From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: the event log client does not give up on hosts up for over 24.8 days

The client remembers a missing Event Log service for 30 s in
service_absent_until and compared it as (LONG)(until - GetTickCount()) > 0.
Its initial 0 against a tick count past 2^31 -- after 24.8 days of uptime --
read as "absent for weeks", so every event log call failed with
RPC_S_SERVER_UNAVAILABLE without trying: the eventlog and audit gates failed
on a host up a month. The time is now a 64-bit tick count, 0 meaning none.
---
diff --git a/dlls/advapi32/eventlog.c b/dlls/advapi32/eventlog.c
index 71084f1..e07bb41 100644
--- a/dlls/advapi32/eventlog.c
+++ b/dlls/advapi32/eventlog.c
@@ -156,7 +156,12 @@ static void free_evlog( struct evlog *log )
 
 /* ---- talking to the service -------------------------------------------- */
 
-static LONG service_absent_until;
+/* when a missing Event Log service is asked for again (GetTickCount64); 0: ask now.
+ * A 32-bit tick count passes 2^31 after 24.8 days of uptime: the signed
+ * difference against the initial 0 then read as "absent for weeks to come",
+ * and every event log call failed with RPC_S_SERVER_UNAVAILABLE without
+ * trying (the eventlog and audit gates on a host up for a month). */
+static ULONGLONG service_absent_until;
 
 static void start_service(void)
 {
@@ -178,7 +183,11 @@ static HANDLE connect_service(void)
     DWORD start = GetTickCount(), mode = PIPE_READMODE_MESSAGE;
     HANDLE pipe;
 
-    if ((LONG)(service_absent_until - GetTickCount()) > 0) return INVALID_HANDLE_VALUE;
+#ifdef SG_MUTANT_EVLOG_TICK_WRAP
+    if ((LONG)((DWORD)service_absent_until - GetTickCount()) > 0) return INVALID_HANDLE_VALUE;
+#else
+    if (service_absent_until && GetTickCount64() < service_absent_until) return INVALID_HANDLE_VALUE;
+#endif
     for (;;)
     {
         pipe = CreateFileW( WINE_EVENTLOG_PIPE, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING,
@@ -187,7 +196,7 @@ static HANDLE connect_service(void)
         if (GetTickCount() - start > CONNECT_TIMEOUT)
         {
             WARN_(eventlog)( "the Event Log service is not answering\n" );
-            service_absent_until = GetTickCount() + 30000;
+            service_absent_until = GetTickCount64() + 30000;
             return INVALID_HANDLE_VALUE;
         }
         if (GetLastError() == ERROR_PIPE_BUSY) WaitNamedPipeW( WINE_EVENTLOG_PIPE, 500 );
