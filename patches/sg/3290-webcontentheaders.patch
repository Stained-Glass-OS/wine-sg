+static inline struct content_headers *impl_from_iterable( IIterable_IKeyValuePair_HSTRING_HSTRING *iface )
+{ return CONTAINING_RECORD( iface, struct content_headers, IIterable_IKeyValuePair_HSTRING_HSTRING_iface ); }
