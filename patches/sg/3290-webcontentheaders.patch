+{ return ch_QI( impl_from_typed( iface ), iid, out ); }
+static ULONG WINAPI typed_ch_AddRef( IHttpContentHeaderCollection *iface )
+{ return InterlockedIncrement( &impl_from_typed( iface )->ref ); }
+static ULONG WINAPI typed_ch_Release( IHttpContentHeaderCollection *iface )
+{ return ch_release( impl_from_typed( iface ) ); }
