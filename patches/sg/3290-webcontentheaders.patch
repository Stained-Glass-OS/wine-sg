+/* ---- entry points for the content object -------------------------------- */
+
+/* The headers of a content object of the given length. media_type (may be NULL)
+ * seeds Content-Type. */
+HRESULT http_content_headers_create( UINT64 length, const WCHAR *media_type, IInspectable **out )
+{
+    struct content_headers *impl;
+    HRESULT hr;
+
+    if (FAILED( hr = content_headers_new( &impl ) )) return hr;
+    impl->has_length = TRUE;
+    impl->length = length;
+    if (media_type && *media_type) headers_set( impl, L"Content-Type", media_type, TRUE, FALSE );
+    *out = (IInspectable *)&impl->IHttpContentHeaderCollection_iface;
+    return S_OK;
+}
+
+/* Fill the content headers from a raw "Name: Value\r\n..." block, taking the
+ * headers that describe the content. */
+void http_content_headers_merge_raw( IInspectable *headers, const WCHAR *raw )
+{
+    struct content_headers *impl = impl_from_typed( (IHttpContentHeaderCollection *)headers );
+    const WCHAR *p = raw;
+
+#ifdef SG_MUTANT_WEBHDR_RESP
+    return;
+#endif
+    while (p && *p)
+    {
+        const WCHAR *eol = wcschr( p, '\n' ), *colon;
+        size_t linelen = eol ? (size_t)(eol - p) : wcslen( p );
+        while (linelen && p[linelen - 1] == '\r') linelen--;
+        colon = wmemchr( p, ':', linelen );
+        if (colon && colon > p)
+        {
+            WCHAR *name = wdup_n( p, colon - p ), *value;
+            const WCHAR *vs = colon + 1;
+            enum entry_kind kind;
+            while (vs < p + linelen && (*vs == ' ' || *vs == '\t')) vs++;
+            value = wdup_n( vs, p + linelen - vs );
+            if (name && value && canonical_name( name, &kind ))
+                headers_set( impl, name, value, FALSE, FALSE );
+            free( name );
+            free( value );
+        }
+        if (!eol) break;
+        p = eol + 1;
+    }
+}
+
+/* The header lines of a content header collection as "Name: value\r\n", for the
+ * transport; Content-Length (computed by the transport) and Content-Type (sent
+ * from http_content_headers_type) are left out. NULL when empty. */
+WCHAR *http_content_headers_lines( IInspectable *headers )
+{
+    struct content_headers *impl = impl_from_typed( (IHttpContentHeaderCollection *)headers );
+    struct snapshot snap;
+    struct sb b = {0};
+    unsigned int i;
+
+#ifdef SG_MUTANT_WEBHDR_SENT
+    return NULL;
+#endif
+    if (FAILED( snapshot_take( impl, &snap ) )) return NULL;
+    for (i = 0; i < snap.count; i++)
+    {
+        if (!wcsicmp( snap.pairs[i].name, L"Content-Length" ) || !wcsicmp( snap.pairs[i].name, L"Content-Type" )) continue;
+        sb_add( &b, snap.pairs[i].name );
+        sb_add( &b, L": " );
+        sb_add( &b, snap.pairs[i].value );
+        sb_add( &b, L"\r\n" );
+    }
+    snapshot_free( &snap );
+    return b.s;
+}
+
+/* Content-Type as the transport sends it, malloc'd; NULL when not set. */
+WCHAR *http_content_headers_type( IInspectable *headers )
+{
+    struct content_headers *impl = impl_from_typed( (IHttpContentHeaderCollection *)headers );
+    struct entry *e = headers_find( impl, L"Content-Type" );
+    return e ? entry_render( e ) : NULL;
+}
