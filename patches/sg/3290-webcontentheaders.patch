+static HRESULT range_create( BOOL has_range, UINT64 first, UINT64 last, BOOL has_length, UINT64 length,
+        IHttpContentRangeHeaderValue **out )
+{
+    struct range *impl;
+
+    /* from <= to, and to < length when the length is known */
+#ifndef SG_MUTANT_WEBHDR_RANGE
+    if (has_range && first > last) return E_INVALIDARG;
+    if (has_range && has_length && last >= length) return E_INVALIDARG;
+#endif
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IHttpContentRangeHeaderValue_iface.lpVtbl = &range_vtbl;
+    impl->IStringable_iface.lpVtbl = &range_str_vtbl;
+    impl->ref = 1;
+    impl->unit = wdup( L"bytes" );
+    impl->has_range = has_range; impl->first = first; impl->last = last;
+    impl->has_length = has_length; impl->length = length;
+    if (!impl->unit) { range_free( impl ); return E_OUTOFMEMORY; }
+    *out = &impl->IHttpContentRangeHeaderValue_iface;
+    return S_OK;
+}
+/* "unit first-last/length", "unit first-last/star" or "unit star/length" */
+static HRESULT range_parse_string( const WCHAR *text, IHttpContentRangeHeaderValue **out )
+{
+    const WCHAR *sp, *slash, *spec, *dash, *lenp;
+    size_t unit_len, spec_len, len_len;
+    UINT64 first = 0, last = 0, length = 0;
+    BOOL has_range = FALSE, has_length = FALSE;
+    HRESULT hr;
+
+    *out = NULL;
+    text = skip_ws( text );
+    if (!(sp = wcschr( text, ' ' ))) return E_INVALIDARG;
+    unit_len = sp - text;
+    if (!is_token( text, unit_len )) return E_INVALIDARG;
+    spec = skip_ws( sp );
+    if (!(slash = wcschr( spec, '/' ))) return E_INVALIDARG;
+    spec_len = slash - spec;
+    {
+        const WCHAR *s = spec;
+        trim( &s, &spec_len );
+        spec = s;
+    }
+    lenp = slash + 1;
+    len_len = wcslen( lenp );
+    trim( &lenp, &len_len );
+    if (spec_len == 1 && *spec == '*') has_range = FALSE;
+    else
+    {
+        if (!(dash = wmemchr( spec, '-', spec_len ))) return E_INVALIDARG;
+        if (!parse_u64( spec, dash - spec, &first ) || !parse_u64( dash + 1, spec - dash - 1 + spec_len, &last ))
+            return E_INVALIDARG;
+        has_range = TRUE;
+    }
+    if (len_len == 1 && *lenp == '*') has_length = FALSE;
+    else if (parse_u64( lenp, len_len, &length )) has_length = TRUE;
+    else return E_INVALIDARG;
+    if (!has_range && !has_length) return E_INVALIDARG;
+    if (FAILED( hr = range_create( has_range, first, last, has_length, length, out ) )) return hr;
+    {
+        struct range *impl = range_from( *out );
+        free( impl->unit );
+        impl->unit = wdup_n( text, unit_len );
+        if (!impl->unit) { IHttpContentRangeHeaderValue_Release( *out ); *out = NULL; return E_OUTOFMEMORY; }
+    }
+    return S_OK;
+}
