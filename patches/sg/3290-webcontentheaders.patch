+/* the collections always exist; they are created empty on first use */
+static HRESULT get_collection( IHttpContentHeaderCollection *iface, const WCHAR *name, enum entry_kind kind, IInspectable **value )
+{
+    struct content_headers *impl = impl_from_typed( iface );
+    struct entry *e = headers_find( impl, name );
+    struct objvec *vec;
+    HRESULT hr;
+
+    *value = NULL;
+    if (!e)
+    {
+        if (FAILED( hr = objvec_create( kind == ENT_CODINGS ? VEC_CODINGS : VEC_LANGS, &vec ) )) return hr;
+        if (!(e = headers_add( impl, name, kind ))) { vec_release( vec ); return E_OUTOFMEMORY; }
+        e->obj = (IInspectable *)&vec->IVector_iface;
+    }
+    IInspectable_AddRef( e->obj );
+    *value = e->obj;
+    return S_OK;
+}
