+/* ---- activation factories ------------------------------------------------ */
+
+/* A factory exposes IActivationFactory plus a constructor interface and a statics interface. */
+#define DEFINE_HV_FACTORY( pfx, FACT, STAT, rtclass )                                              \
+    struct pfx##_factory                                                                           \
+    {                                                                                              \
+        IActivationFactory IActivationFactory_iface;                                               \
+        FACT FACT##_iface;                                                                         \
+        STAT STAT##_iface;                                                                         \
+        LONG ref;                                                                                  \
+    };                                                                                             \
+    static const FACT##Vtbl pfx##_fact_vtbl;                                                       \
+    static const STAT##Vtbl pfx##_stat_vtbl;                                                       \
+    static HRESULT WINAPI pfx##_af_QueryInterface( IActivationFactory *iface, REFIID iid, void **out ) \
+    {                                                                                              \
+        struct pfx##_factory *impl = CONTAINING_RECORD( iface, struct pfx##_factory, IActivationFactory_iface ); \
+        if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||          \
+            IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))  \
+            *out = &impl->IActivationFactory_iface;                                                \
+        else if (IsEqualGUID( iid, &IID_##FACT )) *out = &impl->FACT##_iface;                      \
+        else if (IsEqualGUID( iid, &IID_##STAT )) *out = &impl->STAT##_iface;                      \
+        else                                                                                       \
+        {                                                                                          \
+            WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );        \
+            *out = NULL;                                                                           \
+            return E_NOINTERFACE;                                                                  \
+        }                                                                                          \
+        InterlockedIncrement( &impl->ref );                                                        \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static ULONG WINAPI pfx##_af_AddRef( IActivationFactory *iface )                               \
+    { return InterlockedIncrement( &CONTAINING_RECORD( iface, struct pfx##_factory, IActivationFactory_iface )->ref ); } \
+    static ULONG WINAPI pfx##_af_Release( IActivationFactory *iface )                              \
+    { return InterlockedDecrement( &CONTAINING_RECORD( iface, struct pfx##_factory, IActivationFactory_iface )->ref ); } \
+    static HRESULT WINAPI pfx##_af_GetIids( IActivationFactory *iface, ULONG *c, IID **i )         \
+    {                                                                                              \
+        static const IID *const ids[] = { &IID_IActivationFactory, &IID_##FACT, &IID_##STAT };     \
+        return web_get_iids( ids, ARRAY_SIZE(ids), c, i );                                         \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_af_GetRuntimeClassName( IActivationFactory *iface, HSTRING *n )    \
+    { return web_class_name( rtclass, n ); }                                                       \
+    static HRESULT WINAPI pfx##_af_GetTrustLevel( IActivationFactory *iface, TrustLevel *t )       \
+    { *t = BaseTrust; return S_OK; }                                                               \
+    static HRESULT WINAPI pfx##_af_ActivateInstance( IActivationFactory *iface, IInspectable **instance ) \
+    {                                                                                              \
+        /* built from a value only: no default activation */                                       \
+        WARN( "iface %p: " #pfx " needs a value.\n", iface );                                      \
+        *instance = NULL;                                                                          \
+        return E_NOTIMPL;                                                                          \
+    }                                                                                              \
+    static const struct IActivationFactoryVtbl pfx##_af_vtbl =                                     \
+    {                                                                                              \
+        pfx##_af_QueryInterface, pfx##_af_AddRef, pfx##_af_Release, pfx##_af_GetIids,              \
+        pfx##_af_GetRuntimeClassName, pfx##_af_GetTrustLevel, pfx##_af_ActivateInstance,           \
+    };                                                                                             \
+    DEFINE_IINSPECTABLE_( pfx##_fact, FACT, struct pfx##_factory, pfx##_fact_from, FACT##_iface, &impl->IActivationFactory_iface ) \
+    DEFINE_IINSPECTABLE_( pfx##_stat, STAT, struct pfx##_factory, pfx##_stat_from, STAT##_iface, &impl->IActivationFactory_iface )
+
+#define DEFINE_HV_SINGLETON( pfx )                                                                 \
+    static struct pfx##_factory pfx##_factory_singleton =                                          \
+    { {&pfx##_af_vtbl}, {&pfx##_fact_vtbl}, {&pfx##_stat_vtbl}, 1 };
+
+/* Parse / TryParse of a statics interface: parse_fn(const WCHAR *, VAL **) */
+#define DEFINE_PARSERS( pfx, STAT, VAL, parse_fn )                                                 \
+    static HRESULT pfx##_do_parse( HSTRING input, VAL **value )                                    \
+    {                                                                                              \
+        WCHAR *text;                                                                               \
+        HRESULT hr;                                                                                \
+        *value = NULL;                                                                             \
+        if (!input || !WindowsGetStringLen( input )) return E_INVALIDARG;                          \
+        if (!(text = hs_dup( input ))) return E_OUTOFMEMORY;                                       \
+        hr = parse_fn( text, value );                                                              \
+        free( text );                                                                              \
+        return hr;                                                                                 \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_stat_Parse( STAT *iface, HSTRING input, VAL **value )              \
+    {                                                                                              \
+        TRACE( "iface %p, input %s.\n", iface, debugstr_hstring( input ) );                        \
+        return pfx##_do_parse( input, value );                                                     \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_stat_TryParse( STAT *iface, HSTRING input, VAL **value, boolean *succeeded ) \
+    {                                                                                              \
+        HRESULT hr = pfx##_do_parse( input, value );                                               \
+        TRACE( "iface %p, input %s.\n", iface, debugstr_hstring( input ) );                        \
+        *succeeded = SUCCEEDED( hr );                                                              \
+        return hr == E_OUTOFMEMORY ? hr : S_OK;                                                    \
+    }
