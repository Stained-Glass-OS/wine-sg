+/* the collection objects handed out are IVector faces; callers QI for their typed interface */
+static HRESULT WINAPI typed_ch_get_ContentLength( IHttpContentHeaderCollection *iface, IReference_UINT64 **value )
+{
+    struct content_headers *impl = impl_from_typed( iface );
+    struct entry *e = headers_find( impl, L"Content-Length" );
+    UINT64 length;
+    const WCHAR *t;
+    size_t len;
+
+    TRACE( "iface %p.\n", iface );
+    *value = NULL;
+    if (e && e->text)
+    {
+        t = e->text; len = wcslen( t );
+        trim( &t, &len );
+        if (parse_u64( t, len, &length )) return box_u64( length, value );
+        return S_OK;
+    }
+#ifdef SG_MUTANT_WEBHDR_LENGTH
+    return S_OK;
+#endif
+    if (!impl->has_length) return S_OK;
+    /* the content knows its length: the header takes that value on first read */
+    {
+        WCHAR text[24];
+        swprintf( text, ARRAY_SIZE(text), L"%I64u", impl->length );
+        if (!(e = headers_add( impl, L"Content-Length", ENT_TEXT ))) return E_OUTOFMEMORY;
+        if (!(e->text = wdup( text ))) { impl->count--; entry_clear( e ); return E_OUTOFMEMORY; }
+    }
+    return box_u64( impl->length, value );
+}
+static HRESULT set_text_header( struct content_headers *impl, const WCHAR *name, WCHAR *text )
+{
+    struct entry *e;
+    if (!text) return E_OUTOFMEMORY;
+    headers_remove( impl, name );
+    if (!(e = headers_add( impl, name, ENT_TEXT ))) { free( text ); return E_OUTOFMEMORY; }
+    e->text = text;
+    return S_OK;
+}
+static HRESULT WINAPI typed_ch_put_ContentLength( IHttpContentHeaderCollection *iface, IReference_UINT64 *value )
+{
+    struct content_headers *impl = impl_from_typed( iface );
+    UINT64 length;
+    BOOL has;
+    WCHAR text[24];
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (FAILED( hr = unbox_u64( value, &has, &length ) )) return hr;
+    if (!has) { headers_remove( impl, L"Content-Length" ); impl->has_length = FALSE; return S_OK; }
+    swprintf( text, ARRAY_SIZE(text), L"%I64u", length );
+    return set_text_header( impl, L"Content-Length", wdup( text ) );
+}
