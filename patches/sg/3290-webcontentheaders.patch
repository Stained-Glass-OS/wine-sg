+{
+    struct content_headers *impl;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IHttpContentHeaderCollection_iface.lpVtbl = &typed_ch_vtbl;
+    impl->IMap_HSTRING_HSTRING_iface.lpVtbl = &map_vtbl;
+    impl->IIterable_IKeyValuePair_HSTRING_HSTRING_iface.lpVtbl = &itbl_vtbl;
+    impl->IStringable_iface.lpVtbl = &str_vtbl;
+    impl->ref = 1;
+    *out = impl;
+    return S_OK;
+}
