+static HRESULT ch_QI( struct content_headers *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IHttpContentHeaderCollection ))
+        *out = &impl->IHttpContentHeaderCollection_iface;
+    else if (IsEqualGUID( iid, &IID_IMap_HSTRING_HSTRING )) *out = &impl->IMap_HSTRING_HSTRING_iface;
+    else if (IsEqualGUID( iid, &IID_IIterable_IKeyValuePair_HSTRING_HSTRING ))
+        *out = &impl->IIterable_IKeyValuePair_HSTRING_HSTRING_iface;
+    else if (IsEqualGUID( iid, &IID_IStringable )) *out = &impl->IStringable_iface;
+    else
+    {
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+static ULONG ch_release( struct content_headers *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) headers_free( impl );
+    return ref;
+}
+static HRESULT ch_get_iids( ULONG *count, IID **iids )
+{
+    static const IID *const ids[] = { &IID_IHttpContentHeaderCollection, &IID_IMap_HSTRING_HSTRING,
+        &IID_IIterable_IKeyValuePair_HSTRING_HSTRING, &IID_IStringable };
+    return web_get_iids( ids, ARRAY_SIZE(ids), count, iids );
+}
