+/* filename*: RFC 5987 ext-value  charset ' [language] ' percent-encoded-bytes */
+static int hexval( WCHAR c )
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+static WCHAR *ext_decode( const WCHAR *ext )
+{
+    const WCHAR *q1 = wcschr( ext, '\'' ), *q2 = q1 ? wcschr( q1 + 1, '\'' ) : NULL, *p;
+    size_t len, i, o = 0;
+    char *bytes;
+    WCHAR *r;
+    UINT cp = CP_UTF8;
+    int wlen;
+
+    if (!q2) return wdup( ext );
+    if (q1 - ext == 10 && !wcsnicmp( ext, L"iso-8859-1", 10 )) cp = 28591;
+    p = q2 + 1;
+    len = wcslen( p );
+    if (!(bytes = malloc( len + 1 ))) return NULL;
+    for (i = 0; i < len; i++)
+    {
+        if (p[i] == '%' && i + 2 < len + 0 && hexval( p[i + 1] ) >= 0 && hexval( p[i + 2] ) >= 0)
+        {
+            bytes[o++] = hexval( p[i + 1] ) * 16 + hexval( p[i + 2] );
+            i += 2;
+        }
+        else bytes[o++] = (char)p[i];
+    }
+    wlen = MultiByteToWideChar( cp, 0, bytes, o, NULL, 0 );
+    if ((r = malloc( (wlen + 1) * sizeof(WCHAR) )))
+    {
+        if (wlen) MultiByteToWideChar( cp, 0, bytes, o, r, wlen );
+        r[wlen] = 0;
+    }
+    free( bytes );
+    return r;
+}
+static WCHAR *ext_encode( const WCHAR *text )
+{
+    int n = WideCharToMultiByte( CP_UTF8, 0, text, -1, NULL, 0, NULL, NULL ), i;
+    char *bytes;
+    struct sb b = {0};
+
+    if (n <= 0 || !(bytes = malloc( n ))) return NULL;
+    WideCharToMultiByte( CP_UTF8, 0, text, -1, bytes, n, NULL, NULL );
+    sb_add( &b, L"UTF-8''" );
+    for (i = 0; i < n - 1; i++)
+    {
+        unsigned char c = bytes[i];
+#ifdef SG_MUTANT_WEBHDR_EXTENC
+        if (1)
+#else
+        if ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || strchr( "!#$&+-.^_`|~", c ))
+#endif
+        {
+            WCHAR w = c;
+            sb_add_n( &b, &w, 1 );
+        }
+        else
+        {
+            WCHAR esc[4];
+            swprintf( esc, ARRAY_SIZE(esc), L"%%%02X", c );
+            sb_add( &b, esc );
+        }
+    }
+    free( bytes );
+    return sb_take( &b );
+}
