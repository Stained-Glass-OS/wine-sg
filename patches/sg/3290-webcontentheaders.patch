+static WCHAR *range_render( struct range *impl )
+{
+    struct sb b = {0};
+    WCHAR num[48];
+    sb_add( &b, impl->unit );
+    sb_add( &b, L" " );
+    if (impl->has_range)
+    {
+        swprintf( num, ARRAY_SIZE(num), L"%I64u-%I64u", impl->first, impl->last );
+        sb_add( &b, num );
+    }
+    else sb_add( &b, L"*" );
+    sb_add( &b, L"/" );
+    if (impl->has_length)
+    {
+        swprintf( num, ARRAY_SIZE(num), L"%I64u", impl->length );
+        sb_add( &b, num );
+    }
+    else sb_add( &b, L"*" );
