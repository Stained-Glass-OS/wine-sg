+    vec_iterable_QueryInterface, vec_iterable_AddRef, vec_iterable_Release,
+    vec_iterable_GetIids, vec_iterable_GetRuntimeClassName, vec_iterable_GetTrustLevel,
+    vec_iterable_First,
+};
