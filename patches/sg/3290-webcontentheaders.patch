+ * the terms of the GNU Lesser General Public License as published by the Free
+ * Software Foundation; either version 2.1 of the License, or (at your option)
+ * any later version.
+ */
+
+#include <stdlib.h>
+#include <wchar.h>
+
+#include "private.h"
+#include "winhttp.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(web);
+
+/* ---- small string helpers ---------------------------------------------- */
+
+static WCHAR *wdup_n( const WCHAR *s, size_t n )
+{
+    WCHAR *r = malloc( (n + 1) * sizeof(WCHAR) );
+    if (!r) return NULL;
+    if (n) memcpy( r, s, n * sizeof(WCHAR) );
+    r[n] = 0;
+    return r;
+}
+static WCHAR *wdup( const WCHAR *s ) { return wdup_n( s, s ? wcslen( s ) : 0 ); }
+
+static WCHAR *hs_dup( HSTRING s )
+{
+    UINT32 len = 0;
+    const WCHAR *buf = WindowsGetStringRawBuffer( s, &len );
+    return wdup_n( buf, len );
+}
+static HRESULT hs_new( const WCHAR *s, HSTRING *out )
+{
+    if (!s) s = L"";
+    return WindowsCreateString( s, wcslen( s ), out );
+}
+
+static BOOL is_token_char( WCHAR c )
+{
+    if (c <= 0x20 || c >= 0x7f) return FALSE;
+    return !wcschr( L"()<>@,;:\\\"/[]?={}", c );
+}
+static BOOL is_token( const WCHAR *s, size_t len )
+{
+    size_t i;
+    if (!len) return FALSE;
+    for (i = 0; i < len; i++) if (!is_token_char( s[i] )) return FALSE;
+    return TRUE;
+}
+static const WCHAR *skip_ws( const WCHAR *s ) { while (*s == ' ' || *s == '\t') s++; return s; }
+static void trim( const WCHAR **s, size_t *len )
+{
+    while (*len && (**s == ' ' || **s == '\t')) { (*s)++; (*len)--; }
+    while (*len && ((*s)[*len - 1] == ' ' || (*s)[*len - 1] == '\t')) (*len)--;
+}
+static BOOL is_quoted( const WCHAR *s, size_t len ) { return len >= 2 && s[0] == '"' && s[len - 1] == '"'; }
+
+/* a value as stored (maybe quoted), without its quotes and with quoted-pairs resolved */
+static WCHAR *unquote( const WCHAR *s )
+{
+    size_t len = wcslen( s ), i, o = 0;
+    WCHAR *r;
+    if (!is_quoted( s, len )) return wdup( s );
+    if (!(r = malloc( len * sizeof(WCHAR) ))) return NULL;
+    for (i = 1; i + 1 < len; i++)
+    {
+        if (s[i] == '\\' && i + 2 < len) i++;
+        r[o++] = s[i];
+    }
+    r[o] = 0;
+    return r;
+}
+/* value to store for a text value: a token as is, anything else quoted */
+static WCHAR *quote_if_needed( const WCHAR *s )
+{
+    size_t len = wcslen( s ), i, o = 0;
+    WCHAR *r;
+#ifdef SG_MUTANT_WEBHDR_QUOTE
+    return wdup( s );
+#endif
+    if (is_token( s, len ) || is_quoted( s, len )) return wdup( s );
+    if (!(r = malloc( (len * 2 + 3) * sizeof(WCHAR) ))) return NULL;
+    r[o++] = '"';
+    for (i = 0; i < len; i++)
+    {
+        if (s[i] == '"' || s[i] == '\\') r[o++] = '\\';
+        r[o++] = s[i];
+    }
+    r[o++] = '"';
+    r[o] = 0;
+    return r;
+}
+
+static BOOL parse_u64( const WCHAR *s, size_t len, UINT64 *out )
+{
+    UINT64 v = 0;
+    size_t i;
+    if (!len) return FALSE;
+    for (i = 0; i < len; i++)
+    {
+        if (s[i] < '0' || s[i] > '9') return FALSE;
+        if (v > (~(UINT64)0 - (s[i] - '0')) / 10) return FALSE;
+        v = v * 10 + (s[i] - '0');
+    }
+    *out = v;
+    return TRUE;
+}
+
+/* ---- growable string builder ------------------------------------------- */
+
+struct sb { WCHAR *s; size_t len, cap; };
+static BOOL sb_add_n( struct sb *b, const WCHAR *s, size_t n )
+{
+    if (b->len + n + 1 > b->cap)
+    {
+        size_t cap = max( b->cap * 2, b->len + n + 64 );
+        WCHAR *r = realloc( b->s, cap * sizeof(WCHAR) );
+        if (!r) return FALSE;
+        b->s = r;
+        b->cap = cap;
+    }
+    if (n) memcpy( b->s + b->len, s, n * sizeof(WCHAR) );
+    b->len += n;
+    b->s[b->len] = 0;
+    return TRUE;
+}
+static BOOL sb_add( struct sb *b, const WCHAR *s ) { return sb_add_n( b, s, wcslen( s ) ); }
+static WCHAR *sb_take( struct sb *b )
+{
+    if (!b->s) return wdup( L"" );
+    return b->s;
+}
+
+/* split "main; a=b; c" at semicolons outside quoted strings; the pieces are
+ * trimmed copies, the array and the pieces are freed with free_pieces */
+static WCHAR **split_params( const WCHAR *s, unsigned int *count )
+{
+    WCHAR **list = NULL;
+    unsigned int n = 0, cap = 0;
+    const WCHAR *start = s, *p = s;
+    BOOL quoted = FALSE;
+
+    for (;; p++)
+    {
+        if (*p == '"' && (!quoted || p == s || p[-1] != '\\')) quoted = !quoted;
+        if ((*p == ';' && !quoted) || !*p)
+        {
+            const WCHAR *piece = start;
+            size_t len = p - start;
+            trim( &piece, &len );
+            if (n == cap)
+            {
+                WCHAR **r = realloc( list, (cap = cap ? cap * 2 : 8) * sizeof(*r) );
+                if (!r) goto fail;
+                list = r;
+            }
+            if (!(list[n] = wdup_n( piece, len ))) goto fail;
+            n++;
+            if (!*p) break;
+            start = p + 1;
+        }
+    }
+    *count = n;
+    return list;
+fail:
+    while (n--) free( list[n] );
+    free( list );
+    return NULL;
+}
+static void free_pieces( WCHAR **list, unsigned int n )
+{
+    while (n--) free( list[n] );
+    free( list );
+}
+
+/* ---- common object plumbing -------------------------------------------- */
+
+/* The value objects all have the shape { primary iface, IStringable, ref }. */
+#define VALUE_OBJECT_QI( pfx, IFACE, type )                                                        \
+    static HRESULT WINAPI pfx##_QueryInterface( IFACE *iface, REFIID iid, void **out )             \
+    {                                                                                              \
+        type *impl = CONTAINING_RECORD( iface, type, IFACE##_iface );                              \
+        if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||          \
+            IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_##IFACE ))             \
+            *out = &impl->IFACE##_iface;                                                           \
+        else if (IsEqualGUID( iid, &IID_IStringable ))                                             \
+            *out = &impl->IStringable_iface;                                                       \
+        else                                                                                       \
+        {                                                                                          \
+            *out = NULL;                                                                           \
+            return E_NOINTERFACE;                                                                  \
+        }                                                                                          \
+        InterlockedIncrement( &impl->ref );                                                        \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static ULONG WINAPI pfx##_AddRef( IFACE *iface )                                               \
+    {                                                                                              \
+        return InterlockedIncrement( &CONTAINING_RECORD( iface, type, IFACE##_iface )->ref );      \
+    }                                                                                              \
+    static ULONG WINAPI pfx##_Release( IFACE *iface )                                              \
+    {                                                                                              \
+        type *impl = CONTAINING_RECORD( iface, type, IFACE##_iface );                              \
+        ULONG ref = InterlockedDecrement( &impl->ref );                                            \
+        if (!ref) pfx##_free( impl );                                                              \
+        return ref;                                                                                \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_GetIids( IFACE *iface, ULONG *c, IID **i )                         \
+    {                                                                                              \
+        static const IID *const ids[] = { &IID_##IFACE, &IID_IStringable };                        \
+        return web_get_iids( ids, ARRAY_SIZE(ids), c, i );                                         \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_GetTrustLevel( IFACE *iface, TrustLevel *t )                       \
+    {                                                                                              \
+        *t = BaseTrust;                                                                            \
+        return S_OK;                                                                               \
+    }
+
+/* ToString for a value object: pfx##_render returns a malloc'd string */
+#define VALUE_OBJECT_STRINGABLE( pfx, IFACE, type )                                                \
+    DEFINE_IINSPECTABLE_( pfx##_str, IStringable, type, pfx##_str_from, IStringable_iface, &impl->IFACE##_iface ) \
+    static HRESULT WINAPI pfx##_str_ToString( IStringable *iface, HSTRING *value )                 \
+    {                                                                                              \
+        type *impl = CONTAINING_RECORD( iface, type, IStringable_iface );                          \
+        WCHAR *s = pfx##_render( impl );                                                           \
+        HRESULT hr;                                                                                \
+        if (!s) return E_OUTOFMEMORY;                                                              \
+        hr = hs_new( s, value );                                                                   \
+        free( s );                                                                                 \
+        return hr;                                                                                 \
+    }                                                                                              \
+    static const IStringableVtbl pfx##_str_vtbl =                                                  \
+    {                                                                                              \
+        pfx##_str_QueryInterface, pfx##_str_AddRef, pfx##_str_Release, pfx##_str_GetIids,          \
+        pfx##_str_GetRuntimeClassName, pfx##_str_GetTrustLevel, pfx##_str_ToString,                \
+    };
+
+/* Boxed integers / dates for the IReference<T> properties. */
+static HRESULT box_value( BOOL date, UINT64 value, const GUID *iid, void **out )
+{
+    IPropertyValueStatics *statics;
+    IInspectable *boxed;
+    HSTRING name;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED( hr = WindowsCreateString( RuntimeClass_Windows_Foundation_PropertyValue,
+                                          wcslen( RuntimeClass_Windows_Foundation_PropertyValue ), &name ) ))
+        return hr;
+    hr = RoGetActivationFactory( name, &IID_IPropertyValueStatics, (void **)&statics );
+    WindowsDeleteString( name );
+    if (FAILED( hr )) return hr;
+    if (date)
+    {
+        DateTime when;
+        when.UniversalTime = value;
+        hr = IPropertyValueStatics_CreateDateTime( statics, when, &boxed );
+    }
+    else hr = IPropertyValueStatics_CreateUInt64( statics, value, &boxed );
+    IPropertyValueStatics_Release( statics );
+    if (FAILED( hr )) return hr;
+    hr = IInspectable_QueryInterface( boxed, iid, out );
+    IInspectable_Release( boxed );
+    return hr;
+}
+static HRESULT box_u64( UINT64 value, IReference_UINT64 **out )
+{
+    return box_value( FALSE, value, &IID_IReference_UINT64, (void **)out );
+}
+/* NULL or empty reference: *has = FALSE */
+static HRESULT unbox_u64( IReference_UINT64 *ref, BOOL *has, UINT64 *value )
+{
+    *has = FALSE;
+    if (!ref) return S_OK;
+    *has = TRUE;
+    return IReference_UINT64_get_Value( ref, value );
+}
+
+/* ---- generic object / string vector ------------------------------------ */
+
+enum vec_kind { VEC_OBJECT, VEC_STRING };
+
+struct objvec
+{
+    IVector_IInspectable IVector_iface;
+    IVectorView_IInspectable IVectorView_iface;
+    IIterable_IInspectable IIterable_iface;
+    IStringable IStringable_iface;
+    void *typed_iface_vtbl_holder;      /* ParseAdd/TryParseAdd face (vtbl pointer first) */
+    LONG ref;
+    enum vec_kind kind;
+    const IID *iid_vector, *iid_view, *iid_iterable, *iid_typed;
+    const IID *iid_elem;                /* interface elements must support */
+    const WCHAR *class_name;
+    BOOL stringable;                    /* collections of coding / language values */
+    void **items;
+    UINT32 count, cap;
+};
+
+static inline struct objvec *vec_from_vector( IVector_IInspectable *iface )
+{ return CONTAINING_RECORD( iface, struct objvec, IVector_iface ); }
+static inline struct objvec *vec_from_view( IVectorView_IInspectable *iface )
+{ return CONTAINING_RECORD( iface, struct objvec, IVectorView_iface ); }
+static inline struct objvec *vec_from_iterable( IIterable_IInspectable *iface )
+{ return CONTAINING_RECORD( iface, struct objvec, IIterable_iface ); }
+static inline struct objvec *vec_from_str( IStringable *iface )
+{ return CONTAINING_RECORD( iface, struct objvec, IStringable_iface ); }
+
+/* the typed ParseAdd / TryParseAdd interface */
+typedef struct typed_coll typed_coll;
+struct typed_coll_vtbl
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)( typed_coll *, REFIID, void ** );
+    ULONG   (STDMETHODCALLTYPE *AddRef)( typed_coll * );
+    ULONG   (STDMETHODCALLTYPE *Release)( typed_coll * );
+    HRESULT (STDMETHODCALLTYPE *GetIids)( typed_coll *, ULONG *, IID ** );
+    HRESULT (STDMETHODCALLTYPE *GetRuntimeClassName)( typed_coll *, HSTRING * );
+    HRESULT (STDMETHODCALLTYPE *GetTrustLevel)( typed_coll *, TrustLevel * );
+    HRESULT (STDMETHODCALLTYPE *ParseAdd)( typed_coll *, HSTRING );
+    HRESULT (STDMETHODCALLTYPE *TryParseAdd)( typed_coll *, HSTRING, boolean * );
+};
+struct typed_coll { const struct typed_coll_vtbl *lpVtbl; };
+#define VEC_TYPED(v) ((typed_coll *)&(v)->typed_iface_vtbl_holder)
+
+static void vec_free_item( struct objvec *vec, void *item )
+{
+    if (vec->kind == VEC_STRING) WindowsDeleteString( item );
+    else if (item) IInspectable_Release( item );
+}
+static void vec_free( struct objvec *vec )
+{
+    UINT32 i;
+    for (i = 0; i < vec->count; i++) vec_free_item( vec, vec->items[i] );
+    free( vec->items );
+    free( vec );
+}
+
+static HRESULT vec_QI( struct objvec *vec, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, vec->iid_vector ))
+        *out = &vec->IVector_iface;
+    else if (IsEqualGUID( iid, vec->iid_view )) *out = &vec->IVectorView_iface;
+    else if (IsEqualGUID( iid, vec->iid_iterable )) *out = &vec->IIterable_iface;
+    else if (vec->iid_typed && IsEqualGUID( iid, vec->iid_typed )) *out = VEC_TYPED( vec );
+    else if (vec->stringable && IsEqualGUID( iid, &IID_IStringable )) *out = &vec->IStringable_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &vec->ref );
+    return S_OK;
+}
+static ULONG vec_release( struct objvec *vec )
+{
+    ULONG ref = InterlockedDecrement( &vec->ref );
+    if (!ref) vec_free( vec );
+    return ref;
+}
+static HRESULT vec_get_iids( struct objvec *vec, ULONG *count, IID **iids )
+{
+    const IID *ids[5];
+    ULONG n = 0;
+    ids[n++] = vec->iid_vector;
+    ids[n++] = vec->iid_iterable;
+    if (vec->iid_typed) ids[n++] = vec->iid_typed;
+    if (vec->stringable) ids[n++] = &IID_IStringable;
+    return web_get_iids( ids, n, count, iids );
+}
+
+/* an element handed in by the caller, checked and referenced for storing */
+static HRESULT vec_take( struct objvec *vec, IInspectable *value, void **item )
+{
+    IInspectable *checked;
+    HRESULT hr;
+
+    if (vec->kind == VEC_STRING)
+    {
+        HSTRING s = (HSTRING)value, copy;
+        WCHAR *w;
+        if (!s || !WindowsGetStringLen( s )) return E_INVALIDARG;
+        w = hs_dup( s );
+        if (!w) return E_OUTOFMEMORY;
+        if (!is_token( w, wcslen( w ) )) { free( w ); return E_INVALIDARG; }
+        free( w );
+        if (FAILED( hr = WindowsDuplicateString( s, &copy ) )) return hr;
+        *item = copy;
+        return S_OK;
+    }
+    if (!value) return E_INVALIDARG;
+    if (FAILED( hr = IInspectable_QueryInterface( value, vec->iid_elem, (void **)&checked ) )) return E_INVALIDARG;
+    *item = checked;
+    return S_OK;
+}
+static HRESULT vec_grow( struct objvec *vec )
+{
+    if (vec->count == vec->cap)
+    {
+        UINT32 cap = vec->cap ? vec->cap * 2 : 4;
+        void **r = realloc( vec->items, cap * sizeof(*r) );
+        if (!r) return E_OUTOFMEMORY;
+        vec->items = r;
+        vec->cap = cap;
+    }
+    return S_OK;
+}
+static HRESULT vec_insert( struct objvec *vec, UINT32 index, IInspectable *value )
+{
+    void *item;
+    HRESULT hr;
+    if (index > vec->count) return E_BOUNDS;
+    if (FAILED( hr = vec_take( vec, value, &item ) )) return hr;
+    if (FAILED( hr = vec_grow( vec ) )) { vec_free_item( vec, item ); return hr; }
+    memmove( vec->items + index + 1, vec->items + index, (vec->count - index) * sizeof(*vec->items) );
+    vec->items[index] = item;
+    vec->count++;
+    return S_OK;
+}
+static HRESULT vec_remove( struct objvec *vec, UINT32 index )
+{
+    if (index >= vec->count) return E_BOUNDS;
+    vec_free_item( vec, vec->items[index] );
+    memmove( vec->items + index, vec->items + index + 1, (vec->count - index - 1) * sizeof(*vec->items) );
+    vec->count--;
+    return S_OK;
+}
+static HRESULT vec_get_at( struct objvec *vec, UINT32 index, IInspectable **value )
+{
+    HRESULT hr;
+    *value = NULL;
+    if (index >= vec->count) return E_BOUNDS;
+    if (vec->kind == VEC_STRING)
+    {
+        HSTRING copy;
+        if (FAILED( hr = WindowsDuplicateString( vec->items[index], &copy ) )) return hr;
+        *value = (IInspectable *)copy;
+        return S_OK;
+    }
+    IInspectable_AddRef( (IInspectable *)vec->items[index] );
+    *value = vec->items[index];
+    return S_OK;
+}
+static BOOL vec_same( struct objvec *vec, void *a, IInspectable *b )
+{
+    if (vec->kind == VEC_STRING)
+    {
+        INT32 cmp = 1;
+        WindowsCompareStringOrdinal( a, (HSTRING)b, &cmp );
+        return !cmp;
+    }
+    return a == (void *)b;
+}
+static HRESULT vec_get_many( struct objvec *vec, UINT32 start, UINT32 count, IInspectable **items, UINT32 *actual )
+{
+    UINT32 n = 0;
+    *actual = 0;
+    if (start > vec->count) return E_BOUNDS;
+    while (n < count && start + n < vec->count)
+    {
+        HRESULT hr = vec_get_at( vec, start + n, &items[n] );
+        if (FAILED( hr ))
+        {
+            while (n--) { if (vec->kind == VEC_STRING) WindowsDeleteString( (HSTRING)items[n] ); else IInspectable_Release( items[n] ); }
+            return hr;
+        }
+        n++;
+    }
+    *actual = n;
+    return S_OK;
+}
+
+/* ToString of coding / language collections: values joined with ", " */
+static WCHAR *vec_render( struct objvec *vec )
+{
+    struct sb b = {0};
+    UINT32 i;
+
+    for (i = 0; i < vec->count; i++)
+    {
+        HSTRING s = NULL;
+        const WCHAR *w;
+        if (i && !sb_add( &b, L", " )) goto fail;
+        if (vec->kind == VEC_STRING) s = vec->items[i];
+        else
+        {
+            IStringable *str;
+            if (SUCCEEDED( IInspectable_QueryInterface( vec->items[i], &IID_IStringable, (void **)&str ) ))
+            {
+                IStringable_ToString( str, &s );
+                IStringable_Release( str );
+            }
+        }
+        w = WindowsGetStringRawBuffer( s, NULL );
+        if (!sb_add( &b, w )) goto fail;
+        if (vec->kind != VEC_STRING) WindowsDeleteString( s );
+    }
+    return sb_take( &b );
+fail:
+    free( b.s );
+    return NULL;
+}
