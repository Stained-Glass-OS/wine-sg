+    range_QueryInterface, range_AddRef, range_Release, range_GetIids, range_GetRuntimeClassName, range_GetTrustLevel,
+    range_get_FirstBytePosition, range_get_LastBytePosition, range_get_Length, range_get_Unit, range_put_Unit,
+};
