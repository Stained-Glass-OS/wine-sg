+/* ---- the collection ------------------------------------------------------ */
+
+enum entry_kind { ENT_TEXT, ENT_MEDIA, ENT_DISP, ENT_RANGE, ENT_CODINGS, ENT_LANGS };
+
+struct entry
+{
+    WCHAR *name;
+    enum entry_kind kind;
+    WCHAR *text;                 /* ENT_TEXT, or a typed header kept raw because it did not parse */
+    IInspectable *obj;           /* the live typed object */
+};
+
+struct content_headers
+{
+    IHttpContentHeaderCollection IHttpContentHeaderCollection_iface;
+    IMap_HSTRING_HSTRING IMap_HSTRING_HSTRING_iface;
+    IIterable_IKeyValuePair_HSTRING_HSTRING IIterable_IKeyValuePair_HSTRING_HSTRING_iface;
+    IStringable IStringable_iface;
+    LONG ref;
+    BOOL has_length;             /* the owning content knows its length */
+    UINT64 length;
+    struct entry *entries;
+    unsigned int count, cap;
+};
+
+static const struct { const WCHAR *name; enum entry_kind kind; } known_headers[] =
+{
+    { L"Content-Disposition", ENT_DISP }, { L"Content-Encoding", ENT_CODINGS }, { L"Content-Language", ENT_LANGS },
+    { L"Content-Length", ENT_TEXT }, { L"Content-Location", ENT_TEXT }, { L"Content-MD5", ENT_TEXT },
+    { L"Content-Range", ENT_RANGE }, { L"Content-Type", ENT_MEDIA }, { L"Expires", ENT_TEXT },
+    { L"Last-Modified", ENT_TEXT },
+};
+static const WCHAR *canonical_name( const WCHAR *name, enum entry_kind *kind )
+{
+    unsigned int i;
+    *kind = ENT_TEXT;
+    for (i = 0; i < ARRAY_SIZE(known_headers); i++)
+        if (!wcsicmp( name, known_headers[i].name )) { *kind = known_headers[i].kind; return known_headers[i].name; }
+    return NULL;
+}
+
+static void entry_clear( struct entry *e )
+{
+    free( e->name );
+    free( e->text );
+    if (e->obj) IInspectable_Release( e->obj );
+}
+static void headers_free( struct content_headers *impl )
+{
+    unsigned int i;
+    for (i = 0; i < impl->count; i++) entry_clear( &impl->entries[i] );
+    free( impl->entries );
+    free( impl );
+}
+static struct entry *headers_find( struct content_headers *impl, const WCHAR *name )
+{
+    unsigned int i;
+    for (i = 0; i < impl->count; i++)
+        if (!wcsicmp( impl->entries[i].name, name )) return &impl->entries[i];
+    return NULL;
+}
+static void headers_remove_entry( struct content_headers *impl, struct entry *e )
+{
+    entry_clear( e );
+    memmove( e, e + 1, (impl->entries + impl->count - e - 1) * sizeof(*e) );
+    impl->count--;
+}
+/* a new entry at the end; the caller fills in text / obj */
+static struct entry *headers_add( struct content_headers *impl, const WCHAR *name, enum entry_kind kind )
+{
+    struct entry *e;
+    if (impl->count == impl->cap)
+    {
+        unsigned int cap = impl->cap ? impl->cap * 2 : 8;
+        struct entry *r = realloc( impl->entries, cap * sizeof(*r) );
+        if (!r) return NULL;
+        impl->entries = r;
+        impl->cap = cap;
+    }
+    e = &impl->entries[impl->count];
+    memset( e, 0, sizeof(*e) );
+    if (!(e->name = wdup( name ))) return NULL;
+    e->kind = kind;
+    impl->count++;
+    return e;
+}
+
+/* The header's value text; NULL for an empty typed collection (not a header). */
+static WCHAR *entry_render( struct entry *e )
+{
+    IStringable *str;
+    HSTRING hs = NULL;
+    WCHAR *text;
+
+    if (!e->obj) return wdup( e->text );
+    if (e->kind == ENT_CODINGS || e->kind == ENT_LANGS)
+    {
+        struct objvec *vec = CONTAINING_RECORD( e->obj, struct objvec, IVector_iface );
+#ifndef SG_MUTANT_WEBHDR_EMPTYVEC
+        if (!vec->count) return NULL;
+#endif
+        return vec_render( vec );
+    }
+    if (FAILED( IInspectable_QueryInterface( e->obj, &IID_IStringable, (void **)&str ) )) return wdup( L"" );
+    IStringable_ToString( str, &hs );
+    IStringable_Release( str );
+    text = hs_dup( hs );
+    WindowsDeleteString( hs );
+    return text;
+}
+
+/* Make the typed object of an entry exist (from its raw text); FALSE when the
+ * raw text is not a valid value for the header. */
+static BOOL entry_materialize( struct content_headers *impl, struct entry *e )
+{
+    HRESULT hr = E_FAIL;
+    IInspectable *obj = NULL;
+
+    if (e->obj) return TRUE;
+    switch (e->kind)
+    {
+    case ENT_MEDIA: hr = media_parse_string( e->text, (IHttpMediaTypeHeaderValue **)&obj ); break;
+    case ENT_DISP: hr = disp_parse_string( e->text, (IHttpContentDispositionHeaderValue **)&obj ); break;
+    case ENT_RANGE: hr = range_parse_string( e->text, (IHttpContentRangeHeaderValue **)&obj ); break;
+    default: return FALSE;
+    }
+    if (FAILED( hr )) return FALSE;
+    e->obj = obj;
+    free( e->text );
+    e->text = NULL;
+    return TRUE;
+}
+
+/* HTTP-date <-> DateTime ticks. Read: RFC 1123, RFC 850 and asctime forms, GMT only. */
+static int month_number( const WCHAR *t )
+{
+    static const WCHAR *const names[] = { L"jan", L"feb", L"mar", L"apr", L"may", L"jun", L"jul", L"aug", L"sep", L"oct", L"nov", L"dec" };
+    int i;
+    if (wcslen( t ) < 3) return 0;
+    for (i = 0; i < 12; i++) if (!wcsnicmp( t, names[i], 3 )) return i + 1;
+    return 0;
+}
+static BOOL num_token( const WCHAR *t, int digits_min, int digits_max, int *out )
+{
+    size_t n = wcslen( t ), i;
+    int v = 0;
+    if (n < (size_t)digits_min || n > (size_t)digits_max) return FALSE;
+    for (i = 0; i < n; i++)
+    {
+        if (t[i] < '0' || t[i] > '9') return FALSE;
+        v = v * 10 + t[i] - '0';
+    }
+    *out = v;
+    return TRUE;
+}
+static BOOL date_parse( const WCHAR *text, UINT64 *ticks )
+{
+    WCHAR *copy = wdup( text ), *tok[12], *p, *ctx;
+    int n = 0, k = 0, day, mon, year, hh, mm, ss;
+    SYSTEMTIME st = {0};
+    FILETIME ft;
+    BOOL ok = FALSE;
+
+    if (!copy) return FALSE;
+    for (p = copy; *p; p++) if (*p == ',' || *p == '-' || *p == ':') *p = ' ';
+    for (p = wcstok_s( copy, L" \t", &ctx ); p; p = wcstok_s( NULL, L" \t", &ctx ))
+    {
+        if (n == ARRAY_SIZE(tok)) goto done;
+        tok[n++] = p;
+    }
+    /* optional weekday */
+    if (n && !month_number( tok[0] ) && !(tok[0][0] >= '0' && tok[0][0] <= '9')) k = 1;
+    if (k < n && month_number( tok[k] ))
+    {
+        /* asctime: Mon Day hh mm ss Year */
+        if (n - k != 6) goto done;
+        mon = month_number( tok[k] );
+        if (!num_token( tok[k + 1], 1, 2, &day ) || !num_token( tok[k + 2], 2, 2, &hh ) ||
+            !num_token( tok[k + 3], 2, 2, &mm ) || !num_token( tok[k + 4], 2, 2, &ss ) ||
+            !num_token( tok[k + 5], 4, 4, &year )) goto done;
+    }
+    else
+    {
+        /* Day Mon Year hh mm ss [GMT] */
+        if (n - k != 7 && n - k != 6) goto done;
+        if (!num_token( tok[k], 1, 2, &day ) || !(mon = month_number( tok[k + 1] )) ||
+            !num_token( tok[k + 2], 2, 4, &year ) || !num_token( tok[k + 3], 2, 2, &hh ) ||
+            !num_token( tok[k + 4], 2, 2, &mm ) || !num_token( tok[k + 5], 2, 2, &ss )) goto done;
+        if (wcslen( tok[k + 2] ) == 2) year += year >= 70 ? 1900 : 2000;
+        else if (wcslen( tok[k + 2] ) == 3) goto done;
+        if (n - k == 7 && wcsicmp( tok[k + 6], L"GMT" ) && wcsicmp( tok[k + 6], L"UTC" ) && wcsicmp( tok[k + 6], L"Z" )) goto done;
+    }
+    if (hh > 23 || mm > 59 || ss > 59 || year < 1601) goto done;
+    st.wYear = year; st.wMonth = mon; st.wDay = day; st.wHour = hh; st.wMinute = mm; st.wSecond = ss;
+    if (!SystemTimeToFileTime( &st, &ft )) goto done;
+    *ticks = ((UINT64)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    ok = TRUE;
+done:
+    free( copy );
+    return ok;
+}
+static WCHAR *date_render( UINT64 ticks )
+{
+    WCHAR buf[64];
+    FILETIME ft;
+    SYSTEMTIME st;
+    ft.dwLowDateTime = (DWORD)ticks;
+    ft.dwHighDateTime = ticks >> 32;
+    if (!FileTimeToSystemTime( &ft, &st ) || !WinHttpTimeFromSystemTime( &st, buf )) return NULL;
+    return wdup( buf );
+}
+
+static WCHAR *base64_encode( const BYTE *data, UINT32 len )
+{
+    static const WCHAR tab[] = L"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    WCHAR *r = malloc( ((len + 2) / 3 * 4 + 1) * sizeof(WCHAR) ), *p = r;
+    UINT32 i;
+    if (!r) return NULL;
+    for (i = 0; i < len; i += 3)
+    {
+        UINT32 v = data[i] << 16 | (i + 1 < len ? data[i + 1] << 8 : 0) | (i + 2 < len ? data[i + 2] : 0);
+        *p++ = tab[v >> 18 & 63];
+        *p++ = tab[v >> 12 & 63];
+        *p++ = i + 1 < len ? tab[v >> 6 & 63] : '=';
+#ifdef SG_MUTANT_WEBHDR_B64PAD
+        *p++ = i + 2 < len ? tab[v & 63] : ':';
+#else
+        *p++ = i + 2 < len ? tab[v & 63] : '=';
+#endif
+    }
+    *p = 0;
+    return r;
+}
+static int b64val( WCHAR c )
+{
+    if (c >= 'A' && c <= 'Z') return c - 'A';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if (c >= '0' && c <= '9') return c - '0' + 52;
+    if (c == '+') return 62;
+    if (c == '/') return 63;
+    return -1;
+}
+static BYTE *base64_decode( const WCHAR *s, UINT32 *len )
+{
+    size_t n = wcslen( s ), i;
+    BYTE *r;
+    UINT32 o = 0;
+    int pad = 0;
+
+    if (!n || n % 4) return NULL;
+    if (s[n - 1] == '=') pad++;
+    if (s[n - 2] == '=') pad++;
+    if (!(r = malloc( n / 4 * 3 + 1 ))) return NULL;
+    for (i = 0; i < n; i += 4)
+    {
+        int a = b64val( s[i] ), b = b64val( s[i + 1] ), c = s[i + 2] == '=' ? 0 : b64val( s[i + 2] ),
+            d = s[i + 3] == '=' ? 0 : b64val( s[i + 3] );
+        if (a < 0 || b < 0 || c < 0 || d < 0) { free( r ); return NULL; }
+        r[o++] = a << 2 | b >> 4;
+        if (s[i + 2] != '=') r[o++] = b << 4 | c >> 2;
+        if (s[i + 3] != '=') r[o++] = c << 6 | d;
+    }
+    *len = o;
+    return r;
+}
+
+/* ---- typed header text validation (Append) ------------------------------ */
+
+/* TRUE when text is a valid value for the named header, as the typed accessor reads it */
+static BOOL valid_value( enum entry_kind kind, const WCHAR *name, const WCHAR *text )
+{
+    UINT64 tmp;
+    size_t len = wcslen( text );
+    const WCHAR *t = text;
+    IInspectable *obj = NULL;
+
+    switch (kind)
+    {
+    case ENT_MEDIA:
+        if (FAILED( media_parse_string( text, (IHttpMediaTypeHeaderValue **)&obj ) )) return FALSE;
+        IInspectable_Release( obj );
+        return TRUE;
+    case ENT_DISP:
+        if (FAILED( disp_parse_string( text, (IHttpContentDispositionHeaderValue **)&obj ) )) return FALSE;
+        IInspectable_Release( obj );
+        return TRUE;
+    case ENT_RANGE:
+        if (FAILED( range_parse_string( text, (IHttpContentRangeHeaderValue **)&obj ) )) return FALSE;
+        IInspectable_Release( obj );
+        return TRUE;
+    case ENT_TEXT:
+        trim( &t, &len );
+        if (!wcsicmp( name, L"Content-Length" )) return parse_u64( t, len, &tmp );
+#ifdef SG_MUTANT_WEBHDR_DATE
+        if (!wcsicmp( name, L"Expires" ) || !wcsicmp( name, L"Last-Modified" )) return TRUE;
+#else
+        if (!wcsicmp( name, L"Expires" ) || !wcsicmp( name, L"Last-Modified" )) return date_parse( text, &tmp );
+#endif
+        if (!wcsicmp( name, L"Content-MD5" ))
+        {
+            UINT32 n;
+            BYTE *bytes = base64_decode( text, &n );
+            free( bytes );
+            return !!bytes;
+        }
+        return TRUE;
+    default:
+        return TRUE;
+    }
+}
+
+/* Store a header the generic way (Append / Insert). Single-valued headers are replaced;
+ * multi-valued and unknown ones gain the new value. validate: reject bad names and values. */
+static HRESULT headers_set( struct content_headers *impl, const WCHAR *name, const WCHAR *value, BOOL replace, BOOL validate )
+{
+    enum entry_kind kind;
+    const WCHAR *canon = canonical_name( name, &kind );
+    struct entry *e;
+    const WCHAR *v = value;
+    size_t vlen = wcslen( value );
+    WCHAR *text;
+    HRESULT hr;
+
+    if (!is_token( name, wcslen( name ) )) return E_INVALIDARG;
+    trim( &v, &vlen );
+    if (!(text = wdup_n( v, vlen ))) return E_OUTOFMEMORY;
+    if (canon) name = canon;
+    if (validate && !valid_value( kind, name, text )) { free( text ); return E_INVALIDARG; }
+
+    e = headers_find( impl, name );
+    if (e && (kind == ENT_CODINGS || kind == ENT_LANGS))
+    {
+        struct objvec *vec = CONTAINING_RECORD( e->obj, struct objvec, IVector_iface );
+        if (replace) while (vec->count) vec_remove( vec, vec->count - 1 );
+        hr = vec_parse_add( vec, text );
+        if (FAILED( hr ) && !validate) hr = S_OK;
+        free( text );
+        return hr;
+    }
+#ifdef SG_MUTANT_WEBHDR_JOIN
+    if (e && !replace)
+#else
+    if (e && !replace && !canon)
+#endif
+    {
+        /* an unknown (or text valued) header seen again carries both values */
+        WCHAR *old = entry_render( e ), *joined;
+        size_t n = (old ? wcslen( old ) : 0) + wcslen( text ) + 3;
+        if (!old || !(joined = malloc( n * sizeof(WCHAR) ))) { free( old ); free( text ); return E_OUTOFMEMORY; }
+        swprintf( joined, n, L"%ls, %ls", old, text );
+        free( old );
+        free( text );
+        free( e->text );
+        e->text = joined;
+        return S_OK;
+    }
+    if (e) headers_remove_entry( impl, e );
+
+    if (!(e = headers_add( impl, name, kind ))) { free( text ); return E_OUTOFMEMORY; }
+    if (kind == ENT_CODINGS || kind == ENT_LANGS)
+    {
+        struct objvec *vec;
+        free( text );
+        if (FAILED( hr = objvec_create( kind == ENT_CODINGS ? VEC_CODINGS : VEC_LANGS, &vec ) ))
+        { impl->count--; entry_clear( e ); return hr; }
+        e->obj = (IInspectable *)&vec->IVector_iface;
+        text = wdup_n( v, vlen );
+        hr = text ? vec_parse_add( vec, text ) : E_OUTOFMEMORY;
+        free( text );
+        if (FAILED( hr ) && !validate) hr = S_OK;
+        return hr;
+    }
+    e->text = text;
+    if (kind != ENT_TEXT) entry_materialize( impl, e );
+    return S_OK;
+}
+
+static BOOL headers_remove( struct content_headers *impl, const WCHAR *name )
+{
+    struct entry *e = headers_find( impl, name );
+    if (!e) return FALSE;
+    headers_remove_entry( impl, e );
+    return TRUE;
+}
