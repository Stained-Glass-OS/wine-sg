diff --git a/dlls/windows.web/http_content_headers.c b/dlls/windows.web/http_content_headers.c
new file mode 100644
index 0000000..90a8a9f
--- /dev/null
+++ b/dlls/windows.web/http_content_headers.c
@@ -0,0 +1,3178 @@
+/* WinRT Windows.Web.Http.Headers.HttpContentHeaderCollection and the typed
+ * header value classes it hands out (HttpMediaTypeHeaderValue,
+ * HttpContentDispositionHeaderValue, HttpContentRangeHeaderValue,
+ * HttpContentCodingHeaderValue, HttpNameValueHeaderValue).
+ *
+ * The collection keeps one ordered list of headers. Headers whose typed
+ * accessor returns an object (Content-Type, Content-Disposition, Content-Range,
+ * Content-Encoding, Content-Language) keep that live object, so changes made
+ * through it show up in the map face, the iteration and ToString. The others
+ * (Content-Length, Content-Location, Content-MD5, Expires, Last-Modified) are
+ * kept as their header text and parsed on every typed read.
+ *
+ * Parsing and rendering follow RFC 7230/7231/7233/6266 and the documented
+ * behaviour of the .NET header model that this API mirrors. Choices made
+ * without a documented answer are listed in patches/notes/3290.txt.
+ *
+ * Copyright (C) 2026 Stained Glass OS contributors
