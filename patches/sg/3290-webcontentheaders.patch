+static HRESULT WINAPI typed_ch_get_ContentLocation( IHttpContentHeaderCollection *iface, IInspectable **value )
+{
+    struct entry *e = headers_find( impl_from_typed( iface ), L"Content-Location" );
+    IUriRuntimeClassFactory *factory;
+    IUriRuntimeClass *uri;
+    HSTRING name, str;
+    HRESULT hr;
+
+    TRACE( "iface %p.\n", iface );
+    *value = NULL;
+    if (!e || !e->text) return S_OK;
+    if (FAILED( hr = WindowsCreateString( RuntimeClass_Windows_Foundation_Uri,
+                                          wcslen( RuntimeClass_Windows_Foundation_Uri ), &name ) )) return hr;
+    hr = RoGetActivationFactory( name, &IID_IUriRuntimeClassFactory, (void **)&factory );
+    WindowsDeleteString( name );
+    if (FAILED( hr )) return hr;
+    if (SUCCEEDED( hr = hs_new( e->text, &str ) ))
+    {
+        hr = IUriRuntimeClassFactory_CreateUri( factory, str, &uri );
+        WindowsDeleteString( str );
+        if (SUCCEEDED( hr )) *value = (IInspectable *)uri;
+        else hr = S_OK;                /* a value that is no Uri reads as null */
+    }
+    IUriRuntimeClassFactory_Release( factory );
+    return hr;
+}
