+/* ---- snapshots of the (name, value) list --------------------------------- */
+
+struct pair { WCHAR *name, *value; };
+struct snapshot { struct pair *pairs; unsigned int count; };
+
+static void snapshot_free( struct snapshot *s )
+{
+    unsigned int i;
+    for (i = 0; i < s->count; i++) { free( s->pairs[i].name ); free( s->pairs[i].value ); }
+    free( s->pairs );
+    s->pairs = NULL;
+    s->count = 0;
+}
+static HRESULT snapshot_take( struct content_headers *impl, struct snapshot *s )
+{
+    unsigned int i;
+
+    s->pairs = NULL;
+    s->count = 0;
+    if (impl->count && !(s->pairs = calloc( impl->count, sizeof(*s->pairs) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < impl->count; i++)
+    {
+        WCHAR *text = entry_render( &impl->entries[i] );
+        if (!text) continue;              /* an empty typed collection is not a header */
+        s->pairs[s->count].name = wdup( impl->entries[i].name );
+        s->pairs[s->count].value = text;
+        if (!s->pairs[s->count].name) { free( text ); snapshot_free( s ); return E_OUTOFMEMORY; }
+        s->count++;
+    }
+    return S_OK;
+}
