+/* -- IIterable / IIterator faces */
+struct vec_iter
+{
+    IIterator_IInspectable IIterator_iface;
+    LONG ref;
+    struct objvec *vec;
+    UINT32 index;
+    const IID *iid;
+};
+static inline struct vec_iter *vec_iter_from( IIterator_IInspectable *iface )
+{ return CONTAINING_RECORD( iface, struct vec_iter, IIterator_iface ); }
+static HRESULT WINAPI vec_iter_QueryInterface( IIterator_IInspectable *iface, REFIID iid, void **out )
+{
+    struct vec_iter *it = vec_iter_from( iface );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, it->iid ))
+    {
+        *out = iface;
+        InterlockedIncrement( &it->ref );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI vec_iter_AddRef( IIterator_IInspectable *iface )
+{ return InterlockedIncrement( &vec_iter_from( iface )->ref ); }
+static ULONG WINAPI vec_iter_Release( IIterator_IInspectable *iface )
+{
+    struct vec_iter *it = vec_iter_from( iface );
+    ULONG ref = InterlockedDecrement( &it->ref );
+    if (!ref) { vec_release( it->vec ); free( it ); }
+    return ref;
+}
+static HRESULT WINAPI vec_iter_GetIids( IIterator_IInspectable *iface, ULONG *c, IID **i )
+{
+    const IID *ids[1];
+    ids[0] = vec_iter_from( iface )->iid;
+    return web_get_iids( ids, 1, c, i );
+}
+static HRESULT WINAPI vec_iter_GetRuntimeClassName( IIterator_IInspectable *iface, HSTRING *n )
+{ return web_class_name( L"Windows.Foundation.Collections.IIterator`1", n ); }
+static HRESULT WINAPI vec_iter_GetTrustLevel( IIterator_IInspectable *iface, TrustLevel *t )
+{ *t = BaseTrust; return S_OK; }
+static HRESULT WINAPI vec_iter_get_Current( IIterator_IInspectable *iface, IInspectable **value )
+{
+    struct vec_iter *it = vec_iter_from( iface );
+    return vec_get_at( it->vec, it->index, value );
+}
+static HRESULT WINAPI vec_iter_get_HasCurrent( IIterator_IInspectable *iface, boolean *value )
+{
+    struct vec_iter *it = vec_iter_from( iface );
+    *value = it->index < it->vec->count;
+    return S_OK;
+}
+static HRESULT WINAPI vec_iter_MoveNext( IIterator_IInspectable *iface, boolean *value )
+{
+    struct vec_iter *it = vec_iter_from( iface );
+    if (it->index < it->vec->count) it->index++;
+    *value = it->index < it->vec->count;
+    return S_OK;
+}
+static HRESULT WINAPI vec_iter_GetMany( IIterator_IInspectable *iface, UINT32 count, IInspectable **items, UINT32 *actual )
+{
+    struct vec_iter *it = vec_iter_from( iface );
+    HRESULT hr = vec_get_many( it->vec, it->index, count, items, actual );
+    if (SUCCEEDED( hr )) it->index += *actual;
+    return hr;
+}
+static const IIterator_IInspectableVtbl vec_iter_vtbl =
+{
+    vec_iter_QueryInterface, vec_iter_AddRef, vec_iter_Release,
+    vec_iter_GetIids, vec_iter_GetRuntimeClassName, vec_iter_GetTrustLevel,
+    vec_iter_get_Current, vec_iter_get_HasCurrent, vec_iter_MoveNext, vec_iter_GetMany,
+};
