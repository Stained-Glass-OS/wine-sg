+{ *t = BaseTrust; return S_OK; }
+static HRESULT WINAPI vec_vector_GetAt( IVector_IInspectable *iface, UINT32 index, IInspectable **value )
+{ return vec_get_at( vec_from_vector( iface ), index, value ); }
+static HRESULT WINAPI vec_vector_get_Size( IVector_IInspectable *iface, UINT32 *size )
+{ *size = vec_from_vector( iface )->count; return S_OK; }
+static HRESULT WINAPI vec_vector_GetView( IVector_IInspectable *iface, IVectorView_IInspectable **view )
+{
+    struct objvec *vec = vec_from_vector( iface );
+    *view = &vec->IVectorView_iface;
+    InterlockedIncrement( &vec->ref );
+    return S_OK;
+}
+static HRESULT WINAPI vec_vector_IndexOf( IVector_IInspectable *iface, IInspectable *value, UINT32 *index, boolean *found )
+{
+    struct objvec *vec = vec_from_vector( iface );
+    UINT32 i;
+    *index = 0;
+    *found = FALSE;
+    for (i = 0; i < vec->count; i++)
+        if (vec_same( vec, vec->items[i], value )) { *index = i; *found = TRUE; break; }
+    return S_OK;
+}
+static HRESULT WINAPI vec_vector_SetAt( IVector_IInspectable *iface, UINT32 index, IInspectable *value )
+{
+    struct objvec *vec = vec_from_vector( iface );
+    void *item;
+    HRESULT hr;
+    if (index >= vec->count) return E_BOUNDS;
+    if (FAILED( hr = vec_take( vec, value, &item ) )) return hr;
+    vec_free_item( vec, vec->items[index] );
+    vec->items[index] = item;
+    return S_OK;
+}
+static HRESULT WINAPI vec_vector_InsertAt( IVector_IInspectable *iface, UINT32 index, IInspectable *value )
+{ return vec_insert( vec_from_vector( iface ), index, value ); }
+static HRESULT WINAPI vec_vector_RemoveAt( IVector_IInspectable *iface, UINT32 index )
+{ return vec_remove( vec_from_vector( iface ), index ); }
+static HRESULT WINAPI vec_vector_Append( IVector_IInspectable *iface, IInspectable *value )
+{
+    struct objvec *vec = vec_from_vector( iface );
+    return vec_insert( vec, vec->count, value );
+}
+static HRESULT WINAPI vec_vector_RemoveAtEnd( IVector_IInspectable *iface )
+{
+    struct objvec *vec = vec_from_vector( iface );
+    if (!vec->count) return E_BOUNDS;
+    return vec_remove( vec, vec->count - 1 );
+}
+static HRESULT WINAPI vec_vector_Clear( IVector_IInspectable *iface )
+{
+    struct objvec *vec = vec_from_vector( iface );
+    while (vec->count) vec_remove( vec, vec->count - 1 );
+    return S_OK;
+}
+static HRESULT WINAPI vec_vector_GetMany( IVector_IInspectable *iface, UINT32 start, UINT32 count,
+        IInspectable **items, UINT32 *actual )
+{ return vec_get_many( vec_from_vector( iface ), start, count, items, actual ); }
+static HRESULT WINAPI vec_vector_ReplaceAll( IVector_IInspectable *iface, UINT32 count, IInspectable **items )
+{
+    struct objvec *vec = vec_from_vector( iface );
+    void **new_items = NULL;
+    UINT32 i;
+    HRESULT hr = S_OK;
+
+    if (count && !(new_items = calloc( count, sizeof(*new_items) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+        if (FAILED( hr = vec_take( vec, items[i], &new_items[i] ) )) break;
+    if (FAILED( hr ))
+    {
+        while (i--) vec_free_item( vec, new_items[i] );
+        free( new_items );
+        return hr;
+    }
+    for (i = 0; i < vec->count; i++) vec_free_item( vec, vec->items[i] );
+    free( vec->items );
+    vec->items = new_items;
+    vec->count = vec->cap = count;
+    return S_OK;
+}
+static const IVector_IInspectableVtbl vec_vector_vtbl =
+{
+    vec_vector_QueryInterface, vec_vector_AddRef, vec_vector_Release,
+    vec_vector_GetIids, vec_vector_GetRuntimeClassName, vec_vector_GetTrustLevel,
+    vec_vector_GetAt, vec_vector_get_Size, vec_vector_GetView, vec_vector_IndexOf, vec_vector_SetAt,
+    vec_vector_InsertAt, vec_vector_RemoveAt, vec_vector_Append, vec_vector_RemoveAtEnd,
+    vec_vector_Clear, vec_vector_GetMany, vec_vector_ReplaceAll,
+};
