+/* -- IVector face */
+static HRESULT WINAPI vec_vector_QueryInterface( IVector_IInspectable *iface, REFIID iid, void **out )
+{ return vec_QI( vec_from_vector( iface ), iid, out ); }
+static ULONG WINAPI vec_vector_AddRef( IVector_IInspectable *iface )
+{ return InterlockedIncrement( &vec_from_vector( iface )->ref ); }
+static ULONG WINAPI vec_vector_Release( IVector_IInspectable *iface )
+{ return vec_release( vec_from_vector( iface ) ); }
+static HRESULT WINAPI vec_vector_GetIids( IVector_IInspectable *iface, ULONG *c, IID **i )
+{ return vec_get_iids( vec_from_vector( iface ), c, i ); }
+static HRESULT WINAPI vec_vector_GetRuntimeClassName( IVector_IInspectable *iface, HSTRING *n )
+{ return web_class_name( vec_from_vector( iface )->class_name, n ); }
