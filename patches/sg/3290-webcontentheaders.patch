+/* parse a comma separated list and add every item */
+static HRESULT vec_parse_add( struct objvec *vec, const WCHAR *list )
+{
+    const WCHAR *p = list;
+    HRESULT hr = S_OK;
+    BOOL any = FALSE;
+
+    while (*p)
+    {
+        const WCHAR *end = wcschr( p, ',' ), *item = p;
+        size_t len = end ? (size_t)(end - p) : wcslen( p );
+        trim( &item, &len );
+        p = end ? end + 1 : p + wcslen( p );
+        if (!len) continue;               /* empty list elements are allowed by RFC 7230 */
+        if (!is_token( item, len )) return E_INVALIDARG;
+        any = TRUE;
+    }
+    if (!any) return E_INVALIDARG;
+
+    p = list;
+    while (*p)
+    {
+        const WCHAR *end = wcschr( p, ',' ), *item = p;
+        size_t len = end ? (size_t)(end - p) : wcslen( p );
+        trim( &item, &len );
+        p = end ? end + 1 : p + wcslen( p );
+        if (!len) continue;
+        if (vec->kind == VEC_STRING)
+        {
+            HSTRING s;
+            if (FAILED( hr = WindowsCreateString( item, len, &s ) )) return hr;
+            hr = vec_insert( vec, vec->count, (IInspectable *)s );
+            WindowsDeleteString( s );
+        }
+        else
+        {
+            IHttpContentCodingHeaderValue *coding;
+            if (FAILED( hr = coding_create_from_token( item, len, &coding ) )) return hr;
+            hr = vec_insert( vec, vec->count, (IInspectable *)coding );
+            IHttpContentCodingHeaderValue_Release( coding );
+        }
+        if (FAILED( hr )) return hr;
+    }
+    return S_OK;
+}
