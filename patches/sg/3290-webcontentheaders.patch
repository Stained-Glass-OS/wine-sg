+static IInspectable *content_headers( struct http_content *impl )
+{
+    IInspectable *headers, *old;
+
+    if (impl->headers) return impl->headers;
+    if (FAILED( http_content_headers_create( impl->len, impl->media_type, &headers ) )) return NULL;
+    old = InterlockedCompareExchangePointer( (void **)&impl->headers, headers, NULL );
+    if (old) { IInspectable_Release( headers ); return old; }
+    return headers;
+}
+
+/* The headers that describe a received body, taken from the raw response header block. */
+void http_content_set_raw_headers( IHttpContent *iface, const WCHAR *raw )
+{
+    struct http_content *impl;
+    IInspectable *headers;
+    if (!iface || iface->lpVtbl != &content_vtbl || !raw) return;
+    impl = impl_from_IHttpContent( iface );
+    if ((headers = content_headers( impl ))) http_content_headers_merge_raw( headers, raw );
+}
+
+/* Content headers other than Content-Type and Content-Length, as header lines (malloc'd), for the transport */
+WCHAR *http_content_extra_header_lines( IHttpContent *iface )
+{
+    struct http_content *impl;
+    if (!iface || iface->lpVtbl != &content_vtbl) return NULL;
+    impl = impl_from_IHttpContent( iface );
+    return impl->headers ? http_content_headers_lines( impl->headers ) : NULL;
+}
