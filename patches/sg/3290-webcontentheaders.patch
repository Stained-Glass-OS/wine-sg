+/* "name" or "name=value" */
+static HRESULT nv_parse_piece( const WCHAR *piece, IHttpNameValueHeaderValue **out )
+{
+    const WCHAR *eq = wcschr( piece, '=' ), *name = piece, *value = NULL;
+    size_t nlen = eq ? (size_t)(eq - piece) : wcslen( piece ), vlen = 0;
+
+    trim( &name, &nlen );
+    if (eq)
+    {
+        value = eq + 1;
+        vlen = wcslen( value );
+        trim( &value, &vlen );
+    }
+    return nv_create( name, nlen, value, vlen, !!eq, out );
