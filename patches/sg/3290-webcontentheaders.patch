+{ *t = BaseTrust; return S_OK; }
+static HRESULT WINAPI vec_iterable_First( IIterable_IInspectable *iface, IIterator_IInspectable **value )
+{
+    struct objvec *vec = vec_from_iterable( iface );
+    struct vec_iter *it;
+
+    if (!(it = calloc( 1, sizeof(*it) ))) return E_OUTOFMEMORY;
+    it->IIterator_iface.lpVtbl = &vec_iter_vtbl;
+    it->ref = 1;
+    it->vec = vec;
+    it->iid = vec->kind == VEC_STRING ? &IID_IIterator_HSTRING
+            : (vec->iid_elem == &IID_IHttpNameValueHeaderValue ? &IID_IIterator_HttpNameValueHeaderValue
+                                                                : &IID_IIterator_HttpContentCodingHeaderValue);
+    InterlockedIncrement( &vec->ref );
+    *value = &it->IIterator_iface;
+    return S_OK;
+}
