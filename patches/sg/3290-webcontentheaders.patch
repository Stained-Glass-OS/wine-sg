+/* ---- parameter list helpers (shared by media type and disposition) ------ */
+
+/* the first parameter called name (case-insensitive), or NULL */
+static IHttpNameValueHeaderValue *params_find( struct objvec *params, const WCHAR *name, UINT32 *index )
+{
+    UINT32 i;
+    for (i = 0; i < params->count; i++)
+    {
+        IHttpNameValueHeaderValue *nv_iface = params->items[i];
+        if (!wcsicmp( nv_name( nv_iface ), name )) { if (index) *index = i; return nv_iface; }
+    }
+    return NULL;
+}
+/* a parameter's text without quotes, NULL when absent */
+static WCHAR *params_get_text( struct objvec *params, const WCHAR *name )
+{
+    IHttpNameValueHeaderValue *nv_iface = params_find( params, name, NULL );
+    if (!nv_iface || !nv_value( nv_iface )) return NULL;
+    return unquote( nv_value( nv_iface ) );
+}
+/* set (value != NULL, stored as given) or remove (value NULL) */
+static HRESULT params_set( struct objvec *params, const WCHAR *name, const WCHAR *value )
+{
+    IHttpNameValueHeaderValue *nv_iface;
+    UINT32 index;
+    HRESULT hr;
+
+    if ((nv_iface = params_find( params, name, &index )))
+    {
+        if (!value) return vec_remove( params, index );
+        {
+            struct nv *impl = CONTAINING_RECORD( nv_iface, struct nv, IHttpNameValueHeaderValue_iface );
+            WCHAR *copy = wdup( value );
+            if (!copy) return E_OUTOFMEMORY;
+            free( impl->value );
+            impl->value = copy;
+            return S_OK;
+        }
+    }
+    if (!value) return S_OK;
+    if (FAILED( hr = nv_create( name, wcslen( name ), value, wcslen( value ), TRUE, &nv_iface ) )) return hr;
+    hr = vec_insert( params, params->count, (IInspectable *)nv_iface );
+    IHttpNameValueHeaderValue_Release( nv_iface );
+    return hr;
+}
+static BOOL params_render( struct objvec *params, struct sb *b )
+{
+    UINT32 i;
+    for (i = 0; i < params->count; i++)
+    {
+        IHttpNameValueHeaderValue *nv_iface = params->items[i];
+        if (!sb_add( b, L"; " ) || !sb_add( b, nv_name( nv_iface ) )) return FALSE;
+        if (nv_value( nv_iface ) && (!sb_add( b, L"=" ) || !sb_add( b, nv_value( nv_iface ) ))) return FALSE;
+    }
+    return TRUE;
+}
+/* parse pieces[1..n) into params; any malformed piece fails the whole parse */
+static HRESULT params_parse( struct objvec *params, WCHAR **pieces, unsigned int n )
+{
+    unsigned int i;
+    HRESULT hr;
+    for (i = 1; i < n; i++)
+    {
+        IHttpNameValueHeaderValue *nv_iface;
+        if (!pieces[i][0]) continue;       /* "a;;b" tolerated */
+        if (FAILED( hr = nv_parse_piece( pieces[i], &nv_iface ) )) return hr;
+        hr = vec_insert( params, params->count, (IInspectable *)nv_iface );
+        IHttpNameValueHeaderValue_Release( nv_iface );
+        if (FAILED( hr )) return hr;
+    }
+    return S_OK;
+}
