-/* UTF-8 encode a string into a fresh content object. */
-static HRESULT content_from_string( HSTRING str, const WCHAR *media_type, IHttpContent **out )
+/* Encode a string into a fresh content object. encoding is a UnicodeEncoding
+ * (0 UTF-8, 1 UTF-16LE, 2 UTF-16BE); the content type is the media type
+ * (default text/plain) with the charset of the encoding, as HttpStringContent
+ * documents. */
+static HRESULT content_from_string( HSTRING str, INT32 encoding, const WCHAR *media_type, IHttpContent **out )
 {
+    static const WCHAR *const charsets[] = { L"utf-8", L"utf-16LE", L"utf-16BE" };
     UINT32 wlen = 0;
     const WCHAR *w = WindowsGetStringRawBuffer( str, &wlen );
-    int bytes = WideCharToMultiByte( CP_UTF8, 0, w, wlen, NULL, 0, NULL, NULL );
-    BYTE *data = malloc( bytes ? bytes : 1 );
-    if (!data) return E_OUTOFMEMORY;
-    if (bytes) WideCharToMultiByte( CP_UTF8, 0, w, wlen, (char *)data, bytes, NULL, NULL );
-    return http_content_create( data, bytes, media_type, out );
+    BYTE *data;
+    UINT32 bytes, i;
+    WCHAR *type;
+    size_t n;
+    HRESULT hr;
+
+    if (encoding < 0 || encoding > 2) return E_INVALIDARG;
+    if (encoding == 0)
+    {
+        bytes = WideCharToMultiByte( CP_UTF8, 0, w, wlen, NULL, 0, NULL, NULL );
+        data = malloc( bytes ? bytes : 1 );
+        if (!data) return E_OUTOFMEMORY;
+        if (bytes) WideCharToMultiByte( CP_UTF8, 0, w, wlen, (char *)data, bytes, NULL, NULL );
+    }
+    else
+    {
+        bytes = wlen * sizeof(WCHAR);
+        data = malloc( bytes ? bytes : 1 );
+        if (!data) return E_OUTOFMEMORY;
+        for (i = 0; i < wlen; i++)
+        {
+            data[2 * i + (encoding == 1 ? 0 : 1)] = w[i] & 0xff;
+            data[2 * i + (encoding == 1 ? 1 : 0)] = w[i] >> 8;
+        }
+    }
+    if (!media_type || !*media_type) media_type = L"text/plain";
+    n = wcslen( media_type ) + wcslen( charsets[encoding] ) + 16;
+    if (!(type = malloc( n * sizeof(WCHAR) ))) { free( data ); return E_OUTOFMEMORY; }
+#ifdef SG_MUTANT_WEBHDR_CHARSETDEF
+    swprintf( type, n, L"%ls", media_type );
+#else
+    swprintf( type, n, L"%ls; charset=%ls", media_type, charsets[encoding] );
+#endif
+    hr = http_content_create( data, bytes, type, out );
+    free( type );
+    if (SUCCEEDED( hr )) impl_from_IHttpContent( *out )->encoding = encoding;
+    return hr;
 }
 
