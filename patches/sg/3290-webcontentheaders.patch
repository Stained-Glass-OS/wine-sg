+/* an object property: the live object, parsed from the header text on first use; NULL when absent or invalid */
+static HRESULT get_object( IHttpContentHeaderCollection *iface, const WCHAR *name, IInspectable **value )
+{
+    struct content_headers *impl = impl_from_typed( iface );
+    struct entry *e = headers_find( impl, name );
+    *value = NULL;
+    if (!e || !entry_materialize( impl, e )) return S_OK;
+    IInspectable_AddRef( e->obj );
+    *value = e->obj;
+    return S_OK;
+}
+/* assign an object property: our own object is kept (so later changes to it show in the
+ * header), a foreign one is read through its text */
+static BOOL is_own_object( enum entry_kind kind, IInspectable *value )
+{
+    switch (kind)
+    {
+    case ENT_MEDIA: return ((IHttpMediaTypeHeaderValue *)value)->lpVtbl == &media_vtbl;
+    case ENT_DISP: return ((IHttpContentDispositionHeaderValue *)value)->lpVtbl == &disp_vtbl;
+    case ENT_RANGE: return ((IHttpContentRangeHeaderValue *)value)->lpVtbl == &range_vtbl;
+    default: return FALSE;
+    }
+}
+static HRESULT put_object( IHttpContentHeaderCollection *iface, const WCHAR *name, const IID *iid, IInspectable *value )
+{
+    struct content_headers *impl = impl_from_typed( iface );
+    enum entry_kind kind;
+    struct entry *e;
+    IStringable *str;
+    HSTRING hs = NULL;
+    WCHAR *text;
+    HRESULT hr;
+
+    canonical_name( name, &kind );
+    if (!value) { headers_remove( impl, name ); return S_OK; }
+#ifdef SG_MUTANT_WEBHDR_LIVE
+    if (0)
+#else
+    if (is_own_object( kind, value ))
+#endif
+    {
+        headers_remove( impl, name );
+        if (!(e = headers_add( impl, name, kind ))) return E_OUTOFMEMORY;
+        IInspectable_AddRef( value );
+        e->obj = value;
+        return S_OK;
+    }
+    if (FAILED( hr = IInspectable_QueryInterface( value, &IID_IStringable, (void **)&str ) )) return E_INVALIDARG;
+    hr = IStringable_ToString( str, &hs );
+    IStringable_Release( str );
+    if (FAILED( hr )) return hr;
+    text = hs_dup( hs );
+    WindowsDeleteString( hs );
+    if (!text) return E_OUTOFMEMORY;
+    headers_remove( impl, name );
+    if (!(e = headers_add( impl, name, kind ))) { free( text ); return E_OUTOFMEMORY; }
+    e->text = text;
+    if (!entry_materialize( impl, e )) { headers_remove_entry( impl, e ); return E_INVALIDARG; }
+    return S_OK;
+}
