From: Stained Glass OS <dev@stained-glass.example>
Subject: server: admit a peer that holds the shared prefix's group

A shared prefix admits root, the server directory's owner and members of its
group (patch 0001), and asked NSS for the membership: getgrouplist() on the
peer's user name. A process can hold the group without any group file saying
so -- given by pam_group at sign-in, by sg/newgrp, by a unit's
SupplementaryGroups= -- and then the kernel lets it open every file in the
prefix while the server refused it the connection.

Also admit a peer whose own supplementary groups, as the kernel reports them
for the connection (SO_PEERGROUPS), include the directory's group. That is
the same membership the kernel checks the peer's file access against, so it
admits nobody who could not already open the prefix.

--- a/server/request.c
+++ b/server/request.c
@@ -608,6 +608,32 @@
  * Admitted: root, the owner of the server directory, and members of the group
  * owning it. Which users that group contains is an administrative decision,
  * expressed with ordinary Unix tools rather than a policy file of our own. */
+/* Does the connecting process itself hold this group? SO_PEERGROUPS is the
+ * kernel's list of the peer's supplementary groups at connect time -- what its
+ * file access is checked against too. A process can hold the group with no
+ * group file saying so (pam_group, sg/newgrp, SupplementaryGroups=), and then
+ * asking NSS (uid_in_group) says no. */
+static int peer_holds_group( int client, gid_t gid )
+{
+#ifdef SO_PEERGROUPS
+    gid_t stack[64], *groups = stack;
+    socklen_t len = sizeof(stack);
+    int i, count, ret = 0;
+
+    if (getsockopt( client, SOL_SOCKET, SO_PEERGROUPS, groups, &len ) == -1)
+    {
+        if (errno != ERANGE || !(groups = malloc( len ))) return 0;
+        if (getsockopt( client, SOL_SOCKET, SO_PEERGROUPS, groups, &len ) == -1) { free( groups ); return 0; }
+    }
+    count = len / sizeof(gid_t);
+    for (i = 0; i < count; i++) if (groups[i] == gid) { ret = 1; break; }
+    if (groups != stack) free( groups );
+    return ret;
+#else
+    return 0;
+#endif
+}
+
 static int check_peer_credentials( int client, uid_t *peer_uid )
 {
     struct ucred cred;
@@ -625,6 +651,7 @@
     *peer_uid = cred.uid;
     if (cred.uid == 0 || cred.uid == server_dir_uid) return 1;
     if (uid_in_group( cred.uid, server_dir_gid )) return 1;
+    if (peer_holds_group( client, server_dir_gid )) return 1;
 
     fprintf( stderr, "wineserver: refusing connection from uid %u: not a member of gid %u\n",
              (unsigned int)cred.uid, (unsigned int)server_dir_gid );
