@@ -28,6 +31,7 @@
 #include <stdarg.h>
 #include "windef.h"
 #include "winbase.h"
+#include "wingdi.h"
 #include "winuser.h"
 #include "shellapi.h"
 #include "wine/debug.h"
@@ -175,6 +179,121 @@
     ShowWindowAsync( hwnd, SW_MAXIMIZE );
 }
 
+/* ---- snapping by dragging ---------------------------------------------- */
+
+#define SNAP_TIMER 0x5780
+static HWND drag_hwnd, preview;
+static SIZE drag_size;
+static int drag_target;          /* 0 none, -1 left, 1 right, 2 top (maximize) */
+
+static void target_rect( HWND hwnd, int target, RECT *rc )
+{
+    RECT work;
+    work_area( hwnd, &work );
+    *rc = work;
+    if (target == -1) rc->right = (work.left + work.right) / 2;
+    else if (target == 1) rc->left = (work.left + work.right) / 2;
+}
+
+static LRESULT CALLBACK preview_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    if (msg == WM_ERASEBKGND)
+    {
+        RECT rc;
+        HBRUSH brush = CreateSolidBrush( RGB(0x8A,0x2B,0xE2) );
+        GetClientRect( hwnd, &rc );
+        FillRect( (HDC)wp, &rc, brush );
+        DeleteObject( brush );
+        return 1;
+    }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+/* the outline of where the window will go: a frame, drawn as a window region */
+static void show_preview( int target )
+{
+    RECT rc;
+    HRGN outer, inner;
+    int w, h, b = 4;
+
+    if (!target)
+    {
+        if (preview) ShowWindow( preview, SW_HIDE );
+        return;
+    }
+    target_rect( drag_hwnd, target, &rc );
+    InflateRect( &rc, -6, -6 );
+    w = rc.right - rc.left; h = rc.bottom - rc.top;
+    if (!preview)
+        preview = CreateWindowExW( WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE | WS_EX_TRANSPARENT, L"SgSnapPreview", L"",
+                                   WS_POPUP, 0, 0, 0, 0, 0, 0, 0, 0 );
+    if (!preview) return;
+    outer = CreateRectRgn( 0, 0, w, h );
+    inner = CreateRectRgn( b, b, w - b, h - b );
+    CombineRgn( outer, outer, inner, RGN_DIFF );
+    DeleteObject( inner );
+    SetWindowRgn( preview, outer, FALSE );
+    /* beneath the window being dragged */
+    SetWindowPos( preview, drag_hwnd, rc.left, rc.top, w, h, SWP_NOACTIVATE | SWP_SHOWWINDOW );
+    InvalidateRect( preview, NULL, TRUE );
+}
+
+static void CALLBACK snap_timer( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
+{
+    POINT pt;
+    RECT work;
+    int target = 0;
+
+    if (!drag_hwnd) return;
+    GetCursorPos( &pt );
+    work_area( drag_hwnd, &work );
+    if (pt.x <= work.left + 1) target = -1;
+    else if (pt.x >= work.right - 2) target = 1;
+    else if (pt.y <= work.top + 1) target = 2;
+    if (target != drag_target)
+    {
+        drag_target = target;
+        show_preview( target );
+    }
+}
+
+static void CALLBACK move_size_event( HWINEVENTHOOK hook, DWORD event, HWND hwnd, LONG object, LONG child,
+                                      DWORD thread, DWORD time )
+{
+    RECT rc;
+
+    if (object != OBJID_WINDOW || child != CHILDID_SELF || !hwnd) return;
+    if (event == EVENT_SYSTEM_MOVESIZESTART)
+    {
+        if (!is_app( hwnd ) || !(GetWindowLongW( hwnd, GWL_STYLE ) & WS_THICKFRAME)) return;
+        GetWindowRect( hwnd, &rc );
+        drag_hwnd = hwnd;
+        drag_size.cx = rc.right - rc.left;
+        drag_size.cy = rc.bottom - rc.top;
+        drag_target = 0;
+        SetTimer( sk_tray, SNAP_TIMER, 30, snap_timer );
+    }
+    else if (event == EVENT_SYSTEM_MOVESIZEEND && hwnd == drag_hwnd)
+    {
+        int target = drag_target;
+        struct snap *s;
+
+        KillTimer( sk_tray, SNAP_TIMER );
+        show_preview( 0 );
+        drag_hwnd = 0;
+        drag_target = 0;
+        GetWindowRect( hwnd, &rc );
+        /* a move, not a resize, ending at an edge */
+        if (!target || rc.right - rc.left != drag_size.cx || rc.bottom - rc.top != drag_size.cy) return;
+        if (target == 2) { ShowWindowAsync( hwnd, SW_MAXIMIZE ); return; }
+        if (!(s = get_snap( hwnd, TRUE ))) return;
+        if (!s->side) s->restore = rc;
+        target_rect( hwnd, target, &rc );
+        SetWindowPos( hwnd, 0, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, SWP_NOZORDER );
+        s->side = target;
+    }
+}
+
 /* ---- programs ------------------------------------------------------------- */
 
 static void run( const WCHAR *file, const WCHAR *params )
@@ -319,4 +438,12 @@
     RegisterHotKey( tray, SK_MAXIMIZE, MOD_WIN, VK_UP );
     RegisterHotKey( tray, SK_DOWN, MOD_WIN, VK_DOWN );
     sk_hook = SetWindowsHookExW( WH_KEYBOARD_LL, win_key_proc, GetModuleHandleW( NULL ), 0 );
+    {
+        WNDCLASSW wc = { 0 };
+        wc.lpfnWndProc = preview_proc;
+        wc.lpszClassName = L"SgSnapPreview";
+        RegisterClassW( &wc );
+    }
+    SetWinEventHook( EVENT_SYSTEM_MOVESIZESTART, EVENT_SYSTEM_MOVESIZEEND, NULL, move_size_event, 0, 0,
+                     WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS );
 }
