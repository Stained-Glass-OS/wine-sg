From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32, server: ChangeWindowMessageFilter, the process's UIPI filter

ChangeWindowMessageFilter was a stub that said yes and let nothing
through, so an elevated program that opens WM_COPYDATA or WM_DROPFILES to
programs below it (as many do for drag and drop) refused them still. As
documented now:

- ChangeWindowMessageFilter(MSGFLT_ADD/MSGFLT_REMOVE) adds a message to,
  or removes it from, the calling process's filter (any other flag:
  ERROR_INVALID_PARAMETER). The server keeps it with the process (user32
  sets a "__sg_uipi_process_XXXX" property, which the server takes as the
  caller's own and does not store), and UIPI (wine-sg 0291) lets the
  message through to every window of the process.
- A window's own ChangeWindowMessageFilterEx setting goes first:
  MSGFLT_DISALLOW now blocks the message for that window even when the
  process allows it, MSGFLT_RESET gives the window back to the process's
  filter, and ExtStatus says MSGFLTINFO_ALREADYALLOWED_FORWND or
  MSGFLTINFO_ALREADYDISALLOWED_FORWND.

Gate: test/msgfilter-gate.sh (test/msgfilter-probe.c, a medium integrity
sender). Mutant SG_MUTANT_NO_PROCESS_FILTER (server/window.c). The
elevtray gate (0291/0771) still passes.
---
--- a/dlls/user32/message.c
+++ b/dlls/user32/message.c
@@ -1310,7 +1310,21 @@ BOOL WINAPI IsHungAppWindow( HWND hWnd )
  */
 BOOL WINAPI ChangeWindowMessageFilter( UINT message, DWORD flag )
 {
-    FIXME( "%x %08lx\n", message, flag );
+    /* Stained Glass OS 1684: the process's own filter, which the server's
+     * UIPI reads for every window of the process (a window's own
+     * ChangeWindowMessageFilterEx setting goes first) */
+    WCHAR name[32];
+
+    TRACE( "%x %08lx\n", message, flag );
+    if (flag != MSGFLT_ADD && flag != MSGFLT_REMOVE)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (message > 0xffff) return TRUE;
+    swprintf( name, ARRAY_SIZE(name), L"__sg_uipi_process_%04x", message );
+    if (flag == MSGFLT_ADD) return SetPropW( GetDesktopWindow(), name, (HANDLE)1 );
+    RemovePropW( GetDesktopWindow(), name );
     return TRUE;
 }
 
@@ -1341,8 +1355,13 @@ BOOL WINAPI ChangeWindowMessageFilterEx( HWND hwnd, UINT message, DWORD action,
     swprintf( name, ARRAY_SIZE(name), L"__sg_uipi_allow_%04x", message );
     switch (action)
     {
-    case MSGFLT_ALLOW: return SetPropW( hwnd, name, (HANDLE)1 );
+    case MSGFLT_ALLOW:
+        if (changefilter && GetPropW( hwnd, name ) == (HANDLE)1) changefilter->ExtStatus = MSGFLTINFO_ALREADYALLOWED_FORWND;
+        return SetPropW( hwnd, name, (HANDLE)1 );
     case MSGFLT_DISALLOW:
+        /* kept, so it blocks what the process's filter lets through */
+        if (changefilter && GetPropW( hwnd, name ) == (HANDLE)2) changefilter->ExtStatus = MSGFLTINFO_ALREADYDISALLOWED_FORWND;
+        return SetPropW( hwnd, name, (HANDLE)2 );
     case MSGFLT_RESET: RemovePropW( hwnd, name ); return TRUE;
     }
     SetLastError( ERROR_INVALID_PARAMETER );
--- a/server/process.c
+++ b/server/process.c
@@ -729,6 +729,7 @@ struct process *create_process( int fd, struct process *parent, unsigned int fla
     process->token           = NULL;
     process->trace_data      = 0;
     process->rawinput_devices = NULL;
+    process->uipi_allow      = NULL;
     process->rawinput_device_count = 0;
     process->rawinput_mouse  = NULL;
     process->rawinput_kbd    = NULL;
@@ -862,6 +863,7 @@ static void process_destroy( struct object *obj )
     if (process->token) release_object( process->token );
     list_remove( &process->rawinput_entry );
     free( process->rawinput_devices );
+    free( process->uipi_allow );
     free( process->dir_cache );
     free( process->image );
 }
--- a/server/process.h
+++ b/server/process.h
@@ -89,6 +89,7 @@ struct process
     struct pe_image_info image_info;      /* main exe image info */
     unsigned int         child_policy;    /* PROCESS_CREATION_CHILD_PROCESS_* in force (Stained Glass 1641) */
     unsigned __int64     mitigation[2];   /* PROCESS_CREATION_MITIGATION_POLICY(2)_* it was created with */
+    unsigned char       *uipi_allow;      /* Stained Glass OS: ChangeWindowMessageFilter's messages (a bit each) */
 };
 
 /* process functions */
--- a/server/queue.c
+++ b/server/queue.c
@@ -3444,7 +3444,7 @@ DECL_HANDLER(send_message)
 
     if (!uipi_allows( current->process, thread->process, req->msg )
 #ifndef SG_MUTANT_UIPI_NO_FILTER
-        && !window_allows_message( req->win, req->msg )
+        && !window_or_process_allows_message( req->win, req->msg )
 #endif
        )
     {
--- a/server/user.h
+++ b/server/user.h
@@ -124,6 +124,7 @@ extern void add_desktop_hook_count( struct desktop *desktop, struct thread *thre
 /* Stained Glass OS: user interface privilege isolation (queue.c) */
 extern int uipi_allows( struct process *sender, struct process *receiver, unsigned int msg );
 extern int window_allows_message( user_handle_t handle, unsigned int msg );
+extern int window_or_process_allows_message( user_handle_t handle, unsigned int msg );
 
 extern void free_msg_queue( struct thread *thread );
 extern struct hook_table *get_queue_hooks( struct thread *thread );
--- a/server/window.c
+++ b/server/window.c
@@ -573,6 +573,46 @@ static int is_uipi_allow_name( const struct unicode_str *name )
     return 1;
 }
 
+/* Stained Glass OS 1684: ChangeWindowMessageFilter's process-wide filter.
+ * user32 sets a property "__sg_uipi_process_XXXX" on any window; it is not
+ * kept on the window but as the calling process's own allowance. */
+static const WCHAR uipi_process_prefixW[] = {'_','_','s','g','_','u','i','p','i','_','p','r','o','c','e','s','s','_'};
+
+static int uipi_process_message( const struct unicode_str *name )
+{
+    unsigned int i, n = ARRAY_SIZE( uipi_process_prefixW ), msg = 0;
+
+    if (name->len != (n + 4) * sizeof(WCHAR)) return -1;
+    for (i = 0; i < n; i++)
+    {
+        WCHAR c = name->str[i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (c != uipi_process_prefixW[i]) return -1;
+    }
+    for (i = n; i < n + 4; i++)
+    {
+        WCHAR c = name->str[i];
+        msg <<= 4;
+        if (c >= '0' && c <= '9') msg |= c - '0';
+        else if (c >= 'a' && c <= 'f') msg |= c - 'a' + 10;
+        else if (c >= 'A' && c <= 'F') msg |= c - 'A' + 10;
+        else return -1;
+    }
+    return msg;
+}
+
+static void set_process_uipi_allow( struct process *process, unsigned int msg, int allow )
+{
+    if (!process->uipi_allow)
+    {
+        if (!allow) return;
+        if (!(process->uipi_allow = mem_alloc( 0x10000 / 8 ))) return;
+        memset( process->uipi_allow, 0, 0x10000 / 8 );
+    }
+    if (allow) process->uipi_allow[msg / 8] |= 1 << (msg % 8);
+    else process->uipi_allow[msg / 8] &= ~(1 << (msg % 8));
+}
+
 /* has the window's own process let this message through UIPI to it? */
 int window_allows_message( user_handle_t handle, unsigned int msg )
 {
@@ -591,8 +631,42 @@ int window_allows_message( user_handle_t handle, unsigned int msg )
      * beforehand, which would go round that */
     for (i = 0; i < win->prop_inuse; i++)
         if (win->properties[i].type == PROP_TYPE_STRING && win->properties[i].atom == atom)
-            return win->properties[i].data != 0;
+            return win->properties[i].data == 1;  /* 2: MSGFLT_DISALLOW, over the process's filter */
+    return 0;
+}
+
+static int process_allows_message( user_handle_t handle, unsigned int msg )
+{
+    struct window *win;
+
+#ifdef SG_MUTANT_NO_PROCESS_FILTER
     return 0;
+#endif
+    if (msg > 0xffff || !handle || !(win = get_user_object( handle, USER_WINDOW ))) return 0;
+    if (!win->thread || !win->thread->process->uipi_allow) return 0;
+    return (win->thread->process->uipi_allow[msg / 8] >> (msg % 8)) & 1;
+}
+
+/* the window's own allowance, else its process's */
+int window_or_process_allows_message( user_handle_t handle, unsigned int msg )
+{
+    static const char hex[] = "0123456789abcdef";
+    WCHAR nameW[ARRAY_SIZE( uipi_allow_prefixW ) + 4];
+    struct unicode_str name = { nameW, sizeof(nameW) };
+    struct window *win;
+    atom_t atom;
+    int i;
+
+    if (msg <= 0xffff && handle && (win = get_user_object( handle, USER_WINDOW )))
+    {
+        memcpy( nameW, uipi_allow_prefixW, sizeof(uipi_allow_prefixW) );
+        for (i = 0; i < 4; i++) nameW[ARRAY_SIZE( uipi_allow_prefixW ) + i] = hex[(msg >> (12 - 4 * i)) & 0xf];
+        if ((atom = find_global_atom( NULL, &name )))
+            for (i = 0; i < win->prop_inuse; i++)
+                if (win->properties[i].type == PROP_TYPE_STRING && win->properties[i].atom == atom)
+                    return win->properties[i].data == 1;
+    }
+    return process_allows_message( handle, msg );
 }
 
 /* destroy all properties of a window */
@@ -3124,6 +3198,13 @@ DECL_HANDLER(set_window_property)
     if (name.len)
     {
         atom_t atom;
+        int msg;
+
+        if ((msg = uipi_process_message( &name )) >= 0)
+        {
+            set_process_uipi_allow( current->process, msg, req->data != 0 );
+            return;
+        }
 #ifndef SG_MUTANT_UIPI_ALLOW_ANYONE
         if (is_uipi_allow_name( &name ) && (!win->thread || win->thread->process != current->process))
         {
@@ -3150,7 +3231,15 @@ DECL_HANDLER(remove_window_property)
 
     if (win)
     {
-        atom_t atom = name.len ? find_global_atom( NULL, &name ) : req->atom;
+        atom_t atom;
+        int msg;
+
+        if (name.len && (msg = uipi_process_message( &name )) >= 0)
+        {
+            set_process_uipi_allow( current->process, msg, 0 );
+            return;
+        }
+        atom = name.len ? find_global_atom( NULL, &name ) : req->atom;
         if (atom) reply->data = remove_property( win, atom );
     }
 }
