From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: a Start-like popup gone brings the Linux window back again

A passing surface (the Start menu, a flyout) opened while a Linux
program's window (SG Office) was in front puts Wine's desktop in front;
closed without starting anything, the Linux window comes back (0702).
Since 0862 Wine passes over the taskbar when the active window goes away,
and makes the program window behind the popup active instead: the bar
took that for a program started from the popup, and the Linux window
stayed behind Wine's desktop (desktopfront-gate red since 0862).

The program window that was Wine's last in front when the popup came up
coming forward as the popup goes is now known for Wine's own fallback,
not the person's choice: the Linux window comes back, and that window is
deactivated again, so a click on it still brings it forward (0747). A
window shown meanwhile (a program started from the popup) still stays in
front.

Test: test/desktopfront-gate.sh (mutant SG_MUTANT_POPUP_FALLBACK_CANCELS
in systray.c fails it).
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -1918,6 +1918,24 @@
  * sg_restore_popup is up. */
 static HWND sg_restore_popup;
 static unsigned long sg_restore_xwin;
+/* Stained Glass OS: the program window that was Wine's last in front when the
+ * surface came up. The surface gone, Wine makes the next window in Z order
+ * active -- that one, since the taskbar is passed over (0862): its coming
+ * forward is not a program started from the surface, and the Linux window
+ * still comes back */
+static HWND sg_restore_prev;
+static HWND sg_app_foreground;
+
+/* that window came forward with the surface gone */
+static BOOL sg_is_fallback_foreground( HWND hwnd )
+{
+#ifndef SG_MUTANT_POPUP_FALLBACK_CANCELS
+    return hwnd && hwnd == sg_restore_prev &&
+           !(IsWindow( sg_restore_popup ) && IsWindowVisible( sg_restore_popup ));
+#else
+    return FALSE;
+#endif
+}
 static DWORD sg_restore_hidden;   /* when the surface was seen gone (0: not yet) */
 
 static BOOL sg_is_passing_surface( HWND hwnd )
@@ -1951,6 +1969,7 @@
     {
         sg_restore_popup = hwnd;
         sg_restore_xwin = front;
+        sg_restore_prev = sg_app_foreground;
         sg_restore_hidden = 0;
     }
 #endif
@@ -1975,7 +1994,7 @@
     if (GetTickCount() - sg_restore_hidden < 600) return;
     fg = GetForegroundWindow();
     if (!fg || fg == GetDesktopWindow() || fg == tray_window || fg == sg_restore_popup ||
-        !IsWindowVisible( fg ) || sg_is_passing_surface( fg ))
+        !IsWindowVisible( fg ) || sg_is_passing_surface( fg ) || sg_is_fallback_foreground( fg ))
     {
         LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
             if (win->xwin == sg_restore_xwin && !win->xwin_minimized)
@@ -1983,12 +2002,16 @@
                 sg_xwin_command( win, L"XACTIVATE" );
                 sg_xwin_front = TRUE;
                 sg_xwin_front_time = GetTickCount();
+                /* the window Wine fell back to is behind it: deactivated,
+                 * so that a click on it brings it forward (as 0747) */
+                if (sg_is_fallback_foreground( fg )) SetForegroundWindow( GetDesktopWindow() );
                 break;
             }
     }
     sg_restore_popup = NULL;
     sg_restore_xwin = 0;
     sg_restore_hidden = 0;
+    sg_restore_prev = NULL;
 }
 
 /* Stained Glass OS: the last program window in front (not the bar, the
@@ -2030,11 +2053,12 @@
     if (!hwnd || object != OBJID_WINDOW) return;
     /* another window than the passing one came forward: it stays in front */
     if (sg_restore_popup && hwnd != sg_restore_popup && hwnd != GetDesktopWindow() && hwnd != tray_window &&
-        IsWindowVisible( hwnd ) && !sg_is_passing_surface( hwnd ))
+        IsWindowVisible( hwnd ) && !sg_is_passing_surface( hwnd ) && !sg_is_fallback_foreground( hwnd ))
     {
         sg_restore_popup = NULL;
         sg_restore_xwin = 0;
         sg_restore_hidden = 0;
+        sg_restore_prev = NULL;
     }
     if (!sg_xwin_front) return;
     if (hwnd == tray_window || hwnd == GetDesktopWindow() || !IsWindowVisible( hwnd )) return;
@@ -4044,6 +4068,7 @@
         sg_restore_popup = NULL;
         sg_restore_xwin = 0;
         sg_restore_hidden = 0;
+        sg_restore_prev = NULL;
     }
     if (event != EVENT_SYSTEM_FOREGROUND && GetAncestor( hwnd, GA_PARENT ) != GetDesktopWindow()) return;
     /* the bar back on top of a window brought forward or shown -- not of a
