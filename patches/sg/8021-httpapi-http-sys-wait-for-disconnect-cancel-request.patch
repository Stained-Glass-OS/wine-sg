     SOCKET socket;
+    LIST_ENTRY disconnect_irps; /* IOCTL_HTTP_WAIT_DISCONNECT, completed when it closes (wine-sg 8021) */
 
     char *buffer;
     unsigned int len, size;
@@ -140,6 +141,7 @@
         return;
     }
     conn->size = 8192;
+    InitializeListHead(&conn->disconnect_irps);
     WSAEventSelect(peer, request_event, FD_READ | FD_CLOSE);
     ioctlsocket(peer, FIONBIO, &one);
     conn->socket = peer;
@@ -155,8 +157,22 @@
 
 static void close_connection(struct connection *conn)
 {
+    LIST_ENTRY *entry;
+
     if (!conn->shutdown)
         shutdown_connection(conn);
+    /* the waits for its disconnection end */
+    while ((entry = RemoveHeadList(&conn->disconnect_irps)) != &conn->disconnect_irps)
+    {
+        IRP *irp = CONTAINING_RECORD(entry, IRP, Tail.Overlay.ListEntry);
+        if (IoSetCancelRoutine(irp, NULL))
+        {
+            irp->IoStatus.Status = STATUS_SUCCESS;
+            irp->IoStatus.Information = 0;
+            IoCompleteRequest(irp, IO_NO_INCREMENT);
+        }
+        else InitializeListHead(&irp->Tail.Overlay.ListEntry);   /* its cancel routine runs */
+    }
     closesocket(conn->socket);
     list_remove(&conn->entry);
     free(conn);
@@ -1156,6 +1172,81 @@
     return ret;
 }
 
+static void WINAPI http_wait_disconnect_cancel(DEVICE_OBJECT *device, IRP *irp)
+{
+    TRACE("device %p, irp %p.\n", device, irp);
+
+    IoReleaseCancelSpinLock(irp->CancelIrql);
+
+    EnterCriticalSection(&http_cs);
+    RemoveEntryList(&irp->Tail.Overlay.ListEntry);
+    LeaveCriticalSection(&http_cs);
+
+    irp->IoStatus.Status = STATUS_CANCELLED;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+}
+
+/* (wine-sg 8021) HttpWaitForDisconnect: pending until the connection is closed, by either side */
+static NTSTATUS http_wait_disconnect(struct request_queue *queue, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    struct connection *conn, *found = NULL;
+    HTTP_CONNECTION_ID id;
+    NTSTATUS ret;
+
+    if (stack->Parameters.DeviceIoControl.InputBufferLength < sizeof(id)) return STATUS_INVALID_PARAMETER;
+    id = *(HTTP_CONNECTION_ID *)irp->AssociatedIrp.SystemBuffer;
+    TRACE("connection %s.\n", wine_dbgstr_longlong(id));
+
+    EnterCriticalSection(&http_cs);
+    LIST_FOR_EACH_ENTRY(conn, &connections, struct connection, entry)
+        if ((ULONG_PTR)conn == id) { found = conn; break; }
+#ifndef SG_MUTANT_NO_HTTP_DISCONNECT
+    if (!found || found->shutdown)
+        ret = STATUS_CONNECTION_INVALID;
+    else
+    {
+        IoSetCancelRoutine(irp, http_wait_disconnect_cancel);
+        if (irp->Cancel && !IoSetCancelRoutine(irp, NULL))
+            ret = STATUS_CANCELLED;
+        else
+        {
+            IoMarkIrpPending(irp);
+            InsertTailList(&found->disconnect_irps, &irp->Tail.Overlay.ListEntry);
+            ret = STATUS_PENDING;
+        }
+    }
+#else
+    ret = found ? STATUS_SUCCESS : STATUS_CONNECTION_INVALID;
+#endif
+    LeaveCriticalSection(&http_cs);
+    return ret;
+}
+
+/* (wine-sg 8021) HttpCancelHttpRequest: the request's connection is closed -- the client sees a reset,
+ * and the request's waits for a disconnection end */
+static NTSTATUS http_cancel_request(struct request_queue *queue, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    struct connection *conn;
+    HTTP_REQUEST_ID id;
+    NTSTATUS ret = STATUS_CONNECTION_INVALID;
+
+    if (stack->Parameters.DeviceIoControl.InputBufferLength < sizeof(id)) return STATUS_INVALID_PARAMETER;
+    id = *(HTTP_REQUEST_ID *)irp->AssociatedIrp.SystemBuffer;
+    TRACE("request %s.\n", wine_dbgstr_longlong(id));
+    if (id == HTTP_NULL_ID) return STATUS_INVALID_PARAMETER;
+
+    EnterCriticalSection(&http_cs);
+    if ((conn = get_connection(id)) && conn->queue == queue)
+    {
+        close_connection(conn);
+        ret = STATUS_SUCCESS;
+    }
+    LeaveCriticalSection(&http_cs);
+    return ret;
+}
+
 static NTSTATUS http_send_response(struct request_queue *queue, IRP *irp)
 {
     const struct http_response *response = irp->AssociatedIrp.SystemBuffer;
@@ -1277,6 +1368,12 @@
     case IOCTL_HTTP_RECEIVE_BODY:
         ret = http_receive_body(queue, irp);
         break;
+    case IOCTL_HTTP_WAIT_DISCONNECT:
+        ret = http_wait_disconnect(queue, irp);
+        break;
+    case IOCTL_HTTP_CANCEL_REQUEST:
+        ret = http_cancel_request(queue, irp);
+        break;
     default:
         FIXME("Unhandled ioctl %#lx.\n", stack->Parameters.DeviceIoControl.IoControlCode);
         ret = STATUS_NOT_IMPLEMENTED;
--- a/dlls/httpapi/httpapi_main.c
+++ b/dlls/httpapi/httpapi_main.c
@@ -643,6 +643,69 @@
     return remove_url(queue, url);
 }
 
+/* (wine-sg 8021) an ioctl on the queue, waited for when there is no OVERLAPPED */
+static ULONG queue_ioctl(HANDLE queue, DWORD code, void *in, DWORD in_size, OVERLAPPED *ovl)
+{
+    OVERLAPPED sync_ovl;
+    ULONG ret = ERROR_SUCCESS;
+    DWORD size;
+
+    if (!ovl)
+    {
+        memset(&sync_ovl, 0, sizeof(sync_ovl));
+        sync_ovl.hEvent = CreateEventW(NULL, TRUE, FALSE, NULL);
+        ovl = &sync_ovl;
+    }
+    if (!DeviceIoControl(queue, code, in, in_size, NULL, 0, &size, ovl))
+        ret = GetLastError();
+    if (ovl == &sync_ovl)
+    {
+        if (ret == ERROR_IO_PENDING)
+        {
+            ret = ERROR_SUCCESS;
+            if (!GetOverlappedResult(queue, ovl, &size, TRUE))
+                ret = GetLastError();
+        }
+        CloseHandle(sync_ovl.hEvent);
+    }
+    return ret;
+}
+
+/***********************************************************************
+ *        HttpCancelHttpRequest     (HTTPAPI.@)
+ *
+ * (wine-sg 8021) The request is cancelled: its connection is closed.
+ */
+ULONG WINAPI HttpCancelHttpRequest(HANDLE queue, HTTP_REQUEST_ID id, OVERLAPPED *ovl)
+{
+    TRACE("queue %p, id %s, ovl %p.\n", queue, wine_dbgstr_longlong(id), ovl);
+
+    if (!id) return ERROR_INVALID_PARAMETER;
+    return queue_ioctl(queue, IOCTL_HTTP_CANCEL_REQUEST, &id, sizeof(id), ovl);
+}
+
+/***********************************************************************
+ *        HttpWaitForDisconnectEx     (HTTPAPI.@)
+ *
+ * (wine-sg 8021) Completes when the connection closes (ERROR_IO_PENDING until then with an OVERLAPPED);
+ * ERROR_CONNECTION_INVALID for a connection that is not open.
+ */
+ULONG WINAPI HttpWaitForDisconnectEx(HANDLE queue, HTTP_CONNECTION_ID id, ULONG reserved, OVERLAPPED *ovl)
+{
+    TRACE("queue %p, id %s, reserved %#lx, ovl %p.\n", queue, wine_dbgstr_longlong(id), reserved, ovl);
+
+    if (reserved || !id) return ERROR_INVALID_PARAMETER;
+    return queue_ioctl(queue, IOCTL_HTTP_WAIT_DISCONNECT, &id, sizeof(id), ovl);
+}
+
+/***********************************************************************
+ *        HttpWaitForDisconnect     (HTTPAPI.@)
+ */
+ULONG WINAPI HttpWaitForDisconnect(HANDLE queue, HTTP_CONNECTION_ID id, OVERLAPPED *ovl)
+{
+    return HttpWaitForDisconnectEx(queue, id, 0, ovl);
+}
+
 /***********************************************************************
  *        HttpReceiveRequestEntityBody     (HTTPAPI.@)
  */
