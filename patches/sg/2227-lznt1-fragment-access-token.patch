--- a/server/process.c
+++ b/server/process.c
@@ -1757,6 +1757,19 @@ static void set_process_affinity( struct process *process, affinity_t affinity )
     }
 }
 
+/* is the token the token of a process? */
+static int sg_token_in_use( struct token *token )
+{
+    struct process *p;
+
+#ifdef SG_MUTANT_TOKEN_NOT_IN_USE_CHECK
+    return 0;
+#endif
+    LIST_FOR_EACH_ENTRY( p, &process_list, struct process, entry )
+        if (p->token == token) return 1;
+    return 0;
+}
+
 /* set information about a process */
 DECL_HANDLER(set_process_info)
 {
@@ -1783,6 +1796,35 @@ DECL_HANDLER(set_process_info)
                     set_error( STATUS_PRIVILEGE_NOT_HELD );
                     return;
                 }
+                /* as SeAssignPrimaryToken: an impersonation token at least at
+                 * the impersonation level is used as a primary token; a token
+                 * already the token of a process is refused */
+                if (!token_is_primary( token ))
+                {
+                    struct token *primary_token;
+
+                    if (token_get_impersonation_level( token ) < SecurityImpersonation)
+                    {
+                        release_object( token );
+                        release_object( process );
+                        set_error( STATUS_BAD_IMPERSONATION_LEVEL );
+                        return;
+                    }
+                    primary_token = token_duplicate( token, TRUE, 0, NULL, NULL, 0, NULL, 0 );
+                    release_object( token );
+                    if (!(token = primary_token))
+                    {
+                        release_object( process );
+                        return;
+                    }
+                }
+                else if (sg_token_in_use( token ))
+                {
+                    release_object( token );
+                    release_object( process );
+                    set_error( STATUS_TOKEN_ALREADY_IN_USE );
+                    return;
+                }
                 release_object( process->token );
                 process->token = token;
             }
--- a/server/security.h
+++ b/server/security.h
@@ -76,6 +76,8 @@ struct ace
 
 extern struct token *get_token_obj( struct process *process, obj_handle_t handle, unsigned int access );
 extern struct token *token_create_admin( unsigned primary, int impersonation_level, int elevation, unsigned int session_id );
+extern int token_is_primary( struct token *token );
+extern int token_get_impersonation_level( struct token *token );
 extern int token_assign_label( struct token *token, const struct sid *label );
 extern struct token *token_duplicate( struct token *src_token, unsigned primary,
                                       int impersonation_level, const struct security_descriptor *sd,
--- a/server/token.c
+++ b/server/token.c
@@ -1022,6 +1022,17 @@ static int filter_privilege( struct privilege *privilege, const struct luid_attr
     return 0;
 }
 
+/* Stained Glass OS: ProcessAccessToken needs to tell a primary token from an impersonation one */
+int token_is_primary( struct token *token )
+{
+    return token->primary;
+}
+
+int token_get_impersonation_level( struct token *token )
+{
+    return token->impersonation_level;
+}
+
 struct token *token_duplicate( struct token *src_token, unsigned primary,
                                int impersonation_level, const struct security_descriptor *sd,
                                const struct luid_attr *remove_privs, unsigned int remove_priv_count,
