From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, server: RtlDecompressFragment strictness, ProcessAccessToken checks

RtlDecompressFragment accepted every chunk RtlDecompressBuffer does.  As
on Windows it now refuses (STATUS_BAD_COMPRESSION_BUFFER) an uncompressed
chunk that is not a whole 4096 bytes, and gives zeroes up to the end of a
chunk whose data ends before the requested offset (offset 4095 of a short
chunk is one zero byte).  RtlDecompressBuffer is unchanged.
NtSetInformationProcess(ProcessAccessToken) took any token: a token that is
already a process's token is now STATUS_TOKEN_ALREADY_IN_USE, an
impersonation token below the impersonation level is
STATUS_BAD_IMPERSONATION_LEVEL, and one at or above it is made a primary
token for the process.  The todo_wine marks these satisfy are removed from
the ntdll rtl and info tests.

---
--- a/dlls/ntdll/rtl.c
+++ b/dlls/ntdll/rtl.c
@@ -1047,12 +1047,22 @@ static UCHAR *lznt1_decompress_chunk(UCHAR *dst, ULONG dst_size, UCHAR *src, ULO
 }
 
 /* decompress data encoded with LZNT1 */
+/* RtlDecompressFragment refuses an uncompressed chunk that is not a whole
+ * 4096 bytes (RtlDecompressBuffer takes it, as the last chunk of a stream) */
+static inline BOOL lznt1_bad_fragment_chunk( BOOL fragment, WORD header, ULONG chunk_size )
+{
+#ifdef SG_MUTANT_LZNT1_FRAGMENT_LENIENT
+    return FALSE;
+#endif
+    return fragment && !(header & 0x8000) && chunk_size != 0x1000;
+}
+
 static NTSTATUS lznt1_decompress(UCHAR *dst, ULONG dst_size, UCHAR *src, ULONG src_size,
-                                 ULONG offset, ULONG *final_size, UCHAR *workspace)
+                                 ULONG offset, ULONG *final_size, UCHAR *workspace, BOOL fragment)
 {
     UCHAR *src_cur = src, *src_end = src + src_size;
     UCHAR *dst_cur = dst, *dst_end = dst + dst_size;
-    ULONG chunk_size, block_size;
+    ULONG chunk_size, block_size, data_len;
     WORD chunk_header;
     UCHAR *ptr;
 
@@ -1085,6 +1095,9 @@ static NTSTATUS lznt1_decompress(UCHAR *dst, ULONG dst_size, UCHAR *src, ULONG s
         if (src_cur + chunk_size > src_end)
             return STATUS_BAD_COMPRESSION_BUFFER;
 
+        if (lznt1_bad_fragment_chunk( fragment, chunk_header, chunk_size ))
+            return STATUS_BAD_COMPRESSION_BUFFER;
+
         if (dst_cur >= dst_end)
             goto out;
 
@@ -1094,9 +1107,10 @@ static NTSTATUS lznt1_decompress(UCHAR *dst, ULONG dst_size, UCHAR *src, ULONG s
             if (!workspace) return STATUS_ACCESS_VIOLATION;
             ptr = lznt1_decompress_chunk(workspace, 0x1000, src_cur, chunk_size);
             if (!ptr) return STATUS_BAD_COMPRESSION_BUFFER;
-            if (ptr - workspace > offset)
+            data_len = ptr - workspace;
+            if (data_len > offset)
             {
-                block_size = min((ptr - workspace) - offset, dst_end - dst_cur);
+                block_size = min(data_len - offset, dst_end - dst_cur);
                 memcpy(dst_cur, workspace + offset, block_size);
                 dst_cur += block_size;
             }
@@ -1104,6 +1118,7 @@ static NTSTATUS lznt1_decompress(UCHAR *dst, ULONG dst_size, UCHAR *src, ULONG s
         else
         {
             /* uncompressed chunk */
+            data_len = chunk_size;
             if (chunk_size > offset)
             {
                 block_size = min(chunk_size - offset, dst_end - dst_cur);
@@ -1112,6 +1127,18 @@ static NTSTATUS lznt1_decompress(UCHAR *dst, ULONG dst_size, UCHAR *src, ULONG s
             }
         }
 
+        /* a chunk that ends before the offset gives zeroes up to the end of its 4096 bytes */
+#ifndef SG_MUTANT_LZNT1_NO_FRAGMENT_PAD
+        if (data_len < offset)
+        {
+            block_size = 0x1000 - offset;
+            if (dst_cur + block_size >= dst_end)
+                goto out;
+            memset(dst_cur, 0, block_size);
+            dst_cur += block_size;
+        }
+#endif
+
         src_cur += chunk_size;
     }
 
@@ -1125,6 +1152,8 @@ static NTSTATUS lznt1_decompress(UCHAR *dst, ULONG dst_size, UCHAR *src, ULONG s
 
         if (src_cur + chunk_size > src_end)
             return STATUS_BAD_COMPRESSION_BUFFER;
+        if (lznt1_bad_fragment_chunk( fragment, chunk_header, chunk_size ))
+            return STATUS_BAD_COMPRESSION_BUFFER;
 
         /* fill space with padding when the previous chunk was decompressed
          * to less than 4096 bytes. no padding is needed for the last chunk
@@ -1167,21 +1196,15 @@ out:
 
 }
 
-/******************************************************************************
- *  RtlDecompressFragment	[NTDLL.@]
- */
-NTSTATUS WINAPI RtlDecompressFragment(USHORT format, PUCHAR uncompressed, ULONG uncompressed_size,
-                               PUCHAR compressed, ULONG compressed_size, ULONG offset,
-                               PULONG final_size, PVOID workspace)
+static NTSTATUS decompress( USHORT format, PUCHAR uncompressed, ULONG uncompressed_size,
+                            PUCHAR compressed, ULONG compressed_size, ULONG offset,
+                            PULONG final_size, PVOID workspace, BOOL fragment )
 {
-    TRACE("0x%04x, %p, %lu, %p, %lu, %lu, %p, %p\n", format, uncompressed,
-          uncompressed_size, compressed, compressed_size, offset, final_size, workspace);
-
     switch (format & COMPRESSION_FORMAT_MASK)
     {
         case COMPRESSION_FORMAT_LZNT1:
             return lznt1_decompress(uncompressed, uncompressed_size, compressed,
-                                    compressed_size, offset, final_size, workspace);
+                                    compressed_size, offset, final_size, workspace, fragment);
 
         case COMPRESSION_FORMAT_NONE:
         case COMPRESSION_FORMAT_DEFAULT:
@@ -1193,6 +1216,20 @@ NTSTATUS WINAPI RtlDecompressFragment(USHORT format, PUCHAR uncompressed, ULONG
     }
 }
 
+/******************************************************************************
+ *  RtlDecompressFragment	[NTDLL.@]
+ */
+NTSTATUS WINAPI RtlDecompressFragment(USHORT format, PUCHAR uncompressed, ULONG uncompressed_size,
+                               PUCHAR compressed, ULONG compressed_size, ULONG offset,
+                               PULONG final_size, PVOID workspace)
+{
+    TRACE("0x%04x, %p, %lu, %p, %lu, %lu, %p, %p\n", format, uncompressed,
+          uncompressed_size, compressed, compressed_size, offset, final_size, workspace);
+
+    return decompress( format, uncompressed, uncompressed_size, compressed, compressed_size,
+                       offset, final_size, workspace, TRUE );
+}
+
 
 /******************************************************************************
  *  RtlDecompressBuffer		[NTDLL.@]
@@ -1203,8 +1240,8 @@ NTSTATUS WINAPI RtlDecompressBuffer(USHORT format, PUCHAR uncompressed, ULONG un
     TRACE("0x%04x, %p, %lu, %p, %lu, %p\n", format, uncompressed,
         uncompressed_size, compressed, compressed_size, final_size);
 
-    return RtlDecompressFragment(format, uncompressed, uncompressed_size,
-                                 compressed, compressed_size, 0, final_size, NULL);
+    return decompress( format, uncompressed, uncompressed_size, compressed, compressed_size,
+                       0, final_size, NULL, FALSE );
 }
 
 /******************************************************************************
--- a/dlls/ntdll/tests/info.c
+++ b/dlls/ntdll/tests/info.c
@@ -3865,12 +3865,12 @@ static void test_process_token(int argc, char **argv)
 
     token_info.Token = token;
     status = pNtSetInformationProcess( pi.hProcess, ProcessAccessToken, &token_info, sizeof(token_info) );
-    todo_wine ok( status == STATUS_TOKEN_ALREADY_IN_USE, "got %#lx\n", status );
+    ok( status == STATUS_TOKEN_ALREADY_IN_USE, "got %#lx\n", status );
 
     ret = DuplicateTokenEx( token, TOKEN_ALL_ACCESS, NULL, SecurityAnonymous, TokenImpersonation, &token_info.Token );
     ok( ret, "got error %lu\n", GetLastError() );
     status = pNtSetInformationProcess( pi.hProcess, ProcessAccessToken, &token_info, sizeof(token_info) );
-    todo_wine ok( status == STATUS_BAD_IMPERSONATION_LEVEL, "got %#lx\n", status );
+    ok( status == STATUS_BAD_IMPERSONATION_LEVEL, "got %#lx\n", status );
     CloseHandle( token_info.Token );
 
     ret = DuplicateTokenEx( token, TOKEN_QUERY, NULL, SecurityAnonymous, TokenPrimary, &token_info.Token );
--- a/dlls/ntdll/tests/rtl.c
+++ b/dlls/ntdll/tests/rtl.c
@@ -2807,7 +2807,6 @@ static void test_RtlDecompressBuffer(void)
         status = RtlDecompressFragment(COMPRESSION_FORMAT_LZNT1, buf, sizeof(buf), test_lznt[i].compressed,
                                        test_lznt[i].compressed_size, 0, &final_size, workspace);
         if (test_lznt[i].broken_flags & DECOMPRESS_BROKEN_FRAGMENT)
-            todo_wine
             ok(status == STATUS_BAD_COMPRESSION_BUFFER, "%d: got wrong status 0x%08lx\n", i, status);
         else
             ok(status == test_lznt[i].status, "%d: got wrong status 0x%08lx\n", i, status);
@@ -2827,7 +2826,6 @@ static void test_RtlDecompressBuffer(void)
         status = RtlDecompressFragment(COMPRESSION_FORMAT_LZNT1, buf, sizeof(buf), test_lznt[i].compressed,
                                        test_lznt[i].compressed_size, 1, &final_size, workspace);
         if (test_lznt[i].broken_flags & DECOMPRESS_BROKEN_FRAGMENT)
-            todo_wine
             ok(status == STATUS_BAD_COMPRESSION_BUFFER, "%d: got wrong status 0x%08lx\n", i, status);
         else
             ok(status == test_lznt[i].status, "%d: got wrong status 0x%08lx\n", i, status);
@@ -2835,7 +2833,6 @@ static void test_RtlDecompressBuffer(void)
         {
             if (test_lznt[i].uncompressed_size == 0)
             {
-                todo_wine
                 ok(final_size == 4095, "%d: got wrong final_size %lu\n", i, final_size);
                 /* Buffer doesn't contain any useful value on Windows */
                 ok(buf[4095] == 0x11, "%d: buf[4095] was modified\n", i);
@@ -2857,15 +2854,12 @@ static void test_RtlDecompressBuffer(void)
         status = RtlDecompressFragment(COMPRESSION_FORMAT_LZNT1, buf, sizeof(buf), test_lznt[i].compressed,
                                        test_lznt[i].compressed_size, 4095, &final_size, workspace);
         if (test_lznt[i].broken_flags & DECOMPRESS_BROKEN_FRAGMENT)
-            todo_wine
             ok(status == STATUS_BAD_COMPRESSION_BUFFER, "%d: got wrong status 0x%08lx\n", i, status);
         else
             ok(status == test_lznt[i].status, "%d: got wrong status 0x%08lx\n", i, status);
         if (!status)
         {
-            todo_wine
             ok(final_size == 1, "%d: got wrong final_size %lu\n", i, final_size);
-            todo_wine
             ok(buf[0] == 0, "%d: padding is not zero\n", i);
             ok(buf[1] == 0x11, "%d: buf[1] was modified\n", i);
