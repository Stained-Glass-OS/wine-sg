From: Stained Glass OS contributors
Subject: shell32: a program run as an administrator can be waited for

ShellExecuteEx "runas" hands the command to the elevation broker's client,
sg-elevate, a Unix program. Wine returns no real process handle for a Unix
program it starts, so a caller waiting for the elevated program
(SEE_MASK_NOCLOSEPROCESS, then WaitForSingleObject) went on at once with exit
code 0. Get a web browser then deleted Edge's MSI while the elevated msiexec
was starting, and msiexec found no file.

sg-elevate now runs inside rundll32 (shell32.dll,SgElevate): a Windows
process that waits for sg-elevate -- which waits for the elevated program
(sg-session 0.1.0-52) -- and ends with its exit code.

Gate: test/elevreq-gate.sh (make test-elevreq), "the caller waits".
---
--- a/dlls/shell32/shell32.spec
+++ b/dlls/shell32/shell32.spec
@@ -276,6 +276,7 @@
 @ stdcall Control_FillCache_RunDLLA(long long long long)
 @ stdcall Control_FillCache_RunDLLW(long long long long)
 @ stdcall Control_RunDLL(ptr ptr str long) Control_RunDLLA
+@ stdcall SgElevateW(long long wstr long)
 @ stdcall Control_RunDLLA(ptr ptr str long)
 @ stub Control_RunDLLAsUserW
 @ stdcall Control_RunDLLW(ptr ptr wstr long)
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -320,6 +320,7 @@
                                    STARTUPINFOW *startup, PROCESS_INFORMATION *info )
 {
     WCHAR broker[MAX_PATH + 16] = L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-elevate", *broker_cmd, *p;
+    WCHAR rundll[MAX_PATH];
     BOOL ret;
 
     if (GetEnvironmentVariableW( L"SG_IN_BROKER", NULL, 0 )) return FALSE;
@@ -330,16 +331,60 @@
     }
     else wcscpy( broker, L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-elevate" );
     if (GetFileAttributesW( broker ) == INVALID_FILE_ATTRIBUTES) return FALSE;
-    if (!(broker_cmd = malloc( (wcslen( broker ) + wcslen( L" --wine " ) + wcslen( lpCmd ) + 1) * sizeof(WCHAR) ))) return FALSE;
-    wcscpy( broker_cmd, broker );
-    wcscat( broker_cmd, L" --wine " );
+    /* Through rundll32 and SgElevateW below, not the Unix program itself: Wine
+     * gives no process handle for a Unix program it starts, so a caller waiting
+     * for an elevated installer (SEE_MASK_NOCLOSEPROCESS) had nothing to wait
+     * on and went on at once -- deleting the package the installer was about to
+     * open. rundll32 is a Windows process; it waits for sg-elevate, which
+     * waits for the elevated program, and ends with its code. */
+    GetSystemDirectoryW( rundll, MAX_PATH - 32 );
+    wcscat( rundll, L"\\rundll32.exe" );
+    if (!(broker_cmd = malloc( (wcslen( rundll ) + wcslen( L" shell32.dll,SgElevate " ) + wcslen( lpCmd ) + 1) * sizeof(WCHAR) ))) return FALSE;
+    wcscpy( broker_cmd, rundll );
+    wcscat( broker_cmd, L" shell32.dll,SgElevate " );
     wcscat( broker_cmd, lpCmd );
-    ret = CreateProcessW( NULL, broker_cmd, NULL, NULL, FALSE, flags, env, NULL, startup, info );
+    ret = CreateProcessW( rundll, broker_cmd, NULL, NULL, FALSE, flags, env, NULL, startup, info );
     free( broker_cmd );
     return ret;
 }
 
 /*************************************************************************
+ *      SgElevateW   [SHELL32.@]
+ *
+ * Stained Glass OS: rundll32 shell32.dll,SgElevate COMMAND -- runs COMMAND
+ * elevated through sg-elevate (the broker's client, a Unix program), waits for
+ * it and ends with its exit code. See sg_execute_via_broker.
+ */
+void WINAPI SgElevateW( HWND hwnd, HINSTANCE inst, LPWSTR cmdline, INT show )
+{
+    LONG (WINAPI *spawnvp)( char * const argv[], int wait );
+    char broker[MAX_PATH * 3] = "/usr/libexec/stained-glass/sg-elevate", **argv;
+    WCHAR **args, value[MAX_PATH];
+    int count = 0, i, len;
+    WCHAR ** (WINAPI *to_argv)( const WCHAR *, int * );
+    LONG ret;
+
+    spawnvp = (void *)GetProcAddress( GetModuleHandleW( L"ntdll.dll" ), "__wine_unix_spawnvp" );
+    to_argv = (void *)GetProcAddress( LoadLibraryW( L"shcore.dll" ), "CommandLineToArgvW" );
+    if (!spawnvp || !to_argv || !cmdline || !*cmdline || !(args = to_argv( cmdline, &count ))) ExitProcess( 2 );
+    if (GetEnvironmentVariableW( L"SG_ELEVATE", value, MAX_PATH ) && value[0] == '/')
+        WideCharToMultiByte( CP_UNIXCP, 0, value, -1, broker, sizeof(broker), NULL, NULL );
+    if (!(argv = calloc( count + 3, sizeof(*argv) ))) ExitProcess( 2 );
+    argv[0] = broker;
+    argv[1] = (char *)"--wine";
+    for (i = 0; i < count; i++)
+    {
+        len = WideCharToMultiByte( CP_UNIXCP, 0, args[i], -1, NULL, 0, NULL, NULL );
+        if (!(argv[i + 2] = malloc( len ))) ExitProcess( 2 );
+        WideCharToMultiByte( CP_UNIXCP, 0, args[i], -1, argv[i + 2], len, NULL, NULL );
+    }
+    TRACE( "%s --wine with %d arguments\n", debugstr_a(broker), count );
+    ret = spawnvp( argv, TRUE );
+    /* an exit status, or an NTSTATUS if sg-elevate could not be started */
+    ExitProcess( ret > 255 ? 2 : ret );
+}
+
+/*************************************************************************
  *	SHELL_ExecuteW [Internal]
  *
  */
