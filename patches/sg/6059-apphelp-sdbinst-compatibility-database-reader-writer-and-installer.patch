diff --git a/dlls/apphelp/sdb.c b/dlls/apphelp/sdb.c
new file mode 100644
index 0000000..85d153b
--- /dev/null
+++ b/dlls/apphelp/sdb.c
@@ -0,0 +1,684 @@
+/*
+ * Application compatibility databases (.sdb): reading and writing
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A database is a 12-byte header (major and minor version, "sdbf") and a
+ * sequence of tags. A tag is a WORD whose top four bits are its type:
+ * NULL (no data), BYTE, WORD, DWORD, QWORD, STRINGREF (a DWORD offset into
+ * the string table), or LIST, STRING and BINARY (a DWORD size, then the
+ * data; a list's data is its children). Tags start on even offsets. A
+ * TAGID is a tag's offset in the file; the root's children are the
+ * top-level tags. Strings referred to by STRINGREF tags are the
+ * STRINGTABLE_ITEMs of the top-level STRINGTABLE, the reference being the
+ * item's offset from the start of the table's children.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winnt.h"
+#include "winreg.h"
+#include "objbase.h"
+
+#include "wine/debug.h"
+#include "apphelp_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(apphelp);
+
+#define SDB_HEADER_SIZE 12
+
+struct sdb_string
+{
+    WCHAR *str;
+    DWORD ref;
+};
+
+struct sdb_database
+{
+    BYTE *data;
+    DWORD size, alloc;
+    BOOL write;
+    WCHAR *path;
+    TAGID stringtable;              /* a read database's */
+    struct sdb_string *strings;     /* a written database's string table */
+    DWORD string_count, string_size;
+};
+
+struct sdb_handle
+{
+    PDB db;
+    DWORD flags;
+};
+
+static WCHAR *dos_path( LPCWSTR path, PATH_TYPE type )
+{
+    if (!path) return NULL;
+    /* an NT path names the DOS one after its \??\ prefix */
+    if (type == NT_PATH && !wcsncmp( path, L"\\??\\", 4 )) path += 4;
+    return wcsdup( path );
+}
+
+static void db_free( PDB db )
+{
+    DWORD i;
+
+    if (!db) return;
+    for (i = 0; i < db->string_count; i++) free( db->strings[i].str );
+    free( db->strings );
+    free( db->data );
+    free( db->path );
+    free( db );
+}
+
+/* ---- reading -------------------------------------------------------------- */
+
+static BOOL tag_valid( PDB db, TAGID id )
+{
+    return db && id >= SDB_HEADER_SIZE && id + sizeof(WORD) <= db->size && !(id & 1);
+}
+
+static TAG tag_at( PDB db, TAGID id )
+{
+    return tag_valid( db, id ) ? *(const WORD *)(db->data + id) : TAG_NULL;
+}
+
+static BOOL sized_type( TAG tag )
+{
+    TAG type = tag & TAG_TYPE_MASK;
+    return type == TAG_TYPE_LIST || type == TAG_TYPE_STRING || type == TAG_TYPE_BINARY;
+}
+
+/* the size of a tag's data, after its WORD (and its size, for the sized types) */
+static DWORD data_size( PDB db, TAGID id )
+{
+    TAG tag = tag_at( db, id );
+
+    switch (tag & TAG_TYPE_MASK)
+    {
+    case TAG_TYPE_NULL: return 0;
+    case TAG_TYPE_BYTE: return 1;
+    case TAG_TYPE_WORD: return 2;
+    case TAG_TYPE_DWORD: case TAG_TYPE_STRINGREF: return 4;
+    case TAG_TYPE_QWORD: return 8;
+    case TAG_TYPE_LIST: case TAG_TYPE_STRING: case TAG_TYPE_BINARY:
+        if (id + 6 > db->size) return 0;
+        return *(const DWORD *)(db->data + id + 2);
+    default: return 0;
+    }
+}
+
+static DWORD data_offset( PDB db, TAGID id )
+{
+    return id + 2 + (sized_type( tag_at( db, id ) ) ? 4 : 0);
+}
+
+/* the offset just after a tag, on an even offset */
+static DWORD tag_end( PDB db, TAGID id )
+{
+    DWORD end = data_offset( db, id ) + data_size( db, id );
+    return (end + 1) & ~1;
+}
+
+static BOOL tag_whole( PDB db, TAGID id )
+{
+    return tag_valid( db, id ) && data_offset( db, id ) + data_size( db, id ) <= db->size;
+}
+
+static DWORD children_end( PDB db, TAGID parent )
+{
+    if (parent == TAGID_ROOT) return db->size;
+    return data_offset( db, parent ) + data_size( db, parent );
+}
+
+static TAGID find_stringtable( PDB db )
+{
+    TAGID id;
+
+    for (id = SDB_HEADER_SIZE; tag_whole( db, id ); id = tag_end( db, id ))
+        if (tag_at( db, id ) == TAG_STRINGTABLE) return id;
+    return TAGID_NULL;
+}
+
+PDB WINAPI SdbOpenDatabase( LPCWSTR path, PATH_TYPE type )
+{
+    LARGE_INTEGER size;
+    HANDLE file;
+    DWORD read;
+    PDB db;
+
+    TRACE( "%s %u\n", debugstr_w(path), type );
+
+    if (!path) return NULL;
+    if (!(db = calloc( 1, sizeof(*db) )) || !(db->path = dos_path( path, type ))) goto fail;
+    file = CreateFileW( db->path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) goto fail;
+    if (!GetFileSizeEx( file, &size ) || size.QuadPart < SDB_HEADER_SIZE || size.QuadPart > 256 * 1024 * 1024 ||
+        !(db->data = malloc( size.QuadPart )) || !ReadFile( file, db->data, size.QuadPart, &read, NULL ) ||
+        read != size.QuadPart)
+    {
+        CloseHandle( file );
+        goto fail;
+    }
+    CloseHandle( file );
+    db->size = db->alloc = read;
+    if (memcmp( db->data + 8, "sdbf", 4 ))
+    {
+        WARN( "%s is not a compatibility database\n", debugstr_w(db->path) );
+        goto fail;
+    }
+    db->stringtable = find_stringtable( db );
+    return db;
+
+fail:
+    db_free( db );
+    return NULL;
+}
+
+void WINAPI SdbCloseDatabase( PDB db )
+{
+    TRACE( "%p\n", db );
+    if (db && db->write) WARN( "closing a database being written without writing it\n" );
+    db_free( db );
+}
+
+TAGID WINAPI SdbGetFirstChild( PDB db, TAGID parent )
+{
+    TAGID first;
+
+    TRACE( "%p %#lx\n", db, parent );
+    if (!db) return TAGID_NULL;
+    if (parent == TAGID_ROOT) first = SDB_HEADER_SIZE;
+    else
+    {
+        if (!tag_whole( db, parent ) || (tag_at( db, parent ) & TAG_TYPE_MASK) != TAG_TYPE_LIST) return TAGID_NULL;
+        first = data_offset( db, parent );
+    }
+    if (first >= children_end( db, parent ) || !tag_whole( db, first )) return TAGID_NULL;
+    return first;
+}
+
+TAGID WINAPI SdbGetNextChild( PDB db, TAGID parent, TAGID prev )
+{
+    TAGID next;
+
+    TRACE( "%p %#lx %#lx\n", db, parent, prev );
+    if (!db || !tag_whole( db, prev )) return TAGID_NULL;
+    next = tag_end( db, prev );
+    if (next >= children_end( db, parent ) || !tag_whole( db, next )) return TAGID_NULL;
+    return next;
+}
+
+TAG WINAPI SdbGetTagFromTagID( PDB db, TAGID id )
+{
+    TRACE( "%p %#lx\n", db, id );
+    return tag_whole( db, id ) ? tag_at( db, id ) : TAG_NULL;
+}
+
+TAGID WINAPI SdbFindFirstTag( PDB db, TAGID parent, TAG tag )
+{
+    TAGID id;
+
+    TRACE( "%p %#lx %#x\n", db, parent, tag );
+    for (id = SdbGetFirstChild( db, parent ); id; id = SdbGetNextChild( db, parent, id ))
+        if (tag_at( db, id ) == tag) return id;
+    return TAGID_NULL;
+}
+
+TAGID WINAPI SdbFindNextTag( PDB db, TAGID parent, TAGID prev )
+{
+    TAG tag = tag_at( db, prev );
+    TAGID id;
+
+    TRACE( "%p %#lx %#lx\n", db, parent, prev );
+    for (id = SdbGetNextChild( db, parent, prev ); id; id = SdbGetNextChild( db, parent, id ))
+        if (tag_at( db, id ) == tag) return id;
+    return TAGID_NULL;
+}
+
+DWORD WINAPI SdbGetTagDataSize( PDB db, TAGID id )
+{
+    TRACE( "%p %#lx\n", db, id );
+    return tag_whole( db, id ) ? data_size( db, id ) : 0;
+}
+
+static BOOL read_fixed( PDB db, TAGID id, TAG type, void *out, DWORD size )
+{
+    if (!tag_whole( db, id ) || (tag_at( db, id ) & TAG_TYPE_MASK) != type) return FALSE;
+    memcpy( out, db->data + data_offset( db, id ), size );
+    return TRUE;
+}
+
+BYTE WINAPI SdbReadBYTETag( PDB db, TAGID id, BYTE def )
+{
+    BYTE v;
+    return read_fixed( db, id, TAG_TYPE_BYTE, &v, sizeof(v) ) ? v : def;
+}
+
+WORD WINAPI SdbReadWORDTag( PDB db, TAGID id, WORD def )
+{
+    WORD v;
+    return read_fixed( db, id, TAG_TYPE_WORD, &v, sizeof(v) ) ? v : def;
+}
+
+DWORD WINAPI SdbReadDWORDTag( PDB db, TAGID id, DWORD def )
+{
+    DWORD v;
+    return read_fixed( db, id, TAG_TYPE_DWORD, &v, sizeof(v) ) ? v : def;
+}
+
+QWORD WINAPI SdbReadQWORDTag( PDB db, TAGID id, QWORD def )
+{
+    QWORD v;
+    return read_fixed( db, id, TAG_TYPE_QWORD, &v, sizeof(v) ) ? v : def;
+}
+
+/* a STRING tag's characters, or a STRINGREF tag's string table item's */
+WCHAR * WINAPI SdbGetStringTagPtr( PDB db, TAGID id )
+{
+    TAGID item;
+    DWORD ref;
+
+    TRACE( "%p %#lx\n", db, id );
+    if (!tag_whole( db, id )) return NULL;
+    switch (tag_at( db, id ) & TAG_TYPE_MASK)
+    {
+    case TAG_TYPE_STRING:
+        item = id;
+        break;
+    case TAG_TYPE_STRINGREF:
+        if (!db->stringtable) return NULL;
+        ref = *(const DWORD *)(db->data + id + 2);
+        item = data_offset( db, db->stringtable ) + ref;
+#ifdef SG_MUTANT_SDB_REF_FROM_TABLE
+        item = db->stringtable + ref;
+#endif
+        if (item >= children_end( db, db->stringtable ) || !tag_whole( db, item ) ||
+            (tag_at( db, item ) & TAG_TYPE_MASK) != TAG_TYPE_STRING)
+            return NULL;
+        break;
+    default:
+        return NULL;
+    }
+    /* the strings are stored with their terminator */
+    if (data_size( db, item ) < sizeof(WCHAR) || data_size( db, item ) % sizeof(WCHAR)) return NULL;
+    if (*(const WCHAR *)(db->data + data_offset( db, item ) + data_size( db, item ) - sizeof(WCHAR))) return NULL;
+    return (WCHAR *)(db->data + data_offset( db, item ));
+}
+
+BOOL WINAPI SdbReadStringTag( PDB db, TAGID id, LPWSTR buffer, DWORD size )
+{
+    WCHAR *str = SdbGetStringTagPtr( db, id );
+
+    TRACE( "%p %#lx %p %lu\n", db, id, buffer, size );
+    if (!str || !buffer || wcslen( str ) + 1 > size) return FALSE;
+    lstrcpyW( buffer, str );
+    return TRUE;
+}
+
+void * WINAPI SdbGetBinaryTagData( PDB db, TAGID id )
+{
+    TRACE( "%p %#lx\n", db, id );
+    if (!tag_whole( db, id ) || (tag_at( db, id ) & TAG_TYPE_MASK) != TAG_TYPE_BINARY) return NULL;
+    return db->data + data_offset( db, id );
+}
+
+BOOL WINAPI SdbReadBinaryTag( PDB db, TAGID id, BYTE *buffer, DWORD size )
+{
+    void *data = SdbGetBinaryTagData( db, id );
+
+    TRACE( "%p %#lx %p %lu\n", db, id, buffer, size );
+    if (!data || !buffer || data_size( db, id ) > size) return FALSE;
+    memcpy( buffer, data, data_size( db, id ) );
+    return TRUE;
+}
+
+BOOL WINAPI SdbGetDatabaseVersion( LPCWSTR path, DWORD *major, DWORD *minor )
+{
+    PDB db = SdbOpenDatabase( path, DOS_PATH );
