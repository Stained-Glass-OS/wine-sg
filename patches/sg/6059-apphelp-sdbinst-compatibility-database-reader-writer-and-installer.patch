+    {
+        if (!(name = pSdbFindFirstTag( db, exe, TAG_NAME )) || !(str = pSdbGetStringTagPtr( db, name ))) continue;
+#ifdef SG_MUTANT_SDBINST_NO_EXE
+        continue;
+#endif
+        if (add)
+        {
+            QWORD stamp;
+            FILETIME now;
+
+            if ((status = open_key( flags_key, L"Custom", &key, TRUE ))) return status;
+            RegCloseKey( key );
+            {
+                WCHAR sub[MAX_PATH + 8];
+                swprintf( sub, ARRAY_SIZE(sub), L"Custom\\%s", str );
+                if ((status = open_key( flags_key, sub, &key, TRUE ))) return status;
+            }
+            GetSystemTimeAsFileTime( &now );
+            stamp = ((QWORD)now.dwHighDateTime << 32) | now.dwLowDateTime;
+            status = RegSetValueExW( key, file, 0, REG_QWORD, (const BYTE *)&stamp, sizeof(stamp) );
+            RegCloseKey( key );
+            if (status) return status;
+        }
+        else
+        {
+            WCHAR sub[MAX_PATH + 8];
+            DWORD values = 1, subkeys = 1;
+
+            swprintf( sub, ARRAY_SIZE(sub), L"Custom\\%s", str );
+            if (open_key( flags_key, sub, &key, FALSE )) continue;
+            RegDeleteValueW( key, file );
+            RegQueryInfoKeyW( key, NULL, NULL, NULL, &subkeys, NULL, NULL, &values, NULL, NULL, NULL, NULL );
+            RegCloseKey( key );
+            /* the EXE's key goes with its last database */
+            if (!values && !subkeys && !open_key( flags_key, L"Custom", &key, FALSE ))
+            {
+                RegDeleteKeyW( key, str );
+                RegCloseKey( key );
+            }
+        }
+    }
+    return status;
+}
+
+static int install( const WCHAR *path )
+{
+    WCHAR full[MAX_PATH], guid_str[40], dest[MAX_PATH], file[48], command[MAX_PATH + 32], *name;
+    LSTATUS status;
+    FILETIME now;
+    QWORD stamp;
+    GUID guid;
+    DWORD type = 0x10000;
+    HKEY key;
+    PDB db;
+
+    if (!GetFullPathNameW( path, ARRAY_SIZE(full), full, NULL ) || !(db = pSdbOpenDatabase( full, 0 )))
+    {
+        error( L"%s is not a compatibility database.\n", path );
+        return 1;
+    }
+    if (!pSdbGetDatabaseID( db, &guid ))
+    {
+        error( L"%s has no database ID.\n", path );
+        pSdbCloseDatabase( db );
+        return 1;
+    }
+    StringFromGUID2( &guid, guid_str, ARRAY_SIZE(guid_str) );
+    name = database_name( db );
+    custom_path( guid_str, dest, ARRAY_SIZE(dest) );
+    swprintf( file, ARRAY_SIZE(file), L"%s.sdb", guid_str );
+
+    /* the file first: a user without the rights stops here */
+    {
+        WCHAR dir[MAX_PATH], *p;
+
+        lstrcpyW( dir, dest );
+        if ((p = wcsrchr( dir, '\\' ))) *p = 0;
+        if ((p = wcsrchr( dir, '\\' )))
+        {
+            *p = 0;
+            CreateDirectoryW( dir, NULL );
+            *p = '\\';
+        }
+        CreateDirectoryW( dir, NULL );
+    }
+    if (!CopyFileW( full, dest, FALSE ))
+    {
+        DWORD err = GetLastError();
+        error( err == ERROR_ACCESS_DENIED ? L"Installing a database needs administrator rights.\n"
+                                          : L"Cannot copy %s to %s (error %lu).\n", path, dest, err );
+        pSdbCloseDatabase( db );
+        free( name );
+        return 1;
+    }
+
+    GetSystemTimeAsFileTime( &now );
+    stamp = ((QWORD)now.dwHighDateTime << 32) | now.dwLowDateTime;
+    if (!(status = open_key( flags_key, L"InstalledSDB", &key, TRUE ))) RegCloseKey( key );
+    if (!status)
+    {
+        WCHAR sub[64];
+        swprintf( sub, ARRAY_SIZE(sub), L"InstalledSDB\\%s", guid_str );
+        status = open_key( flags_key, sub, &key, TRUE );
+    }
+    if (!status)
+    {
+        set_string( key, L"DatabaseDescription", name ? name : file );
+        RegSetValueExW( key, L"DatabaseInstallTimeStamp", 0, REG_QWORD, (const BYTE *)&stamp, sizeof(stamp) );
+        set_string( key, L"DatabasePath", dest );
+        RegSetValueExW( key, L"DatabaseType", 0, REG_DWORD, (const BYTE *)&type, sizeof(type) );
+        RegCloseKey( key );
+        status = for_each_exe( db, file, TRUE );
+    }
+    if (!status && !(status = open_key( uninstall_key, file, &key, TRUE )))
+    {
+        set_string( key, L"DisplayName", name ? name : file );
+        swprintf( command, ARRAY_SIZE(command), L"sdbinst.exe -u \"%s\"", dest );
+        set_string( key, L"UninstallString", command );
+        RegCloseKey( key );
+    }
+    pSdbCloseDatabase( db );
+    if (status)
+    {
+        error( status == ERROR_ACCESS_DENIED ? L"Installing a database needs administrator rights.\n"
+                                             : L"Cannot record the database (error %ld).\n", status );
+        DeleteFileW( dest );
+        free( name );
+        return 1;
+    }
+    message( L"Installation of %s complete.\n", name ? name : file );
+    free( name );
+    return 0;
+}
+
+static int uninstall_guid( const WCHAR *guid_str )
+{
+    WCHAR dest[MAX_PATH], file[48], sub[64];
+    LSTATUS status;
+    HKEY key;
+    PDB db;
+    GUID guid;
+
+    if (FAILED(CLSIDFromString( guid_str, &guid )))
+    {
+        error( L"%s is not a database ID.\n", guid_str );
+        return 1;
+    }
+    swprintf( sub, ARRAY_SIZE(sub), L"InstalledSDB\\%s", guid_str );
+    if ((status = open_key( flags_key, sub, &key, FALSE )))
+    {
+        error( status == ERROR_ACCESS_DENIED ? L"Uninstalling a database needs administrator rights.\n"
+                                             : L"No database %s is installed.\n", guid_str );
+        return 1;
+    }
+    {
+        DWORD size = sizeof(dest);
+        if (RegQueryValueExW( key, L"DatabasePath", NULL, NULL, (BYTE *)dest, &size )) custom_path( guid_str, dest, ARRAY_SIZE(dest) );
+    }
+    RegCloseKey( key );
+    swprintf( file, ARRAY_SIZE(file), L"%s.sdb", guid_str );
+
+    if ((db = pSdbOpenDatabase( dest, 0 )))
+    {
+        for_each_exe( db, file, FALSE );
+        pSdbCloseDatabase( db );
+    }
+    if (!open_key( flags_key, L"InstalledSDB", &key, FALSE ))
+    {
+        status = RegDeleteKeyW( key, guid_str );
+        RegCloseKey( key );
+        if (status == ERROR_ACCESS_DENIED)
+        {
+            error( L"Uninstalling a database needs administrator rights.\n" );
+            return 1;
+        }
+    }
+    if (!open_key( uninstall_key, NULL, &key, FALSE ))
+    {
+        RegDeleteKeyW( key, file );
+        RegCloseKey( key );
+    }
+    DeleteFileW( dest );
+    message( L"Uninstallation of %s complete.\n", guid_str );
     return 0;
 }
+
+static int uninstall_file( const WCHAR *path )
+{
+    WCHAR guid_str[40];
+    GUID guid;
+    PDB db;
+    BOOL ok;
+
+    if (!(db = pSdbOpenDatabase( path, 0 )))
+    {
+        error( L"%s is not a compatibility database.\n", path );
+        return 1;
+    }
+    ok = pSdbGetDatabaseID( db, &guid );
+    pSdbCloseDatabase( db );
+    if (!ok)
+    {
+        error( L"%s has no database ID.\n", path );
+        return 1;
+    }
+    StringFromGUID2( &guid, guid_str, ARRAY_SIZE(guid_str) );
+    return uninstall_guid( guid_str );
+}
+
+/* the installed database whose description is NAME */
+static int uninstall_name( const WCHAR *name )
+{
+    WCHAR guid_str[64], desc[512];
+    DWORD i, len, size;
+    HKEY key, sub;
+
+    if (open_key( flags_key, L"InstalledSDB", &key, FALSE ))
+    {
+        error( L"No database %s is installed.\n", name );
+        return 1;
+    }
+    for (i = 0; len = ARRAY_SIZE(guid_str), !RegEnumKeyExW( key, i, guid_str, &len, NULL, NULL, NULL, NULL ); i++)
+    {
+        if (RegOpenKeyExW( key, guid_str, 0, KEY_READ, &sub )) continue;
+        size = sizeof(desc);
+        if (!RegQueryValueExW( sub, L"DatabaseDescription", NULL, NULL, (BYTE *)desc, &size ) && !wcsicmp( desc, name ))
+        {
+            RegCloseKey( sub );
+            RegCloseKey( key );
+            return uninstall_guid( guid_str );
+        }
+        RegCloseKey( sub );
+    }
+    RegCloseKey( key );
+    error( L"No database %s is installed.\n", name );
+    return 1;
+}
+
+static void usage(void)
+{
+    error( L"Usage: sdbinst [-q] [-u] file.sdb\n"
+           L"       sdbinst [-q] [-u] -g {GUID}\n"
+           L"       sdbinst [-q] -n name\n" );
+}
+
+int __cdecl wmain( int argc, WCHAR *argv[] )
+{
+    const WCHAR *file = NULL, *guid = NULL, *name = NULL;
+    BOOL remove = FALSE;
+    int i;
+
+    TRACE( "%d arguments\n", argc );
+    for (i = 1; i < argc; i++)
+    {
+        const WCHAR *arg = argv[i];
+
+        if (arg[0] == '-' || arg[0] == '/')
+        {
+            if (!wcsicmp( arg + 1, L"q" )) quiet = TRUE;
+            else if (!wcsicmp( arg + 1, L"u" )) remove = TRUE;
+            else if (!wcsicmp( arg + 1, L"g" ) && i + 1 < argc) guid = argv[++i];
+            else if (!wcsicmp( arg + 1, L"n" ) && i + 1 < argc) name = argv[++i];
+            else if (!wcsicmp( arg + 1, L"?" ) || !wcsicmp( arg + 1, L"h" ))
+            {
+                usage();
+                return 0;
+            }
+            else
+            {
+                usage();
+                return 1;
+            }
+        }
+        else if (!file) file = arg;
+        else
+        {
+            usage();
+            return 1;
+        }
+    }
+    if (!load_apphelp())
+    {
+        error( L"apphelp.dll is missing its database functions.\n" );
+        return 1;
+    }
+    if (guid) return uninstall_guid( guid );
+    if (name) return uninstall_name( name );
+    if (!file)
+    {
+        usage();
+        return 1;
+    }
+    return remove ? uninstall_file( file ) : install( file );
+}
