+LPCWSTR WINAPI SdbTagToString( TAG tag )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(tag_names); i++) if (tag_names[i].tag == tag) return tag_names[i].name;
+    return L"InvalidTag";
+}
+
+/* ---- writing -------------------------------------------------------------- */
+
+static BOOL db_reserve( PDB db, DWORD more )
+{
+    DWORD alloc;
+    BYTE *data;
+
+    if (db->size + more <= db->alloc) return TRUE;
+    alloc = max( db->alloc * 2, db->size + more + 4096 );
+    if (!(data = realloc( db->data, alloc ))) return FALSE;
+    db->data = data;
+    db->alloc = alloc;
+    return TRUE;
+}
+
+static BOOL db_append( PDB db, const void *data, DWORD size )
+{
+    if (!db_reserve( db, size + 1 )) return FALSE;
+    memcpy( db->data + db->size, data, size );
+    db->size += size;
+    return TRUE;
+}
+
+static BOOL db_pad( PDB db )
+{
+    static const BYTE zero;
+    return !(db->size & 1) || db_append( db, &zero, 1 );
+}
+
+static BOOL write_tag( PDB db, TAG tag, TAG type, const void *data, DWORD size )
+{
+    if (!db || !db->write || (tag & TAG_TYPE_MASK) != type) return FALSE;
+    if (!db_append( db, &tag, sizeof(tag) )) return FALSE;
+    if (sized_type( tag ) && !db_append( db, &size, sizeof(size) )) return FALSE;
+    return db_append( db, data, size ) && db_pad( db );
+}
+
+PDB WINAPI SdbCreateDatabase( LPCWSTR path, PATH_TYPE type )
+{
+    static const DWORD version[2] = { 2, 1 };
+    PDB db;
+
+    TRACE( "%s %u\n", debugstr_w(path), type );
+    if (!path || !(db = calloc( 1, sizeof(*db) ))) return NULL;
+    db->write = TRUE;
+    if (!(db->path = dos_path( path, type )) || !db_append( db, version, sizeof(version) ) || !db_append( db, "sdbf", 4 ))
+    {
+        db_free( db );
+        return NULL;
+    }
+    /* the file is made now, so a bad path fails here */
+    {
+        HANDLE file = CreateFileW( db->path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+        if (file == INVALID_HANDLE_VALUE)
+        {
+            db_free( db );
+            return NULL;
+        }
+        CloseHandle( file );
+    }
+    return db;
+}
+
+BOOL WINAPI SdbWriteNULLTag( PDB db, TAG tag )
+{
+    return write_tag( db, tag, TAG_TYPE_NULL, NULL, 0 );
+}
+
+BOOL WINAPI SdbWriteBYTETag( PDB db, TAG tag, BYTE data )
+{
+    return write_tag( db, tag, TAG_TYPE_BYTE, &data, sizeof(data) );
+}
+
+BOOL WINAPI SdbWriteWORDTag( PDB db, TAG tag, WORD data )
+{
+    return write_tag( db, tag, TAG_TYPE_WORD, &data, sizeof(data) );
+}
+
+BOOL WINAPI SdbWriteDWORDTag( PDB db, TAG tag, DWORD data )
+{
+    return write_tag( db, tag, TAG_TYPE_DWORD, &data, sizeof(data) );
+}
+
+BOOL WINAPI SdbWriteQWORDTag( PDB db, TAG tag, QWORD data )
+{
+    return write_tag( db, tag, TAG_TYPE_QWORD, &data, sizeof(data) );
+}
+
+BOOL WINAPI SdbWriteStringRefTag( PDB db, TAG tag, TAGID ref )
+{
+    return write_tag( db, tag, TAG_TYPE_STRINGREF, &ref, sizeof(ref) );
+}
+
+BOOL WINAPI SdbWriteStringTagDirect( PDB db, TAG tag, LPCWSTR str )
+{
+    if (!str) return FALSE;
+    return write_tag( db, tag, TAG_TYPE_STRING, str, (wcslen( str ) + 1) * sizeof(WCHAR) );
+}
+
+/* a STRINGREF tag's string goes to the string table (once), a STRING tag's is written in place */
+BOOL WINAPI SdbWriteStringTag( PDB db, TAG tag, LPCWSTR str )
+{
+    struct sdb_string *strings;
+    DWORD i;
+
+    TRACE( "%p %#x %s\n", db, tag, debugstr_w(str) );
+    if (!db || !str) return FALSE;
+    if ((tag & TAG_TYPE_MASK) == TAG_TYPE_STRING) return SdbWriteStringTagDirect( db, tag, str );
+    if ((tag & TAG_TYPE_MASK) != TAG_TYPE_STRINGREF) return FALSE;
+#ifndef SG_MUTANT_SDB_NO_DEDUP
+    for (i = 0; i < db->string_count; i++)
+        if (!wcscmp( db->strings[i].str, str )) return SdbWriteStringRefTag( db, tag, db->strings[i].ref );
+#endif
+    if (!(strings = realloc( db->strings, (db->string_count + 1) * sizeof(*strings) ))) return FALSE;
+    db->strings = strings;
+    if (!(strings[db->string_count].str = wcsdup( str ))) return FALSE;
+    strings[db->string_count].ref = db->string_size;
+    /* the item: its tag, its size, the string and its terminator, to an even size */
+    db->string_size += (2 + 4 + (wcslen( str ) + 1) * sizeof(WCHAR) + 1) & ~1;
+    return SdbWriteStringRefTag( db, tag, strings[db->string_count++].ref );
+}
+
+BOOL WINAPI SdbWriteBinaryTag( PDB db, TAG tag, const BYTE *data, DWORD size )
+{
+    if (!data && size) return FALSE;
+    return write_tag( db, tag, TAG_TYPE_BINARY, data, size );
+}
+
+BOOL WINAPI SdbWriteBinaryTagFromFile( PDB db, TAG tag, LPCWSTR path )
+{
+    LARGE_INTEGER size;
+    HANDLE file;
+    BYTE *data;
+    DWORD read;
+    BOOL ret = FALSE;
+
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    if (GetFileSizeEx( file, &size ) && size.QuadPart < 64 * 1024 * 1024 && (data = malloc( size.QuadPart + 1 )))
+    {
+        if (ReadFile( file, data, size.QuadPart, &read, NULL ) && read == size.QuadPart)
+            ret = SdbWriteBinaryTag( db, tag, data, read );
+        free( data );
+    }
+    CloseHandle( file );
+    return ret;
+}
+
+TAGID WINAPI SdbBeginWriteListTag( PDB db, TAG tag )
+{
+    DWORD size = 0;
+    TAGID id;
+
+    TRACE( "%p %#x\n", db, tag );
+    if (!db || !db->write || (tag & TAG_TYPE_MASK) != TAG_TYPE_LIST) return TAGID_NULL;
+    id = db->size;
+    if (!db_append( db, &tag, sizeof(tag) ) || !db_append( db, &size, sizeof(size) )) return TAGID_NULL;
+    return id;
+}
+
+BOOL WINAPI SdbEndWriteListTag( PDB db, TAGID id )
+{
+    DWORD size;
+
+    TRACE( "%p %#lx\n", db, id );
+    if (!db || !db->write || id < SDB_HEADER_SIZE || id + 6 > db->size ||
+        (*(const WORD *)(db->data + id) & TAG_TYPE_MASK) != TAG_TYPE_LIST)
+        return FALSE;
+    size = db->size - id - 6;
+#ifdef SG_MUTANT_SDB_LIST_SIZE_HEADER
+    size += 6;
+#endif
+    memcpy( db->data + id + 2, &size, sizeof(size) );
+    return TRUE;
+}
+
+/* the string table, then the file */
+void WINAPI SdbCloseDatabaseWrite( PDB db )
+{
+    HANDLE file;
+    DWORD i, written;
+    TAGID table;
+
+    TRACE( "%p\n", db );
+    if (!db) return;
+    if (db->write && db->string_count && (table = SdbBeginWriteListTag( db, TAG_STRINGTABLE )))
+    {
+        for (i = 0; i < db->string_count; i++) SdbWriteStringTagDirect( db, TAG_STRINGTABLE_ITEM, db->strings[i].str );
+        SdbEndWriteListTag( db, table );
+    }
+    if (db->write)
+    {
+        file = CreateFileW( db->path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            WriteFile( file, db->data, db->size, &written, NULL );
+            CloseHandle( file );
+        }
+        else WARN( "cannot write %s\n", debugstr_w(db->path) );
+    }
+    db_free( db );
+}
+
+/* ---- the system database ------------------------------------------------- */
+
+HSDB WINAPI SdbInitDatabase( DWORD flags, LPCWSTR path )
+{
+    WCHAR sysmain[MAX_PATH];
+    HSDB handle;
+
+    TRACE( "%#lx %s\n", flags, debugstr_w(path) );
+    if (!(handle = calloc( 1, sizeof(*handle) ))) return NULL;
+    handle->flags = flags;
+    if (flags & HID_NO_DATABASE) return handle;
+    /* the given database, else %windir%\AppPatch\sysmain.sdb */
+    if (path && (flags & HID_DATABASE_FULLPATH))
+        handle->db = SdbOpenDatabase( path, (flags & HID_DOS_PATHS) ? DOS_PATH : NT_PATH );
+    else if (GetWindowsDirectoryW( sysmain, MAX_PATH - 22 ))
+    {
+        lstrcatW( sysmain, L"\\AppPatch\\sysmain.sdb" );
+        handle->db = SdbOpenDatabase( sysmain, DOS_PATH );
+    }
+    if (!handle->db)
+    {
+        WARN( "no compatibility database\n" );
+        free( handle );
+        return NULL;
+    }
+    return handle;
+}
+
+void WINAPI SdbReleaseDatabase( HSDB handle )
+{
+    TRACE( "%p\n", handle );
+    if (!handle) return;
+    db_free( handle->db );
+    free( handle );
+}
