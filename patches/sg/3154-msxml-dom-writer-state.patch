From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 03:29:34 -0700
Subject: [PATCH] msxml3: DOM writer output: createElement blocked while
 writing, get_xml unindented

An MXXMLWriter that fills a DOM document marks it between startDocument and
endDocument: createElement then fails with E_FAIL. The document stays
unformatted: get_xml no longer indents it until the next load.

diff --git a/dlls/msxml3/domdoc.c b/dlls/msxml3/domdoc.c
index c24679c..3f7e130 100644
--- a/dlls/msxml3/domdoc.c
+++ b/dlls/msxml3/domdoc.c
@@ -148,6 +148,9 @@ struct domdoc
     IDispatch *events[EVENTID_LAST];
 
     IXMLDOMSchemaCollection2 *namespaces;
+
+    BOOL writer_busy; /* an MXXMLWriter is building the content, between startDocument and endDocument */
+    BOOL no_format;   /* the content comes from a writer: get_xml does not indent it */
 };
 
 static HRESULT set_doc_event(domdoc *doc, eventid_t eid, const VARIANT *v)
@@ -909,6 +912,7 @@ static inline xmlDocPtr get_doc( domdoc *This )
 
 static HRESULT attach_xmldoc(domdoc *This, xmlDocPtr xml )
 {
+    This->no_format = FALSE;
     release_namespaces(This);
 
     if(This->node.node)
@@ -1661,7 +1665,11 @@ static HRESULT WINAPI domdoc_get_xml(
     if(!buf)
         return E_OUTOFMEMORY;
 
-    options = XML_SAVE_FORMAT | XML_SAVE_NO_DECL;
+    options = XML_SAVE_NO_DECL;
+#ifndef SG_MUTANT_DOM_NOFORMAT
+    if (!This->no_format)
+#endif
+        options |= XML_SAVE_FORMAT;
     ctxt = xmlSaveToIO(domdoc_get_xml_writecallback, NULL, buf, "UTF-8", options);
 
     if(!ctxt)
@@ -1911,6 +1919,11 @@ static HRESULT WINAPI domdoc_createElement(
 
     if (!element || !tagname) return E_INVALIDARG;
 
+    /* the document cannot be modified from outside while a writer fills it */
+#ifndef SG_MUTANT_DOM_BUSY
+    if (This->writer_busy) return E_FAIL;
+#endif
+
     V_VT(&type) = VT_I1;
     V_I1(&type) = NODE_ELEMENT;
 
@@ -4405,6 +4418,8 @@ HRESULT get_domdoc_from_xmldoc(xmlDocPtr xmldoc, IXMLDOMDocument3 **document)
     doc->IConnectionPointContainer_iface.lpVtbl = &ConnectionPointContainerVtbl;
     doc->ref = 1;
     doc->async = VARIANT_TRUE;
+    doc->writer_busy = FALSE;
+    doc->no_format = FALSE;
     doc->resolving = 0;
     doc->properties = properties_add_ref(properties_from_xmlDocPtr(xmldoc));
     doc->error = S_OK;
@@ -4467,3 +4482,18 @@ IUnknown* create_domdoc( xmlNodePtr document )
 
     return obj;
 }
+
+/* used by the writer that fills a document: busy blocks the creation methods, unformatted keeps get_xml from indenting */
+HRESULT domdoc_set_writer_state(IXMLDOMDocument *dom, BOOL busy, BOOL unformatted)
+{
+    IXMLDOMDocument3 *doc3;
+    domdoc *This;
+    HRESULT hr;
+
+    if (FAILED(hr = IXMLDOMDocument_QueryInterface(dom, &IID_IXMLDOMDocument3, (void **)&doc3))) return hr;
+    This = impl_from_IXMLDOMDocument3(doc3);
+    This->writer_busy = busy;
+    if (unformatted) This->no_format = TRUE;
+    IXMLDOMDocument3_Release(doc3);
+    return S_OK;
+}
diff --git a/dlls/msxml3/mxwriter.c b/dlls/msxml3/mxwriter.c
index a732826..318b944 100644
--- a/dlls/msxml3/mxwriter.c
+++ b/dlls/msxml3/mxwriter.c
@@ -33,6 +33,8 @@
 
 #include "msxml_dispex.h"
 
+extern HRESULT domdoc_set_writer_state( IXMLDOMDocument *, BOOL, BOOL );
+
 WINE_DEFAULT_DEBUG_CHANNEL(msxml);
 
 static const WCHAR emptyW[] = {0};
@@ -853,6 +855,7 @@ static ULONG WINAPI mxwriter_AddRef(IMXWriter *iface)
 /* Output to a DOM document */
 static void dom_release_nodes(mxwriter *writer)
 {
+    if (writer->dom_node && writer->dom) domdoc_set_writer_state(writer->dom, FALSE, FALSE);
     if (writer->dom_node) IXMLDOMNode_Release(writer->dom_node);
     writer->dom_node = NULL;
     free(writer->dom_text);
@@ -897,6 +900,7 @@ static HRESULT dom_start_document(mxwriter *writer)
         if (removed) IXMLDOMNode_Release(removed);
         if (FAILED(hr)) break;
     }
+    domdoc_set_writer_state(writer->dom, TRUE, TRUE);
     return IXMLDOMDocument_QueryInterface(writer->dom, &IID_IXMLDOMNode, (void **)&writer->dom_node);
 }
 
diff --git a/dlls/msxml3/tests/saxreader.c b/dlls/msxml3/tests/saxreader.c
index 4af1329..457661f 100644
--- a/dlls/msxml3/tests/saxreader.c
+++ b/dlls/msxml3/tests/saxreader.c
@@ -4528,7 +4528,6 @@ static void test_mxwriter_domdoc(void)
     ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
 
     hr = IXMLDOMDocument_createElement(domdoc, _bstr_("TestElement"), &root);
-    todo_wine
     ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
 
     /* startElement allows document root node to be accessed. */
@@ -4630,7 +4629,6 @@ static void test_mxwriter_domdoc(void)
     /* finally check doc output */
     hr = IXMLDOMDocument_get_xml(domdoc, &str);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
-    todo_wine
     ok(!lstrcmpW(
             L"<BankAccount>"
             "<Number>12345</Number>"
