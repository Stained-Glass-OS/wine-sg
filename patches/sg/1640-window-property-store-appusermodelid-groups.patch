+/* a window property as shell32's window property store keeps it (1640) */
+static BYTE *sg_window_prop( HKEY key, DWORD pid, DWORD *size )
+{
+    WCHAR name[64];
+    BYTE *data;
+    DWORD type;
+
+    swprintf( name, ARRAY_SIZE(name), L"{9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3} %lu", pid );
+    if (RegQueryValueExW( key, name, NULL, &type, NULL, size ) || type != REG_BINARY || *size < sizeof(DWORD)) return NULL;
+    if (!(data = calloc( 1, *size + sizeof(WCHAR) ))) return NULL;
+    if (RegQueryValueExW( key, name, NULL, NULL, data, size )) { free( data ); return NULL; }
+    return data;
+}
+
+static void sg_read_app_ids( struct taskbar_button *win )
+{
+    WCHAR path[80];
+    BYTE *data;
+    DWORD size, pid;
+    HKEY key;
+
+    win->appid[0] = 0;
+    free( win->relaunch );
+    win->relaunch = NULL;
+    win->no_pin = FALSE;
+    if (!win->hwnd || win->xwin || win->elevated) return;
+
+    swprintf( path, ARRAY_SIZE(path), L"Software\\Wine\\Shell\\WindowProperties\\%08lx", HandleToUlong( win->hwnd ) );
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &key ))
+    {
+        if ((data = sg_window_prop( key, 5, &size )))   /* System.AppUserModel.ID */
+        {
+            if (*(WORD *)data == 31 /* VT_LPWSTR */) lstrcpynW( win->appid, (WCHAR *)(data + sizeof(DWORD)), ARRAY_SIZE(win->appid) );
+            free( data );
+        }
+        if ((data = sg_window_prop( key, 2, &size )))   /* System.AppUserModel.RelaunchCommand */
+        {
+            if (*(WORD *)data == 31 /* VT_LPWSTR */) win->relaunch = wcsdup( (WCHAR *)(data + sizeof(DWORD)) );
+            free( data );
+        }
+        if ((data = sg_window_prop( key, 9, &size )))   /* System.AppUserModel.PreventPinning */
+        {
+            if (*(WORD *)data == 11 /* VT_BOOL */) win->no_pin = *(SHORT *)(data + sizeof(DWORD)) != 0;
+            free( data );
+        }
+        RegCloseKey( key );
+    }
+    if (win->appid[0]) return;
+
+    /* the program's explicit ID (shcore), if this is still that process */
+    GetWindowThreadProcessId( win->hwnd, &pid );
+    swprintf( path, ARRAY_SIZE(path), L"Software\\Wine\\Shell\\ProcessAppIds\\%lu", pid );
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &key ))
+    {
+        FILETIME created, exited, kernel, user;
+        ULONGLONG started = 0;
+        HANDLE process;
+        WCHAR id[130];
+        DWORD len = sizeof(started);
+
+        RegQueryValueExW( key, L"Started", NULL, NULL, (BYTE *)&started, &len );
+        len = sizeof(id) - sizeof(WCHAR);
+        memset( id, 0, sizeof(id) );
+        if (!RegQueryValueExW( key, L"Id", NULL, NULL, (BYTE *)id, &len ) &&
+            (process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid )))
+        {
+            if (GetProcessTimes( process, &created, &exited, &kernel, &user ) &&
+                started == (((ULONGLONG)created.dwHighDateTime << 32) | created.dwLowDateTime))
+                lstrcpynW( win->appid, id, ARRAY_SIZE(win->appid) );
+            CloseHandle( process );
+        }
+        RegCloseKey( key );
+    }
+}
+
+/* what groups a window's button with others: its AppUserModelID, else its program */
+static BOOL sg_same_group( const struct taskbar_button *a, const struct taskbar_button *b )
+{
+#ifndef SG_MUTANT_GROUP_BY_EXE
+    if (a->appid[0] || b->appid[0]) return !wcsicmp( a->appid, b->appid );
+#endif
+    return a->exe[0] && !wcsicmp( a->exe, b->exe );
+}
