+/* Stained Glass OS (1640): a window's property store (its AppUserModelID,
+ * relaunch command, ...) is the window's: every process sees what was set,
+ * the taskbar most of all, which groups buttons by the ID. It is kept in a
+ * volatile key per window, which the taskbar removes with the window:
+ * HKCU\Software\Wine\Shell\WindowProperties\<hwnd>, a value per property
+ * named "{fmtid} pid", holding its VARTYPE and its data. */
+#define SG_TASKBAR_LIST_DATA 0x53470101
+#define SG_TBL_PROPERTIES    7
+
+/* PKEY_AppUserModel_* (propkey.h) */
+static const GUID appusermodel_fmtid = {0x9f4c2855,0x9f79,0x4b39,{0xa8,0xd0,0xe1,0xd4,0x2d,0xe1,0xd5,0xf3}};
+#define APPUSERMODEL_ID_PID 5
+
+struct sg_taskbar_list_data  /* as explorerframe's and explorer's */
+{
+    DWORD     cmd;
+    DWORD     hwnd;
+    DWORD     state;
+    DWORD     pad;
+    ULONGLONG done, total;
+    UINT      width, height, planes, bpp;
+};
+
 struct window_prop_store
 {
     IPropertyStore IPropertyStore_iface;
     LONG           ref;
+    HWND           hwnd;
 };
 
 static inline struct window_prop_store *impl_from_IPropertyStore(IPropertyStore *iface)
@@ -744,7 +768,7 @@ static HRESULT WINAPI window_prop_store_QueryInterface(IPropertyStore *iface, RE
     }
     else
     {
-        FIXME("no interface for %s\n", debugstr_guid(iid));
+        WARN("no interface for %s\n", debugstr_guid(iid));
         *obj = NULL;
         return E_NOINTERFACE;
     }
@@ -753,33 +777,208 @@ static HRESULT WINAPI window_prop_store_QueryInterface(IPropertyStore *iface, RE
     return S_OK;
 }
 
+static LSTATUS window_prop_key(HWND hwnd, BOOL create, HKEY *key)
+{
+    WCHAR path[80];
+
+    swprintf(path, ARRAY_SIZE(path), L"Software\\Wine\\Shell\\WindowProperties\\%08lx", HandleToUlong(hwnd));
+    if (!create) return RegOpenKeyExW(HKEY_CURRENT_USER, path, 0, KEY_READ, key);
+    /* the window's, and the session's: not kept past it */
+    return RegCreateKeyExW(HKEY_CURRENT_USER, path, 0, NULL, REG_OPTION_VOLATILE, KEY_READ | KEY_WRITE, NULL, key, NULL);
+}
+
+static void window_prop_name(const PROPERTYKEY *key, WCHAR *name)
+{
+    const GUID *g = &key->fmtid;
+    swprintf(name, 64, L"{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X} %lu", g->Data1, g->Data2, g->Data3,
+             g->Data4[0], g->Data4[1], g->Data4[2], g->Data4[3], g->Data4[4], g->Data4[5], g->Data4[6], g->Data4[7],
+             key->pid);
+}
+
+static BOOL window_prop_parse_name(const WCHAR *name, PROPERTYKEY *key)
+{
+    WCHAR guid[39];
+    const WCHAR *space = wcschr(name, ' ');
+
+    if (!space || space - name != 38) return FALSE;
+    memcpy(guid, name, 38 * sizeof(WCHAR));
+    guid[38] = 0;
+    if (CLSIDFromString(guid, &key->fmtid) != S_OK) return FALSE;
+    key->pid = wcstoul(space + 1, NULL, 10);
+    return TRUE;
+}
+
 static HRESULT WINAPI window_prop_store_GetCount(IPropertyStore *iface, DWORD *count)
 {
-    FIXME("%p, %p\n", iface, count);
-    return E_NOTIMPL;
+    struct window_prop_store *store = impl_from_IPropertyStore(iface);
+    HKEY key;
+
+    TRACE("%p, %p\n", iface, count);
+
+    if (!count) return E_POINTER;
+    *count = 0;
+    if (window_prop_key(store->hwnd, FALSE, &key)) return S_OK;
+    RegQueryInfoKeyW(key, NULL, NULL, NULL, NULL, NULL, NULL, count, NULL, NULL, NULL, NULL);
+    RegCloseKey(key);
+    return S_OK;
 }
 
-static HRESULT WINAPI window_prop_store_GetAt(IPropertyStore *iface, DWORD prop, PROPERTYKEY *key)
+static HRESULT WINAPI window_prop_store_GetAt(IPropertyStore *iface, DWORD prop, PROPERTYKEY *pkey)
 {
-    FIXME("%p, %lu,%p\n", iface, prop, key);
-    return E_NOTIMPL;
+    struct window_prop_store *store = impl_from_IPropertyStore(iface);
+    WCHAR name[64];
+    DWORD len = ARRAY_SIZE(name);
+    HRESULT hr = E_INVALIDARG;
+    HKEY key;
+
+    TRACE("%p, %lu, %p\n", iface, prop, pkey);
+
+    if (!pkey) return E_POINTER;
+    if (window_prop_key(store->hwnd, FALSE, &key)) return E_INVALIDARG;
+    if (!RegEnumValueW(key, prop, name, &len, NULL, NULL, NULL, NULL) && window_prop_parse_name(name, pkey)) hr = S_OK;
+    RegCloseKey(key);
+    return hr;
 }
 
-static HRESULT WINAPI window_prop_store_GetValue(IPropertyStore *iface, const PROPERTYKEY *key, PROPVARIANT *var)
+static HRESULT WINAPI window_prop_store_GetValue(IPropertyStore *iface, const PROPERTYKEY *pkey, PROPVARIANT *var)
 {
-    FIXME("%p, {%s,%lu}, %p\n", iface, debugstr_guid(&key->fmtid), key->pid, var);
-    return E_NOTIMPL;
+    struct window_prop_store *store = impl_from_IPropertyStore(iface);
+    WCHAR name[64];
+    BYTE *data = NULL;
+    DWORD size = 0, type;
+    HRESULT hr = S_OK;
+    VARTYPE vt;
+    HKEY key;
+
+    TRACE("%p, {%s,%lu}, %p\n", iface, debugstr_guid(&pkey->fmtid), pkey->pid, var);
+
+    if (!pkey || !var) return E_POINTER;
+    PropVariantInit(var);
+    if (window_prop_key(store->hwnd, FALSE, &key)) return S_OK;
+    window_prop_name(pkey, name);
+    if (RegQueryValueExW(key, name, NULL, &type, NULL, &size) || type != REG_BINARY || size < sizeof(DWORD) ||
+        !(data = malloc(size)) || RegQueryValueExW(key, name, NULL, NULL, data, &size))
+    {
+        free(data);
+        RegCloseKey(key);
+        return S_OK;   /* not set: VT_EMPTY */
+    }
+    RegCloseKey(key);
+
+    vt = *(VARTYPE *)data;
+    size -= sizeof(DWORD);
+    switch (vt)
+    {
+    case VT_LPWSTR:
+        if (!(var->pwszVal = CoTaskMemAlloc(size + sizeof(WCHAR)))) { hr = E_OUTOFMEMORY; break; }
+        memcpy(var->pwszVal, data + sizeof(DWORD), size);
+        var->pwszVal[size / sizeof(WCHAR)] = 0;
+        var->vt = vt;
+        break;
+    case VT_BOOL: case VT_I2: case VT_UI2:
+    case VT_I4: case VT_UI4: case VT_INT: case VT_UINT: case VT_ERROR:
+    case VT_I8: case VT_UI8: case VT_R4: case VT_R8: case VT_FILETIME: case VT_CLSID: case VT_I1: case VT_UI1:
+        if (vt == VT_CLSID)
+        {
+            if (size != sizeof(GUID) || !(var->puuid = CoTaskMemAlloc(sizeof(GUID)))) { hr = E_FAIL; break; }
+            memcpy(var->puuid, data + sizeof(DWORD), sizeof(GUID));
+        }
+        else memcpy(&var->uhVal, data + sizeof(DWORD), min(size, sizeof(var->uhVal)));
+        var->vt = vt;
+        break;
+    default:
+        hr = E_FAIL;
+        break;
+    }
+    free(data);
+    return hr;
+}
+
+/* the taskbar reads the window's ID, relaunch command and pinning again */
+static void window_prop_notify_taskbar(HWND hwnd)
+{
+    struct sg_taskbar_list_data data = { SG_TBL_PROPERTIES, HandleToLong(hwnd) };
+    COPYDATASTRUCT cds = { SG_TASKBAR_LIST_DATA, sizeof(data), &data };
+    DWORD_PTR result;
+    HWND tray;
+
+    if (!(tray = FindWindowExW(0, NULL, L"Shell_TrayWnd", NULL))) return;
+    SendMessageTimeoutW(tray, WM_COPYDATA, 0, (LPARAM)&cds, SMTO_ABORTIFHUNG, 2000, &result);
 }
 
-static HRESULT WINAPI window_prop_store_SetValue(IPropertyStore *iface, const PROPERTYKEY *key, const PROPVARIANT *var)
+static HRESULT WINAPI window_prop_store_SetValue(IPropertyStore *iface, const PROPERTYKEY *pkey, const PROPVARIANT *var)
 {
-    FIXME("%p, {%s,%lu}, %p\n", iface, debugstr_guid(&key->fmtid), key->pid, var);
+    struct window_prop_store *store = impl_from_IPropertyStore(iface);
+    WCHAR name[64];
+    BYTE *data;
+    DWORD size;
+    const void *payload = NULL;
+    HKEY key;
+    LSTATUS ret;
+
+    TRACE("%p, {%s,%lu}, %p\n", iface, debugstr_guid(&pkey->fmtid), pkey->pid, var);
+
+    if (!pkey || !var) return E_POINTER;
+    if (!IsWindow(store->hwnd)) return HRESULT_FROM_WIN32(ERROR_INVALID_WINDOW_HANDLE);
+    window_prop_name(pkey, name);
+
+    switch (var->vt)
+    {
+    case VT_EMPTY:
+        /* takes the property away (the ID: the window goes back to its program's) */
+        if (!window_prop_key(store->hwnd, FALSE, &key))
+        {
+            RegCloseKey(key);
+            if (!window_prop_key(store->hwnd, TRUE, &key))
+            {
+                RegDeleteValueW(key, name);
+                RegCloseKey(key);
+            }
+        }
+        if (IsEqualGUID(&pkey->fmtid, &appusermodel_fmtid)) window_prop_notify_taskbar(store->hwnd);
+        return S_OK;
+    case VT_LPWSTR:
+        if (!var->pwszVal) return E_INVALIDARG;
+        payload = var->pwszVal;
+        size = wcslen(var->pwszVal) * sizeof(WCHAR);
+        /* an AppUserModelID is at most 128 characters */
+        if (IsEqualGUID(&pkey->fmtid, &appusermodel_fmtid) && pkey->pid == APPUSERMODEL_ID_PID && (!size || size > 128 * sizeof(WCHAR))) return E_INVALIDARG;
+        break;
+    case VT_BSTR:
+        payload = var->bstrVal;
+        size = SysStringLen(var->bstrVal) * sizeof(WCHAR);
+        break;
+    case VT_BOOL: case VT_I2: case VT_UI2: size = 2; payload = &var->iVal; break;
+    case VT_I1: case VT_UI1: size = 1; payload = &var->bVal; break;
+    case VT_I4: case VT_UI4: case VT_INT: case VT_UINT: case VT_ERROR: case VT_R4: size = 4; payload = &var->lVal; break;
+    case VT_I8: case VT_UI8: case VT_R8: case VT_FILETIME: size = 8; payload = &var->hVal; break;
+    case VT_CLSID:
+        if (!var->puuid) return E_INVALIDARG;
+        size = sizeof(GUID); payload = var->puuid;
+        break;
+    default:
+        FIXME("type %u not kept\n", var->vt);
+        return E_INVALIDARG;
+    }
+
+    if (!(data = malloc(sizeof(DWORD) + size))) return E_OUTOFMEMORY;
+    *(DWORD *)data = var->vt == VT_BSTR ? VT_LPWSTR : var->vt;   /* read back as a string */
+    memcpy(data + sizeof(DWORD), payload, size);
+    if (!(ret = window_prop_key(store->hwnd, TRUE, &key)))
+    {
+        ret = RegSetValueExW(key, name, 0, REG_BINARY, data, sizeof(DWORD) + size);
+        RegCloseKey(key);
+    }
+    free(data);
+    if (ret) return HRESULT_FROM_WIN32(ret);
+    if (IsEqualGUID(&pkey->fmtid, &appusermodel_fmtid)) window_prop_notify_taskbar(store->hwnd);
     return S_OK;
 }
 
