+        sg_read_app_ids( win );
     }
     win->button = CreateWindowW( WC_BUTTONW, NULL, WS_CHILD | BS_OWNERDRAW,
                                  0, 0, 0, 0, tray_window, (HMENU)hwnd, 0, 0 );
@@ -1733,6 +1825,15 @@ static void remove_taskbar_button( HWND hwnd )
     if (win->exe_icon) DestroyIcon( win->exe_icon );
