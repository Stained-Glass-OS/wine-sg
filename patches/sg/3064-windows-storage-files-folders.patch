+static void test_items(void)
+{
+    IStorageFolder *root_folder, *sub;
+    IStorageFile *file, *copy, *other;
+    IStorageItem *item;
+    IStorageItem2 *item2, *item2_other;
+    IStorageItemProperties *props;
+    IAsyncOperation_BasicProperties *props_op;
+    IBasicProperties *basic;
+    IAsyncOperation_IStorageItem *parent_op;
+    IAsyncOperation_StorageFolder *parent_op2;
+    IAsyncAction *action;
+    HRESULT hr;
+    HSTRING str;
+    UINT64 size;
+    boolean equal;
+    WCHAR path[MAX_PATH];
+
+    root_folder = folder_from_path( root, &hr );
+    sub = create_folder( root_folder, L"items", CreationCollisionOption_ReplaceExisting, &hr );
+    ok( hr == S_OK && sub, "got hr %#lx.\n", hr );
+    file = create_file( sub, L"data.txt", CreationCollisionOption_FailIfExists, &hr );
+    ok( hr == S_OK && file, "got hr %#lx.\n", hr );
+
+    /* write through a stream, read back through another */
+    {
+        IAsyncOperation_IRandomAccessStream *stream_op;
+        IRandomAccessStream *stream;
+        IOutputStream *out;
+        IBuffer *buffer;
+        IBufferFactory *factory;
+        UINT64 stream_size;
+        boolean can;
+        HANDLE h;
+        char data[16];
+        DWORD read;
+
+        hr = IStorageFile_OpenAsync( file, FileAccessMode_ReadWrite, &stream_op );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = await_ptr( stream_op, (void **)&stream );
+        ok( hr == S_OK && stream, "got hr %#lx.\n", hr );
+        hr = IRandomAccessStream_get_Size( stream, &stream_size );
+        ok( hr == S_OK && !stream_size, "got hr %#lx, size %I64u.\n", hr, stream_size );
+        hr = IRandomAccessStream_get_CanWrite( stream, &can );
+        ok( hr == S_OK && can, "got hr %#lx.\n", hr );
+        hr = IRandomAccessStream_QueryInterface( stream, &IID_IOutputStream, (void **)&out );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        {
+            HSTRING cls = hs( RuntimeClass_Windows_Storage_Streams_Buffer );
+            IAsyncOperation_UINT32 *write_unused;
+            IAsyncOperationWithProgress_UINT32_UINT32 *write_op;
+            UINT32 written = 0;
+            BYTE *bytes;
+            IBufferByteAccess *access;
+
+            hr = RoGetActivationFactory( cls, &IID_IBufferFactory, (void **)&factory );
+            WindowsDeleteString( cls );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            hr = IBufferFactory_Create( factory, 8, &buffer );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&access );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            IBufferByteAccess_Buffer( access, &bytes );
+            memcpy( bytes, "stored!!", 8 );
+            IBuffer_put_Length( buffer, 8 );
+            hr = IOutputStream_WriteAsync( out, buffer, &write_op );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            hr = IAsyncOperationWithProgress_UINT32_UINT32_GetResults( write_op, &written );
+            ok( hr == S_OK && written == 8, "got hr %#lx, written %u.\n", hr, written );
+            IAsyncOperationWithProgress_UINT32_UINT32_Release( write_op );
+            (void)write_unused;
+            IBufferByteAccess_Release( access );
+            IBuffer_Release( buffer );
+            IBufferFactory_Release( factory );
+        }
+        hr = IRandomAccessStream_get_Size( stream, &stream_size );
+        ok( hr == S_OK && stream_size == 8, "got hr %#lx, size %I64u.\n", hr, stream_size );
+        IOutputStream_Release( out );
+        {
+            IClosable *closable;
+            IRandomAccessStream_QueryInterface( stream, &IID_IClosable, (void **)&closable );
+            IClosable_Close( closable );
+            IClosable_Release( closable );
+        }
+        IRandomAccessStream_Release( stream );
+
+        swprintf( path, ARRAY_SIZE(path), L"%ls\\items\\data.txt", root );
+        h = CreateFileW( path, GENERIC_READ, 0, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+        ok( h != INVALID_HANDLE_VALUE, "the stream still has the file open, error %lu.\n", GetLastError() );
+        memset( data, 0, sizeof(data) );
+        ReadFile( h, data, sizeof(data), &read, NULL );
+        ok( read == 8 && !memcmp( data, "stored!!", 8 ), "got %lu bytes %s.\n", read, debugstr_an( data, read ) );
+        CloseHandle( h );
+
+        /* read access refuses writes */
+        hr = IStorageFile_OpenAsync( file, FileAccessMode_Read, &stream_op );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = await_ptr( stream_op, (void **)&stream );
+        ok( hr == S_OK && stream, "got hr %#lx.\n", hr );
+        hr = IRandomAccessStream_get_CanWrite( stream, &can );
+        ok( hr == S_OK && !can, "got hr %#lx, can %d.\n", hr, can );
+        hr = IRandomAccessStream_put_Size( stream, 3 );
+        ok( hr == E_ACCESSDENIED, "got hr %#lx.\n", hr );
+        IRandomAccessStream_Release( stream );
+    }
+
+    /* properties */
+    hr = IStorageFile_QueryInterface( file, &IID_IStorageItem, (void **)&item );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IStorageItem_GetBasicPropertiesAsync( item, &props_op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_ptr( props_op, (void **)&basic );
+    ok( hr == S_OK && basic, "got hr %#lx.\n", hr );
+    hr = IBasicProperties_get_Size( basic, &size );
+    ok( hr == S_OK && size == 8, "got hr %#lx, size %I64u.\n", hr, size );
+    {
+        DateTime modified;
+        hr = IBasicProperties_get_DateModified( basic, &modified );
+        ok( hr == S_OK && modified.UniversalTime > 0, "got hr %#lx.\n", hr );
+    }
+    IBasicProperties_Release( basic );
+
+    hr = IStorageFile_QueryInterface( file, &IID_IStorageItemProperties, (void **)&props );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IStorageItemProperties_get_DisplayName( props, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    CHECK_HSTRING( str, L"data" );
+    hr = IStorageItemProperties_get_DisplayType( props, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( *WindowsGetStringRawBuffer( str, NULL ), "empty display type.\n" );
+    WindowsDeleteString( str );
+    IStorageItemProperties_Release( props );
+
+    /* parent and equality */
+    hr = IStorageFile_QueryInterface( file, &IID_IStorageItem2, (void **)&item2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IStorageItem2_GetParentAsync( item2, &parent_op2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_ptr( parent_op2, (void **)&other );
+    ok( hr == S_OK && other, "got hr %#lx.\n", hr );
+    CHECK_NAME( other, L"items" );
+    hr = IStorageItem2_IsEqual( item2, item, &equal );
+    ok( hr == S_OK && equal, "got hr %#lx, equal %d.\n", hr, equal );
+    hr = IStorageFolder_QueryInterface( sub, &IID_IStorageItem2, (void **)&item2_other );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    {
+        IStorageItem *sub_item;
+        IStorageFolder_QueryInterface( sub, &IID_IStorageItem, (void **)&sub_item );
+        hr = IStorageItem2_IsEqual( item2, sub_item, &equal );
+        ok( hr == S_OK && !equal, "got hr %#lx, equal %d.\n", hr, equal );
+        hr = IStorageItem2_IsEqual( item2_other, sub_item, &equal );
+        ok( hr == S_OK && equal, "got hr %#lx, equal %d.\n", hr, equal );
+        IStorageItem_Release( sub_item );
+    }
+    IStorageItem2_Release( item2_other );
+    IStorageItem2_Release( item2 );
+    IStorageFolder_Release( (IStorageFolder *)other );
+    (void)parent_op;
+
+    /* copy, move, rename, delete */
+    {
+        IAsyncOperation_StorageFile *copy_op;
+
+        str = hs( L"copy.txt" );
+        hr = IStorageFile_CopyOverloadDefaultOptions( file, sub, str, &copy_op );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = await_ptr( copy_op, (void **)&copy );
+        ok( hr == S_OK && copy, "got hr %#lx.\n", hr );
+        CHECK_NAME( copy, L"copy.txt" );
+        hr = IStorageFile_CopyOverloadDefaultOptions( file, sub, str, &copy_op );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = await_ptr( copy_op, (void **)&other );
+        ok( hr == HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS ) && !other, "got hr %#lx.\n", hr );
+        hr = IStorageFile_CopyOverload( file, sub, str, NameCollisionOption_GenerateUniqueName, &copy_op );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = await_ptr( copy_op, (void **)&other );
+        ok( hr == S_OK && other, "got hr %#lx.\n", hr );
+        CHECK_NAME( other, L"copy (1).txt" );
+        IStorageFile_Release( other );
+        WindowsDeleteString( str );
+    }
+
+    str = hs( L"renamed.dat" );
+    hr = IStorageItem_RenameAsyncOverloadDefaultOptions( item, str, &action );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_action( action );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    CHECK_NAME( file, L"renamed.dat" );
+    swprintf( path, ARRAY_SIZE(path), L"%ls\\items\\renamed.dat", root );
+    ok( GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES, "the file was not renamed.\n" );
+    WindowsDeleteString( str );
+    str = hs( L"copy.txt" );
+    hr = IStorageItem_RenameAsyncOverloadDefaultOptions( item, str, &action );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_action( action );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS ), "got hr %#lx.\n", hr );
+    hr = IStorageItem_RenameAsync( item, str, NameCollisionOption_ReplaceExisting, &action );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_action( action );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    WindowsDeleteString( str );
+    swprintf( path, ARRAY_SIZE(path), L"%ls\\items\\renamed.dat", root );
+    ok( GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES, "the old name is still there.\n" );
+
+    hr = IStorageItem_DeleteAsyncOverloadDefaultOptions( item, &action );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_action( action );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    swprintf( path, ARRAY_SIZE(path), L"%ls\\items\\copy.txt", root );
+    ok( GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES, "the file was not deleted.\n" );
+    hr = IStorageItem_DeleteAsyncOverloadDefaultOptions( item, &action );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_action( action );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND ), "got hr %#lx.\n", hr );
+    IStorageItem_Release( item );
+
+    /* a folder with contents is deleted with them */
+    {
+        IStorageItem *sub_item;
+
+        IStorageFolder_QueryInterface( sub, &IID_IStorageItem, (void **)&sub_item );
+        hr = IStorageItem_DeleteAsync( sub_item, StorageDeleteOption_PermanentDelete, &action );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = await_action( action );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        swprintf( path, ARRAY_SIZE(path), L"%ls\\items", root );
+        ok( GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES, "the folder was not deleted.\n" );
+        IStorageItem_Release( sub_item );
+    }
+    IStorageFile_Release( copy );
+    IStorageFile_Release( file );
+    IStorageFolder_Release( sub );
+    IStorageFolder_Release( root_folder );
+}
