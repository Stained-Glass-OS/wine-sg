+
+/* IAsyncOperation<T *> that is already done; iid is IID_IAsyncOperation_T */
+HRESULT async_ptr_create( const GUID *iid, const WCHAR *class_name, IUnknown *result, HRESULT hr, void **out )
+{
+    struct async *impl;
+    HRESULT ret;
+
+    if (FAILED(ret = async_create( ASYNC_PTR, &ptr_vtbl, hr, &impl ))) return ret;
+    impl->iid = iid;
+    impl->class_name = class_name;
+    if ((impl->ptr = result)) IUnknown_AddRef( result );
+    *out = &impl->op_iface;
+    return S_OK;
+}
+
+HRESULT async_hstring_create( const WCHAR *text, HRESULT hr, IAsyncOperation_HSTRING **out )
+{
+    struct async *impl;
+    HRESULT ret;
+
+    if (FAILED(ret = async_create( ASYNC_HSTRING, &str_vtbl, hr, &impl ))) return ret;
+    impl->iid = &IID_IAsyncOperation_HSTRING;
+    if (SUCCEEDED(hr) && FAILED(ret = WindowsCreateString( text, wcslen( text ), &impl->str )))
+    {
+        IInspectable_Release( &impl->op_iface );
+        return ret;
+    }
+    *out = (IAsyncOperation_HSTRING *)&impl->op_iface;
+    return S_OK;
+}
+
+HRESULT async_action_create( HRESULT hr, IAsyncAction **out )
+{
+    struct async *impl;
+    HRESULT ret;
+
+    if (FAILED(ret = async_create( ASYNC_ACTION, &action_vtbl, hr, &impl ))) return ret;
+    *out = (IAsyncAction *)&impl->op_iface;
+    return S_OK;
+}
+
+/* IAsyncOperation<enum> with a 32-bit result */
+HRESULT async_enum_create( const GUID *iid, UINT32 result, HRESULT hr, void **out )
+{
+    struct async *impl;
+    HRESULT ret;
+
+    if (FAILED(ret = async_create( ASYNC_UINT32, &u32_vtbl, hr, &impl ))) return ret;
+    impl->u32 = result;
+    impl->iid = iid;
+    *out = &impl->op_iface;
+    return S_OK;
+}
