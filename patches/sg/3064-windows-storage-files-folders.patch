+static HRESULT item_delete( struct item *impl, IAsyncAction **operation )
+{
+    HRESULT hr = item_ensure_exists( impl );
+
+    if (!operation) return E_POINTER;
+    if (impl->is_virtual) hr = E_ACCESSDENIED;
+    else if (SUCCEEDED(hr)) hr = delete_tree( impl->path );
+    return ret_action( hr, operation );
+}
