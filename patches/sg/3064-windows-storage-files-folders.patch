+static HRESULT WINAPI item_RenameAsyncOverloadDefaultOptions( IStorageItem *iface, HSTRING name, IAsyncAction **operation )
+{
+    TRACE( "iface %p, name %s, operation %p.\n", iface, debugstr_hstring( name ), operation );
+    return item_rename( impl_from_IStorageItem( iface ), name, COLLIDE_FAIL, operation );
+}
