+#define APPMODEL_NO_PACKAGE_HR ((HRESULT)0x80073d54)
+#define PACKAGE_FAMILY_NAME_MAX_LENGTH 65
+LONG WINAPI GetCurrentPackagePath( UINT32 *length, WCHAR *path );
+
+/* ms-appx:///dir/file and ms-appdata:///local|roaming|temp/dir/file */
+static HRESULT app_uri_path( const WCHAR *uri, WCHAR **path )
+{
+    WCHAR family[PACKAGE_FAMILY_NAME_MAX_LENGTH + 1], base[MAX_PATH], *rest, *out, *p;
+    UINT32 len;
+    HRESULT hr;
+    int skip;
+
+    if (!wcsnicmp( uri, L"ms-appx:///", 11 )) skip = 11;
+    else if (!wcsnicmp( uri, L"ms-appdata:///", 14 )) skip = 14;
+    else return E_INVALIDARG;
+    rest = (WCHAR *)uri + skip;
+
+    if (skip == 11)
+    {
+        len = ARRAY_SIZE(base);
+        if (GetCurrentPackagePath( &len, base ) != ERROR_SUCCESS) return APPMODEL_NO_PACKAGE_HR;
+    }
+    else
+    {
+        const WCHAR *sub;
+        WCHAR *appdata = NULL;
+
+        len = ARRAY_SIZE(family);
+        if (GetCurrentPackageFamilyName( &len, family ) != ERROR_SUCCESS) return APPMODEL_NO_PACKAGE_HR;
+        if (!wcsnicmp( rest, L"local/", 6 ) || !wcsicmp( rest, L"local" )) { sub = L"LocalState"; skip = 5; }
+        else if (!wcsnicmp( rest, L"roaming/", 8 ) || !wcsicmp( rest, L"roaming" )) { sub = L"RoamingState"; skip = 7; }
+        else if (!wcsnicmp( rest, L"temp/", 5 ) || !wcsicmp( rest, L"temp" )) { sub = L"TempState"; skip = 4; }
+        else return E_INVALIDARG;
+        rest += skip;
+        if (*rest == '/') rest++;
+        if (FAILED(hr = SHGetKnownFolderPath( &FOLDERID_LocalAppData, KF_FLAG_CREATE, NULL, &appdata ))) return hr;
+        swprintf( base, ARRAY_SIZE(base), L"%ls\\Packages\\%ls\\%ls", appdata, family, sub );
+        CoTaskMemFree( appdata );
+    }
+    if (!(out = path_join( base, rest ))) return E_OUTOFMEMORY;
+    /* the URI path uses / and escapes */
+    for (p = out + wcslen( base ); *p; p++) if (*p == '/') *p = '\\';
+    {
+        WCHAR *src = out + wcslen( base ), *dst = src;
+
+        while (*src)
+        {
+            if (src[0] == '%' && iswxdigit( src[1] ) && iswxdigit( src[2] ))
+            {
+                WCHAR hex[3] = { src[1], src[2], 0 };
+                *dst++ = wcstol( hex, NULL, 16 );
+                src += 3;
+            }
+            else *dst++ = *src++;
+        }
+        *dst = 0;
+    }
+    *path = out;
+    return S_OK;
+}
