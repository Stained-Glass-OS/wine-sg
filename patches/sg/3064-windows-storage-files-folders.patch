+/* the child called name; want is 1 for files, 2 for folders, 3 for either */
+static HRESULT folder_get_child( struct item *impl, HSTRING hname, int want, BOOL try_only, IUnknown **result )
+{
+    const WCHAR *name = WindowsGetStringRawBuffer( hname, NULL );
+    WCHAR *path;
+    DWORD attr;
+    HRESULT hr;
+
+    *result = NULL;
+    if (!is_valid_name( name )) return try_only ? S_OK : (name && *name ? HRESULT_FROM_WIN32( ERROR_INVALID_NAME ) : E_INVALIDARG);
+    if (impl->is_virtual) return try_only ? S_OK : HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
+    if (!(path = path_join( impl->path, name ))) return E_OUTOFMEMORY;
+    attr = GetFileAttributesW( path );
+    if (attr == INVALID_FILE_ATTRIBUTES || (!(attr & FILE_ATTRIBUTE_DIRECTORY) && !(want & 1)) ||
+        ((attr & FILE_ATTRIBUTE_DIRECTORY) && !(want & 2)))
+        hr = try_only ? S_OK : HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
+    else
+        hr = item_from_path( path, !!(attr & FILE_ATTRIBUTE_DIRECTORY), result );
+    free( path );
+    return hr;
+}
