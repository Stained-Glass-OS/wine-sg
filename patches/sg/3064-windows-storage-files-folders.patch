+static void test_statics(void)
+{
+    IStorageFolder *folder;
+    IStorageFile *file;
+    IStorageItem *item;
+    IStorageItem2 *item2;
+    IInspectable *insp;
+    HSTRING str;
+    WCHAR path[MAX_PATH];
+    HANDLE handle;
+    HRESULT hr;
+    boolean value;
+    FileAttributes attributes;
+    DateTime created;
+    ULONG count;
+    IID *iids;
+    TrustLevel trust;
+
+    folder = folder_from_path( root, &hr );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (!folder) return;
+
+    hr = IStorageFolder_QueryInterface( folder, &IID_IStorageItem, (void **)&item );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IStorageItem_get_Path( item, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    CHECK_HSTRING( str, root );
+    hr = IStorageItem_get_Name( item, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    CHECK_HSTRING( str, wcsrchr( root, '\\' ) + 1 );
+    hr = IStorageItem_get_Attributes( item, &attributes );
+    ok( hr == S_OK && (attributes & FileAttributes_Directory), "got hr %#lx, attributes %#x.\n", hr, attributes );
+    hr = IStorageItem_get_DateCreated( item, &created );
+    ok( hr == S_OK && created.UniversalTime > 0, "got hr %#lx.\n", hr );
+    hr = IStorageItem_IsOfType( item, StorageItemTypes_Folder, &value );
+    ok( hr == S_OK && value, "got hr %#lx, value %d.\n", hr, value );
+    hr = IStorageItem_IsOfType( item, StorageItemTypes_File, &value );
+    ok( hr == S_OK && !value, "got hr %#lx, value %d.\n", hr, value );
+    hr = IStorageItem_IsOfType( item, StorageItemTypes_File | StorageItemTypes_Folder, &value );
+    ok( hr == S_OK && value, "got hr %#lx, value %d.\n", hr, value );
+    IStorageItem_Release( item );
+
+    hr = IStorageFolder_GetRuntimeClassName( folder, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    CHECK_HSTRING( str, L"Windows.Storage.StorageFolder" );
+    hr = IStorageFolder_GetTrustLevel( folder, &trust );
+    ok( hr == S_OK && trust == BaseTrust, "got hr %#lx, trust %d.\n", hr, trust );
+    hr = IStorageFolder_GetIids( folder, &count, &iids );
+    ok( hr == S_OK && count >= 5, "got hr %#lx, count %lu.\n", hr, count );
+    if (hr == S_OK) CoTaskMemFree( iids );
+    hr = IStorageFolder_QueryInterface( folder, &IID_IInspectable, (void **)&insp );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IInspectable_Release( insp );
+    hr = IStorageFolder_QueryInterface( folder, &IID_IStorageFile, (void **)&insp );
+    ok( hr == E_NOINTERFACE, "got hr %#lx.\n", hr );
+    hr = IStorageFolder_QueryInterface( folder, &IID_IStorageItem2, (void **)&item2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IStorageItem2_Release( item2 );
+    IStorageFolder_Release( folder );
+
+    /* paths that are not folders */
+    folder = folder_from_path( L"relative\\path", &hr );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    folder = folder_from_path( L"C:/forward/slashes", &hr );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    swprintf( path, ARRAY_SIZE(path), L"%ls\\no such folder", root );
+    folder = folder_from_path( path, &hr );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND ), "got hr %#lx.\n", hr );
+
+    swprintf( path, ARRAY_SIZE(path), L"%ls\\plain.txt", root );
+    handle = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    ok( handle != INVALID_HANDLE_VALUE, "got error %lu.\n", GetLastError() );
+    CloseHandle( handle );
+    folder = folder_from_path( path, &hr );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_DIRECTORY ), "got hr %#lx.\n", hr );
+
+    file = file_from_path( path, &hr );
+    ok( hr == S_OK && file, "got hr %#lx.\n", hr );
+    CHECK_NAME( file, L"plain.txt" );
+    hr = IStorageFile_get_FileType( file, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    CHECK_HSTRING( str, L".txt" );
+    hr = IStorageFile_GetRuntimeClassName( file, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    CHECK_HSTRING( str, L"Windows.Storage.StorageFile" );
+    IStorageFile_Release( file );
+    file = file_from_path( root, &hr );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND ), "got hr %#lx.\n", hr );
+    DeleteFileW( path );
+}
