+static HRESULT WINAPI item2_GetParentAsync( IStorageItem2 *iface, IAsyncOperation_StorageFolder **operation )
+{
+    struct item *impl = impl_from_IStorageItem2( iface );
+    IUnknown *parent = NULL;
+    WCHAR *dir;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    if (!operation) return E_POINTER;
+    if (!impl->is_virtual && (dir = path_parent( impl->path )))
