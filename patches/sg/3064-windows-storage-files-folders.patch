+    IStorageFolder_Release( folder );
+
+    hr = IKnownFoldersStatics_QueryInterface( statics, &IID_IKnownFoldersStatics4, (void **)&statics4 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IKnownFoldersStatics4_GetFolderAsync( statics4, KnownFolderId_MusicLibrary, &op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_ptr( op, (void **)&folder );
+    ok( hr == S_OK && folder, "got hr %#lx.\n", hr );
+    if (folder) IStorageFolder_Release( folder );
+    hr = IKnownFoldersStatics4_RequestAccessAsync( statics4, KnownFolderId_PicturesLibrary, &access_op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IAsyncOperation_KnownFoldersAccessStatus_GetResults( access_op, &status );
+    ok( hr == S_OK && status == KnownFoldersAccessStatus_Allowed, "got hr %#lx, status %d.\n", hr, status );
+    IAsyncOperation_KnownFoldersAccessStatus_Release( access_op );
+    IKnownFoldersStatics4_Release( statics4 );
+    IKnownFoldersStatics_Release( statics );
+    (void)factory;
+}
