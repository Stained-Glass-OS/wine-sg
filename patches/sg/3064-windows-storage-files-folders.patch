+/* IAsyncOperation<T *> for any interface or runtime class T: the same layout for all of them */
+typedef HRESULT (WINAPI *ptr_put_Completed_t)( IInspectable *iface, IUnknown *handler );
+typedef HRESULT (WINAPI *ptr_get_Completed_t)( IInspectable *iface, IUnknown **handler );
+typedef HRESULT (WINAPI *ptr_GetResults_t)( IInspectable *iface, void **results );
+struct ptr_vtbl
+{
+    void *QueryInterface, *AddRef, *Release, *GetIids, *GetRuntimeClassName, *GetTrustLevel;
+    ptr_put_Completed_t put_Completed;
+    ptr_get_Completed_t get_Completed;
+    ptr_GetResults_t GetResults;
+};
+static HRESULT WINAPI ptr_put_Completed( IInspectable *iface, IUnknown *handler )
+{
+    return op_put_Completed( iface, handler );
+}
+static HRESULT WINAPI ptr_get_Completed( IInspectable *iface, IUnknown **handler )
+{
+    return op_get_Completed( iface, handler );
+}
+static HRESULT WINAPI ptr_GetResults( IInspectable *iface, void **results )
+{
+    struct async *impl = impl_from_op( iface );
+    HRESULT hr = op_check_results( impl );
+    TRACE( "iface %p, results %p.\n", iface, results );
+    *results = NULL;
+    if (SUCCEEDED(hr) && (*results = impl->ptr)) IUnknown_AddRef( impl->ptr );
+    return hr;
+}
+static const struct ptr_vtbl ptr_vtbl =
+{
+    op_QueryInterface, op_AddRef, op_Release, op_GetIids, op_GetRuntimeClassName, op_GetTrustLevel,
+    ptr_put_Completed, ptr_get_Completed, ptr_GetResults,
+};
+
+/* IAsyncOperation<HSTRING> */
+static HRESULT WINAPI str_GetResults( IInspectable *iface, HSTRING *results )
+{
+    struct async *impl = impl_from_op( iface );
+    HRESULT hr = op_check_results( impl );
+    TRACE( "iface %p, results %p.\n", iface, results );
+    *results = NULL;
+    if (SUCCEEDED(hr)) hr = WindowsDuplicateString( impl->str, results );
+    return hr;
+}
+static const struct
+{
+    void *QueryInterface, *AddRef, *Release, *GetIids, *GetRuntimeClassName, *GetTrustLevel;
+    ptr_put_Completed_t put_Completed;
+    ptr_get_Completed_t get_Completed;
+    HRESULT (WINAPI *GetResults)( IInspectable *iface, HSTRING *results );
+} str_vtbl =
+{
+    op_QueryInterface, op_AddRef, op_Release, op_GetIids, op_GetRuntimeClassName, op_GetTrustLevel,
+    ptr_put_Completed, ptr_get_Completed, str_GetResults,
+};
+
+/* IAsyncAction */
+static HRESULT WINAPI action_GetResults( IInspectable *iface )
+{
+    struct async *impl = impl_from_op( iface );
+    TRACE( "iface %p.\n", iface );
+    return op_check_results( impl );
+}
+static const struct
+{
+    void *QueryInterface, *AddRef, *Release, *GetIids, *GetRuntimeClassName, *GetTrustLevel;
+    ptr_put_Completed_t put_Completed;
+    ptr_get_Completed_t get_Completed;
+    HRESULT (WINAPI *GetResults)( IInspectable *iface );
+} action_vtbl =
+{
+    op_QueryInterface, op_AddRef, op_Release, op_GetIids, op_GetRuntimeClassName, op_GetTrustLevel,
+    ptr_put_Completed, ptr_get_Completed, action_GetResults,
+};
+
 /* IAsyncInfo */
 static struct async *impl_from_IAsyncInfo( IAsyncInfo *iface )
 {
@@ -418,3 +535,56 @@ HRESULT async_read_create( IBuffer *result, HRESULT hr, IAsyncOperationWithProgr
     *out = (IAsyncOperationWithProgress_IBuffer_UINT32 *)&impl->op_iface;
     return S_OK;
