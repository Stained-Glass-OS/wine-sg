+static IStorageFolder *folder_from_path( const WCHAR *path, HRESULT *hr )
+{
+    IAsyncOperation_StorageFolder *op = NULL;
+    IStorageFolder *folder = NULL;
+    HSTRING str = hs( path );
+
+    *hr = IStorageFolderStatics_GetFolderFromPathAsync( folder_statics, str, &op );
+    WindowsDeleteString( str );
+    ok( *hr == S_OK, "got hr %#lx.\n", *hr );
+    *hr = await_ptr( op, (void **)&folder );
+    return folder;
+}
+
+static IStorageFile *file_from_path( const WCHAR *path, HRESULT *hr )
+{
+    IAsyncOperation_StorageFile *op = NULL;
