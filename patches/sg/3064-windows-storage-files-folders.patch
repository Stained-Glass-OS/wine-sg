+                                        IAsyncAction **operation )
+{
+    TRACE( "iface %p, name %s, option %d, operation %p.\n", iface, debugstr_hstring( name ), option, operation );
+    return item_rename( impl_from_IStorageItem( iface ), name, option, operation );
+}
