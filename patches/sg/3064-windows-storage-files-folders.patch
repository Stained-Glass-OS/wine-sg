+}
+
+static const IBasicPropertiesVtbl props_vtbl =
+{
+    props_QueryInterface, props_AddRef, props_Release, props_GetIids, props_GetRuntimeClassName,
+    props_GetTrustLevel, props_get_Size, props_get_DateModified, props_get_ItemDate,
+};
+
+/* ---- results of asynchronous operations ---- */
+
+static HRESULT ret_ptr( const GUID *iid, const WCHAR *class_name, IUnknown *obj, HRESULT hr, void **out )
+{
+    HRESULT ret;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    ret = async_ptr_create( iid, class_name, obj, hr, out );
+    if (obj) IUnknown_Release( obj );
+    return ret;
+}
+
+#define RET_FILE( obj, hr, out ) \
+    ret_ptr( &IID_IAsyncOperation_StorageFile, L"Windows.Foundation.IAsyncOperation`1<Windows.Storage.StorageFile>", \
+             (IUnknown *)(obj), hr, (void **)(out) )
+#define RET_FOLDER( obj, hr, out ) \
+    ret_ptr( &IID_IAsyncOperation_StorageFolder, L"Windows.Foundation.IAsyncOperation`1<Windows.Storage.StorageFolder>", \
+             (IUnknown *)(obj), hr, (void **)(out) )
+#define RET_ITEM( obj, hr, out ) \
+    ret_ptr( &IID_IAsyncOperation_IStorageItem, L"Windows.Foundation.IAsyncOperation`1<Windows.Storage.IStorageItem>", \
+             (IUnknown *)(obj), hr, (void **)(out) )
+
+static HRESULT ret_action( HRESULT hr, IAsyncAction **out )
+{
+    if (!out) return E_POINTER;
+    return async_action_create( hr, out );
+}
+
+/* the item that results from path, of the kind that is there */
+static HRESULT item_from_path( const WCHAR *path, BOOL is_folder, IUnknown **out )
+{
+    struct item *item;
+    HRESULT hr;
+
+    if (FAILED(hr = item_create( is_folder, path, &item ))) return hr;
+    *out = is_folder ? (IUnknown *)&item->IStorageFolder_iface : (IUnknown *)&item->IStorageFile_iface;
+    return S_OK;
+}
+
+/* ---- IStorageItem (the identity of the object) ---- */
+
+static HRESULT WINAPI item_QueryInterface( IStorageItem *iface, REFIID iid, void **out )
+{
+    struct item *impl = impl_from_IStorageItem( iface );
+    void *found = NULL;
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+        found = impl->is_folder ? (void *)&impl->IStorageFolder_iface : (void *)&impl->IStorageFile_iface;
+    else if (IsEqualGUID( iid, &IID_IStorageItem )) found = &impl->IStorageItem_iface;
+    else if (IsEqualGUID( iid, &IID_IStorageItem2 )) found = &impl->IStorageItem2_iface;
+    else if (IsEqualGUID( iid, &IID_IStorageItemProperties )) found = &impl->IStorageItemProperties_iface;
+    else if (IsEqualGUID( iid, &IID_IStorageItemProperties2 )) found = &impl->IStorageItemProperties2_iface;
+    else if (impl->is_folder)
+    {
+        if (IsEqualGUID( iid, &IID_IStorageFolder )) found = &impl->IStorageFolder_iface;
+        else if (IsEqualGUID( iid, &IID_IStorageFolder2 )) found = &impl->IStorageFolder2_iface;
+        else if (IsEqualGUID( iid, &IID_IStorageFolderQueryOperations )) found = &impl->IStorageFolderQueryOperations_iface;
+    }
+    else
+    {
+        if (IsEqualGUID( iid, &IID_IStorageFile )) found = &impl->IStorageFile_iface;
+        else if (IsEqualGUID( iid, &IID_IStorageFile2 )) found = &impl->IStorageFile2_iface;
+        else if (IsEqualGUID( iid, &IID_IStorageFilePropertiesWithAvailability ))
+            found = &impl->IStorageFilePropertiesWithAvailability_iface;
+        else if (IsEqualGUID( iid, &IID_IInputStreamReference )) found = &impl->IInputStreamReference_iface;
+        else if (IsEqualGUID( iid, &IID_IRandomAccessStreamReference )) found = &impl->IRandomAccessStreamReference_iface;
+    }
+    if (!found)
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    *out = found;
+    IUnknown_AddRef( (IUnknown *)found );
+    return S_OK;
+}
