+/* the folder path of a destination IStorageFolder, from any implementation */
+static HRESULT folder_path( IStorageFolder *folder, WCHAR **path )
+{
+    IStorageItem *item;
+    HSTRING str;
+    HRESULT hr;
+
+    if (!folder) return E_INVALIDARG;
+    if (FAILED(hr = IStorageFolder_QueryInterface( folder, &IID_IStorageItem, (void **)&item ))) return hr;
+    hr = IStorageItem_get_Path( item, &str );
+    IStorageItem_Release( item );
+    if (FAILED(hr)) return hr;
+    if (!*WindowsGetStringRawBuffer( str, NULL )) hr = E_ACCESSDENIED; /* a virtual folder */
+    else if (!(*path = wcsdup( WindowsGetStringRawBuffer( str, NULL ) ))) hr = E_OUTOFMEMORY;
+    WindowsDeleteString( str );
+    return hr;
+}
+
+static HRESULT file_path_of( IStorageFile *file, WCHAR **path )
+{
+    IStorageItem *item;
+    HSTRING str;
+    HRESULT hr;
+
+    if (!file) return E_INVALIDARG;
+    if (FAILED(hr = IStorageFile_QueryInterface( file, &IID_IStorageItem, (void **)&item ))) return hr;
+    hr = IStorageItem_get_Path( item, &str );
+    IStorageItem_Release( item );
+    if (FAILED(hr)) return hr;
+    if (!(*path = wcsdup( WindowsGetStringRawBuffer( str, NULL ) ))) hr = E_OUTOFMEMORY;
+    WindowsDeleteString( str );
+    return hr;
+}
+
+/* CopyAsync and MoveAsync: name may be NULL for the current name */
+static HRESULT file_transfer( struct item *impl, IStorageFolder *folder, HSTRING desired, int option, BOOL move,
+                              IUnknown **result )
+{
+    const WCHAR *name = desired ? WindowsGetStringRawBuffer( desired, NULL ) : path_name( impl->path );
+    WCHAR *dir = NULL, *target = NULL;
+    BOOL replace, open;
+    HRESULT hr;
+
+    if (result) *result = NULL;
+    if (FAILED(hr = item_ensure_exists( impl ))) return hr;
+    if (FAILED(hr = folder_path( folder, &dir ))) return hr;
+    if (SUCCEEDED(hr = resolve_target( dir, name, option, FALSE, &target, &replace, &open )))
+    {
+        if (open) hr = HR_ALREADY_EXISTS;
+        else if (replace && FAILED(hr = delete_tree( target ))) {}
+        else if (move)
+        {
+            if (!MoveFileExW( impl->path, target, MOVEFILE_COPY_ALLOWED )) hr = hr_last_error();
+            else
+            {
+                free( impl->path );
+                impl->path = target;
+                target = NULL;
+                if (result) IStorageItem_AddRef( &impl->IStorageItem_iface );
+                if (result) *result = (IUnknown *)&impl->IStorageFile_iface;
+            }
+        }
+        else if (!CopyFileW( impl->path, target, TRUE )) hr = hr_last_error();
+        else if (result) hr = item_from_path( target, FALSE, result );
+        free( target );
+    }
+    free( dir );
+    return hr;
+}
