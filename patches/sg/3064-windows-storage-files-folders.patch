+/* ---- paths and names ---- */
+
+static HRESULT hr_last_error(void)
+{
+    return HRESULT_FROM_WIN32( GetLastError() );
+}
+
+static BOOL is_valid_name( const WCHAR *name )
+{
+    if (!name || !*name) return FALSE;
+    if (wcspbrk( name, L"\\/:*?\"<>|" )) return FALSE;
+    return TRUE;
+}
+
+/* a full path without trailing separator (except for a root), or an error */
+static HRESULT normalize_path( const WCHAR *in, WCHAR **out )
+{
+    WCHAR full[MAX_PATH * 2], *p;
+    DWORD len;
+
+    if (!in || !*in) return E_INVALIDARG;
+    if (wcschr( in, '/' )) return E_INVALIDARG;
+    if (!((iswalpha( in[0] ) && in[1] == ':' && in[2] == '\\') || (in[0] == '\\' && in[1] == '\\')))
+        return E_INVALIDARG;
+    if (!(len = GetFullPathNameW( in, ARRAY_SIZE(full), full, NULL )) || len >= ARRAY_SIZE(full)) return E_INVALIDARG;
+    /* strip trailing separators, but keep "C:\" */
+    while (len > 3 && full[len - 1] == '\\') full[--len] = 0;
+    if (!(p = wcsdup( full ))) return E_OUTOFMEMORY;
+    *out = p;
+    return S_OK;
+}
+
+static const WCHAR *path_name( const WCHAR *path )
+{
+    const WCHAR *p = wcsrchr( path, '\\' );
+
+    if (!p || !p[1]) return path; /* a root is its own name */
+    return p + 1;
+}
+
+/* dir\name into a new string */
+static WCHAR *path_join( const WCHAR *dir, const WCHAR *name )
+{
+    size_t len = wcslen( dir );
+    WCHAR *ret;
+
+    if (!(ret = malloc( (len + wcslen( name ) + 2) * sizeof(WCHAR) ))) return NULL;
+    wcscpy( ret, dir );
+    if (len && dir[len - 1] != '\\') ret[len++] = '\\';
+    wcscpy( ret + len, name );
+    return ret;
+}
+
+/* the directory part of a path, as a new string; NULL for a root */
+static WCHAR *path_parent( const WCHAR *path )
+{
+    const WCHAR *p = wcsrchr( path, '\\' );
+    WCHAR *ret;
+    size_t len;
+
+    if (!p || p == path) return NULL;
+    len = p - path;
+    if (len == 2 && path[1] == ':') len = 3; /* the root of a drive */
+    if (len >= wcslen( path )) return NULL;
+    if (!(ret = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( ret, path, len * sizeof(WCHAR) );
+    ret[len] = 0;
+    return ret;
+}
+
+static BOOL path_exists( const WCHAR *path )
+{
+    return GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES;
+}
+
+/* "name (N).ext" in dir, for the first N that does not exist */
+static WCHAR *unique_path( const WCHAR *dir, const WCHAR *name )
+{
+    const WCHAR *ext = wcsrchr( name, '.' );
+    WCHAR buf[MAX_PATH], *path;
+    size_t base;
+    int n;
+
+    if (!ext || ext == name) ext = name + wcslen( name );
+    base = ext - name;
+    for (n = 1; n < 10000; n++)
+    {
+        #ifdef SG_MUTANT_UNIQUE
+        swprintf( buf, ARRAY_SIZE(buf), L"%.*ls(%d)%ls", (int)base, name, n, ext );
+#else
+        swprintf( buf, ARRAY_SIZE(buf), L"%.*ls (%d)%ls", (int)base, name, n, ext );
+#endif
+        if (!(path = path_join( dir, buf ))) return NULL;
+        if (!path_exists( path )) return path;
+        free( path );
+    }
+    return NULL;
+}
+
+static HRESULT delete_tree( const WCHAR *path )
+{
+    WIN32_FIND_DATAW fd;
+    WCHAR *pattern, *child;
+    HANDLE find;
+    HRESULT hr = S_OK;
+    DWORD attr = GetFileAttributesW( path );
+
+    if (attr == INVALID_FILE_ATTRIBUTES) return hr_last_error();
+    if (attr & FILE_ATTRIBUTE_READONLY) SetFileAttributesW( path, attr & ~FILE_ATTRIBUTE_READONLY );
+    if (!(attr & FILE_ATTRIBUTE_DIRECTORY) || (attr & FILE_ATTRIBUTE_REPARSE_POINT))
+    {
+        if (attr & FILE_ATTRIBUTE_DIRECTORY) return RemoveDirectoryW( path ) ? S_OK : hr_last_error();
+        return DeleteFileW( path ) ? S_OK : hr_last_error();
+    }
+    if (!(pattern = path_join( path, L"*" ))) return E_OUTOFMEMORY;
+    if ((find = FindFirstFileW( pattern, &fd )) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (!wcscmp( fd.cFileName, L"." ) || !wcscmp( fd.cFileName, L".." )) continue;
+            if (!(child = path_join( path, fd.cFileName ))) { hr = E_OUTOFMEMORY; break; }
+            hr = delete_tree( child );
+            free( child );
+            if (FAILED(hr)) break;
+        } while (FindNextFileW( find, &fd ));
+        FindClose( find );
+    }
+    free( pattern );
+    if (FAILED(hr)) return hr;
+    return RemoveDirectoryW( path ) ? S_OK : hr_last_error();
+}
+
+/*
+ * The path an item is to get in dir under name, by the collision option. *replace is set when an
+ * existing item of that name must be replaced, *open when it is the result itself.
+ */
+static HRESULT resolve_target( const WCHAR *dir, const WCHAR *name, int option, BOOL want_folder, WCHAR **target,
+                               BOOL *replace, BOOL *open )
+{
+    WCHAR *path;
+    DWORD attr;
+
+    *replace = *open = FALSE;
+    if (!is_valid_name( name )) return name && *name ? HRESULT_FROM_WIN32( ERROR_INVALID_NAME ) : E_INVALIDARG;
+    if (!(path = path_join( dir, name ))) return E_OUTOFMEMORY;
+    attr = GetFileAttributesW( path );
+    if (attr == INVALID_FILE_ATTRIBUTES)
+    {
+        *target = path;
+        return S_OK;
+    }
+    switch (option)
+    {
+    case COLLIDE_UNIQUE:
+        free( path );
+        if (!(path = unique_path( dir, name ))) return E_OUTOFMEMORY;
+        break;
+    case COLLIDE_REPLACE:
+        *replace = TRUE;
+        break;
+    case COLLIDE_OPEN:
+        if (!!(attr & FILE_ATTRIBUTE_DIRECTORY) != !!want_folder)
+        {
+            free( path );
+            return HR_ALREADY_EXISTS;
+        }
+        *open = TRUE;
+        break;
+    default:
+#ifdef SG_MUTANT_FAILEXISTS
+        *replace = TRUE;
+        break;
+#endif
+        free( path );
+        return HR_ALREADY_EXISTS;
+    }
+    *target = path;
+    return S_OK;
+}
+
+static const WCHAR *content_type_for( const WCHAR *path, WCHAR *buf, DWORD size )
+{
+    const WCHAR *ext = wcsrchr( path_name( path ), '.' );
+    DWORD len = size * sizeof(WCHAR);
+
+    buf[0] = 0;
+    if (!ext) return buf;
+    if (RegGetValueW( HKEY_CLASSES_ROOT, ext, L"Content Type", RRF_RT_REG_SZ, NULL, buf, &len )) buf[0] = 0;
+    return buf;
+}
+
