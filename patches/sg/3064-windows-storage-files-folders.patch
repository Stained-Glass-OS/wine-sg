+/* the stream on a file, as the operation OpenAsync and friends return */
+static HRESULT file_open_stream( struct item *impl, FileAccessMode mode, StorageOpenOptions options,
+                                 IRandomAccessStream **stream )
+{
+    DWORD access = mode == FileAccessMode_ReadWrite ? GENERIC_READ | GENERIC_WRITE : GENERIC_READ;
+    DWORD share = FILE_SHARE_DELETE;
+    WCHAR type[128];
+    HANDLE file;
+
+    *stream = NULL;
+    if (mode != FileAccessMode_Read && mode != FileAccessMode_ReadWrite) return E_INVALIDARG;
+    if (options & StorageOpenOptions_AllowOnlyReaders) share |= FILE_SHARE_READ;
+    else if (options & StorageOpenOptions_AllowReadersAndWriters) share |= FILE_SHARE_READ | FILE_SHARE_WRITE;
+    else share |= mode == FileAccessMode_Read ? FILE_SHARE_READ | FILE_SHARE_WRITE : FILE_SHARE_READ;
+    file = CreateFileW( impl->path, access, share, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return hr_last_error();
+    content_type_for( impl->path, type, ARRAY_SIZE(type) );
+    return file_stream_create( file, mode == FileAccessMode_ReadWrite, type, stream );
+}
+
+static HRESULT file_open_async( struct item *impl, FileAccessMode mode, StorageOpenOptions options,
+                                IAsyncOperation_IRandomAccessStream **operation )
+{
+    IRandomAccessStream *stream;
+    HRESULT hr = file_open_stream( impl, mode, options, &stream );
+
+    if (!operation) return E_POINTER;
+    return ret_ptr( &IID_IAsyncOperation_IRandomAccessStream,
+                    L"Windows.Foundation.IAsyncOperation`1<Windows.Storage.Streams.IRandomAccessStream>",
+                    SUCCEEDED(hr) ? (IUnknown *)stream : NULL, hr, (void **)operation );
+}
