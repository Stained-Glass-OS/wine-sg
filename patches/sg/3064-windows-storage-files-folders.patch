+/* GetResults of any completed IAsyncOperation<T *> */
+static HRESULT results_ptr( void *op, void **out )
+{
+    AsyncStatus status;
+    IAsyncInfo *info;
+    HRESULT hr;
+
+    *out = NULL;
+    hr = IUnknown_QueryInterface( (IUnknown *)op, &IID_IAsyncInfo, (void **)&info );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IAsyncInfo_get_Status( info, &status );
+    ok( hr == S_OK && (status == Completed || status == Error), "got hr %#lx, status %d.\n", hr, status );
+    IAsyncInfo_Release( info );
+    return ((HRESULT (WINAPI *)( void *, void ** ))VTBL(op)[8])( op, out );
+}
+
+/* the result of a completed operation, whose reference is released */
+static HRESULT await_ptr( void *op, void **out )
+{
+    HRESULT hr;
+
+    hr = results_ptr( op, out );
+    IUnknown_Release( (IUnknown *)op );
+    return hr;
+}
+
+static HRESULT await_action( IAsyncAction *op )
+{
+    HRESULT hr = IAsyncAction_GetResults( op );
+    IAsyncAction_Release( op );
+    return hr;
+}
