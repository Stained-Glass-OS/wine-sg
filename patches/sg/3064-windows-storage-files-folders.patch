+/* ---- enumeration ---- */
+
+struct entry
+{
+    WCHAR *path;
+    BOOL is_folder;
+    UINT64 modified;
+};
+
+static int compare_entries_name( const void *a, const void *b )
+{
+    const struct entry *ea = a, *eb = b;
+    return CompareStringOrdinal( path_name( ea->path ), -1, path_name( eb->path ), -1, TRUE ) - CSTR_EQUAL;
+}
+
+#ifdef SG_MUTANT_SORT
+static int compare_entries_name_reversed( const void *a, const void *b )
+{
+    return -compare_entries_name( a, b );
+}
+#endif
+
+static int compare_entries_date( const void *a, const void *b )
+{
+    const struct entry *ea = a, *eb = b;
+
+    if (ea->modified != eb->modified) return ea->modified < eb->modified ? 1 : -1; /* newest first */
+    return compare_entries_name( a, b );
+}
+
+static void free_entries( struct entry *entries, UINT32 count )
+{
+    UINT32 i;
+    for (i = 0; i < count; i++) free( entries[i].path );
+    free( entries );
+}
+
+/* the children of a folder, files (1), folders (2) or both (3), sorted by name or by date */
+static HRESULT folder_list( struct item *impl, int want, BOOL by_date, struct entry **entries, UINT32 *count )
+{
+    WIN32_FIND_DATAW fd;
+    struct entry *list = NULL, *tmp;
+    UINT32 n = 0, cap = 0;
+    WCHAR *pattern;
+    HANDLE find;
+    HRESULT hr;
+
+    *entries = NULL;
+    *count = 0;
+    if (FAILED(hr = item_ensure_exists( impl ))) return hr;
+
+    if (impl->is_virtual)
+    {
+        /* the virtual folders list the drives of the kind they stand for */
+        if (!wcscmp( impl->virtual_name, L"Removable Storage" ) && (want & 2))
+        {
+            DWORD drives = GetLogicalDrives();
+            WCHAR root[] = L"A:\\";
+            int i;
+
+            for (i = 0; i < 26; i++)
+            {
+                if (!(drives & (1 << i))) continue;
+                root[0] = 'A' + i;
+                if (GetDriveTypeW( root ) != DRIVE_REMOVABLE && GetDriveTypeW( root ) != DRIVE_CDROM) continue;
+                if (n == cap)
+                {
+                    cap = cap ? cap * 2 : 8;
+                    if (!(tmp = realloc( list, cap * sizeof(*list) ))) { free_entries( list, n ); return E_OUTOFMEMORY; }
+                    list = tmp;
+                }
+                list[n].path = wcsdup( root );
+                list[n].is_folder = TRUE;
+                list[n].modified = 0;
+                n++;
+            }
+        }
+        *entries = list;
+        *count = n;
+        return S_OK;
+    }
+
+    if (!(pattern = path_join( impl->path, L"*" ))) return E_OUTOFMEMORY;
+    find = FindFirstFileW( pattern, &fd );
+    free( pattern );
+    if (find == INVALID_HANDLE_VALUE)
+    {
+        DWORD err = GetLastError();
+        return err == ERROR_FILE_NOT_FOUND ? S_OK : HRESULT_FROM_WIN32( err );
+    }
+    do
+    {
+        BOOL is_dir = !!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY);
+
+        if (!wcscmp( fd.cFileName, L"." ) || !wcscmp( fd.cFileName, L".." )) continue;
+        if (!(want & (is_dir ? 2 : 1))) continue;
+        if (n == cap)
+        {
+            cap = cap ? cap * 2 : 16;
+            if (!(tmp = realloc( list, cap * sizeof(*list) ))) { hr = E_OUTOFMEMORY; goto done; }
+            list = tmp;
+        }
+        if (!(list[n].path = path_join( impl->path, fd.cFileName ))) { hr = E_OUTOFMEMORY; goto done; }
+        list[n].is_folder = is_dir;
+        list[n].modified = ((UINT64)fd.ftLastWriteTime.dwHighDateTime << 32) | fd.ftLastWriteTime.dwLowDateTime;
+        n++;
+    } while (FindNextFileW( find, &fd ));
+    hr = S_OK;
+
+done:
+    FindClose( find );
+    if (FAILED(hr))
+    {
+        free_entries( list, n );
+        return hr;
+    }
+#ifdef SG_MUTANT_SORT
+    qsort( list, n, sizeof(*list), by_date ? compare_entries_date : compare_entries_name_reversed );
+#else
+    qsort( list, n, sizeof(*list), by_date ? compare_entries_date : compare_entries_name );
+#endif
+    *entries = list;
+    *count = n;
+    return S_OK;
+}
+
+/* a vector of the entries in [start, start + max), as objects; takes the entries */
+static HRESULT entries_to_vector( struct entry *entries, UINT32 count, UINT32 start, UINT32 max, int want,
+                                  const struct vector_ids *ids, void **out )
+{
+    IUnknown **items;
+    UINT32 i, n = 0;
+    HRESULT hr = S_OK;
+
+    if (start > count) start = count;
+    if (max > count - start) max = count - start;
+    if (!(items = calloc( max ? max : 1, sizeof(*items) )))
+    {
+        free_entries( entries, count );
+        return E_OUTOFMEMORY;
+    }
+    for (i = start; i < start + max && SUCCEEDED(hr); i++)
+        if (SUCCEEDED(hr = item_from_path( entries[i].path, entries[i].is_folder, &items[n] ))) n++;
+    free_entries( entries, count );
+    if (FAILED(hr))
+    {
+        while (n) { n--; IUnknown_Release( items[n] ); }
+        free( items );
+        return hr;
+    }
+    return vector_view_create( ids, items, n, out );
+}
+
+static HRESULT folder_list_async( struct item *impl, int want, BOOL by_date, UINT32 start, UINT32 max, void **operation )
+{
+    struct entry *entries;
+    UINT32 count;
+    void *vector = NULL;
+    const struct vector_ids *ids = want == 1 ? &vector_ids_file : want == 2 ? &vector_ids_folder : &vector_ids_item;
+    const GUID *iid = want == 1 ? &IID_IAsyncOperation_IVectorView_StorageFile :
+                      want == 2 ? &IID_IAsyncOperation_IVectorView_StorageFolder :
+                                  &IID_IAsyncOperation_IVectorView_IStorageItem;
+    const WCHAR *name = want == 1 ?
+        L"Windows.Foundation.IAsyncOperation`1<Windows.Foundation.Collections.IVectorView`1<Windows.Storage.StorageFile>>" :
+        want == 2 ?
+        L"Windows.Foundation.IAsyncOperation`1<Windows.Foundation.Collections.IVectorView`1<Windows.Storage.StorageFolder>>" :
+        L"Windows.Foundation.IAsyncOperation`1<Windows.Foundation.Collections.IVectorView`1<Windows.Storage.IStorageItem>>";
+    HRESULT hr;
+
+    if (!operation) return E_POINTER;
+    if (SUCCEEDED(hr = folder_list( impl, want, by_date, &entries, &count )))
+        hr = entries_to_vector( entries, count, start, max, want, ids, &vector );
+    return ret_ptr( iid, name, SUCCEEDED(hr) ? (IUnknown *)vector : NULL, hr, operation );
+}
+
+static HRESULT WINAPI folder_GetFilesAsyncOverloadDefaultOptionsStartAndCount( IStorageFolder *iface,
+        IAsyncOperation_IVectorView_StorageFile **operation )
