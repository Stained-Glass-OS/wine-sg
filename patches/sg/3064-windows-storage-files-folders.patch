+}
+
+static ULONG WINAPI props_Release( IBasicProperties *iface )
+{
+    struct basic_properties *impl = impl_from_IBasicProperties( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI props_GetIids( IBasicProperties *iface, ULONG *count, IID **iids )
+{
+    IID *list;
+
+    if (!(list = CoTaskMemAlloc( sizeof(*list) ))) return E_OUTOFMEMORY;
+    *list = IID_IBasicProperties;
+    *count = 1;
+    *iids = list;
+    return S_OK;
+}
+
+static HRESULT WINAPI props_GetRuntimeClassName( IBasicProperties *iface, HSTRING *name )
+{
+    static const WCHAR str[] = L"Windows.Storage.FileProperties.BasicProperties";
+    return WindowsCreateString( str, wcslen( str ), name );
+}
+
+static HRESULT WINAPI props_GetTrustLevel( IBasicProperties *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI props_get_Size( IBasicProperties *iface, UINT64 *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = impl_from_IBasicProperties( iface )->size;
+    return S_OK;
+}
+
+static HRESULT WINAPI props_get_DateModified( IBasicProperties *iface, DateTime *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = impl_from_IBasicProperties( iface )->modified;
