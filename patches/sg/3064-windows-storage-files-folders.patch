+
+static HRESULT WINAPI item2_IsEqual( IStorageItem2 *iface, IStorageItem *item, boolean *value )
+{
+    struct item *impl = impl_from_IStorageItem2( iface );
+    HSTRING path = NULL;
+    IStorageItem *other = NULL;
+    StorageItemTypes types = StorageItemTypes_None;
+    boolean is_folder = FALSE;
+
+    TRACE( "iface %p, item %p, value %p.\n", iface, item, value );
+
+    *value = FALSE;
+    if (!item) return S_OK;
+    if (SUCCEEDED(IStorageItem_QueryInterface( item, &IID_IStorageItem, (void **)&other )))
+    {
+        types = StorageItemTypes_Folder;
+        IStorageItem_IsOfType( other, types, &is_folder );
+        if (SUCCEEDED(IStorageItem_get_Path( other, &path )))
+        {
+            const WCHAR *str = WindowsGetStringRawBuffer( path, NULL );
+            *value = !!is_folder == !!impl->is_folder && !wcsicmp( str, item_display_path( impl ) );
+            WindowsDeleteString( path );
+        }
+        IStorageItem_Release( other );
+    }
+    return S_OK;
+}
