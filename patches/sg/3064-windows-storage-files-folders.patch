+static HRESULT item_ensure_exists( struct item *impl )
+{
+    if (impl->is_virtual) return S_OK;
+    return path_exists( impl->path ) ? S_OK : HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
+}
+
+/* shared by RenameAsync(name) and (name, option) */
+static HRESULT item_rename( struct item *impl, HSTRING desired, int option, IAsyncAction **operation )
+{
+    const WCHAR *name = WindowsGetStringRawBuffer( desired, NULL );
+    WCHAR *dir, *target = NULL;
+    BOOL replace, open;
+    HRESULT hr;
+
+    if (!operation) return E_POINTER;
+    if (impl->is_virtual) return ret_action( HR_NOT_SUPPORTED, operation );
+    if (SUCCEEDED(hr = item_ensure_exists( impl )) && !(dir = path_parent( impl->path ))) hr = E_ACCESSDENIED;
+    if (SUCCEEDED(hr))
+    {
+        /* renaming to the same name in a different case is allowed */
+        if (!wcsicmp( path_name( impl->path ), name ) && wcscmp( path_name( impl->path ), name ))
+        {
+            target = path_join( dir, name );
+            hr = target ? S_OK : E_OUTOFMEMORY;
+        }
+        else if (SUCCEEDED(hr = resolve_target( dir, name, option, impl->is_folder, &target, &replace, &open )))
+        {
+            if (open || !wcsicmp( target, impl->path ))
+            {
+                /* the item already has this name */
+                free( target );
+                target = NULL;
+            }
+            else if (replace && FAILED(hr = delete_tree( target ))) {}
+        }
+        free( dir );
+    }
+    if (SUCCEEDED(hr) && target)
+    {
+        if (!MoveFileExW( impl->path, target, MOVEFILE_COPY_ALLOWED ))
+            hr = hr_last_error();
+        else
+        {
+#ifndef SG_MUTANT_RENAME
+            free( impl->path );
+            impl->path = target;
+            target = NULL;
+#endif
+        }
+    }
+    free( target );
+    return ret_action( hr, operation );
+}
