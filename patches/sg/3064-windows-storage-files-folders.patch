+static BOOL stream_data_reserve( struct stream_data *data, UINT64 size );
+
+/* the helpers below are called with data->cs held */
+static UINT64 data_get_size( struct stream_data *data )
+{
+    LARGE_INTEGER size;
+
+    if (!data->file) return data->size;
+#ifdef SG_MUTANT_SIZE
+    return 0;
+#endif
+    return GetFileSizeEx( data->file, &size ) ? size.QuadPart : 0;
+}
+
+static HRESULT data_set_size( struct stream_data *data, UINT64 value )
+{
+    LARGE_INTEGER pos;
+
+    if (!data->file)
+    {
+        if (!stream_data_reserve( data, value )) return E_OUTOFMEMORY;
+        if (value < data->size) memset( data->bytes + value, 0, data->size - value );
+        data->size = value;
+        return S_OK;
+    }
+    if (!data->can_write) return E_ACCESSDENIED;
+    pos.QuadPart = value;
+    if (!SetFilePointerEx( data->file, pos, NULL, FILE_BEGIN ) || !SetEndOfFile( data->file ))
+        return HRESULT_FROM_WIN32( GetLastError() );
+    return S_OK;
+}
+
+static HRESULT data_read( struct stream_data *data, UINT64 position, BYTE *dst, UINT32 count, UINT32 *done )
+{
+    *done = 0;
+    if (!data->file)
+    {
+        if (position < data->size) *done = min( count, data->size - position );
+        memcpy( dst, data->bytes + position, *done );
+        return S_OK;
+    }
+    else
+    {
+        OVERLAPPED ov = { 0 };
+        DWORD read = 0;
+
+        ov.Offset = position;
+        ov.OffsetHigh = position >> 32;
+        if (!ReadFile( data->file, dst, count, &read, &ov ) && GetLastError() != ERROR_HANDLE_EOF)
+            return HRESULT_FROM_WIN32( GetLastError() );
+        *done = read;
+        return S_OK;
+    }
+}
+
+static HRESULT data_write( struct stream_data *data, UINT64 position, const BYTE *src, UINT32 length )
+{
+    if (!data->file)
+    {
+        if (!stream_data_reserve( data, position + length )) return E_OUTOFMEMORY;
+        memcpy( data->bytes + position, src, length );
+        if (position + length > data->size) data->size = position + length;
+        return S_OK;
+    }
+    else
+    {
+        OVERLAPPED ov = { 0 };
+        DWORD written = 0;
+
+        if (!data->can_write) return E_ACCESSDENIED;
+        ov.Offset = position;
+        ov.OffsetHigh = position >> 32;
+        if (!WriteFile( data->file, src, length, &written, &ov ) || written != length)
+            return HRESULT_FROM_WIN32( GetLastError() );
+        return S_OK;
+    }
+}
