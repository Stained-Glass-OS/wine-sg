+static ULONG WINAPI item_AddRef( IStorageItem *iface )
+{
+    struct item *impl = impl_from_IStorageItem( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI item_Release( IStorageItem *iface )
+{
+    struct item *impl = impl_from_IStorageItem( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        free( impl->path );
+        free( impl->virtual_name );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI item_GetIids( IStorageItem *iface, ULONG *count, IID **iids )
+{
+    struct item *impl = impl_from_IStorageItem( iface );
+    IID *list;
+    ULONG n = 0;
+
+    TRACE( "iface %p, count %p, iids %p.\n", iface, count, iids );
+
+    if (!(list = CoTaskMemAlloc( 10 * sizeof(*list) ))) return E_OUTOFMEMORY;
+    if (impl->is_folder)
+    {
+        list[n++] = IID_IStorageFolder;
+        list[n++] = IID_IStorageItem;
+        list[n++] = IID_IStorageFolderQueryOperations;
+        list[n++] = IID_IStorageItemProperties;
+        list[n++] = IID_IStorageItemProperties2;
+        list[n++] = IID_IStorageItem2;
+        list[n++] = IID_IStorageFolder2;
+    }
+    else
+    {
+        list[n++] = IID_IStorageFile;
+        list[n++] = IID_IInputStreamReference;
+        list[n++] = IID_IRandomAccessStreamReference;
+        list[n++] = IID_IStorageItem;
+        list[n++] = IID_IStorageItemProperties;
+        list[n++] = IID_IStorageItemProperties2;
+        list[n++] = IID_IStorageItem2;
+        list[n++] = IID_IStorageFilePropertiesWithAvailability;
+        list[n++] = IID_IStorageFile2;
+    }
+    *count = n;
+    *iids = list;
+    return S_OK;
+}
