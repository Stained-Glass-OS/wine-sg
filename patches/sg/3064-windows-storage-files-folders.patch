+static HRESULT item_create( BOOL is_folder, const WCHAR *path, struct item **out )
+{
+    struct item *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (!(impl->path = wcsdup( path )))
+    {
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    impl->IStorageItem_iface.lpVtbl = &item_vtbl;
+    impl->IStorageFile_iface.lpVtbl = &file_vtbl;
+    impl->IStorageFolder_iface.lpVtbl = &folder_vtbl;
+    impl->IStorageItem2_iface.lpVtbl = &item2_vtbl;
+    impl->IStorageItemProperties_iface.lpVtbl = &props_item_vtbl;
+    impl->IStorageItemProperties2_iface.lpVtbl = &props2_item_vtbl;
+    impl->IStorageFolder2_iface.lpVtbl = &folder2_vtbl;
+    impl->IStorageFile2_iface.lpVtbl = &file2_vtbl;
+    impl->IStorageFilePropertiesWithAvailability_iface.lpVtbl = &avail_vtbl;
+    impl->IStorageFolderQueryOperations_iface.lpVtbl = &query_vtbl;
+    impl->IInputStreamReference_iface.lpVtbl = &inref_vtbl;
+    impl->IRandomAccessStreamReference_iface.lpVtbl = &ramref_vtbl;
+    impl->ref = 1;
+    impl->is_folder = is_folder;
+    *out = impl;
+    return S_OK;
+}
