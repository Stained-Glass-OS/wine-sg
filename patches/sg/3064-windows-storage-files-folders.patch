new file mode 100644
index 0000000..eff0474
--- /dev/null
+++ b/dlls/windows.storage/collections.c
@@ -0,0 +1,400 @@
+/* Read-only vectors of runtime class objects, as returned by GetFilesAsync and friends
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(storage);
+
+/*
+ * IVectorView<T *>, IIterable<T *> and IIterator<T *> have the same layout for every
+ * interface or runtime class T, so one implementation serves all of them; only the
+ * interface ids differ.
+ */
+
+struct vview_vtbl
+{
+    void *QueryInterface, *AddRef, *Release, *GetIids, *GetRuntimeClassName, *GetTrustLevel;
+    HRESULT (WINAPI *GetAt)( void *iface, UINT32 index, void **value );
+    HRESULT (WINAPI *get_Size)( void *iface, UINT32 *value );
+    HRESULT (WINAPI *IndexOf)( void *iface, void *value, UINT32 *index, boolean *found );
+    HRESULT (WINAPI *GetMany)( void *iface, UINT32 start, UINT32 size, void **items, UINT32 *actual );
+};
+
+struct iterable_vtbl
+{
+    void *QueryInterface, *AddRef, *Release, *GetIids, *GetRuntimeClassName, *GetTrustLevel;
+    HRESULT (WINAPI *First)( void *iface, void **iterator );
+};
+
+struct iterator_vtbl
+{
+    void *QueryInterface, *AddRef, *Release, *GetIids, *GetRuntimeClassName, *GetTrustLevel;
+    HRESULT (WINAPI *get_Current)( void *iface, void **value );
+    HRESULT (WINAPI *get_HasCurrent)( void *iface, boolean *value );
+    HRESULT (WINAPI *MoveNext)( void *iface, boolean *value );
+    HRESULT (WINAPI *GetMany)( void *iface, UINT32 size, void **items, UINT32 *actual );
+};
+
+struct vview
+{
+    const struct vview_vtbl *view_vtbl;
+    const struct iterable_vtbl *iterable_vtbl;
+    LONG ref;
+    const struct vector_ids *ids;
+    IUnknown **items;
+    UINT32 count;
+};
+
+struct viterator
+{
+    const struct iterator_vtbl *vtbl;
+    LONG ref;
+    struct vview *view;
+    UINT32 pos;
+};
+
+static struct vview *view_from_iface( void *iface ) { return CONTAINING_RECORD( iface, struct vview, view_vtbl ); }
+static struct vview *view_from_iterable( void *iface ) { return CONTAINING_RECORD( iface, struct vview, iterable_vtbl ); }
+
+static HRESULT WINAPI view_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    struct vview *impl = view_from_iface( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, impl->ids->view ))
+        *out = &impl->view_vtbl;
+    else if (IsEqualGUID( iid, impl->ids->iterable ))
+        *out = &impl->iterable_vtbl;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI view_AddRef( void *iface )
+{
+    return InterlockedIncrement( &view_from_iface( iface )->ref );
+}
+
+static ULONG WINAPI view_Release( void *iface )
+{
+    struct vview *impl = view_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        UINT32 i;
+        for (i = 0; i < impl->count; i++) IUnknown_Release( impl->items[i] );
+        free( impl->items );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI view_GetIids( void *iface, ULONG *count, IID **iids )
+{
+    struct vview *impl = view_from_iface( iface );
+    IID *list;
+
+    if (!(list = CoTaskMemAlloc( 2 * sizeof(*list) ))) return E_OUTOFMEMORY;
+    list[0] = *impl->ids->view;
+    list[1] = *impl->ids->iterable;
+    *count = 2;
+    *iids = list;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    const WCHAR *str = view_from_iface( iface )->ids->class_name;
+    return WindowsCreateString( str, wcslen( str ), name );
+}
+
+static HRESULT WINAPI view_GetTrustLevel( void *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_GetAt( void *iface, UINT32 index, void **value )
+{
+    struct vview *impl = view_from_iface( iface );
+
+    TRACE( "iface %p, index %u, value %p.\n", iface, index, value );
+
+    *value = NULL;
+    if (index >= impl->count) return E_BOUNDS;
+    *value = impl->items[index];
+    IUnknown_AddRef( impl->items[index] );
+    return S_OK;
+}
+
+static HRESULT WINAPI view_get_Size( void *iface, UINT32 *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = view_from_iface( iface )->count;
+    return S_OK;
+}
+
+static BOOL same_object( IUnknown *a, IUnknown *b )
+{
+    IUnknown *ua = NULL, *ub = NULL;
+    BOOL ret;
+
+    if (a == b) return TRUE;
+    if (!a || !b) return FALSE;
+    IUnknown_QueryInterface( a, &IID_IUnknown, (void **)&ua );
+    IUnknown_QueryInterface( b, &IID_IUnknown, (void **)&ub );
+    ret = ua == ub;
+    if (ua) IUnknown_Release( ua );
+    if (ub) IUnknown_Release( ub );
+    return ret;
+}
+
+static HRESULT WINAPI view_IndexOf( void *iface, void *value, UINT32 *index, boolean *found )
+{
+    struct vview *impl = view_from_iface( iface );
+    UINT32 i;
+
+    TRACE( "iface %p, value %p, index %p, found %p.\n", iface, value, index, found );
+
+    *index = 0;
+    *found = FALSE;
+    for (i = 0; i < impl->count; i++)
+        if (same_object( impl->items[i], value )) { *index = i; *found = TRUE; break; }
+    return S_OK;
+}
+
+static HRESULT WINAPI view_GetMany( void *iface, UINT32 start, UINT32 size, void **items, UINT32 *actual )
+{
+    struct vview *impl = view_from_iface( iface );
+    UINT32 i;
+
+    TRACE( "iface %p, start %u, size %u, items %p, actual %p.\n", iface, start, size, items, actual );
+
+    *actual = 0;
+    if (start > impl->count) return E_BOUNDS;
+    for (i = start; i < impl->count && *actual < size; i++)
+    {
+        IUnknown_AddRef( impl->items[i] );
+        items[(*actual)++] = impl->items[i];
+    }
+    return S_OK;
+}
+
+static const struct vview_vtbl view_vtbl =
+{
+    view_QueryInterface, view_AddRef, view_Release, view_GetIids, view_GetRuntimeClassName, view_GetTrustLevel,
+    view_GetAt, view_get_Size, view_IndexOf, view_GetMany,
+};
+
+/* IIterable */
+static HRESULT WINAPI iterable_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    return view_QueryInterface( &view_from_iterable( iface )->view_vtbl, iid, out );
+}
+static ULONG WINAPI iterable_AddRef( void *iface )
+{
+    return view_AddRef( &view_from_iterable( iface )->view_vtbl );
+}
+static ULONG WINAPI iterable_Release( void *iface )
+{
+    return view_Release( &view_from_iterable( iface )->view_vtbl );
+}
+static HRESULT WINAPI iterable_GetIids( void *iface, ULONG *count, IID **iids )
+{
+    return view_GetIids( &view_from_iterable( iface )->view_vtbl, count, iids );
+}
+static HRESULT WINAPI iterable_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    return view_GetRuntimeClassName( &view_from_iterable( iface )->view_vtbl, name );
+}
+
+/* IIterator */
+static HRESULT WINAPI iterator_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    struct viterator *impl = iface;
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, impl->view->ids->iterator ))
+    {
+        *out = impl;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI iterator_AddRef( void *iface )
+{
+    return InterlockedIncrement( &((struct viterator *)iface)->ref );
+}
+
+static ULONG WINAPI iterator_Release( void *iface )
+{
+    struct viterator *impl = iface;
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        view_Release( &impl->view->view_vtbl );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI iterator_GetIids( void *iface, ULONG *count, IID **iids )
+{
+    struct viterator *impl = iface;
+    IID *list;
+
+    if (!(list = CoTaskMemAlloc( sizeof(*list) ))) return E_OUTOFMEMORY;
+    *list = *impl->view->ids->iterator;
+    *count = 1;
+    *iids = list;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    const WCHAR *str = ((struct viterator *)iface)->view->ids->iterator_class_name;
+    return WindowsCreateString( str, wcslen( str ), name );
+}
+
+static HRESULT WINAPI iterator_get_Current( void *iface, void **value )
+{
+    struct viterator *impl = iface;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    *value = NULL;
+    if (impl->pos >= impl->view->count) return E_BOUNDS;
+    *value = impl->view->items[impl->pos];
+    IUnknown_AddRef( impl->view->items[impl->pos] );
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_get_HasCurrent( void *iface, boolean *value )
+{
+    struct viterator *impl = iface;
+    *value = impl->pos < impl->view->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_MoveNext( void *iface, boolean *value )
+{
+    struct viterator *impl = iface;
+
+    if (impl->pos < impl->view->count) impl->pos++;
+    *value = impl->pos < impl->view->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetMany( void *iface, UINT32 size, void **items, UINT32 *actual )
+{
+    struct viterator *impl = iface;
+
+    *actual = 0;
+    while (impl->pos < impl->view->count && *actual < size)
+    {
+        IUnknown_AddRef( impl->view->items[impl->pos] );
+        items[(*actual)++] = impl->view->items[impl->pos++];
+    }
+    return S_OK;
+}
+
+static const struct iterator_vtbl iterator_vtbl =
+{
+    iterator_QueryInterface, iterator_AddRef, iterator_Release, iterator_GetIids, iterator_GetRuntimeClassName,
+    view_GetTrustLevel, iterator_get_Current, iterator_get_HasCurrent, iterator_MoveNext, iterator_GetMany,
+};
+
+static HRESULT WINAPI iterable_First( void *iface, void **value )
+{
+    struct vview *impl = view_from_iterable( iface );
+    struct viterator *iter;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!(iter = calloc( 1, sizeof(*iter) ))) return E_OUTOFMEMORY;
+    iter->vtbl = &iterator_vtbl;
+    iter->ref = 1;
+    InterlockedIncrement( &impl->ref );
+    iter->view = impl;
+    *value = iter;
+    return S_OK;
+}
+
+static const struct iterable_vtbl iterable_vtbl =
+{
+    iterable_QueryInterface, iterable_AddRef, iterable_Release, iterable_GetIids, iterable_GetRuntimeClassName,
+    view_GetTrustLevel, iterable_First,
+};
+
+const struct vector_ids vector_ids_file =
+{
+    &IID_IVectorView_StorageFile, &IID_IIterable_StorageFile, &IID_IIterator_StorageFile,
+    L"Windows.Foundation.Collections.IVectorView`1<Windows.Storage.StorageFile>",
+    L"Windows.Foundation.Collections.IIterator`1<Windows.Storage.StorageFile>",
+};
+
+const struct vector_ids vector_ids_folder =
+{
+    &IID_IVectorView_StorageFolder, &IID_IIterable_StorageFolder, &IID_IIterator_StorageFolder,
+    L"Windows.Foundation.Collections.IVectorView`1<Windows.Storage.StorageFolder>",
+    L"Windows.Foundation.Collections.IIterator`1<Windows.Storage.StorageFolder>",
+};
+
+const struct vector_ids vector_ids_item =
+{
+    &IID_IVectorView_IStorageItem, &IID_IIterable_IStorageItem, &IID_IIterator_IStorageItem,
+    L"Windows.Foundation.Collections.IVectorView`1<Windows.Storage.IStorageItem>",
+    L"Windows.Foundation.Collections.IIterator`1<Windows.Storage.IStorageItem>",
+};
+
+/* takes the references on the items (and the array) */
+HRESULT vector_view_create( const struct vector_ids *ids, IUnknown **items, UINT32 count, void **out )
+{
+    struct vview *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        UINT32 i;
+        for (i = 0; i < count; i++) IUnknown_Release( items[i] );
+        free( items );
+        return E_OUTOFMEMORY;
+    }
+    impl->view_vtbl = &view_vtbl;
+    impl->iterable_vtbl = &iterable_vtbl;
+    impl->ref = 1;
+    impl->ids = ids;
+    impl->items = items;
+    impl->count = count;
+    *out = &impl->view_vtbl;
+    return S_OK;
+}
