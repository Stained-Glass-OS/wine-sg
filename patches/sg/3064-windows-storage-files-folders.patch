+static HSTRING hs( const WCHAR *str )
+{
+    HSTRING ret;
+    WindowsCreateString( str, wcslen( str ), &ret );
+    return ret;
+}
+
+static void check_hstring( HSTRING str, const WCHAR *expect, int line )
+{
+    ok_( __FILE__, line )( !wcscmp( WindowsGetStringRawBuffer( str, NULL ), expect ), "got %s, expected %s.\n",
+                            debugstr_w( WindowsGetStringRawBuffer( str, NULL ) ), debugstr_w( expect ) );
+    WindowsDeleteString( str );
+}
+#define CHECK_HSTRING( str, expect ) check_hstring( str, expect, __LINE__ )
+
+static IStorageFolderStatics *folder_statics;
