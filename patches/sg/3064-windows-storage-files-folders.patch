+    sub2 = create_folder( root_folder, L"zdir", CreationCollisionOption_FailIfExists, &hr );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS ) && !sub2, "got hr %#lx.\n", hr );
+    sub2 = create_folder( root_folder, L"zdir", CreationCollisionOption_OpenIfExists, &hr );
+    ok( hr == S_OK && sub2, "got hr %#lx.\n", hr );
+    if (sub2) IStorageFolder_Release( sub2 );
+    sub2 = create_folder( sub, L"inner", CreationCollisionOption_FailIfExists, &hr );
+    ok( hr == S_OK && sub2, "got hr %#lx.\n", hr );
+    if (sub2) IStorageFolder_Release( sub2 );
+
+    /* files, sorted by name */
+    hr = IStorageFolder_GetFilesAsyncOverloadDefaultOptionsStartAndCount( root_folder, &files_op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_ptr( files_op, (void **)&files );
+    ok( hr == S_OK && files, "got hr %#lx.\n", hr );
+    hr = IVectorView_StorageFile_get_Size( files, &size );
+    ok( hr == S_OK && size == 3, "got hr %#lx, size %u.\n", hr, size );
+    hr = IVectorView_StorageFile_GetAt( files, 0, &other );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    CHECK_NAME( other, L"a.dat" );
+    hr = IVectorView_StorageFile_GetAt( files, 1, &same );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    CHECK_NAME( same, L"b (1).txt" );
+    IStorageFile_Release( same );
+    hr = IVectorView_StorageFile_GetAt( files, 3, &same );
+    ok( hr == E_BOUNDS && !same, "got hr %#lx.\n", hr );
+    hr = IVectorView_StorageFile_IndexOf( files, other, &index, &found );
+    ok( hr == S_OK && found && !index, "got hr %#lx, found %d, index %u.\n", hr, found, index );
+    /* a different object for the same file is not in the vector */
+    hr = IVectorView_StorageFile_IndexOf( files, a, &index, &found );
+    ok( hr == S_OK && !found && !index, "got hr %#lx, found %d, index %u.\n", hr, found, index );
+    IStorageFile_Release( other );
+    memset( got, 0, sizeof(got) );
+    hr = IVectorView_StorageFile_GetMany( files, 1, ARRAY_SIZE(got), got, &actual );
+    ok( hr == S_OK && actual == 2, "got hr %#lx, actual %u.\n", hr, actual );
+    while (actual--) IStorageFile_Release( got[actual] );
+    hr = IVectorView_StorageFile_QueryInterface( files, &IID_IIterable_StorageFile, (void **)&iterable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IIterable_StorageFile_First( iterable, &iterator );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    size = 0;
+    for (;;)
+    {
+        hr = IIterator_StorageFile_get_HasCurrent( iterator, &has_current );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        if (!has_current) break;
+        size++;
+        hr = IIterator_StorageFile_MoveNext( iterator, &has_current );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+    }
+    ok( size == 3, "got %u items.\n", size );
+    IIterator_StorageFile_Release( iterator );
+    IIterable_StorageFile_Release( iterable );
+    IVectorView_StorageFile_Release( files );
+
+    hr = IStorageFolder_GetFoldersAsyncOverloadDefaultOptionsStartAndCount( root_folder, &folders_op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_ptr( folders_op, (void **)&folders );
+    ok( hr == S_OK && folders, "got hr %#lx.\n", hr );
+    hr = IVectorView_StorageFolder_get_Size( folders, &size );
+    ok( hr == S_OK && size == 1, "got hr %#lx, size %u.\n", hr, size );
+    IVectorView_StorageFolder_Release( folders );
+
+    hr = IStorageFolder_GetItemsAsyncOverloadDefaultStartAndCount( root_folder, &items_op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_ptr( items_op, (void **)&items );
+    ok( hr == S_OK && items, "got hr %#lx.\n", hr );
+    hr = IVectorView_IStorageItem_get_Size( items, &size );
+    ok( hr == S_OK && size == 4, "got hr %#lx, size %u.\n", hr, size );
+    hr = IVectorView_IStorageItem_GetAt( items, 3, &item );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    CHECK_NAME( item, L"zdir" );
+    IStorageItem_Release( item );
+    IVectorView_IStorageItem_Release( items );
+
+    /* single items */
+    str = hs( L"a.dat" );
+    hr = IStorageFolder_GetFileAsync( root_folder, str, &file_op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_ptr( file_op, (void **)&other );
+    ok( hr == S_OK && other, "got hr %#lx.\n", hr );
+    if (other) IStorageFile_Release( other );
+    hr = IStorageFolder_GetItemAsync( root_folder, str, &item_op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_ptr( item_op, (void **)&item );
+    ok( hr == S_OK && item, "got hr %#lx.\n", hr );
+    if (item) IStorageItem_Release( item );
+    WindowsDeleteString( str );
+    str = hs( L"missing" );
+    hr = IStorageFolder_GetFileAsync( root_folder, str, &file_op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = await_ptr( file_op, (void **)&other );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND ) && !other, "got hr %#lx.\n", hr );
+    {
+        IStorageFolder2 *folder2;
+        IAsyncOperation_IStorageItem *try_op;
+
+        hr = IStorageFolder_QueryInterface( root_folder, &IID_IStorageFolder2, (void **)&folder2 );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = IStorageFolder2_TryGetItemAsync( folder2, str, &try_op );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        item = (void *)1;
+        hr = await_ptr( try_op, (void **)&item );
+        ok( hr == S_OK && !item, "got hr %#lx, item %p.\n", hr, item );
+        IStorageFolder2_Release( folder2 );
+    }
+    WindowsDeleteString( str );
+
+    IStorageFile_Release( a );
+    IStorageFile_Release( b );
+    IStorageFile_Release( c );
+    IStorageFolder_Release( sub );
+    IStorageFolder_Release( root_folder );
+}
