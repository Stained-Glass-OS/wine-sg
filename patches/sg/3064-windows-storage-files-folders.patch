+static void remove_tree( const WCHAR *dir )
+{
+    WIN32_FIND_DATAW fd;
+    WCHAR pattern[MAX_PATH], child[MAX_PATH];
+    HANDLE find;
+
+    swprintf( pattern, ARRAY_SIZE(pattern), L"%ls\\*", dir );
+    if ((find = FindFirstFileW( pattern, &fd )) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (!wcscmp( fd.cFileName, L"." ) || !wcscmp( fd.cFileName, L".." )) continue;
+            swprintf( child, ARRAY_SIZE(child), L"%ls\\%ls", dir, fd.cFileName );
+            if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) remove_tree( child );
+            else DeleteFileW( child );
+        } while (FindNextFileW( find, &fd ));
+        FindClose( find );
+    }
+    RemoveDirectoryW( dir );
+}
