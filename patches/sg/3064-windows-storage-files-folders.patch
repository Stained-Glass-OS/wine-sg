+static HRESULT WINAPI item_GetBasicPropertiesAsync( IStorageItem *iface, IAsyncOperation_BasicProperties **operation )
+{
+    struct item *impl = impl_from_IStorageItem( iface );
+    struct basic_properties *props = NULL;
+    WIN32_FILE_ATTRIBUTE_DATA data;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    if (!operation) return E_POINTER;
+    if (!impl->is_virtual && !GetFileAttributesExW( impl->path, GetFileExInfoStandard, &data )) hr = hr_last_error();
+    else if (!(props = calloc( 1, sizeof(*props) ))) hr = E_OUTOFMEMORY;
+    else
+    {
+        props->IBasicProperties_iface.lpVtbl = &props_vtbl;
+        props->ref = 1;
+        if (!impl->is_virtual)
+        {
+            props->size = ((UINT64)data.nFileSizeHigh << 32) | data.nFileSizeLow;
+            props->modified.UniversalTime = ((UINT64)data.ftLastWriteTime.dwHighDateTime << 32) |
+                                            data.ftLastWriteTime.dwLowDateTime;
+            if (impl->is_folder) props->size = 0;
+        }
+    }
+    return ret_ptr( &IID_IAsyncOperation_BasicProperties,
+                    L"Windows.Foundation.IAsyncOperation`1<Windows.Storage.FileProperties.BasicProperties>",
+                    props ? (IUnknown *)&props->IBasicProperties_iface : NULL, hr, (void **)operation );
+}
