+static void *statics_find( struct statics *impl, REFIID iid )
+{
+    if (IsEqualGUID( iid, &IID_IStorageFolderStatics )) return &impl->IStorageFolderStatics_iface;
+    if (IsEqualGUID( iid, &IID_IStorageFileStatics )) return &impl->IStorageFileStatics_iface;
+    if (IsEqualGUID( iid, &IID_IKnownFoldersStatics )) return &impl->IKnownFoldersStatics_iface;
+    if (IsEqualGUID( iid, &IID_IKnownFoldersStatics2 )) return &impl->IKnownFoldersStatics2_iface;
+    if (IsEqualGUID( iid, &IID_IKnownFoldersStatics3 )) return &impl->IKnownFoldersStatics3_iface;
+    if (IsEqualGUID( iid, &IID_IKnownFoldersStatics4 )) return &impl->IKnownFoldersStatics4_iface;
+    if (IsEqualGUID( iid, &IID_IKnownFoldersPlaylistsStatics )) return &impl->IKnownFoldersPlaylistsStatics_iface;
+    if (IsEqualGUID( iid, &IID_IKnownFoldersCameraRollStatics )) return &impl->IKnownFoldersCameraRollStatics_iface;
+    if (IsEqualGUID( iid, &IID_IKnownFoldersSavedPicturesStatics )) return &impl->IKnownFoldersSavedPicturesStatics_iface;
+    return NULL;
+}
