+
+static HRESULT WINAPI item_get_Attributes( IStorageItem *iface, FileAttributes *value )
+{
+    struct item *impl = impl_from_IStorageItem( iface );
+    DWORD attr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (impl->is_virtual)
+    {
+        *value = FileAttributes_Directory | FileAttributes_ReadOnly;
+        return S_OK;
+    }
+    if ((attr = GetFileAttributesW( impl->path )) == INVALID_FILE_ATTRIBUTES) return hr_last_error();
+    *value = attr & (FILE_ATTRIBUTE_READONLY | FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_ARCHIVE | FILE_ATTRIBUTE_TEMPORARY);
+    return S_OK;
+}
+
+static HRESULT WINAPI item_get_DateCreated( IStorageItem *iface, DateTime *value )
+{
+    struct item *impl = impl_from_IStorageItem( iface );
+    WIN32_FILE_ATTRIBUTE_DATA data;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    value->UniversalTime = 0;
+    if (impl->is_virtual) return S_OK;
+    if (!GetFileAttributesExW( impl->path, GetFileExInfoStandard, &data )) return hr_last_error();
+    value->UniversalTime = ((UINT64)data.ftCreationTime.dwHighDateTime << 32) | data.ftCreationTime.dwLowDateTime;
+    return S_OK;
