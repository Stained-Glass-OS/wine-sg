+static HRESULT WINAPI props_item_get_DisplayName( IStorageItemProperties *iface, HSTRING *value )
+{
+    struct item *impl = impl_from_IStorageItemProperties( iface );
+    const WCHAR *name = impl->is_virtual ? impl->virtual_name : path_name( impl->path );
+    const WCHAR *ext = impl->is_folder ? NULL : wcsrchr( name, '.' );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!ext || ext == name) return WindowsCreateString( name, wcslen( name ), value );
+    return WindowsCreateString( name, ext - name, value );
+}
+
+static HRESULT WINAPI props_item_get_DisplayType( IStorageItemProperties *iface, HSTRING *value )
+{
+    struct item *impl = impl_from_IStorageItemProperties( iface );
+    WCHAR type[128];
+    const WCHAR *ext;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (impl->is_folder) wcscpy( type, L"File folder" );
+    else
+    {
+        WCHAR progid[128], key[128];
+        DWORD len = sizeof(progid);
+
+        type[0] = 0;
+        ext = wcsrchr( path_name( impl->path ), '.' );
+        if (ext && !RegGetValueW( HKEY_CLASSES_ROOT, ext, NULL, RRF_RT_REG_SZ, NULL, progid, &len ) && progid[0])
+        {
+            len = sizeof(type);
+            swprintf( key, ARRAY_SIZE(key), L"%ls", progid );
+            if (RegGetValueW( HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ, NULL, type, &len )) type[0] = 0;
+        }
+        if (!type[0])
+        {
+            if (ext && ext[1]) swprintf( type, ARRAY_SIZE(type), L"%ls File", ext + 1 );
+            else wcscpy( type, L"File" );
+            if (ext && ext[1])
+            {
+                WCHAR *c;
+                for (c = type; c < type + wcslen( ext + 1 ); c++) *c = towupper( *c );
+            }
+        }
+    }
+    return WindowsCreateString( type, wcslen( type ), value );
+}
+
+static HRESULT WINAPI props_item_get_FolderRelativeId( IStorageItemProperties *iface, HSTRING *value )
+{
+    struct item *impl = impl_from_IStorageItemProperties( iface );
+    WCHAR id[64 + MAX_PATH];
+    const WCHAR *name = impl->is_virtual ? impl->virtual_name : path_name( impl->path );
+    WCHAR *dir;
+    UINT32 hash = 0;
+    const WCHAR *p;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    /* "{id of the containing folder}\name" */
+    dir = impl->is_virtual ? NULL : path_parent( impl->path );
+    for (p = dir ? dir : L""; *p; p++) hash = hash * 31 + towlower( *p );
+    swprintf( id, ARRAY_SIZE(id), L"{%08X-0000-0000-0000-000000000000}\\%ls", hash, name );
+    free( dir );
+    return WindowsCreateString( id, wcslen( id ), value );
+}
