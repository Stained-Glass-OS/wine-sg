+/* ---- known folders ---- */
+
+typedef __x_ABI_CWindows_CSystem_CIUser IUser;
+
+static HRESULT known_folder_path( const KNOWNFOLDERID *id, const WCHAR *subdir, WCHAR **path )
+{
+    WCHAR *base = NULL, *full;
+    HRESULT hr;
+
+    if (FAILED(hr = SHGetKnownFolderPath( id, KF_FLAG_CREATE, NULL, &base ))) return hr;
+    if (subdir) full = path_join( base, subdir );
+    else full = wcsdup( base );
+    CoTaskMemFree( base );
+    if (!full) return E_OUTOFMEMORY;
+    if (subdir) CreateDirectoryW( full, NULL );
+    *path = full;
+    return S_OK;
+}
+
+static HRESULT known_folder( KnownFolderId id, IUnknown **folder )
+{
+    WCHAR *path = NULL;
+    HRESULT hr;
+
+    *folder = NULL;
+    switch (id)
+    {
+    case KnownFolderId_DocumentsLibrary: hr = known_folder_path( &FOLDERID_Documents, NULL, &path ); break;
+    case KnownFolderId_MusicLibrary: hr = known_folder_path( &FOLDERID_Music, NULL, &path ); break;
+    case KnownFolderId_PicturesLibrary: hr = known_folder_path( &FOLDERID_Pictures, NULL, &path ); break;
+    case KnownFolderId_VideosLibrary: hr = known_folder_path( &FOLDERID_Videos, NULL, &path ); break;
+    case KnownFolderId_Objects3D:
+        if (FAILED(hr = known_folder_path( &FOLDERID_Objects3D, NULL, &path )))
+        {
+            WCHAR profile[MAX_PATH];
+            DWORD size = ARRAY_SIZE(profile);
+            HANDLE token;
+
+            hr = E_FAIL;
+            if (OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+            {
+                if (GetUserProfileDirectoryW( token, profile, &size ) && (path = path_join( profile, L"3D Objects" )))
+                {
+                    CreateDirectoryW( path, NULL );
+                    hr = S_OK;
+                }
+                CloseHandle( token );
+            }
+        }
+        break;
+    case KnownFolderId_AppCaptures:
+        if (FAILED(hr = known_folder_path( &FOLDERID_AppCaptures, NULL, &path )))
+            hr = known_folder_path( &FOLDERID_Videos, L"Captures", &path );
+        break;
+    case KnownFolderId_CameraRoll:
+        if (FAILED(hr = known_folder_path( &FOLDERID_CameraRoll, NULL, &path )))
+            hr = known_folder_path( &FOLDERID_Pictures, L"Camera Roll", &path );
+        break;
+    case KnownFolderId_Playlists:
+        if (FAILED(hr = known_folder_path( &FOLDERID_Playlists, NULL, &path )))
+            hr = known_folder_path( &FOLDERID_Music, L"Playlists", &path );
+        break;
+    case KnownFolderId_RecordedCalls:
+        if (FAILED(hr = known_folder_path( &FOLDERID_RecordedCalls, NULL, &path )))
+            hr = known_folder_path( &FOLDERID_Music, L"Recorded Calls", &path );
+        break;
+    case KnownFolderId_SavedPictures:
+        if (FAILED(hr = known_folder_path( &FOLDERID_SavedPictures, NULL, &path )))
+            hr = known_folder_path( &FOLDERID_Pictures, L"Saved Pictures", &path );
+        break;
+    case KnownFolderId_Screenshots:
+        if (FAILED(hr = known_folder_path( &FOLDERID_Screenshots, NULL, &path )))
+            hr = known_folder_path( &FOLDERID_Pictures, L"Screenshots", &path );
+        break;
+    case KnownFolderId_RemovableDevices: return virtual_folder_create( L"Removable Storage", folder );
+    case KnownFolderId_HomeGroup: return virtual_folder_create( L"HomeGroup", folder );
+    case KnownFolderId_MediaServerDevices: return virtual_folder_create( L"Media Servers", folder );
+    default:
+        WARN( "known folder %d is not supported\n", id );
+        return HR_NOT_SUPPORTED;
+    }
+    if (FAILED(hr)) return hr;
+    hr = item_from_path( path, TRUE, folder );
+    free( path );
+    return hr;
+}
