+static HRESULT folder_create_item( struct item *impl, HSTRING desired, int option, BOOL want_folder, IUnknown **result )
+{
+    const WCHAR *name = WindowsGetStringRawBuffer( desired, NULL );
+    WCHAR *target = NULL;
+    BOOL replace, open;
+    HRESULT hr;
+
+    *result = NULL;
+    if (impl->is_virtual) return E_ACCESSDENIED;
+    if (FAILED(hr = item_ensure_exists( impl ))) return hr;
+    if (FAILED(hr = resolve_target( impl->path, name, option, want_folder, &target, &replace, &open ))) return hr;
+    if (open) hr = S_OK;
+    else
+    {
+        if (replace && FAILED(hr = delete_tree( target ))) {}
+        else if (want_folder)
+        {
+            if (!CreateDirectoryW( target, NULL )) hr = hr_last_error();
+        }
+        else
+        {
+            HANDLE file = CreateFileW( target, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                                       CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL );
+            if (file == INVALID_HANDLE_VALUE) hr = hr_last_error();
+            else CloseHandle( file );
+        }
+    }
+    if (SUCCEEDED(hr)) hr = item_from_path( target, want_folder, result );
+    free( target );
+    return hr;
+}
