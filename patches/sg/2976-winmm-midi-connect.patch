From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winmm: midiConnect/midiDisconnect MIDI thru connections

midiConnect/midiDisconnect kept a connection table (input or output handle to
output handle). Invalid handles give MMSYSERR_INVALHANDLE, a non-NULL reserved
argument or a self connection MMSYSERR_INVALPARAM, disconnecting something not
connected MMSYSERR_INVALPARAM. Closing a device drops its connections. Data
from a thru output (short and long messages) and from a MIDI input (via a
callback interposed in midiInOpen that forwards to the connected outputs and
then to the caller) is also sent to the connected outputs.
---
diff --git a/dlls/winmm/winemm.h b/dlls/winmm/winemm.h
index b928c43..02d0350 100644
--- a/dlls/winmm/winemm.h
+++ b/dlls/winmm/winemm.h
@@ -86,6 +86,9 @@ typedef struct  {
 typedef struct {
        WINE_MLD			mld;
        MIDIOPENDESC		mod;			/* FIXME: should be removed */
+       DWORD_PTR		client_cb;		/* MIDI input: the caller's callback (see midiConnect) */
+       DWORD_PTR		client_inst;
+       DWORD			client_flags;
 } WINE_MIDI, *LPWINE_MIDI;
 
 typedef struct {
diff --git a/dlls/winmm/winmm.c b/dlls/winmm/winmm.c
index 1d6b072..5670f3f 100644
--- a/dlls/winmm/winmm.c
+++ b/dlls/winmm/winmm.c
@@ -388,6 +388,74 @@ UINT WINAPI midiOutGetErrorTextW(UINT uError, LPWSTR lpText, UINT uSize)
     return ret;
 }
 
+/* MIDI thru connections made with midiConnect: data arriving on "in" (a MIDI
+ * input handle, or a MIDI output handle acting as thru device) is also sent to
+ * "out". */
+#define MIDI_MAX_CONNECTIONS 64
+static struct { HANDLE in; HMIDIOUT out; } midi_conns[MIDI_MAX_CONNECTIONS];
+static CRITICAL_SECTION midi_conn_cs;
+static CRITICAL_SECTION_DEBUG midi_conn_cs_debug =
+{
+    0, 0, &midi_conn_cs,
+    { &midi_conn_cs_debug.ProcessLocksList, &midi_conn_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": midi_conn_cs") }
+};
+static CRITICAL_SECTION midi_conn_cs = { &midi_conn_cs_debug, -1, 0, 0, 0, 0 };
+
+static void MIDI_ThruDrop(HANDLE h)
+{
+    unsigned int i;
+    EnterCriticalSection(&midi_conn_cs);
+    for (i = 0; i < MIDI_MAX_CONNECTIONS; i++)
+        if (midi_conns[i].in == h || midi_conns[i].out == (HMIDIOUT)h)
+            midi_conns[i].in = NULL, midi_conns[i].out = NULL;
+    LeaveCriticalSection(&midi_conn_cs);
+}
+
+/* Send a short message (hdr == NULL) or a long message to everything connected to "in". */
+static void MIDI_ThruSend(HANDLE in, DWORD msg, const BYTE *data, DWORD len)
+{
+    HMIDIOUT outs[MIDI_MAX_CONNECTIONS];
+    unsigned int i, n = 0;
+
+    EnterCriticalSection(&midi_conn_cs);
+    for (i = 0; i < MIDI_MAX_CONNECTIONS; i++)
+        if (midi_conns[i].in == in && midi_conns[i].out) outs[n++] = midi_conns[i].out;
+    LeaveCriticalSection(&midi_conn_cs);
+
+    for (i = 0; i < n; i++)
+    {
+        LPWINE_MLD out = MMDRV_Get(outs[i], MMDRV_MIDIOUT, FALSE);
+        if (!out) continue;
+        if (!data) MMDRV_Message(out, MODM_DATA, msg, 0);
+        else
+        {
+            MIDIHDR hdr = {0};
+            hdr.lpData = (char *)data;
+            hdr.dwBufferLength = hdr.dwBytesRecorded = len;
+            if (MMDRV_Message(out, MODM_PREPARE, (DWORD_PTR)&hdr, sizeof(hdr)) != MMSYSERR_NOERROR) continue;
+            MMDRV_Message(out, MODM_LONGDATA, (DWORD_PTR)&hdr, sizeof(hdr));
+            MMDRV_Message(out, MODM_UNPREPARE, (DWORD_PTR)&hdr, sizeof(hdr));
+        }
+    }
+}
+
+/* Callback given to the input driver: forwards to the connected outputs and
+ * then to the caller's own callback. */
+static void CALLBACK MIDI_InThruProc(HDRVR hMidi, UINT msg, DWORD_PTR inst, DWORD_PTR p1, DWORD_PTR p2)
+{
+    LPWINE_MIDI wm = (LPWINE_MIDI)inst;
+
+    if (msg == MIM_DATA || msg == MIM_MOREDATA)
+        MIDI_ThruSend((HANDLE)hMidi, p1, NULL, 0);
+    else if (msg == MIM_LONGDATA && p1)
+    {
+        MIDIHDR *h = (MIDIHDR *)p1;
+        if (h->dwBytesRecorded) MIDI_ThruSend((HANDLE)hMidi, 0, (BYTE *)h->lpData, h->dwBytesRecorded);
+    }
+    DriverCallback(wm->client_cb, wm->client_flags, hMidi, msg, wm->client_inst, p1, p2);
+}
+
 /**************************************************************************
  * 				MIDI_OutAlloc    		[internal]
  */
@@ -472,6 +540,9 @@ UINT WINAPI midiOutClose(HMIDIOUT hMidiOut)
 	return MMSYSERR_INVALHANDLE;
 
     dwRet = MMDRV_Close(wmld, MODM_CLOSE);
+#ifndef SG_MUTANT_MIDI_DROP_ON_CLOSE
+    MIDI_ThruDrop(hMidiOut);
+#endif
     MMDRV_Free(hMidiOut, wmld);
 
     return dwRet;
@@ -524,13 +595,16 @@ UINT WINAPI midiOutUnprepareHeader(HMIDIOUT hMidiOut,
 UINT WINAPI midiOutShortMsg(HMIDIOUT hMidiOut, DWORD dwMsg)
 {
     LPWINE_MLD		wmld;
+    UINT		ret;
 
     TRACE("(%p, %08lX)\n", hMidiOut, dwMsg);
 
     if ((wmld = MMDRV_Get(hMidiOut, MMDRV_MIDIOUT, FALSE)) == NULL)
 	return MMSYSERR_INVALHANDLE;
 
-    return MMDRV_Message(wmld, MODM_DATA, dwMsg, 0L);
+    ret = MMDRV_Message(wmld, MODM_DATA, dwMsg, 0L);
+    if (ret == MMSYSERR_NOERROR) MIDI_ThruSend(hMidiOut, dwMsg, NULL, 0);
+    return ret;
 }
 
 /**************************************************************************
@@ -540,13 +614,17 @@ UINT WINAPI midiOutLongMsg(HMIDIOUT hMidiOut,
 			   MIDIHDR* lpMidiOutHdr, UINT uSize)
 {
     LPWINE_MLD		wmld;
+    UINT		ret;
 
     TRACE("(%p, %p, %d)\n", hMidiOut, lpMidiOutHdr, uSize);
 
     if ((wmld = MMDRV_Get(hMidiOut, MMDRV_MIDIOUT, FALSE)) == NULL)
 	return MMSYSERR_INVALHANDLE;
 
-    return MMDRV_Message(wmld, MODM_LONGDATA, (DWORD_PTR)lpMidiOutHdr, uSize);
+    ret = MMDRV_Message(wmld, MODM_LONGDATA, (DWORD_PTR)lpMidiOutHdr, uSize);
+    if (ret == MMSYSERR_NOERROR && lpMidiOutHdr && lpMidiOutHdr->dwBufferLength)
+        MIDI_ThruSend(hMidiOut, 0, (BYTE *)lpMidiOutHdr->lpData, lpMidiOutHdr->dwBufferLength);
+    return ret;
 }
 
 /**************************************************************************
@@ -764,6 +842,18 @@ MMRESULT WINAPI midiInOpen(HMIDIIN* lphMidiIn, UINT uDeviceID,
     lpwm->mod.dwCallback = dwCallback;
     lpwm->mod.dwInstance = dwInstance;
 
+    /* let midiConnect interpose on the data: the driver calls us, we call the caller */
+    lpwm->client_cb = dwCallback;
+    lpwm->client_inst = dwInstance;
+#ifdef SG_MUTANT_MIDI_THRU_FLAGS
+    lpwm->client_flags = dwFlags & CALLBACK_TYPEMASK;
+#else
+    lpwm->client_flags = HIWORD(dwFlags & CALLBACK_TYPEMASK);
+#endif
+    lpwm->mod.dwCallback = (DWORD_PTR)MIDI_InThruProc;
+    lpwm->mod.dwInstance = (DWORD_PTR)lpwm;
+    dwFlags = (dwFlags & ~CALLBACK_TYPEMASK) | CALLBACK_FUNCTION;
+
     lpwm->mld.uDeviceID = uDeviceID;
     dwRet = MMDRV_Open(&lpwm->mld, MIDM_OPEN, (DWORD_PTR)&lpwm->mod, dwFlags);
 
@@ -791,6 +881,7 @@ UINT WINAPI midiInClose(HMIDIIN hMidiIn)
 	return MMSYSERR_INVALHANDLE;
 
     dwRet = MMDRV_Close(wmld, MIDM_CLOSE);
+    MIDI_ThruDrop(hMidiIn);
     MMDRV_Free(hMidiIn, wmld);
     return dwRet;
 }
@@ -934,8 +1025,33 @@ UINT WINAPI midiInMessage(HMIDIIN hMidiIn, UINT uMessage,
  */
 MMRESULT WINAPI midiConnect(HMIDI hMidi, HMIDIOUT hmo, LPVOID pReserved)
 {
-    FIXME("(%p, %p, %p): Stub\n", hMidi, hmo, pReserved);
-    return MMSYSERR_ERROR;
+    unsigned int i, free_slot = MIDI_MAX_CONNECTIONS;
+    MMRESULT ret = MMSYSERR_NOERROR;
+
+    TRACE("(%p, %p, %p)\n", hMidi, hmo, pReserved);
+
+#ifndef SG_MUTANT_MIDI_RESERVED
+    if (pReserved) return MMSYSERR_INVALPARAM;
+#endif
+    if (!MMDRV_Get(hmo, MMDRV_MIDIOUT, FALSE)) return MMSYSERR_INVALHANDLE;
+    if (!MMDRV_Get(hMidi, MMDRV_MIDIIN, FALSE) && !MMDRV_Get(hMidi, MMDRV_MIDIOUT, FALSE))
+        return MMSYSERR_INVALHANDLE;
+    /* connecting a device to itself would loop */
+    if ((HANDLE)hMidi == (HANDLE)hmo) return MMSYSERR_INVALPARAM;
+
+    EnterCriticalSection(&midi_conn_cs);
+    for (i = 0; i < MIDI_MAX_CONNECTIONS; i++)
+    {
+        if (midi_conns[i].in == (HANDLE)hMidi && midi_conns[i].out == hmo) break; /* already connected */
+        if (!midi_conns[i].in && free_slot == MIDI_MAX_CONNECTIONS) free_slot = i;
+    }
+    if (i == MIDI_MAX_CONNECTIONS)
+    {
+        if (free_slot == MIDI_MAX_CONNECTIONS) ret = MMSYSERR_NOMEM;
+        else { midi_conns[free_slot].in = (HANDLE)hMidi; midi_conns[free_slot].out = hmo; }
+    }
+    LeaveCriticalSection(&midi_conn_cs);
+    return ret;
 }
 
 /**************************************************************************
@@ -943,8 +1059,27 @@ MMRESULT WINAPI midiConnect(HMIDI hMidi, HMIDIOUT hmo, LPVOID pReserved)
  */
 MMRESULT WINAPI midiDisconnect(HMIDI hMidi, HMIDIOUT hmo, LPVOID pReserved)
 {
-    FIXME("(%p, %p, %p): Stub\n", hMidi, hmo, pReserved);
-    return MMSYSERR_ERROR;
+    unsigned int i;
+    MMRESULT ret = MMSYSERR_INVALPARAM;
+
+    TRACE("(%p, %p, %p)\n", hMidi, hmo, pReserved);
+
+    if (pReserved) return MMSYSERR_INVALPARAM;
+    if (!MMDRV_Get(hmo, MMDRV_MIDIOUT, FALSE)) return MMSYSERR_INVALHANDLE;
+    if (!MMDRV_Get(hMidi, MMDRV_MIDIIN, FALSE) && !MMDRV_Get(hMidi, MMDRV_MIDIOUT, FALSE))
+        return MMSYSERR_INVALHANDLE;
+
+    EnterCriticalSection(&midi_conn_cs);
+    for (i = 0; i < MIDI_MAX_CONNECTIONS; i++)
+        if (midi_conns[i].in == (HANDLE)hMidi && midi_conns[i].out == hmo)
+        {
+#ifndef SG_MUTANT_MIDI_DISCONNECT
+            midi_conns[i].in = NULL; midi_conns[i].out = NULL;
+#endif
+            ret = MMSYSERR_NOERROR;
+        }
+    LeaveCriticalSection(&midi_conn_cs);
+    return ret;
 }
 
 typedef struct WINE_MIDIStream {
