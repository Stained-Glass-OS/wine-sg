 static HRESULT WINAPI raw_controller_2_get_NonRoamableId( IRawGameController2 *iface, HSTRING* value )
 {
-    FIXME( "iface %p, value %p stub!\n", iface, value );
-    return E_NOTIMPL;
+    struct controller *impl = impl_from_IRawGameController2( iface );
+    UINT64 hash[2] = {0xcbf29ce484222325ull, 0x84222325cbf29ce4ull};
+    const WCHAR *path, *p;
+    WCHAR id[64];
+    HSTRING path_str;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = IWineGameControllerProvider_get_DevicePath( impl->wine_provider, &path_str ))) return hr;
+
+    /* an id that stays the same for the device and means nothing elsewhere: a hash of its path */
+    path = WindowsGetStringRawBuffer( path_str, NULL );
+    for (p = path; *p; p++)
+    {
+        hash[0] = (hash[0] ^ *p) * 0x100000001b3ull;
+        hash[1] = (hash[1] ^ *p) * 0x100000001b3ull;
+    }
+    WindowsDeleteString( path_str );
+
+    swprintf( id, ARRAY_SIZE(id), L"{wgi/nrid/%016I64x%016I64x}", hash[0], hash[1] );
+    return WindowsCreateString( id, wcslen( id ), value );
 }
 
