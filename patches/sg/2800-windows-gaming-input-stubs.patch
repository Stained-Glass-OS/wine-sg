+    if (!value) return E_POINTER;
+
+    /* the description of a HID game controller's device node */
+#ifdef SG_MUTANT_WGI_DISPLAYNAME
+    return WindowsCreateString( L"Controller", 10, value );
+#endif
+    return WindowsCreateString( L"HID-compliant game controller", 29, value );
