From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, user32, shell32: an elevated program's tray icon is
 shown, and answers

An elevated program (ADR 0012) runs on a Wine desktop of its own,
WinSta0\sg-elevated-<display>. That desktop's explorer made a tray no one
sees, and Shell_NotifyIcon found it first: the program's icons went there.
AmbirScan run as administrator -- a tray program -- had no icon, and no way
back to its window (David 2026-10-02).

- shell32: from an sg-elevated-* desktop, the icons go to the shell's tray,
  the one shown on another desktop of the window station (found by its
  style: on another desktop IsWindowVisible calls every window hidden).
- The shell, below the elevated program, sends the icon's callbacks to it;
  UIPI (0291) refused them. ChangeWindowMessageFilterEx now works: the
  allowance is a window property the server's UIPI check reads, which only
  the window's own process may set (by its name -- a property set by an atom
  made beforehand does not count), so a program below cannot let a message
  through for itself. Shell_NotifyIcon allows the icon's callback message,
  and nothing else.

Process-wide ChangeWindowMessageFilter is still a stub.

Test: test/elevtray-gate.sh (mutants SG_MUTANT_ELEVATED_OWN_TRAY,
SG_MUTANT_UIPI_NO_FILTER, SG_MUTANT_UIPI_ALLOW_ANYONE each fail it).
VM-verified: an icon from a program run as administrator shows in the
taskbar, and its clicks reach it.
---
--- a/server/queue.c
+++ b/server/queue.c
@@ -3182,7 +3182,11 @@
 
     if (!(thread = get_thread_from_id( req->id ))) return;
 
-    if (!uipi_allows( current->process, thread->process, req->msg ))
+    if (!uipi_allows( current->process, thread->process, req->msg )
+#ifndef SG_MUTANT_UIPI_NO_FILTER
+        && !window_allows_message( req->win, req->msg )
+#endif
+       )
     {
         set_error( STATUS_ACCESS_DENIED );
         release_object( thread );
--- a/server/user.h
+++ b/server/user.h
@@ -123,6 +123,7 @@
 
 /* Stained Glass OS: user interface privilege isolation (queue.c) */
 extern int uipi_allows( struct process *sender, struct process *receiver, unsigned int msg );
+extern int window_allows_message( user_handle_t handle, unsigned int msg );
 
 extern void free_msg_queue( struct thread *thread );
 extern struct hook_table *get_queue_hooks( struct thread *thread );
--- a/server/window.c
+++ b/server/window.c
@@ -553,6 +553,48 @@
     return 0;
 }
 
+/* Stained Glass OS: ChangeWindowMessageFilterEx's allowances. user32 keeps
+ * them as window properties "__sg_uipi_allow_XXXX" (the message, in hex),
+ * which only the window's own process may set: a program below may not
+ * open a message to an elevated window by itself. */
+static const WCHAR uipi_allow_prefixW[] = {'_','_','s','g','_','u','i','p','i','_','a','l','l','o','w','_'};
+
+static int is_uipi_allow_name( const struct unicode_str *name )
+{
+    unsigned int i, n = ARRAY_SIZE( uipi_allow_prefixW );
+
+    if (name->len < n * sizeof(WCHAR)) return 0;
+    for (i = 0; i < n; i++)   /* atoms ignore case: so does this */
+    {
+        WCHAR c = name->str[i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (c != uipi_allow_prefixW[i]) return 0;
+    }
+    return 1;
+}
+
+/* has the window's own process let this message through UIPI to it? */
+int window_allows_message( user_handle_t handle, unsigned int msg )
+{
+    static const char hex[] = "0123456789abcdef";
+    WCHAR nameW[ARRAY_SIZE( uipi_allow_prefixW ) + 4];
+    struct unicode_str name = { nameW, sizeof(nameW) };
+    struct window *win;
+    atom_t atom;
+    int i;
+
+    if (!handle || !(win = get_user_object( handle, USER_WINDOW ))) return 0;
+    memcpy( nameW, uipi_allow_prefixW, sizeof(uipi_allow_prefixW) );
+    for (i = 0; i < 4; i++) nameW[ARRAY_SIZE( uipi_allow_prefixW ) + i] = hex[(msg >> (12 - 4 * i)) & 0xf];
+    if (msg > 0xffff || !(atom = find_global_atom( NULL, &name ))) return 0;
+    /* set by its name, where the owner is checked -- not by an atom made
+     * beforehand, which would go round that */
+    for (i = 0; i < win->prop_inuse; i++)
+        if (win->properties[i].type == PROP_TYPE_STRING && win->properties[i].atom == atom)
+            return win->properties[i].data != 0;
+    return 0;
+}
+
 /* destroy all properties of a window */
 static inline void destroy_properties( struct window *win )
 {
@@ -3082,7 +3124,15 @@
 
     if (name.len)
     {
-        atom_t atom = add_global_atom( NULL, &name );
+        atom_t atom;
+#ifndef SG_MUTANT_UIPI_ALLOW_ANYONE
+        if (is_uipi_allow_name( &name ) && (!win->thread || win->thread->process != current->process))
+        {
+            set_error( STATUS_ACCESS_DENIED );
+            return;
+        }
+#endif
+        atom = add_global_atom( NULL, &name );
         if (atom)
         {
             set_property( win, atom, req->data, PROP_TYPE_STRING );
--- a/dlls/user32/message.c
+++ b/dlls/user32/message.c
@@ -1304,6 +1304,32 @@
  */
 BOOL WINAPI ChangeWindowMessageFilterEx( HWND hwnd, UINT message, DWORD action, CHANGEFILTERSTRUCT *changefilter )
 {
-    FIXME( "%p %x %ld %p\n", hwnd, message, action, changefilter );
-    return TRUE;
+    /* Stained Glass OS: kept as a window property the server's UIPI reads
+     * (wine-sg 0291): an elevated program lets a message from below through
+     * to one of its windows -- a tray icon's callback from the shell */
+    WCHAR name[32];
+    DWORD pid;
+
+    TRACE( "%p %x %ld %p\n", hwnd, message, action, changefilter );
+    if (changefilter && changefilter->cbSize < sizeof(*changefilter))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!GetWindowThreadProcessId( hwnd, &pid ) || pid != GetCurrentProcessId())
+    {
+        SetLastError( ERROR_ACCESS_DENIED );
+        return FALSE;
+    }
+    if (changefilter) changefilter->ExtStatus = MSGFLTINFO_NONE;
+    if (message > 0xffff) return TRUE;
+    swprintf( name, ARRAY_SIZE(name), L"__sg_uipi_allow_%04x", message );
+    switch (action)
+    {
+    case MSGFLT_ALLOW: return SetPropW( hwnd, name, (HANDLE)1 );
+    case MSGFLT_DISALLOW:
+    case MSGFLT_RESET: RemovePropW( hwnd, name ); return TRUE;
+    }
+    SetLastError( ERROR_INVALID_PARAMETER );
+    return FALSE;
 }
--- a/dlls/shell32/systray.c
+++ b/dlls/shell32/systray.c
@@ -128,6 +128,53 @@
 /*************************************************************************
  * get_bitmap_info Helper function for filling BITMAP structs and calculating buffer size in bits
  */
+/* Stained Glass OS: an elevated program (ADR 0012) runs on a Wine desktop of
+ * its own, WinSta0\sg-elevated-<display>, whose explorer has a tray no one
+ * sees: its icons went there and never showed (David 2026-10-02, AmbirScan
+ * run as administrator). Its icons go to the session's shell's tray, the
+ * one shown on another desktop of the window station. */
+struct tray_search { HWND tray; };
+
+static BOOL CALLBACK find_tray_window( HWND hwnd, LPARAM lparam )
+{
+    struct tray_search *search = (struct tray_search *)lparam;
+    WCHAR class[32];
+
+    if (!GetClassNameW( hwnd, class, ARRAY_SIZE(class) ) || wcscmp( class, L"Shell_TrayWnd" )) return TRUE;
+    /* on another desktop IsWindowVisible calls every window hidden: its style says */
+    if (!(GetWindowLongW( hwnd, GWL_STYLE ) & WS_VISIBLE)) return TRUE;
+    search->tray = hwnd;
+    return FALSE;
+}
+
+static BOOL CALLBACK find_tray_desktop( WCHAR *name, LPARAM lparam )
+{
+    struct tray_search *search = (struct tray_search *)lparam;
+    HDESK desk;
+
+    if (!wcsnicmp( name, L"sg-elevated-", 12 )) return TRUE;
+    if (!(desk = OpenDesktopW( name, 0, FALSE, DESKTOP_READOBJECTS | DESKTOP_ENUMERATE ))) return TRUE;
+    EnumDesktopWindows( desk, find_tray_window, lparam );
+    CloseDesktop( desk );
+    return !search->tray;
+}
+
+static HWND find_tray(void)
+{
+    struct tray_search search = { NULL };
+    WCHAR name[64];
+
+#ifndef SG_MUTANT_ELEVATED_OWN_TRAY
+    if (GetUserObjectInformationW( GetThreadDesktop( GetCurrentThreadId() ), UOI_NAME, name, sizeof(name), NULL ) &&
+        !wcsnicmp( name, L"sg-elevated-", 12 ))
+    {
+        EnumDesktopsW( GetProcessWindowStation(), find_tray_desktop, (LPARAM)&search );
+        if (search.tray) return search.tray;
+    }
+#endif
+    return FindWindowExW( 0, NULL, L"Shell_TrayWnd", NULL );
+}
+
 static void get_bitmap_info( ICONINFO *icon_info, BITMAP *mask, BITMAP *color, LONG *mask_bits, LONG *color_bits )
 {
     if ((icon_info->hbmMask && !GetObjectW( icon_info->hbmMask, sizeof(*mask), mask )) ||
@@ -204,12 +251,16 @@
         return Shell_NotifyIconW(dwMessage, &newNid);
     }
 
-    tray = FindWindowExW(0, NULL, L"Shell_TrayWnd", NULL);
+    tray = find_tray();
     if (!tray)
     {
         SetLastError(E_FAIL);
         return FALSE;
     }
+    /* the shell, below an elevated program, may send it the icon's
+     * callbacks (UIPI, wine-sg 0291) */
+    if ((dwMessage == NIM_ADD || dwMessage == NIM_MODIFY) && (nid->uFlags & NIF_MESSAGE))
+        ChangeWindowMessageFilterEx( nid->hWnd, nid->uCallbackMessage, MSGFLT_ALLOW, NULL );
 
     cds.dwData = dwMessage;
     cds.cbData = sizeof(*data);
@@ -318,7 +369,7 @@
 
     if (!identifier || !icon_location || identifier->cbSize != sizeof(*identifier))
         return E_INVALIDARG;
-    if (!(tray = FindWindowW( L"Shell_TrayWnd", NULL ))) return E_FAIL;
+    if (!(tray = find_tray())) return E_FAIL;
 
     req.hWnd = HandleToLong( identifier->hWnd );
     req.uID = identifier->uID;
