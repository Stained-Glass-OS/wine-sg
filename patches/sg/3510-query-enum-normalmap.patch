+static HRESULT qe_reader_items(IWICMetadataReader *reader, struct string_list *list)
+{
+    GUID format, nested_format;
+    UINT count, i, j;
+    GUID *seen = NULL;
+    UINT *seen_count = NULL, nseen = 0;
+    HRESULT hr;
+
+    if (FAILED(hr = IWICMetadataReader_GetMetadataFormat(reader, &format))) return hr;
+    if (FAILED(hr = IWICMetadataReader_GetCount(reader, &count))) return hr;
+
+    if (!(seen = calloc(count + 1, sizeof(*seen))) || !(seen_count = calloc(count + 1, sizeof(*seen_count))))
+    {
+        free(seen);
+        return E_OUTOFMEMORY;
+    }
+
+    for (i = 0; i < count && SUCCEEDED(hr); i++)
+    {
+        PROPVARIANT schema, id, value;
+        IWICMetadataReader *nested;
+        WCHAR *name = NULL;
+
+        PropVariantInit(&schema);
+        PropVariantInit(&id);
+        PropVariantInit(&value);
+
+        if (FAILED(IWICMetadataReader_GetValueByIndex(reader, i, &schema, &id, &value)))
+            goto next;
+
+        if (value.vt == VT_UNKNOWN && value.punkVal
+                && SUCCEEDED(IUnknown_QueryInterface(value.punkVal, &IID_IWICMetadataReader, (void **)&nested)))
+        {
+            if (SUCCEEDED(IWICMetadataReader_GetMetadataFormat(nested, &nested_format)))
+            {
+                for (j = 0; j < nseen; j++)
+                    if (IsEqualGUID(&seen[j], &nested_format)) break;
+                if (j == nseen) { seen[nseen] = nested_format; seen_count[nseen++] = 0; }
+                name = format_reader_name(&nested_format, seen_count[j]++);
+            }
+            IWICMetadataReader_Release(nested);
+        }
+        else
+            name = format_item_name(&format, &schema, &id);
+
+        if (name) hr = string_list_add(list, name);
+    next:
+        PropVariantClear(&schema);
+        PropVariantClear(&id);
+        PropVariantClear(&value);
+    }
+
+    free(seen);
+    free(seen_count);
+    return hr;
+}
+
+static HRESULT qe_block_readers(IWICMetadataBlockReader *block, struct string_list *list)
+{
+    UINT count, i, j, nseen = 0;
+    GUID *seen;
+    UINT *seen_count;
+    HRESULT hr;
+
+    if (FAILED(hr = IWICMetadataBlockReader_GetCount(block, &count))) return hr;
+    if (!(seen = calloc(count + 1, sizeof(*seen))) || !(seen_count = calloc(count + 1, sizeof(*seen_count))))
+    {
+        free(seen);
+        return E_OUTOFMEMORY;
+    }
+
+    for (i = 0; i < count && SUCCEEDED(hr); i++)
+    {
+        IWICMetadataReader *reader;
+        GUID format;
+
+        if (FAILED(IWICMetadataBlockReader_GetReaderByIndex(block, i, &reader))) continue;
+        if (SUCCEEDED(IWICMetadataReader_GetMetadataFormat(reader, &format)))
+        {
+            for (j = 0; j < nseen; j++)
+                if (IsEqualGUID(&seen[j], &format)) break;
+            if (j == nseen) { seen[nseen] = format; seen_count[nseen++] = 0; }
+            hr = string_list_add(list, format_reader_name(&format, seen_count[j]++));
+        }
+        IWICMetadataReader_Release(reader);
+    }
+
+    free(seen);
+    free(seen_count);
+    return hr;
+}
+
+/* Lists the queries, relative to the location, of the readers and items found there. */
+static HRESULT qe_location(IWICMetadataBlockReader *block, const WCHAR *root, IEnumString **enum_string)
+{
+    struct string_list list = {0};
+    IWICMetadataReader *reader = NULL;
+    const WCHAR *p = root;
+    HRESULT hr = S_OK;
+
+    while (p && *p == '/' && p[1])
+    {
+        struct string_t elem;
+        PROPVARIANT id, schema;
+        int index = INDEX_NONE;
+        GUID guid;
+
+        p++;
+        elem.str = p;
+        elem.len = lstrlenW(p);
+        if (FAILED(hr = get_token(&elem, &id, &schema, &index))) break;
+        PropVariantClear(&schema);
+
+        if (id.vt == VT_CLSID || (id.vt == VT_BSTR && WICMapShortNameToGuid(id.bstrVal, &guid) == S_OK))
+        {
+            IWICMetadataReader *next = NULL;
+
+            if (id.vt == VT_CLSID) guid = *id.puuid;
+            if (index < 0) index = 0;
+
+            if (reader)
+            {
+                hr = get_next_reader(reader, index, &guid, &next);
+                IWICMetadataReader_Release(reader);
+            }
+            else
+                hr = find_reader_from_block(block, index, &guid, &next);
+            reader = next;
+        }
+        else
+            hr = WINCODEC_ERR_INVALIDQUERYREQUEST; /* items have no children */
+        PropVariantClear(&id);
+        if (hr != S_OK) break;
+        p += elem.len;
+    }
+
+    if (SUCCEEDED(hr))
+        hr = reader ? qe_reader_items(reader, &list) : qe_block_readers(block, &list);
+    if (reader) IWICMetadataReader_Release(reader);
+
+    if (SUCCEEDED(hr) && FAILED(hr = string_enumerator_create(list.strings, list.count, 0, enum_string)))
+        string_list_free(&list);
+    else if (FAILED(hr))
+        string_list_free(&list);
+    return hr;
+}
