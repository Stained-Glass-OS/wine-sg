+                float *o = out + 4 * ((SIZE_T)y * desc.Width + x);
+
+                o[0] = nx / len * 0.5f + 0.5f;
+                o[1] = ny / len * 0.5f + 0.5f;
+                o[2] = nz / len * 0.5f + 0.5f;
+                o[3] = 1.0f;
+            }
+        }
+        if (flags & D3DX_NORMALMAP_COMPUTE_OCCLUSION)
+        {
+            /* the occlusion term: how far each pixel lies below the mean height of its neighbours */
+            for (y = 0; y < desc.Height; ++y)
+            {
+                for (x = 0; x < desc.Width; ++x)
+                {
+                    float sum = 0.0f, h = normal_map_height(pixels, desc.Width, desc.Height, x, y, flags, channel);
+                    int dx, dy;
+
+                    for (dy = -1; dy <= 1; ++dy)
+                        for (dx = -1; dx <= 1; ++dx)
+                            if (dx || dy) sum += normal_map_height(pixels, desc.Width, desc.Height, x + dx, y + dy,
+                                    flags, channel);
+                    out[4 * ((SIZE_T)y * desc.Width + x) + 3] = max(0.0f, min(1.0f, 1.0f - (sum / 8.0f - h)));
+                }
+            }
+        }
+        {
+            RECT rect = {0, 0, desc.Width, desc.Height};
+
+            hr = D3DXLoadSurfaceFromMemory(dst_surface, NULL, NULL, out, D3DFMT_A32B32G32R32F,
+                    desc.Width * 4 * sizeof(float), NULL, &rect, D3DX_FILTER_NONE, 0);
+        }
+        free(out);
+    }
+
+done:
+    free(pixels);
+    if (work) IDirect3DSurface9_Release(work);
+    if (device) IDirect3DDevice9_Release(device);
+    if (src_surface) IDirect3DSurface9_Release(src_surface);
+    if (dst_surface) IDirect3DSurface9_Release(dst_surface);
+    return hr;
 }
