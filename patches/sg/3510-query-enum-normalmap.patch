+struct string_list
+{
+    WCHAR **strings;
+    ULONG count, capacity;
+};
+
+static HRESULT string_list_add(struct string_list *list, WCHAR *str)
+{
+    if (!str) return E_OUTOFMEMORY;
+    if (list->count == list->capacity)
+    {
+        ULONG capacity = list->capacity ? list->capacity * 2 : 8;
+        WCHAR **strings = realloc(list->strings, capacity * sizeof(*strings));
+
+        if (!strings) { free(str); return E_OUTOFMEMORY; }
+        list->strings = strings;
+        list->capacity = capacity;
+    }
+    list->strings[list->count++] = str;
+    return S_OK;
+}
+
+static void string_list_free(struct string_list *list)
+{
+    while (list->count) free(list->strings[--list->count]);
+    free(list->strings);
+    memset(list, 0, sizeof(*list));
+}
+
+static WCHAR *format_query(const WCHAR *fmt, ...)
+{
+    WCHAR buffer[512];
+    va_list args;
+    int len;
+
+    va_start(args, fmt);
+    len = vswprintf(buffer, ARRAY_SIZE(buffer), fmt, args);
+    va_end(args);
+    return len < 0 ? NULL : wcsdup(buffer);
+}
+
+/* Appends a plain name to a query, escaping the characters the query language uses. */
+static BOOL append_escaped(WCHAR *dst, SIZE_T size, const WCHAR *name, BOOL braces)
+{
+    SIZE_T len = lstrlenW(dst);
+
+    for (; *name; name++)
+    {
+        BOOL special = *name == '\\' || (braces ? (*name == '}') : (*name == '/' || *name == ':' || *name == '{' || *name == '['));
+
+        if (len + 3 >= size) return FALSE;
+        if (special) dst[len++] = '\\';
+        dst[len++] = *name;
+    }
+    dst[len] = 0;
+    return TRUE;
+}
+
+static WCHAR *format_reader_name(const GUID *format, UINT index)
+{
+    WCHAR name[64], guid_str[40];
+    UINT len;
+
+    if (SUCCEEDED(WICMapGuidToShortName(format, ARRAY_SIZE(name), name, &len)))
+        return index ? format_query(L"/%s[%u]", name, index) : format_query(L"/%s", name);
+
+    StringFromGUID2(format, guid_str, ARRAY_SIZE(guid_str));
+    return index ? format_query(L"/{guid=%s}[%u]", guid_str, index) : format_query(L"/{guid=%s}", guid_str);
+}
+
+static WCHAR *format_item_name(const GUID *format, const PROPVARIANT *schema, const PROPVARIANT *id)
+{
+    WCHAR buffer[512];
+    const WCHAR *short_schema = NULL;
+
+    if (schema->vt == VT_LPWSTR && schema->pwszVal && schema->pwszVal[0])
+    {
+        short_schema = schema_to_shortname(format, schema->pwszVal);
+        if (id->vt != VT_LPWSTR || !id->pwszVal) return NULL;
+
+        lstrcpyW(buffer, L"/");
+        if (short_schema)
+        {
+            lstrcatW(buffer, short_schema);
+            lstrcatW(buffer, L":");
+            if (!append_escaped(buffer, ARRAY_SIZE(buffer), id->pwszVal, FALSE)) return NULL;
+        }
+        else
+        {
+            lstrcatW(buffer, L"{wstr=");
+            if (!append_escaped(buffer, ARRAY_SIZE(buffer), schema->pwszVal, TRUE)) return NULL;
+            lstrcatW(buffer, L"}:{wstr=");
+            if (!append_escaped(buffer, ARRAY_SIZE(buffer), id->pwszVal, TRUE)) return NULL;
+            lstrcatW(buffer, L"}");
+        }
+        return wcsdup(buffer);
+    }
+
+    switch (id->vt)
+    {
+        case VT_LPWSTR:
+            if (!id->pwszVal) return NULL;
+            lstrcpyW(buffer, L"/{wstr=");
+            if (!append_escaped(buffer, ARRAY_SIZE(buffer), id->pwszVal, TRUE)) return NULL;
+            lstrcatW(buffer, L"}");
+            return wcsdup(buffer);
+        case VT_LPSTR:
+            if (!id->pszVal) return NULL;
+            return format_query(L"/{str=%S}", id->pszVal);
+        case VT_I1:  return format_query(L"/{char=%d}", id->cVal);
+        case VT_UI1: return format_query(L"/{uchar=%u}", id->bVal);
+        case VT_I2:  return format_query(L"/{short=%d}", id->iVal);
+        case VT_UI2: return format_query(L"/{ushort=%u}", id->uiVal);
+        case VT_I4:  return format_query(L"/{long=%ld}", id->lVal);
+        case VT_UI4: return format_query(L"/{ulong=%lu}", id->ulVal);
+        case VT_I8:  return format_query(L"/{longlong=%I64d}", id->hVal.QuadPart);
+        case VT_UI8: return format_query(L"/{ulonglong=%I64u}", id->uhVal.QuadPart);
+        default:
+            return NULL;
+    }
+}
