+static float normal_map_height(const float *pixels, UINT width, UINT height, int x, int y, DWORD flags, DWORD channel)
+{
+    const float *p;
+
+    if (flags & D3DX_NORMALMAP_MIRROR_U)
+    {
+        if (x < 0) x = -x - 1;
+        if (x >= (int)width) x = 2 * width - x - 1;
+        x = max(0, min(x, (int)width - 1));
+    }
+    else
+        x = (x % (int)width + width) % width;
+    if (flags & D3DX_NORMALMAP_MIRROR_V)
+    {
+        if (y < 0) y = -y - 1;
+        if (y >= (int)height) y = 2 * height - y - 1;
+        y = max(0, min(y, (int)height - 1));
+    }
+    else
+        y = (y % (int)height + height) % height;
+
+    p = pixels + 4 * (y * width + x); /* r, g, b, a */
+    switch (channel)
+    {
+        case D3DX_CHANNEL_RED:   return p[0];
+        case D3DX_CHANNEL_GREEN: return p[1];
+        case D3DX_CHANNEL_BLUE:  return p[2];
+        case D3DX_CHANNEL_ALPHA: return p[3];
+        default:                 return 0.299f * p[0] + 0.587f * p[1] + 0.114f * p[2];
+    }
+}
