+/* ---- messages ----------------------------------------------------------------- */
+
+static const WCHAR *level_name( BYTE level, ULONGLONG keywords )
+{
+    switch (level)
+    {
+    case 1: return L"Critical";
+    case 2: return L"Error";
+    case 3: return L"Warning";
+    case 5: return L"Verbose";
+    case 0:
+        if (keywords == AUDIT_SUCCESS_KEYWORDS || keywords == AUDIT_FAILURE_KEYWORDS) return L"Information";
+        return L"LogAlways";
+    default: return L"Information";
+    }
+}
+
+static const WCHAR *keyword_name( ULONGLONG keywords )
+{
+    if (keywords == AUDIT_SUCCESS_KEYWORDS) return L"Audit Success";
+    if (keywords == AUDIT_FAILURE_KEYWORDS) return L"Audit Failure";
+    return L"Classic";
+}
+
+/* the event's message: its source's message file with its strings inserted
+ * (and %%n parameters from the parameter file) */
+static WCHAR *event_message( struct publisher *pub, const struct event *ev, DWORD nvalues, EVT_VARIANT *values )
+{
+    const EVENTLOGRECORD *rec = ev->rec;
+    DWORD_PTR args[100];
+    WCHAR *msg = NULL;
+    DWORD i, n;
+
+    n = min( rec->NumStrings, ARRAY_SIZE(args) );
+    for (i = 0; i < n; i++) args[i] = (DWORD_PTR)rec_string( rec, i );
+    for (i = 0; i < nvalues && i < ARRAY_SIZE(args); i++)
+        if ((values[i].Type & EVT_VARIANT_TYPE_MASK) == EvtVarTypeString)
+        {
+            args[i] = (DWORD_PTR)values[i].StringVal;
+            n = max( n, i + 1 );
+        }
+    for (; n < ARRAY_SIZE(args); n++) args[n] = (DWORD_PTR)L"";
+    if (!load_message( pub->message_file, rec->EventID, args, n, &msg )) return NULL;
+    /* parameters: %%n is message n of the parameter file */
+    if (pub->parameter_file[0] && wcsstr( msg, L"%%" ))
+    {
+        struct strbuf sb = {0};
+        WCHAR *p = msg;
+
+        while (*p)
+        {
+            if (p[0] == '%' && p[1] == '%' && iswdigit( p[2] ))
+            {
+                WCHAR *end, *param = NULL;
+                DWORD id = wcstoul( p + 2, &end, 10 );
+                if (load_message( pub->parameter_file, id, NULL, 0, &param ))
+                {
+                    sb_append( &sb, param );
+                    free( param );
+                    p = end;
+                    continue;
+                }
+            }
+            sb_append_len( &sb, p++, 1 );
+        }
+        if (!sb.failed)
+        {
+            free( msg );
+            msg = sb.buf;
+        }
+        else free( sb.buf );
+    }
+    return msg;
+}
+
+static BOOL return_text( const WCHAR *text, DWORD size, WCHAR *buffer, DWORD *used )
+{
+    DWORD len = wcslen( text ) + 1;
+
+    *used = len;
+    if (!buffer || size < len)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    memcpy( buffer, text, len * sizeof(WCHAR) );
+    return TRUE;
+}
+
+BOOL WINAPI EvtFormatMessage( EVT_HANDLE metadata, EVT_HANDLE event, DWORD message_id, DWORD nvalues,
+                              EVT_VARIANT *values, DWORD flags, DWORD size, WCHAR *buffer, DWORD *used )
+{
+    struct publisher *pub = NULL;
+    struct event *ev = NULL;
+    WCHAR *text = NULL, num[16], name[256];
+    const WCHAR *fixed = NULL;
+    DWORD err = ERROR_SUCCESS;
+    BOOL ret;
+
+    TRACE( "(%p %p %lu %lu %p %lu %lu %p %p)\n", metadata, event, message_id, nvalues, values, flags, size, buffer, used );
+
+    if (!used || flags < EvtFormatMessageEvent || flags > EvtFormatMessageXml)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (flags != EvtFormatMessageId && !(ev = (struct event *)grab( event, OBJ_EVENT ))) return FALSE;
+    if (metadata)
+    {
+        if (!(pub = (struct publisher *)grab( metadata, OBJ_PUBLISHER )))
+        {
+            if (ev) release_object( &ev->hdr );
+            return FALSE;
+        }
+    }
+    else if (ev) pub = open_publisher( rec_source( ev->rec ), ev->from_file ? NULL : ev->channel );
+    else
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    switch (flags)
+    {
+    case EvtFormatMessageEvent:
+        if (!pub || !(text = event_message( pub, ev, nvalues, values ))) err = ERROR_EVT_MESSAGE_NOT_FOUND;
+        break;
+    case EvtFormatMessageLevel:
+        fixed = level_name( event_level( ev->rec ), event_keywords( ev->rec ) );
+        break;
+    case EvtFormatMessageTask:
+        if (!ev->rec->EventCategory) fixed = L"None";
+        else if (!pub || !load_message( pub->category_file, ev->rec->EventCategory, NULL, 0, &text ))
+        {
+            swprintf( num, ARRAY_SIZE(num), L"(%u)", ev->rec->EventCategory );
+            fixed = num;
+        }
+        break;
+    case EvtFormatMessageOpcode:
+        fixed = L"Info";
+        break;
+    case EvtFormatMessageKeyword:
+        fixed = keyword_name( event_keywords( ev->rec ) );
+        break;
+    case EvtFormatMessageChannel:
+        lstrcpynW( name, ev->from_file ? L"" : ev->channel, ARRAY_SIZE(name) );
+        fixed = name;
+        break;
+    case EvtFormatMessageProvider:
+        lstrcpynW( name, pub ? pub->name : rec_source( ev->rec ), ARRAY_SIZE(name) );
+        fixed = name;
+        break;
+    case EvtFormatMessageId:
+        if (!pub || !load_message( pub->message_file, message_id, NULL, 0, &text )) err = ERROR_EVT_MESSAGE_ID_NOT_FOUND;
+        break;
+    case EvtFormatMessageXml:
+    {
+        struct strbuf sb = {0};
+        WCHAR *message = pub ? event_message( pub, ev, nvalues, values ) : NULL, *task = NULL;
+
+        sb_append( &sb, L"<RenderingInfo Culture='en-US'><Message>" );
+        if (message) sb_escape( &sb, message );
+        sb_append( &sb, L"</Message><Level>" );
+        sb_escape( &sb, level_name( event_level( ev->rec ), event_keywords( ev->rec ) ) );
+        sb_append( &sb, L"</Level><Task>" );
+        if (ev->rec->EventCategory && pub && load_message( pub->category_file, ev->rec->EventCategory, NULL, 0, &task ))
+            sb_escape( &sb, task );
+        else if (!ev->rec->EventCategory) sb_append( &sb, L"None" );
+        sb_append( &sb, L"</Task><Opcode>Info</Opcode><Channel>" );
+        sb_escape( &sb, ev->from_file ? L"" : ev->channel );
+        sb_append( &sb, L"</Channel><Provider>" );
+        sb_escape( &sb, rec_source( ev->rec ) );
+        sb_append( &sb, L"</Provider><Keywords><Keyword>" );
+        sb_escape( &sb, keyword_name( event_keywords( ev->rec ) ) );
+        sb_append( &sb, L"</Keyword></Keywords></RenderingInfo>" );
+        free( message );
+        free( task );
+        if (sb.failed || !(text = event_xml( ev, sb.buf ))) err = ERROR_NOT_ENOUGH_MEMORY;
+        free( sb.buf );
+        break;
+    }
+    }
+    if (pub) release_object( &pub->hdr );
+    if (ev) release_object( &ev->hdr );
+    if (err)
+    {
+        free( text );
+        *used = 0;
+        SetLastError( err );
+        return FALSE;
+    }
+    ret = return_text( text ? text : fixed, size, buffer, used );
+    free( text );
+    return ret;
+}
+
+/* ---- information --------------------------------------------------------------- */
+
+BOOL WINAPI EvtGetEventInfo( EVT_HANDLE handle, EVT_EVENT_PROPERTY_ID id, DWORD size, EVT_VARIANT *buffer,
+                             DWORD *used )
+{
+    struct event *ev;
+    EVT_VARIANT var = {{0}};
+    BOOL ret;
+
+    TRACE( "(%p %u %lu %p %p)\n", handle, id, size, buffer, used );
+
+    if (!used)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(ev = (struct event *)grab( handle, OBJ_EVENT ))) return FALSE;
+    if (id == EvtEventQueryIDs)
+    {
+        /* the query (in a list) that selected it */
+        DWORD need = sizeof(EVT_VARIANT) + sizeof(INT32);
+        *used = need;
+        if (!buffer || size < need)
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            ret = FALSE;
+        }
+        else
+        {
+            buffer->Type = EvtVarTypeInt32 | EVT_VARIANT_TYPE_ARRAY;
+            buffer->Count = 1;
+            buffer->Int32Arr = (INT32 *)(buffer + 1);
+            buffer->Int32Arr[0] = ev->query_id;
+            ret = TRUE;
+        }
+    }
+    else if (id == EvtEventPath)
+    {
+        var.Type = EvtVarTypeString;
+        ret = return_variant( &var, ev->channel, NULL, 0, size, buffer, used );
+    }
+    else
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        ret = FALSE;
+    }
+    release_object( &ev->hdr );
+    return ret;
+}
+
+BOOL WINAPI EvtGetQueryInfo( EVT_HANDLE handle, EVT_QUERY_PROPERTY_ID id, DWORD size, EVT_VARIANT *buffer,
+                             DWORD *used )
+{
+    struct result_set *rs;
+    DWORD need, i, offset;
+    BOOL ret = FALSE;
+
+    TRACE( "(%p %u %lu %p %p)\n", handle, id, size, buffer, used );
+
+    if (!used)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(rs = (struct result_set *)grab( handle, OBJ_QUERY ))) return FALSE;
+    if (id == EvtQueryNames)
+    {
+        need = sizeof(EVT_VARIANT) + rs->npaths * sizeof(WCHAR *);
+        for (i = 0; i < rs->npaths; i++) need += (wcslen( rs->names[i] ) + 1) * sizeof(WCHAR);
+        *used = need;
+        if (!buffer || size < need) SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        else
+        {
+            WCHAR **arr = (WCHAR **)(buffer + 1);
+            buffer->Type = EvtVarTypeString | EVT_VARIANT_TYPE_ARRAY;
+            buffer->Count = rs->npaths;
+            buffer->StringArr = arr;
+            offset = sizeof(EVT_VARIANT) + rs->npaths * sizeof(WCHAR *);
+            for (i = 0; i < rs->npaths; i++)
+            {
+                arr[i] = (WCHAR *)((BYTE *)buffer + offset);
+                lstrcpyW( arr[i], rs->names[i] );
+                offset += (wcslen( rs->names[i] ) + 1) * sizeof(WCHAR);
+            }
+            ret = TRUE;
+        }
+    }
+    else if (id == EvtQueryStatuses)
+    {
+        need = sizeof(EVT_VARIANT) + rs->npaths * sizeof(UINT32);
+        *used = need;
+        if (!buffer || size < need) SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        else
+        {
+            buffer->Type = EvtVarTypeUInt32 | EVT_VARIANT_TYPE_ARRAY;
+            buffer->Count = rs->npaths;
+            buffer->UInt32Arr = (UINT32 *)(buffer + 1);
+            for (i = 0; i < rs->npaths; i++) buffer->UInt32Arr[i] = rs->statuses[i];
+            ret = TRUE;
+        }
+    }
+    else SetLastError( ERROR_INVALID_PARAMETER );
+    release_object( &rs->hdr );
+    return ret;
+}
+
+DWORD WINAPI EvtGetExtendedStatus( DWORD size, WCHAR *buffer, DWORD *used )
+{
+    TRACE( "(%lu %p %p)\n", size, buffer, used );
+
+    /* no call here leaves more to say than its error code */
+    if (!used) return ERROR_INVALID_PARAMETER;
+    *used = 1;
+    if (!buffer || !size) return ERROR_INSUFFICIENT_BUFFER;
+    buffer[0] = 0;
+    return ERROR_SUCCESS;
 }
