+/* a classic event log (of the service), with its own name */
+static BOOL classic_log( const WCHAR *name, WCHAR *real, DWORD size )
+{
+    WCHAR path[512], sub[256];
+    DWORD i, len;
+    HKEY key;
+    BOOL found = FALSE;
+
+    if (!name || !name[0] || wcschr( name, '\\' )) return FALSE;
+    swprintf( path, ARRAY_SIZE(path), L"%s", eventlog_keyW );
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_ENUMERATE_SUB_KEYS, &key )) return FALSE;
+    for (i = 0; !found; i++)
+    {
+        len = ARRAY_SIZE(sub);
+        if (RegEnumKeyExW( key, i, sub, &len, NULL, NULL, NULL, NULL )) break;
+        if (!wcsicmp( sub, name ))
+        {
+            found = TRUE;
+            if (real) lstrcpynW( real, sub, size );
+        }
+    }
+    RegCloseKey( key );
+    return found;
