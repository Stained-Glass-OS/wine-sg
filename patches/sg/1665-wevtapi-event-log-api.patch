+/* ---- the event as a document ------------------------------------------------------- */
+
+struct xattr
+{
+    const WCHAR *name;
+    WCHAR *value;
+};
+
+struct xnode
+{
+    const WCHAR *name;
+    WCHAR *text;
+    struct xattr attrs[4];
+    int nattrs;
+    struct xnode *children;
+    int nchildren, cap;
+};
+
+static struct xnode *xadd( struct xnode *parent, const WCHAR *name, const WCHAR *text )
+{
+    struct xnode *node;
+
+    if (parent->nchildren == parent->cap)
+    {
+        int cap = parent->cap ? parent->cap * 2 : 8;
+        struct xnode *children = realloc( parent->children, cap * sizeof(*children) );
+        if (!children) return NULL;
+        parent->children = children;
+        parent->cap = cap;
+    }
+    node = &parent->children[parent->nchildren++];
+    memset( node, 0, sizeof(*node) );
+    node->name = name;
+    node->text = strdupW( text );
+    return node;
+}
+
+static void xattr_add( struct xnode *node, const WCHAR *name, const WCHAR *value )
+{
+    if (!node || node->nattrs >= ARRAY_SIZE(node->attrs)) return;
+    node->attrs[node->nattrs].name = name;
+    node->attrs[node->nattrs].value = strdupW( value );
+    node->nattrs++;
+}
+
+static void xfree( struct xnode *node )
+{
+    int i;
+
+    for (i = 0; i < node->nchildren; i++) xfree( &node->children[i] );
+    for (i = 0; i < node->nattrs; i++) free( node->attrs[i].value );
+    free( node->children );
+    free( node->text );
+}
