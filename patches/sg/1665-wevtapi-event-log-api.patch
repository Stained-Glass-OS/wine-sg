+/* ---- logs ------------------------------------------------------------------------- */
+
+struct log_object
+{
+    struct object hdr;
+    WCHAR name[MAX_PATH];
+    BOOL file;
+    BOOL classic;
+};
+
+static BOOL log_file_path( const WCHAR *channel, WCHAR *path, DWORD size )
+{
+    WCHAR key[512], value[MAX_PATH], dir[MAX_PATH];
+    DWORD len = sizeof(value);
+
+    swprintf( key, ARRAY_SIZE(key), L"%s\\%s", eventlog_keyW, channel );
+    if (!RegGetValueW( HKEY_LOCAL_MACHINE, key, L"File", RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ | RRF_NOEXPAND,
+                       NULL, value, &len ))
+    {
+        ExpandEnvironmentStringsW( value, path, size );
+        return TRUE;
+    }
+    GetSystemDirectoryW( dir, ARRAY_SIZE(dir) );
+    swprintf( path, size, L"%s\\winevt\\Logs\\%s.sgevt", dir, channel );
+    return TRUE;
+}
+
+EVT_HANDLE WINAPI EvtOpenLog( EVT_HANDLE session, const WCHAR *path, DWORD flags )
+{
+    struct log_object *log;
+    WCHAR name[256];
+    BOOL classic = FALSE;
+
+    TRACE( "(%p %s %#lx)\n", session, debugstr_w( path ), flags );
+
+    if (!check_session( session )) return NULL;
+    if (!path || (flags != EvtOpenChannelPath && flags != EvtOpenFilePath))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (flags == EvtOpenChannelPath && !find_channel( path, name, ARRAY_SIZE(name), &classic ))
+    {
+        SetLastError( ERROR_EVT_CHANNEL_NOT_FOUND );
+        return NULL;
+    }
+    if (flags == EvtOpenFilePath && GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES) return NULL;
+    if (!(log = alloc_object( sizeof(*log), OBJ_LOG, destroy_plain ))) return NULL;
+    lstrcpynW( log->name, flags == EvtOpenFilePath ? path : name, ARRAY_SIZE(log->name) );
+    log->file = flags == EvtOpenFilePath;
+    log->classic = classic;
+    return alloc_handle( &log->hdr );
+}
+
+static BOOL return_variant( const EVT_VARIANT *var, const WCHAR *str, const BYTE *extra, DWORD extra_len,
+                            DWORD size, EVT_VARIANT *buffer, DWORD *used )
+{
+    DWORD need = sizeof(EVT_VARIANT) + (str ? (wcslen( str ) + 1) * sizeof(WCHAR) : 0) + extra_len;
+
+    *used = need;
+    if (!buffer || size < need)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    /* Count is left alone for a single value */
+    buffer->Type = var->Type;
+    buffer->UInt64Val = var->UInt64Val;
+    if (str)
+    {
+        buffer->StringVal = (WCHAR *)(buffer + 1);
+        lstrcpyW( (WCHAR *)(buffer + 1), str );
+    }
+    else if (extra_len)
+    {
+        buffer->BinaryVal = (BYTE *)(buffer + 1);
+        memcpy( buffer + 1, extra, extra_len );
+    }
+    return TRUE;
+}
+
+BOOL WINAPI EvtGetLogInfo( EVT_HANDLE handle, EVT_LOG_PROPERTY_ID id, DWORD size, EVT_VARIANT *buffer, DWORD *used )
+{
+    WIN32_FILE_ATTRIBUTE_DATA attrs = {0};
+    struct log_object *log;
+    EVT_VARIANT var = {{0}};
+    WCHAR path[MAX_PATH];
+    HANDLE h = NULL;
+    DWORD value = 0;
+    BOOL ret;
+
+    TRACE( "(%p %u %lu %p %p)\n", handle, id, size, buffer, used );
+
+    if (!used)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(log = (struct log_object *)grab( handle, OBJ_LOG ))) return FALSE;
+    if (log->file) lstrcpyW( path, log->name );
+    else log_file_path( log->name, path, ARRAY_SIZE(path) );
+    GetFileAttributesExW( path, GetFileExInfoStandard, &attrs );
+    if (id >= EvtLogNumberOfLogRecords)
+    {
+        h = log->file ? OpenBackupEventLogW( NULL, log->name ) : log->classic ? OpenEventLogW( NULL, log->name ) : NULL;
+    }
+    switch (id)
+    {
+    case EvtLogCreationTime:
+        var.Type = EvtVarTypeFileTime;
+        var.FileTimeVal = (ULONGLONG)attrs.ftCreationTime.dwHighDateTime << 32 | attrs.ftCreationTime.dwLowDateTime;
+        break;
+    case EvtLogLastAccessTime:
+        var.Type = EvtVarTypeFileTime;
+        var.FileTimeVal = (ULONGLONG)attrs.ftLastAccessTime.dwHighDateTime << 32 | attrs.ftLastAccessTime.dwLowDateTime;
+        break;
+    case EvtLogLastWriteTime:
+        var.Type = EvtVarTypeFileTime;
+        var.FileTimeVal = (ULONGLONG)attrs.ftLastWriteTime.dwHighDateTime << 32 | attrs.ftLastWriteTime.dwLowDateTime;
+        break;
+    case EvtLogFileSize:
+        var.Type = EvtVarTypeUInt64;
+        var.UInt64Val = (ULONGLONG)attrs.nFileSizeHigh << 32 | attrs.nFileSizeLow;
+        break;
+    case EvtLogAttributes:
+        var.Type = EvtVarTypeUInt32;
+        var.UInt32Val = attrs.dwFileAttributes;
+        break;
+    case EvtLogNumberOfLogRecords:
+        if (h) GetNumberOfEventLogRecords( h, &value );
+        var.Type = EvtVarTypeUInt64;
+        var.UInt64Val = value;
+        break;
+    case EvtLogOldestRecordNumber:
+        if (h) GetOldestEventLogRecord( h, &value );
+        var.Type = EvtVarTypeUInt64;
+        var.UInt64Val = value;
+        break;
+    case EvtLogFull:
+    {
+        EVENTLOG_FULL_INFORMATION full = {0};
+        DWORD needed;
+        if (h) GetEventLogInformation( h, EVENTLOG_FULL_INFO, &full, sizeof(full), &needed );
+        var.Type = EvtVarTypeBoolean;
+        var.BooleanVal = full.dwFull != 0;
+        break;
+    }
+    default:
+        if (h) CloseEventLog( h );
+        release_object( &log->hdr );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (h) CloseEventLog( h );
+    release_object( &log->hdr );
+    ret = return_variant( &var, NULL, NULL, 0, size, buffer, used );
+    return ret;
+}
+
+BOOL WINAPI EvtClearLog( EVT_HANDLE session, const WCHAR *channel, const WCHAR *target, DWORD flags )
+{
+    WCHAR name[256];
+    BOOL classic, ret;
+    HANDLE log;
+
+    TRACE( "(%p %s %s %#lx)\n", session, debugstr_w( channel ), debugstr_w( target ), flags );
+
+    if (!check_session( session )) return FALSE;
+    if (!channel || flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!find_channel( channel, name, ARRAY_SIZE(name), &classic ))
+    {
+        SetLastError( ERROR_EVT_CHANNEL_NOT_FOUND );
+        return FALSE;
+    }
+    if (!classic) return TRUE;  /* nothing kept */
+    if (!(log = OpenEventLogW( NULL, name ))) return FALSE;
+    ret = ClearEventLogW( log, target );
+    CloseEventLog( log );
+    return ret;
+}
+
+/* writes the events of a query to a file the Event Log service can read
+ * back (OpenBackupEventLog) */
+BOOL WINAPI EvtExportLog( EVT_HANDLE session, const WCHAR *path, const WCHAR *query, const WCHAR *file, DWORD flags )
+{
+    struct backup_header header = { BACKUP_MAGIC, BACKUP_VERSION, 1 };
+    struct result_set *rs;
+    HANDLE out;
+    DWORD err, i, written;
+    BOOL ok = TRUE;
+
+    TRACE( "(%p %s %s %s %#lx)\n", session, debugstr_w( path ), debugstr_w( query ), debugstr_w( file ), flags );
+
+    if (!check_session( session )) return FALSE;
+    if (!file || (flags & (EvtExportLogChannelPath | EvtExportLogFilePath)) ==
+        (EvtExportLogChannelPath | EvtExportLogFilePath) ||
+        (flags & ~(EvtExportLogChannelPath | EvtExportLogFilePath | EvtExportLogTolerateQueryErrors |
+                   EvtExportLogOverwrite)))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(rs = run_query( path, query, ((flags & EvtExportLogFilePath) ? EvtQueryFilePath : EvtQueryChannelPath) |
+                          ((flags & EvtExportLogTolerateQueryErrors) ? EvtQueryTolerateQueryErrors : 0), &err )))
+    {
+        SetLastError( err );
+        return FALSE;
+    }
+    out = CreateFileW( file, GENERIC_WRITE, 0, NULL, (flags & EvtExportLogOverwrite) ? CREATE_ALWAYS : CREATE_NEW,
+                       FILE_ATTRIBUTE_NORMAL, NULL );
+    if (out == INVALID_HANDLE_VALUE)
+    {
+        release_object( &rs->hdr );
+        return FALSE;
+    }
+    for (i = 0; i < rs->count; i++) header.next_record = max( header.next_record, rs->events[i]->rec->RecordNumber + 1 );
+    ok = WriteFile( out, &header, sizeof(header), &written, NULL );
+    for (i = 0; ok && i < rs->count; i++)
+        ok = WriteFile( out, rs->events[i]->rec, rs->events[i]->rec->Length, &written, NULL );
+    CloseHandle( out );
+    release_object( &rs->hdr );
+    if (!ok) DeleteFileW( file );
+    return ok;
+}
+
+BOOL WINAPI EvtArchiveExportedLog( EVT_HANDLE session, const WCHAR *file, LCID locale, DWORD flags )
+{
+    TRACE( "(%p %s %#lx %#lx)\n", session, debugstr_w( file ), locale, flags );
+
+    if (!check_session( session )) return FALSE;
+    if (!file || flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* messages are found when an event is formatted: nothing to add */
+    if (GetFileAttributesW( file ) == INVALID_FILE_ATTRIBUTES) return FALSE;
+    return TRUE;
+}
+
+/* ---- channel enumeration and configuration ------------------------------------- */
+
+struct name_list
+{
+    struct object hdr;
+    WCHAR **names;
+    DWORD count, pos;
+};
+
+static void destroy_name_list( struct object *obj )
+{
+    struct name_list *list = (struct name_list *)obj;
+    DWORD i;
+
+    for (i = 0; i < list->count; i++) free( list->names[i] );
+    free( list->names );
+    free( list );
+}
+
+static void names_add( struct name_list *list, const WCHAR *name )
+{
+    WCHAR **names;
+    DWORD i;
+
+    for (i = 0; i < list->count; i++) if (!wcsicmp( list->names[i], name )) return;
+    if (!(names = realloc( list->names, (list->count + 1) * sizeof(*names) ))) return;
+    list->names = names;
+    list->names[list->count++] = wcsdup( name );
+}
+
+static void names_add_subkeys( struct name_list *list, HKEY root, const WCHAR *path )
+{
+    WCHAR name[256];
+    DWORD i, len;
+    HKEY key;
+
+    if (RegOpenKeyExW( root, path, 0, KEY_ENUMERATE_SUB_KEYS, &key )) return;
+    for (i = 0;; i++)
+    {
+        len = ARRAY_SIZE(name);
+        if (RegEnumKeyExW( key, i, name, &len, NULL, NULL, NULL, NULL )) break;
+        names_add( list, name );
+    }
+    RegCloseKey( key );
+}
+
+static int __cdecl cmp_names( const void *a, const void *b )
+{
+    return wcsicmp( *(WCHAR *const *)a, *(WCHAR *const *)b );
+}
+
+EVT_HANDLE WINAPI EvtOpenChannelEnum( EVT_HANDLE session, DWORD flags )
+{
+    struct name_list *list;
+
+    TRACE( "(%p %#lx)\n", session, flags );
+
+    if (!check_session( session )) return NULL;
+    if (flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (!(list = alloc_object( sizeof(*list), OBJ_CHANNEL_ENUM, destroy_name_list ))) return NULL;
+    names_add_subkeys( list, HKEY_LOCAL_MACHINE, eventlog_keyW );
+    names_add_subkeys( list, HKEY_LOCAL_MACHINE, channels_keyW );
+    if (list->count) qsort( list->names, list->count, sizeof(*list->names), cmp_names );
+    return alloc_handle( &list->hdr );
+}
+
+static BOOL next_name( EVT_HANDLE handle, enum object_type type, DWORD size, WCHAR *buffer, DWORD *used )
+{
+    struct name_list *list;
+    DWORD len;
+    BOOL ret = FALSE;
+
+    if (!used)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(list = (struct name_list *)grab( handle, type ))) return FALSE;
+    if (list->pos >= list->count) SetLastError( ERROR_NO_MORE_ITEMS );
+    else
+    {
+        len = wcslen( list->names[list->pos] ) + 1;
+        *used = len;
+        if (!buffer || size < len) SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        else
+        {
+            lstrcpyW( buffer, list->names[list->pos++] );
+            ret = TRUE;
+        }
+    }
+    release_object( &list->hdr );
+    return ret;
+}
+
+BOOL WINAPI EvtNextChannelPath( EVT_HANDLE handle, DWORD size, WCHAR *buffer, DWORD *used )
+{
+    TRACE( "(%p %lu %p %p)\n", handle, size, buffer, used );
+    return next_name( handle, OBJ_CHANNEL_ENUM, size, buffer, used );
+}
+
+struct channel_config
+{
+    struct object hdr;
+    WCHAR name[256];
+    BOOL classic;
+    /* pending changes (EvtSaveChannelConfig) */
+    BOOL set_enabled, enabled;
+    BOOL set_retention, retention;
+    BOOL set_autobackup, autobackup;
+    BOOL set_maxsize;
+    ULONGLONG maxsize;
+    WCHAR *file;
+    WCHAR *access;
+    BOOL set_level, set_keywords;
+    DWORD level;
+    ULONGLONG keywords;
+};
+
+static void destroy_channel_config( struct object *obj )
+{
+    struct channel_config *cfg = (struct channel_config *)obj;
+    free( cfg->file );
+    free( cfg->access );
+    free( cfg );
+}
+
+EVT_HANDLE WINAPI EvtOpenChannelConfig( EVT_HANDLE session, const WCHAR *path, DWORD flags )
+{
+    struct channel_config *cfg;
+    WCHAR name[256];
+    BOOL classic;
+
+    TRACE( "(%p %s %#lx)\n", session, debugstr_w( path ), flags );
+
+    if (!check_session( session )) return NULL;
+    if (!path || flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (!find_channel( path, name, ARRAY_SIZE(name), &classic ))
+    {
+        SetLastError( ERROR_EVT_CHANNEL_NOT_FOUND );
+        return NULL;
+    }
+    if (!(cfg = alloc_object( sizeof(*cfg), OBJ_CHANNEL_CONFIG, destroy_channel_config ))) return NULL;
+    lstrcpyW( cfg->name, name );
+    cfg->classic = classic;
+    return alloc_handle( &cfg->hdr );
+}
+
+static DWORD reg_dword( const WCHAR *base, const WCHAR *channel, const WCHAR *value, DWORD def )
+{
+    WCHAR key[512];
+    DWORD data, len = sizeof(data);
+
+    swprintf( key, ARRAY_SIZE(key), L"%s\\%s", base, channel );
+    if (RegGetValueW( HKEY_LOCAL_MACHINE, key, value, RRF_RT_REG_DWORD, NULL, &data, &len )) return def;
+    return data;
+}
+
+static BOOL reg_string( const WCHAR *base, const WCHAR *channel, const WCHAR *value, WCHAR *buf, DWORD size )
+{
+    WCHAR key[512];
+    DWORD len = size * sizeof(WCHAR);
+
+    swprintf( key, ARRAY_SIZE(key), L"%s\\%s", base, channel );
+    return !RegGetValueW( HKEY_LOCAL_MACHINE, key, value, RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ | RRF_NOEXPAND, NULL, buf, &len );
+}
+
+/* the access the service grants: Security is for administrators, the others for everyone */
+static const WCHAR *channel_access( const WCHAR *name )
+{
+    return !wcsicmp( name, L"Security" ) ? L"O:BAG:SYD:(A;;0x7;;;SY)(A;;0x5;;;BA)" :
+                                           L"O:BAG:SYD:(A;;0x7;;;SY)(A;;0x7;;;BA)(A;;0x3;;;WD)";
+}
+
+BOOL WINAPI EvtGetChannelConfigProperty( EVT_HANDLE handle, EVT_CHANNEL_CONFIG_PROPERTY_ID id, DWORD flags,
+                                         DWORD size, EVT_VARIANT *buffer, DWORD *used )
+{
+    struct channel_config *cfg;
+    EVT_VARIANT var = {{0}};
+    WCHAR str[MAX_PATH], *strval = NULL;
+    BOOL ret;
+
+    TRACE( "(%p %u %#lx %lu %p %p)\n", handle, id, flags, size, buffer, used );
+
+    if (!used || flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(cfg = (struct channel_config *)grab( handle, OBJ_CHANNEL_CONFIG ))) return FALSE;
+    switch (id)
+    {
+    case EvtChannelConfigEnabled:
+        var.Type = EvtVarTypeBoolean;
+        var.BooleanVal = cfg->set_enabled ? cfg->enabled : reg_dword( channels_keyW, cfg->name, L"Enabled", 1 ) != 0;
+        break;
+    case EvtChannelConfigIsolation:
+        var.Type = EvtVarTypeUInt32;
+        var.UInt32Val = reg_dword( channels_keyW, cfg->name, L"Isolation",
+                                   !wcsicmp( cfg->name, L"System" ) || !wcsicmp( cfg->name, L"Security" ) ?
+                                   EvtChannelIsolationTypeSystem : EvtChannelIsolationTypeApplication );
+        break;
+    case EvtChannelConfigType:
+        var.Type = EvtVarTypeUInt32;
+        var.UInt32Val = reg_dword( channels_keyW, cfg->name, L"Type", EvtChannelTypeAdmin );
+        break;
+    case EvtChannelConfigOwningPublisher:
+        var.Type = EvtVarTypeString;
+        if (!reg_string( channels_keyW, cfg->name, L"OwningPublisher", str, ARRAY_SIZE(str) )) str[0] = 0;
+        strval = str;
+        break;
+    case EvtChannelConfigClassicEventlog:
+        var.Type = EvtVarTypeBoolean;
+        var.BooleanVal = cfg->classic;
+        break;
+    case EvtChannelConfigAccess:
+        var.Type = EvtVarTypeString;
+        if (cfg->access) lstrcpynW( str, cfg->access, ARRAY_SIZE(str) );
+        else if (!reg_string( eventlog_keyW, cfg->name, L"CustomSD", str, ARRAY_SIZE(str) ))
+            lstrcpyW( str, channel_access( cfg->name ) );
+        strval = str;
+        break;
+    case EvtChannelLoggingConfigRetention:
+        var.Type = EvtVarTypeBoolean;
+        var.BooleanVal = cfg->set_retention ? cfg->retention : reg_dword( eventlog_keyW, cfg->name, L"Retention", 0 ) != 0;
+        break;
+    case EvtChannelLoggingConfigAutoBackup:
+        var.Type = EvtVarTypeBoolean;
+        var.BooleanVal = cfg->set_autobackup ? cfg->autobackup :
+                         reg_dword( eventlog_keyW, cfg->name, L"AutoBackupLogFiles", 0 ) != 0;
+        break;
+    case EvtChannelLoggingConfigMaxSize:
+        var.Type = EvtVarTypeUInt64;
+        var.UInt64Val = cfg->set_maxsize ? cfg->maxsize : reg_dword( eventlog_keyW, cfg->name, L"MaxSize", 20 * 1024 * 1024 );
+        break;
+    case EvtChannelLoggingConfigLogFilePath:
+        var.Type = EvtVarTypeString;
+        if (cfg->file) lstrcpynW( str, cfg->file, ARRAY_SIZE(str) );
+        else log_file_path( cfg->name, str, ARRAY_SIZE(str) );
+        strval = str;
+        break;
+    case EvtChannelPublishingConfigLevel:
+        var.Type = EvtVarTypeUInt32;
+        var.UInt32Val = cfg->set_level ? cfg->level : reg_dword( channels_keyW, cfg->name, L"Level", 0 );
+        break;
+    case EvtChannelPublishingConfigKeywords:
+        var.Type = EvtVarTypeUInt64;
+        var.UInt64Val = cfg->set_keywords ? cfg->keywords : reg_dword( channels_keyW, cfg->name, L"Keywords", 0 );
+        break;
+    case EvtChannelPublishingConfigControlGuid:
+        var.Type = EvtVarTypeNull;
+        break;
+    case EvtChannelPublishingConfigBufferSize:
+        var.Type = EvtVarTypeUInt32;
+        var.UInt32Val = 64;
+        break;
+    case EvtChannelPublishingConfigMinBuffers:
+        var.Type = EvtVarTypeUInt32;
+        var.UInt32Val = 0;
+        break;
+    case EvtChannelPublishingConfigMaxBuffers:
+        var.Type = EvtVarTypeUInt32;
+        var.UInt32Val = 64;
+        break;
+    case EvtChannelPublishingConfigLatency:
+        var.Type = EvtVarTypeUInt32;
+        var.UInt32Val = 1000;
+        break;
+    case EvtChannelPublishingConfigClockType:
+        var.Type = EvtVarTypeUInt32;
+        var.UInt32Val = EvtChannelClockTypeSystemTime;
+        break;
+    case EvtChannelPublishingConfigSidType:
+        var.Type = EvtVarTypeUInt32;
+        var.UInt32Val = EvtChannelSidTypePublishing;
+        break;
+    case EvtChannelPublishingConfigFileMax:
+        var.Type = EvtVarTypeUInt32;
+        var.UInt32Val = 1;
+        break;
+    case EvtChannelPublisherList:
+    {
+        /* the sources registered for the log */
+        struct name_list list = {{0}};
+        WCHAR key[512];
+        DWORD need, i, offset;
+
+        swprintf( key, ARRAY_SIZE(key), L"%s\\%s", eventlog_keyW, cfg->name );
+        names_add_subkeys( &list, HKEY_LOCAL_MACHINE, key );
+        need = sizeof(EVT_VARIANT) + list.count * sizeof(WCHAR *);
+        for (i = 0; i < list.count; i++) need += (wcslen( list.names[i] ) + 1) * sizeof(WCHAR);
+        *used = need;
+        if (!buffer || size < need)
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            ret = FALSE;
+        }
+        else
+        {
+            WCHAR **arr = (WCHAR **)(buffer + 1);
+            buffer->Type = EvtVarTypeString | EVT_VARIANT_TYPE_ARRAY;
+            buffer->Count = list.count;
+            buffer->StringArr = arr;
+            offset = sizeof(EVT_VARIANT) + list.count * sizeof(WCHAR *);
+            for (i = 0; i < list.count; i++)
+            {
+                arr[i] = (WCHAR *)((BYTE *)buffer + offset);
+                lstrcpyW( arr[i], list.names[i] );
+                offset += (wcslen( list.names[i] ) + 1) * sizeof(WCHAR);
+            }
+            ret = TRUE;
+        }
+        for (i = 0; i < list.count; i++) free( list.names[i] );
+        free( list.names );
+        release_object( &cfg->hdr );
+        return ret;
+    }
+    default:
+        release_object( &cfg->hdr );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    release_object( &cfg->hdr );
+    return return_variant( &var, strval, NULL, 0, size, buffer, used );
+}
+
+BOOL WINAPI EvtSetChannelConfigProperty( EVT_HANDLE handle, EVT_CHANNEL_CONFIG_PROPERTY_ID id, DWORD flags,
+                                         EVT_VARIANT *value )
+{
+    struct channel_config *cfg;
+    DWORD err = ERROR_SUCCESS;
+
+    TRACE( "(%p %u %#lx %p)\n", handle, id, flags, value );
+
+    if (!value || flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(cfg = (struct channel_config *)grab( handle, OBJ_CHANNEL_CONFIG ))) return FALSE;
+    switch (id)
+    {
+    case EvtChannelConfigEnabled:
+        if (value->Type != EvtVarTypeBoolean) { err = ERROR_EVT_INVALID_CHANNEL_PROPERTY_VALUE; break; }
+        cfg->set_enabled = TRUE;
+        cfg->enabled = value->BooleanVal != 0;
+        break;
+    case EvtChannelLoggingConfigRetention:
+        if (value->Type != EvtVarTypeBoolean) { err = ERROR_EVT_INVALID_CHANNEL_PROPERTY_VALUE; break; }
+        cfg->set_retention = TRUE;
+        cfg->retention = value->BooleanVal != 0;
+        break;
+    case EvtChannelLoggingConfigAutoBackup:
+        if (value->Type != EvtVarTypeBoolean) { err = ERROR_EVT_INVALID_CHANNEL_PROPERTY_VALUE; break; }
+        cfg->set_autobackup = TRUE;
+        cfg->autobackup = value->BooleanVal != 0;
+        break;
+    case EvtChannelLoggingConfigMaxSize:
+        if (value->Type != EvtVarTypeUInt64 || value->UInt64Val < 64 * 1024 || value->UInt64Val > 0xffffffff)
+        {
+            err = ERROR_EVT_INVALID_CHANNEL_PROPERTY_VALUE;
+            break;
+        }
+        cfg->set_maxsize = TRUE;
+        cfg->maxsize = value->UInt64Val;
+        break;
+    case EvtChannelLoggingConfigLogFilePath:
+        if (value->Type != EvtVarTypeString || !value->StringVal || !value->StringVal[0])
+        {
+            err = ERROR_EVT_INVALID_CHANNEL_PROPERTY_VALUE;
+            break;
+        }
+        free( cfg->file );
+        cfg->file = wcsdup( value->StringVal );
+        break;
+    case EvtChannelConfigAccess:
+    {
+        PSECURITY_DESCRIPTOR sd;
+        if (value->Type != EvtVarTypeString || !value->StringVal ||
+            !ConvertStringSecurityDescriptorToSecurityDescriptorW( value->StringVal, SDDL_REVISION_1, &sd, NULL ))
+        {
+            err = ERROR_EVT_INVALID_CHANNEL_PROPERTY_VALUE;
+            break;
+        }
+        LocalFree( sd );
+        free( cfg->access );
+        cfg->access = wcsdup( value->StringVal );
+        break;
+    }
+    case EvtChannelPublishingConfigLevel:
+        if (value->Type != EvtVarTypeUInt32) { err = ERROR_EVT_INVALID_CHANNEL_PROPERTY_VALUE; break; }
+        cfg->set_level = TRUE;
+        cfg->level = value->UInt32Val;
+        break;
+    case EvtChannelPublishingConfigKeywords:
+        if (value->Type != EvtVarTypeUInt64) { err = ERROR_EVT_INVALID_CHANNEL_PROPERTY_VALUE; break; }
+        cfg->set_keywords = TRUE;
+        cfg->keywords = value->UInt64Val;
+        break;
+    default:
+        /* the rest are the channel's own */
+        err = ERROR_INVALID_OPERATION;
+        break;
+    }
+    release_object( &cfg->hdr );
+    if (err) SetLastError( err );
+    return !err;
+}
+
+static LSTATUS set_value( const WCHAR *base, const WCHAR *channel, const WCHAR *name, DWORD type, const void *data,
+                          DWORD len )
+{
+    WCHAR path[512];
+    LSTATUS ret;
+    HKEY key;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", base, channel );
+    if ((ret = RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL ))) return ret;
+    ret = RegSetValueExW( key, name, 0, type, data, len );
+    RegCloseKey( key );
+    return ret;
+}
+
+BOOL WINAPI EvtSaveChannelConfig( EVT_HANDLE handle, DWORD flags )
+{
+    struct channel_config *cfg;
+    LSTATUS err = ERROR_SUCCESS;
+    DWORD value;
+
+    TRACE( "(%p %#lx)\n", handle, flags );
+
+    if (flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(cfg = (struct channel_config *)grab( handle, OBJ_CHANNEL_CONFIG ))) return FALSE;
+    if (cfg->set_enabled && !err)
+    {
+        value = cfg->enabled;
+        err = set_value( channels_keyW, cfg->name, L"Enabled", REG_DWORD, &value, sizeof(value) );
+    }
+    if (cfg->set_level && !err)
+        err = set_value( channels_keyW, cfg->name, L"Level", REG_DWORD, &cfg->level, sizeof(cfg->level) );
+    if (cfg->set_keywords && !err)
+    {
+        value = (DWORD)cfg->keywords;
+        err = set_value( channels_keyW, cfg->name, L"Keywords", REG_DWORD, &value, sizeof(value) );
+    }
+    if (cfg->classic)
+    {
+        if (cfg->set_retention && !err)
+        {
+            value = cfg->retention ? 0xffffffff : 0;
+            err = set_value( eventlog_keyW, cfg->name, L"Retention", REG_DWORD, &value, sizeof(value) );
+        }
+        if (cfg->set_autobackup && !err)
+        {
+            value = cfg->autobackup;
+            err = set_value( eventlog_keyW, cfg->name, L"AutoBackupLogFiles", REG_DWORD, &value, sizeof(value) );
+        }
+        if (cfg->set_maxsize && !err)
+        {
+            value = (DWORD)cfg->maxsize;
+            err = set_value( eventlog_keyW, cfg->name, L"MaxSize", REG_DWORD, &value, sizeof(value) );
+        }
+        if (cfg->file && !err)
+            err = set_value( eventlog_keyW, cfg->name, L"File", REG_EXPAND_SZ, cfg->file,
+                             (wcslen( cfg->file ) + 1) * sizeof(WCHAR) );
+        if (cfg->access && !err)
+            err = set_value( eventlog_keyW, cfg->name, L"CustomSD", REG_SZ, cfg->access,
+                             (wcslen( cfg->access ) + 1) * sizeof(WCHAR) );
+    }
+    release_object( &cfg->hdr );
+    if (err) SetLastError( err );
+    return !err;
+}
