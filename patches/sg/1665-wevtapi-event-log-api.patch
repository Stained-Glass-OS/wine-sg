+    struct xpath xp = {0};
+    struct value v;
+    int ret;
+
+    xp.p = filter;
+    next_token( &xp );
+    if (xp.tok == TOK_SLASH) next_token( &xp );
+    if (!eval_path( &xp, doc, &v ) || xp.error || xp.tok != TOK_END)
+    {
+        value_free( &v );
+        return -1;
+    }
+    ret = v.nodes.count > 0;
+    value_free( &v );
+    return ret;
+}
+
+/* a query is checked once, against an empty event */
+static BOOL xpath_valid( const WCHAR *filter )
+{
+    static const EVENTLOGRECORD empty = { sizeof(EVENTLOGRECORD) + 4 * sizeof(WCHAR) };
+    struct { EVENTLOGRECORD rec; WCHAR strings[4]; } blank;
+    struct event ev = {{0}};
+    struct xnode doc;
+    int ret;
+
+    memset( &blank, 0, sizeof(blank) );
+    blank.rec = empty;
+    ev.rec = &blank.rec;
+    build_event_doc( &ev, &doc );
+    ret = xpath_match( filter, &doc );
+    xfree( &doc );
+    return ret >= 0;
+}
+
+/* ---- queries ------------------------------------------------------------------- */
+
+struct select
+{
+    WCHAR *path;
+    WCHAR *filter;
+    BOOL suppress;
+};
+
+struct query_part
+{
+    DWORD id;
+    struct select *selects;
+    int count;
+};
+
+struct query_list
+{
+    struct query_part *parts;
+    int count;
+};
+
+static void free_query_list( struct query_list *ql )
+{
+    int i, j;
+
+    for (i = 0; i < ql->count; i++)
+    {
+        for (j = 0; j < ql->parts[i].count; j++)
+        {
+            free( ql->parts[i].selects[j].path );
+            free( ql->parts[i].selects[j].filter );
+        }
+        free( ql->parts[i].selects );
+    }
+    free( ql->parts );
+    memset( ql, 0, sizeof(*ql) );
+}
+
+static BOOL add_select( struct query_part *part, const WCHAR *path, const WCHAR *filter, BOOL suppress )
+{
+    struct select *selects = realloc( part->selects, (part->count + 1) * sizeof(*selects) );
+
+    if (!selects) return FALSE;
+    part->selects = selects;
+    selects[part->count].path = strdupW( path );
+    selects[part->count].filter = strdupW( filter && filter[0] ? filter : L"*" );
+    selects[part->count].suppress = suppress;
+    part->count++;
+    return TRUE;
+}
+
+/* a tiny reader for <QueryList> */
+static const WCHAR *skip_space( const WCHAR *p )
+{
+    while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
+    return p;
+}
+
+static void xml_unescape( WCHAR *str )
+{
+    static const struct { const WCHAR *ent; WCHAR c; } ents[] =
+    {
+        { L"&lt;", '<' }, { L"&gt;", '>' }, { L"&amp;", '&' }, { L"&quot;", '"' }, { L"&apos;", '\'' },
+    };
+    WCHAR *in = str, *out = str;
+    unsigned int i;
+
+    while (*in)
+    {
+        if (*in == '&')
+        {
+            for (i = 0; i < ARRAY_SIZE(ents); i++)
+                if (!wcsncmp( in, ents[i].ent, wcslen( ents[i].ent ) )) break;
+            if (i < ARRAY_SIZE(ents))
+            {
+                *out++ = ents[i].c;
+                in += wcslen( ents[i].ent );
+                continue;
+            }
+        }
+        *out++ = *in++;
+    }
+    *out = 0;
+}
+
+struct xml_tag
+{
+    WCHAR name[64];
+    WCHAR attr_names[4][32];
+    WCHAR attr_values[4][512];
+    int nattrs;
+    BOOL closing, empty;
+};
+
+/* the next tag from p; comments and declarations are skipped; the text
+ * before it is returned in text */
+static const WCHAR *next_tag( const WCHAR *p, struct xml_tag *tag, WCHAR *text, int text_size )
+{
+    const WCHAR *start;
+    int len;
+
+    for (;;)
+    {
+        start = p;
+        while (*p && *p != '<') p++;
+        if (text)
+        {
+            len = min( p - start, text_size - 1 );
+            memcpy( text, start, len * sizeof(WCHAR) );
+            text[len] = 0;
+        }
+        if (!*p) return NULL;
+        if (!wcsncmp( p, L"<!--", 4 ))
+        {
+            const WCHAR *end = wcsstr( p, L"-->" );
+            if (!end) return NULL;
+            p = end + 3;
+            continue;
+        }
+        if (p[1] == '?' || p[1] == '!')
+        {
+            while (*p && *p != '>') p++;
+            if (!*p) return NULL;
+            p++;
+            continue;
+        }
+        break;
+    }
+    memset( tag, 0, sizeof(*tag) );
+    p++;
+    if (*p == '/') { tag->closing = TRUE; p++; }
+    len = 0;
+    while (*p && !wcschr( L" \t\r\n/>", *p ))
+    {
+        if (len < ARRAY_SIZE(tag->name) - 1) tag->name[len++] = *p;
+        p++;
+    }
+    for (;;)
+    {
+        WCHAR quote;
+
+        p = skip_space( p );
+        if (!*p) return NULL;
+        if (*p == '/' && p[1] == '>') { tag->empty = TRUE; return p + 2; }
+        if (*p == '>') return p + 1;
+        len = 0;
+        while (*p && !wcschr( L" \t\r\n=/>", *p ))
+        {
+            if (tag->nattrs < 4 && len < 31) tag->attr_names[tag->nattrs][len++] = *p;
+            p++;
+        }
+        p = skip_space( p );
+        if (*p != '=') return NULL;
+        p = skip_space( p + 1 );
+        if (*p != '\'' && *p != '"') return NULL;
+        quote = *p++;
+        len = 0;
+        while (*p && *p != quote)
+        {
+            if (tag->nattrs < 4 && len < 511) tag->attr_values[tag->nattrs][len++] = *p;
+            p++;
+        }
+        if (!*p) return NULL;
+        p++;
+        if (tag->nattrs < 4)
+        {
+            xml_unescape( tag->attr_values[tag->nattrs] );
+            tag->nattrs++;
+        }
+    }
+}
+
+static const WCHAR *tag_attr( const struct xml_tag *tag, const WCHAR *name )
+{
+    int i;
+    for (i = 0; i < tag->nattrs; i++) if (!wcscmp( tag->attr_names[i], name )) return tag->attr_values[i];
+    return NULL;
+}
+
+static DWORD parse_query_list( const WCHAR *xml, struct query_list *ql )
+{
+    struct xml_tag tag;
+    WCHAR text[4096];
+    const WCHAR *p = xml, *query_path = NULL;
+    WCHAR query_path_buf[512];
+    struct query_part *part = NULL;
+
+    if (!(p = next_tag( p, &tag, NULL, 0 )) || tag.closing || wcscmp( tag.name, L"QueryList" ))
+        return ERROR_EVT_INVALID_QUERY;
+    if (tag.empty) return ERROR_EVT_INVALID_QUERY;
+    while ((p = next_tag( p, &tag, NULL, 0 )))
+    {
+        if (tag.closing && !wcscmp( tag.name, L"QueryList" )) break;
+        if (tag.closing && !wcscmp( tag.name, L"Query" )) { part = NULL; continue; }
+        if (!tag.closing && !wcscmp( tag.name, L"Query" ))
+        {
+            struct query_part *parts = realloc( ql->parts, (ql->count + 1) * sizeof(*parts) );
+            const WCHAR *id = tag_attr( &tag, L"Id" );
+
+            if (!parts) return ERROR_NOT_ENOUGH_MEMORY;
+            ql->parts = parts;
+            part = &parts[ql->count++];
+            memset( part, 0, sizeof(*part) );
+            part->id = id ? wcstoul( id, NULL, 10 ) : 0;
+            query_path = tag_attr( &tag, L"Path" );
+            if (query_path)
+            {
+                lstrcpynW( query_path_buf, query_path, ARRAY_SIZE(query_path_buf) );
+                query_path = query_path_buf;
+            }
+            if (tag.empty) part = NULL;
+            continue;
+        }
+        if (!tag.closing && part && (!wcscmp( tag.name, L"Select" ) || !wcscmp( tag.name, L"Suppress" )))
+        {
+            BOOL suppress = !wcscmp( tag.name, L"Suppress" );
+            const WCHAR *path = tag_attr( &tag, L"Path" );
+            WCHAR path_buf[512];
+            struct xml_tag end;
+
+            lstrcpynW( path_buf, path ? path : (query_path ? query_path : L""), ARRAY_SIZE(path_buf) );
+            text[0] = 0;
+            if (!tag.empty)
+            {
+                if (!(p = next_tag( p, &end, text, ARRAY_SIZE(text) )) || !end.closing) return ERROR_EVT_INVALID_QUERY;
+                xml_unescape( text );
+            }
+            if (!path_buf[0]) return ERROR_EVT_INVALID_QUERY;
+            if (!add_select( part, path_buf, skip_space( text ), suppress )) return ERROR_NOT_ENOUGH_MEMORY;
+            continue;
+        }
+        return ERROR_EVT_INVALID_QUERY;
+    }
+    if (!p || !ql->count) return ERROR_EVT_INVALID_QUERY;
+    return ERROR_SUCCESS;
+}
+
+/* the query as a list: a <QueryList>, or one XPath over the path given */
+static DWORD build_query_list( const WCHAR *path, const WCHAR *query, BOOL file, struct query_list *ql )
+{
+    WCHAR buf[MAX_PATH + 8];
+    DWORD err;
+    int i, j;
+
+    memset( ql, 0, sizeof(*ql) );
+    if (query && *skip_space( query ) == '<')
+    {
+        if ((err = parse_query_list( skip_space( query ), ql )))
+        {
+            free_query_list( ql );
+            return err;
+        }
+    }
+    else
+    {
+        if (!path || !path[0]) return ERROR_EVT_INVALID_QUERY;
+        if (!(ql->parts = calloc( 1, sizeof(*ql->parts) ))) return ERROR_NOT_ENOUGH_MEMORY;
+        ql->count = 1;
+        if (file)
+        {
+            swprintf( buf, ARRAY_SIZE(buf), L"file://%s", path );
+            path = buf;
+        }
+        if (!add_select( &ql->parts[0], path, query, FALSE ))
+        {
+            free_query_list( ql );
+            return ERROR_NOT_ENOUGH_MEMORY;
+        }
+    }
+    for (i = 0; i < ql->count; i++)
+        for (j = 0; j < ql->parts[i].count; j++)
+            if (!xpath_valid( ql->parts[i].selects[j].filter ))
+            {
+                WARN( "bad query %s\n", debugstr_w( ql->parts[i].selects[j].filter ) );
+                free_query_list( ql );
+                return ERROR_EVT_INVALID_QUERY;
+            }
+    return ERROR_SUCCESS;
+}
+
+/* does the query part select the event (read from path)? */
+static BOOL part_matches( const struct query_part *part, const WCHAR *path, struct xnode *doc )
+{
+    BOOL selected = FALSE;
+    int i;
+
+    for (i = 0; i < part->count; i++)
+    {
+        const struct select *sel = &part->selects[i];
+        if (wcsicmp( sel->path, path )) continue;
+        if (xpath_match( sel->filter, doc ) <= 0) continue;
+        if (sel->suppress) return FALSE;
+        selected = TRUE;
+    }
+    return selected;
+}
+
+/* ---- reading logs -------------------------------------------------------------------- */
+
+/* the path a select names: a channel, or "file://" and a file */
+static BOOL is_file_path( const WCHAR *path, const WCHAR **file )
+{
+    if (wcsnicmp( path, L"file://", 7 )) return FALSE;
+    *file = path + 7;
+    return TRUE;
+}
+
+typedef BOOL (*record_cb)( const EVENTLOGRECORD *rec, void *ctx );
+
+/* every record of a log or backup file, oldest first; from_record: only
+ * those from that number on */
+static DWORD read_records( const WCHAR *path, DWORD from_record, record_cb cb, void *ctx )
+{
+    const WCHAR *file;
+    DWORD size = 0x10000, read, needed, err = ERROR_SUCCESS, flags;
+    BYTE *buf;
+    HANDLE log;
+    BOOL classic, more = TRUE;
+    WCHAR name[256];
+
+    if (is_file_path( path, &file )) log = OpenBackupEventLogW( NULL, file );
+    else
+    {
+        if (!find_channel( path, name, ARRAY_SIZE(name), &classic )) return ERROR_EVT_CHANNEL_NOT_FOUND;
+        if (!classic) return ERROR_SUCCESS;    /* no records of its own */
+        log = OpenEventLogW( NULL, name );
+    }
+    if (!log) return GetLastError();
+    if (!(buf = malloc( size )))
+    {
+        CloseEventLog( log );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    flags = from_record ? EVENTLOG_SEEK_READ | EVENTLOG_FORWARDS_READ : EVENTLOG_SEQUENTIAL_READ | EVENTLOG_FORWARDS_READ;
+    while (more)
+    {
+        BYTE *p;
+
+        if (!ReadEventLogW( log, flags, from_record, buf, size, &read, &needed ))
+        {
+            err = GetLastError();
+            if (err == ERROR_INSUFFICIENT_BUFFER)
+            {
+                BYTE *bigger = realloc( buf, needed );
+                if (!bigger) { err = ERROR_NOT_ENOUGH_MEMORY; break; }
+                buf = bigger;
+                size = needed;
+                err = ERROR_SUCCESS;
+                continue;
+            }
+            if (err == ERROR_HANDLE_EOF || (from_record && err == ERROR_INVALID_PARAMETER)) err = ERROR_SUCCESS;
+            break;
+        }
+        flags = EVENTLOG_SEQUENTIAL_READ | EVENTLOG_FORWARDS_READ;
+        for (p = buf; p < buf + read && more; p += ((EVENTLOGRECORD *)p)->Length)
+        {
+            if (((EVENTLOGRECORD *)p)->Length < sizeof(EVENTLOGRECORD)) { more = FALSE; break; }
+            more = cb( (EVENTLOGRECORD *)p, ctx );
+        }
+    }
+    free( buf );
+    CloseEventLog( log );
+    return err;
+}
+
+/* ---- result sets ---------------------------------------------------------------------- */
+
+struct result_set
+{
+    struct object hdr;
+    struct event **events;
+    DWORD count, size;
+    LONGLONG pos;               /* the next event EvtNext returns */
+    WCHAR **names;              /* EvtGetQueryInfo */
+    DWORD *statuses;
+    DWORD npaths;
+    BOOL reverse;
+};
+
+static void destroy_result_set( struct object *obj )
+{
+    struct result_set *rs = (struct result_set *)obj;
+    DWORD i;
+
+    for (i = 0; i < rs->count; i++) release_object( &rs->events[i]->hdr );
+    for (i = 0; i < rs->npaths; i++) free( rs->names[i] );
+    free( rs->names );
+    free( rs->statuses );
+    free( rs->events );
+    free( rs );
+}
+
+static BOOL rs_add( struct result_set *rs, struct event *ev )
+{
+    if (rs->count == rs->size)
+    {
+        DWORD size = rs->size ? rs->size * 2 : 64;
+        struct event **events = realloc( rs->events, size * sizeof(*events) );
+        if (!events) return FALSE;
+        rs->events = events;
+        rs->size = size;
+    }
+    rs->events[rs->count++] = ev;
+    return TRUE;
+}
+
+struct collect_ctx
+{
+    struct result_set *rs;
+    const struct query_list *ql;
+    const WCHAR *path;          /* as the query names it */
+    const WCHAR *name;          /* the channel or file */
+    BOOL file;
+    DWORD after;                /* only records after this number */
+    struct event **found;       /* or into this array (subscriptions) */
+    DWORD nfound, sizefound;
+    DWORD last;
+};
+
+static BOOL collect_record( const EVENTLOGRECORD *rec, void *arg )
+{
+    struct collect_ctx *ctx = arg;
+    struct event probe = {{0}}, *ev;
+    struct xnode doc;
+    int i;
+
+    ctx->last = max( ctx->last, rec->RecordNumber );
+    if (rec->RecordNumber <= ctx->after) return TRUE;
+    probe.rec = (EVENTLOGRECORD *)rec;
+    lstrcpynW( probe.channel, ctx->name, ARRAY_SIZE(probe.channel) );
+    probe.from_file = ctx->file;
+    build_event_doc( &probe, &doc );
+    for (i = 0; i < ctx->ql->count; i++)
+        if (part_matches( &ctx->ql->parts[i], ctx->path, &doc )) break;
+    xfree( &doc );
+    if (i == ctx->ql->count) return TRUE;
+    if (!(ev = create_event( ctx->name, ctx->file, rec, ctx->ql->parts[i].id ))) return FALSE;
+    if (ctx->rs)
+    {
+        if (!rs_add( ctx->rs, ev )) { release_object( &ev->hdr ); return FALSE; }
+    }
+    else
+    {
+        if (ctx->nfound == ctx->sizefound)
+        {
+            DWORD size = ctx->sizefound ? ctx->sizefound * 2 : 16;
+            struct event **found = realloc( ctx->found, size * sizeof(*found) );
+            if (!found) { release_object( &ev->hdr ); return FALSE; }
+            ctx->found = found;
+            ctx->sizefound = size;
+        }
+        ctx->found[ctx->nfound++] = ev;
+    }
+    return TRUE;
+}
+
+/* the distinct paths of a query list */
+static DWORD query_paths( const struct query_list *ql, WCHAR ***paths )
+{
+    DWORD n = 0, k;
+    int i, j;
+
+    *paths = NULL;
+    for (i = 0; i < ql->count; i++)
+        for (j = 0; j < ql->parts[i].count; j++)
+        {
+            WCHAR **more;
+            for (k = 0; k < n; k++) if (!wcsicmp( (*paths)[k], ql->parts[i].selects[j].path )) break;
+            if (k < n) continue;
+            if (!(more = realloc( *paths, (n + 1) * sizeof(*more) ))) return n;
+            *paths = more;
+            (*paths)[n++] = ql->parts[i].selects[j].path;
+        }
+    return n;
+}
+
+static int __cdecl cmp_events( const void *a, const void *b )
+{
+    const struct event *x = *(struct event *const *)a, *y = *(struct event *const *)b;
+    ULONGLONG tx = event_time( x->rec ), ty = event_time( y->rec );
+    if (tx != ty) return tx < ty ? -1 : 1;
+    return x->rec->RecordNumber < y->rec->RecordNumber ? -1 : x->rec->RecordNumber > y->rec->RecordNumber;
+}
+
+static struct result_set *run_query( const WCHAR *path, const WCHAR *query, DWORD flags, DWORD *error )
+{
+    struct query_list ql;
+    struct result_set *rs;
+    WCHAR **paths, name[MAX_PATH];
+    DWORD n, i, err, first_error = 0;
+    const WCHAR *file;
+
+    *error = build_query_list( path, query, flags & EvtQueryFilePath, &ql );
+    if (*error) return NULL;
+    if (!(rs = alloc_object( sizeof(*rs), OBJ_QUERY, destroy_result_set )))
+    {
+        free_query_list( &ql );
+        *error = ERROR_NOT_ENOUGH_MEMORY;
+        return NULL;
+    }
+    n = query_paths( &ql, &paths );
+    rs->names = calloc( max( n, 1 ), sizeof(WCHAR *) );
+    rs->statuses = calloc( max( n, 1 ), sizeof(DWORD) );
+    rs->npaths = n;
+    for (i = 0; i < n; i++)
+    {
+        struct collect_ctx ctx = { rs, &ql, paths[i] };
+        BOOL classic;
+
+        if (rs->names) rs->names[i] = strdupW( is_file_path( paths[i], &file ) ? file : paths[i] );
+        ctx.file = is_file_path( paths[i], &file );
+        if (ctx.file) ctx.name = file;
+        else if (find_channel( paths[i], name, ARRAY_SIZE(name), &classic )) ctx.name = name;
+        else ctx.name = paths[i];
+        err = read_records( paths[i], 0, collect_record, &ctx );
+        if (rs->statuses) rs->statuses[i] = err;
+        if (err && !first_error) first_error = err;
+    }
+    free( paths );
+    free_query_list( &ql );
+#ifdef SG_MUTANT_QUERY_NOTHING
+    while (rs->count) release_object( &rs->events[--rs->count]->hdr );
+#endif
+    if (first_error && !(flags & EvtQueryTolerateQueryErrors))
+    {
+        release_object( &rs->hdr );
+        *error = first_error;
+        return NULL;
+    }
+    /* several logs: in time order */
+    if (n > 1 && rs->count) qsort( rs->events, rs->count, sizeof(*rs->events), cmp_events );
+    if (flags & EvtQueryReverseDirection)
+    {
+        DWORD a, b;
+        rs->reverse = TRUE;
+        for (a = 0, b = rs->count ? rs->count - 1 : 0; a < b; a++, b--)
+        {
+            struct event *t = rs->events[a];
+            rs->events[a] = rs->events[b];
+            rs->events[b] = t;
+        }
+    }
+    return rs;
+}
+
+EVT_HANDLE WINAPI EvtQuery( EVT_HANDLE session, const WCHAR *path, const WCHAR *query, DWORD flags )
+{
+    struct result_set *rs;
+    DWORD err;
+
+    TRACE( "(%p %s %s %#lx)\n", session, debugstr_w( path ), debugstr_w( query ), flags );
+
+    if (!check_session( session )) return NULL;
+    if ((flags & (EvtQueryChannelPath | EvtQueryFilePath)) == (EvtQueryChannelPath | EvtQueryFilePath) ||
+        (flags & (EvtQueryForwardDirection | EvtQueryReverseDirection)) ==
+        (EvtQueryForwardDirection | EvtQueryReverseDirection) ||
+        (flags & ~(EvtQueryChannelPath | EvtQueryFilePath | EvtQueryForwardDirection | EvtQueryReverseDirection |
+                   EvtQueryTolerateQueryErrors)))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (!(rs = run_query( path, query, flags, &err )))
+    {
+        SetLastError( err );
+        return NULL;
+    }
+    return alloc_handle( &rs->hdr );
+}
+
+/* ---- subscriptions ------------------------------------------------------------------- */
+
+struct subscription
+{
+    struct object hdr;
+    CRITICAL_SECTION cs;
+    struct query_list ql;
+    WCHAR **paths;
+    DWORD *last;                /* per path: the last record seen */
+    DWORD npaths;
+    HANDLE signal;              /* pull: set while events wait */
+    EVT_SUBSCRIBE_CALLBACK callback;
+    void *context;
+    struct event **queue;
+    DWORD queued, queue_size;
+    HANDLE stop, thread;
+    DWORD thread_id;
+};
+
+static void destroy_subscription( struct object *obj )
+{
+    struct subscription *sub = (struct subscription *)obj;
+    DWORD i;
+
+    for (i = 0; i < sub->queued; i++) release_object( &sub->queue[i]->hdr );
+    free( sub->queue );
+    free( sub->paths );
+    free( sub->last );
+    free_query_list( &sub->ql );
+    if (sub->stop) CloseHandle( sub->stop );
+    if (sub->thread) CloseHandle( sub->thread );
+    sub->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &sub->cs );
+    free( sub );
+}
+
+static DWORD log_last_record( const WCHAR *path )
+{
+    DWORD oldest = 0, count = 0;
+    WCHAR name[256];
+    BOOL classic;
+    HANDLE log;
+
+    if (!find_channel( path, name, ARRAY_SIZE(name), &classic ) || !classic) return 0;
+    if (!(log = OpenEventLogW( NULL, name ))) return 0;
+    GetOldestEventLogRecord( log, &oldest );
+    GetNumberOfEventLogRecords( log, &count );
+    CloseEventLog( log );
+    return count ? oldest + count - 1 : 0;
+}
+
+/* new records of the subscription's channels go to it */
+static void poll_subscription( struct subscription *sub )
+{
+    DWORD i, j;
+
+    for (i = 0; i < sub->npaths; i++)
+    {
+        struct collect_ctx ctx = { NULL, &sub->ql, sub->paths[i] };
+        WCHAR name[256];
+        BOOL classic;
+
+        if (!find_channel( sub->paths[i], name, ARRAY_SIZE(name), &classic ) || !classic) continue;
+        ctx.name = name;
+        ctx.after = sub->last[i];
+        ctx.last = sub->last[i];
+        read_records( sub->paths[i], sub->last[i] ? sub->last[i] + 1 : 0, collect_record, &ctx );
+        /* a cleared log starts again from where it is */
+        if (!ctx.nfound && ctx.last == sub->last[i] && log_last_record( sub->paths[i] ) < sub->last[i])
+            sub->last[i] = log_last_record( sub->paths[i] );
+        else sub->last[i] = ctx.last;
+        for (j = 0; j < ctx.nfound; j++)
+        {
+            if (sub->callback)
+            {
+                EVT_HANDLE h = alloc_handle( &ctx.found[j]->hdr );
+                if (h)
+                {
+                    sub->callback( EvtSubscribeActionDeliver, sub->context, h );
+                    EvtClose( h );
+                }
+                continue;
+            }
+            EnterCriticalSection( &sub->cs );
+            if (sub->queued == sub->queue_size)
+            {
+                DWORD size = sub->queue_size ? sub->queue_size * 2 : 16;
+                struct event **queue = realloc( sub->queue, size * sizeof(*queue) );
+                if (queue)
+                {
+                    sub->queue = queue;
+                    sub->queue_size = size;
+                }
+            }
+            if (sub->queued < sub->queue_size) sub->queue[sub->queued++] = ctx.found[j];
+            else release_object( &ctx.found[j]->hdr );
+            if (sub->signal) SetEvent( sub->signal );
+            LeaveCriticalSection( &sub->cs );
+        }
+        free( ctx.found );
+    }
+}
+
+static DWORD WINAPI subscription_thread( void *arg )
+{
+    struct subscription *sub = arg;
+    HANDLE waits[MAXIMUM_WAIT_OBJECTS], logs[MAXIMUM_WAIT_OBJECTS];
+    DWORD nwaits = 1, i;
+    WCHAR name[256];
+    BOOL classic;
+
+    SetThreadDescription( GetCurrentThread(), L"wevtapi_subscription" );
+    waits[0] = sub->stop;
+    for (i = 0; i < sub->npaths && nwaits < MAXIMUM_WAIT_OBJECTS; i++)
+    {
+        if (!find_channel( sub->paths[i], name, ARRAY_SIZE(name), &classic ) || !classic) continue;
+        if (!(logs[nwaits] = OpenEventLogW( NULL, name ))) continue;
+        waits[nwaits] = CreateEventW( NULL, FALSE, FALSE, NULL );
+        if (!waits[nwaits] || !NotifyChangeEventLog( logs[nwaits], waits[nwaits] ))
+        {
+            if (waits[nwaits]) CloseHandle( waits[nwaits] );
+            CloseEventLog( logs[nwaits] );
+            continue;
+        }
+        nwaits++;
+    }
+#ifdef SG_MUTANT_NO_SUBSCRIPTION
+    WaitForSingleObject( sub->stop, INFINITE );
+#endif
+    /* what is there already (from the oldest, or after a bookmark) */
+    poll_subscription( sub );
+    for (;;)
+    {
+        /* a change, else a look every few seconds */
+        DWORD ret = WaitForMultipleObjects( nwaits, waits, FALSE, 3000 );
+        if (ret == WAIT_OBJECT_0) break;
+        poll_subscription( sub );
+    }
+    for (i = 1; i < nwaits; i++)
+    {
+        CloseEventLog( logs[i] );
+        CloseHandle( waits[i] );
+    }
+    release_object( &sub->hdr );
+    return 0;
+}
+
+struct bookmark
+{
+    struct object hdr;
+    WCHAR channel[256];
+    DWORD record;
+};
+
+EVT_HANDLE WINAPI EvtSubscribe( EVT_HANDLE session, HANDLE signal, const WCHAR *path, const WCHAR *query,
+                                EVT_HANDLE bookmark, void *context, EVT_SUBSCRIBE_CALLBACK callback, DWORD flags )
+{
+    struct subscription *sub;
+    struct bookmark *bm = NULL;
+    EVT_HANDLE handle;
+    DWORD err, i, origin = flags & EvtSubscribeOriginMask;
+    const WCHAR *file;
+
+    TRACE( "(%p %p %s %s %p %p %p %#lx)\n", session, signal, debugstr_w( path ), debugstr_w( query ), bookmark,
+           context, callback, flags );
+
+    if (!check_session( session )) return NULL;
+    if ((!signal && !callback) || (signal && callback) || !origin ||
+        (origin == EvtSubscribeStartAfterBookmark) != !!bookmark ||
+        (flags & ~(EvtSubscribeOriginMask | EvtSubscribeTolerateQueryErrors | EvtSubscribeStrict)))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (bookmark && !(bm = (struct bookmark *)grab( bookmark, OBJ_BOOKMARK ))) return NULL;
+    if (!(sub = alloc_object( sizeof(*sub), OBJ_SUBSCRIPTION, destroy_subscription )))
+    {
+        release_object( &bm->hdr );
+        return NULL;
+    }
+    InitializeCriticalSectionEx( &sub->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    sub->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": subscription.cs");
+    sub->signal = signal;
+    sub->callback = callback;
+    sub->context = context;
+    if ((err = build_query_list( path, query, FALSE, &sub->ql ))) goto failed;
+    sub->npaths = query_paths( &sub->ql, &sub->paths );
+    sub->last = calloc( max( sub->npaths, 1 ), sizeof(DWORD) );
+    for (i = 0; i < sub->npaths; i++)
+    {
+        if (is_file_path( sub->paths[i], &file )) { err = ERROR_EVT_SUBSCRIPTION_TO_DIRECT_CHANNEL; goto failed; }
+        if (!find_channel( sub->paths[i], NULL, 0, NULL ))
+        {
+            if (flags & EvtSubscribeTolerateQueryErrors) continue;
+            err = ERROR_EVT_CHANNEL_NOT_FOUND;
+            goto failed;
+        }
+        if (origin == EvtSubscribeToFutureEvents) sub->last[i] = log_last_record( sub->paths[i] );
+        else if (origin == EvtSubscribeStartAfterBookmark)
+        {
+            if (!wcsicmp( bm->channel, sub->paths[i] )) sub->last[i] = bm->record;
+            else if (flags & EvtSubscribeStrict) { err = ERROR_NOT_FOUND; goto failed; }
+            else sub->last[i] = log_last_record( sub->paths[i] );
+        }
+    }
+    if (bm && (flags & EvtSubscribeStrict) && bm->record > log_last_record( bm->channel ))
+    {
+        err = ERROR_NOT_FOUND;
+        goto failed;
+    }
+    release_object( &bm->hdr );
+    bm = NULL;
+    if (!(sub->stop = CreateEventW( NULL, TRUE, FALSE, NULL ))) { err = GetLastError(); goto failed; }
+    InterlockedIncrement( &sub->hdr.refs );     /* the thread's */
+    if (!(sub->thread = CreateThread( NULL, 0, subscription_thread, sub, 0, &sub->thread_id )))
+    {
+        err = GetLastError();
+        InterlockedDecrement( &sub->hdr.refs );
+        goto failed;
+    }
+    if (!(handle = alloc_handle( &sub->hdr ))) SetEvent( sub->stop );
+    return handle;
+
+failed:
+    if (bm) release_object( &bm->hdr );
+    release_object( &sub->hdr );
+    SetLastError( err );
+    return NULL;
+}
+
+/* ---- EvtNext, EvtSeek, EvtClose ------------------------------------------------------ */
+
+BOOL WINAPI EvtNext( EVT_HANDLE handle, DWORD size, EVT_HANDLE *array, DWORD timeout, DWORD flags, DWORD *returned )
+{
+    struct object *obj;
+    DWORD n = 0;
+
+    TRACE( "(%p %lu %p %lu %#lx %p)\n", handle, size, array, timeout, flags, returned );
+
+    if (!array || !returned || !size || flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *returned = 0;
+    if (!(obj = grab( handle, 0 ))) return FALSE;
+    if (obj->type == OBJ_QUERY)
+    {
+        struct result_set *rs = (struct result_set *)obj;
+
+        while (n < size && rs->pos >= 0 && rs->pos < rs->count)
+        {
+            struct event *ev = rs->events[rs->pos];
+            InterlockedIncrement( &ev->hdr.refs );
+            if (!(array[n] = alloc_handle( &ev->hdr ))) break;
+            n++;
+            rs->pos++;
+        }
+    }
+    else if (obj->type == OBJ_SUBSCRIPTION)
+    {
+        struct subscription *sub = (struct subscription *)obj;
+
+        if (sub->callback)
+        {
+            release_object( obj );
+            SetLastError( ERROR_INVALID_OPERATION );
+            return FALSE;
+        }
+        EnterCriticalSection( &sub->cs );
+        while (n < size && n < sub->queued)
+        {
+            if (!(array[n] = alloc_handle( &sub->queue[n]->hdr ))) break;
+            n++;
+        }
+        memmove( sub->queue, sub->queue + n, (sub->queued - n) * sizeof(*sub->queue) );
+        sub->queued -= n;
+        if (!sub->queued && sub->signal) ResetEvent( sub->signal );
+        LeaveCriticalSection( &sub->cs );
+    }
+    else
+    {
+        release_object( obj );
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    release_object( obj );
+    *returned = n;
+    if (!n)
+    {
+        SetLastError( ERROR_NO_MORE_ITEMS );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+BOOL WINAPI EvtSeek( EVT_HANDLE handle, LONGLONG position, EVT_HANDLE bookmark, DWORD timeout, DWORD flags )
+{
+    struct result_set *rs;
+    struct bookmark *bm;
+    LONGLONG base, target;
+    DWORD i;
+
+    TRACE( "(%p %s %p %lu %#lx)\n", handle, wine_dbgstr_longlong( position ), bookmark, timeout, flags );
+
+    if (!(rs = (struct result_set *)grab( handle, OBJ_QUERY ))) return FALSE;
+    switch (flags & EvtSeekOriginMask)
+    {
+    case EvtSeekRelativeToFirst: base = 0; break;
+    case EvtSeekRelativeToLast: base = (LONGLONG)rs->count - 1; break;
+    case EvtSeekRelativeToCurrent: base = rs->pos - 1; break;
+    case EvtSeekRelativeToBookmark:
+        if (!(bm = (struct bookmark *)grab( bookmark, OBJ_BOOKMARK )))
+        {
+            release_object( &rs->hdr );
+            return FALSE;
+        }
+        for (i = 0; i < rs->count; i++)
+            if (rs->events[i]->rec->RecordNumber == bm->record && !wcsicmp( rs->events[i]->channel, bm->channel ))
+                break;
+        release_object( &bm->hdr );
+        if (i == rs->count)
+        {
+            release_object( &rs->hdr );
+            SetLastError( ERROR_NOT_FOUND );
+            return FALSE;
+        }
+        base = i;
+        break;
+    default:
+        release_object( &rs->hdr );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    target = base + position;
+    if (target < 0 || target > (LONGLONG)rs->count)
+    {
+        if (flags & EvtSeekStrict)
+        {
+            release_object( &rs->hdr );
+            SetLastError( ERROR_NOT_FOUND );
+            return FALSE;
+        }
+        target = target < 0 ? 0 : rs->count;
+    }
+    /* the next EvtNext returns the event sought */
+    rs->pos = target;
+    release_object( &rs->hdr );
+    return TRUE;
+}
+
+BOOL WINAPI EvtClose( EVT_HANDLE handle )
+{
+    ULONG_PTR h = (ULONG_PTR)handle;
+    struct object *obj = NULL;
+    DWORD i;
+
+    TRACE( "(%p)\n", handle );
+
+    if (!handle)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    if (h > HANDLE_BASE && !(h & 3))
+    {
+        i = (h - HANDLE_BASE) / 4 - 1;
+        EnterCriticalSection( &handle_cs );
+        if (i < handles_size && (obj = handles[i])) handles[i] = NULL;
+        LeaveCriticalSection( &handle_cs );
+    }
+    if (!obj)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    if (obj->type == OBJ_SUBSCRIPTION)
+    {
+        struct subscription *sub = (struct subscription *)obj;
+        SetEvent( sub->stop );
+        /* not from its own callback */
+        if (GetCurrentThreadId() != sub->thread_id) WaitForSingleObject( sub->thread, 10000 );
+    }
+    release_object( obj );
+    return TRUE;
+}
+
+BOOL WINAPI EvtCancel( EVT_HANDLE handle )
+{
+    struct object *obj;
+
+    TRACE( "(%p)\n", handle );
+
+    /* nothing here waits on a remote party: there is nothing to cancel */
+    if (!handle) return TRUE;
+    if (!(obj = grab( handle, 0 ))) return FALSE;
+    release_object( obj );
+    return TRUE;
+}
+
+/* ---- rendering --------------------------------------------------------------------- */
+
+struct render_context
+{
+    struct object hdr;
+    DWORD flags;
+    WCHAR **paths;
+    DWORD count;
+};
+
+static void destroy_context( struct object *obj )
+{
+    struct render_context *ctx = (struct render_context *)obj;
+    DWORD i;
+
+    for (i = 0; i < ctx->count; i++) free( ctx->paths[i] );
+    free( ctx->paths );
+    free( ctx );
+}
+
+EVT_HANDLE WINAPI EvtCreateRenderContext( DWORD count, const WCHAR **paths, DWORD flags )
+{
+    struct render_context *ctx;
+    DWORD i;
+
+    TRACE( "(%lu %p %#lx)\n", count, paths, flags );
+
+    if (flags > EvtRenderContextUser || (flags == EvtRenderContextValues && count && !paths) ||
+        (flags != EvtRenderContextValues && count))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    for (i = 0; i < count; i++)
+        if (!paths[i] || !xpath_valid( paths[i] ))
+        {
+            SetLastError( ERROR_EVT_INVALID_QUERY );
+            return NULL;
+        }
+    if (!(ctx = alloc_object( sizeof(*ctx), OBJ_CONTEXT, destroy_context ))) return NULL;
+    ctx->flags = flags;
+    if (count && !(ctx->paths = calloc( count, sizeof(WCHAR *) )))
+    {
+        free( ctx );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    for (i = 0; i < count; i++) ctx->paths[i] = strdupW( paths[i] );
+    ctx->count = count;
+    return alloc_handle( &ctx->hdr );
+}
+
+/* values are laid out as an array of EVT_VARIANTs followed by their data */
+struct value_writer
+{
+    EVT_VARIANT *vars;
+    DWORD count;
+    BYTE *buf;
+    DWORD size, used;
+};
+
+static void *vw_data( struct value_writer *vw, DWORD len, DWORD align )
+{
+    void *ret = NULL;
+
+    vw->used = (vw->used + align - 1) & ~(align - 1);
+    if (vw->buf && vw->used + len <= vw->size) ret = vw->buf + vw->used;
+    vw->used += len;
+    return ret;
+}
+
+static void vw_string( struct value_writer *vw, EVT_VARIANT *var, const WCHAR *str )
+{
+    DWORD len = (wcslen( str ) + 1) * sizeof(WCHAR);
+    WCHAR *dst = vw_data( vw, len, sizeof(WCHAR) );
+
+    if (!var) return;
+    var->Type = EvtVarTypeString;
+    var->StringVal = dst;
+    if (dst) memcpy( dst, str, len );
+}
+
+static void vw_sid( struct value_writer *vw, EVT_VARIANT *var, PSID sid )
+{
+    DWORD len = GetLengthSid( sid );
+    BYTE *dst = vw_data( vw, len, sizeof(DWORD) );
+
+    if (!var) return;
+    var->Type = EvtVarTypeSid;
+    var->SidVal = dst;
+    if (dst) CopySid( len, dst, sid );
+}
+
+/* one system property */
+static void system_value( struct value_writer *vw, EVT_VARIANT *var, const struct event *ev, DWORD id )
+{
+    const EVENTLOGRECORD *rec = ev->rec;
+    EVT_VARIANT dummy;
+
+    if (!var) var = &dummy;
+    var->Type = EvtVarTypeNull;
+    switch (id)
+    {
+    case EvtSystemProviderName: vw_string( vw, var == &dummy ? NULL : var, rec_source( rec ) ); break;
+    case EvtSystemEventID: var->Type = EvtVarTypeUInt16; var->UInt16Val = LOWORD(rec->EventID); break;
+    case EvtSystemQualifiers: var->Type = EvtVarTypeUInt16; var->UInt16Val = HIWORD(rec->EventID); break;
+    case EvtSystemLevel: var->Type = EvtVarTypeByte; var->ByteVal = event_level( rec ); break;
+    case EvtSystemTask: var->Type = EvtVarTypeUInt16; var->UInt16Val = rec->EventCategory; break;
+    case EvtSystemOpcode: var->Type = EvtVarTypeByte; var->ByteVal = 0; break;
+    case EvtSystemKeywords: var->Type = EvtVarTypeHexInt64; var->UInt64Val = event_keywords( rec ); break;
+    case EvtSystemTimeCreated: var->Type = EvtVarTypeFileTime; var->FileTimeVal = event_time( rec ); break;
+    case EvtSystemEventRecordId: var->Type = EvtVarTypeUInt64; var->UInt64Val = rec->RecordNumber; break;
+    case EvtSystemProcessID: var->Type = EvtVarTypeUInt32; var->UInt32Val = 0; break;
+    case EvtSystemThreadID: var->Type = EvtVarTypeUInt32; var->UInt32Val = 0; break;
+    case EvtSystemChannel:
+        if (!ev->from_file) vw_string( vw, var == &dummy ? NULL : var, ev->channel );
+        break;
+    case EvtSystemComputer: vw_string( vw, var == &dummy ? NULL : var, rec_computer( rec ) ); break;
+    case EvtSystemUserID:
+        if (rec_sid( rec )) vw_sid( vw, var == &dummy ? NULL : var, rec_sid( rec ) );
+        break;
+    case EvtSystemVersion: var->Type = EvtVarTypeByte; var->ByteVal = 0; break;
+    default: break;     /* ProviderGuid, ActivityID, RelatedActivityID: none */
+    }
+}
+
+/* the system property an XPath names, or -1 */
+static int system_path_id( const WCHAR *path )
+{
+    static const struct { const WCHAR *path; int id; } map[] =
+    {
+        { L"Event/System/Provider/@Name", EvtSystemProviderName },
+        { L"Event/System/Provider/@Guid", EvtSystemProviderGuid },
+        { L"Event/System/EventID", EvtSystemEventID },
+        { L"Event/System/EventID/@Qualifiers", EvtSystemQualifiers },
+        { L"Event/System/Level", EvtSystemLevel },
+        { L"Event/System/Task", EvtSystemTask },
+        { L"Event/System/Opcode", EvtSystemOpcode },
+        { L"Event/System/Keywords", EvtSystemKeywords },
+        { L"Event/System/TimeCreated/@SystemTime", EvtSystemTimeCreated },
+        { L"Event/System/EventRecordID", EvtSystemEventRecordId },
+        { L"Event/System/Correlation/@ActivityID", EvtSystemActivityID },
+        { L"Event/System/Correlation/@RelatedActivityID", EvtSystemRelatedActivityID },
+        { L"Event/System/Execution/@ProcessID", EvtSystemProcessID },
+        { L"Event/System/Execution/@ThreadID", EvtSystemThreadID },
+        { L"Event/System/Channel", EvtSystemChannel },
+        { L"Event/System/Computer", EvtSystemComputer },
+        { L"Event/System/Security/@UserID", EvtSystemUserID },
+        { L"Event/System/Version", EvtSystemVersion },
+    };
+    unsigned int i;
+
+    if (*path == '/') path++;
+    for (i = 0; i < ARRAY_SIZE(map); i++) if (!wcscmp( map[i].path, path )) return map[i].id;
+    return -1;
+}
+
+static BOOL render_values( struct render_context *ctx, struct event *ev, DWORD size, void *buffer, DWORD *used,
+                           DWORD *count )
+{
+    struct value_writer vw = {0};
+    DWORD n, i;
+    struct xnode doc;
+
+    n = ctx->flags == EvtRenderContextSystem ? EvtSystemPropertyIdEND :
+        ctx->flags == EvtRenderContextUser ? ev->rec->NumStrings : ctx->count;
+    vw.count = n;
+    vw.size = size;
+    vw.used = n * sizeof(EVT_VARIANT);
+    if (buffer && size >= vw.used)
+    {
+        vw.vars = buffer;
+        vw.buf = buffer;
+        memset( buffer, 0, vw.used );
+    }
+    if (ctx->flags == EvtRenderContextValues) build_event_doc( ev, &doc );
+    for (i = 0; i < n; i++)
+    {
+        EVT_VARIANT *var = vw.vars ? &vw.vars[i] : NULL;
+
+        if (ctx->flags == EvtRenderContextSystem) system_value( &vw, var, ev, i );
+        else if (ctx->flags == EvtRenderContextUser)
+        {
+            const WCHAR *str = rec_string( ev->rec, i );
+            if (str) vw_string( &vw, var, str );
+        }
+        else
+        {
+            int id = system_path_id( ctx->paths[i] );
+
+            if (id >= 0) system_value( &vw, var, ev, id );
+            else
+            {
+                struct xpath xp = {0};
+                struct value v;
+
+                xp.p = ctx->paths[i];
+                next_token( &xp );
+                if (xp.tok == TOK_SLASH) next_token( &xp );
+                if (eval_path( &xp, &doc, &v ) && v.nodes.count) vw_string( &vw, var, nref_text( &v.nodes.refs[0] ) );
+                else if (var) var->Type = EvtVarTypeNull;
+                value_free( &v );
+            }
+        }
+    }
+    if (ctx->flags == EvtRenderContextValues) xfree( &doc );
+    *used = vw.used;
+    *count = n;
+    if (!buffer || size < vw.used)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL return_string( const WCHAR *str, DWORD size, void *buffer, DWORD *used )
+{
+    DWORD len = (wcslen( str ) + 1) * sizeof(WCHAR);
+
+    *used = len;
+    if (!buffer || size < len)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    memcpy( buffer, str, len );
+    return TRUE;
+}
+
+BOOL WINAPI EvtRender( EVT_HANDLE context, EVT_HANDLE fragment, DWORD flags, DWORD size, void *buffer,
+                       DWORD *used, DWORD *count )
+{
+    struct object *obj;
+    BOOL ret = FALSE;
+
+    TRACE( "(%p %p %lu %lu %p %p %p)\n", context, fragment, flags, size, buffer, used, count );
+
+    if (!used || !count)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *used = *count = 0;
+    if (!(obj = grab( fragment, 0 ))) return FALSE;
+    switch (flags)
+    {
+    case EvtRenderEventXml:
+    {
+        WCHAR *xml;
+        if (obj->type != OBJ_EVENT) { SetLastError( ERROR_INVALID_PARAMETER ); break; }
+        if (!(xml = event_xml( (struct event *)obj, NULL ))) { SetLastError( ERROR_NOT_ENOUGH_MEMORY ); break; }
+        ret = return_string( xml, size, buffer, used );
+        free( xml );
+        break;
+    }
+    case EvtRenderBookmark:
+    {
+        struct bookmark *bm = (struct bookmark *)obj;
+        struct strbuf sb = {0};
+
+        if (obj->type != OBJ_BOOKMARK) { SetLastError( ERROR_INVALID_PARAMETER ); break; }
+        sb_append( &sb, L"<BookmarkList>" );
+        if (bm->channel[0])
+        {
+            sb_append( &sb, L"\r\n  <Bookmark Channel='" );
+            sb_escape( &sb, bm->channel );
+            sb_printf( &sb, L"' RecordId='%u' IsCurrent='true'/>\r\n", bm->record );
+        }
+        sb_append( &sb, L"</BookmarkList>" );
+        if (sb.failed) { SetLastError( ERROR_NOT_ENOUGH_MEMORY ); free( sb.buf ); break; }
+        ret = return_string( sb.buf, size, buffer, used );
+        free( sb.buf );
+        break;
+    }
+    case EvtRenderEventValues:
+    {
+        struct render_context *ctx;
+        if (obj->type != OBJ_EVENT) { SetLastError( ERROR_INVALID_PARAMETER ); break; }
+        if (!(ctx = (struct render_context *)grab( context, OBJ_CONTEXT ))) break;
+        ret = render_values( ctx, (struct event *)obj, size, buffer, used, count );
+        release_object( &ctx->hdr );
+        break;
+    }
+    default:
+        SetLastError( ERROR_INVALID_PARAMETER );
+        break;
+    }
+    release_object( obj );
+    return ret;
+}
+
+/* ---- bookmarks ------------------------------------------------------------------- */
+
+EVT_HANDLE WINAPI EvtCreateBookmark( const WCHAR *xml )
+{
+    struct bookmark *bm;
+    struct xml_tag tag;
+    const WCHAR *p;
+
+    TRACE( "(%s)\n", debugstr_w( xml ) );
+
+    if (!(bm = alloc_object( sizeof(*bm), OBJ_BOOKMARK, destroy_plain ))) return NULL;
+    if (xml)
+    {
+        if (!(p = next_tag( xml, &tag, NULL, 0 )) || wcscmp( tag.name, L"BookmarkList" ))
+        {
+            free( bm );
+            SetLastError( ERROR_EVT_MALFORMED_XML_TEXT );
+            return NULL;
+        }
+        while (!tag.empty && (p = next_tag( p, &tag, NULL, 0 )) && !tag.closing)
+        {
+            const WCHAR *channel = tag_attr( &tag, L"Channel" ), *record = tag_attr( &tag, L"RecordId" );
+            const WCHAR *current = tag_attr( &tag, L"IsCurrent" );
+
+            if (wcscmp( tag.name, L"Bookmark" ) || !channel || !record)
+            {
+                free( bm );
+                SetLastError( ERROR_EVT_MALFORMED_XML_TEXT );
+                return NULL;
+            }
+            if (!bm->channel[0] || (current && !wcsicmp( current, L"true" )))
+            {
+                lstrcpynW( bm->channel, channel, ARRAY_SIZE(bm->channel) );
+                bm->record = wcstoul( record, NULL, 10 );
+            }
+        }
+    }
+    return alloc_handle( &bm->hdr );
+}
+
+BOOL WINAPI EvtUpdateBookmark( EVT_HANDLE bookmark, EVT_HANDLE event )
+{
+    struct bookmark *bm;
+    struct event *ev;
+
+    TRACE( "(%p %p)\n", bookmark, event );
+
+    if (!(bm = (struct bookmark *)grab( bookmark, OBJ_BOOKMARK ))) return FALSE;
+    if (!(ev = (struct event *)grab( event, OBJ_EVENT )))
+    {
+        release_object( &bm->hdr );
+        return FALSE;
+    }
+    lstrcpynW( bm->channel, ev->channel, ARRAY_SIZE(bm->channel) );
+    bm->record = ev->rec->RecordNumber;
+    release_object( &ev->hdr );
+    release_object( &bm->hdr );
+    return TRUE;
+}
