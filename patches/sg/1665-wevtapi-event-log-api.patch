+/* ---- sessions ------------------------------------------------------------------- */
+
+EVT_HANDLE WINAPI EvtOpenSession( EVT_LOGIN_CLASS login_class, void *login, DWORD timeout, DWORD flags )
+{
+    EVT_RPC_LOGIN *rpc = login;
+    WCHAR computer[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD len = ARRAY_SIZE(computer);
+    struct object *obj;
+
+    TRACE( "(%u %p %lu %#lx)\n", login_class, login, timeout, flags );
+
+    if (login_class != EvtRpcLogin || !rpc || flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    GetComputerNameW( computer, &len );
+    /* this computer only: there is no remote event log service to reach */
+    if (rpc->Server && rpc->Server[0] && wcsicmp( rpc->Server, L"localhost" ) && wcsicmp( rpc->Server, L"." ) &&
+        wcsicmp( rpc->Server, L"127.0.0.1" ) && wcsicmp( rpc->Server, computer ))
+    {
+        FIXME( "remote server %s\n", debugstr_w( rpc->Server ) );
+        SetLastError( RPC_S_SERVER_UNAVAILABLE );
+        return NULL;
+    }
+    if (!(obj = alloc_object( sizeof(*obj), OBJ_SESSION, destroy_plain ))) return NULL;
+    return alloc_handle( obj );
+}
