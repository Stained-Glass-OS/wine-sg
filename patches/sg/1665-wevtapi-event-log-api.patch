+/* ---- publishers ------------------------------------------------------------------ */
+
+EVT_HANDLE WINAPI EvtOpenPublisherEnum( EVT_HANDLE session, DWORD flags )
+{
+    struct name_list *list, logs = {{0}};
+    WCHAR key[512], name[256], guid[64];
+    DWORD i, len;
+    HKEY pub;
+
+    TRACE( "(%p %#lx)\n", session, flags );
+
+    if (!check_session( session )) return NULL;
+    if (flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (!(list = alloc_object( sizeof(*list), OBJ_PUBLISHER_ENUM, destroy_name_list ))) return NULL;
+    /* the sources of the classic logs */
+    names_add_subkeys( &logs, HKEY_LOCAL_MACHINE, eventlog_keyW );
+    for (i = 0; i < logs.count; i++)
+    {
+        swprintf( key, ARRAY_SIZE(key), L"%s\\%s", eventlog_keyW, logs.names[i] );
+        names_add_subkeys( list, HKEY_LOCAL_MACHINE, key );
+        free( logs.names[i] );
+    }
+    free( logs.names );
+    /* and the publishers described by GUID */
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, publishers_keyW, 0, KEY_READ, &pub ))
+    {
+        for (i = 0;; i++)
+        {
+            len = ARRAY_SIZE(guid);
+            if (RegEnumKeyExW( pub, i, guid, &len, NULL, NULL, NULL, NULL )) break;
+            len = sizeof(name);
+            if (!RegGetValueW( pub, guid, NULL, RRF_RT_REG_SZ, NULL, name, &len )) names_add( list, name );
+        }
+        RegCloseKey( pub );
+    }
+    if (list->count) qsort( list->names, list->count, sizeof(*list->names), cmp_names );
+    return alloc_handle( &list->hdr );
+}
+
+BOOL WINAPI EvtNextPublisherId( EVT_HANDLE handle, DWORD size, WCHAR *buffer, DWORD *used )
+{
+    TRACE( "(%p %lu %p %p)\n", handle, size, buffer, used );
+    return next_name( handle, OBJ_PUBLISHER_ENUM, size, buffer, used );
+}
+
+struct publisher
+{
+    struct object hdr;
+    WCHAR name[256];
+    WCHAR channel[256];         /* a classic source: its log */
+    GUID guid;
+    BOOL has_guid;
+    WCHAR message_file[MAX_PATH * 2];
+    WCHAR parameter_file[MAX_PATH * 2];
+    WCHAR resource_file[MAX_PATH * 2];
+    WCHAR category_file[MAX_PATH * 2];
+    DWORD category_count;
+};
+
+/* where a classic source is registered (its log) */
+static BOOL find_source( const WCHAR *source, WCHAR *log, DWORD size )
+{
+    struct name_list logs = {{0}};
+    WCHAR key[512];
+    DWORD i;
+    BOOL found = FALSE;
+    HKEY h;
+
+    names_add_subkeys( &logs, HKEY_LOCAL_MACHINE, eventlog_keyW );
+    for (i = 0; i < logs.count; i++)
+    {
+        if (!found)
+        {
+            swprintf( key, ARRAY_SIZE(key), L"%s\\%s\\%s", eventlog_keyW, logs.names[i], source );
+            if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, key, 0, KEY_READ, &h ))
+            {
+                RegCloseKey( h );
+                lstrcpynW( log, logs.names[i], size );
+                found = TRUE;
+            }
+        }
+        free( logs.names[i] );
+    }
+    free( logs.names );
+    return found;
+}
+
+static void source_value( const WCHAR *log, const WCHAR *source, const WCHAR *name, WCHAR *buf, DWORD size )
+{
+    WCHAR key[512];
+    DWORD len = size * sizeof(WCHAR);
+
+    buf[0] = 0;
+    swprintf( key, ARRAY_SIZE(key), L"%s\\%s\\%s", eventlog_keyW, log, source );
+    RegGetValueW( HKEY_LOCAL_MACHINE, key, name, RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ | RRF_NOEXPAND, NULL, buf, &len );
+}
+
+static struct publisher *open_publisher( const WCHAR *name, const WCHAR *log_hint )
+{
+    struct publisher *pub;
+    WCHAR guid[64], key[512], value[256];
+    DWORD i, len;
+    HKEY keys;
+
+    if (!(pub = alloc_object( sizeof(*pub), OBJ_PUBLISHER, destroy_plain ))) return NULL;
+    lstrcpynW( pub->name, name, ARRAY_SIZE(pub->name) );
+    if ((log_hint && log_hint[0] && (swprintf( key, ARRAY_SIZE(key), L"%s\\%s\\%s", eventlog_keyW, log_hint, name ),
+                                     !RegOpenKeyExW( HKEY_LOCAL_MACHINE, key, 0, KEY_READ, &keys ) &&
+                                     !RegCloseKey( keys ) && lstrcpynW( pub->channel, log_hint, ARRAY_SIZE(pub->channel) ))) ||
+        find_source( name, pub->channel, ARRAY_SIZE(pub->channel) ))
+    {
+        DWORD count = 0, size = sizeof(count);
+
+        source_value( pub->channel, name, L"EventMessageFile", pub->message_file, ARRAY_SIZE(pub->message_file) );
+        source_value( pub->channel, name, L"ParameterMessageFile", pub->parameter_file, ARRAY_SIZE(pub->parameter_file) );
+        source_value( pub->channel, name, L"CategoryMessageFile", pub->category_file, ARRAY_SIZE(pub->category_file) );
+        source_value( pub->channel, name, L"ProviderGuid", value, ARRAY_SIZE(value) );
+        if (value[0] && CLSIDFromString( value, &pub->guid ) == S_OK) pub->has_guid = TRUE;
+        swprintf( key, ARRAY_SIZE(key), L"%s\\%s\\%s", eventlog_keyW, pub->channel, name );
+        if (!RegGetValueW( HKEY_LOCAL_MACHINE, key, L"CategoryCount", RRF_RT_REG_DWORD, NULL, &count, &size ))
+            pub->category_count = count;
+        return pub;
+    }
+    /* a publisher described by GUID, by its name or its GUID */
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, publishers_keyW, 0, KEY_READ, &keys ))
+    {
+        for (i = 0;; i++)
+        {
+            len = ARRAY_SIZE(guid);
+            if (RegEnumKeyExW( keys, i, guid, &len, NULL, NULL, NULL, NULL )) break;
+            len = sizeof(value);
+            if (RegGetValueW( keys, guid, NULL, RRF_RT_REG_SZ, NULL, value, &len )) value[0] = 0;
+            if (wcsicmp( value, name ) && wcsicmp( guid, name )) continue;
+            if (value[0]) lstrcpynW( pub->name, value, ARRAY_SIZE(pub->name) );
+            pub->has_guid = CLSIDFromString( guid, &pub->guid ) == S_OK;
+            len = sizeof(pub->message_file);
+            RegGetValueW( keys, guid, L"MessageFileName", RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ | RRF_NOEXPAND, NULL, pub->message_file, &len );
+            len = sizeof(pub->parameter_file);
+            RegGetValueW( keys, guid, L"ParameterFileName", RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ | RRF_NOEXPAND, NULL, pub->parameter_file, &len );
+            len = sizeof(pub->resource_file);
+            RegGetValueW( keys, guid, L"ResourceFileName", RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ | RRF_NOEXPAND, NULL, pub->resource_file, &len );
+            RegCloseKey( keys );
+            return pub;
+        }
+        RegCloseKey( keys );
+    }
+    free( pub );
+    SetLastError( ERROR_EVT_PUBLISHER_METADATA_NOT_FOUND );
+    return NULL;
+}
+
+EVT_HANDLE WINAPI EvtOpenPublisherMetadata( EVT_HANDLE session, const WCHAR *id, const WCHAR *logfile, LCID locale,
+                                            DWORD flags )
+{
+    struct publisher *pub;
+
+    TRACE( "(%p %s %s %#lx %#lx)\n", session, debugstr_w( id ), debugstr_w( logfile ), locale, flags );
+
+    if (!check_session( session )) return NULL;
+    if (!id || flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (!(pub = open_publisher( id, NULL ))) return NULL;
+    return alloc_handle( &pub->hdr );
+}
+
+/* arrays of channel references, levels, tasks, opcodes and keywords */
+struct meta_item
+{
+    WCHAR name[256];
+    ULONGLONG value;
+    DWORD message_id;
+};
+
+struct meta_array
+{
+    struct object hdr;
+    DWORD kind;                 /* the EvtPublisherMetadata* id of the array */
+    struct meta_item *items;
+    DWORD count;
+};
+
+static void destroy_meta_array( struct object *obj )
+{
+    struct meta_array *array = (struct meta_array *)obj;
+    free( array->items );
+    free( array );
+}
+
+static void array_add( struct meta_array *array, const WCHAR *name, ULONGLONG value, DWORD message_id )
+{
+    struct meta_item *items = realloc( array->items, (array->count + 1) * sizeof(*items) );
+
+    if (!items) return;
+    array->items = items;
+    lstrcpynW( items[array->count].name, name, ARRAY_SIZE(items[0].name) );
+    items[array->count].value = value;
+    items[array->count].message_id = message_id;
+    array->count++;
+}
+
+/* the first message file of a list (a;b;c) that has the message */
+static BOOL load_message( const WCHAR *files, DWORD id, DWORD_PTR *args, DWORD nargs, WCHAR **out )
+{
+    WCHAR list[MAX_PATH * 2], expanded[MAX_PATH], *file, *next;
+    HMODULE module;
+    DWORD flags = FORMAT_MESSAGE_FROM_HMODULE | FORMAT_MESSAGE_ALLOCATE_BUFFER;
+
+    if (!files || !files[0]) return FALSE;
+#ifdef SG_MUTANT_NO_MESSAGE
+    return FALSE;
+#endif
+    flags |= args ? FORMAT_MESSAGE_ARGUMENT_ARRAY : FORMAT_MESSAGE_IGNORE_INSERTS;
+    lstrcpynW( list, files, ARRAY_SIZE(list) );
+    for (file = list; file; file = next)
+    {
+        WCHAR *msg = NULL;
+
+        if ((next = wcschr( file, ';' ))) *next++ = 0;
+        ExpandEnvironmentStringsW( file, expanded, ARRAY_SIZE(expanded) );
+        if (!(module = LoadLibraryExW( expanded, NULL, LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE )))
+            continue;
+        if (FormatMessageW( flags, module, id, 0, (WCHAR *)&msg, 0, (va_list *)args ) && msg)
+        {
+            size_t len = wcslen( msg );
+            /* without the line end the message file adds */
+            while (len && (msg[len - 1] == '\n' || msg[len - 1] == '\r')) msg[--len] = 0;
+            *out = wcsdup( msg );
+            LocalFree( msg );
+            FreeLibrary( module );
+            return *out != NULL;
+        }
+        FreeLibrary( module );
+    }
+    return FALSE;
+}
+
+BOOL WINAPI EvtGetPublisherMetadataProperty( EVT_HANDLE handle, EVT_PUBLISHER_METADATA_PROPERTY_ID id, DWORD flags,
+                                             DWORD size, EVT_VARIANT *buffer, DWORD *used )
+{
+    static const struct { const WCHAR *name; DWORD value; } levels[] =
+    {
+        { L"win:Critical", 1 }, { L"win:Error", 2 }, { L"win:Warning", 3 }, { L"win:Informational", 4 },
+        { L"win:Verbose", 5 },
+    };
+    struct publisher *pub;
+    struct meta_array *array;
+    EVT_VARIANT var = {{0}};
+    const WCHAR *str = NULL;
+    const BYTE *extra = NULL;
+    DWORD extra_len = 0, i;
+    EVT_HANDLE h;
+
+    TRACE( "(%p %u %#lx %lu %p %p)\n", handle, id, flags, size, buffer, used );
+
+    if (!used || flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(pub = (struct publisher *)grab( handle, OBJ_PUBLISHER ))) return FALSE;
+    switch (id)
+    {
+    case EvtPublisherMetadataPublisherGuid:
+        if (pub->has_guid)
+        {
+            var.Type = EvtVarTypeGuid;
+            extra = (const BYTE *)&pub->guid;
+            extra_len = sizeof(GUID);
+        }
+        else var.Type = EvtVarTypeNull;
+        break;
+    case EvtPublisherMetadataResourceFilePath:
+        var.Type = EvtVarTypeString;
+        str = pub->resource_file[0] ? pub->resource_file : pub->message_file;
+        break;
+    case EvtPublisherMetadataParameterFilePath:
+        var.Type = EvtVarTypeString;
+        str = pub->parameter_file;
+        break;
+    case EvtPublisherMetadataMessageFilePath:
+        var.Type = EvtVarTypeString;
+        str = pub->message_file;
+        break;
+    case EvtPublisherMetadataHelpLink:
+        var.Type = EvtVarTypeString;
+        str = L"";
+        break;
+    case EvtPublisherMetadataPublisherMessageID:
+        var.Type = EvtVarTypeUInt32;
+        var.UInt32Val = ~0u;
+        break;
+    case EvtPublisherMetadataChannelReferences:
+    case EvtPublisherMetadataLevels:
+    case EvtPublisherMetadataTasks:
+    case EvtPublisherMetadataOpcodes:
+    case EvtPublisherMetadataKeywords:
+        if (!(array = alloc_object( sizeof(*array), OBJ_ARRAY, destroy_meta_array )))
+        {
+            release_object( &pub->hdr );
+            return FALSE;
+        }
+        array->kind = id;
+        if (id == EvtPublisherMetadataChannelReferences && pub->channel[0]) array_add( array, pub->channel, 0, ~0u );
+        else if (id == EvtPublisherMetadataLevels)
+            for (i = 0; i < ARRAY_SIZE(levels); i++) array_add( array, levels[i].name, levels[i].value, ~0u );
+        else if (id == EvtPublisherMetadataTasks)
+        {
+            /* a classic source's categories */
+            for (i = 1; i <= pub->category_count && i <= 1024; i++)
+            {
+                WCHAR *msg = NULL;
+                load_message( pub->category_file, i, NULL, 0, &msg );
+                array_add( array, msg ? msg : L"", i, i );
+                free( msg );
+            }
+        }
+        else if (id == EvtPublisherMetadataOpcodes) array_add( array, L"win:Info", 0, ~0u );
+        else if (id == EvtPublisherMetadataKeywords)
+        {
+            array_add( array, L"Classic", CLASSIC_KEYWORDS, ~0u );
+        }
+        if (!(h = alloc_handle( &array->hdr )))
+        {
+            release_object( &pub->hdr );
+            return FALSE;
+        }
+        var.Type = EvtVarTypeEvtHandle;
+        var.EvtHandleVal = h;
+        if (!buffer || size < sizeof(EVT_VARIANT))
+        {
+            /* not kept: asked again with a buffer */
+            EvtClose( h );
+            var.EvtHandleVal = NULL;
+        }
+        break;
+    default:
+        release_object( &pub->hdr );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    release_object( &pub->hdr );
+    return return_variant( &var, str, extra, extra_len, size, buffer, used );
+}
+
+BOOL WINAPI EvtGetObjectArraySize( EVT_OBJECT_ARRAY_PROPERTY_HANDLE handle, DWORD *size )
+{
+    struct meta_array *array;
+
+    TRACE( "(%p %p)\n", handle, size );
+
+    if (!size)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(array = (struct meta_array *)grab( handle, OBJ_ARRAY ))) return FALSE;
+    *size = array->count;
+    release_object( &array->hdr );
+    return TRUE;
+}
+
+BOOL WINAPI EvtGetObjectArrayProperty( EVT_OBJECT_ARRAY_PROPERTY_HANDLE handle, DWORD id, DWORD index, DWORD flags,
+                                       DWORD size, EVT_VARIANT *buffer, DWORD *used )
+{
+    struct meta_array *array;
+    struct meta_item *item;
+    EVT_VARIANT var = {{0}};
+    const WCHAR *str = NULL;
+    BOOL ok = TRUE;
+
+    TRACE( "(%p %lu %lu %#lx %lu %p %p)\n", handle, id, index, flags, size, buffer, used );
+
+    if (!used || flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(array = (struct meta_array *)grab( handle, OBJ_ARRAY ))) return FALSE;
+    if (index >= array->count)
+    {
+        release_object( &array->hdr );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    item = &array->items[index];
+    switch (array->kind)
+    {
+    case EvtPublisherMetadataChannelReferences:
+        if (id == EvtPublisherMetadataChannelReferencePath) { var.Type = EvtVarTypeString; str = item->name; }
+        else if (id == EvtPublisherMetadataChannelReferenceIndex) { var.Type = EvtVarTypeUInt32; var.UInt32Val = index; }
+        else if (id == EvtPublisherMetadataChannelReferenceID) { var.Type = EvtVarTypeUInt32; var.UInt32Val = index; }
+        else if (id == EvtPublisherMetadataChannelReferenceFlags) { var.Type = EvtVarTypeUInt32; var.UInt32Val = 0; }
+        else if (id == EvtPublisherMetadataChannelReferenceMessageID) { var.Type = EvtVarTypeUInt32; var.UInt32Val = item->message_id; }
+        else ok = FALSE;
+        break;
+    case EvtPublisherMetadataLevels:
+        if (id == EvtPublisherMetadataLevelName) { var.Type = EvtVarTypeString; str = item->name; }
+        else if (id == EvtPublisherMetadataLevelValue) { var.Type = EvtVarTypeUInt32; var.UInt32Val = item->value; }
+        else if (id == EvtPublisherMetadataLevelMessageID) { var.Type = EvtVarTypeUInt32; var.UInt32Val = item->message_id; }
+        else ok = FALSE;
+        break;
+    case EvtPublisherMetadataTasks:
+        if (id == EvtPublisherMetadataTaskName) { var.Type = EvtVarTypeString; str = item->name; }
+        else if (id == EvtPublisherMetadataTaskEventGuid) var.Type = EvtVarTypeNull;
+        else if (id == EvtPublisherMetadataTaskValue) { var.Type = EvtVarTypeUInt32; var.UInt32Val = item->value; }
+        else if (id == EvtPublisherMetadataTaskMessageID) { var.Type = EvtVarTypeUInt32; var.UInt32Val = item->message_id; }
+        else ok = FALSE;
+        break;
+    case EvtPublisherMetadataOpcodes:
+        if (id == EvtPublisherMetadataOpcodeName) { var.Type = EvtVarTypeString; str = item->name; }
+        else if (id == EvtPublisherMetadataOpcodeValue) { var.Type = EvtVarTypeUInt32; var.UInt32Val = item->value; }
+        else if (id == EvtPublisherMetadataOpcodeMessageID) { var.Type = EvtVarTypeUInt32; var.UInt32Val = item->message_id; }
+        else ok = FALSE;
+        break;
+    case EvtPublisherMetadataKeywords:
+        if (id == EvtPublisherMetadataKeywordName) { var.Type = EvtVarTypeString; str = item->name; }
+        else if (id == EvtPublisherMetadataKeywordValue) { var.Type = EvtVarTypeUInt64; var.UInt64Val = item->value; }
+        else if (id == EvtPublisherMetadataKeywordMessageID) { var.Type = EvtVarTypeUInt32; var.UInt32Val = item->message_id; }
+        else ok = FALSE;
+        break;
+    default:
+        ok = FALSE;
+        break;
+    }
+    if (!ok)
+    {
+        release_object( &array->hdr );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    ok = return_variant( &var, str, NULL, 0, size, buffer, used );
+    release_object( &array->hdr );
+    return ok;
+}
