+/* Stained Glass OS (9817): an option's value, in a buffer of the option's own size: an integer
+ * option may be an array (a gamma table: 16 KB), a string longer than a fixed buffer -- read into
+ * one int or 255 bytes, they ran over the stack (the source's window crashed or never came) */
+static void *option_value(int optno, int size)
+{
+    void *value = calloc(1, max(size, (int)sizeof(int)) + sizeof(WCHAR));
+
+    if (value) sane_option_get_value( optno, value );
+    return value;
+}
