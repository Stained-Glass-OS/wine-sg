-        DSM_parent = (HWND)pData;
+        /* the program's window: pData points to it (TWAIN); some programs give the handle itself */
+        DSM_parent = NULL;
+        if (pData && !IsBadReadPtr(pData, sizeof(HWND)) && IsWindow(*(HWND *)pData)) DSM_parent = *(HWND *)pData;
+        else if (IsWindow((HWND)pData)) DSM_parent = (HWND)pData;
+#ifndef SG_MUTANT_TWAIN2_NONE
+        /* a TWAIN 2 program is told this manager is one too */
+        if (twRC == TWRC_SUCCESS && pOrigin && (pOrigin->SupportedGroups & DF_APP2))
+            pOrigin->SupportedGroups |= DF_DSM2;
+#endif
 	return twRC;
