--- a/dlls/twain_32/twain32_main.c
+++ b/dlls/twain_32/twain32_main.c
@@ -147,6 +147,21 @@
 }
 
 
+/* Stained Glass OS (9818): TWAIN 2's memory functions (DAT_ENTRYPOINT) */
+static TW_HANDLE WINAPI DSM_MemAllocate(TW_UINT32 size) { return GlobalAlloc(GHND, size); }
+static void WINAPI DSM_MemFree(TW_HANDLE handle) { GlobalFree(handle); }
+static TW_MEMREF WINAPI DSM_MemLock(TW_HANDLE handle) { return GlobalLock(handle); }
+static void WINAPI DSM_MemUnlock(TW_HANDLE handle) { GlobalUnlock(handle); }
+
+void DSM_GetEntryPoints(TW_ENTRYPOINT *entry)
+{
+    entry->DSM_Entry = DSM_Entry;
+    entry->DSM_MemAllocate = DSM_MemAllocate;
+    entry->DSM_MemFree = DSM_MemFree;
+    entry->DSM_MemLock = DSM_MemLock;
+    entry->DSM_MemUnlock = DSM_MemUnlock;
+}
+
 /* Main entry point for the TWAIN library */
 TW_UINT16 WINAPI
 DSM_Entry (pTW_IDENTITY pOrigin,
@@ -160,6 +175,47 @@
 
     TRACE("(DG=%ld DAT=%d MSG=%d)\n", DG, DAT, MSG);
 
+#ifndef SG_MUTANT_TWAIN2_NONE
+    /* TWAIN 2: the program asks for the source manager's memory functions */
+    if (DG == DG_CONTROL && DAT == DAT_ENTRYPOINT && MSG == MSG_GET && !pDest)
+    {
+        TW_ENTRYPOINT *entry = pData;
+
+        if (!entry || entry->Size < sizeof(*entry))
+        {
+            DSM_twCC = TWCC_BADVALUE;
+            return TWRC_FAILURE;
+        }
+        DSM_GetEntryPoints(entry);
+        DSM_twCC = TWCC_SUCCESS;
+        return TWRC_SUCCESS;
+    }
+    /* TWAIN 2: the program's callback for the source's events, instead of DAT_EVENT */
+    if (DG == DG_CONTROL && (DAT == DAT_CALLBACK || DAT == DAT_CALLBACK2) && MSG == MSG_REGISTER_CALLBACK && pDest)
+    {
+        activeDS *pSource = TWAIN_LookupSource (pDest);
+
+        if (!pSource || !pData)
+        {
+            DSM_twCC = pSource ? TWCC_BADVALUE : TWCC_BADDEST;
+            return TWRC_FAILURE;
+        }
+        if (DAT == DAT_CALLBACK)
+        {
+            pSource->callback = ((TW_CALLBACK *)pData)->CallBackProc;
+            pSource->refcon = ((TW_CALLBACK *)pData)->RefCon;
+        }
+        else
+        {
+            pSource->callback = ((TW_CALLBACK2 *)pData)->CallBackProc;
+            pSource->refcon = ((TW_CALLBACK2 *)pData)->RefCon;
+        }
+        TRACE("callback %p for source %lu\n", pSource->callback, pSource->identity.Id);
+        DSM_twCC = TWCC_SUCCESS;
+        return TWRC_SUCCESS;
+    }
+#endif
+
     if (DG == DG_CONTROL && DAT == DAT_NULL)
     {
         activeDS *pSource = TWAIN_LookupSource (pOrigin);
--- a/dlls/twain_32/twain_i.h
+++ b/dlls/twain_32/twain_i.h
@@ -43,8 +43,23 @@
     struct list         pending_messages;
     HWND                ui_window;
     HWND                event_window;
+    TW_IDENTITY         app;            /* Stained Glass OS (9818): the program that opened it */
+    TW_MEMREF           callback;       /* its TWAIN 2 callback (DAT_CALLBACK), or NULL */
+    UINT_PTR            refcon;
 } activeDS;
 
+/* Stained Glass OS (9818): the TWAIN 2 source manager (twaindsm.dll is built from these sources too) */
+#define DAT_CALLBACK          0x0010
+#define DAT_CALLBACK2         0x0012
+#define MSG_REGISTER_CALLBACK 0x0902
+#define DF_DSM2               0x10000000
+#define DF_APP2               0x20000000
+#include "pshpack2.h"
+typedef struct { TW_MEMREF CallBackProc; TW_UINT32 RefCon; TW_INT16 Message; } TW_CALLBACK;
+typedef struct { TW_MEMREF CallBackProc; UINT_PTR RefCon; TW_INT16 Message; } TW_CALLBACK2;
+#include "poppack.h"
+typedef TW_UINT16 (WINAPI *DSM_CALLBACKPROC)(pTW_IDENTITY, pTW_IDENTITY, TW_UINT32, TW_UINT16, TW_UINT16, TW_MEMREF);
+
 extern TW_UINT16 DSM_twCC;             /* current condition code of Source Manager */
 
 extern activeDS *activeSources;	/* list of active data sources */
@@ -63,5 +78,6 @@
 extern TW_UINT16 TWAIN_GetDSMStatus(pTW_IDENTITY pOrigin, TW_MEMREF pData);
 extern TW_UINT16 TWAIN_ControlNull(pTW_IDENTITY pOrigin, pTW_IDENTITY pDest, activeDS *pSource, TW_UINT16 MSG, TW_MEMREF pData);
 extern TW_UINT16 TWAIN_ProcessEvent(pTW_IDENTITY pOrigin, activeDS *pSource, TW_MEMREF pData);
+extern void DSM_GetEntryPoints(TW_ENTRYPOINT *entry);
 
 #endif
