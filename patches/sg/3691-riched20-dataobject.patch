From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: GetDataHere and advise on the transfer data object (3691)

riched20: GetDataHere and advise on the transfer data object

The data object of a copy or drag answers GetDataHere for the text and RTF
formats (into a block the caller allocated) and the advise calls with
OLE_E_ADVISENOTSUPPORTED: the data is a snapshot.
---
diff --git a/dlls/riched20/clipboard.c b/dlls/riched20/clipboard.c
index 65d317b..ef84365 100644
--- a/dlls/riched20/clipboard.c
+++ b/dlls/riched20/clipboard.c
@@ -239,8 +239,35 @@ static HRESULT WINAPI DataObjectImpl_GetData(IDataObject* iface, FORMATETC *pfor
 static HRESULT WINAPI DataObjectImpl_GetDataHere(IDataObject* iface, FORMATETC *pformatetc, STGMEDIUM *pmedium)
 {
     DataObjectImpl *This = impl_from_IDataObject(iface);
-    FIXME("(%p): stub\n", This);
+    HGLOBAL src;
+    SIZE_T size;
+    void *from, *to;
+
+    TRACE("(%p)->(fmt=0x%08x)\n", This, pformatetc->cfFormat);
+
+    if(pformatetc->lindex != -1)
+        return DV_E_LINDEX;
+    if(!(pformatetc->tymed & TYMED_HGLOBAL))
+        return DV_E_TYMED;
+    if(This->unicode && pformatetc->cfFormat == CF_UNICODETEXT) src = This->unicode;
+    else if(This->rtf && pformatetc->cfFormat == cfRTF) src = This->rtf;
+    else return DV_E_FORMATETC;
+
+#ifdef SG_MUTANT_RE_HERE
     return E_NOTIMPL;
+#endif
+    /* only a block the caller allocated can be filled in */
+    if(pmedium->tymed != TYMED_HGLOBAL || !pmedium->hGlobal)
+        return DV_E_TYMED;
+    size = GlobalSize(src);
+    if(GlobalSize(pmedium->hGlobal) < size)
+        return STG_E_MEDIUMFULL;
+    from = GlobalLock(src);
+    to = GlobalLock(pmedium->hGlobal);
+    if(from && to) memcpy(to, from, size);
+    if(from) GlobalUnlock(src);
+    if(to) GlobalUnlock(pmedium->hGlobal);
+    return from && to ? S_OK : E_OUTOFMEMORY;
 }
 
 static HRESULT WINAPI DataObjectImpl_QueryGetData(IDataObject* iface, FORMATETC *pformatetc)
@@ -299,26 +326,29 @@ static HRESULT WINAPI DataObjectImpl_EnumFormatEtc(IDataObject* iface, DWORD dwD
     return EnumFormatImpl_Create(This->fmtetc, This->fmtetc_cnt, ppenumFormatEtc);
 }
 
+/* the data is a snapshot taken for the transfer: it never changes, so nothing is advised */
 static HRESULT WINAPI DataObjectImpl_DAdvise(IDataObject* iface, FORMATETC *pformatetc, DWORD advf,
                                              IAdviseSink *pAdvSink, DWORD *pdwConnection)
 {
     DataObjectImpl *This = impl_from_IDataObject(iface);
-    FIXME("(%p): stub\n", This);
-    return E_NOTIMPL;
+    TRACE("(%p)\n", This);
+    if(pdwConnection) *pdwConnection = 0;
+    return OLE_E_ADVISENOTSUPPORTED;
 }
 
 static HRESULT WINAPI DataObjectImpl_DUnadvise(IDataObject* iface, DWORD dwConnection)
 {
     DataObjectImpl *This = impl_from_IDataObject(iface);
-    FIXME("(%p): stub\n", This);
-    return E_NOTIMPL;
+    TRACE("(%p)\n", This);
+    return OLE_E_ADVISENOTSUPPORTED;
 }
 
 static HRESULT WINAPI DataObjectImpl_EnumDAdvise(IDataObject* iface, IEnumSTATDATA **ppenumAdvise)
 {
     DataObjectImpl *This = impl_from_IDataObject(iface);
-    FIXME("(%p): stub\n", This);
-    return E_NOTIMPL;
+    TRACE("(%p)\n", This);
+    if(ppenumAdvise) *ppenumAdvise = NULL;
+    return OLE_E_ADVISENOTSUPPORTED;
 }
 
 static const IDataObjectVtbl VT_DataObjectImpl =
