From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHGetImageList(-1) gives a shell image list a program may resize

TreeSize Free 4.8 (VCL) asks SHGetImageList(-1, IID_IImageList2) at every start, resizes the
list to its own icon size (IImageList2::Resize) and uses it unchecked; it was refused and TreeSize
crashed (access violation in TJamSystemImageList.GetSize). The index is undocumented; the shell
keeps one more list beside the five documented ones, at the small icon size to begin with, kept in
step with them (the shell's later icons are added to it at whatever size it has then), and -1 gives
it. Gate: test/shilany-gate.sh.
---
--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -58,7 +58,13 @@
 
 static HDPA sic_hdpa;
 static INIT_ONCE sic_init_once = INIT_ONCE_STATIC_INIT;
-static HIMAGELIST shell_imagelists[SHIL_LAST+1];
+/* Stained Glass OS (9301): SHGetImageList(-1) is a list of the shell's own
+ * beside the five documented ones -- programs take it and resize it to a size
+ * of their own (IImageList2::Resize), and the icons the shell adds later come
+ * at that size. TreeSize (VCL) asks for it at every start and crashed when it
+ * was refused. It starts at the small icon size. */
+#define SHIL_SG_ANYSIZE (SHIL_LAST + 1)
+static HIMAGELIST shell_imagelists[SHIL_LAST+2];
 static UINT sic_dpi;  /* Stained Glass OS: the system DPI the lists were made at */
 
 static CRITICAL_SECTION SHELL32_SicCS;
@@ -673,6 +679,8 @@
     sizes[SHIL_SYSSMALL].cx = GetSystemMetrics( SM_CXSMICON );
     sizes[SHIL_SYSSMALL].cy = GetSystemMetrics( SM_CYSMICON );
     sizes[SHIL_JUMBO].cx = sizes[SHIL_JUMBO].cy = 256;
+    sizes[SHIL_SG_ANYSIZE].cx = GetSystemMetrics( SM_CXSMICON );
+    sizes[SHIL_SG_ANYSIZE].cy = GetSystemMetrics( SM_CYSMICON );
 
     TRACE("large %ldx%ld small %ldx%ld\n", sizes[SHIL_LARGE].cx, sizes[SHIL_LARGE].cy, sizes[SHIL_SMALL].cx, sizes[SHIL_SMALL].cy);
     sic_dpi = GetDpiForSystem();
@@ -2018,6 +2026,10 @@
 {
     TRACE("(%d, %s, %p)\n", iImageList, debugstr_guid(riid), ppv);
 
+#ifndef SG_MUTANT_NO_ANYSIZE_LIST
+    if (iImageList == -1) iImageList = SHIL_SG_ANYSIZE;
+    else
+#endif
     if (iImageList < 0 || iImageList > SHIL_LAST)
         return E_FAIL;
 
