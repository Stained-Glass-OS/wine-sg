+/* whether the task may run: its XML's Enabled, unless EnableTask said otherwise */
+static BOOL task_is_enabled(const struct run_task *task)
+{
+    if (task->disabled) return FALSE;
+    return task->enabled || task->forced;
+}
+
+static void forget_state(const struct run_task *task)
+{
+    HKEY key;
+
+    if (RegOpenKeyExW(state_root(), state_key, 0, KEY_SET_VALUE, &key)) return;
+    RegDeleteValueW(key, task->path);
+    RegCloseKey(key);
+}
