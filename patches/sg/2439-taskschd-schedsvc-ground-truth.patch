+/* a task was registered anew or deleted: EnableTask(TRUE) on the old definition no longer holds */
+void taskrun_unforce(const WCHAR *path)
+{
+    struct run_task *task;
+    struct saved_state state;
+    DWORD size = sizeof(state);
+    HKEY key;
+
+    while (*path == '\\' || *path == '/') path++;
+    EnterCriticalSection(&cs);
+    LIST_FOR_EACH_ENTRY(task, &tasks, struct run_task, entry)
+    {
+        const WCHAR *p = task->path;
+        while (*p == '\\') p++;
+        if (!wcsicmp(p, path) && task->forced)
+        {
+            task->forced = FALSE;
+            save_state(task);
+        }
+    }
+    if (!RegOpenKeyExW(state_root(), state_key, 0, KEY_QUERY_VALUE | KEY_SET_VALUE, &key))
+    {
+        WCHAR *full = malloc((wcslen(path) + 2) * sizeof(WCHAR));
+
+        if (full)
+        {
+            full[0] = '\\';
+            wcscpy(full + 1, path);
+            if (!RegQueryValueExW(key, full, NULL, NULL, (BYTE *)&state, &size) && size == sizeof(state) &&
+                (state.disabled & 2))
+            {
+                state.disabled &= ~2;
+                RegSetValueExW(key, full, 0, REG_BINARY, (const BYTE *)&state, sizeof(state));
+            }
+            free(full);
+        }
+        RegCloseKey(key);
+    }
+    LeaveCriticalSection(&cs);
+}
