+/* a folder name: parts separated by backslashes, none of them "." or ".." or containing
+ * any of / : * ? " < > | */
+BOOL is_valid_folder_path(const WCHAR *path)
+{
+    const WCHAR *part = path;
+
+#ifdef SG_MUTANT_TS_NAMES
+    return TRUE;
+#endif
+
+    while (*part)
+    {
+        const WCHAR *end = part;
+
+        while (*end && *end != '\\')
+        {
+            if (wcschr(L"/:*?\"<>|", *end)) return FALSE;
+            end++;
+        }
+        if ((end - part == 1 && part[0] == '.') || (end - part == 2 && part[0] == '.' && part[1] == '.'))
+            return FALSE;
+        part = *end ? end + 1 : end;
+    }
+    return TRUE;
+}
