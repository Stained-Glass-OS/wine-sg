+    task->forced = FALSE;
     if (RegGetValueW(state_root(), state_key, task->path, RRF_RT_REG_BINARY, NULL, &state, &size) ||
         size != sizeof(state))
         return;
     task->last_run = ((ULONGLONG)state.last_run.dwHighDateTime << 32) | state.last_run.dwLowDateTime;
     task->last_result = state.last_result;
-    task->disabled = !!state.disabled;
+    task->disabled = !!(state.disabled & 1);
+    task->forced = !!(state.disabled & 2);
 }
 
