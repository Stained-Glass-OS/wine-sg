@@ -1032,10 +1034,11 @@ HRESULT __cdecl SchRpcGetTaskInfo(const WCHAR *path, DWORD flags, DWORD *enabled
     if (FAILED(hr)) return hr;
 
     *enabled = info.enabled;
-    if (taskrun_state(path, &state, &disabled))
+    if (taskrun_state(path, &state, &disabled, &forced))
     {
-        /* what the scheduler knows: running, queued; disabled by EnableTask */
