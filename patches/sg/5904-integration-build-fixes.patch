diff --git a/dlls/netapi32/netapi32.c b/dlls/netapi32/netapi32.c
--- a/dlls/netapi32/netapi32.c
+++ b/dlls/netapi32/netapi32.c
@@ -3748,8 +3748,9 @@ NetUserGetLocalGroups(LPCWSTR servername, LPCWSTR username, DWORD level,
                       LPDWORD entriesread, LPDWORD totalentries)
 {
     NET_API_STATUS status;
-    const WCHAR *names[ARRAY_SIZE(local_groups)];
-    UINT count = 0, i, j;
+    WCHAR **groups = NULL;
+    const WCHAR **names;
+    DWORD ngroups = 0, count = 0, i, j;
     SIZE_T size = 0;
     BYTE *buf, *ptr;
 
@@ -3762,45 +3763,57 @@ NetUserGetLocalGroups(LPCWSTR servername, LPCWSTR username, DWORD level,
     if (!username || !bufptr || !entriesread || !totalentries) return ERROR_INVALID_PARAMETER;
     if (!account_exists( username )) return NERR_UserNotFound;
 
-    for (i = 0; i < ARRAY_SIZE(local_groups); i++)
+    /* the local groups and their members are fast-a 3180's (sg_localgroup_*): a member is
+     * listed as "COMPUTER\name" */
+    if ((status = sg_localgroup_names( &groups, &ngroups ))) return status;
+    if (!(names = calloc( ngroups ? ngroups : 1, sizeof(*names) )))
+    {
+        sg_free_names( groups, ngroups );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    for (i = 0; i < ngroups; i++)
     {
         WCHAR **members;
-        UINT n = get_group_members( i, &members );
+        DWORD n = 0;
         BOOL member = FALSE;
 
+        if (sg_localgroup_members( groups[i], &members, &n )) continue;
         for (j = 0; j < n; j++)
         {
-            if (!wcsicmp( members[j], username )) member = TRUE;
-            free( members[j] );
+            const WCHAR *m = wcsrchr( members[j], '\\' );
+            if (!wcsicmp( m ? m + 1 : members[j], username )) member = TRUE;
         }
-        free( members );
+        sg_free_names( members, n );
         if (!member) continue;
-        names[count++] = local_groups[i].name;
-        size += sizeof(LOCALGROUP_USERS_INFO_0) + (wcslen( local_groups[i].name ) + 1) * sizeof(WCHAR);
+        names[count++] = groups[i];
+        size += sizeof(LOCALGROUP_USERS_INFO_0) + (wcslen( groups[i] ) + 1) * sizeof(WCHAR);
     }
     *entriesread = *totalentries = count;
     *bufptr = NULL;
+    status = NERR_Success;
     if (prefmaxlen != MAX_PREFERRED_LENGTH && prefmaxlen < size)
     {
         *entriesread = 0;
-        return ERROR_MORE_DATA;
+        status = ERROR_MORE_DATA;
     }
-    if ((status = NetApiBufferAllocate( size ? size : 1, (void **)&buf )))
-    {
+    else if ((status = NetApiBufferAllocate( size ? size : 1, (void **)&buf )))
         *entriesread = *totalentries = 0;
-        return status;
-    }
-    ptr = buf + count * sizeof(LOCALGROUP_USERS_INFO_0);
-    for (i = 0; i < count; i++)
+    else
     {
-        WCHAR *name = (WCHAR *)ptr;
+        ptr = buf + count * sizeof(LOCALGROUP_USERS_INFO_0);
+        for (i = 0; i < count; i++)
+        {
+            WCHAR *name = (WCHAR *)ptr;
 
-        wcscpy( name, names[i] );
-        ptr += (wcslen( name ) + 1) * sizeof(WCHAR);
-        ((LOCALGROUP_USERS_INFO_0 *)buf)[i].lgrui0_name = name;
+            wcscpy( name, names[i] );
+            ptr += (wcslen( name ) + 1) * sizeof(WCHAR);
+            ((LOCALGROUP_USERS_INFO_0 *)buf)[i].lgrui0_name = name;
+        }
+        *bufptr = buf;
     }
-    *bufptr = buf;
-    return NERR_Success;
+    free( names );
+    sg_free_names( groups, ngroups );
+    return status;
 }
 
