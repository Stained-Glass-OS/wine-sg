From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] netapi32, advapi32, crypt32, mciavi32: build fixes for the merged series (5904)

Build fixes for the merged series, found by the integration build:
- netapi32: fast-b 3532's NetUserGetLocalGroups was written on fast-b
  3528's read-only two-group table, which the integration replaced with
  fast-a 3180's local groups (DECISIONS item 7); it now asks 3180's
  sg_localgroup_names / sg_localgroup_members (members are "COMPUTER\name")
  and frees what it got on every path.
- advapi32: LookupSecurityDescriptorPartsA/W (fast-b 3734) take a
  PSECURITY_DESCRIPTOR as the documented prototype in aclapi.h says.
- crypt32: CryptMsgGetParam had CMSG_ENVELOPE_ALGORITHM_PARAM twice for
  decoded enveloped messages (stubs-6b 5303 and fast-b 3758); 5303's case
  (with its mutant) stays.
- mciavi32: MCIAVI_SendSignals (stubs-5 4023) is declared before its first use.

Integration patch (integ-2026-10).
---
diff --git a/dlls/advapi32/security.c b/dlls/advapi32/security.c
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -4790,7 +4790,7 @@ done:
  */
 DWORD WINAPI LookupSecurityDescriptorPartsW( TRUSTEEW **owner, TRUSTEEW **group, ULONG *access_count,
                                              EXPLICIT_ACCESSW **access_list, ULONG *audit_count,
-                                             EXPLICIT_ACCESSW **audit_list, SECURITY_DESCRIPTOR *descriptor )
+                                             EXPLICIT_ACCESSW **audit_list, PSECURITY_DESCRIPTOR descriptor )
 {
     SECURITY_DESCRIPTOR_CONTROL control;
     DWORD revision, err = ERROR_SUCCESS;
@@ -4863,7 +4863,7 @@ DWORD WINAPI LookupSecurityDescriptorPartsW( TRUSTEEW **owner, TRUSTEEW **group,
  */
 DWORD WINAPI LookupSecurityDescriptorPartsA( TRUSTEEA **owner, TRUSTEEA **group, ULONG *access_count,
                                              EXPLICIT_ACCESSA **access_list, ULONG *audit_count,
-                                             EXPLICIT_ACCESSA **audit_list, SECURITY_DESCRIPTOR *descriptor )
+                                             EXPLICIT_ACCESSA **audit_list, PSECURITY_DESCRIPTOR descriptor )
 {
     TRUSTEEW *ow = NULL, *gw = NULL;
     EXPLICIT_ACCESSW *aw = NULL, *uw = NULL;
diff --git a/dlls/crypt32/msg.c b/dlls/crypt32/msg.c
--- a/dlls/crypt32/msg.c
+++ b/dlls/crypt32/msg.c
@@ -4622,32 +4622,6 @@ static BOOL CDecodeEnvelopedMsg_GetParam(CDecodeMsg *msg, DWORD dwParamType,
         else
             SetLastError(CRYPT_E_INVALID_MSG_TYPE);
         break;
-    case CMSG_ENVELOPE_ALGORITHM_PARAM:
-        if (msg->u.enveloped_data.data)
-        {
-            const CRYPT_ALGORITHM_IDENTIFIER *id = &msg->u.enveloped_data.data->encryptedContentInfo.contentEncryptionAlgorithm;
-            DWORD oid_len = id->pszObjId ? strlen(id->pszObjId) + 1 : 0, size = sizeof(*id) + oid_len + id->Parameters.cbData;
-
-            if (!pvData) { *pcbData = size; ret = TRUE; }
-            else if (*pcbData < size) { *pcbData = size; SetLastError(ERROR_MORE_DATA); }
-            else
-            {
-                CRYPT_ALGORITHM_IDENTIFIER *out = pvData;
-                BYTE *next = (BYTE *)(out + 1);
-
-                out->pszObjId = oid_len ? (char *)next : NULL;
-                if (oid_len) memcpy(next, id->pszObjId, oid_len);
-                next += oid_len;
-                out->Parameters.cbData = id->Parameters.cbData;
-                out->Parameters.pbData = id->Parameters.cbData ? next : NULL;
-                if (id->Parameters.cbData) memcpy(next, id->Parameters.pbData, id->Parameters.cbData);
-                *pcbData = size;
-                ret = TRUE;
-            }
-        }
-        else
-            SetLastError(CRYPT_E_INVALID_MSG_TYPE);
-        break;
     case CMSG_RECIPIENT_COUNT_PARAM:
         if (msg->u.enveloped_data.data)
             ret = CRYPT_CopyParam(pvData, pcbData,
diff --git a/dlls/mciavi32/mciavi.c b/dlls/mciavi32/mciavi.c
--- a/dlls/mciavi32/mciavi.c
+++ b/dlls/mciavi32/mciavi.c
