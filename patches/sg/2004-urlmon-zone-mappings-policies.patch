+typedef struct {
+    IEnumString IEnumString_iface;
+    LONG ref;
+    WCHAR **strs;
+    ULONG count, pos;
+} StringEnum;
+
+static inline StringEnum *impl_from_IEnumString(IEnumString *iface)
+{
+    return CONTAINING_RECORD(iface, StringEnum, IEnumString_iface);
+}
+
+static HRESULT WINAPI StringEnum_QueryInterface(IEnumString *iface, REFIID riid, void **ppv)
+{
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumString)) {
+        *ppv = iface;
+        IEnumString_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI StringEnum_AddRef(IEnumString *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumString(iface)->ref);
+}
+
+static ULONG WINAPI StringEnum_Release(IEnumString *iface)
+{
+    StringEnum *This = impl_from_IEnumString(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref) {
+        ULONG i;
+        for(i = 0; i < This->count; i++)
+            free(This->strs[i]);
+        free(This->strs);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI StringEnum_Next(IEnumString *iface, ULONG celt, LPOLESTR *rgelt, ULONG *fetched)
+{
+    StringEnum *This = impl_from_IEnumString(iface);
+    ULONG n = 0;
+
+    if(!rgelt || (!fetched && celt > 1))
+        return E_POINTER;
+
+    while(n < celt && This->pos < This->count) {
+        const WCHAR *str = This->strs[This->pos];
+        SIZE_T size = (lstrlenW(str) + 1) * sizeof(WCHAR);
+
+        rgelt[n] = CoTaskMemAlloc(size);
+        if(!rgelt[n]) {
+            while(n--)
+                CoTaskMemFree(rgelt[n]);
+            if(fetched)
+                *fetched = 0;
+            return E_OUTOFMEMORY;
+        }
+        memcpy(rgelt[n], str, size);
+        n++;
+        This->pos++;
+    }
+
+    if(fetched)
+        *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI StringEnum_Skip(IEnumString *iface, ULONG celt)
+{
+    StringEnum *This = impl_from_IEnumString(iface);
+
+    if(celt > This->count - This->pos) {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI StringEnum_Reset(IEnumString *iface)
+{
+    impl_from_IEnumString(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_string_enum(WCHAR **strs, ULONG count, ULONG pos, IEnumString **ret);
+
+static HRESULT WINAPI StringEnum_Clone(IEnumString *iface, IEnumString **ret)
+{
+    StringEnum *This = impl_from_IEnumString(iface);
+    WCHAR **copy = NULL;
+    ULONG i;
+
+    if(!ret)
+        return E_POINTER;
+
+    if(This->count) {
+        copy = calloc(This->count, sizeof(*copy));
+        if(!copy)
+            return E_OUTOFMEMORY;
+        for(i = 0; i < This->count; i++) {
+            copy[i] = wcsdup(This->strs[i]);
+            if(!copy[i]) {
+                while(i--)
+                    free(copy[i]);
+                free(copy);
+                return E_OUTOFMEMORY;
+            }
+        }
+    }
+    return create_string_enum(copy, This->count, This->pos, ret);
+}
+
+static const IEnumStringVtbl StringEnumVtbl = {
+    StringEnum_QueryInterface,
+    StringEnum_AddRef,
+    StringEnum_Release,
+    StringEnum_Next,
+    StringEnum_Skip,
+    StringEnum_Reset,
+    StringEnum_Clone
+};
+
+/* Takes ownership of strs. */
+static HRESULT create_string_enum(WCHAR **strs, ULONG count, ULONG pos, IEnumString **ret)
+{
+    StringEnum *obj = calloc(1, sizeof(*obj));
+    ULONG i;
+
+    if(!obj) {
+        for(i = 0; i < count; i++)
+            free(strs[i]);
+        free(strs);
+        return E_OUTOFMEMORY;
+    }
+    obj->IEnumString_iface.lpVtbl = &StringEnumVtbl;
+    obj->ref = 1;
+    obj->strs = strs;
+    obj->count = count;
+    obj->pos = pos;
+    *ret = &obj->IEnumString_iface;
+    return S_OK;
+}
+
+/* Splits "scheme://host" into the registry location used by MapUrlToZone:
+ * ZoneMap\Domains\<domain>[\<subdomain>], value named after the scheme.
+ * A missing scheme means every scheme ("*"). */
+static HRESULT parse_zone_pattern(const WCHAR *pattern, WCHAR *scheme, WCHAR *domain, WCHAR *sub)
+{
+    const WCHAR *host, *sep, *dot;
+    WCHAR host_buf[MAX_PATH];
+    SIZE_T len, scheme_len;
+    int dots = 0;
+
+    sep = wcsstr(pattern, L"://");
+    if(sep) {
+        scheme_len = sep - pattern;
+        host = sep + 3;
+    }else{
+        scheme_len = 0;
+        host = pattern;
+    }
+    if(scheme_len >= 32)
+        return E_INVALIDARG;
+    if(!scheme_len) {
+        lstrcpyW(scheme, L"*");
+    }else{
+        memcpy(scheme, pattern, scheme_len * sizeof(WCHAR));
+        scheme[scheme_len] = 0;
+    }
+
+    len = lstrlenW(host);
+    while(len && host[len - 1] == '/')
+        len--;
+    if(!len || len >= ARRAY_SIZE(host_buf) || wcschr(host, '\\') || (wcschr(host, '/') && wcschr(host, '/') < host + len))
+        return E_INVALIDARG;
+    memcpy(host_buf, host, len * sizeof(WCHAR));
+    host_buf[len] = 0;
+    CharLowerBuffW(host_buf, len);
+    host = host_buf;
+
+    /* "*.example.com" is the domain key "example.com", which already covers
+     * its subdomains. */
+    if(host[0] == '*' && host[1] == '.' && host[2]) {
+        const WCHAR *rest = host + 2;
+        if(!wcschr(rest, '*') && (!(dot = wcschr(rest, '.')) || !wcschr(dot + 1, '.')))
+            host = rest;
+    }
+
+    for(dot = host; (dot = wcschr(dot, '.')); dot++)
+        dots++;
+    /* The domain is the last two labels, the rest is the subdomain. */
+    if(dots >= 2) {
+        const WCHAR *split = NULL;
+        const WCHAR *c;
+        int n = 0;
+        for(c = host + lstrlenW(host); c > host; c--) {
+            if(c[-1] == '.' && ++n == 2) { split = c; break; }
+        }
+        lstrcpyW(domain, split);
+        memcpy(sub, host, (split - 1 - host) * sizeof(WCHAR));
+        sub[split - 1 - host] = 0;
+        if(!*sub || !*domain)
+            return E_INVALIDARG;
+    }else{
+        lstrcpyW(domain, host);
+        *sub = 0;
+    }
+    return S_OK;
+}
+
+static BOOL key_is_empty(HKEY key)
+{
+    DWORD subkeys = 1, values = 1;
+
+    RegQueryInfoKeyW(key, NULL, NULL, NULL, &subkeys, NULL, NULL, &values, NULL, NULL, NULL, NULL);
+    return !subkeys && !values;
+}
+
+static HRESULT set_zone_mapping(DWORD zone, const WCHAR *pattern, DWORD flags)
+{
+    WCHAR scheme[32], domain[MAX_PATH], sub[MAX_PATH], path[2 * MAX_PATH + ARRAY_SIZE(wszZoneMapDomainsKey) + 4];
+    HKEY key;
+    HRESULT hres;
+    DWORD res;
+
+    if(!pattern || (flags != SZM_CREATE && flags != SZM_DELETE))
+        return E_INVALIDARG;
+
+    hres = parse_zone_pattern(pattern, scheme, domain, sub);
+    if(FAILED(hres))
+        return hres;
+
+    lstrcpyW(path, wszZoneMapDomainsKey);
+    lstrcatW(path, L"\\");
+    lstrcatW(path, domain);
+    if(*sub) {
+        lstrcatW(path, L"\\");
+        lstrcatW(path, sub);
+    }
+
+    if(flags == SZM_CREATE) {
+        res = RegCreateKeyExW(HKEY_CURRENT_USER, path, 0, NULL, 0, KEY_WRITE, NULL, &key, NULL);
+        if(res != ERROR_SUCCESS)
+            return HRESULT_FROM_WIN32(res);
+        res = RegSetValueExW(key, scheme, 0, REG_DWORD, (const BYTE*)&zone, sizeof(zone));
+        RegCloseKey(key);
+        return res == ERROR_SUCCESS ? S_OK : HRESULT_FROM_WIN32(res);
+    }
+
+    res = RegOpenKeyExW(HKEY_CURRENT_USER, path, 0, KEY_READ | KEY_WRITE, &key);
+    if(res != ERROR_SUCCESS)
+        return S_OK;
+    RegDeleteValueW(key, scheme);
+    res = key_is_empty(key);
+    RegCloseKey(key);
+
+    if(res) {
+        /* Remove the emptied keys, subdomain first. */
+        RegDeleteKeyW(HKEY_CURRENT_USER, path);
+        if(*sub) {
+            lstrcpyW(path, wszZoneMapDomainsKey);
+            lstrcatW(path, L"\\");
+            lstrcatW(path, domain);
+            if(!RegOpenKeyExW(HKEY_CURRENT_USER, path, 0, KEY_READ, &key)) {
+                BOOL empty = key_is_empty(key);
+                RegCloseKey(key);
+                if(empty)
+                    RegDeleteKeyW(HKEY_CURRENT_USER, path);
+            }
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT add_zone_pattern(WCHAR ***strs, ULONG *count, ULONG *cap, const WCHAR *scheme,
+        const WCHAR *sub, const WCHAR *domain)
+{
+    SIZE_T len = lstrlenW(scheme) + 3 + (sub ? lstrlenW(sub) + 1 : 0) + lstrlenW(domain) + 1;
+    WCHAR *str;
+
+    if(*count == *cap) {
+        ULONG ncap = *cap ? *cap * 2 : 8;
+        WCHAR **n = realloc(*strs, ncap * sizeof(**strs));
+        if(!n)
+            return E_OUTOFMEMORY;
+        *strs = n;
+        *cap = ncap;
+    }
+    str = malloc(len * sizeof(WCHAR));
+    if(!str)
+        return E_OUTOFMEMORY;
+    lstrcpyW(str, scheme);
+    lstrcatW(str, L"://");
+    if(sub) {
+        lstrcatW(str, sub);
+        lstrcatW(str, L".");
+    }
+    lstrcatW(str, domain);
+    (*strs)[(*count)++] = str;
+    return S_OK;
+}
+
+static HRESULT collect_zone_values(HKEY key, DWORD zone, const WCHAR *sub, const WCHAR *domain,
+        WCHAR ***strs, ULONG *count, ULONG *cap)
+{
+    WCHAR name[64];
+    DWORD i, len, type, value, size, res;
+
+    for(i = 0; ; i++) {
+        len = ARRAY_SIZE(name);
+        size = sizeof(value);
+        res = RegEnumValueW(key, i, name, &len, NULL, &type, (BYTE*)&value, &size);
+        if(res == ERROR_NO_MORE_ITEMS)
+            break;
+        if(res != ERROR_SUCCESS)
+            continue;
+        if(type == REG_DWORD && value == zone) {
+            HRESULT hres = add_zone_pattern(strs, count, cap, name, sub, domain);
+            if(FAILED(hres))
+                return hres;
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT collect_zone_mappings(HKEY root, DWORD zone, WCHAR ***strs, ULONG *count, ULONG *cap)
+{
+    HKEY domains, dkey, skey;
+    WCHAR domain[MAX_PATH], sub[MAX_PATH];
+    DWORD i, j, len;
+    HRESULT hres = S_OK;
+
+    if(RegOpenKeyExW(root, wszZoneMapDomainsKey, 0, KEY_READ, &domains))
+        return S_OK;
+
+    for(i = 0; SUCCEEDED(hres); i++) {
+        len = ARRAY_SIZE(domain);
+        if(RegEnumKeyExW(domains, i, domain, &len, NULL, NULL, NULL, NULL))
+            break;
+        if(RegOpenKeyExW(domains, domain, 0, KEY_READ, &dkey))
+            continue;
+        hres = collect_zone_values(dkey, zone, NULL, domain, strs, count, cap);
+        for(j = 0; SUCCEEDED(hres); j++) {
+            len = ARRAY_SIZE(sub);
+            if(RegEnumKeyExW(dkey, j, sub, &len, NULL, NULL, NULL, NULL))
+                break;
+            if(RegOpenKeyExW(dkey, sub, 0, KEY_READ, &skey))
+                continue;
+            hres = collect_zone_values(skey, zone, sub, domain, strs, count, cap);
+            RegCloseKey(skey);
+        }
+        RegCloseKey(dkey);
+    }
+    RegCloseKey(domains);
+    return hres;
+}
+
+static HRESULT get_zone_mappings(DWORD zone, IEnumString **ret)
+{
+    WCHAR **strs = NULL;
+    ULONG count = 0, cap = 0, i;
+    HRESULT hres;
+
+    if(!ret)
+        return E_INVALIDARG;
+    *ret = NULL;
+
+    hres = collect_zone_mappings(HKEY_CURRENT_USER, zone, &strs, &count, &cap);
+    if(SUCCEEDED(hres))
+        hres = collect_zone_mappings(HKEY_LOCAL_MACHINE, zone, &strs, &count, &cap);
+    if(FAILED(hres)) {
+        for(i = 0; i < count; i++)
+            free(strs[i]);
+        free(strs);
+        return hres;
+    }
+    return create_string_enum(strs, count, 0, ret);
+}
+
