+/* an enumerator of the collection's tasks, as VARIANTs holding IDispatch */
+typedef struct
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref, pos;
+    IRegisteredTaskCollection *regtasks;
+} regtasks_enum;
+
+static inline regtasks_enum *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, regtasks_enum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI regtasks_enum_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IEnumVARIANT) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        IEnumVARIANT_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI regtasks_enum_AddRef(IEnumVARIANT *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumVARIANT(iface)->ref);
+}
+
+static ULONG WINAPI regtasks_enum_Release(IEnumVARIANT *iface)
+{
+    regtasks_enum *e = impl_from_IEnumVARIANT(iface);
+    LONG ref = InterlockedDecrement(&e->ref);
+
+    if (!ref)
+    {
+        IRegisteredTaskCollection_Release(e->regtasks);
+        free(e);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI regtasks_enum_Next(IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched)
+{
+    regtasks_enum *e = impl_from_IEnumVARIANT(iface);
+    LONG count = 0;
+    ULONG n = 0;
+
+    IRegisteredTaskCollection_get_Count(e->regtasks, &count);
+    while (n < celt && e->pos < count)
+    {
+        IRegisteredTask *task;
+        VARIANT index;
+
+        V_VT(&index) = VT_I4;
+        V_I4(&index) = ++e->pos;
+        if (FAILED(IRegisteredTaskCollection_get_Item(e->regtasks, index, &task))) continue;
+        V_VT(&var[n]) = VT_DISPATCH;
+        V_DISPATCH(&var[n]) = (IDispatch *)task;
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI regtasks_enum_Skip(IEnumVARIANT *iface, ULONG celt)
+{
+    impl_from_IEnumVARIANT(iface)->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI regtasks_enum_Reset(IEnumVARIANT *iface)
+{
+    impl_from_IEnumVARIANT(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI regtasks_enum_Clone(IEnumVARIANT *iface, IEnumVARIANT **out)
+{
     return E_NOTIMPL;
 }
 
+static const IEnumVARIANTVtbl regtasks_enum_vtbl =
+{
+    regtasks_enum_QueryInterface,
+    regtasks_enum_AddRef,
+    regtasks_enum_Release,
+    regtasks_enum_Next,
+    regtasks_enum_Skip,
+    regtasks_enum_Reset,
+    regtasks_enum_Clone
+};
