+}
+
+static HRESULT WINAPI network_QueryInterface(INetworkSettings *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_INetworkSettings) || IsEqualGUID(riid, &IID_IDispatch) ||
+        IsEqualGUID(riid, &IID_IUnknown))
+    {
+        INetworkSettings_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI network_AddRef(INetworkSettings *iface)
+{
+    return InterlockedIncrement(&impl_from_INetworkSettings(iface)->ref);
+}
+
+static ULONG WINAPI network_Release(INetworkSettings *iface)
+{
+    struct network_settings *network = impl_from_INetworkSettings(iface);
+    LONG ref = InterlockedDecrement(&network->ref);
+
+    if (!ref)
+    {
+        free(network->name);
+        free(network->id);
+        free(network);
+    }
+    return ref;
+}
