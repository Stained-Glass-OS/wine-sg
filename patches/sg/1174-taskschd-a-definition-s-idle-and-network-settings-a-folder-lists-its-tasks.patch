+/* Windows' defaults: ten minutes idle, wait an hour, stop when no longer idle */
+HRESULT IdleSettings_create(IIdleSettings **obj)
+{
+    struct idle_settings *idle;
+
+    if (!(idle = calloc(1, sizeof(*idle)))) return E_OUTOFMEMORY;
+    idle->IIdleSettings_iface.lpVtbl = &idle_vtbl;
+    idle->ref = 1;
+    idle->duration = wcsdup(L"PT10M");
+    idle->wait_timeout = wcsdup(L"PT1H");
+    idle->stop_on_idle_end = TRUE;
+    *obj = &idle->IIdleSettings_iface;
+    return S_OK;
+}
+
+/* the values of another idle settings object into ours */
+void IdleSettings_copy(IIdleSettings *to, IIdleSettings *from)
+{
+    VARIANT_BOOL stop = VARIANT_TRUE, restart = VARIANT_FALSE;
+    BSTR duration = NULL, timeout = NULL;
+
+    if (to == from) return;
+    IIdleSettings_get_IdleDuration(from, &duration);
+    IIdleSettings_get_WaitTimeout(from, &timeout);
+    IIdleSettings_get_StopOnIdleEnd(from, &stop);
+    IIdleSettings_get_RestartOnIdle(from, &restart);
+    IIdleSettings_put_IdleDuration(to, duration);
+    IIdleSettings_put_WaitTimeout(to, timeout);
+    IIdleSettings_put_StopOnIdleEnd(to, stop);
+    IIdleSettings_put_RestartOnIdle(to, restart);
+    SysFreeString(duration);
+    SysFreeString(timeout);
+}
