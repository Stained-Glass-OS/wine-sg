+static void idle_child(ITaskSettings *taskset, const WCHAR *name, const WCHAR *value)
+{
+    IIdleSettings *idle;
+
+    if (FAILED(ITaskSettings_get_IdleSettings(taskset, &idle))) return;
+    if (!lstrcmpW(name, L"Duration")) IIdleSettings_put_IdleDuration(idle, (BSTR)value);
+    else if (!lstrcmpW(name, L"WaitTimeout")) IIdleSettings_put_WaitTimeout(idle, (BSTR)value);
+    else if (!lstrcmpW(name, L"StopOnIdleEnd")) IIdleSettings_put_StopOnIdleEnd(idle, !lstrcmpW(value, L"true"));
+    else if (!lstrcmpW(name, L"RestartOnIdle")) IIdleSettings_put_RestartOnIdle(idle, !lstrcmpW(value, L"true"));
+    IIdleSettings_Release(idle);
+}
