+#ifndef SG_MUTANT_DEAD_LINK_ERROR
+    if ( !This->sComponent && link_target_gone( path ) )
+    {
+        BOOL ui = !(lpici->fMask & CMIC_MASK_FLAG_NO_UI);
+        TRACE("target %s is gone\n", debugstr_w(path) );
+        if (ui) dead_link_ask( This, lpici->hwnd, path );
+        free( path );
+        /* ShellExecute stops here: nothing more to show */
+        shelllink_set_error( ui ? ERROR_CANCELLED : ERROR_FILE_NOT_FOUND );
+        return HRESULT_FROM_WIN32( ERROR_CANCELLED );
+    }
