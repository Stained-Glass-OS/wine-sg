@@ -3086,6 +3146,31 @@
     if (link_process_tls != TLS_OUT_OF_INDEXES) TlsSetValue( link_process_tls, value );
 }
 
+static DWORD link_error_tls = TLS_OUT_OF_INDEXES;
+static INIT_ONCE link_error_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL WINAPI link_error_init( INIT_ONCE *once, void *param, void **context )
+{
+    link_error_tls = TlsAlloc();
+    return TRUE;
+}
+
+void shelllink_set_error( DWORD error )
+{
+    InitOnceExecuteOnce( &link_error_once, link_error_init, NULL, NULL );
+    if (link_error_tls != TLS_OUT_OF_INDEXES) TlsSetValue( link_error_tls, (void *)(ULONG_PTR)error );
+}
+
+DWORD shelllink_take_error( void )
+{
+    DWORD error;
+    InitOnceExecuteOnce( &link_error_once, link_error_init, NULL, NULL );
+    if (link_error_tls == TLS_OUT_OF_INDEXES) return ERROR_CANCELLED;
+    error = (DWORD)(ULONG_PTR)TlsGetValue( link_error_tls );
+    TlsSetValue( link_error_tls, NULL );
+    return error ? error : ERROR_CANCELLED;
+}
+
 void shelllink_want_process( BOOL want )
 {
     HANDLE old = link_process_get();
