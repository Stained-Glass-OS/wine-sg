+/* Stained Glass OS: a shortcut whose program is gone -- its target a path on
+ * a fixed local disk that is not there (an uninstaller that left Zoom
+ * Workplace's desktop shortcut). Windows says so and offers to delete the
+ * shortcut ("Problem with Shortcut"); here ShellExecute said "Path not found."
+ * A target on a network or removable drive, or one that cannot be checked,
+ * counts as there. */
+static BOOL link_target_gone( const WCHAR *path )
+{
+    WCHAR full[MAX_PATH], root[4];
+    DWORD err;
+
+    if (!path || !ExpandEnvironmentStringsW( path, full, ARRAY_SIZE(full) )) return FALSE;
+    if (!iswalpha( full[0] ) || full[1] != ':' || full[2] != '\\') return FALSE;
+    root[0] = full[0]; root[1] = ':'; root[2] = '\\'; root[3] = 0;
+    if (GetDriveTypeW( root ) != DRIVE_FIXED) return FALSE;
+    if (GetFileAttributesW( full ) != INVALID_FILE_ATTRIBUTES) return FALSE;
+    err = GetLastError();
+    return err == ERROR_FILE_NOT_FOUND || err == ERROR_PATH_NOT_FOUND;
+}
+
+/* asks whether to delete the shortcut; Yes puts it in the Recycle Bin
+ * (SHFileOperation, which asks for an administrator's consent for a shortcut
+ * everyone shares, as on the Public desktop) */
+static void dead_link_ask( IShellLinkImpl *This, HWND hwnd, const WCHAR *path )
+{
+    WCHAR msg[MAX_PATH + 256], from[MAX_PATH + 1];
+    SHFILEOPSTRUCTW op;
+
+    swprintf( msg, ARRAY_SIZE(msg), L"The item \"%s\" that this shortcut opens has been moved or removed, "
+              L"so the shortcut no longer works.\n\nDo you want to delete this shortcut?", PathFindFileNameW( path ) );
+    if (MessageBoxW( hwnd, msg, L"Problem with Shortcut", MB_YESNO | MB_ICONWARNING ) != IDYES) return;
+    if (!This->filepath || lstrlenW( This->filepath ) >= MAX_PATH) return;
+    memset( from, 0, sizeof(from) );
+    lstrcpyW( from, This->filepath );
+    memset( &op, 0, sizeof(op) );
+    op.hwnd = hwnd;
+    op.wFunc = FO_DELETE;
+    op.pFrom = from;
+    op.fFlags = FOF_ALLOWUNDO | FOF_NOCONFIRMATION;
+    SHFileOperationW( &op );
+}
+
