From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwmapi: the thumbnail thread costs nothing while nothing changes (3714)

dwmapi: the thumbnail thread costs nothing while nothing changes

The painting thread of 3712 woke every 50 ms for as long as a thumbnail was
registered. It now sleeps until the properties change while none is
visible, looks every 50 ms only while pictures change, once a second after
ten quiet rounds (and when thumbnails keep repainting each other), ends
with its last thumbnail, and drops a thumbnail whose destination window was
destroyed.
---
diff --git a/dlls/dwmapi/dwmapi_main.c b/dlls/dwmapi/dwmapi_main.c
index ad2bb87..7219d6a 100644
--- a/dlls/dwmapi/dwmapi_main.c
+++ b/dlls/dwmapi/dwmapi_main.c
@@ -769,6 +769,8 @@ static CRITICAL_SECTION_DEBUG thumbnail_cs_debug =
 };
 static CRITICAL_SECTION thumbnail_cs = { &thumbnail_cs_debug, -1, 0, 0, 0, 0 };
 static HANDLE thumbnail_thread;
+static HANDLE thumbnail_event;     /* signalled when the properties change */
+static LONG thumbnail_activity;   /* counts pictures that changed or were painted */
 static ULONG_PTR next_thumbnail = 0x100;
 
 static struct thumbnail *find_thumbnail( HTHUMBNAIL id )
@@ -868,6 +870,7 @@ static void refresh_picture( struct picture *pic, const struct thumbnail *t )
         if (!pic->bitmap || pic->width != size.cx || pic->height != size.cy ||
             !same_pixels( bits, pic->bits, size.cx * size.cy ))
             pic->picture_new = TRUE;
+        if (pic->picture_new) InterlockedIncrement( &thumbnail_activity );
         if (pic->bitmap) DeleteObject( pic->bitmap );
         pic->bitmap = bitmap;
         pic->bits = bits;
@@ -970,6 +973,7 @@ static void paint_thumbnail( struct picture *pic, const struct thumbnail *t )
         if (now && same_pixels( now, pic->stale, (pic->stale_rect.right - pic->stale_rect.left) *
                                                 (pic->stale_rect.bottom - pic->stale_rect.top) ) && ++pic->stale_wait < 10)
         {
+            InterlockedIncrement( &thumbnail_activity );
             InvalidateRect( t->dest, &pic->stale_rect, TRUE );
             free( now );
             ReleaseDC( t->dest, dc );
@@ -995,12 +999,14 @@ static void paint_thumbnail( struct picture *pic, const struct thumbnail *t )
 #endif
     {
         /* our own blend is what is there: have the destination draw under it again */
+        InterlockedIncrement( &thumbnail_activity );
         InvalidateRect( t->dest, &dest, TRUE );
         free( pic->composite );
         pic->composite = NULL;
         ReleaseDC( t->dest, dc );
         return;
     }
+    InterlockedIncrement( &thumbnail_activity );
     draw_thumbnail( pic, t->opacity, dc, &dest, &src );
     free( pic->composite );
     pic->composite = capture_dest( dc, &dest );
@@ -1020,21 +1026,43 @@ static struct picture *find_picture( HTHUMBNAIL id )
 
 static DWORD WINAPI thumbnail_thread_proc( void *arg )
 {
-    DWORD tick = 0;
+    DWORD tick = 0, quiet = 0, busy = 0;
+    BOOL waiting = FALSE;
 
     for (;;)
     {
-        struct thumbnail work[16], *t;
+        struct thumbnail work[16], *t, *next_t;
         struct picture *pic, *next;
         unsigned int count = 0, i;
         BOOL idle;
-
-        Sleep( 50 );
+        LONG activity;
+        DWORD timeout;
+
+        /* Pictures are looked at every 50 ms while they change, every second
+         * once ten rounds found nothing to do, and not at all while no
+         * thumbnail is visible: the thread sleeps until the properties change. */
+        timeout = waiting ? INFINITE : (quiet < 10 && busy < 40) ? 50 : 1000;
+#ifdef SG_MUTANT_THUMB_SPIN
+        timeout = 0;
+#endif
+        if (WaitForSingleObject( thumbnail_event, timeout ) == WAIT_OBJECT_0) quiet = busy = 0;
+        activity = thumbnail_activity;
 
         EnterCriticalSection( &thumbnail_cs );
+        /* a thumbnail ends with its destination window */
+        LIST_FOR_EACH_ENTRY_SAFE( t, next_t, &thumbnails, struct thumbnail, entry )
+            if (t->dest != GetDesktopWindow() && !IsWindow( t->dest ))
+            {
+                list_remove( &t->entry );
+                free( t );
+            }
         LIST_FOR_EACH_ENTRY( t, &thumbnails, struct thumbnail, entry )
             if (t->visible && count < ARRAY_SIZE(work)) work[count++] = *t;
+        waiting = !count;
         idle = list_empty( &thumbnails );
+#ifdef SG_MUTANT_THUMB_NOEXIT
+        idle = FALSE;
+#endif
         if (idle)
         {
             CloseHandle( thumbnail_thread );
@@ -1068,6 +1096,7 @@ static DWORD WINAPI thumbnail_thread_proc( void *arg )
             {
                 /* new properties: the picture is taken again and painted afresh */
                 pic->generation = work[i].generation;
+                InterlockedIncrement( &thumbnail_activity );
                 free( pic->stale );
                 pic->stale = pic->composite;     /* what is on the destination now */
                 pic->stale_rect = pic->composite_rect;
@@ -1082,7 +1111,7 @@ static DWORD WINAPI thumbnail_thread_proc( void *arg )
                 }
                 pic->client_only = work[i].client_only;
             }
-            if (!pic->bitmap || !(tick % 2)) refresh_picture( pic, &work[i] );
+            if (1) refresh_picture( pic, &work[i] );
             paint_thumbnail( pic, &work[i] );
 
             /* unregistered or hidden while it was drawn: take it back */
@@ -1096,6 +1125,8 @@ static DWORD WINAPI thumbnail_thread_proc( void *arg )
 #endif
         }
         tick++;
+        if (thumbnail_activity != activity) { quiet = 0; if (busy < 1000) busy++; }
+        else { busy = 0; if (quiet < 1000) quiet++; }
     }
 }
 
@@ -1134,6 +1165,7 @@ HRESULT WINAPI DwmRegisterThumbnail(HWND dest, HWND src, PHTHUMBNAIL thumbnail_i
     list_add_tail( &thumbnails, &t->entry );
     *thumbnail_id = t->id;
 #ifdef SG_MUTANT_THUMB_VISIBLE_DEFAULT
+    if (!thumbnail_event) thumbnail_event = CreateEventW( NULL, FALSE, FALSE, NULL );
     if (!thumbnail_thread) thumbnail_thread = CreateThread( NULL, 0, thumbnail_thread_proc, NULL, 0, NULL );
 #endif
     LeaveCriticalSection( &thumbnail_cs );
@@ -1163,6 +1195,7 @@ HRESULT WINAPI DwmUnregisterThumbnail(HTHUMBNAIL thumbnail)
         list_remove( &t->entry );
         free( t );
         hr = S_OK;
+        if (thumbnail_event) SetEvent( thumbnail_event );   /* the thread may be the last one's */
     }
     LeaveCriticalSection( &thumbnail_cs );
     /* what it covered is the destination's to draw again */
@@ -1199,8 +1232,10 @@ HRESULT WINAPI DwmUpdateThumbnailProperties(HTHUMBNAIL thumbnail, const DWM_THUM
         if (props->dwFlags & DWM_TNP_VISIBLE) t->visible = !!props->fVisible;
         if (props->dwFlags & DWM_TNP_SOURCECLIENTAREAONLY) t->client_only = !!props->fSourceClientAreaOnly;
         t->generation++;
+        if (!thumbnail_event) thumbnail_event = CreateEventW( NULL, FALSE, FALSE, NULL );
         if (t->visible && !thumbnail_thread)
             thumbnail_thread = CreateThread( NULL, 0, thumbnail_thread_proc, NULL, 0, NULL );
+        if (thumbnail_event) SetEvent( thumbnail_event );
         hr = S_OK;
     }
     LeaveCriticalSection( &thumbnail_cs );
