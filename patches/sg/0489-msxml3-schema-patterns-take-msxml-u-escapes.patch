From: Stained Glass OS <dev@stained-glass.example>
Subject: msxml3: schema patterns take MSXML's \uXXXX escapes

MSXML's XML Schema patterns take \uXXXX escapes, which XML Schema's regular
expressions, and libxml2's, do not. Office's installer (Click-to-Run) loads
App-V's manifest schema, whose patterns say
"[^\uFDD0-\uFDEF\uFFF9-\uFFFF\p{IsPrivateUse}]+": the whole schema failed
to parse, adding it to a schema cache failed with E_FAIL, and Office stopped
with error 30175-45 (App-V's xmlutils.cpp:624, OISVAPI::ConfigurePackage).

The copy of the schema libxml2 parses has its patterns' \uXXXX escapes
written as the characters themselves -- escaped again where a regular
expression gives them a meaning (\uXXXX of a dot is a literal dot), a
surrogate pair as its character, a lone surrogate as U+FFFD, and U+0000
(which no XML text holds) as U+0001. An escaped backslash before "u" is left
as it is.

Gate: test/xsdpattern-gate.sh (added, and validating by the escapes).
---
--- a/dlls/msxml3/schema.c
+++ b/dlls/msxml3/schema.c
@@ -852,6 +852,76 @@
     return TRUE;
 }
 
+/* MSXML's schema patterns take \uXXXX escapes (App-V's manifest schema, which
+ * Office's installer loads, has "[^\uFDD0-\uFDEF...]"); XML Schema's regular
+ * expressions, and libxml2's, do not, so the whole schema failed to parse and
+ * adding it failed with E_FAIL. The escapes become the characters themselves
+ * (escaped again where a regular expression gives them a meaning; U+0000,
+ * which no XML text holds, becomes U+0001; a lone surrogate U+FFFD). */
+static int pattern_hex4(const xmlChar *p)
+{
+    int i, v = 0;
+    for (i = 0; i < 4; i++)
+    {
+        xmlChar c = p[i];
+        v <<= 4;
+        if (c >= '0' && c <= '9') v |= c - '0';
+        else if (c >= 'a' && c <= 'f') v |= c - 'a' + 10;
+        else if (c >= 'A' && c <= 'F') v |= c - 'A' + 10;
+        else return -1;
+    }
+    return v;
+}
+
+static xmlChar *unescape_pattern(const xmlChar *in)
+{
+    xmlChar *out = malloc(strlen((const char *)in) * 2 + 1), *o = out;
+    const xmlChar *p = in;
+
+    if (!out) return NULL;
+    while (*p)
+    {
+        int cp, lo;
+        if (p[0] != '\\' || !p[1]) { *o++ = *p++; continue; }
+        if (p[1] != 'u' || (cp = pattern_hex4(p + 2)) < 0) { *o++ = *p++; *o++ = *p++; continue; }
+        p += 6;
+        if (cp >= 0xd800 && cp <= 0xdbff && p[0] == '\\' && p[1] == 'u' &&
+            (lo = pattern_hex4(p + 2)) >= 0xdc00 && lo <= 0xdfff)
+        {
+            cp = 0x10000 + ((cp - 0xd800) << 10) + (lo - 0xdc00);
+            p += 6;
+        }
+        else if (cp >= 0xd800 && cp <= 0xdfff) cp = 0xfffd;
+        if (!cp) cp = 1;
+        if (cp < 0x80 && strchr("\\|.-^?*+{}()[]", cp)) { *o++ = '\\'; *o++ = cp; }
+        else o += xmlCopyCharMultiByte(o, cp);
+    }
+    *o = 0;
+    return out;
+}
+
+static void fix_pattern_escapes(xmlNodePtr node)
+{
+    for (; node; node = node->next)
+    {
+        xmlChar *value, *fixed;
+
+        if (node->type != XML_ELEMENT_NODE) continue;
+        if (node->ns && xmlStrEqual(node->ns->href, XSD_nsURI) && xmlStrEqual(node->name, BAD_CAST "pattern") &&
+            (value = xmlGetNoNsProp(node, BAD_CAST "value")))
+        {
+            if (strstr((const char *)value, "\\u") && (fixed = unescape_pattern(value)))
+            {
+                TRACE("pattern %s -> %s\n", debugstr_a((const char *)value), debugstr_a((const char *)fixed));
+                xmlSetProp(node, BAD_CAST "value", fixed);
+                free(fixed);
+            }
+            xmlFree(value);
+        }
+        fix_pattern_escapes(node->children);
+    }
+}
+
 static cache_entry* cache_entry_from_xsd_doc(xmlDocPtr doc, xmlChar const* nsURI, MSXML_VERSION v)
 {
     cache_entry* entry = malloc(sizeof(cache_entry));
@@ -859,6 +929,7 @@
     xmlDocPtr new_doc = xmlCopyDoc(doc, 1);
 
     link_datatypes(new_doc);
+    fix_pattern_escapes(xmlDocGetRootElement(new_doc));
 
     /* TODO: if the nsURI is different from the default xmlns or targetNamespace,
      *       do we need to do something special here? */
