From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] iphlpapi: an adapter's DHCP state, server and lease from the TCP/IP keys (9251)

GetAdaptersInfo said DhcpEnabled for every adapter (FIXME) with no DHCP server and no lease times; GetAdaptersAddresses never set IP_ADAPTER_DHCP_ENABLED nor Dhcpv4Server, so ipconfig /all said 'DHCP Enabled: No' everywhere and .NET's IsDhcpEnabled/DhcpServerAddresses were wrong. Both now read Tcpip\Parameters\Interfaces\{GUID} (EnableDHCP, DhcpServer, LeaseObtainedTime, LeaseTerminatesTime), which nsiproxy keeps (9250); an adapter without the key is on DHCP, Windows' default.

Gate: test-tcpipreg (GetAdaptersInfo, GetAdaptersAddresses, ipconfig /all, .NET NetworkInterface). Mutant SG_MUTANT_GAI_DHCP_ALWAYS.
---
--- a/dlls/iphlpapi/iphlpapi_main.c
+++ b/dlls/iphlpapi/iphlpapi_main.c
@@ -19,6 +19,7 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 #include <stdarg.h>
+#include <stdio.h>
 
 #define IPHLPAPI_DLL_LINKAGE
 #include "windef.h"
@@ -729,6 +730,44 @@
     s->Context = ctxt;
 }
 
+/* Stained Glass OS: an adapter's DHCP state, from the TCP/IP keys nsiproxy keeps as Windows' TCP/IP
+ * driver and DHCP client do (Tcpip\Parameters\Interfaces\{GUID}). Without them an adapter is on
+ * DHCP, the default for a new adapter. */
+static BOOL adapter_dhcp_state( const char *guid, char *server, DWORD server_len, time_t *obtained, time_t *expires )
+{
+    char path[128];
+    DWORD type, value, size;
+    BOOL dhcp = TRUE;
+    HKEY key;
+
+    if (server) *server = 0;
+    if (obtained) *obtained = 0;
+    if (expires) *expires = 0;
+#ifdef SG_MUTANT_GAI_DHCP_ALWAYS
+    return TRUE;
+#endif
+    snprintf( path, sizeof(path), "System\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces\\%s", guid );
+    if (RegOpenKeyExA( HKEY_LOCAL_MACHINE, path, 0, KEY_QUERY_VALUE, &key )) return TRUE;
+    size = sizeof(value);
+    if (!RegQueryValueExA( key, "EnableDHCP", NULL, &type, (BYTE *)&value, &size ) && type == REG_DWORD)
+        dhcp = !!value;
+    if (dhcp)
+    {
+        size = server_len;
+        if (server && (RegQueryValueExA( key, "DhcpServer", NULL, &type, (BYTE *)server, &size ) || type != REG_SZ))
+            *server = 0;
+        if (server && server_len) server[server_len - 1] = 0;
+        size = sizeof(value);
+        if (obtained && !RegQueryValueExA( key, "LeaseObtainedTime", NULL, &type, (BYTE *)&value, &size ) && type == REG_DWORD)
+            *obtained = value;
+        size = sizeof(value);
+        if (expires && !RegQueryValueExA( key, "LeaseTerminatesTime", NULL, &type, (BYTE *)&value, &size ) && type == REG_DWORD)
+            *expires = value;
+    }
+    RegCloseKey( key );
+    return dhcp;
+}
+
 /******************************************************************
  *    GetAdaptersInfo (IPHLPAPI.@)
  *
