From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdi32: document events for printer drivers (DrvDocumentEvent)

GDI tells a printer's configuration DLL of each printing call through
winspool's DocumentEvent (Microsoft Learn, DrvDocumentEvent and
DOCEVENT_FILTER); ours never did:

- gdi32: CreateDC asks which events the driver wants
  (DOCUMENTEVENT_QUERYFILTER), then tells it of the DC's creation
  (CREATEDCPRE, with the printer's settings when the program gave none; the
  driver may give settings of its own) and, if it answered that with
  success, of the DC's other calls: CREATEDCPOST, RESETDCPRE/POST,
  STARTDOCPRE (which can refuse the document) and STARTDOCPOST with the job,
  STARTPAGE, ENDPAGE, ENDDOCPRE, ENDDOCPOST, ABORTDOC and DELETEDC.
  Brother's and HP's drivers answer the creation with failure and hear
  nothing more, as on Windows. OKI's PostScript driver (B930) prepares its
  pages there: it wrote its header and nothing else before, and prints
  whole documents now.
- gdi32: a spooled job is scheduled after ENDDOCPOST, as Windows' spooler
  prints it after GDI is done with it.

Test: test/drvpkg-gate.sh (mutants SG_MUTANT_DOCEVENT, ENDDOCPOST,
EVENTSOFF).
---
--- a/dlls/gdi32/dc.c
+++ b/dlls/gdi32/dc.c
@@ -26,6 +26,7 @@
 #include "ddrawgdi.h"
 #include "winnls.h"
 #include "winppi.h"
+#include "ddk/winddiui.h"
 
 #include "wine/list.h"
 #include "wine/debug.h"
@@ -75,6 +76,7 @@
     WCHAR *output;
     enum print_flags flags;
     DEVMODEW *devmode;
+    UINT events;      /* the document events the driver hears (bit per event) */
 };
 
 BOOL WINAPI SeekPrinter( HANDLE, LARGE_INTEGER, LARGE_INTEGER*, DWORD, BOOL );
@@ -326,6 +328,49 @@
     ClosePrinter( printer );
 }
 
+/* GDI tells the printer's configuration DLL of each printing call it makes
+ * (DrvDocumentEvent): makers' drivers prepare and finish their jobs there */
+static int doc_event( HANDLE printer, HDC hdc, int esc, ULONG cb_in, void *in, ULONG cb_out, void *out )
+{
+#ifdef SG_MUTANT_DOCEVENT
+    return DOCUMENTEVENT_UNSUPPORTED;
+#endif
+    if (!printer) return DOCUMENTEVENT_UNSUPPORTED;
+    return DocumentEvent( printer, hdc, esc, cb_in, in, cb_out, out );
+}
+
+static int print_event( struct print *print, HDC hdc, int esc, ULONG cb_in, void *in, ULONG cb_out, void *out )
+{
+    if (!print || !(print->events & (1u << esc))) return DOCUMENTEVENT_UNSUPPORTED;
+    return doc_event( print->printer, hdc, esc, cb_in, in, cb_out, out );
+}
+
+/* which events the driver hears: those it lists (DOCUMENTEVENT_QUERYFILTER),
+ * or all; none when it does not answer DOCUMENTEVENT_CREATEDCPRE with success
+ * (Microsoft Learn, DOCEVENT_FILTER) */
+static UINT query_events( HANDLE printer, DOCEVENT_CREATEDCPRE *pre )
+{
+    struct { DOCEVENT_FILTER filter; DWORD more[DOCUMENTEVENT_LAST]; } buf;
+    UINT events = ~0u, i;
+
+    memset( &buf, 0, sizeof(buf) );
+    buf.filter.cElementsAllocated = DOCUMENTEVENT_LAST - 1;
+    buf.filter.cElementsNeeded = 0xffffffff;
+    buf.filter.cElementsReturned = 0xffffffff;
+    if (doc_event( printer, 0, DOCUMENTEVENT_QUERYFILTER, sizeof(*pre), pre, sizeof(buf), &buf ) ==
+        DOCUMENTEVENT_SUCCESS && buf.filter.cElementsReturned != 0xffffffff &&
+        buf.filter.cElementsReturned <= buf.filter.cElementsAllocated)
+    {
+        const DWORD *calls = (const DWORD *)((const BYTE *)&buf + offsetof( DOCEVENT_FILTER, aDocEventCall ));
+
+        events = 0;
+        for (i = 0; i < buf.filter.cElementsReturned; i++)
+            if (calls[i] < 32) events |= 1u << calls[i];
+        TRACE( "the driver hears events %#x\n", events );
+    }
+    return events;
+}
+
 /***********************************************************************
  *           CreateDCW    (GDI32.@)
  */
@@ -345,6 +390,7 @@
     struct print *print = NULL;
     BOOL is_display = FALSE;
     HANDLE hspool = NULL;
+    DEVMODEW *driver_dm = NULL, *default_dm = NULL;
     DC_ATTR *dc_attr;
     HDC ret;
 
@@ -402,6 +448,35 @@
         return 0;
     }
 
+    if (hspool)
+    {
+        DOCEVENT_CREATEDCPRE pre = { (WCHAR *)driver, (WCHAR *)device, (DEVMODEW *)devmode, FALSE };
+        LONG size;
+
+        /* without the program's settings, the driver is told the printer's */
+        if (!devmode && (size = DocumentPropertiesW( NULL, hspool, (WCHAR *)device, NULL, NULL, 0 )) > 0 &&
+            (default_dm = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, size )))
+        {
+            default_dm->dmSize = size;
+            if (DocumentPropertiesW( NULL, hspool, (WCHAR *)device, default_dm, NULL, DM_OUT_BUFFER ) == IDOK)
+                pre.pdm = default_dm;
+        }
+
+        /* the driver may give the settings to use instead of the program's;
+         * its answer says whether it wants to hear of the DC's other calls
+         * (Brother's and HP's do not) */
+        print->events = query_events( hspool, &pre );
+        if (doc_event( hspool, 0, DOCUMENTEVENT_CREATEDCPRE, sizeof(pre), &pre, sizeof(driver_dm),
+                       &driver_dm ) != DOCUMENTEVENT_SUCCESS)
+        {
+#ifndef SG_MUTANT_EVENTSOFF
+            print->events = 0;
+#endif
+            driver_dm = NULL;
+        }
+        if (driver_dm && print_copy_devmode( print, driver_dm )) devmode = driver_dm;
+    }
+
     if (display)
     {
         /* Use only the display name. For example, \\.\DISPLAY1 in \\.\DISPLAY1\Monitor0 */
@@ -434,6 +509,7 @@
         print->printer = hspool;
         print->output = port;
         dc_attr->print = (UINT_PTR)print;
+        print_event( print, ret, DOCUMENTEVENT_CREATEDCPOST, sizeof(driver_dm), &driver_dm, 0, NULL );
     }
     else if (hspool)
     {
@@ -587,6 +663,7 @@
     {
         if (dc_attr->emf)
             AbortDoc( hdc );
+        print_event( get_dc_print( dc_attr ), hdc, DOCUMENTEVENT_DELETEDC, 0, NULL, 0, NULL );
         delete_print_dc( dc_attr );
     }
     if (dc_attr->emf) EMFDC_DeleteDC( dc_attr );
@@ -621,6 +698,14 @@
     if (!(dc_attr = get_dc_attr( hdc ))) return 0;
     print = get_dc_print( dc_attr );
     if (print && print->flags & CALL_END_PAGE) return 0;
+    if (print)
+    {
+        DEVMODEW *driver_dm = NULL;
+
+        if (print_event( print, hdc, DOCUMENTEVENT_RESETDCPRE, sizeof(devmode), &devmode,
+                       sizeof(driver_dm), &driver_dm ) == DOCUMENTEVENT_SUCCESS && driver_dm)
+            devmode = driver_dm;
+    }
     if (!NtGdiResetDC( hdc, devmode, NULL, NULL, NULL )) return 0;
     if (print)
     {
@@ -631,6 +716,8 @@
             .DesiredAccess = PRINTER_ACCESS_USE
         };
 
+        print_event( print, hdc, DOCUMENTEVENT_RESETDCPOST, sizeof(devmode), &devmode, 0, NULL );
+
         if (!print_copy_devmode( print, devmode )) return 0;
         ResetPrinterW( print->printer, &prn_defaults );
     }
@@ -2572,6 +2659,11 @@
     print = get_dc_print( dc_attr );
     if (print)
     {
+        DOCINFOW *doc_info = &info;
+
+        if (print_event( print, hdc, DOCUMENTEVENT_STARTDOCPRE, sizeof(doc_info), &doc_info,
+                       0, NULL ) == DOCUMENTEVENT_FAILURE)
+            return SP_ERROR;
         if (!info.lpszOutput) info.lpszOutput = print->output;
         output = StartDocDlgW( print->printer, &info );
         if (output) info.lpszOutput = output;
@@ -2591,6 +2683,11 @@
             }
             HeapFree( GetProcessHeap(), 0, output );
             print->flags |= CALL_START_PAGE;
+            if (ret > 0)
+            {
+                LONG job = ret;
+                print_event( print, hdc, DOCUMENTEVENT_STARTDOCPOST, sizeof(job), &job, 0, NULL );
+            }
             return ret;
         }
     }
@@ -2657,6 +2754,7 @@
     print = get_dc_print( dc_attr );
     if (print)
     {
+        print_event( print, hdc, DOCUMENTEVENT_STARTPAGE, 0, NULL, 0, NULL );
         print->flags = (print->flags & ~CALL_START_PAGE) | CALL_END_PAGE;
         if (dc_attr->emf)
             return spool_start_page( dc_attr, print->printer );
@@ -2679,6 +2777,7 @@
         BOOL write = print->flags & WRITE_DEVMODE;
 
         if (!(print->flags & CALL_END_PAGE)) return SP_ERROR;
+        print_event( print, hdc, DOCUMENTEVENT_ENDPAGE, 0, NULL, 0, NULL );
         print->flags = (print->flags & ~(CALL_END_PAGE | WRITE_DEVMODE)) | CALL_START_PAGE;
         if (dc_attr->emf)
             return spool_end_page( dc_attr, print->printer, print->devmode, write );
@@ -2698,10 +2797,29 @@
     print = get_dc_print( dc_attr );
     if (print)
     {
+        INT ret;
+
         if (print->flags & CALL_END_PAGE) EndPage( hdc );
         print->flags &= ~CALL_START_PAGE;
-        if (dc_attr->emf)
-            return spool_end_doc( dc_attr, print->printer );
+        print_event( print, hdc, DOCUMENTEVENT_ENDDOCPRE, 0, NULL, 0, NULL );
+        if (!dc_attr->emf)
+        {
+            ret = NtGdiEndDoc( hdc );
+            print_event( print, hdc, DOCUMENTEVENT_ENDDOCPOST, 0, NULL, 0, NULL );
+            return ret;
+        }
+#ifndef SG_MUTANT_ENDDOCPOST
+        /* Windows' spooler prints a spooled job after GDI is done with it, so
+         * the driver hears of the end (Samsung's leaves its print processor a
+         * note then) before the job is printed */
+        spool_close_doc( dc_attr );
+        print_event( print, hdc, DOCUMENTEVENT_ENDDOCPOST, 0, NULL, 0, NULL );
+        return EndDocPrinter( print->printer );
+#else
+        ret = spool_end_doc( dc_attr, print->printer );
+        print_event( print, hdc, DOCUMENTEVENT_ENDDOCPOST, 0, NULL, 0, NULL );
+        return ret;
+#endif
     }
     return NtGdiEndDoc( hdc );
 }
@@ -2718,6 +2836,7 @@
     print = get_dc_print( dc_attr );
     if (print)
     {
+        print_event( print, hdc, DOCUMENTEVENT_ABORTDOC, 0, NULL, 0, NULL );
         print->flags &= ~(CALL_START_PAGE | CALL_END_PAGE);
         if (dc_attr->emf)
             return spool_abort_doc( dc_attr, print->printer );
--- a/dlls/gdi32/emfdc.c
+++ b/dlls/gdi32/emfdc.c
@@ -2970,6 +2970,14 @@
     return AbortPrinter( hspool );
 }
 
+/* the document's pages are all in the job; it is not scheduled yet */
+void spool_close_doc( DC_ATTR *dc_attr )
+{
+    TRACE( "(%p)\n", dc_attr );
+
+    EMFDC_DeleteDC( dc_attr );
+}
+
 int spool_end_doc( DC_ATTR *dc_attr, HANDLE hspool )
 {
     TRACE( "(%p %p)\n", dc_attr, hspool );
--- a/dlls/gdi32/gdi_private.h
+++ b/dlls/gdi32/gdi_private.h
@@ -277,6 +277,7 @@
 int spool_end_page( DC_ATTR *dc_attr, HANDLE hspool, const DEVMODEW *devmode,
                     BOOL write_devmode );
 int spool_end_doc( DC_ATTR *dc_attr, HANDLE hspool );
+extern void spool_close_doc( DC_ATTR *dc_attr );
 int spool_abort_doc( DC_ATTR *dc_attr, HANDLE hspool );
 
 void print_call_start_page( DC_ATTR *dc_attr );
