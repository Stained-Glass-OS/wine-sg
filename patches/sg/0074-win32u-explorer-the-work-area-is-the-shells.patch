From: Stained Glass OS <dev@stained-glass.example>
Subject: win32u, explorer: the work area is the shell's, for every program

On Windows the taskbar reserves its space with SPI_SETWORKAREA and every
program's maximized and snapped windows stop above it. Wine kept
SPI_SETWORKAREA's rectangle in the calling process only, and took each
monitor's work area from the display driver -- in a virtual desktop, the
whole screen -- so maximized windows covered the taskbar.

- win32u: SPI_SETWORKAREA sets the monitor's work area in its registry
  record, bumps the monitor serial and touches the video key, so every
  process reads it again. The reservation is also kept as insets from the
  monitor's edges (HKCU\Software\Wine\WorkArea, per monitor) and applied
  whenever the monitors are enumerated again -- a display change hands the
  driver's work area back, and explorer sets the desktop's size after the
  taskbar is up.
- explorer: the taskbar sets the work area above itself when it is placed.

Gate: test/shellkeys-gate.sh (the work area; Win+Up maximizes above the
taskbar).
---
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -1525,6 +1525,48 @@
     return TRUE;
 }
 
+/* The shell's reservation of a monitor (the taskbar), as insets from its
+ * edges: the driver's work area comes back whenever the monitors are
+ * enumerated again, and the reservation must outlive that. Per user, like
+ * the session that makes it. */
+static const char work_area_key[] = "Software\\Wine\\WorkArea";
+
+static void save_work_area_insets( const char *path, const RECT *monitor_rect, const RECT *work )
+{
+    RECT insets = { work->left - monitor_rect->left, work->top - monitor_rect->top,
+                    monitor_rect->right - work->right, monitor_rect->bottom - work->bottom };
+    WCHAR nameW[MAX_PATH];
+    HKEY hkey;
+
+    if (!(hkey = reg_create_ascii_key( hkcu_key, work_area_key, 0, NULL ))) return;
+    asciiz_to_unicode( nameW, path );
+    set_reg_value( hkey, nameW, REG_BINARY, &insets, sizeof(insets) );
+    NtClose( hkey );
+}
+
+static void apply_work_area_insets( const char *path, const RECT *monitor_rect, RECT *work )
+{
+    char buffer[FIELD_OFFSET(KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(RECT)])];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    WCHAR nameW[MAX_PATH];
+    const RECT *insets;
+    RECT rc;
+    HKEY hkey;
+
+    if (!(hkey = reg_open_hkcu_key( work_area_key ))) return;
+    asciiz_to_unicode( nameW, path );
+    if (query_reg_value( hkey, nameW, value, sizeof(buffer) ) == sizeof(RECT) && value->Type == REG_BINARY)
+    {
+        insets = (const RECT *)value->Data;
+        SetRect( &rc, monitor_rect->left + insets->left, monitor_rect->top + insets->top,
+                 monitor_rect->right - insets->right, monitor_rect->bottom - insets->bottom );
+        if (!IsRectEmpty( &rc ) && rc.left >= monitor_rect->left && rc.top >= monitor_rect->top &&
+            rc.right <= monitor_rect->right && rc.bottom <= monitor_rect->bottom)
+            *work = rc;
+    }
+    NtClose( hkey );
+}
+
 static void add_monitor( const struct gdi_monitor *gdi_monitor, void *param )
 {
     struct device_manager_ctx *ctx = param;
