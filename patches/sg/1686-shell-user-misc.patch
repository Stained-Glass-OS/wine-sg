+/*
+ * Stained Glass OS 1686: Group Policy notification. Policy is applied by
+ * writing the Policies keys (sg-session's policy.d and sg-polimport, at
+ * boot and on refresh), so a registered event is set when the machine's
+ * (HKLM) or the user's (HKCU) Software\Policies key changes, and when
+ * RefreshPolicy asks for a refresh.
+ */
+struct gp_notification
+{
+    struct list entry;
+    HANDLE orig;             /* the caller's */
+    HANDLE event;            /* our copy of it */
+    BOOL machine;
+    HKEY key;
+    HANDLE changed;          /* the key's change notification */
+    HANDLE refresh;          /* RefreshPolicy's named event */
+    HANDLE wait_changed, wait_refresh;
+};
+
+static struct list gp_notifications = LIST_INIT( gp_notifications );
+static CRITICAL_SECTION gp_cs;
+static CRITICAL_SECTION_DEBUG gp_cs_debug =
+{
+    0, 0, &gp_cs,
+    { &gp_cs_debug.ProcessLocksList, &gp_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": gp_cs") }
+};
+static CRITICAL_SECTION gp_cs = { &gp_cs_debug, -1, 0, 0, 0, 0 };
+
+static HANDLE open_refresh_event( BOOL machine )
+{
+    return CreateEventW( NULL, TRUE, FALSE, machine ? L"Global\\SgGroupPolicyRefreshMachine"
+                                                    : L"Global\\SgGroupPolicyRefreshUser" );
+}
+
+static void arm_key_notify( struct gp_notification *n )
+{
+    if (n->key)
+        RegNotifyChangeKeyValue( n->key, TRUE, REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET,
+                                 n->changed, TRUE );
+}
+
+static void CALLBACK gp_changed( void *ctx, BOOLEAN timeout )
+{
+    struct gp_notification *n = ctx;
+
+#ifndef SG_MUTANT_NO_GP_NOTIFY
+    SetEvent( n->event );
+#endif
+    arm_key_notify( n );
+}
+
+static void CALLBACK gp_refreshed( void *ctx, BOOLEAN timeout )
+{
+    struct gp_notification *n = ctx;
+
+    SetEvent( n->event );
+}
+
 BOOL WINAPI RegisterGPNotification( HANDLE event, BOOL machine )
 {
-    FIXME("%p %d\n", event, machine );
+    struct gp_notification *n;
+    HANDLE dup;
+
+    TRACE("%p %d\n", event, machine );
+
+    if (!event || !DuplicateHandle( GetCurrentProcess(), event, GetCurrentProcess(), &dup,
+                                    EVENT_MODIFY_STATE | SYNCHRONIZE, FALSE, 0 ))
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    if (!(n = calloc( 1, sizeof(*n) )))
+    {
+        CloseHandle( dup );
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    n->orig = event;
+    n->event = dup;
+    n->machine = machine;
+    if (RegCreateKeyExW( machine ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER, L"Software\\Policies", 0, NULL, 0,
+                         KEY_NOTIFY, NULL, &n->key, NULL ) &&
+        RegOpenKeyExW( machine ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER, L"Software", 0, KEY_NOTIFY, &n->key ))
+        n->key = NULL;
+    n->changed = CreateEventW( NULL, FALSE, FALSE, NULL );
+    n->refresh = open_refresh_event( machine );
+    arm_key_notify( n );
+    if (n->key) RegisterWaitForSingleObject( &n->wait_changed, n->changed, gp_changed, n, INFINITE, WT_EXECUTEDEFAULT );
+    if (n->refresh) RegisterWaitForSingleObject( &n->wait_refresh, n->refresh, gp_refreshed, n, INFINITE, WT_EXECUTEDEFAULT );
+    EnterCriticalSection( &gp_cs );
+    list_add_tail( &gp_notifications, &n->entry );
+    LeaveCriticalSection( &gp_cs );
     return TRUE;
 }
 
 BOOL WINAPI UnregisterGPNotification( HANDLE event )
 {
-    FIXME("%p\n", event );
+    struct gp_notification *n, *found = NULL;
+
+    TRACE("%p\n", event );
+
+    EnterCriticalSection( &gp_cs );
+    LIST_FOR_EACH_ENTRY( n, &gp_notifications, struct gp_notification, entry )
+    {
+        if (n->orig == event)
+        {
+            found = n;
+            list_remove( &n->entry );
+            break;
+        }
+    }
+    LeaveCriticalSection( &gp_cs );
+    if (!found)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (found->wait_changed) UnregisterWaitEx( found->wait_changed, INVALID_HANDLE_VALUE );
+    if (found->wait_refresh) UnregisterWaitEx( found->wait_refresh, INVALID_HANDLE_VALUE );
+    if (found->key) RegCloseKey( found->key );
+    CloseHandle( found->changed );
+    if (found->refresh) CloseHandle( found->refresh );
+    CloseHandle( found->event );
+    free( found );
     return TRUE;
 }
 
+/******************************************************************
+ *      RefreshPolicy (USERENV.@)
+ *
+ * Policy is in the registry already: a refresh tells those waiting for it.
+ */
+BOOL WINAPI RefreshPolicyEx( BOOL machine, DWORD options )
+{
+    HANDLE event;
+
+    TRACE("%d %#lx\n", machine, options );
+
+    if (options & ~RP_FORCE)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(event = open_refresh_event( machine ))) return FALSE;
+    PulseEvent( event );
+    CloseHandle( event );
+    return TRUE;
+}
+
+BOOL WINAPI RefreshPolicy( BOOL machine )
+{
+    return RefreshPolicyEx( machine, 0 );
+}
+
 BOOL WINAPI UnloadUserProfile( HANDLE hToken, HANDLE hProfile )
 {
     FIXME("(%p, %p): stub\n", hToken, hProfile);
     return FALSE;
 }
 
+/* the policy section: a named mutex held while policy is read or applied */
 HANDLE WINAPI EnterCriticalPolicySection(BOOL bMachine)
 {
-    FIXME("(%x)\n", bMachine);
-    SetLastError(ERROR_ACCESS_DENIED);
-    return NULL;
+    HANDLE mutex;
+    DWORD ret;
+
+    TRACE("(%x)\n", bMachine);
+
+    if (!(mutex = CreateMutexW( NULL, FALSE, bMachine ? L"Global\\SgGroupPolicySectionMachine"
+                                                      : L"Global\\SgGroupPolicySectionUser" )))
+        return NULL;
+    /* Windows waits up to ten minutes for whoever applies policy */
+    ret = WaitForSingleObject( mutex, 600000 );
+    if (ret != WAIT_OBJECT_0 && ret != WAIT_ABANDONED)
+    {
+        CloseHandle( mutex );
+        SetLastError( ret == WAIT_TIMEOUT ? ERROR_TIMEOUT : GetLastError() );
+        return NULL;
+    }
+    return mutex;
 }
 
 BOOL WINAPI LeaveCriticalPolicySection(HANDLE hSection)
 {
-    FIXME("(%p)\n", hSection);
+    TRACE("(%p)\n", hSection);
+
+    if (!hSection)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!ReleaseMutex( hSection ))
+    {
+        CloseHandle( hSection );
+        return FALSE;
+    }
+    CloseHandle( hSection );
     return TRUE;
 }
 
