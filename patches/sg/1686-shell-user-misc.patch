 {
-    FIXME( "stub\n" );
+    /* Stained Glass OS 1686: drawing here is done at once, in the calling
+     * thread, so there is no pending operation left to cancel: the call
+     * only answers whether hdc is a device context, as Windows does. */
+    TRACE( "%p\n", hdc );
+
+    if (!hdc || !get_dc_attr( hdc ))
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
     return TRUE;
 }
 
