                                        PVOID attribute, DWORD size)
 {
-   FIXME("(%p,%d,%p,%ld): stub\n", hwnd, type, attribute, size);
-   return E_NOTIMPL;
+    /* Stained Glass OS 1686: the non-client options, kept as a property
+     * win32u's frame drawing and hit testing read */
+    const WTA_OPTIONS *opts = attribute;
+    DWORD flags;
+
+    TRACE("(%p,%d,%p,%ld)\n", hwnd, type, attribute, size);
+
+    if (!IsWindow(hwnd)) return HRESULT_FROM_WIN32(ERROR_INVALID_WINDOW_HANDLE);
+    if (type != WTA_NONCLIENT || !opts || size != sizeof(*opts)) return E_INVALIDARG;
+    flags = HandleToUlong(GetPropW(hwnd, L"__wine_wta_nc"));
+    flags = (flags & ~opts->dwMask) | (opts->dwFlags & opts->dwMask);
+    flags &= WTNCA_VALIDBITS;
+    if (flags) SetPropW(hwnd, L"__wine_wta_nc", ULongToHandle(flags));
+    else RemovePropW(hwnd, L"__wine_wta_nc");
+    SetWindowPos(hwnd, 0, 0, 0, 0, 0, SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER |
+                 SWP_NOACTIVATE | SWP_NOOWNERZORDER);
+    return S_OK;
 }
 
