+/* Stained Glass OS 1686: is the foreground window full screen? Not the
+ * desktop or the shell's own windows. */
+static BOOL foreground_is_full_screen(void)
+{
+    static const WCHAR *shell_classes[] = { L"Progman", L"WorkerW", L"Shell_TrayWnd", L"#32769" };
+    HWND fg = GetForegroundWindow();
+    MONITORINFO mi = { sizeof(mi) };
+    WCHAR cls[64];
+    RECT rect;
+    unsigned int i;
+
+    if (!fg || fg == GetDesktopWindow() || fg == GetShellWindow()) return FALSE;
+    if (GetClassNameW( fg, cls, ARRAY_SIZE(cls) ))
+        for (i = 0; i < ARRAY_SIZE(shell_classes); i++)
+            if (!wcsicmp( cls, shell_classes[i] )) return FALSE;
+    if (!IsWindowVisible( fg ) || IsIconic( fg ) || !GetWindowRect( fg, &rect )) return FALSE;
+    if (!GetMonitorInfoW( MonitorFromWindow( fg, MONITOR_DEFAULTTONEAREST ), &mi )) return FALSE;
+    return rect.left <= mi.rcMonitor.left && rect.top <= mi.rcMonitor.top &&
+           rect.right >= mi.rcMonitor.right && rect.bottom >= mi.rcMonitor.bottom;
+}
+
 HRESULT WINAPI SHQueryUserNotificationState(QUERY_USER_NOTIFICATION_STATE *state)
 {
-    FIXME("%p: stub\n", state);
+    BOOL saver = FALSE;
+    DWORD value = 1, size = sizeof(value);
+    HDESK input;
+
+    TRACE("%p\n", state);
+
+    if (!state) return E_INVALIDARG;
+#ifdef SG_MUTANT_ALWAYS_ACCEPTS
+    *state = QUNS_ACCEPTS_NOTIFICATIONS;
+    return S_OK;
+#endif
+    /* the screen saver runs, or the workstation is locked: nobody there */
+    SystemParametersInfoW( SPI_GETSCREENSAVERRUNNING, 0, &saver, 0 );
+    if (saver)
+    {
+        *state = QUNS_NOT_PRESENT;
+        return S_OK;
+    }
+    if (!(input = OpenInputDesktop( 0, FALSE, DESKTOP_READOBJECTS )))
+    {
+        *state = QUNS_NOT_PRESENT;
+        return S_OK;
+    }
+    CloseDesktop( input );
+    if (foreground_is_full_screen())
+    {
+        *state = QUNS_BUSY;
+        return S_OK;
+    }
+    /* notifications from apps turned off */
+    if (!RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Notifications\\Settings",
+                       L"NOC_GLOBAL_SETTING_TOASTS_ENABLED", RRF_RT_REG_DWORD, NULL, &value, &size ) && !value)
+    {
+        *state = QUNS_QUIET_TIME;
+        return S_OK;
+    }
     *state = QUNS_ACCEPTS_NOTIFICATIONS;
     return S_OK;
 }
