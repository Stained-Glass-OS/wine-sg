+    SG_TBL_PROPERTIES,      /* shell32 */
+    /* Stained Glass OS 1659: the thumbnail toolbar, tooltip and clip, tabs */
+    SG_TBL_THUMB_BUTTONS,   /* state: count, pad: 1 to update; sg_thumb_button records follow */
+    SG_TBL_THUMB_TOOLTIP,   /* a NUL-terminated string follows */
+    SG_TBL_THUMB_CLIP,      /* state: 1 with a clip; done: left | top << 32, total: right | bottom << 32 */
