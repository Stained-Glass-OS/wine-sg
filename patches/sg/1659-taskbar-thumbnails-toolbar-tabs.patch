 IMPORTLIB = dwmapi
 
 EXTRADLLFLAGS = -Wb,--prefer-native
--- a/dlls/dwmapi/dwmapi_main.c
+++ b/dlls/dwmapi/dwmapi_main.c
@@ -165,12 +165,79 @@ HRESULT WINAPI DwmFlush(void)
 /**********************************************************************
  *        DwmInvalidateIconicBitmaps      (DWMAPI.@)
  */
+/* Stained Glass OS 1659: a window's iconic thumbnail goes to the taskbar
+ * (explorer's Shell_TrayWnd) as 32-bit BGRA bits, as explorerframe sends
+ * what ITaskbarList3 is told (programs/explorer/systray.c) */
+#define SG_TASKBAR_LIST_DATA 0x53470101
+#define SG_TBL_ICONIC        12
+
+struct sg_taskbar_list_data
+{
+    DWORD     cmd;
+    DWORD     hwnd;
+    DWORD     state;     /* 0: thumbnail, 1: live preview */
+    DWORD     pad;
+    ULONGLONG done, total;
+    UINT      width, height, planes, bpp;   /* width 0: forget the bitmap */
+    BYTE      icon_data[];
+};
+
+static HRESULT send_iconic(HWND hwnd, HBITMAP hbmp, DWORD live)
+{
+    struct sg_taskbar_list_data *data;
+    BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER) }};
+    COPYDATASTRUCT cds;
+    DWORD_PTR result;
+    size_t size = sizeof(*data);
+    BITMAP bm = {0};
+    HWND tray;
+    HDC hdc;
+
+    if (!IsWindow(hwnd)) return E_HANDLE;
+    if (hbmp)
+    {
+        if (!GetObjectW(hbmp, sizeof(bm), &bm) || bm.bmWidth <= 0 || bm.bmHeight == 0) return E_INVALIDARG;
+        if (bm.bmWidth > 4096 || abs(bm.bmHeight) > 4096) return E_INVALIDARG;
+        size += (size_t)bm.bmWidth * abs(bm.bmHeight) * 4;
+    }
+    if (!(data = calloc(1, size))) return E_OUTOFMEMORY;
+    data->cmd = SG_TBL_ICONIC;
+    data->hwnd = HandleToLong(hwnd);
+    data->state = live;
+    if (hbmp)
+    {
+        data->width = bm.bmWidth;
+        data->height = abs(bm.bmHeight);
+        data->planes = 1;
+        data->bpp = 32;
+        bmi.bmiHeader.biWidth = bm.bmWidth;
+        bmi.bmiHeader.biHeight = -(int)data->height;
+        bmi.bmiHeader.biPlanes = 1;
+        bmi.bmiHeader.biBitCount = 32;
+        bmi.bmiHeader.biCompression = BI_RGB;
+        hdc = CreateCompatibleDC(0);
+        GetDIBits(hdc, hbmp, 0, data->height, data->icon_data, &bmi, DIB_RGB_COLORS);
+        DeleteDC(hdc);
+    }
+    if ((tray = FindWindowW(L"Shell_TrayWnd", NULL)))
+    {
+        cds.dwData = SG_TASKBAR_LIST_DATA;
+        cds.cbData = size;
+        cds.lpData = data;
+        SendMessageTimeoutW(tray, WM_COPYDATA, 0, (LPARAM)&cds, SMTO_ABORTIFHUNG, 2000, &result);
+    }
+    free(data);
+    return S_OK;
+}
+
 HRESULT WINAPI DwmInvalidateIconicBitmaps(HWND hwnd)
 {
-    /* iconic bitmaps are asked for when a thumbnail is shown; none is kept */
     TRACE("(%p)\n", hwnd);
 
-    return IsWindow(hwnd) ? S_OK : E_HANDLE;
+    /* the taskbar forgets the bitmaps it has, and asks for new ones */
+    if (!IsWindow(hwnd)) return E_HANDLE;
+    send_iconic(hwnd, NULL, 0);
+    return S_OK;
 }
 
