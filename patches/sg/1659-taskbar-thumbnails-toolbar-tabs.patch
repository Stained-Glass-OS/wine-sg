+/* an icon as 32-bit BGRA with alpha, at most 32x32 */
+static BYTE *icon_bits( HICON icon, UINT *w, UINT *h )
+{
+    BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER) }};
+    ICONINFO info;
+    BITMAP bm;
+    BYTE *bits = NULL, *mask = NULL;
+    HDC hdc;
+    UINT i;
+    BOOL alpha = FALSE;
+
+    *w = *h = 0;
+    if (!icon || !GetIconInfo( icon, &info )) return NULL;
+    if (!GetObjectW( info.hbmColor ? info.hbmColor : info.hbmMask, sizeof(bm), &bm )) goto done;
+    *w = min( bm.bmWidth, 32 );
+    *h = min( info.hbmColor ? bm.bmHeight : bm.bmHeight / 2, 32 );
+    if (!(bits = calloc( *w * *h, 4 )) || !(mask = calloc( *w * *h, 4 ))) goto done;
+    hdc = CreateCompatibleDC( 0 );
+    bmi.bmiHeader.biWidth = *w;
+    bmi.bmiHeader.biHeight = -(int)*h;
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biCompression = BI_RGB;
+    if (info.hbmColor) GetDIBits( hdc, info.hbmColor, 0, *h, bits, &bmi, DIB_RGB_COLORS );
+    GetDIBits( hdc, info.hbmMask, 0, *h, mask, &bmi, DIB_RGB_COLORS );
+    DeleteDC( hdc );
+    for (i = 0; i < *w * *h; i++) if (bits[i * 4 + 3]) alpha = TRUE;
+    /* no alpha channel: opaque where the mask says */
+    if (!alpha) for (i = 0; i < *w * *h; i++) bits[i * 4 + 3] = mask[i * 4] ? 0 : 255;
+done:
+    free( mask );
+    if (info.hbmColor) DeleteObject( info.hbmColor );
+    DeleteObject( info.hbmMask );
+    if (!*w || !*h) { free( bits ); bits = NULL; }
+    return bits;
+}
+
+/* the image lists programs gave for their thumbnail buttons, and the
+ * windows their tabs belong to */
+static CRITICAL_SECTION tbl_cs;
+static CRITICAL_SECTION_DEBUG tbl_cs_debug =
+{
+    0, 0, &tbl_cs,
+    { &tbl_cs_debug.ProcessLocksList, &tbl_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": tbl_cs") }
+};
+static CRITICAL_SECTION tbl_cs = { &tbl_cs_debug, -1, 0, 0, 0, 0 };
+
+struct hwnd_map { HWND key; void *value; };
+static struct hwnd_map image_lists[64], tab_owners[256];
+
+static void map_set( struct hwnd_map *map, UINT size, HWND key, void *value )
+{
+    UINT i, free_slot = size;
+    EnterCriticalSection( &tbl_cs );
+    for (i = 0; i < size; i++)
+    {
+        if (map[i].key == key) break;
+        if (free_slot == size && (!map[i].key || !IsWindow( map[i].key ))) free_slot = i;
+    }
+    if (i == size) i = free_slot;
+    if (i < size)
+    {
+        map[i].key = value ? key : NULL;
+        map[i].value = value;
+    }
+    LeaveCriticalSection( &tbl_cs );
+}
+
+static void *map_get( struct hwnd_map *map, UINT size, HWND key )
+{
+    void *ret = NULL;
+    UINT i;
+    EnterCriticalSection( &tbl_cs );
+    for (i = 0; i < size; i++) if (map[i].key == key) { ret = map[i].value; break; }
+    LeaveCriticalSection( &tbl_cs );
+    return ret;
+}
+
+static HRESULT send_thumb_buttons( HWND hwnd, UINT count, const THUMBBUTTON *buttons, BOOL update )
+{
+    struct sg_taskbar_list_data *data;
+    HIMAGELIST himl = map_get( image_lists, ARRAY_SIZE(image_lists), hwnd );
+    size_t size = sizeof(*data);
+    BYTE *bits[7] = {0}, *p;
+    UINT w[7], h[7], i;
+
+    if (!hwnd || !IsWindow( hwnd )) return E_INVALIDARG;
+    if (!count || count > 7 || !buttons) return E_INVALIDARG;
+    for (i = 0; i < count; i++)
+    {
+        HICON icon = NULL;
+        w[i] = h[i] = 0;
+        if (buttons[i].dwMask & THB_ICON) icon = buttons[i].hIcon;
+        else if ((buttons[i].dwMask & THB_BITMAP) && himl) icon = ImageList_GetIcon( himl, buttons[i].iBitmap, ILD_TRANSPARENT );
+        if (icon) bits[i] = icon_bits( icon, &w[i], &h[i] );
+        if (icon && icon != buttons[i].hIcon) DestroyIcon( icon );
+        size += sizeof(struct sg_thumb_button) + w[i] * h[i] * 4;
+    }
+    if (!(data = calloc( 1, size )))
+    {
+        for (i = 0; i < count; i++) free( bits[i] );
+        return E_OUTOFMEMORY;
+    }
+    data->cmd = SG_TBL_THUMB_BUTTONS;
+    data->hwnd = HandleToLong( hwnd );
+    data->state = count;
+    data->pad = update;
+    p = data->icon_data;
+    for (i = 0; i < count; i++)
+    {
+        struct sg_thumb_button *b = (struct sg_thumb_button *)p;
+        b->mask = buttons[i].dwMask;
+        if ((buttons[i].dwMask & (THB_ICON | THB_BITMAP)) && bits[i]) b->mask |= THB_ICON;
+        b->id = buttons[i].iId;
+        b->flags = buttons[i].dwFlags;
+        b->icon_w = w[i];
+        b->icon_h = h[i];
+        if (buttons[i].dwMask & THB_TOOLTIP) lstrcpynW( b->tip, buttons[i].szTip, ARRAY_SIZE(b->tip) );
+        p += sizeof(*b);
+        if (bits[i]) memcpy( p, bits[i], w[i] * h[i] * 4 );
+        p += w[i] * h[i] * 4;
+        free( bits[i] );
+    }
+    send_taskbar_data( data, size );
+    free( data );
+    return S_OK;
+}
+
+static void send_tab_cmd( DWORD cmd, HWND owner, HWND tab, HWND other, DWORD flags )
+{
+    struct sg_taskbar_list_data data = { 0 };
+
+    data.cmd = SG_TBL_TAB;
+    data.hwnd = HandleToLong( owner );
+    data.state = cmd;
+    data.done = HandleToLong( tab );
+    data.total = HandleToLong( other );
+    data.pad = flags;
+    send_taskbar_data( &data, sizeof(data) );
+}
+
