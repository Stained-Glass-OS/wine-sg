+/* ------------------------------------------------------------------------ */
+/* Stained Glass OS 1659: taskbar thumbnails. Hovering over a window's button */
+/* shows its windows (or its tabs) as thumbnails above it: the window as it  */
+/* looks (or as it last looked), or the iconic bitmap it gives when asked     */
+/* (WM_DWMSENDICONICTHUMBNAIL); under it the program's thumbnail toolbar,    */
+/* whose buttons send it WM_COMMAND THBN_CLICKED. A click on a thumbnail      */
+/* brings its window (or tab) forward; its x closes it.                       */
+
+#define SG_THUMB_HOVER_MS     400
+#define SG_THUMB_HIDE_TIMER   0xC1B0
+#define SG_THUMB_W            SG_PX(200)
+#define SG_THUMB_IMG_H        SG_PX(112)
+#define SG_THUMB_TITLE_H      SG_PX(24)
+#define SG_THUMB_BAR_H        SG_PX(30)
+#define SG_THUMB_PAD          SG_PX(8)
+#define SG_THBN_CLICKED       0x1800
+
+static HWND sg_thumb_popup, sg_thumb_tip_window;
+static HWND sg_thumb_button_for;      /* the taskbar button it is for */
+static struct taskbar_button *sg_thumb_leader;
+
+struct sg_tile
+{
+    HWND tile;          /* its child window */
+    HWND target;        /* the window, or the tab */
+    BOOL is_tab;
+    struct taskbar_button *win;   /* the window's button (the tab's owner's) */
+};
+static struct sg_tile sg_tiles[16];
+static UINT sg_tile_count;
+
+static COLORREF sg_thumb_bg(void) { return sg_pal_light() ? RGB(0xF3,0xF3,0xF3) : RGB(0x2B,0x2B,0x2B); }
+static COLORREF sg_thumb_hot(void) { return sg_pal_light() ? RGB(0xE0,0xE0,0xE0) : RGB(0x3D,0x3D,0x3D); }
+static COLORREF sg_thumb_text(void) { return sg_pal_light() ? RGB(0x1A,0x1A,0x1A) : RGB(0xF0,0xF0,0xF0); }
+
+static struct sg_iconic *sg_find_iconic( HWND hwnd )
+{
+    struct sg_iconic *ic;
+    LIST_FOR_EACH_ENTRY( ic, &sg_iconics, struct sg_iconic, entry ) if (ic->hwnd == hwnd) return ic;
+    return NULL;
+}
+
+static LRESULT sg_set_iconic( HWND hwnd, const struct sg_taskbar_list_data *data, DWORD size )
+{
+    struct sg_iconic *ic = sg_find_iconic( hwnd );
+    HBITMAP bitmap = NULL;
+
+    if (data->state) return TRUE;   /* live previews: this taskbar has no peek */
+    if (data->width)
+    {
+        BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER) }};
+        void *bits;
+        if (data->width > 4096 || data->height > 4096 ||
+            size < sizeof(*data) + (size_t)data->width * data->height * 4) return FALSE;
+        bmi.bmiHeader.biWidth = data->width;
+        bmi.bmiHeader.biHeight = -(int)data->height;
+        bmi.bmiHeader.biPlanes = 1;
+        bmi.bmiHeader.biBitCount = 32;
+        bmi.bmiHeader.biCompression = BI_RGB;
+        if (!(bitmap = CreateDIBSection( 0, &bmi, DIB_RGB_COLORS, &bits, NULL, 0 ))) return FALSE;
+        memcpy( bits, data->icon_data, (size_t)data->width * data->height * 4 );
+    }
+    if (!ic && bitmap && (ic = calloc( 1, sizeof(*ic) )))
+    {
+        ic->hwnd = hwnd;
+        list_add_tail( &sg_iconics, &ic->entry );
+    }
+    if (ic)
+    {
+        if (ic->bitmap) DeleteObject( ic->bitmap );
+        ic->bitmap = bitmap;
+        if (!bitmap)
+        {
+            list_remove( &ic->entry );
+            free( ic );
+        }
+    }
+    else if (bitmap) DeleteObject( bitmap );
+    /* the thumbnail shows it now (not laid out again: that asks for it again) */
+    if (sg_thumb_popup)
+    {
+        UINT i;
+        for (i = 0; i < sg_tile_count; i++)
+            if (sg_tiles[i].target == hwnd) InvalidateRect( sg_tiles[i].tile, NULL, FALSE );
+    }
+    return TRUE;
+}
+
+static HICON sg_icon_from_bits( UINT w, UINT h, const BYTE *bits )
+{
+    BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER) }};
+    ICONINFO info = { TRUE };
+    void *dib;
+    HICON icon;
+
+    bmi.bmiHeader.biWidth = w;
+    bmi.bmiHeader.biHeight = -(int)h;
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biCompression = BI_RGB;
+    if (!(info.hbmColor = CreateDIBSection( 0, &bmi, DIB_RGB_COLORS, &dib, NULL, 0 ))) return NULL;
+    memcpy( dib, bits, (size_t)w * h * 4 );
+    info.hbmMask = CreateBitmap( w, h, 1, 1, NULL );
+    icon = CreateIconIndirect( &info );
+    DeleteObject( info.hbmColor );
+    DeleteObject( info.hbmMask );
+    return icon;
+}
+
+static BOOL sg_set_thumb_buttons( struct taskbar_button *win, const struct sg_taskbar_list_data *data, DWORD size )
+{
+    const BYTE *p = data->icon_data, *end = (const BYTE *)data + size;
+    UINT i, j;
+
+    if (data->state > 7) return FALSE;
+    if (!data->pad)  /* added: the toolbar is these */
+    {
+        for (j = 0; j < win->thumb_count; j++) if (win->thumb[j].icon) DestroyIcon( win->thumb[j].icon );
+        memset( win->thumb, 0, sizeof(win->thumb) );
+        win->thumb_count = 0;
+    }
+    for (i = 0; i < data->state; i++)
+    {
+        const struct sg_thumb_button *b = (const struct sg_thumb_button *)p;
+        struct sg_thumb_btn *t = NULL;
+
+        if (p + sizeof(*b) > end || b->icon_w > 32 || b->icon_h > 32 ||
+            p + sizeof(*b) + b->icon_w * b->icon_h * 4 > end) return FALSE;
+        for (j = 0; j < win->thumb_count; j++) if (win->thumb[j].id == b->id) t = &win->thumb[j];
+        if (!t)
+        {
+            if (data->pad || win->thumb_count >= 7) { p += sizeof(*b) + b->icon_w * b->icon_h * 4; continue; }
+            t = &win->thumb[win->thumb_count++];
+            t->id = b->id;
+        }
+        if (b->mask & THB_FLAGS) t->flags = b->flags;
+        if (b->mask & THB_TOOLTIP) lstrcpynW( t->tip, b->tip, ARRAY_SIZE(t->tip) );
+        if ((b->mask & THB_ICON) && b->icon_w && b->icon_h)
+        {
+            if (t->icon) DestroyIcon( t->icon );
+            t->icon = sg_icon_from_bits( b->icon_w, b->icon_h, p + sizeof(*b) );
+        }
+        p += sizeof(*b) + b->icon_w * b->icon_h * 4;
+    }
+    sg_thumbs_changed( win->hwnd );
+    return TRUE;
+}
+
+static void sg_tab_command( struct taskbar_button *win, DWORD cmd, HWND tab, HWND other )
+{
+    UINT i, j;
+
+    for (i = 0; i < win->tab_count; i++) if (win->tabs[i] == tab) break;
+    switch (cmd)
+    {
+    case SG_TAB_REGISTER:
+        if (i == win->tab_count && win->tab_count < ARRAY_SIZE(win->tabs)) win->tabs[win->tab_count++] = tab;
+        break;
+    case SG_TAB_UNREGISTER:
+        if (i < win->tab_count)
+        {
+            memmove( win->tabs + i, win->tabs + i + 1, (win->tab_count - i - 1) * sizeof(HWND) );
+            win->tab_count--;
+        }
+        if (win->tab_active == tab) win->tab_active = NULL;
+        break;
+    case SG_TAB_ORDER:  /* before other, or last */
+        if (i == win->tab_count) break;
+        memmove( win->tabs + i, win->tabs + i + 1, (win->tab_count - i - 1) * sizeof(HWND) );
+        win->tab_count--;
+        for (j = 0; j < win->tab_count; j++) if (win->tabs[j] == other) break;
+        memmove( win->tabs + j + 1, win->tabs + j, (win->tab_count - j) * sizeof(HWND) );
+        win->tabs[j] = tab;
+        win->tab_count++;
+        break;
+    case SG_TAB_ACTIVE:
+        win->tab_active = tab;
+        break;
+    case SG_TAB_PROPERTIES:
+        break;
+    }
+    sg_thumbs_changed( win->hwnd );
+}
+
+static BOOL sg_is_iconic_window( HWND hwnd )
+{
+    ULONG_PTR has = (ULONG_PTR)GetPropW( hwnd, L"__wine_dwm_iconic_bitmap" );
+    ULONG_PTR force = (ULONG_PTR)GetPropW( hwnd, L"__wine_dwm_iconic" );
+    return (has > 1) || (force > 1);   /* stored + 1 */
+}
+
+/* the window as it looks now, from the screen (visible, not minimized) */
+static void sg_capture( struct taskbar_button *win )
+{
+    RECT rc;
+    HDC screen, mem;
+    HBITMAP bmp;
+    int w, h;
+
+    if (!win->hwnd || win->xwin || !IsWindowVisible( win->hwnd ) || IsIconic( win->hwnd )) return;
+    if (win->has_clip)
+    {
+        POINT pt = { win->clip.left, win->clip.top };
+        ClientToScreen( win->hwnd, &pt );
+        SetRect( &rc, pt.x, pt.y, pt.x + win->clip.right - win->clip.left, pt.y + win->clip.bottom - win->clip.top );
+    }
+    else GetWindowRect( win->hwnd, &rc );
+    w = rc.right - rc.left;
+    h = rc.bottom - rc.top;
+    if (w <= 0 || h <= 0 || w > 8192 || h > 8192) return;
+    screen = GetDC( 0 );
+    mem = CreateCompatibleDC( screen );
+    if ((bmp = CreateCompatibleBitmap( screen, w, h )))
+    {
+        HGDIOBJ old = SelectObject( mem, bmp );
+        BitBlt( mem, 0, 0, w, h, screen, rc.left, rc.top, SRCCOPY );
+        SelectObject( mem, old );
+        if (win->snapshot) DeleteObject( win->snapshot );
+        win->snapshot = bmp;
+    }
+    DeleteDC( mem );
+    ReleaseDC( 0, screen );
+}
+
+static void sg_hide_thumbnails(void)
+{
+    UINT i;
+    KillTimer( tray_window, SG_THUMB_HIDE_TIMER );
+    if (!sg_thumb_popup) return;
+    for (i = 0; i < sg_tile_count; i++) DestroyWindow( sg_tiles[i].tile );
+    sg_tile_count = 0;
+    DestroyWindow( sg_thumb_popup );
+    sg_thumb_popup = NULL;
+    sg_thumb_tip_window = NULL;
+    sg_thumb_button_for = NULL;
+    sg_thumb_leader = NULL;
+}
+
+static void sg_tile_title( const struct sg_tile *t, WCHAR *buf, int len )
+{
+    buf[0] = 0;
+    if (t->win && t->win->elevated) InternalGetWindowText( t->target, buf, len );
+    else GetWindowTextW( t->target, buf, len );
+    if (!buf[0]) lstrcpynW( buf, L"(untitled)", len );
+}
+
+static void sg_paint_tile( HWND tile, HDC hdc )
+{
+    struct sg_tile *t = &sg_tiles[GetWindowLongPtrW( tile, GWLP_USERDATA )];
+    BOOL hot = GetPropW( tile, L"sg_hot" ) != NULL;
+    RECT rc, title, img, close;
+    struct sg_iconic *ic = sg_find_iconic( t->target );
+    WCHAR text[256];
+    HFONT old_font;
+    HBITMAP bmp = NULL;
+    HICON icon = t->win ? (t->win->exe_icon ? t->win->exe_icon : (HICON)SendMessageW( t->target, WM_GETICON, ICON_SMALL2, 0 )) : NULL;
+
+    GetClientRect( tile, &rc );
+    sg_fill( hdc, &rc, hot ? sg_thumb_hot() : sg_thumb_bg() );
+    title = rc;
+    title.bottom = title.top + SG_THUMB_TITLE_H;
+    if (icon && !t->win->elevated)
+        DrawIconEx( hdc, rc.left + SG_PX(4), title.top + (SG_THUMB_TITLE_H - SG_PX(16)) / 2, icon, SG_PX(16), SG_PX(16), 0, NULL, DI_NORMAL );
+    title.left += SG_PX(24);
+    title.right -= SG_PX(24);
+    sg_tile_title( t, text, ARRAY_SIZE(text) );
+    SetBkMode( hdc, TRANSPARENT );
+    SetTextColor( hdc, sg_thumb_text() );
+    old_font = SelectObject( hdc, GetStockObject( DEFAULT_GUI_FONT ) );
+    DrawTextW( hdc, text, -1, &title, DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS | DT_NOPREFIX );
+    if (hot)  /* the close button */
+    {
+        SetRect( &close, rc.right - SG_PX(22), rc.top + SG_PX(3), rc.right - SG_PX(4), rc.top + SG_PX(21) );
+        sg_fill( hdc, &close, RGB(0xC4,0x2B,0x1C) );
+        SetTextColor( hdc, RGB(0xFF,0xFF,0xFF) );
+        DrawTextW( hdc, L"\x2715", -1, &close, DT_SINGLELINE | DT_VCENTER | DT_CENTER );
+    }
+    SelectObject( hdc, old_font );
+
+    img = rc;
+    img.top = rc.top + SG_THUMB_TITLE_H;
+    InflateRect( &img, -SG_PX(6), 0 );
+    img.bottom -= SG_PX(6);
+    if (ic) bmp = ic->bitmap;
+    else if (!t->is_tab && t->win) bmp = t->win->snapshot;
+    if (bmp)
+    {
+        BITMAP bm;
+        HDC mem = CreateCompatibleDC( hdc );
+        HGDIOBJ old;
+        int w, h;
+        GetObjectW( bmp, sizeof(bm), &bm );
+        /* fitted, keeping its shape */
+        w = img.right - img.left;
+        h = img.bottom - img.top;
+        if (bm.bmWidth * h > bm.bmHeight * w) h = max( 1, bm.bmHeight * w / max( bm.bmWidth, 1 ) );
+        else w = max( 1, bm.bmWidth * h / max( bm.bmHeight, 1 ) );
+        old = SelectObject( mem, bmp );
+        SetStretchBltMode( hdc, HALFTONE );
+        SetBrushOrgEx( hdc, 0, 0, NULL );
+        if (ic && bm.bmBitsPixel == 32)
+        {
+            BLENDFUNCTION bf = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+            GdiAlphaBlend( hdc, img.left + (img.right - img.left - w) / 2, img.top + (img.bottom - img.top - h) / 2,
+                           w, h, mem, 0, 0, bm.bmWidth, abs(bm.bmHeight), bf );
+        }
+        else
+            StretchBlt( hdc, img.left + (img.right - img.left - w) / 2, img.top + (img.bottom - img.top - h) / 2,
+                        w, h, mem, 0, 0, bm.bmWidth, abs(bm.bmHeight), SRCCOPY );
+        SelectObject( mem, old );
+        DeleteDC( mem );
+    }
+    else if (icon && t->win && !t->win->elevated)
+        DrawIconEx( hdc, (img.left + img.right) / 2 - SG_PX(16), (img.top + img.bottom) / 2 - SG_PX(16),
+                    t->win->exe_icon_big ? t->win->exe_icon_big : icon, SG_PX(32), SG_PX(32), 0, NULL, DI_NORMAL );
+}
+
+static void activate_taskbar_window( HWND hwnd );
+
+static LRESULT CALLBACK sg_tile_proc( HWND tile, UINT msg, WPARAM wp, LPARAM lp )
+{
+    struct sg_tile *t = &sg_tiles[GetWindowLongPtrW( tile, GWLP_USERDATA )];
+
+    switch (msg)
+    {
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint( tile, &ps );
+        sg_paint_tile( tile, hdc );
+        EndPaint( tile, &ps );
+        return 0;
+    }
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_MOUSEMOVE:
+        if (!GetPropW( tile, L"sg_hot" ))
+        {
+            TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, tile };
+            SetPropW( tile, L"sg_hot", (HANDLE)1 );
+            TrackMouseEvent( &tme );
+            InvalidateRect( tile, NULL, FALSE );
+        }
+        KillTimer( tray_window, SG_THUMB_HIDE_TIMER );
+        return 0;
+    case WM_MOUSELEAVE:
+        RemovePropW( tile, L"sg_hot" );
+        InvalidateRect( tile, NULL, FALSE );
+        SetTimer( tray_window, SG_THUMB_HIDE_TIMER, 400, NULL );
+        return 0;
+    case WM_LBUTTONUP:
+    {
+        RECT rc;
+        POINT pt = { (short)LOWORD(lp), (short)HIWORD(lp) };
+        HWND target = t->target, owner = t->win ? t->win->hwnd : NULL;
+        BOOL is_tab = t->is_tab;
+        GetClientRect( tile, &rc );
+        if (pt.x >= rc.right - SG_PX(22) && pt.y < rc.top + SG_PX(21))
+        {
+            /* close: a window gets SC_CLOSE, a tab WM_CLOSE, as on Windows */
+            sg_hide_thumbnails();
+            if (is_tab) PostMessageW( target, WM_CLOSE, 0, 0 );
+            else PostMessageW( target, WM_SYSCOMMAND, SC_CLOSE, 0 );
+            return 0;
+        }
+        sg_hide_thumbnails();
+        if (is_tab)
+        {
+            /* the tab's proxy is told it is activated; its window comes forward */
+            if (owner) activate_taskbar_window( owner );
+            PostMessageW( target, WM_ACTIVATE, MAKEWPARAM( WA_CLICKACTIVE, 0 ), (LPARAM)owner );
+        }
+        else activate_taskbar_window( target );
+        return 0;
+    }
+    }
+    return DefWindowProcW( tile, msg, wp, lp );
+}
+
+static LRESULT CALLBACK sg_thumbs_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    switch (msg)
+    {
+    case WM_ERASEBKGND:
+    {
+        RECT rc;
+        GetClientRect( hwnd, &rc );
+        sg_fill( (HDC)wp, &rc, sg_thumb_bg() );
+        return 1;
+    }
+    case WM_MOUSEACTIVATE:
+        return MA_NOACTIVATE;
+    case WM_MOUSEMOVE:
+    {
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd };
+        KillTimer( tray_window, SG_THUMB_HIDE_TIMER );
+        TrackMouseEvent( &tme );
+        return 0;
+    }
+    case WM_MOUSELEAVE:
+        SetTimer( tray_window, SG_THUMB_HIDE_TIMER, 400, NULL );
+        return 0;
+    case WM_DRAWITEM:
+    {
+        const DRAWITEMSTRUCT *dis = (const DRAWITEMSTRUCT *)lp;
+        struct sg_tile *t = &sg_tiles[GetWindowLongPtrW( dis->hwndItem, GWLP_USERDATA )];
+        struct sg_thumb_btn *b = NULL;
+        UINT i;
+        for (i = 0; t->win && i < t->win->thumb_count; i++) if (t->win->thumb[i].id == dis->CtlID) b = &t->win->thumb[i];
+        sg_fill( dis->hDC, &dis->rcItem, sg_thumb_bg() );
+        if (!b) return TRUE;
+        if (!(b->flags & THBF_NOBACKGROUND) && (dis->itemState & (ODS_SELECTED | ODS_HOTLIGHT)) &&
+            !(b->flags & (THBF_DISABLED | THBF_NONINTERACTIVE)))
+            sg_fill( dis->hDC, &dis->rcItem, sg_thumb_hot() );
+        if (b->icon)
+            DrawIconEx( dis->hDC, (dis->rcItem.left + dis->rcItem.right) / 2 - SG_PX(8),
+                        (dis->rcItem.top + dis->rcItem.bottom) / 2 - SG_PX(8), b->icon, SG_PX(16), SG_PX(16), 0, NULL,
+                        DI_NORMAL );
+        if (b->flags & THBF_DISABLED)  /* greyed */
+        {
+            BLENDFUNCTION bf = { AC_SRC_OVER, 0, 160, 0 };
+            HDC mem = CreateCompatibleDC( dis->hDC );
+            HBITMAP bmp = CreateCompatibleBitmap( dis->hDC, 1, 1 );
+            HGDIOBJ old = SelectObject( mem, bmp );
+            SetPixel( mem, 0, 0, sg_thumb_bg() );
+            GdiAlphaBlend( dis->hDC, dis->rcItem.left, dis->rcItem.top, dis->rcItem.right - dis->rcItem.left,
+                           dis->rcItem.bottom - dis->rcItem.top, mem, 0, 0, 1, 1, bf );
+            SelectObject( mem, old );
+            DeleteObject( bmp );
+            DeleteDC( mem );
+        }
+        return TRUE;
+    }
+    case WM_COMMAND:
+        if (HIWORD(wp) == BN_CLICKED && lp)
+        {
+            struct sg_tile *t = &sg_tiles[GetWindowLongPtrW( (HWND)lp, GWLP_USERDATA )];
+            UINT i, id = LOWORD(wp);
+            for (i = 0; t->win && i < t->win->thumb_count; i++)
+            {
+                struct sg_thumb_btn *b = &t->win->thumb[i];
+                HWND target = t->win->hwnd;
+                if (b->id != id) continue;
+                if (b->flags & (THBF_DISABLED | THBF_NONINTERACTIVE | THBF_HIDDEN)) break;
+                if (b->flags & THBF_DISMISSONCLICK) sg_hide_thumbnails();
+#ifndef SG_MUTANT_NO_THUMB_CLICK
+                PostMessageW( target, WM_COMMAND, MAKEWPARAM( id, SG_THBN_CLICKED ), 0 );
+#endif
+                break;
+            }
+        }
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+static void sg_show_thumbnails( HWND button )
+{
+    static BOOL registered;
+    struct taskbar_button *win = find_taskbar_button( (HWND)GetWindowLongPtrW( button, GWLP_ID ) ), *other;
+    struct taskbar_button *leader;
+    TOOLINFOW ti = { sizeof(ti) };
+    RECT brc, work;
+    MONITORINFO mi = { sizeof(mi) };
+    int width, height, x, y, bar_h = 0;
+    UINT n = 0, j;
+
+    if (!win || win->xwin) return;
+    leader = win->group ? win->group : win;
+    if (sg_thumb_popup && sg_thumb_button_for == button) return;
+    sg_hide_thumbnails();
+
+    if (!registered)
+    {
+        WNDCLASSW wc = { 0 };
+        wc.lpfnWndProc = sg_thumbs_proc;
+        wc.hCursor = LoadCursorW( NULL, (LPCWSTR)IDC_ARROW );
+        wc.lpszClassName = L"SGTaskbarThumbnails";
+        wc.style = CS_DROPSHADOW;
+        RegisterClassW( &wc );
+        wc.lpfnWndProc = sg_tile_proc;
+        wc.lpszClassName = L"SGTaskbarThumbnail";
+        wc.style = 0;
+        RegisterClassW( &wc );
+        registered = TRUE;
+    }
+
+    /* the windows of the button: the group's when combined, each window's tabs in its place */
+    LIST_FOR_EACH_ENTRY( other, &taskbar_buttons, struct taskbar_button, entry )
+    {
+        if (!other->hwnd || !other->visible || other->xwin) continue;
+        if (other != win && !(leader->combined && other->group == leader)) continue;
+        sg_capture( other );
+        if (other->tab_count)
+        {
+            for (j = 0; j < other->tab_count && n < ARRAY_SIZE(sg_tiles); j++)
+            {
+                if (!IsWindow( other->tabs[j] )) continue;
+                sg_tiles[n].target = other->tabs[j];
+                sg_tiles[n].is_tab = TRUE;
+                sg_tiles[n++].win = other;
+            }
+        }
+        else if (n < ARRAY_SIZE(sg_tiles))
+        {
+            sg_tiles[n].target = other->hwnd;
+            sg_tiles[n].is_tab = FALSE;
+            sg_tiles[n++].win = other;
+        }
+    }
+    if (!n) return;
+    for (j = 0; j < n; j++)
+        if (sg_tiles[j].win->thumb_count && !sg_tiles[j].is_tab) bar_h = SG_THUMB_BAR_H;
+
+    width = n * SG_THUMB_W + (n + 1) * SG_THUMB_PAD;
+    height = SG_THUMB_TITLE_H + SG_THUMB_IMG_H + bar_h + 2 * SG_THUMB_PAD;
+    GetWindowRect( button, &brc );
+    GetMonitorInfoW( MonitorFromWindow( button, MONITOR_DEFAULTTOPRIMARY ), &mi );
+    work = mi.rcMonitor;
+    x = (brc.left + brc.right) / 2 - width / 2;
+    x = max( work.left, min( x, work.right - width ) );
+    y = sg_bar.edge == ABE_TOP ? brc.bottom + SG_PX(4) : brc.top - height - SG_PX(4);
+
+    sg_thumb_popup = CreateWindowExW( WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_NOACTIVATE, L"SGTaskbarThumbnails",
+                                      L"", WS_POPUP | WS_BORDER, x, y, width, height, tray_window, NULL, NULL, NULL );
+    if (!sg_thumb_popup) return;
+    sg_thumb_button_for = button;
+    sg_thumb_leader = leader;
+    sg_thumb_tip_window = CreateWindowExW( WS_EX_TOPMOST, TOOLTIPS_CLASSW, NULL, WS_POPUP | TTS_ALWAYSTIP | TTS_NOPREFIX,
+                                           0, 0, 0, 0, sg_thumb_popup, NULL, NULL, NULL );
+    for (j = 0; j < n; j++)
+    {
+        struct sg_tile *t = &sg_tiles[j];
+        WCHAR title[256];
+        int tx = SG_THUMB_PAD + j * (SG_THUMB_W + SG_THUMB_PAD);
+
+        sg_tile_title( t, title, ARRAY_SIZE(title) );
+        t->tile = CreateWindowExW( 0, L"SGTaskbarThumbnail", title, WS_CHILD | WS_VISIBLE, tx, SG_THUMB_PAD,
+                                   SG_THUMB_W, SG_THUMB_TITLE_H + SG_THUMB_IMG_H, sg_thumb_popup, NULL, NULL, NULL );
+        SetWindowLongPtrW( t->tile, GWLP_USERDATA, j );
+        if (sg_thumb_tip_window)
+        {
+            ti.uFlags = TTF_IDISHWND | TTF_SUBCLASS;
+            ti.hwnd = sg_thumb_popup;
+            ti.uId = (UINT_PTR)t->tile;
+            ti.lpszText = (!t->is_tab && t->win->thumb_tip) ? t->win->thumb_tip : title;
+            SendMessageW( sg_thumb_tip_window, TTM_ADDTOOLW, 0, (LPARAM)&ti );
+        }
+        /* iconic: ask for the bitmap (it comes back through dwmapi) */
+        if (t->is_tab || sg_is_iconic_window( t->target ))
+            PostMessageW( t->target, WM_DWMSENDICONICTHUMBNAIL, 0,
+                          MAKELPARAM( SG_THUMB_IMG_H - SG_PX(6), SG_THUMB_W - SG_PX(12) ) );
+        /* the thumbnail toolbar, centred under the window's thumbnail */
+        if (!t->is_tab && t->win->thumb_count)
+        {
+            UINT shown = 0, k;
+            int bw = SG_PX(28), bx;
+            for (k = 0; k < t->win->thumb_count; k++) if (!(t->win->thumb[k].flags & THBF_HIDDEN)) shown++;
+            bx = tx + (SG_THUMB_W - (int)shown * bw) / 2;
+            for (k = 0; k < t->win->thumb_count; k++)
+            {
+                struct sg_thumb_btn *b = &t->win->thumb[k];
+                HWND btn;
+                if (b->flags & THBF_HIDDEN) continue;
+                btn = CreateWindowExW( 0, WC_BUTTONW, b->tip, WS_CHILD | WS_VISIBLE | BS_OWNERDRAW |
+                                       ((b->flags & THBF_DISABLED) ? WS_DISABLED : 0),
+                                       bx, SG_THUMB_PAD + SG_THUMB_TITLE_H + SG_THUMB_IMG_H + SG_PX(2), bw, bw,
+                                       sg_thumb_popup, (HMENU)(UINT_PTR)b->id, NULL, NULL );
+                SetWindowLongPtrW( btn, GWLP_USERDATA, j );
+                if (sg_thumb_tip_window && b->tip[0])
+                {
+                    ti.uFlags = TTF_IDISHWND | TTF_SUBCLASS;
+                    ti.hwnd = sg_thumb_popup;
+                    ti.uId = (UINT_PTR)btn;
+                    ti.lpszText = b->tip;
+                    SendMessageW( sg_thumb_tip_window, TTM_ADDTOOLW, 0, (LPARAM)&ti );
+                }
+                bx += bw;
+            }
+        }
+    }
+    sg_tile_count = n;
+    ShowWindow( sg_thumb_popup, SW_SHOWNOACTIVATE );
+}
+
+/* what a thumbnail shows changed: repaint it */
+static void sg_thumbs_changed( HWND hwnd )
+{
+    UINT i;
+    if (!sg_thumb_popup) return;
+    for (i = 0; i < sg_tile_count; i++)
+        if (sg_tiles[i].target == hwnd || (sg_tiles[i].win && sg_tiles[i].win->hwnd == hwnd))
+        {
+            /* the toolbar changed: lay it out again */
+            HWND button = sg_thumb_button_for;
+            sg_hide_thumbnails();
+            sg_show_thumbnails( button );
+            return;
+        }
+}
+
+/* the pointer stays over a window's button: its thumbnails */
+static void sg_thumb_hover( HWND button, UINT msg )
+{
+    switch (msg)
+    {
+    case WM_MOUSEMOVE:
+        if (!GetPropW( button, L"sg_tracking" ))
+        {
+            TRACKMOUSEEVENT tme = { sizeof(tme), TME_HOVER | TME_LEAVE, button, SG_THUMB_HOVER_MS };
+            SetPropW( button, L"sg_tracking", (HANDLE)1 );
+            TrackMouseEvent( &tme );
+        }
+        if (sg_thumb_popup && sg_thumb_button_for == button) KillTimer( tray_window, SG_THUMB_HIDE_TIMER );
+        break;
+    case WM_MOUSEHOVER:
+        RemovePropW( button, L"sg_tracking" );
+#ifndef SG_MUTANT_NO_THUMBNAILS
+        sg_show_thumbnails( button );
+#endif
+        break;
+    case WM_MOUSELEAVE:
+        RemovePropW( button, L"sg_tracking" );
+        if (sg_thumb_popup) SetTimer( tray_window, SG_THUMB_HIDE_TIMER, 400, NULL );
+        break;
+    case WM_LBUTTONDOWN:
+    case WM_RBUTTONDOWN:
+        sg_hide_thumbnails();
+        break;
+    }
+}
+
+static void sg_thumb_hide_timer(void)
+{
+    POINT pt;
+    RECT rc;
+    GetCursorPos( &pt );
+    if (sg_thumb_popup && GetWindowRect( sg_thumb_popup, &rc ) && PtInRect( &rc, pt )) return;
+    if (sg_thumb_button_for && GetWindowRect( sg_thumb_button_for, &rc ) && PtInRect( &rc, pt )) return;
+    sg_hide_thumbnails();
+}
