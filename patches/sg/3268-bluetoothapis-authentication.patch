From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:54:16 -0700
Subject: [PATCH] bluetoothapis: authentication registrations (3268)

BluetoothRegisterForAuthenticationEx returns ERROR_SUCCESS and a registration handle (kept in a list), BluetoothUnregisterAuthentication removes it (FALSE with ERROR_INVALID_HANDLE for NULL or unknown). No authentication events are raised: there is no radio.

diff --git a/dlls/bluetoothapis/main.c b/dlls/bluetoothapis/main.c
index 076d758..5797996 100644
--- a/dlls/bluetoothapis/main.c
+++ b/dlls/bluetoothapis/main.c
@@ -20,12 +20,14 @@
  */
 
 #include <stdarg.h>
+#include <stdlib.h>
 #include <windef.h>
 #include <winbase.h>
 #include <winuser.h>
 #include <winreg.h>
 
 #include "wine/debug.h"
+#include "wine/list.h"
 #include "bthsdpdef.h"
 #include "bluetoothapis.h"
 #include "setupapi.h"
@@ -193,14 +195,49 @@ BOOL WINAPI BluetoothFindNextDevice(HBLUETOOTH_DEVICE_FIND find, BLUETOOTH_DEVIC
     return FALSE;
 }
 
+/* Registrations for authentication events. The events come from a radio's pairing requests; there is no
+ * radio, so none is raised, and the registration only has to be kept until it is removed. */
+#define AUTH_REG_MAGIC 0x42544152
+struct auth_registration
+{
+    struct list entry;
+    DWORD magic;
+    PFN_AUTHENTICATION_CALLBACK_EX callback;
+    void *param;
+};
+static struct list auth_registrations = LIST_INIT(auth_registrations);
+static CRITICAL_SECTION auth_cs;
+static CRITICAL_SECTION_DEBUG auth_cs_debug =
+{
+    0, 0, &auth_cs,
+    { &auth_cs_debug.ProcessLocksList, &auth_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": auth_cs") }
+};
+static CRITICAL_SECTION auth_cs = { &auth_cs_debug, -1, 0, 0, 0, 0 };
+
 /*********************************************************************
  *  BluetoothRegisterForAuthenticationEx
  */
 DWORD WINAPI BluetoothRegisterForAuthenticationEx(const BLUETOOTH_DEVICE_INFO *info, HBLUETOOTH_AUTHENTICATION_REGISTRATION *out,
                                                   PFN_AUTHENTICATION_CALLBACK_EX callback, void *param)
 {
-    FIXME("(%p, %p, %p, %p): stub!\n", info, out, callback, param);
+    struct auth_registration *reg;
+
+    FIXME("(%p, %p, %p, %p): no authentication events are raised here\n", info, out, callback, param);
+
+#ifdef SG_MUTANT_BT_AUTH
     return ERROR_CALL_NOT_IMPLEMENTED;
+#endif
+    if (!out || !callback) return ERROR_INVALID_PARAMETER;
+    if (!(reg = calloc(1, sizeof(*reg)))) return ERROR_OUTOFMEMORY;
+    reg->magic = AUTH_REG_MAGIC;
+    reg->callback = callback;
+    reg->param = param;
+    EnterCriticalSection(&auth_cs);
+    list_add_tail(&auth_registrations, &reg->entry);
+    LeaveCriticalSection(&auth_cs);
+    *out = (HBLUETOOTH_AUTHENTICATION_REGISTRATION)reg;
+    return ERROR_SUCCESS;
 }
 
 /*********************************************************************
@@ -208,7 +245,34 @@ DWORD WINAPI BluetoothRegisterForAuthenticationEx(const BLUETOOTH_DEVICE_INFO *i
  */
 BOOL WINAPI BluetoothUnregisterAuthentication(HBLUETOOTH_AUTHENTICATION_REGISTRATION handle)
 {
-    FIXME("(%p): stub!\n", handle);
-    if (!handle) SetLastError(ERROR_INVALID_HANDLE);
+    struct auth_registration *reg;
+    BOOL found = FALSE;
+
+    TRACE("(%p)\n", handle);
+
+#ifdef SG_MUTANT_BT_AUTH
     return FALSE;
+#endif
+    if (!handle)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    EnterCriticalSection(&auth_cs);
+    LIST_FOR_EACH_ENTRY(reg, &auth_registrations, struct auth_registration, entry)
+    {
+        if (reg != (struct auth_registration *)handle) continue;
+        list_remove(&reg->entry);
+        found = TRUE;
+        break;
+    }
+    LeaveCriticalSection(&auth_cs);
+    if (!found)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    reg->magic = 0;
+    free(reg);
+    return TRUE;
 }
