From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: IQueryAssociations strings and values, folder view rename (3688)

shell32: IQueryAssociations strings and values, folder view rename

IQueryAssociations::GetString answers the DDE command, ifexec, application
and topic of a verb, DropTarget, DelegateExecute, NoOpen, InfoTip, QuickTip,
TileInfo and AppUserModelID; GetData answers ASSOCDATA_VALUE.
IFolderView2::GetSortColumnCount and DoRename (label edit of the focused
item).
---
diff --git a/dlls/shell32/assoc.c b/dlls/shell32/assoc.c
index 672a4be..40f800d 100644
--- a/dlls/shell32/assoc.c
+++ b/dlls/shell32/assoc.c
@@ -450,11 +450,10 @@ static HRESULT ASSOC_GetValue(HKEY hkey, const WCHAR *name, void **data, DWORD *
   return S_OK;
 }
 
-static HRESULT ASSOC_GetCommand(IQueryAssociationsImpl *This, const WCHAR *extra, WCHAR **command)
+/* The key of a verb (the given one, or the default one, or the first): shell\<verb> */
+static HRESULT ASSOC_OpenVerbKey(IQueryAssociationsImpl *This, const WCHAR *extra, HKEY *verb)
 {
-  HKEY hkeyCommand;
   HKEY hkeyShell;
-  HKEY hkeyVerb;
   HRESULT hr;
   LONG ret;
   WCHAR *extra_from_reg = NULL;
@@ -523,10 +522,21 @@ static HRESULT ASSOC_GetCommand(IQueryAssociationsImpl *This, const WCHAR *extra
   }
 
   /* open verb subkey */
-  ret = RegOpenKeyExW(hkeyShell, extra, 0, KEY_READ, &hkeyVerb);
+  ret = RegOpenKeyExW(hkeyShell, extra, 0, KEY_READ, verb);
   free(extra_from_reg);
   RegCloseKey(hkeyShell);
-  if (ret) return HRESULT_FROM_WIN32(ret);
+  return HRESULT_FROM_WIN32(ret);
+}
+
+
+static HRESULT ASSOC_GetCommand(IQueryAssociationsImpl *This, const WCHAR *extra, WCHAR **command)
+{
+  HKEY hkeyCommand;
+  HKEY hkeyVerb;
+  HRESULT hr;
+  LONG ret;
+
+  if (FAILED(hr = ASSOC_OpenVerbKey(This, extra, &hkeyVerb))) return hr;
 
   /* open command subkey */
   ret = RegOpenKeyExW(hkeyVerb, L"command", 0, KEY_READ, &hkeyCommand);
@@ -681,7 +691,7 @@ static HRESULT WINAPI IQueryAssociations_fnGetString(
   if (!This->hkeySource && !This->hkeyProgID)
     return HRESULT_FROM_WIN32(ERROR_NO_ASSOCIATION);
 
-  switch (str)
+  switch ((int)str)
   {
     case ASSOCSTR_COMMAND:
     {
@@ -845,6 +855,62 @@ get_friendly_name_fail:
         return ASSOC_ReturnString(flags, pszOut, pcchOut, guid, size / sizeof(WCHAR));
     }
 
+    case ASSOCSTR_NOOPEN:
+    case ASSOCSTR_INFOTIP:
+    case ASSOCSTR_QUICKTIP:
+    case ASSOCSTR_TILEINFO:
+    case 21: /* ASSOCSTR_APPID */
+    {
+      /* a string value of the class: NoOpen, InfoTip, QuickTip, TileInfo, AppUserModelID */
+      static const WCHAR *names[] = { L"NoOpen", L"InfoTip", L"QuickTip", L"TileInfo" };
+      const WCHAR *name = str == 21 ? L"AppUserModelID" : names[str == ASSOCSTR_NOOPEN ? 0 : str - ASSOCSTR_INFOTIP + 1];
+      HKEY key = This->hkeyProgID ? This->hkeyProgID : This->hkeySource;
+      WCHAR *value;
+
+      hr = ASSOC_GetValue(key, name, (void **)&value, NULL);
+      if (FAILED(hr)) return HRESULT_FROM_WIN32(ERROR_NO_ASSOCIATION);
+      hr = ASSOC_ReturnString(flags, pszOut, pcchOut, value, lstrlenW(value) + 1);
+      free(value);
+      return hr;
+    }
+
+    case ASSOCSTR_DDECOMMAND:
+    case ASSOCSTR_DDEIFEXEC:
+    case ASSOCSTR_DDEAPPLICATION:
+    case ASSOCSTR_DDETOPIC:
+    case 17: /* ASSOCSTR_DROPTARGET */
+    case 18: /* ASSOCSTR_DELEGATEEXECUTE */
+    {
+      /* values below the verb: shell\<verb>\ddeexec (default, ifexec, application, topic),
+         DropTarget\CLSID, command\DelegateExecute */
+      const WCHAR *sub = L"ddeexec", *name = NULL;
+      HKEY verb, key;
+      WCHAR *value;
+      LONG ret;
+
+      switch ((int)str)
+      {
+      case ASSOCSTR_DDEIFEXEC: sub = L"ddeexec\\ifexec"; break;
+      case ASSOCSTR_DDEAPPLICATION: sub = L"ddeexec\\application"; break;
+      case ASSOCSTR_DDETOPIC: sub = L"ddeexec\\topic"; break;
+      case 17: sub = L"DropTarget"; name = L"CLSID"; break;
+      case 18: sub = L"command"; name = L"DelegateExecute"; break;
+      }
+#ifdef SG_MUTANT_GETSTR
+      return E_NOTIMPL;
+#endif
+      if (FAILED(hr = ASSOC_OpenVerbKey(This, pszExtra, &verb))) return hr;
+      ret = RegOpenKeyExW(verb, sub, 0, KEY_READ, &key);
+      RegCloseKey(verb);
+      if (ret) return HRESULT_FROM_WIN32(ret);
+      hr = ASSOC_GetValue(key, name, (void **)&value, NULL);
+      RegCloseKey(key);
+      if (FAILED(hr)) return HRESULT_FROM_WIN32(ERROR_NO_ASSOCIATION);
+      hr = ASSOC_ReturnString(flags, pszOut, pcchOut, value, lstrlenW(value) + 1);
+      free(value);
+      return hr;
+    }
+
     default:
       FIXME("assocstr %d unimplemented!\n", str);
       return E_NOTIMPL;
@@ -957,6 +1023,18 @@ static HRESULT WINAPI IQueryAssociations_fnGetData(IQueryAssociations *iface,
             hres = ASSOC_ReturnData(pvOut, pcbOut, data, size);
         free(data);
         return hres;
+    case ASSOCDATA_VALUE:
+    {
+        /* the named value of the class, as it is stored */
+        HKEY key = This->hkeyProgID ? This->hkeyProgID : This->hkeySource;
+
+        if (!key || !pszExtra) return HRESULT_FROM_WIN32(ERROR_NO_ASSOCIATION);
+        hres = ASSOC_GetValue(key, pszExtra, &data, &size);
+        if (SUCCEEDED(hres) && pcbOut)
+            hres = ASSOC_ReturnData(pvOut, pcbOut, data, size);
+        free(data);
+        return hres;
+    }
     default:
         FIXME("Unsupported ASSOCDATA value: %d\n", assocdata);
         return E_NOTIMPL;
diff --git a/dlls/shell32/shlview.c b/dlls/shell32/shlview.c
index ec9a86e..22b0881 100644
--- a/dlls/shell32/shlview.c
+++ b/dlls/shell32/shlview.c
@@ -4618,8 +4618,13 @@ static HRESULT WINAPI FolderView2_GetCurrentFolderFlags(IFolderView2 *iface, DWO
 static HRESULT WINAPI FolderView2_GetSortColumnCount(IFolderView2 *iface, int *columns)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p)->(%p), stub\n", This, columns);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, columns);
+
+    /* the view sorts by one column */
+    if (!columns) return E_POINTER;
+    *columns = 1;
+    return S_OK;
 }
 
 static HRESULT WINAPI FolderView2_SetSortColumns(IFolderView2 *iface, const SORTCOLUMN *columns,
@@ -4865,8 +4870,18 @@ static HRESULT WINAPI FolderView2_IsMoveInSameFolder(IFolderView2 *iface)
 static HRESULT WINAPI FolderView2_DoRename(IFolderView2 *iface)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p), stub\n", This);
-    return E_NOTIMPL;
+    int focus;
+
+    TRACE("(%p)\n", This);
+
+    /* edit the name of the focused item in place */
+    if (!This->hWndList) return E_FAIL;
+    if ((focus = SendMessageW(This->hWndList, LVM_GETNEXTITEM, -1, LVNI_FOCUSED)) < 0) return S_FALSE;
+    SetFocus(This->hWndList);
+#ifdef SG_MUTANT_FV_RENAME
+    return S_OK;
+#endif
+    return SendMessageW(This->hWndList, LVM_EDITLABELW, focus, 0) ? S_OK : E_FAIL;
 }
 
 static const IFolderView2Vtbl folderviewvtbl =
