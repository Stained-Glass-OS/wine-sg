+        {
+            *flags = source->deselected ? 0 : AMSTREAMSELECTINFO_ENABLED;
+#ifdef SG_MUTANT_SELFLAGS
+            *flags = 0;
+#endif
+            if (parser_group_size(filter, source_group) > 1)
+                *flags |= AMSTREAMSELECTINFO_EXCLUSIVE;
