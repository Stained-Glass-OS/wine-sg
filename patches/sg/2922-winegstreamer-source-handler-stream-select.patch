 }
 
+static void parser_source_select(struct parser *filter, struct parser_source *source, bool select)
+{
+    struct wg_format format;
+
+#ifdef SG_MUTANT_SELNOOP
+    if (!select)
+        return;
+#endif
+    source->deselected = !select;
+    /* While streaming the parser is told at once; otherwise it is when the
+     * filter goes to paused. */
+    if (!filter->streaming || !source->pin.pin.peer)
+        return;
+    if (select && amt_to_wg_format(&source->pin.pin.mt, &format))
+        wg_parser_stream_enable(source->wg_stream, &format);
+    else
+        wg_parser_stream_disable(source->wg_stream);
+}
+
 static HRESULT WINAPI stream_select_Enable(IAMStreamSelect *iface, LONG index, DWORD flags)
 {
-    FIXME("iface %p, index %ld, flags %#lx, stub!\n", iface, index, flags);
-    return E_NOTIMPL;
+    struct parser *filter = impl_from_IAMStreamSelect(iface);
+    unsigned int i;
+    DWORD group;
+
+    TRACE("filter %p, index %ld, flags %#lx.\n", filter, index, flags);
+
+    if (flags & ~(AMSTREAMSELECTENABLE_ENABLE | AMSTREAMSELECTENABLE_ENABLEALL))
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&filter->filter.filter_cs);
+
+    if (!filter->sink.pin.peer)
+    {
+        LeaveCriticalSection(&filter->filter.filter_cs);
+        return VFW_E_NOT_CONNECTED;
+    }
+
+    if (flags & AMSTREAMSELECTENABLE_ENABLEALL)
+    {
+        /* Every stream, whatever the index. */
+        for (i = 0; i < filter->source_count; ++i)
+            parser_source_select(filter, filter->sources[i], true);
+    }
+    else if (index < 0 || index >= filter->source_count)
+    {
+        LeaveCriticalSection(&filter->filter.filter_cs);
+        return E_INVALIDARG;
+    }
+    else if (flags & AMSTREAMSELECTENABLE_ENABLE)
+    {
+        /* The stream is enabled and, the group being exclusive, its
+         * neighbours are not. */
+        group = parser_source_group(filter->sources[index]);
+        for (i = 0; i < filter->source_count; ++i)
+        {
+            if (i != index && parser_source_group(filter->sources[i]) == group)
+                parser_source_select(filter, filter->sources[i], false);
+        }
+        parser_source_select(filter, filter->sources[index], true);
+    }
+    else
+        parser_source_select(filter, filter->sources[index], false);
+
+    LeaveCriticalSection(&filter->filter.filter_cs);
+    return S_OK;
 }
 
