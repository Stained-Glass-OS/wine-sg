+/* The streams of the parser, as IAMStreamSelect lists them: one group for
+ * the video streams, one for the audio streams, one for the rest. A group that
+ * holds several streams is exclusive: enabling one disables the others. */
+static DWORD parser_source_group(const struct parser_source *source)
+{
+    struct wg_format format;
+
+    wg_parser_stream_get_current_format(source->wg_stream, &format);
+    switch (format.major_type)
+    {
+        case WG_MAJOR_TYPE_VIDEO:
+        case WG_MAJOR_TYPE_VIDEO_CINEPAK:
+        case WG_MAJOR_TYPE_VIDEO_H264:
+        case WG_MAJOR_TYPE_VIDEO_WMV:
+        case WG_MAJOR_TYPE_VIDEO_INDEO:
+        case WG_MAJOR_TYPE_VIDEO_MPEG1:
+            return 0;
+        case WG_MAJOR_TYPE_AUDIO:
+        case WG_MAJOR_TYPE_AUDIO_MPEG1:
+        case WG_MAJOR_TYPE_AUDIO_MPEG4:
+        case WG_MAJOR_TYPE_AUDIO_WMA:
+            return 1;
+        case WG_MAJOR_TYPE_UNKNOWN:
+            break;
+    }
+    return 2;
+}
+
+static unsigned int parser_group_size(struct parser *filter, DWORD group)
+{
+    unsigned int i, count = 0;
+
+    for (i = 0; i < filter->source_count; ++i)
+        count += parser_source_group(filter->sources[i]) == group;
+    return count;
+}
+
+/* The MPEG splitter names a stream by its PES stream id: 0xE0 + n for the
+ * n-th video stream, 0xC0 + n for the n-th audio stream. */
+static WCHAR *parser_source_name(struct parser *filter, unsigned int index)
+{
+    const struct parser_source *source = filter->sources[index];
+    WCHAR buffer[128];
+    unsigned int i, n = 0;
+    DWORD group = parser_source_group(source);
+    WCHAR *name;
+
+    if (IsEqualGUID(&filter->filter.clsid, &CLSID_MPEG1Splitter) && group < 2)
+    {
+        for (i = 0; i < index; ++i)
+            n += parser_source_group(filter->sources[i]) == group;
+        swprintf(buffer, ARRAY_SIZE(buffer), L"Stream(%02X)", (group ? 0xc0 : 0xe0) + n);
+    }
+    else
+        wcscpy(buffer, source->pin.pin.name);
+
+    if ((name = CoTaskMemAlloc((wcslen(buffer) + 1) * sizeof(WCHAR))))
+        wcscpy(name, buffer);
+    return name;
+}
+
