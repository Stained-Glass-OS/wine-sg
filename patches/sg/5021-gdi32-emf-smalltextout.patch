From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdi32: Play EMR_SMALLTEXTOUT records.

PlayEnhMetaFileRecord plays EMR_SMALLTEXTOUT (MS-EMF 2.3.5.37): text at a
point with 16-bit characters, or 8-bit ones with ETO_SMALL_CHARS, a clip
rectangle unless ETO_NO_RECT, no Dx array. It was ignored with a FIXME.
The other records in that FIXME list stay unplayed.

Gate: test/gdi32-smalltextout-gate.sh (64/32).
---
 dlls/gdi32/enhmetafile.c | 48 +++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 47 insertions(+), 1 deletion(-)

diff --git a/dlls/gdi32/enhmetafile.c b/dlls/gdi32/enhmetafile.c
index 89622ef..84ba181 100644
--- a/dlls/gdi32/enhmetafile.c
+++ b/dlls/gdi32/enhmetafile.c
@@ -1288,6 +1288,53 @@ BOOL WINAPI PlayEnhMetaFileRecord(
 	break;
     }
 
+    case EMR_SMALLTEXTOUT:
+    {
+        /* MS-EMF 2.3.5.37: no Dx array; no clip rectangle with ETO_NO_RECT,
+         * 8-bit characters with ETO_SMALL_CHARS */
+        const struct
+        {
+            EMR emr;
+            POINTL ptl;
+            DWORD chars, options, graphics_mode;
+            FLOAT ex_scale, ey_scale;
+        } *small = (const void *)mr;
+        const BYTE *data = (const BYTE *)(small + 1);
+        DWORD options = small->options, i, size;
+        RECT rc, *clip = NULL;
+        WCHAR *str;
+        int old_mode;
+
+#ifdef SG_MUTANT_SMALLTEXT_IGNORED
+        break;
+#endif
+        if (mr->nSize < sizeof(*small) || small->chars > mr->nSize) break;
+        if (!(options & 0x100))
+        {
+            const RECTL *r = (const RECTL *)data;
+            if (mr->nSize < sizeof(*small) + sizeof(*r)) break;
+            rc.left = r->left; rc.top = r->top; rc.right = r->right; rc.bottom = r->bottom;
+            clip = &rc;
+            data += sizeof(*r);
+        }
+        size = small->chars * ((options & 0x200) ? 1 : sizeof(WCHAR));
+        if (data + size > (const BYTE *)mr + mr->nSize) break;
+        if (!(str = HeapAlloc( GetProcessHeap(), 0, small->chars * sizeof(WCHAR) + 1 ))) break;
+#ifndef SG_MUTANT_SMALLTEXT_WIDE_ONLY
+        if (options & 0x200)
+            for (i = 0; i < small->chars; i++) str[i] = data[i];
+        else
+#endif
+            memcpy( str, data, small->chars * sizeof(WCHAR) );
+
+        old_mode = SetGraphicsMode( hdc, small->graphics_mode );
+        SelectObject( hdc, GetCurrentObject( hdc, OBJ_FONT ) );
+        ExtTextOutW( hdc, small->ptl.x, small->ptl.y, options & ~0x300, clip, str, small->chars, NULL );
+        SetGraphicsMode( hdc, old_mode );
+        HeapFree( GetProcessHeap(), 0, str );
+        break;
+    }
+
     case EMR_CREATEPALETTE:
       {
 	const EMRCREATEPALETTE *lpCreatePal = (const EMRCREATEPALETTE *)mr;
@@ -2324,7 +2371,6 @@ BOOL WINAPI PlayEnhMetaFileRecord(
     case EMR_DRAWESCAPE:
     case EMR_EXTESCAPE:
     case EMR_STARTDOC:
-    case EMR_SMALLTEXTOUT:
     case EMR_FORCEUFIMAPPING:
     case EMR_NAMEDESCAPE:
     case EMR_COLORCORRECTPALETTE:
