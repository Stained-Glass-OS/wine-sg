From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: Perflib v2 providers keep their own allocators; single-instance counter sets

- PerfStartProviderEx logged "semi-stub" and ignored the provider's
  MemAllocRoutine/MemFreeRoutine/pMemContext; they now allocate and free the
  instance blocks PerfCreateInstance hands out (the provider's own
  bookkeeping stays on our heap), and one routine without the other is
  ERROR_INVALID_PARAMETER.
- PerfCreateInstance on a counter set that is not PERF_COUNTERSET_FLAG_MULTIPLE
  allows exactly one instance: a second one, whatever its id, is
  ERROR_ALREADY_EXISTS.
- PerfStartProvider(Ex), PerfSetCounterSetInfo, PerfCreateInstance and
  PerfSetCounterRefValue worked but logged a FIXME on every call (real
  programs call them in loops); they now trace.

---
--- a/dlls/kernelbase/main.c
+++ b/dlls/kernelbase/main.c
@@ -206,12 +206,35 @@
     struct counterset_template **countersets;
     unsigned int counterset_count;
 
+    /* a provider's own instance allocator (PERF_PROVIDER_CONTEXT), used for
+     * PERF_COUNTERSET_INSTANCE blocks only -- the provider's own bookkeeping
+     * (countersets, the instance list entries) stays on our heap either way */
+    PERF_MEM_ALLOC mem_alloc;
+    PERF_MEM_FREE mem_free;
+    void *mem_context;
+
     struct list instance_list;
 };
 
 static struct perf_provider *perf_provider_from_handle(HANDLE prov)
 {
     return (struct perf_provider *)prov;
+}
+
+static void *perf_instance_alloc( struct perf_provider *prov, SIZE_T size )
+{
+#ifndef SG_MUTANT_NO_CUSTOM_ALLOC
+    if (prov->mem_alloc) return prov->mem_alloc( size, prov->mem_context );
+#endif
+    return heap_alloc_zero( size );
+}
+
+static void perf_instance_free( struct perf_provider *prov, void *ptr )
+{
+#ifndef SG_MUTANT_NO_CUSTOM_ALLOC
+    if (prov->mem_free) { prov->mem_free( ptr, prov->mem_context ); return; }
+#endif
+    heap_free( ptr );
 }
 
 /***********************************************************************
@@ -226,7 +249,7 @@
     unsigned int i;
     ULONG size;
 
-    FIXME( "handle %p, guid %s, name %s, id %lu semi-stub.\n", handle, debugstr_guid(guid), debugstr_w(name), id );
+    TRACE( "handle %p, guid %s, name %s, id %lu.\n", handle, debugstr_guid(guid), debugstr_w(name), id );
 
     if (!prov || !guid || !name)
     {
@@ -247,7 +270,14 @@
 
     LIST_FOR_EACH_ENTRY(inst, &prov->instance_list, struct counterset_instance, entry)
     {
-        if (inst->template == template && inst->instance.InstanceId == id)
+        if (inst->template != template) continue;
+        /* a single-instance (or single-aggregate) counter set may only ever
+         * have the one instance, whatever id a second PerfCreateInstance asks for */
+        if (inst->instance.InstanceId == id
+#ifndef SG_MUTANT_NO_SINGLE_INSTANCE
+            || !(template->counterset.InstanceType & PERF_COUNTERSET_FLAG_MULTIPLE)
+#endif
+           )
         {
             SetLastError( ERROR_ALREADY_EXISTS );
             return NULL;
@@ -256,12 +286,17 @@
 
     size = (sizeof(PERF_COUNTERSET_INSTANCE) + template->counterset.NumCounters * sizeof(UINT64)
             + (lstrlenW( name ) + 1) * sizeof(WCHAR) + 7) & ~7;
-    inst = heap_alloc_zero( offsetof(struct counterset_instance, instance) + size );
+    /* the whole block (our bookkeeping header plus the instance data the app
+     * gets a pointer into) comes from the provider's own allocator when it
+     * gave one at PerfStartProviderEx -- it never sees our header, only
+     * &inst->instance, exactly as with our own heap */
+    inst = perf_instance_alloc( prov, offsetof(struct counterset_instance, instance) + size );
     if (!inst)
     {
         SetLastError( ERROR_OUTOFMEMORY );
         return NULL;
     }
+    memset( inst, 0, offsetof(struct counterset_instance, instance) + size );
 
     inst->template = template;
     inst->instance.CounterSetGuid = *guid;
@@ -290,7 +325,7 @@
 
     inst = CONTAINING_RECORD(block, struct counterset_instance, instance);
     list_remove( &inst->entry );
-    heap_free( inst );
+    perf_instance_free( prov, inst );
 
     return ERROR_SUCCESS;
 }
@@ -305,7 +340,7 @@
     struct counterset_template *new;
     unsigned int i;
 
-    FIXME( "handle %p, template %p, size %lu semi-stub.\n", handle, template, size );
+    TRACE( "handle %p, template %p, size %lu.\n", handle, template, size );
 
     if (!prov || !template) return ERROR_INVALID_PARAMETER;
     if (!template->NumCounters) return ERROR_INVALID_PARAMETER;
@@ -351,7 +386,7 @@
     struct counterset_instance *inst;
     unsigned int i;
 
-    FIXME( "provider %p, instance %p, counterid %lu, address %p semi-stub.\n",
+    TRACE( "provider %p, instance %p, counterid %lu, address %p.\n",
            provider, instance, counterid, address );
 
     if (!prov || !instance || !address) return ERROR_INVALID_PARAMETER;
@@ -375,7 +410,7 @@
 {
     PERF_PROVIDER_CONTEXT ctx;
 
-    FIXME( "guid %s, callback %p, provider %p semi-stub.\n", debugstr_guid(guid), callback, provider );
+    TRACE( "guid %s, callback %p, provider %p.\n", debugstr_guid(guid), callback, provider );
 
     memset( &ctx, 0, sizeof(ctx) );
     ctx.ContextSize = sizeof(ctx);
@@ -391,18 +426,22 @@
 {
     struct perf_provider *prov;
 
-    FIXME( "guid %s, context %p, provider %p semi-stub.\n", debugstr_guid(guid), context, provider );
+    TRACE( "guid %s, context %p, provider %p.\n", debugstr_guid(guid), context, provider );
 
     if (!guid || !context || !provider) return ERROR_INVALID_PARAMETER;
     if (context->ContextSize < sizeof(*context)) return ERROR_INVALID_PARAMETER;
-
-    if (context->MemAllocRoutine || context->MemFreeRoutine)
-        FIXME("Memory allocation routine is not supported.\n");
+    /* one routine without the other is not a context PerfStartProvider's
+     * zeroed one can match, and a provider that means to free its own
+     * instances will hand its own pMemContext to both */
+    if (!!context->MemAllocRoutine != !!context->MemFreeRoutine) return ERROR_INVALID_PARAMETER;
 
     if (!(prov = heap_alloc_zero( sizeof(*prov) ))) return ERROR_OUTOFMEMORY;
     list_init( &prov->instance_list );
     memcpy( &prov->guid, guid, sizeof(prov->guid) );
     prov->callback = context->ControlCallback;
+    prov->mem_alloc = context->MemAllocRoutine;
+    prov->mem_free = context->MemFreeRoutine;
+    prov->mem_context = context->pMemContext;
     *provider = prov;
 
     return STATUS_SUCCESS;
@@ -425,7 +464,7 @@
     LIST_FOR_EACH_ENTRY_SAFE(inst, next, &prov->instance_list, struct counterset_instance, entry)
     {
         list_remove( &inst->entry );
-        heap_free( inst );
+        perf_instance_free( prov, inst );
     }
 
     for (i = 0; i < prov->counterset_count; ++i)
