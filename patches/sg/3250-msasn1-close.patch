From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 13:57:01 -0700
Subject: [PATCH] msasn1: ASN1_CloseEncoder/CloseDecoder release the object
 (3250)

ASN1_CloseEncoder and ASN1_CloseDecoder were stubs that leaked every
encoder and decoder. They now release the object (a NULL or foreign
object is ignored). The parent argument of ASN1_CreateEncoder/Decoder,
ASN1_Decode and the BER/PER helper exports have no published
documentation or test and stay as they are.

diff --git a/dlls/msasn1/main.c b/dlls/msasn1/main.c
index 480683c..1570dac 100644
--- a/dlls/msasn1/main.c
+++ b/dlls/msasn1/main.c
@@ -124,7 +124,13 @@ ASN1error_e WINAPI ASN1_CreateEncoder(ASN1module_t module, ASN1encoding_t *encod
 
 void WINAPI ASN1_CloseEncoder(ASN1encoding_t encoder)
 {
-    FIXME("(%p): Stub!\n", encoder);
+    TRACE("(%p)\n", encoder);
+
+    if (!encoder || encoder->magic != 0x44434e45) return;
+    encoder->magic = 0;
+#ifndef SG_MUTANT_ASN1_ENCLEAK
+    free(encoder);
+#endif
 }
 
 ASN1error_e WINAPI ASN1_CreateDecoder(ASN1module_t module, ASN1decoding_t *decoder, ASN1octet_t *buf,
@@ -172,7 +178,13 @@ ASN1error_e WINAPI ASN1_CreateDecoder(ASN1module_t module, ASN1decoding_t *decod
 
 void WINAPI ASN1_CloseDecoder(ASN1decoding_t decoder)
 {
-    FIXME("(%p): Stub!\n", decoder);
+    TRACE("(%p)\n", decoder);
+
+    if (!decoder || decoder->magic != 0x44434544) return;
+    decoder->magic = 0;
+#ifndef SG_MUTANT_ASN1_DECLEAK
+    free(decoder);
+#endif
 }
 
 ASN1error_e WINAPI ASN1_Decode(ASN1decoding_t decoder, void **outdata, ASN1uint32_t pdunum,
