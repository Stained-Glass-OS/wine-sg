+static UINT create_folder_cache_table( MSIDATABASE *db )
+{
+    static const WCHAR create[] = L"CREATE TABLE `#_FolderCache` ( `Directory` CHAR(72) NOT NULL TEMPORARY, "
+                                  L"`Path` CHAR(255) NOT NULL TEMPORARY PRIMARY KEY `Directory`) HOLD";
+    static const WCHAR insert[] = L"INSERT INTO `#_FolderCache` ( `Directory`, `Path` ) "
+                                  L"VALUES ( 'TARGETDIR', 'SourceDir' ) TEMPORARY";
+    MSIQUERY *view;
+    UINT r;
+
+    if ((r = MSI_DatabaseOpenViewW( db, create, &view ))) return r;
+    r = MSI_ViewExecute( view, 0 );
+    MSI_ViewClose( view );
+    msiobj_release( &view->hdr );
+    if (r) return r;
+
+    if ((r = MSI_DatabaseOpenViewW( db, insert, &view ))) return r;
+    r = MSI_ViewExecute( view, 0 );
+    MSI_ViewClose( view );
+    msiobj_release( &view->hdr );
+    return r;
+}
+
+/* MsiOpenPackage("") : a package over an empty scratch database, which has no persistent tables,
+ * no summary information and no _Streams or _Storages tables. */
+static UINT open_empty_package( MSIPACKAGE **ret )
+{
+    WCHAR dir[MAX_PATH], path[MAX_PATH];
+    MSIDATABASE *db;
+    MSIPACKAGE *package;
+    UINT r;
+
+    if (!GetTempPathW( ARRAY_SIZE(dir), dir ) || !GetTempFileNameW( dir, L"msi", 0, path ))
+        return ERROR_FUNCTION_FAILED;
+
+    r = MSI_OpenDatabaseW( path, MSIDBOPEN_CREATEDIRECT, &db );
+    if (r != ERROR_SUCCESS)
+    {
+        DeleteFileW( path );
+        return r;
+    }
+    db->empty = TRUE;
+    if (!(package = MSI_CreatePackage( db )))
+    {
+        msiobj_release( &db->hdr );
+        return ERROR_INSTALL_PACKAGE_INVALID;
+    }
+    msiobj_release( &db->hdr );
+    package->localfile = wcsdup( L"" );
+    package->log_file = INVALID_HANDLE_VALUE;
+#ifndef SG_MUTANT_MSI_EMPTYCACHE
+    create_folder_cache_table( package->db );
+#endif
+    *ret = package;
+    return ERROR_SUCCESS;
+}
+
 UINT MSI_OpenPackageW(LPCWSTR szPackage, DWORD dwOptions, MSIPACKAGE **pPackage)
 {
     MSIDATABASE *db;
@@ -1396,6 +1452,8 @@ UINT MSI_OpenPackageW(LPCWSTR szPackage, DWORD dwOptions, MSIPACKAGE **pPackage)
 
