From: Stained Glass OS <dev@stained-glass.example>
Subject: kernelbase: GetProcessGroupAffinity says a process is in group 0

GetProcessGroupAffinity was a stub failing with ERROR_CALL_NOT_IMPLEMENTED;
every Java 21 (HotSpot) start printed "Attempt to get process group affinity
failed: Call not implemented" four times. There is one processor group:
every process is in group 0 (and a too-small array gets
ERROR_INSUFFICIENT_BUFFER with the count needed).

Gate: test/appfix-gate.sh.
---
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -927,9 +927,28 @@
  */
 BOOL WINAPI DECLSPEC_HOTPATCH GetProcessGroupAffinity( HANDLE process, USHORT *count, USHORT *array )
 {
-    FIXME( "(%p,%p,%p): stub\n", process, count, array );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    PROCESS_BASIC_INFORMATION info;
+
+    TRACE( "(%p,%p,%p)\n", process, count, array );
+
+    if (!count)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!set_ntstatus( NtQueryInformationProcess( process, ProcessBasicInformation, &info, sizeof(info), NULL ) ))
+        return FALSE;
+    /* one processor group, group 0: every process is in it (Java asks, and
+     * warns on every start when it cannot tell) */
+    if (*count < 1 || !array)
+    {
+        *count = 1;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    *count = 1;
+    array[0] = 0;
+    return TRUE;
 }
 
 
