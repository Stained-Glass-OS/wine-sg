From: Stained Glass OS <dev@stained-glass.example>
Subject: kernelbase: dynamic time zone conversions; a year before a zone's table

SystemTimeToTzSpecificLocalTimeEx and TzSpecificLocalTimeToSystemTimeEx
were stubs, and SetDynamicTimeZoneInformation was not exported (a program
importing it did not start). The conversions now use the rules the zone
had in the year of the date -- its key's "Dynamic DST" table, through
GetTimeZoneInformationForYear -- the local year's rules near New Year; a
zone without a key name, or with dynamic rules disabled and no key, uses
the rules it carries; no zone means the current one.
SetDynamicTimeZoneInformation behaves as SetTimeZoneInformation (the
machine's zone is the host's).

GetTimeZoneInformationForYear fell back to today's rules (TZI) for a year
before a zone's table; as on Windows, the table's first year's rules apply
before it and its last year's after it.

Gate: test/tzex-gate.sh. kernel32:time and kernel32:locale unchanged.
---
--- a/dlls/kernelbase/locale.c
+++ b/dlls/kernelbase/locale.c
@@ -6386,6 +6386,16 @@
         !RegOpenKeyExW( key, L"Dynamic DST", 0, KEY_ALL_ACCESS, &dst_key ))
     {
         WCHAR yearW[16];
+        DWORD first, last, type;
+
+        /* before the table's first year its first rules apply, after its
+         * last year its last ones */
+        count = sizeof(first);
+        if (!RegQueryValueExW( dst_key, L"FirstEntry", NULL, &type, (BYTE *)&first, &count ) &&
+            type == REG_DWORD && year < first) year = first;
+        count = sizeof(last);
+        if (!RegQueryValueExW( dst_key, L"LastEntry", NULL, &type, (BYTE *)&last, &count ) &&
+            type == REG_DWORD && year > last) year = last;
         swprintf( yearW, ARRAY_SIZE(yearW), L"%u", year );
         count = sizeof(data);
         ret = RegQueryValueExW( dst_key, yearW, NULL, NULL, (BYTE *)&data, &count );
@@ -7280,6 +7290,17 @@
 }
 
 
+/***********************************************************************
+ *	SetDynamicTimeZoneInformation   (kernelbase.@)
+ *
+ * The machine's time zone is the host's, as for SetTimeZoneInformation.
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH SetDynamicTimeZoneInformation( const DYNAMIC_TIME_ZONE_INFORMATION *info )
+{
+    return SetTimeZoneInformation( (const TIME_ZONE_INFORMATION *)info );
+}
+
+
 /******************************************************************************
  *	SetUserGeoID   (kernelbase.@)
  */
@@ -7381,6 +7402,77 @@
 }
 
 
+/* the rules a dynamic time zone had in a year (its registry key's "Dynamic
+ * DST"); a zone without a key name, or with dynamic rules disabled and no
+ * key, has only the rules it carries itself */
+static BOOL get_tz_rules_for_year( const DYNAMIC_TIME_ZONE_INFORMATION *dynamic, USHORT year,
+                                   TIME_ZONE_INFORMATION *info )
+{
+    DYNAMIC_TIME_ZONE_INFORMATION local_info;
+
+    if (!dynamic)
+    {
+        if (GetDynamicTimeZoneInformation( &local_info ) == TIME_ZONE_ID_INVALID) return FALSE;
+        dynamic = &local_info;
+    }
+    if (dynamic->TimeZoneKeyName[0] && GetTimeZoneInformationForYear( year, (DYNAMIC_TIME_ZONE_INFORMATION *)dynamic, info ))
+        return TRUE;
+    if (dynamic->TimeZoneKeyName[0] && !dynamic->DynamicDaylightTimeDisabled) return FALSE;
+    memcpy( info, dynamic, sizeof(*info) );
+    return TRUE;
+}
+
+
+/***********************************************************************
+ *	SystemTimeToTzSpecificLocalTimeEx   (kernelbase.@)
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH SystemTimeToTzSpecificLocalTimeEx( const DYNAMIC_TIME_ZONE_INFORMATION *dynamic,
+                                                                 const SYSTEMTIME *system,
+                                                                 SYSTEMTIME *local )
+{
+    TIME_ZONE_INFORMATION info;
+
+    TRACE( "(%p,%p,%p)\n", dynamic, system, local );
+
+    if (!system || !local)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* the rules of the year it is there: near New Year the local year
+     * is not the UTC one */
+    if (!get_tz_rules_for_year( dynamic, system->wYear, &info )) return FALSE;
+    if (!SystemTimeToTzSpecificLocalTime( &info, system, local )) return FALSE;
+    if (local->wYear != system->wYear)
+    {
+        if (!get_tz_rules_for_year( dynamic, local->wYear, &info )) return FALSE;
+        if (!SystemTimeToTzSpecificLocalTime( &info, system, local )) return FALSE;
+    }
+    return TRUE;
+}
+
+
+/***********************************************************************
+ *	TzSpecificLocalTimeToSystemTimeEx   (kernelbase.@)
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH TzSpecificLocalTimeToSystemTimeEx( const DYNAMIC_TIME_ZONE_INFORMATION *dynamic,
+                                                                 const SYSTEMTIME *local,
+                                                                 SYSTEMTIME *system )
+{
+    TIME_ZONE_INFORMATION info;
+
+    TRACE( "(%p,%p,%p)\n", dynamic, local, system );
+
+    if (!local || !system)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!get_tz_rules_for_year( dynamic, local->wYear, &info )) return FALSE;
+    return TzSpecificLocalTimeToSystemTime( &info, local, system );
+}
+
+
