--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -790,6 +790,15 @@
 static WNDPROC desktop_orig_wndproc;
 
 /* window procedure for the desktop window */
+#define SG_WALLPAPER_REPAINT 0x5750
+
+static BOOL CALLBACK repaint_window( HWND hwnd, LPARAM lparam )
+{
+    if (IsWindowVisible( hwnd ))
+        RedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+    return TRUE;
+}
+
 static LRESULT WINAPI desktop_wnd_proc( HWND hwnd, UINT message, WPARAM wp, LPARAM lp )
 {
     TRACE( "got msg %04x wp %Ix lp %Ix\n", message, wp, lp );
@@ -821,9 +830,24 @@
 
     case WM_SETTINGCHANGE:
         if (wp == SPI_SETDESKWALLPAPER)
+        {
             SystemParametersInfoW( SPI_SETDESKWALLPAPER, 0, NULL, FALSE );
+            /* Stained Glass OS: the new picture is copied to the screen over
+             * the windows (a surface is flushed with IncludeInferiors), so
+             * once it is up, every window paints itself back on top */
+            SetTimer( hwnd, SG_WALLPAPER_REPAINT, 250, NULL );
+        }
         return 0;
 
+    case WM_TIMER:
+        if (wp == SG_WALLPAPER_REPAINT)
+        {
+            KillTimer( hwnd, SG_WALLPAPER_REPAINT );
+            EnumWindows( repaint_window, 0 );
+            return 0;
+        }
+        break;
+
     case WM_PARENTNOTIFY:
         handle_parent_notify( (HWND)lp, wp );
         return 0;
