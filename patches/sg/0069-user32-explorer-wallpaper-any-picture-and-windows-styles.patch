-        hbitmap = LoadImageW( 0, buffer, IMAGE_BITMAP, 0, 0, LR_CREATEDIBSECTION | LR_LOADFROMFILE );
+        hbitmap = load_picture( buffer );
     }
     return hbitmap;
 }
