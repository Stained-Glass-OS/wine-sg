From: Stained Glass OS <dev@stained-glass.example>
Subject: user32, explorer: wallpaper in any picture format, Windows' styles

The desktop showed only a .bmp, centred or tiled: a JPEG or PNG -- what
wallpapers are, and what the Control Panel offers -- showed nothing, and
Fill, Fit, Stretch and Span were ignored. And setting a wallpaper with
windows open painted the picture over them and the taskbar.

- user32: the wallpaper is read with Windows Imaging Components (JPEG, PNG,
  BMP, GIF, TIFF...), loaded on demand from windowscodecs in the desktop's
  process only, with COM initialised for WIC's decoders. WallpaperStyle is
  honoured -- 10 Fill (cover, cropped), 6 Fit (letterboxed), 2 Stretch,
  22 Span, 0 Center, or Tile with TileWallpaper -- by laying the picture out
  once for the desktop's size (HALFTONE), so repainting is a plain copy.
- explorer: a desktop surface is copied to the screen with
  IncludeInferiors, over the windows on it; after a wallpaper change the
  desktop asks every visible window to repaint once the picture is up.

Gate: test/wallpaper-gate.sh -- PNG and JPEG in every style, on the X
server's pixels, and a window and the taskbar intact after a change (a
build without the repaint fails those two).
---
--- a/dlls/user32/desktop.c
+++ b/dlls/user32/desktop.c
@@ -22,16 +22,143 @@
 #include <stdio.h>
 #include <string.h>
 
+#define COBJMACROS
 #include "windef.h"
 #include "winbase.h"
 #include "wingdi.h"
 #include "winnls.h"
+#include "objbase.h"
+#include "wincodec.h"
 #include "controls.h"
 
 static HBRUSH hbrushPattern;
 static HBITMAP hbitmapWallPaper;
 static SIZE bitmapSize;
 static BOOL fTileWallPaper;
+static int wallpaper_style;          /* WallpaperStyle: 0 center/tile, 2 stretch, 6 fit, 10 fill, 22 span */
+static HBITMAP scaled_wallpaper;     /* the wallpaper laid out for the desktop at scaled_size */
+static SIZE scaled_size;
+
+/* Any picture Windows Imaging Components can read (JPEG, PNG, BMP, GIF,
+ * TIFF...), as a 32 bpp top-down DIB section. Only the desktop's process
+ * loads windowscodecs, and only when there is a wallpaper. */
+static HBITMAP load_picture( const WCHAR *filename )
+{
+    /* GUID_WICPixelFormat32bppBGR */
+    static const GUID bgr32 = {0x6fddc324,0x4e03,0x4bfe,{0xb1,0x85,0x3d,0x77,0x76,0x8d,0xc9,0x0e}};
+    HRESULT (WINAPI *create_factory)( UINT, IWICImagingFactory ** );
+    HRESULT (WINAPI *convert)( REFWICPixelFormatGUID, IWICBitmapSource *, IWICBitmapSource ** );
+    IWICImagingFactory *factory = NULL;
+    IWICBitmapDecoder *decoder = NULL;
+    IWICBitmapFrameDecode *frame = NULL;
+    IWICBitmapSource *source = NULL;
+    BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER) }};
+    HBITMAP bitmap = 0;
+    HMODULE codecs;
+    UINT width, height;
+    HRESULT com;
+    void *bits;
+
+    if (!(codecs = LoadLibraryW( L"windowscodecs.dll" ))) return 0;
+    if (!(create_factory = (void *)GetProcAddress( codecs, "WICCreateImagingFactory_Proxy" ))) return 0;
+    if (!(convert = (void *)GetProcAddress( codecs, "WICConvertBitmapSource" ))) return 0;
+    /* WIC finds its decoders through COM; the desktop's thread may not have it */
+    com = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    if (FAILED(create_factory( WINCODEC_SDK_VERSION, &factory )))
+    {
+        if (SUCCEEDED(com)) CoUninitialize();
+        return 0;
+    }
+    if (SUCCEEDED(IWICImagingFactory_CreateDecoderFromFilename( factory, filename, NULL, GENERIC_READ,
+                                                                WICDecodeMetadataCacheOnDemand, &decoder )) &&
+        SUCCEEDED(IWICBitmapDecoder_GetFrame( decoder, 0, &frame )) &&
+        SUCCEEDED(convert( &bgr32, (IWICBitmapSource *)frame, &source )) &&
+        SUCCEEDED(IWICBitmapSource_GetSize( source, &width, &height )) && width && height &&
+        width <= 16384 && height <= 16384)
+    {
+        info.bmiHeader.biWidth = width;
+        info.bmiHeader.biHeight = -(int)height;
+        info.bmiHeader.biPlanes = 1;
+        info.bmiHeader.biBitCount = 32;
+        info.bmiHeader.biCompression = BI_RGB;
+        if ((bitmap = CreateDIBSection( 0, &info, DIB_RGB_COLORS, &bits, NULL, 0 )) &&
+            FAILED(IWICBitmapSource_CopyPixels( source, NULL, width * 4, width * height * 4, bits )))
+        {
+            DeleteObject( bitmap );
+            bitmap = 0;
+        }
+    }
+    if (source) IWICBitmapSource_Release( source );
+    if (frame) IWICBitmapFrameDecode_Release( frame );
+    if (decoder) IWICBitmapDecoder_Release( decoder );
+    IWICImagingFactory_Release( factory );
+    if (SUCCEEDED(com)) CoUninitialize();
+    return bitmap;
+}
+
+/* Lay the wallpaper out for a desktop of this size, once: the desktop is
+ * repainted often, and stretching a large picture each time is slow. */
+static HBITMAP layout_wallpaper( HDC hdc, const RECT *rect )
+{
+    int w = rect->right - rect->left, h = rect->bottom - rect->top, x, y, dw, dh;
+    HDC src, dst;
+    HBITMAP bitmap;
+    HBRUSH background;
+    RECT all;
+
+    if (scaled_wallpaper && scaled_size.cx == w && scaled_size.cy == h) return scaled_wallpaper;
+    if (scaled_wallpaper) DeleteObject( scaled_wallpaper );
+    scaled_wallpaper = 0;
+    if (!hbitmapWallPaper || w <= 0 || h <= 0) return 0;
+    if (!(bitmap = CreateCompatibleBitmap( hdc, w, h ))) return 0;
+
+    src = CreateCompatibleDC( hdc );
+    dst = CreateCompatibleDC( hdc );
+    SelectObject( src, hbitmapWallPaper );
+    SelectObject( dst, bitmap );
+    SetRect( &all, 0, 0, w, h );
+    background = CreateSolidBrush( GetSysColor( COLOR_BACKGROUND ));
+    FillRect( dst, &all, background );
+    DeleteObject( background );
+    SetStretchBltMode( dst, HALFTONE );
+    SetBrushOrgEx( dst, 0, 0, NULL );
+
+    switch (wallpaper_style)
+    {
+    case 2:   /* stretch */
+    case 22:  /* span: one picture across the whole desktop */
+        StretchBlt( dst, 0, 0, w, h, src, 0, 0, bitmapSize.cx, bitmapSize.cy, SRCCOPY );
+        break;
+    case 6:   /* fit: all of it, letterboxed */
+    case 10:  /* fill: cover the desktop, cropped */
+        if ((wallpaper_style == 10) == ((double)w / h > (double)bitmapSize.cx / bitmapSize.cy))
+        {
+            dw = w; dh = MulDiv( bitmapSize.cy, w, bitmapSize.cx );
+        }
+        else
+        {
+            dh = h; dw = MulDiv( bitmapSize.cx, h, bitmapSize.cy );
+        }
+        StretchBlt( dst, (w - dw) / 2, (h - dh) / 2, dw, dh, src, 0, 0, bitmapSize.cx, bitmapSize.cy, SRCCOPY );
+        break;
+    default:
+        if (fTileWallPaper)
+        {
+            for (y = 0; y < h; y += bitmapSize.cy)
+                for (x = 0; x < w; x += bitmapSize.cx)
+                    BitBlt( dst, x, y, bitmapSize.cx, bitmapSize.cy, src, 0, 0, SRCCOPY );
+        }
+        else BitBlt( dst, (w - bitmapSize.cx) / 2, (h - bitmapSize.cy) / 2,
+                     bitmapSize.cx, bitmapSize.cy, src, 0, 0, SRCCOPY );
+        break;
+    }
+    DeleteDC( src );
+    DeleteDC( dst );
+    scaled_wallpaper = bitmap;
+    scaled_size.cx = w;
+    scaled_size.cy = h;
+    return bitmap;
+}
 
 
