From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: RtlGetFullPathName_UEx.

RtlGetFullPathName_U with an NTSTATUS: the byte count goes to an out parameter
(the bytes written without the NUL, or the bytes needed with it when the buffer is
too small, still STATUS_SUCCESS), and a name with no full path is
STATUS_OBJECT_NAME_INVALID. System Informer's setup (phlib PhGetFullPath) ended at
once with "unimplemented function ntdll.dll.RtlGetFullPathName_UEx".
---
diff --git a/dlls/ntdll/ntdll.spec b/dlls/ntdll/ntdll.spec
index e71c57a..a465e55 100644
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -766,6 +766,7 @@
 # @ stub RtlGetFirstRange
 @ stdcall RtlGetFrame()
 @ stdcall RtlGetFullPathName_U(wstr long ptr ptr)
+@ stdcall RtlGetFullPathName_UEx(wstr long ptr ptr ptr)
 @ stdcall RtlGetGroupSecurityDescriptor(ptr ptr ptr)
 @ stdcall RtlGetLastNtStatus()
 @ stdcall RtlGetLastWin32Error()
diff --git a/dlls/ntdll/path.c b/dlls/ntdll/path.c
index 7befa4b..0d837b9 100644
--- a/dlls/ntdll/path.c
+++ b/dlls/ntdll/path.c
@@ -708,6 +708,31 @@ done:
     return reqsize;
 }
 
+/******************************************************************
+ *		RtlGetFullPathName_UEx  (NTDLL.@)
+ *
+ * RtlGetFullPathName_U with a status: the byte count goes to bytes_required
+ * (as RtlGetFullPathName_U returns it: the bytes written without the NUL, or
+ * the bytes needed with it when the buffer is too small, which is still
+ * STATUS_SUCCESS), and a name that has no full path is
+ * STATUS_OBJECT_NAME_INVALID. System Informer's PhGetFullPath calls it.
+ */
+NTSTATUS WINAPI RtlGetFullPathName_UEx( const WCHAR *name, ULONG size, WCHAR *buffer,
+                                        WCHAR **file_part, ULONG *bytes_required )
+{
+    ULONG len;
+
+    TRACE( "(%s %lu %p %p %p)\n", debugstr_w(name), size, buffer, file_part, bytes_required );
+
+    if (bytes_required) *bytes_required = 0;
+    len = RtlGetFullPathName_U( name, size, buffer, file_part );
+    if (!len) return STATUS_OBJECT_NAME_INVALID;
+#ifndef SG_MUTANT_FULLPATH_UEX_NO_BYTES
+    if (bytes_required) *bytes_required = len;
+#endif
+    return STATUS_SUCCESS;
+}
+
 /******************************************************************
  *		RtlGetFullPathName_U  (NTDLL.@)
  *
diff --git a/include/winternl.h b/include/winternl.h
index 85f57ed..037efae 100644
--- a/include/winternl.h
+++ b/include/winternl.h
@@ -5084,6 +5084,7 @@ NTSYSAPI NTSTATUS  WINAPI RtlGetExtendedContextLength2(ULONG,ULONG*,ULONG64);
 NTSYSAPI ULONG64   WINAPI RtlGetExtendedFeaturesMask(CONTEXT_EX*);
 NTSYSAPI TEB_ACTIVE_FRAME * WINAPI RtlGetFrame(void);
 NTSYSAPI ULONG     WINAPI RtlGetFullPathName_U(PCWSTR,ULONG,PWSTR,PWSTR*);
+NTSYSAPI NTSTATUS  WINAPI RtlGetFullPathName_UEx(PCWSTR,ULONG,PWSTR,PWSTR*,ULONG*);
 NTSYSAPI NTSTATUS  WINAPI RtlGetGroupSecurityDescriptor(PSECURITY_DESCRIPTOR,PSID *,PBOOLEAN);
 NTSYSAPI NTSTATUS  WINAPI RtlGetLastNtStatus(void);
 NTSYSAPI DWORD     WINAPI RtlGetLastWin32Error(void);
