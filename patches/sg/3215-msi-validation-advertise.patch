+                FAILED( IStream_Read( b, bufb, sizeof(bufb), &nb ) )) break;
+            if (na != nb || memcmp( bufa, bufb, na )) break;
+            if (!na) { ret = TRUE; break; }
+        }
+        IStream_Seek( b, pos, STREAM_SEEK_SET, NULL );
+    }
+    IStream_Release( a );
+    return ret;
+}
