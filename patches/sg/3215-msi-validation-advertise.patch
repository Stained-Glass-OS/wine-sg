+    pos.QuadPart = 0;
+    if (SUCCEEDED( IStream_Seek( a, pos, STREAM_SEEK_SET, NULL ) ) &&
+        SUCCEEDED( IStream_Seek( b, pos, STREAM_SEEK_SET, NULL ) ))
+    {
+        for (;;)
