+/* Looks up a published assembly (see MsiPublishAssemblies): fills the product code and the
+ * component id of the component that holds it. */
+UINT msi_find_published_assembly( const WCHAR *name, const WCHAR *app_context, BOOL win32, BOOL *found_user,
+                                  WCHAR *product, WCHAR *component )
+{
+    static const UINT contexts[] = { MSIINSTALLCONTEXT_USERUNMANAGED, MSIINSTALLCONTEXT_MACHINE };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(contexts); i++)
+    {
+        WCHAR buffer[64] = {0};
+        DWORD size = sizeof(buffer) - sizeof(WCHAR), type;
+        GUID guid;
+        HKEY hkey;
+        LONG res;
+
+        if (app_context) res = open_local_assembly_key( contexts[i], win32, app_context, &hkey );
+        else res = open_global_assembly_key( contexts[i], win32, &hkey );
+        if (res) continue;
+        res = RegQueryValueExW( hkey, name, NULL, &type, (BYTE *)buffer, &size );
+        RegCloseKey( hkey );
+        if (res || type != REG_MULTI_SZ || lstrlenW( buffer ) < 42 || buffer[20] != '>') continue;
+
+        if (!decode_base85_guid( buffer, &guid )) return ERROR_BAD_CONFIGURATION;
+        StringFromGUID2( &guid, product, 39 );
+        if (!decode_base85_guid( buffer + 21, &guid )) return ERROR_BAD_CONFIGURATION;
+        StringFromGUID2( &guid, component, 39 );
+        if (found_user) *found_user = contexts[i] == MSIINSTALLCONTEXT_USERUNMANAGED;
+        return ERROR_SUCCESS;
+    }
+    return ERROR_UNKNOWN_COMPONENT;
+}
