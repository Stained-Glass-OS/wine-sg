+static BOOL streams_identical(IStream *a, IStream *b)
+{
+    BYTE bufa[512], bufb[512];
+    ULONG na, nb;
+
+    for (;;)
+    {
+        na = nb = 0;
+        if (FAILED(IStream_Read(a, bufa, sizeof(bufa), &na)) || FAILED(IStream_Read(b, bufb, sizeof(bufb), &nb)))
+            return FALSE;
+        if (na != nb || memcmp(bufa, bufb, na)) return FALSE;
+        if (!na) return TRUE;
+    }
+}
+
+/* same elements with the same names, types and stream contents */
+static BOOL storages_identical(IStorage *a, IStorage *b)
+{
+    IEnumSTATSTG *en;
+    STATSTG stat;
+    ULONG n;
+    UINT count_a = 0, count_b = 0;
+    BOOL ret = TRUE;
+
+    if (FAILED(IStorage_EnumElements(a, 0, NULL, 0, &en))) return FALSE;
+    while (ret && IEnumSTATSTG_Next(en, 1, &stat, &n) == S_OK && n)
+    {
+        count_a++;
+        if (stat.type == STGTY_STREAM)
+        {
+            IStream *sa, *sb;
+            if (FAILED(IStorage_OpenStream(a, stat.pwcsName, NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, 0, &sa))) ret = FALSE;
+            else if (FAILED(IStorage_OpenStream(b, stat.pwcsName, NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, 0, &sb)))
+            {
+                ret = FALSE;
+                IStream_Release(sa);
+            }
+            else
+            {
+                ret = streams_identical(sa, sb);
+                IStream_Release(sa);
+                IStream_Release(sb);
+            }
+        }
+        else if (stat.type == STGTY_STORAGE)
+        {
+            IStorage *sa, *sb;
+            if (FAILED(IStorage_OpenStorage(a, stat.pwcsName, NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, NULL, 0, &sa))) ret = FALSE;
+            else if (FAILED(IStorage_OpenStorage(b, stat.pwcsName, NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, NULL, 0, &sb)))
+            {
+                ret = FALSE;
+                IStorage_Release(sa);
+            }
+            else
+            {
+                ret = storages_identical(sa, sb);
+                IStorage_Release(sa);
+                IStorage_Release(sb);
+            }
+        }
+        else ret = FALSE;
+        CoTaskMemFree(stat.pwcsName);
+    }
+    IEnumSTATSTG_Release(en);
+    if (!ret) return FALSE;
+
+    if (FAILED(IStorage_EnumElements(b, 0, NULL, 0, &en))) return FALSE;
+    while (IEnumSTATSTG_Next(en, 1, &stat, &n) == S_OK && n)
+    {
+        count_b++;
+        CoTaskMemFree(stat.pwcsName);
+    }
+    IEnumSTATSTG_Release(en);
+    return count_a == count_b;
+}
+
+/* does the storage in the record hold the same data as the one in the row? */
+static BOOL storages_row_matches(struct storages_view *sv, UINT row, MSIRECORD *rec)
+{
+    IStream *stm;
+    IStorage *stg;
+    BOOL ret = FALSE;
+
+    if (!sv->storages[row].storage) return FALSE;
+    if (MSI_RecordGetIStream(rec, 2, &stm)) return FALSE;
+    if (SUCCEEDED(stream_to_storage(stm, &stg)))
+    {
+        ret = storages_identical(stg, sv->storages[row].storage);
+        IStorage_Release(stg);
+    }
+    IStream_Release(stm);
+    return ret;
+}
