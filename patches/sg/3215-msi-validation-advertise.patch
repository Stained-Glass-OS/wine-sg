+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <wctype.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "msi.h"
+#include "msiquery.h"
+#include "msipriv.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msidb);
+
+/* columns of the _Validation table */
+#define VAL_TABLE     1
+#define VAL_COLUMN    2
+#define VAL_NULLABLE  3
+#define VAL_MINVALUE  4
+#define VAL_MAXVALUE  5
+#define VAL_KEYTABLE  6
+#define VAL_KEYCOLUMN 7
+#define VAL_CATEGORY  8
+#define VAL_SET       9
+
+/* ---- the error list kept on a view ---- */
+
+void msi_view_clear_errors( MSIVIEW *view )
+{
+    free( view->errors );
+    view->errors = NULL;
+    view->error_count = view->error_pos = 0;
+    view->error = MSIDBERROR_NOERROR;
+    view->error_column = NULL;
+}
+
+/* takes ownership of errors */
+void msi_view_set_errors( MSIVIEW *view, struct msi_verror *errors, UINT count )
+{
+    msi_view_clear_errors( view );
+    if (!count)
+    {
+        free( errors );
+        return;
+    }
+    view->errors = errors;
+    view->error_count = count;
+    view->error = errors[0].error;
+    view->error_column = errors[0].column;
+}
+
+/* the current error has been reported: the next one (if any) becomes current */
+void msi_view_next_error( MSIVIEW *view )
+{
+    if (!view->error) return;
+#ifdef SG_MUTANT_MSIB1_NEXT
+    return;
+#endif
+    if (view->error_pos + 1 < view->error_count)
+    {
+        view->error_pos++;
+        view->error = view->errors[view->error_pos].error;
+        view->error_column = view->errors[view->error_pos].column;
+    }
+    else msi_view_clear_errors( view );
+}
+
+void msi_view_move_errors( MSIVIEW *dst, MSIVIEW *src )
+{
+    msi_view_clear_errors( dst );
+    dst->errors = src->errors;
+    dst->error_count = src->error_count;
+    dst->error_pos = src->error_pos;
+    dst->error = src->error;
+    dst->error_column = src->error_column;
+    src->errors = NULL;
+    src->error_count = src->error_pos = 0;
+    src->error = MSIDBERROR_NOERROR;
+    src->error_column = NULL;
+}
+
+static BOOL add_error( struct msi_verror **errors, UINT *count, MSIDBERROR error, const WCHAR *column )
+{
+    struct msi_verror *new = realloc( *errors, (*count + 1) * sizeof(**errors) );
+    if (!new) return FALSE;
+    new[*count].error = error;
+    new[*count].column = column;
+    *errors = new;
+    (*count)++;
+    return TRUE;
+}
+
+/* ---- syntax checks for the column data types ---- */
+
+static BOOL is_identifier( const WCHAR *s, size_t len )
+{
+    size_t i;
+
+    if (!len || !((s[0] >= 'A' && s[0] <= 'Z') || (s[0] >= 'a' && s[0] <= 'z') || s[0] == '_')) return FALSE;
+    for (i = 1; i < len; i++)
+    {
+        if ((s[i] >= 'A' && s[i] <= 'Z') || (s[i] >= 'a' && s[i] <= 'z') ||
+            (s[i] >= '0' && s[i] <= '9') || s[i] == '_' || s[i] == '.') continue;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL is_property( const WCHAR *s )
+{
+    if (s[0] == '%') s++;
+    return is_identifier( s, wcslen( s ) );
+}
+
+/* one part of a (short|long) file name */
+static BOOL is_file_part( const WCHAR *s, size_t len, BOOL is_short, BOOL wildcard )
+{
+    static const WCHAR bad_all[] = L"/\\|><:\"";
+    static const WCHAR bad_wild[] = L"?*";
+    static const WCHAR bad_short[] = L"+,;=[] ";
+    size_t i, dot = len;
+    BOOL seen_dot = FALSE;
+
+    if (!len) return FALSE;
+    if (len == 1 && s[0] == '.') return TRUE;
+    for (i = 0; i < len; i++)
+    {
+        if (wcschr( bad_all, s[i] )) return FALSE;
+        if (!wildcard && wcschr( bad_wild, s[i] )) return FALSE;
+        if (is_short && wcschr( bad_short, s[i] )) return FALSE;
+        if (s[i] == '.' && is_short)
+        {
+            if (seen_dot) return FALSE;
+            seen_dot = TRUE;
+            dot = i;
+        }
+    }
+    if (is_short)
+    {
+        /* eight characters, a period and three characters */
+#ifndef SG_MUTANT_MSIB1_FNAME
+        if (dot > 8 || (seen_dot && len - dot - 1 > 3) || !dot) return FALSE;
+#endif
+        if (!seen_dot && len > 8) return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL is_filename( const WCHAR *s, BOOL wildcard )
+{
+    const WCHAR *bar = wcschr( s, '|' );
+
+    if (!bar) return is_file_part( s, wcslen( s ), TRUE, wildcard );
+    if (wcschr( bar + 1, '|' )) return FALSE;
+    return is_file_part( s, bar - s, TRUE, wildcard ) &&
+           (bar[1] ? is_file_part( bar + 1, wcslen( bar + 1 ), FALSE, wildcard ) : FALSE);
+}
+
+static BOOL is_default_dir( const WCHAR *s )
+{
+    WCHAR *copy = wcsdup( s ), *colon;
+    BOOL ret;
+
+    if (is_identifier( s, wcslen( s ) )) { free( copy ); return TRUE; }
+    if (!copy) return FALSE;
+    if ((colon = wcschr( copy, ':' )))
+    {
+        *colon = 0;
+        ret = is_filename( copy, FALSE ) && is_filename( colon + 1, FALSE );
+    }
+    else ret = is_filename( copy, FALSE );
+    free( copy );
+    return ret;
+}
+
+static BOOL path_chars_ok( const WCHAR *s, size_t len )
+{
+    size_t i;
+    for (i = 0; i < len; i++) if (wcschr( L"?|><*\"", s[i] )) return FALSE;
+    return TRUE;
+}
+
+static BOOL is_path( const WCHAR *s )
+{
+    size_t len = wcslen( s );
+
+    if (!len) return FALSE;
+    if (s[0] == '[') return path_chars_ok( s, len );
+    if (len >= 2 && s[0] == '\\' && s[1] == '\\') return path_chars_ok( s, len );
+    if (len >= 2 && iswalpha( s[0] ) && s[1] == ':') return path_chars_ok( s + 2, len - 2 );
+    return FALSE;
+}
+
+static BOOL is_paths( const WCHAR *s )
+{
+    WCHAR *copy = wcsdup( s ), *p, *end;
+    BOOL ret = TRUE;
+
+    if (!copy) return FALSE;
+    for (p = copy; ret; p = end + 1)
+    {
+        end = wcschr( p, ';' );
+        if (end) *end = 0;
+        if (!is_path( p )) ret = FALSE;
+        if (!end) break;
+    }
+    free( copy );
+    return ret;
+}
+
+static BOOL is_anypath( const WCHAR *s )
+{
+    size_t len = wcslen( s );
+    const WCHAR *bar = wcschr( s, '|' );
+
+    if (!len) return FALSE;
+    if (bar)
+    {
+        /* short|long of a single level, no drives or directories */
+        if (wcschr( s, '\\' ) || wcschr( s, ':' ) || wcschr( s, '/' )) return FALSE;
+        return path_chars_ok( s, bar - s ) && path_chars_ok( bar + 1, wcslen( bar + 1 ) ) && bar[1] != 0;
+    }
+    return path_chars_ok( s, len );
+}
+
+static BOOL is_guid( const WCHAR *s )
+{
+    static const int dashes[] = { 9, 14, 19, 24 };
+    int i, d = 0;
+
+    if (wcslen( s ) != 38 || s[0] != '{' || s[37] != '}') return FALSE;
+    for (i = 1; i < 37; i++)
+    {
+        if (d < 4 && i == dashes[d]) { if (s[i] != '-') return FALSE; d++; continue; }
+#ifdef SG_MUTANT_MSIB1_GUID
+        if (s[i] >= 'a' && s[i] <= 'f') continue;
+#endif
+        if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'A' && s[i] <= 'F'))) return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL is_version( const WCHAR *s )
+{
+    int fields = 0;
+
+    for (;;)
+    {
+        unsigned long n = 0;
+        int digits = 0;
+
+        while (*s >= '0' && *s <= '9')
+        {
+            n = n * 10 + (*s - '0');
+            if (n > 65535) return FALSE;
+            digits++;
+            s++;
+        }
+        if (!digits) return FALSE;
+        fields++;
+        if (*s == '.') { s++; continue; }
+        return !*s && fields <= 4;
+    }
+}
+
+static BOOL is_language( const WCHAR *s )
+{
+    for (;;)
+    {
+        unsigned long n = 0;
+        int digits = 0;
+
+        while (*s >= '0' && *s <= '9')
+        {
+            n = n * 10 + (*s - '0');
+            if (n > 65535) return FALSE;
+            digits++;
+            s++;
+        }
+        if (!digits) return FALSE;
+        if (*s == ',') { s++; continue; }
+        return !*s;
+    }
+}
+
+static BOOL is_regpath( const WCHAR *s )
+{
+    size_t len = wcslen( s );
+    return len && s[0] != '\\' && s[len - 1] != '\\';
+}
+
+static BOOL is_cabinet( const WCHAR *s )
+{
+    if (s[0] == '#') return is_identifier( s + 1, wcslen( s + 1 ) );
+    return !wcschr( s, '|' ) && is_file_part( s, wcslen( s ), TRUE, FALSE );
+}
+
+/* ---- conditional statement syntax (Conditional Statement Syntax topic) ---- */
+
+struct cond_scan { const WCHAR *p; };
+
+static void cond_skip( struct cond_scan *c ) { while (*c->p == ' ' || *c->p == '\t' || *c->p == '\n' || *c->p == '\r') c->p++; }
+
+static BOOL cond_word( struct cond_scan *c, const WCHAR *word )
+{
+    size_t len = wcslen( word );
+    cond_skip( c );
+    if (wcsnicmp( c->p, word, len )) return FALSE;
+    if (iswalnum( c->p[len] ) || c->p[len] == '_' || c->p[len] == '.') return FALSE;
+    c->p += len;
+    return TRUE;
+}
+
+static BOOL cond_expr( struct cond_scan *c, int depth );
+
+static BOOL cond_operand( struct cond_scan *c )
+{
+    const WCHAR *start;
+
+    cond_skip( c );
+    if (*c->p == '"')
+    {
+        const WCHAR *end = wcschr( c->p + 1, '"' );
+        if (!end) return FALSE;
+        c->p = end + 1;
+        return TRUE;
+    }
+    if (*c->p == '-' || (*c->p >= '0' && *c->p <= '9'))
+    {
+        if (*c->p == '-') c->p++;
+        if (!(*c->p >= '0' && *c->p <= '9')) return FALSE;
+        while (*c->p >= '0' && *c->p <= '9') c->p++;
+        return TRUE;
+    }
+    if (*c->p == '$' || *c->p == '?' || *c->p == '&' || *c->p == '!' || *c->p == '%' || *c->p == '#') c->p++;
+    start = c->p;
+    while (iswalnum( *c->p ) || *c->p == '_' || *c->p == '.') c->p++;
+    return c->p != start;
+}
+
+static BOOL cond_compare_op( struct cond_scan *c )
+{
+    static const WCHAR *ops[] = { L"<>", L"<=", L">=", L"><", L"<<", L">>", L"=", L"<", L">" };
+    unsigned int i;
+
+    cond_skip( c );
+    if (*c->p == '~') c->p++;
+    for (i = 0; i < ARRAY_SIZE(ops); i++)
+    {
+        size_t len = wcslen( ops[i] );
+        if (!wcsncmp( c->p, ops[i], len )) { c->p += len; return TRUE; }
+    }
+    return FALSE;
+}
+
+static BOOL cond_primary( struct cond_scan *c, int depth )
+{
+    cond_skip( c );
+    if (cond_word( c, L"NOT" )) return cond_primary( c, depth );
+    if (*c->p == '(')
+    {
+        if (depth > 64) return FALSE;
+        c->p++;
+        if (!cond_expr( c, depth + 1 )) return FALSE;
+        cond_skip( c );
+        if (*c->p != ')') return FALSE;
+        c->p++;
+        return TRUE;
+    }
+    if (!cond_operand( c )) return FALSE;
+    cond_skip( c );
+    if (*c->p == '=' || *c->p == '<' || *c->p == '>' || *c->p == '~')
+    {
+        if (!cond_compare_op( c )) return FALSE;
+        return cond_operand( c );
+    }
+    return TRUE;
+}
+
+static BOOL cond_expr( struct cond_scan *c, int depth )
+{
+    for (;;)
+    {
+        if (!cond_primary( c, depth )) return FALSE;
+        if (cond_word( c, L"AND" ) || cond_word( c, L"OR" ) || cond_word( c, L"XOR" ) ||
+            cond_word( c, L"EQV" ) || cond_word( c, L"IMP" )) continue;
+        return TRUE;
+    }
+}
+
+static BOOL is_condition( const WCHAR *s )
+{
+#ifdef SG_MUTANT_MSIB1_COND
+    return TRUE;
+#endif
+    struct cond_scan c = { s };
+
+    if (!cond_expr( &c, 0 )) return FALSE;
+    cond_skip( &c );
+    return !*c.p;
+}
+
+/* ---- links between tables ---- */
+
+/* returns TRUE if table.column (the n'th column) holds the value; sets *bad_table if the table cannot be used */
+static BOOL link_exists( MSIDATABASE *db, const WCHAR *table, UINT n, BOOL is_string, const WCHAR *sval,
+                         int ival, BOOL *bad_table )
+{
+    MSIQUERY *view = NULL, *q = NULL;
+    MSIRECORD *params, *row = NULL;
+    const WCHAR *name;
+    WCHAR *query;
+    BOOL ret = FALSE;
+    UINT type;
+    size_t len;
+
+    *bad_table = FALSE;
+    if (wcschr( table, '`' )) { *bad_table = TRUE; return FALSE; }
+    len = wcslen( table ) + 32;
+    if (!(query = malloc( len * sizeof(WCHAR) ))) return FALSE;
+    swprintf( query, len, L"SELECT * FROM `%s`", table );
+    if (MSI_DatabaseOpenViewW( db, query, &view ))
+    {
+        free( query );
+        *bad_table = TRUE;
+        return FALSE;
+    }
+    free( query );
+    if (view->view->ops->get_column_info( view->view, n, &name, &type, NULL, NULL ) || wcschr( name, '`' ))
+    {
+        msiobj_release( &view->hdr );
+        *bad_table = TRUE;
+        return FALSE;
+    }
+    msiobj_release( &view->hdr );
+
+    len = wcslen( table ) + wcslen( name ) + 40;
+    if (!(query = malloc( len * sizeof(WCHAR) ))) return FALSE;
+    swprintf( query, len, L"SELECT * FROM `%s` WHERE `%s` = ?", table, name );
+    if (MSI_DatabaseOpenViewW( db, query, &q ))
+    {
+        free( query );
+        return FALSE;
+    }
+    free( query );
+    if ((params = MSI_CreateRecord( 1 )))
+    {
+        if (is_string) MSI_RecordSetStringW( params, 1, sval );
+        else MSI_RecordSetInteger( params, 1, ival );
+        if (!MSI_ViewExecute( q, params ) && !MSI_ViewFetch( q, &row ))
+        {
+            ret = TRUE;
+            msiobj_release( &row->hdr );
+        }
+        msiobj_release( &params->hdr );
+    }
+    MSI_ViewClose( q );
+    msiobj_release( &q->hdr );
+    return ret;
+}
+
+/* ---- validation of one column ---- */
+
+static BOOL in_set( const WCHAR *set, const WCHAR *value )
+{
+    size_t len = wcslen( value );
+    const WCHAR *p = set;
+
+    while (*p)
+    {
+        const WCHAR *end = wcschr( p, ';' );
+        size_t n = end ? end - p : wcslen( p );
+        if (n == len && !wcsncmp( p, value, len )) return TRUE;
+        if (!end) break;
+        p = end + 1;
+    }
+    return FALSE;
+}
+
+static MSIDBERROR check_category( const WCHAR *category, const WCHAR *s )
+{
+    if (!wcsicmp( category, L"Text" ) || !wcsicmp( category, L"Binary" ) ||
+        !wcsicmp( category, L"Formatted" ) || !wcsicmp( category, L"FormattedSDDLText" ) ||
+        !wcsicmp( category, L"Template" ))
+        return MSIDBERROR_NOERROR;
+    if (!wcsicmp( category, L"UpperCase" ))
+    {
+        for (; *s; s++) if (iswlower( *s )) return MSIDBERROR_BADCASE;
+        return MSIDBERROR_NOERROR;
+    }
+    if (!wcsicmp( category, L"LowerCase" ))
+    {
+        for (; *s; s++) if (iswupper( *s )) return MSIDBERROR_BADCASE;
+        return MSIDBERROR_NOERROR;
+    }
+    if (!wcsicmp( category, L"Identifier" )) return is_identifier( s, wcslen( s ) ) ? 0 : MSIDBERROR_BADIDENTIFIER;
+    if (!wcsicmp( category, L"Property" )) return is_property( s ) ? 0 : MSIDBERROR_BADPROPERTY;
+    if (!wcsicmp( category, L"Filename" )) return is_filename( s, FALSE ) ? 0 : MSIDBERROR_BADFILENAME;
+    if (!wcsicmp( category, L"WildCardFilename" )) return is_filename( s, TRUE ) ? 0 : MSIDBERROR_BADWILDCARD;
+    if (!wcsicmp( category, L"Path" )) return is_path( s ) ? 0 : MSIDBERROR_BADPATH;
+    if (!wcsicmp( category, L"Paths" )) return is_paths( s ) ? 0 : MSIDBERROR_BADPATH;
+    if (!wcsicmp( category, L"AnyPath" )) return is_anypath( s ) ? 0 : MSIDBERROR_BADPATH;
+    if (!wcsicmp( category, L"DefaultDir" )) return is_default_dir( s ) ? 0 : MSIDBERROR_BADDEFAULTDIR;
+    if (!wcsicmp( category, L"RegPath" )) return is_regpath( s ) ? 0 : MSIDBERROR_BADREGPATH;
+    if (!wcsicmp( category, L"Condition" )) return is_condition( s ) ? 0 : MSIDBERROR_BADCONDITION;
+    if (!wcsicmp( category, L"GUID" )) return is_guid( s ) ? 0 : MSIDBERROR_BADGUID;
+    if (!wcsicmp( category, L"Version" )) return is_version( s ) ? 0 : MSIDBERROR_BADVERSION;
+    if (!wcsicmp( category, L"Language" )) return is_language( s ) ? 0 : MSIDBERROR_BADLANGUAGE;
+    if (!wcsicmp( category, L"CustomSource" )) return is_identifier( s, wcslen( s ) ) ? 0 : MSIDBERROR_BADCUSTOMSOURCE;
+    if (!wcsicmp( category, L"Cabinet" )) return is_cabinet( s ) ? 0 : MSIDBERROR_BADCABINET;
+    if (!wcsicmp( category, L"Shortcut" ))
+    {
+        if (wcschr( s, '[' )) return MSIDBERROR_NOERROR;
+        return is_identifier( s, wcslen( s ) ) ? 0 : MSIDBERROR_BADSHORTCUT;
+    }
+    return MSIDBERROR_BADCATEGORY;
+}
+
+static BOOL table_exists( MSIDATABASE *db, const WCHAR *name )
+{
+    MSIQUERY *view;
+    WCHAR *query;
+    size_t len = wcslen( name ) + 32;
+    BOOL ret;
+
+    if (wcschr( name, '`' ) || !(query = malloc( len * sizeof(WCHAR) ))) return FALSE;
+    swprintf( query, len, L"SELECT * FROM `%s`", name );
+    ret = !MSI_DatabaseOpenViewW( db, query, &view );
+    free( query );
+    if (ret) msiobj_release( &view->hdr );
+    return ret;
+}
+
+static UINT validate_columns( MSIDATABASE *db, MSIVIEW *tv, MSIRECORD *rec, MSIMODIFY mode, UINT cols,
+                              struct msi_verror **errors, UINT *count )
+{
+    UINT i;
+
+    for (i = 1; i <= cols; i++)
+    {
+        const WCHAR *colname, *table_name, *sval = NULL;
+        MSIRECORD *vrow;
+        UINT type, ival = 0;
+        BOOL null, is_string;
+        MSIDBERROR err = MSIDBERROR_NOERROR;
+        const WCHAR *nullable, *category, *set, *keytable;
+        int minv, maxv;
+
+        if (tv->ops->get_column_info( tv, i, &colname, &type, NULL, &table_name )) return ERROR_FUNCTION_FAILED;
+        is_string = (type & MSITYPE_STRING) != 0;
+
+        if (is_string)
+        {
+            sval = i <= MSI_RecordGetFieldCount( rec ) ? MSI_RecordGetString( rec, i ) : NULL;
+            null = !sval || !sval[0];
+        }
+        else
+        {
+            null = i > MSI_RecordGetFieldCount( rec ) || MSI_RecordIsNull( rec, i );
+            if (!null) ival = MSI_RecordGetInteger( rec, i );
+        }
+
+        /* a partial record only has some of its fields checked */
+        if (mode == MSIMODIFY_VALIDATE_FIELD && null) continue;
+
+        if (!(vrow = MSI_QueryGetRecord( db, L"SELECT * FROM `_Validation` WHERE `Table` = '%s' AND `Column` = '%s'",
+                                         table_name, colname )))
+        {
+            if (!add_error( errors, count, MSIDBERROR_MISSINGDATA, colname )) return ERROR_OUTOFMEMORY;
+            continue;
+        }
+
+        nullable = MSI_RecordGetString( vrow, VAL_NULLABLE );
+        category = MSI_RecordGetString( vrow, VAL_CATEGORY );
+        set = MSI_RecordGetString( vrow, VAL_SET );
+        keytable = MSI_RecordGetString( vrow, VAL_KEYTABLE );
+        minv = MSI_RecordIsNull( vrow, VAL_MINVALUE ) ? 0 : MSI_RecordGetInteger( vrow, VAL_MINVALUE );
+        maxv = MSI_RecordIsNull( vrow, VAL_MAXVALUE ) ? 0 : MSI_RecordGetInteger( vrow, VAL_MAXVALUE );
+
+        if (!MSI_RecordIsNull( vrow, VAL_MINVALUE ) && !MSI_RecordIsNull( vrow, VAL_MAXVALUE ) && maxv < minv)
+            err = MSIDBERROR_BADMAXMINVALUES;
+        else if (null)
+        {
+#ifndef SG_MUTANT_MSIB1_REQ
+            if (nullable && nullable[0] == 'N' && !nullable[1]) err = MSIDBERROR_REQUIRED;
+#endif
+        }
+        else if (MSITYPE_IS_BINARY(type))
+        {
+            /* nothing to check for streams */
+        }
+        else
+        {
+            if (is_string)
+            {
+                UINT width = type & 0xff;
+#ifndef SG_MUTANT_MSIB1_STROVF
+                if (width && wcslen( sval ) > width) err = MSIDBERROR_STRINGOVERFLOW;
+#endif
+            }
+            else
+            {
+                if (!MSI_RecordIsNull( vrow, VAL_MINVALUE ) && (int)ival < minv) err = MSIDBERROR_UNDERFLOW;
+#ifndef SG_MUTANT_MSIB1_RANGE
+                else if (!MSI_RecordIsNull( vrow, VAL_MAXVALUE ) && (int)ival > maxv) err = MSIDBERROR_OVERFLOW;
+#endif
+            }
+
+            if (!err && set && set[0])
+            {
+                WCHAR num[16];
+                if (!is_string) swprintf( num, ARRAY_SIZE(num), L"%d", (int)ival );
+#ifndef SG_MUTANT_MSIB1_SET
+                if (!in_set( set, is_string ? sval : num )) err = MSIDBERROR_NOTINSET;
+#endif
+            }
+
+            /* the category is ignored for integer columns */
+            if (!err && is_string && category && category[0]) err = check_category( category, sval );
+
+            if (!err && keytable && keytable[0] && !MSI_RecordIsNull( vrow, VAL_KEYCOLUMN ))
+            {
+                UINT keycol = MSI_RecordGetInteger( vrow, VAL_KEYCOLUMN );
+                WCHAR *tables = wcsdup( keytable ), *p, *end;
+                BOOL found = FALSE, all_bad = TRUE, bad;
+
+                if (!tables)
+                {
+                    msiobj_release( &vrow->hdr );
+                    return ERROR_OUTOFMEMORY;
+                }
+                for (p = tables; ; p = end + 1)
+                {
+                    end = wcschr( p, ';' );
+                    if (end) *end = 0;
+                    if (link_exists( db, p, keycol, is_string, sval, ival, &bad )) found = TRUE;
+                    if (!bad) all_bad = FALSE;
+                    if (found || !end) break;
+                }
+                free( tables );
+#ifdef SG_MUTANT_MSIB1_LINK
+                found = TRUE;
+#endif
+                if (!found) err = all_bad ? MSIDBERROR_BADKEYTABLE : MSIDBERROR_BADLINK;
+            }
+        }
+        msiobj_release( &vrow->hdr );
+
+        if (err && !add_error( errors, count, err, colname )) return ERROR_OUTOFMEMORY;
+    }
+    return ERROR_SUCCESS;
+}
+
+/* another row refers to the key of the record that is about to be deleted */
+static UINT validate_delete( MSIDATABASE *db, MSIVIEW *tv, MSIRECORD *rec, struct msi_verror **errors, UINT *count )
+{
+    const WCHAR *table_name, *colname;
+    MSIQUERY *vview;
+    MSIRECORD *vrow;
+    UINT type, r;
+
+    if (tv->ops->get_column_info( tv, 1, &colname, &type, NULL, &table_name )) return ERROR_FUNCTION_FAILED;
+    if (MSI_DatabaseOpenViewW( db, L"SELECT * FROM `_Validation` WHERE `KeyTable` IS NOT NULL", &vview ))
+        return ERROR_SUCCESS;
+    r = MSI_ViewExecute( vview, NULL );
+    while (!r && !MSI_ViewFetch( vview, &vrow ))
+    {
+        const WCHAR *keytable = MSI_RecordGetString( vrow, VAL_KEYTABLE );
+        const WCHAR *ref_table = MSI_RecordGetString( vrow, VAL_TABLE );
+        const WCHAR *ref_column = MSI_RecordGetString( vrow, VAL_COLUMN );
+        UINT keycol = MSI_RecordGetInteger( vrow, VAL_KEYCOLUMN );
+
+        if (keytable && ref_table && ref_column && !MSI_RecordIsNull( vrow, VAL_KEYCOLUMN ) &&
+            in_set( keytable, table_name ) && keycol >= 1 && keycol <= MSI_RecordGetFieldCount( rec ) &&
+            !MSI_RecordIsNull( rec, keycol ))
+        {
+            const WCHAR *kname, *sval = NULL;
+            UINT ktype, ival = 0;
+            BOOL is_string;
+
+            if (!tv->ops->get_column_info( tv, keycol, &kname, &ktype, NULL, NULL ) &&
+                !wcschr( ref_table, '`' ) && !wcschr( ref_column, '`' ))
+            {
+                MSIQUERY *rview;
+                WCHAR *query;
+                size_t len = wcslen( ref_table ) + wcslen( ref_column ) + 40;
+
+                is_string = (ktype & MSITYPE_STRING) != 0;
+                if (is_string) sval = MSI_RecordGetString( rec, keycol );
+                else ival = MSI_RecordGetInteger( rec, keycol );
+
+                if ((query = malloc( len * sizeof(WCHAR) )))
+                {
+                    swprintf( query, len, L"SELECT * FROM `%s` WHERE `%s` = ?", ref_table, ref_column );
+                    if (!MSI_DatabaseOpenViewW( db, query, &rview ))
+                    {
+                        MSIRECORD *params = MSI_CreateRecord( 1 ), *row = NULL;
+
+                        if (params)
+                        {
+                            if (is_string) MSI_RecordSetStringW( params, 1, sval );
+                            else MSI_RecordSetInteger( params, 1, ival );
+                            if (!MSI_ViewExecute( rview, params ) && !MSI_ViewFetch( rview, &row ))
+                            {
+                                msiobj_release( &row->hdr );
+#ifndef SG_MUTANT_MSIB1_VDEL
+                                if (!add_error( errors, count, MSIDBERROR_REQUIRED, kname )) r = ERROR_OUTOFMEMORY;
+#endif
+                            }
+                            msiobj_release( &params->hdr );
+                        }
+                        MSI_ViewClose( rview );
+                        msiobj_release( &rview->hdr );
+                    }
+                    free( query );
+                }
+            }
+        }
+        msiobj_release( &vrow->hdr );
+    }
+    MSI_ViewClose( vview );
+    msiobj_release( &vview->hdr );
+    return r == ERROR_OUTOFMEMORY ? r : ERROR_SUCCESS;
+}
+
+/* Validates the record against the _Validation table. The errors are stored in the view
+ * (to be read with MsiViewGetError). Returns ERROR_INVALID_DATA if the record is invalid. */
+UINT msi_validate_record( MSIDATABASE *db, MSIVIEW *tv, MSIRECORD *rec, MSIMODIFY mode )
+{
+    struct msi_verror *errors = NULL;
+    UINT count = 0, rows, cols, r;
+
+    if (tv->ops->get_dimensions( tv, &rows, &cols )) return ERROR_FUNCTION_FAILED;
+
+    if (!table_exists( db, L"_Validation" ))
+    {
+        const WCHAR *colname;
+        UINT type;
+
+        /* VALIDATE_NEW has always accepted a database without the table */
+        if (mode == MSIMODIFY_VALIDATE_NEW)
+        {
+            msi_view_clear_errors( tv );
+            return ERROR_SUCCESS;
+        }
+
+        /* the documentation requires the table */
+        if (!tv->ops->get_column_info( tv, 1, &colname, &type, NULL, NULL ) &&
+            add_error( &errors, &count, MSIDBERROR_MISSINGDATA, colname ))
+            msi_view_set_errors( tv, errors, count );
+        return ERROR_INVALID_DATA;
+    }
+
+    if (mode == MSIMODIFY_VALIDATE_DELETE) r = validate_delete( db, tv, rec, &errors, &count );
+    else r = validate_columns( db, tv, rec, mode, cols, &errors, &count );
+    if (r)
+    {
+        free( errors );
+        return r;
+    }
+
+    TRACE( "mode %d: %u error(s)\n", mode, count );
+    msi_view_set_errors( tv, errors, count );
+    return count ? ERROR_INVALID_DATA : ERROR_SUCCESS;
+}
