+/* An advertise script of this implementation is a UTF-8 text file: a signature line and then
+ * "name=value" lines that identify the package and the way it is advertised.  The script is written and
+ * read by this DLL only (the format of Windows' scripts is not documented). */
+#define ADVERTISE_SCRIPT_SIGNATURE "SGADVSCRIPT 1"
+#define ADVERTISE_SCRIPT_SIGNATUREW L"SGADVSCRIPT 1"
+#define MSIARCHITECTUREFLAGS_MASK  7
+#define MSIADVERTISEOPTIONS_INSTANCE 1
+
+static BOOL advertise_target_is_flag( const WCHAR *target )
+{
+    return (ULONG_PTR)target <= ADVERTISEFLAGS_USERASSIGN;
+}
+
+static UINT advertise_package_code( const WCHAR *package, WCHAR *code, DWORD size )
+{
+    MSIDATABASE *db;
+    MSIRECORD *rec;
+    const WCHAR *value;
+    UINT r;
+
+    if (MSI_OpenDatabaseW( package, MSIDBOPEN_READONLY, &db )) return ERROR_INSTALL_PACKAGE_OPEN_FAILED;
+    rec = MSI_QueryGetRecord( db, L"SELECT `Value` FROM `Property` WHERE `Property` = 'ProductCode'" );
+    msiobj_release( &db->hdr );
+    if (!rec) return ERROR_INSTALL_PACKAGE_INVALID;
+    value = MSI_RecordGetString( rec, 1 );
+    if (value && lstrlenW( value ) < size) { lstrcpyW( code, value ); r = ERROR_SUCCESS; }
+    else r = ERROR_INSTALL_PACKAGE_INVALID;
+    msiobj_release( &rec->hdr );
+    return r;
+}
+
+static UINT write_advertise_script( const WCHAR *script, const WCHAR *package, const WCHAR *transforms,
