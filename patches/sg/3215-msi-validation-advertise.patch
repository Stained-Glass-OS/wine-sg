+/* The top-level ADVERTISE action: AdvtUISequence / AdvtExecuteSequence publish the product, its
+ * features, shortcuts and COM/shell information without installing the files. */
+static UINT ACTION_ADVERTISE(MSIPACKAGE *package)
+{
+    WCHAR *advertise;
+
+    msi_set_property(package->db, L"EXECUTEACTION", L"ADVERTISE", -1);
+
+    /* all features are advertised unless the command line chose some */
+#ifndef SG_MUTANT_MSIB1_ADV
+    if (!(advertise = msi_dup_property( package->db, L"ADVERTISE" )))
+        msi_set_property(package->db, L"ADVERTISE", L"ALL", -1);
+#else
+    advertise = NULL;
+#endif
+    free( advertise );
+
+    if (needs_ui_sequence(package) && ui_sequence_exists(package, L"AdvtUISequence"))
+    {
+        package->InWhatSequence |= SEQUENCE_UI;
+        return ACTION_ProcessUISequence(package, L"AdvtUISequence");
+    }
+    return ACTION_ExecuteAction(package);
+}
