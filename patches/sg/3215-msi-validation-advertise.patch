+/* Match PIDKEY against the visible part of a PIDTemplate (MaskedEdit syntax)
+ * and build the full product id: hidden prefix, key, '-', hidden suffix.
+ * Returns NULL if the key does not fit the mask. */
+static WCHAR *build_product_id( const WCHAR *template, const WCHAR *key )
+{
+    const WCHAR *lt = wcschr( template, '<' ), *gt = lt ? wcschr( lt, '>' ) : NULL;
+    const WCHAR *vis, *vis_end, *p, *k = key;
+    WCHAR *ret, kind = 0, *out;
+    size_t len;
+
+    if (lt && gt) { vis = lt + 1; vis_end = gt; }
+    else { lt = gt = NULL; vis = template; vis_end = template + wcslen( template ); }
+
+    for (p = vis; p < vis_end; p++)
+    {
+        switch (*p)
+        {
+        case '#': case '%':
+            if (*k < '0' || *k > '9') return NULL;
+            kind = *p; k++;
+            break;
+        case '&': case '^': case '?': case '`':
+            if (!*k) return NULL;
+            kind = *p; k++;
+            break;
+        case '=':
+            /* one more position of the preceding kind, then the '-' separator */
+            if (kind == '#' || kind == '%') { if (*k < '0' || *k > '9') return NULL; }
+            else if (!*k) return NULL;
+            k++;
+            if (*k != '-') return NULL;
+            k++;
+            break;
+        case '_':
+            if (*k != '_') return NULL;
+            k++;
+            break;
+        default:
+#ifndef SG_MUTANT_MSIB1_PID
+            if (*k != *p) return NULL;
+#endif
+            k++;
+            break;
+        }
+    }
+    if (*k) return NULL;
+
+    len = wcslen( template ) + wcslen( key ) + 2;
+    if (!(out = ret = malloc( len * sizeof(WCHAR) ))) return NULL;
+    if (lt)
+    {
+        for (p = template; p < lt; p++) *out++ = *p;
+        for (k = key; *k; k++) *out++ = *k;
+        *out++ = '-';
+        for (p = gt + 1; *p; p++)
+        {
+            if (*p == '@') *out++ = '0' + (GetTickCount() / 7 + (p - gt) * 3) % 10;
+            else *out++ = *p;
+        }
+    }
+    else for (k = key; *k; k++) *out++ = *k;
+    *out = 0;
+    return ret;
+}
