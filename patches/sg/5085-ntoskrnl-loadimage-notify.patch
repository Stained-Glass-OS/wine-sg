From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: PsSetLoadImageNotifyRoutineEx flags and limit.

The routine was a FIXME that took any flags and held eight routines.
Flags other than PS_IMAGE_NOTIFY_CONFLICTING_ARCHITECTURE are
STATUS_INVALID_PARAMETER_2 and up to 64 routines can be registered, as
documented.

Gate: test/ntoskrnl-loadimage-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -71,7 +71,12 @@
 
 static void *ldr_notify_cookie;
 
+/* at most 64 routines can be registered */
+#ifdef SG_MUTANT_IMAGE_NOTIFY_LIMIT
 static PLOAD_IMAGE_NOTIFY_ROUTINE load_image_notify_routines[8];
+#else
+static PLOAD_IMAGE_NOTIFY_ROUTINE load_image_notify_routines[64];
+#endif
 static unsigned int load_image_notify_routine_count;
 
 struct irp_data
@@ -4227,7 +4232,13 @@
  */
 NTSTATUS WINAPI PsSetLoadImageNotifyRoutineEx(PLOAD_IMAGE_NOTIFY_ROUTINE routine, ULONG_PTR flags)
 {
-    FIXME("routine %p, flags %Ix semi-stub.\n", routine, flags);
+    TRACE("routine %p, flags %Ix.\n", routine, flags);
+
+    /* PS_IMAGE_NOTIFY_CONFLICTING_ARCHITECTURE (1) is the only flag; the images a driver can see
+     * here are all of the native architecture, so it makes no difference to the calls */
+#ifndef SG_MUTANT_IMAGE_NOTIFY_FLAGS
+    if (flags & ~(ULONG_PTR)1) return STATUS_INVALID_PARAMETER_2;
+#endif
 
     if (load_image_notify_routine_count == ARRAY_SIZE(load_image_notify_routines))
         return STATUS_INSUFFICIENT_RESOURCES;
