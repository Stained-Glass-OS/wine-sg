From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] regedit, wine.inf: .reg files merge on a double-click, asking first

Issue #13 (live ISO): .reg files were "not registered as a valid
filetype". regfile had a name and no verbs, so a double-click did nothing.
As on Windows, regfile now has Merge (its double-click: regedit "%1"),
Edit and Print (Notepad), and regedit's second icon, a page with the
registry's blocks (theme/icons.py). "regedit FILE" (no /s) asks "Are you
sure you want to continue?" first and then reports: the keys and values
were added; not all data was written (one report for the keys and values
it could not write, instead of a message box per line); or the file is no
registry script. A [-key] it cannot delete is one more such error (regedit
used to exit there). regedit's manifest asks for the highest available
level, as Windows' does: an administrator's double-click goes through
consent (the elevation broker, 0259/0623), a standard user's runs as the
user. Gate: test/regmerge-gate.sh (make test-regmerge). Mutant:
SG_MUTANT_MERGE_NO_CONFIRM.
---
--- a/programs/regedit/regedit.c
+++ b/programs/regedit/regedit.c
@@ -30,6 +30,11 @@
 
 static BOOL silent;
 
+/* Stained Glass OS: a .reg file merged by its double-click ("regedit FILE", no /s) asks
+ * first and reports after, as Windows' regedit does; the line-by-line errors of that
+ * import are counted (import_errors) for its report, not shown one box each */
+static BOOL merging;
+
 static void output_formatstring(BOOL with_help, UINT id, va_list va_args)
 {
     WCHAR buffer[4096];
@@ -79,6 +84,11 @@
 {
     va_list va_args;
 
+    if (merging)
+    {
+        import_errors++;
+        return;
+    }
     va_start(va_args, id);
     output_formatstring(FALSE, id, va_args);
     va_end(va_args);
@@ -100,6 +110,23 @@
     error_exit();
 }
 
+/* a message of the merge, about FILE, in a message box titled "Registry Editor" */
+static int merge_box(UINT flags, UINT id, const WCHAR *file)
+{
+    WCHAR title[128], fmt[1024], *str = NULL;
+    DWORD_PTR args[1];
+    int ret;
+
+    args[0] = (DWORD_PTR)file;
+    LoadStringW(GetModuleHandleW(NULL), IDS_APP_TITLE, title, ARRAY_SIZE(title));
+    LoadStringW(GetModuleHandleW(NULL), id, fmt, ARRAY_SIZE(fmt));
+    FormatMessageW(FORMAT_MESSAGE_FROM_STRING | FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_ARGUMENT_ARRAY,
+                   fmt, 0, 0, (WCHAR *)&str, 0, (va_list *)args);
+    ret = MessageBoxW(NULL, str ? str : fmt, title, flags | MB_SETFOREGROUND);
+    LocalFree(str);
+    return ret;
+}
+
 typedef enum {
     ACTION_ADD, ACTION_EXPORT, ACTION_DELETE
 } REGEDIT_ACTION;
@@ -139,7 +166,32 @@
                     return;
                 }
             }
-            import_registry_file(reg_file);
+            if (silent || !realname)
+                import_registry_file(reg_file);
+            else
+            {
+                /* "Are you sure you want to continue?" -- then the keys go in and
+                 * regedit says whether they all did */
+                BOOL ok;
+#ifndef SG_MUTANT_MERGE_NO_CONFIRM
+                if (merge_box(MB_YESNO | MB_ICONWARNING, IDS_IMPORT_CONFIRM, realname) != IDYES)
+                {
+                    free(realname);
+                    fclose(reg_file);
+                    return;
+                }
+#endif
+                import_errors = 0;
+                merging = TRUE;
+                ok = import_registry_file(reg_file);
+                merging = FALSE;
+                if (!ok)
+                    merge_box(MB_OK | MB_ICONERROR, IDS_IMPORT_FAILED, realname);
+                else if (import_errors)
+                    merge_box(MB_OK | MB_ICONERROR, IDS_IMPORT_PARTIAL, realname);
+                else
+                    merge_box(MB_OK | MB_ICONINFORMATION, IDS_IMPORT_SUCCESSFUL, realname);
+            }
             if (realname)
             {
                 free(realname);
--- a/programs/regedit/regproc.c
+++ b/programs/regedit/regproc.c
@@ -427,6 +427,10 @@
     }
 }
 
+/* Stained Glass OS: what an import could not do -- keys it could not open, values it
+ * could not set or delete, keys it could not delete -- for regedit's report */
+unsigned int import_errors;
+
 /******************************************************************************
  * Opens the registry key given by the input path.
  * This key must be closed by calling close_key().
@@ -592,6 +596,7 @@
 
     if (open_key(parser, line) != ERROR_SUCCESS)
     {
+        import_errors++;
         output_message(STRING_OPEN_KEY_FAILED, line);
         return line;
     }
@@ -653,7 +658,10 @@
         return p + 1;
     }
     else if (open_key(parser, p) != ERROR_SUCCESS)
+    {
+        import_errors++;
         output_message(STRING_OPEN_KEY_FAILED, p);
+    }
 
 done:
     set_state(parser, LINE_START);
@@ -668,7 +676,18 @@
     close_key(parser);
 
     if (*p == 'H' || *p == 'h')
-        delete_registry_key(p);
+    {
+        /* Stained Glass OS: a key that cannot be deleted is one more error of the
+         * import, as on Windows -- regedit went on no further (error_exit) */
+        WCHAR *key_name = NULL;
+        HKEY key_class = parse_key_name(p, &key_name);
+        LONG res;
+
+        if (!key_class || !key_name || !*key_name)
+            import_errors++;
+        else if ((res = RegDeleteTreeW(key_class, key_name)) && res != ERROR_FILE_NOT_FOUND)
+            import_errors++;
+    }
 
     set_state(parser, LINE_START);
     return p;
@@ -741,7 +760,13 @@
     while (*p == ' ' || *p == '\t') p++;
     if (*p && *p != ';') goto done;
 
-    RegDeleteValueW(parser->hkey, parser->value_name);
+    if (!parser->hkey)
+        import_errors++;
+    else
+    {
+        LONG res = RegDeleteValueW(parser->hkey, parser->value_name);
+        if (res != ERROR_SUCCESS && res != ERROR_FILE_NOT_FOUND) import_errors++;
+    }
 
 done:
     set_state(parser, LINE_START);
@@ -906,8 +931,10 @@
 /* handler for parser SET_VALUE state */
 static WCHAR *set_value_state(struct parser *parser, WCHAR *pos)
 {
-    RegSetValueExW(parser->hkey, parser->value_name, 0, parser->data_type,
-                   parser->data, parser->data_size);
+    /* without a key (it could not be opened) the error is counted already */
+    if (parser->hkey && RegSetValueExW(parser->hkey, parser->value_name, 0, parser->data_type,
+                                       parser->data, parser->data_size) != ERROR_SUCCESS)
+        import_errors++;
 
     free_parser_data(parser);
 
--- a/programs/regedit/main.h
+++ b/programs/regedit/main.h
@@ -157,6 +157,7 @@
 void WINAPIV error_exit(void);
 
 /* regproc.c */
+extern unsigned int import_errors;
 char *GetMultiByteString(const WCHAR *strW);
 BOOL import_registry_file(FILE *reg_file);
 void delete_registry_key(WCHAR *reg_key_name);
--- a/programs/regedit/resource.h
+++ b/programs/regedit/resource.h
@@ -34,6 +34,7 @@
 #define IDS_LIST_COLUMN_LAST            93
 #define IDS_APP_TITLE                   103
 #define IDI_REGEDIT                     100
+#define IDI_REGFILE                     101
 #define IDI_SMALL                       108
 #define IDC_REGEDIT                     109
 #define IDC_REGEDIT_FRAME               110
@@ -170,6 +171,8 @@
 #define IDS_RENAME_VALUE_FAILED         2017
 #define IDS_IMPORT_SUCCESSFUL           2018
 #define IDS_IMPORT_FAILED               2019
+#define IDS_IMPORT_CONFIRM              2020
+#define IDS_IMPORT_PARTIAL              2021
 
 #define IDC_EXPORT_BASE                 100
 #define IDC_EXPORT_ALL                  101
--- a/programs/regedit/regedit.rc
+++ b/programs/regedit/regedit.rc
@@ -256,8 +256,10 @@
     IDS_DELETE_KEY_FAILED    "Unable to delete the selected registry key."
     IDS_RENAME_KEY_FAILED    "Unable to rename the selected registry key."
     IDS_RENAME_VALUE_FAILED  "Unable to rename the selected registry value."
-    IDS_IMPORT_SUCCESSFUL    "The keys and values contained in %1 were successfully added to the registry."
-    IDS_IMPORT_FAILED        "Unable to import %1. The specified file is not a valid registry file."
+    IDS_IMPORT_SUCCESSFUL    "The keys and values contained in %1 have been successfully added to the registry."
+    IDS_IMPORT_FAILED        "Cannot import %1: The specified file is not a registry script. You can only import binary registry files from within the registry editor."
+    IDS_IMPORT_CONFIRM       "Adding information can unintentionally change or delete values and cause components to stop working correctly. If you do not trust the source of this information in %1, do not add it to the registry.\n\nAre you sure you want to continue?"
+    IDS_IMPORT_PARTIAL       "Cannot import %1: Not all data was successfully written to the registry. Some keys are open by the system or other processes, or you have insufficient privileges to perform this operation."
 END
 
 /*
@@ -460,6 +462,11 @@
 /* @makedep: regedit.ico */
 IDI_REGEDIT ICON regedit.ico
 
+/* Stained Glass OS: a .reg file's icon (regfile's DefaultIcon, "regedit.exe,1", as on
+ * Windows): a page with the registry's blocks, drawn by theme/icons.py */
+/* @makedep: regfile.ico */
+IDI_REGFILE ICON regfile.ico
+
 #define WINE_FILEDESCRIPTION_STR "Registry Editor"
 #define WINE_FILENAME "REGEDIT"
 #define WINE_FILENAME_STR "REGEDIT.EXE"
--- a/programs/regedit/regedit.manifest
+++ b/programs/regedit/regedit.manifest
@@ -13,6 +13,13 @@
         />
     </dependentAssembly>
 </dependency>
+<trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
+    <security>
+        <requestedPrivileges>
+            <requestedExecutionLevel level="highestAvailable" uiAccess="false"/>
+        </requestedPrivileges>
+    </security>
+</trustInfo>
 <application xmlns="urn:schemas-microsoft-com:asm.v3">
     <windowsSettings>
         <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
