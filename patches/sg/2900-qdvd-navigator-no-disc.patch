+#define DVD_CMD_FLAGS_MASK 0x1f
+
+static BOOL volume_exists(const WCHAR *path)
+{
+    static const WCHAR ifo[] = L"\\VIDEO_TS\\VIDEO_TS.IFO";
+    WCHAR buffer[MAX_PATH + 32];
+    size_t len = wcslen(path);
+
+    if (!len || len >= MAX_PATH)
+        return FALSE;
+    wcscpy(buffer, path);
+    if (buffer[len - 1] == '\\' || buffer[len - 1] == '/')
+        buffer[--len] = 0;
+    wcscpy(buffer + len, ifo);
+    return GetFileAttributesW(buffer) != INVALID_FILE_ATTRIBUTES;
+}
+
+/* Playback and selection commands need a started disc; in the stop domain
+ * (the only state this navigator has) they fail with VFW_E_DVD_INVALIDDOMAIN. */
+static HRESULT nav_domain_check(struct navigator *filter)
+{
+#ifdef SG_MUTANT_DOMAIN
+    return S_OK;
+#endif
+    return filter->domain == DVD_DOMAIN_Stop ? VFW_E_DVD_INVALIDDOMAIN : S_OK;
+}
+
+static HRESULT nav_cmd(struct navigator *filter, DWORD flags, IDvdCmd **cmd)
+{
+    if (cmd)
+        *cmd = NULL;
+#ifndef SG_MUTANT_ARGS
+    if (flags & ~DVD_CMD_FLAGS_MASK)
+        return E_INVALIDARG;
+#endif
+    return nav_domain_check(filter);
+}
+
+static BOOL bad_time(const DVD_HMSF_TIMECODE *time)
+{
+    return time->bMinutes > 59 || time->bSeconds > 59 || time->bFrames > 29;
+}
+
 static inline struct navigator *impl_from_strmbase_filter(struct strmbase_filter *filter)
