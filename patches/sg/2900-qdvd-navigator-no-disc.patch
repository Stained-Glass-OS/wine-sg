From: Stained Glass OS drafter 5 <noreply@anthropic.com>
Subject: [PATCH] qdvd: implement the DVD navigator and graph builder without a disc

The navigator has no navigation engine, so it never leaves the stop domain.
IDvdControl2 playback, menu, button and stream commands validate their
arguments (E_POINTER, E_INVALIDARG for unknown command flags, titles, chapters,
times, streams, angles, buttons, menus) and then fail with
VFW_E_DVD_INVALIDDOMAIN, clearing the IDvdCmd out pointer; Stop succeeds.
The settings that may be changed while stopped are stored and read back through
IDvdInfo2: parental level and country, default menu/audio/sub-picture
languages (and extensions), options, and the DVD directory (validated by the
presence of VIDEO_TS\VIDEO_TS.IFO, else VFW_E_DVD_INVALID_DISC). The IDvdInfo2
queries return VFW_E_DVD_INVALIDDOMAIN after pointer and index checks;
GetCurrentDomain reports DVD_DOMAIN_Stop and GetDecoderCaps an empty set.
IDvdGraphBuilder owns a filter graph (GetFiltergraph), GetDvdInterface returns
VFW_E_DVD_GRAPHNOTREADY until a volume has been rendered, then the navigator's
or the graph's interfaces, and RenderDvdVideoVolume validates its flags,
puts the navigator in the graph for a valid volume and reports
VFW_E_DVD_RENDERFAIL with the AM_DVD_RENDERSTATUS fields set.
---
diff --git a/dlls/qdvd/graph.c b/dlls/qdvd/graph.c
index ab9ea85..adda955 100644
--- a/dlls/qdvd/graph.c
+++ b/dlls/qdvd/graph.c
@@ -29,8 +29,16 @@ struct graph_builder
 
     IUnknown *outer_unk;
     LONG refcount;
+
+    CRITICAL_SECTION cs;
+    IGraphBuilder *graph;
+    IBaseFilter *navigator;
 };
 
+#define DVD_RENDER_DECODER_FLAGS (AM_DVD_HWDEC_PREFER | AM_DVD_HWDEC_ONLY | AM_DVD_SWDEC_PREFER | AM_DVD_SWDEC_ONLY)
+#define DVD_RENDER_KNOWN_FLAGS (DVD_RENDER_DECODER_FLAGS | AM_DVD_NOVPE | AM_DVD_DO_NOT_CLEAR | AM_DVD_VMR9_ONLY \
+        | AM_DVD_EVR_ONLY | AM_DVD_EVR_QOS | AM_DVD_ADAPT_GRAPH)
+
 static struct graph_builder *impl_from_IUnknown(IUnknown *iface)
 {
     return CONTAINING_RECORD(iface, struct graph_builder, IUnknown_inner);
@@ -50,7 +58,14 @@ static ULONG WINAPI inner_Release(IUnknown *iface)
     ULONG refcount = InterlockedDecrement(&builder->refcount);
     TRACE("%p decreasing refcount to %lu.\n", builder, refcount);
     if (!refcount)
+    {
+        if (builder->navigator)
+            IBaseFilter_Release(builder->navigator);
+        if (builder->graph)
+            IGraphBuilder_Release(builder->graph);
+        DeleteCriticalSection(&builder->cs);
         free(builder);
+    }
     return refcount;
 }
 
@@ -105,22 +120,155 @@ static HRESULT WINAPI graph_builder_QueryInterface(IDvdGraphBuilder *iface, REFI
     return IUnknown_QueryInterface(builder->outer_unk, iid, out);
 }
 
+/* The builder owns one filter graph manager, created when first needed. */
+static HRESULT builder_get_graph(struct graph_builder *builder, IGraphBuilder **graph)
+{
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&builder->cs);
+    if (!builder->graph)
+        hr = CoCreateInstance(&CLSID_FilterGraph, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IGraphBuilder, (void **)&builder->graph);
+    if (SUCCEEDED(hr))
+    {
+        *graph = builder->graph;
+        IGraphBuilder_AddRef(*graph);
+    }
+    LeaveCriticalSection(&builder->cs);
+    return hr;
+}
+
 static HRESULT WINAPI graph_builder_GetFiltergraph(IDvdGraphBuilder *iface, IGraphBuilder **graph)
 {
-    FIXME("iface %p, graph %p, stub!\n", iface, graph);
-    return E_NOTIMPL;
+    struct graph_builder *builder = impl_from_IDvdGraphBuilder(iface);
+
+    TRACE("iface %p, graph %p.\n", iface, graph);
+
+    if (!graph)
+        return E_POINTER;
+    *graph = NULL;
+    return builder_get_graph(builder, graph);
 }
 
 static HRESULT WINAPI graph_builder_GetDvdInterface(IDvdGraphBuilder *iface, REFIID iid, void **out)
 {
-    FIXME("iface %p, iid %s, out %p, stub!\n", iface, debugstr_guid(iid), out);
-    return E_NOTIMPL;
+    struct graph_builder *builder = impl_from_IDvdGraphBuilder(iface);
+    IBaseFilter *navigator;
+    IGraphBuilder *graph;
+    HRESULT hr;
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (!out || !iid)
+        return E_POINTER;
+    *out = NULL;
+
+    EnterCriticalSection(&builder->cs);
+    if ((navigator = builder->navigator))
+        IBaseFilter_AddRef(navigator);
+    if ((graph = builder->graph))
+        IGraphBuilder_AddRef(graph);
+    LeaveCriticalSection(&builder->cs);
+
+    /* the DVD volume has to have been rendered first */
+    if (!navigator)
+    {
+        if (graph)
+            IGraphBuilder_Release(graph);
+        return VFW_E_DVD_GRAPHNOTREADY;
+    }
+
+    /* the navigator's own interfaces first, then the graph's (IMediaControl, IVideoWindow ...) */
+    hr = IBaseFilter_QueryInterface(navigator, iid, out);
+    if (FAILED(hr) && graph)
+        hr = IGraphBuilder_QueryInterface(graph, iid, out);
+    IBaseFilter_Release(navigator);
+    if (graph)
+        IGraphBuilder_Release(graph);
+    return hr;
 }
 
 static HRESULT WINAPI graph_builder_RenderDvdVideoVolume(IDvdGraphBuilder *iface, const WCHAR *path, DWORD flags, AM_DVD_RENDERSTATUS *status)
 {
-    FIXME("iface %p, path %s, flags %#lx, status %p, stub!\n", iface, debugstr_w(path), flags, status);
-    return E_NOTIMPL;
+    struct graph_builder *builder = impl_from_IDvdGraphBuilder(iface);
+    IBaseFilter *navigator = NULL;
+    IDvdControl2 *control;
+    IGraphBuilder *graph;
+    HRESULT hr;
+
+    TRACE("iface %p, path %s, flags %#lx, status %p.\n", iface, debugstr_w(path), flags, status);
+
+    if (!status)
+        return E_POINTER;
+    memset(status, 0, sizeof(*status));
+
+#ifndef SG_MUTANT_BUILDER
+    if ((flags & ~DVD_RENDER_KNOWN_FLAGS) || ((flags & DVD_RENDER_DECODER_FLAGS) & ((flags & DVD_RENDER_DECODER_FLAGS) - 1)))
+        return E_INVALIDARG;
+#endif
+
+    if (FAILED(hr = builder_get_graph(builder, &graph)))
+        return hr;
+
+    /* There is no DVD drive to default to, so without a path no volume is known. */
+    if (!path)
+    {
+        status->bDvdVolUnknown = TRUE;
+        IGraphBuilder_Release(graph);
+        return VFW_E_DVD_RENDERFAIL;
+    }
+
+    EnterCriticalSection(&builder->cs);
+    if (builder->navigator)
+    {
+        navigator = builder->navigator;
+        IBaseFilter_AddRef(navigator);
+    }
+    LeaveCriticalSection(&builder->cs);
+
+    if (!navigator && FAILED(hr = CoCreateInstance(&CLSID_DVDNavigator, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IBaseFilter, (void **)&navigator)))
+    {
+        IGraphBuilder_Release(graph);
+        return hr;
+    }
+
+    hr = IBaseFilter_QueryInterface(navigator, &IID_IDvdControl2, (void **)&control);
+    if (SUCCEEDED(hr))
+    {
+        hr = IDvdControl2_SetDVDDirectory(control, path);
+        IDvdControl2_Release(control);
+    }
+    if (FAILED(hr))
+    {
+        /* not a DVD volume: nothing was built */
+        status->bDvdVolInvalid = (hr == VFW_E_DVD_INVALID_DISC);
+        IBaseFilter_Release(navigator);
+        IGraphBuilder_Release(graph);
+        return VFW_E_DVD_RENDERFAIL;
+    }
+
+    EnterCriticalSection(&builder->cs);
+    if (!builder->navigator)
+    {
+        if (SUCCEEDED(hr = IGraphBuilder_AddFilter(graph, navigator, L"DVD Navigator")))
+        {
+            builder->navigator = navigator;
+            IBaseFilter_AddRef(navigator);
+        }
+    }
+    LeaveCriticalSection(&builder->cs);
+    IBaseFilter_Release(navigator);
+    IGraphBuilder_Release(graph);
+    if (FAILED(hr))
+        return hr;
+
+    /* The navigator has no output pins and no decoders exist to connect to:
+     * the video, audio and sub-picture streams could not be rendered. */
+    status->iNumStreams = 3;
+    status->iNumStreamsFailed = 3;
+    status->dwFailedStreamsFlag = AM_DVD_STREAM_VIDEO | AM_DVD_STREAM_AUDIO | AM_DVD_STREAM_SUBPIC;
+    return VFW_E_DVD_RENDERFAIL;
 }
 
 static const struct IDvdGraphBuilderVtbl graph_builder_vtbl =
@@ -143,6 +291,7 @@ HRESULT graph_builder_create(IUnknown *outer, IUnknown **out)
     builder->IDvdGraphBuilder_iface.lpVtbl = &graph_builder_vtbl;
