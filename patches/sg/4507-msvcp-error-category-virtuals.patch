From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcp: error_category default_error_condition and equivalent.

The default virtuals of the generic, iostream and system error categories
were FIXME stubs: default_error_condition returned NULL without filling the
result, both equivalent() returned false, so every comparison of an
error_code from these categories with an error_condition (e.g. with an
errc value) was false. They now follow [syserr.errcat.virtuals]: a value
means the condition (value, this category); equivalent(value, cond)
compares cond with that, equivalent(code, value) checks the code's category
and value. msvcp140's system category maps Windows errors that have an
errno equivalent (_Winerror_map) to generic conditions, so
ERROR_ACCESS_DENIED compares equal to errc::permission_denied.
---
 dlls/msvcp90/misc.c | 65 ++++++++++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 59 insertions(+), 6 deletions(-)

diff --git a/dlls/msvcp90/misc.c b/dlls/msvcp90/misc.c
index f670e95..2b8c99c 100644
--- a/dlls/msvcp90/misc.c
+++ b/dlls/msvcp90/misc.c
@@ -1057,28 +1057,48 @@ custom_category* __thiscall custom_category_vector_dtor(custom_category *this, u
     return this;
 }
 
+/* error_condition has the layout of error_code: a value and a category */
+#define call_error_category_default_error_condition(this, ret, code) CALL_VTBL_FUNC(this, 12, \
+        error_code*, (const error_category*, error_code*, int), (this, ret, code))
+
+/* The defaults of error_category ([syserr.errcat.virtuals]): a value of this
+ * category means the condition (value, this category); equivalent() compares
+ * with that condition, or with the code's own value and category. */
 DEFINE_THISCALL_WRAPPER(custom_category_default_error_condition, 12)
 /*error_condition*/void* __thiscall custom_category_default_error_condition(
         custom_category *this, /*error_condition*/void *ret, int code)
 {
-    FIXME("(%p %p %x) stub\n", this, ret, code);
-    return NULL;
+    error_code *cond = ret;
+
+    TRACE("(%p %p %d)\n", this, ret, code);
+
+    cond->code = code;
+    cond->category = &this->base;
+    return ret;
 }
 
 DEFINE_THISCALL_WRAPPER(custom_category_equivalent, 12)
 bool __thiscall custom_category_equivalent(const custom_category *this,
         int code, const /*error_condition*/void *condition)
 {
-    FIXME("(%p %x %p) stub\n", this, code, condition);
-    return FALSE;
+    const error_code *cond = condition;
+    error_code def;
+
+    TRACE("(%p %d %p)\n", this, code, condition);
+
+    call_error_category_default_error_condition(&this->base, &def, code);
+#ifdef SG_MUTANT_ERRCAT_EQUIV_VALUE_ONLY
+    return def.code == cond->code;
+#endif
+    return def.code == cond->code && def.category == cond->category;
 }
 
 DEFINE_THISCALL_WRAPPER(custom_category_equivalent_code, 12)
 bool __thiscall custom_category_equivalent_code(custom_category *this,
         const error_code *code, int condition)
 {
-    FIXME("(%p %p %x) stub\n", this, code, condition);
-    return FALSE;
+    TRACE("(%p %p %d)\n", this, code, condition);
+    return code->category == &this->base && code->code == condition;
 }
 
 DEFINE_THISCALL_WRAPPER(custom_category_message, 12)
@@ -1152,6 +1172,35 @@ basic_string_char* __thiscall system_category_message(const custom_category *thi
 #endif
 }
 
+#if _MSVCP_VER > 100
+int __cdecl _Winerror_map(int);
+
+/* A Windows error with an errno equivalent means that generic condition
+ * (ERROR_FILE_NOT_FOUND is errc::no_such_file_or_directory); the others stay
+ * system conditions. */
+DEFINE_THISCALL_WRAPPER(system_category_default_error_condition, 12)
+/*error_condition*/void* __thiscall system_category_default_error_condition(
+        custom_category *this, /*error_condition*/void *ret, int err)
+{
+    error_code *cond = ret;
+    int errnum = _Winerror_map(err);
+
+    TRACE("(%p %p %d)\n", this, ret, err);
+
+    if (errnum)
+    {
+        cond->code = errnum;
+        cond->category = std_generic_category();
+    }
+    else
+    {
+        cond->code = err;
+        cond->category = &this->base;
+    }
+    return ret;
+}
+#endif
+
 /* ?system_category@std@@YAABVerror_category@1@XZ */
 /* ?system_category@std@@YAAEBVerror_category@1@XZ */
 const error_category* __cdecl std_system_category(void)
@@ -1771,7 +1820,11 @@ __ASM_BLOCK_BEGIN(misc_vtables)
             VTABLE_ADD_FUNC(custom_category_vector_dtor)
             VTABLE_ADD_FUNC(system_category_name)
             VTABLE_ADD_FUNC(system_category_message)
+#if _MSVCP_VER > 100
+            VTABLE_ADD_FUNC(system_category_default_error_condition)
+#else
             VTABLE_ADD_FUNC(custom_category_default_error_condition)
+#endif
             VTABLE_ADD_FUNC(custom_category_equivalent)
             VTABLE_ADD_FUNC(custom_category_equivalent_code));
 #endif
