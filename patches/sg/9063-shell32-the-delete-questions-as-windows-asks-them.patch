From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: the delete questions as Windows asks them

Deleting asked Wine's "Are you sure that you want to send '%1' to the
Recycle Bin?" under "Confirm file deletion". As Windows 10 asks:
- Delete File / Delete Folder / Delete Multiple Items (captions);
- "Are you sure you want to move this file to the Recycle Bin?", "... this
  folder ...", "... these N items ..."; with Shift (or no bin) "Are you
  sure you want to permanently delete this file?" / "this folder?" / "these
  N items?";
- an item that can't go to the bin, or is bigger than it: "This item can't
  be moved to the Recycle Bin." / "This file is too big to recycle." --
  "Do you want to permanently delete it?"
The item's path stays under the question (Windows shows the item's name and
details there), as the bin's own Empty question (9065) does.

diff -ru a/dlls/shell32/shell32.rc b/dlls/shell32/shell32.rc
--- a/dlls/shell32/shell32.rc	2026-11-27 18:30:32.346258834 -0800
+++ b/dlls/shell32/shell32.rc	2026-11-27 18:30:32.370258666 -0800
@@ -169,17 +169,19 @@
 
 	IDS_CREATEFOLDER_DENIED "Unable to create new Folder: Permission denied."
 	IDS_CREATEFOLDER_CAPTION "Error during creation of a new folder"
-	IDS_DELETEITEM_CAPTION "Confirm file deletion"
-	IDS_DELETEFOLDER_CAPTION "Confirm folder deletion"
-	IDS_DELETEITEM_TEXT "Are you sure you want to delete '%1'?"
-	IDS_DELETEMULTIPLE_TEXT "Are you sure you want to delete these %1 items?"
-	IDS_DELETESELECTED_TEXT "Are you sure you want to delete the selected item(s)?"
-	IDS_TRASHITEM_TEXT "Are you sure that you want to send '%1' to the Recycle Bin?"
-	IDS_TRASHFOLDER_TEXT "Are you sure that you want to send '%1' and all its content to the Recycle Bin?"
-	IDS_TRASHMULTIPLE_TEXT "Are you sure that you want to send these %1 items to the Recycle Bin?"
-	IDS_CANTTRASH_TEXT "The item '%1' can't be sent to the Recycle Bin. Do you want to delete it instead?"
+	IDS_DELETEITEM_CAPTION "Delete File"
+	IDS_DELETEFOLDER_CAPTION "Delete Folder"
+	IDS_DELETEMULTIPLE_CAPTION "Delete Multiple Items"
+	IDS_DELETEITEM_TEXT "Are you sure you want to permanently delete this file?\n\n%1"
+	IDS_DELETEFOLDER_TEXT "Are you sure you want to permanently delete this folder?\n\n%1"
+	IDS_DELETEMULTIPLE_TEXT "Are you sure you want to permanently delete these %1 items?"
+	IDS_DELETESELECTED_TEXT "Are you sure you want to permanently delete the selected items?"
+	IDS_TRASHITEM_TEXT "Are you sure you want to move this file to the Recycle Bin?\n\n%1"
+	IDS_TRASHFOLDER_TEXT "Are you sure you want to move this folder to the Recycle Bin?\n\n%1"
+	IDS_TRASHMULTIPLE_TEXT "Are you sure you want to move these %1 items to the Recycle Bin?"
+	IDS_CANTTRASH_TEXT "This item can't be moved to the Recycle Bin. Do you want to permanently delete it?\n\n%1"
 	IDS_TOOBIG_CAPTION "File Too Large for Recycle Bin"
-	IDS_TOOBIG_TEXT "'%1' is too big to recycle. Do you want to permanently delete it?"
+	IDS_TOOBIG_TEXT "This file is too big to recycle. Do you want to permanently delete it?\n\n%1"
 	IDS_OVERWRITEFILE_TEXT "This folder already contains a file called '%1'.\n\nDo you want to replace it?"
 	IDS_OVERWRITEFILE_CAPTION "Confirm file overwrite"
 	IDS_OVERWRITEFOLDER_TEXT "This folder already contains a folder named '%1'.\n\
diff -ru a/dlls/shell32/shlfileop.c b/dlls/shell32/shlfileop.c
--- a/dlls/shell32/shlfileop.c	2026-11-27 18:30:32.350258807 -0800
+++ b/dlls/shell32/shlfileop.c	2026-11-27 18:30:32.370258666 -0800
@@ -222,11 +222,11 @@
 	  case ASK_DELETE_FOLDER:
             ids->icon_resource_id = IDI_SHELL_CONFIRM_DELETE;
 	    ids->caption_resource_id  = IDS_DELETEFOLDER_CAPTION;
-	    ids->text_resource_id  = IDS_DELETEITEM_TEXT;
+	    ids->text_resource_id  = IDS_DELETEFOLDER_TEXT;
 	    return TRUE;
 	  case ASK_DELETE_MULTIPLE_ITEM:
             ids->icon_resource_id = IDI_SHELL_CONFIRM_DELETE;
-	    ids->caption_resource_id  = IDS_DELETEITEM_CAPTION;
+	    ids->caption_resource_id  = IDS_DELETEMULTIPLE_CAPTION;
 	    ids->text_resource_id  = IDS_DELETEMULTIPLE_TEXT;
 	    return TRUE;
           case ASK_TRASH_FILE:
@@ -241,7 +241,7 @@
             return TRUE;
           case ASK_TRASH_MULTIPLE_ITEM:
             ids->icon_resource_id = IDI_SHELL_TRASH_FILE;
-            ids->caption_resource_id = IDS_DELETEITEM_CAPTION;
+            ids->caption_resource_id = IDS_DELETEMULTIPLE_CAPTION;
             ids->text_resource_id = IDS_TRASHMULTIPLE_TEXT;
             return TRUE;
           case ASK_CANT_TRASH_ITEM:
@@ -256,7 +256,7 @@
             return TRUE;
 	  case ASK_DELETE_SELECTED:
             ids->icon_resource_id = IDI_SHELL_CONFIRM_DELETE;
-            ids->caption_resource_id  = IDS_DELETEITEM_CAPTION;
+            ids->caption_resource_id  = IDS_DELETEMULTIPLE_CAPTION;
             ids->text_resource_id  = IDS_DELETESELECTED_TEXT;
             return TRUE;
 	  case ASK_OVERWRITE_FILE:
diff -ru a/dlls/shell32/shresdef.h b/dlls/shell32/shresdef.h
--- a/dlls/shell32/shresdef.h	2026-11-27 18:30:32.346258834 -0800
+++ b/dlls/shell32/shresdef.h	2026-11-27 18:30:32.370258666 -0800
@@ -117,6 +117,8 @@
 #define IDS_OVERWRITEFOLDER_TEXT    141
 #define IDS_TOOBIG_CAPTION          19075  /* Stained Glass OS */
 #define IDS_TOOBIG_TEXT             19076
+#define IDS_DELETEMULTIPLE_CAPTION  19077  /* Stained Glass OS: Windows' delete questions */
+#define IDS_DELETEFOLDER_TEXT       19078
 
 #define IDS_NEWFOLDER 142
 /* Stained Glass OS: New > Text Document in a folder's background menu */
