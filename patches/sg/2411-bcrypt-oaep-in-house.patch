@@ -1515,7 +1516,18 @@ static SECURITY_STATUS unwrap_key_for_transport(NCRYPT_KEY_HANDLE decrypt_key, c
 
     if ((ret = crypt_data(decrypt_key, (BYTE *)wrapped_key, hdr->wrapped_key_len, &oaep, aes_secret,
                           sizeof(aes_secret), &secret_len, BCRYPT_PAD_OAEP, FALSE)))
