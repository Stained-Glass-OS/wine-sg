+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * The archive's entries and the block map's files were looked up by name with a linear search,
+ * once per file and for every check: a package of 32823 files (Nexusbird Motion, 194 MB) spent
+ * more than ten minutes in AddPackageAsync before writing its first file, and JASP (1.3 GB) more
+ * than fifteen. Names compare as part names do (case-insensitively, '/' and '\\' alike).
+ */
+
+#include <stdlib.h>
+#include <wctype.h>
+#include "private.h"
+
+static WCHAR fold( WCHAR c )
+{
+    return c == '/' ? '\\' : towlower( c );
+}
+
+static unsigned int name_hash( const WCHAR *name )
+{
+    unsigned int h = 2166136261u;
+    for (; *name; name++) h = (h ^ fold( *name )) * 16777619u;
+    return h;
+}
+
+BOOL part_names_equal( const WCHAR *a, const WCHAR *b )
+{
+    for (;; a++, b++)
+    {
+        WCHAR ca = fold( *a ), cb = fold( *b );
+        if (ca != cb) return FALSE;
+        if (!ca) return TRUE;
+    }
+}
+
+HRESULT name_index_init( struct name_index *index, unsigned int count )
+{
+    unsigned int size = 16;
+
+    while (size < count * 2 && size < 0x40000000) size *= 2;
+    index->mask = size - 1;
+    if (!(index->slots = calloc( size, sizeof(*index->slots) ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+void name_index_free( struct name_index *index )
+{
+    free( index->slots );
+    index->slots = NULL;
+}
+
+/* adds NAME as item ITEM; the item already there under that name, or ~0u when it was added */
+unsigned int name_index_add( struct name_index *index, const WCHAR *name, unsigned int item )
+{
+    unsigned int i = name_hash( name ) & index->mask;
+
+    for (; index->slots[i].name; i = (i + 1) & index->mask)
+        if (part_names_equal( index->slots[i].name, name )) return index->slots[i].item;
+    index->slots[i].name = name;
+    index->slots[i].item = item;
+    return ~0u;
+}
+
+unsigned int name_index_find( const struct name_index *index, const WCHAR *name )
+{
+    unsigned int i;
+
+    if (!index->slots) return ~0u;
+    for (i = name_hash( name ) & index->mask; index->slots[i].name; i = (i + 1) & index->mask)
+        if (part_names_equal( index->slots[i].name, name )) return index->slots[i].item;
+    return ~0u;
+}
