+/* Stained Glass OS: part names hashed (nameindex.c) */
+struct name_index
+{
+    unsigned int mask;
+    struct { const WCHAR *name; unsigned int item; } *slots;
+};
+HRESULT name_index_init( struct name_index *index, unsigned int count );
+void name_index_free( struct name_index *index );
+unsigned int name_index_add( struct name_index *index, const WCHAR *name, unsigned int item );
+unsigned int name_index_find( const struct name_index *index, const WCHAR *name );
+BOOL part_names_equal( const WCHAR *a, const WCHAR *b );
+
 struct zip_archive
 {
+    struct name_index names;
     IStream *stream;
     CRITICAL_SECTION cs;  /* the stream's position is shared */
     UINT64 stream_size;
--- /dev/null
+++ b/dlls/appxpackaging/nameindex.c
@@ -0,0 +1,90 @@
+/*
+ * Stained Glass OS 7718: a package's part names, hashed
+ *
