     zip->cs.DebugInfo->Spare[0] = 0;
     DeleteCriticalSection( &zip->cs );
@@ -249,6 +250,10 @@
         pos += 46 + (UINT64)name_len + extra_len + comment_len;
     }
     free( cd );
+#ifndef SG_MUTANT_APPX_LINEAR_NAMES
+    if (FAILED(hr = name_index_init( &zip->names, zip->count ))) goto fail;
+    for (i = 0; i < zip->count; i++) name_index_add( &zip->names, zip->entries[i].name, i );  /* the first of a name counts */
+#endif
     TRACE( "%u entries\n", zip->count );
     *out = zip;
     return S_OK;
@@ -262,17 +267,15 @@
 const struct zip_entry *zip_find( const struct zip_archive *zip, const WCHAR *name )
 {
     unsigned int i;
-    for (i = 0; i < zip->count; i++)
+
+    /* part names compare case-insensitively (OPC); '/' and '\\' alike */
+    if (zip->names.slots)
     {
-        const WCHAR *a = zip->entries[i].name, *b = name;
-        /* part names compare case-insensitively (OPC); '/' and '\\' alike */
-        for (;; a++, b++)
-        {
-            WCHAR ca = *a == '/' ? '\\' : towlower( *a ), cb = *b == '/' ? '\\' : towlower( *b );
-            if (ca != cb) break;
-            if (!ca) return &zip->entries[i];
-        }
+        i = name_index_find( &zip->names, name );
+        return i == ~0u ? NULL : &zip->entries[i];
     }
+    for (i = 0; i < zip->count; i++)
+        if (part_names_equal( zip->entries[i].name, name )) return &zip->entries[i];
     return NULL;
 }
 
