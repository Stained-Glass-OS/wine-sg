 static HRESULT WINAPI connection_get_Errors( _Connection *iface, Errors **obj )
 {
-    FIXME( "%p, %p\n", iface, obj );
-    return E_NOTIMPL;
+    struct connection *connection = impl_from_Connection( iface );
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", iface, obj );
