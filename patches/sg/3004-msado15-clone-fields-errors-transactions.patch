+static HRESULT connection_get_transaction( struct connection *connection, ITransactionLocal **local )
+{
+    *local = NULL;
+    if (!connection->session) return MAKE_ADO_HRESULT( adErrFeatureNotAvailable );
+    if (FAILED(IUnknown_QueryInterface( connection->session, &IID_ITransactionLocal, (void **)local )))
+        return MAKE_ADO_HRESULT( adErrFeatureNotAvailable );
+    return S_OK;
+}
+
 static HRESULT WINAPI connection_BeginTrans( _Connection *iface, LONG *transaction_level )
 {
     struct connection *connection = impl_from_Connection( iface );
-    FIXME( "%p, %p\n", iface, transaction_level );
+    ITransactionLocal *local;
+    ULONG level = 0;
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", iface, transaction_level );
+
     if (connection->state == adStateClosed) return MAKE_ADO_HRESULT( adErrObjectClosed );
-    return E_NOTIMPL;
+    if (FAILED(hr = connection_get_transaction( connection, &local ))) return hr;
+
+    hr = ITransactionLocal_StartTransaction( local, connection->isolation, 0, NULL, &level );
+    ITransactionLocal_Release( local );
+    if (FAILED(hr)) return hr;
+
+    if (transaction_level) *transaction_level = level;
+    return S_OK;
 }
 
 static HRESULT WINAPI connection_CommitTrans( _Connection *iface )
 {
     struct connection *connection = impl_from_Connection( iface );
-    FIXME( "%p\n", iface );
+    ITransactionLocal *local;
+    HRESULT hr;
+
+    TRACE( "%p\n", iface );
+
     if (connection->state == adStateClosed) return MAKE_ADO_HRESULT( adErrObjectClosed );
-    return E_NOTIMPL;
+    if (FAILED(hr = connection_get_transaction( connection, &local ))) return hr;
+
+    hr = ITransactionLocal_Commit( local, FALSE, 0, 0 );
+    ITransactionLocal_Release( local );
+    return hr;
 }
 
 static HRESULT WINAPI connection_RollbackTrans( _Connection *iface )
 {
     struct connection *connection = impl_from_Connection( iface );
-    FIXME( "%p\n", iface );
+    ITransactionLocal *local;
+    HRESULT hr;
+
+    TRACE( "%p\n", iface );
+
     if (connection->state == adStateClosed) return MAKE_ADO_HRESULT( adErrObjectClosed );
-    return E_NOTIMPL;
+    if (FAILED(hr = connection_get_transaction( connection, &local ))) return hr;
+
+    hr = ITransactionLocal_Abort( local, NULL, FALSE, FALSE );
+    ITransactionLocal_Release( local );
+    return hr;
 }
 
