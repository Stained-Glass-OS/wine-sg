+
+typedef struct
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG refs;
+    struct fields *fields;
+    ULONG pos;
+} fields_enum;
+
+static inline fields_enum *impl_from_fields_enum( IEnumVARIANT *iface )
+{
+    return CONTAINING_RECORD( iface, fields_enum, IEnumVARIANT_iface );
+}
+
+static HRESULT WINAPI fields_enum_QueryInterface( IEnumVARIANT *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IEnumVARIANT ))
+    {
+        *obj = iface;
+        IEnumVARIANT_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI fields_enum_AddRef( IEnumVARIANT *iface )
+{
+    return InterlockedIncrement( &impl_from_fields_enum( iface )->refs );
+}
+
+static ULONG WINAPI fields_enum_Release( IEnumVARIANT *iface )
+{
+    fields_enum *This = impl_from_fields_enum( iface );
+    LONG refs = InterlockedDecrement( &This->refs );
+
+    if (!refs)
+    {
+        Fields_Release( &This->fields->Fields_iface );
+        free( This );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI fields_enum_Next( IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched )
+{
+    fields_enum *This = impl_from_fields_enum( iface );
+    ULONG n = 0;
+
+    if (fetched) *fetched = 0;
+    if (celt && !var) return E_INVALIDARG;
+
+    while (n < celt && This->pos < This->fields->count)
+    {
+        Field *field = This->fields->field[This->pos++];
+
+        V_VT(&var[n]) = VT_DISPATCH;
+        V_DISPATCH(&var[n]) = (IDispatch *)field;
+        Field_AddRef( field );
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI fields_enum_Skip( IEnumVARIANT *iface, ULONG celt )
+{
+    fields_enum *This = impl_from_fields_enum( iface );
+
+    if (celt > This->fields->count - This->pos)
+    {
+        This->pos = This->fields->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI fields_enum_Reset( IEnumVARIANT *iface )
+{
+    impl_from_fields_enum( iface )->pos = 0;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl fields_enum_vtbl;
+
+static HRESULT create_fields_enum( struct fields *fields, ULONG pos, IEnumVARIANT **out )
+{
+    fields_enum *This;
+
+    if (!(This = calloc( 1, sizeof(*This) ))) return E_OUTOFMEMORY;
+    This->IEnumVARIANT_iface.lpVtbl = &fields_enum_vtbl;
+    This->refs = 1;
+    This->fields = fields;
+    This->pos = pos;
+    Fields_AddRef( &fields->Fields_iface );
+    *out = &This->IEnumVARIANT_iface;
+    return S_OK;
+}
+
