 }
 
+static HRESULT WINAPI field_get_Value( Field *iface, VARIANT *val );
+
 static HRESULT WINAPI field_get_ActualSize( Field *iface, ADO_LONGPTR *size )
 {
     struct field *field = impl_from_Field( iface );
-    FIXME( "%p, %p\n", field, size );
-    *size = 0;
+    VARIANT value;
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", field, size );
+
+    if (field->recordset->state == adStateClosed) return MAKE_ADO_HRESULT( adErrObjectClosed );
+    if (field->recordset->index < 0 || field->recordset->index >= field->recordset->count)
+        return MAKE_ADO_HRESULT( adErrNoCurrentRecord );
+
+    VariantInit( &value );
+    if (FAILED(hr = field_get_Value( iface, &value ))) return hr;
+
+    /* fixed size types have the size of the type, whatever the variant holding the value */
+    switch (field->type)
+    {
+    case adTinyInt: case adUnsignedTinyInt: *size = 1; goto done;
+    case adSmallInt: case adUnsignedSmallInt: case adBoolean: *size = 2; goto done;
+    case adInteger: case adUnsignedInt: case adSingle: case adError: *size = 4; goto done;
+    case adBigInt: case adUnsignedBigInt: case adDouble: case adCurrency: case adDate: case adFileTime: *size = 8; goto done;
+    case adGUID: case adDecimal: case adNumeric: case adVarNumeric: *size = 16; goto done;
+    default: break;
+    }
+
+    /* characters for text, bytes for binary data, the size of the type for the rest */
+    switch (V_VT(&value))
+    {
+    case VT_NULL:
+    case VT_EMPTY:
+        *size = 0;
+        break;
+    case VT_BSTR:
+        *size = SysStringLen( V_BSTR(&value) );
+        break;
+    case VT_ARRAY | VT_UI1:
+    {
+        LONG lb = 0, ub = -1;
+        SafeArrayGetLBound( V_ARRAY(&value), 1, &lb );
+        SafeArrayGetUBound( V_ARRAY(&value), 1, &ub );
+        *size = ub - lb + 1;
+        break;
+    }
+    case VT_I1: case VT_UI1: *size = 1; break;
+    case VT_I2: case VT_UI2: case VT_BOOL: *size = 2; break;
+    case VT_I4: case VT_UI4: case VT_R4: case VT_ERROR: *size = 4; break;
+    case VT_I8: case VT_UI8: case VT_R8: case VT_CY: case VT_DATE: *size = 8; break;
+    case VT_DECIMAL: *size = 16; break;
+    default: *size = field->defined_size; break;
+    }
+
+done:
+    VariantClear( &value );
     return S_OK;
 }
 
