+/* The provider errors of a connection. Nothing here reports provider errors yet, so the
+ * collection is always empty; it still has to exist, scripts count it after every call. */
+struct errors
+{
+    Errors Errors_iface;
+    LONG refs;
+};
+
+static inline struct errors *impl_from_Errors( Errors *iface )
+{
+    return CONTAINING_RECORD( iface, struct errors, Errors_iface );
+}
+
+static HRESULT WINAPI errors_QueryInterface( Errors *iface, REFIID riid, void **obj )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_Errors ) || IsEqualGUID( riid, &IID__Collection ) ||
+        IsEqualGUID( riid, &IID_IDispatch ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        Errors_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI errors_AddRef( Errors *iface )
+{
+    return InterlockedIncrement( &impl_from_Errors( iface )->refs );
+}
+
+static ULONG WINAPI errors_Release( Errors *iface )
+{
+    struct errors *errors = impl_from_Errors( iface );
+    LONG refs = InterlockedDecrement( &errors->refs );
+
+    if (!refs) free( errors );
+    return refs;
+}
+
+static HRESULT WINAPI errors_GetTypeInfoCount( Errors *iface, UINT *count )
+{
+    TRACE( "%p, %p\n", iface, count );
+
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI errors_GetTypeInfo( Errors *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    TRACE( "%p, %u, %lu, %p\n", iface, index, lcid, info );
+
+    return get_typeinfo( Errors_tid, info );
+}
+
+static HRESULT WINAPI errors_GetIDsOfNames( Errors *iface, REFIID riid, LPOLESTR *names, UINT count, LCID lcid,
+                                            DISPID *dispid )
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    TRACE( "%p, %s, %p, %u, %lu, %p\n", iface, debugstr_guid(riid), names, count, lcid, dispid );
+
+    if (SUCCEEDED(hr = get_typeinfo( Errors_tid, &info )))
+    {
+        hr = ITypeInfo_GetIDsOfNames( info, names, count, dispid );
+        ITypeInfo_Release( info );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI errors_Invoke( Errors *iface, DISPID member, REFIID riid, LCID lcid, WORD flags,
+                                     DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    TRACE( "%p, %ld, %s, %ld, %d, %p, %p, %p, %p\n", iface, member, debugstr_guid(riid), lcid, flags, params,
+           result, excep, arg_err );
+
+    if (SUCCEEDED(hr = get_typeinfo( Errors_tid, &info )))
+    {
+        hr = ITypeInfo_Invoke( info, iface, member, flags, params, result, excep, arg_err );
+        ITypeInfo_Release( info );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI errors_get_Count( Errors *iface, LONG *count )
+{
+    TRACE( "%p, %p\n", iface, count );
+
+    if (!count) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    *count = 0;
+    return S_OK;
+}
+
+/* an enumerator that has nothing to enumerate */
+static HRESULT WINAPI empty_enum_QueryInterface( IEnumVARIANT *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IEnumVARIANT ))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI empty_enum_AddRef( IEnumVARIANT *iface ) { return 2; }
+static ULONG WINAPI empty_enum_Release( IEnumVARIANT *iface ) { return 1; }
+
+static HRESULT WINAPI empty_enum_Next( IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched )
+{
+    if (fetched) *fetched = 0;
+    return celt ? S_FALSE : S_OK;
+}
+
+static HRESULT WINAPI empty_enum_Skip( IEnumVARIANT *iface, ULONG celt ) { return celt ? S_FALSE : S_OK; }
+static HRESULT WINAPI empty_enum_Reset( IEnumVARIANT *iface ) { return S_OK; }
+
+static HRESULT WINAPI empty_enum_Clone( IEnumVARIANT *iface, IEnumVARIANT **ret )
+{
+    *ret = iface;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl empty_enum_vtbl =
+{
+    empty_enum_QueryInterface,
+    empty_enum_AddRef,
+    empty_enum_Release,
+    empty_enum_Next,
+    empty_enum_Skip,
+    empty_enum_Reset,
+    empty_enum_Clone,
+};
+
+static IEnumVARIANT empty_enum = { &empty_enum_vtbl };
+
+static HRESULT WINAPI errors__NewEnum( Errors *iface, IUnknown **obj )
+{
+    TRACE( "%p, %p\n", iface, obj );
+
+    if (!obj) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    *obj = (IUnknown *)&empty_enum;
+    return S_OK;
+}
+
+static HRESULT WINAPI errors_Refresh( Errors *iface )
+{
+    TRACE( "%p\n", iface );
+
+    return S_OK;
+}
+
+static HRESULT WINAPI errors_get_Item( Errors *iface, VARIANT index, Error **obj )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_variant(&index), obj );
+
+    if (!obj) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    *obj = NULL;
+    return MAKE_ADO_HRESULT( adErrItemNotFound );
+}
+
+static HRESULT WINAPI errors_Clear( Errors *iface )
+{
+    TRACE( "%p\n", iface );
+
+    return S_OK;
+}
+
+static const struct ErrorsVtbl errors_vtbl =
+{
+    errors_QueryInterface,
+    errors_AddRef,
+    errors_Release,
+    errors_GetTypeInfoCount,
+    errors_GetTypeInfo,
+    errors_GetIDsOfNames,
+    errors_Invoke,
+    errors_get_Count,
+    errors__NewEnum,
+    errors_Refresh,
+    errors_get_Item,
+    errors_Clear,
+};
+
+HRESULT Errors_create( Errors **obj )
+{
+    struct errors *errors;
+
+    if (!(errors = calloc( 1, sizeof(*errors) ))) return E_OUTOFMEMORY;
+    errors->Errors_iface.lpVtbl = &errors_vtbl;
+    errors->refs = 1;
+    *obj = &errors->Errors_iface;
+    return S_OK;
+}
