diff --git a/dlls/cfgmgr32/swdevice.c b/dlls/cfgmgr32/swdevice.c
new file mode 100644
index 0000000..ea5c094
--- /dev/null
+++ b/dlls/cfgmgr32/swdevice.c
@@ -0,0 +1,77 @@
+/*
+ * Software devices and device object queries (wine-sg 6266)
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * SwDeviceCreate (swdevice.h) enumerates a software device through PnP for the driver its program
+ * installed, and DevCreateObjectQuery (devquery.h) watches devices appear. Kernel drivers of that kind
+ * (Wintun's network adapter) are not run here, so a software device is not made: the calls fail as
+ * a system without the device class would, and the program goes on (it reported that it could not
+ * make its adapter; it was ended by a delay load that found no SwDeviceCreate).
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(setupapi);
+
+/***********************************************************************
+ *           SwDeviceCreate (cfgmgr32.@)
+ */
+HRESULT WINAPI SwDeviceCreate( const WCHAR *enumerator, const WCHAR *parent, const void *info, ULONG count,
+                               const void *properties, void *callback, void *context, HANDLE *device )
+{
+    FIXME( "enumerator %s, parent %s, info %p, count %lu, properties %p, callback %p, context %p, device %p: "
+           "software devices are not made\n", debugstr_w( enumerator ), debugstr_w( parent ), info, count,
+           properties, callback, context, device );
+    if (device) *device = NULL;
+    return HRESULT_FROM_WIN32( ERROR_NOT_SUPPORTED );
+}
+
+/***********************************************************************
+ *           SwDeviceClose (cfgmgr32.@)
+ */
+void WINAPI SwDeviceClose( HANDLE device )
+{
+    TRACE( "device %p\n", device );
+}
+
+/***********************************************************************
+ *           DevCreateObjectQuery (cfgmgr32.@)
+ */
+HRESULT WINAPI DevCreateObjectQuery( int type, ULONG flags, ULONG prop_count, const void *props, ULONG filter_count,
+                                     const void *filters, void *callback, void *context, HANDLE *query )
+{
+    FIXME( "type %d, flags %#lx, %lu properties, %lu filters, callback %p, context %p, query %p: no queries yet\n",
+           type, flags, prop_count, filter_count, callback, context, query );
+    if (query) *query = NULL;
+    return E_NOTIMPL;
+}
+
+/***********************************************************************
+ *           DevCloseObjectQuery (cfgmgr32.@)
+ */
+void WINAPI DevCloseObjectQuery( HANDLE query )
+{
+    TRACE( "query %p\n", query );
+}
