diff --git a/programs/services/services.c b/programs/services/services.c
index b053427..e17232c 100644
--- a/programs/services/services.c
+++ b/programs/services/services.c
@@ -1485,7 +1485,62 @@ static DWORD process_send_start_message(struct process_entry *process, BOOL shar
     return result;
 }
 
+static DWORD service_start_one(struct service_entry *service, DWORD service_argc, LPCWSTR *service_argv);
+
+/* the services it depends on (DependOnService), started first as Windows does: ERROR_SERVICE_DEPENDENCY_FAIL
+ * when one does not start (wine-sg 6266; Tailscale's service depends on Dnscache, iphlpsvc, netprofm and
+ * WinHttpAutoProxySvc) */
+static DWORD start_dependencies(struct service_entry *service, unsigned int depth)
+{
+    const WCHAR *name;
+    DWORD err;
+
+#ifdef SG_MUTANT_NO_DEPENDENCY_START
+    return ERROR_SUCCESS;
+#endif
+    if (!service->dependOnServices || depth > 16) return ERROR_SUCCESS;
+    for (name = service->dependOnServices; *name; name += lstrlenW(name) + 1)
+    {
+        struct service_entry *dep;
+
+        scmdatabase_lock(service->db);
+        if ((dep = scmdatabase_find_service(service->db, name))) grab_service(dep);
+        scmdatabase_unlock(service->db);
+        if (!dep)
+        {
+            WARN("%s depends on %s, which does not exist\n", debugstr_w(service->name), debugstr_w(name));
+            return ERROR_SERVICE_DEPENDENCY_DELETED;
+        }
+        err = ERROR_SUCCESS;
+        if (dep->status.dwCurrentState != SERVICE_RUNNING)
+        {
+            if (dep->config.dwStartType == SERVICE_DISABLED) err = ERROR_SERVICE_DISABLED;
+            else if (!(err = start_dependencies(dep, depth + 1)))
+            {
+                TRACE("starting %s for %s\n", debugstr_w(dep->name), debugstr_w(service->name));
+                err = service_start_one(dep, 0, NULL);
+                if (err == ERROR_SERVICE_ALREADY_RUNNING) err = ERROR_SUCCESS;
+            }
+        }
+        release_service(dep);
+        if (err)
+        {
+            WARN("dependency %s of %s did not start: %lu\n", debugstr_w(name), debugstr_w(service->name), err);
+            return ERROR_SERVICE_DEPENDENCY_FAIL;
+        }
+    }
+    return ERROR_SUCCESS;
+}
+
 DWORD service_start(struct service_entry *service, DWORD service_argc, LPCWSTR *service_argv)
+{
+    DWORD err;
+
+    if ((err = start_dependencies(service, 0))) return err;
+    return service_start_one(service, service_argc, service_argv);
+}
+
+static DWORD service_start_one(struct service_entry *service, DWORD service_argc, LPCWSTR *service_argv)
 {
     struct process_entry *process = NULL;
     BOOL shared_process;
