new file mode 100644
index 0000000..6cc0a28
--- /dev/null
+++ b/dlls/sgnetsvc/main.c
@@ -0,0 +1,104 @@
+/*
+ * Network services Windows has running (DNS Client, IP Helper, Network List Service,
+ * WinHTTP Web Proxy Auto-Discovery), hosted by svchost (wine-sg 6266)
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Programs depend on these services existing and running: an installer checks them (Tailscale's), a
+ * service names them as its dependencies, so the service manager starts them first. What they do on
+ * Windows is done here by other parts (dnsapi resolves through the host's resolver, iphlpapi and nsi
+ * answer from the host's interfaces, netprofm and winhttp in the programs' own processes): each one
+ * runs, answers its controls and stops when asked. DNS Client, as on Windows, does not stop.
+ */
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include "winsvc.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(sgnetsvc);
+
+struct netsvc
+{
+    const WCHAR *name;
+    DWORD accepted;             /* the controls it accepts */
+    SERVICE_STATUS_HANDLE handle;
+    HANDLE stop_event;
+};
+
+static struct netsvc services[] =
+{
+    { L"Dnscache", 0 },
+    { L"iphlpsvc", SERVICE_ACCEPT_STOP | SERVICE_ACCEPT_SHUTDOWN },
+    { L"netprofm", SERVICE_ACCEPT_STOP | SERVICE_ACCEPT_SHUTDOWN },
+    { L"WinHttpAutoProxySvc", SERVICE_ACCEPT_STOP | SERVICE_ACCEPT_SHUTDOWN },
+};
+
+static void report( struct netsvc *svc, DWORD state )
+{
+    SERVICE_STATUS status = { 0 };
+
+    status.dwServiceType = SERVICE_WIN32_SHARE_PROCESS;
+    status.dwCurrentState = state;
+    status.dwControlsAccepted = state == SERVICE_RUNNING ? svc->accepted : 0;
+    status.dwWaitHint = state == SERVICE_RUNNING || state == SERVICE_STOPPED ? 0 : 10000;
+    SetServiceStatus( svc->handle, &status );
+}
+
+static DWORD WINAPI handler( DWORD ctrl, DWORD type, void *data, void *context )
+{
+    struct netsvc *svc = context;
+
+    switch (ctrl)
+    {
+    case SERVICE_CONTROL_STOP:
+    case SERVICE_CONTROL_SHUTDOWN:
+        if (!(svc->accepted & SERVICE_ACCEPT_STOP)) return ERROR_CALL_NOT_IMPLEMENTED;
+        TRACE( "%s: stopping\n", debugstr_w( svc->name ) );
+        report( svc, SERVICE_STOP_PENDING );
+        SetEvent( svc->stop_event );
+        return NO_ERROR;
+    case SERVICE_CONTROL_INTERROGATE:
+        report( svc, SERVICE_RUNNING );
+        return NO_ERROR;
+    default:
+        return ERROR_CALL_NOT_IMPLEMENTED;
+    }
+}
+
+static void run( struct netsvc *svc )
+{
+    TRACE( "%s: starting\n", debugstr_w( svc->name ) );
+    svc->stop_event = CreateEventW( NULL, TRUE, FALSE, NULL );
+    if (!(svc->handle = RegisterServiceCtrlHandlerExW( svc->name, handler, svc ))) return;
+#ifdef SG_MUTANT_NETSVC_NOT_RUNNING
+    report( svc, SERVICE_STOPPED );
+    return;
+#endif
+    report( svc, SERVICE_RUNNING );
+    WaitForSingleObject( svc->stop_event, INFINITE );
+    report( svc, SERVICE_STOPPED );
+    CloseHandle( svc->stop_event );
+    TRACE( "%s: stopped\n", debugstr_w( svc->name ) );
+}
+
+void WINAPI DnscacheServiceMain( DWORD argc, WCHAR **argv ) { run( &services[0] ); }
+void WINAPI IphlpsvcServiceMain( DWORD argc, WCHAR **argv ) { run( &services[1] ); }
+void WINAPI NetprofmServiceMain( DWORD argc, WCHAR **argv ) { run( &services[2] ); }
+void WINAPI WinHttpAutoProxyServiceMain( DWORD argc, WCHAR **argv ) { run( &services[3] ); }
