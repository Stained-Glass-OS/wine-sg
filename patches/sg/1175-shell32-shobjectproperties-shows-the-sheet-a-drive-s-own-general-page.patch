+/* Stained Glass OS: the properties sheet of a file, a folder, a drive or
+ * several files (a double-NUL-terminated list), shown on a thread of its own
+ * as Windows does: the caller goes on (File Explorer's Properties for a
+ * drive in This PC, for search results and for the folder it shows did
+ * nothing at all). */
+struct object_properties
+{
+    HWND hwnd;
+    WCHAR *paths;           /* double-NUL-terminated */
+};
+
+static DWORD WINAPI object_properties_thread(void *arg)
+{
+    struct object_properties *op = arg;
+    LPITEMIDLIST *pidls = NULL, parent = NULL;
+    IShellFolder *desktop = NULL, *folder = NULL;
+    IContextMenu *menu = NULL;
+    const WCHAR *p;
+    UINT count = 0, i;
+    HRESULT hr;
+
+    OleInitialize(NULL);
+    for (p = op->paths; *p; p += lstrlenW(p) + 1) count++;
+    /* through their folder's menu, as the "properties" verb of a selection */
+    if (!count || !(pidls = calloc(count, sizeof(*pidls)))) goto done;
+    for (i = 0, p = op->paths; *p; p += lstrlenW(p) + 1, i++)
+        if (FAILED(SHParseDisplayName(p, NULL, &pidls[i], 0, NULL))) goto done;
+    if (!(parent = ILClone(pidls[0]))) goto done;
+    ILRemoveLastID(parent);
+    if (FAILED(SHGetDesktopFolder(&desktop))) goto done;
+    hr = _ILIsDesktop(parent) ? IShellFolder_QueryInterface(desktop, &IID_IShellFolder, (void **)&folder)
+                              : IShellFolder_BindToObject(desktop, parent, NULL, &IID_IShellFolder, (void **)&folder);
+    if (FAILED(hr)) goto done;
+    for (i = 0; i < count; i++)
+    {
+        LPITEMIDLIST last = ILClone(ILFindLastID(pidls[i]));
+        ILFree(pidls[i]);
+        pidls[i] = last;
+    }
+    if (SUCCEEDED(IShellFolder_GetUIObjectOf(folder, op->hwnd, count, (LPCITEMIDLIST *)pidls, &IID_IContextMenu,
+                                             NULL, (void **)&menu)))
+    {
+        CMINVOKECOMMANDINFO info = { sizeof(info) };
+
+        info.hwnd = op->hwnd;
+        info.lpVerb = "properties";
+        info.nShow = SW_SHOWNORMAL;
+        IContextMenu_InvokeCommand(menu, &info);
+        IContextMenu_Release(menu);
+    }
+done:
+    if (pidls) for (i = 0; i < count; i++) ILFree(pidls[i]);
+    free(pidls);
+    ILFree(parent);
+    if (folder) IShellFolder_Release(folder);
+    if (desktop) IShellFolder_Release(desktop);
+    free(op->paths);
+    free(op);
+    OleUninitialize();
+    return 0;
+}
+
 BOOL WINAPI SHObjectProperties(HWND hwnd, DWORD dwType, LPCWSTR szObject, LPCWSTR szPage)
 {
-    FIXME("%p, 0x%08lx, %s, %s - stub\n", hwnd, dwType, debugstr_w(szObject), debugstr_w(szPage));
+    struct object_properties *op;
+    WCHAR path[MAX_PATH];
+    const WCHAR *p;
+    size_t len;
+    HANDLE thread;
+
+    TRACE("%p, 0x%08lx, %s, %s\n", hwnd, dwType, debugstr_w(szObject), debugstr_w(szPage));
+
+    if (!szObject) return FALSE;
+    if (szPage) FIXME("page %s is not chosen\n", debugstr_w(szPage));
+#ifdef SG_MUTANT_NO_OBJECT_PROPERTIES
+    return TRUE;
+#endif
+    switch (dwType & 0xf)
+    {
+    case SHOP_FILEPATH:
+        break;
+    case SHOP_VOLUMEGUID:
+    {
+        DWORD needed = 0;
+        /* \\?\Volume{GUID}\ -> its drive's root */
+        if (!GetVolumePathNamesForVolumeNameW(szObject, path, ARRAY_SIZE(path), &needed) || !path[0]) return FALSE;
+        szObject = path;
+        break;
+    }
+    case SHOP_PRINTERNAME:
+    {
+        HANDLE printer;
+        BOOL (WINAPI *props)(HWND, HANDLE);
+        BOOL (WINAPI *open)(WCHAR *, HANDLE *, void *);
+        BOOL (WINAPI *close)(HANDLE);
+        HMODULE winspool = LoadLibraryW(L"winspool.drv");
 
+        if (!winspool) return FALSE;
+        props = (void *)GetProcAddress(winspool, "PrinterProperties");
+        open = (void *)GetProcAddress(winspool, "OpenPrinterW");
+        close = (void *)GetProcAddress(winspool, "ClosePrinter");
+        if (!props || !open || !close || !open((WCHAR *)szObject, &printer, NULL)) return FALSE;
+        props(hwnd, printer);
+        close(printer);
+        return TRUE;
+    }
+    default:
+        FIXME("type %#lx is not supported\n", dwType);
+        return FALSE;
+    }
+    /* one path, or a double-NUL-terminated list of them */
+    for (p = szObject; *p; p += lstrlenW(p) + 1);
+    len = p - szObject + 1;
+    if (!(op = calloc(1, sizeof(*op))) || !(op->paths = calloc(len + 1, sizeof(WCHAR))))
+    {
+        free(op);
+        return FALSE;
+    }
+    memcpy(op->paths, szObject, len * sizeof(WCHAR));
+    op->hwnd = hwnd;
+    if (!(thread = CreateThread(NULL, 0, object_properties_thread, op, 0, NULL)))
+    {
+        free(op->paths);
+        free(op);
+        return FALSE;
+    }
+    CloseHandle(thread);
     return TRUE;
 }
 
