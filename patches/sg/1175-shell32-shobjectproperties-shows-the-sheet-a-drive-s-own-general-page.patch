+
+struct drive_properties
+{
+    WCHAR root[4];          /* "C:\" */
+    ULARGE_INTEGER total, free;
+    BOOL known;             /* the sizes could be read */
+};
+
+/* the used part and the free part of the chart and their swatches */
+#define USED_COLOR RGB(0x26, 0xa0, 0xda)
+#define FREE_COLOR RGB(0xd8, 0xd8, 0xd8)
+
+static void set_size_text(HWND dlg, int bytes_id, int short_id, ULONGLONG size)
+{
+    WCHAR bytes[64], number[48], short_size[32];
+    NUMBERFMTW fmt = { 0, 0, 3, (WCHAR *)L".", (WCHAR *)L",", 1 };
+    WCHAR sep[8], value[32];
+
+    /* the grouping the user's locale has */
+    if (GetLocaleInfoW(LOCALE_USER_DEFAULT, LOCALE_STHOUSAND, sep, ARRAY_SIZE(sep))) fmt.lpThousandSep = sep;
+    swprintf(value, ARRAY_SIZE(value), L"%I64u", size);
+    if (!GetNumberFormatW(LOCALE_USER_DEFAULT, 0, value, &fmt, number, ARRAY_SIZE(number)))
+        lstrcpynW(number, value, ARRAY_SIZE(number));
+    swprintf(bytes, ARRAY_SIZE(bytes), L"%s bytes", number);
+    SetDlgItemTextW(dlg, bytes_id, bytes);
+    StrFormatByteSizeW(size, short_size, ARRAY_SIZE(short_size));
+    SetDlgItemTextW(dlg, short_id, short_size);
+}
+
+static void init_page(HWND dlg, struct drive_properties *props)
+{
+    WCHAR label[MAX_PATH] = L"", fs[MAX_PATH] = L"", name[MAX_PATH + 16], type[64], cleanup[MAX_PATH];
+    UINT drive_type = GetDriveTypeW(props->root);
+    SHFILEINFOW info;
+    HICON icon = NULL;
+
+    if (SHGetFileInfoW(props->root, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON)) icon = info.hIcon;
+    if (icon) SendDlgItemMessageW(dlg, IDC_DPROP_ICON, STM_SETICON, (WPARAM)icon, 0);
+
+    GetVolumeInformationW(props->root, label, ARRAY_SIZE(label), NULL, NULL, NULL, fs, ARRAY_SIZE(fs));
+    SetDlgItemTextW(dlg, IDC_DPROP_LABEL, label);
+    switch (drive_type)
+    {
+    case DRIVE_REMOVABLE: lstrcpyW(type, L"Removable Disk"); break;
+    case DRIVE_REMOTE: lstrcpyW(type, L"Network Drive"); break;
+    case DRIVE_CDROM: lstrcpyW(type, L"CD Drive"); break;
+    case DRIVE_RAMDISK: lstrcpyW(type, L"RAM Disk"); break;
+    default: lstrcpyW(type, L"Local Disk"); break;
+    }
+    SetDlgItemTextW(dlg, IDC_DPROP_TYPE, type);
+    SetDlgItemTextW(dlg, IDC_DPROP_FS, fs[0] ? fs : L"Unknown");
+
+    props->known = GetDiskFreeSpaceExW(props->root, NULL, &props->total, &props->free);
+    if (props->known && props->free.QuadPart > props->total.QuadPart) props->free.QuadPart = props->total.QuadPart;
+    if (props->known)
+    {
+        set_size_text(dlg, IDC_DPROP_USED_BYTES, IDC_DPROP_USED, props->total.QuadPart - props->free.QuadPart);
+        set_size_text(dlg, IDC_DPROP_FREE_BYTES, IDC_DPROP_FREE, props->free.QuadPart);
+        set_size_text(dlg, IDC_DPROP_CAPACITY_BYTES, IDC_DPROP_CAPACITY, props->total.QuadPart);
+    }
+    swprintf(name, ARRAY_SIZE(name), L"Drive %c:", props->root[0]);
+    SetDlgItemTextW(dlg, IDC_DPROP_DRIVE, name);
+
+    /* Disk Cleanup, for a drive of this machine, when the system has it */
+    if (drive_type == DRIVE_REMOTE || drive_type == DRIVE_CDROM ||
+        !SearchPathW(NULL, L"cleanmgr.exe", NULL, ARRAY_SIZE(cleanup), cleanup, NULL))
+        ShowWindow(GetDlgItem(dlg, IDC_DPROP_CLEANUP), SW_HIDE);
+}
+
+/* sine and cosine for the chart's slice (no C runtime here) */
+static double sine(double x)
+{
+    const double pi = 3.14159265358979;
+    double term, sum;
+    int n;
+
+    while (x > pi) x -= 2 * pi;
+    while (x < -pi) x += 2 * pi;
+    term = sum = x;
+    for (n = 1; n < 12; n++)
+    {
+        term *= -x * x / ((2 * n) * (2 * n + 1));
+        sum += term;
+    }
+    return sum;
+}
+
+static double cosine(double x)
+{
+    return sine(x + 3.14159265358979 / 2);
+}
+
+/* the chart: the free part as a disc, the used part a slice of it */
+static void draw_chart(const DRAWITEMSTRUCT *draw, const struct drive_properties *props)
+{
+    RECT r = draw->rcItem;
+    HBRUSH used = CreateSolidBrush(USED_COLOR), free = CreateSolidBrush(FREE_COLOR), old_brush;
+    HPEN pen = CreatePen(PS_SOLID, 1, RGB(0x80, 0x80, 0x80)), old_pen;
+    int cx = (r.left + r.right) / 2, cy = (r.top + r.bottom) / 2, size = min(r.right - r.left, r.bottom - r.top) - 2;
+    RECT disc = { cx - size / 2, cy - size / 2, cx + size / 2, cy + size / 2 };
+    double share, angle;
+
+    {
+        /* the page's own background (themed: white, or dark) */
+        HBRUSH back = (HBRUSH)SendMessageW(GetParent(draw->hwndItem), WM_CTLCOLORSTATIC, (WPARAM)draw->hDC,
+                                           (LPARAM)draw->hwndItem);
+        FillRect(draw->hDC, &r, back ? back : GetSysColorBrush(COLOR_WINDOW));
+    }
+    old_pen = SelectObject(draw->hDC, pen);
+    old_brush = SelectObject(draw->hDC, free);
+    Ellipse(draw->hDC, disc.left, disc.top, disc.right, disc.bottom);
+    if (props->known && props->total.QuadPart)
+    {
+        share = (double)(props->total.QuadPart - props->free.QuadPart) / (double)props->total.QuadPart;
+        SelectObject(draw->hDC, used);
+        if (share >= 0.999)
+            Ellipse(draw->hDC, disc.left, disc.top, disc.right, disc.bottom);
+        else if (share > 0.001)
+        {
+            /* from twelve o'clock, clockwise, as Windows draws it */
+            angle = 3.14159265358979 / 2 - share * 2 * 3.14159265358979;
+            Pie(draw->hDC, disc.left, disc.top, disc.right, disc.bottom,
+                (int)(cx + size * cosine(angle)), (int)(cy - size * sine(angle)), cx, disc.top);
+        }
+    }
+    SelectObject(draw->hDC, old_brush);
+    SelectObject(draw->hDC, old_pen);
+    DeleteObject(used);
+    DeleteObject(free);
+    DeleteObject(pen);
+}
+
+static void draw_swatch(const DRAWITEMSTRUCT *draw, COLORREF color)
+{
+    HBRUSH brush = CreateSolidBrush(color);
+    FillRect(draw->hDC, &draw->rcItem, brush);
+    FrameRect(draw->hDC, &draw->rcItem, GetSysColorBrush(COLOR_BTNSHADOW));
+    DeleteObject(brush);
+}
+
+static INT_PTR CALLBACK drive_properties_proc(HWND dlg, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct drive_properties *props = (struct drive_properties *)GetWindowLongPtrW(dlg, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        PROPSHEETPAGEW *page = (PROPSHEETPAGEW *)lparam;
+
+        props = (struct drive_properties *)page->lParam;
+        SetWindowLongPtrW(dlg, DWLP_USER, (LONG_PTR)props);
+        init_page(dlg, props);
+        return TRUE;
+    }
+    case WM_DRAWITEM:
+    {
+        const DRAWITEMSTRUCT *draw = (const DRAWITEMSTRUCT *)lparam;
+
+        if (!props) break;
+        if (draw->CtlID == IDC_DPROP_CHART) draw_chart(draw, props);
+        else if (draw->CtlID == IDC_DPROP_USED_SWATCH) draw_swatch(draw, USED_COLOR);
+        else if (draw->CtlID == IDC_DPROP_FREE_SWATCH) draw_swatch(draw, FREE_COLOR);
+        else break;
+        return TRUE;
+    }
+    case WM_COMMAND:
+        if (LOWORD(wparam) == IDC_DPROP_CLEANUP && props)
+        {
+            WCHAR args[16];
+
+            swprintf(args, ARRAY_SIZE(args), L"/d %c", props->root[0]);
+            ShellExecuteW(dlg, NULL, L"cleanmgr.exe", args, NULL, SW_SHOWNORMAL);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+static UINT CALLBACK drive_properties_callback(HWND hwnd, UINT msg, PROPSHEETPAGEW *page)
+{
+    if (msg == PSPCB_RELEASE) free((void *)page->lParam);
+    return 1;
+}
+
+/* the General page of a drive, for "X:\" */
+BOOL add_drive_properties_page(const WCHAR *root, LPFNADDPROPSHEETPAGE add, LPARAM lparam)
+{
+    struct drive_properties *props;
+    PROPSHEETPAGEW page;
+    HPROPSHEETPAGE hpage;
+
+    if (!root || !root[0] || root[1] != ':' || root[2] != '\\' || root[3]) return FALSE;
+    if (!(props = calloc(1, sizeof(*props)))) return FALSE;
+    lstrcpynW(props->root, root, ARRAY_SIZE(props->root));
+
+    memset(&page, 0, sizeof(page));
+    page.dwSize = sizeof(page);
+    page.dwFlags = PSP_DEFAULT | PSP_USECALLBACK;
+    page.hInstance = shell32_hInstance;
+    page.pszTemplate = MAKEINTRESOURCEW(IDD_DRIVE_PROPERTIES);
+    page.pfnDlgProc = drive_properties_proc;
+    page.pfnCallback = drive_properties_callback;
+    page.lParam = (LPARAM)props;
+    if (!(hpage = CreatePropertySheetPageW(&page)))
+    {
+        free(props);
+        return FALSE;
+    }
+    add(hpage, lparam);
+    return TRUE;
+}
