From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] win32u: wglShareLists for software OpenGL contexts

dibdrv's wglShareLists shares display lists and textures by creating the
destination OSMesa context again with the original as its share list. CORE:
integrator must review (patches/notes/5219.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/win32u/dibdrv/opengl.c b/dlls/win32u/dibdrv/opengl.c
--- a/dlls/win32u/dibdrv/opengl.c
+++ b/dlls/win32u/dibdrv/opengl.c
@@ -56,6 +56,9 @@
 {
     OSMesaContext context;
     UINT          format;
+    GLint         depth_bits;
+    GLint         stencil_bits;
+    GLint         accum_bits;
 };
 
 static struct opengl_funcs opengl_funcs;
@@ -71,6 +74,7 @@
 static GLboolean (*pOSMesaMakeCurrent)( OSMesaContext ctx, void *buffer, GLenum type,
                                         GLsizei width, GLsizei height );
 static void (*pOSMesaPixelStore)( GLint pname, GLint value );
+static OSMesaContext (*pOSMesaGetCurrentContext)( void );
 
 static BOOL init_opengl(void)
 {
@@ -99,6 +103,7 @@
     LOAD_FUNCPTR(OSMesaGetProcAddress);
     LOAD_FUNCPTR(OSMesaMakeCurrent);
     LOAD_FUNCPTR(OSMesaPixelStore);
+    LOAD_FUNCPTR(OSMesaGetCurrentContext);
 #undef LOAD_FUNCPTR
 
     for (i = 0; i < ARRAY_SIZE( opengl_func_names ); i++)
@@ -152,6 +157,9 @@
     }
     if (!(context = malloc( sizeof( *context )))) return NULL;
     context->format = gl_format;
+    context->depth_bits = descr->cDepthBits;
+    context->stencil_bits = descr->cStencilBits;
+    context->accum_bits = descr->cAccumBits;
     if (!(context->context = pOSMesaCreateContextExt( gl_format, descr->cDepthBits, descr->cStencilBits,
                                                       descr->cAccumBits, 0 )))
     {
@@ -204,13 +212,42 @@
     return ret;
 }
 
+/***********************************************************************
+ *		osmesa_share_lists
+ *
+ * OSMesa can only share the objects of a context when the other one is created, so
+ * the destination (which must not have any object yet, as wglShareLists asks) is made again
+ * with the original as its share list.
+ */
+static BOOL osmesa_share_lists( struct wgl_context *org, struct wgl_context *dest )
+{
+    OSMesaContext shared;
+
+    if (org == dest) return TRUE;
+    if (org->format != dest->format) return FALSE;
+#ifndef SG_MUTANT_SHARE_NOCUR
+    if (pOSMesaGetCurrentContext() == dest->context) return FALSE;   /* in use by this thread */
+#endif
+    if (!(shared = pOSMesaCreateContextExt( dest->format, dest->depth_bits, dest->stencil_bits,
+                                            dest->accum_bits, org->context )))
+        return FALSE;
+#ifdef SG_MUTANT_SHARE_NOOP
+    pOSMesaDestroyContext( shared );
+    return TRUE;
+#endif
+    pOSMesaDestroyContext( dest->context );
+    dest->context = shared;
+    return TRUE;
+}
+
 static const struct osmesa_funcs osmesa_funcs =
 {
     osmesa_get_gl_funcs,
     osmesa_create_context,
     osmesa_delete_context,
     osmesa_get_proc_address,
-    osmesa_make_current
+    osmesa_make_current,
+    osmesa_share_lists
 };
 
 const struct osmesa_funcs *init_opengl_lib(void)
diff --git a/dlls/win32u/dibdrv/dc.c b/dlls/win32u/dibdrv/dc.c
--- a/dlls/win32u/dibdrv/dc.c
+++ b/dlls/win32u/dibdrv/dc.c
@@ -564,8 +564,8 @@
  */
 static BOOL dibdrv_wglShareLists( struct wgl_context *org, struct wgl_context *dest )
 {
-    FIXME( "not supported yet\n" );
-    return FALSE;
+    if (!osmesa_funcs || !org || !dest) return FALSE;
+    return osmesa_funcs->share_lists( org, dest );
 }
 
 /***********************************************************************
diff --git a/dlls/win32u/dibdrv/dibdrv.h b/dlls/win32u/dibdrv/dibdrv.h
--- a/dlls/win32u/dibdrv/dibdrv.h
+++ b/dlls/win32u/dibdrv/dibdrv.h
@@ -298,6 +298,7 @@
     PROC (*get_proc_address)( const char *proc );
     BOOL (*make_current)( struct wgl_context *context, void *bits,
                           int width, int height, int bpp, int stride );
+    BOOL (*share_lists)( struct wgl_context *org, struct wgl_context *dest );
 };
 
 extern const struct osmesa_funcs *init_opengl_lib(void);
