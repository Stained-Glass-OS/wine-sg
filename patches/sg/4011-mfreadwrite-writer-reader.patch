+static struct stream *sink_writer_get_stream(const struct sink_writer *writer, DWORD index);
+
+static HRESULT sink_writer_get_stream_type(IMFStreamSink *stream_sink, IMFMediaType **type)
+{
+    IMFMediaTypeHandler *handler;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFStreamSink_GetMediaTypeHandler(stream_sink, &handler)))
+        return hr;
+    hr = IMFMediaTypeHandler_GetCurrentMediaType(handler, type);
+    IMFMediaTypeHandler_Release(handler);
+    return hr;
+}
+
+/* Finds and configures a transform of the category taking "input" to "output". An
+ * encoder gets its output type first, other transforms their input type first. */
+static HRESULT sink_writer_create_transform(const GUID *category, IMFMediaType *input, IMFMediaType *output,
+        BOOL encoder, IMFTransform **ret)
+{
+    MFT_REGISTER_TYPE_INFO in_info, out_info;
+    IMFActivate **activates = NULL;
+    IMFTransform *transform;
+    UINT32 count = 0, i;
+    HRESULT hr;
+
+    *ret = NULL;
+
+    if (FAILED(hr = IMFMediaType_GetMajorType(input, &in_info.guidMajorType))
+            || FAILED(hr = IMFMediaType_GetGUID(input, &MF_MT_SUBTYPE, &in_info.guidSubtype))
+            || FAILED(hr = IMFMediaType_GetMajorType(output, &out_info.guidMajorType))
+            || FAILED(hr = IMFMediaType_GetGUID(output, &MF_MT_SUBTYPE, &out_info.guidSubtype)))
+        return hr;
+
+    if (FAILED(hr = MFTEnumEx(*category, MFT_ENUM_FLAG_SYNCMFT | MFT_ENUM_FLAG_LOCALMFT | MFT_ENUM_FLAG_SORTANDFILTER,
+            encoder ? NULL : &in_info, &out_info, &activates, &count)))
+        return hr;
+
+    hr = MF_E_TOPO_CODEC_NOT_FOUND;
+    for (i = 0; i < count; ++i)
+    {
+        if (!*ret && SUCCEEDED(IMFActivate_ActivateObject(activates[i], &IID_IMFTransform, (void **)&transform)))
+        {
+            if (encoder)
+                hr = IMFTransform_SetOutputType(transform, 0, output, 0);
+            else
+                hr = IMFTransform_SetInputType(transform, 0, input, 0);
+            if (SUCCEEDED(hr))
+            {
+                if (encoder)
+                    hr = IMFTransform_SetInputType(transform, 0, input, 0);
+                else
+                    hr = IMFTransform_SetOutputType(transform, 0, output, 0);
+            }
+
+            if (SUCCEEDED(hr))
+                *ret = transform;
+            else
+            {
+                IMFTransform_Release(transform);
+                IMFActivate_ShutdownObject(activates[i]);
+            }
+        }
+        IMFActivate_Release(activates[i]);
+    }
+    CoTaskMemFree(activates);
+
+    return *ret ? S_OK : MF_E_TOPO_CODEC_NOT_FOUND;
+}
+
+/* An encoder for "output" fed through a converter from "input": tries the
+ * encoder's own input types in its order of preference. */
+static HRESULT sink_writer_create_encoder_chain(const GUID *encoder_category, const GUID *converter_category,
+        IMFMediaType *input, IMFMediaType *output, IMFTransform **converter, IMFTransform **encoder)
+{
+    MFT_REGISTER_TYPE_INFO out_info;
+    IMFActivate **activates = NULL;
+    IMFMediaType *encoder_input;
+    IMFTransform *transform;
+    UINT32 count = 0, i;
+    DWORD index;
+    HRESULT hr;
+
+    *converter = *encoder = NULL;
+
+    if (FAILED(hr = IMFMediaType_GetMajorType(output, &out_info.guidMajorType))
+            || FAILED(hr = IMFMediaType_GetGUID(output, &MF_MT_SUBTYPE, &out_info.guidSubtype)))
+        return hr;
+    if (FAILED(hr = MFTEnumEx(*encoder_category, MFT_ENUM_FLAG_SYNCMFT | MFT_ENUM_FLAG_LOCALMFT | MFT_ENUM_FLAG_SORTANDFILTER,
+            NULL, &out_info, &activates, &count)))
+        return hr;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (!*encoder && SUCCEEDED(IMFActivate_ActivateObject(activates[i], &IID_IMFTransform, (void **)&transform)))
+        {
+            if (SUCCEEDED(IMFTransform_SetOutputType(transform, 0, output, 0)))
+            {
+                for (index = 0; !*encoder && SUCCEEDED(IMFTransform_GetInputAvailableType(transform, 0, index,
+                        &encoder_input)); ++index)
+                {
+                    if (SUCCEEDED(sink_writer_create_transform(converter_category, input, encoder_input, FALSE, converter)))
+                    {
+                        if (SUCCEEDED(IMFTransform_SetInputType(transform, 0, encoder_input, 0)))
+                            *encoder = transform;
+                        else
+                        {
+                            IMFTransform_Release(*converter);
+                            *converter = NULL;
+                        }
+                    }
+                    IMFMediaType_Release(encoder_input);
+                }
+            }
+            if (!*encoder)
+            {
+                IMFTransform_Release(transform);
+                IMFActivate_ShutdownObject(activates[i]);
+            }
+        }
+        IMFActivate_Release(activates[i]);
+    }
+    CoTaskMemFree(activates);
+
+    return *encoder ? S_OK : MF_E_TOPO_CODEC_NOT_FOUND;
+}
