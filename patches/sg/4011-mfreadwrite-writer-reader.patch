+static IMFTransform *sink_writer_get_transform(struct stream *stream, unsigned int index)
+{
+    IMFTransform *transforms[2];
+    unsigned int count = 0;
+
+    if (stream->converter)
+        transforms[count++] = stream->converter;
+    if (stream->encoder)
+        transforms[count++] = stream->encoder;
+
+    return index < count ? transforms[index] : NULL;
+}
+
+static HRESULT sink_writer_push_transform_sample(struct stream *stream, unsigned int index, IMFSample *sample);
+
+/* Takes what the transform has ready and passes it on (or queues it for the sink). */
+static HRESULT sink_writer_pull_transform_samples(struct stream *stream, unsigned int index)
+{
+    IMFTransform *transform = sink_writer_get_transform(stream, index);
+    MFT_OUTPUT_STREAM_INFO info;
+    IMFMediaBuffer *buffer;
+    IMFMediaType *type;
+    HRESULT hr = S_OK;
+    DWORD status;
+
+    if (FAILED(hr = IMFTransform_GetOutputStreamInfo(transform, 0, &info)))
+        return hr;
+
+    for (;;)
+    {
+        MFT_OUTPUT_DATA_BUFFER output = {0};
+
+        if (!(info.dwFlags & (MFT_OUTPUT_STREAM_PROVIDES_SAMPLES | MFT_OUTPUT_STREAM_CAN_PROVIDE_SAMPLES)))
+        {
+            if (FAILED(hr = MFCreateSample(&output.pSample)))
+                break;
+            if (FAILED(hr = MFCreateAlignedMemoryBuffer(max(info.cbSize, 1), info.cbAlignment ? info.cbAlignment - 1 : 0,
+                    &buffer)))
+            {
+                IMFSample_Release(output.pSample);
+                break;
+            }
+            IMFSample_AddBuffer(output.pSample, buffer);
+            IMFMediaBuffer_Release(buffer);
+        }
+
+        hr = IMFTransform_ProcessOutput(transform, 0, 1, &output, &status);
+        if (SUCCEEDED(hr) && output.pSample)
+        {
+            if (sink_writer_get_transform(stream, index + 1))
