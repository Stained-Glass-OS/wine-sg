+static HRESULT source_reader_map_stream_index(const struct source_reader *reader, DWORD *index)
+{
+    switch (*index)
+    {
+        case MF_SOURCE_READER_FIRST_VIDEO_STREAM:
+            *index = reader->first_video_stream_index;
+            break;
+        case MF_SOURCE_READER_FIRST_AUDIO_STREAM:
+            *index = reader->first_audio_stream_index;
+            break;
+        default:
+            ;
+    }
+
+    return *index < reader->stream_count ? S_OK : MF_E_INVALIDSTREAMNUMBER;
+}
+
+static void source_reader_remove_transforms(struct media_stream *stream, BOOL user_only)
+{
+    struct transform_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &stream->transforms, struct transform_entry, entry)
+    {
+        if (user_only && !entry->user)
+            continue;
+        if (stream->transform_service == entry->transform)
+        {
+            IMFTransform_Release(stream->transform_service);
+            stream->transform_service = NULL;
+        }
+        list_remove(&entry->entry);
+        transform_entry_destroy(entry);
+    }
+
+    if (!user_only && stream->transform_service)
+    {
+        IMFTransform_Release(stream->transform_service);
+        stream->transform_service = NULL;
+    }
+}
