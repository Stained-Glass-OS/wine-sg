+
+    if (!transform)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = source_reader_map_stream_index(reader, &stream_index)))
+        return hr;
+
+    if (FAILED(IUnknown_QueryInterface(transform, &IID_IMFTransform, (void **)&mft)))
+    {
+        if (FAILED(hr = IUnknown_QueryInterface(transform, &IID_IMFActivate, (void **)&activate)))
+            return E_INVALIDARG;
+        hr = IMFActivate_ActivateObject(activate, &IID_IMFTransform, (void **)&mft);
+        IMFActivate_Release(activate);
+        if (FAILED(hr))
+            return hr;
+    }
+
+    EnterCriticalSection(&reader->cs);
+
+    stream = &reader->streams[stream_index];
+
+    /* The new transform takes the current output type; effects keep the format, otherwise its first output type is used. */
+    if (SUCCEEDED(hr = IMFTransform_SetInputType(mft, 0, stream->current, 0)))
+    {
+        if (FAILED(IMFTransform_SetOutputType(mft, 0, stream->current, 0))
+                && SUCCEEDED(hr = IMFTransform_GetOutputAvailableType(mft, 0, 0, &output_type)))
+        {
+            hr = IMFTransform_SetOutputType(mft, 0, output_type, 0);
+            IMFMediaType_Release(output_type);
+        }
+    }
+    if (FAILED(hr))
+        hr = MF_E_INVALIDMEDIATYPE;
+    else if (!(entry = calloc(1, sizeof(*entry))))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        entry->transform = mft;
+        IMFTransform_AddRef(mft);
+        entry->user = TRUE;
+        entry->attributes_initialized = TRUE;
+        if (SUCCEEDED(IMFMediaType_GetMajorType(stream->current, &major)) && IsEqualGUID(&major, &MFMediaType_Video))
+            entry->category = MFT_CATEGORY_VIDEO_EFFECT;
+        else
+            entry->category = MFT_CATEGORY_AUDIO_EFFECT;
+        list_add_tail(&stream->transforms, &entry->entry);
+
+        if (SUCCEEDED(hr = IMFTransform_GetOutputCurrentType(mft, 0, &output_type)))
+        {
+            IMFMediaType_DeleteAllItems(stream->current);
+            hr = IMFMediaType_CopyAllItems(output_type, (IMFAttributes *)stream->current);
+            IMFMediaType_Release(output_type);
+        }
+        if (SUCCEEDED(hr))
+            hr = source_reader_setup_sample_allocator(reader, stream_index);
+    }
