 static HRESULT WINAPI src_reader_SetNativeMediaType(IMFSourceReaderEx *iface, DWORD stream_index,
         IMFMediaType *media_type, DWORD *stream_flags)
 {
-    FIXME("%p, %#lx, %p, %p.\n", iface, stream_index, media_type, stream_flags);
+    struct source_reader *reader = impl_from_IMFSourceReaderEx(iface);
+    IMFMediaTypeHandler *handler;
+    struct media_stream *stream;
+    BOOL had_transforms;
+    DWORD flags;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%p, %#lx, %p, %p.\n", iface, stream_index, media_type, stream_flags);
+
+    if (!media_type || !stream_flags)
+        return E_POINTER;
+
+    *stream_flags = 0;
+
+    if (FAILED(hr = source_reader_map_stream_index(reader, &stream_index)))
+        return hr;
+
+    EnterCriticalSection(&reader->cs);
+
+    stream = &reader->streams[stream_index];
+
+    if (SUCCEEDED(hr = source_reader_get_source_type_handler(reader, stream_index, &handler)))
+    {
+        if (IMFMediaTypeHandler_IsMediaTypeSupported(handler, media_type, NULL) != S_OK)
+            hr = MF_E_INVALIDMEDIATYPE;
+        else if (SUCCEEDED(hr = IMFMediaTypeHandler_SetCurrentMediaType(handler, media_type)))
+        {
+            *stream_flags |= MF_SOURCE_READERF_NATIVEMEDIATYPECHANGED;
+
+            /* The decoding chain was built for the old type: the output is now the native type. */
+            had_transforms = !list_empty(&stream->transforms);
+            source_reader_remove_transforms(stream, FALSE);
+            if (had_transforms)
+                *stream_flags |= MF_SOURCE_READERF_ALLEFFECTSREMOVED;
+
+            if (FAILED(IMFMediaType_IsEqual(media_type, stream->current, &flags))
+                    || !(flags & MF_MEDIATYPE_EQUAL_FORMAT_DATA))
+                *stream_flags |= MF_SOURCE_READERF_CURRENTMEDIATYPECHANGED;
+            IMFMediaType_DeleteAllItems(stream->current);
+            if (SUCCEEDED(hr = IMFMediaType_CopyAllItems(media_type, (IMFAttributes *)stream->current)))
+                hr = source_reader_setup_sample_allocator(reader, stream_index);
+        }
+        IMFMediaTypeHandler_Release(handler);
+    }
+
+    LeaveCriticalSection(&reader->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI src_reader_AddTransformForStream(IMFSourceReaderEx *iface, DWORD stream_index,
         IUnknown *transform)
 {
-    FIXME("%p, %#lx, %p.\n", iface, stream_index, transform);
+    struct source_reader *reader = impl_from_IMFSourceReaderEx(iface);
+    IMFMediaType *output_type = NULL;
