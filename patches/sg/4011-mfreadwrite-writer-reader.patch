+/* Waits for the sink to take everything queued, then finalizes and shuts down the sink. */
+static HRESULT sink_writer_complete_finalize(struct sink_writer *writer)
+{
+    IMFFinalizableMediaSink *finalizable;
+    HRESULT hr;
+
+    for (;;)
+    {
