 static HRESULT WINAPI sink_writer_SetInputMediaType(IMFSinkWriter *iface, DWORD index, IMFMediaType *type,
         IMFAttributes *parameters)
 {
-    FIXME("%p, %lu, %p, %p.\n", iface, index, type, parameters);
+    struct sink_writer *writer = impl_from_IMFSinkWriter(iface);
+    IMFTransform *converter = NULL, *encoder = NULL;
+    const GUID *encoder_category, *converter_category;
+    IMFMediaType *output = NULL;
+    IMFAttributes *attributes;
+    GUID in_major, out_major;
+    struct stream *stream;
+    DWORD flags;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%p, %lu, %p, %p.\n", iface, index, type, parameters);
+
+    if (!type)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&writer->cs);
+
+    if (writer->state != SINK_WRITER_STATE_INITIAL)
+        hr = MF_E_INVALIDREQUEST;
+    else if (!(stream = sink_writer_get_stream(writer, index)))
+        hr = MF_E_INVALIDSTREAMNUMBER;
+    else if (SUCCEEDED(hr = sink_writer_get_stream_type(stream->stream_sink, &output))
+            && SUCCEEDED(hr = IMFMediaType_GetMajorType(type, &in_major))
+            && SUCCEEDED(hr = IMFMediaType_GetMajorType(output, &out_major)))
+    {
+        if (!IsEqualGUID(&in_major, &out_major))
+            hr = MF_E_INVALIDMEDIATYPE;
+        else if (IMFMediaType_IsEqual(type, output, &flags) == S_OK)
+            hr = S_OK; /* written as is */
+        else
+        {
+            if (IsEqualGUID(&in_major, &MFMediaType_Video))
+            {
+                encoder_category = &MFT_CATEGORY_VIDEO_ENCODER;
+                converter_category = &MFT_CATEGORY_VIDEO_PROCESSOR;
+            }
+            else if (IsEqualGUID(&in_major, &MFMediaType_Audio))
+            {
+                encoder_category = &MFT_CATEGORY_AUDIO_ENCODER;
+                converter_category = &MFT_CATEGORY_AUDIO_EFFECT;
+            }
+            else
+                encoder_category = converter_category = NULL;
+
+            if (!encoder_category)
+                hr = MF_E_TOPO_CODEC_NOT_FOUND;
+            else if (FAILED(hr = sink_writer_create_transform(converter_category, type, output, FALSE, &converter))
+                    && FAILED(hr = sink_writer_create_transform(encoder_category, type, output, TRUE, &encoder)))
+            {
+                hr = sink_writer_create_encoder_chain(encoder_category, converter_category, type, output,
+                        &converter, &encoder);
+            }
+        }
+
+        if (SUCCEEDED(hr))
+        {
+            if (encoder && parameters && SUCCEEDED(IMFTransform_GetAttributes(encoder, &attributes)))
+            {
+                IMFAttributes_CopyAllItems(parameters, attributes);
+                IMFAttributes_Release(attributes);
+            }
+
+            if (stream->encoder)
+                IMFTransform_Release(stream->encoder);
+            if (stream->converter)
+                IMFTransform_Release(stream->converter);
+            stream->encoder = encoder;
+            stream->converter = converter;
+        }
+    }
+
+    if (output)
+        IMFMediaType_Release(output);
+
+    LeaveCriticalSection(&writer->cs);
+
+    return hr;
 }
 
