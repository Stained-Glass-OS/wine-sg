diff --git a/dlls/ole32/storage32.c b/dlls/ole32/storage32.c
index bf6132b..e59f477 100644
--- a/dlls/ole32/storage32.c
+++ b/dlls/ole32/storage32.c
@@ -459,25 +459,71 @@ static ULONG WINAPI directwriterlock_Release(IDirectWriterLock *iface)
   return IStorage_Release(&This->IStorage_iface);
 }
 
+static HRESULT StorageImpl_LockRegion(StorageImpl *This, ULARGE_INTEGER offset,
+    ULARGE_INTEGER cb, DWORD dwLockType, BOOL *supported);
+static HRESULT StorageImpl_UnlockRegion(StorageImpl *This, ULARGE_INTEGER offset,
+    ULARGE_INTEGER cb, DWORD dwLockType);
+
+/* Stained Glass OS: the single writer of a STGM_DIRECT_SWMR file takes write
+ * access by locking a byte of the file's lock range, so a second writer (in
+ * another process too) waits for it; readers do not take it */
 static HRESULT WINAPI directwriterlock_WaitForWriteAccess(IDirectWriterLock *iface, DWORD timeout)
 {
   StorageBaseImpl *This = impl_from_IDirectWriterLock(iface);
-  FIXME("%p, %ld: stub\n", This, timeout);
-  return E_NOTIMPL;
+  StorageImpl *storage = (StorageImpl *)This;
+  ULARGE_INTEGER offset, cb;
+  DWORD start = GetTickCount();
+  BOOL supported;
+  HRESULT hr;
+
+  TRACE("%p, %ld\n", This, timeout);
+
+  if (This->reverted) return STG_E_REVERTED;
+  if (This->have_write_access) return S_OK;
+  offset.QuadPart = RANGELOCK_SWMR_WRITER;
+  cb.QuadPart = 1;
+  for (;;)
+  {
+#ifdef SG_MUTANT_SWMR_NO_LOCK
+    hr = S_OK; supported = TRUE;
+#else
+    hr = StorageImpl_LockRegion(storage, offset, cb, LOCK_ONLYONCE, &supported);
+    if (hr == STG_E_INVALIDFUNCTION || !supported)
+      hr = StorageImpl_LockRegion(storage, offset, cb, LOCK_EXCLUSIVE, &supported);
+#endif
+    if (hr != STG_E_ACCESSDENIED && hr != STG_E_LOCKVIOLATION) break;
+    if (timeout != INFINITE && GetTickCount() - start >= timeout) return STG_E_INUSE;
+    Sleep(10);
+  }
+  if (FAILED(hr)) return hr;
+  This->have_write_access = TRUE;
+  return S_OK;
 }
 
 static HRESULT WINAPI directwriterlock_ReleaseWriteAccess(IDirectWriterLock *iface)
 {
   StorageBaseImpl *This = impl_from_IDirectWriterLock(iface);
-  FIXME("(%p): stub\n", This);
-  return E_NOTIMPL;
+  StorageImpl *storage = (StorageImpl *)This;
+  ULARGE_INTEGER offset, cb;
+  HRESULT hr;
+
+  TRACE("(%p)\n", This);
+
+  if (!This->have_write_access) return STG_E_ACCESSDENIED;
+  offset.QuadPart = RANGELOCK_SWMR_WRITER;
+  cb.QuadPart = 1;
+  hr = StorageImpl_UnlockRegion(storage, offset, cb, LOCK_ONLYONCE);
+  if (FAILED(hr)) hr = StorageImpl_UnlockRegion(storage, offset, cb, LOCK_EXCLUSIVE);
+  This->have_write_access = FALSE;
+  return S_OK;
 }
 
 static HRESULT WINAPI directwriterlock_HaveWriteAccess(IDirectWriterLock *iface)
 {
   StorageBaseImpl *This = impl_from_IDirectWriterLock(iface);
-  FIXME("(%p): stub\n", This);
-  return E_NOTIMPL;
+
+  TRACE("(%p)\n", This);
+  return This->have_write_access ? S_OK : S_FALSE;
 }
 
 static const IDirectWriterLockVtbl DirectWriterLockVtbl =
@@ -2364,6 +2410,8 @@ static HRESULT WINAPI StorageBaseImpl_CopyTo(
 /*************************************************************************
  * MoveElementTo (IStorage)
  */
+/* Stained Glass OS: an element copied (STGMOVE_COPY) or moved (STGMOVE_MOVE) to
+ * another storage under a new name, replacing an element of that name there */
 static HRESULT WINAPI StorageBaseImpl_MoveElementTo(
   IStorage*     iface,
   const OLECHAR *pwcsName,   /* [string][in] */
@@ -2371,9 +2419,56 @@ static HRESULT WINAPI StorageBaseImpl_MoveElementTo(
   const OLECHAR *pwcsNewName,/* [string][in] */
   DWORD           grfFlags)    /* [in] */
 {
-  FIXME("%p, %s, %p, %s, %#lx: stub\n", iface, debugstr_w(pwcsName), pstgDest,
+  StorageBaseImpl *This = impl_from_IStorage(iface);
+  const DWORD mode = STGM_CREATE | STGM_READWRITE | STGM_SHARE_EXCLUSIVE;
+  DirEntry entry;
+  HRESULT hr;
+
+  TRACE("%p, %s, %p, %s, %#lx\n", iface, debugstr_w(pwcsName), pstgDest,
       debugstr_w(pwcsNewName), grfFlags);
-  return E_NOTIMPL;
+
+  if (!pwcsName || !pwcsNewName) return STG_E_INVALIDNAME;
+  if (!pstgDest) return STG_E_INVALIDPOINTER;
+  if (grfFlags != STGMOVE_MOVE && grfFlags != STGMOVE_COPY) return STG_E_INVALIDFLAG;
+  if (This->reverted) return STG_E_REVERTED;
+  if (findElement(This, This->storageDirEntry, pwcsName, &entry) == DIRENTRY_NULL)
+    return STG_E_FILENOTFOUND;
+
+  if (entry.stgType == STGTY_STREAM)
+  {
+    IStream *src, *dst;
+    ULARGE_INTEGER size;
+
+    if (FAILED(hr = IStorage_OpenStream(iface, pwcsName, NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, 0, &src)))
+      return hr;
+    if (SUCCEEDED(hr = IStorage_CreateStream(pstgDest, pwcsNewName, mode, 0, 0, &dst)))
+    {
+      size.QuadPart = ~(ULONGLONG)0;
+      hr = IStream_CopyTo(src, dst, size, NULL, NULL);
+      IStream_Release(dst);
+    }
+    IStream_Release(src);
+  }
+  else if (entry.stgType == STGTY_STORAGE)
+  {
+    IStorage *src, *dst;
+
+    if (FAILED(hr = IStorage_OpenStorage(iface, pwcsName, NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, NULL, 0, &src)))
+      return hr;
+    if (SUCCEEDED(hr = IStorage_CreateStorage(pstgDest, pwcsNewName, mode, 0, 0, &dst)))
+    {
+      hr = IStorage_CopyTo(src, 0, NULL, NULL, dst);
+      IStorage_Release(dst);
+    }
+    IStorage_Release(src);
+  }
+  else return STG_E_INVALIDFUNCTION;
+
+#ifndef SG_MUTANT_STG_MOVE_KEEPS
+  if (SUCCEEDED(hr) && grfFlags == STGMOVE_MOVE)
+    hr = IStorage_DestroyElement(iface, pwcsName);
+#endif
+  return hr;
 }
 
