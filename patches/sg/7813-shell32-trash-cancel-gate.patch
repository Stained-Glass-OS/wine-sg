From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: mutants for the Recycle Bin copy's progress and
 Cancel (gate test-trashcancel)

wine-sg 7813: SG_MUTANT_TRASH_DONE_FIRST counts the item before its work,
SG_MUTANT_TRASH_NO_PROGRESS drops the copy's progress routine.
---
 dlls/shell32/fileopdlg.c | 3 +++
 dlls/shell32/shlfileop.c | 5 +++++
 2 files changed, 8 insertions(+)

diff --git a/dlls/shell32/fileopdlg.c b/dlls/shell32/fileopdlg.c
index 51c3a7f..bdf6115 100644
--- a/dlls/shell32/fileopdlg.c
+++ b/dlls/shell32/fileopdlg.c
@@ -502,6 +502,9 @@ BOOL fileop_trash_file(struct fileop_progress *p, const WCHAR *path)
     if (!p) return trash_file(path);
     if (GetFileAttributesExW(path, GetFileExInfoStandard, &fad) && !(fad.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))
         p->item_size = ((LONGLONG)fad.nFileSizeHigh << 32) | fad.nFileSizeLow;
+#ifdef SG_MUTANT_TRASH_NO_PROGRESS
+    return trash_file_progress(path, NULL, NULL);
+#endif
     return trash_file_progress(path, copy_progress_routine, p);
 }
 
diff --git a/dlls/shell32/shlfileop.c b/dlls/shell32/shlfileop.c
index 52eb4da..cd16f00 100644
--- a/dlls/shell32/shlfileop.c
+++ b/dlls/shell32/shlfileop.c
@@ -1488,9 +1488,14 @@ static int delete_files(LPSHFILEOPSTRUCTW lpFileOp, const FILE_LIST *flFrom)
         if (bTrash)
         {
             BOOL bDelete;
+#ifdef SG_MUTANT_TRASH_DONE_FIRST
+            fileop_progress_done_item(fileop_progress_current(), 0);
+#endif
             if (fileop_trash_file(fileop_progress_current(), fileEntry->szFullPath))
             {
+#ifndef SG_MUTANT_TRASH_DONE_FIRST
                 fileop_progress_done_item(fileop_progress_current(), 0);
+#endif
                 continue;
             }
             /* Cancel while it was being copied into the Recycle Bin: the
-- 
2.47.3

