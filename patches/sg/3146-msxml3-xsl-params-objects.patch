From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 02:26:15 -0700
Subject: [PATCH] msxml3: XSLProcessor parameters of other types and extension
 objects

addParameter accepts numbers (integer, float, currency, decimal) and booleans,
which reach the stylesheet as XPath numbers and booleans instead of failing
with E_NOTIMPL; dates and the like are passed as their string form. addObject
now works: the methods of the object are extension functions of the given
namespace, called through IDispatch with string, number and boolean
arguments (a node set is passed as its string value). One object per
namespace; a second one replaces the first.

Office-facing: needs the Office sweep at integration.

diff --git a/dlls/msxml3/msxml_private.h b/dlls/msxml3/msxml_private.h
index 1c1fc32..db3e506 100644
--- a/dlls/msxml3/msxml_private.h
+++ b/dlls/msxml3/msxml_private.h
@@ -83,11 +83,21 @@ struct xslprocessor_par
     struct list entry;
     BSTR name;
     BSTR value;
+    BOOL is_expr; /* value is an XPath expression (number, boolean), not a string */
+};
+
+/* an object whose methods are extension functions of a namespace (IXSLProcessor::addObject) */
+struct xslprocessor_object
+{
+    struct list entry;
+    IDispatch *obj;
+    BSTR uri;
 };
 
 struct xslprocessor_params
 {
     struct list  list;
+    struct list  objects;
     unsigned int count;
     BSTR start_mode;
     BSTR start_mode_uri;
diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index 44eff36..e9f8ccf 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -26,6 +26,7 @@
 #include <libxml/parserInternals.h>
 #include <libxml/xmlerror.h>
 #include <libxml/HTMLtree.h>
+#include <libxml/xpathInternals.h>
 #include <libxslt/pattern.h>
 #include <libxslt/transform.h>
 #include <libxslt/imports.h>
@@ -1496,6 +1497,160 @@ failed:
     return doc;
 }
 
+/* Extension functions backed by objects given to IXSLProcessor::addObject. A function
+   of the object's namespace calls the method of the same name through IDispatch. */
+struct xsl_ext_lookup
+{
+    xmlXPathFuncLookupFunc old_func;
+    void *old_data;
+    const struct list *objects;
+};
+
+static IDispatch *xsl_ext_find_object(const struct list *objects, const xmlChar *uri)
+{
+    struct xslprocessor_object *obj;
+    BSTR uriW = uri ? bstr_from_xmlChar(uri) : NULL;
+    IDispatch *ret = NULL;
+
+    if (!uriW) return NULL;
+    LIST_FOR_EACH_ENTRY(obj, objects, struct xslprocessor_object, entry)
+    {
+        if (!wcscmp(obj->uri, uriW))
+        {
+            ret = obj->obj;
+            break;
+        }
+    }
+    SysFreeString(uriW);
+    return ret;
+}
+
+static void xsl_ext_function(xmlXPathParserContextPtr pctxt, int nargs)
+{
+    xmlXPathContextPtr xctx = pctxt->context;
+    struct xsl_ext_lookup *lookup = xctx->funcLookupData;
+    DISPPARAMS params = { NULL, NULL, 0, 0 };
+    VARIANT result;
+    IDispatch *obj;
+    BSTR nameW;
+    DISPID dispid;
+    HRESULT hr;
+    int i;
+
+    obj = xsl_ext_find_object(lookup->objects, xctx->functionURI);
+    nameW = xctx->function ? bstr_from_xmlChar(xctx->function) : NULL;
+    if (!obj || !nameW)
+    {
+        SysFreeString(nameW);
+        xmlXPathErr(pctxt, XPATH_UNKNOWN_FUNC_ERROR);
+        return;
+    }
+
+    if (nargs)
+    {
+        params.rgvarg = calloc(nargs, sizeof(VARIANT));
+        params.cArgs = nargs;
+    }
+    /* the last argument comes first, as in DISPPARAMS */
+    for (i = 0; i < nargs; i++)
+    {
+        xmlXPathObjectPtr arg = valuePop(pctxt);
+        VARIANT *v = &params.rgvarg[i];
+
+        if (!arg) continue;
+        switch (arg->type)
+        {
+        case XPATH_NUMBER:
+            V_VT(v) = VT_R8;
+            V_R8(v) = arg->floatval;
+            break;
+        case XPATH_BOOLEAN:
+            V_VT(v) = VT_BOOL;
+            V_BOOL(v) = arg->boolval ? VARIANT_TRUE : VARIANT_FALSE;
+            break;
+        default:
+        {
+            /* strings, and the string value of node sets */
+            xmlChar *str = xmlXPathCastToString(arg);
+            V_VT(v) = VT_BSTR;
+            V_BSTR(v) = bstr_from_xmlChar(str);
+            xmlFree(str);
+            break;
+        }
+        }
+        xmlXPathFreeObject(arg);
+    }
+
+    VariantInit(&result);
+    hr = IDispatch_GetIDsOfNames(obj, &IID_NULL, &nameW, 1, LOCALE_USER_DEFAULT, &dispid);
+    if (SUCCEEDED(hr))
+        hr = IDispatch_Invoke(obj, dispid, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD | DISPATCH_PROPERTYGET,
+                &params, &result, NULL, NULL);
+
+    for (i = 0; i < nargs; i++)
+        VariantClear(&params.rgvarg[i]);
+    free(params.rgvarg);
+    SysFreeString(nameW);
+
+    if (FAILED(hr))
+    {
+        WARN("extension function %s failed: %#lx\n", debugstr_a((const char *)xctx->function), hr);
+        xmlXPathErr(pctxt, XPATH_EXPR_ERROR);
+        return;
+    }
+
+    switch (V_VT(&result))
+    {
+    case VT_BOOL:
+        valuePush(pctxt, xmlXPathNewBoolean(V_BOOL(&result) != VARIANT_FALSE));
+        break;
+    case VT_I1: case VT_I2: case VT_I4: case VT_I8: case VT_INT:
+    case VT_UI1: case VT_UI2: case VT_UI4: case VT_UI8: case VT_UINT:
+    case VT_R4: case VT_R8: case VT_CY: case VT_DECIMAL:
+    {
+        VARIANT num;
+        V_VT(&num) = VT_EMPTY;
+        if (SUCCEEDED(VariantChangeType(&num, &result, 0, VT_R8)))
+            valuePush(pctxt, xmlXPathNewFloat(V_R8(&num)));
+        else
+            valuePush(pctxt, xmlXPathNewFloat(xmlXPathNAN));
+        break;
+    }
+    case VT_EMPTY:
+    case VT_NULL:
+        valuePush(pctxt, xmlXPathNewString((const xmlChar *)""));
+        break;
+    default:
+    {
+        VARIANT str;
+        V_VT(&str) = VT_EMPTY;
+        if (SUCCEEDED(VariantChangeType(&str, &result, 0, VT_BSTR)))
+        {
+            xmlChar *utf8 = xmlchar_from_wchar(V_BSTR(&str));
+            valuePush(pctxt, xmlXPathNewString(utf8));
+            free(utf8);
+            VariantClear(&str);
+        }
+        else
+        {
+            WARN("result type %d not supported\n", V_VT(&result));
+            xmlXPathErr(pctxt, XPATH_EXPR_ERROR);
+        }
+        break;
+    }
+    }
+    VariantClear(&result);
+}
+
+static xmlXPathFunction xsl_ext_lookup_func(void *data, const xmlChar *name, const xmlChar *ns_uri)
+{
+    struct xsl_ext_lookup *lookup = data;
+
+    if (xsl_ext_find_object(lookup->objects, ns_uri))
+        return xsl_ext_function;
+    return lookup->old_func ? lookup->old_func(lookup->old_data, name, ns_uri) : NULL;
+}
+
 HRESULT node_transform_node_params(const xmlnode *This, IXMLDOMNode *stylesheet, BSTR *p,
     ISequentialStream *stream, const struct xslprocessor_params *params)
 {
@@ -1516,9 +1671,14 @@ HRESULT node_transform_node_params(const xmlnode *This, IXMLDOMNode *stylesheet,
     if (xsltSS)
     {
         const char **xslparams = NULL;
+        BOOL *xslexpr = NULL;
         xmlDocPtr result;
         xmlChar *mode = NULL, *mode_uri = NULL;
         unsigned int i;
+        BOOL has_objects = params && !list_empty(&params->objects);
+#ifdef SG_MUTANT_XSLOBJECT
+        has_objects = FALSE;
+#endif
 
         /* convert our parameter list to libxml2 format */
         if (params && params->count)
@@ -1527,8 +1687,10 @@ HRESULT node_transform_node_params(const xmlnode *This, IXMLDOMNode *stylesheet,
 
             i = 0;
             xslparams = malloc((params->count * 2 + 1) * sizeof(char*));
+            xslexpr = calloc(params->count, sizeof(*xslexpr));
             LIST_FOR_EACH_ENTRY(par, &params->list, struct xslprocessor_par, entry)
             {
+                xslexpr[i / 2] = par->is_expr;
                 xslparams[i++] = (char*)xmlchar_from_wchar(par->name);
                 xslparams[i++] = (char*)xmlchar_from_wchar(par->value);
             }
@@ -1540,12 +1702,31 @@ HRESULT node_transform_node_params(const xmlnode *This, IXMLDOMNode *stylesheet,
         if (params && params->start_mode_uri)
             mode_uri = xmlchar_from_wchar(params->start_mode_uri);
 
-        if (xslparams || mode)
+        if (xslparams || mode || has_objects)
         {
             xsltTransformContextPtr ctxt = xsltNewTransformContext(xsltSS, This->node->doc);
+            struct xsl_ext_lookup ext_lookup;
+
+            if (has_objects)
+            {
+                ext_lookup.old_func = ctxt->xpathCtxt->funcLookupFunc;
+                ext_lookup.old_data = ctxt->xpathCtxt->funcLookupData;
+                ext_lookup.objects = &params->objects;
+                xmlXPathRegisterFuncLookup(ctxt->xpathCtxt, xsl_ext_lookup_func, &ext_lookup);
+            }
 
             /* push parameters to user context */
-            if (xslparams) xsltQuoteUserParams(ctxt, xslparams);
+            if (xslparams)
+            {
+                /* strings are quoted, numbers and booleans are evaluated as XPath */
+                for (i = 0; xslparams[i]; i += 2)
+                {
+                    if (xslexpr[i / 2])
+                        xsltEvalOneUserParam(ctxt, (const xmlChar *)xslparams[i], (const xmlChar *)xslparams[i + 1]);
+                    else
+                        xsltQuoteOneUserParam(ctxt, (const xmlChar *)xslparams[i], (const xmlChar *)xslparams[i + 1]);
+                }
+            }
 #ifndef SG_MUTANT_START_MODE
             /* the mode in which the transformation starts */
             ctxt->mode = mode;
@@ -1559,6 +1740,7 @@ HRESULT node_transform_node_params(const xmlnode *This, IXMLDOMNode *stylesheet,
                 for (i = 0; i < params->count*2; i++)
                     free((char*)xslparams[i]);
                 free(xslparams);
+                free(xslexpr);
             }
         }
         else
diff --git a/dlls/msxml3/stylesheet.c b/dlls/msxml3/stylesheet.c
index 8d88c13..4de6b3f 100644
--- a/dlls/msxml3/stylesheet.c
+++ b/dlls/msxml3/stylesheet.c
@@ -21,6 +21,9 @@
 #define COBJMACROS
 
 #include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <math.h>
 #include <libxml/parser.h>
 #include <libxml/xmlerror.h>
 
@@ -91,6 +94,19 @@ static inline xslprocessor *impl_from_IXSLProcessor( IXSLProcessor *iface )
     return CONTAINING_RECORD(iface, xslprocessor, IXSLProcessor_iface);
 }
 
+static void xslprocessor_free_objects(struct xslprocessor_params *params)
+{
+    struct xslprocessor_object *obj, *obj2;
+
+    LIST_FOR_EACH_ENTRY_SAFE(obj, obj2, &params->objects, struct xslprocessor_object, entry)
+    {
+        list_remove(&obj->entry);
+        IDispatch_Release(obj->obj);
+        SysFreeString(obj->uri);
+        free(obj);
+    }
+}
+
 static void xslprocessor_par_free(struct xslprocessor_params *params, struct xslprocessor_par *par)
 {
     params->count--;
@@ -348,6 +364,7 @@ static ULONG WINAPI xslprocessor_Release( IXSLProcessor *iface )
 
         LIST_FOR_EACH_ENTRY_SAFE(par, par2, &This->params.list, struct xslprocessor_par, entry)
             xslprocessor_par_free(&This->params, par);
+        xslprocessor_free_objects(&This->params);
 
         SysFreeString(This->params.start_mode);
         SysFreeString(This->params.start_mode_uri);
@@ -752,9 +769,34 @@ static HRESULT WINAPI xslprocessor_get_readyState(
     return S_OK;
 }
 
+/* XPath 1.0 has no exponent notation, so numbers are written out in full */
+static BSTR xslprocessor_number_expr(double d)
+{
+    WCHAR buf[400];
+    char tmp[400];
+
+    if (isnan(d)) return SysAllocString(L"number('NaN')");
+    if (isinf(d)) return SysAllocString(d > 0 ? L"1 div 0" : L"-1 div 0");
+
+    snprintf(tmp, sizeof(tmp), "%.17g", d);
+    if (strpbrk(tmp, "eE"))
+    {
+        char *end;
+        snprintf(tmp, sizeof(tmp), "%.20f", d);
+        end = tmp + strlen(tmp);
+        while (end > tmp && end[-1] == '0') *--end = 0;
+        if (end > tmp && end[-1] == '.') *--end = 0;
+    }
+    MultiByteToWideChar(CP_ACP, 0, tmp, -1, buf, ARRAY_SIZE(buf));
+    return SysAllocString(buf);
+}
+
 static HRESULT xslprocessor_set_parvalue(const VARIANT *var, struct xslprocessor_par *par)
 {
     HRESULT hr = S_OK;
+    VARIANT tmp;
+
+    par->is_expr = FALSE;
 
     switch (V_VT(var))
     {
@@ -764,6 +806,34 @@ static HRESULT xslprocessor_set_parvalue(const VARIANT *var, struct xslprocessor
         if (!par->value) hr = E_OUTOFMEMORY;
         break;
     }
+#ifndef SG_MUTANT_XSLPAR_TYPES
+    case VT_BOOL:
+        par->is_expr = TRUE;
+        par->value = SysAllocString(V_BOOL(var) ? L"true()" : L"false()");
+        if (!par->value) hr = E_OUTOFMEMORY;
+        break;
+    case VT_I1: case VT_I2: case VT_I4: case VT_I8: case VT_INT:
+    case VT_UI1: case VT_UI2: case VT_UI4: case VT_UI8: case VT_UINT:
+    case VT_R4: case VT_R8: case VT_CY: case VT_DECIMAL:
+    {
+        V_VT(&tmp) = VT_EMPTY;
+        hr = VariantChangeType(&tmp, var, 0, VT_R8);
+        if (FAILED(hr)) break;
+        par->is_expr = TRUE;
+        par->value = xslprocessor_number_expr(V_R8(&tmp));
+        if (!par->value) hr = E_OUTOFMEMORY;
+        break;
+    }
+    case VT_DATE:
+    {
+        /* other simple types are passed as their string form */
+        V_VT(&tmp) = VT_EMPTY;
+        hr = VariantChangeType(&tmp, var, 0, VT_BSTR);
+        if (FAILED(hr)) break;
+        par->value = V_BSTR(&tmp);
+        break;
+    }
+#endif
     default:
         FIXME("value type %d not handled\n", V_VT(var));
         hr = E_NOTIMPL;
@@ -839,9 +909,36 @@ static HRESULT WINAPI xslprocessor_addObject(
     BSTR uri)
 {
     xslprocessor *This = impl_from_IXSLProcessor( iface );
+    struct xslprocessor_object *cur, *entry;
+
+    TRACE("(%p)->(%p %s)\n", This, obj, debugstr_w(uri));
+
+    if (!obj || !uri || !*uri) return E_INVALIDARG;
+
+    /* one object per namespace: a new one replaces the old one */
+    LIST_FOR_EACH_ENTRY(cur, &This->params.objects, struct xslprocessor_object, entry)
+    {
+        if (!wcscmp(cur->uri, uri))
+        {
+            IDispatch_AddRef(obj);
+            IDispatch_Release(cur->obj);
+            cur->obj = obj;
+            return S_OK;
+        }
+    }
 
-    FIXME("(%p)->(%p %s): stub\n", This, obj, debugstr_w(uri));
-    return E_NOTIMPL;
+    entry = malloc(sizeof(*entry));
+    if (!entry) return E_OUTOFMEMORY;
+    entry->uri = SysAllocString(uri);
+    if (!entry->uri)
+    {
+        free(entry);
+        return E_OUTOFMEMORY;
+    }
+    IDispatch_AddRef(obj);
+    entry->obj = obj;
+    list_add_tail(&This->params.objects, &entry->entry);
+    return S_OK;
 }
 
 static HRESULT WINAPI xslprocessor_get_stylesheet(
@@ -912,6 +1009,7 @@ HRESULT XSLProcessor_create(xsltemplate *template, IXSLProcessor **ppObj)
     This->outstr = NULL;
     This->transformed = FALSE;
     list_init(&This->params.list);
+    list_init(&This->params.objects);
     This->params.count = 0;
     This->params.start_mode = NULL;
     This->params.start_mode_uri = NULL;
