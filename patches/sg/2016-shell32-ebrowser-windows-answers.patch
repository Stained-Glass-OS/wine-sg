+/**************************************************************************
+ * IServiceProvider Implementation
+ */
+static inline ExplorerBrowserImpl *impl_from_IServiceProvider(IServiceProvider *iface)
+{
+    return CONTAINING_RECORD(iface, ExplorerBrowserImpl, IServiceProvider_iface);
+}
+
+static HRESULT WINAPI IServiceProvider_fnQueryInterface(IServiceProvider *iface, REFIID riid, void **ppv)
+{
+    ExplorerBrowserImpl *This = impl_from_IServiceProvider(iface);
+    return IExplorerBrowser_QueryInterface(&This->IExplorerBrowser_iface, riid, ppv);
+}
+
+static ULONG WINAPI IServiceProvider_fnAddRef(IServiceProvider *iface)
+{
+    ExplorerBrowserImpl *This = impl_from_IServiceProvider(iface);
+    return IExplorerBrowser_AddRef(&This->IExplorerBrowser_iface);
+}
+
+static ULONG WINAPI IServiceProvider_fnRelease(IServiceProvider *iface)
+{
+    ExplorerBrowserImpl *This = impl_from_IServiceProvider(iface);
+    return IExplorerBrowser_Release(&This->IExplorerBrowser_iface);
+}
+
+static HRESULT WINAPI IServiceProvider_fnQueryService(IServiceProvider *iface, REFGUID guid, REFIID riid, void **ppv)
+{
+    ExplorerBrowserImpl *This = impl_from_IServiceProvider(iface);
+    IServiceProvider *site_sp;
+    HRESULT hr;
+
+    TRACE("%p (%s, %s, %p)\n", This, shdebugstr_guid(guid), shdebugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+
+    /* the browser itself is the shell browser of what it shows */
+#ifdef SG_MUTANT_EB_SERVICE
+    if (0)
+#else
+    if (IsEqualGUID(guid, &SID_SShellBrowser) || IsEqualGUID(guid, &SID_STopLevelBrowser))
+#endif
+        return IShellBrowser_QueryInterface(&This->IShellBrowser_iface, riid, ppv);
+
+    /* anything else is the site's to give */
+    if (This->punk_site && SUCCEEDED(hr = IUnknown_QueryInterface(This->punk_site, &IID_IServiceProvider, (void **)&site_sp)))
+    {
+        hr = IServiceProvider_QueryService(site_sp, guid, riid, ppv);
+        IServiceProvider_Release(site_sp);
+        return hr;
+    }
+    return E_NOINTERFACE;
+}
+
+static const IServiceProviderVtbl vt_IServiceProvider = {
+    IServiceProvider_fnQueryInterface,
+    IServiceProvider_fnAddRef,
+    IServiceProvider_fnRelease,
+    IServiceProvider_fnQueryService
+};
+
+/**************************************************************************
+ * IConnectionPointContainer / IConnectionPoint: the one connection point is
+ * for IExplorerBrowserEvents, the same list IExplorerBrowser::Advise fills.
+ */
+static inline ExplorerBrowserImpl *impl_from_IConnectionPointContainer(IConnectionPointContainer *iface)
+{
+    return CONTAINING_RECORD(iface, ExplorerBrowserImpl, IConnectionPointContainer_iface);
+}
+
+static inline ExplorerBrowserImpl *impl_from_IConnectionPoint(IConnectionPoint *iface)
+{
+    return CONTAINING_RECORD(iface, ExplorerBrowserImpl, IConnectionPoint_iface);
+}
+
+static HRESULT WINAPI IConnectionPointContainer_fnQueryInterface(IConnectionPointContainer *iface, REFIID riid, void **ppv)
+{
+    ExplorerBrowserImpl *This = impl_from_IConnectionPointContainer(iface);
+    return IExplorerBrowser_QueryInterface(&This->IExplorerBrowser_iface, riid, ppv);
+}
+
+static ULONG WINAPI IConnectionPointContainer_fnAddRef(IConnectionPointContainer *iface)
+{
+    ExplorerBrowserImpl *This = impl_from_IConnectionPointContainer(iface);
+    return IExplorerBrowser_AddRef(&This->IExplorerBrowser_iface);
+}
+
+static ULONG WINAPI IConnectionPointContainer_fnRelease(IConnectionPointContainer *iface)
+{
+    ExplorerBrowserImpl *This = impl_from_IConnectionPointContainer(iface);
+    return IExplorerBrowser_Release(&This->IExplorerBrowser_iface);
+}
+
+static HRESULT WINAPI IConnectionPointContainer_fnEnumConnectionPoints(IConnectionPointContainer *iface,
+                                                                       IEnumConnectionPoints **ppEnum)
+{
+    ExplorerBrowserImpl *This = impl_from_IConnectionPointContainer(iface);
+    FIXME("stub, %p (%p)\n", This, ppEnum);
+    if (ppEnum) *ppEnum = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI IConnectionPointContainer_fnFindConnectionPoint(IConnectionPointContainer *iface,
+                                                                      REFIID riid, IConnectionPoint **ppCP)
+{
+    ExplorerBrowserImpl *This = impl_from_IConnectionPointContainer(iface);
+    TRACE("%p (%s, %p)\n", This, shdebugstr_guid(riid), ppCP);
+
+    if (!ppCP) return E_POINTER;
+    *ppCP = NULL;
+    if (!IsEqualIID(riid, &IID_IExplorerBrowserEvents)) return CONNECT_E_NOCONNECTION;
+    *ppCP = &This->IConnectionPoint_iface;
+    IConnectionPoint_AddRef(*ppCP);
+    return S_OK;
+}
+
+static const IConnectionPointContainerVtbl vt_IConnectionPointContainer = {
+    IConnectionPointContainer_fnQueryInterface,
+    IConnectionPointContainer_fnAddRef,
+    IConnectionPointContainer_fnRelease,
+    IConnectionPointContainer_fnEnumConnectionPoints,
+    IConnectionPointContainer_fnFindConnectionPoint
+};
+
+static HRESULT WINAPI IConnectionPoint_fnQueryInterface(IConnectionPoint *iface, REFIID riid, void **ppv)
+{
+    ExplorerBrowserImpl *This = impl_from_IConnectionPoint(iface);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IConnectionPoint))
+    {
+        *ppv = &This->IConnectionPoint_iface;
+        IConnectionPoint_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI IConnectionPoint_fnAddRef(IConnectionPoint *iface)
+{
+    ExplorerBrowserImpl *This = impl_from_IConnectionPoint(iface);
+    return IExplorerBrowser_AddRef(&This->IExplorerBrowser_iface);
+}
+
+static ULONG WINAPI IConnectionPoint_fnRelease(IConnectionPoint *iface)
+{
+    ExplorerBrowserImpl *This = impl_from_IConnectionPoint(iface);
+    return IExplorerBrowser_Release(&This->IExplorerBrowser_iface);
+}
+
+static HRESULT WINAPI IConnectionPoint_fnGetConnectionInterface(IConnectionPoint *iface, IID *pIID)
+{
+    if (!pIID) return E_POINTER;
+    *pIID = IID_IExplorerBrowserEvents;
+    return S_OK;
+}
+
+static HRESULT WINAPI IConnectionPoint_fnGetConnectionPointContainer(IConnectionPoint *iface,
+                                                                     IConnectionPointContainer **ppCPC)
+{
+    ExplorerBrowserImpl *This = impl_from_IConnectionPoint(iface);
+
+    if (!ppCPC) return E_POINTER;
+    *ppCPC = &This->IConnectionPointContainer_iface;
+    IConnectionPointContainer_AddRef(*ppCPC);
+    return S_OK;
+}
+
+static HRESULT WINAPI IConnectionPoint_fnAdvise(IConnectionPoint *iface, IUnknown *pUnkSink, DWORD *pdwCookie)
+{
+    ExplorerBrowserImpl *This = impl_from_IConnectionPoint(iface);
+    IExplorerBrowserEvents *sink;
+    HRESULT hr;
+
+    TRACE("%p (%p, %p)\n", This, pUnkSink, pdwCookie);
+
+    if (!pUnkSink || !pdwCookie) return E_POINTER;
+    if (FAILED(hr = IUnknown_QueryInterface(pUnkSink, &IID_IExplorerBrowserEvents, (void **)&sink)))
+        return CONNECT_E_CANNOTCONNECT;
+#ifdef SG_MUTANT_EB_CP_NOADVISE
+    *pdwCookie = 1, hr = S_OK;
+#else
+    hr = IExplorerBrowser_Advise(&This->IExplorerBrowser_iface, sink, pdwCookie);
+#endif
+    IExplorerBrowserEvents_Release(sink);
+    return hr;
+}
+
+static HRESULT WINAPI IConnectionPoint_fnUnadvise(IConnectionPoint *iface, DWORD dwCookie)
+{
+    ExplorerBrowserImpl *This = impl_from_IConnectionPoint(iface);
+
+    TRACE("%p (0x%lx)\n", This, dwCookie);
+
+    return IExplorerBrowser_Unadvise(&This->IExplorerBrowser_iface, dwCookie) == S_OK ? S_OK : CONNECT_E_NOCONNECTION;
+}
+
+static HRESULT WINAPI IConnectionPoint_fnEnumConnections(IConnectionPoint *iface, IEnumConnections **ppEnum)
+{
+    ExplorerBrowserImpl *This = impl_from_IConnectionPoint(iface);
+    FIXME("stub, %p (%p)\n", This, ppEnum);
+    if (ppEnum) *ppEnum = NULL;
+    return E_NOTIMPL;
+}
+
+static const IConnectionPointVtbl vt_IConnectionPoint = {
+    IConnectionPoint_fnQueryInterface,
+    IConnectionPoint_fnAddRef,
+    IConnectionPoint_fnRelease,
+    IConnectionPoint_fnGetConnectionInterface,
+    IConnectionPoint_fnGetConnectionPointContainer,
+    IConnectionPoint_fnAdvise,
+    IConnectionPoint_fnUnadvise,
+    IConnectionPoint_fnEnumConnections
+};
