From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: EMF+ image effect objects are played; images drawn without image attributes play

EmfPlusSerializableObject records ([MS-EMFPLUS] 2.3.5.2: an image effect's GUID and parameters) were 'Not implemented for EMF+ record type 56': the effect is now created (GdipCreateEffect, GdipSetEffectParameters) and kept for the playback, and a DrawImagePoints record with the E flag (2.3.4.9; was a FIXME) draws a copy of its image through it; a later object replaces it, the playback's end drops it. And DrawImage/DrawImagePoints refused an ImageAttributesID that names no image attributes object (InvalidParameter), which is how GDI+ records an image drawn without attributes (-1): a metafile's plain images were never played back. The attributes are optional and such a draw uses none. (EmfPlusSetTSGraphics/SetTSClip are not played: Windows never writes them, [MS-EMFPLUS] <29> <30>.)
---
--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -691,6 +691,8 @@
 {
     unsigned int i;
 
+    if (metafile->pending_effect) GdipDeleteEffect(metafile->pending_effect);
+
     free(metafile->comment_data);
     DeleteEnhMetaFile(CloseEnhMetaFile(metafile->record_dc));
     if (!metafile->preserve_hemf)
@@ -3051,6 +3053,30 @@
     return metafile->objtable[brush_id].u.brush;
 }
 
+/* wine-sg 9505: an image of a played-back EmfPlusDrawImage(Points) record; with EFFECT (a DrawImagePoints
+ * record's E flag, [MS-EMFPLUS] 2.3.4.9) through the effect of the latest EmfPlusSerializableObject record
+ * (2.3.5.2): the effect works on a copy of the bitmap, as GdipDrawImageFX does */
+static GpStatus metafile_draw_image(GpMetafile *metafile, GpImage *image, const GpPointF *points, REAL srcx,
+        REAL srcy, REAL srcwidth, REAL srcheight, GpUnit srcunit, GpImageAttributes *attrs, BOOL apply)
+{
+    CGpEffect *effect = apply ? metafile->pending_effect : NULL;
+    GpBitmap *processed = NULL;
+    GpStatus stat;
+
+    if (apply && !effect) WARN("no image effect object for the image\n");
+    if (effect && image->type == ImageTypeBitmap &&
+            GdipCloneBitmapAreaI(0, 0, ((GpBitmap *)image)->width, ((GpBitmap *)image)->height,
+                    PixelFormat32bppARGB, (GpBitmap *)image, &processed) == Ok)
+    {
+        if (effect_apply_bitmap(processed, effect, NULL) == Ok)
+            image = &processed->image;
+    }
+    stat = GdipDrawImagePointsRect(metafile->playback_graphics, image, points, 3, srcx, srcy, srcwidth, srcheight,
+            srcunit, attrs, NULL, NULL);
+    if (processed) GdipDisposeImage(&processed->image);
+    return stat;
+}
+
 static GpStatus metafile_play_new_record(GpMetafile *metafile, EmfPlusRecordType type, UINT flags, UINT size,
         const BYTE *data)
 {
@@ -3066,6 +3092,29 @@
 #endif
     switch (type)
     {
+#ifndef SG_MUTANT_GDIP_NO_SERIALIZABLE
+    case EmfPlusRecordTypeSerializableObject:
+    {
+        /* [MS-EMFPLUS] 2.3.5.2: ObjectGUID, BufferSize, Buffer (the effect's parameters) */
+        CGpEffect *effect;
+        GUID guid;
+        UINT len;
+
+        if (size < sizeof(GUID) + sizeof(UINT)) return InvalidParameter;
+        memcpy(&guid, data, sizeof(guid));
+        memcpy(&len, data + sizeof(guid), sizeof(len));
+        if (len > size - sizeof(GUID) - sizeof(UINT)) return InvalidParameter;
+        if ((stat = GdipCreateEffect(guid, &effect)) != Ok) return stat;
+        if ((stat = GdipSetEffectParameters(effect, data + sizeof(GUID) + sizeof(UINT), len)) != Ok)
+        {
+            GdipDeleteEffect(effect);
+            return stat;
+        }
+        if (metafile->pending_effect) GdipDeleteEffect(metafile->pending_effect);
+        metafile->pending_effect = effect;
+        return Ok;
+    }
+#endif
     case EmfPlusRecordTypeComment:
         return Ok;
     case EmfPlusRecordTypeResetClip:
@@ -3629,9 +3678,13 @@
                     (flags & 0x4000 ? sizeof(EmfPlusRect) : sizeof(EmfPlusRectF)))
                 return InvalidParameter;
 
+            /* wine-sg 9505: the image attributes are optional; a draw without them (an ID that names no image
+             * attributes object, -1 as GDI+ records it) is drawn with none instead of failing */
+#ifdef SG_MUTANT_GDIP_ATTRS_REQUIRED
             if (draw->ImageAttributesID >= EmfPlusObjectTableSize ||
                     real_metafile->objtable[draw->ImageAttributesID].type != ObjectTypeImageAttributes)
                 return InvalidParameter;
+#endif
 
             if (flags & 0x4000) /* C */
             {
@@ -3652,9 +3705,11 @@
                 points[2].Y = points[1].Y + draw->RectData.rectF.Height;
             }
 
-            return GdipDrawImagePointsRect(real_metafile->playback_graphics, real_metafile->objtable[image].u.image,
-                points, 3, draw->SrcRect.X, draw->SrcRect.Y, draw->SrcRect.Width, draw->SrcRect.Height, draw->SrcUnit,
-                real_metafile->objtable[draw->ImageAttributesID].u.image_attributes, NULL, NULL);
+            return metafile_draw_image(real_metafile, real_metafile->objtable[image].u.image,
+                points, draw->SrcRect.X, draw->SrcRect.Y, draw->SrcRect.Width, draw->SrcRect.Height, draw->SrcUnit,
+                (draw->ImageAttributesID < EmfPlusObjectTableSize &&
+                 real_metafile->objtable[draw->ImageAttributesID].type == ObjectTypeImageAttributes) ?
+                real_metafile->objtable[draw->ImageAttributesID].u.image_attributes : NULL, FALSE);
         }
         case EmfPlusRecordTypeDrawImagePoints:
         {
@@ -3673,15 +3728,17 @@
                 return InvalidParameter;
             dataSize -= fixed_part_size;
 
+            /* wine-sg 9505: the image attributes are optional; a draw without them (an ID that names no image
+             * attributes object, -1 as GDI+ records it) is drawn with none instead of failing */
+#ifdef SG_MUTANT_GDIP_ATTRS_REQUIRED
             if (draw->ImageAttributesID >= EmfPlusObjectTableSize ||
                     real_metafile->objtable[draw->ImageAttributesID].type != ObjectTypeImageAttributes)
                 return InvalidParameter;
+#endif
 
             if (draw->count != 3)
                 return InvalidParameter;
 
-            if ((flags >> 13) & 1) /* E */
-                FIXME("image effects are not supported.\n");
 
             if ((flags >> 11) & 1) /* P */
                 size = sizeof(EmfPlusPointR7) * draw->count;
@@ -3714,9 +3771,12 @@
             else
                 memcpy(points, draw->PointData.pointsF, sizeof(points));
 
-            return GdipDrawImagePointsRect(real_metafile->playback_graphics, real_metafile->objtable[image].u.image,
-                points, 3, draw->SrcRect.X, draw->SrcRect.Y, draw->SrcRect.Width, draw->SrcRect.Height, draw->SrcUnit,
-                real_metafile->objtable[draw->ImageAttributesID].u.image_attributes, NULL, NULL);
+            return metafile_draw_image(real_metafile, real_metafile->objtable[image].u.image,
+                points, draw->SrcRect.X, draw->SrcRect.Y, draw->SrcRect.Width, draw->SrcRect.Height, draw->SrcUnit,
+                (draw->ImageAttributesID < EmfPlusObjectTableSize &&
+                 real_metafile->objtable[draw->ImageAttributesID].type == ObjectTypeImageAttributes) ?
+                real_metafile->objtable[draw->ImageAttributesID].u.image_attributes : NULL,
+                (flags >> 13) & 1 /* E */);
         }
         case EmfPlusRecordTypeFillPath:
         {
@@ -4368,6 +4428,12 @@
         GdipEndContainer(graphics, state);
     }
 
+    /* an image effect object lasts for its playback, like the object table */
+    if (real_metafile->pending_effect)
+    {
+        GdipDeleteEffect(real_metafile->pending_effect);
+        real_metafile->pending_effect = NULL;
+    }
     real_metafile->playback_graphics = NULL;
 
     return stat;
--- a/dlls/gdiplus/gdiplus_private.h
+++ b/dlls/gdiplus/gdiplus_private.h
@@ -494,6 +494,7 @@
     GpRegion *clip; /* clip region within the metafile */
     struct list containers;
     struct emfplus_object objtable[EmfPlusObjectTableSize];
+    CGpEffect *pending_effect; /* the latest EmfPlusSerializableObject's effect during playback (wine-sg 9505) */
 };
 
 struct GpBitmap{
