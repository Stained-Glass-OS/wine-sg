From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: emoji fall back to the emoji fonts and are drawn as emoji

Issue #15 (live ISO): emoji showed as boxes. DirectWrite's system font
fallback had no entry for emoji or symbols, so every DirectWrite program
-- Chromium-based browsers (Skia), WinUI, Direct2D text -- found no font
for them. As Windows' fallback gives them to Segoe UI Emoji and Segoe UI
Symbol, they now go to those, and where they are not installed to the
colour emoji font Stained Glass ships (Noto Color Emoji), then Symbola;
mathematical alphanumerics, letterlike and technical symbols, box drawing
and Braille to Segoe UI Symbol, Symbola, Noto Sans Symbols2, Noto Sans
Math. With the colour emoji font in place, four more things kept emoji
from drawing right: a CBDT font's strikes are what their index subtables'
image format says (17-19 are PNG), not what their bit depth suggests --
Noto Color Emoji's 32-bit strike was reported as BGRA and Direct2D took it
for no colour font and drew nothing; a bitmap-only glyph had no advance at
all (FreeType gives such a face no units per em, and no scalable size) --
text layout stacked every emoji on the next character; a character
followed by the emoji presentation selector U+FE0F (red heart, U+2764
U+FE0F) is drawn from the emoji font even when the base font has a text
glyph for it, as on Windows, and a variation selector stays with its
character in a fallback run; and a default-ignorable character the font
has no glyph for (U+FE0F, joiners) is invisible and takes no room, as
Windows and HarfBuzz draw it, not a missing-glyph box. Gate:
test/emojifallback-gate.sh. Mutants: SG_MUTANT_NO_EMOJI_FALLBACK,
SG_MUTANT_CBLC_BY_DEPTH, SG_MUTANT_BITMAP_ADVANCE_ZERO,
SG_MUTANT_NO_EMOJI_PRESENTATION, SG_MUTANT_IGNORABLE_NOTDEF.
---
--- a/dlls/dwrite/analyzer.c
+++ b/dlls/dwrite/analyzer.c
@@ -357,6 +357,27 @@
     { "FF00-FFEF",              L"Noto Sans CJK TC", L"zh-Hant" },
     { "FF00-FFEF",              L"Noto Sans CJK KR", L"ko" },
     { "FF00-FFEF",              L"Noto Sans CJK JP" },
+
+#ifndef SG_MUTANT_NO_EMOJI_FALLBACK
+    /* Stained Glass OS (issue #15): emoji and symbols, as Windows' fallback gives them to
+     * Segoe UI Emoji and Segoe UI Symbol. Where those are not installed, the colour emoji
+     * font Stained Glass ships (Noto Color Emoji), then Symbola (monochrome); the arrows,
+     * shapes and technical signs a colour emoji font lacks go on to the symbol fonts.
+     * There was no entry: Chromium-based browsers and every other DirectWrite program
+     * drew emoji as missing-glyph boxes. */
+    { "1F000-1F0FF, 1F100-1F1FF, 1F200-1F2FF, 1F300-1F5FF, 1F600-1F64F, 1F650-1F67F, "
+      "1F680-1F6FF, 1F700-1F77F, 1F780-1F7FF, 1F800-1F8FF, 1F900-1F9FF, 1FA00-1FAFF, "
+      "E0020-E007F, 200D, 20E3",
+      L"Segoe UI Emoji, Noto Color Emoji, Segoe UI Symbol, Symbola" },
+    { "2600-26FF, 2700-27BF, 2B00-2BFF, 2300-23FF, 2190-21FF, 25A0-25FF, 2900-297F, "
+      "203C, 2049, 2122, 2139, 24C2, 3030, 303D, 3297, 3299",
+      L"Segoe UI Emoji, Noto Color Emoji, Segoe UI Symbol, Symbola" },
+    /* letterlike symbols, number forms, mathematical operators and alphanumerics, enclosed
+     * alphanumerics, box drawing, Braille, chess and the other symbol blocks */
+    { "2100-214F, 2150-218F, 2200-22FF, 2460-24FF, 2500-257F, 2580-259F, 27C0-27EF, "
+      "27F0-27FF, 2800-28FF, 2980-29FF, 2A00-2AFF, 1D400-1D7FF, 1D100-1D1FF, 1F780-1F7FF",
+      L"Segoe UI Symbol, Symbola, Noto Sans Symbols2, Noto Sans Math" },
+#endif
 };
 
 struct text_source_context
@@ -2770,7 +2791,8 @@
     mapped = text_source_get_char_length(&context);
     while (!text_source_get_next_u32_char(&context))
     {
-        if (find_fallback_mapping(data, locale, context.ch) != mapping) break;
+        /* Stained Glass OS: a variation selector goes with the character before it */
+        if (!fallback_is_uvs(&context) && find_fallback_mapping(data, locale, context.ch) != mapping) break;
         mapped += text_source_get_char_length(&context);
     }
 
@@ -2867,6 +2889,34 @@
     if (!basecollection)
         basecollection = fallback->systemcollection;
 
+#ifndef SG_MUTANT_NO_EMOJI_PRESENTATION
+    /* Stained Glass OS (issue #15): a character with the emoji presentation selector after it
+     * (U+FE0F: "red heart" is U+2764 U+FE0F) is drawn as an emoji, from the fallback's emoji font, as
+     * on Windows -- even when the base font has a text glyph for it. The base font took the heart and
+     * left the selector alone, drawn as a missing-glyph box. */
+    {
+        const WCHAR *text = NULL;
+        UINT32 avail = 0, i, step = 1;
+
+        if (SUCCEEDED(IDWriteTextAnalysisSource_GetTextAtPosition(source, position, &text, &avail)) && text)
+        {
+            avail = min(avail, length);
+            for (i = 0; i < avail; i += step)
+            {
+                step = (i + 1 < avail && IS_HIGH_SURROGATE(text[i]) && IS_LOW_SURROGATE(text[i + 1])) ? 2 : 1;
+                if (i + step < avail && text[i + step] == 0xfe0f) break;
+            }
+            if (i < avail)
+            {
+                if (!i)
+                    return fallback_map_characters(fallback, source, position, length, weight, style, stretch,
+                            ret_font, mapped_length, scale);
+                length = i;  /* the base font up to the emoji */
+            }
+        }
+    }
+#endif
+
     if (basefamily && *basefamily)
     {
         if (SUCCEEDED(create_matching_font(basecollection, basefamily, weight, style, stretch,
--- a/dlls/dwrite/opentype.c
+++ b/dlls/dwrite/opentype.c
@@ -3174,11 +3174,25 @@
         for (i = 0; i < num_sizes; ++i)
         {
             BYTE bpp = sizes[i].bit_depth;
+            unsigned int array_offset = GET_BE_DWORD(sizes[i].indexSubTableArrayOffset);
+            unsigned int count = GET_BE_DWORD(sizes[i].numberofIndexSubTables), j;
+            BOOL png = FALSE;
 
             if ((ret & format_mask) == format_mask)
                 break;
 
-            if (bpp == 1 || bpp == 2 || bpp == 4 || bpp == 8)
+#ifndef SG_MUTANT_CBLC_BY_DEPTH
+            /* Stained Glass OS (issue #15): what a strike's glyphs are is its index subtables' image
+             * format -- 17, 18 and 19 are PNG -- not its bit depth. Noto Color Emoji's 32-bit strike
+             * is PNG and was reported as BGRA: Direct2D took it for no colour font and drew nothing. */
+            for (j = 0; j < count && !png; ++j)
+            {
+                unsigned int sub = array_offset + table_read_be_dword(&cblc, array_offset + j * 8 + 4);
+                unsigned int image_format = table_read_be_word(&cblc, sub + 2);
+                if (image_format >= 17 && image_format <= 19) png = TRUE;
+            }
+#endif
+            if (png || bpp == 1 || bpp == 2 || bpp == 4 || bpp == 8)
                 ret |= DWRITE_GLYPH_IMAGE_FORMATS_PNG;
             else if (bpp == 32)
                 ret |= DWRITE_GLYPH_IMAGE_FORMATS_PREMULTIPLIED_B8G8R8A8;
@@ -6521,6 +6535,16 @@
         }
         if (opentype_is_zero_width(codepoint))
             context->u.buffer.glyph_props[g].isZeroWidthSpace = 1;
+#ifndef SG_MUTANT_IGNORABLE_NOTDEF
+        /* Stained Glass OS (issue #15): a default-ignorable character the font has no glyph for --
+         * the emoji presentation selector U+FE0F after an emoji, a joiner -- is invisible and takes
+         * no room, as Windows draws it (HarfBuzz does the same), not the font's missing-glyph box */
+        else if ((context->glyph_infos[g].props & GLYPH_PROP_IGNORABLE) && !context->u.buffer.glyphs[g])
+        {
+            context->u.buffer.glyphs[g] = font->get_glyph(context->cache->context, ' ');
+            context->u.buffer.glyph_props[g].isZeroWidthSpace = 1;
+        }
+#endif
 
         context->u.buffer.glyph_props[g].components = 1;
         context->glyph_count++;
--- a/dlls/dwrite/freetype.c
+++ b/dlls/dwrite/freetype.c
@@ -110,6 +110,22 @@
     return size;
 }
 
+/* Stained Glass OS (issue #15): a glyph's hmtx advance at EMSIZE. A bitmap-only face (Noto Color
+ * Emoji) has no units_per_EM in FreeType's face; its head table has. */
+static int freetype_hmtx_advance(FT_Face face, FT_UInt glyph, float emsize)
+{
+    unsigned int upem = face->units_per_EM;
+    FT_Fixed advance = 0;
+
+    if (!upem)
+    {
+        const TT_Header *head = pFT_Get_Sfnt_Table(face, FT_SFNT_HEAD);
+        if (head) upem = head->Units_Per_EM;
+    }
+    if (!upem || pFT_Get_Advance(face, glyph, FT_LOAD_NO_SCALE, &advance)) return 0;
+    return (int)(advance * emsize / upem + 0.5f);
+}
+
 static BOOL freetype_glyph_has_contours(FT_Face face)
 {
     return face->glyph->format == FT_GLYPH_FORMAT_OUTLINE && face->glyph->outline.n_contours;
@@ -800,13 +816,32 @@
     *params->has_contours = FALSE;
 
     if (!(size = freetype_set_face_size(face, params->emsize)))
+    {
+#ifndef SG_MUTANT_BITMAP_ADVANCE_ZERO
+        /* Stained Glass OS (issue #15): a bitmap-only font (Noto Color Emoji: CBDT strikes, no
+         * outlines) has no scalable size, so its glyphs had no advance at all: text layout put every
+         * emoji at the same place as the next character, and a centred one half its width too far
+         * right. Its hmtx advance, scaled to the size asked for, as for an outline glyph. */
+        *params->advance = freetype_hmtx_advance(face, params->glyph, params->emsize);
+        return STATUS_SUCCESS;
+#else
         return STATUS_UNSUCCESSFUL;
+#endif
+    }
 
     if (!pFT_Load_Glyph(face, params->glyph, params->mode == DWRITE_MEASURING_MODE_NATURAL ? FT_LOAD_NO_HINTING : 0))
     {
         *params->advance = face->glyph->advance.x >> 6;
         *params->has_contours = freetype_glyph_has_contours(face);
     }
+#ifndef SG_MUTANT_BITMAP_ADVANCE_ZERO
+    if (!FT_IS_SCALABLE(face))
+    {
+        /* a bitmap-only glyph: its strike's bitmap says nothing of the size asked for (it loaded
+         * with no advance at all) -- its hmtx advance, scaled */
+        *params->advance = freetype_hmtx_advance(face, params->glyph, params->emsize);
+    }
+#endif
 
     pFT_Done_Size(size);
 
