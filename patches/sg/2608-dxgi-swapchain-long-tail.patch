+    /* The waitable object starts signalled: the application may render
+     * max_latency frames before the first one has been presented. */
+    if (flags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT)
+        state->latency_semaphore = CreateSemaphoreW(NULL, max_latency, DXGI_MAX_SWAP_CHAIN_BUFFERS, NULL);
+}
+
+void dxgi_swapchain_state_cleanup(struct dxgi_swapchain_state *state)
+{
+    if (state->latency_semaphore)
+        CloseHandle(state->latency_semaphore);
+    state->latency_semaphore = NULL;
+}
+
+/* Validates the arguments of Present() beyond the sync interval. */
+HRESULT dxgi_swapchain_state_check_present(const struct dxgi_swapchain_state *state,
+        UINT sync_interval, UINT flags)
+{
+    static const UINT known = DXGI_PRESENT_TEST | DXGI_PRESENT_DO_NOT_SEQUENCE | DXGI_PRESENT_RESTART
+            | DXGI_PRESENT_DO_NOT_WAIT | DXGI_PRESENT_STEREO_PREFER_RIGHT | DXGI_PRESENT_STEREO_TEMPORARY_MONO
+            | DXGI_PRESENT_RESTRICT_TO_OUTPUT | DXGI_PRESENT_USE_DURATION | DXGI_PRESENT_ALLOW_TEARING;
+
+    if (flags & ~known)
+        FIXME("Unknown present flags %#x.\n", flags & ~known);
+
+    if (flags & DXGI_PRESENT_ALLOW_TEARING)
+    {
+        /* Tearing is only available to swap chains created for it, and only
+         * when not waiting for the vertical blank. */
+#ifdef SG_MUTANT_DXGI_TEARING_NOT_VALIDATED
+        if (0)
+#else
+        if (!(state->flags & DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING) || sync_interval)
+#endif
+        {
+            WARN("DXGI_PRESENT_ALLOW_TEARING with creation flags %#x, sync interval %u.\n",
+                    state->flags, sync_interval);
+            return DXGI_ERROR_INVALID_CALL;
+        }
+    }
+
+    if (flags & ~(DXGI_PRESENT_TEST | DXGI_PRESENT_ALLOW_TEARING))
+        TRACE("Present flags %#x do not change how the frame is shown.\n", flags);
+    return S_OK;
+}
+
+/* A frame has been presented: the application may start rendering another. */
+void dxgi_swapchain_state_frame_presented(struct dxgi_swapchain_state *state)
+{
+    LONG previous;
+
+#ifdef SG_MUTANT_DXGI_LATENCY_NEVER_SIGNALLED
+    return;
+#endif
+    if (!state->latency_semaphore)
+        return;
+
+    /* Never let the object hold more than max_latency frames. */
+    if (ReleaseSemaphore(state->latency_semaphore, 1, &previous) && previous >= (LONG)state->max_latency)
+        WaitForSingleObject(state->latency_semaphore, 0);
+}
