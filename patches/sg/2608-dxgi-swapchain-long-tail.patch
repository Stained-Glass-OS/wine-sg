+HRESULT dxgi_swapchain_state_set_rotation(struct dxgi_swapchain_state *state, DXGI_MODE_ROTATION rotation)
+{
+#ifndef SG_MUTANT_DXGI_ROTATION_NOT_VALIDATED
+    if (rotation < DXGI_MODE_ROTATION_IDENTITY || rotation > DXGI_MODE_ROTATION_ROTATE270)
+        return DXGI_ERROR_INVALID_CALL;
+#endif
+    if (rotation != DXGI_MODE_ROTATION_IDENTITY)
+        FIXME("Rotation %#x is recorded but not applied.\n", rotation);
+    state->rotation = rotation;
+    return S_OK;
+}
