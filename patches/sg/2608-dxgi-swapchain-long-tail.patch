@@ -145,12 +143,25 @@ static void composition_destroy_buffers(struct composition_swapchain *swapchain)
  * critical section held; touches no Direct3D state, so any thread may call it. */
 static void composition_draw(struct composition_swapchain *swapchain)
 {
+    UINT src_width = swapchain->frame_width, src_height = swapchain->frame_height;
+    const DXGI_MATRIX_3X2_F *m = &swapchain->state.matrix;
+    BOOL scaled;
     BITMAPINFO info;
     HDC dc;
 
     if (!swapchain->window || !swapchain->frame || !IsWindowVisible(swapchain->window))
         return;
 
+    /* SetSourceSize shows only the top left part of the buffer. */
+    if (swapchain->state.source_width && swapchain->state.source_width <= src_width
+            && swapchain->state.source_height && swapchain->state.source_height <= src_height)
+    {
+        src_width = swapchain->state.source_width;
+        src_height = swapchain->state.source_height;
+    }
+    /* The transform is applied as a scale and an offset; rotation and skew are not. */
+    scaled = m->_11 != 1.0f || m->_22 != 1.0f || m->_31 != 0.0f || m->_32 != 0.0f;
+
     memset(&info, 0, sizeof(info));
     info.bmiHeader.biSize = sizeof(info.bmiHeader);
     info.bmiHeader.biWidth = swapchain->frame_width;
@@ -161,8 +172,14 @@ static void composition_draw(struct composition_swapchain *swapchain)
 
     if ((dc = GetDCEx(swapchain->window, 0, DCX_CACHE | DCX_CLIPSIBLINGS)))
     {
-        SetDIBitsToDevice(dc, swapchain->x, swapchain->y, swapchain->frame_width, swapchain->frame_height,
-                0, 0, 0, swapchain->frame_height, swapchain->frame, &info, DIB_RGB_COLORS);
+        if (!scaled)
+            SetDIBitsToDevice(dc, swapchain->x, swapchain->y, src_width, src_height,
+                    0, swapchain->frame_height - src_height, 0, swapchain->frame_height,
+                    swapchain->frame, &info, DIB_RGB_COLORS);
+        else if (m->_11 > 0.0f && m->_22 > 0.0f)
+            StretchDIBits(dc, swapchain->x + (int)m->_31, swapchain->y + (int)m->_32,
+                    (int)(src_width * m->_11 + 0.5f), (int)(src_height * m->_22 + 0.5f),
+                    0, 0, src_width, src_height, swapchain->frame, &info, DIB_RGB_COLORS, SRCCOPY);
         ReleaseDC(swapchain->window, dc);
     }
 }
