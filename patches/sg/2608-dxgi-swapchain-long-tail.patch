+HRESULT dxgi_swapchain_state_set_source_size(struct dxgi_swapchain_state *state,
+        UINT buffer_width, UINT buffer_height, UINT width, UINT height)
+{
+#ifndef SG_MUTANT_DXGI_SOURCE_SIZE_NOT_VALIDATED
+    if (!width || !height || width > buffer_width || height > buffer_height)
+        return DXGI_ERROR_INVALID_CALL;
+#endif
+    state->source_width = width;
+    state->source_height = height;
+    return S_OK;
+}
+
+HRESULT dxgi_swapchain_state_get_source_size(const struct dxgi_swapchain_state *state,
+        UINT buffer_width, UINT buffer_height, UINT *width, UINT *height)
+{
+    if (!width || !height)
+        return E_INVALIDARG;
+
+    /* A source size larger than the buffers (after a resize) means the whole buffer. */
+    if (!state->source_width || state->source_width > buffer_width
+            || !state->source_height || state->source_height > buffer_height)
+    {
+        *width = buffer_width;
+        *height = buffer_height;
+        return S_OK;
+    }
+
+    *width = state->source_width;
+    *height = state->source_height;
+    return S_OK;
+}
