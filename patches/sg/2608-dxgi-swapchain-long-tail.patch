+/* There is no hardware vertical blank counter to read, so the refresh counts
+ * come from the refresh rate of the monitor the window is on and the time
+ * elapsed since the swap chain was created. */
+HRESULT dxgi_swapchain_state_get_frame_statistics(const struct dxgi_swapchain_state *state, HWND window,
+        UINT present_count, DXGI_FRAME_STATISTICS *stats)
+{
+    LARGE_INTEGER now, freq;
+    DWORD refresh_rate = 60;
+    MONITORINFOEXW monitor_info;
+    HMONITOR monitor;
+    DEVMODEW mode;
+
+    if (!stats)
+        return E_INVALIDARG;
+
+    monitor_info.cbSize = sizeof(monitor_info);
+    mode.dmSize = sizeof(mode);
+    mode.dmDriverExtra = 0;
+    if ((monitor = MonitorFromWindow(window, MONITOR_DEFAULTTOPRIMARY))
+            && GetMonitorInfoW(monitor, (MONITORINFO *)&monitor_info)
+            && EnumDisplaySettingsW(monitor_info.szDevice, ENUM_CURRENT_SETTINGS, &mode)
+            && mode.dmDisplayFrequency > 1)
+        refresh_rate = mode.dmDisplayFrequency;
+
+    QueryPerformanceCounter(&now);
+    QueryPerformanceFrequency(&freq);
+
+    memset(stats, 0, sizeof(*stats));
+#ifndef SG_MUTANT_DXGI_STATS_NO_PRESENT_COUNT
+    stats->PresentCount = present_count;
+#endif
+    stats->SyncRefreshCount = (UINT)((now.QuadPart - state->start_qpc) * refresh_rate / freq.QuadPart);
+    stats->PresentRefreshCount = stats->SyncRefreshCount;
+    stats->SyncQPCTime = now;
+    stats->SyncGPUTime.QuadPart = 0;
+    return S_OK;
+}
+
+HRESULT dxgi_swapchain_state_check_colour_space(DXGI_COLOR_SPACE_TYPE colour_space, UINT *support)
+{
+    if (!support)
+        return E_INVALIDARG;
+    *support = colour_space == DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709
+            ? DXGI_SWAP_CHAIN_COLOR_SPACE_SUPPORT_FLAG_PRESENT : 0;
+    return S_OK;
+}
+
+HRESULT dxgi_swapchain_state_set_colour_space(struct dxgi_swapchain_state *state, DXGI_COLOR_SPACE_TYPE colour_space)
+{
+    UINT support;
+
+    dxgi_swapchain_state_check_colour_space(colour_space, &support);
+    if (!(support & DXGI_SWAP_CHAIN_COLOR_SPACE_SUPPORT_FLAG_PRESENT))
+    {
+        WARN("Colour space %#x is not supported.\n", colour_space);
+        return E_INVALIDARG;
+    }
+    state->colour_space = colour_space;
+    return S_OK;
+}
+
+HRESULT dxgi_swapchain_state_set_hdr_metadata(struct dxgi_swapchain_state *state,
+        DXGI_HDR_METADATA_TYPE type, UINT size, void *metadata)
+{
+    switch (type)
+    {
+        case DXGI_HDR_METADATA_TYPE_NONE:
+            if (size || metadata)
+                return E_INVALIDARG;
+            state->hdr_type = type;
+            memset(&state->hdr10, 0, sizeof(state->hdr10));
+            return S_OK;
+
+        case DXGI_HDR_METADATA_TYPE_HDR10:
+#ifndef SG_MUTANT_DXGI_HDR_NOT_VALIDATED
+            if (size != sizeof(state->hdr10) || !metadata)
+                return E_INVALIDARG;
+#endif
+            state->hdr_type = type;
+            memcpy(&state->hdr10, metadata, sizeof(state->hdr10));
+            return S_OK;
+
+        default:
+            WARN("Unsupported HDR metadata type %#x.\n", type);
+            return E_INVALIDARG;
+    }
+}
+
+HRESULT dxgi_swapchain_state_set_max_latency(struct dxgi_swapchain_state *state, UINT max_latency)
+{
+    if (!(state->flags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT))
+    {
+        WARN("DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT not set.\n");
+        return DXGI_ERROR_INVALID_CALL;
+    }
+    if (!max_latency || max_latency > DXGI_MAX_SWAP_CHAIN_BUFFERS)
+        return DXGI_ERROR_INVALID_CALL;
+
+    if (state->latency_semaphore)
+    {
+        /* Make the number of frames that may be started follow the new limit. */
+        if (max_latency > state->max_latency)
+            ReleaseSemaphore(state->latency_semaphore, max_latency - state->max_latency, NULL);
+        else
+        {
+            UINT i;
+            for (i = max_latency; i < state->max_latency; ++i)
+                WaitForSingleObject(state->latency_semaphore, 0);
+        }
+    }
+    state->max_latency = max_latency;
+    return S_OK;
+}
+
+HRESULT dxgi_swapchain_state_get_max_latency(const struct dxgi_swapchain_state *state, UINT *max_latency)
+{
+    if (!(state->flags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT))
+    {
+        WARN("DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT not set.\n");
+        return DXGI_ERROR_INVALID_CALL;
+    }
+    if (!max_latency)
+        return DXGI_ERROR_INVALID_CALL;
+    *max_latency = state->max_latency;
+    return S_OK;
+}
+
+HANDLE dxgi_swapchain_state_get_latency_handle(const struct dxgi_swapchain_state *state)
+{
+    HANDLE handle;
+
+    if (!state->latency_semaphore)
+        return NULL;
+
+    /* Each call hands out a new handle that the caller closes. */
+    if (!DuplicateHandle(GetCurrentProcess(), state->latency_semaphore, GetCurrentProcess(),
+            &handle, 0, FALSE, DUPLICATE_SAME_ACCESS))
+    {
+        ERR("Cannot duplicate handle, last error %lu.\n", GetLastError());
+        return NULL;
+    }
+    return handle;
+}
