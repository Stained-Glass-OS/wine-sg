+static HRESULT WINAPI objpath_get_ParentNamespace( ISWbemObjectPath *iface, BSTR *parent )
+{
+    struct objpath *p = impl_from_ISWbemObjectPath( iface );
+    const WCHAR *slash = wcsrchr( p->namespace, '\\' );
+    WCHAR *str;
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", p, parent );
+    if (!parent) return E_INVALIDARG;
+    if (!slash) return return_bstr( L"", parent );
+    if (!(str = wcsdup_range( p->namespace, slash - p->namespace ))) return E_OUTOFMEMORY;
+    hr = return_bstr( str, parent );
+    free( str );
+    return hr;
+}
