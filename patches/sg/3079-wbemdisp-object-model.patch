+    TRACE( "%p, %s\n", p, debugstr_w(class) );
+    objpath_sync_rel( p );
+    old = wcscspn( p->rel, L".=" );
+    if (!(rel = malloc( (wcslen( class ? class : L"" ) + wcslen( p->rel + old ) + 1) * sizeof(WCHAR) )))
+        return E_OUTOFMEMORY;
