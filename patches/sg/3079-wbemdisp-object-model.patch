+/* Key=value pairs of the relative path into a name/value set */
+static HRESULT objpath_load_keys( struct objpath *p )
+{
+    ISWbemNamedValueSet *set;
+    const WCHAR *c;
+    HRESULT hr;
+
+    if (FAILED(hr = SWbemNamedValueSet_create( (void **)&set ))) return hr;
+    {
+        const WCHAR *dot = wcschr( p->rel, '.' ), *eqs = wcschr( p->rel, '=' );
+        c = (dot && eqs && dot < eqs) ? dot + 1 : NULL;
+    }
+    while (c && *c)
+    {
+        const WCHAR *eq = wcschr( c, '=' ), *end;
+        WCHAR *name, *value;
+        VARIANT v;
+        ISWbemNamedValue *nv;
+        BSTR bname;
+
+        if (!eq) break;
+        name = wcsdup_range( c, eq - c );
+        c = eq + 1;
+        if (*c == '"')
+        {
+            struct strbuf b = {0};
+            WCHAR one[2] = {0};
+
+            c++;
+            while (*c && *c != '"')
+            {
+                if (*c == '\\' && c[1]) c++;
+                one[0] = *c++;
+                strbuf_add( &b, one );
+            }
+            if (*c == '"') c++;
+            value = b.str ? b.str : wcsdup( L"" );
+            V_VT( &v ) = VT_BSTR;
+            V_BSTR( &v ) = SysAllocString( value );
+        }
+        else
+        {
+            end = c + wcscspn( c, L"," );
+            value = wcsdup_range( c, end - c );
+            c = end;
+            V_VT( &v ) = VT_BSTR;
+            V_BSTR( &v ) = SysAllocString( value );
+            if (value && *value && !value[wcsspn( value, L"0123456789" )])
+            {
+                VARIANT n;
+                VariantInit( &n );
+                if (SUCCEEDED(VariantChangeType( &n, &v, 0, VT_I4 )))
+                {
+                    VariantClear( &v );
+                    v = n;
+                }
+            }
+        }
+        if (*c == ',') c++;
+        bname = SysAllocString( name );
+        if (bname && SUCCEEDED(ISWbemNamedValueSet_Add( set, bname, &v, 0, &nv ))) ISWbemNamedValue_Release( nv );
+        SysFreeString( bname );
+        VariantClear( &v );
+        free( name );
+        free( value );
+    }
+    p->keys = set;
+    return S_OK;
+}
+
+static HRESULT WINAPI objpath_get_Keys( ISWbemObjectPath *iface, ISWbemNamedValueSet **keys )
+{
+    struct objpath *p = impl_from_ISWbemObjectPath( iface );
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", p, keys );
+    if (!keys) return E_INVALIDARG;
+    if (!p->keys && FAILED(hr = objpath_load_keys( p ))) return hr;
+    ISWbemNamedValueSet_AddRef( (*keys = p->keys) );
+    return S_OK;
+}
