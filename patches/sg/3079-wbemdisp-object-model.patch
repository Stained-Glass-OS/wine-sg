+static HRESULT WINAPI privilege_get_IsEnabled( ISWbemPrivilege *iface, VARIANT_BOOL *enabled )
+{
+    struct privilege *priv = impl_from_ISWbemPrivilege( iface );
+
+    TRACE( "%p, %p\n", priv, enabled );
+    if (!enabled) return E_INVALIDARG;
+    *enabled = priv->set->enabled[priv->id] ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI privilege_put_IsEnabled( ISWbemPrivilege *iface, VARIANT_BOOL enabled )
+{
+    struct privilege *priv = impl_from_ISWbemPrivilege( iface );
+
+    TRACE( "%p, %d\n", priv, enabled );
+    priv->set->enabled[priv->id] = enabled != VARIANT_FALSE;
+    apply_privilege( priv->id, enabled != VARIANT_FALSE );
+    return S_OK;
+}
