+/*
+ * SWbemEventSource
+ */
+struct eventsource
+{
+    ISWbemEventSource ISWbemEventSource_iface;
+    LONG refs;
+    IEnumWbemClassObject *iter;
+    struct services *services;
+};
+
+static inline struct eventsource *impl_from_ISWbemEventSource( ISWbemEventSource *iface )
+{
+    return CONTAINING_RECORD( iface, struct eventsource, ISWbemEventSource_iface );
+}
+
+static ULONG WINAPI eventsource_AddRef( ISWbemEventSource *iface )
+{
+    return InterlockedIncrement( &impl_from_ISWbemEventSource( iface )->refs );
+}
+
+static ULONG WINAPI eventsource_Release( ISWbemEventSource *iface )
+{
+    struct eventsource *e = impl_from_ISWbemEventSource( iface );
+    LONG refs = InterlockedDecrement( &e->refs );
+
+    if (!refs)
+    {
+        IEnumWbemClassObject_Release( e->iter );
+        ISWbemServices_Release( &e->services->ISWbemServices_iface );
+        free( e );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI eventsource_QueryInterface( ISWbemEventSource *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_ISWbemEventSource ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        ISWbemEventSource_AddRef( (*obj = iface) );
+        return S_OK;
+    }
+    WARN( "interface %s not implemented\n", debugstr_guid(riid) );
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+DISPATCH_IMPL( eventsource, ISWbemEventSource, ISWbemEventSource_tid )
+
+static HRESULT WINAPI eventsource_NextEvent( ISWbemEventSource *iface, LONG timeout, ISWbemObject **obj )
+{
+    struct eventsource *e = impl_from_ISWbemEventSource( iface );
+    IWbemClassObject *event;
+    ULONG count = 0;
+    HRESULT hr;
+
+    TRACE( "%p, %ld, %p\n", e, timeout, obj );
+    if (!obj) return E_INVALIDARG;
+    *obj = NULL;
+    hr = IEnumWbemClassObject_Next( e->iter, timeout, 1, &event, &count );
+    if (FAILED(hr)) return hr;
+    if (!count) return wbemErrTimedout;
+    hr = SWbemObject_create( e->services, event, obj );
+    IWbemClassObject_Release( event );
+    return hr;
+}
+
+static HRESULT WINAPI eventsource_get_Security_( ISWbemEventSource *iface, ISWbemSecurity **security )
+{
+    struct eventsource *e = impl_from_ISWbemEventSource( iface );
+
+    TRACE( "%p, %p\n", e, security );
+    if (!security) return E_INVALIDARG;
+    return ISWbemServices_get_Security_( &e->services->ISWbemServices_iface, security );
+}
+
+static const ISWbemEventSourceVtbl eventsource_vtbl =
+{
+    eventsource_QueryInterface, eventsource_AddRef, eventsource_Release,
+    eventsource_GetTypeInfoCount, eventsource_GetTypeInfo, eventsource_GetIDsOfNames, eventsource_Invoke,
+    eventsource_NextEvent, eventsource_get_Security_,
+};
+
+static HRESULT SWbemEventSource_create( struct services *services, IEnumWbemClassObject *iter, ISWbemEventSource **obj )
+{
+    struct eventsource *e;
+
+    if (!(e = calloc( 1, sizeof(*e) ))) return E_OUTOFMEMORY;
+    e->ISWbemEventSource_iface.lpVtbl = &eventsource_vtbl;
+    e->refs = 1;
+    IEnumWbemClassObject_AddRef( (e->iter = iter) );
+    ISWbemServices_AddRef( &services->ISWbemServices_iface );
+    e->services = services;
+    *obj = &e->ISWbemEventSource_iface;
+    return S_OK;
+}
