+    TRACE( "%p, %p\n", p, is_singleton );
+    if (!is_singleton) return E_INVALIDARG;
+    len = wcslen( p->rel );
+    *is_singleton = (len > 2 && !wcscmp( p->rel + len - 2, L"=@" )) ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI objpath_SetAsSingleton( ISWbemObjectPath *iface )
+{
+    struct objpath *p = impl_from_ISWbemObjectPath( iface );
+    size_t n;
+    WCHAR *rel;
+
+    TRACE( "%p\n", p );
+    objpath_sync_rel( p );
+    n = wcscspn( p->rel, L".=" );
+    if (!(rel = malloc( (n + 3) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    memcpy( rel, p->rel, n * sizeof(WCHAR) );
+    lstrcpyW( rel + n, L"=@" );
+    free( p->rel );
+    p->rel = rel;
+    if (p->keys)
+    {
+        ISWbemNamedValueSet_Release( p->keys );
+        p->keys = NULL;
+    }
+    return S_OK;
+}
