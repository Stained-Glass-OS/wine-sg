+/* the path of an object, or its class name when it has none; *is_class says it is a class */
+static HRESULT object_get_path( IWbemClassObject *obj, BSTR *path, BOOL *is_class )
+{
+    VARIANT v;
+    HRESULT hr;
+
+    *path = NULL;
+    if (is_class)
+    {
+        VariantInit( &v );
+        *is_class = SUCCEEDED(IWbemClassObject_Get( obj, L"__GENUS", 0, &v, NULL, NULL )) && V_VT( &v ) == VT_I4 &&
+                    V_I4( &v ) == WBEM_GENUS_CLASS;
+        VariantClear( &v );
+    }
+    VariantInit( &v );
+    if (SUCCEEDED(hr = IWbemClassObject_Get( obj, L"__PATH", 0, &v, NULL, NULL )) && V_VT( &v ) == VT_BSTR &&
+        SysStringLen( V_BSTR( &v ) ))
+    {
+        *path = V_BSTR( &v );
+        return S_OK;
+    }
+    VariantClear( &v );
+    VariantInit( &v );
+    if (SUCCEEDED(hr = IWbemClassObject_Get( obj, L"__RELPATH", 0, &v, NULL, NULL )) && V_VT( &v ) == VT_BSTR &&
+        SysStringLen( V_BSTR( &v ) ))
+    {
+        *path = V_BSTR( &v );
+        return S_OK;
+    }
+    VariantClear( &v );
+    VariantInit( &v );
+    if (SUCCEEDED(hr = IWbemClassObject_Get( obj, L"__CLASS", 0, &v, NULL, NULL )) && V_VT( &v ) == VT_BSTR)
+    {
+        *path = V_BSTR( &v );
+        return S_OK;
+    }
+    VariantClear( &v );
+    return FAILED(hr) ? hr : WBEM_E_NOT_FOUND;
+}
