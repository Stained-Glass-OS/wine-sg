+static HRESULT WINAPI privset_get__NewEnum( ISWbemPrivilegeSet *iface, IUnknown **unk )
+{
+    struct privset *set = impl_from_ISWbemPrivilegeSet( iface );
+    struct varlist list = {0};
+    ISWbemPrivilege *priv;
+    HRESULT hr = S_OK;
+    LONG i;
+
+    TRACE( "%p, %p\n", set, unk );
+    if (!unk) return E_INVALIDARG;
+    for (i = 1; i <= NB_PRIVILEGES && SUCCEEDED(hr); i++)
+    {
+        if (!set->present[i]) continue;
+        if (SUCCEEDED(hr = privilege_create( set, i, &priv )))
+            if (FAILED(hr = varlist_add( &list, (IDispatch *)priv ))) ISWbemPrivilege_Release( priv );
+    }
+    if (FAILED(hr))
+    {
+        varlist_free( &list );
+        return hr;
+    }
+    return varlist_enum( &list, unk );
+}
