+/*
+ * SWbemObjectPath: \\server\namespace:Class.Key=value,Key=value
+ */
+struct objpath
+{
+    ISWbemObjectPath ISWbemObjectPath_iface;
+    LONG refs;
+    WCHAR *server, *namespace, *rel, *locale, *authority;
+    ISWbemNamedValueSet *keys;
+};
+
+static inline struct objpath *impl_from_ISWbemObjectPath( ISWbemObjectPath *iface )
+{
+    return CONTAINING_RECORD( iface, struct objpath, ISWbemObjectPath_iface );
+}
+
+static WCHAR *wcsdup_range( const WCHAR *str, size_t len )
+{
+    WCHAR *ret = malloc( (len + 1) * sizeof(WCHAR) );
+    if (ret)
+    {
+        memcpy( ret, str, len * sizeof(WCHAR) );
+        ret[len] = 0;
+    }
+    return ret;
+}
+
+static void objpath_set_string( WCHAR **field, const WCHAR *value )
+{
+    free( *field );
+    *field = wcsdup( value ? value : L"" );
+}
+
+static BOOL is_slash( WCHAR c ) { return c == '\\' || c == '/'; }
+
+/* split a path into server, namespace and relative path */
+static HRESULT objpath_parse( struct objpath *p, const WCHAR *path )
+{
+    WCHAR *server = NULL, *namespace = NULL, *rel = NULL, *c;
+    const WCHAR *ns_start, *colon, *rel_start, *eq;
+
+    if (!_wcsnicmp( path, L"winmgmts:", 9 )) path += 9;
+    while (*path == ' ') path++;
+
+    if (is_slash( path[0] ) && is_slash( path[1] ))
+    {
+        const WCHAR *end = path + 2;
+
+        while (*end && !is_slash( *end )) end++;
+        server = wcsdup_range( path + 2, end - (path + 2) );
+        ns_start = *end ? end + 1 : end;
+    }
+    else ns_start = path;
+
+    /* a colon before any '=' separates the namespace */
+    colon = wcschr( ns_start, ':' );
+    eq = wcschr( ns_start, '=' );
+    if (colon && (!eq || colon < eq))
+    {
+        namespace = wcsdup_range( ns_start, colon - ns_start );
+        rel_start = colon + 1;
+    }
+    else if (server && !colon)
+    {
+        namespace = wcsdup( ns_start );
+        rel_start = L"";
+    }
+    else rel_start = ns_start;
+    rel = wcsdup( rel_start );
+    if (!rel || (server && !*server && !namespace && FALSE))
+    {
+        free( server ); free( namespace ); free( rel );
+        return E_OUTOFMEMORY;
+    }
+    if (!namespace) namespace = wcsdup( L"" );
+    if (!server) server = wcsdup( L"" );
+    for (c = namespace; c && *c; c++) if (*c == '/') *c = '\\';
+
+    free( p->server ); free( p->namespace ); free( p->rel );
+    p->server = server;
+    p->namespace = namespace;
+    p->rel = rel;
+    if (p->keys)
+    {
+        ISWbemNamedValueSet_Release( p->keys );
+        p->keys = NULL;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI objpath_AddRef( ISWbemObjectPath *iface )
+{
+    return InterlockedIncrement( &impl_from_ISWbemObjectPath( iface )->refs );
+}
+
+static ULONG WINAPI objpath_Release( ISWbemObjectPath *iface )
+{
+    struct objpath *p = impl_from_ISWbemObjectPath( iface );
+    LONG refs = InterlockedDecrement( &p->refs );
+
+    if (!refs)
+    {
+        if (p->keys) ISWbemNamedValueSet_Release( p->keys );
+        free( p->server ); free( p->namespace ); free( p->rel ); free( p->locale ); free( p->authority );
+        free( p );
+    }
+    return refs;
+}
