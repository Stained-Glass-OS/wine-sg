+static HRESULT WINAPI privset_Item( ISWbemPrivilegeSet *iface, WbemPrivilegeEnum id, ISWbemPrivilege **priv )
+{
+    struct privset *set = impl_from_ISWbemPrivilegeSet( iface );
+
+    TRACE( "%p, %d, %p\n", set, id, priv );
+    if (!priv) return E_INVALIDARG;
+    *priv = NULL;
+    if (id < 1 || id > NB_PRIVILEGES) return WBEM_E_INVALID_PARAMETER;
+    if (!set->present[id]) return WBEM_E_NOT_FOUND;
+    return privilege_create( set, id, priv );
+}
+
+static HRESULT WINAPI privset_get_Count( ISWbemPrivilegeSet *iface, LONG *count )
+{
+    struct privset *set = impl_from_ISWbemPrivilegeSet( iface );
+    LONG i;
+
+    TRACE( "%p, %p\n", set, count );
+    if (!count) return E_INVALIDARG;
+    *count = 0;
+    for (i = 1; i <= NB_PRIVILEGES; i++) if (set->present[i]) (*count)++;
+    return S_OK;
+}
+
+static HRESULT WINAPI privset_Add( ISWbemPrivilegeSet *iface, WbemPrivilegeEnum id, VARIANT_BOOL enabled,
+                                   ISWbemPrivilege **priv )
+{
+    struct privset *set = impl_from_ISWbemPrivilegeSet( iface );
+
+    TRACE( "%p, %d, %d, %p\n", set, id, enabled, priv );
+    if (!priv) return E_INVALIDARG;
+    *priv = NULL;
+    if (id < 1 || id > NB_PRIVILEGES) return WBEM_E_INVALID_PARAMETER;
+    set->present[id] = TRUE;
+    set->enabled[id] = enabled != VARIANT_FALSE;
+    apply_privilege( id, set->enabled[id] );
+    return privilege_create( set, id, priv );
+}
+
+static HRESULT WINAPI privset_Remove( ISWbemPrivilegeSet *iface, WbemPrivilegeEnum id )
+{
+    struct privset *set = impl_from_ISWbemPrivilegeSet( iface );
+
+    TRACE( "%p, %d\n", set, id );
+    if (id < 1 || id > NB_PRIVILEGES) return WBEM_E_INVALID_PARAMETER;
+    set->present[id] = set->enabled[id] = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI privset_DeleteAll( ISWbemPrivilegeSet *iface )
+{
+    struct privset *set = impl_from_ISWbemPrivilegeSet( iface );
+
+    TRACE( "%p\n", set );
+    memset( set->present, 0, sizeof(set->present) );
+    memset( set->enabled, 0, sizeof(set->enabled) );
+    return S_OK;
+}
