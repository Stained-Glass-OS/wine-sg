+/*
+ * An enumerator over a list of variants (the collections' _NewEnum)
+ */
+struct varenum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG refs;
+    VARIANT *items;
+    ULONG count;
+    ULONG pos;
+};
+
+static inline struct varenum *impl_from_varenum( IEnumVARIANT *iface )
+{
+    return CONTAINING_RECORD( iface, struct varenum, IEnumVARIANT_iface );
+}
+
+static HRESULT WINAPI varenum_QueryInterface( IEnumVARIANT *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IEnumVARIANT ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        IEnumVARIANT_AddRef( (*obj = iface) );
+        return S_OK;
+    }
+    WARN( "interface %s not implemented\n", debugstr_guid(riid) );
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI varenum_AddRef( IEnumVARIANT *iface )
+{
+    return InterlockedIncrement( &impl_from_varenum( iface )->refs );
+}
+
+static ULONG WINAPI varenum_Release( IEnumVARIANT *iface )
+{
+    struct varenum *e = impl_from_varenum( iface );
+    LONG refs = InterlockedDecrement( &e->refs );
+    ULONG i;
+
+    if (!refs)
+    {
+        for (i = 0; i < e->count; i++) VariantClear( &e->items[i] );
+        free( e->items );
+        free( e );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI varenum_Next( IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched )
+{
+    struct varenum *e = impl_from_varenum( iface );
+    ULONG n = 0;
+
+    if (!var && celt) return E_INVALIDARG;
+    while (n < celt && e->pos < e->count)
+    {
+        VariantInit( &var[n] );
+        if (FAILED(VariantCopy( &var[n], &e->items[e->pos] ))) break;
+        e->pos++;
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n < celt ? S_FALSE : S_OK;
+}
+
+static HRESULT WINAPI varenum_Skip( IEnumVARIANT *iface, ULONG celt )
+{
+    struct varenum *e = impl_from_varenum( iface );
+
+    if (celt > e->count - e->pos)
+    {
+        e->pos = e->count;
+        return S_FALSE;
+    }
+    e->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI varenum_Reset( IEnumVARIANT *iface )
+{
+    impl_from_varenum( iface )->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI varenum_Clone( IEnumVARIANT *iface, IEnumVARIANT **out )
+{
+    struct varenum *e = impl_from_varenum( iface );
+    VARIANT *copy;
+    ULONG i;
+    HRESULT hr;
+
+    if (!out) return E_INVALIDARG;
+    if (!(copy = calloc( e->count ? e->count : 1, sizeof(*copy) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < e->count; i++)
+    {
+        VariantInit( &copy[i] );
+        if (FAILED(hr = VariantCopy( &copy[i], &e->items[i] )))
+        {
+            while (i--) VariantClear( &copy[i] );
+            free( copy );
+            return hr;
+        }
+    }
+    if (SUCCEEDED(hr = varenum_create( copy, e->count, out ))) impl_from_varenum( *out )->pos = e->pos;
+    return hr;
+}
+
+static const IEnumVARIANTVtbl varenum_vtbl =
+{
+    varenum_QueryInterface, varenum_AddRef, varenum_Release, varenum_Next, varenum_Skip, varenum_Reset, varenum_Clone
+};
+
+/* takes the items (allocated with calloc, may be NULL when count is 0) */
+static HRESULT varenum_create( VARIANT *items, ULONG count, IEnumVARIANT **out )
+{
+    struct varenum *e;
+    ULONG i;
+
+    if (!(e = calloc( 1, sizeof(*e) )))
+    {
+        for (i = 0; i < count; i++) VariantClear( &items[i] );
+        free( items );
+        return E_OUTOFMEMORY;
+    }
+    e->IEnumVARIANT_iface.lpVtbl = &varenum_vtbl;
+    e->refs = 1;
+    e->items = items;
+    e->count = count;
+    *out = &e->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+/* a growing list of dispatch variants */
+struct varlist
+{
+    VARIANT *items;
+    ULONG count, capacity;
+};
+
+static HRESULT varlist_add( struct varlist *list, IDispatch *disp )
+{
+    if (list->count == list->capacity)
+    {
+        ULONG cap = list->capacity ? list->capacity * 2 : 8;
+        VARIANT *items = realloc( list->items, cap * sizeof(*items) );
+        if (!items) return E_OUTOFMEMORY;
+        list->items = items;
+        list->capacity = cap;
+    }
+    VariantInit( &list->items[list->count] );
+    V_VT( &list->items[list->count] ) = VT_DISPATCH;
+    V_DISPATCH( &list->items[list->count] ) = disp;
+    list->count++;
+    return S_OK;
+}
+
+static HRESULT varlist_enum( struct varlist *list, IUnknown **out )
+{
+    return varenum_create( list->items, list->count, (IEnumVARIANT **)out );
+}
+
+static void varlist_free( struct varlist *list )
+{
+    ULONG i;
+    for (i = 0; i < list->count; i++) VariantClear( &list->items[i] );
+    free( list->items );
+}
+
+/*
+ * SWbemQualifier and SWbemQualifierSet
+ */
+struct qualifierset
+{
+    ISWbemQualifierSet ISWbemQualifierSet_iface;
+    LONG refs;
+    IWbemQualifierSet *set;
+};
+
+struct qualifier
+{
+    ISWbemQualifier ISWbemQualifier_iface;
+    LONG refs;
+    IWbemQualifierSet *set;
+    BSTR name;
+};
+
+static inline struct qualifier *impl_from_ISWbemQualifier( ISWbemQualifier *iface )
+{
+    return CONTAINING_RECORD( iface, struct qualifier, ISWbemQualifier_iface );
+}
+
+static HRESULT WINAPI qualifier_QueryInterface( ISWbemQualifier *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_ISWbemQualifier ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        ISWbemQualifier_AddRef( (*obj = iface) );
+        return S_OK;
+    }
+    WARN( "interface %s not implemented\n", debugstr_guid(riid) );
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI qualifier_AddRef( ISWbemQualifier *iface )
+{
+    return InterlockedIncrement( &impl_from_ISWbemQualifier( iface )->refs );
+}
+
+static ULONG WINAPI qualifier_Release( ISWbemQualifier *iface )
+{
+    struct qualifier *q = impl_from_ISWbemQualifier( iface );
+    LONG refs = InterlockedDecrement( &q->refs );
+
+    if (!refs)
+    {
+        IWbemQualifierSet_Release( q->set );
+        SysFreeString( q->name );
+        free( q );
+    }
+    return refs;
+}
+
+DISPATCH_IMPL( qualifier, ISWbemQualifier, ISWbemQualifier_tid )
+
+static HRESULT WINAPI qualifier_get_Value( ISWbemQualifier *iface, VARIANT *value )
+{
+    struct qualifier *q = impl_from_ISWbemQualifier( iface );
+
+    TRACE( "%p, %p\n", q, value );
+    if (!value) return E_INVALIDARG;
+    return IWbemQualifierSet_Get( q->set, q->name, 0, value, NULL );
+}
+
+static HRESULT qualifier_flavor( struct qualifier *q, LONG *flavor )
+{
+    VARIANT v;
+    HRESULT hr;
+
+    VariantInit( &v );
+    if (SUCCEEDED(hr = IWbemQualifierSet_Get( q->set, q->name, 0, &v, flavor ))) VariantClear( &v );
+    return hr;
+}
+
+static HRESULT WINAPI qualifier_put_Value( ISWbemQualifier *iface, VARIANT *value )
+{
+    struct qualifier *q = impl_from_ISWbemQualifier( iface );
+    LONG flavor = 0;
+    HRESULT hr;
+
+    TRACE( "%p, %s\n", q, debugstr_variant(value) );
+    if (!value) return E_INVALIDARG;
+    if (FAILED(hr = qualifier_flavor( q, &flavor ))) return hr;
+    return IWbemQualifierSet_Put( q->set, q->name, value, flavor & ~WBEM_FLAVOR_MASK_ORIGIN );
+}
+
+static HRESULT WINAPI qualifier_get_Name( ISWbemQualifier *iface, BSTR *name )
+{
+    struct qualifier *q = impl_from_ISWbemQualifier( iface );
+
+    TRACE( "%p, %p\n", q, name );
+    if (!name) return E_INVALIDARG;
+    return (*name = SysAllocString( q->name )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT qualifier_get_flag( ISWbemQualifier *iface, LONG mask, BOOL expect_set, VARIANT_BOOL *value )
+{
+    struct qualifier *q = impl_from_ISWbemQualifier( iface );
+    LONG flavor = 0;
+    HRESULT hr;
+
+    if (!value) return E_INVALIDARG;
+    if (FAILED(hr = qualifier_flavor( q, &flavor ))) return hr;
+    *value = ((flavor & mask) != 0) == expect_set ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT qualifier_put_flag( ISWbemQualifier *iface, LONG bit, BOOL set_bit, VARIANT_BOOL value )
+{
+    struct qualifier *q = impl_from_ISWbemQualifier( iface );
+    LONG flavor = 0;
+    VARIANT v;
+    HRESULT hr;
+
+    VariantInit( &v );
+    if (FAILED(hr = IWbemQualifierSet_Get( q->set, q->name, 0, &v, &flavor ))) return hr;
+    flavor &= ~WBEM_FLAVOR_MASK_ORIGIN;
+    if ((value != VARIANT_FALSE) == set_bit) flavor |= bit;
+    else flavor &= ~bit;
+    hr = IWbemQualifierSet_Put( q->set, q->name, &v, flavor );
+    VariantClear( &v );
+    return hr;
+}
+
+static HRESULT WINAPI qualifier_get_IsLocal( ISWbemQualifier *iface, VARIANT_BOOL *value )
+{
+    return qualifier_get_flag( iface, WBEM_FLAVOR_MASK_ORIGIN, FALSE, value );
+}
+
+static HRESULT WINAPI qualifier_get_PropagatesToSubclass( ISWbemQualifier *iface, VARIANT_BOOL *value )
+{
+    return qualifier_get_flag( iface, WBEM_FLAVOR_FLAG_PROPAGATE_TO_DERIVED_CLASS, TRUE, value );
+}
+
+static HRESULT WINAPI qualifier_put_PropagatesToSubclass( ISWbemQualifier *iface, VARIANT_BOOL value )
+{
+    return qualifier_put_flag( iface, WBEM_FLAVOR_FLAG_PROPAGATE_TO_DERIVED_CLASS, TRUE, value );
+}
+
+static HRESULT WINAPI qualifier_get_PropagatesToInstance( ISWbemQualifier *iface, VARIANT_BOOL *value )
+{
+    return qualifier_get_flag( iface, WBEM_FLAVOR_FLAG_PROPAGATE_TO_INSTANCE, TRUE, value );
+}
+
+static HRESULT WINAPI qualifier_put_PropagatesToInstance( ISWbemQualifier *iface, VARIANT_BOOL value )
+{
+    return qualifier_put_flag( iface, WBEM_FLAVOR_FLAG_PROPAGATE_TO_INSTANCE, TRUE, value );
+}
+
+static HRESULT WINAPI qualifier_get_IsOverridable( ISWbemQualifier *iface, VARIANT_BOOL *value )
+{
+    return qualifier_get_flag( iface, WBEM_FLAVOR_NOT_OVERRIDABLE, FALSE, value );
+}
+
+static HRESULT WINAPI qualifier_put_IsOverridable( ISWbemQualifier *iface, VARIANT_BOOL value )
+{
+    return qualifier_put_flag( iface, WBEM_FLAVOR_NOT_OVERRIDABLE, FALSE, value );
+}
+
+static HRESULT WINAPI qualifier_get_IsAmended( ISWbemQualifier *iface, VARIANT_BOOL *value )
+{
+    return qualifier_get_flag( iface, WBEM_FLAVOR_AMENDED, TRUE, value );
+}
+
+static const ISWbemQualifierVtbl qualifier_vtbl =
+{
+    qualifier_QueryInterface, qualifier_AddRef, qualifier_Release,
+    qualifier_GetTypeInfoCount, qualifier_GetTypeInfo, qualifier_GetIDsOfNames, qualifier_Invoke,
+    qualifier_get_Value, qualifier_put_Value, qualifier_get_Name, qualifier_get_IsLocal,
+    qualifier_get_PropagatesToSubclass, qualifier_put_PropagatesToSubclass,
+    qualifier_get_PropagatesToInstance, qualifier_put_PropagatesToInstance,
+    qualifier_get_IsOverridable, qualifier_put_IsOverridable, qualifier_get_IsAmended,
+};
+
+static HRESULT SWbemQualifier_create( IWbemQualifierSet *set, const WCHAR *name, ISWbemQualifier **obj )
+{
+    struct qualifier *q;
+
+    if (!(q = calloc( 1, sizeof(*q) ))) return E_OUTOFMEMORY;
+    q->ISWbemQualifier_iface.lpVtbl = &qualifier_vtbl;
+    q->refs = 1;
+    IWbemQualifierSet_AddRef( (q->set = set) );
+    if (!(q->name = SysAllocString( name )))
+    {
+        ISWbemQualifier_Release( &q->ISWbemQualifier_iface );
+        return E_OUTOFMEMORY;
+    }
+    *obj = &q->ISWbemQualifier_iface;
+    return S_OK;
+}
+
+static inline struct qualifierset *impl_from_ISWbemQualifierSet( ISWbemQualifierSet *iface )
+{
+    return CONTAINING_RECORD( iface, struct qualifierset, ISWbemQualifierSet_iface );
+}
+
+static HRESULT WINAPI qualifierset_QueryInterface( ISWbemQualifierSet *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_ISWbemQualifierSet ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        ISWbemQualifierSet_AddRef( (*obj = iface) );
+        return S_OK;
+    }
+    WARN( "interface %s not implemented\n", debugstr_guid(riid) );
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI qualifierset_AddRef( ISWbemQualifierSet *iface )
+{
+    return InterlockedIncrement( &impl_from_ISWbemQualifierSet( iface )->refs );
+}
+
+static ULONG WINAPI qualifierset_Release( ISWbemQualifierSet *iface )
+{
+    struct qualifierset *s = impl_from_ISWbemQualifierSet( iface );
+    LONG refs = InterlockedDecrement( &s->refs );
+
+    if (!refs)
+    {
+        IWbemQualifierSet_Release( s->set );
+        free( s );
+    }
+    return refs;
+}
+
+DISPATCH_IMPL( qualifierset, ISWbemQualifierSet, ISWbemQualifierSet_tid )
+
+/* the names of the qualifiers */
+static HRESULT qualifierset_names( struct qualifierset *s, struct varlist *list, ULONG *count )
+{
+    HRESULT hr;
+    BSTR name;
+
+    if (count) *count = 0;
+    if (FAILED(hr = IWbemQualifierSet_BeginEnumeration( s->set, 0 ))) return hr;
+    while (IWbemQualifierSet_Next( s->set, 0, &name, NULL, NULL ) == S_OK)
+    {
+        if (list)
+        {
+            ISWbemQualifier *q;
+
+            if (SUCCEEDED(hr = SWbemQualifier_create( s->set, name, &q )))
+            {
+                if (FAILED(hr = varlist_add( list, (IDispatch *)q ))) ISWbemQualifier_Release( q );
+            }
+            if (FAILED(hr))
+            {
+                SysFreeString( name );
+                break;
+            }
+        }
+        if (count) (*count)++;
+        SysFreeString( name );
+    }
+    IWbemQualifierSet_EndEnumeration( s->set );
+    return hr;
+}
+
+static HRESULT WINAPI qualifierset_get__NewEnum( ISWbemQualifierSet *iface, IUnknown **unk )
+{
+    struct qualifierset *s = impl_from_ISWbemQualifierSet( iface );
+    struct varlist list = {0};
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", s, unk );
+    if (!unk) return E_INVALIDARG;
+    if (FAILED(hr = qualifierset_names( s, &list, NULL )))
+    {
+        varlist_free( &list );
+        return hr;
+    }
+    return varlist_enum( &list, unk );
+}
+
+static HRESULT WINAPI qualifierset_Item( ISWbemQualifierSet *iface, BSTR name, LONG flags, ISWbemQualifier **qualifier )
+{
+    struct qualifierset *s = impl_from_ISWbemQualifierSet( iface );
+    VARIANT v;
+    HRESULT hr;
+
+    TRACE( "%p, %s, %#lx, %p\n", s, debugstr_w(name), flags, qualifier );
+    if (!name || !qualifier) return E_INVALIDARG;
+    *qualifier = NULL;
+    VariantInit( &v );
+    if (FAILED(hr = IWbemQualifierSet_Get( s->set, name, 0, &v, NULL ))) return hr;
+    VariantClear( &v );
+    return SWbemQualifier_create( s->set, name, qualifier );
+}
+
+static HRESULT WINAPI qualifierset_get_Count( ISWbemQualifierSet *iface, LONG *count )
+{
+    struct qualifierset *s = impl_from_ISWbemQualifierSet( iface );
+    ULONG n;
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", s, count );
+    if (!count) return E_INVALIDARG;
+    if (FAILED(hr = qualifierset_names( s, NULL, &n ))) return hr;
+    *count = n;
+    return S_OK;
+}
+
+static HRESULT WINAPI qualifierset_Add( ISWbemQualifierSet *iface, BSTR name, VARIANT *value,
+        VARIANT_BOOL to_subclass, VARIANT_BOOL to_instance, VARIANT_BOOL overridable, LONG flags,
+        ISWbemQualifier **qualifier )
+{
+    struct qualifierset *s = impl_from_ISWbemQualifierSet( iface );
+    LONG flavor = 0;
+    HRESULT hr;
+
+    TRACE( "%p, %s, %s, %d, %d, %d, %#lx, %p\n", s, debugstr_w(name), debugstr_variant(value), to_subclass,
+           to_instance, overridable, flags, qualifier );
+    if (!name || !value || !qualifier) return E_INVALIDARG;
+    *qualifier = NULL;
+    if (to_subclass) flavor |= WBEM_FLAVOR_FLAG_PROPAGATE_TO_DERIVED_CLASS;
+    if (to_instance) flavor |= WBEM_FLAVOR_FLAG_PROPAGATE_TO_INSTANCE;
+    if (!overridable) flavor |= WBEM_FLAVOR_NOT_OVERRIDABLE;
+    if (FAILED(hr = IWbemQualifierSet_Put( s->set, name, value, flavor ))) return hr;
+    return SWbemQualifier_create( s->set, name, qualifier );
