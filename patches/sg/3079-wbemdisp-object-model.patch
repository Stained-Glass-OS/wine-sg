+struct strbuf
+{
+    WCHAR *str;
+    size_t len, cap;
+};
+
+static BOOL strbuf_add( struct strbuf *b, const WCHAR *add )
+{
+    size_t n = wcslen( add );
+
+    if (b->len + n + 1 > b->cap)
+    {
+        size_t cap = max( b->cap * 2, b->len + n + 64 );
+        WCHAR *str = realloc( b->str, cap * sizeof(WCHAR) );
+        if (!str) return FALSE;
+        b->str = str;
+        b->cap = cap;
+    }
+    memcpy( b->str + b->len, add, (n + 1) * sizeof(WCHAR) );
+    b->len += n;
+    return TRUE;
+}
+
+static BOOL strbuf_clause( struct strbuf *b, BOOL *first, const WCHAR *name, const WCHAR *value )
+{
+    BOOL ok = TRUE;
+
+    if (!value || !*value) return TRUE;
+    ok = strbuf_add( b, *first ? L" WHERE " : L" " );
+    *first = FALSE;
+    return ok && strbuf_add( b, name ) && strbuf_add( b, L" = " ) && strbuf_add( b, value );
+}
+
+/* ASSOCIATORS OF / REFERENCES OF {path} WHERE ... */
+static HRESULT assoc_query( BOOL associators, const WCHAR *path, const WCHAR *assoc_class, const WCHAR *result_class,
+        const WCHAR *result_role, const WCHAR *role, VARIANT_BOOL classes_only, VARIANT_BOOL schema_only,
+        const WCHAR *req_assoc_qualifier, const WCHAR *req_qualifier, BSTR *query )
+{
+    struct strbuf b = {0};
+    BOOL first = TRUE, ok;
+
+    ok = strbuf_add( &b, associators ? L"ASSOCIATORS OF {" : L"REFERENCES OF {" ) && strbuf_add( &b, path ) &&
+         strbuf_add( &b, L"}" );
+    if (ok && associators) ok = strbuf_clause( &b, &first, L"AssocClass", assoc_class );
+    if (ok) ok = strbuf_clause( &b, &first, L"ResultClass", result_class );
+    if (ok && associators) ok = strbuf_clause( &b, &first, L"ResultRole", result_role );
+    if (ok) ok = strbuf_clause( &b, &first, L"Role", role );
+    if (ok && classes_only)
+    {
+        ok = strbuf_add( &b, first ? L" WHERE ClassDefsOnly" : L" ClassDefsOnly" );
+        first = FALSE;
+    }
+    if (ok && schema_only)
+    {
+        ok = strbuf_add( &b, first ? L" WHERE SchemaOnly" : L" SchemaOnly" );
+        first = FALSE;
+    }
