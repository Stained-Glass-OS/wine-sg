+
+struct method_param
+{
+    WCHAR *name;
+    LONG id;
+    BOOL in, out;
+    CIMTYPE type;
+};
+
+static LONG param_id( IWbemClassObject *sign, const WCHAR *name, LONG fallback )
+{
+    IWbemQualifierSet *qualifiers;
+    LONG id = fallback;
+    VARIANT v;
+
+    if (FAILED(IWbemClassObject_GetPropertyQualifierSet( sign, name, &qualifiers ))) return fallback;
+    VariantInit( &v );
+    if (SUCCEEDED(IWbemQualifierSet_Get( qualifiers, L"ID", 0, &v, NULL )) && V_VT( &v ) == VT_I4) id = V_I4( &v );
+    VariantClear( &v );
+    IWbemQualifierSet_Release( qualifiers );
+    return id;
+}
+
+static void free_params( struct method_param *list, UINT count )
+{
+    UINT i;
+    for (i = 0; i < count; i++) free( list[i].name );
+    free( list );
+}
+
+/* the parameters of a method in the order of their ID qualifiers */
+static HRESULT collect_params( IWbemClassObject *in_sign, IWbemClassObject *out_sign, struct method_param **ret,
+        UINT *ret_count )
+{
+    struct method_param *list = NULL, tmp;
+    IWbemClassObject *sign[2] = { in_sign, out_sign };
+    UINT count = 0, i, j, k;
+    BSTR name;
+    CIMTYPE type;
+
+    for (k = 0; k < 2; k++)
+    {
+        if (!sign[k] || FAILED(IWbemClassObject_BeginEnumeration( sign[k], WBEM_FLAG_NONSYSTEM_ONLY ))) continue;
+        while (IWbemClassObject_Next( sign[k], 0, &name, NULL, &type, NULL ) == S_OK)
+        {
+            if (k == 1 && !wcsicmp( name, L"ReturnValue" )) { SysFreeString( name ); continue; }
+            for (i = 0; i < count; i++) if (!wcsicmp( list[i].name, name )) break;
+            if (i == count)
+            {
+                struct method_param *new = realloc( list, (count + 1) * sizeof(*list) );
+                if (!new)
+                {
+                    SysFreeString( name );
+                    IWbemClassObject_EndEnumeration( sign[k] );
+                    free_params( list, count );
+                    return E_OUTOFMEMORY;
+                }
+                list = new;
+                memset( &list[count], 0, sizeof(list[count]) );
+                list[count].name = wcsdup( name );
+                list[count].id = param_id( sign[k], name, count );
+                list[count].type = type;
+                count++;
+            }
+            if (k == 0) list[i].in = TRUE; else list[i].out = TRUE;
+            SysFreeString( name );
+        }
+        IWbemClassObject_EndEnumeration( sign[k] );
+    }
+    for (i = 1; i < count; i++)
+        for (j = i; j > 0 && list[j - 1].id > list[j].id; j--)
+        {
+            tmp = list[j - 1];
+            list[j - 1] = list[j];
+            list[j] = tmp;
+        }
+    *ret = list;
+    *ret_count = count;
+    return S_OK;
+}
+
+/* obj.Method( args ): the arguments are the method's parameters in ID order */
+static HRESULT object_call_method( struct object *object, const WCHAR *method, DISPPARAMS *params, VARIANT *result )
+{
+    IWbemClassObject *in_sign = NULL, *out_sign = NULL, *in_inst = NULL, *out = NULL;
+    struct method_param *list = NULL;
+    UINT count = 0, i, nb_args = params ? params->cArgs : 0;
+    BOOL is_class;
+    BSTR path = NULL;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_NO_METHOD_CALL
+    return DISP_E_MEMBERNOTFOUND;
+#endif
+    if (params && params->cNamedArgs) return DISP_E_NONAMEDARGS;
+    if (FAILED(hr = IWbemClassObject_GetMethod( object->object, method, 0, &in_sign, &out_sign ))) return hr;
+    if (in_sign && FAILED(hr = IWbemClassObject_SpawnInstance( in_sign, 0, &in_inst ))) goto done;
+    if (FAILED(hr = collect_params( in_sign, out_sign, &list, &count ))) goto done;
+    if (nb_args > count)
+    {
+        hr = DISP_E_BADPARAMCOUNT;
+        goto done;
+    }
+
+    for (i = 0; i < nb_args; i++)
+    {
+        VARIANT *arg = &params->rgvarg[nb_args - 1 - i], conv;
+        VARTYPE vt;
+
+        if (V_VT( arg ) == VT_ERROR && V_ERROR( arg ) == DISP_E_PARAMNOTFOUND) continue;
+        if (!list[i].in) continue;
+        VariantInit( &conv );
+        if ((list[i].type & CIM_FLAG_ARRAY) || !(vt = to_vartype( list[i].type ))) hr = VariantCopyInd( &conv, arg );
+        else hr = VariantChangeType( &conv, arg, 0, vt );
+        if (FAILED(hr)) goto done;
+        hr = IWbemClassObject_Put( in_inst, list[i].name, 0, &conv, 0 );
+        VariantClear( &conv );
+        if (FAILED(hr)) goto done;
+    }
+
+    if (FAILED(hr = object_get_path( object->object, &path, &is_class ))) goto done;
+    if (FAILED(hr = IWbemServices_ExecMethod( object->services->services, path, (BSTR)method, 0, NULL, in_inst,
+                                              &out, NULL ))) goto done;
+
+    for (i = 0; out && i < nb_args; i++)
+    {
+        VARIANT *arg = &params->rgvarg[nb_args - 1 - i];
+
+        if (!list[i].out || !(V_VT( arg ) & VT_BYREF)) continue;
+        if (V_VT( arg ) == (VT_BYREF | VT_VARIANT))
+        {
+            VariantClear( V_VARIANTREF( arg ) );
+            IWbemClassObject_Get( out, list[i].name, 0, V_VARIANTREF( arg ), NULL, NULL );
+        }
+    }
+    if (result)
+    {
+        VariantInit( result );
+        if (out) IWbemClassObject_Get( out, L"ReturnValue", 0, result, NULL, NULL );
+    }
+
+done:
+    SysFreeString( path );
+    free_params( list, count );
+    if (in_sign) IWbemClassObject_Release( in_sign );
+    if (out_sign) IWbemClassObject_Release( out_sign );
+    if (in_inst) IWbemClassObject_Release( in_inst );
+    if (out) IWbemClassObject_Release( out );
+    return hr;
+}
