+static HRESULT WINAPI objpath_QueryInterface( ISWbemObjectPath *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_ISWbemObjectPath ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
