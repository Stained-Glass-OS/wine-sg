+static HRESULT WINAPI privilege_get_Name( ISWbemPrivilege *iface, BSTR *name )
+{
+    struct privilege *priv = impl_from_ISWbemPrivilege( iface );
+
+    TRACE( "%p, %p\n", priv, name );
+    if (!name) return E_INVALIDARG;
+    return (*name = SysAllocString( privilege_names[priv->id] )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI privilege_get_DisplayName( ISWbemPrivilege *iface, BSTR *name )
+{
+    struct privilege *priv = impl_from_ISWbemPrivilege( iface );
+    WCHAR buffer[256];
+    DWORD len = ARRAY_SIZE(buffer), lang;
+
+    TRACE( "%p, %p\n", priv, name );
+    if (!name) return E_INVALIDARG;
+    if (!LookupPrivilegeDisplayNameW( NULL, privilege_names[priv->id], buffer, &len, &lang ) || !buffer[0])
+        lstrcpyW( buffer, privilege_names[priv->id] );
+    return (*name = SysAllocString( buffer )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI privilege_get_Identifier( ISWbemPrivilege *iface, WbemPrivilegeEnum *id )
+{
+    struct privilege *priv = impl_from_ISWbemPrivilege( iface );
+
+    TRACE( "%p, %p\n", priv, id );
+    if (!id) return E_INVALIDARG;
+    *id = priv->id;
