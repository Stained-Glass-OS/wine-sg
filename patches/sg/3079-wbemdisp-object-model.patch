+static HRESULT WINAPI privilege_QueryInterface( ISWbemPrivilege *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_ISWbemPrivilege ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        ISWbemPrivilege_AddRef( (*obj = iface) );
+        return S_OK;
+    }
+    WARN( "interface %s not implemented\n", debugstr_guid(riid) );
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
