+    HRESULT hr;
+    WCHAR *str;
+
+    TRACE( "%p, %p\n", p, name );
+    if (!name) return E_INVALIDARG;
+    if (!(path = objpath_full( p ))) return E_OUTOFMEMORY;
+    if (!(str = malloc( (SysStringLen( path ) + 10) * sizeof(WCHAR) )))
+    {
+        SysFreeString( path );
+        return E_OUTOFMEMORY;
+    }
+    lstrcpyW( str, L"winmgmts:" );
+    lstrcatW( str, path );
+    hr = return_bstr( str, name );
+    free( str );
+    SysFreeString( path );
+    return hr;
+}
