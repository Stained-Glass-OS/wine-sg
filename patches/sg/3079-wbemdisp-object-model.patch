+{
+    objpath_QueryInterface, objpath_AddRef, objpath_Release,
+    objpath_GetTypeInfoCount, objpath_GetTypeInfo, objpath_GetIDsOfNames, objpath_Invoke,
+    objpath_get_Path, objpath_put_Path, objpath_get_RelPath, objpath_put_RelPath,
+    objpath_get_Server, objpath_put_Server, objpath_get_Namespace, objpath_put_Namespace,
+    objpath_get_ParentNamespace, objpath_get_DisplayName, objpath_put_DisplayName,
+    objpath_get_Class, objpath_put_Class, objpath_get_IsClass, objpath_SetAsClass,
+    objpath_get_IsSingleton, objpath_SetAsSingleton, objpath_get_Keys, objpath_get_Security_,
+    objpath_get_Locale, objpath_put_Locale, objpath_get_Authority, objpath_put_Authority,
+};
+
+static HRESULT SWbemObjectPath_create( const WCHAR *path, ISWbemObjectPath **obj )
+{
+    struct objpath *p;
+    HRESULT hr;
+
+    if (!(p = calloc( 1, sizeof(*p) ))) return E_OUTOFMEMORY;
+    p->ISWbemObjectPath_iface.lpVtbl = &objpath_vtbl;
+    p->refs = 1;
+    p->locale = wcsdup( L"" );
+    p->authority = wcsdup( L"" );
+    if (FAILED(hr = objpath_parse( p, path ? path : L"" )))
+    {
+        ISWbemObjectPath_Release( &p->ISWbemObjectPath_iface );
+        return hr;
+    }
+    *obj = &p->ISWbemObjectPath_iface;
+    return S_OK;
+}
