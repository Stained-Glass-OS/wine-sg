+static HRESULT privilege_create( struct privset *set, LONG id, ISWbemPrivilege **obj )
+{
+    struct privilege *priv;
+
+    if (!(priv = calloc( 1, sizeof(*priv) ))) return E_OUTOFMEMORY;
+    priv->ISWbemPrivilege_iface.lpVtbl = &privilege_vtbl;
+    priv->refs = 1;
+    ISWbemPrivilegeSet_AddRef( &set->ISWbemPrivilegeSet_iface );
+    priv->set = set;
+    priv->id = id;
+    *obj = &priv->ISWbemPrivilege_iface;
+    return S_OK;
