+
+/* keys changed through Keys: the relative path follows them */
+static HRESULT objpath_sync_rel( struct objpath *p )
+{
+    IUnknown *unk = NULL;
+    IEnumVARIANT *e;
+    struct strbuf b = {0};
+    size_t class_len = wcscspn( p->rel, L".=" );
+    WCHAR *class = wcsdup_range( p->rel, class_len );
+    VARIANT v;
+    ULONG fetched;
+    BOOL first = TRUE, ok = class != NULL;
+    HRESULT hr;
+
+    if (!p->keys) { free( class ); return S_OK; }
+    if (FAILED(hr = ISWbemNamedValueSet_get__NewEnum( p->keys, &unk ))) { free( class ); return hr; }
+    IUnknown_QueryInterface( unk, &IID_IEnumVARIANT, (void **)&e );
+    IUnknown_Release( unk );
+    ok = ok && strbuf_add( &b, class );
+    VariantInit( &v );
+    while (ok && IEnumVARIANT_Next( e, 1, &v, &fetched ) == S_OK && fetched)
+    {
+        ISWbemNamedValue *nv;
+        BSTR name = NULL;
+        VARIANT value;
+        WCHAR num[32];
+
+        VariantInit( &value );
+        if (V_VT( &v ) == VT_DISPATCH && SUCCEEDED(IDispatch_QueryInterface( V_DISPATCH( &v ), &IID_ISWbemNamedValue, (void **)&nv )))
+        {
+            ISWbemNamedValue_get_Name( nv, &name );
+            ISWbemNamedValue_get_Value( nv, &value );
+            ok = strbuf_add( &b, first ? L"." : L"," ) && strbuf_add( &b, name ? name : L"" ) && strbuf_add( &b, L"=" );
+            first = FALSE;
+            if (V_VT( &value ) == VT_BSTR)
+            {
+                const WCHAR *c;
+
+                ok = ok && strbuf_add( &b, L"\"" );
+                for (c = V_BSTR( &value ); ok && c && *c; c++)
+                {
+                    WCHAR esc[3] = { '\\', *c, 0 };
+                    WCHAR plain[2] = { *c, 0 };
+                    ok = strbuf_add( &b, (*c == '"' || *c == '\\') ? esc : plain );
+                }
+                ok = ok && strbuf_add( &b, L"\"" );
+            }
+            else
+            {
+                VARIANT str;
+                VariantInit( &str );
+                if (SUCCEEDED(VariantChangeType( &str, &value, 0, VT_BSTR ))) ok = ok && strbuf_add( &b, V_BSTR( &str ) );
+                else { swprintf( num, ARRAY_SIZE(num), L"0" ); ok = ok && strbuf_add( &b, num ); }
+                VariantClear( &str );
+            }
+            SysFreeString( name );
+            VariantClear( &value );
+            ISWbemNamedValue_Release( nv );
+        }
+        VariantClear( &v );
+    }
+    IEnumVARIANT_Release( e );
+    if (ok && !first)
+    {
+        free( p->rel );
+        p->rel = b.str;
+        b.str = NULL;
+    }
+    free( b.str );
+    free( class );
+    return ok ? S_OK : E_OUTOFMEMORY;
+}
+
+static BSTR objpath_full( struct objpath *p )
+{
+    struct strbuf b = {0};
+    BSTR ret = NULL;
+    BOOL ok = TRUE;
+
+    objpath_sync_rel( p );
+    if (*p->server)
+        ok = strbuf_add( &b, L"\\\\" ) && strbuf_add( &b, p->server ) &&
+             (!*p->namespace || (strbuf_add( &b, L"\\" ) && strbuf_add( &b, p->namespace )));
+    else if (*p->namespace) ok = strbuf_add( &b, p->namespace );
+    if (ok && (*p->server || *p->namespace) && *p->rel) ok = strbuf_add( &b, L":" );
+    if (ok) ok = strbuf_add( &b, p->rel );
+    if (ok && b.str) ret = SysAllocString( b.str );
+    else if (ok) ret = SysAllocString( L"" );
+    free( b.str );
+    return ret;
+}
+
+static HRESULT WINAPI objpath_get_Path( ISWbemObjectPath *iface, BSTR *path )
+{
+    struct objpath *p = impl_from_ISWbemObjectPath( iface );
