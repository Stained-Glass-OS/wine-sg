+static HRESULT WINAPI privset_AddAsString( ISWbemPrivilegeSet *iface, BSTR name, VARIANT_BOOL enabled,
+                                           ISWbemPrivilege **priv )
+{
+    LONG i;
+
+    TRACE( "%p, %s, %d, %p\n", iface, debugstr_w(name), enabled, priv );
+    if (!name || !priv) return E_INVALIDARG;
+    *priv = NULL;
+    for (i = 1; i <= NB_PRIVILEGES; i++)
