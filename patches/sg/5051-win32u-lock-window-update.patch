From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: Hold back drawing to a window locked by LockWindowUpdate.

While LockWindowUpdate holds a window, DCs of it and its children have an
empty visible region unless they were taken with DCX_LOCKWINDOWUPDATE
(which GetDCEx now keeps in the DCE's flags): drawing is held back, and
GetPixel gives CLR_INVALID. Locking and unlocking refresh those DCs'
regions; unlocking repaints the window. It only recorded the window.
Removes the todo_wine_if in user32's LockWindowUpdate test.

Gate: test/win32u-lockwindowupdate-gate.sh (64/32, private Xvfb).
---
 dlls/user32/tests/win.c |  1 -
 dlls/win32u/dce.c       | 41 ++++++++++++++++++++++++++++++++++++-----
 2 files changed, 36 insertions(+), 6 deletions(-)

diff --git a/dlls/user32/tests/win.c b/dlls/user32/tests/win.c
index d84ef8c..dfd1539 100644
--- a/dlls/user32/tests/win.c
+++ b/dlls/user32/tests/win.c
@@ -11511,7 +11511,6 @@ static void test_LockWindowUpdate(HWND parent)
             do { \
                 COLORREF c = GetPixel(hdc, p.x, p.y); \
                 COLORREF e = tests[i].expect_valid ? (c_valid) : (c_invalid); \
-                todo_wine_if(!tests[i].expect_valid) \
                 ok(c == e, "%u: GetPixel: got %08lx, expected %08lx\n", i, c, e); \
             } while (0)
 
diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index 7ed020d..e2f5825 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -984,6 +984,10 @@ static void dump_rdw_flags(UINT flags)
  * Set the visible region and X11 drawable for the DC associated to
  * a given window.
  */
+/* the window LockWindowUpdate locked: drawing to it and its children is held
+ * back (an empty visible region) unless the DC asked for DCX_LOCKWINDOWUPDATE */
+static HWND locked_hwnd;
+
 static void update_visible_region( struct dce *dce )
 {
     struct window_surface *surface = NULL;
@@ -1036,6 +1040,12 @@ static void update_visible_region( struct dce *dce )
     if (dce->clip_rgn) NtGdiCombineRgn( vis_rgn, vis_rgn, dce->clip_rgn,
                                         (flags & DCX_INTERSECTRGN) ? RGN_AND : RGN_DIFF );
 
+#ifndef SG_MUTANT_LOCKUPDATE_DRAWS
+    if (locked_hwnd && !(flags & DCX_LOCKWINDOWUPDATE) &&
+        (dce->hwnd == locked_hwnd || is_child( locked_hwnd, dce->hwnd )))
+        NtGdiSetRectRgn( vis_rgn, 0, 0, 0, 0 );
+#endif
+
     /* don't use a surface to paint the client area of OpenGL windows */
     if (!(paint_flags & SET_WINPOS_PIXEL_FORMAT) || (flags & DCX_WINDOW))
     {
@@ -1540,7 +1550,9 @@ HDC WINAPI NtUserGetDCEx( HWND hwnd, HRGN clip_rgn, DWORD flags )
         NtGdiSetLayout( dce->hdc, -1, LAYOUT_RTL );
 
     dce->hwnd = hwnd;
-    dce->flags = (dce->flags & ~user_flags) | (flags & user_flags);
+    /* a DC that may draw into a locked window keeps saying so */
+    if (locked_hwnd && ((dce->flags ^ flags) & DCX_LOCKWINDOWUPDATE)) update_vis_rgn = TRUE;
+    dce->flags = (dce->flags & ~(user_flags | DCX_LOCKWINDOWUPDATE)) | (flags & (user_flags | DCX_LOCKWINDOWUPDATE));
 
     /* cross-process invalidation is not supported yet, so always update the vis rgn */
     if (!is_current_process_window( hwnd )) update_vis_rgn = TRUE;
@@ -2149,18 +2161,37 @@ BOOL WINAPI NtUserInvalidateRect( HWND hwnd, const RECT *rect, BOOL erase )
 /***********************************************************************
  *           NtUserLockWindowUpdate (win32u.@)
  */
+/* recompute the visible regions of the DCs of a window and its children */
+static void make_window_dces_dirty( HWND hwnd )
+{
+    struct dce *dce;
+
+    user_lock();
+    LIST_FOR_EACH_ENTRY( dce, &dce_list, struct dce, entry )
+        if (dce->hwnd && (dce->hwnd == hwnd || is_child( hwnd, dce->hwnd ))) make_dc_dirty( dce );
+    user_unlock();
+}
+
 BOOL WINAPI NtUserLockWindowUpdate( HWND hwnd )
 {
-    static HWND locked_hwnd;
+    HWND prev;
 
-    FIXME( "(%p), partial stub!\n", hwnd );
+    TRACE( "(%p)\n", hwnd );
 
     if (!hwnd)
     {
-        locked_hwnd = NULL;
+        if ((prev = InterlockedExchangePointer( (void **)&locked_hwnd, NULL )))
+        {
+            make_window_dces_dirty( prev );
+            /* Windows invalidates what was drawn into meanwhile; that area is
+             * not recorded here, so the whole window repaints */
+            NtUserRedrawWindow( prev, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+        }
         return TRUE;
     }
-    return !InterlockedCompareExchangePointer( (void **)&locked_hwnd, hwnd, 0 );
+    if (InterlockedCompareExchangePointer( (void **)&locked_hwnd, hwnd, 0 )) return FALSE;
+    make_window_dces_dirty( hwnd );
+    return TRUE;
 }
 
 /*************************************************************************
