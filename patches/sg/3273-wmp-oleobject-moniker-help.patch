From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:55:18 -0700
Subject: [PATCH] wmp: SetMoniker and ContextSensitiveHelp succeed (3273)

IOleObject::SetMoniker and IOleInPlaceObject::ContextSensitiveHelp returned E_NOTIMPL, which the documentation does not list; both return S_OK (the control is not a link source and has no help mode).

diff --git a/dlls/wmp/oleobj.c b/dlls/wmp/oleobj.c
index cbabc3b..5ce6190 100644
--- a/dlls/wmp/oleobj.c
+++ b/dlls/wmp/oleobj.c
@@ -386,8 +386,12 @@ static HRESULT WINAPI OleObject_Close(IOleObject *iface, DWORD dwSaveOption)
 static HRESULT WINAPI OleObject_SetMoniker(IOleObject *iface, DWORD dwWhichMoniker, IMoniker *pmk)
 {
     WindowsMediaPlayer *This = impl_from_IOleObject(iface);
-    FIXME("(%p %ld %p)->()\n", This, dwWhichMoniker, pmk);
+    TRACE("(%p %ld %p)\n", This, dwWhichMoniker, pmk);
+#ifdef SG_MUTANT_WMP
     return E_NOTIMPL;
+#endif
+    /* the control is not a link source: the name is accepted and not used */
+    return S_OK;
 }
 
 static HRESULT WINAPI OleObject_GetMoniker(IOleObject *iface, DWORD dwAssign, DWORD dwWhichMoniker, IMoniker **ppmk)
@@ -670,8 +674,12 @@ static HRESULT WINAPI OleInPlaceObjectWindowless_ContextSensitiveHelp(IOleInPlac
         BOOL fEnterMode)
 {
     WindowsMediaPlayer *This = impl_from_IOleInPlaceObjectWindowless(iface);
-    FIXME("(%p)->(%x)\n", This, fEnterMode);
+    TRACE("(%p)->(%x)\n", This, fEnterMode);
+#ifdef SG_MUTANT_WMP
     return E_NOTIMPL;
+#endif
+    /* the control has no help mode of its own */
+    return S_OK;
 }
 
 static HRESULT WINAPI OleInPlaceObjectWindowless_InPlaceDeactivate(IOleInPlaceObjectWindowless *iface)
