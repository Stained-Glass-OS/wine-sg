From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: GetWindowPlacement of another process's window

GetWindowPlacement of another process's window was "not fully
supported": it returned the window's current rectangle as its normal one
and -1 for the minimized and maximized positions, so window managers,
session savers, taskbar tools and accessibility programs restored a
maximized window to full screen and lost where it had been.

- The placement is asked of the window's own thread with a new internal
  message, WM_WINE_GETPLACEMENT, part by part (show command and flags,
  the minimized and maximized positions, the normal rectangle), in the
  window's DPI, then mapped to the caller's. A window whose thread does
  not answer still gives its current rectangle, as before.
- explorer's taskbar thumbnails (1659) take a window as it last drew
  itself (PrintWindow with PW_RENDERFULLCONTENT), so a covered window
  shows as itself; the screen is the fallback.

Wine's user32 win tests: 61231 tests, no failures, as before.

Gate: test/xplacement-gate.sh (the shell's desktop,
test/xplacement-probe.c). Mutant SG_MUTANT_NO_REMOTE_PLACEMENT
(win32u/window.c).
---
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2090,6 +2090,8 @@ static LRESULT handle_internal_message( HWND hwnd, UINT msg, WPARAM wparam, LPAR
         return set_window_cloak( hwnd, wparam );
     case WM_WINE_PRINTWINDOW:
         return print_window_to_section( hwnd, (HANDLE)wparam, lparam );
+    case WM_WINE_GETPLACEMENT:
+        return get_window_placement_part( hwnd, wparam );
     case WM_WINE_SHOWWINDOW:
         if (is_desktop_window( hwnd )) return 0;
         return NtUserShowWindow( hwnd, wparam );
--- a/dlls/win32u/spy.c
+++ b/dlls/win32u/spy.c
@@ -1127,7 +1127,7 @@ static const char * const CCMMessageTypeNames[SPY_MAX_CCMMSGNUM + 1] =
     "CCM_SETNOTIFYWINDOW"
 };
 
-#define SPY_MAX_WINEMSGNUM   (WM_WINE_PRINTWINDOW - WM_WINE_DESTROYWINDOW)
+#define SPY_MAX_WINEMSGNUM   (WM_WINE_GETPLACEMENT - WM_WINE_DESTROYWINDOW)
 static const char * const WINEMessageTypeNames[SPY_MAX_WINEMSGNUM + 1] =
 {
     "WM_WINE_DESTROYWINDOW",
@@ -1144,6 +1144,7 @@ static const char * const WINEMessageTypeNames[SPY_MAX_WINEMSGNUM + 1] =
     "WM_WINE_UPDATEWINDOWSTATE",
     "WM_WINE_SETCLOAK",
     "WM_WINE_PRINTWINDOW",
+    "WM_WINE_GETPLACEMENT",
 };
 
 /* Virtual key names */
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -311,6 +311,7 @@ extern LONG_PTR set_window_long( HWND hwnd, INT offset, UINT size, LONG_PTR newv
 extern BOOL set_window_pos( WINDOWPOS *winpos, int parent_x, int parent_y );
 extern BOOL set_window_cloak( HWND hwnd, UINT flags );
 extern LRESULT print_window_to_section( HWND hwnd, HANDLE section, LPARAM lparam );
+extern LRESULT get_window_placement_part( HWND hwnd, UINT part );
 extern ULONG set_window_style( HWND hwnd, ULONG set_bits, ULONG clear_bits );
 extern BOOL show_owned_popups( HWND owner, BOOL show );
 extern void update_window_state( HWND hwnd );
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2892,6 +2892,64 @@ static BOOL empty_point( POINT pt )
     return pt.x == -1 && pt.y == -1;
 }
 
+/* Stained Glass OS 1660: in the window's thread (WM_WINE_GETPLACEMENT), one
+ * part of its placement, in the window's DPI, two 16-bit values packed:
+ * 0 showCmd and flags, 1 the minimized position, 2 the maximized one, 3 the
+ * normal rectangle's top left, 4 its bottom right */
+LRESULT get_window_placement_part( HWND hwnd, UINT part )
+{
+    WINDOWPLACEMENT wp = { sizeof(wp) };
+    UINT context;
+    LRESULT ret;
+
+    /* in the window's own DPI */
+    context = set_thread_dpi_awareness_context( get_window_dpi_awareness_context( hwnd ));
+    ret = NtUserGetWindowPlacement( hwnd, &wp );
+    set_thread_dpi_awareness_context( context );
+    if (!ret) return 0;
+    switch (part)
+    {
+    case 0: return MAKELONG( wp.showCmd, wp.flags | 0x8000 );
+    case 1: return MAKELONG( (SHORT)wp.ptMinPosition.x, (SHORT)wp.ptMinPosition.y );
+    case 2: return MAKELONG( (SHORT)wp.ptMaxPosition.x, (SHORT)wp.ptMaxPosition.y );
+    case 3: return MAKELONG( (SHORT)wp.rcNormalPosition.left, (SHORT)wp.rcNormalPosition.top );
+    case 4: return MAKELONG( (SHORT)wp.rcNormalPosition.right, (SHORT)wp.rcNormalPosition.bottom );
+    }
+    return 0;
+}
+
+/* another process's window: its placement, asked of its thread */
+static BOOL get_other_process_placement( HWND hwnd, WINDOWPLACEMENT *placement )
+{
+    UINT win_dpi = get_dpi_for_window( hwnd ), thread_dpi = get_thread_dpi();
+    DWORD_PTR parts[5];
+    POINT pt;
+    RECT rc;
+    UINT i;
+
+#ifdef SG_MUTANT_NO_REMOTE_PLACEMENT
+    return FALSE;
+#endif
+    /* the first part carries a marker: no answer, no placement */
+    for (i = 0; i < ARRAY_SIZE(parts); i++)
+    {
+        parts[i] = (DWORD)send_message_timeout( hwnd, WM_WINE_GETPLACEMENT, i, 0, SMTO_ABORTIFHUNG, 2000, FALSE );
+        if (!i && !(HIWORD(parts[0]) & 0x8000)) return FALSE;
+    }
+    placement->length  = sizeof(*placement);
+    placement->showCmd = LOWORD(parts[0]);
+    placement->flags   = HIWORD(parts[0]) & 0x7fff;
+    pt.x = (SHORT)LOWORD(parts[1]);
+    pt.y = (SHORT)HIWORD(parts[1]);
+    placement->ptMinPosition = empty_point( pt ) ? pt : map_dpi_point( pt, win_dpi, thread_dpi );
+    pt.x = (SHORT)LOWORD(parts[2]);
+    pt.y = (SHORT)HIWORD(parts[2]);
+    placement->ptMaxPosition = empty_point( pt ) ? pt : map_dpi_point( pt, win_dpi, thread_dpi );
+    SetRect( &rc, (SHORT)LOWORD(parts[3]), (SHORT)HIWORD(parts[3]), (SHORT)LOWORD(parts[4]), (SHORT)HIWORD(parts[4]) );
+    placement->rcNormalPosition = map_dpi_rect( rc, win_dpi, thread_dpi );
+    return TRUE;
+}
+
 /***********************************************************************
  *           NtUserGetWindowPlacement (win32u.@)
  */
@@ -2923,7 +2981,9 @@ BOOL WINAPI NtUserGetWindowPlacement( HWND hwnd, WINDOWPLACEMENT *placement )
         if (!get_window_rect( hwnd, &normal_position, get_thread_dpi() ))
             return FALSE;
 
-        FIXME("not fully supported on other process window %p.\n", hwnd);
+        /* Stained Glass OS 1660: asked of the window's own thread */
+        if (get_other_process_placement( hwnd, placement )) return TRUE;
+        WARN( "window %p of another process did not answer; its current rectangle\n", hwnd );
 
         placement->length  = sizeof(*placement);
         style = get_window_long( hwnd, GWL_STYLE );
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -616,6 +616,7 @@ enum wine_internal_message
     WM_WINE_UPDATEWINDOWSTATE,
     WM_WINE_SETCLOAK,
     WM_WINE_PRINTWINDOW,
+    WM_WINE_GETPLACEMENT,   /* Stained Glass OS 1660 */
     WM_WINE_FIRST_DRIVER_MSG = 0x80001000,  /* range of messages reserved for the USER driver */
     WM_WINE_CLIPCURSOR = 0x80001ff0, /* internal driver notification messages */
     WM_WINE_SETCURSOR,
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -2182,6 +2182,52 @@ static BOOL sg_is_iconic_window( HWND hwnd )
     return (has > 1) || (force > 1);   /* stored + 1 */
 }
 
+static BOOL sg_print_capture( struct taskbar_button *win )
+{
+    RECT rc, part;
+    HDC screen, mem, mem2;
+    HBITMAP bmp, out;
+    HGDIOBJ old, old2;
+    int w, h;
+    BOOL ret = FALSE;
+
+    GetWindowRect( win->hwnd, &rc );
+    w = rc.right - rc.left;
+    h = rc.bottom - rc.top;
+    if (w <= 0 || h <= 0 || w > 8192 || h > 8192) return FALSE;
+    SetRect( &part, 0, 0, w, h );
+    if (win->has_clip)
+    {
+        POINT pt = { win->clip.left, win->clip.top };
+        ClientToScreen( win->hwnd, &pt );
+        SetRect( &part, pt.x - rc.left, pt.y - rc.top, pt.x - rc.left + win->clip.right - win->clip.left,
+                 pt.y - rc.top + win->clip.bottom - win->clip.top );
+        IntersectRect( &part, &part, &(RECT){ 0, 0, w, h } );
+        if (IsRectEmpty( &part )) return FALSE;
+    }
+    screen = GetDC( 0 );
+    mem = CreateCompatibleDC( screen );
+    bmp = CreateCompatibleBitmap( screen, w, h );
+    old = SelectObject( mem, bmp );
+    if (PrintWindow( win->hwnd, mem, PW_RENDERFULLCONTENT ))
+    {
+        mem2 = CreateCompatibleDC( screen );
+        out = CreateCompatibleBitmap( screen, part.right - part.left, part.bottom - part.top );
+        old2 = SelectObject( mem2, out );
+        BitBlt( mem2, 0, 0, part.right - part.left, part.bottom - part.top, mem, part.left, part.top, SRCCOPY );
+        SelectObject( mem2, old2 );
+        DeleteDC( mem2 );
+        if (win->snapshot) DeleteObject( win->snapshot );
+        win->snapshot = out;
+        ret = TRUE;
+    }
+    SelectObject( mem, old );
+    DeleteObject( bmp );
+    DeleteDC( mem );
+    ReleaseDC( 0, screen );
+    return ret;
+}
+
 /* the window as it looks now, from the screen (visible, not minimized) */
 static void sg_capture( struct taskbar_button *win )
 {
@@ -2191,6 +2237,8 @@ static void sg_capture( struct taskbar_button *win )
     int w, h;
 
     if (!win->hwnd || win->xwin || !IsWindowVisible( win->hwnd ) || IsIconic( win->hwnd )) return;
+    /* what the window last drew (1660), covered or not; the screen otherwise */
+    if (!win->elevated && sg_print_capture( win )) return;
     if (win->has_clip)
     {
         POINT pt = { win->clip.left, win->clip.top };
