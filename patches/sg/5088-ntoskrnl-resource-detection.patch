From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: IoReportResourceForDetection.

The routine was a stub that returned STATUS_NOT_IMPLEMENTED. It now claims
the resources of a list (ports, memory, interrupts, DMA channels) for the
driver, or for the device when a device list is given, reports
STATUS_CONFLICTING_ADDRESSES with ConflictDetected set when another owner
already claimed overlapping resources (shared claims do not conflict),
replaces an owner's earlier claim, gives a claim back for a list with a count
of zero and returns STATUS_UNSUCCESSFUL for an invalid list. Deleting a
device or driver gives its claims back.

Gate: test/ntoskrnl-resclaim-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -1830,6 +1830,8 @@
 }
 
 
+static void release_resource_claims( void *owner );
+
 /***********************************************************************
  *           IoDeleteDriver   (NTOSKRNL.EXE.@)
  */
@@ -1837,6 +1839,7 @@
 {
     TRACE( "(%p)\n", driver_object );
 
+    release_resource_claims( driver_object );
     EnterCriticalSection( &drivers_cs );
     wine_rb_remove_key( &wine_drivers, &driver_object->DriverName );
     LeaveCriticalSection( &drivers_cs );
@@ -1972,6 +1975,7 @@
         free_io_timer( device );
         free_startio_state( device );
         unregister_shutdown( device );
+        release_resource_claims( device );
         while (*prev && *prev != device) prev = &(*prev)->NextDevice;
         if (*prev) *prev = (*prev)->NextDevice;
         if ((children = wine_device->children))
@@ -2415,16 +2419,162 @@
 /***********************************************************************
  *           IoReportResourceForDetection   (NTOSKRNL.EXE.@)
  */
+/* resources claimed with IoReportResourceForDetection: one list per owner (a driver or a device).
+ * The descriptors of a CM_RESOURCE_LIST are 4-byte packed (20 bytes each), unlike the unpacked
+ * CM_PARTIAL_RESOURCE_DESCRIPTOR of the headers. */
+#define CM_TYPE_PORT      1
+#define CM_TYPE_INTERRUPT 2
+#define CM_TYPE_MEMORY    3
+#define CM_TYPE_DMA       4
+#define CM_SHARE_SHARED   3
+#define CM_LIST_COUNT_OFFSET 16   /* Count of the first full descriptor's partial list */
+#define CM_LIST_DESCS_OFFSET 20   /* its first descriptor */
+
+#include <pshpack4.h>
+struct cm_descriptor
+{
+    UCHAR Type;
+    UCHAR ShareDisposition;
+    USHORT Flags;
+    union
+    {
+        struct { PHYSICAL_ADDRESS Start; ULONG Length; } range;   /* port or memory */
+        struct { ULONG Level, Vector, Affinity; } interrupt;
+        struct { ULONG Channel, Port, Reserved; } dma;
+        ULONG size[4];
+    } u;
+};
+#include <poppack.h>
+
+struct resource_claim
+{
+    struct list entry;
+    void *owner;
+    struct cm_descriptor desc;
+};
+static struct list resource_claims = LIST_INIT( resource_claims );
+static CRITICAL_SECTION resource_cs;
+static CRITICAL_SECTION_DEBUG resource_cs_debug =
+{
+    0, 0, &resource_cs,
+    { &resource_cs_debug.ProcessLocksList, &resource_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": resource_cs") }
+};
+static CRITICAL_SECTION resource_cs = { &resource_cs_debug, -1, 0, 0, 0, 0 };
+
+static BOOL resources_conflict( const struct cm_descriptor *a, const struct cm_descriptor *b )
+{
+    if (a->Type != b->Type) return FALSE;
+#ifndef SG_MUTANT_RES_SHARED
+    if (a->ShareDisposition == CM_SHARE_SHARED && b->ShareDisposition == CM_SHARE_SHARED) return FALSE;
+#endif
+    switch (a->Type)
+    {
+    case CM_TYPE_PORT:
+    case CM_TYPE_MEMORY:
+    {
+        ULONGLONG a1 = a->u.range.Start.QuadPart, a2 = a1 + a->u.range.Length;
+        ULONGLONG b1 = b->u.range.Start.QuadPart, b2 = b1 + b->u.range.Length;
+        return a->u.range.Length && b->u.range.Length && a1 < b2 && b1 < a2;
+    }
+    case CM_TYPE_INTERRUPT:
+        return a->u.interrupt.Vector == b->u.interrupt.Vector &&
+               (!a->u.interrupt.Affinity || !b->u.interrupt.Affinity || (a->u.interrupt.Affinity & b->u.interrupt.Affinity));
+    case CM_TYPE_DMA:
+        return a->u.dma.Channel == b->u.dma.Channel;
+    }
+    return FALSE;
+}
+
+/* the descriptors of the first full resource descriptor of a list in a buffer of the given size,
+ * NULL when the list is not valid */
+static struct cm_descriptor *list_descriptors( CM_RESOURCE_LIST *list, ULONG size, ULONG *count )
+{
+    struct cm_descriptor *descs;
+    ULONG i;
+
+    *count = 0;
+    if (size < CM_LIST_DESCS_OFFSET) return NULL;
+    *count = *(ULONG *)((char *)list + CM_LIST_COUNT_OFFSET);
+    descs = (struct cm_descriptor *)((char *)list + CM_LIST_DESCS_OFFSET);
+    if (*count > (size - CM_LIST_DESCS_OFFSET) / sizeof(*descs)) return NULL;
+    for (i = 0; i < *count; i++) if (!descs[i].Type || descs[i].Type > CM_TYPE_DMA) return NULL;
+    return descs;
+}
+
+static void release_resource_claims( void *owner )
+{
+    struct resource_claim *claim, *next;
+
+    EnterCriticalSection( &resource_cs );
+    LIST_FOR_EACH_ENTRY_SAFE( claim, next, &resource_claims, struct resource_claim, entry )
+    {
+        if (claim->owner != owner) continue;
+        list_remove( &claim->entry );
+        free( claim );
+    }
+    LeaveCriticalSection( &resource_cs );
+}
+
 NTSTATUS WINAPI IoReportResourceForDetection( DRIVER_OBJECT *drv_obj, CM_RESOURCE_LIST *drv_list, ULONG drv_size,
                                               DEVICE_OBJECT *dev_obj, CM_RESOURCE_LIST *dev_list, ULONG dev_size,
                                               BOOLEAN *conflict )
 {
-    FIXME( "(%p, %p, %lu, %p, %p, %lu, %p): stub\n", drv_obj, drv_list, drv_size,
-           dev_obj, dev_list, dev_size, conflict );
+    struct cm_descriptor *descs = NULL;
+    struct resource_claim *claim, *next;
+    CM_RESOURCE_LIST *list;
+    ULONG size, count = 0, i;
+    void *owner;
 
-    return STATUS_NOT_IMPLEMENTED;
-}
+    TRACE( "(%p, %p, %lu, %p, %p, %lu, %p)\n", drv_obj, drv_list, drv_size, dev_obj, dev_list, dev_size, conflict );
+
+    /* a device list wins over a driver list, and claims against the device */
+    if (dev_list) { list = dev_list; size = dev_size; owner = dev_obj ? (void *)dev_obj : (void *)drv_obj; }
+    else { list = drv_list; size = drv_size; owner = drv_obj; }
+    if (conflict) *conflict = FALSE;
+    if (!owner) return STATUS_INVALID_PARAMETER;
+
+    /* no list, or one with no descriptors, gives the claim back */
+    if (list)
+    {
+        if (size < CM_LIST_DESCS_OFFSET) return STATUS_UNSUCCESSFUL;
+        if (list->Count && *(ULONG *)((char *)list + CM_LIST_COUNT_OFFSET))
+        {
+            if (!(descs = list_descriptors( list, size, &count ))) return STATUS_UNSUCCESSFUL;
+        }
+    }
 
+    EnterCriticalSection( &resource_cs );
+    for (i = 0; i < count; i++)
+    {
+        LIST_FOR_EACH_ENTRY( claim, &resource_claims, struct resource_claim, entry )
+        {
+#ifdef SG_MUTANT_RES_NO_CONFLICT
+            if (1) continue;
+#endif
+            if (claim->owner == owner || !resources_conflict( &claim->desc, &descs[i] )) continue;
+            LeaveCriticalSection( &resource_cs );
+            if (conflict) *conflict = TRUE;
+            return STATUS_CONFLICTING_ADDRESSES;
+        }
+    }
+    /* what the owner claimed before is replaced */
+    LIST_FOR_EACH_ENTRY_SAFE( claim, next, &resource_claims, struct resource_claim, entry )
+    {
+        if (claim->owner != owner) continue;
+        list_remove( &claim->entry );
+        free( claim );
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (!(claim = malloc( sizeof(*claim) ))) break;
+        claim->owner = owner;
+        claim->desc = descs[i];
+        list_add_tail( &resource_claims, &claim->entry );
+    }
+    LeaveCriticalSection( &resource_cs );
+    return STATUS_SUCCESS;
+}
 
 /***********************************************************************
  *           IoReportResourceUsage    (NTOSKRNL.EXE.@)
