+/* Stained Glass OS 1676: activation factories a process registers for its
+ * own classes (RoRegisterActivationFactories), found by RoGetActivationFactory
+ * before the registry's in-process servers. */
+struct registered_factories
+{
+    struct list entry;
+    UINT32 count;
+    HSTRING *classes;
+    PFNGETACTIVATIONFACTORY *callbacks;
+};
+
+static struct list registered_factories = LIST_INIT(registered_factories);
+static CRITICAL_SECTION registered_factories_cs;
+static CRITICAL_SECTION_DEBUG registered_factories_cs_debug =
+{
+    0, 0, &registered_factories_cs,
+    { &registered_factories_cs_debug.ProcessLocksList, &registered_factories_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": registered_factories_cs") }
+};
+static CRITICAL_SECTION registered_factories_cs = { &registered_factories_cs_debug, -1, 0, 0, 0, 0 };
+
+static BOOL get_registered_factory(HSTRING classid, IActivationFactory **factory)
+{
+    struct registered_factories *reg;
+    PFNGETACTIVATIONFACTORY callback = NULL;
+    INT32 order;
+    UINT32 i;
+
+#ifdef SG_MUTANT_NO_REGISTERED_FACTORIES
+    return FALSE;
+#endif
+    EnterCriticalSection(&registered_factories_cs);
+    LIST_FOR_EACH_ENTRY(reg, &registered_factories, struct registered_factories, entry)
+    {
+        for (i = 0; i < reg->count && !callback; i++)
+            if (SUCCEEDED(WindowsCompareStringOrdinal(reg->classes[i], classid, &order)) && !order)
+                callback = reg->callbacks[i];
+        if (callback) break;
+    }
+    LeaveCriticalSection(&registered_factories_cs);
+    if (!callback) return FALSE;
+    *factory = NULL;
+    return SUCCEEDED(callback(classid, factory)) && *factory;
+}
