 /***********************************************************************
  *      RoRegisterActivationFactories (combase.@)
  */
 HRESULT WINAPI RoRegisterActivationFactories(HSTRING *classes, PFNGETACTIVATIONFACTORY *callbacks,
                                              UINT32 count, RO_REGISTRATION_COOKIE *cookie)
 {
-    FIXME("(%p, %p, %d, %p): stub\n", classes, callbacks, count, cookie);
+    struct registered_factories *reg;
+    UINT32 i;
+
+    TRACE("(%p, %p, %d, %p)\n", classes, callbacks, count, cookie);
+
+    if (!classes || !callbacks || !cookie || !count) return E_INVALIDARG;
+    if (!(reg = calloc(1, sizeof(*reg)))) return E_OUTOFMEMORY;
+    reg->classes = calloc(count, sizeof(*reg->classes));
+    reg->callbacks = calloc(count, sizeof(*reg->callbacks));
+    if (!reg->classes || !reg->callbacks)
+    {
+        free(reg->classes);
+        free(reg->callbacks);
+        free(reg);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (!callbacks[i] || FAILED(WindowsDuplicateString(classes[i], &reg->classes[i])))
+        {
+            while (i--) WindowsDeleteString(reg->classes[i]);
+            free(reg->classes);
+            free(reg->callbacks);
+            free(reg);
+            return E_INVALIDARG;
+        }
+        reg->callbacks[i] = callbacks[i];
+    }
+    reg->count = count;
+    EnterCriticalSection(&registered_factories_cs);
+    list_add_tail(&registered_factories, &reg->entry);
+    LeaveCriticalSection(&registered_factories_cs);
+    *cookie = (RO_REGISTRATION_COOKIE)reg;
+    return S_OK;
+}
+
+/***********************************************************************
+ *      RoRevokeActivationFactories (combase.@)
+ */
+void WINAPI RoRevokeActivationFactories(RO_REGISTRATION_COOKIE cookie)
+{
+    struct registered_factories *reg, *found = NULL;
+    UINT32 i;
+
+    TRACE("(%p)\n", cookie);
+
+    EnterCriticalSection(&registered_factories_cs);
+    LIST_FOR_EACH_ENTRY(reg, &registered_factories, struct registered_factories, entry)
+    {
+        if (reg == (struct registered_factories *)cookie)
+        {
+            found = reg;
+            list_remove(&reg->entry);
+            break;
+        }
+    }
+    LeaveCriticalSection(&registered_factories_cs);
+    if (!found) return;
+    for (i = 0; i < found->count; i++) WindowsDeleteString(found->classes[i]);
+    free(found->classes);
+    free(found->callbacks);
+    free(found);
+}
