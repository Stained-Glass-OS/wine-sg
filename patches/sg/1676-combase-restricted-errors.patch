+static struct restricted_error *current_restricted_error(void)
+{
+    IRestrictedErrorInfo *info;
+
+    /* GetRestrictedErrorInfo takes it from the thread; it is put back */
+    if (GetRestrictedErrorInfo(&info) != S_OK) return NULL;
+    SetRestrictedErrorInfo(info);
+    if (info->lpVtbl != &restricted_error_vtbl)
+    {
+        IRestrictedErrorInfo_Release(info);
+        return NULL;
+    }
+    return impl_from_IRestrictedErrorInfo(info);
+}
+
+static HRESULT create_restricted_error(HRESULT hr, const WCHAR *message, UINT len, IUnknown *language_exception,
+                                       struct restricted_error **out)
+{
+    struct restricted_error *error;
+    WCHAR buffer[512], ref[64];
+    DWORD count;
+
+    if (!(error = calloc(1, sizeof(*error)))) return E_OUTOFMEMORY;
+    error->IRestrictedErrorInfo_iface.lpVtbl = &restricted_error_vtbl;
+    error->IErrorInfo_iface.lpVtbl = &restricted_errorinfo_vtbl;
+    error->ILanguageExceptionErrorInfo2_iface.lpVtbl = &language_error_vtbl;
+    error->IAgileObject_iface.lpVtbl = &restricted_agile_vtbl;
+    error->ref = 1;
+    error->error = hr;
+    /* the description is the system's for the error, the restricted
+     * description the message given, at most 512 characters */
+    count = FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL, hr, 0, buffer,
+                           ARRAY_SIZE(buffer), NULL);
+    while (count && (buffer[count - 1] == '\n' || buffer[count - 1] == '\r')) buffer[--count] = 0;
+    error->description = count ? SysAllocString(buffer) : NULL;
+    if (message)
+    {
+        if (!len) len = lstrlenW(message);
+        error->restricted = SysAllocStringLen(message, min(len, RO_MAX_MESSAGE));
+    }
+    swprintf(ref, ARRAY_SIZE(ref), L"%08lX-%04lX-%08lX", hr, GetCurrentProcessId(), InterlockedIncrement(&error_serial));
+    error->reference = SysAllocString(ref);
+    if ((error->language_exception = language_exception)) IUnknown_AddRef(language_exception);
+
+    EnterCriticalSection(&registered_factories_cs);
+    if (recent_errors[recent_next]) IRestrictedErrorInfo_Release(&recent_errors[recent_next]->IRestrictedErrorInfo_iface);
+    recent_errors[recent_next] = error;
+    IRestrictedErrorInfo_AddRef(&error->IRestrictedErrorInfo_iface);
+    recent_next = (recent_next + 1) % ARRAY_SIZE(recent_errors);
+    LeaveCriticalSection(&registered_factories_cs);
+
+    *out = error;
+    return S_OK;
+}
+
+/* RoOriginateError and its kin: a failure's error object for the thread,
+ * the debugger told of it */
+static BOOL originate_error(HRESULT hr, const WCHAR *message, UINT len, IUnknown *language_exception,
+                            struct restricted_error *previous)
+{
+    struct restricted_error *error;
+
+    if (SUCCEEDED(hr)) return FALSE;
+#ifdef SG_MUTANT_NO_RESTRICTED_ERROR
+    return FALSE;
+#endif
+    if (FAILED(create_restricted_error(hr, message, len, language_exception, &error))) return FALSE;
+    if (previous)
+    {
+        error->previous = previous;
+        IRestrictedErrorInfo_AddRef(&previous->IRestrictedErrorInfo_iface);
+    }
+
+    if ((error_reporting_flags & RO_ERROR_REPORTING_FORCEEXCEPTIONS) ||
+        (IsDebuggerPresent() && !(error_reporting_flags & RO_ERROR_REPORTING_SUPPRESSEXCEPTIONS)))
+    {
+        ULONG_PTR args[2];
+
+        args[0] = error->restricted ? SysStringLen(error->restricted) : 0;
+        args[1] = (ULONG_PTR)error->restricted;
+        __TRY
+        {
+            RaiseException(EXCEPTION_RO_ORIGINATEERROR, 0, 2, args);
+        }
+        __EXCEPT_ALL
+        {
+        }
+        __ENDTRY
+    }
+
+    if (error_reporting_flags & RO_ERROR_REPORTING_SUPPRESSSETERRORINFO)
+    {
+        IRestrictedErrorInfo_Release(&error->IRestrictedErrorInfo_iface);
+        return FALSE;
+    }
+    SetRestrictedErrorInfo(&error->IRestrictedErrorInfo_iface);
+    IRestrictedErrorInfo_Release(&error->IRestrictedErrorInfo_iface);
+    return TRUE;
+}
