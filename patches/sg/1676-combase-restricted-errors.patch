+struct restricted_error
+{
+    IRestrictedErrorInfo IRestrictedErrorInfo_iface;
+    IErrorInfo IErrorInfo_iface;
+    ILanguageExceptionErrorInfo2 ILanguageExceptionErrorInfo2_iface;
+    IAgileObject IAgileObject_iface;
