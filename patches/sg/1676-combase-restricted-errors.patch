+/* Restricted error information (documented in roerrorapi.h and
+ * restrictederrorinfo.h): the error object RoOriginateError and its kin
+ * make and keep for the thread, where GetRestrictedErrorInfo takes it. It
+ * shares the thread's slot with SetErrorInfo, as an IErrorInfo too. */
+
+DEFINE_GUID(IID_ILanguageExceptionErrorInfo, 0x04a2dbf3, 0xdf83, 0x116c, 0x09, 0x46, 0x08, 0x12, 0xab, 0xf6, 0xe0, 0x7d);
+DEFINE_GUID(IID_ILanguageExceptionErrorInfo2, 0x5746e5c4, 0x5b97, 0x424c, 0xb6, 0x20, 0x28, 0x22, 0x91, 0x57, 0x34, 0xdd);
+
+typedef struct ILanguageExceptionErrorInfo2 ILanguageExceptionErrorInfo2;
+typedef struct
+{
+    HRESULT (WINAPI *QueryInterface)(ILanguageExceptionErrorInfo2 *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(ILanguageExceptionErrorInfo2 *);
+    ULONG (WINAPI *Release)(ILanguageExceptionErrorInfo2 *);
+    HRESULT (WINAPI *GetLanguageException)(ILanguageExceptionErrorInfo2 *, IUnknown **);
+    HRESULT (WINAPI *GetPreviousLanguageExceptionErrorInfo)(ILanguageExceptionErrorInfo2 *, ILanguageExceptionErrorInfo2 **);
+    HRESULT (WINAPI *CapturePropagationContext)(ILanguageExceptionErrorInfo2 *, IUnknown *);
+    HRESULT (WINAPI *GetPropagationContextHead)(ILanguageExceptionErrorInfo2 *, ILanguageExceptionErrorInfo2 **);
+} ILanguageExceptionErrorInfo2Vtbl;
+struct ILanguageExceptionErrorInfo2 { const ILanguageExceptionErrorInfo2Vtbl *lpVtbl; };
+
+#define RO_MAX_MESSAGE 512
+void WINAPI RaiseFailFastException(EXCEPTION_RECORD *, CONTEXT *, DWORD);
+#define EXCEPTION_RO_ORIGINATEERROR 0x40080201
