+static UINT32 error_reporting_flags = RO_ERROR_REPORTING_USESETERRORINFO;
+
+/* the thread's error information, as GetErrorInfo and SetErrorInfo keep it
+ * (called here directly: their declarations import them from oleaut32) */
+static HRESULT take_thread_errorinfo(IErrorInfo **out)
+{
+    struct tlsdata *tlsdata;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = com_get_tlsdata(&tlsdata))) return hr;
+    if (!(*out = tlsdata->errorinfo)) return S_FALSE;
+    tlsdata->errorinfo = NULL;
+    return S_OK;
+}
+
+static HRESULT set_thread_errorinfo(IErrorInfo *info)
+{
+    struct tlsdata *tlsdata;
+    HRESULT hr;
+
+    if (FAILED(hr = com_get_tlsdata(&tlsdata))) return hr;
+    if (info) IErrorInfo_AddRef(info);
+    if (tlsdata->errorinfo) IErrorInfo_Release(tlsdata->errorinfo);
+    tlsdata->errorinfo = info;
+    return S_OK;
+}
+
+/* the last errors made, for RoResolveRestrictedErrorInfoReference */
+static struct restricted_error *recent_errors[32];
+static unsigned int recent_next;
+static LONG error_serial;
+
+static inline struct restricted_error *impl_from_IRestrictedErrorInfo(IRestrictedErrorInfo *iface)
+{
+    return CONTAINING_RECORD(iface, struct restricted_error, IRestrictedErrorInfo_iface);
+}
+
+static HRESULT WINAPI restricted_error_QueryInterface(IRestrictedErrorInfo *iface, REFIID riid, void **out)
+{
+    struct restricted_error *error = impl_from_IRestrictedErrorInfo(iface);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IRestrictedErrorInfo))
+        *out = &error->IRestrictedErrorInfo_iface;
+    else if (IsEqualIID(riid, &IID_IErrorInfo))
+        *out = &error->IErrorInfo_iface;
+    else if (IsEqualIID(riid, &IID_ILanguageExceptionErrorInfo) || IsEqualIID(riid, &IID_ILanguageExceptionErrorInfo2))
+        *out = &error->ILanguageExceptionErrorInfo2_iface;
+    else if (IsEqualIID(riid, &IID_IAgileObject))
+        *out = &error->IAgileObject_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IRestrictedErrorInfo_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI restricted_error_AddRef(IRestrictedErrorInfo *iface)
+{
+    return InterlockedIncrement(&impl_from_IRestrictedErrorInfo(iface)->ref);
+}
+
+static ULONG WINAPI restricted_error_Release(IRestrictedErrorInfo *iface)
+{
+    struct restricted_error *error = impl_from_IRestrictedErrorInfo(iface);
+    ULONG ref = InterlockedDecrement(&error->ref);
+
+    if (!ref)
