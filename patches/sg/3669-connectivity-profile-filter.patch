+static UINT32 find_count( INetworkInformationStatics2 *statics2, IConnectionProfileFilter *filter )
+{
+    IAsyncOperation_IVectorView_ConnectionProfile *op;
+    IVectorView_ConnectionProfile *view;
+    UINT32 size = 0;
+    HRESULT hr;
+
+    hr = INetworkInformationStatics2_FindConnectionProfilesAsync( statics2, filter, &op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return 0;
+    hr = IAsyncOperation_IVectorView_ConnectionProfile_GetResults( op, &view );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IAsyncOperation_IVectorView_ConnectionProfile_Release( op );
+    hr = IVectorView_ConnectionProfile_get_Size( view, &size );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IVectorView_ConnectionProfile_Release( view );
+    return size;
+}
+
+static void test_find_profiles(void)
+{
+    static const WCHAR *info_name = L"Windows.Networking.Connectivity.NetworkInformation";
+    static const WCHAR *filter_name = L"Windows.Networking.Connectivity.ConnectionProfileFilter";
+    INetworkInformationStatics2 *statics2;
+    INetworkInformationStatics *statics;
+    IConnectionProfileFilter *filter;
+    IVectorView_ConnectionProfile *profiles;
+    IActivationFactory *factory;
+    IInspectable *inspectable;
+    NetworkCostType cost;
+    UINT32 all, connected, unconnected, size;
+    boolean value;
+    HSTRING str;
+    HRESULT hr;
+    ULONG count;
+    IID *iids;
+
+    WindowsCreateString( info_name, wcslen( info_name ), &str );
+    hr = RoGetActivationFactory( str, &IID_IActivationFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    if (hr != S_OK) return;
+    hr = IActivationFactory_QueryInterface( factory, &IID_INetworkInformationStatics2, (void **)&statics2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IActivationFactory_QueryInterface( factory, &IID_INetworkInformationStatics, (void **)&statics );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = INetworkInformationStatics2_GetIids( statics2, &count, &iids );
+    ok( hr == S_OK && count == 2, "got hr %#lx, count %lu.\n", hr, count );
+    CoTaskMemFree( iids );
+
+    WindowsCreateString( filter_name, wcslen( filter_name ), &str );
+    hr = RoActivateInstance( str, &inspectable );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IInspectable_QueryInterface( inspectable, &IID_IConnectionProfileFilter, (void **)&filter );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IInspectable_Release( inspectable );
+
+    /* properties round-trip */
+    hr = IConnectionProfileFilter_put_IsWlanConnectionProfile( filter, TRUE );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    value = FALSE;
+    hr = IConnectionProfileFilter_get_IsWlanConnectionProfile( filter, &value );
+    ok( hr == S_OK && value, "got hr %#lx, value %d.\n", hr, value );
+    hr = IConnectionProfileFilter_put_IsWlanConnectionProfile( filter, FALSE );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IConnectionProfileFilter_put_NetworkCostType( filter, NetworkCostType_Fixed );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IConnectionProfileFilter_get_NetworkCostType( filter, &cost );
+    ok( hr == S_OK && cost == NetworkCostType_Fixed, "got hr %#lx, cost %d.\n", hr, cost );
+    hr = IConnectionProfileFilter_get_NetworkCostType( filter, NULL );
+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+    IConnectionProfileFilter_Release( filter );
+
+    WindowsCreateString( filter_name, wcslen( filter_name ), &str );
+    RoActivateInstance( str, &inspectable );
+    WindowsDeleteString( str );
+    IInspectable_QueryInterface( inspectable, &IID_IConnectionProfileFilter, (void **)&filter );
+    IInspectable_Release( inspectable );
+
+    hr = INetworkInformationStatics2_FindConnectionProfilesAsync( statics2, NULL, (void *)&str );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = INetworkInformationStatics2_FindConnectionProfilesAsync( statics2, filter, NULL );
+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+
+    hr = INetworkInformationStatics_GetConnectionProfiles( statics, &profiles );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IVectorView_ConnectionProfile_get_Size( profiles, &size );
+    IVectorView_ConnectionProfile_Release( profiles );
+
+    all = find_count( statics2, filter );
+    ok( all == size, "got %u profiles for an empty filter, expected %u.\n", all, size );
+
+    IConnectionProfileFilter_put_IsConnected( filter, TRUE );
+    connected = find_count( statics2, filter );
+    IConnectionProfileFilter_put_IsConnected( filter, FALSE );
+    unconnected = find_count( statics2, filter );
+    ok( connected + unconnected == size, "got %u connected and %u unconnected of %u.\n", connected, unconnected, size );
+
+    IConnectionProfileFilter_put_IsConnected( filter, TRUE );
+    IConnectionProfileFilter_put_IsWwanConnectionProfile( filter, TRUE );
+    ok( !find_count( statics2, filter ), "found a mobile broadband profile.\n" );
+
+    IConnectionProfileFilter_Release( filter );
+    INetworkInformationStatics_Release( statics );
+    INetworkInformationStatics2_Release( statics2 );
+    IActivationFactory_Release( factory );
+}
+
 START_TEST(connectivity)
 {
     HRESULT hr;
@@ -796,6 +904,7 @@ START_TEST(connectivity)
     test_lists_and_events();
     test_proxy_configuration();
     test_sorted_endpoints();
+    test_find_profiles();
 
