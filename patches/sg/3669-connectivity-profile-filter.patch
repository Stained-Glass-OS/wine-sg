+/* ---- ConnectionProfileFilter and NetworkInformation.FindConnectionProfilesAsync ---- */
+
+#define FILTER_CONNECTED  0x01
+#define FILTER_WWAN       0x02
+#define FILTER_WLAN       0x04
+#define FILTER_COST       0x08
+
+struct profile_filter
+{
+    IConnectionProfileFilter IConnectionProfileFilter_iface;
+    LONG ref;
+
+    CRITICAL_SECTION cs;
+    DWORD set;                  /* the properties that were assigned: only those narrow the search */
+    boolean connected, wwan, wlan;
+    NetworkCostType cost;
+    IReference_GUID *provider;
+};
+
+static inline struct profile_filter *impl_from_IConnectionProfileFilter( IConnectionProfileFilter *iface )
+{
+    return CONTAINING_RECORD( iface, struct profile_filter, IConnectionProfileFilter_iface );
+}
+
+static HRESULT WINAPI filter_QueryInterface( IConnectionProfileFilter *iface, REFIID iid, void **out )
+{
+    struct profile_filter *impl = impl_from_IConnectionProfileFilter( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IConnectionProfileFilter ))
+    {
+        IConnectionProfileFilter_AddRef( (*out = &impl->IConnectionProfileFilter_iface) );
+        return S_OK;
+    }
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI filter_AddRef( IConnectionProfileFilter *iface )
+{
+    return InterlockedIncrement( &impl_from_IConnectionProfileFilter( iface )->ref );
+}
+
+static ULONG WINAPI filter_Release( IConnectionProfileFilter *iface )
+{
+    struct profile_filter *impl = impl_from_IConnectionProfileFilter( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->provider) IReference_GUID_Release( impl->provider );
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI filter_GetIids( IConnectionProfileFilter *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = IID_IConnectionProfileFilter;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI filter_GetRuntimeClassName( IConnectionProfileFilter *iface, HSTRING *name )
+{
+    if (!name) return E_POINTER;
+    return WindowsCreateString( RuntimeClass_Windows_Networking_Connectivity_ConnectionProfileFilter,
+                                wcslen( RuntimeClass_Windows_Networking_Connectivity_ConnectionProfileFilter ), name );
+}
+
+static HRESULT WINAPI filter_GetTrustLevel( IConnectionProfileFilter *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+#define FILTER_BOOL_PROPERTY( name, member, flag )                                                       \
+    static HRESULT WINAPI filter_put_##name( IConnectionProfileFilter *iface, boolean value )            \
+    {                                                                                                    \
+        struct profile_filter *impl = impl_from_IConnectionProfileFilter( iface );                       \
+        TRACE( "iface %p, value %d.\n", iface, value );                                                  \
+        EnterCriticalSection( &impl->cs );                                                               \
+        impl->member = !!value;                                                                          \
+        impl->set |= flag;                                                                               \
+        LeaveCriticalSection( &impl->cs );                                                               \
+        return S_OK;                                                                                     \
+    }                                                                                                    \
+    static HRESULT WINAPI filter_get_##name( IConnectionProfileFilter *iface, boolean *value )           \
+    {                                                                                                    \
+        struct profile_filter *impl = impl_from_IConnectionProfileFilter( iface );                       \
+        TRACE( "iface %p, value %p.\n", iface, value );                                                  \
+        if (!value) return E_POINTER;                                                                    \
+        *value = impl->member;                                                                           \
+        return S_OK;                                                                                     \
+    }
+
+FILTER_BOOL_PROPERTY( IsConnected, connected, FILTER_CONNECTED )
+FILTER_BOOL_PROPERTY( IsWwanConnectionProfile, wwan, FILTER_WWAN )
+FILTER_BOOL_PROPERTY( IsWlanConnectionProfile, wlan, FILTER_WLAN )
+
+static HRESULT WINAPI filter_put_NetworkCostType( IConnectionProfileFilter *iface, NetworkCostType value )
+{
+    struct profile_filter *impl = impl_from_IConnectionProfileFilter( iface );
+
+    TRACE( "iface %p, value %d.\n", iface, value );
+    EnterCriticalSection( &impl->cs );
+    impl->cost = value;
+    impl->set |= FILTER_COST;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI filter_get_NetworkCostType( IConnectionProfileFilter *iface, NetworkCostType *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl_from_IConnectionProfileFilter( iface )->cost;
+    return S_OK;
+}
+
+static HRESULT WINAPI filter_put_ServiceProviderGuid( IConnectionProfileFilter *iface, IReference_GUID *value )
+{
+    struct profile_filter *impl = impl_from_IConnectionProfileFilter( iface );
+    IReference_GUID *old;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (value) IReference_GUID_AddRef( value );
+    EnterCriticalSection( &impl->cs );
+    old = impl->provider;
+    impl->provider = value;
+    LeaveCriticalSection( &impl->cs );
+    if (old) IReference_GUID_Release( old );
+    return S_OK;
+}
+
+static HRESULT WINAPI filter_get_ServiceProviderGuid( IConnectionProfileFilter *iface, IReference_GUID **value )
+{
+    struct profile_filter *impl = impl_from_IConnectionProfileFilter( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    if ((*value = impl->provider)) IReference_GUID_AddRef( *value );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static const IConnectionProfileFilterVtbl filter_vtbl =
+{
+    filter_QueryInterface, filter_AddRef, filter_Release, filter_GetIids, filter_GetRuntimeClassName,
+    filter_GetTrustLevel, filter_put_IsConnected, filter_get_IsConnected,
+    filter_put_IsWwanConnectionProfile, filter_get_IsWwanConnectionProfile,
+    filter_put_IsWlanConnectionProfile, filter_get_IsWlanConnectionProfile,
+    filter_put_NetworkCostType, filter_get_NetworkCostType,
+    filter_put_ServiceProviderGuid, filter_get_ServiceProviderGuid,
+};
+
+/* the activation factory: the class is created by its default constructor */
+
+static HRESULT WINAPI ffactory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ffactory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI ffactory_Release( IActivationFactory *iface ) { return 1; }
+
+static HRESULT WINAPI ffactory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *iids = NULL;
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI ffactory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return filter_GetRuntimeClassName( NULL, name );
+}
+
+static HRESULT WINAPI ffactory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    return filter_GetTrustLevel( NULL, level );
+}
+
+static HRESULT WINAPI ffactory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    struct profile_filter *impl;
+
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+
+    if (!instance) return E_POINTER;
+    *instance = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IConnectionProfileFilter_iface.lpVtbl = &filter_vtbl;
+    impl->ref = 1;
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": profile_filter.cs");
+    *instance = (IInspectable *)&impl->IConnectionProfileFilter_iface;
+    return S_OK;
+}
+
+static const IActivationFactoryVtbl ffactory_vtbl =
+{
+    ffactory_QueryInterface, ffactory_AddRef, ffactory_Release, ffactory_GetIids, ffactory_GetRuntimeClassName,
+    ffactory_GetTrustLevel, ffactory_ActivateInstance,
+};
+
+static IActivationFactory filter_factory_object = { &ffactory_vtbl };
+IActivationFactory *profile_filter_factory = &filter_factory_object;
+
+static BOOL profile_matches( IConnectionProfile *profile, struct profile_filter *filter )
+{
+    INetworkAdapter *adapter = NULL;
+    NetworkConnectivityLevel level = NetworkConnectivityLevel_None;
+    UINT32 type = 0;
+    BOOL ok = TRUE;
+
+    if (filter->set & FILTER_CONNECTED)
+    {
+        IConnectionProfile_GetNetworkConnectivityLevel( profile, &level );
+        if ((level != NetworkConnectivityLevel_None) != !!filter->connected) ok = FALSE;
+    }
+    if (ok && (filter->set & (FILTER_WWAN | FILTER_WLAN)))
+    {
+        if (SUCCEEDED(IConnectionProfile_get_NetworkAdapter( profile, &adapter )) && adapter)
+        {
+            INetworkAdapter_get_IanaInterfaceType( adapter, &type );
+            INetworkAdapter_Release( adapter );
+        }
+        /* IANA: 71 ieee80211, 243 and 244 the 3GPP mobile broadband types */
+        if ((filter->set & FILTER_WLAN) && (type == 71) != !!filter->wlan) ok = FALSE;
+        if ((filter->set & FILTER_WWAN) && (type == 243 || type == 244) != !!filter->wwan) ok = FALSE;
+    }
+    if (ok && (filter->set & FILTER_COST))
+    {
+        IConnectionCost *cost = NULL;
+        NetworkCostType cost_type = NetworkCostType_Unknown;
+
+        if (SUCCEEDED(IConnectionProfile_GetConnectionCost( profile, &cost )) && cost)
+        {
+            IConnectionCost_get_NetworkCostType( cost, &cost_type );
+            IConnectionCost_Release( cost );
+        }
+        if (cost_type != filter->cost) ok = FALSE;
+    }
+    /* profiles carry no service provider guid, so a filter naming one finds none */
+    if (ok && filter->provider) ok = FALSE;
+    return ok;
+}
+
+HRESULT find_profiles_async( IConnectionProfileFilter *filter_iface, IAsyncOperation_IVectorView_ConnectionProfile **value )
+{
+    struct profile_filter *filter;
+    INetworkInformationStatics *statics;
+    IVectorView_ConnectionProfile *all;
+    IConnectionProfile **matches = NULL;
+    IVectorView_ConnectionProfile *result = NULL;
+    UINT32 size, i, count = 0;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!filter_iface) return E_INVALIDARG;
+    filter = impl_from_IConnectionProfileFilter( filter_iface );
+
+    if (FAILED(hr = IActivationFactory_QueryInterface( network_information_factory, &IID_INetworkInformationStatics,
+                                                       (void **)&statics ))) return hr;
+    hr = INetworkInformationStatics_GetConnectionProfiles( statics, &all );
+    INetworkInformationStatics_Release( statics );
+    if (FAILED(hr)) return hr;
+
+    if (FAILED(hr = IVectorView_ConnectionProfile_get_Size( all, &size ))) goto done;
+    if (!(matches = calloc( size + 1, sizeof(*matches) ))) { hr = E_OUTOFMEMORY; goto done; }
+    EnterCriticalSection( &filter->cs );
+    for (i = 0; i < size; i++)
+    {
+        IConnectionProfile *profile;
+
+        if (FAILED(IVectorView_ConnectionProfile_GetAt( all, i, &profile ))) continue;
+#ifdef SG_MUTANT_FIND_ALL
+        matches[count++] = profile;
+#else
+        if (profile_matches( profile, filter )) matches[count++] = profile;
+        else IConnectionProfile_Release( profile );
+#endif
+    }
+    LeaveCriticalSection( &filter->cs );
+
+    hr = vector_view_create( VECTOR_CONNECTION_PROFILE, (void **)matches, count, (void **)&result );
+    if (SUCCEEDED(hr))
+    {
+        hr = completed_op_create( &IID_IAsyncOperation_IVectorView_ConnectionProfile, &IID_IVectorView_ConnectionProfile,
+                                  L"Windows.Foundation.IAsyncOperation`1<Windows.Foundation.Collections.IVectorView`1<Windows.Networking.Connectivity.ConnectionProfile>>",
+                                  (IUnknown *)result, (void **)value );
+        IVectorView_ConnectionProfile_Release( result );
+    }
+done:
+    free( matches );
+    IVectorView_ConnectionProfile_Release( all );
+    return hr;
+}
