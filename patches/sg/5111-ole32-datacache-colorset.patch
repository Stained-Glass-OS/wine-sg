diff --git a/dlls/ole32/datacache.c b/dlls/ole32/datacache.c
--- a/dlls/ole32/datacache.c
+++ b/dlls/ole32/datacache.c
@@ -2163,6 +2163,84 @@
   return OLE_E_BLANK;
 }
 
+/* a LOGPALETTE made from the palette entries given as RGBQUADs (a DIB's colour table) */
+static LOGPALETTE *palette_from_quads(const RGBQUAD *quads, UINT count)
+{
+    LOGPALETTE *pal;
+    UINT i;
+
+    if (!(pal = CoTaskMemAlloc(offsetof(LOGPALETTE, palPalEntry[count])))) return NULL;
+    pal->palVersion = 0x300;
+    pal->palNumEntries = count;
+    for (i = 0; i < count; i++)
+    {
+        pal->palPalEntry[i].peRed = quads[i].rgbRed;
+        pal->palPalEntry[i].peGreen = quads[i].rgbGreen;
+        pal->palPalEntry[i].peBlue = quads[i].rgbBlue;
+        pal->palPalEntry[i].peFlags = 0;
+    }
+    return pal;
+}
+
+/* the first palette a metafile creates: META_CREATEPALETTE (0x00f7, a LOGPALETTE) in a Windows metafile,
+ * EMR_CREATEPALETTE (49, an index and a LOGPALETTE) in an enhanced one; NULL if there is none */
+static LOGPALETTE *palette_from_metafile(const BYTE *data, UINT size, BOOL enhanced)
+{
+    UINT pos = 0;
+
+    if (!enhanced)
+    {
+        if (size < 18) return NULL;
+        pos = 18;  /* the METAHEADER */
+        while (pos + 6 <= size)
+        {
+            DWORD words = *(const DWORD *)(data + pos);
+            WORD function = *(const WORD *)(data + pos + 4);
+
+            if (words < 3 || (UINT64)words * 2 > size - pos) break;
+            if (function == 0x00f7 && words * 2 >= 6 + 4)
+            {
+                const WORD *pal = (const WORD *)(data + pos + 6);
+                UINT count = pal[1];
+                if (words * 2 >= 6 + 4 + count * sizeof(PALETTEENTRY))
+                {
+                    LOGPALETTE *ret = CoTaskMemAlloc(offsetof(LOGPALETTE, palPalEntry[count]));
+                    if (ret) memcpy(ret, pal, offsetof(LOGPALETTE, palPalEntry[count]));
+                    return ret;
+                }
+            }
+            if (function == 0) break;
+            pos += words * 2;
+        }
+    }
+    else
+    {
+        while (pos + 8 <= size)
+        {
+            DWORD type = *(const DWORD *)(data + pos), len = *(const DWORD *)(data + pos + 4);
+
+            if (len < 8 || len > size - pos) break;
+            if (type == 49 && len >= 12 + 4)
+            {
+                const WORD *pal = (const WORD *)(data + pos + 12);
+                UINT count = pal[1];
+                if (len >= 12 + 4 + count * sizeof(PALETTEENTRY))
+                {
+                    LOGPALETTE *ret = CoTaskMemAlloc(offsetof(LOGPALETTE, palPalEntry[count]));
+                    if (ret) memcpy(ret, pal, offsetof(LOGPALETTE, palPalEntry[count]));
+                    return ret;
+                }
+            }
+            if (type == 14) break;  /* EMR_EOF */
+            pos += len;
+        }
+    }
+    return NULL;
+}
+
+/* IViewObject::GetColorSet: the palette Draw would use.  "If CF_DIB is the drawing format, the palette found
+ * in the bitmap is used. For a regular bitmap, no color information is returned. If the drawing format is a
+ * metafile, the object handler enumerates the metafile looking for a CreatePalette metafile record." */
 static HRESULT WINAPI DataCache_GetColorSet(
             IViewObject2*   iface,
 	    DWORD           dwDrawAspect,
@@ -2172,8 +2250,107 @@
 	    HDC             hicTargetDevice,
 	    LOGPALETTE**    ppColorSet)
 {
-  FIXME("stub\n");
-  return E_NOTIMPL;
+  DataCache *This = impl_from_IViewObject2(iface);
+  DataCacheEntry *cache_entry;
+  BOOL found = FALSE;
+
+  TRACE("%p, %lx, %ld, %p, %p, %p, %p\n", iface, dwDrawAspect, lindex, pvAspect, ptd, hicTargetDevice, ppColorSet);
+
+  if (!ppColorSet) return E_INVALIDARG;
+  *ppColorSet = NULL;
+  if (lindex != -1) return DV_E_LINDEX;
+  if (dwDrawAspect != DVASPECT_CONTENT && dwDrawAspect != DVASPECT_THUMBNAIL &&
+      dwDrawAspect != DVASPECT_ICON && dwDrawAspect != DVASPECT_DOCPRINT)
+    return DV_E_DVASPECT;
+
+  LIST_FOR_EACH_ENTRY(cache_entry, &This->cache_list, DataCacheEntry, entry)
+  {
+    LOGPALETTE *pal = NULL;
+
+    if (cache_entry->fmtetc.dwAspect != dwDrawAspect || cache_entry->fmtetc.lindex != lindex)
+      continue;
+
+    /* if the data hasn't been loaded yet, do it now */
+    if (cache_entry->stgmedium.tymed == TYMED_NULL && cache_entry->load_stream_num != STREAM_NUMBER_NOT_SET)
+    {
+      if (FAILED(DataCacheEntry_LoadData(cache_entry, This->presentationStorage))) continue;
+    }
+    if (cache_entry->stgmedium.tymed == TYMED_NULL) continue;
+
+    found = TRUE;
+    switch (cache_entry->fmtetc.cfFormat)
+    {
+      case CF_DIB:
+      {
+        BITMAPINFO *info;
+
+        if (cache_entry->stgmedium.tymed != TYMED_HGLOBAL ||
+            !(info = GlobalLock(cache_entry->stgmedium.hGlobal)))
+          continue;
+        if (info->bmiHeader.biBitCount && info->bmiHeader.biBitCount <= 8)
+        {
+          UINT count = info->bmiHeader.biClrUsed ? info->bmiHeader.biClrUsed : 1u << info->bmiHeader.biBitCount;
+          const RGBQUAD *quads = (const RGBQUAD *)((const BYTE *)info + info->bmiHeader.biSize);
+
+          if (count > 256) count = 256;
+#ifndef SG_MUTANT_COLORSET_DIB
+          pal = palette_from_quads(quads, count);
+#endif
+          if (!pal && count) { GlobalUnlock(cache_entry->stgmedium.hGlobal); return E_OUTOFMEMORY; }
+        }
+        GlobalUnlock(cache_entry->stgmedium.hGlobal);
+        break;
+      }
+      case CF_METAFILEPICT:
+      {
+        METAFILEPICT *mfpict;
+        UINT size;
+        BYTE *bits;
+
+        if (cache_entry->stgmedium.tymed != TYMED_MFPICT ||
+            !(mfpict = GlobalLock(cache_entry->stgmedium.hMetaFilePict)))
+          continue;
+        if (mfpict->hMF && (size = GetMetaFileBitsEx(mfpict->hMF, 0, NULL)) &&
+            (bits = HeapAlloc(GetProcessHeap(), 0, size)))
+        {
+#ifndef SG_MUTANT_COLORSET_MF
+          if (GetMetaFileBitsEx(mfpict->hMF, size, bits) == size)
+            pal = palette_from_metafile(bits, size, FALSE);
+#endif
+          HeapFree(GetProcessHeap(), 0, bits);
+        }
+        GlobalUnlock(cache_entry->stgmedium.hMetaFilePict);
+        break;
+      }
+      case CF_ENHMETAFILE:
+      {
+        UINT size;
+        BYTE *bits;
+
+        if (cache_entry->stgmedium.tymed != TYMED_ENHMF || !cache_entry->stgmedium.hEnhMetaFile) continue;
+        if ((size = GetEnhMetaFileBits(cache_entry->stgmedium.hEnhMetaFile, 0, NULL)) &&
+            (bits = HeapAlloc(GetProcessHeap(), 0, size)))
+        {
+          if (GetEnhMetaFileBits(cache_entry->stgmedium.hEnhMetaFile, size, bits) == size)
+            pal = palette_from_metafile(bits, size, TRUE);
+          HeapFree(GetProcessHeap(), 0, bits);
+        }
+        break;
+      }
+      default:  /* a bitmap, or a format without colours of its own */
+        break;
+    }
+
+    if (pal && pal->palNumEntries)
+    {
+      *ppColorSet = pal;
+      return S_OK;
+    }
+    CoTaskMemFree(pal);
+    return S_FALSE;
+  }
+
+  return found ? S_FALSE : OLE_E_BLANK;
 }
 
 static HRESULT WINAPI DataCache_Freeze(
