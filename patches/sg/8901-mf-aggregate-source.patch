+static const IMFAsyncCallbackVtbl agg_input_events_vtbl =
+{
+    agg_callback_QueryInterface,
+    agg_input_events_AddRef,
+    agg_input_events_Release,
+    agg_callback_GetParameters,
+    agg_input_events_Invoke,
+};
