+/***********************************************************************
+ *      MFCreateAggregateSource (mf.@)
+ */
+HRESULT WINAPI MFCreateAggregateSource(IMFCollection *collection, IMFMediaSource **out)
+{
+    IMFPresentationDescriptor *inner_pd;
+    struct agg_source *source;
+    IMFStreamDescriptor *sd;
+    BOOL selected, unique = TRUE;
+    DWORD i, j, k, count, id;
+    IUnknown *unk;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", collection, out);
+
+    if (!collection || !out) return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = IMFCollection_GetElementCount(collection, &count))) return hr;
+    if (!count) return E_INVALIDARG;
+
+    if (!(source = calloc(1, sizeof(*source)))) return E_OUTOFMEMORY;
+    source->IMFMediaSource_iface.lpVtbl = &agg_source_vtbl;
+    source->refcount = 1;
+    InitializeCriticalSection(&source->cs);
+    if (!(source->inputs = calloc(count, sizeof(*source->inputs))))
+    {
+        IMFMediaSource_Release(&source->IMFMediaSource_iface);
+        return E_OUTOFMEMORY;
+    }
+    if (FAILED(hr = MFCreateEventQueue(&source->queue))) goto failed;
+
+    for (i = 0; i < count; i++)
+    {
+        struct agg_input *input = &source->inputs[i];
+
+        if (FAILED(hr = IMFCollection_GetElement(collection, i, &unk))) goto failed;
+        hr = unk ? IUnknown_QueryInterface(unk, &IID_IMFMediaSource, (void **)&input->media_source) : E_INVALIDARG;
+        if (unk) IUnknown_Release(unk);
+        if (FAILED(hr)) goto failed;
+        input->events_callback.lpVtbl = &agg_input_events_vtbl;
+        input->source = source;
+        source->input_count++;
+
+        if (FAILED(hr = IMFMediaSource_CreatePresentationDescriptor(input->media_source, &inner_pd))) goto failed;
+        if (SUCCEEDED(hr = IMFPresentationDescriptor_GetStreamDescriptorCount(inner_pd, &input->stream_count)))
+        {
+            struct agg_entry *entries = realloc(source->entries,
+                    (source->entry_count + input->stream_count) * sizeof(*entries));
+            if (!entries) hr = E_OUTOFMEMORY;
+            else
+            {
+                source->entries = entries;
+                input->first = source->entry_count;
+                for (j = 0; SUCCEEDED(hr) && j < input->stream_count; j++)
+                {
+                    struct agg_entry *entry = &source->entries[source->entry_count];
+
+                    memset(entry, 0, sizeof(*entry));
+                    if (FAILED(hr = IMFPresentationDescriptor_GetStreamDescriptorByIndex(inner_pd, j, &selected, &sd)))
+                        break;
+                    IMFStreamDescriptor_GetStreamIdentifier(sd, &entry->inner_id);
+                    if (!(entry->descriptor = calloc(1, sizeof(*entry->descriptor))))
+                    {
+                        IMFStreamDescriptor_Release(sd);
+                        hr = E_OUTOFMEMORY;
+                        break;
+                    }
+                    entry->descriptor->IMFStreamDescriptor_iface.lpVtbl = &agg_sd_vtbl;
+                    entry->descriptor->refcount = 1;
+                    entry->descriptor->inner = sd;
+                    entry->input = input;
+                    source->entry_count++;
+                }
+            }
+        }
+        IMFPresentationDescriptor_Release(inner_pd);
+        if (FAILED(hr)) goto failed;
+    }
+
+    /* identifiers stay the streams' own unless two sources use the same one */
+    for (i = 0; i < source->entry_count && unique; i++)
+        for (k = i + 1; k < source->entry_count; k++)
+            if (source->entries[i].inner_id == source->entries[k].inner_id) unique = FALSE;
+    for (i = 0; i < source->entry_count; i++)
+    {
+        id = unique ? source->entries[i].inner_id : i;
+#ifdef SG_MUTANT_AGG_SAME_IDS
+        id = source->entries[i].inner_id;
+#endif
+        source->entries[i].descriptor->id = id;
+    }
+
+    for (i = 0; i < source->input_count; i++)
+        IMFMediaSource_BeginGetEvent(source->inputs[i].media_source, &source->inputs[i].events_callback, NULL);
+
+    *out = &source->IMFMediaSource_iface;
+    return S_OK;
+
+failed:
+    IMFMediaSource_Release(&source->IMFMediaSource_iface);
+    return hr;
+}
