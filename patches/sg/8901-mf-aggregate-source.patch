+static HRESULT WINAPI agg_source_QueryInterface(IMFMediaSource *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IMFMediaSource) || IsEqualIID(riid, &IID_IMFMediaEventGenerator) ||
+            IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        IMFMediaSource_AddRef(iface);
+        return S_OK;
+    }
+    WARN("Unsupported %s.\n", debugstr_guid(riid));
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI agg_source_AddRef(IMFMediaSource *iface)
+{
+    return InterlockedIncrement(&impl_from_IMFMediaSource(iface)->refcount);
+}
+
+static void release_entries(struct agg_source *source)
+{
+    DWORD i;
+
+    for (i = 0; i < source->entry_count; i++)
+    {
+        if (source->entries[i].descriptor)
+            IMFStreamDescriptor_Release(&source->entries[i].descriptor->IMFStreamDescriptor_iface);
+        if (source->entries[i].stream)
+            IMFMediaStream_Release(&source->entries[i].stream->IMFMediaStream_iface);
+    }
+    free(source->entries);
+    source->entries = NULL;
+    source->entry_count = 0;
+}
+
+static ULONG WINAPI agg_source_Release(IMFMediaSource *iface)
+{
+    struct agg_source *source = impl_from_IMFMediaSource(iface);
+    ULONG refcount = InterlockedDecrement(&source->refcount);
+    DWORD i;
+
+    if (!refcount)
+    {
+        release_entries(source);
+        for (i = 0; i < source->input_count; i++)
+            if (source->inputs[i].media_source) IMFMediaSource_Release(source->inputs[i].media_source);
+        free(source->inputs);
+        if (source->queue) IMFMediaEventQueue_Release(source->queue);
+        PropVariantClear(&source->pending_value);
+        DeleteCriticalSection(&source->cs);
+        free(source);
+    }
+    return refcount;
+}
