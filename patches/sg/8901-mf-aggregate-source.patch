+}
+
+static HRESULT WINAPI agg_source_QueueEvent(IMFMediaSource *iface, MediaEventType type, REFGUID ext_type,
+        HRESULT hr, const PROPVARIANT *value)
+{
+    return IMFMediaEventQueue_QueueEventParamVar(impl_from_IMFMediaSource(iface)->queue, type, ext_type, hr, value);
+}
+
+/* live if any source is; seeks, pauses only if every source can */
+static HRESULT WINAPI agg_source_GetCharacteristics(IMFMediaSource *iface, DWORD *characteristics)
+{
+    static const DWORD all_must = MFMEDIASOURCE_CAN_SEEK | MFMEDIASOURCE_CAN_PAUSE | MFMEDIASOURCE_CAN_SKIPFORWARD |
+            MFMEDIASOURCE_CAN_SKIPBACKWARD | MFMEDIASOURCE_HAS_SLOW_SEEK;
+    struct agg_source *source = impl_from_IMFMediaSource(iface);
+    DWORD i, flags, any = 0, all = all_must;
+    HRESULT hr = S_OK;
+
+    if (!characteristics) return E_POINTER;
+    if (source->shutdown) return MF_E_SHUTDOWN;
+    for (i = 0; i < source->input_count; i++)
+    {
+        if (FAILED(hr = IMFMediaSource_GetCharacteristics(source->inputs[i].media_source, &flags))) break;
+        any |= flags;
+        all &= flags;
+    }
+    /* slow seeking if any source seeks slowly */
+    if (SUCCEEDED(hr)) *characteristics = (any & ~all_must) | (all & ~MFMEDIASOURCE_HAS_SLOW_SEEK) |
+            (any & MFMEDIASOURCE_HAS_SLOW_SEEK);
+    return hr;
+}
+
+static HRESULT WINAPI agg_source_CreatePresentationDescriptor(IMFMediaSource *iface, IMFPresentationDescriptor **pd)
+{
+    struct agg_source *source = impl_from_IMFMediaSource(iface);
+    IMFStreamDescriptor **sds;
+    IMFPresentationDescriptor *inner_pd;
+    UINT64 duration, max_duration = 0;
+    BOOL selected, have_duration = FALSE;
+    IMFStreamDescriptor *sd;
+    HRESULT hr = S_OK;
+    DWORD i, j;
+
+    TRACE("%p, %p.\n", iface, pd);
+
+    if (!pd) return E_POINTER;
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+    {
+        LeaveCriticalSection(&source->cs);
+        return MF_E_SHUTDOWN;
+    }
+    if (!(sds = calloc(source->entry_count, sizeof(*sds))))
+    {
+        LeaveCriticalSection(&source->cs);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < source->entry_count; i++)
+        sds[i] = &source->entries[i].descriptor->IMFStreamDescriptor_iface;
+    hr = MFCreatePresentationDescriptor(source->entry_count, sds, pd);
+    free(sds);
+
+    /* each source's own default selection, and the longest duration */
+    for (i = 0; SUCCEEDED(hr) && i < source->input_count; i++)
+    {
+        struct agg_input *input = &source->inputs[i];
+
+        if (FAILED(IMFMediaSource_CreatePresentationDescriptor(input->media_source, &inner_pd))) continue;
+        if (SUCCEEDED(IMFPresentationDescriptor_GetUINT64(inner_pd, &MF_PD_DURATION, &duration)))
+        {
+            have_duration = TRUE;
+            if (duration > max_duration) max_duration = duration;
+        }
+        for (j = 0; j < input->stream_count; j++)
+        {
+            if (FAILED(IMFPresentationDescriptor_GetStreamDescriptorByIndex(inner_pd, j, &selected, &sd))) continue;
+            if (selected) IMFPresentationDescriptor_SelectStream(*pd, input->first + j);
+            else IMFPresentationDescriptor_DeselectStream(*pd, input->first + j);
+            IMFStreamDescriptor_Release(sd);
+        }
+        IMFPresentationDescriptor_Release(inner_pd);
+    }
+    if (SUCCEEDED(hr) && have_duration) IMFPresentationDescriptor_SetUINT64(*pd, &MF_PD_DURATION, max_duration);
+    LeaveCriticalSection(&source->cs);
+    return hr;
+}
+
+/* whether @pd (the aggregate's presentation descriptor) selects the stream of @entry */
+static BOOL is_selected(IMFPresentationDescriptor *pd, struct agg_entry *entry)
+{
+    IMFStreamDescriptor *sd;
+    DWORD i, count, id;
+    BOOL selected;
+
+    if (FAILED(IMFPresentationDescriptor_GetStreamDescriptorCount(pd, &count))) return FALSE;
+    for (i = 0; i < count; i++)
+    {
+        if (FAILED(IMFPresentationDescriptor_GetStreamDescriptorByIndex(pd, i, &selected, &sd))) continue;
+        IMFStreamDescriptor_GetStreamIdentifier(sd, &id);
+        IMFStreamDescriptor_Release(sd);
+        if (id == entry->descriptor->id) return selected;
+    }
+    return FALSE;
+}
+
+static HRESULT WINAPI agg_source_Start(IMFMediaSource *iface, IMFPresentationDescriptor *pd, const GUID *time_format,
+        const PROPVARIANT *start_position)
+{
+    struct agg_source *source = impl_from_IMFMediaSource(iface);
+    IMFPresentationDescriptor *inner_pd;
+    IMFStreamDescriptor *sd;
+    BOOL selected, any;
+    HRESULT hr = S_OK;
+    DWORD i, j, count;
+
+    TRACE("%p, %p, %s, %p.\n", iface, pd, debugstr_guid(time_format), start_position);
+
+    if (!pd) return E_INVALIDARG;
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+    {
+        LeaveCriticalSection(&source->cs);
+        return MF_E_SHUTDOWN;
+    }
+    source->pending = PENDING_START;
+    source->pending_count = 0;
+    source->pending_hr = S_OK;
+    source->pending_event = MESourceStarted;
+    PropVariantClear(&source->pending_value);
+
+    for (i = 0; i < source->input_count; i++)
+    {
+        struct agg_input *input = &source->inputs[i];
+
+        input->started = FALSE;
+        input->ended = FALSE;
+        if (FAILED(hr = IMFMediaSource_CreatePresentationDescriptor(input->media_source, &inner_pd))) break;
+        any = FALSE;
+        if (SUCCEEDED(IMFPresentationDescriptor_GetStreamDescriptorCount(inner_pd, &count)))
+        {
+            for (j = 0; j < count; j++)
+            {
+                struct agg_entry *entry;
+                DWORD id;
+
+                if (FAILED(IMFPresentationDescriptor_GetStreamDescriptorByIndex(inner_pd, j, &selected, &sd))) continue;
+                IMFStreamDescriptor_GetStreamIdentifier(sd, &id);
+                IMFStreamDescriptor_Release(sd);
+                if ((entry = find_entry(source, input, id)) && is_selected(pd, entry))
+                {
+                    IMFPresentationDescriptor_SelectStream(inner_pd, j);
+                    any = TRUE;
+                }
+                else IMFPresentationDescriptor_DeselectStream(inner_pd, j);
+            }
+        }
+        if (any)
+        {
+            input->started = TRUE;
+            source->pending_count++;
+            if (FAILED(hr = IMFMediaSource_Start(input->media_source, inner_pd, time_format, start_position)))
+            {
+                source->pending_count--;
+                input->started = FALSE;
+            }
+        }
+        IMFPresentationDescriptor_Release(inner_pd);
+        if (FAILED(hr)) break;
+    }
+    if (SUCCEEDED(hr) && !source->pending_count)
+    {
+        /* nothing selected: started, with no streams */
+        source->pending = PENDING_NONE;
+        hr = IMFMediaEventQueue_QueueEventParamVar(source->queue, MESourceStarted, &GUID_NULL, S_OK, start_position);
+    }
+    LeaveCriticalSection(&source->cs);
+    return hr;
+}
+
+static HRESULT forward_state(struct agg_source *source, enum agg_pending pending, MediaEventType event)
+{
+    HRESULT hr = S_OK;
+    DWORD i;
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+    {
+        LeaveCriticalSection(&source->cs);
+        return MF_E_SHUTDOWN;
+    }
+    source->pending = pending;
+    source->pending_count = 0;
+    source->pending_hr = S_OK;
+    source->pending_event = event;
+    PropVariantClear(&source->pending_value);
+    for (i = 0; i < source->input_count; i++)
+    {
+        struct agg_input *input = &source->inputs[i];
+
+        if (!input->started) continue;
+        source->pending_count++;
+        if (pending == PENDING_PAUSE) hr = IMFMediaSource_Pause(input->media_source);
+        else hr = IMFMediaSource_Stop(input->media_source);
+        if (FAILED(hr))
+        {
+            source->pending_count--;
+            break;
+        }
+    }
+    if (SUCCEEDED(hr) && !source->pending_count)
+    {
+        source->pending = PENDING_NONE;
+        hr = IMFMediaEventQueue_QueueEventParamVar(source->queue, event, &GUID_NULL, S_OK, NULL);
+    }
+    LeaveCriticalSection(&source->cs);
+    return hr;
+}
+
+static HRESULT WINAPI agg_source_Stop(IMFMediaSource *iface)
+{
+    TRACE("%p.\n", iface);
+    return forward_state(impl_from_IMFMediaSource(iface), PENDING_STOP, MESourceStopped);
+}
+
+static HRESULT WINAPI agg_source_Pause(IMFMediaSource *iface)
+{
+    struct agg_source *source = impl_from_IMFMediaSource(iface);
+    DWORD characteristics;
+    HRESULT hr;
+
+    TRACE("%p.\n", iface);
+    if (FAILED(hr = agg_source_GetCharacteristics(iface, &characteristics))) return hr;
+    if (!(characteristics & MFMEDIASOURCE_CAN_PAUSE)) return MF_E_INVALID_STATE_TRANSITION;
+    return forward_state(source, PENDING_PAUSE, MESourcePaused);
+}
+
+static HRESULT WINAPI agg_source_Shutdown(IMFMediaSource *iface)
+{
+    struct agg_source *source = impl_from_IMFMediaSource(iface);
+    DWORD i;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&source->cs);
+    if (source->shutdown)
+    {
+        LeaveCriticalSection(&source->cs);
+        return MF_E_SHUTDOWN;
+    }
+    source->shutdown = TRUE;
+    for (i = 0; i < source->input_count; i++)
+        IMFMediaSource_Shutdown(source->inputs[i].media_source);
+    for (i = 0; i < source->entry_count; i++)
+        if (source->entries[i].stream) IMFMediaEventQueue_Shutdown(source->entries[i].stream->queue);
+    IMFMediaEventQueue_Shutdown(source->queue);
+    LeaveCriticalSection(&source->cs);
+    return S_OK;
+}
+
+static const IMFMediaSourceVtbl agg_source_vtbl =
+{
+    agg_source_QueryInterface,
+    agg_source_AddRef,
+    agg_source_Release,
+    agg_source_GetEvent,
+    agg_source_BeginGetEvent,
+    agg_source_EndGetEvent,
+    agg_source_QueueEvent,
+    agg_source_GetCharacteristics,
+    agg_source_CreatePresentationDescriptor,
+    agg_source_Start,
+    agg_source_Stop,
+    agg_source_Pause,
+    agg_source_Shutdown,
+};
