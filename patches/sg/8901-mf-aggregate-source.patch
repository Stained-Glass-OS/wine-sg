From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mf: MFCreateAggregateSource joins several media sources into one

Qt Multimedia joins a camera and a microphone source with MFCreateAggregateSource for capture sessions with audio (imported by Anki, Kdenlive, MKVToolNix, MusicBrainz Picard, Wireshark, calibre); Wine had a stub. The aggregate lists every stream of every source; each stream gets a descriptor that forwards to the real one (attributes and media type handler) and keeps its identifier unless two sources share it, then streams are numbered in order. Start/Pause/Stop go to the sources with selected streams and their answers become one event; MEEndOfPresentation once all started sources ended.
---
--- a/include/mfidl.idl
+++ b/include/mfidl.idl
@@ -710,6 +710,7 @@
 cpp_quote("HRESULT WINAPI MFCreateMPEG4MediaSink(IMFByteStream *stream, IMFMediaType *video_type,")
 cpp_quote("    IMFMediaType *audio_type, IMFMediaSink **sink);")
 cpp_quote("HRESULT WINAPI MFCreatePresentationClock(IMFPresentationClock **clock);")
+cpp_quote("HRESULT WINAPI MFCreateAggregateSource(IMFCollection *collection, IMFMediaSource **source);")
 cpp_quote("HRESULT WINAPI MFCreatePresentationDescriptor(DWORD count, IMFStreamDescriptor **descriptors,")
 cpp_quote("     IMFPresentationDescriptor **presentation_desc);")
 cpp_quote("HRESULT WINAPI MFCreateSimpleTypeHandler(IMFMediaTypeHandler **handler);")
--- a/dlls/mf/Makefile.in
+++ b/dlls/mf/Makefile.in
@@ -6,6 +6,7 @@
 EXTRADLLFLAGS = -Wb,--prefer-native
 
 SOURCES = \
+	aggregate.c \
 	clock.c \
 	copier.c \
 	evr.c \
--- a/dlls/mf/mf.spec
+++ b/dlls/mf/mf.spec
@@ -23,7 +23,7 @@
 @ stub MFCreateASFStreamSelector
 @ stub MFCreateASFStreamingMediaSink
 @ stub MFCreateASFStreamingMediaSinkActivate
-@ stub MFCreateAggregateSource
+@ stdcall MFCreateAggregateSource(ptr ptr)
 @ stub MFCreateAppSourceProxy
 @ stdcall MFCreateAudioRenderer(ptr ptr)
 @ stdcall MFCreateAudioRendererActivate(ptr)
--- /dev/null
+++ b/dlls/mf/aggregate.c
@@ -0,0 +1,1049 @@
