 @ stdcall CryptUnprotectData(ptr ptr ptr ptr ptr long ptr)
@@ -204,7 +204,7 @@
 @ stdcall CryptVerifyDetachedMessageSignature(ptr long ptr long long ptr ptr ptr)
 @ stdcall CryptVerifyMessageHash(ptr ptr long ptr ptr ptr ptr)
