--- a/dlls/crypt32/message.c
+++ b/dlls/crypt32/message.c
@@ -20,6 +20,8 @@
 #include "windef.h"
 #include "winbase.h"
 #include "wincrypt.h"
+#include <stddef.h>
+#include <string.h>
 
 #include "crypt32_private.h"
 #include "wine/debug.h"
@@ -560,10 +562,10 @@ BOOL WINAPI CryptSignMessage(PCRYPT_SIGN_MESSAGE_PARA pSignPara,
     return ret;
 }
 
-BOOL WINAPI CryptEncryptMessage(PCRYPT_ENCRYPT_MESSAGE_PARA pEncryptPara,
+static BOOL encrypt_message(PCRYPT_ENCRYPT_MESSAGE_PARA pEncryptPara,
  DWORD cRecipientCert, PCCERT_CONTEXT rgpRecipientCert[],
  const BYTE *pbToBeEncrypted, DWORD cbToBeEncrypted, BYTE *pbEncryptedBlob,
- DWORD *pcbEncryptedBlob)
+ DWORD *pcbEncryptedBlob, LPSTR innerOID)
 {
     BOOL ret = TRUE;
     DWORD i;
@@ -607,7 +609,7 @@ BOOL WINAPI CryptEncryptMessage(PCRYPT_ENCRYPT_MESSAGE_PARA pEncryptPara,
 
     if (ret)
         msg = CryptMsgOpenToEncode(pEncryptPara->dwMsgEncodingType, 0,
-         CMSG_ENVELOPED, &envelopedInfo, NULL, NULL);
+         CMSG_ENVELOPED, &envelopedInfo, innerOID, NULL);
     if (msg)
     {
         ret = CryptMsgUpdate(msg, pbToBeEncrypted, cbToBeEncrypted, TRUE);
@@ -623,3 +625,430 @@ BOOL WINAPI CryptEncryptMessage(PCRYPT_ENCRYPT_MESSAGE_PARA pEncryptPara,
     if (!ret) *pcbEncryptedBlob = 0;
     return ret;
 }
+
+BOOL WINAPI CryptEncryptMessage(PCRYPT_ENCRYPT_MESSAGE_PARA pEncryptPara,
+ DWORD cRecipientCert, PCCERT_CONTEXT rgpRecipientCert[],
+ const BYTE *pbToBeEncrypted, DWORD cbToBeEncrypted, BYTE *pbEncryptedBlob,
+ DWORD *pcbEncryptedBlob)
+{
+    return encrypt_message(pEncryptPara, cRecipientCert, rgpRecipientCert, pbToBeEncrypted, cbToBeEncrypted,
+     pbEncryptedBlob, pcbEncryptedBlob, NULL);
+}
+
+/* ---- decrypting, decoding and the key-signed messages (Stained Glass OS) ---- */
+
+static BOOL decrypt_para_ok(PCRYPT_DECRYPT_MESSAGE_PARA para)
+{
+    /* the structure has a trailing dwFlags in newer SDKs; both sizes are taken */
+    return para && (para->cbSize == offsetof(CRYPT_DECRYPT_MESSAGE_PARA, rghCertStore) + sizeof(HCERTSTORE *) ||
+                    para->cbSize == offsetof(CRYPT_DECRYPT_MESSAGE_PARA, rghCertStore) + sizeof(HCERTSTORE *) + sizeof(DWORD) + 4 ||
+                    para->cbSize == sizeof(CRYPT_DECRYPT_MESSAGE_PARA)) &&
+           GET_CMSG_ENCODING_TYPE(para->dwMsgAndCertEncodingType) == PKCS_7_ASN_ENCODING;
+}
+
+/* the message is opened and updated; finds the first recipient for whose certificate (in one of the
+ * parameter's stores) a private key is available and decrypts with it */
+static BOOL decrypt_msg(HCRYPTMSG msg, PCRYPT_DECRYPT_MESSAGE_PARA para, PCCERT_CONTEXT *ppXchgCert)
+{
+    DWORD count = 0, size = sizeof(count), i, j;
+    BOOL ret = FALSE;
+
+    if (!CryptMsgGetParam(msg, CMSG_RECIPIENT_COUNT_PARAM, 0, &count, &size)) return FALSE;
+    for (i = 0; i < count && !ret; i++)
+    {
+        CERT_INFO *recipient;
+
+        size = 0;
+        if (!CryptMsgGetParam(msg, CMSG_RECIPIENT_INFO_PARAM, i, NULL, &size) || !(recipient = CryptMemAlloc(size)))
+            continue;
+        if (CryptMsgGetParam(msg, CMSG_RECIPIENT_INFO_PARAM, i, recipient, &size))
+        {
+#ifdef SG_MUTANT_DEC_NOKEY
+            for (j = 0; j < 0; j++)
+#else
+            for (j = 0; j < para->cCertStore && !ret; j++)
+#endif
+            {
+                PCCERT_CONTEXT cert = CertFindCertificateInStore(para->rghCertStore[j], para->dwMsgAndCertEncodingType,
+                 0, CERT_FIND_SUBJECT_CERT, recipient, NULL);
+                HCRYPTPROV prov;
+                DWORD keySpec;
+                BOOL free_prov;
+
+                if (!cert) continue;
+                if (CryptAcquireCertificatePrivateKey(cert, CRYPT_ACQUIRE_CACHE_FLAG, NULL, &prov, &keySpec, &free_prov))
+                {
+                    CMSG_CTRL_DECRYPT_PARA dp;
+
+                    memset(&dp, 0, sizeof(dp));
+                    dp.cbSize = sizeof(dp);
+                    dp.hCryptProv = prov;
+                    dp.dwKeySpec = keySpec;
+                    dp.dwRecipientIndex = i;
+                    ret = CryptMsgControl(msg, 0, CMSG_CTRL_DECRYPT, &dp);
+                    if (free_prov) CryptReleaseContext(prov, 0);
+                }
+                if (ret && ppXchgCert) *ppXchgCert = cert;
+                else CertFreeCertificateContext(cert);
+            }
+        }
+        CryptMemFree(recipient);
+    }
+    if (!ret) SetLastError(CRYPT_E_NO_DECRYPT_CERT);
+    return ret;
+}
+
+BOOL WINAPI CryptDecryptMessage(PCRYPT_DECRYPT_MESSAGE_PARA pDecryptPara, const BYTE *pbEncryptedBlob,
+ DWORD cbEncryptedBlob, BYTE *pbDecrypted, DWORD *pcbDecrypted, PCCERT_CONTEXT *ppXchgCert)
+{
+    HCRYPTMSG msg;
+    BOOL ret = FALSE;
+
+    TRACE("(%p, %p, %ld, %p, %p, %p)\n", pDecryptPara, pbEncryptedBlob, cbEncryptedBlob, pbDecrypted, pcbDecrypted,
+     ppXchgCert);
+
+    if (ppXchgCert) *ppXchgCert = NULL;
+    if (!decrypt_para_ok(pDecryptPara))
+    {
+        if (pcbDecrypted) *pcbDecrypted = 0;
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if ((msg = CryptMsgOpenToDecode(pDecryptPara->dwMsgAndCertEncodingType, 0, 0, 0, NULL, NULL)))
+    {
+        DWORD type = 0, size = sizeof(type);
+
+        ret = CryptMsgUpdate(msg, pbEncryptedBlob, cbEncryptedBlob, TRUE);
+        if (ret && (!CryptMsgGetParam(msg, CMSG_TYPE_PARAM, 0, &type, &size) || type != CMSG_ENVELOPED))
+        {
+            SetLastError(CRYPT_E_UNEXPECTED_MSG_TYPE);
+            ret = FALSE;
+        }
+        if (ret) ret = decrypt_msg(msg, pDecryptPara, ppXchgCert);
+        if (ret && pcbDecrypted)
+            ret = CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, pbDecrypted, pcbDecrypted);
+        CryptMsgClose(msg);
+    }
+    if (!ret && pcbDecrypted && GetLastError() != ERROR_MORE_DATA) *pcbDecrypted = 0;
+    return ret;
+}
+
+BOOL WINAPI CryptSignAndEncryptMessage(PCRYPT_SIGN_MESSAGE_PARA pSignPara, PCRYPT_ENCRYPT_MESSAGE_PARA pEncryptPara,
+ DWORD cRecipientCert, PCCERT_CONTEXT rgpRecipientCert[], const BYTE *pbToBeSignedAndEncrypted,
+ DWORD cbToBeSignedAndEncrypted, BYTE *pbSignedAndEncryptedBlob, DWORD *pcbSignedAndEncryptedBlob)
+{
+    const BYTE *pieces[1] = { pbToBeSignedAndEncrypted };
+    DWORD sizes[1] = { cbToBeSignedAndEncrypted };
+    DWORD signedSize = 0;
+    BYTE *signedBlob;
+    BOOL ret;
+
+    TRACE("(%p, %p, %ld, %p, %p, %ld, %p, %p)\n", pSignPara, pEncryptPara, cRecipientCert, rgpRecipientCert,
+     pbToBeSignedAndEncrypted, cbToBeSignedAndEncrypted, pbSignedAndEncryptedBlob, pcbSignedAndEncryptedBlob);
+
+    if (!pSignPara || !pEncryptPara || !pcbSignedAndEncryptedBlob)
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (!CryptSignMessage(pSignPara, FALSE, 1, pieces, sizes, NULL, &signedSize)) return FALSE;
+    if (!(signedBlob = CryptMemAlloc(signedSize)))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    ret = CryptSignMessage(pSignPara, FALSE, 1, pieces, sizes, signedBlob, &signedSize);
+    if (ret)
+        ret = encrypt_message(pEncryptPara, cRecipientCert, rgpRecipientCert, signedBlob, signedSize,
+         pbSignedAndEncryptedBlob, pcbSignedAndEncryptedBlob, (LPSTR)szOID_RSA_signedData);
+    CryptMemFree(signedBlob);
+    return ret;
+}
+
+BOOL WINAPI CryptDecryptAndVerifyMessageSignature(PCRYPT_DECRYPT_MESSAGE_PARA pDecryptPara,
+ PCRYPT_VERIFY_MESSAGE_PARA pVerifyPara, DWORD dwSignerIndex, const BYTE *pbEncryptedBlob, DWORD cbEncryptedBlob,
+ BYTE *pbDecrypted, DWORD *pcbDecrypted, PCCERT_CONTEXT *ppXchgCert, PCCERT_CONTEXT *ppSignerCert)
+{
+    DWORD size = 0;
+    BYTE *signedBlob;
+    BOOL ret;
+
+    TRACE("(%p, %p, %ld, %p, %ld, %p, %p, %p, %p)\n", pDecryptPara, pVerifyPara, dwSignerIndex, pbEncryptedBlob,
+     cbEncryptedBlob, pbDecrypted, pcbDecrypted, ppXchgCert, ppSignerCert);
+
+    if (ppXchgCert) *ppXchgCert = NULL;
+    if (ppSignerCert) *ppSignerCert = NULL;
+    if (!CryptDecryptMessage(pDecryptPara, pbEncryptedBlob, cbEncryptedBlob, NULL, &size, ppXchgCert))
+    {
+        if (pcbDecrypted) *pcbDecrypted = 0;
+        return FALSE;
+    }
+    if (!(signedBlob = CryptMemAlloc(size)))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        if (ppXchgCert && *ppXchgCert) { CertFreeCertificateContext(*ppXchgCert); *ppXchgCert = NULL; }
+        return FALSE;
+    }
+    if (ppXchgCert && *ppXchgCert) { CertFreeCertificateContext(*ppXchgCert); *ppXchgCert = NULL; }
+    ret = CryptDecryptMessage(pDecryptPara, pbEncryptedBlob, cbEncryptedBlob, signedBlob, &size, ppXchgCert);
+#ifndef SG_MUTANT_DEC_NOVERIFY
+    if (ret)
+        ret = CryptVerifyMessageSignature(pVerifyPara, dwSignerIndex, signedBlob, size, pbDecrypted, pcbDecrypted,
+         ppSignerCert);
+#endif
+    CryptMemFree(signedBlob);
+    if (!ret && ppXchgCert && *ppXchgCert) { CertFreeCertificateContext(*ppXchgCert); *ppXchgCert = NULL; }
+    return ret;
+}
+
+static DWORD inner_type_from_oid(const char *oid)
+{
+    if (!oid) return 0;
+    if (!strcmp(oid, szOID_RSA_signedData)) return CMSG_SIGNED;
+    if (!strcmp(oid, szOID_RSA_envelopedData)) return CMSG_ENVELOPED;
+    if (!strcmp(oid, szOID_RSA_digestedData)) return CMSG_HASHED;
+    return CMSG_DATA;
+}
+
+/* one layer of a message per call: what it is, what it holds (pdwInnerContentType, for the next call) */
+BOOL WINAPI CryptDecodeMessage(DWORD dwMsgTypeFlags, PCRYPT_DECRYPT_MESSAGE_PARA pDecryptPara,
+ PCRYPT_VERIFY_MESSAGE_PARA pVerifyPara, DWORD dwSignerIndex, const BYTE *pbEncodedBlob, DWORD cbEncodedBlob,
+ DWORD dwPrevInnerContentType, DWORD *pdwMsgType, DWORD *pdwInnerContentType, BYTE *pbDecoded, DWORD *pcbDecoded,
+ PCCERT_CONTEXT *ppXchgCert, PCCERT_CONTEXT *ppSignerCert)
+{
+    HCRYPTMSG msg;
+    DWORD type = 0, size = sizeof(type), inner = CMSG_DATA;
+    char oid[64];
+    BOOL ret = FALSE;
+
+    TRACE("(%08lx, %p, %p, %ld, %p, %ld, %ld, %p, %p, %p, %p, %p, %p)\n", dwMsgTypeFlags, pDecryptPara, pVerifyPara,
+     dwSignerIndex, pbEncodedBlob, cbEncodedBlob, dwPrevInnerContentType, pdwMsgType, pdwInnerContentType, pbDecoded,
+     pcbDecoded, ppXchgCert, ppSignerCert);
+
+    if (pdwMsgType) *pdwMsgType = 0;
+    if (pdwInnerContentType) *pdwInnerContentType = 0;
+    if (ppXchgCert) *ppXchgCert = NULL;
+    if (ppSignerCert) *ppSignerCert = NULL;
+
+    /* The bare content of a data message is taken as it is. */
+    if (dwPrevInnerContentType == CMSG_DATA && dwMsgTypeFlags == CMSG_DATA_FLAG)
+    {
+        if (pdwMsgType) *pdwMsgType = CMSG_DATA;
+        if (pdwInnerContentType) *pdwInnerContentType = CMSG_DATA;
+        if (pcbDecoded)
+        {
+            ret = TRUE;
+            if (pbDecoded && *pcbDecoded < cbEncodedBlob) { *pcbDecoded = cbEncodedBlob; SetLastError(ERROR_MORE_DATA); return FALSE; }
+            if (pbDecoded) memcpy(pbDecoded, pbEncodedBlob, cbEncodedBlob);
+            *pcbDecoded = cbEncodedBlob;
+        }
+        return TRUE;
+    }
+
+    if (!(msg = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, 0, 0, 0, NULL, NULL))) return FALSE;
+    ret = CryptMsgUpdate(msg, pbEncodedBlob, cbEncodedBlob, TRUE) &&
+          CryptMsgGetParam(msg, CMSG_TYPE_PARAM, 0, &type, &size);
+    if (ret)
+    {
+        size = sizeof(oid);
+        if (CryptMsgGetParam(msg, CMSG_INNER_CONTENT_TYPE_PARAM, 0, oid, &size)) inner = inner_type_from_oid(oid);
+#ifdef SG_MUTANT_DEC_LAYER
+        if (0)
+#else
+        if (!(dwMsgTypeFlags & (1 << type)))
+#endif
+        {
+            SetLastError(CRYPT_E_INVALID_MSG_TYPE);
+            ret = FALSE;
+        }
+    }
+    CryptMsgClose(msg);
+    if (!ret) goto done;
+
+    switch (type)
+    {
+    case CMSG_DATA:
+    case CMSG_SIGNED:
+    case CMSG_ENVELOPED:
+    case CMSG_HASHED:
+        break;
+    default:
+        SetLastError(CRYPT_E_INVALID_MSG_TYPE);
+        ret = FALSE;
+        goto done;
+    }
+    if (type == CMSG_SIGNED)
+        ret = CryptVerifyMessageSignature(pVerifyPara, dwSignerIndex, pbEncodedBlob, cbEncodedBlob, pbDecoded,
+         pcbDecoded, ppSignerCert);
+    else if (type == CMSG_ENVELOPED)
+        ret = CryptDecryptMessage(pDecryptPara, pbEncodedBlob, cbEncodedBlob, pbDecoded, pcbDecoded, ppXchgCert);
+    else if (type == CMSG_HASHED)
+    {
+        CRYPT_HASH_MESSAGE_PARA hp;
+
+        if (!pVerifyPara || pVerifyPara->cbSize != sizeof(*pVerifyPara))
+        {
+            SetLastError(E_INVALIDARG);
+            ret = FALSE;
+            goto done;
+        }
+        memset(&hp, 0, sizeof(hp));
+        hp.cbSize = sizeof(hp);
+        hp.dwMsgEncodingType = pVerifyPara->dwMsgAndCertEncodingType;
+        hp.hCryptProv = pVerifyPara->hCryptProv;
+        ret = CryptVerifyMessageHash(&hp, (BYTE *)pbEncodedBlob, cbEncodedBlob, pbDecoded, pcbDecoded, NULL, NULL);
+    }
+    else
+    {
+        /* a data message: its content */
+        HCRYPTMSG data = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, 0, 0, 0, NULL, NULL);
+
+        ret = data && CryptMsgUpdate(data, pbEncodedBlob, cbEncodedBlob, TRUE);
+        if (ret && pcbDecoded) ret = CryptMsgGetParam(data, CMSG_CONTENT_PARAM, 0, pbDecoded, pcbDecoded);
+        if (data) CryptMsgClose(data);
+    }
+done:
+    if (ret)
+    {
+        if (pdwMsgType) *pdwMsgType = type;
+        if (pdwInnerContentType) *pdwInnerContentType = inner;
+    }
+    else if (pcbDecoded && GetLastError() != ERROR_MORE_DATA)
+        *pcbDecoded = 0;
+    return ret;
+}
+
+/* ---- messages signed with a bare key, no certificate ---- */
+
+static void key_signer_cert_info(CERT_INFO *info, CRYPT_INTEGER_BLOB *serial, CERT_NAME_BLOB *issuer)
+{
+    static BYTE empty_name[] = { 0x30, 0x00 };
+    static BYTE zero_serial[] = { 0 };
+
+    memset(info, 0, sizeof(*info));
+    info->dwVersion = CERT_V3;
+    serial->cbData = 1; serial->pbData = zero_serial;
+    issuer->cbData = sizeof(empty_name); issuer->pbData = empty_name;
+    info->SerialNumber = *serial;
+    info->Issuer = *issuer;
+    /* the key is an RSA key (the only kind this signs with) */
+    info->SubjectPublicKeyInfo.Algorithm.pszObjId = (char *)szOID_RSA_RSA;
+}
+
+BOOL WINAPI CryptSignMessageWithKey(PCRYPT_KEY_SIGN_MESSAGE_PARA pSignPara, const BYTE *pbToBeSigned,
+ DWORD cbToBeSigned, BYTE *pbSignedBlob, DWORD *pcbSignedBlob)
+{
+    CMSG_SIGNED_ENCODE_INFO signInfo;
+    CMSG_SIGNER_ENCODE_INFO signer;
+    CERT_INFO certInfo;
+    CRYPT_INTEGER_BLOB serial;
+    CERT_NAME_BLOB issuer;
+    HCRYPTMSG msg;
+    BOOL ret = FALSE;
+
+    TRACE("(%p, %p, %ld, %p, %p)\n", pSignPara, pbToBeSigned, cbToBeSigned, pbSignedBlob, pcbSignedBlob);
+
+    /* the structure grew a PubKeyAlgorithm; programs built before have the shorter one */
+    if (!pSignPara || !pcbSignedBlob ||
+        (pSignPara->cbSize != sizeof(*pSignPara) && pSignPara->cbSize != offsetof(CRYPT_KEY_SIGN_MESSAGE_PARA, PubKeyAlgorithm)) ||
+        GET_CMSG_ENCODING_TYPE(pSignPara->dwMsgAndCertEncodingType) != PKCS_7_ASN_ENCODING)
+    {
+        if (pcbSignedBlob) *pcbSignedBlob = 0;
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    key_signer_cert_info(&certInfo, &serial, &issuer);
+    if (pSignPara->cbSize == sizeof(*pSignPara) && pSignPara->PubKeyAlgorithm.pszObjId)
+        certInfo.SubjectPublicKeyInfo.Algorithm = pSignPara->PubKeyAlgorithm;
+    memset(&signer, 0, sizeof(signer));
+    signer.cbSize = sizeof(signer);
+    signer.pCertInfo = &certInfo;
+    signer.hCryptProv = pSignPara->hCryptProv;
+    signer.dwKeySpec = pSignPara->dwKeySpec;
+    signer.HashAlgorithm = pSignPara->HashAlgorithm;
+    signer.pvHashAuxInfo = pSignPara->pvHashAuxInfo;
+    memset(&signInfo, 0, sizeof(signInfo));
+    signInfo.cbSize = sizeof(signInfo);
+    signInfo.cSigners = 1;
+    signInfo.rgSigners = &signer;
+    if ((msg = CryptMsgOpenToEncode(pSignPara->dwMsgAndCertEncodingType, 0, CMSG_SIGNED, &signInfo, NULL, NULL)))
+    {
+        ret = CryptMsgUpdate(msg, pbToBeSigned, cbToBeSigned, TRUE);
+        if (ret) ret = CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, pbSignedBlob, pcbSignedBlob);
+        CryptMsgClose(msg);
+    }
+    if (!ret && GetLastError() != ERROR_MORE_DATA) *pcbSignedBlob = 0;
+    return ret;
+}
+
+BOOL WINAPI CryptVerifyMessageSignatureWithKey(PCRYPT_KEY_VERIFY_MESSAGE_PARA pVerifyPara,
+ PCERT_PUBLIC_KEY_INFO pPublicKeyInfo, const BYTE *pbSignedBlob, DWORD cbSignedBlob, BYTE *pbDecoded,
+ DWORD *pcbDecoded)
+{
+    HCRYPTMSG msg;
+    BOOL ret = FALSE;
+
+    TRACE("(%p, %p, %p, %ld, %p, %p)\n", pVerifyPara, pPublicKeyInfo, pbSignedBlob, cbSignedBlob, pbDecoded, pcbDecoded);
+
+    if (!pVerifyPara || pVerifyPara->cbSize != sizeof(*pVerifyPara) ||
+        GET_CMSG_ENCODING_TYPE(pVerifyPara->dwMsgEncodingType) != PKCS_7_ASN_ENCODING || !pPublicKeyInfo)
+    {
+        if (pcbDecoded) *pcbDecoded = 0;
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if ((msg = CryptMsgOpenToDecode(pVerifyPara->dwMsgEncodingType, 0, 0, pVerifyPara->hCryptProv, NULL, NULL)))
+    {
+        ret = CryptMsgUpdate(msg, pbSignedBlob, cbSignedBlob, TRUE);
+        if (ret && pcbDecoded) ret = CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, pbDecoded, pcbDecoded);
+        if (ret)
+        {
+            CERT_INFO certInfo;
+            CRYPT_INTEGER_BLOB serial;
+            CERT_NAME_BLOB issuer;
+
+            key_signer_cert_info(&certInfo, &serial, &issuer);
+            certInfo.SubjectPublicKeyInfo = *pPublicKeyInfo;
+#ifdef SG_MUTANT_DEC_KEYSIGN
+            ret = TRUE;
+#else
+            ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE, &certInfo);
+#endif
+        }
+        CryptMsgClose(msg);
+    }
+    if (!ret && pcbDecoded && GetLastError() != ERROR_MORE_DATA) *pcbDecoded = 0;
+    return ret;
+}
+
+/* The size of the encoded message: made as the message would be, of data that are
+ * only zeros, which is as long as any other data of that length (the signature of
+ * a signed message has the key's length, whatever it signs). */
+DWORD WINAPI CryptMsgCalculateEncodedLength(DWORD dwMsgEncodingType, DWORD dwFlags, DWORD dwMsgType,
