From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcrtd: Implement the debug heap state, pointer and report file functions.

msvcrtd's remaining debug heap entry points were spec stubs. Wine's debug
heap is the normal heap, without debug block headers, so they do what can
be done without them: _CrtDbgBreak, _CrtIsValidPointer (readable, and
writable when asked), _CrtIsValidHeapPointer (a block of the CRT heap),
_CrtIsMemoryBlock (a heap block of that size; no request number or file),
_CrtMemCheckpoint (every busy block counts as a normal block),
_CrtMemDifference, _CrtMemDumpStatistics (to the debugger),
_CrtDoForAllClientObjects (there are no client blocks), _CrtSetReportFile
(kept per report type) and _CrtSetAllocHook (kept and returned). The hook
is never called and _CrtSetDbgBlockType and _CrtMemDumpAllObjectsSince
have nothing to work on; those stay FIXMEs.
---
 dlls/msvcrtd/debug.c      | 204 ++++++++++++++++++++++++++++++++++++++++++++++
 dlls/msvcrtd/msvcrtd.spec |  24 +++---
 2 files changed, 216 insertions(+), 12 deletions(-)

diff --git a/dlls/msvcrtd/debug.c b/dlls/msvcrtd/debug.c
index 137f1bf..4635772 100644
--- a/dlls/msvcrtd/debug.c
+++ b/dlls/msvcrtd/debug.c
@@ -19,6 +19,11 @@
  */
 
 #include "msvcrt.h"
+#include "crtdbg.h"
+#include "malloc.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msvcrt);
 
 int _crtAssertBusy = -1;
 int _crtBreakAlloc = -1;
@@ -123,3 +128,202 @@ int * CDECL __p__crtDbgFlag(void)
 {
     return &_crtDbgFlag;
 }
+
+/* Wine's debug heap is the normal heap: blocks carry no debug header, so
+ * there are no request numbers, file names or block types beyond normal
+ * blocks. The functions below give what can be known without them. */
+
+#undef _CrtDoForAllClientObjects
+#undef _CrtIsMemoryBlock
+#undef _CrtIsValidHeapPointer
+#undef _CrtIsValidPointer
+#undef _CrtMemCheckpoint
+#undef _CrtMemDifference
+#undef _CrtMemDumpAllObjectsSince
+#undef _CrtMemDumpStatistics
+#undef _CrtSetAllocHook
+#undef _CrtDbgBreak
+
+#define _CRTDBG_INVALID_HFILE ((HANDLE)-1)
+#define _CRTDBG_HFILE_ERROR   ((HANDLE)-2)
+#define _CRTDBG_REPORT_FILE   ((HANDLE)-6)
+#define _CRTDBG_CHECK_CRT_DF  0x10
+
+/*********************************************************************
+ *		_CrtDbgBreak (MSVCRTD.@)
+ */
+void CDECL _CrtDbgBreak(void)
+{
+    DebugBreak();
+}
+
+/*********************************************************************
+ *		_CrtIsValidPointer (MSVCRTD.@)
+ */
+int CDECL _CrtIsValidPointer(const void *p, unsigned int size, int access)
+{
+    return p && !IsBadReadPtr(p, size) && (!access || !IsBadWritePtr((void *)p, size));
+}
+
+/*********************************************************************
+ *		_CrtIsValidHeapPointer (MSVCRTD.@)
+ */
+int CDECL _CrtIsValidHeapPointer(const void *p)
+{
+    if (!p) return FALSE;
+    return HeapValidate((HANDLE)_get_heap_handle(), 0, p);
+}
+
+/*********************************************************************
+ *		_CrtIsMemoryBlock (MSVCRTD.@)
+ */
+int CDECL _CrtIsMemoryBlock(const void *p, unsigned int size, __msvcrt_long *request,
+                            char **file, int *line)
+{
+    static int once;
+
+    if (request) *request = 0;
+    if (file) *file = NULL;
+    if (line) *line = 0;
+    if (!once++) FIXME("no request numbers or file names: blocks carry no debug header\n");
+    return _CrtIsValidHeapPointer(p) && _msize((void *)p) == size;
+}
+
+static size_t high_water;
+
+/*********************************************************************
+ *		_CrtMemCheckpoint (MSVCRTD.@)
+ *
+ * Every busy block of the heap counts as a normal block; the total of
+ * allocations is the current one.
+ */
+void CDECL _CrtMemCheckpoint(_CrtMemState *state)
+{
+    HANDLE heap = (HANDLE)_get_heap_handle();
+    PROCESS_HEAP_ENTRY entry;
+    size_t count = 0, total = 0;
+
+    if (!MSVCRT_CHECK_PMT(state != NULL)) return;
+
+    memset(state, 0, sizeof(*state));
+    entry.lpData = NULL;
+    HeapLock(heap);
+    while (HeapWalk(heap, &entry))
+    {
+        if (!(entry.wFlags & PROCESS_HEAP_ENTRY_BUSY)) continue;
+        count++;
+        total += entry.cbData;
+    }
+    HeapUnlock(heap);
+    if (total > high_water) high_water = total;
+    state->lCounts[_NORMAL_BLOCK] = count;
+    state->lSizes[_NORMAL_BLOCK] = total;
+    state->lHighWaterCount = high_water;
+    state->lTotalCount = total;
+}
+
+/*********************************************************************
+ *		_CrtMemDifference (MSVCRTD.@)
+ */
+int CDECL _CrtMemDifference(_CrtMemState *diff, const _CrtMemState *old, const _CrtMemState *new)
+{
+    int i, ret = FALSE;
+
+    if (!MSVCRT_CHECK_PMT(diff != NULL && old != NULL && new != NULL)) return FALSE;
+
+    diff->pBlockHeader = NULL;
+    for (i = 0; i < _MAX_BLOCKS; i++)
+    {
+        diff->lCounts[i] = new->lCounts[i] - old->lCounts[i];
+        diff->lSizes[i] = new->lSizes[i] - old->lSizes[i];
+        if (i == _FREE_BLOCK || i == _IGNORE_BLOCK) continue;
+        if (i == _CRT_BLOCK && !(_crtDbgFlag & _CRTDBG_CHECK_CRT_DF)) continue;
+#ifndef SG_MUTANT_MEMDIFF_NEVER
+        if (diff->lCounts[i] || diff->lSizes[i]) ret = TRUE;
+#endif
+    }
+    diff->lHighWaterCount = new->lHighWaterCount - old->lHighWaterCount;
+    diff->lTotalCount = new->lTotalCount - old->lTotalCount;
+    return ret;
+}
+
+/*********************************************************************
+ *		_CrtMemDumpStatistics (MSVCRTD.@)
+ *
+ * Reports the counts of a state to the debugger.
+ */
+void CDECL _CrtMemDumpStatistics(const _CrtMemState *state)
+{
+    static const char * const names[_MAX_BLOCKS] = {"Free", "Normal", "CRT", "Ignore", "Client"};
+    char buf[128];
+    int i;
+
+    if (!MSVCRT_CHECK_PMT(state != NULL)) return;
+
+    for (i = 0; i < _MAX_BLOCKS; i++)
+    {
+        sprintf(buf, "%lu bytes in %lu %s Blocks.\n", (unsigned long)state->lSizes[i],
+                (unsigned long)state->lCounts[i], names[i]);
+        OutputDebugStringA(buf);
+    }
+    sprintf(buf, "Largest number used: %lu bytes.\n", (unsigned long)state->lHighWaterCount);
+    OutputDebugStringA(buf);
+    sprintf(buf, "Total allocations: %lu bytes.\n", (unsigned long)state->lTotalCount);
+    OutputDebugStringA(buf);
+}
+
+/*********************************************************************
+ *		_CrtMemDumpAllObjectsSince (MSVCRTD.@)
+ */
+void CDECL _CrtMemDumpAllObjectsSince(const _CrtMemState *state)
+{
+    FIXME("(%p) blocks carry no debug header to dump\n", state);
+}
+
+/*********************************************************************
+ *		_CrtDoForAllClientObjects (MSVCRTD.@)
+ *
+ * Only _malloc_dbg with _CLIENT_BLOCK makes client blocks, and Wine's
+ * _malloc_dbg makes normal blocks: there are none to visit.
+ */
+void CDECL _CrtDoForAllClientObjects(void (CDECL *func)(void *, void *), void *context)
+{
+    TRACE("(%p %p)\n", func, context);
+}
+
+static void *alloc_hook;
+
+/*********************************************************************
+ *		_CrtSetAllocHook (MSVCRTD.@)
+ */
+void * CDECL _CrtSetAllocHook(void *hook)
+{
+    void *old = alloc_hook;
+
+    if (hook) FIXME("(%p) allocation hooks are not called\n", hook);
+    alloc_hook = hook;
+    return old;
+}
+
+/*********************************************************************
+ *		_CrtSetDbgBlockType (MSVCRTD.@)
+ */
+void CDECL _CrtSetDbgBlockType(void *p, int type)
+{
+    FIXME("(%p %d) blocks carry no debug header\n", p, type);
+}
+
+static HANDLE report_files[_CRT_ERRCNT] = {_CRTDBG_INVALID_HFILE, _CRTDBG_INVALID_HFILE, _CRTDBG_INVALID_HFILE};
+
+/*********************************************************************
+ *		_CrtSetReportFile (MSVCRTD.@)
+ */
+HANDLE CDECL _CrtSetReportFile(int type, HANDLE file)
+{
+    HANDLE old;
+
+    if (type < 0 || type >= _CRT_ERRCNT) return _CRTDBG_HFILE_ERROR;
+    old = report_files[type];
+    if (file != _CRTDBG_REPORT_FILE) report_files[type] = file;
+    return old;
+}
diff --git a/dlls/msvcrtd/msvcrtd.spec b/dlls/msvcrtd/msvcrtd.spec
index ebaa7c1..1d91887 100644
--- a/dlls/msvcrtd/msvcrtd.spec
+++ b/dlls/msvcrtd/msvcrtd.spec
@@ -122,23 +122,23 @@
 @ cdecl -arch=i386 _CItan()
 @ cdecl -arch=i386 _CItanh()
 @ cdecl _CrtCheckMemory()
-@ stub _CrtDbgBreak
+@ cdecl _CrtDbgBreak()
 @ varargs _CrtDbgReport(long ptr long ptr ptr)
-@ stub _CrtDoForAllClientObjects
+@ cdecl _CrtDoForAllClientObjects(ptr ptr)
 @ cdecl _CrtDumpMemoryLeaks()
-@ stub _CrtIsMemoryBlock
-@ stub _CrtIsValidHeapPointer
-@ stub _CrtIsValidPointer
-@ stub _CrtMemCheckpoint
-@ stub _CrtMemDifference
-@ stub _CrtMemDumpAllObjectsSince
-@ stub _CrtMemDumpStatistics
-@ stub _CrtSetAllocHook
+@ cdecl _CrtIsMemoryBlock(ptr long ptr ptr ptr)
+@ cdecl _CrtIsValidHeapPointer(ptr)
+@ cdecl _CrtIsValidPointer(ptr long long)
+@ cdecl _CrtMemCheckpoint(ptr)
+@ cdecl _CrtMemDifference(ptr ptr ptr)
+@ cdecl _CrtMemDumpAllObjectsSince(ptr)
+@ cdecl _CrtMemDumpStatistics(ptr)
+@ cdecl _CrtSetAllocHook(ptr)
 @ cdecl _CrtSetBreakAlloc(long)
-@ stub _CrtSetDbgBlockType
+@ cdecl _CrtSetDbgBlockType(ptr long)
 @ cdecl _CrtSetDbgFlag(long)
 @ cdecl _CrtSetDumpClient(ptr)
-@ stub _CrtSetReportFile
+@ cdecl _CrtSetReportFile(long long)
 @ cdecl _CrtSetReportHook(ptr)
 @ cdecl _CrtSetReportMode(long long)
 @ stdcall _CxxThrowException(ptr ptr)
