             LPWSTR cmdline_end;
 
             SetupGetIntField( &context, 1, &dirid );
-            dir = DIRID_get_string( dirid );
+            dir = DIRID_get_string_inf( hinf, dirid );
 
             if (dir) dir_len = lstrlenW(dir);
 
diff --git a/dlls/setupapi/parser.c b/dlls/setupapi/parser.c
index c526166..f245bec 100644
--- a/dlls/setupapi/parser.c
+++ b/dlls/setupapi/parser.c
@@ -302,7 +302,7 @@ static const WCHAR *get_dirid_subst( const struct inf_file *file, int dirid, uns
     const WCHAR *ret;
 
     if (dirid == DIRID_SRCPATH) return get_inf_dir( file, len );
-    ret = DIRID_get_string( dirid );
+    ret = DIRID_get_string_inf( file, dirid );
     if (ret) *len = lstrlenW(ret);
     return ret;
 }
@@ -1040,6 +1040,14 @@ static struct inf_file *parse_file( HANDLE handle, const WCHAR *class, DWORD sty
  *
  * Retrieve the filename of an inf file.
  */
+BOOL PARSER_inf_in_set( HINF head, const void *file )
+{
+    const struct inf_file *f;
+
+    for (f = head; f; f = f->next) if (f == file) return TRUE;
+    return FALSE;
+}
+
 const WCHAR *PARSER_get_inf_filename( HINF hinf )
 {
     struct inf_file *file = hinf;
@@ -1061,7 +1069,12 @@ WCHAR *PARSER_get_dest_dir( INFCONTEXT *context )
     DWORD len2;
 
     if (!SetupGetIntField( context, 1, &dirid )) return NULL;
-    if (!(dir = get_dirid_subst( context->Inf, dirid, &len1 ))) return NULL;
+    dir = get_dirid_subst( context->Inf, dirid, &len1 );
+    /* a custom directory id nobody set for this INF stands for the INF's own directory */
+#ifndef SG_MUTANT_SETUP_NOINFDIR
+    if (!dir && dirid >= DIRID_USER) dir = get_inf_dir( context->Inf, &len1 );
+#endif
+    if (!dir) return NULL;
     if (!SetupGetStringFieldW( context, 2, NULL, 0, &len2 )) len2 = 0;
     if (!(ret = malloc( (len1 + len2 + 1) * sizeof(WCHAR) ))) return NULL;
     memcpy( ret, dir, len1 * sizeof(WCHAR) );
@@ -1247,6 +1260,7 @@ void WINAPI SetupCloseInfFile( HINF hinf )
 
     if (!hinf || (hinf == INVALID_HANDLE_VALUE)) return;
 
+    DIRID_close_inf( hinf );
     free_inf_file( file );
 }
 
