+++ b/dlls/advpack/tests/advpack.c
@@ -312,11 +312,8 @@ static void translateinfstring_test(void)
     hr = pTranslateInfString(inf_file, NULL, "Options.NTx86",
                              "InstallDir", buffer, MAX_PATH, &dwSize, NULL);
     ok(hr == S_OK, "Expected S_OK, got 0x%08x\n", (UINT)hr);
-    todo_wine
-    {
-        ok(!strcmp(buffer, TEST_STRING2), "Expected %s, got %s\n", TEST_STRING2, buffer);
-        ok(dwSize == 25, "Expected size 25, got %ld\n", dwSize);
-    }
+    ok(!strcmp(buffer, TEST_STRING2), "Expected %s, got %s\n", TEST_STRING2, buffer);
+    ok(dwSize == 25, "Expected size 25, got %ld\n", dwSize);
 
     DeleteFileA("c:\\a.inf");
     DeleteFileA(inf_file);
@@ -375,11 +372,8 @@ static void translateinfstringex_test(void)
     hr = pTranslateInfStringEx(hinf, "", "Options.NTx86", "InstallDir",
                               buffer, size, &size, NULL);
     ok(hr == S_OK, "Expected S_OK, got %08lx\n", hr);
-    todo_wine
-    {
-        ok(!strcmp(buffer, TEST_STRING2), "Expected %s, got %s\n", TEST_STRING2, buffer);
-        ok(size == 25, "Expected size 25, got %ld\n", size);
-    }
+    ok(!strcmp(buffer, TEST_STRING2), "Expected %s, got %s\n", TEST_STRING2, buffer);
+    ok(size == 25, "Expected size 25, got %ld\n", size);
 
     /* try a NULL translate section */
     hr = pTranslateInfStringEx(hinf, inf_file, NULL, "InstallDir",
@@ -408,11 +402,8 @@ static void translateinfstringex_test(void)
     hr = pTranslateInfStringEx(hinf, inf_file, "Options.NTx86", "InstallDir",
                               buffer, size, &size, NULL);
     ok(hr == S_OK, "Expected S_OK, got %08lx\n", hr);
-    todo_wine
-    {
-        ok(!strcmp(buffer, TEST_STRING2), "Expected %s, got %s\n", TEST_STRING2, buffer);
-        ok(size == 25, "Expected size 25, got %ld\n", size);
-    }
+    ok(!strcmp(buffer, TEST_STRING2), "Expected %s, got %s\n", TEST_STRING2, buffer);
+    ok(size == 25, "Expected size 25, got %ld\n", size);
 
     /* try a NULL hinf */
     hr = pCloseINFEngine(NULL);
diff --git a/dlls/setupapi/dirid.c b/dlls/setupapi/dirid.c
index a46b974..8d69c90 100644
--- a/dlls/setupapi/dirid.c
+++ b/dlls/setupapi/dirid.c
@@ -43,6 +43,7 @@ struct user_dirid
 {
     int    id;
     WCHAR *str;
+    HINF   owner;  /* the INF the id was set for, NULL for all of them */
 };
 
 #ifdef __i386__
@@ -205,6 +206,12 @@ static const WCHAR *get_csidl_dir( DWORD csidl )
 
 /* retrieve the string corresponding to a dirid, or NULL if none */
 const WCHAR *DIRID_get_string( int dirid )
+{
+    return DIRID_get_string_inf( NULL, dirid );
+}
+
+/* the ids set for an INF are its own; the ones set for no INF are everybody's */
+const WCHAR *DIRID_get_string_inf( const void *inf, int dirid )
 {
     int i;
 
@@ -217,8 +224,19 @@ const WCHAR *DIRID_get_string( int dirid )
     }
     else if (dirid >= DIRID_USER)
     {
+#ifdef SG_MUTANT_SETUP_GLOBALDIRID
         for (i = 0; i < nb_user_dirids; i++)
             if (user_dirids[i].id == dirid) return user_dirids[i].str;
+#endif
+        if (inf)
+            for (i = 0; i < nb_user_dirids; i++)
+                if (user_dirids[i].id == dirid && user_dirids[i].owner && PARSER_inf_in_set( user_dirids[i].owner, inf ))
+                    return user_dirids[i].str;
+        for (i = 0; i < nb_user_dirids; i++)
+            if (user_dirids[i].id == dirid && !user_dirids[i].owner) return user_dirids[i].str;
+        if (!inf)  /* a caller that does not know its INF sees any id */
+            for (i = 0; i < nb_user_dirids; i++)
+                if (user_dirids[i].id == dirid) return user_dirids[i].str;
         WARN("user id %d not found\n", dirid );
         return NULL;
     }
@@ -237,12 +255,27 @@ const WCHAR *DIRID_get_string( int dirid )
     }
 }
 
+/* drops the ids set for an INF (all of the global ones when it is NULL) */
+void DIRID_close_inf( HINF hinf )
+{
+    int i, j = 0;
+
+    if (hinf == INVALID_HANDLE_VALUE) hinf = NULL;
+    for (i = 0; i < nb_user_dirids; i++)
+    {
+        if (user_dirids[i].owner == hinf) free( user_dirids[i].str );
+        else user_dirids[j++] = user_dirids[i];
+    }
+    nb_user_dirids = j;
+}
+
 /* store a user dirid string */
 static BOOL store_user_dirid( HINF hinf, int id, WCHAR *str )
 {
     int i;
 
-    for (i = 0; i < nb_user_dirids; i++) if (user_dirids[i].id == id) break;
+    if (hinf == INVALID_HANDLE_VALUE) hinf = NULL;
+    for (i = 0; i < nb_user_dirids; i++) if (user_dirids[i].id == id && user_dirids[i].owner == hinf) break;
 
     if (i < nb_user_dirids) free( user_dirids[i].str );
     else
@@ -259,6 +292,7 @@ static BOOL store_user_dirid( HINF hinf, int id, WCHAR *str )
     }
     user_dirids[i].id  = id;
     user_dirids[i].str = str;
+    user_dirids[i].owner = hinf;
     TRACE("id %d -> %s\n", id, debugstr_w(str) );
     return TRUE;
 }
@@ -270,12 +304,10 @@ static BOOL store_user_dirid( HINF hinf, int id, WCHAR *str )
 BOOL WINAPI SetupSetDirectoryIdA( HINF hinf, DWORD id, PCSTR dir )
 {
     UNICODE_STRING dirW;
-    int i;
 
     if (!id)  /* clear everything */
     {
-        for (i = 0; i < nb_user_dirids; i++) free( user_dirids[i].str );
-        nb_user_dirids = 0;
+        DIRID_close_inf( hinf );
         return TRUE;
     }
     if (id < DIRID_USER)
@@ -299,13 +331,12 @@ BOOL WINAPI SetupSetDirectoryIdA( HINF hinf, DWORD id, PCSTR dir )
  */
 BOOL WINAPI SetupSetDirectoryIdW( HINF hinf, DWORD id, PCWSTR dir )
 {
-    int i, len;
+    int len;
     WCHAR *str;
 
     if (!id)  /* clear everything */
     {
-        for (i = 0; i < nb_user_dirids; i++) free( user_dirids[i].str );
-        nb_user_dirids = 0;
+        DIRID_close_inf( hinf );
         return TRUE;
     }
     if (id < DIRID_USER)
