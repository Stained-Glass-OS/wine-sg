From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.media.mediacontrol: Non-agile handlers are called in their apartment (6528)

Since 6523 the transport controls raise ButtonPressed and
PlaybackPositionChangeRequested from their own thread. A handler that is
not agile must be called in the apartment that registered it, as COM
would marshal the call. Firefox registers its handlers on its media
thread (an STA) and asserts that they run there
(MOZ_RELEASE_ASSERT(mWorkerThread->IsOnCurrentThread())), so the first
MPRIS PlayPause crashed it. Handlers registered in a single-threaded
apartment now get the call through a message-only window of their
thread, as windows.ui's toasts do. Agile handlers, and those registered
in the MTA, are called on the dispatcher thread, which joins the MTA.
---
diff --git a/dlls/windows.media.mediacontrol/Makefile.in b/dlls/windows.media.mediacontrol/Makefile.in
index 16a568c..176d697 100644
--- a/dlls/windows.media.mediacontrol/Makefile.in
+++ b/dlls/windows.media.mediacontrol/Makefile.in
@@ -1,7 +1,7 @@
 MODULE  = windows.media.mediacontrol.dll
 UNIXLIB = windows.media.mediacontrol.so
 UNIX_CFLAGS = $(DBUS_CFLAGS)
-IMPORTS = combase ole32 shcore
+IMPORTS = combase ole32 shcore user32
 
 SOURCES = \
 	audio.idl \
diff --git a/dlls/windows.media.mediacontrol/main.c b/dlls/windows.media.mediacontrol/main.c
index 3bde010..bb07404 100644
--- a/dlls/windows.media.mediacontrol/main.c
+++ b/dlls/windows.media.mediacontrol/main.c
@@ -37,8 +37,78 @@ struct handler
     struct list entry;
     EventRegistrationToken token;
     IUnknown *handler;
+    HWND apartment;     /* the single-threaded apartment a handler that is not agile lives in (wine-sg 6528) */
 };
 
+/* Stained Glass OS (wine-sg 6528): a handler that is not agile is called in the apartment that
+ * registered it, as COM would marshal the call (the transport controls' events come from our own
+ * thread since 6523): Firefox asserts its handlers run on its media thread. A single-threaded
+ * apartment gets the call through a message-only window of its thread, as windows.ui's toasts do. */
+#define WM_SMTC_INVOKE (WM_APP + 4)
+
+struct invocation
+{
+    IUnknown *handler;
+    IInspectable *sender;
+    IInspectable *args;
+};
+
+static void invoke( struct invocation *call )
+{
+    /* every typed handler is Invoke( sender, args ) after IUnknown */
+    ITypedEventHandler_SystemMediaTransportControls_SystemMediaTransportControlsButtonPressedEventArgs_Invoke(
+        (ITypedEventHandler_SystemMediaTransportControls_SystemMediaTransportControlsButtonPressedEventArgs *)call->handler,
+        (ISystemMediaTransportControls *)call->sender, (ISystemMediaTransportControlsButtonPressedEventArgs *)call->args );
+    IUnknown_Release( call->handler );
+    IInspectable_Release( call->sender );
+    IInspectable_Release( call->args );
+    free( call );
+}
+
+static LRESULT CALLBACK apartment_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (msg == WM_SMTC_INVOKE)
+    {
+        invoke( (struct invocation *)lparam );
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static HWND apartment_window( IUnknown *handler )
+{
+    static const WCHAR class_name[] = L"WineSMTCApartment";
+    static ATOM atom;
+    APTTYPEQUALIFIER qualifier;
+    APTTYPE type;
+    IUnknown *agile;
+    HWND hwnd = NULL;
+
+#ifdef SG_MUTANT_SMTC_NO_APARTMENT
+    return NULL;
+#endif
+    if (SUCCEEDED(IUnknown_QueryInterface( handler, &IID_IAgileObject, (void **)&agile )))
+    {
+        IUnknown_Release( agile );
+        return NULL;
+    }
+    if (FAILED(CoGetApartmentType( &type, &qualifier )) || (type != APTTYPE_STA && type != APTTYPE_MAINSTA)) return NULL;
+
+    /* one window per thread, found by its class among the thread's windows */
+    while ((hwnd = FindWindowExW( HWND_MESSAGE, hwnd, class_name, NULL )))
+        if (GetWindowThreadProcessId( hwnd, NULL ) == GetCurrentThreadId()) return hwnd;
+
+    if (!atom)
+    {
+        WNDCLASSW class = {0};
+        GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, (const WCHAR *)apartment_wndproc, &class.hInstance );
+        class.lpfnWndProc = apartment_wndproc;
+        class.lpszClassName = class_name;
+        atom = RegisterClassW( &class );
+    }
+    return CreateWindowExW( 0, class_name, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, NULL, NULL );
+}
+
 static SRWLOCK event_lock = SRWLOCK_INIT;
 static LONG64 next_token;
 
@@ -51,6 +121,7 @@ static HRESULT event_add( struct list *list, IUnknown *handler, EventRegistratio
     if (!handler) return E_INVALIDARG;
     if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
     entry->handler = handler;
+    entry->apartment = apartment_window( handler );
     IUnknown_AddRef( handler );
     entry->token.value = InterlockedIncrement64( &next_token );
     AcquireSRWLockExclusive( &event_lock );
@@ -1501,16 +1572,18 @@ static void raise_event( struct media_control *impl, struct list *list, IInspect
 {
     struct handler *entry;
     IUnknown **handlers;
+    HWND *apartments = NULL;
     UINT count = 0, i;
 
     AcquireSRWLockShared( &event_lock );
     LIST_FOR_EACH_ENTRY( entry, list, struct handler, entry ) count++;
-    if ((handlers = calloc( max( count, 1 ), sizeof(*handlers) )))
+    if ((handlers = calloc( max( count, 1 ), sizeof(*handlers) )) && (apartments = calloc( max( count, 1 ), sizeof(*apartments) )))
     {
         count = 0;
         LIST_FOR_EACH_ENTRY( entry, list, struct handler, entry )
         {
             handlers[count] = entry->handler;
+            apartments[count] = entry->apartment;
             IUnknown_AddRef( handlers[count] );
             count++;
         }
@@ -1521,12 +1594,22 @@ static void raise_event( struct media_control *impl, struct list *list, IInspect
     TRACE( "control %p, args %p, %u handlers\n", impl, args, count );
     for (i = 0; i < count; i++)
     {
-        ITypedEventHandler_SystemMediaTransportControls_SystemMediaTransportControlsButtonPressedEventArgs_Invoke(
-            (ITypedEventHandler_SystemMediaTransportControls_SystemMediaTransportControlsButtonPressedEventArgs *)handlers[i],
-            &impl->ISystemMediaTransportControls_iface, (ISystemMediaTransportControlsButtonPressedEventArgs *)args );
-        IUnknown_Release( handlers[i] );
+        struct invocation *call;
+
+        if (!(call = malloc( sizeof(*call) )))
+        {
+            IUnknown_Release( handlers[i] );
+            continue;
+        }
+        call->handler = handlers[i];
+        call->sender = (IInspectable *)&impl->ISystemMediaTransportControls_iface;
+        IInspectable_AddRef( call->sender );
+        call->args = args;
+        IInspectable_AddRef( args );
+        if (!apartments[i] || !PostMessageW( apartments[i], WM_SMTC_INVOKE, 0, (LPARAM)call )) invoke( call );
     }
     free( handlers );
+    free( apartments );
 }
 
 static void raise_button_pressed( struct media_control *impl, SystemMediaTransportControlsButton button )
@@ -1734,6 +1817,7 @@ static DWORD WINAPI mpris_thread( void *arg )
     struct media_control *impl, *found;
 
     SetThreadDescription( GetCurrentThread(), L"sg_smtc_mpris" );
+    CoInitializeEx( NULL, COINIT_MULTITHREADED );   /* (the handlers of the free-threaded apartment are called here) */
     for (;;)
     {
         /* covers asked for since the last time */
