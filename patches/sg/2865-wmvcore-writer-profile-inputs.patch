 }
 
 static HRESULT WINAPI WMWriter_SetOutputFilename(IWMWriter *iface, const WCHAR *filename)
 {
     WMWriter *This = impl_from_IWMWriter(iface);
-    FIXME("(%p)->(%s)\n", This, debugstr_w(filename));
