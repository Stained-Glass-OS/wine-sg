+static const GUID media_type_audio = {0x73647561, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID media_type_video = {0x73646976, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID media_type_script = {0x73636d64, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID format_waveformatex = {0x05589f81, 0xc356, 0x11ce, {0xbf, 0x01, 0x00, 0xaa, 0x00, 0x55, 0x59, 0x5a}};
+static const GUID format_videoinfo = {0x05589f80, 0xc356, 0x11ce, {0xbf, 0x01, 0x00, 0xaa, 0x00, 0x55, 0x59, 0x5a}};
+static const GUID format_script = {0x5c8510f2, 0xdebe, 0x4ca7, {0xbb, 0xa5, 0xf0, 0x7a, 0x10, 0x4f, 0x8d, 0xff}};
+static const GUID subtype_pcm = {0x00000001, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID subtype_two_strings = {0x82f38a70, 0xc29f, 0x11d1, {0x97, 0xad, 0x00, 0xa0, 0xc9, 0x5e, 0xa8, 0x50}};
+static const GUID null_guid;
+
+#define WAVEFORMATEX_SIZE 18
+#define VIDEOINFO_SIZE 88
+
+static WORD rd16(const BYTE *p) { return p[0] | (p[1] << 8); }
+static DWORD rd32(const BYTE *p) { return rd16(p) | ((DWORD)rd16(p + 2) << 16); }
+static void wr16(BYTE *p, WORD v) { p[0] = v; p[1] = v >> 8; }
+static void wr32(BYTE *p, DWORD v) { wr16(p, v); wr16(p + 2, v >> 16); }
+
+/* The uncompressed formats an input accepts, derived from the stream the
+ * profile describes: PCM at the stream's channel count and rate, YUV or RGB
+ * frames of the stream's size, or script commands. No encoder is involved in
+ * listing them. */
+static const struct video_format
+{
+    GUID subtype;
+    DWORD compression;
+    WORD bits;
+    BOOL planar;
+}
+video_formats[] =
+{
+    {{0x30323449, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}}, 0x30323449, 12, TRUE},  /* I420 */
+    {{0x32315659, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}}, 0x32315659, 12, TRUE},  /* YV12 */
+    {{0x32595559, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}}, 0x32595559, 16, FALSE}, /* YUY2 */
+    {{0xe436eb7d, 0x524f, 0x11ce, {0x9f, 0x53, 0x00, 0x20, 0xaf, 0x0b, 0xa7, 0x70}}, 0, 24, FALSE},          /* RGB24 */
+    {{0xe436eb7e, 0x524f, 0x11ce, {0x9f, 0x53, 0x00, 0x20, 0xaf, 0x0b, 0xa7, 0x70}}, 0, 32, FALSE},          /* RGB32 */
+};
+
+static BOOL input_has_audio_format(const struct writer_input *input)
+{
+    return IsEqualGUID(&input->type, &media_type_audio) && input->stream_mt
+            && IsEqualGUID(&input->stream_mt->formattype, &format_waveformatex)
+            && input->stream_mt->cbFormat >= WAVEFORMATEX_SIZE;
+}
+
+static BOOL input_has_video_format(const struct writer_input *input)
+{
+    return IsEqualGUID(&input->type, &media_type_video) && input->stream_mt
+            && IsEqualGUID(&input->stream_mt->formattype, &format_videoinfo)
+            && input->stream_mt->cbFormat >= VIDEOINFO_SIZE;
+}
+
+static DWORD input_format_count(const struct writer_input *input)
+{
+    if (input_has_audio_format(input))
+        return 1;
+    if (input_has_video_format(input))
+        return ARRAY_SIZE(video_formats);
+    if (IsEqualGUID(&input->type, &media_type_script))
+        return 1;
+    return 0;
+}
+
+static HRESULT input_format(const struct writer_input *input, DWORD index, WM_MEDIA_TYPE **out)
+{
+    WM_MEDIA_TYPE mt = {0};
+    BYTE format[VIDEOINFO_SIZE];
+    HRESULT hr;
+
+    if (index >= input_format_count(input))
+        return E_INVALIDARG;
+    mt.majortype = input->type;
+
+    if (input_has_audio_format(input))
+    {
+        const BYTE *src = input->stream_mt->pbFormat;
+        WORD channels = rd16(src + 2), block = channels * 2;
+        DWORD rate = rd32(src + 4);
+
+        memset(format, 0, WAVEFORMATEX_SIZE);
+        wr16(format, 1);
+        wr16(format + 2, channels);
+        wr32(format + 4, rate);
+        wr32(format + 8, rate * block);
+        wr16(format + 12, block);
+        wr16(format + 14, 16);
+        mt.subtype = subtype_pcm;
+        mt.bFixedSizeSamples = TRUE;
+        mt.lSampleSize = block;
+        mt.formattype = format_waveformatex;
+        mt.cbFormat = WAVEFORMATEX_SIZE;
+    }
+    else if (input_has_video_format(input))
+    {
+        const struct video_format *vf = &video_formats[index];
+        const BYTE *src = input->stream_mt->pbFormat;
+        LONG width = rd32(src + 52), height = rd32(src + 56);
+        DWORD stride = vf->planar ? (width + 3) & ~3 : ((width * vf->bits + 31) / 32) * 4;
+        DWORD image = vf->planar ? stride * abs(height) * 3 / 2 : stride * abs(height);
+
+        memset(format, 0, sizeof(format));
+        memcpy(format, src, 32);                  /* source and target rectangles */
+        memcpy(format + 40, src + 40, 8);         /* average time per frame */
+        wr32(format + 48, 40);
+        wr32(format + 52, width);
+        wr32(format + 56, abs(height));
+        wr16(format + 60, 1);
+        wr16(format + 62, vf->bits);
+        wr32(format + 64, vf->compression);
+        wr32(format + 68, image);
+        mt.subtype = vf->subtype;
+        mt.bFixedSizeSamples = TRUE;
+        mt.lSampleSize = image;
+        mt.formattype = format_videoinfo;
+        mt.cbFormat = VIDEOINFO_SIZE;
+    }
+    else
+    {
+        memcpy(format, &subtype_two_strings, sizeof(GUID));
+        mt.subtype = subtype_two_strings;
+        mt.formattype = format_script;
+        mt.cbFormat = sizeof(GUID);
+    }
+    mt.pbFormat = format;
+    if (FAILED(hr = wm_dup_media_type(&mt, out)))
+        return hr;
+    return S_OK;
+}
+
+static BOOL input_format_accepted(const struct writer_input *input, const WM_MEDIA_TYPE *mt)
+{
+    DWORD i;
+
+    for (i = 0; i < input_format_count(input); i++)
+    {
+        WM_MEDIA_TYPE *f;
+        BOOL match = FALSE;
+
+        if (FAILED(input_format(input, i, &f)))
+            continue;
+        if (IsEqualGUID(&f->subtype, &mt->subtype) && IsEqualGUID(&f->formattype, &mt->formattype)
+                && mt->cbFormat >= f->cbFormat && mt->pbFormat)
+        {
+            if (IsEqualGUID(&f->formattype, &format_waveformatex))
+                match = rd16(f->pbFormat + 2) == rd16(mt->pbFormat + 2) && rd32(f->pbFormat + 4) == rd32(mt->pbFormat + 4)
+                        && rd16(f->pbFormat + 14) == rd16(mt->pbFormat + 14);
+            else if (IsEqualGUID(&f->formattype, &format_videoinfo))
+                match = rd32(f->pbFormat + 52) == rd32(mt->pbFormat + 52) && abs((LONG)rd32(f->pbFormat + 56)) == abs((LONG)rd32(mt->pbFormat + 56))
+                        && rd16(f->pbFormat + 62) == rd16(mt->pbFormat + 62);
+            else
+                match = !memcmp(f->pbFormat, mt->pbFormat, f->cbFormat);
+        }
+        wm_free_media_type(f);
+        if (match)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+/* IWMInputMediaProps: a media type and the connection name of the input. */
+struct input_props
+{
+    IWMInputMediaProps IWMInputMediaProps_iface;
+    LONG refcount;
+    WM_MEDIA_TYPE *mt;
+    WCHAR *connection;
+};
+
+static struct input_props *impl_from_IWMInputMediaProps(IWMInputMediaProps *iface)
+{
+    return CONTAINING_RECORD(iface, struct input_props, IWMInputMediaProps_iface);
+}
+
+static HRESULT WINAPI input_props_QueryInterface(IWMInputMediaProps *iface, REFIID iid, void **out)
+{
+    struct input_props *props = impl_from_IWMInputMediaProps(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IWMMediaProps)
+            || IsEqualGUID(iid, &IID_IWMInputMediaProps))
+        *out = &props->IWMInputMediaProps_iface;
+    else
+    {
+        *out = NULL;
+        WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI input_props_AddRef(IWMInputMediaProps *iface)
+{
+    struct input_props *props = impl_from_IWMInputMediaProps(iface);
+    return InterlockedIncrement(&props->refcount);
+}
+
+static ULONG WINAPI input_props_Release(IWMInputMediaProps *iface)
+{
+    struct input_props *props = impl_from_IWMInputMediaProps(iface);
+    ULONG refcount = InterlockedDecrement(&props->refcount);
+
+    if (!refcount)
+    {
+        wm_free_media_type(props->mt);
+        free(props->connection);
+        free(props);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI input_props_GetType(IWMInputMediaProps *iface, GUID *type)
+{
+    struct input_props *props = impl_from_IWMInputMediaProps(iface);
+
+    TRACE("iface %p, type %p.\n", iface, type);
+
+    if (!type)
+        return E_INVALIDARG;
+    *type = props->mt->majortype;
+    return S_OK;
+}
+
+static HRESULT WINAPI input_props_GetMediaType(IWMInputMediaProps *iface, WM_MEDIA_TYPE *mt, DWORD *size)
+{
+    struct input_props *props = impl_from_IWMInputMediaProps(iface);
+
+    TRACE("iface %p, mt %p, size %p.\n", iface, mt, size);
+
+    if (!size)
+        return E_INVALIDARG;
+    return wm_copy_media_type(props->mt, mt, size);
+}
+
+static HRESULT WINAPI input_props_SetMediaType(IWMInputMediaProps *iface, WM_MEDIA_TYPE *mt)
+{
+    struct input_props *props = impl_from_IWMInputMediaProps(iface);
+    WM_MEDIA_TYPE *copy;
+    HRESULT hr;
+
+    TRACE("iface %p, mt %p.\n", iface, mt);
+
+    if (!mt || (mt->cbFormat && !mt->pbFormat))
+        return E_INVALIDARG;
+    if (FAILED(hr = wm_dup_media_type(mt, &copy)))
+        return hr;
+    wm_free_media_type(props->mt);
+    props->mt = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI input_props_GetConnectionName(IWMInputMediaProps *iface, WCHAR *name, WORD *len)
+{
+    struct input_props *props = impl_from_IWMInputMediaProps(iface);
+
+    TRACE("iface %p, name %p, len %p.\n", iface, name, len);
+
+    return wm_get_string_word(props->connection, name, len);
+}
+
+static HRESULT WINAPI input_props_GetGroupName(IWMInputMediaProps *iface, WCHAR *name, WORD *len)
+{
+    TRACE("iface %p, name %p, len %p.\n", iface, name, len);
+
+    /* Inputs are not grouped by mutual exclusions here. */
+    return wm_get_string_word(NULL, name, len);
+}
+
+static const IWMInputMediaPropsVtbl input_props_vtbl =
+{
+    input_props_QueryInterface,
+    input_props_AddRef,
+    input_props_Release,
+    input_props_GetType,
+    input_props_GetMediaType,
+    input_props_SetMediaType,
+    input_props_GetConnectionName,
+    input_props_GetGroupName,
+};
+
+static HRESULT input_props_create(const struct writer_input *input, const WM_MEDIA_TYPE *mt, IWMInputMediaProps **out)
+{
+    struct input_props *props;
+    HRESULT hr;
+
+    if (!(props = calloc(1, sizeof(*props))))
+        return E_OUTOFMEMORY;
+    props->IWMInputMediaProps_iface.lpVtbl = &input_props_vtbl;
+    props->refcount = 1;
+    if (FAILED(hr = wm_dup_media_type(mt, &props->mt))
+            || (input->connection && !(props->connection = wcsdup(input->connection))))
+    {
+        input_props_Release(&props->IWMInputMediaProps_iface);
+        return FAILED(hr) ? hr : E_OUTOFMEMORY;
+    }
+    *out = &props->IWMInputMediaProps_iface;
+    return S_OK;
+}
+
+static void writer_clear_inputs(WMWriter *writer)
+{
+    DWORD i;
+
+    for (i = 0; i < writer->input_count; i++)
+    {
+        wm_free_media_type(writer->inputs[i].stream_mt);
+        wm_free_media_type(writer->inputs[i].chosen);
+        free(writer->inputs[i].connection);
+    }
+    free(writer->inputs);
+    writer->inputs = NULL;
+    writer->input_count = 0;
+}
+
+static HRESULT writer_load_inputs(WMWriter *writer, IWMProfile *profile)
+{
+    DWORD count, i;
+    HRESULT hr;
+
+    if (FAILED(hr = IWMProfile_GetStreamCount(profile, &count)))
+        return hr;
+    if (count && !(writer->inputs = calloc(count, sizeof(*writer->inputs))))
+        return E_OUTOFMEMORY;
+    writer->input_count = count;
+
+    for (i = 0; i < count; i++)
+    {
+        struct writer_input *input = &writer->inputs[i];
+        IWMStreamConfig *config;
+        IWMMediaProps *props;
+        WORD len = 0;
+
+        if (FAILED(hr = IWMProfile_GetStream(profile, i, &config)))
+            return hr;
+        IWMStreamConfig_GetStreamType(config, &input->type);
+        IWMStreamConfig_GetStreamNumber(config, &input->stream_number);
+        if (SUCCEEDED(IWMStreamConfig_GetConnectionName(config, NULL, &len)) && len > 1
+                && (input->connection = malloc(len * sizeof(WCHAR))))
+            IWMStreamConfig_GetConnectionName(config, input->connection, &len);
+        if (SUCCEEDED(IWMStreamConfig_QueryInterface(config, &IID_IWMMediaProps, (void **)&props)))
+        {
+            DWORD size = 0;
+            WM_MEDIA_TYPE *mt;
+
+            if (SUCCEEDED(IWMMediaProps_GetMediaType(props, NULL, &size)) && size >= sizeof(*mt) && (mt = malloc(size)))
+            {
+                if (SUCCEEDED(IWMMediaProps_GetMediaType(props, mt, &size))
+                        && (!IsEqualGUID(&mt->subtype, &null_guid) || mt->cbFormat))
+                    wm_dup_media_type(mt, &input->stream_mt);
+                free(mt);
+            }
+            IWMMediaProps_Release(props);
+        }
+        IWMStreamConfig_Release(config);
+    }
+    return S_OK;
+}
+
 static HRESULT WINAPI WMWriter_SetProfileByID(IWMWriter *iface, REFGUID guidProfile)
 {
     WMWriter *This = impl_from_IWMWriter(iface);
-    FIXME("(%p)->(%s)\n", This, debugstr_guid(guidProfile));
