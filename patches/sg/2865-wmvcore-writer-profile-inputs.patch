 static HRESULT WINAPI WMWriter_GetInputCount(IWMWriter *iface, DWORD *pcInputs)
 {
     WMWriter *This = impl_from_IWMWriter(iface);
-    FIXME("(%p)->(%p)\n", This, pcInputs);
