+static ULONGLONG gif_num(const MetadataItem *items, DWORD count, const WCHAR *name, ULONGLONG def)
+{
+    ULONGLONG v;
+
+    return md_item_uint(md_find_item(items, count, name), &v) ? v : def;
+}
+
+static HRESULT LSD_serialize(const MetadataItem *items, DWORD count, DWORD options, struct md_buf *buf)
+{
+    struct logical_screen_descriptor lsd = { "GIF89a" };
+    const MetadataItem *sig = md_find_item(items, count, L"Signature");
+
+    if (sig && sig->value.vt == (VT_UI1 | VT_VECTOR) && sig->value.caub.cElems >= sizeof(lsd.signature))
+        memcpy(lsd.signature, sig->value.caub.pElems, sizeof(lsd.signature));
+    lsd.width = gif_num(items, count, L"Width", 0);
+    lsd.height = gif_num(items, count, L"Height", 0);
+    lsd.packed = (gif_num(items, count, L"GlobalColorTableFlag", 0) ? 0x80 : 0)
+            | ((gif_num(items, count, L"ColorResolution", 0) & 7) << 4)
+            | (gif_num(items, count, L"SortFlag", 0) ? 0x08 : 0)
+            | (gif_num(items, count, L"GlobalColorTableSize", 0) & 7);
+    lsd.background_color_index = gif_num(items, count, L"BackgroundColorIndex", 0);
+    lsd.pixel_aspect_ratio = gif_num(items, count, L"PixelAspectRatio", 0);
+    return md_buf_put(buf, &lsd, sizeof(lsd));
+}
+
+MD_SERIALIZER(LSD)
+
+static HRESULT IMD_serialize(const MetadataItem *items, DWORD count, DWORD options, struct md_buf *buf)
+{
+    struct image_descriptor imd;
+
+    imd.left = gif_num(items, count, L"Left", 0);
+    imd.top = gif_num(items, count, L"Top", 0);
+    imd.width = gif_num(items, count, L"Width", 0);
+    imd.height = gif_num(items, count, L"Height", 0);
+    imd.packed = (gif_num(items, count, L"LocalColorTableFlag", 0) ? 0x80 : 0)
+            | (gif_num(items, count, L"InterlaceFlag", 0) ? 0x40 : 0)
+            | (gif_num(items, count, L"SortFlag", 0) ? 0x20 : 0)
+            | (gif_num(items, count, L"LocalColorTableSize", 0) & 7);
+    return md_buf_put(buf, &imd, sizeof(imd));
+}
+
+MD_SERIALIZER(IMD)
+
+static HRESULT GCE_serialize(const MetadataItem *items, DWORD count, DWORD options, struct md_buf *buf)
+{
+    BYTE packed = ((gif_num(items, count, L"Disposal", 0) & 7) << 2)
+            | (gif_num(items, count, L"UserInputFlag", 0) ? 0x02 : 0)
+            | (gif_num(items, count, L"TransparencyFlag", 0) ? 0x01 : 0);
+    USHORT delay = gif_num(items, count, L"Delay", 0);
+    BYTE index = gif_num(items, count, L"TransparentColorIndex", 0);
+    HRESULT hr;
+
+    if (SUCCEEDED(hr = md_buf_put_u8(buf, packed))
+            && SUCCEEDED(hr = md_buf_put_u16(buf, delay, FALSE)))
+        hr = md_buf_put_u8(buf, index);
+    return hr;
+}
+
+MD_SERIALIZER(GCE)
+
+static HRESULT APE_serialize(const MetadataItem *items, DWORD count, DWORD options, struct md_buf *buf)
+{
+    const MetadataItem *app = md_find_item(items, count, L"Application");
+    const MetadataItem *data = md_find_item(items, count, L"Data");
+    BYTE name[11] = {0};
+    HRESULT hr;
+
+    if (app && app->value.vt == (VT_UI1 | VT_VECTOR))
+        memcpy(name, app->value.caub.pElems, min(app->value.caub.cElems, sizeof(name)));
+    if (FAILED(hr = md_buf_put_u8(buf, 0x21))) return hr;
+    if (FAILED(hr = md_buf_put_u8(buf, APPLICATION_EXT_FUNC_CODE))) return hr;
+    if (FAILED(hr = md_buf_put_u8(buf, 11))) return hr;
+    if (FAILED(hr = md_buf_put(buf, name, sizeof(name)))) return hr;
+    /* the data is kept as the sub-blocks it was read as, sizes included */
+    if (data && data->value.vt == (VT_UI1 | VT_VECTOR) && FAILED(hr = md_buf_put(buf, data->value.caub.pElems,
+            data->value.caub.cElems)))
+        return hr;
+    return md_buf_put_u8(buf, 0);
+}
+
+MD_SERIALIZER(APE)
+
+static HRESULT GifComment_serialize(const MetadataItem *items, DWORD count, DWORD options, struct md_buf *buf)
+{
+    const MetadataItem *text = md_find_item(items, count, L"TextEntry");
+    const char *str = text && text->value.vt == VT_LPSTR && text->value.pszVal ? text->value.pszVal : "";
+    ULONG len = strlen(str), at = 0, chunk;
+    HRESULT hr;
+
+    if (FAILED(hr = md_buf_put_u8(buf, 0x21))) return hr;
+    if (FAILED(hr = md_buf_put_u8(buf, COMMENT_EXT_FUNC_CODE))) return hr;
+    while (at < len)
+    {
+#ifdef SG_MUTANT_MDS_GIF_COMMENT_UNSPLIT
+        chunk = min(len - at, 255) == 255 ? 254 : min(len - at, 255);
+#else
+        chunk = min(len - at, 255);
+#endif
+        if (FAILED(hr = md_buf_put_u8(buf, chunk))) return hr;
+        if (FAILED(hr = md_buf_put(buf, str + at, chunk))) return hr;
+        at += chunk;
+    }
+    return md_buf_put_u8(buf, 0);
+}
