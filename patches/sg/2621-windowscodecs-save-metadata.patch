+    ULONG len, cap;
+};
+
+extern HRESULT md_buf_put(struct md_buf *buf, const void *data, ULONG size);
+extern HRESULT md_buf_put_u8(struct md_buf *buf, BYTE value);
+extern HRESULT md_buf_put_u16(struct md_buf *buf, USHORT value, BOOL big_endian);
+extern HRESULT md_buf_put_u32(struct md_buf *buf, ULONG value, BOOL big_endian);
