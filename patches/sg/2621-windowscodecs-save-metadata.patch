+    int i;
+
+    for (i = 0; i < 6 && SUCCEEDED(hr); ++i)
+    {
+        const MetadataItem *item = md_find_item(items, count, names[i]);
+        ULONGLONG v = 0;
+
+        if (item && !md_item_uint(item, &v)) hr = WINCODEC_ERR_UNEXPECTEDMETADATATYPE;
+        if (SUCCEEDED(hr)) hr = i ? md_buf_put_u8(&data, v) : md_buf_put_u16(&data, v, TRUE);
+    }
+    if (SUCCEEDED(hr)) hr = png_chunk_put(buf, "tIME", data.data, data.len);
+    md_buf_free(&data);
+    return hr;
+}
