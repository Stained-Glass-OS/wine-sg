+/* Makes the save and size functions of a handler from its serialiser. */
+#define MD_SERIALIZER(name) \
+    static HRESULT name##_save(IStream *stream, DWORD options, const MetadataItem *items, DWORD count) \
+    { \
+        struct md_buf buf = {0}; \
+        HRESULT hr = name##_serialize(items, count, options, &buf); \
+        if (SUCCEEDED(hr)) hr = md_write_stream(stream, buf.data, buf.len); \
+        md_buf_free(&buf); \
+        return hr; \
+    } \
+    static HRESULT name##_size(const MetadataItem *items, DWORD count, ULARGE_INTEGER *size) \
+    { \
+        struct md_buf buf = {0}; \
+        HRESULT hr = name##_serialize(items, count, 0, &buf); \
+        if (SUCCEEDED(hr)) size->QuadPart = buf.len; \
+        md_buf_free(&buf); \
+        return hr; \
+    }
