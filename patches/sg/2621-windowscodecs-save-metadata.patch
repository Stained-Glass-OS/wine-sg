+/* A chunk as it is stored: length, type, data and the CRC of the type and data. */
+static HRESULT png_chunk_put(struct md_buf *buf, const char *type, const BYTE *data, ULONG size)
+{
+    HRESULT hr;
+    ULONG crc;
+
+    if (FAILED(hr = md_buf_put_u32(buf, size, TRUE))) return hr;
+    if (FAILED(hr = md_buf_put(buf, type, 4))) return hr;
+    if (FAILED(hr = md_buf_put(buf, data, size))) return hr;
+    crc = RtlComputeCrc32(0, (const BYTE *)type, 4);
+    crc = RtlComputeCrc32(crc, data, size);
+#ifdef SG_MUTANT_MDS_PNG_CRC_ZERO
+    crc = 0;
+#endif
+    return md_buf_put_u32(buf, crc, TRUE);
+}
+
+/* Latin-1 text of a keyword or text item. */
+static HRESULT png_item_text(const PROPVARIANT *v, char **text, ULONG *len)
+{
+    ULONG i;
+
+    if (v->vt == VT_LPSTR && v->pszVal)
+    {
+        *len = strlen(v->pszVal);
+        if (!(*text = malloc(*len + 1))) return E_OUTOFMEMORY;
+        memcpy(*text, v->pszVal, *len + 1);
+        return S_OK;
+    }
+    if (v->vt == VT_LPWSTR && v->pwszVal)
+    {
+        *len = lstrlenW(v->pwszVal);
+        if (!(*text = malloc(*len + 1))) return E_OUTOFMEMORY;
+        for (i = 0; i <= *len; ++i)
+            (*text)[i] = v->pwszVal[i] < 256 ? v->pwszVal[i] : '?';
+        return S_OK;
+    }
+    return WINCODEC_ERR_UNEXPECTEDMETADATATYPE;
+}
+
+static HRESULT text_serialize(const MetadataItem *items, DWORD count, DWORD options, struct md_buf *buf)
+{
+    struct md_buf data = {0};
+    char *name = NULL, *value = NULL;
+    ULONG name_len, value_len;
+    HRESULT hr;
+
+    if (!count) return S_OK;
+
+    if (FAILED(hr = png_item_text(&items[0].id, &name, &name_len))) return hr;
+    if (FAILED(hr = png_item_text(&items[0].value, &value, &value_len))) goto done;
+
+    /* the keyword is one to 79 characters */
+#ifndef SG_MUTANT_MDS_PNG_KEYWORD_ANY
+    if (!name_len || name_len > 79)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+#endif
+
+    if (SUCCEEDED(hr = md_buf_put(&data, name, name_len + 1)))
+        hr = md_buf_put(&data, value, value_len);
+    if (SUCCEEDED(hr)) hr = png_chunk_put(buf, "tEXt", data.data, data.len);
+
+done:
+    md_buf_free(&data);
+    free(name);
+    free(value);
+    return hr;
+}
+
+MD_SERIALIZER(text)
+
+static HRESULT gama_serialize(const MetadataItem *items, DWORD count, DWORD options, struct md_buf *buf)
+{
+    const MetadataItem *item = md_find_item(items, count, L"ImageGamma");
+    ULONGLONG gamma = 0;
+    struct md_buf data = {0};
+    HRESULT hr;
+
+    if (item && !md_item_uint(item, &gamma)) return WINCODEC_ERR_UNEXPECTEDMETADATATYPE;
+    if (SUCCEEDED(hr = md_buf_put_u32(&data, gamma, TRUE)))
+        hr = png_chunk_put(buf, "gAMA", data.data, data.len);
+    md_buf_free(&data);
+    return hr;
+}
+
+MD_SERIALIZER(gama)
