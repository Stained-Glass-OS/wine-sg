+/* The IFD (TIFF directory) is written as: the number of entries, the entries sorted by tag,
+ * the offset of the next directory (none), then the values that do not fit into the entry.
+ * Offsets count from the start of the stream, which for Exif is the TIFF header. */
+struct ifd_out
+{
+    BOOL big_endian;
+    int depth;
+};
+
+static void ifd_free_items(MetadataItem *items, DWORD count);
+
+static HRESULT ifd_reader_items(IWICMetadataReader *reader, MetadataItem **items, DWORD *count)
+{
+    UINT n, i;
+    HRESULT hr = S_OK;
+
+    *items = NULL;
+    *count = 0;
+    if (FAILED(hr = IWICMetadataReader_GetCount(reader, &n))) return hr;
+    if (!n) return S_OK;
+    if (!(*items = calloc(n, sizeof(**items)))) return E_OUTOFMEMORY;
+
+    for (i = 0; i < n; ++i)
+    {
+        PropVariantInit(&(*items)[i].schema);
+        PropVariantInit(&(*items)[i].id);
+        PropVariantInit(&(*items)[i].value);
+    }
+    for (i = 0; i < n; ++i)
+    {
+        if (FAILED(hr = IWICMetadataReader_GetValueByIndex(reader, i, &(*items)[i].schema,
+                &(*items)[i].id, &(*items)[i].value)))
+            break;
+    }
+    if (FAILED(hr))
+    {
+        ifd_free_items(*items, n);
+        *items = NULL;
+        return hr;
+    }
+    *count = n;
+    return S_OK;
+}
+
+static void ifd_free_items(MetadataItem *items, DWORD count)
+{
+    DWORD i;
+
+    for (i = 0; i < count; ++i)
+    {
+        PropVariantClear(&items[i].schema);
+        PropVariantClear(&items[i].id);
+        PropVariantClear(&items[i].value);
+    }
+    free(items);
+}
+
+struct ifd_value
+{
+    USHORT tag, type;
+    ULONG count;
+    struct md_buf data;       /* the encoded values */
+    IWICMetadataReader *nested;
+};
+
+static HRESULT ifd_encode_value(const PROPVARIANT *v, BOOL be, struct ifd_value *out)
+{
+    VARTYPE base = v->vt & ~VT_VECTOR;
+    BOOL vector = v->vt & VT_VECTOR;
+    ULONG n = 1, i;
+    HRESULT hr = S_OK;
+    const BYTE *bytes;
+
+    switch (base)
+    {
+    case VT_UI1:
+    case VT_I1:
+        out->type = base == VT_UI1 ? IFD_BYTE : IFD_SBYTE;
+        n = vector ? v->caub.cElems : 1;
+        bytes = vector ? v->caub.pElems : &v->bVal;
+        out->count = n;
+        return md_buf_put(&out->data, bytes, n);
+    case VT_UI2:
+    case VT_I2:
+        out->type = base == VT_UI2 ? IFD_SHORT : IFD_SSHORT;
+        n = vector ? v->caui.cElems : 1;
+        for (i = 0; i < n && SUCCEEDED(hr); ++i)
+            hr = md_buf_put_u16(&out->data, vector ? v->caui.pElems[i] : v->uiVal, be);
+        out->count = n;
+        return hr;
+    case VT_UI4:
+    case VT_I4:
+    case VT_R4:
+        out->type = base == VT_UI4 ? IFD_LONG : base == VT_I4 ? IFD_SLONG : IFD_FLOAT;
+        n = vector ? v->caul.cElems : 1;
+        for (i = 0; i < n && SUCCEEDED(hr); ++i)
+            hr = md_buf_put_u32(&out->data, vector ? v->caul.pElems[i] : v->ulVal, be);
+        out->count = n;
+        return hr;
+    case VT_UI8:
+    case VT_I8:
+        out->type = base == VT_UI8 ? IFD_RATIONAL : IFD_SRATIONAL;
+        n = vector ? v->cauh.cElems : 1;
+        for (i = 0; i < n && SUCCEEDED(hr); ++i)
+        {
+            ULARGE_INTEGER q = vector ? v->cauh.pElems[i] : v->uhVal;
+
+            if (SUCCEEDED(hr = md_buf_put_u32(&out->data, q.LowPart, be)))
+                hr = md_buf_put_u32(&out->data, q.HighPart, be);
+        }
+        out->count = n;
+        return hr;
+    case VT_R8:
+        out->type = IFD_DOUBLE;
+        n = vector ? v->cauh.cElems : 1;
+        for (i = 0; i < n && SUCCEEDED(hr); ++i)
+        {
+            ULONGLONG q = vector ? v->cauh.pElems[i].QuadPart : v->uhVal.QuadPart;
+
+            if (be)
+            {
+                if (SUCCEEDED(hr = md_buf_put_u32(&out->data, q >> 32, TRUE)))
+                    hr = md_buf_put_u32(&out->data, q, TRUE);
+            }
+            else
+            {
+                if (SUCCEEDED(hr = md_buf_put_u32(&out->data, q, FALSE)))
+                    hr = md_buf_put_u32(&out->data, q >> 32, FALSE);
+            }
+        }
+        out->count = n;
+        return hr;
+    case VT_LPSTR:
+        if (vector) return WINCODEC_ERR_UNEXPECTEDMETADATATYPE;
+        out->type = IFD_ASCII;
+        n = v->pszVal ? strlen(v->pszVal) + 1 : 1;
+        if (v->pszVal) hr = md_buf_put(&out->data, v->pszVal, n);
+        else hr = md_buf_put_u8(&out->data, 0);
+        out->count = n;
+        return hr;
+    case VT_LPWSTR:
+    {
+        int len;
+        char *ansi;
+
+        if (vector) return WINCODEC_ERR_UNEXPECTEDMETADATATYPE;
+        out->type = IFD_ASCII;
+        len = WideCharToMultiByte(CP_ACP, 0, v->pwszVal ? v->pwszVal : L"", -1, NULL, 0, NULL, NULL);
+        if (!(ansi = malloc(len))) return E_OUTOFMEMORY;
+        WideCharToMultiByte(CP_ACP, 0, v->pwszVal ? v->pwszVal : L"", -1, ansi, len, NULL, NULL);
+        hr = md_buf_put(&out->data, ansi, len);
+        out->count = len;
+        free(ansi);
+        return hr;
+    }
+    case VT_BLOB:
+        if (vector) return WINCODEC_ERR_UNEXPECTEDMETADATATYPE;
+        out->type = IFD_UNDEFINED;
+        out->count = v->blob.cbSize;
+        return md_buf_put(&out->data, v->blob.pBlobData, v->blob.cbSize);
+    default:
+        return WINCODEC_ERR_UNEXPECTEDMETADATATYPE;
+    }
+}
+
+static HRESULT ifd_write(struct md_buf *buf, const MetadataItem *items, DWORD count, struct ifd_out *ctx, ULONG *offset);
+
+static HRESULT ifd_write_items(struct md_buf *buf, const MetadataItem *items, DWORD count, struct ifd_out *ctx,
+        ULONG *offset)
+{
+    struct ifd_value *values;
+    DWORD i, n = 0, j;
+    ULONG start, entries_at;
+    BOOL be = ctx->big_endian;
+    HRESULT hr = S_OK;
+
+    if (ctx->depth > 4) return WINCODEC_ERR_BADMETADATAHEADER;
+
+    if (!(values = calloc(count ? count : 1, sizeof(*values)))) return E_OUTOFMEMORY;
+
+    for (i = 0; i < count && SUCCEEDED(hr); ++i)
+    {
+        struct ifd_value *val = &values[n];
+
+        if (items[i].value.vt == VT_EMPTY) continue;
+        if (items[i].id.vt != VT_UI2) { hr = WINCODEC_ERR_UNEXPECTEDMETADATATYPE; break; }
+        val->tag = items[i].id.uiVal;
+
+        if (items[i].value.vt == VT_UNKNOWN)
+        {
+            IWICMetadataReader *reader;
+
+            if (!items[i].value.punkVal || FAILED(IUnknown_QueryInterface(items[i].value.punkVal,
+                    &IID_IWICMetadataReader, (void **)&reader)))
+            {
+                hr = WINCODEC_ERR_UNEXPECTEDMETADATATYPE;
+                break;
+            }
+            val->type = IFD_LONG;
+            val->count = 1;
+            val->nested = reader;
+        }
+        else
+            hr = ifd_encode_value(&items[i].value, be, val);
+        ++n;
+    }
+
+    /* the entries are sorted by tag */
+#ifndef SG_MUTANT_MDS_IFD_UNSORTED
+    for (i = 1; i < n && SUCCEEDED(hr); ++i)
+    {
+        struct ifd_value tmp = values[i];
+
+        for (j = i; j > 0 && values[j - 1].tag > tmp.tag; --j)
+            values[j] = values[j - 1];
+        values[j] = tmp;
+    }
+#endif
+
+    start = buf->len;
+    entries_at = start + 2;
+    if (SUCCEEDED(hr)) hr = md_buf_put_u16(buf, n, be);
+    for (i = 0; i < n && SUCCEEDED(hr); ++i)
+    {
+        hr = md_buf_put_u16(buf, values[i].tag, be);
+        if (SUCCEEDED(hr)) hr = md_buf_put_u16(buf, values[i].type, be);
+        if (SUCCEEDED(hr)) hr = md_buf_put_u32(buf, values[i].count, be);
+        if (SUCCEEDED(hr)) hr = md_buf_put_u32(buf, 0, be);
+    }
+    if (SUCCEEDED(hr)) hr = md_buf_put_u32(buf, 0, be); /* no next IFD */
+
+    /* values that do not fit the four bytes of the entry go behind the table */
+    for (i = 0; i < n && SUCCEEDED(hr); ++i)
+    {
+        ULONG field = entries_at + i * 12 + 8;
+
+        if (values[i].nested) continue;
+#ifdef SG_MUTANT_MDS_IFD_NO_INLINE
+        if (0)
+#else
+        if (values[i].data.len <= 4)
+#endif
+        {
+            memset(buf->data + field, 0, 4);
+            memcpy(buf->data + field, values[i].data.data, values[i].data.len);
+        }
+        else
+        {
+            ULONG at;
+
+            if (buf->len & 1) hr = md_buf_put_u8(buf, 0);
+            at = buf->len;
+            if (SUCCEEDED(hr)) hr = md_buf_put(buf, values[i].data.data, values[i].data.len);
+            if (SUCCEEDED(hr))
+            {
+                BYTE o[4];
+
+                if (be) { o[0] = at >> 24; o[1] = at >> 16; o[2] = at >> 8; o[3] = at; }
+                else { o[0] = at; o[1] = at >> 8; o[2] = at >> 16; o[3] = at >> 24; }
+                memcpy(buf->data + field, o, 4);
+            }
+        }
+    }
+
+    /* the Exif and GPS directories are directories of their own, after this one */
+    for (i = 0; i < n && SUCCEEDED(hr); ++i)
+    {
+        MetadataItem *nested_items;
+        DWORD nested_count;
+        ULONG nested_at;
+
+        if (!values[i].nested) continue;
+        if (SUCCEEDED(hr = ifd_reader_items(values[i].nested, &nested_items, &nested_count)))
+        {
+            if (buf->len & 1) hr = md_buf_put_u8(buf, 0);
+            ctx->depth++;
+            if (SUCCEEDED(hr)) hr = ifd_write_items(buf, nested_items, nested_count, ctx, &nested_at);
+            ctx->depth--;
+            ifd_free_items(nested_items, nested_count);
+            if (SUCCEEDED(hr))
+            {
+                ULONG field = entries_at + i * 12 + 8;
+                BYTE o[4];
+
+                if (be) { o[0] = nested_at >> 24; o[1] = nested_at >> 16; o[2] = nested_at >> 8; o[3] = nested_at; }
+                else { o[0] = nested_at; o[1] = nested_at >> 8; o[2] = nested_at >> 16; o[3] = nested_at >> 24; }
+                memcpy(buf->data + field, o, 4);
+            }
+        }
+    }
+
+    for (i = 0; i < n; ++i)
+    {
+        md_buf_free(&values[i].data);
+        if (values[i].nested) IWICMetadataReader_Release(values[i].nested);
+    }
+    free(values);
+    if (SUCCEEDED(hr)) *offset = start;
+    return hr;
+}
+
+static HRESULT ifd_write(struct md_buf *buf, const MetadataItem *items, DWORD count, struct ifd_out *ctx, ULONG *offset)
+{
+    return ifd_write_items(buf, items, count, ctx, offset);
+}
+
+static BOOL ifd_big_endian(DWORD options)
+{
+    return (options & WICPersistOptionBigEndian) != 0;
+}
+
+static HRESULT ifd_serialize(const MetadataItem *items, DWORD count, DWORD options, struct md_buf *buf)
+{
+    struct ifd_out ctx = { ifd_big_endian(options), 0 };
+    ULONG offset;
+
+    return ifd_write(buf, items, count, &ctx, &offset);
+}
+
+MD_SERIALIZER(ifd)
+
+/* Exif data in a JPEG's APP1 segment: "Exif" and two zeros, the TIFF header, the IFD. */
+static HRESULT app1_serialize(const MetadataItem *items, DWORD count, DWORD options, struct md_buf *buf)
+{
+    static const BYTE exif_sig[6] = { 'E', 'x', 'i', 'f', 0, 0 };
+    struct ifd_out ctx = { ifd_big_endian(options), 0 };
+    struct md_buf tiff = {0};
+    MetadataItem *ifd_items = NULL;
+    DWORD ifd_count = 0, i;
+    ULONG offset;
+    HRESULT hr;
+
+    for (i = 0; i < count; ++i)
+    {
+        IWICMetadataReader *ifd;
+
+        if (items[i].value.vt != VT_UNKNOWN || !items[i].value.punkVal) continue;
+        if (FAILED(IUnknown_QueryInterface(items[i].value.punkVal, &IID_IWICMetadataReader, (void **)&ifd)))
+            continue;
+        hr = ifd_reader_items(ifd, &ifd_items, &ifd_count);
+        IWICMetadataReader_Release(ifd);
+        if (FAILED(hr)) return hr;
+        break;
+    }
+
+    if (SUCCEEDED(hr = md_buf_put(&tiff, ctx.big_endian ? "MM" : "II", 2))
+            && SUCCEEDED(hr = md_buf_put_u16(&tiff, 42, ctx.big_endian))
+            && SUCCEEDED(hr = md_buf_put_u32(&tiff, 8, ctx.big_endian)))
+    {
+        hr = ifd_write(&tiff, ifd_items, ifd_count, &ctx, &offset);
+    }
+    if (SUCCEEDED(hr))
+    {
+#ifdef SG_MUTANT_MDS_APP1_NO_SIG
+        hr = S_OK;
+#else
+        hr = md_buf_put(buf, exif_sig, sizeof(exif_sig));
+#endif
+        if (SUCCEEDED(hr)) hr = md_buf_put(buf, tiff.data, tiff.len);
+    }
+    ifd_free_items(ifd_items, ifd_count);
+    md_buf_free(&tiff);
+    return hr;
+}
+
+MD_SERIALIZER(app1)
