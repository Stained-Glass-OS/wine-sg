+/* Growable buffer the serialisers write into. */
+static HRESULT md_buf_reserve(struct md_buf *buf, ULONG extra)
+{
+    if (buf->len + extra > buf->cap)
+    {
+        ULONG cap = max(buf->cap * 2, buf->len + extra + 64);
+        BYTE *data = realloc(buf->data, cap);
+
+        if (!data) return E_OUTOFMEMORY;
+        buf->data = data;
+        buf->cap = cap;
+    }
+    return S_OK;
+}
+
+HRESULT md_buf_put(struct md_buf *buf, const void *data, ULONG size)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = md_buf_reserve(buf, size))) return hr;
+    if (size) memcpy(buf->data + buf->len, data, size);
+    buf->len += size;
+    return S_OK;
+}
+
+HRESULT md_buf_put_u8(struct md_buf *buf, BYTE value)
+{
+    return md_buf_put(buf, &value, 1);
+}
+
+HRESULT md_buf_put_u16(struct md_buf *buf, USHORT value, BOOL big_endian)
+{
+    BYTE b[2];
+
+    if (big_endian) { b[0] = value >> 8; b[1] = value; }
+    else { b[0] = value; b[1] = value >> 8; }
+    return md_buf_put(buf, b, 2);
+}
+
+HRESULT md_buf_put_u32(struct md_buf *buf, ULONG value, BOOL big_endian)
+{
+    BYTE b[4];
+
+    if (big_endian) { b[0] = value >> 24; b[1] = value >> 16; b[2] = value >> 8; b[3] = value; }
+    else { b[0] = value; b[1] = value >> 8; b[2] = value >> 16; b[3] = value >> 24; }
+    return md_buf_put(buf, b, 4);
+}
+
+void md_buf_free(struct md_buf *buf)
+{
+    free(buf->data);
+    memset(buf, 0, sizeof(*buf));
+}
+
+HRESULT md_write_stream(IStream *stream, const BYTE *data, ULONG size)
+{
+    ULONG written;
+    HRESULT hr;
+
+    if (!size) return S_OK;
+    hr = IStream_Write(stream, data, size, &written);
+    if (SUCCEEDED(hr) && written != size) hr = E_FAIL;
+    return hr;
+}
+
+/* The item whose identifier is a string, ignoring case. */
+const MetadataItem *md_find_item(const MetadataItem *items, DWORD count, const WCHAR *name)
+{
+    DWORD i;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (items[i].id.vt == VT_LPWSTR && items[i].id.pwszVal && !_wcsicmp(items[i].id.pwszVal, name))
+            return &items[i];
+    }
+    return NULL;
+}
+
+BOOL md_item_uint(const MetadataItem *item, ULONGLONG *value)
+{
+    const PROPVARIANT *v;
+
+    if (!item) return FALSE;
+    v = &item->value;
+    switch (v->vt)
+    {
+        case VT_UI1: *value = v->bVal; return TRUE;
+        case VT_I1: *value = (BYTE)v->cVal; return TRUE;
+        case VT_UI2: *value = v->uiVal; return TRUE;
+        case VT_I2: *value = (USHORT)v->iVal; return TRUE;
+        case VT_UI4: *value = v->ulVal; return TRUE;
+        case VT_I4: *value = (ULONG)v->lVal; return TRUE;
+        case VT_UI8: *value = v->uhVal.QuadPart; return TRUE;
+        case VT_I8: *value = v->hVal.QuadPart; return TRUE;
+        case VT_BOOL: *value = v->boolVal ? 1 : 0; return TRUE;
+        default: return FALSE;
+    }
+}
