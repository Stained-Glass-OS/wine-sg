From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, win32u: the pointer takes the size of a new display scale

The pointer over a Windows program kept the size it had when the program
started after the display scale changed (0890): 24 px at 175%, while over
a Linux program it grew (sg-session sets Xcursor.size, GTK's cursor size).
Wine draws the system cursors from the X cursor theme, at the size the
process read when it opened the display, and caches each one. Now, once in
each process that sees the new scale, win32u tells the driver
(SPI_SETCURSORS with the new DPI); winex11 sets the theme's size for it
(the size it started with, scaled from the scale it started at) and loads
each system cursor it has made again at that size, handing the X server
the new picture for the cursor already in use (XFixesChangeCursor), as the
window under the pointer is not asked for its cursor again.

At 100% with nothing changing, nothing changes.

Test: test/dpifollow-gate.sh part 4 (mutant SG_MUTANT_CURSOR_FIXED in
x11drv_main.c).
---
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -6680,6 +6680,16 @@ void window_check_dpi_change( HWND hwnd )
     TRACE( "%p context %#x monitor dpi %u -> %u\n", hwnd, context, old_dpi, new_dpi );
     /* a per-monitor aware process: what Wine draws for it at the new scale too */
     follow_display_scale( new_dpi );
+    {
+        /* and the pointer: the system cursors at the new scale's size, once
+         * in each process (winex11: the X cursor theme's) */
+        static UINT cursors_dpi;
+        if (cursors_dpi != new_dpi)
+        {
+            cursors_dpi = new_dpi;
+            user_driver->pSystemParametersInfo( SPI_SETCURSORS, new_dpi, NULL, 0 );
+        }
+    }
     thread_context = set_thread_dpi_awareness_context( context );
 
     if (NTUSER_DPI_CONTEXT_IS_MONITOR_AWARE( context ))
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -45,8 +45,14 @@ MAKE_FUNCPTR(XcursorImagesCreate);
 MAKE_FUNCPTR(XcursorImagesDestroy);
 MAKE_FUNCPTR(XcursorImagesLoadCursor);
 MAKE_FUNCPTR(XcursorLibraryLoadCursor);
+MAKE_FUNCPTR(XcursorGetDefaultSize);
+MAKE_FUNCPTR(XcursorSetDefaultSize);
 # undef MAKE_FUNCPTR
 #endif /* SONAME_LIBXCURSOR */
+#ifdef SONAME_LIBXFIXES
+# include <X11/extensions/Xfixes.h>
+static typeof(XFixesChangeCursor) *pXFixesChangeCursor;
+#endif
 
 #define OEMRESOURCE
 
@@ -137,6 +143,27 @@ MAKE_FUNCPTR(XISelectEvents);
 #undef MAKE_FUNCPTR
 #endif
 
+/* Stained Glass OS: the system cursors drawn from the X cursor theme
+ * (create_xcursor_system_cursor), by handle, so that a new display scale
+ * gives them the theme's size for it (x11drv_scale_system_cursors) */
+static pthread_mutex_t theme_cursor_mutex = PTHREAD_MUTEX_INITIALIZER;
+static HCURSOR theme_cursors[64];
+static int nb_theme_cursors;
+static int theme_cursor_size;   /* the theme's size the process started with */
+static UINT theme_cursor_dpi;   /* and the display scale that goes with it */
+static UINT theme_cursor_now;   /* the scale the cursors are at now */
+
+static void remember_theme_cursor( HCURSOR handle )
+{
+    int i;
+
+    pthread_mutex_lock( &theme_cursor_mutex );
+    for (i = 0; i < nb_theme_cursors; i++) if (theme_cursors[i] == handle) break;
+    if (i == nb_theme_cursors && nb_theme_cursors < ARRAY_SIZE(theme_cursors))
+        theme_cursors[nb_theme_cursors++] = handle;
+    pthread_mutex_unlock( &theme_cursor_mutex );
+}
+
 /***********************************************************************
  *		X11DRV_Xcursor_Init
  *
@@ -160,8 +187,17 @@ void X11DRV_Xcursor_Init(void)
     LOAD_FUNCPTR(XcursorImagesDestroy);
     LOAD_FUNCPTR(XcursorImagesLoadCursor);
     LOAD_FUNCPTR(XcursorLibraryLoadCursor);
+    LOAD_FUNCPTR(XcursorGetDefaultSize);
+    LOAD_FUNCPTR(XcursorSetDefaultSize);
 #undef LOAD_FUNCPTR
 #endif /* SONAME_LIBXCURSOR */
+#ifdef SONAME_LIBXFIXES
+    {
+        void *xfixes = dlopen( SONAME_LIBXFIXES, RTLD_NOW );
+        if (xfixes) pXFixesChangeCursor = dlsym( xfixes, "XFixesChangeCursor" );
+    }
+#endif
+    theme_cursor_dpi = NtUserGetSystemDpiForProcess( NULL );
 }
 
 
@@ -1517,6 +1553,7 @@ static Cursor create_cursor( HANDLE handle )
     {
         NtGdiDeleteObjectApp( info.hbmColor );
         NtGdiDeleteObjectApp( info.hbmMask );
+        remember_theme_cursor( handle );
         return cursor;
     }
 
@@ -2461,3 +2498,55 @@ BOOL X11DRV_GenericEvent( HWND hwnd, XEvent *xev )
 #endif
     return ret;
 }
+
+
+/***********************************************************************
+ *		x11drv_scale_system_cursors
+ *
+ * Stained Glass OS: the display scale changed while the process runs
+ * (win32u tells the driver, SPI_SETCURSORS with the new DPI). The system
+ * cursors it shows come from the X cursor theme at the size the process
+ * started with -- the pointer stayed small after 100% -> 175% (the Linux
+ * side's grew: Xcursor.size, Gtk/CursorThemeSize). They are loaded again at
+ * the size for the new scale, and each X cursor already in use takes the new
+ * picture where it is (XFixesChangeCursor), as the window under the pointer
+ * is not asked for its cursor again.
+ */
+void x11drv_scale_system_cursors( UINT dpi )
+{
+#if defined(SONAME_LIBXCURSOR) && defined(SONAME_LIBXFIXES)
+    int i, size;
+
+    if (!pXcursorGetDefaultSize || !pXcursorSetDefaultSize || !pXFixesChangeCursor || !dpi) return;
+    pthread_mutex_lock( &theme_cursor_mutex );
+    if (!theme_cursor_size) theme_cursor_size = pXcursorGetDefaultSize( gdi_display );
+    if (!theme_cursor_dpi) theme_cursor_dpi = USER_DEFAULT_SCREEN_DPI;
+    if (!theme_cursor_now) theme_cursor_now = theme_cursor_dpi;
+    if (dpi == theme_cursor_now || theme_cursor_size <= 0)
+    {
+        pthread_mutex_unlock( &theme_cursor_mutex );
+        return;
+    }
+    theme_cursor_now = dpi;
+    size = (theme_cursor_size * dpi + theme_cursor_dpi / 2) / theme_cursor_dpi;
+    TRACE( "theme cursor size %d (started %d at %u dpi) for %u dpi\n", size, theme_cursor_size, theme_cursor_dpi, dpi );
+    XLockDisplay( gdi_display );
+    pXcursorSetDefaultSize( gdi_display, size );
+    for (i = 0; i < nb_theme_cursors; i++)
+    {
+        ICONINFOEXW info;
+        Cursor old, new;
+
+        if (XFindContext( gdi_display, (XID)theme_cursors[i], cursor_context, (char **)&old )) continue;
+        if (!get_icon_info( theme_cursors[i], &info )) continue;
+        NtGdiDeleteObjectApp( info.hbmColor );
+        NtGdiDeleteObjectApp( info.hbmMask );
+        if (!(new = create_xcursor_system_cursor( &info ))) continue;
+        pXFixesChangeCursor( gdi_display, new, old );
+        XFreeCursor( gdi_display, new );
+    }
+    XUnlockDisplay( gdi_display );
+    XFlush( gdi_display );
+    pthread_mutex_unlock( &theme_cursor_mutex );
+#endif
+}
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -257,6 +257,7 @@ extern void X11DRV_ThreadDetach(void);
 /* X11 driver internal functions */
 
 extern void X11DRV_Xcursor_Init(void);
+extern void x11drv_scale_system_cursors( UINT dpi );
 
 extern DWORD copy_image_bits( BITMAPINFO *info, BOOL is_r8g8b8, XImage *image,
                               const struct gdi_image_bits *src_bits, struct gdi_image_bits *dst_bits,
--- a/dlls/winex11.drv/x11drv_main.c
+++ b/dlls/winex11.drv/x11drv_main.c
@@ -785,6 +785,13 @@ BOOL X11DRV_SystemParametersInfo( UINT action, UINT int_param, void *ptr_param,
 {
     switch (action)
     {
+    case SPI_SETCURSORS:
+        /* Stained Glass OS: a new display scale (win32u passes its DPI): the
+         * system cursors at the X cursor theme's size for it */
+#ifndef SG_MUTANT_CURSOR_FIXED
+        if (int_param >= USER_DEFAULT_SCREEN_DPI && !ptr_param) x11drv_scale_system_cursors( int_param );
+#endif
+        break;
     case SPI_GETSCREENSAVEACTIVE:
         if (ptr_param)
         {
