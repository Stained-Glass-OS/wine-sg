 static HRESULT WINAPI file_stream_CopyTo(IStream *iface, IStream *dest, ULARGE_INTEGER size,
         ULARGE_INTEGER *read_size, ULARGE_INTEGER *write_size)
 {
     struct file_stream *This = file_stream_from_IStream(iface);
-    FIXME("(%p): stub\n", This);
-    return E_NOTIMPL;
+
+    ULARGE_INTEGER total_read = {0}, total_written = {0};
+    HRESULT hr = S_OK;
+    BYTE buffer[4096];
+
+    TRACE("(%p, %p, %I64u, %p, %p)\n", This, dest, size.QuadPart, read_size, write_size);
+
+    if (!dest) return STG_E_INVALIDPOINTER;
+
+    while (size.QuadPart)
+    {
+        ULONG count = min(size.QuadPart, sizeof(buffer)), read, written;
+
+        if (FAILED(hr = IStream_Read(iface, buffer, count, &read)) || !read) break;
+        total_read.QuadPart += read;
+
+        if (FAILED(hr = IStream_Write(dest, buffer, read, &written))) break;
+        total_written.QuadPart += written;
+        if (written != read)
+        {
+            hr = STG_E_MEDIUMFULL;
+            break;
+        }
+#ifdef SG_MUTANT_STREAM_COPYTO
+        total_read.QuadPart = total_written.QuadPart = 0;
+        break;
+#endif
+        size.QuadPart -= read;
+    }
+
+    if (read_size) *read_size = total_read;
+    if (write_size) *write_size = total_written;
+    return SUCCEEDED(hr) ? S_OK : hr;
 }
 
