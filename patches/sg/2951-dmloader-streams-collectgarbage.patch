From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dmloader: stream methods of the loader and file streams, CollectGarbage

- The loader's stream (the IStream handed to IPersistStream::Load) wraps
  the file or memory stream: Write, SetSize, CopyTo, Commit, Revert,
  LockRegion, UnlockRegion and Stat now go to the wrapped stream.
- The file stream is read-only: Write and SetSize are STG_E_ACCESSDENIED,
  Commit and Revert S_OK (nothing is buffered), LockRegion and
  UnlockRegion STG_E_INVALIDFUNCTION, CopyTo copies from the current
  position, Stat reports a stream with the file size, times and name.
- IDirectMusicLoader8::CollectGarbage releases the cached objects that
  nothing but the cache still references.
---
Not currently on any branch.
nothing to commit, working tree clean
diff --git a/dlls/dmloader/loader.c b/dlls/dmloader/loader.c
index 3798a08..453cceb 100644
--- a/dlls/dmloader/loader.c
+++ b/dlls/dmloader/loader.c
@@ -811,7 +811,30 @@ static HRESULT WINAPI loader_EnumObject(IDirectMusicLoader8 *iface, REFGUID rgui
 
 static void WINAPI loader_CollectGarbage(IDirectMusicLoader8 *iface)
 {
-    FIXME("(%p)->(): stub\n", iface);
+    struct loader *This = impl_from_IDirectMusicLoader8(iface);
+    struct cache_entry *entry;
+
+    TRACE("(%p)\n", This);
+
+#ifdef SG_MUTANT_GC_NONE
+    return;
+#endif
+    /* objects which only the cache still references are released */
+    LIST_FOR_EACH_ENTRY(entry, &This->cache, struct cache_entry, entry)
+    {
+        if (!entry->pObject) continue;
+
+        IDirectMusicObject_AddRef(entry->pObject);
+#ifdef SG_MUTANT_GC_ALWAYS
+        IDirectMusicObject_Release(entry->pObject);
+#else
+        if (IDirectMusicObject_Release(entry->pObject) > 1) continue;
+#endif
+
+        IDirectMusicObject_Release(entry->pObject);
+        entry->pObject = NULL;
+        entry->Desc.dwValidData &= ~DMUS_OBJ_LOADED;
+    }
 }
 
 static HRESULT WINAPI loader_ReleaseObjectByUnknown(IDirectMusicLoader8 *iface, IUnknown *pObject)
