 static HRESULT WINAPI file_stream_Stat(IStream *iface, STATSTG *stat, DWORD flags)
 {
     struct file_stream *This = file_stream_from_IStream(iface);
-    FIXME("(%p): stub\n", This);
+
+    LARGE_INTEGER size;
+    FILETIME ctime, atime, mtime;
+
+    TRACE("(%p, %p, %#lx)\n", This, stat, flags);
+
+    if (!stat) return STG_E_INVALIDPOINTER;
+    memset(stat, 0, sizeof(*stat));
+#ifdef SG_MUTANT_STREAM_STAT
     return E_NOTIMPL;
+#endif
+
+    if (!GetFileSizeEx(This->file, &size) || !GetFileTime(This->file, &ctime, &atime, &mtime))
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    if (!(flags & STATFLAG_NONAME))
+    {
+        if (!(stat->pwcsName = CoTaskMemAlloc((wcslen(This->path) + 1) * sizeof(WCHAR)))) return STG_E_INSUFFICIENTMEMORY;
+        wcscpy(stat->pwcsName, This->path);
+    }
+    stat->type = STGTY_STREAM;
+    stat->cbSize.QuadPart = size.QuadPart;
+    stat->mtime = mtime;
+    stat->ctime = ctime;
+    stat->atime = atime;
+    stat->grfMode = STGM_READ | STGM_SHARE_DENY_NONE;
+    return S_OK;
 }
 
