From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: SeLocateProcessImageName and IoGetRelatedDeviceObject.

SeLocateProcessImageName returned STATUS_NOT_IMPLEMENTED; it now returns the
process's image name in one allocation (a UNICODE_STRING followed by the
text, freed with ExFreePool), STATUS_NOT_FOUND when there is none.
IoGetRelatedDeviceObject returned NULL; it returns the highest device
attached to the device the file object was opened on.

Gate: test/ntoskrnl-procname-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -2033,8 +2033,15 @@
  */
 PDEVICE_OBJECT WINAPI IoGetRelatedDeviceObject( PFILE_OBJECT obj )
 {
-    FIXME( "stub: %p\n", obj );
-    return NULL;
+    TRACE( "%p\n", obj );
+
+    /* the file was opened on a device; requests go to the highest device attached to it */
+    if (!obj || !obj->DeviceObject) return NULL;
+#ifdef SG_MUTANT_RELATED_NO_ATTACHED
+    return obj->DeviceObject;
+#else
+    return IoGetAttachedDevice( obj->DeviceObject );
+#endif
 }
 
 static CONFIGURATION_INFORMATION configuration_information;
@@ -4966,9 +4973,44 @@
  */
 NTSTATUS WINAPI SeLocateProcessImageName(PEPROCESS process, UNICODE_STRING **image_name)
 {
-    FIXME("stub: %p %p\n", process, image_name);
-    if (image_name) *image_name = NULL;
-    return STATUS_NOT_IMPLEMENTED;
+    ULONG size = sizeof(UNICODE_STRING) + MAX_PATH * sizeof(WCHAR), needed;
+    UNICODE_STRING *name;
+    NTSTATUS status;
+    HANDLE handle;
+
+    TRACE( "%p %p\n", process, image_name );
+
+    if (!process || !image_name) return STATUS_INVALID_PARAMETER;
+    *image_name = NULL;
+
+    if ((status = ObOpenObjectByPointer( process, OBJ_KERNEL_HANDLE, NULL, PROCESS_QUERY_LIMITED_INFORMATION,
+                                         NULL, KernelMode, &handle )))
+        return status;
+
+    for (;;)
+    {
+        if (!(name = ExAllocatePool( PagedPool, size )))
+        {
+            NtClose( handle );
+            return STATUS_NO_MEMORY;
+        }
+        needed = 0;
+        status = NtQueryInformationProcess( handle, ProcessImageFileName, name, size, &needed );
+        if (status != STATUS_INFO_LENGTH_MISMATCH && status != STATUS_BUFFER_TOO_SMALL) break;
+        ExFreePool( name );
+        size = needed > size ? needed : size * 2;
+    }
+    NtClose( handle );
+#ifdef SG_MUTANT_SELOCATE_NOTFOUND
+    status = STATUS_NOT_FOUND;
+#endif
+    if (status || !name->Length)
+    {
+        ExFreePool( name );
+        return STATUS_NOT_FOUND;
+    }
+    *image_name = name;
+    return STATUS_SUCCESS;
 }
 
