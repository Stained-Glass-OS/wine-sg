From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: GdipConvertToEmfPlus

GdipConvertToEmfPlus (a stub returning NotImplemented) records an enhanced
metafile again as a metafile of the type asked for: a new recording with the
frame of the source whose GDI records are played in through a device
context, so an EMF+ recording holds them behind a GetDC record. The success
flag is set; a metafile that is still being recorded converts to an empty
recording; one that is already EMF+ stays InvalidParameter. Removes the two
todo_wine marks of the conversion test.
---
--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -4515,12 +4515,79 @@ GpStatus WINGDIPAPI GdipSetMetafileDownLevelRasterizationLimit(GpMetafile *metaf
     return Ok;
 }
 
+
+/* The EMF is recorded again as a metafile of the type asked for: its GDI records are played into the new
+ * recording through a device context, so an EMF+ recording holds them behind a GetDC record, as a program
+ * that draws with GDI on a GDI+ graphics object leaves them. */
+static GpStatus convert_to_emfplus(const GpGraphics *ref, GpMetafile *metafile, BOOL *succ, EmfType type,
+        const WCHAR *description, GpMetafile **out)
+{
+    GpMetafile *recorded;
+    GpGraphics *graphics;
+    MetafileHeader header;
+    HDC ref_dc, dc;
+    GpRectF frame;
+    RECT rect;
+    GpStatus stat;
+
+    /* a metafile still being recorded has no records to take over yet */
+    if (!metafile->hemf && !metafile->record_dc)
+        return InvalidParameter;
+    if (metafile->hemf)
+    {
+        if ((stat = GdipGetMetafileHeaderFromEmf(metafile->hemf, &header)) != Ok)
+            return stat;
+    }
+    else
+    {
+        header.X = metafile->bounds.X;
+        header.Y = metafile->bounds.Y;
+        header.Width = metafile->bounds.Width;
+        header.Height = metafile->bounds.Height;
+    }
+
+    if (!(ref_dc = CreateCompatibleDC(0)))
+        return OutOfMemory;
+    frame.X = header.X;
+    frame.Y = header.Y;
+    frame.Width = header.Width;
+    frame.Height = header.Height;
+    stat = GdipRecordMetafile(ref_dc, type, &frame, MetafileFrameUnitPixel, description, &recorded);
+    DeleteDC(ref_dc);
+    if (stat != Ok)
+        return stat;
+
+    if ((stat = GdipGetImageGraphicsContext((GpImage *)recorded, &graphics)) == Ok)
+    {
+        if ((stat = GdipGetDC(graphics, &dc)) == Ok)
+        {
+            SetRect(&rect, header.X, header.Y, header.X + header.Width, header.Y + header.Height);
+#ifndef SG_MUTANT_GP_CONVERT_NO_PLAY
+            if (metafile->hemf)
+                PlayEnhMetaFile(dc, metafile->hemf, &rect);
+#endif
+            GdipReleaseDC(graphics, dc);
+        }
+        GdipDeleteGraphics(graphics);
+    }
+    if (stat != Ok)
+    {
+        GdipDisposeImage((GpImage *)recorded);
+        return stat;
+    }
+
+#ifndef SG_MUTANT_GP_CONVERT_NO_SUCC
+    if (succ)
+        *succ = TRUE;
+#endif
+    *out = recorded;
+    return Ok;
+}
+
 GpStatus WINGDIPAPI GdipConvertToEmfPlus(const GpGraphics* ref,
     GpMetafile* metafile, BOOL* succ, EmfType emfType,
     const WCHAR* description, GpMetafile** out_metafile)
 {
-    static int calls;
-
     TRACE("(%p,%p,%p,%u,%s,%p)\n", ref, metafile, succ, emfType,
         debugstr_w(description), out_metafile);
 
@@ -4537,10 +4604,7 @@ GpStatus WINGDIPAPI GdipConvertToEmfPlus(const GpGraphics* ref,
         *succ = FALSE;
     *out_metafile = NULL;
 
-    if(!(calls++))
-        FIXME("not implemented\n");
-
-    return NotImplemented;
+    return convert_to_emfplus(ref, metafile, succ, emfType, description, out_metafile);
 }
 
 GpStatus WINGDIPAPI GdipEmfToWmfBits(HENHMETAFILE hemf, UINT cbData16,
--- a/dlls/gdiplus/tests/metafile.c
+++ b/dlls/gdiplus/tests/metafile.c
@@ -2006,13 +2006,13 @@ static void test_converttoemfplus(void)
     expect(InvalidParameter, stat);
 
     stat = pGdipConvertToEmfPlus(graphics, metafile, NULL, EmfTypeEmfPlusOnly, NULL, &metafile2);
-    todo_wine expect(Ok, stat);
+    expect(Ok, stat);
     if(metafile2)
         GdipDisposeImage((GpImage*)metafile2);
 
     succ = FALSE;
     stat = pGdipConvertToEmfPlus(graphics, metafile, &succ, EmfTypeEmfPlusOnly, NULL, &metafile2);
-    todo_wine expect(Ok, stat);
+    expect(Ok, stat);
     if(metafile2)
         GdipDisposeImage((GpImage*)metafile2);
 
