From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dxdiagn: Unknown class requests warn and clear the pointer.


---
 dlls/dxdiagn/dxdiag_main.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/dlls/dxdiagn/dxdiag_main.c b/dlls/dxdiagn/dxdiag_main.c
index 0198508..9761035 100644
--- a/dlls/dxdiagn/dxdiag_main.c
+++ b/dlls/dxdiagn/dxdiag_main.c
@@ -148,6 +148,8 @@ HRESULT WINAPI DllGetClassObject(REFCLSID rclsid, REFIID riid, LPVOID *ppv)
       return S_OK;
     }
 
-    FIXME("(%s,%s,%p): no interface found.\n", debugstr_guid(rclsid), debugstr_guid(riid), ppv);
+    /* the provider is this DLL's only class */
+    WARN("(%s,%s,%p): no interface found.\n", debugstr_guid(rclsid), debugstr_guid(riid), ppv);
+    *ppv = NULL;
     return CLASS_E_CLASSNOTAVAILABLE;
 }
