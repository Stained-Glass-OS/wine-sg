From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: the Status column of cloud files

File Explorer showed nothing of a cloud provider's files' state. A file system folder now has a Status column (System.StorageProviderUIStatus), on by default in a sync root a provider registered (OneDrive's folder) and available elsewhere, saying what the Cloud Filter API knows of each placeholder: "Sync pending" when not in sync, "Always available on this device" when pinned, "Available on this device" when all of it is on disk, "Available when online" when it is not; System.StorageProviderState gives the same as a number. A file that is no placeholder shows nothing.
---
diff --git a/dlls/shell32/shell32.rc b/dlls/shell32/shell32.rc
index 64235a3..b1eddbf 100644
--- a/dlls/shell32/shell32.rc
+++ b/dlls/shell32/shell32.rc
@@ -535,6 +535,10 @@ STRINGTABLE
     IDS_FORMAT_NOADMIN          "You must be an administrator to format a disk."
     IDS_NETADDR_ERROR_TITLE     "Invalid address"
     IDS_NETADDR_ERROR_TEXT      "The text is not a valid network address."
+    IDS_SYNC_ONLINE_ONLY "Available when online"
+    IDS_SYNC_LOCAL "Available on this device"
+    IDS_SYNC_PINNED "Always available on this device"
+    IDS_SYNC_PENDING "Sync pending"
 }
 
 LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
diff --git a/dlls/shell32/shfldr_fs.c b/dlls/shell32/shfldr_fs.c
index 908fab8..07f117f 100644
--- a/dlls/shell32/shfldr_fs.c
+++ b/dlls/shell32/shfldr_fs.c
@@ -76,6 +76,10 @@ typedef struct {
 
 static UINT cfShellIDList;
 
+static const GUID FMTID_StorageProvider = { 0xe77e90df, 0x6271, 0x4f5b, { 0x83, 0x4f, 0x2d, 0xd1, 0xf2, 0x45, 0xdd, 0xa4 } };
+#define PID_STORAGE_PROVIDER_UI_STATUS 2
+#define PID_STORAGE_PROVIDER_STATE 3
+
 static inline IGenericSFImpl *impl_from_IUnknown(IUnknown *iface)
 {
     return CONTAINING_RECORD(iface, IGenericSFImpl, IUnknown_inner);
@@ -193,9 +197,156 @@ static const shvheader GenericSFHeader[] =
     { &FMTID_Storage, PID_STG_SIZE,        IDS_SHV_COLUMN2, SHCOLSTATE_TYPE_STR | SHCOLSTATE_ONBYDEFAULT,  LVCFMT_RIGHT,  8 },
     /* Stained Glass: Windows' order; attributes are available but not shown */
     { &FMTID_Storage, PID_STG_ATTRIBUTES,  IDS_SHV_COLUMN5, SHCOLSTATE_TYPE_STR,                           LVCFMT_LEFT,   5 },
+    /* Stained Glass OS 6246: a cloud file's status (System.StorageProviderUIStatus), shown in sync roots */
+    { &FMTID_StorageProvider, PID_STORAGE_PROVIDER_UI_STATUS, IDS_SHV_COL_STATUS, SHCOLSTATE_TYPE_STR,     LVCFMT_LEFT,  20 },
 };
 
-#define GENERICSHELLVIEWCOLUMNS 5
+#define GENERICSHELLVIEWCOLUMNS 6
+#define STATUS_COLUMN 5
+
+/* ---- a cloud file's status (Stained Glass OS 6246) ----
+ * A folder in a sync root a provider registered (OneDrive's folder) shows its files' status as File
+ * Explorer does on Windows, read from the Cloud Filter API: "Sync pending" for a placeholder not in
+ * sync, "Always available on this device" for a pinned one, "Available on this device" when all of it
+ * is on disk, "Available when online" when it is not. */
+
+static BOOL path_is_under( const WCHAR *root, const WCHAR *path )
+{
+    size_t len = wcslen( root );
+
+    while (len > 3 && root[len - 1] == '\\') len--;
+    return len && !wcsnicmp( root, path, len ) && (!path[len] || path[len] == '\\');
+}
+
+static BOOL sync_root_values( HKEY key, const WCHAR *path )
+{
+    WCHAR name[256], value[MAX_PATH];
+    DWORD i, name_len, size, type;
+    BOOL found = FALSE;
+
+    for (i = 0; !found; i++)
+    {
+        name_len = ARRAY_SIZE(name);
+        size = sizeof(value);
+        if (RegEnumValueW( key, i, name, &name_len, NULL, &type, (BYTE *)value, &size )) break;
+        if (type == REG_SZ && size >= sizeof(WCHAR) && value[0]) found = path_is_under( value, path );
+    }
+    return found;
+}
+
+/* is the folder in a registered sync root (cldapi's Path value, or Windows' UserSyncRoots values) */
+static BOOL in_sync_root( const WCHAR *path )
+{
+    static const HKEY roots[] = { HKEY_CURRENT_USER, HKEY_LOCAL_MACHINE };
+    WCHAR name[256], value[MAX_PATH];
+    unsigned int r;
+    BOOL found = FALSE;
+    DWORD i, len, size;
+    HKEY key, sub, users;
+
+    if (!path || !path[0]) return FALSE;
+    for (r = 0; r < ARRAY_SIZE(roots) && !found; r++)
+    {
+        if (RegOpenKeyExW( roots[r], L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\SyncRootManager",
+                           0, KEY_READ, &key )) continue;
+        for (i = 0; !found; i++)
+        {
+            len = ARRAY_SIZE(name);
+            if (RegEnumKeyExW( key, i, name, &len, NULL, NULL, NULL, NULL )) break;
+            if (RegOpenKeyExW( key, name, 0, KEY_READ, &sub )) continue;
+            size = sizeof(value);
+            if (!RegGetValueW( sub, NULL, L"Path", RRF_RT_REG_SZ, NULL, value, &size ) && path_is_under( value, path ))
+                found = TRUE;
+            if (!found && !RegOpenKeyExW( sub, L"UserSyncRoots", 0, KEY_READ, &users ))
+            {
+                found = sync_root_values( users, path );
+                RegCloseKey( users );
+            }
+            RegCloseKey( sub );
+        }
+        RegCloseKey( key );
+    }
+    return found;
+}
+
+struct cf_basic { DWORD pin, in_sync; LARGE_INTEGER file_id, root_id; DWORD identity_length; BYTE identity[4]; };
+struct cf_range { LARGE_INTEGER offset, length; };
+
+/* the status of a file: a string id, and System.StorageProviderState's value; 0 for none */
+static UINT cloud_status( const WCHAR *path, DWORD *state )
+{
+    static HRESULT (WINAPI *get_info)( HANDLE, DWORD, void *, DWORD, DWORD * );
+    static HRESULT (WINAPI *get_ranges)( HANDLE, DWORD, LONGLONG, LONGLONG, void *, DWORD, DWORD * );
+    static BOOL looked;
+    BYTE buffer[sizeof(struct cf_basic) + 512];
+    struct cf_basic *basic = (struct cf_basic *)buffer;
+    struct cf_range ranges[16];
+    LARGE_INTEGER size;
+    DWORD ret = 0, i;
+    LONGLONG on_disk = 0;
+    HANDLE file;
+    UINT id;
+
+    *state = 0;
+#ifdef SG_MUTANT_NO_CLOUD_STATUS
+    return 0;
+#endif
+    if (!looked)
+    {
+        HMODULE cldapi = LoadLibraryW( L"cldapi.dll" );
+        if (cldapi)
+        {
+            get_info = (void *)GetProcAddress( cldapi, "CfGetPlaceholderInfo" );
+            get_ranges = (void *)GetProcAddress( cldapi, "CfGetPlaceholderRangeInfo" );
+        }
+        looked = TRUE;
+    }
+    if (!get_info) return 0;
+    file = CreateFileW( path, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL );
+    if (file == INVALID_HANDLE_VALUE) return 0;
+    if (FAILED(get_info( file, 0 /* CF_PLACEHOLDER_INFO_BASIC */, buffer, sizeof(buffer), &ret )))
+    {
+        CloseHandle( file );
+        return 0;
+    }
+    if (!basic->in_sync)
+    {
+        id = IDS_SYNC_PENDING;
+        *state = 4;     /* STORAGE_PROVIDER_STATE_PENDING_UPLOAD */
+    }
+    else if (basic->pin == 1 /* CF_PIN_STATE_PINNED */)
+    {
+        id = IDS_SYNC_PINNED;
+        *state = 3;     /* STORAGE_PROVIDER_STATE_PINNED */
+    }
+    else
+    {
+        id = IDS_SYNC_LOCAL;
+        *state = 2;     /* STORAGE_PROVIDER_STATE_IN_SYNC */
+        if (!(GetFileAttributesW( path ) & FILE_ATTRIBUTE_DIRECTORY) && GetFileSizeEx( file, &size ) && size.QuadPart)
+        {
+            if (get_ranges && SUCCEEDED(get_ranges( file, 1 /* CF_PLACEHOLDER_RANGE_INFO_ONDISK */, 0, size.QuadPart,
+                                                    ranges, sizeof(ranges), &ret )))
+                for (i = 0; i < ret / sizeof(ranges[0]); i++) on_disk += ranges[i].length.QuadPart;
+            if (on_disk < size.QuadPart)
+            {
+                id = IDS_SYNC_ONLINE_ONLY;
+                *state = 1;     /* STORAGE_PROVIDER_STATE_SPARSE */
+            }
+        }
+    }
+    CloseHandle( file );
+    return id;
+}
+
+static BOOL item_path( IGenericSFImpl *This, LPCITEMIDLIST pidl, WCHAR *path )
+{
+    WCHAR name[MAX_PATH];
+
+    if (!pidl || !This->sPathTarget || !_ILSimpleGetTextW( pidl, name, ARRAY_SIZE(name) )) return FALSE;
+    return PathCombineW( path, This->sPathTarget, name ) != NULL;
+}
 
 /**************************************************************************
  *  IShellFolder_fnQueryInterface
@@ -1047,6 +1198,8 @@ IShellFolder_fnGetDefaultColumnState (IShellFolder2 * iface, UINT iColumn,
         return E_INVALIDARG;
 
     *pcsFlags = GenericSFHeader[iColumn].pcsFlags;
+    /* the cloud status: shown in a sync root, available elsewhere */
+    if (iColumn == STATUS_COLUMN && in_sync_root( This->sPathTarget )) *pcsFlags |= SHCOLSTATE_ONBYDEFAULT;
 
     return S_OK;
 }
@@ -1059,6 +1212,18 @@ IShellFolder_fnGetDetailsEx (IShellFolder2 * iface, LPCITEMIDLIST pidl,
 
     TRACE ("(%p)->(%p %p %p)\n", This, pidl, pscid, pv);
 
+    /* System.StorageProviderState: the cloud file's state as a number */
+    if (pscid && pv && pidl && IsEqualGUID(&pscid->fmtid, &FMTID_StorageProvider) && pscid->pid == PID_STORAGE_PROVIDER_STATE)
+    {
+        WCHAR path[MAX_PATH];
+        DWORD state = 0;
+
+        VariantInit(pv);
+        if (!item_path(This, pidl, path) || !cloud_status(path, &state)) return S_OK;
+        V_VT(pv) = VT_UI4;
+        V_UI4(pv) = state;
+        return S_OK;
+    }
     return shellfolder_get_details_ex(iface, This->pidlRoot, pidl, GenericSFHeader, GENERICSHELLVIEWCOLUMNS, pscid, pv);
 }
 
@@ -1075,6 +1240,18 @@ IShellFolder_fnGetDetailsOf (IShellFolder2 * iface, LPCITEMIDLIST pidl,
 
     if (!pidl) return SHELL32_GetColumnDetails(GenericSFHeader, iColumn, psd);
 
+    if (iColumn == STATUS_COLUMN)
+    {
+        WCHAR path[MAX_PATH];
+        DWORD state;
+        UINT id = item_path(This, pidl, path) ? cloud_status(path, &state) : 0;
+
+        psd->str.uType = STRRET_WSTR;
+        if (!(psd->str.pOleStr = CoTaskMemAlloc(128 * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+        psd->str.pOleStr[0] = 0;
+        if (id) LoadStringW(shell32_hInstance, id, psd->str.pOleStr, 128);
+        return S_OK;
+    }
     return shellfolder_get_file_details( iface, pidl, GenericSFHeader, iColumn, psd );
 }
 
diff --git a/dlls/shell32/shresdef.h b/dlls/shell32/shresdef.h
index 19b6de3..2ebdaae 100644
--- a/dlls/shell32/shresdef.h
+++ b/dlls/shell32/shresdef.h
@@ -520,5 +520,10 @@ FIXME: Need to add them, but for now just let them use the same: searching.avi
 #define IDS_FORMAT_NOADMIN         9227
 #define IDS_NETADDR_ERROR_TITLE    9230
 #define IDS_NETADDR_ERROR_TEXT     9231
+/* Stained Glass OS 6246: a cloud file's status */
+#define IDS_SYNC_ONLINE_ONLY       9240
+#define IDS_SYNC_LOCAL             9241
+#define IDS_SYNC_PINNED            9242
+#define IDS_SYNC_PENDING           9243
 
 #endif
