+/* ---- mangled names: the RDN of a conflicting or deleted object has "\nCNF:" or "\nDEL:" and the
+ * object's GUID appended ---- */
+
+static BOOL parse_guid(const WCHAR *str, GUID *guid)
+{
+    unsigned int i;
+    WCHAR *end, hex[3] = { 0 };
+
+    for (i = 0; i < 36; i++)
+    {
+        BOOL dash = i == 8 || i == 13 || i == 18 || i == 23;
+        if (dash ? str[i] != '-' : !iswxdigit(str[i])) return FALSE;
+    }
+    guid->Data1 = wcstoul(str, &end, 16);
+    guid->Data2 = wcstoul(str + 9, &end, 16);
+    guid->Data3 = wcstoul(str + 14, &end, 16);
+    for (i = 0; i < 8; i++)
+    {
+        const WCHAR *src = i < 2 ? str + 19 + i * 2 : str + 24 + (i - 2) * 2;
+        hex[0] = src[0];
+        hex[1] = src[1];
+        guid->Data4[i] = wcstoul(hex, &end, 16);
+    }
+    return TRUE;
+}
