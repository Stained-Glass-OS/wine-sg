+/* the parts of "class/instance:port/service" or "class/service": pointers into spn, lengths */
+struct spn_parts
+{
+    const WCHAR *class, *instance, *service;
+    DWORD class_len, instance_len, service_len;
+    USHORT port;
+};
+
+static DWORD parse_spn(const WCHAR *spn, DWORD len, struct spn_parts *parts)
+{
+    const WCHAR *end = spn + len, *slash1, *slash2, *colon, *p;
+
+    memset(parts, 0, sizeof(*parts));
+    for (slash1 = spn; slash1 < end && *slash1 != '/'; slash1++) ;
+    if (slash1 == spn || slash1 >= end) return ERROR_INVALID_PARAMETER;
+    for (slash2 = slash1 + 1; slash2 < end && *slash2 != '/'; slash2++) ;
+
+    parts->class = spn;
+    parts->class_len = slash1 - spn;
+    if (slash2 < end)
+    {
+        /* class/instance[:port]/service */
+        if (slash2 + 1 >= end) return ERROR_INVALID_PARAMETER;
+        parts->service = slash2 + 1;
+        parts->service_len = end - slash2 - 1;
+        parts->instance = slash1 + 1;
+        parts->instance_len = slash2 - slash1 - 1;
+        for (colon = slash2 - 1; colon > slash1 && *colon != ':'; colon--) ;
+        if (colon > slash1)
+        {
+            ULONG port = 0;
+            if (colon + 1 == slash2) return ERROR_INVALID_PARAMETER;
+            for (p = colon + 1; p < slash2; p++)
+            {
+                if (*p < '0' || *p > '9') return ERROR_INVALID_PARAMETER;
+                port = port * 10 + (*p - '0');
+                if (port > 0xffff) return ERROR_INVALID_PARAMETER;
+            }
+            parts->port = port;
+            parts->instance_len = colon - slash1 - 1;
+        }
+    }
+    else
+    {
+        /* class/service */
+        if (slash1 + 1 >= end) return ERROR_INVALID_PARAMETER;
+        parts->service = slash1 + 1;
+        parts->service_len = end - slash1 - 1;
+        parts->instance = parts->service;
+    }
+    return ERROR_SUCCESS;
+}
+
+static DWORD copy_part(const WCHAR *src, DWORD src_len, DWORD *size, WCHAR *dst, BOOL *overflow)
+{
+    if (!size) return ERROR_SUCCESS;
+    if (*size < src_len + 1 || !dst)
+    {
+        *size = src_len + 1;
+        *overflow = TRUE;
+        return ERROR_SUCCESS;
+    }
+    memcpy(dst, src, src_len * sizeof(WCHAR));
+    dst[src_len] = 0;
+    *size = src_len + 1;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *             DsCrackSpn2W (NTDSAPI.@)
+ */
+DWORD WINAPI DsCrackSpn2W(LPCWSTR spn, DWORD spn_len, LPDWORD class_size, LPWSTR class,
+                          LPDWORD service_size, LPWSTR service, LPDWORD instance_size,
+                          LPWSTR instance, USHORT *port)
+{
+    struct spn_parts parts;
+    BOOL overflow = FALSE;
+    DWORD ret;
+
+    TRACE("(%s,%lu,%p,%p,%p,%p,%p,%p,%p)\n", debugstr_wn(spn, spn_len), spn_len, class_size, class,
+          service_size, service, instance_size, instance, port);
+
+    if (!spn) return ERROR_INVALID_PARAMETER;
+    if ((ret = parse_spn(spn, spn_len, &parts))) return ret;
+    copy_part(parts.class, parts.class_len, class_size, class, &overflow);
+    copy_part(parts.service, parts.service_len, service_size, service, &overflow);
+    if (parts.instance == parts.service)
+    {
+        /* two parts: no instance name */
+        copy_part(L"", 0, instance_size, instance, &overflow);
+    }
+    else copy_part(parts.instance, parts.instance_len, instance_size, instance, &overflow);
+    if (overflow) return ERROR_BUFFER_OVERFLOW;
+    if (port) *port = parts.port;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *             DsCrackSpnW (NTDSAPI.@)
+ */
+DWORD WINAPI DsCrackSpnW(LPCWSTR spn, LPDWORD class_size, LPWSTR class, LPDWORD service_size,
+                         LPWSTR service, LPDWORD instance_size, LPWSTR instance, USHORT *port)
+{
+    if (!spn) return ERROR_INVALID_PARAMETER;
+    return DsCrackSpn2W(spn, lstrlenW(spn), class_size, class, service_size, service, instance_size,
+                        instance, port);
+}
+
+static DWORD crack_spn_a(const char *spn, int spn_len, DWORD *class_size, char *class, DWORD *service_size,
+                         char *service, DWORD *instance_size, char *instance, USHORT *port)
+{
+    WCHAR *wspn, *buf[3];
+    DWORD size[3], ret;
+    struct { DWORD *size; char *dst; } out[3] = { { class_size, class }, { service_size, service },
+                                                  { instance_size, instance } };
+    BOOL overflow = FALSE;
+    int i, n;
+
+    if (!spn) return ERROR_INVALID_PARAMETER;
+    if (spn_len < 0) spn_len = strlen(spn);
+    n = MultiByteToWideChar(CP_ACP, 0, spn, spn_len, NULL, 0);
+    if (!(wspn = HeapAlloc(GetProcessHeap(), 0, (n + 1) * sizeof(WCHAR) * 4))) return ERROR_OUTOFMEMORY;
+    n = MultiByteToWideChar(CP_ACP, 0, spn, spn_len, wspn, n);
+    wspn[n] = 0;
+    /* each part is at most as long as the whole */
+    for (i = 0; i < 3; i++)
+    {
+        buf[i] = wspn + (n + 1) * (i + 1);
+        size[i] = n + 1;
+    }
+    ret = DsCrackSpn2W(wspn, n, class_size ? &size[0] : NULL, buf[0], service_size ? &size[1] : NULL, buf[1],
+                       instance_size ? &size[2] : NULL, buf[2], port);
+    if (!ret)
+    {
+        for (i = 0; i < 3; i++)
+        {
+            int len;
+            if (!out[i].size) continue;
+            len = WideCharToMultiByte(CP_ACP, 0, buf[i], -1, NULL, 0, NULL, NULL);
+            if (*out[i].size < len || !out[i].dst)
+            {
+                *out[i].size = len;
+                overflow = TRUE;
+                continue;
+            }
+            *out[i].size = WideCharToMultiByte(CP_ACP, 0, buf[i], -1, out[i].dst, *out[i].size, NULL, NULL);
+        }
+        if (overflow) ret = ERROR_BUFFER_OVERFLOW;
+    }
+    HeapFree(GetProcessHeap(), 0, wspn);
+    return ret;
+}
+
+/***********************************************************************
+ *             DsCrackSpn2A (NTDSAPI.@)
+ */
+DWORD WINAPI DsCrackSpn2A(LPCSTR spn, DWORD spn_len, LPDWORD class_size, LPSTR class, LPDWORD service_size,
+                          LPSTR service, LPDWORD instance_size, LPSTR instance, USHORT *port)
+{
+    return crack_spn_a(spn, spn_len, class_size, class, service_size, service, instance_size, instance, port);
+}
+
+/***********************************************************************
+ *             DsCrackSpnA (NTDSAPI.@)
+ */
+DWORD WINAPI DsCrackSpnA(LPCSTR spn, LPDWORD class_size, LPSTR class, LPDWORD service_size, LPSTR service,
+                         LPDWORD instance_size, LPSTR instance, USHORT *port)
+{
+    return crack_spn_a(spn, -1, class_size, class, service_size, service, instance_size, instance, port);
 }
 
