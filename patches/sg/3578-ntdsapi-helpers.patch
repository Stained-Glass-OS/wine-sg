+/***********************************************************************
+ *             DsGetRdnW (NTDSAPI.@)
+ *
+ * Splits the first RDN off a distinguished name: its key and its value (a quoted value keeps
+ * its quotes), and moves the name past the RDN and its comma or semicolon.
+ */
+DWORD WINAPI DsGetRdnW(LPCWCH *dn, DWORD *dn_len, LPCWCH *key, DWORD *key_len, LPCWCH *value, DWORD *value_len)
+{
+    const WCHAR *p, *end, *key_start, *key_end, *val_start, *val_end;
+
+    TRACE("(%p,%p,%p,%p,%p,%p)\n", dn, dn_len, key, key_len, value, value_len);
+
+    if (!dn || !dn_len || !key || !key_len || !value || !value_len || !*dn) return ERROR_INVALID_PARAMETER;
+    p = *dn;
+    end = p + *dn_len;
+    *key = *value = NULL;
+    *key_len = *value_len = 0;
+    while (p < end && *p == ' ') p++;
+    if (p == end) { *dn = p; *dn_len = 0; return ERROR_SUCCESS; }
+
+    key_start = p;
+    while (p < end && *p != '=') p++;
+    if (p == end) return ERROR_DS_NAME_UNPARSEABLE;
+    key_end = p;
+    while (key_end > key_start && key_end[-1] == ' ') key_end--;
+    if (key_end == key_start) return ERROR_DS_NAME_UNPARSEABLE;
+    p++;
+    while (p < end && *p == ' ') p++;
+    val_start = p;
+    if (p < end && *p == '"')
+    {
+        p++;
+        while (p < end && *p != '"')
+        {
+            if (*p == '\\') p++;
+            p++;
+        }
+        if (p >= end) return ERROR_DS_NAME_UNPARSEABLE;
+        p++;
+        val_end = p;
+        while (p < end && *p == ' ') p++;
+        if (p < end && *p != ',' && *p != ';') return ERROR_DS_NAME_UNPARSEABLE;
+    }
+    else
+    {
+        while (p < end && *p != ',' && *p != ';')
+        {
+            if (*p == '\\') p++;
+            p++;
+        }
+        if (p > end) return ERROR_DS_NAME_UNPARSEABLE;
+        val_end = p;
+        while (val_end > val_start && val_end[-1] == ' ' && (val_end - 1 == val_start || val_end[-2] != '\\')) val_end--;
+    }
+    if (val_end == val_start) return ERROR_DS_NAME_UNPARSEABLE;
+    *key = key_start;
+    *key_len = key_end - key_start;
+    *value = val_start;
+    *value_len = val_end - val_start;
+    if (p < end) p++;
+    *dn = p;
+    *dn_len = end - p;
+    return ERROR_SUCCESS;
+}
