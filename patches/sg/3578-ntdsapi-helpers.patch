+/***********************************************************************
+ *             DsCrackUnquotedMangledRdnW (NTDSAPI.@)
+ */
+BOOL WINAPI DsCrackUnquotedMangledRdnW(LPCWSTR rdn, DWORD len, GUID *guid, DS_MANGLE_FOR *form)
+{
+    const WCHAR *suffix;
+    DS_MANGLE_FOR kind;
+    GUID id;
+
+    TRACE("(%s,%lu,%p,%p)\n", debugstr_wn(rdn, len), len, guid, form);
+
+    /* a name, then "\nCNF:" and 36 characters of GUID */
+    if (!rdn || len < 5 + 36 + 1) return FALSE;
+    suffix = rdn + len - (5 + 36);
+    if (suffix[0] != '\n' || suffix[4] != ':') return FALSE;
+    if (!wcsncmp(suffix + 1, L"CNF", 3)) kind = DS_MANGLE_OBJECT_RDN_FOR_NAME_CONFLICT;
+    else if (!wcsncmp(suffix + 1, L"DEL", 3)) kind = DS_MANGLE_OBJECT_RDN_FOR_DELETION;
+    else return FALSE;
+    if (!parse_guid(suffix + 5, &id)) return FALSE;
+    if (guid) *guid = id;
+    if (form) *form = kind;
+    return TRUE;
+}
+
+/***********************************************************************
+ *             DsCrackUnquotedMangledRdnA (NTDSAPI.@)
+ */
+BOOL WINAPI DsCrackUnquotedMangledRdnA(LPCSTR rdn, DWORD len, GUID *guid, DS_MANGLE_FOR *form)
+{
+    WCHAR buf[512];
+    int n;
+
+    if (!rdn || len >= ARRAY_SIZE(buf)) return FALSE;
+    n = MultiByteToWideChar(CP_ACP, 0, rdn, len, buf, ARRAY_SIZE(buf));
+    return n && DsCrackUnquotedMangledRdnW(buf, n, guid, form);
+}
+
+/***********************************************************************
+ *             DsIsMangledRdnValueW (NTDSAPI.@)
+ */
+BOOL WINAPI DsIsMangledRdnValueW(LPCWSTR rdn, DWORD len, DS_MANGLE_FOR form)
+{
+    DS_MANGLE_FOR found;
+    WCHAR *unquoted;
+    DWORD ulen = len;
+    BOOL ret;
+
+    TRACE("(%s,%lu,%d)\n", debugstr_wn(rdn, len), len, form);
+
+    if (!rdn || !len || (form != DS_MANGLE_OBJECT_RDN_FOR_DELETION && form != DS_MANGLE_OBJECT_RDN_FOR_NAME_CONFLICT))
+        return FALSE;
+    /* the value as it is, or as a quoted value that is unquoted first */
+    if (rdn[0] != '"') return DsCrackUnquotedMangledRdnW(rdn, len, NULL, &found) && found == form;
+    if (!(unquoted = HeapAlloc(GetProcessHeap(), 0, (len + 1) * sizeof(WCHAR)))) return FALSE;
+    if (DsUnquoteRdnValueW(len, rdn, &ulen, unquoted)) ret = FALSE;
+    else ret = DsCrackUnquotedMangledRdnW(unquoted, ulen, NULL, &found) && found == form;
+    HeapFree(GetProcessHeap(), 0, unquoted);
+    return ret;
+}
+
+/***********************************************************************
+ *             DsIsMangledRdnValueA (NTDSAPI.@)
+ */
+BOOL WINAPI DsIsMangledRdnValueA(LPCSTR rdn, DWORD len, DS_MANGLE_FOR form)
+{
+    WCHAR buf[512];
+    int n;
+
+    if (!rdn || len >= ARRAY_SIZE(buf)) return FALSE;
+    n = MultiByteToWideChar(CP_ACP, 0, rdn, len, buf, ARRAY_SIZE(buf));
+    return n && DsIsMangledRdnValueW(buf, n, form);
+}
+
+/***********************************************************************
+ *             DsIsMangledDnW (NTDSAPI.@)
+ */
+BOOL WINAPI DsIsMangledDnW(LPCWSTR dn, DS_MANGLE_FOR form)
+{
+    const WCHAR *rest = dn, *key, *value;
+    DWORD rest_len, key_len, value_len;
+
+    TRACE("(%s,%d)\n", debugstr_w(dn), form);
+
+    if (!dn) return FALSE;
+    rest_len = lstrlenW(dn);
+    if (DsGetRdnW(&rest, &rest_len, &key, &key_len, &value, &value_len)) return FALSE;
+    return DsIsMangledRdnValueW(value, value_len, form);
+}
+
+/***********************************************************************
+ *             DsIsMangledDnA (NTDSAPI.@)
+ */
+BOOL WINAPI DsIsMangledDnA(LPCSTR dn, DS_MANGLE_FOR form)
+{
+    WCHAR *wdn = strdupAtoW(dn);
+    BOOL ret = wdn && DsIsMangledDnW(wdn, form);
+
+    HeapFree(GetProcessHeap(), 0, wdn);
+    return ret;
+}
