+/***********************************************************************
+ *             DsQuoteRdnValueW (NTDSAPI.@)
+ *
+ * A value with a special character, or a space at either end, is put in double quotes, with a
+ * backslash before any quote or backslash inside. The result is not null-terminated.
+ */
+DWORD WINAPI DsQuoteRdnValueW(DWORD len, LPCWCH value, DWORD *quoted_len, LPWCH quoted)
+{
+    BOOL quote = FALSE;
+    DWORD i, out = 0;
+
+    TRACE("(%lu,%s,%p,%p)\n", len, debugstr_wn(value, len), quoted_len, quoted);
+
+    if (!quoted_len || (len && !value) || len > 4096 || (*quoted_len && !quoted)) return ERROR_INVALID_PARAMETER;
+    for (i = 0; i < len; i++)
+        if (rdn_special(value[i])) { quote = TRUE; break; }
+    if (len && (value[0] == ' ' || value[len - 1] == ' ')) quote = TRUE;
+    if (!quote)
+    {
+        if (*quoted_len < len) { *quoted_len = len; return ERROR_BUFFER_OVERFLOW; }
+        memcpy(quoted, value, len * sizeof(WCHAR));
+        *quoted_len = len;
+        return ERROR_SUCCESS;
+    }
+    out = len + 2;
+    for (i = 0; i < len; i++)
+        if (value[i] == '"' || value[i] == '\\') out++;
+    if (*quoted_len < out) { *quoted_len = out; return ERROR_BUFFER_OVERFLOW; }
+    out = 0;
+    quoted[out++] = '"';
+    for (i = 0; i < len; i++)
+    {
+        if (value[i] == '"' || value[i] == '\\') quoted[out++] = '\\';
+        quoted[out++] = value[i];
+    }
+    quoted[out++] = '"';
+    *quoted_len = out;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *             DsUnquoteRdnValueW (NTDSAPI.@)
+ *
+ * Takes off the quotes, or the backslashes of an unquoted value with escapes.
+ */
+DWORD WINAPI DsUnquoteRdnValueW(DWORD len, LPCWCH value, DWORD *unquoted_len, LPWCH unquoted)
+{
+    DWORD i, out = 0, start = 0, end = len;
+    BOOL quoted = FALSE;
+    WCHAR *tmp;
+    DWORD ret = ERROR_SUCCESS;
+
+    TRACE("(%lu,%s,%p,%p)\n", len, debugstr_wn(value, len), unquoted_len, unquoted);
+
+    if (!unquoted_len || !value || !len || len > 4096 || (*unquoted_len && !unquoted)) return ERROR_INVALID_PARAMETER;
+    /* spaces around the value do not count */
+    while (start < end && value[start] == ' ') start++;
+    while (end > start && value[end - 1] == ' ') end--;
+    if (start == end) return ERROR_DS_NAME_UNPARSEABLE;
+    if (value[start] == '"')
+    {
+        if (end - start < 2 || value[end - 1] != '"') return ERROR_DS_NAME_UNPARSEABLE;
+        quoted = TRUE;
+        start++;
+        end--;
+    }
+    if (!(tmp = HeapAlloc(GetProcessHeap(), 0, (end - start + 1) * sizeof(WCHAR)))) return ERROR_NOT_ENOUGH_MEMORY;
+    for (i = start; i < end; i++)
+    {
+        if (value[i] == '\\')
+        {
+            if (i + 1 >= end) { ret = ERROR_DS_NAME_UNPARSEABLE; break; }
+            i++;
+        }
+        else if (quoted ? value[i] == '"' : (rdn_special(value[i]) && value[i] != '#'))
+        {
+            ret = ERROR_DS_NAME_UNPARSEABLE;
+            break;
+        }
+        tmp[out++] = value[i];
+    }
+    if (!ret)
+    {
+        if (*unquoted_len < out) ret = ERROR_BUFFER_OVERFLOW;
+        else memcpy(unquoted, tmp, out * sizeof(WCHAR));
+        *unquoted_len = out;
+    }
+    HeapFree(GetProcessHeap(), 0, tmp);
+    return ret;
+}
+
+static DWORD convert_rdn_a(DWORD len, LPCSTR value, DWORD *out_len, LPSTR out,
+                           DWORD (WINAPI *func)(DWORD, LPCWCH, DWORD *, LPWCH))
+{
+    WCHAR *wvalue = NULL, *wout;
+    DWORD wlen = 0, wout_len = 4 * (len + 2), ret;
+    int n;
+
+    if (!out_len || (len && !value) || (*out_len && !out)) return ERROR_INVALID_PARAMETER;
+    if (len)
+    {
+        n = MultiByteToWideChar(CP_ACP, 0, value, len, NULL, 0);
+        if (!(wvalue = HeapAlloc(GetProcessHeap(), 0, n * sizeof(WCHAR)))) return ERROR_NOT_ENOUGH_MEMORY;
+        wlen = MultiByteToWideChar(CP_ACP, 0, value, len, wvalue, n);
+    }
+    if (!(wout = HeapAlloc(GetProcessHeap(), 0, wout_len * sizeof(WCHAR))))
+    {
+        HeapFree(GetProcessHeap(), 0, wvalue);
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    ret = func(wlen, wvalue, &wout_len, wout);
+    if (!ret)
+    {
+        n = WideCharToMultiByte(CP_ACP, 0, wout, wout_len, NULL, 0, NULL, NULL);
+        if (*out_len < n) { *out_len = n; ret = ERROR_BUFFER_OVERFLOW; }
+        else *out_len = WideCharToMultiByte(CP_ACP, 0, wout, wout_len, out, *out_len, NULL, NULL);
+    }
+    HeapFree(GetProcessHeap(), 0, wvalue);
+    HeapFree(GetProcessHeap(), 0, wout);
+    return ret;
+}
+
+/***********************************************************************
+ *             DsQuoteRdnValueA (NTDSAPI.@)
+ */
+DWORD WINAPI DsQuoteRdnValueA(DWORD len, LPCSTR value, DWORD *quoted_len, LPSTR quoted)
+{
+    return convert_rdn_a(len, value, quoted_len, quoted, DsQuoteRdnValueW);
+}
+
+/***********************************************************************
+ *             DsUnquoteRdnValueA (NTDSAPI.@)
+ */
+DWORD WINAPI DsUnquoteRdnValueA(DWORD len, LPCSTR value, DWORD *unquoted_len, LPSTR unquoted)
+{
+    return convert_rdn_a(len, value, unquoted_len, unquoted, DsUnquoteRdnValueW);
+}
