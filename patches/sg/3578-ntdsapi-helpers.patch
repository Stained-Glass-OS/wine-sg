+/* ---- distinguished names ---- */
+
+static BOOL rdn_special(WCHAR c)
+{
+    return c == ',' || c == '=' || c == '+' || c == '<' || c == '>' || c == '#' || c == ';' ||
+           c == '"' || c == '\\' || c == '\n' || c == '\r';
+}
