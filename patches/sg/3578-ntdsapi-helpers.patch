+static void test_DsMakeSpnA(void)
+{
+    char spn[64];
+    DWORD len, ret;
+
+    len = sizeof(spn);
+    ret = DsMakeSpnA("class", "host", "instance", 555, NULL, &len, spn);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(!strcmp(spn, "class/instance:555/host"), "got %s\n", spn);
+    ok(len == strlen(spn) + 1, "got %lu\n", len);
+
+    len = 5;
+    ret = DsMakeSpnA("class", "host", NULL, 0, NULL, &len, spn);
+    ok(ret == ERROR_BUFFER_OVERFLOW, "got %lu\n", ret);
+    ok(len == strlen("class/host") + 1, "got %lu\n", len);
+
+    len = sizeof(spn);
+    ret = DsMakeSpnA(NULL, "host", NULL, 0, NULL, &len, spn);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+}
+
+static void test_DsGetSpn(void)
+{
+    static const USHORT ports[] = { 0, 8080 };
+    const char *instances[] = { "one.example", "two.example" };
+    char **spns = NULL;
+    DWORD count = 0, ret;
+
+    ret = DsGetSpnA(DS_SPN_DNS_HOST, "http", "web.example", 0, 0, NULL, NULL, &count, &spns);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(count == 1 && spns && !strcmp(spns[0], "http/web.example"), "got %lu %s\n", count, spns ? spns[0] : "(null)");
+    DsFreeSpnArrayA(count, spns);
+
+    spns = NULL;
+    ret = DsGetSpnA(DS_SPN_SERVICE, "svc", "name", 99, 2, instances, ports, &count, &spns);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(count == 2, "got %lu\n", count);
+    if (count == 2)
+    {
+        ok(!strcmp(spns[0], "svc/one.example:99/name"), "got %s\n", spns[0]);
+        ok(!strcmp(spns[1], "svc/two.example:8080/name"), "got %s\n", spns[1]);
+    }
+    DsFreeSpnArrayA(count, spns);
+
+    ret = DsGetSpnA(DS_SPN_DNS_HOST, NULL, "web.example", 0, 0, NULL, NULL, &count, &spns);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = DsGetSpnA(DS_SPN_DOMAIN, "ldap", NULL, 0, 0, NULL, NULL, &count, &spns);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+}
+
+static void test_DsCrackSpn(void)
+{
+    WCHAR cls[32], svc[32], inst[32];
+    DWORD cls_len, svc_len, inst_len, ret;
+    USHORT port;
+    char acls[32], asvc[32], ainst[32];
+
+    cls_len = svc_len = inst_len = 32;
+    port = 1;
+    ret = DsCrackSpnW(L"class/instance:555/host", &cls_len, cls, &svc_len, svc, &inst_len, inst, &port);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(!lstrcmpW(cls, L"class") && cls_len == 6, "got %s %lu\n", wine_dbgstr_w(cls), cls_len);
+    ok(!lstrcmpW(svc, L"host") && svc_len == 5, "got %s %lu\n", wine_dbgstr_w(svc), svc_len);
+    ok(!lstrcmpW(inst, L"instance") && inst_len == 9, "got %s %lu\n", wine_dbgstr_w(inst), inst_len);
+    ok(port == 555, "got %u\n", port);
+
+    cls_len = svc_len = inst_len = 32;
+    ret = DsCrackSpnW(L"class/host", &cls_len, cls, &svc_len, svc, &inst_len, inst, &port);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(!lstrcmpW(svc, L"host") && !inst[0] && !port, "got %s %s %u\n", wine_dbgstr_w(svc), wine_dbgstr_w(inst), port);
+
+    cls_len = 3; svc_len = inst_len = 32;
+    ret = DsCrackSpnW(L"class/host", &cls_len, cls, &svc_len, svc, &inst_len, inst, &port);
+    ok(ret == ERROR_BUFFER_OVERFLOW && cls_len == 6, "got %lu %lu\n", ret, cls_len);
+
+    cls_len = svc_len = inst_len = 32;
+    ret = DsCrackSpnW(L"nospn", &cls_len, cls, &svc_len, svc, &inst_len, inst, &port);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = DsCrackSpnW(L"class/inst:99999/host", &cls_len, cls, &svc_len, svc, &inst_len, inst, &port);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+
+    cls_len = svc_len = inst_len = 32;
+    ret = DsCrackSpnA("a/b:7/c", &cls_len, acls, &svc_len, asvc, &inst_len, ainst, &port);
+    ok(ret == ERROR_SUCCESS && !strcmp(acls, "a") && !strcmp(asvc, "c") && !strcmp(ainst, "b") && port == 7,
+       "got %lu %s %s %s %u\n", ret, acls, asvc, ainst, port);
+
+    cls_len = svc_len = inst_len = 32;
+    ret = DsCrackSpn2W(L"class/host/ignored", 10, &cls_len, cls, &svc_len, svc, &inst_len, inst, &port);
+    ok(ret == ERROR_SUCCESS && !lstrcmpW(svc, L"host"), "got %lu %s\n", ret, wine_dbgstr_w(svc));
+}
+
+static void test_rdn_values(void)
+{
+    WCHAR buf[64];
+    DWORD len, ret;
+
+    len = ARRAY_SIZE(buf);
+    ret = DsQuoteRdnValueW(5, L"plain", &len, buf);
+    ok(ret == ERROR_SUCCESS && len == 5 && !memcmp(buf, L"plain", 10), "got %lu %lu\n", ret, len);
+
+    len = ARRAY_SIZE(buf);
+    ret = DsQuoteRdnValueW(7, L"a,b\"c\\d", &len, buf);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(len == 11 && !memcmp(buf, L"\"a,b\\\"c\\\\d\"", 22), "got %lu %s\n", len, wine_dbgstr_wn(buf, len));
+
+    len = ARRAY_SIZE(buf);
+    ret = DsQuoteRdnValueW(5, L" lead", &len, buf);
+    ok(ret == ERROR_SUCCESS && len == 7 && buf[0] == '"', "got %lu %lu\n", ret, len);
+
+    len = 3;
+    ret = DsQuoteRdnValueW(5, L"a,bcd", &len, buf);
+    ok(ret == ERROR_BUFFER_OVERFLOW && len == 7, "got %lu %lu\n", ret, len);
+
+    len = ARRAY_SIZE(buf);
+    ret = DsUnquoteRdnValueW(11, L"\"a,b\\\"c\\\\d\"", &len, buf);
+    ok(ret == ERROR_SUCCESS && len == 7 && !memcmp(buf, L"a,b\"c\\d", 14), "got %lu %lu\n", ret, len);
+
+    len = ARRAY_SIZE(buf);
+    ret = DsUnquoteRdnValueW(6, L"a\\,b\\+", &len, buf);
+    ok(ret == ERROR_SUCCESS && len == 4 && !memcmp(buf, L"a,b+", 8), "got %lu %lu\n", ret, len);
+
+    len = ARRAY_SIZE(buf);
+    ret = DsUnquoteRdnValueW(4, L"\"abc", &len, buf);
+    ok(ret == ERROR_DS_NAME_UNPARSEABLE, "got %lu\n", ret);
+}
+
+static void test_DsGetRdn(void)
+{
+    const WCHAR *dn = L"CN=John Smith,OU=\"R,D\",DC=example,DC=com", *key, *value;
+    DWORD dn_len = lstrlenW(dn), key_len, value_len, ret;
+
+    ret = DsGetRdnW(&dn, &dn_len, &key, &key_len, &value, &value_len);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(key_len == 2 && !wcsncmp(key, L"CN", 2), "got %s\n", wine_dbgstr_wn(key, key_len));
+    ok(value_len == 10 && !wcsncmp(value, L"John Smith", 10), "got %s\n", wine_dbgstr_wn(value, value_len));
+    ok(!wcsncmp(dn, L"OU=", 3), "got %s\n", wine_dbgstr_w(dn));
+
+    ret = DsGetRdnW(&dn, &dn_len, &key, &key_len, &value, &value_len);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(key_len == 2 && value_len == 5 && !wcsncmp(value, L"\"R,D\"", 5), "got %s\n", wine_dbgstr_wn(value, value_len));
+
+    ret = DsGetRdnW(&dn, &dn_len, &key, &key_len, &value, &value_len);
+    ok(ret == ERROR_SUCCESS && key_len == 2 && !wcsncmp(key, L"DC", 2) && value_len == 7, "got %lu\n", ret);
+    ret = DsGetRdnW(&dn, &dn_len, &key, &key_len, &value, &value_len);
+    ok(ret == ERROR_SUCCESS && value_len == 3 && !dn_len, "got %lu %lu\n", ret, dn_len);
+
+    dn = L"nonsense";
+    dn_len = 8;
+    ret = DsGetRdnW(&dn, &dn_len, &key, &key_len, &value, &value_len);
+    ok(ret == ERROR_DS_NAME_UNPARSEABLE, "got %lu\n", ret);
+}
+
+static void test_mangled(void)
+{
+    static const WCHAR conflict[] = L"Name\nCNF:0123abcd-4567-89ab-cdef-0123456789ab";
+    static const WCHAR deleted[] = L"Name\nDEL:0123abcd-4567-89ab-cdef-0123456789ab";
+    static const WCHAR dn[] = L"CN=Name\nCNF:0123abcd-4567-89ab-cdef-0123456789ab,DC=example";
+    DS_MANGLE_FOR form;
+    GUID guid;
+    BOOL ret;
+
+    ret = DsCrackUnquotedMangledRdnW(conflict, lstrlenW(conflict), &guid, &form);
+    ok(ret && form == DS_MANGLE_OBJECT_RDN_FOR_NAME_CONFLICT, "got %d %d\n", ret, form);
+    ok(guid.Data1 == 0x0123abcd && guid.Data2 == 0x4567 && guid.Data3 == 0x89ab && guid.Data4[0] == 0xcd &&
+       guid.Data4[7] == 0xab, "wrong guid %s\n", wine_dbgstr_guid(&guid));
+    ret = DsCrackUnquotedMangledRdnW(deleted, lstrlenW(deleted), &guid, &form);
+    ok(ret && form == DS_MANGLE_OBJECT_RDN_FOR_DELETION, "got %d %d\n", ret, form);
+    ret = DsCrackUnquotedMangledRdnW(L"Name", 4, &guid, &form);
+    ok(!ret, "got %d\n", ret);
+
+    ok(DsIsMangledRdnValueW(conflict, lstrlenW(conflict), DS_MANGLE_OBJECT_RDN_FOR_NAME_CONFLICT), "conflict\n");
+    ok(!DsIsMangledRdnValueW(conflict, lstrlenW(conflict), DS_MANGLE_OBJECT_RDN_FOR_DELETION), "not deleted\n");
+    ok(DsIsMangledDnW(dn, DS_MANGLE_OBJECT_RDN_FOR_NAME_CONFLICT), "dn conflict\n");
+    ok(!DsIsMangledDnW(L"CN=Name,DC=example", DS_MANGLE_OBJECT_RDN_FOR_NAME_CONFLICT), "plain dn\n");
+}
+
+static void test_credentials(void)
+{
+    SEC_WINNT_AUTH_IDENTITY_W *id;
+    void *handle = (void *)1;
+    DWORD ret;
+
+    ret = DsMakePasswordCredentialsW(NULL, NULL, NULL, &handle);
+    ok(ret == ERROR_SUCCESS && !handle, "got %lu %p\n", ret, handle);
+
+    ret = DsMakePasswordCredentialsW(L"user", L"DOM", L"secret", &handle);
+    ok(ret == ERROR_SUCCESS && handle, "got %lu %p\n", ret, handle);
+    id = handle;
+    if (id)
+    {
+        ok(id->UserLength == 4 && !lstrcmpW(id->User, L"user"), "user\n");
+        ok(id->DomainLength == 3 && !lstrcmpW(id->Domain, L"DOM"), "domain\n");
+        ok(id->PasswordLength == 6 && !lstrcmpW(id->Password, L"secret"), "password\n");
+        ok(id->Flags == SEC_WINNT_AUTH_IDENTITY_UNICODE, "flags %#lx\n", id->Flags);
+    }
+    DsFreePasswordCredentials(handle);
+
+    ret = DsMakePasswordCredentialsA("u", NULL, "p", &handle);
+    id = handle;
+    ok(ret == ERROR_SUCCESS && id && !lstrcmpW(id->User, L"u") && !id->Domain, "got %lu\n", ret);
+    DsFreePasswordCredentials(handle);
+    ret = DsMakePasswordCredentialsA("u", NULL, "p", NULL);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+}
+
+static void test_bind(void)
+{
+    HANDLE ds = (HANDLE)1;
+    DWORD ret;
+
+    ret = DsBindW(NULL, NULL, &ds);
+    ok(ret != ERROR_SUCCESS && !ds, "got %lu %p\n", ret, ds);
+    ret = DsBindW(NULL, NULL, NULL);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = DsUnBindW(NULL);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ds = (HANDLE)1;
+    ret = DsUnBindW(&ds);
+    ok(ret == ERROR_SUCCESS && !ds, "got %lu %p\n", ret, ds);
+    ret = DsServerRegisterSpnW(DS_SPN_ADD_SPN_OP, L"", NULL);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+}
+
 START_TEST( ntdsapi )
 {
     test_DsMakeSpn();
     test_DsClientMakeSpnForTargetServer();
+    test_DsMakeSpnA();
+    test_DsGetSpn();
+    test_DsCrackSpn();
+    test_rdn_values();
+    test_DsGetRdn();
+    test_mangled();
+    test_credentials();
+    test_bind();
 }
