+/******************************************************************************
+ *           __wine_driver_features (wineps.drv.@)
+ *
+ * The driver's own settings, for the print schema (prntvpt): one line per
+ * feature, "F\t<keyword>\t<name>\t<chosen option>", then one per option,
+ * "O\t<keyword>\t<name>".  Returns the characters needed, with the 0.
+ */
+DWORD WINAPI __wine_driver_features( HANDLE printer, const WCHAR *name, const DEVMODEW *in, WCHAR *buf, DWORD size )
+{
+    PRINTERINFO *pi = PSDRV_FindPrinterInfo( name );
+    struct ps_ui *pu;
+    WCHAR line[600], keyword[128], option[128];
+    DWORD used = 0, dm_size;
+    unsigned int i;
+    int o;
+
+    if (!pi || !(pu = calloc( 1, sizeof(*pu) ))) return 0;
+    dm_size = pi->Devmode->dmPublic.dmSize + pi->Devmode->dmPublic.dmDriverExtra;
+    if (!(pu->dm = malloc( dm_size )))
+    {
+        free( pu );
+        return 0;
+    }
+    memcpy( pu->dm, pi->Devmode, dm_size );
+    if (in) PSDRV_MergeDevmodes( pu->dm, in, pi );
+    pu->pi = pi;
+    ps_fill_features( pu );
+    for (i = 0; i < pu->ui.feature_count; i++)
+    {
+        struct drvui_feature *df = &pu->ui.features[i];
+        if (!private_feature( pu, i ) || df->sel < 0 || df->sel >= df->count) continue;
+        MultiByteToWideChar( CP_ACP, 0, df->name, -1, keyword, ARRAY_SIZE(keyword) );
+        MultiByteToWideChar( CP_ACP, 0, df->options[df->sel].name, -1, option, ARRAY_SIZE(option) );
+        swprintf( line, ARRAY_SIZE(line), L"F\t%s\t%s\t%s\n", keyword, df->text, option );
+        append( buf, size, &used, line );
+        for (o = 0; o < df->count; o++)
+        {
+            MultiByteToWideChar( CP_ACP, 0, df->options[o].name, -1, option, ARRAY_SIZE(option) );
+            swprintf( line, ARRAY_SIZE(line), L"O\t%s\t%s\n", option, df->options[o].text );
+            append( buf, size, &used, line );
+        }
+    }
+    if (buf && used < size) buf[used] = 0;
+    ps_ui_free( pu );
+    return used + 1;
+}
+
+/******************************************************************************
+ *           __wine_driver_set_feature (wineps.drv.@)
+ */
+BOOL WINAPI __wine_driver_set_feature( HANDLE printer, const WCHAR *name, DEVMODEW *dm, const WCHAR *feature,
+                                       const WCHAR *option )
+{
+    PRINTERINFO *pi = PSDRV_FindPrinterInfo( name );
+    char featureA[128], optionA[128];
+    PSDRV_DEVMODE *full;
+    PPD_FEATURE *f;
+    DWORD dm_size;
+    int o;
+
+    if (!pi || !dm || !feature || !option) return FALSE;
+    WideCharToMultiByte( CP_ACP, 0, feature, -1, featureA, sizeof(featureA), NULL, NULL );
+    WideCharToMultiByte( CP_ACP, 0, option, -1, optionA, sizeof(optionA), NULL, NULL );
+    if (!(f = ppd_find_feature( pi->ppd, featureA )) || (o = ppd_feature_option( f, optionA )) < 0) return FALSE;
+    dm_size = pi->Devmode->dmPublic.dmSize + pi->Devmode->dmPublic.dmDriverExtra;
+    if (dm->dmSize + dm->dmDriverExtra != dm_size) return FALSE;
+    full = (PSDRV_DEVMODE *)dm;
+    if (!devmode_features( full )) return FALSE;
+    features_select( full, f, o );
+    features_to_public( pi, full );
+    return TRUE;
+}
