+
+static void append( WCHAR *buf, DWORD size, DWORD *used, const WCHAR *text )
+{
+    DWORD len = wcslen( text );
+    if (buf && *used + len < size) memcpy( buf + *used, text, len * sizeof(WCHAR) );
+    *used += len;
+}
+
+/* the PPD's options the print schema has no keyword for */
+static BOOL private_feature( struct ps_ui *pu, unsigned int i )
+{
+    PPD_FEATURE *f = pu->refs[i].feature;
+    return !pu->refs[i].kind && f && !pu->ui.features[i].printer && f != features_color( pu->pi->ppd ) &&
+           strcmp( f->keyword, "Collate" ) && f->count > 1;
+}
