+/* the printer's configuration DLL's description of its own settings */
+static WCHAR *driver_features(HANDLE printer, const WCHAR *device, const DEVMODEW *dm)
+{
+    DWORD (WINAPI *get)(HANDLE, const WCHAR *, const DEVMODEW *, WCHAR *, DWORD);
+    DRIVER_INFO_2W *info;
+    DWORD needed = 0, len;
+    HMODULE module = NULL;
+    WCHAR *text = NULL;
+
+#ifdef SG_MUTANT_PTDRIVERFEATURES
+    return NULL;
+#endif
+    GetPrinterDriverW(printer, NULL, 2, NULL, 0, &needed);
+    if (!needed || !(info = malloc(needed))) return NULL;
+    if (GetPrinterDriverW(printer, NULL, 2, (BYTE *)info, needed, &needed) && info->pConfigFile)
+    {
+        const WCHAR *base = wcsrchr(info->pConfigFile, '\\');
+        if (!(module = LoadLibraryW(info->pConfigFile))) module = LoadLibraryW(base ? base + 1 : info->pConfigFile);
+    }
+    free(info);
+    if (!module) return NULL;
+    if ((get = (void *)GetProcAddress(module, "__wine_driver_features")) &&
+        (len = get(printer, device, dm, NULL, 0)) > 1 && (text = malloc(len * sizeof(WCHAR))))
+    {
+        if (get(printer, device, dm, text, len) != len)
+        {
+            free(text);
+            text = NULL;
+        }
+    }
+    FreeLibrary(module);
+    return text;
+}
