+static void read_driver_settings(IXMLDOMDocument2 *doc, struct ticket *ticket)
+{
+    IXMLDOMNodeList *list;
+    IXMLDOMNode *node, *option;
+    IXMLDOMElement *element;
+    VARIANT name, value;
+
+    if (IXMLDOMDocument2_selectNodes(doc, (BSTR)L"psf:PrintTicket/psf:Feature", &list) != S_OK) return;
+    while (IXMLDOMNodeList_nextNode(list, &node) == S_OK && node)
+    {
+        VariantInit(&name);
+        if (IXMLDOMNode_QueryInterface(node, &IID_IXMLDOMElement, (void **)&element) == S_OK)
+        {
+            if (IXMLDOMElement_getAttribute(element, (BSTR)L"name", &name) == S_OK && V_VT(&name) == VT_BSTR &&
+                !wcsncmp(local_name(V_BSTR(&name)), L"DF_", 3) &&
+                IXMLDOMNode_selectSingleNode(node, (BSTR)L"./psf:Option", &option) == S_OK)
+            {
+                IXMLDOMElement *opt;
+                if (IXMLDOMNode_QueryInterface(option, &IID_IXMLDOMElement, (void **)&opt) == S_OK)
+                {
+                    VariantInit(&value);
+                    if (IXMLDOMElement_getAttribute(opt, (BSTR)L"name", &value) == S_OK && V_VT(&value) == VT_BSTR)
+                    {
+                        set_driver_setting(ticket, local_name(V_BSTR(&name)) + 3, local_name(V_BSTR(&value)));
+                        TRACE("driver setting %s = %s\n", wine_dbgstr_w(V_BSTR(&name)), wine_dbgstr_w(V_BSTR(&value)));
+                    }
+                    VariantClear(&value);
+                    IXMLDOMElement_Release(opt);
+                }
+                IXMLDOMNode_Release(option);
+            }
+            VariantClear(&name);
+            IXMLDOMElement_Release(element);
+        }
+        IXMLDOMNode_Release(node);
+    }
+    IXMLDOMNodeList_Release(list);
+}
