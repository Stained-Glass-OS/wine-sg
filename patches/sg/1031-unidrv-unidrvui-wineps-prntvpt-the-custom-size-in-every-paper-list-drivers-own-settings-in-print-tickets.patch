+static BOOL driver_set_feature(HANDLE printer, const WCHAR *device, DEVMODEW *dm, const WCHAR *feature,
+                               const WCHAR *option)
+{
+    BOOL (WINAPI *set)(HANDLE, const WCHAR *, DEVMODEW *, const WCHAR *, const WCHAR *);
+    DRIVER_INFO_2W *info;
+    DWORD needed = 0;
+    HMODULE module = NULL;
+    BOOL ret = FALSE;
+
+    GetPrinterDriverW(printer, NULL, 2, NULL, 0, &needed);
+    if (!needed || !(info = malloc(needed))) return FALSE;
+    if (GetPrinterDriverW(printer, NULL, 2, (BYTE *)info, needed, &needed) && info->pConfigFile)
+    {
+        const WCHAR *base = wcsrchr(info->pConfigFile, '\\');
+        if (!(module = LoadLibraryW(info->pConfigFile))) module = LoadLibraryW(base ? base + 1 : info->pConfigFile);
+    }
+    free(info);
+    if (!module) return FALSE;
+    if ((set = (void *)GetProcAddress(module, "__wine_driver_set_feature")))
+        ret = set(printer, device, dm, feature, option);
+    FreeLibrary(module);
+    return ret;
+}
+
+/* the next field of a line of the description */
+static WCHAR *next_field(WCHAR **p)
+{
+    WCHAR *start = *p, *end = start + wcscspn(start, L"\t\n");
+    *p = *end ? end + 1 : end;
+    *end = 0;
+    return start;
+}
+
+static void set_driver_setting(struct ticket *ticket, const WCHAR *feature, const WCHAR *option)
+{
+    int i;
+
+    for (i = 0; i < ticket->driver_count; i++)
+        if (!wcscmp(ticket->driver[i].feature, feature)) break;
+    if (i == ticket->driver_count)
+    {
+        if (i == MAX_DRIVER_FEATURES) return;
+        ticket->driver_count++;
+    }
+    lstrcpynW(ticket->driver[i].feature, feature, ARRAY_SIZE(ticket->driver[i].feature));
+    lstrcpynW(ticket->driver[i].option, option, ARRAY_SIZE(ticket->driver[i].option));
+}
+
+/* the devmode's choices of the driver's own settings */
+static void driver_settings_from_devmode(HANDLE printer, const WCHAR *device, const DEVMODEW *dm,
+                                         struct ticket *ticket)
+{
+    WCHAR *text = driver_features(printer, device, dm), *p, *line;
+
+    for (p = text; p && *p; )
+    {
+        WCHAR *kind, *keyword, *display, *chosen;
+        line = p;
+        p += wcscspn(p, L"\n");
+        if (*p) *p++ = 0;
+        kind = next_field(&line);
+        keyword = next_field(&line);
+        display = next_field(&line);
+        chosen = next_field(&line);
+        (void)display;
+        if (!wcscmp(kind, L"F") && *chosen) set_driver_setting(ticket, keyword, chosen);
+    }
+    free(text);
+}
+
+/* a QName's local part */
+static const WCHAR *local_name(const WCHAR *name)
+{
+    const WCHAR *colon = wcschr(name, ':');
+    return colon ? colon + 1 : name;
+}
