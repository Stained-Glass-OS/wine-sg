+/* the driver's own settings, with their names and options */
+static HRESULT write_driver_caps(const WCHAR *device, IXMLDOMElement *root, const DEVMODEW *dm)
+{
+    IXMLDOMElement *feature = NULL;
+    WCHAR *text, *p, *line, name[80];
+    HANDLE printer;
+    HRESULT hr = S_OK;
+
+    if (!OpenPrinterW((WCHAR *)device, &printer, NULL)) return S_OK;
+    text = driver_features(printer, device, dm);
+    ClosePrinter(printer);
+    for (p = text; p && *p && hr == S_OK; )
+    {
+        WCHAR *kind, *keyword, *display;
+        line = p;
+        p += wcscspn(p, L"\n");
+        if (*p) *p++ = 0;
+        kind = next_field(&line);
+        keyword = next_field(&line);
+        display = next_field(&line);
+        if (!wcscmp(kind, L"F"))
+        {
+            if (feature) IXMLDOMElement_Release(feature);
+            feature = NULL;
+            swprintf(name, ARRAY_SIZE(name), L"ns0000:DF_%s", keyword);
+            hr = create_caps_Feature(root, name, display, &feature);
+        }
+        else if (!wcscmp(kind, L"O") && feature)
+        {
+            swprintf(name, ARRAY_SIZE(name), L"ns0000:%s", keyword);
+            hr = add_caps_Option(feature, name, display);
+        }
+    }
+    if (feature) IXMLDOMElement_Release(feature);
+    free(text);
+    return hr;
+}
