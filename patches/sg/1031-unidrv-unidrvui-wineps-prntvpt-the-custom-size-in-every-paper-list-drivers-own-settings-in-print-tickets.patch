+/* the features the print schema has no keyword for, and Unidrv's own */
+static BOOL private_feature( struct gpd *gpd, int f )
+{
+    static const char *standard[] = { "PaperSize", "InputBin", "Duplex", "Orientation", "Resolution", "ColorMode",
+                                      "Collate" };
+    const char *conceal = gpd_feature_attr( gpd, f, "ConcealFromUI?" );
+    unsigned int i;
+
+    if (conceal && gpd_bool( gpd, conceal, FALSE )) return FALSE;
+    if (unidrv_printer_feature( gpd, f )) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(standard); i++) if (!strcmp( gpd->features[f].name, standard[i] )) return FALSE;
+    return gpd->features[f].option_count > 1;
+}
+
+static void append( WCHAR *buf, DWORD size, DWORD *used, const WCHAR *text )
+{
+    DWORD len = wcslen( text );
+    if (buf && *used + len < size) memcpy( buf + *used, text, len * sizeof(WCHAR) );
+    *used += len;
+}
