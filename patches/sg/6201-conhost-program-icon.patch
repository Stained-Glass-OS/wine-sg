From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] conhost, explorer: a console window shows its program's icon

A console program's window showed conhost's generic icon on the taskbar, in the switcher and in Task View, not the program's (DOSBox's console, cmd, PowerShell). On Windows the console window carries the icon of the program it was made for. conhost now puts the icons of the image its console was made for on its window. That image is named by its title, the image's path, unless the title is a shortcut's name. conhost also names that image in a window property (SgConsoleImage) for the shell, which draws other processes' icons from their files and would otherwise take conhost's own.
---
diff --git a/programs/conhost/window.c b/programs/conhost/window.c
index 36b87b7..b5fb7fa 100644
--- a/programs/conhost/window.c
+++ b/programs/conhost/window.c
@@ -2462,6 +2462,38 @@ void update_window_region( struct console *console, const RECT *update )
     update_window_config( console, TRUE );
 }
 
+#ifndef STARTF_TITLEISLINKNAME
+#define STARTF_TITLEISLINKNAME 0x00000800   /* (documented STARTUPINFO flag) */
+#endif
+
+/* the program's icons (its title is its image's path, as the console was made for it) on the window:
+ * the taskbar and the switcher show them; else the class's generic one stays */
+static void set_program_icons( HWND hwnd, const WCHAR *path )
+{
+    HICON big = NULL, small = NULL;
+    DWORD attr;
+
+    if (!path || !*path) return;
+    attr = GetFileAttributesW( path );
+    if (attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_DIRECTORY)) return;
+#ifdef SG_MUTANT_CONSOLE_NO_PROGRAM_ICON
+    return;
+#endif
+    if (PrivateExtractIconsW( path, 0, GetSystemMetrics( SM_CXICON ), GetSystemMetrics( SM_CYICON ),
+                              &big, NULL, 1, 0 ) != 1) big = NULL;
+    if (PrivateExtractIconsW( path, 0, GetSystemMetrics( SM_CXSMICON ), GetSystemMetrics( SM_CYSMICON ),
+                              &small, NULL, 1, 0 ) != 1) small = NULL;
+    TRACE( "%s: icons %p %p\n", debugstr_w( path ), big, small );
+    if (big) SendMessageW( hwnd, WM_SETICON, ICON_BIG, (LPARAM)big );
+    if (small) SendMessageW( hwnd, WM_SETICON, ICON_SMALL, (LPARAM)small );
+    /* the shell draws other processes' icons from their files: it is told which file is the program */
+    if (wcslen( path ) < 256)
+    {
+        ATOM atom = GlobalAddAtomW( path );
+        if (atom) SetPropW( hwnd, L"SgConsoleImage", (HANDLE)(ULONG_PTR)atom );
+    }
+}
+
 BOOL init_window( struct console *console )
 {
     struct console_config config;
@@ -2514,6 +2546,7 @@ BOOL init_window( struct console *console )
                         WS_MAXIMIZEBOX|WS_HSCROLL|WS_VSCROLL, CW_USEDEFAULT, CW_USEDEFAULT,
                         0, 0, 0, 0, wndclass.hInstance, console ))
         return FALSE;
+    if (!(si.dwFlags & STARTF_TITLEISLINKNAME)) set_program_icons( console->win, si.lpTitle );
 
     if (!config.face_name[0])
         set_first_font( console, &config );
diff --git a/programs/explorer/explorer_private.h b/programs/explorer/explorer_private.h
index 3197333..1d3499f 100644
--- a/programs/explorer/explorer_private.h
+++ b/programs/explorer/explorer_private.h
@@ -24,7 +24,9 @@
 extern void manage_desktop( WCHAR *arg );
 extern void initialize_systray( BOOL using_root, BOOL enable_shell, BOOL show_systray, BOOL no_tray_items );
 extern void initialize_appbar(void);
-extern void run_startup_programs(void);   /* Stained Glass OS: Run keys and Startup folders, once per sign-in */
+extern void run_startup_programs(void);
+/* a console window's program (conhost's SgConsoleImage window property), else FALSE */
+extern BOOL sg_console_image( HWND hwnd, WCHAR *exe, DWORD size );   /* Stained Glass OS: Run keys and Startup folders, once per sign-in */
 extern void handle_parent_notify( HWND hwnd, WPARAM wp );
 extern void shell_shutdown_dialog(void);   /* Stained Glass OS: Alt+F4 on the desktop or the taskbar */
 
diff --git a/programs/explorer/systray.c b/programs/explorer/systray.c
index 58a2b15..0e4e842 100644
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -1887,7 +1887,8 @@ static void add_taskbar_button( HWND hwnd )
         DWORD pid, len = ARRAY_SIZE(win->exe);
         HANDLE process;
         GetWindowThreadProcessId( hwnd, &pid );
-        if ((process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid )))
+        if (sg_console_image( hwnd, win->exe, len )) ;   /* a console window: its program's, not conhost's */
+        else if ((process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid )))
         {
             if (!QueryFullProcessImageNameW( process, 0, win->exe, &len )) win->exe[0] = 0;
             CloseHandle( process );
@@ -6080,3 +6081,15 @@ void initialize_systray( BOOL arg_using_root, BOOL arg_enable_shell, BOOL arg_sh
     if (enable_taskbar) do_show_systray();
     else do_hide_systray();
 }
+
+/* the program a console window (conhost's) shows: conhost names its image in a window property */
+BOOL sg_console_image( HWND hwnd, WCHAR *exe, DWORD size )
+{
+    ATOM atom;
+
+#ifdef SG_MUTANT_SHELL_IGNORES_CONSOLE_IMAGE
+    return FALSE;
+#endif
+    if (!hwnd || !(atom = (ATOM)(ULONG_PTR)GetPropW( hwnd, L"SgConsoleImage" ))) return FALSE;
+    return GlobalGetAtomNameW( atom, exe, size ) > 0;
+}
diff --git a/programs/explorer/vdesktop.c b/programs/explorer/vdesktop.c
index 818cea3..b9cc218 100644
--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -889,7 +889,7 @@ static struct program_icon
 } program_icons[64];
 static unsigned int program_icon_count, program_icon_next;
 
-static HICON program_icon( DWORD pid, BOOL little )
+static HICON program_icon( HWND hwnd, DWORD pid, BOOL little )
 {
     WCHAR exe[MAX_PATH];
     DWORD len = ARRAY_SIZE(exe);
@@ -898,9 +898,13 @@ static HICON program_icon( DWORD pid, BOOL little )
     unsigned int i;
     BOOL ok;
 
-    if (!(process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid ))) return 0;
-    ok = QueryFullProcessImageNameW( process, 0, exe, &len );
-    CloseHandle( process );
+    if (sg_console_image( hwnd, exe, len )) ok = TRUE;   /* a console window: its program's */
+    else
+    {
+        if (!(process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid ))) return 0;
+        ok = QueryFullProcessImageNameW( process, 0, exe, &len );
+        CloseHandle( process );
+    }
     if (!ok) return 0;
     for (i = 0; i < program_icon_count; i++)
         if (!wcsicmp( program_icons[i].exe, exe )) break;
@@ -925,7 +929,7 @@ static HICON window_icon( HWND hwnd, BOOL little )
     DWORD pid;
 
 #ifndef SG_MUTANT_SWITCHER_FOREIGN_ICON
-    if (GetWindowThreadProcessId( hwnd, &pid ) && pid != GetCurrentProcessId()) return program_icon( pid, little );
+    if (GetWindowThreadProcessId( hwnd, &pid ) && pid != GetCurrentProcessId()) return program_icon( hwnd, pid, little );
 #else
     (void)pid;
 #endif
