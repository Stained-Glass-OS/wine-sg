+static void test_DSA_private_and_v2(void)
+{
+    BCRYPT_ALG_HANDLE alg;
+    BCRYPT_KEY_HANDLE key, key2;
+    BCRYPT_DSA_KEY_BLOB *blob;
+    BCRYPT_DSA_KEY_BLOB_V2 *blob2;
+    UCHAR hash[32], sig[64], *buf, *buf2;
+    ULONG size, size2, len, i;
+    NTSTATUS ret;
+
+    for (i = 0; i < sizeof(hash); i++) hash[i] = i + 1;
+
+    ret = BCryptOpenAlgorithmProvider(&alg, BCRYPT_DSA_ALGORITHM, NULL, 0);
+    ok(!ret, "got %#lx\n", ret);
+
+    /* a 1024-bit key: private v1 blob round trip, SHA-1 only, 40 byte signatures */
+    ret = BCryptGenerateKeyPair(alg, &key, 1024, 0);
+    ok(!ret, "got %#lx\n", ret);
+    ret = BCryptFinalizeKeyPair(key, 0);
+    ok(!ret, "got %#lx\n", ret);
+    size = 0;
+    ret = BCryptExportKey(key, NULL, BCRYPT_DSA_PRIVATE_BLOB, NULL, 0, &size, 0);
+    ok(!ret, "got %#lx\n", ret);
+    ok(size == sizeof(*blob) + 3 * 128 + 20, "got %lu\n", size);
+    buf = calloc(1, size);
+    ret = BCryptExportKey(key, NULL, BCRYPT_DSA_PRIVATE_BLOB, buf, size, &size, 0);
+    ok(!ret, "got %#lx\n", ret);
+    blob = (BCRYPT_DSA_KEY_BLOB *)buf;
+    ok(blob->dwMagic == BCRYPT_DSA_PRIVATE_MAGIC, "got %#lx\n", blob->dwMagic);
+    ok(blob->cbKey == 128, "got %lu\n", blob->cbKey);
+
+    len = 0;
+    ret = BCryptSignHash(key, NULL, hash, 20, NULL, 0, &len, 0);
