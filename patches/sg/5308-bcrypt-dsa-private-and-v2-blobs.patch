+    ok(!ret, "got %#lx\n", ret);
+    ok(((BCRYPT_DSA_KEY_BLOB_V2 *)buf2)->dwMagic == BCRYPT_DSA_PUBLIC_MAGIC_V2, "got %#lx\n",
