+/* DSA keys longer than 1024 bits have q of 256 bits and use BCRYPT_DSA_KEY_BLOB_V2 */
+#define DSA_V2_GROUP_SIZE 32
+
+static NTSTATUS key_export_dsa_v2( struct key *key, BOOL priv, UCHAR *buf, ULONG len, ULONG *ret_len )
+{
+    BCRYPT_DSA_KEY_BLOB_V2 *blob = (BCRYPT_DSA_KEY_BLOB_V2 *)buf;
+    gnutls_datum_t p, q, g, y, x = { NULL, 0 };
+    ULONG size = key->u.a.bitlen / 8, seed_len = DSA_V2_GROUP_SIZE;
+    NTSTATUS status = STATUS_SUCCESS;
+    UCHAR *dst;
+    int ret;
+
+    if (priv)
+    {
+        if (!key_data(key)->a.privkey) return STATUS_INVALID_PARAMETER;
+        ret = pgnutls_privkey_export_dsa_raw( key_data(key)->a.privkey, &p, &q, &g, &y, &x );
+    }
+    else if (key_data(key)->a.pubkey)
+        ret = pgnutls_pubkey_export_dsa_raw( key_data(key)->a.pubkey, &p, &q, &g, &y );
+    else if (key_data(key)->a.privkey)
+        ret = pgnutls_privkey_export_dsa_raw( key_data(key)->a.privkey, &p, &q, &g, &y, NULL );
+    else
+        return STATUS_INVALID_PARAMETER;
+
+    if (ret)
+    {
+        pgnutls_perror( ret );
+        return STATUS_INTERNAL_ERROR;
+    }
+
+    if (EXPORT_SIZE( q, DSA_V2_GROUP_SIZE, 1 ) > DSA_V2_GROUP_SIZE ||
+        (priv && EXPORT_SIZE( x, DSA_V2_GROUP_SIZE, 1 ) > DSA_V2_GROUP_SIZE))
+    {
+        FIXME( "q of %u bytes not supported\n", q.size );
+        status = STATUS_NOT_SUPPORTED;
+        goto done;
+    }
+
+    *ret_len = sizeof(*blob) + seed_len + DSA_V2_GROUP_SIZE + size * 3 + (priv ? DSA_V2_GROUP_SIZE : 0);
+    if (buf)
+    {
+        if (len < *ret_len)
+        {
+            status = STATUS_BUFFER_TOO_SMALL;
+            goto done;
+        }
+        blob->dwMagic       = priv ? BCRYPT_DSA_PRIVATE_MAGIC_V2 : BCRYPT_DSA_PUBLIC_MAGIC_V2;
+        blob->cbKey         = size;
+        blob->hashAlgorithm = DSA_HASH_ALGORITHM_SHA256;
+        blob->standardVersion = DSA_FIPS186_3;
+        blob->cbSeedLength  = seed_len;
+        blob->cbGroupSize   = DSA_V2_GROUP_SIZE;
+        memset( blob->Count, 0xff, sizeof(blob->Count) );
+
+        dst = (UCHAR *)(blob + 1);
+        memset( dst, 0, seed_len ); /* the seed is not known */
+        dst += seed_len;
+        dst += export_gnutls_datum( dst, DSA_V2_GROUP_SIZE, &q, 1 );
+        dst += export_gnutls_datum( dst, size, &p, 1 );
+        dst += export_gnutls_datum( dst, size, &g, 1 );
+        dst += export_gnutls_datum( dst, size, &y, 1 );
+        if (priv) export_gnutls_datum( dst, DSA_V2_GROUP_SIZE, &x, 1 );
+    }
+
+done:
+    free( p.data ); free( q.data ); free( g.data ); free( y.data ); free( x.data );
+    return status;
+}
+
+static NTSTATUS key_export_dsa( struct key *key, UCHAR *buf, ULONG len, ULONG *ret_len )
+{
+    BCRYPT_DSA_KEY_BLOB *dsa_blob = (BCRYPT_DSA_KEY_BLOB *)buf;
+    gnutls_datum_t p, q, g, y, x;
+    ULONG size = key->u.a.bitlen / 8;
+    NTSTATUS status = STATUS_SUCCESS;
+    UCHAR *dst;
+    int ret;
+
+    if (key->u.a.bitlen > 1024) return key_export_dsa_v2( key, TRUE, buf, len, ret_len );
+    if (!key_data(key)->a.privkey) return STATUS_INVALID_PARAMETER;
+
+    if ((ret = pgnutls_privkey_export_dsa_raw( key_data(key)->a.privkey, &p, &q, &g, &y, &x )))
+    {
+        pgnutls_perror( ret );
+        return STATUS_INTERNAL_ERROR;
+    }
+
+    if (EXPORT_SIZE( q, sizeof(dsa_blob->q), 1 ) > sizeof(dsa_blob->q) || EXPORT_SIZE( x, 20, 1 ) > 20)
+    {
+        status = STATUS_INVALID_PARAMETER;
+        goto done;
+    }
+
+    *ret_len = sizeof(*dsa_blob) + size * 3 + 20;
+    if (buf)
+    {
+        if (len < *ret_len)
+        {
+            status = STATUS_BUFFER_TOO_SMALL;
+            goto done;
+        }
+        dst = (UCHAR *)(dsa_blob + 1);
+        dst += export_gnutls_datum( dst, size, &p, 1 );
+        dst += export_gnutls_datum( dst, size, &g, 1 );
+        dst += export_gnutls_datum( dst, size, &y, 1 );
+        export_gnutls_datum( dst, 20, &x, 1 );
+        export_gnutls_datum( dsa_blob->q, sizeof(dsa_blob->q), &q, 1 );
+
+        dsa_blob->dwMagic = BCRYPT_DSA_PRIVATE_MAGIC;
+        dsa_blob->cbKey   = size;
+        memset( dsa_blob->Count, 0, sizeof(dsa_blob->Count) ); /* FIXME */
+        memset( dsa_blob->Seed, 0, sizeof(dsa_blob->Seed) ); /* FIXME */
+    }
+
+done:
+    free( p.data ); free( q.data ); free( g.data ); free( y.data ); free( x.data );
+    return status;
+}
