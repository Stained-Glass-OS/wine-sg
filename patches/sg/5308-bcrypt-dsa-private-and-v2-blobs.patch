+    ok(ret == STATUS_INVALID_PARAMETER, "got %#lx\n", ret);
+    BCryptDestroyKey(key2);
+    free(buf2);
+    free(buf);
+    BCryptDestroyKey(key);
+
+    BCryptCloseAlgorithmProvider(alg, 0);
