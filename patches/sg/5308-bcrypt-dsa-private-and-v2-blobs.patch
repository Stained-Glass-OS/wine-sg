+    ret = BCryptFinalizeKeyPair(key, 0);
+    ok(!ret, "got %#lx\n", ret);
+    size = 0;
+    ret = BCryptExportKey(key, NULL, BCRYPT_DSA_PRIVATE_BLOB, NULL, 0, &size, 0);
+    ok(!ret, "got %#lx\n", ret);
+    ok(size == sizeof(*blob2) + 32 + 32 + 3 * 256 + 32, "got %lu\n", size);
+    buf = calloc(1, size);
+    ret = BCryptExportKey(key, NULL, BCRYPT_DSA_PRIVATE_BLOB, buf, size, &size, 0);
+    ok(!ret, "got %#lx\n", ret);
+    blob2 = (BCRYPT_DSA_KEY_BLOB_V2 *)buf;
+    ok(blob2->dwMagic == BCRYPT_DSA_PRIVATE_MAGIC_V2, "got %#lx\n", blob2->dwMagic);
+    ok(blob2->cbKey == 256, "got %lu\n", blob2->cbKey);
+    ok(blob2->cbGroupSize == 32, "got %lu\n", blob2->cbGroupSize);
+
+    len = 0;
+    ret = BCryptSignHash(key, NULL, hash, 32, NULL, 0, &len, 0);
+    ok(!ret, "got %#lx\n", ret);
+    ok(len == 64, "got %lu\n", len);
+    ret = BCryptSignHash(key, NULL, hash, 32, sig, sizeof(sig), &len, 0);
+    ok(!ret, "got %#lx\n", ret);
+    ok(len == 64, "got %lu\n", len);
+    ret = BCryptVerifySignature(key, NULL, hash, 32, sig, len, 0);
+    ok(!ret, "got %#lx\n", ret);
+    sig[3] ^= 1;
+    ret = BCryptVerifySignature(key, NULL, hash, 32, sig, len, 0);
+    ok(ret == STATUS_INVALID_SIGNATURE, "got %#lx\n", ret);
