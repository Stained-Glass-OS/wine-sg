+/* FIPS 186-3 DSA: keys over 1024 bits (V2 blobs) take 160/224/256-bit hashes, older keys only SHA-1. */
+static gnutls_digest_algorithm_t get_dsa_digest( ULONG bitlen, ULONG hash_len )
+{
+    if (hash_len == 20) return GNUTLS_DIG_SHA1;
+#ifndef SG_MUTANT_BCRYPT_DSA_V2
+    if (bitlen > 1024)
+    {
+        if (hash_len == 28) return GNUTLS_DIG_SHA224;
+        if (hash_len == 32) return GNUTLS_DIG_SHA256;
+    }
+#endif
+    return GNUTLS_DIG_UNKNOWN;
+}
