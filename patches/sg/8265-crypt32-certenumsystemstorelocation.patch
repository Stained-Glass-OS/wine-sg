From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: CertEnumSystemStoreLocation

CertEnumSystemStoreLocation passes each predefined system store location to the callback, by name with its location ID in the flags; a callback returning FALSE ends the enumeration. It was not exported.
---
--- a/dlls/crypt32/store.c
+++ b/dlls/crypt32/store.c
@@ -2236,3 +2236,47 @@
 {
     CRYPT_InitStore(&empty_store, CERT_STORE_READONLY_FLAG, StoreTypeEmpty, &EmptyStoreVtbl);
 }
+
+#ifndef SG_MUTANT_NO_STORE_LOCATIONS
+/***********************************************************************
+ *		CertEnumSystemStoreLocation (CRYPT32.@)
+ *
+ * (wine-sg 8265) The predefined system store locations, each passed to the callback by name with its
+ * location ID in the flags (CERT_SYSTEM_STORE_*); the callback returning FALSE ends the enumeration.
+ */
+BOOL WINAPI CertEnumSystemStoreLocation(DWORD flags, void *arg, PFN_CERT_ENUM_SYSTEM_STORE_LOCATION enum_func)
+{
+    static const struct { const WCHAR *name; DWORD id; } locations[] =
+    {
+        { L"CurrentUser",             CERT_SYSTEM_STORE_CURRENT_USER_ID },
+        { L"LocalMachine",            CERT_SYSTEM_STORE_LOCAL_MACHINE_ID },
+        { L"CurrentService",          CERT_SYSTEM_STORE_CURRENT_SERVICE_ID },
+        { L"Services",                CERT_SYSTEM_STORE_SERVICES_ID },
+        { L"Users",                   CERT_SYSTEM_STORE_USERS_ID },
+        { L"CurrentUserGroupPolicy",  CERT_SYSTEM_STORE_CURRENT_USER_GROUP_POLICY_ID },
+        { L"LocalMachineGroupPolicy", CERT_SYSTEM_STORE_LOCAL_MACHINE_GROUP_POLICY_ID },
+        { L"LocalMachineEnterprise",  CERT_SYSTEM_STORE_LOCAL_MACHINE_ENTERPRISE_ID },
+    };
+    unsigned int i;
+
+    TRACE("(%#lx, %p, %p)\n", flags, arg, enum_func);
+
+    if (!enum_func)
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    for (i = 0; i < ARRAY_SIZE(locations); i++)
+        if (!enum_func(locations[i].name, locations[i].id << CERT_SYSTEM_STORE_LOCATION_SHIFT, NULL, arg))
+            return FALSE;
+    return TRUE;
+}
+#else
+BOOL WINAPI CertEnumSystemStoreLocation(DWORD flags, void *arg, PFN_CERT_ENUM_SYSTEM_STORE_LOCATION enum_func)
+{
+    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    return FALSE;
+}
+#endif
+
+
--- a/dlls/crypt32/crypt32.spec
+++ b/dlls/crypt32/crypt32.spec
@@ -39,6 +39,7 @@
 @ stdcall CertEnumCertificatesInStore(ptr ptr)
 @ stdcall CertEnumPhysicalStore(ptr long ptr ptr)
 @ stdcall CertEnumSystemStore(long ptr ptr ptr)
+@ stdcall CertEnumSystemStoreLocation(long ptr ptr)
 @ stdcall CertFindAttribute(str long ptr)
 @ stdcall CertFindCRLInStore(ptr long long long ptr ptr)
 @ stdcall CertFindCTLInStore(ptr long long long ptr ptr)
