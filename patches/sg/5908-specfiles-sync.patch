diff --git a/dlls/cng.sys/cng.sys.spec b/dlls/cng.sys/cng.sys.spec
--- a/dlls/cng.sys/cng.sys.spec
+++ b/dlls/cng.sys/cng.sys.spec
@@ -13,7 +13,7 @@
