+/*
+ * Stained Glass OS: Windows programs' way to Stained Glass Firewall
+ *
+ * The firewall is sg-session's sg-firewall. What it is doing -- on or off
+ * for each kind of network, the kind each network in use is -- is in its
+ * status file (/run/stained-glass-firewall/status; SG_FIREWALL_STATUS for
+ * tests), which anyone may read. Changing it is an administrator's: an
+ * elevated program (SYSTEM) files the change with sg-admind, sg-shell's
+ * administration service, whose spool only SYSTEM can write
+ * (/run/stained-glass-admin; SG_ADMIN_SPOOL for tests) -- anyone else gets
+ * ERROR_PRIVILEGE_NOT_HELD, as a standard user is refused on Windows.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_SGFIREWALL_H
+#define __WINE_SGFIREWALL_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* a Unix path from an environment variable (or the default), as \\?\unix\ */
+static inline void sgfw_unix_path( const WCHAR *var, const WCHAR *def, WCHAR *out, size_t len )
+{
+    WCHAR unix_path[MAX_PATH], *p;
+    if (!GetEnvironmentVariableW( var, unix_path, ARRAY_SIZE(unix_path) ) || unix_path[0] != '/')
+        lstrcpynW( unix_path, def, ARRAY_SIZE(unix_path) );
+    swprintf( out, len, L"\\\\?\\unix%s", unix_path );
+    for (p = out; *p; p++) if (*p == '/') *p = '\\';
+}
+
+/* File a request with sg-admind: FIELDS (one per line). WAIT_MS 0: do not
+ * wait for the answer. Returns a Win32 error; *message (if given) gets
+ * sg-admind's FAILED reason. */
+static inline DWORD sgfw_admin_request( const WCHAR *const *fields, int n, DWORD wait_ms, WCHAR *message, size_t mlen )
+{
+    WCHAR dir[MAX_PATH + 16], tmp[MAX_PATH + 80], req[MAX_PATH + 80], rep[MAX_PATH + 80], id[40];
+    static LONG serial;
+    char *body, answer[1024];
+    size_t cap = 64, len = 0;
+    DWORD written, i, err, got;
+    HANDLE file;
+    int k;
+
+    if (message && mlen) message[0] = 0;
+    sgfw_unix_path( L"SG_ADMIN_SPOOL", L"/run/stained-glass-admin", dir, ARRAY_SIZE(dir) );
+    swprintf( id, ARRAY_SIZE(id), L"%08lx%08lx%08lx%08lx", GetCurrentProcessId(), GetCurrentThreadId(),
+              GetTickCount(), (unsigned long)InterlockedIncrement( &serial ) );
+    swprintf( tmp, ARRAY_SIZE(tmp), L"%s\\requests\\.%s", dir, id );
+    swprintf( req, ARRAY_SIZE(req), L"%s\\requests\\%s.req", dir, id );
+    swprintf( rep, ARRAY_SIZE(rep), L"%s\\replies\\%s.rep", dir, id );
+
+    for (k = 0; k < n; k++) cap += wcslen( fields[k] ) * 3 + 1;
+    if (!(body = malloc( cap ))) return ERROR_OUTOFMEMORY;
+    for (k = 0; k < n; k++)
+    {
+        int m;
+        if (wcspbrk( fields[k], L"\r\n" )) { free( body ); return ERROR_INVALID_PARAMETER; }
+        m = WideCharToMultiByte( CP_UTF8, 0, fields[k], -1, body + len, cap - len, NULL, NULL );
+        if (!m) { free( body ); return ERROR_INVALID_PARAMETER; }
+        len += m;
+        body[len - 1] = '\n';
+    }
+
+    /* written under another name and renamed: whole when it appears */
+    file = CreateFileW( tmp, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) { free( body ); return ERROR_PRIVILEGE_NOT_HELD; }
+    err = WriteFile( file, body, len, &written, NULL ) && written == len ? 0 : GetLastError();
+    CloseHandle( file );
+    free( body );
+    if (err || !MoveFileExW( tmp, req, 0 ))
+    {
+        DeleteFileW( tmp );
+        return ERROR_PRIVILEGE_NOT_HELD;
+    }
+    for (i = 0; i < wait_ms / 100; i++)
+    {
+        file = CreateFileW( rep, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL );
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            Sleep( 50 );
+            got = 0;
+            ReadFile( file, answer, sizeof(answer) - 1, &got, NULL );
+            CloseHandle( file );
+            answer[got] = 0;
+            if (!strncmp( answer, "OK", 2 ) && (answer[2] == '\n' || !answer[2])) return ERROR_SUCCESS;
+            if (message && mlen && !strncmp( answer, "FAILED ", 7 ))
+            {
+                char *nl = strchr( answer, '\n' );
+                if (nl) *nl = 0;
+                MultiByteToWideChar( CP_UTF8, 0, answer + 7, -1, message, mlen );
+            }
+            return ERROR_ACCESS_DENIED;
+        }
+        Sleep( 100 );
+    }
+    return wait_ms ? ERROR_TIMEOUT : ERROR_SUCCESS;
+}
+
+/* The firewall's status file (UTF-8, malloc'd), or NULL when it is not running. */
+static inline char *sgfw_status(void)
+{
+    WCHAR path[MAX_PATH + 16];
+    HANDLE file;
+    DWORD size, got = 0;
+    char *text;
+
+    sgfw_unix_path( L"SG_FIREWALL_STATUS", L"/run/stained-glass-firewall/status", path, ARRAY_SIZE(path) );
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    size = GetFileSize( file, NULL );
+    if (size == INVALID_FILE_SIZE || size > (1 << 22) || !(text = malloc( size + 1 )))
+    {
+        CloseHandle( file );
+        return NULL;
+    }
+    ReadFile( file, text, size, &got, NULL );
+    CloseHandle( file );
+    text[got] = 0;
+    if (strncmp( text, "state\trunning", 13 )) { free( text ); return NULL; }
+    return text;
+}
+
+/* the line "KEY\t..." of the status, its rest in out */
+static inline BOOL sgfw_status_line( const char *status, const char *key, char *out, size_t len )
+{
+    size_t k = strlen( key );
+    const char *p = status;
+    while (p && *p)
+    {
+        if (!strncmp( p, key, k ) && p[k] == '\t')
+        {
+            const char *e = strchr( p, '\n' );
+            size_t n = e ? (size_t)(e - p - k - 1) : strlen( p + k + 1 );
+            if (n >= len) n = len - 1;
+            memcpy( out, p + k + 1, n );
+            out[n] = 0;
+            return TRUE;
+        }
+        p = strchr( p, '\n' );
+        if (p) p++;
+    }
+    return FALSE;
+}
+
+/* NET_FW_PROFILE2_* bits: 1 domain, 2 private, 4 public */
+static inline LONG sgfw_profile_bits( const char *names )
+{
+    LONG bits = 0;
+    if (strstr( names, "domain" )) bits |= 1;
+    if (strstr( names, "private" )) bits |= 2;
+    if (strstr( names, "public" )) bits |= 4;
+    return bits;
+}
+
+/* is the firewall on for that kind of network: 1, 0, or -1 when not known */
+static inline int sgfw_profile_on( const char *status, const char *name )
+{
+    char key[32], value[16];
+    snprintf( key, sizeof(key), "profile\t%s", name );
+    if (!status || !sgfw_status_line( status, key, value, sizeof(value) )) return -1;
+    return strcmp( value, "off" ) != 0;
+}
+
+#endif  /* __WINE_SGFIREWALL_H */
