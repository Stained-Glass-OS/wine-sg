+/* Stained Glass OS: a rule a program stores (or removes) is in force at once.
+ * Stained Glass Firewall reads the rules from the machine's registry file,
+ * which wineserver writes only every half minute: the program -- an
+ * installer, elevated -- also hands it to the firewall through sg-admind,
+ * so the program it allows is not asked about when it starts at once. */
+static void firewall_push( const WCHAR *id, const WCHAR *text )
+{
+#ifndef SG_MUTANT_FW_RULES_NOT_PUSHED
+    const WCHAR *fields[] = { L"firewall", L"registry-push", id, text };
+    DWORD err = sgfw_admin_request( fields, text ? 4 : 3, 0, NULL, 0 );
+    if (err) WARN( "the firewall was not told about rule %s: %lu\n", debugstr_w(id), err );
+#endif
+}
+
 /* a stored rule's changes go back to its value */
 static HRESULT rule_save( fw_rule *r )
 {
