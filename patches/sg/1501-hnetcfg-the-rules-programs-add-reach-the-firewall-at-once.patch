 static HRESULT WINAPI fwpolicy2_get_FirewallEnabled(INetFwPolicy2 *iface, NET_FW_PROFILE_TYPE2 profileType, VARIANT_BOOL *enabled)
 {
     TRACE("%p, %d, %p\n", iface, profileType, enabled);
     if (!enabled) return E_POINTER;
     *enabled = VARIANT_TRUE;   /* so installers add the rules they need */
+    /* Stained Glass OS: as Stained Glass Firewall has it, when it runs */
+    if (profile_name( profileType ))
+    {
+        char *status = sgfw_status();
+        if (sgfw_profile_on( status, profile_name( profileType ) ) == 0) *enabled = VARIANT_FALSE;
+        free( status );
+    }
     return S_OK;
 }
 
 static HRESULT WINAPI fwpolicy2_put_FirewallEnabled(INetFwPolicy2 *iface, NET_FW_PROFILE_TYPE2 profileType, VARIANT_BOOL enabled)
 {
-    fw_policy2 *This = impl_from_INetFwPolicy2( iface );
+    /* Stained Glass OS: Stained Glass Firewall, through sg-admind (an
+     * administrator's: anyone else is refused, as on Windows) */
+    WCHAR name[16];
+    const WCHAR *fields[] = { L"firewall", L"profile", name, enabled ? L"on" : L"off" };
+    DWORD err;
+
+    TRACE("%p, %d, %d\n", iface, profileType, enabled);
+    if (profileType == NET_FW_PROFILE2_ALL) lstrcpyW( name, L"all" );
+    else if (profile_name( profileType )) MultiByteToWideChar( CP_ACP, 0, profile_name( profileType ), -1, name, ARRAY_SIZE(name) );
+    else return E_INVALIDARG;
+    err = sgfw_admin_request( fields, 4, 0, NULL, 0 );
+    return err == ERROR_PRIVILEGE_NOT_HELD ? E_ACCESSDENIED : HRESULT_FROM_WIN32( err );
+}
+
+/* Stained Glass OS: the older interfaces' "authorized application" and
+ * "open port" (INetFwMgr, from Windows XP's firewall), which installers
+ * still use, become rules like INetFwPolicy2's */
+HRESULT sg_firewall_add_rule( const WCHAR *name, const WCHAR *app, LONG protocol, const WCHAR *ports, BOOL enabled )
+{
+    INetFwPolicy2 *policy = NULL;
+    INetFwRules *rules = NULL;
+    INetFwRule *rule = NULL;
+    BSTR b;
+    HRESULT hr;
 
-    FIXME("%p %d %d\n", This, profileType, enabled);
-    return E_NOTIMPL;
+    if (FAILED(hr = NetFwPolicy2_create( NULL, (void **)&policy ))) return hr;
+    if (SUCCEEDED(hr = INetFwPolicy2_get_Rules( policy, &rules )) &&
+        SUCCEEDED(hr = NetFwRule_create( NULL, (void **)&rule )))
+    {
+        b = SysAllocString( name ? name : (app ? app : L"Port") );
+        INetFwRule_put_Name( rule, b );
+        SysFreeString( b );
+        if (app)
+        {
+            b = SysAllocString( app );
+            INetFwRule_put_ApplicationName( rule, b );
+            SysFreeString( b );
+        }
+        INetFwRule_put_Protocol( rule, protocol );
+        if (ports)
+        {
+            b = SysAllocString( ports );
+            INetFwRule_put_LocalPorts( rule, b );
+            SysFreeString( b );
+        }
+        INetFwRule_put_Direction( rule, NET_FW_RULE_DIR_IN );
+        INetFwRule_put_Action( rule, NET_FW_ACTION_ALLOW );
+        INetFwRule_put_Profiles( rule, NET_FW_PROFILE2_ALL );
+        INetFwRule_put_Enabled( rule, enabled ? VARIANT_TRUE : VARIANT_FALSE );
+        hr = INetFwRules_Add( rules, rule );
+    }
+    if (rule) INetFwRule_Release( rule );
+    if (rules) INetFwRules_Release( rules );
+    INetFwPolicy2_Release( policy );
+    return hr;
 }
 
