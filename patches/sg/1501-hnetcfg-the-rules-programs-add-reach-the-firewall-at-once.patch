+static const char *profile_name( NET_FW_PROFILE_TYPE2 type )
+{
+    switch (type)
+    {
+    case NET_FW_PROFILE2_DOMAIN: return "domain";
+    case NET_FW_PROFILE2_PRIVATE: return "private";
+    case NET_FW_PROFILE2_PUBLIC: return "public";
+    default: return NULL;
+    }
+}
