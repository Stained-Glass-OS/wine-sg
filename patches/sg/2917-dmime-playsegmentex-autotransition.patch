From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dmime: PlaySegmentEx DMUS_SEGF_AUTOTRANSITION

IDirectMusicPerformance8::PlaySegmentEx with DMUS_SEGF_AUTOTRANSITION and a
transition template. The template (IDirectMusicSegment8) composes a
transition (Compose, patch 2915) from the primary segment which plays now to
the segment; the transition plays at the start time with the given flags and
"from" argument, and the segment follows at the exact end of the transition
(in music time, without further resolution or queueing). The returned
segment state is the segment's. A template which is not a segment is
E_NOINTERFACE; without a template (or without the flag) the segment plays
as it does without a transition.
---
diff --git a/dlls/dmime/performance.c b/dlls/dmime/performance.c
index 39d2349..5bab87a 100644
--- a/dlls/dmime/performance.c
+++ b/dlls/dmime/performance.c
@@ -2261,6 +2261,54 @@ static BOOL segment_find_valid_start(IDirectMusicSegment *segment, DWORD flags,
     return FALSE;
 }
 
+/* DMUS_SEGF_AUTOTRANSITION: the transition template composes a transition from the primary segment which plays
+ * to the segment, the transition plays at the start time and the segment follows when it ends. */
+static HRESULT performance_play_transition(IDirectMusicPerformance8 *iface, IDirectMusicSegment *segment,
+        IUnknown *transition, DWORD flags, INT64 start_time, IDirectMusicSegmentState **segment_state,
+        IUnknown *from, IUnknown *audio_path)
+{
+    static const DWORD resolve_flags = DMUS_SEGF_AFTERPREPARETIME | DMUS_SEGF_AFTERQUEUETIME
+            | DMUS_SEGF_AFTERLATENCYTIME | DMUS_SEGF_GRID | DMUS_SEGF_BEAT | DMUS_SEGF_MEASURE
+            | DMUS_SEGF_MARKER | DMUS_SEGF_SEGMENTEND | DMUS_SEGF_DEFAULT | DMUS_SEGF_QUEUE;
+    struct performance *This = impl_from_IDirectMusicPerformance8(iface);
+    IDirectMusicSegmentState *transition_state;
+    IDirectMusicSegment *current = NULL, *composed;
+    IDirectMusicSegment8 *template;
+    MUSIC_TIME start, length;
+    HRESULT hr;
+
+    if (FAILED(hr = IUnknown_QueryInterface(transition, &IID_IDirectMusicSegment8, (void **)&template)))
+        return hr;
+
+    EnterCriticalSection(&This->safe);
+    if ((current = This->primary_segment)) IDirectMusicSegment_AddRef(current);
+    LeaveCriticalSection(&This->safe);
+
+    hr = IDirectMusicSegment8_Compose(template, 0, current, segment, &composed);
+    IDirectMusicSegment8_Release(template);
+    if (current) IDirectMusicSegment_Release(current);
+    if (FAILED(hr)) return hr;
+
+    hr = IDirectMusicPerformance8_PlaySegmentEx(iface, (IUnknown *)composed, NULL, NULL,
+            flags & ~DMUS_SEGF_AUTOTRANSITION, start_time, &transition_state, from, audio_path);
+    if (SUCCEEDED(hr))
+    {
+        IDirectMusicSegmentState_GetStartTime(transition_state, &start);
+        IDirectMusicSegment_GetLength(composed, &length);
+        IDirectMusicSegmentState_Release(transition_state);
+
+        /* the segment follows the transition, exactly at its end */
+#ifdef SG_MUTANT_TRANSITION_END
+        length = 0;
+#endif
+        hr = IDirectMusicPerformance8_PlaySegmentEx(iface, (IUnknown *)segment, NULL, NULL,
+                flags & ~(DMUS_SEGF_AUTOTRANSITION | DMUS_SEGF_REFTIME | resolve_flags), start + length,
+                segment_state, NULL, audio_path);
+    }
+    IDirectMusicSegment_Release(composed);
+    return hr;
+}
+
 static HRESULT WINAPI performance_PlaySegmentEx(IDirectMusicPerformance8 *iface, IUnknown *source,
         WCHAR *segment_name, IUnknown *transition, DWORD segment_flags, INT64 start_time,
         IDirectMusicSegmentState **segment_state, IUnknown *from, IUnknown *audio_path)
@@ -2273,6 +2321,7 @@ static HRESULT WINAPI performance_PlaySegmentEx(IDirectMusicPerformance8 *iface,
     static const DWORD handled_flags = DMUS_SEGF_REFTIME | DMUS_SEGF_SECONDARY | DMUS_SEGF_CONTROL
             | DMUS_SEGF_DEFAULT | DMUS_SEGF_QUEUE | DMUS_SEGF_NOINVALIDATE | DMUS_SEGF_ALIGN
             | DMUS_SEGF_TIMESIG_ALWAYS | DMUS_SEGF_USE_AUDIOPATH | DMUS_SEGF_INVALIDATE_PRI
+            | DMUS_SEGF_AUTOTRANSITION
             | valid_start_flags | resolve_flags;
     BOOL primary = !(segment_flags & DMUS_SEGF_SECONDARY), control = (segment_flags & DMUS_SEGF_CONTROL);
     struct performance *This = impl_from_IDirectMusicPerformance8(iface);
@@ -2289,7 +2338,6 @@ static HRESULT WINAPI performance_PlaySegmentEx(IDirectMusicPerformance8 *iface,
             transition, segment_flags, start_time, segment_state, from, audio_path);
 
     if (segment_flags & ~handled_flags) FIXME("flags %#lx not implemented\n", segment_flags & ~handled_flags);
-    if (segment_flags & DMUS_SEGF_AUTOTRANSITION) FIXME("transition %p not implemented\n", transition);
 
     if (!source) return E_POINTER;
     if (!This->dmusic) return DMUS_E_NO_MASTER_CLOCK;
@@ -2303,6 +2351,13 @@ static HRESULT WINAPI performance_PlaySegmentEx(IDirectMusicPerformance8 *iface,
         return hr;
     }
 
+    if ((segment_flags & DMUS_SEGF_AUTOTRANSITION) && transition)
+    {
+        hr = performance_play_transition(iface, segment, transition, segment_flags, start_time, segment_state,
+                from, audio_path);
+        goto done;
+    }
+
     /* the segment state, or all of an audio path, which the new segment replaces at its start */
     if (from && FAILED(IUnknown_QueryInterface(from, &IID_IDirectMusicSegmentState, (void **)&from_state))
             && FAILED(IUnknown_QueryInterface(from, &IID_IDirectMusicAudioPath, (void **)&from_path)))
