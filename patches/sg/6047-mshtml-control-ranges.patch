+/* Stained Glass OS: body.createControlRange() gave E_NOTIMPL. HTML editors of older programs (mail
+ * composers, help authoring, CMS editors in a WebBrowser control) select an image or a table as a
+ * control range, then ask it for its elements, run commands on them (Delete, Copy, JustifyCenter) or
+ * select them. The range keeps its elements; select() makes the document's selection cover them; the
+ * commands are the document's, run on that selection. */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "ole2.h"
+
+#include "wine/debug.h"
+
+#include "mshtml_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mshtml);
+
+typedef struct {
+    DispatchEx dispex;
+    IHTMLControlRange IHTMLControlRange_iface;
+
+    HTMLDocumentNode *doc;
+    HTMLElement **elems;
+    unsigned count, size;
+} HTMLControlRange;
+
+static inline HTMLControlRange *impl_from_IHTMLControlRange(IHTMLControlRange *iface)
+{
+    return CONTAINING_RECORD(iface, HTMLControlRange, IHTMLControlRange_iface);
+}
+
+DISPEX_IDISPATCH_IMPL(HTMLControlRange, IHTMLControlRange, impl_from_IHTMLControlRange(iface)->dispex)
+
+/* the document's selection covers the range's elements (its first one: a selection of several
+ * controls is not kept apart here) */
+static HRESULT control_range_select(IHTMLControlRange *iface)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+    nsISelection *nsselection;
+    nsIDOMRange *nsrange;
+    nsresult nsres;
+    unsigned i;
+
+    TRACE("(%p)\n", This);
+
+    if(!This->doc || !This->doc->window || !This->doc->dom_document)
+        return E_FAIL;
+    nsres = nsIDOMWindow_GetSelection(This->doc->window->dom_window, &nsselection);
+    if(NS_FAILED(nsres))
+        return E_FAIL;
+    nsISelection_RemoveAllRanges(nsselection);
+    for(i = 0; i < This->count; i++) {
+        nsres = nsIDOMDocument_CreateRange(This->doc->dom_document, &nsrange);
+        if(NS_FAILED(nsres))
+            break;
+        if(NS_SUCCEEDED(nsIDOMRange_SelectNode(nsrange, This->elems[i]->node.nsnode)))
+            nsISelection_AddRange(nsselection, nsrange);
+        nsIDOMRange_Release(nsrange);
+    }
+    nsISelection_Release(nsselection);
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLControlRange_select_(IHTMLControlRange *iface)
+{
+    return control_range_select(iface);
+}
+
+static HRESULT WINAPI HTMLControlRange_add(IHTMLControlRange *iface, IHTMLControlElement *item)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+    IHTMLElement *elem_iface;
+    HTMLElement *elem;
+    unsigned i;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, item);
+
+    if(!item)
+        return E_INVALIDARG;
+    hres = IHTMLControlElement_QueryInterface(item, &IID_IHTMLElement, (void**)&elem_iface);
+    if(FAILED(hres))
+        return E_INVALIDARG;
+    elem = unsafe_impl_from_IHTMLElement(elem_iface);
+    IHTMLElement_Release(elem_iface);
+    if(!elem)
+        return E_INVALIDARG;
+    /* an element is in a range once */
+    for(i = 0; i < This->count; i++)
+        if(This->elems[i] == elem)
+            return S_OK;
+    if(This->count == This->size) {
+        unsigned size = This->size ? This->size * 2 : 4;
+        HTMLElement **grown = realloc(This->elems, size * sizeof(*grown));
+        if(!grown)
+            return E_OUTOFMEMORY;
+        This->elems = grown;
+        This->size = size;
+    }
+    node_addref(&elem->node);
+    This->elems[This->count++] = elem;
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLControlRange_remove(IHTMLControlRange *iface, LONG index)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+    HTMLElement *elem;
+
+    TRACE("(%p)->(%ld)\n", This, index);
+
+    if(index < 0 || index >= (LONG)This->count)
+        return E_INVALIDARG;
+    elem = This->elems[index];
+    memmove(This->elems + index, This->elems + index + 1, (This->count - index - 1) * sizeof(*This->elems));
+    This->count--;
+    node_release(&elem->node);
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLControlRange_item(IHTMLControlRange *iface, LONG index, IHTMLElement **pdisp)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+
+    TRACE("(%p)->(%ld %p)\n", This, index, pdisp);
+
+    if(!pdisp)
+        return E_POINTER;
+    *pdisp = NULL;
+    if(index < 0 || index >= (LONG)This->count)
+        return E_INVALIDARG;
+    *pdisp = &This->elems[index]->IHTMLElement_iface;
+    IHTMLElement_AddRef(*pdisp);
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLControlRange_scrollIntoView(IHTMLControlRange *iface, VARIANT varargStart)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+
+    TRACE("(%p)->(%s)\n", This, debugstr_variant(&varargStart));
+
+    if(!This->count)
+        return S_OK;
+    return IHTMLElement_scrollIntoView(&This->elems[0]->IHTMLElement_iface, varargStart);
+}
+
+/* the commands are the document's, on the range's elements selected */
+static IHTMLDocument2 *range_document(HTMLControlRange *This)
+{
+    return This->doc ? &This->doc->IHTMLDocument2_iface : NULL;
+}
+
+static HRESULT WINAPI HTMLControlRange_queryCommandSupported(IHTMLControlRange *iface, BSTR cmdID, VARIANT_BOOL *pfRet)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+    IHTMLDocument2 *doc = range_document(This);
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(cmdID), pfRet);
+    if(!doc)
+        return E_FAIL;
+    return IHTMLDocument2_queryCommandSupported(doc, cmdID, pfRet);
+}
+
+static HRESULT WINAPI HTMLControlRange_queryCommandEnabled(IHTMLControlRange *iface, BSTR cmdID, VARIANT_BOOL *pfRet)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+    IHTMLDocument2 *doc = range_document(This);
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(cmdID), pfRet);
+    if(!doc)
+        return E_FAIL;
+    return IHTMLDocument2_queryCommandEnabled(doc, cmdID, pfRet);
+}
+
+static HRESULT WINAPI HTMLControlRange_queryCommandState(IHTMLControlRange *iface, BSTR cmdID, VARIANT_BOOL *pfRet)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+    IHTMLDocument2 *doc = range_document(This);
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(cmdID), pfRet);
+    if(!doc)
+        return E_FAIL;
+    return IHTMLDocument2_queryCommandState(doc, cmdID, pfRet);
+}
+
+static HRESULT WINAPI HTMLControlRange_queryCommandIndeterm(IHTMLControlRange *iface, BSTR cmdID, VARIANT_BOOL *pfRet)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+    IHTMLDocument2 *doc = range_document(This);
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(cmdID), pfRet);
+    if(!doc)
+        return E_FAIL;
+    return IHTMLDocument2_queryCommandIndeterm(doc, cmdID, pfRet);
+}
+
+static HRESULT WINAPI HTMLControlRange_queryCommandText(IHTMLControlRange *iface, BSTR cmdID, BSTR *pcmdText)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+    IHTMLDocument2 *doc = range_document(This);
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(cmdID), pcmdText);
+    if(!doc)
+        return E_FAIL;
+    return IHTMLDocument2_queryCommandText(doc, cmdID, pcmdText);
+}
+
+static HRESULT WINAPI HTMLControlRange_queryCommandValue(IHTMLControlRange *iface, BSTR cmdID, VARIANT *pcmdValue)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+    IHTMLDocument2 *doc = range_document(This);
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(cmdID), pcmdValue);
+    if(!doc)
+        return E_FAIL;
+    return IHTMLDocument2_queryCommandValue(doc, cmdID, pcmdValue);
+}
+
+static HRESULT WINAPI HTMLControlRange_execCommand(IHTMLControlRange *iface, BSTR cmdID, VARIANT_BOOL showUI,
+        VARIANT value, VARIANT_BOOL *pfRet)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+    IHTMLDocument2 *doc = range_document(This);
+    HRESULT hres;
+
+    TRACE("(%p)->(%s %x %s %p)\n", This, debugstr_w(cmdID), showUI, debugstr_variant(&value), pfRet);
+    if(!doc)
+        return E_FAIL;
+    /* Delete removes the controls themselves (the editor's command would only empty a table) */
+    if(cmdID && !wcsicmp(cmdID, L"delete")) {
+        unsigned i;
+        for(i = 0; i < This->count; i++) {
+            IHTMLDOMNode *removed = NULL;
+            IHTMLDOMNode_removeNode(&This->elems[i]->node.IHTMLDOMNode_iface, VARIANT_TRUE, &removed);
+            if(removed)
+                IHTMLDOMNode_Release(removed);
+        }
+        if(pfRet)
+            *pfRet = VARIANT_TRUE;
+        return S_OK;
+    }
+    if(FAILED(hres = control_range_select(iface)))
+        return hres;
+    return IHTMLDocument2_execCommand(doc, cmdID, showUI, value, pfRet);
+}
+
+static HRESULT WINAPI HTMLControlRange_execCommandShowHelp(IHTMLControlRange *iface, BSTR cmdID, VARIANT_BOOL *pfRet)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+    IHTMLDocument2 *doc = range_document(This);
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(cmdID), pfRet);
+    if(!doc)
+        return E_FAIL;
+    return IHTMLDocument2_execCommandShowHelp(doc, cmdID, pfRet);
+}
+
+/* the nearest element that contains all of the range's elements */
+static HRESULT WINAPI HTMLControlRange_commonParentElement(IHTMLControlRange *iface, IHTMLElement **parent)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+    IHTMLElement *candidate, *next;
+    unsigned i;
+
+    TRACE("(%p)->(%p)\n", This, parent);
+
+    if(!parent)
+        return E_POINTER;
+    *parent = NULL;
+    if(!This->count)
+        return S_OK;
+    /* start from the first element's parent (IE gives the parent even for one element) */
+    if(FAILED(IHTMLElement_get_parentElement(&This->elems[0]->IHTMLElement_iface, &candidate)) || !candidate)
+        return S_OK;
+    for(;;) {
+        VARIANT_BOOL contains_all = VARIANT_TRUE;
+        IHTMLElement *elem_iface;
+
+        for(i = 1; i < This->count && contains_all; i++) {
+            VARIANT_BOOL contains = VARIANT_FALSE;
+            elem_iface = &This->elems[i]->IHTMLElement_iface;
+            if(FAILED(IHTMLElement_contains(candidate, elem_iface, &contains)))
+                contains = VARIANT_FALSE;
+            contains_all = contains;
+        }
+#ifdef SG_MUTANT_CTRLRANGE_FIRST_PARENT
+        contains_all = VARIANT_TRUE;
+#endif
+        if(contains_all)
+            break;
+        next = NULL;
+        IHTMLElement_get_parentElement(candidate, &next);
+        IHTMLElement_Release(candidate);
+        if(!(candidate = next))
+            return S_OK;
+    }
+    *parent = candidate;
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLControlRange_get_length(IHTMLControlRange *iface, LONG *p)
+{
+    HTMLControlRange *This = impl_from_IHTMLControlRange(iface);
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    if(!p)
+        return E_POINTER;
+    *p = This->count;
+    return S_OK;
+}
+
+static const IHTMLControlRangeVtbl HTMLControlRangeVtbl = {
+    HTMLControlRange_QueryInterface,
+    HTMLControlRange_AddRef,
+    HTMLControlRange_Release,
+    HTMLControlRange_GetTypeInfoCount,
+    HTMLControlRange_GetTypeInfo,
+    HTMLControlRange_GetIDsOfNames,
+    HTMLControlRange_Invoke,
+    HTMLControlRange_select_,
+    HTMLControlRange_add,
+    HTMLControlRange_remove,
+    HTMLControlRange_item,
+    HTMLControlRange_scrollIntoView,
+    HTMLControlRange_queryCommandSupported,
+    HTMLControlRange_queryCommandEnabled,
+    HTMLControlRange_queryCommandState,
+    HTMLControlRange_queryCommandIndeterm,
+    HTMLControlRange_queryCommandText,
+    HTMLControlRange_queryCommandValue,
+    HTMLControlRange_execCommand,
+    HTMLControlRange_execCommandShowHelp,
+    HTMLControlRange_commonParentElement,
+    HTMLControlRange_get_length
+};
+
+static inline HTMLControlRange *HTMLControlRange_from_DispatchEx(DispatchEx *iface)
+{
+    return CONTAINING_RECORD(iface, HTMLControlRange, dispex);
+}
+
+static void *HTMLControlRange_query_interface(DispatchEx *dispex, REFIID riid)
+{
+    HTMLControlRange *This = HTMLControlRange_from_DispatchEx(dispex);
+
+    if(IsEqualGUID(&IID_IHTMLControlRange, riid))
+        return &This->IHTMLControlRange_iface;
+    return NULL;
+}
+
+static void HTMLControlRange_traverse(DispatchEx *dispex, nsCycleCollectionTraversalCallback *cb)
+{
+    HTMLControlRange *This = HTMLControlRange_from_DispatchEx(dispex);
+    unsigned i;
+
+    for(i = 0; i < This->count; i++)
+        note_cc_edge((nsISupports*)&This->elems[i]->node.IHTMLDOMNode_iface, "elem", cb);
+    if(This->doc)
+        note_cc_edge((nsISupports*)&This->doc->node.IHTMLDOMNode_iface, "doc", cb);
+}
+
+static void HTMLControlRange_unlink(DispatchEx *dispex)
+{
+    HTMLControlRange *This = HTMLControlRange_from_DispatchEx(dispex);
+    unsigned i, count = This->count;
+    HTMLDocumentNode *doc = This->doc;
+
+    This->count = 0;
+    for(i = 0; i < count; i++)
+        node_release(&This->elems[i]->node);
+    if(doc) {
+        This->doc = NULL;
+        node_release(&doc->node);
+    }
+}
+
+static void HTMLControlRange_destructor(DispatchEx *dispex)
+{
+    HTMLControlRange *This = HTMLControlRange_from_DispatchEx(dispex);
+    free(This->elems);
+    free(This);
+}
+
+static const dispex_static_data_vtbl_t HTMLControlRange_dispex_vtbl = {
+    .query_interface  = HTMLControlRange_query_interface,
+    .destructor       = HTMLControlRange_destructor,
+    .traverse         = HTMLControlRange_traverse,
+    .unlink           = HTMLControlRange_unlink
+};
+
+static const tid_t HTMLControlRange_iface_tids[] = {
+    IHTMLControlRange_tid,
+    0
+};
+static dispex_static_data_t HTMLControlRange_dispex = {
+    .name       = "ControlRangeCollection",
+    .vtbl       = &HTMLControlRange_dispex_vtbl,
+    .disp_tid   = IHTMLControlRange_tid,
+    .iface_tids = HTMLControlRange_iface_tids,
+};
+
+HRESULT HTMLControlRange_Create(HTMLDocumentNode *doc, IDispatch **ret)
+{
+    HTMLControlRange *range;
+
+    if(!(range = calloc(1, sizeof(*range))))
+        return E_OUTOFMEMORY;
+    range->IHTMLControlRange_iface.lpVtbl = &HTMLControlRangeVtbl;
+    init_dispatch(&range->dispex, &HTMLControlRange_dispex, doc->script_global,
+                  dispex_compat_mode(&doc->node.event_target.dispex));
+    range->doc = doc;
+    node_addref(&doc->node);
+    *ret = (IDispatch*)&range->IHTMLControlRange_iface;
+    return S_OK;
+}
