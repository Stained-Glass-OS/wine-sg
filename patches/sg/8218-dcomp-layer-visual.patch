From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dcomp: Windows.UI.Composition LayerVisual

ICompositor2::CreateLayerVisual was E_NOTIMPL. A LayerVisual is a container visual with ILayerVisual (Effect: kept, the children drawn without it) and ILayerVisual2 (Shadow: kept, not drawn yet). Interface identity per windows-rs 0.30 (MIT OR Apache-2.0).
---
--- a/dlls/dcomp/composition.c
+++ b/dlls/dcomp/composition.c
@@ -121,6 +121,8 @@
 static const GUID IID_ICompositionNineGridBrush_x = { 0xf25154e4, 0xbc8c, 0x4be7, { 0xb8, 0x0f, 0x86, 0x85, 0xb8, 0x3c, 0x01, 0x86 } };
 static const GUID IID_ICompositionBackdropBrush_x = { 0xc5acae58, 0x3898, 0x499e, { 0x8d, 0x7f, 0x22, 0x4e, 0x91, 0x28, 0x6a, 0x5d } };
 static const GUID IID_ISpriteVisual2_x = { 0x588c9664, 0x997a, 0x4850, { 0x91, 0xfe, 0x53, 0xcb, 0x58, 0xf8, 0x1c, 0xe9 } };
+static const GUID IID_ILayerVisual_x = { 0xaf843985, 0x0444, 0x4887, { 0x8e, 0x83, 0xb4, 0x0b, 0x25, 0x3f, 0x82, 0x2c } };
+static const GUID IID_ILayerVisual2_x = { 0x98f9aeeb, 0x6f23, 0x49f1, { 0x90, 0xb1, 0x1f, 0x59, 0xa1, 0x4f, 0xbc, 0xe3 } };
 static const WCHAR class_drop_shadow[] = L"Windows.UI.Composition.DropShadow";
 static const WCHAR class_nine_grid_brush[] = L"Windows.UI.Composition.CompositionNineGridBrush";
 static const WCHAR class_backdrop_brush[] = L"Windows.UI.Composition.CompositionBackdropBrush";
@@ -144,7 +146,11 @@
 
     struct compositor *compositor;
     BOOL sprite;
-    IInspectable *shadow;       /* ISpriteVisual2.Shadow: kept, not drawn yet */
+    IInspectable *shadow;       /* ISpriteVisual2.Shadow (ILayerVisual2.Shadow): kept, not drawn yet */
+    BOOL layer;                 /* (8217) a LayerVisual: a container whose Effect is kept, not applied */
+    struct { const void * const *vtbl; } ILayerVisual_iface;
+    struct { const void * const *vtbl; } ILayerVisual2_iface;
+    ICompositionBrush *layer_effect;
     BOOL shape_visual;                          /* a ShapeVisual (wine-sg 6265) */
     struct { const void * const *vtbl; } IShapeVisual_iface;
     IInspectable *shapes, *view_box;            /* its CompositionShapeCollection and CompositionViewBox */
@@ -221,6 +227,10 @@
     else if (impl->sprite && IsEqualGUID( iid, &IID_ISpriteVisual2_x ))
         *out = &impl->ISpriteVisual2_iface;
 #endif
+    else if (impl->layer && IsEqualGUID( iid, &IID_ILayerVisual_x ))
+        *out = &impl->ILayerVisual_iface;
+    else if (impl->layer && IsEqualGUID( iid, &IID_ILayerVisual2_x ))
+        *out = &impl->ILayerVisual2_iface;
     else if (IsEqualGUID( iid, &IID_ICompositionObject4_x ))
         *out = &impl->ICompositionObject4_iface;
     else if (IsEqualGUID( iid, &IID_ICompositionObject ))
@@ -267,6 +277,7 @@
         if (impl->clip) ICompositionClip_Release( impl->clip );
         if (impl->brush) ICompositionBrush_Release( impl->brush );
         if (impl->shadow) IInspectable_Release( impl->shadow );
+        if (impl->layer_effect) ICompositionBrush_Release( impl->layer_effect );
         if (impl->shapes) IInspectable_Release( impl->shapes );
         if (impl->view_box) IInspectable_Release( impl->view_box );
         if (impl->implicit) IImplicitAnimationCollection_Release( impl->implicit );
@@ -283,6 +294,12 @@
 {
     struct visual *impl = impl_from_IVisual( iface );
     static const IID *const list[] = { &IID_IVisual, &IID_IContainerVisual, &IID_ISpriteVisual, &IID_ICompositionObject, &IID_ICompositionObject2, &IID_IClosable };
+    if (impl->layer)
+    {
+        static const IID *const layer[] = { &IID_ILayerVisual_x, &IID_ILayerVisual2_x, &IID_IContainerVisual, &IID_IVisual,
+                                            &IID_ICompositionObject, &IID_ICompositionObject2, &IID_IClosable };
+        return get_iids( iid_count, iids, layer, ARRAY_SIZE(layer) );
+    }
     if (!impl->sprite)
     {
         static const IID *const plain[] = { &IID_IVisual, &IID_IContainerVisual, &IID_ICompositionObject, &IID_ICompositionObject2, &IID_IClosable };
@@ -295,6 +312,7 @@
 {
     struct visual *impl = impl_from_IVisual( iface );
     return runtime_class_name( impl->shape_visual ? L"Windows.UI.Composition.ShapeVisual"
+                               : impl->layer ? L"Windows.UI.Composition.LayerVisual"
                                : impl->sprite ? class_sprite_visual : class_container_visual, class_name );
 }
 
@@ -697,6 +715,54 @@
     sprite2_GetTrustLevel, sprite2_get_Shadow, sprite2_put_Shadow,
 };
 
+/* ILayerVisual / ILayerVisual2 (8217): a LayerVisual's Effect (a CompositionEffectBrush over its flattened
+ * children; kept, the children drawn as they are) and Shadow (kept, not drawn yet) */
+SG_VOID_IINSPECTABLE( layer, struct visual, ILayerVisual_iface, IVisual, IVisual_iface )
+
+static HRESULT WINAPI layer_get_Effect( void *iface, ICompositionBrush **value )
+{
+    struct visual *impl = layer_impl( iface );
+    if (!value) return E_POINTER;
+    if ((*value = impl->layer_effect)) ICompositionBrush_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI layer_put_Effect( void *iface, ICompositionBrush *value )
+{
+    struct visual *impl = layer_impl( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (value) ICompositionBrush_AddRef( value );
+    if (impl->layer_effect) ICompositionBrush_Release( impl->layer_effect );
+    impl->layer_effect = value;
+    compositor_changed( impl->compositor );
+    return S_OK;
+}
+
+static const void * const layer_vtbl[] =
+{
+    layer_QueryInterface, layer_AddRef, layer_Release, layer_GetIids, layer_GetRuntimeClassName,
+    layer_GetTrustLevel, layer_get_Effect, layer_put_Effect,
+};
+
+SG_VOID_IINSPECTABLE( layer2, struct visual, ILayerVisual2_iface, IVisual, IVisual_iface )
+
+static HRESULT WINAPI layer2_get_Shadow( void *iface, IInspectable **value )
+{
+    return sprite2_get_Shadow( &layer2_impl( iface )->ISpriteVisual2_iface, value );
+}
+
+static HRESULT WINAPI layer2_put_Shadow( void *iface, IInspectable *value )
+{
+    return sprite2_put_Shadow( &layer2_impl( iface )->ISpriteVisual2_iface, value );
+}
+
+static const void * const layer2_vtbl[] =
+{
+    layer2_QueryInterface, layer2_AddRef, layer2_Release, layer2_GetIids, layer2_GetRuntimeClassName,
+    layer2_GetTrustLevel, layer2_get_Shadow, layer2_put_Shadow,
+};
+
 /* what StartAnimation animates on a visual */
 static BOOL visual_animatable( void *impl, const WCHAR *name, struct anim_property *prop )
 {
@@ -954,6 +1020,8 @@
     impl->IClosable_iface.lpVtbl = &visual_closable_vtbl;
     impl->IVisual2_iface.lpVtbl = &visual2_vtbl;
     impl->ISpriteVisual2_iface.vtbl = sprite2_vtbl;
+    impl->ILayerVisual_iface.vtbl = layer_vtbl;
+    impl->ILayerVisual2_iface.vtbl = layer2_vtbl;
     impl->ref = 1;
     impl->compositor = compositor;
     ICompositor_AddRef( (ICompositor *)compositor );
@@ -4939,7 +5007,23 @@
 }
 #endif
 COMPOSITOR2_NOT_MADE( CreateDistantLight )
+#ifdef SG_MUTANT_NO_LAYER_VISUAL
 COMPOSITOR2_NOT_MADE( CreateLayerVisual )
+#else
+/* (8217) a LayerVisual: a container visual with an Effect and a Shadow */
+static HRESULT WINAPI compositor2_CreateLayerVisual( void *iface, void **out )
+{
+    struct visual *visual;
+    HRESULT hr;
+
+    TRACE( "iface %p, out %p.\n", iface, out );
+    if (!out) return E_POINTER;
+    if (FAILED(hr = visual_create( impl_from_compositor2( iface ), FALSE, &visual ))) return hr;
+    visual->layer = TRUE;
+    *out = &visual->ILayerVisual_iface;
+    return S_OK;
+}
+#endif
 #ifdef SG_MUTANT_NO_COMPOSITOR2_OBJECTS
 COMPOSITOR2_NOT_MADE( CreateBackdropBrush )
 COMPOSITOR2_NOT_MADE( CreateDropShadow )
