From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wininet: what Windows does, from the todo_wine checks of Wine's tests (all twelve removed)

Twelve todo_wine checks in wininet's internet tests record what real Windows
does. They pass now and the marks are gone.

- A cookie cannot be set for a domain that is a public suffix: two labels, a
  country code last and a generic second level first ("co.uk", "com.pl",
  "gov.au"). IsDomainLegalCookieDomainW says so too (and is no longer a
  semi-stub).
- InternetGetCookie of a string that is no URL fails with
  ERROR_INTERNET_UNRECOGNIZED_SCHEME, as InternetSetCookie does.
- Proxy and direct together in INTERNET_PER_CONN_FLAGS read back as direct.
- InternetTimeToSystemTime reads the C library's asctime layout
  ("Fri Jan 7 12:06:35 2005", with or without a zone).
- DetectAutoProxyUrl no longer says "not implemented": it looks for a host
  "wpad" in the computer's DNS domain and gives its wpad.dat address, else
  fails with ERROR_WINHTTP_AUTODETECTION_FAILED and an empty string (DHCP
  option 252 cannot be read from here).
---
--- a/dlls/wininet/cookie.c
+++ b/dlls/wininet/cookie.c
@@ -741,9 +741,14 @@ BOOL WINAPI InternetGetCookieExW(LPCWSTR lpszUrl, LPCWSTR lpszCookieName,
         return FALSE;
     }
 
+    SetLastError(0);
     ret = cookie_parse_url(lpszUrl, &host, &path);
     if (!ret) {
-        SetLastError(ERROR_INVALID_PARAMETER);
+        /* a string that is no URL at all is an unrecognized scheme, as for InternetSetCookie */
+#ifndef SG_MUTANT_WI_GETERR
+        if (GetLastError() != ERROR_INTERNET_UNRECOGNIZED_SCHEME)
+#endif
+            SetLastError(ERROR_INVALID_PARAMETER);
         return FALSE;
     }
 
@@ -943,6 +948,25 @@ BOOL WINAPI InternetGetCookieA(const char *url, const char *name, char *data, DW
     return InternetGetCookieExA(url, name, data, size, 0, NULL);
 }
 
+/* A domain of two labels whose last is a country code and whose first is one of the
+ * usual second-level names ("co.uk", "com.pl", "gov.au") is a public suffix, not
+ * a site: no cookie may be set for it. Windows does this and the Wine test records it. */
+static BOOL is_public_suffix_domain(substr_t domain)
+{
+    static const WCHAR *generic[] = { L"com", L"co", L"net", L"org", L"edu", L"gov", L"mil", L"ac", L"or", L"ne", L"go",
+                                      L"ltd", L"plc", L"sch", L"nic", L"info", L"biz" };
+    const WCHAR *dot = wmemchr(domain.str, '.', domain.len), *last;
+    size_t i, first_len;
+
+    if (!dot || wmemchr(dot + 1, '.', domain.len - (dot + 1 - domain.str))) return FALSE;  /* not exactly two labels */
+    last = dot + 1;
+    if (domain.str + domain.len - last != 2) return FALSE;                               /* not a country code */
+    first_len = dot - domain.str;
+    for (i = 0; i < ARRAY_SIZE(generic); i++)
+        if (wcslen(generic[i]) == first_len && !wcsnicmp(generic[i], domain.str, first_len)) return TRUE;
+    return FALSE;
+}
+
 static BOOL is_domain_legal_for_cookie(substr_t domain, substr_t full_domain)
 {
     const WCHAR *ptr;
@@ -954,6 +978,10 @@ static BOOL is_domain_legal_for_cookie(substr_t domain, substr_t full_domain)
 
     if(domain.len > full_domain.len || !wmemchr(domain.str, '.', domain.len) || !wmemchr(full_domain.str, '.', full_domain.len))
         return FALSE;
+#ifndef SG_MUTANT_WI_SUFFIX
+    if(is_public_suffix_domain(domain))
+        return FALSE;
+#endif
 
     ptr = full_domain.str + full_domain.len - domain.len;
     if (wcsnicmp(domain.str, ptr, domain.len) || (full_domain.len > domain.len && ptr[-1] != '.')) {
@@ -969,7 +997,7 @@ static BOOL is_domain_legal_for_cookie(substr_t domain, substr_t full_domain)
  */
 BOOL WINAPI IsDomainLegalCookieDomainW(const WCHAR *domain, const WCHAR *full_domain)
 {
-    FIXME("(%s, %s) semi-stub\n", debugstr_w(domain), debugstr_w(full_domain));
+    TRACE("(%s, %s)\n", debugstr_w(domain), debugstr_w(full_domain));
 
     if (!domain || !full_domain) {
         SetLastError(ERROR_INVALID_PARAMETER);
--- a/dlls/wininet/internet.c
+++ b/dlls/wininet/internet.c
@@ -585,9 +585,58 @@ BOOL WINAPI InternetInitializeAutoProxyDll(DWORD dwReserved)
 BOOL WINAPI DetectAutoProxyUrl(LPSTR lpszAutoProxyUrl,
 	DWORD dwAutoProxyUrlLength, DWORD dwDetectFlags)
 {
-    FIXME("STUB\n");
+    static const char path[] = "/wpad.dat";
+    WCHAR domain[256], host[300];
+    DWORD size = ARRAY_SIZE(domain);
+    ADDRINFOW hints = {0}, *res = NULL;
+    char url[320];
+
+    TRACE("(%p, %ld, %08lx)\n", lpszAutoProxyUrl, dwAutoProxyUrlLength, dwDetectFlags);
+
+    if (!lpszAutoProxyUrl || !dwAutoProxyUrlLength || !dwDetectFlags ||
+        (dwDetectFlags & ~(PROXY_AUTO_DETECT_TYPE_DHCP | PROXY_AUTO_DETECT_TYPE_DNS_A)))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    lpszAutoProxyUrl[0] = 0;
+
+    /* DHCP option 252 is not readable from here. The DNS way is a host "wpad" in the computer's domain. */
+    if ((dwDetectFlags & PROXY_AUTO_DETECT_TYPE_DNS_A) &&
+        GetComputerNameExW(ComputerNameDnsDomain, domain, &size) && domain[0])
+    {
+        swprintf(host, ARRAY_SIZE(host), L"wpad.%s", domain);
+        hints.ai_family = AF_INET;
+        if (!GetAddrInfoW(host, NULL, &hints, &res))
+        {
+            FreeAddrInfoW(res);
+            snprintf(url, sizeof(url), "http://%ls%s", host, path);
+            if (strlen(url) + 1 > dwAutoProxyUrlLength)
+            {
+                SetLastError(ERROR_INSUFFICIENT_BUFFER);
+                return FALSE;
+            }
+            strcpy(lpszAutoProxyUrl, url);
+            return TRUE;
+        }
+    }
+#ifdef SG_MUTANT_WI_DETECT
     SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
     return FALSE;
+#endif
+    SetLastError(12180);  /* ERROR_WINHTTP_AUTODETECTION_FAILED */
+    return FALSE;
+}
+
+/* Both the direct and the proxy bit make no sense together: Windows keeps the direct one. */
+static DWORD normalize_proxy_flags( DWORD flags )
+{
+#ifdef SG_MUTANT_WI_PROXYFLAGS
+    return flags;
+#endif
+    if ((flags & (PROXY_TYPE_PROXY | PROXY_TYPE_DIRECT)) == (PROXY_TYPE_PROXY | PROXY_TYPE_DIRECT))
+        flags &= ~PROXY_TYPE_PROXY;
+    return flags;
 }
 
 static void FreeProxyInfo( proxyinfo_t *lpwpi )
@@ -1270,7 +1319,7 @@ static DWORD APPINFO_SetOption(object_header_t *hdr, DWORD option, void *buf, DW
             case INTERNET_PER_CONN_FLAGS:
                 if(option->Value.dwValue & ~(PROXY_TYPE_PROXY | PROXY_TYPE_DIRECT))
                     FIXME("Unhandled flags: 0x%lx\n", option->Value.dwValue);
-                global_proxy.flags = option->Value.dwValue;
+                global_proxy.flags = normalize_proxy_flags(option->Value.dwValue);
                 break;
 
             case INTERNET_PER_CONN_PROXY_BYPASS:
@@ -3658,7 +3707,7 @@ BOOL WINAPI InternetSetOptionW(HINTERNET hInternet, DWORD dwOption,
             case INTERNET_PER_CONN_FLAGS:
                 if(option->Value.dwValue & ~(PROXY_TYPE_PROXY | PROXY_TYPE_DIRECT))
                     FIXME("Unhandled flags: 0x%lx\n", option->Value.dwValue);
-                pi.flags = option->Value.dwValue;
+                pi.flags = normalize_proxy_flags(option->Value.dwValue);
                 break;
 
             case INTERNET_PER_CONN_PROXY_BYPASS:
@@ -4002,6 +4051,7 @@ BOOL WINAPI InternetTimeToSystemTimeW( LPCWSTR string, SYSTEMTIME* time, DWORD r
                 break;
             }
         }
+        while (iswalpha(*s)) s++;
     }
     else if (is_time_digit(*s))
     {
@@ -4010,6 +4060,44 @@ BOOL WINAPI InternetTimeToSystemTimeW( LPCWSTR string, SYSTEMTIME* time, DWORD r
     }
     if (time->wDayOfWeek > 6) return TRUE;
 
+    /* the C library's asctime layout: "Fri Jan 7 12:06:35 2005", month and day the other way round,
+     * the time before the year */
+    {
+        const WCHAR *p = s;
+
+        while (*p && !iswalpha(*p) && !is_time_digit(*p)) p++;
+#ifdef SG_MUTANT_WI_ASCTIME
+        if (0)
+#else
+        if (iswalpha(*p))
+#endif
+        {
+            time->wMonth = 0;
+            for (i = 0; i < 12; i++)
+                if (!wcsnicmp(WININET_month[i], p, 3)) { time->wMonth = i + 1; break; }
+            if (!time->wMonth) return TRUE;
+            while (iswalpha(*p)) p++;
+            s = p;
+            while (*s && !is_time_digit(*s)) s++;
+            if (*s == '\0') return TRUE;
+            time->wDay = wcstol(s, &end, 10); s = end;
+            while (*s && !is_time_digit(*s)) s++;
+            if (*s == '\0') return TRUE;
+            time->wHour = wcstol(s, &end, 10); s = end;
+            while (*s && !is_time_digit(*s)) s++;
+            if (*s == '\0') return TRUE;
+            time->wMinute = wcstol(s, &end, 10); s = end;
+            while (*s && !is_time_digit(*s)) s++;
+            if (*s == '\0') return TRUE;
+            time->wSecond = wcstol(s, &end, 10); s = end;
+            while (*s && !is_time_digit(*s)) s++;
+            if (*s == '\0') return TRUE;
+            time->wYear = wcstol(s, &end, 10);
+            time->wMilliseconds = 0;
+            return TRUE;
+        }
+    }
+
     while (*s && !is_time_digit(*s)) s++;
     time->wDay = wcstol( s, &end, 10 );
     s = end;
