From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] hid: HidP_SetData, HidP_UsageListDifference, HidP_GetExtendedAttributes

HidP_SetData puts each data item into a report: the value caps its data index is in found, a button's usage set (On) or cleared, a value's raw value set; on an error the data length is the failing item's index. HidP_UsageListDifference gives the usages of the previous list not in the current one and those of the current one not in the previous, zero-filled. HidP_GetExtendedAttributes reports no unknown global items for a known data index. They were spec stubs; hidpi.h gains them and the extended attribute structures.
---
--- a/include/ddk/hidpi.h
+++ b/include/ddk/hidpi.h
@@ -218,6 +218,25 @@
 NTSTATUS WINAPI HidP_GetUsagesEx(HIDP_REPORT_TYPE ReportType, USHORT LinkCollection, USAGE_AND_PAGE *ButtonList, ULONG *UsageLength, PHIDP_PREPARSED_DATA PreparsedData, CHAR *Report, ULONG ReportLength);
 ULONG WINAPI HidP_MaxDataListLength(HIDP_REPORT_TYPE ReportType, PHIDP_PREPARSED_DATA PreparsedData);
 NTSTATUS WINAPI HidP_GetData(HIDP_REPORT_TYPE ReportType, HIDP_DATA *DataList, ULONG *DataLength, PHIDP_PREPARSED_DATA PreparsedData, CHAR *Report, ULONG ReportLength);
+NTSTATUS WINAPI HidP_SetData(HIDP_REPORT_TYPE ReportType, HIDP_DATA *DataList, ULONG *DataLength, PHIDP_PREPARSED_DATA PreparsedData, CHAR *Report, ULONG ReportLength);
+NTSTATUS WINAPI HidP_UsageListDifference(USAGE *PreviousUsageList, USAGE *CurrentUsageList, USAGE *BreakUsageList, USAGE *MakeUsageList, ULONG UsageListLength);
+
+typedef struct _HIDP_UNKNOWN_TOKEN
+{
+    UCHAR Token;
+    UCHAR Reserved[3];
+    ULONG BitField;
+} HIDP_UNKNOWN_TOKEN, *PHIDP_UNKNOWN_TOKEN;
+
+typedef struct _HIDP_EXTENDED_ATTRIBUTES
+{
+    UCHAR NumGlobalUnknowns;
+    UCHAR Reserved[3];
+    PHIDP_UNKNOWN_TOKEN GlobalUnknowns;
+    ULONG Data[1];
+} HIDP_EXTENDED_ATTRIBUTES, *PHIDP_EXTENDED_ATTRIBUTES;
+
+NTSTATUS WINAPI HidP_GetExtendedAttributes(HIDP_REPORT_TYPE ReportType, USHORT DataIndex, PHIDP_PREPARSED_DATA PreparsedData, PHIDP_EXTENDED_ATTRIBUTES Attributes, PULONG LengthAttributes);
 NTSTATUS WINAPI HidP_GetLinkCollectionNodes(HIDP_LINK_COLLECTION_NODE *LinkCollectionNode, ULONG *LinkCollectionNodeLength, PHIDP_PREPARSED_DATA PreparsedData);
 
 #ifndef FACILITY_HID_ERROR_CODE
--- a/dlls/hid/hidp.c
+++ b/dlls/hid/hidp.c
@@ -1210,3 +1210,131 @@
 
     return HIDP_STATUS_SUCCESS;
 }
+
+#ifndef SG_MUTANT_HIDP_NO_SETDATA
+/* (wine-sg 8239) the value caps a data index is in */
+static const struct hid_value_caps *caps_of_index( struct hid_preparsed_data *preparsed, HIDP_REPORT_TYPE report_type,
+                                                   USHORT index )
+{
+    const struct hid_value_caps *caps, *caps_end;
+
+    if (get_value_caps_range( preparsed, report_type, 0, &caps, &caps_end ) != HIDP_STATUS_SUCCESS) return NULL;
+    for (; caps != caps_end; caps++)
+    {
+        if (!caps->usage_min && !caps->usage_max) continue;
+        if (caps->data_index_min <= index && index <= caps->data_index_max) return caps;
+    }
+    return NULL;
+}
+
+/***********************************************************************
+ *              HidP_SetData   (HID.@)
+ *
+ * Each data item into the report: a button's usage set (On) or cleared, a value's raw value set. On an error
+ * *data_len is the index of the item that failed.
+ */
+NTSTATUS WINAPI HidP_SetData( HIDP_REPORT_TYPE report_type, HIDP_DATA *data, ULONG *data_len,
+                              PHIDP_PREPARSED_DATA preparsed_data, char *report_buf, ULONG report_len )
+{
+    struct hid_preparsed_data *preparsed = (struct hid_preparsed_data *)preparsed_data;
+    ULONG i;
+
+    TRACE( "report_type %d, data %p, data_len %p, preparsed_data %p, report_buf %p, report_len %lu.\n",
+           report_type, data, data_len, preparsed_data, report_buf, report_len );
+
+    if (!preparsed || memcmp( preparsed->magic, "HidP KDR", 8 )) return HIDP_STATUS_INVALID_PREPARSED_DATA;
+    if (!report_len) return HIDP_STATUS_INVALID_REPORT_LENGTH;
+    for (i = 0; i < *data_len; i++)
+    {
+        const struct hid_value_caps *caps = caps_of_index( preparsed, report_type, data[i].DataIndex );
+        NTSTATUS status;
+        USAGE usage;
+
+        if (!caps)
+        {
+            *data_len = i;
+            return HIDP_STATUS_DATA_INDEX_NOT_FOUND;
+        }
+        if (caps->flags & HID_VALUE_CAPS_IS_RANGE) usage = caps->usage_min + data[i].DataIndex - caps->data_index_min;
+        else usage = caps->usage_min;
+        if (caps->flags & HID_VALUE_CAPS_IS_BUTTON)
+        {
+            ULONG count = 1;
+            if (data[i].On)
+                status = HidP_SetUsages( report_type, caps->usage_page, caps->link_collection, &usage, &count,
+                                         preparsed_data, report_buf, report_len );
+            else
+            {
+                status = HidP_UnsetUsages( report_type, caps->usage_page, caps->link_collection, &usage, &count,
+                                           preparsed_data, report_buf, report_len );
+                if (status == HIDP_STATUS_BUTTON_NOT_PRESSED) status = HIDP_STATUS_SUCCESS;
+            }
+        }
+        else
+            status = HidP_SetUsageValue( report_type, caps->usage_page, caps->link_collection, usage, data[i].RawValue,
+                                         preparsed_data, report_buf, report_len );
+        if (status != HIDP_STATUS_SUCCESS)
+        {
+            *data_len = i;
+            return status;
+        }
+    }
+    return HIDP_STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *              HidP_GetExtendedAttributes   (HID.@)
+ *
+ * The global items the parser did not know for a data index: none are kept, so the count is 0.
+ */
+NTSTATUS WINAPI HidP_GetExtendedAttributes( HIDP_REPORT_TYPE report_type, USHORT index, PHIDP_PREPARSED_DATA preparsed_data,
+                                            HIDP_EXTENDED_ATTRIBUTES *attributes, ULONG *length )
+{
+    struct hid_preparsed_data *preparsed = (struct hid_preparsed_data *)preparsed_data;
+
+    TRACE( "report_type %d, index %u, preparsed_data %p, attributes %p, length %p.\n",
+           report_type, index, preparsed_data, attributes, length );
+
+    if (!preparsed || memcmp( preparsed->magic, "HidP KDR", 8 )) return HIDP_STATUS_INVALID_PREPARSED_DATA;
+    if (!caps_of_index( preparsed, report_type, index )) return HIDP_STATUS_DATA_INDEX_NOT_FOUND;
+    if (!length || *length < offsetof( HIDP_EXTENDED_ATTRIBUTES, Data ))
+    {
+        if (length) *length = sizeof(*attributes);
+        return HIDP_STATUS_BUFFER_TOO_SMALL;
+    }
+    memset( attributes, 0, offsetof( HIDP_EXTENDED_ATTRIBUTES, Data ) );
+    *length = offsetof( HIDP_EXTENDED_ATTRIBUTES, Data );
+    return HIDP_STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *              HidP_UsageListDifference   (HID.@)
+ *
+ * The usages of the previous list not in the current one (break) and of the current one not in the previous
+ * (make); a list ends at its length or its first 0, the rest of the output lists is zeroed.
+ */
+NTSTATUS WINAPI HidP_UsageListDifference( USAGE *previous, USAGE *current, USAGE *broken, USAGE *made, ULONG length )
+{
+    ULONG i, j, nb = 0, nm = 0;
+
+    TRACE( "previous %p, current %p, broken %p, made %p, length %lu.\n", previous, current, broken, made, length );
+
+    for (i = 0; i < length && previous[i]; i++)
+    {
+        for (j = 0; j < length && current[j]; j++) if (current[j] == previous[i]) break;
+        if (j == length || !current[j]) broken[nb++] = previous[i];
+    }
+    for (i = 0; i < length && current[i]; i++)
+    {
+        for (j = 0; j < length && previous[j]; j++) if (previous[j] == current[i]) break;
+        if (j == length || !previous[j]) made[nm++] = current[i];
+    }
+    while (nb < length) broken[nb++] = 0;
+    while (nm < length) made[nm++] = 0;
+    return HIDP_STATUS_SUCCESS;
+}
+#else
+NTSTATUS WINAPI HidP_SetData( HIDP_REPORT_TYPE t, HIDP_DATA *d, ULONG *l, PHIDP_PREPARSED_DATA p, char *r, ULONG rl ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS WINAPI HidP_GetExtendedAttributes( HIDP_REPORT_TYPE t, USHORT i, PHIDP_PREPARSED_DATA p, HIDP_EXTENDED_ATTRIBUTES *a, ULONG *l ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS WINAPI HidP_UsageListDifference( USAGE *p, USAGE *c, USAGE *b, USAGE *m, ULONG l ) { return STATUS_NOT_IMPLEMENTED; }
+#endif
