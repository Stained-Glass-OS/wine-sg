 {
     ITextRangeImpl *This = impl_from_ITextRange(me);
+    ITextPara *mine;
+    HRESULT hr;
 
-    FIXME("(%p)->(%p): stub\n", This, para);
+    TRACE("(%p)->(%p)\n", This, para);
 
     if (!This->child.reole)
         return CO_E_RELEASED;
-
-    return E_NOTIMPL;
+    if (!para) return E_INVALIDARG;
+    /* the formatting of the range's paragraphs becomes that of the given one */
+    if (FAILED(hr = create_textpara(me, &mine))) return hr;
+#ifdef SG_MUTANT_TOM_SETPARA
+    ITextPara_Release(mine);
+    return S_OK;
+#endif
+    hr = ITextPara_SetDuplicate(mine, para);
+    ITextPara_Release(mine);
+    return hr;
 }
 
 static HRESULT WINAPI ITextRange_fnGetStoryLength(ITextRange *me, LONG *length)
@@ -2189,25 +2267,25 @@ static HRESULT WINAPI ITextRange_fnGetIndex(ITextRange *me, LONG unit, LONG *ind
