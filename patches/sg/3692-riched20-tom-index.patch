From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: TOM GetIndex, SetIndex and SetPara (3692)

riched20: TOM GetIndex, SetIndex and SetPara

ITextRange and ITextSelection GetIndex (the index of the character, word,
sentence, paragraph or story at the start), SetIndex (select the nth unit,
counting from the end when negative; optionally extending) and SetPara
(apply another paragraph's formatting).
---
diff --git a/dlls/riched20/richole.c b/dlls/riched20/richole.c
index f431895..bbc84cf 100644
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -1115,6 +1115,74 @@ static HRESULT tom_generic_expand(ITextRange *range, LONG unit, LONG *delta)
     return (ns != start || ne != end) ? S_OK : S_FALSE;
 }
 
+static HRESULT textrange_getindex(ITextRange *range, LONG unit, LONG *index)
+{
+    LONG start, len, i, n = 1;
+    WCHAR *t;
+    HRESULT hr;
+
+    if (!index) return E_INVALIDARG;
+    ITextRange_GetStart(range, &start);
+    if (unit == tomCharacter) { *index = start + 1; return S_OK; }
+    if (!tom_generic_unit(unit)) return E_NOTIMPL;
+    if (unit == tomStory) { *index = 1; return S_OK; }
+    if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
+    /* one more than the unit starts after the beginning of the story, up to the range start */
+    for (i = 1; i <= start && i < len; i++) if (tom_is_boundary(t, len, unit, i)) n++;
+#ifdef SG_MUTANT_TOM_INDEX
+    n = 1;
+#endif
+    free(t);
+    *index = n;
+    return S_OK;
+}
+
+static HRESULT textrange_setindex(ITextRange *range, LONG unit, LONG index, LONG extend)
+{
+    LONG start, end, len, i, count = 0, ns = -1, ne = -1;
+    WCHAR *t;
+    HRESULT hr;
+
+    if (!index) return E_INVALIDARG;
+    if (unit != tomCharacter && !tom_generic_unit(unit)) return E_NOTIMPL;
+    if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
+    ITextRange_GetStart(range, &start);
+    ITextRange_GetEnd(range, &end);
+    if (unit == tomCharacter)
+    {
+        ns = index > 0 ? index - 1 : len + index;
+        ne = ns + 1;
+    }
+    else if (unit == tomStory)
+    {
+        if (index == 1 || index == -1) { ns = 0; ne = len; }
+    }
+    else
+    {
+        LONG units = 0;
+
+        for (i = 0; i < len; i++) if (i == 0 || tom_is_boundary(t, len, unit, i)) units++;
+        count = index > 0 ? index : units + index + 1;
+        if (count >= 1 && count <= units)
+        {
+            LONG k = 0;
+
+            for (i = 0; i < len; i++)
+                if ((i == 0 || tom_is_boundary(t, len, unit, i)) && ++k == count) { ns = i; break; }
+            ne = tom_unit_next(t, len, unit, ns);
+        }
+    }
+    free(t);
+    if (ns < 0 || ne > len || ns >= len) return S_FALSE;
+    if (extend) ns = start < ns ? start : ns;
+#ifdef SG_MUTANT_TOM_SETINDEX
+    return S_OK;
+#endif
+    ITextRange_SetEnd(range, ne);
+    ITextRange_SetStart(range, ns);
+    return S_OK;
+}
+
 static HRESULT textrange_expand(ITextRange *range, LONG unit, LONG *delta)
 {
     LONG expand_start, expand_end;
@@ -2112,13 +2180,23 @@ static HRESULT WINAPI ITextRange_fnGetPara(ITextRange *me, ITextPara **para)
