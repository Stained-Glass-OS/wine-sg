From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfreadwrite: SetCurrentMediaType needs major type and subtype, sink writer media sink service

Behaviour recorded by todo_wine marks of mfreadwrite's conformance test:

- IMFSourceReader::SetCurrentMediaType returns E_INVALIDARG for a NULL type
  or a type without MF_MT_MAJOR_TYPE / MF_MT_SUBTYPE.
- IMFSinkWriter::GetServiceForStream(MF_SINK_WRITER_MEDIASINK) only reaches
  the media sink's own services (IMFGetService): GUID_NULL gives
  MF_E_UNSUPPORTED_SERVICE and a NULL output pointer.

The todo_wine marks that now pass are removed.
---
diff --git a/dlls/mfreadwrite/reader.c b/dlls/mfreadwrite/reader.c
index 883c614..bf705ba 100644
--- a/dlls/mfreadwrite/reader.c
+++ b/dlls/mfreadwrite/reader.c
@@ -2258,6 +2258,11 @@ static HRESULT WINAPI src_reader_SetCurrentMediaType(IMFSourceReaderEx *iface, D
     if (index >= reader->stream_count)
         return MF_E_INVALIDSTREAMNUMBER;
 
+    /* The requested type needs at least a major type and a subtype. */
+    if (!type || FAILED(IMFMediaType_GetItem(type, &MF_MT_MAJOR_TYPE, NULL))
+            || FAILED(IMFMediaType_GetItem(type, &MF_MT_SUBTYPE, NULL)))
+        return E_INVALIDARG;
+
     /* FIXME: setting the output type while streaming should trigger a flush */
 
     EnterCriticalSection(&reader->cs);
diff --git a/dlls/mfreadwrite/tests/mfplat.c b/dlls/mfreadwrite/tests/mfplat.c
index b698147..7b41fcd 100644
--- a/dlls/mfreadwrite/tests/mfplat.c
+++ b/dlls/mfreadwrite/tests/mfplat.c
@@ -1637,9 +1637,7 @@ static void test_sink_writer_mp4(void)
     sink = (void *)0xdeadbeef;
     hr = IMFSinkWriter_GetServiceForStream(writer, MF_SINK_WRITER_MEDIASINK,
             &GUID_NULL, &IID_IMFMediaSink, (void **)&sink);
-    todo_wine
     ok(hr == MF_E_UNSUPPORTED_SERVICE, "Unexpected hr %#lx.\n", hr);
-    todo_wine
     ok(!sink, "Unexpected pointer %p.\n", sink);
 
     DeleteFileW(tmp_file);
@@ -1887,7 +1885,7 @@ static void test_source_reader_transforms(BOOL enable_processing, BOOL enable_ad
     ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
     init_media_type(media_type, nv12_stream_type_desc, 1);
     hr = IMFSourceReader_SetCurrentMediaType(reader, 0, NULL, media_type);
-    todo_wine ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
 
     /* RGB32 -> NV12 conversion with MF_SOURCE_READER_ENABLE_ADVANCED_VIDEO_PROCESSING */
     init_media_type(media_type, nv12_stream_type_desc, 2); /* doesn't need the frame size */
diff --git a/dlls/mfreadwrite/writer.c b/dlls/mfreadwrite/writer.c
index c708664..d794f69 100644
--- a/dlls/mfreadwrite/writer.c
+++ b/dlls/mfreadwrite/writer.c
@@ -704,19 +704,22 @@ static HRESULT WINAPI sink_writer_Finalize(IMFSinkWriter *iface)
     return E_NOTIMPL;
 }
 
-static HRESULT sink_writer_get_service(void *object, REFGUID service, REFIID riid, void **ret)
+static HRESULT sink_writer_get_service(void *object, REFGUID service, REFIID riid, void **ret, BOOL null_is_query)
 {
     IUnknown *iface = object;
     IMFGetService *gs;
     HRESULT hr;
 
+    *ret = NULL;
+
     if (!iface) return MF_E_UNSUPPORTED_SERVICE;
 
-    if (IsEqualGUID(service, &GUID_NULL))
+    if (null_is_query && IsEqualGUID(service, &GUID_NULL))
         return IUnknown_QueryInterface(iface, riid, ret);
 
+    /* The media sink itself is only reachable through its own services. */
     if (FAILED(hr = IUnknown_QueryInterface(iface, &IID_IMFGetService, (void **)&gs)))
-        return hr;
+        return null_is_query ? hr : MF_E_UNSUPPORTED_SERVICE;
 
     hr = IMFGetService_GetService(gs, service, riid, ret);
     IMFGetService_Release(gs);
@@ -735,13 +738,13 @@ static HRESULT WINAPI sink_writer_GetServiceForStream(IMFSinkWriter *iface, DWOR
     EnterCriticalSection(&writer->cs);
 
     if (index == MF_SINK_WRITER_MEDIASINK)
-        hr = sink_writer_get_service(writer->sink, service, riid, object);
+        hr = sink_writer_get_service(writer->sink, service, riid, object, FALSE);
     else if ((stream = sink_writer_get_stream(writer, index)))
     {
         if (stream->encoder)
-            hr = sink_writer_get_service(stream->encoder, service, riid, object);
+            hr = sink_writer_get_service(stream->encoder, service, riid, object, TRUE);
         if (FAILED(hr))
-            hr = sink_writer_get_service(stream->stream_sink, service, riid, object);
+            hr = sink_writer_get_service(stream->stream_sink, service, riid, object, TRUE);
     }
     else
         hr = MF_E_INVALIDSTREAMNUMBER;
