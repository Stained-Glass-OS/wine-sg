From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: GTK's and SDL's environment variables stay Unix-side, like Qt's (5946)

ntdll: GTK's and SDL's environment variables stay Unix-side, like Qt's

The session tells Linux programs to draw on X11 (sg-common.sh,
SG_LINUX_APP_ENV: GDK_BACKEND=x11, QT_QPA_PLATFORM=xcb, SDL_VIDEODRIVER=x11,
...), and the shell (explorer, Start) carries them. A Windows build of GTK
or SDL reads them too and has no X11: Geany said "cannot open display" and
ended at once when started from Start or the desktop (the SG Store walk:
"no process" for Geany and Pidgin), and every Windows SDL program would
fail the same way. Upstream already keeps QT_, VK_ and XDG_SESSION_TYPE out
of the Windows environment.

GDK_, GTK_, GSK_ and SDL_ are now special too: hidden from the Windows
environment (a value the Windows side sets itself still reaches its Windows
children, WINE-prefixed on the way). And the Unix-only ones (those and QT_,
VK_, XDG_SESSION_TYPE) are passed on from the process's Unix environment to
a Unix program it starts with CreateProcess, as PATH and HOME are; a Linux
program started from Start or the desktop keeps its X11 hints. Gate
test-toolkitenv; mutants SG_MUTANT_TOOLKIT_ENV_VISIBLE,
SG_MUTANT_UNIX_ENV_DROPPED.
---
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -336,6 +336,23 @@
  * Check if an environment variable needs to be handled specially when
  * passed through the Unix environment (i.e. prefixed with "WINE").
  */
+/* Stained Glass OS: the session tells Linux programs to draw on X11 (sg-common.sh, SG_LINUX_APP_ENV:
+ * GDK_BACKEND=x11, SDL_VIDEODRIVER=x11, ...). A Windows build of the same toolkit reads them too and
+ * has no X11: Geany (GTK) said "cannot open display" and ended at once when started from Start or the
+ * desktop, as did every Windows GTK and SDL program (Pidgin, DOSBox, ScummVM). Like Qt's (QT_), they
+ * are kept Unix-side: hidden from the Windows environment, and passed on to the Unix side of every
+ * child process, so a Linux program a Windows one starts (Start's gio launch) still gets them. */
+static BOOL is_toolkit_env_var( const char *var )
+{
+#ifdef SG_MUTANT_TOOLKIT_ENV_VISIBLE
+    return FALSE;
+#endif
+    return (STARTS_WITH( var, "GDK_" ) ||
+            STARTS_WITH( var, "GTK_" ) ||
+            STARTS_WITH( var, "GSK_" ) ||
+            STARTS_WITH( var, "SDL_" ));
+}
+
 static BOOL is_special_env_var( const char *var )
 {
     return (STARTS_WITH( var, "PATH=" ) ||
@@ -345,7 +362,21 @@
             STARTS_WITH( var, "TMP=" ) ||
             STARTS_WITH( var, "QT_" ) ||
             STARTS_WITH( var, "VK_" ) ||
-            STARTS_WITH( var, "XDG_SESSION_TYPE=" ));
+            STARTS_WITH( var, "XDG_SESSION_TYPE=" ) ||
+            is_toolkit_env_var( var ));
+}
+
+/* Stained Glass OS: the special variables only a Unix program reads; a child process gets them from
+ * this process's Unix environment, as PATH and HOME (build_envp) */
+static BOOL is_unix_only_env_var( const char *var )
+{
+#ifdef SG_MUTANT_UNIX_ENV_DROPPED
+    return FALSE;
+#endif
+    return (STARTS_WITH( var, "QT_" ) ||
+            STARTS_WITH( var, "VK_" ) ||
+            STARTS_WITH( var, "XDG_SESSION_TYPE=" ) ||
+            is_toolkit_env_var( var ));
 }
 
 /* check if an environment variable changes dynamically in every new process */
@@ -492,7 +523,7 @@
 char **build_envp( const WCHAR *envW )
 {
     static const char * const unix_vars[] = { "PATH", "TEMP", "TMP", "HOME" };
-    char **envp;
+    char **envp, **e;
     char *env, *p;
     int count = 1, length, lenW;
     unsigned int i;
@@ -513,6 +544,12 @@
         length += strlen(unix_vars[i]) + strlen(p) + 2;
         count++;
     }
+    for (e = environ; *e; e++)
+    {
+        if (!is_unix_only_env_var( *e )) continue;
+        length += strlen( *e ) + 1;
+        count++;
+    }
 
     if ((envp = malloc( count * sizeof(*envp) + length )))
     {
@@ -528,6 +565,12 @@
             strcat( dst, p );
             dst += strlen(dst) + 1;
         }
+        for (e = environ; *e; e++)
+        {
+            if (!is_unix_only_env_var( *e )) continue;
+            *envptr++ = strcpy( dst, *e );
+            dst += strlen(dst) + 1;
+        }
 
         /* now put the Windows environment strings */
         for (p = env; *p; p += strlen(p) + 1)
