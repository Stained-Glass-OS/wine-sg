+/* Stained Glass OS: the desktop as Windows' shell has it for other programs
+ * to find -- a "Progman" window ("Program Manager") holding SHELLDLL_DefView
+ * and its SysListView32. Programs look for them: Opera's installer finds
+ * the desktop's icon list through UI Automation and crashed without it
+ * (2026-10-04); wallpaper and desktop tools FindWindow("Progman"). Ours
+ * draws the desktop itself, so these are one transparent, click-through
+ * pixel, as the keys window is. */
+static LRESULT WINAPI sg_progman_proc( HWND hwnd, UINT message, WPARAM wp, LPARAM lp )
+{
+    switch (message)
+    {
+    case 0x052c:            /* "spawn a WorkerW" (wallpaper tools): none here */
+        return 0;
+    case WM_CLOSE:
+        return 0;
+    }
+    return DefWindowProcW( hwnd, message, wp, lp );
+}
+
+static void sg_create_progman_window(void)
+{
+#ifndef SG_MUTANT_NO_PROGMAN
+    WNDCLASSW wc = { 0 };
+    INITCOMMONCONTROLSEX icc = { sizeof(icc), ICC_LISTVIEW_CLASSES };
+    HWND progman, view;
+
+    wc.lpfnWndProc = sg_progman_proc;
+    wc.hInstance = GetModuleHandleW( NULL );
+    wc.lpszClassName = L"Progman";
+    RegisterClassW( &wc );
+    wc.lpfnWndProc = DefWindowProcW;
+    wc.lpszClassName = L"SHELLDLL_DefView";
+    RegisterClassW( &wc );
+    if (!(progman = CreateWindowExW( WS_EX_TOOLWINDOW | WS_EX_LAYERED | WS_EX_TRANSPARENT, L"Progman", L"Program Manager",
+                                     WS_POPUP | WS_CLIPCHILDREN, 0, 0, 1, 1, NULL, NULL, wc.hInstance, NULL )))
+        return;
+    SetLayeredWindowAttributes( progman, 0, 0, LWA_ALPHA );
+    view = CreateWindowExW( 0, L"SHELLDLL_DefView", NULL, WS_CHILD | WS_VISIBLE, 0, 0, 1, 1, progman, NULL, wc.hInstance, NULL );
+    InitCommonControlsEx( &icc );
+    if (view) CreateWindowExW( 0, WC_LISTVIEWW, L"FolderView", WS_CHILD | WS_VISIBLE | LVS_ICON, 0, 0, 1, 1,
+                               view, NULL, wc.hInstance, NULL );
+    SetWindowPos( progman, HWND_BOTTOM, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE );
+    ShowWindow( progman, SW_SHOWNOACTIVATE );
+#endif
+}
+
