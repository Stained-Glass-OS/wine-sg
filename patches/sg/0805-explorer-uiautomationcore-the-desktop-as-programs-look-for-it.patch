+
+/* the conditions of a SAFEARRAY of IUnknowns (CreateAndConditionFromArray) */
+static HRESULT conds_from_safearray(SAFEARRAY *sa, IUIAutomationCondition ***out, int *count)
+{
+    LONG lbound, ubound, i;
+    IUIAutomationCondition **conds;
+    HRESULT hr;
+
+    *out = NULL;
+    *count = 0;
+    if (!sa) return E_POINTER;
+    if (FAILED(hr = SafeArrayGetLBound(sa, 1, &lbound)) || FAILED(hr = SafeArrayGetUBound(sa, 1, &ubound))) return hr;
+    if (ubound < lbound) return E_INVALIDARG;
+    if (!(conds = calloc(ubound - lbound + 1, sizeof(*conds)))) return E_OUTOFMEMORY;
+    for (i = lbound; i <= ubound; i++)
+    {
+        IUnknown *unk = NULL;
+        if (FAILED(hr = SafeArrayGetElement(sa, &i, &unk)) || !unk ||
+                FAILED(hr = IUnknown_QueryInterface(unk, &IID_IUIAutomationCondition, (void **)&conds[i - lbound])))
+        {
+            if (unk) IUnknown_Release(unk);
+            while (--i >= lbound) IUIAutomationCondition_Release(conds[i - lbound]);
+            free(conds);
+            return FAILED(hr) ? hr : E_INVALIDARG;
+        }
+        IUnknown_Release(unk);
+    }
+    *out = conds;
+    *count = ubound - lbound + 1;
+    return S_OK;
+}
