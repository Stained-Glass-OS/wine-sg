+++ b/dlls/windows.applicationmodel/main.c
@@ -76,6 +76,9 @@ HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **fa
     if (!wcscmp( buffer, RuntimeClass_Windows_ApplicationModel_LimitedAccessFeatures ))
         IActivationFactory_QueryInterface( limited_access_factory, &IID_IActivationFactory, (void **)factory );
 
+    if (!wcscmp( buffer, L"Windows.ApplicationModel.Resources.Core.ResourceManager" ))
