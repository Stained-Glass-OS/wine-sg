--- a/dlls/windows.applicationmodel/resource_loader.c
+++ b/dlls/windows.applicationmodel/resource_loader.c
@@ -150,6 +150,14 @@ static HRESULT lookup_string( const WCHAR *map, const WCHAR *resource, HSTRING *
     return hr;
 }
 
+/* a resource's string by its path ("Map/Key", or "/Map/Key" from the root); NULL if there is none
+ * (the ResourceManager's maps) */
+WCHAR *resource_lookup( const WCHAR *path )
+{
+    struct pri_file *file = get_pri();
+    return file ? pri_get_string( file, path, (const WCHAR *const *)languages ) : NULL;
+}
+
 /* ms-resource:///Map/Key, ms-resource://package/Map/Key: the path names the
  * resource from the root. */
 static HRESULT lookup_uri( IUriRuntimeClass *uri, HSTRING *value )
