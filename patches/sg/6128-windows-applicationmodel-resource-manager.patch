index 2768b93..9afdf44 100644
--- a/dlls/windows.applicationmodel/Makefile.in
+++ b/dlls/windows.applicationmodel/Makefile.in
@@ -10,4 +10,5 @@ SOURCES = \
 	package.c \
 	package_catalog.c \
 	pri.c \
-	resource_loader.c
+	resource_loader.c \
+	resource_manager.c
