new file mode 100644
index 0000000..6825051
--- /dev/null
+++ b/dlls/windows.applicationmodel/resource_manager.c
@@ -0,0 +1,451 @@
+/*
+ * Windows.ApplicationModel.Resources.Core.ResourceManager
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Stained Glass OS: the resource manager of Windows.ApplicationModel.Resources.Core, over the same
+ * resource index (resources.pri) the ResourceLoader reads.  NanaZip's file manager (XAML Islands)
+ * gets its strings through ResourceManager.Current.MainResourceMap; the class did not exist.
+ * ResourceManager.Current, its MainResourceMap and DefaultContext, a map's values and subtrees, a
+ * candidate's string.
+ *
+ * Interface definitions (IIDs, method order and parameters) per windows-rs 0.100 (MIT), the
+ * Windows.ApplicationModel.Resources.Core module; the implementation is ours.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "winnls.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(model);
+
+#include "initguid.h"
+DEFINE_GUID(IID_IResourceManagerStatics, 0x1cc0fdfc, 0x69ee, 0x4e43, 0x99, 0x01, 0x47, 0xf1, 0x26, 0x87, 0xba, 0xf7);
+DEFINE_GUID(IID_IResourceManager,        0xf744d97b, 0x9988, 0x44fb, 0xab, 0xd6, 0x53, 0x78, 0x84, 0x4c, 0xfa, 0x8b);
+DEFINE_GUID(IID_IResourceMap,            0x72284824, 0xdb8c, 0x42f8, 0xb0, 0x8c, 0x53, 0xff, 0x35, 0x7d, 0xad, 0x82);
+DEFINE_GUID(IID_IResourceCandidate,      0xaf5207d9, 0xc433, 0x4764, 0xb3, 0xfd, 0x8f, 0xa6, 0xbf, 0xbc, 0xba, 0xdc);
+DEFINE_GUID(IID_IResourceContext,        0x2fa22f4b, 0x707e, 0x4b27, 0xad, 0x0d, 0xd0, 0xd8, 0xcd, 0x46, 0x8f, 0xd2);
+
+/* the ResourceLoader's lookup (resource_loader.c) */
+extern WCHAR *resource_lookup( const WCHAR *path );
+
+#define HRESULT_MRM_NAMED_RESOURCE_NOT_FOUND HRESULT_FROM_WIN32( 15015 )  /* ERROR_MRM_NAMED_RESOURCE_NOT_FOUND */
+
+/* ---- one object per instance: an IInspectable-shaped vtable and its interface ------------------ */
+
+enum kind { KIND_MANAGER, KIND_MAP, KIND_CANDIDATE, KIND_CONTEXT };
+
+struct object
+{
+    const void *vtbl;
+    LONG ref;
+    enum kind kind;
+    WCHAR *text;                  /* a map's path; a candidate's value */
+};
+
+static const IID *kind_iid( enum kind kind )
+{
+    switch (kind)
+    {
+    case KIND_MANAGER: return &IID_IResourceManager;
+    case KIND_MAP: return &IID_IResourceMap;
+    case KIND_CANDIDATE: return &IID_IResourceCandidate;
+    case KIND_CONTEXT: return &IID_IResourceContext;
+    }
+    return &IID_IUnknown;
+}
+
+static const WCHAR *kind_class( enum kind kind )
+{
+    switch (kind)
+    {
+    case KIND_MANAGER: return L"Windows.ApplicationModel.Resources.Core.ResourceManager";
+    case KIND_MAP: return L"Windows.ApplicationModel.Resources.Core.ResourceMap";
+    case KIND_CANDIDATE: return L"Windows.ApplicationModel.Resources.Core.ResourceCandidate";
+    case KIND_CONTEXT: return L"Windows.ApplicationModel.Resources.Core.ResourceContext";
+    }
+    return L"";
+}
+
+static HRESULT WINAPI obj_QueryInterface( struct object *obj, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, kind_iid( obj->kind ) ))
+    {
+        InterlockedIncrement( &obj->ref );
+        *out = obj;
+        return S_OK;
+    }
+    FIXME( "%s: %s not implemented, returning E_NOINTERFACE.\n", debugstr_w( kind_class( obj->kind ) ), debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI obj_AddRef( struct object *obj )
+{
+    return InterlockedIncrement( &obj->ref );
+}
+
+static ULONG WINAPI obj_Release( struct object *obj )
+{
+    ULONG ref = InterlockedDecrement( &obj->ref );
+    if (!ref)
+    {
+        free( obj->text );
+        free( obj );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI obj_GetIids( struct object *obj, ULONG *count, IID **iids )
+{
+    FIXME( "%p, %p, %p stub!\n", obj, count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI obj_GetRuntimeClassName( struct object *obj, HSTRING *name )
+{
+    return inspectable_name( kind_class( obj->kind ), name );
+}
+
+static HRESULT WINAPI obj_GetTrustLevel( struct object *obj, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI obj_notimpl1( struct object *obj, void *a )
+{
+    FIXME( "%s: method not implemented\n", debugstr_w( kind_class( obj->kind ) ) );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI obj_notimpl2( struct object *obj, void *a, void *b )
+{
+    FIXME( "%s: method not implemented\n", debugstr_w( kind_class( obj->kind ) ) );
+    return E_NOTIMPL;
+}
+
+#define INSPECTABLE_METHODS \
+    obj_QueryInterface, obj_AddRef, obj_Release, obj_GetIids, obj_GetRuntimeClassName, obj_GetTrustLevel
+
+static HRESULT new_object( const void *vtbl, enum kind kind, const WCHAR *text, void **out )
+{
+    struct object *obj;
+
+    if (!out) return E_POINTER;
+    if (!(obj = calloc( 1, sizeof(*obj) ))) return E_OUTOFMEMORY;
+    obj->vtbl = vtbl;
+    obj->ref = 1;
+    obj->kind = kind;
+    if (text && !(obj->text = wcsdup( text )))
+    {
+        free( obj );
+        return E_OUTOFMEMORY;
+    }
+    *out = obj;
+    return S_OK;
+}
+
+/* ---- ResourceCandidate -------------------------------------------------- */
+
+static HRESULT WINAPI candidate_is_true( struct object *obj, boolean *value )
+{
+    *value = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI candidate_ValueAsString( struct object *obj, HSTRING *value )
+{
+    return WindowsCreateString( obj->text, wcslen( obj->text ), value );
+}
+
+static const struct
+{
+    void *base[6];
+    void *Qualifiers, *IsMatch, *IsMatchAsDefault, *IsDefault, *ValueAsString, *GetValueAsFileAsync, *GetQualifierValue;
+} candidate_vtbl =
+{
+    { INSPECTABLE_METHODS },
+    obj_notimpl1, candidate_is_true, candidate_is_true, candidate_is_true, candidate_ValueAsString,
+    obj_notimpl1, obj_notimpl2,
+};
+
+/* ---- ResourceMap -------------------------------------------------------- */
+
+static WCHAR *map_path( struct object *map, const WCHAR *key )
+{
+    size_t len;
+    WCHAR *path;
+
+    if (!key) key = L"";
+    if (key[0] == '/') return wcsdup( key );   /* from the root */
+    len = wcslen( map->text ) + wcslen( key ) + 2;
+    if (!(path = malloc( len * sizeof(WCHAR) ))) return NULL;
+    if (map->text[0]) swprintf( path, len, L"%s/%s", map->text, key );
+    else wcscpy( path, key );
+    return path;
+}
+
+static HRESULT WINAPI map_GetValue( struct object *map, HSTRING key, void **candidate )
+{
+    WCHAR *path, *value;
+    HRESULT hr;
+
+    if (!candidate) return E_POINTER;
+    *candidate = NULL;
+    if (!(path = map_path( map, WindowsGetStringRawBuffer( key, NULL ) ))) return E_OUTOFMEMORY;
+    value = resource_lookup( path );
+    TRACE( "%s -> %s\n", debugstr_w( path ), debugstr_w( value ) );
+    free( path );
+#ifdef SG_MUTANT_RESMAN_NOT_FOUND
+    free( value );
+    value = NULL;
+#endif
+    if (!value) return HRESULT_MRM_NAMED_RESOURCE_NOT_FOUND;
+    hr = new_object( &candidate_vtbl, KIND_CANDIDATE, value, candidate );
+    free( value );
+    return hr;
+}
+
+static HRESULT WINAPI map_GetValueForContext( struct object *map, HSTRING key, void *context, void **candidate )
+{
+    return map_GetValue( map, key, candidate );
+}
+
+static HRESULT make_map( const WCHAR *path, void **out );
+
+static HRESULT WINAPI map_GetSubtree( struct object *map, HSTRING reference, void **out )
+{
+    WCHAR *path;
+    HRESULT hr;
+
+    if (!(path = map_path( map, WindowsGetStringRawBuffer( reference, NULL ) ))) return E_OUTOFMEMORY;
+    hr = make_map( path, out );
+    free( path );
+    return hr;
+}
+
+static const struct
+{
+    void *base[6];
+    void *Uri, *GetValue, *GetValueForContext, *GetSubtree;
+} map_vtbl =
+{
+    { INSPECTABLE_METHODS },
+    obj_notimpl1, map_GetValue, map_GetValueForContext, map_GetSubtree,
+};
+
+static HRESULT make_map( const WCHAR *path, void **out )
+{
+    return new_object( &map_vtbl, KIND_MAP, path, out );
+}
+
+/* ---- ResourceContext (the default one) ----------------------------------- */
+
+static const struct
+{
+    void *base[6];
+    void *QualifierValues, *Reset, *ResetQualifierValues, *OverrideToMatch, *Clone, *Languages, *SetLanguages;
+} context_vtbl =
+{
+    { INSPECTABLE_METHODS },
+    obj_notimpl1, obj_notimpl1, obj_notimpl1, obj_notimpl1, obj_notimpl1, obj_notimpl1, obj_notimpl1,
+};
+
+/* ---- ResourceManager ---------------------------------------------------- */
+
+static HRESULT WINAPI manager_MainResourceMap( struct object *obj, void **map )
+{
+    return new_object( &map_vtbl, KIND_MAP, L"", map );
+}
+
+static HRESULT WINAPI manager_DefaultContext( struct object *obj, void **context )
+{
+    return new_object( &context_vtbl, KIND_CONTEXT, NULL, context );
+}
+
+static const struct
+{
+    void *base[6];
+    void *MainResourceMap, *AllResourceMaps, *DefaultContext, *LoadPriFiles, *UnloadPriFiles;
+} manager_vtbl =
+{
+    { INSPECTABLE_METHODS },
+    manager_MainResourceMap, obj_notimpl1, manager_DefaultContext, obj_notimpl1, obj_notimpl1,
+};
+
+/* ---- the class's statics -------------------------------------------------- */
+
+struct manager_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    const void *statics_vtbl;   /* IResourceManagerStatics */
+    LONG ref;
+};
+
+static struct manager_statics *impl_from_factory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct manager_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct manager_statics *impl = impl_from_factory( iface );
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid( iid ), out );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface;
+        IActivationFactory_AddRef( iface );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IResourceManagerStatics ))
+    {
+        *out = &impl->statics_vtbl;
+        IActivationFactory_AddRef( iface );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &impl_from_factory( iface )->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &impl_from_factory( iface )->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    FIXME( "%p, %p, %p stub!\n", iface, count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return inspectable_name( L"Windows.ApplicationModel.Resources.Core.ResourceManager", name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    return E_NOTIMPL;   /* a static class */
+}
+
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release, factory_GetIids, factory_GetRuntimeClassName,
+    factory_GetTrustLevel, factory_ActivateInstance,
+};
+
+/* the statics interface's methods take the address of its vtable pointer in the structure */
+static struct manager_statics *impl_from_statics( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct manager_statics, statics_vtbl );
+}
+
+static HRESULT WINAPI statics_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    return factory_QueryInterface( &impl_from_statics( iface )->IActivationFactory_iface, iid, out );
+}
+
+static ULONG WINAPI statics_AddRef( void *iface )
+{
+    return factory_AddRef( &impl_from_statics( iface )->IActivationFactory_iface );
+}
+
+static ULONG WINAPI statics_Release( void *iface )
+{
+    return factory_Release( &impl_from_statics( iface )->IActivationFactory_iface );
+}
+
+static HRESULT WINAPI statics_GetIids( void *iface, ULONG *count, IID **iids )
+{
+    return factory_GetIids( &impl_from_statics( iface )->IActivationFactory_iface, count, iids );
+}
+
+static HRESULT WINAPI statics_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    return factory_GetRuntimeClassName( &impl_from_statics( iface )->IActivationFactory_iface, name );
+}
+
+static HRESULT WINAPI statics_GetTrustLevel( void *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_get_Current( void *iface, void **manager )
+{
+    static struct object *current;
+    struct object *obj;
+
+    TRACE( "%p\n", manager );
+    if (!manager) return E_POINTER;
+    if (!current)
+    {
+        if (FAILED(new_object( &manager_vtbl, KIND_MANAGER, NULL, (void **)&obj ))) return E_OUTOFMEMORY;
+        if (InterlockedCompareExchangePointer( (void **)&current, obj, NULL )) obj_Release( obj );
+    }
+    obj_AddRef( current );
+    *manager = current;
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_IsResourceReference( void *iface, HSTRING reference, boolean *result )
+{
+    const WCHAR *str = WindowsGetStringRawBuffer( reference, NULL );
+
+    if (!result) return E_POINTER;
+    *result = !wcsnicmp( str, L"ms-resource:", 12 );
+    return S_OK;
+}
+
+static const struct
+{
+    void *QueryInterface, *AddRef, *Release, *GetIids, *GetRuntimeClassName, *GetTrustLevel;
+    void *get_Current, *IsResourceReference;
+} statics_vtbl =
+{
+    statics_QueryInterface, statics_AddRef, statics_Release, statics_GetIids, statics_GetRuntimeClassName,
+    statics_GetTrustLevel, statics_get_Current, statics_IsResourceReference,
+};
+
+static struct manager_statics manager_statics =
+{
+    { &factory_vtbl },
+    &statics_vtbl,
+    1,
+};
+
+IActivationFactory *resource_manager_factory = &manager_statics.IActivationFactory_iface;
+
