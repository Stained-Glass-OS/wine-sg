+/* ---- RegisterPackageByFamilyNameAndOptionalPackagesAsync --------------------------- */
+
+static BOOL find_installed_family( struct package_record *rec, void *context )
+{
+    const WCHAR **family_name = context;
+
+    if (rec->family_name && !wcsicmp( rec->family_name, *family_name ))
+    {
+        *family_name = NULL;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* Registers an installed package again, for this user.  Packages here are
+ * installed for the user who adds them, so an installed one is registered;
+ * one that is not installed cannot be, as on Windows
+ * (ERROR_INSTALL_PACKAGE_NOT_FOUND). */
+HRESULT register_family_work( const WCHAR *family_name, DeploymentOptions options, WCHAR **error_text )
+{
+    const WCHAR *search = family_name;
+
+    TRACE( "family %s, options %#x\n", debugstr_w( family_name ), options );
+
+    if (!family_name || !family_name[0] || wcschr( family_name, '\\' ))
+    {
+        set_error( error_text, L"Not a package family name", family_name );
+        return E_INVALIDARG;
+    }
+    for_each_record( find_installed_family, &search );
+    if (search)
+    {
+        set_error( error_text, L"The package could not be found", family_name );
+        return 0x80073cf1; /* ERROR_INSTALL_PACKAGE_NOT_FOUND */
+    }
+    return S_OK;
+}
