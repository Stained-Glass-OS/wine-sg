+DEFINE_IINSPECTABLE( package_manager5, IPackageManager5, struct package_manager, IPackageManager_iface );
+
+/* One volume here; optional packages are not deployed with the main one. */
+static HRESULT WINAPI package_manager5_AddPackageToVolumeAndOptionalPackagesAsync( IPackageManager5 *iface, IUriRuntimeClass *uri,
+    IIterable_Uri *dependencies, DeploymentOptions options, IPackageVolume *volume, IIterable_HSTRING *optional_family_names,
+    IIterable_Uri *external_package_uris, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    TRACE( "iface %p, uri %p, dependencies %p, options %#x, volume %p, optional %p, external %p, operation %p.\n",
+           iface, uri, dependencies, options, volume, optional_family_names, external_package_uris, operation );
+
+    if (!operation) return E_POINTER;
+    if (options & DeploymentOptions_DevelopmentMode) return E_INVALIDARG;
+    if (optional_family_names || external_package_uris)
+        FIXME( "optional packages are not deployed\n" );
+    return start_add( uri, dependencies, options, operation );
+}
+
+static HRESULT WINAPI package_manager5_StagePackageToVolumeAndOptionalPackagesAsync( IPackageManager5 *iface, IUriRuntimeClass *uri,
+    IIterable_Uri *dependencies, DeploymentOptions options, IPackageVolume *volume, IIterable_HSTRING *optional_family_names,
+    IIterable_Uri *external_package_uris, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    FIXME( "iface %p, uri %p: staging is not implemented\n", iface, uri );
+    return E_NOTIMPL;
+}
+
+/* Registering by family name is how a program repairs a package it needs:
+ * the operation completes, with the package registered, or with "not found"
+ * when it is not installed. */
+static HRESULT WINAPI package_manager5_RegisterPackageByFamilyNameAndOptionalPackagesAsync( IPackageManager5 *iface,
+    HSTRING family_name, IIterable_HSTRING *dependency_family_names, DeploymentOptions options, IPackageVolume *volume,
+    IIterable_HSTRING *optional_family_names, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    TRACE( "iface %p, family_name %s, dependencies %p, options %#x, volume %p, optional %p, operation %p.\n", iface,
+           debugstr_hstring( family_name ), dependency_family_names, options, volume, optional_family_names, operation );
+
+    if (!operation) return E_POINTER;
+    return start_one( register_family_work, family_name ? WindowsGetStringRawBuffer( family_name, NULL ) : L"",
+                      options, operation );
+}
+
+static HRESULT WINAPI package_manager5_get_DebugSettings( IPackageManager5 *iface, IInspectable **value )
+{
+    FIXME( "iface %p, value %p: no debug settings\n", iface, value );
+    return E_NOTIMPL;
+}
