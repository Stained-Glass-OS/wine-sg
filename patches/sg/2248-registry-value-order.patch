@@ -238,6 +241,30 @@ static void dump_path( const struct key *key, const struct key *base, FILE *f )
 }
 
 /* dump a value to a text file */
+/* build the array of value indexes in creation order, if it isn't there; on
+ * failure key->order stays NULL and callers use the sorted order */
+static const struct key_value *seq_sort_values;  /* the array being sorted (the server is single threaded) */
+
+static int compare_value_seq( const void *a, const void *b )
+{
+    unsigned int sa = seq_sort_values[*(const int *)a].seq, sb = seq_sort_values[*(const int *)b].seq;
+    return sa < sb ? -1 : sa > sb;
+}
+
+static void value_order( struct key *key )
+{
+    int i;
+
+    if (key->order || key->last_value < 1) return;
+#ifdef SG_MUTANT_REG_SORTED_ENUM
+    return;
+#endif
+    if (!(key->order = malloc( (key->last_value + 1) * sizeof(*key->order) ))) return;
+    for (i = 0; i <= key->last_value; i++) key->order[i] = i;
+    seq_sort_values = key->values;
+    qsort( key->order, key->last_value + 1, sizeof(*key->order), compare_value_seq );
+}
+
 static void dump_value( const struct key_value *value, FILE *f )
 {
     unsigned int i, dw;
@@ -363,7 +390,9 @@ static void save_subkeys( const struct key *key, const struct key *base, FILE *f
