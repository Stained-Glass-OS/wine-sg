From: Stained Glass OS <ke7oxh@gmail.com>
d3dx9: effect sampler states from float expressions are enumeration numbers

A sampler state set from a floating point parameter or expression (the
magnification filters in the effect test) gets the number as an integer, not
the float's bits; the mipmap LOD bias keeps its bits. Removes nine
todo_wine marks of the effect preshader test.
---
--- a/dlls/d3dx9_36/effect.c
+++ b/dlls/d3dx9_36/effect.c
@@ -1679,10 +1679,18 @@ static HRESULT d3dx9_apply_state(struct d3dx_effect *effect, struct d3dx_pass *p
         {
             UINT sampler;
 
+            DWORD value = *(DWORD *)param_value;
+
             sampler = parent_index == ~0u ? state->index : parent_index;
-            TRACE("%s, sampler %u, value %lu.\n", state_table[state->operation].name, sampler, *(DWORD *)param_value);
-            return SET_D3D_STATE(effect, SetSamplerState, sampler, state_table[state->operation].op,
-                    *(DWORD *)param_value);
+            /* A floating point parameter gives the number the enumeration has, except for the one float
+             * valued state, the mipmap LOD bias, that keeps the bits. */
+#ifndef SG_MUTANT_D3DX_SAMPLER_FLOAT_BITS
+            if (param && param->type == D3DXPT_FLOAT
+                    && state_table[state->operation].op != D3DSAMP_MIPMAPLODBIAS)
+                value = (DWORD)*(float *)param_value;
+#endif
+            TRACE("%s, sampler %u, value %lu.\n", state_table[state->operation].name, sampler, value);
+            return SET_D3D_STATE(effect, SetSamplerState, sampler, state_table[state->operation].op, value);
         }
         case SC_VERTEXSHADER:
             TRACE("%s, shader %p.\n", state_table[state->operation].name, *(IDirect3DVertexShader9 **)param_value);
