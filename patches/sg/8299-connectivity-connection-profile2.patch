From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.networking.connectivity: ConnectionProfile answers IConnectionProfile2

A connection profile did not answer IConnectionProfile2. Qt 6's network information plugin, in the build Audacity 4 ships, used the interface without checking that it was there, and Audacity crashed at start. The profile now answers it: whether it is a Wi-Fi or mobile broadband profile (from its adapter's interface type), no service provider or signal bars, and no domain connectivity; the usage queries are not implemented.
---
--- a/include/windows.networking.connectivity.idl
+++ b/include/windows.networking.connectivity.idl
@@ -68,6 +68,10 @@
     typedef enum NetworkEncryptionType NetworkEncryptionType;
     typedef enum NetworkTypes NetworkTypes;
     typedef enum RoamingStates RoamingStates;
+    typedef enum DomainConnectivityLevel DomainConnectivityLevel;
+    typedef enum TriStates TriStates;
+    typedef enum NetworkUsageGranularity NetworkUsageGranularity;
+    typedef struct NetworkUsageStates NetworkUsageStates;
 
     declare
     {
@@ -208,6 +212,69 @@
         [propget] HRESULT NetworkSecuritySettings([out, retval] Windows.Networking.Connectivity.NetworkSecuritySettings **value);
     }
 
+    /* (wine-sg 8299) IConnectionProfile2; the classes its details and usage methods return are not
+     * declared here: they are passed as IInspectable */
+    [
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+    ]
+    enum DomainConnectivityLevel
+    {
+        None            = 0,
+        Unauthenticated = 1,
+        Authenticated   = 2,
+    };
+
+    [
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+    ]
+    enum TriStates
+    {
+        DoNotCare = 0,
+        No        = 1,
+        Yes       = 2,
+    };
+
+    [
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+    ]
+    enum NetworkUsageGranularity
+    {
+        PerMinute = 0,
+        PerHour   = 1,
+        PerDay    = 2,
+        Total     = 3,
+    };
+
+    [
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+    ]
+    struct NetworkUsageStates
+    {
+        Windows.Networking.Connectivity.TriStates Roaming;
+        Windows.Networking.Connectivity.TriStates Shared;
+    };
+
+    [
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+        exclusiveto(Windows.Networking.Connectivity.ConnectionProfile),
+        uuid(e2045145-4c9f-400c-9150-7ec7d6e2888a),
+    ]
+    interface IConnectionProfile2 : IInspectable
+    {
+        [propget] HRESULT IsWwanConnectionProfile([out, retval] boolean *value);
+        [propget] HRESULT IsWlanConnectionProfile([out, retval] boolean *value);
+        [propget] HRESULT WwanConnectionProfileDetails([out, retval] IInspectable **value);
+        [propget] HRESULT WlanConnectionProfileDetails([out, retval] IInspectable **value);
+        [propget] HRESULT ServiceProviderGuid([out, retval] Windows.Foundation.IReference<GUID> **value);
+        HRESULT GetSignalBars([out, retval] Windows.Foundation.IReference<BYTE> **value);
+        HRESULT GetDomainConnectivityLevel([out, retval] Windows.Networking.Connectivity.DomainConnectivityLevel *value);
+        HRESULT GetNetworkUsageAsync([in] Windows.Foundation.DateTime start, [in] Windows.Foundation.DateTime end,
+                [in] Windows.Networking.Connectivity.NetworkUsageGranularity granularity,
+                [in] Windows.Networking.Connectivity.NetworkUsageStates states, [out, retval] IInspectable **value);
+        HRESULT GetConnectivityIntervalsAsync([in] Windows.Foundation.DateTime start, [in] Windows.Foundation.DateTime end,
+                [in] Windows.Networking.Connectivity.NetworkUsageStates states, [out, retval] IInspectable **value);
+    }
+
     [
         contract(Windows.Foundation.UniversalApiContract, 1.0),
         exclusiveto(Windows.Networking.Connectivity.DataPlanStatus),
--- a/dlls/windows.networking.connectivity/network_information.c
+++ b/dlls/windows.networking.connectivity/network_information.c
@@ -531,6 +531,7 @@
 struct connection_profile
 {
     IConnectionProfile IConnectionProfile_iface;
+    IConnectionProfile2 IConnectionProfile2_iface;   /* wine-sg 8299 */
     LONG ref;
 
     INetworkListManager *network_list_manager;
@@ -889,6 +890,14 @@
         IInspectable_AddRef( *out );
         return S_OK;
     }
+#ifndef SG_MUTANT_NO_PROFILE2
+    if (IsEqualGUID( iid, &IID_IConnectionProfile2 ))
+    {
+        *out = &impl->IConnectionProfile2_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+#endif
 
     FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
@@ -1232,12 +1241,130 @@
     connection_profile_get_NetworkSecuritySettings,
 };
 
+/* (wine-sg 8299) IConnectionProfile2: whether the profile's network is reached by Wi-Fi or a mobile
+ * broadband connection (its adapter's interface type), and its domain connectivity.  Qt 6's network
+ * information plugin used the interface without checking it was there (Audacity 4 crashed at start). */
+DEFINE_IINSPECTABLE( connection_profile2, IConnectionProfile2, struct connection_profile, IConnectionProfile_iface )
+
+static HRESULT profile_if_type( struct connection_profile *impl, DWORD *type )
+{
+    struct adapter_info info;
+    HRESULT hr;
+
+    *type = 0;
+    if (FAILED(hr = profile_get_adapter( impl, &info, NULL, NULL ))) return hr;
+    *type = info.if_type;
+    return S_OK;
+}
+
+static HRESULT WINAPI connection_profile2_get_IsWwanConnectionProfile( IConnectionProfile2 *iface, boolean *value )
+{
+    struct connection_profile *impl = impl_from_IConnectionProfile2( iface );
+    DWORD type;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    profile_if_type( impl, &type );
+    *value = type == IF_TYPE_WWANPP || type == IF_TYPE_WWANPP2;
+    return S_OK;
+}
+
+static HRESULT WINAPI connection_profile2_get_IsWlanConnectionProfile( IConnectionProfile2 *iface, boolean *value )
+{
+    struct connection_profile *impl = impl_from_IConnectionProfile2( iface );
+    DWORD type;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    profile_if_type( impl, &type );
+    *value = type == IF_TYPE_IEEE80211;
+    return S_OK;
+}
+
+static HRESULT WINAPI connection_profile2_get_WwanConnectionProfileDetails( IConnectionProfile2 *iface, IInspectable **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = NULL;   /* no mobile broadband details are known here */
+    return S_OK;
+}
+
+static HRESULT WINAPI connection_profile2_get_WlanConnectionProfileDetails( IConnectionProfile2 *iface, IInspectable **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = NULL;   /* the SSID is not known here */
+    return S_OK;
+}
+
+static HRESULT WINAPI connection_profile2_get_ServiceProviderGuid( IConnectionProfile2 *iface, IReference_GUID **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI connection_profile2_GetSignalBars( IConnectionProfile2 *iface, IReference_BYTE **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI connection_profile2_GetDomainConnectivityLevel( IConnectionProfile2 *iface, DomainConnectivityLevel *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = DomainConnectivityLevel_None;   /* no domain controller is reached */
+    return S_OK;
+}
+
+static HRESULT WINAPI connection_profile2_GetNetworkUsageAsync( IConnectionProfile2 *iface, DateTime start, DateTime end,
+        NetworkUsageGranularity granularity, NetworkUsageStates states, IInspectable **value )
+{
+    FIXME( "iface %p, granularity %d, value %p stub!\n", iface, granularity, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI connection_profile2_GetConnectivityIntervalsAsync( IConnectionProfile2 *iface, DateTime start,
+        DateTime end, NetworkUsageStates states, IInspectable **value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IConnectionProfile2Vtbl connection_profile2_vtbl =
+{
+    connection_profile2_QueryInterface,
+    connection_profile2_AddRef,
+    connection_profile2_Release,
+    /* IInspectable methods */
+    connection_profile2_GetIids,
+    connection_profile2_GetRuntimeClassName,
+    connection_profile2_GetTrustLevel,
+    /* IConnectionProfile2 methods */
+    connection_profile2_get_IsWwanConnectionProfile,
+    connection_profile2_get_IsWlanConnectionProfile,
+    connection_profile2_get_WwanConnectionProfileDetails,
+    connection_profile2_get_WlanConnectionProfileDetails,
+    connection_profile2_get_ServiceProviderGuid,
+    connection_profile2_GetSignalBars,
+    connection_profile2_GetDomainConnectivityLevel,
+    connection_profile2_GetNetworkUsageAsync,
+    connection_profile2_GetConnectivityIntervalsAsync,
+};
+
 static HRESULT new_profile( INetworkListManager *manager, const GUID *network_id, IConnectionProfile **out )
 {
     struct connection_profile *impl;
 
     if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
     impl->IConnectionProfile_iface.lpVtbl = &connection_profile_vtbl;
+    impl->IConnectionProfile2_iface.lpVtbl = &connection_profile2_vtbl;
     impl->ref = 1;
     INetworkListManager_AddRef( (impl->network_list_manager = manager) );
     if (network_id)
