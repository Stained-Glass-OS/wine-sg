+static void performance_get_time_signature(struct performance *This, MUSIC_TIME time, DMUS_TIMESIGNATURE *sig)
+{
+    IDirectMusicPerformance8 *iface = &This->IDirectMusicPerformance8_iface;
+
+    if (FAILED(IDirectMusicPerformance8_GetParam(iface, &GUID_TimeSignature, -1, DMUS_SEG_ALLTRACKS,
+            time, NULL, sig)))
+    {
+        /* without time signature track the default is 4/4, with two grids per beat,
+         * from the start of the performance (the time is relative to the one asked for) */
+        sig->mtTime = -time;
+        sig->bBeatsPerMeasure = 4;
+        sig->bBeat = 4;
+        sig->wGridsPerBeat = 2;
+    }
+}
+
+static HRESULT performance_resolve_time(struct performance *This, REFERENCE_TIME time, DWORD flags,
+        REFERENCE_TIME *ret_time)
+{
+    static const DWORD grid_flags = DMUS_TIME_RESOLVE_GRID | DMUS_TIME_RESOLVE_BEAT | DMUS_TIME_RESOLVE_MEASURE;
+    IDirectMusicPerformance8 *iface = &This->IDirectMusicPerformance8_iface;
+    REFERENCE_TIME now, other;
+    HRESULT hr;
+
+    if (FAILED(hr = IDirectMusicPerformance8_GetTime(iface, &now, NULL))) return hr;
+    if (!time) time = now;
+
+    if (flags & DMUS_TIME_RESOLVE_AFTERPREPARETIME) time = max(time, now + This->dwPrepareTime * 10000);
+    if (flags & DMUS_TIME_RESOLVE_AFTERQUEUETIME)
+    {
+        if (FAILED(hr = IDirectMusicPerformance8_GetQueueTime(iface, &other))) return hr;
+        time = max(time, other);
+    }
+    if (flags & DMUS_TIME_RESOLVE_AFTERLATENCYTIME)
+    {
+        if (FAILED(hr = IDirectMusicPerformance8_GetLatencyTime(iface, &other))) return hr;
+        time = max(time, other);
+    }
+
+#ifdef SG_MUTANT_RESOLVE
+    flags = 0;
+#endif
+    if (flags & grid_flags)
+    {
+        MUSIC_TIME music_time, start, unit, length;
+        DMUS_TIMESIGNATURE sig;
+
+        if (FAILED(hr = IDirectMusicPerformance8_ReferenceToMusicTime(iface, time, &music_time))) return hr;
+        performance_get_time_signature(This, music_time, &sig);
+
+        /* the coarsest requested boundary wins */
+        unit = DMUS_PPQ * 4 / max(sig.bBeat, 1);
+        if (flags & DMUS_TIME_RESOLVE_MEASURE) unit *= sig.bBeatsPerMeasure;
+        else if (!(flags & DMUS_TIME_RESOLVE_BEAT)) unit /= max(sig.wGridsPerBeat, 1);
+        if (unit < 1) unit = 1;
+
+        /* boundaries are counted from the start of the time signature */
+        start = music_time + sig.mtTime;
+        length = music_time - start;
+        if (length < 0) music_time = start;
+        else if (length % unit) music_time += unit - length % unit;
+
+        if (FAILED(hr = IDirectMusicPerformance8_MusicToReferenceTime(iface, music_time, &other))) return hr;
+        /* the music time was rounded to the nearest tick, the boundary must not be in the past */
+        if (other < time)
+        {
+            music_time += unit;
+            if (FAILED(hr = IDirectMusicPerformance8_MusicToReferenceTime(iface, music_time, &other))) return hr;
+        }
+        time = other;
+    }
+
+    *ret_time = time;
+    return S_OK;
+}
