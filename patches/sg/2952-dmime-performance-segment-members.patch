+BOOL segment_state_has_audio_path(IDirectMusicSegmentState *iface, IDirectMusicAudioPath *path)
+{
+    struct segment_state *This = impl_from_IDirectMusicSegmentState8((IDirectMusicSegmentState8 *)iface);
+    return This->audio_path == path;
+}
+
+/* the performance time the segment state started at, and the time it will end at (if it does not loop) */
+void segment_state_get_times(IDirectMusicSegmentState *iface, MUSIC_TIME *start, MUSIC_TIME *end)
+{
+    struct segment_state *This = impl_from_IDirectMusicSegmentState8((IDirectMusicSegmentState8 *)iface);
+
+    *start = This->start_time;
+    *end = This->start_time + (This->end_point - This->start_point) * (1 + This->actual_repeats);
+}
+
+HRESULT segment_state_get_track(IDirectMusicSegmentState *iface, DWORD track_id, MUSIC_TIME *time_offset,
+        IDirectMusicTrack **ret_track)
+{
+    struct segment_state *This = impl_from_IDirectMusicSegmentState8((IDirectMusicSegmentState8 *)iface);
+    struct track_entry *entry;
+
+    LIST_FOR_EACH_ENTRY(entry, &This->tracks, struct track_entry, entry)
+    {
+        if (entry->track_id != track_id) continue;
+        *time_offset = This->start_time - This->start_point;
+        *ret_track = entry->track;
+        IDirectMusicTrack_AddRef(entry->track);
+        return S_OK;
+    }
+
+    return DMUS_E_NOT_FOUND;
+}
+
+BOOL segment_state_will_invalidate(IDirectMusicSegmentState *iface, MUSIC_TIME time)
+{
+    struct segment_state *This = impl_from_IDirectMusicSegmentState8((IDirectMusicSegmentState8 *)iface);
+    return max(time - This->start_time, 0) < This->played;
+}
+
+/* Rewinds the segment state to time and plays its tracks again up to where they had played,
+ * with DMUS_TRACKF_SEEK and DMUS_TRACKF_DIRTY. */
+HRESULT segment_state_invalidate(IDirectMusicSegmentState *iface, IDirectMusicPerformance8 *performance,
+        MUSIC_TIME time)
+{
+    struct segment_state *This = impl_from_IDirectMusicSegmentState8((IDirectMusicSegmentState8 *)iface);
+    MUSIC_TIME position = max(time - This->start_time, 0), played = This->played;
+    HRESULT hr;
+
+    if (position >= played) return S_OK;
+
+    This->played = position;
+    This->track_flags |= DMUS_TRACKF_SEEK | DMUS_TRACKF_DIRTY;
+    hr = segment_state_play_until(This, performance, This->start_time + played, This->track_flags);
+    return FAILED(hr) ? hr : S_OK;
+}
