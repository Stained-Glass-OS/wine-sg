 static HRESULT WINAPI ShellImageData_Scale(IShellImageData *iface, ULONG cx, ULONG cy, InterpolationMode mode)
 {
     ShellImageData *This = impl_from_IShellImageData(iface);
+    GpBitmap *bitmap;
+    GpGraphics *graphics;
+    REAL width, height;
+    HRESULT hr;
 
-    FIXME("%p, %lu, %lu, %#x: stub\n", This, cx, cy, mode);
