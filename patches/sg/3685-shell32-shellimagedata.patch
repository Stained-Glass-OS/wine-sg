+/* the frames of one dimension (time: animation frames, page: pages), at least one */
+static UINT sid_frame_count(ShellImageData *This, const GUID *dimension)
+{
+    UINT count = 0;
+    GUID own;
+
+#ifdef SG_MUTANT_SID_PAGE
+    return 1;
+#endif
+
+    /* the image has one dimension (time for animations, page for the rest): the other has one frame */
+    if (GdipImageGetFrameDimensionsList(This->image, &own, 1) != Ok || !IsEqualGUID(&own, dimension)) return 1;
+    if (GdipImageGetFrameCount(This->image, dimension, &count) != Ok || !count) count = 1;
+    return count;
+}
