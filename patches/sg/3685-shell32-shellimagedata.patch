+static HRESULT sid_load(ShellImageData *This, GpImage **image)
+{
+    if (This->path) return gpstatus_to_hresult(GdipLoadImageFromFile(This->path, image));
+    if (This->stream)
+    {
+        LARGE_INTEGER zero = {{0}};
+
+        IStream_Seek(This->stream, zero, STREAM_SEEK_SET, NULL);
+        return gpstatus_to_hresult(GdipLoadImageFromStream(This->stream, image));
+    }
+    return E_FAIL;
 }
 
