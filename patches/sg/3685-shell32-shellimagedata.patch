+static HRESULT sid_select(ShellImageData *This, const GUID *dimension, UINT *current, UINT index)
+{
+    HRESULT hr = gpstatus_to_hresult(GdipImageSelectActiveFrame(This->image, dimension, index));
+
+    if (SUCCEEDED(hr)) *current = index;
+    return hr;
+}
