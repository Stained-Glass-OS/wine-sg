+/* The parameters the built-in encoders take: Transformation, Quality and the tables of the
+ * JPEG encoder; Compression, ColorDepth, SaveFlag and SaveAsCMYK of TIFF; SaveFlag of GIF;
+ * none for BMP and PNG (the lists of the documented sample output; the value sets are
+ * unverified against native). */
+enum { EPT_SHORT = 3, EPT_LONG = 4, EPT_LONGRANGE = 6 };
+
+struct enc_param
+{
+    GUID guid;
+    ULONG type, count;
+    const LONG *values;
+};
+
+static const GUID enc_transformation = {0x8d0eb2d1, 0xa58e, 0x4ea8, {0xaa, 0x14, 0x10, 0x80, 0x74, 0xb7, 0xb6, 0xf9}};
+static const GUID enc_quality = {0x1d5be4b5, 0xfa4a, 0x452d, {0x9c, 0xdd, 0x5d, 0xb3, 0x51, 0x05, 0xe7, 0xeb}};
+static const GUID enc_luminance = {0xedb33bce, 0x0266, 0x4a77, {0xb9, 0x04, 0x27, 0x21, 0x60, 0x99, 0xe7, 0x17}};
+static const GUID enc_chrominance = {0xf2e455dc, 0x09b3, 0x4316, {0x82, 0x60, 0x67, 0x6a, 0xda, 0x32, 0x48, 0x1c}};
+static const GUID enc_saveflag = {0x292266fc, 0xac40, 0x47bf, {0x8c, 0xfc, 0xa8, 0x5b, 0x89, 0xa6, 0x55, 0xde}};
+static const GUID enc_compression = {0xe09d739d, 0xccd4, 0x44ee, {0x8e, 0xba, 0x3f, 0xbf, 0x8b, 0xe4, 0xfc, 0x58}};
+static const GUID enc_colordepth = {0x66087055, 0xad66, 0x4c7c, {0x9a, 0x18, 0x38, 0xa2, 0x31, 0x0b, 0x83, 0x37}};
+static const GUID enc_savecmyk = {0xa219bbc9, 0x0a9d, 0x4005, {0xa3, 0xee, 0x3a, 0x42, 0x1b, 0x8b, 0xb0, 0x6c}};
+
+static const LONG enc_transform_values[] = { 13, 14, 15, 16, 17 };  /* rotate 90/180/270, flip h/v */
+static const LONG enc_quality_range[] = { 0, 100 };
+static const LONG enc_saveflag_values[] = { 18 };                    /* multi frame */
+static const LONG enc_tiff_compression[] = { 2, 3, 4, 5, 6 };        /* LZW, CCITT3, CCITT4, RLE, none */
+static const LONG enc_tiff_depth[] = { 1, 4, 8, 24, 32 };
+static const LONG enc_one[] = { 1 };
+
+static const struct enc_param jpeg_params[] =
+{
+    { {0}, EPT_LONG, 5, enc_transform_values },
+    { {0}, EPT_LONGRANGE, 1, enc_quality_range },
+    { {0}, EPT_SHORT, 0, NULL },
+    { {0}, EPT_SHORT, 0, NULL },
+    { {0}, EPT_LONG, 1, enc_saveflag_values },
+};
+static const struct enc_param tiff_params[] =
+{
+    { {0}, EPT_LONG, 5, enc_tiff_compression },
+    { {0}, EPT_LONG, 5, enc_tiff_depth },
+    { {0}, EPT_LONG, 1, enc_saveflag_values },
+    { {0}, EPT_LONG, 1, enc_one },
+};
+static const struct enc_param gif_params[] = { { {0}, EPT_LONG, 1, enc_saveflag_values } };
+
+/* the parameter table of an encoder (by the last digits of its clsid), with its GUIDs filled */
+static UINT get_encoder_params(const CLSID *clsid, struct enc_param *out)
+{
+    const struct enc_param *src = NULL;
+    UINT n = 0, i;
+    const GUID *guids_jpeg[] = { &enc_transformation, &enc_quality, &enc_luminance, &enc_chrominance, &enc_saveflag };
+    const GUID *guids_tiff[] = { &enc_compression, &enc_colordepth, &enc_saveflag, &enc_savecmyk };
+    const GUID **guids = NULL;
+
+    if (clsid->Data1 == 0x557cf401) { src = jpeg_params; n = ARRAY_SIZE(jpeg_params); guids = guids_jpeg; }
+    else if (clsid->Data1 == 0x557cf405) { src = tiff_params; n = ARRAY_SIZE(tiff_params); guids = guids_tiff; }
+    else if (clsid->Data1 == 0x557cf402) { src = gif_params; n = ARRAY_SIZE(gif_params); guids = guids_tiff + 2; }
+    if (out) for (i = 0; i < n; i++) { out[i] = src[i]; out[i].guid = *guids[i]; }
+    return n;
+}
+
+static BOOL is_builtin_encoder(const CLSID *clsid)
+{
+    int i;
+
+    for (i = 0; i < NUM_CODECS; i++)
+        if ((codecs[i].info.Flags & ImageCodecFlagsEncoder) && IsEqualGUID(&codecs[i].info.Clsid, clsid)) return TRUE;
+    return FALSE;
+}
+
 GpStatus WINGDIPAPI GdipGetEncoderParameterListSize(GpImage *image,
     GDIPCONST CLSID* clsidEncoder, UINT *size)
 {
-    static int calls;
+    struct enc_param params[8];
+    UINT n, i, bytes;
 
     TRACE("(%p,%s,%p)\n", image, debugstr_guid(clsidEncoder), size);
 
-    if(!(calls++))
-        FIXME("not implemented\n");
+    if (!image || !clsidEncoder || !size) return InvalidParameter;
+    if (!is_builtin_encoder(clsidEncoder)) return Win32Error;
+
+    n = get_encoder_params(clsidEncoder, params);
+    bytes = sizeof(UINT) + n * sizeof(EncoderParameter);
+    for (i = 0; i < n; i++) bytes += params[i].count * sizeof(LONG);
+    /* no parameters at all: the size is zero */
+    *size = n ? bytes : 0;
+    return Ok;
+}
+
+GpStatus WINGDIPAPI GdipGetEncoderParameterList(GpImage *image, GDIPCONST CLSID* clsidEncoder, UINT size,
+    EncoderParameters *buffer)
+{
+    struct enc_param params[8];
+    UINT n, i, need;
+    LONG *data;
 
-    *size = 0;
+    TRACE("(%p,%s,%u,%p)\n", image, debugstr_guid(clsidEncoder), size, buffer);
 
+    if (!image || !clsidEncoder || !buffer) return InvalidParameter;
+#ifdef SG_MUTANT_ENCPARAMS
     return NotImplemented;
+#endif
+    if (GdipGetEncoderParameterListSize(image, clsidEncoder, &need) != Ok) return Win32Error;
+    if (size != need || !need) return InvalidParameter;
+
+    n = get_encoder_params(clsidEncoder, params);
+    buffer->Count = n;
+    data = (LONG *)&buffer->Parameter[n];
+    for (i = 0; i < n; i++)
+    {
+        buffer->Parameter[i].Guid = params[i].guid;
+        buffer->Parameter[i].Type = params[i].type;
+        buffer->Parameter[i].NumberOfValues = params[i].count;
+        buffer->Parameter[i].Value = params[i].count ? data : NULL;
+        if (params[i].count)
+        {
+            memcpy(data, params[i].values, params[i].count * sizeof(LONG));
+            data += params[i].count;
+        }
+    }
+    return Ok;
 }
 
 static PixelFormat get_16bpp_format(HBITMAP hbm)
