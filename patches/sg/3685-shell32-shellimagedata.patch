+    hr = gpstatus_to_hresult(GdipGetImageGraphicsContext((GpImage *)bitmap, &graphics));
+    if (SUCCEEDED(hr))
+    {
+        GdipSetInterpolationMode(graphics, mode);
+        hr = gpstatus_to_hresult(GdipDrawImageRectRect(graphics, This->image, 0, 0, cx, cy, 0, 0, width, height,
+                UnitPixel, NULL, NULL, NULL));
+        GdipDeleteGraphics(graphics);
+    }
+    if (SUCCEEDED(hr))
+    {
+        GdipDisposeImage(This->image);
+        This->image = (GpImage *)bitmap;
+        This->frame = This->page = 0;
+        This->dirty = TRUE;
+    }
+    else
+        GdipDisposeImage((GpImage *)bitmap);
+    return hr;
+}
