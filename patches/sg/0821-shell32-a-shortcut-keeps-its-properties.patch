From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: a shortcut keeps its properties

Installers and programs set a shortcut's System.AppUserModel.ID and
System.AppUserModel.ToastActivatorCLSID (Chrome, Electron programs,
programs using toast activators) through the shortcut's IPropertyStore.
Wine's store was a stub that kept nothing, and a shortcut's extra data
blocks were not read, so the identity the notification centre (0819) and
the taskbar find a program by was lost. Now the store keeps the values
set, and the shortcut saves them in its property storage data block
(serialized property storages, MS-SHLLINK/MS-PROPSTORE) and reads them
back: strings, CLSIDs, booleans and 32/64-bit integers. The other extra
data blocks of a shortcut made elsewhere are skipped as before.

Test: test/toastactivate-gate.sh (shortcut saved and loaded, its activator
found; mutant SG_MUTANT_NO_LINK_PROPERTIES).
---
--- a/dlls/shell32/shelllink.c
+++ b/dlls/shell32/shelllink.c
@@ -115,6 +115,12 @@
 
 /* IShellLink Implementation */
 
+struct link_property
+{
+    PROPERTYKEY key;
+    PROPVARIANT value;
+};
+
 typedef struct
 {
         IShellLinkA IShellLinkA_iface;
@@ -153,6 +159,11 @@
 	IUnknown      *site;
 
 	LPOLESTR      filepath; /* file path returned by IPersistFile::GetCurFile */
+
+	/* Stained Glass OS: the shortcut's properties (IPropertyStore), kept
+	 * in its property storage data block */
+	struct link_property *props;
+	DWORD         prop_count;
 } IShellLinkImpl;
 
 static inline IShellLinkImpl *impl_from_IShellLinkA(IShellLinkA *iface)
@@ -200,6 +211,234 @@
     return CONTAINING_RECORD(iface, IShellLinkImpl, IPropertyStore_iface);
 }
 
+/* Stained Glass OS: a shortcut's properties -- System.AppUserModel.ID, the
+ * CLSID of the program's toast activator and the like, which installers and
+ * programs set through its IPropertyStore -- are kept in the shortcut, in a
+ * property storage data block (signature 0xa0000009) holding serialized
+ * property storages: per format ID, values named by number (or by string,
+ * for the format of named properties). Wine's store kept nothing, so a
+ * program's shortcut lost the identity the taskbar and the notification
+ * centre find it by. Strings, CLSIDs, booleans and 32/64-bit integers are
+ * stored; values of other types live in memory only. */
+
+#define SPS_VERSION 0x53505331  /* '1SPS' */
+
+DEFINE_GUID(FMTID_link_named_props, 0xd5cdd505, 0x2e9c, 0x101b, 0x93, 0x97, 0x08, 0x00, 0x2b, 0x2c, 0xf9, 0xae);
+
+static void link_props_free( IShellLinkImpl *This )
+{
+    DWORD i;
+    for (i = 0; i < This->prop_count; i++) PropVariantClear( &This->props[i].value );
+    free( This->props );
+    This->props = NULL;
+    This->prop_count = 0;
+}
+
+static struct link_property *link_prop_find( IShellLinkImpl *This, const PROPERTYKEY *key )
+{
+    DWORD i;
+    for (i = 0; i < This->prop_count; i++)
+        if (IsEqualGUID( &This->props[i].key.fmtid, &key->fmtid ) && This->props[i].key.pid == key->pid)
+            return &This->props[i];
+    return NULL;
+}
+
+static HRESULT link_prop_set( IShellLinkImpl *This, const PROPERTYKEY *key, const PROPVARIANT *value )
+{
+    struct link_property *prop = link_prop_find( This, key ), *grown;
+    PROPVARIANT copy;
+    HRESULT hr;
+
+    if (FAILED(hr = PropVariantCopy( &copy, value ))) return hr;
+    if (!prop)
+    {
+        if (!(grown = realloc( This->props, (This->prop_count + 1) * sizeof(*grown) )))
+        {
+            PropVariantClear( &copy );
+            return E_OUTOFMEMORY;
+        }
+        This->props = grown;
+        prop = &This->props[This->prop_count++];
+        prop->key = *key;
+        PropVariantInit( &prop->value );
+    }
+    PropVariantClear( &prop->value );
+    prop->value = copy;
+    return S_OK;
+}
+
+/* the bytes of one typed value (MS-OLEPS TypedPropertyValue), padded to 4; 0 if not stored */
+static DWORD link_value_size( const PROPVARIANT *value )
+{
+    switch (value->vt)
+    {
+    case VT_LPWSTR: return value->pwszVal ? 4 + 4 + ((lstrlenW( value->pwszVal ) + 1) * sizeof(WCHAR) + 3) / 4 * 4 : 0;
+    case VT_CLSID: return value->puuid ? 4 + sizeof(GUID) : 0;
+    case VT_BOOL: case VT_I4: case VT_UI4: return 4 + 4;
+    case VT_I8: case VT_UI8: return 4 + 8;
+    default: return 0;
+    }
+}
+
+static void link_value_write( BYTE *p, const PROPVARIANT *value )
+{
+    DWORD len;
+
+    *(WORD *)p = value->vt;
+    *(WORD *)(p + 2) = 0;
+    p += 4;
+    switch (value->vt)
+    {
+    case VT_LPWSTR:
+        len = lstrlenW( value->pwszVal ) + 1;
+        memcpy( p, &len, 4 );
+        memcpy( p + 4, value->pwszVal, len * sizeof(WCHAR) );
+        break;
+    case VT_CLSID: memcpy( p, value->puuid, sizeof(GUID) ); break;
+    case VT_BOOL: *(DWORD *)p = 0; *(VARIANT_BOOL *)p = value->boolVal; break;
+    case VT_I4: case VT_UI4: memcpy( p, &value->ulVal, 4 ); break;
+    case VT_I8: case VT_UI8: memcpy( p, &value->uhVal, 8 ); break;
+    }
+}
+
+/* reads one typed value; FALSE if malformed or of a type not kept */
+static BOOL link_value_read( const BYTE *p, DWORD size, PROPVARIANT *value )
+{
+    DWORD len;
+
+    PropVariantInit( value );
+    if (size < 4) return FALSE;
+    value->vt = *(const WORD *)p;
+    p += 4;
+    size -= 4;
+    switch (value->vt)
+    {
+    case VT_LPWSTR:
+        if (size < 4) return FALSE;
+        memcpy( &len, p, 4 );
+        if (!len || len > (size - 4) / sizeof(WCHAR)) return FALSE;
+        if (!(value->pwszVal = CoTaskMemAlloc( len * sizeof(WCHAR) ))) return FALSE;
+        memcpy( value->pwszVal, p + 4, len * sizeof(WCHAR) );
+        value->pwszVal[len - 1] = 0;
+        return TRUE;
+    case VT_CLSID:
+        if (size < sizeof(GUID) || !(value->puuid = CoTaskMemAlloc( sizeof(GUID) ))) return FALSE;
+        memcpy( value->puuid, p, sizeof(GUID) );
+        return TRUE;
+    case VT_BOOL:
+        if (size < 2) return FALSE;
+        value->boolVal = *(const VARIANT_BOOL *)p;
+        return TRUE;
+    case VT_I4: case VT_UI4:
+        if (size < 4) return FALSE;
+        memcpy( &value->ulVal, p, 4 );
+        return TRUE;
+    case VT_I8: case VT_UI8:
+        if (size < 8) return FALSE;
+        memcpy( &value->uhVal, p, 8 );
+        return TRUE;
+    }
+    value->vt = VT_EMPTY;
+    return FALSE;
+}
+
+/* the property storage data block, or NULL when there is nothing to keep */
+static BYTE *link_props_block( IShellLinkImpl *This, DWORD *block_size )
+{
+    DWORD i, j, size = 8 + 4, storage, value;
+    BYTE *block, *p;
+    BOOL *done;
+
+#ifdef SG_MUTANT_NO_LINK_PROPERTIES
+    return NULL;
+#endif
+    if (!This->prop_count || !(done = calloc( This->prop_count, sizeof(*done) ))) return NULL;
+    for (i = 0; i < This->prop_count; i++)
+    {
+        if (!(value = link_value_size( &This->props[i].value )) ||
+            IsEqualGUID( &This->props[i].key.fmtid, &FMTID_link_named_props )) { done[i] = TRUE; continue; }
+        size += 4 + 4 + 16 + 4;   /* a storage of its own at most */
+        size += 4 + 4 + 1 + value;
+    }
+    if (size == 8 + 4 || !(block = calloc( 1, size )))
+    {
+        free( done );
+        return NULL;
+    }
+    p = block + 8;
+    for (i = 0; i < This->prop_count; i++)
+    {
+        BYTE *start;
+        if (done[i]) continue;
+        /* one storage per format ID */
+        start = p;
+        p += 4;
+        *(DWORD *)p = SPS_VERSION; p += 4;
+        memcpy( p, &This->props[i].key.fmtid, 16 ); p += 16;
+        for (j = i; j < This->prop_count; j++)
+        {
+            if (done[j] || !IsEqualGUID( &This->props[j].key.fmtid, &This->props[i].key.fmtid )) continue;
+            value = link_value_size( &This->props[j].value );
+            *(DWORD *)p = 4 + 4 + 1 + value;
+            *(DWORD *)(p + 4) = This->props[j].key.pid;
+            p[8] = 0;
+            link_value_write( p + 9, &This->props[j].value );
+            p += 4 + 4 + 1 + value;
+            done[j] = TRUE;
+        }
+        *(DWORD *)p = 0; p += 4;  /* the end of its values */
+        storage = p - start;
+        memcpy( start, &storage, 4 );
+    }
+    *(DWORD *)p = 0; p += 4;  /* the end of the storages */
+    free( done );
+    *block_size = p - block;
+    ((DWORD *)block)[0] = *block_size;
+    ((DWORD *)block)[1] = EXP_PROPERTYSTORAGE_SIG;
+    return block;
+}
+
+/* the properties of a property storage data block (after its size and signature) */
+static void link_props_parse( IShellLinkImpl *This, const BYTE *p, DWORD size )
+{
+    while (size >= 4)
+    {
+        DWORD storage, value_size;
+        const BYTE *values;
+        GUID fmtid;
+
+        memcpy( &storage, p, 4 );
+        if (storage < 4 + 4 + 16 || storage > size) break;
+        if (*(const DWORD *)(p + 4) == SPS_VERSION)
+        {
+            memcpy( &fmtid, p + 8, 16 );
+            values = p + 24;
+            while (values + 4 <= p + storage)
+            {
+                memcpy( &value_size, values, 4 );
+                if (!value_size || value_size < 9 || values + value_size > p + storage) break;
+                if (!IsEqualGUID( &fmtid, &FMTID_link_named_props ))
+                {
+                    PROPERTYKEY key;
+                    PROPVARIANT value;
+
+                    key.fmtid = fmtid;
+                    memcpy( &key.pid, values + 4, 4 );
+                    if (link_value_read( values + 9, value_size - 9, &value ))
+                    {
+                        TRACE( "property %s,%lu type %u\n", debugstr_guid( &key.fmtid ), key.pid, value.vt );
+                        link_prop_set( This, &key, &value );
+                    }
+                    PropVariantClear( &value );
+                }
+                values += value_size;
+            }
+        }
+        p += storage;
+        size -= storage;
+    }
+}
+
 static HRESULT ShellLink_UpdatePath(LPCWSTR sPathRel, LPCWSTR path, LPCWSTR sWorkDir, LPWSTR* psPath);
 
 /**************************************************************************
