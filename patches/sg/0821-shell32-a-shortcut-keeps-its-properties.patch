+
     This->wHotKey = hdr.wHotKey;
     This->iIcoNdx = hdr.nIcon;
     FileTimeToSystemTime (&hdr.CreationTime, &This->CreationTime);
@@ -851,6 +1091,31 @@
     if( FAILED( r ) )
         goto end;
 
+#ifndef SG_MUTANT_NO_LINK_PROPERTIES
+    /* the extra data blocks, up to a terminal one: the property storage is
+     * kept (Stained Glass OS), the others are skipped */
+    for (;;)
+    {
+        DWORD size = 0, signature;
+        BYTE *block;
+
+        r = IStream_Read(stm, &size, sizeof size, &dwBytesRead);
+        if (FAILED(r) || dwBytesRead != sizeof size || size < 8 || size > 0x100000) break;
+        if (!(block = malloc(size - 4))) break;
+        r = IStream_Read(stm, block, size - 4, &dwBytesRead);
+        if (FAILED(r) || dwBytesRead != size - 4)
+        {
+            free(block);
+            break;
+        }
+        memcpy(&signature, block, sizeof signature);
+        TRACE("extra data block %08lx, %lu bytes\n", signature, size);
+        if (signature == EXP_PROPERTYSTORAGE_SIG) link_props_parse(This, block + 4, size - 8);
+        free(block);
+    }
+    r = S_OK;
+    (void)zero;
+#else
     r = IStream_Read(stm, &zero, sizeof zero, &dwBytesRead);
     if( FAILED( r ) || zero || dwBytesRead != sizeof zero )
     {
@@ -861,6 +1126,7 @@
          */
         WARN("Last word was not zero\n");
     }
+#endif
 
     TRACE("OK\n");
 
@@ -1079,6 +1345,16 @@
     if( This->sComponent )
         r = Stream_WriteAdvertiseInfo( stm, This->sComponent, EXP_DARWIN_ID_SIG );
 
+    {
+        DWORD block_size;
+        BYTE *block = link_props_block( This, &block_size );
+        if (block)
+        {
+            r = IStream_Write( stm, block, block_size, &count );
+            free( block );
+        }
+    }
+
     /* the last field is a single zero dword */
     zero = 0;
     r = IStream_Write( stm, &zero, sizeof zero, &count );
@@ -1644,6 +1920,7 @@
     free(This->sProduct);
     free(This->sComponent);
     free(This->filepath);
+    link_props_free(This);
 
     if (This->site)
         IUnknown_Release( This->site );
@@ -2646,35 +2923,58 @@
 static HRESULT WINAPI propertystore_GetCount(IPropertyStore *iface, DWORD *props)
 {
     IShellLinkImpl *This = impl_from_IPropertyStore(iface);
-    FIXME("(%p)->(%p): stub\n", This, props);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, props);
+
+    if (!props) return E_POINTER;
+    *props = This->prop_count;
+    return S_OK;
 }
 
 static HRESULT WINAPI propertystore_GetAt(IPropertyStore *iface, DWORD propid, PROPERTYKEY *key)
 {
     IShellLinkImpl *This = impl_from_IPropertyStore(iface);
-    FIXME("(%p)->(%ld %p): stub\n", This, propid, key);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%ld %p)\n", This, propid, key);
+
+    if (!key) return E_POINTER;
+    if (propid >= This->prop_count) return E_INVALIDARG;
+    *key = This->props[propid].key;
+    return S_OK;
 }
 
 static HRESULT WINAPI propertystore_GetValue(IPropertyStore *iface, REFPROPERTYKEY key, PROPVARIANT *value)
 {
     IShellLinkImpl *This = impl_from_IPropertyStore(iface);
-    FIXME("(%p)->(%p %p): stub\n", This, key, value);
-    return E_NOTIMPL;
+    struct link_property *prop;
+
+    TRACE("(%p)->(%s,%lu %p)\n", This, key ? debugstr_guid(&key->fmtid) : "(null)", key ? key->pid : 0, value);
+
+    if (!key || !value) return E_POINTER;
+    PropVariantInit(value);
+    if (!(prop = link_prop_find(This, key))) return S_OK;   /* VT_EMPTY */
+    return PropVariantCopy(value, &prop->value);
 }
 
 static HRESULT WINAPI propertystore_SetValue(IPropertyStore *iface, REFPROPERTYKEY key, REFPROPVARIANT value)
 {
     IShellLinkImpl *This = impl_from_IPropertyStore(iface);
-    FIXME("(%p)->(%p %p): stub\n", This, key, value);
-    return S_OK;
+    HRESULT hr;
+
+    TRACE("(%p)->(%s,%lu %p)\n", This, key ? debugstr_guid(&key->fmtid) : "(null)", key ? key->pid : 0, value);
+
+    if (!key || !value) return E_POINTER;
+    if (SUCCEEDED(hr = link_prop_set(This, key, value))) This->bDirty = TRUE;
+    return hr;
 }
 
 static HRESULT WINAPI propertystore_Commit(IPropertyStore *iface)
 {
     IShellLinkImpl *This = impl_from_IPropertyStore(iface);
-    FIXME("(%p): stub\n", This);
+
+    TRACE("(%p)\n", This);
+
+    /* kept when the shortcut is saved, as on Windows */
     return S_OK;
 }
 
