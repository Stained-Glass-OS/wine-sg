From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxdeploymentclient: A package has IPackage5 through IPackage9 and IPackageWithMetadata (6044)

Dropbox, past IPackageStatus2, asked its package for IPackage8 and used
the NULL it got. Package now answers every interface Windows gives it,
with what Windows returns for a package of this module:
IPackage5 (no content groups; SetInUseAsync), IPackage6 (no App
Installer file), IPackage7 (no mutable folder, the effective folder is
the installed one), IPackage8 (the external location of a package with
external content as the effective one, the machine's when SYSTEM added
it, else the user's; installed and effective paths; not a stub; app
list entries), IPackage9 (no source URI scheme) and
IPackageWithMetadata (install date). GetIids lists them. Records know
whether they are the machine's.
---
diff --git a/dlls/appxdeploymentclient/deploy.c b/dlls/appxdeploymentclient/deploy.c
index b9ba7c2..771ce13 100644
--- a/dlls/appxdeploymentclient/deploy.c
+++ b/dlls/appxdeploymentclient/deploy.c
@@ -675,6 +675,7 @@ static void for_each_record( record_func func, void *context )
             if (RegOpenKeyExW( root, full_name, 0, KEY_READ, &key )) continue;
             if (read_record( key, full_name, &rec ))
             {
+                rec.machine = (pass ? other_hive() : own_hive()) == HKEY_LOCAL_MACHINE;
                 more = func( &rec, context );
                 package_record_free( &rec );
             }
@@ -701,18 +702,20 @@ static BOOL record_in( HKEY hive, const WCHAR *full_name )
 static BOOL open_record( const WCHAR *full_name, struct package_record *rec, HKEY *out )
 {
     WCHAR path[MAX_PATH];
+    BOOL machine;
     HKEY key;
 
     if (!full_name || !full_name[0] || wcschr( full_name, '\\' ) || wcslen( full_name ) > 200) return FALSE;
     swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, full_name );
-    if (RegOpenKeyExW( own_hive(), path, 0, KEY_READ | REC_VIEW, &key ) &&
-        RegOpenKeyExW( other_hive(), path, 0, KEY_READ | REC_VIEW, &key ))
-        return FALSE;
+    if (!RegOpenKeyExW( own_hive(), path, 0, KEY_READ | REC_VIEW, &key )) machine = own_hive() == HKEY_LOCAL_MACHINE;
+    else if (!RegOpenKeyExW( other_hive(), path, 0, KEY_READ | REC_VIEW, &key )) machine = other_hive() == HKEY_LOCAL_MACHINE;
+    else return FALSE;
     if (!read_record( key, full_name, rec ))
     {
         RegCloseKey( key );
         return FALSE;
     }
+    rec->machine = machine;
     if (out) *out = key;
     else RegCloseKey( key );
     return TRUE;
