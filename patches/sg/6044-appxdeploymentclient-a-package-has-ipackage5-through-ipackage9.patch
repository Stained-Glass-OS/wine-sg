+static HRESULT WINAPI package8_GetLogoAsRandomAccessStreamReference( IPackage8 *iface, Size size,
+                                                                     IRandomAccessStreamReference **value )
+{
+    FIXME( "iface %p, value %p: stub\n", iface, value );
