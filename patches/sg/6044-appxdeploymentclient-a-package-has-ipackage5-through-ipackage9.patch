+static const WCHAR *external_of( const struct package_record *rec, int which )
+{
+    /* which: 0 effective, 1 the machine's, 2 the user's */
+    if (!rec->external_location || !rec->external_location[0]) return NULL;
+    if (which == 1 && !rec->machine) return NULL;
+    if (which == 2 && rec->machine) return NULL;
+    return rec->external_location;
+}
+
