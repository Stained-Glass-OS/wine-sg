-static HRESULT WINAPI package_GetIids( IPackage *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI package_GetIids( IPackage *iface, ULONG *count, IID **iids )
+{
+    static const IID *const list[] = { &IID_IPackage, &IID_IPackage2, &IID_IPackage3, &IID_IPackageWithMetadata,
+                                       &IID_IPackage4, &IID_IPackage5, &IID_IPackage6, &IID_IPackage7, &IID_IPackage8,
+                                       &IID_IPackage9 };
+    ULONG i;
+
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(list) / sizeof(*list) * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < ARRAY_SIZE(list); i++) (*iids)[i] = *list[i];
+    *count = ARRAY_SIZE(list);
+    return S_OK;
+}
 static HRESULT WINAPI package_GetRuntimeClassName( IPackage *iface, HSTRING *name )
 {
     return dup_hstring( L"Windows.ApplicationModel.Package", name );
@@ -618,6 +651,297 @@ static const struct IPackage4Vtbl package4_vtbl =
     package4_VerifyContentIntegrityAsync,
 };
 
+/* ---- Stained Glass OS: IPackage5-9, IPackageWithMetadata -------------------------------------
+ *
+ * What Windows gives for a package of this module: no content groups (a package here has none
+ * staged apart), no App Installer file, no mutable folder; the effective folder is the installed
+ * one; a package with external content has its external folder as the effective external location,
+ * the machine's (added by SYSTEM, recorded in HKLM) or the user's. */
+
+static HRESULT path_hstring( const WCHAR *path, HSTRING *value )
+{
+    if (!value) return E_POINTER;
+    return dup_hstring( path ? path : L"", value );
+}
+
+static HRESULT folder_or_null( const WCHAR *path, IStorageFolder **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!path || !path[0]) return S_OK;
+    return folder_create( path, value );
+}
+
