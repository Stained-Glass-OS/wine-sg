+
+static HRESULT WINAPI package5_GetContentGroupsAsync( IPackage5 *iface, IInspectable **operation )
+{
+    FIXME( "iface %p, operation %p: content groups are not supported\n", iface, operation );
+    if (operation) *operation = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI package5_GetContentGroupAsync( IPackage5 *iface, HSTRING name, IInspectable **operation )
+{
+    FIXME( "iface %p, name %s: content groups are not supported\n", iface, debugstr_hstring( name ) );
+    if (operation) *operation = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI package5_StageContentGroupsAsync( IPackage5 *iface, IIterable_HSTRING *names, IInspectable **operation )
+{
+    FIXME( "iface %p: content groups are not supported\n", iface );
+    if (operation) *operation = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI package5_StageContentGroupsWithPriorityAsync( IPackage5 *iface, IIterable_HSTRING *names, boolean head,
+                                                                     IInspectable **operation )
+{
+    FIXME( "iface %p: content groups are not supported\n", iface );
+    if (operation) *operation = NULL;
+    return E_NOTIMPL;
+}
+
+/* whether the package is in use is not tracked: the operation's result is the value asked for */
+static HRESULT WINAPI package5_SetInUseAsync( IPackage5 *iface, boolean in_use, IAsyncOperation_boolean **operation )
+{
+    TRACE( "iface %p, in_use %d, operation %p\n", iface, in_use, operation );
+    if (!operation) return E_POINTER;
+    return bool_operation_create( in_use, operation );
+}
+
