+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI package8_GetAppListEntries( IPackage8 *iface, IVectorView_AppListEntry **value )
+{
+    IAsyncOperation_IVectorView_AppListEntry *operation;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    /* the entries are read at once: the operation is complete */
+    if (FAILED(hr = app_list_entries_create( impl_from_IPackage8( iface )->rec.install_location, &operation ))) return hr;
+    hr = IAsyncOperation_IVectorView_AppListEntry_GetResults( operation, value );
+    IAsyncOperation_IVectorView_AppListEntry_Release( operation );
+    return hr;
+}
+
+static HRESULT WINAPI package8_get_IsStub( IPackage8 *iface, boolean *value )
