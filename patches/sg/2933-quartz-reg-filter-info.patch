From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] quartz: add IRegFilterInfo and the registered filter collection

IRegFilterInfo exposes a registered filter's name and, through Filter(),
instantiates it, adds it to the graph under its registered name and returns
its IFilterInfo. filterinfo_create_reg_collection() enumerates all registered
filters through IFilterMapper (no merit floor, no pin type requirement).
---
diff --git a/dlls/quartz/filterinfo.c b/dlls/quartz/filterinfo.c
index 916866d..371ada6 100644
--- a/dlls/quartz/filterinfo.c
+++ b/dlls/quartz/filterinfo.c
@@ -1179,3 +1179,169 @@ HRESULT filterinfo_create_filter_collection(IFilterGraph2 *graph, IDispatch **ou
         free_items(items, count);
     return hr;
 }
+
+/* ---------------------------------------------------------------- IRegFilterInfo */
+
+struct reg_filter_info
+{
+    IRegFilterInfo IRegFilterInfo_iface;
+    LONG ref;
+    IFilterGraph2 *graph;
+    CLSID clsid;
+    WCHAR *name;
+};
+
+static struct reg_filter_info *impl_from_IRegFilterInfo(IRegFilterInfo *iface)
+{
+    return CONTAINING_RECORD(iface, struct reg_filter_info, IRegFilterInfo_iface);
+}
+
+static HRESULT WINAPI reg_info_QueryInterface(IRegFilterInfo *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDispatch)
+            || IsEqualGUID(iid, &IID_IRegFilterInfo))
+    {
+        IRegFilterInfo_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI reg_info_AddRef(IRegFilterInfo *iface)
+{
+    return InterlockedIncrement(&impl_from_IRegFilterInfo(iface)->ref);
+}
+
+static ULONG WINAPI reg_info_Release(IRegFilterInfo *iface)
+{
+    struct reg_filter_info *info = impl_from_IRegFilterInfo(iface);
+    ULONG ref = InterlockedDecrement(&info->ref);
+
+    if (!ref)
+    {
+        IFilterGraph2_Release(info->graph);
+        free(info->name);
+        free(info);
+    }
+    return ref;
+}
+
+DEFINE_INFO_DISPATCH(reg_info, IRegFilterInfo, IID_IRegFilterInfo)
+
+static HRESULT WINAPI reg_info_get_Name(IRegFilterInfo *iface, BSTR *name)
+{
+    struct reg_filter_info *info = impl_from_IRegFilterInfo(iface);
+
+    TRACE("iface %p, name %p.\n", iface, name);
+
+    if (!name)
+        return E_POINTER;
+    return (*name = SysAllocString(info->name)) ? S_OK : E_OUTOFMEMORY;
+}
+
+/* Documented behaviour: instantiates the registered filter, adds it to the
+ * graph under its registered name and returns its IFilterInfo. */
+static HRESULT WINAPI reg_info_Filter(IRegFilterInfo *iface, IDispatch **out)
+{
+    struct reg_filter_info *info = impl_from_IRegFilterInfo(iface);
+    IBaseFilter *filter;
+    HRESULT hr;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = CoCreateInstance(&info->clsid, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IBaseFilter, (void **)&filter)))
+        return hr;
+#ifdef SG_MUTANT_REG_ADD
+    if (SUCCEEDED(hr = S_OK))
+#else
+    if (SUCCEEDED(hr = IFilterGraph2_AddFilter(info->graph, filter, info->name)))
+#endif
+    {
+        if (FAILED(hr = filterinfo_create(filter, out)))
+            IFilterGraph2_RemoveFilter(info->graph, filter);
+    }
+    IBaseFilter_Release(filter);
+    return hr;
+}
+
+static const IRegFilterInfoVtbl reg_info_vtbl =
+{
+    reg_info_QueryInterface,
+    reg_info_AddRef,
+    reg_info_Release,
+    reg_info_GetTypeInfoCount,
+    reg_info_GetTypeInfo,
+    reg_info_GetIDsOfNames,
+    reg_info_Invoke,
+    reg_info_get_Name,
+    reg_info_Filter,
+};
+
+static HRESULT create_reg_filter_info(IFilterGraph2 *graph, const REGFILTER *reg, IDispatch **out)
+{
+    struct reg_filter_info *info;
+
+    if (!(info = calloc(1, sizeof(*info))))
+        return E_OUTOFMEMORY;
+    if (!(info->name = wcsdup(reg->Name ? reg->Name : L"")))
+    {
+        free(info);
+        return E_OUTOFMEMORY;
+    }
+    info->IRegFilterInfo_iface.lpVtbl = &reg_info_vtbl;
+    info->ref = 1;
+    IFilterGraph2_AddRef(info->graph = graph);
+    info->clsid = reg->Clsid;
+    *out = (IDispatch *)&info->IRegFilterInfo_iface;
+    return S_OK;
+}
+
+HRESULT filterinfo_create_reg_collection(IFilterGraph2 *graph, IFilterMapper *mapper, IDispatch **out)
+{
+    IUnknown **items = NULL;
+    IEnumRegFilters *enum_reg;
+    REGFILTER *reg;
+    LONG count = 0, capacity = 0;
+    HRESULT hr;
+
+    /* All registered filters: no merit floor, no pin type requirements. */
+    if (FAILED(hr = IFilterMapper_EnumMatchingFilters(mapper, &enum_reg, 0, FALSE,
+            GUID_NULL, GUID_NULL, FALSE, FALSE, GUID_NULL, GUID_NULL)))
+        return hr;
+
+    while (IEnumRegFilters_Next(enum_reg, 1, &reg, NULL) == S_OK)
+    {
+        IDispatch *disp;
+
+        hr = create_reg_filter_info(graph, reg, &disp);
+        CoTaskMemFree(reg); /* the name is part of the same allocation */
+        if (FAILED(hr))
+            break;
+        if (count == capacity)
+        {
+            IUnknown **new_items = realloc(items, (capacity ? capacity * 2 : 4) * sizeof(*items));
+            if (!new_items)
+            {
+                IDispatch_Release(disp);
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+            items = new_items;
+            capacity = capacity ? capacity * 2 : 4;
+        }
+        items[count++] = (IUnknown *)disp;
+    }
+    IEnumRegFilters_Release(enum_reg);
+
+    if (SUCCEEDED(hr))
+        hr = create_collection(items, count, out);
+    if (FAILED(hr))
+        free_items(items, count);
+    return hr;
+}
diff --git a/dlls/quartz/quartz_private.h b/dlls/quartz/quartz_private.h
index 6bdc55c..d131c67 100644
--- a/dlls/quartz/quartz_private.h
+++ b/dlls/quartz/quartz_private.h
@@ -51,6 +51,7 @@
 
 HRESULT filterinfo_create(IBaseFilter *filter, IDispatch **out);
 HRESULT filterinfo_create_filter_collection(IFilterGraph2 *graph, IDispatch **out);
+HRESULT filterinfo_create_reg_collection(IFilterGraph2 *graph, IFilterMapper *mapper, IDispatch **out);
 void filterinfo_release_typelib(void);
 
 bool array_reserve(void **elements, size_t *capacity, size_t count, size_t size);
