+        m._32 += baseline_origin.x * m._12 + baseline_origin.y * m._22;
+        hr = ID2D1PathGeometry_GetBounds(geometry, &m, bounds);
+    }
+    ID2D1PathGeometry_Release(geometry);
+    return hr;
