+/* ---- ID2D1LookupTable3D --------------------------------------------------- */
+
+struct d2d_lookup_table
+{
+    struct d2d_obj obj;
+    D2D1_BUFFER_PRECISION precision;
+    UINT32 extents[3];
+    BYTE *data;
+    size_t size;
+};
+
+static const GUID *const d2d_lookup_table_iids[] = {&IID_ID2D1LookupTable3D, NULL};
+
+D2D_OBJ_BASE_METHODS(d2d_lookup_table, ID2D1LookupTable3D)
+
+static void d2d_lookup_table_destroy(struct d2d_obj *obj)
+{
+    free(((struct d2d_lookup_table *)obj)->data);
+}
+
+static const ID2D1LookupTable3DVtbl d2d_lookup_table_vtbl =
+{
+    d2d_lookup_table_QueryInterface,
+    d2d_lookup_table_AddRef,
+    d2d_lookup_table_Release,
+    d2d_lookup_table_GetFactory,
+};
+
+/* Entries are four channels (BGRA); strides are the byte distances from one
+ * entry row to the next along the second and third dimension. */
+HRESULT d2d_lookup_table_create(ID2D1Factory *factory, D2D1_BUFFER_PRECISION precision, const UINT32 *extents,
+        const BYTE *data, UINT32 data_count, const UINT32 *strides, ID2D1LookupTable3D **out)
+{
+    struct d2d_lookup_table *table;
+    unsigned int bpp, x, y, z;
+
+    switch (precision)
+    {
+        case D2D1_BUFFER_PRECISION_8BPC_UNORM:
+        case D2D1_BUFFER_PRECISION_8BPC_UNORM_SRGB: bpp = 4; break;
+        case D2D1_BUFFER_PRECISION_16BPC_UNORM:
+        case D2D1_BUFFER_PRECISION_16BPC_FLOAT: bpp = 8; break;
+        case D2D1_BUFFER_PRECISION_32BPC_FLOAT: bpp = 16; break;
+        default: return E_INVALIDARG;
+    }
+    if (!extents || !data || !strides || !extents[0] || !extents[1] || !extents[2]
+            || strides[0] < extents[0] * bpp || strides[1] < strides[0] * extents[1])
+        return E_INVALIDARG;
+    if ((UINT64)strides[1] * extents[2] > data_count)
+        return E_INVALIDARG;
+    if (!(table = d2d_obj_alloc(sizeof(*table))))
+        return E_OUTOFMEMORY;
+    d2d_obj_init(&table->obj, &d2d_lookup_table_vtbl, factory, d2d_lookup_table_iids, d2d_lookup_table_destroy);
+    table->precision = precision;
+    memcpy(table->extents, extents, sizeof(table->extents));
+    table->size = (size_t)extents[0] * extents[1] * extents[2] * bpp;
+    if (!(table->data = malloc(table->size)))
+    {
+        ID2D1Factory_Release(factory);
+        free(table);
+        return E_OUTOFMEMORY;
+    }
+    for (z = 0; z < extents[2]; ++z)
+        for (y = 0; y < extents[1]; ++y)
+            for (x = 0; x < 1; ++x)
+                memcpy(&table->data[((size_t)z * extents[1] + y) * extents[0] * bpp],
+                        &data[(size_t)z * strides[1] + (size_t)y * strides[0]], (size_t)extents[0] * bpp);
+    *out = (ID2D1LookupTable3D *)table;
+    return S_OK;
+}
