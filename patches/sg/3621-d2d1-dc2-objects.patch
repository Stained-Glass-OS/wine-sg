+HRESULT d2d_image_source_create_from_wic(ID2D1DeviceContext6 *context, ID2D1Factory *factory,
+        IWICBitmapSource *wic, D2D1_IMAGE_SOURCE_LOADING_OPTIONS options, D2D1_ALPHA_MODE alpha_mode,
+        ID2D1ImageSourceFromWic **out)
+{
+    D2D1_BITMAP_PROPERTIES desc = {{DXGI_FORMAT_UNKNOWN, alpha_mode}, 0.0f, 0.0f};
+    struct d2d_image_source *source;
+    HRESULT hr;
+
+    if (!wic || (options & ~(D2D1_IMAGE_SOURCE_LOADING_OPTIONS_RELEASE_SOURCE
+            | D2D1_IMAGE_SOURCE_LOADING_OPTIONS_CACHE_ON_DEMAND)) || alpha_mode > D2D1_ALPHA_MODE_IGNORE)
+        return E_INVALIDARG;
+    if (!(source = d2d_obj_alloc(sizeof(*source))))
+        return E_OUTOFMEMORY;
+    d2d_obj_init(&source->obj, &d2d_image_source_wic_vtbl, factory, d2d_image_source_wic_iids,
+            d2d_image_source_destroy);
+    if (FAILED(hr = ID2D1RenderTarget_CreateBitmapFromWicBitmap((ID2D1RenderTarget *)context, wic,
+            alpha_mode ? &desc : NULL, &source->bitmap)))
+    {
+        ID2D1ImageSourceFromWic_Release((ID2D1ImageSourceFromWic *)source);
+        return hr;
+    }
+    if (!(options & D2D1_IMAGE_SOURCE_LOADING_OPTIONS_RELEASE_SOURCE))
+        IWICBitmapSource_AddRef(source->wic = wic);
+    *out = (ID2D1ImageSourceFromWic *)source;
+    return S_OK;
