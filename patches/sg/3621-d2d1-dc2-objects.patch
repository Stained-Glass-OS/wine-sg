+/* The resources of ID2D1DeviceContext2: ink and its style, gradient meshes,
+ * image sources, transformed image sources, 3D lookup tables, sprite
+ * batches and SVG glyph styles.  All of them are plain resources that keep
+ * their data; drawing goes through the public drawing calls of the context. */
+
+struct d2d_obj
+{
+    const void *vtbl;                   /* first, so the object is its own interface pointer */
+    LONG refcount;
+    ID2D1Factory *factory;
+    const GUID *const *iids;            /* NULL terminated */
+    void (*destroy)(struct d2d_obj *obj);
+};
+
+static HRESULT d2d_obj_query_interface(struct d2d_obj *obj, REFIID iid, void **out)
+{
+    const GUID *const *p;
+
+    TRACE("obj %p, iid %s, out %p.\n", obj, debugstr_guid(iid), out);
+
+    for (p = obj->iids; *p; ++p)
+    {
+        if (IsEqualGUID(iid, *p))
+        {
+            InterlockedIncrement(&obj->refcount);
+            *out = obj;
+            return S_OK;
+        }
+    }
+    if (IsEqualGUID(iid, &IID_ID2D1Resource) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        InterlockedIncrement(&obj->refcount);
+        *out = obj;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG d2d_obj_addref(struct d2d_obj *obj)
+{
+    ULONG refcount = InterlockedIncrement(&obj->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", obj, refcount);
+    return refcount;
+}
+
+static ULONG d2d_obj_release(struct d2d_obj *obj)
+{
+    ULONG refcount = InterlockedDecrement(&obj->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", obj, refcount);
+
+    if (!refcount)
+    {
+        obj->destroy(obj);
+        ID2D1Factory_Release(obj->factory);
+        free(obj);
+    }
+    return refcount;
+}
+
+static void d2d_obj_get_factory(struct d2d_obj *obj, ID2D1Factory **factory)
+{
+    ID2D1Factory_AddRef(*factory = obj->factory);
+}
+
+static void d2d_obj_init(struct d2d_obj *obj, const void *vtbl, ID2D1Factory *factory,
+        const GUID *const *iids, void (*destroy)(struct d2d_obj *))
+{
+    obj->vtbl = vtbl;
+    obj->refcount = 1;
+    ID2D1Factory_AddRef(obj->factory = factory);
+    obj->iids = iids;
+    obj->destroy = destroy;
+}
+
+#define D2D_OBJ_BASE_METHODS(name, type) \
+    static HRESULT STDMETHODCALLTYPE name##_QueryInterface(type *iface, REFIID iid, void **out) \
+    { return d2d_obj_query_interface((struct d2d_obj *)iface, iid, out); } \
+    static ULONG STDMETHODCALLTYPE name##_AddRef(type *iface) \
+    { return d2d_obj_addref((struct d2d_obj *)iface); } \
+    static ULONG STDMETHODCALLTYPE name##_Release(type *iface) \
+    { return d2d_obj_release((struct d2d_obj *)iface); } \
+    static void STDMETHODCALLTYPE name##_GetFactory(type *iface, ID2D1Factory **factory) \
+    { d2d_obj_get_factory((struct d2d_obj *)iface, factory); }
+
+static void d2d_obj_destroy_nothing(struct d2d_obj *obj)
+{
+}
