+static void d2d_fill_stream(ID2D1DeviceContext6 *context, ID2D1Brush *brush, ID2D1PathGeometry *geometry)
+{
+    ID2D1DeviceContext6_FillGeometry(context, (ID2D1Geometry *)geometry, brush, NULL);
+}
+
+void d2d_draw_ink(ID2D1DeviceContext6 *context, ID2D1Ink *ink, ID2D1Brush *brush, ID2D1InkStyle *style)
+{
+    ID2D1PathGeometry *geometry;
+    ID2D1GeometrySink *sink;
+    ID2D1Factory *factory;
+
+    if (!ink || !brush)
+        return;
+    ID2D1DeviceContext6_GetFactory(context, &factory);
+    if (SUCCEEDED(ID2D1Factory_CreatePathGeometry(factory, &geometry)))
+    {
+        if (SUCCEEDED(ID2D1PathGeometry_Open(geometry, &sink)))
+        {
+            HRESULT hr = ID2D1Ink_StreamAsGeometry(ink, style, NULL, 0.25f, (ID2D1SimplifiedGeometrySink *)sink);
+            ID2D1GeometrySink_Close(sink);
+            ID2D1GeometrySink_Release(sink);
+            if (SUCCEEDED(hr))
+                d2d_fill_stream(context, brush, geometry);
+        }
+        ID2D1PathGeometry_Release(geometry);
+    }
+    ID2D1Factory_Release(factory);
+}
