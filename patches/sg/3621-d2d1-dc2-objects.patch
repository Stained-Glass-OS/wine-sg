+/* ---- ID2D1SvgGlyphStyle --------------------------------------------------- */
+
+struct d2d_svg_glyph_style
+{
+    struct d2d_obj obj;
+    ID2D1Brush *fill, *stroke;
+    float stroke_width, dash_offset;
+    float *dashes;
+    UINT32 dash_count;
+};
+
+static const GUID *const d2d_svg_glyph_style_iids[] = {&IID_ID2D1SvgGlyphStyle, NULL};
+
+D2D_OBJ_BASE_METHODS(d2d_svg_glyph_style, ID2D1SvgGlyphStyle)
+
+static void d2d_svg_glyph_style_destroy(struct d2d_obj *obj)
+{
+    struct d2d_svg_glyph_style *style = (struct d2d_svg_glyph_style *)obj;
+
+    if (style->fill)
+        ID2D1Brush_Release(style->fill);
+    if (style->stroke)
+        ID2D1Brush_Release(style->stroke);
+    free(style->dashes);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_glyph_style_SetFill(ID2D1SvgGlyphStyle *iface, ID2D1Brush *brush)
+{
+    struct d2d_svg_glyph_style *style = (struct d2d_svg_glyph_style *)iface;
+
+    TRACE("iface %p, brush %p.\n", iface, brush);
+
+    if (brush)
+        ID2D1Brush_AddRef(brush);
+    if (style->fill)
+        ID2D1Brush_Release(style->fill);
+    style->fill = brush;
+    return S_OK;
+}
+
+static void STDMETHODCALLTYPE d2d_svg_glyph_style_GetFill(ID2D1SvgGlyphStyle *iface, ID2D1Brush **brush)
+{
+    struct d2d_svg_glyph_style *style = (struct d2d_svg_glyph_style *)iface;
+
+    TRACE("iface %p, brush %p.\n", iface, brush);
+
+    if ((*brush = style->fill))
+        ID2D1Brush_AddRef(*brush);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_glyph_style_SetStroke(ID2D1SvgGlyphStyle *iface, ID2D1Brush *brush,
+        float width, const float *dashes, UINT32 dash_count, float offset)
+{
+    struct d2d_svg_glyph_style *style = (struct d2d_svg_glyph_style *)iface;
+    float *copy = NULL;
+
+    TRACE("iface %p, brush %p, width %.8e, dashes %p, dash_count %u, offset %.8e.\n",
+            iface, brush, width, dashes, dash_count, offset);
+
+    if (dash_count && !dashes)
+        return E_INVALIDARG;
+    if (dash_count && !(copy = malloc(dash_count * sizeof(*copy))))
+        return E_OUTOFMEMORY;
+    if (dash_count)
+        memcpy(copy, dashes, dash_count * sizeof(*copy));
+
+    if (brush)
+        ID2D1Brush_AddRef(brush);
+    if (style->stroke)
+        ID2D1Brush_Release(style->stroke);
+    style->stroke = brush;
+    style->stroke_width = width;
+    free(style->dashes);
+    style->dashes = copy;
+    style->dash_count = dash_count;
+    style->dash_offset = offset;
+    return S_OK;
+}
+
+static UINT32 STDMETHODCALLTYPE d2d_svg_glyph_style_GetStrokeDashesCount(ID2D1SvgGlyphStyle *iface)
+{
+    struct d2d_svg_glyph_style *style = (struct d2d_svg_glyph_style *)iface;
+
+    TRACE("iface %p.\n", iface);
+    return style->dash_count;
+}
+
+static void STDMETHODCALLTYPE d2d_svg_glyph_style_GetStroke(ID2D1SvgGlyphStyle *iface, ID2D1Brush **brush,
+        float *width, float *dashes, UINT32 dash_count, float *offset)
+{
+    struct d2d_svg_glyph_style *style = (struct d2d_svg_glyph_style *)iface;
+
+    TRACE("iface %p, brush %p, width %p, dashes %p, dash_count %u, offset %p.\n",
+            iface, brush, width, dashes, dash_count, offset);
+
+    if (brush && (*brush = style->stroke))
+        ID2D1Brush_AddRef(*brush);
+    if (width)
+        *width = style->stroke_width;
+    if (dashes && dash_count)
+        memcpy(dashes, style->dashes, min(dash_count, style->dash_count) * sizeof(*dashes));
+    if (offset)
+        *offset = style->dash_offset;
+}
+
+static const ID2D1SvgGlyphStyleVtbl d2d_svg_glyph_style_vtbl =
+{
+    d2d_svg_glyph_style_QueryInterface,
+    d2d_svg_glyph_style_AddRef,
+    d2d_svg_glyph_style_Release,
+    d2d_svg_glyph_style_GetFactory,
+    d2d_svg_glyph_style_SetFill,
+    d2d_svg_glyph_style_GetFill,
+    d2d_svg_glyph_style_SetStroke,
+    d2d_svg_glyph_style_GetStrokeDashesCount,
+    d2d_svg_glyph_style_GetStroke,
+};
+
+HRESULT d2d_svg_glyph_style_create(ID2D1Factory *factory, ID2D1SvgGlyphStyle **out)
+{
+    struct d2d_svg_glyph_style *style;
+
+    if (!(style = d2d_obj_alloc(sizeof(*style))))
+        return E_OUTOFMEMORY;
+    d2d_obj_init(&style->obj, &d2d_svg_glyph_style_vtbl, factory, d2d_svg_glyph_style_iids,
+            d2d_svg_glyph_style_destroy);
+    style->stroke_width = 1.0f;
+    *out = (ID2D1SvgGlyphStyle *)style;
+    return S_OK;
+}
+
+/* ---- ID2D1GdiMetafile ----------------------------------------------------- */
+
+struct d2d_gdi_metafile
+{
+    struct d2d_obj obj;
+    BYTE *data;
+    UINT32 size;
+    D2D1_RECT_F bounds;
+};
+
+static const GUID *const d2d_gdi_metafile_iids[] = {&IID_ID2D1GdiMetafile, NULL};
+
+D2D_OBJ_BASE_METHODS(d2d_gdi_metafile, ID2D1GdiMetafile)
+
+static void d2d_gdi_metafile_destroy(struct d2d_obj *obj)
+{
+    free(((struct d2d_gdi_metafile *)obj)->data);
+}
+
+/* Each record is passed to the sink without its type and size fields. */
+static HRESULT STDMETHODCALLTYPE d2d_gdi_metafile_Stream(ID2D1GdiMetafile *iface, ID2D1GdiMetafileSink *sink)
+{
+    struct d2d_gdi_metafile *mf = (struct d2d_gdi_metafile *)iface;
+    UINT32 pos = 0;
+    HRESULT hr;
+
+    TRACE("iface %p, sink %p.\n", iface, sink);
+
+    if (!sink)
+        return E_INVALIDARG;
+    while (pos + 8 <= mf->size)
+    {
+        const DWORD *rec = (const DWORD *)(mf->data + pos);
+        DWORD type = rec[0], size = rec[1];
+
+        if (size < 8 || size % 4 || size > mf->size - pos)
+            return D2DERR_UNSUPPORTED_OPERATION;
+        if (FAILED(hr = ID2D1GdiMetafileSink_ProcessRecord(sink, type, size > 8 ? rec + 2 : NULL, size - 8)))
+            return hr;
+        pos += size;
+        if (type == EMR_EOF)
+            break;
+    }
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_gdi_metafile_GetBounds(ID2D1GdiMetafile *iface, D2D1_RECT_F *bounds)
+{
+    struct d2d_gdi_metafile *mf = (struct d2d_gdi_metafile *)iface;
+
+    TRACE("iface %p, bounds %p.\n", iface, bounds);
+
+    *bounds = mf->bounds;
+    return S_OK;
+}
+
+static const ID2D1GdiMetafileVtbl d2d_gdi_metafile_vtbl =
+{
+    d2d_gdi_metafile_QueryInterface,
+    d2d_gdi_metafile_AddRef,
+    d2d_gdi_metafile_Release,
+    d2d_gdi_metafile_GetFactory,
+    d2d_gdi_metafile_Stream,
+    d2d_gdi_metafile_GetBounds,
+};
+
+HRESULT d2d_gdi_metafile_create(ID2D1Factory *factory, IStream *stream, ID2D1GdiMetafile **out)
+{
+    struct d2d_gdi_metafile *mf;
+    const ENHMETAHEADER *header;
+    STATSTG stat;
+    ULONG read;
+    HRESULT hr;
+
+    if (!stream)
+        return E_INVALIDARG;
+    if (FAILED(hr = IStream_Stat(stream, &stat, STATFLAG_NONAME)))
+        return hr;
+    if (stat.cbSize.QuadPart < sizeof(ENHMETAHEADER) || stat.cbSize.QuadPart > 0x10000000)
+        return D2DERR_UNSUPPORTED_OPERATION;
+    if (!(mf = d2d_obj_alloc(sizeof(*mf))))
+        return E_OUTOFMEMORY;
+    d2d_obj_init(&mf->obj, &d2d_gdi_metafile_vtbl, factory, d2d_gdi_metafile_iids, d2d_gdi_metafile_destroy);
+    mf->size = stat.cbSize.QuadPart;
+    if (!(mf->data = malloc(mf->size)))
+    {
+        ID2D1GdiMetafile_Release((ID2D1GdiMetafile *)mf);
+        return E_OUTOFMEMORY;
+    }
+    if (FAILED(hr = IStream_Read(stream, mf->data, mf->size, &read)) || read != mf->size)
+    {
+        ID2D1GdiMetafile_Release((ID2D1GdiMetafile *)mf);
+        return FAILED(hr) ? hr : D2DERR_UNSUPPORTED_OPERATION;
+    }
+    header = (const ENHMETAHEADER *)mf->data;
+    if (header->iType != EMR_HEADER || header->dSignature != ENHMETA_SIGNATURE)
+    {
+        ID2D1GdiMetafile_Release((ID2D1GdiMetafile *)mf);
+        return D2DERR_UNSUPPORTED_OPERATION;
+    }
+    /* the frame is in hundredths of a millimeter */
+    mf->bounds.left = header->rclFrame.left * 96.0f / 2540.0f;
+    mf->bounds.top = header->rclFrame.top * 96.0f / 2540.0f;
+    mf->bounds.right = header->rclFrame.right * 96.0f / 2540.0f;
+    mf->bounds.bottom = header->rclFrame.bottom * 96.0f / 2540.0f;
+    *out = (ID2D1GdiMetafile *)mf;
+    return S_OK;
+}
+
+/* Plays the metafile on the device context's GDI surface. */
+void d2d_draw_gdi_metafile(ID2D1DeviceContext6 *context, ID2D1GdiMetafile *iface, const D2D1_POINT_2F *offset,
+        const D2D1_RECT_F *dst_rect, const D2D1_RECT_F *src_rect)
+{
+    struct d2d_gdi_metafile *mf = (struct d2d_gdi_metafile *)iface;
+    ID2D1GdiInteropRenderTarget *gdi;
+    D2D1_MATRIX_3X2_F m;
+    float dpi_x, dpi_y;
+    XFORM xf;
+    HENHMETAFILE emf;
+    RECT rect;
+    HDC hdc;
+    int old_mode;
+
+    if (!mf || FAILED(ID2D1DeviceContext6_QueryInterface(context, &IID_ID2D1GdiInteropRenderTarget, (void **)&gdi)))
+        return;
+    if (SUCCEEDED(ID2D1GdiInteropRenderTarget_GetDC(gdi, D2D1_DC_INITIALIZE_MODE_COPY, &hdc)))
+    {
+        ID2D1DeviceContext6_GetTransform(context, &m);
+        ID2D1DeviceContext6_GetDpi(context, &dpi_x, &dpi_y);
+        xf.eM11 = m._11 * dpi_x / 96.0f; xf.eM12 = m._12 * dpi_y / 96.0f;
+        xf.eM21 = m._21 * dpi_x / 96.0f; xf.eM22 = m._22 * dpi_y / 96.0f;
+        xf.eDx = m._31 * dpi_x / 96.0f; xf.eDy = m._32 * dpi_y / 96.0f;
+        if (dst_rect)
+        {
+            rect.left = lroundf(dst_rect->left); rect.top = lroundf(dst_rect->top);
+            rect.right = lroundf(dst_rect->right); rect.bottom = lroundf(dst_rect->bottom);
+        }
+        else
+        {
+            float x = offset ? offset->x : 0.0f, y = offset ? offset->y : 0.0f;
+            rect.left = lroundf(x); rect.top = lroundf(y);
+            rect.right = lroundf(x + mf->bounds.right - mf->bounds.left);
+            rect.bottom = lroundf(y + mf->bounds.bottom - mf->bounds.top);
+        }
+        if ((emf = SetEnhMetaFileBits(mf->size, mf->data)))
+        {
+            old_mode = SetGraphicsMode(hdc, GM_ADVANCED);
+            SetWorldTransform(hdc, &xf);
+            PlayEnhMetaFile(hdc, emf, &rect);
+            ModifyWorldTransform(hdc, NULL, MWT_IDENTITY);
+            SetGraphicsMode(hdc, old_mode);
+            DeleteEnhMetaFile(emf);
+        }
+        ID2D1GdiInteropRenderTarget_ReleaseDC(gdi, NULL);
+    }
+    ID2D1GdiInteropRenderTarget_Release(gdi);
+}
+
+/* ---- ID2D1ResourceTexture ------------------------------------------------- */
+
+struct d2d_resource_texture
+{
+    ID2D1ResourceTexture ID2D1ResourceTexture_iface;
+    LONG refcount;
+    UINT32 dimensions;
+    UINT32 extents[3];
+    UINT32 elem_size;                   /* bytes of one texel */
+    BYTE *data;
+};
+
+static inline struct d2d_resource_texture *impl_from_ID2D1ResourceTexture(ID2D1ResourceTexture *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_resource_texture, ID2D1ResourceTexture_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_resource_texture_QueryInterface(ID2D1ResourceTexture *iface,
+        REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_ID2D1ResourceTexture) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        ID2D1ResourceTexture_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_resource_texture_AddRef(ID2D1ResourceTexture *iface)
+{
+    struct d2d_resource_texture *texture = impl_from_ID2D1ResourceTexture(iface);
+
+    return InterlockedIncrement(&texture->refcount);
+}
+
+static ULONG STDMETHODCALLTYPE d2d_resource_texture_Release(ID2D1ResourceTexture *iface)
+{
+    struct d2d_resource_texture *texture = impl_from_ID2D1ResourceTexture(iface);
+    ULONG refcount = InterlockedDecrement(&texture->refcount);
+
+    if (!refcount)
+    {
+        free(texture->data);
+        free(texture);
+    }
+    return refcount;
+}
+
+/* Copies a sub-box of the caller's data (laid out with the strides given) into the texture. */
+static HRESULT d2d_resource_texture_copy(struct d2d_resource_texture *texture, const UINT32 *min,
+        const UINT32 *max, const UINT32 *strides, const BYTE *data, UINT32 data_size)
+{
+    UINT32 lo[3] = {0, 0, 0}, hi[3] = {texture->extents[0], 1, 1}, x_count, y, z;
+    UINT32 row = texture->extents[0] * texture->elem_size, slice = row * (texture->dimensions > 1 ? texture->extents[1] : 1);
+    UINT32 src_row, src_slice;
+    UINT64 needed;
+    unsigned int i;
+
+    for (i = 0; i < texture->dimensions; ++i)
+    {
+        lo[i] = min ? min[i] : 0;
+        hi[i] = max ? max[i] : texture->extents[i];
+        if (lo[i] >= hi[i] || hi[i] > texture->extents[i])
+            return E_INVALIDARG;
+    }
+    x_count = (hi[0] - lo[0]) * texture->elem_size;
+    src_row = texture->dimensions > 1 ? strides[0] : x_count;
+    src_slice = texture->dimensions > 2 ? strides[1] : src_row * (hi[1] - lo[1]);
+    if (texture->dimensions > 1 && src_row < x_count)
+        return E_INVALIDARG;
+    if (texture->dimensions > 2 && src_slice < src_row * (hi[1] - lo[1]))
+        return E_INVALIDARG;
+    needed = (UINT64)(hi[2] - lo[2] - 1) * src_slice + (UINT64)(hi[1] - lo[1] - 1) * src_row + x_count;
+    if (data_size < needed)
+        return E_INVALIDARG;
+    for (z = lo[2]; z < hi[2]; ++z)
+        for (y = lo[1]; y < hi[1]; ++y)
+            memcpy(texture->data + (size_t)z * slice + (size_t)y * row + (size_t)lo[0] * texture->elem_size,
+                    data + (size_t)(z - lo[2]) * src_slice + (size_t)(y - lo[1]) * src_row, x_count);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_resource_texture_Update(ID2D1ResourceTexture *iface, const UINT32 *min_extents,
+        const UINT32 *max_extents, const UINT32 *strides, UINT32 dimensions, const BYTE *data, UINT32 data_size)
+{
+    struct d2d_resource_texture *texture = impl_from_ID2D1ResourceTexture(iface);
+
+    TRACE("iface %p, min_extents %p, max_extents %p, strides %p, dimensions %u, data %p, data_size %u.\n",
+            iface, min_extents, max_extents, strides, dimensions, data, data_size);
+
+    if (dimensions != texture->dimensions || !data || !min_extents || !max_extents
+            || (dimensions > 1 && !strides))
+        return E_INVALIDARG;
+    return d2d_resource_texture_copy(texture, min_extents, max_extents, strides, data, data_size);
+}
+
+static const ID2D1ResourceTextureVtbl d2d_resource_texture_vtbl =
+{
+    d2d_resource_texture_QueryInterface,
+    d2d_resource_texture_AddRef,
+    d2d_resource_texture_Release,
+    d2d_resource_texture_Update,
+};
+
+HRESULT d2d_resource_texture_create(const D2D1_RESOURCE_TEXTURE_PROPERTIES *props, const BYTE *data,
+        const UINT32 *strides, UINT32 data_size, ID2D1ResourceTexture **out)
+{
+    struct d2d_resource_texture *texture;
+    unsigned int i, channels, depth;
+    UINT64 size = 1;
+    HRESULT hr;
+
+    if (!props || !props->extents || props->dimensions < 1 || props->dimensions > 3)
+        return E_INVALIDARG;
+    switch (props->bufferPrecision)
+    {
+        case D2D1_BUFFER_PRECISION_8BPC_UNORM:
+        case D2D1_BUFFER_PRECISION_8BPC_UNORM_SRGB: depth = 1; break;
+        case D2D1_BUFFER_PRECISION_16BPC_UNORM:
+        case D2D1_BUFFER_PRECISION_16BPC_FLOAT: depth = 2; break;
+        case D2D1_BUFFER_PRECISION_32BPC_FLOAT: depth = 4; break;
+        case D2D1_BUFFER_PRECISION_UNKNOWN: depth = 1; break;
+        default: return E_INVALIDARG;
+    }
+    if (props->channelDepth == D2D1_CHANNEL_DEPTH_DEFAULT || props->channelDepth == D2D1_CHANNEL_DEPTH_1)
+        channels = 1;
+    else if (props->channelDepth == D2D1_CHANNEL_DEPTH_4)
+        channels = 4;
+    else
+        return E_INVALIDARG;
+    for (i = 0; i < props->dimensions; ++i)
+    {
+        if (!props->extents[i])
+            return E_INVALIDARG;
+        size *= props->extents[i];
+        if (size * channels * depth > 0x10000000)
+            return E_OUTOFMEMORY;
+    }
+    if (data && props->dimensions > 1 && !strides)
+        return E_INVALIDARG;
+    if (!(texture = calloc(1, sizeof(*texture))))
+        return E_OUTOFMEMORY;
+    texture->ID2D1ResourceTexture_iface.lpVtbl = &d2d_resource_texture_vtbl;
+    texture->refcount = 1;
+    texture->dimensions = props->dimensions;
+    for (i = 0; i < props->dimensions; ++i)
+        texture->extents[i] = props->extents[i];
+    texture->elem_size = channels * depth;
+    if (!(texture->data = calloc(size, texture->elem_size)))
+    {
+        free(texture);
+        return E_OUTOFMEMORY;
+    }
+    if (data && FAILED(hr = d2d_resource_texture_copy(texture, NULL, NULL, strides, data, data_size)))
+    {
+        ID2D1ResourceTexture_Release(&texture->ID2D1ResourceTexture_iface);
+        return hr;
+    }
+    *out = &texture->ID2D1ResourceTexture_iface;
+    return S_OK;
+}
