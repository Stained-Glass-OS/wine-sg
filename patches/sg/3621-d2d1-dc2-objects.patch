+static void STDMETHODCALLTYPE d2d_ink_style_GetNibTransform(ID2D1InkStyle *iface, D2D1_MATRIX_3X2_F *transform)
+{
+    struct d2d_ink_style *style = (struct d2d_ink_style *)iface;
