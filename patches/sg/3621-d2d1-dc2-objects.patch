+static void STDMETHODCALLTYPE d2d_ink_SetStartPoint(ID2D1Ink *iface, const D2D1_INK_POINT *start_point)
+{
+    struct d2d_ink *ink = (struct d2d_ink *)iface;
+
+    TRACE("iface %p, start_point %p.\n", iface, start_point);
+    ink->start = *start_point;
+}
+
+static D2D1_INK_POINT * STDMETHODCALLTYPE d2d_ink_GetStartPoint(ID2D1Ink *iface, D2D1_INK_POINT *point)
+{
+    struct d2d_ink *ink = (struct d2d_ink *)iface;
+
+    TRACE("iface %p, point %p.\n", iface, point);
+    *point = ink->start;
+    return point;
+}
+
+static HRESULT d2d_ink_reserve(struct d2d_ink *ink, UINT32 count)
+{
+    D2D1_INK_BEZIER_SEGMENT *tmp;
+    UINT32 size;
+
+    if (count <= ink->size)
+        return S_OK;
+    size = max(ink->size * 2, max(count, 8));
+    if (!(tmp = realloc(ink->segments, size * sizeof(*tmp))))
+        return E_OUTOFMEMORY;
+    ink->segments = tmp;
+    ink->size = size;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_ink_AddSegments(ID2D1Ink *iface,
+        const D2D1_INK_BEZIER_SEGMENT *segments, UINT32 segment_count)
+{
+    struct d2d_ink *ink = (struct d2d_ink *)iface;
+    HRESULT hr;
+
+    TRACE("iface %p, segments %p, segment_count %u.\n", iface, segments, segment_count);
+
+    if (!segments && segment_count)
+        return E_INVALIDARG;
+    if (segment_count > 0x10000000 - ink->count)
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = d2d_ink_reserve(ink, ink->count + segment_count)))
+        return hr;
+    if (segment_count)
+        memcpy(&ink->segments[ink->count], segments, segment_count * sizeof(*segments));
+    ink->count += segment_count;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_ink_RemoveSegmentsAtEnd(ID2D1Ink *iface, UINT32 segment_count)
+{
+    struct d2d_ink *ink = (struct d2d_ink *)iface;
+
+    TRACE("iface %p, segment_count %u.\n", iface, segment_count);
+
+    if (segment_count > ink->count)
+        return E_INVALIDARG;
+    ink->count -= segment_count;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_ink_SetSegments(ID2D1Ink *iface, UINT32 start_segment,
+        const D2D1_INK_BEZIER_SEGMENT *segments, UINT32 segment_count)
+{
+    struct d2d_ink *ink = (struct d2d_ink *)iface;
+
+    TRACE("iface %p, start_segment %u, segments %p, segment_count %u.\n",
+            iface, start_segment, segments, segment_count);
+
+    if (start_segment > ink->count || segment_count > ink->count - start_segment || (!segments && segment_count))
+        return E_INVALIDARG;
+    if (segment_count)
+        memcpy(&ink->segments[start_segment], segments, segment_count * sizeof(*segments));
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_ink_SetSegmentAtEnd(ID2D1Ink *iface, const D2D1_INK_BEZIER_SEGMENT *segment)
+{
+    struct d2d_ink *ink = (struct d2d_ink *)iface;
+
+    TRACE("iface %p, segment %p.\n", iface, segment);
+
+    if (!ink->count || !segment)
+        return E_INVALIDARG;
+    ink->segments[ink->count - 1] = *segment;
+    return S_OK;
+}
+
+static UINT32 STDMETHODCALLTYPE d2d_ink_GetSegmentCount(ID2D1Ink *iface)
+{
+    struct d2d_ink *ink = (struct d2d_ink *)iface;
+
+    TRACE("iface %p.\n", iface);
+    return ink->count;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_ink_GetSegments(ID2D1Ink *iface, UINT32 start_segment,
+        D2D1_INK_BEZIER_SEGMENT *segments, UINT32 segment_count)
+{
+    struct d2d_ink *ink = (struct d2d_ink *)iface;
+
+    TRACE("iface %p, start_segment %u, segments %p, segment_count %u.\n",
+            iface, start_segment, segments, segment_count);
+
+    if (start_segment > ink->count || segment_count > ink->count - start_segment || (!segments && segment_count))
+        return E_INVALIDARG;
+    if (segment_count)
+        memcpy(segments, &ink->segments[start_segment], segment_count * sizeof(*segments));
+    return S_OK;
+}
+
+/* The ink is the union of the nib swept along the curve.  Each step between
+ * two samples is the convex hull of the nib at both: a convex polygon, all of
+ * the same winding, so a filled geometry with the winding rule is the union. */
+#define D2D_INK_CIRCLE_POINTS 16
+#define D2D_INK_STEPS 12
+#define D2D_INK_MAX_HULL (4 * D2D_INK_CIRCLE_POINTS)
+
+static float d2d_ink_lerp(float a, float b, float t)
+{
+    return a + (b - a) * t;
+}
+
+static void d2d_ink_eval(const D2D1_INK_POINT *p0, const D2D1_INK_BEZIER_SEGMENT *s, float t, D2D1_INK_POINT *out)
+{
+    const D2D1_INK_POINT *p[4] = {p0, &s->point1, &s->point2, &s->point3};
+    float v[3][4];
+    unsigned int k, i;
+
+    for (k = 0; k < 3; ++k)
+    {
+        for (i = 0; i < 4; ++i)
+        {
+            float a[4] = {p[0]->x, p[1]->x, p[2]->x, p[3]->x};
+            float b[4] = {p[0]->y, p[1]->y, p[2]->y, p[3]->y};
+            float c[4] = {p[0]->radius, p[1]->radius, p[2]->radius, p[3]->radius};
+            const float *src = k == 0 ? a : k == 1 ? b : c;
+            v[k][i] = src[i];
+        }
+    }
+    for (k = 0; k < 3; ++k)
+    {
+        float *w = v[k];
+        for (i = 3; i > 0; --i)
+        {
+            unsigned int j;
+            for (j = 0; j < i; ++j)
+                w[j] = d2d_ink_lerp(w[j], w[j + 1], t);
+        }
+    }
+    out->x = v[0][0];
+    out->y = v[1][0];
+    out->radius = v[2][0];
+}
+
+static int d2d_ink_cmp_points(const void *a, const void *b)
+{
+    const D2D1_POINT_2F *p = a, *q = b;
+
+    if (p->x != q->x)
+        return p->x < q->x ? -1 : 1;
+    if (p->y != q->y)
+        return p->y < q->y ? -1 : 1;
+    return 0;
+}
+
+static float d2d_ink_cross(const D2D1_POINT_2F *o, const D2D1_POINT_2F *a, const D2D1_POINT_2F *b)
+{
+    return (a->x - o->x) * (b->y - o->y) - (a->y - o->y) * (b->x - o->x);
+}
+
+/* Andrew's monotone chain; returns the number of points of the hull. */
+static unsigned int d2d_ink_hull(D2D1_POINT_2F *pts, unsigned int n, D2D1_POINT_2F *out)
+{
+    unsigned int i, k = 0, t;
+
+    qsort(pts, n, sizeof(*pts), d2d_ink_cmp_points);
+    for (i = 0; i < n; ++i)
+    {
+        while (k >= 2 && d2d_ink_cross(&out[k - 2], &out[k - 1], &pts[i]) <= 0.0f)
+            --k;
+        out[k++] = pts[i];
+    }
+    for (i = n - 1, t = k + 1; i > 0; --i)
+    {
+        while (k >= t && d2d_ink_cross(&out[k - 2], &out[k - 1], &pts[i - 1]) <= 0.0f)
+            --k;
+        out[k++] = pts[i - 1];
+    }
+    return k > 1 ? k - 1 : k;
+}
+
+static void d2d_ink_nib(const struct d2d_ink_style *style, const D2D1_INK_POINT *p, D2D1_POINT_2F *out)
+{
+    D2D1_MATRIX_3X2_F m = style ? style->transform : d2d_identity;
+    unsigned int i, count = D2D_INK_CIRCLE_POINTS;
+    float x, y;
+
+    if (style && style->shape == D2D1_INK_NIB_SHAPE_SQUARE)
+        count = 4;
+    for (i = 0; i < count; ++i)
+    {
+        if (count == 4)
+        {
+            x = (i == 0 || i == 3) ? -1.0f : 1.0f;
+            y = (i < 2) ? -1.0f : 1.0f;
+        }
+        else
+        {
+            x = cosf(2.0f * 3.14159265358979f * i / count);
+            y = sinf(2.0f * 3.14159265358979f * i / count);
+        }
+#ifndef SG_MUTANT_D2D_INK_NORADIUS
+        x *= p->radius;
+        y *= p->radius;
+#endif
+        out[i].x = p->x + x * m._11 + y * m._21;
+        out[i].y = p->y + x * m._12 + y * m._22;
+    }
+    for (; i < D2D_INK_CIRCLE_POINTS; ++i)
+        out[i] = out[0];
+}
+
+typedef HRESULT (*d2d_ink_poly_cb)(void *ctx, const D2D1_POINT_2F *pts, unsigned int n);
+
+static HRESULT d2d_ink_walk(struct d2d_ink *ink, const struct d2d_ink_style *style,
+        const D2D1_MATRIX_3X2_F *world, d2d_ink_poly_cb cb, void *ctx)
+{
+    D2D1_POINT_2F nib0[D2D_INK_CIRCLE_POINTS], nib1[D2D_INK_CIRCLE_POINTS], all[2 * D2D_INK_CIRCLE_POINTS];
+    D2D1_POINT_2F hull[D2D_INK_MAX_HULL];
+    D2D1_INK_POINT prev, cur;
+    unsigned int s, i, n;
+    HRESULT hr;
+
+    prev = ink->start;
+    d2d_ink_nib(style, &prev, nib0);
+    for (s = 0; s < ink->count || s == 0; ++s)
+    {
+        for (i = (ink->count ? 1 : 0); i <= (ink->count ? D2D_INK_STEPS : 0); ++i)
+        {
+            D2D1_POINT_2F out[D2D_INK_MAX_HULL];
+            unsigned int j;
+
+            if (ink->count)
+                d2d_ink_eval(&prev, &ink->segments[s], (float)i / D2D_INK_STEPS, &cur);
+            else
+                cur = ink->start;
+            d2d_ink_nib(style, &cur, nib1);
+            memcpy(all, nib0, sizeof(nib0));
+            memcpy(all + D2D_INK_CIRCLE_POINTS, nib1, sizeof(nib1));
+            n = d2d_ink_hull(all, 2 * D2D_INK_CIRCLE_POINTS, hull);
+            if (n >= 3)
+            {
+                for (j = 0; j < n; ++j)
+                {
+                    float x = hull[j].x, y = hull[j].y;
+                    out[j].x = world ? x * world->_11 + y * world->_21 + world->_31 : x;
+                    out[j].y = world ? x * world->_12 + y * world->_22 + world->_32 : y;
+                }
+                if (FAILED(hr = cb(ctx, out, n)))
+                    return hr;
+            }
+            memcpy(nib0, nib1, sizeof(nib0));
+        }
+        if (ink->count)
+        {
+            /* the next segment starts where this one ends */
+            prev = ink->segments[s].point3;
+            if (s + 1 == ink->count)
+                break;
+        }
+        else
+            break;
+    }
+    return S_OK;
+}
+
+struct d2d_ink_stream_ctx
+{
+    ID2D1SimplifiedGeometrySink *sink;
+    BOOL first;
+};
+
+static HRESULT d2d_ink_stream_poly(void *ctx_, const D2D1_POINT_2F *pts, unsigned int n)
+{
+    struct d2d_ink_stream_ctx *ctx = ctx_;
+
+    if (ctx->first)
+    {
+        ID2D1SimplifiedGeometrySink_SetFillMode(ctx->sink, D2D1_FILL_MODE_WINDING);
+        ctx->first = FALSE;
+    }
+    ID2D1SimplifiedGeometrySink_BeginFigure(ctx->sink, pts[0], D2D1_FIGURE_BEGIN_FILLED);
+    ID2D1SimplifiedGeometrySink_AddLines(ctx->sink, pts + 1, n - 1);
+    ID2D1SimplifiedGeometrySink_EndFigure(ctx->sink, D2D1_FIGURE_END_CLOSED);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_ink_StreamAsGeometry(ID2D1Ink *iface, ID2D1InkStyle *ink_style,
+        const D2D1_MATRIX_3X2_F *world_transform, float flattening_tolerance, ID2D1SimplifiedGeometrySink *sink)
+{
+    struct d2d_ink *ink = (struct d2d_ink *)iface;
+    struct d2d_ink_stream_ctx ctx;
+
+    TRACE("iface %p, ink_style %p, world_transform %p, flattening_tolerance %.8e, sink %p.\n",
+            iface, ink_style, world_transform, flattening_tolerance, sink);
+
+    if (!sink)
+        return E_INVALIDARG;
+    ctx.sink = sink;
+    ctx.first = TRUE;
+    return d2d_ink_walk(ink, (struct d2d_ink_style *)ink_style, world_transform, d2d_ink_stream_poly, &ctx);
+}
+
+static HRESULT d2d_ink_bounds_poly(void *ctx, const D2D1_POINT_2F *pts, unsigned int n)
+{
+    D2D1_RECT_F *r = ctx;
+    unsigned int i;
+
+    for (i = 0; i < n; ++i)
+    {
+        r->left = min(r->left, pts[i].x);
+        r->top = min(r->top, pts[i].y);
+        r->right = max(r->right, pts[i].x);
+        r->bottom = max(r->bottom, pts[i].y);
+    }
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_ink_GetBounds(ID2D1Ink *iface, ID2D1InkStyle *ink_style,
+        const D2D1_MATRIX_3X2_F *world_transform, D2D1_RECT_F *bounds)
+{
+    struct d2d_ink *ink = (struct d2d_ink *)iface;
+    HRESULT hr;
+
+    TRACE("iface %p, ink_style %p, world_transform %p, bounds %p.\n", iface, ink_style, world_transform, bounds);
+
+    bounds->left = bounds->top = FLT_MAX;
+    bounds->right = bounds->bottom = -FLT_MAX;
+    if (FAILED(hr = d2d_ink_walk(ink, (struct d2d_ink_style *)ink_style, world_transform, d2d_ink_bounds_poly, bounds)))
+        return hr;
+    if (bounds->left > bounds->right)
+        bounds->left = bounds->top = bounds->right = bounds->bottom = 0.0f;
+    return S_OK;
+}
