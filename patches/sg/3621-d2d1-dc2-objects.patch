+
+/* The patch is a bicubic Bezier surface; point<i><j> is row i, column j, and
+ * the corner colors are interpolated bilinearly. */
+static void d2d_patch_eval(const D2D1_GRADIENT_MESH_PATCH *patch, float u, float v, D2D1_POINT_2F *out)
+{
+    const D2D1_POINT_2F *p = &patch->point00;
+    float bu[4], bv[4];
+    unsigned int i, j;
+
+    bu[0] = (1 - u) * (1 - u) * (1 - u);
+    bu[1] = 3 * u * (1 - u) * (1 - u);
+    bu[2] = 3 * u * u * (1 - u);
+    bu[3] = u * u * u;
+    bv[0] = (1 - v) * (1 - v) * (1 - v);
+    bv[1] = 3 * v * (1 - v) * (1 - v);
+    bv[2] = 3 * v * v * (1 - v);
+    bv[3] = v * v * v;
+    out->x = out->y = 0.0f;
+    for (i = 0; i < 4; ++i)
+    {
+        for (j = 0; j < 4; ++j)
+        {
+            out->x += bv[i] * bu[j] * p[i * 4 + j].x;
+            out->y += bv[i] * bu[j] * p[i * 4 + j].y;
+        }
+    }
+}
+
+#define D2D_PATCH_GRID 12
+
+HRESULT d2d_gradient_mesh_bounds(ID2D1GradientMesh *iface, const D2D1_MATRIX_3X2_F *m, D2D1_RECT_F *bounds)
+{
+    UINT32 count = ID2D1GradientMesh_GetPatchCount(iface), i;
+    D2D1_RECT_F r = {FLT_MAX, FLT_MAX, -FLT_MAX, -FLT_MAX};
+    D2D1_GRADIENT_MESH_PATCH patch;
+    unsigned int a, b;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (FAILED(ID2D1GradientMesh_GetPatches(iface, i, &patch, 1)))
+            return E_INVALIDARG;
+        for (a = 0; a <= D2D_PATCH_GRID; ++a)
+        {
+            for (b = 0; b <= D2D_PATCH_GRID; ++b)
+            {
+                D2D1_POINT_2F pt;
+                float x, y;
+
+                d2d_patch_eval(&patch, (float)b / D2D_PATCH_GRID, (float)a / D2D_PATCH_GRID, &pt);
+                x = pt.x * m->_11 + pt.y * m->_21 + m->_31;
+                y = pt.x * m->_12 + pt.y * m->_22 + m->_32;
+                r.left = min(r.left, x);
+                r.top = min(r.top, y);
+                r.right = max(r.right, x);
+                r.bottom = max(r.bottom, y);
+            }
+        }
+    }
+    if (r.left > r.right)
+        r.left = r.top = r.right = r.bottom = 0.0f;
+    *bounds = r;
+    return S_OK;
+}
+
+static D2D1_COLOR_F d2d_patch_color(const D2D1_GRADIENT_MESH_PATCH *p, float u, float v)
+{
+    D2D1_COLOR_F c;
+
+    c.r = (1 - v) * ((1 - u) * p->color00.r + u * p->color03.r) + v * ((1 - u) * p->color30.r + u * p->color33.r);
+    c.g = (1 - v) * ((1 - u) * p->color00.g + u * p->color03.g) + v * ((1 - u) * p->color30.g + u * p->color33.g);
+    c.b = (1 - v) * ((1 - u) * p->color00.b + u * p->color03.b) + v * ((1 - u) * p->color30.b + u * p->color33.b);
+    c.a = (1 - v) * ((1 - u) * p->color00.a + u * p->color03.a) + v * ((1 - u) * p->color30.a + u * p->color33.a);
+    return c;
+}
+
+/* A mesh is drawn as a grid of small quads per patch, each filled with the
+ * color of its center. */
+void d2d_draw_gradient_mesh(ID2D1DeviceContext6 *context, ID2D1GradientMesh *mesh)
+{
+    UINT32 count, i;
+    ID2D1SolidColorBrush *brush;
+    ID2D1Factory *factory;
+    D2D1_COLOR_F white = {1.0f, 1.0f, 1.0f, 1.0f};
+
+    if (!mesh)
+        return;
+    count = ID2D1GradientMesh_GetPatchCount(mesh);
+    ID2D1DeviceContext6_GetFactory(context, &factory);
+    if (FAILED(ID2D1DeviceContext6_CreateSolidColorBrush(context, &white, NULL, &brush)))
+    {
+        ID2D1Factory_Release(factory);
+        return;
+    }
+    for (i = 0; i < count; ++i)
+    {
+        D2D1_GRADIENT_MESH_PATCH patch;
+        unsigned int a, b;
+
+        if (FAILED(ID2D1GradientMesh_GetPatches(mesh, i, &patch, 1)))
+            break;
+        for (a = 0; a < D2D_PATCH_GRID; ++a)
+        {
+            for (b = 0; b < D2D_PATCH_GRID; ++b)
+            {
+                float u0 = (float)b / D2D_PATCH_GRID, u1 = (float)(b + 1) / D2D_PATCH_GRID;
+                float v0 = (float)a / D2D_PATCH_GRID, v1 = (float)(a + 1) / D2D_PATCH_GRID;
+                D2D1_POINT_2F q[4];
+                D2D1_COLOR_F color = d2d_patch_color(&patch, (u0 + u1) / 2, (v0 + v1) / 2);
+                ID2D1PathGeometry *geometry;
+                ID2D1GeometrySink *sink;
+
+                d2d_patch_eval(&patch, u0, v0, &q[0]);
+                d2d_patch_eval(&patch, u1, v0, &q[1]);
+                d2d_patch_eval(&patch, u1, v1, &q[2]);
+                d2d_patch_eval(&patch, u0, v1, &q[3]);
+                if (FAILED(ID2D1Factory_CreatePathGeometry(factory, &geometry)))
+                    continue;
+                if (SUCCEEDED(ID2D1PathGeometry_Open(geometry, &sink)))
+                {
+                    ID2D1GeometrySink_BeginFigure(sink, q[0], D2D1_FIGURE_BEGIN_FILLED);
+                    ID2D1GeometrySink_AddLines(sink, q + 1, 3);
+                    ID2D1GeometrySink_EndFigure(sink, D2D1_FIGURE_END_CLOSED);
+                    ID2D1GeometrySink_Close(sink);
+                    ID2D1GeometrySink_Release(sink);
+                    ID2D1SolidColorBrush_SetColor(brush, &color);
+                    ID2D1DeviceContext6_FillGeometry(context, (ID2D1Geometry *)geometry,
+                            (ID2D1Brush *)brush, NULL);
+                }
+                ID2D1PathGeometry_Release(geometry);
+            }
+        }
+    }
+    ID2D1SolidColorBrush_Release(brush);
+    ID2D1Factory_Release(factory);
+}
