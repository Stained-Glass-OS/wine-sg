+    struct d2d_image_source *source;
+    HRESULT hr;
+
+    if (!surfaces || !surface_count || !surfaces[0])
+        return E_INVALIDARG;
+    if (surface_count != 1)
+    {
+        FIXME("Multi-plane surfaces (%u) are not supported.\n", surface_count);
+        return E_NOTIMPL;
+    }
+    if (!(source = d2d_obj_alloc(sizeof(*source))))
+        return E_OUTOFMEMORY;
+    d2d_obj_init(&source->obj, &d2d_image_source_vtbl, factory, d2d_image_source_iids, d2d_image_source_destroy);
+    if (FAILED(hr = ID2D1DeviceContext6_CreateSharedBitmap(context, &IID_IDXGISurface, surfaces[0],
+            &desc, &source->bitmap)))
+    {
+        ID2D1ImageSource_Release((ID2D1ImageSource *)source);
+        return hr;
+    }
+    *out = (ID2D1ImageSource *)source;
+    return S_OK;
+}
