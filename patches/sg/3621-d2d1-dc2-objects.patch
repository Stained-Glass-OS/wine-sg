+/* ---- ID2D1SpriteBatch ----------------------------------------------------- */
+
+struct d2d_sprite
+{
+    D2D1_RECT_F dst;
+    D2D1_RECT_U src;
+    D2D1_COLOR_F color;
+    D2D1_MATRIX_3X2_F transform;
+};
+
+struct d2d_sprite_batch
+{
+    struct d2d_obj obj;
+    struct d2d_sprite *sprites;
+    UINT32 count, size;
+};
+
+static const GUID *const d2d_sprite_batch_iids[] = {&IID_ID2D1SpriteBatch, NULL};
+
+D2D_OBJ_BASE_METHODS(d2d_sprite_batch, ID2D1SpriteBatch)
+
+static void d2d_sprite_batch_destroy(struct d2d_obj *obj)
+{
+    free(((struct d2d_sprite_batch *)obj)->sprites);
+}
+
+static const void *d2d_stride(const void *base, UINT32 i, UINT32 stride)
+{
+    return base ? (const BYTE *)base + (size_t)i * stride : NULL;
+}
+
+/* A sprite without a source rectangle uses the whole bitmap; this marks it. */
+static const D2D1_RECT_U d2d_sprite_whole = {0, 0, 0xffffffff, 0xffffffff};
+
+static void d2d_sprite_set(struct d2d_sprite *s, UINT32 i, const D2D1_RECT_F *dst, const D2D1_RECT_U *src,
+        const D2D1_COLOR_F *colors, const D2D1_MATRIX_3X2_F *transforms, UINT32 dst_stride, UINT32 src_stride,
+        UINT32 color_stride, UINT32 transform_stride)
+{
+    const D2D1_RECT_F *d = d2d_stride(dst, i, dst_stride);
+    const D2D1_RECT_U *r = d2d_stride(src, i, src_stride);
+    const D2D1_COLOR_F *c = d2d_stride(colors, i, color_stride);
+    const D2D1_MATRIX_3X2_F *t = d2d_stride(transforms, i, transform_stride);
+
+    s->dst = d ? *d : (D2D1_RECT_F){0};
+    s->src = r ? *r : d2d_sprite_whole;
+    s->color = c ? *c : (D2D1_COLOR_F){1.0f, 1.0f, 1.0f, 1.0f};
+    s->transform = t ? *t : d2d_identity;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_sprite_batch_AddSprites(ID2D1SpriteBatch *iface, UINT32 sprite_count,
+        const D2D1_RECT_F *dst, const D2D1_RECT_U *src, const D2D1_COLOR_F *colors,
+        const D2D1_MATRIX_3X2_F *transforms, UINT32 dst_stride, UINT32 src_stride, UINT32 color_stride,
+        UINT32 transform_stride)
+{
+    struct d2d_sprite_batch *batch = (struct d2d_sprite_batch *)iface;
+    UINT32 i;
+
+    TRACE("iface %p, sprite_count %u, dst %p, src %p, colors %p, transforms %p.\n",
+            iface, sprite_count, dst, src, colors, transforms);
+
+    if (!dst)
+        return E_INVALIDARG;
+    if (sprite_count > 0x1000000 - batch->count)
+        return E_OUTOFMEMORY;
+    if (batch->count + sprite_count > batch->size)
+    {
+        UINT32 size = max(batch->size * 2, batch->count + sprite_count);
+        struct d2d_sprite *tmp;
+
+        if (!(tmp = realloc(batch->sprites, size * sizeof(*tmp))))
+            return E_OUTOFMEMORY;
+        batch->sprites = tmp;
+        batch->size = size;
+    }
+    for (i = 0; i < sprite_count; ++i)
+        d2d_sprite_set(&batch->sprites[batch->count + i], i, dst, src, colors, transforms,
+                dst_stride, src_stride, color_stride, transform_stride);
+    batch->count += sprite_count;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_sprite_batch_SetSprites(ID2D1SpriteBatch *iface, UINT32 start_index,
+        UINT32 sprite_count, const D2D1_RECT_F *dst, const D2D1_RECT_U *src, const D2D1_COLOR_F *colors,
+        const D2D1_MATRIX_3X2_F *transforms, UINT32 dst_stride, UINT32 src_stride, UINT32 color_stride,
+        UINT32 transform_stride)
+{
+    struct d2d_sprite_batch *batch = (struct d2d_sprite_batch *)iface;
+    UINT32 i;
+
+    TRACE("iface %p, start_index %u, sprite_count %u.\n", iface, start_index, sprite_count);
+
+    if (start_index > batch->count || sprite_count > batch->count - start_index)
+        return E_INVALIDARG;
+    /* only the arrays given change */
+    for (i = 0; i < sprite_count; ++i)
+    {
+        struct d2d_sprite *s = &batch->sprites[start_index + i], n = *s;
+        const D2D1_RECT_F *d = d2d_stride(dst, i, dst_stride);
+        const D2D1_RECT_U *r = d2d_stride(src, i, src_stride);
+        const D2D1_COLOR_F *c = d2d_stride(colors, i, color_stride);
+        const D2D1_MATRIX_3X2_F *t = d2d_stride(transforms, i, transform_stride);
+
+        if (d) n.dst = *d;
+        if (r) n.src = *r;
+        if (c) n.color = *c;
+        if (t) n.transform = *t;
+        *s = n;
+    }
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_sprite_batch_GetSprites(ID2D1SpriteBatch *iface, UINT32 start_index,
+        UINT32 sprite_count, D2D1_RECT_F *dst, D2D1_RECT_U *src, D2D1_COLOR_F *colors, D2D1_MATRIX_3X2_F *transforms)
+{
+    struct d2d_sprite_batch *batch = (struct d2d_sprite_batch *)iface;
+    UINT32 i;
+
+    TRACE("iface %p, start_index %u, sprite_count %u.\n", iface, start_index, sprite_count);
+
+    if (start_index > batch->count || sprite_count > batch->count - start_index)
+        return E_INVALIDARG;
+    for (i = 0; i < sprite_count; ++i)
+    {
+        const struct d2d_sprite *s = &batch->sprites[start_index + i];
+
+        if (dst) dst[i] = s->dst;
+        if (src) src[i] = s->src;
+        if (colors) colors[i] = s->color;
+        if (transforms) transforms[i] = s->transform;
+    }
+    return S_OK;
+}
+
+static UINT32 STDMETHODCALLTYPE d2d_sprite_batch_GetSpriteCount(ID2D1SpriteBatch *iface)
+{
+    struct d2d_sprite_batch *batch = (struct d2d_sprite_batch *)iface;
+
+    TRACE("iface %p.\n", iface);
+    return batch->count;
+}
+
+static void STDMETHODCALLTYPE d2d_sprite_batch_Clear(ID2D1SpriteBatch *iface)
+{
+    struct d2d_sprite_batch *batch = (struct d2d_sprite_batch *)iface;
+
+    TRACE("iface %p.\n", iface);
+#ifndef SG_MUTANT_D2D_SPRITE_CLEAR
+    batch->count = 0;
+#endif
+}
+
+static const ID2D1SpriteBatchVtbl d2d_sprite_batch_vtbl =
+{
+    d2d_sprite_batch_QueryInterface,
+    d2d_sprite_batch_AddRef,
+    d2d_sprite_batch_Release,
+    d2d_sprite_batch_GetFactory,
+    d2d_sprite_batch_AddSprites,
+    d2d_sprite_batch_SetSprites,
+    d2d_sprite_batch_GetSprites,
+    d2d_sprite_batch_GetSpriteCount,
+    d2d_sprite_batch_Clear,
+};
+
+HRESULT d2d_sprite_batch_create(ID2D1Factory *factory, ID2D1SpriteBatch **out)
+{
+    struct d2d_sprite_batch *batch;
+
+    if (!(batch = d2d_obj_alloc(sizeof(*batch))))
+        return E_OUTOFMEMORY;
+    d2d_obj_init(&batch->obj, &d2d_sprite_batch_vtbl, factory, d2d_sprite_batch_iids, d2d_sprite_batch_destroy);
+    *out = (ID2D1SpriteBatch *)batch;
+    return S_OK;
+}
+
+/* Each sprite is a bitmap draw with the sprite's transform; the tint is
+ * applied as opacity only (the alpha of the color). */
+HRESULT d2d_draw_sprite_batch(ID2D1DeviceContext6 *context, ID2D1SpriteBatch *iface, UINT32 start_index,
+        UINT32 sprite_count, ID2D1Bitmap *bitmap, D2D1_BITMAP_INTERPOLATION_MODE mode, D2D1_SPRITE_OPTIONS options)
+{
+    struct d2d_sprite_batch *batch = (struct d2d_sprite_batch *)iface;
+    D2D1_MATRIX_3X2_F saved;
+    UINT32 i;
+
+    if (!batch || !bitmap || options > D2D1_SPRITE_OPTIONS_CLAMP_TO_SOURCE_RECTANGLE
+            || start_index > batch->count || sprite_count > batch->count - start_index)
+        return E_INVALIDARG;
+
+    ID2D1DeviceContext6_GetTransform(context, &saved);
+    for (i = 0; i < sprite_count; ++i)
+    {
+        const struct d2d_sprite *s = &batch->sprites[start_index + i];
+        D2D1_SIZE_U size = ID2D1Bitmap_GetPixelSize(bitmap);
+        D2D1_RECT_F src;
+        D2D1_MATRIX_3X2_F m;
+
+        src.left = s->src.left;
+        src.top = s->src.top;
+        src.right = min(s->src.right, size.width);
+        src.bottom = min(s->src.bottom, size.height);
+        m._11 = s->transform._11 * saved._11 + s->transform._12 * saved._21;
+        m._12 = s->transform._11 * saved._12 + s->transform._12 * saved._22;
+        m._21 = s->transform._21 * saved._11 + s->transform._22 * saved._21;
+        m._22 = s->transform._21 * saved._12 + s->transform._22 * saved._22;
+        m._31 = s->transform._31 * saved._11 + s->transform._32 * saved._21 + saved._31;
+        m._32 = s->transform._31 * saved._12 + s->transform._32 * saved._22 + saved._32;
+        ID2D1DeviceContext6_SetTransform(context, &m);
+        ID2D1RenderTarget_DrawBitmap((ID2D1RenderTarget *)context, bitmap, &s->dst, s->color.a, mode, &src);
+    }
+    ID2D1DeviceContext6_SetTransform(context, &saved);
+    return S_OK;
+}
