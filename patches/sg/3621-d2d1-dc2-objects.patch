+
+struct d2d_ink
+{
+    struct d2d_obj obj;
+    D2D1_INK_POINT start;
+    D2D1_INK_BEZIER_SEGMENT *segments;
+    UINT32 count, size;
+};
+
+static const GUID *const d2d_ink_iids[] = {&IID_ID2D1Ink, NULL};
+
+D2D_OBJ_BASE_METHODS(d2d_ink, ID2D1Ink)
+
+static void d2d_ink_destroy(struct d2d_obj *obj)
+{
+    free(((struct d2d_ink *)obj)->segments);
+}
