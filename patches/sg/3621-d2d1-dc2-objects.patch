+    TRACE("iface %p, source %p.\n", iface, source);
+    ID2D1ImageSource_AddRef(*source = t->source);
+}
+
+static void STDMETHODCALLTYPE d2d_transformed_source_GetProperties(ID2D1TransformedImageSource *iface,
+        D2D1_TRANSFORMED_IMAGE_SOURCE_PROPERTIES *props)
+{
+    struct d2d_transformed_source *t = (struct d2d_transformed_source *)iface;
+
+    TRACE("iface %p, props %p.\n", iface, props);
+    *props = t->props;
+}
+
+static const ID2D1TransformedImageSourceVtbl d2d_transformed_source_vtbl =
+{
+    d2d_transformed_source_QueryInterface,
+    d2d_transformed_source_AddRef,
+    d2d_transformed_source_Release,
+    d2d_transformed_source_GetFactory,
+    d2d_transformed_source_GetSource,
+    d2d_transformed_source_GetProperties,
+};
+
+HRESULT d2d_transformed_source_create(ID2D1Factory *factory, ID2D1ImageSource *source,
+        const D2D1_TRANSFORMED_IMAGE_SOURCE_PROPERTIES *props, ID2D1TransformedImageSource **out)
+{
+    struct d2d_transformed_source *t;
+
+    if (!source || !props || props->orientation < D2D1_ORIENTATION_DEFAULT
+            || props->orientation > D2D1_ORIENTATION_ROTATE_CLOCKWISE90
+            || props->scaleX <= 0.0f || props->scaleY <= 0.0f)
+        return E_INVALIDARG;
+    if (!(t = d2d_obj_alloc(sizeof(*t))))
+        return E_OUTOFMEMORY;
+    d2d_obj_init(&t->obj, &d2d_transformed_source_vtbl, factory, d2d_transformed_iids, d2d_transformed_destroy);
+    ID2D1ImageSource_AddRef(t->source = source);
+    t->props = *props;
+    *out = (ID2D1TransformedImageSource *)t;
+    return S_OK;
+}
+
+/* If the image is one of these sources, return the bitmap to draw and the
+ * matrix that places it (the orientation and scale of a transformed one). */
+BOOL d2d_image_source_resolve(ID2D1Image *image, ID2D1Bitmap **bitmap, D2D1_MATRIX_3X2_F *m,
+        D2D1_INTERPOLATION_MODE *mode, BOOL *use_mode)
+{
+    const struct d2d_obj *obj = (const struct d2d_obj *)image;
+    struct d2d_image_source *source;
+
+    *use_mode = FALSE;
+    *m = d2d_identity;
+    if (!image)
+        return FALSE;
+    if (obj->vtbl == &d2d_transformed_source_vtbl)
+    {
+        const struct d2d_transformed_source *t = (const struct d2d_transformed_source *)obj;
+        D2D1_SIZE_F size;
+        float w, h, sx = t->props.scaleX, sy = t->props.scaleY;
+        D2D1_MATRIX_3X2_F o;
+
+        if (!d2d_image_source_resolve((ID2D1Image *)t->source, bitmap, m, mode, use_mode))
+            return FALSE;
+        size = ID2D1Bitmap_GetSize(*bitmap);
+        w = size.width;
+        h = size.height;
+        switch (t->props.orientation)
+        {
+            case D2D1_ORIENTATION_FLIP_HORIZONTAL:
+                o = (D2D1_MATRIX_3X2_F){{{-1, 0, 0, 1, w, 0}}}; break;
+            case D2D1_ORIENTATION_ROTATE_CLOCKWISE180:
+                o = (D2D1_MATRIX_3X2_F){{{-1, 0, 0, -1, w, h}}}; break;
+            case D2D1_ORIENTATION_ROTATE_CLOCKWISE180_FLIP_HORIZONTAL:
+                o = (D2D1_MATRIX_3X2_F){{{1, 0, 0, -1, 0, h}}}; break;
+            case D2D1_ORIENTATION_ROTATE_CLOCKWISE90_FLIP_HORIZONTAL:
+                o = (D2D1_MATRIX_3X2_F){{{0, 1, 1, 0, 0, 0}}}; break;
+            case D2D1_ORIENTATION_ROTATE_CLOCKWISE270:
+                o = (D2D1_MATRIX_3X2_F){{{0, -1, 1, 0, 0, w}}}; break;
+            case D2D1_ORIENTATION_ROTATE_CLOCKWISE270_FLIP_HORIZONTAL:
+                o = (D2D1_MATRIX_3X2_F){{{0, -1, -1, 0, h, w}}}; break;
+            case D2D1_ORIENTATION_ROTATE_CLOCKWISE90:
+                o = (D2D1_MATRIX_3X2_F){{{0, 1, -1, 0, h, 0}}}; break;
+            default:
+                o = d2d_identity; break;
+        }
+        /* the matrix of the source (identity) then orientation then scale */
+        o._11 *= sx; o._21 *= sx; o._31 *= sx;
+        o._12 *= sy; o._22 *= sy; o._32 *= sy;
+        *m = o;
+        *mode = t->props.interpolationMode;
+        *use_mode = TRUE;
+        return TRUE;
+    }
+    if (obj->vtbl == &d2d_image_source_wic_vtbl || obj->vtbl == &d2d_image_source_vtbl)
+    {
+        source = (struct d2d_image_source *)obj;
+        ID2D1Bitmap_AddRef(*bitmap = source->bitmap);
+        return TRUE;
+    }
+    return FALSE;
+}
