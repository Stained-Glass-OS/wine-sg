+static void STDMETHODCALLTYPE d2d_ink_style_SetNibShape(ID2D1InkStyle *iface, D2D1_INK_NIB_SHAPE shape)
+{
+    struct d2d_ink_style *style = (struct d2d_ink_style *)iface;
+
+    TRACE("iface %p, shape %u.\n", iface, shape);
