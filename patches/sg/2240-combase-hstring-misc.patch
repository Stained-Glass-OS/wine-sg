--- a/dlls/combase/string.c
+++ b/dlls/combase/string.c
@@ -480,3 +480,75 @@ HRESULT WINAPI WindowsTrimStringEnd(HSTRING str1, HSTRING str2, HSTRING *out)
     return (len < priv1->header.length) ? WindowsCreateString(priv1->header.str, len, out) :
                                    WindowsDuplicateString(str1, out);
 }
+
+/***********************************************************************
+ *      WindowsReplaceString (combase.@)
+ *
+ * A copy of STR with every occurrence of OLD replaced by NEW (which may be
+ * NULL, to delete them); the copy is NULL when it is empty.
+ */
+HRESULT WINAPI WindowsReplaceString(HSTRING str, HSTRING old, HSTRING new, HSTRING *out)
+{
+    struct hstring_private *priv = impl_from_HSTRING(str);
+    struct hstring_private *priv_old = impl_from_HSTRING(old);
+    struct hstring_private *priv_new = impl_from_HSTRING(new);
+    UINT32 old_len, new_len, i, count = 0, replaced, len;
+    const WCHAR *src, *old_str, *new_str;
+    HSTRING result;
+    WCHAR *dst;
+
+    TRACE("(%p, %p, %p, %p)\n", str, old, new, out);
+
+    if (!out || !old || !priv_old->header.length)
+        return E_INVALIDARG;
+    if (!str)
+    {
+        *out = NULL;
+        return S_OK;
+    }
+
+    src = priv->header.str;
+    len = priv->header.length;
+    old_str = priv_old->header.str;
+    old_len = priv_old->header.length;
+    new_str = new ? priv_new->header.str : empty;
+    new_len = new ? priv_new->header.length : 0;
+
+    for (i = 0; i + old_len <= len; )
+    {
+#ifdef SG_MUTANT_REPLACE_FIRST_ONLY
+        if (!count && !memcmp(src + i, old_str, old_len * sizeof(WCHAR))) { count++; i += old_len; }
+#else
+        if (!memcmp(src + i, old_str, old_len * sizeof(WCHAR))) { count++; i += old_len; }
+#endif
+        else i++;
+    }
+    if (!count) return WindowsDuplicateString(str, out);
+
+    if (new_len > old_len && (new_len - old_len) > (0x7fffffffu - len) / count)
+        return E_OUTOFMEMORY;
+    len = len - count * old_len + count * new_len;
+    if (!len)
+    {
+        *out = NULL;
+        return S_OK;
+    }
+    if (!alloc_string(len, &result))
+        return E_OUTOFMEMORY;
+
+    dst = impl_from_HSTRING(result)->buffer;
+    for (i = 0, replaced = 0; i < priv->header.length; )
+    {
+        if (i + old_len <= priv->header.length && !memcmp(src + i, old_str, old_len * sizeof(WCHAR))
+            && replaced < count)
+        {
+            replaced++;
+            memcpy(dst, new_str, new_len * sizeof(WCHAR));
+            dst += new_len;
+            i += old_len;
+        }
+        else *dst++ = src[i++];
+    }
+    *out = result;
+    return S_OK;
+}
--- a/dlls/combase/usrmarshal.c
+++ b/dlls/combase/usrmarshal.c
@@ -21,6 +21,7 @@
 
 #define COBJMACROS
 #include "ole2.h"
+#include "winstring.h"
 
 #include "wine/debug.h"
 
@@ -1025,3 +1026,56 @@ void WINAPI WdtpInterfacePointer_UserFree(IUnknown *punk)
     TRACE("%p.\n", punk);
     if (punk) IUnknown_Release(punk);
 }
+
+/* HSTRING crossing an apartment: its length as a ULONG, then its characters.
+ * A NULL string is a length of zero, as an empty one is NULL. */
+ULONG __RPC_USER HSTRING_UserSize(ULONG *flags, ULONG start, HSTRING *str)
+{
+    TRACE("%s, %lu, %p.\n", debugstr_user_flags(flags), start, str);
+
+    ALIGN_LENGTH(start, 3);
+#ifdef SG_MUTANT_HSTRING_NO_LENGTH
+    return start + WindowsGetStringLen(*str) * sizeof(WCHAR);
+#endif
+    return start + sizeof(ULONG) + WindowsGetStringLen(*str) * sizeof(WCHAR);
+}
+
+unsigned char * __RPC_USER HSTRING_UserMarshal(ULONG *flags, unsigned char *buffer, HSTRING *str)
+{
+    UINT32 len = WindowsGetStringLen(*str);
+
+    TRACE("%s, %p, %p.\n", debugstr_user_flags(flags), buffer, str);
+
+    ALIGN_POINTER(buffer, 3);
+    *(ULONG *)buffer = len;
+    buffer += sizeof(ULONG);
+    if (len) memcpy(buffer, WindowsGetStringRawBuffer(*str, NULL), len * sizeof(WCHAR));
+    return buffer + len * sizeof(WCHAR);
+}
+
+unsigned char * __RPC_USER HSTRING_UserUnmarshal(ULONG *flags, unsigned char *buffer, HSTRING *str)
+{
+    HSTRING new = NULL;
+    ULONG len;
+    HRESULT hr;
+
+    TRACE("%s, %p, %p.\n", debugstr_user_flags(flags), buffer, str);
+
+    ALIGN_POINTER(buffer, 3);
+    len = *(ULONG *)buffer;
+    buffer += sizeof(ULONG);
+    if (len > 0x10000000) RaiseException(RPC_X_BAD_STUB_DATA, 0, 0, NULL);
+    if (len && FAILED(hr = WindowsCreateString((WCHAR *)buffer, len, &new)))
+        RaiseException(hr, 0, 0, NULL);
+    WindowsDeleteString(*str);
+    *str = new;
+    return buffer + len * sizeof(WCHAR);
+}
+
+void __RPC_USER HSTRING_UserFree(ULONG *flags, HSTRING *str)
+{
+    TRACE("%s, %p.\n", debugstr_user_flags(flags), str);
+
+    WindowsDeleteString(*str);
+    *str = NULL;
+}
