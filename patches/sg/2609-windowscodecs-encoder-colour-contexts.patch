+/* Join the APP2 "ICC_PROFILE" segments into one profile; an incomplete,
+ * inconsistent or duplicated set means there is no usable profile. */
+static void jpeg_decoder_collect_icc_profile(struct jpeg_decoder *This)
+{
+    jpeg_saved_marker_ptr marker, chunks[256] = {0};
+    UINT count = 0, total = 0, i;
+    BYTE *profile;
+
+    for (marker = This->cinfo.marker_list; marker; marker = marker->next)
+    {
+        UINT seq, num;
+
+        if (marker->marker != JPEG_APP0 + 2 || marker->data_length < 14 ||
+            memcmp(marker->data, "ICC_PROFILE", 12))
+            continue;
+
+        seq = marker->data[12];
+        num = marker->data[13];
+#ifdef SG_MUTANT_ICC_JPEG_FILE_ORDER
+        for (seq = 1; seq < 255 && chunks[seq]; seq++) ;
