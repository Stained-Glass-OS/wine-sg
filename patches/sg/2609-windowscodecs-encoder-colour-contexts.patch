--- a/dlls/windowscodecs/colorcontext.c
+++ b/dlls/windowscodecs/colorcontext.c
@@ -273,3 +273,47 @@ HRESULT ColorContext_Create(IWICColorContext **colorcontext)
 
     return S_OK;
 }
+
+/* Validate the contexts handed to SetColorContexts() of an encoder and pick the
+ * profile to embed: the first context that carries profile bytes (a container
+ * holds one profile; Exif colour space contexts have no bytes to embed).
+ * *profile is a malloc'd copy or NULL when there is none. */
+HRESULT ColorContext_CollectProfile(UINT count, IWICColorContext **contexts, BYTE **profile, UINT *len)
+{
+    UINT i;
+
+    *profile = NULL;
+    *len = 0;
+
+    if (count && !contexts) return E_INVALIDARG;
+
+    for (i = 0; i < count; i++)
+    {
+        WICColorContextType type;
+        UINT size;
+        HRESULT hr;
+
+        if (!contexts[i]) return E_INVALIDARG;
+
+        hr = IWICColorContext_GetType(contexts[i], &type);
+        if (FAILED(hr)) return hr;
+        if (type == WICColorContextUninitialized) return WINCODEC_ERR_NOTINITIALIZED;
+        if (type != WICColorContextProfile || *profile) continue;
+
+        hr = IWICColorContext_GetProfileBytes(contexts[i], 0, NULL, &size);
+        if (FAILED(hr)) return hr;
+        if (!size) continue;
+
+        if (!(*profile = malloc(size))) return E_OUTOFMEMORY;
+        hr = IWICColorContext_GetProfileBytes(contexts[i], size, *profile, len);
+        if (FAILED(hr))
+        {
+            free(*profile);
+            *profile = NULL;
+            *len = 0;
+            return hr;
+        }
+    }
+
+    return S_OK;
+}
