From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscoree: ICorConfiguration, legacy v2 activation policy (3644)

mscoree: ICorConfiguration, useLegacyV2RuntimeActivationPolicy
---
diff --git a/dlls/mscoree/config.c b/dlls/mscoree/config.c
index 20281f7..29a943b 100644
--- a/dlls/mscoree/config.c
+++ b/dlls/mscoree/config.c
@@ -425,8 +425,13 @@ static HRESULT parse_startup(ConfigFileHandler *This, ISAXAttributes *pAttr)
     HRESULT hr;
 
     hr = ISAXAttributes_getValueFromName(pAttr, empty, 0, legacy, lstrlenW(legacy), &value, &value_size);
-    if (SUCCEEDED(hr))
-        FIXME("useLegacyV2RuntimeActivationPolicy=%s not implemented\n", debugstr_wn(value, value_size));
+    if (SUCCEEDED(hr) && value)
+    {
+        static const WCHAR trueW[] = {'t','r','u','e',0};
+
+        TRACE("useLegacyV2RuntimeActivationPolicy=%s\n", debugstr_wn(value, value_size));
+        This->result->legacy_v2_policy = value_size == 4 && !_wcsnicmp(value, trueW, 4);
+    }
     hr = S_OK;
 
     return hr;
@@ -709,6 +714,7 @@ static const struct ISAXErrorHandlerVtbl ConfigFileHandlerErrorVtbl =
 static void init_config(parsed_config_file *config)
 {
     list_init(&config->supported_runtimes);
+    config->legacy_v2_policy = FALSE;
     config->private_path = NULL;
 }
 
diff --git a/dlls/mscoree/corruntimehost.c b/dlls/mscoree/corruntimehost.c
index cc1205e..d3128ce 100644
--- a/dlls/mscoree/corruntimehost.c
+++ b/dlls/mscoree/corruntimehost.c
@@ -592,12 +592,100 @@ static HRESULT WINAPI corruntimehost_MapFile(
     return E_NOTIMPL;
 }
 
+/* ICorConfiguration: a process wide object that remembers what the host handed in. */
+struct cor_configuration
+{
+    ICorConfiguration ICorConfiguration_iface;
+    IGCThreadControl *gc_thread_control;
+    IGCHostControl *gc_host_control;
+    IDebuggerThreadControl *debugger_thread_control;
+    DWORD special_threads[16];
+    unsigned int special_thread_count;
+};
+
+static struct cor_configuration global_cor_configuration;
+
+static HRESULT WINAPI cor_configuration_QueryInterface(ICorConfiguration *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_ICorConfiguration))
+    {
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI cor_configuration_AddRef(ICorConfiguration *iface) { return 2; }
+static ULONG WINAPI cor_configuration_Release(ICorConfiguration *iface) { return 1; }
+
+static void cor_config_replace(IUnknown **slot, IUnknown *new)
+{
+    if (new) IUnknown_AddRef(new);
+    if (*slot) IUnknown_Release(*slot);
+    *slot = new;
+}
+
+static HRESULT WINAPI cor_configuration_SetGCThreadControl(ICorConfiguration *iface, IGCThreadControl *control)
+{
+    TRACE("(%p)\n", control);
+    if (!control) return E_INVALIDARG;
+    cor_config_replace((IUnknown **)&global_cor_configuration.gc_thread_control, (IUnknown *)control);
+    return S_OK;
+}
+
+static HRESULT WINAPI cor_configuration_SetGCHostControl(ICorConfiguration *iface, IGCHostControl *control)
+{
+    TRACE("(%p)\n", control);
+    if (!control) return E_INVALIDARG;
+    cor_config_replace((IUnknown **)&global_cor_configuration.gc_host_control, (IUnknown *)control);
+    return S_OK;
+}
+
+static HRESULT WINAPI cor_configuration_SetDebuggerThreadControl(ICorConfiguration *iface,
+        IDebuggerThreadControl *control)
+{
+    TRACE("(%p)\n", control);
+    if (!control) return E_INVALIDARG;
+    cor_config_replace((IUnknown **)&global_cor_configuration.debugger_thread_control, (IUnknown *)control);
+    return S_OK;
+}
+
+static HRESULT WINAPI cor_configuration_AddDebuggerSpecialThread(ICorConfiguration *iface, DWORD thread_id)
+{
+    struct cor_configuration *c = &global_cor_configuration;
+
+    TRACE("(%lu)\n", thread_id);
+#ifdef SG_MUTANT_COR_CONFIG
+    return E_FAIL;
+#endif
+    if (c->special_thread_count < ARRAY_SIZE(c->special_threads))
+        c->special_threads[c->special_thread_count++] = thread_id;
+    return S_OK;
+}
+
+static const ICorConfigurationVtbl cor_configuration_vtbl =
+{
+    cor_configuration_QueryInterface,
+    cor_configuration_AddRef,
+    cor_configuration_Release,
+    cor_configuration_SetGCThreadControl,
+    cor_configuration_SetGCHostControl,
+    cor_configuration_SetDebuggerThreadControl,
+    cor_configuration_AddDebuggerSpecialThread,
+};
+
 static HRESULT WINAPI corruntimehost_GetConfiguration(
     ICorRuntimeHost* iface,
     ICorConfiguration **pConfiguration)
 {
-    FIXME("stub %p\n", iface);
-    return E_NOTIMPL;
+    TRACE("(%p, %p)\n", iface, pConfiguration);
+
+    if (!pConfiguration)
+        return E_POINTER;
+    global_cor_configuration.ICorConfiguration_iface.lpVtbl = &cor_configuration_vtbl;
+    *pConfiguration = &global_cor_configuration.ICorConfiguration_iface;
+    return S_OK;
 }
 
 static HRESULT WINAPI corruntimehost_Start(
diff --git a/dlls/mscoree/metahost.c b/dlls/mscoree/metahost.c
index 2027ea6..adf4288 100644
--- a/dlls/mscoree/metahost.c
+++ b/dlls/mscoree/metahost.c
@@ -2034,9 +2034,9 @@ done:
     return result;
 }
 
-HRESULT get_runtime_info(LPCWSTR exefile, LPCWSTR version, LPCWSTR config_file,
+static HRESULT get_runtime_info_inner(LPCWSTR exefile, LPCWSTR version, LPCWSTR config_file,
     IStream *config_stream, DWORD startup_flags, DWORD runtimeinfo_flags,
-    BOOL legacy, ICLRRuntimeInfo **result)
+    BOOL legacy, BOOL *legacy_policy, ICLRRuntimeInfo **result)
 {
     static const WCHAR dotconfig[] = {'.','c','o','n','f','i','g',0};
     static const DWORD supported_startup_flags = 0;
@@ -2076,6 +2076,8 @@ HRESULT get_runtime_info(LPCWSTR exefile, LPCWSTR version, LPCWSTR config_file,
         if (SUCCEEDED(hr))
         {
             supported_runtime *entry;
+
+            *legacy_policy = parsed_config.legacy_v2_policy;
             LIST_FOR_EACH_ENTRY(entry, &parsed_config.supported_runtimes, supported_runtime, entry)
             {
                 hr = get_runtime(entry->version, TRUE, &IID_ICLRRuntimeInfo, (void**)result);
@@ -2169,3 +2171,21 @@ HRESULT get_runtime_info(LPCWSTR exefile, LPCWSTR version, LPCWSTR config_file,
 
     return CLR_E_SHIM_RUNTIME;
 }
+
+/* A config file asking for the legacy v2 activation policy makes the runtime that gets selected the one
+ * that legacy (v2 era) activation binds to. */
+HRESULT get_runtime_info(LPCWSTR exefile, LPCWSTR version, LPCWSTR config_file,
+    IStream *config_stream, DWORD startup_flags, DWORD runtimeinfo_flags,
+    BOOL legacy, ICLRRuntimeInfo **result)
+{
+    BOOL legacy_policy = FALSE;
+    HRESULT hr;
+
+    hr = get_runtime_info_inner(exefile, version, config_file, config_stream, startup_flags, runtimeinfo_flags,
+            legacy, &legacy_policy, result);
+#ifndef SG_MUTANT_LEGACY_POLICY
+    if (SUCCEEDED(hr) && legacy_policy)
+        ICLRRuntimeInfo_BindAsLegacyV2Runtime(*result);
+#endif
+    return hr;
+}
diff --git a/dlls/mscoree/mscoree_private.h b/dlls/mscoree/mscoree_private.h
index 831d34e..f9a0c3e 100644
--- a/dlls/mscoree/mscoree_private.h
+++ b/dlls/mscoree/mscoree_private.h
@@ -122,6 +122,7 @@ typedef struct parsed_config_file
 {
     struct list supported_runtimes;
     LPWSTR private_path;
+    BOOL legacy_v2_policy; /* <startup useLegacyV2RuntimeActivationPolicy="true"> */
 } parsed_config_file;
 
 typedef struct supported_runtime
