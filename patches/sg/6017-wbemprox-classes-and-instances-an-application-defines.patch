@@ -690,8 +737,13 @@ static HRESULT WINAPI wbem_services_DeleteInstance(
     IWbemContext *pCtx,
     IWbemCallResult **ppCallResult )
 {
-    FIXME("\n");
-    return WBEM_E_FAILED;
+    struct wbem_services *services = impl_from_IWbemServices( iface );
+
+    TRACE( "%p, %s, %#lx, %p, %p\n", iface, debugstr_w(strObjectPath), lFlags, pCtx, ppCallResult );
+
+    if (ppCallResult) *ppCallResult = NULL;
+    if (!strObjectPath) return WBEM_E_INVALID_PARAMETER;
+    return delete_user_instance( services->ns, strObjectPath );
 }
 
