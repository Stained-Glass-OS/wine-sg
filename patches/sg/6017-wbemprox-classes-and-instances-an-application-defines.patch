 };
 
 static inline struct class_object *impl_from_IWbemClassObject(
@@ -444,6 +445,7 @@ HRESULT create_class_only_object( IEnumWbemClassObject *iter, enum wbm_namespace
     table = get_view_table( ec->query->view, 0 );
     if (!(record = create_record( table ))) return E_OUTOFMEMORY;
     if (FAILED(hr = create_class_object( ns, table->name, iter, 0, record, obj ))) destroy_record( record );
+    else impl_from_IWbemClassObject( *obj )->is_class = TRUE;
     return hr;
 }
 
@@ -743,6 +745,44 @@ static HRESULT WINAPI class_object_Put(
         UINT index;
         HRESULT hr;
 
+        /* Stained Glass OS: a new class takes its name and its properties */
+        if (co->record->table->flags & TABLE_FLAG_SPAWNED)
+        {
+            if (!wszName) return WBEM_E_INVALID_PARAMETER;
+            if (!wcsicmp( wszName, L"__CLASS" )) return set_spawned_name( co->record->table, pVal );
+            if (wszName[0] == '_' && wszName[1] == '_') return WBEM_E_READ_ONLY;
+            if (get_column_index( co->record->table, wszName, &index ) != S_OK)
+            {
+                CIMTYPE type = Type;
+
+                if (!type && pVal)
+                {
+                    switch (V_VT( pVal ))
+                    {
+                    case VT_BSTR: type = CIM_STRING; break;
+                    case VT_BOOL: type = CIM_BOOLEAN; break;
+                    case VT_I1:   type = CIM_SINT8; break;
+                    case VT_UI1:  type = CIM_UINT8; break;
+                    case VT_I2:   type = CIM_SINT16; break;
+                    case VT_UI2:  type = CIM_UINT16; break;
+                    case VT_I4:   type = CIM_SINT32; break;
+                    case VT_UI4:  type = CIM_UINT32; break;
+                    case VT_I8:   type = CIM_SINT64; break;
+                    case VT_UI8:  type = CIM_UINT64; break;
+                    default: break;
+                    }
+                }
+                if (!type) return WBEM_E_INVALID_PROPERTY_TYPE;
+#ifndef SG_MUTANT_WMI_NO_NEW_PROPS
+                if ((hr = add_spawned_property( co->record->table, co->record, wszName, type )) != S_OK) return hr;
+#else
+                return WBEM_E_NOT_FOUND;
+#endif
+                index = co->record->count - 1;
+            }
+            if (!pVal || V_VT( pVal ) == VT_NULL || V_VT( pVal ) == VT_EMPTY) return S_OK;
+            return record_set_value( co->record, index, pVal );
+        }
         if ((hr = get_column_index( co->record->table, wszName, &index )) != S_OK) return hr;
         return record_set_value( co->record, index, pVal );
     }
@@ -987,6 +1027,14 @@ static HRESULT WINAPI class_object_GetPropertyQualifierSet(
 
     TRACE("%p, %s, %p\n", iface, debugstr_w(wszProperty), ppQualSet);
 
+    /* Stained Glass OS: a new class's key is given through its qualifier sets */
+    if (co->record && (co->record->table->flags & TABLE_FLAG_SPAWNED))
+    {
+        UINT column;
+        if (!wszProperty || get_column_index( co->record->table, wszProperty, &column ) != S_OK)
+            return WBEM_E_NOT_FOUND;
+        return WbemQualifierSet_create_table( co->ns, co->record->table, wszProperty, (void **)ppQualSet );
+    }
     return WbemQualifierSet_create( co->ns, co->name, wszProperty, (void **)ppQualSet );
 }
 
@@ -1076,8 +1124,41 @@ static HRESULT WINAPI class_object_SpawnDerivedClass(
     LONG lFlags,
     IWbemClassObject **ppNewClass )
 {
-    FIXME( "%p, %#lx, %p\n", iface, lFlags, ppNewClass );
-    return E_NOTIMPL;
+    struct class_object *co = impl_from_IWbemClassObject( iface );
+    struct table *table;
+
+    TRACE( "%p, %#lx, %p\n", iface, lFlags, ppNewClass );
+
+    if (!ppNewClass || lFlags) return WBEM_E_INVALID_PARAMETER;
+    *ppNewClass = NULL;
+    /* Stained Glass OS: a class derives from a class that is stored (an object of the class
+     * stands for it: GetObject of a class with instances gives its first instance here) */
+    if (!(co->iter || co->record)) return WBEM_E_INVALID_OPERATION;
+    table = class_object_table( co );
+    if (!table || is_unnamed_class( table )) return WBEM_E_INVALID_OPERATION;
+    return spawn_derived_class( co->ns, table, ppNewClass );
+}
+
+/* Stained Glass OS: what an object of ours is, for IWbemServices::PutClass/PutInstance */
+HRESULT get_class_object_definition( IWbemClassObject *obj, struct table **table, struct record **record, UINT *row,
+                                     BOOL *is_class )
+{
+    struct class_object *co;
+
+    if (!obj || obj->lpVtbl != &class_object_vtbl) return WBEM_E_INVALID_PARAMETER;
+    co = impl_from_IWbemClassObject( obj );
+    if (!co->iter && !co->record) return WBEM_E_INVALID_OBJECT;
+    *table = class_object_table( co );
+    *record = co->record;
+    *row = 0;
+    if (!co->record)
+    {
+        struct view *view = impl_from_IEnumWbemClassObject( co->iter )->query->view;
+        if (co->index >= view->result_count) return WBEM_E_INVALID_OBJECT;
+        *row = view->result[co->index];
+    }
+    *is_class = co->is_class;
+    return S_OK;
 }
 
 static HRESULT WINAPI class_object_SpawnInstance(
@@ -1555,6 +1636,7 @@ HRESULT create_class_object( enum wbm_namespace ns, const WCHAR *name, IEnumWbem
     co->enum_flags     = 0;
     co->record         = record;
     co->ns             = ns;
+    co->is_class       = FALSE;
     init_client_security( &co->client_security, (IUnknown *)&co->IWbemClassObject_iface );
     if (iter) IEnumWbemClassObject_AddRef( iter );
 
diff --git a/dlls/wbemprox/qualifier.c b/dlls/wbemprox/qualifier.c
index 6f738ca..8aac7a3 100644
--- a/dlls/wbemprox/qualifier.c
+++ b/dlls/wbemprox/qualifier.c
@@ -48,6 +48,7 @@ struct qualifier_set
     struct list qualifiers; /* what the set holds: the class's own, plus the changes made through the set */
     struct qualifier *cursor; /* enumeration position */
     BOOL enumerating;
+    struct table *table; /* Stained Glass OS: the new class (SpawnDerivedClass) the set is of */
 };
 
 static inline struct qualifier_set *impl_from_IWbemQualifierSet(
@@ -114,6 +115,7 @@ static ULONG WINAPI qualifier_set_Release(
 
         TRACE("destroying %p\n", set);
         LIST_FOR_EACH_ENTRY_SAFE( q, next, &set->qualifiers, struct qualifier, entry ) free_qualifier( q );
+        if (set->table) release_table( set->table );
         free( set->class );
         free( set->member );
         InterlockedDecrement( &object_count );
@@ -196,14 +198,12 @@ static const WCHAR *cimtype_name( CIMTYPE type )
 
 /* qualifiers that follow from the shape of the class: a key property is [key], a method is [implemented], the
  * classes that are backed by the provider are [dynamic] */
-static HRESULT add_implied_qualifiers( struct qualifier_set *set )
+static HRESULT add_table_qualifiers( struct qualifier_set *set, struct table *table )
 {
-    struct table *table = find_table( set->ns, set->class );
     VARIANT v;
     UINT column;
     HRESULT hr = S_OK;
 
-    if (!table) return S_OK;
     V_VT( &v ) = VT_BOOL;
     V_BOOL( &v ) = VARIANT_TRUE;
     if (!set->member)
@@ -235,6 +235,18 @@ static HRESULT add_implied_qualifiers( struct qualifier_set *set )
     return hr;
 }
 
+/* Stained Glass OS: the table is released again (it stayed held, and with it its lock) */
+static HRESULT add_implied_qualifiers( struct qualifier_set *set )
+{
+    struct table *table = set->table ? grab_table( set->table ) : find_table( set->ns, set->class );
+    HRESULT hr;
+
+    if (!table) return S_OK;
+    hr = add_table_qualifiers( set, table );
+    release_table( table );
+    return hr;
+}
+
 static HRESULT load_qualifiers( struct qualifier_set *set )
 {
     IEnumWbemClassObject *iter;
@@ -315,6 +327,25 @@ static HRESULT WINAPI qualifier_set_Put(
     TRACE( "%p, %s, %p, %ld\n", iface, debugstr_w(wszName), pVal, lFlavor );
 
     if (!wszName || !pVal) return WBEM_E_INVALID_PARAMETER;
+    /* Stained Glass OS: [key] makes a property of a new class a key */
+    if (set->table && set->member && !wcsicmp( wszName, L"key" ) && V_VT( pVal ) == VT_BOOL)
+    {
+        UINT column;
+        struct column *col;
+
+        if (get_column_index( set->table, set->member, &column ) != S_OK) return WBEM_E_NOT_FOUND;
+        col = (struct column *)&set->table->columns[column];
+#ifndef SG_MUTANT_WMI_KEY_IGNORED
+        if (V_BOOL( pVal )) col->type |= COL_FLAG_KEY;
+        else col->type &= ~COL_FLAG_KEY;
+#endif
+        if ((q = find_qualifier( set, wszName )))
+        {
+            q->value = *pVal;
+            return S_OK;
+        }
+        return add_qualifier( set, wszName, pVal, lFlavor );
+    }
     /* the origin of a qualifier is not the caller's to set */
     if (lFlavor & ~(WBEM_FLAVOR_MASK_PROPAGATION | WBEM_FLAVOR_MASK_PERMISSIONS | WBEM_FLAVOR_MASK_AMENDED))
         return WBEM_E_INVALID_PARAMETER;
@@ -483,6 +514,35 @@ static const IWbemQualifierSetVtbl qualifier_set_vtbl =
     qualifier_set_EndEnumeration
 };
 
+/* Stained Glass OS: the qualifiers of a property of a new class (SpawnDerivedClass) */
+HRESULT WbemQualifierSet_create_table( enum wbm_namespace ns, struct table *table, const WCHAR *member, LPVOID *ppObj )
+{
+    struct qualifier_set *set;
+    HRESULT hr;
+
+    if (!(set = calloc( 1, sizeof(*set) ))) return E_OUTOFMEMORY;
+    set->IWbemQualifierSet_iface.lpVtbl = &qualifier_set_vtbl;
+    list_init( &set->qualifiers );
+    set->ns = ns;
+    set->refs = 1;
+    if (!(set->class = wcsdup( table->name )) || (member && !(set->member = wcsdup( member ))) ||
+        !(set->table = grab_table( table )))
+    {
+        free( set->class );
+        free( set->member );
+        free( set );
+        return E_OUTOFMEMORY;
+    }
+    InterlockedIncrement( &object_count );
+    if (FAILED(hr = add_implied_qualifiers( set )))
+    {
+        qualifier_set_Release( &set->IWbemQualifierSet_iface );
+        return hr;
+    }
+    *ppObj = &set->IWbemQualifierSet_iface;
+    return S_OK;
+}
+
 HRESULT WbemQualifierSet_create( enum wbm_namespace ns, const WCHAR *class, const WCHAR *member, LPVOID *ppObj )
 {
     struct qualifier_set *set;
diff --git a/dlls/wbemprox/query.c b/dlls/wbemprox/query.c
