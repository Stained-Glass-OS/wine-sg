From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wbemprox: classes and instances an application defines (6017)

IWbemClassObject::SpawnDerivedClass and IWbemServices::GetObject of no
path give a new class to fill in (Put of __CLASS and of new properties, a
[key] qualifier); IWbemServices::PutClass stores it, PutInstance stores an
instance of it, DeleteInstance and DeleteClass remove them. They are kept
under HKLM\Software\Wine\WBEM\<namespace>\Classes, so other processes see
them, and writing there needs an administrator as the repository does
(COM-WMI).
---
diff --git a/dlls/wbemprox/Makefile.in b/dlls/wbemprox/Makefile.in
index 53835c7..3edfa86 100644
--- a/dlls/wbemprox/Makefile.in
+++ b/dlls/wbemprox/Makefile.in
@@ -14,6 +14,7 @@ SOURCES = \
 	services.c \
 	sysrestore.c \
 	table.c \
+	userclass.c \
 	wbemlocator.c \
 	wbemprox.idl \
 	wql.y
diff --git a/dlls/wbemprox/builtin.c b/dlls/wbemprox/builtin.c
index 137e819..a5ede2b 100644
--- a/dlls/wbemprox/builtin.c
+++ b/dlls/wbemprox/builtin.c
@@ -6173,5 +6173,21 @@ const WCHAR *get_class_parent( const WCHAR *class )
     if (!class) return NULL;
     for (i = 0; i < ARRAY_SIZE(class_parents); i++)
         if (!wcsicmp( class_parents[i].class, class )) return class_parents[i].parent;
-    return NULL;
+    /* Stained Glass OS: a class an application defined */
+    return get_user_class_parent( class );
+}
+
+const WCHAR *get_namespace_name( enum wbm_namespace ns )
+{
+    return ns < WBEMPROX_NAMESPACE_LAST ? builtin_namespaces[ns].name : NULL;
+}
+
+BOOL is_builtin_class( enum wbm_namespace ns, const WCHAR *name )
+{
+    unsigned int i;
+
+    if (ns >= WBEMPROX_NAMESPACE_LAST) return FALSE;
+    for (i = 0; i < builtin_namespaces[ns].table_count; i++)
+        if (!wcsicmp( builtin_namespaces[ns].tables[i].name, name )) return TRUE;
+    return FALSE;
 }
