--- a/dlls/wbemprox/services.c
+++ b/dlls/wbemprox/services.c
@@ -578,8 +578,15 @@ static HRESULT WINAPI wbem_services_GetObject(
 
     if (lFlags) FIXME( "unsupported flags %#lx\n", lFlags );
 
+    /* Stained Glass OS: an empty class, to define a class of its own */
     if (!strObjectPath || !strObjectPath[0])
+    {
+        if (!ppObject) return WBEM_E_INVALID_PARAMETER;
+#ifndef SG_MUTANT_WMI_EMPTY_CLASS_OLD
+        if (spawn_derived_class( services->ns, NULL, ppObject ) == S_OK) return S_OK;
+#endif
         return create_class_object( services->ns, NULL, NULL, 0, NULL, ppObject );
+    }
 
     return get_object( services->ns, strObjectPath, ppObject );
 }
@@ -602,8 +609,25 @@ static HRESULT WINAPI wbem_services_PutClass(
     IWbemContext *pCtx,
     IWbemCallResult **ppCallResult )
 {
-    FIXME("\n");
-    return WBEM_E_FAILED;
+    struct wbem_services *services = impl_from_IWbemServices( iface );
+    struct record *record;
+    struct table *table;
+    BOOL is_class;
+    UINT row;
+    HRESULT hr;
+
+    TRACE( "%p, %p, %#lx, %p, %p\n", iface, pObject, lFlags, pCtx, ppCallResult );
+
+    /* Stained Glass OS: a class an application defines */
+    if (ppCallResult) *ppCallResult = NULL;
+    if (!pObject) return WBEM_E_INVALID_PARAMETER;
+    if (lFlags & ~(WBEM_FLAG_UPDATE_ONLY | WBEM_FLAG_CREATE_ONLY | WBEM_MASK_UPDATE_MODE | WBEM_FLAG_RETURN_IMMEDIATELY |
+                   WBEM_FLAG_USE_AMENDED_QUALIFIERS | WBEM_FLAG_ADVISORY))
+        return WBEM_E_INVALID_PARAMETER;
+    if ((hr = get_class_object_definition( pObject, &table, &record, &row, &is_class )) != S_OK) return hr;
+    if (!(table->flags & (TABLE_FLAG_SPAWNED | TABLE_FLAG_USER)) && !is_builtin_class( services->ns, table->name ))
+        return WBEM_E_INVALID_OBJECT;
+    return put_user_class( services->ns, table, lFlags );
 }
 
 static HRESULT WINAPI wbem_services_PutClassAsync(
@@ -624,8 +648,13 @@ static HRESULT WINAPI wbem_services_DeleteClass(
     IWbemContext *pCtx,
     IWbemCallResult **ppCallResult )
 {
-    FIXME("\n");
-    return WBEM_E_FAILED;
+    struct wbem_services *services = impl_from_IWbemServices( iface );
+
+    TRACE( "%p, %s, %#lx, %p, %p\n", iface, debugstr_w(strClass), lFlags, pCtx, ppCallResult );
+
+    if (ppCallResult) *ppCallResult = NULL;
+    if (!strClass) return WBEM_E_INVALID_PARAMETER;
+    return delete_user_class( services->ns, strClass );
 }
 
 static HRESULT WINAPI wbem_services_DeleteClassAsync(
@@ -668,8 +697,26 @@ static HRESULT WINAPI wbem_services_PutInstance(
     IWbemContext *pCtx,
     IWbemCallResult **ppCallResult )
 {
-    FIXME("\n");
-    return WBEM_E_FAILED;
+    struct wbem_services *services = impl_from_IWbemServices( iface );
+    struct record *record;
+    struct table *table;
+    BOOL is_class;
+    UINT row;
+    HRESULT hr;
+
+    TRACE( "%p, %p, %#lx, %p, %p\n", iface, pInst, lFlags, pCtx, ppCallResult );
+
+    /* Stained Glass OS: an instance of a class an application defined */
+    if (ppCallResult) *ppCallResult = NULL;
+    if (!pInst) return WBEM_E_INVALID_PARAMETER;
+    if ((hr = get_class_object_definition( pInst, &table, &record, &row, &is_class )) != S_OK) return hr;
+    if (table->flags & TABLE_FLAG_SPAWNED) return WBEM_E_INVALID_OBJECT; /* a class, not stored yet */
+    if (!(table->flags & TABLE_FLAG_USER))
+    {
+        FIXME( "instances of %s are the provider's\n", debugstr_w(table->name) );
+        return WBEM_E_PROVIDER_NOT_CAPABLE;
+    }
+    return put_user_instance( services->ns, table, record, row, lFlags & (WBEM_FLAG_UPDATE_ONLY | WBEM_FLAG_CREATE_ONLY) );
 }
 
