+/* Stained Glass OS: the superclass of a class an application defined is its table's */
+static const WCHAR *table_parent( const struct table *table )
+{
+    return table->parent ? table->parent : get_class_parent( table->name );
+}
+
 static HRESULT get_system_propval( const struct view *view, UINT table_index, UINT result_index, const WCHAR *name,
                                    VARIANT *ret, CIMTYPE *type, LONG *flavor )
 {
@@ -978,7 +984,9 @@ static HRESULT get_system_propval( const struct view *view, UINT table_index, UI
         if (ret)
         {
             V_VT( ret ) = VT_BSTR;
-            V_BSTR( ret ) = SysAllocString( view->table[table_index]->name );
+            /* a new class has no name until it is given one */
+            if (is_unnamed_class( view->table[table_index] )) V_VT( ret ) = VT_NULL;
+            else V_BSTR( ret ) = SysAllocString( view->table[table_index]->name );
         }
         if (type) *type = CIM_STRING;
         return S_OK;
@@ -988,7 +996,8 @@ static HRESULT get_system_propval( const struct view *view, UINT table_index, UI
         if (ret)
         {
             V_VT( ret ) = VT_I4;
-            V_I4( ret ) = view->result_count ? WBEM_GENUS_INSTANCE : WBEM_GENUS_CLASS; /* FIXME */
+            V_I4( ret ) = view->result_count && !(view->table[table_index]->flags & TABLE_FLAG_SPAWNED) ?
+                          WBEM_GENUS_INSTANCE : WBEM_GENUS_CLASS; /* FIXME */
         }
         if (type) *type = CIM_SINT32;
         return S_OK;
@@ -1051,7 +1060,7 @@ static HRESULT get_system_propval( const struct view *view, UINT table_index, UI
     {
         if (ret)
         {
-            const WCHAR *parent = get_class_parent( view->table[table_index]->name );
+            const WCHAR *parent = table_parent( view->table[table_index] );
             SAFEARRAY *sa;
             LONG i = 0, count = 0;
 
@@ -1060,7 +1069,7 @@ static HRESULT get_system_propval( const struct view *view, UINT table_index, UI
             count = 0;
 #endif
             if (!(sa = SafeArrayCreateVector( VT_BSTR, 0, count ))) return E_OUTOFMEMORY;
-            for (parent = get_class_parent( view->table[table_index]->name ); parent && count; parent = get_class_parent( parent ), i++)
+            for (parent = table_parent( view->table[table_index] ); parent && count; parent = get_class_parent( parent ), i++)
             {
                 BSTR str = SysAllocString( parent );
                 HRESULT hr = str ? SafeArrayPutElement( sa, &i, str ) : E_OUTOFMEMORY;
@@ -1081,7 +1090,7 @@ static HRESULT get_system_propval( const struct view *view, UINT table_index, UI
     {
         if (ret)
         {
-            const WCHAR *parent = get_class_parent( view->table[table_index]->name );
+            const WCHAR *parent = table_parent( view->table[table_index] );
             V_VT( ret ) = VT_BSTR;
             V_BSTR( ret ) = parent ? SysAllocString( parent ) : NULL;
             if (!V_BSTR( ret )) V_VT( ret ) = VT_NULL;
@@ -1094,6 +1103,7 @@ static HRESULT get_system_propval( const struct view *view, UINT table_index, UI
         if (ret)
         {
             const WCHAR *dynasty = view->table[table_index]->name, *parent;
+            if ((parent = table_parent( view->table[table_index] ))) dynasty = parent;
             while ((parent = get_class_parent( dynasty ))) dynasty = parent;
             V_VT( ret ) = VT_BSTR;
             V_BSTR( ret ) = SysAllocString( dynasty );
diff --git a/dlls/wbemprox/services.c b/dlls/wbemprox/services.c
