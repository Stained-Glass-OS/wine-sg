+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include <stdio.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "objbase.h"
+#include "wbemcli.h"
+
+#include "wine/debug.h"
+#include "wbemprox_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wbemprox);
+
+#define SPAWNED_PREFIX L"__SG_SPAWNED_"
+#define NS_SHIFT 16
+
+static CRITICAL_SECTION user_cs;
+static CRITICAL_SECTION_DEBUG user_cs_debug =
+{
+    0, 0, &user_cs,
+    { &user_cs_debug.ProcessLocksList, &user_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": user_cs") }
+};
+static CRITICAL_SECTION user_cs = { &user_cs_debug, -1, 0, 0, 0, 0 };
+
+static HRESULT reg_error( LSTATUS err )
+{
+    switch (err)
+    {
+    case ERROR_SUCCESS:        return S_OK;
+    case ERROR_ACCESS_DENIED:  return WBEM_E_ACCESS_DENIED;
+    case ERROR_FILE_NOT_FOUND: return WBEM_E_NOT_FOUND;
+    default:                   return WBEM_E_FAILED;
+    }
+}
+
+static WCHAR *classes_key_path( enum wbm_namespace ns, const WCHAR *class )
+{
+    const WCHAR *nsname = get_namespace_name( ns );
+    WCHAR *path;
+    int len;
+
+    if (!nsname) return NULL;
+    len = 64 + lstrlenW( nsname ) + (class ? lstrlenW( class ) : 0);
+    if (!(path = malloc( len * sizeof(WCHAR) ))) return NULL;
+    swprintf( path, len, L"Software\\Wine\\WBEM\\%s\\Classes%s%s", nsname, class ? L"\\" : L"", class ? class : L"" );
+    return path;
+}
+
+static BOOL is_valid_name( const WCHAR *name )
+{
+    const WCHAR *p;
+
+    if (!name || !name[0] || (name[0] == '_' && name[1] == '_')) return FALSE;
+    if (name[0] >= '0' && name[0] <= '9') return FALSE;
+    for (p = name; *p; p++)
+        if (!(*p == '_' || (*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || *p >= 0x80))
+            return FALSE;
+    return TRUE;
+}
+
+/* the property types a stored class can have */
+static BOOL is_user_type( CIMTYPE type )
+{
+    switch (type)
+    {
+    case CIM_BOOLEAN: case CIM_SINT8: case CIM_UINT8: case CIM_SINT16: case CIM_UINT16:
+    case CIM_SINT32: case CIM_UINT32: case CIM_SINT64: case CIM_UINT64:
+    case CIM_STRING: case CIM_DATETIME: case CIM_REFERENCE:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+static BOOL is_string_type( CIMTYPE type )
+{
+    return type == CIM_STRING || type == CIM_DATETIME || type == CIM_REFERENCE;
+}
+
+/* the superclasses of the stored classes, by name, for get_class_parent (the strings stay) */
+struct user_parent
+{
+    struct list entry;
+    WCHAR *class;
+    WCHAR *parent;
+};
+static struct list user_parents = LIST_INIT( user_parents );
+
+static void remember_parent( const WCHAR *class, const WCHAR *parent )
+{
+    struct user_parent *p;
+
+    EnterCriticalSection( &user_cs );
+    LIST_FOR_EACH_ENTRY( p, &user_parents, struct user_parent, entry )
+    {
+        if (wcsicmp( p->class, class )) continue;
+        if (!parent || !p->parent || wcsicmp( p->parent, parent ))
+        {
+            /* the old string may still be in use: it stays */
+            p->parent = parent ? wcsdup( parent ) : NULL;
+        }
+        LeaveCriticalSection( &user_cs );
+        return;
+    }
+    if ((p = calloc( 1, sizeof(*p) )) && (p->class = wcsdup( class )))
+    {
+        p->parent = parent ? wcsdup( parent ) : NULL;
+        list_add_tail( &user_parents, &p->entry );
+    }
+    else free( p );
+    LeaveCriticalSection( &user_cs );
+}
+
+const WCHAR *get_user_class_parent( const WCHAR *class )
+{
+    struct user_parent *p;
+    const WCHAR *ret = NULL;
+
+    EnterCriticalSection( &user_cs );
+    LIST_FOR_EACH_ENTRY( p, &user_parents, struct user_parent, entry )
+    {
+        if (!wcsicmp( p->class, class ))
+        {
+            ret = p->parent;
+            break;
+        }
+    }
+    LeaveCriticalSection( &user_cs );
+    return ret;
+}
+
+static void write_row_value( struct table *table, UINT row, UINT column, LONGLONG val )
+{
+    BYTE *ptr = table->data + row * table_row_size( table ) + table_column_offset( table, column );
+
+    switch (table->columns[column].type & COL_TYPE_MASK)
+    {
+    case CIM_BOOLEAN: *(int *)ptr = val ? -1 : 0; break; /* as the system's classes have it: VARIANT_TRUE */
+    case CIM_SINT8:
+    case CIM_UINT8:   *(UINT8 *)ptr = val; break;
+    case CIM_SINT16:
+    case CIM_UINT16:  *(UINT16 *)ptr = val; break;
+    case CIM_SINT32:
+    case CIM_UINT32:  *(UINT32 *)ptr = val; break;
+    case CIM_SINT64:
+    case CIM_UINT64:  *(UINT64 *)ptr = val; break;
+    case CIM_STRING:
+    case CIM_DATETIME:
+    case CIM_REFERENCE: *(WCHAR **)ptr = (WCHAR *)(INT_PTR)val; break;
+    default: break;
+    }
+}
+
+/* the instances, from the registry, every time the class is queried */
+static enum fill_status fill_user_class( struct table *table, const struct expr *cond )
+{
+    enum wbm_namespace ns = table->flags >> NS_SHIFT;
+    WCHAR *path, name[64];
+    HKEY key, inst;
+    DWORD i, count = 0, size;
+    UINT row = 0, row_size = table_row_size( table ), col;
+    BYTE *data;
+
+    if (!(path = classes_key_path( ns, table->name ))) return FILL_STATUS_FAILED;
+#ifdef SG_MUTANT_WMI_INSTANCES_NOT_READ
+    free( path );
+    return FILL_STATUS_UNFILTERED;
+#endif
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key ))
+    {
+        free( path );
+        return FILL_STATUS_UNFILTERED;
+    }
+    free( path );
+    if (RegOpenKeyExW( key, L"Instances", 0, KEY_READ, &inst ))
+    {
+        RegCloseKey( key );
+        return FILL_STATUS_UNFILTERED;
+    }
+    RegQueryInfoKeyW( inst, NULL, NULL, NULL, &count, NULL, NULL, NULL, NULL, NULL, NULL, NULL );
+    if (count && row_size)
+    {
+        if (!(data = calloc( count, row_size )))
+        {
+            RegCloseKey( inst );
+            RegCloseKey( key );
+            return FILL_STATUS_FAILED;
+        }
+        free( table->data );
+        table->data = data;
+        table->num_rows_allocated = count;
+        for (i = 0; i < count; i++)
+        {
+            HKEY rkey;
+
+            size = ARRAY_SIZE(name);
+            if (RegEnumKeyExW( inst, i, name, &size, NULL, NULL, NULL, NULL )) break;
+            if (RegOpenKeyExW( inst, name, 0, KEY_READ, &rkey )) continue;
+            for (col = 0; col < table->num_cols; col++)
+            {
+                CIMTYPE type = table->columns[col].type & COL_TYPE_MASK;
+                DWORD regtype, len = 0;
+
+                if (RegQueryValueExW( rkey, table->columns[col].name, NULL, &regtype, NULL, &len )) continue;
+                if (is_string_type( type ))
+                {
+                    WCHAR *str;
+                    if (regtype != REG_SZ || !(str = calloc( 1, len + sizeof(WCHAR) ))) continue;
+                    RegQueryValueExW( rkey, table->columns[col].name, NULL, NULL, (BYTE *)str, &len );
+                    write_row_value( table, row, col, (INT_PTR)str );
+                }
+                else
+                {
+                    ULONGLONG val = 0;
+                    len = sizeof(val);
+                    if (regtype != REG_QWORD ||
+                        RegQueryValueExW( rkey, table->columns[col].name, NULL, NULL, (BYTE *)&val, &len )) continue;
+                    write_row_value( table, row, col, val );
+                }
+            }
+            RegCloseKey( rkey );
+            row++;
+        }
+    }
+    table->num_rows = row;
+    RegCloseKey( inst );
+    RegCloseKey( key );
+    TRACE( "%s: %u instances\n", debugstr_w(table->name), row );
+    return FILL_STATUS_UNFILTERED;
+}
+
+/* "type:name" (the column type with its key flag, in hex) */
+static HRESULT parse_property( const WCHAR *str, struct column *col )
+{
+    WCHAR *end;
+    UINT type = wcstoul( str, &end, 16 );
+
+    if (*end != ':' || !is_valid_name( end + 1 ) || !is_user_type( type & COL_TYPE_MASK )) return WBEM_E_FAILED;
+    if (!(col->name = wcsdup( end + 1 ))) return E_OUTOFMEMORY;
+    /* the rows own their strings, and the properties of an instance can be changed */
+    col->type = (type & (COL_TYPE_MASK | COL_FLAG_KEY)) | COL_FLAG_DYNAMIC;
+    return S_OK;
+}
+
+struct table *load_user_class( enum wbm_namespace ns, const WCHAR *name )
+{
+    WCHAR *path, *props = NULL, *p, *parent = NULL, *stored_name = NULL;
+    struct column *columns = NULL;
+    struct table *table = NULL, *ret = NULL;
+    DWORD len = 0, type, count = 0, i;
+    HKEY key;
+
+    if (!is_valid_name( name ) || !(path = classes_key_path( ns, name ))) return NULL;
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key ))
+    {
+        free( path );
+        return NULL;
+    }
+    free( path );
+
+    if (RegQueryValueExW( key, L"Properties", NULL, &type, NULL, &len ) || type != REG_MULTI_SZ ||
+        !(props = calloc( 1, len + 2 * sizeof(WCHAR) )) ||
+        RegQueryValueExW( key, L"Properties", NULL, NULL, (BYTE *)props, &len )) goto done;
+    for (p = props; *p; p += lstrlenW( p ) + 1) count++;
+    if (!count || !(columns = calloc( count, sizeof(*columns) ))) goto done;
+    for (p = props, i = 0; *p; p += lstrlenW( p ) + 1, i++)
+        if (parse_property( p, &columns[i] ) != S_OK) goto done;
+
+    len = 0;
+    if (!RegQueryValueExW( key, L"Superclass", NULL, &type, NULL, &len ) && type == REG_SZ && len > sizeof(WCHAR) &&
+        (parent = calloc( 1, len + sizeof(WCHAR) )))
+        RegQueryValueExW( key, L"Superclass", NULL, NULL, (BYTE *)parent, &len );
+    /* the class's own spelling of its name */
+    len = 0;
+    if (!RegQueryValueExW( key, L"Name", NULL, &type, NULL, &len ) && type == REG_SZ &&
+        (stored_name = calloc( 1, len + sizeof(WCHAR) )))
+        RegQueryValueExW( key, L"Name", NULL, NULL, (BYTE *)stored_name, &len );
+
+    if (!(table = create_table( stored_name && !wcsicmp( stored_name, name ) ? stored_name : name,
+                                count, columns, 0, 0, NULL, fill_user_class ))) goto done;
+    columns = NULL;
+    table->flags |= TABLE_FLAG_USER | (ns << NS_SHIFT);
+    table->parent = parent;
+    parent = NULL;
+    remember_parent( table->name, table->parent );
+
+    if (add_table( ns, table )) ret = grab_table( table );
+    else
+    {
+        /* another thread loaded it */
+        free_table( table );
+        ret = find_table( ns, name );
+    }
+    table = NULL;
+    TRACE( "loaded %s\n", debugstr_w(name) );
+
+done:
+    if (columns) free_columns( columns, count );
+    free( props );
+    free( parent );
+    free( stored_name );
+    RegCloseKey( key );
+    return ret;
+}
+
+/* drop the loaded copy of a class, so that the next query reads it again */
+static void forget_user_class( enum wbm_namespace ns, const WCHAR *name )
+{
+    struct table *table;
+
+    LIST_FOR_EACH_ENTRY( table, table_list[ns], struct table, entry )
+    {
+        if (!wcsicmp( table->name, name ))
+        {
+            if (table->flags & TABLE_FLAG_USER)
+            {
+                EnterCriticalSection( &table->cs );
+                table->removed = TRUE;
+                LeaveCriticalSection( &table->cs );
+                detach_table( table );
+            }
+            return;
+        }
+    }
+}
+
+HRESULT put_user_class( enum wbm_namespace ns, const struct table *def, LONG flags )
+{
+    WCHAR *path, *props, *p;
+    DWORD len = 1, disp, i;
+    LSTATUS err;
+    HKEY key;
+
+    if (ns >= WBEMPROX_NAMESPACE_LAST) return WBEM_E_INVALID_NAMESPACE;
+    if ((flags & WBEM_FLAG_CREATE_ONLY) && (flags & WBEM_FLAG_UPDATE_ONLY)) return WBEM_E_INVALID_PARAMETER;
+    if (!def->name || !wcsnicmp( def->name, SPAWNED_PREFIX, ARRAY_SIZE(SPAWNED_PREFIX) - 1 ))
+        return WBEM_E_INVALID_OBJECT; /* no __CLASS */
+    if (!is_valid_name( def->name )) return WBEM_E_INVALID_CLASS;
+    /* the system's classes are not the application's to change */
+    if (is_builtin_class( ns, def->name ))
+        return (flags & WBEM_FLAG_CREATE_ONLY) ? WBEM_E_ALREADY_EXISTS : WBEM_E_ACCESS_DENIED;
+    if (def->parent && !wcsicmp( def->parent, def->name )) return WBEM_E_INVALID_SUPERCLASS;
+
+    for (i = 0; i < def->num_cols; i++)
+    {
+        if (def->columns[i].type & COL_FLAG_METHOD) continue;
+        if (!is_user_type( def->columns[i].type & COL_TYPE_MASK )) return WBEM_E_INVALID_PROPERTY_TYPE;
+        len += lstrlenW( def->columns[i].name ) + 10;
+    }
+    if (!(props = calloc( len, sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    for (i = 0, p = props; i < def->num_cols; i++)
+    {
+        if (def->columns[i].type & COL_FLAG_METHOD) continue;
+        p += swprintf( p, len - (p - props), L"%x:%s",
+                       def->columns[i].type & (COL_TYPE_MASK | COL_FLAG_KEY), def->columns[i].name ) + 1;
+    }
+    *p++ = 0;
+
+    if (!(path = classes_key_path( ns, def->name )))
+    {
+        free( props );
+        return E_OUTOFMEMORY;
+    }
+    EnterCriticalSection( &user_cs );
+    if ((err = RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key )) == ERROR_SUCCESS)
+    {
+        RegCloseKey( key );
+        if (flags & WBEM_FLAG_CREATE_ONLY) err = ERROR_ALREADY_EXISTS;
+    }
+    else if (flags & WBEM_FLAG_UPDATE_ONLY) err = ERROR_FILE_NOT_FOUND;
+    else err = ERROR_SUCCESS;
+    if (err == ERROR_ALREADY_EXISTS)
+    {
+        LeaveCriticalSection( &user_cs );
+        free( path );
+        free( props );
+        return WBEM_E_ALREADY_EXISTS;
+    }
+    if (!err) err = RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, &disp );
+    free( path );
+    if (!err)
+    {
+        err = RegSetValueExW( key, L"Properties", 0, REG_MULTI_SZ, (BYTE *)props, (p - props) * sizeof(WCHAR) );
+        if (!err) err = RegSetValueExW( key, L"Name", 0, REG_SZ, (const BYTE *)def->name,
+                                        (lstrlenW( def->name ) + 1) * sizeof(WCHAR) );
+        if (!err && def->parent)
+            err = RegSetValueExW( key, L"Superclass", 0, REG_SZ, (const BYTE *)def->parent,
+                                  (lstrlenW( def->parent ) + 1) * sizeof(WCHAR) );
+        else if (!err) RegDeleteValueW( key, L"Superclass" );
+        RegCloseKey( key );
+    }
+    free( props );
+    if (!err)
+    {
+        remember_parent( def->name, def->parent );
+        forget_user_class( ns, def->name );
+    }
+    LeaveCriticalSection( &user_cs );
+    TRACE( "%s: %ld\n", debugstr_w(def->name), err );
+    return reg_error( err );
+}
+
+HRESULT delete_user_class( enum wbm_namespace ns, const WCHAR *name )
+{
+    WCHAR *path;
+    LSTATUS err;
+
+    if (ns >= WBEMPROX_NAMESPACE_LAST) return WBEM_E_INVALID_NAMESPACE;
+    if (!name || !name[0]) return WBEM_E_INVALID_PARAMETER;
+    if (is_builtin_class( ns, name )) return WBEM_E_ACCESS_DENIED;
+    if (!is_valid_name( name )) return WBEM_E_INVALID_CLASS;
+    if (!(path = classes_key_path( ns, name ))) return E_OUTOFMEMORY;
+    EnterCriticalSection( &user_cs );
+    err = RegDeleteTreeW( HKEY_LOCAL_MACHINE, path );
+    if (!err) forget_user_class( ns, name );
+    LeaveCriticalSection( &user_cs );
+    free( path );
+    return reg_error( err );
+}
+
+static void key_value_name( const struct table *table, const struct record *record, UINT row, UINT col,
+                            LONGLONG *val, BOOL *is_set )
+{
+    if (record)
+    {
+        *val = record->fields[col].u.ival;
+        *is_set = record->fields[col].is_set;
+    }
+    else
+    {
+        get_value( table, row, col, val );
+        *is_set = !is_string_type( table->columns[col].type & COL_TYPE_MASK ) || *val;
+    }
+}
+
+/* the registry name of an instance: its key values */
+static WCHAR *instance_key_name( const struct table *table, const struct record *record, UINT row, HRESULT *hr )
+{
+    WCHAR *name = NULL, *tmp;
+    UINT i, len = 0, keys = 0;
+
+    *hr = S_OK;
+    for (i = 0; i < table->num_cols; i++)
+    {
+        LONGLONG val;
+        BOOL is_set;
+        WCHAR num[24];
+        const WCHAR *part;
+        UINT plen;
+
+        if (!(table->columns[i].type & COL_FLAG_KEY)) continue;
+        keys++;
+        key_value_name( table, record, row, i, &val, &is_set );
+        if (!is_set)
+        {
+            free( name );
+            *hr = WBEM_E_ILLEGAL_NULL;
+            return NULL;
+        }
+        if (is_string_type( table->columns[i].type & COL_TYPE_MASK )) part = (const WCHAR *)(INT_PTR)val;
+        else
+        {
+            swprintf( num, ARRAY_SIZE(num), L"%I64d", val );
+            part = num;
+        }
+        plen = lstrlenW( part );
+        if (!(tmp = realloc( name, (len + plen + 2) * sizeof(WCHAR) )))
+        {
+            free( name );
+            *hr = E_OUTOFMEMORY;
+            return NULL;
+        }
+        name = tmp;
+        if (len) name[len++] = ',';
+        memcpy( name + len, part, plen * sizeof(WCHAR) );
+        len += plen;
+        name[len] = 0;
+    }
+    if (!keys)
+    {
+        *hr = WBEM_E_INVALID_OBJECT; /* a class without a key has no instances to store */
+        return NULL;
+    }
+    /* a key name cannot have a backslash: it is an escape here */
+    for (i = 0; i < len; i++) if (name[i] == '\\') name[i] = '/';
+    for (i = 0; i < len; i++) name[i] = towlower( name[i] );
+    return name;
+}
+
+HRESULT put_user_instance( enum wbm_namespace ns, struct table *table, const struct record *record, UINT row,
+                           LONG flags )
+{
+    WCHAR *path, *name;
+    HKEY key, inst;
+    LSTATUS err;
+    DWORD disp;
+    HRESULT hr;
+    UINT i;
+
+    if (!(table->flags & TABLE_FLAG_USER)) return WBEM_E_INVALID_OPERATION;
+    if ((flags & WBEM_FLAG_CREATE_ONLY) && (flags & WBEM_FLAG_UPDATE_ONLY)) return WBEM_E_INVALID_PARAMETER;
+    if (!(name = instance_key_name( table, record, row, &hr ))) return hr;
+    if (!(path = classes_key_path( ns, table->name )))
+    {
+        free( name );
+        return E_OUTOFMEMORY;
+    }
+    EnterCriticalSection( &user_cs );
+    if ((err = RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_ALL_ACCESS, &key )))
+    {
+        LeaveCriticalSection( &user_cs );
+        free( path );
+        free( name );
+        return err == ERROR_FILE_NOT_FOUND ? WBEM_E_INVALID_CLASS : reg_error( err );
+    }
+    free( path );
+    if (!(err = RegCreateKeyExW( key, L"Instances", 0, NULL, 0, KEY_ALL_ACCESS, NULL, &inst, NULL )))
+    {
+        HKEY rkey = NULL;
+
+        err = RegOpenKeyExW( inst, name, 0, KEY_READ, &rkey );
+        if (!err)
+        {
+            RegCloseKey( rkey );
+            rkey = NULL;
+            err = (flags & WBEM_FLAG_CREATE_ONLY) ? ERROR_ALREADY_EXISTS : ERROR_SUCCESS;
+        }
+        else err = (flags & WBEM_FLAG_UPDATE_ONLY) ? ERROR_FILE_NOT_FOUND : ERROR_SUCCESS;
+        if (!err)
+        {
+            RegDeleteTreeW( inst, name );
+            err = RegCreateKeyExW( inst, name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &rkey, &disp );
+        }
+        for (i = 0; !err && i < table->num_cols; i++)
+        {
+            CIMTYPE type = table->columns[i].type & COL_TYPE_MASK;
+            LONGLONG val;
+            BOOL is_set;
+
+            if (table->columns[i].type & COL_FLAG_METHOD) continue;
+            key_value_name( table, record, row, i, &val, &is_set );
+            if (!is_set) continue;
+            if (is_string_type( type ))
+            {
+                const WCHAR *str = (const WCHAR *)(INT_PTR)val;
+                err = RegSetValueExW( rkey, table->columns[i].name, 0, REG_SZ, (const BYTE *)str,
+                                      (lstrlenW( str ) + 1) * sizeof(WCHAR) );
+            }
+            else
+            {
+                ULONGLONG q = (type == CIM_BOOLEAN) ? !!val : val;
+                err = RegSetValueExW( rkey, table->columns[i].name, 0, REG_QWORD, (const BYTE *)&q, sizeof(q) );
+            }
+        }
+        if (rkey) RegCloseKey( rkey );
+        RegCloseKey( inst );
+    }
+    RegCloseKey( key );
+    LeaveCriticalSection( &user_cs );
+    free( name );
+    if (err == ERROR_ALREADY_EXISTS) return WBEM_E_ALREADY_EXISTS;
+    if (err == ERROR_FILE_NOT_FOUND) return WBEM_E_NOT_FOUND;
+    return reg_error( err );
+}
+
+HRESULT delete_user_instance( enum wbm_namespace ns, const WCHAR *object_path )
+{
+    IWbemClassObject *obj;
+    struct table *table;
+    struct record *record;
+    UINT row;
+    BOOL is_class;
+    WCHAR *path, *name;
+    HRESULT hr;
+    LSTATUS err;
+
+    if (FAILED(hr = get_object( ns, object_path, &obj ))) return hr;
+    if (FAILED(hr = get_class_object_definition( obj, &table, &record, &row, &is_class )) || is_class ||
+        !(table->flags & TABLE_FLAG_USER))
+    {
+        IWbemClassObject_Release( obj );
+        return FAILED(hr) ? hr : WBEM_E_INVALID_OPERATION;
+    }
+    if (!(name = instance_key_name( table, record, row, &hr )))
+    {
+        IWbemClassObject_Release( obj );
+        return hr;
+    }
+    path = classes_key_path( ns, table->name );
+    IWbemClassObject_Release( obj );
+    if (!path)
+    {
+        free( name );
+        return E_OUTOFMEMORY;
+    }
+    EnterCriticalSection( &user_cs );
+    {
+        HKEY key;
+        if (!(err = RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_ALL_ACCESS, &key )))
+        {
+            HKEY inst;
+            if (!(err = RegOpenKeyExW( key, L"Instances", 0, KEY_ALL_ACCESS, &inst )))
+            {
+                err = RegDeleteTreeW( inst, name );
+                RegCloseKey( inst );
+            }
+            RegCloseKey( key );
+        }
+    }
+    LeaveCriticalSection( &user_cs );
+    free( path );
+    free( name );
+    return reg_error( err );
+}
+
+/* a new class to fill in: the properties of its superclass (none for a class of its own: GetObject of
+ * no path), and no name yet */
+HRESULT spawn_derived_class( enum wbm_namespace ns, const struct table *parent, IWbemClassObject **obj )
+{
+    static LONG spawned;
+    WCHAR name[40], query[80];
+    struct column *columns;
+    struct table *table;
+    IEnumWbemClassObject *iter;
+    UINT i, count = 0;
+    HRESULT hr;
+
+    if (!(columns = calloc( parent && parent->num_cols ? parent->num_cols : 1, sizeof(*columns) )))
+        return E_OUTOFMEMORY;
+    for (i = 0; parent && i < parent->num_cols; i++)
+    {
+        /* the methods are the provider's, not the new class's */
+        if (parent->columns[i].type & COL_FLAG_METHOD) continue;
+        if (!(columns[count].name = wcsdup( parent->columns[i].name )))
+        {
+            free_columns( columns, count );
+            return E_OUTOFMEMORY;
+        }
+        columns[count++].type = parent->columns[i].type & (COL_TYPE_MASK | COL_FLAG_KEY);
+    }
+    swprintf( name, ARRAY_SIZE(name), SPAWNED_PREFIX L"%lu", InterlockedIncrement( &spawned ) );
+    if (!(table = create_table( name, count, columns, 0, 0, NULL, NULL )))
+    {
+        free_columns( columns, count );
+        return E_OUTOFMEMORY;
+    }
+    table->flags |= TABLE_FLAG_SPAWNED;
+    if ((parent && !(table->parent = wcsdup( parent->name ))) || !add_table( ns, table ))
+    {
+        free_table( table );
+        return E_OUTOFMEMORY;
+    }
+    /* the query holds the table; then nobody else finds it by its name */
+    swprintf( query, ARRAY_SIZE(query), L"SELECT * FROM %s", name );
+    hr = exec_query( ns, query, &iter );
+    detach_table( table );
+    if (FAILED(hr))
+    {
+        free_table( table );
+        return hr;
+    }
+    hr = create_class_only_object( iter, ns, obj );
+    IEnumWbemClassObject_Release( iter );
+    return hr;
+}
+
+/* a property the new class gets */
+HRESULT add_spawned_property( struct table *table, struct record *record, const WCHAR *name, CIMTYPE type )
+{
+    struct column *columns;
+    struct field *fields;
+
+    if (!(table->flags & TABLE_FLAG_SPAWNED)) return WBEM_E_INVALID_OPERATION;
+    if (!is_valid_name( name )) return WBEM_E_INVALID_PARAMETER;
+    if (!is_user_type( type )) return WBEM_E_INVALID_PROPERTY_TYPE;
+    if (!(columns = realloc( (struct column *)table->columns, (table->num_cols + 1) * sizeof(*columns) )))
+        return E_OUTOFMEMORY;
+    table->columns = columns;
+    if (!(columns[table->num_cols].name = wcsdup( name ))) return E_OUTOFMEMORY;
+    if (!(fields = realloc( record->fields, (record->count + 1) * sizeof(*fields) )))
+    {
+        free( (WCHAR *)columns[table->num_cols].name );
+        return E_OUTOFMEMORY;
+    }
+    record->fields = fields;
+    columns[table->num_cols].type = type;
+    table->num_cols++;
+    fields[record->count].type = type;
+    fields[record->count].is_set = FALSE;
+    fields[record->count].u.ival = 0;
+    record->count++;
+    return S_OK;
+}
+
+HRESULT set_spawned_name( struct table *table, const VARIANT *var )
+{
+    WCHAR *name;
+
+    if (!(table->flags & TABLE_FLAG_SPAWNED)) return WBEM_E_READ_ONLY;
+    if (V_VT( var ) != VT_BSTR) return WBEM_E_TYPE_MISMATCH;
+    if (!is_valid_name( V_BSTR( var ) )) return WBEM_E_INVALID_PARAMETER;
+    if (!(name = wcsdup( V_BSTR( var ) ))) return E_OUTOFMEMORY;
+    EnterCriticalSection( &table->cs );
+    free( (WCHAR *)table->name );
+    table->name = name;
+    LeaveCriticalSection( &table->cs );
+    return S_OK;
+}
+
+BOOL is_unnamed_class( const struct table *table )
+{
+    return (table->flags & TABLE_FLAG_SPAWNED) && !wcsnicmp( table->name, SPAWNED_PREFIX, ARRAY_SIZE(SPAWNED_PREFIX) - 1 );
+}
