From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntoskrnl.exe: Run drivers' Reinitialize routines.

IoRegisterDriverReinitialization and IoRegisterBootDriverReinitialization
queue a driver's Reinitialize routine (they were stubs and the routine never
ran): once DriverEntry returns success the queued routines run in order with
the driver object, their context and Count, the number of calls so far this
one included (DriverExtension->Count); a routine that registers itself again
runs again after the others. There is no boot phase here, so a boot driver's
routine runs at the same point.

Gate: test/ntoskrnl-reinit-gate.sh (a probe driver; 64-bit, a WoW64 host skips).
---
 dlls/ntoskrnl.exe/ntoskrnl.c         | 55 ++++++++++++++++++++++++++++++++++--
 dlls/ntoskrnl.exe/ntoskrnl_private.h |  1 +
 2 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index 93ad7dd..5a9cc97 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -1654,6 +1654,35 @@ static struct _OBJECT_TYPE driver_type =
 POBJECT_TYPE IoDriverObjectType = &driver_type;
 
 
+struct reinit_routine
+{
+    struct list entry;
+    PDRIVER_REINITIALIZE routine;
+    void *context;
+};
+
+/* call the driver's Reinitialize routines, the ones they register again too, in order;
+ * Count is the number of calls so far, this one included */
+static void run_reinit_routines( struct wine_driver *driver )
+{
+    struct reinit_routine *routine;
+    struct list *head;
+
+    for (;;)
+    {
+        EnterCriticalSection( &drivers_cs );
+        if ((head = list_head( &driver->reinit_routines ))) list_remove( head );
+        LeaveCriticalSection( &drivers_cs );
+        if (!head) break;
+        routine = LIST_ENTRY( head, struct reinit_routine, entry );
+#ifndef SG_MUTANT_REINIT_NO_COUNT
+        driver->driver_extension.Count++;
+#endif
+        routine->routine( &driver->driver_obj, routine->context, driver->driver_extension.Count );
+        free( routine );
+    }
+}
+
 /***********************************************************************
  *           IoCreateDriver   (NTOSKRNL.EXE.@)
  */
@@ -1683,6 +1712,7 @@ NTSTATUS WINAPI IoCreateDriver( UNICODE_STRING *name, PDRIVER_INITIALIZE init )
         driver->driver_obj.MajorFunction[i] = unhandled_irp;
     list_init( &driver->root_pnp_devices );
     list_init( &driver->object_extensions );
+    list_init( &driver->reinit_routines );
 
     EnterCriticalSection( &drivers_cs );
     if (wine_rb_put( &wine_drivers, &driver->driver_obj.DriverName, &driver->entry ))
@@ -1692,9 +1722,14 @@ NTSTATUS WINAPI IoCreateDriver( UNICODE_STRING *name, PDRIVER_INITIALIZE init )
     status = driver->driver_obj.DriverInit( &driver->driver_obj, &driver->driver_extension.ServiceKeyName );
     if (status)
     {
+        struct reinit_routine *routine, *next;
+
+        LIST_FOR_EACH_ENTRY_SAFE( routine, next, &driver->reinit_routines, struct reinit_routine, entry )
+            free( routine );
         IoDeleteDriver( &driver->driver_obj );
         return status;
     }
+    run_reinit_routines( driver );
 
     for (i = 0; i <= IRP_MJ_MAXIMUM_FUNCTION; i++)
     {
@@ -2103,12 +2138,26 @@ NTSTATUS WINAPI IoQueryDeviceDescription(PINTERFACE_TYPE itype, PULONG bus, PCON
     return STATUS_NOT_IMPLEMENTED;
 }
 
+static void register_reinit( DRIVER_OBJECT *obj, PDRIVER_REINITIALIZE reinit, void *context )
+{
+    struct wine_driver *driver = CONTAINING_RECORD( obj, struct wine_driver, driver_obj );
+    struct reinit_routine *routine;
+
+    if (!(routine = malloc( sizeof(*routine) ))) return;
+    routine->routine = reinit;
+    routine->context = context;
+    EnterCriticalSection( &drivers_cs );
+    list_add_tail( &driver->reinit_routines, &routine->entry );
+    LeaveCriticalSection( &drivers_cs );
+}
+
 /***********************************************************************
  *           IoRegisterDriverReinitialization    (NTOSKRNL.EXE.@)
  */
 void WINAPI IoRegisterDriverReinitialization( PDRIVER_OBJECT obj, PDRIVER_REINITIALIZE reinit, PVOID context )
 {
-    FIXME( "stub: %p %p %p\n", obj, reinit, context );
+    TRACE( "%p %p %p\n", obj, reinit, context );
+    register_reinit( obj, reinit, context );
 }
 
 /***********************************************************************
@@ -2116,7 +2165,9 @@ void WINAPI IoRegisterDriverReinitialization( PDRIVER_OBJECT obj, PDRIVER_REINIT
  */
 void WINAPI IoRegisterBootDriverReinitialization(DRIVER_OBJECT *driver, PDRIVER_REINITIALIZE proc, void *ctx)
 {
-    FIXME("driver %p, proc %p, ctx %p, stub!\n", driver, proc, ctx);
+    /* there is no boot phase here: the routine runs once the driver's DriverEntry returned */
+    TRACE("driver %p, proc %p, ctx %p\n", driver, proc, ctx);
+    register_reinit( driver, proc, ctx );
 }
 
 /***********************************************************************
diff --git a/dlls/ntoskrnl.exe/ntoskrnl_private.h b/dlls/ntoskrnl.exe/ntoskrnl_private.h
index fde9a89..af7da35 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl_private.h
+++ b/dlls/ntoskrnl.exe/ntoskrnl_private.h
@@ -100,6 +100,7 @@ struct wine_driver
     struct wine_rb_entry entry;
     struct list root_pnp_devices;
     struct list object_extensions;  /* IoAllocateDriverObjectExtension (drivers_cs) */
+    struct list reinit_routines;    /* IoRegister(Boot)DriverReinitialization, run after DriverEntry */
 };
 
 void ObReferenceObject( void *obj );
