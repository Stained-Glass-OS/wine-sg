From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: Implement FileFsObjectIdInformation from the file system's UUID.

NtQueryVolumeInformationFile(FileFsObjectIdInformation) answers the volume's
object id, the 16-byte GUID that identifies the file system volume: here the
UUID of the Unix file system the file is on (FS_IOC_GETFSUUID, or the
device's /dev/disk/by-uuid name), in the byte order it is written. A file
system without one fails with STATUS_INVALID_DEVICE_REQUEST; it returned
STATUS_NOT_IMPLEMENTED. Adds FILE_FS_OBJECTID_INFORMATION to winioctl.h.

Gate: test/ntdll-fsobjectid-gate.sh (the gate passes findmnt's UUID).
---
 dlls/ntdll/unix/file.c | 73 ++++++++++++++++++++++++++++++++++++++++++++++++--
 include/winioctl.h     |  6 +++++
 2 files changed, 77 insertions(+), 2 deletions(-)

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 44dffd9..9eb6da7 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -8201,6 +8201,61 @@ NTSTATUS get_device_info( int fd, FILE_FS_DEVICE_INFORMATION *info )
 /******************************************************************************
  *              NtQueryVolumeInformationFile   (NTDLL.@)
  */
+/* the bytes of a textual id ("edf28d94-62e3-...", "525A-3466"), up to 16 */
+static BOOL parse_fs_uuid( const char *text, UCHAR id[16] )
+{
+    unsigned int n = 0, digit;
+    BOOL high = TRUE;
+
+    for (; *text && n < 16; text++)
+    {
+        if (*text >= '0' && *text <= '9') digit = *text - '0';
+        else if (*text >= 'a' && *text <= 'f') digit = *text - 'a' + 10;
+        else if (*text >= 'A' && *text <= 'F') digit = *text - 'A' + 10;
+        else continue;
+        if (high) id[n] = digit << 4;
+        else id[n++] |= digit;
+        high = !high;
+    }
+    return n > 0;
+}
+
+/* the id of the file system holding fd: its UUID, as blkid and /dev/disk/by-uuid show it */
+static BOOL get_fs_uuid( int fd, UCHAR id[16] )
+{
+#ifdef SG_MUTANT_FSUUID_ZERO
+    return TRUE;
+#endif
+#ifdef __linux__
+    struct { unsigned char len; unsigned char uuid[16]; } fsuuid = { 16 };
+    struct stat st, dev_st;
+    struct dirent *de;
+    char path[300];
+    BOOL ret = FALSE;
+    DIR *dir;
+
+    /* FS_IOC_GETFSUUID, Linux 6.5 */
+    if (!ioctl( fd, _IOR( 0x15, 0, fsuuid ), &fsuuid ) && fsuuid.len)
+    {
+        memcpy( id, fsuuid.uuid, min( fsuuid.len, 16 ) );
+        return TRUE;
+    }
+    /* the block device the file system is on, by its UUID link */
+    if (fstat( fd, &st ) || !(dir = opendir( "/dev/disk/by-uuid" ))) return FALSE;
+    while (!ret && (de = readdir( dir )))
+    {
+        if (de->d_name[0] == '.' || strlen( de->d_name ) > 200) continue;
+        snprintf( path, sizeof(path), "/dev/disk/by-uuid/%s", de->d_name );
+        if (!stat( path, &dev_st ) && S_ISBLK( dev_st.st_mode ) && dev_st.st_rdev == st.st_dev)
+            ret = parse_fs_uuid( de->d_name, id );
+    }
+    closedir( dir );
+    return ret;
+#else
+    return FALSE;
+#endif
+}
+
 NTSTATUS WINAPI NtQueryVolumeInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
                                               void *buffer, ULONG length,
                                               FS_INFORMATION_CLASS info_class )
@@ -8512,9 +8567,23 @@ NTSTATUS WINAPI NtQueryVolumeInformationFile( HANDLE handle, IO_STATUS_BLOCK *io
 #endif
 
     case FileFsObjectIdInformation:
-        FIXME( "%p: object id info not supported\n", handle );
-        status = STATUS_NOT_IMPLEMENTED;
+    {
+        FILE_FS_OBJECTID_INFORMATION *info = buffer;
+
+        if (length < sizeof(*info))
+        {
+            status = STATUS_INFO_LENGTH_MISMATCH;
+            break;
+        }
+        memset( info, 0, sizeof(*info) );
+        if (get_fs_uuid( fd, info->ObjectId ))
+        {
+            io->Information = sizeof(*info);
+            status = STATUS_SUCCESS;
+        }
+        else status = STATUS_INVALID_DEVICE_REQUEST;  /* a file system without an id */
         break;
+    }
 
     case FileFsMaximumInformation:
         FIXME( "%p: maximum info not supported\n", handle );
diff --git a/include/winioctl.h b/include/winioctl.h
index ce48526..994f48d 100644
--- a/include/winioctl.h
+++ b/include/winioctl.h
@@ -690,6 +690,12 @@ typedef struct _FILE_FS_FULL_SIZE_INFORMATION {
 	ULONG		BytesPerSector;
 } FILE_FS_FULL_SIZE_INFORMATION, *PFILE_FS_FULL_SIZE_INFORMATION;
 
+/*FileFsObjectIdInformation = 8 */
+typedef struct _FILE_FS_OBJECTID_INFORMATION {
+	UCHAR	ObjectId[16];
+	UCHAR	ExtendedInfo[48];
+} FILE_FS_OBJECTID_INFORMATION, *PFILE_FS_OBJECTID_INFORMATION;
+
 /*FileFsSectorSizeInformation = 11 */
 typedef struct _FILE_FS_SECTOR_SIZE_INFORMATION {
 	ULONG	LogicalBytesPerSector;
