From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: Installer Detection -- a program taken for an installer needs an administrator, as on Windows

UAC's Installer Detection: Windows asks for an administrator (consent, or credentials for a
standard user) before it starts a 32-bit program that states no requestedExecutionLevel in its
manifest, is started interactively, and whose file name or version resource (company, product,
description, original and internal file name) has an installer's keyword in it: install, setup,
update, patch, upgrade. OpenSCAD 2021's NSIS 2 installer ("Installer" in its name, no level) ran
as the person here and failed on Program Files ("Error opening file for writing") with no prompt;
its silent /S ended 0 having installed nothing.

sg_elevation_required (0259) now also takes such a program as one that needs an administrator, so
CreateProcess fails with ERROR_ELEVATION_REQUIRED and ShellExecuteEx (a double-click, start) asks
the elevation broker -- the existing consent path, unchanged. Not when the manifest (inside, or
PROGRAM.manifest beside it) states any level, not for a 64-bit program, not for Wine's builtin
programs (msiexec, dpvsetup, uninstaller carry no manifest level, as Windows' own programs do), not
onto a service's window station (__wineservice_winstation), not with __COMPAT_LAYER=RunAsInvoker
(5958), not inside a program the broker started (SG_IN_BROKER), and not with the policy
HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System EnableInstallerDetection = 0 (on
when unset, Windows' default outside a domain). Windows' undocumented byte-signature and
string-table heuristics are not reproduced.

David 2026-11-23: elevation as Windows does it. Gate test-instdetect (test/instdetect-gate.sh);
mutant SG_MUTANT_NO_INSTALLER_DETECTION. QA: OpenSCAD 2021.01 on qa5 asks, then installs.
---
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -27,6 +27,7 @@
 #include "winbase.h"
 #include "winnls.h"
 #include "winreg.h"
+#include "winver.h"
 #include "wincontypes.h"
 #include "winternl.h"
 #include "processsnapshot.h"
@@ -773,7 +774,122 @@
     return GetEnvironmentVariableW( L"SG_USER_ADMIN", v, ARRAY_SIZE(v) ) == 1 && v[0] == '1';
 }
 
-static BOOL sg_elevation_required( const WCHAR *app_name, HANDLE token )
+/* Stained Glass OS 9000: UAC's Installer Detection, as Windows does it. A program that states no
+ * requestedExecutionLevel in its manifest, is a 32-bit image and is started interactively is taken
+ * for an installer -- and needs an administrator -- when its file name, or one of its version
+ * resource's names (company, product, description, original and internal file name), has one of
+ * the keywords in it: OpenSCAD 2021's NSIS 2 installer ("Installer" in its name, no manifest level)
+ * ran as the person and failed on Program Files with no prompt. Windows' own programs carry a
+ * manifest with a level; Wine's builtin ones (msiexec, dpvsetup, uninstaller) mostly do not and are
+ * never taken for one. The policy EnableInstallerDetection = 0 (HKLM ... Policies\System) turns it
+ * off, as on Windows; unset, it is on (the default of Windows outside a domain). */
+static const WCHAR *const sg_installer_words[] = { L"install", L"setup", L"update", L"patch", L"upgrade" };
+
+static BOOL sg_has_installer_word( const WCHAR *text )
+{
+    unsigned int i, n;
+    const WCHAR *p;
+
+    if (!text) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(sg_installer_words); i++)
+    {
+        n = lstrlenW( sg_installer_words[i] );
+        for (p = text; *p; p++) if (!wcsnicmp( p, sg_installer_words[i], n )) return TRUE;
+    }
+    return FALSE;
+}
+
+/* the image's header: a 32-bit (i386) program that is not one of Wine's builtin ones */
+static BOOL sg_plain_32bit_image( const WCHAR *app_name )
+{
+    BYTE buf[1024];
+    DWORD got = 0, pe;
+    HANDLE file;
+    BOOL ret = FALSE;
+
+    file = CreateFileW( app_name, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                        NULL, OPEN_EXISTING, 0, 0 );
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    if (ReadFile( file, buf, sizeof(buf), &got, NULL ) && got >= 0x60 && buf[0] == 'M' && buf[1] == 'Z')
+    {
+        pe = buf[0x3c] | (buf[0x3d] << 8) | (buf[0x3e] << 16) | ((DWORD)buf[0x3f] << 24);
+        /* "Wine builtin DLL" / "Wine placeholder DLL" after the DOS header */
+        if (!memcmp( buf + 0x40, "Wine builtin DLL", 16 ) || !memcmp( buf + 0x40, "Wine placeholder DLL", 20 ))
+            ret = FALSE;
+        else if (pe <= got - 26 && !memcmp( buf + pe, "PE\0\0", 4 ))
+            ret = (buf[pe + 4] | (buf[pe + 5] << 8)) == IMAGE_FILE_MACHINE_I386 &&
+                  (buf[pe + 24] | (buf[pe + 25] << 8)) == IMAGE_NT_OPTIONAL_HDR32_MAGIC;
+    }
+    CloseHandle( file );
+    return ret;
+}
+
+/* started where a person works: not by a service, nor onto a service's window station */
+static BOOL sg_interactive_start( const STARTUPINFOW *startup )
+{
+    static const WCHAR service_ws[] = L"__wineservice_winstation";
+    const UNICODE_STRING *desktop = &NtCurrentTeb()->Peb->ProcessParameters->Desktop;
+    unsigned int n = ARRAY_SIZE(service_ws) - 1;
+
+    if (startup && startup->lpDesktop && !wcsnicmp( startup->lpDesktop, service_ws, n )) return FALSE;
+    if (desktop->Buffer && desktop->Length >= n * sizeof(WCHAR) && !wcsnicmp( desktop->Buffer, service_ws, n ))
+        return FALSE;
+    return TRUE;
+}
+
+static BOOL sg_installer_detection_on(void)
+{
+    DWORD value = 1, size = sizeof(value);
+
+#ifdef SG_MUTANT_NO_INSTALLER_DETECTION
+    return FALSE;
+#endif
+    if (RegGetValueW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
+                      L"EnableInstallerDetection", RRF_RT_REG_DWORD, NULL, &value, &size )) return TRUE;
+    return value != 0;
+}
+
+static BOOL sg_installer_detected( const WCHAR *app_name, HMODULE module, const STARTUPINFOW *startup )
+{
+    static const WCHAR *const fields[] = { L"CompanyName", L"ProductName", L"FileDescription",
+                                           L"OriginalFilename", L"InternalName" };
+    const WCHAR *base, *p;
+    WCHAR query[64], *value;
+    BOOL ret = FALSE;
+    HRSRC res;
+    void *data = NULL;
+    DWORD size, i, t, ntrans = 0, *trans = NULL;
+    UINT len;
+
+    if (!sg_installer_detection_on() || !sg_interactive_start( startup ) || !sg_plain_32bit_image( app_name ))
+        return FALSE;
+    for (base = p = app_name; *p; p++) if (*p == '\\' || *p == '/') base = p + 1;
+    if (sg_has_installer_word( base )) ret = TRUE;
+    /* RT_VERSION (16), its resource 1 */
+    else if (module && (res = FindResourceW( module, (const WCHAR *)(ULONG_PTR)1, (const WCHAR *)(ULONG_PTR)16 )) &&
+             (size = SizeofResource( module, res )) && (data = HeapAlloc( GetProcessHeap(), 0, size )))
+    {
+        memcpy( data, LoadResource( module, res ), size );
+        if (VerQueryValueW( data, L"\\VarFileInfo\\Translation", (void **)&trans, &len ) && trans)
+            ntrans = len / sizeof(DWORD);
+        for (t = 0; t <= ntrans && !ret; t++)
+        {
+            /* each language the resource lists, then US English, Unicode */
+            DWORD lang = t < ntrans ? MAKELONG( HIWORD(trans[t]), LOWORD(trans[t]) ) : 0x040904b0;
+            for (i = 0; i < ARRAY_SIZE(fields) && !ret; i++)
+            {
+                swprintf( query, ARRAY_SIZE(query), L"\\StringFileInfo\\%08lx\\%s", lang, fields[i] );
+                if (VerQueryValueW( data, query, (void **)&value, &len ) && len && sg_has_installer_word( value ))
+                    ret = TRUE;
+            }
+        }
+        HeapFree( GetProcessHeap(), 0, data );
+    }
+    if (ret) TRACE( "%s: taken for an installer (Installer Detection)\n", debugstr_w(app_name) );
+    return ret;
+}
+
+static BOOL sg_elevation_required( const WCHAR *app_name, HANDLE token, const STARTUPINFOW *startup )
 {
     static const char tag[] = "requestedexecutionlevel", level[] = "requireadministrator";
     static const char highest[] = "highestavailable";
@@ -782,7 +898,7 @@
     TOKEN_ELEVATION elevation;
     const char *xml;
     DWORD size, len, i, j;
-    BOOL in_tag = FALSE, ret = FALSE;
+    BOOL in_tag = FALSE, ret = FALSE, has_level = FALSE;
     HMODULE module;
     HRSRC res;
 
@@ -852,7 +968,7 @@
             if (!in_tag && len - i >= sizeof(tag) - 1)
             {
                 for (j = 0; j < sizeof(tag) - 1 && (xml[i + j] | 0x20) == tag[j]; j++);
-                if (j == sizeof(tag) - 1) { in_tag = TRUE; i += j - 1; continue; }
+                if (j == sizeof(tag) - 1) { in_tag = has_level = TRUE; i += j - 1; continue; }
             }
             if (in_tag && xml[i] == '>') in_tag = FALSE;
             if (in_tag && len - i >= sizeof(level) - 1)
@@ -869,6 +985,35 @@
             }
         }
     }
+    else if (!res)
+    {
+        /* no manifest inside: one beside it (app.exe.manifest) may state the level */
+        WCHAR *ext = HeapAlloc( GetProcessHeap(), 0, (lstrlenW( app_name ) + 10) * sizeof(WCHAR) );
+        HANDLE file = INVALID_HANDLE_VALUE;
+        char buf[8192];
+        DWORD got = 0;
+
+        if (ext)
+        {
+            lstrcpyW( ext, app_name );
+            lstrcatW( ext, L".manifest" );
+            file = CreateFileW( ext, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                                NULL, OPEN_EXISTING, 0, 0 );
+            HeapFree( GetProcessHeap(), 0, ext );
+        }
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            if (ReadFile( file, buf, sizeof(buf), &got, NULL ))
+                for (i = 0; i + sizeof(tag) - 1 <= got && !has_level; i++)
+                {
+                    for (j = 0; j < sizeof(tag) - 1 && (buf[i + j] | 0x20) == tag[j]; j++);
+                    if (j == sizeof(tag) - 1) has_level = TRUE;
+                }
+            CloseHandle( file );
+        }
+    }
+    /* no level stated: Installer Detection (9000) */
+    if (!ret && !has_level) ret = sg_installer_detected( app_name, module, startup );
     FreeLibrary( module );
     if (ret) TRACE( "%s requires an administrator\n", debugstr_w(app_name) );
     return ret;
@@ -1167,7 +1312,7 @@
         flags = (flags & ~(CREATE_NEW_CONSOLE | CREATE_NO_WINDOW)) | DETACHED_PROCESS;
     }
 
-    if (sg_elevation_required( app_name, token ))
+    if (sg_elevation_required( app_name, token, startup_info ))
     {
         status = STATUS_ELEVATION_REQUIRED;
         goto done;
