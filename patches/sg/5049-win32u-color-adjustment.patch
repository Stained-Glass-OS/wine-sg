From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: Keep a colour adjustment per DC.

GetColorAdjustment and SetColorAdjustment keep a COLORADJUSTMENT per DC: a
new DC has the no-change values (unit gammas, black 0, white 10000, no
contrast, brightness, colourfulness or tint), SetColorAdjustment takes
values within the documented member ranges and GetColorAdjustment gives
them back. Both always failed. Halftone stretching does not use the values
yet.

Gate: test/win32u-coloradjust-gate.sh (64/32).
---
 dlls/win32u/dc.c            |  5 +++++
 dlls/win32u/gdiobj.c        | 42 ++++++++++++++++++++++++++++++++++++++++--
 dlls/win32u/ntgdi_private.h |  1 +
 3 files changed, 46 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/dc.c b/dlls/win32u/dc.c
index 3f6a501..e17cc30 100644
--- a/dlls/win32u/dc.c
+++ b/dlls/win32u/dc.c
@@ -154,6 +154,11 @@ static void free_dc_attr( DC_ATTR *dc_attr )
  */
 static void set_initial_dc_state( DC *dc )
 {
+    /* no adjustment: unit gammas, full black-to-white range, no change */
+    static const COLORADJUSTMENT default_adjustment =
+        { sizeof(COLORADJUSTMENT), 0, ILLUMINANT_DEVICE_DEFAULT, 10000, 10000, 10000, 0, 10000, 0, 0, 0, 0 };
+
+    dc->color_adjustment = default_adjustment;
     dc->attr->wnd_org.x     = 0;
     dc->attr->wnd_org.y     = 0;
     dc->attr->wnd_ext.cx    = 1;
diff --git a/dlls/win32u/gdiobj.c b/dlls/win32u/gdiobj.c
index fec9924..ef2ef8c 100644
--- a/dlls/win32u/gdiobj.c
+++ b/dlls/win32u/gdiobj.c
@@ -1017,17 +1017,55 @@ BOOL WINAPI NtGdiFlush(void)
  */
 BOOL WINAPI NtGdiGetColorAdjustment( HDC hdc, COLORADJUSTMENT *ca )
 {
-    FIXME( "stub\n" );
+    DC *dc;
+
+    TRACE( "%p, %p\n", hdc, ca );
+
+#ifdef SG_MUTANT_COLORADJ_STUB
     return FALSE;
+#endif
+    if (!ca || !(dc = get_dc_ptr( hdc ))) return FALSE;
+    *ca = dc->color_adjustment;
+    release_dc_ptr( dc );
+    return TRUE;
+}
+
+/* the documented ranges of the COLORADJUSTMENT members */
+static BOOL is_valid_color_adjustment( const COLORADJUSTMENT *ca )
+{
+    return ca->caSize == sizeof(*ca)
+        && !(ca->caFlags & ~(CA_NEGATIVE | CA_LOG_FILTER))
+        && ca->caIlluminantIndex <= ILLUMINANT_MAX_INDEX
+        && ca->caRedGamma >= RGB_GAMMA_MIN && ca->caRedGamma <= RGB_GAMMA_MAX
+        && ca->caGreenGamma >= RGB_GAMMA_MIN && ca->caGreenGamma <= RGB_GAMMA_MAX
+        && ca->caBlueGamma >= RGB_GAMMA_MIN && ca->caBlueGamma <= RGB_GAMMA_MAX
+        && ca->caReferenceBlack <= REFERENCE_BLACK_MAX
+        && ca->caReferenceWhite >= REFERENCE_WHITE_MIN && ca->caReferenceWhite <= REFERENCE_WHITE_MAX
+        && ca->caContrast >= COLOR_ADJ_MIN && ca->caContrast <= COLOR_ADJ_MAX
+        && ca->caBrightness >= COLOR_ADJ_MIN && ca->caBrightness <= COLOR_ADJ_MAX
+        && ca->caColorfulness >= COLOR_ADJ_MIN && ca->caColorfulness <= COLOR_ADJ_MAX
+        && ca->caRedGreenTint >= COLOR_ADJ_MIN && ca->caRedGreenTint <= COLOR_ADJ_MAX;
 }
 
 /*******************************************************************
  *           NtGdiSetColorAdjustment    (win32u.@)
+ *
+ * The values are kept for the DC; halftone stretching does not use them yet.
  */
 BOOL WINAPI NtGdiSetColorAdjustment( HDC hdc, const COLORADJUSTMENT *ca )
 {
-    FIXME( "stub\n" );
+    DC *dc;
+
+    TRACE( "%p, %p\n", hdc, ca );
+
+#ifdef SG_MUTANT_COLORADJ_STUB
     return FALSE;
+#endif
+    if (!ca || !is_valid_color_adjustment( ca )) return FALSE;
+    if (!(dc = get_dc_ptr( hdc ))) return FALSE;
+    dc->color_adjustment = *ca;
+    release_dc_ptr( dc );
+    return TRUE;
 }
 
 void gdi_init(void)
diff --git a/dlls/win32u/ntgdi_private.h b/dlls/win32u/ntgdi_private.h
index e5718f2..c6018b7 100644
--- a/dlls/win32u/ntgdi_private.h
+++ b/dlls/win32u/ntgdi_private.h
@@ -66,6 +66,7 @@ typedef struct tagDC
     int          pixel_format;     /* pixel format (for memory DCs) */
     UINT         aa_flags;         /* anti-aliasing flags to pass to GetGlyphOutline for current font */
     WCHAR        display[CCHDEVICENAME]; /* Display name when created for a specific display device */
+    COLORADJUSTMENT color_adjustment; /* halftone colour adjustment (SetColorAdjustment) */
 
     int           flags;
     HRGN          hClipRgn;      /* Clip region */
