+/* ICompositionMaskBrush: Mask and Source, two brushes of ours */
+static struct brush *impl_from_mask_brush( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct brush, ICompositionMaskBrush_iface );
+}
