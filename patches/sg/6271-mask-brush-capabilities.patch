+static void draw_brush( ID2D1DeviceContext *ctx, const struct visual *v, struct brush *brush, float opacity,
+        const D2D1_MATRIX_3X2_F *world, struct swapchain_place *places, unsigned int max_places, unsigned int *count,
+        unsigned int depth );
+
+/* a mask brush: its source, through the mask's alpha (a Direct2D layer with the mask as its opacity brush) */
+static void draw_mask_brush( ID2D1DeviceContext *ctx, const struct visual *v, struct brush *brush, float opacity,
+        const D2D1_MATRIX_3X2_F *world, struct swapchain_place *places, unsigned int max_places, unsigned int *count,
+        unsigned int depth )
+{
+    struct brush *source = unsafe_brush( brush->source ), *mask = unsafe_brush( brush->mask );
+    D2D1_LAYER_PARAMETERS1 layer;
+    ID2D1Brush *opacity_brush;
+
+    memset( &layer, 0, sizeof(layer) );
+    if (!source || depth > 8) return;
+#ifdef SG_MUTANT_MASK_IGNORED
+    mask = NULL;
+#endif
+    if (!mask)
+    {
+        draw_brush( ctx, v, source, opacity, world, places, max_places, count, depth + 1 );
+        return;
+    }
+    if (draw_render_target_only || !(opacity_brush = mask_d2d_brush( ctx, mask, v->render_size.X, v->render_size.Y,
+            &layer.contentBounds )))
+    {
+        /* nothing of the mask to draw through: nothing shows */
+        return;
+    }
+    layer.geometricMask = NULL;
+    layer.maskAntialiasMode = D2D1_ANTIALIAS_MODE_PER_PRIMITIVE;
+    layer.maskTransform._11 = layer.maskTransform._22 = 1.0f;
+    layer.opacity = 1.0f;
+    layer.opacityBrush = opacity_brush;
+    layer.layerOptions = D2D1_LAYER_OPTIONS1_NONE;
+    ID2D1DeviceContext_PushLayer( ctx, &layer, NULL );
+    draw_brush( ctx, v, source, opacity, world, places, max_places, count, depth + 1 );
+    ID2D1DeviceContext_PopLayer( ctx );
+    ID2D1Brush_Release( opacity_brush );
+}
