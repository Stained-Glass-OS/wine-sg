+/* where a surface brush puts its surface in a w x h area (Stretch, the alignment ratios) */
+static BOOL surface_brush_place( struct brush *brush, float w, float h, D2D1_RECT_F *dst, D2D1_SIZE_F *size )
+{
+    struct drawing_surface *surface = unsafe_drawing_surface( (IUnknown *)brush->surface );
+    float sw, sh, dw, dh, scale;
+
+    if (!surface || !surface->bitmap || !surface->size.width || !surface->size.height) return FALSE;
+    sw = surface->size.width;
+    sh = surface->size.height;
+    switch (brush->stretch)
+    {
+        case CompositionStretch_None: dw = sw; dh = sh; break;
+        case CompositionStretch_Uniform: scale = min( w / sw, h / sh ); dw = sw * scale; dh = sh * scale; break;
+        case CompositionStretch_UniformToFill: scale = max( w / sw, h / sh ); dw = sw * scale; dh = sh * scale; break;
+        default: dw = w; dh = h; break;
+    }
+    dst->left = (w - dw) * brush->horizontal_ratio;
+    dst->top = (h - dh) * brush->vertical_ratio;
+    dst->right = dst->left + dw;
+    dst->bottom = dst->top + dh;
+    size->width = sw;
+    size->height = sh;
+    return TRUE;
+}
+
+/* a mask brush's mask as a Direct2D brush over the visual's area, and the area it covers */
+static ID2D1Brush *mask_d2d_brush( ID2D1DeviceContext *ctx, struct brush *mask, float w, float h, D2D1_RECT_F *bounds )
+{
+    *bounds = (D2D1_RECT_F){ 0, 0, w, h };
+    if (!mask->surface_brush && !mask->mask_brush)
+    {
+        D2D1_COLOR_F color = { mask->color.R / 255.0f, mask->color.G / 255.0f, mask->color.B / 255.0f, mask->color.A / 255.0f };
+        ID2D1SolidColorBrush *solid;
+        if (FAILED(ID2D1DeviceContext_CreateSolidColorBrush( ctx, &color, NULL, &solid ))) return NULL;
+        return (ID2D1Brush *)solid;
+    }
+    if (mask->surface_brush)
+    {
+        struct drawing_surface *surface = unsafe_drawing_surface( (IUnknown *)mask->surface );
+        D2D1_BITMAP_BRUSH_PROPERTIES1 props = { D2D1_EXTEND_MODE_CLAMP, D2D1_EXTEND_MODE_CLAMP,
+                mask->interpolation == CompositionBitmapInterpolationMode_NearestNeighbor
+                ? D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR : D2D1_INTERPOLATION_MODE_LINEAR };
+        D2D1_BRUSH_PROPERTIES brush_props = { 1.0f };
+        ID2D1BitmapBrush1 *bitmap_brush;
+        D2D1_RECT_F place;
+        D2D1_SIZE_F size;
+
+        if (draw_render_target_only || !surface_brush_place( mask, w, h, &place, &size )) return NULL;
+        *bounds = place;
+        /* outside its picture the mask is clear: the layer's bounds */
+        bounds->left = max( bounds->left, 0.0f ); bounds->top = max( bounds->top, 0.0f );
+        bounds->right = min( bounds->right, w ); bounds->bottom = min( bounds->bottom, h );
+        /* the picture scaled and placed as the brush places it */
+        brush_props.transform._11 = (place.right - place.left) / size.width;
+        brush_props.transform._22 = (place.bottom - place.top) / size.height;
+        brush_props.transform._31 = place.left;
+        brush_props.transform._32 = place.top;
+        if (FAILED(ID2D1DeviceContext_CreateBitmapBrush( ctx, (ID2D1Bitmap *)surface->bitmap, &props, &brush_props,
