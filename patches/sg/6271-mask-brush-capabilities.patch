+}
+
+static ULONG WINAPI mask_brush_Release( void *iface )
+{
+    return brush_Release( &impl_from_mask_brush( iface )->ICompositionBrush_iface );
+}
+
+static HRESULT WINAPI mask_brush_GetIids( void *iface, ULONG *count, IID **iids )
+{
