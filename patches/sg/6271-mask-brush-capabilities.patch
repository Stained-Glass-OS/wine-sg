From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dcomp: CompositionMaskBrush and CompositionCapabilities (Teams)

ICompositor2::CreateMaskBrush makes a CompositionMaskBrush whose Source is drawn through its Mask's alpha, and Windows.UI.Composition.CompositionCapabilities exists, saying what the renderer does. Teams' title bar overlay threw on the mask brush and its capabilities query found no class.
---
diff --git a/dlls/dcomp/Makefile.in b/dlls/dcomp/Makefile.in
index d3bf2d2..5786903 100644
--- a/dlls/dcomp/Makefile.in
+++ b/dlls/dcomp/Makefile.in
@@ -6,6 +6,7 @@ EXTRADLLFLAGS = -Wb,--prefer-native
 SOURCES = \
 	classes.idl \
 	animation.c \
+	capabilities.c \
 	composition.c \
 	objects.c \
 	device.c \
diff --git a/dlls/dcomp/capabilities.c b/dlls/dcomp/capabilities.c
new file mode 100644
index 0000000..245b972
--- /dev/null
+++ b/dlls/dcomp/capabilities.c
@@ -0,0 +1,199 @@
+/*
+ * Windows.UI.Composition.CompositionCapabilities (wine-sg 6270)
+ *
+ * What the compositor can draw, for a program to choose what it asks for:
+ * GetForCurrentView, AreEffectsSupported, AreEffectsFast and Changed, as
+ * Windows has them. Ours draws colour, surface and mask brushes, shapes and
+ * clips; it makes no effect brushes (Compositor.CreateEffectFactory is not
+ * made), so effects are neither supported nor fast, and Teams and the others
+ * keep to what is drawn. Nothing about that changes while a program runs:
+ * Changed is never raised.
+ *
+ * Copyright (C) 2026 Stained Glass OS contributors; LGPL-2.1-or-later
+ */
+
+#include <stdarg.h>
+
+#include "composition_private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+/* windows-rs metadata */
+static const GUID IID_ICompositionCapabilities_x = { 0x8253353e, 0xb517, 0x48bc, { 0xb1, 0xe8, 0x4b, 0x35, 0x61, 0xa2, 0xe1, 0x81 } };
+static const GUID IID_ICompositionCapabilitiesStatics_x = { 0xf7b7a86e, 0x6416, 0x49e5, { 0x8d, 0xdf, 0xaf, 0xe9, 0x49, 0xe2, 0x05, 0x62 } };
+static const WCHAR class_capabilities[] = L"Windows.UI.Composition.CompositionCapabilities";
+
+struct capabilities
+{
+    IInspectable IInspectable_iface;    /* ICompositionCapabilities */
+    LONG ref;
+};
+
+static struct capabilities *impl_from_caps( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct capabilities, IInspectable_iface );
+}
+
+static HRESULT WINAPI caps_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    struct capabilities *impl = impl_from_caps( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICompositionCapabilities_x ))
+    {
+        *out = &impl->IInspectable_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI caps_AddRef( void *iface )
+{
+    return InterlockedIncrement( &impl_from_caps( iface )->ref );
+}
+
+static ULONG WINAPI caps_Release( void *iface )
+{
+    struct capabilities *impl = impl_from_caps( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI caps_GetIids( void *iface, ULONG *count, IID **iids )
+{
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_ICompositionCapabilities_x;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI caps_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    return WindowsCreateString( class_capabilities, wcslen( class_capabilities ), name );
+}
+
+static HRESULT WINAPI caps_GetTrustLevel( void *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI caps_AreEffectsSupported( void *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+#ifdef SG_MUTANT_EFFECTS_CLAIMED
+    *value = TRUE;
+    return S_OK;
+#endif
+    *value = FALSE;   /* no effect brushes are made */
+    return S_OK;
+}
+
+static HRESULT WINAPI caps_AreEffectsFast( void *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static LONG caps_next_token;
+
+static HRESULT WINAPI caps_add_Changed( void *iface, IUnknown *handler, EventRegistrationToken *token )
+{
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    if (!handler || !token) return E_INVALIDARG;
+    /* what the compositor can do does not change: the handler is never called, and not kept */
+    token->value = InterlockedIncrement( &caps_next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI caps_remove_Changed( void *iface, EventRegistrationToken token )
+{
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+    return S_OK;
+}
+
+static const void * const caps_vtbl[] =
+{
+    caps_QueryInterface, caps_AddRef, caps_Release, caps_GetIids, caps_GetRuntimeClassName, caps_GetTrustLevel,
+    caps_AreEffectsSupported, caps_AreEffectsFast, caps_add_Changed, caps_remove_Changed,
+};
+
+/* ---- the class's statics: GetForCurrentView ---- */
+
+struct caps_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    struct { const void * const *vtbl; } statics_iface;
+};
+
+static struct caps_factory caps_factory_impl;
+
+static HRESULT WINAPI cf_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &caps_factory_impl.IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionCapabilitiesStatics_x ))
+        *out = &caps_factory_impl.statics_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI cf_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI cf_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI cf_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { *count = 0; *iids = NULL; return S_OK; }
+static HRESULT WINAPI cf_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return WindowsCreateString( class_capabilities, wcslen( class_capabilities ), name );
+}
+static HRESULT WINAPI cf_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+/* not activatable: a static class */
+static HRESULT WINAPI cf_ActivateInstance( IActivationFactory *iface, IInspectable **out ) { *out = NULL; return E_NOTIMPL; }
+
+static const struct IActivationFactoryVtbl cf_vtbl =
+{
+    cf_QueryInterface, cf_AddRef, cf_Release, cf_GetIids, cf_GetRuntimeClassName, cf_GetTrustLevel,
+    cf_ActivateInstance,
+};
+
+static HRESULT WINAPI cs_QueryInterface( void *iface, REFIID iid, void **out ) { return cf_QueryInterface( NULL, iid, out ); }
+static ULONG WINAPI cs_AddRef( void *iface ) { return 2; }
+static ULONG WINAPI cs_Release( void *iface ) { return 1; }
+static HRESULT WINAPI cs_GetIids( void *iface, ULONG *count, IID **iids ) { return cf_GetIids( NULL, count, iids ); }
+static HRESULT WINAPI cs_GetRuntimeClassName( void *iface, HSTRING *name ) { return cf_GetRuntimeClassName( NULL, name ); }
+static HRESULT WINAPI cs_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI cs_GetForCurrentView( void *iface, IInspectable **out )
+{
+    struct capabilities *impl;
+
+    TRACE( "out %p.\n", out );
+    if (!out) return E_POINTER;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IInspectable_iface.lpVtbl = (const IInspectableVtbl *)caps_vtbl;
+    impl->ref = 1;
+    *out = &impl->IInspectable_iface;
+    return S_OK;
+}
+
+static const void * const cs_vtbl[] =
+{
+    cs_QueryInterface, cs_AddRef, cs_Release, cs_GetIids, cs_GetRuntimeClassName, cs_GetTrustLevel,
+    cs_GetForCurrentView,
+};
+
+static struct caps_factory caps_factory_impl = { { &cf_vtbl }, { cs_vtbl } };
+
+IActivationFactory *capabilities_factory = &caps_factory_impl.IActivationFactory_iface;
