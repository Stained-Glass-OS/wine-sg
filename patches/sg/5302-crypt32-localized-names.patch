From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: CryptFindLocalizedName finds the registered names

crypt32: CryptFindLocalizedName searches the names registered with
CryptSetOIDFunctionValue (encoding type 0, "CryptDLLFindLocalizedName",
"LocalizedNames", as the documentation shows) before the preinstalled ones,
and keeps what it returns valid for the life of the process. For that,
CryptSetOIDFunctionValue and CryptGetOIDFunctionValue no longer treat encoding
type 0 as a no-op that succeeds (CryptRegisterOIDFunction already stores it),
CryptSetOIDFunctionValue creates the function's key if it is missing and no
data removes the value, which is how the documentation unregisters a string.
---
--- a/dlls/crypt32/oid.c
+++ b/dlls/crypt32/oid.c
@@ -851,8 +851,10 @@ BOOL WINAPI CryptGetOIDFunctionValue(DWORD dwEncodingType, LPCSTR pszFuncName,
      debugstr_a(pszOID), debugstr_w(pwszValueName), pdwValueType, pbValueData,
      pcbValueData);
 
+#ifdef SG_MUTANT_OIDVALUE_ZERO
     if (!GET_CERT_ENCODING_TYPE(dwEncodingType))
         return TRUE;
+#endif
 
     if (!pszFuncName || !pszOID || !pwszValueName)
     {
@@ -888,8 +890,10 @@ BOOL WINAPI CryptSetOIDFunctionValue(DWORD dwEncodingType, LPCSTR pszFuncName,
      debugstr_a(pszOID), debugstr_w(pwszValueName), dwValueType, pbValueData,
      cbValueData);
 
+#ifdef SG_MUTANT_OIDVALUE_ZERO
     if (!GET_CERT_ENCODING_TYPE(dwEncodingType))
         return TRUE;
+#endif
 
     if (!pszFuncName || !pszOID || !pwszValueName)
     {
@@ -898,14 +902,17 @@ BOOL WINAPI CryptSetOIDFunctionValue(DWORD dwEncodingType, LPCSTR pszFuncName,
     }
 
     szKey = CRYPT_GetKeyName(dwEncodingType, pszFuncName, pszOID);
-    rc = RegOpenKeyA(HKEY_LOCAL_MACHINE, szKey, &hKey);
+    rc = RegCreateKeyExA(HKEY_LOCAL_MACHINE, szKey, 0, NULL, 0, KEY_SET_VALUE, NULL, &hKey, NULL);
     CryptMemFree(szKey);
     if (rc)
         SetLastError(rc);
     else
     {
-        rc = RegSetValueExW(hKey, pwszValueName, 0, dwValueType, pbValueData,
-         cbValueData);
+        /* no data unregisters the value, as the documentation of CryptFindLocalizedName shows */
+        if (!pbValueData && !cbValueData)
+            rc = RegDeleteValueW(hKey, pwszValueName);
+        else
+            rc = RegSetValueExW(hKey, pwszValueName, 0, dwValueType, pbValueData, cbValueData);
         if (rc)
             SetLastError(rc);
         RegCloseKey(hKey);
@@ -1167,9 +1174,95 @@ static void oid_init_localizednames(void)
 /********************************************************************
  *              CryptFindLocalizedName (CRYPT32.@)
  */
+/* The localized names registered with CryptSetOIDFunctionValue are kept as long as
+ * the process runs: the returned pointer "must not be freed". */
+struct registered_name
+{
+    struct list entry;
+    WCHAR *name;
+    WCHAR *value;
+};
+
+static struct list registered_names = LIST_INIT(registered_names);
+static CRITICAL_SECTION registered_names_cs;
+static CRITICAL_SECTION_DEBUG registered_names_cs_debug =
+{
+    0, 0, &registered_names_cs,
+    { &registered_names_cs_debug.ProcessLocksList, &registered_names_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": registered_names_cs") }
+};
+static CRITICAL_SECTION registered_names_cs = { &registered_names_cs_debug, -1, 0, 0, 0, 0 };
+
+static const WCHAR *find_registered_localized_name(const WCHAR *name)
+{
+    static const char key_name[] =
+        "Software\\Microsoft\\Cryptography\\OID\\EncodingType 0\\CryptDLLFindLocalizedName\\LocalizedNames";
+    struct registered_name *entry;
+    const WCHAR *ret = NULL;
+    DWORD type, size = 0;
+    WCHAR *value = NULL;
+    HKEY key;
+
+    if (RegOpenKeyExA(HKEY_LOCAL_MACHINE, key_name, 0, KEY_READ, &key)) return NULL;
+    if (!RegQueryValueExW(key, name, NULL, &type, NULL, &size) && type == REG_SZ && size >= sizeof(WCHAR) &&
+        (value = CryptMemAlloc(size + sizeof(WCHAR))))
+    {
+        if (RegQueryValueExW(key, name, NULL, &type, (BYTE *)value, &size) || type != REG_SZ)
+        {
+            CryptMemFree(value);
+            value = NULL;
+        }
+        else value[size / sizeof(WCHAR)] = 0;
+    }
+    RegCloseKey(key);
+    if (!value) return NULL;
+
+    EnterCriticalSection(&registered_names_cs);
+    LIST_FOR_EACH_ENTRY(entry, &registered_names, struct registered_name, entry)
+    {
+        if (lstrcmpiW(entry->name, name)) continue;
+        if (!lstrcmpW(entry->value, value))
+        {
+            ret = entry->value;
+            CryptMemFree(value);
+            value = NULL;
+        }
+        else
+        {
+            /* a changed string: the old one stays for whoever still holds it */
+            list_remove(&entry->entry);
+        }
+        break;
+    }
+    if (value && (entry = CryptMemAlloc(sizeof(*entry))))
+    {
+        if ((entry->name = CryptMemAlloc((lstrlenW(name) + 1) * sizeof(WCHAR))))
+        {
+            lstrcpyW(entry->name, name);
+            entry->value = value;
+            list_add_tail(&registered_names, &entry->entry);
+            ret = value;
+            value = NULL;
+        }
+        else CryptMemFree(entry);
+    }
+    LeaveCriticalSection(&registered_names_cs);
+    CryptMemFree(value);
+    return ret;
+}
+
 LPCWSTR WINAPI CryptFindLocalizedName(LPCWSTR pwszCryptName)
 {
     unsigned int i;
+    const WCHAR *registered;
+
+    TRACE("%s\n", debugstr_w(pwszCryptName));
+
+    /* the registered names are searched before the preinstalled ones */
+#ifndef SG_MUTANT_LOCALIZED_REGISTERED
+    if (pwszCryptName && (registered = find_registered_localized_name(pwszCryptName)))
+        return registered;
+#endif
 
     for(i = 0; i < ARRAY_SIZE(LocalizedKeys); i++)
     {
@@ -1179,7 +1272,7 @@ LPCWSTR WINAPI CryptFindLocalizedName(LPCWSTR pwszCryptName)
         }
     }
 
-    FIXME("No name for: %s - stub\n",debugstr_w(pwszCryptName));
+    TRACE("No name for: %s\n", debugstr_w(pwszCryptName));
     return NULL;
 }
 
--- a/dlls/crypt32/tests/oid.c
+++ b/dlls/crypt32/tests/oid.c
@@ -679,6 +679,50 @@ static void test_registerOIDInfo(void)
     ok(ret == ERROR_FILE_NOT_FOUND, "got %lu\n", ret);
 }
 
+static void test_findLocalizedName(void)
+{
+    static const WCHAR appstore[] = L"ApplicationStore", local[] = L"Anwendungsspeicher", local2[] = L"Speicher 2";
+    const WCHAR *name, *name2;
+    BOOL ret;
+
+    /* the names of the predefined stores are preinstalled, found without regard to case */
+    name = CryptFindLocalizedName(L"Root");
+    ok(name && *name, "got %s.\n", wine_dbgstr_w(name));
+    name2 = CryptFindLocalizedName(L"ROOT");
+    ok(name2 == name, "got %p, %p.\n", name, name2);
+    name = CryptFindLocalizedName(L"My");
+    ok(name && *name, "got %s.\n", wine_dbgstr_w(name));
+
+    name = CryptFindLocalizedName(appstore);
+    ok(!name, "got %s.\n", wine_dbgstr_w(name));
+
+    /* names registered with CryptSetOIDFunctionValue are found */
+    ret = CryptSetOIDFunctionValue(0, "CryptDLLFindLocalizedName", "LocalizedNames", appstore, REG_SZ,
+            (const BYTE *)local, sizeof(local));
+    ok(ret, "got error %#lx.\n", GetLastError());
+    name = CryptFindLocalizedName(appstore);
+    ok(name && !wcscmp(name, local), "got %s.\n", wine_dbgstr_w(name));
+    name2 = CryptFindLocalizedName(L"APPLICATIONSTORE");
+    ok(name2 == name, "got %p, %p.\n", name, name2);
+
+    /* and are searched before the preinstalled names */
+    ret = CryptSetOIDFunctionValue(0, "CryptDLLFindLocalizedName", "LocalizedNames", L"Root", REG_SZ,
+            (const BYTE *)local2, sizeof(local2));
+    ok(ret, "got error %#lx.\n", GetLastError());
+    name = CryptFindLocalizedName(L"Root");
+    ok(name && !wcscmp(name, local2), "got %s.\n", wine_dbgstr_w(name));
+    ret = CryptSetOIDFunctionValue(0, "CryptDLLFindLocalizedName", "LocalizedNames", L"Root", REG_SZ, NULL, 0);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    name = CryptFindLocalizedName(L"Root");
+    ok(name && *name && wcscmp(name, local2), "got %s.\n", wine_dbgstr_w(name));
+
+    /* NULL data unregisters the string */
+    ret = CryptSetOIDFunctionValue(0, "CryptDLLFindLocalizedName", "LocalizedNames", appstore, REG_SZ, NULL, 0);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    name = CryptFindLocalizedName(appstore);
+    ok(!name, "got %s.\n", wine_dbgstr_w(name));
+}
+
 START_TEST(oid)
 {
     test_OIDToAlgID();
@@ -691,4 +735,5 @@ START_TEST(oid)
     test_registerOIDFunction();
     test_registerDefaultOIDFunction();
     test_getDefaultOIDFunctionAddress();
+    test_findLocalizedName();
 }
