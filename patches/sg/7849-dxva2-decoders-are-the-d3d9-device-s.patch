From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dxva2: the decoders are the Direct3D 9 device's

Wine's DXVA2 decoder service had no decoders, so programs that decode
through DXVA2 (MPC-HC, VLC's and mpv's dxva2 modes, older players,
FFmpeg's dxva2 hwaccel) all decoded on the CPU. On Windows the D3D9
driver has them.

A device that has decoders -- DXVK's, sg-d3d (dxvk/patches/0010) --
answers a private interface id (IID_ISgD3D9VideoDecoderService) with its
own IDirectXVideoDecoderService; GetDecoderDeviceGuids,
GetDecoderRenderTargets, GetDecoderConfigurations and CreateVideoDecoder
are handed to it. Surfaces are still made here, as before. A device
without one (wined3d) has no decoders, as before.

Gate test-dxva2dec (a stand-in device and service); mutant
SG_MUTANT_DXVA2_NO_BACKEND. sg-image's videodecode-test decodes H.264,
HEVC, AV1 and VP9 clips bit-exact through DXVA2 with it.
---
diff --git a/dlls/dxva2/main.c b/dlls/dxva2/main.c
index d187187..6bc597a 100644
--- a/dlls/dxva2/main.c
+++ b/dlls/dxva2/main.c
@@ -725,15 +725,45 @@ static HRESULT WINAPI device_manager_decoder_service_CreateSurface(IDirectXVideo
             backbuffers, format, pool, usage, dxvaType, surfaces, shared_handle);
 }
 
-/* No decoding device is exposed (there is no hardware decode path behind this
- * D3D9 implementation): callers see an empty list and decode in software. */
+/* Stained Glass OS (7849): the decoders are the D3D9 device's, as on Windows, where the driver has
+ * them. A device that has them (DXVK's, sg-d3d) answers this private interface id with its
+ * IDirectXVideoDecoderService; the calls below go there. Without one no decoding device is exposed:
+ * callers see an empty list and decode in software. */
+static const GUID IID_ISgD3D9VideoDecoderService =
+    {0x1f6b2c7e, 0x3a8d, 0x4f05, {0x9c, 0x21, 0x5e, 0x4d, 0x7b, 0x9a, 0x0c, 0x13}};
+
+static IDirectXVideoDecoderService *decoder_backend(struct device_manager *manager)
+{
+    IDirectXVideoDecoderService *backend = NULL;
+
+#ifdef SG_MUTANT_DXVA2_NO_BACKEND
+    return NULL;
+#endif
+    EnterCriticalSection(&manager->cs);
+    if (manager->device && FAILED(IDirect3DDevice9_QueryInterface(manager->device, &IID_ISgD3D9VideoDecoderService,
+            (void **)&backend)))
+        backend = NULL;
+    LeaveCriticalSection(&manager->cs);
+    return backend;
+}
+
 static HRESULT WINAPI device_manager_decoder_service_GetDecoderDeviceGuids(IDirectXVideoDecoderService *iface,
         UINT *count, GUID **guids)
 {
+    struct device_manager *manager = impl_from_IDirectXVideoDecoderService(iface);
+    IDirectXVideoDecoderService *backend;
+    HRESULT hr;
+
     TRACE("%p, %p, %p.\n", iface, count, guids);
 
     if (!count || !guids)
         return E_POINTER;
+    if ((backend = decoder_backend(manager)))
+    {
+        hr = IDirectXVideoDecoderService_GetDecoderDeviceGuids(backend, count, guids);
+        IDirectXVideoDecoderService_Release(backend);
+        return hr;
+    }
     *count = 0;
     *guids = NULL;
     return S_OK;
@@ -742,10 +772,20 @@ static HRESULT WINAPI device_manager_decoder_service_GetDecoderDeviceGuids(IDire
 static HRESULT WINAPI device_manager_decoder_service_GetDecoderRenderTargets(IDirectXVideoDecoderService *iface,
         REFGUID guid, UINT *count, D3DFORMAT **formats)
 {
+    struct device_manager *manager = impl_from_IDirectXVideoDecoderService(iface);
+    IDirectXVideoDecoderService *backend;
+    HRESULT hr;
+
     TRACE("%p, %s, %p, %p.\n", iface, debugstr_guid(guid), count, formats);
 
     if (!count || !formats)
         return E_POINTER;
+    if ((backend = decoder_backend(manager)))
+    {
+        hr = IDirectXVideoDecoderService_GetDecoderRenderTargets(backend, guid, count, formats);
+        IDirectXVideoDecoderService_Release(backend);
+        return hr;
+    }
     *count = 0;
     *formats = NULL;
     return E_INVALIDARG;
@@ -754,10 +794,20 @@ static HRESULT WINAPI device_manager_decoder_service_GetDecoderRenderTargets(IDi
 static HRESULT WINAPI device_manager_decoder_service_GetDecoderConfigurations(IDirectXVideoDecoderService *iface,
         REFGUID guid, const DXVA2_VideoDesc *video_desc, void *reserved, UINT *count, DXVA2_ConfigPictureDecode **configs)
 {
+    struct device_manager *manager = impl_from_IDirectXVideoDecoderService(iface);
+    IDirectXVideoDecoderService *backend;
+    HRESULT hr;
+
     TRACE("%p, %s, %p, %p, %p, %p.\n", iface, debugstr_guid(guid), video_desc, reserved, count, configs);
 
     if (!count || !configs)
         return E_POINTER;
+    if ((backend = decoder_backend(manager)))
+    {
+        hr = IDirectXVideoDecoderService_GetDecoderConfigurations(backend, guid, video_desc, reserved, count, configs);
+        IDirectXVideoDecoderService_Release(backend);
+        return hr;
+    }
     *count = 0;
     *configs = NULL;
     return E_INVALIDARG;
@@ -767,11 +817,21 @@ static HRESULT WINAPI device_manager_decoder_service_CreateVideoDecoder(IDirectX
         REFGUID guid, const DXVA2_VideoDesc *video_desc, const DXVA2_ConfigPictureDecode *config, IDirect3DSurface9 **rts,
         UINT num_surfaces, IDirectXVideoDecoder **decoder)
 {
+    struct device_manager *manager = impl_from_IDirectXVideoDecoderService(iface);
+    IDirectXVideoDecoderService *backend;
+    HRESULT hr;
+
     TRACE("%p, %s, %p, %p, %p, %u, %p.\n", iface, debugstr_guid(guid), video_desc, config, rts, num_surfaces,
             decoder);
 
     if (!decoder)
         return E_POINTER;
+    if ((backend = decoder_backend(manager)))
+    {
+        hr = IDirectXVideoDecoderService_CreateVideoDecoder(backend, guid, video_desc, config, rts, num_surfaces, decoder);
+        IDirectXVideoDecoderService_Release(backend);
+        return hr;
+    }
     *decoder = NULL;
     return E_INVALIDARG;
 }
