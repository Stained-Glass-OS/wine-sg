From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wined3d: no D3DPRASTERCAPS_PAT where line patterns are ignored

OpenGL core contexts have no glLineStipple, so wined3d ignores
D3DRS_LINEPATTERN there -- yet it reported D3DPRASTERCAPS_PAT, and every
device printed "Setting line patterns is not supported in OpenGL core
contexts" for the default state (no pattern), which runtime censuses counted
against 3 programs. As a Direct3D driver without line patterns does, the
device does not report PAT in a core context (nor on Vulkan) and a pattern
set anyway is ignored, with a WARN only when one is set. Legacy contexts keep
PAT and glLineStipple.

Gate: test/d3dlinepat-gate.sh (mutant SG_MUTANT_PAT_ALWAYS).
---
--- a/dlls/wined3d/adapter_gl.c
+++ b/dlls/wined3d/adapter_gl.c
@@ -4133,6 +4133,13 @@
     if (gl_info->supported[ARB_SAMPLER_OBJECTS] || gl_info->supported[EXT_TEXTURE_LOD_BIAS])
         caps->RasterCaps |= WINED3DPRASTERCAPS_MIPMAPLODBIAS;
 
+    /* Line patterns are glLineStipple, which core contexts do not have: like a Direct3D driver
+     * without the capability, the device does not report it and ignores D3DRS_LINEPATTERN. */
+#ifndef SG_MUTANT_PAT_ALWAYS
+    if (!gl_info->supported[WINED3D_GL_LEGACY_CONTEXT])
+        caps->RasterCaps &= ~WINED3DPRASTERCAPS_PAT;
+#endif
+
     if (gl_info->supported[ARB_TEXTURE_FILTER_ANISOTROPIC])
     {
         caps->RasterCaps |= WINED3DPRASTERCAPS_ANISOTROPY;
--- a/dlls/wined3d/adapter_vk.c
+++ b/dlls/wined3d/adapter_vk.c
@@ -563,6 +563,8 @@
             | WINED3DPMISCCAPS_SEPARATEALPHABLEND;
 
     caps->RasterCaps |= WINED3DPRASTERCAPS_MIPMAPLODBIAS;
+    /* no line patterns (D3DRS_LINEPATTERN is ignored) */
+    caps->RasterCaps &= ~WINED3DPRASTERCAPS_PAT;
 
     if (sampler_anisotropy)
     {
--- a/dlls/wined3d/ffp_gl.c
+++ b/dlls/wined3d/ffp_gl.c
@@ -875,8 +875,11 @@
 {
     static unsigned int once;
 
-    if (!once++)
-        FIXME("Setting line patterns is not supported in OpenGL core contexts.\n");
+    /* WINED3DPRASTERCAPS_PAT is not reported here, so a pattern is ignored as Direct3D drivers
+     * without it do; the default (no pattern) is no fault at all. */
+    if ((state->render_states[WINED3D_RS_LINEPATTERN] & 0xffff) && !once++)
+        WARN("Ignoring line pattern %#lx: no line patterns in OpenGL core contexts.\n",
+                (unsigned long)state->render_states[WINED3D_RS_LINEPATTERN]);
 }
 
 void state_pointsprite_w(struct wined3d_context *context, const struct wined3d_state *state, DWORD state_id)
