-GetEffectiveRightsFromAclA( PACL pacl, PTRUSTEEA pTrustee, PACCESS_MASK pAccessRights )
+/* Stained Glass OS: the trustee-in-an-ACL evaluators. Windows evaluates the ACEs of the trustee and of the
+ * groups it belongs to; the group part here is only known for the user of the calling token (GUESS). */
+static DWORD rights_trustee_sid( const TRUSTEEW *trustee, BYTE *buf, PSID *sid )
 {
-    FIXME("%p %p %p - stub\n", pacl, pTrustee, pAccessRights);
+    TRUSTEEW tmp;
+    DWORD err;
+
+    if (!trustee) return ERROR_INVALID_PARAMETER;
+    switch (trustee->TrusteeForm)
+    {
+    case TRUSTEE_IS_OBJECTS_AND_SID:
+    {
+        OBJECTS_AND_SID *os = (OBJECTS_AND_SID *)trustee->ptstrName;
+        if (!os || !os->pSid || !IsValidSid( os->pSid )) return ERROR_INVALID_PARAMETER;
+        *sid = os->pSid;
+        return ERROR_SUCCESS;
+    }
+    case TRUSTEE_IS_OBJECTS_AND_NAME:
+    {
+        OBJECTS_AND_NAME_W *on = (OBJECTS_AND_NAME_W *)trustee->ptstrName;
+        if (!on || !on->ptstrName) return ERROR_INVALID_PARAMETER;
+        tmp = *trustee;
+        tmp.TrusteeForm = TRUSTEE_IS_NAME;
+        tmp.ptstrName = on->ptstrName;
+        trustee = &tmp;
+        break;
+    }
+    case TRUSTEE_IS_SID:
+        if (!trustee->ptstrName || !IsValidSid( (PSID)trustee->ptstrName )) return ERROR_INVALID_PARAMETER;
+        break;
+    case TRUSTEE_IS_NAME:
+        if (!trustee->ptstrName) return ERROR_INVALID_PARAMETER;
+        break;
+    default:
+        return ERROR_INVALID_PARAMETER;
+    }
+    if ((err = trustee_to_sid( sizeof(MAX_SID), buf, (PTRUSTEEW)trustee ))) return err;
+    *sid = buf;
+    return ERROR_SUCCESS;
+}
+
+static BOOL trustee_is_current_user( PSID sid )
+{
+    BYTE buf[sizeof(TOKEN_USER) + sizeof(MAX_SID)];
+    HANDLE token;
+    DWORD len;
+    BOOL ret = FALSE;
+
+    if (!OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )) return FALSE;
+    if (GetTokenInformation( token, TokenUser, buf, sizeof(buf), &len ))
+        ret = EqualSid( ((TOKEN_USER *)buf)->User.Sid, sid );
+    CloseHandle( token );
+    return ret;
+}
+
+/* does an ACE for ace_sid apply to the trustee? */
+static BOOL ace_sid_applies( PSID ace_sid, PSID trustee, BOOL is_current )
+{
+    static const SID_IDENTIFIER_AUTHORITY world = { SECURITY_WORLD_SID_AUTHORITY };
+    BOOL member;
+
+    if (EqualSid( ace_sid, trustee )) return TRUE;
+    if (*GetSidSubAuthorityCount( ace_sid ) == 1 && *GetSidSubAuthority( ace_sid, 0 ) == SECURITY_WORLD_RID &&
+        !memcmp( GetSidIdentifierAuthority( ace_sid ), &world, sizeof(world) ))
+        return TRUE;
+    if (is_current && CheckTokenMembership( NULL, ace_sid, &member )) return member;
+    return FALSE;
+}
