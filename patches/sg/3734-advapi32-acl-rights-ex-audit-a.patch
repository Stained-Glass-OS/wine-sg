+    if ((err = trustee_A_to_W( pTrustee, &w ))) return err;
+    err = GetAuditedPermissionsFromAclW( pacl, &w, pSuccessfulAuditedRights, pFailedAuditRights );
+    free_trustee_name( w.TrusteeForm, w.ptstrName );
+    return err;
 }
 
