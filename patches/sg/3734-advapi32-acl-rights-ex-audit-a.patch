+}
+
+static DWORD explicit_A_to_W( const EXPLICIT_ACCESSA *in, ULONG count, EXPLICIT_ACCESSW **out )
+{
+    EXPLICIT_ACCESSW *w;
+    ULONG i;
+    DWORD err;
+
+    *out = NULL;
+    if (!in) return ERROR_SUCCESS;
+    if (!(w = calloc( count ? count : 1, sizeof(*w) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    for (i = 0; i < count; i++)
+    {
+        w[i].grfAccessPermissions = in[i].grfAccessPermissions;
+        w[i].grfAccessMode = in[i].grfAccessMode;
+        w[i].grfInheritance = in[i].grfInheritance;
+        if ((err = trustee_A_to_W( &in[i].Trustee, &w[i].Trustee )))
+        {
+            free_explicit_A_to_W( w, i );
+            return err;
+        }
+    }
+    *out = w;
+    return ERROR_SUCCESS;
+}
