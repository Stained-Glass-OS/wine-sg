+/* the account name of a SID as the ACL helpers show it: "DOMAIN\name", or the SID string when it has no account
+ * (GUESS: Windows fails when the name cannot be resolved). The result is malloc'ed. */
+static WCHAR *sid_to_account_string( PSID sid, TRUSTEE_TYPE *type )
+{
+    WCHAR name[256], domain[256], *ret, *str;
+    DWORD nlen = ARRAY_SIZE(name), dlen = ARRAY_SIZE(domain);
+    SID_NAME_USE use;
+
+    *type = TRUSTEE_IS_UNKNOWN;
+    if (LookupAccountSidW( NULL, sid, name, &nlen, domain, &dlen, &use ))
+    {
+        switch (use)
+        {
+        case SidTypeUser: *type = TRUSTEE_IS_USER; break;
+        case SidTypeGroup: *type = TRUSTEE_IS_GROUP; break;
+        case SidTypeDomain: *type = TRUSTEE_IS_DOMAIN; break;
+        case SidTypeAlias: *type = TRUSTEE_IS_ALIAS; break;
+        case SidTypeWellKnownGroup: *type = TRUSTEE_IS_WELL_KNOWN_GROUP; break;
+        case SidTypeDeletedAccount: *type = TRUSTEE_IS_DELETED; break;
+        case SidTypeInvalid: *type = TRUSTEE_IS_INVALID; break;
+        default: break;
+        }
+        if (!(ret = malloc( (dlen + 1 + nlen + 1) * sizeof(WCHAR) ))) return NULL;
+        if (dlen) swprintf( ret, dlen + 1 + nlen + 1, L"%s\\%s", domain, name );
+        else lstrcpyW( ret, name );
+        return ret;
+    }
+    if (!ConvertSidToStringSidW( sid, &str )) return NULL;
+    ret = wcsdup( str );
+    LocalFree( str );
+    return ret;
+}
+
+/* the DACL (or SACL) as one LocalAlloc block: the EXPLICIT_ACCESS array, then the trustee names */
+static DWORD acl_to_named_entries( PACL acl, BOOL audit, ULONG *count, EXPLICIT_ACCESSW **list )
+{
+    ACL_SIZE_INFORMATION info;
+    EXPLICIT_ACCESSW *tmp, *out;
+    WCHAR **names;
+    ULONG i, n = 0, chars = 0;
+    DWORD err = ERROR_SUCCESS;
+    WCHAR *pos;
+
+    *count = 0;
+    *list = NULL;
+    if (!acl) return ERROR_SUCCESS;
+    if (RtlQueryInformationAcl( acl, &info, sizeof(info), AclSizeInformation )) return ERROR_INVALID_ACL;
+    if (!info.AceCount) return ERROR_SUCCESS;
+    tmp = calloc( info.AceCount * 2, sizeof(*tmp) );
+    names = calloc( info.AceCount * 2, sizeof(*names) );
+    if (!tmp || !names) { free( tmp ); free( names ); return ERROR_NOT_ENOUGH_MEMORY; }
+
+    for (i = 0; i < info.AceCount; i++)
+    {
+        ACE_HEADER *ace;
+        ACCESS_MODE modes[2];
+        int nm = 0, k;
+        TRUSTEE_TYPE type;
+        WCHAR *name;
+
+        RtlGetAce( acl, i, (void **)&ace );
+        if (!audit && ace->AceType == ACCESS_ALLOWED_ACE_TYPE) modes[nm++] = GRANT_ACCESS;
+        else if (!audit && ace->AceType == ACCESS_DENIED_ACE_TYPE) modes[nm++] = DENY_ACCESS;
+        else if (audit && ace->AceType == SYSTEM_AUDIT_ACE_TYPE)
+        {
+            if (ace->AceFlags & SUCCESSFUL_ACCESS_ACE_FLAG) modes[nm++] = SET_AUDIT_SUCCESS;
+            if (ace->AceFlags & FAILED_ACCESS_ACE_FLAG) modes[nm++] = SET_AUDIT_FAILURE;
+        }
+        if (!nm) continue;
+        if (!(name = sid_to_account_string( (PSID)&((ACCESS_ALLOWED_ACE *)ace)->SidStart, &type )))
+        {
+            err = ERROR_NOT_ENOUGH_MEMORY;
+            goto done;
+        }
+        for (k = 0; k < nm; k++)
+        {
+            tmp[n].grfAccessPermissions = ((ACCESS_ALLOWED_ACE *)ace)->Mask;
+            tmp[n].grfAccessMode = modes[k];
+            tmp[n].grfInheritance = ace->AceFlags & (OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE |
+                                                     NO_PROPAGATE_INHERIT_ACE | INHERIT_ONLY_ACE);
+            tmp[n].Trustee.MultipleTrusteeOperation = NO_MULTIPLE_TRUSTEE;
+            tmp[n].Trustee.TrusteeForm = TRUSTEE_IS_NAME;
+            tmp[n].Trustee.TrusteeType = type;
+            names[n] = k ? wcsdup( name ) : name;
+            chars += lstrlenW( name ) + 1;
+            n++;
+        }
+        if (nm == 0) free( name );
+    }
+    if (n)
+    {
+        if (!(out = LocalAlloc( LMEM_FIXED | LMEM_ZEROINIT, n * sizeof(*out) + chars * sizeof(WCHAR) )))
+        {
+            err = ERROR_NOT_ENOUGH_MEMORY;
+            goto done;
+        }
+        pos = (WCHAR *)(out + n);
+        for (i = 0; i < n; i++)
+        {
+            out[i] = tmp[i];
+            out[i].Trustee.ptstrName = pos;
+            lstrcpyW( pos, names[i] );
+            pos += lstrlenW( names[i] ) + 1;
+        }
+        *list = out;
+        *count = n;
+    }
+done:
+    for (i = 0; i < info.AceCount * 2; i++) free( names[i] );
+    free( tmp );
+    free( names );
+    return err;
+}
