+DWORD WINAPI GetEffectiveRightsFromAclW( PACL pacl, PTRUSTEEW pTrustee, PACCESS_MASK pAccessRights )
+{
+    ACL_SIZE_INFORMATION info;
+    BYTE sidbuf[sizeof(MAX_SID)];
+    ACCESS_MASK granted = 0, denied = 0;
+    PSID sid;
+    BOOL current;
+    DWORD err, i;
+
+    TRACE( "%p %p %p\n", pacl, pTrustee, pAccessRights );
+
+    if (!pacl || !pTrustee || !pAccessRights) return ERROR_INVALID_PARAMETER;
+    if (!RtlValidAcl( pacl )) return ERROR_INVALID_ACL;
+    if ((err = rights_trustee_sid( pTrustee, sidbuf, &sid ))) return err;
+    if (RtlQueryInformationAcl( pacl, &info, sizeof(info), AclSizeInformation )) return ERROR_INVALID_ACL;
+    current = trustee_is_current_user( sid );
+
+    /* an inherited access-denied ACE makes the ACL unusable for this function (documented) */
+    for (i = 0; i < info.AceCount; i++)
+    {
+        ACE_HEADER *ace;
+        if (RtlGetAce( pacl, i, (void **)&ace )) return ERROR_INVALID_ACL;
+        if (ace->AceType == ACCESS_DENIED_ACE_TYPE && (ace->AceFlags & INHERITED_ACE)) return ERROR_INVALID_ACL;
+    }
+
+    for (i = 0; i < info.AceCount; i++)
+    {
+        ACE_HEADER *ace;
+        ACCESS_MASK mask;
 
-    *pAccessRights = STANDARD_RIGHTS_ALL | SPECIFIC_RIGHTS_ALL;
-    return 0;
+        RtlGetAce( pacl, i, (void **)&ace );
+        if (ace->AceType != ACCESS_ALLOWED_ACE_TYPE && ace->AceType != ACCESS_DENIED_ACE_TYPE) continue;
+        if (ace->AceFlags & INHERIT_ONLY_ACE) continue;
+        if (!ace_sid_applies( (PSID)&((ACCESS_ALLOWED_ACE *)ace)->SidStart, sid, current )) continue;
+        mask = ((ACCESS_ALLOWED_ACE *)ace)->Mask;
+        if (ace->AceType == ACCESS_ALLOWED_ACE_TYPE) granted |= mask & ~denied;
+        else denied |= mask & ~granted;
+    }
+    *pAccessRights = granted;
+    return ERROR_SUCCESS;
 }
 
