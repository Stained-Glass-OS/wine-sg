+static void free_explicit_A_to_W( EXPLICIT_ACCESSW *list, ULONG count )
+{
+    ULONG i;
+    for (i = 0; i < count; i++) free_trustee_name( list[i].Trustee.TrusteeForm, list[i].Trustee.ptstrName );
