+/* Stained Glass OS: GetSecurityInfoEx / GetNamedSecurityInfoEx for the Windows provider (the only one).
+ * The DACL and the SACL come back as ACTRL_ACCESS / ACTRL_AUDIT lists (one property entry, the object itself,
+ * with one entry per ACE, the trustees named), the owner and group as account names; every output is one
+ * LocalAlloc block. How Windows fills ProvSpecificAccess is not documented: it is 0 here (GUESS). */
+static DWORD named_entries_to_actrl( const EXPLICIT_ACCESSW *e, ULONG n, ACTRL_ACCESSW **out )
+{
+    ACTRL_ACCESSW *list;
+    ACTRL_PROPERTY_ENTRYW *prop;
+    ACTRL_ACCESS_ENTRY_LISTW *elist;
+    ACTRL_ACCESS_ENTRYW *entries;
+    WCHAR *pos;
+    ULONG i, chars = 0;
+
+    for (i = 0; i < n; i++) chars += lstrlenW( e[i].Trustee.ptstrName ) + 1;
+    if (!(list = LocalAlloc( LMEM_FIXED | LMEM_ZEROINIT, sizeof(*list) + sizeof(*prop) + sizeof(*elist) +
+                             n * sizeof(*entries) + chars * sizeof(WCHAR) )))
+        return ERROR_NOT_ENOUGH_MEMORY;
+    prop = (ACTRL_PROPERTY_ENTRYW *)(list + 1);
+    elist = (ACTRL_ACCESS_ENTRY_LISTW *)(prop + 1);
+    entries = (ACTRL_ACCESS_ENTRYW *)(elist + 1);
+    pos = (WCHAR *)(entries + n);
+    list->cEntries = 1;
+    list->pPropertyAccessList = prop;
+    prop->lpProperty = NULL;
+    prop->pAccessEntryList = elist;
+    elist->cEntries = n;
+    elist->pAccessList = entries;
+    for (i = 0; i < n; i++)
+    {
+        entries[i].Trustee = e[i].Trustee;
+        entries[i].Trustee.ptstrName = pos;
+        lstrcpyW( pos, e[i].Trustee.ptstrName );
+        pos += lstrlenW( pos ) + 1;
+        switch (e[i].grfAccessMode)
+        {
+        case GRANT_ACCESS: entries[i].fAccessFlags = ACTRL_ACCESS_ALLOWED; break;
+        case DENY_ACCESS: entries[i].fAccessFlags = ACTRL_ACCESS_DENIED; break;
+        case SET_AUDIT_SUCCESS: entries[i].fAccessFlags = ACTRL_AUDIT_SUCCESS; break;
+        case SET_AUDIT_FAILURE: entries[i].fAccessFlags = ACTRL_AUDIT_FAILURE; break;
+        default: break;
+        }
+        entries[i].Access = e[i].grfAccessPermissions;
+        entries[i].Inheritance = e[i].grfInheritance;
+    }
+    *out = list;
+    return ERROR_SUCCESS;
+}
+
+static DWORD fill_security_info_ex( PSECURITY_DESCRIPTOR sd, SECURITY_INFORMATION info, ACTRL_ACCESSW **access,
+                                    ACTRL_ACCESSW **audit, WCHAR **owner, WCHAR **group )
+{
+    BOOLEAN present, defaulted;
+    EXPLICIT_ACCESSW *list;
+    PACL acl;
+    PSID sid;
+    ULONG n;
+    DWORD err = ERROR_SUCCESS;
+    int i;
+
+    if (access && (info & DACL_SECURITY_INFORMATION))
+    {
+        RtlGetDaclSecurityDescriptor( sd, &present, &acl, &defaulted );
+        if (present && acl)
+        {
+            if (!(err = acl_to_named_entries( acl, FALSE, &n, &list )))
+            {
+                err = named_entries_to_actrl( list, n, access );
+                LocalFree( list );
+            }
+        }
+    }
+    if (!err && audit && (info & SACL_SECURITY_INFORMATION))
+    {
+        RtlGetSaclSecurityDescriptor( sd, &present, &acl, &defaulted );
+        if (present && acl)
+        {
+            if (!(err = acl_to_named_entries( acl, TRUE, &n, &list )))
+            {
+                err = named_entries_to_actrl( list, n, audit );
+                LocalFree( list );
+            }
+        }
+    }
+    for (i = 0; i < 2 && !err; i++)
+    {
+        WCHAR **dst = i ? group : owner, *name, *copy;
+        TRUSTEE_TYPE type;
+
+        if (!dst || !(info & (i ? GROUP_SECURITY_INFORMATION : OWNER_SECURITY_INFORMATION))) continue;
+        if (i) RtlGetGroupSecurityDescriptor( sd, &sid, &defaulted );
+        else RtlGetOwnerSecurityDescriptor( sd, &sid, &defaulted );
+        if (!sid) continue;
+        if (!(name = sid_to_account_string( sid, &type ))) { err = ERROR_NOT_ENOUGH_MEMORY; break; }
+        if ((copy = LocalAlloc( LMEM_FIXED, (lstrlenW( name ) + 1) * sizeof(WCHAR) ))) { lstrcpyW( copy, name ); *dst = copy; }
+        else err = ERROR_NOT_ENOUGH_MEMORY;
+        free( name );
+    }
+    if (err)
+    {
+        if (access) { LocalFree( *access ); *access = NULL; }
+        if (audit) { LocalFree( *audit ); *audit = NULL; }
+        if (owner) { LocalFree( *owner ); *owner = NULL; }
+        if (group) { LocalFree( *group ); *group = NULL; }
+    }
+    return err;
+}
+
+static BOOL is_windows_provider( const WCHAR *provider )
+{
+    return !provider || !wcsicmp( provider, L"Windows Provider" );
+}
+
+DWORD WINAPI GetSecurityInfoExW( HANDLE handle, SE_OBJECT_TYPE type, SECURITY_INFORMATION info, LPCWSTR provider,
+                                 LPCWSTR property, PACTRL_ACCESSW *access, PACTRL_AUDITW *audit, LPWSTR *owner, LPWSTR *group )
+{
+    PSECURITY_DESCRIPTOR sd;
+    DWORD err;
+
+    TRACE( "%p %d %#lx %s %s %p %p %p %p\n", handle, type, info, debugstr_w(provider), debugstr_w(property),
+           access, audit, owner, group );
+
+    if (!is_windows_provider( provider )) return ERROR_BAD_PROVIDER;
+    if (property) return ERROR_INVALID_PARAMETER;  /* GUESS: the Windows provider has no properties */
+    if (access) *access = NULL;
+    if (audit) *audit = NULL;
+    if (owner) *owner = NULL;
+    if (group) *group = NULL;
+    if ((err = GetSecurityInfo( handle, type, info, NULL, NULL, NULL, NULL, &sd ))) return err;
+    err = fill_security_info_ex( sd, info, access, audit, owner, group );
+    LocalFree( sd );
+    return err;
+}
+
+DWORD WINAPI GetNamedSecurityInfoExW( LPCWSTR object, SE_OBJECT_TYPE type, SECURITY_INFORMATION info, LPCWSTR provider,
+                                      LPCWSTR property, PACTRL_ACCESSW *access, PACTRL_AUDITW *audit, LPWSTR *owner, LPWSTR *group )
+{
+    PSECURITY_DESCRIPTOR sd;
+    DWORD err;
+
+    TRACE( "%s %d %#lx %s %s %p %p %p %p\n", debugstr_w(object), type, info, debugstr_w(provider),
+           debugstr_w(property), access, audit, owner, group );
+
+    if (!is_windows_provider( provider )) return ERROR_BAD_PROVIDER;
+    if (!object || property) return ERROR_INVALID_PARAMETER;
+    if (access) *access = NULL;
+    if (audit) *audit = NULL;
+    if (owner) *owner = NULL;
+    if (group) *group = NULL;
+    if ((err = GetNamedSecurityInfoW( object, type, info, NULL, NULL, NULL, NULL, &sd ))) return err;
+    err = fill_security_info_ex( sd, info, access, audit, owner, group );
+    LocalFree( sd );
+    return err;
+}
+
+/* the A forms: the same blocks with the trustee names and the owner and group in the ANSI page */
+static DWORD actrl_W_to_A( ACTRL_ACCESSW *w, ACTRL_ACCESSA **out )
+{
+    ACTRL_ACCESSA *a;
+    ACTRL_PROPERTY_ENTRYA *prop;
+    ACTRL_ACCESS_ENTRY_LISTA *elist;
+    ACTRL_ACCESS_ENTRYA *entries;
+    ULONG i, n, bytes = 0;
+    char *pos;
+
+    n = w->pPropertyAccessList->pAccessEntryList->cEntries;
+    for (i = 0; i < n; i++)
+        bytes += WideCharToMultiByte( CP_ACP, 0, w->pPropertyAccessList->pAccessEntryList->pAccessList[i].Trustee.ptstrName,
+                                      -1, NULL, 0, NULL, NULL );
+    if (!(a = LocalAlloc( LMEM_FIXED | LMEM_ZEROINIT, sizeof(*a) + sizeof(*prop) + sizeof(*elist) + n * sizeof(*entries) + bytes )))
+        return ERROR_NOT_ENOUGH_MEMORY;
+    prop = (ACTRL_PROPERTY_ENTRYA *)(a + 1);
+    elist = (ACTRL_ACCESS_ENTRY_LISTA *)(prop + 1);
+    entries = (ACTRL_ACCESS_ENTRYA *)(elist + 1);
+    pos = (char *)(entries + n);
+    a->cEntries = 1;
+    a->pPropertyAccessList = prop;
+    prop->pAccessEntryList = elist;
+    elist->cEntries = n;
+    elist->pAccessList = entries;
+    for (i = 0; i < n; i++)
+    {
+        ACTRL_ACCESS_ENTRYW *src = &w->pPropertyAccessList->pAccessEntryList->pAccessList[i];
+        int len = WideCharToMultiByte( CP_ACP, 0, src->Trustee.ptstrName, -1, pos, bytes, NULL, NULL );
+
+        entries[i].Trustee.MultipleTrusteeOperation = src->Trustee.MultipleTrusteeOperation;
+        entries[i].Trustee.TrusteeForm = src->Trustee.TrusteeForm;
+        entries[i].Trustee.TrusteeType = src->Trustee.TrusteeType;
+        entries[i].Trustee.ptstrName = pos;
+        pos += len;
+        entries[i].fAccessFlags = src->fAccessFlags;
+        entries[i].Access = src->Access;
+        entries[i].ProvSpecificAccess = src->ProvSpecificAccess;
+        entries[i].Inheritance = src->Inheritance;
+    }
+    *out = a;
+    return ERROR_SUCCESS;
+}
+
+static DWORD ex_W_to_A( ACTRL_ACCESSW *accessW, ACTRL_ACCESSW *auditW, WCHAR *ownerW, WCHAR *groupW,
+                        ACTRL_ACCESSA **access, ACTRL_ACCESSA **audit, char **owner, char **group )
+{
+    DWORD err = ERROR_SUCCESS;
+    int i;
+
+    if (access && accessW) err = actrl_W_to_A( accessW, access );
+    if (!err && audit && auditW) err = actrl_W_to_A( auditW, audit );
+    for (i = 0; i < 2 && !err; i++)
+    {
+        WCHAR *src = i ? groupW : ownerW;
+        char **dst = i ? group : owner;
+        int len;
+
+        if (!dst || !src) continue;
+        len = WideCharToMultiByte( CP_ACP, 0, src, -1, NULL, 0, NULL, NULL );
+        if (!(*dst = LocalAlloc( LMEM_FIXED, len ))) { err = ERROR_NOT_ENOUGH_MEMORY; break; }
+        WideCharToMultiByte( CP_ACP, 0, src, -1, *dst, len, NULL, NULL );
+    }
+    if (err)
+    {
+        if (access) { LocalFree( *access ); *access = NULL; }
+        if (audit) { LocalFree( *audit ); *audit = NULL; }
+        if (owner) { LocalFree( *owner ); *owner = NULL; }
+        if (group) { LocalFree( *group ); *group = NULL; }
+    }
+    return err;
+}
+
+DWORD WINAPI GetSecurityInfoExA( HANDLE handle, SE_OBJECT_TYPE type, SECURITY_INFORMATION info, LPCSTR provider,
+                                 LPCSTR property, PACTRL_ACCESSA *access, PACTRL_AUDITA *audit, LPSTR *owner, LPSTR *group )
+{
+    WCHAR *providerW = provider ? strdupAW( provider ) : NULL, *propertyW = property ? strdupAW( property ) : NULL;
+    ACTRL_ACCESSW *accessW = NULL, *auditW = NULL;
+    WCHAR *ownerW = NULL, *groupW = NULL;
+    DWORD err;
+
+    err = GetSecurityInfoExW( handle, type, info, providerW, propertyW, access ? &accessW : NULL, audit ? &auditW : NULL,
+                              owner ? &ownerW : NULL, group ? &groupW : NULL );
+    if (!err) err = ex_W_to_A( accessW, auditW, ownerW, groupW, access, audit, owner, group );
+    LocalFree( accessW ); LocalFree( auditW ); LocalFree( ownerW ); LocalFree( groupW );
+    free( providerW ); free( propertyW );
+    return err;
+}
+
+DWORD WINAPI GetNamedSecurityInfoExA( LPCSTR object, SE_OBJECT_TYPE type, SECURITY_INFORMATION info, LPCSTR provider,
+                                      LPCSTR property, PACTRL_ACCESSA *access, PACTRL_AUDITA *audit, LPSTR *owner, LPSTR *group )
+{
+    WCHAR *objectW = object ? strdupAW( object ) : NULL, *providerW = provider ? strdupAW( provider ) : NULL;
+    WCHAR *propertyW = property ? strdupAW( property ) : NULL;
+    ACTRL_ACCESSW *accessW = NULL, *auditW = NULL;
+    WCHAR *ownerW = NULL, *groupW = NULL;
+    DWORD err;
+
+    err = GetNamedSecurityInfoExW( objectW, type, info, providerW, propertyW, access ? &accessW : NULL,
+                                   audit ? &auditW : NULL, owner ? &ownerW : NULL, group ? &groupW : NULL );
+    if (!err) err = ex_W_to_A( accessW, auditW, ownerW, groupW, access, audit, owner, group );
+    LocalFree( accessW ); LocalFree( auditW ); LocalFree( ownerW ); LocalFree( groupW );
+    free( objectW ); free( providerW ); free( propertyW );
+    return err;
 }
