+
+    /* each block: structures then the names, converted in place of the W names (a W name needs at most
+     * as many bytes as the A name needs chars times two; reserve 3 bytes per char for MBCS) */
+#define CONV_TRUSTEE( dst, src ) do { \
+        if (src) { \
+            int len = WideCharToMultiByte( CP_ACP, 0, (src)->ptstrName, -1, NULL, 0, NULL, NULL ); \
+            (dst) = LocalAlloc( LMEM_FIXED | LMEM_ZEROINIT, sizeof(*(dst)) + len ); \
+            if (!(dst)) { err = ERROR_NOT_ENOUGH_MEMORY; goto fail; } \
+            (dst)->MultipleTrusteeOperation = (src)->MultipleTrusteeOperation; \
+            (dst)->TrusteeForm = (src)->TrusteeForm; \
+            (dst)->TrusteeType = (src)->TrusteeType; \
+            (dst)->ptstrName = (char *)((dst) + 1); \
+            WideCharToMultiByte( CP_ACP, 0, (src)->ptstrName, -1, (dst)->ptstrName, len, NULL, NULL ); \
+        } } while (0)
+#define CONV_LIST( dst, src, n ) do { \
+        if (src) { \
+            ULONG total = 0, k; \
+            char *p; \
+            for (k = 0; k < (n); k++) total += WideCharToMultiByte( CP_ACP, 0, (src)[k].Trustee.ptstrName, -1, NULL, 0, NULL, NULL ); \
+            (dst) = LocalAlloc( LMEM_FIXED | LMEM_ZEROINIT, ((n) ? (n) : 1) * sizeof(*(dst)) + total ); \
+            if (!(dst)) { err = ERROR_NOT_ENOUGH_MEMORY; goto fail; } \
+            p = (char *)((dst) + ((n) ? (n) : 1)); \
+            for (k = 0; k < (n); k++) { \
+                int len = WideCharToMultiByte( CP_ACP, 0, (src)[k].Trustee.ptstrName, -1, p, total, NULL, NULL ); \
+                (dst)[k].grfAccessPermissions = (src)[k].grfAccessPermissions; \
+                (dst)[k].grfAccessMode = (src)[k].grfAccessMode; \
+                (dst)[k].grfInheritance = (src)[k].grfInheritance; \
+                (dst)[k].Trustee.MultipleTrusteeOperation = (src)[k].Trustee.MultipleTrusteeOperation; \
+                (dst)[k].Trustee.TrusteeForm = (src)[k].Trustee.TrusteeForm; \
+                (dst)[k].Trustee.TrusteeType = (src)[k].Trustee.TrusteeType; \
+                (dst)[k].Trustee.ptstrName = p; \
+                p += len; \
+            } \
+        } } while (0)
+    CONV_TRUSTEE( oa, ow );
+    CONV_TRUSTEE( ga, gw );
+    CONV_LIST( aa, aw, ac );
+    CONV_LIST( ua, uw, uc );
