+DWORD WINAPI GetAuditedPermissionsFromAclW( PACL pacl, PTRUSTEEW pTrustee, PACCESS_MASK pSuccessfulAuditedRights,
+                                            PACCESS_MASK pFailedAuditRights )
+{
+    ACL_SIZE_INFORMATION info;
+    BYTE sidbuf[sizeof(MAX_SID)];
+    ACCESS_MASK success = 0, failure = 0;
+    PSID sid;
+    BOOL current;
+    DWORD err, i;
+
+    TRACE( "%p %p %p %p\n", pacl, pTrustee, pSuccessfulAuditedRights, pFailedAuditRights );
+
+    if (!pacl || !pTrustee || !pSuccessfulAuditedRights || !pFailedAuditRights) return ERROR_INVALID_PARAMETER;
+    if (!RtlValidAcl( pacl )) return ERROR_INVALID_ACL;
+    if ((err = rights_trustee_sid( pTrustee, sidbuf, &sid ))) return err;
+    if (RtlQueryInformationAcl( pacl, &info, sizeof(info), AclSizeInformation )) return ERROR_INVALID_ACL;
+    current = trustee_is_current_user( sid );
+
+    for (i = 0; i < info.AceCount; i++)
+    {
+        ACE_HEADER *ace;
+
+        if (RtlGetAce( pacl, i, (void **)&ace )) return ERROR_INVALID_ACL;
+        if (ace->AceType != SYSTEM_AUDIT_ACE_TYPE) continue;
+        if (ace->AceFlags & INHERIT_ONLY_ACE) continue;
+        if (!ace_sid_applies( (PSID)&((SYSTEM_AUDIT_ACE *)ace)->SidStart, sid, current )) continue;
+        if (ace->AceFlags & SUCCESSFUL_ACCESS_ACE_FLAG) success |= ((SYSTEM_AUDIT_ACE *)ace)->Mask;
+        if (ace->AceFlags & FAILED_ACCESS_ACE_FLAG) failure |= ((SYSTEM_AUDIT_ACE *)ace)->Mask;
+    }
+    *pSuccessfulAuditedRights = success;
+    *pFailedAuditRights = failure;
+    return ERROR_SUCCESS;
+}
+
+DWORD WINAPI GetAuditedPermissionsFromAclA( PACL pacl, PTRUSTEEA pTrustee, PACCESS_MASK pSuccessfulAuditedRights,
+                                            PACCESS_MASK pFailedAuditRights )
