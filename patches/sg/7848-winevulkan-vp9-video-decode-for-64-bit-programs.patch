From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winevulkan: VP9 video decode for 64-bit programs

VK_KHR_video_decode_vp9 is newer than the Vulkan registry winevulkan's
thunks were made from (1.4.303), so it was never offered to Windows
programs, and DXVK's D3D11 VP9 video decoders (sg-d3d,
dxvk/patches/0009) could not be offered.

It is now offered to 64-bit programs. Its feature structure
(VkPhysicalDeviceVideoDecodeVP9FeaturesKHR) is converted in
vkCreateDevice's chain; its profile, capability and picture structures
pass through as they are, as every other 64-bit video structure does. A
32-bit program is not offered it: its structures would need converting,
which they are not. include/wine/vulkan.h gains the extension's name,
its structure types and the feature structure.

Gate test-vkvp9 (on a host whose driver decodes VP9: 64-bit offered and
gets a device with the feature, 32-bit not offered). Mutant
SG_MUTANT_VP9_NOT_OFFERED (winevulkan/vulkan.c). sg-image's
videodecode-test decodes three VP9 clips bit-exact through it.
---
diff --git a/dlls/winevulkan/vulkan.c b/dlls/winevulkan/vulkan.c
index 192f41d..97fccd3 100644
--- a/dlls/winevulkan/vulkan.c
+++ b/dlls/winevulkan/vulkan.c
@@ -157,6 +157,20 @@ static BOOL use_external_memory(void)
     return is_wow64();
 }
 
+/* Stained Glass OS (7848): the device extensions offered. VK_KHR_video_decode_vp9 is newer than the
+ * registry these thunks were made from: its feature structure is converted for 64-bit callers only
+ * (vkCreateDevice), the rest of it passes through as it is; a 32-bit caller would need its structures
+ * converted, so it is not offered there. */
+static BOOL device_extension_offered(const char *name)
+{
+    if (!wine_vk_device_extension_supported(name)) return FALSE;
+#ifdef SG_MUTANT_VP9_NOT_OFFERED
+    if (!strcmp(name, "VK_KHR_video_decode_vp9")) return FALSE;
+#endif
+    if (!strcmp(name, "VK_KHR_video_decode_vp9") && (sizeof(void *) != sizeof(UINT64) || is_wow64())) return FALSE;
+    return TRUE;
+}
+
 static ULONG_PTR zero_bits = 0;
 
 #define wine_vk_count_struct(s, t) wine_vk_count_struct_((void *)s, VK_STRUCTURE_TYPE_##t)
@@ -457,7 +471,7 @@ static VkResult wine_vk_physical_device_init(struct wine_phys_dev *object, VkPhy
      */
     for (i = 0; i < num_host_properties; i++)
     {
-        if (wine_vk_device_extension_supported(host_properties[i].extensionName))
+        if (device_extension_offered(host_properties[i].extensionName))
         {
             TRACE("Enabling extension '%s' for physical device %p\n", host_properties[i].extensionName, object);
             num_properties++;
@@ -514,7 +528,7 @@ static VkResult wine_vk_physical_device_init(struct wine_phys_dev *object, VkPhy
 
     for (i = 0, j = 0; i < num_host_properties; i++)
     {
-        if (wine_vk_device_extension_supported(host_properties[i].extensionName))
+        if (device_extension_offered(host_properties[i].extensionName))
         {
             object->extensions[j] = host_properties[i];
             j++;
@@ -690,7 +704,7 @@ static VkResult wine_vk_device_convert_create_info(VkPhysicalDevice client_physi
     {
         const char *extension_name = extensions[i];
         TRACE("Extension %u: %s.\n", i, debugstr_a(extension_name));
-        if (!wine_vk_device_extension_supported(extension_name))
+        if (!device_extension_offered(extension_name))
         {
             WARN("Extension %s is not supported.\n", debugstr_a(extension_name));
             return VK_ERROR_EXTENSION_NOT_PRESENT;
diff --git a/dlls/winevulkan/vulkan_thunks.c b/dlls/winevulkan/vulkan_thunks.c
index 587df56..5820d08 100644
--- a/dlls/winevulkan/vulkan_thunks.c
+++ b/dlls/winevulkan/vulkan_thunks.c
@@ -16333,6 +16333,18 @@ static inline void convert_VkDeviceCreateInfo_win64_to_host(struct conversion_co
             out_header = (void *)out_ext;
             break;
         }
+        case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_DECODE_VP9_FEATURES_KHR:
+        {
+            /* Stained Glass OS (7848): VP9 video decode, for 64-bit callers (vulkan.c) */
+            VkPhysicalDeviceVideoDecodeVP9FeaturesKHR *out_ext = conversion_context_alloc(ctx, sizeof(*out_ext));
+            const VkPhysicalDeviceVideoDecodeVP9FeaturesKHR *in_ext = (const VkPhysicalDeviceVideoDecodeVP9FeaturesKHR *)in_header;
+            out_ext->sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_DECODE_VP9_FEATURES_KHR;
+            out_ext->pNext = NULL;
+            out_ext->videoDecodeVP9 = in_ext->videoDecodeVP9;
+            out_header->pNext = (void *)out_ext;
+            out_header = (void *)out_ext;
+            break;
+        }
         case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_MAINTENANCE_1_FEATURES_KHR:
         {
             VkPhysicalDeviceVideoMaintenance1FeaturesKHR *out_ext = conversion_context_alloc(ctx, sizeof(*out_ext));
@@ -55315,6 +55327,7 @@ static const char * const vk_device_extensions[] =
     "VK_KHR_video_decode_h264",
     "VK_KHR_video_decode_h265",
     "VK_KHR_video_decode_queue",
+    "VK_KHR_video_decode_vp9",
     "VK_KHR_video_encode_av1",
     "VK_KHR_video_encode_h264",
     "VK_KHR_video_encode_h265",
diff --git a/include/wine/vulkan.h b/include/wine/vulkan.h
index f1703db..65814b1 100644
--- a/include/wine/vulkan.h
+++ b/include/wine/vulkan.h
@@ -675,6 +675,8 @@
 #define VK_KHR_COMPUTE_SHADER_DERIVATIVES_EXTENSION_NAME "VK_KHR_compute_shader_derivatives"
 #define VK_KHR_VIDEO_DECODE_AV1_SPEC_VERSION 1
 #define VK_KHR_VIDEO_DECODE_AV1_EXTENSION_NAME "VK_KHR_video_decode_av1"
+#define VK_KHR_VIDEO_DECODE_VP9_SPEC_VERSION 1
+#define VK_KHR_VIDEO_DECODE_VP9_EXTENSION_NAME "VK_KHR_video_decode_vp9"
 #define VK_KHR_VIDEO_ENCODE_AV1_SPEC_VERSION 1
 #define VK_KHR_VIDEO_ENCODE_AV1_EXTENSION_NAME "VK_KHR_video_encode_av1"
 #define VK_KHR_VIDEO_MAINTENANCE_1_SPEC_VERSION 1
@@ -5596,6 +5598,10 @@ typedef enum VkStructureType
     VK_STRUCTURE_TYPE_VIDEO_ENCODE_AV1_QUALITY_LEVEL_PROPERTIES_KHR = 1000513008,
     VK_STRUCTURE_TYPE_VIDEO_ENCODE_AV1_SESSION_CREATE_INFO_KHR = 1000513009,
     VK_STRUCTURE_TYPE_VIDEO_ENCODE_AV1_GOP_REMAINING_FRAME_INFO_KHR = 1000513010,
+    VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_DECODE_VP9_FEATURES_KHR = 1000514000,
+    VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_CAPABILITIES_KHR = 1000514001,
+    VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_PICTURE_INFO_KHR = 1000514002,
+    VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_PROFILE_INFO_KHR = 1000514003,
     VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_MAINTENANCE_1_FEATURES_KHR = 1000515000,
     VK_STRUCTURE_TYPE_VIDEO_INLINE_QUERY_INFO_KHR = 1000515001,
     VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PER_STAGE_DESCRIPTOR_SET_FEATURES_NV = 1000516000,
@@ -12304,6 +12310,14 @@ typedef struct VkPhysicalDeviceVideoFormatInfoKHR
     VkImageUsageFlags imageUsage;
 } VkPhysicalDeviceVideoFormatInfoKHR;
 
+/* Stained Glass OS (7848): VK_KHR_video_decode_vp9's feature, which applications enable */
+typedef struct VkPhysicalDeviceVideoDecodeVP9FeaturesKHR
+{
+    VkStructureType sType;
+    void *pNext;
+    VkBool32 videoDecodeVP9;
+} VkPhysicalDeviceVideoDecodeVP9FeaturesKHR;
+
 typedef struct VkPhysicalDeviceVideoMaintenance1FeaturesKHR
 {
     VkStructureType sType;
