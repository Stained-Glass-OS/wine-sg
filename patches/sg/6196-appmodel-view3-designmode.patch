From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.applicationmodel: CoreApplicationView 3 and 5, title bar, DesignMode

WinUI 2's NavigationView (Windows Terminal's settings page) takes CoreApplication.GetCurrentView().TitleBar while applying its template and registers revocable handlers on it, and reads the view's Properties; its ItemsRepeater asks DesignMode while measuring. The view answered only ICoreApplicationView (an access violation followed) and DesignMode was not made (every measure of the menu failed). The current view now answers ICoreApplicationView3 (not a component; HostedViewClosing never raised for a plain process) with a title bar that has no system title bar to measure (height and insets 0, not visible), keeps ExtendViewIntoTitleBar and takes its handlers, with a weak reference that always resolves; and ICoreApplicationView5, whose Properties is a property set of the view's own. DesignMode says FALSE for both of its questions: programs here always run for real.
---
diff --git a/dlls/windows.applicationmodel/Makefile.in b/dlls/windows.applicationmodel/Makefile.in
index 9afdf44..94389d6 100644
--- a/dlls/windows.applicationmodel/Makefile.in
+++ b/dlls/windows.applicationmodel/Makefile.in
@@ -5,6 +5,7 @@ SOURCES = \
 	classes.idl \
 	main.c \
 	core_application.c \
+	design_mode.c \
 	limited_access.c \
 	property_set.c \
 	package.c \
diff --git a/dlls/windows.applicationmodel/core_application.c b/dlls/windows.applicationmodel/core_application.c
index 789526b..98a82cf 100644
--- a/dlls/windows.applicationmodel/core_application.c
+++ b/dlls/windows.applicationmodel/core_application.c
@@ -18,6 +18,7 @@
  */
 
 #include "private.h"
+#include "weakreference.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(model);
@@ -124,10 +125,27 @@ typedef __FITypedEventHandler_2_Windows__CApplicationModel__CCore__CCoreApplicat
 struct core_application_view
 {
     ICoreApplicationView ICoreApplicationView_iface;
+    ICoreApplicationView3 ICoreApplicationView3_iface;
+    ICoreApplicationView5 ICoreApplicationView5_iface;
     LONG ref;
     INT64 next_token;
+    IPropertySet *properties;   /* the view's own bag, created when first asked for */
 };
 
+/* The view's title bar: a program's own window frame is not the view's, so
+ * there is no system title bar here to measure (no height or insets) and
+ * nothing that changes it; extending into it is kept, and has no effect. */
+struct view_title_bar
+{
+    ICoreApplicationViewTitleBar ICoreApplicationViewTitleBar_iface;
+    IWeakReferenceSource IWeakReferenceSource_iface;
+    IWeakReference IWeakReference_iface;
+    boolean extend;
+    INT64 next_token;
+};
+
+static struct view_title_bar current_title_bar;
+
 static inline struct core_application_view *impl_from_ICoreApplicationView( ICoreApplicationView *iface )
 {
     return CONTAINING_RECORD( iface, struct core_application_view, ICoreApplicationView_iface );
@@ -143,6 +161,22 @@ static HRESULT WINAPI view_QueryInterface( ICoreApplicationView *iface, REFIID i
         ICoreApplicationView_AddRef( (*out = iface) );
         return S_OK;
     }
+#ifndef SG_MUTANT_NO_VIEW3
+    if (IsEqualGUID( iid, &IID_ICoreApplicationView3 ))
+    {
+        *out = &impl_from_ICoreApplicationView( iface )->ICoreApplicationView3_iface;
+        ICoreApplicationView_AddRef( iface );
+        return S_OK;
+    }
+#endif
+#ifndef SG_MUTANT_NO_VIEW5
+    if (IsEqualGUID( iid, &IID_ICoreApplicationView5 ))
+    {
+        *out = &impl_from_ICoreApplicationView( iface )->ICoreApplicationView5_iface;
+        ICoreApplicationView_AddRef( iface );
+        return S_OK;
+    }
+#endif
     WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
@@ -161,7 +195,7 @@ static ULONG WINAPI view_Release( ICoreApplicationView *iface )
 
 static HRESULT WINAPI view_GetIids( ICoreApplicationView *iface, ULONG *count, IID **iids )
 {
-    INSPECTABLE_IIDS( count, iids, &IID_ICoreApplicationView );
+    INSPECTABLE_IIDS( count, iids, &IID_ICoreApplicationView, &IID_ICoreApplicationView3, &IID_ICoreApplicationView5 );
 }
 
 static HRESULT WINAPI view_GetRuntimeClassName( ICoreApplicationView *iface, HSTRING *name )
@@ -222,7 +256,274 @@ static const ICoreApplicationViewVtbl view_vtbl =
     view_get_IsMain, view_get_IsHosted,
 };
 
-static struct core_application_view current_view = { {&view_vtbl}, 1, 0 };
+DEFINE_IINSPECTABLE( view3, ICoreApplicationView3, struct core_application_view, ICoreApplicationView_iface )
+
+static HRESULT WINAPI view3_get_IsComponent( ICoreApplicationView3 *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI view3_get_TitleBar( ICoreApplicationView3 *iface, ICoreApplicationViewTitleBar **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = &current_title_bar.ICoreApplicationViewTitleBar_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI view3_add_HostedViewClosing( ICoreApplicationView3 *iface,
+        ITypedEventHandler_CoreApplicationView_HostedViewClosingEventArgs *handler, EventRegistrationToken *token )
+{
+    struct core_application_view *impl = impl_from_ICoreApplicationView3( iface );
+
+    /* the main view of a plain process is not hosted: it is never closed by a host */
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    if (!handler || !token) return E_POINTER;
+    token->value = InterlockedIncrement64( &impl->next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI view3_remove_HostedViewClosing( ICoreApplicationView3 *iface, EventRegistrationToken token )
+{
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+    return S_OK;
+}
+
+static const ICoreApplicationView3Vtbl view3_vtbl =
+{
+    view3_QueryInterface, view3_AddRef, view3_Release,
+    view3_GetIids, view3_GetRuntimeClassName, view3_GetTrustLevel,
+    view3_get_IsComponent, view3_get_TitleBar,
+    view3_add_HostedViewClosing, view3_remove_HostedViewClosing,
+};
+
+DEFINE_IINSPECTABLE( view5, ICoreApplicationView5, struct core_application_view, ICoreApplicationView_iface )
+
+/* CoreApplicationView.Properties: a bag of the view's own, not CoreApplication.Properties */
+static HRESULT WINAPI view5_get_Properties( ICoreApplicationView5 *iface, IPropertySet **value )
+{
+    struct core_application_view *impl = impl_from_ICoreApplicationView5( iface );
+    IPropertySet *set;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    if (!impl->properties)
+    {
+        if (FAILED(hr = property_set_create( &set ))) return hr;
+        if (InterlockedCompareExchangePointer( (void **)&impl->properties, set, NULL ))
+            IInspectable_Release( (IInspectable *)set );
+    }
+    *value = impl->properties;
+    IInspectable_AddRef( (IInspectable *)*value );
+    return S_OK;
+}
+
+static const ICoreApplicationView5Vtbl view5_vtbl =
+{
+    view5_QueryInterface, view5_AddRef, view5_Release,
+    view5_GetIids, view5_GetRuntimeClassName, view5_GetTrustLevel,
+    view5_get_Properties,
+};
+
+static struct core_application_view current_view = { {&view_vtbl}, {&view3_vtbl}, {&view5_vtbl}, 1, 0 };
+
+/* ICoreApplicationViewTitleBar: lives as long as the process */
+
+static inline struct view_title_bar *impl_from_ICoreApplicationViewTitleBar( ICoreApplicationViewTitleBar *iface )
+{
+    return CONTAINING_RECORD( iface, struct view_title_bar, ICoreApplicationViewTitleBar_iface );
+}
+
+static HRESULT WINAPI title_bar_QueryInterface( ICoreApplicationViewTitleBar *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICoreApplicationViewTitleBar ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+#ifndef SG_MUTANT_NO_TITLE_BAR_WEAKREF
+    if (IsEqualGUID( iid, &IID_IWeakReferenceSource ))
+    {
+        *out = &impl_from_ICoreApplicationViewTitleBar( iface )->IWeakReferenceSource_iface;
+        return S_OK;
+    }
+#endif
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI title_bar_AddRef( ICoreApplicationViewTitleBar *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI title_bar_Release( ICoreApplicationViewTitleBar *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI title_bar_GetIids( ICoreApplicationViewTitleBar *iface, ULONG *count, IID **iids )
+{
+    INSPECTABLE_IIDS( count, iids, &IID_ICoreApplicationViewTitleBar );
+}
+
+static HRESULT WINAPI title_bar_GetRuntimeClassName( ICoreApplicationViewTitleBar *iface, HSTRING *name )
+{
+    return inspectable_name( RuntimeClass_Windows_ApplicationModel_Core_CoreApplicationViewTitleBar, name );
+}
+
+static HRESULT WINAPI title_bar_GetTrustLevel( ICoreApplicationViewTitleBar *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI title_bar_put_ExtendViewIntoTitleBar( ICoreApplicationViewTitleBar *iface, boolean value )
+{
+    TRACE( "iface %p, value %d.\n", iface, value );
+    impl_from_ICoreApplicationViewTitleBar( iface )->extend = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI title_bar_get_ExtendViewIntoTitleBar( ICoreApplicationViewTitleBar *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ICoreApplicationViewTitleBar( iface )->extend;
+    return S_OK;
+}
+
+static HRESULT WINAPI title_bar_get_SystemOverlayLeftInset( ICoreApplicationViewTitleBar *iface, DOUBLE *value )
+{
+    if (!value) return E_POINTER;
+    *value = 0.0;
+    return S_OK;
+}
+
+static HRESULT WINAPI title_bar_get_SystemOverlayRightInset( ICoreApplicationViewTitleBar *iface, DOUBLE *value )
+{
+    if (!value) return E_POINTER;
+    *value = 0.0;
+    return S_OK;
+}
+
+static HRESULT WINAPI title_bar_get_Height( ICoreApplicationViewTitleBar *iface, DOUBLE *value )
+{
+    if (!value) return E_POINTER;
+    *value = 0.0;
+    return S_OK;
+}
+
+static HRESULT WINAPI title_bar_add_LayoutMetricsChanged( ICoreApplicationViewTitleBar *iface,
+        ITypedEventHandler_CoreApplicationViewTitleBar_IInspectable *handler, EventRegistrationToken *token )
+{
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    if (!handler || !token) return E_POINTER;
+    token->value = InterlockedIncrement64( &impl_from_ICoreApplicationViewTitleBar( iface )->next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI title_bar_remove_LayoutMetricsChanged( ICoreApplicationViewTitleBar *iface, EventRegistrationToken token )
+{
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+    return S_OK;
+}
+
+static HRESULT WINAPI title_bar_get_IsVisible( ICoreApplicationViewTitleBar *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI title_bar_add_IsVisibleChanged( ICoreApplicationViewTitleBar *iface,
+        ITypedEventHandler_CoreApplicationViewTitleBar_IInspectable *handler, EventRegistrationToken *token )
+{
+    return title_bar_add_LayoutMetricsChanged( iface, handler, token );
+}
+
+static HRESULT WINAPI title_bar_remove_IsVisibleChanged( ICoreApplicationViewTitleBar *iface, EventRegistrationToken token )
+{
+    return title_bar_remove_LayoutMetricsChanged( iface, token );
+}
+
+static const ICoreApplicationViewTitleBarVtbl title_bar_vtbl =
+{
+    title_bar_QueryInterface, title_bar_AddRef, title_bar_Release,
+    title_bar_GetIids, title_bar_GetRuntimeClassName, title_bar_GetTrustLevel,
+    title_bar_put_ExtendViewIntoTitleBar, title_bar_get_ExtendViewIntoTitleBar,
+    title_bar_get_SystemOverlayLeftInset, title_bar_get_SystemOverlayRightInset, title_bar_get_Height,
+    title_bar_add_LayoutMetricsChanged, title_bar_remove_LayoutMetricsChanged,
+    title_bar_get_IsVisible, title_bar_add_IsVisibleChanged, title_bar_remove_IsVisibleChanged,
+};
+
+/* its weak references (event revokers take them): it is never freed, so they always resolve */
+static HRESULT WINAPI title_bar_weak_source_QueryInterface( IWeakReferenceSource *iface, REFIID iid, void **out )
+{
+    return title_bar_QueryInterface( &current_title_bar.ICoreApplicationViewTitleBar_iface, iid, out );
+}
+
+static ULONG WINAPI title_bar_weak_source_AddRef( IWeakReferenceSource *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI title_bar_weak_source_Release( IWeakReferenceSource *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI title_bar_weak_source_GetWeakReference( IWeakReferenceSource *iface, IWeakReference **ref )
+{
+    if (!ref) return E_POINTER;
+    *ref = &current_title_bar.IWeakReference_iface;
+    return S_OK;
+}
+
+static const IWeakReferenceSourceVtbl title_bar_weak_source_vtbl =
+{
+    title_bar_weak_source_QueryInterface, title_bar_weak_source_AddRef, title_bar_weak_source_Release,
+    title_bar_weak_source_GetWeakReference,
+};
+
+static HRESULT WINAPI title_bar_weak_QueryInterface( IWeakReference *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IWeakReference ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI title_bar_weak_AddRef( IWeakReference *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI title_bar_weak_Release( IWeakReference *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI title_bar_weak_Resolve( IWeakReference *iface, REFIID iid, IInspectable **out )
+{
+    return title_bar_QueryInterface( &current_title_bar.ICoreApplicationViewTitleBar_iface, iid, (void **)out );
+}
+
+static const IWeakReferenceVtbl title_bar_weak_vtbl =
+{
+    title_bar_weak_QueryInterface, title_bar_weak_AddRef, title_bar_weak_Release, title_bar_weak_Resolve,
+};
+
+static struct view_title_bar current_title_bar = { {&title_bar_vtbl}, {&title_bar_weak_source_vtbl}, {&title_bar_weak_vtbl} };
 
 DEFINE_IINSPECTABLE( core_application, ICoreApplication, struct core_application_statics, IActivationFactory_iface )
 
diff --git a/dlls/windows.applicationmodel/design_mode.c b/dlls/windows.applicationmodel/design_mode.c
new file mode 100644
index 0000000..7325d0e
--- /dev/null
+++ b/dlls/windows.applicationmodel/design_mode.c
@@ -0,0 +1,142 @@
+/* WinRT Windows.ApplicationModel.DesignMode Implementation
+ *
+ * Copyright (C) 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * DesignMode tells a component whether it runs inside a visual designer
+ * (an IDE's XAML designer surface). Programs here always run for real, so
+ * both answers are FALSE. Control libraries ask before doing any run-time
+ * only work (WinUI 2's ItemsRepeater asks while measuring).
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(model);
+
+struct design_mode
+{
+    IActivationFactory IActivationFactory_iface;
+    IDesignModeStatics IDesignModeStatics_iface;
+    IDesignModeStatics2 IDesignModeStatics2_iface;
+};
+
+static inline struct design_mode *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct design_mode, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct design_mode *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IDesignModeStatics ))
+        *out = &impl->IDesignModeStatics_iface;
+    else if (IsEqualGUID( iid, &IID_IDesignModeStatics2 ))
+        *out = &impl->IDesignModeStatics2_iface;
+    else
+    {
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+/* a static object: it lives as long as the module */
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    INSPECTABLE_IIDS( iid_count, iids, &IID_IDesignModeStatics, &IID_IDesignModeStatics2 );
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    return inspectable_name( RuntimeClass_Windows_ApplicationModel_DesignMode, class_name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    /* a static class: nothing to activate */
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release,
+    factory_GetIids, factory_GetRuntimeClassName, factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( statics, IDesignModeStatics, struct design_mode, IActivationFactory_iface )
+
+static HRESULT WINAPI statics_get_DesignModeEnabled( IDesignModeStatics *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static const struct IDesignModeStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface, statics_AddRef, statics_Release,
+    statics_GetIids, statics_GetRuntimeClassName, statics_GetTrustLevel,
+    statics_get_DesignModeEnabled,
+};
+
+DEFINE_IINSPECTABLE( statics2, IDesignModeStatics2, struct design_mode, IActivationFactory_iface )
+
+static HRESULT WINAPI statics2_get_DesignMode2Enabled( IDesignModeStatics2 *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static const struct IDesignModeStatics2Vtbl statics2_vtbl =
+{
+    statics2_QueryInterface, statics2_AddRef, statics2_Release,
+    statics2_GetIids, statics2_GetRuntimeClassName, statics2_GetTrustLevel,
+    statics2_get_DesignMode2Enabled,
+};
+
+static struct design_mode design_mode_statics = { {&factory_vtbl}, {&statics_vtbl}, {&statics2_vtbl} };
+
+IActivationFactory *design_mode_factory = &design_mode_statics.IActivationFactory_iface;
diff --git a/dlls/windows.applicationmodel/main.c b/dlls/windows.applicationmodel/main.c
index 72dbcef..a53a3ee 100644
--- a/dlls/windows.applicationmodel/main.c
+++ b/dlls/windows.applicationmodel/main.c
@@ -76,6 +76,11 @@ HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **fa
     if (!wcscmp( buffer, RuntimeClass_Windows_ApplicationModel_LimitedAccessFeatures ))
         IActivationFactory_QueryInterface( limited_access_factory, &IID_IActivationFactory, (void **)factory );
 
+#ifndef SG_MUTANT_NO_DESIGN_MODE
+    if (!wcscmp( buffer, RuntimeClass_Windows_ApplicationModel_DesignMode ))
+        IActivationFactory_QueryInterface( design_mode_factory, &IID_IActivationFactory, (void **)factory );
+#endif
+
     if (!wcscmp( buffer, L"Windows.Foundation.Collections.ValueSet" ) ||
         !wcscmp( buffer, L"Windows.Foundation.Collections.PropertySet" ))
         IActivationFactory_QueryInterface( property_set_factory, &IID_IActivationFactory, (void **)factory );
diff --git a/dlls/windows.applicationmodel/private.h b/dlls/windows.applicationmodel/private.h
index bce5e83..6642554 100644
--- a/dlls/windows.applicationmodel/private.h
+++ b/dlls/windows.applicationmodel/private.h
@@ -56,6 +56,7 @@ extern IActivationFactory *resource_manager_factory;
 extern IActivationFactory *resource_context_factory;
 extern IActivationFactory *package_catalog_factory;
 extern IActivationFactory *limited_access_factory;
+extern IActivationFactory *design_mode_factory;
 
 extern HRESULT property_set_create( IPropertySet **out );
 extern IActivationFactory *property_set_factory;
