From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32, vcruntime140: the file versions installers look for

TortoiseGit's MSI looks for shell32.dll >= 6.3.14392.0 in the system folder
("requires Windows 10 version 1607 or later") and vcruntime140.dll >= 14.42
("the latest Visual C++ 2015-2022 Redistributable"). Wine's shell32 said
XP's 6.0.2900 and its vcruntime140 had no version resource at all, so the
launch conditions failed and msiexec ended with 1603 (SG Store: "code 67").
shell32 now says the Windows 10 build the system reports (10.0.19041) and
vcruntime140 and vcruntime140_1 say 14.42.34433.0, the version msvcp140
already carries.
---
--- a/dlls/shell32/shell32.rc
+++ b/dlls/shell32/shell32.rc
@@ -1118,10 +1118,20 @@
 LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
 
 #define WINE_FILENAME_STR "shell32.dll"
+/* the version of the shell this one stands for (the build the system
+ * reports, 19041 and up): installers check it, as TortoiseGit's "Windows 10
+ * 1607 or later" (shell32.dll >= 6.3.14392) -- XP's 6.0.2900 failed that */
+#ifndef SG_MUTANT_XPSHELL
+#define WINE_FILEVERSION 10,0,19041,5072
+#define WINE_FILEVERSION_STR "10.0.19041.5072"
+#define WINE_PRODUCTVERSION 10,0,19041,5072
+#define WINE_PRODUCTVERSION_STR "10.0.19041.5072"
+#else
 #define WINE_FILEVERSION 6,0,2900,6242
 #define WINE_FILEVERSION_STR "6.0.2900.6242"
 #define WINE_PRODUCTVERSION 6,0,2900,6242
 #define WINE_PRODUCTVERSION_STR "6.0.2900.6242"
+#endif
 #define WINE_EXTRAVALUES VALUE "OLESelfRegister",""
 
 #include "wine/wine_common_ver.rc"
--- a/dlls/vcruntime140/Makefile.in
+++ b/dlls/vcruntime140/Makefile.in
@@ -3,4 +3,5 @@
 IMPORTS   = ntdll
 
 SOURCES = \
-	misc.c
+	misc.c \
+	version.rc
--- /dev/null
+++ b/dlls/vcruntime140/version.rc
@@ -0,0 +1,30 @@
