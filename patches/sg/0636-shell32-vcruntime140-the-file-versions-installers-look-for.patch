+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* the version msvcp140 carries: installers look for "the Visual C++ 2015-2022
+ * runtime" by this file's version (TortoiseGit: vcruntime140.dll >= 14.42) */
+#define WINE_FILEDESCRIPTION_STR "Wine runtime library"
+#define WINE_FILENAME_STR "vcruntime140.dll"
+#define WINE_FILEVERSION 14,42,34433,0
+#define WINE_FILEVERSION_STR "14.42.34433.0"
+#define WINE_PRODUCTVERSION 14,42,34433,0
+#define WINE_PRODUCTVERSION_STR "14.42.34433.0"
+
+#include "wine/wine_common_ver.rc"
--- a/dlls/vcruntime140_1/Makefile.in
+++ b/dlls/vcruntime140_1/Makefile.in
@@ -6,4 +6,5 @@
 	except_arm64ec.c \
 	except_x86_64.c \
 	handler4.c \
-	main.c
+	main.c \
+	version.rc
--- /dev/null
+++ b/dlls/vcruntime140_1/version.rc
@@ -0,0 +1,30 @@
