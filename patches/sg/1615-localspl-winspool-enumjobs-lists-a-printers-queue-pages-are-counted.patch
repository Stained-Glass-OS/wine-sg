From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] localspl, winspool: EnumJobs lists a printer's queue; pages are counted

EnumJobsA/W failed with no error set (779 FIXMEs in the logs): programs
watching their job leave the queue, and print queue windows, saw nothing.
StartPagePrinter and EndPagePrinter were stubs that said yes whatever was
printing; GetJob's level 3 was a stub.

The local print provider enumerates a printer's jobs from the first one
asked for, up to the count asked for: the structures first, then every
job's strings (and DEVMODE), with the size needed when the buffer is
short. A job carries its position in the queue, its status, when it was
submitted and its pages: StartPagePrinter counts them, and it and
EndPagePrinter fail with ERROR_SPL_NO_STARTDOC outside a document.
Level 3 gives the job and the one after it. EnumJobsA makes each job's
strings narrow in place.

Wine's winspool info and localspl localmon tests: the same results as
before.

Gate: test/enumjobs-gate.sh (a printer on Wine's PostScript driver and
the FILE: port). Mutant SG_MUTANT_NO_ENUM_JOBS (localspl/provider.c).
---
--- a/dlls/localspl/provider.c
+++ b/dlls/localspl/provider.c
@@ -233,6 +233,8 @@ typedef struct {
     HANDLE hf;
     WCHAR *print_proc;      /* a print processor's own drawing: printed by winprint */
     BOOL read;              /* a print processor opened the job's data */
+    DWORD pages;            /* StartPagePrinter calls */
+    SYSTEMTIME submitted;   /* when the job was made */
 } job_info_t;
 
 typedef struct {
@@ -3395,6 +3397,7 @@ static job_info_t* add_job(printer_t *printer, DOC_INFO_1W *info, BOOL create)
     }
 
     job->id = job_id;
+    GetSystemTime(&job->submitted);
     get_spool_filename(job_id, job->filename, len);
     if (create)
     {
@@ -3963,11 +3966,17 @@ static BOOL WINAPI fpGetJob(HANDLE hprinter, DWORD job_id, DWORD level,
         }
         break;
     case 3:
-        FIXME("level 3 stub\n");
+        /* the job and the one after it in the queue */
         s = sizeof(JOB_INFO_3);
-
         if (size >= s)
-            memset(data, 0, sizeof(JOB_INFO_3));
+        {
+            JOB_INFO_3 *info = (JOB_INFO_3 *)data;
+            struct list *next = list_next(&printer->info->jobs, &job->entry);
+
+            memset(info, 0, sizeof(*info));
+            info->JobId = job->id;
+            info->NextJobId = next ? LIST_ENTRY(next, job_info_t, entry)->id : 0;
+        }
         break;
     default:
         SetLastError(ERROR_INVALID_LEVEL);
@@ -3986,6 +3995,216 @@ static BOOL WINAPI fpGetJob(HANDLE hprinter, DWORD job_id, DWORD level,
     return ret;
 }
 
+/* One job's JOB_INFO at "info", its strings (and DEVMODE) at data + *s
+ * on, *s advancing; nothing is written unless "fill". EnumJobs lays the
+ * structures out first and every job's strings after them. */
+static void fill_job_info(printer_t *printer, job_info_t *job, DWORD level, DWORD position, DWORD next_id,
+        BYTE *info_ptr, BYTE *data, DWORD *s, BOOL fill, const WCHAR *user, const WCHAR *machine)
+{
+    WCHAR *p = (WCHAR *)(data + *s);
+    DWORD status = job->read ? JOB_STATUS_PRINTING : 0;
+
+    switch (level)
+    {
+    case 1:
+    {
+        JOB_INFO_1W *info = (JOB_INFO_1W *)info_ptr;
+        WCHAR *str;
+
+        if (fill) memset(info, 0, sizeof(*info));
+        str = job_string(job->document_title, &p, s, fill); if (fill) info->pDocument = str;
+        str = job_string(printer->info->name, &p, s, fill); if (fill) info->pPrinterName = str;
+        str = job_string(job->datatype, &p, s, fill); if (fill) info->pDatatype = str;
+        str = job_string(user[0] ? user : NULL, &p, s, fill); if (fill) info->pUserName = str;
+        str = job_string(machine[0] ? machine : NULL, &p, s, fill); if (fill) info->pMachineName = str;
+        if (fill)
+        {
+            info->JobId = job->id;
+            info->Status = status;
+            info->Priority = DEF_PRIORITY;
+            info->Position = position;
+            info->TotalPages = job->pages;
+            info->PagesPrinted = job->read ? job->pages : 0;
+            info->Submitted = job->submitted;
+        }
+        break;
+    }
+    case 2:
+    {
+        JOB_INFO_2W *info = (JOB_INFO_2W *)info_ptr;
+        const WCHAR *proc = job->print_proc ? job->print_proc : printer->info->print_proc;
+        WCHAR *str;
+
+        if (fill) memset(info, 0, sizeof(*info));
+        str = job_string(job->document_title, &p, s, fill); if (fill) info->pDocument = str;
+        str = job_string(printer->info->name, &p, s, fill); if (fill) info->pPrinterName = str;
+        str = job_string(job->datatype, &p, s, fill); if (fill) info->pDatatype = str;
+        str = job_string(user[0] ? user : NULL, &p, s, fill); if (fill) info->pUserName = str;
+        str = job_string(user[0] ? user : NULL, &p, s, fill); if (fill) info->pNotifyName = str;
+        str = job_string(machine[0] ? machine : NULL, &p, s, fill); if (fill) info->pMachineName = str;
+        str = job_string(proc, &p, s, fill); if (fill) info->pPrintProcessor = str;
+        if (job->devmode)
+        {
+            /* align DEVMODE to a DWORD boundary */
+            *s += (4 - (*s & 3)) & 3;
+            if (fill)
+            {
+                info->pDevMode = (DEVMODEW *)(data + *s);
+                memcpy(info->pDevMode, job->devmode, job->devmode->dmSize + job->devmode->dmDriverExtra);
+            }
+            *s += job->devmode->dmSize + job->devmode->dmDriverExtra;
+        }
+        if (fill)
+        {
+            info->JobId = job->id;
+            info->Status = status;
+            info->Priority = DEF_PRIORITY;
+            info->Position = position;
+            info->TotalPages = job->pages;
+            info->PagesPrinted = job->read ? job->pages : 0;
+            info->Submitted = job->submitted;
+        }
+        break;
+    }
+    case 3:
+        if (fill)
+        {
+            JOB_INFO_3 *info = (JOB_INFO_3 *)info_ptr;
+            memset(info, 0, sizeof(*info));
+            info->JobId = job->id;
+            info->NextJobId = next_id;
+        }
+        break;
+    }
+}
+
+/* the jobs in a printer's queue, from the first asked for: EnumJobs failed
+ * with no error (779 FIXMEs in the logs), so programs waiting for their
+ * job to leave the queue never saw it */
+static BOOL WINAPI fpEnumJobs(HANDLE hprinter, DWORD first, DWORD count, DWORD level,
+        BYTE *data, DWORD size, DWORD *needed, DWORD *returned)
+{
+    printer_t *printer = (printer_t *)hprinter;
+    WCHAR user[257], machine[MAX_COMPUTERNAME_LENGTH + 3];
+    DWORD struct_size, n = 0, i, s, len;
+    job_info_t *job, *next;
+    struct list *cursor;
+    int pass;
+
+    TRACE("%p %ld %ld %ld %p %ld %p %p\n", hprinter, first, count, level, data, size, needed, returned);
+
+    if (!printer || printer->header.type != HANDLE_PRINTER)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    switch (level)
+    {
+    case 1: struct_size = sizeof(JOB_INFO_1W); break;
+    case 2: struct_size = sizeof(JOB_INFO_2W); break;
+    case 3: struct_size = sizeof(JOB_INFO_3); break;
+    default:
+        SetLastError(ERROR_INVALID_LEVEL);
+        return FALSE;
+    }
+    if (!needed || !returned)
+    {
+        SetLastError(RPC_X_NULL_REF_POINTER);
+        return FALSE;
+    }
+
+    len = ARRAY_SIZE(user);
+    if (!GetUserNameW(user, &len)) user[0] = 0;
+    wcscpy(machine, L"\\\\");
+    len = ARRAY_SIZE(machine) - 2;
+    if (!GetComputerNameW(machine + 2, &len)) machine[0] = 0;
+
+    EnterCriticalSection(&printer->info->jobs_cs);
+    for (pass = 0, s = 0; pass < 2; pass++)
+    {
+        BOOL fill = pass;
+
+        if (pass && size < s) break;
+        i = 0;
+        n = 0;
+        LIST_FOR_EACH(cursor, &printer->info->jobs)
+        {
+            if (i++ < first) continue;
+            if (n >= count) break;
+            n++;
+        }
+        s = n * struct_size;
+        i = 0;
+        n = 0;
+        LIST_FOR_EACH_ENTRY(job, &printer->info->jobs, job_info_t, entry)
+        {
+            struct list *after;
+
+            if (i++ < first) continue;
+            if (n >= count) break;
+            after = list_next(&printer->info->jobs, &job->entry);
+            next = after ? LIST_ENTRY(after, job_info_t, entry) : NULL;
+            fill_job_info(printer, job, level, i, next ? next->id : 0, data + n * struct_size, data, &s, fill,
+                          user, machine);
+            n++;
+        }
+    }
+    LeaveCriticalSection(&printer->info->jobs_cs);
+
+    *needed = s;
+    if (size < s)
+    {
+        *returned = 0;
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+    *returned = n;
+    return TRUE;
+}
+
+/* a page of the document StartDocPrinter began: counted for the job's
+ * TotalPages; without a document, ERROR_SPL_NO_STARTDOC */
+static BOOL WINAPI fpStartPagePrinter(HANDLE hprinter)
+{
+    printer_t *printer = (printer_t *)hprinter;
+
+    TRACE("%p\n", hprinter);
+
+    if (!printer || printer->header.type != HANDLE_PRINTER)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (!printer->doc)
+    {
+        SetLastError(ERROR_SPL_NO_STARTDOC);
+        return FALSE;
+    }
+    EnterCriticalSection(&printer->info->jobs_cs);
+    printer->doc->pages++;
+    LeaveCriticalSection(&printer->info->jobs_cs);
+    return TRUE;
+}
+
+static BOOL WINAPI fpEndPagePrinter(HANDLE hprinter)
+{
+    printer_t *printer = (printer_t *)hprinter;
+
+    TRACE("%p\n", hprinter);
+
+    if (!printer || printer->header.type != HANDLE_PRINTER)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (!printer->doc)
+    {
+        SetLastError(ERROR_SPL_NO_STARTDOC);
+        return FALSE;
+    }
+    return TRUE;
+}
+
 static BOOL WINAPI fpScheduleJob(HANDLE hprinter, DWORD job_id)
 {
     printer_t *printer = (printer_t *)hprinter;
@@ -4358,7 +4577,11 @@ static const PRINTPROVIDOR backend = {
         fpOpenPrinter,
         fpSetJob,
         fpGetJob,
+#ifndef SG_MUTANT_NO_ENUM_JOBS
+        fpEnumJobs,
+#else
         NULL,   /* fpEnumJobs */
+#endif
         NULL,   /* fpAddPrinter */
         NULL,   /* fpDeletePrinter */
         NULL,   /* fpSetPrinter */
@@ -4375,9 +4598,9 @@ static const PRINTPROVIDOR backend = {
         NULL,   /* fpDeletePrintProcessor */
         NULL,   /* fpEnumPrintProcessorDatatypes */
         fpStartDocPrinter,
-        NULL,   /* fpStartPagePrinter */
+        fpStartPagePrinter,
         fpWritePrinter,
-        NULL,   /* fpEndPagePrinter */
+        fpEndPagePrinter,
         fpAbortPrinter,
         fpReadPrinter,
         fpEndDocPrinter,
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -3775,8 +3775,18 @@ BOOL WINAPI EndDocPrinter(HANDLE printer)
  */
 BOOL WINAPI EndPagePrinter(HANDLE hPrinter)
 {
-    FIXME("(%p): stub\n", hPrinter);
-    return TRUE;
+    HANDLE handle = get_backend_handle(hPrinter);
+    opened_printer_t *opened;
+
+    TRACE("(%p)\n", hPrinter);
+
+    if (redirected_output( hPrinter, &opened )) return TRUE;
+    if (!handle)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    return backend->fpEndPagePrinter(handle);
 }
 
 /*****************************************************************************
@@ -3848,8 +3858,18 @@ DWORD WINAPI StartDocPrinterW(HANDLE printer, DWORD level, BYTE *doc_info)
  */
 BOOL WINAPI StartPagePrinter(HANDLE hPrinter)
 {
-    FIXME("(%p): stub\n", hPrinter);
-    return TRUE;
+    HANDLE handle = get_backend_handle(hPrinter);
+    opened_printer_t *opened;
+
+    TRACE("(%p)\n", hPrinter);
+
+    if (redirected_output( hPrinter, &opened )) return TRUE;
