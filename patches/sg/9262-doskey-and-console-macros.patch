         if (read_complete( console, STATUS_SUCCESS, console->read_buffer, out_size,
@@ -733,6 +744,9 @@
 }
 
 static NTSTATUS alias_result( NTSTATUS status, const WCHAR *text, size_t length, size_t *out_size );
+static struct alias_exe *find_alias_exe( struct console *console, const WCHAR *name, size_t len );
+static struct alias *find_alias( struct alias_exe *exe, const WCHAR *source, size_t len );
+static void expand_console_macro( struct console *console );
 
 /* Stained Glass OS (wine-sg 9705): command history per program, as Windows' console host keeps it --
  * GetConsoleCommandHistory, GetConsoleCommandHistoryLength, ExpungeConsoleCommandHistory,
@@ -1786,6 +1800,7 @@
         else
         {
             if (ctx->len) append_input_history( console, ctx->buf, ctx->len * sizeof(WCHAR) );
+            expand_console_macro( console );
