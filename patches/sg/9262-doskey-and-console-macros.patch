+/* Stained Glass OS (wine-sg 9262): a doskey macro typed at the start of a line is expanded, as Windows'
+ * console host does it, from the alias table of the program reading the line (AddConsoleAlias, doskey.exe):
+ * $1-$9 are the words after the macro's name, $* all of them, $T separates commands (one line each), $G $L $B
+ * and $$ are > < | and $. The line goes to the history as typed. */
+static void expand_console_macro( struct console *console )
+{
+    struct edit_line *ctx = &console->edit_line;
+    const WCHAR *line = ctx->buf, *end, *rest, *word[9], *p;
+    size_t word_len[9], name_len, rest_len, size, len = 0;
+    unsigned int words = 0, i;
+    struct alias_exe *exe;
+    struct alias *alias;
+    WCHAR *out;
+
+#ifdef SG_MUTANT_MACRO_NO_EXPAND
+    return;
+#endif
+    if (!console->read_exe || !ctx->len) return;
+    if (!(exe = find_alias_exe( console, console->read_exe, wcslen( console->read_exe ) ))) return;
+    end = line + ctx->len;
+    for (name_len = 0; line + name_len < end && line[name_len] != ' ' && line[name_len] != '\t'; name_len++) ;
+    if (!name_len || !(alias = find_alias( exe, line, name_len ))) return;
+    for (rest = line + name_len; rest < end && (*rest == ' ' || *rest == '\t'); rest++) ;
+    rest_len = end - rest;
+    for (p = rest; p < end && words < ARRAY_SIZE(word); )
+    {
+        while (p < end && (*p == ' ' || *p == '\t')) p++;
+        if (p == end) break;
+        word[words] = p;
+        while (p < end && *p != ' ' && *p != '\t') p++;
+        word_len[words] = p - word[words];
+        words++;
+    }
+
+    /* at most the whole rest for each $ of the target */
+    size = wcslen( alias->target ) * (rest_len + 2) + 3;
+    if (!(out = malloc( size * sizeof(WCHAR) ))) return;
+    for (p = alias->target; *p; p++)
+    {
+        if (*p != '$' || !p[1])
+        {
+            out[len++] = *p;
+            continue;
+        }
+        switch (*++p)
+        {
+        case 't': case 'T': out[len++] = '\r'; out[len++] = '\n'; break;
+        case 'g': case 'G': out[len++] = '>'; break;
+        case 'l': case 'L': out[len++] = '<'; break;
+        case 'b': case 'B': out[len++] = '|'; break;
+        case '$': out[len++] = '$'; break;
+        case '*': memcpy( out + len, rest, rest_len * sizeof(WCHAR) ); len += rest_len; break;
+        default:
+            if (*p >= '1' && *p <= '9')
+            {
+                i = *p - '1';
+                if (i < words)
+                {
+                    memcpy( out + len, word[i], word_len[i] * sizeof(WCHAR) );
+                    len += word_len[i];
+                }
+            }
+            else
+            {
+                out[len++] = '$';
+                out[len++] = *p;
+            }
+            break;
+        }
+    }
+    free( ctx->buf );
+    ctx->buf = out;
+    ctx->len = len;
+    ctx->size = size;
+    ctx->cursor = len;
+    TRACE( "macro %s -> %s\n", debugstr_wn( line, name_len ), debugstr_wn( out, len ) );
+}
+
 static NTSTATUS read_console( struct console *console, unsigned int ioctl, size_t out_size,
                               const WCHAR *initial, unsigned int initial_len, unsigned int ctrl_mask )
 {
--- /dev/null
+++ b/programs/doskey/Makefile.in
@@ -0,0 +1,7 @@
+MODULE    = doskey.exe
+IMPORTS   = kernelbase
+
+EXTRADLLFLAGS = -mconsole -municode
+
+SOURCES = \
+	main.c
--- /dev/null
+++ b/programs/doskey/main.c
@@ -0,0 +1,270 @@
+/*
+ * doskey.exe: console macros and command history (Stained Glass OS, wine-sg 9262)
+ *
+ * Windows has doskey.exe in system32; Wine had none, so Git for Windows' Git CMD
+ * (cmd /K "doskey git=^"...\git.exe^" $*") opened with "Can't recognize ...". As
+ * Windows' doskey it keeps macros in the console's alias table, per program
+ * (AddConsoleAlias; cmd.exe unless /EXENAME= names another), and the console host
+ * expands a macro typed at the start of a line it reads for that program.
+ *
+ *   doskey [/REINSTALL] [/LISTSIZE=size] [/MACROS[:ALL | :exename]] [/HISTORY]
+ *          [/INSERT | /OVERSTRIKE] [/EXENAME=exename] [/MACROFILE=filename]
+ *          [macroname=[text]]
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <windows.h>
+#include <wincon.h>
+
+/* not in wincon.h */
+DWORD WINAPI GetConsoleCommandHistoryW( WCHAR *buffer, DWORD length, WCHAR *exe );
+DWORD WINAPI GetConsoleCommandHistoryLengthW( WCHAR *exe );
+BOOL WINAPI SetConsoleNumberOfCommandsW( DWORD count, WCHAR *exe );
+
+static void output( const WCHAR *str, DWORD len )
+{
+    HANDLE out = GetStdHandle( STD_OUTPUT_HANDLE );
+    DWORD written, mode;
+    char *buf;
+    int n;
+
+    if (!len) return;
+    if (GetConsoleMode( out, &mode ))
+    {
+        WriteConsoleW( out, str, len, &written, NULL );
+        return;
+    }
+    n = WideCharToMultiByte( GetConsoleOutputCP(), 0, str, len, NULL, 0, NULL, NULL );
+    if (!(buf = malloc( n ))) return;
+    WideCharToMultiByte( GetConsoleOutputCP(), 0, str, len, buf, n, NULL, NULL );
+    WriteFile( out, buf, n, &written, NULL );
+    free( buf );
+}
+
+static void output_line( const WCHAR *str )
+{
+    output( str, wcslen( str ) );
+    output( L"\r\n", 2 );
+}
+
+static void usage(void)
+{
+    static const WCHAR *const lines[] =
+    {
+        L"Edits command lines, recalls command lines, and creates macros.",
+        L"",
+        L"DOSKEY [/REINSTALL] [/LISTSIZE=size] [/MACROS[:ALL | :exename]]",
+        L"  [/HISTORY] [/INSERT | /OVERSTRIKE] [/EXENAME=exename] [/MACROFILE=filename]",
+        L"  [macroname=[text]]",
+        L"",
+        L"  /REINSTALL          Installs a new copy of Doskey.",
+        L"  /LISTSIZE=size      Sets size of command history buffer.",
+        L"  /MACROS             Displays all Doskey macros.",
+        L"  /MACROS:ALL         Displays all Doskey macros for all executables which have",
+        L"                      Doskey macros.",
+        L"  /MACROS:exename     Displays all Doskey macros for the given executable.",
+        L"  /HISTORY            Displays all commands stored in memory.",
+        L"  /INSERT             Specifies that new text you type is inserted in old text.",
+        L"  /OVERSTRIKE         Specifies that new text overwrites old text.",
+        L"  /EXENAME=exename    Specifies the executable.",
+        L"  /MACROFILE=filename Specifies a file of macros to install.",
+        L"  macroname           Specifies a name for a macro you create.",
+        L"  text                Specifies commands you want to record.",
+        L"",
+        L"In a macro: $T separates commands, $1-$9 are the parameters, $* is all of",
+        L"them; $G is >, $L is <, $B is | and $$ is $.",
+    };
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(lines); i++) output_line( lines[i] );
+}
+
+/* the macros of one program: name=text lines; with a header naming the program for /MACROS:ALL */
+static void list_macros( const WCHAR *exe, BOOL header )
+{
+    DWORD len = GetConsoleAliasesLengthW( (WCHAR *)exe );
+    WCHAR *buf, *p;
+
+    if (!len || !(buf = malloc( len + sizeof(WCHAR) ))) return;
+    if (GetConsoleAliasesW( buf, len, (WCHAR *)exe ))
+    {
+        buf[len / sizeof(WCHAR)] = 0;
+        if (header)
+        {
+            output( L"[", 1 ); output( exe, wcslen( exe ) ); output_line( L"]" );
+        }
+        for (p = buf; p < buf + len / sizeof(WCHAR) && *p; p += wcslen( p ) + 1)
+        {
+            if (header) output( L"    ", 4 );
+            output_line( p );
+        }
+        if (header) output_line( L"" );
+    }
+    free( buf );
+}
+
+static void list_all_macros(void)
+{
+    DWORD len = GetConsoleAliasExesLengthW();
+    WCHAR *buf, *p;
+
+    if (!len || !(buf = malloc( len + sizeof(WCHAR) ))) return;
+    if (GetConsoleAliasExesW( buf, len ))
+    {
+        buf[len / sizeof(WCHAR)] = 0;
+        for (p = buf; p < buf + len / sizeof(WCHAR) && *p; p += wcslen( p ) + 1) list_macros( p, TRUE );
+    }
+    free( buf );
+}
+
+static void list_history( const WCHAR *exe )
+{
+    DWORD len = GetConsoleCommandHistoryLengthW( (WCHAR *)exe );
+    WCHAR *buf, *p;
+
+    if (!len || !(buf = malloc( len + sizeof(WCHAR) ))) return;
+    if (GetConsoleCommandHistoryW( buf, len, (WCHAR *)exe ))
+    {
+        buf[len / sizeof(WCHAR)] = 0;
+        for (p = buf; p < buf + len / sizeof(WCHAR) && *p; p += wcslen( p ) + 1) output_line( p );
+    }
+    free( buf );
+}
+
+/* name=text: a macro for exe; name= removes it. FALSE: no '=' (Windows says nothing either) */
+static BOOL define_macro( WCHAR *def, const WCHAR *exe )
+{
+    WCHAR *eq = wcschr( def, '=' ), *end;
+
+    if (!eq) return FALSE;
+    *eq = 0;
+    /* the name ends at its last non-blank character; the text is kept as typed */
+    for (end = eq; end > def && (end[-1] == ' ' || end[-1] == '\t'); end--) end[-1] = 0;
+    if (!*def) return FALSE;
+#ifdef SG_MUTANT_DOSKEY_NO_ALIAS
+    return TRUE;
+#endif
+    AddConsoleAliasW( def, eq[1] ? eq + 1 : NULL, (WCHAR *)exe );
+    return TRUE;
+}
+
+static void load_macro_file( const WCHAR *path, const WCHAR *exe )
+{
+    HANDLE file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    DWORD size, got;
+    char *data;
+    WCHAR *text, *line, *next;
+    int n;
+
+    if (file == INVALID_HANDLE_VALUE) return;
+    size = GetFileSize( file, NULL );
+    if (size == INVALID_FILE_SIZE || !(data = malloc( size + 1 )))
+    {
+        CloseHandle( file );
+        return;
+    }
+    ReadFile( file, data, size, &got, NULL );
+    CloseHandle( file );
+    n = MultiByteToWideChar( GetConsoleCP(), 0, data, got, NULL, 0 );
+    if ((text = malloc( (n + 1) * sizeof(WCHAR) )))
+    {
+        MultiByteToWideChar( GetConsoleCP(), 0, data, got, text, n );
+        text[n] = 0;
+        /* lines of name=text; [exename] starts the macros of another program */
+        for (line = text; line && *line; line = next)
+        {
+            WCHAR *cur_exe;
+            if ((next = wcspbrk( line, L"\r\n" ))) { *next++ = 0; while (*next == '\r' || *next == '\n') next++; }
+            if (line[0] == '[' && wcschr( line, ']' ))
+            {
+                *wcschr( line, ']' ) = 0;
+                cur_exe = line + 1;
+                exe = cur_exe;
+                continue;
+            }
+            define_macro( line, exe );
+        }
+        free( text );
+    }
+    free( data );
+}
+
+/* the rest of the command line after the program's own name, as typed (macro text keeps its quotes) */
+static WCHAR *after_program_name( WCHAR *cmd )
+{
+    if (*cmd == '"')
+    {
+        cmd++;
+        while (*cmd && *cmd != '"') cmd++;
+        if (*cmd) cmd++;
+    }
+    else while (*cmd && *cmd != ' ' && *cmd != '\t') cmd++;
+    while (*cmd == ' ' || *cmd == '\t') cmd++;
+    return cmd;
+}
+
+static BOOL switch_is( const WCHAR *arg, size_t len, const WCHAR *name )
+{
+    return wcslen( name ) == len && !wcsnicmp( arg, name, len );
+}
+
+int __cdecl wmain( int argc, WCHAR *argv[] )
+{
+    WCHAR *cmd = after_program_name( GetCommandLineW() ), exe[MAX_PATH] = L"cmd.exe";
+    WCHAR *macro_file = NULL, *macros = NULL;
+    BOOL show_history = FALSE, show_macros = FALSE;
+
+    /* switches come first; the first word that is not one starts the macro definition */
+    while (*cmd == '/' || *cmd == '-')
+    {
+        WCHAR *start = cmd + 1, *value = NULL;
+        size_t len;
+
+        while (*cmd && *cmd != ' ' && *cmd != '\t') cmd++;
+        len = cmd - start;
+        if (*cmd) *cmd++ = 0;
+        while (*cmd == ' ' || *cmd == '\t') cmd++;
+        if ((value = wcspbrk( start, L"=:" ))) len = value++ - start;
+
+        if (switch_is( start, len, L"?" )) { usage(); return 0; }
+        else if (switch_is( start, len, L"EXENAME" ) && value) lstrcpynW( exe, value, ARRAY_SIZE(exe) );
+        else if (switch_is( start, len, L"MACROS" )) { show_macros = TRUE; macros = value; }
+        else if (switch_is( start, len, L"HISTORY" ) || switch_is( start, len, L"H" )) show_history = TRUE;
+        else if (switch_is( start, len, L"MACROFILE" ) && value) macro_file = value;
+        else if (switch_is( start, len, L"LISTSIZE" ) && value) SetConsoleNumberOfCommandsW( wcstoul( value, NULL, 10 ), exe );
+        else if (switch_is( start, len, L"REINSTALL" ) || switch_is( start, len, L"INSERT" ) ||
+                 switch_is( start, len, L"OVERSTRIKE" )) ; /* the console host is always there */
+        else if (switch_is( start, len, L"M" )) show_macros = TRUE;
+        else
+        {
+            output( L"Invalid switch - /", 18 ); output_line( start );
+            return 1;
+        }
+    }
+
+    if (macro_file) load_macro_file( macro_file, exe );
+    if (*cmd) define_macro( cmd, exe );
+    if (show_macros)
+    {
+        if (macros && !wcsicmp( macros, L"ALL" )) list_all_macros();
+        else list_macros( macros && *macros ? macros : exe, FALSE );
+    }
+    if (show_history) list_history( exe );
+    return 0;
+}
