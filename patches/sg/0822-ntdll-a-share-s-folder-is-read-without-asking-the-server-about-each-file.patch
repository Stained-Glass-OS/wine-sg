From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: a share's folder is read without asking the server about each file

David: "we still have issues with SMB ... it draws the icons somewhat
slowly at first". Reading a folder, Wine looks up each file's hidden and
system attributes in its "user.DOSATTRIB" extended attribute. On a share
mounted with the kernel's SMB client (sg-netmountd) every read of such an
attribute is a request to the file server -- one network round trip per
file -- and it never finds anything: neither a Samba nor a Windows server
offers its DOS attributes under that name. A folder of 2000 files on a
Linux server cost 2000 round trips: 7.6 s over a 3 ms (Wi-Fi-like) link,
with File Explorer's window blank meanwhile, and the server's own hidden
files were shown as not hidden.

The SMB client already holds the attributes the server sent with the
folder's listing and gives them out as "user.cifs.dosattrib" without asking
the server while its attribute cache is fresh. On an SMB mount (statfs,
remembered per device) that is what is read now: the server's hidden,
system and read-only attributes, with no network request. Other file
systems, and an SMB mount that cannot give them, are read as before.

Test: test/smbshare-gate.sh with test/smbshare-probe.c and test/smbshim.c,
a stand-in SMB client (mutant SG_MUTANT_SMB_DOSATTRIB_EA). On the lab
network (2000 files, 3 ms round trip): 7.6 s -> 0.12 s.
---
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -1650,6 +1650,79 @@
 }
 
 
+/* Stained Glass OS: the DOS attributes of a file on an SMB share.
+ *
+ * Wine keeps a file's hidden and system attributes in a "user.DOSATTRIB"
+ * extended attribute. On a share mounted with the kernel's SMB client
+ * (CIFS) every read of a user.* attribute is a request to the file server:
+ * one network round trip per file, so reading a folder of 2000 files cost
+ * 2000 round trips -- eight seconds of a blank File Explorer window over
+ * Wi-Fi (David: a share's folder "draws slowly"). And it never found
+ * anything: a Samba or Windows server does not offer its own DOS attributes
+ * as an extended attribute of that name.
+ *
+ * The SMB client already holds the attributes the server sent with the
+ * directory listing (or the last query) and hands them out as
+ * "user.cifs.dosattrib" without asking the server again while its attribute
+ * cache is fresh. On such a mount that is what is read: the server's own
+ * hidden, system and read-only attributes, at no network cost. A file system
+ * that is not SMB is never asked for it; when it cannot be read, the usual
+ * attribute is read as before. */
+#define SG_CIFS_MAGIC_NUMBER 0xff534d42
+#define SG_SMB2_MAGIC_NUMBER 0xfe534d42
+#define SG_CIFS_DOSATTRIB    XATTR_USER_PREFIX "cifs.dosattrib"
+
+static pthread_mutex_t sg_smb_dev_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+/* whether a device is an SMB mount; remembered per device (16 of them) */
+static BOOL sg_dev_is_smb( dev_t dev, const char *path, int fd )
+{
+    static struct { dev_t dev; BOOL smb; } cache[16];
+    static unsigned int count;
+    struct statfs sfs;
+    unsigned int i;
+    BOOL smb;
+
+    pthread_mutex_lock( &sg_smb_dev_mutex );
+    for (i = 0; i < count && i < ARRAY_SIZE(cache); i++)
+        if (cache[i].dev == dev)
+        {
+            smb = cache[i].smb;
+            pthread_mutex_unlock( &sg_smb_dev_mutex );
+            return smb;
+        }
+    pthread_mutex_unlock( &sg_smb_dev_mutex );
+
+    if ((path ? statfs( path, &sfs ) : fstatfs( fd, &sfs )) == -1) return FALSE;
+    smb = ((unsigned int)sfs.f_type == SG_CIFS_MAGIC_NUMBER || (unsigned int)sfs.f_type == SG_SMB2_MAGIC_NUMBER);
+
+    pthread_mutex_lock( &sg_smb_dev_mutex );
+    cache[count++ % ARRAY_SIZE(cache)].dev = dev;
+    cache[(count - 1) % ARRAY_SIZE(cache)].smb = smb;
+    pthread_mutex_unlock( &sg_smb_dev_mutex );
+    return smb;
+}
+
+/* the server's DOS attributes of a file on an SMB mount, from the client's
+ * cache; FALSE when the file is not on one or they cannot be had */
+static BOOL sg_smb_dos_attrib( const char *path, int fd, const struct stat *st, ULONG *attr )
+{
+#ifdef SG_MUTANT_SMB_DOSATTRIB_EA
+    return FALSE;
+#else
+    unsigned int value;
+    int len;
+
+    if (!sg_dev_is_smb( st->st_dev, path, fd )) return FALSE;
+    len = path ? xattr_get( path, SG_CIFS_DOSATTRIB, &value, sizeof(value) )
+               : xattr_fget( fd, SG_CIFS_DOSATTRIB, &value, sizeof(value) );
+    if (len != sizeof(value)) return FALSE;
+    *attr |= value & (FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM | FILE_ATTRIBUTE_READONLY);
+    return TRUE;
+#endif
+}
+
+
 /* get the stat info and file attributes for a file (by file descriptor) */
 static int fd_get_file_info( int fd, unsigned int options, struct stat *st, ULONG *attr )
 {
@@ -1663,6 +1736,9 @@
     /* consider mount points to be reparse points (IO_REPARSE_TAG_MOUNT_POINT) */
     if ((options & FILE_OPEN_REPARSE_POINT) && fd_is_mount_point( fd, st ))
         *attr |= FILE_ATTRIBUTE_REPARSE_POINT;
+
+    /* Stained Glass OS: a file on an SMB share: the server's attributes */
+    if (sg_smb_dos_attrib( NULL, fd, st, attr )) return ret;
 
     attr_len = xattr_fget( fd, SAMBA_XATTR_DOS_ATTRIB, attr_data, sizeof(attr_data)-1 );
     if (attr_len != -1)
@@ -1785,6 +1861,13 @@
         free( parent_path );
     }
     *attr |= get_file_attributes( st );
+
+    /* Stained Glass OS: a file on an SMB share: the server's attributes */
+    if (sg_smb_dos_attrib( path, -1, st, attr ))
