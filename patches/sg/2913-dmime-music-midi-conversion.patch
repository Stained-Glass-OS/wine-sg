From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dmime: MIDIToMusic / MusicToMIDI for the non-fixed play modes

IDirectMusicPerformance::MIDIToMusic / MusicToMIDI for the play modes other
than DMUS_PLAYMODE_FIXED, following the documented music value format:
bits 12-15 octave, bits 8-11 chord position (index of the chord tone), bits
4-7 scale offset (scale steps above the chord tone), bits 0-3 accidental
(signed semitones). The chord and scale patterns have bit n set for the note
n semitones above their root. The play mode selects the root (the scale root
for DMUS_PLAYMODE_KEY_ROOT, the chord root otherwise) and whether the chord
and / or scale intervals are used; modes without intervals (fixed to the key
or chord) add the root to a note given in C. The sub chord is the one whose
dwLevels has the bit of the chord level.

Results: S_OK; DMUS_S_OVER_CHORD when the chord position is beyond the chord
(the last chord tone is used); DMUS_S_UP_OCTAVE / DMUS_S_DOWN_OCTAVE when the
note was moved into the MIDI range 0-127; DMUS_E_CANNOT_CONVERT for a chord
without sub chords, DMUS_PLAYMODE_NONE, an empty chord / scale pattern that
the mode needs, or a MIDI value that no accidental in -8..7 can reach; E_POINTER
for a missing chord. MIDIToMusic picks the chord tone and scale offset which
leave the smallest accidental (ties go to the lower scale offset, then the
lower chord position), so MusicToMIDI(MIDIToMusic(x)) is x.

The tables the format needs are in the note (patches/notes/2913.txt) as
assumptions where no Windows output was available.
---
diff --git a/dlls/dmime/performance.c b/dlls/dmime/performance.c
index a85d51d..3740723 100644
--- a/dlls/dmime/performance.c
+++ b/dlls/dmime/performance.c
@@ -1773,6 +1773,168 @@ static HRESULT WINAPI performance_GetResolvedTime(IDirectMusicPerformance8 *ifac
     return performance_resolve_time(This, time, flags, resolved);
 }
 
+/* Music values: bits 12-15 octave, bits 8-11 chord position (index of the chord tone), bits 4-7 scale
+ * offset (scale steps above the chord tone) and bits 0-3 accidental (signed semitones). The chord is
+ * read from the sub chord whose dwLevels has the bit of the chord level, chord and scale patterns have
+ * bit n set for the note n semitones above their root. */
+#define MUSIC_OCTAVE(v) ((v) >> 12)
+#define MUSIC_CHORD_POS(v) (((v) >> 8) & 0xf)
+#define MUSIC_SCALE_OFFSET(v) (((v) >> 4) & 0xf)
+#define MUSIC_ACCIDENTAL(v) ((int)(((v) & 0xf) ^ 8) - 8)
+
+struct music_context
+{
+    int root;           /* pitch class (0-11) the note is counted from */
+    DWORD chord;        /* chord pattern */
+    DWORD scale;        /* scale pattern */
+    int scale_root;
+    BOOL use_chord, use_scale;
+    int tones[24], tone_count;
+};
+
+static HRESULT music_context_init(struct music_context *ctx, const DMUS_CHORD_KEY *chord, BYTE mode, BYTE level)
+{
+    const DMUS_SUBCHORD *sub = NULL;
+    unsigned int i;
+
+    memset(ctx, 0, sizeof(*ctx));
+    if (!chord) return E_POINTER;
+    if ((mode & ~0x1f) || (mode & DMUS_PLAYMODE_NONE)) return DMUS_E_CANNOT_CONVERT;
+    if (!chord->bSubChordCount || chord->bSubChordCount > DMUS_MAXSUBCHORD) return DMUS_E_CANNOT_CONVERT;
+
+    /* the sub chord of the level, the first one when no sub chord claims it */
+    for (i = 0; i < chord->bSubChordCount; i++)
+        if (level < 32 && (chord->SubChordList[i].dwLevels & (1u << level))) { sub = &chord->SubChordList[i]; break; }
+    if (!sub) sub = &chord->SubChordList[0];
+
+    ctx->scale = sub->dwScalePattern ? sub->dwScalePattern : chord->dwScale;
+    ctx->scale_root = (sub->dwScalePattern ? sub->bScaleRoot : chord->bKey) % 12;
+    ctx->chord = sub->dwChordPattern;
+    ctx->root = ((mode & DMUS_PLAYMODE_KEY_ROOT) ? ctx->scale_root : sub->bChordRoot) % 12;
+    ctx->use_chord = !!(mode & DMUS_PLAYMODE_CHORD_INTERVALS);
+    ctx->use_scale = !!(mode & DMUS_PLAYMODE_SCALE_INTERVALS);
+
+    for (i = 0; i < 24; i++)
+        if (ctx->chord & (1u << i)) ctx->tones[ctx->tone_count++] = i;
+    if (ctx->use_chord && !ctx->tone_count) return DMUS_E_CANNOT_CONVERT;
+    if (ctx->use_scale && !((ctx->scale | ctx->scale >> 12) & 0xfff)) return DMUS_E_CANNOT_CONVERT;
+    return S_OK;
+}
+
+/* the pitch (in semitones above the context's root) which is steps scale notes above the pitch from */
+static int music_scale_walk(const struct music_context *ctx, int from, int steps)
+{
+    DWORD pattern = (ctx->scale | ctx->scale >> 12) & 0xfff;
+    int pitch = from;
+
+    while (steps-- > 0)
+    {
+        do pitch++;
+        while (!(pattern & (1u << (((pitch + ctx->root - ctx->scale_root) % 12 + 12) % 12))));
+    }
+    return pitch;
+}
+
+static HRESULT music_to_midi(WORD music, const DMUS_CHORD_KEY *chord, BYTE mode, BYTE level, BYTE *midi)
+{
+    HRESULT hr, ret = S_OK;
+    struct music_context ctx;
+    int value;
+
+    if (FAILED(hr = music_context_init(&ctx, chord, mode, level))) return hr;
+
+    if (!ctx.use_chord && !ctx.use_scale)
+    {
+        /* fixed to the key or chord: the music value is a note in C, moved by the root */
+        if (music > 127) return DMUS_E_CANNOT_CONVERT;
+        value = music + ctx.root;
+    }
+    else
+    {
+        int pos = MUSIC_CHORD_POS(music), semis = 0;
+
+        if (ctx.use_chord)
+        {
+            if (pos >= ctx.tone_count)
+            {
+                pos = ctx.tone_count - 1;
+                ret = DMUS_S_OVER_CHORD;
+            }
+            semis = ctx.tones[pos];
+        }
+#ifdef SG_MUTANT_MUSIC_SCALE
+        ctx.use_scale = FALSE;
+#endif
+        if (ctx.use_scale) semis = music_scale_walk(&ctx, semis, MUSIC_SCALE_OFFSET(music));
+        value = MUSIC_OCTAVE(music) * 12 + ctx.root + semis + MUSIC_ACCIDENTAL(music);
+    }
+
+#ifdef SG_MUTANT_MUSIC_OCTAVE
+    value += 12;
+#endif
+    while (value > 127)
+    {
+        value -= 12;
+        if (!ret) ret = DMUS_S_DOWN_OCTAVE;
+    }
+    while (value < 0)
+    {
+        value += 12;
+        if (!ret) ret = DMUS_S_UP_OCTAVE;
+    }
+    *midi = value;
+    return ret;
+}
+
+static HRESULT midi_to_music(BYTE midi, const DMUS_CHORD_KEY *chord, BYTE mode, BYTE level, WORD *music)
+{
+    int octave, target, best_abs = 100, best_pos = 0, best_scale = 0, best_acc = 0, pos, steps;
+    struct music_context ctx;
+    HRESULT hr, ret = S_OK;
+
+    if (FAILED(hr = music_context_init(&ctx, chord, mode, level))) return hr;
+
+    if (!ctx.use_chord && !ctx.use_scale)
+    {
+        int value = midi - ctx.root;
+        if (value < 0)
+        {
+            value += 12;
+            ret = DMUS_S_UP_OCTAVE;
+        }
+        *music = value;
+        return ret;
+    }
+
+    octave = max((midi - ctx.root) / 12, 0);
+    if (midi - ctx.root < 0) octave = 0;
+    target = midi - ctx.root - octave * 12;
+
+    /* the chord tone and scale offset which come closest, the accidental takes the rest */
+    for (steps = 0; steps < (ctx.use_scale ? 16 : 1); steps++)
+    {
+        for (pos = 0; pos < (ctx.use_chord ? min(ctx.tone_count, 16) : 1); pos++)
+        {
+            int semis = ctx.use_chord ? ctx.tones[pos] : 0, acc;
+
+            if (ctx.use_scale) semis = music_scale_walk(&ctx, semis, steps);
+            acc = target - semis;
+            if (acc < -8 || acc > 7 || abs(acc) >= best_abs) continue;
+            best_abs = abs(acc);
+            best_pos = pos;
+            best_scale = steps;
+            best_acc = acc;
+        }
+    }
+    if (best_abs == 100) return DMUS_E_CANNOT_CONVERT;
+
+#ifdef SG_MUTANT_MUSIC_ACCIDENTAL
+    best_acc = -best_acc;
+#endif
+    *music = (octave << 12) | (best_pos << 8) | (best_scale << 4) | (best_acc & 0xf);
+    return S_OK;
+}
+
 static HRESULT WINAPI performance_MIDIToMusic(IDirectMusicPerformance8 *iface, BYTE midi_value,
         DMUS_CHORD_KEY *chord, BYTE play_mode, BYTE chord_level, WORD *music_value)
 {
@@ -1793,8 +1955,7 @@ static HRESULT WINAPI performance_MIDIToMusic(IDirectMusicPerformance8 *iface, B
         return S_OK;
     }
 
-    FIXME("play mode %#x needs the scale and chord tables, not implemented\n", play_mode);
-    return E_NOTIMPL;
+    return midi_to_music(midi_value, chord, play_mode, chord_level, music_value);
 }
 
 static HRESULT WINAPI performance_MusicToMIDI(IDirectMusicPerformance8 *iface, WORD music_value,
@@ -1812,8 +1973,7 @@ static HRESULT WINAPI performance_MusicToMIDI(IDirectMusicPerformance8 *iface, W
         return S_OK;
     }
 
-    FIXME("play mode %#x needs the scale and chord tables, not implemented\n", play_mode);
-    return E_NOTIMPL;
+    return music_to_midi(music_value, chord, play_mode, chord_level, midi_value);
 }
 
 static HRESULT WINAPI performance_TimeToRhythm(IDirectMusicPerformance8 *iface, MUSIC_TIME time,
