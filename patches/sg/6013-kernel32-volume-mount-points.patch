     return ret;
 }
 
+/* Stained Glass OS: the folders a volume is mounted on (SetVolumeMountPoint
+ * keeps them here, as the volume's reparse index does on Windows) */
+static const WCHAR mounted_folders_key[] = L"Software\\Wine\\MountedFolders";
+
+struct mount_point_enum
+{
+    DWORD magic;
+    DWORD next, count;
+    WCHAR **names;
+};
+#define MOUNT_ENUM_MAGIC 0x4d4e5450
+
+static void free_mount_enum( struct mount_point_enum *e )
+{
+    DWORD i;
+    for (i = 0; i < e->count; i++) HeapFree( GetProcessHeap(), 0, e->names[i] );
+    HeapFree( GetProcessHeap(), 0, e->names );
+    e->magic = 0;
+    HeapFree( GetProcessHeap(), 0, e );
+}
+
+static BOOL next_mount_point( struct mount_point_enum *e, WCHAR *mount_point, DWORD len )
+{
+    if (e->next >= e->count)
+    {
+        SetLastError( ERROR_NO_MORE_FILES );
+        return FALSE;
+    }
+    if (lstrlenW( e->names[e->next] ) + 1 > len)
+    {
+        SetLastError( ERROR_FILENAME_EXCED_RANGE );
+        return FALSE;
+    }
+    lstrcpyW( mount_point, e->names[e->next++] );
+    return TRUE;
+}
+
 /***********************************************************************
  *           FindFirstVolumeMountPointW   (KERNEL32.@)
  */
 HANDLE WINAPI FindFirstVolumeMountPointW(LPCWSTR root, LPWSTR mount_point, DWORD len)
 {
-    WCHAR volume[MAX_PATH];
+    WCHAR volume[MAX_PATH], path[MAX_PATH], other[MAX_PATH], drive[MAX_PATH];
+    struct mount_point_enum *e;
+    DWORD i, name_len, type, size;
+    HKEY key;
 
     TRACE("(%s, %p, %ld)\n", debugstr_w(root), mount_point, len);
 
@@ -564,11 +605,78 @@ HANDLE WINAPI FindFirstVolumeMountPointW(LPCWSTR root, LPWSTR mount_point, DWORD
         SetLastError( ERROR_INVALID_PARAMETER );
         return INVALID_HANDLE_VALUE;
     }
-    /* the root must be that of a volume; nothing here has folder mount points (a volume is
-     * only ever mounted on a drive letter), so there is nothing to enumerate */
+    /* the root must be that of a volume (a drive root or a volume name) */
     if (!GetVolumeNameForVolumeMountPointW( root, volume, ARRAY_SIZE(volume) )) return INVALID_HANDLE_VALUE;
-    SetLastError( ERROR_NO_MORE_FILES );
-    return INVALID_HANDLE_VALUE;
+    if (!(e = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*e) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return INVALID_HANDLE_VALUE;
+    }
+    e->magic = MOUNT_ENUM_MAGIC;
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, mounted_folders_key, 0, KEY_READ, &key ))
+    {
+        for (i = 0; ; i++)
+        {
+            name_len = ARRAY_SIZE(path);
+            size = sizeof(other);
+            if (RegEnumValueW( key, i, path, &name_len, NULL, &type, (BYTE *)other, &size )) break;
+            /* a folder on this volume: its path below the volume's root */
+            if (lstrlenW( path ) < 4 || path[1] != ':' || path[2] != '\\') continue;
+            drive[0] = path[0]; drive[1] = ':'; drive[2] = '\\'; drive[3] = 0;
+            if (!GetVolumeNameForVolumeMountPointW( drive, other, ARRAY_SIZE(other) ) || wcsicmp( other, volume ))
+                continue;
+            if (!(e->names = e->names ? HeapReAlloc( GetProcessHeap(), 0, e->names, (e->count + 1) * sizeof(WCHAR *) )
+                                      : HeapAlloc( GetProcessHeap(), 0, sizeof(WCHAR *) )))
+                break;
+            if ((e->names[e->count] = HeapAlloc( GetProcessHeap(), 0, (lstrlenW( path ) + 1) * sizeof(WCHAR) )))
+                lstrcpyW( e->names[e->count++], path + lstrlenW( drive ) );
+        }
+        RegCloseKey( key );
+    }
+#ifdef SG_MUTANT_MOUNT_NO_ENUM
+    e->count = 0;
+#endif
+    if (!next_mount_point( e, mount_point, len ))
+    {
+        DWORD err = GetLastError();
+        free_mount_enum( e );
+        SetLastError( err );
+        return INVALID_HANDLE_VALUE;
+    }
+    return e;
+}
+
+/***********************************************************************
+ *           FindNextVolumeMountPointW   (KERNEL32.@)
+ */
+BOOL WINAPI FindNextVolumeMountPointW(HANDLE h, LPWSTR mount_point, DWORD len)
+{
+    struct mount_point_enum *e = h;
+
+    TRACE("(%p, %p, %ld)\n", h, mount_point, len);
+
+    if (!e || e == INVALID_HANDLE_VALUE || e->magic != MOUNT_ENUM_MAGIC || !mount_point)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return next_mount_point( e, mount_point, len );
+}
+
+/***********************************************************************
+ *           FindNextVolumeMountPointA   (KERNEL32.@)
+ */
+BOOL WINAPI FindNextVolumeMountPointA(HANDLE h, LPSTR mount_point, DWORD len)
+{
+    WCHAR buffer[MAX_PATH];
+
+    if (!FindNextVolumeMountPointW( h, buffer, ARRAY_SIZE(buffer) )) return FALSE;
+    if (!WideCharToMultiByte( CP_ACP, 0, buffer, -1, mount_point, len, NULL, NULL ))
+    {
+        SetLastError( ERROR_FILENAME_EXCED_RANGE );
+        return FALSE;
+    }
+    return TRUE;
 }
 
