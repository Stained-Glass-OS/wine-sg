+/* Stained Glass OS: the drive root a mounted folder (a mount point / junction)
+ * leads to, from its reparse data */
+static BOOL get_mounted_folder_target( const WCHAR *path, WCHAR *target, DWORD size )
+{
+    BYTE buffer[MAXIMUM_REPARSE_DATA_BUFFER_SIZE];
+    REPARSE_DATA_BUFFER *data = (REPARSE_DATA_BUFFER *)buffer;
+    const WCHAR *name;
+    USHORT len;
+    HANDLE file;
+    DWORD out;
+    BOOL ret;
+
+    WCHAR folder[MAX_PATH];
+    DWORD path_len = lstrlenW( path );
