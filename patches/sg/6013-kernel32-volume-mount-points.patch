@@ -615,7 +745,82 @@ BOOL WINAPI SetVolumeMountPointA(LPCSTR path, LPCSTR volume)
  */
 BOOL WINAPI SetVolumeMountPointW(LPCWSTR path, LPCWSTR volume)
 {
-    FIXME("(%s, %s), stub!\n", debugstr_w(path), debugstr_w(volume));
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    WCHAR names[MAX_PATH * 4], target[4];
+    BYTE buffer[512];
+    REPARSE_DATA_BUFFER *data = (REPARSE_DATA_BUFFER *)buffer;
+    WIN32_FIND_DATAW fd;
+    WCHAR pattern[MAX_PATH + 2];
+    DWORD len, size, out;
+    HANDLE file, find;
+    BOOL ret;
+    HKEY key;
+
+    TRACE("(%s, %s)\n", debugstr_w(path), debugstr_w(volume));
+
+    if (!path || !volume || !(len = lstrlenW( path )) || path[len - 1] != '\\')
+    {
+        SetLastError( ERROR_INVALID_NAME );
+        return FALSE;
+    }
+    if (wcsnicmp( volume, L"\\\\?\\Volume{", 11 ) || volume[lstrlenW( volume ) - 1] != '\\')
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* Stained Glass OS: a volume is mounted on a drive letter; the folder
+     * becomes a mount point (junction) to that drive's root */
+    if (!GetVolumePathNamesForVolumeNameW( volume, names, ARRAY_SIZE(names), &size ) || !names[0] ||
+        lstrlenW( names ) != 3)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    lstrcpyW( target, names );
+    /* the folder must be there and empty */
+    if (len + 2 > ARRAY_SIZE(pattern))
+    {
+        SetLastError( ERROR_FILENAME_EXCED_RANGE );
+        return FALSE;
+    }
+    lstrcpyW( pattern, path );
+    lstrcatW( pattern, L"*" );
+    if ((find = FindFirstFileW( pattern, &fd )) == INVALID_HANDLE_VALUE)
+    {
+        SetLastError( ERROR_PATH_NOT_FOUND );
+        return FALSE;
+    }
+    do
+    {
+        if (wcscmp( fd.cFileName, L"." ) && wcscmp( fd.cFileName, L".." ))
+        {
+            FindClose( find );
+            SetLastError( ERROR_DIR_NOT_EMPTY );
+            return FALSE;
+        }
+    } while (FindNextFileW( find, &fd ));
+    FindClose( find );
+
+    /* \??\D:\ (substitute name), D:\ (print name) */
+    memset( buffer, 0, sizeof(buffer) );
+    data->ReparseTag = IO_REPARSE_TAG_MOUNT_POINT;
+    data->MountPointReparseBuffer.SubstituteNameOffset = 0;
+    data->MountPointReparseBuffer.SubstituteNameLength = 7 * sizeof(WCHAR);
+    data->MountPointReparseBuffer.PrintNameOffset = 8 * sizeof(WCHAR);
+    data->MountPointReparseBuffer.PrintNameLength = 3 * sizeof(WCHAR);
+    memcpy( data->MountPointReparseBuffer.PathBuffer, L"\\??\\", 4 * sizeof(WCHAR) );
+    memcpy( data->MountPointReparseBuffer.PathBuffer + 4, target, 3 * sizeof(WCHAR) );
+    memcpy( data->MountPointReparseBuffer.PathBuffer + 8, target, 3 * sizeof(WCHAR) );
+    data->ReparseDataLength = 8 + 12 * sizeof(WCHAR);
+    file = CreateFileW( path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+                        FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, NULL );
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    ret = DeviceIoControl( file, FSCTL_SET_REPARSE_POINT, buffer, 8 + data->ReparseDataLength, NULL, 0, &out, NULL );
+    CloseHandle( file );
+    if (!ret) return FALSE;
+    if (!RegCreateKeyExW( HKEY_LOCAL_MACHINE, mounted_folders_key, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL ))
+    {
+        RegSetValueExW( key, path, 0, REG_SZ, (const BYTE *)volume, (lstrlenW( volume ) + 1) * sizeof(WCHAR) );
+        RegCloseKey( key );
+    }
+    return TRUE;
 }
