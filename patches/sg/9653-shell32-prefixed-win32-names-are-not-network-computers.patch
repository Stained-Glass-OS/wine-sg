From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: \\?\ names are the items they name; ? and . are no computers

Transmission 4.1 (Qt) parses its settings folder in its long-path form,
"\\?\C:\users\...\transmission", at start. The desktop sent every name that begins
with two backslashes to the Network, which took "?" for a computer and asked for
a name and password to connect to it: an "Enter network credentials" dialog stood
in front of the program. A name with the \\?\ prefix now names the same item as
without it, as PathGetDriveNumber reads it (\\?\C:\... is C:\..., \\?\UNC\s\x is
\\s\x), and the Network never looks for a computer called "?" or "." (they begin
Win32 file and device names): such a name fails at once, asking nothing.

Test: test/prefixparse-gate.sh (mutants SG_MUTANT_PREFIXED_PATH_IS_NETWORK,
SG_MUTANT_DOT_IS_COMPUTER).
---
--- a/dlls/shell32/shfldr_desktop.c
+++ b/dlls/shell32/shfldr_desktop.c
@@ -168,6 +168,33 @@
 
     /* pchEaten is left alone, as Windows does */
 
+#ifndef SG_MUTANT_PREFIXED_PATH_IS_NETWORK
+    /* Stained Glass OS: a Win32 file name with the \\?\ prefix (Qt gives the
+     * shell its long-path form, "\\?\C:\users\...") names the same item
+     * as without it, as PathGetDriveNumber reads it: \\?\C:\... is C:\...,
+     * \\?\UNC\server\share is \\server\share. It went to the Network as a
+     * computer called "?", which asked for a name and password to connect to
+     * it (Transmission 4.1 at start). */
+    if (!wcsncmp(lpszDisplayName, L"\\\\?\\", 4) && wcsnicmp(lpszDisplayName + 4, L"unix\\", 5))
+    {
+        const WCHAR *rest = lpszDisplayName + 4;
+
+        if ((c = towupper(rest[0])) >= 'A' && c <= 'Z' && rest[1] == ':')
+            return ISF_Desktop_fnParseDisplayName(iface, hwndOwner, pbc, (LPOLESTR)rest, pchEaten, ppidl, pdwAttributes);
+        if (!wcsnicmp(rest, L"UNC\\", 4) && rest[4])
+        {
+            WCHAR *unc = malloc((wcslen(rest + 3) + 2) * sizeof(WCHAR));
+
+            if (!unc) return E_OUTOFMEMORY;
+            unc[0] = '\\';
+            lstrcpyW(unc + 1, rest + 3);
+            hr = ISF_Desktop_fnParseDisplayName(iface, hwndOwner, pbc, unc, pchEaten, ppidl, pdwAttributes);
+            free(unc);
+            return hr;
+        }
+    }
+#endif
+
     urldata.cbSize = sizeof(urldata);
 
     if (lpszDisplayName[0] == ':' && lpszDisplayName[1] == ':')
--- a/dlls/shell32/shfldr_netplaces.c
+++ b/dlls/shell32/shfldr_netplaces.c
@@ -412,6 +412,11 @@
     {
         szNext = GetNextElementW(lpszDisplayName + 2, szElement, MAX_PATH);
         if (!szElement[0]) return E_INVALIDARG;
+        /* Stained Glass OS: "\\?\" and "\\.\" begin Win32 file and device
+         * names, never a computer's: nothing on the network is asked for them */
+#ifndef SG_MUTANT_DOT_IS_COMPUTER
+        if (!wcscmp(szElement, L"?") || !wcscmp(szElement, L".")) return HRESULT_FROM_WIN32(ERROR_BAD_NET_NAME);
+#endif
         if (!(pidlTemp = _ILCreateComputer(szElement))) return E_OUTOFMEMORY;
         hr = S_OK;
     }
