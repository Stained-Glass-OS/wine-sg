From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ncrypt: NCryptTranslateHandle

NCryptTranslateHandle gives a CNG key for a CryptoAPI key (or for a CryptoAPI provider's key pair of the given key spec). CryptoAPI and CNG keep separate key stores here, so the CNG key is a copy in the Software Key Storage Provider: the private blob, converted by bcrypt, when the key can be exported, else the public half. It was a spec stub (the JDKs' sunmscapi.dll imports it). ncrypt.h gains it.
---
--- a/include/ncrypt.h
+++ b/include/ncrypt.h
@@ -212,6 +212,7 @@
 SECURITY_STATUS WINAPI NCryptIsAlgSupported(NCRYPT_PROV_HANDLE, const WCHAR *, DWORD);
 SECURITY_STATUS WINAPI NCryptOpenKey(NCRYPT_PROV_HANDLE, NCRYPT_KEY_HANDLE *, const WCHAR *, DWORD, DWORD);
 SECURITY_STATUS WINAPI NCryptOpenStorageProvider(NCRYPT_PROV_HANDLE *, const WCHAR *, DWORD);
+SECURITY_STATUS WINAPI NCryptTranslateHandle(NCRYPT_PROV_HANDLE *, NCRYPT_KEY_HANDLE *, ULONG_PTR, ULONG_PTR, DWORD, DWORD);
 SECURITY_STATUS WINAPI NCryptSetProperty(NCRYPT_HANDLE, const WCHAR *, BYTE *, DWORD, DWORD);
 SECURITY_STATUS WINAPI NCryptSignHash(NCRYPT_KEY_HANDLE, void *, BYTE *, DWORD, BYTE *, DWORD, DWORD *, DWORD);
 SECURITY_STATUS WINAPI NCryptVerifySignature(NCRYPT_KEY_HANDLE, void *, BYTE *, DWORD, BYTE *, DWORD, DWORD);
--- a/dlls/ncrypt/main.c
+++ b/dlls/ncrypt/main.c
@@ -2006,3 +2006,143 @@
     if (result) *result = 0;
     return NTE_NOT_SUPPORTED;
 }
+
+#ifndef SG_MUTANT_NO_TRANSLATE_HANDLE
+/* (wine-sg 8260) A CNG key for a CryptoAPI key: the legacy key (or the provider's key pair of that key spec)
+ * is exported as a CryptoAPI blob and imported into the Microsoft Software Key Storage Provider. CryptoAPI and
+ * CNG keep separate key stores here, so the CNG key is a copy, and a key that cannot be exported -- its
+ * private half, at least -- only gives its public half. */
+SECURITY_STATUS WINAPI NCryptTranslateHandle(NCRYPT_PROV_HANDLE *provider, NCRYPT_KEY_HANDLE *key, HCRYPTPROV legacy_prov,
+                                             HCRYPTKEY legacy_key, DWORD keyspec, DWORD flags)
+{
+    NCRYPT_PROV_HANDLE prov = 0;
+    HCRYPTKEY user_key = 0;
+    BOOL private = TRUE;
+    SECURITY_STATUS status;
+    BYTE *blob = NULL;
+    DWORD size = 0;
+
+    TRACE("(%p, %p, %#Ix, %#Ix, %lu, %#lx)\n", provider, key, legacy_prov, legacy_key, keyspec, flags);
+
+    if (!key) return NTE_INVALID_PARAMETER;
+    *key = 0;
+    if (flags) return NTE_BAD_FLAGS;
+    if (!legacy_key)
+    {
+        if (!legacy_prov) return NTE_INVALID_PARAMETER;
+        if (!CryptGetUserKey(legacy_prov, keyspec ? keyspec : AT_KEYEXCHANGE, &user_key)) return NTE_NO_KEY;
+        legacy_key = user_key;
+    }
+    if (!CryptExportKey(legacy_key, 0, PRIVATEKEYBLOB, 0, NULL, &size))
+    {
+        private = FALSE;
+        if (!CryptExportKey(legacy_key, 0, PUBLICKEYBLOB, 0, NULL, &size))
+        {
+            status = NTE_BAD_KEY;
+            goto done;
+        }
+    }
+    if (!(blob = malloc(size)))
+    {
+        status = NTE_NO_MEMORY;
+        goto done;
+    }
+    if (!CryptExportKey(legacy_key, 0, private ? PRIVATEKEYBLOB : PUBLICKEYBLOB, 0, blob, &size))
+    {
+        status = NTE_BAD_KEY;
+        goto done;
+    }
+    if ((status = NCryptOpenStorageProvider(&prov, MS_KEY_STORAGE_PROVIDER, 0))) goto done;
+    {
+        /* the CryptoAPI blob as a CNG RSA blob: bcrypt converts a private one; a public one
+         * (PUBLICKEYSTRUC, RSAPUBKEY, little-endian modulus) is rewritten here */
+        BYTE *cng = NULL;
+        DWORD cng_size = 0;
+
+        if (private)
+        {
+            BCRYPT_KEY_HANDLE bkey;
+            NTSTATUS nt;
+
+            /* bcrypt reads the blob as an exchange key's; a signature key's material is the same */
+            if (size >= sizeof(BLOBHEADER) && ((BLOBHEADER *)blob)->aiKeyAlg == CALG_RSA_SIGN)
+                ((BLOBHEADER *)blob)->aiKeyAlg = CALG_RSA_KEYX;
+            if ((nt = BCryptImportKeyPair(algorithms[RSA].handle, NULL, LEGACY_RSAPRIVATE_BLOB, &bkey, blob, size, 0)))
+            {
+                status = map_ntstatus(nt);
+                goto done;
+            }
+            if (!(nt = BCryptExportKey(bkey, NULL, BCRYPT_RSAFULLPRIVATE_BLOB, NULL, 0, &cng_size, 0)) &&
+                (cng = malloc(cng_size)))
+                nt = BCryptExportKey(bkey, NULL, BCRYPT_RSAFULLPRIVATE_BLOB, cng, cng_size, &cng_size, 0);
+            BCryptDestroyKey(bkey);
+            if (nt || !cng)
+            {
+                status = cng ? map_ntstatus(nt) : NTE_NO_MEMORY;
+                free(cng);
+                goto done;
+            }
+        }
+        else
+        {
+            const BLOBHEADER *hdr = (const BLOBHEADER *)blob;
+            const RSAPUBKEY *rsa = (const RSAPUBKEY *)(hdr + 1);
+            const BYTE *modulus = (const BYTE *)(rsa + 1);
+            BCRYPT_RSAKEY_BLOB *out;
+            DWORD mod_len, exp = 0, j;
+            BYTE exp_be[4];
+            int exp_len = 0;
+
+            if (size < sizeof(*hdr) + sizeof(*rsa) || rsa->magic != 0x31415352 /* RSA1 */ ||
+                size < sizeof(*hdr) + sizeof(*rsa) + rsa->bitlen / 8)
+            {
+                status = NTE_BAD_KEY;
+                goto done;
+            }
+            mod_len = rsa->bitlen / 8;
+            exp = rsa->pubexp;
+            for (j = 0; j < 4; j++) if (exp >> (8 * (3 - j)) || exp_len) exp_be[exp_len++] = exp >> (8 * (3 - j));
+            cng_size = sizeof(*out) + exp_len + mod_len;
+            if (!(cng = malloc(cng_size)))
+            {
+                status = NTE_NO_MEMORY;
+                goto done;
+            }
+            out = (BCRYPT_RSAKEY_BLOB *)cng;
+            out->Magic = BCRYPT_RSAPUBLIC_MAGIC;
+            out->BitLength = rsa->bitlen;
+            out->cbPublicExp = exp_len;
+            out->cbModulus = mod_len;
+            out->cbPrime1 = out->cbPrime2 = 0;
+            memcpy(out + 1, exp_be, exp_len);
+            for (j = 0; j < mod_len; j++) cng[sizeof(*out) + exp_len + j] = modulus[mod_len - 1 - j];
+        }
+        status = NCryptImportKey(prov, 0, private ? BCRYPT_RSAFULLPRIVATE_BLOB : BCRYPT_RSAPUBLIC_BLOB, NULL, key,
+                                 cng, cng_size, 0);
+        SecureZeroMemory(cng, cng_size);
+        free(cng);
+        if (status) goto done;
+    }
+    if (provider)
+    {
+        *provider = prov;
+        prov = 0;
+    }
+
+done:
+    if (prov) NCryptFreeObject(prov);
+    if (blob)
+    {
+        SecureZeroMemory(blob, size);
+        free(blob);
+    }
+    if (user_key) CryptDestroyKey(user_key);
+    return status;
+}
+#else
+SECURITY_STATUS WINAPI NCryptTranslateHandle(NCRYPT_PROV_HANDLE *provider, NCRYPT_KEY_HANDLE *key, HCRYPTPROV legacy_prov,
+                                             HCRYPTKEY legacy_key, DWORD keyspec, DWORD flags)
+{
+    return NTE_NOT_SUPPORTED;
+}
+#endif
--- a/dlls/ncrypt/ncrypt.spec
+++ b/dlls/ncrypt/ncrypt.spec
@@ -97,7 +97,7 @@
 @ stdcall NCryptStreamOpenToUnprotect(ptr long ptr ptr)
 @ stdcall NCryptStreamOpenToUnprotectEx(ptr long ptr ptr)
 @ stdcall NCryptStreamUpdate(long ptr long long)
-@ stub NCryptTranslateHandle
+@ stdcall NCryptTranslateHandle(ptr ptr ptr ptr long long)
 @ stub NCryptUnprotectKey
 @ stdcall NCryptUnprotectSecret(ptr long ptr long ptr ptr ptr ptr)
 @ stub NCryptVerifyClaim
