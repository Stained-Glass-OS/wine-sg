+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * The mouse over a XAML host window: the element under the pointer is the topmost visible,
+ * hit-testable one whose rectangle holds it; the button it is in shows the pointer over it and its
+ * press, and is clicked when the button is released over it (ClickMode Release, the default).
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "winuser.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+struct input_state
+{
+    HWND hwnd;
+    struct uielem *hover;           /* the button the pointer is over (a reference on its object) */
+    struct uielem *pressed;         /* the button pressed */
+};
+
+static struct input_state input;
+
+static void hold( struct uielem **slot, struct uielem *elem )
+{
+    if (*slot == elem) return;
+    if (elem) IUnknown_AddRef( elem->d.obj.outer );
+    if (*slot) IUnknown_Release( (*slot)->d.obj.outer );
+    *slot = elem;
+}
+
+static BOOL hit_testable( struct uielem *elem )
+{
+    IInspectable *box = NULL;
+    boolean visible = TRUE;
+    struct xaml_property *prop = xaml_property_find( L"Windows.UI.Xaml.UIElement", L"IsHitTestVisible" );
+
+    if (prop && SUCCEEDED(dobj_get_value( &elem->d, prop, &box )))
+    {
+        visible = xunbox_boolean( box, TRUE );
+        if (box) IInspectable_Release( box );
+    }
+    return visible;
+}
+
+/* the topmost element at a point (x, y in the parent's coordinates) */
+static struct uielem *hit_test( struct uielem *elem, FLOAT x, FLOAT y )
+{
+    struct uielem *child, *hit;
+
+    if (elem->visibility == XCOLLAPSED || !elem->arrange_valid || !hit_testable( elem )) return NULL;
+    x -= elem->offset.x;
+    y -= elem->offset.y;
+    LIST_FOR_EACH_ENTRY_REV( child, &elem->children, struct uielem, entry )
+        if ((hit = hit_test( child, x, y ))) return hit;
+#ifdef SG_MUTANT_INPUT_NO_HIT
+    return NULL;
+#endif
+    if (x >= 0 && y >= 0 && x < elem->render.width && y < elem->render.height) return elem;
+    return NULL;
+}
+
+static struct uielem *button_at( IInspectable *content, LPARAM lparam )
+{
+    struct uielem *root = uielem_from_inspectable( content ), *elem;
+
+    if (!root) return NULL;
+    for (elem = hit_test( root, (SHORT)LOWORD( lparam ), (SHORT)HIWORD( lparam ) ); elem; elem = elem->parent)
+        if (xaml_is_button( elem )) return elem;
+    return NULL;
+}
+
+static void set_hover( struct uielem *button )
+{
+    if (input.hover == button) return;
+    if (input.hover) xaml_button_state( input.hover, FALSE, input.hover == input.pressed && button == input.pressed );
+    hold( &input.hover, button );
+    if (button) xaml_button_state( button, TRUE, button == input.pressed );
+}
+
+/* a host window's mouse message: TRUE when XAML handled it */
+BOOL xaml_input_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspectable *content )
+{
+    struct uielem *button;
+
+    switch (msg)
+    {
+    case WM_MOUSEMOVE:
+    {
+        TRACKMOUSEEVENT track = { sizeof(track), TME_LEAVE, hwnd };
+        if (input.hwnd != hwnd)
+        {
+            input.hwnd = hwnd;
+            TrackMouseEvent( &track );
+        }
+        set_hover( button_at( content, lparam ) );
+        return TRUE;
+    }
+    case WM_MOUSELEAVE:
+        if (input.hwnd == hwnd) input.hwnd = NULL;
+        if (!input.pressed) set_hover( NULL );
+        return TRUE;
+    case WM_LBUTTONDOWN:
+        button = button_at( content, lparam );
+        set_hover( button );
+        hold( &input.pressed, button );
+        if (button)
+        {
+            SetCapture( hwnd );
+            xaml_button_state( button, TRUE, TRUE );
+        }
+        return TRUE;
+    case WM_LBUTTONUP:
+        button = button_at( content, lparam );
+        if (input.pressed)
+        {
+            struct uielem *pressed = input.pressed;
+            input.pressed = NULL;
+            if (GetCapture() == hwnd) ReleaseCapture();
+            xaml_button_state( pressed, pressed == button, FALSE );
+            TRACE( "%p released over %p (pressed %p)\n", hwnd, button, pressed );
+            /* released over the button it was pressed on: a click */
+            if (pressed == button) xaml_button_click( pressed );
+            IUnknown_Release( pressed->d.obj.outer );
+        }
+        set_hover( button );
+        return TRUE;
+    case WM_CAPTURECHANGED:
+        if (input.pressed && (HWND)lparam != hwnd)
+        {
+            xaml_button_state( input.pressed, FALSE, FALSE );
+            hold( &input.pressed, NULL );
+        }
+        return FALSE;
+    }
+    return FALSE;
+}
