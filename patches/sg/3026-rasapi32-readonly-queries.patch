 DWORD WINAPI RasGetProjectionInfoA(HRASCONN hrasconn, RASPROJECTION rasprojection,
                                    LPVOID lpprojection, LPDWORD lpcb)
 {
-    FIXME("(%p,0x%08x,%p,%p), stub!\n", hrasconn, rasprojection, lpprojection, lpcb);
-    return 1;
+    return RasGetProjectionInfoW( hrasconn, rasprojection, lpprojection, lpcb );
 }
 
 DWORD WINAPI RasGetProjectionInfoW(HRASCONN hrasconn, RASPROJECTION rasprojection,
                                    LPVOID lpprojection, LPDWORD lpcb)
 {
-    FIXME("(%p,0x%08x,%p,%p), stub!\n", hrasconn, rasprojection, lpprojection, lpcb);
-    return 1;
+    struct sg_vpn *v;
+    int i;
+
+    TRACE("(%p,0x%08x,%p,%p)\n", hrasconn, rasprojection, lpprojection, lpcb);
+    if (!lpcb) return ERROR_INVALID_PARAMETER;
+    switch (rasprojection)
+    {
+    case RASP_Amb: case RASP_PppNbf: case RASP_PppIpx: case RASP_PppIp: case RASP_PppLcp: case RASP_Slip: break;
+    default: return ERROR_INVALID_PARAMETER;
+    }
+    i = sg_find_handle( hrasconn, &v );
+    if (i == -2) return ERROR_INVALID_HANDLE;
+    if (i < 0) { free( v ); return ERROR_INVALID_HANDLE; }
+    i = v[i].connected;
+    free( v );
+    if (!i) return ERROR_INVALID_HANDLE;
+    /* the protocols of a VPN link are negotiated by NetworkManager, not visible here */
+    return ERROR_PROJECTION_NOT_COMPLETE;
 }
 
