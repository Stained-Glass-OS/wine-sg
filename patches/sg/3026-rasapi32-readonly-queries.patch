-/**************************************************************************
- *                 RasEnumDevicesW		[RASAPI32.20]
- */
-DWORD WINAPI RasEnumDevicesW(LPRASDEVINFOW a, LPDWORD b, LPDWORD c)
+DWORD WINAPI RasEnumDevicesW(LPRASDEVINFOW info, LPDWORD size, LPDWORD count)
 {
-	FIXME("(%p,%p,%p),stub!\n",a,b,c);
-	return 0;
+    if (!size || !count) return ERROR_INVALID_PARAMETER;
+    TRACE("(%p,%p,%p)\n",info,size,count);
+
+    if (info && info->dwSize != sizeof(RASDEVINFOW)) return ERROR_INVALID_SIZE;
+
+    if (info && !*size)
+    {
+        *size = sizeof(RASDEVINFOW);
+        return ERROR_BUFFER_TOO_SMALL;
+    }
+
+    *count = 1;
+    if (!info || *size < sizeof(RASDEVINFOW))
+    {
+        *size = sizeof(RASDEVINFOW);
+        return ERROR_BUFFER_TOO_SMALL;
+    }
+    wcscpy( info->szDeviceType, L"modem" );
+    wcscpy( info->szDeviceName, L"WINE virtmodem" );
+    *size = sizeof(RASDEVINFOW);
+    return 0;
 }
 
