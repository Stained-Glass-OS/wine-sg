From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 13:09:40 -0700
Subject: [PATCH] rasapi32: read-only queries for autodial, devices, dial
 parameters and projections

RasGetAutodialParam returns the documented defaults, RasGetAutodialEnable and
RasGetAutodialAddress report nothing configured, RasEnumAutodialAddresses
reports an empty list, RasEnumDevicesW matches the A variant (and both refuse
a zero sized buffer without counting devices, which clears a todo_wine in the
conformance test), RasGetEntryDialParams answers for the VPN phone book entries
or ERROR_CANNOT_FIND_PHONEBOOK_ENTRY, and RasGetProjectionInfo validates the
handle and projection type. Nothing here changes configuration or the network.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/rasapi32/rasapi.c b/dlls/rasapi32/rasapi.c
index 8b61765..e7453ea 100644
--- a/dlls/rasapi32/rasapi.c
+++ b/dlls/rasapi32/rasapi.c
@@ -290,6 +290,42 @@ static const struct { DWORD code; const WCHAR *text; } sg_ras_errors[] =
     { ERROR_INVALID_PARAMETER, L"The parameter is incorrect." },
 };
 
+
+#define SG_RASADP_DisableConnectionQuery 0
+#define SG_RASADP_LoginSessionDisable    1
+#define SG_RASADP_SavedAddressesLimit    2
+#define SG_RASADP_FailedConnectionTimeout 3
+#define SG_RASADP_ConnectionQueryTimeout 4
+
+static DWORD sg_autodial_param( DWORD key, void *value, DWORD *size )
+{
+    static const DWORD defaults[] = { 0, 0, 100, 5, 15 };
+
+    if (key > SG_RASADP_ConnectionQueryTimeout) return ERROR_INVALID_PARAMETER;
+    if (!size) return ERROR_INVALID_PARAMETER;
+    if (!value || *size < sizeof(DWORD))
+    {
+        *size = sizeof(DWORD);
+        return ERROR_BUFFER_TOO_SMALL;
+    }
+    *(DWORD *)value = defaults[key];
+    *size = sizeof(DWORD);
+    return ERROR_SUCCESS;
+}
+
+/* The phone book entry named in the dial parameters, if any entry of that name exists. */
+static DWORD sg_dial_params_entry( const WCHAR *entry, BOOL *found )
+{
+    struct sg_vpn *v;
+    int i, n = sg_vpn_list( &v );
+
+    *found = FALSE;
+    if (n < 0) return ~0u;
+    for (i = 0; i < n; i++) if (!wcsicmp( v[i].name, entry )) *found = TRUE;
+    free( v );
+    return 0;
+}
+
 DWORD WINAPI RasConnectionNotificationA(HRASCONN hrasconn, HANDLE hEvent, DWORD dwFlags)
 {
     FIXME("(%p,%p,0x%08lx),stub!\n",hrasconn,hEvent,dwFlags);
@@ -497,27 +533,55 @@ DWORD WINAPI RasGetConnectStatusW(HRASCONN hrasconn, LPRASCONNSTATUSW lprasconns
     return 0;
 }
 
-/**************************************************************************
- *                 RasGetEntryDialParamsA			[RASAPI32.550]
- */
 DWORD WINAPI RasGetEntryDialParamsA(
 	LPCSTR lpszPhoneBook, LPRASDIALPARAMSA lpRasDialParams,
 	LPBOOL lpfPassword)
 {
-	FIXME("(%s,%p,%p),stub!\n",debugstr_a(lpszPhoneBook),
-            lpRasDialParams,lpfPassword);
-	return 0;
+    RASDIALPARAMSW w = { sizeof(w) };
+    DWORD ret;
+
+    TRACE("(%s,%p,%p)\n",debugstr_a(lpszPhoneBook), lpRasDialParams,lpfPassword);
+    if (!lpRasDialParams || !lpfPassword) return ERROR_INVALID_PARAMETER;
+    if (lpRasDialParams->dwSize < FIELD_OFFSET(RASDIALPARAMSA, szDomain)) return ERROR_INVALID_SIZE;
+    MultiByteToWideChar( CP_ACP, 0, lpRasDialParams->szEntryName, -1, w.szEntryName, ARRAY_SIZE(w.szEntryName) );
+    if ((ret = RasGetEntryDialParamsW( NULL, &w, lpfPassword ))) return ret;
+    lpRasDialParams->szPhoneNumber[0] = 0;
+    lpRasDialParams->szCallbackNumber[0] = 0;
+    lpRasDialParams->szUserName[0] = 0;
+    lpRasDialParams->szPassword[0] = 0;
+    if (lpRasDialParams->dwSize >= FIELD_OFFSET(RASDIALPARAMSA, szDomain[1])) lpRasDialParams->szDomain[0] = 0;
+    if (lpRasDialParams->dwSize >= sizeof(RASDIALPARAMSA))
+    {
+        lpRasDialParams->dwSubEntry = w.dwSubEntry;
+        lpRasDialParams->dwCallbackId = w.dwCallbackId;
+    }
+    return 0;
 }
 
-/**************************************************************************
- *                 RasGetEntryDialParamsW           [RASAPI32.551]
- */
 DWORD WINAPI RasGetEntryDialParamsW(
     LPCWSTR lpszPhoneBook, LPRASDIALPARAMSW lpRasDialParams,
     LPBOOL lpfPassword)
 {
-    FIXME("(%s,%p,%p),stub!\n",debugstr_w(lpszPhoneBook),
-            lpRasDialParams,lpfPassword);
+    BOOL found;
+    DWORD ret;
+
+    TRACE("(%s,%p,%p)\n",debugstr_w(lpszPhoneBook), lpRasDialParams,lpfPassword);
+    if (!lpRasDialParams || !lpfPassword) return ERROR_INVALID_PARAMETER;
+    if (lpRasDialParams->dwSize < FIELD_OFFSET(RASDIALPARAMSW, szDomain)) return ERROR_INVALID_SIZE;
+    ret = sg_dial_params_entry( lpRasDialParams->szEntryName, &found );
+    /* an entry is a stored VPN connection; credentials are not kept in the phone book */
+    if (ret == ~0u || !found) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    lpRasDialParams->szPhoneNumber[0] = 0;
+    lpRasDialParams->szCallbackNumber[0] = 0;
+    lpRasDialParams->szUserName[0] = 0;
+    lpRasDialParams->szPassword[0] = 0;
+    if (lpRasDialParams->dwSize >= FIELD_OFFSET(RASDIALPARAMSW, szDomain[1])) lpRasDialParams->szDomain[0] = 0;
+    if (lpRasDialParams->dwSize >= sizeof(RASDIALPARAMSW))
+    {
+        lpRasDialParams->dwSubEntry = 0;
+        lpRasDialParams->dwCallbackId = 0;
+    }
+    *lpfPassword = FALSE;
     return 0;
 }
 
