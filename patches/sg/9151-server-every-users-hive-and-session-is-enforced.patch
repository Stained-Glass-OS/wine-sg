From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: every user's hive and session is enforced, however many users (9151)

The descriptors that keep a user's HKCU theirs (5950, 9150) were made once
per hive and kept in a table of 32: from the 33rd user on (counting every
SID whose hive a key was checked in) a hive had none, and its keys were
open to every account again -- another standard user could write that
person's HKCU\Software, their Run key. Users' sessions were kept in a
table of 200, and every user after the 200th was given SYSTEM's session
(its window station and Local\ objects, and each other's). Windows always
enforces a hive's own descriptor and gives every logon a session.

- The hive descriptors are a list without a limit (most recently used
  first). When one cannot be made (no memory, or the key's name cannot be
  had), the key is checked against SYSTEM and Administrators only, never
  "no descriptor"; it is not given that stand-in when a caller sets part
  of its descriptor.
- HKEY_USERS itself and a hive not named by a SID (.Default, which is
  userdef.reg, the template of every new profile) had no descriptor: any
  account could create a key in HKEY_USERS -- a hive for a user who has
  not logged on yet, which the server then takes as theirs -- and write
  .Default. They have the machine keys' (SYSTEM and Administrators full,
  the users' read), as HKEY_USERS and HKEY_USERS\.DEFAULT on Windows.
- The session map has no limit; without memory a user gets a session of
  their own that no one else is given, never SYSTEM's.

Gate test-manyusers; mutants SG_MUTANT_HIVE_SD_TABLE_32,
SG_MUTANT_HKU_NOT_A_SID_OPEN, SG_MUTANT_SESSION_MAP_200.
---
--- a/server/registry.c
+++ b/server/registry.c
@@ -507,13 +507,69 @@
 static const struct sid sg_app_packages_sid = { SID_REVISION, 2, SECURITY_APP_PACKAGE_AUTHORITY,
                                                 { SECURITY_APP_PACKAGE_BASE_RID, SECURITY_BUILTIN_PACKAGE_ANY_PACKAGE } };
 
+/* Stained Glass OS 9151: the descriptor a key of \\Registry\\User is checked against when the
+ * hive's own cannot be known -- the server is out of memory. SYSTEM and Administrators only: a
+ * request of anyone else's fails while memory is short, it is never let through (9151). */
+static const struct security_descriptor *sg_hive_unknown_sd(void)
+{
+    static union
+    {
+        struct security_descriptor sd;
+        unsigned int align;
+        char buf[sizeof(struct security_descriptor) + 2 * sizeof(struct sid) + sizeof(struct acl) +
+                 2 * (sizeof(struct ace) + sizeof(struct sid))];
+    } u;
+    struct security_descriptor *sd = &u.sd;
+    data_size_t dacl_len;
+    struct acl *dacl;
+    struct ace *ace;
+
+    if (sd->dacl_len) return sd;
+    dacl_len = sizeof(*dacl) + 2 * sizeof(*ace) + sid_len( &local_system_sid ) + sid_len( &builtin_admins_sid );
+    sd->control   = SE_DACL_PRESENT;
+    sd->owner_len = sid_len( &local_system_sid );
+    sd->group_len = sid_len( &local_system_sid );
+    sd->sacl_len  = 0;
+    copy_sid( copy_sid( (struct sid *)(sd + 1), &local_system_sid ), &local_system_sid );
+    dacl = (struct acl *)((char *)(sd + 1) + 2 * sid_len( &local_system_sid ));
+    dacl->revision = ACL_REVISION;
+    dacl->pad1     = 0;
+    dacl->size     = dacl_len;
+    dacl->count    = 2;
+    dacl->pad2     = 0;
+    ace = set_ace( ace_first( dacl ), &local_system_sid, ACCESS_ALLOWED_ACE_TYPE, CONTAINER_INHERIT_ACE, KEY_ALL_ACCESS );
+    set_ace( ace_next( ace ), &builtin_admins_sid, ACCESS_ALLOWED_ACE_TYPE, CONTAINER_INHERIT_ACE, KEY_ALL_ACCESS );
+    sd->dacl_len  = dacl_len;
+    return sd;
+}
+
+/* Stained Glass OS 9151: the users' descriptors made so far, one per hive, for the server's life
+ * (each is a few dozen bytes). They were kept in a table of 32, and a 33rd user's hive had none:
+ * its keys were open to every account again (another user wrote that person's HKCU). There is no
+ * limit now; most recently used first. */
+struct sg_hive_sd
+{
+    struct list entry;
+    struct sid  sid;
+    struct security_descriptor *sd;
+};
+static struct list sg_hive_sds = LIST_INIT( sg_hive_sds );
+#ifdef SG_MUTANT_HIVE_SD_TABLE_32
+static unsigned int sg_hive_sd_count;
+#endif
+
+/* Returns NULL for a key outside \\Registry\\User. A key of a hive named by a SID: that user's
+ * descriptor. \\Registry\\User itself and a hive named otherwise (.Default, which seeds no one but is
+ * userdef.reg, the template of every new profile): the machine keys' -- SYSTEM and Administrators
+ * full, the users' read, as HKEY_USERS and HKEY_USERS\\.DEFAULT on Windows; a key of either was
+ * open to every account (9151). When the name or the descriptor cannot be had (no memory):
+ * sg_hive_unknown_sd, never "no descriptor". */
 static const struct security_descriptor *sg_user_key_default_sd( struct object *obj )
 {
     static const WCHAR userW[] = {'\\','R','e','g','i','s','t','r','y','\\','U','s','e','r','\\'};
-    static struct { struct sid sid; struct security_descriptor *sd; } cache[32];
-    static unsigned int cached;
     struct sid user = { SID_REVISION };
     struct security_descriptor *sd;
+    struct sg_hive_sd *cached;
     const struct sid *sids[3];
     data_size_t len = 0, dacl_len, i;
     unsigned long long auth;
@@ -524,30 +580,57 @@
 #ifdef SG_MUTANT_USERKEY_GENERIC_SD
     return NULL;
 #endif
-    if (!(name = obj->ops->get_full_name( obj, &len ))) { clear_error(); return NULL; }
+    if (!(name = obj->ops->get_full_name( obj, &len ))) { clear_error(); return sg_hive_unknown_sd(); }
     len /= sizeof(WCHAR);
-    if (len <= ARRAY_SIZE(userW) + 4 || memicmp_strW( name, userW, sizeof(userW) )) { free( name ); return NULL; }
+    /* \\Registry\\User itself */
+    if (len == ARRAY_SIZE(userW) - 1 && !memicmp_strW( name, userW, len * sizeof(WCHAR) ))
+    {
+        free( name );
+#ifdef SG_MUTANT_HKU_NOT_A_SID_OPEN
+        return NULL;
+#endif
+        return sg_machine_key_sd() ? sg_machine_key_sd() : sg_hive_unknown_sd();
+    }
+    if (len <= ARRAY_SIZE(userW) || memicmp_strW( name, userW, sizeof(userW) )) { free( name ); return NULL; }
     p = name + ARRAY_SIZE(userW);
     end = name + len;
     /* "S-1-<authority>-<sub>..." up to the end, a backslash or "_Classes" */
-    if (end - p < 4 || (p[0] != 'S' && p[0] != 's') || p[1] != '-' || p[2] != '1' || p[3] != '-') { free( name ); return NULL; }
-    p += 4;
-    for (auth = 0; p < end && *p >= '0' && *p <= '9'; p++) auth = auth * 10 + (*p - '0');
-    for (i = 0; i < 6; i++) user.id_auth[5 - i] = (auth >> (8 * i)) & 0xff;
-    while (p < end && *p == '-' && user.sub_count < ARRAY_SIZE(user.sub_auth))
-    {
-        unsigned long long v = 0;
-        WCHAR *start = ++p;
-        for (; p < end && *p >= '0' && *p <= '9'; p++) v = v * 10 + (*p - '0');
-        if (p == start || v > 0xffffffffu) { free( name ); return NULL; }
-        user.sub_auth[user.sub_count++] = v;
+    i = end - p < 4 || (p[0] != 'S' && p[0] != 's') || p[1] != '-' || p[2] != '1' || p[3] != '-';
+    if (!i)
+    {
+        p += 4;
+        for (auth = 0; p < end && *p >= '0' && *p <= '9' && auth <= 0xffffffffffffull; p++) auth = auth * 10 + (*p - '0');
+        for (i = 0; i < 6; i++) user.id_auth[5 - i] = (auth >> (8 * i)) & 0xff;
+        i = 0;
+        while (!i && p < end && *p == '-' && user.sub_count < ARRAY_SIZE(user.sub_auth))
+        {
+            unsigned long long v = 0;
+            WCHAR *start = ++p;
+            for (; p < end && *p >= '0' && *p <= '9' && v <= 0xffffffffu; p++) v = v * 10 + (*p - '0');
+            if (p == start || v > 0xffffffffu) i = 1;
+            else user.sub_auth[user.sub_count++] = v;
+        }
+        i = i || (p < end && *p != '\\' && *p != '_') || !user.sub_count;
     }
-    i = p < end && *p != '\\' && *p != '_';
     free( name );
-    if (i || !user.sub_count) return NULL;
+    if (i)  /* not a SID */
+    {
+#ifdef SG_MUTANT_HKU_NOT_A_SID_OPEN
+        return NULL;
+#endif
+        return sg_machine_key_sd() ? sg_machine_key_sd() : sg_hive_unknown_sd();
+    }
 
-    for (i = 0; i < cached; i++) if (equal_sid( &cache[i].sid, &user )) return cache[i].sd;
-    if (cached == ARRAY_SIZE(cache)) return NULL;
+    LIST_FOR_EACH_ENTRY( cached, &sg_hive_sds, struct sg_hive_sd, entry )
+    {
+        if (!equal_sid( &cached->sid, &user )) continue;
+        list_remove( &cached->entry );
+        list_add_head( &sg_hive_sds, &cached->entry );
+        return cached->sd;
+    }
+#ifdef SG_MUTANT_HIVE_SD_TABLE_32
+    if (sg_hive_sd_count == 32) return NULL;
+#endif
 
     sids[0] = &user; sids[1] = &local_system_sid; sids[2] = &builtin_admins_sid;
     dacl_len = sizeof(*dacl);
@@ -558,7 +641,13 @@
      * user's settings; it passes only if the user is granted as well, so no other account gains */
     dacl_len += 2 * sizeof(*ace) + sid_len( &sg_restricted_sid ) + sid_len( &sg_app_packages_sid );
 #endif
-    if (!(sd = mem_alloc( sizeof(*sd) + 2 * sid_len( &user ) + dacl_len ))) return NULL;
+    if (!(cached = mem_alloc( sizeof(*cached) ))) { clear_error(); return sg_hive_unknown_sd(); }
+    if (!(sd = mem_alloc( sizeof(*sd) + 2 * sid_len( &user ) + dacl_len )))
+    {
+        free( cached );
+        clear_error();
+        return sg_hive_unknown_sd();
+    }
     sd->control   = SE_DACL_PRESENT;
     sd->owner_len = sid_len( &user );
     sd->group_len = sid_len( &user );
@@ -579,8 +668,12 @@
     set_ace( ace, &sg_app_packages_sid, ACCESS_ALLOWED_ACE_TYPE, CONTAINER_INHERIT_ACE, KEY_READ );
     dacl->count = 5;
 #endif
-    cache[cached].sid = user;
-    cache[cached++].sd = sd;
+    cached->sid = user;
+    cached->sd = sd;
+    list_add_head( &sg_hive_sds, &cached->entry );
+#ifdef SG_MUTANT_HIVE_SD_TABLE_32
+    sg_hive_sd_count++;
+#endif
     return sd;
 }
 
@@ -926,7 +1019,14 @@
     {
         const struct security_descriptor *def = sg_key_default_sd( obj );
         if (!def) def = sg_user_key_default_sd( obj );
-        if (def) obj->sd = memdup( def, sizeof(*def) + def->owner_len + def->group_len + def->sacl_len + def->dacl_len );
+        /* 9151: never seed a key with the stand-in for a descriptor that could not be had */
+        if (def && def == sg_hive_unknown_sd())
+        {
+            set_error( (((struct key *)obj)->flags & KEY_DELETED) ? STATUS_KEY_DELETED : STATUS_NO_MEMORY );
+            return 0;
+        }
+        if (def && !(obj->sd = memdup( def, sizeof(*def) + def->owner_len + def->group_len + def->sacl_len + def->dacl_len )))
+            return 0;
     }
 #endif
     if (!default_set_sd( obj, sd, set_info )) return 0;
--- a/server/process.c
+++ b/server/process.c
@@ -983,8 +983,10 @@
  * Windows (1707: a user's window station is that user's alone); users get the
  * next ones, kept for the server's life. Global\ objects are shared, as on
  * Windows. */
-static struct { uid_t uid; unsigned int id; } session_map[200];
-static unsigned int session_count;
+/* Stained Glass OS 9151: the map has no limit. It held 200, and every user after the 200th was
+ * given SYSTEM's session -- its window station, its Local\ objects, and each other's. */
+static struct sg_session_map { uid_t uid; unsigned int id; } *session_map;
+static unsigned int session_count, session_size;
 
 unsigned int sg_session_for_uid( uid_t uid )
 {
@@ -996,7 +998,23 @@
 #endif
     if (!sg_system_prefix || !uid || uid == sg_system_prefix_uid) return default_session_id;
     for (i = 0; i < session_count; i++) if (session_map[i].uid == uid) return session_map[i].id;
-    if (session_count == ARRAY_SIZE(session_map)) return default_session_id;
+#ifdef SG_MUTANT_SESSION_MAP_200
+    if (session_count == 200) return default_session_id;
+#endif
+    if (session_count == session_size)
+    {
+        unsigned int size = session_size ? 2 * session_size : 64;
+        struct sg_session_map *map = realloc( session_map, size * sizeof(*map) );
+        if (!map)
+        {
+            /* no memory: a session of its own, which no one else is given -- never SYSTEM's */
+            id = next++;
+            sg_create_session( id );
+            return id;
+        }
+        session_map = map;
+        session_size = size;
+    }
     id = next++;
     session_map[session_count].uid = uid;
     session_map[session_count].id = id;
