+/* ---- uploads: the BITS upload protocol over HTTP ----
+ * A session is opened with a Create-Session packet, the file goes up in Fragment packets with
+ * a Content-Range header, and a Close-Session packet ends it; the server answers each one with
+ * an Ack packet (BITS-Packet-Type) that names the session and how much it has received. An
+ * upload-reply job takes the body of the Close-Session answer as the server's reply. */
+
+#define BITS_UPLOAD_PROTOCOL L"{7DF0354D-249B-430F-820D-3D2A9BEF4931}"
+#define UPLOAD_FRAGMENT_SIZE 262144
+#define MAX_REPLY_SIZE (64 * 1024 * 1024)
+
+struct bits_answer
+{
+    DWORD status;
+    WCHAR packet[32], protocol[64], session[64];
+    BOOL has_received;
+    ULONG64 received;
+    HRESULT bits_error;
+    BYTE *body;
+    DWORD body_len;
+};
+
+static BOOL answer_header(HINTERNET req, const WCHAR *name, WCHAR *buf, DWORD chars)
+{
+    DWORD size = chars * sizeof(WCHAR);
+    buf[0] = 0;
+    return WinHttpQueryHeaders(req, WINHTTP_QUERY_CUSTOM, name, buf, &size, WINHTTP_NO_HEADER_INDEX);
+}
+
+/* one packet: a POST whose BITS-Packet-Type header says what it is */
+static BOOL bits_packet(BackgroundCopyJobImpl *job, HINTERNET con, const WCHAR *path, DWORD flags,
+                        const WCHAR *type, const WCHAR *session, const WCHAR *extra,
+                        const BYTE *data, DWORD len, struct bits_answer *ans, BOOL keep_body)
+{
+    WCHAR *headers, num[64];
+    HINTERNET req;
+    DWORD size, got;
+    BOOL ret = FALSE;
+    size_t hlen;
+
+    memset(ans, 0, sizeof(*ans));
+    hlen = (job->http_options.headers ? wcslen(job->http_options.headers) : 0) + wcslen(type) + 128 +
+           (session ? wcslen(session) : 0) + (extra ? wcslen(extra) : 0);
+    if (!(headers = malloc(hlen * sizeof(WCHAR)))) return FALSE;
+    swprintf(headers, hlen, L"%sBITS-Packet-Type: %s\r\n", job->http_options.headers ? job->http_options.headers : L"", type);
+    if (session) swprintf(headers + wcslen(headers), hlen - wcslen(headers), L"BITS-Session-Id: %s\r\n", session);
+    if (extra) wcscat(headers, extra);
+    if (!wcscmp(type, L"Create-Session"))
+        swprintf(headers + wcslen(headers), hlen - wcslen(headers), L"BITS-Supported-Protocols: %s\r\n", BITS_UPLOAD_PROTOCOL);
+
+    if (!(req = WinHttpOpenRequest(con, L"POST", path, NULL, NULL, NULL, flags))) goto done;
+    if (!set_request_credentials(req, job) || !set_request_security(req, job)) goto done;
+    if (!WinHttpSendRequest(req, headers, ~0u, (void *)data, len, len, 0)) goto done;
+    if (!WinHttpReceiveResponse(req, NULL)) goto done;
+
+    size = sizeof(ans->status);
+    if (!WinHttpQueryHeaders(req, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, NULL, &ans->status, &size, NULL))
+        goto done;
+    answer_header(req, L"BITS-Packet-Type", ans->packet, ARRAY_SIZE(ans->packet));
+    answer_header(req, L"BITS-Protocol", ans->protocol, ARRAY_SIZE(ans->protocol));
+    answer_header(req, L"BITS-Session-Id", ans->session, ARRAY_SIZE(ans->session));
+    if (answer_header(req, L"BITS-Received-Content-Range", num, ARRAY_SIZE(num)))
+    {
+        ans->has_received = TRUE;
+        ans->received = _wcstoui64(num, NULL, 10);
+    }
+    if (answer_header(req, L"BITS-Error-Code", num, ARRAY_SIZE(num)))
+        ans->bits_error = (HRESULT)wcstoul(num, NULL, 16);
+
+    for (;;)
+    {
+        BYTE chunk[4096], *grown;
+        if (!WinHttpReadData(req, chunk, sizeof(chunk), &got)) goto done;
+        if (!got) break;
+        if (!keep_body) continue;
+        if (ans->body_len + got > MAX_REPLY_SIZE) goto done;
+        if (!(grown = realloc(ans->body, ans->body_len + got))) goto done;
+        ans->body = grown;
+        memcpy(ans->body + ans->body_len, chunk, got);
+        ans->body_len += got;
+    }
+    ret = TRUE;
+done:
+    if (!ret) job->error.code = HRESULT_FROM_WIN32(GetLastError());
+    if (req) WinHttpCloseHandle(req);
+    free(headers);
+    return ret;
+}
+
+static void upload_fail(BackgroundCopyFileImpl *file, BG_ERROR_CONTEXT context, HRESULT hr)
+{
+    BackgroundCopyJobImpl *job = file->owner;
+
+    EnterCriticalSection(&job->cs);
+    job->error.code = hr;
+    job->error.context = context;
+    if (job->error.file) IBackgroundCopyFile2_Release(job->error.file);
+    job->error.file = &file->IBackgroundCopyFile2_iface;
+    IBackgroundCopyFile2_AddRef(job->error.file);
+    LeaveCriticalSection(&job->cs);
+}
+
+/* a packet that is no Ack: the server's own error code if it sent one */
+static HRESULT answer_error(const struct bits_answer *ans, HRESULT unsupported)
+{
+    if (ans->status < 200 || ans->status >= 300) return hresult_from_http_response(ans->status);
+    if (ans->bits_error) return ans->bits_error;
+    return unsupported;
+}
+
+static BOOL is_ack(const struct bits_answer *ans)
+{
+    return !wcsicmp(ans->packet, L"Ack");
+}
+
+static BOOL upload_reply_store(BackgroundCopyJobImpl *job, struct bits_answer *ans)
+{
+    BOOL ret = TRUE;
+
+    EnterCriticalSection(&job->cs);
+    job->reply_total = ans->body_len;
+    if (job->reply_file)
+    {
+        HANDLE h = CreateFileW(job->reply_file, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        DWORD written;
+
+        if (h == INVALID_HANDLE_VALUE || !WriteFile(h, ans->body, ans->body_len, &written, NULL)) ret = FALSE;
+        if (h != INVALID_HANDLE_VALUE) CloseHandle(h);
+    }
+    else
+    {
+        free(job->reply_data);
+        job->reply_data = ans->body;
+        ans->body = NULL;
+    }
+    if (ret) job->reply_size = ans->body_len;
+    LeaveCriticalSection(&job->cs);
+    return ret;
+}
+
+static BOOL transfer_file_upload(BackgroundCopyFileImpl *file)
+{
+    BackgroundCopyJobImpl *job = file->owner;
+    URL_COMPONENTSW uc = { sizeof(uc) };
+    WCHAR host[MAX_PATH], path[2048], extra[1024], session[64] = L"", range[160];
+    HINTERNET ses = NULL, con = NULL;
+    struct bits_answer ans = { 0 };
+    HANDLE handle = INVALID_HANDLE_VALUE;
+    LARGE_INTEGER size, pos;
+    BYTE *buf = NULL;
+    BOOL ret = FALSE, closed = FALSE;
+    DWORD flags = 0;
+
+    uc.lpszHostName = host;
+    uc.dwHostNameLength = ARRAY_SIZE(host);
+    uc.lpszUrlPath = path;
+    uc.dwUrlPathLength = ARRAY_SIZE(path);
+    uc.lpszExtraInfo = extra;
+    uc.dwExtraInfoLength = ARRAY_SIZE(extra);
+    if (!WinHttpCrackUrl(file->info.RemoteName, 0, 0, &uc))
+    {
+        upload_fail(file, BG_ERROR_CONTEXT_REMOTE_FILE, BG_E_PROTOCOL_NOT_AVAILABLE);
+        goto done;
+    }
+    flags = uc.nScheme == INTERNET_SCHEME_HTTPS ? WINHTTP_FLAG_SECURE : 0;
+    if (uc.dwExtraInfoLength && wcslen(path) + uc.dwExtraInfoLength < ARRAY_SIZE(path)) wcscat(path, extra);
+
+    handle = CreateFileW(file->info.LocalName, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                         OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (handle == INVALID_HANDLE_VALUE || !GetFileSizeEx(handle, &size))
+    {
+        upload_fail(file, BG_ERROR_CONTEXT_LOCAL_FILE, HRESULT_FROM_WIN32(GetLastError()));
+        goto done;
+    }
+    EnterCriticalSection(&job->cs);
+    file->fileProgress.BytesTotal = size.QuadPart;
+    LeaveCriticalSection(&job->cs);
+    if (!(buf = malloc(UPLOAD_FRAGMENT_SIZE))) { upload_fail(file, BG_ERROR_CONTEXT_UNKNOWN, E_OUTOFMEMORY); goto done; }
+
+    transitionJobState(job, BG_JOB_STATE_QUEUED, BG_JOB_STATE_CONNECTING);
+    if (!(ses = open_session(job, 0)) || !(con = WinHttpConnect(ses, host, uc.nPort, 0)))
+    {
+        upload_fail(file, BG_ERROR_CONTEXT_REMOTE_FILE, HRESULT_FROM_WIN32(GetLastError()));
+        goto done;
+    }
+
+    if (!bits_packet(job, con, path, flags, L"Create-Session", NULL, NULL, NULL, 0, &ans, FALSE))
+    {
+        upload_fail(file, BG_ERROR_CONTEXT_REMOTE_FILE, job->error.code);
+        goto done;
+    }
+    if (!is_ack(&ans) || !ans.session[0] || (ans.protocol[0] && wcsicmp(ans.protocol, BITS_UPLOAD_PROTOCOL)))
+    {
+        upload_fail(file, BG_ERROR_CONTEXT_REMOTE_FILE, answer_error(&ans, BG_E_REMOTE_NOT_SUPPORTED));
+        goto done;
+    }
+    wcscpy(session, ans.session);
+
+    transitionJobState(job, BG_JOB_STATE_CONNECTING, BG_JOB_STATE_TRANSFERRING);
+    pos.QuadPart = 0;
+    while (pos.QuadPart < size.QuadPart)
+    {
+        DWORD n = 0, want = (DWORD)min(size.QuadPart - pos.QuadPart, UPLOAD_FRAGMENT_SIZE);
+
+        if (WaitForSingleObject(job->cancel, 0) == WAIT_OBJECT_0)
+        {
+            bits_packet(job, con, path, flags, L"Cancel-Session", session, NULL, NULL, 0, &ans, FALSE);
+            transitionJobState(job, BG_JOB_STATE_TRANSFERRING, BG_JOB_STATE_CANCELLED);
+            goto done;
+        }
+        if (!SetFilePointerEx(handle, pos, NULL, FILE_BEGIN) || !ReadFile(handle, buf, want, &n, NULL) || n != want)
+        {
+            upload_fail(file, BG_ERROR_CONTEXT_LOCAL_FILE, HRESULT_FROM_WIN32(GetLastError() ? GetLastError() : ERROR_HANDLE_EOF));
+            goto done;
+        }
+        swprintf(range, ARRAY_SIZE(range), L"Content-Range: bytes %I64d-%I64d/%I64d\r\n",
+                 pos.QuadPart, pos.QuadPart + n - 1, size.QuadPart);
+        if (!bits_packet(job, con, path, flags, L"Fragment", session, range, buf, n, &ans, FALSE))
+        {
+            upload_fail(file, BG_ERROR_CONTEXT_REMOTE_FILE, job->error.code);
+            goto done;
+        }
+        if (!is_ack(&ans))
+        {
+            upload_fail(file, BG_ERROR_CONTEXT_REMOTE_FILE, answer_error(&ans, BG_E_REMOTE_NOT_SUPPORTED));
+            goto done;
+        }
+        /* the server says how much it has: a short count means it lost data, so send from there */
+        if (ans.has_received && ans.received <= (ULONG64)pos.QuadPart + n) n = ans.received > (ULONG64)pos.QuadPart ? (DWORD)(ans.received - pos.QuadPart) : 0;
+        pos.QuadPart += n;
+        EnterCriticalSection(&job->cs);
+        file->fileProgress.BytesTransferred = pos.QuadPart;
+        job->jobProgress.BytesTransferred += n;
+        job->last_progress = GetTickCount64();
+        LeaveCriticalSection(&job->cs);
+        if (!n && ans.has_received && ans.received < (ULONG64)pos.QuadPart + want)
+        {
+            /* the server made no progress at all */
+            upload_fail(file, BG_ERROR_CONTEXT_REMOTE_FILE, BG_E_REMOTE_NOT_SUPPORTED);
+            goto done;
+        }
+    }
+
+    if (!bits_packet(job, con, path, flags, L"Close-Session", session, NULL, NULL, 0, &ans,
+                     job->type == BG_JOB_TYPE_UPLOAD_REPLY))
+    {
+        upload_fail(file, BG_ERROR_CONTEXT_REMOTE_FILE, job->error.code);
+        goto done;
+    }
+    closed = TRUE;
+    if (!is_ack(&ans))
+    {
+        upload_fail(file, BG_ERROR_CONTEXT_REMOTE_FILE, answer_error(&ans, BG_E_REMOTE_NOT_SUPPORTED));
+        goto done;
+    }
+    if (job->type == BG_JOB_TYPE_UPLOAD_REPLY && !upload_reply_store(job, &ans))
+    {
+        upload_fail(file, BG_ERROR_CONTEXT_LOCAL_FILE, HRESULT_FROM_WIN32(GetLastError()));
+        goto done;
+    }
+    ret = TRUE;
+
+done:
+    if (!ret && session[0] && !closed && job->state != BG_JOB_STATE_CANCELLED)
+        bits_packet(job, con, path, flags, L"Cancel-Session", session, NULL, NULL, 0, &ans, FALSE);
+    free(ans.body);
+    free(buf);
+    if (handle != INVALID_HANDLE_VALUE) CloseHandle(handle);
+    if (con) WinHttpCloseHandle(con);
+    if (ses) WinHttpCloseHandle(ses);
+    if (!ret && job->state != BG_JOB_STATE_CANCELLED &&
+        !transitionJobState(job, BG_JOB_STATE_CONNECTING, BG_JOB_STATE_ERROR) &&
+        !transitionJobState(job, BG_JOB_STATE_TRANSFERRING, BG_JOB_STATE_ERROR))
+        transitionJobState(job, BG_JOB_STATE_QUEUED, BG_JOB_STATE_ERROR);
+    SetEvent(job->done);
+    return ret;
+}
+
+static BOOL process_upload(BackgroundCopyFileImpl *file, BackgroundCopyJobImpl *job)
+{
+    EnterCriticalSection(&job->cs);
+    file->fileProgress.BytesTotal = BG_SIZE_UNKNOWN;
+    file->fileProgress.BytesTransferred = 0;
+    file->fileProgress.Completed = FALSE;
+    LeaveCriticalSection(&job->cs);
+
+    TRACE("Uploading: %s -> %s\n", debugstr_w(file->info.LocalName), debugstr_w(file->info.RemoteName));
+
+    if (transfer_file_upload(file) &&
+        (transitionJobState(job, BG_JOB_STATE_CONNECTING, BG_JOB_STATE_QUEUED) ||
+         transitionJobState(job, BG_JOB_STATE_TRANSFERRING, BG_JOB_STATE_QUEUED)))
+    {
+        EnterCriticalSection(&job->cs);
+        file->fileProgress.Completed = TRUE;
+        job->jobProgress.FilesTransferred++;
+        LeaveCriticalSection(&job->cs);
+        return TRUE;
+    }
+    if (job->state == BG_JOB_STATE_ERROR || job->state == BG_JOB_STATE_TRANSIENT_ERROR)
+        job_failed(job);
+    return FALSE;
+}
