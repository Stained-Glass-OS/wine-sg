From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comctl32, shell32: icon overlays drawn over alpha images and in the view

An item's overlay reached the list view but was never drawn. ImageList_DrawIndirect drew images with an alpha channel (every image in the shell's 32-bit lists) on a path that returned before the overlay, so Explorer showed no overlays. The overlay is now blended over the image there too. And when the view changed to large icons after the overlays were known, its own image list never got the overlay pictures; it gets them whenever an item's overlay is asked for.
---
diff --git a/dlls/comctl32/imagelist.c b/dlls/comctl32/imagelist.c
index 3d565c6..532c640 100644
--- a/dlls/comctl32/imagelist.c
+++ b/dlls/comctl32/imagelist.c
@@ -1448,6 +1448,28 @@ static BOOL draw_scaled( HIMAGELIST himl, const IMAGELISTDRAWPARAMS *params, int
     return TRUE;
 }
 
+/* Stained Glass OS 6254: the overlay (ILD_OVERLAYMASK) over an image drawn with its alpha.
+ * The alpha path returned before the overlay was drawn, so no 32-bit list (the shell's)
+ * ever showed one: Explorer drew no icon overlays (OneDrive's, qa4 640). */
+static void alpha_blend_overlay( HIMAGELIST himl, const IMAGELISTDRAWPARAMS *params, HDC dst, int x, int y,
+                                 int cx, int cy, UINT style, UINT state )
+{
+    int ovl = (params->fStyle & ILD_OVERLAYMASK) >> 8;  /* the caller's style has it masked out */
+    POINT pt;
+
+#ifdef SG_MUTANT_NO_ALPHA_OVERLAY
+    return;
+#endif
+    if (ovl < 1 || ovl > MAX_OVERLAYIMAGE) return;
+    ovl = himl->nOvlIdx[ovl - 1];
+    if (ovl < 0 || ovl >= himl->cCurImage) return;
+    imagelist_point_from_index( himl, ovl, &pt );
+    pt.x += params->xBitmap;
+    pt.y += params->yBitmap;
+    alpha_blend_image( himl, dst, x, y, pt.x, pt.y, cx, cy, style & ~(ILD_OVERLAYMASK | ILD_BLEND25 | ILD_BLEND50),
+                       state & ~ILS_SATURATE, params->Frame, CLR_NONE, himl->item_flags[ovl] & ILIF_ALPHA );
+}
+
 /*************************************************************************
  * ImageList_DrawIndirect [COMCTL32.@]
  *
@@ -1563,6 +1585,7 @@ ImageList_DrawIndirect (IMAGELISTDRAWPARAMS *pimldp)
         {
             bResult = alpha_blend_image( himl, pimldp->hdcDst, pimldp->x, pimldp->y, pt.x, pt.y, cx, cy,
                                          fStyle, fState, pimldp->Frame, blend_col, has_alpha );
+            alpha_blend_overlay( himl, pimldp, pimldp->hdcDst, pimldp->x, pimldp->y, cx, cy, fStyle, fState );
             goto end;
         }
         colour = pimldp->rgbBk;
@@ -1573,6 +1596,7 @@ ImageList_DrawIndirect (IMAGELISTDRAWPARAMS *pimldp)
         PatBlt( hImageDC, 0, 0, cx, cy, PATCOPY );
         alpha_blend_image( himl, hImageDC, 0, 0, pt.x, pt.y, cx, cy, fStyle, fState,
                            pimldp->Frame, blend_col, has_alpha );
+        alpha_blend_overlay( himl, pimldp, hImageDC, 0, 0, cx, cy, fStyle, fState );
         DeleteObject (SelectObject (hImageDC, hOldBrush));
         bResult = BitBlt( pimldp->hdcDst, pimldp->x,  pimldp->y, cx, cy, hImageDC, 0, 0, SRCCOPY );
         goto end;
@@ -3097,6 +3121,7 @@ ImageList_SetOverlayImage (HIMAGELIST himl, INT iImage, INT iOverlay)
 	return FALSE;
     if ((iImage!=-1) && ((iImage < 0) || (iImage > himl->cCurImage)))
 	return FALSE;
+    TRACE("%p: overlay %d is image %d\n", himl, iOverlay, iImage);
     himl->nOvlIdx[iOverlay - 1] = iImage;
     return TRUE;
 }
diff --git a/dlls/shell32/shlview.c b/dlls/shell32/shlview.c
index d214392..33d65f2 100644
--- a/dlls/shell32/shlview.c
+++ b/dlls/shell32/shlview.c
@@ -899,6 +899,7 @@ static void ShellView_OwnOverlay(IShellViewImpl *This, int overlay)
     {
         int own = ShellView_OwnIcon(This, SHELL32_OverlayImage(overlay));
         if (own >= 0) ImageList_SetOverlayImage(This->own_icons, own, overlay);
+        TRACE("overlay %d is image %d of the view's own list %p\n", overlay, own, This->own_icons);
         This->own_overlay_set[overlay] = TRUE;
     }
 }
@@ -925,7 +926,13 @@ static int ShellView_Overlay(IShellViewImpl *This, LPCITEMIDLIST pidl)
     size = ILGetSize(pidl);
     for (i = 0; i < This->n_overlays; i++)
         if (ILGetSize(This->overlays[i].child) == size && !memcmp(This->overlays[i].child, pidl, size))
+        {
+            /* 6254: the view's own list may be new (large icons after details): it needs the picture too */
+#ifndef SG_MUTANT_OWN_OVERLAY_ONCE
+            ShellView_OwnOverlay(This, This->overlays[i].overlay);
+#endif
             return This->overlays[i].overlay;
+        }
 
 #ifndef SG_MUTANT_VIEW_OVERLAY_SYNC
     overlay = OI_ASYNC;
@@ -977,7 +984,9 @@ static void ShellView_OnOverlay(IShellViewImpl *This, struct overlay_answer *ans
                 This->overlays[i].pending = FALSE;
                 This->overlays[i].overlay = overlay;
                 ShellView_OwnOverlay(This, overlay);
-                if (overlay && (item = LV_FindItemByPidl(This, answer->child)) >= 0)
+                item = LV_FindItemByPidl(This, answer->child);
+                TRACE("item %d: overlay %d (state %#x)\n", item, overlay, INDEXTOOVERLAYMASK(overlay));
+                if (overlay && item >= 0)
                     SendMessageW(This->hWndList, LVM_REDRAWITEMS, item, item);
                 break;
             }
