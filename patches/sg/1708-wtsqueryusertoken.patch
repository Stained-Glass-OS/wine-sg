From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, wtsapi32: WTSQueryUserToken gives the session's user's token

WTSQueryUserToken handed every caller a copy of its own token, whatever
session it named. A service uses it to start a program on the desktop of
the user logged on to a session (CreateProcessAsUser); it got SYSTEM's own
token, and anybody could call it.

As on Windows, now:

- Only a caller holding SeTcbPrivilege gets a token: LocalSystem services,
  which in a shared prefix are SYSTEM's processes (root or the prefix's
  owner). Anyone else gets ERROR_PRIVILEGE_NOT_HELD, even for their own
  session.
- The token is a new primary token for the user logged on to that session
  (1706), in that session. WTS_CURRENT_SESSION is the caller's session.
- SYSTEM's own session has no user: ERROR_NO_TOKEN. A session that does
  not exist: ERROR_CTX_WINSTATION_NOT_FOUND.
- In a single-user prefix there is one session; it gives the caller's own
  token, as before, for a caller holding the privilege.

This adds a server request, get_session_user_token.

Gate: test/wtstoken-gate.sh (sgsystem, sgtest1, sgtest2 against one
machine wineserver). Mutant SG_MUTANT_SESSION_TOKEN_FOR_ALL.
---
--- a/dlls/wtsapi32/Makefile.in
+++ b/dlls/wtsapi32/Makefile.in
@@ -1,7 +1,7 @@
 MODULE    = wtsapi32.dll
 UNIXLIB   = wtsapi32.so
 IMPORTLIB = wtsapi32
-IMPORTS   = advapi32 user32
+IMPORTS   = advapi32 user32 ntdll
 
 SOURCES = \
 	unixlib.c \
--- a/dlls/wtsapi32/wtsapi32.c
+++ b/dlls/wtsapi32/wtsapi32.c
@@ -28,6 +28,7 @@
 #include "wtsapi32.h"
 #include "reason.h"
 #include "wine/debug.h"
+#include "wine/server.h"
 #include "wine/list.h"
 #include "unixlib.h"
 
@@ -1626,7 +1627,10 @@ BOOL WINAPI WTSQuerySessionInformationW(HANDLE server, DWORD session_id, WTS_INF
  */
 BOOL WINAPI WTSQueryUserToken(ULONG session_id, PHANDLE token)
 {
-    FIXME("%lu %p semi-stub!\n", session_id, token);
+    NTSTATUS status;
+    HANDLE ret = 0;
+
+    TRACE("%lu %p\n", session_id, token);
 
     if (!token)
     {
@@ -1634,9 +1638,22 @@ BOOL WINAPI WTSQueryUserToken(ULONG session_id, PHANDLE token)
         return FALSE;
     }
 
-    return DuplicateHandle(GetCurrentProcess(), GetCurrentProcessToken(),
-                           GetCurrentProcess(), token,
-                           0, FALSE, DUPLICATE_SAME_ACCESS);
+    /* Stained Glass OS (1708): the session's user's token, for a caller
+     * holding SeTcbPrivilege (LocalSystem services), from the server, which
+     * knows who is logged on to which session (1706) */
+    SERVER_START_REQ( get_session_user_token )
+    {
+        req->session_id = session_id;
+        if (!(status = wine_server_call( req ))) ret = wine_server_ptr_handle( reply->token );
+    }
+    SERVER_END_REQ;
+    if (status)
+    {
+        SetLastError( RtlNtStatusToDosError( status ) );
+        return FALSE;
+    }
+    *token = ret;
+    return TRUE;
 }
 
