--- a/server/token.c
+++ b/server/token.c
@@ -2945,3 +2945,47 @@ DECL_HANDLER(get_token_appcontainer)
     }
     release_object( token );
 }
+
+/* Stained Glass OS (1708): WTSQueryUserToken. As on Windows only a caller
+ * holding SeTcbPrivilege -- in a shared prefix, SYSTEM's processes (root or
+ * the prefix's owner), as LocalSystem services on Windows -- gets the primary
+ * token of the user logged on to a session: a new token for that user in that
+ * session, as a service gets one to start a program on the user's desktop
+ * (CreateProcessAsUser). SYSTEM's own session has no user (STATUS_NO_TOKEN); a
+ * session that does not exist is STATUS_CTX_WINSTATION_NOT_FOUND. */
+DECL_HANDLER(get_session_user_token)
+{
+    struct token *caller = current->token ? current->token : current->process->token;
+    unsigned int id = req->session_id;
+    struct token *token;
+    uid_t uid;
+
+    reply->token = 0;
+#ifndef SG_MUTANT_SESSION_TOKEN_FOR_ALL
+    if (!caller || !token_find_privilege( caller, SeTcbPrivilege, FALSE ) ||
+        (sg_system_prefix && !sg_requester_is_admin()))
+    {
+        set_error( STATUS_PRIVILEGE_NOT_HELD );
+        return;
+    }
+#endif
+    if (id == 0xffffffff) id = current->process->session_id;
+    if (!sg_system_prefix)
+    {
+        /* one user, logged on to the default session */
+        if (id != default_session_id) { set_error( STATUS_CTX_WINSTATION_NOT_FOUND ); return; }
+        if ((token = token_duplicate( current->process->token, TRUE, SecurityAnonymous, NULL, NULL, 0, NULL, 0 )))
+        {
+            reply->token = alloc_handle( current->process, token, TOKEN_ALL_ACCESS, 0 );
+            release_object( token );
+        }
+        return;
+    }
+    if (id == default_session_id) { set_error( STATUS_NO_TOKEN ); return; }
+    if (!sg_session_user( id, &uid )) { set_error( STATUS_CTX_WINSTATION_NOT_FOUND ); return; }
+    if ((token = token_create_for_uid( TRUE, -1, TokenElevationTypeDefault, id, uid )))
+    {
+        reply->token = alloc_handle( current->process, token, TOKEN_ALL_ACCESS, 0 );
+        release_object( token );
+    }
+}
