         ICompositionSurface **result )
 {
-    FIXME( "iface %p, swapchain %p, result %p stub!\n", iface, swapchain, result );
-    return E_NOTIMPL;
+    struct swapchain_surface *surface;
+    IUnknown *content;
+    HRESULT hr;
+
+    TRACE( "iface %p, swapchain %p, result %p.\n", iface, swapchain, result );
+
+    if (!result) return E_INVALIDARG;
+    if (FAILED(hr = dc_create_surface_from_handle( NULL, swapchain, (void **)&content ))) return hr;
+    /* the handle's content comes from whoever draws to it; nothing to show until then */
+    if (!(surface = calloc( 1, sizeof(*surface) )))
+    {
+        IUnknown_Release( content );
+        return E_OUTOFMEMORY;
+    }
+    surface->ICompositionSurface_iface.lpVtbl = &swapchain_surface_vtbl;
+    surface->ref = 1;
+    surface->swapchain = content;
+    *result = &surface->ICompositionSurface_iface;
+    return S_OK;
 }
 
