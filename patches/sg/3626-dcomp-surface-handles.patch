+/* ---- surface handles and window surfaces ---------------------------------- */
+
+/* A surface handle is a small shared memory section: it can be duplicated into
+ * another process (a video decoder, a GPU process) which hands it back through
+ * CreateSurfaceFromHandle; the section tells how big the surface is. */
+#define DC_SURFACE_HANDLE_MAGIC 0x53474453 /* "SGDS" */
+
+struct dc_surface_handle_data
+{
+    DWORD magic;
+    DWORD version;
+    UINT width, height;
+};
+
+HRESULT WINAPI DCompositionCreateSurfaceHandle(DWORD access, SECURITY_ATTRIBUTES *sa, HANDLE *handle)
+{
+    struct dc_surface_handle_data *data;
+    HANDLE section;
+
+    TRACE("access %#lx, sa %p, handle %p.\n", access, sa, handle);
+
+    if (!handle)
+        return E_INVALIDARG;
+    *handle = NULL;
+    if (!(section = CreateFileMappingW(INVALID_HANDLE_VALUE, sa, PAGE_READWRITE, 0, 4096, NULL)))
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (!(data = MapViewOfFile(section, FILE_MAP_WRITE, 0, 0, sizeof(*data))))
+    {
+        DWORD err = GetLastError();
+        CloseHandle(section);
+        return HRESULT_FROM_WIN32(err);
+    }
+    data->magic = DC_SURFACE_HANDLE_MAGIC;
+    data->version = 1;
+    UnmapViewOfFile(data);
+    *handle = section;
+    return S_OK;
+}
+
+HRESULT dc_create_surface_from_handle(IDXGIDevice *dxgi_device, HANDLE handle, void **out)
+{
+    const struct dc_surface_handle_data *data;
+    UINT width, height;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+    if (!handle || handle == INVALID_HANDLE_VALUE)
+        return E_INVALIDARG;
+    if (!(data = MapViewOfFile(handle, FILE_MAP_READ, 0, 0, sizeof(*data))))
+        return E_INVALIDARG;
+#ifdef SG_MUTANT_DC_MAGIC
+    if (0)
+#else
+    if (data->magic != DC_SURFACE_HANDLE_MAGIC)
+#endif
+    {
+        UnmapViewOfFile(data);
+        return E_INVALIDARG;
+    }
+    width = data->width ? data->width : 1;
+    height = data->height ? data->height : 1;
+    UnmapViewOfFile(data);
+    return dc_create_surface(dxgi_device, width, height, DXGI_FORMAT_B8G8R8A8_UNORM,
+            DXGI_ALPHA_MODE_PREMULTIPLIED, FALSE, out);
+}
+
+/* A surface showing a window: sized to its client area, holding what the window looks like. */
+HRESULT dc_create_surface_from_hwnd(IDXGIDevice *dxgi_device, HWND window, void **out)
+{
+    IDCompositionSurface *surface;
+    IDXGISurface1 *dxgi;
+    RECT rect;
+    POINT offset;
+    HRESULT hr;
+    HDC hdc;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+#ifdef SG_MUTANT_DC_HWND
+    return E_NOTIMPL;
+#endif
+    if (!IsWindow(window) || !GetClientRect(window, &rect))
+        return E_INVALIDARG;
+    if (FAILED(hr = dc_create_surface(dxgi_device, max(rect.right, 1), max(rect.bottom, 1),
+            DXGI_FORMAT_B8G8R8A8_UNORM, DXGI_ALPHA_MODE_PREMULTIPLIED, FALSE, (void **)&surface)))
+        return hr;
+
+    if (rect.right > 0 && rect.bottom > 0 && SUCCEEDED(IDCompositionSurface_BeginDraw(surface, NULL,
+            &IID_IDXGISurface1, (void **)&dxgi, &offset)))
+    {
+        if (SUCCEEDED(IDXGISurface1_GetDC(dxgi, FALSE, &hdc)))
+        {
+            HDC src = GetDC(window);
+
+            if (src)
+            {
+                BitBlt(hdc, offset.x, offset.y, rect.right, rect.bottom, src, 0, 0, SRCCOPY);
+                ReleaseDC(window, src);
+            }
+            IDXGISurface1_ReleaseDC(dxgi, NULL);
+        }
+        IDXGISurface1_Release(dxgi);
+        IDCompositionSurface_EndDraw(surface);
+    }
+    *out = surface;
+    return S_OK;
+}
