From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: a framed window names its client area for the desktop's compositor

The Glass look's window frames are glass, as the Glass taskbar is (David
2026-10-02: "The glass theme does not have the window decorations made of
glass like the bottom bar is"). A window with a title bar names where its
client area is inside it, _SG_FRAME (left, top, right, bottom, pixels),
updated as its frame changes; sg-deskcomp (sg-compositor) lays the frame
see-through over a blur of what is below it and the client area opaque,
when Settings says so (effects.conf glass=N: the Glass look with
Transparency effects on). Test: sg-compositor's test/glassframe-gate.sh
(mutant SG_MUTANT_NO_FRAME_PROP).
---
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3239,6 +3239,45 @@
 /***********************************************************************
  *		WindowPosChanged   (X11DRV.@)
  */
+/* Stained Glass OS: where the client area is in a window with a title bar,
+ * for the desktop's compositor (sg-deskcomp): the Glass look's frame is laid
+ * see-through over a blur of what is below, as that era's frames were, the
+ * client area opaque (David 2026-10-02: "the glass theme does not have the
+ * window decorations made of glass like the bottom bar is"). _SG_FRAME is
+ * left, top, right, bottom in pixels; none on a window without a frame. */
+static void sg_set_frame_prop( struct x11drv_win_data *data, UINT style )
+{
+    static Atom frame_atom;
+    DWORD ex_style = NtUserGetWindowLongW( data->hwnd, GWL_EXSTYLE );
+    int v[4];
+    BOOL want = (style & WS_CAPTION) == WS_CAPTION && !(ex_style & WS_EX_LAYERED) && !data->embedded;
+
+#ifdef SG_MUTANT_NO_FRAME_PROP
+    want = FALSE;
+#endif
+    if (!data->whole_window) return;
+    if (!frame_atom) frame_atom = XInternAtom( data->display, "_SG_FRAME", False );
+    if (!want)
+    {
+        if (data->sg_frame_set) XDeleteProperty( data->display, data->whole_window, frame_atom );
+        data->sg_frame_set = FALSE;
+        return;
+    }
+    v[0] = data->rects.client.left - data->rects.visible.left;
+    v[1] = data->rects.client.top - data->rects.visible.top;
+    v[2] = data->rects.visible.right - data->rects.client.right;
+    v[3] = data->rects.visible.bottom - data->rects.client.bottom;
+    if (v[0] < 0 || v[1] < 0 || v[2] < 0 || v[3] < 0) return;
+    if (data->sg_frame_set && !memcmp( v, data->sg_frame, sizeof(v) )) return;
+    {
+        long prop[4] = { v[0], v[1], v[2], v[3] };
+        XChangeProperty( data->display, data->whole_window, frame_atom, XA_CARDINAL, 32,
+                         PropModeReplace, (unsigned char *)prop, 4 );
+    }
+    memcpy( data->sg_frame, v, sizeof(v) );
+    data->sg_frame_set = TRUE;
+}
+
 void X11DRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UINT swp_flags, BOOL fullscreen,
                               const struct window_rects *new_rects, struct window_surface *surface )
 {
@@ -3275,6 +3314,7 @@
         release_win_data( data );
         return;
     }
+    sg_set_frame_prop( data, new_style );
 
     if (old_style & WS_VISIBLE)
     {
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -675,6 +675,8 @@
     unsigned long wm_state_serial;     /* serial of last pending WM_STATE request */
     unsigned long net_wm_state_serial; /* serial of last pending _NET_WM_STATE request */
     unsigned long configure_serial;    /* serial of last pending configure request */
+    int         sg_frame[4];    /* Stained Glass OS: the _SG_FRAME last set (left, top, right, bottom; -1: none) */
+    BOOL        sg_frame_set;   /* ...and whether one was */
 };
 
 extern struct x11drv_win_data *get_win_data( HWND hwnd );
