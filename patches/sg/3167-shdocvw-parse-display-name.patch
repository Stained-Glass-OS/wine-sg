From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 07:20:21 -0700
Subject: [PATCH] shdocvw: IEParseDisplayNameWithBCW parses a display name to
 an item ID list

The ordinal 218 export now calls SHParseDisplayName with the supplied bind context instead of returning E_FAIL.

diff --git a/dlls/shdocvw/Makefile.in b/dlls/shdocvw/Makefile.in
index d38782e..bea902a 100644
--- a/dlls/shdocvw/Makefile.in
+++ b/dlls/shdocvw/Makefile.in
@@ -1,7 +1,7 @@
 MODULE    = shdocvw.dll
 IMPORTLIB = shdocvw
 IMPORTS   = uuid shlwapi advapi32
-DELAYIMPORTS = version ole32 oleaut32 ieframe
+DELAYIMPORTS = version ole32 oleaut32 ieframe shell32
 
 SOURCES = \
 	shdocvw.rc \
diff --git a/dlls/shdocvw/shdocvw_main.c b/dlls/shdocvw/shdocvw_main.c
index 6556223..84e257d 100644
--- a/dlls/shdocvw/shdocvw_main.c
+++ b/dlls/shdocvw/shdocvw_main.c
@@ -29,6 +29,7 @@
 
 #include "winreg.h"
 #include "shlwapi.h"
+#include "shlobj.h"
 #include "wininet.h"
 #include "isguids.h"
 
@@ -433,9 +434,18 @@ DWORD WINAPI ParseURLFromOutsideSourceA(LPCSTR url, LPSTR out, LPDWORD plen, LPD
  */
 HRESULT WINAPI IEParseDisplayNameWithBCW(DWORD codepage, LPCWSTR lpszDisplayName, LPBC pbc, LPITEMIDLIST *ppidl)
 {
-    /* Guessing at parameter 3 based on IShellFolder's  ParseDisplayName */
-    FIXME("stub: 0x%lx %s %p %p\n",codepage,debugstr_w(lpszDisplayName),pbc,ppidl);
+    /* parameter 3 is the bind context of IShellFolder::ParseDisplayName; the string is already wide,
+     * so the code page does not matter */
+    TRACE("0x%lx %s %p %p\n", codepage, debugstr_w(lpszDisplayName), pbc, ppidl);
+
+#ifdef SG_MUTANT_SHDOCVWPARSE
     return E_FAIL;
+#endif
+    if (!ppidl) return E_INVALIDARG;
+    *ppidl = NULL;
+    if (!lpszDisplayName || !*lpszDisplayName) return E_INVALIDARG;
+
+    return SHParseDisplayName(lpszDisplayName, pbc, ppidl, 0, NULL);
 }
 
 /******************************************************************
