+HRESULT shape_create( struct compositor *compositor, const WCHAR *what, IInspectable *arg, IInspectable **out )
+{
+    static const struct { const WCHAR *name; enum shape_kind kind; } kinds[] =
+    {
+        { L"ContainerShape", SHAPE_CONTAINER }, { L"SpriteShape", SHAPE_SPRITE },
+        { L"PathGeometry", GEOMETRY_PATH }, { L"RectangleGeometry", GEOMETRY_RECTANGLE },
+        { L"RoundedRectangleGeometry", GEOMETRY_ROUNDED_RECTANGLE }, { L"EllipseGeometry", GEOMETRY_ELLIPSE },
+        { L"LineGeometry", GEOMETRY_LINE }, { L"ViewBox", SHAPE_VIEW_BOX }, { L"ShapeCollection", SHAPE_COLLECTION },
+    };
+    struct shape *impl;
+    HRESULT hr;
+    UINT i;
+
+    TRACE( "compositor %p, %s, arg %p.\n", compositor, debugstr_w( what ), arg );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    for (i = 0; i < ARRAY_SIZE(kinds); i++) if (!wcscmp( kinds[i].name, what )) break;
+    if (i == ARRAY_SIZE(kinds)) return E_INVALIDARG;
+    if (FAILED(hr = shape_new( compositor, kinds[i].kind, &impl ))) return hr;
+    if (arg && kinds[i].kind == SHAPE_SPRITE) sprite_put_Geometry( &impl->IInspectable_iface, arg );
+    if (arg && kinds[i].kind == GEOMETRY_PATH) path_geometry_put_Path( &impl->IInspectable_iface, arg );
+    *out = &impl->IInspectable_iface;
+    return S_OK;
+}
+
+/* ---- the CompositionPath class: ICompositionPathFactory.Create(IGeometrySource2D) ---- */
+
+struct path_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    struct xiface path_factory_iface;
+};
+
+static struct path_factory path_factory_impl;
+
+static HRESULT WINAPI pf_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &path_factory_impl.IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionPathFactory_x ))
+        *out = &path_factory_impl.path_factory_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI pf_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI pf_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI pf_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { *count = 0; *iids = NULL; return S_OK; }
+static HRESULT WINAPI pf_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return WindowsCreateString( class_names[SHAPE_PATH], wcslen( class_names[SHAPE_PATH] ), name );
+}
+static HRESULT WINAPI pf_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI pf_ActivateInstance( IActivationFactory *iface, IInspectable **out ) { *out = NULL; return E_NOTIMPL; }
+
+static const struct IActivationFactoryVtbl pf_vtbl =
+{
+    pf_QueryInterface, pf_AddRef, pf_Release, pf_GetIids, pf_GetRuntimeClassName, pf_GetTrustLevel,
+    pf_ActivateInstance,
+};
+
+static HRESULT WINAPI pfi_QueryInterface( void *iface, REFIID iid, void **out ) { return pf_QueryInterface( NULL, iid, out ); }
+static ULONG WINAPI pfi_AddRef( void *iface ) { return 2; }
+static ULONG WINAPI pfi_Release( void *iface ) { return 1; }
+static HRESULT WINAPI pfi_GetIids( void *iface, ULONG *count, IID **iids ) { *count = 0; *iids = NULL; return S_OK; }
+static HRESULT WINAPI pfi_GetRuntimeClassName( void *iface, HSTRING *name ) { return pf_GetRuntimeClassName( NULL, name ); }
+static HRESULT WINAPI pfi_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI pfi_Create( void *iface, IUnknown *source, IInspectable **out )
+{
+    struct shape *impl;
+    HRESULT hr;
+
+    TRACE( "source %p, out %p.\n", source, out );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!source) return E_INVALIDARG;
+    if (FAILED(hr = shape_new( NULL, SHAPE_PATH, &impl ))) return hr;
+    impl->source = source;
+    IUnknown_AddRef( source );
+    *out = &impl->IInspectable_iface;
+    return S_OK;
+}
+
+static const void * const pfi_vtbl[] =
+{
+    pfi_QueryInterface, pfi_AddRef, pfi_Release, pfi_GetIids, pfi_GetRuntimeClassName, pfi_GetTrustLevel, pfi_Create,
+};
+
+static struct path_factory path_factory_impl = { { &pf_vtbl }, { pfi_vtbl } };
+
+IActivationFactory *path_factory = &path_factory_impl.IActivationFactory_iface;
+
+/* ---- drawing ---- */
+
+/* the geometry of a CompositionPath: its source's Direct2D geometry (IGeometrySource2DInterop) */
+static ID2D1Geometry *path_d2d_geometry( IInspectable *path )
+{
+    struct shape *impl = unsafe_shape( (IUnknown *)path, NULL );
+    IUnknown *interop = NULL;
+    ID2D1Geometry *geometry = NULL;
+
+    if (!impl || impl->kind != SHAPE_PATH || !impl->source) return NULL;
+    if (FAILED(IUnknown_QueryInterface( impl->source, &IID_IGeometrySource2DInterop_x, (void **)&interop ))) return NULL;
+    /* IGeometrySource2DInterop::GetGeometry, slot 3 */
+    if (FAILED(((HRESULT (WINAPI *)( IUnknown *, ID2D1Geometry ** ))((void **)interop->lpVtbl)[3])( interop, &geometry )))
+        geometry = NULL;
+    IUnknown_Release( interop );
+    return geometry;
+}
+
+/* the Direct2D geometry of a geometry of ours */
+static ID2D1Geometry *shape_d2d_geometry( ID2D1Factory *factory, struct shape *g )
+{
+    ID2D1Geometry *geometry = NULL;
+
+    switch (g->kind)
+    {
+    case GEOMETRY_PATH:
+        geometry = g->path ? path_d2d_geometry( g->path ) : NULL;
+        break;
+    case GEOMETRY_RECTANGLE:
+    {
+        D2D1_RECT_F rect = { g->g_offset.X, g->g_offset.Y, g->g_offset.X + g->g_size.X, g->g_offset.Y + g->g_size.Y };
+        ID2D1Factory_CreateRectangleGeometry( factory, &rect, (ID2D1RectangleGeometry **)&geometry );
+        break;
+    }
+    case GEOMETRY_ROUNDED_RECTANGLE:
+    {
+        D2D1_ROUNDED_RECT rect = { { g->g_offset.X, g->g_offset.Y, g->g_offset.X + g->g_size.X, g->g_offset.Y + g->g_size.Y },
+                                   g->corner.X, g->corner.Y };
+        ID2D1Factory_CreateRoundedRectangleGeometry( factory, &rect, (ID2D1RoundedRectangleGeometry **)&geometry );
+        break;
+    }
+    case GEOMETRY_ELLIPSE:
+    {
+        D2D1_ELLIPSE ellipse = { { g->g_center.X, g->g_center.Y }, g->radius.X, g->radius.Y };
+        ID2D1Factory_CreateEllipseGeometry( factory, &ellipse, (ID2D1EllipseGeometry **)&geometry );
+        break;
+    }
+    case GEOMETRY_LINE:
+    {
+        ID2D1PathGeometry *path;
+        ID2D1GeometrySink *sink;
+        if (SUCCEEDED(ID2D1Factory_CreatePathGeometry( factory, &path )))
+        {
+            if (SUCCEEDED(ID2D1PathGeometry_Open( path, &sink )))
+            {
+                ID2D1GeometrySink_BeginFigure( sink, (D2D1_POINT_2F){ g->start.X, g->start.Y }, D2D1_FIGURE_BEGIN_HOLLOW );
+                ID2D1GeometrySink_AddLine( sink, (D2D1_POINT_2F){ g->end.X, g->end.Y } );
+                ID2D1GeometrySink_EndFigure( sink, D2D1_FIGURE_END_OPEN );
+                ID2D1GeometrySink_Close( sink );
+                ID2D1GeometrySink_Release( sink );
+            }
+            geometry = (ID2D1Geometry *)path;
+        }
+        break;
+    }
+    default:
+        break;
+    }
+    return geometry;
+}
+
+/* a shape's own transform: scale and rotation about its centre point, its matrix, then its offset */
+static void shape_transform( const struct shape *s, D2D1_MATRIX_3X2_F *m )
+{
+    float cx = s->center.X, cy = s->center.Y, c = cosf( s->rotation ), sn = sinf( s->rotation );
+    D2D1_MATRIX_3X2_F a, b;
+
+    a._11 = s->scale.X * c; a._12 = s->scale.X * sn;
+    a._21 = -s->scale.Y * sn; a._22 = s->scale.Y * c;
+    a._31 = -cx * a._11 - cy * a._21 + cx;
+    a._32 = -cx * a._12 - cy * a._22 + cy;
+    b._11 = s->transform.M11; b._12 = s->transform.M12;
+    b._21 = s->transform.M21; b._22 = s->transform.M22;
+    b._31 = s->transform.M31; b._32 = s->transform.M32;
+    m->_11 = a._11 * b._11 + a._12 * b._21;
+    m->_12 = a._11 * b._12 + a._12 * b._22;
+    m->_21 = a._21 * b._11 + a._22 * b._21;
+    m->_22 = a._21 * b._12 + a._22 * b._22;
+    m->_31 = a._31 * b._11 + a._32 * b._21 + b._31 + s->offset.X;
+    m->_32 = a._31 * b._12 + a._32 * b._22 + b._32 + s->offset.Y;
+}
+
+static void multiply( D2D1_MATRIX_3X2_F *out, const D2D1_MATRIX_3X2_F *a, const D2D1_MATRIX_3X2_F *b )
+{
+    D2D1_MATRIX_3X2_F r;
+    r._11 = a->_11 * b->_11 + a->_12 * b->_21;
+    r._12 = a->_11 * b->_12 + a->_12 * b->_22;
+    r._21 = a->_21 * b->_11 + a->_22 * b->_21;
+    r._22 = a->_21 * b->_12 + a->_22 * b->_22;
+    r._31 = a->_31 * b->_11 + a->_32 * b->_21 + b->_31;
+    r._32 = a->_31 * b->_12 + a->_32 * b->_22 + b->_32;
+    *out = r;
+}
+
+static ID2D1Brush *make_brush( ID2D1DeviceContext *ctx, ICompositionBrush *brush, float opacity )
+{
+    ID2D1SolidColorBrush *solid = NULL;
+    ICompositionBrush *base = NULL;
+    D2D1_COLOR_F color;
+    BOOL ok;
+
+    /* whichever of its interfaces it was given as */
+    if (!brush || FAILED(ICompositionBrush_QueryInterface( brush, &IID_ICompositionBrush, (void **)&base ))) return NULL;
+    ok = composition_brush_color( base, &color );
+    ICompositionBrush_Release( base );
+    if (!ok) return NULL;
+    color.a *= opacity;
+    if (FAILED(ID2D1DeviceContext_CreateSolidColorBrush( ctx, &color, NULL, &solid ))) return NULL;
+    return (ID2D1Brush *)solid;
+}
+
+static void draw_shape( ID2D1DeviceContext *ctx, ID2D1Factory *factory, IInspectable *item,
+                        const D2D1_MATRIX_3X2_F *parent, float opacity, unsigned int depth )
+{
+    struct shape *s = unsafe_shape( (IUnknown *)item, is_shape ), *g;
+    D2D1_MATRIX_3X2_F local, world;
+    ID2D1Geometry *geometry;
+    ID2D1Brush *brush;
+    UINT i;
+
+    if (!s || depth > 64) return;
+    TRACE( "shape %p kind %u depth %u\n", s, s->kind, depth );
+    shape_transform( s, &local );
+    multiply( &world, &local, parent );
+    if (s->kind == SHAPE_CONTAINER)
+    {
+        for (i = 0; i < s->shapes->count; i++) draw_shape( ctx, factory, s->shapes->items[i], &world, opacity, depth + 1 );
+        return;
+    }
+    if (!(g = unsafe_shape( (IUnknown *)s->geometry, is_geometry ))) return;
+    if (!(geometry = shape_d2d_geometry( factory, g )))
+    {
+        WARN( "shape %p: no geometry of kind %u\n", s, g->kind );
+        return;
+    }
+    TRACE( "shape %p: geometry kind %u, fill %p, stroke %p, at %g,%g\n", s, g->kind, s->fill, s->stroke, world._31, world._32 );
+    ID2D1DeviceContext_SetTransform( ctx, &world );
+    if (g->trim_start > 0.0f || g->trim_end < 1.0f || g->trim_offset != 0.0f)
+        TRACE( "trim %g-%g offset %g not applied\n", g->trim_start, g->trim_end, g->trim_offset );
+    if (g->trim_end > g->trim_start)
+    {
+        if ((brush = make_brush( ctx, s->fill, opacity )))
+        {
+            ID2D1DeviceContext_FillGeometry( ctx, geometry, brush, NULL );
+            ID2D1Brush_Release( brush );
+        }
+        if (s->stroke_thickness > 0.0f && (brush = make_brush( ctx, s->stroke, opacity )))
+        {
+            ID2D1DeviceContext_DrawGeometry( ctx, geometry, brush, s->stroke_thickness, NULL );
+            ID2D1Brush_Release( brush );
+        }
+    }
+    ID2D1Geometry_Release( geometry );
+}
+
+/* a ShapeVisual's shapes, in its own space (the transform of the visual), within its size */
+void shapes_draw( ID2D1DeviceContext *ctx, IInspectable *collection, IInspectable *view_box, Vector2 size,
+                  const D2D1_MATRIX_3X2_F *world, float opacity )
+{
+    struct shape *shapes = unsafe_shape( (IUnknown *)collection, NULL ), *vb = unsafe_shape( (IUnknown *)view_box, NULL );
+    D2D1_MATRIX_3X2_F base = *world, fit;
+    ID2D1Factory *factory = NULL;
+    UINT i;
+
+    TRACE( "collection %p, size %gx%g, opacity %g\n", collection, size.X, size.Y, opacity );
+    if (!shapes || shapes->kind != SHAPE_COLLECTION || !shapes->count) return;
+    ID2D1DeviceContext_GetFactory( ctx, &factory );
+    if (vb && vb->kind == SHAPE_VIEW_BOX && vb->vb_size.X > 0 && vb->vb_size.Y > 0)
+    {
+        /* the view box's area fitted into the visual by its stretch */
+        float sx = size.X / vb->vb_size.X, sy = size.Y / vb->vb_size.Y;
+        switch (vb->stretch)
+        {
+        case 0: sx = sy = 1.0f; break;                   /* None */
+        case 2: sx = sy = min( sx, sy ); break;          /* Uniform */
+        case 3: sx = sy = max( sx, sy ); break;          /* UniformToFill */
+        default: break;                                  /* Fill */
+        }
+        fit._11 = sx; fit._12 = 0; fit._21 = 0; fit._22 = sy;
+        fit._31 = -vb->vb_offset.X * sx + (size.X - vb->vb_size.X * sx) * vb->h_ratio;
+        fit._32 = -vb->vb_offset.Y * sy + (size.Y - vb->vb_size.Y * sy) * vb->v_ratio;
+        multiply( &base, &fit, world );
+    }
+    ID2D1DeviceContext_PushAxisAlignedClip( ctx, &(D2D1_RECT_F){ 0, 0, size.X, size.Y }, D2D1_ANTIALIAS_MODE_ALIASED );
+    for (i = 0; i < shapes->count; i++) draw_shape( ctx, factory, shapes->items[i], &base, opacity, 0 );
+    ID2D1DeviceContext_SetTransform( ctx, world );
+    ID2D1DeviceContext_PopAxisAlignedClip( ctx );
+    if (factory) ID2D1Factory_Release( factory );
+}
+
+/* a new, empty shape collection for a ShapeVisual */
+HRESULT shape_collection_create( struct compositor *compositor, IInspectable **out )
+{
+    return shape_create( compositor, L"ShapeCollection", NULL, out );
+}
+
+/* a stamp of what a shape tree draws: it changes when something drawn changes */
+static UINT64 stamp_bytes( UINT64 h, const void *data, size_t size )
+{
+    const BYTE *p = data;
+    while (size--) h = (h ^ *p++) * 0x100000001b3ull;
+    return h;
+}
+
+static UINT64 stamp_brush( UINT64 h, ICompositionBrush *brush )
+{
+    ICompositionBrush *base = NULL;
+    D2D1_COLOR_F color = { 0 };
+
+    if (brush && SUCCEEDED(ICompositionBrush_QueryInterface( brush, &IID_ICompositionBrush, (void **)&base )))
+    {
+        composition_brush_color( base, &color );
+        ICompositionBrush_Release( base );
+    }
+    return stamp_bytes( h, &color, sizeof(color) );
+}
+
+static UINT64 stamp_shape( UINT64 h, IInspectable *item, unsigned int depth )
+{
+    struct shape *s = unsafe_shape( (IUnknown *)item, NULL ), *g;
+    UINT i;
+
+    if (!s || depth > 64) return h;
+    h = stamp_bytes( h, &s->center, offsetof(struct shape, shapes) - offsetof(struct shape, center) );
+    if (s->kind == SHAPE_CONTAINER)
+    {
+        for (i = 0; i < s->shapes->count; i++) h = stamp_shape( h, s->shapes->items[i], depth + 1 );
+        return h;
+    }
+    if (s->kind == SHAPE_COLLECTION)
+    {
+        for (i = 0; i < s->count; i++) h = stamp_shape( h, s->items[i], depth + 1 );
+        return h;
+    }
+    h = stamp_bytes( h, &s->stroke_thickness, offsetof(struct shape, trim_start) - offsetof(struct shape, stroke_thickness) );
+    h = stamp_brush( h, s->fill );
+    h = stamp_brush( h, s->stroke );
+    if ((g = unsafe_shape( (IUnknown *)s->geometry, is_geometry )))
+    {
+        h = stamp_bytes( h, &g, sizeof(g) );
+        h = stamp_bytes( h, &g->trim_start, offsetof(struct shape, h_ratio) - offsetof(struct shape, trim_start) );
+    }
+    return h;
+}
+
+UINT64 shapes_stamp( IInspectable *collection, IInspectable *view_box, UINT64 h )
+{
+    struct shape *vb = unsafe_shape( (IUnknown *)view_box, NULL );
+    h = stamp_shape( h, collection, 0 );
+    if (vb) h = stamp_bytes( h, &vb->h_ratio, offsetof(struct shape, source) - offsetof(struct shape, h_ratio) );
+    return h;
+}
