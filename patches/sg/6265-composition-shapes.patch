+    if (v->shape_visual) h = shapes_stamp( v->shapes, v->view_box, h );
+    LIST_FOR_EACH_ENTRY( child, &v->children, struct visual, entry ) h = visual_stamp( child, h, depth + 1 );
+    return h;
