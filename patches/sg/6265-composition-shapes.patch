+        { L"PlaybackRate", ANIM_SCALAR, offsetof(struct controller, rate) },
+    };
+    return anim_resolve( impl, members, ARRAY_SIZE(members), name, prop );
+}
+
+DEFINE_COMPOSITION_OBJECT_( controller, struct controller, IAnimationController_iface, controller_animatable )
+DEFINE_COMPOSITION_OBJECT4( controller, struct controller, IAnimationController_iface )
+
+static struct controller *controller_create( struct compositor *compositor )
+{
+    struct controller *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->IAnimationController_iface.lpVtbl = (const IInspectableVtbl *)controller_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &controller_object_vtbl;
+    impl->IClosable_iface.lpVtbl = &controller_closable_vtbl;
+    impl->ICompositionObject4_iface.lpVtbl = (const IInspectableVtbl *)controller_object4_vtbl;
+    impl->ref = 1;
+    impl->compositor = compositor;
+    ICompositor_AddRef( (ICompositor *)compositor );
+    impl->rate = 1.0f;
+    return impl;
+}
