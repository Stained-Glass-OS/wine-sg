+    if (depth > 256) return h;
+    h = (h ^ (UINT_PTR)v) * 0x100000001b3ull;
+    h = (h ^ v->visible) * 0x100000001b3ull;
+    if (!v->visible) return h;
+    {
+        const BYTE *p = (const BYTE *)&v->anchor_point;
+        size_t size = offsetof(struct visual, clip) - offsetof(struct visual, anchor_point);
+        while (size--) h = (h ^ *p++) * 0x100000001b3ull;
