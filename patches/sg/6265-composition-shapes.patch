+/* the item as the collection keeps it: one of our shapes, as ICompositionShape */
+static HRESULT collection_item( IInspectable *item, IInspectable **out )
+{
+    struct shape *shape = unsafe_shape( (IUnknown *)item, is_shape );
+
+    *out = NULL;
+    if (!shape) return E_INVALIDARG;
+    IInspectable_AddRef( (*out = &shape->IInspectable_iface) );
+    return S_OK;
+}
+
+static HRESULT collection_insert( struct shape *impl, UINT32 index, IInspectable *item )
+{
+    IInspectable *kept;
+    HRESULT hr;
+
+    if (index > impl->count) return E_BOUNDS;
+    if (FAILED(hr = collection_item( item, &kept ))) return hr;
+    if (impl->count == impl->capacity)
+    {
+        UINT capacity = max( 8, impl->capacity * 2 );
+        IInspectable **items = realloc( impl->items, capacity * sizeof(*items) );
+        if (!items)
+        {
+            IInspectable_Release( kept );
+            return E_OUTOFMEMORY;
+        }
+        impl->items = items;
+        impl->capacity = capacity;
+    }
+    memmove( impl->items + index + 1, impl->items + index, (impl->count - index) * sizeof(*impl->items) );
+    impl->items[index] = kept;
+    impl->count++;
+    changed( impl );
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_SetAt( void *iface, UINT32 index, IInspectable *item )
+{
+    struct shape *impl = self_impl( iface );
+    IInspectable *kept;
+    HRESULT hr;
+
+    if (index >= impl->count) return E_BOUNDS;
+    if (FAILED(hr = collection_item( item, &kept ))) return hr;
+    IInspectable_Release( impl->items[index] );
+    impl->items[index] = kept;
+    changed( impl );
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_InsertAt( void *iface, UINT32 index, IInspectable *item )
+{
+    return collection_insert( self_impl( iface ), index, item );
+}
+
+static HRESULT WINAPI collection_RemoveAt( void *iface, UINT32 index )
+{
+    struct shape *impl = self_impl( iface );
+
+    if (index >= impl->count) return E_BOUNDS;
+    IInspectable_Release( impl->items[index] );
+    memmove( impl->items + index, impl->items + index + 1, (impl->count - index - 1) * sizeof(*impl->items) );
+    impl->count--;
+    changed( impl );
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_Append( void *iface, IInspectable *item )
+{
+    struct shape *impl = self_impl( iface );
+    return collection_insert( impl, impl->count, item );
+}
+
+static HRESULT WINAPI collection_RemoveAtEnd( void *iface )
+{
+    struct shape *impl = self_impl( iface );
+    if (!impl->count) return E_BOUNDS;
+    return collection_RemoveAt( iface, impl->count - 1 );
+}
+
+static HRESULT WINAPI collection_Clear( void *iface )
+{
+    struct shape *impl = self_impl( iface );
+    while (impl->count) IInspectable_Release( impl->items[--impl->count] );
+    changed( impl );
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_GetMany( void *iface, UINT32 start, UINT32 size, IInspectable **items, UINT32 *count )
+{
+    struct shape *impl = self_impl( iface );
+    UINT i;
+
+    *count = 0;
+    for (i = start; i < impl->count && *count < size; i++)
+    {
+        items[*count] = impl->items[i];
+        IInspectable_AddRef( items[*count] );
+        ++*count;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_ReplaceAll( void *iface, UINT32 size, IInspectable **items )
+{
+    struct shape *impl = self_impl( iface );
+    HRESULT hr = S_OK;
+    UINT i;
+
+    collection_Clear( iface );
+    for (i = 0; i < size && SUCCEEDED(hr); i++) hr = collection_insert( impl, impl->count, items[i] );
+    return hr;
+}
