+static HRESULT WINAPI collection_IndexOf( void *iface, IInspectable *item, UINT32 *index, boolean *found )
+{
+    struct shape *impl = self_impl( iface );
+    struct shape *wanted = unsafe_shape( (IUnknown *)item, NULL );
+    UINT i;
+
+    *found = FALSE;
+    *index = 0;
+    for (i = 0; i < impl->count; i++)
+        if (unsafe_shape( (IUnknown *)impl->items[i], NULL ) == wanted) { *index = i; *found = TRUE; break; }
+    return S_OK;
