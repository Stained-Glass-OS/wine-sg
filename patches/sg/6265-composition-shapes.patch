+/* what a visual tree draws, as a stamp: it changes when something drawn changes */
+static UINT64 visual_stamp( struct visual *v, UINT64 h, unsigned int depth )
+{
+    struct visual *child;
+    struct brush *brush;
+    struct clip *clip;
