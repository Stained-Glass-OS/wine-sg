+/* ---- AnimationController: a running animation paused and driven by its Progress (wine-sg 6265) ---- */
+
+static const GUID IID_IAnimationController_x = { 0xc934efd2, 0x0722, 0x4f5f, { 0xa4, 0xe2, 0x95, 0x10, 0xf3, 0xd4, 0x3b, 0xf7 } };
+
+struct controller
+{
+    IInspectable IAnimationController_iface;
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    IInspectable ICompositionObject4_iface;
+    LONG ref;
+    struct compositor *compositor;
+    ICompositionPropertySet *properties;
+    FLOAT rate, progress;
+    INT32 behavior;
+    BOOL paused;
+};
+
+static struct controller *impl_from_controller( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct controller, IAnimationController_iface );
+}
+
+static HRESULT WINAPI controller_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct controller *impl = impl_from_controller( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAnimationController_x ))
+        *out = &impl->IAnimationController_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject ))
+        *out = &impl->ICompositionObject_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject4_x ))
+        *out = &impl->ICompositionObject4_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI controller_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_controller( iface )->ref );
+}
+
+static ULONG WINAPI controller_Release( IInspectable *iface )
+{
+    struct controller *impl = impl_from_controller( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        object_release_properties( impl->properties );
+        ICompositor_Release( (ICompositor *)impl->compositor );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI controller_GetIids( IInspectable *iface, ULONG *count, IID **iids )
+{
+    static const IID *const list[] = { &IID_IAnimationController_x, &IID_ICompositionObject, &IID_IClosable };
+    return iid_list( count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI controller_GetRuntimeClassName( IInspectable *iface, HSTRING *name )
+{
+    return class_name( L"Windows.UI.Composition.AnimationController", name );
+}
+
+static HRESULT WINAPI controller_GetTrustLevel( IInspectable *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+#define CONTROLLER_PROPERTY( name, type, field )                                                   \
+    static HRESULT WINAPI controller_get_##name( IInspectable *iface, type *value )                \
+    {                                                                                              \
+        if (!value) return E_POINTER;                                                              \
+        *value = impl_from_controller( iface )->field;                                             \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static HRESULT WINAPI controller_put_##name( IInspectable *iface, type value )                 \
+    {                                                                                              \
+        struct controller *impl = impl_from_controller( iface );                                   \
+        impl->field = value;                                                                       \
+        compositor_changed( impl->compositor );                                                    \
+        compositor_wake( impl->compositor );                                                       \
+        return S_OK;                                                                               \
+    }
+
+CONTROLLER_PROPERTY( PlaybackRate, FLOAT, rate )
+CONTROLLER_PROPERTY( Progress, FLOAT, progress )
+CONTROLLER_PROPERTY( ProgressBehavior, INT32, behavior )
+
+static HRESULT WINAPI controller_Pause( IInspectable *iface )
+{
+    struct controller *impl = impl_from_controller( iface );
+    TRACE( "controller %p paused at %g.\n", impl, impl->progress );
+    impl->paused = TRUE;
+    compositor_wake( impl->compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI controller_Resume( IInspectable *iface )
+{
+    struct controller *impl = impl_from_controller( iface );
+    FIXME( "controller %p: resumed, its animation keeps the progress it is given\n", impl );
+    return S_OK;
+}
