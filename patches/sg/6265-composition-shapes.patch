+HRESULT object_animation_controller( struct compositor *compositor, IUnknown *owner, HSTRING name, IInspectable **out )
+{
+    struct anim_clock *clock;
+    struct running *r;
+    WCHAR *text;
+
+    TRACE( "owner %p, name %s.\n", owner, debugstr_hstring( name ) );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(text = hstring_dup( name ))) return E_OUTOFMEMORY;
+    compositor_lock( compositor );
+    if ((clock = get_clock( compositor )) && (r = find_running( clock, owner, text )) && !r->expr)
+    {
+        if (!r->controller) r->controller = controller_create( compositor );
+        if (r->controller)
+        {
+            *out = &r->controller->IAnimationController_iface;
+            IInspectable_AddRef( *out );
+        }
+    }
+    compositor_unlock( compositor );
+    free( text );
+    return S_OK;
+}
