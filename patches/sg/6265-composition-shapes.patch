+static struct shape *impl_from_IInspectable( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct shape, IInspectable_iface );
+}
+
+static BOOL is_shape( const struct shape *s ) { return s->kind == SHAPE_CONTAINER || s->kind == SHAPE_SPRITE; }
+static BOOL is_geometry( const struct shape *s ) { return s->kind >= GEOMETRY_PATH && s->kind <= GEOMETRY_LINE; }
+
+static const GUID *kind_iid( enum shape_kind kind )
+{
+    switch (kind)
+    {
+    case SHAPE_CONTAINER: return &IID_ICompositionContainerShape_x;
+    case SHAPE_SPRITE: return &IID_ICompositionSpriteShape_x;
+    case GEOMETRY_PATH: return &IID_ICompositionPathGeometry_x;
+    case GEOMETRY_RECTANGLE: return &IID_ICompositionRectangleGeometry_x;
+    case GEOMETRY_ROUNDED_RECTANGLE: return &IID_ICompositionRoundedRectangleGeometry_x;
+    case GEOMETRY_ELLIPSE: return &IID_ICompositionEllipseGeometry_x;
+    case GEOMETRY_LINE: return &IID_ICompositionLineGeometry_x;
+    case SHAPE_VIEW_BOX: return &IID_ICompositionViewBox_x;
+    case SHAPE_PATH: return &IID_ICompositionPath_x;
+    case SHAPE_COLLECTION: return &IID_IVector_Shape;
+    }
+    return &IID_IInspectable;
+}
+
+/* one of ours, of a kind (NULL if not) */
+static struct shape *unsafe_shape( IUnknown *unknown, BOOL (*test)( const struct shape * ) )
+{
+    IInspectable *inspectable;
+    struct shape *impl = NULL;
+
+    if (!unknown || FAILED(IUnknown_QueryInterface( unknown, &IID_IInspectable, (void **)&inspectable ))) return NULL;
+    if (inspectable->lpVtbl == (const IInspectableVtbl *)kind_vtbl( SHAPE_CONTAINER ) ||
+        inspectable->lpVtbl == (const IInspectableVtbl *)kind_vtbl( SHAPE_SPRITE ) ||
+        inspectable->lpVtbl == (const IInspectableVtbl *)kind_vtbl( GEOMETRY_PATH ) ||
+        inspectable->lpVtbl == (const IInspectableVtbl *)kind_vtbl( GEOMETRY_RECTANGLE ) ||
+        inspectable->lpVtbl == (const IInspectableVtbl *)kind_vtbl( GEOMETRY_ROUNDED_RECTANGLE ) ||
+        inspectable->lpVtbl == (const IInspectableVtbl *)kind_vtbl( GEOMETRY_ELLIPSE ) ||
+        inspectable->lpVtbl == (const IInspectableVtbl *)kind_vtbl( GEOMETRY_LINE ) ||
+        inspectable->lpVtbl == (const IInspectableVtbl *)kind_vtbl( SHAPE_VIEW_BOX ) ||
+        inspectable->lpVtbl == (const IInspectableVtbl *)kind_vtbl( SHAPE_PATH ) ||
+        inspectable->lpVtbl == (const IInspectableVtbl *)kind_vtbl( SHAPE_COLLECTION ))
+        impl = impl_from_IInspectable( inspectable );
+    IInspectable_Release( inspectable );
+    if (impl && test && !test( impl )) impl = NULL;
+    return impl;
+}
+
+/* ---- IInspectable of the class's own interface ---- */
+
+static HRESULT WINAPI shape_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct shape *impl = impl_from_IInspectable( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, kind_iid( impl->kind ) ))
+        *out = &impl->IInspectable_iface;
+    else if (is_shape( impl ) && IsEqualGUID( iid, &IID_ICompositionShape_x ))
+        *out = &impl->shape_iface;
+    else if (is_geometry( impl ) && IsEqualGUID( iid, &IID_ICompositionGeometry_x ))
+        *out = &impl->geometry_iface;
+    else if (impl->kind == SHAPE_COLLECTION && IsEqualGUID( iid, &IID_IIterable_Shape ))
+        *out = &impl->iterable_iface;
+    else if (impl->kind != SHAPE_PATH && IsEqualGUID( iid, &IID_ICompositionObject ))
+        *out = &impl->ICompositionObject_iface;
+    else if (impl->kind != SHAPE_PATH && IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else if (impl->kind != SHAPE_PATH && IsEqualGUID( iid, &IID_ICompositionObject4_x ))
+        *out = &impl->ICompositionObject4_iface;
+    else
+    {
+        *out = NULL;
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI shape_AddRef( IInspectable *iface )
+{
+    struct shape *impl = impl_from_IInspectable( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static void release_object( IInspectable **slot )
+{
+    if (*slot) IInspectable_Release( *slot );
+    *slot = NULL;
+}
+
+static ULONG WINAPI shape_Release( IInspectable *iface )
+{
+    struct shape *impl = impl_from_IInspectable( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT i;
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+    if (!ref)
+    {
+        if (impl->shapes) IInspectable_Release( &impl->shapes->IInspectable_iface );
+        for (i = 0; i < impl->count; i++) IInspectable_Release( impl->items[i] );
+        free( impl->items );
+        if (impl->fill) ICompositionBrush_Release( impl->fill );
+        if (impl->stroke) ICompositionBrush_Release( impl->stroke );
+        release_object( &impl->geometry );
+        release_object( &impl->path );
+        if (impl->source) IUnknown_Release( impl->source );
+        object_release_properties( impl->properties );
+        if (impl->compositor) ICompositor_Release( (ICompositor *)impl->compositor );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI shape_GetIids( IInspectable *iface, ULONG *count, IID **iids )
+{
+    struct shape *impl = impl_from_IInspectable( iface );
+    ULONG n = 0;
+
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( 4 * sizeof(IID) ))) return E_OUTOFMEMORY;
+    (*iids)[n++] = *kind_iid( impl->kind );
+    if (is_shape( impl )) (*iids)[n++] = IID_ICompositionShape_x;
+    if (is_geometry( impl )) (*iids)[n++] = IID_ICompositionGeometry_x;
+    if (impl->kind != SHAPE_PATH) (*iids)[n++] = IID_ICompositionObject;
+    *count = n;
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_GetRuntimeClassName( IInspectable *iface, HSTRING *class_name )
