+        h = (h ^ *(UINT32 *)&clip->left ^ (UINT64)*(UINT32 *)&clip->top << 32) * 0x100000001b3ull;
+        h = (h ^ *(UINT32 *)&clip->right ^ (UINT64)*(UINT32 *)&clip->bottom << 32) * 0x100000001b3ull;
+        h = (h ^ *(UINT32 *)&clip->offset.X ^ (UINT64)*(UINT32 *)&clip->offset.Y << 32) * 0x100000001b3ull;
+    }
+    if (v->sprite && (brush = unsafe_brush( v->brush )))
