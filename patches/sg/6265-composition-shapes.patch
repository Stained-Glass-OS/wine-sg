+/* ---- an element's composition child visual (ElementCompositionPreview), drawn by dcomp (wine-sg 6265) ---- */
+
+static void (CDECL *composition_draw)( IUnknown *visual, IUnknown *ctx, const D2D1_MATRIX_3X2_F *transform );
+static UINT64 (CDECL *composition_stamp)( IUnknown *visual );
+static struct list comp_elements = LIST_INIT( comp_elements );   /* with a child visual, on the UI thread */
+
+void xaml_composition_child_set( struct uielem *elem, BOOL set )
+{
+    if (elem->comp_entry.next) list_remove( &elem->comp_entry );
+    elem->comp_entry.next = elem->comp_entry.prev = NULL;
+    if (set) list_add_tail( &comp_elements, &elem->comp_entry );
+}
+
+/* a commit of the compositor: the islands draw again when what a child visual draws changed (animations
+ * of visuals not drawn here -- a hidden ProgressRing's -- do not make them draw again) */
+static void CALLBACK composition_committed(void)
+{
+    struct uielem *elem;
+    BOOL changed = FALSE;
+
+    LIST_FOR_EACH_ENTRY( elem, &comp_elements, struct uielem, comp_entry )
+    {
+#ifndef SG_MUTANT_COMP_STAMP_IGNORED
+        if (composition_stamp && composition_stamp( (IUnknown *)elem->comp_child ) == elem->comp_stamp) continue;
+#endif
+        changed = TRUE;
+        break;
+    }
+    if (changed) xaml_invalidate_visuals();
+}
+
+static BOOL WINAPI init_composition_draw( INIT_ONCE *once, void *param, void **context )
+{
+    HMODULE dcomp = LoadLibraryW( L"dcomp.dll" );
+    void (CDECL *set_callback)( void (CALLBACK *)(void) );
+
+    if (!dcomp) return TRUE;
+    composition_draw = (void *)GetProcAddress( dcomp, "__wine_composition_draw" );
+    composition_stamp = (void *)GetProcAddress( dcomp, "__wine_composition_stamp" );
+    if ((set_callback = (void *)GetProcAddress( dcomp, "__wine_composition_set_commit_callback" )))
+        set_callback( composition_committed );
+    return TRUE;
+}
