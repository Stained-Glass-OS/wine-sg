+static HRESULT shape_new( struct compositor *compositor, enum shape_kind kind, struct shape **out )
+{
+    struct shape *impl;
+    HRESULT hr;
+
+    *out = NULL;
+#ifdef SG_MUTANT_NO_SHAPES
+    return E_NOTIMPL;
+#endif
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IInspectable_iface.lpVtbl = (const IInspectableVtbl *)kind_vtbl( kind );
+    impl->shape_iface.vtbl = shape_iface_vtbl;
+    impl->geometry_iface.vtbl = geometry_iface_vtbl;
+    impl->iterable_iface.vtbl = iterable_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &shape_object_vtbl;
+    impl->IClosable_iface.lpVtbl = &shape_closable_vtbl;
+    impl->ICompositionObject4_iface.lpVtbl = (const IInspectableVtbl *)shape_object4_vtbl;
+    impl->ref = 1;
+    impl->kind = kind;
+    if ((impl->compositor = compositor)) ICompositor_AddRef( (ICompositor *)compositor );
+    impl->scale.X = impl->scale.Y = 1.0f;
+    impl->transform.M11 = impl->transform.M22 = 1.0f;
+    impl->trim_end = 1.0f;
+    impl->miter_limit = 1.0f;
+    impl->stroke_thickness = 1.0f;
+    impl->stretch = 1;   /* CompositionStretch_Fill */
+    if (kind == SHAPE_CONTAINER && FAILED(hr = shape_new( compositor, SHAPE_COLLECTION, &impl->shapes )))
+    {
+        shape_Release( &impl->IInspectable_iface );
+        return hr;
+    }
+    *out = impl;
+    return S_OK;
+}
