From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] newdev: SgInstallDriverOnDevices private export for DIFxAPI (5901)

DIFxAPI (drafter 7's 5504) asks newdev, through the Wine-private export
SgInstallDriverOnDevices, how many present devices a driver package matches
and on how many it is (or, in the count-only mode, would be) installed. That
export came with drafter 7's 5503, which also replaced fast-a 3245's
DiInstallDriver. At integration (RECONCILE-CLOUD newdev MERGE) 3245 and fast-b's
5900 are kept and only the export is added, on 3245's matching: the
installed-driver comparison (device_has_better_driver) decides, and
DIIRFLAG_FORCE_INF (flags & 1) installs on every matching device.

Integration patch (integ-2026-10). Gates: test-newdev (drafter 7's), test-difxapi
(5504), fast-a's fastcloudnewdev.
---
diff --git a/dlls/newdev/main.c b/dlls/newdev/main.c
--- a/dlls/newdev/main.c
+++ b/dlls/newdev/main.c
@@ -312,14 +312,21 @@ static BOOL is_admin(void)
     return ret;
 }
 
-static BOOL install_inf_on_devices(const WCHAR *inf_path, DWORD flags, BOOL *reboot)
+/* Installs the package on the present devices it matches (only where it is a better driver than
+ * the one the device has, unless DIIRFLAG_FORCE_INF). matched counts the devices the package has a
+ * driver for, installed those it was (or, with dry_run, would be) installed on. */
+static BOOL install_inf_on_devices(const WCHAR *inf_path, DWORD flags, BOOL dry_run, BOOL *reboot,
+                                   DWORD *matched, DWORD *installed)
 {
     SP_DEVINSTALL_PARAMS_W params = {sizeof(params)};
     SP_DEVINFO_DATA device = {sizeof(device)};
     SP_DRVINFO_DATA_W drvinfo = {sizeof(drvinfo)};
-    DWORD i, j;
+    DWORD i, j, dummy;
     HDEVINFO set;
 
+    if (!matched) matched = &dummy;
+    if (!installed) installed = &dummy;
+    *matched = *installed = 0;
     if ((set = SetupDiGetClassDevsW(NULL, NULL, 0, DIGCF_ALLCLASSES | DIGCF_PRESENT)) == INVALID_HANDLE_VALUE)
         return TRUE; /* the package is in the driver store: that is a success */
 
@@ -333,6 +340,7 @@ static BOOL install_inf_on_devices(const WCHAR *inf_path, DWORD flags, BOOL *reb
         if (!SetupDiBuildDriverInfoList(set, &device, SPDIT_COMPATDRIVER)) continue;
         drvinfo.cbSize = sizeof(drvinfo);
         if (!SetupDiEnumDriverInfoW(set, &device, SPDIT_COMPATDRIVER, 0, &drvinfo)) continue;
+        ++*matched;
 
         #ifdef SG_MUTANT_NDV_ALWAYS
         if (0)
@@ -345,12 +353,18 @@ static BOOL install_inf_on_devices(const WCHAR *inf_path, DWORD flags, BOOL *reb
             TRACE("device %lu keeps its driver\n", i);
             continue;
         }
+        if (dry_run)
+        {
+            ++*installed;
+            continue;
+        }
 
         for (j = 0; j < ARRAY_SIZE(dif_list); ++j)
         {
             if (!SetupDiCallClassInstaller(dif_list[j], set, &device) && GetLastError() != ERROR_DI_DO_DEFAULT)
                 break;
         }
+        if (j == ARRAY_SIZE(dif_list)) ++*installed;
 
         params.cbSize = sizeof(params);
         if (reboot && SetupDiGetDeviceInstallParamsW(set, &device, &params)
@@ -362,6 +376,17 @@ static BOOL install_inf_on_devices(const WCHAR *inf_path, DWORD flags, BOOL *reb
     return TRUE;
 }
 
+/* Wine private (drafter 7's 5503, on this matching): the part of DiInstallDriver that DIFxAPI needs
+ * the counts of. flags: 1 = force (as DIIRFLAG_FORCE_INF), 2 = only count (matched, and installed =
+ * the devices it would be installed on). */
+BOOL WINAPI SgInstallDriverOnDevices(const WCHAR *inf_path, DWORD flags, BOOL *reboot, DWORD *matched, DWORD *installed)
+{
+    TRACE("%s, %#lx, %p, %p, %p\n", debugstr_w(inf_path), flags, reboot, matched, installed);
+
+    return install_inf_on_devices(inf_path, (flags & 1) ? DIIRFLAG_FORCE_INF : 0, !!(flags & 2), reboot,
+                                  matched, installed);
+}
+
 /***********************************************************************
  *           DiInstallDriverA (NEWDEV.@)
  */
@@ -454,5 +479,5 @@ BOOL WINAPI DiInstallDriverW(HWND parent, const WCHAR *inf_path, DWORD flags, BO
     if (!SetupCopyOEMInfW(inf_path, NULL, SPOST_PATH, 0, dest, ARRAY_SIZE(dest), NULL, NULL))
         return FALSE;
 
-    return install_inf_on_devices(dest, flags, reboot);
+    return install_inf_on_devices(dest, flags, FALSE, reboot, NULL, NULL);
 }
diff --git a/dlls/newdev/newdev.spec b/dlls/newdev/newdev.spec
--- a/dlls/newdev/newdev.spec
+++ b/dlls/newdev/newdev.spec
@@ -16,3 +16,4 @@
 @ stub pDiDoDeviceInstallAsAdmin
 @ stub pDiDoFinishInstallAsAdmin
 @ stub pDiDoNullDriverInstall
+@ stdcall -private SgInstallDriverOnDevices(wstr long ptr ptr ptr)
