diff --git a/dlls/wsock32/socket.c b/dlls/wsock32/socket.c
index 2df54b2..e8a4ea6 100644
--- a/dlls/wsock32/socket.c
+++ b/dlls/wsock32/socket.c
@@ -639,8 +639,24 @@ DWORD WINAPI WsControl(DWORD protocol,
  */
 INT WINAPI WSARecvEx(SOCKET s, char *buf, INT len, INT *flags)
 {
-    FIXME("(WSARecvEx) partial packet return value not set\n");
-    return recv(s, buf, len, *flags);
+    int ret;
+
+    TRACE("(%#Ix %p %d %p)\n", s, buf, len, flags);
+
+    if (!flags)
+    {
+        WSASetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+
+    ret = recv( s, buf, len, *flags & ~MSG_PARTIAL );
+    /* a datagram larger than the buffer: the buffer is full and the message is reported as partial */
+    if (ret == SOCKET_ERROR && WSAGetLastError() == WSAEMSGSIZE)
+    {
+        *flags |= MSG_PARTIAL;
+        return len;
+    }
+    return ret;
 }
 
 
