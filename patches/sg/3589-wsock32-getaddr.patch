@@ -31,32 +34,153 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(winsock);
 
-INT WINAPI GetAddressByNameA(DWORD dwNameSpace, LPGUID lpServiceType, LPSTR lpServiceName,
+#ifndef RES_FIND_MULTIPLE
+#define RES_SOFT_SEARCH   0x00000001
+#define RES_FIND_MULTIPLE 0x00000002
+#define RES_SERVICE       0x00000004
+#endif
+
+/* Name lookup through the Windows Sockets 2 name resolver: one CSADDR_INFO per address and requested protocol,
+ * packed into the caller's buffer, structures first, then the socket addresses they point to. */
+static INT get_address_by_name( DWORD name_space, GUID *type, WCHAR *name, INT *protocols, DWORD resolution,
+                                void *buffer, DWORD *buffer_len, WCHAR *alias, DWORD *alias_len )
+{
+    static const INT default_protocols[] = { IPPROTO_TCP, 0 };
+    CSADDR_INFO *out = buffer;
+    DWORD total, i, count = 0, p;
+    ADDRINFOW *list, *ai;
+    BYTE *data;
+    int err;
+
+    if (!name || !buffer_len || (*buffer_len && !buffer))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return SOCKET_ERROR;
+    }
+    if (name_space != NS_DNS && name_space != 0 && name_space != NS_ALL)
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+    if (!protocols) protocols = (INT *)default_protocols;
+
+    total = 0;
+    for (p = 0; protocols[p]; p++)
+    {
+        ADDRINFOW hints = {0};
+
+        hints.ai_family = AF_UNSPEC;
+        hints.ai_protocol = protocols[p];
+        hints.ai_socktype = protocols[p] == IPPROTO_UDP ? SOCK_DGRAM : SOCK_STREAM;
+        if ((err = GetAddrInfoW( name, NULL, &hints, &list )))
+        {
+            if (p) continue;
+            SetLastError( err );
+            return SOCKET_ERROR;
+        }
+        for (ai = list; ai; ai = ai->ai_next)
+        {
+            if (ai->ai_family != AF_INET && ai->ai_family != AF_INET6) continue;
+            total += sizeof(CSADDR_INFO) + ai->ai_addrlen;
+            count++;
+            if (!(resolution & RES_FIND_MULTIPLE)) break;
+        }
+        FreeAddrInfoW( list );
+    }
+    if (!count)
+    {
+        SetLastError( WSASERVICE_NOT_FOUND );
+        return SOCKET_ERROR;
+    }
+    if (*buffer_len < total)
+    {
+        *buffer_len = total;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return SOCKET_ERROR;
+    }
+
+    memset( buffer, 0, total );
+    data = (BYTE *)(out + count);
+    i = 0;
+    for (p = 0; protocols[p]; p++)
+    {
+        ADDRINFOW hints = {0};
+
+        hints.ai_family = AF_UNSPEC;
+        hints.ai_protocol = protocols[p];
+        hints.ai_socktype = protocols[p] == IPPROTO_UDP ? SOCK_DGRAM : SOCK_STREAM;
+        if (GetAddrInfoW( name, NULL, &hints, &list )) continue;
+        for (ai = list; ai && i < count; ai = ai->ai_next)
+        {
+            if (ai->ai_family != AF_INET && ai->ai_family != AF_INET6) continue;
+            memcpy( data, ai->ai_addr, ai->ai_addrlen );
+            out[i].RemoteAddr.lpSockaddr = (SOCKADDR *)data;
+            out[i].RemoteAddr.iSockaddrLength = ai->ai_addrlen;
+            out[i].iSocketType = hints.ai_socktype;
+            out[i].iProtocol = protocols[p];
+            data += ai->ai_addrlen;
+            i++;
+            if (!(resolution & RES_FIND_MULTIPLE)) break;
+        }
+        FreeAddrInfoW( list );
+    }
+    *buffer_len = total;
+    if (alias && alias_len && *alias_len) alias[0] = 0;
+    return i;
+}
+
+INT WINAPI GetAddressByNameW(DWORD dwNameSpace, LPGUID lpServiceType, LPWSTR lpServiceName,
     LPINT lpiProtocols, DWORD dwResolution, LPSERVICE_ASYNC_INFO lpServiceAsyncInfo,
-    LPVOID lpCsaddrBuffer, LPDWORD lpdwBufferLength, LPSTR lpAliasBuffer,
+    LPVOID lpCsaddrBuffer, LPDWORD lpdwBufferLength, LPWSTR lpAliasBuffer,
     LPDWORD lpdwAliasBufferLength)
 {
-    FIXME("(0x%08lx, %s, %s, %p, 0x%08lx, %p, %p, %p, %p, %p) stub\n", dwNameSpace,
-          debugstr_guid(lpServiceType), debugstr_a(lpServiceName), lpiProtocols,
+    TRACE("(0x%08lx, %s, %s, %p, 0x%08lx, %p, %p, %p, %p, %p)\n", dwNameSpace,
+          debugstr_guid(lpServiceType), debugstr_w(lpServiceName), lpiProtocols,
           dwResolution, lpServiceAsyncInfo, lpCsaddrBuffer, lpdwBufferLength,
           lpAliasBuffer, lpdwAliasBufferLength);
- 
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return SOCKET_ERROR;
+
+    if (lpServiceAsyncInfo)
+    {
+        FIXME("asynchronous calls are not supported\n");
+        SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+        return SOCKET_ERROR;
+    }
+    return get_address_by_name( dwNameSpace, lpServiceType, lpServiceName, lpiProtocols, dwResolution,
+                                lpCsaddrBuffer, lpdwBufferLength, lpAliasBuffer, lpdwAliasBufferLength );
 }
 
-INT WINAPI GetAddressByNameW(DWORD dwNameSpace, LPGUID lpServiceType, LPWSTR lpServiceName,
+INT WINAPI GetAddressByNameA(DWORD dwNameSpace, LPGUID lpServiceType, LPSTR lpServiceName,
     LPINT lpiProtocols, DWORD dwResolution, LPSERVICE_ASYNC_INFO lpServiceAsyncInfo,
-    LPVOID lpCsaddrBuffer, LPDWORD lpdwBufferLength, LPWSTR lpAliasBuffer,
+    LPVOID lpCsaddrBuffer, LPDWORD lpdwBufferLength, LPSTR lpAliasBuffer,
     LPDWORD lpdwAliasBufferLength)
 {
-    FIXME("(0x%08lx, %s, %s, %p, 0x%08lx, %p, %p, %p, %p, %p) stub\n", dwNameSpace,
-          debugstr_guid(lpServiceType), debugstr_w(lpServiceName), lpiProtocols,
+    WCHAR *name = NULL, *alias = NULL;
+    DWORD alias_len = lpdwAliasBufferLength ? *lpdwAliasBufferLength : 0;
+    INT len, ret;
+
+    TRACE("(0x%08lx, %s, %s, %p, 0x%08lx, %p, %p, %p, %p, %p)\n", dwNameSpace,
+          debugstr_guid(lpServiceType), debugstr_a(lpServiceName), lpiProtocols,
           dwResolution, lpServiceAsyncInfo, lpCsaddrBuffer, lpdwBufferLength,
           lpAliasBuffer, lpdwAliasBufferLength);
 
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return SOCKET_ERROR;
+    if (lpServiceName)
+    {
+        len = MultiByteToWideChar( CP_ACP, 0, lpServiceName, -1, NULL, 0 );
+        if (!(name = malloc( len * sizeof(WCHAR) ))) { SetLastError( ERROR_OUTOFMEMORY ); return SOCKET_ERROR; }
+        MultiByteToWideChar( CP_ACP, 0, lpServiceName, -1, name, len );
+    }
+    if (lpAliasBuffer && alias_len && !(alias = calloc( alias_len, sizeof(WCHAR) )))
+    {
+        free( name );
+        SetLastError( ERROR_OUTOFMEMORY );
+        return SOCKET_ERROR;
+    }
+    ret = GetAddressByNameW( dwNameSpace, lpServiceType, name, lpiProtocols, dwResolution, lpServiceAsyncInfo,
+                             lpCsaddrBuffer, lpdwBufferLength, alias, lpdwAliasBufferLength );
+    if (alias && ret != SOCKET_ERROR) WideCharToMultiByte( CP_ACP, 0, alias, -1, lpAliasBuffer, alias_len, NULL, NULL );
+    free( alias );
+    free( name );
+    return ret;
 }
 
