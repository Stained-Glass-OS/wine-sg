From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dxof: enum object lookups (3550)

d3dxof: IDirectXFileEnumObject::GetDataObjectById / GetDataObjectByName

Both read the rest of the file, then look the top-level object up by its GUID or name; a miss returns
DXFILEERR_NOTFOUND with a NULL result.
---
--- a/dlls/d3dxof/d3dxof.c
+++ b/dlls/d3dxof/d3dxof.c
@@ -1068,20 +1068,61 @@
   return hr;
 }
 
+/* read the rest of the file, so that every object is known */
+static HRESULT enum_object_parse_all(IDirectXFileEnumObject *iface)
+{
+    IDirectXFileEnumObjectImpl *This = impl_from_IDirectXFileEnumObject(iface);
+    IDirectXFileData *data;
+    HRESULT hr;
+
+    while ((hr = IDirectXFileEnumObject_GetNextDataObject(iface, &data)) == DXFILE_OK)
+        IDirectXFileData_Release(data);
+    (void)This;
+    return hr == DXFILEERR_NOMOREOBJECTS ? DXFILE_OK : hr;
+}
+
+static HRESULT enum_object_find(IDirectXFileEnumObject *iface, const char *name, const GUID *guid,
+        LPDIRECTXFILEDATA *data)
+{
+    IDirectXFileEnumObjectImpl *This = impl_from_IDirectXFileEnumObject(iface);
+    HRESULT hr;
+    ULONG i;
+
+    *data = NULL;
+    if (FAILED(hr = enum_object_parse_all(iface))) return hr;
+
+    for (i = 0; i < This->nb_xobjects; ++i)
+    {
+        const xobject *obj = This->xobjects[i];
+
+        if (name ? !strcmp(obj->name, name) : IsEqualGUID(&obj->class_id, guid))
+        {
+            *data = This->pRefObjects[i];
+            IDirectXFileData_AddRef(*data);
+            return DXFILE_OK;
+        }
+    }
+    return DXFILEERR_NOTFOUND;
+}
+
 static HRESULT WINAPI IDirectXFileEnumObjectImpl_GetDataObjectById(IDirectXFileEnumObject *iface,
         REFGUID guid, LPDIRECTXFILEDATA *data)
 {
-    FIXME("iface %p, guid %s, data %p stub!\n", iface, debugstr_guid(guid), data);
+    TRACE("iface %p, guid %s, data %p.\n", iface, debugstr_guid(guid), data);
 
-    return DXFILEERR_BADVALUE;
+    if (!data) return E_POINTER;
+    if (!guid) { *data = NULL; return DXFILEERR_BADVALUE; }
+    return enum_object_find(iface, NULL, guid, data);
 }
 
 static HRESULT WINAPI IDirectXFileEnumObjectImpl_GetDataObjectByName(IDirectXFileEnumObject *iface,
         const char *name, LPDIRECTXFILEDATA *data)
 {
-    FIXME("iface %p, name %s, data %p stub!\n", iface, debugstr_a(name), data);
+    TRACE("iface %p, name %s, data %p.\n", iface, debugstr_a(name), data);
 
-    return DXFILEERR_BADVALUE;
+    if (!data) return E_POINTER;
+    if (!name) { *data = NULL; return DXFILEERR_BADVALUE; }
+    return enum_object_find(iface, name, NULL, data);
 }
 
 static const IDirectXFileEnumObjectVtbl IDirectXFileEnumObject_Vtbl =
