From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.applicationmodel: a resource map is a map view of named resources

NanaZip reads its strings as map.HasKey(name), then map.Lookup(name).Candidates().GetAt(0).ValueAsString(); a ResourceMap was not an IMapView<String, NamedResource> and NanaZip's file manager threw before its first page. A map's map view (Lookup, HasKey, Split; Size not yet), NamedResource (Candidates, Resolve, ResolveAll and their context forms) and its ResourceCandidateVectorView (GetAt, Size, IndexOf, GetMany). Interface definitions per windows-rs 0.100 (MIT); the parameterized IIDs are the signatures' (the WinRT type system's rule); the implementation is ours.
---
diff --git a/dlls/windows.applicationmodel/resource_manager.c b/dlls/windows.applicationmodel/resource_manager.c
index 6825051..00491cf 100644
--- a/dlls/windows.applicationmodel/resource_manager.c
+++ b/dlls/windows.applicationmodel/resource_manager.c
@@ -42,6 +42,11 @@ DEFINE_GUID(IID_IResourceManager,        0xf744d97b, 0x9988, 0x44fb, 0xab, 0xd6,
 DEFINE_GUID(IID_IResourceMap,            0x72284824, 0xdb8c, 0x42f8, 0xb0, 0x8c, 0x53, 0xff, 0x35, 0x7d, 0xad, 0x82);
 DEFINE_GUID(IID_IResourceCandidate,      0xaf5207d9, 0xc433, 0x4764, 0xb3, 0xfd, 0x8f, 0xa6, 0xbf, 0xbc, 0xba, 0xdc);
 DEFINE_GUID(IID_IResourceContext,        0x2fa22f4b, 0x707e, 0x4b27, 0xad, 0x0d, 0xd0, 0xd8, 0xcd, 0x46, 0x8f, 0xd2);
+DEFINE_GUID(IID_INamedResource,          0x1c98c219, 0x0b13, 0x4240, 0x89, 0xa5, 0xd4, 0x95, 0xdc, 0x18, 0x9a, 0x00);
+/* parameterized: IMapView<String, NamedResource>, IVectorView<ResourceCandidate> (their
+ * signatures' IIDs, the WinRT type system's rule) */
+DEFINE_GUID(IID_IMapView_NamedResource,  0x4825d6c4, 0x835a, 0x5da1, 0x9b, 0xdd, 0x12, 0xe9, 0x7e, 0x16, 0xfb, 0x7a);
+DEFINE_GUID(IID_IVectorView_Candidate,   0xe28e92f0, 0x9ffb, 0x5ea7, 0x9f, 0xc9, 0xa7, 0x3b, 0xda, 0x47, 0x18, 0x86);
 
 /* the ResourceLoader's lookup (resource_loader.c) */
 extern WCHAR *resource_lookup( const WCHAR *path );
@@ -50,11 +55,12 @@ extern WCHAR *resource_lookup( const WCHAR *path );
 
 /* ---- one object per instance: an IInspectable-shaped vtable and its interface ------------------ */
 
-enum kind { KIND_MANAGER, KIND_MAP, KIND_CANDIDATE, KIND_CONTEXT };
+enum kind { KIND_MANAGER, KIND_MAP, KIND_CANDIDATE, KIND_CONTEXT, KIND_NAMED, KIND_CANDIDATES };
 
 struct object
 {
     const void *vtbl;
+    const void *map_view_vtbl;    /* a map's IMapView<String, NamedResource> */
     LONG ref;
     enum kind kind;
     WCHAR *text;                  /* a map's path; a candidate's value */
@@ -68,6 +74,8 @@ static const IID *kind_iid( enum kind kind )
     case KIND_MAP: return &IID_IResourceMap;
     case KIND_CANDIDATE: return &IID_IResourceCandidate;
     case KIND_CONTEXT: return &IID_IResourceContext;
+    case KIND_NAMED: return &IID_INamedResource;
+    case KIND_CANDIDATES: return &IID_IVectorView_Candidate;
     }
     return &IID_IUnknown;
 }
@@ -80,6 +88,8 @@ static const WCHAR *kind_class( enum kind kind )
     case KIND_MAP: return L"Windows.ApplicationModel.Resources.Core.ResourceMap";
     case KIND_CANDIDATE: return L"Windows.ApplicationModel.Resources.Core.ResourceCandidate";
     case KIND_CONTEXT: return L"Windows.ApplicationModel.Resources.Core.ResourceContext";
+    case KIND_NAMED: return L"Windows.ApplicationModel.Resources.Core.NamedResource";
+    case KIND_CANDIDATES: return L"Windows.ApplicationModel.Resources.Core.ResourceCandidateVectorView";
     }
     return L"";
 }
@@ -93,6 +103,12 @@ static HRESULT WINAPI obj_QueryInterface( struct object *obj, REFIID iid, void *
         *out = obj;
         return S_OK;
     }
+    if (obj->map_view_vtbl && IsEqualGUID( iid, &IID_IMapView_NamedResource ))
+    {
+        InterlockedIncrement( &obj->ref );
+        *out = &obj->map_view_vtbl;
+        return S_OK;
+    }
     FIXME( "%s: %s not implemented, returning E_NOINTERFACE.\n", debugstr_w( kind_class( obj->kind ) ), debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
@@ -253,9 +269,198 @@ static const struct
     obj_notimpl1, map_GetValue, map_GetValueForContext, map_GetSubtree,
 };
 
+/* ---- ResourceCandidateVectorView: a named resource's candidates (one: the user's language's) -- */
+
+static HRESULT WINAPI candidates_GetAt( struct object *obj, UINT32 index, void **candidate )
+{
+    if (!candidate) return E_POINTER;
+    *candidate = NULL;
+    if (index) return E_BOUNDS;
+    return new_object( &candidate_vtbl, KIND_CANDIDATE, obj->text, candidate );
+}
+
+static HRESULT WINAPI candidates_get_Size( struct object *obj, UINT32 *size )
+{
+    if (!size) return E_POINTER;
+    *size = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI candidates_IndexOf( struct object *obj, void *candidate, UINT32 *index, boolean *found )
+{
+    struct object *other = candidate;
+
+    if (!index || !found) return E_POINTER;
+    *index = 0;
+    *found = other && other->vtbl == &candidate_vtbl && !wcscmp( other->text, obj->text );
+    return S_OK;
+}
+
+static HRESULT WINAPI candidates_GetMany( struct object *obj, UINT32 start, UINT32 size, void **items, UINT32 *count )
+{
+    HRESULT hr;
+
+    if (!count) return E_POINTER;
+    *count = 0;
+    if (start || !size) return S_OK;
+    if (!items) return E_POINTER;
+    if (FAILED(hr = candidates_GetAt( obj, 0, &items[0] ))) return hr;
+    *count = 1;
+    return S_OK;
+}
+
+static const struct
+{
+    void *base[6];
+    void *GetAt, *get_Size, *IndexOf, *GetMany;
+} candidates_vtbl =
+{
+    { INSPECTABLE_METHODS },
+    candidates_GetAt, candidates_get_Size, candidates_IndexOf, candidates_GetMany,
+};
+
+/* ---- NamedResource ------------------------------------------------------- */
+
+static HRESULT WINAPI named_Candidates( struct object *obj, void **candidates )
+{
+    return new_object( &candidates_vtbl, KIND_CANDIDATES, obj->text, candidates );
+}
+
+static HRESULT WINAPI named_Resolve( struct object *obj, void **candidate )
+{
+    return new_object( &candidate_vtbl, KIND_CANDIDATE, obj->text, candidate );
+}
+
+static HRESULT WINAPI named_ResolveForContext( struct object *obj, void *context, void **candidate )
+{
+    return named_Resolve( obj, candidate );
+}
+
+static HRESULT WINAPI named_ResolveAllForContext( struct object *obj, void *context, void **candidates )
+{
+    return named_Candidates( obj, candidates );
+}
+
+static const struct
+{
+    void *base[6];
+    void *Uri, *Candidates, *Resolve, *ResolveForContext, *ResolveAll, *ResolveAllForContext;
+} named_vtbl =
+{
+    { INSPECTABLE_METHODS },
+    obj_notimpl1, named_Candidates, named_Resolve, named_ResolveForContext, named_Candidates,
+    named_ResolveAllForContext,
+};
+
+/* ---- a map's IMapView<String, NamedResource> ------------------------------ */
+
+static struct object *impl_from_map_view( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct object, map_view_vtbl );
+}
+
+static HRESULT WINAPI map_view_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    return obj_QueryInterface( impl_from_map_view( iface ), iid, out );
+}
+
+static ULONG WINAPI map_view_AddRef( void *iface )
+{
+    return obj_AddRef( impl_from_map_view( iface ) );
+}
+
+static ULONG WINAPI map_view_Release( void *iface )
+{
+    return obj_Release( impl_from_map_view( iface ) );
+}
+
+static HRESULT WINAPI map_view_GetIids( void *iface, ULONG *count, IID **iids )
+{
+    return obj_GetIids( impl_from_map_view( iface ), count, iids );
+}
+
+static HRESULT WINAPI map_view_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    return obj_GetRuntimeClassName( impl_from_map_view( iface ), name );
+}
+
+static HRESULT WINAPI map_view_GetTrustLevel( void *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+/* the value of a key of the map, or NULL */
+static WCHAR *map_key_value( struct object *map, HSTRING key )
+{
+    WCHAR *path, *value;
+
+    if (!(path = map_path( map, WindowsGetStringRawBuffer( key, NULL ) ))) return NULL;
+    value = resource_lookup( path );
+    TRACE( "%s -> %s\n", debugstr_w( path ), debugstr_w( value ) );
+    free( path );
+#ifdef SG_MUTANT_RESMAP_NO_KEYS
+    free( value );
+    value = NULL;
+#endif
+    return value;
+}
+
+static HRESULT WINAPI map_view_Lookup( void *iface, HSTRING key, void **resource )
+{
+    WCHAR *value;
+    HRESULT hr;
+
+    if (!resource) return E_POINTER;
+    *resource = NULL;
+    if (!(value = map_key_value( impl_from_map_view( iface ), key ))) return E_BOUNDS;
+    hr = new_object( &named_vtbl, KIND_NAMED, value, resource );
+    free( value );
+    return hr;
+}
+
+static HRESULT WINAPI map_view_get_Size( void *iface, UINT32 *size )
+{
+    FIXME( "%p, %p: the count of a map's resources is not implemented\n", iface, size );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI map_view_HasKey( void *iface, HSTRING key, boolean *found )
+{
+    WCHAR *value;
+
+    if (!found) return E_POINTER;
+    value = map_key_value( impl_from_map_view( iface ), key );
+    *found = value != NULL;
+    free( value );
+    return S_OK;
+}
+
+static HRESULT WINAPI map_view_Split( void *iface, void **first, void **second )
+{
+    /* a map view need not split */
+    if (first) *first = NULL;
+    if (second) *second = NULL;
+    return S_OK;
+}
+
+static const struct
+{
+    void *base[6];
+    void *Lookup, *get_Size, *HasKey, *Split;
+} map_view_vtbl =
+{
+    { map_view_QueryInterface, map_view_AddRef, map_view_Release, map_view_GetIids, map_view_GetRuntimeClassName,
+      map_view_GetTrustLevel },
+    map_view_Lookup, map_view_get_Size, map_view_HasKey, map_view_Split,
+};
+
 static HRESULT make_map( const WCHAR *path, void **out )
 {
-    return new_object( &map_vtbl, KIND_MAP, path, out );
+    HRESULT hr = new_object( &map_vtbl, KIND_MAP, path, out );
+
+    if (SUCCEEDED(hr)) ((struct object *)*out)->map_view_vtbl = &map_view_vtbl;
+    return hr;
 }
 
 /* ---- ResourceContext (the default one) ----------------------------------- */
@@ -274,7 +479,7 @@ static const struct
 
 static HRESULT WINAPI manager_MainResourceMap( struct object *obj, void **map )
 {
-    return new_object( &map_vtbl, KIND_MAP, L"", map );
+    return make_map( L"", map );
 }
 
 static HRESULT WINAPI manager_DefaultContext( struct object *obj, void **context )
