From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 15:24:21 -0700
Subject: [PATCH] wpc: parental controls report that they are off

- GetVisibility says hidden; GetUserSettings, GetWebSettings and GetGamesSettings return settings objects
  that report no restrictions, no logging, no blocked downloads and no blocked games
- GetWebFilterInfo reports that no web filter exists (ERROR_NOT_FOUND) instead of E_NOTIMPL

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/wpc/tests/wpc.c b/dlls/wpc/tests/wpc.c
index 3dbf595..4130031 100644
--- a/dlls/wpc/tests/wpc.c
+++ b/dlls/wpc/tests/wpc.c
@@ -36,6 +36,53 @@ static void test_wpc(void)
     if(FAILED(hres))
         return;
 
+    {
+        WPCFLAG_VISIBILITY visibility = 99;
+        IWPCSettings *settings = NULL;
+        IWPCWebSettings *web = NULL;
+        IWPCGamesSettings *games = NULL;
+        DWORD value = 99;
+        BOOL flag = TRUE;
+        GUID id = { 1 };
+        WCHAR *name = (WCHAR *)1;
+
+        hres = IWindowsParentalControls_GetVisibility(wpc, &visibility);
+        ok(hres == S_OK && visibility == WPCFLAG_WPC_HIDDEN, "GetVisibility returned %08lx, %d\n", hres, visibility);
+        hres = IWindowsParentalControls_GetUserSettings(wpc, NULL, &settings);
+        ok(hres == E_INVALIDARG, "GetUserSettings returned %08lx\n", hres);
+        hres = IWindowsParentalControls_GetUserSettings(wpc, L"S-1-5-21-1-2-3-1000", &settings);
+        ok(hres == S_OK && settings, "GetUserSettings returned %08lx\n", hres);
+        if (settings)
+        {
+            hres = IWPCSettings_GetRestrictions(settings, &value);
+            ok(hres == S_OK && value == WPCFLAG_NO_RESTRICTION, "GetRestrictions returned %08lx, %lx\n", hres, value);
+            hres = IWPCSettings_IsLoggingRequired(settings, &flag);
+            ok(hres == S_OK && !flag, "IsLoggingRequired returned %08lx\n", hres);
+            IWPCSettings_Release(settings);
+        }
+        hres = IWindowsParentalControls_GetWebSettings(wpc, L"S-1-5-21-1-2-3-1000", &web);
+        ok(hres == S_OK && web, "GetWebSettings returned %08lx\n", hres);
+        if (web)
+        {
+            hres = IWPCWebSettings_GetSettings(web, &value);
+            ok(hres == S_OK && value == WPCFLAG_WEB_SETTING_NOTBLOCKED, "GetSettings returned %08lx\n", hres);
+            hres = IWPCWebSettings_QueryInterface(web, &IID_IWPCSettings, (void **)&settings);
+            ok(hres == S_OK, "QueryInterface returned %08lx\n", hres);
+            if (hres == S_OK) IWPCSettings_Release(settings);
+            IWPCWebSettings_Release(web);
+        }
+        hres = IWindowsParentalControls_GetGamesSettings(wpc, L"S-1-5-21-1-2-3-1000", &games);
+        ok(hres == S_OK && games, "GetGamesSettings returned %08lx\n", hres);
+        if (games)
+        {
+            hres = IWPCGamesSettings_IsBlocked(games, id, &value);
+            ok(hres == S_OK && !value, "IsBlocked returned %08lx, %lx\n", hres, value);
+            IWPCGamesSettings_Release(games);
+        }
+        hres = IWindowsParentalControls_GetWebFilterInfo(wpc, &id, &name);
+        ok(hres == HRESULT_FROM_WIN32(ERROR_NOT_FOUND), "GetWebFilterInfo returned %08lx\n", hres);
+    }
+
     IWindowsParentalControls_Release(wpc);
 }
 
diff --git a/dlls/wpc/wpc.c b/dlls/wpc/wpc.c
index bf63d4c..58481b2 100644
--- a/dlls/wpc/wpc.c
+++ b/dlls/wpc/wpc.c
@@ -38,7 +38,7 @@ static HRESULT WINAPI WindowsParentalControls_QueryInterface(IWindowsParentalCon
         TRACE("(IID_IWindowsParentalControls %p)\n", ppv);
         *ppv = iface;
     }else {
-        FIXME("unsupported iface %s\n", debugstr_guid(riid));
+        WARN("unsupported iface %s\n", debugstr_guid(riid));
         *ppv = NULL;
         return E_NOINTERFACE;
     }
@@ -57,34 +57,148 @@ static ULONG WINAPI WindowsParentalControls_Release(IWindowsParentalControls *if
     return 1;
 }
 
+/* Parental controls are never switched on: no user is restricted, nothing is logged or blocked. */
+#define WPC_NO_SETTINGS_QI(type_iid) \
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IWPCSettings) || IsEqualGUID(riid, &type_iid)) \
+    { \
+        *ppv = iface; \
+        IUnknown_AddRef((IUnknown *)iface); \
+        return S_OK; \
+    } \
+    WARN("unsupported iface %s\n", debugstr_guid(riid)); \
+    *ppv = NULL; \
+    return E_NOINTERFACE;
+
+static ULONG WINAPI WPCSettings_AddRef(IWPCSettings *iface) { return 2; }
+static ULONG WINAPI WPCSettings_Release(IWPCSettings *iface) { return 1; }
+
+static HRESULT WINAPI WPCSettings_IsLoggingRequired(IWPCSettings *iface, BOOL *required)
+{
+    TRACE("(%p)\n", required);
+    if (!required) return E_INVALIDARG;
+    *required = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI WPCSettings_GetLastSettingsChangeTime(IWPCSettings *iface, SYSTEMTIME *time)
+{
+    TRACE("(%p)\n", time);
+    if (!time) return E_INVALIDARG;
+    /* the settings never changed */
+    memset(time, 0, sizeof(*time));
+    return S_OK;
+}
+
+static HRESULT WINAPI WPCSettings_GetRestrictions(IWPCSettings *iface, DWORD *restrictions)
+{
+    TRACE("(%p)\n", restrictions);
+    if (!restrictions) return E_INVALIDARG;
+    *restrictions = 0; /* WPCFLAG_RESTRICTION_NO_RESTRICTION */
+    return S_OK;
+}
+
+static HRESULT WINAPI WPCSettings_QueryInterface(IWPCSettings *iface, REFIID riid, void **ppv)
+{
+    WPC_NO_SETTINGS_QI(IID_IWPCSettings)
+}
+
+static const IWPCSettingsVtbl WPCSettingsVtbl = {
+    WPCSettings_QueryInterface, WPCSettings_AddRef, WPCSettings_Release,
+    WPCSettings_IsLoggingRequired, WPCSettings_GetLastSettingsChangeTime, WPCSettings_GetRestrictions
+};
+static IWPCSettings wpc_settings = { &WPCSettingsVtbl };
+
+static HRESULT WINAPI WPCWebSettings_QueryInterface(IWPCWebSettings *iface, REFIID riid, void **ppv)
+{
+    WPC_NO_SETTINGS_QI(IID_IWPCWebSettings)
+}
+
+static HRESULT WINAPI WPCWebSettings_GetSettings(IWPCWebSettings *iface, DWORD *settings)
+{
+    TRACE("(%p)\n", settings);
+    if (!settings) return E_INVALIDARG;
+    *settings = WPCFLAG_WEB_SETTING_NOTBLOCKED;
+    return S_OK;
+}
+
+static HRESULT WINAPI WPCWebSettings_RequestURLOverride(IWPCWebSettings *iface, HWND hwnd, LPCWSTR url,
+        DWORD count, LPCWSTR *sub_urls, BOOL *changed)
+{
+    TRACE("(%p %s %lu %p %p)\n", hwnd, debugstr_w(url), count, sub_urls, changed);
+    if (!url || !changed) return E_INVALIDARG;
+    /* nothing is blocked, so there is nothing to override */
+    *changed = FALSE;
+    return S_OK;
+}
+
+static const IWPCWebSettingsVtbl WPCWebSettingsVtbl = {
+    (void *)WPCWebSettings_QueryInterface, (void *)WPCSettings_AddRef, (void *)WPCSettings_Release,
+    (void *)WPCSettings_IsLoggingRequired, (void *)WPCSettings_GetLastSettingsChangeTime,
+    (void *)WPCSettings_GetRestrictions, WPCWebSettings_GetSettings, WPCWebSettings_RequestURLOverride
+};
+static IWPCWebSettings wpc_web_settings = { &WPCWebSettingsVtbl };
+
+static HRESULT WINAPI WPCGamesSettings_QueryInterface(IWPCGamesSettings *iface, REFIID riid, void **ppv)
+{
+    WPC_NO_SETTINGS_QI(IID_IWPCGamesSettings)
+}
+
+static HRESULT WINAPI WPCGamesSettings_IsBlocked(IWPCGamesSettings *iface, GUID app_id, DWORD *reasons)
+{
+    TRACE("(%s %p)\n", debugstr_guid(&app_id), reasons);
+    if (!reasons) return E_INVALIDARG;
+    *reasons = 0; /* WPCFLAG_ISBLOCKED_NOTBLOCKED */
+    return S_OK;
+}
+
+static const IWPCGamesSettingsVtbl WPCGamesSettingsVtbl = {
+    (void *)WPCGamesSettings_QueryInterface, (void *)WPCSettings_AddRef, (void *)WPCSettings_Release,
+    (void *)WPCSettings_IsLoggingRequired, (void *)WPCSettings_GetLastSettingsChangeTime,
+    (void *)WPCSettings_GetRestrictions, WPCGamesSettings_IsBlocked
+};
+static IWPCGamesSettings wpc_games_settings = { &WPCGamesSettingsVtbl };
+
 static HRESULT WINAPI WindowsParentalControls_GetVisibility(IWindowsParentalControls *iface, WPCFLAG_VISIBILITY *visibility)
 {
-    FIXME("(%p)\n", visibility);
-    return E_NOTIMPL;
+    TRACE("(%p)\n", visibility);
+    if (!visibility) return E_INVALIDARG;
+    /* the feature is off, so it is not offered */
+    *visibility = WPCFLAG_WPC_HIDDEN;
+    return S_OK;
 }
 
 static HRESULT WINAPI WindowsParentalControls_GetUserSettings(IWindowsParentalControls *iface, const WCHAR *sid, IWPCSettings **settings)
 {
-    FIXME("(%s %p)\n", debugstr_w(sid), settings);
-    return E_NOTIMPL;
+    TRACE("(%s %p)\n", debugstr_w(sid), settings);
+    if (!sid || !settings) return E_INVALIDARG;
+    *settings = &wpc_settings;
+    return S_OK;
 }
 
 static HRESULT WINAPI WindowsParentalControls_GetWebSettings(IWindowsParentalControls *iface, const WCHAR *sid, IWPCWebSettings **settings)
 {
-    FIXME("(%s %p)\n", debugstr_w(sid), settings);
-    return E_NOTIMPL;
+    TRACE("(%s %p)\n", debugstr_w(sid), settings);
+    if (!sid || !settings) return E_INVALIDARG;
+    *settings = &wpc_web_settings;
+    return S_OK;
 }
 
 static HRESULT WINAPI WindowsParentalControls_GetWebFilterInfo(IWindowsParentalControls *iface, GUID *id, WCHAR **name)
 {
-    FIXME("(%p %p)\n", id, name);
-    return E_NOTIMPL;
+    TRACE("(%p %p)\n", id, name);
+    if (!id || !name) return E_INVALIDARG;
+    /* no web filter is installed */
+    memset(id, 0, sizeof(*id));
+    *name = NULL;
+    return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
 }
 
 static HRESULT WINAPI WindowsParentalControls_GetGamesSettings(IWindowsParentalControls *iface, const WCHAR *sid, IWPCGamesSettings **settings)
 {
-    FIXME("(%s %p)\n", debugstr_w(sid), settings);
-    return E_NOTIMPL;
+    TRACE("(%s %p)\n", debugstr_w(sid), settings);
+    if (!sid || !settings) return E_INVALIDARG;
+    *settings = &wpc_games_settings;
+    return S_OK;
 }
 
 static const IWindowsParentalControlsVtbl WindowsParentalControlsVtbl = {
@@ -124,7 +238,7 @@ static HRESULT WINAPI ClassFactory_QueryInterface(IClassFactory *iface, REFIID r
         return S_OK;
     }
 
-    FIXME("(%p)->(%s %p)\n", iface, debugstr_guid(riid), ppv);
+    WARN("(%p)->(%s %p)\n", iface, debugstr_guid(riid), ppv);
     return E_NOINTERFACE;
 }
 
@@ -166,6 +280,6 @@ HRESULT WINAPI DllGetClassObject(REFCLSID rclsid, REFIID riid, void **ppv)
         return IClassFactory_QueryInterface(&WPCFactory, riid, ppv);
     }
 
-    FIXME("Unknown object %s (iface %s)\n", debugstr_guid(rclsid), debugstr_guid(riid));
+    WARN("Unknown object %s (iface %s)\n", debugstr_guid(rclsid), debugstr_guid(riid));
     return CLASS_E_CLASSNOTAVAILABLE;
 }
