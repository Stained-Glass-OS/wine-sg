From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mciavi32: Signals, audio volume and on/off, video on/off, realize, cue.

MCI_SIGNAL positions are kept and posted, setaudio volume and on/off and
setvideo on/off work, realize and cue to a position are accepted. Status
reported the left channel as off when it was on.
---
 dlls/mciavi32/info.c           |   2 +-
 dlls/mciavi32/mciavi.c         | 142 +++++++++++++++++++++++++++++++++++++++--
 dlls/mciavi32/mmoutput.c       |   5 ++
 dlls/mciavi32/private_mciavi.h |  11 ++++
 4 files changed, 153 insertions(+), 7 deletions(-)

diff --git a/dlls/mciavi32/info.c b/dlls/mciavi32/info.c
index 286753f..2eb3320 100644
--- a/dlls/mciavi32/info.c
+++ b/dlls/mciavi32/info.c
@@ -311,7 +311,7 @@ DWORD	MCIAVI_mciSet(UINT wDevID, DWORD dwFlags, LPMCI_DGV_SET_PARMS lpParms)
 		break;
 	    case MCI_SET_AUDIO_LEFT:
 		szAudio = " audio left";
-		wma->dwSet &= ~2;
+		wma->dwSet &= ~1;
 		break;
 	    case MCI_SET_AUDIO_RIGHT:
 		szAudio = " audio right";
diff --git a/dlls/mciavi32/mciavi.c b/dlls/mciavi32/mciavi.c
index a62c791..8ec9580 100644
--- a/dlls/mciavi32/mciavi.c
+++ b/dlls/mciavi32/mciavi.c
@@ -87,6 +87,7 @@ static	DWORD	MCIAVI_drvOpen(LPCWSTR str, LPMCI_OPEN_DRIVER_PARMSW modp)
     wma->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": WINE_MCIAVI.cs");
     wma->hStopEvent = CreateEventW(NULL, FALSE, FALSE, NULL);
     wma->wDevID = modp->wDeviceID;
+    wma->volume = 1000;
     wma->wCommandTable = mciLoadCommandResource(MCIAVI_hInstance, L"MCIAVI", 0);
     wma->dwStatus = MCI_MODE_NOT_READY;
     modp->wCustomCommandTable = wma->wCommandTable;
@@ -392,6 +393,7 @@ static	DWORD	MCIAVI_player(WINE_MCIAVI *wma, DWORD dwFlags, LPMCI_PLAY_PARMS lpP
             while(next_frame_us <= tc && wma->dwCurrVideoFrame < wma->dwToVideoFrame){
                 double dur;
                 dur = MCIAVI_PaintFrame(wma, hDC);
+                MCIAVI_SendSignals(wma);
                 ++wma->dwCurrVideoFrame;
                 if(!dur)
                     break;
@@ -781,6 +783,25 @@ static	DWORD	MCIAVI_mciSeek(UINT wDevID, DWORD dwFlags, LPMCI_SEEK_PARMS lpParms
     return 0;
 }
 
+/* Posts MM_MCISIGNAL for the signals set at the frame being shown. */
+static void MCIAVI_SendSignals(WINE_MCIAVI *wma)
+{
+    DWORD frame = wma->dwCurrVideoFrame;
+    unsigned int i;
+
+    for (i = 0; i < wma->signal_count; ++i)
+    {
+        struct mciavi_signal *signal = &wma->signals[i];
+
+        if (frame < signal->position)
+            continue;
+        if (signal->period ? (frame - signal->position) % signal->period : frame != signal->position)
+            continue;
+        PostMessageW(signal->callback, MM_MCISIGNAL, wma->wDevID,
+                     signal->position_value ? frame : signal->user_value);
+    }
+}
+
 /*****************************************************************************
  * 				MCIAVI_mciLoad			[internal]
  */
@@ -788,13 +809,14 @@ static DWORD	MCIAVI_mciLoad(UINT wDevID, DWORD dwFlags, LPMCI_DGV_LOAD_PARMSW lp
 {
     WINE_MCIAVI *wma;
 
-    FIXME("(%04x, %08lx, %p) : stub\n", wDevID, dwFlags, lpParms);
+    TRACE("(%04x, %08lx, %p)\n", wDevID, dwFlags, lpParms);
 
     if (lpParms == NULL)	return MCIERR_NULL_PARAMETER_BLOCK;
 
     wma = MCIAVI_mciGetOpenDev(wDevID);
     if (wma == NULL)		return MCIERR_INVALID_DEVICE_ID;
 
+    /* a file is opened with MCI_OPEN, not loaded */
     return MCIERR_UNSUPPORTED_FUNCTION; /* like w2k */
 }
 
@@ -804,8 +826,9 @@ static DWORD	MCIAVI_mciLoad(UINT wDevID, DWORD dwFlags, LPMCI_DGV_LOAD_PARMSW lp
 static	DWORD	MCIAVI_mciRealize(UINT wDevID, DWORD dwFlags, LPMCI_GENERIC_PARMS lpParms)
 {
     WINE_MCIAVI *wma;
+    HDC hdc;
 
-    FIXME("(%04x, %08lx, %p) : stub\n", wDevID, dwFlags, lpParms);
+    TRACE("(%04x, %08lx, %p)\n", wDevID, dwFlags, lpParms);
 
     if (lpParms == NULL)	return MCIERR_NULL_PARAMETER_BLOCK;
 
@@ -813,6 +836,17 @@ static	DWORD	MCIAVI_mciRealize(UINT wDevID, DWORD dwFlags, LPMCI_GENERIC_PARMS l
     if (wma == NULL)		return MCIERR_INVALID_DEVICE_ID;
     if (dwFlags & MCI_TEST)	return 0;
 
+    /* frames are drawn as DIBs, the window's palette only needs realizing again */
+    EnterCriticalSection(&wma->cs);
+    if (wma->hWndPaint && (hdc = GetDC(wma->hWndPaint)))
+    {
+        RealizePalette(hdc);
+        ReleaseDC(wma->hWndPaint, hdc);
+    }
+    LeaveCriticalSection(&wma->cs);
+
+    if (dwFlags & MCI_NOTIFY)
+        mciDriverNotify(HWND_32(LOWORD(lpParms->dwCallback)), wDevID, MCI_NOTIFY_SUCCESSFUL);
     return 0;
 }
 
@@ -884,16 +918,34 @@ static	DWORD	MCIAVI_mciStep(UINT wDevID, DWORD dwFlags, LPMCI_DGV_STEP_PARMS lpP
 static	DWORD	MCIAVI_mciCue(UINT wDevID, DWORD dwFlags, LPMCI_DGV_CUE_PARMS lpParms)
 {
     WINE_MCIAVI *wma;
+    DWORD frame;
 
-    FIXME("(%04x, %08lx, %p) : stub\n", wDevID, dwFlags, lpParms);
+    TRACE("(%04x, %08lx, %p)\n", wDevID, dwFlags, lpParms);
 
     if (lpParms == NULL)	return MCIERR_NULL_PARAMETER_BLOCK;
 
     wma = MCIAVI_mciGetOpenDev(wDevID);
     if (wma == NULL)		return MCIERR_INVALID_DEVICE_ID;
     if (dwFlags & MCI_DGV_CUE_INPUT) return MCIERR_UNSUPPORTED_FUNCTION;
+
+    /* cueing for output: ready to play from the position asked for */
+    if (dwFlags & MCI_TO)
+    {
+        EnterCriticalSection(&wma->cs);
+        frame = MCIAVI_ConvertTimeFormatToFrame(wma, lpParms->dwTo);
+        LeaveCriticalSection(&wma->cs);
+        if (frame >= wma->dwPlayableVideoFrames) return MCIERR_OUTOFRANGE;
+        if (dwFlags & MCI_TEST)	return 0;
+
+        MCIAVI_mciStop(wDevID, MCI_WAIT, NULL);
+        EnterCriticalSection(&wma->cs);
+        wma->dwCurrVideoFrame = frame;
+        LeaveCriticalSection(&wma->cs);
+    }
     if (dwFlags & MCI_TEST)	return 0;
 
+    if (dwFlags & MCI_NOTIFY)
+        mciDriverNotify(HWND_32(LOWORD(lpParms->dwCallback)), wDevID, MCI_NOTIFY_SUCCESSFUL);
     return 0;
 }
 
@@ -927,14 +979,52 @@ static	DWORD	MCIAVI_mciBreak(UINT wDevID, DWORD dwFlags, LPMCI_BREAK_PARMS lpPar
 static	DWORD	MCIAVI_mciSetAudio(UINT wDevID, DWORD dwFlags, LPMCI_DGV_SETAUDIO_PARMSW lpParms)
 {
     WINE_MCIAVI *wma;
+    DWORD level;
 
     if (lpParms == NULL)	return MCIERR_NULL_PARAMETER_BLOCK;
 
-    FIXME("(%04x, %08lx, %p) Item %04lx: stub\n", wDevID, dwFlags, lpParms, dwFlags & MCI_DGV_SETAUDIO_ITEM ? lpParms->dwItem : 0);
+    TRACE("(%04x, %08lx, %p) Item %04lx\n", wDevID, dwFlags, lpParms, dwFlags & MCI_DGV_SETAUDIO_ITEM ? lpParms->dwItem : 0);
 
     wma = MCIAVI_mciGetOpenDev(wDevID);
     if (wma == NULL)		return MCIERR_INVALID_DEVICE_ID;
 
+    if (dwFlags & MCI_DGV_SETAUDIO_ITEM)
+    {
+        /* the audio is played through the wave mapper: only its volume can be set */
+        if (lpParms->dwItem != MCI_DGV_SETAUDIO_VOLUME)
+            return MCIERR_UNSUPPORTED_FUNCTION;
+        if (!(dwFlags & MCI_DGV_SETAUDIO_VALUE))
+            return MCIERR_MISSING_PARAMETER;
+        if (lpParms->dwValue > 1000)
+            return MCIERR_OUTOFRANGE;
+        if (dwFlags & MCI_TEST)
+            return 0;
+
+        EnterCriticalSection(&wma->cs);
+        wma->volume = lpParms->dwValue;
+        level = MulDiv(wma->volume, 0xffff, 1000);
+        if (wma->hWave)
+            waveOutSetVolume(wma->hWave, MAKELONG(level, level));
+        LeaveCriticalSection(&wma->cs);
+    }
+
+    /* audio on/off, like MCI_SET */
+    if (dwFlags & (MCI_SET_ON | MCI_SET_OFF))
+    {
+        DWORD channels = 3;
+
+        if (dwFlags & MCI_DGV_SETAUDIO_LEFT) channels = 1;
+        else if (dwFlags & MCI_DGV_SETAUDIO_RIGHT) channels = 2;
+        if (dwFlags & MCI_TEST)
+            return 0;
+        EnterCriticalSection(&wma->cs);
+        if (dwFlags & MCI_SET_ON) wma->dwSet |= channels;
+        else wma->dwSet &= ~channels;
+        LeaveCriticalSection(&wma->cs);
+    }
+
+    if (dwFlags & MCI_NOTIFY)
+        mciDriverNotify(HWND_32(LOWORD(lpParms->dwCallback)), wDevID, MCI_NOTIFY_SUCCESSFUL);
     return 0;
 }
 
@@ -944,13 +1034,36 @@ static	DWORD	MCIAVI_mciSetAudio(UINT wDevID, DWORD dwFlags, LPMCI_DGV_SETAUDIO_P
 static	DWORD	MCIAVI_mciSignal(UINT wDevID, DWORD dwFlags, LPMCI_DGV_SIGNAL_PARMS lpParms)
 {
     WINE_MCIAVI *wma;
+    struct mciavi_signal *signal;
 
-    FIXME("(%04x, %08lx, %p) : stub\n", wDevID, dwFlags, lpParms);
+    TRACE("(%04x, %08lx, %p)\n", wDevID, dwFlags, lpParms);
 
     if (lpParms == NULL)	return MCIERR_NULL_PARAMETER_BLOCK;
 
     wma = MCIAVI_mciGetOpenDev(wDevID);
     if (wma == NULL)		return MCIERR_INVALID_DEVICE_ID;
+    if (dwFlags & MCI_TEST)	return 0;
+
+    EnterCriticalSection(&wma->cs);
+    if (dwFlags & MCI_DGV_SIGNAL_CANCEL)
+        wma->signal_count = 0;
+    else if (wma->signal_count == ARRAY_SIZE(wma->signals))
+    {
+        LeaveCriticalSection(&wma->cs);
+        return MCIERR_OUT_OF_MEMORY;
+    }
+    else
+    {
+        /* MM_MCISIGNAL goes to the window given as callback when playback reaches the position */
+        signal = &wma->signals[wma->signal_count++];
+        signal->position = (dwFlags & MCI_DGV_SIGNAL_AT) ? MCIAVI_ConvertTimeFormatToFrame(wma, lpParms->dwPosition)
+                                                          : wma->dwCurrVideoFrame;
+        signal->period = (dwFlags & MCI_DGV_SIGNAL_EVERY) ? MCIAVI_ConvertTimeFormatToFrame(wma, lpParms->dwPeriod) : 0;
+        signal->user_value = (dwFlags & MCI_DGV_SIGNAL_USERVAL) ? lpParms->dwUserParm : 0;
+        signal->position_value = !!(dwFlags & MCI_DGV_SIGNAL_POSITION);
+        signal->callback = HWND_32(LOWORD(lpParms->dwCallback));
+    }
+    LeaveCriticalSection(&wma->cs);
 
     return 0;
 }
@@ -964,11 +1077,28 @@ static	DWORD	MCIAVI_mciSetVideo(UINT wDevID, DWORD dwFlags, LPMCI_DGV_SETVIDEO_P
 
     if (lpParms == NULL)	return MCIERR_NULL_PARAMETER_BLOCK;
 
-    FIXME("(%04x, %08lx, %p) Item %04lx: stub\n", wDevID, dwFlags, lpParms, dwFlags & MCI_DGV_SETVIDEO_ITEM ? lpParms->dwItem : 0);
+    TRACE("(%04x, %08lx, %p) Item %04lx\n", wDevID, dwFlags, lpParms, dwFlags & MCI_DGV_SETVIDEO_ITEM ? lpParms->dwItem : 0);
 
     wma = MCIAVI_mciGetOpenDev(wDevID);
     if (wma == NULL)		return MCIERR_INVALID_DEVICE_ID;
 
+    /* picture adjustments (brightness, colour, ...) need display hardware */
+    if (dwFlags & MCI_DGV_SETVIDEO_ITEM)
+        return MCIERR_UNSUPPORTED_FUNCTION;
+    if (dwFlags & MCI_TEST)
+        return 0;
+
+    /* video on/off, like MCI_SET */
+    if (dwFlags & (MCI_SET_ON | MCI_SET_OFF))
+    {
+        EnterCriticalSection(&wma->cs);
+        if (dwFlags & MCI_SET_ON) wma->dwSet |= 4;
+        else wma->dwSet &= ~4;
+        LeaveCriticalSection(&wma->cs);
+    }
+
+    if (dwFlags & MCI_NOTIFY)
+        mciDriverNotify(HWND_32(LOWORD(lpParms->dwCallback)), wDevID, MCI_NOTIFY_SUCCESSFUL);
     return 0;
 }
 
diff --git a/dlls/mciavi32/mmoutput.c b/dlls/mciavi32/mmoutput.c
index dd8f96e..ed15745 100644
--- a/dlls/mciavi32/mmoutput.c
+++ b/dlls/mciavi32/mmoutput.c
@@ -520,6 +520,11 @@ DWORD MCIAVI_OpenAudio(WINE_MCIAVI* wma, unsigned* nHdr, LPWAVEHDR* pWaveHdr)
 	wma->hWave = 0;
 	goto cleanUp;
     }
+    if (wma->volume != 1000)
+    {
+        DWORD level = MulDiv(wma->volume, 0xffff, 1000);
+        waveOutSetVolume(wma->hWave, MAKELONG(level, level));
+    }
 
     /* FIXME: should set up a heuristic to compute the number of wave headers
      * to be used...
diff --git a/dlls/mciavi32/private_mciavi.h b/dlls/mciavi32/private_mciavi.h
index 8068047..2d3404a 100644
--- a/dlls/mciavi32/private_mciavi.h
+++ b/dlls/mciavi32/private_mciavi.h
@@ -81,6 +81,17 @@ typedef struct {
         DWORD flags;
         MCI_BREAK_PARMS parms;
     } mci_break;
+    /* MCI_SIGNAL requests, in frames */
+    struct mciavi_signal
+    {
+        DWORD position;     /* first frame */
+        DWORD period;       /* 0: once */
+        DWORD user_value;
+        BOOL position_value;  /* report the position rather than the user value */
+        HWND callback;
+    } signals[16];
+    unsigned int signal_count;
+    DWORD volume;               /* MCI_DGV_SETAUDIO_VOLUME, 0..1000 */
     /* data for the background mechanism */
     CRITICAL_SECTION	cs;
     HANDLE              hStopEvent;
