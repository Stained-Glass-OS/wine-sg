+/* The flags a service provider is told about a group (the ones it was given
+ * when the group was created) */
+static DWORD DP_GroupSPFlags( IDirectPlayImpl *This, const struct GroupData *group )
+{
+    DWORD flags = 0;
+
+    if ( group == This->dp2->lpSysGroup )
+        flags |= DPLAYI_GROUP_SYSGROUP;
+    if ( group->dwFlags & DPGROUP_HIDDEN )
