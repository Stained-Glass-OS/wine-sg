+/* What is queued for a receiving player for a chat message: the message, a
+ * DPCHAT and its text. The text is kept as Unicode and converted for ANSI
+ * receivers. */
+struct DPChatCopy
+{
+    DPMSG_CHAT msg;
+    DPCHAT chat;
+};
+
+static DWORD DP_CopyChat( DPMSG_GENERIC *genericDst, DPMSG_GENERIC *genericSrc,
+                          DWORD genericSize, BOOL ansi )
+{
+    DPMSG_CHAT *src = (DPMSG_CHAT *) genericSrc;
+    DPMSG_CHAT *dst = (DPMSG_CHAT *) genericDst;
+    DWORD offset = sizeof( DPMSG_CHAT ) + sizeof( DPCHAT );
+    DPCHAT *chat;
+
+    if ( dst )
+    {
+        *dst = *src;
+        chat = (DPCHAT *)( dst + 1 );
+        *chat = *src->lpChat;
+        dst->lpChat = chat;
+    }
+
+    offset += DP_CopyString( dst ? &dst->lpChat->lpszMessageA : NULL,
+                             src->lpChat->lpszMessage, ansi, FALSE, genericDst, offset );
+
+    return offset;
+}
+
+/* Queues a chat message for the local players it is for. The lock is held. */
+HRESULT DP_DeliverChat( IDirectPlayImpl *This, DPID from, DPID to, DWORD flags,
+        const DPCHAT *chatmsg, BOOL ansi )
+{
+    struct DPChatCopy chat;
+    WCHAR *text;
+    HRESULT hr;
+
+    if ( !DP_FindPlayer( This, to ) && !DP_FindAnyGroup( This, to ) )
+        return DPERR_INVALIDPLAYER;
+
+    text = DP_DuplicateString( chatmsg->lpszMessage, FALSE, ansi );
+    if ( !text )
+        return DPERR_OUTOFMEMORY;
+
+    memset( &chat, 0, sizeof( chat ) );
+    chat.chat.dwSize      = sizeof( DPCHAT );
+    chat.chat.dwFlags     = 0;
+    chat.chat.lpszMessage = text;
+    chat.msg.dwType       = DPSYS_CHAT;
+    chat.msg.dwFlags      = flags;
+    chat.msg.idFromPlayer = from;
+    chat.msg.idToPlayer   = DP_FindPlayer( This, to ) ? to : 0;
+    chat.msg.idToGroup    = DP_FindPlayer( This, to ) ? 0 : to;
+    chat.msg.lpChat       = &chat.chat;
+
+#ifdef SG_MUTANT_DP4_CHAT
+    hr = DP_OK;
+#else
+    hr = DP_QueueMessage( This, DPID_SYSMSG, to, from, &chat.msg, DP_CopyChat, 0 );
+#endif
+
+    free( text );
+
+    return hr;
+}
+
+static HRESULT DP_SendChatMessage( IDirectPlayImpl *This, DPID from, DPID to, DWORD flags,
+        const DPCHAT *chatmsg, BOOL ansi )
+{
+    SPDATA_CHATMESSAGE spData;
+    lpPlayerList sender;
+    HRESULT hr;
+
+    TRACE( "(%p)->(0x%08lx,0x%08lx,0x%08lx,%p,%u)\n", This, from, to, flags, chatmsg, ansi );
+
+    if ( This->dp2->connectionInitialized == NO_PROVIDER )
+        return DPERR_UNINITIALIZED;
+
+    if ( !chatmsg || chatmsg->dwSize != sizeof( DPCHAT ) || chatmsg->dwFlags ||
+         !chatmsg->lpszMessage )
+        return DPERR_INVALIDPARAMS;
+
+    if ( flags & ~DPSEND_GUARANTEED )
+        return DPERR_INVALIDFLAGS;
+
+    EnterCriticalSection( &This->lock );
+
+    sender = DP_FindPlayer( This, from );
+    if ( !sender || !( sender->lpPData->dwFlags & DPLAYI_PLAYER_PLAYERLOCAL ) ||
+         ( sender->lpPData->dwFlags & DPLAYI_PLAYER_HIDDEN ) )
+    {
+        hr = DPERR_INVALIDPLAYER;
+        goto done;
+    }
+
+    if ( !DP_FindPlayer( This, to ) && !DP_FindAnyGroup( This, to ) )
+    {
+        hr = DPERR_INVALIDPLAYER;
+        goto done;
+    }
+
+    /* A lobby service provider carries the chat itself. Otherwise it is
+     * delivered to the local players: there is no wire format for it. */
+    if ( This->dp2->connectionInitialized == DP_LOBBY_PROVIDER &&
+         This->dp2->dplspData.lpCB->SendChatMessage )
+    {
+        spData.dwSize   = sizeof( spData );
+        spData.lpISP    = This->dp2->dplspData.lpISP;
+        spData.dwFromID = from;
+        spData.dwToID   = to;
+        spData.dwFlags  = flags;
+        spData.lpChat   = (DPCHAT *) chatmsg;
+
+        hr = This->dp2->dplspData.lpCB->SendChatMessage( &spData );
+    }
+    else
+        hr = DP_DeliverChat( This, from, to, flags, chatmsg, ansi );
+
+done:
+    LeaveCriticalSection( &This->lock );
+
+    return hr;
+}
