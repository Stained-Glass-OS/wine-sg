+/* Look for a session instance in the cache without touching the enumeration
+ * cursor (which an EnumSessions callback in progress is using). */
+BOOL NS_IsKnownSessionInstance( LPVOID lpNSInfo, const GUID *instance )
+{
+  lpNSCache cache = (lpNSCache)lpNSInfo;
+  lpNSCacheData data;
+
+  for( data = DPQ_FIRST( cache->first ); data; data = DPQ_NEXT( data->next ) )
+  {
+    if( IsEqualGUID( &data->data->guidInstance, instance ) )
+      return TRUE;
+  }
+
+  return FALSE;
+}
