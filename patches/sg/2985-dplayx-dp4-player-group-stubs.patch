+/* Called by the service provider when it has finished with an asynchronous
+ * send (result is the HRESULT of the send): the sending player is told by a
+ * DPSYS_SENDCOMPLETE message. Sends that are not waited for are ignored. */
+void DP_SendComplete( IDirectPlayImpl *This, void *msgid, DWORD result )
+{
+    struct DPPendingSend **link, *pending;
+    DPMSG_SENDCOMPLETE msg;
+
+    TRACE( "(%p)->(%p,0x%08lx)\n", This, msgid, result );
+
+#ifdef SG_MUTANT_DP4_SENDCOMPLETE
+    return;
+#endif
+
+    EnterCriticalSection( &This->lock );
+
+    for ( link = &This->dp2->pendingSends; ( pending = *link ); link = &pending->next )
+    {
+        if ( pending->msgid == (DWORD)(ULONG_PTR) msgid )
+            break;
+    }
+
+    if ( !pending )
+    {
+        LeaveCriticalSection( &This->lock );
+        return;
+    }
+
+    *link = pending->next;
+
+    msg.dwType      = DPSYS_SENDCOMPLETE;
+    msg.idFrom      = pending->from;
+    msg.idTo        = pending->to;
+    msg.dwFlags     = pending->flags;
+    msg.dwPriority  = pending->priority;
+    msg.dwTimeout   = pending->timeout;
+    msg.lpvContext  = pending->context;
+    msg.dwMsgID     = pending->msgid;
+    msg.hr          = result;
+    msg.dwSendTime  = GetTickCount() - pending->sendtime;
+
+    DP_QueueMessage( This, DPID_SYSMSG, pending->from, 0, &msg, DP_CopyGeneric, sizeof( msg ) );
+
+    LeaveCriticalSection( &This->lock );
+
+    free( pending );
+}
