+/* Checks shared by the public player and group enumeration methods. The
+ * enumerations work on the open session: without one nothing can be listed,
+ * and the players of a session that has only been seen in an EnumSessions
+ * reply cannot be listed either (that would take a request to its host). */
+static HRESULT DP_CheckEnumerate( IDirectPlayImpl *This, const GUID *instance, const void *callback,
+        DWORD flags )
+{
+    BOOL open, known = FALSE;
+    HRESULT hr = DP_OK;
+
+    if ( This->dp2->connectionInitialized == NO_PROVIDER )
+        return DPERR_UNINITIALIZED;
+
+    if ( !callback )
+        return DPERR_INVALIDPARAMS;
+
+    EnterCriticalSection( &This->lock );
+
+    open = This->dp2->bConnectionOpen;
+
+#ifdef SG_MUTANT_DP4_ENUM
+    open = TRUE;
+#endif
+
+    if ( !open )
+    {
+        if ( instance && ( flags & DPENUMPLAYERS_SESSION ) && This->dp2->lpNameServerData )
+            known = NS_IsKnownSessionInstance( This->dp2->lpNameServerData, instance );
+        hr = known ? DPERR_GENERIC : DPERR_NOSESSIONS;
+    }
+    else if ( flags & DPENUMPLAYERS_SESSION )
+    {
+        if ( !instance )
+            hr = DPERR_INVALIDPARAMS;
+        else if ( !This->dp2->lpSessionDesc ||
+                  !IsEqualGUID( instance, &This->dp2->lpSessionDesc->guidInstance ) )
+            hr = DPERR_GENERIC;
+    }
+
+    LeaveCriticalSection( &This->lock );
+
+    return hr;
+}
