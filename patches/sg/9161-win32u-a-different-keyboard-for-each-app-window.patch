From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: a different keyboard for each app window, as Windows' setting (9161)

Windows' "Let me use a different input method for each app window"
(Settings > Devices > Typing > Advanced keyboard settings) is
SystemParametersInfo SPI_GETTHREADLOCALINPUTSETTINGS /
SPI_SETTHREADLOCALINPUTSETTINGS, kept in the user's UserPreferencesMask
(byte 4, 0x80: the 0x1000 range's SPIs map to its bits in order, as
SPI_GETCLEARTYPE 0x1048 is byte 4's 0x10). Off -- the default -- the
keyboard is the person's whatever window they type in; on, a window
coming to the front brings its own layout back. Wine knew neither SPI.

- SPI_GET/SETTHREADLOCALINPUTSETTINGS (0x104E/0x104F), defined where used.
- sysparams: THREADLOCALINPUTSETTINGS as a UserPreferencesMask entry, read
  again on every query (Settings changes it from another process).
- set_active_window: with the setting on, a window of another thread coming
  to the front activates its thread's layout -- the one it last had, or the
  person's first for a thread that never switched -- and, the thread now
  owning the foreground window, the keyboard switches to it (the session's
  layouts are the display server's, 9156) and the indicator follows (9160).

Gate test/kbdperwindow-gate.sh (Xvfb, us,de, two programs). Mutant
SG_MUTANT_KBD_GLOBAL_ONLY.
---
 dlls/win32u/input.c     | 35 +++++++++++++++++++++++++++++++++++
 dlls/win32u/sysparams.c | 15 +++++++++++++++
 2 files changed, 50 insertions(+)

--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -2316,6 +2316,41 @@ BOOL set_active_window( HWND hwnd, HWND *prev, BOOL mouse, BOOL focus, DWORD new
 
     shell_activation_notify( hwnd );
 
+#ifndef SPI_GETTHREADLOCALINPUTSETTINGS
+#define SPI_GETTHREADLOCALINPUTSETTINGS 0x104E
+#endif
+#ifndef SG_MUTANT_KBD_GLOBAL_ONLY
+    /* Stained Glass OS (9161): "Let me use a different input method for each app window"
+     * (SPI_SETTHREADLOCALINPUTSETTINGS; off by default, when the input method is the person's,
+     * whatever window they type in): a window coming to the front brings its own -- the layout its
+     * thread last activated, or the person's first one for a thread that never did -- and the
+     * keyboard switches to it (the session's layouts are the display server's, 9156), with the
+     * input indicator */
+    if (hwnd && old_thread != new_thread && new_thread == GetCurrentThreadId() &&
+        hwnd == NtUserGetForegroundWindow())
+    {
+        BOOL local = FALSE;
+        HKL layout;
+
+        if (NtUserSystemParametersInfo( SPI_GETTHREADLOCALINPUTSETTINGS, 0, &local, 0 ) && local)
+        {
+            if ((layout = get_thread_kbd_layout( get_user_thread_info() )))
+            {
+                TRACE_(keyboard)( "%p comes to the front: its layout %p\n", hwnd, layout );
+                NtUserActivateKeyboardLayout( layout, 0 );
+            }
+            else if (NtUserGetKeyboardLayoutList( 1, &layout ) >= 1 && layout)
+            {
+                /* a thread that never switched types with the first: the keyboard goes there (the
+                 * driver knows whether it is there already), the thread keeps the keyboard's */
+                TRACE_(keyboard)( "%p comes to the front: the first layout %p\n", hwnd, layout );
+                user_driver->pActivateKeyboardLayout( layout, 0 );
+                tell_shell_language( layout );
+            }
+        }
+    }
+#endif
+
 done:
     if (hwnd) clip_fullscreen_window( hwnd, FALSE );
     return TRUE;
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -5935,6 +5935,13 @@ static USERPREF_ENTRY( DISABLEOVERLAPPEDCONTENT, 4, 0x01 );
 static USERPREF_ENTRY( CLIENTAREAANIMATION,      4, 0x02 );
 static USERPREF_ENTRY( CLEARTYPE,                4, 0x10 );
 static USERPREF_ENTRY( SPEECHRECOGNITION,        4, 0x20 );
+/* Stained Glass OS (9161): Settings' "Let me use a different input method for each app window"
+ * (SPI_GETTHREADLOCALINPUTSETTINGS: the 0x1000 range's bit 39, as the others) */
+#ifndef SPI_GETTHREADLOCALINPUTSETTINGS
+#define SPI_GETTHREADLOCALINPUTSETTINGS 0x104E
+#define SPI_SETTHREADLOCALINPUTSETTINGS 0x104F
+#endif
+static USERPREF_ENTRY( THREADLOCALINPUTSETTINGS, 4, 0x80 );
 
 /* System parameter indexes */
 enum spi_index
@@ -7251,6 +7258,14 @@ BOOL WINAPI NtUserSystemParametersInfo( UINT action, UINT val, void *ptr, UINT w
     case SPI_SETSPEECHRECOGNITION:
         ret = set_entry( &entry_SPEECHRECOGNITION, val, ptr, winini );
         break;
+    case SPI_GETTHREADLOCALINPUTSETTINGS:
+        /* another process may have changed it (Settings): read again */
+        entry_USERPREFERENCESMASK.hdr.loaded = FALSE;
+        ret = get_entry( &entry_THREADLOCALINPUTSETTINGS, val, ptr );
+        break;
+    case SPI_SETTHREADLOCALINPUTSETTINGS:
+        ret = set_entry( &entry_THREADLOCALINPUTSETTINGS, val, ptr, winini );
+        break;
     case SPI_GETFOREGROUNDLOCKTIMEOUT:
         ret = get_entry( &entry_FOREGROUNDLOCKTIMEOUT, val, ptr );
         break;
