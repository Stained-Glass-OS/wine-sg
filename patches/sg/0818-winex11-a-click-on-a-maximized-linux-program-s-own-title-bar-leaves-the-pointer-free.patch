From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: a click on a maximized Linux program's own title bar leaves the pointer free

A Linux program that draws its own title bar (SG Office) asks the window
manager to move its window when its title bar is pressed
(_NET_WM_MOVERESIZE). For a program in a Wine frame (0762, 0803) the
frame then grabs the pointer, so that Wine's move loop sees the button
come up, and Wine's loop lets the grab go when it ends. But Wine starts no
loop for a maximized window (it drags one out of being maximized only
with the button down as Wine knows it, and the press was the program's).
So a click on SG Office's title bar while it was maximized -- easy after
clicking its maximize button a few times, the restore button moving
from under the pointer -- left the pointer grabbed by the frame for good:
every click went to the frame, so the Start button, Task Manager and
every other window were dead (a click on them brought SG Office back),
the program's own buttons and menus too; the keyboard still worked, and
only Alt+F4 ended it (David 2026-10-05).

After the move or size it posts, the frame now posts itself a message
that lets go of its grab unless Wine's loop has taken the pointer over
(the thread's capture grab), in which case the loop lets it go as before.

Test: test/embedmaxgrab-gate.sh with test/embedmaxgrab-grabcheck.c and
test/ownframe-client.c (mutant SG_MUTANT_EMBED_MOVESIZE_GRAB_LEAK).
---
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -810,6 +810,29 @@
 #endif
         return ret;
     }
+    case WM_X11DRV_SG_EMBED_MOVESIZE_DONE:
+    {
+        /* Posted after the WM_SYSCOMMAND that a move or size the program asked
+         * for became (sg_embed_event), for whose loop the pointer was grabbed
+         * for the frame. Wine's loop, running, has the grab as its own (its
+         * capture: grab_hwnd) and lets it go when it ends; but no loop may
+         * have started -- the frame maximized: a click on SG Office's own
+         * title bar, maximized, asks to move it, Wine moves no maximized
+         * window and drags one out of being maximized only with the button
+         * down as Wine knows it, which it never saw (the press was the
+         * program's). Nothing let the grab go: every click went to the frame,
+         * the Start button and every other window dead, the program's own
+         * title bar and menus too, the keyboard fine -- until Alt+F4 closed it
+         * (David 2026-10-05). It is let go here. */
+        struct x11drv_thread_data *thread_data = x11drv_thread_data();
+        if (thread_data && thread_data->display && !thread_data->grab_hwnd)
+        {
+            TRACE( "%p: no move/size loop took the pointer: let go\n", hwnd );
+            XUngrabPointer( thread_data->display, CurrentTime );
+            XFlush( thread_data->display );
+        }
+        return 0;
+    }
     }
 
     pthread_mutex_lock( &embed_mutex );
@@ -1097,6 +1120,11 @@
                     TRACE( "move/size %ld: pointer grab %d\n", dir, st );
                     if (dir == 8) NtUserPostMessage( hwnd, WM_SYSCOMMAND, SC_MOVE | HTCAPTION, 0 );
                     else NtUserPostMessage( hwnd, WM_SYSCOMMAND, SC_SIZE | size_edge[dir], 0 );
+#ifndef SG_MUTANT_EMBED_MOVESIZE_GRAB_LEAK
+                    /* and after it, our grab let go should Wine's loop not
+                     * have taken it over (sg_embed_message) */
+                    NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_MOVESIZE_DONE, 0, 0 );
+#endif
                 }
                 else TRACE( "move/size %ld asked with no button down: not started\n", dir );
             }
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3684,6 +3684,7 @@
     case WM_X11DRV_SG_EMBED_FULLSCREEN:
     case WM_X11DRV_SG_EMBED_MAXIMIZE:
     case WM_X11DRV_SG_EMBED_FOCUS:
+    case WM_X11DRV_SG_EMBED_MOVESIZE_DONE:
         return sg_embed_message( hwnd, msg, wp, lp );
     default:
         FIXME( "got window msg %x hwnd %p wp %lx lp %lx\n", msg, hwnd, (long)wp, lp );
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -619,7 +619,8 @@
     WM_X11DRV_SG_EMBED_SIZE,
     WM_X11DRV_SG_EMBED_FULLSCREEN,
     WM_X11DRV_SG_EMBED_MAXIMIZE,
-    WM_X11DRV_SG_EMBED_FOCUS
+    WM_X11DRV_SG_EMBED_FOCUS,
+    WM_X11DRV_SG_EMBED_MOVESIZE_DONE
 };
 
 /* _NET_WM_STATE properties that we keep track of */
