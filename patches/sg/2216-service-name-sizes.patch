-    todo_wine ok(displaysize == 2, "Service size expected 2, got %ld\n", displaysize);
+    ok(displaysize == 2, "Service size expected 2, got %ld\n", displaysize);
     ok(displayname[0] == 0, "Service name not empty\n");
 
