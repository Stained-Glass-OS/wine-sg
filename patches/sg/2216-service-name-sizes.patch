From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: GetServiceDisplayNameA/GetServiceKeyNameA size on failure

GetServiceDisplayNameA and GetServiceKeyNameA doubled the size on every
failure.  As Wine's conformance test (todo_wine) records from Windows, only
a too-small buffer gets an upper estimate; for any other failure the size is
left as it was, but never below 1, and is 1 when there is no buffer.  The
matching todo_wine marks are removed.

---
--- a/dlls/advapi32/service.c
+++ b/dlls/advapi32/service.c
@@ -302,9 +302,14 @@ BOOL WINAPI GetServiceKeyNameA( SC_HANDLE hSCManager, LPCSTR lpDisplayName,
     sizeW = *lpcchBuffer;
     if (!GetServiceKeyNameW(hSCManager, lpDisplayNameW, lpServiceNameW, &sizeW))
     {
+        DWORD err = GetLastError();
+
         if (lpServiceName && *lpcchBuffer)
             lpServiceName[0] = 0;
-        *lpcchBuffer = sizeW*2;  /* we can only provide an upper estimation of string length */
+        if (err == ERROR_INSUFFICIENT_BUFFER)
+            *lpcchBuffer = sizeW*2;  /* we can only provide an upper estimation of string length */
+        else if (!lpServiceName || !*lpcchBuffer)
+            *lpcchBuffer = 1;        /* any other failure: the size is left as it was, but never below 1 */
         goto cleanup;
     }
 
@@ -414,9 +419,19 @@ BOOL WINAPI GetServiceDisplayNameA( SC_HANDLE hSCManager, LPCSTR lpServiceName,
     sizeW = *lpcchBuffer;
     if (!GetServiceDisplayNameW(hSCManager, lpServiceNameW, lpDisplayNameW, &sizeW))
     {
+        DWORD err = GetLastError();
+
         if (lpDisplayName && *lpcchBuffer)
             lpDisplayName[0] = 0;
-        *lpcchBuffer = sizeW*2;  /* we can only provide an upper estimation of string length */
+#ifdef SG_MUTANT_SVCNAME_OLD
+        *lpcchBuffer = sizeW*2;
+        (void)err;
+#else
+        if (err == ERROR_INSUFFICIENT_BUFFER)
+            *lpcchBuffer = sizeW*2;  /* we can only provide an upper estimation of string length */
+        else if (!lpDisplayName || !*lpcchBuffer)
+            *lpcchBuffer = 1;        /* any other failure: the size is left as it was, but never below 1 */
+#endif
         goto cleanup;
     }
 
