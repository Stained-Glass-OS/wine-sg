-    todo_wine ok(displaysize == 15, "Service size expected 15, got %ld\n", displaysize);
+    ok(displaysize == 15, "Service size expected 15, got %ld\n", displaysize);
     ok(displayname[0] == 0, "Service name not empty\n");
 
