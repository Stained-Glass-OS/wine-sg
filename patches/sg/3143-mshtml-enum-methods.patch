From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 02:01:36 -0700
Subject: [PATCH] mshtml: DOM methods are enumerable

for-in over an IE DOM object lists its methods (getBoundingClientRect,
appendChild, ...), except those of Storage. Method properties of host objects
now carry the enumerable flag; Storage keeps them hidden as before.

Removes the todo_wine for enumerating getBoundingClientRect in es5.js.

diff --git a/dlls/mshtml/dispex.c b/dlls/mshtml/dispex.c
index 77eec04..7a2fe49 100644
--- a/dlls/mshtml/dispex.c
+++ b/dlls/mshtml/dispex.c
@@ -2595,6 +2595,11 @@ static HRESULT get_host_property_descriptor(DispatchEx *This, DISPID id, struct
         if(func->func_disp_idx >= 0) {
             desc->iid = func->tid;
             desc->flags |= PROPF_METHOD | PROPF_WRITABLE;
+            /* IE lists the methods of its DOM objects when enumerating, except those of Storage */
+#ifndef SG_MUTANT_MSHTML_NOENUMMETH
+            if(func->tid != IHTMLStorage_tid)
+                desc->flags |= PROPF_ENUMERABLE;
+#endif
         }else {
             if(func->func_disp_idx == -1)
                 desc->flags |= PROPF_ENUMERABLE;
diff --git a/dlls/mshtml/tests/es5.js b/dlls/mshtml/tests/es5.js
index 634cc51..273cd45 100644
--- a/dlls/mshtml/tests/es5.js
+++ b/dlls/mshtml/tests/es5.js
@@ -2980,7 +2980,6 @@ sync_test("prototypes_delete", function() {
             r = name in obj;
             ok(r === has_prop, name + " in " + obj + " returned " + r);
             r = check_enum(obj, name);
-            todo_wine_if(todo_enum).
             ok(r === has_enum, "enumerating " + name + " in " + obj + "returned " + r);
         }
 
