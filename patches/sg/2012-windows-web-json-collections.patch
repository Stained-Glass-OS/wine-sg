+/* ---- iterators and key/value pairs ---- */
+
+struct json_kvp
+{
+    IKeyValuePair_HSTRING_IJsonValue IKeyValuePair_iface;
+    LONG ref;
+    HSTRING key;
+    IJsonValue *value;
+};
+
+static inline struct json_kvp *impl_from_IKeyValuePair( IKeyValuePair_HSTRING_IJsonValue *iface )
+{
+    return CONTAINING_RECORD( iface, struct json_kvp, IKeyValuePair_iface );
+}
+
+static HRESULT WINAPI kvp_QueryInterface( IKeyValuePair_HSTRING_IJsonValue *iface, REFIID iid, void **out )
+{
+    struct json_kvp *impl = impl_from_IKeyValuePair( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IKeyValuePair_HSTRING_IJsonValue ))
+    {
+        *out = &impl->IKeyValuePair_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI kvp_AddRef( IKeyValuePair_HSTRING_IJsonValue *iface )
+{
+    return InterlockedIncrement( &impl_from_IKeyValuePair( iface )->ref );
+}
+
+static ULONG WINAPI kvp_Release( IKeyValuePair_HSTRING_IJsonValue *iface )
+{
+    struct json_kvp *impl = impl_from_IKeyValuePair( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->key );
+        IJsonValue_Release( impl->value );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI kvp_GetIids( IKeyValuePair_HSTRING_IJsonValue *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI kvp_GetRuntimeClassName( IKeyValuePair_HSTRING_IJsonValue *iface, HSTRING *name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI kvp_GetTrustLevel( IKeyValuePair_HSTRING_IJsonValue *iface, TrustLevel *trust )
+{
+    if (!trust) return E_POINTER;
+    *trust = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI kvp_get_Key( IKeyValuePair_HSTRING_IJsonValue *iface, HSTRING *key )
+{
+    if (!key) return E_POINTER;
+    return WindowsDuplicateString( impl_from_IKeyValuePair( iface )->key, key );
+}
+
+static HRESULT WINAPI kvp_get_Value( IKeyValuePair_HSTRING_IJsonValue *iface, IJsonValue **value )
+{
+    struct json_kvp *impl = impl_from_IKeyValuePair( iface );
+
+    if (!value) return E_POINTER;
+    *value = impl->value;
+    IJsonValue_AddRef( *value );
+    return S_OK;
+}
+
+static const IKeyValuePair_HSTRING_IJsonValueVtbl kvp_vtbl =
+{
+    kvp_QueryInterface,
+    kvp_AddRef,
+    kvp_Release,
+    kvp_GetIids,
+    kvp_GetRuntimeClassName,
+    kvp_GetTrustLevel,
+    kvp_get_Key,
+    kvp_get_Value,
+};
+
+static HRESULT kvp_create( HSTRING key, IJsonValue *value, IKeyValuePair_HSTRING_IJsonValue **out )
+{
+    struct json_kvp *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IKeyValuePair_iface.lpVtbl = &kvp_vtbl;
+    impl->ref = 1;
+    if (FAILED(hr = WindowsDuplicateString( key, &impl->key ))) { free( impl ); return hr; }
+    impl->value = value;
+    IJsonValue_AddRef( value );
+    *out = &impl->IKeyValuePair_iface;
+    return S_OK;
+}
+
+/* one iterator type for both: the values of an array or the pairs of an object */
+struct json_iter
+{
+    IIterator_IJsonValue IIterator_iface;
+    IIterator_IKeyValuePair_HSTRING_IJsonValue IPairIterator_iface;
+    LONG ref;
+    struct json_value *parent;
+    ULONG pos, version;
+    BOOL pairs;
+};
+
+static inline struct json_iter *iter_from_values( IIterator_IJsonValue *iface )
+{
+    return CONTAINING_RECORD( iface, struct json_iter, IIterator_iface );
+}
+
+static inline struct json_iter *iter_from_pairs( IIterator_IKeyValuePair_HSTRING_IJsonValue *iface )
+{
+    return CONTAINING_RECORD( iface, struct json_iter, IPairIterator_iface );
+}
+
+static HRESULT iter_qi( struct json_iter *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = impl->pairs ? (void *)&impl->IPairIterator_iface : (void *)&impl->IIterator_iface;
+    else if (!impl->pairs && IsEqualGUID( iid, &IID_IIterator_IJsonValue )) *out = &impl->IIterator_iface;
+    else if (impl->pairs && IsEqualGUID( iid, &IID_IIterator_IKeyValuePair_HSTRING_IJsonValue )) *out = &impl->IPairIterator_iface;
+    else { *out = NULL; return E_NOINTERFACE; }
+    IInspectable_AddRef( *out );
+    return S_OK;
+}
+
+static ULONG iter_release( struct json_iter *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        IJsonValue_Release( &impl->parent->IJsonValue_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT iter_check( struct json_iter *impl )
+{
+#ifdef SG_MUTANT_ITER_NOCHECK
+    return S_OK;
+#endif
+    return impl->version == impl->parent->version ? S_OK : E_CHANGED_STATE;
+}
+
+static HRESULT iter_has_current( struct json_iter *impl, boolean *value )
+{
+    HRESULT hr;
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    if (FAILED(hr = iter_check( impl ))) return hr;
+    *value = impl->pos < impl->parent->count;
+    return S_OK;
+}
+
+static HRESULT iter_move_next( struct json_iter *impl, boolean *value )
+{
+    HRESULT hr;
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    if (FAILED(hr = iter_check( impl ))) return hr;
+    if (impl->pos < impl->parent->count) impl->pos++;
+    *value = impl->pos < impl->parent->count;
+    return S_OK;
+}
+
+static HRESULT iter_value_at( struct json_iter *impl, ULONG pos, IJsonValue **value )
+{
+    *value = impl->parent->items[pos];
+    IJsonValue_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT iter_pair_at( struct json_iter *impl, ULONG pos, IKeyValuePair_HSTRING_IJsonValue **pair )
+{
+    return kvp_create( impl->parent->members[pos].name, impl->parent->members[pos].value, pair );
+}
+
+static HRESULT WINAPI iter_values_QueryInterface( IIterator_IJsonValue *iface, REFIID iid, void **out )
+{
+    return iter_qi( iter_from_values( iface ), iid, out );
+}
+static ULONG WINAPI iter_values_AddRef( IIterator_IJsonValue *iface )
+{
+    return InterlockedIncrement( &iter_from_values( iface )->ref );
+}
+static ULONG WINAPI iter_values_Release( IIterator_IJsonValue *iface )
+{
+    return iter_release( iter_from_values( iface ) );
+}
+static HRESULT WINAPI iter_values_GetIids( IIterator_IJsonValue *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI iter_values_GetRuntimeClassName( IIterator_IJsonValue *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI iter_values_GetTrustLevel( IIterator_IJsonValue *iface, TrustLevel *trust )
+{
+    if (!trust) return E_POINTER;
+    *trust = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI iter_values_get_Current( IIterator_IJsonValue *iface, IJsonValue **value )
+{
+    struct json_iter *impl = iter_from_values( iface );
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = iter_check( impl ))) return hr;
+    if (impl->pos >= impl->parent->count) return E_BOUNDS;
+    return iter_value_at( impl, impl->pos, value );
+}
+
+static HRESULT WINAPI iter_values_get_HasCurrent( IIterator_IJsonValue *iface, boolean *value )
+{
+    return iter_has_current( iter_from_values( iface ), value );
+}
+
+static HRESULT WINAPI iter_values_MoveNext( IIterator_IJsonValue *iface, boolean *value )
+{
+    return iter_move_next( iter_from_values( iface ), value );
+}
+
+static HRESULT WINAPI iter_values_GetMany( IIterator_IJsonValue *iface, UINT32 capacity, IJsonValue **items, UINT32 *actual )
+{
+    struct json_iter *impl = iter_from_values( iface );
+    UINT32 n = 0;
+    HRESULT hr;
+
+    if (!actual) return E_POINTER;
+    *actual = 0;
+    if (FAILED(hr = iter_check( impl ))) return hr;
+    if (capacity && !items) return E_POINTER;
+    while (n < capacity && impl->pos < impl->parent->count)
+    {
+        iter_value_at( impl, impl->pos++, &items[n++] );
+    }
+    *actual = n;
+    return S_OK;
+}
+
+static const IIterator_IJsonValueVtbl iter_values_vtbl =
+{
+    iter_values_QueryInterface,
+    iter_values_AddRef,
+    iter_values_Release,
+    iter_values_GetIids,
+    iter_values_GetRuntimeClassName,
+    iter_values_GetTrustLevel,
+    iter_values_get_Current,
+    iter_values_get_HasCurrent,
+    iter_values_MoveNext,
+    iter_values_GetMany,
+};
+
+static HRESULT WINAPI iter_pairs_QueryInterface( IIterator_IKeyValuePair_HSTRING_IJsonValue *iface, REFIID iid, void **out )
+{
+    return iter_qi( iter_from_pairs( iface ), iid, out );
+}
+static ULONG WINAPI iter_pairs_AddRef( IIterator_IKeyValuePair_HSTRING_IJsonValue *iface )
+{
+    return InterlockedIncrement( &iter_from_pairs( iface )->ref );
+}
+static ULONG WINAPI iter_pairs_Release( IIterator_IKeyValuePair_HSTRING_IJsonValue *iface )
+{
+    return iter_release( iter_from_pairs( iface ) );
+}
+static HRESULT WINAPI iter_pairs_GetIids( IIterator_IKeyValuePair_HSTRING_IJsonValue *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI iter_pairs_GetRuntimeClassName( IIterator_IKeyValuePair_HSTRING_IJsonValue *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI iter_pairs_GetTrustLevel( IIterator_IKeyValuePair_HSTRING_IJsonValue *iface, TrustLevel *trust )
+{
+    if (!trust) return E_POINTER;
+    *trust = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI iter_pairs_get_Current( IIterator_IKeyValuePair_HSTRING_IJsonValue *iface, IKeyValuePair_HSTRING_IJsonValue **value )
+{
+    struct json_iter *impl = iter_from_pairs( iface );
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = iter_check( impl ))) return hr;
+    if (impl->pos >= impl->parent->count) return E_BOUNDS;
+    return iter_pair_at( impl, impl->pos, value );
+}
+
+static HRESULT WINAPI iter_pairs_get_HasCurrent( IIterator_IKeyValuePair_HSTRING_IJsonValue *iface, boolean *value )
+{
+    return iter_has_current( iter_from_pairs( iface ), value );
+}
+
+static HRESULT WINAPI iter_pairs_MoveNext( IIterator_IKeyValuePair_HSTRING_IJsonValue *iface, boolean *value )
+{
+    return iter_move_next( iter_from_pairs( iface ), value );
+}
+
+static HRESULT WINAPI iter_pairs_GetMany( IIterator_IKeyValuePair_HSTRING_IJsonValue *iface, UINT32 capacity,
+                                          IKeyValuePair_HSTRING_IJsonValue **items, UINT32 *actual )
+{
+    struct json_iter *impl = iter_from_pairs( iface );
+    UINT32 n = 0;
+    HRESULT hr;
+
+    if (!actual) return E_POINTER;
+    *actual = 0;
+    if (FAILED(hr = iter_check( impl ))) return hr;
+    if (capacity && !items) return E_POINTER;
+    while (n < capacity && impl->pos < impl->parent->count)
+    {
+        if (FAILED(hr = iter_pair_at( impl, impl->pos, &items[n] )))
+        {
+            while (n) IKeyValuePair_HSTRING_IJsonValue_Release( items[--n] );
+            return hr;
+        }
+        impl->pos++;
+        n++;
+    }
+    *actual = n;
+    return S_OK;
+}
+
+static const IIterator_IKeyValuePair_HSTRING_IJsonValueVtbl iter_pairs_vtbl =
+{
+    iter_pairs_QueryInterface,
+    iter_pairs_AddRef,
+    iter_pairs_Release,
+    iter_pairs_GetIids,
+    iter_pairs_GetRuntimeClassName,
+    iter_pairs_GetTrustLevel,
+    iter_pairs_get_Current,
+    iter_pairs_get_HasCurrent,
+    iter_pairs_MoveNext,
+    iter_pairs_GetMany,
+};
+
+static struct json_iter *iter_create( struct json_value *parent, BOOL pairs )
+{
+    struct json_iter *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->IIterator_iface.lpVtbl = &iter_values_vtbl;
+    impl->IPairIterator_iface.lpVtbl = &iter_pairs_vtbl;
+    impl->ref = 1;
+    impl->parent = parent;
+    IJsonValue_AddRef( &parent->IJsonValue_iface );
+    impl->version = parent->version;
+    impl->pairs = pairs;
+    return impl;
+}
+
+/* ---- IIterable ---- */
+
+DEFINE_IINSPECTABLE( json_iterable_array, IIterable_IJsonValue, struct json_value, IJsonValue_iface )
+
+static HRESULT WINAPI json_iterable_array_First( IIterable_IJsonValue *iface, IIterator_IJsonValue **value )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IIterable_IJsonValue_iface );
+    struct json_iter *iter;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (!(iter = iter_create( impl, FALSE ))) return E_OUTOFMEMORY;
+    *value = &iter->IIterator_iface;
+    return S_OK;
+}
+
+static const IIterable_IJsonValueVtbl json_iterable_array_vtbl =
+{
+    json_iterable_array_QueryInterface,
+    json_iterable_array_AddRef,
+    json_iterable_array_Release,
+    json_iterable_array_GetIids,
+    json_iterable_array_GetRuntimeClassName,
+    json_iterable_array_GetTrustLevel,
+    json_iterable_array_First,
+};
+
+DEFINE_IINSPECTABLE( json_iterable_map, IIterable_IKeyValuePair_HSTRING_IJsonValue, struct json_value, IJsonValue_iface )
+
+static HRESULT WINAPI json_iterable_map_First( IIterable_IKeyValuePair_HSTRING_IJsonValue *iface,
+                                               IIterator_IKeyValuePair_HSTRING_IJsonValue **value )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IIterable_IKeyValuePair_HSTRING_IJsonValue_iface );
+    struct json_iter *iter;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (!(iter = iter_create( impl, TRUE ))) return E_OUTOFMEMORY;
+    *value = &iter->IPairIterator_iface;
+    return S_OK;
+}
+
+static const IIterable_IKeyValuePair_HSTRING_IJsonValueVtbl json_iterable_map_vtbl =
+{
+    json_iterable_map_QueryInterface,
+    json_iterable_map_AddRef,
+    json_iterable_map_Release,
+    json_iterable_map_GetIids,
+    json_iterable_map_GetRuntimeClassName,
+    json_iterable_map_GetTrustLevel,
+    json_iterable_map_First,
+};
+
+/* ---- IVector<IJsonValue> ---- */
+
+DEFINE_IINSPECTABLE( json_vector, IVector_IJsonValue, struct json_value, IJsonValue_iface )
+
+static HRESULT WINAPI json_vector_GetAt( IVector_IJsonValue *iface, UINT32 index, IJsonValue **value )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IVector_IJsonValue_iface );
+
+    TRACE( "iface %p, index %u, value %p.\n", iface, index, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (index >= impl->count) return E_BOUNDS;
+    *value = impl->items[index];
+    IJsonValue_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI json_vector_get_Size( IVector_IJsonValue *iface, UINT32 *value )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IVector_IJsonValue_iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = impl->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI json_vector_GetView( IVector_IJsonValue *iface, IVectorView_IJsonValue **value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI json_vector_IndexOf( IVector_IJsonValue *iface, IJsonValue *value, UINT32 *index, boolean *found )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IVector_IJsonValue_iface );
+    UINT32 i;
+
+    TRACE( "iface %p, value %p, index %p, found %p.\n", iface, value, index, found );
+
+    if (!index || !found) return E_POINTER;
+    *index = 0;
+    *found = FALSE;
+    for (i = 0; i < impl->count; i++)
+    {
+        if (impl->items[i] != value) continue;
+        *index = i;
+        *found = TRUE;
+        break;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI json_vector_SetAt( IVector_IJsonValue *iface, UINT32 index, IJsonValue *value )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IVector_IJsonValue_iface );
+
+    TRACE( "iface %p, index %u, value %p.\n", iface, index, value );
+
+    if (!value) return E_POINTER;
+    if (index >= impl->count) return E_BOUNDS;
+    IJsonValue_AddRef( value );
+    IJsonValue_Release( impl->items[index] );
+    impl->items[index] = value;
+    impl->version++;
+    return S_OK;
+}
+
+static HRESULT WINAPI json_vector_InsertAt( IVector_IJsonValue *iface, UINT32 index, IJsonValue *value )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IVector_IJsonValue_iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, index %u, value %p.\n", iface, index, value );
+
+    if (!value) return E_POINTER;
+    if (index > impl->count) return E_BOUNDS;
+    if (FAILED(hr = json_add_item( impl, value ))) return hr;
+    /* the new item went to the end: move it into place */
+#ifdef SG_MUTANT_INSERT_APPEND
+    return S_OK;
+#endif
+    memmove( impl->items + index + 1, impl->items + index, (impl->count - 1 - index) * sizeof(*impl->items) );
+    impl->items[index] = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI json_vector_RemoveAt( IVector_IJsonValue *iface, UINT32 index )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IVector_IJsonValue_iface );
+
+    TRACE( "iface %p, index %u.\n", iface, index );
+
+    if (index >= impl->count) return E_BOUNDS;
+    IJsonValue_Release( impl->items[index] );
+    memmove( impl->items + index, impl->items + index + 1, (impl->count - index - 1) * sizeof(*impl->items) );
+    impl->count--;
+    impl->version++;
+    return S_OK;
+}
+
+static HRESULT WINAPI json_vector_Append( IVector_IJsonValue *iface, IJsonValue *value )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IVector_IJsonValue_iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    return json_add_item( impl, value );
+}
+
+static HRESULT WINAPI json_vector_RemoveAtEnd( IVector_IJsonValue *iface )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IVector_IJsonValue_iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    if (!impl->count) return E_BOUNDS;
+    return json_vector_RemoveAt( iface, impl->count - 1 );
+}
+
+static HRESULT WINAPI json_vector_Clear( IVector_IJsonValue *iface )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IVector_IJsonValue_iface );
+
+    TRACE( "iface %p.\n", iface );
+
+#ifdef SG_MUTANT_VEC_CLEAR_NOOP
+    return S_OK;
+#endif
+    while (impl->count) IJsonValue_Release( impl->items[--impl->count] );
+    impl->version++;
+    return S_OK;
+}
+
+static HRESULT WINAPI json_vector_GetMany( IVector_IJsonValue *iface, UINT32 start, UINT32 capacity, IJsonValue **items, UINT32 *actual )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IVector_IJsonValue_iface );
+    UINT32 n = 0;
+
+    TRACE( "iface %p, start %u, capacity %u, items %p, actual %p.\n", iface, start, capacity, items, actual );
+
+    if (!actual) return E_POINTER;
+    *actual = 0;
+    if (start > impl->count) return E_BOUNDS;
+    if (capacity && !items) return E_POINTER;
+    while (n < capacity && start + n < impl->count)
+    {
+        items[n] = impl->items[start + n];
+        IJsonValue_AddRef( items[n] );
+        n++;
+    }
+    *actual = n;
+    return S_OK;
+}
+
+static HRESULT WINAPI json_vector_ReplaceAll( IVector_IJsonValue *iface, UINT32 count, IJsonValue **items )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IVector_IJsonValue_iface );
+    UINT32 i;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, count %u, items %p.\n", iface, count, items );
+
+    if (count && !items) return E_POINTER;
+    for (i = 0; i < count; i++) if (!items[i]) return E_POINTER;
+    json_vector_Clear( iface );
+    for (i = 0; i < count && SUCCEEDED(hr); i++) hr = json_add_item( impl, items[i] );
+    return hr;
+}
+
+static const IVector_IJsonValueVtbl json_vector_vtbl =
+{
+    json_vector_QueryInterface,
+    json_vector_AddRef,
+    json_vector_Release,
+    json_vector_GetIids,
+    json_vector_GetRuntimeClassName,
+    json_vector_GetTrustLevel,
+    json_vector_GetAt,
+    json_vector_get_Size,
+    json_vector_GetView,
+    json_vector_IndexOf,
+    json_vector_SetAt,
+    json_vector_InsertAt,
+    json_vector_RemoveAt,
+    json_vector_Append,
+    json_vector_RemoveAtEnd,
+    json_vector_Clear,
+    json_vector_GetMany,
+    json_vector_ReplaceAll,
+};
+
+/* ---- IMap<HSTRING, IJsonValue> ---- */
+
+DEFINE_IINSPECTABLE( json_map, IMap_HSTRING_IJsonValue, struct json_value, IJsonValue_iface )
+
+static HRESULT WINAPI json_map_Lookup( IMap_HSTRING_IJsonValue *iface, HSTRING key, IJsonValue **value )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IMap_HSTRING_IJsonValue_iface );
+    BOOL found;
+    ULONG pos;
+
+    TRACE( "iface %p, key %s, value %p.\n", iface, debugstr_hstring( key ), value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    pos = json_member_find( impl, WindowsGetStringRawBuffer( key, NULL ), &found );
+    if (!found) return E_BOUNDS;
+    *value = impl->members[pos].value;
+    IJsonValue_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI json_map_get_Size( IMap_HSTRING_IJsonValue *iface, UINT32 *value )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IMap_HSTRING_IJsonValue_iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = impl->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI json_map_HasKey( IMap_HSTRING_IJsonValue *iface, HSTRING key, boolean *found )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IMap_HSTRING_IJsonValue_iface );
+    BOOL has;
+
+    TRACE( "iface %p, key %s, found %p.\n", iface, debugstr_hstring( key ), found );
+
+    if (!found) return E_POINTER;
+    json_member_find( impl, WindowsGetStringRawBuffer( key, NULL ), &has );
+    *found = has;
+    return S_OK;
+}
+
+static HRESULT WINAPI json_map_GetView( IMap_HSTRING_IJsonValue *iface, IMapView_HSTRING_IJsonValue **value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI json_map_Insert( IMap_HSTRING_IJsonValue *iface, HSTRING key, IJsonValue *value, boolean *replaced )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IMap_HSTRING_IJsonValue_iface );
+    BOOL found;
+    HRESULT hr;
+
+    TRACE( "iface %p, key %s, value %p, replaced %p.\n", iface, debugstr_hstring( key ), value, replaced );
+
+    if (!value || !replaced) return E_POINTER;
+    json_member_find( impl, WindowsGetStringRawBuffer( key, NULL ), &found );
+#ifdef SG_MUTANT_MAP_REPLACED
+    found = FALSE;
+#endif
+    if (SUCCEEDED(hr = json_set_member( impl, key, value ))) *replaced = found;
+    return hr;
+}
+
+static HRESULT WINAPI json_map_Remove( IMap_HSTRING_IJsonValue *iface, HSTRING key )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IMap_HSTRING_IJsonValue_iface );
+    BOOL found;
+    ULONG pos = json_member_find( impl, WindowsGetStringRawBuffer( key, NULL ), &found );
+
+    TRACE( "iface %p, key %s.\n", iface, debugstr_hstring( key ) );
+
+    if (!found) return E_BOUNDS;
+#ifdef SG_MUTANT_MAP_REMOVE_NOOP
+    return S_OK;
+#endif
+    WindowsDeleteString( impl->members[pos].name );
+    IJsonValue_Release( impl->members[pos].value );
+    memmove( impl->members + pos, impl->members + pos + 1, (impl->count - pos - 1) * sizeof(*impl->members) );
+    impl->count--;
+    impl->version++;
+    return S_OK;
+}
+
+static HRESULT WINAPI json_map_Clear( IMap_HSTRING_IJsonValue *iface )
+{
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IMap_HSTRING_IJsonValue_iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    while (impl->count)
+    {
+        impl->count--;
+        WindowsDeleteString( impl->members[impl->count].name );
+        IJsonValue_Release( impl->members[impl->count].value );
+    }
+    impl->version++;
+    return S_OK;
+}
+
+static const IMap_HSTRING_IJsonValueVtbl json_map_vtbl =
+{
+    json_map_QueryInterface,
+    json_map_AddRef,
+    json_map_Release,
+    json_map_GetIids,
+    json_map_GetRuntimeClassName,
+    json_map_GetTrustLevel,
+    json_map_Lookup,
+    json_map_get_Size,
+    json_map_HasKey,
+    json_map_GetView,
+    json_map_Insert,
+    json_map_Remove,
+    json_map_Clear,
+};
+
