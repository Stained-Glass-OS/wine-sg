+typedef struct {
+    struct list entry;
+    ITypeLib *lib;
+    DWORD flags;
+    GUID guid;
+    WORD major, minor;
+} typelib_entry_t;
+
+/* Drops the type libraries of the script; persistent ones are kept unless all is TRUE */
+void release_typelibs(script_ctx_t *ctx, BOOL all)
+{
+    typelib_entry_t *iter, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(iter, next, &ctx->typelibs, typelib_entry_t, entry) {
+        if(!all && (iter->flags & SCRIPTTYPELIB_ISPERSISTENT))
+            continue;
+        list_remove(&iter->entry);
+        ITypeLib_Release(iter->lib);
+        free(iter);
+    }
+}
+
+/* Constants of enumerations and modules of the added type libraries are global names of the script */
+BOOL lookup_typelib_const(script_ctx_t *ctx, const WCHAR *name, jsval_t *ret)
+{
+    typelib_entry_t *entry;
+    UINT i, count;
+
+#ifdef SG_MUTANT_JSB1_TYPELIB
+    return FALSE;
+#endif
+    LIST_FOR_EACH_ENTRY(entry, &ctx->typelibs, typelib_entry_t, entry) {
+        count = ITypeLib_GetTypeInfoCount(entry->lib);
+        for(i = 0; i < count; i++) {
+            ITypeInfo *info;
+            TYPEATTR *attr;
+            UINT v;
+
+            if(FAILED(ITypeLib_GetTypeInfo(entry->lib, i, &info)))
+                continue;
+            if(FAILED(ITypeInfo_GetTypeAttr(info, &attr))) {
+                ITypeInfo_Release(info);
+                continue;
+            }
+            if(attr->typekind == TKIND_ENUM || attr->typekind == TKIND_MODULE) {
+                for(v = 0; v < attr->cVars; v++) {
+                    VARDESC *vd;
+                    BSTR vname;
+                    UINT n;
+
+                    if(FAILED(ITypeInfo_GetVarDesc(info, v, &vd)))
