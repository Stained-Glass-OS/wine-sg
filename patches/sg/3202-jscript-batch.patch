+/* Helpers for objects that are not JScript objects (plain IDispatch/IDispatchEx hosts). */
+static HRESULT host_get_id(script_ctx_t *ctx, IDispatch *disp, const WCHAR *name, BOOL ensure, DISPID *id)
+{
+    IDispatchEx *dispex;
+    BSTR bstr;
+    HRESULT hres;
+
+    if(!(bstr = SysAllocString(name)))
+        return E_OUTOFMEMORY;
+
+    hres = IDispatch_QueryInterface(disp, &IID_IDispatchEx, (void**)&dispex);
+    if(SUCCEEDED(hres)) {
+        hres = IDispatchEx_GetDispID(dispex, bstr, make_grfdex(ctx, fdexNameCaseSensitive | (ensure ? fdexNameEnsure : 0)), id);
+        IDispatchEx_Release(dispex);
+    }else if(!ensure) {
+        hres = IDispatch_GetIDsOfNames(disp, &IID_NULL, &bstr, 1, ctx->lcid, id);
+    }else {
+        hres = JS_E_INVALID_ACTION;
+    }
+    SysFreeString(bstr);
+    if(FAILED(hres) && hres != JS_E_INVALID_ACTION && hres != E_OUTOFMEMORY)
+        return DISP_E_UNKNOWNNAME;
+    return hres;
+}
+
+static BOOL host_prop_enumerable(IDispatch *disp, DISPID id)
+{
+    IDispatchEx *dispex;
+    DISPID cur = DISPID_STARTENUM;
+    BOOL ret = FALSE;
+
+#ifdef SG_MUTANT_JSB1_HOSTPIE
+    return FALSE;
+#endif
+    if(FAILED(IDispatch_QueryInterface(disp, &IID_IDispatchEx, (void**)&dispex)))
+        return FALSE;
+    while(IDispatchEx_GetNextDispID(dispex, fdexEnumDefault, cur, &cur) == S_OK) {
+        if(cur == id) {
+            ret = TRUE;
+            break;
+        }
+    }
+    IDispatchEx_Release(dispex);
+    return ret;
+}
+
+/* Object.keys / getOwnPropertyNames of a host object: the names its IDispatchEx enumerates */
+static HRESULT host_keys(script_ctx_t *ctx, IDispatch *disp, jsdisp_t *array)
+{
+    IDispatchEx *dispex;
+    DISPID id = DISPID_STARTENUM;
+    unsigned i = 0;
+    BSTR name;
+    HRESULT hres;
+
+    if(FAILED(IDispatch_QueryInterface(disp, &IID_IDispatchEx, (void**)&dispex)))
+        return S_OK;
+
+#ifdef SG_MUTANT_JSB1_HOSTKEYS
+    IDispatchEx_Release(dispex);
+    return S_OK;
+#endif
+    while(IDispatchEx_GetNextDispID(dispex, fdexEnumDefault, id, &id) == S_OK) {
+        jsstr_t *str;
+
+        hres = IDispatchEx_GetMemberName(dispex, id, &name);
+        if(FAILED(hres))
+            continue;
+        str = jsstr_alloc_len(name, SysStringLen(name));
+        SysFreeString(name);
+        if(!str) {
+            IDispatchEx_Release(dispex);
+            return E_OUTOFMEMORY;
+        }
+        hres = jsdisp_propput_idx(array, i++, jsval_string(str));
+        jsstr_release(str);
+        if(FAILED(hres)) {
+            IDispatchEx_Release(dispex);
+            return hres;
+        }
+    }
+    IDispatchEx_Release(dispex);
+    return S_OK;
+}
