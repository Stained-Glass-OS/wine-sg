+/* Converts a variant the engine keeps as is (jsval_variant) to a double: dates, 64 bit integers,
+ * decimals, by-reference values and so on; arrays, records and errors cannot be converted */
+static HRESULT variant_to_double(const VARIANT *v, double *ret)
+{
+    VARIANT dst;
+    HRESULT hres;
+
+#ifndef SG_MUTANT_JSB1_VNUM
+    if(V_VT(v) == VT_DATE)
+        return variant_date_to_number(V_DATE(v), ret);
+#endif
+
+    V_VT(&dst) = VT_EMPTY;
+    hres = VariantChangeTypeEx(&dst, (VARIANT*)v, MAKELCID(MAKELANGID(LANG_ENGLISH, SUBLANG_ENGLISH_US), SORT_DEFAULT), 0, VT_R8);
+    if(FAILED(hres))
+        return hres;
+    *ret = V_R8(&dst);
+    return S_OK;
+}
