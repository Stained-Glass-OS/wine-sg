+/* Copies properties of a host object into a plain JS object so that the descriptor code can read them.
+ * With names == NULL every enumerated member is copied, else only the listed ones. */
+static HRESULT host_copy_props(script_ctx_t *ctx, IDispatch *disp, const WCHAR * const *names, jsdisp_t **ret)
+{
+    jsdisp_t *obj;
+    HRESULT hres;
+    DISPID id;
+
+    hres = create_object(ctx, NULL, &obj);
+    if(FAILED(hres))
+        return hres;
+
+    if(names) {
+        for(; *names && SUCCEEDED(hres); names++) {
+            jsval_t v;
+
+            if(host_get_id(ctx, disp, *names, FALSE, &id) != S_OK)
+                continue;
+            hres = disp_propget(ctx, disp, id, &v);
+            if(SUCCEEDED(hres)) {
+                hres = jsdisp_propput_name(obj, *names, v);
+                jsval_release(v);
+            }
+        }
+    }else {
+        IDispatchEx *dispex;
+
+        if(SUCCEEDED(IDispatch_QueryInterface(disp, &IID_IDispatchEx, (void**)&dispex))) {
+            id = DISPID_STARTENUM;
+            while(SUCCEEDED(hres) && IDispatchEx_GetNextDispID(dispex, fdexEnumDefault, id, &id) == S_OK) {
+                jsval_t v;
+                BSTR name;
+
+                if(FAILED(IDispatchEx_GetMemberName(dispex, id, &name)))
+                    continue;
+                hres = disp_propget(ctx, disp, id, &v);
+                if(SUCCEEDED(hres)) {
+                    hres = jsdisp_propput_name(obj, name, v);
+                    jsval_release(v);
+                }
+                SysFreeString(name);
+            }
+            IDispatchEx_Release(dispex);
+        }
+    }
+
+    if(FAILED(hres)) {
+        jsdisp_release(obj);
+        return hres;
+    }
+    *ret = obj;
+    return S_OK;
