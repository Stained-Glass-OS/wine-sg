+/* inverse of variant_date_to_number: time value (UTC ms) to an OLE automation date in local time */
+HRESULT number_to_variant_date(double time, double *date)
+{
+    SYSTEMTIME utc, local;
+    UDATE udate;
+
+    if(isnan(time) || !isfinite(time))
+        return DISP_E_OVERFLOW;
+
+    memset(&utc, 0, sizeof(utc));
+    utc.wYear = year_from_time(time);
+    utc.wMonth = month_from_time(time) + 1;
+    utc.wDay = date_from_time(time);
+    utc.wHour = hour_from_time(time);
+    utc.wMinute = min_from_time(time);
+    utc.wSecond = sec_from_time(time);
+    utc.wMilliseconds = ms_from_time(time);
+    utc.wDayOfWeek = week_day(time);
+    if(!SystemTimeToTzSpecificLocalTime(NULL, &utc, &local))
+        return DISP_E_OVERFLOW;
+
+    udate.st = local;
+    udate.wDayOfYear = 0;
+    return VarDateFromUdate(&udate, 0, date);
+}
