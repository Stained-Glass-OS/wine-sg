From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: TxQueryHitPoint and TxGetDropTarget for text services (3699)

riched20: TxQueryHitPoint and TxGetDropTarget for text services

ITextServices::TxQueryHitPoint tells a windowless host whether a point
belongs to the control: outside the client rectangle it is NOHIT, with an
opaque background anywhere inside is a HIT, and with a transparent
background a point over text is a HIT, one a few pixels from text is CLOSE
and any other is TRANSPARENT.

ITextServices::TxGetDropTarget returns a new IDropTarget (released by the
host) that takes rich text, Unicode text or ANSI text from the data object
at the character under the point: move by default, copy with the control
key, nothing for a read-only control or data that is not text.
---
diff --git a/dlls/riched20/editor.c b/dlls/riched20/editor.c
index 5e7284f..cf856e7 100644
--- a/dlls/riched20/editor.c
+++ b/dlls/riched20/editor.c
@@ -2367,6 +2367,216 @@ done:
     return hr == S_OK;
 }
 
+/* A drop target for the text of a control: the TxGetDropTarget of text services. It takes rich
+ * text, Unicode text and ANSI text from the data object and puts it at the point of the drop. */
+struct drop_target
+{
+    IDropTarget IDropTarget_iface;
+    LONG ref;
+    ITextServices *services;
+    ME_TextEditor *editor;
+    IDataObject *data;
+    DWORD effect;
+};
+
+static inline struct drop_target *impl_from_IDropTarget( IDropTarget *iface )
+{
+    return CONTAINING_RECORD( iface, struct drop_target, IDropTarget_iface );
+}
+
+static HRESULT paste_ansi_text(ME_TextEditor *editor, FORMATETC *fmt, STGMEDIUM *med)
+{
+    EDITSTREAM es;
+    ME_GlobalDestStruct gds;
+    HRESULT hr;
+
+    gds.hData = med->hGlobal;
+    gds.nLength = 0;
+    es.dwCookie = (DWORD_PTR)&gds;
+    es.pfnCallback = ME_ReadFromHGLOBALRTF;
+    hr = ME_StreamIn( editor, SF_TEXT | SFF_SELECTION, &es, FALSE ) == 0 ? E_FAIL : S_OK;
+    ReleaseStgMedium( med );
+    return hr;
+}
+
+/* put the data of a data object into the control at the selection; check_only only asks */
+static HRESULT paste_data_object(ME_TextEditor *editor, IDataObject *data, BOOL check_only)
+{
+    static FORMATETC ansi = { CF_TEXT, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    struct paste_format *format;
+    STGMEDIUM med;
+    HRESULT hr;
+
+    init_paste_formats();
+    for (format = paste_formats; format->fmt.cfFormat; format++)
+    {
+        if (IDataObject_QueryGetData( data, &format->fmt ) != S_OK) continue;
+        if (check_only) return S_OK;
+        if ((hr = IDataObject_GetData( data, &format->fmt, &med )) != S_OK) return hr;
+        return format->paste( editor, &format->fmt, &med );
+    }
+#ifdef SG_MUTANT_DROP_ANSI
+    return DV_E_FORMATETC;
+#endif
+    if (IDataObject_QueryGetData( data, &ansi ) != S_OK) return DV_E_FORMATETC;
+    if (check_only) return S_OK;
+    if ((hr = IDataObject_GetData( data, &ansi, &med )) != S_OK) return hr;
+    return paste_ansi_text( editor, &ansi, &med );
+}
+
+static HRESULT WINAPI drop_target_QueryInterface( IDropTarget *iface, REFIID riid, void **obj )
+{
+    struct drop_target *This = impl_from_IDropTarget( iface );
+
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IDropTarget ))
+    {
+        *obj = &This->IDropTarget_iface;
+        IDropTarget_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI drop_target_AddRef( IDropTarget *iface )
+{
+    struct drop_target *This = impl_from_IDropTarget( iface );
+    return InterlockedIncrement( &This->ref );
+}
+
+static ULONG WINAPI drop_target_Release( IDropTarget *iface )
+{
+    struct drop_target *This = impl_from_IDropTarget( iface );
+    ULONG ref = InterlockedDecrement( &This->ref );
+
+    if (!ref)
+    {
+        if (This->data) IDataObject_Release( This->data );
+        ITextServices_Release( This->services );
+        free( This );
+    }
+    return ref;
+}
+
+/* the effect a drop would have: the data has to be text, the control writable, and the key state
+ * chooses between copying and moving */
+static DWORD drop_target_effect( struct drop_target *This, DWORD keys, DWORD allowed )
+{
+    if (!This->data
+#ifndef SG_MUTANT_DROP_RO
+            || (This->editor->props & TXTBIT_READONLY)
+#endif
+            ) return DROPEFFECT_NONE;
+    if (paste_data_object( This->editor, This->data, TRUE ) != S_OK) return DROPEFFECT_NONE;
+    if ((keys & MK_CONTROL)
+#ifdef SG_MUTANT_DROP_CTRL
+            && 0
+#endif
+            )
+        return allowed & DROPEFFECT_COPY ? DROPEFFECT_COPY : DROPEFFECT_NONE;
+    if (allowed & DROPEFFECT_MOVE) return DROPEFFECT_MOVE;
+    return allowed & DROPEFFECT_COPY ? DROPEFFECT_COPY : DROPEFFECT_NONE;
+}
+
+static HRESULT WINAPI drop_target_DragEnter( IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt,
+                                             DWORD *effect )
+{
+    struct drop_target *This = impl_from_IDropTarget( iface );
+
+    if (!effect) return E_INVALIDARG;
+    if (This->data) IDataObject_Release( This->data );
+    This->data = data;
+    if (data) IDataObject_AddRef( data );
+    This->effect = drop_target_effect( This, keys, *effect );
+    *effect = This->effect;
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_target_DragOver( IDropTarget *iface, DWORD keys, POINTL pt, DWORD *effect )
+{
+    struct drop_target *This = impl_from_IDropTarget( iface );
+
+    if (!effect) return E_INVALIDARG;
+    This->effect = drop_target_effect( This, keys, *effect );
+    *effect = This->effect;
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_target_DragLeave( IDropTarget *iface )
+{
+    struct drop_target *This = impl_from_IDropTarget( iface );
+
+#ifndef SG_MUTANT_DROP_LEAK
+    if (This->data) IDataObject_Release( This->data );
+#endif
+    This->data = NULL;
+    This->effect = DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_target_Drop( IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt,
+                                        DWORD *effect )
+{
+    struct drop_target *This = impl_from_IDropTarget( iface );
+    ME_Cursor cursor;
+    POINT point;
+    HRESULT hr;
+    DWORD result;
+
+    if (!effect) return E_INVALIDARG;
+    if (This->data) IDataObject_Release( This->data );
+    This->data = data;
+    if (data) IDataObject_AddRef( data );
+    result = drop_target_effect( This, keys, *effect );
+    if (result == DROPEFFECT_NONE) { *effect = DROPEFFECT_NONE; return S_OK; }
+
+    /* the drop goes to the character under the point, given in screen coordinates */
+    point.x = pt.x;
+    point.y = pt.y;
+    ITextHost_TxScreenToClient( This->editor->texthost, &point );
+    cursor_from_coords( This->editor, point.x, point.y, &cursor );
+#ifdef SG_MUTANT_DROP_POS
+    ME_SetCursorToStart( This->editor, &cursor );
+#endif
+    set_selection_cursors( This->editor, ME_GetCursorOfs( &cursor ), ME_GetCursorOfs( &cursor ) );
+    hr = paste_data_object( This->editor, data, FALSE );
+    if (SUCCEEDED( hr ))
+    {
+        ME_CommitUndo( This->editor );
+        ME_UpdateRepaint( This->editor, FALSE );
+    }
+    *effect = SUCCEEDED( hr ) ? result : DROPEFFECT_NONE;
+    drop_target_DragLeave( iface );
+    return hr;
+}
+
+static const IDropTargetVtbl drop_target_vtbl =
+{
+    drop_target_QueryInterface,
+    drop_target_AddRef,
+    drop_target_Release,
+    drop_target_DragEnter,
+    drop_target_DragOver,
+    drop_target_DragLeave,
+    drop_target_Drop
+};
+
+HRESULT editor_create_drop_target( ME_TextEditor *editor, ITextServices *services, IDropTarget **ret )
+{
+    struct drop_target *target;
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    if (!(target = calloc( 1, sizeof(*target) ))) return E_OUTOFMEMORY;
+    target->IDropTarget_iface.lpVtbl = &drop_target_vtbl;
+    target->ref = 1;
+    target->services = services;
+    ITextServices_AddRef( services );
+    target->editor = editor;
+    *ret = &target->IDropTarget_iface;
+    return S_OK;
+}
+
 static HRESULT editor_copy( ME_TextEditor *editor, ME_Cursor *start, int chars, IDataObject **data_out )
 {
     IDataObject *data = NULL;
diff --git a/dlls/riched20/editor.h b/dlls/riched20/editor.h
index 9202a96..35ba116 100644
--- a/dlls/riched20/editor.h
+++ b/dlls/riched20/editor.h
@@ -165,6 +165,7 @@ static inline ME_DisplayItem *run_get_di( ME_Run *run )
 /* caret.c */
 void cursor_coords( ME_TextEditor *editor, ME_Cursor *cursor, int *x, int *y, int *height );
 BOOL cursor_from_coords( ME_TextEditor *editor, int x, int y, ME_Cursor *cursor );
+HRESULT editor_create_drop_target( ME_TextEditor *editor, ITextServices *services, IDropTarget **ret );
 void ME_SetCursorToStart(ME_TextEditor *editor, ME_Cursor *cursor);
 int set_selection_cursors(ME_TextEditor *editor, int from, int to);
 BOOL ME_MoveCursorWords(ME_TextEditor *editor, ME_Cursor *cursor, int nRelOfs);
diff --git a/dlls/riched20/txtsrv.c b/dlls/riched20/txtsrv.c
index 54fab23..349df42 100644
--- a/dlls/riched20/txtsrv.c
+++ b/dlls/riched20/txtsrv.c
@@ -261,9 +261,56 @@ HRESULT __thiscall fnTextSrv_TxQueryHitPoint(ITextServices *iface, DWORD dwDrawA
                                                              DWORD *pHitResult)
 {
     struct text_services *services = impl_from_ITextServices( iface );
+    ME_TextEditor *editor = services->editor;
+    TXTBACKSTYLE back = editor->back_style;
+    static const int close_distance = 4;
+    ME_Cursor cursor;
+    RECT client;
+    POINT pt = { x, y };
+    int i;
 
-    FIXME( "%p: STUB\n", services );
-    return E_NOTIMPL;
+    TRACE( "%p: aspect %lx %p draw %p target %p client %s (%d,%d) %p\n", services, dwDrawAspect, pvAspect, hdcDraw,
+           hicTargetDev, wine_dbgstr_rect( lprcClient ), x, y, pHitResult );
+
+    if (!pHitResult) return E_INVALIDARG;
+    *pHitResult = TXTHITRESULT_NOHIT;
+
+    if (lprcClient) client = *lprcClient;
+    else if (FAILED(ITextHost_TxGetClientRect( editor->texthost, &client ))) return E_FAIL;
+    if (!PtInRect( &client, pt )) return S_OK;
+
+    /* the control's own background, as the host has it now */
+    ITextHost_TxGetBackStyle( editor->texthost, &back );
+#ifdef SG_MUTANT_HIT_OPAQUE
+    back = TXTBACK_TRANSPARENT;
+#endif
+    if (back != TXTBACK_TRANSPARENT)
+    {
+        *pHitResult = TXTHITRESULT_HIT;
+        return S_OK;
+    }
+
+    /* transparent: over text it is a hit, near text it is close, elsewhere it is transparent */
+    if (cursor_from_coords( editor, x, y, &cursor ))
+    {
+        *pHitResult = TXTHITRESULT_HIT;
+        return S_OK;
+    }
+    *pHitResult = TXTHITRESULT_TRANSPARENT;
+    for (i = 0; i < 4; i++)
+    {
+        int dx = i == 0 ? -close_distance : i == 1 ? close_distance : 0;
+        int dy = i == 2 ? -close_distance : i == 3 ? close_distance : 0;
+
+        if (cursor_from_coords( editor, x + dx, y + dy, &cursor ))
+        {
+#ifndef SG_MUTANT_HIT_CLOSE
+            *pHitResult = TXTHITRESULT_CLOSE;
+#endif
+            break;
+        }
+    }
+    return S_OK;
 }
 
 DEFINE_THISCALL_WRAPPER(fnTextSrv_OnTxInPlaceActivate,8)
@@ -605,8 +652,8 @@ HRESULT __thiscall fnTextSrv_TxGetDropTarget(ITextServices *iface, IDropTarget *
 {
     struct text_services *services = impl_from_ITextServices( iface );
 
-    FIXME( "%p: STUB\n", services );
-    return E_NOTIMPL;
+    TRACE( "%p: %p\n", services, ppDropTarget );
+    return editor_create_drop_target( services->editor, iface, ppDropTarget );
 }
 
 DEFINE_THISCALL_WRAPPER(fnTextSrv_OnTxPropertyBitsChange,12)
