+/* a printer maker's package for the model, installed if it is there; for
+ * printers found through CUPS.  A model looked for in vain is not looked
+ * for again until the packages change. */
+BOOL install_model_driver( const WCHAR *model )
+{
+    WCHAR path[MAX_PATH];
+    DWORD stamp, old, size = sizeof(old);
+    HKEY key;
+    BOOL ret;
+
+    if (!model || !model[0]) return FALSE;
+    /* the Windows system installs it for everyone (splwow64 drivers, run by
+     * sg-windows-printers); a standard user's program does not try */
+    if (!can_install_drivers()) return FALSE;
+    stamp = packages_stamp();
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Wine\\Printing\\Driver Packages", 0, NULL, 0,
+                         KEY_ALL_ACCESS, NULL, &key, NULL ))
+        key = NULL;
+    if (key && !RegQueryValueExW( key, model, NULL, NULL, (BYTE *)&old, &size ) && old == stamp)
+    {
+        RegCloseKey( key );
+        return FALSE;
+    }
+    ret = find_package( model, path, ARRAY_SIZE(path) );
+    if (ret)
+    {
+        TRACE( "installing %s from %s\n", debugstr_w(model), debugstr_w(path) );
+        ret = install_from_inf( path, model, current_env() );
+    }
+    if (key)
+    {
+        if (!ret) RegSetValueExW( key, model, 0, REG_DWORD, (BYTE *)&stamp, sizeof(stamp) );
+        else RegDeleteValueW( key, model );
+        RegCloseKey( key );
+    }
+    return ret;
+}
