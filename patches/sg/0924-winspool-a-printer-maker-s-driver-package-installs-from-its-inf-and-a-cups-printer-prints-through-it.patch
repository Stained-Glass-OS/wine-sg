+/* Stained Glass OS: a queue we publish for Linux programs to print through a
+ * Windows driver ("<printer> (maker's driver)") is the Windows printer
+ * itself seen from CUPS; it is not a printer of its own for Windows programs */
+static BOOL cups_is_windows_driver_queue( const cups_dest_t *dest )
+{
+    const char *model = pcupsGetOption( "printer-make-and-model", dest->num_options, dest->options );
+    static const char suffix[] = " (maker's driver)";
+    size_t len = model ? strlen( model ) : 0;
+#ifdef SG_MUTANT_WINQUEUE
+    return FALSE;
+#endif
+    return len >= sizeof(suffix) - 1 && !strcmp( model + len - (sizeof(suffix) - 1), suffix );
+}
