+/* Stained Glass OS: a printer can print through a Windows printer driver
+ * (the maker's own, or Unidrv for a GPD) installed under its model's name.
+ * Such a driver wins over the PostScript driver we make from the CUPS queue,
+ * unless the printer's "SgPrinterDriver" value says "linux"; the PostScript
+ * driver is then named "<model> (CUPS)" beside it.  The queue's port stays
+ * CUPS: CUPS owns the device and the Windows driver's output goes to it raw. */
+static BOOL is_windows_driver_env( const WCHAR *driver, const WCHAR *env )
+{
+    WCHAR file[MAX_PATH], *base;
+    DWORD size = sizeof(file);
+    HKEY drivers, key;
+    BOOL ret = FALSE;
+
+    if (!driver || !driver[0]) return FALSE;
+    if (!(drivers = WINSPOOL_OpenDriverReg( env ))) return FALSE;
+    if (!RegOpenKeyW( drivers, driver, &key ))
+    {
+        if (!RegQueryValueExW( key, L"Driver", NULL, NULL, (BYTE *)file, &size ) && file[0])
+        {
+            base = wcsrchr( file, '\\' );
+            base = base ? base + 1 : file;
+            ret = wcsicmp( base, L"wineps.drv" ) && wcsicmp( base, L"wineps16.drv" );
+        }
+        RegCloseKey( key );
+    }
+    RegCloseKey( drivers );
+    return ret;
+}
+
+static BOOL is_windows_driver( const WCHAR *driver )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(all_printenv); i++)
+    {
+        if (all_printenv[i]->driverversion == 0) continue;
+        if (is_windows_driver_env( driver, all_printenv[i]->envname )) return TRUE;
+    }
+    return FALSE;
+}
+
+/* A 32-bit program on a 64-bit system prints through the 64-bit driver when
+ * only that one is installed, as through the spooler's 32-bit host on
+ * Windows: we answer for the 64-bit environment, and the parts that cannot
+ * run in the program's process run in our 64-bit host. */
+static const WCHAR *wow64_driver_env( const WCHAR *driver )
+{
+#ifdef __i386__
+    BOOL wow64 = FALSE;
+
+    if (!IsWow64Process( GetCurrentProcess(), &wow64 ) || !wow64) return NULL;
+    if (is_windows_driver_env( driver, NULL )) return NULL;
+    if (is_windows_driver_env( driver, L"Windows x64" )) return L"Windows x64";
+#endif
+    return NULL;
+}
+
+static BOOL wants_linux_driver( HKEY printer_key )
+{
+    WCHAR value[16];
+    DWORD size = sizeof(value);
+
+    if (RegQueryValueExW( printer_key, L"SgPrinterDriver", NULL, NULL, (BYTE *)value, &size )) return FALSE;
+    return !wcsicmp( value, L"linux" );
+}
+
+BOOL install_model_driver( const WCHAR *model );
+
+/* the driver a CUPS queue of this model prints with; *windows says which kind */
+static WCHAR *cups_queue_driver( const WCHAR *model, HKEY printer_key, BOOL *windows )
+{
+    WCHAR *ret;
+
+    *windows = FALSE;
+#ifndef SG_MUTANT_WINDRIVER
+    if (is_windows_driver( model ) || install_model_driver( model ))
+    {
+        if (!printer_key || !wants_linux_driver( printer_key ))
+        {
+            *windows = TRUE;
+            return wcsdup( model );
+        }
+        if ((ret = malloc( (wcslen( model ) + 8) * sizeof(WCHAR) )))
+            swprintf( ret, wcslen( model ) + 8, L"%s (CUPS)", model );
+        return ret;
+    }
+#endif
+    return wcsdup( model );
+}
