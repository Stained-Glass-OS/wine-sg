+/*
+ * A printer maker's driver package is an INF of class Printer: its
+ * [Manufacturer] lists model sections (decorated per platform, NTamd64...),
+ * each model names an install section, and that section names the driver's
+ * files: DriverFile, ConfigFile, DataFile, HelpFile, the files to copy, the
+ * language monitor, and the core driver it builds on (Unidrv or PScript, by
+ * CoreDriverSections or Include/Needs).  We copy the files from the package
+ * and add the driver under the model's name, as the spooler does.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+#include "winerror.h"
+#include "winreg.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winspool.h"
+#include "setupapi.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(winspool);
+
+struct file_list
+{
+    WCHAR **names;
+    unsigned int count, size;
+};
+
+static void list_add( struct file_list *list, const WCHAR *name )
+{
+    unsigned int i;
+    if (!name || !name[0]) return;
+    for (i = 0; i < list->count; i++) if (!wcsicmp( list->names[i], name )) return;
+    if (list->count == list->size)
+    {
+        list->size = list->size ? list->size * 2 : 16;
+        list->names = realloc( list->names, list->size * sizeof(*list->names) );
+    }
+    list->names[list->count++] = wcsdup( name );
+}
+
+static void list_free( struct file_list *list )
+{
+    unsigned int i;
+    for (i = 0; i < list->count; i++) free( list->names[i] );
+    free( list->names );
+}
+
+/* the platform decoration and architecture directory of an environment */
+static const WCHAR *env_decoration( const WCHAR *env )
+{
+    if (!env || !wcsicmp( env, L"Windows x64" )) return L"NTamd64";
+    if (!wcsicmp( env, L"Windows NT x86" )) return L"NTx86";
+    if (!wcsicmp( env, L"Windows ARM64" )) return L"NTarm64";
+    return L"NTx86";
+}
+
+static const WCHAR *current_env( void )
+{
+#ifdef __x86_64__
+    return L"Windows x64";
+#elif defined(__aarch64__)
+    return L"Windows ARM64";
+#else
+    return L"Windows NT x86";
+#endif
+}
+
+static BOOL get_field( INFCONTEXT *ctx, DWORD index, WCHAR *buf, DWORD size )
+{
+    return SetupGetStringFieldW( ctx, index, buf, size, NULL );
+}
+
+static BOOL get_value( HINF inf, const WCHAR *section, const WCHAR *key, WCHAR *buf, DWORD size )
+{
+    INFCONTEXT ctx;
+    if (!SetupFindFirstLineW( inf, section, key, &ctx )) return FALSE;
+    return get_field( &ctx, 1, buf, size );
+}
+
+/* the model section for the environment: the decorated one if the
+ * manufacturer line lists it, else the plain one */
+static BOOL find_model( HINF inf, const WCHAR *env, const WCHAR *model, WCHAR *install, DWORD size )
+{
+    const WCHAR *deco = env_decoration( env );
+    INFCONTEXT mfg, line;
+    WCHAR section[MAX_PATH], field[MAX_PATH], name[512];
+    DWORD i, count;
+
+    if (!SetupFindFirstLineW( inf, L"Manufacturer", NULL, &mfg )) return FALSE;
+    do
+    {
+        WCHAR models[MAX_PATH];
+        BOOL decorated = FALSE;
+
+        if (!get_field( &mfg, 1, section, ARRAY_SIZE(section) )) continue;
+        count = SetupGetFieldCount( &mfg );
+        for (i = 2; i <= count; i++)
+        {
+            if (!get_field( &mfg, i, field, ARRAY_SIZE(field) )) continue;
+            if (!wcsnicmp( field, deco, wcslen( deco ) ))
+            {
+                swprintf( models, ARRAY_SIZE(models), L"%s.%s", section, field );
+                decorated = TRUE;
+                break;
+            }
+        }
+        if (!decorated) wcscpy( models, section );
+        if (!SetupFindFirstLineW( inf, models, NULL, &line ) && decorated)
+        {
+            wcscpy( models, section );
+            if (!SetupFindFirstLineW( inf, models, NULL, &line )) continue;
+        }
+        else if (!SetupFindFirstLineW( inf, models, NULL, &line )) continue;
+        do
+        {
+            if (!SetupGetStringFieldW( &line, 0, name, ARRAY_SIZE(name), NULL )) continue;
+            if (wcsicmp( name, model )) continue;
+            if (!get_field( &line, 1, install, size )) continue;
+            TRACE( "model %s: %s in %s\n", debugstr_w(model), debugstr_w(install), debugstr_w(models) );
+            return TRUE;
+        } while (SetupFindNextLine( &line, &line ));
+    } while (SetupFindNextLine( &mfg, &mfg ));
+    return FALSE;
+}
+
+/* the files a CopyFiles entry names: @file, or a section of file lines */
+static void add_copy_files( HINF inf, const WCHAR *value, struct file_list *files )
+{
+    WCHAR *copy = wcsdup( value ), *p, *next;
+
+    for (p = copy; p && *p; p = next)
+    {
+        INFCONTEXT ctx;
+        WCHAR name[MAX_PATH];
+
+        if ((next = wcschr( p, ',' ))) *next++ = 0;
+        while (*p == ' ' || *p == '\t') p++;
+        while (*p && (p[wcslen( p ) - 1] == ' ' || p[wcslen( p ) - 1] == '\t')) p[wcslen( p ) - 1] = 0;
+        if (!*p) continue;
+        if (*p == '@')
+        {
+            list_add( files, p + 1 );
+            continue;
+        }
+        if (!SetupFindFirstLineW( inf, p, NULL, &ctx )) continue;
+        do
+        {
+            if (get_field( &ctx, 1, name, ARRAY_SIZE(name) ) && name[0]) list_add( files, name );
+            else if (SetupGetStringFieldW( &ctx, 0, name, ARRAY_SIZE(name), NULL )) list_add( files, name );
+        } while (SetupFindNextLine( &ctx, &ctx ));
+    }
+    free( copy );
+}
+
+/* the core drivers: we provide Unidrv; a section naming it brings its files */
+static void add_core( const WCHAR *section, WCHAR *driver, WCHAR *config, struct file_list *files )
+{
+    if (!wcsnicmp( section, L"UNIDRV", 6 ))
+    {
+        if (!driver[0]) wcscpy( driver, L"UNIDRV.DLL" );
+        if (!config[0]) wcscpy( config, L"UNIDRVUI.DLL" );
+    }
+    else if (!wcsnicmp( section, L"PSCRIPT", 7 ))
+    {
+        FIXME( "PostScript core driver %s: printing goes through our PostScript driver\n", debugstr_w(section) );
+    }
+    else TRACE( "core section %s\n", debugstr_w(section) );
+}
+
+static void read_core_sections( HINF inf, const WCHAR *install, WCHAR *driver, WCHAR *config,
+                                struct file_list *files )
+{
+    INFCONTEXT ctx;
+    WCHAR field[MAX_PATH];
+    DWORD i, count;
+
+    if (SetupFindFirstLineW( inf, install, L"CoreDriverSections", &ctx ))
+    {
+        /* "{guid},section,section", "{guid},section"... */
+        count = SetupGetFieldCount( &ctx );
+        for (i = 1; i <= count; i++)
+        {
+            WCHAR *p, *next;
+            if (!get_field( &ctx, i, field, ARRAY_SIZE(field) )) continue;
+            /* each field is quoted: "{guid},section,section" */
+#ifdef SG_MUTANT_PKGINSTALL
+            break;
+#endif
+            for (p = field; p && *p; p = next)
+            {
+                if ((next = wcschr( p, ',' ))) *next++ = 0;
+                while (*p == ' ') p++;
+                if (*p && *p != '{') add_core( p, driver, config, files );
+            }
+        }
+    }
+    if (SetupFindFirstLineW( inf, install, L"Needs", &ctx ))
+    {
+        count = SetupGetFieldCount( &ctx );
+        for (i = 1; i <= count; i++)
+            if (get_field( &ctx, i, field, ARRAY_SIZE(field) )) add_core( field, driver, config, files );
+    }
+}
+
+/* where a file of the package is: the source disk's directory under the
+ * INF's, as SourceDisksFiles and SourceDisksNames say */
+static void source_path( HINF inf, const WCHAR *inf_dir, const WCHAR *env, const WCHAR *file, WCHAR *path, DWORD size )
+{
+    const WCHAR *arch = !wcsicmp( env, L"Windows NT x86" ) ? L"x86" :
+                        !wcsicmp( env, L"Windows ARM64" ) ? L"arm64" : L"amd64";
+    WCHAR section[64], disk[16], subdir[MAX_PATH] = L"", tmp[MAX_PATH];
+    INFCONTEXT ctx;
+
+    swprintf( section, ARRAY_SIZE(section), L"SourceDisksFiles.%s", arch );
+    if (!SetupFindFirstLineW( inf, section, file, &ctx ) &&
+        !SetupFindFirstLineW( inf, L"SourceDisksFiles", file, &ctx ))
+        disk[0] = 0;
+    else if (!get_field( &ctx, 1, disk, ARRAY_SIZE(disk) )) disk[0] = 0;
+    else if (get_field( &ctx, 2, tmp, ARRAY_SIZE(tmp) ) && tmp[0]) wcscpy( subdir, tmp );
+
+    if (disk[0] && !subdir[0])
+    {
+        swprintf( section, ARRAY_SIZE(section), L"SourceDisksNames.%s", arch );
+        if (SetupFindFirstLineW( inf, section, disk, &ctx ) ||
+            SetupFindFirstLineW( inf, L"SourceDisksNames", disk, &ctx ))
+        {
+            if (get_field( &ctx, 4, tmp, ARRAY_SIZE(tmp) )) wcscpy( subdir, tmp );
+        }
+    }
+    if (subdir[0])
+    {
+        while (subdir[0] == '\\') memmove( subdir, subdir + 1, wcslen( subdir ) * sizeof(WCHAR) );
+        swprintf( path, size, L"%s\\%s\\%s", inf_dir, subdir, file );
+        if (GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES) return;
+    }
+    swprintf( path, size, L"%s\\%s", inf_dir, file );
+    if (GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES) return;
+    /* a core file: ours, in the system directory */
+    GetSystemDirectoryW( tmp, ARRAY_SIZE(tmp) );
+    swprintf( path, size, L"%s\\%s", tmp, file );
+}
+
+static BOOL install_from_inf( const WCHAR *inf_path, const WCHAR *model, const WCHAR *env )
+{
+    WCHAR install[MAX_PATH], section[MAX_PATH], value[1024], inf_dir[MAX_PATH], *slash;
+    WCHAR driver[MAX_PATH] = L"", config[MAX_PATH] = L"", data[MAX_PATH] = L"", help[MAX_PATH] = L"";
+    WCHAR monitor[MAX_PATH] = L"", src[4][MAX_PATH], *deps, *p;
+    struct file_list files = { 0 };
+    DRIVER_INFO_6W di;
+    INFCONTEXT ctx;
+    unsigned int i;
+    size_t len;
+    HINF inf;
+    BOOL ret = FALSE;
+
+    inf = SetupOpenInfFileW( inf_path, NULL, INF_STYLE_WIN4, NULL );
+    if (inf == INVALID_HANDLE_VALUE) return FALSE;
+    if (!find_model( inf, env, model, install, ARRAY_SIZE(install) )) goto done;
+
+    lstrcpynW( inf_dir, inf_path, ARRAY_SIZE(inf_dir) );
+    if ((slash = wcsrchr( inf_dir, '\\' ))) *slash = 0;
+
+    /* the install section, decorated for the platform if it is */
+    swprintf( section, ARRAY_SIZE(section), L"%s.%s", install, env_decoration( env ) );
+    if (!SetupFindFirstLineW( inf, section, NULL, &ctx ))
+    {
+        swprintf( section, ARRAY_SIZE(section), L"%s.NT", install );
+        if (!SetupFindFirstLineW( inf, section, NULL, &ctx )) wcscpy( section, install );
+    }
+
+    get_value( inf, section, L"DriverFile", driver, ARRAY_SIZE(driver) );
+    get_value( inf, section, L"ConfigFile", config, ARRAY_SIZE(config) );
+    get_value( inf, section, L"DataFile", data, ARRAY_SIZE(data) );
+    get_value( inf, section, L"HelpFile", help, ARRAY_SIZE(help) );
+    if (SetupFindFirstLineW( inf, section, L"LanguageMonitor", &ctx ) &&
+        get_field( &ctx, 1, monitor, ARRAY_SIZE(monitor) ) && wcschr( monitor, ',' ))
+        *wcschr( monitor, ',' ) = 0;  /* "name,dll": the driver keeps the name */
+    if (SetupFindFirstLineW( inf, section, L"CopyFiles", &ctx ))
+    {
+        DWORD count = SetupGetFieldCount( &ctx ), n;
+        for (n = 1; n <= count; n++)
+            if (get_field( &ctx, n, value, ARRAY_SIZE(value) )) add_copy_files( inf, value, &files );
+    }
+    read_core_sections( inf, section, driver, config, &files );
+    /* an old rule: the section names the driver file when nothing else does */
+    if (!driver[0]) wcscpy( driver, install );
+    if (!data[0]) wcscpy( data, install );
+    if (!config[0]) wcscpy( config, driver );
+
+    source_path( inf, inf_dir, env, driver, src[0], MAX_PATH );
+    source_path( inf, inf_dir, env, data, src[1], MAX_PATH );
+    source_path( inf, inf_dir, env, config, src[2], MAX_PATH );
+    if (help[0]) source_path( inf, inf_dir, env, help, src[3], MAX_PATH );
+
+    for (i = 0, len = 1; i < files.count; i++) len += MAX_PATH + 1;
+    deps = p = calloc( len, sizeof(WCHAR) );
+    for (i = 0; i < files.count; i++)
+    {
+        WCHAR path[MAX_PATH];
+        if (!wcsicmp( files.names[i], driver ) || !wcsicmp( files.names[i], data ) ||
+            !wcsicmp( files.names[i], config )) continue;
+        source_path( inf, inf_dir, env, files.names[i], path, MAX_PATH );
+        if (GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES)
+        {
+            WARN( "%s: no %s in the package\n", debugstr_w(model), debugstr_w(files.names[i]) );
+            continue;
+        }
+        wcscpy( p, path );
+        p += wcslen( p ) + 1;
+    }
+    *p = 0;
+
+    memset( &di, 0, sizeof(di) );
+    di.cVersion = 3;
+    di.pName = (WCHAR *)model;
+    di.pEnvironment = (WCHAR *)env;
+    di.pDriverPath = src[0];
+    di.pDataFile = src[1];
+    di.pConfigFile = src[2];
+    di.pHelpFile = help[0] ? src[3] : NULL;
+    di.pDependentFiles = deps;
+    di.pMonitorName = monitor[0] ? monitor : NULL;
+    di.pDefaultDataType = (WCHAR *)L"NT EMF 1.008";
+    {
+        WCHAR provider[256];
+        if (get_value( inf, L"Version", L"Provider", provider, ARRAY_SIZE(provider) ))
+            di.pszProvider = provider;
+        TRACE( "%s: driver %s data %s config %s monitor %s, %u files\n", debugstr_w(model), debugstr_w(src[0]),
+               debugstr_w(src[1]), debugstr_w(src[2]), debugstr_w(monitor), files.count );
+        ret = AddPrinterDriverExW( NULL, 6, (BYTE *)&di, APD_COPY_ALL_FILES | APD_COPY_FROM_DIRECTORY );
+        if (!ret) WARN( "AddPrinterDriverEx failed %lu\n", GetLastError() );
+    }
+    free( deps );
+
+done:
+    list_free( &files );
+    SetupCloseInfFile( inf );
+    return ret;
+}
+
+/* is this INF a printer driver package naming the model? */
+static BOOL inf_has_model( const WCHAR *path, const WCHAR *model )
+{
+    WCHAR cls[64], install[MAX_PATH];
+    HINF inf;
+    BOOL ret = FALSE;
+
+    inf = SetupOpenInfFileW( path, NULL, INF_STYLE_WIN4, NULL );
+    if (inf == INVALID_HANDLE_VALUE) return FALSE;
+    if (get_value( inf, L"Version", L"Class", cls, ARRAY_SIZE(cls) ) && !wcsicmp( cls, L"Printer" ))
+        ret = find_model( inf, current_env(), model, install, ARRAY_SIZE(install) );
+    SetupCloseInfFile( inf );
+    return ret;
+}
+
+/* the driver store's copy of a package first: it has the files */
+static BOOL find_package( const WCHAR *model, WCHAR *path, DWORD size )
+{
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH];
+    WIN32_FIND_DATAW fd, fd2;
+    HANDLE find, find2;
+
+    GetSystemDirectoryW( dir, ARRAY_SIZE(dir) );
+    swprintf( pattern, ARRAY_SIZE(pattern), L"%s\\DriverStore\\FileRepository\\*", dir );
+    if ((find = FindFirstFileW( pattern, &fd )) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || fd.cFileName[0] == '.') continue;
+            swprintf( pattern, ARRAY_SIZE(pattern), L"%s\\DriverStore\\FileRepository\\%s\\*.inf", dir, fd.cFileName );
+            if ((find2 = FindFirstFileW( pattern, &fd2 )) == INVALID_HANDLE_VALUE) continue;
+            do
+            {
+                swprintf( path, size, L"%s\\DriverStore\\FileRepository\\%s\\%s", dir, fd.cFileName, fd2.cFileName );
+                if (inf_has_model( path, model ))
+                {
+                    FindClose( find2 );
+                    FindClose( find );
+                    return TRUE;
+                }
+            } while (FindNextFileW( find2, &fd2 ));
+            FindClose( find2 );
+        } while (FindNextFileW( find, &fd ));
+        FindClose( find );
+    }
+    GetWindowsDirectoryW( dir, ARRAY_SIZE(dir) );
+    swprintf( pattern, ARRAY_SIZE(pattern), L"%s\\inf\\*.inf", dir );
+    if ((find = FindFirstFileW( pattern, &fd )) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            swprintf( path, size, L"%s\\inf\\%s", dir, fd.cFileName );
+            if (inf_has_model( path, model ))
+            {
+                FindClose( find );
+                return TRUE;
+            }
+        } while (FindNextFileW( find, &fd ));
+        FindClose( find );
+    }
+    return FALSE;
+}
+
+/* Installing a driver writes the machine's printer drivers: an administrator
+ * or the Windows system (SYSTEM) does it, as the spooler does on Windows; a
+ * standard user's programs never try (they would be refused half-way) */
+BOOL can_install_drivers( void )
+{
+    WCHAR dir[MAX_PATH], file[MAX_PATH], *p;
+    DWORD size;
+    HANDLE handle;
+    HKEY key;
+
+#ifdef SG_MUTANT_DRVACCESS
+    return TRUE;
+#endif
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Print\\Environments", 0,
+                         NULL, 0, KEY_SET_VALUE | KEY_CREATE_SUB_KEY, NULL, &key, NULL ))
+        return FALSE;
+    RegCloseKey( key );
+    /* and the drivers' directory: a driver registered without its files
+     * would leave every user a printer that cannot print */
+    if (!GetPrinterDriverDirectoryW( NULL, NULL, 1, (BYTE *)dir, sizeof(dir) - 64, &size )) return FALSE;
+    lstrcatW( dir, L"\\3" );
+    /* made here if it is not yet (a prefix being built): its parents too */
+    for (p = dir + 3; *p; p++)
+    {
+        if (*p != '\\') continue;
+        *p = 0;
+        CreateDirectoryW( dir, NULL );
+        *p = '\\';
+    }
+    CreateDirectoryW( dir, NULL );
+    swprintf( file, ARRAY_SIZE(file), L"%s\\~sgcheck%lx.tmp", dir, GetCurrentProcessId() );
+    handle = CreateFileW( file, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_FLAG_DELETE_ON_CLOSE, NULL );
+    if (handle == INVALID_HANDLE_VALUE) return FALSE;
+    CloseHandle( handle );
+    return TRUE;
+}
+
+/******************************************************************************
+ *          InstallPrinterDriverFromPackageW   [WINSPOOL.@]
+ */
+HRESULT WINAPI InstallPrinterDriverFromPackageW( const WCHAR *server, const WCHAR *inf_path,
+                                                 const WCHAR *driver, const WCHAR *env, DWORD flags )
+{
+    WCHAR path[MAX_PATH];
+
+    TRACE( "%s %s %s %s %#lx\n", debugstr_w(server), debugstr_w(inf_path), debugstr_w(driver),
+           debugstr_w(env), flags );
+    if (!driver) return E_INVALIDARG;
+    if (server && server[0]) FIXME( "remote server %s\n", debugstr_w(server) );
+    if (!can_install_drivers()) return E_ACCESSDENIED;
+    if (!env) env = current_env();
+    if (!inf_path)
+    {
+        if (!find_package( driver, path, ARRAY_SIZE(path) ))
+            return HRESULT_FROM_WIN32( ERROR_UNKNOWN_PRINTER_DRIVER );
+        inf_path = path;
+    }
+    if (!install_from_inf( inf_path, driver, env )) return HRESULT_FROM_WIN32( GetLastError() ?
+                                                                               GetLastError() : ERROR_UNKNOWN_PRINTER_DRIVER );
+    return S_OK;
+}
+
+/******************************************************************************
+ *          InstallPrinterDriverFromPackageA   [WINSPOOL.@]
+ */
+HRESULT WINAPI InstallPrinterDriverFromPackageA( const char *server, const char *inf_path, const char *driver,
+                                                 const char *env, DWORD flags )
+{
+    WCHAR *w[4] = { NULL };
+    const char *a[4] = { server, inf_path, driver, env };
+    HRESULT hr;
+    int i, len;
+
+    for (i = 0; i < 4; i++)
+    {
+        if (!a[i]) continue;
+        len = MultiByteToWideChar( CP_ACP, 0, a[i], -1, NULL, 0 );
+        w[i] = malloc( len * sizeof(WCHAR) );
+        MultiByteToWideChar( CP_ACP, 0, a[i], -1, w[i], len );
+    }
+    hr = InstallPrinterDriverFromPackageW( w[0], w[1], w[2], w[3], flags );
+    for (i = 0; i < 4; i++) free( w[i] );
+    return hr;
+}
+
+/* a cheap fingerprint of the installed packages: names and times */
+static DWORD packages_stamp( void )
+{
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH];
+    WIN32_FIND_DATAW fd;
+    DWORD hash = 2166136261u;
+    HANDLE find;
+    int pass;
+
+    for (pass = 0; pass < 2; pass++)
+    {
+        if (!pass)
+        {
+            GetSystemDirectoryW( dir, ARRAY_SIZE(dir) );
+            swprintf( pattern, ARRAY_SIZE(pattern), L"%s\\DriverStore\\FileRepository\\*", dir );
+        }
+        else
+        {
+            GetWindowsDirectoryW( dir, ARRAY_SIZE(dir) );
+            swprintf( pattern, ARRAY_SIZE(pattern), L"%s\\inf\\*.inf", dir );
+        }
+        if ((find = FindFirstFileW( pattern, &fd )) == INVALID_HANDLE_VALUE) continue;
+        do
+        {
+            const WCHAR *c;
+            for (c = fd.cFileName; *c; c++) hash = (hash ^ towlower( *c )) * 16777619u;
+            hash = (hash ^ fd.ftLastWriteTime.dwLowDateTime) * 16777619u;
+        } while (FindNextFileW( find, &fd ));
+        FindClose( find );
+    }
+    return hash;
+}
