-        (NtQueryDefaultLocale( TRUE, &locale ) || LOWORD(layout) != locale))
+        (NtQueryDefaultLocale( TRUE, &locale ) || LOWORD(layout) != locale) &&
+        !is_loaded_layout( layout ))
