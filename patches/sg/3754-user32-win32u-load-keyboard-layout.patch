-HKL WINAPI LoadKeyboardLayoutW( const WCHAR *name, UINT flags )
+/* Stained Glass OS: the loaded keyboard layouts.  Windows keeps them for the session: here
+ * HKCU\Software\Wine\Temporary System Parameters\Keyboard Layout\Loaded ("1".."n" = the HKL
+ * as a DWORD, volatile like its parent), which win32u reads for NtUserGetKeyboardLayoutList
+ * and ActivateKeyboardLayout once a program has loaded or unloaded a layout.  The Preload
+ * list (the layouts a session starts with) is not touched. */
+#define MAX_LOADED_LAYOUTS 64
+#define LOADED_KEY L"Software\\Wine\\Temporary System Parameters\\Keyboard Layout\\Loaded"
+
+static UINT get_loaded_layouts( HKL *layouts )
 {
-    WCHAR layout_path[MAX_PATH], value[5];
-    LCID locale = GetUserDefaultLCID();
+    UINT count = NtUserGetKeyboardLayoutList( MAX_LOADED_LAYOUTS, layouts );
+    return count > MAX_LOADED_LAYOUTS ? MAX_LOADED_LAYOUTS : count;
+}
+
+static BOOL set_loaded_layouts( const HKL *layouts, UINT count )
+{
+    HKEY loaded;
+    BOOL ret = FALSE;
+    UINT i;
+
+    RegDeleteKeyW( HKEY_CURRENT_USER, LOADED_KEY );
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, LOADED_KEY, 0, NULL, REG_OPTION_VOLATILE, KEY_WRITE, NULL, &loaded, NULL ))
+        return FALSE;
+    for (i = 0; i < count; i++)
+    {
+        WCHAR name[16];
+        DWORD hkl = HandleToUlong( layouts[i] );
+
+        swprintf( name, ARRAY_SIZE(name), L"%u", i + 1 );
+        if (RegSetValueExW( loaded, name, 0, REG_DWORD, (const BYTE *)&hkl, sizeof(hkl) )) goto done;
+    }
+    ret = TRUE;
+done:
+    RegCloseKey( loaded );
+    return ret;
+}
+
+static HKL layout_from_klid( const WCHAR *name )
+{
+    WCHAR layout_path[MAX_PATH], value[5], *end;
     DWORD id, value_size, tmp;
     HKEY hkey;
     HKL layout;
 
-    FIXME_(keyboard)( "name %s, flags %x, semi-stub!\n", debugstr_w( name ), flags );
+    if (!name || !*name || lstrlenW( name ) >= KL_NAMELENGTH) return 0;
+    tmp = wcstoul( name, &end, 16 );
+    if (*end) return 0;
 
-    tmp = wcstoul( name, NULL, 16 );
     if (HIWORD( tmp )) layout = UlongToHandle( tmp );
     else layout = UlongToHandle( MAKELONG( LOWORD( tmp ), LOWORD( tmp ) ) );
 
@@ -440,11 +450,69 @@ HKL WINAPI LoadKeyboardLayoutW( const WCHAR *name, UINT flags )
         RegCloseKey( hkey );
     }
 
-    layout = UlongToHandle( MAKELONG( locale, id ) );
-    if ((flags & KLF_ACTIVATE) && NtUserActivateKeyboardLayout( layout, 0 )) return layout;
+    /* the input language is the KLID's own: it stays a mixed layout / locale pair */
+    return UlongToHandle( MAKELONG( LOWORD( tmp ), id ) );
+}
+
+static HKL load_keyboard_layout( HKL replace, const WCHAR *name, UINT flags )
+{
+    HKL layouts[MAX_LOADED_LAYOUTS + 1], layout;
+    UINT i, j, count;
+
+    if (!(layout = layout_from_klid( name )))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+
+    count = get_loaded_layouts( layouts );
+    if (replace)
+    {
+        for (i = 0; i < count; i++) if (layouts[i] == replace) break;
+        if (i < count)
+        {
+            layouts[i] = layout;
+            /* the same layout twice: the replaced slot goes */
+            for (j = 0; j < count; j++) if (j != i && layouts[j] == layout) break;
+            if (j < count) { memmove( layouts + i, layouts + i + 1, (count - i - 1) * sizeof(*layouts) ); count--; }
+        }
+        else replace = 0;
+    }
+    if (!replace)
+    {
+        for (i = 0; i < count; i++) if (layouts[i] == layout) break;
+        if (i == count)
+        {
+            if (count >= MAX_LOADED_LAYOUTS)
+            {
+                SetLastError( ERROR_OUTOFMEMORY );
+                return 0;
+            }
+            layouts[count++] = layout;
+        }
+    }
+    if (flags & KLF_REORDER)
+    {
+        for (i = 0; i < count; i++) if (layouts[i] == layout) break;
+        memmove( layouts + 1, layouts, i * sizeof(*layouts) );
+        layouts[0] = layout;
+    }
+    if (!set_loaded_layouts( layouts, count ))
+    {
+        SetLastError( ERROR_ACCESS_DENIED );
+        return 0;
+    }
+    if (flags & KLF_ACTIVATE) NtUserActivateKeyboardLayout( layout, 0 );
+    return layout;
+}
 
-    /* FIXME: semi-stub: returning default layout */
-    return get_locale_kbd_layout();
