+/* Stained Glass OS: the layouts loaded by LoadKeyboardLayout / UnloadKeyboardLayout (user32)
+ * for this session are kept in HKCU\Software\Wine\Temporary System Parameters\Keyboard
+ * Layout\Loaded, "1".."n" = the HKL as a DWORD.  Until a program loads or unloads one the
+ * list stays the implicit one below (the locale's layout plus the IMEs installed in HKLM). */
+static UINT get_loaded_layouts( INT size, HKL *layouts )
+{
+    char buffer[64];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    UINT count = 0;
+    HKEY hkey;
+
+    if (!(hkey = reg_open_hkcu_key( "Software\\Wine\\Temporary System Parameters\\Keyboard Layout\\Loaded" ))) return ~0u;
+    for (;;)
+    {
+        WCHAR name[16];
+        char num[16];
+
+        snprintf( num, sizeof(num), "%u", count + 1 );
+        asciiz_to_unicode( name, num );
+        if (!query_reg_value( hkey, name, info, sizeof(buffer) ) || info->Type != REG_DWORD ||
+            info->DataLength != sizeof(DWORD)) break;
+        if (size && layouts)
+        {
+            if (count >= (UINT)size) break;
+            layouts[count] = ULongToHandle( *(const DWORD *)info->Data );
+        }
+        count++;
+    }
+    NtClose( hkey );
+    return count ? count : ~0u;
+}
+
+static BOOL is_loaded_layout( HKL layout )
+{
+    HKL list[128];
+    UINT i, count = get_loaded_layouts( ARRAY_SIZE(list), list );
+
+    if (count == ~0u) return FALSE;
+    for (i = 0; i < count; i++) if (list[i] == layout) return TRUE;
+    return FALSE;
+}
