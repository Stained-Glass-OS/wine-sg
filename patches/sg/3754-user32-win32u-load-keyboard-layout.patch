+    TRACE_(keyboard)( "layout %p, name %s, flags %x\n", layout, debugstr_w( name ), flags );
 
     if (!layout) return NULL;
-    return LoadKeyboardLayoutW( name, flags );
+    return load_keyboard_layout( layout, name, flags );
 }
 
 /***********************************************************************
@@ -480,9 +548,25 @@ HKL WINAPI LoadKeyboardLayoutEx( HKL layout, const WCHAR *name, UINT flags )
  */
 BOOL WINAPI UnloadKeyboardLayout( HKL layout )
 {
-    FIXME_(keyboard)( "layout %p, stub!\n", layout );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    HKL layouts[MAX_LOADED_LAYOUTS + 1];
+    UINT i, count = get_loaded_layouts( layouts );
+
+    TRACE_(keyboard)( "layout %p\n", layout );
+
+    for (i = 0; i < count; i++) if (layouts[i] == layout) break;
+    /* the active layout and the last one stay */
+    if (i == count || count == 1 || layout == NtUserGetKeyboardLayout( 0 ))
+    {
+        SetLastError( ERROR_INVALID_KEYBOARD_HANDLE );
+        return FALSE;
+    }
+    memmove( layouts + i, layouts + i + 1, (count - i - 1) * sizeof(*layouts) );
+    if (!set_loaded_layouts( layouts, count - 1 ))
+    {
+        SetLastError( ERROR_ACCESS_DENIED );
+        return FALSE;
+    }
+    return TRUE;
 }
 
 
