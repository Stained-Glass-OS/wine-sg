+#ifndef SG_MUTANT_NOPROPCOL
+    SHCOLUMNID scid;
+    struct view_prop *vp;
+
+    if (!This->nvprops || !This->pSF2Parent || !len) return FALSE;
+    if (FAILED(IShellFolder2_MapColumnToSCID(This->pSF2Parent, column, &scid))) return FALSE;
+    if (!(vp = find_view_prop(This, pidl, (const PROPERTYKEY *)&scid))) return FALSE;
+    return SUCCEEDED(PropVariantToString(&vp->var, buf, len));
+#else
+    return FALSE;
+#endif
+}
+
+/* the column whose property has this canonical name ("System.Size", or "Size") */
+static int column_of_canonical_name(IShellViewImpl *This, const WCHAR *name, UINT len)
+{
+    SHCOLUMNID scid;
+    UINT i;
+
+    if (!This->pSF2Parent) return -1;
+    for (i = 0; i < This->columns; i++)
+    {
+        WCHAR *canon = NULL;
+        BOOL found = FALSE;
+
+        if (FAILED(IShellFolder2_MapColumnToSCID(This->pSF2Parent, i, &scid))) continue;
+        if (SUCCEEDED(PSGetNameFromPropertyKey((const PROPERTYKEY *)&scid, &canon)) && canon)
+        {
+            const WCHAR *short_name = !wcsnicmp(canon, L"System.", 7) ? canon + 7 : canon;
+            found = (!wcsnicmp(canon, name, len) && !canon[len]) || (!wcsnicmp(short_name, name, len) && !short_name[len]);
+            CoTaskMemFree(canon);
+        }
+        if (found) return i;
+    }
+    return -1;
+}
+
+/* "prop:System.ItemTypeText;System.Size" -> the columns that show those properties */
+static UINT tile_columns_from_list(IShellViewImpl *This, const WCHAR *list, UINT *columns, UINT max)
+{
+    UINT n = 0;
+
+    if (!wcsnicmp(list, L"prop:", 5)) list += 5;
+    while (*list && n < max)
+    {
+        const WCHAR *end = wcschr(list, ';');
+        UINT len = end ? end - list : lstrlenW(list);
+        int col;
+
+        while (len && (*list == '*' || *list == '-' || *list == '~')) { list++; len--; }
+        if (len && (col = column_of_canonical_name(This, list, len)) >= 0) columns[n++] = col;
+        if (!end) break;
+        list = end + 1;
+    }
+    return n;
+}
