+/* wine-sg 3694: a picture of the view's list (and the header a details view has as a
+ * child), in a bitmap the size of its client area */
+static HBITMAP view_snapshot(IShellViewImpl *This, SIZE *size)
+{
+    HWND list = This->hWndList, child;
+    HDC screen, mem;
+    HBITMAP bmp, old;
+    RECT rc;
+
+    if (!list || !IsWindow(list)) return NULL;
+    GetClientRect(list, &rc);
+    if (rc.right <= 0 || rc.bottom <= 0) return NULL;
+    screen = GetDC(NULL);
+    mem = CreateCompatibleDC(screen);
+    bmp = CreateCompatibleBitmap(screen, rc.right, rc.bottom);
+    ReleaseDC(NULL, screen);
+    if (!mem || !bmp) { if (bmp) DeleteObject(bmp); if (mem) DeleteDC(mem); return NULL; }
+    old = SelectObject(mem, bmp);
+    SendMessageW(list, WM_PRINT, (WPARAM)mem, PRF_CLIENT | PRF_ERASEBKGND);
+    for (child = GetWindow(list, GW_CHILD); child; child = GetWindow(child, GW_HWNDNEXT))
+    {
+        RECT cr;
+        POINT org;
+
+        if (!IsWindowVisible(child)) continue;
+        GetWindowRect(child, &cr);
+        MapWindowPoints(NULL, list, (POINT *)&cr, 2);
+        SetViewportOrgEx(mem, cr.left, cr.top, &org);
+        SendMessageW(child, WM_PRINT, (WPARAM)mem, PRF_CLIENT | PRF_ERASEBKGND);
+        SetViewportOrgEx(mem, org.x, org.y, NULL);
+    }
+    SelectObject(mem, old);
+    DeleteDC(mem);
+    size->cx = rc.right;
+    size->cy = rc.bottom;
+    return bmp;
+}
