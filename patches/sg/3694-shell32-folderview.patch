+/* whether the clipboard holds items cut from this view's folder, for IsMoveInSameFolder */
+static BOOL clipboard_is_cut_from_view(IShellViewImpl *This)
+{
+    static const WCHAR fmt_ida[] = L"Shell IDList Array", fmt_effect[] = L"Preferred DropEffect";
+    FORMATETC fe = { 0, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    IDataObject *data;
+    STGMEDIUM med;
+    BOOL ret = FALSE;
+
+    if (!ShellView_FolderPidl(This) || FAILED(OleGetClipboard(&data))) return FALSE;
+    fe.cfFormat = RegisterClipboardFormatW(fmt_effect);
+    if (SUCCEEDED(IDataObject_GetData(data, &fe, &med)))
+    {
+        DWORD *effect = GlobalLock(med.hGlobal);
+
+        if (effect && (*effect & DROPEFFECT_MOVE))
+        {
+            STGMEDIUM ida;
+
+            fe.cfFormat = RegisterClipboardFormatW(fmt_ida);
+            if (SUCCEEDED(IDataObject_GetData(data, &fe, &ida)))
+            {
+                CIDA *cida = GlobalLock(ida.hGlobal);
+
+                if (cida && ILIsEqual((LPCITEMIDLIST)((BYTE *)cida + cida->aoffset[0]), This->folder_pidl))
+                    ret = TRUE;
+                if (cida) GlobalUnlock(ida.hGlobal);
+                ReleaseStgMedium(&ida);
+            }
+        }
+        if (effect) GlobalUnlock(med.hGlobal);
+        ReleaseStgMedium(&med);
+    }
+    IDataObject_Release(data);
+    return ret;
+}
