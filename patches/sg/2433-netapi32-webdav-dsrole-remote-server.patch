From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] netapi32: WebDAV path conversion edge cases, DsRole levels, unreachable servers

From Wine's own netapi32 tests (todo_wine, recorded from Windows):
DavGetHTTPFromUNCPath and DavGetUNCFromHTTPPath return ERROR_BAD_NET_NAME
for malformed names (no leading double slash, empty or "." server, empty
parts, colons), ERROR_BAD_NETPATH for an empty or oversized port, and
accept trailing slashes and "//" as the UNC prefix; the upgrade status and
operation state levels of DsRoleGetPrimaryDomainInformation work; and
NetUserGetInfo/NetUserEnum for another machine return ERROR_BAD_NETPATH
instead of NERR_InvalidComputer. 21 todo_wine marks removed.

Gate: test/netapi32ground-gate.sh (64 and 32 bit; the test tables). Mutants
SG_MUTANT_DAV_PATH, _DAV_PORT, _DAV_TRAIL, SG_MUTANT_NET_REMOTE and
SG_MUTANT_DSROLE are caught.
---
--- a/dlls/netapi32/netapi32.c
+++ b/dlls/netapi32/netapi32.c
@@ -1418,7 +1418,12 @@ NetUserGetInfo(LPCWSTR servername, LPCWSTR username, DWORD level,
     {
         FIXME("Only implemented for local computer, but remote server"
               "%s was requested.\n", debugstr_w(servername));
+        /* a machine that cannot be reached is a bad network path */
+#ifndef SG_MUTANT_NET_REMOTE
+        return ERROR_BAD_NETPATH;
+#else
         return NERR_InvalidComputer;
+#endif
     }
 
     if(!NETAPI_FindUser(username) && !NETAPI_IsCurrentUser(username))
@@ -1877,7 +1882,12 @@ NetUserEnum(LPCWSTR servername, DWORD level, DWORD filter, LPBYTE* bufptr,
     {
         FIXME("Only implemented for local computer, but remote server"
               "%s was requested.\n", debugstr_w(servername));
+        /* a machine that cannot be reached is a bad network path */
+#ifndef SG_MUTANT_NET_REMOTE
+        return ERROR_BAD_NETPATH;
+#else
         return NERR_InvalidComputer;
+#endif
     }
 
     if (!GetUserNameW(user, &len)) return GetLastError();
@@ -2641,6 +2651,9 @@ DWORD WINAPI DsRoleGetPrimaryDomainInformation(
     if (!Buffer) return ERROR_INVALID_PARAMETER;
     if ((InfoLevel < DsRolePrimaryDomainInfoBasic) || (InfoLevel > DsRoleOperationState)) return ERROR_INVALID_PARAMETER;
 
+#ifdef SG_MUTANT_DSROLE
+    if (InfoLevel != DsRolePrimaryDomainInfoBasic) return ERROR_CALL_NOT_IMPLEMENTED;
+#endif
     *Buffer = NULL;
     switch (InfoLevel)
     {
@@ -2685,6 +2698,28 @@ DWORD WINAPI DsRoleGetPrimaryDomainInformation(
             LsaFreeMemory(DomainInfo);
         }
         break;
+    case DsRoleUpgradeStatus:
+    {
+        /* a stand-alone machine is not being upgraded from a domain controller */
+        PDSROLE_UPGRADE_STATUS_INFO upgrade = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*upgrade));
+
+        if (!upgrade) return ERROR_OUTOFMEMORY;
+        upgrade->OperationState = 0;
+        upgrade->PreviousServerState = DsRoleServerUnknown;
+        *Buffer = (PBYTE)upgrade;
+        ret = ERROR_SUCCESS;
+        break;
+    }
+    case DsRoleOperationState:
+    {
+        PDSROLE_OPERATION_STATE_INFO state = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*state));
+
+        if (!state) return ERROR_OUTOFMEMORY;
+        state->OperationState = DsRoleOperationIdle;
+        *Buffer = (PBYTE)state;
+        ret = ERROR_SUCCESS;
+        break;
+    }
     default:
         ret = ERROR_CALL_NOT_IMPLEMENTED;
     }
@@ -2929,11 +2964,13 @@ DWORD WINAPI DavGetHTTPFromUNCPath(const WCHAR *unc_path, WCHAR *buf, DWORD *buf
 
     TRACE("(%s %p %p)\n", debugstr_w(unc_path), buf, buflen);
 
-    if (p[0] != '\\' || p[1] != '\\' || !p[2]) return ERROR_INVALID_PARAMETER;
+    if (!buflen) return ERROR_INVALID_PARAMETER;
+    if ((p[0] != '\\' && p[0] != '/') || (p[1] != '\\' && p[1] != '/') || !p[2]) return ERROR_BAD_NET_NAME;
     q = p += 2;
     while (*q && *q != '\\' && *q != '/' && *q != '@') q++;
     server = p;
     len_server = q - p;
+    if (!len_server || (len_server == 1 && *server == '.')) return ERROR_BAD_NET_NAME;
     if (*q == '@')
     {
         p = ++q;
@@ -2954,6 +2991,15 @@ DWORD WINAPI DavGetHTTPFromUNCPath(const WCHAR *unc_path, WCHAR *buf, DWORD *buf
     if (*q == '\\' || *q  == '/') q++;
     path = q;
     while (*q++) len_path++;
+    /* what is left is a path: no empty parts and no drive or port colons; one slash may end it */
+#ifndef SG_MUTANT_DAV_PATH
+    for (i = 0; i < len_path; i++)
+    {
+        if (path[i] == ':') return ERROR_BAD_NET_NAME;
+        if ((path[i] == '\\' || path[i] == '/') && (!i || path[i - 1] == '\\' || path[i - 1] == '/'))
+            return ERROR_BAD_NET_NAME;
+    }
+#endif
     if (len_path && (path[len_path - 1] == '\\' || path[len_path - 1] == '/'))
         len_path--; /* remove trailing slash */
 
@@ -3025,27 +3071,34 @@ DWORD WINAPI DavGetUNCFromHTTPPath(const WCHAR *http_path, WCHAR *buf, DWORD *bu
     else if (len == ARRAY_SIZE(httpsW) && !wcsnicmp( http_path, httpsW, len )) ssl = TRUE;
     else return ERROR_INVALID_PARAMETER;
 
-    if (p[0] != ':' || p[1] != '/' || p[2] != '/') return ERROR_INVALID_PARAMETER;
+    if (p[0] != ':') return ERROR_INVALID_PARAMETER;
+    if (p[1] != '/' || p[2] != '/') return ERROR_BAD_NET_NAME;
     server = p += 3;
 
     while (*p && *p != ':' && *p != '/') { p++; len_server++; };
-    if (!len_server) return ERROR_BAD_NET_NAME;
+    if (!len_server) return ERROR_BAD_NETPATH;
     if (*p == ':')
     {
         port = ++p;
         while (*p >= '0' && *p <= '9') { p++; len_port++; };
+#ifndef SG_MUTANT_DAV_PORT
+        if (!len_port || (len_port > 5) || (len_port == 5 && wcsncmp( port, L"65535", 5 ) > 0)) return ERROR_BAD_NETPATH;
+#endif
         if (len_port == 2 && !ssl && !memcmp( port, port80W, sizeof(port80W) )) port = NULL;
         else if (len_port == 3 && ssl && !memcmp( port, port443W, sizeof(port443W) )) port = NULL;
         path = p;
     }
     else if (*p == '/') path = p;
 
-    while (*p)
-    {
-        if (p[0] == '/' && p[1] == '/') return ERROR_BAD_NET_NAME;
-        p++; len_path++;
-    }
+    while (*p) { p++; len_path++; }
+    /* trailing slashes are dropped, but not an empty part in the middle */
+#ifndef SG_MUTANT_DAV_TRAIL
+    while (len_path && path[len_path - 1] == '/') len_path--;
+#else
     if (len_path && path[len_path - 1] == '/') len_path--;
+#endif
+    for (i = 0; i + 1 < len_path; i++)
+        if (path[i] == '/' && path[i + 1] == '/') return ERROR_BAD_NET_NAME;
 
     len = len_server + 2; /* \\ */
     if (ssl) len += 4; /* @SSL */
