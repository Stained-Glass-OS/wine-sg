         {L"\\\\a",                  ERROR_SUCCESS, L"http://a"},
         {L"\\\\a\\",                ERROR_SUCCESS, L"http://a"},
         {L"\\\\a\\b",               ERROR_SUCCESS, L"http://a/b"},
@@ -325,12 +322,12 @@ static void test_DavGetHTTPFromUNCPath(void)
         {L"\\\\a/b",                ERROR_SUCCESS, L"http://a/b"},
         {L"\\\\a.\\b",              ERROR_SUCCESS, L"http://a./b"},
         {L"\\\\.a\\b",              ERROR_SUCCESS, L"http://.a/b"},
