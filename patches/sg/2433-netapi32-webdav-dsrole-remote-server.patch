         {L"http://server:81",       ERROR_SUCCESS, L"\\\\server@81\\DavWWWRoot"},
         {L"https://server:80",      ERROR_SUCCESS, L"\\\\server@SSL@80\\DavWWWRoot"},
         {L"HTTP://server/path",     ERROR_SUCCESS, L"\\\\server\\DavWWWRoot\\path"},
