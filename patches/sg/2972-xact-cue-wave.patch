From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] xactengine: cue channel map/volume, output voices, PrepareInMemoryWave/PrepareStreamingWave through FACT

xactengine: cue channel map/volume, output voices, PrepareInMemoryWave/PrepareStreamingWave through FACT
---
diff --git a/dlls/xactengine3_7/xact_dll.c b/dlls/xactengine3_7/xact_dll.c
index cf67331..99e9dc1 100644
--- a/dlls/xactengine3_7/xact_dll.c
+++ b/dlls/xactengine3_7/xact_dll.c
@@ -162,6 +162,13 @@ typedef struct _XACT3CueImpl {
     IXACT3Cue IXACT3Cue_iface;
     FACTCue *fact_cue;
     XACT3EngineImpl *engine;
+#if XACT3_VER < 0x0300
+    /* FACT has no per-cue channel routing: the settings are only kept for the application */
+    XACTCHANNELMAPENTRY *map_entries;
+    XACTCHANNEL map_count;
+    XACTCHANNELVOLUMEENTRY *volume_entries;
+    XACTCHANNEL volume_count;
+#endif
 } XACT3CueImpl;
 
 static inline XACT3CueImpl *impl_from_IXACT3Cue(IXACT3Cue *iface)
@@ -207,6 +214,10 @@ static HRESULT WINAPI IXACT3CueImpl_Destroy(IXACT3Cue *iface)
     if (ret != 0)
         WARN("FACTCue_Destroy returned %d\n", ret);
     wrapper_remove_entry(This->engine, This->fact_cue);
+#if XACT3_VER < 0x0300
+    HeapFree(GetProcessHeap(), 0, This->map_entries);
+    HeapFree(GetProcessHeap(), 0, This->volume_entries);
+#endif
     HeapFree(GetProcessHeap(), 0, This);
     return S_OK;
 }
@@ -216,30 +227,81 @@ static HRESULT WINAPI IXACT3CueImpl_Destroy(IXACT3Cue *iface)
 static HRESULT WINAPI IXACT3CueImpl_GetChannelMap(IXACT3Cue *iface,
         XACTCHANNELMAP *map, DWORD size, DWORD *needed_size)
 {
-    FIXME("(%p)->(%p, %lu, %p)\n", iface, map, size, needed_size);
+    XACT3CueImpl *This = impl_from_IXACT3Cue(iface);
+    DWORD needed = sizeof(*map) + This->map_count * sizeof(*This->map_entries);
 
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p, %lu, %p)\n", iface, map, size, needed_size);
+
+    if (!needed_size) return E_POINTER;
+    *needed_size = needed;
+    if (!map || size < needed) return E_INVALIDARG;
+
+    map->EntryCount = This->map_count;
+    map->paEntries = (XACTCHANNELMAPENTRY *)(map + 1);
+    memcpy(map->paEntries, This->map_entries, This->map_count * sizeof(*This->map_entries));
+
+    return S_OK;
 }
 
 static HRESULT WINAPI IXACT3CueImpl_SetChannelMap(IXACT3Cue *iface, XACTCHANNELMAP *map)
 {
-    FIXME("(%p)->(%p)\n", iface, map);
+    XACT3CueImpl *This = impl_from_IXACT3Cue(iface);
+    XACTCHANNELMAPENTRY *entries = NULL;
 
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", iface, map);
+
+    if (!map || (map->EntryCount && !map->paEntries)) return E_POINTER;
+
+    if (map->EntryCount)
+    {
+        if (!(entries = HeapAlloc(GetProcessHeap(), 0, map->EntryCount * sizeof(*entries))))
+            return E_OUTOFMEMORY;
+        memcpy(entries, map->paEntries, map->EntryCount * sizeof(*entries));
+    }
+    HeapFree(GetProcessHeap(), 0, This->map_entries);
+    This->map_entries = entries;
+    This->map_count = map->EntryCount;
+
+    return S_OK;
 }
 
 static HRESULT WINAPI IXACT3CueImpl_GetChannelVolume(IXACT3Cue *iface, XACTCHANNELVOLUME *volume)
 {
-    FIXME("(%p)->(%p)\n", iface, volume);
+    XACT3CueImpl *This = impl_from_IXACT3Cue(iface);
 
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", iface, volume);
+
+    if (!volume) return E_POINTER;
+
+    /* the caller's EntryCount is the capacity of paEntries, the stored count is returned */
+    if (volume->paEntries)
+        memcpy(volume->paEntries, This->volume_entries,
+                min(volume->EntryCount, This->volume_count) * sizeof(*This->volume_entries));
+    volume->EntryCount = This->volume_count;
+
+    return S_OK;
 }
 
 static HRESULT WINAPI IXACT3CueImpl_SetChannelVolume(IXACT3Cue *iface, XACTCHANNELVOLUME *volume)
 {
-    FIXME("(%p)->(%p)\n", iface, volume);
+    XACT3CueImpl *This = impl_from_IXACT3Cue(iface);
+    XACTCHANNELVOLUMEENTRY *entries = NULL;
 
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", iface, volume);
+
+    if (!volume || (volume->EntryCount && !volume->paEntries)) return E_POINTER;
+
+    if (volume->EntryCount)
+    {
+        if (!(entries = HeapAlloc(GetProcessHeap(), 0, volume->EntryCount * sizeof(*entries))))
+            return E_OUTOFMEMORY;
+        memcpy(entries, volume->paEntries, volume->EntryCount * sizeof(*entries));
+    }
+    HeapFree(GetProcessHeap(), 0, This->volume_entries);
+    This->volume_entries = entries;
+    This->volume_count = volume->EntryCount;
+
+    return S_OK;
 }
 
 #endif
@@ -320,8 +382,12 @@ static HRESULT WINAPI IXACT3CueImpl_SetOutputVoices(IXACT3Cue *iface,
         const XAUDIO2_VOICE_SENDS *pSendList)
 {
     XACT3CueImpl *This = impl_from_IXACT3Cue(iface);
-    FIXME("(%p)->(%p): stub!\n", This, pSendList);
-    return S_OK;
+
+    TRACE("(%p)->(%p)\n", This, pSendList);
+
+    /* XAudio2 voices of the application cannot be mapped to FAudio voices here: the cue
+     * keeps playing to the engine's output, which is what FACT does with a send list */
+    return FACTCue_SetOutputVoices(This->fact_cue, NULL);
 }
 
 static HRESULT WINAPI IXACT3CueImpl_SetOutputVoiceMatrix(IXACT3Cue *iface,
@@ -329,9 +395,17 @@ static HRESULT WINAPI IXACT3CueImpl_SetOutputVoiceMatrix(IXACT3Cue *iface,
         UINT32 DestinationChannels, const float *pLevelMatrix)
 {
     XACT3CueImpl *This = impl_from_IXACT3Cue(iface);
-    FIXME("(%p)->(%p %u %u %p): stub!\n", This, pDestinationVoice, SourceChannels,
+
+    TRACE("(%p)->(%p %u %u %p)\n", This, pDestinationVoice, SourceChannels,
+            DestinationChannels, pLevelMatrix);
+
+    /* the default destination is the cue's own output */
+    if (!pDestinationVoice)
+        return FACTCue_SetMatrixCoefficients(This->fact_cue, SourceChannels,
+                DestinationChannels, (float *)pLevelMatrix);
+
+    return FACTCue_SetOutputVoiceMatrix(This->fact_cue, NULL, SourceChannels,
             DestinationChannels, pLevelMatrix);
-    return S_OK;
 }
 #endif
 
@@ -1313,14 +1387,68 @@ static HRESULT WINAPI IXACT3EngineImpl_CreateStreamingWaveBank(IXACT3Engine *ifa
 
 #if XACT3_VER >= 0x0205
 
+static HRESULT xact3_wrap_wave(XACT3EngineImpl *This, FACTWave *fwave, IXACT3Wave **ppWave)
+{
+    XACT3WaveImpl *wave;
+    HRESULT hr;
+
+    wave = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*wave));
+    if (!wave)
+    {
+        FACTWave_Destroy(fwave);
+        return E_OUTOFMEMORY;
+    }
+
+    hr = wrapper_add_entry(This, fwave, &wave->IXACT3Wave_iface);
+    if (FAILED(hr))
+    {
+        FACTWave_Destroy(fwave);
+        HeapFree(GetProcessHeap(), 0, wave);
+        return hr;
+    }
+
+    wave->IXACT3Wave_iface.lpVtbl = &XACT3Wave_Vtbl;
+    wave->fact_wave = fwave;
+    wave->engine = This;
+    *ppWave = &wave->IXACT3Wave_iface;
+
+    TRACE("Created Wave: %p\n", wave);
+
+    return S_OK;
+}
+
 static HRESULT WINAPI IXACT3EngineImpl_PrepareInMemoryWave(IXACT3Engine *iface,
         DWORD dwFlags, WAVEBANKENTRY entry, DWORD *pdwSeekTable,
         BYTE *pbWaveData, DWORD dwPlayOffset, XACTLOOPCOUNT nLoopCount,
         IXACT3Wave **ppWave)
 {
     XACT3EngineImpl *This = impl_from_IXACT3Engine(iface);
-    FIXME("(%p): stub!\n", This);
+    FACTWave *fwave = NULL;
+    UINT ret;
+
+    TRACE("(%p)->(0x%08lx, %p, %p, %lu, %d, %p)\n", This, dwFlags, pbWaveData, pdwSeekTable,
+            dwPlayOffset, nLoopCount, ppWave);
+
+#ifndef SG_MUTANT_WAVE_PTR
+    if (!ppWave) return E_POINTER;
+#endif
+#ifndef SG_MUTANT_WAVE_ARGS
+    if (!pbWaveData) return E_INVALIDARG;
+#endif
+#ifdef SG_MUTANT_WAVE_INMEM
     return E_NOTIMPL;
+#endif
+
+    ret = FACTAudioEngine_PrepareInMemoryWave(This->fact_engine, dwFlags,
+            *(FACTWaveBankEntry *)&entry, (uint32_t *)pdwSeekTable, pbWaveData,
+            dwPlayOffset, nLoopCount, &fwave);
+    if (ret != 0 || !fwave)
+    {
+        ERR("Failed to PrepareInMemoryWave: %d (%p)\n", ret, fwave);
+        return E_FAIL;
+    }
+
+    return xact3_wrap_wave(This, fwave, ppWave);
 }
 
 static HRESULT WINAPI IXACT3EngineImpl_PrepareStreamingWave(IXACT3Engine *iface,
@@ -1330,8 +1458,41 @@ static HRESULT WINAPI IXACT3EngineImpl_PrepareStreamingWave(IXACT3Engine *iface,
         IXACT3Wave **ppWave)
 {
     XACT3EngineImpl *This = impl_from_IXACT3Engine(iface);
-    FIXME("(%p): stub!\n", This);
+    FACTStreamingParameters fakeParms;
+    wrap_readfile_struct *fake;
+    FACTWave *fwave = NULL;
+    UINT ret;
+
+    TRACE("(%p)->(0x%08lx, %lu, %p, %lu, %d, %p)\n", This, dwFlags, dwAlignment,
+            pdwSeekTable, dwPlayOffset, nLoopCount, ppWave);
+
+#ifndef SG_MUTANT_WAVE_SPTR
+    if (!ppWave) return E_POINTER;
+#endif
+#ifdef SG_MUTANT_WAVE_STREAM
     return E_NOTIMPL;
+#endif
+
+    /* the file has to be wrapped to fix up the callbacks, as for streaming wave banks */
+    if (!(fake = CoTaskMemAlloc(sizeof(*fake)))) return E_OUTOFMEMORY;
+    fake->engine = This;
+    fake->file = streamingParams.file;
+    fakeParms.file = fake;
+    fakeParms.flags = streamingParams.flags;
+    fakeParms.offset = streamingParams.offset;
+    fakeParms.packetSize = streamingParams.packetSize;
+
+    ret = FACTAudioEngine_PrepareStreamingWave(This->fact_engine, dwFlags,
+            *(FACTWaveBankEntry *)&entry, fakeParms, dwAlignment, (uint32_t *)pdwSeekTable,
+            NULL, dwPlayOffset, nLoopCount, &fwave);
+    if (ret != 0 || !fwave)
+    {
+        ERR("Failed to PrepareStreamingWave: %d (%p)\n", ret, fwave);
+        CoTaskMemFree(fake);
+        return E_FAIL;
+    }
+
+    return xact3_wrap_wave(This, fwave, ppWave);
 }
 
 static HRESULT WINAPI IXACT3EngineImpl_PrepareWave(IXACT3Engine *iface,
