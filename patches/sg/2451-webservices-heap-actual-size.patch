From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] webservices: heap actual size counts chunks

Ground truth from Wine's reader tests (3 todo_wine marks removed): WS_HEAP_PROPERTY_ACTUAL_SIZE is no longer the requested size. Memory comes in chunks, the first of 128 bytes and each next twice as big as the one before (or as big as the allocation needs); the actual size is what they add up to (16 bytes asked: 128; 129 bytes: 128 + 256 = 384) and a reset keeps the first chunk (128).
---
--- a/dlls/webservices/heap.c
+++ b/dlls/webservices/heap.c
@@ -45,11 +45,35 @@ struct heap
     HANDLE           handle;
     SIZE_T           max_size;
     SIZE_T           allocated;
+    SIZE_T           chunks;       /* what the pages behind the allocations add up to (the actual size) */
+    SIZE_T           chunk_size;   /* the newest chunk */
+    SIZE_T           chunk_used;
     ULONG            prop_count;
     struct prop      prop[ARRAY_SIZE( heap_props )];
 };
 
 #define HEAP_MAGIC (('H' << 24) | ('E' << 16) | ('A' << 8) | 'P')
+#define HEAP_FIRST_CHUNK 128
+
+/* Windows takes memory in chunks: the first holds 128 bytes and every one after it is twice as big as the one before
+ * (or as big as the allocation needs).  What the chunks add up to is the heap's actual size. */
+static void account_alloc( struct heap *heap, SIZE_T size )
+{
+#ifndef SG_MUTANT_WSHEAP_ACTUAL
+    if (!size) return;
+    if (!heap->chunk_size || size > heap->chunk_size - heap->chunk_used)
+    {
+        SIZE_T next = heap->chunk_size ? heap->chunk_size * 2 : HEAP_FIRST_CHUNK;
+        while (next < size) next *= 2;
+        heap->chunks += next;
+        heap->chunk_size = next;
+        heap->chunk_used = 0;
+    }
+    heap->chunk_used += size;
+#else
+    heap->chunks += size;
+#endif
+}
 
 static BOOL ensure_heap( struct heap *heap )
 {
@@ -71,7 +95,7 @@ void *ws_alloc( WS_HEAP *handle, SIZE_T size )
 
     if (heap->magic != HEAP_MAGIC) goto done;
     if (!ensure_heap( heap ) || size > heap->max_size - heap->allocated) goto done;
-    if ((ret = HeapAlloc( heap->handle, 0, size ))) heap->allocated += size;
+    if ((ret = HeapAlloc( heap->handle, 0, size ))) { heap->allocated += size; account_alloc( heap, size ); }
 
 done:
     LeaveCriticalSection( &heap->cs );
@@ -87,7 +111,7 @@ void *ws_alloc_zero( WS_HEAP *handle, SIZE_T size )
 
     if (heap->magic != HEAP_MAGIC) goto done;
     if (!ensure_heap( heap ) || size > heap->max_size - heap->allocated) goto done;
-    if ((ret = HeapAlloc( heap->handle, HEAP_ZERO_MEMORY, size ))) heap->allocated += size;
+    if ((ret = HeapAlloc( heap->handle, HEAP_ZERO_MEMORY, size ))) { heap->allocated += size; account_alloc( heap, size ); }
 
 done:
     LeaveCriticalSection( &heap->cs );
@@ -106,7 +130,7 @@ void *ws_realloc( WS_HEAP *handle, void *ptr, SIZE_T old_size, SIZE_T new_size )
     {
         SIZE_T size = new_size - old_size;
         if (size > heap->max_size - heap->allocated) goto done;
-        if ((ret = HeapReAlloc( heap->handle, 0, ptr, new_size ))) heap->allocated += size;
+        if ((ret = HeapReAlloc( heap->handle, 0, ptr, new_size ))) { heap->allocated += size; account_alloc( heap, size ); }
     }
     else
     {
@@ -131,7 +155,7 @@ void *ws_realloc_zero( WS_HEAP *handle, void *ptr, SIZE_T old_size, SIZE_T new_s
     {
         SIZE_T size = new_size - old_size;
         if (size > heap->max_size - heap->allocated) goto done;
-        if ((ret = HeapReAlloc( heap->handle, HEAP_ZERO_MEMORY, ptr, new_size ))) heap->allocated += size;
+        if ((ret = HeapReAlloc( heap->handle, HEAP_ZERO_MEMORY, ptr, new_size ))) { heap->allocated += size; account_alloc( heap, size ); }
     }
     else
     {
@@ -219,6 +243,10 @@ static void reset_heap( struct heap *heap )
     if (heap->handle) HeapDestroy( heap->handle );
     heap->handle   = NULL;
     heap->max_size = heap->allocated = 0;
+    /* a reset keeps the first chunk */
+    heap->chunks = heap->chunks ? HEAP_FIRST_CHUNK : 0;
+    heap->chunk_size = heap->chunks;
+    heap->chunk_used = 0;
 }
 
 /**************************************************************************
@@ -307,7 +335,7 @@ HRESULT WINAPI WsGetHeapProperty( WS_HEAP *handle, WS_HEAP_PROPERTY_ID id, void
     {
         SIZE_T *heap_size = buf;
         if (!buf || size != sizeof(heap_size)) hr = E_INVALIDARG;
-        else *heap_size = heap->allocated;
+        else *heap_size = (id == WS_HEAP_PROPERTY_ACTUAL_SIZE) ? heap->chunks : heap->allocated;
         break;
     }
     default:
--- a/dlls/webservices/tests/reader.c
+++ b/dlls/webservices/tests/reader.c
@@ -2134,7 +2134,7 @@ static void test_WsAlloc(void)
     size = sizeof(actual);
     hr = WsGetHeapProperty( heap, WS_HEAP_PROPERTY_ACTUAL_SIZE, &actual, size, NULL );
     ok( hr == S_OK, "got %#lx\n", hr );
-    todo_wine ok( actual == 128, "got %Iu\n", actual );
+    ok( actual == 128, "got %Iu\n", actual );
 
     WsFreeHeap( heap );
 }
@@ -3574,7 +3574,7 @@ static void test_WsResetHeap(void)
     size = sizeof(actual);
     hr = WsGetHeapProperty( heap, WS_HEAP_PROPERTY_ACTUAL_SIZE, &actual, size, NULL );
     ok( hr == S_OK, "got %#lx\n", hr );
-    todo_wine ok( actual == 384, "got %Iu\n", actual );
+    ok( actual == 384, "got %Iu\n", actual );
 
     hr = WsResetHeap( NULL, NULL );
     ok( hr == E_INVALIDARG, "got %#lx\n", hr );
@@ -3592,7 +3592,7 @@ static void test_WsResetHeap(void)
     size = sizeof(actual);
     hr = WsGetHeapProperty( heap, WS_HEAP_PROPERTY_ACTUAL_SIZE, &actual, size, NULL );
     ok( hr == S_OK, "got %#lx\n", hr );
-    todo_wine ok( actual == 128, "got %Iu\n", actual );
+    ok( actual == 128, "got %Iu\n", actual );
 
     WsFreeHeap( heap );
 }
