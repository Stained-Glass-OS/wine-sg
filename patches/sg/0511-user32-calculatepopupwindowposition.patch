From: Stained Glass OS <dev@stained-glass.example>
Subject: user32: CalculatePopupWindowPosition

Word delay-loads it for the flyout its "Sign in or create account" button
opens; the missing export ended Word with an unhandled 0xc06d007f.

A popup of the given size is aligned on the anchor as the TPM_ flags ask
(TPM_LAYOUTRTL mirrors the horizontal alignment), kept inside the anchor's
monitor -- or its work area with TPM_WORKAREA -- flipping to the anchor's
other side at an edge, and kept out of the exclude rectangle along its
primary axis: below or above it with TPM_VERTICAL, beside it otherwise.

--- a/include/winuser.h
+++ b/include/winuser.h
@@ -1652,6 +1652,7 @@
 #define TPM_VERNEGANIMATION 0x2000
 #define TPM_NOANIMATION     0x4000
 #define TPM_LAYOUTRTL       0x8000
+#define TPM_WORKAREA        0x10000
 
 typedef struct tagTPMPARAMS
 {
@@ -3890,6 +3891,7 @@
 WINUSERAPI LONG        WINAPI BroadcastSystemMessageExW(DWORD,LPDWORD,UINT,WPARAM,LPARAM,PBSMINFO);
 #define                       BroadcastSystemMessageEx WINELIB_NAME_AW(BroadcastSystemMessageEx)
 WINUSERAPI void        WINAPI CalcChildScroll(HWND, INT);
+WINUSERAPI BOOL        WINAPI CalculatePopupWindowPosition(const POINT*,const SIZE*,UINT,RECT*,RECT*);
 WINUSERAPI BOOL        WINAPI CallMsgFilterA(LPMSG,INT);
 WINUSERAPI BOOL        WINAPI CallMsgFilterW(LPMSG,INT);
 #define                       CallMsgFilter WINELIB_NAME_AW(CallMsgFilter)
--- a/dlls/user32/menu.c
+++ b/dlls/user32/menu.c
@@ -946,3 +946,85 @@
         return 0;
     }
 }
+
+/* One axis of a popup: 'align' is 0 (the anchor starts the popup), 1 (the
+ * anchor is its centre) or 2 (the anchor ends it).  The popup keeps out of
+ * [ex_lo, ex_hi) when 'exclude' is set, flipping to the other side when it
+ * would leave [lo, hi), and is finally pushed inside [lo, hi). */
+static LONG popup_axis( LONG anchor, LONG size, int align, BOOL exclude,
+                        LONG ex_lo, LONG ex_hi, LONG lo, LONG hi )
+{
+    LONG pos;
+
+    if (align == 2)
+    {
+        pos = anchor - size;
+        if (exclude && pos + size > ex_lo && pos < ex_hi) pos = ex_lo - size;
+        if (pos < lo) pos = exclude ? ex_hi : anchor;
+    }
+    else
+    {
+        pos = align == 1 ? anchor - size / 2 : anchor;
+        if (exclude && pos + size > ex_lo && pos < ex_hi) pos = ex_hi;
+        if (pos + size > hi) pos = (exclude ? ex_lo : anchor) - size;
+    }
+    if (pos + size > hi) pos = hi - size;
+    if (pos < lo) pos = lo;
+    return pos;
+}
+
+/**********************************************************************
+ *      CalculatePopupWindowPosition   (USER32.@)
+ *
+ * Where a popup of the given size goes for an anchor point: aligned as the
+ * TPM_ flags ask, inside the anchor's monitor (or its work area with
+ * TPM_WORKAREA), and clear of the exclude rectangle -- moved past it along
+ * the flags' primary axis (TPM_VERTICAL or horizontal).
+ */
+BOOL WINAPI CalculatePopupWindowPosition( const POINT *anchor, const SIZE *size, UINT flags,
+                                          RECT *exclude, RECT *popup )
+{
+    MONITORINFO info = { sizeof(info) };
+    const RECT *bounds;
+    int halign, valign;
+    BOOL vertical, has_ex;
+    LONG x, y;
+
+    TRACE( "%p %p %#x %s %p\n", anchor, size, flags, wine_dbgstr_rect( exclude ), popup );
+
+    if (!anchor || !size || !popup)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    if (!GetMonitorInfoW( MonitorFromPoint( *anchor, MONITOR_DEFAULTTONEAREST ), &info ))
+        return FALSE;
+    bounds = (flags & TPM_WORKAREA) ? &info.rcWork : &info.rcMonitor;
+
+    if (flags & TPM_LAYOUTRTL) flags ^= TPM_RIGHTALIGN;
+    halign = (flags & TPM_RIGHTALIGN) ? 2 : (flags & TPM_CENTERALIGN) ? 1 : 0;
+    valign = (flags & TPM_BOTTOMALIGN) ? 2 : (flags & TPM_VCENTERALIGN) ? 1 : 0;
+    vertical = !!(flags & TPM_VERTICAL);
+    has_ex = exclude && !IsRectEmpty( exclude );
+
+    /* the secondary axis only aligns and fits; the popup then keeps out of
+     * the exclude rectangle along the primary axis if the two still overlap */
+    if (vertical)
+    {
+        x = popup_axis( anchor->x, size->cx, halign, FALSE, 0, 0, bounds->left, bounds->right );
+        has_ex = has_ex && x + size->cx > exclude->left && x < exclude->right;
+        y = popup_axis( anchor->y, size->cy, valign, has_ex, has_ex ? exclude->top : 0,
+                        has_ex ? exclude->bottom : 0, bounds->top, bounds->bottom );
+    }
+    else
+    {
+        y = popup_axis( anchor->y, size->cy, valign, FALSE, 0, 0, bounds->top, bounds->bottom );
+        has_ex = has_ex && y + size->cy > exclude->top && y < exclude->bottom;
+        x = popup_axis( anchor->x, size->cx, halign, has_ex, has_ex ? exclude->left : 0,
+                        has_ex ? exclude->right : 0, bounds->left, bounds->right );
+    }
+
+    SetRect( popup, x, y, x + size->cx, y + size->cy );
+    return TRUE;
+}
--- a/dlls/user32/user32.spec
+++ b/dlls/user32/user32.spec
@@ -244,7 +244,7 @@
