From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxdeploymentclient: A user's stale package registrations go at their next start (6043)

As AppReadiness does at sign-in: a user's first package query in a
process drops the user's registrations of packages SYSTEM removed for
all users (HKLM\Software\Wine\AppModel\RemovedPackages, written by the
removal, cleared by a new install) and of packages whose content is gone
(their folder missing, and for a package with external content that
content too). Start menu entries, aliases and classes go with them; the
files are not the user's and stay. Development and staged registrations
stay. A family's version whose external content is there counts as
available.
---
diff --git a/dlls/appxdeploymentclient/deploy.c b/dlls/appxdeploymentclient/deploy.c
index 22ca99f..b9ba7c2 100644
--- a/dlls/appxdeploymentclient/deploy.c
+++ b/dlls/appxdeploymentclient/deploy.c
@@ -304,6 +304,41 @@ static HKEY other_hive(void)
 }
 
 /* The record, and what the installation made: shortcuts, aliases, resource packages. */
+/* Stained Glass OS: the packages SYSTEM removed for all users, by full name, so that each user's
+ * registration of them goes at the user's next start (cleanup_stale_user_records), as AppReadiness
+ * drops them at sign-in on Windows. */
+static const WCHAR removed_keyW[] = L"Software\\Wine\\AppModel\\RemovedPackages";
+
+static void set_removed_for_all( const WCHAR *full_name, BOOL removed )
+{
+    HKEY key;
+
+    if (!removed)
+    {
+        if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, removed_keyW, 0, KEY_SET_VALUE | KEY_WOW64_64KEY, &key ))
+        {
+            RegDeleteValueW( key, full_name );
+            RegCloseKey( key );
+        }
+        return;
+    }
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, removed_keyW, 0, NULL, 0, KEY_SET_VALUE | KEY_WOW64_64KEY, NULL, &key, NULL ))
+        return;
+    RegSetValueExW( key, full_name, 0, REG_SZ, (const BYTE *)L"", sizeof(WCHAR) );
+    RegCloseKey( key );
+}
+
+static BOOL removed_for_all( const WCHAR *full_name )
+{
+    HKEY key;
+    BOOL ret;
+
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, removed_keyW, 0, KEY_QUERY_VALUE | KEY_WOW64_64KEY, &key )) return FALSE;
+    ret = !RegQueryValueExW( key, full_name, NULL, NULL, NULL, NULL );
+    RegCloseKey( key );
+    return ret;
+}
+
 static HRESULT write_record( const struct package_record *rec, const struct strlist *shortcuts,
                              const struct strlist *aliases, const struct strlist *resources )
 {
@@ -315,6 +350,8 @@ static HRESULT write_record( const struct package_record *rec, const struct strl
     swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, rec->full_name );
     if ((res = RegCreateKeyExW( own_hive(), path, 0, NULL, 0, KEY_ALL_ACCESS | REC_VIEW, NULL, &key, NULL )))
         return HRESULT_FROM_WIN32( res );
+    /* the machine has it (again) */
+    if (caller_is_system()) set_removed_for_all( rec->full_name, FALSE );
     reg_set_string( key, L"Name", rec->name );
     reg_set_string( key, L"Publisher", rec->publisher );
     reg_set_string( key, L"PublisherId", rec->publisher_id );
@@ -607,6 +644,8 @@ static HRESULT verify_signature( const WCHAR *path )
 typedef BOOL (*record_func)( struct package_record *rec, void *context );
 
 /* Calls func for each deployed package of the user until it returns FALSE. */
+static void cleanup_stale_user_records(void);
+
 static void for_each_record( record_func func, void *context )
 {
     WCHAR full_name[256];
@@ -615,6 +654,8 @@ static void for_each_record( record_func func, void *context )
     BOOL more = TRUE;
     int pass;
 
+    cleanup_stale_user_records();
+
     /* this caller's own records, then the others it sees (a user: the machine's) */
     for (pass = 0; pass < 2 && more; pass++)
     {
@@ -1360,10 +1401,110 @@ static HRESULT remove_record( const WCHAR *full_name, WCHAR **error_text )
     swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, full_name );
     if ((res = delete_tree_64( hive, path )) && res != ERROR_FILE_NOT_FOUND)
         return HRESULT_FROM_WIN32( res );
+    /* removed for every user: their registrations go at their next start */
+    if (hive == HKEY_LOCAL_MACHINE) set_removed_for_all( full_name, TRUE );
     TRACE( "removed %s\n", debugstr_w( full_name ) );
     return S_OK;
 }
 
+/* ---- Stained Glass OS: stale registrations of the user ------------------------------------------
+ *
+ * At a user's first package query in a process (on Windows, AppReadiness at sign-in) the user's own
+ * registrations of packages that are gone are dropped: one whose package SYSTEM removed for all
+ * users, or one whose content is no longer there (its files removed by an uninstaller or an update
+ * that moved on). Its Start menu entries, aliases and classes go with it; its files are not the
+ * user's to delete. A development registration (the developer's own folder) stays. */
+
+static void drop_user_record( HKEY packages, const WCHAR *full_name )
+{
+    WCHAR path[MAX_PATH], *list, *p;
+    struct package_record rec;
+    HKEY key;
+
+    if (RegOpenKeyExW( packages, full_name, 0, KEY_READ, &key )) return;
+    if (!read_record( key, full_name, &rec ))
+    {
+        RegCloseKey( key );
+        return;
+    }
+    TRACE( "dropping %s\n", debugstr_w( full_name ) );
+    if ((list = reg_multi( key, L"Aliases" )))
+    {
+        for (p = list; *p; p += wcslen( p ) + 1)
+            if (rec.install_location && alias_is_ours( p, rec.install_location )) DeleteFileW( p );
+        free( list );
+    }
+    if ((list = reg_multi( key, L"Shortcuts" )))
+    {
+        for (p = list; *p; p += wcslen( p ) + 1) DeleteFileW( p );
+        free( list );
+    }
+    unregister_com_classes( key, HKEY_CURRENT_USER );
+    RegCloseKey( key );
+    package_record_free( &rec );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, full_name );
+    delete_tree_64( HKEY_CURRENT_USER, path );
+}
+
+static BOOL record_is_stale( HKEY packages, const WCHAR *full_name )
+{
+    struct package_record rec;
+    BOOL stale = FALSE;
+    HKEY key;
+
+    if (removed_for_all( full_name )) return TRUE;
+    if (RegOpenKeyExW( packages, full_name, 0, KEY_READ, &key )) return FALSE;
+    if (read_record( key, full_name, &rec ))
+    {
+        /* a package with external content stays while that content is there (its own folder may go) */
+        stale = !rec.development_mode && !rec.staged && rec.install_location && rec.install_location[0] &&
+                GetFileAttributesW( rec.install_location ) == INVALID_FILE_ATTRIBUTES &&
+#ifndef SG_MUTANT_AX_DROP_SPARSE
+                (!rec.external_location || !rec.external_location[0] ||
+                 GetFileAttributesW( rec.external_location ) == INVALID_FILE_ATTRIBUTES) &&
+#endif
+                TRUE;
+        package_record_free( &rec );
+    }
+    RegCloseKey( key );
+    return stale;
+}
+
+static BOOL CALLBACK cleanup_once( INIT_ONCE *once, void *param, void **context )
+{
+    WCHAR full_name[256], **stale = NULL, **grown;
+    DWORD len, index = 0, count = 0, i;
+    HKEY packages;
+
+#ifdef SG_MUTANT_AX_NO_CLEANUP
+    return TRUE;
+#endif
+    if (caller_is_system()) return TRUE;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, packages_keyW, 0, KEY_READ | REC_VIEW, &packages )) return TRUE;
+    while (len = ARRAY_SIZE(full_name), !RegEnumKeyExW( packages, index++, full_name, &len, NULL, NULL, NULL, NULL ))
+    {
+        if (!record_is_stale( packages, full_name )) continue;
+        if (!(grown = realloc( stale, (count + 1) * sizeof(*stale) ))) break;
+        stale = grown;
+        if ((stale[count] = wcsdup( full_name ))) count++;
+    }
+    /* dropped once the enumeration is over */
+    for (i = 0; i < count; i++)
+    {
+        drop_user_record( packages, stale[i] );
+        free( stale[i] );
+    }
+    free( stale );
+    RegCloseKey( packages );
+    return TRUE;
+}
+
+static void cleanup_stale_user_records(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, cleanup_once, NULL, NULL );
+}
+
 /* ---- installation --------------------------------------------------------------------------- */
 
 struct family_search
@@ -2970,7 +3111,8 @@ static BOOL query_record( struct package_record *rec, void *context )
         WCHAR *family;
         UINT32 i;
 
-        available = rec->install_location && GetFileAttributesW( rec->install_location ) != INVALID_FILE_ATTRIBUTES;
+        available = (rec->install_location && GetFileAttributesW( rec->install_location ) != INVALID_FILE_ATTRIBUTES) ||
+                    (rec->external_location && GetFileAttributesW( rec->external_location ) != INVALID_FILE_ATTRIBUTES);
 #ifndef SG_MUTANT_AX_TWO_VERSIONS
         for (i = 0; main && i < q->count; i++)
         {
