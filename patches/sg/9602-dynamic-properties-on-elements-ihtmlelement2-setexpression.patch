From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mshtml: dynamic properties on elements (IHTMLElement2::setExpression) (9602)

Internet Explorer 5-7 pages and HTML applications set dynamic properties
on elements: el.setExpression("title", "..."), el.setExpression(
"style.width", "..."). They were E_NOTIMPL (8228 did them on style
objects). The expression is evaluated by the page's script engine when it
is set and again at document.recalc, and the property -- a dotted path
from the element, or an expando made as a script assignment makes it --
set to its value. getExpression gives the expression, removeExpression
takes it away (true once).
---
--- a/dlls/mshtml/htmlelem.c
+++ b/dlls/mshtml/htmlelem.c
@@ -34,6 +34,7 @@
 #include "mshtml_private.h"
 #include "htmlevent.h"
 #include "htmlstyle.h"
+#include "htmlscript.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(mshtml);
 
@@ -3637,31 +3650,221 @@
     return hres;
 }
 
+#ifndef SG_MUTANT_NO_ELEM_EXPRESSIONS
+/* Stained Glass OS (wine-sg 9602): dynamic properties on an element (IHTMLElement2::setExpression), as
+ * Internet Explorer 5-7 have them: the expression is evaluated by the page's script engine when it is set
+ * and again at document.recalc, and the property (a dotted path, such as "style.width") set to its value. */
+struct elem_expression
+{
+    struct list entry;
+    WCHAR *prop;
+    WCHAR *expr;
+    WCHAR *lang;
+};
+
+static void free_elem_expression(struct elem_expression *e)
+{
+    list_remove(&e->entry);
+    free(e->prop);
+    free(e->expr);
+    free(e->lang);
+    free(e);
+}
+
+static struct elem_expression *find_elem_expression(HTMLElement *elem, const WCHAR *prop)
+{
+    struct elem_expression *e;
+
+    if(!elem->expressions.next) return NULL;
+    LIST_FOR_EACH_ENTRY(e, &elem->expressions, struct elem_expression, entry)
+        if(!wcsicmp(e->prop, prop)) return e;
+    return NULL;
+}
+
+/* sets the property a dotted path names, starting at the element */
+static HRESULT put_path_value(HTMLElement *elem, const WCHAR *path, VARIANT *value)
+{
+    IDispatch *disp = (IDispatch*)&elem->IHTMLElement_iface;
+    DISPID put_id = DISPID_PROPERTYPUT, dispid;
+    const WCHAR *start = path, *dot;
+    HRESULT hres = S_OK;
+    BSTR name;
+
+    IDispatch_AddRef(disp);
+    while((dot = wcschr(start, '.'))) {
+        DISPPARAMS dp = { NULL, NULL, 0, 0 };
+        VARIANT next;
+
+        if(!(name = SysAllocStringLen(start, dot - start))) { hres = E_OUTOFMEMORY; break; }
+        hres = IDispatch_GetIDsOfNames(disp, &IID_NULL, &name, 1, 0, &dispid);
+        SysFreeString(name);
+        if(FAILED(hres)) break;
+        V_VT(&next) = VT_EMPTY;
+        hres = IDispatch_Invoke(disp, dispid, &IID_NULL, 0, DISPATCH_PROPERTYGET, &dp, &next, NULL, NULL);
+        if(FAILED(hres)) break;
+        if(V_VT(&next) != VT_DISPATCH || !V_DISPATCH(&next)) {
+            VariantClear(&next);
+            hres = DISP_E_TYPEMISMATCH;
+            break;
+        }
+        IDispatch_Release(disp);
+        disp = V_DISPATCH(&next);
+        start = dot + 1;
+    }
+    if(SUCCEEDED(hres)) {
+        DISPPARAMS dp = { value, &put_id, 1, 1 };
+
+        if(!(name = SysAllocString(start)))
+            hres = E_OUTOFMEMORY;
+        else {
+            IDispatchEx *dispex;
+
+            /* an expando property is made the way a script assignment makes it */
+            if(SUCCEEDED(IDispatch_QueryInterface(disp, &IID_IDispatchEx, (void**)&dispex))) {
+                hres = IDispatchEx_GetDispID(dispex, name, fdexNameEnsure | fdexNameCaseInsensitive, &dispid);
+                if(SUCCEEDED(hres))
+                    hres = IDispatchEx_InvokeEx(dispex, dispid, 0, DISPATCH_PROPERTYPUT, &dp, NULL, NULL, NULL);
+                IDispatchEx_Release(dispex);
+            }else {
+                hres = IDispatch_GetIDsOfNames(disp, &IID_NULL, &name, 1, 0, &dispid);
+                if(SUCCEEDED(hres))
+                    hres = IDispatch_Invoke(disp, dispid, &IID_NULL, 0, DISPATCH_PROPERTYPUT, &dp, NULL, NULL, NULL);
+            }
+            SysFreeString(name);
+        }
+    }
+    IDispatch_Release(disp);
+    return hres;
+}
+
+static void evaluate_elem_expression(HTMLElement *elem, struct elem_expression *e)
+{
+    HTMLInnerWindow *window = elem->node.doc ? elem->node.doc->window : NULL;
+    VARIANT value;
+    HRESULT hres;
+
+    if(!window) return;
+    V_VT(&value) = VT_EMPTY;
+    hres = exec_script_expr_lang(window, e->expr, e->lang, &value);
+    if(FAILED(hres)) {
+        WARN("expression %s failed: %08lx\n", debugstr_w(e->expr), hres);
+        return;
+    }
+    hres = put_path_value(elem, e->prop, &value);
+    if(FAILED(hres))
+        WARN("setting %s from %s failed: %08lx\n", debugstr_w(e->prop), debugstr_w(e->expr), hres);
+    VariantClear(&value);
+}
+
+static void free_elem_expressions(HTMLElement *elem)
+{
+    struct elem_expression *e, *next;
+
+    if(!elem->expressions.next) return;
+    LIST_FOR_EACH_ENTRY_SAFE(e, next, &elem->expressions, struct elem_expression, entry)
+        free_elem_expression(e);
+}
+
+/* document.recalc */
+void recalc_element_expressions(HTMLElement *elem)
+{
+    struct elem_expression *e, *next;
+
+    if(!elem->expressions.next) return;
+    IHTMLElement_AddRef(&elem->IHTMLElement_iface);
+    LIST_FOR_EACH_ENTRY_SAFE(e, next, &elem->expressions, struct elem_expression, entry)
+        evaluate_elem_expression(elem, e);
+    IHTMLElement_Release(&elem->IHTMLElement_iface);
+}
+
 static HRESULT WINAPI HTMLElement2_setExpression(IHTMLElement2 *iface, BSTR propname,
                                                  BSTR expression, BSTR language)
 {
     HTMLElement *This = impl_from_IHTMLElement2(iface);
-    FIXME("(%p)->(%s %s %s)\n", This, debugstr_w(propname), debugstr_w(expression),
+    struct elem_expression *e;
+
+    TRACE("(%p)->(%s %s %s)\n", This, debugstr_w(propname), debugstr_w(expression),
           debugstr_w(language));
-    return E_NOTIMPL;
+
+    if(!propname || !*propname || !expression)
+        return E_INVALIDARG;
+    if(!This->expressions.next) list_init(&This->expressions);
+    if(!(e = find_elem_expression(This, propname))) {
+        if(!(e = calloc(1, sizeof(*e))) || !(e->prop = wcsdup(propname))) {
+            free(e);
+            return E_OUTOFMEMORY;
+        }
+        list_add_tail(&This->expressions, &e->entry);
+    }
+    free(e->expr);
+    free(e->lang);
+    e->expr = wcsdup(expression);
+    e->lang = language && *language ? wcsdup(language) : NULL;
+    if(!e->expr) {
+        free_elem_expression(e);
+        return E_OUTOFMEMORY;
+    }
+    evaluate_elem_expression(This, e);
+    return S_OK;
 }
 
 static HRESULT WINAPI HTMLElement2_getExpression(IHTMLElement2 *iface, BSTR propname,
                                                  VARIANT *expression)
 {
     HTMLElement *This = impl_from_IHTMLElement2(iface);
-    FIXME("(%p)->(%s %p)\n", This, debugstr_w(propname), expression);
-    return E_NOTIMPL;
+    struct elem_expression *e;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(propname), expression);
+
+    if(!expression)
+        return E_POINTER;
+    V_VT(expression) = VT_EMPTY;
+    if(propname && (e = find_elem_expression(This, propname))) {
+        V_VT(expression) = VT_BSTR;
+        if(!(V_BSTR(expression) = SysAllocString(e->expr))) {
+            V_VT(expression) = VT_EMPTY;
+            return E_OUTOFMEMORY;
+        }
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI HTMLElement2_removeExpression(IHTMLElement2 *iface, BSTR propname,
                                                     VARIANT_BOOL *pfSuccess)
 {
     HTMLElement *This = impl_from_IHTMLElement2(iface);
-    FIXME("(%p)->(%s %p)\n", This, debugstr_w(propname), pfSuccess);
+    struct elem_expression *e;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(propname), pfSuccess);
+
+    e = propname ? find_elem_expression(This, propname) : NULL;
+    if(e) free_elem_expression(e);
+    if(pfSuccess) *pfSuccess = variant_bool(e != NULL);
+    return S_OK;
+}
+#else
+static void free_elem_expressions(HTMLElement *elem) {}
+void recalc_element_expressions(HTMLElement *elem) {}
+
+static HRESULT WINAPI HTMLElement2_setExpression(IHTMLElement2 *iface, BSTR propname,
+                                                 BSTR expression, BSTR language)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI HTMLElement2_getExpression(IHTMLElement2 *iface, BSTR propname,
+                                                 VARIANT *expression)
+{
     return E_NOTIMPL;
 }
 
+static HRESULT WINAPI HTMLElement2_removeExpression(IHTMLElement2 *iface, BSTR propname,
+                                                    VARIANT_BOOL *pfSuccess)
+{
+    return E_NOTIMPL;
+}
+#endif
+
 static HRESULT WINAPI HTMLElement2_put_tabIndex(IHTMLElement2 *iface, short v)
 {
     HTMLElement *This = impl_from_IHTMLElement2(iface);
@@ -7831,6 +8042,8 @@
     HTMLElement *This = impl_from_DispatchEx(dispex);
 
     ConnectionPointContainer_Destroy(&This->cp_container);
+    free_elem_expressions(This);
+    elem_free_behaviors(This);
     free(This->filter);
     HTMLDOMNode_destructor(&This->node.event_target.dispex);
 }
--- a/dlls/mshtml/mshtml_private.h
+++ b/dlls/mshtml/mshtml_private.h
@@ -1115,6 +1115,8 @@
     HTMLStyle *runtime_style;
     HTMLAttributeCollection *attrs;
     WCHAR *filter;
+    struct list expressions;          /* Stained Glass OS: setExpression on the element (lazily initialized) */
+    struct user_data *user_data;      /* Stained Glass OS: the #default#userData behavior (behavior.c) */
     unsigned unique_id;
     BOOL has_pointer_capture;  /* msSetPointerCapture */
     LONG captured_pointer;
@@ -1511,6 +1514,13 @@
 HRESULT get_node(nsIDOMNode*,BOOL,HTMLDOMNode**);
 HRESULT get_element(nsIDOMElement*,HTMLElement**);
 void recalc_style_expressions(HTMLDocumentNode*);
+void recalc_element_expressions(HTMLElement*);
+HRESULT elem_add_behavior(HTMLElement*,const WCHAR*,LONG*);
+HRESULT elem_remove_behavior(HTMLElement*,LONG,VARIANT_BOOL*);
+void elem_free_behaviors(HTMLElement*);
+BOOL user_data_get(HTMLElement*,const WCHAR*,VARIANT*);
+BOOL user_data_set(HTMLElement*,const WCHAR*,VARIANT*,HRESULT*);
+BOOL user_data_remove(HTMLElement*,const WCHAR*,VARIANT_BOOL*);
 HRESULT get_document_node(nsIDOMDocument*,HTMLDocumentNode**);
 
 HTMLElement *unsafe_impl_from_IHTMLElement(IHTMLElement*);
