  */
-HRESULT WINAPI DwmUpdateThumbnailProperties(HTHUMBNAIL thumbnail, const DWM_THUMBNAIL_PROPERTIES *props)
+HRESULT WINAPI DwmUpdateThumbnailProperties(HTHUMBNAIL id, const DWM_THUMBNAIL_PROPERTIES *props)
 {
-    FIXME("(%p, %p) stub\n", thumbnail, props);
-    return E_NOTIMPL;
+    struct thumbnail *thumbnail;
+    DWORD flags;
+
+    TRACE("(%p, %p)\n", id, props);
+
+    /* null or invalid thumbnails, and other processes', are E_INVALIDARG */
+    if (!props) return E_INVALIDARG;
+    flags = props->dwFlags;
+
+    EnterCriticalSection( &thumbnail_cs );
+    if (!id || !(thumbnail = find_thumbnail( id )))
+    {
+        LeaveCriticalSection( &thumbnail_cs );
+        return E_INVALIDARG;
+    }
+
+    /* only the fields named by the flags change; the others keep their value */
+    if (flags & DWM_TNP_RECTDESTINATION) thumbnail->props.rcDestination = props->rcDestination;
+    if (flags & DWM_TNP_RECTSOURCE) thumbnail->props.rcSource = props->rcSource;
+    if (flags & DWM_TNP_OPACITY) thumbnail->props.opacity = props->opacity;
+    if (flags & DWM_TNP_VISIBLE) thumbnail->props.fVisible = props->fVisible;
+    if (flags & DWM_TNP_SOURCECLIENTAREAONLY) thumbnail->props.fSourceClientAreaOnly = props->fSourceClientAreaOnly;
+    thumbnail->props.dwFlags |= flags & (DWM_TNP_RECTDESTINATION | DWM_TNP_RECTSOURCE | DWM_TNP_OPACITY |
+                                         DWM_TNP_VISIBLE | DWM_TNP_SOURCECLIENTAREAONLY);
+    LeaveCriticalSection( &thumbnail_cs );
+
+    /* hiding or moving: the render thread clears what it drew */
+    return S_OK;
 }
 
