@@ -555,9 +926,72 @@ HRESULT WINAPI DwmGetWindowAttribute(HWND hwnd, DWORD attribute, PVOID pv_attrib
  */
 HRESULT WINAPI DwmRegisterThumbnail(HWND dest, HWND src, PHTHUMBNAIL thumbnail_id)
 {
-    FIXME("(%p %p %p) stub\n", dest, src, thumbnail_id);
+    struct thumbnail *thumbnail;
+    DWORD pid;
 
-    return E_NOTIMPL;
+    TRACE("(%p %p %p)\n", dest, src, thumbnail_id);
+
+    if (!thumbnail_id) return E_INVALIDARG;
+    *thumbnail_id = NULL;
+
+    /* "anything other than a top-level window" is E_INVALIDARG; the destination
+     * may also be the desktop window itself */
+    if (!IsWindow( dest ) || !IsWindow( src )) return E_INVALIDARG;
+    if (dest != GetDesktopWindow() && !is_top_level( dest )) return E_INVALIDARG;
+    if (!is_top_level( src )) return E_INVALIDARG;
+
+    /* the destination must be the desktop or belong to the caller: nothing
+     * may change what another program's window shows */
+#ifndef SG_MUTANT_NO_OWNER_CHECK
+    if (dest != GetDesktopWindow())
+    {
+        GetWindowThreadProcessId( dest, &pid );
+        if (pid != GetCurrentProcessId()) return E_ACCESSDENIED;
+    }
+#endif
+
+    if (!(thumbnail = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*thumbnail) ))) return E_OUTOFMEMORY;
+    thumbnail->dest = dest;
+    thumbnail->src = src;
+    thumbnail->props.opacity = 255;
+
+    EnterCriticalSection( &thumbnail_cs );
+    thumbnail->id = (HTHUMBNAIL)next_thumbnail_id++;
+    list_add_tail( &thumbnails, &thumbnail->entry );
+    *thumbnail_id = thumbnail->id;
+    start_thumbnail_thread();
+    LeaveCriticalSection( &thumbnail_cs );
+    return S_OK;
+}
+
+/**********************************************************************
+ *           DwmQueryThumbnailSourceSize         (DWMAPI.@)
+ */
+HRESULT WINAPI DwmQueryThumbnailSourceSize(HTHUMBNAIL id, SIZE *size)
+{
+    struct thumbnail *thumbnail, copy;
+    RECT window;
+
+    TRACE("(%p %p)\n", id, size);
+
+    if (!size) return E_INVALIDARG;
+
+    EnterCriticalSection( &thumbnail_cs );
+    if (!id || !(thumbnail = find_thumbnail( id )))
+    {
+        LeaveCriticalSection( &thumbnail_cs );
+        return E_INVALIDARG;
+    }
+    copy = *thumbnail;
+    LeaveCriticalSection( &thumbnail_cs );
+
+    /* the whole source window, not what rcSource selects of it */
+    copy.props.dwFlags = 0;
+    if (!IsWindow( copy.src ) || !get_thumbnail_source_area( &copy, &window ))
+        return DWM_E_COMPOSITIONDISABLED;
+    size->cx = window.right - window.left;
+    size->cy = window.bottom - window.top;
+    return S_OK;
 }
 
