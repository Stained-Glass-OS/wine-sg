From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwmapi: thumbnails really draw; the deprecated MIL/stream entry points answer as documented

DwmRegisterThumbnail, DwmUpdateThumbnailProperties, DwmUnregisterThumbnail and
(new, was a spec stub) DwmQueryThumbnailSourceSize follow Microsoft's
documentation: the registration is per process (a handle is unique to it and
only it can update or remove it; null, unknown and other processes' handles
are E_INVALIDARG), only top-level windows can be a destination (or the
desktop window) or a source (E_INVALIDARG), the destination must belong to the
caller (E_ACCESSDENIED), nothing is drawn until the first update, and only the
fields named by the update flags change. There is no compositor, so a thread
of the process copies each visible source (PrintWindow, so another process's or
a covered/cloaked window works) into the destination: source rectangle, client
area only, scaled into rcDestination, with the opacity blended over the
destination's own pixels. It draws again only when the source or the
destination changed, and it clears what it drew when the thumbnail is hidden,
moved or unregistered.

DwmAttachMilContent, DwmDetachMilContent, DwmGetGraphicsStreamClient and
DwmGetGraphicsStreamTransformHint return DWM_E_COMPOSITIONDISABLED: Microsoft
documents them as "deprecated and only returns DWM_E_COMPOSITIONDISABLED in
Windows 7 and later" (they returned E_NOTIMPL). DwmSetPresentParameters
"always returns S_OK" and keeps doing so, without the FIXME.

Rebased at integration (integ-2026-10) onto fast-b 3712+3714 (RECONCILE-CLOUD dwmapi KEEP-A: 5500's thumbnail thread polls every 40 ms and never exits). Only 5500's conformance test (test_thumbnails, which passes on 3712+3714) is kept.
---
--- a/dlls/dwmapi/tests/dwmapi.c
+++ b/dlls/dwmapi/tests/dwmapi.c
@@ -140,9 +140,96 @@ cleanup:
     DestroyWindow(hwnd);
 }
 
+static void test_thumbnails(void)
+{
+    DWM_THUMBNAIL_PROPERTIES props;
+    HTHUMBNAIL thumbnail, thumbnail2;
+    HWND dest, src, child;
+    BOOL enabled = FALSE;
+    SIZE size;
+    HRESULT hr;
+
+    DwmIsCompositionEnabled(&enabled);
+    if (!enabled)
+    {
+        skip("DWM is disabled.\n");
+        return;
+    }
+
+    dest = CreateWindowW(L"static", L"dest", WS_OVERLAPPEDWINDOW | WS_VISIBLE, 10, 10, 200, 200, NULL, NULL, NULL, NULL);
+    src = CreateWindowW(L"static", L"src", WS_OVERLAPPEDWINDOW | WS_VISIBLE, 300, 10, 160, 120, NULL, NULL, NULL, NULL);
+    child = CreateWindowW(L"static", L"child", WS_CHILD | WS_VISIBLE, 0, 0, 50, 50, dest, NULL, NULL, NULL);
+    ok(!!dest && !!src && !!child, "Failed to create windows.\n");
+
+    /* null and unknown thumbnails */
+    memset(&props, 0, sizeof(props));
+    props.dwFlags = DWM_TNP_VISIBLE;
+    props.fVisible = TRUE;
+    hr = DwmUnregisterThumbnail(NULL);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = DwmUnregisterThumbnail((HTHUMBNAIL)0x1234abcd);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = DwmUpdateThumbnailProperties(NULL, &props);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = DwmUpdateThumbnailProperties((HTHUMBNAIL)0x1234abcd, &props);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+
+    /* only top-level windows can be a destination or a source */
+    thumbnail = NULL;
+    hr = DwmRegisterThumbnail(child, src, &thumbnail);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = DwmRegisterThumbnail(dest, child, &thumbnail);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+
+    hr = DwmRegisterThumbnail(dest, src, &thumbnail);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(!!thumbnail, "Got a null thumbnail.\n");
+    hr = DwmRegisterThumbnail(dest, src, &thumbnail2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(thumbnail2 != thumbnail, "Got the same thumbnail twice.\n");
+
+    memset(&size, 0, sizeof(size));
+    hr = DwmQueryThumbnailSourceSize(thumbnail, &size);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(size.cx > 0 && size.cy > 0, "Got source size %ldx%ld.\n", size.cx, size.cy);
+
+    props.dwFlags = DWM_TNP_RECTDESTINATION | DWM_TNP_VISIBLE | DWM_TNP_OPACITY | DWM_TNP_SOURCECLIENTAREAONLY;
+    SetRect(&props.rcDestination, 0, 50, 100, 150);
+    props.fVisible = TRUE;
+    props.opacity = 178;
+    props.fSourceClientAreaOnly = FALSE;
+    hr = DwmUpdateThumbnailProperties(thumbnail, &props);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = DwmUpdateThumbnailProperties(thumbnail, NULL);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+
+    hr = DwmUnregisterThumbnail(thumbnail);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = DwmUnregisterThumbnail(thumbnail);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = DwmUpdateThumbnailProperties(thumbnail, &props);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = DwmQueryThumbnailSourceSize(thumbnail, &size);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = DwmUnregisterThumbnail(thumbnail2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    /* the deprecated entry points: "only returns DWM_E_COMPOSITIONDISABLED
+     * in Windows 7 and later" */
+    hr = DwmAttachMilContent(dest);
+    ok(hr == DWM_E_COMPOSITIONDISABLED, "Got hr %#lx.\n", hr);
+    hr = DwmDetachMilContent(dest);
+    ok(hr == DWM_E_COMPOSITIONDISABLED, "Got hr %#lx.\n", hr);
+
+    DestroyWindow(child);
+    DestroyWindow(src);
+    DestroyWindow(dest);
+}
+
 START_TEST(dwmapi)
 {
     test_DwmIsCompositionEnabled();
     test_DwmGetCompositionTimingInfo();
     test_DWMWA_EXTENDED_FRAME_BOUNDS();
+    test_thumbnails();
 }
