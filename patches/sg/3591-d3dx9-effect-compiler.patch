+static BOOL compiler_is_keyword(const char *name, size_t len)
+{
+    static const char *const keywords[] =
+    {
+        "technique", "technique10", "pass", "cbuffer", "tbuffer", "struct", "if", "while", "for", "switch", "return",
+        "typedef", "else", "do", "sampler_state", "compile", "asm", "vertexshader", "pixelshader",
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(keywords); ++i)
+        if (strlen(keywords[i]) == len && !strncmp(keywords[i], name, len))
+            return TRUE;
+    return FALSE;
+}
+
+static BOOL compiler_is_ident_char(char c)
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (c >= '0' && c <= '9');
+}
+
+/* the functions of the source are the top level definitions with a body, found in the preprocessed text */
+static void compiler_scan_functions(struct ID3DXEffectCompilerImpl *compiler, const char *data, SIZE_T size)
+{
+    const char *p = data, *end = data + size;
+    const char *prev_name = NULL, *last_name = NULL;
+    size_t last_len = 0;
+    BOOL after_ident = FALSE;
+    int depth = 0;
+
+    while (p < end && *p)
+    {
+        if (p[0] == '/' && p + 1 < end && p[1] == '/')
+        {
+            while (p < end && *p != '\n')
+                ++p;
+            continue;
+        }
+        if (p[0] == '/' && p + 1 < end && p[1] == '*')
+        {
+            p += 2;
+            while (p + 1 < end && !(p[0] == '*' && p[1] == '/'))
+                ++p;
+            p += 2;
+            continue;
+        }
+        if (*p == '#')
+        {
+            while (p < end && *p != '\n')
+                ++p;
+            continue;
+        }
+        if (*p == '"')
+        {
+            for (++p; p < end && *p != '"'; ++p)
+                if (*p == '\\')
+                    ++p;
+            ++p;
+            prev_name = last_name = NULL;
+            after_ident = FALSE;
+            continue;
+        }
+        if (*p == '{')
+        {
+            ++depth;
+            prev_name = last_name = NULL;
+            after_ident = FALSE;
+            ++p;
+            continue;
+        }
+        if (*p == '}')
+        {
+            --depth;
+            prev_name = last_name = NULL;
+            after_ident = FALSE;
+            ++p;
+            continue;
+        }
+        if (depth > 0)
+        {
+            ++p;
+            continue;
+        }
+        if (compiler_is_ident_char(*p) && !(*p >= '0' && *p <= '9'))
+        {
