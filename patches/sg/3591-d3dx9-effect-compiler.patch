From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dx9_36: effect compiler (3591)

d3dx9_36: effect compiler

D3DXCreateEffectCompiler now compiles the source (or reads a binary effect)
into an effect that has no device and keeps the parameters, techniques and
passes. The ID3DXBaseEffect methods of the compiler (descriptions, handles,
values, annotations) work on that effect, SetLiteral/GetLiteral keep the
literal flag of a parameter, CompileEffect returns the compiled effect and
CompileShader compiles a function of the source (found by name or by the
handles of GetFunction/GetFunctionByName, which come from a scan of the
preprocessed source) with D3DXCompileShader. Effects can be created without
a device: shader objects are only built when there is one.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---
diff --git a/dlls/d3dx9_36/d3dx9_private.h b/dlls/d3dx9_36/d3dx9_private.h
index bd6f268..2695a5a 100644
--- a/dlls/d3dx9_36/d3dx9_private.h
+++ b/dlls/d3dx9_36/d3dx9_private.h
@@ -533,6 +533,8 @@ struct d3dx_parameter
 
     char *full_name;
     struct wine_rb_entry rb_entry;
+
+    BOOL literal;
 };
 
 struct d3dx_top_level_parameter
diff --git a/dlls/d3dx9_36/effect.c b/dlls/d3dx9_36/effect.c
index f1dc6e1..bd172b8 100644
--- a/dlls/d3dx9_36/effect.c
+++ b/dlls/d3dx9_36/effect.c
@@ -214,10 +214,25 @@ struct d3dx_effect_pool
     ULONG64 version_counter;
 };
 
+struct compiler_function
+{
+    char *name;
+    D3DXFUNCTION_DESC desc;
+};
+
 struct ID3DXEffectCompilerImpl
 {
     ID3DXEffectCompiler ID3DXEffectCompiler_iface;
     LONG ref;
+
+    /* the effect that holds the parameters, techniques and passes of the compiled source; it has no device */
+    struct d3dx_effect *effect;
+    char *source;
+    SIZE_T source_size;
+    D3DXMACRO *defines;
+    ID3DXInclude *include;
+    struct compiler_function *functions;
+    unsigned int function_count;
 };
 
 static HRESULT d3dx9_effect_init_from_binary(struct d3dx_effect *effect,
@@ -806,7 +821,8 @@ static void d3dx_effect_cleanup(struct d3dx_effect *effect)
     if (effect->manager)
         IUnknown_Release(effect->manager);
 
-    IDirect3DDevice9_Release(effect->device);
+    if (effect->device)
+        IDirect3DDevice9_Release(effect->device);
     free(effect);
 }
 
@@ -4597,464 +4613,623 @@ static ULONG WINAPI ID3DXEffectCompilerImpl_Release(ID3DXEffectCompiler *iface)
 
     if (!refcount)
     {
+        unsigned int i;
+
+        if (compiler->effect)
+            compiler->effect->ID3DXEffect_iface.lpVtbl->Release(&compiler->effect->ID3DXEffect_iface);
+        for (i = 0; i < compiler->function_count; ++i)
+            free(compiler->functions[i].name);
+        free(compiler->functions);
+        if (compiler->defines)
+        {
+            for (i = 0; compiler->defines[i].Name; ++i)
+            {
+                free((char *)compiler->defines[i].Name);
+                free((char *)compiler->defines[i].Definition);
+            }
+            free(compiler->defines);
+        }
+        free(compiler->source);
         free(compiler);
     }
 
     return refcount;
+
 }
 
