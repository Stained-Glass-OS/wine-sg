From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 02:52:59 -0700
Subject: [PATCH] shell32: ExtractAssociatedIconEx icon ids, desktop folder
 SetNameOf (3303)

CORE review: shell.

ExtractAssociatedIconExW was a stub returning NULL (and so was the ANSI
form through it). It now extracts the icon as ExtractAssociatedIconW does
and, when the icon is an executable's, also returns the id of its icon
group (the group counted the way ExtractIcon counts), updating the path,
the index and the id.

The desktop folder's SetNameOf was a stub (E_FAIL). It now renames the
file or folder in the desktop directory: a name with characters a file
cannot have is cancelled, a hidden extension is kept as the file system
folder does, failures carry the error of the move, the new simple item is
returned and a rename change notification is sent. The namespace items
(My Computer and the like) have no file and fail.

Test: test/fastshmisc-gate.sh (mutants SG_MUTANT_DSK_*, SG_MUTANT_ICX_*).

diff --git a/dlls/shell32/iconcache.c b/dlls/shell32/iconcache.c
index 88ddf9a..3ccbda9 100644
--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -952,6 +952,41 @@ HICON WINAPI ExtractAssociatedIconW(HINSTANCE hInst, LPWSTR lpIconPath, LPWORD l
     return hIcon;
 }
 
+struct group_icon_find
+{
+    int index;           /* the one wanted, counting down */
+    WORD id;
+    BOOL found;
+};
+
+static BOOL CALLBACK find_group_icon_proc(HMODULE module, LPCWSTR type, LPWSTR name, LONG_PTR param)
+{
+    struct group_icon_find *find = (struct group_icon_find *)param;
+
+#ifdef SG_MUTANT_ICX_INDEX
+    if (--find->index > 0) return TRUE;
+#else
+    if (find->index-- > 0) return TRUE;
+#endif
+    /* a group named by a string has no numeric id */
+    find->id = IS_INTRESOURCE(name) ? LOWORD((ULONG_PTR)name) : 0;
+    find->found = TRUE;
+    return FALSE;
+}
+
+/* the id of the icon group at an index of a module, the way ExtractIcon counts */
+static BOOL get_group_icon_id(const WCHAR *path, WORD index, WORD *id)
+{
+    struct group_icon_find find = { index, 0, FALSE };
+    HMODULE module;
+
+    if (!(module = LoadLibraryExW(path, NULL, LOAD_LIBRARY_AS_DATAFILE))) return FALSE;
+    EnumResourceNamesW(module, (LPCWSTR)RT_GROUP_ICON, find_group_icon_proc, (LONG_PTR)&find);
+    FreeLibrary(module);
+    if (find.found) *id = find.id;
+    return find.found;
+}
+
 /*************************************************************************
  *				ExtractAssociatedIconExW (SHELL32.@)
  *
@@ -960,8 +995,28 @@ HICON WINAPI ExtractAssociatedIconW(HINSTANCE hInst, LPWSTR lpIconPath, LPWORD l
  */
 HICON WINAPI ExtractAssociatedIconExW(HINSTANCE hInst, LPWSTR lpIconPath, LPWORD lpiIconIdx, LPWORD lpiIconId)
 {
-  FIXME("%p %s %p %p): stub\n", hInst, debugstr_w(lpIconPath), lpiIconIdx, lpiIconId);
-  return 0;
+    WORD dummy_index = 0;
+    HICON icon;
+
+    TRACE("%p %s %p %p\n", hInst, debugstr_w(lpIconPath), lpiIconIdx, lpiIconId);
+
+#ifndef SG_MUTANT_ICX_NULLIDX
+    if (!lpiIconIdx) lpiIconIdx = &dummy_index;
+#endif
+    if (!(icon = ExtractAssociatedIconW(hInst, lpIconPath, lpiIconIdx))) return NULL;
+
+    /* from an executable file (the one given, an associated one or shell32): its id of the icon */
+    if (lpiIconId && lpIconPath && *lpIconPath && icon != (HICON)1)
+    {
+        WORD id;
+#ifdef SG_MUTANT_ICX_NOID
+        if (0)
+#else
+        if (get_group_icon_id(lpIconPath, *lpiIconIdx, &id))
+#endif
+            *lpiIconId = id;
+    }
+    return icon;
 }
 
 /*************************************************************************
diff --git a/dlls/shell32/shfldr_desktop.c b/dlls/shell32/shfldr_desktop.c
index 1ba758b..a5e91a2 100644
--- a/dlls/shell32/shfldr_desktop.c
+++ b/dlls/shell32/shfldr_desktop.c
@@ -734,11 +734,76 @@ static HRESULT WINAPI ISF_Desktop_fnSetNameOf (IShellFolder2 * iface,
                 LPCOLESTR lpName, DWORD dwFlags, LPITEMIDLIST * pPidlOut)
 {
     IDesktopFolderImpl *This = impl_from_IShellFolder2(iface);
+    WCHAR src[MAX_PATH + 1], dest[MAX_PATH + 1], shown[MAX_PATH + 1], *ptr;
+    BOOL is_folder;
 
-    FIXME ("(%p)->(%p,pidl=%p,%s,%lu,%p) stub\n", This, hwndOwner, pidl,
+    TRACE ("(%p)->(%p,pidl=%p,%s,%lu,%p)\n", This, hwndOwner, pidl,
            debugstr_w (lpName), dwFlags, pPidlOut);
 
-    return E_FAIL;
+    /* one item of the desktop folder, with a name */
+    if (!pidl || !lpName || _ILIsDesktop(pidl) || !_ILIsPidlSimple(pidl) || !_ILGetTextPointer(pidl))
+        return E_INVALIDARG;
+    if (pPidlOut) *pPidlOut = NULL;
+
+    /* the namespace items (My Computer and the others) have no file to rename */
+#ifndef SG_MUTANT_DSK_GUID
+    if (_ILGetGUIDPointer(pidl)) return E_FAIL;
+#endif
+
+    is_folder = _ILIsFolder(pidl);
+#ifndef SG_MUTANT_DSK_CHARS
+    if (wcspbrk( lpName, L"\\/:*?\"<>|" )) return HRESULT_FROM_WIN32(ERROR_CANCELLED);
+#endif
+
+    /* the file is in the desktop directory */
+    lstrcpynW(src, This->sPathTarget, MAX_PATH);
+    ptr = PathAddBackslashW(src);
+    _ILSimpleGetTextW(pidl, ptr, MAX_PATH + 1 - (ptr - src));
+
+    lstrcpynW(dest, This->sPathTarget, MAX_PATH);
+    ptr = PathAddBackslashW(dest);
+    lstrcpynW(ptr, lpName, MAX_PATH + 1 - (ptr - dest));
+
+    /* when the extension is not shown, the new name keeps it */
+    if (!(dwFlags & SHGDN_FORPARSING) && !is_folder)
+    {
+        _ILSimpleGetTextW(pidl, shown, ARRAY_SIZE(shown));
+        SHELL_FS_ProcessDisplayFilename(shown, dwFlags);
+        ptr = PathFindExtensionW(src);
+#ifdef SG_MUTANT_DSK_EXT
+        if (0)
+#else
+        if (*ptr && lstrlenW(shown) < lstrlenW(PathFindFileNameW(src)))
+#endif
+        {
+            INT len = lstrlenW(dest);
+            lstrcpynW(dest + len, ptr, MAX_PATH - len);
+        }
+    }
+
+    TRACE ("src=%s dest=%s\n", debugstr_w(src), debugstr_w(dest));
+
+#ifdef SG_MUTANT_DSK_ERR
+    if (!MoveFileW(src, dest)) return E_FAIL;
+#else
+    if (!MoveFileW(src, dest)) return HRESULT_FROM_WIN32(GetLastError());
+#endif
+
+    if (pPidlOut)
+    {
+        LPITEMIDLIST full;
+        if (SUCCEEDED(_ILCreateFromPathW(dest, &full)) && full)
+        {
+#ifdef SG_MUTANT_DSK_OUT
+            *pPidlOut = ILClone(ILFindLastID(full)) ? ILClone(pidl) : NULL;
+#else
+            *pPidlOut = ILClone(ILFindLastID(full));
+#endif
+            ILFree(full);
+        }
+    }
+    SHChangeNotify(is_folder ? SHCNE_RENAMEFOLDER : SHCNE_RENAMEITEM, SHCNF_PATHW, src, dest);
+    return S_OK;
 }
 
 static HRESULT WINAPI ISF_Desktop_fnGetDefaultSearchGUID(IShellFolder2 *iface, GUID *guid)
