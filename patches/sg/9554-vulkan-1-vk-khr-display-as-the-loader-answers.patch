From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] vulkan-1: VK_KHR_display answered as the Khronos loader does without a driver for it (9554)

vulkan-1 exported VK_KHR_display's seven entry points as spec stubs: a
program that called one without checking for the extension first died
of the stub's exception. Windows' vulkan-1.dll is the Khronos loader,
which answers these itself when the driver does not offer the extension
-- and winevulkan never does. So, as the loader does:

- vkGetPhysicalDeviceDisplayPropertiesKHR,
  vkGetPhysicalDeviceDisplayPlanePropertiesKHR,
  vkGetDisplayPlaneSupportedDisplaysKHR, vkGetDisplayModePropertiesKHR:
  VK_SUCCESS with a count of 0;
- vkGetDisplayPlaneCapabilitiesKHR: VK_SUCCESS with zeroed capabilities;
- vkCreateDisplayModeKHR: VK_ERROR_INITIALIZATION_FAILED (nothing to
  emulate); vkCreateDisplayPlaneSurfaceKHR:
  VK_ERROR_EXTENSION_NOT_PRESENT (the extension is not enabled).

make_vulkan writes them into vulkan-1.spec that way.

Gate: test/vkdisplay-gate.sh (64- and 32-bit; a real physical device
when Vulkan has one). Mutant SG_MUTANT_DISPLAY_NO_COUNT
(vulkan-1/vulkan.c).
---
diff --git a/dlls/vulkan-1/vulkan-1.spec b/dlls/vulkan-1/vulkan-1.spec
--- a/dlls/vulkan-1/vulkan-1.spec
+++ b/dlls/vulkan-1/vulkan-1.spec
@@ -124,8 +124,8 @@
 @ stdcall vkCreateDescriptorSetLayout(ptr ptr ptr ptr) winevulkan.vkCreateDescriptorSetLayout
 @ stdcall vkCreateDescriptorUpdateTemplate(ptr ptr ptr ptr) winevulkan.vkCreateDescriptorUpdateTemplate
 @ stdcall vkCreateDevice(ptr ptr ptr ptr) winevulkan.vkCreateDevice
-@ stub vkCreateDisplayModeKHR
-@ stub vkCreateDisplayPlaneSurfaceKHR
+@ stdcall vkCreateDisplayModeKHR(ptr int64 ptr ptr ptr)
+@ stdcall vkCreateDisplayPlaneSurfaceKHR(ptr ptr ptr ptr)
 @ stdcall vkCreateEvent(ptr ptr ptr ptr) winevulkan.vkCreateEvent
 @ stdcall vkCreateFence(ptr ptr ptr ptr) winevulkan.vkCreateFence
 @ stdcall vkCreateFramebuffer(ptr ptr ptr ptr) winevulkan.vkCreateFramebuffer
@@ -202,9 +202,9 @@
 @ stdcall vkGetDeviceProcAddr(ptr str) winevulkan.vkGetDeviceProcAddr
 @ stdcall vkGetDeviceQueue(ptr long long ptr) winevulkan.vkGetDeviceQueue
 @ stdcall vkGetDeviceQueue2(ptr ptr ptr) winevulkan.vkGetDeviceQueue2
-@ stub vkGetDisplayModePropertiesKHR
-@ stub vkGetDisplayPlaneCapabilitiesKHR
-@ stub vkGetDisplayPlaneSupportedDisplaysKHR
+@ stdcall vkGetDisplayModePropertiesKHR(ptr int64 ptr ptr)
+@ stdcall vkGetDisplayPlaneCapabilitiesKHR(ptr int64 long ptr)
+@ stdcall vkGetDisplayPlaneSupportedDisplaysKHR(ptr long ptr ptr)
 @ stdcall vkGetEventStatus(ptr int64) winevulkan.vkGetEventStatus
 @ stub vkGetFaultData
 @ stdcall vkGetFenceStatus(ptr int64) winevulkan.vkGetFenceStatus
@@ -215,8 +215,8 @@
 @ stdcall vkGetImageSubresourceLayout(ptr int64 ptr ptr) winevulkan.vkGetImageSubresourceLayout
 @ stdcall vkGetImageSubresourceLayout2(ptr int64 ptr ptr) winevulkan.vkGetImageSubresourceLayout2
 @ stdcall vkGetInstanceProcAddr(ptr str) winevulkan.vkGetInstanceProcAddr
-@ stub vkGetPhysicalDeviceDisplayPlanePropertiesKHR
-@ stub vkGetPhysicalDeviceDisplayPropertiesKHR
+@ stdcall vkGetPhysicalDeviceDisplayPlanePropertiesKHR(ptr ptr ptr)
+@ stdcall vkGetPhysicalDeviceDisplayPropertiesKHR(ptr ptr ptr)
 @ stdcall vkGetPhysicalDeviceExternalBufferProperties(ptr ptr ptr) winevulkan.vkGetPhysicalDeviceExternalBufferProperties
 @ stdcall vkGetPhysicalDeviceExternalFenceProperties(ptr ptr ptr) winevulkan.vkGetPhysicalDeviceExternalFenceProperties
 @ stdcall vkGetPhysicalDeviceExternalSemaphoreProperties(ptr ptr ptr) winevulkan.vkGetPhysicalDeviceExternalSemaphoreProperties
diff --git a/dlls/vulkan-1/vulkan.c b/dlls/vulkan-1/vulkan.c
--- a/dlls/vulkan-1/vulkan.c
+++ b/dlls/vulkan-1/vulkan.c
@@ -18,6 +18,88 @@
 
 #include <windows.h>
 #include "wine/debug.h"
+#include "wine/vulkan.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(vulkan);
+
+/* Stained Glass OS: VK_KHR_display. No driver offers it here (winevulkan
+ * does not expose the extension), and the Khronos loader that is
+ * vulkan-1.dll on Windows answers these itself when the driver does not:
+ * no displays, no planes, no modes; nothing it cannot emulate is created.
+ * A program that calls them without checking the extension got a stub's
+ * crash before. */
+/* VK_KHR_display's types are not in wine/vulkan.h (the extension is not
+ * exposed); its handles are 64-bit values, its structures what the
+ * caller passes */
+struct display_plane_capabilities
+{
+    VkDisplayPlaneAlphaFlagsKHR supportedAlpha;
+    VkOffset2D minSrcPosition, maxSrcPosition;
+    VkExtent2D minSrcExtent, maxSrcExtent;
+    VkOffset2D minDstPosition, maxDstPosition;
+    VkExtent2D minDstExtent, maxDstExtent;
+};
+
+#ifdef SG_MUTANT_DISPLAY_NO_COUNT
+#define NO_COUNT(c) do { } while (0)
+#else
+#define NO_COUNT(c) do { if (c) *(c) = 0; } while (0)
+#endif
+
+VkResult WINAPI vkGetPhysicalDeviceDisplayPropertiesKHR(VkPhysicalDevice device, uint32_t *count,
+                                                        void *properties)
+{
+    TRACE("%p %p %p: no displays\n", device, count, properties);
+    NO_COUNT(count);
+    return VK_SUCCESS;
+}
+
+VkResult WINAPI vkGetPhysicalDeviceDisplayPlanePropertiesKHR(VkPhysicalDevice device, uint32_t *count,
+                                                             void *properties)
+{
+    TRACE("%p %p %p: no planes\n", device, count, properties);
+    NO_COUNT(count);
+    return VK_SUCCESS;
+}
+
+VkResult WINAPI vkGetDisplayPlaneSupportedDisplaysKHR(VkPhysicalDevice device, uint32_t plane, uint32_t *count,
+                                                      uint64_t *displays)
+{
+    TRACE("%p %u %p %p: no displays\n", device, plane, count, displays);
+    NO_COUNT(count);
+    return VK_SUCCESS;
+}
+
+VkResult WINAPI vkGetDisplayModePropertiesKHR(VkPhysicalDevice device, uint64_t display, uint32_t *count,
+                                              void *properties)
+{
+    TRACE("%p %s %p %p: no modes\n", device, wine_dbgstr_longlong(display), count, properties);
+    NO_COUNT(count);
+    return VK_SUCCESS;
+}
+
+VkResult WINAPI vkGetDisplayPlaneCapabilitiesKHR(VkPhysicalDevice device, uint64_t mode, uint32_t plane,
+                                                 struct display_plane_capabilities *caps)
+{
+    TRACE("%p %s %u %p\n", device, wine_dbgstr_longlong(mode), plane, caps);
+    if (caps) memset(caps, 0, sizeof(*caps));
+    return VK_SUCCESS;
+}
+
+VkResult WINAPI vkCreateDisplayModeKHR(VkPhysicalDevice device, uint64_t display,
+                                       const void *info,
+                                       const VkAllocationCallbacks *allocator, uint64_t *mode)
+{
+    WARN("%p %s %p %p %p: no driver offers VK_KHR_display\n", device, wine_dbgstr_longlong(display), info, allocator, mode);
+    return VK_ERROR_INITIALIZATION_FAILED;
+}
+
+VkResult WINAPI vkCreateDisplayPlaneSurfaceKHR(VkInstance instance, const void *info,
+                                               const VkAllocationCallbacks *allocator, VkSurfaceKHR *surface)
+{
+    WARN("%p %p %p %p: VK_KHR_display is not enabled\n", instance, info, allocator, surface);
+    return VK_ERROR_EXTENSION_NOT_PRESENT;
+}
 
 
 BOOL WINAPI DllMain(HINSTANCE hinst, DWORD reason, void *reserved)
diff --git a/dlls/winevulkan/make_vulkan b/dlls/winevulkan/make_vulkan
--- a/dlls/winevulkan/make_vulkan
+++ b/dlls/winevulkan/make_vulkan
@@ -3185,9 +3185,13 @@ class VkGenerator(object):
                 continue
 
             # We support all Core functions except for VK_KHR_display* APIs.
-            # Create stubs for unsupported Core functions.
+            # Stained Glass OS: those are answered by vulkan-1 itself, as
+            # the Khronos loader does for a driver without the extension.
+            # Create stubs for the other unsupported Core functions.
             if func.is_required():
                 f.write(func.spec(symbol="winevulkan." + func.name))
+            elif "VK_KHR_display" in func.extensions:
+                f.write(func.spec())
             else:
                 f.write("@ stub {0}\n".format(func.name))
 
