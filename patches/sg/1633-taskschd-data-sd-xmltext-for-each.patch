+/* Stained Glass OS: a part of a task's XML (XmlText of the registration
+ * info, the settings, the actions): written out as in the whole task, and
+ * read from a fragment whose root is that element */
+enum xml_part { XML_PART_REGINFO, XML_PART_SETTINGS, XML_PART_ACTIONS };
+
+static HRESULT xml_part_get(enum xml_part part, void *obj, BSTR *xml)
+{
+    IStream *stream;
+    HGLOBAL hmem;
+    HRESULT hr;
+    void *p;
+
+    if (!xml) return E_POINTER;
+    *xml = NULL;
+    if (!(hmem = GlobalAlloc(GMEM_MOVEABLE | GMEM_NODISCARD, 16))) return E_OUTOFMEMORY;
+    if ((hr = CreateStreamOnHGlobal(hmem, TRUE, &stream)) != S_OK)
+    {
+        GlobalFree(hmem);
+        return hr;
+    }
+    switch (part)
+    {
+    case XML_PART_REGINFO:  hr = write_registration_info(stream, obj); break;
+    case XML_PART_SETTINGS: hr = write_settings(stream, obj); break;
+    case XML_PART_ACTIONS:  hr = write_actions(stream, obj); break;
+    }
+    if (hr == S_OK)
+    {
+        IStream_Write(stream, "\0\0", 2, NULL);
+        p = GlobalLock(hmem);
+        *xml = SysAllocString(p);
+        GlobalUnlock(hmem);
+        if (!*xml) hr = E_OUTOFMEMORY;
+    }
+    IStream_Release(stream);
+    return hr;
+}
+
+/* a reader on the fragment, at its root element, which must be the part's */
+static HRESULT xml_part_reader(BSTR xml, const WCHAR *element, IXmlReader **ret)
+{
+    IXmlReader *reader;
+    IStream *stream;
+    XmlNodeType type;
+    const WCHAR *name;
+    HGLOBAL hmem;
+    HRESULT hr;
+    void *buf;
+
+    *ret = NULL;
+    if (!xml) return E_INVALIDARG;
+    if (!(hmem = GlobalAlloc(0, lstrlenW(xml) * sizeof(WCHAR) + 1))) return E_OUTOFMEMORY;
+    buf = GlobalLock(hmem);
+    memcpy(buf, xml, lstrlenW(xml) * sizeof(WCHAR));
+    GlobalUnlock(hmem);
+    if ((hr = CreateStreamOnHGlobal(hmem, TRUE, &stream)) != S_OK)
+    {
+        GlobalFree(hmem);
+        return hr;
+    }
+    if ((hr = CreateXmlReader(&IID_IXmlReader, (void **)&reader, NULL)) != S_OK)
+    {
+        IStream_Release(stream);
+        return hr;
+    }
+    hr = IXmlReader_SetInput(reader, (IUnknown *)stream);
+    IStream_Release(stream);
+    while (hr == S_OK && (hr = IXmlReader_Read(reader, &type)) == S_OK)
+    {
+        if (type != XmlNodeType_Element) continue;
+        if (IXmlReader_GetLocalName(reader, &name, NULL) != S_OK || lstrcmpW(name, element))
+            hr = SCHED_E_MALFORMEDXML;
+        break;
+    }
+    if (hr != S_OK)
+    {
+        IXmlReader_Release(reader);
+        return hr == S_FALSE ? SCHED_E_MALFORMEDXML : hr;
+    }
+    *ret = reader;
+    return S_OK;
+}
