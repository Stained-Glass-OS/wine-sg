+    /* read into a definition of its own, then take its actions */
+    if ((hr = xml_part_reader(xml, L"Actions", &reader)) != S_OK) return hr;
+    if ((hr = TaskDefinition_create(&tmp)) == S_OK)
+    {
+        hr = read_actions(reader, tmp);
+        if (hr == S_OK) hr = ITaskDefinition_get_Actions(tmp, &read);
+        if (hr == S_OK)
+        {
+            IActionCollection_Clear(iface);
+            if (SUCCEEDED(IActionCollection_get_Context(read, &ctx)))
+            {
+                IActionCollection_put_Context(iface, ctx);
+                SysFreeString(ctx);
+            }
+            IActionCollection_get_Count(read, &count);
+            for (i = 1; i <= count && hr == S_OK; i++)
+            {
+                IExecAction *from, *to;
+                IAction *action, *created;
+                BSTR str;
+
+                if (FAILED(hr = IActionCollection_get_Item(read, i, &action))) break;
+                if (SUCCEEDED(IAction_QueryInterface(action, &IID_IExecAction, (void **)&from)))
+                {
+                    if (SUCCEEDED(hr = IActionCollection_Create(iface, TASK_ACTION_EXEC, &created)))
+                    {
+                        IAction_QueryInterface(created, &IID_IExecAction, (void **)&to);
+                        if (SUCCEEDED(IExecAction_get_Path(from, &str))) { IExecAction_put_Path(to, str); SysFreeString(str); }
+                        if (SUCCEEDED(IExecAction_get_Arguments(from, &str))) { IExecAction_put_Arguments(to, str); SysFreeString(str); }
+                        if (SUCCEEDED(IExecAction_get_WorkingDirectory(from, &str))) { IExecAction_put_WorkingDirectory(to, str); SysFreeString(str); }
+                        if (SUCCEEDED(IExecAction_get_Id(from, &str))) { IExecAction_put_Id(to, str); SysFreeString(str); }
+                        IExecAction_Release(to);
+                        IAction_Release(created);
+                    }
+                    IExecAction_Release(from);
+                }
+                IAction_Release(action);
+            }
+            IActionCollection_Release(read);
+        }
+        ITaskDefinition_Release(tmp);
+    }
+    IXmlReader_Release(reader);
+    return hr;
 }
 
