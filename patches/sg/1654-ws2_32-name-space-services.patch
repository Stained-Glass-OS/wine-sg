+
+/* Two name spaces answer, as on Windows:
+ *
+ *  - NS_DNS: host names to addresses (SVCID_HOSTNAME,
+ *    SVCID_INET_HOSTADDRBYNAME with a HOSTENT blob, SVCID_INET_
+ *    HOSTADDRBYINETSTRING for address literals) and service names to ports
+ *    (SVCID_INET_SERVICEBYNAME with a SERVENT blob);
+ *  - NS_NLA: the networks the machine is connected to, one result each,
+ *    with NLA_INTERFACE and NLA_CONNECTIVITY blobs, and SIO_NSP_NOTIFY_CHANGE
+ *    to learn when they change (polled, or completed through an event, a
+ *    completion port, a window message or an APC).
+ *
+ * Results are written into the caller's buffer as one block: the
+ * WSAQUERYSET first and everything its pointers point at after it. */
+
+#include "ws2_32_private.h"
+#include "wine/list.h"
+
+#ifndef LUP_CONTAINERS
+#define LUP_CONTAINERS    0x0002
+#endif
+#ifndef LUP_FLUSHPREVIOUS
+#define LUP_FLUSHPREVIOUS 0x2000
+#endif
+
+WINE_DEFAULT_DEBUG_CHANNEL(winsock);
+
+static const GUID svcid_hostname          = {0x0002a800, 0, 0, {0xc0, 0, 0, 0, 0, 0, 0, 0x46}};
+static const GUID svcid_hostaddr_by_str   = {0x0002a801, 0, 0, {0xc0, 0, 0, 0, 0, 0, 0, 0x46}};
+static const GUID svcid_service_by_name   = {0x0002a802, 0, 0, {0xc0, 0, 0, 0, 0, 0, 0, 0x46}};
+static const GUID svcid_hostaddr_by_name  = {0x0002a803, 0, 0, {0xc0, 0, 0, 0, 0, 0, 0, 0x46}};
+static const GUID nla_service_class       = {0x0037e515, 0xb5c9, 0x4a43, {0xba, 0xda, 0x8b, 0x48, 0xa8, 0x7a, 0xd2, 0x39}};
+static const GUID dns_provider_id         = {0x22059d40, 0x7e9e, 0x11cf, {0xae, 0x5a, 0x00, 0xaa, 0x00, 0xa7, 0x11, 0x2b}};
+static const GUID nla_provider_id         = {0x6642243a, 0x3ba8, 0x4aa6, {0xba, 0xa5, 0x2e, 0x0b, 0xd7, 0x1f, 0xdd, 0x83}};
+
+#define SIO_NSP_NOTIFY_CHANGE _WSAIOW(IOC_WS2, 25)
+
+static const struct
+{
+    const GUID *id;
+    DWORD name_space;
+    const WCHAR *identifier;
+}
+providers[] =
+{
+    { &dns_provider_id, NS_DNS, L"Tcpip" },
+    { &nla_provider_id, NS_NLA, L"Network Location Awareness Legacy" },
+};
+
+struct nsp_result
+{
+    WCHAR *name;
+    WCHAR *comment;
+    CSADDR_INFO *addrs;
+    SOCKADDR_STORAGE *sockaddrs;   /* two per address: local, remote */
+    unsigned int addr_count;
+    BYTE *blob;
+    DWORD blob_size;
+};
+
+#define NSP_LOOKUP_MAGIC 0x4e53504c  /* "NSPL" */
+
+struct nsp_lookup
+{
+    DWORD magic;
+    struct list entry;
+    CRITICAL_SECTION cs;
+    DWORD name_space;   /* NS_DNS or NS_NLA */
+    DWORD flags;
+    GUID class_id;
+    struct nsp_result *results;
+    unsigned int count, next;
+
+    /* SIO_NSP_NOTIFY_CHANGE */
+    BOOL watching;
+    BOOL changed;
+    HANDLE change_event, change_wait;
+    OVERLAPPED change_ov;
+    BOOL pending;
+    WSACOMPLETION completion;
+    HANDLE apc_thread;
+};
+
+static struct list lookups = LIST_INIT( lookups );
+static CRITICAL_SECTION lookups_cs;
+static CRITICAL_SECTION_DEBUG lookups_cs_debug =
+{
+    0, 0, &lookups_cs,
+    { &lookups_cs_debug.ProcessLocksList, &lookups_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": lookups_cs") }
+};
+static CRITICAL_SECTION lookups_cs = { &lookups_cs_debug, -1, 0, 0, 0, 0 };
+
+static WCHAR *strdupW( const WCHAR *str )
+{
+    WCHAR *ret;
+    if (!str) return NULL;
+    if ((ret = malloc( (wcslen( str ) + 1) * sizeof(WCHAR) ))) wcscpy( ret, str );
+    return ret;
+}
+
+static WCHAR *strdupAtoW( const char *str )
+{
+    WCHAR *ret;
+    int len;
+    if (!str) return NULL;
+    len = MultiByteToWideChar( CP_ACP, 0, str, -1, NULL, 0 );
+    if ((ret = malloc( len * sizeof(WCHAR) ))) MultiByteToWideChar( CP_ACP, 0, str, -1, ret, len );
+    return ret;
+}
+
+static void free_results( struct nsp_lookup *lookup )
+{
+    unsigned int i;
+    for (i = 0; i < lookup->count; i++)
+    {
+        free( lookup->results[i].name );
+        free( lookup->results[i].comment );
+        free( lookup->results[i].addrs );
+        free( lookup->results[i].sockaddrs );
+        free( lookup->results[i].blob );
+    }
+    free( lookup->results );
+    lookup->results = NULL;
+    lookup->count = 0;
+}
+
+static struct nsp_result *add_result( struct nsp_lookup *lookup )
+{
+    struct nsp_result *results;
+    if (!(results = realloc( lookup->results, (lookup->count + 1) * sizeof(*results) ))) return NULL;
+    lookup->results = results;
+    memset( &results[lookup->count], 0, sizeof(*results) );
+    return &results[lookup->count++];
+}
+
+static BOOL add_address( struct nsp_result *result, const struct sockaddr *addr, int addr_len,
+                         int socktype, int protocol )
+{
+    SOCKADDR_STORAGE *sockaddrs;
+    CSADDR_INFO *addrs;
+    unsigned int i;
+
+    if (addr_len > sizeof(SOCKADDR_STORAGE)) return TRUE;
+    /* each address once */
+    for (i = 0; i < result->addr_count; i++)
+        if (result->addrs[i].RemoteAddr.iSockaddrLength == addr_len &&
+            !memcmp( &result->sockaddrs[2 * i + 1], addr, addr_len )) return TRUE;
+
+    if (!(addrs = realloc( result->addrs, (result->addr_count + 1) * sizeof(*addrs) ))) return FALSE;
+    result->addrs = addrs;
+    if (!(sockaddrs = realloc( result->sockaddrs, (result->addr_count + 1) * 2 * sizeof(*sockaddrs) ))) return FALSE;
+    result->sockaddrs = sockaddrs;
+
+    i = result->addr_count++;
+    memset( &sockaddrs[2 * i], 0, sizeof(*sockaddrs) );
+    sockaddrs[2 * i].ss_family = addr->sa_family;      /* the local end: any address */
+    memcpy( &sockaddrs[2 * i + 1], addr, addr_len );
+    addrs[i].LocalAddr.iSockaddrLength = addr_len;
+    addrs[i].RemoteAddr.iSockaddrLength = addr_len;
+    addrs[i].iSocketType = socktype;
+    addrs[i].iProtocol = protocol;
+    /* the pointers are set when the result is written out */
+    return TRUE;
+}
+
+/* a HOSTENT with offsets from its start for pointers, as the DNS provider
+ * gives for SVCID_INET_HOSTADDRBYNAME */
+static BOOL make_hostent_blob( struct nsp_result *result, const char *name )
+{
+    unsigned int count = 0, i, n;
+    size_t size, name_off, aliases_off, list_off, addrs_off;
+    struct hostent *he;
+    BYTE *blob;
+
+    for (i = 0; i < result->addr_count; i++)
+        if (result->sockaddrs[2 * i + 1].ss_family == AF_INET) count++;
+
+    aliases_off = sizeof(struct hostent);
+    list_off = aliases_off + sizeof(char *);
+    addrs_off = list_off + (count + 1) * sizeof(char *);
+    name_off = addrs_off + count * 4;
+    size = name_off + strlen( name ) + 1;
+    if (!(blob = calloc( 1, size ))) return FALSE;
+
+    he = (struct hostent *)blob;
+    he->h_name = (char *)name_off;
+    he->h_aliases = (char **)aliases_off;
+    he->h_addrtype = AF_INET;
+    he->h_length = 4;
+    he->h_addr_list = (char **)list_off;
+    for (i = n = 0; i < result->addr_count; i++)
+    {
+        struct sockaddr_in *sin = (struct sockaddr_in *)&result->sockaddrs[2 * i + 1];
+        if (sin->sin_family != AF_INET) continue;
+        ((char **)(blob + list_off))[n] = (char *)(addrs_off + n * 4);
+        memcpy( blob + addrs_off + n * 4, &sin->sin_addr, 4 );
+        n++;
+    }
+    strcpy( (char *)blob + name_off, name );
+    result->blob = blob;
+    result->blob_size = size;
+    return TRUE;
+}
+
+static int lookup_hosts( struct nsp_lookup *lookup, const WCHAR *name, const WSAQUERYSETW *query )
+{
+    ADDRINFOW hints = {0}, *info = NULL, *ai;
+    struct nsp_result *result;
+    WCHAR local[256];
+    char *nameA;
+    int family = AF_UNSPEC, ret, len;
+    unsigned int i;
+
+    if (query->dwNumberOfProtocols && query->lpafpProtocols)
+    {
+        BOOL v4 = FALSE, v6 = FALSE;
+        for (i = 0; i < query->dwNumberOfProtocols; i++)
+        {
+            if (query->lpafpProtocols[i].iAddressFamily == AF_INET) v4 = TRUE;
+            if (query->lpafpProtocols[i].iAddressFamily == AF_INET6) v6 = TRUE;
+        }
+        if (v4 && !v6) family = AF_INET;
+        else if (v6 && !v4) family = AF_INET6;
+    }
+    if (IsEqualGUID( &lookup->class_id, &svcid_hostaddr_by_name )) family = AF_INET;  /* a HOSTENT is IPv4 */
+
+    if (!name || !*name)
+    {
+        if (IsEqualGUID( &lookup->class_id, &svcid_hostaddr_by_str )) return WSAEINVAL;
+        if (GetHostNameW( local, ARRAY_SIZE(local) )) return WSAGetLastError();
+        name = local;
+    }
+
+    hints.ai_family = family;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_flags = AI_CANONNAME;
+    if (IsEqualGUID( &lookup->class_id, &svcid_hostaddr_by_str )) hints.ai_flags |= AI_NUMERICHOST;
+    if ((ret = GetAddrInfoW( name, NULL, &hints, &info )))
+        return ret == WSAHOST_NOT_FOUND || ret == WSANO_DATA || ret == WSATRY_AGAIN || ret == WSANO_RECOVERY
+               ? ret : WSAHOST_NOT_FOUND;
+
+    if (!(result = add_result( lookup )))
+    {
+        FreeAddrInfoW( info );
+        return WSA_NOT_ENOUGH_MEMORY;
+    }
+    result->name = strdupW( info->ai_canonname && *info->ai_canonname ? info->ai_canonname : name );
+    for (ai = info; ai; ai = ai->ai_next)
+    {
+        if (ai->ai_family != AF_INET && ai->ai_family != AF_INET6) continue;
+        if (!add_address( result, ai->ai_addr, ai->ai_addrlen, SOCK_STREAM, IPPROTO_TCP ))
+        {
+            FreeAddrInfoW( info );
+            return WSA_NOT_ENOUGH_MEMORY;
+        }
+    }
+    FreeAddrInfoW( info );
+    if (!result->name) return WSA_NOT_ENOUGH_MEMORY;
+
+    if (IsEqualGUID( &lookup->class_id, &svcid_hostaddr_by_name ))
+    {
+        len = WideCharToMultiByte( CP_ACP, 0, result->name, -1, NULL, 0, NULL, NULL );
+        if (!(nameA = malloc( len ))) return WSA_NOT_ENOUGH_MEMORY;
+        WideCharToMultiByte( CP_ACP, 0, result->name, -1, nameA, len, NULL, NULL );
+        ret = make_hostent_blob( result, nameA ) ? 0 : WSA_NOT_ENOUGH_MEMORY;
+        free( nameA );
+        return ret;
+    }
+    return 0;
+}
+
+/* "ftp", "ftp/tcp", "53/udp" -> the port; a SERVENT blob, pointers as offsets */
+static int lookup_service( struct nsp_lookup *lookup, const WCHAR *name )
+{
+    char *nameA, *proto, *end;
+    struct nsp_result *result;
+    struct servent *se;
+    size_t size, name_off, proto_off;
+    unsigned long port;
+    BYTE *blob;
+    int len;
+
+    if (!name || !*name) return WSAEINVAL;
+    len = WideCharToMultiByte( CP_ACP, 0, name, -1, NULL, 0, NULL, NULL );
+    if (!(nameA = malloc( len ))) return WSA_NOT_ENOUGH_MEMORY;
+    WideCharToMultiByte( CP_ACP, 0, name, -1, nameA, len, NULL, NULL );
+    if ((proto = strchr( nameA, '/' ))) *proto++ = 0;
+
+    port = strtoul( nameA, &end, 10 );
+    se = (*nameA && !*end) ? getservbyport( htons( (u_short)port ), proto ) : getservbyname( nameA, proto );
+    if (!se)
+    {
+        free( nameA );
+        return WSASERVICE_NOT_FOUND;
+    }
+
+    name_off = sizeof(struct servent) + sizeof(char *);   /* no aliases */
+    proto_off = name_off + strlen( se->s_name ) + 1;
+    size = proto_off + strlen( se->s_proto ) + 1;
+    if (!(blob = calloc( 1, size )) || !(result = add_result( lookup )))
+    {
+        free( blob );
+        free( nameA );
+        return WSA_NOT_ENOUGH_MEMORY;
+    }
+    ((struct servent *)blob)->s_name = (char *)name_off;
+    ((struct servent *)blob)->s_aliases = (char **)sizeof(struct servent);
+    ((struct servent *)blob)->s_port = se->s_port;
+    ((struct servent *)blob)->s_proto = (char *)proto_off;
+    strcpy( (char *)blob + name_off, se->s_name );
+    strcpy( (char *)blob + proto_off, se->s_proto );
+    result->blob = blob;
+    result->blob_size = size;
+    result->name = strdupAtoW( se->s_name );
+    free( nameA );
+    return result->name ? 0 : WSA_NOT_ENOUGH_MEMORY;
+}
+
+struct nla_header
+{
+    NLA_BLOB_DATA_TYPE type;
+    DWORD size;
+    DWORD next;
+};
+
+static IP_ADAPTER_ADDRESSES *get_adapters(void)
+{
+    IP_ADAPTER_ADDRESSES *adapters = NULL;
+    ULONG size = 16384, ret;
+
+    for (;;)
+    {
+        if (!(adapters = malloc( size ))) return NULL;
+        ret = GetAdaptersAddresses( AF_UNSPEC, GAA_FLAG_INCLUDE_GATEWAYS | GAA_FLAG_SKIP_ANYCAST |
+                                    GAA_FLAG_SKIP_MULTICAST, NULL, adapters, &size );
+        if (ret == ERROR_SUCCESS) return adapters;
+        free( adapters );
+        if (ret != ERROR_BUFFER_OVERFLOW) return NULL;
+    }
+}
+
+/* one result per connected network: an adapter that is up, is not the
+ * loopback and has an address */
+static int lookup_networks( struct nsp_lookup *lookup, const WCHAR *name )
+{
+    IP_ADAPTER_ADDRESSES *adapters, *a;
+    struct nsp_result *result;
+    struct nla_header *hdr;
+    DWORD *data;
+    BYTE *base;
+    size_t iface_size, conn_size;
+    char adapter_name[256];
+    BOOL managed, internet;
+
+    if (!(adapters = get_adapters())) return WSA_NOT_ENOUGH_MEMORY;
+    for (a = adapters; a; a = a->Next)
+    {
+        const WCHAR *network;
+
+        if (a->OperStatus != IfOperStatusUp || a->IfType == IF_TYPE_SOFTWARE_LOOPBACK || !a->FirstUnicastAddress)
+            continue;
+        network = a->DnsSuffix && *a->DnsSuffix ? a->DnsSuffix : a->FriendlyName;
+        if (name && *name && wcsicmp( name, network )) continue;
+
+        if (!(result = add_result( lookup ))) break;
+        result->name = strdupW( network );
+        result->comment = strdupW( a->Description );
+
+        lstrcpynA( adapter_name, a->AdapterName, sizeof(adapter_name) );
+        iface_size = (offsetof(NLA_BLOB, data.interfaceData.adapterName) + strlen( adapter_name ) + 1 + 7) & ~7;
+        conn_size = offsetof(NLA_BLOB, data.connectivity.internet) + sizeof(NLA_INTERNET);
+        if (!(base = calloc( 1, iface_size + conn_size ))) break;
+        result->blob = base;
+        result->blob_size = iface_size + conn_size;
+
+        /* written field by field: an NLA_BLOB is larger than one record */
+        hdr = (struct nla_header *)base;
+        hdr->type = NLA_INTERFACE;
+        hdr->size = iface_size;
+        hdr->next = iface_size;
+        data = (DWORD *)(base + offsetof(NLA_BLOB, data));
+        data[0] = a->IfType;
+        data[1] = (DWORD)min( a->TransmitLinkSpeed / 1000, (ULONG64)MAXDWORD );
+        strcpy( (char *)base + offsetof(NLA_BLOB, data.interfaceData.adapterName), adapter_name );
+
+        managed = a->DnsSuffix && *a->DnsSuffix;
+        internet = a->FirstGatewayAddress != NULL;
+        hdr = (struct nla_header *)(base + iface_size);
+        hdr->type = NLA_CONNECTIVITY;
+        hdr->size = conn_size;
+        hdr->next = 0;
+        data = (DWORD *)(base + iface_size + offsetof(NLA_BLOB, data));
+        data[0] = managed ? NLA_NETWORK_MANAGED : NLA_NETWORK_UNMANAGED;
+        data[1] = internet ? NLA_INTERNET_YES : NLA_INTERNET_NO;
+        if (!result->name || !result->comment) break;
+    }
+    free( adapters );
+    return a ? WSA_NOT_ENOUGH_MEMORY : 0;
+}
+
+/* the lookup a handle names, locked; with remove, also taken off the list */
+static struct nsp_lookup *grab_lookup_ex( HANDLE handle, BOOL remove )
+{
+    struct nsp_lookup *lookup;
+
+    EnterCriticalSection( &lookups_cs );
+    LIST_FOR_EACH_ENTRY( lookup, &lookups, struct nsp_lookup, entry )
+    {
+        if (lookup == handle && lookup->magic == NSP_LOOKUP_MAGIC)
+        {
+            EnterCriticalSection( &lookup->cs );
+            if (remove)
+            {
+                list_remove( &lookup->entry );
+                lookup->magic = 0;
+            }
+            LeaveCriticalSection( &lookups_cs );
+            return lookup;
+        }
+    }
+    LeaveCriticalSection( &lookups_cs );
+    return NULL;
+}
+
+static struct nsp_lookup *grab_lookup( HANDLE handle )
+{
+    return grab_lookup_ex( handle, FALSE );
+}
+
+/***********************************************************************
+ *      WSALookupServiceBeginW   (ws2_32.@)
+ */
+int WINAPI WSALookupServiceBeginW( WSAQUERYSETW *query, DWORD flags, HANDLE *handle )
+{
+    struct nsp_lookup *lookup;
+    BOOL nla;
+    int err;
+
+    TRACE( "(%p %#lx %p)\n", query, flags, handle );
+
+    if (!query || !handle)
+    {
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    if (query->dwSize < sizeof(*query))
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+    TRACE( "name %s class %s name space %lu\n", debugstr_w(query->lpszServiceInstanceName),
+           debugstr_guid(query->lpServiceClassId), query->dwNameSpace );
+
+    /* no class: the list of networks, as Windows answers it */
+    if (!query->lpServiceClassId && query->dwNameSpace == NS_DNS)
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+    nla = !query->lpServiceClassId || IsEqualGUID( query->lpServiceClassId, &nla_service_class );
+    if ((query->dwNameSpace != NS_ALL && query->dwNameSpace != NS_DNS && query->dwNameSpace != NS_NLA) ||
+        (query->dwNameSpace == NS_NLA && !nla) || (query->dwNameSpace == NS_DNS && nla))
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+
+    if (!(lookup = calloc( 1, sizeof(*lookup) )))
+    {
+        SetLastError( WSA_NOT_ENOUGH_MEMORY );
+        return SOCKET_ERROR;
+    }
+    lookup->magic = NSP_LOOKUP_MAGIC;
+    lookup->flags = flags;
+    lookup->class_id = query->lpServiceClassId ? *query->lpServiceClassId : nla_service_class;
+    lookup->name_space = nla ? NS_NLA : NS_DNS;
+    InitializeCriticalSectionEx( &lookup->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    lookup->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": nsp_lookup.cs");
+
+    if (flags & LUP_CONTAINERS)
+        err = 0;   /* neither name space has containers */
+    else if (nla)
+        err = lookup_networks( lookup, query->lpszServiceInstanceName );
+    else if (IsEqualGUID( &lookup->class_id, &svcid_hostname ) ||
+             IsEqualGUID( query->lpServiceClassId, &svcid_hostaddr_by_name ) ||
+             IsEqualGUID( query->lpServiceClassId, &svcid_hostaddr_by_str ))
+        err = lookup_hosts( lookup, query->lpszServiceInstanceName, query );
+    else if (IsEqualGUID( query->lpServiceClassId, &svcid_service_by_name ))
+        err = lookup_service( lookup, query->lpszServiceInstanceName );
+    else
+    {
+        FIXME( "service class %s not supported\n", debugstr_guid(query->lpServiceClassId) );
+        err = WSASERVICE_NOT_FOUND;
+    }
+
+    if (err)
+    {
+        free_results( lookup );
+        lookup->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &lookup->cs );
+        free( lookup );
+        SetLastError( err );
+        return SOCKET_ERROR;
+    }
+
+    EnterCriticalSection( &lookups_cs );
+    list_add_tail( &lookups, &lookup->entry );
+    LeaveCriticalSection( &lookups_cs );
+    *handle = lookup;
+    return 0;
+}
+
+static WCHAR *query_strdupAtoW( const char *str, BOOL *ok )
+{
+    WCHAR *ret = NULL;
+    if (str && !(ret = strdupAtoW( str ))) *ok = FALSE;
+    return ret;
+}
+
+/***********************************************************************
+ *      WSALookupServiceBeginA   (ws2_32.@)
+ */
+int WINAPI WSALookupServiceBeginA( WSAQUERYSETA *query, DWORD flags, HANDLE *handle )
+{
+    WSAQUERYSETW queryW;
+    BOOL ok = TRUE;
+    int ret;
+
+    TRACE( "(%p %#lx %p)\n", query, flags, handle );
+
+    if (!query || !handle)
+    {
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    if (query->dwSize < sizeof(*query))
+    {
+        SetLastError( WSAEINVAL );
+        return SOCKET_ERROR;
+    }
+    memset( &queryW, 0, sizeof(queryW) );
+    queryW.dwSize = sizeof(queryW);
+    queryW.lpszServiceInstanceName = query_strdupAtoW( query->lpszServiceInstanceName, &ok );
+    queryW.lpServiceClassId = query->lpServiceClassId;
+    queryW.lpVersion = query->lpVersion;
+    queryW.dwNameSpace = query->dwNameSpace;
+    queryW.lpNSProviderId = query->lpNSProviderId;
+    queryW.lpszContext = query_strdupAtoW( query->lpszContext, &ok );
+    queryW.dwNumberOfProtocols = query->dwNumberOfProtocols;
+    queryW.lpafpProtocols = query->lpafpProtocols;
+    queryW.lpszQueryString = query_strdupAtoW( query->lpszQueryString, &ok );
+    if (ok)
+        ret = WSALookupServiceBeginW( &queryW, flags, handle );
+    else
+    {
+        SetLastError( WSA_NOT_ENOUGH_MEMORY );
+        ret = SOCKET_ERROR;
+    }
+    free( queryW.lpszServiceInstanceName );
+    free( queryW.lpszContext );
+    free( queryW.lpszQueryString );
+    return ret;
+}
+
+#define ALIGN_PTR(x) (((x) + sizeof(void *) - 1) & ~(sizeof(void *) - 1))
+
+static size_t string_size( const WCHAR *str, BOOL ansi )
+{
+    if (!str) return 0;
+    if (ansi) return WideCharToMultiByte( CP_ACP, 0, str, -1, NULL, 0, NULL, NULL );
+    return (wcslen( str ) + 1) * sizeof(WCHAR);
+}
+
+static void *put_string( BYTE *base, size_t *off, const WCHAR *str, BOOL ansi )
+{
+    void *ret = base + *off;
+    size_t size = string_size( str, ansi );
+    if (ansi) WideCharToMultiByte( CP_ACP, 0, str, -1, ret, size, NULL, NULL );
+    else memcpy( ret, str, size );
+    *off += size;
+    return ret;
+}
+
+/* the size of a result as the caller gets it, or, with base, write it */
+static size_t write_result( const struct nsp_lookup *lookup, const struct nsp_result *result,
+                            DWORD flags, BYTE *base, BOOL ansi )
+{
+    WSAQUERYSETW *qs = (WSAQUERYSETW *)base;   /* same layout as WSAQUERYSETA */
+    size_t off = sizeof(WSAQUERYSETW);
+    unsigned int i;
+
+    C_ASSERT( sizeof(WSAQUERYSETW) == sizeof(WSAQUERYSETA) );
+
+    if (base)
+    {
+        memset( qs, 0, sizeof(*qs) );
+        qs->dwSize = sizeof(*qs);
+        qs->dwNameSpace = lookup->name_space;
+    }
+
+    off = ALIGN_PTR( off );
+    if (base)
+    {
+        qs->lpServiceClassId = (GUID *)(base + off);
+        *qs->lpServiceClassId = lookup->class_id;
+    }
+    off += sizeof(GUID);
+    if (base)
+    {
+        qs->lpNSProviderId = (GUID *)(base + off);
+        *qs->lpNSProviderId = lookup->name_space == NS_NLA ? nla_provider_id : dns_provider_id;
+    }
+    off += sizeof(GUID);
+
+    if (flags & LUP_RETURN_ADDR && result->addr_count)
+    {
+        CSADDR_INFO *addrs = NULL;
+        off = ALIGN_PTR( off );
+        if (base)
+        {
+            qs->lpcsaBuffer = addrs = (CSADDR_INFO *)(base + off);
+            qs->dwNumberOfCsAddrs = result->addr_count;
+        }
+        off += result->addr_count * sizeof(CSADDR_INFO);
+        for (i = 0; i < result->addr_count; i++)
+        {
+            int len = result->addrs[i].RemoteAddr.iSockaddrLength;
+            off = ALIGN_PTR( off );
+            if (base)
+            {
+                addrs[i] = result->addrs[i];
+                addrs[i].LocalAddr.lpSockaddr = (SOCKADDR *)(base + off);
+                memcpy( base + off, &result->sockaddrs[2 * i], len );
+                addrs[i].RemoteAddr.lpSockaddr = (SOCKADDR *)(base + off + len);
+                memcpy( base + off + len, &result->sockaddrs[2 * i + 1], len );
+            }
+            off += 2 * len;
+        }
+    }
+
+#ifdef SG_MUTANT_NO_BLOB
+    flags &= ~LUP_RETURN_BLOB;
+#endif
+    if (flags & LUP_RETURN_BLOB && result->blob)
+    {
+        off = ALIGN_PTR( off );
+        if (base) qs->lpBlob = (BLOB *)(base + off);
+        off += sizeof(BLOB);
+        off = ALIGN_PTR( off );
+        if (base)
+        {
+            qs->lpBlob->cbSize = result->blob_size;
+            qs->lpBlob->pBlobData = base + off;
+            memcpy( base + off, result->blob, result->blob_size );
+        }
+        off += result->blob_size;
+    }
+
+    if (flags & LUP_RETURN_NAME && result->name)
+    {
+        if (base) qs->lpszServiceInstanceName = put_string( base, &off, result->name, ansi );
+        else off += string_size( result->name, ansi );
+    }
+    if (flags & LUP_RETURN_COMMENT && result->comment)
+    {
+        if (base) qs->lpszComment = put_string( base, &off, result->comment, ansi );
+        else off += string_size( result->comment, ansi );
+    }
+    return off;
+}
+
+static int lookup_next( HANDLE handle, DWORD flags, DWORD *len, BYTE *results, BOOL ansi )
+{
+    struct nsp_lookup *lookup;
+    size_t size;
+    int err = 0;
+
+    if (!len)
+    {
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    if (!(lookup = grab_lookup( handle )))
+    {
+        SetLastError( WSA_INVALID_HANDLE );
+        return SOCKET_ERROR;
+    }
+
+    if (flags & LUP_FLUSHPREVIOUS && lookup->next < lookup->count) lookup->next++;
+    if (lookup->next >= lookup->count)
+        err = WSA_E_NO_MORE;
+    else
+    {
+        /* the flags given to Next replace Begin's return flags when set */
+        DWORD ret_flags = (flags & LUP_RETURN_ALL) ? flags : lookup->flags;
+        size = write_result( lookup, &lookup->results[lookup->next], ret_flags, NULL, ansi );
+        if (!results || *len < size)
+        {
+            *len = size;
+            err = WSAEFAULT;
+        }
+        else
+        {
+            write_result( lookup, &lookup->results[lookup->next], ret_flags, results, ansi );
+            lookup->next++;
+        }
+    }
+    LeaveCriticalSection( &lookup->cs );
+    if (err)
+    {
+        SetLastError( err );
+        return SOCKET_ERROR;
+    }
+    return 0;
+}
+
+/***********************************************************************
+ *      WSALookupServiceNextW   (ws2_32.@)
+ */
+int WINAPI WSALookupServiceNextW( HANDLE handle, DWORD flags, DWORD *len, WSAQUERYSETW *results )
+{
+    TRACE( "(%p %#lx %p %p)\n", handle, flags, len, results );
+    return lookup_next( handle, flags, len, (BYTE *)results, FALSE );
+}
+
+/***********************************************************************
+ *      WSALookupServiceNextA   (ws2_32.@)
+ */
+int WINAPI WSALookupServiceNextA( HANDLE handle, DWORD flags, DWORD *len, WSAQUERYSETA *results )
+{
+    TRACE( "(%p %#lx %p %p)\n", handle, flags, len, results );
+    return lookup_next( handle, flags, len, (BYTE *)results, TRUE );
+}
+
+static void WINAPI apc_completion( ULONG_PTR arg )
+{
+    WSACOMPLETION *completion = (WSACOMPLETION *)arg;
+    OVERLAPPED *ov = completion->Parameters.Apc.lpOverlapped;
+    LPWSAOVERLAPPED_COMPLETION_ROUTINE proc = completion->Parameters.Apc.lpfnCompletionProc;
+
+    proc( ov->Internal == STATUS_SUCCESS ? 0 : WSA_OPERATION_ABORTED, 0, ov, 0 );
+    free( completion );
+}
+
+/* tell the waiter, lookup->cs held */
+static void complete_notify( struct nsp_lookup *lookup, NTSTATUS status )
+{
+    WSACOMPLETION *c = &lookup->completion;
+
+    if (!lookup->pending) return;
+    lookup->pending = FALSE;
+    switch (c->Type)
+    {
+    case NSP_NOTIFY_EVENT:
+        c->Parameters.Event.lpOverlapped->Internal = status;
+        c->Parameters.Event.lpOverlapped->InternalHigh = 0;
+        if (c->Parameters.Event.lpOverlapped->hEvent) SetEvent( c->Parameters.Event.lpOverlapped->hEvent );
+        break;
+    case NSP_NOTIFY_PORT:
+        c->Parameters.Port.lpOverlapped->Internal = status;
+        c->Parameters.Port.lpOverlapped->InternalHigh = 0;
+        PostQueuedCompletionStatus( c->Parameters.Port.hPort, 0, c->Parameters.Port.Key,
+                                    c->Parameters.Port.lpOverlapped );
+        break;
+    case NSP_NOTIFY_HWND:
+        PostMessageW( c->Parameters.WindowMessage.hWnd, c->Parameters.WindowMessage.uMsg,
+                      c->Parameters.WindowMessage.context, status == STATUS_SUCCESS ? 0 : WSA_OPERATION_ABORTED );
+        break;
+    case NSP_NOTIFY_APC:
+    {
+        WSACOMPLETION *copy = malloc( sizeof(*copy) );
+        c->Parameters.Apc.lpOverlapped->Internal = status;
+        c->Parameters.Apc.lpOverlapped->InternalHigh = 0;
+        if (copy)
+        {
+            *copy = *c;
+            if (!QueueUserAPC( apc_completion, lookup->apc_thread, (ULONG_PTR)copy )) free( copy );
+        }
+        CloseHandle( lookup->apc_thread );
+        lookup->apc_thread = NULL;
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+static void arm_watch( struct nsp_lookup *lookup )
+{
+    HANDLE h;
+    DWORD ret;
+
+    memset( &lookup->change_ov, 0, sizeof(lookup->change_ov) );
+    lookup->change_ov.hEvent = lookup->change_event;
+    ret = NotifyAddrChange( &h, &lookup->change_ov );
+    if (ret != ERROR_IO_PENDING && ret != NO_ERROR) WARN( "NotifyAddrChange failed: %lu\n", ret );
+}
+
+static void CALLBACK network_changed( void *context, BOOLEAN timeout )
+{
+    struct nsp_lookup *lookup = context;
+
+    EnterCriticalSection( &lookup->cs );
+    TRACE( "lookup %p: the networks changed\n", lookup );
+    lookup->changed = TRUE;
+    if (lookup->pending)
+    {
+        lookup->changed = FALSE;
+        complete_notify( lookup, STATUS_SUCCESS );
+    }
+    arm_watch( lookup );
+    LeaveCriticalSection( &lookup->cs );
+}
+
+static BOOL start_watch( struct nsp_lookup *lookup )
+{
+    if (lookup->watching) return TRUE;
+    if (!(lookup->change_event = CreateEventW( NULL, FALSE, FALSE, NULL ))) return FALSE;
+    arm_watch( lookup );
+    if (!RegisterWaitForSingleObject( &lookup->change_wait, lookup->change_event, network_changed, lookup,
+                                      INFINITE, WT_EXECUTEDEFAULT ))
+    {
+        CancelIPChangeNotify( &lookup->change_ov );
+        CloseHandle( lookup->change_event );
+        lookup->change_event = NULL;
+        return FALSE;
+    }
+    lookup->watching = TRUE;
+    return TRUE;
+}
+
+/***********************************************************************
+ *      WSANSPIoctl   (ws2_32.@)
+ */
+int WINAPI WSANSPIoctl( HANDLE handle, DWORD code, void *in_buffer, DWORD in_size, void *out_buffer,
+                        DWORD out_size, DWORD *ret_size, WSACOMPLETION *completion )
+{
+    struct nsp_lookup *lookup;
+    int err = 0;
+
+    TRACE( "(%p, %#lx, %p, %#lx, %p, %#lx, %p, %p)\n", handle, code, in_buffer, in_size,
+           out_buffer, out_size, ret_size, completion );
+
+    if (!(lookup = grab_lookup( handle )))
+    {
+        SetLastError( WSA_INVALID_HANDLE );
+        return SOCKET_ERROR;
+    }
+
+    if (code != SIO_NSP_NOTIFY_CHANGE)
+        err = WSAEOPNOTSUPP;
+    else if (lookup->name_space != NS_NLA)
+        err = WSAEOPNOTSUPP;   /* the DNS provider has no change notifications */
+#ifdef SG_MUTANT_POLL_ALWAYS_CHANGED
+    else if (!completion && (lookup->changed = TRUE) && FALSE) ;
+#endif
+    else if (!start_watch( lookup ))
+        err = WSA_NOT_ENOUGH_MEMORY;
+    else if (!completion || completion->Type == NSP_NOTIFY_IMMEDIATELY)
+    {
+        /* a poll: has anything changed since the last call? */
+        if (lookup->changed) lookup->changed = FALSE;
+        else err = WSAEWOULDBLOCK;
+    }
+    else if (lookup->pending)
+        err = WSAEINVAL;
+    else if (completion->Type > NSP_NOTIFY_APC)
+        err = WSAEINVAL;
+    else
+    {
+        lookup->completion = *completion;
+        if (completion->Type == NSP_NOTIFY_APC &&
+            !DuplicateHandle( GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(),
+                              &lookup->apc_thread, 0, FALSE, DUPLICATE_SAME_ACCESS ))
+            err = WSA_NOT_ENOUGH_MEMORY;
+        else
+        {
+            OVERLAPPED *ov = NULL;
+            if (completion->Type == NSP_NOTIFY_EVENT) ov = completion->Parameters.Event.lpOverlapped;
+            else if (completion->Type == NSP_NOTIFY_PORT) ov = completion->Parameters.Port.lpOverlapped;
+            else if (completion->Type == NSP_NOTIFY_APC) ov = completion->Parameters.Apc.lpOverlapped;
+            if (ov)
+            {
+                ov->Internal = STATUS_PENDING;
+                ov->InternalHigh = 0;
+            }
+            lookup->pending = TRUE;
+            if (lookup->changed)
+            {
+                lookup->changed = FALSE;
+                complete_notify( lookup, STATUS_SUCCESS );
+            }
+            err = WSA_IO_PENDING;
+        }
+    }
+    LeaveCriticalSection( &lookup->cs );
+
+    if (ret_size) *ret_size = 0;
+    if (err)
+    {
+        SetLastError( err );
+        return SOCKET_ERROR;
+    }
+    return 0;
+}
+
+/***********************************************************************
+ *      WSALookupServiceEnd   (ws2_32.@)
+ */
+int WINAPI WSALookupServiceEnd( HANDLE handle )
+{
+    struct nsp_lookup *lookup;
+    HANDLE wait;
+
+    TRACE( "(%p)\n", handle );
+
+    if (!(lookup = grab_lookup_ex( handle, TRUE )))
+    {
+        SetLastError( WSA_INVALID_HANDLE );
+        return SOCKET_ERROR;
+    }
+
+    wait = lookup->change_wait;
+    lookup->change_wait = NULL;
+#ifndef SG_MUTANT_END_NO_CANCEL
+    complete_notify( lookup, STATUS_CANCELLED );
+#endif
+    LeaveCriticalSection( &lookup->cs );
+
+    if (wait) UnregisterWaitEx( wait, INVALID_HANDLE_VALUE );
+    if (lookup->watching) CancelIPChangeNotify( &lookup->change_ov );
+    if (lookup->change_event) CloseHandle( lookup->change_event );
+    if (lookup->apc_thread) CloseHandle( lookup->apc_thread );
+    free_results( lookup );
+    lookup->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &lookup->cs );
+    free( lookup );
+    return 0;
+}
