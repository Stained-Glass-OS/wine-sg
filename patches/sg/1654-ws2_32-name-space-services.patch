+/***********************************************************************
+ *      WSAEnumNameSpaceProvidersW   (ws2_32.@)
+ */
+int WINAPI WSAEnumNameSpaceProvidersW( DWORD *len, WSANAMESPACE_INFOW *buffer )
+{
+    size_t size = ARRAY_SIZE(providers) * sizeof(*buffer);
+    unsigned int i;
+    WCHAR *str;
+
+    TRACE( "(%p %p)\n", len, buffer );
+
+    if (!len)
+    {
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    for (i = 0; i < ARRAY_SIZE(providers); i++) size += (wcslen( providers[i].identifier ) + 1) * sizeof(WCHAR);
+    if (!buffer || *len < size)
+    {
+        *len = size;
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    str = (WCHAR *)(buffer + ARRAY_SIZE(providers));
+    for (i = 0; i < ARRAY_SIZE(providers); i++)
+    {
+        buffer[i].NSProviderId = *providers[i].id;
+        buffer[i].dwNameSpace = providers[i].name_space;
+        buffer[i].fActive = TRUE;
+        buffer[i].dwVersion = 1;
+        buffer[i].lpszIdentifier = str;
+        wcscpy( str, providers[i].identifier );
+        str += wcslen( str ) + 1;
+    }
+    return ARRAY_SIZE(providers);
+}
+
+/***********************************************************************
+ *      WSAEnumNameSpaceProvidersA   (ws2_32.@)
+ */
+int WINAPI WSAEnumNameSpaceProvidersA( DWORD *len, WSANAMESPACE_INFOA *buffer )
+{
+    size_t size = ARRAY_SIZE(providers) * sizeof(*buffer);
+    unsigned int i;
+    char *str;
+
+    TRACE( "(%p %p)\n", len, buffer );
+
+    if (!len)
+    {
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    for (i = 0; i < ARRAY_SIZE(providers); i++)
+        size += WideCharToMultiByte( CP_ACP, 0, providers[i].identifier, -1, NULL, 0, NULL, NULL );
+    if (!buffer || *len < size)
+    {
+        *len = size;
+        SetLastError( WSAEFAULT );
+        return SOCKET_ERROR;
+    }
+    str = (char *)(buffer + ARRAY_SIZE(providers));
+    for (i = 0; i < ARRAY_SIZE(providers); i++)
+    {
+        buffer[i].NSProviderId = *providers[i].id;
+        buffer[i].dwNameSpace = providers[i].name_space;
+        buffer[i].fActive = TRUE;
+        buffer[i].dwVersion = 1;
+        buffer[i].lpszIdentifier = str;
+        str += WideCharToMultiByte( CP_ACP, 0, providers[i].identifier, -1, str,
+                                    size - (str - (char *)buffer), NULL, NULL );
+    }
+    return ARRAY_SIZE(providers);
+}
+
+/* is this the id of one of the transport providers WSAEnumProtocols lists? */
+static BOOL is_transport_provider( const GUID *id )
+{
+    WSAPROTOCOL_INFOW *info;
+    DWORD size = 0;
+    int count, i;
+    BOOL ret = FALSE;
+
+    WSAEnumProtocolsW( NULL, NULL, &size );
+    if (!size || !(info = malloc( size ))) return FALSE;
+    count = WSAEnumProtocolsW( NULL, info, &size );
+    for (i = 0; i < count && !ret; i++) ret = IsEqualGUID( &info[i].ProviderId, id );
+    free( info );
+    return ret;
+}
+
+/***********************************************************************
+ *      WSCGetProviderPath   (ws2_32.@)
+ */
+int WINAPI WSCGetProviderPath( GUID *provider, WCHAR *path, int *len, int *errcode )
+{
+    static const WCHAR provider_path[] = L"%SystemRoot%\\system32\\mswsock.dll";
+
+    TRACE( "(%s %p %p %p)\n", debugstr_guid(provider), path, len, errcode );
+
+    if (!errcode) return SOCKET_ERROR;
+    if (!provider || !len)
+    {
+        *errcode = WSAEFAULT;
+        return SOCKET_ERROR;
+    }
+    if (*len <= 0)
+    {
+        *errcode = WSAEINVAL;
+        return SOCKET_ERROR;
+    }
+    /* the base transport providers, and the name space providers, live in mswsock */
+    if (!is_transport_provider( provider ) && !IsEqualGUID( provider, &dns_provider_id ) &&
+        !IsEqualGUID( provider, &nla_provider_id ))
+    {
+        *errcode = WSAEINVAL;
+        return SOCKET_ERROR;
+    }
+    if (!path || *len < ARRAY_SIZE(provider_path))
+    {
+        *len = ARRAY_SIZE(provider_path);
+        *errcode = WSAEFAULT;
+        return SOCKET_ERROR;
+    }
+    wcscpy( path, provider_path );
+    *len = ARRAY_SIZE(provider_path) - 1;
+    return 0;
+}
+
+/***********************************************************************
+ *      WSCGetProviderInfo   (ws2_32.@)
+ */
+int WINAPI WSCGetProviderInfo( GUID *provider, WSC_PROVIDER_INFO_TYPE info_type,
+                               BYTE *info, size_t *len, DWORD flags, int *errcode )
+{
+    size_t need;
+
+    TRACE( "(%s %#x %p %p %#lx %p)\n", debugstr_guid(provider), info_type, info, len, flags, errcode );
+
+    if (!errcode) return SOCKET_ERROR;
+    if (!provider)
+    {
+        *errcode = WSAEFAULT;
+        return SOCKET_ERROR;
+    }
+    if (!is_transport_provider( provider ))
+    {
+        *errcode = WSANO_RECOVERY;   /* what Windows answers for an unknown provider */
+        return SOCKET_ERROR;
+    }
+
+    switch (info_type)
+    {
+    case ProviderInfoLspCategories:
+        need = sizeof(DWORD);
+        break;
+    case ProviderInfoAudit:
+        need = 2 * sizeof(void *);   /* WSC_PROVIDER_AUDIT_INFO: RecordSize, Reserved */
+        break;
+    default:
+        *errcode = WSAEINVAL;
+        return SOCKET_ERROR;
+    }
+    if (!len)
+    {
+        *errcode = WSAEFAULT;
+        return SOCKET_ERROR;
+    }
+    if (!info || *len < need)
+    {
+        *len = need;
+        *errcode = WSAEFAULT;
+        return SOCKET_ERROR;
+    }
+    memset( info, 0, need );
+    /* base providers are in no layered service provider category, and have
+     * no audit record */
+    if (info_type == ProviderInfoAudit) *(DWORD *)info = need;
+    *len = need;
+    return 0;
+}
