From: Stained Glass OS <dev@stained-glass.example>
Subject: user32: ExitWindowsEx shuts down and restarts the PC

Wine's ExitWindowsEx only runs wineboot --end-session: Shut down and Restart
-- the Start menu's, and every program's -- ended the Windows session and
left the PC on. After starting wineboot, a shut down, power-off or restart now
also starts the native helper sg-settingsctl (sg-session), which waits while
the session's programs close (the wineboot just started) and then asks logind;
polkit decides. It is not a Wine process, so ending the session does not end
it. Sign-out (EWX_LOGOFF) is unchanged. SG_POWERCTL may name a stand-in (an
absolute Unix path) for gates; like LockWorkStation's helper (0010) it carries
no authority of its own.

Found by the 2026-09-26 ISO QA pass. Gate: test/shutdown-gate.sh
(make test-shutdown).
---
--- a/dlls/user32/user_main.c
+++ b/dlls/user32/user_main.c
@@ -323,6 +323,35 @@
     Wow64RevertWow64FsRedirection( redir );
     CloseHandle( pi.hProcess );
     CloseHandle( pi.hThread );
+
+    /* Stained Glass OS: wineboot only ends the Windows session; shutting
+     * down or restarting the PC is the Linux system's. A native helper
+     * (sg-session's sg-settingsctl) waits while the session's programs close
+     * -- the wineboot just started -- and then asks logind, whose polkit
+     * decides. It is started after wineboot, which it waits for, and it is
+     * not a Wine process, so ending the session does not end it. Sign-out
+     * (EWX_LOGOFF) stays wineboot's alone. SG_POWERCTL names a stand-in (a
+     * Unix path), for gates; like LockWorkStation's helper it carries no
+     * authority of its own. */
+    if (flags & (EWX_SHUTDOWN | EWX_REBOOT | EWX_POWEROFF))
+    {
+        WCHAR helper[MAX_PATH] = L"/usr/bin/sg-settingsctl", power[MAX_PATH + 64], *p;
+
+        if (!GetEnvironmentVariableW( L"SG_POWERCTL", helper, ARRAY_SIZE(helper) ) ||
+            !helper[0] || helper[0] != '/')
+            lstrcpyW( helper, L"/usr/bin/sg-settingsctl" );
+        swprintf( power, ARRAY_SIZE(power), L"\\\\?\\unix%s shutdown %s", helper,
+                  (flags & EWX_REBOOT) ? L"reboot" : L"poweroff" );
+        for (p = power + 8; *p && *p != ' '; p++) if (*p == '/') *p = '\\';
+        memset( &si, 0, sizeof si );
+        si.cb = sizeof si;
+        if (CreateProcessW( NULL, power, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi ))
+        {
+            CloseHandle( pi.hProcess );
+            CloseHandle( pi.hThread );
+        }
+        else WARN( "cannot run %s: %lu\n", debugstr_w(power), GetLastError() );
+    }
     return TRUE;
 }
 
