+/* Stained Glass OS: the image's properties go into the file the way the decoder read them: EXIF in a
+ * JPEG's APP1 IFD, the EXIF and GPS tags in their own IFDs. */
+static HRESULT item_to_propvariant(const PropertyItem *item, PROPVARIANT *value)
+{
+    UINT size, count;
+    void *data;
+
+    PropVariantInit(value);
+    switch (item->type)
+    {
+    case PropertyTagTypeByte:      value->vt = VT_UI1; size = 1; break;
+    case PropertyTagTypeSByte:     value->vt = VT_I1; size = 1; break;
+    case PropertyTagTypeShort:     value->vt = VT_UI2; size = 2; break;
+    case PropertyTagTypeSShort:    value->vt = VT_I2; size = 2; break;
+    case PropertyTagTypeLong:      value->vt = VT_UI4; size = 4; break;
+    case PropertyTagTypeSLONG:     value->vt = VT_I4; size = 4; break;
+    case PropertyTagTypeFloat:     value->vt = VT_R4; size = 4; break;
+    case PropertyTagTypeRational:  value->vt = VT_UI8; size = 8; break;
+    case PropertyTagTypeSRational: value->vt = VT_I8; size = 8; break;
+    case PropertyTagTypeDouble:    value->vt = VT_R8; size = 8; break;
+    case PropertyTagTypeASCII:
+        value->vt = VT_LPSTR;
+        if (!(value->pszVal = CoTaskMemAlloc(item->length + 1))) return E_OUTOFMEMORY;
+        memcpy(value->pszVal, item->value, item->length);
+        value->pszVal[item->length] = 0;
+        return S_OK;
+    case PropertyTagTypeUndefined:
+        value->vt = VT_BLOB;
+        value->blob.cbSize = item->length;
+        if (!(value->blob.pBlobData = CoTaskMemAlloc(max(item->length, 1)))) return E_OUTOFMEMORY;
+        memcpy(value->blob.pBlobData, item->value, item->length);
+        return S_OK;
+    default:
+        return E_INVALIDARG;
+    }
+    if (!(count = item->length / size)) return E_INVALIDARG;
+    if (count == 1)
+    {
+        memcpy(&value->uhVal, item->value, size);
+        return S_OK;
+    }
+    if (!(data = CoTaskMemAlloc(count * size))) return E_OUTOFMEMORY;
+    memcpy(data, item->value, count * size);
+    value->vt |= VT_VECTOR;
+    value->caub.cElems = count;
+    value->caub.pElems = data;
+    return S_OK;
+}
+
+static BOOL is_exif_ifd_tag(PROPID id)
+{
+    return (id >= 0x829a && id <= 0x829d) || (id >= 0x8822 && id <= 0x8832 && id != 0x8825) ||
+           (id >= 0x9000 && id <= 0x9fff) || (id >= 0xa000 && id <= 0xa4ff);
+}
+
+static void write_properties(GpBitmap *bitmap, IWICBitmapFrameEncode *frame, const GUID *container)
+{
+    IWICMetadataQueryWriter *writer;
+    const WCHAR *root;
+    WCHAR path[64];
+    PROPVARIANT value;
+    UINT i;
+
+    /* (the TIFF encoder writes no metadata blocks yet) */
+    if (IsEqualGUID(container, &GUID_ContainerFormatJpeg)) root = L"/app1/ifd";
+    else return;
+    if (make_property_list(bitmap) != Ok || !bitmap->prop_count) return;
+    if (FAILED(IWICBitmapFrameEncode_GetMetadataQueryWriter(frame, &writer))) return;
+    for (i = 0; i < bitmap->prop_count; i++)
+    {
+        const PropertyItem *item = &bitmap->prop_item[i];
+
+        /* the thumbnail's tags, and the IFD pointers, are the encoder's */
+        if ((item->id >= 0x5000 && item->id <= 0x5fff) || item->id == 0x8769 || item->id == 0x8825 ||
+            item->id == 0xa005 || item->id == 0x0201 || item->id == 0x0202 || item->id == 0x0111 ||
+            item->id == 0x0117 || item->id == 0x0100 || item->id == 0x0101 || item->id == 0x0102 ||
+            item->id == 0x0103 || item->id == 0x0106 || item->id == 0x0115 || item->id == 0x0116)
+            continue;
+        if (item->id <= 0x001f) swprintf(path, ARRAY_SIZE(path), L"%s/gps/{ushort=%u}", root, item->id);
+        else if (is_exif_ifd_tag(item->id)) swprintf(path, ARRAY_SIZE(path), L"%s/exif/{ushort=%u}", root, item->id);
+        else swprintf(path, ARRAY_SIZE(path), L"%s/{ushort=%u}", root, item->id);
+        if (FAILED(item_to_propvariant(item, &value))) continue;
+        if (FAILED(IWICMetadataQueryWriter_SetMetadataByName(writer, path, &value)))
+            WARN("property %#lx not written\n", item->id);
+        PropVariantClear(&value);
+    }
+    IWICMetadataQueryWriter_Release(writer);
+}
+
 static GpStatus encode_frame_wic(IWICBitmapEncoder *encoder, GpImage *image)
 {
     GpStatus stat;
@@ -4786,6 +5009,11 @@ static GpStatus encode_frame_wic(IWICBitmapEncoder *encoder, GpImage *image)
