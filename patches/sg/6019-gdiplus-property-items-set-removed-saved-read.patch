From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: property items set, removed, saved and read as one list (6019)

GdipSetPropertyItem did nothing and GdipRemovePropertyItem was not
implemented: both change the image's list now. A JPEG is saved with the
image's properties (EXIF in APP1, the EXIF and GPS IFDs' tags in theirs),
and a JPEG's or TIFF's properties read back as GDI+ lists them: the tags of
all its IFDs, not the one APP1 item they were (G-GDIP).
---
diff --git a/dlls/gdiplus/image.c b/dlls/gdiplus/image.c
index d39226b..5db026a 100644
--- a/dlls/gdiplus/image.c
+++ b/dlls/gdiplus/image.c
@@ -3769,6 +3769,72 @@ static GpStatus initialize_decoder_wic(IStream *stream, REFGUID container, IWICB
     return Ok;
 }
 
+/* Stained Glass OS: the properties of a JPEG or TIFF file are the tags of its IFDs: a JPEG's APP1
+ * block holds the IFD, which holds the EXIF and GPS IFDs; GDI+ lists all their tags as one list. */
+static void add_reader_tags(GpBitmap *bitmap, IWICMetadataReader *reader, int depth)
+{
+    IWICEnumMetadataItem *enumerator;
+    PROPVARIANT id, value;
+    ULONG got;
+
+    if (depth > 3 || FAILED(IWICMetadataReader_GetEnumerator(reader, &enumerator))) return;
+    PropVariantInit(&id);
+    PropVariantInit(&value);
+    while (IWICEnumMetadataItem_Next(enumerator, 1, NULL, &id, &value, &got) == S_OK && got)
+    {
+        if (value.vt == VT_UNKNOWN)
+        {
+            IWICMetadataReader *nested;
+            if (value.punkVal && SUCCEEDED(IUnknown_QueryInterface(value.punkVal, &IID_IWICMetadataReader, (void **)&nested)))
+            {
+                add_reader_tags(bitmap, nested, depth + 1);
+                IWICMetadataReader_Release(nested);
+            }
+        }
+        else if (id.vt == VT_UI2)
+        {
+            PropertyItem *item = create_prop(id.uiVal, &value);
+            if (item)
+            {
+                add_property(bitmap, item);
+                free(item);
+            }
+        }
+        PropVariantClear(&id);
+        PropVariantClear(&value);
+    }
+    IWICEnumMetadataItem_Release(enumerator);
+}
+
+static void flatten_metadata(GpBitmap *bitmap)
+{
+    IWICMetadataReader *reader = bitmap->metadata_reader;
+    IWICEnumMetadataItem *enumerator;
+    PROPVARIANT id, value;
+    BOOL nested = FALSE;
+    ULONG got;
+
+    /* only when a tag is an IFD of its own: a flat list stays as the reader gives it */
+    if (FAILED(IWICMetadataReader_GetEnumerator(reader, &enumerator))) return;
+    PropVariantInit(&id);
+    PropVariantInit(&value);
+    while (!nested && IWICEnumMetadataItem_Next(enumerator, 1, NULL, &id, &value, &got) == S_OK && got)
+    {
+        nested = value.vt == VT_UNKNOWN;
+        PropVariantClear(&id);
+        PropVariantClear(&value);
+    }
+    IWICEnumMetadataItem_Release(enumerator);
+    if (!nested) return;
+    add_reader_tags(bitmap, reader, 0);
+    if (!bitmap->prop_item)
+    {
+        /* no tags: an empty list, not the reader's IFD items */
+        bitmap->prop_item = calloc(1, sizeof(PropertyItem));
+        bitmap->prop_count = 0;
+    }
+}
+
 typedef void (*metadata_reader_func)(GpBitmap *bitmap, IWICBitmapDecoder *decoder, UINT frame);
 
 static GpStatus decode_frame_wic(IWICBitmapDecoder *decoder, BOOL force_conversion,
@@ -3885,6 +3951,9 @@ static GpStatus decode_frame_wic(IWICBitmapDecoder *decoder, BOOL force_conversi
                 if (IWICMetadataBlockReader_GetCount(block_reader, &block_count) == S_OK && block_count)
                     IWICMetadataBlockReader_GetReaderByIndex(block_reader, 0, &bitmap->metadata_reader);
                 IWICMetadataBlockReader_Release(block_reader);
+#ifndef SG_MUTANT_GDIP_NESTED_PROPS_LOST
+                if (bitmap->metadata_reader) flatten_metadata(bitmap);
+#endif
             }
 
             palette = get_palette(frame, palette_type);
@@ -4588,33 +4657,96 @@ GpStatus WINGDIPAPI GdipLoadImageFromStreamICM(IStream* stream, GpImage **image)
     return GdipLoadImageFromStream(stream, image);
 }
 
+/* Stained Glass OS: the properties as a list of their own, which can change (they are read
+ * from the decoder's metadata until then) */
+static GpStatus make_property_list(GpBitmap *bitmap)
+{
+    PropertyItem *list;
+    UINT size, count;
+    GpStatus status;
+
+    if (bitmap->prop_item) return Ok;
+    if ((status = GdipGetPropertySize(&bitmap->image, &size, &count)) != Ok) return status;
+    if (!(list = calloc(1, max(size, sizeof(PropertyItem))))) return OutOfMemory;
+    if (count && (status = GdipGetAllPropertyItems(&bitmap->image, size, count, list)) != Ok)
+    {
+        free(list);
+        return status;
+    }
+    bitmap->prop_item = list;
+    bitmap->prop_count = count;
+    return Ok;
+}
+
+/* the list without the property at index */
+static GpStatus remove_property(GpBitmap *bitmap, UINT index)
+{
+    PropertyItem *list;
+    UINT size = 0, i, j;
+    char *value;
+
+    for (i = 0; i < bitmap->prop_count; i++)
+        if (i != index) size += sizeof(PropertyItem) + bitmap->prop_item[i].length;
+    if (!(list = calloc(1, max(size, sizeof(PropertyItem))))) return OutOfMemory;
+    value = (char *)(list + bitmap->prop_count - 1);
+    for (i = j = 0; i < bitmap->prop_count; i++)
+    {
+        if (i == index) continue;
+        list[j] = bitmap->prop_item[i];
+        list[j].value = value;
+        memcpy(value, bitmap->prop_item[i].value, list[j].length);
+        value += list[j].length;
+        j++;
+    }
+    free(bitmap->prop_item);
+    bitmap->prop_item = list;
+    bitmap->prop_count--;
+    return Ok;
+}
+
 GpStatus WINGDIPAPI GdipRemovePropertyItem(GpImage *image, PROPID propId)
 {
-    static int calls;
+    GpBitmap *bitmap = (GpBitmap *)image;
+    GpStatus status;
+    UINT i;
 
     TRACE("(%p,%lu)\n", image, propId);
 
     if(!image)
         return InvalidParameter;
-
-    if(!(calls++))
-        FIXME("not implemented\n");
-
-    return NotImplemented;
+    if (image->type != ImageTypeBitmap) return NotImplemented;
+    if ((status = make_property_list(bitmap)) != Ok) return status;
+    for (i = 0; i < bitmap->prop_count; i++)
+        if (bitmap->prop_item[i].id == propId) return remove_property(bitmap, i);
+    return PropertyNotFound;
 }
 
 GpStatus WINGDIPAPI GdipSetPropertyItem(GpImage *image, GDIPCONST PropertyItem* item)
 {
-    static int calls;
+    GpBitmap *bitmap = (GpBitmap *)image;
+    GpStatus status;
+    UINT i, count;
 
     if (!image || !item) return InvalidParameter;
 
     TRACE("(%p,%p:%#lx,%u,%lu,%p)\n", image, item, item->id, item->type, item->length, item->value);
 
-    if(!(calls++))
-        FIXME("not implemented\n");
-
+    if (item->length && !item->value) return InvalidParameter;
+    if (image->type != ImageTypeBitmap) return NotImplemented;
+    if ((status = make_property_list(bitmap)) != Ok) return status;
+    /* a new value takes the old one's place, at the end */
+    for (i = 0; i < bitmap->prop_count; i++)
+    {
+        if (bitmap->prop_item[i].id != item->id) continue;
+        if ((status = remove_property(bitmap, i)) != Ok) return status;
+        break;
+    }
+    count = bitmap->prop_count;
+#ifdef SG_MUTANT_GDIP_SETPROP_IGNORED
     return Ok;
+#endif
+    add_property(bitmap, (PropertyItem *)item);
+    return bitmap->prop_count == count + 1 ? Ok : OutOfMemory;
 }
 
