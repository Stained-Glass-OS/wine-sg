From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: text services UI activation, cached size, base line and caret x (3695)

riched20: text services UI activation, cached size, base line and caret x

ITextServices::OnTxUIActivate/OnTxUIDeactivate return S_OK, TxGetCachedSize,
TxGetBaseLinePos and TxGetCurTargetX answer from the laid-out text. The
control's own ITextHost answers TxSetForegroundWindow, TxGetWindowStyles,
TxGetEastAsianFlags and TxGetHorzExtent from its window.
---
diff --git a/dlls/riched20/txthost.c b/dlls/riched20/txthost.c
index 8ae8043..9ead83e 100644
--- a/dlls/riched20/txthost.c
+++ b/dlls/riched20/txthost.c
@@ -562,7 +562,10 @@ HRESULT __thiscall ITextHostImpl_TxGetWindow( ITextHost2 *iface, HWND *hwnd )
 DEFINE_THISCALL_WRAPPER(ITextHostImpl_TxSetForegroundWindow,4)
 HRESULT __thiscall ITextHostImpl_TxSetForegroundWindow( ITextHost2 *iface )
 {
-    return E_NOTIMPL;
+    struct host *host = impl_from_ITextHost( iface );
+
+    /* "Sets the rich edit control's host window as the foreground window" */
+    return SetForegroundWindow( host->window ) ? S_OK : E_FAIL;
 }
 
 DEFINE_THISCALL_WRAPPER(ITextHostImpl_TxGetPalette,4)
@@ -574,7 +577,12 @@ HPALETTE __thiscall ITextHostImpl_TxGetPalette( ITextHost2 *iface )
 DEFINE_THISCALL_WRAPPER(ITextHostImpl_TxGetEastAsianFlags,8)
 HRESULT __thiscall ITextHostImpl_TxGetEastAsianFlags( ITextHost2 *iface, LONG *flags )
 {
-    return E_NOTIMPL;
+    struct host *host = impl_from_ITextHost( iface );
+
+    if (!flags) return E_INVALIDARG;
+    /* ES_NOIME suppresses IME input, ES_SELFIME says the client handles it */
+    *flags = GetWindowLongW( host->window, GWL_STYLE ) & (ES_NOIME | ES_SELFIME);
+    return S_OK;
 }
 
 DEFINE_THISCALL_WRAPPER(ITextHostImpl_TxSetCursor2,12)
@@ -598,7 +606,12 @@ HRESULT __thiscall ITextHostImpl_TxGetEditStyle( ITextHost2 *iface, DWORD item,
 DEFINE_THISCALL_WRAPPER(ITextHostImpl_TxGetWindowStyles,12)
 HRESULT __thiscall ITextHostImpl_TxGetWindowStyles( ITextHost2 *iface, DWORD *style, DWORD *ex_style )
 {
-    return E_NOTIMPL;
+    struct host *host = impl_from_ITextHost( iface );
+
+    if (!style || !ex_style) return E_INVALIDARG;
+    *style = GetWindowLongW( host->window, GWL_STYLE );
+    *ex_style = GetWindowLongW( host->window, GWL_EXSTYLE );
+    return S_OK;
 }
 
 DEFINE_THISCALL_WRAPPER(ITextHostImpl_TxShowDropCaret,16)
@@ -616,7 +629,14 @@ HRESULT __thiscall ITextHostImpl_TxDestroyCaret( ITextHost2 *iface )
 DEFINE_THISCALL_WRAPPER(ITextHostImpl_TxGetHorzExtent,8)
 HRESULT __thiscall ITextHostImpl_TxGetHorzExtent( ITextHost2 *iface, LONG *horz_extent )
 {
-    return E_NOTIMPL;
+    struct host *host = impl_from_ITextHost( iface );
+    int min, max;
+
+    if (!horz_extent) return E_INVALIDARG;
+    /* the horizontal scroll extent of the host window (the control itself takes the width of the widest line) */
+    GetScrollRange( host->window, SB_HORZ, &min, &max );
+    *horz_extent = max;
+    return S_OK;
 }
 
 
diff --git a/dlls/riched20/txtsrv.c b/dlls/riched20/txtsrv.c
index 2eb6f92..54fab23 100644
--- a/dlls/riched20/txtsrv.c
+++ b/dlls/riched20/txtsrv.c
@@ -301,8 +301,12 @@ HRESULT __thiscall fnTextSrv_OnTxUIActivate(ITextServices *iface)
 {
     struct text_services *services = impl_from_ITextServices( iface );
 
-    FIXME( "%p: STUB\n", services );
+    TRACE( "%p\n", services );
+    /* "The method always returns S_OK" */
+#ifdef SG_MUTANT_RT_UI
     return E_NOTIMPL;
+#endif
+    return S_OK;
 }
 
 DEFINE_THISCALL_WRAPPER(fnTextSrv_OnTxUIDeactivate,4)
@@ -310,8 +314,9 @@ HRESULT __thiscall fnTextSrv_OnTxUIDeactivate(ITextServices *iface)
 {
     struct text_services *services = impl_from_ITextServices( iface );
 
-    FIXME( "%p: STUB\n", services );
-    return E_NOTIMPL;
+    TRACE( "%p\n", services );
+    /* "The method always returns S_OK" */
+    return S_OK;
 }
 
 DEFINE_THISCALL_WRAPPER(fnTextSrv_TxGetText,8)
@@ -359,18 +364,55 @@ DEFINE_THISCALL_WRAPPER(fnTextSrv_TxGetCurTargetX,8)
 HRESULT __thiscall fnTextSrv_TxGetCurTargetX(ITextServices *iface, LONG *x)
 {
     struct text_services *services = impl_from_ITextServices( iface );
+    ME_TextEditor *editor = services->editor;
+    int cx, cy, height;
 
-    FIXME( "%p: STUB\n", services );
-    return E_NOTIMPL;
+    TRACE( "%p, %p\n", services, x );
+
+    if (!x) return E_INVALIDARG;
+    if (!editor->pCursors[0].para) return E_FAIL;
+    ME_WrapMarkedParagraphs( editor );
+    /* the x the caret keeps while it moves up and down, else where it is now (client coordinates) */
+    if (editor->nUDArrowX != -1)
+        *x = editor->rcFormat.left + editor->nUDArrowX - editor->horz_si.nPos;
+    else
+    {
+        cursor_coords( editor, &editor->pCursors[0], &cx, &cy, &height );
+        *x = cx;
+    }
+#ifdef SG_MUTANT_RT_TARGETX
+    *x = 0;
+#endif
+    return S_OK;
 }
 
 DEFINE_THISCALL_WRAPPER(fnTextSrv_TxGetBaseLinePos,8)
 HRESULT __thiscall fnTextSrv_TxGetBaseLinePos(ITextServices *iface, LONG *x)
 {
     struct text_services *services = impl_from_ITextServices( iface );
+    ME_TextEditor *editor = services->editor;
+    ME_Paragraph *para;
+    ME_Row *row;
 
-    FIXME( "%p: STUB\n", services );
-    return E_NOTIMPL;
+    TRACE( "%p, %p\n", services, x );
+
+    if (!x) return E_INVALIDARG;
+    ME_WrapMarkedParagraphs( editor );
+    /* the base line of the first line that shows, relative to the client rectangle */
+    for (para = editor_first_para( editor ); para; para = para_next( para ))
+    {
+        if (para->pt.y + para->nHeight <= editor->vert_si.nPos) continue;
+        for (row = para_first_row( para ); row; row = row_next( row ))
+            if (para->pt.y + row->pt.y + row->nHeight > editor->vert_si.nPos)
+            {
+                *x = editor->rcFormat.top + para->pt.y + row->pt.y + row->nBaseline - editor->vert_si.nPos;
+#ifdef SG_MUTANT_RT_BASE
+                *x = 0;
+#endif
+                return S_OK;
+            }
+    }
+    return E_FAIL;
 }
 
 DEFINE_THISCALL_WRAPPER(fnTextSrv_TxGetNaturalSize,36)
@@ -635,9 +677,18 @@ DEFINE_THISCALL_WRAPPER(fnTextSrv_TxGetCachedSize,12)
 HRESULT __thiscall fnTextSrv_TxGetCachedSize(ITextServices *iface, DWORD *pdwWidth, DWORD *pdwHeight)
 {
     struct text_services *services = impl_from_ITextServices( iface );
+    ME_TextEditor *editor = services->editor;
 
-    FIXME( "%p: STUB\n", services );
-    return E_NOTIMPL;
+    TRACE( "%p, %p, %p\n", services, pdwWidth, pdwHeight );
+
+    if (!pdwWidth || !pdwHeight) return E_INVALIDARG;
+    /* the size of the rectangle the text was last laid out and drawn in */
+    *pdwWidth = editor->rcFormat.right - editor->rcFormat.left;
+    *pdwHeight = editor->rcFormat.bottom - editor->rcFormat.top;
+#ifdef SG_MUTANT_RT_CACHED
+    *pdwWidth = 100;
+#endif
+    return S_OK;
 }
 
 #ifdef __ASM_USE_THISCALL_WRAPPER
