From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: an unknown file type takes no verbs of HKEY_CLASSES_ROOT (6031)

The context menu of a file whose extension has no class read the type
name from a buffer HCR_MapTypeToValueA had not filled. When it held an
empty name, the verbs were read from HKEY_CLASSES_ROOT itself, whose
"shell" key is the shell: protocol's: the menu had a "shell" item now
and then. Such a file now has no type, and no verbs but the common ones.
---
diff --git a/dlls/shell32/shlview_cmenu.c b/dlls/shell32/shlview_cmenu.c
index ef2edc6..7cbc4b4 100644
--- a/dlls/shell32/shlview_cmenu.c
+++ b/dlls/shell32/shlview_cmenu.c
@@ -1233,11 +1233,11 @@ static void get_filetype(LPCITEMIDLIST pidl, WCHAR filetype[MAX_PATH])
     {
         char ext[64], filetypeA[64];
 
-        if (_ILGetExtension(pidl, ext, 64))
-        {
-            HCR_MapTypeToValueA(ext, filetypeA, 64, TRUE);
+        /* Stained Glass OS: an extension with no class has no type; the buffer was left as it was,
+         * and a garbage or empty name opened HKEY_CLASSES_ROOT itself, whose "shell" key (the shell:
+         * protocol) gave the menu a "shell" item */
+        if (_ILGetExtension(pidl, ext, 64) && HCR_MapTypeToValueA(ext, filetypeA, 64, TRUE))
             MultiByteToWideChar(CP_ACP, 0, filetypeA, -1, filetype, MAX_PATH);
-        }
         else
         {
             filetype[0] = 0;
@@ -2038,6 +2038,9 @@ static void build_verb_list(ContextMenu *menu)
         }
     }
 
+#ifndef SG_MUTANT_FILETYPE_EMPTY
+    if (!menu->filetype[0]) return;
+#endif
     if ((ret = RegOpenKeyExW(HKEY_CLASSES_ROOT, menu->filetype, 0, KEY_READ, &type_key)))
         return;
 
