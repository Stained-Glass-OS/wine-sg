From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] gdi32: GetCharacterPlacement character classes

GetCharacterPlacementW fills GCP_RESULTS.lpClass (Latin, Latin digit,
Hebrew, Arabic, local digit) and, with GCP_CLASSIN, keeps preset classes.
Also fixes the GCPCLASS_* values in wingdi.h to the Windows ones (ARABIC is
2, NEUTRAL 3, ...). CORE: integrator must review (patches/notes/5202.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/gdi32/text.c b/dlls/gdi32/text.c
--- a/dlls/gdi32/text.c
+++ b/dlls/gdi32/text.c
@@ -1139,6 +1139,33 @@
     return ret;
 }
 
+/* GCP_RESULTS.lpClass: the classification of each character (Hebrew, Arabic, Latin, the
+ * Latin and local digits).  Classes preset by the caller are kept when GCP_CLASSIN is set. */
+static BYTE character_class( WCHAR ch )
+{
+    if ((ch >= 0x0590 && ch <= 0x05ff) || (ch >= 0xfb1d && ch <= 0xfb4f)) return GCPCLASS_HEBREW;
+    if ((ch >= 0x0660 && ch <= 0x0669) || (ch >= 0x06f0 && ch <= 0x06f9)) return GCPCLASS_LOCALNUMBER;
+    if ((ch >= 0x0600 && ch <= 0x06ff) || (ch >= 0x0750 && ch <= 0x077f) ||
+        (ch >= 0xfb50 && ch <= 0xfdff) || (ch >= 0xfe70 && ch <= 0xfeff)) return GCPCLASS_ARABIC;
+    if (ch >= '0' && ch <= '9') return GCPCLASS_LATINNUMBER;
+    return GCPCLASS_LATIN;
+}
+
+static void classify_characters( const WCHAR *str, UINT count, DWORD flags, char *classes )
+{
+    UINT i;
+
+    for (i = 0; i < count; i++)
+    {
+#ifndef SG_MUTANT_GCP_CLASS_OVERWRITE
+        if ((flags & GCP_CLASSIN) && classes[i]) continue;
+#endif
+#ifndef SG_MUTANT_GCP_CLASS_NONE
+        classes[i] = character_class( str[i] );
+#endif
+    }
+}
+
 /*************************************************************************
  *           GetCharacterPlacementW    (GDI32.@)
  *
@@ -1154,7 +1181,6 @@
  *   All flags except GCP_REORDER are not yet implemented.
  *   Reordering is not 100% compliant to the Windows BiDi method.
  *   Caret positioning is not yet implemented for BiDi.
- *   Classes are not yet implemented.
  *
  */
 DWORD WINAPI GetCharacterPlacementW( HDC hdc, const WCHAR *str, INT count, INT max_extent,
@@ -1179,10 +1205,8 @@
            result->lpDx, result->lpCaretPos, result->lpClass,
            result->lpGlyphs, result->nGlyphs, result->nMaxFit );
 
-    if (flags & ~(GCP_REORDER | GCP_USEKERNING))
+    if (flags & ~(GCP_REORDER | GCP_USEKERNING | GCP_CLASSIN))
         FIXME( "flags 0x%08lx ignored\n", flags );
-    if (result->lpClass)
-        FIXME( "classes not implemented\n" );
     if (result->lpCaretPos && (flags & GCP_REORDER))
         FIXME( "Caret positions for complex scripts not implemented\n" );
 
@@ -1192,6 +1216,8 @@
     /* return number of initialized fields */
     result->nGlyphs = set_cnt;
 
+    if (result->lpClass) classify_characters( str, set_cnt, flags, result->lpClass );
+
     if (!(flags & GCP_REORDER))
     {
         /* Treat the case where no special handling was requested in a fastpath way */
diff --git a/include/wingdi.h b/include/wingdi.h
--- a/include/wingdi.h
+++ b/include/wingdi.h
@@ -1419,13 +1419,13 @@
 
 #define GCPCLASS_LATIN                     1
 #define GCPCLASS_HEBREW                    2
-#define GCPCLASS_ARABIC                    3
-#define GCPCLASS_NEUTRAL                   4
-#define GCPCLASS_LOCALNUMBER               5
-#define GCPCLASS_LATINNUMBER               6
-#define GCPCLASS_LATINNUMERICTERMINATOR    7
-#define GCPCLASS_LATINNUMERICSEPARATOR     8
-#define GCPCLASS_NUMERICSEPARATOR          9
+#define GCPCLASS_ARABIC                    2
+#define GCPCLASS_NEUTRAL                   3
+#define GCPCLASS_LOCALNUMBER               4
+#define GCPCLASS_LATINNUMBER               5
+#define GCPCLASS_LATINNUMERICTERMINATOR    6
+#define GCPCLASS_LATINNUMERICSEPARATOR     7
+#define GCPCLASS_NUMERICSEPARATOR          8
 #define GCPCLASS_PREBOUNDLTR               0x80
 #define GCPCLASS_PREBOUNDRTL               0x40
 #define GCPCLASS_POSTBOUNDLTR              0x20
