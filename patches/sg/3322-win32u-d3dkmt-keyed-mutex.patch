+/* ---- keyed mutexes ----
+ *
+ * The state of a keyed mutex (the key, who owns it, whether its owner is gone) is in the header of its block,
+ * so every process that has the block mapped sees the same mutex. A keyed mutex is its own block, or part of the
+ * block of a resource when it was shared with the resource (D3DKMTShareObjects). */
+
+#define STATUS_ABANDONED_WAIT_0_VALUE ((NTSTATUS)0x00000080)
+
+static UINT64 kmt_owner_id( const struct kmt_object *object )
+{
+    return ((UINT64)HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess ) << 32) | object->handle;
+}
+
+/* d3dkmt_lock must be held. The objects of a block that get their state from it. */
+static struct kmt_object *kmt_object_new( enum kmt_type type, D3DKMT_HANDLE device, struct kmt_block *block )
+{
+    struct kmt_object *object;
+
+    if (!(object = calloc( 1, sizeof(*object) ))) return NULL;
+    object->handle = kmt_new_handle();
+    object->device = device;
+    object->type = type;
+    object->block = block;
+    block->ref++;
+    list_add_tail( &kmt_objects, &object->entry );
+    return object;
+}
+
+/* The mutex is destroyed with its owner holding it: it is lost. d3dkmt_lock must be held. */
+static void kmt_mutex_object_gone( struct kmt_object *object )
+{
+    struct kmt_share_header *hdr = object->block->hdr;
+    LONG64 me = kmt_owner_id( object );
+
+    if (__atomic_load_n( &hdr->mutex_owner, __ATOMIC_SEQ_CST ) == me)
+    {
+#ifndef SG_MUTANT_KMT_NO_ABANDON
+        __atomic_store_n( &hdr->mutex_abandoned, 1, __ATOMIC_SEQ_CST );
+#endif
+        __atomic_store_n( &hdr->mutex_owner, 0, __ATOMIC_SEQ_CST );
+    }
+}
+
+static NTSTATUS kmt_create_keyed_mutex( UINT64 initial, UINT *shared, D3DKMT_HANDLE *handle, const void *runtime,
+                                        UINT runtime_size, BOOL global )
+{
+    struct kmt_object *object;
+    struct kmt_block *block;
+    UINT id = 0;
+    NTSTATUS status;
+
+    if (!handle || runtime_size > KMT_MUTEX_RUNTIME_MAX || (runtime_size && !runtime)) return STATUS_INVALID_PARAMETER;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if (!(status = kmt_block_create( KMT_SHARE_MUTEX, NULL, 0, NULL, 0, 0, NULL, NULL, global ? &id : NULL, &block )))
+    {
+        block->hdr->mutex_key = initial;
+        block->hdr->mutex_runtime_size = runtime_size;
+        if (runtime_size) memcpy( block->hdr->mutex_runtime, runtime, runtime_size );
+        if (!(object = kmt_object_new( KMT_KEYEDMUTEX, 0, block ))) status = STATUS_NO_MEMORY;
+        else
+        {
+            object->nt_sharing = !global;
+            *handle = object->handle;
+            if (shared) *shared = id;
+        }
+        kmt_block_unref( block );
+    }
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
+}
