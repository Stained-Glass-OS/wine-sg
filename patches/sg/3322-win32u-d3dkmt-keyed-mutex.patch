+
+/* A keyed mutex of a block that has one. The block's reference stays with the caller, d3dkmt_lock is held. */
+static NTSTATUS kmt_mutex_open_locked( struct kmt_block *block, void *runtime, UINT *runtime_size,
+                                       D3DKMT_HANDLE *handle )
+{
+    struct kmt_share_header *hdr = block->hdr;
+    struct kmt_object *object;
+
+    if (!(hdr->flags & KMT_SHARE_MUTEX) || !handle) return STATUS_INVALID_PARAMETER;
+    if (runtime && runtime_size && *runtime_size < hdr->mutex_runtime_size) return STATUS_BUFFER_TOO_SMALL;
+    if (!(object = kmt_object_new( KMT_KEYEDMUTEX, 0, block ))) return STATUS_NO_MEMORY;
+    object->nt_sharing = TRUE;
+    *handle = object->handle;
+    if (runtime) memcpy( runtime, hdr->mutex_runtime, hdr->mutex_runtime_size );
+    if (runtime_size) *runtime_size = hdr->mutex_runtime_size;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS kmt_mutex_open( struct kmt_block *block, void *runtime, UINT *runtime_size, D3DKMT_HANDLE *handle )
+{
+    NTSTATUS status;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    status = kmt_mutex_open_locked( block, runtime, runtime_size, handle );
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
+}
+
+static NTSTATUS kmt_open_keyed_mutex_global( UINT id, void *runtime, UINT *runtime_size, D3DKMT_HANDLE *handle )
+{
+    struct kmt_block *block;
+    NTSTATUS status;
+
+    if ((status = kmt_block_open_global( id, &block ))) return status;
+    status = kmt_mutex_open( block, runtime, runtime_size, handle );
+    pthread_mutex_lock( &d3dkmt_lock );
+    kmt_block_unref( block );
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
 }
 
