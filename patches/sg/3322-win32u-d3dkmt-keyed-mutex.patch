+static ULONGLONG kmt_now_ns(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (ULONGLONG)ts.tv_sec * 1000000000 + ts.tv_nsec;
+}
+
+/* The end of a wait of an NT timeout (NULL: never, relative when negative, an absolute system time otherwise),
+ * in the clock of kmt_now_ns; 0 for no waiting at all. */
+static ULONGLONG kmt_deadline( const LARGE_INTEGER *timeout )
+{
+    LARGE_INTEGER now;
+    LONGLONG wait;
+
+    if (!timeout) return ~(ULONGLONG)0;
+    if (timeout->QuadPart < 0) wait = -timeout->QuadPart;
+    else if (timeout->QuadPart == 0) return 0;
+    else
+    {
+        NtQuerySystemTime( &now );
+        wait = timeout->QuadPart > now.QuadPart ? timeout->QuadPart - now.QuadPart : 0;
+    }
+    return kmt_now_ns() + wait * 100;
+}
+
+/* The wait of a poll: a short while at first, so that a mutex that goes back and forth is not slowed down. */
+static void kmt_poll_sleep( UINT polls )
+{
+    LARGE_INTEGER delay;
+
+    if (polls < 20) { NtYieldExecution(); return; }
+    delay.QuadPart = polls < 1000 ? -1000 : -20000;     /* 100 microseconds, then 2 milliseconds */
+    NtDelayExecution( FALSE, &delay );
+}
+
+static BOOL kmt_process_gone( UINT pid )
+{
+    OBJECT_ATTRIBUTES attr;
+    CLIENT_ID cid;
+    HANDLE process;
+    NTSTATUS status;
+
+    InitializeObjectAttributes( &attr, NULL, 0, 0, NULL );
+    cid.UniqueProcess = ULongToHandle( pid );
+    cid.UniqueThread = 0;
+    if (!(status = NtOpenProcess( &process, PROCESS_QUERY_LIMITED_INFORMATION, &attr, &cid )))
+    {
+        NtClose( process );
+        return FALSE;
+    }
+    return status == STATUS_INVALID_CID;
+}
+
+static NTSTATUS kmt_acquire_keyed_mutex( D3DKMT_HANDLE handle, UINT64 key, const LARGE_INTEGER *timeout,
+                                         void *runtime, UINT runtime_size, UINT64 *fence )
+{
+    struct kmt_share_header *hdr;
+    struct kmt_object *object;
+    struct kmt_block *block;
+    ULONGLONG deadline;
+    LONG64 me, owner, expected;
+    NTSTATUS status;
+    UINT polls = 0;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if (!(object = kmt_find( handle, KMT_KEYEDMUTEX )))
+    {
+        pthread_mutex_unlock( &d3dkmt_lock );
+        return STATUS_INVALID_PARAMETER;
+    }
+    block = object->block;
+    block->ref++;
+    me = kmt_owner_id( object );
+    pthread_mutex_unlock( &d3dkmt_lock );
+
+    hdr = block->hdr;
+    if (runtime && runtime_size < hdr->mutex_runtime_size)
+    {
+        status = STATUS_BUFFER_TOO_SMALL;
+        goto done;
+    }
+    deadline = kmt_deadline( timeout );
+    for (;;)
+    {
+        if (__atomic_load_n( &hdr->mutex_abandoned, __ATOMIC_SEQ_CST ))
+        {
+            status = STATUS_ABANDONED_WAIT_0_VALUE;
+            break;
+        }
+        owner = __atomic_load_n( &hdr->mutex_owner, __ATOMIC_SEQ_CST );
+        if (owner == me)
+        {
+            /* waiting for oneself would never end */
+#ifndef SG_MUTANT_KMT_REACQUIRE_WAITS
+            status = STATUS_INVALID_PARAMETER;
+            break;
+#endif
+        }
+        else if (!owner)
+        {
+            expected = 0;
+            if (__atomic_compare_exchange_n( &hdr->mutex_owner, &expected, me, FALSE, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+            {
+#ifdef SG_MUTANT_KMT_MX_NOKEY
+                if (TRUE)
+#else
+                if (hdr->mutex_key == key)
+#endif
+                {
+                    status = STATUS_SUCCESS;
+                    break;
+                }
+                /* the key is another: the mutex goes back to whoever waits for that key */
+                __atomic_store_n( &hdr->mutex_owner, 0, __ATOMIC_SEQ_CST );
+            }
+        }
+        else if (!(polls % 64) && kmt_process_gone( owner >> 32 ))
+        {
+            /* the process that held it is gone: the mutex and what it guards cannot be relied on */
+            __atomic_store_n( &hdr->mutex_abandoned, 1, __ATOMIC_SEQ_CST );
+            __atomic_store_n( &hdr->mutex_owner, 0, __ATOMIC_SEQ_CST );
+            status = STATUS_ABANDONED_WAIT_0_VALUE;
+            break;
+        }
+        if (deadline != ~(ULONGLONG)0 && (!deadline || kmt_now_ns() >= deadline))
+        {
+            status = STATUS_TIMEOUT;
+            break;
+        }
+        kmt_poll_sleep( polls++ );
+    }
+    if (runtime && (status == STATUS_SUCCESS || status == STATUS_ABANDONED_WAIT_0_VALUE))
+        memcpy( runtime, hdr->mutex_runtime, hdr->mutex_runtime_size );
+    if (fence) *fence = 0;
+
+done:
+    pthread_mutex_lock( &d3dkmt_lock );
+    kmt_block_unref( block );
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
+}
+
+static NTSTATUS kmt_release_keyed_mutex( D3DKMT_HANDLE handle, UINT64 key, void *runtime, UINT runtime_size,
+                                         UINT64 *fence )
+{
+    struct kmt_share_header *hdr;
+    struct kmt_object *object;
+    NTSTATUS status = STATUS_SUCCESS;
+    LONG64 me;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if (!(object = kmt_find( handle, KMT_KEYEDMUTEX )))
+    {
+        pthread_mutex_unlock( &d3dkmt_lock );
+        return STATUS_INVALID_PARAMETER;
+    }
+    hdr = object->block->hdr;
+    me = kmt_owner_id( object );
+    if (runtime && runtime_size < hdr->mutex_runtime_size) status = STATUS_BUFFER_TOO_SMALL;
+    else if (__atomic_load_n( &hdr->mutex_abandoned, __ATOMIC_SEQ_CST )
+#ifndef SG_MUTANT_KMT_MX_NOOWNER
+             || __atomic_load_n( &hdr->mutex_owner, __ATOMIC_SEQ_CST ) != me
+#endif
+             )
+        status = STATUS_INVALID_PARAMETER;
+    else
+    {
+        if (runtime) memcpy( runtime, hdr->mutex_runtime, hdr->mutex_runtime_size );
+        /* the key first: whoever gets the mutex next must see it */
+        __atomic_store_n( &hdr->mutex_key, key, __ATOMIC_SEQ_CST );
+        __atomic_store_n( &hdr->mutex_owner, 0, __ATOMIC_SEQ_CST );
+        if (fence) *fence = 0;
+    }
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
+}
+
+/******************************************************************************
+ *           NtGdiDdDDIAcquireKeyedMutex    (win32u.@)
+ */
+NTSTATUS WINAPI NtGdiDdDDIAcquireKeyedMutex( D3DKMT_ACQUIREKEYEDMUTEX *params )
+{
+    TRACE( "params %p\n", params );
+    if (!params) return STATUS_INVALID_PARAMETER;
+    return kmt_acquire_keyed_mutex( params->hKeyedMutex, params->Key, params->pTimeout, NULL, 0, &params->FenceValue );
+}
+
+/******************************************************************************
+ *           NtGdiDdDDIAcquireKeyedMutex2    (win32u.@)
+ */
+NTSTATUS WINAPI NtGdiDdDDIAcquireKeyedMutex2( D3DKMT_ACQUIREKEYEDMUTEX2 *params )
+{
+    TRACE( "params %p\n", params );
+    if (!params) return STATUS_INVALID_PARAMETER;
+    return kmt_acquire_keyed_mutex( params->hKeyedMutex, params->Key, params->pTimeout, params->pPrivateRuntimeData,
+                                    params->PrivateRuntimeDataSize, &params->FenceValue );
+}
+
+/******************************************************************************
+ *           NtGdiDdDDIReleaseKeyedMutex    (win32u.@)
+ */
+NTSTATUS WINAPI NtGdiDdDDIReleaseKeyedMutex( D3DKMT_RELEASEKEYEDMUTEX *params )
+{
+    TRACE( "params %p\n", params );
+    if (!params) return STATUS_INVALID_PARAMETER;
+    return kmt_release_keyed_mutex( params->hKeyedMutex, params->Key, NULL, 0, &params->FenceValue );
+}
+
+/******************************************************************************
+ *           NtGdiDdDDIReleaseKeyedMutex2    (win32u.@)
+ */
+NTSTATUS WINAPI NtGdiDdDDIReleaseKeyedMutex2( D3DKMT_RELEASEKEYEDMUTEX2 *params )
+{
+    TRACE( "params %p\n", params );
+    if (!params) return STATUS_INVALID_PARAMETER;
+    return kmt_release_keyed_mutex( params->hKeyedMutex, params->Key, params->pPrivateRuntimeData,
