+static const PROPERTYKEY friendly_name_key = {{0xa45c254e, 0xdf1c, 0x4efd, {0x80, 0x20, 0x67, 0xd1, 0x46, 0xa8, 0x50, 0xe0}}, 14};
+
+/* the interface classes of the device classes (the same GUIDs appear in the AQS filters) */
+static const GUID audio_capture_class = {0x2eef81be, 0x33fa, 0x4800, {0x96, 0x70, 0x1c, 0xd4, 0x74, 0x97, 0x2c, 0x3f}};
+static const GUID audio_render_class = {0xe6327cad, 0xdcec, 0x4949, {0xae, 0x8a, 0x99, 0x1e, 0x97, 0x6a, 0x79, 0xd2}};
+static const GUID storage_class = {0x6ac27878, 0xa6fa, 0x4155, {0xba, 0x85, 0xf9, 0x8f, 0x49, 0x1d, 0x4f, 0x33}};
+static const GUID video_capture_class = {0xe5323777, 0xf976, 0x4f5b, {0x9b, 0x55, 0xb9, 0x46, 0x99, 0xc4, 0x6e, 0x44}};
+static const GUID scanner_class = {0x6bdd1fc6, 0x810f, 0x11d0, {0xbe, 0xc7, 0x08, 0x00, 0x2b, 0xe2, 0x09, 0x2f}};
+
+const GUID *device_class_guid( DeviceClass device_class )
+{
+    switch (device_class)
+    {
+    case DeviceClass_AudioCapture: return &audio_capture_class;
+    case DeviceClass_AudioRender: return &audio_render_class;
+    case DeviceClass_PortableStorageDevice: return &storage_class;
+    case DeviceClass_VideoCapture: return &video_capture_class;
+    case DeviceClass_ImageScanner: return &scanner_class;
+    default: return NULL;
+    }
+}
+
+/* the AQS filter that selects the interfaces of a class */
+HRESULT device_class_filter( DeviceClass device_class, HSTRING *filter )
+{
+    const GUID *guid = device_class_guid( device_class );
+    WCHAR buffer[160], str[39];
+    unsigned int i;
+
+    if (device_class < DeviceClass_All || device_class > DeviceClass_Location) return E_INVALIDARG;
+    if (!guid) return WindowsCreateString( L"", 0, filter );    /* all devices, or no interface of this class */
+    StringFromGUID2( guid, str, ARRAY_SIZE(str) );
+    for (i = 0; str[i]; i++) str[i] = towlower( str[i] );
+    swprintf( buffer, ARRAY_SIZE(buffer),
+              L"System.Devices.InterfaceClassGuid:=\"%s\" AND System.Devices.InterfaceEnabled:=System.StructuredQueryType.Boolean#True",
+              str );
+    return WindowsCreateString( buffer, wcslen( buffer ), filter );
+}
