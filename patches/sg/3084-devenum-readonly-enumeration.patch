diff --git a/dlls/windows.devices.enumeration/async.c b/dlls/windows.devices.enumeration/async.c
new file mode 100644
index 0000000..1831edd
--- /dev/null
+++ b/dlls/windows.devices.enumeration/async.c
@@ -0,0 +1,281 @@
+/* Asynchronous operations whose result is ready when they are handed out
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(enumeration);
+
+/*
+ * An IAsyncOperation<T *> for any interface or runtime class T has the same layout.
+ * The operation starts Completed (or Error); a Completed handler set on it is called
+ * at once, as WinRT does for an operation that has already finished.
+ */
+struct async
+{
+    IInspectable op_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    HRESULT hr;
+    const GUID *iid;
+    const WCHAR *class_name;
+    IUnknown *result;
+    IUnknown *handler;
+    BOOL closed;
+};
+
+static struct async *impl_from_op( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct async, op_iface );
+}
+
+static HRESULT WINAPI op_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct async *impl = impl_from_op( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, impl->iid ))
+    {
+        IInspectable_AddRef( (*out = &impl->op_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+    {
+        IAsyncInfo_AddRef( (*out = &impl->IAsyncInfo_iface) );
+        return S_OK;
+    }
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI op_AddRef( IInspectable *iface )
+{
+    struct async *impl = impl_from_op( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI op_Release( IInspectable *iface )
+{
+    struct async *impl = impl_from_op( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (impl->handler) IUnknown_Release( impl->handler );
+        if (impl->result) IUnknown_Release( impl->result );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI op_GetIids( IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    struct async *impl = impl_from_op( iface );
+    IID *list;
+
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+
+    if (!(list = CoTaskMemAlloc( 2 * sizeof(*list) ))) return E_OUTOFMEMORY;
+    list[0] = *impl->iid;
+    list[1] = IID_IAsyncInfo;
+    *iid_count = 2;
+    *iids = list;
+    return S_OK;
+}
+
+static HRESULT WINAPI op_GetRuntimeClassName( IInspectable *iface, HSTRING *class_name )
+{
+    struct async *impl = impl_from_op( iface );
+
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( impl->class_name, wcslen( impl->class_name ), class_name );
+}
+
+static HRESULT WINAPI op_GetTrustLevel( IInspectable *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static AsyncStatus async_status( struct async *impl )
+{
+    return SUCCEEDED(impl->hr) ? Completed : Error;
+}
+
+/* every Completed handler's Invoke is (this, operation, status) */
+typedef HRESULT (WINAPI *handler_invoke)( IUnknown *handler, void *operation, AsyncStatus status );
+
+static HRESULT WINAPI op_put_Completed( IInspectable *iface, IUnknown *handler )
+{
+    struct async *impl = impl_from_op( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    if (impl->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if (!handler) return S_OK;
+    impl->handler = handler;
+    IUnknown_AddRef( handler );
+    ((handler_invoke)(*(void ***)handler)[3])( handler, &impl->op_iface, async_status( impl ) );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_get_Completed( IInspectable *iface, IUnknown **handler )
+{
+    struct async *impl = impl_from_op( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if ((*handler = impl->handler)) IUnknown_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_GetResults( IInspectable *iface, void **results )
+{
+    struct async *impl = impl_from_op( iface );
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    *results = NULL;
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    if (FAILED(impl->hr)) return impl->hr;
+    if ((*results = impl->result)) IUnknown_AddRef( impl->result );
+    return S_OK;
+}
+
+struct op_vtbl
+{
+    void *QueryInterface, *AddRef, *Release, *GetIids, *GetRuntimeClassName, *GetTrustLevel;
+    void *put_Completed, *get_Completed, *GetResults;
+};
+
+static const struct op_vtbl op_vtbl =
+{
+    op_QueryInterface, op_AddRef, op_Release, op_GetIids, op_GetRuntimeClassName, op_GetTrustLevel,
+    op_put_Completed, op_get_Completed, op_GetResults,
+};
+
+static struct async *impl_from_IAsyncInfo( IAsyncInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct async, IAsyncInfo_iface );
+}
+
+static HRESULT WINAPI info_QueryInterface( IAsyncInfo *iface, REFIID iid, void **out )
+{
+    return op_QueryInterface( &impl_from_IAsyncInfo( iface )->op_iface, iid, out );
+}
+
+static ULONG WINAPI info_AddRef( IAsyncInfo *iface )
+{
+    return op_AddRef( &impl_from_IAsyncInfo( iface )->op_iface );
+}
+
+static ULONG WINAPI info_Release( IAsyncInfo *iface )
+{
+    return op_Release( &impl_from_IAsyncInfo( iface )->op_iface );
+}
+
+static HRESULT WINAPI info_GetIids( IAsyncInfo *iface, ULONG *iid_count, IID **iids )
+{
+    return op_GetIids( &impl_from_IAsyncInfo( iface )->op_iface, iid_count, iids );
+}
+
+static HRESULT WINAPI info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *class_name )
+{
+    return op_GetRuntimeClassName( &impl_from_IAsyncInfo( iface )->op_iface, class_name );
+}
+
+static HRESULT WINAPI info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *trust_level )
+{
+    return op_GetTrustLevel( &impl_from_IAsyncInfo( iface )->op_iface, trust_level );
+}
+
+static HRESULT WINAPI info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    TRACE( "iface %p, id %p.\n", iface, id );
+    *id = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct async *impl = impl_from_IAsyncInfo( iface );
+
+    TRACE( "iface %p, status %p.\n", iface, status );
+
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    *status = async_status( impl );
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error_code )
+{
+    struct async *impl = impl_from_IAsyncInfo( iface );
+
+    TRACE( "iface %p, error_code %p.\n", iface, error_code );
+
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    *error_code = impl->hr;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_Cancel( IAsyncInfo *iface )
+{
+    TRACE( "iface %p.\n", iface );
+    return S_OK;
+}
+
+static HRESULT WINAPI info_Close( IAsyncInfo *iface )
+{
+    TRACE( "iface %p.\n", iface );
+    impl_from_IAsyncInfo( iface )->closed = TRUE;
+    return S_OK;
+}
+
+static const struct IAsyncInfoVtbl info_vtbl =
+{
+    info_QueryInterface, info_AddRef, info_Release,
+    info_GetIids, info_GetRuntimeClassName, info_GetTrustLevel,
+    info_get_Id, info_get_Status, info_get_ErrorCode, info_Cancel, info_Close,
+};
+
+/* an IAsyncOperation<T *> with iid and runtime class name for T, finished with result or the error hr */
+HRESULT async_ptr_create( const GUID *iid, const WCHAR *class_name, IUnknown *result, HRESULT hr, void **out )
+{
+    struct async *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->op_iface.lpVtbl = (void *)&op_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    impl->ref = 1;
+    impl->hr = hr;
+    impl->iid = iid;
+    impl->class_name = class_name;
+    if ((impl->result = result)) IUnknown_AddRef( result );
+    *out = &impl->op_iface;
+    return S_OK;
+}
