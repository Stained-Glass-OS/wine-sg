+/* the interface class an AQS filter asks for, if it names one of those that are known */
+BOOL filter_class( const WCHAR *filter, GUID *guid )
+{
+    const WCHAR *p;
+    WCHAR str[40];
+
+    if (!filter || !(p = wcsstr( filter, L"InterfaceClassGuid" ))) return FALSE;
+    if (!(p = wcschr( p, '{' ))) return FALSE;
+    lstrcpynW( str, p, 39 );
+    return SUCCEEDED(CLSIDFromString( str, guid ));
+}
+
+void device_list_free( struct device_list *list )
+{
+    UINT32 i;
+
+    for (i = 0; i < list->count; i++)
+    {
+        free( list->items[i].id );
+        free( list->items[i].name );
+    }
+    free( list->items );
+    memset( list, 0, sizeof(*list) );
+}
+
+static HRESULT device_list_add( struct device_list *list, const WCHAR *id, const WCHAR *name, BOOL is_default,
+                                const GUID *class )
+{
+    struct device_info *items, *info;
+
+    if (!(items = realloc( list->items, (list->count + 1) * sizeof(*items) ))) return E_OUTOFMEMORY;
+    list->items = items;
+    info = &items[list->count];
+    info->id = wcsdup( id );
+    info->name = wcsdup( name );
+    info->enabled = TRUE;
+    info->is_default = is_default;
+    info->class = *class;
+    if (!info->id || !info->name)
+    {
+        free( info->id );
+        free( info->name );
+        return E_OUTOFMEMORY;
+    }
+    list->count++;
+    return S_OK;
+}
+
+/* the endpoints of the audio devices; the identifier is that of the device interface of the endpoint */
+static HRESULT enumerate_audio( struct device_list *list, EDataFlow flow, const GUID *class )
+{
+    IMMDeviceEnumerator *enumerator;
+    IMMDeviceCollection *devices;
+    IMMDevice *default_device = NULL, *device;
+    WCHAR *default_id = NULL, guid[39];
+    UINT count, i, k;
+    HRESULT hr;
+
+    if (FAILED(hr = CoCreateInstance( &mm_enumerator_clsid, NULL, CLSCTX_INPROC_SERVER, &mm_enumerator_iid,
+                                      (void **)&enumerator ))) return S_OK;    /* no audio: no devices */
+    if (SUCCEEDED(IMMDeviceEnumerator_GetDefaultAudioEndpoint( enumerator, flow, eConsole, &default_device )))
+    {
+        IMMDevice_GetId( default_device, &default_id );
+        IMMDevice_Release( default_device );
+    }
+    StringFromGUID2( class, guid, ARRAY_SIZE(guid) );
+    for (k = 0; guid[k]; k++) guid[k] = towlower( guid[k] );
+
+    if (SUCCEEDED(hr = IMMDeviceEnumerator_EnumAudioEndpoints( enumerator, flow, DEVICE_STATE_ACTIVE, &devices )))
+    {
+        IMMDeviceCollection_GetCount( devices, &count );
+        for (i = 0; i < count && SUCCEEDED(hr); i++)
+        {
+            IPropertyStore *store;
+            PROPVARIANT name;
+            WCHAR *id = NULL, *path;
+            size_t len;
+
+            if (FAILED(IMMDeviceCollection_Item( devices, i, &device ))) continue;
+            if (SUCCEEDED(IMMDevice_GetId( device, &id )))
+            {
+                PropVariantInit( &name );
+                if (SUCCEEDED(IMMDevice_OpenPropertyStore( device, STGM_READ, &store )))
+                {
+                    IPropertyStore_GetValue( store, &friendly_name_key, &name );
+                    IPropertyStore_Release( store );
+                }
+                len = wcslen( id ) + wcslen( guid ) + 24;
+                if ((path = malloc( len * sizeof(WCHAR) )))
+                {
+                    swprintf( path, len, L"\\\\?\\SWD#MMDEVAPI#%s#%s", id, guid );
+                    hr = device_list_add( list, path, name.vt == VT_LPWSTR ? name.pwszVal : id,
+                                          default_id && !wcscmp( default_id, id ), class );
+                    free( path );
+                }
+                PropVariantClear( &name );
+                CoTaskMemFree( id );
+            }
+            IMMDevice_Release( device );
+        }
+        IMMDeviceCollection_Release( devices );
+    }
+    CoTaskMemFree( default_id );
+    IMMDeviceEnumerator_Release( enumerator );
+    return hr;
+}
+
+/* removable drives */
+static HRESULT enumerate_storage( struct device_list *list )
+{
+    DWORD drives = GetLogicalDrives();
+    WCHAR root[4] = L"A:\\", volume[64], label[64], name[128];
+    HRESULT hr = S_OK;
+    int i;
+
+    for (i = 0; i < 26 && SUCCEEDED(hr); i++)
+    {
+        if (!(drives & (1 << i))) continue;
+        root[0] = 'A' + i;
+        if (GetDriveTypeW( root ) != DRIVE_REMOVABLE) continue;
+        if (!GetVolumeNameForVolumeMountPointW( root, volume, ARRAY_SIZE(volume) )) continue;
+        label[0] = 0;
+        GetVolumeInformationW( root, label, ARRAY_SIZE(label), NULL, NULL, NULL, NULL, 0 );
+        swprintf( name, ARRAY_SIZE(name), L"%s (%c:)", label[0] ? label : L"Removable Disk", root[0] );
+        hr = device_list_add( list, volume, name, FALSE, &storage_class );
+    }
+    return hr;
+}
+
+/* the devices of one interface class (all of those that are known when class is NULL) */
+HRESULT enumerate_devices( const GUID *class, struct device_list *list )
+{
+    HRESULT hr = S_OK;
+
+    memset( list, 0, sizeof(*list) );
+    if (!class || IsEqualGUID( class, &audio_capture_class ))
+        hr = enumerate_audio( list, eCapture, &audio_capture_class );
+    if (SUCCEEDED(hr) && (!class || IsEqualGUID( class, &audio_render_class )))
+        hr = enumerate_audio( list, eRender, &audio_render_class );
+    if (SUCCEEDED(hr) && (!class || IsEqualGUID( class, &storage_class )))
+        hr = enumerate_storage( list );
+    if (FAILED(hr)) device_list_free( list );
+    return hr;
+}
