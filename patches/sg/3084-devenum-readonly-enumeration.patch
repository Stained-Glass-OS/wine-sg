 extern IActivationFactory *device_access_factory;
 
+struct device_info
+{
+    WCHAR *id;
+    WCHAR *name;
+    BOOL enabled, is_default;
+    GUID class;
+};
+
+struct device_list
+{
+    struct device_info *items;
+    UINT32 count;
+};
+
+const GUID *device_class_guid( DeviceClass device_class );
+HRESULT device_class_filter( DeviceClass device_class, HSTRING *filter );
