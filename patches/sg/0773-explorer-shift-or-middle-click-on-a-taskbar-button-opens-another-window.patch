From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: Shift+click or a middle click on a taskbar button
 opens another window

A running program's button only brought its window forward; another window
of it (another File Explorer -- David 2026-10-02: "you need to be able to
open more than one of them") took the button's menu. As Windows' taskbar,
Shift+click or a middle click on the button starts the program again. Not
for an elevated program's window (its consent, from its menu) or a Linux
program's.

Test: test/anotherwindow-gate.sh (mutant SG_MUTANT_NO_ANOTHER_WINDOW).
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -132,6 +132,14 @@
 
 static struct list taskbar_buttons = LIST_INIT( taskbar_buttons );
 
+/* Stained Glass OS: another window of a running program, as Windows' taskbar
+ * opens one on Shift+click or a middle click on its button (David
+ * 2026-10-02: "you need to be able to open more than one" File Explorer) --
+ * not of an elevated program (its consent, from its own button menu) or a
+ * Linux one. Defined below. */
+static void sg_button_middle_click( HWND button );
+static BOOL sg_launch_another( HWND hwnd );
+
 static HWND tray_window;
 static HWND taskview_button;   /* Stained Glass OS: Task View, left of the desktop pager */
 static HWND pager_window;      /* Stained Glass OS: the desktop pager, left of the tray icons */
@@ -1534,6 +1542,7 @@
     }
     win->button = CreateWindowW( WC_BUTTONW, NULL, WS_CHILD | BS_OWNERDRAW,
                                  0, 0, 0, 0, tray_window, (HMENU)hwnd, 0, 0 );
+    sg_button_middle_click( win->button );
     list_add_tail( &taskbar_buttons, &win->entry );
 }
 
@@ -2081,6 +2090,7 @@
             }
             win->button = CreateWindowW( WC_BUTTONW, NULL, WS_CHILD | BS_OWNERDRAW, 0, 0, 0, 0,
                                          tray_window, (HMENU)stand_in, 0, 0 );
+            sg_button_middle_click( win->button );
             list_add_tail( &taskbar_buttons, &win->entry );
             changed = TRUE;
         }
@@ -2983,6 +2993,9 @@
         else do_startmenu( tray_window );
         return;
     }
+#ifndef SG_MUTANT_NO_ANOTHER_WINDOW
+    if (GetKeyState( VK_SHIFT ) < 0 && sg_launch_another( hwnd )) return;
+#endif
     if (hwnd && (win = find_taskbar_button( hwnd )) && win->combined && win->group == win && win->group_count > 1)
     {
         if (!(hwnd = sg_choose_in_group( win, button ))) return;
@@ -3081,6 +3094,32 @@
 
 static void sg_taskbar_menu( LPARAM lparam );
 
+static BOOL sg_launch_another( HWND hwnd )
+{
+    struct taskbar_button *win;
+    if (!hwnd || !(win = find_taskbar_button( hwnd )) || !win->exe[0] || win->elevated || win->xwin) return FALSE;
+    ShellExecuteW( NULL, NULL, win->exe, NULL, NULL, SW_SHOWNORMAL );
+    return TRUE;
+}
+
+static WNDPROC sg_button_proc;
+
+static LRESULT CALLBACK sg_button_middle_proc( HWND button, UINT msg, WPARAM wp, LPARAM lp )
+{
+#ifndef SG_MUTANT_NO_ANOTHER_WINDOW
+    if (msg == WM_MBUTTONUP) { sg_launch_another( (HWND)GetWindowLongPtrW( button, GWLP_ID ) ); return 0; }
+#endif
+    return CallWindowProcW( sg_button_proc, button, msg, wp, lp );
+}
+
+static void sg_button_middle_click( HWND button )
+{
+    WNDPROC old;
+    if (!button) return;
+    old = (WNDPROC)SetWindowLongPtrW( button, GWLP_WNDPROC, (LONG_PTR)sg_button_middle_proc );
+    if (!sg_button_proc) sg_button_proc = old;
+}
+
 /* Stained Glass OS: a program's button has Windows 10's menu -- the program
  * (another window of it), Report a problem (sg-bugreport, for testers) and
  * Close window; Shift+right-click keeps the window's own system menu. */
