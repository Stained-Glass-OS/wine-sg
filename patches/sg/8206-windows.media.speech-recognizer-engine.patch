+#include "wine/unixlib.h"
+
+/* every field 64 bits: the same layout for 32-bit and 64-bit callers */
+struct speech_recognize_params
+{
+    UINT64 language;  /* const char *: en-US, de-DE, fr-FR, es-ES */
+    UINT64 seconds;   /* the most to listen for */
+    UINT64 text;      /* char *: what was said, UTF-8 */
+    UINT64 size;      /* in: the buffer's size; out: the text's length */
+    UINT64 status;    /* out: SPEECH_RECOGNIZED, SPEECH_NO_ENGINE, SPEECH_FAILED */
+};
+
+enum { SPEECH_RECOGNIZED, SPEECH_NO_ENGINE, SPEECH_FAILED };
+
+enum speech_funcs
+{
+    unix_speech_recognize,
+    unix_speech_count,
+};
