+++ b/dlls/windows.media.speech/unixlib.c
@@ -0,0 +1,163 @@
+/*
+ * Stained Glass OS: speech recognition through the system's own engine (wine-sg 8206)
+ *
+ * The engine is Stained Glass OS's voice typing (sg-dictate: Parakeet on the CPU, the model installed with
+ * the system). It runs as the user, as the program asking does, and is asked through its command line:
+ * --listen --once (the microphone, until the speaker pauses, at most SECONDS). Nothing heard is kept.
+ *
