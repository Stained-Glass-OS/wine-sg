+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <spawn.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(speech);
+
+extern char **environ;
+
+#define ENGINE "/usr/bin/sg-dictate"
+
+static long long now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return ts.tv_sec * 1000LL + ts.tv_nsec / 1000000;
+}
+
+static NTSTATUS speech_recognize( void *args )
+{
+    struct speech_recognize_params *params = args;
+    const char *lang = (const char *)(ULONG_PTR)params->language;
+    char *text = (char *)(ULONG_PTR)params->text, seconds[16];
+    char *argv[10];
+    posix_spawn_file_actions_t actions;
+    int fds[2], status = 0, argc = 0;
+    size_t len = 0, size = params->size;
+    long long deadline;
+    pid_t pid;
+
+    params->status = SPEECH_FAILED;
+    params->size = 0;
+    if (!size) return STATUS_INVALID_PARAMETER;
+    text[0] = 0;
+    if (access( ENGINE, X_OK ))
+    {
+        params->status = SPEECH_NO_ENGINE;
+        return STATUS_SUCCESS;
+    }
+    snprintf( seconds, sizeof(seconds), "%u", (unsigned int)params->seconds );
+    argv[argc++] = (char *)ENGINE;
+    argv[argc++] = (char *)"--listen";
+    argv[argc++] = (char *)"--once";
+    argv[argc++] = (char *)"--seconds";
+    argv[argc++] = seconds;
+    argv[argc++] = (char *)"--language";
+    argv[argc++] = (char *)(lang && *lang ? lang : "en-US");
+    argv[argc] = NULL;
+
+    if (pipe2( fds, O_CLOEXEC )) return STATUS_UNSUCCESSFUL;
+    posix_spawn_file_actions_init( &actions );
+    posix_spawn_file_actions_addopen( &actions, 0, "/dev/null", O_RDONLY, 0 );
+    posix_spawn_file_actions_adddup2( &actions, fds[1], 1 );
+    posix_spawn_file_actions_addopen( &actions, 2, "/dev/null", O_WRONLY, 0 );
+    if (posix_spawn( &pid, ENGINE, &actions, NULL, argv, environ ))
+    {
+        posix_spawn_file_actions_destroy( &actions );
+        close( fds[0] );
+        close( fds[1] );
+        return STATUS_UNSUCCESSFUL;
+    }
+    posix_spawn_file_actions_destroy( &actions );
+    close( fds[1] );
+
+    /* the model loads first (seconds), then it listens */
+    deadline = now_ms() + (params->seconds + 60) * 1000LL;
+    for (;;)
+    {
+        struct pollfd pfd = { fds[0], POLLIN };
+        long long left = deadline - now_ms();
+        ssize_t got;
+
+        if (left <= 0)
+        {
+            WARN( "the speech engine took too long\n" );
+            kill( pid, SIGTERM );
+            break;
+        }
+        if (poll( &pfd, 1, left > 1000 ? 1000 : left ) <= 0) continue;
+        if (len + 1 >= size) break;
+        got = read( fds[0], text + len, size - 1 - len );
+        if (got < 0 && errno == EINTR) continue;
+        if (got <= 0) break;
+        len += got;
+    }
+    close( fds[0] );
+    while (waitpid( pid, &status, 0 ) < 0 && errno == EINTR);
+    text[len] = 0;
+    if (WIFEXITED( status ) && WEXITSTATUS( status ) == 3)   /* the model is not installed */
+    {
+        params->status = SPEECH_NO_ENGINE;
+        text[0] = 0;
+        return STATUS_SUCCESS;
+    }
+    if (!WIFEXITED( status ) || WEXITSTATUS( status )) return STATUS_SUCCESS;   /* failed */
+    len = strlen( text );
+    while (len && (text[len - 1] == '\n' || text[len - 1] == '\r' || text[len - 1] == ' ')) text[--len] = 0;
+    params->size = len;
+    params->status = SPEECH_RECOGNIZED;
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    speech_recognize,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_speech_count );
+
+#ifdef _WIN64
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    speech_recognize,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_speech_count );
+#endif
