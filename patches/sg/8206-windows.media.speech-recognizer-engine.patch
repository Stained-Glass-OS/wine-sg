+/* Stained Glass OS (wine-sg 8206): the system's speech engine (unixlib.c) hears the microphone until the
+ * speaker pauses. With list
+ * constraints, what was said must be one of their phrases (letter case, spaces and end punctuation aside);
+ * otherwise it is rejected, as Windows does. */
+static INIT_ONCE unix_init_once = INIT_ONCE_STATIC_INIT;
+static BOOL unix_ready;
+
+static BOOL WINAPI unix_init( INIT_ONCE *once, void *param, void **context )
+{
+    unix_ready = !__wine_init_unix_call();
+    return TRUE;
+}
+
+static void speech_language( struct recognizer *impl, char *out, size_t size )
+{
+    static const char *supported[] = { "en-US", "de-DE", "fr-FR", "es-ES" };
+    HSTRING tag = NULL;
+    const WCHAR *str;
+    unsigned int i;
+
+    snprintf(out, size, "en-US");
+    if (!impl->language || FAILED(ILanguage_get_LanguageTag(impl->language, &tag))) return;
+    str = WindowsGetStringRawBuffer(tag, NULL);
+    for (i = 0; i < ARRAY_SIZE(supported); i++)
+        if (str[0] == supported[i][0] && str[1] == supported[i][1]) { snprintf(out, size, "%s", supported[i]); break; }
+    WindowsDeleteString(tag);
+}
+
+/* a phrase as it is compared: lower case, no spaces at its ends, no end punctuation */
+static void phrase_key( const WCHAR *in, UINT32 len, WCHAR *out, UINT32 size )
+{
+    UINT32 n = 0, i;
+
+    while (len && (iswspace(*in))) { in++; len--; }
+    while (len && (iswspace(in[len - 1]) || wcschr(L".!?,;:", in[len - 1]))) len--;
+    for (i = 0; i < len && n + 1 < size; i++) out[n++] = towlower(in[i]);
+    out[n] = 0;
+}
+
+/* the list constraint and phrase what was said is one of; FALSE with no list constraints at all */
+static BOOL match_constraints( struct recognizer *impl, const WCHAR *said, UINT32 said_len,
+                               ISpeechRecognitionConstraint **matched, HSTRING *phrase, BOOL *any_list )
+{
+    struct session *session = impl_from_ISpeechContinuousRecognitionSession(impl->session);
+    ISpeechRecognitionListConstraint *list;
+    ISpeechRecognitionConstraint *constraint;
+    IVector_HSTRING *commands;
+    WCHAR key[512], key2[512];
+    UINT32 count = 0, n = 0, i, j;
+    HSTRING command;
+
+    *matched = NULL;
+    *any_list = FALSE;
+    phrase_key(said, said_len, key, ARRAY_SIZE(key));
+    if (!session->constraints) return FALSE;
+    IVector_ISpeechRecognitionConstraint_get_Size(session->constraints, &count);
+    for (i = 0; i < count && !*matched; i++)
+    {
+        if (FAILED(IVector_ISpeechRecognitionConstraint_GetAt(session->constraints, i, &constraint))) continue;
+        if (SUCCEEDED(ISpeechRecognitionConstraint_QueryInterface(constraint, &IID_ISpeechRecognitionListConstraint,
+                                                                  (void **)&list)))
+        {
+            *any_list = TRUE;
+            if (SUCCEEDED(ISpeechRecognitionListConstraint_get_Commands(list, &commands)))
+            {
+                IVector_HSTRING_get_Size(commands, &n);
+                for (j = 0; j < n && !*matched; j++)
+                {
+                    UINT32 len;
+                    const WCHAR *str;
+
+                    if (FAILED(IVector_HSTRING_GetAt(commands, j, &command))) continue;
+                    str = WindowsGetStringRawBuffer(command, &len);
+                    phrase_key(str, len, key2, ARRAY_SIZE(key2));
+#ifndef SG_MUTANT_WMS_NO_MATCH
+                    if (key[0] && !wcscmp(key, key2))
+#else
+                    if (0)
+#endif
+                    {
+                        ISpeechRecognitionConstraint_AddRef((*matched = constraint));
+                        WindowsDuplicateString(command, phrase);
+                    }
+                    WindowsDeleteString(command);
+                }
+                IVector_HSTRING_Release(commands);
+            }
+            ISpeechRecognitionListConstraint_Release(list);
+        }
+        ISpeechRecognitionConstraint_Release(constraint);
+    }
+    return *matched != NULL;
+}
+
 static HRESULT recognizer_recognize_async( IInspectable *invoker, IInspectable **result )
 {
-    #ifdef SG_MUTANT_WMS_RECOGNIZE
+    struct recognizer *impl = impl_from_ISpeechRecognizer((ISpeechRecognizer *)invoker);
+    struct speech_recognize_params params = { 0 };
+    struct recognition_result *res;
+    ISpeechRecognitionConstraint *matched = NULL;
+    HSTRING phrase = NULL;
+    WCHAR *said;
+    char language[16], *text;
+    BOOL any_list;
+    int len;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_WMS_RECOGNIZE
     return recognition_result_create(SpeechRecognitionResultStatus_Success, result);
-#else
-    return recognition_result_create(SpeechRecognitionResultStatus_TimeoutExceeded, result);
 #endif
+    InitOnceExecuteOnce(&unix_init_once, unix_init, NULL, NULL);
+    if (!unix_ready) return recognition_result_create(SpeechRecognitionResultStatus_TimeoutExceeded, result);
+    if (!(text = malloc(8192))) return E_OUTOFMEMORY;
+    speech_language(impl, language, sizeof(language));
+    params.language = (ULONG_PTR)language;
+    params.seconds = 10;
+    params.text = (ULONG_PTR)text;
+    params.size = 8192;
+    WINE_UNIX_CALL(unix_speech_recognize, &params);
+    TRACE("status %u, text %s\n", (UINT)params.status, debugstr_a(text));
+
+    if (params.status != SPEECH_RECOGNIZED || !params.size)
+    {
+        free(text);
+        if (params.status == SPEECH_NO_ENGINE) WARN("no speech engine (sg-dictate, its model) on this system\n");
+        return recognition_result_create(SpeechRecognitionResultStatus_TimeoutExceeded, result);
+    }
+    len = MultiByteToWideChar(CP_UTF8, 0, text, -1, NULL, 0);
+    if (!(said = malloc(len * sizeof(WCHAR))))
+    {
+        free(text);
+        return E_OUTOFMEMORY;
+    }
+    MultiByteToWideChar(CP_UTF8, 0, text, -1, said, len);
+    free(text);
+
+    if (FAILED(hr = recognition_result_create(SpeechRecognitionResultStatus_Success, result)))
+    {
+        free(said);
+        return hr;
+    }
+    res = impl_from_ISpeechRecognitionResult((ISpeechRecognitionResult *)*result);
+    if (match_constraints(impl, said, len - 1, &matched, &phrase, &any_list))
+    {
+        res->text = phrase;
+        res->constraint = matched;
+        res->confidence = SpeechRecognitionConfidence_High;
+        res->raw_confidence = 0.9;
+    }
+    else if (!any_list)
+    {
+        /* dictation (the default topic): what was said */
+        WindowsCreateString(said, len - 1, &res->text);
+        res->confidence = SpeechRecognitionConfidence_High;
+        res->raw_confidence = 0.9;
+    }
+    /* else: heard, but none of the phrases: rejected, no text */
+    free(said);
+    return S_OK;
 }
 
 static HRESULT recognizer_recognize( ISpeechRecognizer *iface, IAsyncOperation_SpeechRecognitionResult **operation )
@@ -1415,8 +1582,8 @@
 
     *operation = NULL;
     if (impl_from_ISpeechContinuousRecognitionSession(impl->session)->closed) return RO_E_CLOSED;
-    return async_operation_inspectable_create(&IID_IAsyncOperation_SpeechRecognitionResult, NULL, recognizer_recognize_async,
-                                              InterlockedIncrement(&impl->operation_id),
+    return async_operation_inspectable_create(&IID_IAsyncOperation_SpeechRecognitionResult, (IInspectable *)iface,
+                                              recognizer_recognize_async, InterlockedIncrement(&impl->operation_id),
                                               (IAsyncOperation_IInspectable **)operation);
 }
 
