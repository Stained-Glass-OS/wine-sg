+/******************************************************************
+ *    InitializeIpInterfaceEntry (IPHLPAPI.@)
+ *
+ * Every setting is "leave as it is" for SetIpInterfaceEntry.
+ */
+void WINAPI InitializeIpInterfaceEntry( MIB_IPINTERFACE_ROW *row )
+{
+    TRACE( "%p\n", row );
+
+    memset( row, 0, sizeof(*row) );
+    row->Family = AF_UNSPEC;
+    row->MinRouterAdvertisementInterval = ~0u;
+    row->MaxRouterAdvertisementInterval = ~0u;
+    row->AdvertisingEnabled = row->ForwardingEnabled = row->WeakHostSend = row->WeakHostReceive = 0xff;
+    row->UseAutomaticMetric = row->UseNeighborUnreachabilityDetection = 0xff;
+    row->ManagedAddressConfigurationSupported = row->OtherStatefulConfigurationSupported = 0xff;
+    row->AdvertiseDefaultRoute = 0xff;
+    row->RouterDiscoveryBehavior = RouterDiscoveryUnchanged;
+    row->DadTransmits = ~0u;
+    row->BaseReachableTime = ~0u;
+    row->RetransmitTime = ~0u;
+    row->PathMtuDiscoveryTimeout = ~0u;
+    row->LinkLocalAddressBehavior = LinkLocalUnchanged;
+    row->LinkLocalAddressTimeout = ~0u;
+    row->SitePrefixLength = ~0u;
+    row->Metric = ~0u;
+    row->NlMtu = ~0u;
+    row->DisableDefaultRoutes = 0xff;
 }
 
