+    TRACE("(%u %p)\n", family, table);
+
+    if (!table || (family != AF_UNSPEC && family != AF_INET && family != AF_INET6))
+        return ERROR_INVALID_PARAMETER;
+    *table = NULL;
+#ifdef SG_MUTANT_NO_IP_INTERFACES
     return ERROR_NOT_SUPPORTED;
+#endif
+    if ((err = GetIfTable2( &ifs ))) return err;
+    for (f = 0; f < 2; f++)
+        enabled[f] = (family == AF_UNSPEC || family == families[f]) && ip_family_enabled( families[f] );
+    if (!(*table = heap_alloc_zero( FIELD_OFFSET( MIB_IPINTERFACE_TABLE, Table[ifs->NumEntries * 2 + 1] ) )))
+    {
+        FreeMibTable( ifs );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    for (f = 0; f < 2; f++)
+    {
+        if (!enabled[f]) continue;
+        for (i = 0; i < ifs->NumEntries; i++)
+            ip_interface_row_fill( (*table)->Table + count++, families[f], ifs->Table + i );
+    }
+    (*table)->NumEntries = count;
+    FreeMibTable( ifs );
+    return NO_ERROR;
+}
