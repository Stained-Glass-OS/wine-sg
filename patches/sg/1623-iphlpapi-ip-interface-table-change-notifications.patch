+    if (!row || (row->Family != AF_INET && row->Family != AF_INET6)) return ERROR_INVALID_PARAMETER;
+    memset( &ifrow, 0, sizeof(ifrow) );
+    ifrow.InterfaceLuid = row->InterfaceLuid;
+    ifrow.InterfaceIndex = row->InterfaceIndex;
+    if ((err = GetIfEntry2( &ifrow ))) return err == ERROR_FILE_NOT_FOUND ? ERROR_NOT_FOUND : err;
+    if (!ip_family_enabled( row->Family )) return ERROR_NOT_FOUND;
+    ip_interface_row_fill( row, row->Family, &ifrow );
+    return NO_ERROR;
+}
