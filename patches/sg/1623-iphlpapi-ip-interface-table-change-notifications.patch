 DWORD WINAPI GetIpInterfaceTable(ADDRESS_FAMILY family, PMIB_IPINTERFACE_TABLE *table)
 {
-    FIXME("(%u %p): stub\n", family, table);
+    static const ADDRESS_FAMILY families[] = { AF_INET, AF_INET6 };
+    MIB_IF_TABLE2 *ifs;
+    ULONG f, i, count = 0;
