+static void test_GetIpInterfaceTable(void)
+{
+    MIB_IPINTERFACE_TABLE *table;
+    MIB_IPINTERFACE_ROW row;
+    DWORD ret, i;
+
+    ret = GetIpInterfaceTable(AF_INET, &table);
+    ok(ret == NO_ERROR, "got %lu\n", ret);
+    if (ret) return;
+    ok(table->NumEntries > 0, "no interfaces\n");
+    for (i = 0; i < table->NumEntries; i++)
+    {
+        ok(table->Table[i].Family == AF_INET, "got family %u\n", table->Table[i].Family);
+        memset(&row, 0, sizeof(row));
+        row.Family = AF_INET;
+        row.InterfaceLuid = table->Table[i].InterfaceLuid;
+        ret = GetIpInterfaceEntry(&row);
+        ok(ret == NO_ERROR, "got %lu\n", ret);
+        ok(row.InterfaceIndex == table->Table[i].InterfaceIndex, "got index %lu, expected %lu\n",
+           row.InterfaceIndex, table->Table[i].InterfaceIndex);
+        ok(row.NlMtu == table->Table[i].NlMtu, "got mtu %lu, expected %lu\n", row.NlMtu, table->Table[i].NlMtu);
+    }
+    FreeMibTable(table);
+
+    ret = GetIpInterfaceTable(AF_INET6 + 1, &table);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    memset(&row, 0, sizeof(row));
+    ret = GetIpInterfaceEntry(&row);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    row.Family = AF_INET;
+    row.InterfaceIndex = 0xdead;
+    ret = GetIpInterfaceEntry(&row);
+    ok(ret == ERROR_NOT_FOUND, "got %lu\n", ret);
+}
