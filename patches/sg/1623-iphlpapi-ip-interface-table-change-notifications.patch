+/******************************************************************
+ *    GetIpInterfaceTable (IPHLPAPI.@)
+ */
+/* Stained Glass OS: an interface's IP settings, from its link (the host
+ * keeps no per-family settings that Windows programs could change) */
+static ULONG ip_interface_metric( const MIB_IF_ROW2 *ifrow )
+{
+    ULONG64 speed = ifrow->ReceiveLinkSpeed;
+
+    /* the automatic metric, by link speed */
+    if (ifrow->Type == IF_TYPE_SOFTWARE_LOOPBACK) return 75;
+    if (speed >= 2000000000) return 5;
+    if (speed >= 200000000) return 10;
+    if (speed > 80000000) return 20;
+    if (speed > 20000000) return 25;
+    if (speed > 4000000) return 30;
+    if (speed > 500000) return 40;
+    return 50;
+}
+
+static void ip_interface_row_fill( MIB_IPINTERFACE_ROW *row, ADDRESS_FAMILY family, const MIB_IF_ROW2 *ifrow )
+{
+    BOOL loopback = ifrow->Type == IF_TYPE_SOFTWARE_LOOPBACK;
+    int i;
+
+    memset( row, 0, sizeof(*row) );
+    row->Family = family;
+    row->InterfaceLuid = ifrow->InterfaceLuid;
+    row->InterfaceIndex = ifrow->InterfaceIndex;
+    row->MaxReassemblySize = 0xffff;
+    row->MinRouterAdvertisementInterval = 200000;
+    row->MaxRouterAdvertisementInterval = 600000;
+    row->UseAutomaticMetric = TRUE;
+    row->UseNeighborUnreachabilityDetection = TRUE;
+    row->RouterDiscoveryBehavior = family == AF_INET ? RouterDiscoveryDhcp : RouterDiscoveryEnabled;
+    row->DadTransmits = family == AF_INET ? 3 : 1;
+    row->BaseReachableTime = 30000;
+    row->ReachableTime = 30000;
+    row->RetransmitTime = 1000;
+    row->PathMtuDiscoveryTimeout = 600000;
+    row->LinkLocalAddressBehavior = family == AF_INET ? LinkLocalDelayed : LinkLocalAlwaysOn;
+    row->LinkLocalAddressTimeout = 6000;
+    for (i = 0; i < ScopeLevelCount; i++)
+        row->ZoneIndices[i] = i <= ScopeLevelSubnet ? ifrow->InterfaceIndex : i == ScopeLevelGlobal ? 0 : 1;
+    row->SitePrefixLength = family == AF_INET6 ? 64 : 0;
+    row->Metric = ip_interface_metric( ifrow );
+    row->NlMtu = ifrow->Mtu;
+    row->Connected = loopback || ifrow->OperStatus == IfOperStatusUp;
+    row->SupportsNeighborDiscovery = !loopback;
+    row->SupportsRouterDiscovery = !loopback;
+}
+
+/* whether the host has IPv6 at all: a family without addresses anywhere
+ * has no interfaces */
+static BOOL ip_family_enabled( ADDRESS_FAMILY family )
+{
+    MIB_UNICASTIPADDRESS_TABLE *addrs;
+    BOOL ret;
+
+    if (family == AF_INET) return TRUE;
+    if (GetUnicastIpAddressTable( family, &addrs )) return FALSE;
+    ret = addrs->NumEntries != 0;
+    FreeMibTable( addrs );
+    return ret;
+}
