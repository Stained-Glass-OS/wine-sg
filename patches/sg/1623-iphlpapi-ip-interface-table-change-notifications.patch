+/* Stained Glass OS: change notifications with callbacks. A thread a
+ * registration waits for the NSI tables' change notifications, takes the
+ * table again and tells the caller what was added, deleted or changed. */
+enum mib_notify_kind { notify_unicast, notify_interface, notify_route };
+
+struct mib_notification
+{
+    enum mib_notify_kind kind;
+    ADDRESS_FAMILY family;
+    void *callback;
+    void *context;
+    HANDLE thread, stop;
+    DWORD thread_id;
+    LONG cancelled;
+    LONG self_free;  /* cancelled from a callback: the thread frees it */
+    void *table;   /* the last table seen */
+};
+
+static CRITICAL_SECTION mib_notify_cs;
+static CRITICAL_SECTION_DEBUG mib_notify_cs_debug =
+{
+    0, 0, &mib_notify_cs,
+    { &mib_notify_cs_debug.ProcessLocksList, &mib_notify_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": mib_notify_cs") }
+};
+static CRITICAL_SECTION mib_notify_cs = { &mib_notify_cs_debug, -1, 0, 0, 0, 0 };
+
+static DWORD mib_get_table( struct mib_notification *n, void **table )
+{
+    switch (n->kind)
+    {
+    case notify_unicast:   return GetUnicastIpAddressTable( n->family, (MIB_UNICASTIPADDRESS_TABLE **)table );
+    case notify_interface: return GetIpInterfaceTable( n->family, (MIB_IPINTERFACE_TABLE **)table );
+    case notify_route:     return GetIpForwardTable2( n->family, (MIB_IPFORWARD_TABLE2 **)table );
+    }
+    return ERROR_INVALID_PARAMETER;
+}
+
+static ULONG mib_table_count( struct mib_notification *n, void *table )
+{
+    return table ? *(ULONG *)table : 0;
+}
+
+static void *mib_table_row( struct mib_notification *n, void *table, ULONG i )
+{
+    switch (n->kind)
+    {
+    case notify_unicast:   return ((MIB_UNICASTIPADDRESS_TABLE *)table)->Table + i;
+    case notify_interface: return ((MIB_IPINTERFACE_TABLE *)table)->Table + i;
+    case notify_route:     return ((MIB_IPFORWARD_TABLE2 *)table)->Table + i;
+    }
+    return NULL;
+}
+
+static BOOL sockaddr_inet_equal( const SOCKADDR_INET *a, const SOCKADDR_INET *b )
+{
+    if (a->si_family != b->si_family) return FALSE;
+    if (a->si_family == AF_INET) return a->Ipv4.sin_addr.s_addr == b->Ipv4.sin_addr.s_addr;
+    if (a->si_family == AF_INET6)
+        return !memcmp( &a->Ipv6.sin6_addr, &b->Ipv6.sin6_addr, sizeof(a->Ipv6.sin6_addr) ) &&
+               a->Ipv6.sin6_scope_id == b->Ipv6.sin6_scope_id;
+    return TRUE;
+}
+
+/* whether two rows are the same instance (the table's key) */
+static BOOL mib_same_instance( struct mib_notification *n, const void *a, const void *b )
+{
+    switch (n->kind)
+    {
+    case notify_unicast:
+    {
+        const MIB_UNICASTIPADDRESS_ROW *x = a, *y = b;
+        return x->InterfaceLuid.Value == y->InterfaceLuid.Value && sockaddr_inet_equal( &x->Address, &y->Address );
+    }
+    case notify_interface:
+    {
+        const MIB_IPINTERFACE_ROW *x = a, *y = b;
+        return x->Family == y->Family && x->InterfaceLuid.Value == y->InterfaceLuid.Value;
+    }
+    case notify_route:
+    {
+        const MIB_IPFORWARD_ROW2 *x = a, *y = b;
+        return x->InterfaceLuid.Value == y->InterfaceLuid.Value &&
+               x->DestinationPrefix.PrefixLength == y->DestinationPrefix.PrefixLength &&
+               sockaddr_inet_equal( &x->DestinationPrefix.Prefix, &y->DestinationPrefix.Prefix ) &&
+               sockaddr_inet_equal( &x->NextHop, &y->NextHop );
+    }
+    }
+    return FALSE;
+}
+
+/* whether an instance's parameters changed: times that only count down
+ * (address lifetimes, route ages) are not changes */
+static BOOL mib_parameters_changed( struct mib_notification *n, const void *a, const void *b )
+{
+    switch (n->kind)
+    {
+    case notify_unicast:
+    {
+        const MIB_UNICASTIPADDRESS_ROW *x = a, *y = b;
+        return x->PrefixOrigin != y->PrefixOrigin || x->SuffixOrigin != y->SuffixOrigin ||
+               x->OnLinkPrefixLength != y->OnLinkPrefixLength || x->SkipAsSource != y->SkipAsSource ||
+               x->DadState != y->DadState || x->ScopeId.Value != y->ScopeId.Value;
+    }
+    case notify_interface:
+    {
+        const MIB_IPINTERFACE_ROW *x = a, *y = b;
+        return x->Connected != y->Connected || x->NlMtu != y->NlMtu || x->Metric != y->Metric ||
+               x->ForwardingEnabled != y->ForwardingEnabled;
+    }
+    case notify_route:
+    {
+        const MIB_IPFORWARD_ROW2 *x = a, *y = b;
+        return x->Metric != y->Metric || x->Protocol != y->Protocol || x->Loopback != y->Loopback;
+    }
+    }
+    return FALSE;
+}
+
+static void mib_call( struct mib_notification *n, void *row, MIB_NOTIFICATION_TYPE type )
+{
+    if (n->cancelled) return;
+    switch (n->kind)
+    {
+    case notify_unicast:   ((PUNICAST_IPADDRESS_CHANGE_CALLBACK)n->callback)( n->context, row, type ); break;
+    case notify_interface: ((PIPINTERFACE_CHANGE_CALLBACK)n->callback)( n->context, row, type ); break;
+    case notify_route:     ((PIPFORWARD_CHANGE_CALLBACK)n->callback)( n->context, row, type ); break;
+    }
+}
+
+static void mib_compare( struct mib_notification *n, void *old, void *new )
+{
+    ULONG i, j, old_count = mib_table_count( n, old ), new_count = mib_table_count( n, new );
+
+    for (i = 0; i < old_count; i++)
+    {
+        for (j = 0; j < new_count; j++)
+            if (mib_same_instance( n, mib_table_row( n, old, i ), mib_table_row( n, new, j ) )) break;
+        if (j == new_count) mib_call( n, mib_table_row( n, old, i ), MibDeleteInstance );
+    }
+    for (j = 0; j < new_count; j++)
+    {
+        for (i = 0; i < old_count; i++)
+            if (mib_same_instance( n, mib_table_row( n, old, i ), mib_table_row( n, new, j ) )) break;
+        if (i == old_count) mib_call( n, mib_table_row( n, new, j ), MibAddInstance );
+        else if (mib_parameters_changed( n, mib_table_row( n, old, i ), mib_table_row( n, new, j ) ))
+            mib_call( n, mib_table_row( n, new, j ), MibParameterNotification );
+    }
+}
+
+/* the NSI tables whose changes matter to a registration */
+static void mib_tables( struct mib_notification *n, const NPI_MODULEID **modules, DWORD *tables, int *count )
+{
+    *count = 0;
+    if (n->kind == notify_interface)
+    {
+        modules[*count] = &NPI_MS_NDIS_MODULEID;
+        tables[(*count)++] = NSI_NDIS_IFINFO_TABLE;
+    }
+    if (n->family != AF_INET6)
+    {
+        modules[*count] = &NPI_MS_IPV4_MODULEID;
+        tables[(*count)++] = n->kind == notify_route ? NSI_IP_FORWARD_TABLE : NSI_IP_UNICAST_TABLE;
+    }
+    if (n->family != AF_INET)
+    {
+        modules[*count] = &NPI_MS_IPV6_MODULEID;
+        tables[(*count)++] = n->kind == notify_route ? NSI_IP_FORWARD_TABLE : NSI_IP_UNICAST_TABLE;
+    }
+}
+
+static void free_mib_notification( struct mib_notification *n );
+
+static DWORD WINAPI mib_notification_thread( void *arg )
+{
+    struct mib_notification *n = arg;
+    const NPI_MODULEID *modules[3];
+    OVERLAPPED ovr[3];
+    HANDLE handles[4], nsi_handles[3];
+    DWORD tables[3], ret;
+    int count, i;
+    void *table;
+
+    mib_tables( n, modules, tables, &count );
+    memset( ovr, 0, sizeof(ovr) );
+    handles[0] = n->stop;
+    for (i = 0; i < count; i++)
+    {
+        handles[i + 1] = ovr[i].hEvent = CreateEventW( NULL, TRUE, FALSE, NULL );
+        nsi_handles[i] = NULL;
+    }
+
+    while (!n->cancelled)
+    {
+        /* ask first, then look: a change between the two is not lost */
+        for (i = 0; i < count; i++)
+        {
+            if (nsi_handles[i]) continue;
+            ResetEvent( ovr[i].hEvent );
+            if (NsiRequestChangeNotification( 0, modules[i], tables[i], &ovr[i], &nsi_handles[i] ) != ERROR_IO_PENDING)
+                nsi_handles[i] = NULL;
+        }
+        if (!mib_get_table( n, &table ))
+        {
+            mib_compare( n, n->table, table );
+            FreeMibTable( n->table );
+            n->table = table;
+        }
+        ret = WaitForMultipleObjects( count + 1, handles, FALSE, INFINITE );
+        if (ret == WAIT_OBJECT_0 || ret == WAIT_FAILED) break;
+        i = ret - WAIT_OBJECT_0 - 1;
+        if (i >= 0 && i < count) nsi_handles[i] = NULL;
+        Sleep( 50 );  /* a burst of changes is taken as one */
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        /* the cancelled request completes into ovr: wait for it */
+        if (nsi_handles[i] && !NsiCancelChangeNotification( &ovr[i] ))
+            WaitForSingleObject( ovr[i].hEvent, INFINITE );
+        CloseHandle( ovr[i].hEvent );
+    }
+    if (n->self_free) free_mib_notification( n );
+    return 0;
+}
+
+static void free_mib_notification( struct mib_notification *n )
+{
+    if (n->thread) CloseHandle( n->thread );
+    if (n->stop) CloseHandle( n->stop );
+    FreeMibTable( n->table );
+    heap_free( n );
+}
+
+static DWORD register_mib_notification( enum mib_notify_kind kind, ADDRESS_FAMILY family, void *callback,
+                                        void *context, BOOLEAN init_notify, HANDLE *handle )
+{
+    struct mib_notification *n;
+    DWORD err;
+
+    if (!handle || !callback || (family != AF_UNSPEC && family != AF_INET && family != AF_INET6))
+        return ERROR_INVALID_PARAMETER;
+    *handle = NULL;
+    if (!(n = heap_alloc_zero( sizeof(*n) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    n->kind = kind;
+    n->family = family;
+    n->callback = callback;
+    n->context = context;
+#ifndef SG_MUTANT_NO_MIB_NOTIFY
+    if ((err = mib_get_table( n, &n->table )) && err != ERROR_NOT_FOUND)
+    {
+        free_mib_notification( n );
+        return err;
+    }
+    if (!(n->stop = CreateEventW( NULL, TRUE, FALSE, NULL )) ||
+        !(n->thread = CreateThread( NULL, 0, mib_notification_thread, n, CREATE_SUSPENDED, &n->thread_id )))
+    {
+        err = GetLastError();
+        free_mib_notification( n );
+        return err;
+    }
+#endif
+    /* the initial notification comes before the call returns */
+    if (init_notify) mib_call( n, NULL, MibInitialNotification );
+    if (n->thread) ResumeThread( n->thread );
+    *handle = n;
+    return NO_ERROR;
+}
+
+static DWORD cancel_mib_notification( HANDLE handle )
+{
+    struct mib_notification *n = handle;
+
+    if (!n) return ERROR_INVALID_HANDLE;
+    EnterCriticalSection( &mib_notify_cs );
+    InterlockedExchange( &n->cancelled, 1 );
+    if (n->stop) SetEvent( n->stop );
+    LeaveCriticalSection( &mib_notify_cs );
+    /* callbacks running are waited for, unless this is one */
+    if (n->thread && GetCurrentThreadId() != n->thread_id)
+    {
+        WaitForSingleObject( n->thread, INFINITE );
+        free_mib_notification( n );
+    }
+    /* from a callback: the thread frees it as it ends */
+    else if (n->thread) n->self_free = 1;
+    else free_mib_notification( n );
+    return NO_ERROR;
+}
+
