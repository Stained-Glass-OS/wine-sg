+        return CONNECT_E_CANNOTCONNECT;
     LIST_FOR_EACH(cursor, &This->singleSinks)
     {
         single = LIST_ENTRY(cursor, ContextSingleSink, entry);
@@ -1528,6 +1528,26 @@ static HRESULT WINAPI SourceSingle_AdviseSingleSink( ITfSourceSingle *iface,
     return S_OK;
 }
 
+/* the cleanup duration sinks are told a cleanup of the context starts / ends */
+void Context_NotifyCleanup(ITfContext *iface, BOOL start)
+{
+    Context *This = impl_from_ITfContext(iface);
+    struct list *cursor;
+
+    LIST_FOR_EACH(cursor, &This->singleSinks)
+    {
+        ContextSingleSink *s = LIST_ENTRY(cursor, ContextSingleSink, entry);
+        ITfCleanupContextDurationSink *sink = (ITfCleanupContextDurationSink *)s->sink;
+
+        if (!IsEqualIID(&s->iid, &IID_ITfCleanupContextDurationSink)) continue;
+#ifdef SG_MUTANT_MSCTFB2_CLEANUP
+        if (start) continue;
+#endif
+        if (start) ITfCleanupContextDurationSink_OnStartCleanupContext(sink);
+        else ITfCleanupContextDurationSink_OnEndCleanupContext(sink);
+    }
+}
+
 static HRESULT WINAPI SourceSingle_UnadviseSingleSink( ITfSourceSingle *iface,
     TfClientId tid, REFIID riid)
 {
