 /* the display attribute providers are the text services registered in the
- * display attribute provider category. Their attributes come from the provider's
- * ITfDisplayAttributeProvider, whose interface identifier is not in a source we
- * may use, so a registered provider cannot be asked: with none registered the
- * enumeration is empty and no attribute is found. */
-static BOOL have_providers(void)
+ * display attribute provider category; each is created and asked through
+ * ITfDisplayAttributeProvider. Their interface identifier and method order are
+ * from windows-rs (MIT), see msctf.idl. */
+struct provider { ITfDisplayAttributeProvider *prov; CLSID clsid; };
+
+static HRESULT get_providers(struct provider **out, ULONG *count)
 {
     IUnknown *obj;
     ITfCategoryMgr *catmgr;
     IEnumGUID *e;
-    GUID g;
+    struct provider *list = NULL;
     ULONG n = 0;
+    GUID g;
+    ULONG fetched;
 
-    if (FAILED(CategoryMgr_Constructor(NULL, &obj))) return FALSE;
+    *out = NULL;
+    *count = 0;
+    if (FAILED(CategoryMgr_Constructor(NULL, &obj))) return E_OUTOFMEMORY;
     if (FAILED(IUnknown_QueryInterface(obj, &IID_ITfCategoryMgr, (void **)&catmgr)))
     {
         IUnknown_Release(obj);
-        return FALSE;
+        return E_FAIL;
     }
     IUnknown_Release(obj);
     if (SUCCEEDED(ITfCategoryMgr_EnumItemsInCategory(catmgr, &sg_cat_display_provider, &e)))
     {
-        if (IEnumGUID_Next(e, 1, &g, &n) != S_OK) n = 0;
+        while (IEnumGUID_Next(e, 1, &g, &fetched) == S_OK)
+        {
+            ITfDisplayAttributeProvider *p;
+            struct provider *nl;
+
+            if (FAILED(CoCreateInstance(&g, NULL, CLSCTX_INPROC_SERVER, &IID_ITfDisplayAttributeProvider, (void **)&p)))
+                continue;
+            if (!(nl = realloc(list, (n + 1) * sizeof(*list))))
+            {
+                ITfDisplayAttributeProvider_Release(p);
+                continue;
+            }
+            list = nl;
+            list[n].prov = p;
+            list[n].clsid = g;
+            n++;
+        }
         IEnumGUID_Release(e);
     }
     ITfCategoryMgr_Release(catmgr);
-    return n != 0;
+    *out = list;
+    *count = n;
+    return S_OK;
+}
+
+static void free_providers(struct provider *list, ULONG n)
+{
+    ULONG i;
+    for (i = 0; i < n; i++) ITfDisplayAttributeProvider_Release(list[i].prov);
+    free(list);
 }
 
 typedef struct
 {
     IEnumTfDisplayAttributeInfo IEnumTfDisplayAttributeInfo_iface;
     LONG ref;
-} EmptyEnumInfo;
+    ITfDisplayAttributeInfo **infos;
+    ULONG count, pos;
+} InfoEnum;
 
-static inline EmptyEnumInfo *impl_from_IEnumTfDisplayAttributeInfo(IEnumTfDisplayAttributeInfo *iface)
+static inline InfoEnum *impl_from_IEnumTfDisplayAttributeInfo(IEnumTfDisplayAttributeInfo *iface)
 {
-    return CONTAINING_RECORD(iface, EmptyEnumInfo, IEnumTfDisplayAttributeInfo_iface);
+    return CONTAINING_RECORD(iface, InfoEnum, IEnumTfDisplayAttributeInfo_iface);
 }
 
-static HRESULT WINAPI EmptyEnum_QueryInterface(IEnumTfDisplayAttributeInfo *iface, REFIID riid, void **obj)
+static HRESULT WINAPI InfoEnum_QueryInterface(IEnumTfDisplayAttributeInfo *iface, REFIID riid, void **obj)
 {
     if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumTfDisplayAttributeInfo))
     {
@@ -155,63 +191,101 @@ static HRESULT WINAPI EmptyEnum_QueryInterface(IEnumTfDisplayAttributeInfo *ifac
     return E_NOINTERFACE;
 }
 
-static ULONG WINAPI EmptyEnum_AddRef(IEnumTfDisplayAttributeInfo *iface)
+static ULONG WINAPI InfoEnum_AddRef(IEnumTfDisplayAttributeInfo *iface)
 {
     return InterlockedIncrement(&impl_from_IEnumTfDisplayAttributeInfo(iface)->ref);
 }
 
-static ULONG WINAPI EmptyEnum_Release(IEnumTfDisplayAttributeInfo *iface)
+static ULONG WINAPI InfoEnum_Release(IEnumTfDisplayAttributeInfo *iface)
 {
-    EmptyEnumInfo *This = impl_from_IEnumTfDisplayAttributeInfo(iface);
-    ULONG ref = InterlockedDecrement(&This->ref);
-    if (!ref) free(This);
+    InfoEnum *This = impl_from_IEnumTfDisplayAttributeInfo(iface);
+    ULONG ref = InterlockedDecrement(&This->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) ITfDisplayAttributeInfo_Release(This->infos[i]);
+        free(This->infos);
+        free(This);
+    }
     return ref;
 }
 
-static HRESULT empty_enum_create(IEnumTfDisplayAttributeInfo **out);
+static HRESULT info_enum_create(ITfDisplayAttributeInfo **infos, ULONG count, ULONG pos, IEnumTfDisplayAttributeInfo **out);
 
-static HRESULT WINAPI EmptyEnum_Clone(IEnumTfDisplayAttributeInfo *iface, IEnumTfDisplayAttributeInfo **out)
+static HRESULT WINAPI InfoEnum_Clone(IEnumTfDisplayAttributeInfo *iface, IEnumTfDisplayAttributeInfo **out)
 {
+    InfoEnum *This = impl_from_IEnumTfDisplayAttributeInfo(iface);
+
     if (!out) return E_INVALIDARG;
-    return empty_enum_create(out);
+    return info_enum_create(This->infos, This->count, This->pos, out);
 }
 
-static HRESULT WINAPI EmptyEnum_Next(IEnumTfDisplayAttributeInfo *iface, ULONG count, ITfDisplayAttributeInfo **info,
+static HRESULT WINAPI InfoEnum_Next(IEnumTfDisplayAttributeInfo *iface, ULONG count, ITfDisplayAttributeInfo **info,
         ULONG *fetched)
 {
+    InfoEnum *This = impl_from_IEnumTfDisplayAttributeInfo(iface);
+    ULONG n = 0;
+
     if (!info || (!fetched && count != 1)) return E_INVALIDARG;
-    if (fetched) *fetched = 0;
-    return count ? S_FALSE : S_OK;
+    while (n < count && This->pos < This->count)
+    {
+        info[n] = This->infos[This->pos++];
+        ITfDisplayAttributeInfo_AddRef(info[n++]);
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
 }
 
-static HRESULT WINAPI EmptyEnum_Reset(IEnumTfDisplayAttributeInfo *iface)
+static HRESULT WINAPI InfoEnum_Reset(IEnumTfDisplayAttributeInfo *iface)
 {
+    impl_from_IEnumTfDisplayAttributeInfo(iface)->pos = 0;
     return S_OK;
 }
 
-static HRESULT WINAPI EmptyEnum_Skip(IEnumTfDisplayAttributeInfo *iface, ULONG count)
+static HRESULT WINAPI InfoEnum_Skip(IEnumTfDisplayAttributeInfo *iface, ULONG count)
 {
-    return count ? S_FALSE : S_OK;
+    InfoEnum *This = impl_from_IEnumTfDisplayAttributeInfo(iface);
+
+    if (count > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
 }
 
-static const IEnumTfDisplayAttributeInfoVtbl EmptyEnumVtbl =
+static const IEnumTfDisplayAttributeInfoVtbl InfoEnumVtbl =
 {
-    EmptyEnum_QueryInterface,
-    EmptyEnum_AddRef,
-    EmptyEnum_Release,
-    EmptyEnum_Clone,
-    EmptyEnum_Next,
-    EmptyEnum_Reset,
-    EmptyEnum_Skip
+    InfoEnum_QueryInterface,
+    InfoEnum_AddRef,
+    InfoEnum_Release,
+    InfoEnum_Clone,
+    InfoEnum_Next,
+    InfoEnum_Reset,
+    InfoEnum_Skip
 };
 
-static HRESULT empty_enum_create(IEnumTfDisplayAttributeInfo **out)
+static HRESULT info_enum_create(ITfDisplayAttributeInfo **infos, ULONG count, ULONG pos, IEnumTfDisplayAttributeInfo **out)
 {
-    EmptyEnumInfo *e = calloc(1, sizeof(*e));
+    InfoEnum *e = calloc(1, sizeof(*e));
+    ULONG i;
 
     if (!e) return E_OUTOFMEMORY;
-    e->IEnumTfDisplayAttributeInfo_iface.lpVtbl = &EmptyEnumVtbl;
+    if (count && !(e->infos = calloc(count, sizeof(*infos))))
+    {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        e->infos[i] = infos[i];
+        ITfDisplayAttributeInfo_AddRef(infos[i]);
+    }
+    e->IEnumTfDisplayAttributeInfo_iface.lpVtbl = &InfoEnumVtbl;
     e->ref = 1;
+    e->count = count;
+    e->pos = pos;
     *out = &e->IEnumTfDisplayAttributeInfo_iface;
     return S_OK;
 }
@@ -219,33 +293,78 @@ static HRESULT empty_enum_create(IEnumTfDisplayAttributeInfo **out)
 static HRESULT WINAPI DisplayAttributeMgr_EnumDisplayAttributeInfo(ITfDisplayAttributeMgr *iface, IEnumTfDisplayAttributeInfo **ppEnum)
 {
     DisplayAttributeMgr *This = impl_from_ITfDisplayAttributeMgr(iface);
+    struct provider *provs;
+    ITfDisplayAttributeInfo **infos = NULL;
+    ULONG nprovs, count = 0, cap = 0, i;
+    HRESULT hr;
 
     TRACE("(%p) %p\n", This, ppEnum);
 
     if (!ppEnum) return E_INVALIDARG;
     *ppEnum = NULL;
-#ifdef SG_MUTANT_MSCTFB1_DISPATTR
+#ifdef SG_MUTANT_MSCTFB2_DAENUM
     return E_FAIL;
 #endif
-    if (have_providers())
+    if (FAILED(hr = get_providers(&provs, &nprovs))) return hr;
+    for (i = 0; i < nprovs; i++)
     {
-        FIXME("display attribute providers are registered but cannot be queried\n");
-        return E_FAIL;
+        IEnumTfDisplayAttributeInfo *pe;
+        ITfDisplayAttributeInfo *info;
+        ULONG fetched;
+
+        if (FAILED(ITfDisplayAttributeProvider_EnumDisplayAttributeInfo(provs[i].prov, &pe))) continue;
+        while (IEnumTfDisplayAttributeInfo_Next(pe, 1, &info, &fetched) == S_OK && fetched)
+        {
+            if (count == cap)
+            {
+                ITfDisplayAttributeInfo **n = realloc(infos, (cap ? cap * 2 : 8) * sizeof(*infos));
+                if (!n)
+                {
+                    ITfDisplayAttributeInfo_Release(info);
+                    continue;
+                }
+                infos = n;
+                cap = cap ? cap * 2 : 8;
+            }
+            infos[count++] = info;
+        }
+        IEnumTfDisplayAttributeInfo_Release(pe);
     }
-    return empty_enum_create(ppEnum);
+    free_providers(provs, nprovs);
+    hr = info_enum_create(infos, count, 0, ppEnum);
+    for (i = 0; i < count; i++) ITfDisplayAttributeInfo_Release(infos[i]);
+    free(infos);
+    return hr;
 }
 
 static HRESULT WINAPI DisplayAttributeMgr_GetDisplayAttributeInfo(ITfDisplayAttributeMgr *iface, REFGUID guid, ITfDisplayAttributeInfo **ppInfo, CLSID *pclsidOwner)
 {
     DisplayAttributeMgr *This = impl_from_ITfDisplayAttributeMgr(iface);
+    struct provider *provs;
+    ULONG nprovs, i;
+    HRESULT hr = E_FAIL;
 
     TRACE("(%p) %s %p %p\n", This, debugstr_guid(guid), ppInfo, pclsidOwner);
 
     if (!guid || !ppInfo) return E_INVALIDARG;
     *ppInfo = NULL;
     if (pclsidOwner) *pclsidOwner = GUID_NULL;
-    if (have_providers()) FIXME("display attribute providers are registered but cannot be queried\n");
-    return E_FAIL;      /* no provider has the attribute */
+    if (FAILED(get_providers(&provs, &nprovs))) return E_FAIL;
+#ifdef SG_MUTANT_MSCTFB2_DAGET
+    nprovs = 0;
+#endif
+    for (i = 0; i < nprovs; i++)
+    {
+        if (SUCCEEDED(ITfDisplayAttributeProvider_GetDisplayAttributeInfo(provs[i].prov, guid, ppInfo)) && *ppInfo)
+        {
+            if (pclsidOwner) *pclsidOwner = provs[i].clsid;
+            hr = S_OK;
+            break;
+        }
+        *ppInfo = NULL;
+    }
+    free_providers(provs, nprovs);
+    return hr;      /* E_FAIL: no provider has the attribute */
 }
 
 static const ITfDisplayAttributeMgrVtbl DisplayAttributeMgrVtbl =
