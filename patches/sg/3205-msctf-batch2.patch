From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 21:59:42 -0700
Subject: [PATCH] msctf: display attribute providers, notify sinks, composing
 property, cleanup sinks (3205)

ITfDisplayAttributeProvider, ITfDisplayAttributeNotifySink,
ITfPreservedKeyNotifySink and ITfCleanupContextDurationSink added to
msctf.idl (identifiers and method order from windows-rs 0.62.2, MIT). The
display attribute manager asks registered providers; the thread manager takes
the two notify sinks; contexts take cleanup duration sinks; compositions
mark their text with GUID_PROP_COMPOSING.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/msctf/composition.c b/dlls/msctf/composition.c
index 5cd15d8..a4b157a 100644
--- a/dlls/msctf/composition.c
+++ b/dlls/msctf/composition.c
@@ -23,8 +23,9 @@
  * (ITfContextComposition / ITfContextOwnerCompositionServices); a text service
  * holds the ITfComposition, the context owner and enumerations the
  * ITfCompositionView. The span keeps character positions (like ranges in this
- * implementation). The GUID_PROP_COMPOSING property is not set on the text:
- * the property's identifier is not published in a source we may use. */
+ * implementation). The text of a live composition carries the
+ * GUID_PROP_COMPOSING property (VT_I4 1); its identifier is from windows-rs
+ * 0.62.2 (MIT licence), module Win32::UI::TextServices. */
 
 #include <stdarg.h>
 
@@ -43,6 +44,36 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(msctf);
 
+static const GUID sg_prop_composing =
+    { 0xe12ac060, 0xaf15, 0x11d2, { 0xaf, 0xc5, 0x00, 0x10, 0x5a, 0x27, 0x99, 0xb5 } };
+
+/* marks (or unmarks) the text of a composition with GUID_PROP_COMPOSING */
+static void mark_composing(ITfContext *ctx, TfEditCookie ec, LONG start, LONG end, BOOL on)
+{
+    ITfProperty *prop;
+    ITfRange *range;
+    VARIANT v;
+
+#ifdef SG_MUTANT_MSCTFB2_NOMARK
+    return;
+#endif
+    if (!ctx || FAILED(ITfContext_GetProperty(ctx, &sg_prop_composing, &prop))) return;
+    if (SUCCEEDED(Range_Constructor(ctx, start, end, &range)))
+    {
+        if (on)
+        {
+            VariantInit(&v);
+            V_VT(&v) = VT_I4;
+            V_I4(&v) = 1;
+            ITfProperty_SetValue(prop, ec, range, &v);
+        }
+        else
+            ITfProperty_Clear(prop, ec, range);
+        ITfRange_Release(range);
+    }
+    ITfProperty_Release(prop);
+}
+
 struct composition
 {
     ITfComposition ITfComposition_iface;
@@ -137,17 +168,23 @@ static HRESULT shift_anchor(struct composition *This, TfEditCookie ec, ITfRange
     if (FAILED(Range_GetAnchors(range, &a, &b))) return E_INVALIDARG;
     lo = min(a, b);
     hi = max(a, b);
-    if (start)
     {
-        /* the new start is the start anchor of the range; it may not pass the end */
-        if (lo > This->end) return E_INVALIDARG;
-        This->start = lo;
-    }
-    else
-    {
-        /* the new end is the end anchor of the range; it may not pass before the start */
-        if (hi < This->start) return E_INVALIDARG;
-        This->end = hi;
+        LONG old_start = This->start, old_end = This->end;
+
+        if (start)
+        {
+            /* the new start is the start anchor of the range; it may not pass the end */
+            if (lo > This->end) return E_INVALIDARG;
+            This->start = lo;
+        }
+        else
+        {
+            /* the new end is the end anchor of the range; it may not pass before the start */
+            if (hi < This->start) return E_INVALIDARG;
+            This->end = hi;
+        }
+        mark_composing(This->context, ec, old_start, old_end, FALSE);
+        mark_composing(This->context, ec, This->start, This->end, TRUE);
     }
     owner_update(This, range);
     return S_OK;
@@ -264,6 +301,7 @@ static void terminate(struct composition *This, TfEditCookie ec, BOOL notify_sin
     ITfContextOwnerCompositionSink *owner;
 
     if (!set) return;
+    mark_composing(This->context, ec, This->start, This->end, FALSE);
     This->set = NULL;
     list_remove(&This->entry);
 #ifndef SG_MUTANT_MSCTFB1_COMPEND
@@ -356,6 +394,7 @@ HRESULT CompositionSet_Start(struct composition_set *set, TfClientId tid, TfEdit
         return S_OK;
     }
     list_add_tail(&set->list, &c->entry);
+    mark_composing(set->context, ec, c->start, c->end, TRUE);
     *out = &c->ITfComposition_iface;
     return S_OK;
 }
diff --git a/dlls/msctf/context.c b/dlls/msctf/context.c
index 193ed9e..a195b26 100644
--- a/dlls/msctf/context.c
+++ b/dlls/msctf/context.c
@@ -1507,9 +1507,9 @@ static HRESULT WINAPI SourceSingle_AdviseSingleSink( ITfSourceSingle *iface,
     TRACE("(%p) %li %s %p\n",This, tid, debugstr_guid(riid),punk);
 
     if (!riid || !punk) return E_INVALIDARG;
-    /* a context takes function providers; ITfCleanupContextDurationSink has no
-     * definition here, so it cannot be told apart */
-    if (!IsEqualIID(riid, &IID_ITfFunctionProvider)) return CONNECT_E_CANNOTCONNECT;
+    /* a context takes function providers and cleanup duration sinks */
