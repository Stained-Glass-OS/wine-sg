From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dmime: Unknown PlaySegmentEx flags are a WARN.

The other queued dmime functions return what the dmime tests expect.
---
 dlls/dmime/performance.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/dlls/dmime/performance.c b/dlls/dmime/performance.c
index 5bab87a..8092eee 100644
--- a/dlls/dmime/performance.c
+++ b/dlls/dmime/performance.c
@@ -2337,7 +2337,8 @@ static HRESULT WINAPI performance_PlaySegmentEx(IDirectMusicPerformance8 *iface,
     TRACE("(%p, %p, %s, %p, %#lx, %I64d, %p, %p, %p)\n", This, source, debugstr_w(segment_name),
             transition, segment_flags, start_time, segment_state, from, audio_path);
 
-    if (segment_flags & ~handled_flags) FIXME("flags %#lx not implemented\n", segment_flags & ~handled_flags);
+    /* every documented DMUS_SEGF flag is handled, the others are ignored */
+    if (segment_flags & ~handled_flags) WARN("unknown flags %#lx\n", segment_flags & ~handled_flags);
 
     if (!source) return E_POINTER;
     if (!This->dmusic) return DMUS_E_NO_MASTER_CLOCK;
