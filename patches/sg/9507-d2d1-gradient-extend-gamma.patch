         "}\n"
         "\n"
         "float4 brush_radial(struct brush brush, Buffer<float4> gradient, float2 position)\n"
@@ -5372,7 +5406,7 @@
         "    c = dot(v_q, v_q) - 1.0;\n"
         "    t = -b + sqrt(b * b - c);\n"
         "\n"
-        "    return sample_gradient(gradient, stop_count, l / t);\n"
