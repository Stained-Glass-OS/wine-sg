From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: gradient extend modes and gamma

A gradient stop collection's extend mode and gamma were ignored ('Ignoring extend mode', 'Ignoring gamma'): WRAP and MIRROR gradients were drawn as CLAMP, D2D1_GAMMA_1_0 ones interpolated in sRGB. The brush constants now carry the gradient's flags and the pixel shader extends the position before it finds the stops (WRAP: its fraction; MIRROR: reversed every other length) for linear and radial brushes, and for D2D1_GAMMA_1_0 (a pre-interpolation space of scRGB) converts the stop colours to linear light, interpolates there and converts the result back to sRGB.
---
--- a/dlls/d2d1/brush.c
+++ b/dlls/d2d1/brush.c
@@ -165,6 +165,24 @@
     d2d_gradient_GetColorInterpolationMode,
 };
 
+/* wine-sg 9507: a gradient's extend mode (WRAP repeats it beyond its ends, MIRROR repeats it reversed every
+ * other time; CLAMP keeps the end colours) and, for D2D1_GAMMA_1_0 -- or a pre-interpolation space of
+ * scRGB -- interpolation of the stop colours in linear light, the result back in sRGB */
+unsigned int d2d_gradient_flags(const struct d2d_gradient *gradient)
+{
+    unsigned int flags = 0;
+
+#ifndef SG_MUTANT_D2D_GRADIENT_CLAMP_ONLY
+    if (gradient->extend_mode == D2D1_EXTEND_MODE_WRAP || gradient->extend_mode == D2D1_EXTEND_MODE_MIRROR)
+        flags = gradient->extend_mode;
+#endif
+#ifndef SG_MUTANT_D2D_GRADIENT_GAMMA_22
+    if (gradient->preinterpolation_space == D2D1_COLOR_SPACE_SCRGB)
+        flags |= D2D_GRADIENT_FLAG_LINEAR_LIGHT;
+#endif
+    return flags;
+}
+
 HRESULT d2d_gradient_create(ID2D1Factory *factory, ID3D11Device1 *device, const D2D1_GRADIENT_STOP *stops,
         UINT32 stop_count, D2D1_GAMMA gamma, D2D1_EXTEND_MODE extend_mode, struct d2d_gradient **out)
 {
@@ -231,10 +249,6 @@
         return E_OUTOFMEMORY;
     }
 
-    if (gamma != D2D1_GAMMA_2_2)
-        FIXME("Ignoring gamma %#x.\n", gamma);
-    if (extend_mode != D2D1_EXTEND_MODE_CLAMP)
-        FIXME("Ignoring extend mode %#x.\n", extend_mode);
 
     gradient->ID2D1GradientStopCollection_iface.lpVtbl = (const ID2D1GradientStopCollectionVtbl *)&d2d_gradient_vtbl;
     gradient->refcount = 1;
@@ -1450,6 +1464,7 @@
             d2d_point_transform(&cb->u.linear.start, &b, brush->u.linear.start.x, brush->u.linear.start.y);
             d2d_point_transform(&cb->u.linear.end, &b, brush->u.linear.end.x, brush->u.linear.end.y);
             cb->u.linear.stop_count = brush->u.linear.gradient->stop_count;
+            cb->u.linear.flags = d2d_gradient_flags(brush->u.linear.gradient);
 
             return TRUE;
 
@@ -1492,6 +1507,7 @@
             d2d_point_set(&cb->u.radial.rb, t * -sin_theta, t * cos_theta);
 
             cb->u.radial.stop_count = brush->u.linear.gradient->stop_count;
+            cb->u.radial.flags = d2d_gradient_flags(brush->u.radial.gradient);
 
             return TRUE;
 
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -98,6 +98,7 @@
             D2D1_POINT_2F start;
             D2D1_POINT_2F end;
             unsigned int stop_count;
+            unsigned int flags; /* d2d_gradient_flags (wine-sg 9507) */
         } linear;
         struct
         {
@@ -106,7 +107,8 @@
             D2D1_POINT_2F ra;
             D2D1_POINT_2F rb;
             unsigned int stop_count;
-            float pad[3];
+            unsigned int flags;
+            float pad[2];
         } radial;
         struct
         {
@@ -347,6 +349,9 @@
     D2D1_COLOR_INTERPOLATION_MODE color_interpolation_mode;
 };
 
+/* wine-sg 9507: how the shader reads a gradient: the extend mode in the low byte, linear-light interpolation */
+#define D2D_GRADIENT_FLAG_LINEAR_LIGHT 0x100
+unsigned int d2d_gradient_flags(const struct d2d_gradient *gradient);
 HRESULT d2d_gradient_create(ID2D1Factory *factory, ID3D11Device1 *device, const D2D1_GRADIENT_STOP *stops,
         UINT32 stop_count, D2D1_GAMMA gamma, D2D1_EXTEND_MODE extend_mode,
         struct d2d_gradient **gradient);
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -5297,33 +5297,67 @@
         "    nointerpolation float2x2 stroke_transform : STROKE_TRANSFORM;\n"
         "};\n"
         "\n"
-        "float4 sample_gradient(Buffer<float4> gradient, uint stop_count, float position)\n"
+        /* wine-sg 9507: flags: the extend mode (1 wrap, 2 mirror) in the low byte, 0x100 linear light */
+        "float3 srgb_to_linear(float3 c)\n"
         "{\n"
-        "    float4 c_low, c_high;\n"
-        "    float p_low, p_high;\n"
-        "    uint i;\n"
+        "    return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4);\n"
+        "}\n"
         "\n"
-        "    p_low = gradient.Load(0).x;\n"
-        "    c_low = gradient.Load(1);\n"
-        "    c_high = c_low;\n"
+        "float3 linear_to_srgb(float3 c)\n"
+        "{\n"
+        "    return c <= 0.0031308 ? c * 12.92 : 1.055 * pow(c, 1.0 / 2.4) - 0.055;\n"
+        "}\n"
         "\n"
-        "    if (position < p_low)\n"
-        "        return c_low;\n"
+        "float4 gradient_colour(float4 c, uint flags)\n"
+        "{\n"
+        "    if (flags & 0x100)\n"
+        "        c.rgb = srgb_to_linear(c.rgb);\n"
+        "    return c;\n"
+        "}\n"
         "\n"
-        "    for (i = 1; i < stop_count; ++i)\n"
+        "float4 sample_gradient_flags(Buffer<float4> gradient, uint stop_count, float position, uint flags)\n"
+        "{\n"
+        "    float4 c_low, c_high, c;\n"
+        "    float p_low, p_high, t;\n"
+        "    uint i;\n"
+        "\n"
+        "    if ((flags & 0xff) == 1)\n"
+        "        position = position - floor(position);\n"
+        "    else if ((flags & 0xff) == 2)\n"
         "    {\n"
-        "        p_high = gradient.Load(i * 2).x;\n"
-        "        c_high = gradient.Load(i * 2 + 1);\n"
+        "        t = position - 2.0 * floor(position * 0.5);\n"
+        "        position = t > 1.0 ? 2.0 - t : t;\n"
+        "    }\n"
         "\n"
-        "        if (position >= p_low && position <= p_high)\n"
-        "            return lerp(c_low, c_high, (position - p_low) / (p_high - p_low));\n"
+        "    p_low = gradient.Load(0).x;\n"
+        "    c_low = gradient_colour(gradient.Load(1), flags);\n"
+        "    c_high = c_low;\n"
+        "    c = c_low;\n"
         "\n"
-        "        p_low = p_high;\n"
-        "        c_low = c_high;\n"
+        "    if (position >= p_low)\n"
+        "    {\n"
+        "        for (i = 1; i < stop_count; ++i)\n"
+        "        {\n"
+        "            p_high = gradient.Load(i * 2).x;\n"
+        "            c_high = gradient_colour(gradient.Load(i * 2 + 1), flags);\n"
+        "\n"
+        "            if (position >= p_low && position <= p_high)\n"
+        "                break;\n"
+        "\n"
+        "            p_low = p_high;\n"
+        "            c_low = c_high;\n"
+        "        }\n"
+        "        if (i < stop_count)\n"
+        "            c = lerp(c_low, c_high, (position - p_low) / (p_high - p_low));\n"
+        "        else\n"
+        "            c = c_high;\n"
         "    }\n"
         "\n"
-        "    return c_high;\n"
+        "    if (flags & 0x100)\n"
+        "        c.rgb = linear_to_srgb(saturate(c.rgb));\n"
+        "    return c;\n"
         "}\n"
+
         "\n"
         "float4 brush_linear(struct brush brush, Buffer<float4> gradient, float2 position)\n"
         "{\n"
@@ -5339,7 +5373,7 @@
         "    v_q = end - start;\n"
         "    p = dot(v_q, v_p) / dot(v_q, v_q);\n"
