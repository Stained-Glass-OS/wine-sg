From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wtsapi32: The session thread keeps the library loaded (6531)

The thread that follows the session for WTSRegisterSessionNotification
(1704) ran without a reference to wtsapi32. It retries every 5 seconds
while no compositor answers, and stays while anyone is registered. A
program that loads wtsapi32, registers a window, unregisters it and frees
the library had the thread wake up in unloaded code. MPC-HC 2.8.4 crashed
that way at its first start. The thread now takes a reference when it is
created and drops it with FreeLibraryAndExitThread.
---
diff --git a/dlls/wtsapi32/wtsapi32.c b/dlls/wtsapi32/wtsapi32.c
index 4d4a5cd..04c9ccd 100644
--- a/dlls/wtsapi32/wtsapi32.c
+++ b/dlls/wtsapi32/wtsapi32.c
@@ -155,6 +155,8 @@ static BOOL have_registrations(void)
     return ret;
 }
 
+static HMODULE session_module;
+
 static DWORD WINAPI session_thread_proc( void *arg )
 {
     HANDLE ready = arg;
@@ -188,7 +190,8 @@ static DWORD WINAPI session_thread_proc( void *arg )
                 CloseHandle( session_thread );
                 session_thread = NULL;
                 LeaveCriticalSection( &session_cs );
-                return 0;
+                /* (wine-sg 6531) the reference its creator took for it */
+                FreeLibraryAndExitThread( session_module, 0 );
             }
             LeaveCriticalSection( &session_cs );
         }
@@ -226,8 +229,18 @@ static BOOL register_session_notification( HWND hwnd, DWORD flags )
     list_add_tail( &session_registrations, &reg->entry );
     if (!session_thread && unix_ready)
     {
+        /* Stained Glass OS (wine-sg 6531): the thread keeps the library loaded while it runs: a
+         * program that registers, unregisters and frees wtsapi32 (MPC-HC) had it wake up in
+         * unloaded code */
+#ifndef SG_MUTANT_WTS_NO_MODULE_REF
+        GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, (const WCHAR *)session_thread_proc, &session_module );
+#endif
         ready = CreateEventW( NULL, TRUE, FALSE, NULL );
-        session_thread = CreateThread( NULL, 0, session_thread_proc, ready, 0, NULL );
+        if (!(session_thread = CreateThread( NULL, 0, session_thread_proc, ready, 0, NULL )) && session_module)
+        {
+            FreeLibrary( session_module );
+            session_module = NULL;
+        }
     }
     LeaveCriticalSection( &session_cs );
 
