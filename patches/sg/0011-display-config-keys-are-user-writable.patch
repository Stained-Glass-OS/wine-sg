From: Stained Glass OS <dev@stained-glass.example>
Subject: Let interactive users write the display-config registry subtree

HKLM\System\CurrentControlSet\Control\Video and \GraphicsDrivers hold the
adapters, monitors and modes Wine's display setup discovers. On Windows the
per-session display driver, running with the session's access, owns this; it
is scratch rebuilt every boot, not protected machine policy.

In a shared system prefix (patches 0001-0002) HKLM is administrators-write,
users-read. That is right for real machine policy and wrong here: every
interactive user's win32u must write this subtree during display init, and
every application reads it back to find a graphics driver. Under the read-only
default, a non-admin session comes up with a working shell -- the driver host
needs no registry -- and then no application can launch, because
update_display_cache reads an empty display config and reports
"Failed to read display config", surfacing as "no driver could be loaded".
It only shows in a real multi-user image: on a developer box the interactive
user owns the prefix and so is an administrator, and the writes always land.

Keys under these two paths therefore get a DACL that grants Local System,
administrators AND ordinary users full access. Detection is by the key's full
name; the permissive DACL replaces the read-only default only for this
subtree, so the rest of HKLM is unchanged.

The container keys still have to exist for a user to create beneath them, and
a non-admin cannot create them under the administrator-owned Control key.
sg-prefix-init creates Control\Video and Control\GraphicsDrivers once, as the
prefix owner; with this patch they then carry the user-writable DACL.

Forwarded: not-needed
--- a/server/registry.c
+++ b/server/registry.c
@@ -467,6 +467,43 @@
     return key_default_sd;
 }
 
+/* Stained Glass OS: keys that hold per-session display configuration.
+ *
+ * HKLM\...\Control\Video and \Control\GraphicsDrivers are where Wine's
+ * display setup records the adapters, monitors and modes it found. On Windows
+ * the per-session display driver -- running with the session's access -- owns
+ * this; it is scratch state rebuilt every boot, not protected machine policy.
+ *
+ * In a shared prefix every interactive user's win32u must write here during
+ * display init, and every app reads it back to find a driver. Under the plain
+ * HKLM arrangement (admins write, users read) only the first, and only if an
+ * admin, can populate it -- so a non-admin session comes up with a working
+ * shell (the driver host needs no registry) and no app can launch, because it
+ * reads an empty display config. These keys therefore grant interactive users
+ * write, unlike the rest of HKLM. */
+static int sg_is_display_config_name( const WCHAR *name, data_size_t len )
+{
+    static const WCHAR videoW[] = {'\\','C','o','n','t','r','o','l','\\','V','i','d','e','o'};
+    static const WCHAR gfxW[]   = {'\\','C','o','n','t','r','o','l','\\','G','r','a','p','h','i','c','s','D','r','i','v','e','r','s'};
+    data_size_t chars = len / sizeof(WCHAR), i;
+
+    for (i = 0; i + ARRAY_SIZE(videoW) <= chars; i++)
+    {
+        if (!memicmp_strW( name + i, videoW, sizeof(videoW) )) return 1;
+        if (i + ARRAY_SIZE(gfxW) <= chars && !memicmp_strW( name + i, gfxW, sizeof(gfxW) )) return 1;
+    }
+    return 0;
+}
+
+static int sg_is_display_config_key( struct object *obj )
+{
+    data_size_t len = 0;
+    WCHAR *name = obj->ops->get_full_name( obj, &len );
+    int ret = name && sg_is_display_config_name( name, len );
+    free( name );
+    return ret;
+}
+
 static WCHAR *key_get_full_name( struct object *obj, data_size_t *ret_len )
 {
     struct key *key = (struct key *) obj;
@@ -894,6 +931,10 @@
                                         OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION |
                                         DACL_SECURITY_INFORMATION,
                                         current->process->token );
+            /* Display-config keys are session scratch, not machine policy:
+             * replace the "users read" DACL with one they can write. */
+            if (sg_is_display_config_key( &key->obj ))
+                sg_make_key_user_writable( &key->obj );
         }
         if (parent) touch_key( get_parent( key ), REG_NOTIFY_CHANGE_NAME );
         if (debug_level > 1) dump_operation( key, NULL, "Create" );
--- a/server/token.c
+++ b/server/token.c
@@ -859,6 +859,59 @@
     return dacl;
 }
 
+/* Stained Glass OS: the DACL for per-session display-config keys.
+ *
+ * Local System, administrators and -- unlike the HKLM default -- ordinary
+ * users all get full access. HKLM\...\Control\Video and \GraphicsDrivers are
+ * scratch that every interactive session writes and every app reads; see the
+ * note in registry.c's sg_is_display_config_name. */
+static struct acl *sg_create_display_dacl(void)
+{
+    struct sid alias_admins_sid = { SID_REVISION, 2, SECURITY_NT_AUTHORITY, { SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS }};
+    struct ace *ace;
+    struct acl *dacl;
+    size_t size = sizeof(*dacl) + 3 * sizeof(*ace) +
+                  sid_len( &local_system_sid ) + sid_len( &alias_admins_sid ) + sid_len( &domain_users_sid );
+
+    if (!(dacl = mem_alloc( size ))) return NULL;
+    dacl->revision = ACL_REVISION;
+    dacl->pad1 = 0;
+    dacl->size = size;
+    dacl->count = 3;
+    dacl->pad2 = 0;
+    ace = set_ace( ace_first( dacl ), &local_system_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
+    ace = set_ace( ace_next( ace ), &alias_admins_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
+    set_ace( ace_next( ace ), &domain_users_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
+    return dacl;
+}
+
+/* Give an object the display-config DACL, keeping its owner and group. */
+void sg_make_key_user_writable( struct object *obj )
+{
+    struct acl *dacl = sg_create_display_dacl();
+    struct security_descriptor *sd;
+    size_t dacl_size;
+    char *ptr;
+
+    if (!dacl) return;
+    dacl_size = dacl->size;
+    if ((sd = mem_alloc( sizeof(*sd) + dacl_size )))
+    {
+        sd->control  = SE_DACL_PRESENT;
+        sd->owner_len = 0;
+        sd->group_len = 0;
+        sd->sacl_len = 0;
+        sd->dacl_len = dacl_size;
+        ptr = (char *)(sd + 1);
+        memcpy( ptr, dacl, dacl_size );
+        /* Keep owner/group from the token; replace only the DACL. */
+        set_sd_defaults_from_token( obj, sd, DACL_SECURITY_INFORMATION,
+                                    current ? current->process->token : NULL );
+        free( sd );
+    }
+    free( dacl );
+}
+
 struct token *token_create_admin( unsigned primary, int impersonation_level, int elevation, unsigned int session_id )
 {
     struct token *token = NULL;
