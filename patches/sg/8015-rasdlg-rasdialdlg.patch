From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rasdlg: RasDialDlgA and RasDialDlgW

Spec stubs before (mRemoteNG's delay import, its RAS connections). RasDialDlg dials the phone-book entry it names with the credentials stored for it (RasGetEntryDialParams; a number given replaces the entry's) and returns when the connection is up, TRUE, or has failed, FALSE with the RAS error in dwError -- RAS dials the NetworkManager VPNs synchronously (sg-netctl), so no progress dialog is shown. A structure of another size is ERROR_INVALID_SIZE, no entry ERROR_INVALID_PARAMETER, an unknown one ERROR_CANNOT_FIND_PHONEBOOK_ENTRY. rasdlg.h: RASDIALDLG, the RASDDFLAG_ values and prototypes, and the structures are 4-byte packed as in Windows' header (RASENTRYDLGW's hwndOwner was 8-aligned).
---
--- a/include/rasdlg.h
+++ b/include/rasdlg.h
@@ -21,6 +21,8 @@
 
 #include <ras.h>
 
+#include <pshpack4.h>
+
 typedef struct tagRASENTRYDLGW
 {
     DWORD dwSize;
@@ -34,4 +36,35 @@
     ULONG_PTR reserved2;
 } RASENTRYDLGW;
 
+typedef struct tagRASDIALDLG
+{
+    DWORD     dwSize;
+    HWND      hwndOwner;
+    DWORD     dwFlags;
+    LONG      xDlg;
+    LONG      yDlg;
+    DWORD     dwSubEntry;
+    DWORD     dwError;
+    ULONG_PTR reserved;
+    ULONG_PTR reserved2;
+} RASDIALDLG, *LPRASDIALDLG;
+
+#define RASDDFLAG_PositionDlg 0x00000001
+#define RASDDFLAG_NoPrompt    0x00000002
+#define RASDDFLAG_LinkFailure 0x80000000
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+BOOL WINAPI RasDialDlgA(LPSTR,LPSTR,LPSTR,LPRASDIALDLG);
+BOOL WINAPI RasDialDlgW(LPWSTR,LPWSTR,LPWSTR,LPRASDIALDLG);
+BOOL WINAPI RasEntryDlgW(LPWSTR,LPWSTR,RASENTRYDLGW *);
+
+#ifdef __cplusplus
+}
+#endif
+
+#include <poppack.h>
+
 #endif  /* _RASDLG_H_ */
