 #include "rasdlg.h"
 
 #include "wine/debug.h"
@@ -32,3 +36,80 @@
     FIXME("(%s %s %p) stub\n", debugstr_w(phonebook), debugstr_w(entry), lpInfo);
     return FALSE;
 }
+
+/* Stained Glass OS (wine-sg 8015): RasDialDlg dials the phone-book entry it names with the credentials
+ * stored for it (RasGetEntryDialParams) and returns once the connection is up (TRUE) or has failed
+ * (FALSE, the RAS error in dwError) -- RAS here dials the NetworkManager VPNs synchronously, so there is
+ * no progress to show. An entry that does not exist is ERROR_CANNOT_FIND_PHONEBOOK_ENTRY; a structure
+ * of another size ERROR_INVALID_SIZE; no entry at all ERROR_INVALID_PARAMETER (Windows then shows the
+ * phone book, which RasPhonebookDlg would). */
+BOOL WINAPI RasDialDlgW(LPWSTR phonebook, LPWSTR entry, LPWSTR number, LPRASDIALDLG info)
+{
+    RASDIALPARAMSW params;
+    HRASCONN conn = NULL;
+    BOOL password;
+    DWORD ret;
+
+    TRACE("(%s %s %s %p)\n", debugstr_w(phonebook), debugstr_w(entry), debugstr_w(number), info);
+
+    if (!info)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (info->dwSize != sizeof(*info))
+    {
+        info->dwError = ERROR_INVALID_SIZE;
+        return FALSE;
+    }
+    info->dwError = 0;
+    if (!entry || !entry[0])
+    {
+        info->dwError = ERROR_INVALID_PARAMETER;
+        return FALSE;
+    }
+
+    memset(&params, 0, sizeof(params));
+    params.dwSize = sizeof(params);
+    lstrcpynW(params.szEntryName, entry, ARRAY_SIZE(params.szEntryName));
+    if ((ret = RasGetEntryDialParamsW(phonebook, &params, &password)))
+    {
+        info->dwError = ret;
+        return FALSE;
+    }
+    if (number) lstrcpynW(params.szPhoneNumber, number, ARRAY_SIZE(params.szPhoneNumber));
+    params.dwSubEntry = info->dwSubEntry;
+    ret = RasDialW(NULL, phonebook, &params, 0, NULL, &conn);
+    SecureZeroMemory(params.szPassword, sizeof(params.szPassword));
+    if (ret)
+    {
+        if (conn) RasHangUpW(conn);
+#ifndef SG_MUTANT_NO_RASDIALDLG
+        info->dwError = ret;
+#endif
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static WCHAR *strdupAW(const char *str)
+{
+    WCHAR *ret;
+    int len;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar(CP_ACP, 0, str, -1, NULL, 0);
+    if ((ret = malloc(len * sizeof(WCHAR)))) MultiByteToWideChar(CP_ACP, 0, str, -1, ret, len);
+    return ret;
+}
+
+BOOL WINAPI RasDialDlgA(LPSTR phonebook, LPSTR entry, LPSTR number, LPRASDIALDLG info)
+{
+    WCHAR *pbkW = strdupAW(phonebook), *entryW = strdupAW(entry), *numberW = strdupAW(number);
+    BOOL ret = RasDialDlgW(pbkW, entryW, numberW, info);
+
+    free(pbkW);
+    free(entryW);
+    free(numberW);
+    return ret;
+}
