+/* "hh:mm" or "hh:mm:ss" to the parts, or now */
+static BOOL parse_time( const WCHAR *text, int *h, int *m, int *s )
+{
+    *s = 0;
+    if (!text) { SYSTEMTIME now; GetLocalTime( &now ); *h = now.wHour; *m = now.wMinute; return TRUE; }
+    if (swscanf( text, L"%d:%d:%d", h, m, s ) < 2) return FALSE;
+    return *h >= 0 && *h < 24 && *m >= 0 && *m < 60 && *s >= 0 && *s < 60;
+}
