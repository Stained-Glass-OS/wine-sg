+static const WCHAR *state_text( TASK_STATE state )
+{
+    switch (state)
+    {
+    case TASK_STATE_DISABLED: return L"Disabled";
+    case TASK_STATE_QUEUED: return L"Queued";
+    case TASK_STATE_READY: return L"Ready";
+    case TASK_STATE_RUNNING: return L"Running";
+    default: return L"Unknown";
+    }
+}
+
+static WCHAR *date_text( DATE date, BOOL zero_is_never )
+{
+    SYSTEMTIME st;
+    WCHAR d[64], t[64], *ret = malloc( 160 * sizeof(WCHAR) );
+
+    if (!ret) return NULL;
+    if (date == 0.0 || !VariantTimeToSystemTime( date, &st ))
+    {
+        wcscpy( ret, zero_is_never ? L"N/A" : L"N/A" );
+        return ret;
+    }
+    GetDateFormatW( LOCALE_USER_DEFAULT, DATE_SHORTDATE, &st, NULL, d, ARRAY_SIZE(d) );
+    GetTimeFormatW( LOCALE_USER_DEFAULT, 0, &st, NULL, t, ARRAY_SIZE(t) );
+    swprintf( ret, 160, L"%ls %ls", d, t );
+    return ret;
+}
+
+/* the text of the first <tag>...</tag> in the task XML, unescaped a little */
+static WCHAR *xml_value( const WCHAR *xml, const WCHAR *tag )
+{
+    WCHAR open[64], close[64];
+    const WCHAR *start, *end;
+    WCHAR *ret;
+
+    swprintf( open, ARRAY_SIZE(open), L"<%ls>", tag );
+    swprintf( close, ARRAY_SIZE(close), L"</%ls>", tag );
+    if (!(start = wcsstr( xml, open ))) return NULL;
+    start += wcslen( open );
+    if (!(end = wcsstr( start, close ))) return NULL;
+    ret = malloc( (end - start + 1) * sizeof(WCHAR) );
+    memcpy( ret, start, (end - start) * sizeof(WCHAR) );
+    ret[end - start] = 0;
+    return ret;
+}
+
+static void print_csv_cell( const WCHAR *text )
+{
+    const WCHAR *p;
+    WCHAR quote[2] = { '"', 0 };
+
+    out( L"%ls", quote );
+    for (p = text; *p; p++)
+    {
+        if (*p == '"') out( L"\"\"" );
+        else out( L"%lc", *p );
+    }
+    out( L"%ls", quote );
+}
