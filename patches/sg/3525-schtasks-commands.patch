+/* The names of days or months from a comma list; "*" is all of them. */
+static BOOL add_names( struct xml_builder *b, const WCHAR *list, const WCHAR *const *codes, const WCHAR *const *names, int count )
+{
+    WCHAR *copy = wcsdup( list ), *tok, *ctx;
+    BOOL ok = TRUE;
+    int i;
+
+    if (!copy) return FALSE;
+    if (!wcscmp( list, L"*" ))
+    {
+        for (i = 0; i < count; i++) xml_add( b, L"<%ls />", names[i] );
+        free( copy );
+        return TRUE;
+    }
+    for (tok = wcstok( copy, L",", &ctx ); tok && ok; tok = wcstok( NULL, L",", &ctx ))
+    {
+        for (i = 0; i < count; i++) if (!wcsicmp( tok, codes[i] )) break;
+        if (i == count) ok = FALSE; else xml_add( b, L"<%ls />", names[i] );
     }
+    free( copy );
+    return ok;
+}
 
