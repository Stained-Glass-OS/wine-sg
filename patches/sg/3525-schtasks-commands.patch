+/* mm/dd/yyyy, yyyy/mm/dd or yyyy-mm-dd, or today */
+static BOOL parse_date( const WCHAR *text, int *y, int *mo, int *d )
+{
+    if (!text) { SYSTEMTIME now; GetLocalTime( &now ); *y = now.wYear; *mo = now.wMonth; *d = now.wDay; return TRUE; }
+    if (swscanf( text, L"%d-%d-%d", y, mo, d ) == 3 && *y > 31) return TRUE;
+    if (swscanf( text, L"%d/%d/%d", y, mo, d ) == 3 && *y > 31) return TRUE;
+    if (swscanf( text, L"%d/%d/%d", mo, d, y ) == 3 && *y > 31) return TRUE;
+    return FALSE;
