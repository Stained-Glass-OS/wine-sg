+static void query_task( struct query_state *q, const WCHAR *folder_path, IRegisteredTask *task )
+{
+    BSTR name = NULL, path = NULL, xml = NULL;
+    TASK_STATE state = TASK_STATE_UNKNOWN;
+    DATE next = 0, last = 0;
+    LONG result = 0;
+    WCHAR *next_text, *last_text, host[MAX_COMPUTERNAME_LENGTH + 1] = L"";
+    DWORD hostlen = ARRAY_SIZE(host);
+    WCHAR *author = NULL, *command = NULL, *args = NULL, *comment = NULL, *user = NULL, *logon = NULL, full[1024];
+    const WCHAR *logon_mode;
+
+    IRegisteredTask_get_Name( task, &name );
+    IRegisteredTask_get_Path( task, &path );
+    IRegisteredTask_get_State( task, &state );
+    IRegisteredTask_get_NextRunTime( task, &next );
+    IRegisteredTask_get_LastRunTime( task, &last );
+    IRegisteredTask_get_LastTaskResult( task, &result );
+    GetComputerNameW( host, &hostlen );
+    next_text = date_text( state == TASK_STATE_DISABLED ? 0 : next, TRUE );
+    last_text = date_text( last, TRUE );
+    swprintf( full, ARRAY_SIZE(full), L"%ls", path ? path : (name ? name : L"") );
+
+    IRegisteredTask_get_Xml( task, &xml );
+    if (xml)
+    {
+        author = xml_value( xml, L"Author" );
+        command = xml_value( xml, L"Command" );
+        args = xml_value( xml, L"Arguments" );
+        comment = xml_value( xml, L"Description" );
+        user = xml_value( xml, L"UserId" );
+        logon = xml_value( xml, L"LogonType" );
+    }
+    logon_mode = (logon && !wcscmp( logon, L"InteractiveToken" )) ? L"Interactive only" :
+                 (logon && !wcscmp( logon, L"ServiceAccount" )) ? L"Background only" :
+                 (logon && !wcscmp( logon, L"Password" )) ? L"Interactive/Background" : L"Interactive only";
+
+    q->found++;
+    if (q->format == QF_LIST)
+    {
+        if (!q->header_done) { out( L"\nFolder: %ls\n", folder_path ); q->header_done = TRUE; }
+        out( L"%-38ls%ls\n", L"HostName:", host );
+        out( L"%-38ls%ls\n", L"TaskName:", full );
+        out( L"%-38ls%ls\n", L"Next Run Time:", next_text );
+        out( L"%-38ls%ls\n", L"Status:", state_text( state ) );
+        out( L"%-38ls%ls\n", L"Logon Mode:", logon_mode );
+        if (q->verbose)
+        {
+            out( L"%-38ls%ls\n", L"Last Run Time:", last_text );
+            out( L"%-38ls%ld\n", L"Last Result:", result );
+            out( L"%-38ls%ls\n", L"Author:", author ? author : L"N/A" );
+            if (command)
+                out( L"%-38ls%ls%ls%ls\n", L"Task To Run:", command, args && args[0] ? L" " : L"", args ? args : L"" );
+            else out( L"%-38ls%ls\n", L"Task To Run:", L"N/A" );
+            out( L"%-38ls%ls\n", L"Start In:", L"N/A" );
+            out( L"%-38ls%ls\n", L"Comment:", comment ? comment : L"N/A" );
+            out( L"%-38ls%ls\n", L"Scheduled Task State:", state == TASK_STATE_DISABLED ? L"Disabled" : L"Enabled" );
+            out( L"%-38ls%ls\n", L"Run As User:", user ? user : L"N/A" );
+        }
+        out( L"\n" );
+    }
+    else if (q->format == QF_CSV)
+    {
+        if (!q->no_header && !q->header_done)
+        {
+            out( L"\"HostName\",\"TaskName\",\"Next Run Time\",\"Status\",\"Logon Mode\"" );
+            if (q->verbose) out( L",\"Last Run Time\",\"Last Result\",\"Author\",\"Task To Run\",\"Comment\",\"Run As User\"" );
+            out( L"\n" );
+        }
+        q->header_done = TRUE;
+        print_csv_cell( host ); out( L"," ); print_csv_cell( full ); out( L"," ); print_csv_cell( next_text ); out( L"," );
+        print_csv_cell( state_text( state ) ); out( L"," ); print_csv_cell( logon_mode );
+        if (q->verbose)
+        {
+            WCHAR num[32], run[1024];
+
+            swprintf( num, ARRAY_SIZE(num), L"%ld", result );
+            swprintf( run, ARRAY_SIZE(run), L"%ls%ls%ls", command ? command : L"N/A", args && args[0] ? L" " : L"", args ? args : L"" );
+            out( L"," ); print_csv_cell( last_text ); out( L"," ); print_csv_cell( num ); out( L"," );
+            print_csv_cell( author ? author : L"N/A" ); out( L"," ); print_csv_cell( run ); out( L"," );
+            print_csv_cell( comment ? comment : L"N/A" ); out( L"," ); print_csv_cell( user ? user : L"N/A" );
+        }
+        out( L"\n" );
+    }
+    else
+    {
+        if (!q->header_done)
+        {
+            out( L"\nFolder: %ls\n", folder_path );
+            if (!q->no_header)
+            {
+                out( L"%-40ls %-22ls %-15ls\n", L"TaskName", L"Next Run Time", L"Status" );
+                out( L"======================================== ====================== ===============\n" );
+            }
+            q->header_done = TRUE;
+        }
+        out( L"%-40ls %-22ls %-15ls\n", name ? name : L"", next_text, state_text( state ) );
+    }
+
+    free( next_text ); free( last_text ); free( author ); free( command ); free( args ); free( comment ); free( user ); free( logon );
+    SysFreeString( name ); SysFreeString( path ); SysFreeString( xml );
+}
+
+static void query_folder( struct query_state *q, ITaskFolder *folder, const WCHAR *folder_path )
+{
+    IRegisteredTaskCollection *tasks = NULL;
+    ITaskFolderCollection *folders = NULL;
+    LONG count = 0, i;
+    VARIANT index;
+
+    q->header_done = FALSE;
+    if (SUCCEEDED(ITaskFolder_GetTasks( folder, TASK_ENUM_HIDDEN, &tasks )) && tasks)
+    {
+        IRegisteredTaskCollection_get_Count( tasks, &count );
+        for (i = 1; i <= count; i++)
+        {
+            IRegisteredTask *task = NULL;
+
+            V_VT(&index) = VT_I4;
+            V_I4(&index) = i;
+            if (SUCCEEDED(IRegisteredTaskCollection_get_Item( tasks, index, &task )) && task)
+            {
+                if (q->only)
+                {
+                    BSTR path = NULL, name = NULL;
+                    WCHAR *want = full_task_name( q->only );
+
+                    IRegisteredTask_get_Path( task, &path );
+                    IRegisteredTask_get_Name( task, &name );
+                    if ((path && !wcsicmp( path, want )) || (name && !wcsicmp( name, q->only ))) query_task( q, folder_path, task );
+                    SysFreeString( path ); SysFreeString( name ); free( want );
+                }
+                else query_task( q, folder_path, task );
+                IRegisteredTask_Release( task );
+            }
+        }
+        IRegisteredTaskCollection_Release( tasks );
+    }
+    if (q->format == QF_TABLE && q->header_done) out( L"\n" );
+
+    if (SUCCEEDED(ITaskFolder_GetFolders( folder, 0, &folders )) && folders)
+    {
+        ITaskFolderCollection_get_Count( folders, &count );
+        for (i = 1; i <= count; i++)
+        {
+            ITaskFolder *sub = NULL;
+            BSTR sub_path = NULL;
+
+            V_VT(&index) = VT_I4;
+            V_I4(&index) = i;
+            if (SUCCEEDED(ITaskFolderCollection_get_Item( folders, index, &sub )) && sub)
+            {
+                ITaskFolder_get_Path( sub, &sub_path );
+                query_folder( q, sub, sub_path ? sub_path : L"" );
+                SysFreeString( sub_path );
+                ITaskFolder_Release( sub );
+            }
+        }
+        ITaskFolderCollection_Release( folders );
+    }
+}
+
+static int query_command(int argc, WCHAR *argv[])
+{
+    struct query_state q = { QF_TABLE };
+    ITaskFolder *root;
+
+    while (argc)
+    {
+        if (!wcsicmp( argv[0], L"/fo" ) && argc >= 2)
+        {
+            if (!wcsicmp( argv[1], L"table" )) q.format = QF_TABLE;
+            else if (!wcsicmp( argv[1], L"list" )) q.format = QF_LIST;
+            else if (!wcsicmp( argv[1], L"csv" )) q.format = QF_CSV;
+            else { out( L"ERROR: Invalid value for /FO option.\n" ); return 1; }
+            argc -= 2; argv += 2;
+        }
+        else if (!wcsicmp( argv[0], L"/tn" ) && argc >= 2) { q.only = argv[1]; argc -= 2; argv += 2; }
+        else if (!wcsicmp( argv[0], L"/nh" )) { q.no_header = TRUE; argc--; argv++; }
+        else if (!wcsicmp( argv[0], L"/v" )) { q.verbose = TRUE; argc--; argv++; }
+        else if (!wcsicmp( argv[0], L"/xml" )) { q.xml_only = TRUE; argc--; argv++; if (argc && argv[0][0] != '/') { argc--; argv++; } }
+        else if (!wcsicmp( argv[0], L"/hresult" )) { argc--; argv++; }
+        else { out( L"ERROR: Invalid syntax: unknown option '%ls'.\n", argv[0] ); return 1; }
+    }
+
+    if (q.xml_only)
+    {
+        IRegisteredTask *task;
+        BSTR xml = NULL;
+
+        if (!q.only) { out( L"ERROR: Invalid syntax: /TN is required with /XML.\n" ); return 1; }
+        if (!(task = get_registered_task( q.only ))) { out( L"ERROR: The system cannot find the file specified.\n" ); return 1; }
+        IRegisteredTask_get_Xml( task, &xml );
+        if (xml) out( L"%ls\n", xml );
+        SysFreeString( xml );
+        IRegisteredTask_Release( task );
+        return 0;
+    }
+
+    if (!(root = get_tasks_root_folder())) return 1;
+    query_folder( &q, root, L"\\" );
+    ITaskFolder_Release( root );
+    if (!q.found)
+    {
+        if (q.only) { out( L"ERROR: The system cannot find the file specified.\n" ); return 1; }
+        out( L"INFO: There are no scheduled tasks presently available at your access level.\n" );
+    }
+    return 0;
+}
