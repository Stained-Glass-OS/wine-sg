+        V_VT(&idx) = VT_I4;
+        V_I4(&idx) = 1;
+        hres = IRegisteredTask_get_Definition( task, &def );
+        if (SUCCEEDED(hres)) hres = ITaskDefinition_get_Actions( def, &actions );
+        if (SUCCEEDED(hres)) hres = IActionCollection_get_Item( actions, 1, &action );
+        if (SUCCEEDED(hres)) hres = IAction_QueryInterface( action, &IID_IExecAction, (void **)&exec );
