+    IRegisteredTask *task;
+    HRESULT hres;
+
+    while (argc) {
+        if (!wcsicmp(argv[0], L"/tn")) {
+            if (argc < 2) {
+                out( L"ERROR: Invalid syntax: value expected for '/tn'.\n" );
+                return 1;
+            }
