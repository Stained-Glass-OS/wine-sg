+/* /TR: a program, possibly quoted, and its arguments */
+static void split_command( const WCHAR *tr, WCHAR **command, WCHAR **args )
+{
+    const WCHAR *p = tr;
+
+    while (*p == ' ') p++;
+    if (*p == '"')
+    {
+        const WCHAR *end = wcschr( p + 1, '"' );
+
+        if (end)
+        {
+            *command = malloc( (end - p) * sizeof(WCHAR) );
+            memcpy( *command, p + 1, (end - p - 1) * sizeof(WCHAR) );
+            (*command)[end - p - 1] = 0;
+            p = end + 1;
+        }
+        else *command = wcsdup( p + 1 ), p += wcslen( p );
     }
+    else
+    {
+        const WCHAR *end = p;
 
