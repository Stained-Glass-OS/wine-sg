+static BOOL xml_escape_append( WCHAR **buf, size_t *len, size_t *cap, const WCHAR *text )
+{
+    const WCHAR *p;
+
+    for (p = text; *p; p++)
+    {
+        const WCHAR *rep = NULL, one[2] = { *p, 0 };
+        size_t n;
+
+        switch (*p)
+        {
+        case '<': rep = L"&lt;"; break;
+        case '>': rep = L"&gt;"; break;
+        case '&': rep = L"&amp;"; break;
+        case '"': rep = L"&quot;"; break;
+        default: rep = one; break;
+        }
+        n = wcslen( rep );
+        if (*len + n + 1 > *cap)
+        {
+            WCHAR *grown;
+            *cap = (*cap + n) * 2;
+            if (!(grown = realloc( *buf, *cap * sizeof(WCHAR) ))) return FALSE;
+            *buf = grown;
         }
+        wcscpy( *buf + *len, rep );
+        *len += n;
     }
+    return TRUE;
+}
 
