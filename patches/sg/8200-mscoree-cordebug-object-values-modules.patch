+/* the process's object for the agent's assembly ID (referenced for the caller) */
+static DebugAssembly *process_assembly(DebugProcess *process, UINT32 id)
+{
+    DebugAssembly *assembly, *found = NULL;
+    const BYTE *p;
+    BYTE *reply;
+    UINT32 len;
+    char *location;
+
+    if (!id || !process) return NULL;
+    EnterCriticalSection(&process->cs);
+    LIST_FOR_EACH_ENTRY(assembly, &process->assemblies, DebugAssembly, entry)
+        if (assembly->id == id) { found = assembly; break; }
+    if (found) ICorDebugAssembly_AddRef(&found->ICorDebugAssembly_iface);
+    LeaveCriticalSection(&process->cs);
+    if (found) return found;
+
+    if (FAILED(agent_request_id(process, SDB_SET_ASSEMBLY, SDB_ASSEMBLY_GET_LOCATION, id, &reply, &len))) return NULL;
+    p = reply;
+    location = read_string(&p, reply + len);
+    free(reply);
+    if (!(assembly = calloc(1, sizeof(*assembly))))
+    {
+        free(location);
+        return NULL;
+    }
+    assembly->ICorDebugAssembly_iface.lpVtbl = &assembly_vtbl;
+    assembly->ref = 2;
+    assembly->process = process;
+    assembly->id = id;
+    assembly->location = wide_from_utf8(location);
+    free(location);
+
+    EnterCriticalSection(&process->cs);
+    LIST_FOR_EACH_ENTRY(found, &process->assemblies, DebugAssembly, entry)
+        if (found->id == id) break;
+    if (&found->entry != &process->assemblies)
+    {
+        ICorDebugAssembly_AddRef(&found->ICorDebugAssembly_iface);
+        LeaveCriticalSection(&process->cs);
+        assembly->ref = 1;
+        ICorDebugAssembly_Release(&assembly->ICorDebugAssembly_iface);
+        return found;
+    }
+    list_add_tail(&process->assemblies, &assembly->entry);
+    LeaveCriticalSection(&process->cs);
+    return assembly;
+}
+
+/* the root domain's assemblies */
+static HRESULT process_assemblies(DebugProcess *process, DebugAssembly ***ret, UINT32 *count)
+{
+    DebugAssembly **assemblies;
+    BYTE *reply;
+    UINT32 len, domain, n, i, got = 0;
+    HRESULT hr;
+
+    *ret = NULL;
+    *count = 0;
+    if (FAILED(hr = agent_request(process, SDB_SET_APPDOMAIN, SDB_APPDOMAIN_GET_ROOT, NULL, 0, &reply, &len))) return hr;
+    domain = len >= 4 ? sdb_get32(reply) : 0;
+    free(reply);
+    if (FAILED(hr = agent_request_id(process, SDB_SET_APPDOMAIN, SDB_APPDOMAIN_GET_ASSEMBLIES, domain, &reply, &len)))
+        return hr;
+    if (len < 4 || (n = sdb_get32(reply)) > (len - 4) / 4 || !(assemblies = calloc(n ? n : 1, sizeof(*assemblies))))
+    {
+        free(reply);
+        return E_FAIL;
+    }
+    for (i = 0; i < n; i++)
+        if ((assemblies[got] = process_assembly(process, sdb_get32(reply + 4 + 4 * i)))) got++;
+    free(reply);
+    *ret = assemblies;
+    *count = got;
+    return S_OK;
+}
