+/* the module whose metadata scope (its MVID) is METADATA's */
+static HRESULT process_module_from_metadata(DebugProcess *process, IUnknown *metadata, ICorDebugModule **ret)
+{
+    DebugAssembly **assemblies;
+    IMetaDataImport *import;
+    DebugModule *module;
+    ICorDebugModuleEnum *modules;
+    ICorDebugModule *candidate;
+    char want[40];
+    GUID mvid;
+    UINT32 count, i;
+    ULONG fetched;
+    HRESULT hr;
+
+    *ret = NULL;
+    if (FAILED(IUnknown_QueryInterface(metadata, &IID_IMetaDataImport, (void **)&import))) return E_INVALIDARG;
+    hr = IMetaDataImport_GetScopeProps(import, NULL, 0, NULL, &mvid);
+    IMetaDataImport_Release(import);
+    if (FAILED(hr)) return E_INVALIDARG;
+    sprintf(want, "%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X", mvid.Data1, mvid.Data2, mvid.Data3,
+            mvid.Data4[0], mvid.Data4[1], mvid.Data4[2], mvid.Data4[3], mvid.Data4[4], mvid.Data4[5], mvid.Data4[6],
+            mvid.Data4[7]);
+    if (FAILED(hr = process_assemblies(process, &assemblies, &count))) return hr;
+    hr = E_INVALIDARG;
+    for (i = 0; i < count; i++)
+    {
+        if (!*ret && SUCCEEDED(assembly_EnumerateModules(&assemblies[i]->ICorDebugAssembly_iface, &modules)))
+        {
+            while (!*ret && ICorDebugModuleEnum_Next(modules, 1, &candidate, &fetched) == S_OK && fetched == 1)
+            {
+                module = impl_from_ICorDebugModule(candidate);
+                if (module->guid && !_stricmp(module->guid, want))
+                {
+                    *ret = candidate;
+                    hr = S_OK;
+                }
+                else ICorDebugModule_Release(candidate);
+            }
+            ICorDebugModuleEnum_Release(modules);
+        }
+        ICorDebugAssembly_Release(&assemblies[i]->ICorDebugAssembly_iface);
+    }
+    free(assemblies);
+    return hr;
+}
+
+/* the process lets its assemblies and modules go (detached, gone): they are neutered */
+static void process_release_modules(DebugProcess *process)
+{
+    DebugModule *module, *module2;
+    DebugAssembly *assembly, *assembly2;
+
+    EnterCriticalSection(&process->cs);
+    LIST_FOR_EACH_ENTRY_SAFE(module, module2, &process->modules, DebugModule, entry)
+    {
+        list_remove(&module->entry);
+        module->process = NULL;
+        ICorDebugModule_Release(&module->ICorDebugModule_iface);
+    }
+    LIST_FOR_EACH_ENTRY_SAFE(assembly, assembly2, &process->assemblies, DebugAssembly, entry)
+    {
+        list_remove(&assembly->entry);
+        assembly->process = NULL;
+        ICorDebugAssembly_Release(&assembly->ICorDebugAssembly_iface);
+    }
+    LeaveCriticalSection(&process->cs);
+}
