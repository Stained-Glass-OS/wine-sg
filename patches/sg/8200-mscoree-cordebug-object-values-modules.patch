+/* the process's object for the agent's module ID, made the first time (referenced for the caller) */
+static DebugModule *process_module(DebugProcess *process, UINT32 id)
+{
+    DebugModule *module, *found = NULL;
+    const BYTE *p, *end;
+    BYTE *reply;
+    UINT32 len;
+    char *base, *scope, *name;
+
+    if (!id || !process) return NULL;
+    EnterCriticalSection(&process->cs);
+    LIST_FOR_EACH_ENTRY(module, &process->modules, DebugModule, entry)
+        if (module->id == id) { found = module; break; }
+    if (found) ICorDebugModule_AddRef(&found->ICorDebugModule_iface);
+    LeaveCriticalSection(&process->cs);
+    if (found) return found;
+
+    if (FAILED(agent_request_id(process, SDB_SET_MODULE, SDB_MODULE_GET_INFO, id, &reply, &len))) return NULL;
+    if (!(module = calloc(1, sizeof(*module))))
+    {
+        free(reply);
+        return NULL;
+    }
+    p = reply;
+    end = reply + len;
+    base = read_string(&p, end);
+    scope = read_string(&p, end);
+    name = read_string(&p, end);
+    module->guid = read_string(&p, end);
+    if (end - p >= 4) module->assembly = sdb_get32(p);
+    free(reply);
+    free(base);
+    free(scope);
+    module->name = wide_from_utf8(name);
+    free(name);
+    module->ICorDebugModule_iface.lpVtbl = &module_vtbl;
+    module->ref = 2;   /* the process's and the caller's */
+    module->process = process;
+    module->id = id;
+
+    EnterCriticalSection(&process->cs);
+    LIST_FOR_EACH_ENTRY(found, &process->modules, DebugModule, entry)
+        if (found->id == id) break;
+    if (&found->entry != &process->modules)   /* another thread made it meanwhile */
+    {
+        ICorDebugModule_AddRef(&found->ICorDebugModule_iface);
+        LeaveCriticalSection(&process->cs);
+        module->ref = 1;
+        ICorDebugModule_Release(&module->ICorDebugModule_iface);
+        return found;
+    }
+    list_add_tail(&process->modules, &module->entry);
+    LeaveCriticalSection(&process->cs);
+    TRACE("module %u: %s\n", id, debugstr_w(module->name));
+    return module;
+}
