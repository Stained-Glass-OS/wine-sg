+static HRESULT array_create(DebugProcess *process, UINT32 objid, UINT32 type, ICorDebugValue **ret)
+{
+    struct type_desc td, element;
+    DebugValue *This;
+    BYTE *reply;
+    UINT32 len, rank, i;
+    UINT64 count = 1;
+    HRESULT hr;
+
+    if (FAILED(hr = agent_request_id(process, SDB_SET_ARRAY_REF, SDB_ARRAY_GET_LENGTH, objid, &reply, &len)))
+        return hr == CORDBG_E_PROCESS_TERMINATED ? hr : CORDBG_E_BAD_REFERENCE_VALUE;
+    if (len < 4 || !(rank = sdb_get32(reply)) || rank > 32 || len < 4 + 8 * rank ||
+        !(This = value_alloc(process, VALUE_ARRAY, rank == 1 ? ELEMENT_TYPE_SZARRAY : ELEMENT_TYPE_ARRAY, NULL,
+                             sizeof(void *), objid)))
+    {
+        free(reply);
+        return E_FAIL;
+    }
+    This->rank = rank;
+    This->dims = calloc(rank, sizeof(ULONG32));
+    This->lows = calloc(rank, sizeof(ULONG32));
+    if (!This->dims || !This->lows)
+    {
+        free(reply);
+        value_release(This);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < rank; i++)
+    {
+        This->dims[i] = sdb_get32(reply + 4 + 8 * i);
+        This->lows[i] = sdb_get32(reply + 8 + 8 * i);
+        count *= This->dims[i];
+    }
+    free(reply);
+    This->count = count > 0xffffffff ? 0xffffffff : count;
+    This->element = ELEMENT_TYPE_CLASS;
+    if (!type && SUCCEEDED(agent_request_id(process, SDB_SET_OBJECT_REF, SDB_OBJECT_GET_TYPE, objid, &reply, &len)))
+    {
+        if (len >= 4) type = sdb_get32(reply);
+        free(reply);
+    }
+    if (type && SUCCEEDED(type_describe(process, type, &td)))
+    {
+        if (td.rank > 1) This->type = ELEMENT_TYPE_ARRAY;
+        if (SUCCEEDED(type_describe(process, td.element, &element)))
+        {
+            This->element = type_element(&element);
+            free(element.fullname);
+        }
+        free(td.fullname);
+    }
+    *ret = value_iface(This);
+    return S_OK;
+}
+
+/* the object a reference refers to */
+static HRESULT object_create(DebugProcess *process, UINT32 objid, ICorDebugValue **ret)
+{
+    struct type_desc td;
+    DebugValue *This;
+    BYTE *reply;
+    UINT32 len, type;
+    HRESULT hr;
+
+    if (FAILED(hr = agent_request_id(process, SDB_SET_OBJECT_REF, SDB_OBJECT_GET_TYPE, objid, &reply, &len)))
+        return hr == CORDBG_E_PROCESS_TERMINATED ? hr : CORDBG_E_BAD_REFERENCE_VALUE;
+    type = len >= 4 ? sdb_get32(reply) : 0;
+    free(reply);
+    if (FAILED(hr = type_describe(process, type, &td))) return CORDBG_E_BAD_REFERENCE_VALUE;
+    if (td.rank)
+    {
+        free(td.fullname);
+        return array_create(process, objid, type, ret);
+    }
+    if (!strcmp(td.fullname, "System.String"))
+    {
+        free(td.fullname);
+        return string_create(process, objid, ret);
+    }
+    free(td.fullname);
+    if (!(This = value_alloc(process, VALUE_OBJECT, ELEMENT_TYPE_CLASS, NULL, sizeof(void *), objid)))
+        return E_OUTOFMEMORY;
+    This->class_type = type;
+    *ret = value_iface(This);
+    return S_OK;
