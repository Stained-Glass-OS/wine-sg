+    if (module) items[0] = (IUnknown *)&module->ICorDebugModule_iface;
+    if (FAILED(hr = object_enum_create(&IID_ICorDebugModuleEnum, items, module ? 1 : 0, 0,
+                                       (ICorDebugEnum **)ppModules)))
+    {
+        if (module) ICorDebugModule_Release(&module->ICorDebugModule_iface);
+        free(items);
+    }
+    return hr;
+}
