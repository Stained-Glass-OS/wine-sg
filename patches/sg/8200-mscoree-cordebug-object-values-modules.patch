+static ICorDebugAppDomain *process_appdomain(DebugProcess *process);
+static HRESULT function_create(DebugProcess *process, UINT32 method, mdMethodDef token, ICorDebugFunction **ret);
+static HRESULT object_enum_create(const IID *iid, IUnknown **items, ULONG count, ULONG pos, ICorDebugEnum **ret);
+
+/* a request to the process's agent; *REPLY (the caller frees it) when it answered */
+static HRESULT agent_request(DebugProcess *process, BYTE set, BYTE cmd, const BYTE *payload, UINT32 len,
+                             BYTE **reply, UINT32 *reply_len)
+{
+    struct sdb_conn *sdb;
+    UINT16 err;
+
+    if (reply) *reply = NULL;
+    if (!process) return CORDBG_E_OBJECT_NEUTERED;
+    if (!(sdb = process_agent(process))) return CORDBG_E_PROCESS_TERMINATED;
+    if (!(err = sdb_request(sdb, set, cmd, payload, len, reply, reply_len))) return S_OK;
+    if (reply)
+    {
+        free(*reply);
+        *reply = NULL;
+    }
+    TRACE("command %u/%u: error %u\n", set, cmd, err);
+    return err == SDB_ERR_GONE ? CORDBG_E_PROCESS_TERMINATED : E_FAIL;
+}
+
+static HRESULT agent_request_id(DebugProcess *process, BYTE set, BYTE cmd, UINT32 id, BYTE **reply, UINT32 *len)
+{
+    BYTE payload[4];
+
+    put_be32(payload, id);
+    return agent_request(process, set, cmd, payload, 4, reply, len);
+}
+
+/* one of the agent's strings (length, UTF-8) at *P */
+static char *read_string(const BYTE **p, const BYTE *end)
+{
+    UINT32 n;
+    char *s;
+
+    if (end - *p < 4) return NULL;
+    n = sdb_get32(*p);
+    if (n > end - *p - 4 || !(s = malloc(n + 1))) return NULL;
+    memcpy(s, *p + 4, n);
+    s[n] = 0;
+    *p += 4 + n;
+    return s;
+}
+
+static WCHAR *wide_from_utf8(const char *s)
+{
+    WCHAR *w;
+    int n;
+
+    if (!s) return NULL;
+    n = MultiByteToWideChar(CP_UTF8, 0, s, -1, NULL, 0);
+    if ((w = malloc(n * sizeof(WCHAR)))) MultiByteToWideChar(CP_UTF8, 0, s, -1, w, n);
+    return w;
+}
+
+/* a name the ICorDebug way: its length with the terminator, and as much as fits */
+static HRESULT copy_name(const WCHAR *name, ULONG32 cch, ULONG32 *pcch, WCHAR buffer[])
+{
+    ULONG32 len = (name ? lstrlenW(name) : 0) + 1, n;
+
+    if (!pcch && !buffer) return E_INVALIDARG;
+    if (pcch) *pcch = len;
+    if (buffer && cch)
+    {
+        n = min(cch, len);
+        if (n > 1) memcpy(buffer, name, (n - 1) * sizeof(WCHAR));
+        buffer[n - 1] = 0;
+    }
+    return S_OK;
+}
+
+/* the size of a pointer in the debuggee */
+static ULONG32 process_pointer_size(DebugProcess *process)
+{
+#ifdef _WIN64
+    BOOL wow64 = FALSE;
+    if (process && process->handle && IsWow64Process(process->handle, &wow64) && wow64) return 4;
+    return 8;
+#else
+    return 4;
+#endif
+}
+
+/* a type, as TYPE GET_INFO describes it */
+struct type_desc
+{
+    char *fullname;
+    UINT32 assembly, module, parent, element;
+    mdTypeDef token;
+    BYTE rank, kind;
+};
+
+static HRESULT type_describe(DebugProcess *process, UINT32 type, struct type_desc *td)
+{
+    BYTE *reply;
+    const BYTE *p, *end;
+    UINT32 len;
+    char *ns, *name;
+    HRESULT hr;
+
+    memset(td, 0, sizeof(*td));
+    if (!type) return E_INVALIDARG;
+    if (FAILED(hr = agent_request_id(process, SDB_SET_TYPE, SDB_TYPE_GET_INFO, type, &reply, &len))) return hr;
+    p = reply;
+    end = reply + len;
+    ns = read_string(&p, end);
+    name = read_string(&p, end);
+    td->fullname = read_string(&p, end);
+    free(ns);
+    free(name);
+    if (!td->fullname || end - p < 26)
+    {
+        free(td->fullname);
+        td->fullname = NULL;
+        free(reply);
+        return E_FAIL;
+    }
+    td->assembly = sdb_get32(p);
+    td->module = sdb_get32(p + 4);
+    td->parent = sdb_get32(p + 8);
+    td->element = sdb_get32(p + 12);
+    td->token = sdb_get32(p + 16);
+    td->rank = p[20];
+    td->kind = p[25];   /* (after the flags) */
+    free(reply);
+    return S_OK;
+}
+
+/* what an element or field of a type is, as ICorDebug says it */
+static CorElementType type_element(const struct type_desc *td)
+{
+    static const struct { const char *name; CorElementType type; } primitives[] =
+    {
+        { "System.Boolean", ELEMENT_TYPE_BOOLEAN }, { "System.Char", ELEMENT_TYPE_CHAR },
+        { "System.SByte", ELEMENT_TYPE_I1 }, { "System.Byte", ELEMENT_TYPE_U1 },
+        { "System.Int16", ELEMENT_TYPE_I2 }, { "System.UInt16", ELEMENT_TYPE_U2 },
+        { "System.Int32", ELEMENT_TYPE_I4 }, { "System.UInt32", ELEMENT_TYPE_U4 },
+        { "System.Int64", ELEMENT_TYPE_I8 }, { "System.UInt64", ELEMENT_TYPE_U8 },
+        { "System.Single", ELEMENT_TYPE_R4 }, { "System.Double", ELEMENT_TYPE_R8 },
+        { "System.IntPtr", ELEMENT_TYPE_I }, { "System.UIntPtr", ELEMENT_TYPE_U },
+        { "System.String", ELEMENT_TYPE_STRING }, { "System.Object", ELEMENT_TYPE_OBJECT },
+    };
+    unsigned int i;
+
+    if (td->rank) return td->rank == 1 ? ELEMENT_TYPE_SZARRAY : ELEMENT_TYPE_ARRAY;
+    for (i = 0; td->fullname && i < ARRAY_SIZE(primitives); i++)
+        if (!strcmp(td->fullname, primitives[i].name)) return primitives[i].type;
+    return td->kind & SDB_TYPE_IS_VALUETYPE ? ELEMENT_TYPE_VALUETYPE : ELEMENT_TYPE_CLASS;
+}
+
+/* a type's own fields (TYPE GET_FIELDS), in metadata order */
+struct type_field
+{
+    UINT32 id, type, attrs;
+    char *name;
+};
+
+static void free_fields(struct type_field *fields, UINT32 count)
+{
+    UINT32 i;
+    for (i = 0; i < count; i++) free(fields[i].name);
+    free(fields);
+}
+
+static HRESULT type_fields(DebugProcess *process, UINT32 type, struct type_field **ret, UINT32 *count)
+{
+    struct type_field *fields;
+    BYTE *reply;
+    const BYTE *p, *end;
+    UINT32 len, n, i;
+    HRESULT hr;
+
+    *ret = NULL;
+    *count = 0;
+    if (FAILED(hr = agent_request_id(process, SDB_SET_TYPE, SDB_TYPE_GET_FIELDS, type, &reply, &len))) return hr;
+    if (len < 4 || (n = sdb_get32(reply)) > (len - 4) / 16 || !(fields = calloc(n ? n : 1, sizeof(*fields))))
+    {
+        free(reply);
+        return E_FAIL;
+    }
+    p = reply + 4;
+    end = reply + len;
+    for (i = 0; i < n; i++)
+    {
+        if (end - p < 4) break;
+        fields[i].id = sdb_get32(p);
+        p += 4;
+        if (!(fields[i].name = read_string(&p, end)) || end - p < 8) break;
+        fields[i].type = sdb_get32(p);
+        fields[i].attrs = sdb_get32(p + 4);
+        p += 8;
+    }
+    free(reply);
+    if (i < n)
+    {
+        free_fields(fields, n);
+        return E_FAIL;
+    }
+    *ret = fields;
+    *count = n;
+    return S_OK;
+}
+
+/* ICorDebugAssembly and ICorDebugModule: the agent's, one object each for as long as the process is debugged
+ * (the process holds them; they do not hold the process, which neuters them when it lets them go) */
+typedef struct DebugAssembly
+{
+    ICorDebugAssembly ICorDebugAssembly_iface;
+    LONG ref;
+    DebugProcess *process;
+    struct list entry;
+    UINT32 id;
+    WCHAR *location;
+} DebugAssembly;
+
+typedef struct DebugModule
+{
+    ICorDebugModule ICorDebugModule_iface;
+    LONG ref;
+    DebugProcess *process;
+    struct list entry;
+    UINT32 id, assembly;
+    WCHAR *name;          /* its file */
+    char *guid;           /* its version id (MVID), as the agent writes it */
+    BYTE *image;          /* the assembly's image, which its metadata reads */
+    UINT32 image_size;
+    IMetaDataImport *metadata;
+} DebugModule;
+
+static DebugModule *process_module(DebugProcess *process, UINT32 id);
+static DebugAssembly *process_assembly(DebugProcess *process, UINT32 id);
+
+/* Wine Mono on Windows has the loader map assemblies: the image it gives is laid out as mapped (an RVA is
+ * an offset), which a reader of PE files does not take; the metadata root (BSJB) in it does */
+static HRESULT open_mapped_metadata(const BYTE *image, UINT32 size, IUnknown **ret)
+{
+    const IMAGE_NT_HEADERS32 *nt32;
+    const IMAGE_DATA_DIRECTORY *dir;
+    const IMAGE_COR20_HEADER *cor;
+    UINT32 lfanew, rva, md, md_size;
+
+    if (size < 0x40 || image[0] != 'M' || image[1] != 'Z') return E_FAIL;
+    lfanew = *(const UINT32 *)(image + 0x3c);
+    if (lfanew > size - sizeof(IMAGE_NT_HEADERS64)) return E_FAIL;
+    nt32 = (const IMAGE_NT_HEADERS32 *)(image + lfanew);
+    if (nt32->Signature != IMAGE_NT_SIGNATURE) return E_FAIL;
+    if (nt32->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC)
+        dir = &((const IMAGE_NT_HEADERS64 *)nt32)->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_COM_DESCRIPTOR];
+    else
+        dir = &nt32->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_COM_DESCRIPTOR];
+    rva = dir->VirtualAddress;
+    if (!rva || rva > size - sizeof(*cor)) return E_FAIL;
+    cor = (const IMAGE_COR20_HEADER *)(image + rva);
+    md = cor->MetaData.VirtualAddress;
+    md_size = cor->MetaData.Size;
+    if (!md || md > size || md_size > size - md || md_size < 4 || memcmp(image + md, "BSJB", 4)) return E_FAIL;
+    return MetaData_OpenMemory(image + md, md_size, &IID_IMetaDataImport, ret);
+}
+
+/* the module's metadata (not referenced for the caller: it lives as long as the module) */
+static IMetaDataImport *module_metadata(DebugModule *This)
+{
+    IUnknown *unk = NULL;
+    BYTE *reply, *image;
+    UINT32 len, size;
+
+    if (This->metadata) return This->metadata;
+    if (!This->process) return NULL;
+    if (FAILED(agent_request_id(This->process, SDB_SET_ASSEMBLY, SDB_ASSEMBLY_GET_METADATA_BLOB, This->assembly,
+                                &reply, &len)))
+        return NULL;
+    if (len < 4 || (size = sdb_get32(reply)) > len - 4 || !(image = malloc(size ? size : 1)))
+    {
+        free(reply);
+        return NULL;
+    }
+    memcpy(image, reply + 4, size);
+    free(reply);
+    if (FAILED(MetaData_OpenMemory(image, size, &IID_IMetaDataImport, &unk)) &&
+        FAILED(open_mapped_metadata(image, size, &unk)))
+    {
+        WARN("no metadata for module %s\n", debugstr_w(This->name));
+        free(image);
+        return NULL;
+    }
+    EnterCriticalSection(&This->process->cs);
+    if (!This->metadata)
+    {
+        This->metadata = (IMetaDataImport *)unk;
+        This->image = image;
+        This->image_size = size;
+        unk = NULL;
+    }
+    LeaveCriticalSection(&This->process->cs);
+    if (unk)
+    {
+        IUnknown_Release(unk);
+        free(image);
+    }
+    return This->metadata;
+}
+
+/* ICorDebugClass: a type of the agent's */
+typedef struct DebugClass
+{
+    ICorDebugClass ICorDebugClass_iface;
+    LONG ref;
+    DebugModule *module;
+    UINT32 type;
+    mdTypeDef token;
+} DebugClass;
+
+static const ICorDebugClassVtbl class_vtbl;
+
+static DebugClass *class_impl(ICorDebugClass *iface)
+{
+    if (!iface || iface->lpVtbl != &class_vtbl) return NULL;
+    return CONTAINING_RECORD(iface, DebugClass, ICorDebugClass_iface);
+}
+
+static HRESULT class_create(DebugProcess *process, UINT32 type, ICorDebugClass **ret)
+{
+    struct type_desc td;
+    DebugClass *This;
+    HRESULT hr;
+
+    *ret = NULL;
+    if (FAILED(hr = type_describe(process, type, &td))) return hr;
+    free(td.fullname);
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->ICorDebugClass_iface.lpVtbl = &class_vtbl;
+    This->ref = 1;
+    if (!(This->module = process_module(process, td.module)))
+    {
+        free(This);
+        return CORDBG_E_CLASS_NOT_LOADED;
+    }
+    This->type = type;
+    This->token = td.token;
+    *ret = &This->ICorDebugClass_iface;
+    return S_OK;
+}
+
+/* the field with metadata token TOKEN, declared by TYPE or one of its bases (one in MODULE, when given):
+ * the agent's field, its index among the declaring type's instance fields, the declaring type */
+static HRESULT find_field(DebugProcess *process, UINT32 type, DebugModule *module, mdFieldDef token,
+                          struct type_field *field, UINT32 *index, UINT32 *declaring)
+{
+    struct type_field *fields;
+    struct type_desc td;
+    IMetaDataImport *metadata;
+    DebugModule *owner;
+    WCHAR wname[512];
+    char name[1536];
+    UINT32 count, i, instance, depth;
+    mdTypeDef cls;
+    ULONG n;
+    BOOL here;
+    HRESULT hr;
+
+    if (TypeFromToken(token) != mdtFieldDef) return E_INVALIDARG;
+    for (depth = 0; type && depth < 64; depth++)
+    {
+        if (FAILED(hr = type_describe(process, type, &td))) return hr;
+        free(td.fullname);
+        owner = process_module(process, td.module);
+        here = owner && (!module || module == owner) && (metadata = module_metadata(owner)) &&
+               SUCCEEDED(IMetaDataImport_GetFieldProps(metadata, token, &cls, wname, ARRAY_SIZE(wname), &n, NULL,
+                                                       NULL, NULL, NULL, NULL, NULL)) && cls == td.token;
+        if (owner) ICorDebugModule_Release(&owner->ICorDebugModule_iface);
+        if (here)
+        {
+            WideCharToMultiByte(CP_UTF8, 0, wname, -1, name, sizeof(name), NULL, NULL);
+            if (FAILED(hr = type_fields(process, type, &fields, &count))) return hr;
+            hr = CORDBG_E_FIELD_NOT_AVAILABLE;
+            for (i = instance = 0; i < count; i++)
+            {
+                if (!strcmp(fields[i].name, name))
+                {
+                    *field = fields[i];
+                    field->name = NULL;
+                    *index = instance;
+                    *declaring = type;
+                    hr = S_OK;
+                    break;
+                }
+                if (!(fields[i].attrs & SDB_FIELD_STATIC)) instance++;
+            }
+            free_fields(fields, count);
+            return hr;
+        }
+        type = td.parent;
+    }
+    return E_INVALIDARG;
+}
+
+/* values */
+enum value_kind { VALUE_PRIMITIVE, VALUE_REFERENCE, VALUE_STRING, VALUE_OBJECT, VALUE_STRUCT, VALUE_ARRAY };
+
+/* where a value lives in the debuggee, for SetValue */
+enum home_kind { HOME_NONE, HOME_FRAME, HOME_FIELD, HOME_STATIC, HOME_ELEMENT };
+struct value_home
+{
+    enum home_kind kind;
+    UINT32 a, b;    /* frame: thread, frame; field: object, field; static: type, field; element: array, index */
+    INT32 pos;      /* frame: the agent's position (locals from 0, parameters -1 down) */
+};
 
 typedef struct DebugValue
