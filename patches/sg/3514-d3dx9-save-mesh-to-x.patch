From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dx9: D3DXSaveMeshToX (3514)

d3dx9: D3DXSaveMeshToXA and D3DXSaveMeshToXW

The mesh is written as a text .x file: Mesh (vertices from the POSITION element, faces), MeshNormals,
MeshTextureCoords, MeshVertexColors and a MeshMaterialList with embedded Materials and
TextureFilename, using the attribute buffer for the face materials. Binary and compressed requests
are written in the text format, which every .x reader accepts. D3DXLoadMeshFromX reads the result back.
---
--- a/dlls/d3dx9_36/mesh.c
+++ b/dlls/d3dx9_36/mesh.c
@@ -8552,6 +8552,222 @@
     return hr;
 }
 
+struct x_text
+{
+    char *data;
+    SIZE_T size, capacity;
+    BOOL failed;
+};
+
+static void x_printf(struct x_text *t, const char *fmt, ...) __WINE_PRINTF_ATTR(2, 3);
+static void x_printf(struct x_text *t, const char *fmt, ...)
+{
+    va_list args;
+    char buffer[512];
+    int len;
+
+    if (t->failed) return;
+    va_start(args, fmt);
+    len = vsnprintf(buffer, sizeof(buffer), fmt, args);
+    va_end(args);
+    if (len < 0 || len >= (int)sizeof(buffer)) { t->failed = TRUE; return; }
+    if (t->size + len + 1 > t->capacity)
+    {
+        SIZE_T capacity = max(t->capacity * 2, 4096);
+        char *data;
+
+        while (capacity < t->size + len + 1) capacity *= 2;
+        if (!(data = realloc(t->data, capacity))) { t->failed = TRUE; return; }
+        t->data = data;
+        t->capacity = capacity;
+    }
+    memcpy(t->data + t->size, buffer, len + 1);
+    t->size += len;
+}
+
+static const D3DVERTEXELEMENT9 *find_element(const D3DVERTEXELEMENT9 *decl, D3DDECLUSAGE usage, DWORD index)
+{
+    for (; decl->Stream != 0xff; ++decl)
+        if (decl->Usage == usage && decl->UsageIndex == index) return decl;
+    return NULL;
+}
+
+/* The mesh as a text .x file: Mesh with normals, texture coordinates, vertex colours and the material list. */
+static HRESULT save_mesh_as_x_text(ID3DXMesh *mesh, const D3DXMATERIAL *materials, DWORD material_count,
+        struct x_text *t)
+{
+    D3DVERTEXELEMENT9 decl[MAX_FVF_DECL_SIZE];
+    const D3DVERTEXELEMENT9 *pos, *normal, *tex, *color;
+    DWORD num_vertices = mesh->lpVtbl->GetNumVertices(mesh), num_faces = mesh->lpVtbl->GetNumFaces(mesh);
+    DWORD stride = mesh->lpVtbl->GetNumBytesPerVertex(mesh), i;
+    BOOL wide = mesh->lpVtbl->GetOptions(mesh) & D3DXMESH_32BIT;
+    BYTE *vertices = NULL;
+    void *indices = NULL;
+    DWORD *attributes = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = mesh->lpVtbl->GetDeclaration(mesh, decl))) return hr;
+    if (!(pos = find_element(decl, D3DDECLUSAGE_POSITION, 0))
+            || (pos->Type != D3DDECLTYPE_FLOAT3 && pos->Type != D3DDECLTYPE_FLOAT4))
+        return D3DERR_INVALIDCALL;
+    normal = find_element(decl, D3DDECLUSAGE_NORMAL, 0);
+    if (normal && normal->Type != D3DDECLTYPE_FLOAT3 && normal->Type != D3DDECLTYPE_FLOAT4) normal = NULL;
+    tex = find_element(decl, D3DDECLUSAGE_TEXCOORD, 0);
+    if (tex && (tex->Type < D3DDECLTYPE_FLOAT2 || tex->Type > D3DDECLTYPE_FLOAT4)) tex = NULL;
+    color = find_element(decl, D3DDECLUSAGE_COLOR, 0);
+    if (color && color->Type != D3DDECLTYPE_D3DCOLOR) color = NULL;
+
+    if (FAILED(hr = mesh->lpVtbl->LockVertexBuffer(mesh, D3DLOCK_READONLY, (void **)&vertices))) return hr;
+    if (FAILED(hr = mesh->lpVtbl->LockIndexBuffer(mesh, D3DLOCK_READONLY, &indices)))
+    {
+        mesh->lpVtbl->UnlockVertexBuffer(mesh);
+        return hr;
+    }
+    mesh->lpVtbl->LockAttributeBuffer(mesh, D3DLOCK_READONLY, &attributes);
+
+    x_printf(t, "xof 0303txt 0032\n\nMesh {\n %lu;\n", num_vertices);
+    for (i = 0; i < num_vertices; ++i)
+    {
+        const float *p = (const float *)(vertices + i * stride + pos->Offset);
+        x_printf(t, " %.6f;%.6f;%.6f;%s\n", p[0], p[1], p[2], i + 1 < num_vertices ? "," : ";");
+    }
+    x_printf(t, " %lu;\n", num_faces);
+    for (i = 0; i < num_faces; ++i)
+        x_printf(t, " 3;%lu,%lu,%lu;%s\n", read_ib(indices, wide, 3 * i), read_ib(indices, wide, 3 * i + 1),
+                read_ib(indices, wide, 3 * i + 2), i + 1 < num_faces ? "," : ";");
+
+    if (normal)
+    {
+        x_printf(t, "\n MeshNormals {\n  %lu;\n", num_vertices);
+        for (i = 0; i < num_vertices; ++i)
+        {
+            const float *n = (const float *)(vertices + i * stride + normal->Offset);
+            x_printf(t, "  %.6f;%.6f;%.6f;%s\n", n[0], n[1], n[2], i + 1 < num_vertices ? "," : ";");
+        }
+        x_printf(t, "  %lu;\n", num_faces);
+        for (i = 0; i < num_faces; ++i)
+            x_printf(t, "  3;%lu,%lu,%lu;%s\n", read_ib(indices, wide, 3 * i), read_ib(indices, wide, 3 * i + 1),
+                    read_ib(indices, wide, 3 * i + 2), i + 1 < num_faces ? "," : ";");
+        x_printf(t, " }\n");
+    }
+    if (tex)
+    {
+        x_printf(t, "\n MeshTextureCoords {\n  %lu;\n", num_vertices);
+        for (i = 0; i < num_vertices; ++i)
+        {
+            const float *uv = (const float *)(vertices + i * stride + tex->Offset);
+            x_printf(t, "  %.6f;%.6f;%s\n", uv[0], uv[1], i + 1 < num_vertices ? "," : ";");
+        }
+        x_printf(t, " }\n");
+    }
+    if (color)
+    {
+        x_printf(t, "\n MeshVertexColors {\n  %lu;\n", num_vertices);
+        for (i = 0; i < num_vertices; ++i)
+        {
+            DWORD c = *(const DWORD *)(vertices + i * stride + color->Offset);
+            x_printf(t, "  %lu;%.6f;%.6f;%.6f;%.6f;;%s\n", i, ((c >> 16) & 0xff) / 255.0f, ((c >> 8) & 0xff) / 255.0f,
+                    (c & 0xff) / 255.0f, (c >> 24) / 255.0f, i + 1 < num_vertices ? "," : ";");
+        }
+        x_printf(t, " }\n");
+    }
+    if (materials && material_count)
+    {
+        x_printf(t, "\n MeshMaterialList {\n  %lu;\n  %lu;\n", material_count, num_faces);
+        for (i = 0; i < num_faces; ++i)
+        {
+            DWORD id = attributes ? attributes[i] : 0;
+            x_printf(t, "  %lu%s\n", id < material_count ? id : 0, i + 1 < num_faces ? "," : ";;");
+        }
+        for (i = 0; i < material_count; ++i)
+        {
+            const D3DMATERIAL9 *m = &materials[i].MatD3D;
+            x_printf(t, "  Material {\n   %.6f;%.6f;%.6f;%.6f;;\n   %.6f;\n   %.6f;%.6f;%.6f;;\n   %.6f;%.6f;%.6f;;\n",
+                    m->Diffuse.r, m->Diffuse.g, m->Diffuse.b, m->Diffuse.a, m->Power,
+                    m->Specular.r, m->Specular.g, m->Specular.b, m->Emissive.r, m->Emissive.g, m->Emissive.b);
+            if (materials[i].pTextureFilename)
+            {
+                const char *f;
+
+                x_printf(t, "   TextureFilename { \"");
+                for (f = materials[i].pTextureFilename; *f; ++f)
+                    x_printf(t, "%s%c", *f == '\\' || *f == '"' ? "\\" : "", *f);
+                x_printf(t, "\"; }\n");
+            }
+            x_printf(t, "  }\n");
+        }
+        x_printf(t, " }\n");
+    }
+    x_printf(t, "}\n");
+
+    if (attributes) mesh->lpVtbl->UnlockAttributeBuffer(mesh);
+    mesh->lpVtbl->UnlockIndexBuffer(mesh);
+    mesh->lpVtbl->UnlockVertexBuffer(mesh);
+    return t->failed ? E_OUTOFMEMORY : D3D_OK;
+}
+
+/*************************************************************************
+ * D3DXSaveMeshToXW    (D3DX9_36.@)
+ */
+HRESULT WINAPI D3DXSaveMeshToXW(const WCHAR *filename, ID3DXMesh *mesh, const DWORD *adjacency,
+        const D3DXMATERIAL *materials, const D3DXEFFECTINSTANCE *effect_instances, DWORD material_count, DWORD format)
+{
+    struct x_text text = {0};
+    HANDLE file;
+    DWORD written;
+    HRESULT hr;
+
+    TRACE("filename %s, mesh %p, adjacency %p, materials %p, effect_instances %p, material_count %lu, format %#lx.\n",
+            debugstr_w(filename), mesh, adjacency, materials, effect_instances, material_count, format);
+
+    if (!filename || !mesh || format > D3DXF_FILEFORMAT_COMPRESSED || (material_count && !materials))
+        return D3DERR_INVALIDCALL;
+    if (effect_instances)
+        FIXME("Effect instances are not saved.\n");
+    if (format != D3DXF_FILEFORMAT_TEXT)
+        FIXME("Format %#lx requested, writing the text format, which every loader reads.\n", format);
+
+    if (FAILED(hr = save_mesh_as_x_text(mesh, materials, material_count, &text)))
+    {
+        free(text.data);
+        return hr;
+    }
+    file = CreateFileW(filename, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        free(text.data);
+        return D3DXERR_INVALIDDATA;
+    }
+    if (!WriteFile(file, text.data, text.size, &written, NULL) || written != text.size)
+        hr = D3DXERR_INVALIDDATA;
+    CloseHandle(file);
+    free(text.data);
+    return hr;
+}
+
+/*************************************************************************
+ * D3DXSaveMeshToXA    (D3DX9_36.@)
+ */
+HRESULT WINAPI D3DXSaveMeshToXA(const char *filename, ID3DXMesh *mesh, const DWORD *adjacency,
+        const D3DXMATERIAL *materials, const D3DXEFFECTINSTANCE *effect_instances, DWORD material_count, DWORD format)
+{
+    WCHAR *filenameW;
+    HRESULT hr;
+    int len;
+
+    TRACE("filename %s, mesh %p, adjacency %p, materials %p, effect_instances %p, material_count %lu, format %#lx.\n",
+            debugstr_a(filename), mesh, adjacency, materials, effect_instances, material_count, format);
+
+    if (!filename)
+        return D3DERR_INVALIDCALL;
+    len = MultiByteToWideChar(CP_ACP, 0, filename, -1, NULL, 0);
+    if (!(filenameW = malloc(len * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    MultiByteToWideChar(CP_ACP, 0, filename, -1, filenameW, len);
+    hr = D3DXSaveMeshToXW(filenameW, mesh, adjacency, materials, effect_instances, material_count, format);
+    free(filenameW);
+    return hr;
+}
+
