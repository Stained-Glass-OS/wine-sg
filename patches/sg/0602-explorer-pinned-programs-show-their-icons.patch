From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: pinned programs show their own icons

A pinned shortcut's icon came from SHGetFileInfo on the .lnk, which gives a
program's shortcut the blank page with an arrow: File Explorer and Edge
pinned showed that. Now the shortcut's icon location, else the program's
first icon, else the folder icon for explorer.exe (which carries none).
---
--- a/programs/explorer/taskpins.c
+++ b/programs/explorer/taskpins.c
@@ -97,28 +97,52 @@
     return ia != ib ? (ia < ib ? -1 : 1) : wcsicmp( na, nb );
 }
 
-/* what a shortcut starts, and its icon */
+/* what a shortcut starts, and its icon: the shortcut's own icon location,
+ * else its program's first icon, else -- File Explorer, whose explorer.exe
+ * carries none -- the folder icon; the shell's answer only last. The shell
+ * gave a program's shortcut the blank page with an arrow: File Explorer and
+ * Edge pinned showed that on the taskbar (David 2026-09-30). */
 static void resolve_pin( struct taskbar_pin *pin )
 {
     IShellLinkW *link;
     IPersistFile *file;
     SHFILEINFOW info;
+    WCHAR location[MAX_PATH] = L"", expanded[MAX_PATH];
+    const WCHAR *base;
+    int index = 0;
 
     pin->target[0] = 0;
+    pin->icon = 0;
     if (SUCCEEDED(CoCreateInstance( &CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW, (void **)&link )))
     {
         if (SUCCEEDED(IShellLinkW_QueryInterface( link, &IID_IPersistFile, (void **)&file )))
         {
             if (SUCCEEDED(IPersistFile_Load( file, pin->lnk, STGM_READ )))
+            {
                 IShellLinkW_GetPath( link, pin->target, MAX_PATH, NULL, 0 );
+                if (FAILED(IShellLinkW_GetIconLocation( link, location, MAX_PATH, &index ))) location[0] = 0;
+            }
             IPersistFile_Release( file );
         }
         IShellLinkW_Release( link );
     }
     lstrcpynW( pin->name, wcsrchr( pin->lnk, '\\' ) + 1, MAX_PATH );
     if (wcsrchr( pin->name, '.' )) *wcsrchr( pin->name, '.' ) = 0;
+
+    if (location[0] && ExpandEnvironmentStringsW( location, expanded, MAX_PATH ) &&
+        ExtractIconExW( expanded, index, &pin->icon, NULL, 1 ) == 1 && pin->icon) return;
+    pin->icon = 0;
+    if (pin->target[0] && ExtractIconExW( pin->target, 0, &pin->icon, NULL, 1 ) == 1 && pin->icon) return;
     pin->icon = 0;
+    base = wcsrchr( pin->target, '\\' ) ? wcsrchr( pin->target, '\\' ) + 1 : pin->target;
+    if (!wcsicmp( base, L"explorer.exe" ) && GetWindowsDirectoryW( expanded, MAX_PATH ) &&
+        SHGetFileInfoW( expanded, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON ) && info.hIcon)
+    {
+        pin->icon = info.hIcon;
+        return;
+    }
     if (SHGetFileInfoW( pin->lnk, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON )) pin->icon = info.hIcon;
+    TRACE( "%s: %s, icon %p\n", debugstr_w(pin->lnk), debugstr_w(pin->target), pin->icon );
 }
 
 void pins_free( struct taskbar_pin *pins, int count )
