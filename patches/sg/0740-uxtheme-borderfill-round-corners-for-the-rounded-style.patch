From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uxtheme: a bordered fill with round corners (BorderType = RoundRect)

David: in the Rounded style the edit boxes stayed square while everything
else was round. Their frames -- and those of list boxes, list and tree views
and combo boxes -- are a bordered fill (BgType = BorderFill), which uxtheme
only drew as a rectangle. BorderType = RoundRect with RoundCornerWidth and
RoundCornerHeight now give it round corners: the straight parts as before,
the four corners anti-aliased (4x4 samples) and alpha-blended over what is
already there. IsThemeBackgroundPartiallyTransparent says yes for such a
part, so the controls draw their parent's background below it first, and
that shows through outside the curve. The Rounded and Rounded Dark schemes
(theme/rounded.py) ask for it; Light, Blue and Dark stay square.
---
--- a/dlls/uxtheme/draw.c
+++ b/dlls/uxtheme/draw.c
@@ -1063,12 +1063,116 @@
  *
  * Draw an imagefile background
  */
+/* Stained Glass OS: BorderType = RoundRect, RoundCornerWidth/Height -- the
+ * Rounded style's edit boxes, list boxes and list and tree views. The radius
+ * of a part's round corners, or 0 for square ones. */
+static int sg_round_radius(HTHEME hTheme, int iPartId, int iStateId, const RECT *rc)
+{
+    int type = BT_RECT, w = 0, h = 0, r;
+
+    if (FAILED(GetThemeEnumValue(hTheme, iPartId, iStateId, TMT_BORDERTYPE, &type)) || type != BT_ROUNDRECT)
+        return 0;
+    GetThemeInt(hTheme, iPartId, iStateId, TMT_ROUNDCORNERWIDTH, &w);
+    if (FAILED(GetThemeInt(hTheme, iPartId, iStateId, TMT_ROUNDCORNERHEIGHT, &h))) h = w;
+    r = min(w, h) / 2;
+    if (rc) r = min(r, min(rc->right - rc->left, rc->bottom - rc->top) / 2);
+    return r >= 2 ? min(r, 32) : 0;
+}
+
+/* The four corners, r pixels square, anti-aliased: the border's ring and the
+ * fill inside it blended over what is already there (the parent's background,
+ * which callers draw first, IsThemeBackgroundPartiallyTransparent saying so);
+ * outside the curve nothing is drawn. */
+static void sg_round_corners(HDC hdc, const RECT *rc, int r, int border, COLORREF bc, COLORREF fc, BOOL content)
+{
+    BLENDFUNCTION bf = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER) }};
+    DWORD *bits;
+    HBITMAP bmp, old;
+    HDC mem;
+    int c, i, j, k, l;
+    const int S = 4;   /* samples per pixel and axis */
+    int ro = r * 2 * S, ri = (r - border) * 2 * S;   /* radii in half-samples */
+
+    bmi.bmiHeader.biWidth = r;
+    bmi.bmiHeader.biHeight = -r;
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biCompression = BI_RGB;
+    if (!(mem = CreateCompatibleDC(hdc))) return;
+    if (!(bmp = CreateDIBSection(mem, &bmi, DIB_RGB_COLORS, (void **)&bits, NULL, 0)))
+    {
+        DeleteDC(mem);
+        return;
+    }
+    old = SelectObject(mem, bmp);
+    for (c = 0; c < 4; c++)
+    {
+        for (j = 0; j < r; j++)
+            for (i = 0; i < r; i++)
+            {
+                /* the pixel in the top left corner's frame; the circle's centre is (r, r) */
+                int x = (c & 1) ? r - 1 - i : i, y = (c & 2) ? r - 1 - j : j;
+                int in_outer = 0, in_inner = 0, a, br, fr;
+                for (k = 0; k < S; k++)
+                    for (l = 0; l < S; l++)
+                    {
+                        int dx = 2 * S * r - (2 * S * x + 2 * l + 1), dy = 2 * S * r - (2 * S * y + 2 * k + 1);
+                        int d2 = dx * dx + dy * dy;
+                        if (d2 <= ro * ro) in_outer++;
+                        if (ri > 0 && d2 <= ri * ri) in_inner++;
+                    }
+                br = in_outer - in_inner;          /* the border's share, of S*S */
+                fr = content ? in_inner : 0;       /* the fill's */
+                a = br + fr;
+                bits[j * r + i] = (a * 255 / (S * S)) << 24 |
+                    ((br * GetRValue(bc) + fr * GetRValue(fc)) / (S * S)) << 16 |
+                    ((br * GetGValue(bc) + fr * GetGValue(fc)) / (S * S)) << 8 |
+                    ((br * GetBValue(bc) + fr * GetBValue(fc)) / (S * S));
+            }
+        GdiAlphaBlend(hdc, (c & 1) ? rc->right - r : rc->left, (c & 2) ? rc->bottom - r : rc->top, r, r,
+                      mem, 0, 0, r, r, bf);
+    }
+    SelectObject(mem, old);
+    DeleteObject(bmp);
+    DeleteDC(mem);
+}
+
 static HRESULT UXTHEME_DrawBorderBackground(HTHEME hTheme, HDC hdc, int iPartId,
                                      int iStateId, const RECT *pRect,
                                      const DTBGOPTS *pOptions)
 {
     HRESULT hr;
     RECT rt;
+#ifndef SG_MUTANT_SQUARE_BORDERFILL
+    int r = sg_round_radius(hTheme, iPartId, iStateId, pRect);
+
+    if (r)
+    {
+        COLORREF bc = RGB(0,0,0), fc = RGB(255,255,255);
+        int border = 1;
+
+        GetThemeInt(hTheme, iPartId, iStateId, TMT_BORDERSIZE, &border);
+        GetThemeColor(hTheme, iPartId, iStateId, TMT_BORDERCOLOR, &bc);
+        GetThemeColor(hTheme, iPartId, iStateId, TMT_FILLCOLOR, &fc);
+        if (border < 0) border = 0;
+        if (pOptions->dwFlags & DTBG_OMITBORDER) bc = fc;
+        /* the straight parts as ever, the corners left out of them */
+        SaveDC(hdc);
+        ExcludeClipRect(hdc, pRect->left, pRect->top, pRect->left + r, pRect->top + r);
+        ExcludeClipRect(hdc, pRect->right - r, pRect->top, pRect->right, pRect->top + r);
+        ExcludeClipRect(hdc, pRect->left, pRect->bottom - r, pRect->left + r, pRect->bottom);
+        ExcludeClipRect(hdc, pRect->right - r, pRect->bottom - r, pRect->right, pRect->bottom);
+        rt = *pRect;
+        hr = UXTHEME_DrawBorderRectangle(hTheme, hdc, iPartId, iStateId, &rt, pOptions);
+        if (SUCCEEDED(hr))
+            hr = UXTHEME_DrawBackgroundFill(hTheme, hdc, iPartId, iStateId, &rt, pOptions);
+        RestoreDC(hdc, -1);
+        if (SUCCEEDED(hr))
+            sg_round_corners(hdc, pRect, r, border, bc, fc, !(pOptions->dwFlags & DTBG_OMITCONTENT));
+        return hr;
+    }
+#endif
 
     rt = *pRect;
 
@@ -2225,6 +2329,8 @@
 
     GetThemeEnumValue(hTheme, iPartId, iStateId, TMT_BGTYPE, &bgtype);
 
+    /* Stained Glass OS: round corners show what is below them */
+    if (bgtype == BT_BORDERFILL) return sg_round_radius(hTheme, iPartId, iStateId, NULL) != 0;
     if (bgtype != BT_IMAGEFILE) return FALSE;
 
     if (FAILED(UXTHEME_LoadImage(hTheme, iPartId, iStateId, &rect, FALSE, &bmpSrc, &rcSrc,
