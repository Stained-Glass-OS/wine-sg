From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] nsiproxy.sys: the IPv6 neighbour table

GetIpNetTable2(AF_INET6), GetIpNetEntry2 and the neighbour notifications' data
came back empty with STATUS_NOT_IMPLEMENTED: the IPv6 neighbour table was a
FIXME on every host. On Linux the table is now the kernel's neighbour cache
(an RTM_GETNEIGH dump over rtnetlink): the address, the interface (its LUID),
the link-layer address and the router flag (NTF_ROUTER), with the kernel's
neighbour states mapped to NL_NEIGHBOR_STATE as Microsoft documents it
(permanent and no-ARP static entries: Permanent; reachable; stale; delay;
probe; incomplete; failed: Unreachable, flagged IsUnreachable). A kernel
without IPv6 gives an empty table, as with IPv6 turned off. Entries of other
families, or without an address, are not reported.

SG_NSI_NEIGH6_DUMP (an absolute path to the raw bytes of a dump) stands in for
the kernel for the gate: a test machine may have no IPv6 to make a real one.
---
--- a/dlls/nsiproxy.sys/ip.c
+++ b/dlls/nsiproxy.sys/ip.c
@@ -141,6 +141,13 @@ struct ip6stat {
 #include <arpa/inet.h>
 #endif
 
+#ifdef HAVE_LINUX_RTNETLINK_H
+#include <errno.h>
+#include <unistd.h>
+#include <linux/rtnetlink.h>
+#include <linux/neighbour.h>
+#endif
+
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
 #include "windef.h"
@@ -1239,12 +1246,248 @@ static NTSTATUS ipv4_neighbour_enumerate_all( void *key_data, UINT key_size, voi
     return status;
 }
 
+struct ipv6_neighbour_data
+{
+    NET_LUID luid;
+    UINT if_index;
+    struct in6_addr addr;
+    BYTE phys_addr[IF_MAX_PHYS_ADDRESS_LENGTH];
+    UINT state;
+    USHORT phys_addr_len;
+    BOOL is_router;
+    BOOL is_unreachable;
+};
+
+static void ipv6_neighbour_fill_entry( struct ipv6_neighbour_data *entry, struct nsi_ipv6_neighbour_key *key,
+                                       struct nsi_ip_neighbour_rw *rw, struct nsi_ip_neighbour_dynamic *dyn )
+{
+    USHORT phys_addr_len = entry->phys_addr_len > sizeof(rw->phys_addr) ? 0 : entry->phys_addr_len;
+
+    if (key)
+    {
+        key->luid = entry->luid;
+        key->luid2 = entry->luid;
+        memcpy( &key->addr, &entry->addr, sizeof(key->addr) );
+    }
+
+    if (rw)
+    {
+        memcpy( rw->phys_addr, entry->phys_addr, phys_addr_len );
+        memset( rw->phys_addr + phys_addr_len, 0, sizeof(rw->phys_addr) - phys_addr_len );
+    }
+
+    if (dyn)
+    {
+        memset( dyn, 0, sizeof(*dyn) );
+        dyn->state = entry->state;
+        dyn->flags.is_router = entry->is_router;
+        dyn->flags.is_unreachable = entry->is_unreachable;
+        dyn->phys_addr_len = phys_addr_len;
+    }
+}
+
+#ifdef HAVE_LINUX_RTNETLINK_H
+
+/* NUD_* (the kernel's neighbour states) to NL_NEIGHBOR_STATE, which Microsoft
+ * documents as Unreachable, Incomplete, Probe, Delay, Stale, Reachable and
+ * Permanent. A static entry without resolution (NOARP) never goes stale: it is
+ * permanent. */
+static UINT neighbour_state_from_nud( unsigned int nud, BOOL *unreachable )
+{
+    *unreachable = FALSE;
+    if (nud & (NUD_PERMANENT | NUD_NOARP)) return NlnsPermanent;
+#ifdef SG_MUTANT_NEIGH6_STATE
+    if (nud & NUD_REACHABLE) return NlnsStale;
+#endif
+    if (nud & NUD_REACHABLE) return NlnsReachable;
+    if (nud & NUD_STALE) return NlnsStale;
+    if (nud & NUD_DELAY) return NlnsDelay;
+    if (nud & NUD_PROBE) return NlnsProbe;
+    if (nud & NUD_INCOMPLETE) return NlnsIncomplete;
+    *unreachable = TRUE;  /* NUD_FAILED */
+    return NlnsUnreachable;
+}
+
+struct neighbour_list
+{
+    struct ipv6_neighbour_data *entries;
+    unsigned int count, capacity;
+    int error;  /* a NLMSG_ERROR's errno */
+};
+
+/* returns 1 at NLMSG_DONE (or an error message), 0 when more is to come */
+static int parse_neighbour_messages( const BYTE *buf, size_t len, struct neighbour_list *list )
+{
+    const struct nlmsghdr *nlh = (const struct nlmsghdr *)buf;
+
+    for (; NLMSG_OK( nlh, len ); nlh = NLMSG_NEXT( nlh, len ))
+    {
+        const struct ndmsg *nd;
+        const struct rtattr *attr;
+        struct ipv6_neighbour_data entry;
+        BOOL have_addr = FALSE;
+        int attr_len;
+
+        if (nlh->nlmsg_type == NLMSG_DONE) return 1;
+        if (nlh->nlmsg_type == NLMSG_ERROR)
+        {
+            const struct nlmsgerr *err = NLMSG_DATA( nlh );
+
+            if (nlh->nlmsg_len >= NLMSG_LENGTH( sizeof(*err) )) list->error = -err->error;
+            return 1;
+        }
+        if (nlh->nlmsg_type != RTM_NEWNEIGH || nlh->nlmsg_len < NLMSG_LENGTH( sizeof(*nd) )) continue;
+
+        nd = NLMSG_DATA( nlh );
+#ifndef SG_MUTANT_NEIGH6_FAMILY
+        if (nd->ndm_family != AF_INET6) continue;
+#endif
+
+        memset( &entry, 0, sizeof(entry) );
+        entry.if_index = nd->ndm_ifindex;
+        entry.state = neighbour_state_from_nud( nd->ndm_state, &entry.is_unreachable );
+#ifndef SG_MUTANT_NEIGH6_ROUTER
+        entry.is_router = !!(nd->ndm_flags & NTF_ROUTER);
+#endif
+
+        attr = (const struct rtattr *)((const BYTE *)nd + NLMSG_ALIGN( sizeof(*nd) ));
+        attr_len = nlh->nlmsg_len - NLMSG_LENGTH( sizeof(*nd) );
+        for (; RTA_OK( attr, attr_len ); attr = RTA_NEXT( attr, attr_len ))
+        {
+            if (attr->rta_type == NDA_DST && RTA_PAYLOAD( attr ) == sizeof(entry.addr))
+            {
+                memcpy( &entry.addr, RTA_DATA( attr ), sizeof(entry.addr) );
+                have_addr = TRUE;
+            }
+            else if (attr->rta_type == NDA_LLADDR && RTA_PAYLOAD( attr ) <= sizeof(entry.phys_addr))
+            {
+                entry.phys_addr_len = RTA_PAYLOAD( attr );
+                memcpy( entry.phys_addr, RTA_DATA( attr ), entry.phys_addr_len );
+            }
+        }
+        if (!have_addr) continue;
+
+        if (list->count == list->capacity)
+        {
+            unsigned int capacity = list->capacity ? list->capacity * 2 : 32;
+            struct ipv6_neighbour_data *entries = realloc( list->entries, capacity * sizeof(*entries) );
+
+            if (!entries) { list->error = ENOMEM; return 1; }
+            list->entries = entries;
+            list->capacity = capacity;
+        }
+        list->entries[list->count++] = entry;
+    }
+    return 0;
+}
+
+static NTSTATUS read_ipv6_neighbours( struct neighbour_list *list )
+{
+    struct { struct nlmsghdr nlh; struct ndmsg nd; } req;
+    static BYTE buf[65536];  /* serialised by the callers' single thread of the driver */
+    struct sockaddr_nl addr = { .nl_family = AF_NETLINK };
+    NTSTATUS status = STATUS_SUCCESS;
+    const char *dump_file;
+    int fd, done = 0;
+    ssize_t len;
+
+    memset( list, 0, sizeof(*list) );
+
+    /* a test stand-in for the kernel: a file with the raw bytes of a dump */
+    if ((dump_file = getenv( "SG_NSI_NEIGH6_DUMP" )) && dump_file[0] == '/')
+    {
+        FILE *fp = fopen( dump_file, "rb" );
+        BYTE *data = malloc( 1 << 20 );
+
+        if (!fp || !data)
+        {
+            if (fp) fclose( fp );
+            free( data );
+            return STATUS_NOT_SUPPORTED;
+        }
+        len = fread( data, 1, 1 << 20, fp );
+        fclose( fp );
+        parse_neighbour_messages( data, len, list );
+        free( data );
+        return STATUS_SUCCESS;
+    }
+
+    if ((fd = socket( PF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_ROUTE )) == -1) return STATUS_NOT_SUPPORTED;
+
+    memset( &req, 0, sizeof(req) );
+    req.nlh.nlmsg_len = NLMSG_LENGTH( sizeof(req.nd) );
+    req.nlh.nlmsg_type = RTM_GETNEIGH;
+    req.nlh.nlmsg_flags = NLM_F_REQUEST | NLM_F_DUMP;
+    req.nlh.nlmsg_seq = 1;
+    req.nd.ndm_family = AF_INET6;
+    if (sendto( fd, &req, req.nlh.nlmsg_len, 0, (struct sockaddr *)&addr, sizeof(addr) ) == -1)
+    {
+        close( fd );
+        return STATUS_NOT_SUPPORTED;
+    }
+
+    while (!done)
+    {
+        len = recv( fd, buf, sizeof(buf), 0 );
+        if (len < 0 && errno == EINTR) continue;
+        if (len <= 0) { status = STATUS_NOT_SUPPORTED; break; }
+        done = parse_neighbour_messages( buf, len, list );
+    }
+    close( fd );
+
+    /* no IPv6 in the kernel is an empty table, as with IPv6 turned off */
+    if (list->error == EAFNOSUPPORT || list->error == EPROTONOSUPPORT) list->error = 0;
+    if (!status && list->error) status = (list->error == ENOMEM) ? STATUS_NO_MEMORY : STATUS_NOT_SUPPORTED;
+    if (status) { free( list->entries ); memset( list, 0, sizeof(*list) ); }
+    return status;
+}
+
+#endif /* HAVE_LINUX_RTNETLINK_H */
+
 static NTSTATUS ipv6_neighbour_enumerate_all( void *key_data, UINT key_size, void *rw_data, UINT rw_size,
                                               void *dynamic_data, UINT dynamic_size,
                                               void *static_data, UINT static_size, UINT_PTR *count )
 {
+#ifdef HAVE_LINUX_RTNETLINK_H
+    BOOL want_data = key_size || rw_size || dynamic_size || static_size;
+    NTSTATUS status = STATUS_SUCCESS;
+    struct neighbour_list list;
+    UINT num = 0, i;
+
+    TRACE( "%p %d %p %d %p %d %p %d %p\n", key_data, key_size, rw_data, rw_size,
+           dynamic_data, dynamic_size, static_data, static_size, count );
+
+    if ((status = read_ipv6_neighbours( &list ))) return status;
+#ifdef SG_MUTANT_NEIGH6_NONE
+    list.count = 0;
+#endif
+
+    for (i = 0; i < list.count; i++)
+    {
+        struct ipv6_neighbour_data *entry = &list.entries[i];
+
+        if (!convert_index_to_luid( entry->if_index, &entry->luid )) continue;
+
+        if (num < *count)
+        {
+            ipv6_neighbour_fill_entry( entry, key_data, rw_data, dynamic_data );
+
+            if (key_data) key_data = (BYTE *)key_data + key_size;
+            if (rw_data) rw_data = (BYTE *)rw_data + rw_size;
+            if (dynamic_data) dynamic_data = (BYTE *)dynamic_data + dynamic_size;
+            if (static_data) static_data = (BYTE *)static_data + static_size;
+        }
+        num++;
+    }
+    free( list.entries );
+
+    if (!want_data || num <= *count) *count = num;
+    else status = STATUS_BUFFER_OVERFLOW;
+    return status;
+#else
     FIXME( "not implemented\n" );
     return STATUS_NOT_IMPLEMENTED;
+#endif
 }
 
 struct ipv4_route_data
