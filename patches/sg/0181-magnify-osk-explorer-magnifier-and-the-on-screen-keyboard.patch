+/* Magnifier (sg-shell's, through magnify.exe and App Paths) takes its keys
+ * as commands to its window, class SgMagnifier: 0x101 zooms in, 0x102 out. */
+#define MAGNIFIER_ZOOM_IN  0x101
+#define MAGNIFIER_ZOOM_OUT 0x102
+
+static void magnifier( UINT cmd )
+{
+    HWND mag = FindWindowW( L"SgMagnifier", NULL );
+
+    if (mag)
+    {
+        if (cmd == WM_CLOSE) PostMessageW( mag, WM_CLOSE, 0, 0 );
+        else PostMessageW( mag, WM_COMMAND, cmd, 0 );
+    }
+    /* Win+Plus starts Magnifier; Win+Minus and Win+Esc do nothing without it */
+    else if (cmd == MAGNIFIER_ZOOM_IN) run( L"magnify.exe", NULL );
+}
+
+/* Win+Ctrl+O turns the On-Screen Keyboard on and off, as on Windows */
+static void on_screen_keyboard(void)
+{
+    HWND osk = FindWindowW( L"OSKMainClass", NULL );
+
+    if (osk) PostMessageW( osk, WM_CLOSE, 0, 0 );
+    else run( L"osk.exe", NULL );
+}
+
 /* Settings, at the page an ms-settings: URI names, as Windows opens it; the
  * Control Panel (and its page) where no Settings app is registered. */
 static void run_settings( const WCHAR *uri, const WCHAR *control_params )
