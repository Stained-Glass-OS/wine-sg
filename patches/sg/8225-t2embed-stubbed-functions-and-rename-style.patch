From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] t2embed: TTEmbedFontEx, TTGetNewFontName, TTCharToUnicode, TTRunValidationTests(Ex); renamed fonts keep their style name

The functions the spec file only stubbed: TTEmbedFontEx (UCS-4 codes, the whole font as TTEmbedFont), TTGetNewFontName (the family of a font TTLoadEmbeddedFont loaded, the new one when renamed), TTCharToUnicode (8-bit codes of the DC's font: symbol fonts to U+F0xx, others through their code page), TTRunValidationTests/Ex (the font's tables are there and each code has a glyph that outlines at each size). A font loaded under a new name now keeps its subfamily (name 2): without it FreeType refused fonts with embedded bitmaps, and TTLoadEmbeddedFont failed with E_ADDFONTFAILED. t2embapi.h gains the declarations and the validation structures.
---
--- a/dlls/t2embed/main.c
+++ b/dlls/t2embed/main.c
@@ -22,6 +22,7 @@
 
 #include "windef.h"
 #include "winbase.h"
+#include "winnls.h"
 #include "wingdi.h"
 #include "winreg.h"
 #include "t2embapi.h"
@@ -377,16 +378,52 @@
 }
 
 /* the font with its family name changed (the Windows names of the name table) */
+#ifndef SG_MUTANT_T2EMBED_NO_EXTRAS
+/* (wine-sg 8225) the font's subfamily (name 2, Windows platform, US English), "Regular" if it has none:
+ * a renamed font keeps its style name -- FreeType refuses a face without one */
+static void font_subfamily( const BYTE *font, DWORD size, DWORD name_off, WCHAR *out, int count )
+{
+    DWORD off = get_be32( font + name_off + 8 ), len = get_be32( font + name_off + 12 ), n, i, k;
+    const BYTE *table = font + off;
+
+    lstrcpyW( out, L"Regular" );
+    if (off > size || len > size - off || len < 6) return;
+    n = get_be16( table + 2 );
+    for (i = 0; i < n && 6 + (i + 1) * 12 <= len; i++)
+    {
+        const BYTE *rec = table + 6 + i * 12;
+        DWORD str = get_be16( table + 4 ) + get_be16( rec + 10 ), slen = get_be16( rec + 8 );
+        if (get_be16( rec ) != 3 || get_be16( rec + 4 ) != 0x409 || get_be16( rec + 6 ) != 2) continue;
+        if (str + slen > len || !slen) return;
+        for (k = 0; k < slen / 2 && k < (DWORD)count - 1; k++) out[k] = get_be16( table + str + k * 2 );
+        out[k] = 0;
+        return;
+    }
+}
+#endif
+
 static BYTE *rename_font( const BYTE *font, DWORD size, const WCHAR *family, DWORD *new_size )
 {
+#ifndef SG_MUTANT_T2EMBED_NO_EXTRAS
+    static const WORD ids[] = { 1, 2, 4, 6, 16 };
+    WCHAR style[64];
+    DWORD style_len;
+#else
     static const WORD ids[] = { 1, 4, 6, 16 };
+#endif
     DWORD count = get_be16( font + 4 ), i, j, name_off = 0, name_len, len = lstrlenW( family ) * 2, pos;
     BYTE *ret, *table;
 
     for (i = 0; i < count; i++)
         if (get_be32( font + 12 + i * 16 ) == TAG('n','a','m','e')) name_off = 12 + i * 16;
     if (!name_off) return NULL;
+#ifndef SG_MUTANT_T2EMBED_NO_EXTRAS
+    font_subfamily( font, size, name_off, style, ARRAY_SIZE(style) );
+    style_len = lstrlenW( style ) * 2;
+    name_len = 6 + ARRAY_SIZE(ids) * 12 + (ARRAY_SIZE(ids) - 1) * len + style_len;
+#else
     name_len = 6 + ARRAY_SIZE(ids) * 12 + ARRAY_SIZE(ids) * len;
+#endif
     *new_size = ((size + 3) & ~3) + name_len;
     if (!(ret = calloc( 1, *new_size ))) return NULL;
     memcpy( ret, font, size );
@@ -398,20 +435,85 @@
     for (i = 0; i < ARRAY_SIZE(ids); i++)
     {
         BYTE *rec = table + 6 + i * 12, *str = table + 6 + ARRAY_SIZE(ids) * 12 + pos;
+        const WCHAR *text = family;
+        DWORD text_len = len;
+#ifndef SG_MUTANT_T2EMBED_NO_EXTRAS
+        if (ids[i] == 2) { text = style; text_len = style_len; }
+#endif
         put_be16( rec, 3 );
         put_be16( rec + 2, 1 );
         put_be16( rec + 4, 0x409 );
         put_be16( rec + 6, ids[i] );
-        put_be16( rec + 8, len );
+        put_be16( rec + 8, text_len );
         put_be16( rec + 10, pos );
-        for (j = 0; j < len / 2; j++) put_be16( str + j * 2, family[j] );
-        pos += len;
+        for (j = 0; j < text_len / 2; j++) put_be16( str + j * 2, text[j] );
+        pos += text_len;
     }
     put_be32( ret + name_off + 8, table - ret );
     put_be32( ret + name_off + 12, name_len );
     return ret;
 }
 
+#ifndef SG_MUTANT_T2EMBED_NO_EXTRAS
+/* (wine-sg 8225) the family name each font loaded by TTLoadEmbeddedFont has, for TTGetNewFontName */
+struct loaded_name
+{
+    HANDLE handle;
+    WCHAR name[LF_FACESIZE];
+};
+static struct loaded_name *loaded_names;
+static SIZE_T loaded_count, loaded_size;
+static CRITICAL_SECTION names_cs;
+static CRITICAL_SECTION_DEBUG names_cs_debug =
+{
+    0, 0, &names_cs,
+    { &names_cs_debug.ProcessLocksList, &names_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": names_cs") }
+};
+static CRITICAL_SECTION names_cs = { &names_cs_debug, -1, 0, 0, 0, 0 };
+
+static void remember_name( HANDLE handle, const WCHAR *name )
+{
+    EnterCriticalSection( &names_cs );
+    if (loaded_count == loaded_size)
+    {
+        SIZE_T size = max( 8, loaded_size * 2 );
+        struct loaded_name *n = realloc( loaded_names, size * sizeof(*n) );
+        if (!n) { LeaveCriticalSection( &names_cs ); return; }
+        loaded_names = n;
+        loaded_size = size;
+    }
+    loaded_names[loaded_count].handle = handle;
+    lstrcpynW( loaded_names[loaded_count].name, name, LF_FACESIZE );
+    loaded_count++;
+    LeaveCriticalSection( &names_cs );
+}
+
+static void forget_name( HANDLE handle )
+{
+    SIZE_T i;
+    EnterCriticalSection( &names_cs );
+    for (i = 0; i < loaded_count; i++)
+        if (loaded_names[i].handle == handle)
+        {
+            loaded_names[i] = loaded_names[--loaded_count];
+            break;
+        }
+    LeaveCriticalSection( &names_cs );
+}
+
+/* the family name of an EOT header: FamilyNameSize at 82, then the UTF-16LE name */
+static void eot_family( const struct eot *eot, WCHAR *name, int count )
+{
+    USHORT len = eot->size >= 84 ? *(const USHORT *)(eot->header + 82) : 0;
+    int i;
+
+    if (len > eot->size - 84) len = 0;
+    for (i = 0; i < len / 2 && i < count - 1; i++) name[i] = ((const WCHAR *)(eot->header + 84))[i];
+    name[i] = 0;
+}
+#endif
+
 LONG WINAPI TTLoadEmbeddedFont(HANDLE *phFontReference, ULONG ulFlags,
                                ULONG *pulPrivStatus, ULONG ulPrivs,
                                ULONG *pulStatus, READEMBEDPROC lpfnReadFromStream,
@@ -457,6 +559,15 @@
     handle = AddFontMemResourceEx( renamed ? renamed : eot.font, size, NULL, &fonts );
 #endif
     free( renamed );
+#ifndef SG_MUTANT_T2EMBED_NO_EXTRAS
+    if (handle && fonts)
+    {
+        WCHAR family[LF_FACESIZE];
+        if (szWinFamilyName && *szWinFamilyName) lstrcpynW( family, szWinFamilyName, LF_FACESIZE );
+        else eot_family( &eot, family, LF_FACESIZE );
+        remember_name( handle, family );
+    }
+#endif
     free( eot.header );
     if (!handle || !fonts) return E_ADDFONTFAILED;
     *phFontReference = handle;
@@ -612,5 +723,161 @@
     if (!status) return E_STATUSINVALID;
     *status = 0;
     if (!hFontReference || !RemoveFontMemResourceEx( hFontReference )) return E_FONTREFERENCEINVALID;
+#ifndef SG_MUTANT_T2EMBED_NO_EXTRAS
+    forget_name( hFontReference );
+#endif
     return E_NONE;
 }
