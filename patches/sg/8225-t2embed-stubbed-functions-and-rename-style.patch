+#ifndef SG_MUTANT_T2EMBED_NO_EXTRAS
+/* Stained Glass OS (wine-sg 8225): the t2embed functions the spec file only stubbed */
+
+/* TTEmbedFont with UCS-4 character codes */
+LONG WINAPI TTEmbedFontEx(HDC hDC, ULONG ulFlags, ULONG ulCharSet, ULONG *pulPrivStatus, ULONG *pulStatus,
+                          WRITEEMBEDPROC lpfnWriteToStream, LPVOID lpvWriteStream, ULONG *pulCharCodeSet,
+                          USHORT usCharCodeCount, USHORT usLanguage, TTEMBEDINFO *pTTEmbedInfo)
+{
+    BYTE *data;
+    DWORD size;
+    LONG ret;
+
+    TRACE("%p, %#lx, %lu, %p, %p, %p, %p, %p, %u, %u, %p\n", hDC, ulFlags, ulCharSet, pulPrivStatus, pulStatus,
+          lpfnWriteToStream, lpvWriteStream, pulCharCodeSet, usCharCodeCount, usLanguage, pTTEmbedInfo);
+
+    /* the whole font is embedded (no subsetting yet), so the codes only need to be there */
+    if ((ret = check_embed_args( ulFlags, ulCharSet, pulPrivStatus, pulStatus, lpfnWriteToStream, lpvWriteStream,
+                                 (USHORT *)pulCharCodeSet, usCharCodeCount ))) return ret;
+    if ((ret = embed_font_from_dc( hDC, &data, &size ))) return ret;
+    ret = embed_font_data( data, size, ulFlags, pulPrivStatus, pulStatus, lpfnWriteToStream, lpvWriteStream, pTTEmbedInfo );
+    free( data );
+    return ret;
+}
+
+/* the family name of a font TTLoadEmbeddedFont loaded (the new one when it was renamed) */
+LONG WINAPI TTGetNewFontName(HANDLE *phFontReference, LPWSTR wzWinFamilyName, LONG cchMaxWinName,
+                             LPSTR szMacFamilyName, LONG cchMaxMacName)
+{
+    WCHAR name[LF_FACESIZE];
+    BOOL found = FALSE;
+    SIZE_T i;
+
+    TRACE("%p, %p, %ld, %p, %ld\n", phFontReference, wzWinFamilyName, cchMaxWinName, szMacFamilyName, cchMaxMacName);
+
+    if (!phFontReference) return E_FONTREFERENCEINVALID;
+    if (!wzWinFamilyName || cchMaxWinName <= 0) return E_INPUTPARAMINVALID;
+    EnterCriticalSection( &names_cs );
+    for (i = 0; i < loaded_count; i++)
+        if (loaded_names[i].handle == *phFontReference)
+        {
+            lstrcpyW( name, loaded_names[i].name );
+            found = TRUE;
+            break;
+        }
+    LeaveCriticalSection( &names_cs );
+    if (!found) return E_FONTREFERENCEINVALID;
+    if ((LONG)lstrlenW( name ) >= cchMaxWinName) return E_INPUTPARAMINVALID;
+    lstrcpyW( wzWinFamilyName, name );
+    if (szMacFamilyName && cchMaxMacName > 0)
+        WideCharToMultiByte( CP_MACCP, 0, name, -1, szMacFamilyName, cchMaxMacName, NULL, NULL );
+    return E_NONE;
+}
+
+/* 8-bit character codes of the DC's font to Unicode: a symbol font's are U+F0xx, others go through the
+ * code page of the font's character set */
+LONG WINAPI TTCharToUnicode(HDC hDC, UCHAR *pucCharCodes, ULONG ulCharCodeSize, USHORT *pusShortCodes,
+                            ULONG ulShortCodeSize, ULONG ulFlags)
+{
+    CHARSETINFO csi;
+    UINT charset;
+    ULONG i;
+
+    TRACE("%p, %p, %lu, %p, %lu, %#lx\n", hDC, pucCharCodes, ulCharCodeSize, pusShortCodes, ulShortCodeSize, ulFlags);
+
+    if (!hDC) return E_HDCINVALID;
+    if (!pucCharCodes || !pusShortCodes) return E_INPUTPARAMINVALID;
+    if (!ulCharCodeSize || ulShortCodeSize < ulCharCodeSize) return E_CHARCODECOUNTINVALID;
+    charset = GetTextCharset( hDC );
+    if (charset == DEFAULT_CHARSET && GetObjectType( hDC ) == 0) return E_HDCINVALID;
+    if (charset == SYMBOL_CHARSET)
+    {
+        for (i = 0; i < ulCharCodeSize; i++) pusShortCodes[i] = 0xf000 | pucCharCodes[i];
+        return E_NONE;
+    }
+    if (!TranslateCharsetInfo( (DWORD *)(UINT_PTR)charset, &csi, TCI_SRCCHARSET )) csi.ciACP = CP_ACP;
+    if (MultiByteToWideChar( csi.ciACP, 0, (const char *)pucCharCodes, ulCharCodeSize, (WCHAR *)pusShortCodes,
+                             ulShortCodeSize ) != (int)ulCharCodeSize)
+        return E_WINDOWSAPI;
+    return E_NONE;
+}
+
+/* the font in the DC holds together: its tables are there, and each character asked for has a glyph that
+ * outlines at each size asked for */
+static LONG validate_font( HDC hdc, LONG from, LONG to, ULONG count, const ULONG *codes32, const USHORT *codes16 )
+{
+    static const DWORD tables[] = { 0x64616568 /* head */, 0x7078616d /* maxp */, 0x70616d63 /* cmap */,
+                                    0x61656868 /* hhea */, 0x78746d68 /* hmtx */, 0x656d616e /* name */ };
+    LOGFONTW lf;
+    HFONT font, old;
+    GLYPHMETRICS gm;
+    MAT2 mat = { {0, 1}, {0, 0}, {0, 0}, {0, 1} };
+    LONG size, ret = E_NONE;
+    ULONG i;
+
+    if (GetFontData( hdc, 0, 0, NULL, 0 ) == GDI_ERROR) return E_NOTATRUETYPEFONT;
+    for (i = 0; i < ARRAY_SIZE(tables); i++)
+        if (GetFontData( hdc, tables[i], 0, NULL, 0 ) == GDI_ERROR) return E_FONTDATAINVALID;
+    if (!count) return E_NONE;
+    if (from <= 0) from = 1;
+    if (to < from) to = from;
+    if (to - from > 200) to = from + 200;   /* bounded */
+    if (!GetObjectW( GetCurrentObject( hdc, OBJ_FONT ), sizeof(lf), &lf )) return E_HDCINVALID;
+    for (size = from; size <= to && !ret; size++)
+    {
+        lf.lfHeight = -size;
+        lf.lfWidth = 0;
+        if (!(font = CreateFontIndirectW( &lf ))) return E_WINDOWSAPI;
+        old = SelectObject( hdc, font );
+        for (i = 0; i < count && !ret; i++)
+        {
+            WCHAR ch = codes32 ? (WCHAR)codes32[i] : codes16[i];
+            WORD glyph = 0xffff;
+            if (GetGlyphIndicesW( hdc, &ch, 1, &glyph, GGI_MARK_NONEXISTING_GLYPHS ) == GDI_ERROR || glyph == 0xffff ||
+                GetGlyphOutlineW( hdc, ch, GGO_METRICS, &gm, 0, NULL, &mat ) == GDI_ERROR)
+                ret = E_FONTDATAINVALID;
+        }
+        SelectObject( hdc, old );
+        DeleteObject( font );
+    }
+    return ret;
+}
+
+LONG WINAPI TTRunValidationTests(HDC hTestDC, TTVALIDATIONTESTSPARAMS *pTestParam)
+{
+    TRACE("%p, %p\n", hTestDC, pTestParam);
+
+    if (!hTestDC) return E_HDCINVALID;
+    if (!pTestParam || pTestParam->ulStructSize < sizeof(*pTestParam)) return E_INPUTPARAMINVALID;
+    if (pTestParam->usCharCodeCount && !pTestParam->pusCharCodeSet) return E_CHARCODESETINVALID;
+    return validate_font( hTestDC, pTestParam->lTestFromSize, pTestParam->lTestToSize, pTestParam->usCharCodeCount,
+                          NULL, pTestParam->pusCharCodeSet );
+}
+
+LONG WINAPI TTRunValidationTestsEx(HDC hTestDC, TTVALIDATIONTESTSPARAMSEX *pTestParam)
+{
+    TRACE("%p, %p\n", hTestDC, pTestParam);
+
+    if (!hTestDC) return E_HDCINVALID;
+    if (!pTestParam || pTestParam->ulStructSize < sizeof(*pTestParam)) return E_INPUTPARAMINVALID;
+    if (pTestParam->usCharCodeCount && !pTestParam->pulCharCodeSet) return E_CHARCODESETINVALID;
+    return validate_font( hTestDC, pTestParam->lTestFromSize, pTestParam->lTestToSize, pTestParam->usCharCodeCount,
+                          pTestParam->pulCharCodeSet, NULL );
+}
+#else
+LONG WINAPI TTEmbedFontEx(HDC hDC, ULONG ulFlags, ULONG ulCharSet, ULONG *pulPrivStatus, ULONG *pulStatus,
+                          WRITEEMBEDPROC lpfnWriteToStream, LPVOID lpvWriteStream, ULONG *pulCharCodeSet,
+                          USHORT usCharCodeCount, USHORT usLanguage, TTEMBEDINFO *pTTEmbedInfo) { return E_API_NOTIMPL; }
+LONG WINAPI TTGetNewFontName(HANDLE *ref, LPWSTR win, LONG cwin, LPSTR mac, LONG cmac) { return E_API_NOTIMPL; }
+LONG WINAPI TTCharToUnicode(HDC dc, UCHAR *in, ULONG cin, USHORT *out, ULONG cout, ULONG flags) { return E_API_NOTIMPL; }
+LONG WINAPI TTRunValidationTests(HDC dc, TTVALIDATIONTESTSPARAMS *p) { return E_API_NOTIMPL; }
+LONG WINAPI TTRunValidationTestsEx(HDC dc, TTVALIDATIONTESTSPARAMSEX *p) { return E_API_NOTIMPL; }
+#endif
