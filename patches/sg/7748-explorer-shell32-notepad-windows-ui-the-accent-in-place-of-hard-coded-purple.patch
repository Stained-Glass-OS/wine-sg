From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer, shell32, notepad, windows.ui: the accent in place of the purple drawn by hand

What we draw ourselves in the default accent's shades now draws the
accent's: wine/sg_accent.h reads the accent (again as soon as the key
changes: the key is watched, so the repaint after "ImmersiveColorSet" has
the new one) and turns a colour designed against Stained Glass purple into
the same shade of the accent, as uxtheme does to the style (7746).

- File Explorer: hover, pressed, selected, its accent and dark accent.
- The folder view's selection tint (shell32), Open With's "recommended"
  label, the file operation dialog's accent, hover and progress.
- The taskbar reads its pins again on a new accent: their icons were made
  once, when the pins were read (7747 makes our programs' icons follow).
- The taskbar: a running program's mark under its button; the accent is
  read again as soon as it changes, not up to a second later. With no
  accent chosen the taskbar keeps its own purple, as before.
- Task View and the snap preview take the taskbar's accent.
- Notepad: the current line, the selection, matching brackets, the gutter's
  current line number, its chrome's accent (both modes). Syntax colours are
  the language's and stay.
- Toast notifications: their accent and their purple-greys.
---
--- /dev/null
+++ b/include/wine/sg_accent.h
@@ -0,0 +1,117 @@
+/*
+ * Stained Glass OS: the accent colour, and the default accent's shades as the
+ * accent's (wine-sg 7748)
+ *
+ * The accent is Personalization's, HKCU\Software\Microsoft\Windows\DWM
+ * AccentColor (0xAABBGGRR: its low three bytes are a COLORREF). It is read
+ * again only once the key changed: the key is watched, so the repaint that
+ * follows WM_SETTINGCHANGE "ImmersiveColorSet" already has the new one.
+ *
+ * sg_accent_shade() takes a colour drawn against the default accent
+ * (Stained Glass purple, 0x7B2FBE) -- a selection's tint, a hover's, a dark
+ * mode's lighter purple -- and gives the same shade of the accent: its hue
+ * becomes the accent's, its saturation and value keep their place relative to
+ * the key's (below it they scale, above it the rest of the way to full
+ * scales), so a pale tint stays pale and a deep shade deep. Colours of another
+ * hue come back unchanged. uxtheme does the same to our visual style and
+ * sg-shell's sg-mode.h to the shell's programs.
+ */
+
+#ifndef __WINE_SG_ACCENT_H
+#define __WINE_SG_ACCENT_H
+
+#include <windef.h>
+#include <winbase.h>
+#include <wingdi.h>
+#include <winreg.h>
+
+#define SG_ACCENT_DEFAULT RGB(0x7b, 0x2f, 0xbe)
+
+static inline COLORREF sg_accent_color(void)
+{
+    static COLORREF cached = SG_ACCENT_DEFAULT;
+    static HKEY key;
+    static HANDLE changed;
+    static BOOL have, watching;
+    DWORD value, size = sizeof(value);
+    BOOL read = !have;
+
+    /* the key is created if no accent was ever chosen: one not there cannot be watched */
+    if (!watching && !have &&
+        !RegCreateKeyExW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\DWM", 0, NULL, 0, KEY_NOTIFY, NULL, &key, NULL ) &&
+        (changed = CreateEventW( NULL, FALSE, FALSE, NULL )))
+        watching = TRUE;
+    if (!watching) read = TRUE;
+    else if (have && !WaitForSingleObject( changed, 0 )) read = TRUE;
+    if (watching && read)
+        RegNotifyChangeKeyValue( key, FALSE, REG_NOTIFY_CHANGE_LAST_SET, changed, TRUE );
+    if (read)
+    {
+        if (!RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\DWM", L"AccentColor",
+                           RRF_RT_REG_DWORD, NULL, &value, &size ))
+            cached = value & 0xffffff;
+        else
+            cached = SG_ACCENT_DEFAULT;
+        have = TRUE;
+    }
+    return cached;
+}
+
+static inline void sg_accent_hsv( COLORREF c, double *h, double *s, double *v )
+{
+    double r = GetRValue(c) / 255.0, g = GetGValue(c) / 255.0, b = GetBValue(c) / 255.0;
+    double hi = r > g ? (r > b ? r : b) : (g > b ? g : b), lo = r < g ? (r < b ? r : b) : (g < b ? g : b);
+    double d = hi - lo;
+
+    *v = hi;
+    *s = hi > 0 ? d / hi : 0;
+    if (d <= 0) *h = 0;
+    else if (hi == r) *h = 60 * ((g - b) / d);
+    else if (hi == g) *h = 60 * ((b - r) / d + 2);
+    else *h = 60 * ((r - g) / d + 4);
+    if (*h < 0) *h += 360;
+}
+
+static inline double sg_accent_shift( double x, double key, double accent )
+{
+    return x <= key ? x * accent / key : accent + (x - key) / (1 - key) * (1 - accent);
+}
+
+static inline COLORREF sg_accent_shade_with( COLORREF designed, COLORREF accent )
+{
+    const double key_h = 271.88, key_s = 0.7526, key_v = 0.7451;
+    double h, s, v, ah, as, av, dh, c, x, m, hh, r, g, b;
+    int i;
+
+#ifdef SG_MUTANT_WINE_SHADE_FIXED
+    return designed;
+#endif
+    if (accent == SG_ACCENT_DEFAULT) return designed;
+    sg_accent_hsv( designed, &h, &s, &v );
+    dh = h > key_h ? h - key_h : key_h - h;
+    if (dh > 180) dh = 360 - dh;
+    if (dh > 22 || s < 0.04 || v < 0.15) return designed;
+    sg_accent_hsv( accent, &ah, &as, &av );
+    s = sg_accent_shift( s, key_s, as ); if (s > 1) s = 1;
+    v = sg_accent_shift( v, key_v, av ); if (v > 1) v = 1;
+    c = v * s; m = v - c; hh = ah / 60; i = (int)hh % 6;
+    x = hh - 2 * (int)(hh / 2) - 1; if (x < 0) x = -x;
+    x = c * (1 - x);
+    switch (i)
+    {
+    case 0: r = c; g = x; b = 0; break;
+    case 1: r = x; g = c; b = 0; break;
+    case 2: r = 0; g = c; b = x; break;
+    case 3: r = 0; g = x; b = c; break;
+    case 4: r = x; g = 0; b = c; break;
+    default: r = c; g = 0; b = x; break;
+    }
+    return RGB( (BYTE)((r + m) * 255 + 0.5), (BYTE)((g + m) * 255 + 0.5), (BYTE)((b + m) * 255 + 0.5) );
+}
+
+static inline COLORREF sg_accent_shade( COLORREF designed )
+{
+    return sg_accent_shade_with( designed, sg_accent_color() );
+}
+
+#endif /* __WINE_SG_ACCENT_H */
