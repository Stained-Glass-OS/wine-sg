From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dinput: IDirectInputDevice::Initialize, RunControlPanel, GetImageInfo, IDirectInput7::FindDevice, LockServer

FIXME stubs that returned DI_OK, as documented now (and as dinput's
conformance tests joystick8.c / device8.c expect):

- IDirectInputDevice::Initialize: the version is checked against the one of
  the DirectInput object (DIERR_BETADIRECTINPUTVERSION / OLD...), a NULL guid
  is E_POINTER, a NULL instance DIERR_INVALIDPARAM, and the guid must be the
  device's instance or product guid (or the emulated mouse/keyboard of its
  class) or the answer is REGDB_E_CLASSNOTREG. The todo_wine marks of
  joystick8.c that now pass are removed.
- IDirectInputDevice::RunControlPanel: E_HANDLE for a bad window,
  DIERR_INVALIDPARAM for flags, otherwise the default control panel is started.
- IDirectInputDevice8::GetImageInfo: the size fields are checked and the
  answer is "no views" with the device's button, axis and POV counts.
- IDirectInput7::FindDevice: the instance guid of the attached device of the
  class (mouse, keyboard, joystick) whose instance or product name is the
  given one, DIERR_DEVICENOTREG when there is none.
- The class factory's LockServer: S_OK without the FIXME.

---
diff --git a/dlls/dinput/device.c b/dlls/dinput/device.c
index 4166d18..e556acf 100644
--- a/dlls/dinput/device.c
+++ b/dlls/dinput/device.c
@@ -1558,15 +1558,56 @@ static HRESULT WINAPI dinput_device_GetDeviceData( IDirectInputDevice8W *iface,
 
 static HRESULT WINAPI dinput_device_RunControlPanel( IDirectInputDevice8W *iface, HWND hwnd, DWORD flags )
 {
-    FIXME( "iface %p, hwnd %p, flags %#lx stub!\n", iface, hwnd, flags );
+    WCHAR control_exe[] = {L"control.exe"};
+    STARTUPINFOW si = {0};
+    PROCESS_INFORMATION pi;
+
+    TRACE( "iface %p, hwnd %p, flags %#lx.\n", iface, hwnd, flags );
+
+    if (hwnd && !IsWindow( hwnd )) return E_HANDLE;
+    if (flags) return DIERR_INVALIDPARAM;
+
+    /* the default device control panel: there is no panel of the device's own */
+    if (!CreateProcessW( NULL, control_exe, NULL, NULL, FALSE, DETACHED_PROCESS, NULL, NULL, &si, &pi ))
+        return HRESULT_FROM_WIN32(GetLastError());
+    CloseHandle( pi.hThread );
+    CloseHandle( pi.hProcess );
+
     return DI_OK;
 }
 
 static HRESULT WINAPI dinput_device_Initialize( IDirectInputDevice8W *iface, HINSTANCE instance,
                                                 DWORD version, const GUID *guid )
 {
-    FIXME( "iface %p, instance %p, version %#lx, guid %s stub!\n", iface, instance, version,
-           debugstr_guid( guid ) );
+    struct dinput_device *impl = impl_from_IDirectInputDevice8W( iface );
+    BOOL known;
+
+    TRACE( "iface %p, instance %p, version %#lx, guid %s.\n", iface, instance, version, debugstr_guid( guid ) );
+
+    /* the version is that of the DirectInput object the device was made by */
+    if (version == 0) return DIERR_NOTINITIALIZED;
+    if (version < impl->dinput->dwVersion) return DIERR_BETADIRECTINPUTVERSION;
+    if (version > impl->dinput->dwVersion) return DIERR_OLDDIRECTINPUTVERSION;
+    if (!guid) return E_POINTER;
+    if (!instance) return DIERR_INVALIDPARAM;
+
+    /* the device can be initialized again as the device it is: by its instance or product guid, or
+     * as the emulated mouse or keyboard */
+    if (IsEqualGUID( &impl->guid, &GUID_SysMouse ) || IsEqualGUID( &impl->guid, &GUID_SysMouseEm ) ||
+        IsEqualGUID( &impl->guid, &GUID_SysMouseEm2 ))
+        known = IsEqualGUID( guid, &GUID_SysMouse ) || IsEqualGUID( guid, &GUID_SysMouseEm ) ||
+                IsEqualGUID( guid, &GUID_SysMouseEm2 );
+    else if (IsEqualGUID( &impl->guid, &GUID_SysKeyboard ) || IsEqualGUID( &impl->guid, &GUID_SysKeyboardEm ) ||
+             IsEqualGUID( &impl->guid, &GUID_SysKeyboardEm2 ))
+        known = IsEqualGUID( guid, &GUID_SysKeyboard ) || IsEqualGUID( guid, &GUID_SysKeyboardEm ) ||
+                IsEqualGUID( guid, &GUID_SysKeyboardEm2 );
+    else
+        known = IsEqualGUID( guid, &impl->instance.guidInstance ) || IsEqualGUID( guid, &impl->instance.guidProduct );
+#ifdef SG_MUTANT_DINPUT_INIT_GUID
+    known = TRUE;
+#endif
+    if (!known) return REGDB_E_CLASSNOTREG;
+
     return DI_OK;
 }
 
@@ -2088,7 +2129,25 @@ static HRESULT WINAPI dinput_device_SetActionMap( IDirectInputDevice8W *iface, D
 
 static HRESULT WINAPI dinput_device_GetImageInfo( IDirectInputDevice8W *iface, DIDEVICEIMAGEINFOHEADERW *header )
 {
-    FIXME( "iface %p, header %p stub!\n", iface, header );
+    struct dinput_device *impl = impl_from_IDirectInputDevice8W( iface );
+
+    TRACE( "iface %p, header %p.\n", iface, header );
+
+    if (!header) return E_POINTER;
+    if (header->dwSize != sizeof(*header) || header->dwSizeImageInfo != sizeof(DIDEVICEIMAGEINFOW))
+        return DIERR_INVALIDPARAM;
+
+    /* no device image is available: no views, whatever the buffer, and the controls are counted */
+#ifdef SG_MUTANT_DINPUT_IMAGE_VIEWS
+    header->dwcViews = 1;
+#else
+    header->dwcViews = 0;
+#endif
+    header->dwcButtons = impl->caps.dwButtons;
+    header->dwcAxes = impl->caps.dwAxes;
+    header->dwcPOVs = impl->caps.dwPOVs;
+    header->dwBufferUsed = 0;
+
     return DI_OK;
 }
 
diff --git a/dlls/dinput/dinput.c b/dlls/dinput/dinput.c
index e53eea4..2467d51 100644
--- a/dlls/dinput/dinput.c
+++ b/dlls/dinput/dinput.c
@@ -257,11 +257,48 @@ static HRESULT WINAPI dinput7_RunControlPanel( IDirectInput7W *iface, HWND owner
     return DI_OK;
 }
 
+struct find_device_params
+{
+    const WCHAR *name;
+    GUID *instance_guid;
+    BOOL found;
+};
+
+static BOOL CALLBACK find_device_callback( const DIDEVICEINSTANCEW *instance, void *context )
+{
+    struct find_device_params *params = context;
+
+#ifdef SG_MUTANT_DINPUT_FIND_NAME
+    return DIENUM_CONTINUE;
+#endif
+    if (wcsicmp( instance->tszInstanceName, params->name ) && wcsicmp( instance->tszProductName, params->name ))
+        return DIENUM_CONTINUE;
+
+    *params->instance_guid = instance->guidInstance;
+    params->found = TRUE;
+    return DIENUM_STOP;
+}
+
 static HRESULT WINAPI dinput7_FindDevice( IDirectInput7W *iface, const GUID *guid, const WCHAR *name, GUID *instance_guid )
 {
-    FIXME( "iface %p, guid %s, name %s, instance_guid %s stub!\n", iface, debugstr_guid( guid ),
+    struct dinput *impl = impl_from_IDirectInput7W( iface );
+    struct find_device_params params = {.name = name, .instance_guid = instance_guid};
+    DWORD type;
+
+    TRACE( "iface %p, guid %s, name %s, instance_guid %s.\n", iface, debugstr_guid( guid ),
            debugstr_w(name), debugstr_guid( instance_guid ) );
-    return DI_OK;
+
+    if (!guid || !name || !instance_guid) return E_POINTER;
+    if (!impl->dwVersion) return DIERR_NOTINITIALIZED;
+
+    /* the class is that of the system device: mouse, keyboard or joysticks */
+    if (IsEqualGUID( guid, &GUID_SysMouse )) type = DI8DEVCLASS_POINTER;
+    else if (IsEqualGUID( guid, &GUID_SysKeyboard )) type = DI8DEVCLASS_KEYBOARD;
+    else if (IsEqualGUID( guid, &GUID_Joystick )) type = DI8DEVCLASS_GAMECTRL;
+    else return DIERR_DEVICENOTREG;
+
+    IDirectInput7_EnumDevices( iface, type, find_device_callback, &params, DIEDFL_ATTACHEDONLY );
+    return params.found ? DI_OK : DIERR_DEVICENOTREG;
 }
 
 static HRESULT WINAPI dinput7_CreateDeviceEx( IDirectInput7W *iface, const GUID *guid,
@@ -859,7 +896,8 @@ static HRESULT WINAPI class_factory_CreateInstance( IClassFactory *iface, IUnkno
 
 static HRESULT WINAPI class_factory_LockServer( IClassFactory *iface, BOOL lock )
 {
-    FIXME( "iface %p, lock %d stub!\n", iface, lock );
+    TRACE( "iface %p, lock %d.\n", iface, lock );
+    /* the factory is static: there is nothing to keep loaded */
     return S_OK;
 }
 
