From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHGetStockIconInfo's index, shortcut and selected flags

SHGetStockIconInfo ignored SHGSI_SYSICONINDEX, SHGSI_LINKOVERLAY and
SHGSI_SELECTED with a FIXME (76 in the logs): callers got no system image
list index (-1) and a plain icon.

SHGSI_SYSICONINDEX gives the icon's place in the system image list, the
shortcut-overlaid one's with SHGSI_LINKOVERLAY; with SHGSI_ICON those two
and SHGSI_SELECTED take the icon from that list, overlaid or drawn
selected. SHGSI_SHELLICONSIZE is the shell's icon size, which is the
system one here.

Wine's shell32 shelllink tests: no failures, as before.

Gate: test/stockicon-gate.sh (Xvfb). Mutant SG_MUTANT_NO_STOCK_ICON_FLAGS
(shell32/iconcache.c).
---
--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -1087,6 +1087,31 @@ HRESULT WINAPI SHGetStockIconInfo(SHSTOCKICONID id, UINT flags, SHSTOCKICONINFO
     sii->iIcon = -res;
     lstrcatW(sii->szPath, L"\\shell32.dll");
 
+#ifndef SG_MUTANT_NO_STOCK_ICON_FLAGS
+    /* SHGSI_SYSICONINDEX, SHGSI_LINKOVERLAY and SHGSI_SELECTED (76 FIXMEs in
+     * the logs): the icon's place in the system image list -- the shortcut
+     * overlaid one for SHGSI_LINKOVERLAY -- and an icon from that list,
+     * drawn selected for SHGSI_SELECTED. SHGSI_SHELLICONSIZE is the shell's
+     * icon size, which is the system one here. */
+    sii->hIcon = NULL;
+    sii->iSysImageIndex = -1;
+    if (flags & (SHGSI_SYSICONINDEX | SHGSI_LINKOVERLAY | SHGSI_SELECTED))
+        sii->iSysImageIndex = SIC_GetIconIndex(sii->szPath, sii->iIcon,
+                                               (flags & SHGSI_LINKOVERLAY) ? GIL_FORSHORTCUT : 0);
+    if ((flags & SHGSI_ICON) && (flags & (SHGSI_LINKOVERLAY | SHGSI_SELECTED)) && sii->iSysImageIndex != -1)
+    {
+        HIMAGELIST list = shell_imagelists[(flags & SHGSI_SMALLICON) ? SHIL_SMALL : SHIL_LARGE];
+        sii->hIcon = ImageList_GetIcon(list, sii->iSysImageIndex,
+                                       ILD_TRANSPARENT | ((flags & SHGSI_SELECTED) ? ILD_SELECTED : 0));
+    }
+    else if (flags & SHGSI_ICON)
+    {
+        int cx = GetSystemMetrics((flags & SHGSI_SMALLICON) ? SM_CXSMICON : SM_CXICON);
+        int cy = GetSystemMetrics((flags & SHGSI_SMALLICON) ? SM_CYSMICON : SM_CYICON);
+        sii->hIcon = LoadImageW(shell32_hInstance, MAKEINTRESOURCEW(res), IMAGE_ICON, cx, cy, 0);
+    }
+    if (!(flags & SHGSI_SYSICONINDEX)) sii->iSysImageIndex = -1;
+#else
     if (flags & ~(SHGSI_ICON | SHGSI_SMALLICON | SHGSI_LARGEICON | SHGSI_ICONLOCATION))
         FIXME("flags 0x%x not implemented\n", flags);
 
@@ -1098,6 +1123,7 @@ HRESULT WINAPI SHGetStockIconInfo(SHSTOCKICONID id, UINT flags, SHSTOCKICONINFO
         sii->hIcon = LoadImageW(shell32_hInstance, MAKEINTRESOURCEW(res), IMAGE_ICON, cx, cy, 0);
     }
     sii->iSysImageIndex = -1;
+#endif
 
     TRACE("%3d: returning %s (%d)\n", id, debugstr_w(sii->szPath), sii->iIcon);
 
