From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rpcrt4: RpcStringBindingParse protocol sequence/options, MesEncodeFixedBufferHandleCreate size

RpcStringBindingParse (A and W) accepted a string binding with no protocol
sequence and left allocations behind in its outputs when it failed; as
Wine's conformance test (todo_wine) records from Windows, a binding without a
protocol sequence is RPC_S_INVALID_STRING_BINDING with every output NULL, and
a binding whose brackets hold no option returns an empty options string
instead of NULL.  MesEncodeFixedBufferHandleCreate with a zero buffer size is
RPC_S_INVALID_ARG.  The matching todo_wine marks are removed.

---
--- a/dlls/rpcrt4/ndr_es.c
+++ b/dlls/rpcrt4/ndr_es.c
@@ -195,7 +195,10 @@ RPC_STATUS RPC_ENTRY MesEncodeFixedBufferHandleCreate(
     if (!pEncodedSize)
         return RPC_S_INVALID_ARG;
 
-    /* FIXME: check BufferSize too */
+#ifndef SG_MUTANT_MES_ZERO_SIZE
+    if (!BufferSize)
+        return RPC_S_INVALID_ARG;
+#endif
 
     pEsMsg = malloc(sizeof(*pEsMsg));
     if (!pEsMsg)
--- a/dlls/rpcrt4/rpc_binding.c
+++ b/dlls/rpcrt4/rpc_binding.c
@@ -585,6 +585,9 @@ RPC_STATUS WINAPI RpcStringBindingParseA( RPC_CSTR StringBinding, RPC_CSTR *ObjU
     if (Protseq) *Protseq = unescape_string_binding_component(data, next - data);
     data = next+1;
   }
+#ifndef SG_MUTANT_BINDING_NO_PROTSEQ_CHECK
+  else goto fail;  /* a string binding names its protocol sequence */
+#endif
 
   next = string_binding_find_delimiter(data, '[');
   if (next) {
@@ -636,6 +639,10 @@ RPC_STATUS WINAPI RpcStringBindingParseA( RPC_CSTR StringBinding, RPC_CSTR *ObjU
 
     data = close+1;
     if (*data) goto fail;
+#ifndef SG_MUTANT_BINDING_NO_EMPTY_OPTIONS
+    /* options are an empty string when the brackets hold none */
+    if (Options && !*Options) *Options = unescape_string_binding_component((const unsigned char *)"", 0);
+#endif
   }
   else if (NetworkAddr) 
     *NetworkAddr = unescape_string_binding_component(data, -1);
@@ -643,11 +650,12 @@ RPC_STATUS WINAPI RpcStringBindingParseA( RPC_CSTR StringBinding, RPC_CSTR *ObjU
   return RPC_S_OK;
 
 fail:
-  if (ObjUuid) RpcStringFreeA(ObjUuid);
-  if (Protseq) RpcStringFreeA(Protseq);
-  if (NetworkAddr) RpcStringFreeA(NetworkAddr);
-  if (Endpoint) RpcStringFreeA(Endpoint);
-  if (Options) RpcStringFreeA(Options);
+  /* nothing is returned on failure */
+  if (ObjUuid) { RpcStringFreeA(ObjUuid); *ObjUuid = NULL; }
+  if (Protseq) { RpcStringFreeA(Protseq); *Protseq = NULL; }
+  if (NetworkAddr) { RpcStringFreeA(NetworkAddr); *NetworkAddr = NULL; }
+  if (Endpoint) { RpcStringFreeA(Endpoint); *Endpoint = NULL; }
+  if (Options) { RpcStringFreeA(Options); *Options = NULL; }
   return RPC_S_INVALID_STRING_BINDING;
 }
 
@@ -694,6 +702,9 @@ RPC_STATUS WINAPI RpcStringBindingParseW( RPC_WSTR StringBinding, RPC_WSTR *ObjU
     if (Protseq) *Protseq = unescape_string_binding_componentW(data, next - data);
     data = next+1;
   }
+#ifndef SG_MUTANT_BINDING_NO_PROTSEQ_CHECK
+  else goto fail;  /* a string binding names its protocol sequence */
+#endif
 
   next = string_binding_find_delimiterW(data, '[');
   if (next) {
@@ -745,17 +756,22 @@ RPC_STATUS WINAPI RpcStringBindingParseW( RPC_WSTR StringBinding, RPC_WSTR *ObjU
 
     data = close+1;
     if (*data) goto fail;
+#ifndef SG_MUTANT_BINDING_NO_EMPTY_OPTIONS
+    /* options are an empty string when the brackets hold none */
+    if (Options && !*Options) *Options = unescape_string_binding_componentW(L"", 0);
+#endif
   } else if (NetworkAddr) 
     *NetworkAddr = unescape_string_binding_componentW(data, -1);
 
   return RPC_S_OK;
 
 fail:
-  if (ObjUuid) RpcStringFreeW(ObjUuid);
-  if (Protseq) RpcStringFreeW(Protseq);
-  if (NetworkAddr) RpcStringFreeW(NetworkAddr);
-  if (Endpoint) RpcStringFreeW(Endpoint);
-  if (Options) RpcStringFreeW(Options);
+  /* nothing is returned on failure */
+  if (ObjUuid) { RpcStringFreeW(ObjUuid); *ObjUuid = NULL; }
+  if (Protseq) { RpcStringFreeW(Protseq); *Protseq = NULL; }
+  if (NetworkAddr) { RpcStringFreeW(NetworkAddr); *NetworkAddr = NULL; }
+  if (Endpoint) { RpcStringFreeW(Endpoint); *Endpoint = NULL; }
+  if (Options) { RpcStringFreeW(Options); *Options = NULL; }
   return RPC_S_INVALID_STRING_BINDING;
 }
 
--- a/dlls/rpcrt4/tests/ndr_marshall.c
+++ b/dlls/rpcrt4/tests/ndr_marshall.c
@@ -2941,7 +2941,6 @@ static void test_MesEncodeFixedBufferHandleCreate(void)
     ok(status == RPC_S_INVALID_ARG, "got %ld\n", status);
 
     status = MesEncodeFixedBufferHandleCreate(buffer, 0, &encoded_size, &handle);
-    todo_wine
     ok(status == RPC_S_INVALID_ARG, "got %ld\n", status);
 if (status == RPC_S_OK) {
     MesHandleFree(handle);
--- a/dlls/rpcrt4/tests/rpc.c
+++ b/dlls/rpcrt4/tests/rpc.c
@@ -634,14 +634,11 @@ static void test_RpcStringBindingParseA(void)
 
     /* test with invalid binding */
     status = RpcStringBindingParseA(invalid_binding, &uuid, &protseq, &network_addr, &endpoint, &options);
-    todo_wine
     ok(status == RPC_S_INVALID_STRING_BINDING, "RpcStringBindingParseA should have returned RPC_S_INVALID_STRING_BINDING instead of %ld\n", status);
-    todo_wine
     ok(uuid == NULL, "uuid was %p instead of NULL\n", uuid);
     if (uuid)
         RpcStringFreeA(&uuid);
     ok(protseq == NULL, "protseq was %p instead of NULL\n", protseq);
-    todo_wine
     ok(network_addr == NULL, "network_addr was %p instead of NULL\n", network_addr);
     if (network_addr)
         RpcStringFreeA(&network_addr);
