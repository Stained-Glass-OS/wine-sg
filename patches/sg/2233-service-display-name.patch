From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] services: display name against service names

CreateService only refused a display name equal to another display name;
one equal to another service's name is ERROR_DUPLICATE_SERVICE_NAME too.
Matching todo_wine marks removed from the advapi32 service test, and two
already satisfied from the combase roapi test (activation factory of a
registered Windows Runtime class).

---
--- a/dlls/advapi32/tests/service.c
+++ b/dlls/advapi32/tests/service.c
@@ -364,8 +364,8 @@ static void test_create_delete_svc(void)
 
     svc_handle2 = CreateServiceA(scm_handle, "winetest_dupname2", "winetest_dupname", DELETE,
             SERVICE_WIN32_OWN_PROCESS, SERVICE_AUTO_START, 0, pathname, NULL, NULL, NULL, NULL, NULL);
-    todo_wine ok(!svc_handle2, "Expected failure\n");
-    todo_wine ok(GetLastError() == ERROR_DUPLICATE_SERVICE_NAME, "Got wrong error %lu\n", GetLastError());
+    ok(!svc_handle2, "Expected failure\n");
+    ok(GetLastError() == ERROR_DUPLICATE_SERVICE_NAME, "Got wrong error %lu\n", GetLastError());
     if (svc_handle2)
     {
         DeleteService(svc_handle2);
--- a/dlls/combase/tests/roapi.c
+++ b/dlls/combase/tests/roapi.c
@@ -95,7 +95,7 @@ static void test_ActivationFactories(void)
     ok(hr == REGDB_E_CLASSNOTREG, "Unexpected hr %#lx.\n", hr);
 
     hr = RoGetActivationFactory(str, &IID_IActivationFactory, (void **)&factory);
-    todo_wine ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     if(factory)
         IActivationFactory_Release(factory);
 
@@ -103,7 +103,7 @@ static void test_ActivationFactories(void)
     ok(hr == REGDB_E_CLASSNOTREG, "Unexpected hr %#lx.\n", hr);
 
     hr = RoActivateInstance(str, &inspect);
-    todo_wine ok(hr == S_OK, "UNexpected hr %#lx.\n", hr);
+    ok(hr == S_OK, "UNexpected hr %#lx.\n", hr);
     if(inspect)
         IInspectable_Release(inspect);
 
--- a/programs/services/rpc.c
+++ b/programs/services/rpc.c
@@ -762,7 +762,12 @@ static DWORD create_serviceW(
         return err;
     }
 
-    if (scmdatabase_find_service_by_displayname(manager->db, get_display_name(entry)))
+    /* the display name may match neither another display name nor a service name */
+    if (scmdatabase_find_service_by_displayname(manager->db, get_display_name(entry))
+#ifndef SG_MUTANT_DISPLAYNAME_VS_NAME
+        || scmdatabase_find_service(manager->db, get_display_name(entry))
+#endif
+        )
     {
         scmdatabase_unlock(manager->db);
         free_service_entry(entry);
