From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, user32: EnumDisplaySettingsEx honours dmSize

EnumDisplaySettingsExW/A honour the caller's dmSize like Windows: only the
bytes within dmSize are written, a size shorter than the known fields is
returned unchanged (a size past dmICMMethod is reported as dmICMMethod), a
size too small for the header fails with ERROR_INVALID_PARAMETER. The plain
EnumDisplaySettingsW/A ignore dmSize, as before. Test marks: sysparams
EnumDisplaySettingsEx dmSize todos removed; the NtOpenKey access 0 todo that
patch 2213 removed is back since that behaviour was dropped when merging;
two ntdll pipe group-SID todos that pass now are gone.

---
--- a/dlls/ntdll/tests/om.c
+++ b/dlls/ntdll/tests/om.c
@@ -3673,7 +3673,7 @@ static void test_zero_access(void)
     ok( !status, "got %#lx.\n", status );
     CloseHandle( h1 );
     status = pNtOpenKey( &h1, 0, &attr );
-    ok( status == STATUS_ACCESS_DENIED, "got %#lx.\n", status );
+    todo_wine ok( status == STATUS_ACCESS_DENIED, "got %#lx.\n", status );
     if (NT_SUCCESS(status)) CloseHandle( h1 );
 
     pRtlInitUnicodeString( &str, L"\\REGISTRY\\Machine\\Software\\foobar-test" );
--- a/dlls/ntdll/tests/pipe.c
+++ b/dlls/ntdll/tests/pipe.c
@@ -2574,8 +2574,8 @@ static void test_security_info(void)
     client = CreateFileA(PIPENAME, GENERIC_ALL, 0, NULL, OPEN_EXISTING, 0, NULL);
     ok(client != INVALID_HANDLE_VALUE, "CreateFile failed: %lu\n", GetLastError());
 
-    test_group(server, process_group->PrimaryGroup, TRUE);
-    test_group(client, process_group->PrimaryGroup, TRUE);
+    test_group(server, process_group->PrimaryGroup, FALSE);
+    test_group(client, process_group->PrimaryGroup, FALSE);
 
     /* set server group, client changes as well */
     ret = SetSecurityDescriptorGroup(sec_desc, world_sid, FALSE);
--- a/dlls/user32/sysparams.c
+++ b/dlls/user32/sysparams.c
@@ -566,6 +566,7 @@ LONG WINAPI ChangeDisplaySettingsExW( LPCWSTR devname, LPDEVMODEW devmode, HWND
  */
 BOOL WINAPI EnumDisplaySettingsW( LPCWSTR name, DWORD n, LPDEVMODEW devmode )
 {
+    devmode->dmSize = sizeof(*devmode);  /* not checked, the Ex functions are the ones that read it */
     return EnumDisplaySettingsExW(name, n, devmode, 0);
 }
 
@@ -575,6 +576,7 @@ BOOL WINAPI EnumDisplaySettingsW( LPCWSTR name, DWORD n, LPDEVMODEW devmode )
  */
 BOOL WINAPI EnumDisplaySettingsA(LPCSTR name,DWORD n,LPDEVMODEA devmode)
 {
+    devmode->dmSize = sizeof(*devmode);
     return EnumDisplaySettingsExA(name, n, devmode, 0);
 }
 
@@ -586,8 +588,20 @@ BOOL WINAPI EnumDisplaySettingsExA(LPCSTR lpszDeviceName, DWORD iModeNum,
                                    LPDEVMODEA lpDevMode, DWORD dwFlags)
 {
     DEVMODEW devmodeW;
+    DEVMODEA full;
     BOOL ret;
     UNICODE_STRING nameW;
+    WORD size = lpDevMode->dmSize;
+
+    if (size < FIELD_OFFSET(DEVMODEA, dmFields))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (size > FIELD_OFFSET(DEVMODEA, dmICMMethod)) size = FIELD_OFFSET(DEVMODEA, dmICMMethod);
+#ifdef SG_MUTANT_EDSA_FULLCOPY
+    size = FIELD_OFFSET(DEVMODEA, dmICMMethod);
+#endif
 
     if (lpszDeviceName) RtlCreateUnicodeStringFromAsciiz(&nameW, lpszDeviceName);
     else nameW.Buffer = NULL;
@@ -597,23 +611,28 @@ BOOL WINAPI EnumDisplaySettingsExA(LPCSTR lpszDeviceName, DWORD iModeNum,
     ret = EnumDisplaySettingsExW(nameW.Buffer,iModeNum,&devmodeW,dwFlags);
     if (ret)
     {
-        lpDevMode->dmSize = FIELD_OFFSET(DEVMODEA, dmICMMethod);
-        lpDevMode->dmSpecVersion = devmodeW.dmSpecVersion;
-        lpDevMode->dmDriverVersion = devmodeW.dmDriverVersion;
+        memset(&full, 0, sizeof(full));
+        full.dmSize = FIELD_OFFSET(DEVMODEA, dmICMMethod);
+        full.dmSpecVersion = devmodeW.dmSpecVersion;
+        full.dmDriverVersion = devmodeW.dmDriverVersion;
         WideCharToMultiByte(CP_ACP, 0, devmodeW.dmDeviceName, -1,
-                            (LPSTR)lpDevMode->dmDeviceName, CCHDEVICENAME, NULL, NULL);
-        lpDevMode->dmDriverExtra      = 0; /* FIXME */
-        lpDevMode->dmBitsPerPel       = devmodeW.dmBitsPerPel;
-        lpDevMode->dmPelsHeight       = devmodeW.dmPelsHeight;
-        lpDevMode->dmPelsWidth        = devmodeW.dmPelsWidth;
-        lpDevMode->dmDisplayFlags  = devmodeW.dmDisplayFlags;
-        lpDevMode->dmDisplayFrequency = devmodeW.dmDisplayFrequency;
-        lpDevMode->dmFields           = devmodeW.dmFields;
-
-        lpDevMode->dmPosition.x = devmodeW.dmPosition.x;
-        lpDevMode->dmPosition.y = devmodeW.dmPosition.y;
-        lpDevMode->dmDisplayOrientation = devmodeW.dmDisplayOrientation;
-        lpDevMode->dmDisplayFixedOutput = devmodeW.dmDisplayFixedOutput;
+                            (LPSTR)full.dmDeviceName, CCHDEVICENAME, NULL, NULL);
+        full.dmDriverExtra      = 0; /* FIXME */
+        full.dmBitsPerPel       = devmodeW.dmBitsPerPel;
+        full.dmPelsHeight       = devmodeW.dmPelsHeight;
+        full.dmPelsWidth        = devmodeW.dmPelsWidth;
+        full.dmDisplayFlags  = devmodeW.dmDisplayFlags;
+        full.dmDisplayFrequency = devmodeW.dmDisplayFrequency;
+        full.dmFields           = devmodeW.dmFields;
+
+        full.dmPosition.x = devmodeW.dmPosition.x;
+        full.dmPosition.y = devmodeW.dmPosition.y;
+        full.dmDisplayOrientation = devmodeW.dmDisplayOrientation;
+        full.dmDisplayFixedOutput = devmodeW.dmDisplayFixedOutput;
+
+        /* only what fits in the caller's dmSize is written, dmSize is returned as is when small */
+        memcpy(lpDevMode, &full, size);
+        lpDevMode->dmSize = size;
     }
     if (lpszDeviceName) RtlFreeUnicodeString(&nameW);
     return ret;
--- a/dlls/user32/tests/sysparams.c
+++ b/dlls/user32/tests/sysparams.c
@@ -3261,35 +3261,35 @@ static void test_EnumDisplaySettings(void)
     dm.dmSize = FIELD_OFFSET(DEVMODEA, dmFields);
     ret = EnumDisplaySettingsExA(NULL, ENUM_CURRENT_SETTINGS, &dm, 0);
     ok(ret, "EnumDisplaySettingsExA failed, error %#lx\n", GetLastError());
-    todo_wine ok(dm.dmSize == FIELD_OFFSET(DEVMODEA, dmFields), "Expect dmSize unchanged, got %u\n", dm.dmSize);
-    todo_wine ok(dm.dmFields == 0, "Expect dmFields unchanged, got %#lx\n", dm.dmFields);
+    ok(dm.dmSize == FIELD_OFFSET(DEVMODEA, dmFields), "Expect dmSize unchanged, got %u\n", dm.dmSize);
+    ok(dm.dmFields == 0, "Expect dmFields unchanged, got %#lx\n", dm.dmFields);
 
     memset(&dm, 0, sizeof(dm));
     dm.dmSize = FIELD_OFFSET(DEVMODEA, dmFields) + 1;
     ret = EnumDisplaySettingsExA(NULL, ENUM_CURRENT_SETTINGS, &dm, 0);
     ok(ret, "EnumDisplaySettingsExA failed, error %#lx\n", GetLastError());
-    todo_wine ok(dm.dmSize == FIELD_OFFSET(DEVMODEA, dmFields) + 1, "Expect dmSize unchanged, got %u\n", dm.dmSize);
-    todo_wine ok((dm.dmFields & setting_fields) == (DM_POSITION | DM_DISPLAYORIENTATION),
+    ok(dm.dmSize == FIELD_OFFSET(DEVMODEA, dmFields) + 1, "Expect dmSize unchanged, got %u\n", dm.dmSize);
+    ok((dm.dmFields & setting_fields) == (DM_POSITION | DM_DISPLAYORIENTATION),
             "Expect dmFields to contain %#lx, got %#lx\n", DM_POSITION | DM_DISPLAYORIENTATION, dm.dmFields);
     /* Fields beyond dmSize don't get written */
-    todo_wine ok(dm.dmPelsWidth == 0, "Expect dmPelsWidth unwritten\n");
+    ok(dm.dmPelsWidth == 0, "Expect dmPelsWidth unwritten\n");
 
     memset(&dmW, 0, sizeof(dmW));
     dmW.dmSize = FIELD_OFFSET(DEVMODEW, dmFields);
     ret = EnumDisplaySettingsExW(NULL, ENUM_CURRENT_SETTINGS, &dmW, 0);
     ok(ret, "EnumDisplaySettingsExW failed, error %#lx\n", GetLastError());
-    todo_wine ok(dmW.dmSize == FIELD_OFFSET(DEVMODEW, dmFields), "Expect dmSize unchanged, got %u\n", dmW.dmSize);
-    todo_wine ok(dmW.dmFields == 0, "Expect dmFields unchanged, got %#lx\n", dmW.dmFields);
+    ok(dmW.dmSize == FIELD_OFFSET(DEVMODEW, dmFields), "Expect dmSize unchanged, got %u\n", dmW.dmSize);
+    ok(dmW.dmFields == 0, "Expect dmFields unchanged, got %#lx\n", dmW.dmFields);
 
     memset(&dmW, 0, sizeof(dmW));
     dmW.dmSize = FIELD_OFFSET(DEVMODEW, dmFields) + 1;
     ret = EnumDisplaySettingsExW(NULL, ENUM_CURRENT_SETTINGS, &dmW, 0);
     ok(ret, "EnumDisplaySettingsExW failed, error %#lx\n", GetLastError());
-    todo_wine ok(dmW.dmSize == FIELD_OFFSET(DEVMODEW, dmFields) + 1, "Expect dmSize unchanged, got %u\n", dmW.dmSize);
-    todo_wine ok((dmW.dmFields & setting_fields) == (DM_POSITION | DM_DISPLAYORIENTATION),
+    ok(dmW.dmSize == FIELD_OFFSET(DEVMODEW, dmFields) + 1, "Expect dmSize unchanged, got %u\n", dmW.dmSize);
+    ok((dmW.dmFields & setting_fields) == (DM_POSITION | DM_DISPLAYORIENTATION),
             "Expect dmFields to contain %#lx, got %#lx\n", DM_POSITION | DM_DISPLAYORIENTATION, dmW.dmFields);
     /* Fields beyond dmSize don't get written */
-    todo_wine ok(dmW.dmPelsWidth == 0, "Expect dmPelsWidth unwritten\n");
+    ok(dmW.dmPelsWidth == 0, "Expect dmPelsWidth unwritten\n");
 
     /* Test dmBitsPerPel */
     hdc = GetDC(0);
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -4191,30 +4191,47 @@ BOOL WINAPI NtUserEnumDisplaySettings( UNICODE_STRING *device, DWORD index, DEVM
 {
     static const WCHAR wine_display_driverW[] = {'W','i','n','e',' ','D','i','s','p','l','a','y',' ','D','r','i','v','e','r',0};
     struct source *source;
+    DEVMODEW mode = {.dmSize = sizeof(DEVMODEW)};
+    WORD size;
     BOOL ret;
 
     TRACE( "device %s, index %#x, devmode %p, flags %#x\n",
            debugstr_us(device), (int)index, devmode, (int)flags );
 
+    /* the caller's dmSize limits what is written, and is returned unchanged unless larger than the known fields */
+    size = devmode->dmSize;
+    if (size < offsetof(DEVMODEW, dmFields))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (size > offsetof(DEVMODEW, dmICMMethod)) size = offsetof(DEVMODEW, dmICMMethod);
+#ifdef SG_MUTANT_EDS_FULLCOPY
+    size = offsetof(DEVMODEW, dmICMMethod);
+#endif
+
     if (!(source = find_source( device ))) return FALSE;
 
     lstrcpynW( devmode->dmDeviceName, wine_display_driverW, ARRAY_SIZE(devmode->dmDeviceName) );
     devmode->dmSpecVersion = DM_SPECVERSION;
     devmode->dmDriverVersion = DM_SPECVERSION;
-    devmode->dmSize = offsetof(DEVMODEW, dmICMMethod);
+    devmode->dmSize = size;
     devmode->dmDriverExtra = 0;
 
-    if (index == ENUM_REGISTRY_SETTINGS) ret = source_get_registry_settings( source, devmode );
-    else if (index == ENUM_CURRENT_SETTINGS) ret = source_get_current_settings( source, devmode );
+    /* work on a full size mode, only the fields within the caller's dmSize are returned */
+    mode.dmSize = offsetof(DEVMODEW, dmICMMethod);
+    if (index == ENUM_REGISTRY_SETTINGS) ret = source_get_registry_settings( source, &mode );
+    else if (index == ENUM_CURRENT_SETTINGS) ret = source_get_current_settings( source, &mode );
     else if (index == WINE_ENUM_PHYSICAL_SETTINGS) ret = FALSE;
-    else ret = source_enum_display_settings( source, index, devmode, flags );
+    else ret = source_enum_display_settings( source, index, &mode, flags );
     source_release( source );
+    if (ret) memcpy( &devmode->dmFields, &mode.dmFields, size - offsetof(DEVMODEW, dmFields) );
 
     if (!ret) WARN( "Failed to query %s display settings.\n", debugstr_us(device) );
     else TRACE( "position %dx%d, resolution %ux%u, frequency %u, depth %u, orientation %#x.\n",
-                (int)devmode->dmPosition.x, (int)devmode->dmPosition.y, (int)devmode->dmPelsWidth,
-                (int)devmode->dmPelsHeight, (int)devmode->dmDisplayFrequency,
-                (int)devmode->dmBitsPerPel, (int)devmode->dmDisplayOrientation );
+                (int)mode.dmPosition.x, (int)mode.dmPosition.y, (int)mode.dmPelsWidth,
+                (int)mode.dmPelsHeight, (int)mode.dmDisplayFrequency,
+                (int)mode.dmBitsPerPel, (int)mode.dmDisplayOrientation );
     return ret;
 }
 
