From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernel32: OOBEComplete

OOBEComplete says whether the machine has finished its out-of-box experience: yes, unless setup marks it as still running (HKLM\System\Setup OOBEInProgress or SystemSetupInProgress). It was not exported. winbase.h gains it.
---
--- a/include/winbase.h
+++ b/include/winbase.h
@@ -2729,6 +2729,7 @@
 WINADVAPI  DWORD       WINAPI OpenEncryptedFileRawA(LPCSTR,ULONG,PVOID*);
 WINADVAPI  DWORD       WINAPI OpenEncryptedFileRawW(LPCWSTR,ULONG,PVOID*);
 #define                       OpenEncryptedFileRaw WINELIB_NAME_AW(OpenEncryptedFileRaw)
+WINBASEAPI BOOL        WINAPI OOBEComplete(PBOOL);
 WINBASEAPI HANDLE      WINAPI OpenEventA(DWORD,BOOL,LPCSTR);
 WINBASEAPI HANDLE      WINAPI OpenEventW(DWORD,BOOL,LPCWSTR);
 #define                       OpenEvent WINELIB_NAME_AW(OpenEvent)
--- a/dlls/kernel32/process.c
+++ b/dlls/kernel32/process.c
@@ -30,6 +30,7 @@
 #define WIN32_NO_STATUS
 #include "winternl.h"
 #include "winbase.h"
+#include "winreg.h"
 #include "winnls.h"
 #include "wincon.h"
 #include "kernel_private.h"
@@ -1107,3 +1108,39 @@
     SetLastError( UMS_ERROR );
     return FALSE;
 }
+
+#ifndef SG_MUTANT_NO_OOBE_COMPLETE
+/***********************************************************************
+ *           OOBEComplete   (KERNEL32.@)
+ *
+ * (wine-sg 8268) Whether the machine has finished its out-of-box experience: yes, unless setup marks it as
+ * still running (HKLM\System\Setup OOBEInProgress or SystemSetupInProgress set).
+ */
+BOOL WINAPI OOBEComplete( BOOL *complete )
+{
+    DWORD value, size;
+    BOOL running = FALSE;
+
+    TRACE( "(%p)\n", complete );
+
+    if (!complete)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    size = sizeof(value);
+    if (!RegGetValueW( HKEY_LOCAL_MACHINE, L"System\\Setup", L"OOBEInProgress", RRF_RT_REG_DWORD, NULL, &value, &size ) && value)
+        running = TRUE;
+    size = sizeof(value);
+    if (!RegGetValueW( HKEY_LOCAL_MACHINE, L"System\\Setup", L"SystemSetupInProgress", RRF_RT_REG_DWORD, NULL, &value, &size ) && value)
+        running = TRUE;
+    *complete = !running;
+    return TRUE;
+}
+#else
+BOOL WINAPI OOBEComplete( BOOL *complete )
+{
+    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    return FALSE;
+}
+#endif
--- a/dlls/kernel32/kernel32.spec
+++ b/dlls/kernel32/kernel32.spec
@@ -1151,6 +1151,7 @@
 @ stub NotifyNLSUserCache
 # @ stub NotifyUILanguageChange
 # @ stub NumaVirtualQueryNode
+@ stdcall OOBEComplete(ptr)
 @ stdcall OpenConsoleW(wstr long long long)
 @ stub OpenDataFile
 @ stdcall -import OpenEventA(long long str)
