From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: SystemProcessorPerformanceInformation without host counters

ntdll: SystemProcessorPerformanceInformation without /proc/stat counters

When the host gives no per-CPU counters the fallback returned counters that
counted up by 1,2,3 per call. It now returns real times: elapsed time since
boot, the process's own busy time shared over the CPUs it may run on, idle as
the rest, and kernel time that includes idle as documented.
---
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -60,6 +60,9 @@
 #ifdef HAVE_SYS_RESOURCE_H
 # include <sys/resource.h>
 #endif
+#ifdef HAVE_SCHED_H
+# include <sched.h>
+#endif
 #ifdef __APPLE__
 # include <CoreFoundation/CoreFoundation.h>
 # include <IOKit/IOKitLib.h>
@@ -3416,18 +3419,58 @@ NTSTATUS WINAPI NtQuerySystemInformation( SYSTEM_INFORMATION_CLASS class,
 #endif
         if (cpus == 0)
         {
-            static int i = 1;
-            unsigned int n;
+            /* no per-CPU counters from the host: elapsed time since boot, and
+             * this process's own busy time (a lower bound) shared out over the
+             * CPUs it may run on */
+            ULONGLONG elapsed, user = 0, kernel = 0, share_user, share_kernel;
+            unsigned int n, allowed = 0;
+            struct timespec ts;
+            struct rusage ru;
+#ifdef linux
+            cpu_set_t set;
+#endif
+
             cpus = min(peb->NumberOfProcessors, out_cpus);
-            FIXME("stub info_class SYSTEM_PROCESSOR_PERFORMANCE_INFORMATION\n");
-            /* many programs expect these values to change so fake change */
+#ifdef CLOCK_BOOTTIME
+            if (clock_gettime( CLOCK_BOOTTIME, &ts ))
+#endif
+                clock_gettime( CLOCK_MONOTONIC, &ts );
+            elapsed = (ULONGLONG)ts.tv_sec * 10000000 + ts.tv_nsec / 100;
+            if (!getrusage( RUSAGE_SELF, &ru ))
+            {
+                user += (ULONGLONG)ru.ru_utime.tv_sec * 10000000 + ru.ru_utime.tv_usec * 10;
+                kernel += (ULONGLONG)ru.ru_stime.tv_sec * 10000000 + ru.ru_stime.tv_usec * 10;
+            }
+            if (!getrusage( RUSAGE_CHILDREN, &ru ))
+            {
+                user += (ULONGLONG)ru.ru_utime.tv_sec * 10000000 + ru.ru_utime.tv_usec * 10;
+                kernel += (ULONGLONG)ru.ru_stime.tv_sec * 10000000 + ru.ru_stime.tv_usec * 10;
+            }
+#ifdef linux
+            if (!sched_getaffinity( 0, sizeof(set), &set ))
+                for (n = 0; n < cpus; n++) if (CPU_ISSET( n, &set )) allowed++;
+#endif
+            if (!allowed) allowed = cpus;
+            share_user = user / allowed;
+            share_kernel = kernel / allowed;
             for (n = 0; n < cpus; n++)
             {
-                sppi[n].KernelTime.QuadPart = 1 * i;
-                sppi[n].UserTime.QuadPart   = 2 * i;
-                sppi[n].IdleTime.QuadPart   = 3 * i;
+                ULONGLONG busy_user = 0, busy_kernel = 0, busy;
+#ifdef linux
+                if (allowed == cpus || CPU_ISSET( n, &set ))
+#endif
+                {
+                    busy_user = share_user;
+                    busy_kernel = share_kernel;
+                }
+                busy = busy_user + busy_kernel;
+#ifdef SG_MUTANT_SPPI_FALLBACK_COUNTER
+                busy_user = 2 * (n + 1); busy_kernel = 1 * (n + 1); busy = 3 * (n + 1); elapsed = 3 * (n + 1);
+#endif
+                sppi[n].UserTime.QuadPart = busy_user;
+                sppi[n].IdleTime.QuadPart = elapsed > busy ? elapsed - busy : 0;
+                sppi[n].KernelTime.QuadPart = busy_kernel + sppi[n].IdleTime.QuadPart;
             }
-            i++;
         }
 
         len = sizeof(*sppi) * cpus;
