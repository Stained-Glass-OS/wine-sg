From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: MDL locking, mapping and protection.

MmBuildMdlForNonPagedPool marks the MDL as non-paged pool, sets the
mapped system address to the start of the buffer and fills the page frame
numbers. MmProbeAndLockPages probes the pages (not committed, no access,
guard pages, or read-only for a write raise STATUS_ACCESS_VIOLATION), fills
the page frame numbers and sets the locked (and write) flags.
MmMapLockedPagesSpecifyCache maps a locked MDL (kernel mode: records the
mapping in the MDL; user mode: the pages are already at their user
address), MmUnmapLockedPages releases a mapping made that way,
MmUnlockPages releases the mapping and the lock, MmProtectMdlSystemAddress
changes the protection of a mapped MDL (STATUS_INVALID_PAGE_PROTECTION,
STATUS_NOT_MAPPED_VIEW). One todo_wine goes from the driver test.

Gate: test/ntoskrnl-mdl-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -3317,12 +3317,33 @@
     return NULL;
 }
 
+static ULONG mdl_page_count( const MDL *mdl )
+{
+    return ADDRESS_AND_SIZE_TO_SPAN_PAGES( (ULONG_PTR)mdl->StartVa + mdl->ByteOffset, mdl->ByteCount );
+}
+
+/* Wine's kernel address space is the process address space: the "physical" page described for a
+ * page is its virtual page number, which is distinct for every page of a buffer. */
+static void mdl_fill_pfns( MDL *mdl )
+{
+    PFN_NUMBER *pfns = (PFN_NUMBER *)(mdl + 1);
+    ULONG i, count = mdl_page_count( mdl );
+
+    for (i = 0; i < count; i++) pfns[i] = ((ULONG_PTR)mdl->StartVa >> PAGE_SHIFT) + i;
+}
+
 /***********************************************************************
  *           MmBuildMdlForNonPagedPool   (NTOSKRNL.EXE.@)
  */
 void WINAPI MmBuildMdlForNonPagedPool(MDL *mdl)
 {
-    FIXME("stub: %p\n", mdl);
+    TRACE( "%p\n", mdl );
+
+    mdl_fill_pfns( mdl );
+#ifndef SG_MUTANT_MDL_NO_NONPAGED_FLAG
+    mdl->MdlFlags |= MDL_SOURCE_IS_NONPAGED_POOL;
+#endif
+    mdl->MappedSystemVa = (char *)mdl->StartVa + mdl->ByteOffset;
 }
 
 /***********************************************************************
@@ -3400,9 +3421,29 @@
 PVOID WINAPI  MmMapLockedPagesSpecifyCache(PMDLX MemoryDescriptorList, KPROCESSOR_MODE AccessMode, MEMORY_CACHING_TYPE CacheType,
                                            PVOID BaseAddress, ULONG BugCheckOnFailure, MM_PAGE_PRIORITY Priority)
 {
-    FIXME("(%p, %u, %u, %p, %lu, %u): stub\n", MemoryDescriptorList, AccessMode, CacheType, BaseAddress, BugCheckOnFailure, Priority);
+    MDL *mdl = (MDL *)MemoryDescriptorList;
+    void *va = (char *)mdl->StartVa + mdl->ByteOffset;
 
-    return NULL;
+    TRACE( "(%p, %u, %u, %p, %lu, %u)\n", mdl, AccessMode, CacheType, BaseAddress, BugCheckOnFailure, Priority );
+
+    if (AccessMode != KernelMode)
+    {
+        /* the process address space is the system address space: the pages are already at va,
+         * a different requested address cannot be honoured */
+        if (BaseAddress && BaseAddress != va) RtlRaiseStatus( STATUS_INSUFFICIENT_RESOURCES );
+        return va;
+    }
+    if (mdl->MdlFlags & (MDL_MAPPED_TO_SYSTEM_VA | MDL_SOURCE_IS_NONPAGED_POOL)) return mdl->MappedSystemVa;
+    if (!(mdl->MdlFlags & MDL_PAGES_LOCKED))
+    {
+        WARN( "mdl %p is not locked\n", mdl );
+        return NULL;
+    }
+#ifndef SG_MUTANT_MDL_MAP_NO_FLAG
+    mdl->MdlFlags |= MDL_MAPPED_TO_SYSTEM_VA;
+#endif
+    mdl->MappedSystemVa = va;
+    return va;
 }
 
 /***********************************************************************
@@ -3410,7 +3451,15 @@
  */
 void WINAPI MmUnmapLockedPages( void *base, MDL *mdl )
 {
-    FIXME( "(%p %p_\n", base, mdl );
+    TRACE( "(%p %p)\n", base, mdl );
+
+    /* only a system mapping made by MmMapLockedPagesSpecifyCache is released */
+    if ((mdl->MdlFlags & (MDL_MAPPED_TO_SYSTEM_VA | MDL_PAGES_LOCKED | MDL_SOURCE_IS_NONPAGED_POOL)) ==
+        (MDL_MAPPED_TO_SYSTEM_VA | MDL_PAGES_LOCKED) && base == mdl->MappedSystemVa)
+    {
+        mdl->MdlFlags &= ~MDL_MAPPED_TO_SYSTEM_VA;
+        mdl->MappedSystemVa = NULL;
+    }
 }
 
 /***********************************************************************
@@ -3436,7 +3485,31 @@
  */
 void WINAPI MmProbeAndLockPages(PMDLX MemoryDescriptorList, KPROCESSOR_MODE AccessMode, LOCK_OPERATION Operation)
 {
-    FIXME("(%p, %u, %u): stub\n", MemoryDescriptorList, AccessMode, Operation);
+    MDL *mdl = (MDL *)MemoryDescriptorList;
+    char *addr = (char *)mdl->StartVa + mdl->ByteOffset, *end = addr + mdl->ByteCount;
+
+    TRACE( "(%p, %u, %u)\n", mdl, AccessMode, Operation );
+
+    while (addr < end)
+    {
+        MEMORY_BASIC_INFORMATION info;
+        ULONG prot;
+
+        if (NtQueryVirtualMemory( GetCurrentProcess(), addr, MemoryBasicInformation, &info, sizeof(info), NULL ) ||
+            info.State != MEM_COMMIT)
+            RtlRaiseStatus( STATUS_ACCESS_VIOLATION );
+        prot = info.Protect & 0xff;
+        if ((info.Protect & (PAGE_GUARD | PAGE_NOACCESS)) || prot == PAGE_EXECUTE) RtlRaiseStatus( STATUS_ACCESS_VIOLATION );
+#ifndef SG_MUTANT_MDL_NO_WRITE_CHECK
+        if (Operation != IoReadAccess && prot != PAGE_READWRITE && prot != PAGE_WRITECOPY &&
+            prot != PAGE_EXECUTE_READWRITE && prot != PAGE_EXECUTE_WRITECOPY)
+            RtlRaiseStatus( STATUS_ACCESS_VIOLATION );
+#endif
+        addr = (char *)info.BaseAddress + info.RegionSize;
+    }
+    mdl_fill_pfns( mdl );
+    mdl->MdlFlags |= MDL_PAGES_LOCKED;
+    if (Operation != IoReadAccess) mdl->MdlFlags |= MDL_WRITE_OPERATION;
 }
 
 
@@ -3454,7 +3527,20 @@
  */
 void WINAPI  MmUnlockPages(PMDLX MemoryDescriptorList)
 {
-    FIXME("(%p): stub\n", MemoryDescriptorList);
+    MDL *mdl = (MDL *)MemoryDescriptorList;
+
+    TRACE( "(%p)\n", mdl );
+
+    if (!(mdl->MdlFlags & MDL_PAGES_LOCKED) || (mdl->MdlFlags & MDL_SOURCE_IS_NONPAGED_POOL))
+    {
+        WARN( "mdl %p is not locked\n", mdl );
+        return;
+    }
+    /* a system mapping is released before the pages are unlocked */
+    if (mdl->MdlFlags & MDL_MAPPED_TO_SYSTEM_VA) MmUnmapLockedPages( mdl->MappedSystemVa, mdl );
+#ifndef SG_MUTANT_MDL_UNLOCK_KEEPS_LOCK
+    mdl->MdlFlags &= ~(MDL_PAGES_LOCKED | MDL_WRITE_OPERATION);
+#endif
 }
 
 
@@ -3872,8 +3958,28 @@
  */
 NTSTATUS WINAPI MmProtectMdlSystemAddress(PMDL MemoryDescriptorList, ULONG NewProtect)
 {
-    FIXME("(%p, %lu) stub\n", MemoryDescriptorList, NewProtect);
-    return STATUS_SUCCESS;
+    MDL *mdl = MemoryDescriptorList;
+    void *addr;
+    SIZE_T size;
+    ULONG old;
+
+    TRACE( "(%p, %lu)\n", mdl, NewProtect );
+
+    switch (NewProtect)
+    {
+    case PAGE_NOACCESS: case PAGE_READONLY: case PAGE_READWRITE:
+    case PAGE_EXECUTE: case PAGE_EXECUTE_READ: case PAGE_EXECUTE_READWRITE:
+        break;
+    default:
+        return STATUS_INVALID_PAGE_PROTECTION;
+    }
+#ifndef SG_MUTANT_MDL_PROTECT_UNMAPPED
+    if (!(mdl->MdlFlags & (MDL_MAPPED_TO_SYSTEM_VA | MDL_SOURCE_IS_NONPAGED_POOL))) return STATUS_NOT_MAPPED_VIEW;
+#endif
+
+    addr = mdl->MappedSystemVa;
+    size = mdl->ByteCount;
+    return NtProtectVirtualMemory( GetCurrentProcess(), &addr, &size, NewProtect, &old );
 }
 
 /***********************************************************************
diff --git a/dlls/ntoskrnl.exe/tests/driver.c b/dlls/ntoskrnl.exe/tests/driver.c
--- a/dlls/ntoskrnl.exe/tests/driver.c
+++ b/dlls/ntoskrnl.exe/tests/driver.c
@@ -285,7 +285,6 @@
     MmProbeAndLockPages(mdl, KernelMode, IoReadAccess);
 
     addr = MmMapLockedPagesSpecifyCache(mdl, KernelMode, MmCached, NULL, FALSE, NormalPagePriority);
-    todo_wine
     ok(addr != NULL, "MmMapLockedPagesSpecifyCache failed\n");
 
     MmUnmapLockedPages(addr, mdl);
-- 
2.47.0
