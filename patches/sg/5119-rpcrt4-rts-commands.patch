From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] rpcrt4: parse all RTS command types in RPC-over-HTTP packets

Share one command-size table (MS-RPCH 2.2.3.5) between the validator
and the field walker; reject unknown or malformed commands.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/rpcrt4/rpc_message.c b/dlls/rpcrt4/rpc_message.c
--- a/dlls/rpcrt4/rpc_message.c
+++ b/dlls/rpcrt4/rpc_message.c
@@ -474,6 +474,56 @@
     }
 }
 
+/* Size in bytes of the data following the command type of an RTS command
+ * (MS-RPCH 2.2.3.5).  Returns FALSE if the command type is unknown or the
+ * data does not fit in the data_len bytes available. */
+static BOOL RPCRT4_HttpCommandSize(ULONG type, const unsigned char *data,
+                                   unsigned short data_len, ULONG *size)
+{
+  switch (type)
+  {
+    case 0x3: /* Cookie */
+    case 0xc: /* AssociationGroupId */
+      *size = sizeof(GUID);
+      break;
+    case 0x0: /* ReceiveWindowSize */
+    case 0x2: /* ConnectionTimeout */
+    case 0x4: /* ChannelLifetime */
+    case 0x5: /* ClientKeepalive */
+    case 0x6: /* Version */
+    case 0xd: /* Destination */
+    case 0xe: /* PingTrafficSentNotify */
+      *size = sizeof(ULONG);
+      break;
+    case 0x1: /* FlowControlAck */
+      *size = 24;
+      break;
+    case 0x7: /* Empty */
+    case 0x9: /* NegativeANCE */
+    case 0xa: /* ANCE */
+      *size = 0;
+      break;
+    case 0x8: /* Padding: ConformanceCount, then that many bytes */
+      if (data_len < sizeof(ULONG)) return FALSE;
+      if (*(const ULONG *)data > 0xffff) return FALSE;
+      *size = sizeof(ULONG) + *(const ULONG *)data;
+      break;
+    case 0xb: /* ClientAddress: type, IPv4 (4) or IPv6 (16) address, 12 bytes padding */
+      if (data_len < sizeof(ULONG)) return FALSE;
+      switch (*(const ULONG *)data)
+      {
+        case 0: *size = sizeof(ULONG) + 4 + 12; break;
+        case 1: *size = sizeof(ULONG) + 16 + 12; break;
+        default: return FALSE;
+      }
+      break;
+    default:
+      FIXME("unimplemented type 0x%lx\n", type);
+      return FALSE;
+  }
+  return data_len >= *size;
+}
+
 /* assumes the common header fields have already been validated */
 BOOL RPCRT4_IsValidHttpPacket(RpcPktHdr *hdr, unsigned char *data,
                               unsigned short data_len)
@@ -483,7 +533,7 @@
 
   for (i = 0; i < hdr->http.num_data_items; i++)
   {
-    ULONG type;
+    ULONG type, size;
 
     if (data_len < sizeof(ULONG))
       return FALSE;
@@ -492,36 +542,10 @@
     p += sizeof(ULONG);
     data_len -= sizeof(ULONG);
 
-    switch (type)
-    {
-      case 0x3:
-      case 0xc:
-        if (data_len < sizeof(GUID))
-          return FALSE;
-        p += sizeof(GUID);
-        data_len -= sizeof(GUID);
-        break;
-      case 0x0:
-      case 0x2:
-      case 0x4:
-      case 0x5:
-      case 0x6:
-      case 0xd:
-        if (data_len < sizeof(ULONG))
-          return FALSE;
-        p += sizeof(ULONG);
-        data_len -= sizeof(ULONG);
-        break;
-      case 0x1:
-        if (data_len < 24)
-          return FALSE;
-        p += 24;
-        data_len -= 24;
-        break;
-      default:
-        FIXME("unimplemented type 0x%lx\n", type);
-        break;
-    }
+    if (!RPCRT4_HttpCommandSize(type, p, data_len, &size))
+      return FALSE;
+    p += size;
+    data_len -= size;
   }
   return TRUE;
 }
@@ -529,29 +553,15 @@
 /* assumes the HTTP packet has been validated */
 static unsigned char *RPCRT4_NextHttpHeaderField(unsigned char *data)
 {
-  ULONG type;
+  ULONG type, size;
 
   type = *(ULONG *)data;
   data += sizeof(ULONG);
 
-  switch (type)
-  {
-    case 0x3:
-    case 0xc:
-      return data + sizeof(GUID);
-    case 0x0:
-    case 0x2:
-    case 0x4:
-    case 0x5:
-    case 0x6:
-    case 0xd:
-      return data + sizeof(ULONG);
-    case 0x1:
-      return data + 24;
-    default:
-      FIXME("unimplemented type 0x%lx\n", type);
-      return data;
-  }
+  /* the packet was validated, so the data is long enough */
+  if (!RPCRT4_HttpCommandSize(type, data, 0xffff, &size))
+    return data;
+  return data + size;
 }
 
 #define READ_HTTP_PAYLOAD_FIELD_TYPE(data) *(ULONG *)(data)
-- 
