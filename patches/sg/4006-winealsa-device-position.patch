From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winealsa.drv: Report the device position.

IAudioClock2::GetDevicePosition got E_NOTIMPL from the ALSA driver; the
device position is the stream's position in frames (a shared stream's
stream position counts bytes).
---
 dlls/winealsa.drv/alsa.c | 10 +++-------
 1 file changed, 3 insertions(+), 7 deletions(-)

diff --git a/dlls/winealsa.drv/alsa.c b/dlls/winealsa.drv/alsa.c
index 046b447..26ebcd1 100644
--- a/dlls/winealsa.drv/alsa.c
+++ b/dlls/winealsa.drv/alsa.c
@@ -2211,12 +2211,6 @@ static NTSTATUS alsa_get_position(void *args)
     UINT64 position;
     snd_pcm_state_t alsa_state;
 
-    if (params->device) {
-        FIXME("Device position reporting not implemented\n");
-        params->result = E_NOTIMPL;
-        return STATUS_SUCCESS;
-    }
-
     alsa_lock(stream);
 
     /* avail_update required to get accurate snd_pcm_state() */
@@ -2248,7 +2242,9 @@ static NTSTATUS alsa_get_position(void *args)
             (UINT32)(stream->written_frames%1000000000), stream->held_frames,
             alsa_state, (UINT32)(position%1000000000));
 
-    if(stream->share == AUDCLNT_SHAREMODE_SHARED)
+    /* the device position (IAudioClock2) counts frames, the stream position
+     * of a shared stream counts bytes */
+    if(stream->share == AUDCLNT_SHAREMODE_SHARED && !params->device)
         *params->pos = position * stream->fmt->nBlockAlign;
     else
         *params->pos = position;
