+/* Software restriction (Safer) levels. A level is a handle of its own; its
+ * token is the caller's with what the level takes away: a normal user's has
+ * the Administrators group for deny only and no privileges but bypassing
+ * traverse checking, at medium integrity; a constrained one is also
+ * restricted to the user, Everyone, Users and RESTRICTED; an untrusted one
+ * also runs at low integrity. Disallowed software gets no token. The stubs
+ * handed out 0xdeadbeef as level and token: "run as a normal user"
+ * launchers (runas /trustlevel, installers dropping elevation) then failed
+ * to start anything. No restriction policies exist, so every program is
+ * fully trusted. */
+#define SAFER_LEVEL_MAGIC 0x53414652  /* "SAFR" */
+
+struct safer_level
+{
+    DWORD magic;
+    DWORD scope;
+    DWORD level;
+};
+
+static struct safer_level *get_safer_level( SAFER_LEVEL_HANDLE handle )
+{
+    struct safer_level *level = (struct safer_level *)handle;
+    BOOL valid = FALSE;
+
+    __TRY
+    {
+        valid = level && level->magic == SAFER_LEVEL_MAGIC;
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        valid = FALSE;
+    }
+    __ENDTRY
+    if (!valid)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return NULL;
+    }
+    return level;
+}
+
+static BOOL valid_safer_level( DWORD level )
+{
+    return level == SAFER_LEVELID_DISALLOWED || level == SAFER_LEVELID_UNTRUSTED || level == SAFER_LEVELID_CONSTRAINED ||
+           level == SAFER_LEVELID_NORMALUSER || level == SAFER_LEVELID_FULLYTRUSTED;
+}
+
+static SAFER_LEVEL_HANDLE new_safer_level( DWORD scope, DWORD level_id )
+{
+    struct safer_level *level;
+
+    if (!(level = HeapAlloc( GetProcessHeap(), 0, sizeof(*level) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    level->magic = SAFER_LEVEL_MAGIC;
+    level->scope = scope;
+    level->level = level_id;
+    return (SAFER_LEVEL_HANDLE)level;
+}
+
 /******************************************************************************
  * SaferCreateLevel   [ADVAPI32.@]
  */
 BOOL WINAPI SaferCreateLevel(DWORD ScopeId, DWORD LevelId, DWORD OpenFlags,
                              SAFER_LEVEL_HANDLE* LevelHandle, LPVOID lpReserved)
 {
+#ifndef SG_MUTANT_NO_SAFER
+    TRACE("(%lu, %lx, %lu, %p, %p)\n", ScopeId, LevelId, OpenFlags, LevelHandle, lpReserved);
+
+    if (!LevelHandle || (ScopeId != SAFER_SCOPEID_MACHINE && ScopeId != SAFER_SCOPEID_USER) ||
+        !valid_safer_level( LevelId ) || !(OpenFlags & SAFER_LEVEL_OPEN))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return !!(*LevelHandle = new_safer_level( ScopeId, LevelId ));
+#else
     FIXME("(%lu, %lx, %lu, %p, %p) stub\n", ScopeId, LevelId, OpenFlags, LevelHandle, lpReserved);
 
     *LevelHandle = (SAFER_LEVEL_HANDLE)0xdeadbeef;
     return TRUE;
+#endif
 }
 
