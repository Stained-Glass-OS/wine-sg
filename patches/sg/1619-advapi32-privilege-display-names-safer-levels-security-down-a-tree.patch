@@ -3585,10 +3753,94 @@ BOOL WINAPI SaferCreateLevel(DWORD ScopeId, DWORD LevelId, DWORD OpenFlags,
 BOOL WINAPI SaferComputeTokenFromLevel(SAFER_LEVEL_HANDLE handle, HANDLE token, PHANDLE access_token,
                                        DWORD flags, LPVOID reserved)
 {
+#ifndef SG_MUTANT_NO_SAFER
+    SID_IDENTIFIER_AUTHORITY nt = {SECURITY_NT_AUTHORITY}, world = {SECURITY_WORLD_SID_AUTHORITY};
+    SID_IDENTIFIER_AUTHORITY label = {SECURITY_MANDATORY_LABEL_AUTHORITY};
+    SID_AND_ATTRIBUTES disable = { NULL, 0 }, restricting[4] = {{ 0 }};
+    TOKEN_MANDATORY_LABEL integrity;
+    PSID admins = NULL, everyone = NULL, users = NULL, restricted = NULL, il = NULL;
+    BYTE user_buf[SECURITY_MAX_SID_SIZE + sizeof(TOKEN_USER)];
+    struct safer_level *level;
+    HANDLE source = token, result = NULL, copy;
+    DWORD size;
+    BOOL ret = FALSE;
+
+    TRACE("(%p, %p, %p, %lx, %p)\n", handle, token, access_token, flags, reserved);
+
+    if (!(level = get_safer_level( handle ))) return FALSE;
+    if (!access_token && !(flags & SAFER_TOKEN_COMPARE_ONLY))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (level->level == SAFER_LEVELID_DISALLOWED)
+    {
+        SetLastError( ERROR_ACCESS_DISABLED_BY_POLICY );
+        return FALSE;
+    }
+    if (!source && !OpenProcessToken( GetCurrentProcess(), TOKEN_DUPLICATE | TOKEN_QUERY | TOKEN_ASSIGN_PRIMARY, &source ))
+        return FALSE;
+
+    if (flags & SAFER_TOKEN_COMPARE_ONLY)
+    {
+        /* the caller's token against the level's: -1 less, 0 the same, 1 more privileged */
+        if (reserved) *(LONG *)reserved = level->level == SAFER_LEVELID_FULLYTRUSTED ? 0 : 1;
+        ret = TRUE;
+        goto done;
+    }
+    if (level->level == SAFER_LEVELID_FULLYTRUSTED)
+    {
+        if (flags & SAFER_TOKEN_NULL_IF_EQUAL) *access_token = NULL;
+        else ret = DuplicateTokenEx( source, TOKEN_ALL_ACCESS, NULL, SecurityImpersonation, TokenPrimary, access_token );
+        if (flags & SAFER_TOKEN_NULL_IF_EQUAL) ret = TRUE;
+        goto done;
+    }
+
+    AllocateAndInitializeSid( &nt, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS, 0, 0, 0, 0, 0, 0, &admins );
+    disable.Sid = admins;
+    if (level->level <= SAFER_LEVELID_CONSTRAINED)
+    {
+        AllocateAndInitializeSid( &world, 1, SECURITY_WORLD_RID, 0, 0, 0, 0, 0, 0, 0, &everyone );
+        AllocateAndInitializeSid( &nt, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_USERS, 0, 0, 0, 0, 0, 0, &users );
+        AllocateAndInitializeSid( &nt, 1, SECURITY_RESTRICTED_CODE_RID, 0, 0, 0, 0, 0, 0, 0, &restricted );
+        if (!GetTokenInformation( source, TokenUser, user_buf, sizeof(user_buf), &size )) goto done;
+        restricting[0].Sid = ((TOKEN_USER *)user_buf)->User.Sid;
+        restricting[1].Sid = everyone;
+        restricting[2].Sid = users;
+        restricting[3].Sid = restricted;
+    }
+    /* the integrity level first, on a copy: the restricted token's own
+     * default DACL may not let its maker change it afterwards */
+    if (!DuplicateTokenEx( source, TOKEN_ALL_ACCESS, NULL, SecurityImpersonation, TokenPrimary, &copy )) goto done;
+    AllocateAndInitializeSid( &label, 1, level->level <= SAFER_LEVELID_UNTRUSTED ? SECURITY_MANDATORY_LOW_RID
+                                                                             : SECURITY_MANDATORY_MEDIUM_RID,
+                              0, 0, 0, 0, 0, 0, 0, &il );
+    integrity.Label.Sid = il;
+    integrity.Label.Attributes = SE_GROUP_INTEGRITY;
+    SetTokenInformation( copy, TokenIntegrityLevel, &integrity, sizeof(integrity) + GetLengthSid( il ) );
+    ret = CreateRestrictedToken( copy, DISABLE_MAX_PRIVILEGE, 1, &disable, 0, NULL,
+                                 level->level <= SAFER_LEVELID_CONSTRAINED ? 4 : 0,
+                                 level->level <= SAFER_LEVELID_CONSTRAINED ? restricting : NULL, &result );
+    CloseHandle( copy );
+    if (!ret) goto done;
+    *access_token = result;
+    result = NULL;
+
+done:
+    if (result) CloseHandle( result );
+    if (source != token) CloseHandle( source );
+    if (admins) FreeSid( admins );
+    if (everyone) FreeSid( everyone );
+    if (users) FreeSid( users );
+    if (restricted) FreeSid( restricted );
+    if (il) FreeSid( il );
+    return ret;
+#else
     FIXME("(%p, %p, %p, %lx, %p) stub\n", handle, token, access_token, flags, reserved);
 
     *access_token = (flags & SAFER_TOKEN_NULL_IF_EQUAL) ? NULL : (HANDLE)0xdeadbeef;
     return TRUE;
+#endif
 }
 
