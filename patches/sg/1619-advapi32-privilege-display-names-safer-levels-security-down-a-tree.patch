+/******************************************************************************
+ * SaferGetLevelInformation   [ADVAPI32.@]
+ */
+BOOL WINAPI SaferGetLevelInformation(SAFER_LEVEL_HANDLE handle, SAFER_OBJECT_INFO_CLASS infotype,
+                                     LPVOID buffer, DWORD size, LPDWORD needed)
+{
+    struct safer_level *level;
+    DWORD value;
+
+    TRACE("(%p %u %p %lu %p)\n", handle, infotype, buffer, size, needed);
+
+    if (!(level = get_safer_level( handle ))) return FALSE;
+    switch (infotype)
+    {
+    case SaferObjectLevelId: value = level->level; break;
+    case SaferObjectScopeId: value = level->scope; break;
+    case SaferObjectBuiltin: value = TRUE; break;
+    case SaferObjectDisallowed: value = level->level == SAFER_LEVELID_DISALLOWED; break;
+    case SaferObjectDisableMaxPrivilege: value = level->level < SAFER_LEVELID_FULLYTRUSTED; break;
+    default:
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (needed) *needed = sizeof(DWORD);
+    if (!buffer || size < sizeof(DWORD))
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    *(DWORD *)buffer = value;
+    return TRUE;
+}
+
+/* Setting security down a tree (TreeSetNamedSecurityInfo,
+ * TreeResetNamedSecurityInfo): the root gets what is given; below it every
+ * file or key gets the owner and group given, and its DACL (and SACL) is
+ * its explicit entries -- none when resetting -- plus what it inherits
+ * from its parent. Both were stubs (one failed, one did nothing), so
+ * installers and icacls-style tools that open a folder up to a group left
+ * everything inside as it was. */
+#ifndef TREE_SEC_INFO_SET
+#define TREE_SEC_INFO_SET                   0x00000001
+#define TREE_SEC_INFO_RESET                 0x00000002
+#define TREE_SEC_INFO_RESET_KEEP_EXPLICIT   0x00000003
+#endif
+
+struct tree_security
+{
+    SE_OBJECT_TYPE type;
+    SECURITY_INFORMATION info;
+    PSID owner, group;
+    BOOL keep_explicit;
+    FN_PROGRESS progress;
+    PROG_INVOKE_SETTING pis;
+    void *args;
+    DWORD error;
+};
+
+/* the explicit ACEs of an ACL (none when resetting), as a new ACL */
+static ACL *explicit_part( const ACL *acl, BOOL keep )
+{
+    DWORD size = sizeof(ACL) + (acl ? acl->AclSize : 0);
+    ACE_HEADER *ace;
+    ACL *ret;
+    DWORD i;
+
+    if (!(ret = malloc( size ))) return NULL;
+    InitializeAcl( ret, size, ACL_REVISION );
+    for (i = 0; keep && acl && i < acl->AceCount; i++)
+    {
+        if (!GetAce( (ACL *)acl, i, (void **)&ace )) break;
+        if (ace->AceFlags & INHERITED_ACE) continue;
+        AddAce( ret, ACL_REVISION, MAXDWORD, ace, ace->AceSize );
+    }
+    return ret;
+}
+
+/* explicit ACEs followed by what a child inherits from its parent's ACL */
+static ACL *inherit_acl( const ACL *explicit, const ACL *parent, BOOL container )
+{
+    DWORD size = sizeof(ACL) + (explicit ? explicit->AclSize : 0) + (parent ? parent->AclSize : 0);
+    ACE_HEADER *ace, *copy;
+    ACL *ret;
+    DWORD i;
+    BYTE flags;
+
+    if (!(ret = malloc( size ))) return NULL;
+    InitializeAcl( ret, size, ACL_REVISION );
+    for (i = 0; explicit && i < explicit->AceCount; i++)
+        if (GetAce( (ACL *)explicit, i, (void **)&ace )) AddAce( ret, ACL_REVISION, MAXDWORD, ace, ace->AceSize );
+    for (i = 0; parent && i < parent->AceCount; i++)
+    {
+        if (!GetAce( (ACL *)parent, i, (void **)&ace )) break;
+        flags = ace->AceFlags;
+        if (container)
+        {
+            if (flags & CONTAINER_INHERIT_ACE)
+                flags = (flags & NO_PROPAGATE_INHERIT_ACE) ? 0 : (flags & ~INHERIT_ONLY_ACE);
+            else if ((flags & OBJECT_INHERIT_ACE) && !(flags & NO_PROPAGATE_INHERIT_ACE))
+                flags |= INHERIT_ONLY_ACE;  /* passed on to the files below */
+            else continue;
+        }
+        else
+        {
+            if (!(flags & OBJECT_INHERIT_ACE)) continue;
+            flags = 0;
+        }
+        flags = (flags & (CONTAINER_INHERIT_ACE | OBJECT_INHERIT_ACE | NO_PROPAGATE_INHERIT_ACE | INHERIT_ONLY_ACE)) | INHERITED_ACE;
+        if (!AddAce( ret, ACL_REVISION, MAXDWORD, ace, ace->AceSize )) continue;
+        if (GetAce( ret, ret->AceCount - 1, (void **)&copy )) copy->AceFlags = flags | (ace->AceFlags & (SUCCESSFUL_ACCESS_ACE_FLAG | FAILED_ACCESS_ACE_FLAG));
+    }
+    return ret;
+}
+
+static BOOL tree_progress( struct tree_security *tree, WCHAR *name, DWORD status )
+{
+    if (!tree->progress || tree->pis == ProgressInvokeNever) return TRUE;
+    if (tree->pis == ProgressInvokeOnError && !status) return TRUE;
+    tree->progress( name, status, &tree->pis, tree->args, TRUE );
+    return tree->pis != ProgressCancelOperation;
+}
+
+/* below "path", whose DACL and SACL are given */
+static BOOL tree_children( struct tree_security *tree, const WCHAR *path, const ACL *parent_dacl, const ACL *parent_sacl )
+{
+    SECURITY_INFORMATION child_info = tree->info & (OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION |
+                                                    DACL_SECURITY_INFORMATION | SACL_SECURITY_INFORMATION);
+    WIN32_FIND_DATAW data;
+    WCHAR *child, *pattern;
+    HANDLE find = INVALID_HANDLE_VALUE;
+    HKEY key = NULL;
+    DWORD index = 0, len, status;
+    BOOL ret = TRUE, container;
+
+    if (tree->type == SE_FILE_OBJECT)
+    {
+        if (!(pattern = malloc( (wcslen( path ) + 3) * sizeof(WCHAR) ))) return FALSE;
+        swprintf( pattern, wcslen( path ) + 3, L"%s\\*", path );
+        find = FindFirstFileW( pattern, &data );
+        free( pattern );
+        if (find == INVALID_HANDLE_VALUE) return TRUE;
+    }
+    else
+    {
+        HKEY root;
+        const WCHAR *sub = path;
+
+        if (!wcsnicmp( sub, L"MACHINE\\", 8 )) { root = HKEY_LOCAL_MACHINE; sub += 8; }
+        else if (!wcsnicmp( sub, L"USERS\\", 6 )) { root = HKEY_USERS; sub += 6; }
+        else if (!wcsnicmp( sub, L"CURRENT_USER\\", 13 )) { root = HKEY_CURRENT_USER; sub += 13; }
