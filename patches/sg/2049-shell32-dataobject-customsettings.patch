+static HRESULT read_custom_string(const WCHAR *ini, const WCHAR *key, WCHAR *buffer, DWORD size, DWORD mask_bit,
+                                  DWORD *mask)
+{
+    if (!buffer || !size) return E_INVALIDARG;
+    GetPrivateProfileStringW(L".ShellClassInfo", key, L"", buffer, size, ini);
+    if (!buffer[0]) *mask &= ~mask_bit;
+    return S_OK;
+}
