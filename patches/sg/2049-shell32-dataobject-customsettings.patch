+                    GetPrivateProfileStringW(L".ShellClassInfo", L"IconFile", L"", fcs->pszIconFile, fcs->cchIconFile, ini);
+                    if (!fcs->pszIconFile[0]) mask &= ~FCSM_ICONFILE;
+                    else fcs->iIconIndex = GetPrivateProfileIntW(L".ShellClassInfo", L"IconIndex", 0, ini);
+                }
+                else if ((comma = wcsrchr(fcs->pszIconFile, ',')))
+                {
+                    *comma = 0;
+                    fcs->iIconIndex = wcstol(comma + 1, NULL, 10);
+                }
+            }
+        }
+        if (SUCCEEDED(hr) && (mask & FCSM_INFOTIP))
+            hr = read_custom_string(ini, L"InfoTip", fcs->pszInfoTip, fcs->cchInfoTip, FCSM_INFOTIP, &mask);
+        if (SUCCEEDED(hr) && (mask & FCSM_LOGO))
+            hr = read_custom_string(ini, L"Logo", fcs->pszLogo, fcs->cchLogo, FCSM_LOGO, &mask);
+        if (SUCCEEDED(hr) && (mask & FCSM_CLSID))
+        {
+            WCHAR guid[64];
+
+            if (!fcs->pclsid) hr = E_INVALIDARG;
+            else
+            {
+                GetPrivateProfileStringW(L".ShellClassInfo", L"CLSID", L"", guid, ARRAY_SIZE(guid), ini);
+                if (!guid[0] || FAILED(CLSIDFromString(guid, fcs->pclsid))) mask &= ~FCSM_CLSID;
+            }
+        }
+        if (SUCCEEDED(hr)) fcs->dwMask = mask;
+    }
 
     return hr;
 }
 
 /***********************************************************************
  * SHLimitInputEdit (SHELL32.747)
+ *
+ * An edit control that refuses the characters a file name cannot have: typed
+ * ones are dropped, pasted text is cleaned.
  */
+struct limit_edit
+{
+    WCHAR invalid[16];
+};
+
+static LRESULT CALLBACK limit_edit_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, UINT_PTR id, DWORD_PTR ref)
+{
+    struct limit_edit *limit = (struct limit_edit *)ref;
+
+    switch (msg)
+    {
+    case WM_CHAR:
+#ifndef SG_MUTANT_LIMIT_CHAR
+        if (wp >= ' ' && wp < 0x10000 && wcschr(limit->invalid, (WCHAR)wp)) return 0;
+#endif
+        break;
+    case WM_PASTE:
+        if (OpenClipboard(hwnd))
+        {
+            HANDLE data = GetClipboardData(CF_UNICODETEXT);
+            WCHAR *text = NULL, *src, *dst;
+
+            if (data && (src = GlobalLock(data)))
+            {
+                if ((text = wcsdup(src)))
+                {
+                    for (src = dst = text; *src; src++)
+#ifdef SG_MUTANT_LIMIT_PASTE
+                        *dst++ = *src;
+#else
+                        if (!wcschr(limit->invalid, *src)) *dst++ = *src;
+#endif
+                    *dst = 0;
+                }
+                GlobalUnlock(data);
+            }
+            CloseClipboard();
+            if (text)
+            {
+                SendMessageW(hwnd, EM_REPLACESEL, TRUE, (LPARAM)text);
+                free(text);
+                return 0;
+            }
+        }
+        break;
+    case WM_NCDESTROY:
+        RemoveWindowSubclass(hwnd, limit_edit_proc, id);
+        free(limit);
+        break;
+    }
+    return DefSubclassProc(hwnd, msg, wp, lp);
+}
+
 HRESULT WINAPI SHLimitInputEdit( HWND textbox, IShellFolder *folder )
 {
-    FIXME("%p %p: stub\n", textbox, folder);
-    return E_NOTIMPL;
+    struct limit_edit *limit;
+    DWORD_PTR old;
+
+    TRACE("%p %p\n", textbox, folder);
+
+    if (!textbox || !IsWindow(textbox) || !folder) return E_FAIL;
+    if (!(limit = calloc(1, sizeof(*limit)))) return E_OUTOFMEMORY;
+    lstrcpyW(limit->invalid, L"\\/:*?\"<>|");
+
+    /* a second call replaces the first one's limits */
+    if (GetWindowSubclass(textbox, limit_edit_proc, 1, &old)) free((void *)old);
+    if (!SetWindowSubclass(textbox, limit_edit_proc, 1, (DWORD_PTR)limit))
+    {
+        free(limit);
+        return E_FAIL;
+    }
+    return S_OK;
 }
