+/* Whether every item is a file or folder of the file system: the others have no paths to hand over */
+static BOOL items_are_files(const ITEMIDLIST *root_pidl, const ITEMIDLIST **pidls, unsigned int count)
+{
+    unsigned int i;
+
+#ifdef SG_MUTANT_DATAOBJ_ALWAYS_FILES
+    return TRUE;
+#endif
+    if (!count) return TRUE;
+    for (i = 0; i < count; i++)
+    {
+        WCHAR path[MAX_PATH];
+        ITEMIDLIST *full = ILCombine(root_pidl, pidls[i]);
+        BOOL ok = full && SHGetPathFromIDListW(full, path) && path[0];
+
+        ILFree(full);
+        if (!ok) return FALSE;
+    }
+    return TRUE;
+}
