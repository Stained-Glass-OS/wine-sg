 /***********************************************************************
  *           TpSetTimer    (NTDLL.@)
  */
+/***********************************************************************
+ *           TpSetTimerEx    (NTDLL.@)
+ *
+ * TpSetTimer, telling whether the timer was pending (and is replaced or
+ * cancelled). kernel32's SetThreadpoolTimerEx.
+ */
+BOOL WINAPI TpSetTimerEx( TP_TIMER *timer, LARGE_INTEGER *timeout, LONG period, LONG window_length )
+{
+    struct threadpool_object *this = impl_from_TP_TIMER( timer );
+    BOOL pending;
+
+    RtlEnterCriticalSection( &timerqueue.cs );
+    pending = this->u.timer.timer_pending;
+    TpSetTimer( timer, timeout, period, window_length );
+    RtlLeaveCriticalSection( &timerqueue.cs );
+    return pending;
+}
+
 VOID WINAPI TpSetTimer( TP_TIMER *timer, LARGE_INTEGER *timeout, LONG period, LONG window_length )
 {
     struct threadpool_object *this = impl_from_TP_TIMER( timer );
