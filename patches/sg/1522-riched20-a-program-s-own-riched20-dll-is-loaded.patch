From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: a program's own riched20.dll is loaded

Microsoft Office ships its own RICHED20.DLL (RichEdit 8, in
root\vfs\ProgramFilesCommonX64\Microsoft Shared\Office16) and loads it by
full path. It is a different library from the system's riched20: it has
exports and interfaces the system one never had -- CreateTextBoxLayout,
and a text-services interface {19dae8db-ddc7-4130-833f-e6abbb8101fc} that
Excel uses for every cell -- none of them documented. Windows loads the
file a program names. Wine put its builtin riched20 in its place:
PowerPoint said "There's not enough memory or system resources to start
PowerPoint" (GetProcAddress(CreateTextBoxLayout) failed), Excel crashed
typing into a cell (QueryInterface of the private interface failed, then
a NULL read), left its font box empty and drew white boxes, Publisher
crashed in a text box and Outlook lost its ribbon and reading pane. With
their own RICHED20 (an override in the QA VM) all of them work.

riched20 now prefers a native file the loader found (winebuild
--prefer-native): loaded by full path, or by name from the program's
directory (searched first, as on Windows), the program's copy is used; by
name from anywhere else, or by its system32 path, the system's -- ours --
still is. Wine's own modules are built on Wine's riched20 and must not get
a program's copy found first beside it: msftedit (WordPad, sg-wordpad and
every RICHEDIT50W user) and riched32 import it, so a builtin module's import
or forward of riched20 comes from the system directory (ntdll), and
msftedit loads it from there to register its classes.

Gate: test/richedprivate-gate.sh (a stand-in private riched20.dll; full
path, exe directory, elsewhere, system32 path; msftedit and riched32 beside
the private copy and elsewhere). The unpatched build fails the first two;
mutants SG_MUTANT_RICHED_BUILTIN_IMPORT (ntdll) and
SG_MUTANT_MSFTEDIT_ANY_RICHED20 fail the msftedit/riched32 cases.
Conformance: riched20, riched32, msftedit, kernel32 loader/module -- same
results with and without the patch.
---
--- a/dlls/msftedit/msftedit_main.c
+++ b/dlls/msftedit/msftedit_main.c
@@ -48,7 +48,14 @@
     {
     case DLL_PROCESS_ATTACH:
         /* explicitly load riched20 since it creates the window classes at dll attach time */
+#ifndef SG_MUTANT_MSFTEDIT_ANY_RICHED20
+        /* Stained Glass OS (wine-sg 1522): the system's riched20, which this
+         * one is built on -- not a program's own riched20.dll (Office's,
+         * which riched20 now lets programs load), found first beside it */
+        richedit = LoadLibraryExW( L"riched20.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32 );
+#else
         richedit = LoadLibraryW( L"riched20.dll" );
+#endif
         DisableThreadLibraryCalls(inst);
         break;
     case DLL_PROCESS_DETACH:
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -3308,6 +3308,7 @@
     SECTION_IMAGE_INFORMATION image_info;
     NTSTATUS nts = STATUS_DLL_NOT_FOUND;
     void *prev;
+    BOOL builtin_importer = system;
 
     TRACE( "looking for %s in %s\n", debugstr_w(libname), debugstr_w(load_path) );
 
@@ -3320,6 +3321,40 @@
         system = FALSE;
     }
 
+    /* Stained Glass OS (wine-sg 1522): riched20 prefers a program's own copy
+     * (Office's RICHED20.DLL), but Wine's own modules are built against
+     * Wine's: msftedit imports and forwards to riched20, and a riched20.dll
+     * beside the program was taken for it (no CreateTextServices, no
+     * RICHEDIT50W). Their imports of it come from the system directory. */
+    if (builtin_importer && !nts && !*pwm && !wcschr( libname, '\\' ) && !wcschr( libname, '/' ) &&
+        !wcsnicmp( libname, L"riched20", 8 ) && (!libname[8] || !wcsicmp( libname + 8, L".dll" )) &&
+        wcsnicmp( nt_name.Buffer + 4, system_dir, wcslen( system_dir ) ))
+    {
+#ifndef SG_MUTANT_RICHED_BUILTIN_IMPORT
+        UNICODE_STRING sys_name;
+        HANDLE sys_mapping = 0;
+        SECTION_IMAGE_INFORMATION sys_info;
+        struct file_id sys_id;
+        WINE_MODREF *sys_wm = NULL;
+        WCHAR sysdir[MAX_PATH];
+
+        wcscpy( sysdir, system_dir );
+        sysdir[wcslen( sysdir ) - 1] = 0;  /* no trailing backslash in a search path */
+        if (!search_dll_file( sysdir, libname, &sys_name, &sys_wm, &sys_mapping, &sys_info, &sys_id ))
+        {
+            TRACE( "%s: Wine's own for a builtin importer: %s, not %s\n", debugstr_w(libname),
+                   debugstr_us(&sys_name), debugstr_us(&nt_name) );
+            if (mapping) NtClose( mapping );
+            RtlFreeUnicodeString( &nt_name );
+            nt_name = sys_name;
+            mapping = sys_mapping;
+            image_info = sys_info;
+            id = sys_id;
+            *pwm = sys_wm;
+        }
+#endif
+    }
+
     if (*pwm)  /* found already loaded module */
     {
         if ((*pwm)->ldr.LoadCount != -1) (*pwm)->ldr.LoadCount++;
--- a/dlls/riched20/Makefile.in
+++ b/dlls/riched20/Makefile.in
@@ -2,7 +2,7 @@
 IMPORTLIB = riched20
 IMPORTS   = uuid ole32 oleaut32 imm32 user32 gdi32
 
-EXTRADLLFLAGS = -Wl,--image-base,0x7ac00000
+EXTRADLLFLAGS = -Wl,--image-base,0x7ac00000 -Wb,--prefer-native
 
 SOURCES = \
 	caret.c \
