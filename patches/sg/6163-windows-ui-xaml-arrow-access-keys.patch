+/* AccessKey and AccessKeyInvoked */
+WCHAR *xaml_access_key( struct uielem *elem )
+{
+    IInspectable *box = NULL;
+    WCHAR *str;
+
+    xaml_elements_init();
+    dobj_get_value( &elem->d, prop_access_key, &box );
+    str = xunbox_string( box );
+    if (box) IInspectable_Release( box );
+    if (str && !*str)
+    {
+        free( str );
+        str = NULL;
+    }
+    return str;
+}
+
+static HRESULT WINAPI uielement4_get_AccessKey( struct xiface *iface, HSTRING *value )
+{
+    WCHAR *str;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    str = xaml_access_key( elem_from_iface( iface ) );
+    hr = WindowsCreateString( str ? str : L"", str ? wcslen( str ) : 0, value );
+    free( str );
+    return hr;
+}
+
+static HRESULT WINAPI uielement4_put_AccessKey( struct xiface *iface, HSTRING value )
+{
+    IInspectable *box = xbox_string( WindowsGetStringRawBuffer( value, NULL ) );
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &elem_from_iface( iface )->d, prop_access_key, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static HRESULT WINAPI uielement4_add_AccessKeyInvoked( struct xiface *iface, IUnknown *handler, INT64 *token )
+{
+    return handlers_add( &elem_from_iface( iface )->access_key_invoked, handler, token );
+}
+
+static HRESULT WINAPI uielement4_remove_AccessKeyInvoked( struct xiface *iface, INT64 token )
+{
+    return handlers_remove( &elem_from_iface( iface )->access_key_invoked, token );
+}
+
+/* AccessKeyInvokedEventArgs: Handled */
+struct access_args
+{
+    struct xobj obj;
+    struct xiface iface;
+    boolean handled;
+};
+
+static const struct xiface_entry access_args_ifaces[] =
+{
+    { &IID_IAccessKeyInvokedEventArgs, offsetof(struct access_args, iface) },
+};
+
+static const struct xclass access_args_class =
+{
+    L"Windows.UI.Xaml.Input.AccessKeyInvokedEventArgs", access_args_ifaces, ARRAY_SIZE(access_args_ifaces), NULL,
+};
+
+static HRESULT WINAPI access_args_get_Handled( struct xiface *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = CONTAINING_RECORD( iface->obj, struct access_args, obj )->handled;
+    return S_OK;
+}
+
+static HRESULT WINAPI access_args_put_Handled( struct xiface *iface, boolean value )
+{
+    CONTAINING_RECORD( iface->obj, struct access_args, obj )->handled = value;
+    return S_OK;
+}
+
+static const void *access_args_vtbl[] =
+{
+    IAccessKeyInvokedEventArgs_STUBS,
+    [IAccessKeyInvokedEventArgs_Handled] = access_args_get_Handled,
+    [IAccessKeyInvokedEventArgs_SetHandled] = access_args_put_Handled,
+};
+
+/* AccessKeyInvoked raised on the element; TRUE when a handler handled it */
+BOOL xaml_access_key_invoked( struct uielem *elem )
+{
+    struct access_args *args;
+    IInspectable *sender = NULL;
+    BOOL handled;
+
+    if (list_empty( &elem->access_key_invoked.entries )) return FALSE;
+    if (!(args = calloc( 1, sizeof(*args) ))) return FALSE;
+    args->iface.vtbl = access_args_vtbl;
+    xobj_init( &args->obj, &access_args_class, NULL );
+    IUnknown_QueryInterface( elem->d.obj.outer, &IID_IInspectable, (void **)&sender );
+    xaml_raise_routed( &elem->access_key_invoked, sender, (IInspectable *)&args->iface );
+    if (sender) IInspectable_Release( sender );
+    handled = args->handled;
+    IInspectable_Release( (IInspectable *)&args->iface );
+    return handled;
+}
+
 static const void *uielement4_vtbl[] =
 {
     IUIElement4_STUBS,
+    [IUIElement4_AccessKey] = uielement4_get_AccessKey,
+    [IUIElement4_SetAccessKey] = uielement4_put_AccessKey,
+    [IUIElement4_AccessKeyInvoked] = uielement4_add_AccessKeyInvoked,
+    [IUIElement4_RemoveAccessKeyInvoked] = uielement4_remove_AccessKeyInvoked,
     [IUIElement4_ContextFlyout] = uielement4_get_ContextFlyout,
