+#include <math.h>
 #include <stdlib.h>
 #include "private.h"
 #include <limits.h>
@@ -489,6 +490,284 @@ BOOL xaml_focus_navigate( HWND hwnd, IInspectable *content, INT32 reason )
     return ret;
