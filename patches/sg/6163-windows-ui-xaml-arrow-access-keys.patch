+/* ---- arrow keys: the focus to the nearest focus target that way (XY focus) ---- */
+
+struct xy_target { struct uielem *elem; FLOAT x, y, w, h; };
+
+static void elem_bounds( struct uielem *elem, FLOAT *x, FLOAT *y )
+{
+    *x = *y = 0;
+    for (; elem; elem = elem->parent)
+    {
+        *x += elem->offset.x;
+        *y += elem->offset.y;
+    }
+}
+
+static void collect_xy( struct uielem *elem, struct xy_target *out, unsigned int *count, unsigned int size )
+{
+    struct uielem *child;
+
+    if (!tab_visible( elem )) return;
+    if (xaml_is_focus_target( elem ) && *count < size)
+    {
+        struct xy_target *t = &out[(*count)++];
+        t->elem = elem;
+        elem_bounds( elem, &t->x, &t->y );
+        t->w = elem->render.width;
+        t->h = elem->render.height;
+    }
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry ) collect_xy( child, out, count, size );
+}
+
+/* where arrow keys move the focus: the nearest container above it with XYFocusKeyboardNavigation
+ * Enabled (none when one says Disabled first), else a CommandBar's buttons left and right */
+static struct uielem *xy_scope( struct uielem *elem, UINT vk )
+{
+    struct uielem *a;
+
+    for (a = elem->parent; a; a = a->parent)
+    {
+        INT32 mode = xaml_xy_keyboard_navigation( a );
+        if (mode == 1) return a;
+        if (mode == 2) return NULL;
+        if ((vk == VK_LEFT || vk == VK_RIGHT) && xaml_is_command_bar( a )) return a;
+    }
+    return NULL;
+}
+
+static BOOL move_focus_xy( HWND hwnd, UINT vk )
+{
+    struct uielem *scope;
+    struct xy_target *targets, cur;
+    unsigned int count = 0, i;
+    struct uielem *best = NULL;
+    FLOAT best_score = 0;
+
+    if (!focus || xaml_is_text_box( focus ) || !(scope = xy_scope( focus, vk ))) return FALSE;
+#ifdef SG_MUTANT_XAML_NO_XY_FOCUS
+    return FALSE;
+#endif
+    if (!(targets = malloc( MAX_TAB * sizeof(*targets) ))) return FALSE;
+    collect_xy( scope, targets, &count, MAX_TAB );
+    cur.elem = focus;
+    elem_bounds( focus, &cur.x, &cur.y );
+    cur.w = focus->render.width;
+    cur.h = focus->render.height;
+    for (i = 0; i < count; i++)
+    {
+        struct xy_target *t = &targets[i];
+        FLOAT primary, overlap, cross, score;
+
+        if (t->elem == focus) continue;
+        /* beyond the focused one that way; the distance along it and how far it is off the line */
+        switch (vk)
+        {
+        case VK_RIGHT: primary = t->x - (cur.x + cur.w); break;
+        case VK_LEFT: primary = cur.x - (t->x + t->w); break;
+        case VK_DOWN: primary = t->y - (cur.y + cur.h); break;
+        default: primary = cur.y - (t->y + t->h); break;
+        }
+        if (primary < -0.5f) continue;
+        if (vk == VK_LEFT || vk == VK_RIGHT)
+        {
+            overlap = fminf( t->y + t->h, cur.y + cur.h ) - fmaxf( t->y, cur.y );
+            cross = fabsf( (t->y + t->h / 2) - (cur.y + cur.h / 2) );
+        }
+        else
+        {
+            overlap = fminf( t->x + t->w, cur.x + cur.w ) - fmaxf( t->x, cur.x );
+            cross = fabsf( (t->x + t->w / 2) - (cur.x + cur.w / 2) );
+        }
+        /* those in line first, then the nearest */
+        score = fmaxf( primary, 0 ) + (overlap > 0 ? 0 : 10000) + cross * 2;
+        if (!best || score < best_score)
+        {
+            best = t->elem;
+            best_score = score;
+        }
+    }
+    free( targets );
+    if (!best) return FALSE;
+    TRACE( "arrow %#x to %p\n", vk, best );
+    xaml_focus_element_state( best, hwnd, 2 );
+    return TRUE;
+}
+
+/* ---- access keys: Alt alone shows the key tips (display mode), then the keys typed invoke an
+ * element; Alt+key invokes at once; Escape leaves ---- */
+
+static HWND access_hwnd;            /* the island in display mode, or NULL */
+static WCHAR access_typed[16];
+static BOOL alt_alone, access_ate_char;
+
+struct access_list { struct uielem *items[256]; WCHAR *keys[256]; unsigned int count; };
+
+static void collect_access( struct uielem *elem, struct access_list *list )
+{
+    struct uielem *child;
+    WCHAR *key;
+
+    if (!tab_visible( elem )) return;
+    if (list->count < ARRAY_SIZE(list->items) && (key = xaml_access_key( elem )))
+    {
+        list->items[list->count] = elem;
+        list->keys[list->count++] = key;
+    }
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry ) collect_access( child, list );
+}
+
+static void free_access( struct access_list *list )
+{
+    unsigned int i;
+    for (i = 0; i < list->count; i++) free( list->keys[i] );
+}
+
+BOOL xaml_access_key_display( HWND hwnd )
+{
+    return access_hwnd && access_hwnd == hwnd;
+}
+
+void xaml_access_key_exit(void)
+{
+    if (!access_hwnd) return;
+    TRACE( "display mode off\n" );
+    access_hwnd = NULL;
+    xaml_invalidate_visuals();
+}
+
+static void access_invoke( HWND hwnd, struct uielem *elem )
+{
+    TRACE( "%p\n", elem );
+    xaml_access_key_exit();
+    access_typed[0] = 0;
+    if (xaml_access_key_invoked( elem )) return;
+    /* not handled: a button clicks, what takes the keyboard takes the focus */
+    if (xaml_is_button( elem ) && xaml_is_focus_target( elem )) xaml_button_click( elem );
+    else if (xaml_is_focus_target( elem )) xaml_focus_element_state( elem, hwnd, 2 );
+}
+
+/* the keys typed so far (with ch): an element whose AccessKey they are is invoked (2); 1 when some key
+ * still begins with them, else 0 (and they start again) */
+static int access_type( HWND hwnd, IInspectable *content, WCHAR ch )
+{
+    struct uielem *root = uielem_from_inspectable( content ), *hit = NULL;
+    struct access_list *list;
+    size_t len = wcslen( access_typed );
+    unsigned int i;
+    BOOL prefix = FALSE;
+
+    if (!root || !(list = calloc( 1, sizeof(*list) ))) return 0;
+    if (len + 1 < ARRAY_SIZE(access_typed))
+    {
+        access_typed[len] = ch;
+        access_typed[len + 1] = 0;
+    }
+    collect_access( root, list );
+    for (i = 0; i < list->count; i++)
+    {
+        if (!wcsicmp( list->keys[i], access_typed )) { if (!hit) hit = list->items[i]; }
+        else if (!wcsnicmp( list->keys[i], access_typed, wcslen( access_typed ) )) prefix = TRUE;
+    }
+    if (hit) IUnknown_AddRef( hit->d.obj.outer );
+    free_access( list );
+    free( list );
+    if (hit)
+    {
+        access_invoke( hwnd, hit );
+        IUnknown_Release( hit->d.obj.outer );
+        return 2;
+    }
+    if (!prefix) access_typed[0] = 0;   /* no key goes on like this: start again */
+    return prefix ? 1 : 0;
+}
+
+static BOOL has_access_keys( IInspectable *content )
+{
+    struct uielem *root = uielem_from_inspectable( content );
+    struct access_list *list;
+    BOOL ret;
+
+    if (!root || !(list = calloc( 1, sizeof(*list) ))) return FALSE;
+    collect_access( root, list );
+    ret = list->count > 0;
+    free_access( list );
+    free( list );
+    return ret;
+}
+
+static BOOL access_key_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspectable *content )
+{
+#ifdef SG_MUTANT_XAML_NO_ACCESS_KEYS
+    return FALSE;
+#endif
+    switch (msg)
+    {
+    case WM_SYSKEYDOWN:
+        if (wparam == VK_MENU)
+        {
+            if (!(lparam & 0x40000000)) alt_alone = TRUE;
+            return FALSE;
+        }
+        alt_alone = FALSE;
+        /* Alt+key: the element at once */
+        if ((wparam >= '0' && wparam <= '9') || (wparam >= 'A' && wparam <= 'Z'))
+        {
+            int r;
+            if (!access_hwnd) access_typed[0] = 0;
+            if ((r = access_type( hwnd, content, wparam )))
+            {
+                /* a key of more letters: display mode goes on with the next ones */
+                if (r == 1 && !access_hwnd)
+                {
+                    access_hwnd = hwnd;
+                    xaml_invalidate_visuals();
+                }
+                access_ate_char = TRUE;
+                return TRUE;
+            }
+        }
+        return FALSE;
+    case WM_SYSKEYUP:
+        if (wparam != VK_MENU || !alt_alone) return FALSE;
+        alt_alone = FALSE;
+        if (access_hwnd)
+        {
+            xaml_access_key_exit();
+            return TRUE;
+        }
+        if (!has_access_keys( content )) return FALSE;   /* the window's menu keeps Alt */
+        TRACE( "display mode on\n" );
+        access_hwnd = hwnd;
+        access_typed[0] = 0;
+        xaml_invalidate_visuals();
+        return TRUE;
+    case WM_SYSCHAR:
+        if (!access_ate_char) return FALSE;
+        access_ate_char = FALSE;
+        return TRUE;
+    case WM_KEYDOWN:
+        alt_alone = FALSE;
+        if (!xaml_access_key_display( hwnd )) return FALSE;
+        if (wparam == VK_ESCAPE)
+        {
+            xaml_access_key_exit();
+            return TRUE;
+        }
+        return (wparam >= '0' && wparam <= '9') || (wparam >= 'A' && wparam <= 'Z');   /* typed as WM_CHAR */
+    case WM_KEYUP:
+        return xaml_access_key_display( hwnd ) && ((wparam >= '0' && wparam <= '9') || (wparam >= 'A' && wparam <= 'Z'));
+    case WM_CHAR:
+        if (!xaml_access_key_display( hwnd )) return FALSE;
+        if (wparam > ' ') access_type( hwnd, content, wparam );
+        return TRUE;
+    case WM_KILLFOCUS:
+        if (xaml_access_key_display( hwnd )) xaml_access_key_exit();
+        return FALSE;
+    }
+    return FALSE;
+}
+
 BOOL xaml_key_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspectable *content )
 {
     struct uielem *target = focus && in_content( focus, content ) ? focus : uielem_from_inspectable( content );
@@ -496,6 +775,7 @@ BOOL xaml_key_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspe
     IInspectable *source;
     BOOL up = msg == WM_KEYUP || msg == WM_SYSKEYUP;
 
+    if (access_key_message( hwnd, msg, wparam, lparam, content )) return TRUE;
     switch (msg)
     {
     case WM_KEYDOWN:
@@ -543,6 +823,8 @@ BOOL xaml_key_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspe
         }
         if (!args->handled && !up && wparam == VK_TAB)
             args->handled = move_focus( hwnd, content, GetKeyState( VK_SHIFT ) < 0 );
+        if (!args->handled && !up && target == focus && (wparam == VK_LEFT || wparam == VK_RIGHT || wparam == VK_UP || wparam == VK_DOWN))
+            args->handled = move_focus_xy( hwnd, wparam );
         TRACE( "%p: key %#Ix %s, handled %d\n", target, wparam, up ? "up" : "down", args->handled );
         IUnknown_Release( args->obj.outer );
         return msg == WM_KEYDOWN || msg == WM_KEYUP;
@@ -574,3 +856,46 @@ BOOL xaml_key_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspe
     }
