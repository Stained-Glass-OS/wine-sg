+/* access key display mode: each element's AccessKey in a tip below its middle, in the text colours swapped */
+static void render_key_tips( struct uielem *elem, ID2D1RenderTarget *target, FLOAT x, FLOAT y )
+{
+    struct uielem *child;
+    WCHAR *key;
+
+    if (elem->visibility == XCOLLAPSED || !elem->arrange_valid) return;
+    x += elem->offset.x;
+    y += elem->offset.y;
+    if ((key = xaml_access_key( elem )))
+    {
+        struct xdraw draw = { target, 0, 0 };
+        struct xsize size;
+        struct xrect rect;
+        IUnknown *layout = xaml_make_text_layout( key, NULL, 12, 400, &size );
+
+        if (layout)
+        {
+            rect.width = size.width + 8;
+            rect.height = size.height + 2;
+            rect.x = x + (elem->render.width - rect.width) / 2;
+            rect.y = y + elem->render.height - rect.height / 2;
+            xdraw_fill( &draw, &rect, xaml_theme_color( XTHEME_TEXT ), NULL );
+            xdraw_text( &draw, layout, rect.x + 4, rect.y + 1, xaml_theme_color( XTHEME_BACKGROUND ) );
+            IUnknown_Release( layout );
+        }
+        free( key );
+    }
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry ) render_key_tips( child, target, x, y );
+}
