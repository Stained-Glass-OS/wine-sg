+++ b/dlls/dxgi/output_dup.c
@@ -0,0 +1,512 @@
+/*
+ * IDXGIOutputDuplication: desktop duplication by copying the output's display
+ * image into a texture of the caller's Direct3D 11 device.
+ *
+ * Every frame is the whole output captured through its display device context.
+ * A frame counts as new when its contents differ from the previous one, so
+ * AcquireNextFrame waits (polling) until the desktop changes or the timeout
+ * ends. Pointer shapes, move rectangles and mapping the desktop surface are not
+ * provided: the pointer is reported as not visible, there are no move
+ * rectangles, and MapDesktopSurface says DXGI_ERROR_UNSUPPORTED the way a
+ * desktop that lives in video memory does.
+ *
+ * Stained Glass OS: written from the documented interface behaviour.
+ */
+#define COBJMACROS
+#include "d3d11.h"
+#include "dxgi_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dxgi);
+
+#ifndef CAPTUREBLT
+#define CAPTUREBLT 0x40000000
+#endif
+
+struct dxgi_output_duplication
+{
+    IDXGIOutputDuplication IDXGIOutputDuplication_iface;
+    LONG refcount;
+    struct wined3d_private_store private_store;
+
+    IDXGIOutput *output;
+    ID3D11Device *device;
+    ID3D11DeviceContext *context;
+    ID3D11Texture2D *texture;
+    WCHAR device_name[32];
+    UINT width, height;
+    DXGI_MODE_DESC mode;
+    DXGI_MODE_ROTATION rotation;
+
+    BYTE *pixels;
+    UINT64 hash;
+    BOOL have_frame;
+    BOOL frame_held;
+    CRITICAL_SECTION cs;
+};
+
+static inline struct dxgi_output_duplication *impl_from_IDXGIOutputDuplication(IDXGIOutputDuplication *iface)
+{
+    return CONTAINING_RECORD(iface, struct dxgi_output_duplication, IDXGIOutputDuplication_iface);
+}
+
+/* Copy the display image of a device into pixels (width * height, BGRA, alpha set). */
+BOOL dxgi_capture_display(const WCHAR *device_name, UINT width, UINT height, BYTE *pixels)
+{
+    BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER) }};
+    HDC screen, mem;
+    HBITMAP bitmap, old;
+    void *bits;
+    BOOL ret = FALSE;
+
+    if (!(screen = CreateDCW(device_name, NULL, NULL, NULL)))
+        return FALSE;
+    mem = CreateCompatibleDC(screen);
+
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -(LONG)height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+
+    bitmap = CreateDIBSection(mem, &info, DIB_RGB_COLORS, &bits, NULL, 0);
+    if (mem && bitmap)
+    {
+        old = SelectObject(mem, bitmap);
+        if (BitBlt(mem, 0, 0, width, height, screen, 0, 0, SRCCOPY | CAPTUREBLT))
+        {
+            UINT i;
+
+            GdiFlush();
+            memcpy(pixels, bits, (SIZE_T)width * height * 4);
+            /* the screen has no alpha channel */
+            for (i = 0; i < width * height; ++i)
+            {
+                pixels[i * 4 + 3] = 0xff;
+#ifdef SG_MUTANT_DUP_RB_SWAPPED
+                { BYTE t = pixels[i * 4]; pixels[i * 4] = pixels[i * 4 + 2]; pixels[i * 4 + 2] = t; }
+#endif
+            }
+            ret = TRUE;
+        }
+        SelectObject(mem, old);
+    }
+    if (bitmap) DeleteObject(bitmap);
+    if (mem) DeleteDC(mem);
+    DeleteDC(screen);
+    return ret;
+}
+
+static BOOL dxgi_output_duplication_capture(struct dxgi_output_duplication *dup)
+{
+    return dxgi_capture_display(dup->device_name, dup->width, dup->height, dup->pixels);
+}
+
+static UINT64 dxgi_output_duplication_hash(const BYTE *data, SIZE_T size)
+{
+    UINT64 hash = 14695981039346656037ull;
+    SIZE_T i;
+
+    for (i = 0; i < size; ++i)
+        hash = (hash ^ data[i]) * 1099511628211ull;
+    return hash;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_output_duplication_QueryInterface(IDXGIOutputDuplication *iface,
+        REFIID iid, void **object)
+{
+    TRACE("iface %p, iid %s, object %p.\n", iface, debugstr_guid(iid), object);
+
+    if (IsEqualGUID(iid, &IID_IDXGIOutputDuplication)
+            || IsEqualGUID(iid, &IID_IDXGIObject)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        IUnknown_AddRef(iface);
+        *object = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+
+    *object = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE dxgi_output_duplication_AddRef(IDXGIOutputDuplication *iface)
+{
+    struct dxgi_output_duplication *dup = impl_from_IDXGIOutputDuplication(iface);
+    ULONG refcount = InterlockedIncrement(&dup->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", dup, refcount);
+
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE dxgi_output_duplication_Release(IDXGIOutputDuplication *iface)
+{
+    struct dxgi_output_duplication *dup = impl_from_IDXGIOutputDuplication(iface);
+    ULONG refcount = InterlockedDecrement(&dup->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", dup, refcount);
+
+    if (!refcount)
+    {
+        wined3d_private_store_cleanup(&dup->private_store);
+        if (dup->texture) ID3D11Texture2D_Release(dup->texture);
+        if (dup->context) ID3D11DeviceContext_Release(dup->context);
+        if (dup->device) ID3D11Device_Release(dup->device);
+        if (dup->output) IDXGIOutput_Release(dup->output);
+        DeleteCriticalSection(&dup->cs);
+        free(dup->pixels);
+        free(dup);
+    }
+
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_output_duplication_SetPrivateData(IDXGIOutputDuplication *iface,
+        REFGUID guid, UINT data_size, const void *data)
+{
+    struct dxgi_output_duplication *dup = impl_from_IDXGIOutputDuplication(iface);
+
+    TRACE("iface %p, guid %s, data_size %u, data %p.\n", iface, debugstr_guid(guid), data_size, data);
+
+    return dxgi_set_private_data(&dup->private_store, guid, data_size, data);
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_output_duplication_SetPrivateDataInterface(IDXGIOutputDuplication *iface,
+        REFGUID guid, const IUnknown *object)
+{
+    struct dxgi_output_duplication *dup = impl_from_IDXGIOutputDuplication(iface);
+
+    TRACE("iface %p, guid %s, object %p.\n", iface, debugstr_guid(guid), object);
+
+    return dxgi_set_private_data_interface(&dup->private_store, guid, object);
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_output_duplication_GetPrivateData(IDXGIOutputDuplication *iface,
+        REFGUID guid, UINT *data_size, void *data)
+{
+    struct dxgi_output_duplication *dup = impl_from_IDXGIOutputDuplication(iface);
+
+    TRACE("iface %p, guid %s, data_size %p, data %p.\n", iface, debugstr_guid(guid), data_size, data);
+
+    return dxgi_get_private_data(&dup->private_store, guid, data_size, data);
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_output_duplication_GetParent(IDXGIOutputDuplication *iface,
+        REFIID riid, void **parent)
+{
+    struct dxgi_output_duplication *dup = impl_from_IDXGIOutputDuplication(iface);
+
+    TRACE("iface %p, riid %s, parent %p.\n", iface, debugstr_guid(riid), parent);
+
+    return IDXGIOutput_QueryInterface(dup->output, riid, parent);
+}
+
+static void STDMETHODCALLTYPE dxgi_output_duplication_GetDesc(IDXGIOutputDuplication *iface,
+        DXGI_OUTDUPL_DESC *desc)
+{
+    struct dxgi_output_duplication *dup = impl_from_IDXGIOutputDuplication(iface);
+
+    TRACE("iface %p, desc %p.\n", iface, desc);
+
+    desc->ModeDesc = dup->mode;
+    desc->Rotation = dup->rotation;
+    desc->DesktopImageInSystemMemory = FALSE;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_output_duplication_AcquireNextFrame(IDXGIOutputDuplication *iface,
+        UINT timeout, DXGI_OUTDUPL_FRAME_INFO *frame_info, IDXGIResource **resource)
+{
+    struct dxgi_output_duplication *dup = impl_from_IDXGIOutputDuplication(iface);
+    DWORD start = GetTickCount();
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, timeout %u, frame_info %p, resource %p.\n", iface, timeout, frame_info, resource);
+
+    if (!frame_info || !resource)
+        return E_INVALIDARG;
+
+    memset(frame_info, 0, sizeof(*frame_info));
+    *resource = NULL;
+
+    EnterCriticalSection(&dup->cs);
+
+#ifndef SG_MUTANT_DUP_NO_HELD_CHECK
+    if (dup->frame_held)
+    {
+        LeaveCriticalSection(&dup->cs);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+#endif
+
+    for (;;)
+    {
+        UINT64 hash;
+
+        if (!dxgi_output_duplication_capture(dup))
+        {
+            hr = DXGI_ERROR_ACCESS_LOST;
+            break;
+        }
+
+        hash = dxgi_output_duplication_hash(dup->pixels, (SIZE_T)dup->width * dup->height * 4);
+#ifdef SG_MUTANT_DUP_ALWAYS_NEW
+        if (1)
+#else
+        if (!dup->have_frame || hash != dup->hash)
+#endif
+        {
+            LARGE_INTEGER now;
+
+            dup->hash = hash;
+            dup->have_frame = TRUE;
+            ID3D11DeviceContext_UpdateSubresource(dup->context, (ID3D11Resource *)dup->texture, 0, NULL,
+                    dup->pixels, dup->width * 4, 0);
+
+            QueryPerformanceCounter(&now);
+            frame_info->LastPresentTime = now;
+            frame_info->AccumulatedFrames = 1;
+            hr = ID3D11Texture2D_QueryInterface(dup->texture, &IID_IDXGIResource, (void **)resource);
+            if (SUCCEEDED(hr))
+                dup->frame_held = TRUE;
+            break;
+        }
+
+        if (timeout != INFINITE && GetTickCount() - start >= timeout)
+        {
+            hr = DXGI_ERROR_WAIT_TIMEOUT;
+            break;
+        }
+
+        LeaveCriticalSection(&dup->cs);
+        Sleep(10);
+        EnterCriticalSection(&dup->cs);
+    }
+
+    LeaveCriticalSection(&dup->cs);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_output_duplication_GetFrameDirtyRects(IDXGIOutputDuplication *iface,
+        UINT size, RECT *rects, UINT *required)
+{
+    struct dxgi_output_duplication *dup = impl_from_IDXGIOutputDuplication(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, size %u, rects %p, required %p.\n", iface, size, rects, required);
+
+    if (!required)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&dup->cs);
+    if (!dup->frame_held)
+        hr = DXGI_ERROR_INVALID_CALL;
+    else
+    {
+        /* Every new frame is reported as changed as a whole. */
+        *required = sizeof(RECT);
+        if (size < sizeof(RECT) || !rects)
+            hr = DXGI_ERROR_MORE_DATA;
+        else
+#ifdef SG_MUTANT_DUP_DIRTY_EMPTY
+            SetRect(rects, 0, 0, 0, 0);
+#else
+            SetRect(rects, 0, 0, dup->width, dup->height);
+#endif
+    }
+    LeaveCriticalSection(&dup->cs);
+
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_output_duplication_GetFrameMoveRects(IDXGIOutputDuplication *iface,
+        UINT size, DXGI_OUTDUPL_MOVE_RECT *rects, UINT *required)
+{
+    struct dxgi_output_duplication *dup = impl_from_IDXGIOutputDuplication(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, size %u, rects %p, required %p.\n", iface, size, rects, required);
+
+    if (!required)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&dup->cs);
+    if (!dup->frame_held)
+        hr = DXGI_ERROR_INVALID_CALL;
+    else
+        *required = 0;
+    LeaveCriticalSection(&dup->cs);
+
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_output_duplication_GetFramePointerShape(IDXGIOutputDuplication *iface,
+        UINT size, void *buffer, UINT *required, DXGI_OUTDUPL_POINTER_SHAPE_INFO *info)
+{
+    struct dxgi_output_duplication *dup = impl_from_IDXGIOutputDuplication(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, size %u, buffer %p, required %p, info %p.\n", iface, size, buffer, required, info);
+
+    if (!required || !info)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&dup->cs);
+    if (!dup->frame_held)
+        hr = DXGI_ERROR_INVALID_CALL;
+    else
+    {
+        *required = 0;
+        memset(info, 0, sizeof(*info));
+    }
+    LeaveCriticalSection(&dup->cs);
+
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_output_duplication_MapDesktopSurface(IDXGIOutputDuplication *iface,
+        DXGI_MAPPED_RECT *mapped_rect)
+{
+    TRACE("iface %p, mapped_rect %p.\n", iface, mapped_rect);
+
+    if (!mapped_rect)
+        return E_INVALIDARG;
+
+    return DXGI_ERROR_UNSUPPORTED;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_output_duplication_UnMapDesktopSurface(IDXGIOutputDuplication *iface)
+{
+    TRACE("iface %p.\n", iface);
+
+    return DXGI_ERROR_INVALID_CALL;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_output_duplication_ReleaseFrame(IDXGIOutputDuplication *iface)
+{
+    struct dxgi_output_duplication *dup = impl_from_IDXGIOutputDuplication(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&dup->cs);
+    if (!dup->frame_held)
+        hr = DXGI_ERROR_INVALID_CALL;
+    else
+        dup->frame_held = FALSE;
+    LeaveCriticalSection(&dup->cs);
+
+    return hr;
+}
+
+static const struct IDXGIOutputDuplicationVtbl dxgi_output_duplication_vtbl =
+{
+    dxgi_output_duplication_QueryInterface,
+    dxgi_output_duplication_AddRef,
+    dxgi_output_duplication_Release,
+    dxgi_output_duplication_SetPrivateData,
+    dxgi_output_duplication_SetPrivateDataInterface,
+    dxgi_output_duplication_GetPrivateData,
+    dxgi_output_duplication_GetParent,
+    dxgi_output_duplication_GetDesc,
+    dxgi_output_duplication_AcquireNextFrame,
+    dxgi_output_duplication_GetFrameDirtyRects,
+    dxgi_output_duplication_GetFrameMoveRects,
+    dxgi_output_duplication_GetFramePointerShape,
+    dxgi_output_duplication_MapDesktopSurface,
+    dxgi_output_duplication_UnMapDesktopSurface,
+    dxgi_output_duplication_ReleaseFrame,
+};
+
+/* formats, if given, are the formats the caller can use; the desktop is B8G8R8A8. */
+HRESULT dxgi_output_duplication_create(IDXGIOutput *output, IUnknown *device, UINT format_count,
+        const DXGI_FORMAT *formats, IDXGIOutputDuplication **duplication)
+{
+    struct dxgi_output_duplication *dup;
+    D3D11_TEXTURE2D_DESC desc = {0};
+    DXGI_OUTPUT_DESC output_desc;
+    IDXGIOutput *output_obj = output;
+    ID3D11Device *d3d11 = NULL;
+    HRESULT hr;
+    UINT i;
+
+    if (!device || !duplication)
+        return E_INVALIDARG;
+    *duplication = NULL;
+
+    if (format_count)
+    {
+        for (i = 0; i < format_count; ++i)
+            if (formats && formats[i] == DXGI_FORMAT_B8G8R8A8_UNORM)
+                break;
+#ifndef SG_MUTANT_DUP_FORMATS_IGNORED
+        if (!formats || i == format_count)
+            return DXGI_ERROR_UNSUPPORTED;
+#endif
+    }
+
+    if (FAILED(hr = IUnknown_QueryInterface(device, &IID_ID3D11Device, (void **)&d3d11)))
+    {
+        WARN("Not a Direct3D 11 device, hr %#lx.\n", hr);
+        return E_INVALIDARG;
+    }
+
+    if (FAILED(hr = IDXGIOutput_GetDesc(output_obj, &output_desc)))
+    {
+        ID3D11Device_Release(d3d11);
+        return hr;
+    }
+
+    if (!(dup = calloc(1, sizeof(*dup))))
+    {
+        ID3D11Device_Release(d3d11);
+        return E_OUTOFMEMORY;
+    }
+
+    dup->IDXGIOutputDuplication_iface.lpVtbl = &dxgi_output_duplication_vtbl;
+    dup->refcount = 1;
+    wined3d_private_store_init(&dup->private_store);
+    InitializeCriticalSectionEx(&dup->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    dup->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": dxgi_output_duplication.cs");
+
+    dup->device = d3d11;
+    ID3D11Device_GetImmediateContext(d3d11, &dup->context);
+    dup->output = output_obj;
+    IDXGIOutput_AddRef(output_obj);
+    wcscpy(dup->device_name, output_desc.DeviceName);
+    dup->width = output_desc.DesktopCoordinates.right - output_desc.DesktopCoordinates.left;
+    dup->height = output_desc.DesktopCoordinates.bottom - output_desc.DesktopCoordinates.top;
+    dup->rotation = output_desc.Rotation;
+    if (!dup->width || !dup->height || !(dup->pixels = malloc((SIZE_T)dup->width * dup->height * 4)))
+    {
+        IDXGIOutputDuplication_Release(&dup->IDXGIOutputDuplication_iface);
+        return dup->width && dup->height ? E_OUTOFMEMORY : E_INVALIDARG;
+    }
+
+    dup->mode.Width = dup->width;
+    dup->mode.Height = dup->height;
+    dup->mode.RefreshRate.Numerator = 60;
+    dup->mode.RefreshRate.Denominator = 1;
+    dup->mode.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    dup->mode.ScanlineOrdering = DXGI_MODE_SCANLINE_ORDER_PROGRESSIVE;
+    dup->mode.Scaling = DXGI_MODE_SCALING_UNSPECIFIED;
+
+    desc.Width = dup->width;
+    desc.Height = dup->height;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    if (FAILED(hr = ID3D11Device_CreateTexture2D(d3d11, &desc, NULL, &dup->texture)))
+    {
+        WARN("Failed to create the desktop texture, hr %#lx.\n", hr);
+        IDXGIOutputDuplication_Release(&dup->IDXGIOutputDuplication_iface);
+        return hr;
+    }
+
+    *duplication = &dup->IDXGIOutputDuplication_iface;
+    return S_OK;
+}
