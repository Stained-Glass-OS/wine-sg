+
+static HRESULT dxgi_output_get_display_surface_data(struct dxgi_output *output, IDXGISurface *surface)
+{
+    struct wined3d_output_desc wined3d_desc;
+    DXGI_MAPPED_RECT mapped;
+    DXGI_SURFACE_DESC desc;
+    BYTE *pixels;
+    UINT y, width, height;
+    HRESULT hr;
+
+    if (!surface)
+        return E_INVALIDARG;
+
+    wined3d_mutex_lock();
+    hr = wined3d_output_get_desc(output->wined3d_output, &wined3d_desc);
+    wined3d_mutex_unlock();
+    if (FAILED(hr))
+        return hr;
+
+    width = wined3d_desc.desktop_rect.right - wined3d_desc.desktop_rect.left;
+    height = wined3d_desc.desktop_rect.bottom - wined3d_desc.desktop_rect.top;
+
+    if (FAILED(hr = IDXGISurface_GetDesc(surface, &desc)))
+        return hr;
+#ifdef SG_MUTANT_DISPSURF_NO_SIZE_CHECK
+    if (desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM)
+#else
+    if (desc.Width != width || desc.Height != height || desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM)
+#endif
+    {
+        WARN("Surface %ux%u format %#x does not match the %ux%u display.\n",
+                desc.Width, desc.Height, desc.Format, width, height);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    if (!(pixels = malloc((SIZE_T)width * height * 4)))
+        return E_OUTOFMEMORY;
+    if (!dxgi_capture_display(wined3d_desc.device_name, width, height, pixels))
+    {
+        free(pixels);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    if (SUCCEEDED(hr = IDXGISurface_Map(surface, &mapped, DXGI_MAP_WRITE | DXGI_MAP_DISCARD)))
+    {
+        for (y = 0; y < height; ++y)
+            memcpy(mapped.pBits + (SIZE_T)y * mapped.Pitch, pixels + (SIZE_T)y * width * 4, (SIZE_T)width * 4);
+        IDXGISurface_Unmap(surface);
+    }
+    free(pixels);
+
+    return hr;
 }
 
