From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the Win+X menu has Power Options, Search and Shut down or sign out

Windows 10/11's Win+X menu (Start's right-click) has Power Options, Search and
"Shut down or sign out" (Sign out, Sleep, Shut down, Restart; only Sign out
under the NoClose policy). Ours had none of them.

Gate: make test-taskkeys (Search; the submenu opens, nothing in it is
chosen). Mutant: -DSG_MUTANT_WINX_NO_POWER.
---
--- a/programs/explorer/shellkeys.c
+++ b/programs/explorer/shellkeys.c
@@ -43,6 +43,7 @@
 #include "winuser.h"
 #include "winreg.h"
 #include "shellapi.h"
+#include "shlobj.h"
 #include "wine/debug.h"
 #include "explorer_private.h"
 
@@ -643,12 +644,15 @@
 static void quick_link(void)
 {
     enum { QL_APPS = 1, QL_SYSTEM, QL_NETWORK, QL_POWERSHELL, QL_TASKMGR, QL_SETTINGS, QL_EXPLORER,
-           QL_RUN, QL_DESKTOP, QL_CONTROL, QL_EVENTS, QL_DEVICES, QL_DISKS, QL_COMPMGMT, QL_TERMINAL_ADMIN };
-    HMENU menu = CreatePopupMenu();
+           QL_RUN, QL_DESKTOP, QL_CONTROL, QL_EVENTS, QL_DEVICES, QL_DISKS, QL_COMPMGMT, QL_TERMINAL_ADMIN,
+           QL_POWER, QL_SEARCH, QL_SIGNOUT, QL_SLEEP, QL_SHUTDOWN, QL_RESTART };
+    HMENU menu = CreatePopupMenu(), power = CreatePopupMenu();
+    BOOL noclose = SHRestricted( REST_NOCLOSE ) != 0;
     RECT work;
     int cmd;
 
     AppendMenuW( menu, MF_STRING, QL_APPS, L"Apps and &Features" );
+    AppendMenuW( menu, MF_STRING, QL_POWER, L"P&ower Options" );
     AppendMenuW( menu, MF_STRING, QL_EVENTS, L"Event &Viewer" );
     AppendMenuW( menu, MF_STRING, QL_SYSTEM, L"S&ystem" );
     AppendMenuW( menu, MF_STRING, QL_DEVICES, L"Device &Manager" );
@@ -662,13 +666,25 @@
     AppendMenuW( menu, MF_STRING, QL_SETTINGS, L"Setti&ngs" );
     AppendMenuW( menu, MF_STRING, QL_CONTROL, L"Control &Panel" );
     AppendMenuW( menu, MF_STRING, QL_EXPLORER, L"File &Explorer" );
+    /* Stained Glass OS (9070): Search, and Shut down or sign out, as Windows 10/11's menu has them */
+    AppendMenuW( menu, MF_STRING, QL_SEARCH, L"Searc&h" );
     AppendMenuW( menu, MF_STRING, QL_RUN, L"&Run" );
     AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( power, MF_STRING, QL_SIGNOUT, L"S&ign out" );
+    if (!noclose)
+    {
+        AppendMenuW( power, MF_STRING, QL_SLEEP, L"&Sleep" );
+        AppendMenuW( power, MF_STRING, QL_SHUTDOWN, L"Sh&ut down" );
+        AppendMenuW( power, MF_STRING, QL_RESTART, L"&Restart" );
+    }
+#ifndef SG_MUTANT_WINX_NO_POWER
+    AppendMenuW( menu, MF_POPUP, (UINT_PTR)power, L"Sh&ut down or sign out" );
+#endif
     AppendMenuW( menu, MF_STRING, QL_DESKTOP, L"&Desktop" );
     SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
     SetForegroundWindow( sk_tray );
     cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_LEFTALIGN | TPM_BOTTOMALIGN, work.left, work.bottom, 0, sk_tray, NULL );
-    DestroyMenu( menu );
+    DestroyMenu( menu );   /* and the power submenu with it */
     switch (cmd)
     {
     case QL_APPS: run_settings( L"ms-settings:appsfeatures", L"appwiz.cpl" ); break;
@@ -690,6 +706,20 @@
     case QL_EXPLORER: run( L"explorer.exe", NULL ); break;
     case QL_RUN: run_dialog(); break;
     case QL_DESKTOP: toggle_desktop(); break;
+    case QL_POWER: run_settings( L"ms-settings:powersleep", L"powercfg.cpl" ); break;
+    case QL_SEARCH: taskbar_search(); break;
+    case QL_SIGNOUT: ExitWindowsEx( EWX_LOGOFF, 0 ); break;
+    case QL_SHUTDOWN: ExitWindowsEx( EWX_SHUTDOWN | EWX_POWEROFF, SHTDN_REASON_FLAG_PLANNED ); break;
+    case QL_RESTART: ExitWindowsEx( EWX_REBOOT, SHTDN_REASON_FLAG_PLANNED ); break;
+    case QL_SLEEP:
+    {
+        /* as the Start menu's Sleep (powrprof, which the session's power service answers) */
+        BOOLEAN (WINAPI *suspend)( BOOLEAN, BOOLEAN, BOOLEAN );
+        HMODULE powrprof = LoadLibraryW( L"powrprof.dll" );
+        if (powrprof && (suspend = (void *)GetProcAddress( powrprof, "SetSuspendState" ))) suspend( FALSE, FALSE, FALSE );
+        if (powrprof) FreeLibrary( powrprof );
+        break;
+    }
     }
 }
 
