+DWORD WINAPI RasGetCredentialsA(const char *phonebook, const char *entry, RASCREDENTIALSA *credentials)
+{
+    WCHAR *pbk = dup_acp( phonebook ), *name = dup_acp( entry );
+    RASCREDENTIALSW w = { sizeof(w) };
+    DWORD ret;
+
+    if (!credentials) ret = ERROR_INVALID_PARAMETER;
+    else if (credentials->dwSize < sizeof(*credentials)) ret = ERROR_INVALID_SIZE;
+    else
+    {
+        w.dwMask = credentials->dwMask;
+        if (!(ret = ras_get_credentials( pbk, name, &w )))
+        {
+            credentials->dwMask = w.dwMask;
+            WideCharToMultiByte( CP_ACP, 0, w.szUserName, -1, credentials->szUserName, sizeof(credentials->szUserName), NULL, NULL );
+            WideCharToMultiByte( CP_ACP, 0, w.szPassword, -1, credentials->szPassword, sizeof(credentials->szPassword), NULL, NULL );
+            WideCharToMultiByte( CP_ACP, 0, w.szDomain, -1, credentials->szDomain, sizeof(credentials->szDomain), NULL, NULL );
+        }
+        SecureZeroMemory( w.szPassword, sizeof(w.szPassword) );
+    }
+    free( pbk ); free( name );
+    return ret;
 }
 
