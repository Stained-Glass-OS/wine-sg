+static HRASCONN *notify_known;        /* the connected handles at the last look */
+static unsigned int notify_known_count;
+static BOOL notify_thread_running;
+static CRITICAL_SECTION notify_cs;
+static CRITICAL_SECTION_DEBUG notify_cs_debug =
+{
+    0, 0, &notify_cs, { &notify_cs_debug.ProcessLocksList, &notify_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": notify_cs") }
+};
+static CRITICAL_SECTION notify_cs = { &notify_cs_debug, -1, 0, 0, 0, 0 };
+
+static BOOL handle_listed( const HRASCONN *list, unsigned int n, HRASCONN h )
+{
+    unsigned int i;
+    for (i = 0; i < n; i++) if (list[i] == h) return TRUE;
+    return FALSE;
+}
+
+/* the connected handles now (malloc'd); -1 when sg-netctl cannot be asked */
+static int connected_handles( HRASCONN **out )
+{
+    struct sg_vpn *v;
+    HRASCONN *list;
+    int i, n, k = 0;
+
+    *out = NULL;
+    if ((n = sg_vpn_list( &v )) < 0) return -1;
+    if (!(list = calloc( n + 1, sizeof(*list) ))) { free( v ); return -1; }
+    for (i = 0; i < n; i++) if (v[i].connected) list[k++] = v[i].handle;
+    free( v );
+    *out = list;
+    return k;
+}
+
+static DWORD WINAPI notify_thread( void *arg )
+{
+    for (;;)
+    {
+        HRASCONN *now;
+        int n;
+        unsigned int i, j;
+
+        Sleep( 1000 );
+        EnterCriticalSection( &notify_cs );
+        if (!notify_count) { notify_thread_running = FALSE; LeaveCriticalSection( &notify_cs ); return 0; }
+        LeaveCriticalSection( &notify_cs );
+        if ((n = connected_handles( &now )) < 0) continue;
+        EnterCriticalSection( &notify_cs );
+        for (i = 0; i < (unsigned)n; i++)
+            if (!handle_listed( notify_known, notify_known_count, now[i] ))
+                for (j = 0; j < notify_count; j++)
+#ifndef SG_MUTANT_RAS_NONOTIFY
+                    if ((notify_regs[j].flags & RASCN_Connection) && notify_regs[j].conn == INVALID_HANDLE_VALUE)
+                        SetEvent( notify_regs[j].event );
+#else
+                    (void)j;
+#endif
+        for (i = 0; i < notify_known_count; i++)
+            if (!handle_listed( now, n, notify_known[i] ))
+                for (j = 0; j < notify_count; j++)
+                    if ((notify_regs[j].flags & RASCN_Disconnection) &&
+                        (notify_regs[j].conn == INVALID_HANDLE_VALUE || notify_regs[j].conn == notify_known[i]))
+                        SetEvent( notify_regs[j].event );
+        free( notify_known );
+        notify_known = now;
+        notify_known_count = n;
+        LeaveCriticalSection( &notify_cs );
+    }
+}
+
+static DWORD sg_connection_notification( HRASCONN conn, HANDLE event, DWORD flags )
+{
+    unsigned int i;
+    DWORD ret = 0;
+
+    if (flags & ~(RASCN_Connection | RASCN_Disconnection | RASCN_BandwidthAdded | RASCN_BandwidthRemoved))
+        return ERROR_INVALID_PARAMETER;
+    if (!event || event == INVALID_HANDLE_VALUE) return ERROR_INVALID_PARAMETER;
+    EnterCriticalSection( &notify_cs );
+    for (i = 0; i < notify_count; i++) if (notify_regs[i].event == event && notify_regs[i].conn == conn) break;
+    if (!flags)
+    {
+        /* no flags: the registration is withdrawn */
+        if (i < notify_count) memmove( notify_regs + i, notify_regs + i + 1, (--notify_count - i) * sizeof(*notify_regs) );
+    }
+    else if (i < notify_count) notify_regs[i].flags = flags;
+    else
+    {
+        struct notify_reg *bigger = realloc( notify_regs, (notify_count + 1) * sizeof(*notify_regs) );
+        if (!bigger) ret = ERROR_NOT_ENOUGH_MEMORY;
+        else
+        {
+            notify_regs = bigger;
+            notify_regs[notify_count].conn = conn;
+            notify_regs[notify_count].event = event;
+            notify_regs[notify_count].flags = flags;
+            if (!notify_count && !notify_known) notify_known_count = max( 0, connected_handles( &notify_known ) );
+            notify_count++;
+            if (!notify_thread_running)
+            {
+                HANDLE t = CreateThread( NULL, 0, notify_thread, NULL, 0, NULL );
+                if (t) { CloseHandle( t ); notify_thread_running = TRUE; }
+                else ret = ERROR_NOT_ENOUGH_MEMORY;
+            }
+        }
+    }
+    LeaveCriticalSection( &notify_cs );
+    return ret;
+}
+
