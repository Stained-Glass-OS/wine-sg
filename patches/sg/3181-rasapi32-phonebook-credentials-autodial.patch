+/* is the name a VPN connection (an entry of the network settings, not of a phone book file)? */
+static BOOL sg_is_vpn_entry( const WCHAR *entry, WCHAR *kind, DWORD kindlen )
+{
+    struct sg_vpn *v;
+    int i, n = sg_vpn_list( &v );
+    BOOL found = FALSE;
+
+    for (i = 0; i < n && entry; i++)
+        if (!wcsicmp( v[i].name, entry ))
+        {
+            found = TRUE;
+            if (kind) lstrcpynW( kind, sg_vpn_device( &v[i] ), kindlen );
+        }
+    free( v );
+    return found;
+}
