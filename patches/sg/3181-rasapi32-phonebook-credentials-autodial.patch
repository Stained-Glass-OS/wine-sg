+/* Phone-book entries live where Windows keeps them: an INI file, one section
+ * per entry, in %APPDATA%\Microsoft\Network\Connections\Pbk\rasphone.pbk (the
+ * user's) and %ProgramData%\Microsoft\Network\Connections\Pbk\rasphone.pbk
+ * (all users', which only an administrator may change). A NULL phone book
+ * means the user's for changes and both for reading. Dialling is the VPN
+ * connections' (sg-netctl); an entry of any other kind cannot be dialled, as
+ * there is no modem or ISDN here (the entry is stored all the same, for
+ * programs that manage them).
+ *
+ * The user name, domain, callback number and (protected with CryptProtectData)
+ * password of an entry are kept in the entry's section as DialUser,
+ * DialDomain, DialCallback and DialPassword. Automatic-dialling addresses and
+ * parameters are in HKCU\Software\Microsoft\RAS AutoDial. */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+#include "winreg.h"
+#include "winerror.h"
+#include "wincrypt.h"
+#include "winuser.h"
+#include "rpc.h"
+#include "lmcons.h"
+#include "ras.h"
+#include "raserror.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ras);
+
+
+#ifndef RASET_Phone
+#define RASET_Phone 1
+#define RASET_Vpn 2
+#endif
+#ifndef RASFP_Ppp
+#define RASFP_Ppp 1
+#define RASNP_Ip 4
+#endif
+#ifndef RASCM_UserName
+#define RASCM_UserName 1
+#define RASCM_Password 2
+#define RASCM_Domain 4
+#endif
+
+#ifndef RASEO_AllUsers
+#define RASEO_AllUsers 0
+#endif
+
+static const GUID zero_guid;
+static const WCHAR pbk_tail[] = L"\\Microsoft\\Network\\Connections\\Pbk\\rasphone.pbk";
+
+/* ---- the files ------------------------------------------------------------------------------ */
+
+static void make_dirs( WCHAR *path )
+{
+    WCHAR *p;
+    for (p = path + 3; *p; p++)
+    {
+        if (*p != '\\') continue;
+        *p = 0;
+        CreateDirectoryW( path, NULL );
+        *p = '\\';
+    }
+}
+
+/* which: 0 the user's, 1 all users' */
+static BOOL default_pbk( int which, WCHAR *path, DWORD len )
+{
+    WCHAR base[MAX_PATH];
+
+    if (!GetEnvironmentVariableW( which ? L"ProgramData" : L"APPDATA", base, ARRAY_SIZE(base) ) || !base[0])
+    {
+        if (which || !GetEnvironmentVariableW( L"USERPROFILE", base, ARRAY_SIZE(base) )) return FALSE;
+        lstrcatW( base, L"\\AppData\\Roaming" );
+    }
+    if (wcslen( base ) + wcslen( pbk_tail ) >= len) return FALSE;
+    wcscpy( path, base );
+    wcscat( path, pbk_tail );
+    return TRUE;
+}
+
+static BOOL same_path( const WCHAR *a, const WCHAR *b )
+{
+    return !wcsicmp( a, b );
+}
+
+/* the file a change goes to; *all set when it is the all-users' */
+static DWORD change_path( const WCHAR *pbk, WCHAR *path, DWORD len, BOOL *all )
+{
+    WCHAR common[MAX_PATH];
+
+    *all = FALSE;
+    if (!pbk || !pbk[0])
+    {
+        if (!default_pbk( 0, path, len )) return ERROR_CANNOT_OPEN_PHONEBOOK;
+    }
+    else
+    {
+        if (wcslen( pbk ) >= len) return ERROR_CANNOT_OPEN_PHONEBOOK;
+        wcscpy( path, pbk );
+        if (default_pbk( 1, common, ARRAY_SIZE(common) ) && same_path( path, common )) *all = TRUE;
+    }
+    return 0;
+}
+
+static BOOL is_administrator(void)
+{
+    SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+    PSID admins;
+    BOOL member = FALSE;
+
+    if (!AllocateAndInitializeSid( &nt, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS, 0, 0, 0, 0, 0, 0, &admins ))
+        return FALSE;
+#ifdef SG_MUTANT_RAS_NOADMIN
+    member = TRUE;
+#else
+    if (!CheckTokenMembership( NULL, admins, &member )) member = FALSE;
+#endif
+    FreeSid( admins );
+    return member;
+}
+
+/* a file to write into: the path, ready for writing (directories made) */
+static DWORD writable_pbk( const WCHAR *pbk, WCHAR *path, DWORD len )
+{
+    BOOL all;
+    DWORD err = change_path( pbk, path, len, &all );
+
+    if (err) return err;
+    if (all && !is_administrator()) return ERROR_ACCESS_DENIED;
+    make_dirs( path );
+    return 0;
+}
+
+/* ---- sections ------------------------------------------------------------------------------- */
+
+/* the section names of the file (double-zero list, malloc'd) */
+static WCHAR *section_names( const WCHAR *path )
+{
+    DWORD size = 4096, got;
+    WCHAR *buf = NULL, *n;
+
+    for (;;)
+    {
+        if (!(n = realloc( buf, size * sizeof(WCHAR) ))) { free( buf ); return NULL; }
+        buf = n;
+        buf[0] = buf[1] = 0;
+        got = GetPrivateProfileSectionNamesW( buf, size, path );
+        if (!got) buf[0] = buf[1] = 0;
+        if (got < size - 2) break;
+        size *= 2;
+    }
+    return buf;
+}
+
+static BOOL entry_in_file( const WCHAR *path, const WCHAR *entry )
+{
+    WCHAR *names = section_names( path ), *p;
+    BOOL found = FALSE;
+
+    if (!names) return FALSE;
+    for (p = names; *p; p += wcslen( p ) + 1) if (!wcsicmp( p, entry )) { found = TRUE; break; }
+    free( names );
+    return found;
+}
+
+/* the file holding the entry, among those a phone book argument names (the user's first) */
+static BOOL find_entry( const WCHAR *pbk, const WCHAR *entry, WCHAR *path, DWORD len, BOOL *all )
+{
+    WCHAR files[2][MAX_PATH];
+    BOOL allf[2];
+    int i, n = 0;
+
+    *all = FALSE;
+    if (pbk && pbk[0])
+    {
+        WCHAR common[MAX_PATH];
+        if (wcslen( pbk ) >= len) return FALSE;
+        wcscpy( path, pbk );
+        if (default_pbk( 1, common, ARRAY_SIZE(common) ) && same_path( path, common )) *all = TRUE;
+        return entry_in_file( path, entry );
+    }
+    if (default_pbk( 0, files[n], MAX_PATH )) allf[n++] = FALSE;
+    if (default_pbk( 1, files[n], MAX_PATH )) allf[n++] = TRUE;
+    for (i = 0; i < n; i++)
+    {
+        if (!entry_in_file( files[i], entry )) continue;
+        lstrcpynW( path, files[i], len );
+        *all = allf[i];
+        return TRUE;
+    }
+    return FALSE;
+}
+
+DWORD ras_validate_name( const WCHAR *pbk, const WCHAR *entry )
+{
+    const WCHAR *p;
+    WCHAR path[MAX_PATH];
+    BOOL all;
+
+    TRACE( "(%s,%s)\n", debugstr_w( pbk ), debugstr_w( entry ));
+    if (!entry || !entry[0] || wcslen( entry ) > RAS_MaxEntryName) return ERROR_INVALID_NAME;
+    for (p = entry; *p; p++) if (*p < 32 || *p == '[' || *p == ']') return ERROR_INVALID_NAME;
+    if (find_entry( pbk, entry, path, ARRAY_SIZE(path), &all )) return ERROR_ALREADY_EXISTS;
+    return 0;
+}
+
+/* ---- the entry structure, field by field ---------------------------------------------------- */
+
+enum kind { K_DWORD, K_STR, K_IP, K_GUID };
+
+#define FIELDS(X, T) \
+    X(L"Options",              K_DWORD, dwfOptions) \
+    X(L"CountryID",            K_DWORD, dwCountryID) \
+    X(L"CountryCode",          K_DWORD, dwCountryCode) \
+    X(L"AreaCode",             K_STR,   szAreaCode) \
+    X(L"PhoneNumber",          K_STR,   szLocalPhoneNumber) \
+    X(L"AlternateOffset",      K_DWORD, dwAlternateOffset) \
+    X(L"IpAddress",            K_IP,    ipaddr) \
+    X(L"IpDnsAddress",         K_IP,    ipaddrDns) \
+    X(L"IpDns2Address",        K_IP,    ipaddrDnsAlt) \
+    X(L"IpWinsAddress",        K_IP,    ipaddrWins) \
+    X(L"IpWins2Address",       K_IP,    ipaddrWinsAlt) \
+    X(L"FrameSize",            K_DWORD, dwFrameSize) \
+    X(L"NetProtocols",         K_DWORD, dwfNetProtocols) \
+    X(L"BaseProtocol",         K_DWORD, dwFramingProtocol) \
+    X(L"Script",               K_STR,   szScript) \
+    X(L"AutodialDll",          K_STR,   szAutodialDll) \
+    X(L"AutodialFunc",         K_STR,   szAutodialFunc) \
+    X(L"DeviceType",           K_STR,   szDeviceType) \
+    X(L"DeviceName",           K_STR,   szDeviceName) \
+    X(L"X25PadType",           K_STR,   szX25PadType) \
+    X(L"X25Address",           K_STR,   szX25Address) \
+    X(L"X25Facilities",        K_STR,   szX25Facilities) \
+    X(L"X25UserData",          K_STR,   szX25UserData) \
+    X(L"Channels",             K_DWORD, dwChannels) \
+    X(L"DialMode",             K_DWORD, dwDialMode) \
+    X(L"DialPercent",          K_DWORD, dwDialExtraPercent) \
+    X(L"DialSeconds",          K_DWORD, dwDialExtraSampleSeconds) \
+    X(L"HangUpPercent",        K_DWORD, dwHangUpExtraPercent) \
+    X(L"HangUpSeconds",        K_DWORD, dwHangUpExtraSampleSeconds) \
+    X(L"IdleDisconnectSeconds",K_DWORD, dwIdleDisconnectSeconds) \
+    X(L"Type",                 K_DWORD, dwType) \
+    X(L"DataEncryption",       K_DWORD, dwEncryptionType) \
+    X(L"CustomAuthKey",        K_DWORD, dwCustomAuthKey) \
+    X(L"Guid",                 K_GUID,  guidId) \
+    X(L"CustomDialDll",        K_STR,   szCustomDialDll) \
+    X(L"VpnStrategy",          K_DWORD, dwVpnStrategy) \
+    X(L"Options2",             K_DWORD, dwfOptions2) \
+    X(L"Options3",             K_DWORD, dwfOptions3) \
+    X(L"IpDnsSuffix",          K_STR,   szDnsSuffix) \
+    X(L"TcpWindowSize",        K_DWORD, dwTcpWindowSize) \
+    X(L"PrerequisitePbk",      K_STR,   szPrerequisitePbk) \
+    X(L"PrerequisiteEntry",    K_STR,   szPrerequisiteEntry) \
+    X(L"RedialAttempts",       K_DWORD, dwRedialCount) \
+    X(L"RedialSeconds",        K_DWORD, dwRedialPause)
+
+struct field
+{
+    const WCHAR *key;
+    enum kind    kind;
+    DWORD        off;      /* offset in the structure */
+    DWORD        chars;    /* string length in characters, with the terminator */
+};
+
+#define FW(k, kind, f) { k, kind, FIELD_OFFSET(RASENTRYW, f), sizeof(((RASENTRYW *)0)->f) / sizeof(WCHAR) },
+#define FA(k, kind, f) { k, kind, FIELD_OFFSET(RASENTRYA, f), sizeof(((RASENTRYA *)0)->f) },
+static const struct field fields_w[] = { FIELDS(FW, W) };
+static const struct field fields_a[] = { FIELDS(FA, A) };
+
+static DWORD field_size( const struct field *f, BOOL unicode )
+{
+    switch (f->kind)
+    {
+    case K_DWORD: return sizeof(DWORD);
+    case K_IP:    return sizeof(RASIPADDR);
+    case K_GUID:  return sizeof(GUID);
+    default:      return f->chars * (unicode ? sizeof(WCHAR) : 1);
+    }
+}
+
+static void get_text( const WCHAR *path, const WCHAR *entry, const WCHAR *key, WCHAR *out, DWORD len )
+{
+    GetPrivateProfileStringW( entry, key, L"", out, len, path );
+}
+
+static BOOL has_key( const WCHAR *path, const WCHAR *entry, const WCHAR *key )
+{
+    WCHAR buf[4];
+    GetPrivateProfileStringW( entry, key, L"\x01", buf, ARRAY_SIZE(buf), path );
+    return buf[0] != 1;
+}
+
+static DWORD get_dword( const WCHAR *path, const WCHAR *entry, const WCHAR *key )
+{
+    return GetPrivateProfileIntW( entry, key, 0, path );
+}
+
+static void put_text( const WCHAR *path, const WCHAR *entry, const WCHAR *key, const WCHAR *value )
+{
+    WritePrivateProfileStringW( entry, key, value, path );
+}
+
+static void put_dword( const WCHAR *path, const WCHAR *entry, const WCHAR *key, DWORD value )
+{
+    WCHAR text[16];
+    swprintf( text, ARRAY_SIZE(text), L"%lu", value );
+    put_text( path, entry, key, text );
+}
+
+static void guid_text( const GUID *g, WCHAR *out )
+{
+    swprintf( out, 40, L"{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}", g->Data1, g->Data2, g->Data3,
+              g->Data4[0], g->Data4[1], g->Data4[2], g->Data4[3], g->Data4[4], g->Data4[5], g->Data4[6], g->Data4[7] );
+}
+
+static BOOL text_guid( const WCHAR *s, GUID *g )
+{
+    unsigned int d[11];
+    int i;
+
+    if (swscanf( s, L"{%8x-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x}", &d[0], &d[1], &d[2], &d[3], &d[4], &d[5], &d[6],
+                 &d[7], &d[8], &d[9], &d[10] ) != 11) return FALSE;
+    g->Data1 = d[0]; g->Data2 = d[1]; g->Data3 = d[2];
+    for (i = 0; i < 8; i++) g->Data4[i] = d[3 + i];
+    return TRUE;
+}
+
+static DWORD link_count( const WCHAR *path, const WCHAR *entry )
+{
+    return get_dword( path, entry, L"LinkCount" );
+}
+
+/* the entry's values into the caller's structure (only the part its size covers) */
+static void read_entry( const WCHAR *path, const WCHAR *entry, BYTE *buf, DWORD size, BOOL unicode )
+{
+    const struct field *f = unicode ? fields_w : fields_a;
+    unsigned int i, n = unicode ? ARRAY_SIZE(fields_w) : ARRAY_SIZE(fields_a);
+    WCHAR text[600];
+
+    for (i = 0; i < n; i++, f++)
+    {
+        BYTE *p = buf + f->off;
+        if (f->off + field_size( f, unicode ) > size) continue;
+        get_text( path, entry, f->key, text, ARRAY_SIZE(text) );
+        switch (f->kind)
+        {
+        case K_DWORD: *(DWORD *)p = text[0] ? wcstoul( text, NULL, 10 ) : 0; break;
+        case K_IP:
+        {
+            unsigned int a[4] = {0};
+            RASIPADDR *ip = (RASIPADDR *)p;
+            if (swscanf( text, L"%u.%u.%u.%u", &a[0], &a[1], &a[2], &a[3] ) == 4)
+            {
+                ip->classA = a[0]; ip->classB = a[1]; ip->classC = a[2]; ip->classD = a[3];
+            }
+            break;
+        }
+        case K_GUID: if (!text_guid( text, (GUID *)p )) memset( p, 0, sizeof(GUID) ); break;
+        default:
+            if (unicode) lstrcpynW( (WCHAR *)p, text, f->chars );
+            else if (!WideCharToMultiByte( CP_ACP, 0, text, -1, (char *)p, f->chars, NULL, NULL )) ((char *)p)[f->chars - 1] = 0;
+        }
+    }
+    {
+        /* dwSubEntries: the links, at least the entry itself */
+        DWORD links = link_count( path, entry );
+        if (unicode) { if (FIELD_OFFSET(RASENTRYW, dwSubEntries) + 4 <= size) ((RASENTRYW *)buf)->dwSubEntries = links ? links : 1; }
+        else if (FIELD_OFFSET(RASENTRYA, dwSubEntries) + 4 <= size) ((RASENTRYA *)buf)->dwSubEntries = links ? links : 1;
+    }
+}
+
+static void write_entry( const WCHAR *path, const WCHAR *entry, const BYTE *buf, DWORD size, BOOL unicode )
+{
+    const struct field *f = unicode ? fields_w : fields_a;
+    unsigned int i, n = unicode ? ARRAY_SIZE(fields_w) : ARRAY_SIZE(fields_a);
+    WCHAR text[600];
+
+    for (i = 0; i < n; i++, f++)
+    {
+        const BYTE *p = buf + f->off;
+        if (f->off + field_size( f, unicode ) > size) continue;
+        switch (f->kind)
+        {
+        case K_DWORD: put_dword( path, entry, f->key, *(const DWORD *)p ); break;
+        case K_IP:
+        {
+            const RASIPADDR *ip = (const RASIPADDR *)p;
+            swprintf( text, ARRAY_SIZE(text), L"%u.%u.%u.%u", ip->classA, ip->classB, ip->classC, ip->classD );
+            put_text( path, entry, f->key, text );
+            break;
+        }
+        case K_GUID:
+            if (!memcmp( p, &zero_guid, sizeof(GUID) ))
+            {
+                if (has_key( path, entry, f->key )) break;
+                {
+                    GUID g;
+                    UuidCreate( &g );
+                    guid_text( &g, text );
+                }
+            }
+            else guid_text( (const GUID *)p, text );
+            put_text( path, entry, f->key, text );
+            break;
+        default:
+            if (unicode) lstrcpynW( text, (const WCHAR *)p, f->chars );
+            else MultiByteToWideChar( CP_ACP, 0, (const char *)p, -1, text, ARRAY_SIZE(text) );
+            put_text( path, entry, f->key, text );
+        }
+    }
+}
+
+/* ---- the calls ------------------------------------------------------------------------------ */
+
+static BOOL entry_size_ok( DWORD size, BOOL unicode )
+{
+    /* the structure grew over time: Windows 95's, NT4's, 2000's, XP's, Vista's */
+    return size >= (unicode ? FIELD_OFFSET(RASENTRYW, dwSubEntries) : FIELD_OFFSET(RASENTRYA, dwSubEntries)) &&
+           size <= (unicode ? sizeof(RASENTRYW) : sizeof(RASENTRYA));
+}
+
+DWORD ras_set_entry( const WCHAR *pbk, const WCHAR *entry, const BYTE *info, DWORD size, BOOL unicode )
+{
+    WCHAR path[MAX_PATH], found[MAX_PATH];
+    BOOL all, exists;
+    DWORD err;
+    DWORD declared;
+
+    if (!entry || !entry[0] || !info) return ERROR_INVALID_PARAMETER;
+    declared = *(const DWORD *)info;
+    if (!entry_size_ok( declared, unicode ) || size < declared) return ERROR_INVALID_SIZE;
+    exists = find_entry( pbk, entry, found, ARRAY_SIZE(found), &all );
+    if (exists) { wcscpy( path, found ); if (all && !is_administrator()) return ERROR_ACCESS_DENIED; }
+    else
+    {
+        const WCHAR *p;
+        if (wcslen( entry ) > RAS_MaxEntryName) return ERROR_INVALID_NAME;
+        for (p = entry; *p; p++) if (*p < 32 || *p == '[' || *p == ']') return ERROR_INVALID_NAME;
+        if ((err = writable_pbk( pbk, path, ARRAY_SIZE(path) ))) return err;
+        put_text( path, entry, L"Encoding", L"1" );
+        put_text( path, entry, L"PBVersion", L"4" );
+    }
+    write_entry( path, entry, info, declared, unicode );
+    if (!has_key( path, entry, L"Type" )) put_dword( path, entry, L"Type", RASET_Phone );
+    return 0;
+}
+
+DWORD ras_get_entry( const WCHAR *pbk, const WCHAR *entry, BYTE *info, DWORD *size, DWORD *devsize, BOOL unicode )
+{
+    WCHAR path[MAX_PATH];
+    BOOL all;
+    DWORD total = unicode ? sizeof(RASENTRYW) : sizeof(RASENTRYA), declared;
+
+    if (!size) return ERROR_INVALID_PARAMETER;
+    if (devsize) *devsize = 0;
+    if (!entry) return ERROR_INVALID_PARAMETER;
+    if (entry[0] && !find_entry( pbk, entry, path, ARRAY_SIZE(path), &all )) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    if (!info || *size < total)
+    {
+        *size = total;
+        return ERROR_BUFFER_TOO_SMALL;
+    }
+    declared = *(const DWORD *)info;
+    if (!entry_size_ok( declared, unicode ) || declared > *size) return ERROR_INVALID_SIZE;
+    memset( info + 4, 0, declared - 4 );
+    if (!entry[0])
+    {
+        /* the defaults of a new entry */
+        if (unicode) { RASENTRYW *e = (RASENTRYW *)info; e->dwfOptions = RASEO_UseCountryAndAreaCodes | RASEO_IpHeaderCompression |
+                       RASEO_RemoteDefaultGateway | RASEO_SwCompression | RASEO_ModemLights; e->dwType = RASET_Phone;
+                       e->dwFramingProtocol = RASFP_Ppp; e->dwfNetProtocols = RASNP_Ip; }
+        else { RASENTRYA *e = (RASENTRYA *)info; e->dwfOptions = RASEO_UseCountryAndAreaCodes | RASEO_IpHeaderCompression |
+                       RASEO_RemoteDefaultGateway | RASEO_SwCompression | RASEO_ModemLights; e->dwType = RASET_Phone;
+                       e->dwFramingProtocol = RASFP_Ppp; e->dwfNetProtocols = RASNP_Ip; }
+        return 0;
+    }
+    read_entry( path, entry, info, declared, unicode );
+    return 0;
+}
+
+DWORD ras_delete_entry( const WCHAR *pbk, const WCHAR *entry )
+{
+    WCHAR path[MAX_PATH];
+    BOOL all;
+
+    if (!entry || !entry[0]) return ERROR_INVALID_PARAMETER;
+    if (!find_entry( pbk, entry, path, ARRAY_SIZE(path), &all )) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    if (all && !is_administrator()) return ERROR_ACCESS_DENIED;
+    WritePrivateProfileStringW( entry, NULL, NULL, path );
+    return 0;
+}
+
+DWORD ras_rename_entry( const WCHAR *pbk, const WCHAR *old, const WCHAR *new )
+{
+    WCHAR path[MAX_PATH], *data = NULL, other[MAX_PATH];
+    DWORD size = 4096, got;
+    BOOL all;
+    const WCHAR *p;
+
+    if (!old || !old[0]) return ERROR_INVALID_PARAMETER;
+    if (!find_entry( pbk, old, path, ARRAY_SIZE(path), &all )) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    if (!new || !new[0] || wcslen( new ) > RAS_MaxEntryName) return ERROR_INVALID_NAME;
+    for (p = new; *p; p++) if (*p < 32 || *p == '[' || *p == ']') return ERROR_INVALID_NAME;
+    if (wcsicmp( old, new ) && find_entry( pbk, new, other, ARRAY_SIZE(other), &all ))
+        return ERROR_ALREADY_EXISTS;
+    if (all && !is_administrator()) return ERROR_ACCESS_DENIED;
+    for (;;)
+    {
+        WCHAR *n = realloc( data, size * sizeof(WCHAR) );
+        if (!n) { free( data ); return ERROR_NOT_ENOUGH_MEMORY; }
+        data = n;
+        got = GetPrivateProfileSectionW( old, data, size, path );
+        if (got < size - 2) break;
+        size *= 2;
+    }
+    if (wcscmp( old, new ))
+    {
+        WritePrivateProfileStringW( old, NULL, NULL, path );
+        WritePrivateProfileSectionW( new, data, path );
+    }
+    free( data );
+    return 0;
+}
+
+/* ---- credentials and dial parameters -------------------------------------------------------- */
+
+static void hex_text( const BYTE *in, DWORD n, WCHAR *out )
+{
+    DWORD i;
+    for (i = 0; i < n; i++) swprintf( out + i * 2, 3, L"%02x", in[i] );
+}
+
+static DWORD hex_bytes( const WCHAR *s, BYTE *out, DWORD max )
+{
+    DWORD n = 0;
+    while (s[0] && s[1] && n < max)
+    {
+        unsigned int v;
+        if (swscanf( s, L"%2x", &v ) != 1) break;
+        out[n++] = v;
+        s += 2;
+    }
+    return n;
+}
+
+static void store_password( const WCHAR *path, const WCHAR *entry, const WCHAR *password )
+{
+    DATA_BLOB in, out;
+    WCHAR *hex;
+
+    if (!password || !password[0]) { put_text( path, entry, L"DialPassword", NULL ); return; }
+    in.pbData = (BYTE *)password;
+    in.cbData = (wcslen( password ) + 1) * sizeof(WCHAR);
+    if (!CryptProtectData( &in, L"RAS", NULL, NULL, NULL, 0, &out ))
+    {
+        /* a password that cannot be protected is not stored */
+        put_text( path, entry, L"DialPassword", NULL );
+        return;
+    }
+    if ((hex = malloc( (out.cbData * 2 + 1) * sizeof(WCHAR) )))
+    {
+        hex_text( out.pbData, out.cbData, hex );
+        put_text( path, entry, L"DialPassword", hex );
+        free( hex );
+    }
+    LocalFree( out.pbData );
+}
+
+/* TRUE with the password when one is stored */
+static BOOL load_password( const WCHAR *path, const WCHAR *entry, WCHAR *out, DWORD chars )
+{
+    WCHAR hex[4096];
+    BYTE *raw;
+    DATA_BLOB in, plain;
+    BOOL ok = FALSE;
+
+    out[0] = 0;
+    get_text( path, entry, L"DialPassword", hex, ARRAY_SIZE(hex) );
+    if (!hex[0] || !(raw = malloc( ARRAY_SIZE(hex) / 2 ))) return FALSE;
+    in.cbData = hex_bytes( hex, raw, ARRAY_SIZE(hex) / 2 );
+    in.pbData = raw;
+    if (CryptUnprotectData( &in, NULL, NULL, NULL, NULL, 0, &plain ))
+    {
+        if (plain.cbData >= sizeof(WCHAR) && plain.cbData / sizeof(WCHAR) <= chars)
+        {
+            memcpy( out, plain.pbData, plain.cbData );
+            out[chars - 1] = 0;
+            ok = TRUE;
+        }
+        LocalFree( plain.pbData );
+    }
+    free( raw );
+    return ok;
+}
+
+DWORD ras_set_dial_params( const WCHAR *pbk, const RASDIALPARAMSW *p, BOOL remove_password )
+{
+    WCHAR path[MAX_PATH];
+    BOOL all;
+
+    if (!p) return ERROR_INVALID_PARAMETER;
+    if (p->dwSize < FIELD_OFFSET(RASDIALPARAMSW, szDomain)) return ERROR_INVALID_SIZE;
+    if (!p->szEntryName[0]) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    if (!find_entry( pbk, p->szEntryName, path, ARRAY_SIZE(path), &all )) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    if (all && !is_administrator()) return ERROR_ACCESS_DENIED;
+    if (p->szPhoneNumber[0]) put_text( path, p->szEntryName, L"PhoneNumber", p->szPhoneNumber );
+    put_text( path, p->szEntryName, L"DialCallback", p->szCallbackNumber[0] ? p->szCallbackNumber : NULL );
+    put_text( path, p->szEntryName, L"DialUser", p->szUserName[0] ? p->szUserName : NULL );
+    if (p->dwSize >= FIELD_OFFSET(RASDIALPARAMSW, szDomain[1]))
+        put_text( path, p->szEntryName, L"DialDomain", p->szDomain[0] ? p->szDomain : NULL );
+    if (remove_password) store_password( path, p->szEntryName, NULL );
+    else store_password( path, p->szEntryName, p->szPassword );
+    return 0;
+}
+
+/* the stored values into p (szEntryName names the entry); FALSE if the entry is not in a phone book file */
+BOOL ras_get_dial_params( const WCHAR *pbk, RASDIALPARAMSW *p, BOOL *has_password )
+{
+    WCHAR path[MAX_PATH];
+    BOOL all;
+
+    if (!find_entry( pbk, p->szEntryName, path, ARRAY_SIZE(path), &all )) return FALSE;
+    get_text( path, p->szEntryName, L"PhoneNumber", p->szPhoneNumber, ARRAY_SIZE(p->szPhoneNumber) );
+    get_text( path, p->szEntryName, L"DialCallback", p->szCallbackNumber, ARRAY_SIZE(p->szCallbackNumber) );
+    get_text( path, p->szEntryName, L"DialUser", p->szUserName, ARRAY_SIZE(p->szUserName) );
+    if (p->dwSize >= FIELD_OFFSET(RASDIALPARAMSW, szDomain[1]))
+        get_text( path, p->szEntryName, L"DialDomain", p->szDomain, ARRAY_SIZE(p->szDomain) );
+    *has_password = load_password( path, p->szEntryName, p->szPassword, ARRAY_SIZE(p->szPassword) );
+    return TRUE;
+}
+
+DWORD ras_set_credentials( const WCHAR *pbk, const WCHAR *entry, const RASCREDENTIALSW *c, BOOL clear )
+{
+    WCHAR path[MAX_PATH];
+    BOOL all;
+
+    if (!c || !entry || !entry[0]) return ERROR_INVALID_PARAMETER;
+    if (c->dwSize < sizeof(*c)) return ERROR_INVALID_SIZE;
+    if (!find_entry( pbk, entry, path, ARRAY_SIZE(path), &all )) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    if (all && !is_administrator()) return ERROR_ACCESS_DENIED;
+    if (c->dwMask & RASCM_UserName) put_text( path, entry, L"DialUser", clear ? NULL : c->szUserName );
+    if (c->dwMask & RASCM_Domain) put_text( path, entry, L"DialDomain", clear ? NULL : c->szDomain );
+    if (c->dwMask & RASCM_Password) store_password( path, entry, clear ? NULL : c->szPassword );
+    return 0;
+}
+
+DWORD ras_get_credentials( const WCHAR *pbk, const WCHAR *entry, RASCREDENTIALSW *c )
+{
+    WCHAR path[MAX_PATH];
+    BOOL all;
+
+    if (!c || !entry || !entry[0]) return ERROR_INVALID_PARAMETER;
+    if (c->dwSize < sizeof(*c)) return ERROR_INVALID_SIZE;
+    if (!find_entry( pbk, entry, path, ARRAY_SIZE(path), &all )) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    {
+        DWORD want = c->dwMask, got = 0;
+        WCHAR pw[PWLEN + 1];
+        c->szUserName[0] = c->szPassword[0] = c->szDomain[0] = 0;
+        if (want & RASCM_UserName)
+        {
+            get_text( path, entry, L"DialUser", c->szUserName, ARRAY_SIZE(c->szUserName) );
+            if (c->szUserName[0]) got |= RASCM_UserName;
+        }
+        if (want & RASCM_Domain)
+        {
+            get_text( path, entry, L"DialDomain", c->szDomain, ARRAY_SIZE(c->szDomain) );
+            if (c->szDomain[0]) got |= RASCM_Domain;
+        }
+        if ((want & RASCM_Password) && load_password( path, entry, pw, ARRAY_SIZE(pw) ))
+        {
+            lstrcpynW( c->szPassword, pw, ARRAY_SIZE(c->szPassword) );
+            got |= RASCM_Password;
+        }
+        c->dwMask = got;
+    }
+    return 0;
+}
+
+DWORD ras_set_custom_auth( const WCHAR *pbk, const WCHAR *entry, const BYTE *data, DWORD size )
+{
+    WCHAR path[MAX_PATH], *hex;
+    BOOL all;
+
+    if (!entry || !entry[0]) return ERROR_INVALID_PARAMETER;
+    if (!find_entry( pbk, entry, path, ARRAY_SIZE(path), &all )) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    if (all && !is_administrator()) return ERROR_ACCESS_DENIED;
+    if (!data || !size) { put_text( path, entry, L"CustomAuthData", NULL ); return 0; }
+    if (size > 65536) return ERROR_INVALID_SIZE;
+    if (!(hex = malloc( (size * 2 + 1) * sizeof(WCHAR) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    hex_text( data, size, hex );
+    put_text( path, entry, L"CustomAuthData", hex );
+    free( hex );
+    return 0;
+}
+
+/* ---- links (sub-entries) -------------------------------------------------------------------- */
+
+#define LINK_KEY(buf, n, name) swprintf( buf, ARRAY_SIZE(buf), L"Link%lu%s", (DWORD)(n), name )
+
+DWORD ras_set_subentry( const WCHAR *pbk, const WCHAR *entry, DWORD id, const BYTE *sub, DWORD size, BOOL unicode )
+{
+    WCHAR path[MAX_PATH], key[40], text[300];
+    BOOL all;
+    DWORD links;
+
+    if (!entry || !entry[0] || !sub) return ERROR_INVALID_PARAMETER;
+    if (!id) return ERROR_INVALID_PARAMETER;
+    if (size < FIELD_OFFSET(RASSUBENTRYW, dwAlternateOffset) || size < *(const DWORD *)sub) return ERROR_INVALID_SIZE;
+    if (!find_entry( pbk, entry, path, ARRAY_SIZE(path), &all )) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    if (all && !is_administrator()) return ERROR_ACCESS_DENIED;
+    links = link_count( path, entry );
+    if (!links) links = 1;
+    if (id > links + 1) return ERROR_INVALID_PARAMETER;      /* sub-entries are added one after the other */
+    if (id == links + 1) links++;
+    LINK_KEY( key, id, L"Flags" );
+    if (unicode)
+    {
+        const RASSUBENTRYW *s = (const RASSUBENTRYW *)sub;
+        put_dword( path, entry, key, s->dwfFlags );
+        LINK_KEY( key, id, L"DeviceType" ); put_text( path, entry, key, s->szDeviceType );
+        LINK_KEY( key, id, L"DeviceName" ); put_text( path, entry, key, s->szDeviceName );
+        LINK_KEY( key, id, L"PhoneNumber" ); put_text( path, entry, key, s->szLocalPhoneNumber );
+        LINK_KEY( key, id, L"AlternateOffset" ); put_dword( path, entry, key, s->dwAlternateOffset );
+    }
+    else
+    {
+        const RASSUBENTRYA *s = (const RASSUBENTRYA *)sub;
+        put_dword( path, entry, key, s->dwfFlags );
+        LINK_KEY( key, id, L"DeviceType" ); MultiByteToWideChar( CP_ACP, 0, s->szDeviceType, -1, text, ARRAY_SIZE(text) ); put_text( path, entry, key, text );
+        LINK_KEY( key, id, L"DeviceName" ); MultiByteToWideChar( CP_ACP, 0, s->szDeviceName, -1, text, ARRAY_SIZE(text) ); put_text( path, entry, key, text );
+        LINK_KEY( key, id, L"PhoneNumber" ); MultiByteToWideChar( CP_ACP, 0, s->szLocalPhoneNumber, -1, text, ARRAY_SIZE(text) ); put_text( path, entry, key, text );
+        LINK_KEY( key, id, L"AlternateOffset" ); put_dword( path, entry, key, s->dwAlternateOffset );
+    }
+    put_dword( path, entry, L"LinkCount", links );
+    return 0;
+}
+
+DWORD ras_get_subentry( const WCHAR *pbk, const WCHAR *entry, DWORD id, BYTE *sub, DWORD *size, BOOL unicode )
+{
+    WCHAR path[MAX_PATH], key[40], text[300];
+    BOOL all;
+    DWORD links, need = unicode ? sizeof(RASSUBENTRYW) : sizeof(RASSUBENTRYA);
+
+    if (!entry || !entry[0] || !size) return ERROR_INVALID_PARAMETER;
+    if (!find_entry( pbk, entry, path, ARRAY_SIZE(path), &all )) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    links = link_count( path, entry );
+    if (!links) links = 1;
+    if (!id || id > links) return ERROR_INVALID_PARAMETER;
+    if (!sub || *size < need) { *size = need; return ERROR_BUFFER_TOO_SMALL; }
+    memset( sub, 0, need );
+    *(DWORD *)sub = need;
+    LINK_KEY( key, id, L"Flags" );
+    if (unicode)
+    {
+        RASSUBENTRYW *s = (RASSUBENTRYW *)sub;
+        s->dwfFlags = get_dword( path, entry, key );
+        LINK_KEY( key, id, L"DeviceType" ); get_text( path, entry, key, s->szDeviceType, ARRAY_SIZE(s->szDeviceType) );
+        LINK_KEY( key, id, L"DeviceName" ); get_text( path, entry, key, s->szDeviceName, ARRAY_SIZE(s->szDeviceName) );
+        LINK_KEY( key, id, L"PhoneNumber" ); get_text( path, entry, key, s->szLocalPhoneNumber, ARRAY_SIZE(s->szLocalPhoneNumber) );
+        LINK_KEY( key, id, L"AlternateOffset" ); s->dwAlternateOffset = get_dword( path, entry, key );
+        if (id == 1 && !s->szLocalPhoneNumber[0]) get_text( path, entry, L"PhoneNumber", s->szLocalPhoneNumber, ARRAY_SIZE(s->szLocalPhoneNumber) );
+        if (id == 1 && !s->szDeviceName[0]) get_text( path, entry, L"DeviceName", s->szDeviceName, ARRAY_SIZE(s->szDeviceName) );
+        if (id == 1 && !s->szDeviceType[0]) get_text( path, entry, L"DeviceType", s->szDeviceType, ARRAY_SIZE(s->szDeviceType) );
+    }
+    else
+    {
+        RASSUBENTRYA *s = (RASSUBENTRYA *)sub;
+        s->dwfFlags = get_dword( path, entry, key );
+        LINK_KEY( key, id, L"DeviceType" ); get_text( path, entry, key, text, ARRAY_SIZE(text) );
+        WideCharToMultiByte( CP_ACP, 0, text, -1, s->szDeviceType, sizeof(s->szDeviceType), NULL, NULL );
+        LINK_KEY( key, id, L"DeviceName" ); get_text( path, entry, key, text, ARRAY_SIZE(text) );
+        WideCharToMultiByte( CP_ACP, 0, text, -1, s->szDeviceName, sizeof(s->szDeviceName), NULL, NULL );
+        LINK_KEY( key, id, L"PhoneNumber" ); get_text( path, entry, key, text, ARRAY_SIZE(text) );
+        WideCharToMultiByte( CP_ACP, 0, text, -1, s->szLocalPhoneNumber, sizeof(s->szLocalPhoneNumber), NULL, NULL );
+        LINK_KEY( key, id, L"AlternateOffset" ); s->dwAlternateOffset = get_dword( path, entry, key );
+    }
+    *size = need;
+    return 0;
+}
+
+DWORD ras_delete_subentry( const WCHAR *pbk, const WCHAR *entry, DWORD id )
+{
+    static const WCHAR *const names[] = { L"Flags", L"DeviceType", L"DeviceName", L"PhoneNumber", L"AlternateOffset" };
+    WCHAR path[MAX_PATH], from[40], to[40], value[300];
+    BOOL all;
+    DWORD links, i, k;
+
+    if (!entry || !entry[0]) return ERROR_INVALID_PARAMETER;
+    if (!find_entry( pbk, entry, path, ARRAY_SIZE(path), &all )) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    if (all && !is_administrator()) return ERROR_ACCESS_DENIED;
+    links = link_count( path, entry );
+    if (!links) links = 1;
+    if (!id || id > links) return ERROR_INVALID_PARAMETER;
+    if (links == 1) return ERROR_INVALID_PARAMETER;          /* an entry keeps at least one link */
+    for (i = id; i < links; i++)
+        for (k = 0; k < ARRAY_SIZE(names); k++)
+        {
+            LINK_KEY( from, i + 1, names[k] ); LINK_KEY( to, i, names[k] );
+            get_text( path, entry, from, value, ARRAY_SIZE(value) );
+            put_text( path, entry, to, value[0] ? value : NULL );
+        }
+    for (k = 0; k < ARRAY_SIZE(names); k++) { LINK_KEY( from, links, names[k] ); put_text( path, entry, from, NULL ); }
+    put_dword( path, entry, L"LinkCount", links - 1 );
+    return 0;
+}
+
+/* ---- listing -------------------------------------------------------------------------------- */
+
+/* every entry of the phone book(s): a malloc'd array, one record each */
+struct pbk_entry { WCHAR name[RAS_MaxEntryName + 1]; WCHAR path[MAX_PATH]; BOOL all; };
+
+int ras_list_entries( const WCHAR *pbk, struct pbk_entry **out )
+{
+    WCHAR files[2][MAX_PATH];
+    BOOL allflag[2];
+    int nfiles = 0, i, n = 0, cap = 0;
+    struct pbk_entry *list = NULL;
+
+    *out = NULL;
+    if (pbk && pbk[0])
+    {
+        WCHAR common[MAX_PATH];
+        lstrcpynW( files[0], pbk, MAX_PATH );
+        allflag[0] = default_pbk( 1, common, ARRAY_SIZE(common) ) && same_path( files[0], common );
+        nfiles = 1;
+    }
+    else
+    {
+        if (default_pbk( 1, files[nfiles], MAX_PATH )) allflag[nfiles++] = TRUE;
+        if (default_pbk( 0, files[nfiles], MAX_PATH )) allflag[nfiles++] = FALSE;
+    }
+    for (i = 0; i < nfiles; i++)
+    {
+        WCHAR *names = section_names( files[i] ), *p;
+        if (!names) continue;
+        for (p = names; *p; p += wcslen( p ) + 1)
+        {
+            struct pbk_entry *e;
+            if (wcslen( p ) > RAS_MaxEntryName) continue;
+            if (n == cap)
+            {
+                struct pbk_entry *bigger = realloc( list, (cap = cap ? cap * 2 : 8) * sizeof(*list) );
+                if (!bigger) break;
+                list = bigger;
+            }
+            e = &list[n++];
+            wcscpy( e->name, p );
+            wcscpy( e->path, files[i] );
+            e->all = allflag[i];
+        }
+        free( names );
+    }
+    *out = list;
+    return n;
+}
+
+/* ---- automatic dialling --------------------------------------------------------------------- */
+
+static const WCHAR autodial_key[] = L"Software\\Microsoft\\RAS AutoDial";
+static const WCHAR *const param_names[] = { L"DisableConnectionQuery", L"LoginSessionDisable", L"SavedAddressesLimit",
+                                            L"FailedConnectionTimeout", L"ConnectionQueryTimeout" };
+static const DWORD param_defaults[] = { 0, 0, 100, 5, 15 };
+
+DWORD ras_get_autodial_param( DWORD key, void *value, DWORD *size )
+{
+    HKEY hkey;
+    DWORD v = param_defaults[key < ARRAY_SIZE(param_names) ? key : 0], len = sizeof(v), type;
+    WCHAR path[128];
+
+    if (key >= ARRAY_SIZE(param_names) || !size) return ERROR_INVALID_PARAMETER;
+    if (!value || *size < sizeof(DWORD)) { *size = sizeof(DWORD); return ERROR_BUFFER_TOO_SMALL; }
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Control Params", autodial_key );
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &hkey ))
+    {
+        DWORD stored;
+        len = sizeof(stored);
+        if (!RegQueryValueExW( hkey, param_names[key], NULL, &type, (BYTE *)&stored, &len ) && type == REG_DWORD) v = stored;
+        RegCloseKey( hkey );
+    }
+    *(DWORD *)value = v;
+    *size = sizeof(DWORD);
+    return 0;
+}
+
+DWORD ras_set_autodial_param( DWORD key, const void *value, DWORD size )
+{
+    HKEY hkey;
+    WCHAR path[128];
+
+    if (key >= ARRAY_SIZE(param_names) || !value) return ERROR_INVALID_PARAMETER;
+    if (size != sizeof(DWORD)) return ERROR_INVALID_SIZE;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Control Params", autodial_key );
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, path, 0, NULL, 0, KEY_WRITE, NULL, &hkey, NULL )) return ERROR_ACCESS_DENIED;
+    RegSetValueExW( hkey, param_names[key], 0, REG_DWORD, value, sizeof(DWORD) );
+    RegCloseKey( hkey );
+    return 0;
+}
+
+DWORD ras_get_autodial_enable( DWORD location, BOOL *enabled )
+{
+    HKEY hkey;
+    WCHAR path[128];
+    DWORD v = 0, len = sizeof(v), type;
+
+    if (!enabled) return ERROR_INVALID_PARAMETER;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Default", autodial_key );
+    *enabled = FALSE;
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &hkey ))
+    {
+        WCHAR name[24];
+        swprintf( name, ARRAY_SIZE(name), L"Enable%lu", location );
+        if (!RegQueryValueExW( hkey, name, NULL, &type, (BYTE *)&v, &len ) && type == REG_DWORD) *enabled = v != 0;
+        RegCloseKey( hkey );
+    }
+    return 0;
+}
+
+DWORD ras_set_autodial_enable( DWORD location, BOOL enabled )
+{
+    HKEY hkey;
+    WCHAR path[128], name[24];
+    DWORD v = enabled != 0;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Default", autodial_key );
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, path, 0, NULL, 0, KEY_WRITE, NULL, &hkey, NULL )) return ERROR_ACCESS_DENIED;
+    swprintf( name, ARRAY_SIZE(name), L"Enable%lu", location );
+    RegSetValueExW( hkey, name, 0, REG_DWORD, (BYTE *)&v, sizeof(v) );
+    RegCloseKey( hkey );
+    return 0;
+}
+
+/* The addresses with entries: Addresses\<address> holds the RASAUTODIALENTRY array (value "Entries"). */
+DWORD ras_set_autodial_address( const WCHAR *address, const BYTE *entries, DWORD cb, DWORD count )
+{
+    HKEY hkey;
+    WCHAR path[600];
+
+    if (!address || !address[0] || wcslen( address ) > 255 || wcschr( address, '\\' )) return ERROR_INVALID_PARAMETER;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Addresses", autodial_key );
+    if (!entries || !count)
+    {
+        if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_ALL_ACCESS, &hkey )) return 0;
+        RegDeleteTreeW( hkey, address );
+        RegCloseKey( hkey );
+        return 0;
+    }
+    if (cb < count * sizeof(RASAUTODIALENTRYW) || count > 64) return ERROR_INVALID_SIZE;
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &hkey, NULL )) return ERROR_ACCESS_DENIED;
+    {
+        HKEY sub;
+        if (!RegCreateKeyExW( hkey, address, 0, NULL, 0, KEY_WRITE, NULL, &sub, NULL ))
+        {
+            RegSetValueExW( sub, L"Entries", 0, REG_BINARY, entries, count * sizeof(RASAUTODIALENTRYW) );
+            RegCloseKey( sub );
+        }
+    }
+    RegCloseKey( hkey );
+    return 0;
+}
+
+DWORD ras_get_autodial_address( const WCHAR *address, BYTE *entries, DWORD *cb, DWORD *count )
+{
+    HKEY hkey;
+    WCHAR path[600];
+    DWORD size = 0, type;
+
+    if (!cb || !count) return ERROR_INVALID_PARAMETER;
+    *count = 0;
+    if (!address) return ERROR_INVALID_PARAMETER;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Addresses\\%s", autodial_key, address );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &hkey )) { *cb = 0; return 0; }
+    if (RegQueryValueExW( hkey, L"Entries", NULL, &type, NULL, &size ) || type != REG_BINARY) { RegCloseKey( hkey ); *cb = 0; return 0; }
+    *count = size / sizeof(RASAUTODIALENTRYW);
+    if (!entries || *cb < size)
+    {
+        *cb = size;
+        RegCloseKey( hkey );
+        return ERROR_BUFFER_TOO_SMALL;
+    }
+    RegQueryValueExW( hkey, L"Entries", NULL, &type, entries, &size );
+    *cb = size;
+    RegCloseKey( hkey );
+    return 0;
+}
+
+/* the addresses as an array of pointers into the same buffer */
+DWORD ras_enum_autodial_addresses( BYTE *buffer, DWORD *cb, DWORD *count, BOOL unicode )
+{
+    HKEY hkey;
+    WCHAR path[128], name[300];
+    WCHAR **names = NULL;
+    DWORD i, n = 0, subkeys = 0, need, len;
+
+    if (!cb || !count) return ERROR_INVALID_PARAMETER;
+    *count = 0;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Addresses", autodial_key );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &hkey )) { *cb = 0; return 0; }
+    RegQueryInfoKeyW( hkey, NULL, NULL, NULL, &subkeys, NULL, NULL, NULL, NULL, NULL, NULL, NULL );
+    if (subkeys && (names = calloc( subkeys, sizeof(*names) )))
+        for (i = 0; i < subkeys; i++)
+        {
+            len = ARRAY_SIZE(name);
+            if (RegEnumKeyExW( hkey, i, name, &len, NULL, NULL, NULL, NULL )) break;
+            if ((names[n] = malloc( (len + 1) * sizeof(WCHAR) ))) { wcscpy( names[n], name ); n++; }
+        }
+    RegCloseKey( hkey );
+    need = n * (unicode ? sizeof(WCHAR *) : sizeof(char *));
+    for (i = 0; i < n; i++) need += (wcslen( names[i] ) + 1) * (unicode ? sizeof(WCHAR) : 3);
+    *count = n;
+    if (!buffer || *cb < need)
+    {
+        *cb = need;
+        for (i = 0; i < n; i++) free( names[i] );
+        free( names );
+        return n ? ERROR_BUFFER_TOO_SMALL : 0;
+    }
+    {
+        BYTE *str = buffer + n * (unicode ? sizeof(WCHAR *) : sizeof(char *));
+        for (i = 0; i < n; i++)
+        {
+            if (unicode)
+            {
+                ((WCHAR **)buffer)[i] = (WCHAR *)str;
+                wcscpy( (WCHAR *)str, names[i] );
+                str += (wcslen( names[i] ) + 1) * sizeof(WCHAR);
+            }
+            else
+            {
+                int l = WideCharToMultiByte( CP_ACP, 0, names[i], -1, (char *)str, (wcslen( names[i] ) + 1) * 3, NULL, NULL );
+                ((char **)buffer)[i] = (char *)str;
+                str += l;
+            }
+            free( names[i] );
+        }
+    }
+    free( names );
+    *cb = need;
+    return 0;
+}
+
+/* ---- the phone book entry dialog (RasCreatePhonebookEntry, RasEditPhonebookEntry) ------------ */
+
+#define ID_NAME   101
+#define ID_PHONE  102
+#define ID_DEVICE 103
+
+struct entry_dlg { const WCHAR *pbk; WCHAR name[RAS_MaxEntryName + 1]; BOOL edit; };
+
+static BYTE *dlg_align( BYTE *p ) { return (BYTE *)(((ULONG_PTR)p + 3) & ~3); }
+
+static BYTE *dlg_item( BYTE *p, DWORD style, short x, short y, short cx, short cy, WORD id, WORD cls, const WCHAR *text )
+{
+    DLGITEMTEMPLATE *it;
+    p = dlg_align( p );
+    it = (DLGITEMTEMPLATE *)p;
+    it->style = style | WS_CHILD | WS_VISIBLE;
+    it->dwExtendedStyle = 0;
+    it->x = x; it->y = y; it->cx = cx; it->cy = cy; it->id = id;
+    p += sizeof(*it);
+    *(WORD *)p = 0xffff; p += 2;
+    *(WORD *)p = cls; p += 2;
+    wcscpy( (WCHAR *)p, text ); p += (wcslen( text ) + 1) * sizeof(WCHAR);
+    *(WORD *)p = 0; p += 2;                       /* no creation data */
+    return p;
+}
+
+static INT_PTR CALLBACK entry_dlg_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    struct entry_dlg *d;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        d = (struct entry_dlg *)lp;
+        SetWindowLongPtrW( hwnd, DWLP_USER, lp );
+        if (d->edit)
+        {
+            WCHAR path[MAX_PATH], text[300];
+            BOOL all;
+            SetDlgItemTextW( hwnd, ID_NAME, d->name );
+            EnableWindow( GetDlgItem( hwnd, ID_NAME ), FALSE );
+            if (find_entry( d->pbk, d->name, path, ARRAY_SIZE(path), &all ))
+            {
+                get_text( path, d->name, L"PhoneNumber", text, ARRAY_SIZE(text) );
+                SetDlgItemTextW( hwnd, ID_PHONE, text );
+                get_text( path, d->name, L"DeviceName", text, ARRAY_SIZE(text) );
+                SetDlgItemTextW( hwnd, ID_DEVICE, text );
+            }
+        }
+        return TRUE;
+    case WM_COMMAND:
+        d = (struct entry_dlg *)GetWindowLongPtrW( hwnd, DWLP_USER );
+        if (LOWORD(wp) == IDOK)
+        {
+            RASENTRYW e = { sizeof(e) };
+            WCHAR name[RAS_MaxEntryName + 1];
+            DWORD err;
+
+            GetDlgItemTextW( hwnd, ID_NAME, name, ARRAY_SIZE(name) );
+            if (!d->edit)
+            {
+                if ((err = ras_validate_name( d->pbk, name )))
+                {
+                    MessageBoxW( hwnd, err == ERROR_ALREADY_EXISTS ? L"An entry with that name already exists." :
+                                 L"The entry name is not valid.", L"Phone Book Entry", MB_OK | MB_ICONWARNING );
+                    return TRUE;
+                }
+                e.dwType = RASET_Phone; e.dwFramingProtocol = RASFP_Ppp; e.dwfNetProtocols = RASNP_Ip;
+                e.dwfOptions = RASEO_IpHeaderCompression | RASEO_RemoteDefaultGateway | RASEO_SwCompression | RASEO_ModemLights;
+            }
+            else
+            {
+                DWORD size = sizeof(e), dev = 0;
+                e.dwSize = sizeof(e);
+                ras_get_entry( d->pbk, name, (BYTE *)&e, &size, &dev, TRUE );
+            }
+            GetDlgItemTextW( hwnd, ID_PHONE, e.szLocalPhoneNumber, ARRAY_SIZE(e.szLocalPhoneNumber) );
+            GetDlgItemTextW( hwnd, ID_DEVICE, e.szDeviceName, ARRAY_SIZE(e.szDeviceName) );
+            if (e.szDeviceName[0] && !e.szDeviceType[0]) wcscpy( e.szDeviceType, L"modem" );
+            e.dwSize = sizeof(e);
+            if ((err = ras_set_entry( d->pbk, name, (const BYTE *)&e, sizeof(e), TRUE )))
+            {
+                EndDialog( hwnd, err );
+                return TRUE;
+            }
+            EndDialog( hwnd, 0 );
+            return TRUE;
+        }
+        if (LOWORD(wp) == IDCANCEL) { EndDialog( hwnd, 0 ); return TRUE; }
+        break;
+    }
+    return FALSE;
+}
+
+/* edit: the entry named; otherwise a new one. Returns a RAS error (0 also when the person cancels). */
+DWORD ras_entry_dialog( HWND parent, const WCHAR *pbk, const WCHAR *entry, BOOL edit )
+{
+    struct entry_dlg d = { pbk, {0}, edit };
+    BYTE *buf, *p;
+    DLGTEMPLATE *t;
+    INT_PTR ret;
+    WCHAR path[MAX_PATH];
+    BOOL all;
+
+    if (edit)
+    {
+        if (!entry || !entry[0]) return ERROR_INVALID_PARAMETER;
+        if (!find_entry( pbk, entry, path, ARRAY_SIZE(path), &all )) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+        lstrcpynW( d.name, entry, ARRAY_SIZE(d.name) );
+    }
+    if (!(buf = calloc( 1, 2048 ))) return ERROR_NOT_ENOUGH_MEMORY;
+    t = (DLGTEMPLATE *)buf;
+    t->style = DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU;
+    t->cdit = 8;
+    t->cx = 190; t->cy = 90;
+    p = buf + sizeof(*t);
+    *(WORD *)p = 0; p += 2;                       /* no menu */
+    *(WORD *)p = 0; p += 2;                       /* default class */
+    {
+        const WCHAR *title = edit ? L"Phone Book Entry Properties" : L"New Phone Book Entry";
+        wcscpy( (WCHAR *)p, title ); p += (wcslen( title ) + 1) * sizeof(WCHAR);
+    }
+    *(WORD *)p = 8; p += 2;                       /* font size */
+    wcscpy( (WCHAR *)p, L"MS Shell Dlg" ); p += 13 * sizeof(WCHAR);
+    p = dlg_item( p, SS_LEFT, 8, 10, 60, 10, -1, 0x0082, L"Entry name:" );
+    p = dlg_item( p, WS_BORDER | WS_TABSTOP | ES_AUTOHSCROLL, 72, 8, 110, 12, ID_NAME, 0x0081, L"" );
+    p = dlg_item( p, SS_LEFT, 8, 28, 60, 10, -1, 0x0082, L"Phone number:" );
+    p = dlg_item( p, WS_BORDER | WS_TABSTOP | ES_AUTOHSCROLL, 72, 26, 110, 12, ID_PHONE, 0x0081, L"" );
+    p = dlg_item( p, SS_LEFT, 8, 46, 60, 10, -1, 0x0082, L"Device:" );
+    p = dlg_item( p, WS_BORDER | WS_TABSTOP | ES_AUTOHSCROLL, 72, 44, 110, 12, ID_DEVICE, 0x0081, L"" );
+    p = dlg_item( p, WS_TABSTOP | BS_DEFPUSHBUTTON, 40, 68, 50, 14, IDOK, 0x0080, L"OK" );
+    p = dlg_item( p, WS_TABSTOP | BS_PUSHBUTTON, 100, 68, 50, 14, IDCANCEL, 0x0080, L"Cancel" );
+    ret = DialogBoxIndirectParamW( GetModuleHandleW( NULL ), t, parent, entry_dlg_proc, (LPARAM)&d );
+    free( buf );
+    return ret == -1 ? ERROR_NOT_ENOUGH_MEMORY : (DWORD)ret;
+}
