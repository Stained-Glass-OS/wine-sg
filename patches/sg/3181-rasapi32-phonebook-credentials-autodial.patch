+static DWORD sg_get_entry( const WCHAR *pbk, const WCHAR *entry, BYTE *info, DWORD *size, DWORD *devsize, BOOL unicode )
+{
+    WCHAR device[32];
+    DWORD ret = ras_get_entry( pbk, entry, info, size, devsize, unicode );
+
+    if (ret != ERROR_CANNOT_FIND_PHONEBOOK_ENTRY || (pbk && pbk[0]) || !sg_is_vpn_entry( entry, device, ARRAY_SIZE(device) ))
+        return ret;
+    /* a VPN connection: described from what is known of it */
+    {
+        DWORD total = unicode ? sizeof(RASENTRYW) : sizeof(RASENTRYA), declared;
+        if (!info || *size < total) { *size = total; return ERROR_BUFFER_TOO_SMALL; }
+        declared = *(DWORD *)info;
+        memset( info + 4, 0, min( declared, total ) - 4 );
+        if (unicode)
+        {
+            RASENTRYW *e = (RASENTRYW *)info;
+            e->dwType = RASET_Vpn; e->dwFramingProtocol = RASFP_Ppp; e->dwfNetProtocols = RASNP_Ip;
+            e->dwSubEntries = 1;
+            wcscpy( e->szDeviceType, L"vpn" );
+            lstrcpynW( e->szDeviceName, device, ARRAY_SIZE(e->szDeviceName) );
+        }
+        else
+        {
+            RASENTRYA *e = (RASENTRYA *)info;
+            e->dwType = RASET_Vpn; e->dwFramingProtocol = RASFP_Ppp; e->dwfNetProtocols = RASNP_Ip;
+            e->dwSubEntries = 1;
+            strcpy( e->szDeviceType, "vpn" );
+            WideCharToMultiByte( CP_ACP, 0, device, -1, e->szDeviceName, sizeof(e->szDeviceName), NULL, NULL );
+        }
+        return 0;
+    }
