+
+struct format_enum
+{
+    IEnumFORMATETC IEnumFORMATETC_iface;
+    LONG ref;
+    FORMATETC *formats;
+    UINT count, pos;
+};
+
+static inline struct format_enum *impl_from_IEnumFORMATETC(IEnumFORMATETC *iface)
+{
+    return CONTAINING_RECORD(iface, struct format_enum, IEnumFORMATETC_iface);
+}
+
+static HRESULT WINAPI format_enum_QueryInterface(IEnumFORMATETC *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumFORMATETC))
+    {
+        *out = iface;
+        IEnumFORMATETC_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI format_enum_AddRef(IEnumFORMATETC *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumFORMATETC(iface)->ref);
+}
+
+static ULONG WINAPI format_enum_Release(IEnumFORMATETC *iface)
+{
+    struct format_enum *This = impl_from_IEnumFORMATETC(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    if (!ref)
+    {
+        free(This->formats);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI format_enum_Next(IEnumFORMATETC *iface, ULONG count, FORMATETC *formats, ULONG *fetched)
+{
+    struct format_enum *This = impl_from_IEnumFORMATETC(iface);
+    ULONG n = 0;
+
+    if (!formats || (count > 1 && !fetched)) return E_INVALIDARG;
+    while (n < count && This->pos < This->count) formats[n++] = This->formats[This->pos++];
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI format_enum_Skip(IEnumFORMATETC *iface, ULONG count)
+{
+    struct format_enum *This = impl_from_IEnumFORMATETC(iface);
+    UINT left = This->count - This->pos;
+
+    This->pos += min(left, count);
+    return count <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI format_enum_Reset(IEnumFORMATETC *iface)
+{
+    impl_from_IEnumFORMATETC(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_format_enum(const FORMATETC *formats, UINT count, UINT pos, IEnumFORMATETC **out);
+
+static HRESULT WINAPI format_enum_Clone(IEnumFORMATETC *iface, IEnumFORMATETC **out)
+{
+    struct format_enum *This = impl_from_IEnumFORMATETC(iface);
+    if (!out) return E_POINTER;
+    return create_format_enum(This->formats, This->count, This->pos, out);
+}
+
+static const IEnumFORMATETCVtbl format_enum_vtbl =
+{
+    format_enum_QueryInterface,
+    format_enum_AddRef,
+    format_enum_Release,
+    format_enum_Next,
+    format_enum_Skip,
+    format_enum_Reset,
+    format_enum_Clone,
+};
+
+static HRESULT create_format_enum(const FORMATETC *formats, UINT count, UINT pos, IEnumFORMATETC **out)
+{
+    struct format_enum *This;
+
+    *out = NULL;
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    if (count && !(This->formats = malloc(count * sizeof(*formats))))
+    {
+        free(This);
+        return E_OUTOFMEMORY;
+    }
+    if (count) memcpy(This->formats, formats, count * sizeof(*formats));
+    This->IEnumFORMATETC_iface.lpVtbl = &format_enum_vtbl;
+    This->ref = 1;
+    This->count = count;
+    This->pos = pos;
+    *out = &This->IEnumFORMATETC_iface;
+    return S_OK;
 }
 
 /***********************************************************************
  *           OleRegEnumFormatEtc    [OLE32.@]
+ *
+ * The formats a class registers under CLSID\{clsid}\DataFormats\GetSet:
+ * values "format,aspect,medium,direction" (the format a clipboard format
+ * name or number; the direction DATADIR_GET 1, DATADIR_SET 2, or both)
  */
 HRESULT WINAPI DECLSPEC_HOTPATCH OleRegEnumFormatEtc (
   REFCLSID clsid,
   DWORD    dwDirection,
   LPENUMFORMATETC* ppenumFormatetc)
 {
-    FIXME("%p, %ld, %p stub!\n", clsid, dwDirection, ppenumFormatetc);
+    WCHAR path[96], name[64], value[256], *fields[4], *p;
+    FORMATETC *formats = NULL;
+    UINT count = 0, i, f;
+    DWORD name_len, value_len, type;
+    HRESULT hr;
+    HKEY key;
 
-    return E_NOTIMPL;
+    TRACE("%s, %ld, %p\n", debugstr_guid(clsid), dwDirection, ppenumFormatetc);
+
+    if (!ppenumFormatetc) return E_INVALIDARG;
+    *ppenumFormatetc = NULL;
+    if (dwDirection != DATADIR_GET && dwDirection != DATADIR_SET) return E_INVALIDARG;
+    lstrcpyW(path, L"CLSID\\");
+    StringFromGUID2(clsid, path + 6, ARRAY_SIZE(path) - 6);
+    lstrcatW(path, L"\\DataFormats\\GetSet");
+    if (RegOpenKeyExW(HKEY_CLASSES_ROOT, path, 0, KEY_READ, &key)) return REGDB_E_KEYMISSING;
+    for (i = 0;; i++)
+    {
+        FORMATETC fmt = { 0, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+        FORMATETC *more;
+        DWORD dir;
+
+        name_len = ARRAY_SIZE(name);
+        value_len = sizeof(value) - sizeof(WCHAR);
+        if (RegEnumValueW(key, i, name, &name_len, NULL, &type, (BYTE *)value, &value_len)) break;
+        if (type != REG_SZ) continue;
+        value[value_len / sizeof(WCHAR)] = 0;
+        for (f = 0, p = value; f < 4 && p; f++)
+        {
+            fields[f] = p;
+            if ((p = wcschr(p, ','))) *p++ = 0;
+        }
+        if (f < 4) continue;
+        for (f = 0; f < 4; f++) while (*fields[f] == ' ') fields[f]++;
+        fmt.cfFormat = iswdigit(fields[0][0]) ? (CLIPFORMAT)wcstoul(fields[0], NULL, 10)
+                                              : RegisterClipboardFormatW(fields[0]);
+        fmt.dwAspect = wcstoul(fields[1], NULL, 10);
+        fmt.tymed = wcstoul(fields[2], NULL, 10);
+        dir = wcstoul(fields[3], NULL, 10);
+        if (!fmt.cfFormat || !(dir & dwDirection)) continue;
+#ifdef SG_MUTANT_NO_REG_FORMATS
+        continue;
+#endif
+        if (!(more = realloc(formats, (count + 1) * sizeof(*formats)))) break;
+        formats = more;
+        formats[count++] = fmt;
+    }
+    RegCloseKey(key);
+    hr = create_format_enum(formats, count, 0, ppenumFormatetc);
+    free(formats);
+    return hr;
 }
