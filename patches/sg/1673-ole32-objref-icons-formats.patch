+    static DWORD_PTR (WINAPI *get_file_info)(LPCWSTR, DWORD, SHFILEINFOW *, UINT, UINT);
+    WCHAR icon_path[MAX_PATH], *type = NULL;
+    const WCHAR *label = NULL;
+    SHFILEINFOW info;
+    HGLOBAL ret;
