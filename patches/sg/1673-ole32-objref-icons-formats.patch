+/* Stained Glass OS 1673: a class's icon (its DefaultIcon, else the
+ * application icon), from the file and index it names */
+static HICON class_icon(REFCLSID clsid, WCHAR *path, DWORD size, int *index)
+{
+    WCHAR key[64], value[MAX_PATH + 16], *comma;
+    DWORD len = sizeof(value);
+    HICON icon = NULL;
+
+    path[0] = 0;
+    *index = 0;
+    lstrcpyW(key, L"CLSID\\");
+    StringFromGUID2(clsid, key + 6, ARRAY_SIZE(key) - 6);
+    lstrcatW(key, L"\\DefaultIcon");
+    if (!RegGetValueW(HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ, NULL, value, &len))
+    {
+        if ((comma = wcsrchr(value, ',')))
+        {
+            *comma = 0;
+            *index = wcstol(comma + 1, NULL, 10);
+        }
+        ExpandEnvironmentStringsW(value, path, size);
+        if (PrivateExtractIconsW(path, *index, GetSystemMetrics(SM_CXICON), GetSystemMetrics(SM_CYICON), &icon,
+                                 NULL, 1, 0) != 1)
+            icon = NULL;
+    }
+    if (!icon)
+    {
+        path[0] = 0;
+        icon = CopyIcon(LoadIconW(NULL, (LPCWSTR)IDI_APPLICATION));
+    }
+    return icon;
+}
