+static const char base64_chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+/* "objref:" + the OBJREF in base64 + ":" */
 static HRESULT WINAPI ObjrefMonikerImpl_GetDisplayName(IMoniker *iface, IBindCtx *pbc,
                                IMoniker *left, LPOLESTR *name)
 {
-    FIXME("(%p,%p,%p,%p): stub\n", iface, pbc, left, name);
-    return E_NOTIMPL;
+    ObjrefMonikerImpl *moniker = objref_impl_from_IMoniker(iface);
+    IStream *stream;
+    HGLOBAL hglobal;
+    STATSTG stat;
+    const BYTE *data;
+    WCHAR *out;
+    DWORD i, n, len;
+    HRESULT hr;
+
+    TRACE("(%p,%p,%p,%p)\n", iface, pbc, left, name);
+
+    if (!name || !pbc)
+    {
+        if (name) *name = NULL;
+        return E_INVALIDARG;
+    }
+    *name = NULL;
+    if (!moniker->pObject) return E_UNEXPECTED;
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &stream))) return hr;
+    if (FAILED(hr = CoMarshalInterface(stream, &IID_IUnknown, moniker->pObject, MSHCTX_DIFFERENTMACHINE, NULL,
+                                       MSHLFLAGS_NORMAL)) ||
+        FAILED(hr = IStream_Stat(stream, &stat, STATFLAG_NONAME)) ||
+        FAILED(hr = GetHGlobalFromStream(stream, &hglobal)))
+    {
+        IStream_Release(stream);
+        return hr;
+    }
+    n = stat.cbSize.u.LowPart;
+    len = 7 + (n + 2) / 3 * 4 + 2;
+    if (!(out = CoTaskMemAlloc(len * sizeof(WCHAR))))
+    {
+        IStream_Release(stream);
+        return E_OUTOFMEMORY;
+    }
+    data = GlobalLock(hglobal);
+    lstrcpyW(out, L"objref:");
+    len = 7;
+    for (i = 0; i < n; i += 3)
+    {
+        DWORD v = data[i] << 16 | (i + 1 < n ? data[i + 1] << 8 : 0) | (i + 2 < n ? data[i + 2] : 0);
+        out[len++] = base64_chars[(v >> 18) & 63];
+        out[len++] = base64_chars[(v >> 12) & 63];
+        out[len++] = i + 1 < n ? base64_chars[(v >> 6) & 63] : '=';
+        out[len++] = i + 2 < n ? base64_chars[v & 63] : '=';
+    }
+    out[len++] = ':';
+    out[len] = 0;
+    GlobalUnlock(hglobal);
+    IStream_Release(stream);
+    *name = out;
+    return S_OK;
+}
+
+static int base64_value(WCHAR c)
+{
+    const char *p = c < 128 ? strchr(base64_chars, (char)c) : NULL;
+    return p && c ? p - base64_chars : -1;
+}
+
+/* the moniker for "objref:<OBJREF in base64>:" */
+HRESULT objref_moniker_from_display_name(LPCOLESTR name, ULONG *eaten, IMoniker **out)
+{
+    const WCHAR *start, *end;
+    BYTE *data;
+    DWORD n = 0, bits = 0, acc = 0;
+    IStream *stream;
+    IUnknown *object;
+    HRESULT hr;
+
+    *out = NULL;
+    if (wcsnicmp(name, L"objref:", 7)) return MK_E_SYNTAX;
+    start = name + 7;
+    if (!(end = wcschr(start, ':'))) return MK_E_SYNTAX;
+    if (!(data = malloc((end - start) * 3 / 4 + 3))) return E_OUTOFMEMORY;
+    for (; start < end; start++)
+    {
+        int v;
+        if (*start == '=') break;
+        if ((v = base64_value(*start)) < 0)
+        {
+            free(data);
+            return MK_E_SYNTAX;
+        }
+        acc = (acc << 6) | v;
+        bits += 6;
+        if (bits >= 8)
+        {
+            bits -= 8;
+            data[n++] = (acc >> bits) & 0xff;
+        }
+    }
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &stream)))
+    {
+        free(data);
+        return hr;
+    }
+    IStream_Write(stream, data, n, NULL);
+    free(data);
+    IStream_Seek(stream, (LARGE_INTEGER){{0}}, STREAM_SEEK_SET, NULL);
+    hr = CoUnmarshalInterface(stream, &IID_IUnknown, (void **)&object);
+    IStream_Release(stream);
+    if (FAILED(hr)) return hr;
+    hr = CreateObjrefMoniker(object, out);
+    IUnknown_Release(object);
+    if (SUCCEEDED(hr)) *eaten = wcschr(name + 7, ':') - name + 1;
+    return hr;
 }
 
