+    HGLOBAL ret;
+    HICON icon;
+    int index;
+
+    TRACE("(%s,%s,%x)\n", debugstr_guid(rclsid), debugstr_w(lpszLabel), fUseTypeAsLabel);
+
+    /* the label given, else the class's short name, else "Document" */
+    if (!label && fUseTypeAsLabel && SUCCEEDED(OleRegGetUserType(rclsid, USERCLASSTYPE_SHORT, &type)))
+        label = type;
+    if (!label) label = L"Document";
+    icon = class_icon(rclsid, path, ARRAY_SIZE(path), &index);
+    ret = OleMetafilePictFromIconAndLabel(icon, (LPOLESTR)label, path[0] ? path : NULL, index);
+    DestroyIcon(icon);
+    CoTaskMemFree(type);
+    return ret;
 }
 
