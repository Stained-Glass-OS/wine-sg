@@ -280,11 +280,16 @@ static LRESULT CALLBACK island_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM
         return 1;   /* the content paints all of it */
     case WM_PAINT:
     {
+        struct xaml_source *source = (struct xaml_source *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
         PAINTSTRUCT ps;
-        BeginPaint( hwnd, &ps );
