diff --git a/dlls/windows.ui.xaml/panel.c b/dlls/windows.ui.xaml/panel.c
index aa185a2..06e3654 100644
--- a/dlls/windows.ui.xaml/panel.c
+++ b/dlls/windows.ui.xaml/panel.c
@@ -130,6 +130,38 @@ static struct xsize deflate( struct xsize size, const struct xthickness *t )
     return size;
 }
 
+/* ---- drawing ---- */
+
+static void fill_brush( struct dobj *obj, struct xaml_property *prop, struct xdraw *draw, const struct xrect *rect,
+                        const struct xcorner *corner )
+{
+    IInspectable *brush = NULL;
+    struct xcolor color;
+
+    dobj_get_value( obj, prop, &brush );
+    if (brush && xaml_brush_color( brush, &color )) xdraw_fill( draw, rect, color, corner );
+    if (brush) IInspectable_Release( brush );
+}
+
+static void border_brush( struct dobj *obj, struct xaml_property *prop, struct xdraw *draw, const struct xrect *rect,
+                          const struct xthickness *thickness, const struct xcorner *corner )
+{
+    IInspectable *brush = NULL;
+    struct xcolor color;
+
+    dobj_get_value( obj, prop, &brush );
+    if (brush && xaml_brush_color( brush, &color )) xdraw_border( draw, rect, thickness, color, corner );
+    if (brush) IInspectable_Release( brush );
+}
+
+static struct xaml_property *prop_background_ref( void );
+
+static void panel_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct xrect rect = { 0, 0, elem->render.width, elem->render.height };
+    fill_brush( &elem->d, prop_background_ref(), draw, &rect, NULL );
+}
+
 /* ---- Panel ---- */
 
