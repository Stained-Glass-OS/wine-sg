+}
 static INIT_ONCE panels_once = INIT_ONCE_STATIC_INIT;
 
 static void panels_init(void)
@@ -295,7 +332,8 @@ static const struct xclass panel_class =
 };
 
 #define e_obj e.d.obj
-COMPOSABLE_CREATE(panel_factory_CreateInstance, struct panel, panel_init( obj, &panel_class, NULL, outer ), IPanel_iface)
+static const struct elem_ops panel_ops = { NULL, NULL, panel_render };
+COMPOSABLE_CREATE(panel_factory_CreateInstance, struct panel, panel_init( obj, &panel_class, &panel_ops, outer ), IPanel_iface)
 #undef e_obj
 
 static const void *panel_factory_vtbl[] = { IPanelFactory_FSTUBS, [IPanelFactory_CreateInstance] = panel_factory_CreateInstance };
@@ -918,7 +956,19 @@ done:
     free( cells );
 }
 
-static const struct elem_ops grid_ops = { grid_measure, grid_arrange };
+static void grid_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct xrect rect = { 0, 0, elem->render.width, elem->render.height };
+    struct xthickness thickness;
+    struct xcorner corner;
+
+    dobj_ref( &elem->d, prop_grid_corner_radius, &IID_IReference_CornerRadius, &corner, sizeof(corner) );
+    dobj_ref( &elem->d, prop_grid_border_thickness, &IID_IReference_Thickness, &thickness, sizeof(thickness) );
+    fill_brush( &elem->d, prop_background, draw, &rect, &corner );
+    border_brush( &elem->d, prop_grid_border_brush, draw, &rect, &thickness, &corner );
+}
+
+static const struct elem_ops grid_ops = { grid_measure, grid_arrange, grid_render };
 
 static HRESULT WINAPI grid_get_RowDefinitions( struct xiface *iface, IInspectable **value )
 {
@@ -1240,7 +1290,7 @@ static void stack_arrange( struct uielem *elem, struct xsize final, struct xsize
     *used = final;
 }
 
-static const struct elem_ops stack_ops = { stack_measure, stack_arrange };
+static const struct elem_ops stack_ops = { stack_measure, stack_arrange, panel_render };
 
 static HRESULT WINAPI stack_get_AreScrollSnapPointsRegular( struct xiface *iface, boolean *value )
 {
@@ -1424,7 +1474,19 @@ static void border_arrange( struct uielem *elem, struct xsize final, struct xsiz
     uielem_arrange( border->child, rect );
 }
 
-static const struct elem_ops border_ops = { border_measure, border_arrange };
+static void border_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct xrect rect = { 0, 0, elem->render.width, elem->render.height };
+    struct xthickness thickness;
+    struct xcorner corner;
+
+    dobj_ref( &elem->d, prop_corner_radius, &IID_IReference_CornerRadius, &corner, sizeof(corner) );
+    dobj_ref( &elem->d, prop_border_thickness, &IID_IReference_Thickness, &thickness, sizeof(thickness) );
+    fill_brush( &elem->d, prop_border_background, draw, &rect, &corner );
+    border_brush( &elem->d, prop_border_brush, draw, &rect, &thickness, &corner );
+}
