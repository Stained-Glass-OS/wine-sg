+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A XAML host window (an island) paints its content with Direct2D: the content is laid out to the
+ * window's size, then every visible element draws itself (its elem_ops render) at its place, its
+ * children over it in order.  The window's own background is the theme's.
+ */
+
+#include <stdlib.h>
+#include <math.h>
+#include "private.h"
+#include "winuser.h"
+#include "dwrite.h"
+#include "initguid.h"
+#include "d2d1.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+struct xdraw
+{
+    ID2D1RenderTarget *target;
+    FLOAT x, y;                 /* the element's origin in the window */
+};
+
+static ID2D1Factory *d2d;
+static INIT_ONCE d2d_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL WINAPI init_d2d( INIT_ONCE *once, void *param, void **context )
+{
+    if (FAILED(D2D1CreateFactory( D2D1_FACTORY_TYPE_SINGLE_THREADED, &IID_ID2D1Factory, NULL, (void **)&d2d )))
+        ERR( "no Direct2D\n" );
+    return TRUE;
+}
+
+static D2D1_COLOR_F d2d_color( struct xcolor color )
+{
+    D2D1_COLOR_F ret = { color.r / 255.0f, color.g / 255.0f, color.b / 255.0f, color.a / 255.0f };
+    return ret;
+}
+
+static ID2D1SolidColorBrush *solid( struct xdraw *draw, struct xcolor color )
+{
+    ID2D1SolidColorBrush *brush = NULL;
+    D2D1_COLOR_F c = d2d_color( color );
+
+    ID2D1RenderTarget_CreateSolidColorBrush( draw->target, &c, NULL, &brush );
+    return brush;
+}
+
+static BOOL rounded( const struct xcorner *corner )
+{
+    return corner && (corner->top_left > 0 || corner->top_right > 0 || corner->bottom_right > 0 || corner->bottom_left > 0);
+}
+
+/* rounded rectangles use one radius: the largest corner's (Direct2D's) */
+static FLOAT radius( const struct xcorner *corner )
+{
+    return fmax( fmax( corner->top_left, corner->top_right ), fmax( corner->bottom_right, corner->bottom_left ) );
+}
+
+void xdraw_fill( struct xdraw *draw, const struct xrect *rect, struct xcolor color, const struct xcorner *corner )
+{
+    ID2D1SolidColorBrush *brush;
+    D2D1_RECT_F r = { draw->x + rect->x, draw->y + rect->y, draw->x + rect->x + rect->width, draw->y + rect->y + rect->height };
+
+    if (!color.a || rect->width <= 0 || rect->height <= 0 || !(brush = solid( draw, color ))) return;
+    if (rounded( corner ))
+    {
+        D2D1_ROUNDED_RECT rr = { r, radius( corner ), radius( corner ) };
+        ID2D1RenderTarget_FillRoundedRectangle( draw->target, &rr, (ID2D1Brush *)brush );
+    }
+    else ID2D1RenderTarget_FillRectangle( draw->target, &r, (ID2D1Brush *)brush );
+    ID2D1SolidColorBrush_Release( brush );
+}
+
+void xdraw_border( struct xdraw *draw, const struct xrect *rect, const struct xthickness *t, struct xcolor color,
+                   const struct xcorner *corner )
+{
+    ID2D1SolidColorBrush *brush;
+    struct xrect side;
+
+    if (!color.a || (!t->left && !t->top && !t->right && !t->bottom)) return;
+    if (t->left == t->top && t->left == t->right && t->left == t->bottom)
+    {
+        /* uniform: a stroke along the inside */
+        FLOAT w = t->left, half = w / 2;
+        D2D1_RECT_F r = { draw->x + rect->x + half, draw->y + rect->y + half,
+                          draw->x + rect->x + rect->width - half, draw->y + rect->y + rect->height - half };
+
+        if (!(brush = solid( draw, color ))) return;
+        if (rounded( corner ))
+        {
+            D2D1_ROUNDED_RECT rr = { r, fmax( 0, radius( corner ) - half ), fmax( 0, radius( corner ) - half ) };
+            ID2D1RenderTarget_DrawRoundedRectangle( draw->target, &rr, (ID2D1Brush *)brush, w, NULL );
+        }
+        else ID2D1RenderTarget_DrawRectangle( draw->target, &r, (ID2D1Brush *)brush, w, NULL );
+        ID2D1SolidColorBrush_Release( brush );
+        return;
+    }
+    /* sides of their own thickness */
+    side.x = rect->x; side.y = rect->y; side.width = rect->width; side.height = t->top;
+    xdraw_fill( draw, &side, color, NULL );
+    side.y = rect->y + rect->height - t->bottom; side.height = t->bottom;
+    xdraw_fill( draw, &side, color, NULL );
+    side.y = rect->y + t->top; side.height = rect->height - t->top - t->bottom; side.width = t->left;
+    xdraw_fill( draw, &side, color, NULL );
+    side.x = rect->x + rect->width - t->right; side.width = t->right;
+    xdraw_fill( draw, &side, color, NULL );
+}
+
+void xdraw_text( struct xdraw *draw, IUnknown *layout, FLOAT x, FLOAT y, struct xcolor color )
+{
+    ID2D1SolidColorBrush *brush;
+    D2D1_POINT_2F origin = { draw->x + x, draw->y + y };
+
+    if (!color.a || !(brush = solid( draw, color ))) return;
+    ID2D1RenderTarget_DrawTextLayout( draw->target, origin, (IDWriteTextLayout *)layout, (ID2D1Brush *)brush,
+                                      D2D1_DRAW_TEXT_OPTIONS_NONE );
+    ID2D1SolidColorBrush_Release( brush );
+}
+
+static void render_element( struct uielem *elem, ID2D1RenderTarget *target, FLOAT x, FLOAT y )
+{
+    struct xdraw draw = { target, x + elem->offset.x, y + elem->offset.y };
+    struct uielem *child;
+
+    if (elem->visibility == XCOLLAPSED || !elem->arrange_valid) return;
+#ifndef SG_MUTANT_RENDER_NOTHING
+    if (elem->ops && elem->ops->render) elem->ops->render( elem, &draw );
+#endif
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry )
+        render_element( child, target, draw.x, draw.y );
+}
+
+/* a host window's paint: its content laid out to its size and drawn on its DC */
+void xaml_render_window( HWND hwnd, HDC hdc, IInspectable *content )
+{
+    D2D1_RENDER_TARGET_PROPERTIES props =
+    {
+        D2D1_RENDER_TARGET_TYPE_DEFAULT, { DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED }, 0, 0,
+        D2D1_RENDER_TARGET_USAGE_GDI_COMPATIBLE, D2D1_FEATURE_LEVEL_DEFAULT,
+    };
+    ID2D1DCRenderTarget *target;
+    struct uielem *root = uielem_from_inspectable( content );
+    D2D1_COLOR_F background;
+    RECT rc;
+    HRESULT hr;
+
+    InitOnceExecuteOnce( &d2d_once, init_d2d, NULL, NULL );
+    if (!d2d) return;
+    GetClientRect( hwnd, &rc );
+    if (rc.right <= 0 || rc.bottom <= 0) return;
+    if (root)
+    {
+        struct xsize size = { rc.right, rc.bottom };
+        struct xrect final = { 0, 0, rc.right, rc.bottom };
+        uielem_measure( root, size );
+        uielem_arrange( root, final );
+    }
+    if (FAILED(hr = ID2D1Factory_CreateDCRenderTarget( d2d, &props, &target )))
+    {
+        ERR( "no render target, hr %#lx\n", hr );
+        return;
+    }
+    if (SUCCEEDED(ID2D1DCRenderTarget_BindDC( target, hdc, &rc )))
+    {
+        ID2D1DCRenderTarget_BeginDraw( target );
+        background = d2d_color( xaml_theme_color( XTHEME_BACKGROUND ) );
+        ID2D1DCRenderTarget_Clear( target, &background );
+        if (root) render_element( root, (ID2D1RenderTarget *)target, 0, 0 );
+        if (FAILED(hr = ID2D1DCRenderTarget_EndDraw( target, NULL, NULL ))) WARN( "EndDraw hr %#lx\n", hr );
+    }
+    ID2D1DCRenderTarget_Release( target );
+}
diff --git a/dlls/windows.ui.xaml/text.c b/dlls/windows.ui.xaml/text.c
index 1248f12..306bad0 100644
--- a/dlls/windows.ui.xaml/text.c
+++ b/dlls/windows.ui.xaml/text.c
@@ -300,7 +300,22 @@ static void text_arrange( struct uielem *elem, struct xsize final, struct xsize
         IDWriteTextLayout_Release( layout );
 }
 
-static const struct elem_ops text_ops = { text_measure, text_arrange };
+static void text_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct text_block *text = text_from_elem( elem );
+    struct xthickness padding;
+    IInspectable *brush = NULL;
+    struct xcolor color;
+
+    if (!text->layout) return;
+    get_padding( elem, &padding );
+    dobj_get_value( &elem->d, prop_foreground, &brush );
+    if (!brush || !xaml_brush_color( brush, &color )) color = xaml_theme_color( XTHEME_TEXT );
+    if (brush) IInspectable_Release( brush );
+    xdraw_text( draw, (IUnknown *)text->layout, padding.left, padding.top, color );
+}
+
+static const struct elem_ops text_ops = { text_measure, text_arrange, text_render };
 
 /* ---- ITextBlock ---- */
 
