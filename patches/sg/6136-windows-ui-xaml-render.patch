diff --git a/dlls/windows.ui.xaml/private.h b/dlls/windows.ui.xaml/private.h
index a7e2991..bf6f660 100644
--- a/dlls/windows.ui.xaml/private.h
+++ b/dlls/windows.ui.xaml/private.h
@@ -249,11 +249,14 @@ void xaml_invalidate_visuals(void);
 
 struct uielem;
 
-/* what our classes do in place of the overridable methods */
+struct xdraw;
+
+/* what our classes do in place of the overridable methods, and how they draw */
 struct elem_ops
 {
     void (*measure)( struct uielem *elem, struct xsize available, struct xsize *desired );   /* MeasureOverride */
     void (*arrange)( struct uielem *elem, struct xsize final, struct xsize *used );        /* ArrangeOverride */
+    void (*render)( struct uielem *elem, struct xdraw *draw );                             /* its own look */
 };
 
 /* a UIElement (and FrameworkElement: every element of ours is one) */
@@ -328,6 +331,15 @@ void uielem_invalidate_arrange( struct uielem *elem );
 void uielem_update_layout( struct uielem *elem );
 void xaml_elements_init(void);
 
+/* ---- drawing (render.c): coordinates are the element's own ---- */
+
+struct xcorner;
+void xdraw_fill( struct xdraw *draw, const struct xrect *rect, struct xcolor color, const struct xcorner *corner );
+void xdraw_border( struct xdraw *draw, const struct xrect *rect, const struct xthickness *thickness, struct xcolor color,
+                   const struct xcorner *corner );
+void xdraw_text( struct xdraw *draw, IUnknown *layout, FLOAT x, FLOAT y, struct xcolor color );
+void xaml_render_window( HWND hwnd, HDC hdc, IInspectable *content );
+
 /* ---- collections (vector.c) ---- */
 
