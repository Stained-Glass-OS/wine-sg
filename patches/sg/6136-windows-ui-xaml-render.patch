@@ -239,6 +271,11 @@ static const void *panel_vtbl[] =
 static const void *panel2_vtbl[] = { IPanel2_STUBS };
 
 static BOOL WINAPI init_panels( INIT_ONCE *once, void *param, void **context );
+
+static struct xaml_property *prop_background_ref( void )
