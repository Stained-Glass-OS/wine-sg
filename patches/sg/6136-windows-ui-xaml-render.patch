diff --git a/dlls/windows.ui.xaml/render.c b/dlls/windows.ui.xaml/render.c
new file mode 100644
index 0000000..42abc6f
--- /dev/null
+++ b/dlls/windows.ui.xaml/render.c
@@ -0,0 +1,192 @@
