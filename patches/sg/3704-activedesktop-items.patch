 static HRESULT WINAPI active_desktop_GetDesktopItem(IActiveDesktop *iface, int index, LPCOMPONENT component, DWORD reserved)
 {
-    FIXME("%p, %d, %p, %#lx.\n", iface, index, component, reserved);
