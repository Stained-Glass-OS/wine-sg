+    HeapFree(GetProcessHeap(), 0, utf8);
+done:
+    HeapFree(GetProcessHeap(), 0, src);
+    HeapFree(GetProcessHeap(), 0, name);
+    HeapFree(GetProcessHeap(), 0, page);
+    return hr;
+}
+
+static int ad_url_type(const WCHAR *url)
+{
+    static const WCHAR *pics[] = { L".bmp", L".dib", L".gif", L".jpg", L".jpe", L".jpeg", L".jfif", L".png", L".tif", L".tiff", L".ico" };
+    static const WCHAR *docs[] = { L".htm", L".html", L".mht", L".mhtml", L".htt" };
+    const WCHAR *ext = wcsrchr(url, '.'), *slash = wcsrchr(url, '/');
+    BOOL web = !wcsnicmp(url, L"http:", 5) || !wcsnicmp(url, L"https:", 6) || !wcsnicmp(url, L"ftp:", 4);
+    unsigned int i;
+
+#ifdef SG_MUTANT_AD_URLTYPE
+    return COMP_TYPE_WEBSITE;
+#endif
+    if (ext && (!slash || ext > slash))
+    {
+        for (i = 0; i < ARRAY_SIZE(pics); i++) if (!wcsicmp(ext, pics[i])) return COMP_TYPE_PICTURE;
+        if (!web) for (i = 0; i < ARRAY_SIZE(docs); i++) if (!wcsicmp(ext, docs[i])) return COMP_TYPE_HTMLDOC;
+    }
+    return web ? COMP_TYPE_WEBSITE : COMP_TYPE_HTMLDOC;
+}
