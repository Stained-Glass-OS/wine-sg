From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: IActiveDesktop desktop items (3704)

shell32: IActiveDesktop desktop items

IActiveDesktop now keeps desktop items: AddDesktopItem, AddDesktopItemWithUI,
AddUrl, ModifyDesktopItem (only the COMP_ELEM_* members chosen), RemoveDesktopItem,
GetDesktopItem, GetDesktopItemByID, GetDesktopItemBySource, GetDesktopItemCount
and Get/SetDesktopItemOptions. Changes stay in memory until ApplyChanges writes
them to HKCU\Software\Microsoft\Internet Explorer\Desktop\Components; they are read
from there on first use, so another process sees them. GenerateDesktopItemHtml
writes a page with the item (image, frame or object by component type).
---
diff --git a/dlls/shell32/shfldr_desktop.c b/dlls/shell32/shfldr_desktop.c
index 3d1df9a..248ae31 100644
--- a/dlls/shell32/shfldr_desktop.c
+++ b/dlls/shell32/shfldr_desktop.c
@@ -1038,6 +1038,8 @@ static DWORD ad_registry_style(void)
     return WPSTYLE_CENTER;
 }
 
+static void ad_save_items(void);
+
 static HRESULT WINAPI active_desktop_ApplyChanges(IActiveDesktop *iface, DWORD flags)
 {
     HRESULT hr = S_OK;
@@ -1077,6 +1079,7 @@ static HRESULT WINAPI active_desktop_ApplyChanges(IActiveDesktop *iface, DWORD f
                 hr = E_FAIL;
             ad_has_wallpaper = FALSE;
         }
+        ad_save_items();
     }
     LeaveCriticalSection(&ad_cs);
     return hr;
@@ -1170,94 +1173,542 @@ static HRESULT WINAPI active_desktop_SetPattern(IActiveDesktop *iface, PCWSTR pa
     return S_OK;
 }
 
+/* Desktop items (the HTML components of the old Active Desktop).  They live in memory in the shared
+ * object until ApplyChanges writes them to HKCU\Software\Microsoft\Internet Explorer\Desktop\Components
+ * (one subkey per item holding the COMPONENT as a binary value; the layout is this implementation's
+ * own, nothing documents it) and are loaded from there on first use. */
+#define COMP_ELEM_TYPE          0x0001
+#define COMP_ELEM_CHECKED       0x0002
+#define COMP_ELEM_DIRTY         0x0004
+#define COMP_ELEM_NOSCROLL      0x0008
+#define COMP_ELEM_POS_LEFT      0x0010
+#define COMP_ELEM_POS_TOP       0x0020
+#define COMP_ELEM_SIZE_WIDTH    0x0040
+#define COMP_ELEM_SIZE_HEIGHT   0x0080
+#define COMP_ELEM_POS_ZINDEX    0x0100
+#define COMP_ELEM_SOURCE        0x0200
+#define COMP_ELEM_FRIENDLYNAME  0x0400
+#define COMP_ELEM_SUBSCRIBEDURL 0x0800
+#define COMP_ELEM_ORIGINAL_CSI  0x1000
+#define COMP_ELEM_RESTORED_CSI  0x2000
+#define COMP_ELEM_CURITEMSTATE  0x4000
+#define COMP_ELEM_ALL           0x7fff
+#define COMP_TYPE_HTMLDOC  0
+#define COMP_TYPE_PICTURE  1
+#define COMP_TYPE_WEBSITE  2
+#define COMP_TYPE_CONTROL  3
+#define COMPONENT_DEFAULT_LEFT 0xffff
+#define COMPONENT_DEFAULT_TOP  0xffff
+#define IS_NORMAL     1
+#define IS_FULLSCREEN 2
+#define IS_SPLIT      4
+#define DTI_ADDUI_POSITIONITEM 2
+#define ADDURL_SILENT 1
+#define AD_ITEMS_KEY L"Software\\Microsoft\\Internet Explorer\\Desktop\\Components"
+
+static BOOL ad_nul(const WCHAR *s, size_t n)
+{
+    while (n--) if (!*s++) return TRUE;
+    return FALSE;
+}
+
+static COMPONENT *ad_items;
+static int ad_item_count, ad_item_alloc;
+static BOOL ad_items_loaded;
+static DWORD ad_next_id = 1;
+static COMPONENTSOPT ad_copt = { sizeof(COMPONENTSOPT), FALSE, FALSE };
+
+static BOOL ad_append_item(const COMPONENT *c)
+{
+    if (ad_item_count == ad_item_alloc)
+    {
+        int n = ad_item_alloc ? ad_item_alloc * 2 : 8;
+        COMPONENT *p = ad_items ? HeapReAlloc(GetProcessHeap(), 0, ad_items, n * sizeof(*p))
+                                : HeapAlloc(GetProcessHeap(), 0, n * sizeof(*p));
+        if (!p) return FALSE;
+        ad_items = p;
+        ad_item_alloc = n;
+    }
+    ad_items[ad_item_count++] = *c;
+    return TRUE;
+}
+
+/* called with ad_cs held */
+static void ad_load_items(void)
+{
+    HKEY key, sub;
+    WCHAR name[16];
+    DWORD i, size, val, type;
+
+    if (ad_items_loaded) return;
+    ad_items_loaded = TRUE;
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, AD_ITEMS_KEY, 0, KEY_READ, &key)) return;
+    size = sizeof(val);
+    if (!RegQueryValueExW(key, L"EnableComponents", NULL, &type, (BYTE *)&val, &size) && type == REG_DWORD)
+        ad_copt.fEnableComponents = val != 0;
+    size = sizeof(val);
+    if (!RegQueryValueExW(key, L"ActiveDesktop", NULL, &type, (BYTE *)&val, &size) && type == REG_DWORD)
+        ad_copt.fActiveDesktop = val != 0;
+    for (i = 0; !RegEnumKeyW(key, i, name, ARRAY_SIZE(name)); i++)
+    {
+        COMPONENT c;
+
+        if (RegOpenKeyExW(key, name, 0, KEY_READ, &sub)) continue;
+        size = sizeof(c);
+        if (!RegQueryValueExW(sub, L"Component", NULL, &type, (BYTE *)&c, &size) && type == REG_BINARY
+                && size == sizeof(c) && c.dwSize == sizeof(c)
+                && ad_nul(c.wszSource, ARRAY_SIZE(c.wszSource)) && c.wszSource[0])
+        {
+            c.dwID = ad_next_id++;
+            c.fDirty = FALSE;
+            ad_append_item(&c);
+        }
+        RegCloseKey(sub);
+    }
+    RegCloseKey(key);
+}
+
+/* called with ad_cs held */
+static void ad_save_items(void)
+{
+    HKEY key, sub;
+    WCHAR name[16];
+    DWORD val;
+    int i;
+
+#ifdef SG_MUTANT_AD_NOSAVE
+    return;
+#endif
+    if (!ad_items_loaded) return;
+    RegDeleteTreeW(HKEY_CURRENT_USER, AD_ITEMS_KEY);
+    if (RegCreateKeyExW(HKEY_CURRENT_USER, AD_ITEMS_KEY, 0, NULL, 0, KEY_WRITE, NULL, &key, NULL)) return;
+    val = ad_copt.fEnableComponents;
+    RegSetValueExW(key, L"EnableComponents", 0, REG_DWORD, (BYTE *)&val, sizeof(val));
+    val = ad_copt.fActiveDesktop;
+    RegSetValueExW(key, L"ActiveDesktop", 0, REG_DWORD, (BYTE *)&val, sizeof(val));
+    for (i = 0; i < ad_item_count; i++)
+    {
+        swprintf(name, ARRAY_SIZE(name), L"%d", i);
+        ad_items[i].fDirty = FALSE;
+        if (RegCreateKeyExW(key, name, 0, NULL, 0, KEY_WRITE, NULL, &sub, NULL)) continue;
+        RegSetValueExW(sub, L"Component", 0, REG_BINARY, (BYTE *)&ad_items[i], sizeof(COMPONENT));
+        RegCloseKey(sub);
+    }
+    RegCloseKey(key);
+}
+
+static BOOL ad_comp_valid(const COMPONENT *c)
+{
+    return c && c->dwSize >= sizeof(*c);
+}
+
+static int ad_find_source(const WCHAR *source)
+{
+    int i;
+    for (i = 0; i < ad_item_count; i++)
+        if (!lstrcmpiW(ad_items[i].wszSource, source)) return i;
+    return -1;
+}
+
+static int ad_find_id(DWORD id)
+{
+    int i;
+    for (i = 0; i < ad_item_count; i++)
+        if (ad_items[i].dwID == id) return i;
+    return -1;
+}
+
+static void ad_copy_out(COMPONENT *out, const COMPONENT *item)
+{
+    DWORD size = out->dwSize;
+    *out = *item;
+    out->dwSize = size;
+}
+
+/* the IE5 flag of AddDesktopItemWithUI: keep the position and size within the screen */
+static void ad_position_item(COMPONENT *c)
+{
+    int cx = GetSystemMetrics(SM_CXSCREEN), cy = GetSystemMetrics(SM_CYSCREEN);
+
+    if (c->cpPos.iLeft != COMPONENT_DEFAULT_LEFT)
+        c->cpPos.iLeft = max(0, min(c->cpPos.iLeft, cx - 1));
+    if (c->cpPos.iTop != COMPONENT_DEFAULT_TOP)
+        c->cpPos.iTop = max(0, min(c->cpPos.iTop, cy - 1));
+    if (c->cpPos.dwWidth > (DWORD)cx) c->cpPos.dwWidth = cx;
+    if (c->cpPos.dwHeight > (DWORD)cy) c->cpPos.dwHeight = cy;
+}
+
+/* called with ad_cs held; *added receives the stored item */
+static HRESULT ad_add_item(const COMPONENT *src, DWORD ui_flags, COMPONENT *added)
+{
+    COMPONENT c;
+
+    if (!ad_comp_valid(src)) return E_INVALIDARG;
+    if (src->iComponentType < COMP_TYPE_HTMLDOC || src->iComponentType > COMP_TYPE_CONTROL) return E_INVALIDARG;
+    if (!src->wszSource[0] || !ad_nul(src->wszSource, ARRAY_SIZE(src->wszSource))
+            || !ad_nul(src->wszFriendlyName, ARRAY_SIZE(src->wszFriendlyName))
+            || !ad_nul(src->wszSubscribedURL, ARRAY_SIZE(src->wszSubscribedURL)))
+        return E_INVALIDARG;
+    ad_load_items();
+#ifndef SG_MUTANT_AD_DUP
+    if (ad_find_source(src->wszSource) >= 0) return E_FAIL;
+#endif
+    c = *src;
+    c.dwSize = sizeof(c);
+#ifndef SG_MUTANT_AD_NOCLAMP
+    if (ui_flags & DTI_ADDUI_POSITIONITEM) ad_position_item(&c);
+#endif
+    c.dwID = ad_next_id++;
+    c.fDirty = TRUE;
+    if (!c.dwCurItemState) c.dwCurItemState = IS_NORMAL;
+    c.csiOriginal.dwSize = c.csiRestored.dwSize = sizeof(COMPSTATEINFO);
+    c.csiOriginal.iLeft = c.csiRestored.iLeft = c.cpPos.iLeft;
+    c.csiOriginal.iTop = c.csiRestored.iTop = c.cpPos.iTop;
+    c.csiOriginal.dwWidth = c.csiRestored.dwWidth = c.cpPos.dwWidth;
+    c.csiOriginal.dwHeight = c.csiRestored.dwHeight = c.cpPos.dwHeight;
+    c.csiOriginal.dwItemState = c.csiRestored.dwItemState = c.dwCurItemState;
+    if (!ad_append_item(&c)) return E_OUTOFMEMORY;
+    if (added) *added = c;
+    return S_OK;
+}
+
 static HRESULT WINAPI active_desktop_GetDesktopItemOptions(IActiveDesktop *iface, LPCOMPONENTSOPT options, DWORD reserved)
 {
     TRACE("%p, %p, %#lx.\n", iface, options, reserved);
 
     if (!options || options->dwSize < sizeof(*options)) return E_INVALIDARG;
-    options->fEnableComponents = FALSE;
-    options->fActiveDesktop = FALSE;
+    EnterCriticalSection(&ad_cs);
+    ad_load_items();
+    options->fEnableComponents = ad_copt.fEnableComponents;
+    options->fActiveDesktop = ad_copt.fActiveDesktop;
+    LeaveCriticalSection(&ad_cs);
     return S_OK;
 }
 
 static HRESULT WINAPI active_desktop_SetDesktopItemOptions(IActiveDesktop *iface, LPCCOMPONENTSOPT options, DWORD reserved)
 {
-    FIXME("%p, %p, %#lx.\n", iface, options, reserved);
+    TRACE("%p, %p, %#lx.\n", iface, options, reserved);
 
-    return E_NOTIMPL;
+    if (!options || options->dwSize < sizeof(*options)) return E_INVALIDARG;
+    EnterCriticalSection(&ad_cs);
+    ad_load_items();
+#ifndef SG_MUTANT_AD_OPTS
+    ad_copt.fEnableComponents = options->fEnableComponents != 0;
+    ad_copt.fActiveDesktop = options->fActiveDesktop != 0;
+#endif
+    LeaveCriticalSection(&ad_cs);
+    return S_OK;
 }
 
 static HRESULT WINAPI active_desktop_AddDesktopItem(IActiveDesktop *iface, LPCCOMPONENT component, DWORD reserved)
 {
-    FIXME("%p, %p, %#lx.\n", iface, component, reserved);
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p, %#lx.\n", iface, component, reserved);
+
+    EnterCriticalSection(&ad_cs);
+    hr = ad_add_item(component, 0, NULL);
+    LeaveCriticalSection(&ad_cs);
+    return hr;
 }
 
 static HRESULT WINAPI active_desktop_AddDesktopItemWithUI(IActiveDesktop *iface, HWND hwnd, LPCOMPONENT component, DWORD reserved)
 {
-    FIXME("%p, %p, %p, %#lx.\n", iface, hwnd, component, reserved);
+    COMPONENT added;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p, %p, %#lx.\n", iface, hwnd, component, reserved);
+
+    /* The confirmation, security zone and subscription wizard dialogs are not shown (this shell has
+     * no HTML desktop to be protected from a zone); the item is added as if they were accepted. */
+    EnterCriticalSection(&ad_cs);
+    hr = ad_add_item(component, reserved, &added);
+    if (hr == S_OK) component->dwID = added.dwID;
+    LeaveCriticalSection(&ad_cs);
+    return hr;
 }
 
 static HRESULT WINAPI active_desktop_ModifyDesktopItem(IActiveDesktop *iface, LPCCOMPONENT component, DWORD flags)
 {
-    FIXME("%p, %p, %#lx.\n", iface, component, flags);
+    COMPONENT *item;
+    int i;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p, %#lx.\n", iface, component, flags);
+
+    if (!ad_comp_valid(component) || (flags & ~COMP_ELEM_ALL)) return E_INVALIDARG;
+    EnterCriticalSection(&ad_cs);
+    ad_load_items();
+    /* the item is the one with the source of the structure; with COMP_ELEM_SOURCE, which replaces the
+     * source, the item's ID names it instead (a guess: the documentation names only the source) */
+#ifdef SG_MUTANT_AD_BYSRC
+    i = ad_find_source(component->wszSource);
+#else
+    i = ((flags & COMP_ELEM_SOURCE) && component->dwID) ? ad_find_id(component->dwID) : ad_find_source(component->wszSource);
+#endif
+    if (i < 0)
+    {
+        LeaveCriticalSection(&ad_cs);
+        return E_FAIL;
+    }
+    item = &ad_items[i];
+#ifdef SG_MUTANT_AD_MODALL
+    flags = COMP_ELEM_ALL;
+#endif
+    if (flags & COMP_ELEM_TYPE) item->iComponentType = component->iComponentType;
+    if (flags & COMP_ELEM_CHECKED) item->fChecked = component->fChecked;
+    if (flags & COMP_ELEM_DIRTY) item->fDirty = component->fDirty;
+    if (flags & COMP_ELEM_NOSCROLL) item->fNoScroll = component->fNoScroll;
+    if (flags & COMP_ELEM_POS_LEFT) item->cpPos.iLeft = component->cpPos.iLeft;
+    if (flags & COMP_ELEM_POS_TOP) item->cpPos.iTop = component->cpPos.iTop;
+    if (flags & COMP_ELEM_SIZE_WIDTH) item->cpPos.dwWidth = component->cpPos.dwWidth;
+    if (flags & COMP_ELEM_SIZE_HEIGHT) item->cpPos.dwHeight = component->cpPos.dwHeight;
+    if (flags & COMP_ELEM_POS_ZINDEX) item->cpPos.izIndex = component->cpPos.izIndex;
+    if (flags & COMP_ELEM_SOURCE) lstrcpyW(item->wszSource, component->wszSource);
+    if (flags & COMP_ELEM_FRIENDLYNAME) lstrcpyW(item->wszFriendlyName, component->wszFriendlyName);
+    if (flags & COMP_ELEM_SUBSCRIBEDURL) lstrcpyW(item->wszSubscribedURL, component->wszSubscribedURL);
+    if (flags & COMP_ELEM_ORIGINAL_CSI) item->csiOriginal = component->csiOriginal;
+    if (flags & COMP_ELEM_RESTORED_CSI) item->csiRestored = component->csiRestored;
+    if (flags & COMP_ELEM_CURITEMSTATE) item->dwCurItemState = component->dwCurItemState;
+    if (!(flags & COMP_ELEM_DIRTY)) item->fDirty = TRUE;
+    LeaveCriticalSection(&ad_cs);
+    return S_OK;
 }
 
 static HRESULT WINAPI active_desktop_RemoveDesktopItem(IActiveDesktop *iface, LPCCOMPONENT component, DWORD reserved)
 {
-    FIXME("%p, %p, %#lx.\n", iface, component, reserved);
+    int i;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p, %#lx.\n", iface, component, reserved);
+
+    if (!ad_comp_valid(component)) return E_INVALIDARG;
+    EnterCriticalSection(&ad_cs);
+    ad_load_items();
+    i = ad_find_source(component->wszSource);
+    if (i < 0)
+    {
+        LeaveCriticalSection(&ad_cs);
+        return E_FAIL;
+    }
+#ifndef SG_MUTANT_AD_REMOVE
+    memmove(&ad_items[i], &ad_items[i + 1], (ad_item_count - i - 1) * sizeof(*ad_items));
+    ad_item_count--;
+#endif
+    LeaveCriticalSection(&ad_cs);
+    return S_OK;
 }
 
