+/* pixels to a float rectangle, infinite edges to +-FLT_MAX */
+void d2d_rect_f_from_rect_l(D2D1_RECT_F *dst, const D2D1_RECT_L *src, float scale_x, float scale_y)
+{
+    dst->left = src->left == LONG_MIN ? -FLT_MAX : src->left * scale_x;
+    dst->top = src->top == LONG_MIN ? -FLT_MAX : src->top * scale_y;
+    dst->right = src->right == LONG_MAX ? FLT_MAX : src->right * scale_x;
+    dst->bottom = src->bottom == LONG_MAX ? FLT_MAX : src->bottom * scale_y;
+}
