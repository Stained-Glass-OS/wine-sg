+static void STDMETHODCALLTYPE combine_sink_BeginFigure(ID2D1SimplifiedGeometrySink *iface,
+        D2D1_POINT_2F start, D2D1_FIGURE_BEGIN begin)
+{
+    struct combine_input *input = impl_from_sink(iface);
+
+    input->start = input->last = start;
+    /* a hollow figure has no area */
+    input->in_figure = begin == D2D1_FIGURE_BEGIN_FILLED;
+}
+
+static void STDMETHODCALLTYPE combine_sink_AddLines(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_POINT_2F *points, UINT32 count)
+{
+    struct combine_input *input = impl_from_sink(iface);
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (input->in_figure)
+            combine_add_edge(input, input->last, points[i]);
+        input->last = points[i];
+    }
+}
+
+static void STDMETHODCALLTYPE combine_sink_AddBeziers(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_BEZIER_SEGMENT *beziers, UINT32 count)
+{
+    struct combine_input *input = impl_from_sink(iface);
+    UINT32 i;
+
+    /* flattened already; a stray one is taken as its chord */
+    for (i = 0; i < count; ++i)
+        combine_sink_AddLines(iface, &beziers[i].point3, 1);
+    (void)input;
+}
+
+static void STDMETHODCALLTYPE combine_sink_EndFigure(ID2D1SimplifiedGeometrySink *iface, D2D1_FIGURE_END end)
+{
+    struct combine_input *input = impl_from_sink(iface);
+
+    /* a fill closes every figure */
+    if (input->in_figure)
+        combine_add_edge(input, input->last, input->start);
+    input->in_figure = FALSE;
+}
