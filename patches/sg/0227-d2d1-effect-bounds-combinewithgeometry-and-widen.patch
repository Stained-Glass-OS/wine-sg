+static int __cdecl compare_double(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return x < y ? -1 : x > y ? 1 : 0;
+}
+
+static double edge_x(const struct combine_edge *e, double y)
+{
+    if (y <= e->y0) return e->x0;
+    if (y >= e->y1) return e->x1;
+    return e->x0 + (e->x1 - e->x0) * (y - e->y0) / (e->y1 - e->y0);
+}
+
+/* where two edges cross, if they do strictly inside both */
+static BOOL edge_crossing_y(const struct combine_edge *a, const struct combine_edge *b, double *y)
+{
+    double ax = a->x1 - a->x0, ay = a->y1 - a->y0, bx = b->x1 - b->x0, by = b->y1 - b->y0;
+    double det = ax * by - ay * bx, t, u;
+
+    if (fabs(det) < 1e-12)
+        return FALSE;
+    t = ((b->x0 - a->x0) * by - (b->y0 - a->y0) * bx) / det;
+    u = ((b->x0 - a->x0) * ay - (b->y0 - a->y0) * ax) / det;
+    if (t <= 0.0 || t >= 1.0 || u <= 0.0 || u >= 1.0)
+        return FALSE;
+    *y = a->y0 + t * ay;
+    return TRUE;
+}
+
+struct slab_edge
+{
+    unsigned int index;
+    double x_mid, x_top, x_bottom;
+};
+
+static int __cdecl compare_slab_edge(const void *a, const void *b)
+{
+    const struct slab_edge *x = a, *y = b;
+
+    if (x->x_mid != y->x_mid) return x->x_mid < y->x_mid ? -1 : 1;
+    return x->index < y->index ? -1 : x->index > y->index ? 1 : 0;
+}
+
+/* a polygon growing downwards between two edges */
+struct combine_polygon
+{
+    unsigned int left, right;
+    D2D1_POINT_2F *left_points, *right_points;
+    size_t left_count, right_count, left_size, right_size;
+    BOOL continued;
+};
+
+static BOOL polygon_add(D2D1_POINT_2F **points, size_t *count, size_t *size, double x, double y)
+{
+    if (!d2d_array_reserve((void **)points, size, *count + 1, sizeof(**points)))
+        return FALSE;
+    (*points)[*count].x = x;
+    (*points)[*count].y = y;
+    ++*count;
+    return TRUE;
+}
+
+static void polygon_emit(struct combine_polygon *polygon, ID2D1SimplifiedGeometrySink *sink)
+{
+    size_t i;
+
+    if (polygon->left_count && polygon->right_count)
+    {
+        ID2D1SimplifiedGeometrySink_BeginFigure(sink, polygon->left_points[0], D2D1_FIGURE_BEGIN_FILLED);
+        if (polygon->left_count > 1)
+            ID2D1SimplifiedGeometrySink_AddLines(sink, polygon->left_points + 1, polygon->left_count - 1);
+        for (i = polygon->right_count; i-- > 0;)
+            ID2D1SimplifiedGeometrySink_AddLines(sink, &polygon->right_points[i], 1);
+        ID2D1SimplifiedGeometrySink_EndFigure(sink, D2D1_FIGURE_END_CLOSED);
+    }
+    free(polygon->left_points);
+    free(polygon->right_points);
+    memset(polygon, 0, sizeof(*polygon));
+}
+
+static BOOL combine_filled(int winding, D2D1_FILL_MODE mode)
+{
+    return mode == D2D1_FILL_MODE_ALTERNATE ? (winding & 1) : winding != 0;
+}
+
+static BOOL combine_op(BOOL a, BOOL b, D2D1_COMBINE_MODE mode)
+{
+    switch (mode)
+    {
+        case D2D1_COMBINE_MODE_UNION: return a || b;
+        case D2D1_COMBINE_MODE_INTERSECT: return a && b;
+        case D2D1_COMBINE_MODE_XOR: return a != b;
+        case D2D1_COMBINE_MODE_EXCLUDE: return a && !b;
+        default: return FALSE;
+    }
+}
+
+/* the slabs, over a list of edges */
+static HRESULT combine_run(const struct combine_edge *edges, size_t edge_count, D2D1_FILL_MODE fill_a,
+        D2D1_FILL_MODE fill_b, D2D1_COMBINE_MODE mode, ID2D1SimplifiedGeometrySink *sink)
+{
+    struct combine_polygon *open = NULL, *next_open = NULL;
+    size_t open_count = 0, next_count = 0, next_size = 0;
+    struct slab_edge *active = NULL;
+    size_t y_count = 0, y_size = 0, i, j, k;
+    double *ys = NULL;
+    HRESULT hr;
+
+    ID2D1SimplifiedGeometrySink_SetFillMode(sink, D2D1_FILL_MODE_WINDING);
+    if (!edge_count)
+        return S_OK;
+
+    /* the slabs' boundaries: vertices and crossings */
+    for (i = 0; i < edge_count; ++i)
+    {
+        if (!d2d_array_reserve((void **)&ys, &y_size, y_count + 2, sizeof(*ys)))
+            goto oom;
+        ys[y_count++] = edges[i].y0;
+        ys[y_count++] = edges[i].y1;
+        for (j = i + 1; j < edge_count; ++j)
+        {
+            double y;
+
+            if (edges[j].y0 >= edges[i].y1 || edges[i].y0 >= edges[j].y1)
+                continue;
+            if (edge_crossing_y(&edges[i], &edges[j], &y))
+            {
+                if (!d2d_array_reserve((void **)&ys, &y_size, y_count + 1, sizeof(*ys)))
+                    goto oom;
+                ys[y_count++] = y;
+            }
+        }
+    }
+    qsort(ys, y_count, sizeof(*ys), compare_double);
+    for (i = j = 0; i < y_count; ++i)
+    {
+        if (!j || ys[i] - ys[j - 1] > 1e-9)
+            ys[j++] = ys[i];
+    }
+    y_count = j;
+
+    if (!(active = malloc(edge_count * sizeof(*active))))
+        goto oom;
+
+    for (i = 0; i + 1 < y_count; ++i)
+    {
+        double top = ys[i], bottom = ys[i + 1], mid = (top + bottom) / 2.0;
+        size_t active_count = 0;
+        int wind_a = 0, wind_b = 0;
+        BOOL inside = FALSE;
+        unsigned int left = 0;
+        double left_top = 0, left_bottom = 0;
+
+        for (j = 0; j < edge_count; ++j)
+        {
+            if (edges[j].y0 > mid || edges[j].y1 < mid)
+                continue;
+            active[active_count].index = j;
+            active[active_count].x_mid = edge_x(&edges[j], mid);
+            active[active_count].x_top = edge_x(&edges[j], top);
+            active[active_count].x_bottom = edge_x(&edges[j], bottom);
+            ++active_count;
+        }
+        qsort(active, active_count, sizeof(*active), compare_slab_edge);
+
+        next_count = 0;
+        for (j = 0; j < active_count; ++j)
+        {
+            const struct combine_edge *e = &edges[active[j].index];
+            BOOL now;
+
+            if (e->owner) wind_b += e->dir;
+            else wind_a += e->dir;
+            now = combine_op(combine_filled(wind_a, fill_a), combine_filled(wind_b, fill_b), mode);
+
+            if (now && !inside)
+            {
+                left = active[j].index;
+                left_top = active[j].x_top;
+                left_bottom = active[j].x_bottom;
+            }
+            else if (!now && inside)
+            {
+                unsigned int right = active[j].index;
+                struct combine_polygon *polygon = NULL, *p;
+
+                /* the same two edges as in the slab above: that polygon grows */
+                for (k = 0; k < open_count; ++k)
+                {
+                    if (!open[k].continued && open[k].left == left && open[k].right == right)
+                    {
+                        polygon = &open[k];
+                        break;
+                    }
+                }
+                if (!d2d_array_reserve((void **)&next_open, &next_size, next_count + 1, sizeof(*next_open)))
+                    goto oom;
+                p = &next_open[next_count++];
+                if (polygon)
+                {
+                    *p = *polygon;
+                    polygon->continued = TRUE;
+                }
+                else
+                {
+                    memset(p, 0, sizeof(*p));
+                    p->left = left;
+                    p->right = right;
+                    if (!polygon_add(&p->left_points, &p->left_count, &p->left_size, left_top, top)
+                            || !polygon_add(&p->right_points, &p->right_count, &p->right_size, active[j].x_top, top))
+                        goto oom;
+                }
+                p->continued = FALSE;
+                if (!polygon_add(&p->left_points, &p->left_count, &p->left_size, left_bottom, bottom)
+                        || !polygon_add(&p->right_points, &p->right_count, &p->right_size, active[j].x_bottom, bottom))
+                    goto oom;
+            }
+            inside = now;
+        }
+
+        /* the polygons that did not continue end here */
+        for (k = 0; k < open_count; ++k)
+        {
+            if (!open[k].continued)
+                polygon_emit(&open[k], sink);
+        }
+        free(open);
+        open = next_open;
+        open_count = next_count;
+        next_open = NULL;
+        next_count = next_size = 0;
+    }
+    for (k = 0; k < open_count; ++k)
+        polygon_emit(&open[k], sink);
+    open_count = 0;
+    hr = S_OK;
+    goto done;
+
+oom:
+    hr = E_OUTOFMEMORY;
+done:
+    for (k = 0; k < open_count; ++k)
+    {
+        if (open[k].continued) continue;
+        free(open[k].left_points);
+        free(open[k].right_points);
+    }
+    for (k = 0; k < next_count; ++k)
+    {
+        free(next_open[k].left_points);
+        free(next_open[k].right_points);
+    }
+    free(open);
+    free(next_open);
+    free(active);
+    free(ys);
+    return hr;
+}
+
+HRESULT d2d_geometry_combine(ID2D1Geometry *geometry, ID2D1Geometry *other, D2D1_COMBINE_MODE mode,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, ID2D1SimplifiedGeometrySink *sink)
+{
+    struct combine_input a = {{&combine_sink_vtbl}}, b = {{&combine_sink_vtbl}};
+    struct combine_edge *edges = NULL;
+    size_t edge_count;
+    HRESULT hr;
+
+    if (!other || !sink)
+        return E_INVALIDARG;
+    if (mode > D2D1_COMBINE_MODE_EXCLUDE)
+        return E_INVALIDARG;
+    if (tolerance <= 0.0f)
+        tolerance = D2D1_DEFAULT_FLATTENING_TOLERANCE;
+
+    a.fill_mode = b.fill_mode = D2D1_FILL_MODE_ALTERNATE;
+    a.owner = 0;
+    b.owner = 1;
+    if (SUCCEEDED(hr = ID2D1Geometry_Simplify(geometry, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_LINES, NULL, tolerance,
+            &a.ID2D1SimplifiedGeometrySink_iface))
+            && SUCCEEDED(hr = ID2D1Geometry_Simplify(other, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_LINES, transform,
+            tolerance, &b.ID2D1SimplifiedGeometrySink_iface))
+            && SUCCEEDED(hr = a.hr) && SUCCEEDED(hr = b.hr))
+    {
+        edge_count = a.edge_count + b.edge_count;
+        if (edge_count && !(edges = malloc(edge_count * sizeof(*edges))))
+            hr = E_OUTOFMEMORY;
+        else
+        {
+            if (a.edge_count) memcpy(edges, a.edges, a.edge_count * sizeof(*edges));
+            if (b.edge_count) memcpy(edges + a.edge_count, b.edges, b.edge_count * sizeof(*edges));
+            hr = combine_run(edges, edge_count, a.fill_mode, b.fill_mode, mode, sink);
+        }
+    }
+    free(edges);
+    free(a.edges);
+    free(b.edges);
+    return hr;
+}
+
+/* Widen: the area a stroke of the geometry covers. Each flattened segment
+ * becomes a rectangle, each joint and end a join or cap polygon, all turned
+ * the same way round, and their union (non-zero winding) is the outline. */
+
+struct widen_figure
+{
+    D2D1_POINT_2F *points;
+    size_t count, size;
+    BOOL closed;
+};
+
+struct widen_input
+{
+    ID2D1SimplifiedGeometrySink ID2D1SimplifiedGeometrySink_iface;
+    struct widen_figure *figures;
+    size_t figure_count, figure_size;
+    HRESULT hr;
+};
+
+static struct widen_input *widen_from_sink(ID2D1SimplifiedGeometrySink *iface)
+{
+    return CONTAINING_RECORD(iface, struct widen_input, ID2D1SimplifiedGeometrySink_iface);
+}
+
+static void STDMETHODCALLTYPE widen_sink_SetFillMode(ID2D1SimplifiedGeometrySink *iface, D2D1_FILL_MODE mode)
+{
+}
+
+static void widen_add_point(struct widen_input *input, D2D1_POINT_2F p)
+{
+    struct widen_figure *f;
+
+    if (!input->figure_count)
+        return;
+    f = &input->figures[input->figure_count - 1];
+    if (f->count && f->points[f->count - 1].x == p.x && f->points[f->count - 1].y == p.y)
+        return;
+    if (!d2d_array_reserve((void **)&f->points, &f->size, f->count + 1, sizeof(*f->points)))
+    {
+        input->hr = E_OUTOFMEMORY;
+        return;
+    }
+    f->points[f->count++] = p;
+}
+
+static void STDMETHODCALLTYPE widen_sink_BeginFigure(ID2D1SimplifiedGeometrySink *iface,
+        D2D1_POINT_2F start, D2D1_FIGURE_BEGIN begin)
+{
+    struct widen_input *input = widen_from_sink(iface);
+
+    if (!d2d_array_reserve((void **)&input->figures, &input->figure_size, input->figure_count + 1,
+            sizeof(*input->figures)))
+    {
+        input->hr = E_OUTOFMEMORY;
+        return;
+    }
+    memset(&input->figures[input->figure_count++], 0, sizeof(*input->figures));
+    widen_add_point(input, start);
+}
+
+static void STDMETHODCALLTYPE widen_sink_AddLines(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_POINT_2F *points, UINT32 count)
+{
+    struct widen_input *input = widen_from_sink(iface);
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+        widen_add_point(input, points[i]);
+}
+
+static void STDMETHODCALLTYPE widen_sink_AddBeziers(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_BEZIER_SEGMENT *beziers, UINT32 count)
+{
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+        widen_sink_AddLines(iface, &beziers[i].point3, 1);
+}
+
+static void STDMETHODCALLTYPE widen_sink_EndFigure(ID2D1SimplifiedGeometrySink *iface, D2D1_FIGURE_END end)
+{
+    struct widen_input *input = widen_from_sink(iface);
+
+    if (input->figure_count)
+        input->figures[input->figure_count - 1].closed = end == D2D1_FIGURE_END_CLOSED;
+}
+
+static const ID2D1SimplifiedGeometrySinkVtbl widen_sink_vtbl =
+{
+    combine_sink_QueryInterface,
+    combine_sink_AddRef,
+    combine_sink_Release,
+    widen_sink_SetFillMode,
+    combine_sink_SetSegmentFlags,
+    widen_sink_BeginFigure,
+    widen_sink_AddLines,
+    widen_sink_AddBeziers,
+    widen_sink_EndFigure,
+    combine_sink_Close,
+};
+
+struct widen_output
+{
+    struct combine_edge *edges;
+    size_t count, size;
+    HRESULT hr;
+};
+
+/* a polygon, turned so its edges wind +1 */
+static void widen_polygon(struct widen_output *out, const D2D1_POINT_2F *p, unsigned int count)
+{
+    double area = 0.0;
+    unsigned int i;
+    int flip;
+
+    if (count < 3)
+        return;
+    for (i = 0; i < count; ++i)
+    {
+        const D2D1_POINT_2F *a = &p[i], *b = &p[(i + 1) % count];
+        area += (double)a->x * b->y - (double)b->x * a->y;
+    }
+    if (fabs(area) < 1e-12)
+        return;
+    flip = area < 0.0;
+    for (i = 0; i < count; ++i)
+    {
+        D2D1_POINT_2F a = p[i], b = p[(i + 1) % count];
+        struct combine_edge *e;
+
+        if (a.y == b.y)
+            continue;
+        if (!d2d_array_reserve((void **)&out->edges, &out->size, out->count + 1, sizeof(*out->edges)))
+        {
+            out->hr = E_OUTOFMEMORY;
+            return;
+        }
+        e = &out->edges[out->count++];
+        if (a.y < b.y)
+        {
+            e->x0 = a.x; e->y0 = a.y; e->x1 = b.x; e->y1 = b.y; e->dir = flip ? -1 : 1;
+        }
+        else
+        {
+            e->x0 = b.x; e->y0 = b.y; e->x1 = a.x; e->y1 = a.y; e->dir = flip ? 1 : -1;
+        }
+        e->owner = 0;
+    }
+}
+
+static void widen_disc(struct widen_output *out, D2D1_POINT_2F c, float r, float tolerance)
+{
+    D2D1_POINT_2F p[64];
+    unsigned int i, n;
+
+    n = (unsigned int)ceil(M_PI / acos(max(-1.0, 1.0 - tolerance / max(r, 1e-6f))));
+    n = min(max(n, 8), ARRAY_SIZE(p));
+    for (i = 0; i < n; ++i)
+    {
+        p[i].x = c.x + r * cos(2.0 * M_PI * i / n);
+        p[i].y = c.y + r * sin(2.0 * M_PI * i / n);
+    }
+    widen_polygon(out, p, n);
+}
+
+static void widen_cap(struct widen_output *out, D2D1_POINT_2F end, double dx, double dy, float hw,
+        D2D1_CAP_STYLE cap, float tolerance)
+{
+    /* (dx, dy): the unit direction out of the end */
+    D2D1_POINT_2F p[4];
+
+    switch (cap)
+    {
+        case D2D1_CAP_STYLE_SQUARE:
+            p[0].x = end.x - dy * hw; p[0].y = end.y + dx * hw;
+            p[1].x = end.x + dy * hw; p[1].y = end.y - dx * hw;
+            p[2].x = p[1].x + dx * hw; p[2].y = p[1].y + dy * hw;
+            p[3].x = p[0].x + dx * hw; p[3].y = p[0].y + dy * hw;
+            widen_polygon(out, p, 4);
+            break;
+        case D2D1_CAP_STYLE_ROUND:
+            widen_disc(out, end, hw, tolerance);
+            break;
+        case D2D1_CAP_STYLE_TRIANGLE:
+            p[0].x = end.x - dy * hw; p[0].y = end.y + dx * hw;
+            p[1].x = end.x + dy * hw; p[1].y = end.y - dx * hw;
+            p[2].x = end.x + dx * hw; p[2].y = end.y + dy * hw;
+            widen_polygon(out, p, 3);
+            break;
+        default:
+            break;
+    }
+}
+
+static void widen_join(struct widen_output *out, D2D1_POINT_2F v, double d1x, double d1y, double d2x, double d2y,
+        float hw, D2D1_LINE_JOIN join, float miter_limit, float tolerance)
+{
+    double cross = d1x * d2y - d1y * d2x, n1x, n1y, n2x, n2y, mx, my, len;
+    D2D1_POINT_2F p[4];
+
+    if (fabs(cross) < 1e-9 && d1x * d2x + d1y * d2y > 0.0)
+        return;
+    if (join == D2D1_LINE_JOIN_ROUND)
+    {
+        widen_disc(out, v, hw, tolerance);
+        return;
+    }
+    /* the outer side's normals */
+    if (cross > 0.0)
+    {
+        n1x = d1y; n1y = -d1x; n2x = d2y; n2y = -d2x;
+    }
+    else
+    {
+        n1x = -d1y; n1y = d1x; n2x = -d2y; n2y = d2x;
+    }
+    p[0] = v;
+    p[1].x = v.x + n1x * hw; p[1].y = v.y + n1y * hw;
+    p[3].x = v.x + n2x * hw; p[3].y = v.y + n2y * hw;
+    mx = n1x + n2x;
+    my = n1y + n2y;
+    len = sqrt(mx * mx + my * my);
+    if ((join == D2D1_LINE_JOIN_MITER || join == D2D1_LINE_JOIN_MITER_OR_BEVEL) && len > 1e-9)
+    {
+        /* the miter's tip, (n1 + n2) scaled to reach both offset lines */
+        double k = 2.0 / (len * len);
+        double mlen = sqrt(2.0 / (len * len) * 2.0);
+
+        if (mlen <= miter_limit || join == D2D1_LINE_JOIN_MITER)
+        {
+            if (mlen > miter_limit)
+                k *= miter_limit / mlen;
+            p[2].x = v.x + mx * k * hw;
+            p[2].y = v.y + my * k * hw;
+            widen_polygon(out, p, 4);
+            return;
+        }
+    }
+    p[2] = p[3];
+    widen_polygon(out, p, 3);
+}
+
+HRESULT d2d_geometry_widen(ID2D1Geometry *geometry, float stroke_width, ID2D1StrokeStyle *stroke_style,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, ID2D1SimplifiedGeometrySink *sink)
+{
+    struct widen_input input = {{&widen_sink_vtbl}};
+    struct widen_output out = { 0 };
+    D2D1_STROKE_STYLE_PROPERTIES props = { D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT,
+                                           D2D1_LINE_JOIN_MITER, 10.0f, D2D1_DASH_STYLE_SOLID, 0.0f };
+    float hw = stroke_width / 2.0f;
+    size_t i, j;
+    HRESULT hr;
+
+    if (!sink)
+        return E_INVALIDARG;
+    if (tolerance <= 0.0f)
+        tolerance = D2D1_DEFAULT_FLATTENING_TOLERANCE;
+    if (stroke_style)
+    {
+        props.startCap = ID2D1StrokeStyle_GetStartCap(stroke_style);
+        props.endCap = ID2D1StrokeStyle_GetEndCap(stroke_style);
+        props.lineJoin = ID2D1StrokeStyle_GetLineJoin(stroke_style);
+        props.miterLimit = ID2D1StrokeStyle_GetMiterLimit(stroke_style);
+    }
+
+    if (FAILED(hr = ID2D1Geometry_Simplify(geometry, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_LINES, transform,
+            tolerance, &input.ID2D1SimplifiedGeometrySink_iface)) || FAILED(hr = input.hr))
+        goto done;
+
+    for (i = 0; i < input.figure_count; ++i)
+    {
+        struct widen_figure *f = &input.figures[i];
+        size_t n = f->count, segments;
+
+        if (!n)
+            continue;
+        if (n == 1)
+        {
+            /* a dot: its caps */
+            if (props.startCap == D2D1_CAP_STYLE_ROUND || props.startCap == D2D1_CAP_STYLE_SQUARE)
+                widen_cap(&out, f->points[0], 1.0, 0.0, hw, props.startCap, tolerance);
+            continue;
+        }
+        if (f->closed && f->points[n - 1].x == f->points[0].x && f->points[n - 1].y == f->points[0].y)
+            --n;
+        segments = f->closed ? n : n - 1;
+        for (j = 0; j < segments; ++j)
+        {
+            D2D1_POINT_2F a = f->points[j], b = f->points[(j + 1) % n], q[4];
+            double dx = b.x - a.x, dy = b.y - a.y, len = sqrt(dx * dx + dy * dy);
+
+            if (len < 1e-9)
+                continue;
+            dx /= len;
+            dy /= len;
+            q[0].x = a.x - dy * hw; q[0].y = a.y + dx * hw;
+            q[1].x = b.x - dy * hw; q[1].y = b.y + dx * hw;
+            q[2].x = b.x + dy * hw; q[2].y = b.y - dx * hw;
+            q[3].x = a.x + dy * hw; q[3].y = a.y - dx * hw;
+            widen_polygon(&out, q, 4);
+
+            /* the join with the next segment */
+            if (f->closed || j + 1 < segments)
+            {
+                D2D1_POINT_2F c = f->points[(j + 2) % n];
+                double ex = c.x - b.x, ey = c.y - b.y, elen = sqrt(ex * ex + ey * ey);
+
+                if (elen > 1e-9)
+                    widen_join(&out, b, dx, dy, ex / elen, ey / elen, hw, props.lineJoin, props.miterLimit, tolerance);
+            }
+            if (!f->closed && j == 0)
+                widen_cap(&out, a, -dx, -dy, hw, props.startCap, tolerance);
+            if (!f->closed && j + 1 == segments)
+                widen_cap(&out, b, dx, dy, hw, props.endCap, tolerance);
+        }
+    }
+    if (FAILED(hr = out.hr))
+        goto done;
+    hr = combine_run(out.edges, out.count, D2D1_FILL_MODE_WINDING, D2D1_FILL_MODE_ALTERNATE,
+            D2D1_COMBINE_MODE_UNION, sink);
+
+done:
+    for (i = 0; i < input.figure_count; ++i)
+        free(input.figures[i].points);
+    free(input.figures);
