+/* CombineWithGeometry: the union, intersection, symmetric difference or
+ * difference of two geometries' filled areas.
+ *
+ * Both geometries are flattened to polygons (through Simplify). The plane is
+ * cut into horizontal slabs at every vertex and every crossing of two edges,
+ * so that inside a slab no two edges cross; across a slab the edges are in a
+ * fixed left-to-right order, and walking them, counting each geometry's
+ * winding by its fill mode, gives the intervals where the combination is
+ * filled. An interval between the same two edges in consecutive slabs is
+ * the same polygon grown downwards; the polygons are written to the sink
+ * when they end. They do not overlap. */
+
+struct combine_edge
+{
+    double x0, y0, x1, y1;      /* y0 < y1 */
+    int dir;                    /* +1 drawn downwards, -1 upwards */
+    int owner;                  /* 0: the geometry, 1: the other */
+};
+
+struct combine_input
+{
+    ID2D1SimplifiedGeometrySink ID2D1SimplifiedGeometrySink_iface;
+    D2D1_FILL_MODE fill_mode;
+    struct combine_edge *edges;
+    size_t edge_count, edge_size;
+    D2D1_POINT_2F start, last;
+    BOOL in_figure;
+    int owner;
+    HRESULT hr;
+};
+
+static struct combine_input *impl_from_sink(ID2D1SimplifiedGeometrySink *iface)
+{
+    return CONTAINING_RECORD(iface, struct combine_input, ID2D1SimplifiedGeometrySink_iface);
+}
+
+static void combine_add_edge(struct combine_input *input, D2D1_POINT_2F a, D2D1_POINT_2F b)
+{
+    struct combine_edge *e;
+
+    if (a.y == b.y)
+        return;
+    if (!d2d_array_reserve((void **)&input->edges, &input->edge_size, input->edge_count + 1, sizeof(*input->edges)))
+    {
+        input->hr = E_OUTOFMEMORY;
+        return;
+    }
+    e = &input->edges[input->edge_count++];
+    if (a.y < b.y)
+    {
+        e->x0 = a.x; e->y0 = a.y; e->x1 = b.x; e->y1 = b.y; e->dir = 1;
+    }
+    else
+    {
+        e->x0 = b.x; e->y0 = b.y; e->x1 = a.x; e->y1 = a.y; e->dir = -1;
+    }
+    e->owner = input->owner;
+}
+
+static HRESULT STDMETHODCALLTYPE combine_sink_QueryInterface(ID2D1SimplifiedGeometrySink *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_ID2D1SimplifiedGeometrySink) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
