+
+/* The rectangles an effect graph produces, in pixels. An effect's output
+ * rectangle comes from its transform graph: each node maps the rectangles
+ * of its inputs to its output's (draw transforms say so themselves through
+ * MapInputRectsToOutputRect), up to the graph's output node. A built-in
+ * effect's is worked out here from its properties. */
+
+static const D2D1_RECT_L infinite_rect = { LONG_MIN, LONG_MIN, LONG_MAX, LONG_MAX };
+static const D2D1_RECT_L empty_rect = { 0, 0, 0, 0 };
+
+static BOOL rect_l_is_empty(const D2D1_RECT_L *r)
+{
+    return r->left >= r->right || r->top >= r->bottom;
+}
+
+static void rect_l_union(D2D1_RECT_L *dst, const D2D1_RECT_L *src)
+{
+    if (rect_l_is_empty(src)) return;
+    if (rect_l_is_empty(dst))
+    {
+        *dst = *src;
+        return;
+    }
+    dst->left = min(dst->left, src->left);
+    dst->top = min(dst->top, src->top);
+    dst->right = max(dst->right, src->right);
+    dst->bottom = max(dst->bottom, src->bottom);
+}
+
+static void rect_l_intersect(D2D1_RECT_L *dst, const D2D1_RECT_L *src)
+{
+    dst->left = max(dst->left, src->left);
+    dst->top = max(dst->top, src->top);
+    dst->right = min(dst->right, src->right);
+    dst->bottom = min(dst->bottom, src->bottom);
+    if (rect_l_is_empty(dst)) *dst = empty_rect;
+}
+
+static LONG clamp_to_long(double v)
+{
+    if (v <= LONG_MIN) return LONG_MIN;
+    if (v >= LONG_MAX) return LONG_MAX;
+    return (LONG)v;
+}
+
+/* grow by a margin, keeping infinite edges infinite */
+static void rect_l_inflate(D2D1_RECT_L *r, double dx, double dy)
+{
+    if (rect_l_is_empty(r)) return;
+    if (r->left != LONG_MIN) r->left = clamp_to_long(floor(r->left - dx));
+    if (r->top != LONG_MIN) r->top = clamp_to_long(floor(r->top - dy));
+    if (r->right != LONG_MAX) r->right = clamp_to_long(ceil(r->right + dx));
+    if (r->bottom != LONG_MAX) r->bottom = clamp_to_long(ceil(r->bottom + dy));
+}
+
+static void rect_l_offset(D2D1_RECT_L *r, LONG dx, LONG dy)
+{
+    if (rect_l_is_empty(r)) return;
+    if (r->left != LONG_MIN) r->left = clamp_to_long((double)r->left + dx);
+    if (r->top != LONG_MIN) r->top = clamp_to_long((double)r->top + dy);
+    if (r->right != LONG_MAX) r->right = clamp_to_long((double)r->right + dx);
+    if (r->bottom != LONG_MAX) r->bottom = clamp_to_long((double)r->bottom + dy);
+}
+
+/* the bounding box of a rectangle under an affine transform */
+static void rect_l_transform(D2D1_RECT_L *r, const D2D1_MATRIX_3X2_F *m)
+{
+    double x[4], y[4], l, t, rt, b;
+    unsigned int i;
+
+    if (rect_l_is_empty(r)) return;
+    if (r->left == LONG_MIN || r->top == LONG_MIN || r->right == LONG_MAX || r->bottom == LONG_MAX)
+    {
+        *r = infinite_rect;
+        return;
+    }
+    x[0] = r->left;  y[0] = r->top;
+    x[1] = r->right; y[1] = r->top;
+    x[2] = r->left;  y[2] = r->bottom;
+    x[3] = r->right; y[3] = r->bottom;
+    l = t = HUGE_VAL;
+    rt = b = -HUGE_VAL;
+    for (i = 0; i < 4; ++i)
+    {
+        double tx = x[i] * m->_11 + y[i] * m->_21 + m->_31;
+        double ty = x[i] * m->_12 + y[i] * m->_22 + m->_32;
+        l = min(l, tx); rt = max(rt, tx);
+        t = min(t, ty); b = max(b, ty);
+    }
+    r->left = clamp_to_long(floor(l));
+    r->top = clamp_to_long(floor(t));
+    r->right = clamp_to_long(ceil(rt));
+    r->bottom = clamp_to_long(ceil(b));
+}
+
+struct d2d_effect *d2d_effect_from_image(ID2D1Image *image);
+
+static HRESULT d2d_effect_output_rect(struct d2d_effect *effect, const D2D1_RECT_L *inputs, unsigned int depth,
+        D2D1_RECT_L *rect);
+
+/* the rectangle an image covers, in pixels */
+HRESULT d2d_image_get_rect(ID2D1Image *image, unsigned int depth, D2D1_RECT_L *rect)
+{
+    struct d2d_effect *effect;
+    ID2D1Bitmap *bitmap;
+
+    *rect = empty_rect;
+    if (!image)
+        return S_OK;
+    if (depth > 64)
+        return E_FAIL;
+
+    if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1Bitmap, (void **)&bitmap)))
+    {
+        D2D1_SIZE_U size = ID2D1Bitmap_GetPixelSize(bitmap);
+
+        rect->right = size.width;
+        rect->bottom = size.height;
+        ID2D1Bitmap_Release(bitmap);
+        return S_OK;
+    }
+    if ((effect = d2d_effect_from_image(image)))
+        return d2d_effect_output_rect(effect, NULL, depth + 1, rect);
+
+    /* a command list: its extent is not tracked */
+    *rect = infinite_rect;
+    return S_OK;
+}
+
+static BOOL get_float(struct d2d_effect *effect, UINT32 index, float *value)
+{
+    return SUCCEEDED(ID2D1Effect_GetValue(&effect->ID2D1Effect_iface, index, D2D1_PROPERTY_TYPE_FLOAT,
+            (BYTE *)value, sizeof(*value)));
+}
+
+static BOOL get_uint(struct d2d_effect *effect, UINT32 index, D2D1_PROPERTY_TYPE type, UINT32 *value)
+{
+    return SUCCEEDED(ID2D1Effect_GetValue(&effect->ID2D1Effect_iface, index, type, (BYTE *)value, sizeof(*value)));
+}
+
+static BOOL get_floats(struct d2d_effect *effect, UINT32 index, D2D1_PROPERTY_TYPE type, float *values, UINT32 count)
+{
+    return SUCCEEDED(ID2D1Effect_GetValue(&effect->ID2D1Effect_iface, index, type, (BYTE *)values,
+            count * sizeof(*values)));
+}
+
+/* a built-in effect's output rectangle, from its inputs' */
+static void d2d_builtin_output_rect(struct d2d_effect *effect, const D2D1_RECT_L *inputs, D2D1_RECT_L *rect)
+{
+    const GUID *id = &effect->id;
+    unsigned int i;
+    float f, v[6];
+    UINT32 u, w;
+
+    *rect = effect->input_count ? inputs[0] : empty_rect;
+
+    if (IsEqualGUID(id, &CLSID_D2D1Flood) || IsEqualGUID(id, &CLSID_D2D1Turbulence)
+            || IsEqualGUID(id, &CLSID_D2D1Border) || IsEqualGUID(id, &CLSID_D2D1Tile))
+    {
+        *rect = infinite_rect;
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1Composite) || IsEqualGUID(id, &CLSID_D2D1Blend)
+            || IsEqualGUID(id, &CLSID_D2D1ArithmeticComposite) || IsEqualGUID(id, &CLSID_D2D1CrossFade))
+    {
+        for (i = 1; i < effect->input_count; ++i)
+            rect_l_union(rect, &inputs[i]);
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1AlphaMask))
+    {
+        if (effect->input_count > 1)
+            rect_l_intersect(rect, &inputs[1]);
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1Crop) || IsEqualGUID(id, &CLSID_D2D1Atlas))
+    {
+        if (get_floats(effect, 0, D2D1_PROPERTY_TYPE_VECTOR4, v, 4) && (v[0] < v[2] && v[1] < v[3]))
+        {
+            D2D1_RECT_L crop = { clamp_to_long(floor(v[0])), clamp_to_long(floor(v[1])),
+                                 clamp_to_long(ceil(v[2])), clamp_to_long(ceil(v[3])) };
+            rect_l_intersect(rect, &crop);
+        }
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1GaussianBlur) || IsEqualGUID(id, &CLSID_D2D1Shadow))
+    {
+        if (!get_float(effect, 0, &f)) f = 3.0f;
+        rect_l_inflate(rect, 3.0 * f, 3.0 * f);
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1DirectionalBlur))
+    {
+        if (!get_float(effect, 0, &f)) f = 3.0f;
+        rect_l_inflate(rect, 3.0 * f, 3.0 * f);
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1Morphology))
+    {
+        if (!get_uint(effect, 1, D2D1_PROPERTY_TYPE_UINT32, &u)) u = 1;
+        if (!get_uint(effect, 2, D2D1_PROPERTY_TYPE_UINT32, &w)) w = 1;
+        rect_l_inflate(rect, u / 2.0, w / 2.0);
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1ConvolveMatrix) || IsEqualGUID(id, &CLSID_D2D1EdgeDetection)
+            || IsEqualGUID(id, &CLSID_D2D1Emboss) || IsEqualGUID(id, &CLSID_D2D1Sharpen))
+    {
+        rect_l_inflate(rect, 1.0, 1.0);
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1Scale))
+    {
+        D2D1_MATRIX_3X2_F m;
+        if (get_floats(effect, 0, D2D1_PROPERTY_TYPE_VECTOR2, v, 2)
+                && get_floats(effect, 1, D2D1_PROPERTY_TYPE_VECTOR2, v + 2, 2))
+        {
+            m._11 = v[0]; m._12 = 0.0f; m._21 = 0.0f; m._22 = v[1];
+            m._31 = v[2] - v[2] * v[0]; m._32 = v[3] - v[3] * v[1];
+            rect_l_transform(rect, &m);
+        }
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D12DAffineTransform))
+    {
+        D2D1_MATRIX_3X2_F m;
+        if (get_floats(effect, 2, D2D1_PROPERTY_TYPE_MATRIX_3X2, (float *)&m, 6))
+            rect_l_transform(rect, &m);
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D13DTransform) || IsEqualGUID(id, &CLSID_D2D13DPerspectiveTransform)
+            || IsEqualGUID(id, &CLSID_D2D1Straighten))
+    {
+        /* projected: not worked out */
+        if (!rect_l_is_empty(rect)) *rect = infinite_rect;
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1DpiCompensation))
+    {
+        if (get_float(effect, 2, &f) && f > 0.0f)
+        {
+            D2D1_MATRIX_3X2_F m = {{{ 96.0f / f, 0.0f, 0.0f, 96.0f / f, 0.0f, 0.0f }}};
+            rect_l_transform(rect, &m);
+        }
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1BitmapSource))
+    {
+        IWICBitmapSource *source = NULL;
+        UINT width, height;
+
+        *rect = empty_rect;
+        if (SUCCEEDED(ID2D1Effect_GetValue(&effect->ID2D1Effect_iface, 0, D2D1_PROPERTY_TYPE_IUNKNOWN,
+                (BYTE *)&source, sizeof(source))) && source)
+        {
+            if (SUCCEEDED(IWICBitmapSource_GetSize(source, &width, &height)))
+            {
+                if (!get_floats(effect, 1, D2D1_PROPERTY_TYPE_VECTOR2, v, 2)) v[0] = v[1] = 1.0f;
+                rect->right = clamp_to_long(ceil(width * v[0]));
+                rect->bottom = clamp_to_long(ceil(height * v[1]));
+            }
+            IWICBitmapSource_Release(source);
+        }
+    }
+    /* everything else works pixel by pixel on its first input */
+}
+
+static struct d2d_transform_node *graph_input_owner(struct d2d_transform_graph *graph,
+        struct d2d_transform_node *node, unsigned int index, unsigned int *input)
+{
+    unsigned int i;
+
+    for (i = 0; i < graph->input_count; ++i)
+    {
+        if (graph->inputs[i].node == node && graph->inputs[i].index == index)
+        {
+            *input = i;
+            return node;
+        }
+    }
+    return NULL;
+}
+
+static HRESULT d2d_node_output_rect(struct d2d_effect *effect, struct d2d_transform_node *node,
+        const D2D1_RECT_L *inputs, unsigned int depth, D2D1_RECT_L *rect)
+{
+    struct d2d_transform_graph *graph = effect->graph;
+    D2D1_RECT_L stack_rects[8], *rects = stack_rects, *opaque = NULL, opaque_out;
+    ID2D1BoundsAdjustmentTransform *bounds_adjustment;
+    ID2D1OffsetTransform *offset_transform;
+    ID2D1BlendTransform *blend;
+    ID2D1BorderTransform *border;
+    ID2D1Transform *transform;
+    struct d2d_effect *nested;
+    unsigned int i, input;
+    HRESULT hr = S_OK;
+
+    *rect = empty_rect;
+    if (depth > 64)
+        return E_FAIL;
+
+    if (node->input_count > ARRAY_SIZE(stack_rects)
+            && !(rects = calloc(node->input_count, sizeof(*rects))))
+        return E_OUTOFMEMORY;
+
+    for (i = 0; i < node->input_count; ++i)
+    {
+        if (node->inputs[i])
+            hr = d2d_node_output_rect(effect, node->inputs[i], inputs, depth + 1, &rects[i]);
+        else if (graph_input_owner(graph, node, i, &input))
+            rects[i] = inputs[input];
+        else
+            rects[i] = empty_rect;
+        if (FAILED(hr))
+            goto done;
+    }
+
+    if ((nested = d2d_effect_from_transform_node(node->object)))
+    {
+        hr = d2d_effect_output_rect(nested, rects, depth + 1, rect);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1Transform, (void **)&transform)))
+    {
+        if (node->input_count && !(opaque = calloc(node->input_count, sizeof(*opaque))))
+            hr = E_OUTOFMEMORY;
+        else
+            hr = ID2D1Transform_MapInputRectsToOutputRect(transform, rects, opaque, node->input_count,
+                    rect, &opaque_out);
+        free(opaque);
+        ID2D1Transform_Release(transform);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1OffsetTransform,
+            (void **)&offset_transform)))
+    {
+        D2D1_POINT_2L offset = ID2D1OffsetTransform_GetOffset(offset_transform);
+
+        *rect = node->input_count ? rects[0] : empty_rect;
+        rect_l_offset(rect, offset.x, offset.y);
+        ID2D1OffsetTransform_Release(offset_transform);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1BoundsAdjustmentTransform,
+            (void **)&bounds_adjustment)))
+    {
+        ID2D1BoundsAdjustmentTransform_GetOutputBounds(bounds_adjustment, rect);
+        ID2D1BoundsAdjustmentTransform_Release(bounds_adjustment);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1BorderTransform, (void **)&border)))
+    {
+        *rect = infinite_rect;
+        ID2D1BorderTransform_Release(border);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1BlendTransform, (void **)&blend)))
+    {
+        for (i = 0; i < node->input_count; ++i)
+            rect_l_union(rect, &rects[i]);
+        ID2D1BlendTransform_Release(blend);
+    }
+    else
+    {
+        FIXME("Unhandled node %p.\n", node->object);
+        *rect = node->input_count ? rects[0] : empty_rect;
+    }
+
+done:
+    if (rects != stack_rects)
+        free(rects);
+    return hr;
+}
+
+/* an effect's output rectangle; its inputs' rectangles are given when it is a node of another graph */
+static HRESULT d2d_effect_output_rect(struct d2d_effect *effect, const D2D1_RECT_L *given_inputs, unsigned int depth,
+        D2D1_RECT_L *rect)
+{
+    D2D1_RECT_L stack_rects[8], *inputs = stack_rects;
+    struct d2d_transform_graph *graph = effect->graph;
+    HRESULT hr = S_OK;
+    unsigned int i;
+
+    *rect = empty_rect;
+    if (depth > 64)
+        return E_FAIL;
+
+    if (given_inputs)
+        inputs = (D2D1_RECT_L *)given_inputs;
+    else
+    {
+        if (effect->input_count > ARRAY_SIZE(stack_rects)
+                && !(inputs = calloc(effect->input_count, sizeof(*inputs))))
+            return E_OUTOFMEMORY;
+        for (i = 0; i < effect->input_count && SUCCEEDED(hr); ++i)
+            hr = d2d_image_get_rect(effect->inputs[i], depth + 1, &inputs[i]);
+        if (FAILED(hr))
+            goto done;
+    }
+
+    if (effect->builtin)
+    {
+        d2d_builtin_output_rect(effect, inputs, rect);
+        goto done;
+    }
+
+    /* the effect sets its transforms up for its current properties */
+    if (effect->impl)
+        ID2D1EffectImpl_PrepareForRender(effect->impl, D2D1_CHANGE_TYPE_NONE);
+
+    if (!graph)
+        *rect = empty_rect;
+    else if (graph->passthrough)
+        *rect = graph->passthrough_input < effect->input_count ? inputs[graph->passthrough_input] : empty_rect;
+    else if (graph->output)
+        hr = d2d_node_output_rect(effect, graph->output, inputs, depth + 1, rect);
+
+done:
+    if (inputs != stack_rects && inputs != given_inputs)
+        free(inputs);
+    return hr;
+}
+
+HRESULT d2d_effect_get_rect(struct d2d_effect *effect, D2D1_RECT_L *rect)
+{
+    return d2d_effect_output_rect(effect, NULL, 0, rect);
+}
