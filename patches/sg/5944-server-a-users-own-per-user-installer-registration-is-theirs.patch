From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: a user's own per-user Windows Installer registration is theirs (5944)

server: a user's own per-user Windows Installer registration is theirs

Python 3.13 from the SG Store failed at once ("The installer stopped with
code 5"): its per-user ("just for me") MSI packages ended in
ERROR_ACCESS_DENIED. On Windows the Installer service writes a user's
per-user registration, HKLM\Software\Microsoft\Windows\CurrentVersion\
Installer\UserData\<SID>, as SYSTEM; Wine's msi runs in the installing
process, as the user, and since 3764 (10.0-427) the machine default (Users
read) refused it -- and a key of it, once saved, comes back from system.reg
without a descriptor, so every later per-user install of that user failed.

A user account (S-1-5-21-...) may now create its own SID's key in UserData
(object.c's container check and registry.c's parent check: only that name,
not another user's, so nobody can take another user's subtree ahead of them)
and use what is below it (the keys without a descriptor there are not checked
against the machine default for that user). UserData itself is made by the
prefix (wine.inf), so no user owns it. Gate test-msiperuser (with 5945);
mutant SG_MUTANT_USERDATA_READONLY.
---
--- a/server/registry.c
+++ b/server/registry.c
@@ -589,6 +589,77 @@
     return 0;
 }
 
+/* Stained Glass OS: a user's own per-user Windows Installer registration, HKLM\Software\Microsoft\
+ * Windows\CurrentVersion\Installer\UserData\<the user's SID> and below. On Windows the Installer
+ * service (SYSTEM) writes it for the user; Wine's msi runs in the installing process, as the user,
+ * and a package installed "just for me" (Python 3.13 from the SG Store) failed with
+ * ERROR_ACCESS_DENIED: UserData, under the machine default (Users read), refused the user's subtree,
+ * and once a key of it is saved it comes back from system.reg without a descriptor -- every later
+ * per-user install of that user would fail. A user account (S-1-5-21-...) may create its own SID's
+ * key in UserData (sg_may_create_key_in) and use what is below it; another user's subtree, and
+ * UserData itself (made by the prefix, wine.inf), keep the machine default. */
+static const char sg_userdata_path[] = "\\Registry\\Machine\\Software\\Microsoft\\Windows\\CurrentVersion\\Installer\\UserData";
+
+/* the caller's user SID as "S-1-5-21-...", its length; 0 unless a user account's */
+static int sg_caller_user_sid( char *buf, int size )
+{
+    unsigned long long auth = 0;
+    const struct sid *sid;
+    struct token *token;
+    unsigned int i;
+    int n;
+
+#ifdef SG_MUTANT_USERDATA_READONLY
+    return 0;
+#endif
+    if (!current) return 0;
+    token = current->token ? current->token : current->process->token;
+    if (!token || !(sid = token_get_user( token ))) return 0;
+    if (sid->sub_count < 2 || sid->sub_auth[0] != 21) return 0;  /* never SYSTEM's or a well-known account's */
+    for (i = 0; i < 6; i++) auth = (auth << 8) | sid->id_auth[i];
+    n = snprintf( buf, size, "S-%u-%llu", sid->revision, auth );
+    for (i = 0; i < sid->sub_count && n > 0 && n < size; i++) n += snprintf( buf + n, size - n, "-%u", sid->sub_auth[i] );
+    return n > 0 && n < size ? n : 0;
+}
+
+/* whether name[0..n) is str, case aside */
+static int sg_name_is( const WCHAR *name, const char *str, data_size_t n )
+{
+    data_size_t i;
+    for (i = 0; i < n; i++)
+        if (name[i] >= 0x80 || toupper( name[i] ) != toupper( (unsigned char)str[i] )) return 0;
+    return 1;
+}
+
+static int sg_is_own_installer_userdata( const WCHAR *name, data_size_t len )
+{
+    data_size_t chars = len / sizeof(WCHAR), p = sizeof(sg_userdata_path) - 1;
+    char sid[160];
+    int n;
+
+    if (chars <= p + 1 || name[p] != '\\' || !sg_name_is( name, sg_userdata_path, p )) return 0;
+    if (!(n = sg_caller_user_sid( sid, sizeof(sid) )) || chars < p + 1 + n) return 0;
+    if (chars > p + 1 + n && name[p + 1 + n] != '\\') return 0;
+    return sg_name_is( name + p + 1, sid, n );
+}
+
+/* whether the caller may create NAME in OBJ although OBJ refuses it: its own SID's key in UserData */
+int sg_may_create_key_in( struct object *obj, const struct unicode_str *name )
+{
+    data_size_t len = 0, p = sizeof(sg_userdata_path) - 1, chars = name->len / sizeof(WCHAR);
+    char sid[160];
+    WCHAR *full;
+    int n, ret;
+
+    if (!sg_system_prefix || obj->ops != &key_ops || !(n = sg_caller_user_sid( sid, sizeof(sid) ))) return 0;
+    if (chars < (data_size_t)n || (chars > (data_size_t)n && name->str[n] != '\\') || !sg_name_is( name->str, sid, n ))
+        return 0;
+    if (!(full = obj->ops->get_full_name( obj, &len ))) return 0;
+    ret = len == p * sizeof(WCHAR) && sg_name_is( full, sg_userdata_path, p );
+    free( full );
+    return ret;
+}
+
 static int sg_is_display_config_key( struct object *obj )
 {
     data_size_t len = 0;
@@ -622,7 +693,8 @@
     if (!(name = default_get_full_name( obj, &len ))) return NULL;
     machine = len >= sizeof(machineW) && !memicmp_strW( name, machineW, sizeof(machineW) ) &&
               (len == sizeof(machineW) || name[ARRAY_SIZE(machineW)] == '\\');
-    if (machine && (sg_is_display_config_name( name, len ) || sg_is_office_c2r_name( name, len ))) machine = 0;
+    if (machine && (sg_is_display_config_name( name, len ) || sg_is_office_c2r_name( name, len ) ||
+                    sg_is_own_installer_userdata( name, len ))) machine = 0;
     free( name );
     return machine ? sg_machine_key_sd() : NULL;
 }
@@ -893,9 +965,16 @@
                 struct token *tok = current->token ? current->token : current->process->token;
                 if (pk && pk->obj.sd && !check_object_access( tok, &pk->obj, &req ))
                 {
-                    unlink_named_object( &key->obj );
-                    release_object( key );
-                    return NULL;   /* STATUS_ACCESS_DENIED already set */
+                    struct unicode_str own;
+                    /* a user's own per-user Windows Installer registration (sg_may_create_key_in) */
+                    own.str = get_object_name( &key->obj, &own.len );
+                    if (own.str && sg_may_create_key_in( &pk->obj, &own )) clear_error();
+                    else
+                    {
+                        unlink_named_object( &key->obj );
+                        release_object( key );
+                        return NULL;   /* STATUS_ACCESS_DENIED already set */
+                    }
                 }
             }
             if (options & REG_OPTION_CREATE_LINK) key->flags |= KEY_SYMLINK;
--- a/server/object.c
+++ b/server/object.c
@@ -519,8 +519,13 @@
             unsigned int access = obj->ops->map_access( obj, GENERIC_WRITE );
             if (!check_object_access( NULL, obj, &access ))
             {
-                release_object( obj );
-                return NULL;
+                /* a user's own per-user Windows Installer registration (sg_may_create_key_in) */
+                if (sg_may_create_key_in( obj, &new_name )) clear_error();
+                else
+                {
+                    release_object( obj );
+                    return NULL;
+                }
             }
         }
 
--- a/server/security.h
+++ b/server/security.h
@@ -52,6 +52,8 @@
  * sg_system_prefix_uid is the owner of a shared prefix -- see request.c. */
 extern int sg_system_prefix;
 extern const struct security_descriptor *sg_key_default_sd( struct object *obj );
+struct unicode_str;
+extern int sg_may_create_key_in( struct object *obj, const struct unicode_str *name );
 extern const struct security_descriptor *sg_machine_key_sd(void);
 extern uid_t sg_system_prefix_uid;
 extern struct token *token_create_for_uid( unsigned primary, int impersonation_level,
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -548,6 +548,8 @@
 HKLM,%CurrentVersion%\Explorer\KindMap,,16
 HKLM,%CurrentVersion%\Group Policy,,16
 HKLM,%CurrentVersion%\Installer,"InstallerLocation",,"%11%"
+;; Stained Glass OS: made by the prefix, so no user owns it; each user may make their SID's key in it (wine-sg 5944)
+HKLM,%CurrentVersion%\Installer\UserData,,16
 HKLM,%CurrentVersion%\Policies\System,"EnableLUA",0x10001,1
 HKLM,%CurrentVersion%\PreviewHandlers,,16
 HKLM,%CurrentVersion%\Run,,16
