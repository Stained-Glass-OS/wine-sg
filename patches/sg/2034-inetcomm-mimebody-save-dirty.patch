+    char *text;
+    size_t length;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, pcbSize);
+
+    if (!pcbSize)
+        return E_INVALIDARG;
+    if (FAILED(hr = body_header_text(This, &text, &length)))
+        return hr;
+    free(text);
+    if (This->data) get_stream_size(This->data, &data_size);
+
+    pcbSize->QuadPart = length + 2 + data_size.QuadPart;
+    return S_OK;
 }
 
