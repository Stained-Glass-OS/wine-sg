From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] inetcomm: IMimeBody Save, IsDirty, GetSizeMax (2034)

IMimeBody keeps a dirty flag (set by SetProp, DeleteProp, SetData,
EmptyData, SetCurrentEncoding, SetCharset; cleared by InitNew, Load and
Save with clear) answered by IsDirty. Save writes the headers (one line
each, parameters after the value with quotes where needed; the object's
att:/par: properties are not headers; Content-Type follows the type set by
SetData), an empty line, then the data as stored; GetSizeMax is the size
Save would write.
---
--- a/dlls/inetcomm/mimeole.c
+++ b/dlls/inetcomm/mimeole.c
@@ -148,6 +148,12 @@
     struct list params;
 } header_t;
 
+#ifdef SG_MUTANT_BODY_DIRTY
+#define MIMEBODY_SET_DIRTY(b) ((void)0)
+#else
+#define MIMEBODY_SET_DIRTY(b) ((b)->dirty = TRUE)
+#endif
+
 typedef struct MimeBody
 {
     IMimeBody IMimeBody_iface;
@@ -164,6 +170,7 @@
     void *data;
     IID data_iid;
     BODYOFFSETS body_offsets;
+    BOOL dirty;
 } MimeBody;
 
 typedef struct
@@ -976,22 +983,149 @@
                               IMimeBody* iface)
 {
     MimeBody *This = impl_from_IMimeBody(iface);
-    FIXME("(%p)->() stub\n", This);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->()\n", This);
+
+    return This->dirty ? S_OK : S_FALSE;
 }
 
 static HRESULT WINAPI MimeBody_Load(IMimeBody *iface, IStream *pStm)
 {
     MimeBody *This = impl_from_IMimeBody(iface);
+    HRESULT hr;
+
     TRACE("(%p)->(%p)\n", This, pStm);
-    return parse_headers(This, pStm);
+
+    hr = parse_headers(This, pStm);
+    if (SUCCEEDED(hr)) This->dirty = FALSE;
+    return hr;
+}
+
+/* A parameter value needs quotes when it is empty or has a character that
+ * is not allowed in a token. */
+static BOOL param_needs_quotes(const char *value)
+{
+    if (!*value) return TRUE;
+    for (; *value; value++)
+        if (*value <= ' ' || *value >= 0x7f || strchr("()<>@,;:\\\"/[]?=", *value)) return TRUE;
+    return FALSE;
+}
+
+static char *append_text(char *buf, size_t *len, size_t *cap, const char *text, size_t n)
+{
+    if (!buf) return NULL;
+    if (*len + n + 1 > *cap)
+    {
+        char *bigger;
+        *cap = (*len + n + 1) * 2;
+        if (!(bigger = realloc(buf, *cap))) { free(buf); return NULL; }
+        buf = bigger;
+    }
+    memcpy(buf + *len, text, n);
+    *len += n;
+    buf[*len] = 0;
+    return buf;
+}
+
+/* The header text of a body: one line to a header, parameters after the value. */
+static HRESULT body_header_text(MimeBody *body, char **text, size_t *length)
+{
+    size_t len = 0, cap = 256;
+    char *buf = malloc(cap);
+    header_t *header;
+    param_t *param;
+
+    if (!buf) return E_OUTOFMEMORY;
+    buf[0] = 0;
+
+    LIST_FOR_EACH_ENTRY(header, &body->headers, header_t, entry)
+    {
+        const char *name = header->prop->name;
+        PROPVARIANT converted;
+        const char *value = "";
+        char *content_type = NULL;
+
+        /* properties of the object (att:, par:) are not headers */
+        if (!strncasecmp(name, "att:", 4) || !strncasecmp(name, "par:", 4)) continue;
+
+        PropVariantInit(&converted);
+        if (header->value.vt == VT_LPSTR && header->value.pszVal)
+            value = header->value.pszVal;
+        else if (SUCCEEDED(PropVariantChangeType(&converted, &header->value, 0, VT_LPSTR)) && converted.pszVal)
+            value = converted.pszVal;
+
+#ifndef SG_MUTANT_BODY_SAVE_TYPE
+        if (header->prop->id == PID_HDR_CNTTYPE && body->content_pri_type && body->content_sub_type)
+        {
+            content_type = malloc(strlen(body->content_pri_type) + strlen(body->content_sub_type) + 2);
+            sprintf(content_type, "%s/%s", body->content_pri_type, body->content_sub_type);
+            value = content_type;
+        }
+#endif
+
+        buf = append_text(buf, &len, &cap, name, strlen(name));
+        buf = append_text(buf, &len, &cap, ": ", 2);
+        buf = append_text(buf, &len, &cap, value, strlen(value));
+        LIST_FOR_EACH_ENTRY(param, &header->params, param_t, entry)
+        {
+            buf = append_text(buf, &len, &cap, "; ", 2);
+            buf = append_text(buf, &len, &cap, param->name, strlen(param->name));
+            buf = append_text(buf, &len, &cap, "=", 1);
+            if (param_needs_quotes(param->value))
+            {
+                const char *c;
+                buf = append_text(buf, &len, &cap, "\"", 1);
+                for (c = param->value; *c; c++)
+                {
+                    if (*c == '"' || *c == '\\') buf = append_text(buf, &len, &cap, "\\", 1);
+                    buf = append_text(buf, &len, &cap, c, 1);
+                }
+                buf = append_text(buf, &len, &cap, "\"", 1);
+            }
+            else
+                buf = append_text(buf, &len, &cap, param->value, strlen(param->value));
+        }
+        buf = append_text(buf, &len, &cap, "\r\n", 2);
+        PropVariantClear(&converted);
+        free(content_type);
+        if (!buf) return E_OUTOFMEMORY;
+    }
+
+    *text = buf;
+    *length = len;
+    return S_OK;
 }
 
 static HRESULT WINAPI MimeBody_Save(IMimeBody *iface, IStream *pStm, BOOL fClearDirty)
 {
     MimeBody *This = impl_from_IMimeBody(iface);
-    FIXME("(%p)->(%p, %d)\n", This, pStm, fClearDirty);
-    return E_NOTIMPL;
+    char *text = NULL, buf[4096];
+    size_t length;
+    IStream *data;
+    ULONG written, read;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p, %d)\n", This, pStm, fClearDirty);
+
+    if (!pStm)
+        return E_INVALIDARG;
+    if (FAILED(hr = body_header_text(This, &text, &length)))
+        return hr;
+
+    /* the headers, an empty line, and the data as it is stored */
+    hr = IStream_Write(pStm, text, length, &written);
+    free(text);
+    if (SUCCEEDED(hr)) hr = IStream_Write(pStm, "\r\n", 2, &written);
+    if (SUCCEEDED(hr) && This->data && SUCCEEDED(IMimeBody_GetData(iface, This->encoding, &data)))
+    {
+        while (SUCCEEDED(hr = IStream_Read(data, buf, sizeof(buf), &read)) && read)
+            if (FAILED(hr = IStream_Write(pStm, buf, read, &written))) break;
+        IStream_Release(data);
+    }
+    if (FAILED(hr)) return hr;
+
+    if (fClearDirty) This->dirty = FALSE;
+    return S_OK;
 }
 
