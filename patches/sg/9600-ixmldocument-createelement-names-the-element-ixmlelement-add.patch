From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msxml3: IXMLDocument::createElement names the element, IXMLElement::addChild places it (9600)

The IE4/IE5 XML object model (CLSID_XMLDocument) is what old programs
and HTML help pages script when they build XML. createElement ignored its
second argument, the tag name (or a processing instruction's target), so
every element it made was nameless and a saved document lost its tags.
addChild treated any index but 0 as "add the element as a sibling of the
child's last child". The name is now set for element and processing
instruction nodes, and addChild inserts the child before the one at the
index it is given (-1 or past the end: appended). put_text on an element
and GetSizeMax stay E_NOTIMPL: Wine's conformance tests show Windows
returns that.
---
--- a/dlls/msxml3/xmldoc.c
+++ b/dlls/msxml3/xmldoc.c
@@ -607,7 +607,23 @@
     node = xmlNewNode(NULL, empty);
     node->type = type_msxml_to_libxml(V_I4(&vType));
 
-    /* FIXME: create xmlNodePtr based on vType and var1 */
+    /* var1 is the optional tag name (VT_BSTR) of an element or the target of a
+     * processing instruction; other node types have no name. */
+#ifndef SG_MUTANT_XMLDOC_NONAME
+    if (V_VT(&var1) == VT_BSTR && V_BSTR(&var1) && *V_BSTR(&var1) &&
+        (node->type == XML_ELEMENT_NODE || node->type == XML_PI_NODE))
+    {
+        xmlChar *name = xmlchar_from_wchar(V_BSTR(&var1));
+        if (!name)
+        {
+            xmlFreeNode(node);
+            return E_OUTOFMEMORY;
+        }
+        xmlNodeSetName(node, name);
+        free(name);
+    }
+#endif
+
     return XMLElement_create(node, (LPVOID *)ppElem, TRUE);
 }
 
--- a/dlls/msxml3/xmlelem.c
+++ b/dlls/msxml3/xmlelem.c
@@ -429,10 +429,28 @@
 
     TRACE("%p, %p, %ld, %ld.\n", iface, pChildElem, lIndex, lreserved);
 
+    if (!pChildElem)
+        return E_INVALIDARG;
+
+#ifndef SG_MUTANT_XMLDOC_NONAME
+    /* lIndex is where among the children the new one goes; -1 (or past the end) appends it.
+     * (It added the element as a sibling of the child's last child for any index but 0.) */
+    {
+        xmlNodePtr before = This->node->children;
+        LONG i;
+
+        for (i = 0; before && i < lIndex; i++) before = before->next;
+        if (lIndex < 0 || !before)
+            child = xmlAddChild(This->node, childElem->node);
+        else
+            child = xmlAddPrevSibling(before, childElem->node);
+    }
+#else
     if (lIndex == 0)
         child = xmlAddChild(This->node, childElem->node);
     else
         child = xmlAddNextSibling(This->node, childElem->node->last);
+#endif
 
     /* parent is responsible for child data */
     if (child) childElem->own = FALSE;
