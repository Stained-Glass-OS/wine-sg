From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 09:59:15 -0700
Subject: [PATCH] windows.web: HttpClient.GetStringAsync, failed async
 operations, the From request header (3005)

HttpClient.GetStringAsync sends a GET through the client's filter and answers
with the response body as a string; a status outside 2xx makes the operation
fail with HTTP_E_STATUS_* (0x80190000 | status) like EnsureSuccessStatusCode.
The pre-completed async operations can now carry an error (status Error,
ErrorCode, GetResults and the completed handler report it) and their result can
be read by a caller that chains requests.
HttpRequestHeaderCollection.From reads and replaces the "From" header (an empty
value removes it) instead of ignoring it.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/windows.web/http_async.c b/dlls/windows.web/http_async.c
index b5cf643..84c094b 100644
--- a/dlls/windows.web/http_async.c
+++ b/dlls/windows.web/http_async.c
@@ -78,6 +78,7 @@ struct async_op
     IInspectable *result; /* result when it is an interface */
     HSTRING result_str;   /* result when it is a string */
     BOOL is_string;
+    HRESULT error;        /* the operation failed with this */
 };
 
 static struct async_op *impl_from_info( void *iface )
@@ -140,7 +141,7 @@ static HRESULT STDMETHODCALLTYPE op_put_Completed( struct async_op *iface, void
     {
         del->lpVtbl->AddRef( del );
         /* Already complete: fire immediately. */
-        del->lpVtbl->Invoke( del, &iface->lpVtbl, Completed );
+        del->lpVtbl->Invoke( del, &iface->lpVtbl, iface->error ? Error : Completed );
     }
     return S_OK;
 }
@@ -152,6 +153,7 @@ static HRESULT STDMETHODCALLTYPE op_get_Completed( struct async_op *iface, void
 static HRESULT STDMETHODCALLTYPE op_GetResults( struct async_op *iface, void *results )
 {
     TRACE( "iface %p, results %p.\n", iface, results );
+    if (iface->error) return iface->error;
     if (iface->is_string)
         return WindowsDuplicateString( iface->result_str, (HSTRING *)results );
     if ((*(IInspectable **)results = iface->result)) IInspectable_AddRef( iface->result );
@@ -173,8 +175,16 @@ static HRESULT STDMETHODCALLTYPE info_GetIids( void *iface, ULONG *c, IID **i )
 static HRESULT STDMETHODCALLTYPE info_GetRuntimeClassName( void *iface, HSTRING *n ) { return E_NOTIMPL; }
 static HRESULT STDMETHODCALLTYPE info_GetTrustLevel( void *iface, TrustLevel *t ) { *t = BaseTrust; return S_OK; }
 static HRESULT STDMETHODCALLTYPE info_get_Id( void *iface, UINT32 *id ) { *id = 1; return S_OK; }
-static HRESULT STDMETHODCALLTYPE info_get_Status( void *iface, AsyncStatus *status ) { *status = Completed; return S_OK; }
-static HRESULT STDMETHODCALLTYPE info_get_ErrorCode( void *iface, HRESULT *code ) { *code = S_OK; return S_OK; }
+static HRESULT STDMETHODCALLTYPE info_get_Status( void *iface, AsyncStatus *status )
+{
+    *status = impl_from_info( iface )->error ? Error : Completed;
+    return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE info_get_ErrorCode( void *iface, HRESULT *code )
+{
+    *code = impl_from_info( iface )->error;
+    return S_OK;
+}
 static HRESULT STDMETHODCALLTYPE info_Cancel( void *iface ) { return S_OK; }
 static HRESULT STDMETHODCALLTYPE info_Close( void *iface ) { return S_OK; }
 
@@ -216,3 +226,27 @@ HRESULT http_async_complete_string( const GUID *iid, HSTRING result, IInspectabl
     *out = (IInspectable *)&impl->lpVtbl;
     return S_OK;
 }
+
+/* An operation that has already failed with the given error. */
+HRESULT http_async_complete_error( const GUID *iid, HRESULT error, IInspectable **out )
+{
+    struct async_op *impl = async_alloc( iid );
+    if (!impl) return E_OUTOFMEMORY;
+    impl->error = error;
+    *out = (IInspectable *)&impl->lpVtbl;
+    return S_OK;
+}
+
+/* The interface result of a finished operation, from any implementation of the (uniform) ABI. */
+HRESULT http_async_get_iface_result( IInspectable *op, IInspectable **result )
+{
+    struct async_op *impl = (struct async_op *)op;
+    return impl->lpVtbl->GetResults( impl, result );
+}
+
+/* The string result of a finished operation. */
+HRESULT http_async_get_string_result( IInspectable *op, HSTRING *result )
+{
+    struct async_op *impl = (struct async_op *)op;
+    return impl->lpVtbl->GetResults( impl, result );
+}
diff --git a/dlls/windows.web/http_client.c b/dlls/windows.web/http_client.c
index 04eb4b6..9f4c379 100644
--- a/dlls/windows.web/http_client.c
+++ b/dlls/windows.web/http_client.c
@@ -151,9 +151,64 @@ static HRESULT WINAPI client_GetInputStreamAsync( IHttpClient *iface, IInspectab
 }
 static HRESULT WINAPI client_GetStringAsync( IHttpClient *iface, IInspectable *uri, IInspectable **op )
 {
-    FIXME( "iface %p, uri %p: not yet implemented.\n", iface, uri );
+    IInspectable *send_op = NULL, *read_op = NULL, *response_obj = NULL;
+    IHttpResponseMessage *response = NULL;
+    IHttpContent *content = NULL;
+    boolean success = FALSE;
+    HttpStatusCode status = 0;
+    HRESULT hr;
+
+    TRACE( "iface %p, uri %p, op %p.\n", iface, uri, op );
+
     *op = NULL;
-    return E_NOTIMPL;
+    if (FAILED( hr = client_send_verb( iface, L"GET", uri, NULL, &send_op ) )) return hr;
+
+    /* the transport finishes the request before returning */
+    hr = http_async_get_iface_result( send_op, &response_obj );
+    IInspectable_Release( send_op );
+    if (FAILED( hr ))
+        return http_async_complete_error( &IID_IAsyncOperationWithProgress_HSTRING_UINT64, hr, op );
+
+    if (FAILED( hr = IInspectable_QueryInterface( response_obj, &IID_IHttpResponseMessage, (void **)&response ) ))
+        goto done;
+
+    /* like GetStringAsync, fail unless the server answered with a success status */
+    IHttpResponseMessage_get_IsSuccessStatusCode( response, &success );
+    if (!success)
+    {
+        IHttpResponseMessage_get_StatusCode( response, &status );
+        hr = status >= 100 && status <= 599 ? (HRESULT)(0x80190000 | status) : (HRESULT)0x80190001;
+        http_async_complete_error( &IID_IAsyncOperationWithProgress_HSTRING_UINT64, hr, op );
+        hr = S_OK;
+        goto done;
+    }
+
+    if (SUCCEEDED( hr = IHttpResponseMessage_get_Content( response, &content ) ) && content)
+    {
+        HSTRING text = NULL;
+
+        if (SUCCEEDED( hr = IHttpContent_ReadAsStringAsync( content, &read_op ) ) &&
+            SUCCEEDED( hr = http_async_get_string_result( read_op, &text ) ))
+        {
+            hr = http_async_complete_string( &IID_IAsyncOperationWithProgress_HSTRING_UINT64, text, op );
+            WindowsDeleteString( text );
+        }
+        if (read_op) IInspectable_Release( read_op );
+        IHttpContent_Release( content );
+    }
+    else if (SUCCEEDED( hr ))
+    {
+        HSTRING empty = NULL;
+
+        WindowsCreateString( L"", 0, &empty );
+        hr = http_async_complete_string( &IID_IAsyncOperationWithProgress_HSTRING_UINT64, empty, op );
+        WindowsDeleteString( empty );
+    }
+
+done:
+    if (response) IHttpResponseMessage_Release( response );
+    IInspectable_Release( response_obj );
+    return hr;
 }
 static HRESULT WINAPI client_PostAsync( IHttpClient *iface, IInspectable *uri, IInspectable *content, IInspectable **op )
 {
diff --git a/dlls/windows.web/http_headers.c b/dlls/windows.web/http_headers.c
index 7f3ebe1..1c8eb97 100644
--- a/dlls/windows.web/http_headers.c
+++ b/dlls/windows.web/http_headers.c
@@ -149,16 +149,49 @@ TYPED_GET( Referer ) TYPED_SET( Referer )
 TYPED_GET_COLL( TransferEncoding, &iid_transfer_coding, NULL )
 TYPED_GET_COLL( UserAgent, &iid_product_info, NULL )
 
+static struct header *headers_find( struct header_collection *impl, const WCHAR *name )
+{
+    unsigned int i;
+
+    for (i = 0; i < impl->count; i++)
+        if (impl->headers[i].name && !wcsicmp( impl->headers[i].name, name )) return &impl->headers[i];
+    return NULL;
+}
+
 static HRESULT WINAPI headers_get_From( IHttpRequestHeaderCollection *iface, HSTRING *value )
 {
-    FIXME( "iface %p, From stub!\n", iface );
-    *value = NULL;
-    return S_OK;
+    struct header_collection *impl = impl_from_IHttpRequestHeaderCollection( iface );
+    struct header *header;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    header = headers_find( impl, L"From" );
+    return WindowsCreateString( header ? header->value : L"", header ? wcslen( header->value ) : 0, value );
 }
 static HRESULT WINAPI headers_put_From( IHttpRequestHeaderCollection *iface, HSTRING value )
 {
-    FIXME( "iface %p, From stub!\n", iface );
-    return S_OK;
+    struct header_collection *impl = impl_from_IHttpRequestHeaderCollection( iface );
+    struct header *header;
+    HSTRING name;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+
+    /* From is a single value: setting it replaces the old one, setting nothing removes it */
+    if ((header = headers_find( impl, L"From" )))
+    {
+        free( header->name );
+        free( header->value );
+        memmove( header, header + 1, (impl->headers + impl->count - header - 1) * sizeof(*header) );
+        impl->count--;
+    }
+    if (!value || !WindowsGetStringLen( value )) return S_OK;
+
+    if (FAILED(hr = WindowsCreateString( L"From", 4, &name ))) return hr;
+    hr = headers_store( impl, name, value );
+    WindowsDeleteString( name );
+    return hr;
 }
 
 static HRESULT WINAPI headers_Append( IHttpRequestHeaderCollection *iface, HSTRING name, HSTRING value )
