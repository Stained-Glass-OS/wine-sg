+static BOOL global_switch( WCHAR *token )
+{
+    WCHAR *value = wcschr( token, ':' );
+    WCHAR *name = token + 1;
+    size_t len = value ? value - name : wcslen( name );
+
+    if (value) value++;
+    if (len == 9 && !wcsnicmp( name, L"namespace", 9 ))
+    {
+        free( options.namespace );
+        options.namespace = value ? wcsdup( value ) : NULL;
+        if (options.namespace) unquote( options.namespace );
+    }
+    else if (len == 6 && !wcsnicmp( name, L"output", 6 ))
+    {
+        free( options.output );
+        options.output = value ? wcsdup( value ) : NULL;
+        if (options.output) unquote( options.output );
+        options.append = FALSE;
+    }
+    else if (len == 6 && !wcsnicmp( name, L"append", 6 ))
+    {
+        free( options.output );
+        options.output = value ? wcsdup( value ) : NULL;
+        if (options.output) unquote( options.output );
+        options.append = TRUE;
+    }
+    else if ((len == 4 && !wcsnicmp( name, L"node", 4 )) || (len == 4 && !wcsnicmp( name, L"user", 4 )) ||
+             (len == 8 && !wcsnicmp( name, L"password", 8 )) || (len == 4 && !wcsnicmp( name, L"role", 4 )) ||
+             (len == 8 && !wcsnicmp( name, L"implevel", 8 )) || (len == 9 && !wcsnicmp( name, L"authlevel", 9 )) ||
+             (len == 6 && !wcsnicmp( name, L"locale", 6 )) || (len == 10 && !wcsnicmp( name, L"privileges", 10 )) ||
+             (len == 5 && !wcsnicmp( name, L"trace", 5 )) || (len == 6 && !wcsnicmp( name, L"record", 6 )) ||
+             (len == 11 && !wcsnicmp( name, L"interactive", 11 )) || (len == 8 && !wcsnicmp( name, L"failfast", 8 )) ||
+             (len == 9 && !wcsnicmp( name, L"aggregate", 9 )) || (len == 9 && !wcsnicmp( name, L"authority", 9 )))
