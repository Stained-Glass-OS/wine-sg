+/* a condition may only name properties that the class has */
+static BOOL cond_properties_exist( const struct table *table, const struct expr *cond )
+{
+    UINT column;
+
+    if (!cond) return TRUE;
+    switch (cond->type)
+    {
+    case EXPR_COMPLEX:
+    case EXPR_UNARY:
+        return cond_properties_exist( table, cond->u.expr.left ) && cond_properties_exist( table, cond->u.expr.right );
+    case EXPR_PROPVAL:
+        return get_column_index( table, cond->u.propval->name, &column ) == S_OK;
+    default:
+        return TRUE;
+    }
+}
