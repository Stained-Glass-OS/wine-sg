+
+        if (mem && (p = GlobalLock( mem )))
+        {
+            memcpy( p, out_text.str, (out_text.len + 1) * sizeof(WCHAR) );
+            GlobalUnlock( mem );
+            if (OpenClipboard( NULL ))
+            {
