+static BOOL text_reserve( struct text *t, size_t more )
+{
+    WCHAR *p;
+    size_t cap;
+
+    if (t->len + more + 1 <= t->cap) return TRUE;
+    cap = max( t->cap * 2, t->len + more + 1 + 256 );
+    if (!(p = realloc( t->str, cap * sizeof(WCHAR) ))) return FALSE;
+    t->str = p;
+    t->cap = cap;
+    return TRUE;
 }
 
+static void text_add( struct text *t, const WCHAR *str )
+{
+    size_t len = wcslen( str );
+    if (!text_reserve( t, len )) return;
+    memcpy( t->str + t->len, str, (len + 1) * sizeof(WCHAR) );
+    t->len += len;
+}
+
+static void text_pad( struct text *t, const WCHAR *str, size_t width )
+{
+    size_t len = wcslen( str ), i;
+
+    if (!text_reserve( t, max( len, width ) )) return;
+    memcpy( t->str + t->len, str, len * sizeof(WCHAR) );
+    for (i = len; i < width; i++) t->str[t->len + i] = ' ';
+    t->len += max( len, width );
+    t->str[t->len] = 0;
+}
