+/* the object for a class that has no instance: its properties have no values */
+HRESULT create_class_only_object( IEnumWbemClassObject *iter, enum wbm_namespace ns, IWbemClassObject **obj )
+{
+    struct enum_class_object *ec = impl_from_IEnumWbemClassObject( iter );
+    struct table *table;
+    struct record *record;
+    HRESULT hr;
+
+    if (!ec->query->view->table_count) return WBEM_E_NOT_FOUND;
+    table = get_view_table( ec->query->view, 0 );
+    if (!(record = create_record( table ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = create_class_object( ns, table->name, iter, 0, record, obj ))) destroy_record( record );
+    return hr;
+}
