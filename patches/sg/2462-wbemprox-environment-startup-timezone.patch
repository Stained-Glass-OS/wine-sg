+static WCHAR *get_current_user_domain_name(void)
+{
+    WCHAR user[UNLEN + 1], domain[MAX_COMPUTERNAME_LENGTH + 1], *ret;
+    DWORD ulen = ARRAY_SIZE(user), dlen = ARRAY_SIZE(domain), len;
+
+    if (!GetUserNameW( user, &ulen )) return NULL;
+    if (!GetEnvironmentVariableW( L"USERDOMAIN", domain, ARRAY_SIZE(domain) ) && !GetComputerNameW( domain, &dlen )) return NULL;
+    len = wcslen( domain ) + 1 + wcslen( user ) + 1;
+    if ((ret = malloc( len * sizeof(WCHAR) ))) swprintf( ret, len, L"%s\\%s", domain, user );
+    return ret;
+}
+
+static WCHAR *join_path2( const WCHAR *a, const WCHAR *sep, const WCHAR *b )
+{
+    UINT len = wcslen( a ) + wcslen( sep ) + wcslen( b ) + 1;
+    WCHAR *ret = malloc( len * sizeof(WCHAR) );
+    if (ret) swprintf( ret, len, L"%s%s%s", a, sep, b );
+    return ret;
+}
+
+static BOOL add_environment_rows( struct table *table, HKEY root, const WCHAR *path, const WCHAR *username, BOOL system,
+                                  const struct expr *cond, UINT *row, enum fill_status *status )
+{
+    struct record_environment *rec;
+    HKEY key;
+    DWORD index, type, namelen, datalen, maxname, maxdata;
+    WCHAR *name, *data;
+
+    if (RegOpenKeyExW( root, path, 0, KEY_READ, &key )) return TRUE;
+    if (RegQueryInfoKeyW( key, NULL, NULL, NULL, NULL, NULL, NULL, NULL, &maxname, &maxdata, NULL, NULL ))
+    {
+        RegCloseKey( key );
+        return TRUE;
+    }
+    name = malloc( (maxname + 1) * sizeof(WCHAR) );
+    data = malloc( maxdata + 2 * sizeof(WCHAR) );
+    if (!name || !data)
+    {
+        free( name ); free( data );
+        RegCloseKey( key );
+        return FALSE;
+    }
+    for (index = 0;; index++)
+    {
+        namelen = maxname + 1;
+        datalen = maxdata;
+        if (RegEnumValueW( key, index, name, &namelen, NULL, &type, (BYTE *)data, &datalen )) break;
+        if (type != REG_SZ && type != REG_EXPAND_SZ) continue;
+        data[datalen / sizeof(WCHAR)] = 0;
+        if (!resize_table( table, *row + 1, sizeof(*rec) ))
+        {
+            free( name ); free( data );
+            RegCloseKey( key );
+            return FALSE;
+        }
+        rec = (struct record_environment *)(table->data + *row * sizeof(*rec));
+        rec->caption        = join_path2( username, L"\\", name );
+        rec->description    = join_path2( username, L"\\", name );
+        rec->name           = wcsdup( name );
+        rec->status         = L"OK";
+        rec->systemvariable = system ? -1 : 0;
+        rec->username       = wcsdup( username );
+        rec->variablevalue  = wcsdup( data );
+        if (!match_row( table, *row, cond, status ))
+        {
+            free_row_values( table, *row );
+            memset( rec, 0, sizeof(*rec) );
+            continue;
+        }
+        (*row)++;
+    }
+    free( name );
+    free( data );
+    RegCloseKey( key );
+    return TRUE;
+}
+
+static enum fill_status fill_environment( struct table *table, const struct expr *cond )
+{
+    enum fill_status status = FILL_STATUS_UNFILTERED;
+    WCHAR *user = get_current_user_domain_name();
+    UINT row = 0;
+
+    if (!resize_table( table, 8, sizeof(struct record_environment) )) { free( user ); return FILL_STATUS_FAILED; }
+    if (!add_environment_rows( table, HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Session Manager\\Environment",
+                               L"<SYSTEM>", TRUE, cond, &row, &status ) ||
+#ifdef SG_MUTANT_WBEM_ENV_USER
+        0)
+#else
+        (user && !add_environment_rows( table, HKEY_CURRENT_USER, L"Environment", user, FALSE, cond, &row, &status )))
+#endif
+        status = FILL_STATUS_FAILED;
+    free( user );
+    table->num_rows = row;
+    TRACE("created %u rows\n", row);
+    return status;
+}
+
+static WCHAR *current_user_sid_string(void)
+{
+    HANDLE token;
+    TOKEN_USER *user = NULL;
+    DWORD size = 0;
+    WCHAR *sid = NULL, *ret = NULL;
+
+    if (!OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )) return NULL;
+    GetTokenInformation( token, TokenUser, NULL, 0, &size );
+    if (size && (user = malloc( size )) && GetTokenInformation( token, TokenUser, user, size, &size ) &&
+        ConvertSidToStringSidW( user->User.Sid, &sid ))
+        ret = wcsdup( sid );
+    LocalFree( sid );
+    free( user );
+    CloseHandle( token );
+    return ret;
+}
+
+static BOOL add_startup_row( struct table *table, UINT *row, const struct expr *cond, enum fill_status *status,
+                             const WCHAR *name, const WCHAR *command, const WCHAR *location, const WCHAR *user )
+{
+    struct record_startupcommand *rec;
+
+    if (!resize_table( table, *row + 1, sizeof(*rec) )) return FALSE;
+    rec = (struct record_startupcommand *)(table->data + *row * sizeof(*rec));
+    rec->caption     = wcsdup( name );
+    rec->command     = wcsdup( command );
+    rec->description = wcsdup( name );
+    rec->location    = wcsdup( location );
+    rec->name        = wcsdup( name );
+    rec->settingid   = L"";
+    rec->user        = wcsdup( user );
+    if (!match_row( table, *row, cond, status ))
+    {
+        free_row_values( table, *row );
+        memset( rec, 0, sizeof(*rec) );
+        return TRUE;
+    }
+    (*row)++;
+    return TRUE;
+}
+
+static BOOL add_run_key_rows( struct table *table, UINT *row, const struct expr *cond, enum fill_status *status,
+                              HKEY root, const WCHAR *path, const WCHAR *location, const WCHAR *user )
+{
+    HKEY key;
+    DWORD index, type, namelen, datalen, maxname, maxdata;
+    WCHAR *name, *data;
+    BOOL ret = TRUE;
+
+    if (RegOpenKeyExW( root, path, 0, KEY_READ, &key )) return TRUE;
+    if (RegQueryInfoKeyW( key, NULL, NULL, NULL, NULL, NULL, NULL, NULL, &maxname, &maxdata, NULL, NULL ))
+    {
+        RegCloseKey( key );
+        return TRUE;
+    }
+    name = malloc( (maxname + 1) * sizeof(WCHAR) );
+    data = malloc( maxdata + 2 * sizeof(WCHAR) );
+    if (!name || !data) ret = FALSE;
+    for (index = 0; ret; index++)
+    {
+        namelen = maxname + 1;
+        datalen = maxdata;
+        if (RegEnumValueW( key, index, name, &namelen, NULL, &type, (BYTE *)data, &datalen )) break;
+        if (type != REG_SZ && type != REG_EXPAND_SZ) continue;
+        data[datalen / sizeof(WCHAR)] = 0;
+        ret = add_startup_row( table, row, cond, status, name, data, location, user );
+    }
+    free( name );
+    free( data );
+    RegCloseKey( key );
+    return ret;
+}
+
+static BOOL add_startup_folder_rows( struct table *table, UINT *row, const struct expr *cond, enum fill_status *status,
+                                     int csidl, const WCHAR *location, const WCHAR *user )
+{
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH + 4], *command;
+    WIN32_FIND_DATAW data;
+    HANDLE find;
+    BOOL ret = TRUE;
+    typedef BOOL (WINAPI *get_folder_path)( HWND, WCHAR *, int, BOOL );
+    get_folder_path SHGetSpecialFolderPathW_ptr;
+    HMODULE shell32 = LoadLibraryW( L"shell32.dll" );
+
+    if (!shell32) return TRUE;
+    SHGetSpecialFolderPathW_ptr = (get_folder_path)GetProcAddress( shell32, "SHGetSpecialFolderPathW" );
+    if (!SHGetSpecialFolderPathW_ptr || !SHGetSpecialFolderPathW_ptr( NULL, dir, csidl, FALSE ))
+    {
+        FreeLibrary( shell32 );
+        return TRUE;
+    }
+    FreeLibrary( shell32 );
+    swprintf( pattern, ARRAY_SIZE(pattern), L"%s\\*", dir );
+    if ((find = FindFirstFileW( pattern, &data )) == INVALID_HANDLE_VALUE) return TRUE;
+    do
+    {
+        if ((data.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_HIDDEN)) || !wcsicmp( data.cFileName, L"desktop.ini" ))
+            continue;
+        if (!(command = join_path2( dir, L"\\", data.cFileName ))) { ret = FALSE; break; }
+        ret = add_startup_row( table, row, cond, status, data.cFileName, command, location, user );
+        free( command );
+    } while (ret && FindNextFileW( find, &data ));
+    FindClose( find );
+    return ret;
+}
+
+static enum fill_status fill_startupcommand( struct table *table, const struct expr *cond )
+{
+    static const WCHAR run[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Run";
+    enum fill_status status = FILL_STATUS_UNFILTERED;
+    WCHAR *user = get_current_user_domain_name(), *sid = current_user_sid_string(), *location = NULL;
+    UINT row = 0;
+    BOOL ok;
+
+    if (!resize_table( table, 4, sizeof(struct record_startupcommand) )) { free( user ); free( sid ); return FILL_STATUS_FAILED; }
+    ok = add_run_key_rows( table, &row, cond, &status, HKEY_LOCAL_MACHINE, run,
+                           L"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run", L"Public" );
+#ifdef SG_MUTANT_WBEM_STARTUP_HKCU
+    if (0)
+#else
+    if (ok && user && sid && (location = join_path2( L"HKU\\", sid, L"\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run" )))
+#endif
+        ok = add_run_key_rows( table, &row, cond, &status, HKEY_CURRENT_USER, run, location, user );
+    if (ok) ok = add_startup_folder_rows( table, &row, cond, &status, 0x18 /* CSIDL_COMMON_STARTUP */, L"Common Startup", L"Public" );
+    if (ok && user) ok = add_startup_folder_rows( table, &row, cond, &status, 0x07 /* CSIDL_STARTUP */, L"Startup", user );
+    free( location );
+    free( user );
+    free( sid );
+    if (!ok) status = FILL_STATUS_FAILED;
+    table->num_rows = row;
+    TRACE("created %u rows\n", row);
+    return status;
+}
+
+static WCHAR *get_timezone_caption( const WCHAR *standard_name )
+{
+    WCHAR path[200], *ret;
+
+    swprintf( path, ARRAY_SIZE(path), L"Software\\Microsoft\\Windows NT\\CurrentVersion\\Time Zones\\%s", standard_name );
+    if ((ret = get_reg_str( HKEY_LOCAL_MACHINE, path, L"Display" ))) return ret;
+    return wcsdup( standard_name );
+}
+
+static enum fill_status fill_timezone( struct table *table, const struct expr *cond )
+{
+    struct record_timezone *rec;
+    TIME_ZONE_INFORMATION tzi;
+    enum fill_status status = FILL_STATUS_UNFILTERED;
+
+    if (GetTimeZoneInformation( &tzi ) == TIME_ZONE_ID_INVALID) return FILL_STATUS_FAILED;
+    if (!resize_table( table, 1, sizeof(*rec) )) return FILL_STATUS_FAILED;
+
+    rec = (struct record_timezone *)table->data;
+#ifdef SG_MUTANT_WBEM_TZ_BIAS
+    rec->bias                = tzi.Bias;
+#else
+    rec->bias                = -tzi.Bias;
+#endif
+    rec->caption             = get_timezone_caption( tzi.StandardName );
+    rec->daylightbias        = -tzi.DaylightBias;
+    rec->daylightday         = tzi.DaylightDate.wDay;
+    rec->daylightdayofweek   = tzi.DaylightDate.wDayOfWeek;
+    rec->daylighthour        = tzi.DaylightDate.wHour;
+    rec->daylightmillisecond = tzi.DaylightDate.wMilliseconds;
+    rec->daylightminute      = tzi.DaylightDate.wMinute;
+    rec->daylightmonth       = tzi.DaylightDate.wMonth;
+    rec->daylightname        = wcsdup( tzi.DaylightName );
+    rec->daylightsecond      = tzi.DaylightDate.wSecond;
+    rec->daylightyear        = tzi.DaylightDate.wYear;
+    rec->description         = get_timezone_caption( tzi.StandardName );
+    rec->settingid           = L"";
+    rec->standardbias        = -tzi.StandardBias;
+    rec->standardday         = tzi.StandardDate.wDay;
+    rec->standarddayofweek   = tzi.StandardDate.wDayOfWeek;
+    rec->standardhour        = tzi.StandardDate.wHour;
+    rec->standardmillisecond = tzi.StandardDate.wMilliseconds;
+    rec->standardminute      = tzi.StandardDate.wMinute;
+    rec->standardmonth       = tzi.StandardDate.wMonth;
+    rec->standardname        = wcsdup( tzi.StandardName );
+    rec->standardsecond      = tzi.StandardDate.wSecond;
+    rec->standardyear        = tzi.StandardDate.wYear;
+    if (!match_row( table, 0, cond, &status ))
+    {
+        free_row_values( table, 0 );
+        table->num_rows = 0;
+        return status;
+    }
+    table->num_rows = 1;
+    return status;
+}
