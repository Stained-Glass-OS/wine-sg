From: Stained Glass OS <dev@stained-glass.example>
Subject: userenv: DeriveAppContainerSidFromAppContainerName

An AppContainer's SID is S-1-15-2 followed by the first seven 32-bit words of
the SHA-256 of its lower-cased name in UTF-16LE, the derivation independent
tools document; it reproduces the published SID of the legacy Edge package
(Microsoft.MicrosoftEdge_8wekyb3d8bbwe). Chromium's sandbox derives
AppContainer SIDs with it.

--- a/include/userenv.h
+++ b/include/userenv.h
@@ -105,6 +105,7 @@
 USERENVAPI BOOL WINAPI RegisterGPNotification(HANDLE,BOOL);
 USERENVAPI BOOL WINAPI UnloadUserProfile(HANDLE,HANDLE);
 USERENVAPI BOOL WINAPI UnregisterGPNotification(HANDLE);
+USERENVAPI HRESULT WINAPI DeriveAppContainerSidFromAppContainerName(PCWSTR,PSID*);
 
 #ifdef __cplusplus
 }
--- a/dlls/userenv/userenv_main.c
+++ b/dlls/userenv/userenv_main.c
@@ -30,6 +30,7 @@
 #include "sddl.h"
 #include "objbase.h"
 #include "userenv.h"
+#include "bcrypt.h"
 
 #include "wine/debug.h"
 
@@ -688,6 +689,55 @@
     return FALSE;
 }
 
+/***********************************************************************
+ *              DeriveAppContainerSidFromAppContainerName (USERENV.@)
+ *
+ * An AppContainer's SID is derived from its name alone: S-1-15-2 followed by
+ * the first seven 32-bit words of the SHA-256 of the name, lower-cased, in
+ * UTF-16LE -- the derivation independent tools (NtObjectManager among them)
+ * document and reproduce. The SID is freed with FreeSid.
+ */
+HRESULT WINAPI DeriveAppContainerSidFromAppContainerName(PCWSTR name, PSID *sid)
+{
+    SID_IDENTIFIER_AUTHORITY authority = { SECURITY_APP_PACKAGE_AUTHORITY };
+    BCRYPT_ALG_HANDLE alg;
+    BCRYPT_HASH_HANDLE hash;
+    DWORD words[8];
+    WCHAR *lower;
+    size_t len;
+    NTSTATUS status;
+
+    TRACE("(%s, %p)\n", debugstr_w(name), sid);
+
+    if (!name || !sid) return E_INVALIDARG;
+    len = wcslen(name);
+    if (!len || len > 64) return E_INVALIDARG;
+    if (!(lower = HeapAlloc(GetProcessHeap(), 0, (len + 1) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    memcpy(lower, name, (len + 1) * sizeof(WCHAR));
+    CharLowerBuffW(lower, len);
+
+    status = BCryptOpenAlgorithmProvider(&alg, BCRYPT_SHA256_ALGORITHM, NULL, 0);
+    if (!status)
+    {
+        if (!(status = BCryptCreateHash(alg, &hash, NULL, 0, NULL, 0, 0)))
+        {
+            if (!(status = BCryptHashData(hash, (UCHAR *)lower, len * sizeof(WCHAR), 0)))
+                status = BCryptFinishHash(hash, (UCHAR *)words, sizeof(words), 0);
+            BCryptDestroyHash(hash);
+        }
+        BCryptCloseAlgorithmProvider(alg, 0);
+    }
+    HeapFree(GetProcessHeap(), 0, lower);
+    if (status) return HRESULT_FROM_NT(status);
+
+    /* words[] is the digest in memory order: little-endian words, as the
+     * derivation reads it. */
+    if (!AllocateAndInitializeSid(&authority, 8, SECURITY_APP_PACKAGE_BASE_RID,
+                                  words[0], words[1], words[2], words[3], words[4], words[5], words[6], sid))
+        return HRESULT_FROM_WIN32(GetLastError());
+    return S_OK;
+}
+
 HRESULT WINAPI CreateAppContainerProfile(PCWSTR container_name, PCWSTR display_name, PCWSTR description,
                                          SID_AND_ATTRIBUTES *capabilities, DWORD capability_count,
                                          SID **container_sid)
