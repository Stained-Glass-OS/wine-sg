From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: tooltips

ToolTipService.ToolTip was kept but never shown: NanaZip's icon-only toolbar gave no names. When the pointer rests on an element with a tooltip (or inside one) for a moment, its tooltip now shows in a window of its own below the pointer -- a string in the desktop's tooltip colours, or the element given -- and it goes when the pointer moves to another element, leaves, or on a click, a key or the focus leaving. Markup property elements of another type, such as <ToolTipService.ToolTip>, now set that attached member. Behind the XAML switch of 6131.
---
diff --git a/dlls/windows.ui.xaml/hosting.c b/dlls/windows.ui.xaml/hosting.c
index 1dba236..fca84d2 100644
--- a/dlls/windows.ui.xaml/hosting.c
+++ b/dlls/windows.ui.xaml/hosting.c
@@ -556,6 +556,7 @@ static LRESULT CALLBACK island_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM
     {
         struct xaml_source *source = (struct xaml_source *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
         if (msg == WM_KILLFOCUS) xaml_popups_focus_lost( hwnd, (HWND)wparam );
+        if (msg == WM_KEYDOWN || msg == WM_SYSKEYDOWN || msg == WM_KILLFOCUS) xaml_tooltip_hide();
         if (source && xaml_key_message( hwnd, msg, wparam, lparam, source->content )) return 0;
         break;
     }
@@ -566,6 +567,7 @@ static LRESULT CALLBACK island_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM
     case WM_RBUTTONDOWN:
     case WM_RBUTTONUP:
     case WM_CAPTURECHANGED:
+    case WM_TIMER:
     {
         struct xaml_source *source = (struct xaml_source *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
         if (msg == WM_LBUTTONDOWN || msg == WM_RBUTTONDOWN) xaml_popups_light_dismiss( hwnd );
diff --git a/dlls/windows.ui.xaml/input.c b/dlls/windows.ui.xaml/input.c
index d6cc858..7c62578 100644
--- a/dlls/windows.ui.xaml/input.c
+++ b/dlls/windows.ui.xaml/input.c
@@ -88,6 +88,133 @@ static struct uielem *button_at( IInspectable *content, LPARAM lparam )
     return NULL;
 }
 
+/* ---- tooltips: ToolTipService.ToolTip shown after the pointer rests on its element ---- */
+
+#define TOOLTIP_TIMER 0x5347
+#define TOOLTIP_DELAY 600
+
+static struct
+{
+    struct uielem *owner;           /* the element whose tooltip is pending or shown (a reference) */
+    HWND island;
+    HWND window;                    /* its window, while shown */
+    IInspectable *content;          /* what it shows (a reference) */
+    POINT pt;                       /* the pointer, in screen coordinates */
+} tip;
+
+static IInspectable *tooltip_of( struct uielem *elem )
+{
+    struct xaml_property *prop = xaml_property_find( L"Windows.UI.Xaml.Controls.ToolTipService", L"ToolTip" );
+    IInspectable *value = NULL;
+
+    if (prop) dobj_get_value( &elem->d, prop, &value );
+    return value;
+}
+
+static struct uielem *tooltip_target( IInspectable *content, LPARAM lparam )
+{
+    struct uielem *root = uielem_from_inspectable( content ), *elem;
+    IInspectable *value;
+
+    if (!root) return NULL;
+    for (elem = hit_test( root, (SHORT)LOWORD( lparam ), (SHORT)HIWORD( lparam ) ); elem; elem = elem->parent)
+        if ((value = tooltip_of( elem )))
+        {
+            IInspectable_Release( value );
+            return elem;
+        }
+    return NULL;
+}
+
+static void tooltip_hide(void)
+{
+    if (tip.island) KillTimer( tip.island, TOOLTIP_TIMER );
+    if (tip.window)
+    {
+        TRACE( "tooltip of %p hidden\n", tip.owner );
+        xaml_popup_window_close( tip.window );
+        tip.window = NULL;
+    }
+    if (tip.content) IInspectable_Release( tip.content );
+    tip.content = NULL;
+    hold( &tip.owner, NULL );
+    tip.island = NULL;
+}
+
+/* a string in the tooltip's frame (the desktop's info colours), or the element it is */
+static void tooltip_show(void)
+{
+    IInspectable *value, *root = NULL;
+    WCHAR *str, *xaml;
+    POINT pt = tip.pt;
+
+    if (!tip.owner || tip.window || !(value = tooltip_of( tip.owner ))) return;
+#ifdef SG_MUTANT_NO_TOOLTIPS
+    IInspectable_Release( value );
+    return;
+#endif
+    if ((str = xunbox_string( value )))
+    {
+        size_t len = wcslen( str ), i, o = 0;
+        COLORREF bk = GetSysColor( COLOR_INFOBK ), fg = GetSysColor( COLOR_INFOTEXT );
+        if ((xaml = malloc( (len * 6 + 512) * sizeof(WCHAR) )))
+        {
+            o = swprintf( xaml, 512, L"<Border xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\""
+                          L" Background=\"#FF%02X%02X%02X\" BorderBrush=\"#FF%02X%02X%02X\" BorderThickness=\"1\" Padding=\"6,3\">"
+                          L"<TextBlock Foreground=\"#FF%02X%02X%02X\" FontSize=\"12\" Text=\"",
+                          GetRValue( bk ), GetGValue( bk ), GetBValue( bk ), GetRValue( fg ), GetGValue( fg ), GetBValue( fg ),
+                          GetRValue( fg ), GetGValue( fg ), GetBValue( fg ) );
+            for (i = 0; i < len; i++)
+            {
+                const WCHAR *rep = str[i] == '<' ? L"&lt;" : str[i] == '>' ? L"&gt;" : str[i] == '&' ? L"&amp;" :
+                                   str[i] == '"' ? L"&quot;" : NULL;
+                if (rep) { wcscpy( xaml + o, rep ); o += wcslen( rep ); }
+                else xaml[o++] = str[i];
+            }
+            wcscpy( xaml + o, L"\"/></Border>" );
+            if (FAILED(xaml_load_text( xaml, NULL, &root ))) root = NULL;
+            free( xaml );
+        }
+        free( str );
+    }
+    else if (uielem_from_inspectable( value )) IInspectable_AddRef( (root = value) );
+    IInspectable_Release( value );
+    if (!root) return;
+    pt.y += 20;
+    if ((tip.window = xaml_popup_window_open( root, tip.island, pt )))
+    {
+        TRACE( "tooltip of %p shown in %p\n", tip.owner, tip.window );
+        tip.content = root;
+    }
+    else IInspectable_Release( root );
+}
+
+void xaml_tooltip_hide(void)
+{
+    tooltip_hide();
+}
+
+BOOL xaml_tooltip_shown( HWND *window )
+{
+    if (window) *window = tip.window;
+    return tip.window != NULL;
+}
+
+static void tooltip_track( HWND hwnd, IInspectable *content, LPARAM lparam )
+{
+    struct uielem *target = tooltip_target( content, lparam );
+
+    if (target == tip.owner && tip.island == hwnd) return;
+    tooltip_hide();
+    if (!target) return;
+    hold( &tip.owner, target );
+    tip.island = hwnd;
+    tip.pt.x = (SHORT)LOWORD( lparam );
+    tip.pt.y = (SHORT)HIWORD( lparam );
+    ClientToScreen( hwnd, &tip.pt );
+    SetTimer( hwnd, TOOLTIP_TIMER, TOOLTIP_DELAY, NULL );
+}
+
 static void set_hover( struct uielem *button )
 {
     if (input.hover == button) return;
@@ -112,9 +239,16 @@ BOOL xaml_input_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IIns
             TrackMouseEvent( &track );
         }
         set_hover( button_at( content, lparam ) );
+        tooltip_track( hwnd, content, lparam );
         return TRUE;
     }
+    case WM_TIMER:
+        if (wparam != TOOLTIP_TIMER) return FALSE;
+        KillTimer( hwnd, TOOLTIP_TIMER );
+        if (tip.island == hwnd) tooltip_show();
+        return TRUE;
     case WM_MOUSELEAVE:
+        tooltip_hide();
         if (input.hwnd == hwnd) input.hwnd = NULL;
         if (!input.pressed) set_hover( NULL );
         return TRUE;
@@ -122,6 +256,7 @@ BOOL xaml_input_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IIns
     {
         /* the keyboard to what takes it there */
         struct uielem *root = uielem_from_inspectable( content ), *elem;
+        tooltip_hide();
         for (elem = root ? hit_test( root, (SHORT)LOWORD( lparam ), (SHORT)HIWORD( lparam ) ) : NULL; elem; elem = elem->parent)
             if (xaml_is_focus_target( elem )) break;
         if (elem)
diff --git a/dlls/windows.ui.xaml/markup.c b/dlls/windows.ui.xaml/markup.c
index 967a783..ac83762 100644
--- a/dlls/windows.ui.xaml/markup.c
+++ b/dlls/windows.ui.xaml/markup.c
@@ -1077,9 +1077,13 @@ static HRESULT read_content( struct text_state *state, IInspectable *obj, const
             if ((dot = wcschr( local, '.' )))
             {
                 /* a property element: Owner.Member */
-                WCHAR *member = wcsdup( dot + 1 );
+                WCHAR *member = wcsdup( dot + 1 ), *owner = NULL;
                 BOOL empty = IXmlReader_IsEmptyElement( state->reader );
+                struct dobj *d = dobj_from_inspectable( obj );
                 if (!member) return E_OUTOFMEMORY;
+                /* Owner.Member of another type: an attached member (<ToolTipService.ToolTip>) */
+                if (d && !xaml_find_member( d, member ) && (owner = wcsdup( local )))
+                    owner[dot - local] = 0;
                 while (!empty && (hr = IXmlReader_Read( state->reader, &type )) == S_OK && type != XmlNodeType_EndElement)
                 {
                     IInspectable *child = NULL;
@@ -1087,7 +1091,7 @@ static HRESULT read_content( struct text_state *state, IInspectable *obj, const
                     {
                         const WCHAR *text;
                         IXmlReader_GetValue( state->reader, &text, NULL );
-                        hr = xaml_writer_set( state->writer, obj, NULL, member, text, NULL );
+                        hr = xaml_writer_set( state->writer, obj, owner, member, text, NULL );
                     }
                     else if (type == XmlNodeType_Element)
                     {
@@ -1097,7 +1101,7 @@ static HRESULT read_content( struct text_state *state, IInspectable *obj, const
                             if (key || !wcscmp( member, L"Resources" ) || !wcscmp( member, L"MergedDictionaries" ) ||
                                 !wcscmp( member, L"ThemeDictionaries" ))
                                 hr = xaml_writer_add_keyed( state->writer, obj, member, child, key );
-                            else hr = xaml_writer_set( state->writer, obj, NULL, member, NULL, child );
+                            else hr = xaml_writer_set( state->writer, obj, owner, member, NULL, child );
                             IInspectable_Release( child );
                         }
                         else if (hr == E_NOTIMPL) hr = S_OK;   /* not ours yet: skipped */
@@ -1106,6 +1110,7 @@ static HRESULT read_content( struct text_state *state, IInspectable *obj, const
                     if (FAILED(hr)) break;
                 }
                 free( member );
+                free( owner );
                 if (FAILED(hr)) return hr;
             }
             else
diff --git a/dlls/windows.ui.xaml/private.h b/dlls/windows.ui.xaml/private.h
index 342363e..d6db884 100644
--- a/dlls/windows.ui.xaml/private.h
+++ b/dlls/windows.ui.xaml/private.h
@@ -391,6 +391,7 @@ void xaml_popup_window_close( HWND hwnd );
 HWND xaml_element_window( struct uielem *elem );
 void xaml_popups_light_dismiss( HWND clicked );
 void xaml_popups_focus_lost( HWND island, HWND focus );
+void xaml_tooltip_hide(void);
 void xaml_popup_check( struct uielem *popup );
 IInspectable *xaml_context_flyout( struct uielem *elem );
 BOOL xaml_flyout_show( IInspectable *flyout, struct uielem *target, const POINT *at );
