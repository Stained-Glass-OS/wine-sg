+++ b/dlls/windows.ui.xaml/ifaces.txt
@@ -1725,3 +1725,8 @@ IDataTemplateStatics2 8af77d73-aa01-471e-bedd-8bad86219b77 9
   6 ExtensionInstanceProperty 8 ptr
