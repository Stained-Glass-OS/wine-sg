     FIXME( "%p: IDataTemplateStatics2.SetExtensionInstance not implemented\n", iface );
     return E_NOTIMPL;
 }
+
+HRESULT WINAPI stub_IGeneralTransform_6( void *iface, ULONG_PTR a1 )
+{
+    FIXME( "%p: IGeneralTransform.Inverse not implemented\n", iface );
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI stub_IGeneralTransform_7( void *iface, ULONG_PTR a1, ULONG_PTR a2, ULONG_PTR a3 )
+{
+    FIXME( "%p: IGeneralTransform.TransformPoint not implemented\n", iface );
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI stub_IGeneralTransform_8( void *iface, ULONG_PTR a1, ULONG_PTR a2, ULONG_PTR a3, ULONG_PTR a4 )
+{
+    FIXME( "%p: IGeneralTransform.TryTransform not implemented\n", iface );
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI stub_IGeneralTransform_9( void *iface, ULONG_PTR a1, ULONG_PTR a2, ULONG_PTR a3, ULONG_PTR a4, ULONG_PTR a5 )
+{
+    FIXME( "%p: IGeneralTransform.TransformBounds not implemented\n", iface );
+    return E_NOTIMPL;
+}
diff --git a/dlls/windows.ui.xaml/ifaces.h b/dlls/windows.ui.xaml/ifaces.h
index b6e5b9f..4f10ed4 100644
--- a/dlls/windows.ui.xaml/ifaces.h
+++ b/dlls/windows.ui.xaml/ifaces.h
@@ -2578,6 +2578,15 @@ HRESULT WINAPI stub_IDataTemplateStatics2_8( void *iface, ULONG_PTR a1, ULONG_PT
 #define IDataTemplateStatics2_STUBS XIFACE_COMMON, stub_IDataTemplateStatics2_6, stub_IDataTemplateStatics2_7, stub_IDataTemplateStatics2_8
 #define IDataTemplateStatics2_FSTUBS XFIFACE_COMMON, stub_IDataTemplateStatics2_6, stub_IDataTemplateStatics2_7, stub_IDataTemplateStatics2_8
 
+XAML_IID(IGeneralTransform, 0xa06798b7, 0xa2ec, 0x415f, 0xad, 0xe2, 0xea, 0xde, 0x93, 0x33, 0xf2, 0xc7);
+enum { IGeneralTransform_Inverse = 6, IGeneralTransform_TransformPoint = 7, IGeneralTransform_TryTransform = 8, IGeneralTransform_TransformBounds = 9, IGeneralTransform_slots = 10 };
+HRESULT WINAPI stub_IGeneralTransform_6( void *iface, ULONG_PTR a1 );
+HRESULT WINAPI stub_IGeneralTransform_7( void *iface, ULONG_PTR a1, ULONG_PTR a2, ULONG_PTR a3 );
+HRESULT WINAPI stub_IGeneralTransform_8( void *iface, ULONG_PTR a1, ULONG_PTR a2, ULONG_PTR a3, ULONG_PTR a4 );
+HRESULT WINAPI stub_IGeneralTransform_9( void *iface, ULONG_PTR a1, ULONG_PTR a2, ULONG_PTR a3, ULONG_PTR a4, ULONG_PTR a5 );
+#define IGeneralTransform_STUBS XIFACE_COMMON, stub_IGeneralTransform_6, stub_IGeneralTransform_7, stub_IGeneralTransform_8, stub_IGeneralTransform_9
+#define IGeneralTransform_FSTUBS XFIFACE_COMMON, stub_IGeneralTransform_6, stub_IGeneralTransform_7, stub_IGeneralTransform_8, stub_IGeneralTransform_9
+
 HRESULT xaml_event_accept( const char *name, void *iface, void *token );
 
 #endif
