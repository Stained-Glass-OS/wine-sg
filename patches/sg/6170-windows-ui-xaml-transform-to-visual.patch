From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: UIElement.TransformToVisual

UIElement.TransformToVisual was a stub returning nothing, so programs that place things by an element's position got nothing back; NanaZip's "more" button did not open its menu. It now returns a transform from the element's coordinates to the given element's (or the root's): TransformPoint, TryTransform, TransformBounds and Inverse. Our layout only translates elements, so the transform is a translation. Behind the XAML switch of 6131.
---
diff --git a/dlls/windows.ui.xaml/element.c b/dlls/windows.ui.xaml/element.c
index 2bc39b2..5aa56bd 100644
--- a/dlls/windows.ui.xaml/element.c
+++ b/dlls/windows.ui.xaml/element.c
@@ -535,6 +535,116 @@ void uielem_remove_child( struct uielem *parent, struct uielem *child )
 
 /* ---- IUIElement ---- */
 
+/* ---- TransformToVisual: a translation between two elements' coordinates ---- */
+
+struct wpoint { FLOAT X, Y; };
+struct wrect { FLOAT X, Y, Width, Height; };
+
+struct gtransform
+{
+    struct xobj obj;
+    struct xiface IGeneralTransform_iface;
+    FLOAT dx, dy;
+};
+
+static const struct xiface_entry gtransform_ifaces[] =
+{
+    { &IID_IGeneralTransform, offsetof(struct gtransform, IGeneralTransform_iface) },
+};
+
+static const struct xclass gtransform_class =
+{
+    L"Windows.UI.Xaml.Media.MatrixTransform", gtransform_ifaces, ARRAY_SIZE(gtransform_ifaces), NULL,
+};
+
+static struct gtransform *gtransform_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct gtransform, obj );
+}
+
+static IInspectable *gtransform_create( FLOAT dx, FLOAT dy );
+
+static HRESULT WINAPI gtransform_get_Inverse( struct xiface *iface, IInspectable **value )
+{
+    struct gtransform *t = gtransform_from_iface( iface );
+    if (!value) return E_POINTER;
+    return (*value = gtransform_create( -t->dx, -t->dy )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI gtransform_TransformPoint( struct xiface *iface, struct wpoint point, struct wpoint *value )
+{
+    struct gtransform *t = gtransform_from_iface( iface );
+    if (!value) return E_POINTER;
+    value->X = point.X + t->dx;
+    value->Y = point.Y + t->dy;
+    return S_OK;
+}
+
+static HRESULT WINAPI gtransform_TryTransform( struct xiface *iface, struct wpoint point, struct wpoint *out, boolean *ok )
+{
+    if (!out || !ok) return E_POINTER;
+    *ok = TRUE;
+    return gtransform_TransformPoint( iface, point, out );
+}
+
+static HRESULT WINAPI gtransform_TransformBounds( struct xiface *iface, struct wrect rect, struct wrect *value )
+{
+    struct gtransform *t = gtransform_from_iface( iface );
+    if (!value) return E_POINTER;
+    *value = rect;
+    value->X += t->dx;
+    value->Y += t->dy;
+    return S_OK;
+}
+
+static const void *gtransform_vtbl[] =
+{
+    IGeneralTransform_STUBS,
+    [IGeneralTransform_Inverse] = gtransform_get_Inverse,
+    [IGeneralTransform_TransformPoint] = gtransform_TransformPoint,
+    [IGeneralTransform_TryTransform] = gtransform_TryTransform,
+    [IGeneralTransform_TransformBounds] = gtransform_TransformBounds,
+};
+
+static IInspectable *gtransform_create( FLOAT dx, FLOAT dy )
+{
+    struct gtransform *t = calloc( 1, sizeof(*t) );
+
+    if (!t) return NULL;
+    t->IGeneralTransform_iface.vtbl = gtransform_vtbl;
+    t->dx = dx;
+    t->dy = dy;
+    xobj_init( &t->obj, &gtransform_class, NULL );
+    return (IInspectable *)&t->IGeneralTransform_iface;
+}
+
+/* where an element is in its tree's root's coordinates */
+static void elem_origin( struct uielem *elem, FLOAT *x, FLOAT *y )
+{
+    *x = *y = 0;
+    for (; elem; elem = elem->parent)
+    {
+        *x += elem->offset.x;
+        *y += elem->offset.y;
+    }
+}
+
+/* TransformToVisual(visual): from this element's coordinates to visual's (NULL: the root's) */
+static HRESULT WINAPI uielement_TransformToVisual( struct xiface *iface, IInspectable *visual, IInspectable **value )
+{
+    struct uielem *elem = elem_from_iface( iface ), *to = visual ? uielem_from_inspectable( visual ) : NULL;
+    FLOAT x, y, tx = 0, ty = 0;
+
+    if (!value) return E_POINTER;
+    elem_origin( elem, &x, &y );
+    if (to) elem_origin( to, &tx, &ty );
+#ifdef SG_MUTANT_TRANSFORM_IDENTITY
+    x = y = tx = ty = 0;
+#endif
+    TRACE( "%p to %p: %.1f,%.1f\n", elem, to, x - tx, y - ty );
+    return (*value = gtransform_create( x - tx, y - ty )) ? S_OK : E_OUTOFMEMORY;
+}
+
 static HRESULT WINAPI uielement_get_DesiredSize( struct xiface *iface, struct xsize *value )
 {
     if (!value) return E_POINTER;
@@ -649,6 +759,7 @@ static const void *uielement_vtbl[] =
     [IUIElement_GotFocus] = fe_add_GotFocus, [IUIElement_RemoveGotFocus] = fe_remove_GotFocus,
     [IUIElement_LostFocus] = fe_add_LostFocus, [IUIElement_RemoveLostFocus] = fe_remove_LostFocus,
     [IUIElement_DesiredSize] = uielement_get_DesiredSize,
+    [IUIElement_TransformToVisual] = uielement_TransformToVisual,
     [IUIElement_AllowDrop] = uielement_get_AllowDrop,
     [IUIElement_SetAllowDrop] = uielement_put_AllowDrop,
     [IUIElement_Opacity] = uielement_get_Opacity,
