From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] vccorlib140: the 32-bit decorated names (7011)

32-bit C++/CX programs import vccorlib140's x86 names, which 7009 did not export.
The Exception members (Message, HResult) are exported as __thiscall. The free
functions (InitializeData, UninitializeData, GetActivationFactoryByPCWSTR,
__abi_WinRTraiseCOMException) are exported in both their __cdecl (YA) and
__stdcall (YG) decorations, and the no-argument raisers in both (the two
conventions are the same when there are no arguments). The handle's copy
constructor and destructor in the throw data are __thiscall, as the i386 C++
runtime calls them.
---
diff --git a/dlls/vccorlib140/vccorlib.c b/dlls/vccorlib140/vccorlib.c
index 87cdd11..71fe033 100644
--- a/dlls/vccorlib140/vccorlib.c
+++ b/dlls/vccorlib140/vccorlib.c
@@ -228,7 +228,13 @@ static struct eh_catchable_table catchable_tables[CLASS_THROWABLE];
 static struct eh_throw_info throw_infos[CLASS_THROWABLE];
 
 /* the catch block's copy of the handle holds its own reference */
-static void * __cdecl handle_copy_ctor(void **dst, void **src)
+/* the C++ runtime calls these as member functions: __thiscall on i386 */
+#ifndef SG_MUTANT_VCCORLIB_CDECL_HELPERS
+#define EH_MEMBER __thiscall
+#else
+#define EH_MEMBER __cdecl
+#endif
+static void * EH_MEMBER handle_copy_ctor(void **dst, void **src)
 {
     *dst = *src;
     if (*dst) IInspectable_AddRef((IInspectable *)*dst);
@@ -236,7 +242,7 @@ static void * __cdecl handle_copy_ctor(void **dst, void **src)
 }
 
 /* the thrown object releases its reference once the exception is handled */
-static void __cdecl handle_dtor(void **obj)
+static void EH_MEMBER handle_dtor(void **obj)
 {
     if (*obj) IInspectable_Release((IInspectable *)*obj);
 }
@@ -403,6 +409,43 @@ HRESULT __cdecl GetActivationFactoryByPCWSTR(void *name, GUID *iid, void **facto
     return RoGetActivationFactory(str, iid, factory);
 }
 
+#ifdef __i386__
+
+/* 32-bit programs: Exception's members are __thiscall; the free functions are exported in
+ * both their __cdecl and __stdcall decorations */
+
+HSTRING __thiscall Exception_get_Message_thiscall(IInspectable *this)
+{
+    return Exception_get_Message(this);
+}
+
+HRESULT __thiscall Exception_get_HResult_thiscall(IInspectable *this)
+{
+    return Exception_get_HResult(this);
+}
+
+HRESULT __stdcall InitializeData_stdcall(int type)
+{
+    return InitializeData(type);
+}
+
+void __stdcall UninitializeData_stdcall(int type)
+{
+    UninitializeData(type);
+}
+
+HRESULT __stdcall GetActivationFactoryByPCWSTR_stdcall(void *name, GUID *iid, void **factory)
+{
+    return GetActivationFactoryByPCWSTR(name, iid, factory);
+}
+
+void __stdcall __abi_WinRTraiseCOMException_stdcall(HRESULT hr)
+{
+    __abi_WinRTraiseCOMException(hr);
+}
+
+#endif
+
 BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
 {
     if (reason == DLL_PROCESS_ATTACH)
diff --git a/dlls/vccorlib140/vccorlib140.spec b/dlls/vccorlib140/vccorlib140.spec
index dc14992..c9e3534 100644
--- a/dlls/vccorlib140/vccorlib140.spec
+++ b/dlls/vccorlib140/vccorlib140.spec
@@ -1,4 +1,4 @@
-# C++/CX runtime (Platform namespace). The names are the 64-bit mangled ones.
+# C++/CX runtime (Platform namespace): the 64-bit decorated names, then the 32-bit ones
 @ cdecl -arch=win64 ?InitializeData@Details@Platform@@YAJH@Z(long) InitializeData
 @ cdecl -arch=win64 ?UninitializeData@Details@Platform@@YAXH@Z(long) UninitializeData
 @ cdecl -arch=win64 ?GetActivationFactoryByPCWSTR@@YAJPEAXAEAVGuid@Platform@@PEAPEAX@Z(ptr ptr ptr) GetActivationFactoryByPCWSTR
@@ -19,3 +19,41 @@
 @ cdecl -arch=win64 ?__abi_WinRTraiseOutOfBoundsException@@YAXXZ() __abi_WinRTraiseOutOfBoundsException
 @ cdecl -arch=win64 ?__abi_WinRTraiseOutOfMemoryException@@YAXXZ() __abi_WinRTraiseOutOfMemoryException
 @ cdecl -arch=win64 ?__abi_WinRTraiseWrongThreadException@@YAXXZ() __abi_WinRTraiseWrongThreadException
+@ cdecl -arch=i386 ?InitializeData@Details@Platform@@YAJH@Z(long) InitializeData
+@ stdcall -arch=i386 ?InitializeData@Details@Platform@@YGJH@Z(long) InitializeData_stdcall
+@ cdecl -arch=i386 ?UninitializeData@Details@Platform@@YAXH@Z(long) UninitializeData
+@ stdcall -arch=i386 ?UninitializeData@Details@Platform@@YGXH@Z(long) UninitializeData_stdcall
+@ cdecl -arch=i386 ?GetActivationFactoryByPCWSTR@@YAJPAXAAVGuid@Platform@@PAPAX@Z(ptr ptr ptr) GetActivationFactoryByPCWSTR
+@ stdcall -arch=i386 ?GetActivationFactoryByPCWSTR@@YGJPAXAAVGuid@Platform@@PAPAX@Z(ptr ptr ptr) GetActivationFactoryByPCWSTR_stdcall
+@ thiscall -arch=i386 ?get@Message@Exception@Platform@@Q$AAEP$AAVString@3@XZ(ptr) Exception_get_Message_thiscall
+@ thiscall -arch=i386 ?get@HResult@Exception@Platform@@Q$AAEHXZ(ptr) Exception_get_HResult_thiscall
+@ cdecl -arch=i386 ?__abi_WinRTraiseCOMException@@YAXJ@Z(long) __abi_WinRTraiseCOMException
+@ stdcall -arch=i386 ?__abi_WinRTraiseCOMException@@YGXJ@Z(long) __abi_WinRTraiseCOMException_stdcall
+@ cdecl -arch=i386 ?__abi_WinRTraiseAccessDeniedException@@YAXXZ() __abi_WinRTraiseAccessDeniedException
+@ cdecl -arch=i386 ?__abi_WinRTraiseAccessDeniedException@@YGXXZ() __abi_WinRTraiseAccessDeniedException
+@ cdecl -arch=i386 ?__abi_WinRTraiseChangedStateException@@YAXXZ() __abi_WinRTraiseChangedStateException
+@ cdecl -arch=i386 ?__abi_WinRTraiseChangedStateException@@YGXXZ() __abi_WinRTraiseChangedStateException
+@ cdecl -arch=i386 ?__abi_WinRTraiseClassNotRegisteredException@@YAXXZ() __abi_WinRTraiseClassNotRegisteredException
+@ cdecl -arch=i386 ?__abi_WinRTraiseClassNotRegisteredException@@YGXXZ() __abi_WinRTraiseClassNotRegisteredException
+@ cdecl -arch=i386 ?__abi_WinRTraiseDisconnectedException@@YAXXZ() __abi_WinRTraiseDisconnectedException
+@ cdecl -arch=i386 ?__abi_WinRTraiseDisconnectedException@@YGXXZ() __abi_WinRTraiseDisconnectedException
+@ cdecl -arch=i386 ?__abi_WinRTraiseFailureException@@YAXXZ() __abi_WinRTraiseFailureException
+@ cdecl -arch=i386 ?__abi_WinRTraiseFailureException@@YGXXZ() __abi_WinRTraiseFailureException
+@ cdecl -arch=i386 ?__abi_WinRTraiseInvalidArgumentException@@YAXXZ() __abi_WinRTraiseInvalidArgumentException
+@ cdecl -arch=i386 ?__abi_WinRTraiseInvalidArgumentException@@YGXXZ() __abi_WinRTraiseInvalidArgumentException
+@ cdecl -arch=i386 ?__abi_WinRTraiseInvalidCastException@@YAXXZ() __abi_WinRTraiseInvalidCastException
+@ cdecl -arch=i386 ?__abi_WinRTraiseInvalidCastException@@YGXXZ() __abi_WinRTraiseInvalidCastException
+@ cdecl -arch=i386 ?__abi_WinRTraiseNotImplementedException@@YAXXZ() __abi_WinRTraiseNotImplementedException
+@ cdecl -arch=i386 ?__abi_WinRTraiseNotImplementedException@@YGXXZ() __abi_WinRTraiseNotImplementedException
+@ cdecl -arch=i386 ?__abi_WinRTraiseNullReferenceException@@YAXXZ() __abi_WinRTraiseNullReferenceException
+@ cdecl -arch=i386 ?__abi_WinRTraiseNullReferenceException@@YGXXZ() __abi_WinRTraiseNullReferenceException
+@ cdecl -arch=i386 ?__abi_WinRTraiseObjectDisposedException@@YAXXZ() __abi_WinRTraiseObjectDisposedException
+@ cdecl -arch=i386 ?__abi_WinRTraiseObjectDisposedException@@YGXXZ() __abi_WinRTraiseObjectDisposedException
+@ cdecl -arch=i386 ?__abi_WinRTraiseOperationCanceledException@@YAXXZ() __abi_WinRTraiseOperationCanceledException
+@ cdecl -arch=i386 ?__abi_WinRTraiseOperationCanceledException@@YGXXZ() __abi_WinRTraiseOperationCanceledException
+@ cdecl -arch=i386 ?__abi_WinRTraiseOutOfBoundsException@@YAXXZ() __abi_WinRTraiseOutOfBoundsException
+@ cdecl -arch=i386 ?__abi_WinRTraiseOutOfBoundsException@@YGXXZ() __abi_WinRTraiseOutOfBoundsException
+@ cdecl -arch=i386 ?__abi_WinRTraiseOutOfMemoryException@@YAXXZ() __abi_WinRTraiseOutOfMemoryException
+@ cdecl -arch=i386 ?__abi_WinRTraiseOutOfMemoryException@@YGXXZ() __abi_WinRTraiseOutOfMemoryException
+@ cdecl -arch=i386 ?__abi_WinRTraiseWrongThreadException@@YAXXZ() __abi_WinRTraiseWrongThreadException
+@ cdecl -arch=i386 ?__abi_WinRTraiseWrongThreadException@@YGXXZ() __abi_WinRTraiseWrongThreadException
