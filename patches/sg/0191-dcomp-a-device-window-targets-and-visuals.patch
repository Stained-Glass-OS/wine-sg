+static void commit_visual(HWND window, struct composition_visual *visual, float x, float y)
+{
+    IWineDXGICompositionSwapChain *swapchain;
+    unsigned int i;
+
+    x += visual->offset_x;
+    y += visual->offset_y;
+    if (visual->content && SUCCEEDED(IUnknown_QueryInterface(visual->content,
+            &IID_IWineDXGICompositionSwapChain, (void **)&swapchain)))
+    {
+        IWineDXGICompositionSwapChain_set_target(swapchain, window, (int)x, (int)y);
+        IWineDXGICompositionSwapChain_Release(swapchain);
+    }
+    for (i = 0; i < visual->child_count; ++i)
+        commit_visual(window, visual->children[i], x, y);
+}
+
+static HRESULT STDMETHODCALLTYPE device_Commit(IDCompositionDevice *iface)
+{
+    struct composition_device *device = impl_from_IDCompositionDevice(iface);
+    struct composition_target *target;
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&device->cs);
+    for (target = device->targets; target; target = target->next)
+    {
+        if (target->root)
+            commit_visual(target->window, target->root, 0.0f, 0.0f);
+    }
+    LeaveCriticalSection(&device->cs);
+    return S_OK;
+}
