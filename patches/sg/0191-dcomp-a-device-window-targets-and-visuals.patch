+static ULONG STDMETHODCALLTYPE target_Release(IDCompositionTarget *iface)
+{
+    struct composition_target *target = impl_from_IDCompositionTarget(iface);
+    ULONG refcount = InterlockedDecrement(&target->refcount);
+    struct composition_device *device = target->device;
+    struct composition_target **entry;
+
+    TRACE("%p decreasing refcount to %lu.\n", target, refcount);
+
+    if (!refcount)
+    {
+        EnterCriticalSection(&device->cs);
+        for (entry = &device->targets; *entry; entry = &(*entry)->next)
+        {
+            if (*entry != target)
+                continue;
+            *entry = target->next;
+            break;
+        }
+        LeaveCriticalSection(&device->cs);
+        if (target->root)
+            IDCompositionVisual2_Release(&target->root->IDCompositionVisual2_iface);
+        IDCompositionDevice_Release(&device->IDCompositionDevice_iface);
+        free(target);
+    }
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE target_SetRoot(IDCompositionTarget *iface, IDCompositionVisual *visual)
+{
+    struct composition_target *target = impl_from_IDCompositionTarget(iface);
+    struct composition_visual *root = unsafe_impl_from_IDCompositionVisual(visual);
+
+    TRACE("iface %p, visual %p.\n", iface, visual);
+
+    if (visual && !root)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&target->device->cs);
+    if (root)
+        IDCompositionVisual2_AddRef(&root->IDCompositionVisual2_iface);
+    if (target->root)
+        IDCompositionVisual2_Release(&target->root->IDCompositionVisual2_iface);
+    target->root = root;
+    LeaveCriticalSection(&target->device->cs);
+    return S_OK;
+}
