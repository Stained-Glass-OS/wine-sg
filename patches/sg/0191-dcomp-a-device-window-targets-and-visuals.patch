+static HRESULT STDMETHODCALLTYPE visual_AddVisual(IDCompositionVisual2 *iface, IDCompositionVisual *child,
+        BOOL insert_above, IDCompositionVisual *reference)
+{
+    struct composition_visual *visual = impl_from_IDCompositionVisual2(iface);
+    struct composition_visual *child_impl = unsafe_impl_from_IDCompositionVisual(child);
+    struct composition_visual **children;
+    unsigned int capacity;
+
+    TRACE("iface %p, child %p, insert_above %d, reference %p.\n", iface, child, insert_above, reference);
+
+    if (!child_impl)
+        return E_INVALIDARG;
+
+    /* Stacking order does not matter while contents are drawn independently. */
+    if (visual->child_count == visual->child_capacity)
+    {
+        capacity = max(4, visual->child_capacity * 2);
+        if (!(children = realloc(visual->children, capacity * sizeof(*children))))
+            return E_OUTOFMEMORY;
+        visual->children = children;
+        visual->child_capacity = capacity;
+    }
+    IDCompositionVisual2_AddRef(&child_impl->IDCompositionVisual2_iface);
+    visual->children[visual->child_count++] = child_impl;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_RemoveVisual(IDCompositionVisual2 *iface, IDCompositionVisual *child)
+{
+    struct composition_visual *visual = impl_from_IDCompositionVisual2(iface);
+    struct composition_visual *child_impl = unsafe_impl_from_IDCompositionVisual(child);
+    unsigned int i;
+
+    TRACE("iface %p, child %p.\n", iface, child);
+
+    for (i = 0; i < visual->child_count; ++i)
+    {
+        if (visual->children[i] != child_impl)
+            continue;
+        memmove(&visual->children[i], &visual->children[i + 1],
+                (visual->child_count - i - 1) * sizeof(*visual->children));
+        --visual->child_count;
+        IDCompositionVisual2_Release(&child_impl->IDCompositionVisual2_iface);
+        return S_OK;
+    }
+    return E_INVALIDARG;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_RemoveAllVisuals(IDCompositionVisual2 *iface)
+{
+    struct composition_visual *visual = impl_from_IDCompositionVisual2(iface);
+
+    TRACE("iface %p.\n", iface);
+
+    while (visual->child_count)
+        IDCompositionVisual2_Release(&visual->children[--visual->child_count]->IDCompositionVisual2_iface);
+    return S_OK;
+}
