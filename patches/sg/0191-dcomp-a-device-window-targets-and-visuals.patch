+static ULONG STDMETHODCALLTYPE visual_Release(IDCompositionVisual2 *iface)
+{
+    struct composition_visual *visual = impl_from_IDCompositionVisual2(iface);
+    ULONG refcount = InterlockedDecrement(&visual->refcount);
+    unsigned int i;
+
+    TRACE("%p decreasing refcount to %lu.\n", visual, refcount);
+
+    if (!refcount)
+    {
+        if (visual->content)
+            IUnknown_Release(visual->content);
+        for (i = 0; i < visual->child_count; ++i)
+            IDCompositionVisual2_Release(&visual->children[i]->IDCompositionVisual2_iface);
+        free(visual->children);
+        free(visual);
+    }
+    return refcount;
+}
