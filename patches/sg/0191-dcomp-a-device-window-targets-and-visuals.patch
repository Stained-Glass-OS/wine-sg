+static HRESULT STDMETHODCALLTYPE device_CreateTargetForHwnd(IDCompositionDevice *iface, HWND window,
+        BOOL topmost, IDCompositionTarget **out)
+{
+    struct composition_device *device = impl_from_IDCompositionDevice(iface);
+    struct composition_target *target, *existing;
+    DWORD pid;
+
+    TRACE("iface %p, window %p, topmost %d, out %p.\n", iface, window, topmost, out);
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    /* Only the process that owns a window may compose into it. */
+    if (!IsWindow(window) || !GetWindowThreadProcessId(window, &pid) || pid != GetCurrentProcessId())
+        return E_INVALIDARG;
+
+    if (!(target = calloc(1, sizeof(*target))))
+        return E_OUTOFMEMORY;
+    target->IDCompositionTarget_iface.lpVtbl = &composition_target_vtbl;
+    target->refcount = 1;
+    target->device = device;
+    target->window = window;
+    IDCompositionDevice_AddRef(&device->IDCompositionDevice_iface);
+
+    EnterCriticalSection(&device->cs);
+    for (existing = device->targets; existing; existing = existing->next)
+    {
+        if (existing->window == window)
+        {
+            LeaveCriticalSection(&device->cs);
+            WARN("Window %p already has a target.\n", window);
+            IDCompositionDevice_Release(&device->IDCompositionDevice_iface);
+            free(target);
+            return DCOMPOSITION_ERROR_WINDOW_ALREADY_COMPOSED;
+        }
+    }
+    target->next = device->targets;
+    device->targets = target;
+    LeaveCriticalSection(&device->cs);
+
+    *out = &target->IDCompositionTarget_iface;
+    return S_OK;
