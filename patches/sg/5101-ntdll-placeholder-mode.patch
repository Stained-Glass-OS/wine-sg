From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntdll: placeholder compatibility mode (patch 5101)

Keep the process/thread mode in the PEB/TEB and export the set/thread
functions; gap-CORE item 367. Gate with three mutants.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/ntdll/rtl.c b/dlls/ntdll/rtl.c
--- a/dlls/ntdll/rtl.c
+++ b/dlls/ntdll/rtl.c
@@ -1714,13 +1714,78 @@
     return STATUS_NOT_FOUND;
 }
 
+/* The placeholder compatibility mode says whether files that are cloud placeholders show their
+ * reparse point, sparse and offline attributes (exposed) or look like normal files (disguised).
+ * The process has one mode (PEB) and each thread may override it (TEB). There are no placeholder
+ * files here, so the mode is kept and handed back, as the documented functions do. */
+static char placeholder_mode_valid( char mode )
+{
+    return mode >= PHCM_APPLICATION_DEFAULT && mode <= PHCM_MAX;
+}
+
 /*********************************************************************
  *           RtlQueryProcessPlaceholderCompatibilityMode [NTDLL.@]
  */
 char WINAPI RtlQueryProcessPlaceholderCompatibilityMode(void)
 {
-    FIXME("stub\n");
-    return PHCM_APPLICATION_DEFAULT;
+    PEB *peb = NtCurrentTeb()->Peb;
+
+    if (!peb) return PHCM_ERROR_NO_PEB;
+    return peb->PlaceholderCompatibilityMode;
+}
+
+/*********************************************************************
+ *           RtlSetProcessPlaceholderCompatibilityMode [NTDLL.@]
+ */
+char WINAPI RtlSetProcessPlaceholderCompatibilityMode( char mode )
+{
+    PEB *peb = NtCurrentTeb()->Peb;
+    char old;
+
+    TRACE( "%d\n", mode );
+
+    if (!peb) return PHCM_ERROR_NO_PEB;
+#ifndef SG_MUTANT_PHCM_RANGE
+    if (!placeholder_mode_valid( mode )) return PHCM_ERROR_INVALID_PARAMETER;
+#endif
+    old = peb->PlaceholderCompatibilityMode;
+    peb->PlaceholderCompatibilityMode = mode;
+#ifdef SG_MUTANT_PHCM_RET
+    return mode;
+#endif
+    return old;
+}
+
+/*********************************************************************
+ *           RtlQueryThreadPlaceholderCompatibilityMode [NTDLL.@]
+ */
+char WINAPI RtlQueryThreadPlaceholderCompatibilityMode(void)
+{
+    TEB *teb = NtCurrentTeb();
+
+    if (!teb) return PHCM_ERROR_NO_TEB;
+    return teb->PlaceholderCompatibilityMode;
+}
+
+/*********************************************************************
+ *           RtlSetThreadPlaceholderCompatibilityMode [NTDLL.@]
+ */
+char WINAPI RtlSetThreadPlaceholderCompatibilityMode( char mode )
+{
+    TEB *teb = NtCurrentTeb();
+    char old;
+
+    TRACE( "%d\n", mode );
+
+    if (!teb) return PHCM_ERROR_NO_TEB;
+    if (!placeholder_mode_valid( mode )) return PHCM_ERROR_INVALID_PARAMETER;
+    old = teb->PlaceholderCompatibilityMode;
+#ifdef SG_MUTANT_PHCM_THREAD
+    teb->Peb->PlaceholderCompatibilityMode = mode;
+#else
+    teb->PlaceholderCompatibilityMode = mode;
+#endif
+    return old;
 }
 
 /*********************************************************************
diff --git a/dlls/ntdll/ntdll.spec b/dlls/ntdll/ntdll.spec
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -960,6 +960,7 @@
 @ stdcall RtlQueryRegistryValuesEx(long ptr ptr ptr ptr) RtlQueryRegistryValues
 @ stub RtlQuerySecurityObject
 @ stub RtlQueryTagHeap
+@ stdcall RtlQueryThreadPlaceholderCompatibilityMode()
 @ stdcall RtlQueryTimeZoneInformation(ptr)
 @ stdcall RtlQueryUnbiasedInterruptTime(ptr)
 @ stub RtlQueueApcWow64Thread
@@ -1025,6 +1026,7 @@
 # @ stub RtlSetMemoryStreamSize
 @ stdcall RtlSetOwnerSecurityDescriptor(ptr ptr long)
 # @ stub RtlSetProcessIsCritical
+@ stdcall RtlSetProcessPlaceholderCompatibilityMode(long)
 @ stdcall RtlSetProcessPreferredUILanguages(long ptr ptr)
 @ stub RtlSetProperties
 @ stub RtlSetPropertyClassId
@@ -1037,6 +1039,7 @@
 # @ stub RtlSetSecurityObjectEx
 @ stdcall RtlSetThreadErrorMode(long ptr)
 # @ stub RtlSetThreadIsCritical
+@ stdcall RtlSetThreadPlaceholderCompatibilityMode(long)
 @ stdcall RtlSetThreadPreferredUILanguages(long ptr ptr)
 # @ stub RtlSetThreadPoolStartFunc
 @ stdcall RtlSetTimeZoneInformation(ptr)
