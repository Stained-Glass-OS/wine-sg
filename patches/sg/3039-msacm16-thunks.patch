+/***********************************************************************
+ * 		acmFormatDetails (MSACM.41)
+ */
+MMRESULT16 WINAPI acmFormatDetails16(
+  HACMDRIVER16 had, LPACMFORMATDETAILS16 pafd, DWORD fdwDetails)
+{
+  ACMFORMATDETAILSA details;
+  HACMDRIVER drv = NULL;
+  MMRESULT res;
+
+  TRACE("(0x%04x, %p, %ld)\n", had, pafd, fdwDetails);
+
+  if(!pafd || pafd->cbStruct < sizeof(*pafd) || !pafd->pwfx) return MMSYSERR_INVALPARAM;
+  if(had && !(drv = get_handle(had))) return MMSYSERR_INVALHANDLE;
+
+  /* the format pointer in the structure is a 16 bit pointer */
+  memcpy(&details, pafd, FIELD_OFFSET(ACMFORMATDETAILSA, pwfx));
+  details.cbStruct = sizeof(details);
+  details.pwfx = MapSL((SEGPTR)pafd->pwfx);
+  details.cbwfx = pafd->cbwfx;
+  memcpy(details.szFormat, pafd->szFormat, sizeof(details.szFormat));
+
+  res = acmFormatDetailsA(drv, &details, fdwDetails);
+  if(res != MMSYSERR_NOERROR) return res;
+
+  pafd->dwFormatIndex = details.dwFormatIndex;
+  pafd->dwFormatTag = details.dwFormatTag;
+  pafd->fdwSupport = details.fdwSupport;
+  pafd->cbwfx = details.cbwfx;
+  memcpy(pafd->szFormat, details.szFormat, sizeof(pafd->szFormat));
+  return MMSYSERR_NOERROR;
+}
+
+/***********************************************************************
+ * 		acmFormatSuggest (MSACM.45)
+ */
