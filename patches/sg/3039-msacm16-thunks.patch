+  struct formattag_context *ctx = (struct formattag_context *)instance;
+  WORD args[7];
+  DWORD ret = FALSE;
+  WORD h16 = alloc_handle(hadid, KIND_DRIVERID);
+  SEGPTR seg;
+
+  if(!h16) return FALSE;
+
+  /* the callee sees the caller's structure */
+  memcpy(ctx->details16, paftd, sizeof(*ctx->details16));
+  seg = MapLS(ctx->details16);
+  args[6] = h16;
+  args[5] = SELECTOROF(seg);
+  args[4] = OFFSETOF(seg);
+  args[3] = HIWORD(ctx->instance);
+  args[2] = LOWORD(ctx->instance);
+  args[1] = HIWORD(support);
+  args[0] = LOWORD(support);
+  WOWCallback16Ex((DWORD)ctx->callback, WCB16_PASCAL, sizeof(args), args, &ret);
+  UnMapLS(seg);
+  return LOWORD(ret) != 0;
 }
 
