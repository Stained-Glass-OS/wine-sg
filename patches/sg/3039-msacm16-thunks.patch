 #include "wineacm16.h"
 #include "wine/debug.h"
 
@@ -53,6 +55,71 @@ DWORD WINAPI acmGetVersion16(void)
   return acmGetVersion();
 }
 
+/* The 16 bit handles are small numbers mapped to the 32 bit ACM handles. */
+
+#define MAX_HANDLES 256
+
+static struct
+{
+    void *h32;
+    DWORD kind;
+} handles[MAX_HANDLES];
+
+static CRITICAL_SECTION handles_cs;
+static CRITICAL_SECTION_DEBUG handles_cs_debug =
+{
+    0, 0, &handles_cs,
+    { &handles_cs_debug.ProcessLocksList, &handles_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": handles_cs") }
+};
+static CRITICAL_SECTION handles_cs = { &handles_cs_debug, -1, 0, 0, 0, 0 };
+
+/* an existing handle for the object is reused */
+static WORD alloc_handle(void *h32, DWORD kind)
+{
+    WORD i, ret = 0;
+
+    EnterCriticalSection(&handles_cs);
+    for (i = 0; i < MAX_HANDLES; i++)
+        if (handles[i].h32 == h32 && handles[i].kind == kind) { ret = i + 1; break; }
+    if (!ret)
+    {
+        for (i = 0; i < MAX_HANDLES; i++)
+            if (!handles[i].h32)
+            {
+                handles[i].h32 = h32;
+                handles[i].kind = kind;
+                ret = i + 1;
+                break;
+            }
+    }
+    LeaveCriticalSection(&handles_cs);
+    return ret;
+}
+
+static void *get_handle(WORD h16)
+{
+    void *ret = NULL;
+
+    if (!h16 || h16 > MAX_HANDLES) return NULL;
+    EnterCriticalSection(&handles_cs);
+    ret = handles[h16 - 1].h32;
+    LeaveCriticalSection(&handles_cs);
+    return ret;
+}
+
+static void free_handle(WORD h16)
+{
+    if (!h16 || h16 > MAX_HANDLES) return;
+    EnterCriticalSection(&handles_cs);
+    handles[h16 - 1].h32 = NULL;
+    LeaveCriticalSection(&handles_cs);
+}
+
+#define KIND_DRIVERID 1
+#define KIND_DRIVER   2
+#define KIND_STREAM   3
+
