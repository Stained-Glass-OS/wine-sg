+#define STATUS_PREPARED16 ACMSTREAMHEADER_STATUSF_PREPARED
+
+/* the stream header of a 16 bit caller holds 16 bit pointers */
+static void header16_to_32(const ACMSTREAMHEADER *h16, ACMSTREAMHEADER *h32)
+{
+  memset(h32, 0, sizeof(*h32));
+  h32->cbStruct = sizeof(*h32);
+  h32->fdwStatus = h16->fdwStatus & ~(ACMSTREAMHEADER_STATUSF_PREPARED | ACMSTREAMHEADER_STATUSF_INQUEUE);
+  h32->dwUser = h16->dwUser;
+  h32->pbSrc = MapSL((SEGPTR)h16->pbSrc);
+  h32->cbSrcLength = h16->cbSrcLength;
+  h32->cbSrcLengthUsed = h16->cbSrcLengthUsed;
+  h32->dwSrcUser = h16->dwSrcUser;
+  h32->pbDst = MapSL((SEGPTR)h16->pbDst);
+  h32->cbDstLength = h16->cbDstLength;
+  h32->cbDstLengthUsed = h16->cbDstLengthUsed;
+  h32->dwDstUser = h16->dwDstUser;
 }
 
