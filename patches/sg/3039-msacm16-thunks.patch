+  HACMOBJ obj = NULL;
 
-  if(!hao) return acmMetrics(0, uMetric, pMetric);
-  SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-  return MMSYSERR_ERROR;
+  TRACE("(0x%04x, %d, %p)\n", hao, uMetric, pMetric);
+
+  if(hao && !(obj = get_handle(hao))) return MMSYSERR_INVALHANDLE;
+  return acmMetrics(obj, uMetric, pMetric);
+}
+
+struct enum_context
+{
+  FARPROC16 callback;
+  DWORD instance;
+};
+
+static BOOL CALLBACK driver_enum_proc(HACMDRIVERID hadid, DWORD_PTR instance, DWORD support)
+{
+  struct enum_context *ctx = (struct enum_context *)instance;
+  WORD args[5];
+  DWORD ret = FALSE;
+  WORD h16 = alloc_handle(hadid, KIND_DRIVERID);
+
+  if(!h16) return FALSE;
+
+  /* first argument pushed first: HACMDRIVERID16 hadid, DWORD dwInstance, DWORD fdwSupport */
+  args[4] = h16;
+  args[3] = HIWORD(ctx->instance);
+  args[2] = LOWORD(ctx->instance);
+  args[1] = HIWORD(support);
+  args[0] = LOWORD(support);
+  WOWCallback16Ex((DWORD)ctx->callback, WCB16_PASCAL, sizeof(args), args, &ret);
+  return LOWORD(ret) != 0;
 }
 
