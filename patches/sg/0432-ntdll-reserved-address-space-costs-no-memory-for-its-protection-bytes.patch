--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -954,6 +954,33 @@
  *
  * Set a range of page protection bytes.
  */
+#ifdef _WIN64
+/* Fill protection bytes. Reserved, inaccessible address space (what programs
+ * reserve by the gigabyte: V8's and PartitionAlloc's 16 and 32 GB cages in
+ * every Chromium renderer) has protection 0; writing those zeros made every
+ * page of the table resident -- 8 MB for each 32 GB reserved, over 400 MB in
+ * one Chrome renderer. Whole pages of zeros are dropped instead: the table is
+ * anonymous memory, which reads back as zeros without taking any. */
+static void fill_vprot_bytes( BYTE *ptr, BYTE vprot, size_t count )
+{
+#ifdef __linux__
+    if (!vprot && count >= 2 * (page_mask + 1))
+    {
+        BYTE *start = ROUND_ADDR( ptr + page_mask, page_mask );
+        BYTE *end = ROUND_ADDR( ptr + count, page_mask );
+
+        if (end > start && !madvise( start, end - start, MADV_DONTNEED ))
+        {
+            memset( ptr, 0, start - ptr );
+            memset( end, 0, ptr + count - end );
+            return;
+        }
+    }
+#endif
+    memset( ptr, vprot, count );
+}
+#endif
+
 static void set_page_vprot( const void *addr, size_t size, BYTE vprot )
 {
     size_t idx = (size_t)addr >> page_shift;
@@ -963,10 +990,10 @@
