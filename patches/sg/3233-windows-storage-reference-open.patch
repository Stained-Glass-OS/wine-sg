From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:18:47 -0700
Subject: [PATCH] windows.storage: RandomAccessStreamReference OpenReadAsync,
 CreateFromUri (3233)

OpenReadAsync gives a read-only copy of the referenced stream at the start
with its content type; CreateFromUri references a file: or http(s): address
that is opened (downloaded for http) when asked for.

diff --git a/dlls/windows.storage/item.c b/dlls/windows.storage/item.c
index e5b59e2..3c2e981 100644
--- a/dlls/windows.storage/item.c
+++ b/dlls/windows.storage/item.c
@@ -2675,6 +2675,67 @@ static HRESULT streamed_uri_source( IUriRuntimeClass *uri, WCHAR **path )
     return hr;
 }
 
+/* The read-only stream behind CreateFromUri: the local file, or the download of an http(s) address into a
+ * temporary file that goes away when the stream is closed.  The content type is the one the file name
+ * extension registers (GUESS for downloads: the Content-Type header would be better). */
+HRESULT uri_open_read( IUriRuntimeClass *uri, IRandomAccessStream **stream )
+{
+    WCHAR *source, type[128], temp_dir[MAX_PATH], temp[MAX_PATH], *name_part;
+    BOOL download;
+    HANDLE file;
+    HRESULT hr;
+
+    *stream = NULL;
+    if (FAILED( hr = streamed_uri_source( uri, &source ) )) return hr;
+    download = hr == S_FALSE;
+    if (download)
+    {
+        WCHAR *cut;
+
+        if (!GetTempPathW( ARRAY_SIZE(temp_dir), temp_dir ) || !GetTempFileNameW( temp_dir, L"sgu", 0, temp ))
+        {
+            free( source );
+            return hr_last_error();
+        }
+        if (FAILED( hr = download_url( source, temp )))
+        {
+            DeleteFileW( temp );
+            free( source );
+            return hr;
+        }
+        /* the extension of the address, without query or fragment */
+#ifndef SG_MUTANT_URI_QUERY
+        if ((cut = wcspbrk( source, L"?#" ))) *cut = 0;
+#endif
+        for (name_part = source; (cut = wcspbrk( name_part, L"/" )); name_part = cut + 1) ;
+        file = CreateFileW( temp, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING,
+                            FILE_ATTRIBUTE_NORMAL
+#ifndef SG_MUTANT_URI_KEEP
+                            | FILE_FLAG_DELETE_ON_CLOSE
+#endif
+                            , NULL );
+        if (file == INVALID_HANDLE_VALUE) DeleteFileW( temp );
+#ifdef SG_MUTANT_URI_HTTPTYPE
+        name_part = (WCHAR *)L"";
+#endif
+        content_type_for( name_part, type, ARRAY_SIZE(type) );
+    }
+    else
+    {
+        file = CreateFileW( source, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                            OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+        content_type_for( source, type, ARRAY_SIZE(type) );
+    }
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        hr = hr_last_error();
+        free( source );
+        return hr;
+    }
+    free( source );
+    return file_stream_create( file, FALSE, type, stream );
+}
+
 static HRESULT streamed_from_uri( HSTRING name, IStorageFile *replace, IUriRuntimeClass *uri,
                                   IAsyncOperation_StorageFile **operation )
 {
