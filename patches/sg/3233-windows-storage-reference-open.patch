@@ -737,11 +749,95 @@ static HRESULT WINAPI reference_GetTrustLevel( IRandomAccessStreamReference *ifa
     return S_OK;
 }
 
+/* A read-only stream at the start over a copy of the bytes the referenced stream holds, with the
+ * content type of the stream (empty when it has none: GUESS).  A stream of another implementation
+ * is returned as it is when it can already tell its content type. */
+static HRESULT reference_open_read( IRandomAccessStream *src, IRandomAccessStream **out )
+{
+    struct memory_stream *mem;
+    struct stream_data *data, *copy;
+    IRandomAccessStream *stream;
+    HRESULT hr;
+
+    *out = NULL;
+    if (src->lpVtbl != &stream_vtbl)
+    {
+        if (SUCCEEDED(hr = IRandomAccessStream_QueryInterface( src, &IID_IRandomAccessStreamWithContentType, (void **)out )))
+            return hr;
+        return E_NOINTERFACE;
+    }
+    mem = impl_from_IRandomAccessStream( src );
+    if (mem->closed) return RO_E_CLOSED;
+    data = mem->data;
+
+    if (FAILED(hr = memory_stream_create( NULL, 0, &stream ))) return hr;
+    copy = impl_from_IRandomAccessStream( stream )->data;
+    if (data)
+    {
+        EnterCriticalSection( &data->cs );
+        if (!data->file)
+        {
+            if (data->size && !(copy->bytes = malloc( data->size ))) hr = E_OUTOFMEMORY;
+            else
+            {
+                if (data->size) memcpy( copy->bytes, data->bytes, data->size );
+#ifdef SG_MUTANT_REF_NOSIZE
+                copy->size = copy->capacity = 0;
+#else
+                copy->size = copy->capacity = data->size;
+#endif
+            }
+        }
+        else
+        {
+            UINT64 size = data_get_size( data ), pos = 0;
+            UINT32 done;
+
+            if (size > 0x7fffffff || (size && !(copy->bytes = malloc( size )))) hr = E_OUTOFMEMORY;
+            while (SUCCEEDED(hr) && pos < size)
+            {
+                hr = data_read( data, pos, copy->bytes + pos, min( size - pos, 0x10000 ), &done );
+                if (SUCCEEDED(hr) && !done) break;
+                pos += done;
+            }
+            copy->size = copy->capacity = pos;
+        }
+#ifdef SG_MUTANT_REF_NOTYPE
+        copy->content_type = wcsdup( L"" );
+#else
+        copy->content_type = wcsdup( data->content_type ? data->content_type : L"" );
+#endif
+        LeaveCriticalSection( &data->cs );
+    }
+    else copy->content_type = wcsdup( L"" );
+    if (SUCCEEDED(hr) && !copy->content_type) hr = E_OUTOFMEMORY;
+    if (FAILED(hr))
+    {
+        IRandomAccessStream_Release( stream );
+        return hr;
+    }
+    copy->read_only = TRUE;
+    *out = stream;
+    return S_OK;
+}
+
 static HRESULT WINAPI reference_OpenReadAsync( IRandomAccessStreamReference *iface,
                                                IAsyncOperation_IRandomAccessStreamWithContentType **operation )
 {
-    FIXME( "iface %p, operation %p stub!\n", iface, operation );
-    return E_NOTIMPL;
+    struct stream_reference *impl = impl_from_IRandomAccessStreamReference( iface );
+    IRandomAccessStream *stream;
+    HRESULT hr;
+
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    if (!operation) return E_POINTER;
+    if (impl->uri) hr = uri_open_read( impl->uri, &stream );
+    else hr = reference_open_read( impl->stream, &stream );
+    hr = async_ptr_create( &IID_IAsyncOperation_IRandomAccessStreamWithContentType,
+                           L"Windows.Foundation.IAsyncOperation`1<Windows.Storage.Streams.IRandomAccessStreamWithContentType>",
+                           SUCCEEDED(hr) ? (IUnknown *)stream : NULL, hr, (void **)operation );
+    if (stream && SUCCEEDED(hr)) IRandomAccessStream_Release( stream );
+    return hr;
 }
 
 static const struct IRandomAccessStreamReferenceVtbl reference_vtbl =
@@ -826,8 +922,17 @@ static HRESULT WINAPI reference_statics_CreateFromFile( IRandomAccessStreamRefer
 static HRESULT WINAPI reference_statics_CreateFromUri( IRandomAccessStreamReferenceStatics *iface, IUriRuntimeClass *uri,
                                                        IRandomAccessStreamReference **reference )
 {
-    FIXME( "iface %p, uri %p, reference %p stub!\n", iface, uri, reference );
-    return E_NOTIMPL;
+    struct stream_reference *impl;
+
+    TRACE( "iface %p, uri %p, reference %p.\n", iface, uri, reference );
+
+    if (!uri || !reference) return E_POINTER;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IRandomAccessStreamReference_iface.lpVtbl = &reference_vtbl;
+    impl->ref = 1;
+    IUriRuntimeClass_AddRef( (impl->uri = uri) );
+    *reference = &impl->IRandomAccessStreamReference_iface;
+    return S_OK;
 }
 
 static HRESULT WINAPI reference_statics_CreateFromStream( IRandomAccessStreamReferenceStatics *iface,
