@@ -65,6 +66,8 @@ static HRESULT data_set_size( struct stream_data *data, UINT64 value )
 {
     LARGE_INTEGER pos;
 
+    if (data->read_only) return E_ACCESSDENIED;
+
     if (!data->file)
     {
         if (!stream_data_reserve( data, value )) return E_OUTOFMEMORY;
@@ -104,6 +107,9 @@ static HRESULT data_read( struct stream_data *data, UINT64 position, BYTE *dst,
 
 static HRESULT data_write( struct stream_data *data, UINT64 position, const BYTE *src, UINT32 length )
 {
+#ifndef SG_MUTANT_REF_READONLY
