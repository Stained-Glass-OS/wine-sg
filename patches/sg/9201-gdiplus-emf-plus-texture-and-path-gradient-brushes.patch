From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: EMF+ texture and path gradient brushes are recorded and played

Recording a fill or a pen with a TextureBrush or a PathGradientBrush into an EMF+
metafile failed with NotImplemented (System.Drawing programs drawing into a
Metafile got NotImplementedException), and a path gradient brush object in a
metafile ([MS-EMFPLUS] 2.2.2.29 EmfPlusPathGradientBrushData) was not read, so
its fill was dropped. As Windows does: a texture brush is written with its
image (an EmfPlusImage holding a PNG, as an image object) and its transform; a
path gradient with its centre, surround colours, boundary path, transform,
blend or preset colours, focus scales and gamma flag; both forms of the
boundary (path or points) are read back.
---
--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -265,6 +265,18 @@
     BYTE OptionalData[1];
 } EmfPlusTextureBrushData;
 
+/* [MS-EMFPLUS] 2.2.2.29 EmfPlusPathGradientBrushData: the fixed part; the surrounding colors, the
+ * boundary (EmfPlusBoundaryPathData or EmfPlusBoundaryPointData) and the optional data follow. */
+typedef struct EmfPlusPathGradientBrushData
+{
+    DWORD BrushDataFlags;
+    INT WrapMode;
+    EmfPlusARGB CenterColor;
+    EmfPlusPointF CenterPointF;
+    DWORD SurroundingColorCount;
+    EmfPlusARGB SurroundingColor[1];
+} EmfPlusPathGradientBrushData;
+
 typedef struct EmfPlusRectF
 {
     float X;
@@ -294,6 +306,7 @@
         EmfPlusHatchBrushData hatch;
         EmfPlusTextureBrushData texture;
         EmfPlusLinearGradientBrushData lineargradient;
+        EmfPlusPathGradientBrushData pathgradient;
     } BrushData;
 } EmfPlusBrush;
 
@@ -1062,8 +1075,31 @@
     return TRUE;
 }
 
-static GpStatus METAFILE_PrepareBrushData(GDIPCONST GpBrush *brush, DWORD *size)
+static GpStatus METAFILE_CreateCompressedImageStream(GpImage *image, IStream **stream, DWORD *size);
+static GpStatus METAFILE_FillEmfPlusBitmap(EmfPlusBitmap *record, IStream *stream, DWORD size);
+
+/* the optional data both gradient brushes share: blend colors or factors */
+static DWORD gradient_blend_size(INT pcount, const ARGB *pcolors, const REAL *ppos, INT count, const REAL *fac,
+                                 const REAL *pos)
+{
+    if (pcount > 1 && pcolors && ppos)
+        return sizeof(DWORD) + pcount * (sizeof(*pcolors) + sizeof(*ppos));
+    if (count > 1 && fac && pos)
+        return sizeof(DWORD) + count * (sizeof(*fac) + sizeof(*pos));
+    return 0;
+}
+
+static BOOL pathgradient_has_focus(const GpPathGradient *gradient)
 {
+    return gradient->focus.X != 0.0f || gradient->focus.Y != 0.0f;
+}
+
+/* A brush object's size. A texture brush carries its image (an EmfPlusImage holding a PNG, as an image
+ * object does): *image receives that stream, which METAFILE_FillBrushData reads and the caller releases. */
+static GpStatus METAFILE_PrepareBrushData(GDIPCONST GpBrush *brush, DWORD *size, IStream **image)
+{
+    *image = NULL;
+
     switch (brush->bt)
     {
     case BrushTypeSolidColor:
@@ -1092,6 +1128,48 @@
 
         break;
     }
+#ifndef SG_MUTANT_EMFP_NO_TEXTURE_PATHGRADIENT
+    case BrushTypeTextureFill:
+    {
+        GpTexture *texture = (GpTexture *)brush;
+        BOOL identity;
+        DWORD image_size;
+        GpStatus stat;
+
+        if (texture->image->type != ImageTypeBitmap)
+        {
+            FIXME("texture brush of image type %d\n", texture->image->type);
+            return NotImplemented;
+        }
+        stat = METAFILE_CreateCompressedImageStream(texture->image, image, &image_size);
+        if (stat != Ok) return stat;
+
+        *size = FIELD_OFFSET(EmfPlusBrush, BrushData.texture.OptionalData);
+        GdipIsMatrixIdentity(&texture->transform, &identity);
+        if (!identity)
+            *size += sizeof(EmfPlusTransformMatrix);
+        *size += FIELD_OFFSET(EmfPlusImage, ImageData.bitmap.BitmapData) + ((image_size + 3) & ~3);
+        break;
+    }
+    case BrushTypePathGradient:
+    {
+        GpPathGradient *gradient = (GpPathGradient *)brush;
+        BOOL identity;
+
+        *size = FIELD_OFFSET(EmfPlusBrush, BrushData.pathgradient.SurroundingColor)
+              + gradient->surroundcolorcount * sizeof(EmfPlusARGB);
+        /* EmfPlusBoundaryPathData: the size, then the path */
+        *size += sizeof(DWORD) + write_path_data(gradient->path, NULL);
+        GdipIsMatrixIdentity(&gradient->transform, &identity);
+        if (!identity)
+            *size += sizeof(EmfPlusTransformMatrix);
+        *size += gradient_blend_size(gradient->pblendcount, gradient->pblendcolor, gradient->pblendpos,
+                gradient->blendcount, gradient->blendfac, gradient->blendpos);
+        if (pathgradient_has_focus(gradient))
+            *size += sizeof(DWORD) + 2 * sizeof(float);
+        break;
+    }
+#endif
     default:
         FIXME("unsupported brush type: %d\n", brush->bt);
         return NotImplemented;
@@ -1100,7 +1178,37 @@
     return Ok;
 }
 
-static void METAFILE_FillBrushData(GDIPCONST GpBrush *brush, EmfPlusBrush *data)
+static BYTE *fill_gradient_blend(BYTE *cursor, DWORD *flags, INT pcount, const ARGB *pcolors, const REAL *ppos,
+                                 INT count, const REAL *fac, const REAL *pos)
+{
+    DWORD n;
+
+    if (pcount > 1 && pcolors && ppos)
+    {
+        *flags |= BrushDataPresetColors;
+        n = pcount;
+        memcpy(cursor, &n, sizeof(n));
+        cursor += sizeof(n);
+        memcpy(cursor, ppos, n * sizeof(*ppos));
+        cursor += n * sizeof(*ppos);
+        memcpy(cursor, pcolors, n * sizeof(*pcolors));
+        cursor += n * sizeof(*pcolors);
+    }
+    else if (count > 1 && fac && pos)
+    {
+        *flags |= BrushDataBlendFactorsH;
+        n = count;
+        memcpy(cursor, &n, sizeof(n));
+        cursor += sizeof(n);
+        memcpy(cursor, pos, n * sizeof(*pos));
+        cursor += n * sizeof(*pos);
+        memcpy(cursor, fac, n * sizeof(*fac));
+        cursor += n * sizeof(*fac);
+    }
+    return cursor;
+}
+
+static void METAFILE_FillBrushData(GDIPCONST GpBrush *brush, EmfPlusBrush *data, IStream *image)
 {
     data->Version = VERSION_MAGIC2;
     data->Type = brush->bt;
@@ -1182,6 +1290,79 @@
 
         break;
     }
+    case BrushTypeTextureFill:
+    {
+        GpTexture *texture = (GpTexture *)brush;
+        EmfPlusImage *image_data;
+        BYTE *cursor = data->BrushData.texture.OptionalData;
+        BOOL identity;
+        STATSTG statstg;
+        DWORD image_size = 0;
+
+        data->BrushData.texture.BrushDataFlags = 0;
+        data->BrushData.texture.WrapMode = texture->imageattributes->wrap;
+        GdipIsMatrixIdentity(&texture->transform, &identity);
+        if (!identity)
+        {
+            data->BrushData.texture.BrushDataFlags |= BrushDataTransform;
+            memcpy(cursor, &texture->transform, sizeof(EmfPlusTransformMatrix));
+            cursor += sizeof(EmfPlusTransformMatrix);
+        }
+        image_data = (EmfPlusImage *)cursor;
+        image_data->Version = VERSION_MAGIC2;
+        image_data->Type = ImageDataTypeBitmap;
+        if (image && SUCCEEDED(IStream_Stat(image, &statstg, STATFLAG_NONAME)))
+            image_size = statstg.cbSize.u.LowPart;
+        memset(image_data->ImageData.bitmap.BitmapData, 0, (image_size + 3) & ~3);
+        if (image) METAFILE_FillEmfPlusBitmap(&image_data->ImageData.bitmap, image, image_size);
+        break;
+    }
+    case BrushTypePathGradient:
+    {
+        GpPathGradient *gradient = (GpPathGradient *)brush;
+        EmfPlusPathGradientBrushData *grad_data = &data->BrushData.pathgradient;
+        BYTE *cursor;
+        DWORD path_size;
+        BOOL identity;
+
+        grad_data->BrushDataFlags = BrushDataPath;
+        if (gradient->gamma)
+            grad_data->BrushDataFlags |= BrushDataIsGammaCorrected;
+        grad_data->WrapMode = gradient->wrap;
+        grad_data->CenterColor = gradient->centercolor;
+        grad_data->CenterPointF.X = gradient->center.X;
+        grad_data->CenterPointF.Y = gradient->center.Y;
+        grad_data->SurroundingColorCount = gradient->surroundcolorcount;
+        memcpy(grad_data->SurroundingColor, gradient->surroundcolors,
+                gradient->surroundcolorcount * sizeof(EmfPlusARGB));
+        cursor = (BYTE *)(grad_data->SurroundingColor + gradient->surroundcolorcount);
+
+        path_size = write_path_data(gradient->path, NULL);
+        memcpy(cursor, &path_size, sizeof(path_size));
+        cursor += sizeof(path_size);
+        memset(cursor, 0, path_size);
+        write_path_data(gradient->path, cursor);
+        cursor += path_size;
+
+        GdipIsMatrixIdentity(&gradient->transform, &identity);
+        if (!identity)
+        {
+            grad_data->BrushDataFlags |= BrushDataTransform;
+            memcpy(cursor, &gradient->transform, sizeof(EmfPlusTransformMatrix));
+            cursor += sizeof(EmfPlusTransformMatrix);
+        }
+        cursor = fill_gradient_blend(cursor, &grad_data->BrushDataFlags, gradient->pblendcount, gradient->pblendcolor,
+                gradient->pblendpos, gradient->blendcount, gradient->blendfac, gradient->blendpos);
+        if (pathgradient_has_focus(gradient))
+        {
+            DWORD two = 2;
+            grad_data->BrushDataFlags |= BrushDataFocusScales;
+            memcpy(cursor, &two, sizeof(two));
+            memcpy(cursor + 4, &gradient->focus.X, sizeof(float));
+            memcpy(cursor + 8, &gradient->focus.Y, sizeof(float));
+        }
+        break;
+    }
     default:
         FIXME("unsupported brush type: %d\n", brush->bt);
     }
@@ -1311,6 +1492,7 @@
 static GpStatus METAFILE_AddBrushObject(GpMetafile *metafile, GDIPCONST GpBrush *brush, DWORD *id)
 {
     EmfPlusObject *object_record;
+    IStream *image;
     GpStatus stat;
     DWORD size;
 
@@ -1318,16 +1500,21 @@
     if (metafile->metafile_type != MetafileTypeEmfPlusOnly && metafile->metafile_type != MetafileTypeEmfPlusDual)
         return Ok;
 
-    stat = METAFILE_PrepareBrushData(brush, &size);
+    stat = METAFILE_PrepareBrushData(brush, &size, &image);
     if (stat != Ok) return stat;
 
     stat = METAFILE_AllocateRecord(metafile, EmfPlusRecordTypeObject,
         FIELD_OFFSET(EmfPlusObject, ObjectData) + size, (void**)&object_record);
-    if (stat != Ok) return stat;
+    if (stat != Ok)
+    {
+        if (image) IStream_Release(image);
+        return stat;
+    }
 
     *id = METAFILE_AddObjectId(metafile);
     object_record->Header.Flags = *id | ObjectTypeBrush << 8;
-    METAFILE_FillBrushData(brush, &object_record->ObjectData.brush);
+    METAFILE_FillBrushData(brush, &object_record->ObjectData.brush, image);
+    if (image) IStream_Release(image);
     return Ok;
 }
 
@@ -2344,6 +2531,123 @@
         GdipDisposeImage(image);
         break;
     }
+#ifndef SG_MUTANT_EMFP_NO_TEXTURE_PATHGRADIENT
+    case BrushTypePathGradient:
+    {
+        const EmfPlusPathGradientBrushData *grad_data = &data->BrushData.pathgradient;
+        GpPathGradient *gradient = NULL;
+        DWORD surround_count, count = 0;
+        const BYTE *blend = NULL;
+        const float *focus = NULL;
+
+        offset = header_size + FIELD_OFFSET(EmfPlusPathGradientBrushData, SurroundingColor);
+        if (data_size < offset)
+            return InvalidParameter;
+        brushflags = grad_data->BrushDataFlags;
+        if ((brushflags & BrushDataPresetColors) && (brushflags & (BrushDataBlendFactorsH | BrushDataBlendFactorsV)))
+            return InvalidParameter;
+        surround_count = grad_data->SurroundingColorCount;
+        if (surround_count > (data_size - offset) / sizeof(EmfPlusARGB))
+            return InvalidParameter;
+        offset += surround_count * sizeof(EmfPlusARGB);
+
+        /* the boundary: EmfPlusBoundaryPathData (a size and a path) or EmfPlusBoundaryPointData */
+        if (data_size < offset + sizeof(DWORD))
+            return InvalidParameter;
+        count = *(const DWORD *)(record_data + offset);
+        offset += sizeof(DWORD);
+        if (brushflags & BrushDataPath)
+        {
+            GpPath *path;
+
+            if (count > data_size - offset)
+                return InvalidParameter;
+            status = metafile_deserialize_path(record_data + offset, count, &path);
+            if (status != Ok)
+                return status;
+            status = GdipCreatePathGradientFromPath(path, &gradient);
+            GdipDeletePath(path);
+            offset += count;
+        }
+        else
+        {
+            if (count > (data_size - offset) / sizeof(EmfPlusPointF))
+                return InvalidParameter;
+            status = GdipCreatePathGradient((const GpPointF *)(record_data + offset), count,
+                    grad_data->WrapMode, &gradient);
+            offset += count * sizeof(EmfPlusPointF);
+        }
+        if (status != Ok)
+            return status;
+
+        /* the optional data: transform, blend colors or factors, focus scales */
+        if (brushflags & BrushDataTransform)
+        {
+            if (data_size < offset + sizeof(EmfPlusTransformMatrix))
+                status = InvalidParameter;
+            else
+                transform = (EmfPlusTransformMatrix *)(record_data + offset);
+            offset += sizeof(EmfPlusTransformMatrix);
+        }
+        count = 0;
+        if (status == Ok && (brushflags & (BrushDataPresetColors | BrushDataBlendFactorsH | BrushDataBlendFactorsV)))
+        {
+            if (data_size < offset + sizeof(DWORD))
+                status = InvalidParameter;
+            else
+            {
+                count = *(const DWORD *)(record_data + offset);
+                blend = record_data + offset + sizeof(DWORD);
+                if (count > (data_size - offset - sizeof(DWORD)) / (2 * sizeof(float)))
+                    status = InvalidParameter;
+                offset += sizeof(DWORD) + count * 2 * sizeof(float);
+            }
+        }
+        if (status == Ok && (brushflags & BrushDataFocusScales))
+        {
+            if (data_size < offset + sizeof(DWORD) + 2 * sizeof(float))
+                status = InvalidParameter;
+            else
+                focus = (const float *)(record_data + offset + sizeof(DWORD));
+        }
+
+        if (status == Ok)
+            status = GdipSetPathGradientWrapMode(gradient, grad_data->WrapMode);
+        if (status == Ok)
+            status = GdipSetPathGradientCenterColor(gradient, grad_data->CenterColor);
+        if (status == Ok)
+        {
+            GpPointF center = { grad_data->CenterPointF.X, grad_data->CenterPointF.Y };
+            status = GdipSetPathGradientCenterPoint(gradient, &center);
+        }
+        if (status == Ok && surround_count)
+        {
+            INT n = surround_count;
+            status = GdipSetPathGradientSurroundColorsWithCount(gradient, grad_data->SurroundingColor, &n);
+        }
+        if (status == Ok && transform)
+            memcpy(&gradient->transform, transform, sizeof(gradient->transform));
+        if (status == Ok && blend && count)
+        {
+            if (brushflags & BrushDataPresetColors)
+                status = GdipSetPathGradientPresetBlend(gradient, (const ARGB *)(blend + count * sizeof(float)),
+                        (const REAL *)blend, count);
+            else
+                status = GdipSetPathGradientBlend(gradient, (const REAL *)(blend + count * sizeof(float)),
+                        (const REAL *)blend, count);
+        }
+        if (status == Ok && focus)
+            status = GdipSetPathGradientFocusScales(gradient, focus[0], focus[1]);
+        if (status == Ok && (brushflags & BrushDataIsGammaCorrected))
+            status = GdipSetPathGradientGammaCorrection(gradient, TRUE);
+
+        if (status == Ok)
+            *brush = (GpBrush *)gradient;
+        else
+            GdipDeleteBrush((GpBrush *)gradient);
+        break;
+    }
+#endif
     case BrushTypeLinearGradient:
     {
         GpLineGradient *gradient = NULL;
@@ -5652,6 +5956,7 @@
     DWORD custom_start_cap_size = 0, custom_start_cap_data_size = 0, custom_start_cap_path_size = 0;
     DWORD custom_end_cap_size = 0, custom_end_cap_data_size = 0, custom_end_cap_path_size = 0;
     DWORD i, data_flags, pen_data_size, brush_size;
+    IStream *brush_image;
     EmfPlusObject *object_record;
     EmfPlusPenData *pen_data;
     GpStatus stat;
@@ -5733,13 +6038,17 @@
         pen_data_size += custom_end_cap_size;
     }
 
-    stat = METAFILE_PrepareBrushData(pen->brush, &brush_size);
+    stat = METAFILE_PrepareBrushData(pen->brush, &brush_size, &brush_image);
     if (stat != Ok) return stat;
 
     stat = METAFILE_AllocateRecord(metafile, EmfPlusRecordTypeObject,
             FIELD_OFFSET(EmfPlusObject, ObjectData.pen.data) + pen_data_size + brush_size,
             (void**)&object_record);
-    if (stat != Ok) return stat;
+    if (stat != Ok)
+    {
+        if (brush_image) IStream_Release(brush_image);
+        return stat;
+    }
 
     *id = METAFILE_AddObjectId(metafile);
     object_record->Header.Flags = *id | ObjectTypePen << 8;
@@ -5843,7 +6152,8 @@
     }
 
     METAFILE_FillBrushData(pen->brush,
-            (EmfPlusBrush*)(object_record->ObjectData.pen.data + pen_data_size));
+            (EmfPlusBrush*)(object_record->ObjectData.pen.data + pen_data_size), brush_image);
+    if (brush_image) IStream_Release(brush_image);
     return Ok;
 }
 
