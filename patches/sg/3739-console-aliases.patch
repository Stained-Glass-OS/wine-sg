+/* Stained Glass OS: console aliases (AddConsoleAlias and friends), one table per console, names compared
+ * without regard to case */
+static struct alias_exe *find_alias_exe( struct console *console, const WCHAR *name, size_t len )
+{
+    unsigned int i;
+    for (i = 0; i < console->alias_exe_count; i++)
+        if (wcslen( console->alias_exes[i].name ) == len && !wcsnicmp( console->alias_exes[i].name, name, len ))
+            return &console->alias_exes[i];
+    return NULL;
+}
+
+static struct alias *find_alias( struct alias_exe *exe, const WCHAR *source, size_t len )
+{
+    unsigned int i;
+    for (i = 0; i < exe->count; i++)
+        if (wcslen( exe->aliases[i].source ) == len && !wcsnicmp( exe->aliases[i].source, source, len ))
+            return &exe->aliases[i];
+    return NULL;
+}
+
+static WCHAR *dup_alias_string( const WCHAR *str, size_t len )
+{
+    WCHAR *ret = malloc( (len + 1) * sizeof(WCHAR) );
+    if (ret) { memcpy( ret, str, len * sizeof(WCHAR) ); ret[len] = 0; }
+    return ret;
+}
+
+static NTSTATUS set_console_alias( struct console *console, const WCHAR *source, size_t source_len,
+                                   const WCHAR *target, size_t target_len, const WCHAR *exe_name, size_t exe_len )
+{
+    struct alias_exe *exe = find_alias_exe( console, exe_name, exe_len );
+    struct alias *alias;
+
+    if (!target_len)  /* delete */
+    {
+        if (!exe || !(alias = find_alias( exe, source, source_len ))) return STATUS_SUCCESS;
+        free( alias->source );
+        free( alias->target );
+        memmove( alias, alias + 1, (exe->aliases + exe->count - alias - 1) * sizeof(*alias) );
+        if (!--exe->count)
+        {
+            free( exe->aliases );
+            free( exe->name );
+            memmove( exe, exe + 1, (console->alias_exes + console->alias_exe_count - exe - 1) * sizeof(*exe) );
+            console->alias_exe_count--;
+        }
+        return STATUS_SUCCESS;
+    }
+    if (!exe)
+    {
+        struct alias_exe *new_exes = realloc( console->alias_exes, (console->alias_exe_count + 1) * sizeof(*new_exes) );
+        if (!new_exes) return STATUS_NO_MEMORY;
+        console->alias_exes = new_exes;
+        exe = &new_exes[console->alias_exe_count];
+        memset( exe, 0, sizeof(*exe) );
+        if (!(exe->name = dup_alias_string( exe_name, exe_len ))) return STATUS_NO_MEMORY;
+        console->alias_exe_count++;
+    }
+    if ((alias = find_alias( exe, source, source_len )))
+    {
+        WCHAR *new_target = dup_alias_string( target, target_len );
+        if (!new_target) return STATUS_NO_MEMORY;
+        free( alias->target );
+        alias->target = new_target;
+    }
+    else
+    {
+        struct alias *new_aliases = realloc( exe->aliases, (exe->count + 1) * sizeof(*new_aliases) );
+        if (!new_aliases) return STATUS_NO_MEMORY;
+        exe->aliases = new_aliases;
+        alias = &exe->aliases[exe->count];
+        alias->source = dup_alias_string( source, source_len );
+        alias->target = dup_alias_string( target, target_len );
+        if (!alias->source || !alias->target)
+        {
+            free( alias->source );
+            free( alias->target );
+            return STATUS_NO_MEMORY;
+        }
+        exe->count++;
+    }
+    return STATUS_SUCCESS;
+}
+
+/* answer a GET_ALIAS* ioctl: the whole answer is size bytes, of which as much as fits is returned */
+static NTSTATUS alias_answer( const WCHAR *data, size_t size, size_t *out_size )
+{
+    struct condrv_alias_result *result;
+    size_t copy = *out_size > sizeof(*result) - sizeof(WCHAR) ? min( *out_size - (sizeof(*result) - sizeof(WCHAR)), size ) : 0;
+
+    if (*out_size < sizeof(unsigned int)) return STATUS_INVALID_PARAMETER;
+    *out_size = sizeof(unsigned int) + copy;
+    if (!(result = alloc_ioctl_buffer( *out_size ))) return STATUS_NO_MEMORY;
+    result->size = size;
+    if (copy) memcpy( result->buffer, data, copy );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS get_console_alias( struct console *console, const struct condrv_alias_params *params,
+                                   size_t in_size, size_t *out_size )
+{
+    const WCHAR *source = params->buffer;
+    const WCHAR *exe_name = source + params->source_len / sizeof(WCHAR) + params->target_len / sizeof(WCHAR);
+    struct alias_exe *exe;
+    struct alias *alias;
+
+    /* a missing alias is an answer of no bytes */
+    if (!(exe = find_alias_exe( console, exe_name, params->exe_len / sizeof(WCHAR) )) ||
+        !(alias = find_alias( exe, source, params->source_len / sizeof(WCHAR) )))
+        return alias_answer( NULL, 0, out_size );
+    return alias_answer( alias->target, (wcslen( alias->target ) + 1) * sizeof(WCHAR), out_size );
+}
+
+static NTSTATUS get_console_aliases( struct console *console, const WCHAR *exe_name, size_t exe_len, size_t *out_size )
+{
+    struct alias_exe *exe = find_alias_exe( console, exe_name, exe_len );
+    size_t size = 0, pos = 0;
+    WCHAR *all;
+    NTSTATUS status;
+    unsigned int i;
+
+    if (exe)
+        for (i = 0; i < exe->count; i++)
+            size += wcslen( exe->aliases[i].source ) + 1 + wcslen( exe->aliases[i].target ) + 1;
+    if (!(all = malloc( (size + 1) * sizeof(WCHAR) ))) return STATUS_NO_MEMORY;
+    if (exe)
+        for (i = 0; i < exe->count; i++)
+            pos += swprintf( all + pos, size + 1 - pos, L"%ls=%ls", exe->aliases[i].source, exe->aliases[i].target ) + 1;
+    status = alias_answer( all, size * sizeof(WCHAR), out_size );
+    free( all );
+    return status;
+}
+
+static NTSTATUS get_console_alias_exes( struct console *console, size_t *out_size )
+{
+    size_t size = 0, pos = 0;
+    WCHAR *all;
+    NTSTATUS status;
+    unsigned int i;
+
+    for (i = 0; i < console->alias_exe_count; i++) size += wcslen( console->alias_exes[i].name ) + 1;
+    if (!(all = malloc( (size + 1) * sizeof(WCHAR) ))) return STATUS_NO_MEMORY;
+    for (i = 0; i < console->alias_exe_count; i++)
+    {
+        wcscpy( all + pos, console->alias_exes[i].name );
+        pos += wcslen( console->alias_exes[i].name ) + 1;
+    }
+    status = alias_answer( all, size * sizeof(WCHAR), out_size );
+    free( all );
+    return status;
+}
