+/* Stained Glass OS: console aliases. The table lives in the console host; an answer comes with its size,
+ * so a short buffer is told apart from a missing alias. */
+static BOOL alias_exe_arg( const WCHAR *exe )
+{
+    if (exe && exe[0]) return TRUE;
+    SetLastError( ERROR_INVALID_PARAMETER );
+    return FALSE;
+}
+
+/* returns the answer (HeapAlloc'ed, *size bytes of strings) or NULL with the last error set */
+static WCHAR *console_alias_ioctl( DWORD code, void *in, DWORD in_size, DWORD *size )
+{
+    struct condrv_alias_result *result;
+    DWORD got, cap = 512;
+
+    for (;;)
+    {
+        if (!(result = HeapAlloc( GetProcessHeap(), 0, sizeof(*result) + cap ))) return NULL;
+        if (!console_ioctl( RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle, code, in, in_size,
+                            result, sizeof(*result) + cap, &got ) || got < sizeof(unsigned int))
+        {
+            HeapFree( GetProcessHeap(), 0, result );
+            return NULL;
+        }
+        if (result->size <= cap) break;
+        cap = result->size;
+        HeapFree( GetProcessHeap(), 0, result );
+    }
+    *size = result->size;
+    memmove( result, result->buffer, result->size );
+    return (WCHAR *)result;
+}
+
 /******************************************************************
- *	GetConsoleAliasA   (kernelbase.@)
+ *	AddConsoleAliasW   (kernelbase.@)
  */
-DWORD WINAPI GetConsoleAliasA( LPSTR source, LPSTR buffer, DWORD len, LPSTR exename )
+BOOL WINAPI AddConsoleAliasW( LPWSTR source, LPWSTR target, LPWSTR exename )
 {
-    FIXME( "(%s,%p,%ld,%s): stub\n", debugstr_a(source), buffer, len, debugstr_a(exename) );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return 0;
+    struct condrv_alias_params *params;
+    DWORD source_len, target_len, exe_len;
+    BOOL ret;
+
+    TRACE( "(%s, %s, %s)\n", debugstr_w(source), debugstr_w(target), debugstr_w(exename) );
+
+    if (!source || !source[0] || !alias_exe_arg( exename ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    source_len = lstrlenW( source ) * sizeof(WCHAR);
+    target_len = target ? lstrlenW( target ) * sizeof(WCHAR) : 0;
+    exe_len = lstrlenW( exename ) * sizeof(WCHAR);
+    if (!(params = HeapAlloc( GetProcessHeap(), 0, sizeof(*params) + source_len + target_len + exe_len ))) return FALSE;
+    params->source_len = source_len;
+    params->target_len = target_len;
+    params->exe_len = exe_len;
+    memcpy( params->buffer, source, source_len );
+    memcpy( (char *)params->buffer + source_len, target, target_len );
+    memcpy( (char *)params->buffer + source_len + target_len, exename, exe_len );
+    ret = console_ioctl( RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle, IOCTL_CONDRV_ADD_ALIAS, params,
+                         sizeof(*params) - sizeof(WCHAR) + source_len + target_len + exe_len, NULL, 0, NULL );
+    HeapFree( GetProcessHeap(), 0, params );
+    return ret;
 }
 
+/* the ANSI strings for the A forms are in the output code page of the console */
+static WCHAR *alias_strdupAW( const char *str )
+{
+    WCHAR *ret;
+    int len;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar( GetConsoleCP(), 0, str, -1, NULL, 0 );
+    if ((ret = HeapAlloc( GetProcessHeap(), 0, len * sizeof(WCHAR) ))) MultiByteToWideChar( GetConsoleCP(), 0, str, -1, ret, len );
+    return ret;
+}
+
+/******************************************************************
+ *	AddConsoleAliasA   (kernelbase.@)
+ */
+BOOL WINAPI AddConsoleAliasA( LPSTR source, LPSTR target, LPSTR exename )
+{
+    WCHAR *sourceW = alias_strdupAW( source ), *targetW = alias_strdupAW( target ), *exeW = alias_strdupAW( exename );
+    BOOL ret = FALSE;
+
+    if ((!source || sourceW) && (!target || targetW) && (!exename || exeW))
+        ret = AddConsoleAliasW( sourceW, targetW, exeW );
+    HeapFree( GetProcessHeap(), 0, sourceW );
+    HeapFree( GetProcessHeap(), 0, targetW );
+    HeapFree( GetProcessHeap(), 0, exeW );
+    return ret;
+}
 
 /******************************************************************
  *	GetConsoleAliasW   (kernelbase.@)
+ *
+ * len is in bytes; the result is the number of bytes of the target with its terminator.
  */
 DWORD WINAPI GetConsoleAliasW( LPWSTR source, LPWSTR buffer, DWORD len, LPWSTR exename )
 {
-    FIXME( "(%s,%p,%ld,%s): stub\n", debugstr_w(source), buffer, len, debugstr_w(exename) );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return 0;
+    struct condrv_alias_params *params;
+    DWORD source_len, exe_len, size = 0;
+    WCHAR *answer;
+
+    TRACE( "(%s,%p,%ld,%s)\n", debugstr_w(source), buffer, len, debugstr_w(exename) );
+
+    if (!source || !source[0] || !buffer || !alias_exe_arg( exename ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    source_len = lstrlenW( source ) * sizeof(WCHAR);
+    exe_len = lstrlenW( exename ) * sizeof(WCHAR);
+    if (!(params = HeapAlloc( GetProcessHeap(), 0, sizeof(*params) + source_len + exe_len ))) return 0;
+    params->source_len = source_len;
+    params->target_len = 0;
+    params->exe_len = exe_len;
+    memcpy( params->buffer, source, source_len );
+    memcpy( (char *)params->buffer + source_len, exename, exe_len );
+    answer = console_alias_ioctl( IOCTL_CONDRV_GET_ALIAS, params, sizeof(*params) - sizeof(WCHAR) + source_len + exe_len, &size );
+    HeapFree( GetProcessHeap(), 0, params );
+    if (!answer) return 0;
+    if (!size)
+    {
+        HeapFree( GetProcessHeap(), 0, answer );
+        SetLastError( ERROR_NOT_FOUND );
+        return 0;
+    }
+    if (size > len)
+    {
+        HeapFree( GetProcessHeap(), 0, answer );
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return 0;
+    }
+    memcpy( buffer, answer, size );
+    HeapFree( GetProcessHeap(), 0, answer );
+    return size;
 }
 
+/******************************************************************
+ *	GetConsoleAliasA   (kernelbase.@)
+ */
+DWORD WINAPI GetConsoleAliasA( LPSTR source, LPSTR buffer, DWORD len, LPSTR exename )
+{
+    WCHAR *sourceW = alias_strdupAW( source ), *exeW = alias_strdupAW( exename ), *bufferW;
+    DWORD ret = 0;
+
+    if (!buffer || (source && !sourceW) || (exename && !exeW) ||
+        !(bufferW = HeapAlloc( GetProcessHeap(), 0, (len + 1) * sizeof(WCHAR) )))
+    {
+        if (!buffer) SetLastError( ERROR_INVALID_PARAMETER );
+        HeapFree( GetProcessHeap(), 0, sourceW );
+        HeapFree( GetProcessHeap(), 0, exeW );
+        return 0;
+    }
+    ret = GetConsoleAliasW( sourceW, bufferW, (len + 1) * sizeof(WCHAR), exeW );
+    if (ret)
+    {
+        int n = WideCharToMultiByte( GetConsoleCP(), 0, bufferW, -1, buffer, len, NULL, NULL );
+        if (!n) { SetLastError( ERROR_INSUFFICIENT_BUFFER ); ret = 0; }
+        else ret = n;
+    }
+    HeapFree( GetProcessHeap(), 0, bufferW );
+    HeapFree( GetProcessHeap(), 0, sourceW );
+    HeapFree( GetProcessHeap(), 0, exeW );
+    return ret;
+}
+
+/* the "source=target" strings of an executable, as W (HeapAlloc'ed) */
+static WCHAR *get_aliases_w( const WCHAR *exename, DWORD *size )
+{
+    return console_alias_ioctl( IOCTL_CONDRV_GET_ALIASES, (void *)exename, lstrlenW( exename ) * sizeof(WCHAR), size );
+}
 
