+/* Stained Glass OS (ADR 0012, B56): elevated programs' windows.
+ *
+ * An elevated program runs as SYSTEM on a display of its own, which the
+ * compositor shows in the user's desktop; no session program can type into it
+ * or read it. Its windows are not on this desktop, so the shell hook never
+ * reports them: they live on the Wine desktop WinSta0\sg-elevated-<display>,
+ * which sg-elevated-run names after its X display. The bar looks there once a
+ * second and gives each top-level window a button. A click asks the
+ * compositor to bring it forward (sg-lockctl ACTIVATE <display> <X window>):
+ * focus, not input, which the compositor lets anyone in the session ask for.
+ * Nothing is sent to the elevated program itself. */
+struct sg_elevated_scan
+{
+    int  display;
+    BOOL changed;
+};
+
+static BOOL CALLBACK sg_elevated_window( HWND hwnd, LPARAM lparam )
+{
+    struct sg_elevated_scan *scan = (struct sg_elevated_scan *)lparam;
+    struct taskbar_button *win;
+
+    if (!IsWindowVisible( hwnd ) || GetWindow( hwnd, GW_OWNER ) ||
+        (GetWindowLongW( hwnd, GWL_EXSTYLE ) & (WS_EX_TOOLWINDOW | WS_EX_APPWINDOW)) == WS_EX_TOOLWINDOW)
+        return TRUE;
+    if (!(win = find_taskbar_button( hwnd )))
+    {
+        add_taskbar_button( hwnd );
+        if (!(win = find_taskbar_button( hwnd ))) return TRUE;
+        win->elevated = scan->display + 1;
+        /* its own group: the elevated program, not whatever shares its file */
+        swprintf( win->exe, ARRAY_SIZE(win->exe), L"\\sg-elevated\\%d", scan->display );
+        scan->changed = TRUE;
+    }
+    win->elevated_seen = TRUE;
+    return TRUE;
+}
+
+static BOOL CALLBACK sg_elevated_desktop( LPWSTR name, LPARAM lparam )
+{
+    struct sg_elevated_scan *scan = (struct sg_elevated_scan *)lparam;
+    static const WCHAR prefix[] = L"sg-elevated-";
+    HDESK desk;
+    const WCHAR *p;
+    long display = 0;
+
+    if (wcsncmp( name, prefix, ARRAY_SIZE(prefix) - 1 )) return TRUE;
+    p = name + ARRAY_SIZE(prefix) - 1;
+    if (!*p) return TRUE;
+    for (; *p; p++)
+    {
+        if (*p < '0' || *p > '9' || (display = display * 10 + (*p - '0')) > 65535) return TRUE;
+    }
+    if (!(desk = OpenDesktopW( name, 0, FALSE, DESKTOP_READOBJECTS | DESKTOP_ENUMERATE ))) return TRUE;
+    scan->display = display;
+    EnumDesktopWindows( desk, sg_elevated_window, (LPARAM)scan );
+    CloseDesktop( desk );
+    return TRUE;
+}
+
+static void sg_sync_elevated(void)
+{
+    struct sg_elevated_scan scan = { 0, FALSE };
+    struct taskbar_button *win, *next;
+
+    if (!enable_taskbar) return;
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry ) win->elevated_seen = FALSE;
+    EnumDesktopsW( GetProcessWindowStation(), sg_elevated_desktop, (LPARAM)&scan );
+    LIST_FOR_EACH_ENTRY_SAFE( win, next, &taskbar_buttons, struct taskbar_button, entry )
+    {
+        if (!win->elevated || win->elevated_seen) continue;
+        remove_taskbar_button( win->hwnd );
+        scan.changed = TRUE;
+    }
+    if (scan.changed) sync_taskbar_buttons();
+    else
+    {
+        /* titles change (an installer's pages): repaint their buttons */
+        LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+            if (win->elevated && win->visible) InvalidateRect( win->button, NULL, FALSE );
+    }
+}
+
+/* the compositor brings it forward; nothing is sent to the program */
+static void sg_activate_elevated( struct taskbar_button *win )
+{
+    static const WCHAR ctl[] = L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-lockctl";
+    WCHAR cmd[MAX_PATH];
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    ULONG_PTR xwin = (ULONG_PTR)GetPropW( win->hwnd, L"__wine_x11_whole_window" );
+
+    if (!xwin) return;
+    swprintf( cmd, ARRAY_SIZE(cmd), L"%s ACTIVATE %d %Iu", ctl, win->elevated - 1, xwin );
+    if (CreateProcessW( NULL, cmd, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi ))
+    {
+        CloseHandle( pi.hThread );
+        CloseHandle( pi.hProcess );
+    }
+}
+
