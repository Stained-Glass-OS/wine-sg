From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfplat: MFInitVideoFormat, MFGetUncompressedVideoFormat, MFConvertColorInfoFromDXVA, MFValidateMediaTypeSize, attribute stream (de)serialization

MFInitVideoFormat fills an MFVIDEOFORMAT for the nine standard formats,
MFGetUncompressedVideoFormat returns the FOURCC/D3DFORMAT of an uncompressed
subtype (0 otherwise), MFConvertColorInfoFromDXVA inverts
MFConvertColorInfoToDXVA, MFValidateMediaTypeSize checks the size of the known
format blocks, and MFSerializeAttributesToStream/MFDeserializeAttributesFromStream
round-trip every attribute type (IUnknown only with
MF_ATTRIBUTE_SERIALIZE_UNKNOWN_BYREF; the stream layout is private).
---
diff --git a/dlls/mfplat/main.c b/dlls/mfplat/main.c
index abbb15a..2dbf0bb 100644
--- a/dlls/mfplat/main.c
+++ b/dlls/mfplat/main.c
@@ -3671,6 +3671,270 @@ HRESULT WINAPI MFInitAttributesFromBlob(IMFAttributes *dest, const UINT8 *buffer
     return hr;
 }
 
+/* Stream serialization of an attribute store (MFSerializeAttributesToStream). The layout is private to this
+ * implementation (the real one is not documented), all fields are little endian:
+ *
+ *   UINT32 magic ('MFAS'), UINT32 item count, then for every item
+ *   GUID key, UINT32 MF_ATTRIBUTE_TYPE, followed by
+ *     UINT32 / UINT64 / double: the value (4 / 8 / 8 bytes),
+ *     GUID: 16 bytes,
+ *     string: UINT32 length in characters without the terminator, the characters,
+ *     blob: UINT32 size, the bytes,
+ *     IUnknown (only with MF_ATTRIBUTE_SERIALIZE_UNKNOWN_BYREF): UINT64 pointer value.
+ */
+#define ATTRIBUTES_STREAM_MAGIC 0x5341464d
+#define ATTRIBUTES_STREAM_MAX_ITEM_SIZE 0x4000000
+
+struct attr_stream_buffer
+{
+    UINT8 *data;
+    SIZE_T size, capacity;
+};
+
+static HRESULT attr_stream_buffer_append(struct attr_stream_buffer *buffer, const void *data, SIZE_T size)
+{
+    if (buffer->size + size > buffer->capacity)
+    {
+        SIZE_T capacity = max(256, max(buffer->capacity * 2, buffer->size + size));
+        UINT8 *ptr;
+
+        if (!(ptr = realloc(buffer->data, capacity)))
+            return E_OUTOFMEMORY;
+        buffer->data = ptr;
+        buffer->capacity = capacity;
+    }
+    memcpy(buffer->data + buffer->size, data, size);
+    buffer->size += size;
+    return S_OK;
+}
+
+/***********************************************************************
+ *      MFSerializeAttributesToStream (mfplat.@)
+ */
+HRESULT WINAPI MFSerializeAttributesToStream(IMFAttributes *attributes, DWORD flags, IStream *stream)
+{
+    struct attr_stream_buffer buffer = {0};
+    UINT32 count, i, header[2];
+    PROPVARIANT value;
+    ULONG written;
+    HRESULT hr;
+
+    TRACE("%p, %#lx, %p.\n", attributes, flags, stream);
+
+    if (!attributes || !stream || (flags & ~MF_ATTRIBUTE_SERIALIZE_UNKNOWN_BYREF))
+        return E_INVALIDARG;
+
+    IMFAttributes_LockStore(attributes);
+
+    if (FAILED(hr = IMFAttributes_GetCount(attributes, &count)))
+    {
+        IMFAttributes_UnlockStore(attributes);
+        return hr;
+    }
+
+    header[0] = ATTRIBUTES_STREAM_MAGIC;
+    header[1] = count;
+    hr = attr_stream_buffer_append(&buffer, header, sizeof(header));
+
+    for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+    {
+        UINT32 type, size;
+        GUID key;
+
+        if (FAILED(hr = IMFAttributes_GetItemByIndex(attributes, i, &key, &value)))
+            break;
+
+        type = value.vt;
+        if (SUCCEEDED(hr = attr_stream_buffer_append(&buffer, &key, sizeof(key))))
+            hr = attr_stream_buffer_append(&buffer, &type, sizeof(type));
+
+        if (SUCCEEDED(hr))
+        {
+            switch (value.vt)
+            {
+                case MF_ATTRIBUTE_UINT32:
+                    hr = attr_stream_buffer_append(&buffer, &value.ulVal, sizeof(value.ulVal));
+                    break;
+                case MF_ATTRIBUTE_UINT64:
+                    hr = attr_stream_buffer_append(&buffer, &value.uhVal.QuadPart, sizeof(value.uhVal.QuadPart));
+                    break;
+                case MF_ATTRIBUTE_DOUBLE:
+                    hr = attr_stream_buffer_append(&buffer, &value.dblVal, sizeof(value.dblVal));
+                    break;
+                case MF_ATTRIBUTE_GUID:
+                    hr = attr_stream_buffer_append(&buffer, value.puuid, sizeof(GUID));
+                    break;
+                case MF_ATTRIBUTE_STRING:
+                    size = lstrlenW(value.pwszVal);
+                    if (SUCCEEDED(hr = attr_stream_buffer_append(&buffer, &size, sizeof(size))))
+                        hr = attr_stream_buffer_append(&buffer, value.pwszVal, size * sizeof(WCHAR));
+                    break;
+                case MF_ATTRIBUTE_BLOB:
+                    size = value.caub.cElems;
+                    if (SUCCEEDED(hr = attr_stream_buffer_append(&buffer, &size, sizeof(size))))
+                        hr = attr_stream_buffer_append(&buffer, value.caub.pElems, size);
+                    break;
+                case MF_ATTRIBUTE_IUNKNOWN:
+                {
+                    UINT64 ptr = (UINT_PTR)value.punkVal;
+
+#ifdef SG_MUTANT_MFSER_UNKNOWN_DROP
+                    hr = S_OK;
+                    break;
+#endif
+                    if (!(flags & MF_ATTRIBUTE_SERIALIZE_UNKNOWN_BYREF))
+                        hr = MF_E_INVALIDTYPE;
+                    else
+                        hr = attr_stream_buffer_append(&buffer, &ptr, sizeof(ptr));
+                    break;
+                }
+                default:
+                    hr = MF_E_INVALIDTYPE;
+            }
+        }
+
+        PropVariantClear(&value);
+    }
+
+    IMFAttributes_UnlockStore(attributes);
+
+    if (SUCCEEDED(hr))
+    {
+        if (SUCCEEDED(hr = IStream_Write(stream, buffer.data, buffer.size, &written)) && written != buffer.size)
+            hr = E_FAIL;
+    }
+
+    free(buffer.data);
+
+    return hr;
+}
+
+static HRESULT attr_stream_read(IStream *stream, void *data, ULONG size)
+{
+    ULONG read = 0;
+    HRESULT hr;
+
+    if (FAILED(hr = IStream_Read(stream, data, size, &read)))
+        return hr;
+
+    return read == size ? S_OK : MF_E_INVALID_FORMAT;
+}
+
+/***********************************************************************
+ *      MFDeserializeAttributesFromStream (mfplat.@)
+ */
+HRESULT WINAPI MFDeserializeAttributesFromStream(IMFAttributes *attributes, DWORD flags, IStream *stream)
+{
+    IMFAttributes *loaded;
+    UINT32 header[2], i;
+    HRESULT hr;
+
+    TRACE("%p, %#lx, %p.\n", attributes, flags, stream);
+
+    if (!attributes || !stream || (flags & ~MF_ATTRIBUTE_SERIALIZE_UNKNOWN_BYREF))
+        return E_INVALIDARG;
+
+    if (FAILED(hr = attr_stream_read(stream, header, sizeof(header))))
+        return hr;
+    if (header[0] != ATTRIBUTES_STREAM_MAGIC)
+        return MF_E_INVALID_FORMAT;
+
+    if (FAILED(hr = MFCreateAttributes(&loaded, min(header[1], 256))))
+        return hr;
+
+    for (i = 0; i < header[1]; ++i)
+    {
+        UINT32 type, size;
+        GUID key, guid;
+        UINT8 *data;
+
+        if (FAILED(hr = attr_stream_read(stream, &key, sizeof(key)))
+                || FAILED(hr = attr_stream_read(stream, &type, sizeof(type))))
+            break;
+
+        switch (type)
+        {
+            case MF_ATTRIBUTE_UINT32:
+                if (SUCCEEDED(hr = attr_stream_read(stream, &size, sizeof(size))))
+                    hr = IMFAttributes_SetUINT32(loaded, &key, size);
+                break;
+            case MF_ATTRIBUTE_UINT64:
+            {
+                UINT64 value;
+                if (SUCCEEDED(hr = attr_stream_read(stream, &value, sizeof(value))))
+                    hr = IMFAttributes_SetUINT64(loaded, &key, value);
+                break;
+            }
+            case MF_ATTRIBUTE_DOUBLE:
+            {
+                double value;
+                if (SUCCEEDED(hr = attr_stream_read(stream, &value, sizeof(value))))
+                    hr = IMFAttributes_SetDouble(loaded, &key, value);
+                break;
+            }
+            case MF_ATTRIBUTE_GUID:
+                if (SUCCEEDED(hr = attr_stream_read(stream, &guid, sizeof(guid))))
+                    hr = IMFAttributes_SetGUID(loaded, &key, &guid);
+                break;
+            case MF_ATTRIBUTE_STRING:
+            case MF_ATTRIBUTE_BLOB:
+                if (FAILED(hr = attr_stream_read(stream, &size, sizeof(size))))
+                    break;
+                if (type == MF_ATTRIBUTE_STRING && size <= ATTRIBUTES_STREAM_MAX_ITEM_SIZE)
+                    size *= sizeof(WCHAR);
+                if (size > ATTRIBUTES_STREAM_MAX_ITEM_SIZE)
+                {
+                    hr = MF_E_INVALID_FORMAT;
+                    break;
+                }
+                if (!(data = calloc(1, size + sizeof(WCHAR))))
+                {
+                    hr = E_OUTOFMEMORY;
+                    break;
+                }
+                if (SUCCEEDED(hr = attr_stream_read(stream, data, size)))
+                {
+                    if (type == MF_ATTRIBUTE_STRING)
+                        hr = IMFAttributes_SetString(loaded, &key, (const WCHAR *)data);
+                    else
+                        hr = IMFAttributes_SetBlob(loaded, &key, data, size);
+                }
+                free(data);
+                break;
+            case MF_ATTRIBUTE_IUNKNOWN:
+            {
+                UINT64 ptr;
+
+                if (!(flags & MF_ATTRIBUTE_SERIALIZE_UNKNOWN_BYREF))
+                {
+                    hr = MF_E_INVALIDTYPE;
+                    break;
+                }
+                if (SUCCEEDED(hr = attr_stream_read(stream, &ptr, sizeof(ptr))))
+                    hr = IMFAttributes_SetUnknown(loaded, &key, (IUnknown *)(UINT_PTR)ptr);
+                break;
+            }
+            default:
+                hr = MF_E_INVALID_FORMAT;
+        }
+
+        if (FAILED(hr))
+            break;
+    }
+
+    if (SUCCEEDED(hr))
+    {
+        IMFAttributes_LockStore(attributes);
+        IMFAttributes_DeleteAllItems(attributes);
+        hr = IMFAttributes_CopyAllItems(loaded, attributes);
+        IMFAttributes_UnlockStore(attributes);
+    }
+
+    IMFAttributes_Release(loaded);
+
+    return hr;
+}
+
 struct bytestream
 {
     struct attributes attributes;
diff --git a/dlls/mfplat/mediatype.c b/dlls/mfplat/mediatype.c
index 67b7e6a..c30ede9 100644
--- a/dlls/mfplat/mediatype.c
+++ b/dlls/mfplat/mediatype.c
@@ -3769,6 +3769,224 @@ HRESULT WINAPI MFInitVideoFormat_RGB(MFVIDEOFORMAT *format, DWORD width, DWORD h
     return S_OK;
 }
 
+struct standard_video_format
+{
+    DWORD width, height;
+    DWORD par_x, par_y;
+    DWORD fps_n, fps_d;
+    MFVideoInterlaceMode interlace;
+    MFVideoPrimaries primaries;
+    MFVideoTransferMatrix matrix;
+    const GUID *subtype;
+};
+
+/* Parameters of the broadcast standards, taken from the standards themselves (ITU-R BT.601/709, SMPTE 170M,
+ * DV, ATSC A/53): frame size, pixel aspect ratio for 4:3 display, frame rate, field order and colorimetry. */
+static const struct standard_video_format standard_video_formats[] =
+{
+    /* MFStdVideoFormat_NTSC */
+    { 720, 480, 10, 11, 30000, 1001, MFVideoInterlace_FieldInterleavedLowerFirst, MFVideoPrimaries_SMPTE170M,
+      MFVideoTransferMatrix_BT601, &MFVideoFormat_Base },
+    /* MFStdVideoFormat_PAL */
+    { 720, 576, 12, 11, 25, 1, MFVideoInterlace_FieldInterleavedUpperFirst, MFVideoPrimaries_BT470_2_SysBG,
+      MFVideoTransferMatrix_BT601, &MFVideoFormat_Base },
+    /* MFStdVideoFormat_DVD_NTSC */
+    { 720, 480, 10, 11, 30000, 1001, MFVideoInterlace_FieldInterleavedUpperFirst, MFVideoPrimaries_SMPTE170M,
+      MFVideoTransferMatrix_BT601, &MFVideoFormat_MPEG2 },
+    /* MFStdVideoFormat_DVD_PAL */
+    { 720, 576, 12, 11, 25, 1, MFVideoInterlace_FieldInterleavedUpperFirst, MFVideoPrimaries_BT470_2_SysBG,
+      MFVideoTransferMatrix_BT601, &MFVideoFormat_MPEG2 },
+    /* MFStdVideoFormat_DV_PAL */
+    { 720, 576, 12, 11, 25, 1, MFVideoInterlace_FieldInterleavedLowerFirst, MFVideoPrimaries_BT470_2_SysBG,
+      MFVideoTransferMatrix_BT601, &MFVideoFormat_DVSD },
+    /* MFStdVideoFormat_DV_NTSC */
+    { 720, 480, 10, 11, 30000, 1001, MFVideoInterlace_FieldInterleavedLowerFirst, MFVideoPrimaries_SMPTE170M,
+      MFVideoTransferMatrix_BT601, &MFVideoFormat_DVSD },
+    /* MFStdVideoFormat_ATSC_SD480i */
+    { 704, 480, 10, 11, 30000, 1001, MFVideoInterlace_FieldInterleavedUpperFirst, MFVideoPrimaries_SMPTE170M,
+      MFVideoTransferMatrix_BT601, &MFVideoFormat_MPEG2 },
+    /* MFStdVideoFormat_ATSC_HD1080i */
+    { 1920, 1080, 1, 1, 30000, 1001, MFVideoInterlace_FieldInterleavedUpperFirst, MFVideoPrimaries_BT709,
+      MFVideoTransferMatrix_BT709, &MFVideoFormat_MPEG2 },
+    /* MFStdVideoFormat_ATSC_HD720p */
+    { 1280, 720, 1, 1, 60000, 1001, MFVideoInterlace_Progressive, MFVideoPrimaries_BT709,
+      MFVideoTransferMatrix_BT709, &MFVideoFormat_MPEG2 },
+};
+
+/***********************************************************************
+ *      MFInitVideoFormat (mfplat.@)
+ */
+HRESULT WINAPI MFInitVideoFormat(MFVIDEOFORMAT *format, MFStandardVideoFormat type)
+{
+    const struct standard_video_format *std;
+
+    TRACE("%p, %d.\n", format, type);
+
+    if (!format)
+        return E_INVALIDARG;
+
+#ifdef SG_MUTANT_MFIVF_RANGE
+    if (type < MFStdVideoFormat_NTSC || type > MFStdVideoFormat_ATSC_HD720p + 1)
+#else
+    if (type < MFStdVideoFormat_NTSC || type > MFStdVideoFormat_ATSC_HD720p)
+#endif
+        return E_INVALIDARG;
+
+    std = &standard_video_formats[type - MFStdVideoFormat_NTSC];
+
+    memset(format, 0, sizeof(*format));
+    format->dwSize = sizeof(*format);
+    format->videoInfo.dwWidth = std->width;
+    format->videoInfo.dwHeight = std->height;
+    format->videoInfo.PixelAspectRatio.Numerator = std->par_x;
+    format->videoInfo.PixelAspectRatio.Denominator = std->par_y;
+    if (std->subtype == &MFVideoFormat_MPEG2)
+        format->videoInfo.SourceChromaSubsampling = MFVideoChromaSubsampling_MPEG2;
+    else if (type == MFStdVideoFormat_DV_PAL)
+        format->videoInfo.SourceChromaSubsampling = MFVideoChromaSubsampling_DV_PAL;
+    format->videoInfo.InterlaceMode = std->interlace;
+    format->videoInfo.TransferFunction = MFVideoTransFunc_709;
+    format->videoInfo.ColorPrimaries = std->primaries;
+    format->videoInfo.TransferMatrix = std->matrix;
+    format->videoInfo.SourceLighting = MFVideoLighting_dim;
+    format->videoInfo.FramesPerSecond.Numerator = std->fps_n;
+    format->videoInfo.FramesPerSecond.Denominator = std->fps_d;
+    format->videoInfo.NominalRange = MFNominalRange_16_235;
+    format->videoInfo.GeometricAperture.Area.cx = std->width;
+    format->videoInfo.GeometricAperture.Area.cy = std->height;
+    format->videoInfo.MinimumDisplayAperture = format->videoInfo.GeometricAperture;
+    format->guidFormat = *std->subtype;
+
+    return S_OK;
+}
+
+/***********************************************************************
+ *      MFValidateMediaTypeSize (mfplat.@)
+ */
+HRESULT WINAPI MFValidateMediaTypeSize(GUID format_type, UINT8 *block, UINT32 size)
+{
+    SIZE_T min_size;
+
+    TRACE("%s, %p, %u.\n", debugstr_guid(&format_type), block, size);
+
+    /* No format block at all is a valid media type. */
+    if (IsEqualGUID(&format_type, &GUID_NULL))
+        return block || !size ? S_OK : E_INVALIDARG;
+
+    if (!block)
+        return E_INVALIDARG;
+
+    if (IsEqualGUID(&format_type, &FORMAT_VideoInfo))
+        min_size = offsetof(VIDEOINFOHEADER, bmiHeader) + sizeof(BITMAPINFOHEADER);
+    else if (IsEqualGUID(&format_type, &FORMAT_VideoInfo2))
+        min_size = offsetof(VIDEOINFOHEADER2, bmiHeader) + sizeof(BITMAPINFOHEADER);
+    else if (IsEqualGUID(&format_type, &FORMAT_MPEGVideo))
+        min_size = offsetof(MPEG1VIDEOINFO, hdr.bmiHeader) + sizeof(BITMAPINFOHEADER);
+    else if (IsEqualGUID(&format_type, &FORMAT_MPEG2Video))
+        min_size = offsetof(MPEG2VIDEOINFO, hdr.bmiHeader) + sizeof(BITMAPINFOHEADER);
+    else if (IsEqualGUID(&format_type, &FORMAT_WaveFormatEx))
+        min_size = sizeof(PCMWAVEFORMAT);
+    else if (IsEqualGUID(&format_type, &FORMAT_MFVideoFormat))
+        min_size = sizeof(MFVIDEOFORMAT);
+    else
+        return S_OK; /* nothing is known about the layout of other blocks */
+
+#ifdef SG_MUTANT_MFVAL_ALWAYS_OK
+    return S_OK;
+#endif
+    if (size < min_size)
+        return MF_E_INVALIDMEDIATYPE;
+
+    /* The headers carry a variable sized tail described by their own size fields. */
+    if (IsEqualGUID(&format_type, &FORMAT_WaveFormatEx))
+    {
+        const WAVEFORMATEX *wfx = (const WAVEFORMATEX *)block;
+
+        if (wfx->wFormatTag != WAVE_FORMAT_PCM && size < sizeof(WAVEFORMATEX) + wfx->cbSize)
+            return MF_E_INVALIDMEDIATYPE;
+    }
+    else if (IsEqualGUID(&format_type, &FORMAT_MFVideoFormat))
+    {
+        if (((const MFVIDEOFORMAT *)block)->dwSize > size)
+            return MF_E_INVALIDMEDIATYPE;
+    }
+    else
+    {
+        UINT32 bih_offset = IsEqualGUID(&format_type, &FORMAT_VideoInfo) ? offsetof(VIDEOINFOHEADER, bmiHeader)
+                : IsEqualGUID(&format_type, &FORMAT_VideoInfo2) ? offsetof(VIDEOINFOHEADER2, bmiHeader)
+                : IsEqualGUID(&format_type, &FORMAT_MPEGVideo) ? offsetof(MPEG1VIDEOINFO, hdr.bmiHeader)
+                : offsetof(MPEG2VIDEOINFO, hdr.bmiHeader);
+        const BITMAPINFOHEADER *bih = (const BITMAPINFOHEADER *)(block + bih_offset);
+
+        if (bih->biSize < sizeof(*bih) || bih_offset + bih->biSize > size)
+            return MF_E_INVALIDMEDIATYPE;
+    }
+
+    return S_OK;
+}
+
+/***********************************************************************
+ *      MFGetUncompressedVideoFormat (mfplat.@)
+ */
+DWORD WINAPI MFGetUncompressedVideoFormat(const MFVIDEOFORMAT *format)
+{
+    GUID base = MFVideoFormat_Base;
+
+    TRACE("%p.\n", format);
+
+    if (!format)
+        return 0;
+
+    /* Only subtypes derived from the base GUID are candidates, their first field is the FOURCC / D3DFORMAT. */
+    base.Data1 = format->guidFormat.Data1;
+    if (!IsEqualGUID(&base, &format->guidFormat))
+        return 0;
+
+#ifdef SG_MUTANT_MFUNC_ANY
+    return format->guidFormat.Data1;
+#endif
+    return mf_get_video_format(&format->guidFormat) ? format->guidFormat.Data1 : 0;
+}
+
+/***********************************************************************
+ *      MFConvertColorInfoFromDXVA (mfplat.@)
+ */
+HRESULT WINAPI MFConvertColorInfoFromDXVA(MFVIDEOFORMAT *format, DWORD dxva_info)
+{
+    struct
+    {
+        UINT SampleFormat           : 8;
+        UINT VideoChromaSubsampling : 4;
+        UINT NominalRange           : 3;
+        UINT VideoTransferMatrix    : 3;
+        UINT VideoLighting          : 4;
+        UINT VideoPrimaries         : 5;
+        UINT VideoTransferFunction  : 5;
+    } dxva_format;
+
+    TRACE("%p, %#lx.\n", format, dxva_info);
+
+    if (!format)
+        return E_INVALIDARG;
+
+    memcpy(&dxva_format, &dxva_info, sizeof(dxva_info));
+
+    /* Inverse of MFConvertColorInfoToDXVA(): the sample format doubles as the interlace mode (the two
+     * enumerations agree on the values 0 and 2..6). */
+    format->videoInfo.InterlaceMode = dxva_format.SampleFormat;
+
+    format->videoInfo.SourceChromaSubsampling = dxva_format.VideoChromaSubsampling;
+    format->videoInfo.NominalRange = dxva_format.NominalRange;
+#ifndef SG_MUTANT_MFDXVA_NO_MATRIX
+    format->videoInfo.TransferMatrix = dxva_format.VideoTransferMatrix;
+#endif
+    format->videoInfo.SourceLighting = dxva_format.VideoLighting;
+    format->videoInfo.ColorPrimaries = dxva_format.VideoPrimaries;
+    format->videoInfo.TransferFunction = dxva_format.VideoTransferFunction;
+
+    return S_OK;
+}
+
