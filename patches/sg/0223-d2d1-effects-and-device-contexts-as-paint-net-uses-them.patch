+/* The ICC profile of sRGB, or of scRGB (sRGB's primaries, linear), built
+ * from the sRGB standard's numbers (IEC 61966-2-1): its primaries adapted to
+ * the profile connection space's D50 white, and its tone curve. */
+static void put_be32(BYTE *p, UINT32 v)
+{
+    p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v;
+}
+
+static void put_be16(BYTE *p, UINT16 v)
+{
+    p[0] = v >> 8; p[1] = v;
+}
+
+static void put_s15f16(BYTE *p, double v)
+{
+    put_be32(p, (UINT32)(INT32)floor(v * 65536.0 + 0.5));
+}
+
+static void put_xyz(BYTE *p, double x, double y, double z)
+{
+    memcpy(p, "XYZ ", 4);
+    put_be32(p + 4, 0);
+    put_s15f16(p + 8, x);
+    put_s15f16(p + 12, y);
+    put_s15f16(p + 16, z);
+}
+
+static double srgb_to_linear(double v)
+{
+    return v <= 0.04045 ? v / 12.92 : pow((v + 0.055) / 1.055, 2.4);
+}
+
+#define SRGB_CURVE_POINTS 1024
+
+static BYTE *build_rgb_profile(BOOL linear, UINT32 *size)
+{
+    static const char description_srgb[] = "sRGB";
+    static const char description_scrgb[] = "scRGB (linear sRGB)";
+    static const char copyright[] = "No copyright, use freely";
+    const char *description = linear ? description_scrgb : description_srgb;
+    UINT32 desc_len = strlen(description) + 1, desc_size, text_size, curve_size, offset, total, i;
+    struct { const char *sig; UINT32 offset, size; } tags[9];
+    BYTE *profile, *p;
+
+    desc_size = (12 + desc_len + 4 + 4 + 2 + 1 + 67 + 3) & ~3;
+    text_size = (8 + sizeof(copyright) + 3) & ~3;
+    curve_size = linear ? 12 : (12 + SRGB_CURVE_POINTS * 2 + 3) & ~3;
+
+    offset = 128 + 4 + ARRAY_SIZE(tags) * 12;
+    tags[0].sig = "desc"; tags[0].size = desc_size;
+    tags[1].sig = "cprt"; tags[1].size = text_size;
+    tags[2].sig = "wtpt"; tags[2].size = 20;
+    tags[3].sig = "rXYZ"; tags[3].size = 20;
+    tags[4].sig = "gXYZ"; tags[4].size = 20;
+    tags[5].sig = "bXYZ"; tags[5].size = 20;
+    tags[6].sig = "rTRC"; tags[6].size = curve_size;
+    for (i = 0; i < 7; ++i)
+    {
+        tags[i].offset = offset;
+        offset += tags[i].size;
+    }
+    /* the three channels share one curve */
+    tags[7] = tags[6]; tags[7].sig = "gTRC";
+    tags[8] = tags[6]; tags[8].sig = "bTRC";
+    total = offset;
+
+    if (!(profile = calloc(1, total)))
+        return NULL;
+
+    /* header */
+    put_be32(profile, total);
+    put_be32(profile + 8, 0x02100000);           /* version 2.1 */
+    memcpy(profile + 12, "mntr", 4);
+    memcpy(profile + 16, "RGB ", 4);
+    memcpy(profile + 20, "XYZ ", 4);
+    put_be16(profile + 24, 2026);                /* date */
+    put_be16(profile + 26, 1);
+    put_be16(profile + 28, 1);
+    memcpy(profile + 36, "acsp", 4);
+    put_s15f16(profile + 68, 0.9642);            /* D50 */
+    put_s15f16(profile + 72, 1.0);
+    put_s15f16(profile + 76, 0.8249);
+
+    /* tag table */
+    put_be32(profile + 128, ARRAY_SIZE(tags));
+    for (i = 0; i < ARRAY_SIZE(tags); ++i)
+    {
+        p = profile + 132 + i * 12;
+        memcpy(p, tags[i].sig, 4);
+        put_be32(p + 4, tags[i].offset);
+        put_be32(p + 8, tags[i].size);
+    }
+
+    /* desc: textDescriptionType, ASCII only */
+    p = profile + tags[0].offset;
+    memcpy(p, "desc", 4);
+    put_be32(p + 8, desc_len);
+    memcpy(p + 12, description, desc_len);
+
+    /* cprt: textType */
+    p = profile + tags[1].offset;
+    memcpy(p, "text", 4);
+    memcpy(p + 8, copyright, sizeof(copyright));
+
+    put_xyz(profile + tags[2].offset, 0.9642, 1.0, 0.8249);
+    put_xyz(profile + tags[3].offset, 0.4360747, 0.2225045, 0.0139322);
+    put_xyz(profile + tags[4].offset, 0.3850649, 0.7168786, 0.0971045);
+    put_xyz(profile + tags[5].offset, 0.1430804, 0.0606169, 0.7141733);
+
+    /* the tone curve: an exponent of 1.0 (linear), or sRGB's table */
+    p = profile + tags[6].offset;
+    memcpy(p, "curv", 4);
+    if (linear)
+    {
+        put_be32(p + 8, 1);
+        put_be16(p + 12, 0x0100);
+    }
+    else
+    {
+        put_be32(p + 8, SRGB_CURVE_POINTS);
+        for (i = 0; i < SRGB_CURVE_POINTS; ++i)
+            put_be16(p + 12 + i * 2, (UINT16)floor(srgb_to_linear(i / (double)(SRGB_CURVE_POINTS - 1)) * 65535.0 + 0.5));
+    }
+
+    *size = total;
+    return profile;
+}
+
+static HRESULT d2d_color_context_new(ID2D1Factory *factory, D2D1_COLOR_CONTEXT_TYPE type, D2D1_COLOR_SPACE space,
+        const BYTE *profile, UINT32 profile_size, struct d2d_color_context **out)
+{
+    struct d2d_color_context *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    if (profile_size && !(object->profile = malloc(profile_size)))
+    {
+        free(object);
+        return E_OUTOFMEMORY;
+    }
+    object->ID2D1ColorContext1_iface.lpVtbl = &d2d_color_context_vtbl;
+    object->refcount = 1;
+    ID2D1Factory_AddRef(object->factory = factory);
+    object->type = type;
+    object->space = space;
+    object->dxgi_space = space == D2D1_COLOR_SPACE_SCRGB ? DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709
+            : DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709;
+    if (profile_size)
+        memcpy(object->profile, profile, profile_size);
+    object->profile_size = profile_size;
+
+    TRACE("Created color context %p.\n", object);
+    *out = object;
+    return S_OK;
+}
+
+HRESULT d2d_color_context_create(ID2D1Factory *factory, D2D1_COLOR_SPACE space, const BYTE *profile,
+        UINT32 profile_size, ID2D1ColorContext **color_context)
+{
+    struct d2d_color_context *object;
+    HRESULT hr;
+
+    if (!color_context)
+        return E_POINTER;
+    *color_context = NULL;
+
+    switch (space)
+    {
+        case D2D1_COLOR_SPACE_CUSTOM:
+            if (!profile || !profile_size)
+                return E_INVALIDARG;
+            break;
+        case D2D1_COLOR_SPACE_SRGB:
+        case D2D1_COLOR_SPACE_SCRGB:
+            if (profile || profile_size)
+                return E_INVALIDARG;
+            break;
+        default:
+            return E_INVALIDARG;
+    }
+
+    /* sRGB and scRGB have their own profiles */
+    if (space != D2D1_COLOR_SPACE_CUSTOM)
+    {
+        BYTE *builtin;
+        UINT32 size;
+
+        if (!(builtin = build_rgb_profile(space == D2D1_COLOR_SPACE_SCRGB, &size)))
+            return E_OUTOFMEMORY;
+        hr = d2d_color_context_new(factory, D2D1_COLOR_CONTEXT_TYPE_ICC, space, builtin, size, &object);
+        free(builtin);
+    }
+    else
+        hr = d2d_color_context_new(factory, D2D1_COLOR_CONTEXT_TYPE_ICC, space, profile, profile_size, &object);
+    if (FAILED(hr))
+        return hr;
+    *color_context = (ID2D1ColorContext *)&object->ID2D1ColorContext1_iface;
+    return S_OK;
+}
+
+HRESULT d2d_color_context_create_from_filename(ID2D1Factory *factory, const WCHAR *filename,
+        ID2D1ColorContext **color_context)
+{
+    LARGE_INTEGER size;
+    HANDLE file;
+    BYTE *data;
+    DWORD read;
+    HRESULT hr;
+
+    if (!color_context)
+        return E_POINTER;
+    *color_context = NULL;
+    if (!filename)
+        return E_INVALIDARG;
+
+    file = CreateFileW(filename, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (!GetFileSizeEx(file, &size) || !size.QuadPart || size.QuadPart > 64 * 1024 * 1024)
+    {
+        CloseHandle(file);
+        return E_INVALIDARG;
+    }
+    if (!(data = malloc(size.LowPart)))
+    {
+        CloseHandle(file);
+        return E_OUTOFMEMORY;
+    }
+    if (!ReadFile(file, data, size.LowPart, &read, NULL) || read != size.LowPart)
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    else
+        hr = d2d_color_context_create(factory, D2D1_COLOR_SPACE_CUSTOM, data, read, color_context);
+    CloseHandle(file);
+    free(data);
+    return hr;
+}
+
+HRESULT d2d_color_context_create_from_wic(ID2D1Factory *factory, IWICColorContext *wic_context,
+        ID2D1ColorContext **color_context)
+{
+    WICColorContextType type;
+    UINT exif, size;
+    BYTE *data;
+    HRESULT hr;
+
+    if (!color_context)
+        return E_POINTER;
+    *color_context = NULL;
+    if (!wic_context)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = IWICColorContext_GetType(wic_context, &type)))
+        return hr;
+    if (type == WICColorContextExifColorSpace)
+    {
+        if (FAILED(hr = IWICColorContext_GetExifColorSpace(wic_context, &exif)))
+            return hr;
+        /* 1 is sRGB; anything else has no profile to describe it here. */
+        if (exif != 1)
+            FIXME("EXIF color space %u taken as sRGB.\n", exif);
+        return d2d_color_context_create(factory, D2D1_COLOR_SPACE_SRGB, NULL, 0, color_context);
+    }
+
+    if (FAILED(hr = IWICColorContext_GetProfileBytes(wic_context, 0, NULL, &size)))
+        return hr;
+    if (!size)
+        return E_INVALIDARG;
+    if (!(data = malloc(size)))
+        return E_OUTOFMEMORY;
+    if (SUCCEEDED(hr = IWICColorContext_GetProfileBytes(wic_context, size, data, &size)))
+        hr = d2d_color_context_create(factory, D2D1_COLOR_SPACE_CUSTOM, data, size, color_context);
+    free(data);
+    return hr;
+}
+
+HRESULT d2d_color_context_create_from_dxgi(ID2D1Factory *factory, DXGI_COLOR_SPACE_TYPE dxgi_space,
+        ID2D1ColorContext1 **color_context)
+{
+    struct d2d_color_context *object;
+    D2D1_COLOR_SPACE space;
+    HRESULT hr;
+
+    if (!color_context)
+        return E_POINTER;
+    *color_context = NULL;
+
+    switch (dxgi_space)
+    {
+        case DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709: space = D2D1_COLOR_SPACE_SRGB; break;
+        case DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709: space = D2D1_COLOR_SPACE_SCRGB; break;
+        default: space = D2D1_COLOR_SPACE_CUSTOM; break;
+    }
+    if (FAILED(hr = d2d_color_context_new(factory, D2D1_COLOR_CONTEXT_TYPE_DXGI, space, NULL, 0, &object)))
+        return hr;
+    object->dxgi_space = dxgi_space;
+    *color_context = &object->ID2D1ColorContext1_iface;
+    return S_OK;
+}
