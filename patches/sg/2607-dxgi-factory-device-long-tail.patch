+/* Registrations made through the Register...Event / Register...Window methods.
+ * Nothing in this implementation can raise these conditions (windows are never
+ * occluded, stereo is never enabled, the adapter set does not change while a
+ * process runs, there is no hardware content protection), so the registrations
+ * are only recorded: the handles are kept as given and never signalled. */
+struct dxgi_notify
+{
+    struct list entry;
+    DWORD cookie;
+    unsigned int kind;
+    HANDLE event;
+    HWND window;
+    UINT message;
+};
+
+static CRITICAL_SECTION dxgi_notify_cs;
+static CRITICAL_SECTION_DEBUG dxgi_notify_cs_debug =
+{
+    0, 0, &dxgi_notify_cs,
+    { &dxgi_notify_cs_debug.ProcessLocksList, &dxgi_notify_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": dxgi_notify_cs") }
+};
+static CRITICAL_SECTION dxgi_notify_cs = { &dxgi_notify_cs_debug, -1, 0, 0, 0, 0 };
+static LONG dxgi_notify_cookie;
+
+HRESULT dxgi_notify_register(struct list *list, unsigned int kind, HANDLE event, HWND window,
+        UINT message, DWORD *cookie)
+{
+    struct dxgi_notify *notify;
+    DWORD flags;
+
+    if (!cookie)
+        return DXGI_ERROR_INVALID_CALL;
+#ifndef SG_MUTANT_DXGI_NOTIFY_NO_VALIDATE
+    if (window ? !IsWindow(window) : (!event || !GetHandleInformation(event, &flags)))
+        return DXGI_ERROR_INVALID_CALL;
+#endif
+
+    if (!(notify = calloc(1, sizeof(*notify))))
+        return E_OUTOFMEMORY;
+
+    notify->cookie = InterlockedIncrement(&dxgi_notify_cookie);
+    notify->kind = kind;
+    notify->event = event;
+    notify->window = window;
+    notify->message = message;
+
+    EnterCriticalSection(&dxgi_notify_cs);
+    list_add_tail(list, &notify->entry);
+    LeaveCriticalSection(&dxgi_notify_cs);
+
+    *cookie = notify->cookie;
+    return S_OK;
+}
+
+BOOL dxgi_notify_unregister(struct list *list, unsigned int kind, DWORD cookie)
+{
+    struct dxgi_notify *notify;
+    BOOL found = FALSE;
+
+    EnterCriticalSection(&dxgi_notify_cs);
+    LIST_FOR_EACH_ENTRY(notify, list, struct dxgi_notify, entry)
+    {
+#ifdef SG_MUTANT_DXGI_NOTIFY_ANY_KIND
+        if (notify->cookie != cookie)
+            continue;
+#else
+        if (notify->cookie != cookie || notify->kind != kind)
+            continue;
+#endif
+        list_remove(&notify->entry);
+        free(notify);
+        found = TRUE;
+        break;
+    }
+    LeaveCriticalSection(&dxgi_notify_cs);
+
+    return found;
+}
+
+void dxgi_notify_cleanup(struct list *list)
+{
+    struct dxgi_notify *notify, *next;
+
+    EnterCriticalSection(&dxgi_notify_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(notify, next, list, struct dxgi_notify, entry)
+    {
+        list_remove(&notify->entry);
+        free(notify);
+    }
+    LeaveCriticalSection(&dxgi_notify_cs);
+}
+
