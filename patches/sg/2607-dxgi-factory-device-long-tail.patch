 static HRESULT STDMETHODCALLTYPE dxgi_device_EnqueueSetEvent(IWineDXGIDevice *iface, HANDLE event)
 {
-    FIXME("iface %p, event %p stub!\n", iface, event);
+    struct dxgi_device *device = impl_from_IWineDXGIDevice(iface);
+    struct dxgi_set_event_work *work;
+    DWORD flags;
+    HANDLE thread;
+    HRESULT hr;
+
+    TRACE("iface %p, event %p.\n", iface, event);
+
+    if (!event || !GetHandleInformation(event, &flags))
+        return DXGI_ERROR_INVALID_CALL;
+
+    if (!(work = calloc(1, sizeof(*work))))
+        return E_OUTOFMEMORY;
+
+    /* The event is signalled once the GPU has finished everything submitted so
+     * far: an event query issued behind the queued work completes at that point. */
+    wined3d_mutex_lock();
+    hr = wined3d_query_create(device->wined3d_device, WINED3D_QUERY_TYPE_EVENT, NULL,
+            &dxgi_null_wined3d_parent_ops, &work->query);
+    if (SUCCEEDED(hr))
+    {
+        struct wined3d_device_context *context = wined3d_device_get_immediate_context(device->wined3d_device);
+
+        wined3d_device_context_issue_query(context, work->query, WINED3DISSUE_END);
+        wined3d_device_context_flush(context);
+    }
+    wined3d_mutex_unlock();
+    if (FAILED(hr))
+    {
+        free(work);
+        return hr;
+    }
+
+    if (!DuplicateHandle(GetCurrentProcess(), event, GetCurrentProcess(), &work->event, 0, FALSE,
+            DUPLICATE_SAME_ACCESS))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        wined3d_mutex_lock();
+        wined3d_query_decref(work->query);
+        wined3d_mutex_unlock();
+        free(work);
+        return hr;
+    }
 
-    return E_NOTIMPL;
+    work->device = &device->IWineDXGIDevice_iface;
+    IWineDXGIDevice_AddRef(work->device);
+
+    if (!(thread = CreateThread(NULL, 0, dxgi_set_event_thread, work, 0, NULL)))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        dxgi_set_event_work_free(work);
+        return hr;
+    }
+    CloseHandle(thread);
+
+    return S_OK;
 }
 
