+struct dxgi_set_event_work
+{
+    IWineDXGIDevice *device;
+    struct wined3d_query *query;
+    HANDLE event;
+};
+
+static void dxgi_set_event_work_free(struct dxgi_set_event_work *work)
+{
+    wined3d_mutex_lock();
+    wined3d_query_decref(work->query);
+    wined3d_mutex_unlock();
+    CloseHandle(work->event);
+    IWineDXGIDevice_Release(work->device);
+    free(work);
+}
+
+static DWORD WINAPI dxgi_set_event_thread(void *param)
+{
+    struct dxgi_set_event_work *work = param;
+    HRESULT hr;
+
+    for (;;)
+    {
+        wined3d_mutex_lock();
+        hr = wined3d_query_get_data(work->query, NULL, 0, WINED3DGETDATA_FLUSH);
+        wined3d_mutex_unlock();
+        if (hr != S_FALSE)
+            break;
+        Sleep(1);
+    }
+
+#ifndef SG_MUTANT_DXGI_ENQUEUE_NEVER
+    SetEvent(work->event);
+#endif
+    dxgi_set_event_work_free(work);
+    return 0;
+}
