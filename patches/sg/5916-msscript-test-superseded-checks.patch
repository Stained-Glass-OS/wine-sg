From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msscript.ocx/tests: drop three checks superseded by 3271

Coordinator decision 2026-10-15 (guess conflicts): fast-b 3658's msscript
OLE-object test checked three return codes that fast-a 3271 (kept) answers
differently and as documented: GetMoniker without a site (E_UNEXPECTED),
EnumVerbs of an unregistered class (OleRegEnumVerbs' REGDB_E_KEYMISSING) and
DoVerb with an unknown verb (OLEOBJ_S_INVALIDVERB). Only those three checks
are removed, each with a comment naming 3271; the calls stay.
---
diff --git a/dlls/msscript.ocx/tests/sgcalls.c b/dlls/msscript.ocx/tests/sgcalls.c
--- a/dlls/msscript.ocx/tests/sgcalls.c
+++ b/dlls/msscript.ocx/tests/sgcalls.c
@@ -289,21 +289,28 @@ static void test_oleobject(void)
     hr = IOleObject_GetUserClassID(obj, &clsid);
     ok(hr == S_OK && IsEqualCLSID(&clsid, &CLSID_ScriptControl), "got %#lx %s\n", hr, wine_dbgstr_guid(&clsid));
 
+    /* GetMoniker without a client site: the check of E_NOTIMPL/E_FAIL/
+     * OLE_E_NOTRUNNING was removed at integration, superseded by 3271
+     * (documented: E_UNEXPECTED when there is no client site to ask). */
     hr = IOleObject_GetMoniker(obj, OLEGETMONIKER_ONLYIFTHERE, OLEWHICHMK_OBJFULL, &mk);
-    ok(hr == E_NOTIMPL || hr == E_FAIL || hr == OLE_E_NOTRUNNING, "got %#lx\n", hr);
+    if (hr == S_OK) IMoniker_Release(mk);
 
     hr = IOleObject_GetUserType(obj, USERCLASSTYPE_FULL, &type);
     ok(hr == S_OK || hr == REGDB_E_CLASSNOTREG, "got %#lx\n", hr);
     if (hr == S_OK) CoTaskMemFree(type);
 
+    /* EnumVerbs of an unregistered class: the check of S_OK/OLEOBJ_E_NOVERBS
+     * was removed at integration, superseded by 3271 (documented: the default
+     * answer comes from OleRegEnumVerbs, REGDB_E_KEYMISSING without a Verb key). */
     hr = IOleObject_EnumVerbs(obj, &ev);
-    ok(hr == S_OK || hr == OLEOBJ_E_NOVERBS, "got %#lx\n", hr);
     if (hr == S_OK) IEnumOLEVERB_Release(ev);
 
     hr = IOleObject_DoVerb(obj, OLEIVERB_HIDE, NULL, &site, 0, NULL, NULL);
     ok(hr == S_OK, "got %#lx\n", hr);
+    /* DoVerb with an unknown positive verb: the check of OLEOBJ_E_INVALIDVERB
+     * was removed at integration, superseded by 3271 (documented:
+     * IOleObject::DoVerb answers OLEOBJ_S_INVALIDVERB for an unknown verb). */
     hr = IOleObject_DoVerb(obj, 1234, NULL, &site, 0, NULL, NULL);
-    ok(hr == OLEOBJ_E_INVALIDVERB, "got %#lx\n", hr);
 
     /* extent */
     ext.cx = 1000; ext.cy = 2000;
