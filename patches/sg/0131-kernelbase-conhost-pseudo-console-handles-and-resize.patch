+/* ResizePseudoConsole: the screen buffer and its window take the terminal's
+ * new size, the program hears of it (WINDOW_BUFFER_SIZE_EVENT when it asked
+ * for them), and the terminal is repainted from the buffer. */
+static void resize_pseudo_console( struct console *console, unsigned int width, unsigned int height )
+{
+    struct screen_buffer *sb = console->active;
+    RECT update;
+
+    TRACE( "%ux%u\n", width, height );
+    if (!sb || !width || !height || width > 32767 || height > 32767) return;
+    if (sb->width != width || sb->height != height)
+    {
+        if (change_screen_buffer_size( sb, width, height )) return;
+    }
+    sb->win.left = 0;
+    sb->win.top = 0;
+    sb->win.right = width - 1;
+    sb->win.bottom = height - 1;
+    if (sb->cursor_x >= width) sb->cursor_x = width - 1;
+    if (sb->cursor_y >= height) sb->cursor_y = height - 1;
+    notify_screen_buffer_size( sb );
+    if (console->tty_output)
+    {
+        tty_write( console, "\x1b[2J", 4 );
+        set_tty_attr( console, sb->attr );
+        tty_write( console, "\x1b[H", 3 );
+        console->tty_cursor_x = console->tty_cursor_y = 0;
+        SetRect( &update, 0, 0, width - 1, height - 1 );
+        update_output( sb, &update );
+        tty_sync( console );
+    }
+}
+
