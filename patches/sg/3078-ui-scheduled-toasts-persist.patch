+
+/*
+ * Scheduled toasts outlive the program: each is kept under
+ * HKCU\Software\Stained Glass\Notifications\Scheduled\<name> with everything
+ * needed to show it, the way Windows keeps a program's schedule for the
+ * notification platform. While the program that scheduled a toast runs, its
+ * own worker shows it; the toast of a program that has exited is shown by a
+ * scheduler host (rundll32 windows.ui.dll,SgToastScheduler), which the first
+ * AddToSchedule starts, which the user's Run key starts again at logon, and
+ * which ends once nothing is left to deliver.
+ */
+#define SG_SCHEDULE_KEY L"Software\\Stained Glass\\Notifications\\Scheduled"
+#define SG_SCHEDULER_RUN_KEY L"Software\\Microsoft\\Windows\\CurrentVersion\\Run"
+#define SG_SCHEDULER_NAME L"SgToastScheduler"
+#define SG_SCHEDULER_MUTEX L"SgToastSchedulerHost"
+
+static HRESULT notifier_create( const WCHAR *aumid, IToastNotifier **out );
+static void start_scheduler_host(void);
+
+static void set_qword( HKEY key, const WCHAR *name, INT64 value )
+{
+    RegSetValueExW( key, name, 0, REG_QWORD, (const BYTE *)&value, sizeof(value) );
+}
+
+static INT64 get_qword( HKEY key, const WCHAR *name )
+{
+    INT64 value = 0;
+    DWORD size = sizeof(value);
+    if (RegGetValueW( key, NULL, name, RRF_RT_REG_QWORD, NULL, &value, &size )) return 0;
+    return value;
+}
+
+static WCHAR *get_sz( HKEY key, const WCHAR *name )
+{
+    DWORD size = 0;
+    WCHAR *value;
+
+    if (RegGetValueW( key, NULL, name, RRF_RT_REG_SZ, NULL, NULL, &size ) || !size) return NULL;
+    if (!(value = malloc( size + sizeof(WCHAR) ))) return NULL;
+    if (RegGetValueW( key, NULL, name, RRF_RT_REG_SZ, NULL, value, &size )) { free( value ); return NULL; }
+    return value;
+}
+
+static void set_hstring( HKEY key, const WCHAR *name, HSTRING value )
+{
+    if (value && WindowsGetStringLen( value )) set_sz( key, name, WindowsGetStringRawBuffer( value, NULL ) );
+    else RegDeleteValueW( key, name );
+}
+
+static HSTRING get_hstring( HKEY key, const WCHAR *name )
+{
+    HSTRING ret = NULL;
+    WCHAR *value = get_sz( key, name );
+
+    if (value) WindowsCreateString( value, wcslen( value ), &ret );
+    free( value );
+    return ret;
+}
+
+static void scheduler_run_entry( BOOL add )
+{
+    HKEY key;
+
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, SG_SCHEDULER_RUN_KEY, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL )) return;
+    if (add)
+    {
+        static const WCHAR cmd[] = L"rundll32.exe windows.ui.dll," SG_SCHEDULER_NAME;
+        RegSetValueExW( key, SG_SCHEDULER_NAME, 0, REG_SZ, (const BYTE *)cmd, sizeof(cmd) );
+    }
+    else RegDeleteValueW( key, SG_SCHEDULER_NAME );
+    RegCloseKey( key );
+}
+
+/* write (or rewrite) the schedule entry of an item scheduled with notifier */
+static void sched_persist( struct scheduled *item, const WCHAR *aumid )
+{
+    static LONG counter;
+    IXmlNodeSerializer *serializer;
+    HSTRING xml = NULL;
+    FILETIME created, exit_time, kernel, user;
+    WCHAR name[96], exe[MAX_PATH];
+    HKEY root, key;
+
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, SG_SCHEDULE_KEY, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &root, NULL )) return;
+    if (!item->reg_name)
+    {
+        swprintf( name, ARRAY_SIZE(name), L"%lu-%lu-%ld", GetCurrentProcessId(), GetTickCount(),
+                  InterlockedIncrement( &counter ) );
+        item->reg_name = wcsdup( name );
+    }
+    if (item->reg_name && !RegCreateKeyExW( root, item->reg_name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL ))
+    {
+        if (SUCCEEDED(IXmlDocument_QueryInterface( item->content, &IID_IXmlNodeSerializer, (void **)&serializer )))
+        {
+            if (SUCCEEDED(IXmlNodeSerializer_GetXml( serializer, &xml ))) set_hstring( key, L"Xml", xml );
+            WindowsDeleteString( xml );
+            IXmlNodeSerializer_Release( serializer );
+        }
+        set_sz( key, L"Aumid", aumid );
+        set_qword( key, L"Delivery", item->delivery );
+        set_qword( key, L"Snooze", item->snooze );
+        set_dword( key, L"MaxSnooze", item->max_snooze );
+        set_dword( key, L"SnoozesLeft", item->snoozes_left );
+        set_hstring( key, L"Id", item->id );
+        set_hstring( key, L"Tag", item->tag );
+        set_hstring( key, L"Group", item->group );
+        set_hstring( key, L"RemoteId", item->remote_id );
+        set_dword( key, L"SuppressPopup", item->suppress_popup );
+        set_dword( key, L"Mirroring", item->mirroring );
+        /* who delivers it while that program lives */
+        set_dword( key, L"OwnerPid", GetCurrentProcessId() );
+        if (GetProcessTimes( GetCurrentProcess(), &created, &exit_time, &kernel, &user ))
+            set_qword( key, L"OwnerStart", ((INT64)created.dwHighDateTime << 32) | created.dwLowDateTime );
+        GetModuleFileNameW( NULL, exe, ARRAY_SIZE(exe) );
+        set_sz( key, L"OwnerExe", exe );
+        RegCloseKey( key );
+    }
+    RegCloseKey( root );
+}
+
+static void sched_unpersist( struct scheduled *item )
+{
+    HKEY root;
+
+    if (!item->reg_name) return;
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, SG_SCHEDULE_KEY, 0, KEY_ALL_ACCESS, &root ))
+    {
+        RegDeleteKeyW( root, item->reg_name );
+        RegCloseKey( root );
+    }
+    free( item->reg_name );
+    item->reg_name = NULL;
+}
+
+/* an item from its entry; the notifier's program is returned in *aumid */
+static struct scheduled *sched_load( HKEY root, const WCHAR *name, WCHAR **aumid, WCHAR **owner_exe )
+{
+    IXmlDocument *content = NULL;
+    IXmlDocumentIO *io;
+    IScheduledToastNotification *item = NULL;
+    struct scheduled *impl = NULL;
+    HSTRING xml;
+    DateTime delivery;
+    HKEY key;
+
+    *aumid = NULL;
+    if (owner_exe) *owner_exe = NULL;
+    if (RegOpenKeyExW( root, name, 0, KEY_READ, &key )) return NULL;
+    *aumid = get_sz( key, L"Aumid" );
+    if (*aumid && (xml = get_hstring( key, L"Xml" )))
+    {
+        if (SUCCEEDED(xml_document_create( &content )))
+        {
+            if (SUCCEEDED(IXmlDocument_QueryInterface( content, &IID_IXmlDocumentIO, (void **)&io )))
+            {
+                if (FAILED(IXmlDocumentIO_LoadXml( io, xml ))) { IXmlDocument_Release( content ); content = NULL; }
+                IXmlDocumentIO_Release( io );
+            }
+        }
+        WindowsDeleteString( xml );
+    }
+    if (content)
+    {
+        delivery.UniversalTime = get_qword( key, L"Delivery" );
+        if (SUCCEEDED(scheduled_create( content, delivery, get_qword( key, L"Snooze" ), read_dword( key, L"MaxSnooze" ),
+                                        &item )))
+        {
+            impl = impl_from_IScheduledToastNotification( item );
+            impl->snoozes_left = read_dword( key, L"SnoozesLeft" );
+            impl->id = get_hstring( key, L"Id" );
+            impl->tag = get_hstring( key, L"Tag" );
+            impl->group = get_hstring( key, L"Group" );
+            impl->remote_id = get_hstring( key, L"RemoteId" );
+            impl->suppress_popup = read_dword( key, L"SuppressPopup" );
+            impl->mirroring = read_dword( key, L"Mirroring" );
+            impl->reg_name = wcsdup( name );
+            if (owner_exe) *owner_exe = get_sz( key, L"OwnerExe" );
+        }
+        IXmlDocument_Release( content );
+    }
+    RegCloseKey( key );
+    if (!impl) { free( *aumid ); *aumid = NULL; }
+    return impl;
+}
+
 /* show a due toast through the notifier it was scheduled with */
 static void deliver( struct scheduled *item, struct notifier *notifier )
 {
@@ -2731,12 +2930,14 @@ static DWORD WINAPI schedule_thread( void *arg )
                     /* a repeat: the same entry again after the interval */
                     due->snoozes_left--;
                     due->delivery += due->snooze;
+                    sched_persist( due, notifier->aumid );
                 }
                 else
                 {
                     list_remove( &due->entry );
                     list_init( &due->entry );
                     due->notifier = NULL;
+                    sched_unpersist( due );
                     IScheduledToastNotification_Release( &due->IScheduledToastNotification_iface );
                     release_notifier( notifier );   /* the schedule's reference */
                 }
@@ -2811,8 +3012,11 @@ static HRESULT WINAPI notifier_AddToSchedule( IToastNotifier *iface, IScheduledT
     item->notifier = impl;
     item->snoozes_left = item->max_snooze;
     list_add_tail( &schedule, &item->entry );
+    sched_persist( item, impl->aumid );
     LeaveCriticalSection( &schedule_cs );
     SetEvent( schedule_event );
+    scheduler_run_entry( TRUE );
+    start_scheduler_host();
     return S_OK;
 }
 
@@ -2831,13 +3035,195 @@ static HRESULT WINAPI notifier_RemoveFromSchedule( IToastNotifier *iface, ISched
         list_init( &item->entry );
         release_notifier( item->notifier );
         item->notifier = NULL;
+        sched_unpersist( item );
         IScheduledToastNotification_Release( &item->IScheduledToastNotification_iface );
     }
+    else if (item->reg_name && !item->notifier)
+    {
+        /* one kept from an earlier run of the program: only that program's */
+        HKEY root, key;
+        WCHAR *aumid = NULL;
+
+        if (!RegOpenKeyExW( HKEY_CURRENT_USER, SG_SCHEDULE_KEY, 0, KEY_ALL_ACCESS, &root ))
+        {
+            if (!RegOpenKeyExW( root, item->reg_name, 0, KEY_READ, &key ))
+            {
+                aumid = get_sz( key, L"Aumid" );
+                RegCloseKey( key );
+            }
+            if (aumid && !wcscmp( aumid, impl->aumid )) RegDeleteKeyW( root, item->reg_name );
+            RegCloseKey( root );
+        }
+        free( aumid );
+    }
     LeaveCriticalSection( &schedule_cs );
     if (schedule_event) SetEvent( schedule_event );
     return S_OK;
 }
 
+
+/* start the scheduler host unless one runs */
+static void start_scheduler_host(void)
+{
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    WCHAR dir[MAX_PATH], cmd[MAX_PATH + 64];
+    HANDLE mutex;
+
+    if ((mutex = OpenMutexW( SYNCHRONIZE, FALSE, SG_SCHEDULER_MUTEX )))
+    {
+        CloseHandle( mutex );
+        return;
+    }
+#ifdef SG_MUTANT_NO_SCHEDULER_HOST
+    return;
+#endif
+    GetSystemDirectoryW( dir, ARRAY_SIZE(dir) );
+    swprintf( cmd, ARRAY_SIZE(cmd), L"\"%ls\\rundll32.exe\" windows.ui.dll," SG_SCHEDULER_NAME, dir );
+    si.dwFlags = STARTF_USESHOWWINDOW;
+    si.wShowWindow = SW_HIDE;
+    if (CreateProcessW( NULL, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi ))
+    {
+        CloseHandle( pi.hThread );
+        CloseHandle( pi.hProcess );
+    }
+}
+
+/* the process that scheduled the entry is still running */
+static BOOL owner_runs( HKEY key )
+{
+    DWORD pid = read_dword( key, L"OwnerPid" );
+    INT64 started = get_qword( key, L"OwnerStart" );
+    FILETIME created, exit_time, kernel, user;
+    HANDLE process;
+    BOOL ret = FALSE;
+
+    if (!pid || !(process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE, FALSE, pid ))) return FALSE;
+    if (WaitForSingleObject( process, 0 ) == WAIT_TIMEOUT)
+    {
+        if (!started || !GetProcessTimes( process, &created, &exit_time, &kernel, &user )) ret = TRUE;
+        else ret = (((INT64)created.dwHighDateTime << 32) | created.dwLowDateTime) == started;
+    }
+    CloseHandle( process );
+    return ret;
+}
+
+/* deliver what is due of the entries whose program has exited; returns how
+ * many entries remain and, in *wait, the milliseconds until the next is due */
+static DWORD scheduler_pass( DWORD *wait )
+{
+    HKEY root;
+    WCHAR name[96];
+    DWORD i, len, remaining = 0;
+    INT64 now = now_ticks();
+
+    *wait = 5000;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, SG_SCHEDULE_KEY, 0, KEY_ALL_ACCESS, &root )) return 0;
+    for (i = 0; len = ARRAY_SIZE(name), !RegEnumKeyExW( root, i, name, &len, NULL, NULL, NULL, NULL ); i++)
+    {
+        struct scheduled *item;
+        IToastNotifier *notifier;
+        WCHAR *aumid, *exe;
+        HKEY key;
+        BOOL alive = TRUE;
+        INT64 due;
+
+        if (RegOpenKeyExW( root, name, 0, KEY_READ, &key )) continue;
+        alive = owner_runs( key );
+        due = get_qword( key, L"Delivery" );
+        RegCloseKey( key );
+        remaining++;
+        if (alive) continue;            /* its program delivers it */
+        if (due > now)
+        {
+            INT64 ms = (due - now) / 10000;
+            if (ms < *wait) *wait = (DWORD)ms + 1;
+            continue;
+        }
+        if (!(item = sched_load( root, name, &aumid, &exe )))
+        {
+            /* not an entry we can show: drop it */
+            if (!RegDeleteKeyW( root, name )) { remaining--; i--; }
+            continue;
+        }
+        if (item->snoozes_left)
+        {
+            /* a repeat: the same entry again after the interval, now ours */
+            item->snoozes_left--;
+            item->delivery += item->snooze;
+            if (!RegOpenKeyExW( root, name, 0, KEY_WRITE, &key ))
+            {
+                set_qword( key, L"Delivery", item->delivery );
+                set_dword( key, L"SnoozesLeft", item->snoozes_left );
+                set_dword( key, L"OwnerPid", 0 );
+                RegCloseKey( key );
+            }
+        }
+        else if (!RegDeleteKeyW( root, name ))
+        {
+            remaining--;
+            i--;                /* a deleted entry shifts the rest */
+        }
+        else
+        {
+            /* someone else took it */
+            free( aumid );
+            aumid = NULL;
+        }
+        if (aumid && SUCCEEDED(notifier_create( aumid, &notifier )))
+        {
+            lstrcpynW( host_owner_exe, exe ? exe : L"", ARRAY_SIZE(host_owner_exe) );
+            deliver( item, impl_from_IToastNotifier( notifier ) );
+            IToastNotifier_Release( notifier );
+        }
+        free( aumid );
+        free( exe );
+        IScheduledToastNotification_Release( &item->IScheduledToastNotification_iface );
+    }
+    RegCloseKey( root );
+    return remaining;
+}
+
+/***********************************************************************
+ *      SgToastScheduler (windows.ui.@)
+ *
+ * Stained Glass OS: rundll32 entry point of the scheduler host. It delivers
+ * the scheduled toasts of programs that have exited, and ends a while after
+ * nothing is left.
+ */
+void WINAPI SgToastScheduler( HWND hwnd, HINSTANCE instance, LPSTR cmdline, int show )
+{
+    HANDLE mutex;
+    DWORD wait, idle = 0;
+    BOOL ro = SUCCEEDED(RoInitialize( RO_INIT_MULTITHREADED ));
+
+    mutex = CreateMutexW( NULL, FALSE, SG_SCHEDULER_MUTEX );
+    if (!mutex || GetLastError() == ERROR_ALREADY_EXISTS)
+    {
+        if (mutex) CloseHandle( mutex );
+        if (ro) RoUninitialize();
+        return;
+    }
+    for (;;)
+    {
+        DWORD left = scheduler_pass( &wait );
+
+        if (left) idle = 0;
+        else if ((idle += wait) >= 60000) break;     /* toasts on screen finish first */
+        Sleep( wait );
+    }
+    scheduler_run_entry( FALSE );
+    /* an entry made while this one ended is not left without a host */
+    if (scheduler_pass( &wait ))
+    {
+        scheduler_run_entry( TRUE );
+        CloseHandle( mutex );
+        start_scheduler_host();
+    }
+    else CloseHandle( mutex );
+    if (ro) RoUninitialize();
+}
