+/* ---- FocusManager ---- */
+
+static HRESULT WINAPI fm_GetFocusedElement( struct xfiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (focus) IUnknown_QueryInterface( focus->d.obj.outer, &IID_IInspectable, (void **)value );
+    return S_OK;
+}
+
+/* TryMoveFocus: Next 0, Previous 1 as Tab and Shift+Tab, Up 2, Down 3, Left 4, Right 5 as the arrow keys */
+static HRESULT WINAPI fm_TryMoveFocus( struct xfiface *iface, INT32 direction, boolean *moved )
+{
+    static const UINT arrows[] = { VK_UP, VK_DOWN, VK_LEFT, VK_RIGHT };
+    struct uielem *root, *before = focus;
+    IInspectable *content = NULL;
+
+    if (!moved) return E_POINTER;
+    *moved = FALSE;
+    if (!focus || direction < 0 || direction > 5) return S_OK;
+    for (root = focus; root->parent; root = root->parent);
+    if (direction <= 1)
+    {
+        if (FAILED(IUnknown_QueryInterface( root->d.obj.outer, &IID_IInspectable, (void **)&content ))) return S_OK;
+        move_focus( focus_hwnd, content, direction == 1 );
+        IInspectable_Release( content );
+    }
+    else move_focus_xy( focus_hwnd, arrows[direction - 2] );
+    *moved = focus && focus != before;
+    return S_OK;
+}
+
+static const void *fm_statics_vtbl[] =
+{
+    IFocusManagerStatics_FSTUBS,
+    [IFocusManagerStatics_GetFocusedElement] = fm_GetFocusedElement,
+};
+
+static const void *fm_statics2_vtbl[] =
+{
+    IFocusManagerStatics2_FSTUBS,
+    [IFocusManagerStatics2_TryMoveFocus] = fm_TryMoveFocus,
+};
+
+static struct xfactory fm_factory_obj =
+{
+    { &xfactory_vtbl }, L"Windows.UI.Xaml.Input.FocusManager",
+    { &IID_IFocusManagerStatics, &IID_IFocusManagerStatics2 }, { { fm_statics_vtbl }, { fm_statics2_vtbl } }, NULL
+};
+IActivationFactory *focus_manager_factory = &fm_factory_obj.IActivationFactory_iface;
