+/* ---- a ListView from the keyboard ---- */
+
+static const struct xclass list_view_class;
+
+static BOOL is_list_view( struct items_control *items )
+{
+    return items && items->c.e.d.obj.cls == &list_view_class;
+}
+
+/* a ListView's item takes the focus (an ItemsControl's do not) */
+BOOL xaml_is_list_view_item( struct uielem *elem )
+{
+    return xaml_is_list_item( elem ) && is_list_view( host_from_elem( elem )->owner );
+}
+
+BOOL xaml_is_list_view( struct uielem *elem )
+{
+    return elem && elem->d.obj.cls == &list_view_class;
+}
+
+static struct uielem *container_at( struct items_control *items, UINT32 index )
+{
+    struct uielem *child;
+
+    LIST_FOR_EACH_ENTRY( child, &items->c.e.children, struct uielem, entry )
+        if (xaml_is_list_item( child ) && host_from_elem( child )->index == index) return child;
+    return NULL;
+}
+
+/* where Tab enters a ListView: its selected item's container, or NULL */
+struct uielem *xaml_list_view_tab_entry( struct uielem *elem )
+{
+    struct items_control *items;
+
+    if (!xaml_is_list_view( elem )) return NULL;
+    items = items_from_elem( elem );
+    return items->selected_index >= 0 ? container_at( items, items->selected_index ) : NULL;
+}
+
+/* keys on a focused ListView item: Up/Down/Home/End/PageUp/PageDown move the focus (the selection
+ * follows it in Single and Extended mode), Space selects, Enter clicks (ItemClick) */
+BOOL xaml_list_item_key( struct uielem *elem, UINT vk, HWND hwnd )
+{
+    struct item_host *host;
+    struct items_control *items;
+    struct uielem *child, *to;
+    INT32 index, count = 0, mode;
+
+    if (!xaml_is_list_view_item( elem )) return FALSE;
+    host = host_from_elem( elem );
+    items = host->owner;
+    LIST_FOR_EACH_ENTRY( child, &items->c.e.children, struct uielem, entry ) if (xaml_is_list_item( child )) count++;
+    index = host->index;
+    mode = get_int( &items->c.e.d, prop_selection_mode );
+    switch (vk)
+    {
+    case VK_UP: index--; break;
+    case VK_DOWN: index++; break;
+    case VK_HOME: index = 0; break;
+    case VK_END: index = count - 1; break;
+    case VK_PRIOR: index -= 10; break;
+    case VK_NEXT: index += 10; break;
+    case VK_SPACE:
+        if (mode) selector_select( items, host->index );
+        return TRUE;
+    case VK_RETURN:
+        xaml_list_item_click( elem );
+        return TRUE;
+    default: return FALSE;
+    }
+#ifdef SG_MUTANT_LIST_NO_KEYS
+    return FALSE;
+#endif
+    if (index < 0) index = 0;
+    if (index >= count) index = count - 1;
+    if (index < 0 || !(to = container_at( items, index ))) return TRUE;
+    xaml_focus_element_state( to, hwnd, 2 );
+    if (mode == 1 || mode == 3) selector_select( items, index );
+    return TRUE;
+}
+
 /* the containers made again for the current items */
 static void make_containers( struct items_control *items )
 {
