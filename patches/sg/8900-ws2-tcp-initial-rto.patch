From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ws2_32: SIO_TCP_INITIAL_RTO sets the SYN retransmissions of a TCP socket

libuv (Node, Electron) and the JDK call WSAIoctl(SIO_TCP_INITIAL_RTO) before a loopback connect so that a refused connect fails at once; Wine answered "unimplemented ioctl". Linux has no per-socket initial RTO; MaxSynRetransmissions becomes TCP_SYNCNT (no retransmissions -> 1, the fewest Linux makes; default -> net.ipv4.tcp_syn_retries; unspecified -> unchanged). Non-TCP sockets: WSAEOPNOTSUPP. Found by the runtime FIXME census set 3 (Arduino IDE, Joplin, Logseq, DBeaver).
---
--- a/include/mstcpip.h
+++ b/include/mstcpip.h
@@ -27,6 +27,18 @@
     ULONG keepaliveinterval;
 };
 
+typedef struct _TCP_INITIAL_RTO_PARAMETERS
+{
+    USHORT Rtt;
+    UCHAR MaxSynRetransmissions;
+} TCP_INITIAL_RTO_PARAMETERS, *PTCP_INITIAL_RTO_PARAMETERS;
+
+#define TCP_INITIAL_RTO_UNSPECIFIED_RTT                     ((USHORT)-1)
+#define TCP_INITIAL_RTO_UNSPECIFIED_MAX_SYN_RETRANSMISSIONS ((UCHAR)-1)
+#define TCP_INITIAL_RTO_DEFAULT_RTT                         0
+#define TCP_INITIAL_RTO_DEFAULT_MAX_SYN_RETRANSMISSIONS     0
+#define TCP_INITIAL_RTO_NO_SYN_RETRANSMISSIONS              ((UCHAR)-2)
+
 #ifndef USE_WS_PREFIX
 
 #define SIO_RCVALL            _WSAIOW(IOC_VENDOR, 1)
@@ -40,6 +52,7 @@
 #define SIO_INDEX_MCASTIF     _WSAIOW(IOC_VENDOR, 9)
 #define SIO_INDEX_ADD_MCAST   _WSAIOW(IOC_VENDOR, 10)
 #define SIO_INDEX_DEL_MCAST   _WSAIOW(IOC_VENDOR, 11)
+#define SIO_TCP_INITIAL_RTO   _WSAIOW(IOC_VENDOR, 17)
 
 #define RCVALL_OFF             0
 #define RCVALL_ON              1
@@ -68,6 +81,7 @@
 #define WS_SIO_INDEX_MCASTIF     _WSAIOW(WS_IOC_VENDOR, 9)
 #define WS_SIO_INDEX_ADD_MCAST   _WSAIOW(WS_IOC_VENDOR, 10)
 #define WS_SIO_INDEX_DEL_MCAST   _WSAIOW(WS_IOC_VENDOR, 11)
+#define WS_SIO_TCP_INITIAL_RTO   _WSAIOW(WS_IOC_VENDOR, 17)
 
 #define WS_RCVALL_OFF             0
 #define WS_RCVALL_ON              1
--- a/include/wine/afd.h
+++ b/include/wine/afd.h
@@ -294,6 +294,8 @@
 #define IOCTL_AFD_WINE_SET_SO_ERROR                     WINE_AFD_IOC(305)
 #define IOCTL_AFD_WINE_SET_UDP_CONNRESET                WINE_AFD_IOC(306)
 #define IOCTL_AFD_WINE_DISCONNECT_REUSE                 WINE_AFD_IOC(307)
+/* Stained Glass OS (8900): SIO_TCP_INITIAL_RTO */
+#define IOCTL_AFD_WINE_TCP_INITIAL_RTO                  WINE_AFD_IOC(389)
 
 struct afd_iovec
 {
--- a/dlls/ws2_32/socket.c
+++ b/dlls/ws2_32/socket.c
@@ -2421,6 +2421,7 @@
         IOCTL_NAME(SIO_IDEAL_SEND_BACKLOG_CHANGE);
         IOCTL_NAME(SIO_IDEAL_SEND_BACKLOG_QUERY);
         IOCTL_NAME(SIO_KEEPALIVE_VALS);
+        IOCTL_NAME(SIO_TCP_INITIAL_RTO);
         IOCTL_NAME(SIO_MULTIPOINT_LOOPBACK);
         IOCTL_NAME(SIO_MULTICAST_SCOPE);
         /* IOCTL_NAME(SIO_QUERY_RSS_SCALABILITY_INFO);
@@ -2800,6 +2801,21 @@
         return ret ? -1 : 0;
     }
 
+    /* Stained Glass OS (8900): the SYN retransmissions a TCP connect makes (libuv and the JDK set it
+     * for loopback connects, so that a refused one fails at once) */
+#ifndef SG_MUTANT_NO_INITIAL_RTO
+    case SIO_TCP_INITIAL_RTO:
+    {
+        DWORD ret;
+
+        ret = server_ioctl_sock( s, IOCTL_AFD_WINE_TCP_INITIAL_RTO, in_buff, in_size,
+                                 out_buff, out_size, ret_size, overlapped, completion );
+        if (!overlapped || completion) *ret_size = 0;
+        SetLastError( ret );
+        return ret ? -1 : 0;
+    }
+#endif
+
     case SIO_ROUTING_INTERFACE_QUERY:
     {
         struct sockaddr *daddr = (struct sockaddr *)in_buff;
--- a/dlls/ntdll/unix/socket.c
+++ b/dlls/ntdll/unix/socket.c
@@ -25,6 +25,7 @@
 #include "config.h"
 #include <assert.h>
 #include <errno.h>
+#include <stdio.h>
 #include <sys/types.h>
 #include <sys/socket.h>
 #include <sys/ioctl.h>
@@ -2115,6 +2116,56 @@
             if (needs_close) close( fd );
             file_complete_async( handle, options, event, apc, apc_user, io, STATUS_SUCCESS, 0 );
             return STATUS_SUCCESS;
+        }
+
+        /* Stained Glass OS (8900): SIO_TCP_INITIAL_RTO. Linux has no per-socket initial RTO; the
+         * number of SYN retransmissions is TCP_SYNCNT (1-127: "none" becomes 1, the fewest Linux makes;
+         * "default" restores net.ipv4.tcp_syn_retries). */
+        case IOCTL_AFD_WINE_TCP_INITIAL_RTO:
+        {
+            const TCP_INITIAL_RTO_PARAMETERS *params = in_buffer;
+            int type, proto, count = -1;
+            socklen_t len = sizeof(int);
+
+            if (!in_buffer || in_size < sizeof(*params))
+                return STATUS_BUFFER_TOO_SMALL;
+
+            if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, &options )))
+                return status;
+
+            if (getsockopt( fd, SOL_SOCKET, SO_TYPE, &type, &len ) < 0 || type != SOCK_STREAM
+#ifdef SO_PROTOCOL
+                || (len = sizeof(int), getsockopt( fd, SOL_SOCKET, SO_PROTOCOL, &proto, &len ) < 0)
+                || proto != IPPROTO_TCP
+#endif
+                )
+            {
+                status = STATUS_NOT_SUPPORTED;
+                break;
+            }
+            if (params->MaxSynRetransmissions == TCP_INITIAL_RTO_NO_SYN_RETRANSMISSIONS)
+                count = 1;
+            else if (params->MaxSynRetransmissions == TCP_INITIAL_RTO_DEFAULT_MAX_SYN_RETRANSMISSIONS)
+            {
+                FILE *f = fopen( "/proc/sys/net/ipv4/tcp_syn_retries", "r" );
+                if (f)
+                {
+                    if (fscanf( f, "%d", &count ) != 1) count = -1;
+                    fclose( f );
+                }
+            }
+            else if (params->MaxSynRetransmissions != TCP_INITIAL_RTO_UNSPECIFIED_MAX_SYN_RETRANSMISSIONS)
+                count = min( params->MaxSynRetransmissions, 127 );
+#ifdef TCP_SYNCNT
+            if (count > 0 && setsockopt( fd, IPPROTO_TCP, TCP_SYNCNT, &count, sizeof(count) ) < 0)
+            {
+                status = STATUS_INVALID_PARAMETER;
+                break;
+            }
+#endif
+            if (needs_close) close( fd );
+            file_complete_async( handle, options, event, apc, apc_user, io, STATUS_SUCCESS, 0 );
+            return STATUS_SUCCESS;
         }
 
         case IOCTL_AFD_WINE_GETPEERNAME:
