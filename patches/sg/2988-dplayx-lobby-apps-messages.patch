+/* Lobby messages. A message is a chain of blocks of the dynamic area:
+ * the first block says how long the message is and which one comes next in
+ * the queue, the blocks hold the data a piece after the other. Indexes are
+ * used instead of pointers: the area may be mapped at another address in
+ * another process. */
+#define DPLAYX_LOBMSG_CHUNK    ( dwBlockSize - sizeof(BOOL) - 4 * sizeof(DWORD) )
+#define DPLAYX_LOBMSG_MAXSIZE  4096
+#define DPLAYX_LOBMSG_MAXQUEUE 64
+
+typedef struct
+{
+  DWORD nextMsg;   /* first block of the next message of the queue + 1 */
+  DWORD nextChunk; /* next block of this message + 1 */
+  DWORD flags;
+  DWORD size;      /* size of the whole message (first block) */
+  BYTE  data[ dwBlockSize - sizeof(BOOL) - 4 * sizeof(DWORD) ];
+} DPLAYX_LOBMSG;
+C_ASSERT(sizeof(DPLAYX_LOBMSG) == dwBlockSize - sizeof(BOOL));
+
+static DWORD DPLAYX_LobMsgNumber( DPLAYX_LOBMSG *msg )
+{
+  return (DWORD)( ( (BYTE*)msg - (BYTE*)lpMemArea ) / dwBlockSize ) + 1;
+}
+
+static DPLAYX_LOBMSG *DPLAYX_LobMsgFromNumber( DWORD number )
+{
+  return number ? (DPLAYX_LOBMSG*)lpMemArea[ number - 1 ].data : NULL;
+}
+
+static void DPLAYX_FreeLobMsg( DPLAYX_LOBMSG *msg )
+{
+  while( msg )
+  {
+    DPLAYX_LOBMSG *next = DPLAYX_LobMsgFromNumber( msg->nextChunk );
+    DPLAYX_PrivHeapFree( msg );
+    msg = next;
+  }
+}
+
+/* The semaphore must be held */
+static HRESULT DPLAYX_QueueLobMsg( DWORD *head, DWORD *tail, DWORD flags, const void *data,
+                                   DWORD size )
+{
+  DPLAYX_LOBMSG *first = NULL, *last = NULL, *msg;
+  DWORD offset = 0, queued = 0, number;
+
+  for( number = *head; number; number = DPLAYX_LobMsgFromNumber( number )->nextMsg )
+    queued++;
+
+  if( queued >= DPLAYX_LOBMSG_MAXQUEUE )
+    return DPERR_OUTOFMEMORY;
+
+  while( offset < size )
+  {
+    DWORD part = min( size - offset, DPLAYX_LOBMSG_CHUNK );
+
+    msg = DPLAYX_PrivHeapAlloc( HEAP_ZERO_MEMORY, sizeof( *msg ) );
+    if( !msg )
+    {
+      DPLAYX_FreeLobMsg( first );
+      return DPERR_OUTOFMEMORY;
+    }
+
+    memcpy( msg->data, (const BYTE*)data + offset, part );
+    offset += part;
+
+    if( last )
+      last->nextChunk = DPLAYX_LobMsgNumber( msg );
+    else
+      first = msg;
+    last = msg;
+  }
+
+  first->flags = flags;
+  first->size  = size;
+
+#ifdef SG_MUTANT_L_MSGORDER
+  /* newest first */
+  first->nextMsg = *head;
+  *head = DPLAYX_LobMsgNumber( first );
+  if( !*tail )
+    *tail = *head;
+  return DP_OK;
+#endif
+  if( *tail )
+    DPLAYX_LobMsgFromNumber( *tail )->nextMsg = DPLAYX_LobMsgNumber( first );
+  else
+    *head = DPLAYX_LobMsgNumber( first );
+  *tail = DPLAYX_LobMsgNumber( first );
+
+  return DP_OK;
+}
+
+/* Works out which side of the conversation the caller is. 0 is how the
+ * application names itself; a lobby client names the application by its
+ * process id. The semaphore must be held. */
+static HRESULT DPLAYX_LobMsgSide( DWORD dwAppID, LPDPLAYX_LOBBYDATA *lplpData, BOOL *bApp )
+{
+  if( !DPLAYX_IsAppIdLobbied( dwAppID, lplpData ) )
+    return DPERR_NOTLOBBIED;
+
+  *bApp = ( dwAppID == 0 ) ||
+          ( dwAppID == GetCurrentProcessId() &&
+            (*lplpData)->dwAppLaunchedFromID != GetCurrentProcessId() );
+
+  return DP_OK;
+}
+
+HRESULT DPLAYX_SendLobbyMessage( DWORD dwFlags, DWORD dwAppID, const void *lpData, DWORD dwSize )
+{
+  LPDPLAYX_LOBBYDATA lpDplData;
+  HANDLE hNotify = 0;
+  BOOL bApp;
+  HRESULT hr;
+
+  if( dwFlags & ~DPLMSG_STANDARD )
+    return DPERR_INVALIDFLAGS;
+
+  if( !lpData || !dwSize )
+    return DPERR_INVALIDPARAMS;
+
+  if( dwSize > DPLAYX_LOBMSG_MAXSIZE )
+    return DPERR_BUFFERTOOLARGE;
+
+  DPLAYX_AcquireSemaphore();
+
+  hr = DPLAYX_LobMsgSide( dwAppID, &lpDplData, &bApp );
+  if( hr == DP_OK )
+  {
+    if( bApp )
+    {
+      hr = DPLAYX_QueueLobMsg( &lpDplData->dwToLobbyHead, &lpDplData->dwToLobbyTail,
+                               DPLMSG_STANDARD, lpData, dwSize );
+      /* The event of the client was made for the application's process */
+      if( hr == DP_OK && lpDplData->dwAppID == GetCurrentProcessId() )
+        hNotify = lpDplData->hNotifyLobby;
+    }
+    else
+    {
+      hr = DPLAYX_QueueLobMsg( &lpDplData->dwToAppHead, &lpDplData->dwToAppTail,
+                               DPLMSG_STANDARD, lpData, dwSize );
+      /* The event of the application was made for the client's process */
+      if( hr == DP_OK && lpDplData->dwAppLaunchedFromID == GetCurrentProcessId() )
+        hNotify = lpDplData->hNotifyApp;
+    }
+  }
+
+  DPLAYX_ReleaseSemaphore();
+
+#ifndef SG_MUTANT_L_EVENT
+  if( hNotify )
+    SetEvent( hNotify );
+#endif
+
+  return hr;
+}
+
+HRESULT DPLAYX_ReceiveLobbyMessage( DWORD dwFlags, DWORD dwAppID, DWORD *lpdwMessageFlags,
+                                    void *lpData, DWORD *lpdwDataSize )
+{
+  LPDPLAYX_LOBBYDATA lpDplData;
+  DPLAYX_LOBMSG *msg, *chunk;
+  DWORD *head, *tail;
+  BOOL bApp;
+  HRESULT hr;
+
+  if( dwFlags )
+    return DPERR_INVALIDFLAGS;
+
+  if( !lpdwMessageFlags || !lpdwDataSize )
+    return DPERR_INVALIDPARAMS;
+
+  DPLAYX_AcquireSemaphore();
+
+  hr = DPLAYX_LobMsgSide( dwAppID, &lpDplData, &bApp );
+  if( hr != DP_OK )
+  {
+    DPLAYX_ReleaseSemaphore();
+    return hr;
+  }
+
+  /* The application reads what the client sent and the other way round */
+#ifdef SG_MUTANT_L_SIDE
+  bApp = !bApp;
+#endif
+  head = bApp ? &lpDplData->dwToAppHead : &lpDplData->dwToLobbyHead;
+  tail = bApp ? &lpDplData->dwToAppTail : &lpDplData->dwToLobbyTail;
+
+  msg = DPLAYX_LobMsgFromNumber( *head );
+  if( !msg )
+  {
+    DPLAYX_ReleaseSemaphore();
+    return DPERR_NOMESSAGES;
+  }
+
+  /* A message that does not fit stays in the queue */
+  if( !lpData || *lpdwDataSize < msg->size )
+  {
+    *lpdwDataSize = msg->size;
+#ifdef SG_MUTANT_L_MSGKEEP
+    *head = msg->nextMsg;
+    if( !*head )
+      *tail = 0;
+    DPLAYX_FreeLobMsg( msg );
+#endif
+    DPLAYX_ReleaseSemaphore();
+    return DPERR_BUFFERTOOSMALL;
+  }
+
+  *lpdwDataSize = msg->size;
+#ifdef SG_MUTANT_L_MSGSIZE
+  *lpdwDataSize = msg->size - 1;
+#endif
+  *lpdwMessageFlags = msg->flags;
+
+  {
+    DWORD offset = 0;
+
+    for( chunk = msg; chunk && offset < msg->size; chunk = DPLAYX_LobMsgFromNumber( chunk->nextChunk ) )
+    {
+      DWORD part = min( msg->size - offset, DPLAYX_LOBMSG_CHUNK );
+
+      memcpy( (BYTE*)lpData + offset, chunk->data, part );
+      offset += part;
+    }
+  }
+
+  *head = msg->nextMsg;
+  if( !*head )
+    *tail = 0;
+
+  DPLAYX_FreeLobMsg( msg );
+
+  DPLAYX_ReleaseSemaphore();
+
+  return DP_OK;
+}
+
+HRESULT DPLAYX_SetLobbyMessageEvent( DWORD dwFlags, DWORD dwAppID, HANDLE hEvent )
+{
+  LPDPLAYX_LOBBYDATA lpDplData;
+  HANDLE hTarget, hDup = 0;
+  DWORD dwTargetPid;
+  BOOL bApp;
+  HRESULT hr;
+
+  if( dwFlags )
+    return DPERR_INVALIDFLAGS;
+
+  DPLAYX_AcquireSemaphore();
+
+  hr = DPLAYX_LobMsgSide( dwAppID, &lpDplData, &bApp );
+  if( hr != DP_OK )
+  {
+    DPLAYX_ReleaseSemaphore();
+    return hr;
+  }
+
+  /* Whoever sends the messages the event is for has to be able to set it:
+   * the application's events are used by the client's process and the
+   * other way round. */
+  dwTargetPid = bApp ? lpDplData->dwAppLaunchedFromID : lpDplData->dwAppID;
+
+  if( hEvent )
+  {
+    if( dwTargetPid == GetCurrentProcessId() )
+      hTarget = GetCurrentProcess();
+    else
+      hTarget = OpenProcess( PROCESS_DUP_HANDLE, FALSE, dwTargetPid );
+
+    if( !hTarget ||
+        !DuplicateHandle( GetCurrentProcess(), hEvent, hTarget, &hDup, 0, FALSE,
+                          DUPLICATE_SAME_ACCESS ) )
+    {
+      if( hTarget && hTarget != GetCurrentProcess() )
+        CloseHandle( hTarget );
+      DPLAYX_ReleaseSemaphore();
+      return DPERR_INVALIDPARAMS;
+    }
+
+    if( hTarget != GetCurrentProcess() )
+      CloseHandle( hTarget );
+  }
+
+  if( bApp )
+    lpDplData->hNotifyApp = hDup;
+  else
+    lpDplData->hNotifyLobby = hDup;
+
+  DPLAYX_ReleaseSemaphore();
+
+  return DP_OK;
+}
