+/* An application is registered as a subkey of the applications key, named
+ * after the application, with the values Guid, File, Path, CommandLine,
+ * CurrentDirectory and the descriptions. */
+static WCHAR *DPL_StringToW( const void *string, BOOL ansi )
+{
+  WCHAR *result;
+  int len;
+
+  if( !string )
+    return NULL;
+
+  if( !ansi )
+    return wcsdup( string );
+
+  len = MultiByteToWideChar( CP_ACP, 0, string, -1, NULL, 0 );
+  result = malloc( len * sizeof( WCHAR ) );
+  if( result )
+    MultiByteToWideChar( CP_ACP, 0, string, -1, result, len );
+
+  return result;
+}
+
+static LONG DPL_SetRegString( HKEY key, const WCHAR *name, const WCHAR *value )
+{
+  return RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)value,
+                         ( wcslen( value ) + 1 ) * sizeof( WCHAR ) );
+}
+
+static HRESULT DPL_RegisterApplication( DWORD flags, const DPAPPLICATIONDESC *desc, BOOL ansi )
+{
+  static const WCHAR applicationsKey[] = L"SOFTWARE\\Microsoft\\DirectPlay\\Applications";
+  WCHAR *name, *file, *path, *commandLine, *currentDirectory, *descriptionW = NULL;
+  WCHAR guidString[ 40 ], *keyPath;
+  LONG ret = ERROR_SUCCESS;
+  HRESULT hr = DP_OK;
+  HKEY hkey;
+
+  if( flags )
+    return DPERR_INVALIDFLAGS;
+
+  /* The name, the file and where it is are required */
+  if( !desc || desc->dwSize != sizeof( DPAPPLICATIONDESC ) || !desc->lpszApplicationName ||
+      !desc->lpszFilename || !desc->lpszPath )
+    return DPERR_INVALIDPARAMS;
+
+  name             = DPL_StringToW( desc->lpszApplicationName, ansi );
+  file             = DPL_StringToW( desc->lpszFilename, ansi );
+  path             = DPL_StringToW( desc->lpszPath, ansi );
+  commandLine      = DPL_StringToW( desc->lpszCommandLine, ansi );
+  currentDirectory = DPL_StringToW( desc->lpszCurrentDirectory, ansi );
+  if( desc->lpszDescriptionW )
+    descriptionW   = wcsdup( desc->lpszDescriptionW );
+
+  keyPath = malloc( ( ARRAY_SIZE( applicationsKey ) + wcslen( name ) + 1 ) * sizeof( WCHAR ) );
+
+  if( !name || !file || !path || !keyPath )
+    hr = DPERR_OUTOFMEMORY;
+  else if( !name[0] || wcschr( name, '\\' ) )
+    hr = DPERR_INVALIDPARAMS;
+  else
+  {
+    wcscpy( keyPath, applicationsKey );
+    wcscat( keyPath, L"\\" );
+    wcscat( keyPath, name );
+
+    ret = RegCreateKeyExW( HKEY_LOCAL_MACHINE, keyPath, 0, NULL, 0, KEY_WRITE, NULL, &hkey, NULL );
+    if( ret == ERROR_SUCCESS )
+    {
+      StringFromGUID2( &desc->guidApplication, guidString, ARRAY_SIZE( guidString ) );
+#ifdef SG_MUTANT_L_REGGUID
+      StringFromGUID2( &GUID_NULL, guidString, ARRAY_SIZE( guidString ) );
+#endif
+
+      ret = DPL_SetRegString( hkey, L"Guid", guidString );
+      if( ret == ERROR_SUCCESS )
+        ret = DPL_SetRegString( hkey, L"File", file );
+      if( ret == ERROR_SUCCESS )
+        ret = DPL_SetRegString( hkey, L"Path", path );
+      if( ret == ERROR_SUCCESS )
+        ret = DPL_SetRegString( hkey, L"CommandLine", commandLine ? commandLine : L"" );
+      if( ret == ERROR_SUCCESS )
+        ret = DPL_SetRegString( hkey, L"CurrentDirectory", currentDirectory ? currentDirectory : L"" );
+      if( ret == ERROR_SUCCESS && desc->lpszDescriptionA )
+        ret = RegSetValueExA( hkey, "DescriptionA", 0, REG_SZ, (const BYTE *)desc->lpszDescriptionA,
+                              strlen( desc->lpszDescriptionA ) + 1 );
+      if( ret == ERROR_SUCCESS && descriptionW )
+        ret = DPL_SetRegString( hkey, L"DescriptionW", descriptionW );
+
+      RegCloseKey( hkey );
+    }
+
+    if( ret == ERROR_ACCESS_DENIED )
+      hr = DPERR_ACCESSDENIED;
+    else if( ret != ERROR_SUCCESS )
+      hr = DPERR_GENERIC;
+  }
+
+  free( name );
+  free( file );
+  free( path );
+  free( commandLine );
+  free( currentDirectory );
+  free( descriptionW );
+  free( keyPath );
+
+  return hr;
+}
+
+static HRESULT DPL_UnregisterApplication( DWORD flags, const GUID *guid )
+{
+  static const WCHAR applicationsKey[] = L"SOFTWARE\\Microsoft\\DirectPlay\\Applications";
+  HRESULT hr = DPERR_UNKNOWNAPPLICATION;
+  HKEY hkApps;
+  DWORD index;
+
+  if( flags )
+    return DPERR_INVALIDFLAGS;
+
+  if( !guid )
+    return DPERR_INVALIDPARAMS;
+
+  if( RegOpenKeyExW( HKEY_LOCAL_MACHINE, applicationsKey, 0, KEY_READ | KEY_WRITE, &hkApps ) !=
+      ERROR_SUCCESS )
+    return DPERR_UNKNOWNAPPLICATION;
+
+  for( index = 0; ; )
+  {
+    WCHAR name[ 256 ], guidString[ 64 ];
+    DWORD len = ARRAY_SIZE( name ), size = sizeof( guidString ) - sizeof( WCHAR ), type;
+    HKEY hkApp;
+    GUID found;
+    LONG ret = RegEnumKeyExW( hkApps, index, name, &len, NULL, NULL, NULL, NULL );
+    BOOL match = FALSE;
+
+    if( ret == ERROR_NO_MORE_ITEMS )
+      break;
+    if( ret != ERROR_SUCCESS )
+    {
+      index++;
+      continue;
+    }
+
+    if( RegOpenKeyExW( hkApps, name, 0, KEY_READ, &hkApp ) == ERROR_SUCCESS )
+    {
+      memset( guidString, 0, sizeof( guidString ) );
+      if( RegQueryValueExW( hkApp, L"Guid", NULL, &type, (BYTE *)guidString, &size ) ==
+              ERROR_SUCCESS && type == REG_SZ && SUCCEEDED( CLSIDFromString( guidString, &found ) ) )
+        match = IsEqualGUID( &found, guid );
+      RegCloseKey( hkApp );
+    }
+
+#ifdef SG_MUTANT_L_UNREG
+    if( match )
+    {
+      hr = DP_OK;
+      index++;
+      continue;
+    }
+#endif
+    if( match && RegDeleteKeyW( hkApps, name ) == ERROR_SUCCESS )
+    {
+      /* The next key now has this index */
+      hr = DP_OK;
+      continue;
+    }
+
+    index++;
+  }
+
+  RegCloseKey( hkApps );
+
+  return hr;
+}
