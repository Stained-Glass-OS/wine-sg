 }
 
 /* execute rundll32 on the wine.inf file if necessary */
+/* Stained Glass OS: the administrative consoles' .msc files. Windows ships
+ * services.msc, eventvwr.msc, ... in system32, and people and scripts open
+ * them by name (the Run box, cmd, ShellExecute); .msc opens with mmc.exe,
+ * which hands off to the console App Paths names (sg-shell's). Ours name the
+ * console in a StainedGlass element; a file that is not ours is left alone. */
+static void create_msc_files(void)
+{
+    static const WCHAR *const consoles[][2] =
+    {
+        { L"services", L"Services" },
+        { L"eventvwr", L"Event Viewer" },
+        { L"devmgmt", L"Device Manager" },
+        { L"diskmgmt", L"Disk Management" },
+        { L"compmgmt", L"Computer Management" },
+    };
+    WCHAR dir[MAX_PATH], path[MAX_PATH];
+    char buf[512], old[512];
+    unsigned int i, d;
+
+    for (d = 0; d < 2; d++)
+    {
+        if (!(d ? GetSystemWow64DirectoryW( dir, MAX_PATH ) : GetSystemDirectoryW( dir, MAX_PATH ))) continue;
+        for (i = 0; i < ARRAY_SIZE(consoles); i++)
+        {
+            HANDLE file;
+            DWORD len, got = 0;
+
+            swprintf( path, MAX_PATH, L"%s\\%s.msc", dir, consoles[i][0] );
+            len = snprintf( buf, sizeof(buf),
+                            "<?xml version=\"1.0\"?>\r\n"
+                            "<MMC_ConsoleFile ConsoleVersion=\"3.0\">\r\n"
+                            "  <StainedGlass Console=\"%ls\" Title=\"%ls\"/>\r\n"
+                            "</MMC_ConsoleFile>\r\n", consoles[i][0], consoles[i][1] );
+            file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+            if (file != INVALID_HANDLE_VALUE)
+            {
+                ReadFile( file, old, sizeof(old) - 1, &got, NULL );
+                CloseHandle( file );
+                old[got] = 0;
+                if (got == len && !memcmp( old, buf, len )) continue;
+                if (!strstr( old, "<StainedGlass " )) continue;
+            }
+            file = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+            if (file == INVALID_HANDLE_VALUE) continue;
+            WriteFile( file, buf, len, &got, NULL );
+            CloseHandle( file );
+        }
+    }
+}
