From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rpcrt4: RpcBindingInqAuthClient's Privs is the client's name.

The server's RpcBindingInqAuthClient(Ex)W gave Privs NULL ("privs not implemented"). It is the
calling account as DOMAIN\user -- the authentication context's client name, or for ncalrpc the
account of the token the call impersonates (the name RpcServerInqCallAttributes already gives,
7728) -- kept with the binding so the pointer stays valid while the binding does, as documented;
the A functions give it in the ANSI code page. Servers that log or check who called them read it.
---
diff --git a/dlls/rpcrt4/rpc_binding.c b/dlls/rpcrt4/rpc_binding.c
index 9826179..098b005 100644
--- a/dlls/rpcrt4/rpc_binding.c
+++ b/dlls/rpcrt4/rpc_binding.c
@@ -253,6 +253,8 @@ RPC_STATUS RPCRT4_ReleaseBinding(RpcBinding* Binding)
   free(Binding->CookieAuth);
   if (Binding->AuthInfo) RpcAuthInfo_Release(Binding->AuthInfo);
   if (Binding->QOS) RpcQualityOfService_Release(Binding->QOS);
+  free(Binding->ClientPrivsW);
+  free(Binding->ClientPrivsA);
   free(Binding);
   return RPC_S_OK;
 }
@@ -1662,6 +1664,14 @@ RpcBindingInqAuthClientExA( RPC_BINDING_HANDLE ClientBinding, RPC_AUTHZ_HANDLE *
 
     status = RpcBindingInqAuthClientExW(ClientBinding, Privs, ServerPrincName ? &principal : NULL,
                                         AuthnLevel, AuthnSvc, AuthzSvc, Flags);
+    /* Stained Glass OS: the client's name, in the A function's character set */
+    if (status == RPC_S_OK && Privs && *Privs)
+    {
+        RpcBinding *bind = ClientBinding ? ClientBinding : I_RpcGetCurrentCallHandle();
+
+        if (!bind->ClientPrivsA) bind->ClientPrivsA = RPCRT4_strdupWtoA(*Privs);
+        *Privs = bind->ClientPrivsA;
+    }
     if (status == RPC_S_OK && ServerPrincName)
     {
         *ServerPrincName = (RPC_CSTR)RPCRT4_strdupWtoA(principal);
@@ -1675,12 +1685,15 @@ RpcBindingInqAuthClientExA( RPC_BINDING_HANDLE ClientBinding, RPC_AUTHZ_HANDLE *
 /***********************************************************************
  *             RpcBindingInqAuthClientExW (RPCRT4.@)
  */
+static WCHAR *conn_client_principal(RpcConnection *conn);
+
 RPCRTAPI RPC_STATUS RPC_ENTRY
 RpcBindingInqAuthClientExW( RPC_BINDING_HANDLE ClientBinding, RPC_AUTHZ_HANDLE *Privs,
                             RPC_WSTR *ServerPrincName, ULONG *AuthnLevel, ULONG *AuthnSvc,
                             ULONG *AuthzSvc, ULONG Flags )
 {
     RpcBinding *bind;
+    RPC_STATUS status;
 
     TRACE("%p %p %p %p %p %p 0x%lx\n", ClientBinding, Privs, ServerPrincName, AuthnLevel,
           AuthnSvc, AuthzSvc, Flags);
@@ -1691,9 +1704,20 @@ RpcBindingInqAuthClientExW( RPC_BINDING_HANDLE ClientBinding, RPC_AUTHZ_HANDLE *
     bind = ClientBinding;
     if (!bind->FromConn) return RPC_S_INVALID_BINDING;
 
-    return rpcrt4_conn_inquire_auth_client(bind->FromConn, Privs,
-                                           ServerPrincName, AuthnLevel,
-                                           AuthnSvc, AuthzSvc, Flags);
+    status = rpcrt4_conn_inquire_auth_client(bind->FromConn, Privs,
+                                             ServerPrincName, AuthnLevel,
+                                             AuthnSvc, AuthzSvc, Flags);
+    /* Stained Glass OS: Privs is the client's name (DOMAIN\user), as the
+     * documentation has it for the Windows SSPs and ncalrpc; it stays valid
+     * while the binding does */
+#ifndef SG_MUTANT_RPC_NO_PRIVS
+    if (status == RPC_S_OK && Privs)
+    {
+        if (!bind->ClientPrivsW) bind->ClientPrivsW = conn_client_principal(bind->FromConn);
+        *Privs = bind->ClientPrivsW;
+    }
+#endif
+    return status;
 }
 
 /* the caller's account as DOMAIN\name: the authentication context's client
diff --git a/dlls/rpcrt4/rpc_binding.h b/dlls/rpcrt4/rpc_binding.h
index 4ffa596..bdedd82 100644
--- a/dlls/rpcrt4/rpc_binding.h
+++ b/dlls/rpcrt4/rpc_binding.h
@@ -150,6 +150,11 @@ typedef struct _RpcBinding
 
   /* the communications time-out hint (RpcMgmtSetComTimeout), 0 to 10 */
   ULONG ComTimeout;
+
+  /* a server binding: the client's name RpcBindingInqAuthClient hands out as
+   * its Privs, kept while the binding lives */
+  WCHAR *ClientPrivsW;
+  char *ClientPrivsA;
 } RpcBinding;
 
 LPWSTR RPCRT4_strndupW(LPCWSTR src, INT len);
diff --git a/dlls/rpcrt4/rpc_message.c b/dlls/rpcrt4/rpc_message.c
index db9db95..3ece546 100644
--- a/dlls/rpcrt4/rpc_message.c
+++ b/dlls/rpcrt4/rpc_message.c
@@ -1263,11 +1263,8 @@ RPC_STATUS RPCRT4_default_inquire_auth_client(
 {
     if (!conn->AuthInfo) return RPC_S_BINDING_HAS_NO_AUTH;
 
-    if (privs)
-    {
-        FIXME("privs not implemented\n");
-        *privs = NULL;
-    }
+    /* the client's name, filled in by RpcBindingInqAuthClientExW */
+    if (privs) *privs = NULL;
     if (server_princ_name)
     {
         *server_princ_name = wcsdup(conn->AuthInfo->server_principal_name);
diff --git a/dlls/rpcrt4/rpc_transport.c b/dlls/rpcrt4/rpc_transport.c
index fc6f0c0..b14d313 100644
--- a/dlls/rpcrt4/rpc_transport.c
+++ b/dlls/rpcrt4/rpc_transport.c
@@ -867,11 +867,8 @@ static RPC_STATUS rpcrt4_ncalrpc_inquire_auth_client(
     TRACE("(%p, %p, %p, %p, %p, %p, 0x%lx)\n", conn, privs,
           server_princ_name, authn_level, authn_svc, authz_svc, flags);
 
-    if (privs)
-    {
-        FIXME("privs not implemented\n");
-        *privs = NULL;
-    }
+    /* the client's name, filled in by RpcBindingInqAuthClientExW */
+    if (privs) *privs = NULL;
     if (server_princ_name)
     {
         FIXME("server_princ_name not implemented\n");
