From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: Task View's windows fly back as it closes

Opening Task View, the windows fly from their places into the grid
(0520); closing, it vanished in one frame (David 2026-10-01, field report
item 6). Now they fly back to their places first -- the same flight
reversed, eased in -- then it goes, as Windows' does: Escape, the Task
View button, a click on a window (it flies to its place while coming
forward) or on the background. Meanwhile Task View takes no input, and
the activation it loses does not cut the flight short. Only with "Show
animations in Windows" on.

Gate: test/taskview-anim-gate.sh (at 1.2 s of a 4 s close Task View is
still there and unlike the grid, at 6 s gone; mutant
SG_MUTANT_TASKVIEW_NO_CLOSE_ANIM fails it).
---
--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -696,6 +696,7 @@
     BOOL        dragging;
     DWORD       anim_start;     /* the windows fly into place when it opens */
     BOOL        animating;
+    BOOL        closing;        /* and back to theirs as it closes */
 };
 static struct tv_state tv;
 
@@ -732,8 +733,15 @@
     if (!tv.animating || IsIconic( tv.items[i].hwnd ) || !GetWindowRect( tv.items[i].hwnd, &from )) return to;
     MapWindowPoints( HWND_DESKTOP, hwnd, (POINT *)&from, 2 );
     t = (double)(GetTickCount() - tv.anim_start) / tv_anim_ms();
-    if (t >= 1.0) return to;
-    e = 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t);   /* ease out */
+    if (tv.closing)
+    {
+        /* closing: from the grid back to the window, as Windows' Task View
+         * does (David 2026-10-01: it only animated opening) */
+        if (t >= 1.0) return from;
+        t = 1.0 - t;
+    }
+    else if (t >= 1.0) return to;
+    e = 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t);   /* ease out (closing: in) */
     SetRect( &from, from.left + (int)((to.left - from.left) * e), from.top + (int)((to.top - from.top) * e),
              from.right + (int)((to.right - from.right) * e), from.bottom + (int)((to.bottom - from.bottom) * e) );
     return from;
@@ -1014,6 +1022,23 @@
 {
     HWND hwnd = taskview;
     if (!hwnd) return;
+#ifndef SG_MUTANT_TASKVIEW_NO_CLOSE_ANIM
+    /* the windows fly back to their places first, then it goes: the frame
+     * timer (2) ends it; meanwhile it takes no input, and closing it again
+     * (the window it brought forward taking the foreground) waits for that */
+    if (tv.closing) return;
+    if (tv_animations() && IsWindowVisible( hwnd ))
+    {
+        tv.closing = tv.animating = TRUE;
+        tv.anim_start = GetTickCount();
+        tv.hot_item = tv.hot_tile = tv.hot_close = tv.sel = -1;
+        tv.hot_new = FALSE;
+        if (GetCapture() == hwnd) ReleaseCapture();
+        SetTimer( hwnd, 2, 15, NULL );
+        InvalidateRect( hwnd, NULL, FALSE );
+        return;
+    }
+#endif
     taskview = 0;
     DestroyWindow( hwnd );
 }
@@ -1083,9 +1108,14 @@
 {
     POINT pt = { (short)LOWORD(lp), (short)HIWORD(lp) };
 
+    /* closing (the windows on their way back): no more clicks or keys */
+    if (tv.closing && ((msg >= WM_MOUSEFIRST && msg <= WM_MOUSELAST) || (msg >= WM_KEYFIRST && msg <= WM_KEYLAST)))
+        return 0;
+
     switch (msg)
     {
     case WM_CREATE:
+        tv.closing = FALSE;
         tv.shown = vd_current;
         tv.hot_item = tv.hot_tile = tv.hot_close = tv.drag = tv.sel = -1;
         tv.hot_new = tv.dragging = FALSE;
@@ -1204,6 +1234,13 @@
     case WM_TIMER:
         if (wp == 2)
         {
+            if (tv.closing && GetTickCount() - tv.anim_start >= (DWORD)tv_anim_ms())
+            {
+                KillTimer( hwnd, 2 );
+                if (hwnd == taskview) taskview = 0;
+                DestroyWindow( hwnd );
+                return 0;
+            }
             if (GetTickCount() - tv.anim_start >= (DWORD)tv_anim_ms())
             {
                 tv.animating = FALSE;
