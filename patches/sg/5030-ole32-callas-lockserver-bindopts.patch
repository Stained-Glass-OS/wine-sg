From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ole32: Implement call_as wrappers for LockServer, bind options, IsRunning, BindToObject.

The call_as proxy and stub wrappers of IClassFactory::LockServer,
IBindCtx::SetBindOptions/GetBindOptions (a BIND_OPTS2 on the wire, the
caller's cbStruct saying how much is used), IRunnableObject::IsRunning and
IMoniker::BindToObject forward to the remote method. They returned
E_NOTIMPL (FALSE for IsRunning), so e.g. LockServer on an out-of-process
server's class object failed.

Gate: test/ole32-callas-gate.sh (64/32).
---
 dlls/ole32/usrmarshal.c | 75 ++++++++++++++++++++++++++++++++++++-------------
 1 file changed, 56 insertions(+), 19 deletions(-)

diff --git a/dlls/ole32/usrmarshal.c b/dlls/ole32/usrmarshal.c
index 5744270..f3f0b32 100644
--- a/dlls/ole32/usrmarshal.c
+++ b/dlls/ole32/usrmarshal.c
@@ -1281,16 +1281,20 @@ HRESULT CALLBACK IClassFactory_LockServer_Proxy(
     IClassFactory* This,
     BOOL fLock)
 {
-    FIXME(":stub\n");
+    TRACE("%p, %d.\n", This, fLock);
+#ifndef SG_MUTANT_CALLAS_LOCKSERVER
+    return IClassFactory_RemoteLockServer_Proxy(This, fLock);
+#else
     return E_NOTIMPL;
+#endif
 }
 
 HRESULT __RPC_STUB IClassFactory_LockServer_Stub(
     IClassFactory* This,
     BOOL fLock)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    TRACE("%p, %d.\n", This, fLock);
+    return IClassFactory_LockServer(This, fLock);
 }
 
 /* call_as/local stubs for objidl.idl */
@@ -1321,36 +1325,63 @@ HRESULT __RPC_STUB IEnumUnknown_Next_Stub(
     return hr;
 }
 
+/* The wire carries a BIND_OPTS2: the caller's structure is copied in up to
+ * that size, and its cbStruct tells the object how much of it is there. */
 HRESULT CALLBACK IBindCtx_SetBindOptions_Proxy(
     IBindCtx* This,
     BIND_OPTS *pbindopts)
 {
-    FIXME(":stub\n");
+    BIND_OPTS2 opts;
+
+    TRACE("%p, %p.\n", This, pbindopts);
+
+    if (!pbindopts) return E_POINTER;
+    memset(&opts, 0, sizeof(opts));
+    memcpy(&opts, pbindopts, min(pbindopts->cbStruct, sizeof(opts)));
+    opts.cbStruct = min(pbindopts->cbStruct, sizeof(opts));
+#ifndef SG_MUTANT_CALLAS_BINDOPTS
+    return IBindCtx_RemoteSetBindOptions_Proxy(This, &opts);
+#else
     return E_NOTIMPL;
+#endif
 }
 
 HRESULT __RPC_STUB IBindCtx_SetBindOptions_Stub(
     IBindCtx* This,
     BIND_OPTS2 *pbindopts)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    TRACE("%p, %p.\n", This, pbindopts);
+    return IBindCtx_SetBindOptions(This, (BIND_OPTS *)pbindopts);
 }
 
 HRESULT CALLBACK IBindCtx_GetBindOptions_Proxy(
     IBindCtx* This,
     BIND_OPTS *pbindopts)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    BIND_OPTS2 opts;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", This, pbindopts);
+
+    if (!pbindopts) return E_POINTER;
+    memset(&opts, 0, sizeof(opts));
+    opts.cbStruct = min(pbindopts->cbStruct, sizeof(opts));
+#ifndef SG_MUTANT_CALLAS_BINDOPTS
+    hr = IBindCtx_RemoteGetBindOptions_Proxy(This, &opts);
+#else
+    hr = E_NOTIMPL;
+#endif
+    if (SUCCEEDED(hr))
+        memcpy(pbindopts, &opts, min(opts.cbStruct, min(pbindopts->cbStruct, sizeof(opts))));
+    return hr;
 }
 
 HRESULT __RPC_STUB IBindCtx_GetBindOptions_Stub(
     IBindCtx* This,
     BIND_OPTS2 *pbindopts)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    TRACE("%p, %p.\n", This, pbindopts);
+    return IBindCtx_GetBindOptions(This, (BIND_OPTS *)pbindopts);
 }
 
 HRESULT CALLBACK IEnumMoniker_Next_Proxy(
@@ -1382,17 +1413,19 @@ HRESULT __RPC_STUB IEnumMoniker_Next_Stub(
 BOOL CALLBACK IRunnableObject_IsRunning_Proxy(
     IRunnableObject* This)
 {
-    BOOL rv;
-    FIXME(":stub\n");
-    memset(&rv, 0, sizeof rv);
-    return rv;
+    TRACE("%p.\n", This);
+#ifndef SG_MUTANT_CALLAS_ISRUNNING
+    return IRunnableObject_RemoteIsRunning_Proxy(This) == S_OK;
+#else
+    return FALSE;
+#endif
 }
 
 HRESULT __RPC_STUB IRunnableObject_IsRunning_Stub(
     IRunnableObject* This)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    TRACE("%p.\n", This);
+    return IRunnableObject_IsRunning(This) ? S_OK : S_FALSE;
 }
 
 HRESULT CALLBACK IMoniker_BindToObject_Proxy(
@@ -1402,8 +1435,12 @@ HRESULT CALLBACK IMoniker_BindToObject_Proxy(
     REFIID riidResult,
     void **ppvResult)
 {
-    FIXME(":stub\n");
+    TRACE("%p, %p, %p, %s, %p.\n", This, pbc, pmkToLeft, debugstr_guid(riidResult), ppvResult);
+#ifndef SG_MUTANT_CALLAS_BINDTOOBJECT
+    return IMoniker_RemoteBindToObject_Proxy(This, pbc, pmkToLeft, riidResult, (IUnknown **)ppvResult);
+#else
     return E_NOTIMPL;
+#endif
 }
 
 HRESULT __RPC_STUB IMoniker_BindToObject_Stub(
@@ -1413,8 +1450,8 @@ HRESULT __RPC_STUB IMoniker_BindToObject_Stub(
     REFIID riidResult,
     IUnknown **ppvResult)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    TRACE("%p, %p, %p, %s, %p.\n", This, pbc, pmkToLeft, debugstr_guid(riidResult), ppvResult);
+    return IMoniker_BindToObject(This, pbc, pmkToLeft, riidResult, (void **)ppvResult);
 }
 
 HRESULT CALLBACK IMoniker_BindToStorage_Proxy(
