From: Stained Glass OS <dev@stained-glass.example>
Subject: combase, ole32: CoRegisterActivationFilter

Word registers an activation filter as it starts; CoRegisterActivationFilter
was a stub, and Word aborted on it (0xc06d007f: a delay-loaded import not
found).

A process may register one filter (IActivationFilter); a second is refused
with E_ACCESSDENIED. Every class activation (CoCreateInstance[Ex],
CoGetClassObject) asks it first: it may name another class in its place,
refuse the class (its error is the activation's), or name none (GUID_NULL,
as Office's does), which leaves the class asked for. An activation the
filter makes itself, while it answers, is not filtered again. ole32
forwards to combase.

Gate: test/actfilter-gate.sh.
---
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -1694,19 +1694,87 @@
             count, results);
 }
 
-static HRESULT com_get_class_object(REFCLSID rclsid, DWORD clscontext,
+/* Stained Glass OS: a process's activation filter (CoRegisterActivationFilter).
+ * Office registers one at start (Word aborted on the missing function); every
+ * class activation asks it first, and it may refuse the class or name
+ * another in its place. */
+typedef struct activation_filter activation_filter;
+struct activation_filter_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)(activation_filter *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(activation_filter *);
+    ULONG (WINAPI *Release)(activation_filter *);
+    HRESULT (WINAPI *HandleActivation)(activation_filter *, DWORD type, REFCLSID clsid, CLSID *replacement);
+};
+struct activation_filter { const struct activation_filter_vtbl *lpVtbl; };
+static activation_filter *process_activation_filter;
+static DWORD filter_guard_tls = TLS_OUT_OF_INDEXES;
+
+/***********************************************************************
+ *           CoRegisterActivationFilter    (combase.@)
+ */
+HRESULT WINAPI CoRegisterActivationFilter(activation_filter *filter)
+{
+    TRACE("%p\n", filter);
+
+    if (!filter) return E_INVALIDARG;
+    if (filter_guard_tls == TLS_OUT_OF_INDEXES)
+    {
+        DWORD index = TlsAlloc();
+        if (InterlockedCompareExchange((LONG *)&filter_guard_tls, index, TLS_OUT_OF_INDEXES) != TLS_OUT_OF_INDEXES)
+            TlsFree(index);
+    }
+    filter->lpVtbl->AddRef(filter);
+    /* one filter a process */
+    if (InterlockedCompareExchangePointer((void **)&process_activation_filter, filter, NULL))
+    {
+        filter->lpVtbl->Release(filter);
+        return E_ACCESSDENIED;
+    }
+    return S_OK;
+}
+
+/* the class to activate: the filter's answer, if the process has one (it is
+ * not asked again about activations it makes itself) */
+static HRESULT filter_activation(REFCLSID clsid, CLSID *out)
+{
+    activation_filter *filter = process_activation_filter;
+    CLSID replacement;
+    HRESULT hr;
+
+    *out = *clsid;
+    if (!filter || filter_guard_tls == TLS_OUT_OF_INDEXES || TlsGetValue(filter_guard_tls)) return S_OK;
+    replacement = *clsid;
+    TlsSetValue(filter_guard_tls, (void *)1);
+    hr = filter->lpVtbl->HandleActivation(filter, 0 /* ACTIVATIONTYPE_UNCATEGORIZED */, clsid, &replacement);
+    TlsSetValue(filter_guard_tls, NULL);
+    TRACE("%s: %#lx, %s\n", debugstr_guid(clsid), hr, debugstr_guid(&replacement));
+    if (FAILED(hr)) return hr;
+    /* a filter that names no class in reply leaves the one asked for */
+    if (!IsEqualGUID(&replacement, &GUID_NULL)) *out = replacement;
+    return S_OK;
+}
+
+static HRESULT com_get_class_object(REFCLSID asked_clsid, DWORD clscontext,
         COSERVERINFO *server_info, REFIID riid, void **obj)
 {
     struct class_reg_data clsreg = { 0 };
     HRESULT hr = E_UNEXPECTED;
     IUnknown *registered_obj;
     struct apartment *apt;
+    const CLSID *rclsid;
+    CLSID filtered;
 
     if (!obj)
         return E_INVALIDARG;
 
     *obj = NULL;
 
+    if (FAILED(hr = filter_activation(asked_clsid, &filtered)))
+        return hr;
+    rclsid = &filtered;
+    hr = E_UNEXPECTED;
+
     if (!(apt = apartment_get_current_or_mta()))
     {
         ERR("apartment not initialised\n");
