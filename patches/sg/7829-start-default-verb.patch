From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] start: a document opens with its type's default verb

---
 programs/start/start.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/programs/start/start.c b/programs/start/start.c
index 0835b41..736e393 100644
--- a/programs/start/start.c
+++ b/programs/start/start.c
@@ -412,7 +412,13 @@ static void parse_command_line( int argc, WCHAR *argv[] )
     BOOL progid_open = FALSE;
 
     opts.sei.cbSize = sizeof(opts.sei);
+#ifdef SG_MUTANT_START_OPEN_VERB
     opts.sei.lpVerb = L"open";
+#else
+    /* Stained Glass OS (wine-sg 7829): the type's default verb, as start does on Windows: a
+     * document whose program's default verb is not "open" (Edit, a suite's own) opened nothing */
+    opts.sei.lpVerb = NULL;
+#endif
     opts.sei.nShow = SW_SHOWNORMAL;
     /* Dunno what these mean, but it looks like winMe's start uses them */
     opts.sei.fMask = SEE_MASK_FLAG_DDEWAIT | SEE_MASK_FLAG_NO_UI;
-- 
2.47.3

