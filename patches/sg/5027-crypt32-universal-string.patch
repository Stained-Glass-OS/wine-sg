From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: Support CERT_RDN_UNIVERSAL_STRING name values.

CERT_RDN_UNIVERSAL_STRING name values, whose value is an array of INT4
elements (32-bit code points): X509_NAME_VALUE encodes them as an ASN.1
UniversalString and decodes one back, so names with a UniversalString
attribute decode, and CertRDNValueToStr/CertNameToStr give their text
(UTF-16, code points past U+FFFF as surrogate pairs). All three failed
with a FIXME.

Gate: test/crypt32-universalstring-gate.sh (64/32).
---
 dlls/crypt32/decode.c | 23 ++++++++++++++++++++-
 dlls/crypt32/encode.c | 48 +++++++++++++++++++++++++++++++++++++++++++-
 dlls/crypt32/str.c    | 55 +++++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 124 insertions(+), 2 deletions(-)

diff --git a/dlls/crypt32/decode.c b/dlls/crypt32/decode.c
index 4d65804..d56903d 100644
--- a/dlls/crypt32/decode.c
+++ b/dlls/crypt32/decode.c
@@ -1551,9 +1551,20 @@ static BOOL CRYPT_AsnDecodeNameValueInternal(const BYTE *pbEncoded,
                 bytesNeeded += dataLen;
             break;
         case ASN_UNIVERSALSTRING:
-            FIXME("ASN_UNIVERSALSTRING: unimplemented\n");
+#ifndef SG_MUTANT_UNIVERSAL_DECODE
+            /* an array of 32-bit code points ("INT4 elements") */
+            if (dataLen % 4)
+            {
+                SetLastError(CRYPT_E_ASN1_CORRUPT);
+                return FALSE;
+            }
+            valueType = CERT_RDN_UNIVERSAL_STRING;
+            bytesNeeded += dataLen;
+            break;
+#else
             SetLastError(CRYPT_E_ASN1_BADTAG);
             return FALSE;
+#endif
         case ASN_BMPSTRING:
             valueType = CERT_RDN_BMP_STRING;
             bytesNeeded += dataLen;
@@ -1616,6 +1627,16 @@ static BOOL CRYPT_AsnDecodeNameValueInternal(const BYTE *pbEncoded,
                          pbEncoded[1 + lenBytes + 2 * i + 1];
                     break;
                 }
+                case ASN_UNIVERSALSTRING:
+                {
+                    DWORD *chars = (DWORD *)value->Value.pbData;
+                    const BYTE *src = pbEncoded + 1 + lenBytes;
+
+                    value->Value.cbData = dataLen;
+                    for (i = 0; i < dataLen / 4; i++)
+                        chars[i] = (src[4 * i] << 24) | (src[4 * i + 1] << 16) | (src[4 * i + 2] << 8) | src[4 * i + 3];
+                    break;
+                }
                 case ASN_UTF8STRING:
                 {
                     LPWSTR str = (LPWSTR)value->Value.pbData;
diff --git a/dlls/crypt32/encode.c b/dlls/crypt32/encode.c
index 663e823..cee9622 100644
--- a/dlls/crypt32/encode.c
+++ b/dlls/crypt32/encode.c
@@ -998,6 +998,48 @@ static BOOL CRYPT_AsnEncodeBMPString(const CERT_NAME_VALUE *value,
     return ret;
 }
 
+/* CERT_RDN_UNIVERSAL_STRING: an array of 32-bit code points, big-endian on
+ * the wire; cbData 0 means up to a 0 terminator, as for BMP strings */
+static BOOL CRYPT_AsnEncodeUniversalInt4String(const CERT_NAME_VALUE *value,
+ DWORD dwFlags, const CRYPT_ENCODE_PARA *pEncodePara, BYTE *pbEncoded,
+ DWORD *pcbEncoded)
+{
+    BOOL ret = TRUE;
+    const DWORD *chars = (const DWORD *)value->Value.pbData;
+    DWORD bytesNeeded, lenBytes, count = 0;
+
+    if (value->Value.cbData)
+        count = value->Value.cbData / sizeof(DWORD);
+    else if (chars)
+        while (chars[count]) count++;
+    CRYPT_EncodeLen(count * 4, NULL, &lenBytes);
+    bytesNeeded = 1 + lenBytes + count * 4;
+    if (!pbEncoded)
+        *pcbEncoded = bytesNeeded;
+    else
+    {
+        if ((ret = CRYPT_EncodeEnsureSpace(dwFlags, pEncodePara,
+         pbEncoded, pcbEncoded, bytesNeeded)))
+        {
+            DWORD i;
+
+            if (dwFlags & CRYPT_ENCODE_ALLOC_FLAG)
+                pbEncoded = *(BYTE **)pbEncoded;
+            *pbEncoded++ = ASN_UNIVERSALSTRING;
+            CRYPT_EncodeLen(count * 4, pbEncoded, &lenBytes);
+            pbEncoded += lenBytes;
+            for (i = 0; i < count; i++)
+            {
+                *pbEncoded++ = chars[i] >> 24;
+                *pbEncoded++ = chars[i] >> 16;
+                *pbEncoded++ = chars[i] >> 8;
+                *pbEncoded++ = chars[i];
+            }
+        }
+    }
+    return ret;
+}
+
 static BOOL CRYPT_AsnEncodeUTF8String(const CERT_NAME_VALUE *value,
  DWORD dwFlags, const CRYPT_ENCODE_PARA *pEncodePara, BYTE *pbEncoded,
  DWORD *pcbEncoded)
@@ -1093,9 +1135,13 @@ static BOOL WINAPI CRYPT_AsnEncodeNameValue(DWORD dwCertEncodingType,
              dwFlags, pEncodePara, pbEncoded, pcbEncoded);
             break;
         case CERT_RDN_UNIVERSAL_STRING:
-            FIXME("CERT_RDN_UNIVERSAL_STRING: unimplemented\n");
+#ifndef SG_MUTANT_UNIVERSAL_ENCODE
+            ret = CRYPT_AsnEncodeUniversalInt4String(value, dwFlags, pEncodePara,
+             pbEncoded, pcbEncoded);
+#else
             SetLastError(CRYPT_E_ASN1_CHOICE);
             ret = FALSE;
+#endif
             break;
         case CERT_RDN_BMP_STRING:
             ret = CRYPT_AsnEncodeBMPString(value, dwFlags, pEncodePara,
diff --git a/dlls/crypt32/str.c b/dlls/crypt32/str.c
index baa9032..c02568e 100644
--- a/dlls/crypt32/str.c
+++ b/dlls/crypt32/str.c
@@ -62,6 +62,35 @@ DWORD WINAPI CertRDNValueToStrA(DWORD type, PCERT_RDN_VALUE_BLOB value_blob,
     return ret;
 }
 
+/* a CERT_RDN_UNIVERSAL_STRING value is an array of 32-bit code points: the
+ * same text as UTF-16, for the BMP string cases */
+static BOOL universal_to_bmp(const CERT_RDN_VALUE_BLOB *value, CERT_RDN_VALUE_BLOB *bmp)
+{
+    const DWORD *chars = (const DWORD *)value->pbData;
+    DWORD count = value->cbData / sizeof(DWORD), i, len = 0;
+    WCHAR *str;
+
+    if (!(str = CryptMemAlloc(count * 2 * sizeof(WCHAR) + sizeof(WCHAR)))) return FALSE;
+    for (i = 0; i < count; i++)
+    {
+        DWORD c = chars[i];
+
+#ifndef SG_MUTANT_UNIVERSAL_NO_SURROGATES
+        if (c >= 0x10000 && c <= 0x10ffff)
+        {
+            c -= 0x10000;
+            str[len++] = 0xd800 | (c >> 10);
+            str[len++] = 0xdc00 | (c & 0x3ff);
+        }
+        else
+#endif
+            str[len++] = c > 0xffff ? 0xfffd : c;
+    }
+    bmp->pbData = (BYTE *)str;
+    bmp->cbData = len * sizeof(WCHAR);
+    return TRUE;
+}
+
 static DWORD rdn_value_to_strW(DWORD dwValueType, PCERT_RDN_VALUE_BLOB pValue,
                                LPWSTR psz, DWORD csz, BOOL partial_copy)
 {
@@ -69,6 +98,19 @@ static DWORD rdn_value_to_strW(DWORD dwValueType, PCERT_RDN_VALUE_BLOB pValue,
 
     TRACE("(%ld, %p, %p, %ld)\n", dwValueType, pValue, psz, csz);
 
+#ifndef SG_MUTANT_UNIVERSAL_TO_STR
+    if (dwValueType == CERT_RDN_UNIVERSAL_STRING)
+    {
+        CERT_RDN_VALUE_BLOB bmp;
+
+        if (universal_to_bmp(pValue, &bmp))
+        {
+            ret = rdn_value_to_strW(CERT_RDN_BMP_STRING, &bmp, psz, csz, partial_copy);
+            CryptMemFree(bmp.pbData);
+            return ret;
+        }
+    }
+#endif
     switch (dwValueType)
     {
     case CERT_RDN_ANY_TYPE:
@@ -152,6 +194,19 @@ static DWORD quote_rdn_value_to_str_w(DWORD dwValueType, PCERT_RDN_VALUE_BLOB pV
 
     TRACE("(%ld, %p, %p, %ld)\n", dwValueType, pValue, psz, csz);
 
+#ifndef SG_MUTANT_UNIVERSAL_TO_STR
+    if (dwValueType == CERT_RDN_UNIVERSAL_STRING)
+    {
+        CERT_RDN_VALUE_BLOB bmp;
+
+        if (universal_to_bmp(pValue, &bmp))
+        {
+            ret = quote_rdn_value_to_str_w(CERT_RDN_BMP_STRING, &bmp, dwStrType, psz, csz);
+            CryptMemFree(bmp.pbData);
+            return ret;
+        }
+    }
+#endif
