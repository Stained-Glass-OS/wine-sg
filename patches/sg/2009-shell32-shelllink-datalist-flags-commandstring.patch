From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: shell link data list, flags and command string (2009)

shell32: shell link data list, flags and command string (2009)

IShellLinkDataList AddDataBlock/CopyDataBlock/RemoveDataBlock keep the
link's extra data blocks (console properties, special folder, known folder
...), which Load now keeps and Save writes back; the darwin and property
storage blocks map onto the link's own members. GetFlags reports the
name/relative path/working directory members and the flags SetFlags sets,
which are saved in and read from the header. SaveCompleted no longer
FIXMEs; IContextMenu::GetCommandString answers verb and validate.
---
--- a/dlls/shell32/shelllink.c
+++ b/dlls/shell32/shelllink.c
@@ -164,6 +164,13 @@ typedef struct
 	 * in its property storage data block */
 	struct link_property *props;
 	DWORD         prop_count;
+
+	/* the extra data blocks the link carries (console properties, special
+	 * folder, known folder...), each whole with its size and signature, and
+	 * the link flags that no member shows (IShellLinkDataList) */
+	struct link_block *blocks;
+	DWORD         block_count;
+	DWORD         user_flags;
 } IShellLinkImpl;
 
 static inline IShellLinkImpl *impl_from_IShellLinkA(IShellLinkA *iface)
@@ -225,6 +232,70 @@ static inline IShellLinkImpl *impl_from_IPropertyStore(IPropertyStore *iface)
 
 DEFINE_GUID(FMTID_link_named_props, 0xd5cdd505, 0x2e9c, 0x101b, 0x93, 0x97, 0x08, 0x00, 0x2b, 0x2c, 0xf9, 0xae);
 
+/* the flags a caller sets with IShellLinkDataList::SetFlags; the others
+ * follow from what the link holds */
+#define LINK_USER_FLAGS (SLDF_FORCE_NO_LINKINFO | SLDF_HAS_EXP_SZ | SLDF_RUN_IN_SEPARATE | \
+                         SLDF_RUNAS_USER | SLDF_HAS_EXP_ICON_SZ | SLDF_NO_PIDL_ALIAS | \
+                         SLDF_FORCE_UNCNAME | SLDF_RUN_WITH_SHIMLAYER | SLDF_FORCE_NO_LINKTRACK | \
+                         SLDF_ENABLE_TARGET_METADATA | SLDF_DISABLE_LINK_PATH_TRACKING | \
+                         SLDF_DISABLE_KNOWNFOLDER_RELATIVE_TRACKING)
+
+#define LINK_MAX_BLOCK 0x100000
+
+struct link_block
+{
+    DWORD sig;
+    DWORD size;   /* the whole block, size and signature included */
+    BYTE *data;
+};
+
+static void link_blocks_free( IShellLinkImpl *This )
+{
+    DWORD i;
+    for (i = 0; i < This->block_count; i++) free( This->blocks[i].data );
+    free( This->blocks );
+    This->blocks = NULL;
+    This->block_count = 0;
+}
+
+static struct link_block *link_block_find( IShellLinkImpl *This, DWORD sig )
+{
+    DWORD i;
+    for (i = 0; i < This->block_count; i++)
+        if (This->blocks[i].sig == sig) return &This->blocks[i];
+    return NULL;
+}
+
+/* keeps a copy of a whole block, replacing the one of the same signature */
+static BOOL link_block_set( IShellLinkImpl *This, const BYTE *data, DWORD size )
+{
+    struct link_block *block, *blocks;
+    BYTE *copy;
+    DWORD sig;
+
+    memcpy( &sig, data + 4, 4 );
+    if (!(copy = malloc( size ))) return FALSE;
+    memcpy( copy, data, size );
+    if ((block = link_block_find( This, sig )))
+    {
+        free( block->data );
+        block->data = copy;
+        block->size = size;
+        return TRUE;
+    }
+    if (!(blocks = realloc( This->blocks, (This->block_count + 1) * sizeof(*blocks) )))
+    {
+        free( copy );
+        return FALSE;
+    }
+    This->blocks = blocks;
+    blocks[This->block_count].sig = sig;
+    blocks[This->block_count].size = size;
+    blocks[This->block_count].data = copy;
+    This->block_count++;
+    return TRUE;
+}
+
 static void link_props_free( IShellLinkImpl *This )
 {
     DWORD i;
@@ -628,7 +699,8 @@ static HRESULT WINAPI IPersistFile_fnSave(IPersistFile* iface, LPCOLESTR pszFile
 static HRESULT WINAPI IPersistFile_fnSaveCompleted(IPersistFile* iface, LPCOLESTR filename)
 {
     IShellLinkImpl *This = impl_from_IPersistFile(iface);
-    FIXME("(%p)->(%s): stub\n", This, debugstr_w(filename));
+    /* a link has no NoScribble mode to leave: nothing to do */
+    TRACE("(%p)->(%s)\n", This, debugstr_w(filename));
     return S_OK;
 }
 
@@ -1002,6 +1074,8 @@ static HRESULT WINAPI IPersistStream_fnLoad(
     free(This->sComponent);
     This->sComponent = NULL;
     link_props_free(This);
+    link_blocks_free(This);
+    This->user_flags = hdr.dwFlags & LINK_USER_FLAGS;
 
     This->wHotKey = hdr.wHotKey;
     This->iIcoNdx = hdr.nIcon;
@@ -1111,6 +1185,20 @@ static HRESULT WINAPI IPersistStream_fnLoad(
         memcpy(&signature, block, sizeof signature);
         TRACE("extra data block %08lx, %lu bytes\n", signature, size);
         if (signature == EXP_PROPERTYSTORAGE_SIG) link_props_parse(This, block + 4, size - 8);
+#ifndef SG_MUTANT_BLOCKS_DROPPED
+        else
+        {
+            /* any other block stays with the link, so that a save writes it back */
+            BYTE *whole = malloc(size);
+            if (whole)
+            {
+                memcpy(whole, &size, 4);
+                memcpy(whole + 4, block, size - 4);
+                link_block_set(This, whole, size);
+                free(whole);
+            }
+        }
+#endif
         free(block);
     }
     r = S_OK;
@@ -1279,6 +1367,9 @@ static HRESULT WINAPI IPersistStream_fnSave(
     header.wHotKey = This->wHotKey;
     header.nIcon = This->iIcoNdx;
     header.dwFlags = SLDF_UNICODE;   /* strings are in unicode */
+#ifndef SG_MUTANT_FLAGS_NOSAVE
+    header.dwFlags |= This->user_flags;
+#endif
     if( This->pPidl )
         header.dwFlags |= SLDF_HAS_ID_LIST;
     if( This->sPath )
@@ -1346,13 +1437,15 @@ static HRESULT WINAPI IPersistStream_fnSave(
         r = Stream_WriteAdvertiseInfo( stm, This->sComponent, EXP_DARWIN_ID_SIG );
 
     {
-        DWORD block_size;
+        DWORD block_size, i;
         BYTE *block = link_props_block( This, &block_size );
         if (block)
         {
             r = IStream_Write( stm, block, block_size, &count );
             free( block );
         }
+        for (i = 0; i < This->block_count; i++)
+            r = IStream_Write( stm, This->blocks[i].data, This->blocks[i].size, &count );
     }
 
     /* the last field is a single zero dword */
@@ -1921,6 +2014,7 @@ static ULONG WINAPI IShellLinkW_fnRelease(IShellLinkW * iface)
     free(This->sComponent);
     free(This->filepath);
     link_props_free(This);
+    link_blocks_free(This);
 
     if (This->site)
         IUnknown_Release( This->site );
@@ -2479,8 +2573,47 @@ ShellLink_DataList_Release( IShellLinkDataList* iface )
 static HRESULT WINAPI
 ShellLink_AddDataBlock( IShellLinkDataList* iface, void* pDataBlock )
 {
-    FIXME("(%p)->(%p): stub\n", iface, pDataBlock);
-    return E_NOTIMPL;
+    IShellLinkImpl *This = impl_from_IShellLinkDataList(iface);
+    const BYTE *data = pDataBlock;
+    DWORD size, sig;
+
+    TRACE("(%p)->(%p)\n", This, pDataBlock);
+
+    if (!data) return E_INVALIDARG;
+    memcpy( &size, data, 4 );
+    memcpy( &sig, data + 4, 4 );
+    if (size < 8 || size > LINK_MAX_BLOCK) return E_INVALIDARG;
+
+#ifdef SG_MUTANT_ADD_IGNORED
+    return S_OK;
+#endif
+    switch (sig)
+    {
+    case EXP_DARWIN_ID_SIG:
+        {
+            const EXP_DARWIN_LINK *darwin = pDataBlock;
+            WCHAR id[MAX_PATH];
+            WCHAR *copy;
+
+            if (size < sizeof(*darwin)) return E_INVALIDARG;
+            lstrcpynW( id, darwin->szwDarwinID, ARRAY_SIZE(id) );
+            if (!(copy = wcsdup( id ))) return E_OUTOFMEMORY;
+            free( This->sComponent );
+            This->sComponent = copy;
+            This->bDirty = TRUE;
+            return S_OK;
+        }
+    case EXP_PROPERTYSTORAGE_SIG:
+        /* the property storage replaces the link's properties */
+        link_props_free( This );
+        link_props_parse( This, data + 8, size - 8 );
+        This->bDirty = TRUE;
+        return S_OK;
+    default:
+        if (!link_block_set( This, data, size )) return E_OUTOFMEMORY;
+        This->bDirty = TRUE;
+        return S_OK;
+    }
 }
 
 static HRESULT WINAPI
@@ -2489,26 +2622,37 @@ ShellLink_CopyDataBlock( IShellLinkDataList* iface, DWORD dwSig, void** ppDataBl
     IShellLinkImpl *This = impl_from_IShellLinkDataList(iface);
     LPVOID block = NULL;
     HRESULT r = E_FAIL;
+    struct link_block *stored;
 
     TRACE("%p %08lx %p\n", iface, dwSig, ppDataBlock );
 
-    switch (dwSig)
+    if (dwSig == EXP_DARWIN_ID_SIG)
     {
-    case EXP_DARWIN_ID_SIG:
-        if (!This->sComponent)
-            break;
-        block = shelllink_build_darwinid( This->sComponent, dwSig );
-        r = S_OK;
-        break;
-    case EXP_SZ_LINK_SIG:
-    case NT_CONSOLE_PROPS_SIG:
-    case NT_FE_CONSOLE_PROPS_SIG:
-    case EXP_SPECIAL_FOLDER_SIG:
-    case EXP_SZ_ICON_SIG:
-        FIXME("valid but unhandled datablock %08lx\n", dwSig);
-        break;
-    default:
-        ERR("unknown datablock %08lx\n", dwSig);
+        if (This->sComponent)
+        {
+            block = shelllink_build_darwinid( This->sComponent, dwSig );
+            r = S_OK;
+        }
+    }
+    else if (dwSig == EXP_PROPERTYSTORAGE_SIG)
+    {
+        DWORD size;
+        BYTE *props = This->prop_count ? link_props_block( This, &size ) : NULL;
+        if (props)
+        {
+            if ((block = LocalAlloc( LMEM_FIXED, size ))) memcpy( block, props, size );
+            free( props );
+            r = block ? S_OK : E_OUTOFMEMORY;
+        }
+    }
+    else if ((stored = link_block_find( This, dwSig )))
+    {
+        if ((block = LocalAlloc( LMEM_FIXED, stored->size )))
+        {
+            memcpy( block, stored->data, stored->size );
+            r = S_OK;
+        }
+        else r = E_OUTOFMEMORY;
     }
     *ppDataBlock = block;
     return r;
@@ -2517,8 +2661,35 @@ ShellLink_CopyDataBlock( IShellLinkDataList* iface, DWORD dwSig, void** ppDataBl
 static HRESULT WINAPI
 ShellLink_RemoveDataBlock( IShellLinkDataList* iface, DWORD dwSig )
 {
-    FIXME("(%p)->(%lu): stub\n", iface, dwSig);
-    return E_NOTIMPL;
+    IShellLinkImpl *This = impl_from_IShellLinkDataList(iface);
+    struct link_block *stored;
+
+    TRACE("(%p)->(%08lx)\n", This, dwSig);
+
+#ifdef SG_MUTANT_REMOVE_NOOP
+    return S_OK;
+#endif
+    if (dwSig == EXP_DARWIN_ID_SIG)
+    {
+        if (!This->sComponent) return E_FAIL;
+        free( This->sComponent );
+        This->sComponent = NULL;
+    }
+    else if (dwSig == EXP_PROPERTYSTORAGE_SIG)
+    {
+        if (!This->prop_count) return E_FAIL;
+        link_props_free( This );
+    }
+    else if ((stored = link_block_find( This, dwSig )))
+    {
+        free( stored->data );
+        memmove( stored, stored + 1, (This->blocks + This->block_count - stored - 1) * sizeof(*stored) );
+        This->block_count--;
+    }
+    else return E_FAIL;
+
+    This->bDirty = TRUE;
+    return S_OK;
 }
 
 static HRESULT WINAPI
@@ -2527,9 +2698,8 @@ ShellLink_GetFlags( IShellLinkDataList* iface, DWORD* pdwFlags )
     IShellLinkImpl *This = impl_from_IShellLinkDataList(iface);
     DWORD flags = 0;
 
-    FIXME("(%p)->(%p): partially implemented\n", This, pdwFlags);
+    TRACE("(%p)->(%p)\n", This, pdwFlags);
 
-    /* FIXME: add more */
     if (This->sArgs)
         flags |= SLDF_HAS_ARGS;
     if (This->sComponent)
@@ -2540,6 +2710,15 @@ ShellLink_GetFlags( IShellLinkDataList* iface, DWORD* pdwFlags )
         flags |= SLDF_HAS_LOGO3ID;
     if (This->pPidl)
         flags |= SLDF_HAS_ID_LIST;
+    if (This->sDescription)
+        flags |= SLDF_HAS_NAME;
+    if (This->sPathRel)
+        flags |= SLDF_HAS_RELPATH;
+    if (This->sWorkDir)
+        flags |= SLDF_HAS_WORKINGDIR;
+#ifndef SG_MUTANT_FLAGS_DERIVED_ONLY
+    flags |= This->user_flags;
+#endif
 
     *pdwFlags = flags;
 
@@ -2549,7 +2728,13 @@ ShellLink_GetFlags( IShellLinkDataList* iface, DWORD* pdwFlags )
 static HRESULT WINAPI
 ShellLink_SetFlags( IShellLinkDataList* iface, DWORD dwFlags )
 {
-    FIXME("(%p)->(%lu): stub\n", iface, dwFlags);
+    IShellLinkImpl *This = impl_from_IShellLinkDataList(iface);
+
+    TRACE("(%p)->(%08lx)\n", This, dwFlags);
+
+    /* the bits that say a member is present follow the members */
+    This->user_flags = dwFlags & LINK_USER_FLAGS;
+    This->bDirty = TRUE;
     return S_OK;
 }
 
@@ -2826,10 +3011,31 @@ ShellLink_GetCommandString( IContextMenu* iface, UINT_PTR idCmd, UINT uType,
 {
     IShellLinkImpl *This = impl_from_IContextMenu(iface);
 
-    FIXME("(%p)->(%Iu %u %p %p %u): stub\n", This,
-          idCmd, uType, pwReserved, pszName, cchMax );
+    TRACE("(%p)->(%Iu %u %p %p %u)\n", This, idCmd, uType, pwReserved, pszName, cchMax );
 
-    return E_NOTIMPL;
+    /* the one command is Open, the one InvokeCommand takes */
+    switch (uType)
+    {
+    case GCS_VALIDATEA:
+    case GCS_VALIDATEW:
+        return idCmd == 0 ? S_OK : S_FALSE;
+    case GCS_VERBA:
+    case GCS_VERBW:
+        if (idCmd != 0) return E_INVALIDARG;
+        if (!pszName || !cchMax) return E_INVALIDARG;
+#ifdef SG_MUTANT_VERB_EMPTY
+        if (uType == GCS_VERBW) *(WCHAR *)pszName = 0; else *pszName = 0;
+        return S_OK;
+#endif
+        if (uType == GCS_VERBW) lstrcpynW( (WCHAR *)pszName, L"open", cchMax );
+        else lstrcpynA( pszName, "open", cchMax );
+        return S_OK;
+    case GCS_HELPTEXTA:
+    case GCS_HELPTEXTW:
+        return E_NOTIMPL;
+    default:
+        return E_INVALIDARG;
+    }
 }
 
 static const IContextMenuVtbl cmvt =
