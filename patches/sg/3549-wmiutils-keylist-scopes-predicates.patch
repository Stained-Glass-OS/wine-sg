+static HRESULT keylist_get_entry( struct keylist *keylist, ULONG idx, WCHAR **name, WCHAR **value )
+{
+    struct path *parent = impl_from_IWbemPath( keylist->parent );
+    struct key **keys;
+    unsigned int *num;
+    HRESULT hr = S_OK;
+
+    *name = *value = NULL;
+    EnterCriticalSection( &parent->cs );
+    if (!get_keyset( parent, keylist->scope, &keys, &num ) || idx >= *num) hr = WBEM_E_NOT_FOUND;
+    else if (!(*name = wcsdup( (*keys)[idx].name )) || !(*value = wcsdup( (*keys)[idx].value )))
+    {
+        free( *name );
+        *name = *value = NULL;
+        hr = WBEM_E_OUT_OF_MEMORY;
+    }
+    LeaveCriticalSection( &parent->cs );
+    return hr;
+}
+
+static void copy_name( ULONG *size, WCHAR *buf, const WCHAR *name )
+{
+    ULONG len = lstrlenW( name );
+    if (buf && *size > len) lstrcpyW( buf, name );
+    *size = len + 1;
 }
 
