+static HRESULT parse_scope_text( const WCHAR *text, struct scope *scope )
+{
+    const WCHAR *p = text, *q;
+    unsigned int len, i, num = 0;
+    struct key *keys = NULL;
+
+    memset( scope, 0, sizeof(*scope) );
+    q = p;
+    while (*q && *q != '.' && *q != '=') q++;
+    len = q - p;
+    if (!len) return WBEM_E_INVALID_PARAMETER;
+    if (!(scope->class = malloc( (len + 1) * sizeof(WCHAR) ))) return WBEM_E_OUT_OF_MEMORY;
+    memcpy( scope->class, p, len * sizeof(WCHAR) );
+    scope->class[len] = 0;
+    scope->len_class = len;
+
+    if (*q == '.' || *q == '=')
+    {
+        HRESULT hr;
+        if (*q == '.') q++;
+        p = q;
+        num = 1;
+        while (*q) { if (*q == ',') num++; q++; }
+        if (!(keys = calloc( num, sizeof(*keys) ))) { free( scope->class ); return WBEM_E_OUT_OF_MEMORY; }
+        q = p;
+        for (i = 0; i < num && *q; i++)
+        {
+            if ((hr = parse_key( &keys[i], q, &len )) != S_OK)
+            {
+                free_keys( keys, num );
+                free( scope->class );
+                return hr == E_OUTOFMEMORY ? WBEM_E_OUT_OF_MEMORY : hr;
+            }
+            q += len;
+        }
+    }
+    scope->keys = keys;
+    scope->num_keys = num;
+    return S_OK;
+}
+
+static HRESULT set_scope( struct path *path, ULONG idx, struct scope *new )
+{
+    struct scope *tmp;
+
+    if (idx > path->num_scopes)
+    {
+        free( new->class );
+        free_keys( new->keys, new->num_keys );
+        return WBEM_E_INVALID_PARAMETER;
+    }
+    if (idx < path->num_scopes)
+    {
+        free( path->scopes[idx].class );
+        free_keys( path->scopes[idx].keys, path->scopes[idx].num_keys );
+        path->scopes[idx] = *new;
+        return S_OK;
+    }
+    if (!(tmp = realloc( path->scopes, (path->num_scopes + 1) * sizeof(*tmp) )))
+    {
+        free( new->class );
+        free_keys( new->keys, new->num_keys );
+        return WBEM_E_OUT_OF_MEMORY;
+    }
+    path->scopes = tmp;
+    path->scopes[path->num_scopes++] = *new;
+    return S_OK;
+}
