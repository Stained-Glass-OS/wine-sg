+static HRESULT keylist_set( struct keylist *keylist, LPCWSTR name, WCHAR *value )
+{
+    struct path *parent = impl_from_IWbemPath( keylist->parent );
+    struct key **keys;
+    unsigned int *num;
+    HRESULT hr;
+
+    if (!value) return WBEM_E_INVALID_PARAMETER;
+    EnterCriticalSection( &parent->cs );
+    if (get_keyset( parent, keylist->scope, &keys, &num )) hr = put_key( keys, num, name ? name : L"", value );
+    else { free( value ); hr = WBEM_E_INVALID_PARAMETER; }
+    LeaveCriticalSection( &parent->cs );
+    return hr;
 }
 
