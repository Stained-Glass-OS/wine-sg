+static BOOL machine_matches( struct path *path, const WCHAR *machine )
+{
+    WCHAR name[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD size = ARRAY_SIZE(name);
+
+    if (!machine) machine = L".";
+    if (!path->len_server || !wcscmp( path->server, L"." )) return TRUE;
+    if (!wcsicmp( path->server, machine )) return TRUE;
+    if (GetComputerNameW( name, &size ) && !wcsicmp( path->server, name ) &&
+        (!wcscmp( machine, L"." ) || !wcsicmp( machine, name ))) return TRUE;
+    return FALSE;
+}
+
+/* the namespace text of the path, with backslashes */
+static BOOL namespace_equal( struct path *path, const WCHAR *ns, BOOL allow_child )
+{
+    unsigned int i;
+
+    if (!ns) ns = L"";
+    while (*ns == '\\' || *ns == '/') ns++;
+    for (i = 0; i < path->num_namespaces; i++)
+    {
+        int len = path->len_namespaces[i];
+        if (!*ns) return allow_child;
+        if (wcsnicmp( path->namespaces[i], ns, len )) return FALSE;
+        ns += len;
+        if (*ns == '\\' || *ns == '/') ns++;
+        else if (*ns) return FALSE;
+        else if (i + 1 < path->num_namespaces) return allow_child;
+    }
+    return !*ns;
 }
 
