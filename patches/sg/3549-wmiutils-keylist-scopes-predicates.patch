+static BOOL get_keyset( struct path *path, int scope, struct key ***keys, unsigned int **num )
+{
+    if (scope < 0)
+    {
+        *keys = &path->keys;
+        *num = &path->num_keys;
+        return TRUE;
+    }
+    if ((unsigned int)scope >= path->num_scopes) return FALSE;
+    *keys = &path->scopes[scope].keys;
+    *num = &path->scopes[scope].num_keys;
+    return TRUE;
+}
+
+/* quotes a string for use as a key value: "text" with \ and " escaped */
+static WCHAR *quote_value( const WCHAR *str )
+{
+    WCHAR *ret, *p;
+    const WCHAR *q;
+    unsigned int len = 2;
+
+    for (q = str; *q; q++) len += (*q == '"' || *q == '\\') ? 2 : 1;
+    if (!(p = ret = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+    *p++ = '"';
+    for (q = str; *q; q++)
+    {
+        if (*q == '"' || *q == '\\') *p++ = '\\';
+        *p++ = *q;
+    }
+    *p++ = '"';
+    *p = 0;
+    return ret;
+}
+
+/* the string behind a quoted value, or NULL if the value is not quoted */
+static WCHAR *unquote_value( const WCHAR *text )
+{
+    WCHAR *ret, *p;
+    int len = lstrlenW( text );
+    const WCHAR *q, *end = text + len - 1;
+
+    if (len < 2 || text[0] != '"' || *end != '"') return NULL;
+    if (!(p = ret = malloc( len * sizeof(WCHAR) ))) return NULL;
+    for (q = text + 1; q < end; q++)
+    {
+        if (*q == '\\' && q + 1 < end) q++;
+        *p++ = *q;
+    }
+    *p = 0;
+    return ret;
+}
+
+static int find_key( struct key *keys, unsigned int num, const WCHAR *name )
+{
+    unsigned int i;
+    for (i = 0; i < num; i++)
+        if (!wcsicmp( keys[i].name, name )) return i;
+    return -1;
+}
+
+/* sets (or adds) a key, the value text is taken over */
+static HRESULT put_key( struct key **keys, unsigned int *num, const WCHAR *name, WCHAR *value )
+{
+    int idx = find_key( *keys, *num, name );
+    struct key *new;
+    WCHAR *copy;
+
+    if (idx >= 0)
+    {
+        free( (*keys)[idx].value );
+        (*keys)[idx].value = value;
+        (*keys)[idx].len_value = lstrlenW( value );
+        return S_OK;
+    }
+    if (!(copy = wcsdup( name ))) { free( value ); return WBEM_E_OUT_OF_MEMORY; }
+    if (!(new = realloc( *keys, (*num + 1) * sizeof(struct key) )))
+    {
+        free( copy );
+        free( value );
+        return WBEM_E_OUT_OF_MEMORY;
+    }
+    *keys = new;
+    new[*num].name = copy;
+    new[*num].len_name = lstrlenW( copy );
+    new[*num].value = value;
+    new[*num].len_value = lstrlenW( value );
+    (*num)++;
+    return S_OK;
+}
+
+static WCHAR *value_text_from_native( ULONG type, const void *val )
+{
+    WCHAR buf[64];
+
+    if (!val) return NULL;
+    switch (type)
+    {
+    case CIM_STRING:
+    case CIM_DATETIME:
+    case CIM_REFERENCE:
+        return quote_value( val );
+    case CIM_SINT8:   swprintf( buf, ARRAY_SIZE(buf), L"%d", *(const signed char *)val ); break;
+    case CIM_UINT8:   swprintf( buf, ARRAY_SIZE(buf), L"%u", *(const BYTE *)val ); break;
+    case CIM_SINT16:  swprintf( buf, ARRAY_SIZE(buf), L"%d", *(const SHORT *)val ); break;
+    case CIM_UINT16:
+    case CIM_CHAR16:  swprintf( buf, ARRAY_SIZE(buf), L"%u", *(const WORD *)val ); break;
+    case CIM_SINT32:  swprintf( buf, ARRAY_SIZE(buf), L"%ld", *(const LONG *)val ); break;
+    case CIM_UINT32:  swprintf( buf, ARRAY_SIZE(buf), L"%lu", *(const ULONG *)val ); break;
+    case CIM_SINT64:  swprintf( buf, ARRAY_SIZE(buf), L"%I64d", *(const LONGLONG *)val ); break;
+    case CIM_UINT64:  swprintf( buf, ARRAY_SIZE(buf), L"%I64u", *(const ULONGLONG *)val ); break;
+    case CIM_REAL32:  swprintf( buf, ARRAY_SIZE(buf), L"%g", (double)*(const float *)val ); break;
+    case CIM_REAL64:  swprintf( buf, ARRAY_SIZE(buf), L"%g", *(const double *)val ); break;
+    case CIM_BOOLEAN: lstrcpyW( buf, *(const VARIANT_BOOL *)val ? L"TRUE" : L"FALSE" ); break;
+    default: return NULL;
+    }
+    return wcsdup( buf );
+}
+
+static WCHAR *value_text_from_variant( const VARIANT *v )
+{
+    VARIANT tmp;
+    WCHAR *ret;
+
+    switch (V_VT(v))
+    {
+    case VT_BSTR:
+        return quote_value( V_BSTR(v) ? V_BSTR(v) : L"" );
+    case VT_BOOL:
+        return wcsdup( V_BOOL(v) ? L"TRUE" : L"FALSE" );
+    case VT_I1: case VT_UI1: case VT_I2: case VT_UI2: case VT_I4: case VT_UI4: case VT_INT: case VT_UINT:
+    case VT_I8: case VT_UI8: case VT_R4: case VT_R8:
+        VariantInit( &tmp );
+        if (FAILED(VariantChangeType( &tmp, (VARIANT *)v, 0, VT_BSTR ))) return NULL;
+        ret = wcsdup( V_BSTR(&tmp) );
+        VariantClear( &tmp );
+        return ret;
+    default:
+        return NULL;
+    }
+}
+
+/* the CIM type that a stored value text appears to have */
+static ULONG apparent_type( const WCHAR *text )
+{
+    const WCHAR *p = text;
+    BOOL real = FALSE;
+
+    if (text[0] == '"') return CIM_STRING;
+    if (!wcsicmp( text, L"TRUE" ) || !wcsicmp( text, L"FALSE" )) return CIM_BOOLEAN;
+    if (*p == '-' || *p == '+') p++;
+    if (!*p) return CIM_STRING;
+    for (; *p; p++)
+    {
+        if (*p == '.' || *p == 'e' || *p == 'E') real = TRUE;
+        else if (*p < '0' || *p > '9') return CIM_STRING;
+    }
+    if (real) return CIM_REAL64;
+    return (wcstoll( text, NULL, 10 ) > 0x7fffffffLL || wcstoll( text, NULL, 10 ) < -0x80000000LL) ? CIM_SINT64 : CIM_SINT32;
+}
+
+static WCHAR *build_keyset_text( struct key *keys, unsigned int num, int *len )
+{
+    WCHAR *ret, *p;
+    unsigned int i;
+
+    *len = 0;
+    for (i = 0; i < num; i++)
+    {
+        if (i > 0) *len += 1;
+        *len += keys[i].len_name + keys[i].len_value + 1;
+    }
+    if (!(p = ret = malloc( (*len + 1) * sizeof(WCHAR) ))) return NULL;
+    for (i = 0; i < num; i++)
+    {
+        if (i > 0) *p++ = ',';
+        memcpy( p, keys[i].name, keys[i].len_name * sizeof(WCHAR) );
+        p += keys[i].len_name;
+        *p++ = '=';
+        memcpy( p, keys[i].value, keys[i].len_value * sizeof(WCHAR) );
+        p += keys[i].len_value;
+    }
+    *p = 0;
+    return ret;
+}
