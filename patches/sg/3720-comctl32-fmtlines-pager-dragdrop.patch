From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comctl32, user32: EM_FMTLINES soft breaks, pager drag and drop scrolling (3720)

comctl32, user32: EM_FMTLINES soft breaks, pager drag and drop scrolling

EM_FMTLINES now inserts and removes the soft line breaks in the buffer
(both Edit implementations); PGS_DRAGNDROP pagers are drop targets that
scroll while an item is over a scroll button. Details in notes/3720.txt.
---
diff --git a/dlls/comctl32/edit.c b/dlls/comctl32/edit.c
index 442c47b..62e51e8 100644
--- a/dlls/comctl32/edit.c
+++ b/dlls/comctl32/edit.c
@@ -2335,13 +2335,100 @@ static LRESULT EDIT_EM_CharFromPos(EDITSTATE *es, INT x, INT y)
  * If not, notify with EN_ERRSPACE.
  *
  */
+/* where a buffer position goes when soft breaks are added or removed */
+static INT fmtlines_map_pos(EDITSTATE *es, INT pos, BOOL add_eol)
+{
+	LINEDEF *line;
+	INT shift = 0;
+
+	for (line = es->first_line_def; line; line = line->next)
+	{
+		INT end = line->index + line->length;
+
+		if (add_eol)
+		{
+			if (line->ending == END_WRAP && end <= pos) shift += 3;
+		}
+		else if (line->ending == END_SOFT)
+		{
+			if (end <= pos) shift -= 3;
+			else if (pos > line->index + line->net_length) return line->index + line->net_length + shift;
+		}
+	}
+	return pos + shift;
+}
+
 static BOOL EDIT_EM_FmtLines(EDITSTATE *es, BOOL add_eol)
 {
+	LINEDEF *line;
+	WCHAR *buf, *dst;
+	UINT len, newlen, count = 0;
+	INT new_start, new_end;
+
 	es->flags &= ~EF_USE_SOFTBRK;
-	if (add_eol) {
+	if (add_eol)
 		es->flags |= EF_USE_SOFTBRK;
-		FIXME("soft break enabled, not implemented\n");
+
+	/* Soft breaks only exist in multi-line controls. */
+	if (!(es->style & ES_MULTILINE) || !es->text || !es->first_line_def)
+		return add_eol;
+
+	/* The soft breaks are part of the buffer: TRUE puts \r\r\n where a line
+	 * was wrapped, FALSE removes every soft break. */
+	for (line = es->first_line_def; line; line = line->next)
+		if (line->ending == (add_eol ? END_WRAP : END_SOFT)) count++;
+	if (!count)
+		return add_eol;
+
+#ifdef SG_MUTANT_FMT_NOADD
+	if (add_eol) return add_eol;
+#endif
+#ifdef SG_MUTANT_FMT_NOREMOVE
+	if (!add_eol) return add_eol;
+#endif
+	len = get_text_length(es);
+	newlen = add_eol ? len + 3 * count : len - 3 * count;
+	if (add_eol && !EDIT_MakeFit(es, newlen))
+		return add_eol;   /* EN_ERRSPACE has been sent */
+	if (!(buf = Alloc((newlen + 1) * sizeof(WCHAR))))
+		return add_eol;
+
+	new_start = fmtlines_map_pos(es, es->selection_start, add_eol);
+	new_end = fmtlines_map_pos(es, es->selection_end, add_eol);
+#ifdef SG_MUTANT_FMT_NOSEL
+	new_start = es->selection_start; new_end = es->selection_end;
+#endif
+	dst = buf;
+	for (line = es->first_line_def; line; line = line->next)
+	{
+		if (add_eol)
+		{
+			memcpy(dst, es->text + line->index, line->length * sizeof(WCHAR));
+			dst += line->length;
+			if (line->ending == END_WRAP)
+			{
+				*dst++ = '\r'; *dst++ = '\r'; *dst++ = '\n';
+			}
+		}
+		else
+		{
+			UINT n = line->ending == END_SOFT ? line->net_length : line->length;
+			memcpy(dst, es->text + line->index, n * sizeof(WCHAR));
+			dst += n;
+		}
 	}
+	*dst = 0;
+	memcpy(es->text, buf, (newlen + 1) * sizeof(WCHAR));
+	Free(buf);
+
+	text_buffer_changed(es);
+	es->selection_start = min(max(new_start, 0), (INT)newlen);
+	es->selection_end = min(max(new_end, 0), (INT)newlen);
+	EDIT_EM_EmptyUndoBuffer(es);
+	EDIT_BuildLineDefs_ML(es, 0, newlen, 0, NULL);
+	EDIT_UpdateText(es, NULL, TRUE);
+	EDIT_EM_ScrollCaret(es);
+	EDIT_UpdateScrollInfo(es);
 	return add_eol;
 }
 
diff --git a/dlls/comctl32/pager.c b/dlls/comctl32/pager.c
index d60bb90..b08a5b3 100644
--- a/dlls/comctl32/pager.c
+++ b/dlls/comctl32/pager.c
@@ -30,8 +30,6 @@
  *    Implement repetitive button press.
  *    Adjust arrow size relative to size of button.
  *    Allow border size changes.
- *    Styles:
- *      PGS_DRAGNDROP
  *    Notifications:
  *      PGN_HOTITEMCHANGE
  *    Messages:
@@ -53,6 +51,7 @@
  */
 
 #include <stdarg.h>
+#define COBJMACROS
 #include <stdlib.h>
 #include <string.h>
 #include "windef.h"
@@ -62,11 +61,14 @@
 #include "winnls.h"
 #include "commctrl.h"
 #include "uxtheme.h"
+#include "ole2.h"
 #include "comctl32.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(pager);
 
+struct pager_drop;
+
 typedef struct
 {
     HWND   hwndSelf;   /* handle of the control wnd */
@@ -87,6 +89,7 @@ typedef struct
     INT    direction;  /* direction of the scroll, (e.g. PGF_SCROLLUP) */
     WCHAR  *pwszBuffer;/* text buffer for converted notifications */
     INT    nBufferSize;/* size of the above buffer */
+    struct pager_drop *drop; /* drop target for PGS_DRAGNDROP */
 } PAGER_INFO;
 
 #define TIMERID1         1
@@ -570,6 +573,169 @@ PAGER_FmtLines(const PAGER_INFO *infoPtr)
     return DefWindowProcW (infoPtr->hwndSelf, EM_FMTLINES, 0, 0);
 }
 
+/* PGS_DRAGNDROP: the pager is a drop target of its own; an item dragged over
+ * one of the scroll buttons scrolls the contents, repeating until the item
+ * leaves the button. The drop target never accepts a drop (the contained
+ * window has its own). */
+static INT PAGER_HitTest (const PAGER_INFO* infoPtr, const POINT * pt);
+
+struct pager_drop
+{
+    IDropTarget IDropTarget_iface;
+    LONG ref;
+    PAGER_INFO *info;
+    INT dir;            /* PGF_SCROLL* in progress, or 0 */
+};
+
+static inline struct pager_drop *pager_drop_from_iface(IDropTarget *iface)
+{
+    return CONTAINING_RECORD(iface, struct pager_drop, IDropTarget_iface);
+}
+
+static HRESULT WINAPI pager_drop_QueryInterface(IDropTarget *iface, REFIID iid, void **out)
+{
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IDropTarget))
+    {
+        *out = iface;
+        IDropTarget_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI pager_drop_AddRef(IDropTarget *iface)
+{
+    return InterlockedIncrement(&pager_drop_from_iface(iface)->ref);
+}
+
+static ULONG WINAPI pager_drop_Release(IDropTarget *iface)
+{
+    struct pager_drop *drop = pager_drop_from_iface(iface);
+    ULONG ref = InterlockedDecrement(&drop->ref);
+
+    if (!ref) Free(drop);
+    return ref;
+}
+
+static void pager_drop_stop(struct pager_drop *drop)
+{
+    drop->dir = 0;
+    if (drop->info)
+    {
+        KillTimer(drop->info->hwndSelf, TIMERID2);
+        drop->info->direction = -1;
+    }
+}
+
+static HRESULT pager_drop_over(struct pager_drop *drop, POINTL pt, DWORD *effect)
+{
+    PAGER_INFO *infoPtr = drop->info;
+    POINT clpt;
+    INT hit, dir = 0;
+
+    if (effect) *effect = DROPEFFECT_NONE;
+    if (!infoPtr) return S_OK;
+
+    clpt.x = pt.x;
+    clpt.y = pt.y;
+    ScreenToClient(infoPtr->hwndSelf, &clpt);
+    hit = PAGER_HitTest(infoPtr, &clpt);
+    if (hit == PGB_TOPORLEFT)
+        dir = (infoPtr->dwStyle & PGS_HORZ) ? PGF_SCROLLLEFT : PGF_SCROLLUP;
+    else if (hit == PGB_BOTTOMORRIGHT)
+        dir = (infoPtr->dwStyle & PGS_HORZ) ? PGF_SCROLLRIGHT : PGF_SCROLLDOWN;
+
+    if (dir == drop->dir) return S_OK;
+    pager_drop_stop(drop);
+    if (dir)
+    {
+        TRACE("[%p] drag over a scroll button, dir %d\n", infoPtr->hwndSelf, dir);
+        drop->dir = dir;
+        PAGER_Scroll(infoPtr, dir);
+        if (infoPtr->direction > 0)
+            SetTimer(infoPtr->hwndSelf, TIMERID2, INITIAL_DELAY, 0);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI pager_drop_DragEnter(IDropTarget *iface, IDataObject *data, DWORD keys,
+        POINTL pt, DWORD *effect)
+{
+    return pager_drop_over(pager_drop_from_iface(iface), pt, effect);
+}
+
+static HRESULT WINAPI pager_drop_DragOver(IDropTarget *iface, DWORD keys, POINTL pt, DWORD *effect)
+{
+    return pager_drop_over(pager_drop_from_iface(iface), pt, effect);
+}
+
+static HRESULT WINAPI pager_drop_DragLeave(IDropTarget *iface)
+{
+    pager_drop_stop(pager_drop_from_iface(iface));
+    return S_OK;
+}
+
+static HRESULT WINAPI pager_drop_Drop(IDropTarget *iface, IDataObject *data, DWORD keys,
+        POINTL pt, DWORD *effect)
+{
+    pager_drop_stop(pager_drop_from_iface(iface));
+    *effect = DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static const IDropTargetVtbl pager_drop_vtbl =
+{
+    pager_drop_QueryInterface,
+    pager_drop_AddRef,
+    pager_drop_Release,
+    pager_drop_DragEnter,
+    pager_drop_DragOver,
+    pager_drop_DragLeave,
+    pager_drop_Drop,
+};
+
+static void PAGER_RegisterDrop(PAGER_INFO *infoPtr, BOOL want)
+{
+    static HRESULT (WINAPI *register_drop)(HWND, IDropTarget *);
+    static HRESULT (WINAPI *revoke_drop)(HWND);
+
+    if (want == (infoPtr->drop != NULL)) return;
+    if (!register_drop)
+    {
+        HMODULE ole32 = LoadLibraryW(L"ole32.dll");
+        if (!ole32) return;
+        register_drop = (void *)GetProcAddress(ole32, "RegisterDragDrop");
+        revoke_drop = (void *)GetProcAddress(ole32, "RevokeDragDrop");
+        if (!register_drop || !revoke_drop) return;
+    }
+    if (want)
+    {
+        struct pager_drop *drop = Alloc(sizeof(*drop));
+        if (!drop) return;
+        drop->IDropTarget_iface.lpVtbl = &pager_drop_vtbl;
+        drop->ref = 1;
+        drop->info = infoPtr;
+        /* OLE must be initialized by the program for this */
+#ifndef SG_MUTANT_NO_PAGER_DROP
+        if (SUCCEEDED(register_drop(infoPtr->hwndSelf, &drop->IDropTarget_iface)))
+        {
+            infoPtr->drop = drop;
+            return;
+        }
+#endif
+        WARN("[%p] RegisterDragDrop failed\n", infoPtr->hwndSelf);
+        IDropTarget_Release(&drop->IDropTarget_iface);
+    }
+    else
+    {
+        revoke_drop(infoPtr->hwndSelf);
+        infoPtr->drop->info = NULL;
+        IDropTarget_Release(&infoPtr->drop->IDropTarget_iface);
+        infoPtr->drop = NULL;
+    }
+}
+
 static LRESULT
 PAGER_Create (HWND hwnd, const CREATESTRUCTW *lpcs)
 {
@@ -599,7 +765,7 @@ PAGER_Create (HWND hwnd, const CREATESTRUCTW *lpcs)
     infoPtr->direction = -1;
 
     if (infoPtr->dwStyle & PGS_DRAGNDROP)
-        FIXME("[%p] Drag and Drop style is not implemented yet.\n", infoPtr->hwndSelf);
+        PAGER_RegisterDrop(infoPtr, TRUE);
 
     ret = SendMessageW(infoPtr->hwndNotify, WM_NOTIFYFORMAT, (WPARAM)infoPtr->hwndSelf, NF_QUERY);
     infoPtr->bUnicode = (ret == NFR_UNICODE);
@@ -611,6 +777,7 @@ PAGER_Create (HWND hwnd, const CREATESTRUCTW *lpcs)
 static LRESULT
 PAGER_Destroy (PAGER_INFO *infoPtr)
 {
+    PAGER_RegisterDrop(infoPtr, FALSE);
     SetWindowLongPtrW (infoPtr->hwndSelf, 0, 0);
     Free (infoPtr->pwszBuffer);
     Free (infoPtr);
