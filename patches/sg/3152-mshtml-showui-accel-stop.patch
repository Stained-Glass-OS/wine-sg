From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 03:29:34 -0700
Subject: [PATCH] mshtml: host message boxes, accelerators and stop

Script alert and confirm are offered to the container's IDocHostShowUI::ShowMessage
first (S_OK means the host showed it and gave the answer). The UI active document
takes part in IOleInPlaceActiveObject::TranslateAccelerator: key presses go to
IDocHostUIHandler::TranslateAccelerator with CGID_MSHTML and a command id (F5 is
IDM_REFRESH and is taken by the document), and otherwise to the container's
IOleControlSite::TranslateAccelerator with the key modifiers. OLECMDID_STOP aborts
the pending page and the current page's downloads instead of E_NOTIMPL.

diff --git a/dlls/mshtml/htmlwindow.c b/dlls/mshtml/htmlwindow.c
index 08ac442..77e0ea4 100644
--- a/dlls/mshtml/htmlwindow.c
+++ b/dlls/mshtml/htmlwindow.c
@@ -527,6 +527,21 @@ static HRESULT WINAPI HTMLWindow2_clearTimeout(IHTMLWindow2 *iface, LONG timerID
 
 #define MAX_MESSAGE_LEN 2000
 
+/* The host gets to show the message boxes of scripts through IDocHostShowUI::ShowMessage; S_OK means it did. */
+static BOOL host_show_message(HTMLDocumentObj *doc, const WCHAR *text, const WCHAR *caption, DWORD type, LRESULT *result)
+{
+    IDocHostShowUI *showui;
+    HRESULT hres;
+
+    if(!doc->client || FAILED(IOleClientSite_QueryInterface(doc->client, &IID_IDocHostShowUI, (void**)&showui)))
+        return FALSE;
+
+    *result = 0;
+    hres = IDocHostShowUI_ShowMessage(showui, doc->hwnd, (WCHAR*)text, (WCHAR*)caption, type, NULL, 0, result);
+    IDocHostShowUI_Release(showui);
+    return hres == S_OK;
+}
+
 static HRESULT WINAPI HTMLWindow2_alert(IHTMLWindow2 *iface, BSTR message)
 {
     HTMLWindow *This = impl_from_IHTMLWindow2(iface);
@@ -552,7 +567,11 @@ static HRESULT WINAPI HTMLWindow2_alert(IHTMLWindow2 *iface, BSTR message)
         msg[MAX_MESSAGE_LEN] = 0;
     }
 
-    MessageBoxW(This->outer_window->browser->doc->hwnd, msg, title, MB_ICONWARNING);
+    {
+        LRESULT result;
+        if(!host_show_message(This->outer_window->browser->doc, msg, title, MB_ICONWARNING, &result))
+            MessageBoxW(This->outer_window->browser->doc->hwnd, msg, title, MB_ICONWARNING);
+    }
     if(msg != message)
         free(msg);
     return S_OK;
@@ -563,6 +582,7 @@ static HRESULT WINAPI HTMLWindow2_confirm(IHTMLWindow2 *iface, BSTR message,
 {
     HTMLWindow *This = impl_from_IHTMLWindow2(iface);
     WCHAR wszTitle[100];
+    LRESULT result;
 
     TRACE("(%p)->(%s %p)\n", This, debugstr_w(message), confirmed);
 
@@ -577,10 +597,12 @@ static HRESULT WINAPI HTMLWindow2_confirm(IHTMLWindow2 *iface, BSTR message,
         return S_OK;
     }
 
-    if(MessageBoxW(This->outer_window->browser->doc->hwnd, message, wszTitle,
-                MB_OKCANCEL|MB_ICONQUESTION)==IDOK)
-        *confirmed = VARIANT_TRUE;
-    else *confirmed = VARIANT_FALSE;
+    if(!host_show_message(This->outer_window->browser->doc, message, wszTitle, MB_OKCANCEL|MB_ICONQUESTION, &result))
+        result = MessageBoxW(This->outer_window->browser->doc->hwnd, message, wszTitle, MB_OKCANCEL|MB_ICONQUESTION);
+#ifdef SG_MUTANT_SHOWUI_CONFIRM
+    result = IDOK;
+#endif
+    *confirmed = result == IDOK ? VARIANT_TRUE : VARIANT_FALSE;
 
     return S_OK;
 }
diff --git a/dlls/mshtml/olecmd.c b/dlls/mshtml/olecmd.c
index 20a506e..248fc4a 100644
--- a/dlls/mshtml/olecmd.c
+++ b/dlls/mshtml/olecmd.c
@@ -498,8 +498,19 @@ static HRESULT exec_refresh(HTMLDocumentNode *doc, DWORD nCmdexecopt, VARIANT *p
 
 static HRESULT exec_stop(HTMLDocumentNode *doc, DWORD nCmdexecopt, VARIANT *pvaIn, VARIANT *pvaOut)
 {
-    FIXME("(%p)->(%ld %p %p)\n", doc, nCmdexecopt, pvaIn, pvaOut);
-    return E_NOTIMPL;
+    HTMLOuterWindow *window;
+
+    TRACE("(%p)->(%ld %p %p)\n", doc, nCmdexecopt, pvaIn, pvaOut);
+
+    if(!doc->window || !(window = doc->window->base.outer_window))
+        return E_UNEXPECTED;
+
+    /* stops what is loading: the page that is about to replace the current one and the current page's own downloads */
+    if(window->pending_window)
+        abort_window_bindings(window->pending_window);
+    if(window->base.inner_window)
+        abort_window_bindings(window->base.inner_window);
+    return S_OK;
 }
 
 static HRESULT exec_stop_download(HTMLDocumentNode *doc, DWORD nCmdexecopt, VARIANT *pvaIn, VARIANT *pvaOut)
diff --git a/dlls/mshtml/oleobj.c b/dlls/mshtml/oleobj.c
index bc1e690..6ea22f0 100644
--- a/dlls/mshtml/oleobj.c
+++ b/dlls/mshtml/oleobj.c
@@ -29,6 +29,7 @@
 #include "shdeprecated.h"
 #include "mscoree.h"
 #include "mshtmdid.h"
+#include "mshtmcid.h"
 #include "idispids.h"
 
 #include "wine/debug.h"
@@ -1392,11 +1393,53 @@ static HRESULT WINAPI DocObjOleInPlaceActiveObject_ContextSensitiveHelp(IOleInPl
     return E_NOTIMPL;
 }
 
+/* KEYMODIFIERS of IOleControlSite::TranslateAccelerator */
+#define KEYMOD_SHIFT   0x1
+#define KEYMOD_CONTROL 0x2
+#define KEYMOD_ALT     0x4
+
 static HRESULT WINAPI DocObjOleInPlaceActiveObject_TranslateAccelerator(IOleInPlaceActiveObject *iface, LPMSG lpmsg)
 {
     HTMLDocumentObj *This = HTMLDocumentObj_from_IOleInPlaceActiveObject(iface);
-    FIXME("(%p)->(%p)\n", This, lpmsg);
-    return E_NOTIMPL;
+    DWORD cmd = 0, modifiers = 0;
+    IOleControlSite *site;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, lpmsg);
+
+    if(!lpmsg)
+        return E_INVALIDARG;
+
+    /* only the UI active document takes part in the accelerators, and only key presses are accelerators */
+    if(!This->ui_active || (lpmsg->message != WM_KEYDOWN && lpmsg->message != WM_SYSKEYDOWN))
+        return S_FALSE;
+
+    if(lpmsg->wParam == VK_F5)
+        cmd = IDM_REFRESH;
+
+    /* the host gets the first chance, then the document handles what it knows */
+    if(This->hostui) {
+        hres = IDocHostUIHandler_TranslateAccelerator(This->hostui, lpmsg, &CGID_MSHTML, cmd);
+        if(hres == S_OK)
+            return S_OK;
+    }
+
+    /* F5 is an accelerator of the document; the tests show no host command or navigation for it */
+    if(cmd == IDM_REFRESH)
+        return S_OK;
+
+    /* everything else is offered to the container's control site */
+    if(!This->client || FAILED(IOleClientSite_QueryInterface(This->client, &IID_IOleControlSite, (void**)&site)))
+        return S_FALSE;
+    if(GetKeyState(VK_SHIFT) & 0x8000)
+        modifiers |= KEYMOD_SHIFT;
+    if(GetKeyState(VK_CONTROL) & 0x8000)
+        modifiers |= KEYMOD_CONTROL;
+    if(GetKeyState(VK_MENU) & 0x8000)
+        modifiers |= KEYMOD_ALT;
+    hres = IOleControlSite_TranslateAccelerator(site, lpmsg, modifiers);
+    IOleControlSite_Release(site);
+    return SUCCEEDED(hres) ? hres : S_FALSE;
 }
 
 static HRESULT WINAPI DocObjOleInPlaceActiveObject_OnFrameWindowActivate(IOleInPlaceActiveObject *iface,
