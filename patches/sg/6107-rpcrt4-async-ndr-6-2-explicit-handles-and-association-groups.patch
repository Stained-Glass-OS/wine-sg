From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rpcrt4: async calls of NDR 6.2 stubs, their explicit handles, and one association group per client association

Avast's Icarus installer engine (CCleaner 7) talks between its master and slave processes by asynchronous ncalrpc calls with context handles. Async calls of stubs that say NDR 6.2 were refused (RPC_X_WRONG_STUB_VERSION); the server's async manager routine got NULL for its explicit handle_t; a connection opened while the association's first was busy bound with no association group, so a context handle was unknown over it (RPC_X_SS_CONTEXT_MISMATCH).
---
diff --git a/dlls/rpcrt4/ndr_stubless.c b/dlls/rpcrt4/ndr_stubless.c
index a268adb..a2e3aeb 100644
--- a/dlls/rpcrt4/ndr_stubless.c
+++ b/dlls/rpcrt4/ndr_stubless.c
@@ -1568,8 +1568,16 @@ static void do_ndr_async_client_call( const MIDL_STUB_DESC *pStubDesc, PFORMAT_S
     const NDR_PROC_HEADER * pProcHeader = (const NDR_PROC_HEADER *)&pFormat[0];
     RPC_STATUS status;
 
-    /* Later NDR language versions probably won't be backwards compatible */
+    /* Later NDR language versions probably won't be backwards compatible.
+     * Stained Glass OS: 6.2 is what current MIDL writes (Avast's Icarus
+     * installer engine, CCleaner's: every async call between its master and
+     * slave failed with RPC_X_WRONG_STUB_VERSION); synchronous calls take it
+     * already. */
+#ifndef SG_MUTANT_ASYNC_NDR61
+    if (pStubDesc->Version > 0x60002)
+#else
     if (pStubDesc->Version > 0x60001)
+#endif
     {
         FIXME("Incompatible stub description version: 0x%lx\n", pStubDesc->Version);
         RpcRaiseException(RPC_X_WRONG_STUB_VERSION);
@@ -1968,6 +1976,7 @@ void RPC_ENTRY NdrAsyncServerCall(PRPC_MESSAGE pRpcMsg)
     struct async_call_data *async_call_data;
     PRPC_ASYNC_STATE pAsync;
     RPC_STATUS status;
+    const NDR_EHD_PRIMITIVE *primitive = NULL;
 
     TRACE("%p\n", pRpcMsg);
 
@@ -2012,6 +2021,7 @@ void RPC_ENTRY NdrAsyncServerCall(PRPC_MESSAGE pRpcMsg)
         switch (*pFormat) /* handle_type */
         {
         case FC_BIND_PRIMITIVE: /* explicit primitive */
+            primitive = (const NDR_EHD_PRIMITIVE *)pFormat;
             pFormat += sizeof(NDR_EHD_PRIMITIVE);
             break;
         case FC_BIND_GENERIC: /* explicit generic */
@@ -2079,6 +2089,15 @@ void RPC_ENTRY NdrAsyncServerCall(PRPC_MESSAGE pRpcMsg)
     /* add the implicit pAsync pointer as the first arg to the function */
     *(void **)args = pAsync;
 
+    /* Stained Glass OS: and the call's binding where an explicit handle_t
+     * parameter goes, as NdrStubCall2 does: the manager routine got NULL
+     * (Avast's Icarus installer engine, CCleaner's, asked it for its string
+     * binding and crashed the call with an access violation) */
+#ifndef SG_MUTANT_ASYNC_NO_HANDLE
+    if (primitive && !primitive->flag)
+        *(handle_t *)ARG_FROM_OFFSET(args, primitive->offset) = pRpcMsg->Handle;
+#endif
+
     if (is_oicf_stubdesc(pStubDesc))
     {
         INTERPRETER_OPT_FLAGS2 ext_flags = { 0 };
diff --git a/dlls/rpcrt4/rpc_assoc.c b/dlls/rpcrt4/rpc_assoc.c
index afe9ac7..f14d849 100644
--- a/dlls/rpcrt4/rpc_assoc.c
+++ b/dlls/rpcrt4/rpc_assoc.c
@@ -76,6 +76,8 @@ static RPC_STATUS RpcAssoc_Alloc(LPCSTR Protseq, LPCSTR NetworkAddr,
     list_init(&assoc->context_handle_list);
     InitializeCriticalSectionEx(&assoc->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
     assoc->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": RpcAssoc.cs");
+    InitializeCriticalSectionEx(&assoc->bind_cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    assoc->bind_cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": RpcAssoc.bind_cs");
     assoc->Protseq = strdup(Protseq);
     assoc->NetworkAddr = strdup(NetworkAddr);
     assoc->Endpoint = strdup(Endpoint);
@@ -219,6 +221,8 @@ ULONG RpcAssoc_Release(RpcAssoc *assoc)
 
         assoc->cs.DebugInfo->Spare[0] = 0;
         DeleteCriticalSection(&assoc->cs);
+        assoc->bind_cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&assoc->bind_cs);
 
         free(assoc);
     }
@@ -228,7 +232,7 @@ ULONG RpcAssoc_Release(RpcAssoc *assoc)
 
 #define ROUND_UP(value, alignment) (((value) + ((alignment) - 1)) & ~((alignment)-1))
 
-static RPC_STATUS RpcAssoc_BindConnection(const RpcAssoc *assoc, RpcConnection *conn,
+static RPC_STATUS bind_connection(const RpcAssoc *assoc, RpcConnection *conn,
                                           const RPC_SYNTAX_IDENTIFIER *InterfaceId,
                                           const RPC_SYNTAX_IDENTIFIER *TransferSyntax)
 {
@@ -363,6 +367,38 @@ static RPC_STATUS RpcAssoc_BindConnection(const RpcAssoc *assoc, RpcConnection *
     return status;
 }
 
+/* Stained Glass OS: the association group. A connection's bind carries the
+ * group the server gave the association's first connection, so that the
+ * server puts every connection of a client association in one association
+ * of its own -- the one that holds the context handles. The group id was
+ * taken only when a connection went back to the idle pool: a second
+ * connection opened while the first was still in a call (an async call, or
+ * one more thread) bound with none, the server made a new association, and
+ * a context handle made over the first was unknown over the second
+ * (RPC_X_SS_CONTEXT_MISMATCH: Avast's Icarus engine, CCleaner's installer).
+ * The first bind is made alone, and its group id is the association's at once. */
+static RPC_STATUS bind_connection_in_group(RpcAssoc *assoc, RpcConnection *conn,
+                                           const RPC_SYNTAX_IDENTIFIER *InterfaceId,
+                                           const RPC_SYNTAX_IDENTIFIER *TransferSyntax)
+{
+    RPC_STATUS status;
+    BOOL first;
+
+#ifdef SG_MUTANT_ASSOC_GROUP_LATE
+    return bind_connection(assoc, conn, InterfaceId, TransferSyntax);
+#endif
+    if ((first = !assoc->assoc_group_id)) EnterCriticalSection(&assoc->bind_cs);
+    status = bind_connection(assoc, conn, InterfaceId, TransferSyntax);
+    if (status == RPC_S_OK && conn->assoc_group_id)
+    {
+        EnterCriticalSection(&assoc->cs);
+        if (!assoc->assoc_group_id) assoc->assoc_group_id = conn->assoc_group_id;
+        LeaveCriticalSection(&assoc->cs);
+    }
+    if (first) LeaveCriticalSection(&assoc->bind_cs);
+    return status;
+}
+
 static RpcConnection *RpcAssoc_GetIdleConnection(RpcAssoc *assoc,
                                                  const RPC_SYNTAX_IDENTIFIER *InterfaceId,
                                                  const RPC_SYNTAX_IDENTIFIER *TransferSyntax, const RpcAuthInfo *AuthInfo,
@@ -421,7 +457,7 @@ RPC_STATUS RpcAssoc_GetClientConnection(RpcAssoc *assoc,
         return status;
     }
 
-    status = RpcAssoc_BindConnection(assoc, NewConnection, InterfaceId, TransferSyntax);
+    status = bind_connection_in_group(assoc, NewConnection, InterfaceId, TransferSyntax);
     if (status != RPC_S_OK)
     {
         RPCRT4_ReleaseConnection(NewConnection);
diff --git a/dlls/rpcrt4/rpc_assoc.h b/dlls/rpcrt4/rpc_assoc.h
index abd3137..b5c83b6 100644
--- a/dlls/rpcrt4/rpc_assoc.h
+++ b/dlls/rpcrt4/rpc_assoc.h
@@ -37,6 +37,7 @@ typedef struct _RpcAssoc
     UUID http_uuid;
 
     CRITICAL_SECTION cs;
+    CRITICAL_SECTION bind_cs; /* Stained Glass OS: held over the bind that gets the group id */
 
     /* client-only */
     /* connections available to be used (protected by cs) */
