@@ -1375,6 +1380,7 @@
 @ stdcall -private -syscall ZwOpenProcessTokenEx(long long long ptr) NtOpenProcessTokenEx
 @ stdcall -private -syscall ZwOpenSection(ptr long ptr) NtOpenSection
 @ stdcall -private -syscall ZwOpenSemaphore(ptr long ptr) NtOpenSemaphore
+@ stdcall -private ZwOpenPrivateNamespace(ptr long ptr ptr) NtOpenPrivateNamespace
 @ stdcall -private -syscall ZwOpenSymbolicLinkObject (ptr long ptr) NtOpenSymbolicLinkObject
 @ stdcall -private -syscall ZwOpenThread(ptr long ptr ptr) NtOpenThread
 @ stdcall -private -syscall ZwOpenThreadToken(long long long ptr) NtOpenThreadToken
diff --git a/dlls/ntdll/rtl.c b/dlls/ntdll/rtl.c
index 906442f..1d9f3bb 100644
--- a/dlls/ntdll/rtl.c
+++ b/dlls/ntdll/rtl.c
@@ -2668,3 +2668,160 @@ void WINAPI RtlDeleteBoundaryDescriptor( void *desc )
     TRACE( "(%p)\n", desc );
     RtlFreeHeap( GetProcessHeap(), 0, desc );
 }
+
+/******************************************************************************
+ * NtCreatePrivateNamespace / NtOpenPrivateNamespace / NtDeletePrivateNamespace
+ *
+ * The native calls take no name: the boundary descriptor is the namespace's
+ * identity (its name and SIDs), and objects go in it by RootDirectory = the
+ * namespace handle (System Informer's PhCreatePrivateNamespace). A namespace
+ * is an object directory named after the descriptor in the session's
+ * BaseNamedObjects, so every process with an equal descriptor reaches the same
+ * one; it lives while handles to it are open, as on Windows. The boundary is
+ * checked against the caller's token as CreatePrivateNamespace does
+ * (kernelbase): its SIDs must be the token's user or enabled groups, its
+ * integrity label at most the token's.
+ */
+
+static BOOL boundary_token_has_sid( HANDLE token, PSID sid )
+{
+    char buffer[4096];
+    TOKEN_USER *user = (TOKEN_USER *)buffer;
+    TOKEN_GROUPS *groups = (TOKEN_GROUPS *)buffer;
+    ULONG len, i;
+
+    if (!NtQueryInformationToken( token, TokenUser, buffer, sizeof(buffer), &len ) &&
+        RtlEqualSid( user->User.Sid, sid )) return TRUE;
+    if (NtQueryInformationToken( token, TokenGroups, buffer, sizeof(buffer), &len )) return FALSE;
+    for (i = 0; i < groups->GroupCount; i++)
+    {
+        if ((groups->Groups[i].Attributes & (SE_GROUP_ENABLED | SE_GROUP_USE_FOR_DENY_ONLY)) != SE_GROUP_ENABLED)
+            continue;
+        if (RtlEqualSid( groups->Groups[i].Sid, sid )) return TRUE;
+    }
+    return FALSE;
+}
+
+/* checks the descriptor and the caller's membership; on success writes the
+ * namespace directory's path into buf */
+static NTSTATUS boundary_namespace_path( const OBJECT_BOUNDARY_DESCRIPTOR *desc, WCHAR *buf, ULONG cch )
+{
+    const OBJECT_BOUNDARY_ENTRY *entry;
+    HANDLE token = 0;
+    ULONG i, size, pos;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    if (!desc || desc->Version != OBJECT_BOUNDARY_DESCRIPTOR_VERSION || desc->TotalSize < sizeof(*desc) ||
+        !desc->Items)
+        return STATUS_INVALID_PARAMETER;
+    entry = (const OBJECT_BOUNDARY_ENTRY *)(desc + 1);
+    for (i = 0, size = sizeof(*desc); i < desc->Items; i++)
+    {
+        if (desc->TotalSize - size < sizeof(*entry) || entry->EntrySize < sizeof(*entry) ||
+            (entry->EntrySize & 7) || entry->EntrySize > desc->TotalSize - size)
+            return STATUS_INVALID_PARAMETER;
+        if (!i && entry->EntryType != OBNS_Name) return STATUS_INVALID_PARAMETER;
+        if (i && entry->EntryType != OBNS_SID && entry->EntryType != OBNS_IL) return STATUS_INVALID_PARAMETER;
+        size += entry->EntrySize;
+        entry = (const OBJECT_BOUNDARY_ENTRY *)((const char *)entry + entry->EntrySize);
+    }
+
+    if (NtOpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token ) &&
+        NtOpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+        token = 0;
+
+    pos = swprintf( buf, cch, L"\\Sessions\\%u\\BaseNamedObjects\\PrivateNamespace{", NtCurrentTeb()->Peb->SessionId );
+    entry = (const OBJECT_BOUNDARY_ENTRY *)(desc + 1);
+    for (i = 0; i < desc->Items && !status; i++)
+    {
+        const WCHAR *data = (const WCHAR *)(entry + 1);
+        ULONG n = (entry->EntrySize - sizeof(*entry)) / sizeof(WCHAR), j;
+
+        if (entry->EntryType == OBNS_Name)
+        {
+            while (n && !data[n - 1]) n--;
+            for (j = 0; j < n && pos + 2 < cch; j++) buf[pos++] = data[j] == '\\' ? '/' : data[j];
+            buf[pos] = 0;
+        }
+        else if (entry->EntryType == OBNS_SID)
+        {
+            UNICODE_STRING str;
+            if (!RtlValidSid( (PSID)data )) status = STATUS_INVALID_PARAMETER;
+#ifndef SG_MUTANT_PRIVNS_NO_BOUNDARY_CHECK
+            else if (!token || !boundary_token_has_sid( token, (PSID)data )) status = STATUS_ACCESS_DENIED;
+#endif
+            else if (!RtlConvertSidToUnicodeString( &str, (PSID)data, TRUE ))
+            {
+                pos += swprintf( buf + pos, cch - pos, L"|%s", str.Buffer );
+                RtlFreeUnicodeString( &str );
+            }
+        }
+        else if (entry->EntryType == OBNS_IL && token && RtlValidSid( (PSID)data ))
+        {
+            char label_buf[256];
+            TOKEN_MANDATORY_LABEL *label = (TOKEN_MANDATORY_LABEL *)label_buf;
+            ULONG len;
+            PSID need = (PSID)data;
+
+            if (!NtQueryInformationToken( token, TokenIntegrityLevel, label_buf, sizeof(label_buf), &len ) &&
+                *RtlSubAuthoritySid( label->Label.Sid, *RtlSubAuthorityCountSid( label->Label.Sid ) - 1 ) <
+                *RtlSubAuthoritySid( need, *RtlSubAuthorityCountSid( need ) - 1 ))
+                status = STATUS_ACCESS_DENIED;
+        }
+        entry = (const OBJECT_BOUNDARY_ENTRY *)((const char *)entry + entry->EntrySize);
+    }
+    if (token) NtClose( token );
+    if (!status && pos + 2 < cch) { buf[pos++] = '}'; buf[pos] = 0; }
+    return status;
+}
+
+static NTSTATUS private_namespace( HANDLE *handle, ACCESS_MASK access, OBJECT_ATTRIBUTES *attr,
+                                   void *boundary, BOOL create )
+{
+    OBJECT_ATTRIBUTES ns_attr;
+    UNICODE_STRING name;
+    WCHAR path[1024];
+    NTSTATUS status;
+
+    if (!handle) return STATUS_ACCESS_VIOLATION;
+    *handle = 0;
+    if ((status = boundary_namespace_path( boundary, path, ARRAY_SIZE(path) ))) return status;
+    RtlInitUnicodeString( &name, path );
+    InitializeObjectAttributes( &ns_attr, &name, attr ? attr->Attributes & (OBJ_INHERIT | OBJ_CASE_INSENSITIVE) : 0,
+                                0, attr ? attr->SecurityDescriptor : NULL );
+    TRACE( "%s %s\n", create ? "create" : "open", debugstr_w(path) );
+    if (create) return NtCreateDirectoryObject( handle, access, &ns_attr );
+    return NtOpenDirectoryObject( handle, access, &ns_attr );
+}
+
+/******************************************************************************
+ *  NtCreatePrivateNamespace   [NTDLL.@]
+ */
+NTSTATUS WINAPI NtCreatePrivateNamespace( HANDLE *handle, ACCESS_MASK access, OBJECT_ATTRIBUTES *attr, void *boundary )
+{
+    TRACE( "(%p, %#lx, %p, %p)\n", handle, access, attr, boundary );
+    return private_namespace( handle, access, attr, boundary, TRUE );
+}
+
+/******************************************************************************
+ *  NtOpenPrivateNamespace   [NTDLL.@]
+ */
+NTSTATUS WINAPI NtOpenPrivateNamespace( HANDLE *handle, ACCESS_MASK access, OBJECT_ATTRIBUTES *attr, void *boundary )
+{
+    TRACE( "(%p, %#lx, %p, %p)\n", handle, access, attr, boundary );
+    return private_namespace( handle, access, attr, boundary, FALSE );
+}
+
+/******************************************************************************
+ *  NtDeletePrivateNamespace   [NTDLL.@]
+ *
+ * The namespace already goes with its last handle; deleting it only checks the
+ * handle is one.
+ */
+NTSTATUS WINAPI NtDeletePrivateNamespace( HANDLE handle )
+{
+    OBJECT_BASIC_INFORMATION info;
+
+    TRACE( "(%p)\n", handle );
+    return NtQueryObject( handle, ObjectBasicInformation, &info, sizeof(info), NULL );
+}
