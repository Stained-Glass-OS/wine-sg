+NTSYSAPI NTSTATUS  WINAPI NtOpenPrivateNamespace(HANDLE*,ACCESS_MASK,OBJECT_ATTRIBUTES*,void*);
 NTSYSAPI NTSTATUS  WINAPI NtOpenProcess(PHANDLE,ACCESS_MASK,const OBJECT_ATTRIBUTES*,const CLIENT_ID*);
