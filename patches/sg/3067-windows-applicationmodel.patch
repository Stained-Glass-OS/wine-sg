+/* The view of the process's main thread. There is no windowing host behind
+ * it (no CoreWindow), and nothing activates it. */
+typedef __FITypedEventHandler_2_Windows__CApplicationModel__CCore__CCoreApplicationView_Windows__CApplicationModel__CActivation__CIActivatedEventArgs activated_handler;
+
+struct core_application_view
+{
+    ICoreApplicationView ICoreApplicationView_iface;
+    LONG ref;
+    INT64 next_token;
+};
+
+static inline struct core_application_view *impl_from_ICoreApplicationView( ICoreApplicationView *iface )
+{
+    return CONTAINING_RECORD( iface, struct core_application_view, ICoreApplicationView_iface );
+}
+
+static HRESULT WINAPI view_QueryInterface( ICoreApplicationView *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICoreApplicationView ))
+    {
+        ICoreApplicationView_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI view_AddRef( ICoreApplicationView *iface )
+{
+    return InterlockedIncrement( &impl_from_ICoreApplicationView( iface )->ref );
+}
+
+static ULONG WINAPI view_Release( ICoreApplicationView *iface )
+{
+    /* the view lives as long as the process: the static holds one reference */
+    return InterlockedDecrement( &impl_from_ICoreApplicationView( iface )->ref );
+}
+
+static HRESULT WINAPI view_GetIids( ICoreApplicationView *iface, ULONG *count, IID **iids )
+{
+    INSPECTABLE_IIDS( count, iids, &IID_ICoreApplicationView );
+}
+
+static HRESULT WINAPI view_GetRuntimeClassName( ICoreApplicationView *iface, HSTRING *name )
+{
+    return inspectable_name( RuntimeClass_Windows_ApplicationModel_Core_CoreApplicationView, name );
+}
+
+static HRESULT WINAPI view_GetTrustLevel( ICoreApplicationView *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_get_CoreWindow( ICoreApplicationView *iface, __x_ABI_CWindows_CUI_CCore_CICoreWindow **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_add_Activated( ICoreApplicationView *iface, activated_handler *handler, EventRegistrationToken *token )
+{
+    struct core_application_view *impl = impl_from_ICoreApplicationView( iface );
+
+    /* nothing activates a program that was started as a plain process */
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    if (!handler || !token) return E_POINTER;
+    token->value = InterlockedIncrement64( &impl->next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI view_remove_Activated( ICoreApplicationView *iface, EventRegistrationToken token )
+{
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+    return S_OK;
+}
+
+static HRESULT WINAPI view_get_IsMain( ICoreApplicationView *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_get_IsHosted( ICoreApplicationView *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static const ICoreApplicationViewVtbl view_vtbl =
+{
+    view_QueryInterface, view_AddRef, view_Release,
+    view_GetIids, view_GetRuntimeClassName, view_GetTrustLevel,
+    view_get_CoreWindow, view_add_Activated, view_remove_Activated,
+    view_get_IsMain, view_get_IsHosted,
+};
+
+static struct core_application_view current_view = { {&view_vtbl}, 1, 0 };
+
