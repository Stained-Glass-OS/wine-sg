+/* the interfaces an object implements (its WinRT ones, not IUnknown,
+ * IInspectable or IAgileObject), in memory the caller frees with CoTaskMemFree */
+HRESULT inspectable_iids( ULONG *count, IID **iids, const IID *const *list, ULONG n )
+{
+    ULONG i;
+
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = NULL;
+    if (!n) return S_OK;
+    if (!(*iids = CoTaskMemAlloc( n * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < n; i++) (*iids)[i] = *list[i];
+    *count = n;
+    return S_OK;
+}
+
+HRESULT inspectable_name( const WCHAR *name, HSTRING *class_name )
+{
+    if (!class_name) return E_POINTER;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
