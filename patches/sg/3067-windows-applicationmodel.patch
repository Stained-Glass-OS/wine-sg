+/* tell the MapChanged handlers; none is called with the set locked */
+static void fire_changed( struct property_set *impl, int change, HSTRING key )
+{
+    IMapChangedEventHandler_HSTRING_IInspectable **list;
+    struct change_args *args;
+    unsigned int i, n;
+
+    EnterCriticalSection( &impl->cs );
+    n = impl->handler_count;
+    if (!n || !(list = malloc( n * sizeof(*list) )))
+    {
+        LeaveCriticalSection( &impl->cs );
+        return;
+    }
+    for (i = 0; i < n; i++)
+    {
+        list[i] = impl->handlers[i].handler;
+        IMapChangedEventHandler_HSTRING_IInspectable_AddRef( list[i] );
+    }
+    LeaveCriticalSection( &impl->cs );
+
+    if ((args = calloc( 1, sizeof(*args) )))
+    {
+        args->IMapChangedEventArgs_iface.lpVtbl = &args_vtbl;
+        args->ref = 1;
+        args->change = change;
+        if (key) WindowsDuplicateString( key, &args->key );
+        for (i = 0; i < n; i++)
+            IMapChangedEventHandler_HSTRING_IInspectable_Invoke( list[i], &impl->IObservableMap_iface,
+                                                                 &args->IMapChangedEventArgs_iface );
+        IMapChangedEventArgs_HSTRING_Release( &args->IMapChangedEventArgs_iface );
+    }
+    for (i = 0; i < n; i++) IMapChangedEventHandler_HSTRING_IInspectable_Release( list[i] );
+    free( list );
