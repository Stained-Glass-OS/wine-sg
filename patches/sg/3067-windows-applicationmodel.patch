+/* The installed location is the folder the program's image is in; it is the
+ * ordinary Windows.Storage.StorageFolder of that directory. */
+static HRESULT get_installed_location( IStorageFolder **folder )
+{
+    typedef HRESULT (WINAPI *get_factory_func)( HSTRING, IActivationFactory ** );
+    static const WCHAR *class_name = L"Windows.Storage.StorageFolder";
+    IAsyncOperation_StorageFolder *operation = NULL;
+    IStorageFolderStatics *statics = NULL;
+    IActivationFactory *factory = NULL;
+    IAsyncInfo *info = NULL;
+    IStorageFolder *result = NULL;
+    get_factory_func get_factory;
+    HSTRING path = NULL, name = NULL;
+    WCHAR buffer[MAX_PATH];
+    AsyncStatus status;
+    HMODULE module;
+    HRESULT hr;
+    int i;
+
+    *folder = NULL;
+    if (!GetModuleFileNameW( NULL, buffer, MAX_PATH )) return HRESULT_FROM_WIN32( GetLastError() );
+    if (FAILED( hr = PathCchRemoveFileSpec( buffer, ARRAY_SIZE(buffer) ) )) return hr;
+
+    if (!(module = LoadLibraryW( L"windows.storage.dll" ))) return HRESULT_FROM_WIN32( GetLastError() );
+    if (!(get_factory = (void *)GetProcAddress( module, "DllGetActivationFactory" ))) hr = E_NOTIMPL;
+    else if (SUCCEEDED( hr = WindowsCreateString( class_name, wcslen( class_name ), &name ) ) &&
+             SUCCEEDED( hr = get_factory( name, &factory ) ) &&
+             SUCCEEDED( hr = IActivationFactory_QueryInterface( factory, &IID_IStorageFolderStatics, (void **)&statics ) ) &&
+             SUCCEEDED( hr = WindowsCreateString( buffer, wcslen( buffer ), &path ) ) &&
+             SUCCEEDED( hr = IStorageFolderStatics_GetFolderFromPathAsync( statics, path, &operation ) ) &&
+             SUCCEEDED( hr = IAsyncOperation_StorageFolder_QueryInterface( operation, &IID_IAsyncInfo, (void **)&info ) ))
+    {
+        /* the operation runs on a worker thread of its own: wait for it */
+        for (i = 0; i < 5000; i++)
+        {
+            if (FAILED( hr = IAsyncInfo_get_Status( info, &status ) ) || status != Started) break;
+            Sleep( 1 );
+        }
+        if (SUCCEEDED( hr ) && status == Completed)
+        {
+            hr = IAsyncOperation_StorageFolder_GetResults( operation, &result );
+            if (SUCCEEDED( hr )) hr = IStorageFolder_QueryInterface( result, &IID_IStorageFolder, (void **)folder );
+            if (result) IStorageFolder_Release( result );
+        }
+        else if (SUCCEEDED( hr ))
+        {
+            if (FAILED( IAsyncInfo_get_ErrorCode( info, &hr ) ) || SUCCEEDED( hr )) hr = E_FAIL;
+        }
+    }
+
+    if (info) IAsyncInfo_Release( info );
+    if (operation) IAsyncOperation_StorageFolder_Release( operation );
+    if (statics) IStorageFolderStatics_Release( statics );
+    if (factory) IActivationFactory_Release( factory );
+    WindowsDeleteString( path );
+    WindowsDeleteString( name );
+    return hr;
+}
