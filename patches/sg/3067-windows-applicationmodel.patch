+    /* Run hands the thread to a packaged app's view source and its window;
+     * a plain process has neither package identity nor a CoreWindow. */
+    if (!view_source) return E_POINTER;
+    return HRESULT_FROM_WIN32( APPMODEL_ERROR_NO_PACKAGE );
