 static HRESULT WINAPI core_application_Run( ICoreApplication *iface, IFrameworkViewSource *view_source )
 {
-    FIXME( "iface %p, view_source %p stub!\n", iface, view_source );
-    return E_NOTIMPL;
+    TRACE( "iface %p, view_source %p.\n", iface, view_source );
