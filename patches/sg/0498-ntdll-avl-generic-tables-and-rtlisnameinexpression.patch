-void * WINAPI RtlEnumerateGenericTableWithoutSplayingAvl(RTL_AVL_TABLE *table, PVOID *previous)
+void * WINAPI RtlEnumerateGenericTableWithoutSplayingAvl( RTL_AVL_TABLE *table, PVOID *previous )
 {
-    static int warn_once;
+    struct rb_entry *entry;
 
-    if (!warn_once++)
-        FIXME("(%p, %p) stub!\n", table, previous);
-    return NULL;
+    TRACE( "(%p, %p)\n", table, previous );
+
+    if (!*previous) entry = rb_head( avl_tree( table )->root );
+    else entry = rb_next( (struct rb_entry *)*previous );
+    *previous = entry;
+    return avl_data( entry );
 }
 
 /******************************************************************************
- *  RtlNumberGenericTableElementsAvl  (NTDLL.@)
+ *           RtlGetElementGenericTableAvl  (NTDLL.@)
  */
-ULONG WINAPI RtlNumberGenericTableElementsAvl(RTL_AVL_TABLE *table)
+void * WINAPI RtlGetElementGenericTableAvl( PRTL_AVL_TABLE table, ULONG index )
 {
-    FIXME("(%p) stub!\n", table);
-    return 0;
+    struct rb_entry *entry;
+    ULONG i;
+
+    TRACE( "(%p, %lu)\n", table, index );
+
+    if (index >= table->NumberGenericTableElements) return NULL;
+    for (entry = rb_head( avl_tree( table )->root ), i = 0; entry && i < index; i++) entry = rb_next( entry );
+    return avl_data( entry );
 }
 
-/***********************************************************************
- *           RtlInsertElementGenericTableAvl  (NTDLL.@)
+/******************************************************************************
+ *           RtlNumberGenericTableElementsAvl  (NTDLL.@)
  */
-void WINAPI RtlInsertElementGenericTableAvl(PRTL_AVL_TABLE table, void *buffer, ULONG size, BOOL *element)
+ULONG WINAPI RtlNumberGenericTableElementsAvl( RTL_AVL_TABLE *table )
 {
-    FIXME("%p %p %lu %p: stub\n", table, buffer, size, element);
+    TRACE( "(%p)\n", table );
+    return table->NumberGenericTableElements;
 }
 
 /******************************************************************************
- *           RtlLookupElementGenericTableAvl  (NTDLL.@)
+ *           RtlIsGenericTableEmptyAvl  (NTDLL.@)
  */
-void * WINAPI RtlLookupElementGenericTableAvl(PRTL_AVL_TABLE table, void *buffer)
+BOOLEAN WINAPI RtlIsGenericTableEmptyAvl( PRTL_AVL_TABLE table )
+{
+    TRACE( "(%p)\n", table );
+    return !avl_tree( table )->root;
+}
+
+/* Stained Glass OS: a file name against a file system expression, as
+ * FsRtlIsNameInExpression: '*' any characters, '?' one; the DOS wildcards
+ * DOS_STAR ('<': any characters up to the name's last dot), DOS_QM ('>': one
+ * character, or none before a dot or at the end) and DOS_DOT ('"': a dot, or
+ * the end). With ignore_case, the name is upcased first (the expression
+ * already is, as the caller must give it). App-V's subsystems match paths
+ * with it. */
+static BOOLEAN name_in_expression( const WCHAR *exp, int exp_len, const WCHAR *name, int name_len,
+                                   BOOLEAN ignore_case, const WCHAR *upcase )
 {
-    FIXME("(%p, %p) stub!\n", table, buffer);
-    return NULL;
+    while (exp_len)
+    {
+        WCHAR e = *exp;
+        int i;
+
+        if (e == '*' || e == '<')
+        {
+            /* the rest of the expression, from each place in the name */
+            int limit = name_len;
+            if (e == '<')
+            {
+                /* not past the name's last dot */
+                for (i = name_len - 1; i >= 0; i--) if (name[i] == '.') break;
+                if (i >= 0) limit = i;
+            }
+            for (i = 0; i <= limit; i++)
+                if (name_in_expression( exp + 1, exp_len - 1, name + i, name_len - i, ignore_case, upcase ))
+                    return TRUE;
+            return FALSE;
+        }
+        if (e == '>')
+        {
+            /* one character, or nothing at a dot or at the end */
+            if (!name_len || *name == '.')
+            {
+                exp++; exp_len--;
+                continue;
+            }
+            exp++; exp_len--; name++; name_len--;
+            continue;
+        }
+        if (e == '"')
+        {
+            if (!name_len) { exp++; exp_len--; continue; }
+            if (*name != '.') return FALSE;
+            exp++; exp_len--; name++; name_len--;
+            continue;
+        }
+        if (!name_len) return FALSE;
+        if (e != '?')
+        {
+            WCHAR c = *name;
+            if (ignore_case) c = upcase ? upcase[c] : RtlUpcaseUnicodeChar( c );
+            if (c != e) return FALSE;
+        }
+        exp++; exp_len--; name++; name_len--;
+    }
+    return !name_len;
+}
+
+/******************************************************************************
+ *           RtlIsNameInExpression  (NTDLL.@)
+ */
+BOOLEAN WINAPI RtlIsNameInExpression( UNICODE_STRING *expression, UNICODE_STRING *name, BOOLEAN ignore_case,
+                                      WCHAR *upcase_table )
+{
+    TRACE( "(%s, %s, %d, %p)\n", debugstr_us(expression), debugstr_us(name), ignore_case, upcase_table );
+
+    if (!expression || !name) return FALSE;
+    return name_in_expression( expression->Buffer, expression->Length / sizeof(WCHAR), name->Buffer,
+                               name->Length / sizeof(WCHAR), ignore_case, upcase_table );
 }
 
