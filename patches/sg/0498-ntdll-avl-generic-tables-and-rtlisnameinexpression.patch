From: Stained Glass OS <dev@stained-glass.example>
Subject: ntdll: AVL generic tables, and RtlIsNameInExpression

Office's Word runs inside App-V's subsystems (AppVIsvSubsystems64.dll),
which keep their file system and registry maps in AVL generic tables and
match paths with RtlIsNameInExpression. The tables were stubs that held
nothing (and RtlEnumerateGenericTableAvl, RtlIsGenericTableEmptyAvl,
RtlGetElementGenericTableAvl, RtlDeleteElementGenericTableAvl were not
exported); RtlIsNameInExpression was missing.

- Rtl*GenericTableAvl: a real table on Wine's red-black tree. An element's
  links live in the RTL_BALANCED_LINKS header the caller's allocate routine
  is asked for in front of it, the tree in the table's BalancedRoot; the
  caller's compare, allocate and free routines are used as on Windows.
  Insert (a duplicate returns the element there), lookup, delete,
  enumerate in order (with and without splaying), get the n-th, count,
  empty. RtlInsertElementGenericTableAvl returns the element, as it does.
- RtlIsNameInExpression: '*', '?', and the DOS wildcards '<' (up to the
  name's last dot), '>' and '"', case-insensitively with an upcased
  expression; ntoskrnl's FsRtlIsNameInExpression uses it.

Gate: test/avl-gate.sh.
---
--- a/dlls/ntdll/rtl.c
+++ b/dlls/ntdll/rtl.c
@@ -1022,51 +1022,261 @@
     if (tree->root) tree->root->Red = 0;
 }
 
+/* Stained Glass OS: the AVL generic tables (Rtl*GenericTableAvl), which were
+ * stubs -- a table held nothing, and App-V's subsystems (Office's
+ * virtualization, AppVIsvSubsystems64.dll) keep their file system and
+ * registry maps in them. The tree is Wine's red-black tree: each element's
+ * links live in the RTL_BALANCED_LINKS header the caller's allocate routine
+ * is asked for in front of the element, the tree itself in the table's
+ * BalancedRoot; the caller's compare, allocate and free routines are used as
+ * on Windows. Elements are enumerated in order. */
+#include "wine/rbtree.h"
+
+C_ASSERT( sizeof(struct rb_entry) <= sizeof(RTL_BALANCED_LINKS) );
+C_ASSERT( sizeof(struct rb_tree) <= sizeof(RTL_BALANCED_LINKS) );
+
+struct avl_key
+{
+    RTL_AVL_TABLE *table;
+    void *buffer;
+};
+
+static inline struct rb_tree *avl_tree( RTL_AVL_TABLE *table )
+{
+    return (struct rb_tree *)&table->BalancedRoot;
+}
+
+static inline void *avl_data( struct rb_entry *entry )
+{
+    return entry ? (char *)entry + sizeof(RTL_BALANCED_LINKS) : NULL;
+}
+
+static int avl_compare( const void *key, const struct rb_entry *entry )
+{
+    const struct avl_key *k = key;
+    switch (k->table->CompareRoutine( k->table, k->buffer, avl_data( (struct rb_entry *)entry ) ))
+    {
+    case GenericLessThan: return -1;
+    case GenericGreaterThan: return 1;
+    default: return 0;
+    }
+}
+
+static struct rb_entry *avl_find( RTL_AVL_TABLE *table, void *buffer )
+{
+    struct avl_key key = { table, buffer };
+    return rb_get( avl_tree( table ), &key );
+}
+
 /***********************************************************************
  *           RtlInitializeGenericTableAvl  (NTDLL.@)
  */
-void WINAPI RtlInitializeGenericTableAvl(PRTL_AVL_TABLE table, PRTL_AVL_COMPARE_ROUTINE compare,
-                                         PRTL_AVL_ALLOCATE_ROUTINE allocate, PRTL_AVL_FREE_ROUTINE free, void *context)
+void WINAPI RtlInitializeGenericTableAvl( PRTL_AVL_TABLE table, PRTL_AVL_COMPARE_ROUTINE compare,
+                                          PRTL_AVL_ALLOCATE_ROUTINE allocate, PRTL_AVL_FREE_ROUTINE free, void *context )
+{
+    TRACE( "%p %p %p %p %p\n", table, compare, allocate, free, context );
+
+    memset( table, 0, sizeof(*table) );
+    rb_init( avl_tree( table ), avl_compare );
+    table->CompareRoutine = compare;
+    table->AllocateRoutine = allocate;
+    table->FreeRoutine = free;
+    table->TableContext = context;
+}
+
+/***********************************************************************
+ *           RtlInsertElementGenericTableAvl  (NTDLL.@)
+ */
+void * WINAPI RtlInsertElementGenericTableAvl( PRTL_AVL_TABLE table, void *buffer, ULONG size, BOOLEAN *new_element )
+{
+    struct avl_key key = { table, buffer };
+    struct rb_entry *entry;
+
+    TRACE( "%p %p %lu %p\n", table, buffer, size, new_element );
+
+    if ((entry = rb_get( avl_tree( table ), &key )))
+    {
+        if (new_element) *new_element = FALSE;
+        return avl_data( entry );
+    }
+    if (!(entry = table->AllocateRoutine( table, sizeof(RTL_BALANCED_LINKS) + size )))
+    {
+        if (new_element) *new_element = FALSE;
+        return NULL;
+    }
+    memset( entry, 0, sizeof(RTL_BALANCED_LINKS) );
+    memcpy( avl_data( entry ), buffer, size );
+    rb_put( avl_tree( table ), &key, entry );
+    table->NumberGenericTableElements++;
+    table->OrderedPointer = NULL;
+    table->WhichOrderedElement = 0;
+    if (new_element) *new_element = TRUE;
+    return avl_data( entry );
+}
+
+/******************************************************************************
+ *           RtlLookupElementGenericTableAvl  (NTDLL.@)
+ */
+void * WINAPI RtlLookupElementGenericTableAvl( PRTL_AVL_TABLE table, void *buffer )
 {
-    FIXME("%p %p %p %p %p: stub\n", table, compare, allocate, free, context);
+    TRACE( "(%p, %p)\n", table, buffer );
+    return avl_data( avl_find( table, buffer ) );
+}
+
+/******************************************************************************
+ *           RtlDeleteElementGenericTableAvl  (NTDLL.@)
+ */
+BOOLEAN WINAPI RtlDeleteElementGenericTableAvl( PRTL_AVL_TABLE table, void *buffer )
+{
+    struct rb_entry *entry = avl_find( table, buffer );
+
+    TRACE( "(%p, %p)\n", table, buffer );
+
+    if (!entry) return FALSE;
+    if (table->RestartKey == (PRTL_BALANCED_LINKS)entry) table->RestartKey = NULL;
+    rb_remove( avl_tree( table ), entry );
+    table->NumberGenericTableElements--;
+    table->DeleteCount++;
+    table->OrderedPointer = NULL;
+    table->WhichOrderedElement = 0;
+    table->FreeRoutine( table, entry );
+    return TRUE;
+}
+
+/******************************************************************************
+ *           RtlEnumerateGenericTableAvl  (NTDLL.@)
+ */
+void * WINAPI RtlEnumerateGenericTableAvl( PRTL_AVL_TABLE table, BOOLEAN restart )
+{
+    struct rb_entry *entry;
+
+    TRACE( "(%p, %d)\n", table, restart );
+
+    if (restart || !table->RestartKey) entry = rb_head( avl_tree( table )->root );
+    else entry = rb_next( (struct rb_entry *)table->RestartKey );
+    table->RestartKey = (PRTL_BALANCED_LINKS)entry;
+    return avl_data( entry );
 }
 
 /******************************************************************************
  *           RtlEnumerateGenericTableWithoutSplayingAvl  (NTDLL.@)
