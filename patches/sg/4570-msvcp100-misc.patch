diff --git a/dlls/msvcp90/misc.c b/dlls/msvcp90/misc.c
index 2075eae..701c781 100644
--- a/dlls/msvcp90/misc.c
+++ b/dlls/msvcp90/misc.c
@@ -273,6 +273,18 @@ mutex* __thiscall mutex_ctor(mutex *this)
     return this;
 }
 
+#if _MSVCP_VER == 100
+/* ??0_Mutex@std@@QAE@W4_Uninitialized@1@@Z */
+/* ??0_Mutex@std@@QEAA@W4_Uninitialized@1@@Z */
+/* leaves the mutex as it is: the static ones are set up by _Mutex_ctor */
+DEFINE_THISCALL_WRAPPER(mutex_ctor_uninitialized, 8)
+mutex* __thiscall mutex_ctor_uninitialized(mutex *this, int uninitialized)
+{
+    TRACE("(%p %d)\n", this, uninitialized);
+    return this;
+}
+#endif
