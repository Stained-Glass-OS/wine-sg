@@ -341,6 +358,46 @@ static void fire_position_changed(struct geolocator *impl, IGeoposition *positio
 }
 
 /* Ask GeoClue for the position.  Consent is checked first: with location denied nothing is sent anywhere. */
+/* The app's default geoposition (Geolocator.DefaultGeoposition), shared by the process. */
+static CRITICAL_SECTION default_cs;
+static CRITICAL_SECTION_DEBUG default_cs_debug =
+{
+    0, 0, &default_cs,
+    { &default_cs_debug.ProcessLocksList, &default_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": default_cs") }
+};
+static CRITICAL_SECTION default_cs = { &default_cs_debug, -1, 0, 0, 0, 0 };
+static BOOL has_default_geoposition;
+static BasicGeoposition default_geoposition;
+static BOOL service_unavailable;     /* the last attempt found no location service or no fix */
+
+static BOOL use_default_geoposition(struct location *loc)
+{
+    BOOL ret = FALSE;
+
+    EnterCriticalSection(&default_cs);
+    if (has_default_geoposition)
+    {
+        FILETIME ft;
+        ULARGE_INTEGER now;
+
+        memset(loc, 0, sizeof(*loc));
+        loc->latitude = default_geoposition.Latitude;
+        loc->longitude = default_geoposition.Longitude;
+        loc->altitude = default_geoposition.Altitude;
+        loc->has_altitude = TRUE;
+        loc->accuracy = 0.0;   /* GUESSED: the app named the position, so it is exact */
+        loc->source = PositionSource_Default;
+        GetSystemTimeAsFileTime(&ft);
+        now.LowPart = ft.dwLowDateTime;
+        now.HighPart = ft.dwHighDateTime;
+        loc->timestamp = now.QuadPart;
+        ret = TRUE;
+    }
+    LeaveCriticalSection(&default_cs);
+    return ret;
+}
+
 static HRESULT fetch_location(struct geolocator *impl, int timeout_ms, struct location *loc)
 {
     struct get_location_params params = {0};
@@ -357,6 +414,12 @@ static HRESULT fetch_location(struct geolocator *impl, int timeout_ms, struct lo
 
     EnterCriticalSection(&impl->cs);
     accuracy = impl->accuracy;
+    /* GUESSED: a request for 100 meters or better is a request for high accuracy */
+#ifdef SG_MUTANT_GEO_METERS
+    if (impl->has_meters) accuracy = impl->meters <= 100 ? PositionAccuracy_Default : PositionAccuracy_High;
+#else
+    if (impl->has_meters) accuracy = impl->meters <= 100 ? PositionAccuracy_High : PositionAccuracy_Default;
+#endif
     LeaveCriticalSection(&impl->cs);
 
     set_status(impl, PositionStatus_Initializing);
@@ -370,6 +433,7 @@ static HRESULT fetch_location(struct geolocator *impl, int timeout_ms, struct lo
     switch (params.result)
     {
     case LOCATION_OK:
+        service_unavailable = FALSE;
         loc->latitude = params.latitude;
         loc->longitude = params.longitude;
         loc->accuracy = params.accuracy;
@@ -380,6 +444,7 @@ static HRESULT fetch_location(struct geolocator *impl, int timeout_ms, struct lo
         loc->has_speed = !!(params.flags & LOCATION_HAS_SPEED);
         loc->has_heading = !!(params.flags & LOCATION_HAS_HEADING);
         loc->timestamp = (LONGLONG)params.time_sec * 10000000 + params.time_usec * 10 + 116444736000000000ll;
+        loc->source = PositionSource_Unknown;   /* GeoClue does not say which source it used */
         EnterCriticalSection(&impl->cs);
         impl->cache = *loc;
         impl->has_cache = TRUE;
@@ -391,11 +456,18 @@ static HRESULT fetch_location(struct geolocator *impl, int timeout_ms, struct lo
         set_status(impl, PositionStatus_Disabled);
         return E_ACCESSDENIED;
     case LOCATION_UNAVAILABLE:
-        /* no location service: Windows without a source reports its timeout error */
+        /* no location service: the app's default geoposition if it set one, else
+         * Windows without a source reports its timeout error */
         set_status(impl, PositionStatus_NotAvailable);
+        service_unavailable = TRUE;
+#ifndef SG_MUTANT_GEO_NODEFAULT
+        if (use_default_geoposition(loc)) return S_OK;
+#endif
         return HRESULT_FROM_WIN32(ERROR_TIMEOUT);
     case LOCATION_TIMEOUT:
         set_status(impl, PositionStatus_NoData);
+        service_unavailable = TRUE;
+        if (use_default_geoposition(loc)) return S_OK;
         return HRESULT_FROM_WIN32(ERROR_TIMEOUT);
     default:
         set_status(impl, PositionStatus_NoData);
@@ -721,6 +793,230 @@ static const struct IGeolocatorVtbl geolocator_vtbl =
     geolocator_remove_StatusChanged,
 };
 
+/* IReference<UINT32> and IReference<BasicGeoposition>: small immutable boxes */
+
+struct uint_ref
+{
+    IReference_UINT32 IReference_UINT32_iface;
+    LONG ref;
+    UINT32 value;
+};
+
+static inline struct uint_ref *impl_from_uint_ref(IReference_UINT32 *iface)
+{
+    return CONTAINING_RECORD(iface, struct uint_ref, IReference_UINT32_iface);
+}
+
+static HRESULT WINAPI uint_ref_QueryInterface(IReference_UINT32 *iface, REFIID iid, void **out)
+{
+    struct uint_ref *impl = impl_from_uint_ref(iface);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IReference_UINT32))
+    {
+        IReference_UINT32_AddRef((*out = &impl->IReference_UINT32_iface));
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI uint_ref_AddRef(IReference_UINT32 *iface)
+{
+    return InterlockedIncrement(&impl_from_uint_ref(iface)->ref);
+}
+
+static ULONG WINAPI uint_ref_Release(IReference_UINT32 *iface)
+{
+    struct uint_ref *impl = impl_from_uint_ref(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref) free(impl);
+    return ref;
+}
+
+static HRESULT WINAPI uint_ref_GetIids(IReference_UINT32 *iface, ULONG *count, IID **iids)
+{
+    return get_one_iid(&IID_IReference_UINT32, count, iids);
+}
+
+static HRESULT WINAPI uint_ref_GetRuntimeClassName(IReference_UINT32 *iface, HSTRING *name)
+{
+    static const WCHAR text[] = L"Windows.Foundation.IReference`1<UInt32>";
+    if (!name) return E_POINTER;
+    return WindowsCreateString(text, ARRAY_SIZE(text) - 1, name);
+}
+
+static HRESULT WINAPI uint_ref_GetTrustLevel(IReference_UINT32 *iface, TrustLevel *level)
+{
+    return get_base_trust(level);
+}
+
+static HRESULT WINAPI uint_ref_get_Value(IReference_UINT32 *iface, UINT32 *value)
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_uint_ref(iface)->value;
+    return S_OK;
+}
+
+static const IReference_UINT32Vtbl uint_ref_vtbl =
+{
+    uint_ref_QueryInterface, uint_ref_AddRef, uint_ref_Release, uint_ref_GetIids,
+    uint_ref_GetRuntimeClassName, uint_ref_GetTrustLevel, uint_ref_get_Value,
+};
+
+struct bgp_ref
+{
+    IReference_BasicGeoposition IReference_BasicGeoposition_iface;
+    LONG ref;
+    BasicGeoposition value;
+};
+
+static inline struct bgp_ref *impl_from_bgp_ref(IReference_BasicGeoposition *iface)
+{
+    return CONTAINING_RECORD(iface, struct bgp_ref, IReference_BasicGeoposition_iface);
+}
+
+static HRESULT WINAPI bgp_ref_QueryInterface(IReference_BasicGeoposition *iface, REFIID iid, void **out)
+{
+    struct bgp_ref *impl = impl_from_bgp_ref(iface);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IReference_BasicGeoposition))
+    {
+        IReference_BasicGeoposition_AddRef((*out = &impl->IReference_BasicGeoposition_iface));
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI bgp_ref_AddRef(IReference_BasicGeoposition *iface)
+{
+    return InterlockedIncrement(&impl_from_bgp_ref(iface)->ref);
+}
+
+static ULONG WINAPI bgp_ref_Release(IReference_BasicGeoposition *iface)
+{
+    struct bgp_ref *impl = impl_from_bgp_ref(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref) free(impl);
+    return ref;
+}
+
+static HRESULT WINAPI bgp_ref_GetIids(IReference_BasicGeoposition *iface, ULONG *count, IID **iids)
+{
+    return get_one_iid(&IID_IReference_BasicGeoposition, count, iids);
+}
+
+static HRESULT WINAPI bgp_ref_GetRuntimeClassName(IReference_BasicGeoposition *iface, HSTRING *name)
+{
+    static const WCHAR text[] = L"Windows.Foundation.IReference`1<Windows.Devices.Geolocation.BasicGeoposition>";
+    if (!name) return E_POINTER;
+    return WindowsCreateString(text, ARRAY_SIZE(text) - 1, name);
+}
+
+static HRESULT WINAPI bgp_ref_GetTrustLevel(IReference_BasicGeoposition *iface, TrustLevel *level)
+{
+    return get_base_trust(level);
+}
+
+static HRESULT WINAPI bgp_ref_get_Value(IReference_BasicGeoposition *iface, BasicGeoposition *value)
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_bgp_ref(iface)->value;
+    return S_OK;
+}
+
+static const IReference_BasicGeopositionVtbl bgp_ref_vtbl =
+{
+    bgp_ref_QueryInterface, bgp_ref_AddRef, bgp_ref_Release, bgp_ref_GetIids,
+    bgp_ref_GetRuntimeClassName, bgp_ref_GetTrustLevel, bgp_ref_get_Value,
+};
+
+/* IGeolocatorWithScalarAccuracy: DesiredAccuracyInMeters */
+
+static inline struct geolocator *impl_from_IGeolocatorWithScalarAccuracy(IGeolocatorWithScalarAccuracy *iface)
+{
+    return CONTAINING_RECORD(iface, struct geolocator, IGeolocatorWithScalarAccuracy_iface);
+}
+
+static HRESULT WINAPI scalar_QueryInterface(IGeolocatorWithScalarAccuracy *iface, REFIID iid, void **out)
+{
+    return geolocator_QueryInterface(&impl_from_IGeolocatorWithScalarAccuracy(iface)->IGeolocator_iface, iid, out);
+}
+
+static ULONG WINAPI scalar_AddRef(IGeolocatorWithScalarAccuracy *iface)
+{
+    return geolocator_AddRef(&impl_from_IGeolocatorWithScalarAccuracy(iface)->IGeolocator_iface);
+}
+
+static ULONG WINAPI scalar_Release(IGeolocatorWithScalarAccuracy *iface)
+{
+    return geolocator_Release(&impl_from_IGeolocatorWithScalarAccuracy(iface)->IGeolocator_iface);
+}
+
+static HRESULT WINAPI scalar_GetIids(IGeolocatorWithScalarAccuracy *iface, ULONG *count, IID **iids)
+{
+    return geolocator_GetIids(&impl_from_IGeolocatorWithScalarAccuracy(iface)->IGeolocator_iface, count, iids);
+}
+
+static HRESULT WINAPI scalar_GetRuntimeClassName(IGeolocatorWithScalarAccuracy *iface, HSTRING *name)
+{
+    return get_class_name(name);
+}
+
+static HRESULT WINAPI scalar_GetTrustLevel(IGeolocatorWithScalarAccuracy *iface, TrustLevel *level)
+{
+    return get_base_trust(level);
+}
+
+static HRESULT WINAPI scalar_get_DesiredAccuracyInMeters(IGeolocatorWithScalarAccuracy *iface, IReference_UINT32 **value)
+{
+    struct geolocator *impl = impl_from_IGeolocatorWithScalarAccuracy(iface);
+    struct uint_ref *ref;
+    BOOL has;
+    UINT32 meters;
+
+    TRACE("iface %p, value %p.\n", iface, value);
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    EnterCriticalSection(&impl->cs);
+    has = impl->has_meters;
+    meters = impl->meters;
+    LeaveCriticalSection(&impl->cs);
+    if (!has) return S_OK;    /* null: the enum DesiredAccuracy is in force */
+    if (!(ref = calloc(1, sizeof(*ref)))) return E_OUTOFMEMORY;
+    ref->IReference_UINT32_iface.lpVtbl = &uint_ref_vtbl;
+    ref->ref = 1;
+    ref->value = meters;
+    *value = &ref->IReference_UINT32_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI scalar_put_DesiredAccuracyInMeters(IGeolocatorWithScalarAccuracy *iface, IReference_UINT32 *value)
+{
+    struct geolocator *impl = impl_from_IGeolocatorWithScalarAccuracy(iface);
+    UINT32 meters = 0;
+    HRESULT hr;
+
+    TRACE("iface %p, value %p.\n", iface, value);
+
+    if (value && FAILED(hr = IReference_UINT32_get_Value(value, &meters))) return hr;
+    EnterCriticalSection(&impl->cs);
+    impl->has_meters = value != NULL;     /* null goes back to DesiredAccuracy */
+    impl->meters = meters;
+    LeaveCriticalSection(&impl->cs);
+    return S_OK;
+}
+
+static const IGeolocatorWithScalarAccuracyVtbl scalar_vtbl =
+{
+    scalar_QueryInterface, scalar_AddRef, scalar_Release, scalar_GetIids,
+    scalar_GetRuntimeClassName, scalar_GetTrustLevel,
+    scalar_get_DesiredAccuracyInMeters, scalar_put_DesiredAccuracyInMeters,
+};
+
 static inline struct geolocator *impl_from_IWeakReference(IWeakReference *iface)
 {
     return CONTAINING_RECORD(iface, struct geolocator, IWeakReference_iface);
@@ -872,7 +1168,14 @@ static HRESULT WINAPI factory_QueryInterface(IActivationFactory *iface, REFIID i
         return S_OK;
     }
 
-    FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    if (IsEqualGUID(iid, &IID_IGeolocatorStatics2))
+    {
+        *out = &impl->IGeolocatorStatics2_iface;
+        IInspectable_AddRef(*out);
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
     *out = NULL;
     return E_NOINTERFACE;
 }
@@ -926,6 +1229,7 @@ static HRESULT WINAPI factory_ActivateInstance(IActivationFactory *iface, IInspe
     }
 
     impl->IGeolocator_iface.lpVtbl = &geolocator_vtbl;
+    impl->IGeolocatorWithScalarAccuracy_iface.lpVtbl = &scalar_vtbl;
     impl->IWeakReferenceSource_iface.lpVtbl = &weak_reference_source_vtbl;
     impl->IWeakReference_iface.lpVtbl = &weak_reference_vtbl;
     impl->ref_public = 1;
@@ -1012,10 +1316,121 @@ static const IGeolocatorStaticsVtbl statics_vtbl =
     statics_RequestAccessAsync,
 };
 
+/* IGeolocatorStatics2 */
+
+static inline struct geolocator_statics *impl_from_IGeolocatorStatics2(IGeolocatorStatics2 *iface)
+{
+    return CONTAINING_RECORD(iface, struct geolocator_statics, IGeolocatorStatics2_iface);
+}
+
+static HRESULT WINAPI statics2_QueryInterface(IGeolocatorStatics2 *iface, REFIID iid, void **out)
+{
+    return factory_QueryInterface(&impl_from_IGeolocatorStatics2(iface)->IActivationFactory_iface, iid, out);
+}
+
+static ULONG WINAPI statics2_AddRef(IGeolocatorStatics2 *iface)
+{
+    return factory_AddRef(&impl_from_IGeolocatorStatics2(iface)->IActivationFactory_iface);
+}
+
+static ULONG WINAPI statics2_Release(IGeolocatorStatics2 *iface)
+{
+    return factory_Release(&impl_from_IGeolocatorStatics2(iface)->IActivationFactory_iface);
+}
+
+static HRESULT WINAPI statics2_GetIids(IGeolocatorStatics2 *iface, ULONG *iid_count, IID **iids)
+{
+    if (!iid_count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc(2 * sizeof(IID)))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IGeolocatorStatics;
+    (*iids)[1] = IID_IGeolocatorStatics2;
+    *iid_count = 2;
+    return S_OK;
+}
+
+static HRESULT WINAPI statics2_GetRuntimeClassName(IGeolocatorStatics2 *iface, HSTRING *class_name)
+{
+    return get_class_name(class_name);
+}
+
+static HRESULT WINAPI statics2_GetTrustLevel(IGeolocatorStatics2 *iface, TrustLevel *trust_level)
+{
+    return get_base_trust(trust_level);
+}
+
+/* GUESSED: a default position is recommended when the user's switches turn location off or when
+ * the last attempt found no location service. */
+static HRESULT WINAPI statics2_get_IsDefaultGeopositionRecommended(IGeolocatorStatics2 *iface, boolean *value)
+{
+    TRACE("iface %p, value %p.\n", iface, value);
+
+    if (!value) return E_POINTER;
+    *value = location_denied() || service_unavailable;
+#ifdef SG_MUTANT_GEO_RECOMMEND
+    *value = FALSE;
+#endif
+    return S_OK;
+}
+
+static HRESULT WINAPI statics2_put_DefaultGeoposition(IGeolocatorStatics2 *iface, IReference_BasicGeoposition *value)
+{
+    BasicGeoposition position;
+    HRESULT hr;
+
+    TRACE("iface %p, value %p.\n", iface, value);
+
+    if (value)
+    {
+        if (FAILED(hr = IReference_BasicGeoposition_get_Value(value, &position))) return hr;
+        if (!(position.Latitude >= -90.0 && position.Latitude <= 90.0) ||
+            !(position.Longitude >= -180.0 && position.Longitude <= 180.0))
+            return E_INVALIDARG;
+    }
+    EnterCriticalSection(&default_cs);
+    has_default_geoposition = value != NULL;
+    if (value) default_geoposition = position;
+    LeaveCriticalSection(&default_cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI statics2_get_DefaultGeoposition(IGeolocatorStatics2 *iface, IReference_BasicGeoposition **value)
+{
+    struct bgp_ref *ref;
+
+    TRACE("iface %p, value %p.\n", iface, value);
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    EnterCriticalSection(&default_cs);
+    if (has_default_geoposition && (ref = calloc(1, sizeof(*ref))))
+    {
+        ref->IReference_BasicGeoposition_iface.lpVtbl = &bgp_ref_vtbl;
+        ref->ref = 1;
+        ref->value = default_geoposition;
+        *value = &ref->IReference_BasicGeoposition_iface;
+    }
+    LeaveCriticalSection(&default_cs);
+    return S_OK;
+}
+
+static const IGeolocatorStatics2Vtbl statics2_vtbl =
+{
+    statics2_QueryInterface,
+    statics2_AddRef,
+    statics2_Release,
+    statics2_GetIids,
+    statics2_GetRuntimeClassName,
+    statics2_GetTrustLevel,
+    statics2_get_IsDefaultGeopositionRecommended,
+    statics2_put_DefaultGeoposition,
+    statics2_get_DefaultGeoposition,
+};
+
 static struct geolocator_statics geolocator_statics =
 {
     {&factory_vtbl},
     {&statics_vtbl},
+    {&statics2_vtbl},
     1,
 };
 
@@ -1038,6 +1453,9 @@ HRESULT WINAPI DllGetActivationFactory(HSTRING classid, IActivationFactory **fac
     if (!wcscmp(name, RuntimeClass_Windows_Devices_Geolocation_Geolocator))
         IActivationFactory_QueryInterface(geolocator_factory, &IID_IActivationFactory, (void **)factory);
 
+    else if (!wcscmp(name, RuntimeClass_Windows_Devices_Geolocation_Geopoint))
+        IActivationFactory_QueryInterface(geopoint_factory, &IID_IActivationFactory, (void **)factory);
+
     if (*factory) return S_OK;
     return CLASS_E_CLASSNOTAVAILABLE;
 }
