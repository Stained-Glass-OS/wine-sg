@@ -130,6 +130,10 @@ static HRESULT double_ref_create( DOUBLE value, IReference_DOUBLE **out )
 struct geocoordinate
 {
     IGeocoordinate IGeocoordinate_iface;
+    IGeocoordinateWithPoint IGeocoordinateWithPoint_iface;
+    IGeocoordinateWithPositionData IGeocoordinateWithPositionData_iface;
