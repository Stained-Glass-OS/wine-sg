+/* Latitude is -90..90 and longitude -180..180 (BasicGeoposition documentation); the altitude and
+ * the reference system have to be real values. */
+HRESULT geopoint_create( BasicGeoposition position, AltitudeReferenceSystem altitude_system, UINT32 srid, IGeopoint **out )
+{
+    struct geopoint *impl;
+
+    *out = NULL;
+#ifdef SG_MUTANT_GEO_BOUNDS
+    if (0 ||
+#else
+    if (!(position.Latitude >= -90.0 && position.Latitude <= 90.0) ||
+        !(position.Longitude >= -180.0 && position.Longitude <= 180.0) || position.Altitude != position.Altitude ||
+#endif
+        (UINT32)altitude_system > AltitudeReferenceSystem_Surface)
+        return E_INVALIDARG;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IGeopoint_iface.lpVtbl = &geopoint_vtbl;
+    impl->IGeoshape_iface.lpVtbl = &geoshape_vtbl;
+    impl->ref = 1;
+    impl->position = position;
+    impl->altitude_system = altitude_system;
+    impl->srid = srid;
+    *out = &impl->IGeopoint_iface;
+    return S_OK;
+}
