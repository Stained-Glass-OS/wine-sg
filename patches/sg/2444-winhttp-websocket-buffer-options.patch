From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winhttp: web socket buffer size options are not for the upgraded socket handle

Ground truth from Wine's winhttp test (3 todo_wine marks removed): querying or setting WINHTTP_OPTION_WEB_SOCKET_RECEIVE_BUFFER_SIZE or _SEND_BUFFER_SIZE on the handle WinHttpWebSocketCompleteUpgrade returns is ERROR_WINHTTP_INCORRECT_HANDLE_TYPE; they belong to the request that is upgraded.
---
--- a/dlls/winhttp/request.c
+++ b/dlls/winhttp/request.c
@@ -3434,6 +3434,13 @@ static BOOL socket_query_option( struct object_header *hdr, DWORD option, void *
         case WINHTTP_OPTION_WEB_SOCKET_KEEPALIVE_INTERVAL:
             SetLastError( ERROR_INVALID_PARAMETER );
             return FALSE;
+#ifndef SG_MUTANT_WS_SOCKET_OPTIONS
+        case WINHTTP_OPTION_WEB_SOCKET_RECEIVE_BUFFER_SIZE:
+        case WINHTTP_OPTION_WEB_SOCKET_SEND_BUFFER_SIZE:
+            /* the buffer sizes belong to the request that is upgraded, not to the socket */
+            SetLastError( ERROR_WINHTTP_INCORRECT_HANDLE_TYPE );
+            return FALSE;
+#endif
     }
 
     FIXME( "unimplemented option %lu\n", option );
@@ -3478,6 +3485,12 @@ static BOOL socket_set_option( struct object_header *hdr, DWORD option, void *bu
         TRACE( "WINHTTP_OPTION_WEB_SOCKET_KEEPALIVE_INTERVAL %lu.\n", interval);
         return TRUE;
     }
+#ifndef SG_MUTANT_WS_SOCKET_OPTIONS
+    case WINHTTP_OPTION_WEB_SOCKET_RECEIVE_BUFFER_SIZE:
+    case WINHTTP_OPTION_WEB_SOCKET_SEND_BUFFER_SIZE:
+        SetLastError( ERROR_WINHTTP_INCORRECT_HANDLE_TYPE );
+        return FALSE;
+#endif
     }
 
     FIXME( "unimplemented option %lu\n", option );
--- a/dlls/winhttp/tests/winhttp.c
+++ b/dlls/winhttp/tests/winhttp.c
@@ -3683,16 +3683,16 @@ static void test_websocket(int port)
     size = sizeof(value);
     ret = WinHttpQueryOption(socket, WINHTTP_OPTION_WEB_SOCKET_RECEIVE_BUFFER_SIZE, &value, &size);
     ok(!ret, "got %d\n", ret);
-    todo_wine ok(GetLastError() == ERROR_WINHTTP_INCORRECT_HANDLE_TYPE, "got %lu\n", GetLastError());
+    ok(GetLastError() == ERROR_WINHTTP_INCORRECT_HANDLE_TYPE, "got %lu\n", GetLastError());
 
     value = 65535;
     ret = WinHttpSetOption(socket, WINHTTP_OPTION_WEB_SOCKET_RECEIVE_BUFFER_SIZE, &value, sizeof(DWORD));
     ok(!ret, "got %d\n", ret);
-    todo_wine ok(GetLastError() == ERROR_WINHTTP_INCORRECT_HANDLE_TYPE, "got %lu\n", GetLastError());
+    ok(GetLastError() == ERROR_WINHTTP_INCORRECT_HANDLE_TYPE, "got %lu\n", GetLastError());
 
     ret = WinHttpSetOption(socket, WINHTTP_OPTION_WEB_SOCKET_SEND_BUFFER_SIZE, &value, sizeof(DWORD));
     ok(!ret, "got %d\n", ret);
-    todo_wine ok(GetLastError() == ERROR_WINHTTP_INCORRECT_HANDLE_TYPE, "got %lu\n", GetLastError());
+    ok(GetLastError() == ERROR_WINHTTP_INCORRECT_HANDLE_TYPE, "got %lu\n", GetLastError());
 
     value = 20000;
     ret = WinHttpSetOption(socket, WINHTTP_OPTION_WEB_SOCKET_KEEPALIVE_INTERVAL, &value, 2);
