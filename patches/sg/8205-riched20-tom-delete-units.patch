From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: ITextRange::Delete by any unit; MoveLeft/MoveRight refuse other units.

ITextRange::Delete (and ITextSelection's) deleted counted characters at an insertion point only: a word
(Ctrl+Delete, Ctrl+Backspace), a paragraph or any other unit, and a counted delete of a longer range, were
E_NOTIMPL. Now a longer range goes first and counts as one unit, then COUNT more units after (before) the
point, found by a duplicate range's MoveEnd (MoveStart) in that unit; pDelta counts units with Count's
sign (a count of 0 still gives the characters deleted). ITextSelection::MoveLeft/MoveRight take
tomCharacter or tomWord only, as documented: other units are E_INVALIDARG (were E_NOTIMPL).
---
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -3740,14 +3740,18 @@
     return S_OK;
 }
 
-/* Delete: with a count of 0 the text of the range goes; otherwise, for an
- * insertion point, count characters after it (before it when negative). */
+/* Delete: with a count of 0 the text of the range goes; otherwise it is the Delete key (count > 0) or
+ * Backspace (count < 0) COUNT times in UNIT: a range that is not an insertion point goes first and counts
+ * as one unit, then the units after (before) it (Stained Glass OS, wine-sg 8205: any TOM unit, through a
+ * duplicate range's MoveEnd/MoveStart). */
 static HRESULT textrange_delete(ITextRange *range, struct text_services *services, BOOL selection,
                                 LONG unit, LONG count, LONG *delta)
 {
     ME_TextEditor *editor = services->editor;
-    LONG start, end, len = ME_GetTextLength(editor), from, to;
+    LONG start, end, len = ME_GetTextLength(editor), from, to, units = 0, moved = 0;
+    ITextRange *dup;
     ME_Cursor cursor;
+    HRESULT hr;
 
     if (delta) *delta = 0;
     ITextRange_GetStart(range, &start);
@@ -3756,44 +3760,71 @@
     if (editor->props & TXTBIT_READONLY)
         return E_ACCESSDENIED;
 
-    if (!count)
+    if (!count || start != end)
     {
+        /* the range's own text */
         from = start;
         to = min(end, len);
+        if (to > from)
+        {
+#ifdef SG_MUTANT_DELETE_NOOP
+            return S_OK;
+#endif
+            cursor_from_char_ofs(editor, from, &cursor);
+            ME_InternalDeleteText(editor, &cursor, to - from, FALSE);
+            textranges_update_ranges(services, from, to, RANGE_UPDATE_DELETE);
+            units = 1;
+        }
+        else if (!count) return S_FALSE;
+        if (!count || count == 1 || count == -1)
+        {
+            if (selection) set_selection_cursors(editor, from, from);
+            /* (a count of 0 gives the characters deleted) */
+            if (delta) *delta = count ? count : to - from;
+            return S_OK;
+        }
+        count += count > 0 ? -1 : 1;
+        start = end = from;
     }
-    else if (unit != tomCharacter)
-    {
-        FIXME("unit %ld is not supported\n", unit);
-        return E_NOTIMPL;
-    }
-    else if (start != end)
-    {
-        FIXME("counted delete of a range that is not an insertion point\n");
-        return E_NOTIMPL;
-    }
-    else if (count > 0)
+
+    /* COUNT units from the insertion point */
+    if (unit == tomCharacter && (count == tomForward || count == tomBackward))
     {
-        from = start;
-        to = count == tomForward || count > len - start ? len : start + count;
+        if (count > 0) { from = start; to = ME_GetTextLength(editor); }
+        else { from = 0; to = start; }
+        moved = count > 0 ? to - from : from - to;
     }
     else
     {
-        to = start;
-        from = count == tomBackward || -count > start ? 0 : start + count;
+        if (FAILED(hr = ITextRange_GetDuplicate(range, &dup))) return hr;
+        ITextRange_SetRange(dup, start, start);
+#ifndef SG_MUTANT_DELETE_UNIT_CHARS
+        if (count > 0) hr = ITextRange_MoveEnd(dup, unit, count, &moved);
+        else hr = ITextRange_MoveStart(dup, unit, count, &moved);
+#else
+        if (count > 0) hr = ITextRange_MoveEnd(dup, tomCharacter, count, &moved);
+        else hr = ITextRange_MoveStart(dup, tomCharacter, count, &moved);
+#endif
+        ITextRange_GetStart(dup, &from);
+        ITextRange_GetEnd(dup, &to);
+        ITextRange_Release(dup);
+        if (FAILED(hr)) return hr;
     }
-
-    if (to <= from)
-        return S_FALSE;
-
+    to = min(to, (LONG)ME_GetTextLength(editor));
+    if (to > from)
+    {
 #ifdef SG_MUTANT_DELETE_NOOP
-    return S_OK;
+        return S_OK;
 #endif
-    cursor_from_char_ofs(editor, from, &cursor);
-    ME_InternalDeleteText(editor, &cursor, to - from, FALSE);
-    textranges_update_ranges(services, from, to, RANGE_UPDATE_DELETE);
+        cursor_from_char_ofs(editor, from, &cursor);
+        ME_InternalDeleteText(editor, &cursor, to - from, FALSE);
+        textranges_update_ranges(services, from, to, RANGE_UPDATE_DELETE);
+        units += moved < 0 ? -moved : moved;
+    }
+    if (!units) return S_FALSE;
     if (selection)
         set_selection_cursors(editor, from, from);
-    if (delta) *delta = count < 0 ? from - to : to - from;
+    if (delta) *delta = count < 0 ? -units : units;
     return S_OK;
 }
 
@@ -9812,11 +9843,11 @@
     if (!This->services)
         return CO_E_RELEASED;
 
+    /* documented: tomCharacter or tomWord, anything else is not valid (Stained Glass OS, wine-sg 8205) */
     if (unit != tomCharacter && unit != tomWord)
     {
-        FIXME("unit %ld is not supported\n", unit);
         if (delta) *delta = 0;
-        return E_NOTIMPL;
+        return E_INVALIDARG;
     }
     return selection_move(This->services->editor, VK_LEFT, unit == tomWord, count, extend, delta);
 }
@@ -9831,11 +9862,11 @@
     if (!This->services)
         return CO_E_RELEASED;
 
+    /* documented: tomCharacter or tomWord, anything else is not valid (Stained Glass OS, wine-sg 8205) */
     if (unit != tomCharacter && unit != tomWord)
     {
-        FIXME("unit %ld is not supported\n", unit);
         if (delta) *delta = 0;
-        return E_NOTIMPL;
+        return E_INVALIDARG;
     }
     return selection_move(This->services->editor, VK_RIGHT, unit == tomWord, count, extend, delta);
 }
