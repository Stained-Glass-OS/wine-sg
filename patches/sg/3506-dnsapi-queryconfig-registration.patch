From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dnsapi: DnsQueryConfig registration settings (3506)

dnsapi: DnsQueryConfig registration settings

DnsConfigPrimaryHostNameRegistrationEnabled, DnsConfigAdapterHostNameRegistrationEnabled and
DnsConfigAddressRegistrationMaxCount answer a DWORD (registration off, one address).
---
--- a/dlls/dnsapi/query.c
+++ b/dlls/dnsapi/query.c
@@ -599,13 +599,27 @@ DNS_STATUS WINAPI DnsQueryConfig( DNS_CONFIG_TYPE config, DWORD flag, const WCHA
     case DnsConfigPrimaryDomainName_W:
         return get_hostname_w( ComputerNameDnsDomain, buffer, len );
 
+    case DnsConfigPrimaryHostNameRegistrationEnabled:
+    case DnsConfigAdapterHostNameRegistrationEnabled:
+    case DnsConfigAddressRegistrationMaxCount:
+    {
+        /* DWORD values; nothing here registers host names or addresses in DNS */
+        DWORD value = config == DnsConfigAddressRegistrationMaxCount ? 1 : 0;
+
+        if (!buffer || *len < sizeof(DWORD))
+        {
+            *len = sizeof(DWORD);
+            return buffer ? ERROR_MORE_DATA : ERROR_SUCCESS;
+        }
+        *(DWORD *)buffer = value;
+        *len = sizeof(DWORD);
+        return ERROR_SUCCESS;
+    }
+
     case DnsConfigAdapterDomainName_A:
     case DnsConfigAdapterDomainName_W:
     case DnsConfigAdapterDomainName_UTF8:
     case DnsConfigAdapterInfo:
-    case DnsConfigPrimaryHostNameRegistrationEnabled:
-    case DnsConfigAdapterHostNameRegistrationEnabled:
-    case DnsConfigAddressRegistrationMaxCount:
         FIXME( "unimplemented config type %d\n", config );
         break;
 
