From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] widl: a forward-declared runtimeclass is registered only from the file compiled (7504)

6536 made widl register a runtimeclass that classes.idl only forward-declares
(Windows.Media.Playback's), testing that the declaration is in the file being
compiled by comparing its location with input_name. But input_name follows the
preprocessor's #line markers, so it names the #included file too, and every
forward declaration in an included IDL was registered:
windows.networking.connectivity.idl's "runtimeclass Uri;" (and HostName,
EndpointPair) registered those classes to windows.networking.connectivity.dll,
which registers after iertutil, so Windows.Foundation.Uri's factory was
that DLL's: CreateUri failed, and MSIX/winget installs with it
(AddPackageAsync E_INVALIDARG). widl now keeps the compiled file's own name
and compares against it. A prefix registered by the faulty build is repaired
by wineboot -u (the classes are registered again by their DLLs).
---
diff --git a/tools/widl/parser.y b/tools/widl/parser.y
index d9ec81b..8bb92b6 100644
--- a/tools/widl/parser.y
+++ b/tools/widl/parser.y
@@ -428,7 +428,16 @@ gbl_statements
 	| gbl_statements apicontract_def	{ $$ = append_statement($1, make_statement_type_decl($2));
 						  reg_type($2, $2->name, current_namespace, 0); }
 	| gbl_statements runtimeclass ';'       { statement_t *ref = make_statement_reference($2);
+#ifndef SG_MUTANT_TYPEREF_ANY_FILE
+						  /* Stained Glass OS: the file being compiled itself, not one it
+						   * #includes; input_name follows the preprocessor's #line, so it
+						   * named the included file too (windows.networking.connectivity.idl's
+						   * "runtimeclass Uri;" registered Uri to that DLL) */
+						  ref->in_main_input = @2.input_name && main_input_name &&
+						                       !strcmp( @2.input_name, main_input_name );
+#else
 						  ref->in_main_input = @2.input_name && !strcmp( @2.input_name, input_name );
+#endif
 						  $$ = append_statement($1, ref); reg_type($2, $2->name, current_namespace, 0); }
 	| gbl_statements runtimeclass_def       { $$ = append_statement($1, make_statement_type_decl($2));
 	                                          reg_type($2, $2->name, current_namespace, 0); }
diff --git a/tools/widl/widl.c b/tools/widl/widl.c
index e92f9a8..f318e63 100644
--- a/tools/widl/widl.c
+++ b/tools/widl/widl.c
@@ -114,6 +114,7 @@ int use_abi_namespace = 0;
 static int stdinc = 1;
 
 char *input_name;
+char *main_input_name;  /* Stained Glass OS: the file being compiled (input_name follows #line) */
 char *idl_name;
 char *acf_name;
 char *header_name;
@@ -771,6 +772,7 @@ int main(int argc,char *argv[])
     else
     {
       input_name = xstrdup( files.str[0] );
+      main_input_name = xstrdup( files.str[0] );
       idl_name = get_basename( input_name );
     }
   }
diff --git a/tools/widl/widl.h b/tools/widl/widl.h
index 31bb2c8..38dab93 100644
--- a/tools/widl/widl.h
+++ b/tools/widl/widl.h
@@ -52,6 +52,7 @@ extern int interpreted_mode;
 extern int use_abi_namespace;
 
 extern char *input_name;
+extern char *main_input_name;
 extern char *idl_name;
 extern char *acf_name;
 extern char *header_name;
