 /******************************************************************************
  *     OpenSCManagerW   (sechost.@)
  */
+/* the names under which this machine is addressed; any other machine would be
+ * reached over the network, where there is no service control manager to call */
+static BOOL is_local_machine_name( const WCHAR *name )
+{
+    WCHAR buffer[MAX_COMPUTERNAME_LENGTH + 1], dns[256];
+    DWORD size, len;
+
+    if (!name || !*name) return TRUE;
+    if (name[0] == '\\' && name[1] == '\\') name += 2;
+    if (!*name || !wcscmp( name, L"." ) || !wcsicmp( name, L"localhost" )) return TRUE;
+    if (!wcsncmp( name, L"127.", 4 ) || !wcscmp( name, L"::1" ) || !wcscmp( name, L"[::1]" )) return TRUE;
+
+    size = ARRAY_SIZE(buffer);
+    if (GetComputerNameW( buffer, &size ))
+    {
+        len = wcslen( buffer );
+        if (!wcsnicmp( name, buffer, len ) && (!name[len] || name[len] == '.')) return TRUE;
+    }
+    size = ARRAY_SIZE(dns);
+    if (GetComputerNameExW( ComputerNameDnsFullyQualified, dns, &size ) && !wcsicmp( name, dns )) return TRUE;
+    return FALSE;
+}
