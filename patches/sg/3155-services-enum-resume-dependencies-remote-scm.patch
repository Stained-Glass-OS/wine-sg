+/* The dependencies as one string for the wire (a string cannot carry the
+ * embedded NULs of a multi-string): the services first, then the groups with
+ * their '+' prefix, each name followed by a \001; the client turns it back
+ * into the multi-string QueryServiceConfig returns. */
+static WCHAR *dependencies_to_wire(const struct service_entry *entry)
+{
+    const WCHAR *p;
+    SIZE_T len = 0;
+    WCHAR *ret, *out;
+
+    for (p = entry->dependOnServices; p && *p; p += lstrlenW(p) + 1) len += lstrlenW(p) + 1;
+    for (p = entry->dependOnGroups; p && *p; p += lstrlenW(p) + 1) len += lstrlenW(p) + 2;
+#ifdef SG_MUTANT_NO_DEPS
+    return NULL;
+#endif
+    if (!len) return NULL;
+    if (!(ret = malloc((len + 1) * sizeof(WCHAR)))) return NULL;
+    out = ret;
+    for (p = entry->dependOnServices; p && *p; p += lstrlenW(p) + 1)
+    {
+        lstrcpyW(out, p);
+        out += lstrlenW(out);
+        *out++ = 1;
+    }
+    for (p = entry->dependOnGroups; p && *p; p += lstrlenW(p) + 1)
+    {
+        *out++ = '+';
+        lstrcpyW(out, p);
+        out += lstrlenW(out);
+        *out++ = 1;
+    }
+    *out = 0;
+    return ret;
+}
