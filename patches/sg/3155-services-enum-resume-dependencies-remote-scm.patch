From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 03:43:16 -0700
Subject: [PATCH] services: enumeration with a resume handle, dependencies in
 QueryServiceConfig, OpenSCManager on other machines

EnumServicesStatusW/A and EnumServicesStatusExW/A return as many services as
fit the buffer with ERROR_MORE_DATA, the size still needed for the others and
a resume handle that continues where the first piece stopped (the manager
skips the services already handed out). QueryServiceConfigW/A return the
dependencies (services, then groups with their '+') as a multi-string;
OpenSCManager of a machine that is not this one fails with
RPC_S_SERVER_UNAVAILABLE. The Event Log service has its load order group.
Removes 12 todo_wine in advapi32's service tests.

diff --git a/dlls/advapi32/service.c b/dlls/advapi32/service.c
index 63308be..6c8770e 100644
--- a/dlls/advapi32/service.c
+++ b/dlls/advapi32/service.c
@@ -50,6 +50,74 @@ BOOL WINAPI UnlockServiceDatabase( SC_LOCK lock )
     return TRUE;
 }
 
+/* All the services left from the resume index on, as the wide process-info
+ * entries (the manager hands over the whole remainder).  The ANSI variants and
+ * EnumServicesStatusW pick the entries that fit the caller's buffer from it. */
+static BOOL enum_services_fetch( SC_HANDLE manager, SC_ENUM_TYPE level, DWORD type, DWORD state,
+                                 DWORD start, const WCHAR *group, ENUM_SERVICE_STATUS_PROCESSW **ret,
+                                 DWORD *count )
+{
+    ENUM_SERVICE_STATUS_PROCESSW *list = NULL;
+    DWORD need = 0, resume, tries;
+
+    *ret = NULL;
+    *count = 0;
+    resume = start;
+    if (EnumServicesStatusExW( manager, level, type, state, NULL, 0, &need, count, &resume, group ))
+        return TRUE;  /* nothing left */
+    if (GetLastError() != ERROR_MORE_DATA) return FALSE;
+
+    for (tries = 0; tries < 8; tries++)
+    {
+        DWORD err;
+        ENUM_SERVICE_STATUS_PROCESSW *tmp = realloc( list, max( need, sizeof(*list) ) );
+        if (!tmp) { free( list ); SetLastError( ERROR_NOT_ENOUGH_MEMORY ); return FALSE; }
+        list = tmp;
+        resume = start;
+        if (EnumServicesStatusExW( manager, level, type, state, (BYTE *)list, need, &need, count, &resume, group ))
+            break;
+        err = GetLastError();
+        if (err == ERROR_MORE_DATA && !*count) continue;  /* the list grew: try again with the new size */
+        if (err == ERROR_MORE_DATA) break;  /* got what fits, the rest is picked up below */
+        free( list );
+        SetLastError( err );
+        return FALSE;
+    }
+    *ret = list;
+    return TRUE;
+}
+
+static DWORD enum_wide_size( const WCHAR *s )
+{
+    return s ? (lstrlenW( s ) + 1) * sizeof(WCHAR) : 0;
+}
+
+static DWORD enum_ansi_size( const WCHAR *s )
+{
+    return s ? WideCharToMultiByte( CP_ACP, 0, s, -1, NULL, 0, NULL, NULL ) : 0;
+}
+
+/* fits as many leading entries as the buffer holds (the ANSI strings are
+ * shorter than the wide ones); the size still needed for the others is
+ * counted in wide characters for both flavours, like the manager reports it */
+static DWORD enum_fit( const ENUM_SERVICE_STATUS_PROCESSW *list, DWORD count, DWORD entry_size, BOOL ansi,
+                       DWORD size, DWORD *rest )
+{
+    DWORD i, fit = 0, used = 0;
+
+    *rest = 0;
+    for (i = 0; i < count; i++)
+    {
+        DWORD n = entry_size, w = entry_size;
+        w += enum_wide_size( list[i].lpServiceName ) + enum_wide_size( list[i].lpDisplayName );
+        if (ansi) n += enum_ansi_size( list[i].lpServiceName ) + enum_ansi_size( list[i].lpDisplayName );
+        else n = w;
+        if (fit == i && used + n <= size) { used += n; fit++; }
+        else *rest += w;
+    }
+    return fit;
+}
+
