+    if (file == INVALID_HANDLE_VALUE)
+    {
+        DWORD err = GetLastError();
+        return (err == ERROR_FILE_NOT_FOUND || err == ERROR_PATH_NOT_FOUND) ? STG_E_FILENOTFOUND :
