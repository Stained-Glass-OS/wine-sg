     ILockBytes* plkbyt)
 {
     ITStorageImpl *This = impl_from_IITStorage(iface);
-    FIXME("%p\n", This);
-    return E_NOTIMPL;
+    ULARGE_INTEGER pos = {{0}};
+    char magic[4];
+    ULONG got = 0;
+    HRESULT hr;
+
+    TRACE("%p %p\n", This, plkbyt);
+
