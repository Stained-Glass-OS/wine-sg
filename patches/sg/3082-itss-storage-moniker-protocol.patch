From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 18:19:21 -0700
Subject: [PATCH] itss: read-only storage and stream semantics, a working
 moniker, protocol info

IStorage on a CHM file: Stat, CopyTo (streams and storages one level at a time),
Commit/Revert, and STG_E_ACCESSDENIED for everything that would change the archive;
IEnumSTATSTG Clone and Next for more than one element; IStream Write/SetSize
(access denied), CopyTo, Commit, Revert, LockRegion/UnlockRegion, Clone, and the
name in Stat. IITStorage: StgIsStorageFile, StgIsStorageILockBytes, StgSetTimes,
Compact. The ms-its moniker answers IMoniker/IPersistStream queries and implements
Load/Save/GetSizeMax, BindToObject, Reduce, ComposeWith, Enum, IsEqual, Hash,
IsRunning, GetTimeOfLastChange, Inverse, CommonPrefixWith, RelativePathTo,
ParseDisplayName and IsSystemMoniker; GetDisplayName no longer overruns its buffer.
The protocol implements Continue, Abort, Seek, ParseUrl(canonicalize), CompareUrl
and QueryInfo.

diff --git a/dlls/itss/itss.c b/dlls/itss/itss.c
index 010c01d..236d28a 100644
--- a/dlls/itss/itss.c
+++ b/dlls/itss/itss.c
@@ -255,8 +255,25 @@ static HRESULT WINAPI ITStorageImpl_StgIsStorageFile(
     const WCHAR* pwcsName)
 {
     ITStorageImpl *This = impl_from_IITStorage(iface);
-    FIXME("%p\n", This);
-    return E_NOTIMPL;
+    char magic[4];
+    DWORD got;
+    HANDLE file;
+    BOOL ok;
+
+    TRACE("%p %s\n", This, debugstr_w(pwcsName));
+
+    if (!pwcsName) return STG_E_INVALIDNAME;
+    file = CreateFileW( pwcsName, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        DWORD err = GetLastError();
+        return (err == ERROR_FILE_NOT_FOUND || err == ERROR_PATH_NOT_FOUND) ? STG_E_FILENOTFOUND :
+               HRESULT_FROM_WIN32( err );
+    }
+    ok = ReadFile( file, magic, sizeof(magic), &got, NULL ) && got == sizeof(magic) && !memcmp( magic, "ITSF", 4 );
+    CloseHandle( file );
+    return ok ? S_OK : S_FALSE;
 }
 
