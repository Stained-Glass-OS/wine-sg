 static HRESULT WINAPI ITS_IMonikerImpl_Load(
     IMoniker* iface,
     IStream* pStm)
 {
-    FIXME("\n");
-    return E_NOTIMPL;
+    ITS_IMonikerImpl *This = impl_from_IMoniker(iface);
+    WCHAR *names[2] = { NULL, NULL };
+    DWORD len, i;
+    ULONG read;
+    HRESULT hr = S_OK;
+
+    TRACE("%p %p\n", This, pStm);
+
+    if (!pStm) return STG_E_INVALIDPOINTER;
+    /* the file name and the name of the object, each as a length in characters and the characters */
+    for (i = 0; i < 2; i++)
+    {
+        hr = IStream_Read( pStm, &len, sizeof(len), &read );
+        if (SUCCEEDED(hr) && read != sizeof(len)) hr = STG_E_READFAULT;
+        if (SUCCEEDED(hr) && len > 0x10000) hr = E_FAIL;
+        if (FAILED(hr)) break;
+        if (!(names[i] = HeapAlloc( GetProcessHeap(), 0, (len + 1) * sizeof(WCHAR) ))) { hr = E_OUTOFMEMORY; break; }
+        hr = IStream_Read( pStm, names[i], len * sizeof(WCHAR), &read );
+        if (SUCCEEDED(hr) && read != len * sizeof(WCHAR)) hr = STG_E_READFAULT;
+        if (FAILED(hr)) break;
+        names[i][len] = 0;
+    }
+    if (FAILED(hr))
+    {
+        HeapFree( GetProcessHeap(), 0, names[0] );
+        HeapFree( GetProcessHeap(), 0, names[1] );
+        return hr;
+    }
+    HeapFree( GetProcessHeap(), 0, This->szFile );
+    HeapFree( GetProcessHeap(), 0, This->szHtml );
+    This->szFile = names[0];
+    This->szHtml = names[1];
+    return S_OK;
 }
 
