+    *lphRasConn = NULL;
+    ret = sg_dial( lpRasDialParams->szEntryName, lpRasDialParams->szPassword, lphRasConn );
+    if (ret == ~0u)
+    {
+        FIXME("no sg-netctl: RAS is not available\n");
+        return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    }
+    /* Dialled synchronously; a caller that asked to be notified hears the
+     * outcome, as it would from an asynchronous dial. */
+    if (lpvNotifier)
+    {
+        RASCONNSTATE state = ret ? RASCS_Disconnected : RASCS_Connected;
+        if (dwNotifierType == 0xffffffff)
+        {
+            static UINT msg;
+            if (!msg) msg = RegisterWindowMessageA( RASDIALEVENT );
+            PostMessageW( lpvNotifier, msg, state, ret );
+        }
+        else if (dwNotifierType == 0) ((RASDIALFUNC)lpvNotifier)( 0, state, ret );
+        else if (dwNotifierType == 1) ((RASDIALFUNC1)lpvNotifier)( *lphRasConn, 0, state, ret, 0 );
+        return 0;
+    }
+    return ret;
 }
 
