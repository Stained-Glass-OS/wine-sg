+++ b/programs/rasdial/main.c
@@ -0,0 +1,204 @@
+/*
+ * rasdial: dial, list and hang up remote access (VPN) connections
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ *   RASDIAL                                     the connections that are up
+ *   RASDIAL entryname [username [password|*]] [/DOMAIN:domain] [/PHONEBOOK:file]
+ *   RASDIAL [entryname] /DISCONNECT
+ *
+ * A thin client of rasapi32 (RasEnumConnections, RasDial, RasHangUp), as the
+ * Windows command is. The exit status is 0 or the RAS error.
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <windef.h>
+#include <winbase.h>
+#include <winnls.h>
+#include <wincon.h>
+#include <ras.h>
+#include <raserror.h>
+
+static void out( const WCHAR *fmt, ... )
+{
+    WCHAR buf[2048];
+    va_list args;
+    DWORD n;
+    char *a;
+    int len;
+
+    va_start( args, fmt );
+    n = vswprintf( buf, ARRAY_SIZE(buf), fmt, args );
+    va_end( args );
+    if (WriteConsoleW( GetStdHandle( STD_OUTPUT_HANDLE ), buf, n, &n, NULL )) return;
+    len = WideCharToMultiByte( GetConsoleOutputCP(), 0, buf, -1, NULL, 0, NULL, NULL );
+    if (!(a = malloc( len ))) return;
+    WideCharToMultiByte( GetConsoleOutputCP(), 0, buf, -1, a, len, NULL, NULL );
+    WriteFile( GetStdHandle( STD_OUTPUT_HANDLE ), a, len - 1, &n, NULL );
+    free( a );
+}
+
+static int error( DWORD err )
+{
+    WCHAR text[512];
+
+    if (RasGetErrorStringW( err, text, ARRAY_SIZE(text) )) swprintf( text, ARRAY_SIZE(text), L"Error %lu.", err );
+    out( L"Remote Access error %lu - %ls\r\n\r\nFor more help on this error:\r\n"
+         L"        Type 'hh netcfg.chm'\r\n        In help, click Troubleshooting, then Error Messages, then %lu\r\n\r\n",
+         err, text, err );
+    return err;
+}
+
+static RASCONNW *connections( DWORD *count )
+{
+    RASCONNW *c = calloc( 1, sizeof(*c) );
+    DWORD size = sizeof(*c), err;
+
+    *count = 0;
+    if (!c) return NULL;
+    c->dwSize = sizeof(*c);
+    err = RasEnumConnectionsW( c, &size, count );
+    if (err == ERROR_BUFFER_TOO_SMALL)
+    {
+        free( c );
+        if (!(c = calloc( 1, size ))) return NULL;
+        c->dwSize = sizeof(*c);
+        err = RasEnumConnectionsW( c, &size, count );
+    }
+    if (err) { free( c ); *count = 0; return NULL; }
+    return c;
+}
+
+static int list(void)
+{
+    DWORD i, n;
+    RASCONNW *c = connections( &n );
+
+    if (!n) out( L"No connections\r\n" );
+    else
+    {
+        out( L"Connected to\r\n" );
+        for (i = 0; i < n; i++) out( L"%ls\r\n", c[i].szEntryName );
+    }
+    out( L"Command completed successfully.\r\n" );
+    free( c );
+    return 0;
+}
+
+static int disconnect( const WCHAR *entry )
+{
+    DWORD i, n, err = 0, done = 0;
+    RASCONNW *c = connections( &n );
+
+    for (i = 0; i < n; i++)
+    {
+        if (entry && wcsicmp( c[i].szEntryName, entry )) continue;
+        if ((err = RasHangUpW( c[i].hRasConn ))) break;
+        done++;
+    }
+    free( c );
+    if (err) return error( err );
+    if (!done)
+    {
+        out( entry ? L"You are not connected to %ls.\r\n" : L"No connections\r\n", entry );
+        return ERROR_NO_CONNECTION;
+    }
+    out( L"Command completed successfully.\r\n" );
+    return 0;
+}
+
+static void read_password( WCHAR *pw, DWORD size )
+{
+    HANDLE in = GetStdHandle( STD_INPUT_HANDLE );
+    DWORD mode = 0, n = 0;
+    char a[PWLEN + 2];
+
+    out( L"Enter the password to connect to the server: " );
+    if (GetConsoleMode( in, &mode ))
+    {
+        SetConsoleMode( in, mode & ~ENABLE_ECHO_INPUT );
+        if (!ReadConsoleW( in, pw, size - 1, &n, NULL )) n = 0;
+        SetConsoleMode( in, mode );
+        pw[n] = 0;
+    }
+    else
+    {
+        if (!ReadFile( in, a, sizeof(a) - 1, &n, NULL )) n = 0;
+        a[n] = 0;
+        MultiByteToWideChar( GetConsoleCP(), 0, a, -1, pw, size );
+        SecureZeroMemory( a, sizeof(a) );
+    }
+    pw[wcscspn( pw, L"\r\n" )] = 0;
+    out( L"\r\n" );
+}
+
+int __cdecl wmain( int argc, WCHAR *argv[] )
+{
+    RASDIALPARAMSW params = { sizeof(params) };
+    const WCHAR *phonebook = NULL, *pos[3] = { NULL };
+    HRASCONN conn = NULL;
+    BOOL hangup = FALSE;
+    int i, npos = 0;
+    DWORD err;
+
+    for (i = 1; i < argc; i++)
+    {
+        if (argv[i][0] == '/')
+        {
+            if (!wcsicmp( argv[i], L"/disconnect" ) || !wcsicmp( argv[i], L"/d" )) hangup = TRUE;
+            else if (!wcsnicmp( argv[i], L"/domain:", 8 ))
+                lstrcpynW( params.szDomain, argv[i] + 8, ARRAY_SIZE(params.szDomain) );
+            else if (!wcsnicmp( argv[i], L"/phonebook:", 11 )) phonebook = argv[i] + 11;
+            else if (!wcsnicmp( argv[i], L"/phone:", 7 ) || !wcsnicmp( argv[i], L"/callback:", 10 ) ||
+                     !wcsicmp( argv[i], L"/prefixsuffix" )) continue;
+            else
+            {
+                out( L"USAGE:\r\n        rasdial entryname [username [password|*]] [/DOMAIN:domain]\r\n"
+                     L"                [/PHONE:phonenumber] [/CALLBACK:callbacknumber]\r\n"
+                     L"                [/PHONEBOOK:phonebookfile] [/PREFIXSUFFIX]\r\n\r\n"
+                     L"        rasdial [entryname] /DISCONNECT\r\n\r\n        rasdial\r\n\r\n"
+                     L"Command completed successfully.\r\n" );
+                return 0;
+            }
+        }
+        else if (npos < 3) pos[npos++] = argv[i];
+    }
+
+    if (hangup) return disconnect( pos[0] );
+    if (!npos) return list();
+
+    lstrcpynW( params.szEntryName, pos[0], ARRAY_SIZE(params.szEntryName) );
+    if (pos[1]) lstrcpynW( params.szUserName, pos[1], ARRAY_SIZE(params.szUserName) );
+    if (pos[2] && !wcscmp( pos[2], L"*" )) read_password( params.szPassword, ARRAY_SIZE(params.szPassword) );
+    else if (pos[2]) lstrcpynW( params.szPassword, pos[2], ARRAY_SIZE(params.szPassword) );
+
+    out( L"Connecting to %ls...\r\n", params.szEntryName );
+    err = RasDialW( NULL, phonebook, &params, 0, NULL, &conn );
+    SecureZeroMemory( params.szPassword, sizeof(params.szPassword) );
+    if (err)
+    {
+        if (conn) RasHangUpW( conn );
+        return error( err );
+    }
+    out( L"Verifying username and password...\r\nRegistering your computer on the network...\r\n"
+         L"Successfully connected to %ls.\r\nCommand completed successfully.\r\n", params.szEntryName );
+    return 0;
+}
