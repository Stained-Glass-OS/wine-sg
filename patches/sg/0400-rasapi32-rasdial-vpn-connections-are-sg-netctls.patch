 WINE_DEFAULT_DEBUG_CHANNEL(ras);
 
+#ifndef REN_AllUsers
+#define REN_AllUsers 1
+#endif
+#ifndef RASCF_AllUsers
+#define RASCF_AllUsers 1
+#endif
+#ifndef RASDIALEVENT
+#define RASDIALEVENT "RasDialEvent"
+typedef void (WINAPI *RASDIALFUNC)( UINT, RASCONNSTATE, DWORD );
+typedef void (WINAPI *RASDIALFUNC1)( HRASCONN, UINT, RASCONNSTATE, DWORD, DWORD );
+#endif
+
+/* Stained Glass OS: VPN connections are the Linux side's -- NetworkManager's
+ * WireGuard and OpenVPN connections behind sg-netctl (sg-session), which
+ * decides who may do what: anyone with a session may dial and hang up the
+ * connections an administrator added for all users. Here they are RAS
+ * phone-book entries, as a VPN connection is on Windows: enumerated, dialled
+ * by name, listed while connected, hung up. A plain Wine without sg-netctl
+ * keeps the old behaviour (no entries, no connections). */
+
+struct sg_vpn
+{
+    WCHAR    uuid[40];
+    WCHAR    kind[16];    /* openvpn, wireguard */
+    BOOL     connected;
+    WCHAR    name[RAS_MaxEntryName + 1];
+    HRASCONN handle;
+};
+
+/* A connection's handle is derived from its NetworkManager UUID, so that
+ * another process (rasdial /disconnect) names the same connection by it. */
+static HRASCONN sg_vpn_handle( const WCHAR *uuid )
+{
+    UINT hash = 2166136261u;
+    for (; *uuid; uuid++) hash = (hash ^ *uuid) * 16777619u;
+    return (HRASCONN)(ULONG_PTR)((hash & 0x3ffffff0) | 0x4000000c);
+}
+
+/* sg-netctl vpn list: -1 no sg-netctl (plain Wine), else the number found */
+static int sg_vpn_list( struct sg_vpn **out )
+{
+    static const WCHAR *argv[] = { L"vpn", L"list" };
+    struct sgnet_reply r;
+    struct sg_vpn *v;
+    int i, n = 0, ret;
+
+    *out = NULL;
+    if ((ret = sgnet_request( argv, 2, &r )) < 0) return -1;
+    if (!ret) { sgnet_free( &r ); return 0; }
+    if (!(v = calloc( r.count + 1, sizeof(*v) ))) { sgnet_free( &r ); return 0; }
+    for (i = 0; i < r.count; i++)
+    {
+        /* VPN <uuid>\t<kind>\t<state>\t<name> */
+        WCHAR *f[4], *p = r.lines[i] + 4;
+        int k;
+        if (wcsncmp( r.lines[i], L"VPN ", 4 )) continue;
+        for (k = 0; k < 4 && p; k++)
+        {
+            f[k] = p;
+            if (k < 3 && (p = wcschr( p, '\t' ))) *p++ = 0;
+        }
+        if (k < 4 || !p) continue;
+        lstrcpynW( v[n].uuid, f[0], ARRAY_SIZE(v[n].uuid) );
+        lstrcpynW( v[n].kind, f[1], ARRAY_SIZE(v[n].kind) );
+        v[n].connected = !wcscmp( f[2], L"connected" );
+        lstrcpynW( v[n].name, f[3], ARRAY_SIZE(v[n].name) );
+        v[n].handle = sg_vpn_handle( v[n].uuid );
+        n++;
+    }
+    sgnet_free( &r );
+    *out = v;
+    return n;
+}
+
+static const WCHAR *sg_vpn_device( const struct sg_vpn *v )
+{
+    return !wcscmp( v->kind, L"wireguard" ) ? L"WireGuard" : L"OpenVPN";
+}
+
+static DWORD sg_vpn_error( const struct sgnet_reply *r )
+{
+    if (!wcscmp( r->kind, L"notfound" )) return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+    if (!wcscmp( r->kind, L"auth" )) return ERROR_AUTHENTICATION_FAILURE;
+    if (!wcscmp( r->kind, L"denied" )) return ERROR_ACCESS_DENIED;
+    if (!wcscmp( r->kind, L"invalid" )) return ERROR_INVALID_PARAMETER;
+    return ERROR_PORT_NOT_AVAILABLE;
+}
+
+/* RASENTRYNAME as Windows 2000 and later have it: dwFlags and the phone
+ * book's path after the name; callers pass either size */
+#define SG_ENTRY_FLAGS_OFF(unicode) (unicode ? (FIELD_OFFSET(RASENTRYNAMEW, szEntryName[RAS_MaxEntryName + 1]) + 3) / 4 * 4 \
+                                             : (FIELD_OFFSET(RASENTRYNAMEA, szEntryName[RAS_MaxEntryName + 1]) + 3) / 4 * 4)
+#define SG_ENTRY_V500(unicode) ((SG_ENTRY_FLAGS_OFF(unicode) + 4 + (MAX_PATH + 1) * (unicode ? sizeof(WCHAR) : 1) + 3) / 4 * 4)
+
+static DWORD sg_enum_entries( void *buf, DWORD *size, DWORD *count, BOOL unicode )
+{
+    struct sg_vpn *v;
+    DWORD stride, need, i;
+    BYTE *p = buf;
+    int n;
+
+    if (!size || !count) return ERROR_INVALID_PARAMETER;
+    if ((n = sg_vpn_list( &v )) < 0) return ~0u;
+    stride = buf ? *(DWORD *)buf : SG_ENTRY_V500(unicode);
+    if (buf && stride != (unicode ? sizeof(RASENTRYNAMEW) : sizeof(RASENTRYNAMEA)) && stride != SG_ENTRY_V500(unicode))
+    {
+        free( v );
+        return ERROR_INVALID_SIZE;
+    }
+    need = stride * n;
+    *count = n;
+    if (!buf || *size < need)
+    {
+        *size = need;
+        free( v );
+        return n ? ERROR_BUFFER_TOO_SMALL : 0;
+    }
+    for (i = 0; i < n; i++, p += stride)
+    {
+        memset( p, 0, stride );
+        *(DWORD *)p = stride;
+        if (unicode) lstrcpynW( ((RASENTRYNAMEW *)p)->szEntryName, v[i].name, RAS_MaxEntryName + 1 );
+        else WideCharToMultiByte( CP_ACP, 0, v[i].name, -1, ((RASENTRYNAMEA *)p)->szEntryName, RAS_MaxEntryName + 1, NULL, NULL );
+        if (stride == SG_ENTRY_V500(unicode))
+            *(DWORD *)(p + SG_ENTRY_FLAGS_OFF(unicode)) = REN_AllUsers;  /* an all-users entry */
+    }
+    *size = need;
+    free( v );
+    return 0;
+}
+
+static DWORD sg_enum_connections( void *buf, DWORD *size, DWORD *count, BOOL unicode )
+{
+    struct sg_vpn *v;
+    DWORD stride, min, need, i, n = 0;
+    BYTE *p = buf;
+    int all;
+
+    if (!size || !count) return ERROR_INVALID_PARAMETER;
+    if ((all = sg_vpn_list( &v )) < 0) return ~0u;
+    for (i = 0; i < all; i++) if (v[i].connected) v[n++] = v[i];
+    stride = buf ? *(DWORD *)buf : unicode ? sizeof(RASCONNW) : sizeof(RASCONNA);
+    min = unicode ? FIELD_OFFSET(RASCONNW, szPhonebook) : FIELD_OFFSET(RASCONNA, szPhonebook);
+    if (buf && (stride < min || stride > (unicode ? sizeof(RASCONNW) : sizeof(RASCONNA))))
+    {
+        free( v );
+        return ERROR_INVALID_SIZE;
+    }
+    need = stride * n;
+    *count = n;
+    if (!buf || *size < need)
+    {
+        *size = need;
+        free( v );
+        return n ? ERROR_BUFFER_TOO_SMALL : 0;
+    }
+    for (i = 0; i < n; i++, p += stride)
+    {
+        memset( p, 0, stride );
+        if (unicode)
+        {
+            RASCONNW c = { sizeof(c) };
+            c.hRasConn = v[i].handle;
+            lstrcpynW( c.szEntryName, v[i].name, ARRAY_SIZE(c.szEntryName) );
+            wcscpy( c.szDeviceType, L"vpn" );
+            lstrcpynW( c.szDeviceName, sg_vpn_device( &v[i] ), ARRAY_SIZE(c.szDeviceName) );
+            c.dwFlags = RASCF_AllUsers;
+            memcpy( p, &c, stride );
+        }
+        else
+        {
+            RASCONNA c = { sizeof(c) };
+            c.hRasConn = v[i].handle;
+            WideCharToMultiByte( CP_ACP, 0, v[i].name, -1, c.szEntryName, sizeof(c.szEntryName), NULL, NULL );
+            strcpy( c.szDeviceType, "vpn" );
+            WideCharToMultiByte( CP_ACP, 0, sg_vpn_device( &v[i] ), -1, c.szDeviceName, sizeof(c.szDeviceName), NULL, NULL );
+            c.dwFlags = RASCF_AllUsers;
+            memcpy( p, &c, stride );
+        }
+        *(DWORD *)p = stride;
+    }
+    *size = need;
+    free( v );
+    return 0;
+}
+
+/* dial: sg-netctl vpn connect NAME [--password-stdin] -- the password on the
+ * program's standard input, never its command line */
+static DWORD sg_dial( const WCHAR *entry, const WCHAR *password, HRASCONN *handle )
+{
+    const WCHAR *argv[4] = { L"vpn", L"connect", entry, L"--password-stdin" };
+    struct sgnet_reply r;
+    struct sg_vpn *v;
+    char *input = NULL;
+    DWORD err = 0;
+    int i, n, ret;
+
+    if ((n = sg_vpn_list( &v )) < 0) return ~0u;
+    for (i = 0; i < n; i++) if (!wcsicmp( v[i].name, entry )) break;
+    if (i == n) { free( v ); return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY; }
+    argv[2] = v[i].uuid;
+    if (password && password[0])
+    {
+        int len = WideCharToMultiByte( CP_UTF8, 0, password, -1, NULL, 0, NULL, NULL );
+        if ((input = malloc( len + 1 )))
+        {
+            WideCharToMultiByte( CP_UTF8, 0, password, -1, input, len, NULL, NULL );
+            strcat( input, "\n" );
+        }
+    }
+    ret = sgnet_request_input( argv, input ? 4 : 3, input, &r );
+    if (input) { SecureZeroMemory( input, strlen( input ) ); free( input ); }
+    if (ret > 0) *handle = v[i].handle;
+    else err = sg_vpn_error( &r );
+    TRACE( "%s: %s %s\n", debugstr_w(entry), debugstr_w(r.kind), debugstr_w(r.message) );
+    sgnet_free( &r );
+    free( v );
+    return err;
+}
+
+/* the connection a handle names (connected or not): its index in v, or -1 */
+static int sg_find_handle( HRASCONN h, struct sg_vpn **v )
+{
+    int i, n = sg_vpn_list( v );
+    for (i = 0; i < n; i++) if ((*v)[i].handle == h) return i;
+    return n < 0 ? -2 : -1;
+}
+
+static DWORD sg_hang_up( HRASCONN h )
+{
+    const WCHAR *argv[3] = { L"vpn", L"disconnect" };
+    struct sgnet_reply r;
+    struct sg_vpn *v;
+    DWORD err = 0;
+    int i = sg_find_handle( h, &v );
+
+    if (i == -2) return ~0u;
+    if (i < 0) { free( v ); return ERROR_INVALID_HANDLE; }
+    argv[2] = v[i].uuid;
+    if (sgnet_request( argv, 3, &r ) <= 0) err = sg_vpn_error( &r );
+    sgnet_free( &r );
+    free( v );
+    return err;
+}
+
+static const struct { DWORD code; const WCHAR *text; } sg_ras_errors[] =
+{
+    { ERROR_BUFFER_TOO_SMALL, L"The buffer is too small." },
+    { ERROR_CANNOT_FIND_PHONEBOOK_ENTRY, L"The system could not find the phone book entry for this connection." },
+    { ERROR_INVALID_SIZE, L"The structure size is incorrect." },
+    { ERROR_NO_CONNECTION, L"The connection was terminated." },
+    { ERROR_PORT_NOT_AVAILABLE, L"The VPN connection could not be established." },
+    { ERROR_AUTHENTICATION_FAILURE, L"The remote connection was denied because the user name and password combination you provided is not recognized, or the selected authentication protocol is not permitted on the remote access server." },
+    { ERROR_ACCESS_DENIED, L"Access is denied." },
+    { ERROR_INVALID_HANDLE, L"The handle is invalid." },
+    { ERROR_INVALID_PARAMETER, L"The parameter is incorrect." },
+};
