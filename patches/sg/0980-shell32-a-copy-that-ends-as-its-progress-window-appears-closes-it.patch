From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: a copy that ends as its progress window appears closes it

In the regression walk (2026-10-05) a paste into the same folder, after
"Keep both" in the Replace or Skip Files dialog, left the copy's progress
window at "100% complete" for good; Cancel said "Cancelling..." for good,
and File Explorer's paste never returned. The copy itself was done.

The progress window is made on a thread of its own half a second into the
operation. The operation's end set its "done" event and posted WM_CLOSE to
the window -- if there was one yet. When it ended in the moment between
the thread deciding to show the window and the window being made (the
"Keep both" answer restarts the half-second clock, so a small copy ends
right there), there was none: nothing ever closed the window, and the end
waited for its thread forever.

Now the thread looks at the "done" event once the window is made (the end
sets the event before it looks for the window, so one of them always sees
the other) and goes at once if the operation is over; the window's timer
closes it too once the operation is over, and Cancel on an operation that
is already over closes the window instead of waiting for a cancel that
cannot come. SG_FILEOP_SHOW_DELAY (milliseconds) widens that moment, for
the gate.

Test: test/fileoprace-gate.sh with test/fileoprace-probe.c: copies with
the progress window, eight that end as the window is being made (with
SG_FILEOP_SHOW_DELAY=1500) and 24 of about half a second -- all return and
leave no window; mutant SG_MUTANT_FILEOP_LOST_CLOSE hangs ("HANG 5").
---
--- a/dlls/shell32/fileopdlg.c
+++ b/dlls/shell32/fileopdlg.c
@@ -212,6 +212,14 @@
     {
         WCHAR title[64], headline[256], pct[64], name[MAX_PATH + 16], items[128], remaining[64];
         int percent;
+#ifndef SG_MUTANT_FILEOP_LOST_CLOSE
+        /* the operation is over: go, whatever happened to its WM_CLOSE */
+        if (WaitForSingleObject(p->done, 0) == WAIT_OBJECT_0)
+        {
+            DestroyWindow(hwnd);
+            return 0;
+        }
+#endif
         progress_texts(p, title, headline, pct, name, items, remaining, &percent);
         SetWindowTextW(hwnd, title);
         InvalidateRect(hwnd, NULL, FALSE);
@@ -270,6 +278,14 @@
     case WM_COMMAND:
         if (LOWORD(wp) == IDCANCEL)
         {
+#ifndef SG_MUTANT_FILEOP_LOST_CLOSE
+            /* nothing left to cancel: the window goes */
+            if (WaitForSingleObject(p->done, 0) == WAIT_OBJECT_0)
+            {
+                DestroyWindow(hwnd);
+                return 0;
+            }
+#endif
             InterlockedExchange(&p->cancelled, 1);
             EnableWindow((HWND)lp, FALSE);
             InvalidateRect(hwnd, NULL, FALSE);
@@ -291,7 +307,7 @@
     struct fileop_progress *p = arg;
     WNDCLASSW wc = { 0 };
     RECT rc, owner;
-    HWND cancel;
+    HWND cancel, hwnd;
     MSG msg;
     HFONT font;
     int w = scale(480), h = scale(236);
@@ -302,6 +318,12 @@
         if (WaitForSingleObject(p->done, 50) == WAIT_OBJECT_0) return 0;
         if (!p->pausing && elapsed(p) >= PROGRESS_DELAY) break;
     }
+    {
+        /* gates: widen the moment between deciding to show the window and
+         * showing it, where an operation that ends then was lost */
+        WCHAR delay[16];
+        if (GetEnvironmentVariableW(L"SG_FILEOP_SHOW_DELAY", delay, ARRAY_SIZE(delay))) Sleep(wcstoul(delay, NULL, 10));
+    }
 
     wc.lpfnWndProc = progress_proc;
     wc.hInstance = shell32_hInstance;
@@ -322,10 +344,26 @@
         owner.left += (owner.right - owner.left - (rc.right - rc.left)) / 2;
         owner.top += (owner.bottom - owner.top - (rc.bottom - rc.top)) / 3;
     }
-    p->hwnd = CreateWindowExW(WS_EX_DLGMODALFRAME, L"SGFileOperation", L"0% complete",
-                              WS_POPUP | WS_CAPTION | WS_SYSMENU,
-                              max(0, owner.left), max(0, owner.top), rc.right - rc.left, rc.bottom - rc.top,
-                              NULL, NULL, shell32_hInstance, p);
+    hwnd = CreateWindowExW(WS_EX_DLGMODALFRAME, L"SGFileOperation", L"0% complete",
+                           WS_POPUP | WS_CAPTION | WS_SYSMENU,
+                           max(0, owner.left), max(0, owner.top), rc.right - rc.left, rc.bottom - rc.top,
+                           NULL, NULL, shell32_hInstance, p);
+    if (!hwnd) return 0;
+    InterlockedExchangePointer((void **)&p->hwnd, hwnd);
+#ifndef SG_MUTANT_FILEOP_LOST_CLOSE
+    /* The operation may have ended while the window was being made: its end
+     * found no window to close, and waited for this thread forever -- the
+     * dialog stayed at "100% complete", Cancel said "Cancelling..." and File
+     * Explorer hung (the regression walk, after "Keep both"). The end sets
+     * its event before it looks for the window; this looks at the event
+     * after the window is there: one of them sees the other. */
+    if (WaitForSingleObject(p->done, 0) == WAIT_OBJECT_0)
+    {
+        DestroyWindow(hwnd);
+        p->hwnd = NULL;
+        return 0;
+    }
+#endif
     font = ui_font(0, 0);
     cancel = CreateWindowExW(0, L"Button", L"Cancel", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON,
                              w - scale(20) - scale(88), h - scale(16) - scale(28), scale(88), scale(28),
@@ -394,7 +432,10 @@
     if (p->depth) { p->depth--; return; }
     TlsSetValue(progress_tls, NULL);
     SetEvent(p->done);
-    if (p->hwnd) PostMessageW(p->hwnd, WM_CLOSE, 0, 0);
+    {
+        HWND hwnd = InterlockedCompareExchangePointer((void **)&p->hwnd, NULL, NULL);
+        if (hwnd) PostMessageW(hwnd, WM_CLOSE, 0, 0);
+    }
     if (p->thread)
     {
         WaitForSingleObject(p->thread, INFINITE);
