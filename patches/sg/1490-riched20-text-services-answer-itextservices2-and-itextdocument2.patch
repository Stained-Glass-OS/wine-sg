+DEFINE_THISCALL_WRAPPER(fnTextSrv_TxGetNaturalSize2,40)
+HRESULT __thiscall fnTextSrv_TxGetNaturalSize2( ITextServices *iface, DWORD aspect, HDC draw,
+                                                HDC target, DVTARGETDEVICE *td, DWORD mode,
+                                                const SIZEL *extent, LONG *width, LONG *height, LONG *ascent )
+{
+    struct text_services *services = impl_from_ITextServices( iface );
+    ME_Paragraph *para;
+    HRESULT hr;
+
+    TRACE( "%p: ascent %p\n", services, ascent );
+
+    hr = fnTextSrv_TxGetNaturalSize( iface, aspect, draw, target, td, mode, extent, width, height );
+    if (FAILED( hr ) || !ascent) return hr;
+
+    /* the first line's baseline, from the top of the text */
+    *ascent = 0;
+    if ((para = editor_first_para( services->editor )) && para->nRows)
+    {
+        ME_Row *row = para_first_row( para );
+        if (row) *ascent = row->pt.y + row->nBaseline;
+    }
+    return hr;
+}
+
+/* Draws the text into a premultiplied BGRA bitmap and that onto the Direct2D target.
+ * The text is laid out by GDI as for TxDraw; it is drawn twice, on black and on white,
+ * which gives each pixel's coverage (the difference) and its premultiplied colour
+ * (the drawing on black), so text drawn on a transparent target keeps its edges. */
+static HRESULT draw_d2d( ITextServices *iface, ID2D1RenderTarget *target, const RECTL *bounds,
+                         RECT *update, LONG view_id )
+{
+    BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER) }};
+    D2D1_BITMAP_PROPERTIES props;
+    D2D1_SIZE_U size;
+    D2D1_RECT_F dst;
+    ID2D1Bitmap *bitmap = NULL;
+    BYTE *bits[2] = { NULL, NULL };
+    HBITMAP dib[2] = { NULL, NULL };
+    HDC dc = NULL;
+    HRESULT hr = S_OK;
+    float dpi_x, dpi_y;
+    LONG w = bounds->right - bounds->left, h = bounds->bottom - bounds->top;
+    DWORD *black, *white;
+    int i, pass;
+
+    if (w <= 0 || h <= 0) return S_OK;
+
+    info.bmiHeader.biWidth = w;
+    info.bmiHeader.biHeight = -h;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+
+    if (!(dc = CreateCompatibleDC( NULL ))) return E_OUTOFMEMORY;
+    for (pass = 0; pass < 2; pass++)
+    {
+        HGDIOBJ old;
+        if (!(dib[pass] = CreateDIBSection( dc, &info, DIB_RGB_COLORS, (void **)&bits[pass], NULL, 0 )))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+        memset( bits[pass], pass ? 0xff : 0, w * h * 4 );
+        old = SelectObject( dc, dib[pass] );
+        SetViewportOrgEx( dc, -bounds->left, -bounds->top, NULL );
+        hr = fnTextSrv_TxDraw( iface, DVASPECT_CONTENT, 0, NULL, NULL, dc, NULL, bounds, NULL, update,
+                               NULL, 0, view_id );
+        SetViewportOrgEx( dc, 0, 0, NULL );
+        GdiFlush();
+        SelectObject( dc, old );
+        if (FAILED( hr )) goto done;
+    }
+
+    black = (DWORD *)bits[0];
+    white = (DWORD *)bits[1];
+    for (i = 0; i < w * h; i++)
+    {
+        BYTE b[3], a = 0;
+        int c;
+        for (c = 0; c < 3; c++)
+        {
+            int k = (black[i] >> (8 * c)) & 0xff, wh = (white[i] >> (8 * c)) & 0xff;
+            int cov = 255 - (wh > k ? wh - k : 0);
+            b[c] = k;
+            if (cov > a) a = cov;
+        }
+#ifdef SG_MUTANT_RICHED_D2D_OPAQUE
+        a = 255;
+#endif
+        for (c = 0; c < 3; c++) if (b[c] > a) b[c] = a;
+        black[i] = (a << 24) | (b[2] << 16) | (b[1] << 8) | b[0];
+    }
+
+    ID2D1RenderTarget_GetDpi( target, &dpi_x, &dpi_y );
+    if (dpi_x <= 0.0f) dpi_x = 96.0f;
+    if (dpi_y <= 0.0f) dpi_y = 96.0f;
+    size.width = w;
+    size.height = h;
+    props.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    props.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+    props.dpiX = dpi_x;
+    props.dpiY = dpi_y;
+    hr = ID2D1RenderTarget_CreateBitmap( target, size, bits[0], w * 4, &props, &bitmap );
+    if (FAILED( hr ))
+    {
+        WARN( "CreateBitmap failed %#lx\n", hr );
+        goto done;
+    }
+    dst.left = bounds->left * 96.0f / dpi_x;
+    dst.top = bounds->top * 96.0f / dpi_y;
+    dst.right = bounds->right * 96.0f / dpi_x;
+    dst.bottom = bounds->bottom * 96.0f / dpi_y;
+    ID2D1RenderTarget_DrawBitmap( target, bitmap, &dst, 1.0f, D2D1_BITMAP_INTERPOLATION_MODE_NEAREST_NEIGHBOR, NULL );
+    ID2D1Bitmap_Release( bitmap );
+
+done:
+    for (pass = 0; pass < 2; pass++) if (dib[pass]) DeleteObject( dib[pass] );
+    DeleteDC( dc );
+    return hr;
+}
+
+DEFINE_THISCALL_WRAPPER(fnTextSrv_TxDrawD2D,20)
+HRESULT __thiscall fnTextSrv_TxDrawD2D( ITextServices *iface, ID2D1RenderTarget *target, const RECTL *bounds,
+                                        RECT *update, LONG view_id )
+{
+    struct text_services *services = impl_from_ITextServices( iface );
+    RECTL rect;
+
+    TRACE( "%p: target %p, bounds %s, update %s, view %ld\n", services, target,
+           wine_dbgstr_rect( (RECT *)bounds ), wine_dbgstr_rect( update ), view_id );
+
+    if (!target) return E_INVALIDARG;
+    if (view_id == TXTVIEW_ACTIVE && services->editor->freeze_count) return E_UNEXPECTED;
+    if (!bounds)
+    {
+        if (!services->editor->in_place_active) return E_INVALIDARG;
+        rect.left = services->editor->rcFormat.left - services->editor->selofs;
+        rect.top = services->editor->rcFormat.top;
+        rect.right = services->editor->rcFormat.right;
+        rect.bottom = services->editor->rcFormat.bottom;
+        bounds = &rect;
+    }
+    return draw_d2d( iface, target, bounds, update, view_id );
+}
