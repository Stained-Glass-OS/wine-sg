+    THISCALLMETHOD_(HRESULT,OnTxSetCursor)( THIS_ DWORD dwDrawAspect, LONG lindex, void* pvAspect, DVTARGETDEVICE* ptd,
+        HDC hdcDraw, HDC hicTargetDev, LPCRECT lprcClient, INT x, INT y ) PURE;
+    THISCALLMETHOD_(HRESULT,TxQueryHitPoint)( THIS_ DWORD dwDrawAspect, LONG lindex, void* pvAspect, DVTARGETDEVICE* ptd,
+        HDC hdcDraw, HDC hicTargetDev, LPCRECT lprcClient, INT x, INT y, DWORD* pHitResult ) PURE;
+    THISCALLMETHOD_(HRESULT,OnTxInPlaceActivate)( THIS_ LPCRECT prcClient ) PURE;
+    THISCALLMETHOD_(HRESULT,OnTxInPlaceDeactivate)( THIS ) PURE;
+    THISCALLMETHOD_(HRESULT,OnTxUIActivate)( THIS ) PURE;
+    THISCALLMETHOD_(HRESULT,OnTxUIDeactivate)( THIS ) PURE;
+    THISCALLMETHOD_(HRESULT,TxGetText)( THIS_ BSTR* pbstrText ) PURE;
+    THISCALLMETHOD_(HRESULT,TxSetText)( THIS_ LPCWSTR pszText ) PURE;
+    THISCALLMETHOD_(HRESULT,TxGetCurTargetX)( THIS_ LONG* x ) PURE;
