+        HDC hdcDraw, HDC hicTargetDev, LPCRECTL lprcBounds, LPCRECTL lprcWBounds, LPRECT lprcUpdate,
+        BOOL (CALLBACK * pfnContinue)(DWORD), DWORD dwContinue, LONG lViewId ) PURE;
