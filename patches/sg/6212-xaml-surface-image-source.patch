diff --git a/dlls/windows.ui.xaml/imaging.c b/dlls/windows.ui.xaml/imaging.c
index 5313fd9..4809271 100644
--- a/dlls/windows.ui.xaml/imaging.c
+++ b/dlls/windows.ui.xaml/imaging.c
@@ -32,6 +32,8 @@
 #define WIDL_using_Windows_Foundation
 #include "private.h"
 #include "wincodec.h"
+#include "d3d11.h"
+#include "d2d1_1.h"
 #include "windows.foundation.h"
 
 HRESULT WINAPI WICCreateImagingFactory_Proxy( UINT version, IWICImagingFactory **factory );
@@ -181,6 +183,14 @@ struct image_source
     BYTE *pixels;                   /* premultiplied BGRA, width * 4 per row */
     struct handler_list opened, failed;
     BOOL bitmap_image;
+    /* a SurfaceImageSource: the program draws with its device into what BeginDraw gives it */
+    struct xiface INative_iface, INativeD2D_iface;
+    IUnknown *device;
+    ID2D1DeviceContext *draw_context;     /* what a draw goes to: a D2D bitmap ... */
+    ID2D1Bitmap1 *draw_target;
+    ID3D11Texture2D *draw_texture;        /* ... or a texture */
+    RECT update;
+    BOOL drawing, context_drawing;      /* the D2D context is in BeginDraw (handed out), not only its bitmap */
 };
 
 static struct image_source *source_from_iface( struct xiface *iface )
@@ -218,13 +228,14 @@ done:
 /* an image source's pixels (no copy), or FALSE */
 BOOL xaml_image_pixels( IInspectable *obj, UINT *width, UINT *height, const BYTE **pixels );
 
-static const struct xclass software_source_class, bitmap_image_class;
+static const struct xclass software_source_class, bitmap_image_class, surface_source_class;
 
 static struct image_source *source_from_inspectable( IInspectable *obj )
 {
     struct dobj *d = dobj_from_inspectable( obj );
 
-    if (!d || (d->obj.cls != &software_source_class && d->obj.cls != &bitmap_image_class)) return NULL;
+    if (!d || (d->obj.cls != &software_source_class && d->obj.cls != &bitmap_image_class &&
+               d->obj.cls != &surface_source_class)) return NULL;
     return CONTAINING_RECORD( d, struct image_source, d );
 }
 
@@ -464,6 +475,10 @@ static void source_destroy( struct xobj *obj )
 {
     struct image_source *source = CONTAINING_RECORD( obj, struct image_source, d.obj );
 
+    if (source->draw_context) ID2D1DeviceContext_Release( source->draw_context );
+    if (source->draw_target) ID2D1Bitmap1_Release( source->draw_target );
+    if (source->draw_texture) ID3D11Texture2D_Release( source->draw_texture );
+    if (source->device) IUnknown_Release( source->device );
     free( source->pixels );
     handlers_clear( &source->opened );
     handlers_clear( &source->failed );
@@ -568,6 +583,313 @@ static struct xfactory bitmap_image_factory_obj = { { &xfactory_vtbl }, L"Window
 IActivationFactory *software_bitmap_source_factory = &software_source_factory_obj.IActivationFactory_iface;
 IActivationFactory *bitmap_image_factory = &bitmap_image_factory_obj.IActivationFactory_iface;
 
+/* ---- SurfaceImageSource: the program draws into a surface with its own Direct3D or Direct2D device
+ * (ISurfaceImageSourceNative, ...NativeWithD2D); what it drew is read back at EndDraw into the
+ * pixels an Image shows ---- */
+
+static const GUID IID_ISurfaceImageSourceNative_x = { 0xf2e9edc1, 0xd307, 0x4525, { 0x98, 0x86, 0x0f, 0xaf, 0xaa, 0x44, 0x16, 0x3c } };
+static const GUID IID_ISurfaceImageSourceNativeWithD2D_x = { 0x54298223, 0x41e1, 0x4a41, { 0x9c, 0x08, 0x02, 0xe8, 0x25, 0x68, 0x64, 0xa1 } };
+
+static const GUID IID_ID2D1Device_x = { 0x47dd575d, 0xac05, 0x4cdd, { 0x80, 0x49, 0x9b, 0x02, 0xcd, 0x16, 0xf4, 0x4c } };
+static const GUID IID_ID2D1DeviceContext_x = { 0xe8f7fe7a, 0x191c, 0x466d, { 0xad, 0x95, 0x97, 0x56, 0x78, 0xbd, 0xa9, 0x98 } };
+static const GUID IID_IDXGIDevice_x = { 0x54ec77fa, 0x1377, 0x44e6, { 0x8c, 0x32, 0x88, 0xfd, 0x5f, 0x44, 0xc8, 0x4c } };
+static const GUID IID_IDXGISurface_x = { 0xcafcb56c, 0x6ac3, 0x4889, { 0xbf, 0x47, 0x9e, 0x23, 0xbb, 0xd2, 0x60, 0xec } };
+static const GUID IID_ID3D11Device_x = { 0xdb6f6ddb, 0xac77, 0x4e88, { 0x82, 0x53, 0x81, 0x9d, 0xf9, 0xbb, 0xf1, 0x40 } };
+static const void *surface_kind_vtbl[] = { XIFACE_COMMON };
+
+static void surface_end_draw_objects( struct image_source *source )
+{
+    if (source->draw_context) ID2D1DeviceContext_Release( source->draw_context );
+    if (source->draw_target) ID2D1Bitmap1_Release( source->draw_target );
+    if (source->draw_texture) ID3D11Texture2D_Release( source->draw_texture );
+    source->draw_context = NULL;
+    source->draw_target = NULL;
+    source->draw_texture = NULL;
+    source->drawing = source->context_drawing = FALSE;
+}
+
+static HRESULT surface_set_device( struct image_source *source, IUnknown *device )
+{
+    TRACE( "%p, %p\n", source, device );
+    if (source->drawing) return E_FAIL;
+    if (device) IUnknown_AddRef( device );
+    if (source->device) IUnknown_Release( source->device );
+    source->device = device;
+    return S_OK;
+}
+
+/* the update rectangle's rows of a mapped image into the source's pixels */
+static void surface_take( struct image_source *source, const BYTE *bits, UINT pitch )
+{
+    UINT width = source->update.right - source->update.left, y;
+
+    for (y = 0; y < (UINT)(source->update.bottom - source->update.top); y++)
+        memcpy( source->pixels + ((size_t)(source->update.top + y) * source->width + source->update.left) * 4,
+                bits + (size_t)y * pitch, width * 4 );
+    xaml_invalidate_visuals();
+}
+
+static HRESULT surface_begin( struct image_source *source, const RECT *rect, REFIID iid, void **out, POINT *offset )
+{
+    D2D1_SIZE_U size;
+    const BYTE *start;
+    UINT pitch;
+    ID2D1Device *d2d = NULL;
+    IDXGIDevice *dxgi = NULL;
+    ID3D11Device *d3d = NULL;
+    HRESULT hr;
+
+    TRACE( "%p, %s, %s\n", source, wine_dbgstr_rect( rect ), debugstr_guid( iid ) );
+
+    if (!out || !offset) return E_POINTER;
+    *out = NULL;
+#ifdef SG_MUTANT_NO_SURFACE_DRAW
+    return E_NOTIMPL;
+#endif
+    if (rect->left < 0 || rect->top < 0 || rect->right > (LONG)source->width || rect->bottom > (LONG)source->height ||
+        rect->left >= rect->right || rect->top >= rect->bottom) return E_INVALIDARG;
+    if (source->drawing || !source->device) return E_FAIL;
+    size.width = rect->right - rect->left;
+    size.height = rect->bottom - rect->top;
+    pitch = source->width * 4;
+    start = source->pixels + ((size_t)rect->top * source->width + rect->left) * 4;   /* what is there already */
+
+    if (FAILED(IUnknown_QueryInterface( source->device, &IID_ID2D1Device_x, (void **)&d2d )))
+        IUnknown_QueryInterface( source->device, &IID_IDXGIDevice_x, (void **)&dxgi );
+
+    if (IsEqualGUID( iid, &IID_ID2D1DeviceContext_x ))
+    {
+        D2D1_BITMAP_PROPERTIES1 props = { { DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED }, 96.0f, 96.0f,
+                                          D2D1_BITMAP_OPTIONS_TARGET };
+
+        if (!d2d && dxgi && FAILED(hr = D2D1CreateDevice( dxgi, NULL, &d2d ))) goto done;
+        if (!d2d) { hr = E_INVALIDARG; goto done; }
+        if (FAILED(hr = ID2D1Device_CreateDeviceContext( d2d, D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &source->draw_context ))) goto done;
+        if (FAILED(hr = ID2D1DeviceContext_CreateBitmap( source->draw_context, size, start, pitch, &props, &source->draw_target )))
+        {
+            surface_end_draw_objects( source );
+            goto done;
+        }
+        ID2D1DeviceContext_SetTarget( source->draw_context, (ID2D1Image *)source->draw_target );
+        ID2D1DeviceContext_BeginDraw( source->draw_context );
+        source->context_drawing = TRUE;
+        ID2D1DeviceContext_AddRef( source->draw_context );
+        *out = source->draw_context;
+    }
+    else if (IsEqualGUID( iid, &IID_IDXGISurface_x ) && d2d)
+    {
+        /* a Direct2D device: the surface of a bitmap made on it, so it is on the device's own Direct3D device */
+        D2D1_BITMAP_PROPERTIES1 props = { { DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED }, 96.0f, 96.0f,
+                                          D2D1_BITMAP_OPTIONS_TARGET };
+        IDXGISurface *surface = NULL;
+
+        if (FAILED(hr = ID2D1Device_CreateDeviceContext( d2d, D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &source->draw_context ))) goto done;
+        if (FAILED(hr = ID2D1DeviceContext_CreateBitmap( source->draw_context, size, start, pitch, &props, &source->draw_target )) ||
+            FAILED(hr = ID2D1Bitmap1_GetSurface( source->draw_target, &surface )))
+        {
+            surface_end_draw_objects( source );
+            goto done;
+        }
+        *out = surface;
+    }
+    else if (IsEqualGUID( iid, &IID_IDXGISurface_x ))
+    {
+        D3D11_TEXTURE2D_DESC desc = { size.width, size.height, 1, 1, DXGI_FORMAT_B8G8R8A8_UNORM, { 1, 0 },
+                                      D3D11_USAGE_DEFAULT, D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE };
+        D3D11_SUBRESOURCE_DATA data = { start, pitch };
+
+        if (!dxgi || FAILED(hr = IDXGIDevice_QueryInterface( dxgi, &IID_ID3D11Device_x, (void **)&d3d )))
+        {
+            hr = E_INVALIDARG;   /* a surface needs a Direct3D device */
+            goto done;
+        }
+        if (FAILED(hr = ID3D11Device_CreateTexture2D( d3d, &desc, &data, &source->draw_texture ))) goto done;
+        if (FAILED(hr = ID3D11Texture2D_QueryInterface( source->draw_texture, &IID_IDXGISurface_x, out )))
+        {
+            surface_end_draw_objects( source );
+            goto done;
+        }
+    }
+    else
+    {
+        FIXME( "%s not given\n", debugstr_guid( iid ) );
+        hr = E_NOINTERFACE;
+        goto done;
+    }
+    source->update = *rect;
+    source->drawing = TRUE;
+    offset->x = offset->y = 0;
+    hr = S_OK;
+done:
+    if (d3d) ID3D11Device_Release( d3d );
+    if (d2d) ID2D1Device_Release( d2d );
+    if (dxgi) IDXGIDevice_Release( dxgi );
+    return hr;
+}
+
+static HRESULT surface_end( struct image_source *source )
+{
+    HRESULT hr = S_OK;
+
+    TRACE( "%p\n", source );
+    if (!source->drawing) return E_FAIL;
+    if (source->draw_context)
+    {
+        D2D1_BITMAP_PROPERTIES1 props = { { DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED }, 96.0f, 96.0f,
+                                          D2D1_BITMAP_OPTIONS_CPU_READ | D2D1_BITMAP_OPTIONS_CANNOT_DRAW };
+        D2D1_SIZE_U size = { source->update.right - source->update.left, source->update.bottom - source->update.top };
+        D2D1_MAPPED_RECT mapped;
+        ID2D1Bitmap1 *cpu = NULL;
+
+        if (source->context_drawing) ID2D1DeviceContext_EndDraw( source->draw_context, NULL, NULL );
+        if (SUCCEEDED(hr = ID2D1DeviceContext_CreateBitmap( source->draw_context, size, NULL, 0, &props, &cpu )) &&
+            SUCCEEDED(hr = ID2D1Bitmap1_CopyFromBitmap( cpu, NULL, (ID2D1Bitmap *)source->draw_target, NULL )) &&
+            SUCCEEDED(hr = ID2D1Bitmap1_Map( cpu, D2D1_MAP_OPTIONS_READ, &mapped )))
+        {
+            surface_take( source, mapped.bits, mapped.pitch );
+            ID2D1Bitmap1_Unmap( cpu );
+        }
+        if (cpu) ID2D1Bitmap1_Release( cpu );
+    }
+    else if (source->draw_texture)
+    {
+        D3D11_TEXTURE2D_DESC desc;
+        D3D11_MAPPED_SUBRESOURCE mapped;
+        ID3D11Texture2D *staging = NULL;
+        ID3D11DeviceContext *context = NULL;
+        ID3D11Device *device = NULL;
+
+        ID3D11Texture2D_GetDesc( source->draw_texture, &desc );
+        desc.Usage = D3D11_USAGE_STAGING;
+        desc.BindFlags = 0;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        ID3D11Texture2D_GetDevice( source->draw_texture, &device );
+        ID3D11Device_GetImmediateContext( device, &context );
+        if (SUCCEEDED(hr = ID3D11Device_CreateTexture2D( device, &desc, NULL, &staging )))
+        {
+            ID3D11DeviceContext_CopyResource( context, (ID3D11Resource *)staging, (ID3D11Resource *)source->draw_texture );
+            if (SUCCEEDED(hr = ID3D11DeviceContext_Map( context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &mapped )))
+            {
+                surface_take( source, mapped.pData, mapped.RowPitch );
+                ID3D11DeviceContext_Unmap( context, (ID3D11Resource *)staging, 0 );
+            }
+            ID3D11Texture2D_Release( staging );
+        }
+        ID3D11DeviceContext_Release( context );
+        ID3D11Device_Release( device );
+    }
+    surface_end_draw_objects( source );
+    return hr;
+}
+
+static struct image_source *surface_from_native( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct image_source, d.obj );
+}
+
+static HRESULT WINAPI native_SetDevice( struct xiface *iface, IUnknown *device )
+{
+    return surface_set_device( surface_from_native( iface ), device );
+}
+
+static HRESULT WINAPI native_BeginDraw( struct xiface *iface, RECT rect, void **surface, POINT *offset )
+{
+    return surface_begin( surface_from_native( iface ), &rect, &IID_IDXGISurface_x, surface, offset );
+}
+
+static HRESULT WINAPI native_EndDraw( struct xiface *iface )
+{
+    return surface_end( surface_from_native( iface ) );
+}
+
+static HRESULT WINAPI native_d2d_BeginDraw( struct xiface *iface, const RECT *rect, REFIID iid, void **out, POINT *offset )
+{
+    if (!rect) return E_POINTER;
+    return surface_begin( surface_from_native( iface ), rect, iid, out, offset );
+}
+
+/* drawing from several threads is not done here: nothing to suspend */
+static HRESULT WINAPI native_d2d_SuspendDraw( struct xiface *iface ) { return S_OK; }
+static HRESULT WINAPI native_d2d_ResumeDraw( struct xiface *iface ) { return S_OK; }
+
+static const void *surface_native_vtbl[] =
+{
+    xiface_QueryInterface, xiface_AddRef, xiface_Release, native_SetDevice, native_BeginDraw, native_EndDraw,
+};
+static const void *surface_native_d2d_vtbl[] =
+{
+    xiface_QueryInterface, xiface_AddRef, xiface_Release, native_SetDevice, native_d2d_BeginDraw, native_EndDraw,
+    native_d2d_SuspendDraw, native_d2d_ResumeDraw,
+};
+
+static const struct xiface_entry surface_source_ifaces[] =
+{
+    { &IID_ISurfaceImageSource, offsetof(struct image_source, IKind_iface) },
+    { &IID_IImageSource, offsetof(struct image_source, IImageSource_iface) },
+    { &IID_ISurfaceImageSourceNative_x, offsetof(struct image_source, INative_iface) },
+    { &IID_ISurfaceImageSourceNativeWithD2D_x, offsetof(struct image_source, INativeD2D_iface) },
+    DOBJ_IFACES(struct dobj),
+};
+
+static const struct xclass surface_source_class =
+{
+    L"Windows.UI.Xaml.Media.Imaging.SurfaceImageSource", surface_source_ifaces, ARRAY_SIZE(surface_source_ifaces), source_destroy,
+};
+
+static HRESULT WINAPI surface_factory_CreateInstanceWithDimensionsAndOpacity( struct xfiface *iface, INT32 width, INT32 height,
+        boolean opaque, IInspectable *outer, IInspectable **inner, IInspectable **value )
+{
+    struct image_source *source;
+
+    TRACE( "%d x %d, opaque %d, outer %p\n", width, height, opaque, outer );
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    if (width <= 0 || height <= 0 || width > 16384 || height > 16384) return E_INVALIDARG;
+    imaging_init();
+    if (!(source = calloc( 1, sizeof(*source) ))) return E_OUTOFMEMORY;
+    if (!(source->pixels = calloc( (size_t)width * height, 4 )))
+    {
+        free( source );
+        return E_OUTOFMEMORY;
+    }
+    source->width = width;
+    source->height = height;
+    source->IImageSource_iface.vtbl = image_source_vtbl;
+    source->IKind_iface.vtbl = surface_kind_vtbl;
+    source->INative_iface.vtbl = surface_native_vtbl;
+    source->INativeD2D_iface.vtbl = surface_native_d2d_vtbl;
+    handlers_init( &source->opened );
+    handlers_init( &source->failed );
+    dobj_init( &source->d, &surface_source_class, outer );
+    if (outer)
+    {
+        *inner = &source->d.obj.IInspectable_inner;
+        IUnknown_AddRef( source->d.obj.outer );
+    }
+    *value = (IInspectable *)&source->IKind_iface;
+    return S_OK;
