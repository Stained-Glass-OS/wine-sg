From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, explorer: a full-screen client of several monitors
 is full screen on each

---
 dlls/winex11.drv/sg_embed.c | 76 +++++++++++++++++++++++++++-
 programs/explorer/systray.c | 98 +++++++++++++++++++++++++++++++++++--
 2 files changed, 170 insertions(+), 4 deletions(-)

diff --git a/dlls/winex11.drv/sg_embed.c b/dlls/winex11.drv/sg_embed.c
index 386bf97..308dd19 100644
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -635,13 +635,58 @@ static BOOL net_state_fullscreen( Display *d, Window w )
     return ret;
 }
 
+/* a window of one size only (ICCCM WM_NORMAL_HINTS: minimum = maximum) */
+static BOOL fixed_size( Display *d, Window w )
+{
+    XSizeHints hints;
+    long supplied = 0;
+    BOOL ret = FALSE;
+
+    X11DRV_expect_error( d, ignore_error, NULL );
+    if (XGetWMNormalHints( d, w, &hints, &supplied ) && (hints.flags & PMinSize) && (hints.flags & PMaxSize))
+        ret = hints.min_width == hints.max_width && hints.min_height == hints.max_height;
+    if (sync_check_error( d )) ret = FALSE;
+    return ret;
+}
+
 LRESULT sg_embed_attach( HWND hwnd, Window child )
 {
     struct x11drv_win_data *data;
     XWindowAttributes attr;
     struct sg_embed *e;
     int x, y, w, h;
-    BOOL full = FALSE;
+    BOOL full = FALSE, covers = FALSE;
+
+#ifndef SG_MUTANT_EMBED_BORDERLESS_WINDOWED
+    {
+        /* Stained Glass OS (wine-sg 7826): a window exactly the size and place of a monitor that
+         * draws no frame or cannot be resized is that monitor's full-screen window, as X window
+         * managers take one (mutter's and KWin's "legacy full screen"): framed as a window, it got
+         * a caption and border, did not fit the work area and was maximized across the desktop.
+         * sdl-freerdp3 /multimon (Remote Desktop Connection, RDM's "Open (external)" with
+         * multiple monitors) makes one window per monitor, each its monitor's size and fixed so,
+         * and asks for full screen only for the first, or not at all in time. (Asked before
+         * get_win_data: no win32u call under its lock.) */
+        struct x11drv_thread_data *td = x11drv_thread_data();
+        XWindowAttributes ca;
+        if (td && td->display && (draws_own_frame( td->display, child ) || fixed_size( td->display, child )))
+        {
+            BOOL ok;
+            X11DRV_expect_error( td->display, ignore_error, NULL );
+            ok = XGetWindowAttributes( td->display, child, &ca );
+            if (sync_check_error( td->display )) ok = FALSE;
+            if (ok)
+            {
+                RECT r = { ca.x, ca.y, ca.x + ca.width, ca.y + ca.height };
+                MONITORINFO mi = { sizeof(mi) };
+                HMONITOR mon = NtUserMonitorFromRect( &r, MONITOR_DEFAULTTONULL );
+                if (mon && NtUserGetMonitorInfo( mon, &mi ) && EqualRect( &mi.rcMonitor, &r )) covers = TRUE;
+                TRACE( "%lx at %s: monitor %p %s, covers %d\n", child, wine_dbgstr_rect( &r ), mon,
+                       wine_dbgstr_rect( &mi.rcMonitor ), covers );
+            }
+        }
+    }
+#endif
 
     if (!(data = get_win_data( hwnd ))) return 0;
     if (!client_in_frame( data, &x, &y, &w, &h ) || !embeddable( data->display, child, &attr ) ||
@@ -653,6 +698,7 @@ LRESULT sg_embed_attach( HWND hwnd, Window child )
 #ifndef SG_MUTANT_EMBED_PRE_FULLSCREEN_LOST
     full = net_state_fullscreen( data->display, child );
 #endif
+    if (covers) full = TRUE;
     pthread_mutex_lock( &embed_mutex );
     if ((e = find_hwnd( hwnd )) || embed_count == MAX_EMBEDS)
     {
@@ -671,6 +717,7 @@ LRESULT sg_embed_attach( HWND hwnd, Window child )
     w += e->ext[0] + e->ext[1]; h += e->ext[2] + e->ext[3];
     e->x = x; e->y = y; e->w = w; e->h = h;
     e->fs_pending = full;
+    TRACE( "%p: %lx full screen already: %d\n", hwnd, child, full );
     e->serial = NextRequest( data->display );
     pthread_mutex_unlock( &embed_mutex );
 
@@ -1186,6 +1233,16 @@ LRESULT sg_embed_message( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
             X11DRV_expect_error( d, ignore_error, NULL );
             big = XGetWindowAttributes( d, (Window)wp, &attr );
             if (sync_check_error( d )) big = FALSE;
+#ifndef SG_MUTANT_EMBED_FS_MAXIMIZED
+            /* Stained Glass OS (wine-sg 7826): a window that asks for full screen already is not
+             * maximized for being as large as its monitor -- it will be full screen there. A
+             * client of several monitors (sdl-freerdp3 /multimon: one window per monitor, each
+             * its size and full screen) had its frames maximized: the first then full screen as a
+             * maximized pop-up, over the whole desktop; the second's request to be full screen
+             * lost to the maximized state written over it, a frame across both monitors. */
+            if (big && (net_state_fullscreen( d, (Window)wp ) || get_cardinal( d, (Window)wp, fullscreen_atom( d ) )))
+                big = FALSE;
+#endif
             release_win_data( data );
         }
 #ifndef SG_MUTANT_EMBED_NO_MAXIMIZE
@@ -1368,7 +1425,13 @@ LRESULT sg_embed_message( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
         {
             /* the whole of its monitor, no frame -- as a full-screen window */
             NtUserGetMonitorInfo( NtUserMonitorFromWindow( hwnd, MONITOR_DEFAULTTONEAREST ), &mi );
+#ifndef SG_MUTANT_EMBED_FS_MAXIMIZED
+            /* (not maximized either: a maximized pop-up is sized as one, not to its monitor, 7826;
+             * the saved style keeps it for the way back) */
+            NtUserSetWindowLong( hwnd, GWL_STYLE, (style & ~(WS_CAPTION | WS_THICKFRAME | WS_MAXIMIZE)) | WS_POPUP, FALSE );
+#else
             NtUserSetWindowLong( hwnd, GWL_STYLE, (style & ~(WS_CAPTION | WS_THICKFRAME)) | WS_POPUP, FALSE );
+#endif
             NtUserSetWindowPos( hwnd, HWND_TOP, mi.rcMonitor.left, mi.rcMonitor.top,
                                 mi.rcMonitor.right - mi.rcMonitor.left, mi.rcMonitor.bottom - mi.rcMonitor.top,
                                 SWP_FRAMECHANGED );
@@ -1385,6 +1448,17 @@ LRESULT sg_embed_message( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
     {
         /* the program asked to be maximized or restored: its frame is */
         BOOL on, zoomed = !!(NtUserGetWindowLongW( hwnd, GWL_STYLE ) & WS_MAXIMIZE);
+#ifndef SG_MUTANT_EMBED_FS_MAXIMIZED
+        BOOL full;
+        /* full screen (or about to be) wins over maximized (7826): the frame of a window as large
+         * as its monitor is maximized when it is framed (the attach above), and that came after
+         * its request to be full screen -- a full-screen client of two monitors got a maximized
+         * pop-up over the whole desktop and a frame across both */
+        pthread_mutex_lock( &embed_mutex );
+        full = (e = find_hwnd( hwnd )) && (e->fullscreen || e->fs_pending);
+        pthread_mutex_unlock( &embed_mutex );
+        if (full) return 0;
+#endif
         X11DRV_expect_error( display, ignore_error, NULL );
         on = get_cardinal( display, child, maximized_atom( display ) ) != 0;
         sync_check_error( display );
diff --git a/programs/explorer/systray.c b/programs/explorer/systray.c
index 20f5435..58b489e 100644
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -5494,20 +5494,40 @@ static BOOL sg_fullscreen_foreground( HWND fg )
  * but behind a full-screen window in the foreground. Asked again whenever a
  * window comes forward: in the virtual desktop X stacks a newly shown window
  * of another program above it, whatever Wine's order says. */
+static void sg_stack_seconds( HWND fg );
+static HWND sg_cover_for( const RECT *monitor, HWND fg );
+
 static void sg_stack_bar(void)
 {
     const UINT flags = SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOOWNERZORDER;
-    HWND fg = GetForegroundWindow();
+    HWND fg = GetForegroundWindow(), cover = NULL;
 
     if (!tray_window) return;
+    sg_stack_seconds( fg );
     if (!sg_bar.autohide && sg_fullscreen_foreground( fg ))
+    {
+        /* behind the foreground program's full-screen window on this bar's display: the
+         * foreground window itself, or another of its program's when the foreground one is on
+         * another display (7826: a client of several monitors) */
+#ifndef SG_MUTANT_SECOND_BAR_OVER_FULLSCREEN
+        MONITORINFO mi = { sizeof(mi) };
+        HMONITOR mon = MonitorFromWindow( tray_window, MONITOR_DEFAULTTOPRIMARY );
+        if (GetMonitorInfoW( mon, &mi )) cover = sg_cover_for( &mi.rcMonitor, fg );
+        /* the foreground window on this display, full screen as its program says
+         * (MarkFullscreenWindow) though not covering it exactly: as before */
+        if (!cover && MonitorFromWindow( fg, MONITOR_DEFAULTTONEAREST ) == mon) cover = fg;
+#else
+        cover = fg;
+#endif
+    }
+    if (cover)
     {
         SetWindowPos( tray_window, HWND_NOTOPMOST, 0, 0, 0, 0, flags );
-        SetWindowPos( tray_window, fg, 0, 0, 0, 0, flags );
+        SetWindowPos( tray_window, cover, 0, 0, 0, 0, flags );
         /* and the full-screen window above it in X too: its own process
          * restacks it (X stacking below another program's window is left
          * alone) */
-        SetWindowPos( fg, HWND_TOP, 0, 0, 0, 0, flags | SWP_ASYNCWINDOWPOS );
+        SetWindowPos( cover, HWND_TOP, 0, 0, 0, 0, flags | SWP_ASYNCWINDOWPOS );
     }
     else
     {
@@ -6033,6 +6053,78 @@ static void sg_second_place( struct sg_second *bar )
     }
     SetWindowPos( bar->hwnd, HWND_TOPMOST, r.left, r.top, r.right - r.left, r.bottom - r.top,
                   SWP_NOACTIVATE | SWP_SHOWWINDOW );
+#ifndef SG_MUTANT_SECOND_BAR_OVER_FULLSCREEN
+    sg_stack_seconds( GetForegroundWindow() );
+#endif
+}
+
+/* Stained Glass OS (wine-sg 7826): the program in the foreground is full screen on another display
+ * too -- that display's bar goes behind it, as the main bar goes behind the foreground's full
+ * screen. A client of several monitors (sdl-freerdp3 /multimon: Remote Desktop Connection, RDM's
+ * "Open (external)") has a full-screen window on each, one of them in the foreground; the other
+ * displays' bars stayed over the session (they were above everything always). As on Windows, a
+ * full-screen window of another program, not in the foreground, keeps the bar over it. */
+static BOOL sg_same_program( HWND a, HWND b )
+{
+    struct taskbar_button *wa = find_taskbar_button( a ), *wb = find_taskbar_button( b );
+    DWORD pa, pb;
+
+    if (a == b) return TRUE;
+    /* Linux programs' windows are framed here, all of this process: the same X client is the
+     * same program (an X window id carries its client's resource base, the bits above 21) */
+    if (wa && wb && wa->embedded && wb->embedded) return (wa->embedded >> 21) == (wb->embedded >> 21);
+    if ((wa && wa->embedded) || (wb && wb->embedded)) return FALSE;
+    GetWindowThreadProcessId( a, &pa );
+    GetWindowThreadProcessId( b, &pb );
+    return pa == pb && pa != GetCurrentProcessId();
+}
+
+struct sg_cover_find { RECT monitor; HWND fg; HWND found; };
+
+static BOOL CALLBACK sg_find_cover( HWND hwnd, LPARAM lp )
+{
+    struct sg_cover_find *f = (struct sg_cover_find *)lp;
+    RECT rc;
+
+    if (!IsWindowVisible( hwnd ) || IsIconic( hwnd ) || hwnd == tray_window) return TRUE;
+    if (!GetWindowRect( hwnd, &rc )) return TRUE;
+    if (rc.left > f->monitor.left || rc.top > f->monitor.top || rc.right < f->monitor.right ||
+        rc.bottom < f->monitor.bottom) return TRUE;
+    if (!sg_same_program( hwnd, f->fg )) return TRUE;
+    f->found = hwnd;
+    return FALSE;
+}
+
+static HWND sg_cover_for( const RECT *monitor, HWND fg )
+{
+    struct sg_cover_find f = { *monitor, fg, NULL };
+    EnumWindows( sg_find_cover, (LPARAM)&f );
+    return f.found;
+}
+
+static void sg_stack_seconds( HWND fg )
+{
+    const UINT flags = SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOOWNERZORDER;
+    struct sg_second *bar;
+
+    LIST_FOR_EACH_ENTRY( bar, &sg_seconds, struct sg_second, entry )
+    {
+        struct sg_cover_find f = { bar->monitor, fg, NULL };
+
+        if (!bar->hwnd) continue;
+#ifndef SG_MUTANT_SECOND_BAR_OVER_FULLSCREEN
+        if (!sg_bar.autohide && fg && sg_fullscreen_foreground( fg )) EnumWindows( sg_find_cover, (LPARAM)&f );
+#endif
+        if (f.found)
+        {
+            if (GetWindowLongW( bar->hwnd, GWL_EXSTYLE ) & WS_EX_TOPMOST)
+                SetWindowPos( bar->hwnd, HWND_NOTOPMOST, 0, 0, 0, 0, flags );
+            SetWindowPos( bar->hwnd, f.found, 0, 0, 0, 0, flags );
+            SetWindowPos( f.found, HWND_TOP, 0, 0, 0, 0, flags | SWP_ASYNCWINDOWPOS );
+        }
+        else if (!(GetWindowLongW( bar->hwnd, GWL_EXSTYLE ) & WS_EX_TOPMOST))
+            SetWindowPos( bar->hwnd, HWND_TOPMOST, 0, 0, 0, 0, flags );
+    }
 }
 
 /* auto-hide on the other displays' bars, each by itself: it comes out when the
-- 
