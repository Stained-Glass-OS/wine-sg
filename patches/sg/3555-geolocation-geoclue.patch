+/* Ask GeoClue for the position.  Consent is checked first: with location denied nothing is sent anywhere. */
+static HRESULT fetch_location(struct geolocator *impl, int timeout_ms, struct location *loc)
+{
+    struct get_location_params params = {0};
+    PositionAccuracy accuracy;
+    HRESULT hr;
+
+    if (location_denied())
+    {
+#ifndef SG_MUTANT_GEO_CALL_WHEN_DENIED
+        set_status(impl, PositionStatus_Disabled);
+        return E_ACCESSDENIED;
+#endif
+    }
+
+    EnterCriticalSection(&impl->cs);
+    accuracy = impl->accuracy;
+    LeaveCriticalSection(&impl->cs);
+
+    set_status(impl, PositionStatus_Initializing);
+
+    params.high_accuracy = accuracy == PositionAccuracy_High;
+    params.timeout_ms = timeout_ms;
+    params.result = LOCATION_UNAVAILABLE;
+    if (__wine_init_unix_call() || WINE_UNIX_CALL(unix_get_location, &params))
+        params.result = LOCATION_UNAVAILABLE;
+
+    switch (params.result)
+    {
+    case LOCATION_OK:
+        loc->latitude = params.latitude;
+        loc->longitude = params.longitude;
+        loc->accuracy = params.accuracy;
+        loc->altitude = params.altitude;
+        loc->speed = params.speed;
+        loc->heading = params.heading;
+        loc->has_altitude = !!(params.flags & LOCATION_HAS_ALTITUDE);
+        loc->has_speed = !!(params.flags & LOCATION_HAS_SPEED);
+        loc->has_heading = !!(params.flags & LOCATION_HAS_HEADING);
+        loc->timestamp = (LONGLONG)params.time_sec * 10000000 + params.time_usec * 10 + 116444736000000000ll;
+        EnterCriticalSection(&impl->cs);
+        impl->cache = *loc;
+        impl->has_cache = TRUE;
+        impl->cache_tick = GetTickCount64();
+        LeaveCriticalSection(&impl->cs);
+        set_status(impl, PositionStatus_Ready);
+        return S_OK;
+    case LOCATION_DENIED:
+        set_status(impl, PositionStatus_Disabled);
+        return E_ACCESSDENIED;
+    case LOCATION_UNAVAILABLE:
+        /* no location service: Windows without a source reports its timeout error */
+        set_status(impl, PositionStatus_NotAvailable);
+        return HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+    case LOCATION_TIMEOUT:
+        set_status(impl, PositionStatus_NoData);
+        return HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+    default:
+        set_status(impl, PositionStatus_NoData);
+        hr = E_FAIL;
+        return hr;
+    }
+}
