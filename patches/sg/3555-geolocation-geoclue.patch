+
+#include "private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(geolocator);
+
+#define STATUS_CLOSED 4
+#define HANDLER_NOT_SET ((void *)~(ULONG_PTR)0)
+
+enum async_kind { ASYNC_POSITION, ASYNC_ACCESS };
+
+struct async_op
+{
+    IAsyncOperation_Geoposition position_iface;
+    IAsyncOperation_GeolocationAccessStatus access_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    enum async_kind kind;
+
+    async_callback callback;
+    void *param;
+    TP_WORK *work;
+
+    CRITICAL_SECTION cs;
+    IUnknown *handler;
+    AsyncStatus status;
+    HRESULT hr;
+    IUnknown *object;
+    INT32 value;
+};
+
+static inline struct async_op *impl_from_position( IAsyncOperation_Geoposition *iface )
+{
+    return CONTAINING_RECORD( iface, struct async_op, position_iface );
+}
+
+static inline struct async_op *impl_from_access( IAsyncOperation_GeolocationAccessStatus *iface )
+{
+    return CONTAINING_RECORD( iface, struct async_op, access_iface );
+}
+
+static inline struct async_op *impl_from_info( IAsyncInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct async_op, IAsyncInfo_iface );
+}
+
+static IInspectable *op_iface( struct async_op *op )
+{
+    return op->kind == ASYNC_POSITION ? (IInspectable *)&op->position_iface : (IInspectable *)&op->access_iface;
+}
+
+static void invoke_handler( struct async_op *op, IUnknown *handler, AsyncStatus status )
+{
+    if (op->kind == ASYNC_POSITION)
+        IAsyncOperationCompletedHandler_Geoposition_Invoke( (IAsyncOperationCompletedHandler_Geoposition *)handler,
+                                                            &op->position_iface, status );
+    else
+        IAsyncOperationCompletedHandler_GeolocationAccessStatus_Invoke(
+            (IAsyncOperationCompletedHandler_GeolocationAccessStatus *)handler, &op->access_iface, status );
+}
+
+static HRESULT op_query_interface( struct async_op *op, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ))
+    {
+        IInspectable_AddRef( (*out = op_iface( op )) );
+        return S_OK;
+    }
+    if (op->kind == ASYNC_POSITION && IsEqualGUID( iid, &IID_IAsyncOperation_Geoposition ))
+    {
+        IInspectable_AddRef( (*out = &op->position_iface) );
+        return S_OK;
+    }
+    if (op->kind == ASYNC_ACCESS && IsEqualGUID( iid, &IID_IAsyncOperation_GeolocationAccessStatus ))
+    {
+        IInspectable_AddRef( (*out = &op->access_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+    {
+        IAsyncInfo_AddRef( (*out = &op->IAsyncInfo_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG op_add_ref( struct async_op *op )
+{
+    return InterlockedIncrement( &op->ref );
+}
+
+static ULONG op_release( struct async_op *op )
+{
+    ULONG ref = InterlockedDecrement( &op->ref );
+
+    if (!ref)
+    {
+        if (op->handler && op->handler != HANDLER_NOT_SET) IUnknown_Release( op->handler );
+        if (op->work) CloseThreadpoolWork( op->work );
+        if (op->object) IUnknown_Release( op->object );
+        op->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &op->cs );
+        free( op );
+    }
+    return ref;
+}
+
+static HRESULT op_put_completed( struct async_op *op, IUnknown *handler )
+{
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &op->cs );
+    if (op->status == STATUS_CLOSED) hr = E_ILLEGAL_METHOD_CALL;
+    else if (op->handler != HANDLER_NOT_SET) hr = E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    else if ((op->handler = handler))
+    {
+        IUnknown_AddRef( handler );
+
+        if (op->status > Started)
+        {
+            AsyncStatus status = op->status;
+            op->handler = NULL; /* prevent a concurrent invoke */
+            LeaveCriticalSection( &op->cs );
+
+            invoke_handler( op, handler, status );
+            IUnknown_Release( handler );
+            return S_OK;
+        }
+    }
+    LeaveCriticalSection( &op->cs );
+    return hr;
+}
+
+static HRESULT op_get_completed( struct async_op *op, IUnknown **handler )
+{
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &op->cs );
+    if (op->status == STATUS_CLOSED) hr = E_ILLEGAL_METHOD_CALL;
+    if (op->handler == NULL || op->handler == HANDLER_NOT_SET) *handler = NULL;
+    else
+    {
+        *handler = op->handler;
+        IUnknown_AddRef( *handler );
+    }
+    LeaveCriticalSection( &op->cs );
+    return hr;
+}
+
+static HRESULT op_results( struct async_op *op, IUnknown **object, INT32 *value )
+{
+    HRESULT hr = E_ILLEGAL_METHOD_CALL;
+
+    EnterCriticalSection( &op->cs );
+    if (op->status == Completed || op->status == Error)
+    {
+        hr = op->hr;
+        if (SUCCEEDED(hr))
+        {
+            if (object && (*object = op->object)) IUnknown_AddRef( *object );
+            if (value) *value = op->value;
+        }
+    }
+    else if (op->status == Canceled) hr = E_ILLEGAL_METHOD_CALL;
+    LeaveCriticalSection( &op->cs );
+    return hr;
+}
+
+/* IAsyncOperation<Geoposition> */
+
+static HRESULT WINAPI position_QueryInterface( IAsyncOperation_Geoposition *iface, REFIID iid, void **out )
+{
+    return op_query_interface( impl_from_position( iface ), iid, out );
+}
+
+static ULONG WINAPI position_AddRef( IAsyncOperation_Geoposition *iface )
+{
+    return op_add_ref( impl_from_position( iface ) );
+}
+
+static ULONG WINAPI position_Release( IAsyncOperation_Geoposition *iface )
+{
+    return op_release( impl_from_position( iface ) );
+}
+
+static HRESULT WINAPI position_GetIids( IAsyncOperation_Geoposition *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = IID_IAsyncOperation_Geoposition;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI position_GetRuntimeClassName( IAsyncOperation_Geoposition *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Foundation.IAsyncOperation`1<Windows.Devices.Geolocation.Geoposition>";
+    return WindowsCreateString( class_name, ARRAY_SIZE(class_name) - 1, name );
+}
+
+static HRESULT WINAPI position_GetTrustLevel( IAsyncOperation_Geoposition *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI position_put_Completed( IAsyncOperation_Geoposition *iface,
+                                              IAsyncOperationCompletedHandler_Geoposition *handler )
+{
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    return op_put_completed( impl_from_position( iface ), (IUnknown *)handler );
+}
+
+static HRESULT WINAPI position_get_Completed( IAsyncOperation_Geoposition *iface,
+                                              IAsyncOperationCompletedHandler_Geoposition **handler )
+{
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    return op_get_completed( impl_from_position( iface ), (IUnknown **)handler );
+}
+
+static HRESULT WINAPI position_GetResults( IAsyncOperation_Geoposition *iface, IGeoposition **results )
+{
+    IUnknown *object = NULL;
+    HRESULT hr;
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    if (!results) return E_POINTER;
+    *results = NULL;
+    if (SUCCEEDED(hr = op_results( impl_from_position( iface ), &object, NULL )) && object)
+    {
+        hr = IUnknown_QueryInterface( object, &IID_IGeoposition, (void **)results );
+        IUnknown_Release( object );
+    }
+    return hr;
+}
+
+static const IAsyncOperation_GeopositionVtbl position_vtbl =
+{
+    position_QueryInterface,
+    position_AddRef,
+    position_Release,
+    position_GetIids,
+    position_GetRuntimeClassName,
+    position_GetTrustLevel,
+    position_put_Completed,
+    position_get_Completed,
+    position_GetResults,
+};
+
+/* IAsyncOperation<GeolocationAccessStatus> */
+
+static HRESULT WINAPI access_QueryInterface( IAsyncOperation_GeolocationAccessStatus *iface, REFIID iid, void **out )
+{
+    return op_query_interface( impl_from_access( iface ), iid, out );
+}
+
+static ULONG WINAPI access_AddRef( IAsyncOperation_GeolocationAccessStatus *iface )
+{
+    return op_add_ref( impl_from_access( iface ) );
+}
+
+static ULONG WINAPI access_Release( IAsyncOperation_GeolocationAccessStatus *iface )
+{
+    return op_release( impl_from_access( iface ) );
+}
+
+static HRESULT WINAPI access_GetIids( IAsyncOperation_GeolocationAccessStatus *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = IID_IAsyncOperation_GeolocationAccessStatus;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI access_GetRuntimeClassName( IAsyncOperation_GeolocationAccessStatus *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Foundation.IAsyncOperation`1<Windows.Devices.Geolocation.GeolocationAccessStatus>";
+    return WindowsCreateString( class_name, ARRAY_SIZE(class_name) - 1, name );
+}
+
+static HRESULT WINAPI access_GetTrustLevel( IAsyncOperation_GeolocationAccessStatus *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI access_put_Completed( IAsyncOperation_GeolocationAccessStatus *iface,
+                                            IAsyncOperationCompletedHandler_GeolocationAccessStatus *handler )
+{
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    return op_put_completed( impl_from_access( iface ), (IUnknown *)handler );
+}
+
+static HRESULT WINAPI access_get_Completed( IAsyncOperation_GeolocationAccessStatus *iface,
+                                            IAsyncOperationCompletedHandler_GeolocationAccessStatus **handler )
+{
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    return op_get_completed( impl_from_access( iface ), (IUnknown **)handler );
+}
+
+static HRESULT WINAPI access_GetResults( IAsyncOperation_GeolocationAccessStatus *iface, GeolocationAccessStatus *results )
+{
+    INT32 value = 0;
+    HRESULT hr;
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    if (!results) return E_POINTER;
+    hr = op_results( impl_from_access( iface ), NULL, &value );
+    *results = SUCCEEDED(hr) ? value : GeolocationAccessStatus_Unspecified;
+    return hr;
+}
