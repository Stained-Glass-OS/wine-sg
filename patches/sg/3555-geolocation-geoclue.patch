+
+static HRESULT get_position_callback(void *context, IUnknown **object, INT32 *value)
+{
+    struct get_position_params *params = context;
+    struct geolocator *impl = impl_from_IGeolocator(params->geolocator);
+    struct location loc;
+    HRESULT hr = S_OK;
+    BOOL cached = FALSE;
+
+    if (location_denied())
+    {
+#ifndef SG_MUTANT_GEO_CALL_WHEN_DENIED
+        set_status(impl, PositionStatus_Disabled);
+        hr = E_ACCESSDENIED;
+        goto done;
+#endif
+    }
+
+    EnterCriticalSection(&impl->cs);
+    if (impl->has_cache && (LONGLONG)(GetTickCount64() - impl->cache_tick) <= params->maximum_age_ms)
+    {
+        loc = impl->cache;
+        cached = TRUE;
+    }
+    LeaveCriticalSection(&impl->cs);
+
+    if (!cached) hr = fetch_location(impl, params->timeout_ms, &loc);
+    if (SUCCEEDED(hr))
+    {
+        IGeoposition *position;
+
+        if (SUCCEEDED(hr = geoposition_create(&loc, &position))) *object = (IUnknown *)position;
+    }
+done:
+    IGeolocator_Release(params->geolocator);
+    return hr;
+}
+
+static HRESULT start_get_position(IGeolocator *iface, LONGLONG maximum_age_ms, LONGLONG timeout_ms,
+        IAsyncOperation_Geoposition **value)
+{
+    struct get_position_params *params;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(params = malloc(sizeof(*params)))) return E_OUTOFMEMORY;
+    IGeolocator_AddRef((params->geolocator = iface));
+    params->maximum_age_ms = maximum_age_ms;
+    params->timeout_ms = timeout_ms > 600000 ? 600000 : timeout_ms;
+    if (FAILED(hr = async_geoposition_create(get_position_callback, params, value)))
+    {
+        IGeolocator_Release(iface);
+        free(params);
+    }
+    return hr;
+}
