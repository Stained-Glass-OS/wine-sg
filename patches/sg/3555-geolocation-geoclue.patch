+static const IAsyncOperation_GeolocationAccessStatusVtbl access_vtbl =
+{
+    access_QueryInterface,
+    access_AddRef,
+    access_Release,
+    access_GetIids,
+    access_GetRuntimeClassName,
+    access_GetTrustLevel,
