+static void fire_status_changed(struct geolocator *impl, PositionStatus status)
+{
+    struct handler *copy = NULL;
+    ULONG i, count;
+
+    EnterCriticalSection(&impl->cs);
+    count = impl->status_count;
+    if (count && (copy = malloc(count * sizeof(*copy))))
+    {
+        memcpy(copy, impl->status_handlers, count * sizeof(*copy));
+        for (i = 0; i < count; i++) IUnknown_AddRef(copy[i].handler);
+    }
+    LeaveCriticalSection(&impl->cs);
+    if (!copy) return;
+
+    for (i = 0; i < count; i++)
+    {
+        IStatusChangedEventArgs *args;
+
+        if (SUCCEEDED(status_changed_args_create(status, &args)))
+        {
+            ITypedEventHandler_Geolocator_StatusChangedEventArgs_Invoke(
+                (ITypedEventHandler_Geolocator_StatusChangedEventArgs *)copy[i].handler, &impl->IGeolocator_iface, args);
+            IStatusChangedEventArgs_Release(args);
+        }
+        IUnknown_Release(copy[i].handler);
+    }
+    free(copy);
+}
