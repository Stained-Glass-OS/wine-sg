+#define GEOCLUE_NAME        "org.freedesktop.GeoClue2"
+#define GEOCLUE_MANAGER     "/org/freedesktop/GeoClue2/Manager"
+#define GEOCLUE_MANAGER_IF  "org.freedesktop.GeoClue2.Manager"
+#define GEOCLUE_CLIENT_IF   "org.freedesktop.GeoClue2.Client"
+#define GEOCLUE_LOCATION_IF "org.freedesktop.GeoClue2.Location"
+#define PROPERTIES_IF       "org.freedesktop.DBus.Properties"
+
+/* GeoClue's GClueAccuracyLevel */
+#define ACCURACY_NEIGHBORHOOD 5
+#define ACCURACY_EXACT        8
+
+/* test-only: a private bus instead of the system bus */
+#define TEST_BUS_ENV "WINE_SG_GEOCLUE_BUS_ADDRESS"
+
+static int error_result( DBusError *err )
+{
+    if (!err->name) return LOCATION_FAILED;
+    if (!strcmp( err->name, DBUS_ERROR_ACCESS_DENIED ) ||
+        !strcmp( err->name, "org.freedesktop.DBus.Error.AuthFailed" ))
+        return LOCATION_DENIED;
+    if (!strcmp( err->name, DBUS_ERROR_SERVICE_UNKNOWN ) || !strcmp( err->name, DBUS_ERROR_NAME_HAS_NO_OWNER ) ||
+        !strcmp( err->name, DBUS_ERROR_NO_SERVER ) || !strcmp( err->name, DBUS_ERROR_DISCONNECTED ) ||
+        !strcmp( err->name, DBUS_ERROR_NO_REPLY ) || !strcmp( err->name, DBUS_ERROR_TIMED_OUT ))
+        return LOCATION_UNAVAILABLE;
+    return LOCATION_FAILED;
+}
+
+static DBusConnection *connect_bus( DBusError *err )
+{
+    const char *address = getenv( TEST_BUS_ENV );
+    DBusConnection *conn;
+
+    if (address && *address)
+    {
+        if (!(conn = p_dbus_connection_open_private( address, err ))) return NULL;
+        if (!p_dbus_bus_register( conn, err ))
+        {
+            p_dbus_connection_close( conn );
+            p_dbus_connection_unref( conn );
+            return NULL;
+        }
+        return conn;
+    }
+    return p_dbus_bus_get_private( DBUS_BUS_SYSTEM, err );
+}
+
+static DBusMessage *call( DBusConnection *conn, const char *path, const char *iface, const char *method,
+                          DBusError *err )
+{
+    DBusMessage *msg, *reply;
+
+    if (!(msg = p_dbus_message_new_method_call( GEOCLUE_NAME, path, iface, method ))) return NULL;
+    reply = p_dbus_connection_send_with_reply_and_block( conn, msg, 10000, err );
+    p_dbus_message_unref( msg );
+    return reply;
+}
+
+/* Properties.Set( iface, name, variant ) with a string or uint32 value */
+static BOOL set_property( DBusConnection *conn, const char *path, const char *name, int type, const void *value,
+                          DBusError *err )
+{
+    DBusMessage *msg, *reply;
+    DBusMessageIter iter, var;
+    const char *iface = GEOCLUE_CLIENT_IF;
+    const char *sig = type == DBUS_TYPE_STRING ? "s" : "u";
+
+    if (!(msg = p_dbus_message_new_method_call( GEOCLUE_NAME, path, PROPERTIES_IF, "Set" ))) return FALSE;
+    p_dbus_message_iter_init_append( msg, &iter );
+    p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &iface );
+    p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &name );
+    p_dbus_message_iter_open_container( &iter, DBUS_TYPE_VARIANT, sig, &var );
+    p_dbus_message_iter_append_basic( &var, type, value );
+    p_dbus_message_iter_close_container( &iter, &var );
+    reply = p_dbus_connection_send_with_reply_and_block( conn, msg, 10000, err );
+    p_dbus_message_unref( msg );
+    if (!reply) return FALSE;
+    p_dbus_message_unref( reply );
+    return TRUE;
+}
+
+/* Properties.Get( iface, name ): positions the iterator inside the variant */
+static DBusMessage *get_property( DBusConnection *conn, const char *path, const char *iface, const char *name,
+                                  DBusMessageIter *value, DBusError *err )
+{
+    DBusMessage *msg, *reply;
+    DBusMessageIter iter;
+
+    if (!(msg = p_dbus_message_new_method_call( GEOCLUE_NAME, path, PROPERTIES_IF, "Get" ))) return NULL;
+    p_dbus_message_iter_init_append( msg, &iter );
+    p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &iface );
+    p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &name );
+    reply = p_dbus_connection_send_with_reply_and_block( conn, msg, 10000, err );
+    p_dbus_message_unref( msg );
+    if (!reply) return NULL;
+    if (!p_dbus_message_iter_init( reply, &iter ) || p_dbus_message_iter_get_arg_type( &iter ) != DBUS_TYPE_VARIANT)
+    {
+        p_dbus_message_unref( reply );
+        return NULL;
+    }
+    p_dbus_message_iter_recurse( &iter, value );
+    return reply;
+}
+
+static BOOL get_double( DBusConnection *conn, const char *path, const char *name, double *ret )
+{
+    DBusMessageIter value;
+    DBusMessage *reply;
+    BOOL ok = FALSE;
+
+    if (!(reply = get_property( conn, path, GEOCLUE_LOCATION_IF, name, &value, NULL ))) return FALSE;
+    if (p_dbus_message_iter_get_arg_type( &value ) == DBUS_TYPE_DOUBLE)
+    {
+        p_dbus_message_iter_get_basic( &value, ret );
+        ok = TRUE;
+    }
+    p_dbus_message_unref( reply );
+    return ok;
+}
+
+static BOOL read_location( DBusConnection *conn, const char *path, struct get_location_params *params )
+{
+    double altitude, speed, heading;
+    DBusMessageIter value, st;
+    DBusMessage *reply;
+
+    if (!get_double( conn, path, "Latitude", &params->latitude ) ||
+        !get_double( conn, path, "Longitude", &params->longitude ) ||
+        !get_double( conn, path, "Accuracy", &params->accuracy ))
+        return FALSE;
+
+    params->flags = 0;
+    /* GeoClue reports "unknown" as the most negative double (altitude) or -1 (speed, heading) */
+    if (get_double( conn, path, "Altitude", &altitude ) && altitude > -1e300)
+    {
+        params->altitude = altitude;
+        params->flags |= LOCATION_HAS_ALTITUDE;
+    }
+    if (get_double( conn, path, "Speed", &speed ) && speed >= 0)
+    {
+        params->speed = speed;
+        params->flags |= LOCATION_HAS_SPEED;
+    }
+    if (get_double( conn, path, "Heading", &heading ) && heading >= 0)
+    {
+        params->heading = heading;
+        params->flags |= LOCATION_HAS_HEADING;
+    }
+
+    params->time_sec = time( NULL );
+    params->time_usec = 0;
+    if ((reply = get_property( conn, path, GEOCLUE_LOCATION_IF, "Timestamp", &value, NULL )))
+    {
+        if (p_dbus_message_iter_get_arg_type( &value ) == DBUS_TYPE_STRUCT)
+        {
+            dbus_uint64_t sec = 0, usec = 0;
+
+            p_dbus_message_iter_recurse( &value, &st );
+            p_dbus_message_iter_get_basic( &st, &sec );
+            p_dbus_message_iter_next( &st );
+            p_dbus_message_iter_get_basic( &st, &usec );
+            if (sec) { params->time_sec = sec; params->time_usec = usec; }
+        }
+        p_dbus_message_unref( reply );
+    }
+    return TRUE;
+}
+
+/* Location property of a client: the object path, "/" while there is no fix */
+static BOOL client_location( DBusConnection *conn, const char *client, char *out, size_t size )
+{
+    DBusMessageIter value;
+    DBusMessage *reply;
+    const char *path;
+    BOOL ok = FALSE;
+
+    if (!(reply = get_property( conn, client, GEOCLUE_CLIENT_IF, "Location", &value, NULL ))) return FALSE;
+    if (p_dbus_message_iter_get_arg_type( &value ) == DBUS_TYPE_OBJECT_PATH)
+    {
+        p_dbus_message_iter_get_basic( &value, &path );
+        if (strlen( path ) < size) { strcpy( out, path ); ok = TRUE; }
+    }
+    p_dbus_message_unref( reply );
+    return ok;
+}
+
+/* waits for LocationUpdated; returns the new location path or NULL on timeout */
+static BOOL wait_location_updated( DBusConnection *conn, int timeout_ms, char *out, size_t size )
+{
+    time_t end = time( NULL ) + (timeout_ms + 999) / 1000;
+
+    while (time( NULL ) < end)
+    {
+        DBusMessage *msg;
+
+        while ((msg = p_dbus_connection_pop_message( conn )))
+        {
+            if (p_dbus_message_is_signal( msg, GEOCLUE_CLIENT_IF, "LocationUpdated" ))
+            {
+                const char *old = NULL, *new = NULL;
+
+                if (p_dbus_message_get_args( msg, NULL, DBUS_TYPE_OBJECT_PATH, &old, DBUS_TYPE_OBJECT_PATH, &new,
+                                             DBUS_TYPE_INVALID ) && new && strcmp( new, "/" ) && strlen( new ) < size)
+                {
+                    strcpy( out, new );
+                    p_dbus_message_unref( msg );
+                    return TRUE;
+                }
+            }
+            p_dbus_message_unref( msg );
+        }
+        if (!p_dbus_connection_read_write_dispatch( conn, 500 )) break;
+    }
+    return FALSE;
+}
+
+
+static int do_get_location( struct get_location_params *params )
+{
+    DBusConnection *conn;
+    DBusMessage *reply;
+    DBusError err;
+    char client[256], location[256];
+    const char *path, *desktop_id = "wine";
+    dbus_uint32_t level = params->high_accuracy ? ACCURACY_EXACT : ACCURACY_NEIGHBORHOOD;
+    int result;
+
+    if (!load_dbus()) return LOCATION_UNAVAILABLE;
+    p_dbus_error_init( &err );
+    if (!(conn = connect_bus( &err )))
+    {
+        p_dbus_error_free( &err );
+        return LOCATION_UNAVAILABLE;
+    }
+    p_dbus_connection_set_exit_on_disconnect( conn, FALSE );
+
+    if (!(reply = call( conn, GEOCLUE_MANAGER, GEOCLUE_MANAGER_IF, "GetClient", &err )))
+    {
+        result = error_result( &err );
+        goto done;
+    }
+    if (!p_dbus_message_get_args( reply, NULL, DBUS_TYPE_OBJECT_PATH, &path, DBUS_TYPE_INVALID ) || strlen( path ) >= sizeof(client))
+    {
+        p_dbus_message_unref( reply );
+        result = LOCATION_FAILED;
+        goto done;
+    }
+    strcpy( client, path );
+    p_dbus_message_unref( reply );
+
+    if (!set_property( conn, client, "DesktopId", DBUS_TYPE_STRING, &desktop_id, &err ) ||
+        !set_property( conn, client, "RequestedAccuracyLevel", DBUS_TYPE_UINT32, &level, &err ))
+    {
+        result = error_result( &err );
+        goto done;
+    }
+
+    p_dbus_bus_add_match( conn, "type='signal',interface='" GEOCLUE_CLIENT_IF "',member='LocationUpdated'", NULL );
+    if (!(reply = call( conn, client, GEOCLUE_CLIENT_IF, "Start", &err )))
+    {
+        result = error_result( &err );
+        goto done;
+    }
+    p_dbus_message_unref( reply );
+
+    location[0] = 0;
+    if (!client_location( conn, client, location, sizeof(location) ) || !strcmp( location, "/" ))
+    {
+        if (!wait_location_updated( conn, params->timeout_ms, location, sizeof(location) ))
+        {
+            result = LOCATION_TIMEOUT;
+            goto stop;
+        }
+    }
+
+    if (read_location( conn, location, params ))
+    {
+        result = LOCATION_OK;
+#ifdef SG_MUTANT_GEO_SWAP
+        {
+            double tmp = params->latitude;
+            params->latitude = params->longitude;
+            params->longitude = tmp;
+        }
+#endif
+    }
+    else result = LOCATION_FAILED;
+
+stop:
+    if ((reply = call( conn, client, GEOCLUE_CLIENT_IF, "Stop", NULL ))) p_dbus_message_unref( reply );
+done:
+    if (p_dbus_error_is_set( &err )) p_dbus_error_free( &err );
+    p_dbus_connection_close( conn );
+    p_dbus_connection_unref( conn );
+    return result;
+}
+
+#endif /* SONAME_LIBDBUS_1 */
+
+static NTSTATUS get_location( void *args )
+{
+    struct get_location_params *params = args;
+
+#ifdef SONAME_LIBDBUS_1
+    params->result = do_get_location( params );
+#else
+    params->result = LOCATION_UNAVAILABLE;
+#endif
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    get_location,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    get_location,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif
