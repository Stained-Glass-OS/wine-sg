+/* PositionChanged / StatusChanged: a watcher thread polls GeoClue while handlers are registered */
+
+static double distance_meters(const struct location *a, const struct location *b)
+{
+    const double rad = 3.14159265358979323846 / 180.0;
+    double dlat = (b->latitude - a->latitude) * rad, dlon = (b->longitude - a->longitude) * rad;
+    double x = dlon * cos((a->latitude + b->latitude) * rad / 2), y = dlat;
+    return 6371000.0 * sqrt(x * x + y * y);
+}
+
+static DWORD WINAPI watcher_thread(void *context)
+{
+    struct geolocator *impl = context;
+    IGeolocator *iface = &impl->IGeolocator_iface;
+    LONG my_gen = impl->watch_gen;
+    struct location last, loc;
+    BOOL have_last = FALSE;
+    ULONGLONG last_report = 0;
+
+    for (;;)
+    {
+        ULONG waited = 0, period;
+        LONG ref;
+        HRESULT hr;
+
+        /* run only while somebody still holds the geolocator */
+        do
+        {
+            if (!(ref = ReadNoFence(&impl->ref_public))) goto out;
+        } while (ref != InterlockedCompareExchange(&impl->ref_public, ref + 1, ref));
+        IWeakReference_AddRef(&impl->IWeakReference_iface);
+
+        EnterCriticalSection(&impl->cs);
+        period = impl->interval;
+        LeaveCriticalSection(&impl->cs);
+        if (impl->watch_gen != my_gen) { geolocator_Release(iface); goto out; }
+
+        hr = fetch_location(impl, 15000, &loc);
+        if (SUCCEEDED(hr))
+        {
+            double threshold;
+            ULONGLONG now = GetTickCount64();
+
+            EnterCriticalSection(&impl->cs);
+            threshold = impl->threshold;
+            LeaveCriticalSection(&impl->cs);
+
+            if (!have_last || (distance_meters(&last, &loc) >= max(threshold, 0.5) && now - last_report >= period))
+            {
+                IGeoposition *position;
+
+                if (SUCCEEDED(geoposition_create(&loc, &position)))
+                {
+                    fire_position_changed(impl, position);
+                    IGeoposition_Release(position);
+                }
+                last = loc;
+                have_last = TRUE;
+                last_report = now;
+            }
+        }
+        geolocator_Release(iface);
+
+        period = max(period, POLL_INTERVAL_MS);
+        while (waited < period)
+        {
+            Sleep(200);
+            waited += 200;
+            if (impl->watch_gen != my_gen) goto out;
+        }
+    }
+out:
+    IWeakReference_Release(&impl->IWeakReference_iface);
+    return 0;
+}
+
+static void start_watcher(struct geolocator *impl)
+{
+    HANDLE thread;
+
+    if (impl->watching) return;
+    impl->watching = TRUE;
+    InterlockedIncrement(&impl->watch_gen);
+    IWeakReference_AddRef(&impl->IWeakReference_iface);   /* kept by the thread */
+    if (!(thread = CreateThread(NULL, 0, watcher_thread, impl, 0, NULL)))
+    {
+        impl->watching = FALSE;
+        IWeakReference_Release(&impl->IWeakReference_iface);
+        return;
+    }
+    CloseHandle(thread);
+}
+
+static void stop_watcher_if_idle(struct geolocator *impl)
+{
+    if (impl->watching && !impl->position_count && !impl->status_count)
+    {
+        impl->watching = FALSE;
+        InterlockedIncrement(&impl->watch_gen);
+    }
+}
+
+static HRESULT add_handler(struct geolocator *impl, struct handler **list, ULONG *count, ULONG *cap,
+        IUnknown *handler, EventRegistrationToken *token)
+{
+    if (*count == *cap)
+    {
+        ULONG new_cap = *cap ? *cap * 2 : 4;
+        struct handler *p = realloc(*list, new_cap * sizeof(*p));
+        if (!p) return E_OUTOFMEMORY;
+        *list = p;
+        *cap = new_cap;
+    }
+    IUnknown_AddRef(handler);
+    (*list)[*count].handler = handler;
+    (*list)[*count].token.value = token->value = InterlockedIncrement64(&impl->next_token);
+    (*count)++;
+    return S_OK;
+}
+
+static HRESULT remove_handler(struct geolocator *impl, struct handler *list, ULONG *count, EventRegistrationToken token)
+{
+    ULONG i;
+
+    for (i = 0; i < *count; i++)
+    {
+        if (list[i].token.value != token.value) continue;
+        IUnknown_Release(list[i].handler);
+        memmove(&list[i], &list[i + 1], (*count - i - 1) * sizeof(*list));
+        (*count)--;
+        break;
+    }
+    stop_watcher_if_idle(impl);
+    return S_OK;
 }
 
