+
+static HRESULT WINAPI info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    struct async_op *op = impl_from_info( iface );
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &op->cs );
+    if (op->status == STATUS_CLOSED) hr = E_ILLEGAL_METHOD_CALL;
+    *id = 1;
+    LeaveCriticalSection( &op->cs );
+    return hr;
+}
+
+static HRESULT WINAPI info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct async_op *op = impl_from_info( iface );
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &op->cs );
+    if (op->status == STATUS_CLOSED) hr = E_ILLEGAL_METHOD_CALL;
+    *status = op->status;
+    LeaveCriticalSection( &op->cs );
+    return hr;
+}
+
+static HRESULT WINAPI info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error_code )
+{
+    struct async_op *op = impl_from_info( iface );
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &op->cs );
+    if (op->status == STATUS_CLOSED) *error_code = hr = E_ILLEGAL_METHOD_CALL;
+    else *error_code = op->hr;
+    LeaveCriticalSection( &op->cs );
+    return hr;
+}
+
+static HRESULT WINAPI info_Cancel( IAsyncInfo *iface )
+{
+    struct async_op *op = impl_from_info( iface );
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &op->cs );
+    if (op->status == STATUS_CLOSED) hr = E_ILLEGAL_METHOD_CALL;
+    else if (op->status == Started) op->status = Canceled;
+    LeaveCriticalSection( &op->cs );
+    return hr;
+}
+
+static HRESULT WINAPI info_Close( IAsyncInfo *iface )
+{
+    struct async_op *op = impl_from_info( iface );
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &op->cs );
+    if (op->status == Started) hr = E_ILLEGAL_STATE_CHANGE;
+    else op->status = STATUS_CLOSED;
+    LeaveCriticalSection( &op->cs );
+    return hr;
+}
+
+static const IAsyncInfoVtbl info_vtbl =
+{
+    info_QueryInterface,
+    info_AddRef,
+    info_Release,
+    info_GetIids,
+    info_GetRuntimeClassName,
+    info_GetTrustLevel,
+    info_get_Id,
+    info_get_Status,
+    info_get_ErrorCode,
+    info_Cancel,
+    info_Close,
+};
+
+static void CALLBACK async_callback_proc( TP_CALLBACK_INSTANCE *instance, void *context, TP_WORK *work )
+{
+    struct async_op *op = context;
+    IUnknown *object = NULL;
+    INT32 value = 0;
+    HRESULT hr;
+
+    hr = op->callback( op->param, &object, &value );
+    free( op->param );
+    op->param = NULL;
+
+    EnterCriticalSection( &op->cs );
+    if (op->status == Started) op->status = FAILED(hr) ? Error : Completed;
+    op->hr = hr;
+    op->object = object;
+    op->value = value;
+
+    if (op->handler && op->handler != HANDLER_NOT_SET)
+    {
+        IUnknown *handler = op->handler;
+        AsyncStatus status = op->status;
+
+        op->handler = NULL; /* prevent a concurrent invoke */
+        LeaveCriticalSection( &op->cs );
+        invoke_handler( op, handler, status );
+        IUnknown_Release( handler );
+    }
+    else LeaveCriticalSection( &op->cs );
+
+    /* the reference taken when the work was submitted */
+    op_release( op );
+}
+
+static HRESULT async_create( enum async_kind kind, async_callback callback, void *param, struct async_op **out )
+{
+    struct async_op *op;
+
+    *out = NULL;
+    if (!(op = calloc( 1, sizeof(*op) ))) return E_OUTOFMEMORY;
+    op->position_iface.lpVtbl = &position_vtbl;
+    op->access_iface.lpVtbl = &access_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    op->kind = kind;
+    op->ref = 1;
+    op->callback = callback;
+    op->param = param;
+    op->handler = HANDLER_NOT_SET;
+    op->status = Started;
+    InitializeCriticalSectionEx( &op->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    op->cs.DebugInfo->Spare[0] = (DWORD_PTR)( __FILE__ ": async_op.cs" );
+    if (!(op->work = CreateThreadpoolWork( async_callback_proc, op, NULL )))
+    {
+        HRESULT hr = HRESULT_FROM_WIN32( GetLastError() );
+        op->param = NULL;   /* still owned by the caller on failure */
+        op->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &op->cs );
+        free( op );
+        return hr;
+    }
+
+    op_add_ref( op );   /* kept by the running work */
+    SubmitThreadpoolWork( op->work );
+    *out = op;
+    return S_OK;
+}
+
+HRESULT async_geoposition_create( async_callback callback, void *param, IAsyncOperation_Geoposition **out )
+{
+    struct async_op *op;
+    HRESULT hr;
+
+    if (FAILED(hr = async_create( ASYNC_POSITION, callback, param, &op ))) return hr;
+    *out = &op->position_iface;
+    return S_OK;
+}
+
+HRESULT async_access_create( async_callback callback, void *param, IAsyncOperation_GeolocationAccessStatus **out )
+{
+    struct async_op *op;
+    HRESULT hr;
+
+    if (FAILED(hr = async_create( ASYNC_ACCESS, callback, param, &op ))) return hr;
+    *out = &op->access_iface;
+    return S_OK;
+}
