+static void test_statics(void)
+{
+    static const WCHAR *name = L"Windows.Devices.Geolocation.Geolocator";
+    IAsyncOperation_GeolocationAccessStatus *operation;
+    IGeolocatorStatics *statics;
+    GeolocationAccessStatus access;
+    IActivationFactory *factory;
+    AsyncStatus async_status;
+    IAsyncInfo *info;
+    HSTRING str;
+    HRESULT hr;
+    int i;
+
+    WindowsCreateString(name, wcslen(name), &str);
+    hr = RoGetActivationFactory(str, &IID_IActivationFactory, (void **)&factory);
+    WindowsDeleteString(str);
+    if (hr == REGDB_E_CLASSNOTREG) return;
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+
+    hr = IActivationFactory_QueryInterface(factory, &IID_IGeolocatorStatics, (void **)&statics);
+    ok(hr == S_OK || broken(hr == E_NOINTERFACE), "got hr %#lx.\n", hr);
+    if (hr != S_OK)
+    {
+        IActivationFactory_Release(factory);
+        return;
+    }
+
+    hr = IGeolocatorStatics_RequestAccessAsync(statics, NULL);
+    ok(hr == E_POINTER, "got hr %#lx.\n", hr);
+    hr = IGeolocatorStatics_RequestAccessAsync(statics, &operation);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+
+    hr = IAsyncOperation_GeolocationAccessStatus_QueryInterface(operation, &IID_IAsyncInfo, (void **)&info);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    async_status = Started;
+    for (i = 0; i < 100 && async_status == Started; i++)
+    {
+        hr = IAsyncInfo_get_Status(info, &async_status);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        if (async_status == Started) Sleep(50);
