+/* ---- consent: the capability access store written by Settings and first-run setup ---- */
+
+static BOOL consent_value_denied( HKEY root, const WCHAR *subkey )
+{
+    WCHAR value[16];
+    DWORD size = sizeof(value), type;
+    HKEY key;
+    BOOL denied = FALSE;
+    static const WCHAR base[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\location";
+    WCHAR path[256];
+
+    wcscpy( path, base );
+    if (subkey) { wcscat( path, L"\\" ); wcscat( path, subkey ); }
+
+    if (RegOpenKeyExW( root, path, 0, KEY_QUERY_VALUE | KEY_WOW64_64KEY, &key )) return FALSE;
+    if (!RegQueryValueExW( key, L"Value", NULL, &type, (BYTE *)value, &size ) && type == REG_SZ)
+    {
+        value[ARRAY_SIZE(value) - 1] = 0;
+        denied = !wcsicmp( value, L"Deny" );
+    }
+    RegCloseKey( key );
+    return denied;
+}
+
+/* Allow unless the device-wide switch, the user's switch or the desktop apps switch says Deny.
+ * Read at every request: Settings can change it while an app runs. */
+static BOOL location_denied(void)
+{
+#ifdef SG_MUTANT_GEO_NOHKLM
+    if (0)
+#endif
+    if (consent_value_denied( HKEY_LOCAL_MACHINE, NULL )) return TRUE;
+    if (consent_value_denied( HKEY_CURRENT_USER, NULL )) return TRUE;
+#ifndef SG_MUTANT_GEO_NONPACKAGED
+    if (consent_value_denied( HKEY_CURRENT_USER, L"NonPackaged" )) return TRUE;
+#endif
+    return FALSE;
+}
