  */
 DWORD WINAPI GetAuditedPermissionsFromAclA( PACL pacl, PTRUSTEEA pTrustee, PACCESS_MASK pSuccessfulAuditedRights,
         PACCESS_MASK pFailedAuditRights)
 {
-    FIXME("%p %p %p %p\n",pacl, pTrustee, pSuccessfulAuditedRights, pFailedAuditRights);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    TRUSTEEW trusteeW;
+    WCHAR *name = NULL;
+    DWORD ret, len;
+
+    TRACE("%p %p %p %p\n",pacl, pTrustee, pSuccessfulAuditedRights, pFailedAuditRights);
 
+    if (!pTrustee) return ERROR_INVALID_PARAMETER;
+    memcpy( &trusteeW, pTrustee, sizeof(trusteeW) );
+    if (pTrustee->TrusteeForm == TRUSTEE_IS_NAME)
+    {
+        if (!pTrustee->ptstrName) return ERROR_INVALID_PARAMETER;
+        len = MultiByteToWideChar( CP_ACP, MB_ERR_INVALID_CHARS, pTrustee->ptstrName, -1, NULL, 0 );
+        if (!len) return ERROR_NO_UNICODE_TRANSLATION;
+        if (!(name = malloc( len * sizeof(WCHAR) ))) return ERROR_NOT_ENOUGH_MEMORY;
+        MultiByteToWideChar( CP_ACP, MB_ERR_INVALID_CHARS, pTrustee->ptstrName, -1, name, len );
+        trusteeW.ptstrName = name;
+    }
+    ret = GetAuditedPermissionsFromAclW( pacl, &trusteeW, pSuccessfulAuditedRights, pFailedAuditRights );
+    free( name );
+    return ret;
 }
 
