From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: GetAuditedPermissionsFromAcl, LookupSecurityDescriptorParts, OpenEncryptedFileRaw

advapi32: GetAuditedPermissionsFromAcl, LookupSecurityDescriptorParts, OpenEncryptedFileRaw

GetAuditedPermissionsFromAcl evaluates the audit ACEs for a trustee,
LookupSecurityDescriptorParts returns the owner, group, and access/audit
entries as trustees with names, and OpenEncryptedFileRaw validates its
arguments and reports that the volume cannot hold encrypted files.

Rebased at integration (integ-2026-10) onto 3734 (fast-b): GetAuditedPermissionsFromAcl and LookupSecurityDescriptorParts were implemented by both; fast-b 3734's (one ACL evaluator shared with GetEffectiveRightsFromAcl, plus GetSecurityInfoEx) is kept, so this patch drops its dlls/advapi32/security.c hunks and keeps OpenEncryptedFileRaw and its conformance tests, which now check 3734's functions.
---
From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: GetAuditedPermissionsFromAcl, LookupSecurityDescriptorParts, OpenEncryptedFileRaw

advapi32: GetAuditedPermissionsFromAcl, LookupSecurityDescriptorParts, OpenEncryptedFileRaw

GetAuditedPermissionsFromAcl evaluates the audit ACEs for a trustee,
LookupSecurityDescriptorParts returns the owner, group, and access/audit
entries as trustees with names, and OpenEncryptedFileRaw validates its
arguments and reports that the volume cannot hold encrypted files.
---
--- a/dlls/advapi32/crypt.c
+++ b/dlls/advapi32/crypt.c
@@ -2254,8 +2254,19 @@ BOOL WINAPI CryptVerifySignatureA (HCRYPTHASH hHash, const BYTE *pbSignature, DW
  */
 DWORD WINAPI OpenEncryptedFileRawA(LPCSTR filename, ULONG flags, PVOID *context)
 {
-    FIXME("(%s, %lx, %p): stub\n", debugstr_a(filename), flags, context);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    WCHAR *nameW;
+    DWORD len, ret;
+
+    TRACE("(%s, %lx, %p)\n", debugstr_a(filename), flags, context);
+
+    if (!filename) return ERROR_INVALID_PARAMETER;
+    len = MultiByteToWideChar( CP_ACP, MB_ERR_INVALID_CHARS, filename, -1, NULL, 0 );
+    if (!len) return ERROR_NO_UNICODE_TRANSLATION;
+    if (!(nameW = malloc( len * sizeof(WCHAR) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    MultiByteToWideChar( CP_ACP, MB_ERR_INVALID_CHARS, filename, -1, nameW, len );
+    ret = OpenEncryptedFileRawW( nameW, flags, context );
+    free( nameW );
+    return ret;
 }
 
 /******************************************************************************
@@ -2270,11 +2281,24 @@ DWORD WINAPI OpenEncryptedFileRawA(LPCSTR filename, ULONG flags, PVOID *context)
  * RETURNS
  *  Success: ERROR_SUCCESS
  *  Failure: NTSTATUS error code
+ *
+ * NOTES
+ *  The file systems here cannot encrypt (see FileEncryptionStatusW), so a
+ *  file can be neither exported nor imported as an encrypted file.
  */
 DWORD WINAPI OpenEncryptedFileRawW(LPCWSTR filename, ULONG flags, PVOID *context)
 {
-    FIXME("(%s, %lx, %p): stub\n", debugstr_w(filename), flags, context);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    TRACE("(%s, %lx, %p)\n", debugstr_w(filename), flags, context);
+
+    if (!filename || !context || (flags & ~(CREATE_FOR_IMPORT | CREATE_FOR_DIR | OVERWRITE_HIDDEN)))
+        return ERROR_INVALID_PARAMETER;
+    /* an export reads an existing file */
+    if (!(flags & CREATE_FOR_IMPORT) && GetFileAttributesW( filename ) == INVALID_FILE_ATTRIBUTES)
+        return GetLastError();
+#ifdef SG_MUTANT_OPENEFS_SUCCESS
+    return ERROR_SUCCESS;
+#endif
+    return ERROR_VOLUME_NOT_SUPPORT_EFS;
 }
 
 /******************************************************************************
--- a/dlls/advapi32/tests/security.c
+++ b/dlls/advapi32/tests/security.c
@@ -8676,6 +8676,249 @@ static void test_window_security(void)
     LocalFree(sd);
 }
 
+static WCHAR *test_account_name(PSID sid)
+{
+    WCHAR name[256], domain[256], *ret;
+    DWORD nlen = 256, dlen = 256;
+    SID_NAME_USE use;
+    BOOL r = LookupAccountSidW(NULL, sid, name, &nlen, domain, &dlen, &use);
+
+    ok(r, "LookupAccountSidW failed %lu\n", GetLastError());
+    ret = malloc(600 * sizeof(WCHAR));
+    if (dlen) swprintf(ret, 600, L"%s\\%s", domain, name);
+    else wcscpy(ret, name);
+    return ret;
+}
+
+static void test_LookupSecurityDescriptorParts(void)
+{
+    static const WCHAR sddl[] = L"O:BAG:SYD:(A;;GA;;;WD)(D;;GR;;;BU)S:(AU;SAFA;GR;;;WD)(AU;FA;GW;;;BA)(AU;SA;GX;;;SY)";
+    TRUSTEEW *owner, *group;
+    TRUSTEEA *ownerA, *groupA;
+    EXPLICIT_ACCESSW *access, *audit;
+    EXPLICIT_ACCESSA *accessA, *auditA;
+    ULONG access_count, audit_count, size, i;
+    SECURITY_DESCRIPTOR *sd, abs_sd;
+    PSID sid_ba, sid_sy;
+    WCHAR *expect;
+    DWORD ret;
+    BOOL r;
+
+    r = ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl, SDDL_REVISION_1, (void **)&sd, &size);
+    ok(r, "conversion failed %lu\n", GetLastError());
+    if (!r) return;
+    ConvertStringSidToSidW(L"BA", &sid_ba);
+    ConvertStringSidToSidW(L"SY", &sid_sy);
+
+    owner = group = (void *)0xdeadbeef;
+    access = audit = (void *)0xdeadbeef;
+    access_count = audit_count = 0xdeadbeef;
+    ret = LookupSecurityDescriptorPartsW(&owner, &group, &access_count, &access, &audit_count, &audit, sd);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(owner->TrusteeForm == TRUSTEE_IS_NAME, "form %d\n", owner->TrusteeForm);
+    ok(owner->TrusteeType == TRUSTEE_IS_ALIAS, "type %d\n", owner->TrusteeType);
+    ok(owner->MultipleTrusteeOperation == NO_MULTIPLE_TRUSTEE, "op %d\n", owner->MultipleTrusteeOperation);
+    expect = test_account_name(sid_ba);
+    ok(!wcscmp(owner->ptstrName, expect), "owner %s, expected %s\n", debugstr_w(owner->ptstrName), debugstr_w(expect));
+    free(expect);
+    expect = test_account_name(sid_sy);
+    ok(group->TrusteeForm == TRUSTEE_IS_NAME, "form %d\n", group->TrusteeForm);
+    ok(!wcscmp(group->ptstrName, expect), "group %s, expected %s\n", debugstr_w(group->ptstrName), debugstr_w(expect));
+    free(expect);
+
+    ok(access_count == 2, "access count %lu\n", access_count);
+    ok(access[0].grfAccessMode == GRANT_ACCESS, "mode %d\n", access[0].grfAccessMode);
+    ok(access[0].grfAccessPermissions == GENERIC_ALL, "mask %#lx\n", access[0].grfAccessPermissions);
+    ok(access[0].Trustee.TrusteeForm == TRUSTEE_IS_NAME, "form %d\n", access[0].Trustee.TrusteeForm);
+    ok(!wcscmp(access[0].Trustee.ptstrName, L"Everyone"), "name %s\n", debugstr_w(access[0].Trustee.ptstrName));
+    ok(access[0].Trustee.TrusteeType == TRUSTEE_IS_WELL_KNOWN_GROUP, "type %d\n", access[0].Trustee.TrusteeType);
+    ok(access[1].grfAccessMode == DENY_ACCESS, "mode %d\n", access[1].grfAccessMode);
+    ok(access[1].grfAccessPermissions == GENERIC_READ, "mask %#lx\n", access[1].grfAccessPermissions);
+
+    ok(audit_count == 4, "audit count %lu\n", audit_count);
+    ok(audit[0].grfAccessMode == SET_AUDIT_SUCCESS, "mode %d\n", audit[0].grfAccessMode);
+    ok(audit[0].grfAccessPermissions == GENERIC_READ, "mask %#lx\n", audit[0].grfAccessPermissions);
+    ok(audit[0].Trustee.TrusteeForm == TRUSTEE_IS_NAME, "form %d\n", audit[0].Trustee.TrusteeForm);
+    ok(audit[1].grfAccessMode == SET_AUDIT_FAILURE, "mode %d\n", audit[1].grfAccessMode);
+    ok(audit[1].grfAccessPermissions == GENERIC_READ, "mask %#lx\n", audit[1].grfAccessPermissions);
+    ok(audit[2].grfAccessMode == SET_AUDIT_FAILURE, "mode %d\n", audit[2].grfAccessMode);
+    ok(audit[2].grfAccessPermissions == GENERIC_WRITE, "mask %#lx\n", audit[2].grfAccessPermissions);
+    ok(audit[3].grfAccessMode == SET_AUDIT_SUCCESS, "mode %d\n", audit[3].grfAccessMode);
+    ok(audit[3].grfAccessPermissions == GENERIC_EXECUTE, "mask %#lx\n", audit[3].grfAccessPermissions);
+    ok(LocalSize(access) >= access_count * sizeof(*access), "one block\n");
+    LocalFree(owner); LocalFree(group); LocalFree(access); LocalFree(audit);
+
+    /* every output is optional, a list needs its count and the other way round */
+    ret = LookupSecurityDescriptorPartsW(NULL, NULL, NULL, NULL, NULL, NULL, sd);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    owner = (void *)0xdeadbeef;
+    ret = LookupSecurityDescriptorPartsW(&owner, NULL, NULL, NULL, NULL, NULL, sd);
+    ok(ret == ERROR_SUCCESS && owner && owner != (void *)0xdeadbeef, "got %lu %p\n", ret, owner);
+    LocalFree(owner);
+    ret = LookupSecurityDescriptorPartsW(NULL, NULL, &access_count, NULL, NULL, NULL, sd);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = LookupSecurityDescriptorPartsW(NULL, NULL, NULL, NULL, NULL, &audit, sd);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    access_count = 0xdeadbeef;
+    ret = LookupSecurityDescriptorPartsW(NULL, NULL, &access_count, &access, NULL, NULL, sd);
+    ok(ret == ERROR_SUCCESS && access_count == 2, "got %lu %lu\n", ret, access_count);
+    LocalFree(access);
+
+    /* only a self-relative descriptor */
+    InitializeSecurityDescriptor(&abs_sd, SECURITY_DESCRIPTOR_REVISION);
+    ret = LookupSecurityDescriptorPartsW(&owner, NULL, NULL, NULL, NULL, NULL, &abs_sd);
+    ok(ret == ERROR_INVALID_SECURITY_DESCR, "got %lu\n", ret);
+    ret = LookupSecurityDescriptorPartsW(&owner, NULL, NULL, NULL, NULL, NULL, NULL);
+    ok(ret == ERROR_INVALID_SECURITY_DESCR, "got %lu\n", ret);
+
+    /* no DACL and no SACL */
+    LocalFree(sd);
+    r = ConvertStringSecurityDescriptorToSecurityDescriptorW(L"O:BA", SDDL_REVISION_1, (void **)&sd, &size);
+    ok(r, "conversion failed %lu\n", GetLastError());
+    access_count = audit_count = 0xdeadbeef;
+    access = audit = (void *)0xdeadbeef;
+    group = (void *)0xdeadbeef;
+    ret = LookupSecurityDescriptorPartsW(NULL, &group, &access_count, &access, &audit_count, &audit, sd);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(!group && !access && !audit && !access_count && !audit_count, "%p %p %p %lu %lu\n", group, access, audit, access_count, audit_count);
+    LocalFree(sd);
+
+    /* the ANSI form: same structure with ANSI names, one block each */
+    r = ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl, SDDL_REVISION_1, (void **)&sd, &size);
+    ok(r, "conversion failed %lu\n", GetLastError());
+    ret = LookupSecurityDescriptorPartsA(&ownerA, &groupA, &access_count, &accessA, &audit_count, &auditA, sd);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(ownerA->TrusteeForm == TRUSTEE_IS_NAME, "form %d\n", ownerA->TrusteeForm);
+    expect = test_account_name(sid_ba);
+    {
+        char buf[600];
+        WideCharToMultiByte(CP_ACP, 0, expect, -1, buf, sizeof(buf), NULL, NULL);
+        ok(!strcmp(ownerA->ptstrName, buf), "owner %s, expected %s\n", debugstr_a(ownerA->ptstrName), debugstr_a(buf));
+    }
+    free(expect);
+    ok(!strcmp(groupA->ptstrName, "NT AUTHORITY\\SYSTEM") || !strcmp(groupA->ptstrName, "SYSTEM") || strstr(groupA->ptstrName, "SYSTEM"),
+       "group %s\n", debugstr_a(groupA->ptstrName));
+    ok(access_count == 2 && audit_count == 4, "counts %lu %lu\n", access_count, audit_count);
+    ok(!strcmp(accessA[0].Trustee.ptstrName, "Everyone"), "name %s\n", debugstr_a(accessA[0].Trustee.ptstrName));
+    for (i = 0; i < audit_count; i++)
+        ok(auditA[i].Trustee.TrusteeForm == TRUSTEE_IS_NAME && auditA[i].Trustee.ptstrName, "audit %lu\n", i);
+    LocalFree(ownerA); LocalFree(groupA); LocalFree(accessA); LocalFree(auditA);
+
+    LocalFree(sd);
+    LocalFree(sid_ba);
+    LocalFree(sid_sy);
+}
+
+static void test_GetAuditedPermissionsFromAcl(void)
+{
+    static const WCHAR sddl[] = L"S:(AU;SA;GR;;;WD)(AU;FA;GW;;;BA)(AU;SAFA;GX;;;SY)(AU;SAIO;0x10;;;SY)";
+    SECURITY_DESCRIPTOR *sd;
+    ACL *sacl;
+    BOOL present, defaulted, r;
+    PSID sid_ba, sid_sy, sid_bu;
+    TRUSTEEW trustee;
+    TRUSTEEA trusteeA;
+    ACCESS_MASK success, failure;
+    DWORD ret, size;
+
+    r = ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl, SDDL_REVISION_1, (void **)&sd, &size);
+    ok(r, "conversion failed %lu\n", GetLastError());
+    if (!r) return;
+    r = GetSecurityDescriptorSacl(sd, &present, &sacl, &defaulted);
+    ok(r && present && sacl, "no SACL\n");
+    ConvertStringSidToSidW(L"BA", &sid_ba);
+    ConvertStringSidToSidW(L"SY", &sid_sy);
+    ConvertStringSidToSidW(L"BU", &sid_bu);
+
+    BuildTrusteeWithSidW(&trustee, sid_ba);
+    success = failure = 0xdeadbeef;
+    ret = GetAuditedPermissionsFromAclW(sacl, &trustee, &success, &failure);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(success == GENERIC_READ, "success %#lx\n", success);
+    ok(failure == GENERIC_WRITE, "failure %#lx\n", failure);
+
+    BuildTrusteeWithSidW(&trustee, sid_sy);
+    ret = GetAuditedPermissionsFromAclW(sacl, &trustee, &success, &failure);
+    ok(ret == ERROR_SUCCESS, "got %lu\n", ret);
+    ok(success == (GENERIC_READ | GENERIC_EXECUTE), "success %#lx\n", success);
+    ok(failure == (GENERIC_WRITE | GENERIC_EXECUTE) || failure == GENERIC_EXECUTE, "failure %#lx\n", failure);
+    ok(!(success & 0x10), "inherit-only entry applied: %#lx\n", success);
+
+    BuildTrusteeWithSidW(&trustee, sid_bu);
+    ret = GetAuditedPermissionsFromAclW(sacl, &trustee, &success, &failure);
+    ok(ret == ERROR_SUCCESS && success == GENERIC_READ && !failure, "got %lu %#lx %#lx\n", ret, success, failure);
+
+    BuildTrusteeWithNameW(&trustee, (WCHAR *)L"Everyone");
+    ret = GetAuditedPermissionsFromAclW(sacl, &trustee, &success, &failure);
+    ok(ret == ERROR_SUCCESS && success == GENERIC_READ && !failure, "got %lu %#lx %#lx\n", ret, success, failure);
+
+    BuildTrusteeWithNameA(&trusteeA, (char *)"Everyone");
+    success = failure = 0xdeadbeef;
+    ret = GetAuditedPermissionsFromAclA(sacl, &trusteeA, &success, &failure);
+    ok(ret == ERROR_SUCCESS && success == GENERIC_READ && !failure, "got %lu %#lx %#lx\n", ret, success, failure);
+    trusteeA.TrusteeForm = TRUSTEE_IS_SID;
+    trusteeA.ptstrName = (char *)sid_ba;
+    ret = GetAuditedPermissionsFromAclA(sacl, &trusteeA, &success, &failure);
+    ok(ret == ERROR_SUCCESS && success == GENERIC_READ && failure == GENERIC_WRITE, "got %lu %#lx %#lx\n", ret, success, failure);
+
+    BuildTrusteeWithNameW(&trustee, (WCHAR *)L"No Such Account Wine");
+    ret = GetAuditedPermissionsFromAclW(sacl, &trustee, &success, &failure);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = GetAuditedPermissionsFromAclW(sacl, NULL, &success, &failure);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = GetAuditedPermissionsFromAclW(NULL, &trustee, &success, &failure);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+
+    LocalFree(sd);
+    LocalFree(sid_ba);
+    LocalFree(sid_sy);
+    LocalFree(sid_bu);
+}
+
+static void test_OpenEncryptedFileRaw(void)
+{
+    WCHAR path[MAX_PATH], missing[MAX_PATH];
+    char pathA[MAX_PATH];
+    HANDLE file;
+    void *ctx;
+    DWORD ret;
+
+    GetTempPathW(MAX_PATH, path);
+    lstrcpyW(missing, path);
+    lstrcatW(missing, L"wine-efs-missing.tmp");
+    lstrcatW(path, L"wine-efs-raw.tmp");
+    file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "create failed %lu\n", GetLastError());
+    CloseHandle(file);
+    DeleteFileW(missing);
+    WideCharToMultiByte(CP_ACP, 0, path, -1, pathA, MAX_PATH, NULL, NULL);
+
+    ctx = (void *)0xdeadbeef;
+    ret = OpenEncryptedFileRawW(NULL, 0, &ctx);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = OpenEncryptedFileRawA(NULL, 0, &ctx);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = OpenEncryptedFileRawW(path, 0, NULL);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = OpenEncryptedFileRawW(path, 0x100, &ctx);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = OpenEncryptedFileRawA(pathA, 0x100, &ctx);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+
+    ret = OpenEncryptedFileRawW(missing, 0, &ctx);
+    ok(ret == ERROR_FILE_NOT_FOUND, "got %lu\n", ret);
+    ret = OpenEncryptedFileRawW(path, 0, &ctx);
+    ok(ret == ERROR_VOLUME_NOT_SUPPORT_EFS, "got %lu\n", ret);
+    ret = OpenEncryptedFileRawA(pathA, 0, &ctx);
+    ok(ret == ERROR_VOLUME_NOT_SUPPORT_EFS, "got %lu\n", ret);
+    ret = OpenEncryptedFileRawA(pathA, CREATE_FOR_IMPORT, &ctx);
+    ok(ret == ERROR_VOLUME_NOT_SUPPORT_EFS, "got %lu\n", ret);
+    ret = OpenEncryptedFileRawW(missing, CREATE_FOR_IMPORT | OVERWRITE_HIDDEN, &ctx);
+    ok(ret == ERROR_VOLUME_NOT_SUPPORT_EFS, "got %lu\n", ret);
+
+    DeleteFileW(path);
+}
+
 START_TEST(security)
 {
     init();
@@ -8736,6 +8979,9 @@ START_TEST(security)
     test_pseudo_tokens();
     test_maximum_allowed();
     test_token_label();
+    test_LookupSecurityDescriptorParts();
+    test_GetAuditedPermissionsFromAcl();
+    test_OpenEncryptedFileRaw();
     test_GetExplicitEntriesFromAclW();
     test_BuildSecurityDescriptorW();
     test_duplicate_handle_access();
--- a/include/aclapi.h
+++ b/include/aclapi.h
@@ -75,6 +75,12 @@ WINADVAPI void   WINAPI BuildTrusteeWithSidW(PTRUSTEEW pTrustee, PSID pSid);
 WINADVAPI DWORD  WINAPI GetEffectiveRightsFromAclA(PACL,PTRUSTEE_A,PACCESS_MASK);
 WINADVAPI DWORD  WINAPI GetEffectiveRightsFromAclW(PACL,PTRUSTEE_W,PACCESS_MASK);
 #define                 GetEffectiveRightsFromAcl WINELIB_NAME_AW(GetEffectiveRightsFromAcl)
+WINADVAPI DWORD  WINAPI GetAuditedPermissionsFromAclA(PACL,PTRUSTEE_A,PACCESS_MASK,PACCESS_MASK);
+WINADVAPI DWORD  WINAPI GetAuditedPermissionsFromAclW(PACL,PTRUSTEE_W,PACCESS_MASK,PACCESS_MASK);
+#define                 GetAuditedPermissionsFromAcl WINELIB_NAME_AW(GetAuditedPermissionsFromAcl)
+WINADVAPI DWORD  WINAPI LookupSecurityDescriptorPartsA(PTRUSTEE_A*,PTRUSTEE_A*,PULONG,PEXPLICIT_ACCESS_A*,PULONG,PEXPLICIT_ACCESS_A*,PSECURITY_DESCRIPTOR);
+WINADVAPI DWORD  WINAPI LookupSecurityDescriptorPartsW(PTRUSTEE_W*,PTRUSTEE_W*,PULONG,PEXPLICIT_ACCESS_W*,PULONG,PEXPLICIT_ACCESS_W*,PSECURITY_DESCRIPTOR);
+#define                 LookupSecurityDescriptorParts WINELIB_NAME_AW(LookupSecurityDescriptorParts)
 
 #ifdef __cplusplus
 }
