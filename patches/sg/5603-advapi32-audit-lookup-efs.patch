+/* the trustee's audit rights come from the SYSTEM_AUDIT_ACEs naming the trustee
+ * or a group it is a member of */
+static BOOL trustee_in_group( PSID trustee, PSID group )
+{
+    TOKEN_USER *user = NULL;
+    TOKEN_GROUPS *groups = NULL;
+    HANDLE token;
+    DWORD size, i;
+    BOOL ret = FALSE;
+
+    if (EqualSid( trustee, group )) return TRUE;
+    if (IsWellKnownSid( group, WinWorldSid )) return TRUE;
+
+    /* membership can only be read for the identity of this process */
+    if (!OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )) return FALSE;
+    GetTokenInformation( token, TokenUser, NULL, 0, &size );
+    if (GetLastError() == ERROR_INSUFFICIENT_BUFFER && (user = malloc( size )) &&
+        GetTokenInformation( token, TokenUser, user, size, &size ) && EqualSid( user->User.Sid, trustee ))
+    {
+        GetTokenInformation( token, TokenGroups, NULL, 0, &size );
+        if (GetLastError() == ERROR_INSUFFICIENT_BUFFER && (groups = malloc( size )) &&
+            GetTokenInformation( token, TokenGroups, groups, size, &size ))
+        {
+            for (i = 0; i < groups->GroupCount; i++)
+                if (EqualSid( groups->Groups[i].Sid, group )) { ret = TRUE; break; }
+        }
+    }
+    free( user );
+    free( groups );
+    CloseHandle( token );
+    return ret;
+}
+
+static DWORD audited_permissions_from_acl( PACL pacl, PSID trustee, PACCESS_MASK success, PACCESS_MASK failure )
+{
+    ACL_SIZE_INFORMATION info;
+    ACCESS_MASK s = 0, f = 0;
+    NTSTATUS status;
+    ULONG i;
+
+    status = RtlQueryInformationAcl( pacl, &info, sizeof(info), AclSizeInformation );
+    if (status) return RtlNtStatusToDosError( status );
+
+    for (i = 0; i < info.AceCount; i++)
+    {
+        SYSTEM_AUDIT_ACE *ace;
+
+        if ((status = RtlGetAce( pacl, i, (void **)&ace ))) return RtlNtStatusToDosError( status );
+        if (ace->Header.AceType != SYSTEM_AUDIT_ACE_TYPE) continue;
+        if (ace->Header.AceFlags & INHERIT_ONLY_ACE) continue;
+        if (!trustee_in_group( trustee, (PSID)&ace->SidStart )) continue;
+#ifdef SG_MUTANT_AUDITED_ANY_ACE
+        s |= ace->Mask; f |= ace->Mask;
+        continue;
+#endif
+        if (ace->Header.AceFlags & SUCCESSFUL_ACCESS_ACE_FLAG) s |= ace->Mask;
+        if (ace->Header.AceFlags & FAILED_ACCESS_ACE_FLAG) f |= ace->Mask;
+    }
+    *success = s;
+    *failure = f;
+    return ERROR_SUCCESS;
+}
+
