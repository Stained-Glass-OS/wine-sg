+static TRUSTEE_TYPE trustee_type_from_use( SID_NAME_USE use )
+{
+    switch (use)
+    {
+    case SidTypeUser:           return TRUSTEE_IS_USER;
+    case SidTypeGroup:          return TRUSTEE_IS_GROUP;
+    case SidTypeDomain:         return TRUSTEE_IS_DOMAIN;
+    case SidTypeAlias:          return TRUSTEE_IS_ALIAS;
+    case SidTypeWellKnownGroup: return TRUSTEE_IS_WELL_KNOWN_GROUP;
+    case SidTypeDeletedAccount: return TRUSTEE_IS_DELETED;
+    case SidTypeInvalid:        return TRUSTEE_IS_INVALID;
+    case 9 /* SidTypeComputer */: return TRUSTEE_IS_COMPUTER;
+    default:                    return TRUSTEE_IS_UNKNOWN;
+    }
+}
+
+/* "DOMAIN\name", or just the name for accounts without a domain */
+static WCHAR *account_name_from_sid( PSID sid, SID_NAME_USE *use )
+{
+    DWORD name_len = 0, domain_len = 0;
+    WCHAR *name, *domain, *ret;
+
+    LookupAccountSidW( NULL, sid, NULL, &name_len, NULL, &domain_len, use );
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER) return NULL;
+    if (!(name = malloc( (name_len + domain_len) * sizeof(WCHAR) ))) return NULL;
+    domain = name + name_len;
+    if (!LookupAccountSidW( NULL, sid, name, &name_len, domain, &domain_len, use ))
+    {
+        free( name );
+        return NULL;
+    }
+#ifdef SG_MUTANT_LOOKUP_NO_DOMAIN
+    domain_len = 0;
+#endif
+    if (domain_len)
+    {
+        if (!(ret = malloc( (domain_len + 1 + name_len + 1) * sizeof(WCHAR) ))) { free( name ); return NULL; }
+        memcpy( ret, domain, domain_len * sizeof(WCHAR) );
+        ret[domain_len] = '\\';
+        memcpy( ret + domain_len + 1, name, (name_len + 1) * sizeof(WCHAR) );
+        free( name );
+        return ret;
+    }
+    return name;
+}
+
+/* one LocalAlloc'd block: [count] structures, then their names */
+static void *copy_names_block( const WCHAR **names, SIZE_T count, SIZE_T stride, SIZE_T name_offset, BOOL unicode,
+                               SIZE_T *name_bytes_out )
+{
+    SIZE_T i, total = 0, *lens;
+    char *block, *p;
+
+    if (!(lens = malloc( count * sizeof(*lens) ))) return NULL;
+    for (i = 0; i < count; i++)
+    {
+        if (unicode) lens[i] = (wcslen( names[i] ) + 1) * sizeof(WCHAR);
+        else lens[i] = WideCharToMultiByte( CP_ACP, 0, names[i], -1, NULL, 0, NULL, NULL );
+        total += lens[i];
+    }
+    if (!(block = LocalAlloc( LMEM_FIXED | LMEM_ZEROINIT, count * stride + total )))
+    {
+        free( lens );
+        return NULL;
+    }
+    p = block + count * stride;
+    for (i = 0; i < count; i++)
+    {
+        if (unicode) memcpy( p, names[i], lens[i] );
+        else WideCharToMultiByte( CP_ACP, 0, names[i], -1, p, lens[i], NULL, NULL );
+        *(char **)(block + i * stride + name_offset) = p;
+        p += lens[i];
+    }
+    free( lens );
+    if (name_bytes_out) *name_bytes_out = total;
+    return block;
+}
+
+static DWORD lookup_trustee( PSID sid, BOOL unicode, TRUSTEEW **ret )
+{
+    SID_NAME_USE use;
+    WCHAR *name;
+    TRUSTEEW *trustee;
+
+    if (!sid) { *ret = NULL; return ERROR_SUCCESS; }
+    if (!(name = account_name_from_sid( sid, &use ))) return GetLastError() ? GetLastError() : ERROR_NONE_MAPPED;
+    trustee = copy_names_block( (const WCHAR **)&name, 1, sizeof(*trustee), offsetof(TRUSTEEW, ptstrName), unicode, NULL );
+    free( name );
+    if (!trustee) return ERROR_NOT_ENOUGH_MEMORY;
+    trustee->pMultipleTrustee = NULL;
+    trustee->MultipleTrusteeOperation = NO_MULTIPLE_TRUSTEE;
+    trustee->TrusteeForm = TRUSTEE_IS_NAME;
+    trustee->TrusteeType = trustee_type_from_use( use );
+    *ret = trustee;
+    return ERROR_SUCCESS;
+}
+
+static DWORD lookup_acl_entries( ACL *acl, BOOL audit, BOOL unicode, ULONG *count, EXPLICIT_ACCESSW **list )
+{
+    ACL_SIZE_INFORMATION info;
+    EXPLICIT_ACCESSW *entries, *src = NULL;
+    const WCHAR **names = NULL;
+    ULONG i, n = 0, cap;
+    DWORD ret = ERROR_SUCCESS;
+    NTSTATUS status;
+
+    *count = 0;
+    *list = NULL;
+    if (!acl) return ERROR_SUCCESS;
+    if ((status = RtlQueryInformationAcl( acl, &info, sizeof(info), AclSizeInformation )))
+        return RtlNtStatusToDosError( status );
+    if (!info.AceCount) return ERROR_SUCCESS;
+
+    cap = info.AceCount * 2;
+    src = calloc( cap, sizeof(*src) );
+    names = calloc( cap, sizeof(*names) );
+    if (!src || !names) { ret = ERROR_NOT_ENOUGH_MEMORY; goto done; }
+
+    for (i = 0; i < info.AceCount; i++)
+    {
+        ACE_HEADER *ace;
+        DWORD mask;
+        PSID sid;
+        BYTE type;
+
+        if ((status = RtlGetAce( acl, i, (void **)&ace ))) { ret = RtlNtStatusToDosError( status ); goto done; }
+        type = ace->AceType;
+        mask = ((ACCESS_ALLOWED_ACE *)ace)->Mask;
+        sid = (PSID)&((ACCESS_ALLOWED_ACE *)ace)->SidStart;
+        if (!audit && type != ACCESS_ALLOWED_ACE_TYPE && type != ACCESS_DENIED_ACE_TYPE) continue;
+        if (audit && type != SYSTEM_AUDIT_ACE_TYPE) continue;
+
+        if (audit)
+        {
+            /* one entry per audited outcome */
+            DWORD modes[2], nmodes = 0, m;
+            if (ace->AceFlags & SUCCESSFUL_ACCESS_ACE_FLAG) modes[nmodes++] = SET_AUDIT_SUCCESS;
+#ifndef SG_MUTANT_LOOKUP_ONE_AUDIT_MODE
+            if (ace->AceFlags & FAILED_ACCESS_ACE_FLAG) modes[nmodes++] = SET_AUDIT_FAILURE;
+#endif
+            for (m = 0; m < nmodes; m++)
+            {
+                src[n].grfAccessMode = modes[m];
+                src[n].grfAccessPermissions = mask;
+                src[n].grfInheritance = ace->AceFlags & (OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE |
+                                                          NO_PROPAGATE_INHERIT_ACE | INHERIT_ONLY_ACE);
+                src[n].Trustee.ptstrName = (WCHAR *)sid;
+                n++;
+            }
+        }
+        else
+        {
+            src[n].grfAccessMode = (type == ACCESS_ALLOWED_ACE_TYPE) ? GRANT_ACCESS : DENY_ACCESS;
+            src[n].grfAccessPermissions = mask;
+            src[n].grfInheritance = ace->AceFlags & (OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE |
+                                                      NO_PROPAGATE_INHERIT_ACE | INHERIT_ONLY_ACE);
+            src[n].Trustee.ptstrName = (WCHAR *)sid;
+            n++;
+        }
+    }
+    if (!n) goto done;
+
+    for (i = 0; i < n; i++)
+    {
+        SID_NAME_USE use;
+        if (!(names[i] = account_name_from_sid( (PSID)src[i].Trustee.ptstrName, &use )))
+        {
+            ret = GetLastError() ? GetLastError() : ERROR_NONE_MAPPED;
+            goto done;
+        }
+        src[i].Trustee.TrusteeType = trustee_type_from_use( use );
+    }
+    entries = copy_names_block( names, n, sizeof(*entries), offsetof(EXPLICIT_ACCESSW, Trustee.ptstrName), unicode, NULL );
+    if (!entries) { ret = ERROR_NOT_ENOUGH_MEMORY; goto done; }
+    for (i = 0; i < n; i++)
+    {
+        WCHAR *name = entries[i].Trustee.ptstrName;
+        entries[i] = src[i];
+        entries[i].Trustee.ptstrName = name;
+        entries[i].Trustee.pMultipleTrustee = NULL;
+        entries[i].Trustee.MultipleTrusteeOperation = NO_MULTIPLE_TRUSTEE;
+        entries[i].Trustee.TrusteeForm = TRUSTEE_IS_NAME;
+    }
+    *count = n;
+    *list = entries;
+
+done:
+    if (names) for (i = 0; i < cap; i++) free( (WCHAR *)names[i] );
+    free( names );
+    free( src );
+    return ret;
+}
+
+static DWORD lookup_descriptor_parts( TRUSTEEW **owner, TRUSTEEW **group, ULONG *access_count,
+                                      EXPLICIT_ACCESSW **access_list, ULONG *audit_count,
+                                      EXPLICIT_ACCESSW **audit_list, PSECURITY_DESCRIPTOR sd, BOOL unicode )
+{
+    SECURITY_DESCRIPTOR_CONTROL control;
+    DWORD revision, ret;
+    PSID sid;
+    ACL *acl;
+    BOOL present, defaulted;
+    TRUSTEEW *owner_ret = NULL, *group_ret = NULL;
+    EXPLICIT_ACCESSW *access_ret = NULL, *audit_ret = NULL;
+    ULONG access_n = 0, audit_n = 0;
+
+    if (!sd || !GetSecurityDescriptorControl( sd, &control, &revision ) || !(control & SE_SELF_RELATIVE))
+        return ERROR_INVALID_SECURITY_DESCR;
+    if ((access_list == NULL) != (access_count == NULL) || (audit_list == NULL) != (audit_count == NULL))
+        return ERROR_INVALID_PARAMETER;
+
+    if (owner)
+    {
+        GetSecurityDescriptorOwner( sd, &sid, &defaulted );
+        if ((ret = lookup_trustee( sid, unicode, &owner_ret ))) goto fail;
+    }
+    if (group)
+    {
+        GetSecurityDescriptorGroup( sd, &sid, &defaulted );
+        if ((ret = lookup_trustee( sid, unicode, &group_ret ))) goto fail;
+    }
+    if (access_list)
+    {
+        acl = NULL;
+        GetSecurityDescriptorDacl( sd, &present, &acl, &defaulted );
+        if (!present) acl = NULL;
+        if ((ret = lookup_acl_entries( acl, FALSE, unicode, &access_n, &access_ret ))) goto fail;
+    }
+    if (audit_list)
+    {
+        acl = NULL;
+        GetSecurityDescriptorSacl( sd, &present, &acl, &defaulted );
+        if (!present) acl = NULL;
+        if ((ret = lookup_acl_entries( acl, TRUE, unicode, &audit_n, &audit_ret ))) goto fail;
+    }
+    if (owner) *owner = owner_ret;
+    if (group) *group = group_ret;
+    if (access_list) { *access_count = access_n; *access_list = access_ret; }
+    if (audit_list) { *audit_count = audit_n; *audit_list = audit_ret; }
+    return ERROR_SUCCESS;
+
+fail:
+    LocalFree( owner_ret );
+    LocalFree( group_ret );
+    LocalFree( access_ret );
+    LocalFree( audit_ret );
+    return ret;
+}
+
