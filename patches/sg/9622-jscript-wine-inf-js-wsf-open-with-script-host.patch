From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] jscript, wine.inf: .js and .wsf files open with the script host (9622)

Opening a .js file (a double click, ShellExecute "open", start file.js) ran
nothing: JSFile had a script engine but no verbs, unlike VBSFile. JSFile now
has Open (wscript), Open2 (cscript), Edit and Print as on Windows, and .wsf
files -- which cscript and wscript now run (9620) -- are registered as
WSFFile with Open (wscript), Open2 (cscript) and Edit.
---
--- a/dlls/jscript/jscript.rgs
+++ b/dlls/jscript/jscript.rgs
@@ -119,5 +119,24 @@
     ForceRemove JSFile = s 'JScript Script File'
     {
         ScriptEngine = s 'JScript'
+        Shell = s 'Open'
+        {
+            Edit
+            {
+                Command = s '"%SystemRoot%\system32\notepad.exe" %%1'
+            }
+            Open
+            {
+                Command = s '"%SystemRoot%\system32\wscript.exe" "%%1" %%*'
+            }
+            Open2
+            {
+                Command = s '"%SystemRoot%\system32\cscript.exe" "%%1" %%*'
+            }
+            Print
+            {
+                Command = s '"%SystemRoot%\system32\notepad.exe" /p %%1'
+            }
+        }
     }
 }
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -451,6 +451,12 @@
 HKCR,JSFile,,2,"JavaScript File"
 HKCR,.vbs,,2,"VBSFile"
 HKCR,VBSFile,,2,"VBScript Script File"
+HKCR,.wsf,,2,"WSFFile"
+HKCR,WSFFile,,2,"Script File (WSF)"
+HKCR,WSFFile\shell,,2,"Open"
+HKCR,WSFFile\shell\open\command,,2,"""%11%\wscript.exe"" ""%1"" %*"
+HKCR,WSFFile\shell\open2\command,,2,"""%11%\cscript.exe"" ""%1"" %*"
+HKCR,WSFFile\shell\edit\command,,2,"""%11%\notepad.exe"" ""%1"""
 HKCR,.ps1,,2,"Microsoft.PowerShellScript.1"
 HKCR,Microsoft.PowerShellScript.1,,2,"PowerShell Script"
 HKCR,.ttf,,2,"ttffile"
