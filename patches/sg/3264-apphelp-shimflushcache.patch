From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:53:17 -0700
Subject: [PATCH] apphelp: ShimFlushCache succeeds for an administrator (3264)

ShimFlushCache set ERROR_CALL_NOT_IMPLEMENTED and returned TRUE. It now checks that the caller is an administrator (ERROR_ACCESS_DENIED otherwise: GUESS for the code) and returns TRUE; no shim cache is kept, so there is nothing to remove. apphelp imports advapi32.

diff --git a/dlls/apphelp/Makefile.in b/dlls/apphelp/Makefile.in
index b677e9c..2431b83 100644
--- a/dlls/apphelp/Makefile.in
+++ b/dlls/apphelp/Makefile.in
@@ -1,4 +1,5 @@
 MODULE = apphelp.dll
+IMPORTS = advapi32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
diff --git a/dlls/apphelp/apphelp.c b/dlls/apphelp/apphelp.c
index 66e59d7..5813531 100644
--- a/dlls/apphelp/apphelp.c
+++ b/dlls/apphelp/apphelp.c
@@ -67,8 +67,28 @@ BOOL WINAPI ApphelpCheckShellObject( REFCLSID clsid, BOOL shim, ULONGLONG *flags
 
 BOOL WINAPI ShimFlushCache( HWND hwnd, HINSTANCE instance, LPCSTR cmdline, int cmd )
 {
-    FIXME("stub: %p %p %s %u\n", hwnd, instance, debugstr_a(cmdline), cmd);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    SID_IDENTIFIER_AUTHORITY nt_authority = { SECURITY_NT_AUTHORITY };
+    PSID admins;
+    BOOL is_admin = FALSE;
+
+    TRACE("%p %p %s %u\n", hwnd, instance, debugstr_a(cmdline), cmd);
+
+#ifdef SG_MUTANT_SHIMFLUSH
+    return FALSE;
+#endif
+    /* the shim database cache is flushed by an administrator; no cache is kept here, so there is nothing to
+     * remove */
+    if (AllocateAndInitializeSid(&nt_authority, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS,
+            0, 0, 0, 0, 0, 0, &admins))
+    {
+        if (!CheckTokenMembership(NULL, admins, &is_admin)) is_admin = FALSE;
+        FreeSid(admins);
+    }
+    if (!is_admin)
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
     return TRUE;
 }
 
