From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] user32: GetWindowDpiHostingBehavior

A window now remembers the DPI hosting behavior of the thread that created it
(set before WM_NCCREATE), and GetWindowDpiHostingBehavior returns it, or
DPI_HOSTING_BEHAVIOR_INVALID for a bad handle. CORE: integrator must review
(patches/notes/5205.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/include/ntuser.h b/include/ntuser.h
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -110,6 +110,7 @@
     UINT           default_imc;       /* default input context */
     UINT64         client_imm;        /* client IMM thread info */
     UINT64         wmchar_data;       /* client data for WM_CHAR mappings */
+    UINT           dpi_hosting;       /* DPI_HOSTING_BEHAVIOR of windows created by the thread */
 };
 
 static inline struct ntuser_thread_info *NtUserGetThreadInfo(void)
@@ -1471,6 +1472,7 @@
     NtUserCallHwnd_GetParent,
     NtUserCallHwnd_GetWindowContextHelpId,
     NtUserCallHwnd_GetWindowDpiAwarenessContext,
+    NtUserCallHwnd_GetWindowDpiHostingBehavior,
     NtUserCallHwnd_GetWindowInputContext,
     NtUserCallHwnd_GetWindowSysSubMenu,
     NtUserCallHwnd_GetWindowTextLength,
@@ -1538,6 +1540,11 @@
     return NtUserCallHwnd( hwnd, NtUserCallHwnd_GetWindowDpiAwarenessContext );
 }
 
+static inline UINT NtUserGetWindowDpiHostingBehavior( HWND hwnd )
+{
+    return NtUserCallHwnd( hwnd, NtUserCallHwnd_GetWindowDpiHostingBehavior );
+}
+
 static inline HIMC NtUserGetWindowInputContext( HWND hwnd )
 {
     return UlongToHandle( NtUserCallHwnd( hwnd, NtUserCallHwnd_GetWindowInputContext ));
diff --git a/dlls/win32u/ntuser_private.h b/dlls/win32u/ntuser_private.h
--- a/dlls/win32u/ntuser_private.h
+++ b/dlls/win32u/ntuser_private.h
@@ -95,6 +95,7 @@
 #define WIN_NEEDS_SHOW_OWNEDPOPUP 0x0020 /* WM_SHOWWINDOW:SC_SHOW must be sent in the next ShowOwnedPopup call */
 #define WIN_CHILDREN_MOVED        0x0040 /* children may have moved, ignore stored positions */
 #define WIN_HAS_IME_WIN           0x0080 /* the window has been registered with imm32 */
+#define WIN_DPI_MIXED_HOSTING     0x0100 /* created by a thread with DPI_HOSTING_BEHAVIOR_MIXED */
 
 #define WND_OTHER_PROCESS ((WND *)1)  /* returned by get_win_ptr on unknown window handles */
 #define WND_DESKTOP       ((WND *)2)  /* returned by get_win_ptr on the desktop window */
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -5748,6 +5748,7 @@
     win->winproc    = get_class_winproc( class );
     win->cbWndExtra = extra_bytes;
     win->dpi_context = dpi_context;
+    if (NtUserGetThreadInfo()->dpi_hosting) win->flags |= WIN_DPI_MIXED_HOSTING;
     list_init( &win->vulkan_surfaces );
     set_user_handle_ptr( handle, &win->obj );
     if (is_winproc_unicode( win->winproc, !ansi )) win->flags |= WIN_ISUNICODE;
@@ -6247,6 +6248,20 @@
     case NtUserCallHwnd_GetWindowDpiAwarenessContext:
         return get_window_dpi_awareness_context( hwnd );
 
+    case NtUserCallHwnd_GetWindowDpiHostingBehavior:
+#ifdef SG_MUTANT_DPIHOST_STUB
+        return 0;
+#endif
+#ifdef SG_MUTANT_DPIHOST_LIVE
+        return NtUserGetThreadInfo()->dpi_hosting ? 1 : 0;
+#endif
+        if (!is_window( hwnd ))
+        {
+            RtlSetLastWin32Error( ERROR_INVALID_WINDOW_HANDLE );
+            return (UINT)-1;  /* DPI_HOSTING_BEHAVIOR_INVALID */
+        }
+        return (win_get_flags( hwnd ) & WIN_DPI_MIXED_HOSTING) ? 1 : 0;
+
     case NtUserCallHwnd_GetWindowInputContext:
         return HandleToUlong( get_window_input_context( hwnd ));
 
diff --git a/dlls/user32/win.c b/dlls/user32/win.c
--- a/dlls/user32/win.c
+++ b/dlls/user32/win.c
@@ -635,8 +635,8 @@
  */
 DPI_HOSTING_BEHAVIOR WINAPI GetWindowDpiHostingBehavior( HWND hwnd )
 {
-    FIXME("(%p): stub\n", hwnd);
-    return DPI_HOSTING_BEHAVIOR_DEFAULT;
+    /* the behavior of the thread that created the window, kept for good */
+    return (DPI_HOSTING_BEHAVIOR)NtUserGetWindowDpiHostingBehavior( hwnd );
 }
 
 
diff --git a/dlls/user32/sysparams.c b/dlls/user32/sysparams.c
--- a/dlls/user32/sysparams.c
+++ b/dlls/user32/sysparams.c
@@ -926,6 +926,8 @@
     old = (DPI_HOSTING_BEHAVIOR)(INT_PTR)TlsGetValue( index );
     TlsSetValue( index, (void *)(INT_PTR)value );
 #endif
+    /* win32u gives the windows this thread creates from now on their hosting behavior */
+    NtUserGetThreadInfo()->dpi_hosting = value;
     return old;
 }
 
