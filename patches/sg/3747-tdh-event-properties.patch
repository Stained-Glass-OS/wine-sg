+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <wchar.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "winsock2.h"
+#include "ws2tcpip.h"
+#include "sddl.h"
+#include "wmistr.h"
+#include "evntrace.h"
+#include "evntprov.h"
+#include "evntcons.h"
+#include "wine/debug.h"
+#include "tdh_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(tdh);
+
+/* TDH_IN_TYPE and TDH_OUT_TYPE (the MS documentation of EVENT_PROPERTY_INFO) */
+enum
+{
+    IN_NULL, IN_UNICODESTRING, IN_ANSISTRING, IN_INT8, IN_UINT8, IN_INT16, IN_UINT16, IN_INT32, IN_UINT32,
+    IN_INT64, IN_UINT64, IN_FLOAT, IN_DOUBLE, IN_BOOLEAN, IN_BINARY, IN_GUID, IN_POINTER, IN_FILETIME,
+    IN_SYSTEMTIME, IN_SID, IN_HEXINT32, IN_HEXINT64, IN_COUNTEDSTRING, IN_COUNTEDANSISTRING,
+    IN_REVERSEDCOUNTEDSTRING, IN_REVERSEDCOUNTEDANSISTRING, IN_NONNULLTERMINATEDSTRING,
+    IN_NONNULLTERMINATEDANSISTRING, IN_UNICODECHAR, IN_ANSICHAR, IN_SIZET, IN_HEXDUMP, IN_WBEMSID
+};
+enum
+{
+    OUT_NULL, OUT_STRING, OUT_DATETIME, OUT_BYTE, OUT_UNSIGNEDBYTE, OUT_SHORT, OUT_UNSIGNEDSHORT, OUT_INT,
+    OUT_UNSIGNEDINT, OUT_LONG, OUT_UNSIGNEDLONG, OUT_FLOAT, OUT_DOUBLE, OUT_BOOLEAN, OUT_GUID, OUT_HEXBINARY,
+    OUT_HEXINT8, OUT_HEXINT16, OUT_HEXINT32, OUT_HEXINT64, OUT_PID, OUT_TID, OUT_PORT, OUT_IPV4, OUT_IPV6,
+    OUT_SOCKETADDRESS, OUT_CIMDATETIME, OUT_ETWTIME, OUT_XML, OUT_ERRORCODE, OUT_WIN32ERROR, OUT_NTSTATUS,
+    OUT_HRESULT, OUT_CULTURE_INSENSITIVE_DATETIME, OUT_JSON, OUT_UTF8
+};
+
+/* EVENT_PROPERTY_INFO flags */
+#define PropertyStruct           0x1
+#define PropertyParamLength      0x2
+#define PropertyParamCount       0x4
+#define PropertyParamFixedLength 0x10
+#define PropertyParamFixedCount  0x20
+
+typedef struct { ULONGLONG PropertyName; ULONG ArrayIndex; ULONG Reserved; } PROPERTY_DATA_DESCRIPTOR_PUBLIC;
+
+#define ARRAY_INDEX_NONE 0xffffffff
+
+/* the TRACE_EVENT_INFO of the event, from the loaded manifests */
+static ULONG load_info(const EVENT_RECORD *event, TRACE_EVENT_INFO_PUBLIC **ret)
+{
+    TRACE_EVENT_INFO_PUBLIC *info = NULL;
+    ULONG size = 0, err;
+
+    if (event->EventHeader.Flags & (EVENT_HEADER_FLAG_TRACE_MESSAGE | EVENT_HEADER_FLAG_CLASSIC_HEADER))
+        return ERROR_NOT_FOUND;
+    err = tdh_get_event_info(event, NULL, &size);
+    if (err != ERROR_INSUFFICIENT_BUFFER) return err ? err : ERROR_NOT_FOUND;
+    if (!(info = malloc(size))) return ERROR_OUTOFMEMORY;
+    if ((err = tdh_get_event_info(event, info, &size))) { free(info); return err; }
+    *ret = info;
+    return ERROR_SUCCESS;
+}
+
+static const WCHAR *info_string(const TRACE_EVENT_INFO_PUBLIC *info, ULONG offset)
+{
+    return offset ? (const WCHAR *)((const BYTE *)info + offset) : NULL;
+}
+
+static ULONG pointer_size(const EVENT_RECORD *event)
+{
+    if (event->EventHeader.Flags & EVENT_HEADER_FLAG_32_BIT_HEADER) return 4;
+    if (event->EventHeader.Flags & EVENT_HEADER_FLAG_64_BIT_HEADER) return 8;
+    return sizeof(void *);
+}
+
+struct reader
+{
+    const EVENT_RECORD *event;
+    const TRACE_EVENT_INFO_PUBLIC *info;
+    ULONG ptr_size;
+    const BYTE *data;
+    ULONG length;
+};
+
+/* the size of one value of the in type at data[offset]; ERROR_EVT_INVALID_EVENT_DATA when the data is too short */
+static ULONG value_size(const struct reader *r, USHORT in, BOOL has_len, ULONG len, ULONG offset, ULONG *size)
+{
+    const BYTE *p = r->data + offset;
+    ULONG avail = offset <= r->length ? r->length - offset : 0, n;
+
+    switch (in)
+    {
+    case IN_NULL: *size = 0; return ERROR_SUCCESS;
+    case IN_INT8: case IN_UINT8: case IN_ANSICHAR: *size = 1; break;
+    case IN_INT16: case IN_UINT16: case IN_UNICODECHAR: *size = 2; break;
+    case IN_INT32: case IN_UINT32: case IN_FLOAT: case IN_BOOLEAN: case IN_HEXINT32: *size = 4; break;
+    case IN_INT64: case IN_UINT64: case IN_DOUBLE: case IN_FILETIME: case IN_HEXINT64: *size = 8; break;
+    case IN_GUID: case IN_SYSTEMTIME: *size = 16; break;
+    case IN_POINTER: case IN_SIZET: *size = r->ptr_size; break;
+    case IN_UNICODESTRING:
+        if (has_len) { *size = len * sizeof(WCHAR); break; }
+        for (n = 0; n + 1 < avail; n += 2) if (!p[n] && !p[n + 1]) { *size = n + 2; return ERROR_SUCCESS; }
+        return ERROR_EVT_INVALID_EVENT_DATA;
+    case IN_ANSISTRING:
+        if (has_len) { *size = len; break; }
+        for (n = 0; n < avail; n++) if (!p[n]) { *size = n + 1; return ERROR_SUCCESS; }
+        return ERROR_EVT_INVALID_EVENT_DATA;
+    case IN_BINARY: case IN_HEXDUMP:
+        *size = has_len ? len : avail;
+        break;
+    case IN_NONNULLTERMINATEDSTRING: case IN_NONNULLTERMINATEDANSISTRING:
+        *size = has_len ? len : avail;
+        break;
+    case IN_COUNTEDSTRING: case IN_COUNTEDANSISTRING:
+        if (avail < 2) return ERROR_EVT_INVALID_EVENT_DATA;
+        *size = 2 + (p[0] | (p[1] << 8));
+        break;
+    case IN_REVERSEDCOUNTEDSTRING: case IN_REVERSEDCOUNTEDANSISTRING:
+        if (avail < 2) return ERROR_EVT_INVALID_EVENT_DATA;
+        *size = 2 + ((p[0] << 8) | p[1]);
+        break;
+    case IN_SID: case IN_WBEMSID:
+    {
+        /* GUESS: a TOKEN_USER-sized header (a pointer and the attributes) in front of the SID */
+        ULONG header = r->ptr_size * 2;
+        if (avail < header + 8) return ERROR_EVT_INVALID_EVENT_DATA;
+        *size = header + 8 + p[header + 1] * 4;
+        break;
+    }
+    default:
+        return ERROR_EVT_INVALID_EVENT_DATA;
+    }
+    return *size > avail ? ERROR_EVT_INVALID_EVENT_DATA : ERROR_SUCCESS;
+}
+
+/* an integer property's value (the count or the length of a later property) */
+static BOOL read_uint(const struct reader *r, USHORT in, ULONG offset, ULONGLONG *value)
+{
+    const BYTE *p = r->data + offset;
+    ULONG size;
+
+    if (value_size(r, in, FALSE, 0, offset, &size)) return FALSE;
+    switch (in)
+    {
+    case IN_INT8: case IN_UINT8: *value = *p; return TRUE;
+    case IN_INT16: case IN_UINT16: *value = *(const UINT16 *)p; return TRUE;
+    case IN_INT32: case IN_UINT32: case IN_HEXINT32: *value = *(const UINT32 *)p; return TRUE;
+    case IN_INT64: case IN_UINT64: case IN_HEXINT64: *value = *(const UINT64 *)p; return TRUE;
+    default: return FALSE;
+    }
+}
+
+struct location { ULONG offset, size, count; BOOL array; USHORT in, out; USHORT length; BOOL is_struct; const EVENT_PROPERTY_INFO_PUBLIC *prop; };
+
+/* walk the top-level properties from the start of the data; the one at `want` is described in *loc */
+static ULONG walk(const struct reader *r, ULONG want, ULONG array_index, struct location *loc)
+{
+    ULONG i, offset = 0, top = r->info->TopLevelPropertyCount;
+    struct { ULONG offset; USHORT in; } seen[256];
+
+    if (top > ARRAY_SIZE(seen)) return ERROR_NOT_SUPPORTED;
+    for (i = 0; i < top; i++)
+    {
+        const EVENT_PROPERTY_INFO_PUBLIC *prop = &r->info->EventPropertyInfoArray[i];
+        ULONG count = 1, start = offset, k, element_start = offset, element_size = 0, len = 0, err;
+        BOOL array = FALSE, has_len = FALSE;
+        ULONGLONG v;
+
+        seen[i].offset = offset;
+        seen[i].in = prop->Flags & PropertyStruct ? IN_NULL : prop->u.nonStructType.InType;
+
+        if (prop->Flags & PropertyParamCount)
+        {
+            if (prop->count >= i || !read_uint(r, seen[prop->count].in, seen[prop->count].offset, &v)) return ERROR_EVT_INVALID_EVENT_DATA;
+            count = v;
+            array = TRUE;
+        }
+        else if ((prop->Flags & PropertyParamFixedCount) || prop->count > 1)
+        {
+            count = prop->count;
+            array = TRUE;
+        }
+        if (!(prop->Flags & PropertyStruct))
+        {
+            if (prop->Flags & PropertyParamLength)
+            {
+                if (prop->length >= i || !read_uint(r, seen[prop->length].in, seen[prop->length].offset, &v)) return ERROR_EVT_INVALID_EVENT_DATA;
+                len = v;
+                has_len = TRUE;
+            }
+            else if (prop->length) { len = prop->length; has_len = TRUE; }
+        }
+
+        for (k = 0; k < count; k++)
+        {
+            ULONG size = 0, m;
+
+            if (prop->Flags & PropertyStruct)
+            {
+                for (m = 0; m < prop->u.structType.NumOfStructMembers; m++)
+                {
+                    const EVENT_PROPERTY_INFO_PUBLIC *member = &r->info->EventPropertyInfoArray[prop->u.structType.StructStartIndex + m];
+                    ULONG msize = 0;
+                    if (member->count > 1) return ERROR_NOT_SUPPORTED;     /* arrays inside structs: not decoded */
+                    if ((err = value_size(r, member->u.nonStructType.InType, member->length != 0 || (member->Flags & PropertyParamFixedLength),
+                                          member->length, offset + size, &msize))) return err;
+                    size += msize;
+                }
+            }
+            else if ((err = value_size(r, prop->u.nonStructType.InType, has_len, len, offset, &size))) return err;
+            if (i == want && (!array || array_index == ARRAY_INDEX_NONE || array_index == k))
+            {
+                if (array_index == k || !array) { element_start = offset; element_size = size; }
+            }
+            offset += size;
+        }
+        if (i == want)
+        {
+            if (array && array_index != ARRAY_INDEX_NONE && array_index >= count) return ERROR_EVT_INVALID_QUERY;
+            loc->array = array;
+            loc->count = count;
+            loc->prop = prop;
+            loc->is_struct = !!(prop->Flags & PropertyStruct);
+            loc->in = loc->is_struct ? IN_NULL : prop->u.nonStructType.InType;
+            loc->out = loc->is_struct ? OUT_NULL : prop->u.nonStructType.OutType;
+            loc->length = has_len ? len : 0;
+            if (array && array_index == ARRAY_INDEX_NONE) { loc->offset = start; loc->size = offset - start; }
+            else { loc->offset = element_start; loc->size = element_size; }
+            return ERROR_SUCCESS;
+        }
+    }
+    return ERROR_NOT_FOUND;
+}
+
+static ULONG find_property(const struct reader *r, const PROPERTY_DATA_DESCRIPTOR_PUBLIC *desc, struct location *loc)
+{
+    const WCHAR *name = (const WCHAR *)(ULONG_PTR)desc->PropertyName;
+    ULONG i;
+
+    if (!name) return ERROR_INVALID_PARAMETER;
+    for (i = 0; i < r->info->TopLevelPropertyCount; i++)
+    {
+        const WCHAR *n = info_string(r->info, r->info->EventPropertyInfoArray[i].NameOffset);
+        if (n && !wcsicmp(n, name)) return walk(r, i, desc->ArrayIndex, loc);
+    }
+    return ERROR_NOT_FOUND;
+}
+
+static ULONG open_reader(const EVENT_RECORD *event, ULONG count, const PROPERTY_DATA_DESCRIPTOR_PUBLIC *desc,
+                         TRACE_EVENT_INFO_PUBLIC **info, struct reader *r)
+{
+    ULONG err;
+
+    if (!event || !desc || !count) return ERROR_INVALID_PARAMETER;
+    if ((err = load_info(event, info))) return err;
+    r->event = event;
+    r->info = *info;
+    r->ptr_size = pointer_size(event);
+    r->data = event->UserData;
+    r->length = event->UserDataLength;
+    return ERROR_SUCCESS;
+}
+
+ULONG WINAPI TdhGetPropertySize(EVENT_RECORD *event, ULONG context_count, void *context, ULONG count,
+                                PROPERTY_DATA_DESCRIPTOR_PUBLIC *desc, ULONG *size)
+{
+    TRACE_EVENT_INFO_PUBLIC *info;
+    struct reader r;
+    ULONG i, total = 0, err;
+
+    TRACE("(%p %lu %p %lu %p %p)\n", event, context_count, context, count, desc, size);
+
+    if (!size || (context_count && !context)) return ERROR_INVALID_PARAMETER;
+    if ((err = open_reader(event, count, desc, &info, &r))) return err;
+    for (i = 0; i < count && !err; i++)
+    {
+        struct location loc;
+        if (!(err = find_property(&r, &desc[i], &loc)))
+        {
+            if (loc.is_struct) err = ERROR_NOT_SUPPORTED;
+            else total += loc.size;
+        }
+    }
+    free(info);
+    if (!err) *size = total;
+    return err;
+}
+
+ULONG WINAPI TdhGetProperty(EVENT_RECORD *event, ULONG context_count, void *context, ULONG count,
+                            PROPERTY_DATA_DESCRIPTOR_PUBLIC *desc, ULONG buffer_size, BYTE *buffer)
+{
+    TRACE_EVENT_INFO_PUBLIC *info;
+    struct reader r;
+    ULONG i, total = 0, pos = 0, err;
+    struct location *locs;
+
+    TRACE("(%p %lu %p %lu %p %lu %p)\n", event, context_count, context, count, desc, buffer_size, buffer);
+
+    if ((context_count && !context) || (buffer_size && !buffer)) return ERROR_INVALID_PARAMETER;
+    if ((err = open_reader(event, count, desc, &info, &r))) return err;
+    if (!(locs = calloc(count, sizeof(*locs)))) { free(info); return ERROR_OUTOFMEMORY; }
+    for (i = 0; i < count && !err; i++)
+    {
+        if (!(err = find_property(&r, &desc[i], &locs[i])))
+        {
+            if (locs[i].is_struct) err = ERROR_NOT_SUPPORTED;
+            else total += locs[i].size;
+        }
+    }
+    if (!err && buffer_size < total) err = ERROR_INSUFFICIENT_BUFFER;
+    if (!err)
+        for (i = 0; i < count; i++)
+        {
+            memcpy(buffer + pos, r.data + locs[i].offset, locs[i].size);
+            pos += locs[i].size;
+        }
+    free(locs);
+    free(info);
+    return err;
+}
+
+/* ---- formatting ---- */
+
+struct out { WCHAR *buf; ULONG cap, len; BOOL overflow; };
+
+static void out_str(struct out *o, const WCHAR *s, ULONG n)
+{
+    if (o->len + n < o->cap && o->buf) memcpy(o->buf + o->len, s, n * sizeof(WCHAR));
+    else o->overflow = TRUE;
+    o->len += n;
+}
+
+static void out_fmt(struct out *o, const WCHAR *fmt, ...)
+{
+    WCHAR tmp[256];
+    va_list ap;
+    int n;
+
+    va_start(ap, fmt);
+    n = vswprintf(tmp, ARRAY_SIZE(tmp), fmt, ap);
+    va_end(ap);
+    if (n > 0) out_str(o, tmp, n);
+}
+
+static void out_hex(struct out *o, const BYTE *p, ULONG n, BOOL prefix)
+{
+    ULONG i;
+    if (prefix) out_str(o, L"0x", 2);
+    for (i = 0; i < n; i++) out_fmt(o, L"%02X", p[i]);
+}
+
+static ULONGLONG get_le(const BYTE *p, ULONG n)
+{
+    ULONGLONG v = 0;
+    ULONG i;
+    for (i = 0; i < n; i++) v |= (ULONGLONG)p[i] << (8 * i);
+    return v;
+}
+
+static LONGLONG sign_extend(ULONGLONG v, ULONG n)
+{
+    if (n < 8 && (v & (1ull << (n * 8 - 1)))) v |= ~0ull << (n * 8);
+    return (LONGLONG)v;
+}
+
+/* the text of the entry of the map: a value map by equal value, a bit map as the names of the bits set, joined by " | " */
+static BOOL map_text(struct out *o, const void *map_buf, ULONGLONG value)
+{
+    const BYTE *base = map_buf;
+    const struct { ULONG NameOffset, Flag, EntryCount, ValueType; struct { ULONG OutputOffset, Value; } Entries[1]; } *m = map_buf;
+    ULONG i;
+    BOOL first = TRUE;
+
+    if (!m) return FALSE;
+    if (m->Flag & 0x2)   /* bit map */
+    {
+        ULONGLONG left = value;
+        for (i = 0; i < m->EntryCount; i++)
+            if (m->Entries[i].Value && (value & m->Entries[i].Value) == m->Entries[i].Value)
+            {
+                const WCHAR *t = (const WCHAR *)(base + m->Entries[i].OutputOffset);
+                if (!first) out_str(o, L" | ", 3);
+                out_str(o, t, wcslen(t));
+                left &= ~(ULONGLONG)m->Entries[i].Value;
+                first = FALSE;
+            }
+        if (left && !first) { out_str(o, L" | ", 3); out_fmt(o, L"0x%llX", left); }
+        return !first;
+    }
+    for (i = 0; i < m->EntryCount; i++)
+        if (m->Entries[i].Value == value)
+        {
+            const WCHAR *t = (const WCHAR *)(base + m->Entries[i].OutputOffset);
+            out_str(o, t, wcslen(t));
+            return TRUE;
+        }
+    return FALSE;
+}
+
+ULONG WINAPI TdhFormatProperty(void *event_info, void *map_info, ULONG pointer_size, USHORT in, USHORT out_type,
+                               USHORT length, USHORT user_len, BYTE *user_data, ULONG *buffer_size, WCHAR *buffer,
+                               USHORT *consumed)
+{
+    struct reader r = { 0 };
+    struct out o = { buffer, buffer_size ? *buffer_size / sizeof(WCHAR) : 0, 0, FALSE };
+    ULONG size = 0, err;
+    ULONGLONG u;
+    const BYTE *p = user_data;
+
+    TRACE("(%p %p %lu %u %u %u %u %p %p %p %p)\n", event_info, map_info, pointer_size, in, out_type, length,
+          user_len, user_data, buffer_size, buffer, consumed);
+
+    if (!buffer_size || !consumed || (*buffer_size && !buffer) || (!user_data && user_len)) return ERROR_INVALID_PARAMETER;
+    if (pointer_size != 4 && pointer_size != 8) return ERROR_INVALID_PARAMETER;
+    r.ptr_size = pointer_size;
+    r.data = user_data;
+    r.length = user_len;
+    if ((err = value_size(&r, in, length != 0, length, 0, &size))) return err;
+
+    switch (in)
+    {
+    case IN_NULL: break;
+    case IN_UNICODESTRING: case IN_NONNULLTERMINATEDSTRING:
+    {
+        ULONG n = size / sizeof(WCHAR);
+        if (in == IN_UNICODESTRING && !length && n && !((const WCHAR *)p)[n - 1]) n--;
+        out_str(&o, (const WCHAR *)p, n);
+        break;
+    }
+    case IN_COUNTEDSTRING: case IN_REVERSEDCOUNTEDSTRING:
+        out_str(&o, (const WCHAR *)(p + 2), (size - 2) / sizeof(WCHAR));
+        break;
+    case IN_ANSISTRING: case IN_NONNULLTERMINATEDANSISTRING: case IN_COUNTEDANSISTRING: case IN_REVERSEDCOUNTEDANSISTRING:
+    {
+        const BYTE *s = p + (in == IN_COUNTEDANSISTRING || in == IN_REVERSEDCOUNTEDANSISTRING ? 2 : 0);
+        ULONG n = size - (s - p), wn;
+        WCHAR *tmp;
+
+        if (in == IN_ANSISTRING && !length && n && !s[n - 1]) n--;
+        wn = MultiByteToWideChar(CP_ACP, 0, (const char *)s, n, NULL, 0);
+        if ((tmp = malloc((wn + 1) * sizeof(WCHAR))))
+        {
+            MultiByteToWideChar(CP_ACP, 0, (const char *)s, n, tmp, wn);
+            out_str(&o, tmp, wn);
+            free(tmp);
+        }
+        break;
+    }
+    case IN_UNICODECHAR: out_str(&o, (const WCHAR *)p, 1); break;
+    case IN_ANSICHAR: { WCHAR c = *p; out_str(&o, &c, 1); break; }
+    case IN_BOOLEAN:
+        u = get_le(p, 4);
+        out_str(&o, u ? L"true" : L"false", u ? 4 : 5);
+        break;
+    case IN_FLOAT: { float f; memcpy(&f, p, 4); out_fmt(&o, L"%g", (double)f); break; }
+    case IN_DOUBLE: { double d; memcpy(&d, p, 8); out_fmt(&o, L"%g", d); break; }
+    case IN_GUID:
+    {
+        const GUID *g = (const GUID *)p;
+        out_fmt(&o, L"{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}", g->Data1, g->Data2, g->Data3, g->Data4[0],
+                g->Data4[1], g->Data4[2], g->Data4[3], g->Data4[4], g->Data4[5], g->Data4[6], g->Data4[7]);
+        break;
+    }
+    case IN_FILETIME:
+    case IN_SYSTEMTIME:
+    {
+        SYSTEMTIME st;
+        if (in == IN_FILETIME)
+        {
+            FILETIME ft;
+            memcpy(&ft, p, 8);
+            FileTimeToSystemTime(&ft, &st);
+        }
+        else memcpy(&st, p, sizeof(st));
+        /* GUESS: ISO 8601, in UTC with fractional seconds */
+        out_fmt(&o, L"%04u-%02u-%02uT%02u:%02u:%02u.%03uZ", st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute,
+                st.wSecond, st.wMilliseconds);
+        break;
+    }
+    case IN_SID: case IN_WBEMSID:
+    {
+        WCHAR *str = NULL;
+        if (ConvertSidToStringSidW((PSID)(p + pointer_size * 2), &str)) { out_str(&o, str, wcslen(str)); LocalFree(str); }
+        break;
+    }
+    case IN_BINARY: case IN_HEXDUMP:
+        out_hex(&o, p, size, TRUE);
+        break;
+    default:   /* the integer types and pointers */
+    {
+        BOOL is_signed = in == IN_INT8 || in == IN_INT16 || in == IN_INT32 || in == IN_INT64;
+        BOOL map_done = FALSE;
+
+        u = get_le(p, size);
+        if (map_info && map_text(&o, map_info, u)) { map_done = TRUE; }
+        if (map_done) break;
+        switch (out_type)
+        {
+        case OUT_HEXINT8: case OUT_HEXINT16: case OUT_HEXINT32: case OUT_HEXINT64:
+            out_fmt(&o, L"0x%llX", u);
+            goto done;
+        case OUT_IPV4:
+            out_fmt(&o, L"%u.%u.%u.%u", (UINT)(u & 0xff), (UINT)((u >> 8) & 0xff), (UINT)((u >> 16) & 0xff), (UINT)((u >> 24) & 0xff));
+            goto done;
+        case OUT_PORT:
+            out_fmt(&o, L"%u", (UINT)(((u & 0xff) << 8) | ((u >> 8) & 0xff)));
+            goto done;
+        case OUT_HRESULT: case OUT_NTSTATUS: case OUT_ERRORCODE:
+            out_fmt(&o, L"0x%X", (UINT)u);
+            goto done;
+        case OUT_BOOLEAN:
+            out_str(&o, u ? L"true" : L"false", u ? 4 : 5);
+            goto done;
+        }
+        if (in == IN_POINTER || in == IN_SIZET) out_fmt(&o, L"0x%llX", u);
+        else if (in == IN_HEXINT32 || in == IN_HEXINT64) out_fmt(&o, L"0x%llX", u);
+        else if (is_signed) out_fmt(&o, L"%lld", sign_extend(u, size));
+        else out_fmt(&o, L"%llu", u);
+        break;
+    }
+    }
+done:
+    *consumed = size;
+    if (o.overflow || !buffer || o.len + 1 > o.cap)
+    {
+        *buffer_size = (o.len + 1) * sizeof(WCHAR);
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    buffer[o.len] = 0;
+    *buffer_size = (o.len + 1) * sizeof(WCHAR);
+    return ERROR_SUCCESS;
+}
+
+ULONG WINAPI TdhGetEventMapInformation(EVENT_RECORD *event, WCHAR *map_name, void *buffer, ULONG *size)
+{
+    TRACE("(%p %s %p %p)\n", event, debugstr_w(map_name), buffer, size);
+
+    if (!event || !map_name || !size || (*size && !buffer)) return ERROR_INVALID_PARAMETER;
+    return tdh_get_map_info(event, map_name, buffer, size);
+}
+
+ULONG WINAPI TdhEnumerateManifestProviderEvents(GUID *provider, void *buffer, ULONG *size)
+{
+    TRACE("(%s %p %p)\n", debugstr_guid(provider), buffer, size);
+
+    if (!provider || !size || (*size && !buffer)) return ERROR_INVALID_PARAMETER;
+    return tdh_enum_provider_events(provider, buffer, size);
+}
