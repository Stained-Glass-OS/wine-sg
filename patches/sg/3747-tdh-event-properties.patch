+
+/* ---- value and bit maps ---- */
+
+/* The layouts of EVENT_MAP_INFO and EVENT_MAP_ENTRY (the MS documentation of TdhGetEventMapInformation). */
+typedef struct { ULONG OutputOffset; ULONG Value; } EVENT_MAP_ENTRY_PUBLIC;
+typedef struct
+{
+    ULONG NameOffset;
+    ULONG Flag;
+    ULONG EntryCount;
+    ULONG MapEntryValueType;
+    EVENT_MAP_ENTRY_PUBLIC MapEntryArray[1];
+} EVENT_MAP_INFO_PUBLIC;
+
+#define EVENTMAP_INFO_FLAG_MANIFEST_VALUEMAP 0x1
+#define EVENTMAP_INFO_FLAG_MANIFEST_BITMAP   0x2
+
+/* the map named name of the provider of the event, from the loaded manifests */
+ULONG tdh_get_map_info(const EVENT_RECORD *event, const WCHAR *name, void *out_buf, ULONG *size)
+{
+    EVENT_MAP_INFO_PUBLIC *out = out_buf;
+    struct manifest *m;
+    struct provider *p;
+    struct map *map = NULL;
+    struct builder b = { 0 };
+    ULONG i, header, ret;
+
+    EnterCriticalSection(&manifest_cs);
+    if (!(p = find_provider(&event->EventHeader.ProviderId, &m))) { ret = ERROR_NOT_FOUND; goto done; }
+    for (i = 0; i < p->map_count; i++)
+        if (p->maps[i].name && !wcscmp(p->maps[i].name, name)) { map = &p->maps[i]; break; }
+    if (!map) { ret = ERROR_NOT_FOUND; goto done; }
+
+    header = offsetof(EVENT_MAP_INFO_PUBLIC, MapEntryArray) + (map->count ? map->count : 1) * sizeof(EVENT_MAP_ENTRY_PUBLIC);
+    reserve(&b, header);
+    ((EVENT_MAP_INFO_PUBLIC *)b.buf)->NameOffset = add_string(&b, name);
+    ((EVENT_MAP_INFO_PUBLIC *)b.buf)->Flag = map->bitmap ? EVENTMAP_INFO_FLAG_MANIFEST_BITMAP : EVENTMAP_INFO_FLAG_MANIFEST_VALUEMAP;
+    ((EVENT_MAP_INFO_PUBLIC *)b.buf)->EntryCount = map->count;
+    ((EVENT_MAP_INFO_PUBLIC *)b.buf)->MapEntryValueType = 0;   /* EVENTMAP_ENTRY_VALUETYPE_ULONG */
+    for (i = 0; i < map->count; i++)
+    {
+        const WCHAR *text = resolve_text(m, map->entries[i].message);
+        ULONG off = add_string(&b, text ? text : map->entries[i].message);
+        ((EVENT_MAP_INFO_PUBLIC *)b.buf)->MapEntryArray[i].OutputOffset = off;
+        ((EVENT_MAP_INFO_PUBLIC *)b.buf)->MapEntryArray[i].Value = map->entries[i].value;
+    }
+    if (!out || *size < b.size) ret = ERROR_INSUFFICIENT_BUFFER;
+    else { memcpy(out, b.buf, b.size); ret = ERROR_SUCCESS; }
+    *size = b.size;
+done:
+    LeaveCriticalSection(&manifest_cs);
+    free(b.buf);
+    return ret;
+}
+
+/* The documented PROVIDER_EVENT_INFO: the count, then the descriptors of the events the manifest declares. */
+ULONG tdh_enum_provider_events(const GUID *guid, void *out_buf, ULONG *size)
+{
+    struct { ULONG NumberOfEvents; ULONG Reserved; EVENT_DESCRIPTOR EventDescriptorsArray[1]; } *out = out_buf;
+    struct manifest *m;
+    struct provider *p;
+    ULONG i, needed, ret = ERROR_SUCCESS;
+
+    EnterCriticalSection(&manifest_cs);
+    if (!(p = find_provider(guid, &m))) { LeaveCriticalSection(&manifest_cs); return ERROR_NOT_FOUND; }
+    needed = offsetof(__typeof__(*out), EventDescriptorsArray) + p->event_count * sizeof(EVENT_DESCRIPTOR);
+    if (!out || *size < needed)
+    {
+        *size = needed;
+        LeaveCriticalSection(&manifest_cs);
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    out->NumberOfEvents = p->event_count;
+    out->Reserved = 0;
+    /* the descriptor is what TdhGetEventInformation resolves for the event (level, opcode, task, keywords) */
+    for (i = 0; i < p->event_count && !ret; i++)
+    {
+        EVENT_RECORD rec = { 0 };
+        TRACE_EVENT_INFO_PUBLIC *info;
+        ULONG info_size = 0;
+
+        rec.EventHeader.ProviderId = *guid;
+        rec.EventHeader.EventDescriptor.Id = p->events[i].id;
+        rec.EventHeader.EventDescriptor.Version = p->events[i].version;
+        tdh_get_event_info(&rec, NULL, &info_size);
+        if (!(info = malloc(info_size))) { ret = ERROR_OUTOFMEMORY; break; }
+        if (!(ret = tdh_get_event_info(&rec, info, &info_size))) out->EventDescriptorsArray[i] = info->EventDescriptor;
+        free(info);
+    }
+    *size = needed;
+    LeaveCriticalSection(&manifest_cs);
+    return ret;
+}
