- * OFN_NODEREFERENCELINKS, OFN_NOREADONLYRETURN,
+ * FIXME: flags not implemented: OFN_NODEREFERENCELINKS,
  * OFN_NOTESTFILECREATE, OFN_USEMONIKERS
  *
  * FIXME: lCustData for lpfnHook (WM_INITDIALOG)
@@ -75,8 +72,7 @@
 WINE_DEFAULT_DEBUG_CHANNEL(commdlg);
 
 #define UNIMPLEMENTED_FLAGS \
-(OFN_DONTADDTORECENT |\
-OFN_NODEREFERENCELINKS | OFN_NOREADONLYRETURN |\
+(OFN_NODEREFERENCELINKS |\
 OFN_NOTESTFILECREATE /*| OFN_USEMONIKERS*/)
 
 /***********************************************************************
@@ -589,7 +585,7 @@
 
     IFileDialog_GetOptions(dlg, &opts);
     opts |= FOS_FORCEFILESYSTEM | FOS_NOCHANGEDIR;
-    opts &= ~(FOS_FILEMUSTEXIST | FOS_PATHMUSTEXIST | FOS_OVERWRITEPROMPT);
+    opts &= ~(FOS_FILEMUSTEXIST | FOS_PATHMUSTEXIST | FOS_OVERWRITEPROMPT | FOS_NOREADONLYRETURN);
     if (flags & OFN_ALLOWMULTISELECT) opts |= FOS_ALLOWMULTISELECT;
     if (flags & OFN_FILEMUSTEXIST) opts |= FOS_FILEMUSTEXIST;
     if (flags & OFN_PATHMUSTEXIST) opts |= FOS_PATHMUSTEXIST;
@@ -600,6 +596,7 @@
     if (flags & OFN_NOVALIDATE) opts |= FOS_NOVALIDATE;
     if (flags & OFN_NOREADONLYRETURN) opts |= FOS_NOREADONLYRETURN;
     if (flags & OFN_NOTESTFILECREATE) opts |= FOS_NOTESTFILECREATE;
+    if (flags & OFN_DONTADDTORECENT) opts |= FOS_DONTADDTORECENT;
     IFileDialog_SetOptions(dlg, opts);
 
     /* the filters: "Name\0Spec\0...\0" */
