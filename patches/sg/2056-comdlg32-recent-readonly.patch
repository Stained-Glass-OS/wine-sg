From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comdlg32: recent documents from the open dialog, read-only files refused on request (2056)

comdlg32: open dialog adds to recent documents, read-only files refused on request.

The file (or each of several) chosen in an open or save dialog that went
through the item dialog is added to the recent documents, unless the program
passed OFN_DONTADDTORECENT (folders and files that are not there are left out).
OFN_NOREADONLYRETURN is honoured: picking a read-only file gives the message
that it is read-only, and the dialog stays; a program that did not pass it
takes read-only files as before (the item dialog's own default was leaking
through). IFileDialog's FOS_NOREADONLYRETURN and FOS_DONTADDTORECENT work too.
---
--- a/dlls/comdlg32/itemdlg.c
+++ b/dlls/comdlg32/itemdlg.c
@@ -656,6 +656,78 @@
     return result;
 }
 
+/* A dialog that does not return read-only files says so when one is picked */
+static BOOL results_may_be_returned(FileDialogImpl *This)
+{
+    DWORD count, i;
+    BOOL ok = TRUE;
+
+#ifdef SG_MUTANT_READONLY_RETURNED
+    return TRUE;
+#endif
+    if (!This->psia_results || FAILED(IShellItemArray_GetCount(This->psia_results, &count))) return TRUE;
+    for (i = 0; i < count && ok; i++)
+    {
+        IShellItem *item;
+        WCHAR *path;
+
+        if (FAILED(IShellItemArray_GetItemAt(This->psia_results, i, &item))) continue;
+        if (SUCCEEDED(IShellItem_GetDisplayName(item, SIGDN_FILESYSPATH, &path)))
+        {
+            DWORD attrs = GetFileAttributesW(path);
+
+            if (attrs != INVALID_FILE_ATTRIBUTES && (attrs & FILE_ATTRIBUTE_READONLY) && !(attrs & FILE_ATTRIBUTE_DIRECTORY))
+            {
+                static const WCHAR fallback[] = L"This file is read-only.\nTry again with a different file name.";
+                WCHAR text[MAX_PATH + 160], message[128];
+
+                if (!LoadStringW(COMDLG32_hInstance, IDS_READONLYFILE, message, ARRAY_SIZE(message))) lstrcpyW(message, fallback);
+                swprintf(text, ARRAY_SIZE(text), L"%ls\n%ls", path, message);
+                MessageBoxW(This->dlg_hwnd, text, This->custom_title, MB_OK | MB_ICONEXCLAMATION);
+                ok = FALSE;
+            }
+            CoTaskMemFree(path);
+        }
+        IShellItem_Release(item);
+    }
+    if (!ok)
+    {
+        IShellItemArray_Release(This->psia_results);
+        This->psia_results = NULL;
+    }
+    return ok;
+}
+
+/* The files picked go in the recent documents, unless the program said not to (or
+ * these are folders, or not there yet) */
+static void add_results_to_recent(FileDialogImpl *This)
+{
+    DWORD count, i;
+
+#ifdef SG_MUTANT_NO_RECENT
+    return;
+#endif
+    if ((This->options & (FOS_DONTADDTORECENT | FOS_PICKFOLDERS)) || !This->psia_results) return;
+    if (FAILED(IShellItemArray_GetCount(This->psia_results, &count))) return;
+
+    for (i = 0; i < count; i++)
+    {
+        IShellItem *item;
+        WCHAR *path;
+
+        if (FAILED(IShellItemArray_GetItemAt(This->psia_results, i, &item))) continue;
+        if (SUCCEEDED(IShellItem_GetDisplayName(item, SIGDN_FILESYSPATH, &path)))
+        {
+            DWORD attrs = GetFileAttributesW(path);
+
+            if (attrs != INVALID_FILE_ATTRIBUTES && !(attrs & FILE_ATTRIBUTE_DIRECTORY))
+                SHAddToRecentDocs(SHARD_PATHW, path);
+            CoTaskMemFree(path);
+        }
+        IShellItem_Release(item);
+    }
+}
+
 static HRESULT on_default_action(FileDialogImpl *This)
 {
     IShellFolder *psf_parent, *psf_desktop;
@@ -844,8 +916,14 @@
                     break;
             }
 
+            if((This->options & FOS_NOREADONLYRETURN) && !results_may_be_returned(This))
+                break;
+
             if(events_OnFileOk(This) == S_OK)
+            {
                 ret = S_OK;
+                add_results_to_recent(This);
+            }
         }
         break;
 
--- a/dlls/comdlg32/filedlg.c
+++ b/dlls/comdlg32/filedlg.c
@@ -34,10 +34,7 @@
  *
