From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] opengl32: wglGetDefaultProcAddress (3580)

opengl32: wglGetDefaultProcAddress returns the library's own OpenGL 1.1 entry points

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---
diff --git a/dlls/opengl32/wgl.c b/dlls/opengl32/wgl.c
index 01e0e66..5a527ad 100644
--- a/dlls/opengl32/wgl.c
+++ b/dlls/opengl32/wgl.c
@@ -1022,8 +1022,18 @@ int WINAPI wglSetLayerPaletteEntries(HDC hdc,
  */
 PROC WINAPI wglGetDefaultProcAddress( LPCSTR name )
 {
-    FIXME( "%s: stub\n", debugstr_a(name));
-    return NULL;
+    HMODULE module;
+    PROC proc = NULL;
+
+    TRACE( "%s\n", debugstr_a(name) );
+
+    /* the generic implementation: the OpenGL 1.1 entry points this library exports itself */
+    if (!name || name[0] != 'g' || name[1] != 'l') return NULL;
+    if (!(module = GetModuleHandleW( L"opengl32.dll" ))) return NULL;
+#ifndef SG_MUTANT_DEFAULT_PROC
+    proc = (PROC)GetProcAddress( module, name );
+#endif
+    return proc;
 }
 
 /***********************************************************************
