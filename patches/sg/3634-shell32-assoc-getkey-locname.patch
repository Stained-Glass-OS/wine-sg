+/* The desktop.ini that holds the localized name of a path: in the folder
+ * itself, or next to a file. Returns the section and key to use. */
+static HRESULT get_localized_name_ini(const WCHAR *path, WCHAR *ini, const WCHAR **section, WCHAR *key, BOOL create)
+{
+    DWORD attrs;
+    WCHAR *p;
+
+    if (!path || !*path || lstrlenW(path) >= MAX_PATH - 12)
+        return E_INVALIDARG;
+    if ((attrs = GetFileAttributesW(path)) == INVALID_FILE_ATTRIBUTES)
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    lstrcpyW(ini, path);
+    if (attrs & FILE_ATTRIBUTE_DIRECTORY)
+    {
+        PathAddBackslashW(ini);
+        lstrcatW(ini, L"desktop.ini");
+        *section = L".ShellClassInfo";
+        lstrcpyW(key, L"LocalizedResourceName");
+    }
+    else
+    {
+        lstrcpyW(key, PathFindFileNameW(ini));
+        if (!(p = PathFindFileNameW(ini)) || p == ini)
+            return E_INVALIDARG;
+        lstrcpyW(p, L"desktop.ini");
+        *section = L"LocalizedFileNames";
+    }
+    return S_OK;
+}
+
 /*************************************************************************
  *              SHRemoveLocalizedName (SHELL32.@)
  */
 HRESULT WINAPI SHRemoveLocalizedName(const WCHAR *path)
 {
-    FIXME("%s stub\n", debugstr_w(path));
+    const WCHAR *section;
+    WCHAR ini[MAX_PATH], key[MAX_PATH];
+    HRESULT hr;
+
+    TRACE("%s\n", debugstr_w(path));
+
+    if (FAILED(hr = get_localized_name_ini(path, ini, &section, key, FALSE)))
+        return hr;
+
+    if (GetFileAttributesW(ini) == INVALID_FILE_ATTRIBUTES)
+        return S_OK;
+
+    if (!WritePrivateProfileStringW(section, key, NULL, ini))
+        return HRESULT_FROM_WIN32(GetLastError());
     return S_OK;
 }
 
@@ -2240,8 +2284,62 @@ HRESULT WINAPI SHRemoveLocalizedName(const WCHAR *path)
  */
 HRESULT WINAPI SHSetLocalizedName(LPWSTR pszPath, LPCWSTR pszResModule, int idsRes)
 {
-    FIXME("%p, %s, %d - stub\n", pszPath, debugstr_w(pszResModule), idsRes);
+    const WCHAR *section;
+    WCHAR ini[MAX_PATH], key[MAX_PATH], value[MAX_PATH + 16];
+    HRESULT hr;
+
+    TRACE("%s, %s, %d\n", debugstr_w(pszPath), debugstr_w(pszResModule), idsRes);
+
+    if (!pszResModule || !*pszResModule)
+        return E_INVALIDARG;
+    if (FAILED(hr = get_localized_name_ini(pszPath, ini, &section, key, TRUE)))
+        return hr;
+
+    wsprintfW(value, L"@%s,-%d", pszResModule, idsRes);
+    if (!WritePrivateProfileStringW(section, key, value, ini))
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    /* desktop.ini is a hidden system file. */
+    SetFileAttributesW(ini, FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM);
+    return S_OK;
+}
 
+/*************************************************************************
+ *              SHGetLocalizedName (SHELL32.@)
+ */
+HRESULT WINAPI SHGetLocalizedName(LPCWSTR path, LPWSTR module, UINT size, INT *res)
+{
+    const WCHAR *section, *comma;
+    WCHAR ini[MAX_PATH], key[MAX_PATH], value[MAX_PATH + 16], expanded[MAX_PATH + 16];
+    HRESULT hr;
+    int id;
+
+    TRACE("%s %p %u %p\n", debugstr_w(path), module, size, res);
+
+#ifdef SG_MUTANT_SHELL_LOCNAME
+    return E_NOTIMPL;
+#endif
+    if (!module || !res)
+        return E_INVALIDARG;
+    if (FAILED(hr = get_localized_name_ini(path, ini, &section, key, FALSE)))
+        return hr;
+
+    if (!GetPrivateProfileStringW(section, key, L"", value, ARRAY_SIZE(value), ini) || value[0] != '@')
+        return E_FAIL;
+
+    if (!ExpandEnvironmentStringsW(value + 1, expanded, ARRAY_SIZE(expanded)))
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (!(comma = wcsrchr(expanded, ',')))
+        return E_FAIL;
+    id = _wtoi(comma + 1);
+    if (id < 0)
+        id = -id;
+
+    if ((UINT)(comma - expanded) >= size)
+        return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+    memcpy(module, expanded, (comma - expanded) * sizeof(WCHAR));
+    module[comma - expanded] = 0;
+    *res = id;
     return S_OK;
 }
 
