From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: IQueryAssociations::GetKey, SHGetLocalizedName and friends (3634)

shell32: IQueryAssociations::GetKey, SHGetLocalizedName and friends

shell32: IQueryAssociations::GetKey (class, shell exec class, base class; APP = no association since Init has no by-exe mode), SHGetLocalizedName/SHSetLocalizedName/SHRemoveLocalizedName on desktop.ini (LocalizedResourceName / LocalizedFileNames). Gate fastb-gapshell, mutants SG_MUTANT_ASSOC_KEY, SHELL_LOCNAME. Resource id returned positive: sign not documented. Mutants ASSOC_KEY and SHELL_LOCNAME shown caught. shlview.c: the 4 LVM_SETVIEW checks now pass, todo_wine kept only for the still-failing LVM_SETEXTENDEDLISTVIEWSTYLE count.
---
diff --git a/dlls/shell32/assoc.c b/dlls/shell32/assoc.c
index 34bde92..a4f235c 100644
--- a/dlls/shell32/assoc.c
+++ b/dlls/shell32/assoc.c
@@ -856,10 +856,44 @@ static HRESULT WINAPI IQueryAssociations_fnGetKey(
   HKEY *phkeyOut)
 {
   IQueryAssociationsImpl *This = impl_from_IQueryAssociations(iface);
+  HKEY source = NULL;
+  LONG ret;
+
+  TRACE("(%p,0x%8lx,0x%8x,%s,%p)\n", This, cfFlags, assockey, debugstr_w(pszExtra), phkeyOut);
 
-  FIXME("(%p,0x%8lx,0x%8x,%s,%p)-stub!\n", This, cfFlags, assockey,
-        debugstr_w(pszExtra), phkeyOut);
+#ifdef SG_MUTANT_ASSOC_KEY
   return E_NOTIMPL;
+#endif
+  if (!phkeyOut)
+    return E_UNEXPECTED;
+  *phkeyOut = NULL;
+
+  switch (assockey)
+  {
+    case ASSOCKEY_SHELLEXECCLASS:
+    case ASSOCKEY_CLASS:
+      /* The class (ProgID) key; the extension key itself when it has none. */
+      source = This->hkeyProgID ? This->hkeyProgID : This->hkeySource;
+      break;
+
+    case ASSOCKEY_APP:
+      /* Only an association created from an executable name (ASSOCF_INIT_BYEXENAME,
+       * not supported by Init) has an application key. */
+      return HRESULT_FROM_WIN32(ERROR_NO_ASSOCIATION);
+
+    case ASSOCKEY_BASECLASS:
+      ret = RegOpenKeyExW(HKEY_CLASSES_ROOT, L"*", 0, MAXIMUM_ALLOWED, phkeyOut);
+      return HRESULT_FROM_WIN32(ret);
+
+    default:
+      return E_INVALIDARG;
+  }
+
+  if (!source)
+    return HRESULT_FROM_WIN32(ERROR_NO_ASSOCIATION);
+
+  ret = RegOpenKeyExW(source, NULL, 0, MAXIMUM_ALLOWED, phkeyOut);
+  return HRESULT_FROM_WIN32(ret);
 }
 
