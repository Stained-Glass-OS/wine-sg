From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] webservices: WsReadArray, and the item offset of WsWriteArray

WsReadArray (a stub) reads up to itemCount elements of the given name and primitive value type into the array from itemOffset on, stops without an error at the first element of another name or at the parent's end tag, and returns the count it read; a reader with no input is WS_E_INVALID_OPERATION, a bad name, value type, size or range E_INVALIDARG. It is declared in webservices.h now. WsWriteArray looped from the offset to the count instead of count items from the offset, so any offset other than 0 wrote the wrong items.
---
--- a/dlls/webservices/reader.c
+++ b/dlls/webservices/reader.c
@@ -7088,6 +7088,94 @@ HRESULT WINAPI WsReadElement( WS_XML_READER *handle, const WS_ELEMENT_DESCRIPTIO
     return hr;
 }
 
+/* is there a start element next?  (An end tag is the end of the array, not an error.) */
+static HRESULT array_peek_start( struct reader *reader, BOOL *found )
+{
+    unsigned char buf[2];
+
+    *found = FALSE;
+    if (reader->input_enc == WS_XML_READER_ENCODING_TYPE_TEXT && reader->state != READER_STATE_INITIAL &&
+        reader->state != READER_STATE_STARTELEMENT)
+    {
+        read_skip_whitespace( reader );
+        if (read_peek( reader, buf, 2 ) == S_OK && buf[0] == '<' && buf[1] == '/') return S_OK;
+    }
+    return read_to_startelement( reader, found );
+}
+
+/**************************************************************************
+ *          WsReadArray		[webservices.@]
+ *
+ * Reads up to count elements of a primitive type, all with the name given, into the array
+ * from item offset on.  An element that is not the one named ends it, with the count read.
+ */
+HRESULT WINAPI WsReadArray( WS_XML_READER *handle, const WS_XML_STRING *localname, const WS_XML_STRING *ns,
+                            WS_VALUE_TYPE value_type, void *array, ULONG size, ULONG offset, ULONG count,
+                            ULONG *actual_count, WS_ERROR *error )
+{
+    struct reader *reader = (struct reader *)handle;
+    WS_TYPE type;
+    ULONG type_size, i = 0;
+    BOOL found;
+    HRESULT hr = S_OK;
+
+    TRACE( "%p %s %s %u %p %lu %lu %lu %p %p\n", handle, debugstr_xmlstr(localname), debugstr_xmlstr(ns),
+           value_type, array, size, offset, count, actual_count, error );
+    if (error) FIXME( "ignoring error parameter\n" );
+
+    if (!reader) return E_INVALIDARG;
+
+    EnterCriticalSection( &reader->cs );
+
+    if (reader->magic != READER_MAGIC)
+    {
+        LeaveCriticalSection( &reader->cs );
+        return E_INVALIDARG;
+    }
+
+    if (!reader->input_type)
+    {
+        hr = WS_E_INVALID_OPERATION;
+        goto done;
+    }
+
+    if (!localname || !ns || !actual_count || (type = map_value_type( value_type )) == ~0u)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+
+    type_size = get_type_size( type, NULL );
+    if (size % type_size || ((ULONGLONG)offset + count) * type_size > size || (count && !array))
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        char *ptr = (char *)array + (offset + i) * type_size;
+
+        /* look at the next element without consuming anything when it is not one of ours */
+        if (reader->current == reader->last)
+        {
+            if ((hr = array_peek_start( reader, &found )) != S_OK) goto done;
+            if (!found) break;
+        }
+#ifndef SG_MUTANT_WSARRAY_NAME
+        if (!match_element( reader->current, localname, ns )) break;
+#endif
+        if ((hr = read_type( reader, WS_ELEMENT_TYPE_MAPPING, type, localname, ns, NULL, WS_READ_REQUIRED_VALUE, NULL,
+                             ptr, type_size, &found )) != S_OK) goto done;
+    }
+    *actual_count = i;
+
+done:
+    LeaveCriticalSection( &reader->cs );
+    TRACE( "returning %#lx\n", hr );
+    return hr;
+}
+
 /**************************************************************************
  *          WsReadValue		[webservices.@]
  */
--- a/dlls/webservices/webservices.spec
+++ b/dlls/webservices/webservices.spec
@@ -101,7 +101,7 @@
 @ stdcall WsOpenServiceProxy(ptr ptr ptr ptr)
 @ stub WsPullBytes
 @ stub WsPushBytes
-@ stub WsReadArray
+@ stdcall WsReadArray(ptr ptr ptr long ptr long long long ptr ptr)
 @ stdcall WsReadAttribute(ptr ptr long ptr ptr long ptr)
 @ stdcall WsReadBody(ptr ptr long ptr ptr long ptr)
 @ stdcall WsReadBytes(ptr ptr long ptr ptr)
--- a/dlls/webservices/writer.c
+++ b/dlls/webservices/writer.c
@@ -4288,7 +4288,11 @@ HRESULT WINAPI WsWriteArray( WS_XML_WRITER *handle, const WS_XML_STRING *localna
         goto done;
     }
 
+#ifdef SG_MUTANT_WSARRAY_WRITE
     for (i = offset; i < count; i++)
+#else
+    for (i = 0; i < count; i++)
+#endif
     {
         const char *ptr = (const char *)array + (offset + i) * type_size;
         if ((hr = write_element_node( writer, NULL, localname, ns )) != S_OK) goto done;
--- a/include/webservices.h
+++ b/include/webservices.h
@@ -1735,6 +1735,8 @@ HRESULT WINAPI WsReadBody(WS_MESSAGE*, const WS_ELEMENT_DESCRIPTION*, WS_READ_OP
                           ULONG, WS_ERROR*);
 HRESULT WINAPI WsReadBytes(WS_XML_READER*, void*, ULONG, ULONG*, WS_ERROR*);
 HRESULT WINAPI WsReadChars(WS_XML_READER*, WCHAR*, ULONG, ULONG*, WS_ERROR*);
+HRESULT WINAPI WsReadArray(WS_XML_READER*, const WS_XML_STRING*, const WS_XML_STRING*, WS_VALUE_TYPE, void*, ULONG, ULONG, ULONG,
+                         ULONG*, WS_ERROR*);
 HRESULT WINAPI WsReadCharsUtf8(WS_XML_READER*, BYTE*, ULONG, ULONG*, WS_ERROR*);
 HRESULT WINAPI WsReadElement(WS_XML_READER*, const WS_ELEMENT_DESCRIPTION*, WS_READ_OPTION,
                              WS_HEAP*, void*, ULONG, WS_ERROR*);
