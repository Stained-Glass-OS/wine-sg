+/* Approximation of the Unicode Vertical_Orientation property (UAX #50): characters in these ranges
+   stay upright in vertical text, everything else is rotated. */
+static BOOL is_upright_in_vertical_text(UINT32 ch)
+{
+    static const struct { UINT32 first, last; } upright[] =
+    {
+        { 0x00a7, 0x00a7 }, { 0x00a9, 0x00a9 }, { 0x00ae, 0x00ae }, { 0x00b1, 0x00b1 }, { 0x00bc, 0x00be },
+        { 0x00d7, 0x00d7 }, { 0x00f7, 0x00f7 }, { 0x02ea, 0x02eb }, { 0x1100, 0x11ff }, { 0x1401, 0x167f },
+        { 0x18b0, 0x18ff }, { 0x2016, 0x2016 }, { 0x2020, 0x2021 }, { 0x2030, 0x2031 }, { 0x203b, 0x203c },
+        { 0x2042, 0x2042 }, { 0x2047, 0x2049 }, { 0x2051, 0x2051 }, { 0x20dd, 0x20e0 }, { 0x20e2, 0x20e4 },
+        { 0x2100, 0x2101 }, { 0x2103, 0x2109 }, { 0x2113, 0x2113 }, { 0x2116, 0x2117 }, { 0x211e, 0x2123 },
+        { 0x212a, 0x212b }, { 0x2190, 0x23ff }, { 0x2400, 0x2426 }, { 0x2460, 0x2bff }, { 0x2e80, 0x2fdf },
+        { 0x2ff0, 0x3007 }, { 0x3012, 0x3013 }, { 0x3020, 0x302f }, { 0x3031, 0x3037 }, { 0x3040, 0x3096 },
+        { 0x309b, 0x30ff }, { 0x3105, 0x312f }, { 0x3131, 0x318e }, { 0x3190, 0x31bf }, { 0x31c0, 0x31ef },
+        { 0x31f0, 0x321e }, { 0x3220, 0x3247 }, { 0x3250, 0xa4cf }, { 0xa960, 0xa97f }, { 0xac00, 0xd7ff },
+        { 0xe000, 0xfaff }, { 0xfe10, 0xfe19 }, { 0xfe30, 0xfe48 }, { 0xfe50, 0xfe6f }, { 0xff01, 0xff01 },
+        { 0xff03, 0xff06 }, { 0xff0a, 0xff0b }, { 0xff0d, 0xff0d }, { 0xff0f, 0xff19 }, { 0xff1c, 0xff1e },
+        { 0xff20, 0xff3a }, { 0xff3c, 0xff3c }, { 0xff3e, 0xff3e }, { 0xff40, 0xff5a }, { 0xff5c, 0xff5c },
+        { 0xff5e, 0xff5e }, { 0xffe0, 0xffe6 }, { 0xfffc, 0xfffd }, { 0x16fe0, 0x18aff }, { 0x1b000, 0x1b2ff },
+        { 0x1d000, 0x1d24f }, { 0x1d300, 0x1d37f }, { 0x1f000, 0x1faff }, { 0x20000, 0x3ffff },
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(upright); ++i)
+    {
+        if (ch >= upright[i].first && ch <= upright[i].last) return TRUE;
+    }
+    return FALSE;
+}
