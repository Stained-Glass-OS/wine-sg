+struct dwrite_download_queue
+{
+    IDWriteFontDownloadQueue IDWriteFontDownloadQueue_iface;
+    LONG refcount;
+    CRITICAL_SECTION cs;
+    struct
+    {
+        IDWriteFontDownloadListener *listener;
+        UINT32 token;
+    } *listeners;
+    size_t count, size;
+    UINT32 next_token;
+};
+
+static inline struct dwrite_download_queue *impl_from_IDWriteFontDownloadQueue(IDWriteFontDownloadQueue *iface)
+{
+    return CONTAINING_RECORD(iface, struct dwrite_download_queue, IDWriteFontDownloadQueue_iface);
+}
+
+static HRESULT WINAPI download_queue_QueryInterface(IDWriteFontDownloadQueue *iface, REFIID riid, void **obj)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), obj);
+
+    if (IsEqualIID(riid, &IID_IDWriteFontDownloadQueue) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        IDWriteFontDownloadQueue_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("%s not implemented.\n", debugstr_guid(riid));
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI download_queue_AddRef(IDWriteFontDownloadQueue *iface)
+{
+    struct dwrite_download_queue *queue = impl_from_IDWriteFontDownloadQueue(iface);
+    ULONG refcount = InterlockedIncrement(&queue->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI download_queue_Release(IDWriteFontDownloadQueue *iface)
+{
+    struct dwrite_download_queue *queue = impl_from_IDWriteFontDownloadQueue(iface);
+    ULONG refcount = InterlockedDecrement(&queue->refcount);
+    size_t i;
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        for (i = 0; i < queue->count; ++i)
+            IDWriteFontDownloadListener_Release(queue->listeners[i].listener);
+        free(queue->listeners);
+        queue->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&queue->cs);
+        free(queue);
+    }
+
+    return refcount;
+}
+
+static HRESULT WINAPI download_queue_AddListener(IDWriteFontDownloadQueue *iface,
+        IDWriteFontDownloadListener *listener, UINT32 *token)
+{
+    struct dwrite_download_queue *queue = impl_from_IDWriteFontDownloadQueue(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p, %p.\n", iface, listener, token);
+
+    if (!listener || !token)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&queue->cs);
+    if (!dwrite_array_reserve((void **)&queue->listeners, &queue->size, queue->count + 1, sizeof(*queue->listeners)))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        IDWriteFontDownloadListener_AddRef(listener);
+        queue->listeners[queue->count].listener = listener;
+        queue->listeners[queue->count].token = *token = queue->next_token++;
+        queue->count++;
+    }
+    LeaveCriticalSection(&queue->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI download_queue_RemoveListener(IDWriteFontDownloadQueue *iface, UINT32 token)
+{
+    struct dwrite_download_queue *queue = impl_from_IDWriteFontDownloadQueue(iface);
+    IDWriteFontDownloadListener *listener = NULL;
+    size_t i;
+
+    TRACE("%p, %u.\n", iface, token);
+
+    EnterCriticalSection(&queue->cs);
+    for (i = 0; i < queue->count; ++i)
+    {
+        if (queue->listeners[i].token != token) continue;
+        listener = queue->listeners[i].listener;
+        memmove(&queue->listeners[i], &queue->listeners[i + 1], (queue->count - i - 1) * sizeof(*queue->listeners));
+        queue->count--;
+        break;
+    }
+    LeaveCriticalSection(&queue->cs);
+
+    if (!listener)
+        return E_INVALIDARG;
+    IDWriteFontDownloadListener_Release(listener);
+    return S_OK;
