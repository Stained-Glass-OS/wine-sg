+    unsigned int count;
+
+    maxp.exists = TRUE;
+    if (!get_fontface_table(fontface, MS_MAXP_TAG, &maxp)) return 0;
+    count = table_read_be_word(&maxp, FIELD_OFFSET(struct maxp, num_glyphs));
+    IDWriteFontFace5_ReleaseFontTable(fontface, maxp.context);
+    return count;
+}
+
+static void sbix_collect_candidates(struct glyph_image_context *ctx, UINT16 glyph, unsigned int num_glyphs,
+        struct glyph_image_candidate **list, size_t *count, size_t *size)
+{
+    const struct sbix_header *header;
+    unsigned int num_strikes, i;
+
+    ctx->sbix.exists = TRUE;
+    if (!get_fontface_table(ctx->face, MS_SBIX_TAG, &ctx->sbix)) return;
+
+    num_strikes = table_read_be_dword(&ctx->sbix, FIELD_OFFSET(struct sbix_header, num_strikes));
+    header = table_read_ensure(&ctx->sbix, 0, FIELD_OFFSET(struct sbix_header, strike_offset[num_strikes]));
+    if (!header) return;
+
+    for (i = 0; i < num_strikes; ++i)
+    {
+        unsigned int strike_offset = GET_BE_DWORD(header->strike_offset[i]), offset, next_offset;
+        const struct sbix_strike *strike = table_read_ensure(&ctx->sbix, strike_offset,
+                FIELD_OFFSET(struct sbix_strike, glyphdata_offsets[num_glyphs + 1]));
+        const struct sbix_glyph_data *glyph_data;
+        struct glyph_image_candidate c = { 0 };
+
+        if (!strike) continue;
+        offset = GET_BE_DWORD(strike->glyphdata_offsets[glyph]);
+        next_offset = GET_BE_DWORD(strike->glyphdata_offsets[glyph + 1]);
+        if (next_offset <= offset || next_offset - offset <= FIELD_OFFSET(struct sbix_glyph_data, data)) continue;
+        if (!(glyph_data = table_read_ensure(&ctx->sbix, strike_offset + offset, next_offset - offset))) continue;
+
+        switch (glyph_data->graphic_type)
+        {
+            case MS_PNG__TAG: c.format = DWRITE_GLYPH_IMAGE_FORMATS_PNG; break;
+            case MS_JPG__TAG: c.format = DWRITE_GLYPH_IMAGE_FORMATS_JPEG; break;
+            case MS_TIFF_TAG: c.format = DWRITE_GLYPH_IMAGE_FORMATS_TIFF; break;
+            default: continue;
+        }
+
+        c.ppem = GET_BE_WORD(strike->ppem);
+        c.data.pixelsPerEm = c.ppem;
+        c.data.imageData = glyph_data->data;
+        c.data.imageDataSize = next_offset - offset - FIELD_OFFSET(struct sbix_glyph_data, data);
+        c.data.uniqueDataId = strike_offset + offset;
+        glyph_image_png_size(glyph_data->data, c.data.imageDataSize, &c.data);
+        /* The glyph origin is at the lower left corner of the image shifted by the origin offset. */
+        c.data.horizontalLeftOrigin.x = -(int16_t)GET_BE_WORD(glyph_data->originOffsetX);
+        c.data.horizontalLeftOrigin.y = c.data.pixelSize.height + (int16_t)GET_BE_WORD(glyph_data->originOffsetY);
+        c.data.horizontalRightOrigin = c.data.horizontalLeftOrigin;
+        if (!glyph_image_add(list, count, size, &c)) return;
+    }
+}
+
+/* Locates the 'CBDT' data of a glyph in one 'CBLC' strike, returns the image format and data offset. */
+static BOOL cblc_find_glyph(const struct dwrite_fonttable *cblc, const struct cblc_bitmapsize_table *strike,
+        UINT16 glyph, unsigned int *image_format, unsigned int *offset, unsigned int *length, const BYTE **metrics)
+{
+    unsigned int array_offset = GET_BE_DWORD(strike->indexSubTableArrayOffset);
+    unsigned int count = GET_BE_DWORD(strike->numberofIndexSubTables), i;
+    const struct cblc_index_subtable_record *records;
+
+    if (glyph < GET_BE_WORD(strike->startGlyphIndex) || glyph > GET_BE_WORD(strike->endGlyphIndex)) return FALSE;
+    if (!(records = table_read_ensure(cblc, array_offset, count * sizeof(*records)))) return FALSE;
+
+    for (i = 0; i < count; ++i)
+    {
+        unsigned int first = GET_BE_WORD(records[i].first_glyph), last = GET_BE_WORD(records[i].last_glyph);
+        unsigned int sub_offset = array_offset + GET_BE_DWORD(records[i].offset), data_offset, n;
+        const struct cblc_index_subtable_header *sub;
+
+        if (glyph < first || glyph > last) continue;
+        if (!(sub = table_read_ensure(cblc, sub_offset, sizeof(*sub)))) return FALSE;
+        *image_format = GET_BE_WORD(sub->image_format);
+        data_offset = GET_BE_DWORD(sub->image_data_offset);
+        *metrics = NULL;
+
+        switch (GET_BE_WORD(sub->index_format))
+        {
+            case 1:
+            case 3:
+            {
+                unsigned int wide = GET_BE_WORD(sub->index_format) == 1, a, b;
+
+                n = glyph - first;
+                a = wide ? table_read_be_dword(cblc, sub_offset + 8 + n * 4) : table_read_be_word(cblc, sub_offset + 8 + n * 2);
+                b = wide ? table_read_be_dword(cblc, sub_offset + 8 + (n + 1) * 4) : table_read_be_word(cblc, sub_offset + 8 + (n + 1) * 2);
+                if (b <= a) return FALSE;
+                *offset = data_offset + a;
+                *length = b - a;
+                return TRUE;
+            }
+            case 2:
+            {
+                unsigned int image_size = table_read_be_dword(cblc, sub_offset + 8);
+
+                *metrics = table_read_ensure(cblc, sub_offset + 12, 8);
+                *offset = data_offset + (glyph - first) * image_size;
+                *length = image_size;
+                return TRUE;
+            }
+            case 4:
+            {
+                unsigned int num = table_read_be_dword(cblc, sub_offset + 8), k;
+
+                for (k = 0; k < num; ++k)
+                {
+                    if (table_read_be_word(cblc, sub_offset + 12 + k * 4) != glyph) continue;
+                    *offset = data_offset + table_read_be_word(cblc, sub_offset + 12 + k * 4 + 2);
+                    *length = table_read_be_word(cblc, sub_offset + 12 + (k + 1) * 4 + 2) -
+                            table_read_be_word(cblc, sub_offset + 12 + k * 4 + 2);
+                    return *length != 0;
+                }
+                return FALSE;
+            }
+            case 5:
+            {
+                unsigned int image_size = table_read_be_dword(cblc, sub_offset + 8);
+                unsigned int num = table_read_be_dword(cblc, sub_offset + 20), k;
+
+                *metrics = table_read_ensure(cblc, sub_offset + 12, 8);
+                for (k = 0; k < num; ++k)
+                {
+                    if (table_read_be_word(cblc, sub_offset + 24 + k * 2) != glyph) continue;
+                    *offset = data_offset + k * image_size;
+                    *length = image_size;
+                    return TRUE;
+                }
+                return FALSE;
+            }
+            default:
+                return FALSE;
+        }
+    }
+
+    return FALSE;
+}
+
+static void cblc_collect_candidates(struct glyph_image_context *ctx, UINT16 glyph,
+        struct glyph_image_candidate **list, size_t *count, size_t *size)
+{
+    const struct cblc_bitmapsize_table *sizes;
+    unsigned int num_sizes, i;
+
+    ctx->cblc.exists = TRUE;
+    ctx->cbdt.exists = TRUE;
+    if (!get_fontface_table(ctx->face, MS_CBLC_TAG, &ctx->cblc)) return;
+    if (!get_fontface_table(ctx->face, MS_CBDT_TAG, &ctx->cbdt)) return;
+
+    num_sizes = table_read_be_dword(&ctx->cblc, FIELD_OFFSET(struct cblc_header, num_sizes));
+    if (!(sizes = table_read_ensure(&ctx->cblc, sizeof(struct cblc_header), num_sizes * sizeof(*sizes)))) return;
+
+    for (i = 0; i < num_sizes; ++i)
+    {
+        unsigned int image_format, offset, length, data_len;
+        struct glyph_image_candidate c = { 0 };
+        const BYTE *metrics, *image, *png;
+        int bearing_x, bearing_y;
+
+        if (!cblc_find_glyph(&ctx->cblc, &sizes[i], glyph, &image_format, &offset, &length, &metrics)) continue;
+        if (!(image = table_read_ensure(&ctx->cbdt, offset, length)) || length < 4) continue;
+
+        switch (image_format)
+        {
+            case 17: /* small metrics, PNG */
+                if (length < 9) continue;
+                bearing_x = (int8_t)image[2];
+                bearing_y = (int8_t)image[3];
+                data_len = GET_BE_DWORD(*(const DWORD *)(image + 5));
+                png = image + 9;
+                break;
+            case 18: /* big metrics, PNG */
+                if (length < 12) continue;
+                bearing_x = (int8_t)image[2];
+                bearing_y = (int8_t)image[3];
+                data_len = GET_BE_DWORD(*(const DWORD *)(image + 8));
+                png = image + 12;
+                break;
+            case 19: /* metrics in the index subtable, PNG */
+                bearing_x = metrics ? (int8_t)metrics[2] : 0;
+                bearing_y = metrics ? (int8_t)metrics[3] : 0;
+                data_len = GET_BE_DWORD(*(const DWORD *)image);
+                png = image + 4;
+                break;
+            default:
+                continue;
+        }
+        if (data_len > length - (png - image)) continue;
+
+        c.format = DWRITE_GLYPH_IMAGE_FORMATS_PNG;
+        c.ppem = sizes[i].ppemY;
+        c.data.imageData = png;
+        c.data.imageDataSize = data_len;
+        c.data.uniqueDataId = offset;
+        c.data.pixelsPerEm = c.ppem;
+        glyph_image_png_size(png, data_len, &c.data);
+        c.data.horizontalLeftOrigin.x = -bearing_x;
+        c.data.horizontalLeftOrigin.y = bearing_y;
+        c.data.horizontalRightOrigin = c.data.horizontalLeftOrigin;
+        if (!glyph_image_add(list, count, size, &c)) return;
+    }
+}
+
+static void svg_collect_candidates(struct glyph_image_context *ctx, UINT16 glyph,
+        struct glyph_image_candidate **list, size_t *count, size_t *size)
+{
+    unsigned int list_offset, num_docs, i;
+    const struct svg_doc_record *records;
+    const BYTE *doc;
+
+    ctx->svg.exists = TRUE;
+    if (!get_fontface_table(ctx->face, MS_SVG__TAG, &ctx->svg)) return;
+
+    list_offset = table_read_be_dword(&ctx->svg, FIELD_OFFSET(struct svg_header, doc_list_offset));
+    num_docs = table_read_be_word(&ctx->svg, list_offset);
+    if (!(records = table_read_ensure(&ctx->svg, list_offset + 2, num_docs * sizeof(*records)))) return;
+
+    for (i = 0; i < num_docs; ++i)
+    {
+        struct glyph_image_candidate c = { 0 };
+        unsigned int doc_len;
+
+        if (glyph < GET_BE_WORD(records[i].first_glyph) || glyph > GET_BE_WORD(records[i].last_glyph)) continue;
+        doc_len = GET_BE_DWORD(records[i].doc_length);
+        if (!(doc = table_read_ensure(&ctx->svg, list_offset + GET_BE_DWORD(records[i].doc_offset), doc_len))) continue;
+
+        c.format = DWRITE_GLYPH_IMAGE_FORMATS_SVG;
+        c.data.imageData = doc;
+        c.data.imageDataSize = doc_len;
+        c.data.uniqueDataId = list_offset + GET_BE_DWORD(records[i].doc_offset);
+        glyph_image_add(list, count, size, &c);
+        return;
+    }
+}
+
+static struct glyph_image_context *glyph_image_collect(IDWriteFontFace5 *fontface, UINT16 glyph, unsigned int formats,
+        struct glyph_image_candidate **list, size_t *count)
+{
+    struct glyph_image_context *ctx;
+    size_t size = 0;
+    unsigned int num_glyphs;
+
+    *list = NULL;
+    *count = 0;
+
+    if (!(ctx = calloc(1, sizeof(*ctx)))) return NULL;
+    ctx->face = fontface;
+    IDWriteFontFace5_AddRef(fontface);
+
+    num_glyphs = opentype_get_num_glyphs(fontface);
+    if (glyph >= num_glyphs) return ctx;
+
+    if (formats & (DWRITE_GLYPH_IMAGE_FORMATS_PNG | DWRITE_GLYPH_IMAGE_FORMATS_JPEG | DWRITE_GLYPH_IMAGE_FORMATS_TIFF))
+    {
+        sbix_collect_candidates(ctx, glyph, num_glyphs, list, count, &size);
+        if (formats & DWRITE_GLYPH_IMAGE_FORMATS_PNG)
+            cblc_collect_candidates(ctx, glyph, list, count, &size);
+    }
+    if (formats & DWRITE_GLYPH_IMAGE_FORMATS_SVG)
+        svg_collect_candidates(ctx, glyph, list, count, &size);
+
+    return ctx;
+}
+
+UINT32 opentype_get_glyph_formats(IDWriteFontFace5 *fontface, UINT16 glyph, UINT32 ppem_first, UINT32 ppem_last)
+{
+    struct glyph_image_candidate *list;
+    struct glyph_image_context *ctx;
+    UINT32 ret = 0;
+    size_t count, i;
+
+    if (!(ctx = glyph_image_collect(fontface, glyph, DWRITE_GLYPH_IMAGE_FORMATS_PNG | DWRITE_GLYPH_IMAGE_FORMATS_JPEG |
+            DWRITE_GLYPH_IMAGE_FORMATS_TIFF | DWRITE_GLYPH_IMAGE_FORMATS_SVG, &list, &count)))
+        return 0;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (!list[i].ppem || (list[i].ppem >= ppem_first && list[i].ppem <= ppem_last))
+            ret |= list[i].format;
+    }
+    free(list);
+    release_glyph_image_context(ctx);
+
+    /* Outlines and layered color glyphs. */
+    if (glyph < opentype_get_num_glyphs(fontface))
+    {
+        struct dwrite_fonttable colr = { 0 };
+        struct dwrite_colorglyph color_glyph;
+
+        if (opentype_has_font_table(fontface, MS_GLYF_TAG))
+            ret |= DWRITE_GLYPH_IMAGE_FORMATS_TRUETYPE;
+        if (opentype_has_font_table(fontface, MS_CFF__TAG) || opentype_has_font_table(fontface, MS_CFF2_TAG))
+            ret |= DWRITE_GLYPH_IMAGE_FORMATS_CFF;
+
+        colr.exists = TRUE;
+        if (get_fontface_table(fontface, MS_COLR_TAG, &colr))
+        {
+            if (opentype_get_colr_glyph(&colr, glyph, &color_glyph) == S_OK)
+                ret |= DWRITE_GLYPH_IMAGE_FORMATS_COLR;
+            IDWriteFontFace5_ReleaseFontTable(fontface, colr.context);
+        }
+    }
+
+    return ret;
+}
+
+HRESULT opentype_get_glyph_image_data(IDWriteFontFace5 *fontface, UINT16 glyph, UINT32 ppem,
+        DWRITE_GLYPH_IMAGE_FORMATS format, DWRITE_GLYPH_IMAGE_DATA *data, void **context)
+{
+    struct glyph_image_candidate *list, *best = NULL;
+    struct glyph_image_context *ctx;
+    size_t count, i;
+
+    memset(data, 0, sizeof(*data));
+    *context = NULL;
+
+    /* Exactly one raster or SVG format can be requested, outlines are not image data. */
+    if (!format || (format & (format - 1)) || !(format & (DWRITE_GLYPH_IMAGE_FORMATS_PNG |
+            DWRITE_GLYPH_IMAGE_FORMATS_JPEG | DWRITE_GLYPH_IMAGE_FORMATS_TIFF | DWRITE_GLYPH_IMAGE_FORMATS_SVG)))
+        return E_INVALIDARG;
+
+    if (!(ctx = glyph_image_collect(fontface, glyph, format, &list, &count)))
+        return E_OUTOFMEMORY;
+
+    for (i = 0; i < count; ++i)
+    {
+        struct glyph_image_candidate *c = &list[i];
+
+        if (c->format != format) continue;
+        if (!best) { best = c; continue; }
+        /* Smallest strike that is not smaller than requested, otherwise the largest one. */
+        if (best->ppem < ppem ? c->ppem > best->ppem : (c->ppem >= ppem && c->ppem < best->ppem))
+            best = c;
+    }
+
+    if (best)
+    {
+        *data = best->data;
+        *context = ctx;
+    }
+    else
+        release_glyph_image_context(ctx);
+
+    free(list);
+    return S_OK;
+}
+
+void opentype_release_glyph_image_data(void *context)
+{
+    if (context) release_glyph_image_context(context);
+}
