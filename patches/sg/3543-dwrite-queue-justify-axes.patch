+struct stat_header
+{
+    uint16_t major_version;
+    uint16_t minor_version;
+    uint16_t axis_size;
+    uint16_t axis_count;
+    uint32_t axes_offset;
+    uint16_t value_count;
+    uint32_t values_offset;
+    uint16_t fallback_nameid;
+};
+
+struct stat_axis_record
+{
+    uint32_t tag;
+    uint16_t nameid;
+    uint16_t ordering;
+};
+
+struct stat_value_header
+{
+    uint16_t format;
+    uint16_t axis_index;
+    uint16_t flags;
+    uint16_t nameid;
+};
+
+HRESULT opentype_get_axis_names(const struct file_stream_desc *stream_desc, const struct dwrite_var_axis *axis,
+        IDWriteLocalizedStrings **names)
+{
+    struct dwrite_fonttable name;
+    const WCHAR *fallback = NULL;
+    HRESULT hr = E_FAIL;
+
+    *names = NULL;
+
+    if (axis->name_id)
+    {
+        opentype_get_font_table(stream_desc, MS_NAME_TAG, &name);
+        hr = opentype_get_font_strings_from_id(&name, axis->name_id, names);
+        if (name.context)
+            IDWriteFontFileStream_ReleaseFileFragment(stream_desc->stream, name.context);
+        if (SUCCEEDED(hr))
+            return hr;
+    }
+
+    switch (axis->tag)
+    {
+        case DWRITE_FONT_AXIS_TAG_WEIGHT: fallback = L"Weight"; break;
+        case DWRITE_FONT_AXIS_TAG_WIDTH: fallback = L"Width"; break;
+        case DWRITE_FONT_AXIS_TAG_ITALIC: fallback = L"Italic"; break;
+        case DWRITE_FONT_AXIS_TAG_SLANT: fallback = L"Slant"; break;
+        case DWRITE_FONT_AXIS_TAG_OPTICAL_SIZE: fallback = L"Optical size"; break;
+        default: return hr;
+    }
+
+    if (FAILED(hr = create_localizedstrings(names)))
+        return hr;
+    return add_localizedstring(*names, L"en-us", fallback);
+}
+
+/* Returns the number of axis value tables of the STAT table that name values of given axis, formats 1 to 3 only. */
+static unsigned int stat_find_values(const struct dwrite_fonttable *stat, unsigned int tag, unsigned int index,
+        const struct stat_value_header **found, DWRITE_FONT_AXIS_RANGE *range)
+{
+    const struct stat_header *header;
+    unsigned int axis_count, value_count, values_offset, axes_offset, axis_size, i, axis_index = ~0u, count = 0;
+    const struct stat_axis_record *axis_rec;
+    const uint16_t *offsets;
+
+    if (!(header = table_read_ensure(stat, 0, FIELD_OFFSET(struct stat_header, fallback_nameid))))
+        return 0;
+    if (GET_BE_WORD(header->major_version) != 1)
+        return 0;
+
+    axis_count = GET_BE_WORD(header->axis_count);
+    axis_size = GET_BE_WORD(header->axis_size);
+    axes_offset = GET_BE_DWORD(header->axes_offset);
+    value_count = GET_BE_WORD(header->value_count);
+    values_offset = GET_BE_DWORD(header->values_offset);
+
+    if (axis_size < sizeof(*axis_rec)) return 0;
+    for (i = 0; i < axis_count; ++i)
+    {
+        if (!(axis_rec = table_read_ensure(stat, axes_offset + i * axis_size, sizeof(*axis_rec)))) return 0;
+        if (axis_rec->tag == tag) { axis_index = i; break; }
+    }
+    if (axis_index == ~0u) return 0;
+
+    if (!(offsets = table_read_ensure(stat, values_offset, value_count * sizeof(*offsets)))) return 0;
+    for (i = 0; i < value_count; ++i)
+    {
+        const struct stat_value_header *value;
+        unsigned int format, fixed_size;
+
+        if (!(value = table_read_ensure(stat, values_offset + GET_BE_WORD(offsets[i]), sizeof(*value)))) continue;
+        format = GET_BE_WORD(value->format);
+        if (format < 1 || format > 3 || GET_BE_WORD(value->axis_index) != axis_index) continue;
+        fixed_size = format == 2 ? 12 : format == 3 ? 8 : 4;
+        if (!table_read_ensure(stat, values_offset + GET_BE_WORD(offsets[i]) + sizeof(*value), fixed_size)) continue;
+
+        if (found && count == index)
+        {
+            unsigned int base = values_offset + GET_BE_WORD(offsets[i]) + sizeof(*value);
+
+            *found = value;
+            if (range)
+            {
+                if (format == 2)
+                {
+                    range->minValue = table_read_be_fixed(stat, base + 4);
+                    range->maxValue = table_read_be_fixed(stat, base + 8);
+                }
+                else
+                    range->minValue = range->maxValue = table_read_be_fixed(stat, base);
+            }
+            return 1;
+        }
+        count++;
+    }
+
+    return found ? 0 : count;
+}
+
+unsigned int opentype_get_axis_value_name_count(const struct file_stream_desc *stream_desc,
+        const struct dwrite_var_axis *axis)
+{
+    struct dwrite_fonttable stat;
+    unsigned int count;
+
+    opentype_get_font_table(stream_desc, MS_STAT_TAG, &stat);
+    count = stat_find_values(&stat, axis->tag, 0, NULL, NULL);
+    if (stat.context)
+        IDWriteFontFileStream_ReleaseFileFragment(stream_desc->stream, stat.context);
+    return count;
+}
+
+HRESULT opentype_get_axis_value_names(const struct file_stream_desc *stream_desc, const struct dwrite_var_axis *axis,
+        unsigned int index, DWRITE_FONT_AXIS_RANGE *range, IDWriteLocalizedStrings **names)
+{
+    const struct stat_value_header *value = NULL;
+    struct dwrite_fonttable stat, name;
+    DWRITE_FONT_AXIS_RANGE r = { 0 };
+    HRESULT hr = E_INVALIDARG;
+
+    *names = NULL;
+
+    opentype_get_font_table(stream_desc, MS_STAT_TAG, &stat);
+    if (stat_find_values(&stat, axis->tag, index, &value, &r))
+    {
+        opentype_get_font_table(stream_desc, MS_NAME_TAG, &name);
+        hr = opentype_get_font_strings_from_id(&name, GET_BE_WORD(value->nameid), names);
+        if (name.context)
+            IDWriteFontFileStream_ReleaseFileFragment(stream_desc->stream, name.context);
+        if (SUCCEEDED(hr) && range)
+        {
+            range->axisTag = axis->tag;
+            range->minValue = r.minValue;
+            range->maxValue = r.maxValue;
+        }
+    }
+    if (stat.context)
+        IDWriteFontFileStream_ReleaseFileFragment(stream_desc->stream, stat.context);
+    return hr;
+}
