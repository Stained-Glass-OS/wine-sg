+static BOOL is_ideographic_justification_char(WCHAR ch)
+{
+    return (ch >= 0x2e80 && ch <= 0xa4cf) || (ch >= 0xac00 && ch <= 0xd7ff) || (ch >= 0xf900 && ch <= 0xfaff) ||
+            (ch >= 0xff00 && ch <= 0xffef) || (ch >= 0xd840 && ch <= 0xd87f);
+}
