 static HRESULT WINAPI dwritetextanalyzer1_GetJustificationOpportunities(IDWriteTextAnalyzer2 *iface,
     IDWriteFontFace *face, FLOAT font_em_size, DWRITE_SCRIPT_ANALYSIS sa, UINT32 length, UINT32 glyph_count,
-    const WCHAR *text, const UINT16 *clustermap, const DWRITE_SHAPING_GLYPH_PROPERTIES *prop, DWRITE_JUSTIFICATION_OPPORTUNITY *jo)
+    const WCHAR *text, const UINT16 *clustermap, const DWRITE_SHAPING_GLYPH_PROPERTIES *prop,
+    DWRITE_JUSTIFICATION_OPPORTUNITY *jo)
 {
-    FIXME("(%p %.2f %u %u %u %s %p %p %p): stub\n", face, font_em_size, sa.script, length, glyph_count,
-        debugstr_wn(text, length), clustermap, prop, jo);
-    return E_NOTIMPL;
+    UINT32 i, c;
+
+    TRACE("%p, %.2f, %u, %u, %u, %s, %p, %p, %p.\n", face, font_em_size, sa.script, length, glyph_count,
+            debugstr_wn(text, length), clustermap, prop, jo);
+
+    if (!text || !clustermap || !prop || !jo || font_em_size <= 0.0f)
+        return E_INVALIDARG;
+    if (sa.script > Script_LastId)
+        return E_INVALIDARG;
+
+    memset(jo, 0, glyph_count * sizeof(*jo));
+
+    /* Map every glyph to the first character of its cluster. */
+    for (c = 0; c < length; ++c)
+    {
+        UINT32 first = clustermap[c], next = glyph_count;
+        UINT32 k;
+
+        if (c && clustermap[c - 1] == first) continue; /* not the first character of the cluster */
+        for (k = c + 1; k < length; ++k)
+            if (clustermap[k] != first) { next = clustermap[k]; break; }
+        if (first >= glyph_count) continue;
+        next = min(next, glyph_count);
+
+        /* Only the last glyph of a cluster gets an opportunity. */
+        if (next == first) continue;
+        i = next - 1;
+
+        switch (prop[i].justification)
+        {
+            case SCRIPT_JUSTIFY_BLANK:
+            case SCRIPT_JUSTIFY_ARABIC_BLANK:
+                jo[i].expansionMinimum = 0.0f;
+                jo[i].expansionMaximum = INFINITY;
+                jo[i].compressionMaximum = 0.0f;
+                jo[i].expansionPriority = 1;
+                jo[i].compressionPriority = 1;
+                jo[i].allowResidualExpansion = 1;
+                jo[i].allowResidualCompression = 0;
+                jo[i].applyToLeadingEdge = 0;
+                jo[i].applyToTrailingEdge = 1;
+                break;
+            case SCRIPT_JUSTIFY_CHARACTER:
+                if (!is_ideographic_justification_char(text[c])) break;
+                jo[i].expansionMinimum = 0.0f;
+                jo[i].expansionMaximum = font_em_size;
+                jo[i].compressionMaximum = 0.0f;
+                jo[i].expansionPriority = 2;
+                jo[i].compressionPriority = 2;
+                jo[i].allowResidualExpansion = 1;
+                jo[i].allowResidualCompression = 0;
+                jo[i].applyToLeadingEdge = 0;
+                jo[i].applyToTrailingEdge = 1;
+                break;
+            default:
+                break;
+        }
+    }
+
+    return S_OK;
 }
 
 static HRESULT WINAPI dwritetextanalyzer1_JustifyGlyphAdvances(IDWriteTextAnalyzer2 *iface,
     FLOAT width, UINT32 glyph_count, const DWRITE_JUSTIFICATION_OPPORTUNITY *jo, const FLOAT *advances,
     const DWRITE_GLYPH_OFFSET *offsets, FLOAT *justifiedadvances, DWRITE_GLYPH_OFFSET *justifiedoffsets)
 {
-    FIXME("(%.2f %u %p %p %p %p %p): stub\n", width, glyph_count, jo, advances, offsets, justifiedadvances,
-        justifiedoffsets);
-    return E_NOTIMPL;
+    float total = 0.0f, delta, *lead = NULL, *trail = NULL, *limit = NULL;
+    unsigned int pass, open;
+    UINT32 i;
+
+    TRACE("%.2f, %u, %p, %p, %p, %p, %p.\n", width, glyph_count, jo, advances, offsets, justifiedadvances,
+            justifiedoffsets);
+
+    if (!jo || !advances || !justifiedadvances || width < 0.0f)
+        return E_INVALIDARG;
+
+    for (i = 0; i < glyph_count; ++i)
+        total += advances[i];
+    delta = width - total;
+
+    if (!(lead = calloc(glyph_count * 3 + 1, sizeof(*lead))))
+        return E_OUTOFMEMORY;
+    trail = lead + glyph_count;
+    limit = trail + glyph_count;
+
+    if (delta > 0.0f)
+    {
+        float remaining = delta;
+
+        /* Every participating edge takes its minimum first, the rest is shared equally. */
+        for (i = 0, open = 0; i < glyph_count; ++i)
+        {
+            if (jo[i].applyToLeadingEdge) { lead[i] = jo[i].expansionMinimum; remaining -= lead[i]; }
+            if (jo[i].applyToTrailingEdge) { trail[i] = jo[i].expansionMinimum; remaining -= trail[i]; }
+        }
+
+        for (pass = 0; pass < 8 && remaining > 0.001f; ++pass)
+        {
+            float share;
+
+            for (i = 0, open = 0; i < glyph_count; ++i)
+            {
+                if (jo[i].applyToLeadingEdge && lead[i] < jo[i].expansionMaximum) open++;
+                if (jo[i].applyToTrailingEdge && trail[i] < jo[i].expansionMaximum) open++;
+            }
+            if (!open) break;
+
+            share = remaining / open;
+            for (i = 0; i < glyph_count; ++i)
+            {
+                float room, add;
+
+                if (jo[i].applyToLeadingEdge && lead[i] < jo[i].expansionMaximum)
+                {
+                    room = jo[i].expansionMaximum - lead[i];
+                    add = min(share, room);
+                    lead[i] += add;
+                    remaining -= add;
+                }
+                if (jo[i].applyToTrailingEdge && trail[i] < jo[i].expansionMaximum)
+                {
+                    room = jo[i].expansionMaximum - trail[i];
+                    add = min(share, room);
+                    trail[i] += add;
+                    remaining -= add;
+                }
+            }
+        }
+    }
+    else if (delta < 0.0f)
+    {
+        float remaining = -delta;
+
+        for (pass = 0; pass < 8 && remaining > 0.001f; ++pass)
+        {
+            float share;
+
+            for (i = 0, open = 0; i < glyph_count; ++i)
+            {
+                if (jo[i].applyToLeadingEdge && -lead[i] < jo[i].compressionMaximum) open++;
+                if (jo[i].applyToTrailingEdge && -trail[i] < jo[i].compressionMaximum) open++;
+            }
+            if (!open) break;
+
+            share = remaining / open;
+            for (i = 0; i < glyph_count; ++i)
+            {
+                float add;
+
+                if (jo[i].applyToLeadingEdge && -lead[i] < jo[i].compressionMaximum)
+                {
+                    add = min(share, jo[i].compressionMaximum + lead[i]);
+                    lead[i] -= add;
+                    remaining -= add;
+                }
+                if (jo[i].applyToTrailingEdge && -trail[i] < jo[i].compressionMaximum)
+                {
+                    add = min(share, jo[i].compressionMaximum + trail[i]);
+                    trail[i] -= add;
+                    remaining -= add;
+                }
+            }
+        }
+    }
+    (void)limit;
+
+    for (i = 0; i < glyph_count; ++i)
+    {
+        justifiedadvances[i] = advances[i] + lead[i] + trail[i];
+        if (justifiedoffsets)
+        {
+            if (offsets)
+                justifiedoffsets[i] = offsets[i];
+            else
+                justifiedoffsets[i].advanceOffset = justifiedoffsets[i].ascenderOffset = 0.0f;
+            justifiedoffsets[i].advanceOffset += lead[i];
+        }
+    }
+
+    free(lead);
+    return S_OK;
 }
 
