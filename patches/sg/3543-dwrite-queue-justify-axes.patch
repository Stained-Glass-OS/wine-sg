+static void glyph_image_png_size(const BYTE *data, unsigned int size, DWRITE_GLYPH_IMAGE_DATA *image)
+{
+    static const BYTE sig[] = { 0x89, 'P', 'N', 'G', '\r', '\n', 0x1a, '\n' };
+
+    if (size < 24 || memcmp(data, sig, sizeof(sig))) return;
+    image->pixelSize.width = (data[16] << 24) | (data[17] << 16) | (data[18] << 8) | data[19];
+    image->pixelSize.height = (data[20] << 24) | (data[21] << 16) | (data[22] << 8) | data[23];
+}
+
+static void release_glyph_image_context(struct glyph_image_context *ctx)
+{
+    struct dwrite_fonttable *tables[] = { &ctx->sbix, &ctx->cblc, &ctx->cbdt, &ctx->svg };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(tables); ++i)
+    {
+        if (tables[i]->context)
+            IDWriteFontFace5_ReleaseFontTable(ctx->face, tables[i]->context);
+    }
+    IDWriteFontFace5_Release(ctx->face);
+    free(ctx);
+}
+
+static BOOL glyph_image_add(struct glyph_image_candidate **list, size_t *count, size_t *size,
+        const struct glyph_image_candidate *candidate)
+{
+    if (!dwrite_array_reserve((void **)list, size, *count + 1, sizeof(**list))) return FALSE;
+    (*list)[(*count)++] = *candidate;
+    return TRUE;
+}
