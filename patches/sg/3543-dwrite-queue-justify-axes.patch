 static HRESULT WINAPI dwritetextanalyzer1_AnalyzeVerticalGlyphOrientation(IDWriteTextAnalyzer2 *iface,
     IDWriteTextAnalysisSource1* source, UINT32 text_pos, UINT32 len, IDWriteTextAnalysisSink1 *sink)
 {
-    FIXME("(%p %u %u %p): stub\n", source, text_pos, len, sink);
-    return E_NOTIMPL;
+    UINT32 pos = text_pos, end;
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %u, %u, %p.\n", source, text_pos, len, sink);
+
+    if (!source || !sink)
+        return E_INVALIDARG;
+
+    if (!len) return S_OK;
+    end = text_pos + len;
+
+    while (pos < end)
+    {
+        DWRITE_VERTICAL_GLYPH_ORIENTATION orientation;
+        struct text_source_context context;
+        UINT32 seg_len, seg_end, run_start, run_len;
+        UINT8 bidi_level = 0;
+        BOOL upright = FALSE, have_run = FALSE;
+
+        seg_len = 0;
+        orientation = DWRITE_VERTICAL_GLYPH_ORIENTATION_DEFAULT;
+        if (FAILED(hr = IDWriteTextAnalysisSource1_GetVerticalGlyphOrientation(source, pos, &seg_len,
+                &orientation, &bidi_level)))
+            return hr;
+
+        /* The source reports what it has for the rest of its span, clip to the request. */
+        seg_len = seg_len ? min(seg_len, end - pos) : end - pos;
+        seg_end = pos + seg_len;
+
+        if (FAILED(hr = text_source_context_init(&context, (IDWriteTextAnalysisSource *)source, pos, seg_len)))
+            return hr;
+
+        run_start = pos;
+        run_len = 0;
+        while (!text_source_get_next_u32_char(&context))
+        {
+            BOOL char_upright = orientation == DWRITE_VERTICAL_GLYPH_ORIENTATION_STACKED ||
+                    is_upright_in_vertical_text(context.ch);
+
+            if (have_run && char_upright != upright)
+            {
+                hr = IDWriteTextAnalysisSink1_SetGlyphOrientation(sink, run_start, run_len,
+                        upright ? DWRITE_GLYPH_ORIENTATION_ANGLE_0_DEGREES :
+                        (bidi_level & 1 ? DWRITE_GLYPH_ORIENTATION_ANGLE_270_DEGREES : DWRITE_GLYPH_ORIENTATION_ANGLE_90_DEGREES),
+                        bidi_level, !upright, bidi_level & 1);
+                if (FAILED(hr)) return hr;
+                run_start += run_len;
+                run_len = 0;
+            }
+            upright = char_upright;
+            have_run = TRUE;
+            run_len += text_source_get_char_length(&context);
+        }
+
+        if (have_run && run_len)
+        {
+            hr = IDWriteTextAnalysisSink1_SetGlyphOrientation(sink, run_start, run_len,
+                    upright ? DWRITE_GLYPH_ORIENTATION_ANGLE_0_DEGREES :
+                    (bidi_level & 1 ? DWRITE_GLYPH_ORIENTATION_ANGLE_270_DEGREES : DWRITE_GLYPH_ORIENTATION_ANGLE_90_DEGREES),
+                    bidi_level, !upright, bidi_level & 1);
+            if (FAILED(hr)) return hr;
+        }
+
+        if (context.status != S_OK && FAILED(context.status)) return context.status;
+        pos = seg_end;
+    }
+
+    return S_OK;
 }
 
