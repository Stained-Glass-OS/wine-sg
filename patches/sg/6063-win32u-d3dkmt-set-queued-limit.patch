From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: NtGdiDdDDISetQueuedLimit sets and reads a device's limit (6063)

It returned STATUS_NOT_IMPLEMENTED. The device keeps its queued-present
limit for D3DKMT_GET_QUEUEDLIMIT_PRESENT; an unknown device or type is
STATUS_INVALID_PARAMETER.
---
diff --git a/dlls/win32u/d3dkmt.c b/dlls/win32u/d3dkmt.c
index d62894f..37a1a3c 100644
--- a/dlls/win32u/d3dkmt.c
+++ b/dlls/win32u/d3dkmt.c
@@ -47,6 +47,7 @@ struct d3dkmt_device
 {
     D3DKMT_HANDLE handle;               /* Kernel mode graphics device handle*/
     struct list entry;                  /* List entry */
+    UINT queued_present_limit;          /* NtGdiDdDDISetQueuedLimit's, 0 until set */
 };
 
 struct d3dkmt_vidpn_source
@@ -645,10 +646,35 @@ NTSTATUS WINAPI NtGdiDdDDIQueryVideoMemoryInfo( D3DKMT_QUERYVIDEOMEMORYINFO *des
 /******************************************************************************
  *           NtGdiDdDDISetQueuedLimit    (win32u.@)
  */
+/* The limit on a device's queued presents. Presents here are not queued in a
+ * kernel-mode driver, so no more than one is ever outstanding and any limit holds;
+ * the device keeps the value for D3DKMT_GET_QUEUEDLIMIT_PRESENT. */
 NTSTATUS WINAPI NtGdiDdDDISetQueuedLimit( D3DKMT_SETQUEUEDLIMIT *desc )
 {
-    FIXME( "(%p): stub\n", desc );
-    return STATUS_NOT_IMPLEMENTED;
+    struct d3dkmt_device *device, *found = NULL;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE( "(%p)\n", desc );
+
+    if (!desc || !desc->hDevice) return STATUS_INVALID_PARAMETER;
+    if (desc->Type != D3DKMT_SET_QUEUEDLIMIT_PRESENT && desc->Type != D3DKMT_GET_QUEUEDLIMIT_PRESENT)
+        return STATUS_INVALID_PARAMETER;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    LIST_FOR_EACH_ENTRY( device, &d3dkmt_devices, struct d3dkmt_device, entry )
+    {
+        if (device->handle != desc->hDevice) continue;
+        found = device;
+        break;
+    }
+#ifdef SG_MUTANT_QUEUEDLIMIT_ANY_DEVICE
+    if (!found && !list_empty( &d3dkmt_devices )) found = LIST_ENTRY( list_head( &d3dkmt_devices ), struct d3dkmt_device, entry );
+#endif
+    if (!found) status = STATUS_INVALID_PARAMETER;
+    else if (desc->Type == D3DKMT_SET_QUEUEDLIMIT_PRESENT) found->queued_present_limit = desc->QueuedPresentLimit;
+    else desc->QueuedPresentLimit = found->queued_present_limit;
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
 }
 
 /******************************************************************************
