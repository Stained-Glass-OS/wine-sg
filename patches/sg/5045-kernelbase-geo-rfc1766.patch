From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: Implement GEO_RFC1766 in GetGeoInfoW.

GetGeoInfoW(GEO_RFC1766) gives the name "derived from the GetGeoInfo
parameters language and GeoId": the language's primary part and the
nation's ISO code - "en-US" for 0x409 or 0x09 with the United States,
"zh-US" for 0x04 ("ignores the locale-specific portion"); LangId 0 means the
user's default language. It failed with ERROR_CALL_NOT_IMPLEMENTED.
GEO_LCID keeps its FIXME; GetGeoInfoEx still refuses both.

Gate: test/kernelbase-georfc1766-gate.sh (64/32).
---
 dlls/kernelbase/locale.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/dlls/kernelbase/locale.c b/dlls/kernelbase/locale.c
index ef40f58..b570d4c 100644
--- a/dlls/kernelbase/locale.c
+++ b/dlls/kernelbase/locale.c
@@ -1870,7 +1870,28 @@ static int get_geo_info( const struct geo_id *geo, enum SYSGEOTYPE type,
         break;
     }
 #endif
+#ifndef SG_MUTANT_GEO_RFC1766
     case GEO_RFC1766:
+    {
+        /* "derived from the GetGeoInfo parameters language and GeoId": the
+         * language's primary name and the nation, "en-US" for 0x409 or 0x09
+         * with the United States; "ignores the locale-specific portion" */
+        WCHAR name[LOCALE_NAME_MAX_LENGTH];
+
+        if (!lang) lang = GetUserDefaultLangID();
+        if (!GetLocaleInfoW( MAKELCID( MAKELANGID( PRIMARYLANGID(lang), SUBLANG_NEUTRAL ), SORT_DEFAULT ),
+                             LOCALE_SISO639LANGNAME, name, ARRAY_SIZE(name) ))
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return 0;
+        }
+        swprintf( tmp, ARRAY_SIZE(tmp), L"%s-%s", name, geo->iso2 );
+        break;
+    }
+#endif
+#ifdef SG_MUTANT_GEO_RFC1766
+    case GEO_RFC1766:
+#endif
     case GEO_LCID:
 #ifdef SG_MUTANT_GEONAME
     case GEO_FRIENDLYNAME:
