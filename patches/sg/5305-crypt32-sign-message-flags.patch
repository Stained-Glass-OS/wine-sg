From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: CryptSignMessage key id, bare content and silent flags

crypt32: CryptSignMessage honours the flags of CRYPT_SIGN_MESSAGE_PARA it
ignored: CRYPT_MESSAGE_KEYID_SIGNER_FLAG identifies the signer by the signing
certificate's key identifier property (an error if it has none),
CRYPT_MESSAGE_BARE_CONTENT_OUT_FLAG returns the SignedData without its
ContentInfo, as the inner content of another message, and
CRYPT_MESSAGE_SILENT_KEYSET_FLAG acquires the key silently. Verifying such a
message with CMSG_CTRL_VERIFY_SIGNATURE finds the signer by comparing the key
identifier with the subject key identifier extension of the CERT_INFO given
(CRYPT_E_SIGNER_NOT_FOUND if they differ or there is none). The encode
structures with the CMS fields move to crypt32_private.h to be shared.
---
--- a/dlls/crypt32/crypt32_private.h
+++ b/dlls/crypt32/crypt32_private.h
@@ -33,6 +33,38 @@
 #define CERT_ISSUER_CHAIN_PUB_KEY_CNG_ALG_BIT_LENGTH_PROP_ID    96
 #endif
 
+/* CMSG_SIGNER_ENCODE_INFO with the CMS fields (wincrypt.h has them only under
+ * CMSG_SIGNER_ENCODE_INFO_HAS_CMS_FIELDS) */
+typedef struct _CMSG_SIGNER_ENCODE_INFO_WITH_CMS
+{
+    DWORD                      cbSize;
+    PCERT_INFO                 pCertInfo;
+    HCRYPTPROV                 hCryptProv;
+    DWORD                      dwKeySpec;
+    CRYPT_ALGORITHM_IDENTIFIER HashAlgorithm;
+    void                      *pvHashAuxInfo;
+    DWORD                      cAuthAttr;
+    PCRYPT_ATTRIBUTE           rgAuthAttr;
+    DWORD                      cUnauthAttr;
+    PCRYPT_ATTRIBUTE           rgUnauthAttr;
+    CERT_ID                    SignerId;
+    CRYPT_ALGORITHM_IDENTIFIER HashEncryptionAlgorithm;
+    void                      *pvHashEncryptionAuxInfo;
+} CMSG_SIGNER_ENCODE_INFO_WITH_CMS;
+
+typedef struct _CMSG_SIGNED_ENCODE_INFO_WITH_CMS
+{
+    DWORD                             cbSize;
+    DWORD                             cSigners;
+    CMSG_SIGNER_ENCODE_INFO_WITH_CMS *rgSigners;
+    DWORD                             cCertEncoded;
+    PCERT_BLOB                        rgCertEncoded;
+    DWORD                             cCrlEncoded;
+    PCRL_BLOB                         rgCrlEncoded;
+    DWORD                             cAttrCertEncoded;
+    PCERT_BLOB                        rgAttrCertEncoded;
+} CMSG_SIGNED_ENCODE_INFO_WITH_CMS;
+
 BOOL CNG_ImportPubKey(CERT_PUBLIC_KEY_INFO *pubKeyInfo, BCRYPT_KEY_HANDLE *key);
 BOOL cng_prepare_signature(const char *alg_oid, BYTE *encoded_sig, DWORD encoded_sig_len,
     BYTE **sig_value, DWORD *sig_len);
--- a/dlls/crypt32/message.c
+++ b/dlls/crypt32/message.c
@@ -449,8 +449,9 @@ BOOL WINAPI CryptSignMessage(PCRYPT_SIGN_MESSAGE_PARA pSignPara,
     DWORD i, keySpec;
     PCERT_BLOB certBlob = NULL;
     PCRL_BLOB crlBlob = NULL;
-    CMSG_SIGNED_ENCODE_INFO signInfo;
-    CMSG_SIGNER_ENCODE_INFO signer;
+    CMSG_SIGNED_ENCODE_INFO_WITH_CMS signInfo;
+    CMSG_SIGNER_ENCODE_INFO_WITH_CMS signer;
+    BYTE *keyId = NULL;
     HCRYPTMSG msg = 0;
 
     TRACE("(%p, %d, %ld, %p, %p, %p, %p)\n", pSignPara, fDetachedSignature,
@@ -466,7 +467,7 @@ BOOL WINAPI CryptSignMessage(PCRYPT_SIGN_MESSAGE_PARA pSignPara,
     }
     memset(&signer, 0, sizeof(signer));
     memset(&signInfo, 0, sizeof(signInfo));
-    signInfo.cbSize = sizeof(signInfo);
+    signInfo.cbSize = sizeof(CMSG_SIGNED_ENCODE_INFO);
     hCryptProv = 0;
     ret = TRUE;
     /* Without a signing certificate Windows still makes a message, one with
@@ -477,11 +478,12 @@ BOOL WINAPI CryptSignMessage(PCRYPT_SIGN_MESSAGE_PARA pSignPara,
     if (pSignPara->pSigningCert)
     {
         ret = CryptAcquireCertificatePrivateKey(pSignPara->pSigningCert,
-         CRYPT_ACQUIRE_CACHE_FLAG, NULL, &hCryptProv, &keySpec, &freeProv);
+         CRYPT_ACQUIRE_CACHE_FLAG | ((pSignPara->dwFlags & CRYPT_MESSAGE_SILENT_KEYSET_FLAG) ?
+         CRYPT_ACQUIRE_SILENT_FLAG : 0), NULL, &hCryptProv, &keySpec, &freeProv);
         if (!ret)
             return FALSE;
 
-        signer.cbSize = sizeof(signer);
+        signer.cbSize = sizeof(CMSG_SIGNER_ENCODE_INFO);
         signer.pCertInfo = pSignPara->pSigningCert->pCertInfo;
         signer.hCryptProv = hCryptProv;
         signer.dwKeySpec = keySpec;
@@ -492,6 +494,28 @@ BOOL WINAPI CryptSignMessage(PCRYPT_SIGN_MESSAGE_PARA pSignPara,
         signer.cUnauthAttr = pSignPara->cUnauthAttr;
         signer.rgUnauthAttr = pSignPara->rgUnauthAttr;
 
+        /* identify the signer by its key identifier instead of its issuer and serial number */
+#ifndef SG_MUTANT_SIGN_NO_KEYID
+        if (pSignPara->dwFlags & CRYPT_MESSAGE_KEYID_SIGNER_FLAG)
+        {
+            DWORD size = 0;
+
+            if (!CertGetCertificateContextProperty(pSignPara->pSigningCert, CERT_KEY_IDENTIFIER_PROP_ID, NULL, &size) ||
+             !(keyId = CryptMemAlloc(size)) ||
+             !CertGetCertificateContextProperty(pSignPara->pSigningCert, CERT_KEY_IDENTIFIER_PROP_ID, keyId, &size))
+            {
+                CryptMemFree(keyId);
+                if (freeProv)
+                    CryptReleaseContext(hCryptProv, 0);
+                return FALSE;
+            }
+            signer.cbSize = sizeof(signer);
+            signer.SignerId.dwIdChoice = CERT_ID_KEY_IDENTIFIER;
+            signer.SignerId.KeyId.cbData = size;
+            signer.SignerId.KeyId.pbData = keyId;
+        }
+#endif
+
         signInfo.cSigners = 1;
         signInfo.rgSigners = &signer;
     }
@@ -528,7 +552,7 @@ BOOL WINAPI CryptSignMessage(PCRYPT_SIGN_MESSAGE_PARA pSignPara,
         else
             ret = FALSE;
     }
-    if (pSignPara->dwFlags || pSignPara->dwInnerContentType)
+    if ((pSignPara->dwFlags & CRYPT_MESSAGE_ENCAPSULATED_CONTENT_OUT_FLAG) || pSignPara->dwInnerContentType)
         FIXME("unimplemented feature\n");
 
     if (ret)
@@ -548,13 +572,21 @@ BOOL WINAPI CryptSignMessage(PCRYPT_SIGN_MESSAGE_PARA pSignPara,
         else
             ret = CryptMsgUpdate(msg, NULL, 0, TRUE);
         if (ret)
-            ret = CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, pbSignedBlob,
-             pcbSignedBlob);
+        {
+            /* an inner content of another message has no ContentInfo of its own */
+            DWORD param = (pSignPara->dwFlags & CRYPT_MESSAGE_BARE_CONTENT_OUT_FLAG) ?
+             CMSG_BARE_CONTENT_PARAM : CMSG_CONTENT_PARAM;
+#ifdef SG_MUTANT_SIGN_NO_BARE
+            param = CMSG_CONTENT_PARAM;
+#endif
+            ret = CryptMsgGetParam(msg, param, 0, pbSignedBlob, pcbSignedBlob);
+        }
         CryptMsgClose(msg);
     }
     else
         ret = FALSE;
 
+    CryptMemFree(keyId);
     CryptMemFree(crlBlob);
     CryptMemFree(certBlob);
     if (freeProv)
--- a/dlls/crypt32/msg.c
+++ b/dlls/crypt32/msg.c
@@ -597,36 +597,6 @@ static HCRYPTMSG CHashEncodeMsg_Open(DWORD dwFlags, const void *pvMsgEncodeInfo,
     return msg;
 }
 
-typedef struct _CMSG_SIGNER_ENCODE_INFO_WITH_CMS
-{
-    DWORD                      cbSize;
-    PCERT_INFO                 pCertInfo;
-    HCRYPTPROV                 hCryptProv;
-    DWORD                      dwKeySpec;
-    CRYPT_ALGORITHM_IDENTIFIER HashAlgorithm;
-    void                      *pvHashAuxInfo;
-    DWORD                      cAuthAttr;
-    PCRYPT_ATTRIBUTE           rgAuthAttr;
-    DWORD                      cUnauthAttr;
-    PCRYPT_ATTRIBUTE           rgUnauthAttr;
-    CERT_ID                    SignerId;
-    CRYPT_ALGORITHM_IDENTIFIER HashEncryptionAlgorithm;
-    void                      *pvHashEncryptionAuxInfo;
-} CMSG_SIGNER_ENCODE_INFO_WITH_CMS;
-
-typedef struct _CMSG_SIGNED_ENCODE_INFO_WITH_CMS
-{
-    DWORD                             cbSize;
-    DWORD                             cSigners;
-    CMSG_SIGNER_ENCODE_INFO_WITH_CMS *rgSigners;
-    DWORD                             cCertEncoded;
-    PCERT_BLOB                        rgCertEncoded;
-    DWORD                             cCrlEncoded;
-    PCRL_BLOB                         rgCrlEncoded;
-    DWORD                             cAttrCertEncoded;
-    PCERT_BLOB                        rgAttrCertEncoded;
-} CMSG_SIGNED_ENCODE_INFO_WITH_CMS;
-
 static BOOL CRYPT_IsValidSigner(const CMSG_SIGNER_ENCODE_INFO_WITH_CMS *signer)
 {
     if (signer->cbSize != sizeof(CMSG_SIGNER_ENCODE_INFO) &&
@@ -3546,7 +3516,21 @@ static BOOL CDecodeSignedMsg_VerifySignature(CDecodeMsg *msg, PCERT_INFO info)
         }
         else
         {
-            FIXME("signer %ld: unimplemented for key id\n", i);
+            /* the signer's certificate is the one whose subject key identifier extension is the key id */
+            PCERT_EXTENSION ext = CertFindExtension(szOID_SUBJECT_KEY_IDENTIFIER, info->cExtension, info->rgExtension);
+            CRYPT_DATA_BLOB key_id;
+            DWORD size = sizeof(key_id);
+
+#ifndef SG_MUTANT_KEYID_ANY
+            if (ext && CryptDecodeObjectEx(X509_ASN_ENCODING, szOID_SUBJECT_KEY_IDENTIFIER, ext->Value.pbData,
+                    ext->Value.cbData, CRYPT_DECODE_NOCOPY_FLAG, NULL, &key_id, &size))
+                ret = key_id.cbData == signerInfo->SignerId.KeyId.cbData &&
+                      !memcmp(key_id.pbData, signerInfo->SignerId.KeyId.pbData, key_id.cbData);
+#else
+            ret = TRUE;
+#endif
+            if (ret)
+                break;
         }
     }
     if (ret)
--- a/dlls/crypt32/tests/message.c
+++ b/dlls/crypt32/tests/message.c
@@ -1135,6 +1135,107 @@ static void test_sign_message(void)
         CryptMemFree(signedBlob);
     }
 
+    /* the flags: the output as the inner content of another message, and the signer by its key identifier */
+    {
+        static BYTE key_id[] = { 0x10, 0x20, 0x30, 0x40, 0x50 };
+        static BYTE other_key_id[] = { 0x10, 0x20, 0x30, 0x40, 0x51 };
+        CRYPT_DATA_BLOB key_id_blob = { sizeof(key_id), key_id };
+        BYTE *bare, *whole;
+        DWORD bare_size, whole_size, size;
+        CMSG_CMS_SIGNER_INFO *signer_info;
+        CERT_INFO cert_info;
+        CERT_EXTENSION ext;
+        CRYPT_DATA_BLOB ski;
+        HCRYPTMSG msg;
+
+        para.dwFlags = CRYPT_MESSAGE_BARE_CONTENT_OUT_FLAG;
+        signedBlobSize = 0;
+        ret = CryptSignMessage(&para, FALSE, 1, toSign, signSize, NULL, &bare_size);
+        ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
+        bare = CryptMemAlloc(bare_size);
+        ret = CryptSignMessage(&para, FALSE, 1, toSign, signSize, bare, &bare_size);
+        ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
+        para.dwFlags = 0;
+        ret = CryptSignMessage(&para, FALSE, 1, toSign, signSize, NULL, &whole_size);
+        ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
+        whole = CryptMemAlloc(whole_size);
+        ret = CryptSignMessage(&para, FALSE, 1, toSign, signSize, whole, &whole_size);
+        ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
+        ok(bare_size < whole_size && bare[0] == 0x30, "got sizes %lu, %lu, tag %#x.\n", bare_size, whole_size, bare[0]);
+        ok(bare_size < whole_size && !memcmp(whole + whole_size - bare_size, bare, bare_size),
+                "the bare content is not the end of the message.\n");
+        CryptMemFree(bare);
+        CryptMemFree(whole);
+
+        /* identifying the signer by key identifier needs one */
+        SetLastError(0xdeadbeef);
+        para.dwFlags = CRYPT_MESSAGE_KEYID_SIGNER_FLAG;
+        ret = CryptSignMessage(&para, FALSE, 1, toSign, signSize, NULL, &whole_size);
+        ok(!ret, "got ret %d, error %#lx.\n", ret, GetLastError());
+
+        ret = CertSetCertificateContextProperty(para.pSigningCert, CERT_KEY_IDENTIFIER_PROP_ID, 0, &key_id_blob);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ret = CryptSignMessage(&para, FALSE, 1, toSign, signSize, NULL, &whole_size);
+        ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
+        whole = CryptMemAlloc(whole_size);
+        ret = CryptSignMessage(&para, FALSE, 1, toSign, signSize, whole, &whole_size);
+        ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
+        para.dwFlags = 0;
+
+        msg = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, 0, 0, 0, NULL, NULL);
+        ret = CryptMsgUpdate(msg, whole, whole_size, TRUE);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        size = 0;
+        ret = CryptMsgGetParam(msg, CMSG_CMS_SIGNER_INFO_PARAM, 0, NULL, &size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        signer_info = CryptMemAlloc(size);
+        ret = CryptMsgGetParam(msg, CMSG_CMS_SIGNER_INFO_PARAM, 0, signer_info, &size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ok(signer_info->dwVersion == CMSG_SIGNER_INFO_V3, "got version %lu.\n", signer_info->dwVersion);
+        ok(signer_info->SignerId.dwIdChoice == CERT_ID_KEY_IDENTIFIER, "got id choice %lu.\n",
+                signer_info->SignerId.dwIdChoice);
+        ok(signer_info->SignerId.KeyId.cbData == sizeof(key_id)
+                && !memcmp(signer_info->SignerId.KeyId.pbData, key_id, sizeof(key_id)), "unexpected key id.\n");
+        CryptMemFree(signer_info);
+
+        /* the certificate that verifies it has that key identifier */
+        cert_info = *para.pSigningCert->pCertInfo;
+        ext.pszObjId = (char *)szOID_SUBJECT_KEY_IDENTIFIER;
+        ext.fCritical = FALSE;
+        size = 0;
+        ret = CryptEncodeObjectEx(X509_ASN_ENCODING, X509_OCTET_STRING, &key_id_blob, CRYPT_ENCODE_ALLOC_FLAG,
+                NULL, &ski.pbData, &size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ext.Value.pbData = ski.pbData;
+        ext.Value.cbData = size;
+        cert_info.cExtension = 1;
+        cert_info.rgExtension = &ext;
+        ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE, &cert_info);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        LocalFree(ski.pbData);
+
+        /* and another identifier does not */
+        ski.cbData = sizeof(other_key_id);
+        ski.pbData = other_key_id;
+        ret = CryptEncodeObjectEx(X509_ASN_ENCODING, X509_OCTET_STRING, &ski, CRYPT_ENCODE_ALLOC_FLAG,
+                NULL, &ext.Value.pbData, &size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ext.Value.cbData = size;
+        SetLastError(0xdeadbeef);
+        ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE, &cert_info);
+        ok(!ret && GetLastError() == CRYPT_E_SIGNER_NOT_FOUND, "got ret %d, error %#lx.\n", ret, GetLastError());
+        LocalFree(ext.Value.pbData);
+
+        /* a certificate without the extension does not */
+        cert_info.cExtension = 0;
+        SetLastError(0xdeadbeef);
+        ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE, &cert_info);
+        ok(!ret && GetLastError() == CRYPT_E_SIGNER_NOT_FOUND, "got ret %d, error %#lx.\n", ret, GetLastError());
+
+        CryptMsgClose(msg);
+        CryptMemFree(whole);
+    }
+
     if (para.pSigningCert)
         CertFreeCertificateContext(para.pSigningCert);
     if (hKey)
