From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: a person's hive file is closed to other accounts (9100)

On Windows another user's NTUSER.DAT cannot be read without being an
administrator. In a shared prefix the machine's server writes each
person's user-<uid>.reg with its umask (0644 under systemd): every account
in the Wine group could read every other person's HKCU. A user hive
(user-<uid>.reg, the prefix owner's user.reg) is now made 0600, and one the
server finds open to group or others when it loads it is closed (fchmod,
its own regular file only, never through a link). system.reg and
userdef.reg (the Default User template) keep their modes. Nothing but the
server reads the hives; people reach their HKCU through it, as on Windows.
sg-session closes existing hives at boot too.

Gate test/hiveprivate-gate.sh. Mutant: SG_MUTANT_HIVE_SHARED.
---
--- a/server/registry.c
+++ b/server/registry.c
@@ -2383,12 +2383,58 @@
     return 1;
 }
 
+/* Stained Glass OS 9100: no account may read another person's hive file.
+ * On Windows another user's NTUSER.DAT cannot be read without being an
+ * administrator: the profile and the file give the person, SYSTEM and
+ * Administrators access, and while the hive is loaded only the kernel has
+ * it. Here the hives are files the machine's server (the SYSTEM account)
+ * writes into the shared prefix, and they were made with its umask, 0644:
+ * every account in the Wine group could read every other person's HKCU --
+ * their recent files, their settings, what Credential Manager keeps there.
+ * In a shared prefix a user hive (user-<uid>.reg, and the prefix owner's
+ * user.reg) is made 0600, and one the server finds open to others when it
+ * loads it (made before this) is closed to them. Nothing but the server
+ * reads them: people reach their HKCU through it, as on Windows. */
+static int sg_private_hive( const char *filename )
+{
+    size_t len = strlen( filename );
+
+    if (!sg_system_prefix) return 0;
+#ifdef SG_MUTANT_HIVE_SHARED
+    return 0;
+#endif
+    if (!strcmp( filename, "user.reg" )) return 1;
+    return len > 9 && !strncmp( filename, "user-", 5 ) && !strcmp( filename + len - 4, ".reg" );
+}
+
+static void sg_hive_closed_to_others( const char *filename )
+{
+    struct stat st;
+    int fd;
+
+    if (!sg_private_hive( filename )) return;
+    if ((fd = open( filename, O_RDONLY | O_NOFOLLOW | O_NONBLOCK )) == -1) return;
+    /* only the server's own regular file: never through a link to another */
+    if (!fstat( fd, &st ) && S_ISREG( st.st_mode ) && st.st_nlink == 1 &&
+        st.st_uid == getuid() && (st.st_mode & 077))
+    {
+        if (fchmod( fd, st.st_mode & 07700 ) == -1)
+            fprintf( stderr, "wineserver: %s could not be closed to others: %s\n", filename, strerror( errno ));
+    }
+    close( fd );
+}
+
 /* load one of the initial registry files */
 static int load_init_registry_from_file( const char *filename, struct key *key )
 {
     FILE *f = NULL;
 
-    if (!sg_untrusted_registry_file( filename ) && (f = fopen( filename, "r" )))
+    if (!sg_untrusted_registry_file( filename ))
+    {
+        sg_hive_closed_to_others( filename );
+        f = fopen( filename, "r" );
+    }
+    if (f)
     {
         load_keys( key, filename, f, 0 );
         fclose( f );
@@ -2858,7 +2904,8 @@
     for (;;)
     {
         snprintf( tmp, sizeof(tmp), "reg%lx%04x.tmp", (long) getpid(), count++ );
-        if ((fd = open( tmp, O_CREAT | O_EXCL | O_WRONLY, 0666 )) != -1) break;
+        /* a person's hive: no other account may read it (9100) */
+        if ((fd = open( tmp, O_CREAT | O_EXCL | O_WRONLY, sg_private_hive( filename ) ? 0600 : 0666 )) != -1) break;
         if (errno != EEXIST) goto done;
         close( fd );
     }
