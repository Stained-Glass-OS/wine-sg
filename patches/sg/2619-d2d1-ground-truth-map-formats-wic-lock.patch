--- a/dlls/d2d1/bitmap.c
+++ b/dlls/d2d1/bitmap.c
@@ -288,7 +288,16 @@ static HRESULT STDMETHODCALLTYPE d2d_bitmap_GetSurface(ID2D1Bitmap1 *iface, IDXG
     if (*surface)
         IDXGISurface_AddRef(*surface);
 
-    return *surface ? S_OK : D2DERR_INVALID_CALL;
+    if (*surface)
+        return S_OK;
+
+    /* the target bitmap of a render target without a surface is another
+     * failure than a bitmap that never had one */
+#ifdef SG_MUTANT_D2D_SURFACE_ERROR_SAME
+    return D2DERR_INVALID_CALL;
+#else
+    return bitmap->surface_hidden ? E_FAIL : D2DERR_INVALID_CALL;
+#endif
 }
 
