@@ -306,9 +315,6 @@ static HRESULT STDMETHODCALLTYPE d2d_bitmap_Map(ID2D1Bitmap1 *iface, D2D1_MAP_OP
     if (!(bitmap->options & D2D1_BITMAP_OPTIONS_CPU_READ))
         return E_INVALIDARG;
 
-    if (bitmap->mapped_resource.pData)
-        return D2DERR_WRONG_STATE;
-
     if (options == D2D1_MAP_OPTIONS_READ)
         map_type = D3D11_MAP_READ;
     else if (options == D2D1_MAP_OPTIONS_WRITE)
@@ -323,6 +329,37 @@ static HRESULT STDMETHODCALLTYPE d2d_bitmap_Map(ID2D1Bitmap1 *iface, D2D1_MAP_OP
         return E_INVALIDARG;
     }
 
+    /* the bitmap has to allow what is asked for: reading and writing need the
+     * texture's CPU access, discarding a dynamic texture */
+    {
+        ID3D11Texture2D *texture;
+        D3D11_TEXTURE2D_DESC desc;
+
+        if (SUCCEEDED(ID3D11Resource_QueryInterface(bitmap->resource, &IID_ID3D11Texture2D, (void **)&texture)))
+        {
+            ID3D11Texture2D_GetDesc(texture, &desc);
+            ID3D11Texture2D_Release(texture);
+#ifndef SG_MUTANT_D2D_MAP_ACCESS_UNCHECKED
+            if (((options & D2D1_MAP_OPTIONS_READ) && !(desc.CPUAccessFlags & D3D11_CPU_ACCESS_READ))
+                    || ((options & D2D1_MAP_OPTIONS_WRITE) && !(desc.CPUAccessFlags & D3D11_CPU_ACCESS_WRITE)))
+            {
+                WARN("The bitmap does not allow the access %#x.\n", options);
+                return E_INVALIDARG;
+            }
+#endif
+#ifndef SG_MUTANT_D2D_MAP_DISCARD_UNCHECKED
+            if ((options & D2D1_MAP_OPTIONS_DISCARD) && desc.Usage != D3D11_USAGE_DYNAMIC)
+            {
+                WARN("Discarding needs a dynamic bitmap.\n");
+                return E_INVALIDARG;
+            }
+#endif
+        }
+    }
+
+    if (bitmap->mapped_resource.pData)
+        return D2DERR_WRONG_STATE;
+
     ID3D11Resource_GetDevice(bitmap->resource, &device);
     ID3D11Device_GetImmediateContext(device, &context);
     if (SUCCEEDED(hr = ID3D11DeviceContext_Map(context, bitmap->resource, 0, map_type,
@@ -677,6 +714,18 @@ HRESULT d2d_bitmap_create_shared(struct d2d_device_context *context, REFIID iid,
             d = *desc;
             if (d.pixelFormat.format == DXGI_FORMAT_UNKNOWN)
                 d.pixelFormat.format = surface_desc.Format;
+
+            /* asked for a pixel format: it has to be one d2d draws */
+#ifndef SG_MUTANT_D2D_SURFACE_FORMAT_UNCHECKED
+            if (!context->creating_target && !format_supported(&d.pixelFormat))
+            {
+                WARN("Unsupported pixel format {%#x / %#x}.\n", d.pixelFormat.format, d.pixelFormat.alphaMode);
+                free(*bitmap);
+                *bitmap = NULL;
+                ID3D11Resource_Release(resource);
+                return D2DERR_UNSUPPORTED_PIXEL_FORMAT;
+            }
+#endif
         }
 
         if (d.dpiX == 0.0f || d.dpiY == 0.0f)
@@ -691,6 +740,7 @@ HRESULT d2d_bitmap_create_shared(struct d2d_device_context *context, REFIID iid,
         pixel_size.height = surface_desc.Height;
 
         d2d_bitmap_init(*bitmap, context, resource, pixel_size, &d);
+        (*bitmap)->surface_hidden = context->ops && context->ops->hides_target_surface;
         ID3D11Resource_Release(resource);
         TRACE("Created bitmap %p.\n", *bitmap);
 
