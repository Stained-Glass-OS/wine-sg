From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: Export and import AES-wrapped keys.

BCryptExportKey and BCryptImportKey handle BCRYPT_AES_WRAP_KEY_BLOB with an
AES wrapping key: RFC 3394 key wrap (the blob RFC 3565 uses), done with an ECB
key made from the wrapping key's secret. The exported key must be a multiple
of 8 bytes long; an unwrap whose integrity value does not match (wrong key,
damaged blob) fails. Both returned STATUS_NOT_IMPLEMENTED. Other blob types
with a wrapping key are unchanged.

Gate: test/bcrypt-aeswrap-gate.sh (64/32), against the RFC's test vectors.
---
 dlls/bcrypt/bcrypt_main.c | 114 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 114 insertions(+)

diff --git a/dlls/bcrypt/bcrypt_main.c b/dlls/bcrypt/bcrypt_main.c
index 1571d57..85bb26d 100644
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -2026,6 +2026,89 @@ NTSTATUS WINAPI BCryptFinalizeKeyPair( BCRYPT_KEY_HANDLE handle, ULONG flags )
     return ret;
 }
 
+/* RFC 3394 AES key wrap (BCRYPT_AES_WRAP_KEY_BLOB), with an ECB key made from
+ * the wrapping key's secret */
+static const UCHAR aes_wrap_iv[8] = {0xa6, 0xa6, 0xa6, 0xa6, 0xa6, 0xa6, 0xa6, 0xa6};
+
+static NTSTATUS aes_wrap_ecb_key( struct key *wrap_key, BCRYPT_ALG_HANDLE *alg, BCRYPT_KEY_HANDLE *ecb )
+{
+    NTSTATUS status;
+
+    if (wrap_key->alg_id != ALG_ID_AES) return STATUS_INVALID_PARAMETER;
+    if ((status = BCryptOpenAlgorithmProvider( alg, BCRYPT_AES_ALGORITHM, NULL, 0 ))) return status;
+    if (!(status = BCryptSetProperty( *alg, BCRYPT_CHAINING_MODE, (UCHAR *)BCRYPT_CHAIN_MODE_ECB,
+                                      sizeof(BCRYPT_CHAIN_MODE_ECB), 0 )))
+        status = BCryptGenerateSymmetricKey( *alg, ecb, NULL, 0, wrap_key->u.s.secret, wrap_key->u.s.secret_len, 0 );
+    if (status) BCryptCloseAlgorithmProvider( *alg, 0 );
+    return status;
+}
+
+static NTSTATUS aes_wrap( struct key *wrap_key, const UCHAR *plain, ULONG len, UCHAR *output )
+{
+    BCRYPT_ALG_HANDLE alg;
+    BCRYPT_KEY_HANDLE ecb;
+    UCHAR block[16], *r = output + 8;
+    ULONG n = len / 8, i, j, done;
+    NTSTATUS status;
+    UINT64 t;
+    int k;
+
+    if ((status = aes_wrap_ecb_key( wrap_key, &alg, &ecb ))) return status;
+    memcpy( output, aes_wrap_iv, 8 );
+    memmove( r, plain, len );
+    for (j = 0; j < 6 && !status; j++)
+        for (i = 0; i < n && !status; i++)
+        {
+            memcpy( block, output, 8 );
+            memcpy( block + 8, r + 8 * i, 8 );
+            if ((status = BCryptEncrypt( ecb, block, 16, NULL, NULL, 0, block, 16, &done, 0 ))) break;
+            t = (UINT64)n * j + i + 1;
+#ifndef SG_MUTANT_AES_WRAP_NO_COUNTER
+            for (k = 7; k >= 0; k--, t >>= 8) block[k] ^= (UCHAR)t;
+#else
+            (void)k;
+#endif
+            memcpy( output, block, 8 );
+            memcpy( r + 8 * i, block + 8, 8 );
+        }
+    BCryptDestroyKey( ecb );
+    BCryptCloseAlgorithmProvider( alg, 0 );
+    return status;
+}
+
+static NTSTATUS aes_unwrap( struct key *wrap_key, const UCHAR *input, ULONG len, UCHAR *plain )
+{
+    BCRYPT_ALG_HANDLE alg;
+    BCRYPT_KEY_HANDLE ecb;
+    UCHAR a[8], block[16];
+    ULONG n = len / 8 - 1, i, j, done;
+    NTSTATUS status;
+    UINT64 t;
+    int k;
+
+    if ((status = aes_wrap_ecb_key( wrap_key, &alg, &ecb ))) return status;
+    memcpy( a, input, 8 );
+    memcpy( plain, input + 8, len - 8 );
+    for (j = 6; j-- > 0 && !status;)
+        for (i = n; i-- > 0;)
+        {
+            memcpy( block, a, 8 );
+            t = (UINT64)n * j + i + 1;
+            for (k = 7; k >= 0; k--, t >>= 8) block[k] ^= (UCHAR)t;
+            memcpy( block + 8, plain + 8 * i, 8 );
+            if ((status = BCryptDecrypt( ecb, block, 16, NULL, NULL, 0, block, 16, &done, 0 ))) break;
+            memcpy( a, block, 8 );
+            memcpy( plain + 8 * i, block + 8, 8 );
+        }
+    BCryptDestroyKey( ecb );
+    BCryptCloseAlgorithmProvider( alg, 0 );
+#ifndef SG_MUTANT_AES_UNWRAP_NO_CHECK
+    /* the integrity check of the RFC: a wrong key or damaged blob fails */
+    if (!status && memcmp( a, aes_wrap_iv, 8 )) status = STATUS_UNSUCCESSFUL;
+#endif
+    return status;
+}
+
 NTSTATUS WINAPI BCryptImportKey( BCRYPT_ALG_HANDLE handle, BCRYPT_KEY_HANDLE decrypt_key, const WCHAR *type,
                                  BCRYPT_KEY_HANDLE *ret_handle, UCHAR *object, ULONG object_len, UCHAR *input,
                                  ULONG input_len, ULONG flags )
@@ -2038,6 +2121,22 @@ NTSTATUS WINAPI BCryptImportKey( BCRYPT_ALG_HANDLE handle, BCRYPT_KEY_HANDLE dec
 
     if (!alg) return STATUS_INVALID_HANDLE;
     if (!ret_handle || !type || !input) return STATUS_INVALID_PARAMETER;
+    if (!wcscmp( type, BCRYPT_AES_WRAP_KEY_BLOB ))
+    {
+        struct key *wrap_key = get_key_object( decrypt_key );
+        UCHAR *plain;
+
+        if (!wrap_key) return STATUS_INVALID_HANDLE;
+        if (input_len < 24 || input_len % 8) return STATUS_INVALID_PARAMETER;
+        if (!(plain = malloc( input_len - 8 ))) return STATUS_NO_MEMORY;
+        if (!(status = aes_unwrap( wrap_key, input, input_len, plain )))
+            status = generate_symmetric_key( alg, ret_handle, plain, input_len - 8 );
+        SecureZeroMemory( plain, input_len - 8 );
+        free( plain );
+        if (status) return status;
+        TRACE( "returning handle %p\n", *ret_handle );
+        return STATUS_SUCCESS;
+    }
     if (decrypt_key)
     {
         FIXME( "decryption of key not yet supported\n" );
@@ -2059,6 +2158,21 @@ NTSTATUS WINAPI BCryptExportKey( BCRYPT_KEY_HANDLE export_key_handle, BCRYPT_KEY
 
     if (!key) return STATUS_INVALID_HANDLE;
     if (!type || !size) return STATUS_INVALID_PARAMETER;
+#ifndef SG_MUTANT_AES_WRAP_NOTIMPL
+    if (!wcscmp( type, BCRYPT_AES_WRAP_KEY_BLOB ))
+    {
+        struct key *wrap_key = get_key_object( encrypt_key_handle );
+        ULONG len;
+
+        if (!wrap_key) return STATUS_INVALID_HANDLE;
+        /* "the key being exported must be a multiple of 8 bytes long" */
+        if (!is_symmetric_key( key ) || (len = key->u.s.secret_len) % 8 || len < 16) return STATUS_INVALID_PARAMETER;
+        *size = len + 8;
+        if (!output) return STATUS_SUCCESS;
+        if (output_len < len + 8) return STATUS_BUFFER_TOO_SMALL;
+        return aes_wrap( wrap_key, key->u.s.secret, len, output );
+    }
+#endif
     if (encrypt_key_handle)
     {
         FIXME( "encryption of key not yet supported\n" );
