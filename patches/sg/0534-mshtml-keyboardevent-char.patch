--- a/dlls/mshtml/htmlevent.c
+++ b/dlls/mshtml/htmlevent.c
@@ -2946,11 +2946,31 @@
     return S_OK;
 }
 
+/* IE's legacy "char": the character the key types, or an empty string for
+ * a key that types none (the "key" value of those is a name, like "Enter"). */
 static HRESULT WINAPI DOMKeyboardEvent_get_char(IDOMKeyboardEvent *iface, VARIANT *p)
 {
     DOMKeyboardEvent *This = impl_from_IDOMKeyboardEvent(iface);
-    FIXME("(%p)->(%p)\n", This, p);
-    return E_NOTIMPL;
+    BSTR key;
+    HRESULT hres;
+    UINT len;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    hres = DOMKeyboardEvent_get_key(iface, &key);
+    if(FAILED(hres))
+        return hres;
+
+    len = key ? SysStringLen(key) : 0;
+    if(len != 1 && !(len == 2 && IS_HIGH_SURROGATE(key[0]) && IS_LOW_SURROGATE(key[1]))) {
+        SysFreeString(key);
+        if(!(key = SysAllocString(L"")))
+            return E_OUTOFMEMORY;
+    }
+
+    V_VT(p) = VT_BSTR;
+    V_BSTR(p) = key;
+    return S_OK;
 }
 
