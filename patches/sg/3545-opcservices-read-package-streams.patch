+HRESULT opc_package_read(IOpcFactory *factory, IStream *stream, OPC_READ_FLAGS flags, IOpcPackage **out)
+{
+    struct read_types types = { 0 };
+    struct zip_entry *entries = NULL;
+    IOpcPartSet *part_set = NULL;
+    IOpcPackage *package = NULL;
+    size_t count = 0, i;
+    HRESULT hr;
+
+    *out = NULL;
+
+    if (FAILED(hr = compress_read_archive(stream, &entries, &count)))
+        return hr;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (!wcsicmp(entries[i].name, L"[Content_Types].xml"))
+        {
+            if (FAILED(hr = opc_read_content_types(entries[i].data, entries[i].size, &types)))
+                goto done;
+            break;
+        }
+    }
+    if (i == count)
+    {
+        hr = E_FAIL;
+        goto done;
+    }
+
+    if (FAILED(hr = IOpcFactory_CreatePackage(factory, &package)) ||
+            FAILED(hr = IOpcPackage_GetPartSet(package, &part_set)))
+        goto done;
+
+    /* Parts first, relationships refer to them. */
+    for (i = 0; i < count; ++i)
+    {
+        WCHAR *name = entries[i].name, *part_name, rels_target[1024];
+        const WCHAR *type;
+        IOpcPartUri *uri;
+        IOpcPart *part;
+        IStream *content;
+        ULONG written;
+        size_t len = wcslen(name);
+
+        if (!len || name[len - 1] == '/' || !wcsicmp(name, L"[Content_Types].xml") || opc_read_is_rels_name(name, rels_target, ARRAY_SIZE(rels_target)))
+            continue;
+
+        if (!(part_name = malloc((len + 2) * sizeof(WCHAR))))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+        part_name[0] = '/';
+        wcscpy(part_name + 1, name);
+        type = opc_read_lookup_type(&types, part_name);
+        if (!type)
+        {
+            free(part_name);
+            hr = E_FAIL;
+            goto done;
+        }
+        hr = IOpcFactory_CreatePartUri(factory, part_name, &uri);
+        free(part_name);
+        if (FAILED(hr))
+            goto done;
+
+        hr = IOpcPartSet_CreatePart(part_set, uri, type, entries[i].method ? OPC_COMPRESSION_NORMAL : OPC_COMPRESSION_NONE, &part);
+        IOpcPartUri_Release(uri);
+        if (FAILED(hr))
+            goto done;
+        if (SUCCEEDED(hr = IOpcPart_GetContentStream(part, &content)))
+        {
+            hr = IStream_Write(content, entries[i].data, entries[i].size, &written);
+            IStream_Release(content);
+        }
+        IOpcPart_Release(part);
+        if (FAILED(hr))
+            goto done;
+    }
+
+    for (i = 0; i < count; ++i)
+    {
+        WCHAR part_name[1024];
+        IOpcRelationshipSet *rels = NULL;
+
+        if (!opc_read_is_rels_name(entries[i].name, part_name, ARRAY_SIZE(part_name)))
+            continue;
+
+        if (!wcscmp(entries[i].name, L"_rels/.rels"))
+            hr = IOpcPackage_GetRelationshipSet(package, &rels);
+        else
+        {
+            IOpcPartUri *uri;
+            IOpcPart *part;
+
+            if (FAILED(hr = IOpcFactory_CreatePartUri(factory, part_name, &uri)))
+                continue; /* not a usable part name */
+            hr = IOpcPartSet_GetPart(part_set, uri, &part);
+            IOpcPartUri_Release(uri);
+            if (hr == OPC_E_NO_SUCH_PART)
+            {
+                hr = S_OK;
+                continue;
+            }
+            if (SUCCEEDED(hr))
+            {
+                hr = IOpcPart_GetRelationshipSet(part, &rels);
+                IOpcPart_Release(part);
+            }
+        }
+        if (SUCCEEDED(hr))
+        {
+            hr = opc_read_relationships(entries[i].data, entries[i].size, rels);
+            IOpcRelationshipSet_Release(rels);
+        }
+        if (FAILED(hr))
+            goto done;
+    }
+
+    hr = S_OK;
+    *out = package;
+    package = NULL;
+
+done:
+    if (FAILED(hr))
+        WARN("Failed to read package, hr %#lx, entry %Iu of %Iu.\n", hr, i, count);
+    if (part_set)
+        IOpcPartSet_Release(part_set);
+    if (package)
+        IOpcPackage_Release(package);
+    compress_free_entries(entries, count);
+    read_types_free(&types);
+    return hr;
+}
