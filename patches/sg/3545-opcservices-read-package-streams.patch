--- a/dlls/opcservices/compress.c
+++ b/dlls/opcservices/compress.c
@@ -346,3 +346,208 @@
 
     return S_OK;
 }
+
+/* Reading */
+
+static HRESULT compress_read_all(IStream *stream, BYTE **data, DWORD *size)
+{
+    LARGE_INTEGER zero = { 0 };
+    ULARGE_INTEGER end;
+    ULONG read;
+    HRESULT hr;
+
+    *data = NULL;
+    *size = 0;
+
+    if (FAILED(hr = IStream_Seek(stream, zero, STREAM_SEEK_END, &end)))
+        return hr;
+    if (end.QuadPart > 0x7fffffff)
+        return E_FAIL;
+    if (FAILED(hr = IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL)))
+        return hr;
+    if (!(*data = malloc(max(end.QuadPart, 1))))
+        return E_OUTOFMEMORY;
+
+    *size = 0;
+    while (*size < end.QuadPart)
+    {
+        if (FAILED(hr = IStream_Read(stream, *data + *size, end.QuadPart - *size, &read)) || !read)
+            break;
+        *size += read;
+    }
+    if (FAILED(hr) || *size != end.QuadPart)
+    {
+        free(*data);
+        *data = NULL;
+        return FAILED(hr) ? hr : E_FAIL;
+    }
+    return S_OK;
+}
+
+void compress_free_entries(struct zip_entry *entries, size_t count)
+{
+    size_t i;
+
+    for (i = 0; i < count; ++i)
+    {
+        free(entries[i].name);
+        free(entries[i].data);
+    }
+    free(entries);
+}
+
+/* Reads a whole zip archive, stored and deflated entries, without zip64 and encryption. */
+HRESULT compress_read_archive(IStream *stream, struct zip_entry **ret, size_t *ret_count)
+{
+    const struct central_directory_end *end = NULL;
+    struct zip_entry *entries = NULL;
+    DWORD size, pos, i;
+    BYTE *file = NULL;
+    HRESULT hr;
+
+    *ret = NULL;
+    *ret_count = 0;
+
+    if (FAILED(hr = compress_read_all(stream, &file, &size)))
+        return hr;
+
+    if (size >= sizeof(*end))
+    {
+        for (pos = size - sizeof(*end); ; --pos)
+        {
+            const struct central_directory_end *e = (const struct central_directory_end *)(file + pos);
+
+            if (e->signature == DIRECTORY_END_SIGNATURE && pos + sizeof(*e) + e->comment_length <= size)
+            {
+                end = e;
+                break;
+            }
+            if (!pos || size - pos > 0x10000 + sizeof(*e)) break;
+        }
+    }
+    if (!end || end->diskid || end->firstdisk || end->records_num != end->records_total ||
+            end->directory_offset > size || end->directory_size > size - end->directory_offset ||
+            end->records_num == 0xffff || end->directory_offset == 0xffffffff)
+    {
+        WARN("No usable central directory.\n");
+        free(file);
+        return E_FAIL;
+    }
+
+    if (!(entries = calloc(max(end->records_num, 1), sizeof(*entries))))
+    {
+        free(file);
+        return E_OUTOFMEMORY;
+    }
+
+    pos = end->directory_offset;
+    for (i = 0; i < end->records_num; ++i)
+    {
+        const struct central_directory_header *h = (const struct central_directory_header *)(file + pos);
+        const struct local_file_header *local;
+        DWORD name_pos, data_pos, comp, uncomp;
+
+        if (end->directory_offset + end->directory_size - pos < sizeof(*h) || h->signature != CENTRAL_DIR_SIGNATURE ||
+                (DWORD)h->name_length + h->extra_length + h->comment_length > end->directory_offset + end->directory_size - pos - sizeof(*h))
+        {
+            hr = E_FAIL;
+            goto failed;
+        }
+        name_pos = pos + sizeof(*h);
+        pos = name_pos + h->name_length + h->extra_length + h->comment_length;
+
+        comp = h->compressed_size;
+        uncomp = h->uncompressed_size;
+        if ((h->flags & 1) || comp == 0xffffffff || uncomp == 0xffffffff || h->local_file_offset > size ||
+                size - h->local_file_offset < sizeof(*local))
+        {
+            hr = E_FAIL;
+            goto failed;
+        }
+        local = (const struct local_file_header *)(file + h->local_file_offset);
+        data_pos = h->local_file_offset + sizeof(*local) + local->name_length + local->extra_length;
+        if (local->signature != LOCAL_HEADER_SIGNATURE || data_pos > size || comp > size - data_pos)
+        {
+            hr = E_FAIL;
+            goto failed;
+        }
+
+        {
+            int len = MultiByteToWideChar(CP_UTF8, 0, (const char *)file + name_pos, h->name_length, NULL, 0);
+
+            if (!(entries[i].name = malloc((len + 1) * sizeof(WCHAR))))
+            {
+                hr = E_OUTOFMEMORY;
+                goto failed;
+            }
+            MultiByteToWideChar(CP_UTF8, 0, (const char *)file + name_pos, h->name_length, entries[i].name, len);
+            entries[i].name[len] = 0;
+        }
+
+        entries[i].size = uncomp;
+        entries[i].method = h->method;
+        if (!(entries[i].data = malloc(max(uncomp, 1))))
+        {
+            hr = E_OUTOFMEMORY;
+            goto failed;
+        }
+
+        if (h->method == 0)
+        {
+            if (comp != uncomp)
+            {
+                hr = E_FAIL;
+                goto failed;
+            }
+            memcpy(entries[i].data, file + data_pos, comp);
+        }
+        else if (h->method == 8)
+        {
+            z_stream z;
+            int ret_z;
+
+            memset(&z, 0, sizeof(z));
+            z.zalloc = zalloc;
+            z.zfree = zfree;
+            if ((ret_z = inflateInit2(&z, -MAX_WBITS)) != Z_OK)
+            {
+                hr = E_FAIL;
+                goto failed;
+            }
+            z.next_in = file + data_pos;
+            z.avail_in = comp;
+            z.next_out = entries[i].data;
+            z.avail_out = uncomp;
+            ret_z = inflate(&z, Z_FINISH);
+            inflateEnd(&z);
+            if ((ret_z != Z_STREAM_END && !(ret_z == Z_OK && !uncomp)) || z.total_out != uncomp)
+            {
+                hr = E_FAIL;
+                goto failed;
+            }
+        }
+        else
+        {
+            hr = E_FAIL;
+            goto failed;
+        }
+
+        if (uncomp && crc32(0, entries[i].data, uncomp) != h->crc32)
+        {
+            hr = E_FAIL;
+            goto failed;
+        }
+        ++*ret_count;
+    }
+
+    free(file);
+    *ret = entries;
+    return S_OK;
+
+failed:
+    WARN("Failed to read archive entry %lu, hr %#lx.\n", i, hr);
+    compress_free_entries(entries, end->records_num);
+    free(file);
+    *ret_count = 0;
+    return hr;
+}
