+HRESULT opc_stream_copy(IStream *src, IStream *dest, ULARGE_INTEGER size, ULARGE_INTEGER *num_read,
+        ULARGE_INTEGER *written)
+{
+    ULARGE_INTEGER total_read = { 0 }, total_written = { 0 };
+    BYTE buffer[4096];
+    HRESULT hr = S_OK;
+
+    while (total_read.QuadPart < size.QuadPart)
+    {
+        ULONG chunk = (ULONG)min(sizeof(buffer), size.QuadPart - total_read.QuadPart), read = 0, out = 0;
+
+        if (FAILED(hr = IStream_Read(src, buffer, chunk, &read)) || !read)
+            break;
+        total_read.QuadPart += read;
+        if (FAILED(hr = IStream_Write(dest, buffer, read, &out)))
+            break;
+        total_written.QuadPart += out;
+        if (out != read)
+            break;
+    }
+
+    if (num_read) *num_read = total_read;
+    if (written) *written = total_written;
+    return hr;
 }
 
