+/* Absolute path with '.' and '..' segments resolved; '..' never goes above the root. */
+static WCHAR *opc_normalize_path(const WCHAR *path)
+{
+    WCHAR *ret, *out;
+    const WCHAR *seg = path;
+
+    if (!(ret = malloc((wcslen(path) + 2) * sizeof(*ret))))
+        return NULL;
+    out = ret;
+    *out = 0;
+
+    while (*seg)
+    {
+        const WCHAR *end = seg;
+        size_t len;
+
+        while (*end && *end != '/')
+            ++end;
+        len = end - seg;
+
+        if (!len || (len == 1 && seg[0] == '.'))
+            ;
+        else if (len == 2 && seg[0] == '.' && seg[1] == '.')
+        {
+            while (out > ret && out[-1] != '/')
+                --out;
+            if (out > ret)
+                --out; /* drop the separator before the removed segment */
+            *out = 0;
+        }
+        else
+        {
+            *out++ = '/';
+            memcpy(out, seg, len * sizeof(*out));
+            out += len;
+            *out = 0;
+        }
+        seg = *end ? end + 1 : end;
+    }
+
+    if (!*ret)
+        wcscpy(ret, L"/");
+    return ret;
+}
