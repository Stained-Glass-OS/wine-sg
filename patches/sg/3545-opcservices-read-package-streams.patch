+/* Reading packages */
+
+struct read_content_type
+{
+    WCHAR *key;     /* extension or part name */
+    WCHAR *type;
+    BOOL override;
+};
+
+struct read_types
+{
+    struct read_content_type *items;
+    size_t size, count;
+};
+
+static void read_types_free(struct read_types *types)
+{
+    size_t i;
+
+    for (i = 0; i < types->count; ++i)
+    {
+        free(types->items[i].key);
+        free(types->items[i].type);
+    }
+    free(types->items);
+}
+
+static HRESULT opc_read_create_xml_reader(const BYTE *data, DWORD size, IXmlReader **reader)
+{
+    IStream *stream;
+    ULONG written;
+    HRESULT hr;
+
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &stream)))
+        return hr;
+    hr = IStream_Write(stream, data, size, &written);
+    if (SUCCEEDED(hr))
+    {
+        LARGE_INTEGER zero = { 0 };
+        hr = IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+    }
+    if (SUCCEEDED(hr))
+        hr = CreateXmlReader(&IID_IXmlReader, (void **)reader, NULL);
+    if (SUCCEEDED(hr))
+    {
+        hr = IXmlReader_SetInput(*reader, (IUnknown *)stream);
+        if (FAILED(hr))
+            IXmlReader_Release(*reader);
+    }
+    IStream_Release(stream);
+    return hr;
+}
+
+static WCHAR *opc_read_attribute(IXmlReader *reader, const WCHAR *name)
+{
+    const WCHAR *value;
+    WCHAR *ret = NULL;
+
+    if (IXmlReader_MoveToAttributeByName(reader, name, NULL) == S_OK)
+    {
+        if (SUCCEEDED(IXmlReader_GetValue(reader, &value, NULL)))
+            ret = wcsdup(value);
+        IXmlReader_MoveToElement(reader);
+    }
+    return ret;
+}
+
+static HRESULT opc_read_content_types(const BYTE *data, DWORD size, struct read_types *types)
+{
+    XmlNodeType node_type;
+    IXmlReader *reader;
+    HRESULT hr;
+
+    if (FAILED(hr = opc_read_create_xml_reader(data, size, &reader)))
+        return hr;
+
+    while ((hr = IXmlReader_Read(reader, &node_type)) == S_OK)
+    {
+        const WCHAR *name;
+        BOOL override;
+        WCHAR *key, *type;
+
+        if (node_type != XmlNodeType_Element)
+            continue;
+
+        IXmlReader_GetLocalName(reader, &name, NULL);
+        if (!wcscmp(name, L"Default")) override = FALSE;
+        else if (!wcscmp(name, L"Override")) override = TRUE;
+        else continue;
+
+        key = opc_read_attribute(reader, override ? L"PartName" : L"Extension");
+        type = opc_read_attribute(reader, L"ContentType");
+        if (!key || !type || !opc_array_reserve((void **)&types->items, &types->size, types->count + 1, sizeof(*types->items)))
+        {
+            free(key);
+            free(type);
+            hr = E_FAIL;
+            break;
+        }
+        types->items[types->count].key = key;
+        types->items[types->count].type = type;
+        types->items[types->count].override = override;
+        types->count++;
+    }
+
+    IXmlReader_Release(reader);
+    return hr == S_FALSE ? S_OK : hr;
+}
+
+static const WCHAR *opc_read_lookup_type(const struct read_types *types, const WCHAR *name)
+{
+    const WCHAR *ext = wcsrchr(name, '.');
+    size_t i;
+
+    for (i = 0; i < types->count; ++i)
+    {
+        if (types->items[i].override && !wcsicmp(types->items[i].key, name))
+            return types->items[i].type;
+    }
+    if (ext)
+    {
+        for (i = 0; i < types->count; ++i)
+        {
+            if (!types->items[i].override && !wcsicmp(types->items[i].key, ext + 1))
+                return types->items[i].type;
+        }
+    }
+    return NULL;
+}
+
+static HRESULT opc_read_relationships(const BYTE *data, DWORD size, IOpcRelationshipSet *set)
+{
+    XmlNodeType node_type;
+    IXmlReader *reader;
+    HRESULT hr;
+
+    if (FAILED(hr = opc_read_create_xml_reader(data, size, &reader)))
+        return hr;
+
+    while ((hr = IXmlReader_Read(reader, &node_type)) == S_OK)
+    {
+        WCHAR *id, *type, *target, *mode;
+        IOpcRelationship *rel;
+        const WCHAR *name;
+        IUri *uri;
+
+        if (node_type != XmlNodeType_Element)
+            continue;
+        IXmlReader_GetLocalName(reader, &name, NULL);
+        if (wcscmp(name, L"Relationship"))
+            continue;
+
+        id = opc_read_attribute(reader, L"Id");
+        type = opc_read_attribute(reader, L"Type");
+        target = opc_read_attribute(reader, L"Target");
+        mode = opc_read_attribute(reader, L"TargetMode");
+
+        if (!type || !target)
+            hr = E_FAIL;
+        else if (SUCCEEDED(hr = CreateUri(target, Uri_CREATE_ALLOW_RELATIVE, 0, &uri)))
+        {
+            hr = IOpcRelationshipSet_CreateRelationship(set, id, type, uri,
+                    mode && !wcsicmp(mode, L"External") ? OPC_URI_TARGET_MODE_EXTERNAL : OPC_URI_TARGET_MODE_INTERNAL, &rel);
+            if (SUCCEEDED(hr))
+                IOpcRelationship_Release(rel);
+            IUri_Release(uri);
+        }
+        free(id);
+        free(type);
+        free(target);
+        free(mode);
+        if (FAILED(hr))
+            break;
+    }
+
+    IXmlReader_Release(reader);
+    return hr == S_FALSE ? S_OK : hr;
+}
+
+static BOOL opc_read_is_rels_name(const WCHAR *name, WCHAR *part_name, size_t size)
+{
+    /* "dir/_rels/file.ext.rels" belongs to "/dir/file.ext", "_rels/.rels" to the package. */
+    size_t len = wcslen(name), prefix, dirlen, filelen;
+    const WCHAR *file;
+
+    if (len < 6 || len + 2 > size || wcsicmp(name + len - 5, L".rels"))
+        return FALSE;
+
+    file = wcsrchr(name, '/');
+    file = file ? file + 1 : name;
+    prefix = file - name;
+    if (prefix < 6 || wcsnicmp(file - 6, L"_rels/", 6))
+        return FALSE;
+    if (prefix > 6 && file[-7] != '/')
+        return FALSE;
+
+    dirlen = prefix - 6;
+    filelen = wcslen(file) - 5;
+    part_name[0] = '/';
+    memcpy(part_name + 1, name, dirlen * sizeof(WCHAR));
+    memcpy(part_name + 1 + dirlen, file, filelen * sizeof(WCHAR));
+    part_name[1 + dirlen + filelen] = 0;
+    return TRUE;
+}
