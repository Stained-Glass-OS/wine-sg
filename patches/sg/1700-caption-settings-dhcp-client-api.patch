 WINE_DEFAULT_DEBUG_CHANNEL(dhcpcsvc);
 
+/* Stained Glass OS: the API is used between DhcpCApiInitialize and
+ * DhcpCApiCleanup, which count; parameter change registrations are events
+ * signalled when the adapter's (or any adapter's) addresses or interface
+ * change, from IP Helper's change notifications. */
+struct param_change
+{
+    struct list entry;
+    HANDLE event;
+    NET_LUID luid;
+    BOOL any;
+    HANDLE iface_notify;
+    HANDLE addr_notify;
+};
+
+static CRITICAL_SECTION dhcp_cs;
+static CRITICAL_SECTION_DEBUG dhcp_cs_debug =
+{
+    0, 0, &dhcp_cs,
+    { &dhcp_cs_debug.ProcessLocksList, &dhcp_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": dhcp_cs") }
+};
+static CRITICAL_SECTION dhcp_cs = { &dhcp_cs_debug, -1, 0, 0, 0, 0 };
+static struct list param_changes = LIST_INIT( param_changes );
+static LONG init_count;
+
 void WINAPI DhcpCApiCleanup(void)
 {
-    FIXME(": stub\n");
+    TRACE( "\n" );
+    if (InterlockedDecrement( &init_count ) < 0) InterlockedIncrement( &init_count );
 }
 
 DWORD WINAPI DhcpCApiInitialize(LPDWORD version)
 {
+    TRACE( "%p\n", version );
+    if (!version) return ERROR_INVALID_PARAMETER;
     *version = 2; /* 98, XP, and 8 */
-    FIXME(": stub\n");
+    InterlockedIncrement( &init_count );
     return ERROR_SUCCESS;
 }
 
@@ -149,3 +178,80 @@ done:
     CloseHandle( mgr );
     return err;
 }
+
+static void CALLBACK param_iface_changed( void *context, MIB_IPINTERFACE_ROW *row, MIB_NOTIFICATION_TYPE type )
+{
+    struct param_change *change = context;
+
+    if (change->any || (row && row->InterfaceLuid.Value == change->luid.Value)) SetEvent( change->event );
+}
+
+static void CALLBACK param_addr_changed( void *context, MIB_UNICASTIPADDRESS_ROW *row, MIB_NOTIFICATION_TYPE type )
+{
+    struct param_change *change = context;
+
+    if (change->any || (row && row->InterfaceLuid.Value == change->luid.Value)) SetEvent( change->event );
+}
+
+DWORD WINAPI DhcpRegisterParamChange( DWORD flags, void *reserved, WCHAR *adapter, DHCPCAPI_CLASSID *class_id,
+                                      DHCPCAPI_PARAMS_ARRAY params, void *handle )
+{
+    struct param_change *change;
+    DWORD err;
+
+    TRACE( "(%08lx, %p, %s, %p, %lu, %p)\n", flags, reserved, debugstr_w(adapter), class_id, params.nParams, handle );
+
+    if (flags != DHCPCAPI_REGISTER_HANDLE_EVENT || !handle) return ERROR_INVALID_PARAMETER;
+    if (!(change = calloc( 1, sizeof(*change) ))) return ERROR_OUTOFMEMORY;
+    if (!adapter) change->any = TRUE;
+    else if ((err = get_adapter_luid( adapter, &change->luid )))
+    {
+        free( change );
+        return err;
+    }
+    if (!(change->event = CreateEventW( NULL, FALSE, FALSE, NULL )))
+    {
+        free( change );
+        return GetLastError();
+    }
+#ifndef SG_MUTANT_NO_PARAM_CHANGE
+    if ((err = NotifyIpInterfaceChange( AF_UNSPEC, param_iface_changed, change, FALSE, &change->iface_notify ))
+            || (err = NotifyUnicastIpAddressChange( AF_UNSPEC, param_addr_changed, change, FALSE, &change->addr_notify )))
+    {
+        if (change->iface_notify) CancelMibChangeNotify2( change->iface_notify );
+        CloseHandle( change->event );
+        free( change );
+        return err;
+    }
+#endif
+    EnterCriticalSection( &dhcp_cs );
+    list_add_tail( &param_changes, &change->entry );
+    LeaveCriticalSection( &dhcp_cs );
+    *(HANDLE *)handle = change->event;
+    return ERROR_SUCCESS;
+}
+
+DWORD WINAPI DhcpDeRegisterParamChange( DWORD flags, void *reserved, void *event )
+{
+    struct param_change *change, *found = NULL;
+
+    TRACE( "(%08lx, %p, %p)\n", flags, reserved, event );
+
+    if (flags != DHCPCAPI_REGISTER_HANDLE_EVENT) return ERROR_INVALID_PARAMETER;
+    EnterCriticalSection( &dhcp_cs );
+    LIST_FOR_EACH_ENTRY( change, &param_changes, struct param_change, entry )
+    {
+        if (change->event != event) continue;
+        list_remove( &change->entry );
+        found = change;
+        break;
+    }
+    LeaveCriticalSection( &dhcp_cs );
+    if (!found) return ERROR_INVALID_PARAMETER;
+    /* cancelling waits for callbacks in progress */
+    if (found->iface_notify) CancelMibChangeNotify2( found->iface_notify );
+    if (found->addr_notify) CancelMibChangeNotify2( found->addr_notify );
+    CloseHandle( found->event );
+    free( found );
+    return ERROR_SUCCESS;
+}
