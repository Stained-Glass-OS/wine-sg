+static DWORD caption_setting( const WCHAR *name, DWORD max )
 {
-    FIXME( "iface %p, value %p semi-stub.\n", iface, value );
+    DWORD value, size = sizeof(value);
+
+#ifdef SG_MUTANT_CAPTIONS_DEFAULT
