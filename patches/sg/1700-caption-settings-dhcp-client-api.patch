+    return value;
+}
+
+/* A computed colour is the colour the user chose; with none chosen (or no
+ * pointer) there is none, as Windows answers: E_INVALIDARG. */
+static HRESULT caption_color( ClosedCaptionColor color, Color *value )
+{
+    static const Color colors[] =
+    {
+        { 255, 255, 255, 255 }, /* default: not used */
+        { 255, 255, 255, 255 }, /* white */
+        { 255,   0,   0,   0 }, /* black */
+        { 255, 255,   0,   0 }, /* red */
+        { 255,   0, 255,   0 }, /* green */
+        { 255,   0,   0, 255 }, /* blue */
+        { 255, 255, 255,   0 }, /* yellow */
+        { 255, 255,   0, 255 }, /* magenta */
+        { 255,   0, 255, 255 }, /* cyan */
+    };
+
+    if (!value || color == ClosedCaptionColor_Default) return E_INVALIDARG;
+    *value = colors[color];
+    return S_OK;
+}
 
