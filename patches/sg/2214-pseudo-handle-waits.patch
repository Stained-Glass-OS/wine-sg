From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, kernelbase: pseudo handles in waits on several objects

Windows refuses the pseudo handles of the current process and thread in a
wait on several objects (NtWaitForMultipleObjects: STATUS_INVALID_HANDLE,
WaitForMultipleObjects: ERROR_INVALID_HANDLE) but allows them in a wait on
one.  NtWaitForSingleObject no longer goes through the multiple-object entry
point, and kernelbase's WaitForSingleObject/Ex call it directly.  The todo_wine
marks in kernel32's sync.c test are removed.

---
--- a/dlls/kernel32/tests/sync.c
+++ b/dlls/kernel32/tests/sync.c
@@ -1369,26 +1369,26 @@ static void test_WaitForMultipleObjects(void)
     maxevents[0] = GetCurrentProcess();
     SetLastError(0xdeadbeef);
     r = WaitForMultipleObjects(1, maxevents, FALSE, 100);
-    todo_wine ok(r == WAIT_FAILED, "expected WAIT_FAILED, got %lu\n", r);
-    todo_wine ok(GetLastError() == ERROR_INVALID_HANDLE,
+    ok(r == WAIT_FAILED, "expected WAIT_FAILED, got %lu\n", r);
+    ok(GetLastError() == ERROR_INVALID_HANDLE,
                  "expected ERROR_INVALID_HANDLE, got %lu\n", GetLastError());
 
     maxevents[0] = GetCurrentThread();
     SetLastError(0xdeadbeef);
     r = WaitForMultipleObjects(1, maxevents, FALSE, 100);
-    todo_wine ok(r == WAIT_FAILED, "expected WAIT_FAILED, got %lu\n", r);
-    todo_wine ok(GetLastError() == ERROR_INVALID_HANDLE,
+    ok(r == WAIT_FAILED, "expected WAIT_FAILED, got %lu\n", r);
+    ok(GetLastError() == ERROR_INVALID_HANDLE,
                  "expected ERROR_INVALID_HANDLE, got %lu\n", GetLastError());
 
     timeout.QuadPart = -1000000;
     maxevents[0] = GetCurrentProcess();
     status = pNtWaitForMultipleObjects(1, maxevents, TRUE, FALSE, &timeout);
-    todo_wine ok(status == STATUS_INVALID_HANDLE, "expected STATUS_INVALID_HANDLE, got %08lx\n", status);
+    ok(status == STATUS_INVALID_HANDLE, "expected STATUS_INVALID_HANDLE, got %08lx\n", status);
 
     timeout.QuadPart = -1000000;
     maxevents[0] = GetCurrentThread();
     status = pNtWaitForMultipleObjects(1, maxevents, TRUE, FALSE, &timeout);
-    todo_wine ok(status == STATUS_INVALID_HANDLE, "expected STATUS_INVALID_HANDLE, got %08lx\n", status);
+    ok(status == STATUS_INVALID_HANDLE, "expected STATUS_INVALID_HANDLE, got %08lx\n", status);
 }
 
 static BOOL g_initcallback_ret, g_initcallback_called;
--- a/dlls/kernelbase/sync.c
+++ b/dlls/kernelbase/sync.c
@@ -366,7 +366,7 @@ BOOL WINAPI DECLSPEC_HOTPATCH UnregisterWaitEx( HANDLE handle, HANDLE event )
  */
 DWORD WINAPI DECLSPEC_HOTPATCH WaitForSingleObject( HANDLE handle, DWORD timeout )
 {
-    return WaitForMultipleObjectsEx( 1, &handle, FALSE, timeout, FALSE );
+    return WaitForSingleObjectEx( handle, timeout, FALSE );
 }
 
 
@@ -375,7 +375,23 @@ DWORD WINAPI DECLSPEC_HOTPATCH WaitForSingleObject( HANDLE handle, DWORD timeout
  */
 DWORD WINAPI DECLSPEC_HOTPATCH WaitForSingleObjectEx( HANDLE handle, DWORD timeout, BOOL alertable )
 {
-    return WaitForMultipleObjectsEx( 1, &handle, FALSE, timeout, alertable );
+    NTSTATUS status;
+    LARGE_INTEGER time;
+
+    /* the pseudo handles of the current process and thread are fine here, unlike
+     * in a wait on several objects */
+#ifdef SG_MUTANT_SINGLE_VIA_MULTI
+    HANDLE h = normalize_std_handle( handle );
+    status = NtWaitForMultipleObjects( 1, &h, FALSE, alertable, get_nt_timeout( &time, timeout ) );
+#else
+    status = NtWaitForSingleObject( normalize_std_handle( handle ), alertable, get_nt_timeout( &time, timeout ) );
+#endif
+    if (HIWORD(status))  /* is it an error code? */
+    {
+        SetLastError( RtlNtStatusToDosError(status) );
+        status = WAIT_FAILED;
+    }
+    return status;
 }
 
 
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -1678,11 +1678,9 @@ NTSTATUS WINAPI NtQueryTimer( HANDLE handle, TIMER_INFORMATION_CLASS class,
 }
 
 
-/******************************************************************
- *		NtWaitForMultipleObjects (NTDLL.@)
- */
-NTSTATUS WINAPI NtWaitForMultipleObjects( DWORD count, const HANDLE *handles, BOOLEAN wait_any,
-                                          BOOLEAN alertable, const LARGE_INTEGER *timeout )
+/* wait for one or several objects, pseudo handles included */
+static NTSTATUS wait_objects( DWORD count, const HANDLE *handles, BOOLEAN wait_any,
+                              BOOLEAN alertable, const LARGE_INTEGER *timeout )
 {
     union select_op select_op;
     UINT i, flags = SELECT_INTERRUPTIBLE;
@@ -1696,12 +1694,31 @@ NTSTATUS WINAPI NtWaitForMultipleObjects( DWORD count, const HANDLE *handles, BO
 }
 
 
+/******************************************************************
+ *		NtWaitForMultipleObjects (NTDLL.@)
+ */
+NTSTATUS WINAPI NtWaitForMultipleObjects( DWORD count, const HANDLE *handles, BOOLEAN wait_any,
+                                          BOOLEAN alertable, const LARGE_INTEGER *timeout )
+{
+    UINT i;
+
+    /* unlike a wait on a single object, a wait on several refuses the pseudo handles
+     * of the current process and thread */
+#ifndef SG_MUTANT_PSEUDO_WAIT_OK
+    if (count && count <= MAXIMUM_WAIT_OBJECTS)
+        for (i = 0; i < count; i++)
+            if (handles[i] == GetCurrentProcess() || handles[i] == GetCurrentThread()) return STATUS_INVALID_HANDLE;
+#endif
+    return wait_objects( count, handles, wait_any, alertable, timeout );
+}
+
+
 /******************************************************************
  *		NtWaitForSingleObject (NTDLL.@)
  */
 NTSTATUS WINAPI NtWaitForSingleObject( HANDLE handle, BOOLEAN alertable, const LARGE_INTEGER *timeout )
 {
-    return NtWaitForMultipleObjects( 1, &handle, FALSE, alertable, timeout );
+    return wait_objects( 1, &handle, FALSE, alertable, timeout );
 }
 
 
