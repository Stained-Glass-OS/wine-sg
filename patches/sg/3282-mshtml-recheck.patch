+    return NULL;
+}
+
+static void HTMLOpsProfile_destructor(DispatchEx *dispex)
+{
+    HTMLOpsProfile *This = HTMLOpsProfile_from_DispatchEx(dispex);
+    IHTMLWindow2_Release(&This->window->base.IHTMLWindow2_iface);
+    free(This);
+}
+
+static const dispex_static_data_vtbl_t HTMLOpsProfile_dispex_vtbl = {
+    .query_interface  = HTMLOpsProfile_query_interface,
+    .destructor       = HTMLOpsProfile_destructor,
+};
+
+static const tid_t OpsProfile_iface_tids[] = {
+    IHTMLOpsProfile_tid,
+    0
+};
+static dispex_static_data_t OpsProfile_dispex = {
+    .name       = "OpsProfile",
+    .vtbl       = &HTMLOpsProfile_dispex_vtbl,
+    .iface_tids = OpsProfile_iface_tids,
+};
+
+HRESULT create_ops_profile(HTMLInnerWindow *window, IHTMLOpsProfile **ret)
+{
+    HTMLOpsProfile *profile;
+
+    profile = calloc(1, sizeof(*profile));
+    if(!profile)
