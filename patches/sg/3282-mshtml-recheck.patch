+static HRESULT fire_pointer_capture_event(HTMLElement *This, eventid_t eid)
+{
+    DOMEvent *event;
+    HRESULT hres;
+
+#ifdef SG_MUTANT_RC_PTRCAP
+    return S_OK;
+#endif
+    if(!This->node.doc || !This->node.doc->dom_document)
+        return S_OK;
+    hres = create_document_event(This->node.doc, eid, &event);
+    if(FAILED(hres))
+        return hres;
+    dispatch_event(&This->node.event_target, event);
+    IDOMEvent_Release(&event->IDOMEvent_iface);
+    return S_OK;
+}
+
 static HRESULT WINAPI HTMLElement7_msSetPointerCapture(IHTMLElement7 *iface, LONG pointer_id)
 {
     HTMLElement *This = impl_from_IHTMLElement7(iface);
-    FIXME("(%p)->(%ld)\n", This, pointer_id);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%ld)\n", This, pointer_id);
+
+    /* the element gets the pointer's events until it is released or lost; the capture is announced, no event
+     * is sent when the element has the pointer already */
+    if(This->has_pointer_capture && This->captured_pointer == pointer_id)
+        return S_OK;
+    if(This->has_pointer_capture)
+        fire_pointer_capture_event(This, EVENTID_MSLOSTPOINTERCAPTURE);
+    This->has_pointer_capture = TRUE;
+    This->captured_pointer = pointer_id;
+    return fire_pointer_capture_event(This, EVENTID_MSGOTPOINTERCAPTURE);
 }
 
 static HRESULT WINAPI HTMLElement7_msReleasePointerCapture(IHTMLElement7 *iface, LONG pointer_id)
 {
     HTMLElement *This = impl_from_IHTMLElement7(iface);
-    FIXME("(%p)->(%ld)\n", This, pointer_id);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%ld)\n", This, pointer_id);
+
+    /* releasing a pointer the element does not capture does nothing */
+    if(!This->has_pointer_capture || This->captured_pointer != pointer_id)
+        return S_OK;
+    This->has_pointer_capture = FALSE;
+    return fire_pointer_capture_event(This, EVENTID_MSLOSTPOINTERCAPTURE);
 }
 
