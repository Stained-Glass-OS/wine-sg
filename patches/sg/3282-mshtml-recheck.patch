+/* PARSE_ABSOLUTIFYIE40URLS: the markup's relative URLs are combined with the base URL of the document that parsed it */
+#define PARSE_ABSOLUTIFYIE40URLS 0x00000001
+
+static void absolutify_markup_urls(HTMLDocumentNode *doc, IHTMLElement *root)
+{
+    static const WCHAR *url_attrs[] = { L"href", L"src", L"background", L"action", L"cite", L"codebase", L"data",
+                                        L"longdesc", L"lowsrc", L"dynsrc", L"usemap" };
+    IHTMLElementCollection *all = NULL;
+    IHTMLElement2 *root2;
+    BSTR base = NULL, tag;
+    LONG count, i;
+    VARIANT idx;
+
+    if(FAILED(IHTMLDocument2_get_URL(&doc->IHTMLDocument2_iface, &base)) || !base || !*base || !wcscmp(base, L"about:blank")) {
+        SysFreeString(base);
+        return;
+    }
+    if(FAILED(IHTMLElement_QueryInterface(root, &IID_IHTMLElement2, (void**)&root2))) {
+        SysFreeString(base);
+        return;
+    }
+    tag = SysAllocString(L"*");
+    IHTMLElement2_getElementsByTagName(root2, tag, &all);
+    SysFreeString(tag);
+    IHTMLElement2_Release(root2);
+    if(!all || FAILED(IHTMLElementCollection_get_length(all, &count)))
+        count = 0;
+
+    for(i = 0; i < count; i++) {
+        IDispatch *disp = NULL;
+        IHTMLElement *elem;
+        unsigned a;
+
+        V_VT(&idx) = VT_I4;
+        V_I4(&idx) = i;
+        if(FAILED(IHTMLElementCollection_item(all, idx, idx, &disp)) || !disp)
+            continue;
+        if(FAILED(IDispatch_QueryInterface(disp, &IID_IHTMLElement, (void**)&elem))) {
+            IDispatch_Release(disp);
+            continue;
+        }
+        IDispatch_Release(disp);
+
+        for(a = 0; a < ARRAY_SIZE(url_attrs); a++) {
+            WCHAR full[INTERNET_MAX_URL_LENGTH];
+            DWORD size = ARRAY_SIZE(full);
+            VARIANT v;
+            BSTR name = SysAllocString(url_attrs[a]);
+
+            V_VT(&v) = VT_EMPTY;
+            if(SUCCEEDED(IHTMLElement_getAttribute(elem, name, 2, &v)) && V_VT(&v) == VT_BSTR && V_BSTR(&v) && *V_BSTR(&v)
+               && V_BSTR(&v)[0] != '#'
+               && SUCCEEDED(CoInternetCombineUrl(base, V_BSTR(&v), URL_ESCAPE_SPACES_ONLY|URL_DONT_ESCAPE_EXTRA_INFO,
+                                                 full, size, &size, 0))
+               && wcscmp(full, V_BSTR(&v))) {
+                VariantClear(&v);
+                V_VT(&v) = VT_BSTR;
+                V_BSTR(&v) = SysAllocString(full);
+                IHTMLElement_setAttribute(elem, name, v, 0);
+            }
+            VariantClear(&v);
+            SysFreeString(name);
+        }
+        IHTMLElement_Release(elem);
+    }
+    if(all)
+        IHTMLElementCollection_Release(all);
+    SysFreeString(base);
+}
