From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 22:06:31 -0700
Subject: [PATCH] mshtml: member properties, pointer capture, range collection,
 XHR bodies, ParseString URLs, user profile, history position, script error
 (3282)

IDispatchEx::GetMemberProperties (builtin, expando and custom members, selected by the fetch mask), msSetPointerCapture/msReleasePointerCapture (got/lost events), selection.createRangeCollection (one TextRange), XMLHttpRequest.send with a SAFEARRAY of bytes, an XML DOM object, a document or a number, IMarkupServices::ParseString(PARSE_ABSOLUTIFYIE40URLS), navigator.userProfile/opsProfile (a Profile Assistant object that grants nothing), ITravelLogClient::LoadHistoryPosition (anchor, then vertical position), and a script that cannot be downloaded fires its error event instead of failing the setter of src. CORE review: dispex.c GetMemberProperties and script.c load_script (a failed download returns S_OK from put_src).

diff --git a/dlls/mshtml/dispex.c b/dlls/mshtml/dispex.c
index af5f58d..35f518a 100644
--- a/dlls/mshtml/dispex.c
+++ b/dlls/mshtml/dispex.c
@@ -2413,8 +2413,84 @@ static HRESULT WINAPI DispatchEx_DeleteMemberByDispID(IWineJSDispatchHost *iface
 static HRESULT WINAPI DispatchEx_GetMemberProperties(IWineJSDispatchHost *iface, DISPID id, DWORD grfdexFetch, DWORD *pgrfdex)
 {
     DispatchEx *This = impl_from_IWineJSDispatchHost(iface);
-    FIXME("%s (%p)->(%lx %lx %p)\n", This->info->name, This, id, grfdexFetch, pgrfdex);
+    BOOL can_get = TRUE, can_put = FALSE, can_call = FALSE, side_effects_free = FALSE;
+    HRESULT hres;
+
+    TRACE("%s (%p)->(%lx %lx %p)\n", This->info->name, This, id, grfdexFetch, pgrfdex);
+
+    if(!pgrfdex)
+        return E_POINTER;
+#ifdef SG_MUTANT_RC_GMP
     return E_NOTIMPL;
+#endif
+    if(!ensure_real_info(This))
+        return E_OUTOFMEMORY;
+    if(This->jsdisp)
+        return IWineJSDispatch_GetMemberProperties(This->jsdisp, id, grfdexFetch, pgrfdex);
+
+    switch(get_dispid_type(id)) {
+    case DISPEXPROP_BUILTIN: {
+        func_info_t *func;
+
+        hres = get_builtin_func(This->info, id, &func);
+        if(FAILED(hres))
+            return DISP_E_MEMBERNOTFOUND;
+        if(func->func_disp_idx >= 0) {
+            /* a method: a function object that can be read, replaced and called */
+            can_put = can_call = TRUE;
+        }else {
+            can_get = !!func->get_vtbl_off;
+            can_put = !!func->put_vtbl_off;
+        }
+        break;
+    }
+    case DISPEXPROP_DYNAMIC: {
+        DWORD idx = id - DISPID_DYNPROP_0;
+        dynamic_prop_t *prop;
+
+        if(!get_dynamic_data(This) || idx >= This->dynamic_data->prop_cnt)
+            return DISP_E_MEMBERNOTFOUND;
+        prop = This->dynamic_data->props + idx;
+        if(prop->flags & DYNPROP_DELETED)
+            return DISP_E_MEMBERNOTFOUND;
+        can_put = TRUE;
+        can_call = V_VT(&prop->var) == VT_DISPATCH;  /* dispex_prop_call only calls objects */
+        side_effects_free = TRUE;
+        break;
+    }
+    default: {
+        struct property_info desc;
+
+        if(!This->info->vtbl->get_prop_desc)
+            return DISP_E_MEMBERNOTFOUND;
+        hres = This->info->vtbl->get_prop_desc(This, id, &desc);
+        if(FAILED(hres))
+            return DISP_E_MEMBERNOTFOUND;
+        can_put = !!(desc.flags & PROPF_WRITABLE);
+        can_call = !!(desc.flags & PROPF_METHOD);
+        break;
+    }
+    }
+
+    /* every requested capability is answered with its Can or its Cannot bit */
+    *pgrfdex = 0;
+    if(grfdexFetch & (fdexPropCanGet | fdexPropCannotGet))
+        *pgrfdex |= can_get ? fdexPropCanGet : fdexPropCannotGet;
+    if(grfdexFetch & (fdexPropCanPut | fdexPropCannotPut))
+        *pgrfdex |= can_put ? fdexPropCanPut : fdexPropCannotPut;
+    if(grfdexFetch & (fdexPropCanPutRef | fdexPropCannotPutRef))
+        *pgrfdex |= can_put ? fdexPropCanPutRef : fdexPropCannotPutRef;
+    if(grfdexFetch & (fdexPropCanCall | fdexPropCannotCall))
+        *pgrfdex |= can_call ? fdexPropCanCall : fdexPropCannotCall;
+    if(grfdexFetch & (fdexPropCanConstruct | fdexPropCannotConstruct))
+        *pgrfdex |= fdexPropCannotConstruct;
+    if(grfdexFetch & (fdexPropCanSourceEvents | fdexPropCannotSourceEvents))
+        *pgrfdex |= fdexPropCannotSourceEvents;
+    if((grfdexFetch & fdexPropNoSideEffects) && side_effects_free)
+        *pgrfdex |= fdexPropNoSideEffects;
+    if(grfdexFetch & ~grfdexPropAll)
+        return E_INVALIDARG;
+    return S_OK;
 }
 
