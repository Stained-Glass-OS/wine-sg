+/* navigator.userProfile / opsProfile: the Profile Assistant object. Its data came from the Address Book through
+ * a consent dialog, neither of which exists any more: every request is recorded and then left unanswered (GUESS
+ * for the individual results; the documentation only says the interface is obsolete). */
+typedef struct {
+    DispatchEx dispex;
+    IHTMLOpsProfile IHTMLOpsProfile_iface;
+    HTMLInnerWindow *window;
+    unsigned request_cnt;
+} HTMLOpsProfile;
+
+static inline HTMLOpsProfile *impl_from_IHTMLOpsProfile(IHTMLOpsProfile *iface)
+{
+    return CONTAINING_RECORD(iface, HTMLOpsProfile, IHTMLOpsProfile_iface);
+}
+
+DISPEX_IDISPATCH_IMPL(HTMLOpsProfile, IHTMLOpsProfile, impl_from_IHTMLOpsProfile(iface)->dispex)
+
+static HRESULT WINAPI HTMLOpsProfile_addRequest(IHTMLOpsProfile *iface, BSTR name, VARIANT reserved, VARIANT_BOOL *success)
+{
+    HTMLOpsProfile *This = impl_from_IHTMLOpsProfile(iface);
+
+    TRACE("(%p)->(%s %s %p)\n", This, debugstr_w(name), debugstr_variant(&reserved), success);
+
+    if(!success)
+        return E_POINTER;
+    *success = VARIANT_FALSE;
+    if(!name || !*name)
+        return S_OK;
+    This->request_cnt++;
+    *success = VARIANT_TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLOpsProfile_clearRequest(IHTMLOpsProfile *iface)
+{
+    HTMLOpsProfile *This = impl_from_IHTMLOpsProfile(iface);
+
+    TRACE("(%p)\n", This);
+
+    This->request_cnt = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLOpsProfile_doRequest(IHTMLOpsProfile *iface, VARIANT usage, VARIANT fname, VARIANT domain,
+        VARIANT path, VARIANT expire, VARIANT reserved)
+{
+    HTMLOpsProfile *This = impl_from_IHTMLOpsProfile(iface);
+
+    TRACE("(%p)->(%s %s %s %s %s %s)\n", This, debugstr_variant(&usage), debugstr_variant(&fname),
+          debugstr_variant(&domain), debugstr_variant(&path), debugstr_variant(&expire), debugstr_variant(&reserved));
+
+    /* nobody to ask: the request is over, nothing was granted */
+    This->request_cnt = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLOpsProfile_getAttribute(IHTMLOpsProfile *iface, BSTR name, BSTR *value)
+{
+    HTMLOpsProfile *This = impl_from_IHTMLOpsProfile(iface);
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(name), value);
+
+    if(!value)
+        return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLOpsProfile_setAttribute(IHTMLOpsProfile *iface, BSTR name, BSTR value, VARIANT prefs,
+        VARIANT_BOOL *success)
+{
+    HTMLOpsProfile *This = impl_from_IHTMLOpsProfile(iface);
+
+    TRACE("(%p)->(%s %s %s %p)\n", This, debugstr_w(name), debugstr_w(value), debugstr_variant(&prefs), success);
+
+    if(!success)
+        return E_POINTER;
+    *success = VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLOpsProfile_commitChanges(IHTMLOpsProfile *iface, VARIANT_BOOL *success)
+{
+    HTMLOpsProfile *This = impl_from_IHTMLOpsProfile(iface);
+
+    TRACE("(%p)->(%p)\n", This, success);
+
+    if(!success)
+        return E_POINTER;
+    *success = VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLOpsProfile_addReadRequest(IHTMLOpsProfile *iface, BSTR name, VARIANT reserved,
+        VARIANT_BOOL *success)
+{
+    return HTMLOpsProfile_addRequest(iface, name, reserved, success);
+}
+
+static HRESULT WINAPI HTMLOpsProfile_doReadRequest(IHTMLOpsProfile *iface, VARIANT usage, VARIANT fname, VARIANT domain,
+        VARIANT path, VARIANT expire, VARIANT reserved)
+{
+    return HTMLOpsProfile_doRequest(iface, usage, fname, domain, path, expire, reserved);
+}
+
+static HRESULT WINAPI HTMLOpsProfile_doWriteRequest(IHTMLOpsProfile *iface, VARIANT_BOOL *success)
+{
+    HTMLOpsProfile *This = impl_from_IHTMLOpsProfile(iface);
+
+    TRACE("(%p)->(%p)\n", This, success);
+
+    if(!success)
+        return E_POINTER;
+    *success = VARIANT_FALSE;
+    return S_OK;
+}
+
+static const IHTMLOpsProfileVtbl HTMLOpsProfileVtbl = {
+    HTMLOpsProfile_QueryInterface,
+    HTMLOpsProfile_AddRef,
+    HTMLOpsProfile_Release,
+    HTMLOpsProfile_GetTypeInfoCount,
+    HTMLOpsProfile_GetTypeInfo,
+    HTMLOpsProfile_GetIDsOfNames,
