+
+static inline HTMLOpsProfile *HTMLOpsProfile_from_DispatchEx(DispatchEx *iface)
+{
+    return CONTAINING_RECORD(iface, HTMLOpsProfile, dispex);
+}
+
+static void *HTMLOpsProfile_query_interface(DispatchEx *dispex, REFIID riid)
+{
+    HTMLOpsProfile *This = HTMLOpsProfile_from_DispatchEx(dispex);
+
+    if(IsEqualGUID(&IID_IHTMLOpsProfile, riid))
