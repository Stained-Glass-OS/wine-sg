+        }else {
+            hres = E_OUTOFMEMORY;
+        }
+        IHTMLLocation_Release(location);
+        if(FAILED(hres))
+            return hres;
+    }
+    if(dwPosition || !pszUrlLocation || !*pszUrlLocation) {
+        LONG x = 0;
+        nsIDOMWindow_GetScrollX(This->outer_window->nswindow, &x);
+        hres = IHTMLWindow2_scrollTo(&This->IHTMLWindow2_iface, x, dwPosition);
+    }
+    return hres;
 }
 
