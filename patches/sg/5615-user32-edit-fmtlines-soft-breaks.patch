From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: EM_FMTLINES soft line breaks in WM_GETTEXT and EM_GETHANDLE

user32: EM_FMTLINES soft line breaks in WM_GETTEXT and EM_GETHANDLE

With soft breaks enabled, a multiline edit control's WM_GETTEXT,
WM_GETTEXTLENGTH and the buffer EM_GETHANDLE returns carry CR CR LF at each
wrapped line end. The control's own text is unchanged; EM_SETHANDLE takes the
soft breaks out again.
---
--- a/dlls/user32/edit.c
+++ b/dlls/user32/edit.c
@@ -123,6 +123,7 @@ typedef struct
 	HLOCAL hloc32A;			/* alias for ANSI control receiving EM_GETHANDLE
 				   	   or EM_SETHANDLE */
         HLOCAL hlocapp;                 /* The text buffer handle belongs to the app */
+	WCHAR *soft_plain;		/* the text without soft breaks while EM_GETHANDLE's buffer has them */
 	/*
 	 * IME Data
 	 */
@@ -2399,6 +2400,72 @@ static LRESULT EDIT_EM_CharFromPos(EDITSTATE *es, INT x, INT y)
 }
 
 
+/*********************************************************************
+ *
+ *	EDIT_SoftText
+ *
+ * The text with a soft break (CR CR LF) after each wrapped line, as
+ * EM_FMTLINES says WM_GETTEXT and EM_GETHANDLE return it. NULL when the
+ * text has none to add.
+ */
+static WCHAR *EDIT_SoftText(EDITSTATE *es, UINT *len)
+{
+	LINEDEF *line;
+	UINT breaks = 0, total, pos = 0;
+	WCHAR *buf;
+
+	if (!(es->style & ES_MULTILINE) || !(es->flags & EF_USE_SOFTBRK) || !es->text)
+		return NULL;
+	for (line = es->first_line_def; line; line = line->next)
+		if (line->ending == END_WRAP) breaks++;
+#ifdef SG_MUTANT_FMTLINES_NO_BREAKS
+	breaks = 0;
+#endif
+	if (!breaks) return NULL;
+	total = get_text_length(es) + 3 * breaks;
+	if (!(buf = HeapAlloc(GetProcessHeap(), 0, (total + 1) * sizeof(WCHAR)))) return NULL;
+	for (line = es->first_line_def; line; line = line->next)
+	{
+		memcpy(buf + pos, es->text + line->index, line->length * sizeof(WCHAR));
+		pos += line->length;
+		if (line->ending == END_WRAP)
+		{
+			buf[pos++] = '\r';
+			buf[pos++] = '\r';
+			buf[pos++] = '\n';
+		}
+	}
+	buf[pos] = 0;
+	*len = pos;
+	return buf;
+}
+
+
+static void EDIT_RestoreFromSoft(EDITSTATE *es)
+{
+	if (!es->soft_plain) return;
+	lstrcpyW(es->text, es->soft_plain);
+	HeapFree(GetProcessHeap(), 0, es->soft_plain);
+	es->soft_plain = NULL;
+	es->text_length = (UINT)-1;
+}
+
+
+static void EDIT_StripSoftBreaks(EDITSTATE *es)
+{
+	WCHAR *src = es->text, *dst = es->text;
+
+	if (!(es->flags & EF_USE_SOFTBRK)) return;
+	while (*src)
+	{
+		if (src[0] == '\r' && src[1] == '\r' && src[2] == '\n') src += 3;
+		else *dst++ = *src++;
+	}
+	*dst = 0;
+	es->text_length = (UINT)-1;
+}
+
+
 /*********************************************************************
  *
  *	EM_FMTLINES
@@ -2415,7 +2482,6 @@ static BOOL EDIT_EM_FmtLines(EDITSTATE *es, BOOL add_eol)
 	es->flags &= ~EF_USE_SOFTBRK;
 	if (add_eol) {
 		es->flags |= EF_USE_SOFTBRK;
-		FIXME("soft break enabled, not implemented\n");
 	}
 	return add_eol;
 }
@@ -2439,6 +2505,29 @@ static HLOCAL EDIT_EM_GetHandle(EDITSTATE *es)
 	if (!(es->style & ES_MULTILINE))
 		return 0;
 
+	if (!es->soft_plain)
+	{
+	    UINT soft_len;
+	    WCHAR *soft = EDIT_SoftText(es, &soft_len);
+
+	    /* the buffer the application gets has the soft breaks; the control's own text comes
+	       back with the next message */
+	    if (soft)
+	    {
+		WCHAR *plain = HeapAlloc(GetProcessHeap(), 0, (get_text_length(es) + 1) * sizeof(WCHAR));
+
+		if (plain && EDIT_MakeFit(es, soft_len))
+		{
+		    lstrcpyW(plain, es->text);
+		    lstrcpyW(es->text, soft);
+		    es->text_length = (UINT)-1;
+		    es->soft_plain = plain;
+		}
+		else HeapFree(GetProcessHeap(), 0, plain);
+		HeapFree(GetProcessHeap(), 0, soft);
+	    }
+	}
+
 	if(es->is_unicode)
 	    hLocal = es->hloc32W;
 	else
@@ -2811,6 +2900,9 @@ static void EDIT_EM_SetHandle(EDITSTATE *es, HLOCAL hloc)
         es->hlocapp = NULL;
 
 	EDIT_LockBuffer(es);
+	HeapFree(GetProcessHeap(), 0, es->soft_plain);
+	es->soft_plain = NULL;
+	EDIT_StripSoftBreaks(es);
         text_buffer_changed(es);
 
 	es->x_offset = es->y_offset = 0;
@@ -3360,22 +3452,31 @@ static void EDIT_WM_ContextMenu(EDITSTATE *es, INT x, INT y)
  *	WM_GETTEXT
  *
  */
-static INT EDIT_WM_GetText(const EDITSTATE *es, INT count, LPWSTR dst, BOOL unicode)
+static INT EDIT_WM_GetText(EDITSTATE *es, INT count, LPWSTR dst, BOOL unicode)
 {
+    UINT soft_len;
+    WCHAR *soft;
+    const WCHAR *text;
+    INT ret;
+
     if(!count) return 0;
 
+    soft = EDIT_SoftText(es, &soft_len);
+    text = soft ? soft : es->text;
     if(unicode)
     {
-	lstrcpynW(dst, es->text, count);
-	return lstrlenW(dst);
+	lstrcpynW(dst, text, count);
+	ret = lstrlenW(dst);
     }
     else
     {
 	LPSTR textA = (LPSTR)dst;
-	if (!WideCharToMultiByte(CP_ACP, 0, es->text, -1, textA, count, NULL, NULL))
+	if (!WideCharToMultiByte(CP_ACP, 0, text, -1, textA, count, NULL, NULL))
             textA[count - 1] = 0; /* ensure 0 termination */
-	return strlen(textA);
+	ret = strlen(textA);
     }
+    HeapFree(GetProcessHeap(), 0, soft);
+    return ret;
 }
 
 /*********************************************************************
@@ -4545,6 +4646,7 @@ static LRESULT EDIT_WM_NCDestroy(EDITSTATE *es)
         if (es->hloc32A && (es->hloc32A != es->hlocapp)) {
 		LocalFree(es->hloc32A);
 	}
+	HeapFree(GetProcessHeap(), 0, es->soft_plain);
 	EDIT_InvalidateUniscribeData(es);
 	pc = es->first_line_def;
 	while (pc)
@@ -4589,6 +4691,8 @@ LRESULT EditWndProc_common( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam, B
 		return DefWindowProcT(hwnd, msg, wParam, lParam, unicode);
 
 	if (es && (msg != WM_NCDESTROY)) EDIT_LockBuffer(es);
+	if (es && es->soft_plain && msg != EM_GETHANDLE && msg != EM_SETHANDLE && msg != WM_NCDESTROY)
+		EDIT_RestoreFromSoft(es);
 
 	switch (msg) {
 	case EM_GETSEL:
@@ -4975,9 +5079,16 @@ LRESULT EditWndProc_common( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam, B
 		break;
 
 	case WM_GETTEXTLENGTH:
-                if (unicode) result = get_text_length(es);
-                else result = WideCharToMultiByte( CP_ACP, 0, es->text, get_text_length(es),
-                                                   NULL, 0, NULL, NULL );
+            {
+                UINT soft_len = 0;
+                WCHAR *soft = EDIT_SoftText(es, &soft_len);
+                const WCHAR *text = soft ? soft : es->text;
+                UINT len = soft ? soft_len : get_text_length(es);
+
+                if (unicode) result = len;
+                else result = WideCharToMultiByte( CP_ACP, 0, text, len, NULL, 0, NULL, NULL );
+                HeapFree(GetProcessHeap(), 0, soft);
+            }
 		break;
 
 	case WM_HSCROLL:
--- a/dlls/user32/tests/edit.c
+++ b/dlls/user32/tests/edit.c
@@ -3474,6 +3474,97 @@ static void test_format_rect(void)
     }
 }
 
+static int count_soft_breaks(const WCHAR *text)
+{
+    int n = 0;
+
+    for (; *text; text++)
+        if (text[0] == '\r' && text[1] == '\r' && text[2] == '\n') n++;
+    return n;
+}
+
+static void test_fmtlines(BOOL unicode)
+{
+    static const WCHAR textW[] = L"aaaa bbbb cccc dddd eeee ffff gggg hhhh iiii jjjj";
+    WCHAR bufW[512], *handle_text;
+    char bufA[512];
+    LRESULT lines, len, ret;
+    HLOCAL handle, handle2;
+    HWND hwnd;
+    int soft;
+
+    if (unicode)
+        hwnd = CreateWindowExW(0, L"Edit", textW, WS_POPUP | ES_MULTILINE, 0, 0, 90, 200, NULL, NULL, hinst, NULL);
+    else
+        hwnd = CreateWindowExA(0, "Edit", "aaaa bbbb cccc dddd eeee ffff gggg hhhh iiii jjjj",
+                WS_POPUP | ES_MULTILINE, 0, 0, 90, 200, NULL, NULL, hinst, NULL);
+    ok(!!hwnd, "CreateWindow failed\n");
+
+    lines = SendMessageW(hwnd, EM_GETLINECOUNT, 0, 0);
+    ok(lines > 2, "%d: got %Id lines\n", unicode, lines);
+    len = SendMessageW(hwnd, WM_GETTEXTLENGTH, 0, 0);
+    ok(len == lstrlenW(textW), "%d: got length %Id\n", unicode, len);
+
+    /* soft breaks are off by default */
+    SendMessageW(hwnd, WM_GETTEXT, ARRAY_SIZE(bufW), (LPARAM)bufW);
+    ok(count_soft_breaks(bufW) == 0, "%d: unexpected soft breaks\n", unicode);
+
+    ret = SendMessageW(hwnd, EM_FMTLINES, TRUE, 0);
+    ok(ret == TRUE, "%d: got %Id\n", unicode, ret);
+    memset(bufW, 0, sizeof(bufW));
+    if (unicode) ret = SendMessageW(hwnd, WM_GETTEXT, ARRAY_SIZE(bufW), (LPARAM)bufW);
+    else
+    {
+        ret = SendMessageA(hwnd, WM_GETTEXT, sizeof(bufA), (LPARAM)bufA);
+        MultiByteToWideChar(CP_ACP, 0, bufA, -1, bufW, ARRAY_SIZE(bufW));
+    }
+    soft = count_soft_breaks(bufW);
+    ok(soft == lines - 1, "%d: got %d soft breaks for %Id lines\n", unicode, soft, lines);
+    ok(ret == lstrlenW(textW) + 3 * soft, "%d: got %Id\n", unicode, ret);
+    len = SendMessageW(hwnd, WM_GETTEXTLENGTH, 0, 0);
+    ok(len == ret, "%d: got length %Id\n", unicode, len);
+    ok(SendMessageW(hwnd, EM_GETLINECOUNT, 0, 0) == lines, "%d: the line count changed\n", unicode);
+
+    /* the buffer of EM_GETHANDLE has them too, the control's own text does not change */
+    handle = (HLOCAL)SendMessageW(hwnd, EM_GETHANDLE, 0, 0);
+    ok(!!handle, "%d: no handle\n", unicode);
+    if (unicode)
+    {
+        handle_text = LocalLock(handle);
+        ok(count_soft_breaks(handle_text) == soft, "%d: the handle has %d soft breaks\n", unicode,
+                count_soft_breaks(handle_text));
+        LocalUnlock(handle);
+    }
+    else
+    {
+        char *text = LocalLock(handle);
+
+        MultiByteToWideChar(CP_ACP, 0, text, -1, bufW, ARRAY_SIZE(bufW));
+        ok(count_soft_breaks(bufW) == soft, "%d: the handle has %d soft breaks\n", unicode, count_soft_breaks(bufW));
+        LocalUnlock(handle);
+    }
+    ok(SendMessageW(hwnd, EM_GETLINECOUNT, 0, 0) == lines, "%d: the line count changed\n", unicode);
+    SendMessageW(hwnd, EM_FMTLINES, FALSE, 0);
+    len = SendMessageW(hwnd, WM_GETTEXTLENGTH, 0, 0);
+    ok(len == lstrlenW(textW), "%d: got length %Id\n", unicode, len);
+    SendMessageW(hwnd, WM_GETTEXT, ARRAY_SIZE(bufW), (LPARAM)bufW);
+    ok(count_soft_breaks(bufW) == 0, "%d: unexpected soft breaks\n", unicode);
+    if (unicode) ok(!lstrcmpW(bufW, textW), "%d: text %s\n", unicode, wine_dbgstr_w(bufW));
+
+    /* giving the buffer back takes the soft breaks out */
+    SendMessageW(hwnd, EM_FMTLINES, TRUE, 0);
+    handle2 = (HLOCAL)SendMessageW(hwnd, EM_GETHANDLE, 0, 0);
+    SendMessageW(hwnd, EM_SETHANDLE, (WPARAM)handle2, 0);
+    SendMessageW(hwnd, EM_FMTLINES, FALSE, 0);
+    len = SendMessageW(hwnd, WM_GETTEXTLENGTH, 0, 0);
+    ok(len == lstrlenW(textW), "%d: got length %Id after EM_SETHANDLE\n", unicode, len);
+    SendMessageW(hwnd, EM_FMTLINES, TRUE, 0);
+    len = SendMessageW(hwnd, WM_GETTEXTLENGTH, 0, 0);
+    ok(len == lstrlenW(textW) + 3 * (SendMessageW(hwnd, EM_GETLINECOUNT, 0, 0) - 1), "%d: got length %Id\n", unicode, len);
+
+    DestroyWindow(hwnd);
+}
+
 START_TEST(edit)
 {
     BOOL b;
@@ -3505,6 +3596,8 @@ START_TEST(edit)
     test_singleline_wantreturn_edit_dialog();
     test_child_edit_wmkeydown();
     test_fontsize();
+    test_fmtlines(TRUE);
+    test_fmtlines(FALSE);
     test_dialogmode();
     test_contextmenu();
     test_EM_GETHANDLE();
