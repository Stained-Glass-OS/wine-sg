diff --git a/dlls/twinapi.appcore/main.c b/dlls/twinapi.appcore/main.c
index 8a993a0..0db8113 100644
--- a/dlls/twinapi.appcore/main.c
+++ b/dlls/twinapi.appcore/main.c
@@ -21,13 +21,50 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
 
+/* the interfaces an object implements (its WinRT ones, not IUnknown,
+ * IInspectable or IAgileObject), in memory the caller frees with CoTaskMemFree */
+HRESULT inspectable_iids( ULONG *count, IID **iids, const IID *const *list, ULONG n )
+{
+    ULONG i;
+
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = NULL;
+    if (!n) return S_OK;
+    if (!(*iids = CoTaskMemAlloc( n * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < n; i++) (*iids)[i] = *list[i];
+    *count = n;
+    return S_OK;
+}
+
+HRESULT inspectable_name( const WCHAR *name, HSTRING *class_name )
+{
+    if (!class_name) return E_POINTER;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+/* A registration is a heap block of its own; the routines are called when the
+ * process state changes, which happens only for a packaged app the process
+ * model suspends or constrains. A process here runs until it ends, so the
+ * routine is kept and never called. */
+struct appstate_registration { PAPPSTATE_CHANGE_ROUTINE routine; void *context; };
+struct appconstrain_registration { PAPPCONSTRAIN_CHANGE_ROUTINE routine; void *context; };
+
 /***********************************************************************
  *           RegisterAppConstrainedChangeNotification (twinapi.appcore.@)
  */
 ULONG WINAPI RegisterAppConstrainedChangeNotification( PAPPCONSTRAIN_CHANGE_ROUTINE routine, void *context, PAPPCONSTRAIN_REGISTRATION *reg )
 {
-    FIXME( "routine %p, context %p, reg %p - stub.\n", routine, context, reg );
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    struct appconstrain_registration *r;
+
+    TRACE( "routine %p, context %p, reg %p.\n", routine, context, reg );
+
+    if (!routine || !reg) return ERROR_INVALID_PARAMETER;
+    if (!(r = calloc( 1, sizeof(*r) ))) return ERROR_OUTOFMEMORY;
+    r->routine = routine;
+    r->context = context;
+    *reg = (PAPPCONSTRAIN_REGISTRATION)r;
+    return ERROR_SUCCESS;
 }
 
 /***********************************************************************
@@ -35,8 +72,16 @@ ULONG WINAPI RegisterAppConstrainedChangeNotification( PAPPCONSTRAIN_CHANGE_ROUT
  */
 ULONG WINAPI RegisterAppStateChangeNotification( PAPPSTATE_CHANGE_ROUTINE routine, void *context, PAPPSTATE_REGISTRATION *reg )
 {
-    FIXME( "routine %p, context %p, reg %p - stub.\n", routine, context, reg );
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    struct appstate_registration *r;
+
+    TRACE( "routine %p, context %p, reg %p.\n", routine, context, reg );
+
+    if (!routine || !reg) return ERROR_INVALID_PARAMETER;
+    if (!(r = calloc( 1, sizeof(*r) ))) return ERROR_OUTOFMEMORY;
+    r->routine = routine;
+    r->context = context;
+    *reg = (PAPPSTATE_REGISTRATION)r;
+    return ERROR_SUCCESS;
 }
 
 /***********************************************************************
@@ -44,7 +89,8 @@ ULONG WINAPI RegisterAppStateChangeNotification( PAPPSTATE_CHANGE_ROUTINE routin
  */
 void WINAPI UnregisterAppConstrainedChangeNotification( PAPPCONSTRAIN_REGISTRATION reg )
 {
-    FIXME( "reg %p - stub.\n", reg );
+    TRACE( "reg %p.\n", reg );
+    free( reg );
 }
 
 /***********************************************************************
@@ -52,12 +98,15 @@ void WINAPI UnregisterAppConstrainedChangeNotification( PAPPCONSTRAIN_REGISTRATI
  */
 void WINAPI UnregisterAppStateChangeNotification( PAPPSTATE_REGISTRATION reg )
 {
-    FIXME( "reg %p - stub.\n", reg );
+    TRACE( "reg %p.\n", reg );
+    free( reg );
 }
 
+/* the DLL's classes are all runtime classes, reached by DllGetActivationFactory */
 HRESULT WINAPI DllGetClassObject( REFCLSID clsid, REFIID riid, void **out )
 {
-    FIXME( "clsid %s, riid %s, out %p stub!\n", debugstr_guid(clsid), debugstr_guid(riid), out );
+    TRACE( "clsid %s, riid %s, out %p.\n", debugstr_guid(clsid), debugstr_guid(riid), out );
+    if (out) *out = NULL;
     return CLASS_E_CLASSNOTAVAILABLE;
 }
 
@@ -94,3 +143,8 @@ HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **fa
     if (*factory) return S_OK;
     return CLASS_E_CLASSNOTAVAILABLE;
 }
+
+HRESULT WINAPI DllCanUnloadNow(void)
+{
+    return S_FALSE;
+}
