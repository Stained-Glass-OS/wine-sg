From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: sg_embed's state thread lets X's error lock go
 before embed_mutex

---
 dlls/winex11.drv/sg_embed.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/dlls/winex11.drv/sg_embed.c b/dlls/winex11.drv/sg_embed.c
index 308dd19..7a3041d 100644
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -540,10 +540,24 @@ static void handle_wm_request( Display *d, Window root, XEvent *evp, Atom net_mo
         {
             BOOL hidden = FALSE, focused = FALSE;
             int i;
+#if !defined(SG_MUTANT_EMBED_UNGUARDED) && !defined(SG_MUTANT_EMBED_LOCK_ORDER)
+            /* Stained Glass OS (wine-sg 7827): X's error lock (held around each request this thread
+             * hears, state_thread) let go before embed_mutex is taken. The frames' thread takes
+             * them the other way round -- embed_mutex, then the error lock for the X calls it makes
+             * under it (a frame moved or sized, its window's focus or shadow changed) -- and with
+             * both at once explorer deadlocked: the shell gone, no Windows program could start, a
+             * full-screen frame left over everything (sdl-freerdp3 /multimon, its two full-screen
+             * windows passing the focus back and forth while it asked for states). */
+            XSync( d, False );
+            X11DRV_check_error();
+#endif
             pthread_mutex_lock( &embed_mutex );
             for (i = 0; i < embed_count; i++)
                 if (embeds[i].child == ev.xclient.window) { hidden = embeds[i].minimized; focused = embeds[i].focused; }
             pthread_mutex_unlock( &embed_mutex );
+#if !defined(SG_MUTANT_EMBED_UNGUARDED) && !defined(SG_MUTANT_EMBED_LOCK_ORDER)
+            X11DRV_expect_error( d, ignore_error, NULL );
+#endif
             set_net_state( d, ev.xclient.window, get_cardinal( d, ev.xclient.window, ours_fs ),
                            get_cardinal( d, ev.xclient.window, ours_max ), hidden, focused );
         }
