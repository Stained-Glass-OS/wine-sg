From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, server: find a local class by the instance's high word below 0x10000 too

Windows finds a local window class by the high word of the instance, so an instance below 0x10000
that is not a module -- a process handle, say -- finds a class registered with another such value.
Wine matched instances below 0x10000 exactly, as Win16 instances (selectors) need. NAPS2's TWAIN
worker registers its message pump window's class and creates the window each with
Process.GetCurrentProcess().Handle, a new process handle on every call (0x24c, then 0x250): the
window was not created, the pump's PostMessage(NULL, ...) went to the posting thread's own queue,
the TWAIN session never opened and the device search never ended. GetClassInfo and window creation
now fall back to the Windows rule when nothing matched; registering and destroying a class keep the
exact match, so Win16 modules still each have their own class of a name.
---
diff --git a/dlls/win32u/class.c b/dlls/win32u/class.c
--- a/dlls/win32u/class.c
+++ b/dlls/win32u/class.c
@@ -355,6 +355,33 @@
             return class;
         }
     }
+#ifndef SG_MUTANT_CLASS_SMALL_INSTANCE_EXACT
+    /* Stained Glass OS (wine-sg 8409): Windows finds a local class by the high word of the
+     * instance, so an instance below 0x10000 -- not a module, e.g. a process handle -- finds a
+     * class registered with another such value. Wine keeps those exact for Win16 instances
+     * (selectors), and they still match exactly above; only when nothing matched does the
+     * Windows rule apply. NAPS2's TWAIN worker registers its pump window's class and creates the
+     * window each with Process.GetCurrentProcess().Handle -- a new handle every call -- and the
+     * window creation failed, so its device search never ended. */
+    if (instance && !(instance >> 16))
+    {
+        LIST_FOR_EACH_ENTRY( class, &class_list, CLASS, entry )
+        {
+            if (!class->local || (class->instance >> 16)) continue;
+            if (atom)
+            {
+                if (class->atomName != atom) continue;
+            }
+            else
+            {
+                if (wcsnicmp( class->name, name->Buffer, name->Length / sizeof(WCHAR) ) ||
+                    class->name[name->Length / sizeof(WCHAR)]) continue;
+            }
+            TRACE( "%s %lx -> %p (instance %lx)\n", debugstr_us(name), instance, class, class->instance );
+            return class;
+        }
+    }
+#endif
     user_unlock();
     return NULL;
 }
diff --git a/server/class.c b/server/class.c
--- a/server/class.c
+++ b/server/class.c
@@ -109,10 +109,33 @@
     return NULL;
 }
 
+#ifndef SG_MUTANT_CLASS_SMALL_INSTANCE_EXACT
+/* Stained Glass OS (wine-sg 8409): Windows finds a local class by the high word of the instance,
+ * so an instance below 0x10000 that is not a module (a process handle, say) finds a class
+ * registered with another such value. find_class keeps those exact, as Win16 instances
+ * (selectors) need, and registering and destroying stay that way; a window's creation falls back
+ * to the Windows rule when nothing matched. (NAPS2's TWAIN worker: its message pump window.) */
+static struct window_class *find_class_for_window( struct process *process, atom_t atom, mod_handle_t instance )
+{
+    struct window_class *class = find_class( process, atom, instance );
+    struct list *ptr;
+
+    if (class || !instance || (instance >> 16)) return class;
+    LIST_FOR_EACH( ptr, &process->classes )
+    {
+        class = LIST_ENTRY( ptr, struct window_class, entry );
+        if (class->atom == atom && class->local && !(class->instance >> 16)) return class;
+    }
+    return NULL;
+}
+#else
+#define find_class_for_window find_class
+#endif
+
 struct window_class *grab_class( struct process *process, atom_t atom,
                                  mod_handle_t instance, int *extra_bytes )
 {
-    struct window_class *class = find_class( process, atom, instance );
+    struct window_class *class = find_class_for_window( process, atom, instance );
     if (class)
     {
         class->count++;
