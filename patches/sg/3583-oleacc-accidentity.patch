diff --git a/dlls/oleacc/propservice.c b/dlls/oleacc/propservice.c
index 43e9c87..3229fc0 100644
--- a/dlls/oleacc/propservice.c
+++ b/dlls/oleacc/propservice.c
@@ -94,8 +94,33 @@ struct accprop_entry
     MSAAPROPID prop;
     VARIANT var;            /* VT_EMPTY when server is set instead */
     IAccPropServer *server;
+    DWORD server_cookie;    /* global interface table cookie of the server, or 0 */
 };
 
+/*
+ * A property server belongs to the apartment that registered it, and the
+ * table is read from any thread: the server is also kept in the global
+ * interface table, from where each reader gets an interface usable in its
+ * own apartment.
+ */
+static const GUID accprop_clsid_git = { 0x00000323, 0, 0, { 0xc0, 0, 0, 0, 0, 0, 0, 0x46 } };
+static const GUID accprop_iid_git = { 0x00000146, 0, 0, { 0xc0, 0, 0, 0, 0, 0, 0, 0x46 } };
+
+static IGlobalInterfaceTable *accprop_git(void)
+{
+    static IGlobalInterfaceTable *git;
+    IGlobalInterfaceTable *tmp;
+
+    if (git)
+        return git;
+    if (FAILED(CoCreateInstance(&accprop_clsid_git, NULL, CLSCTX_INPROC_SERVER,
+            &accprop_iid_git, (void **)&tmp)))
+        return NULL;
+    if (InterlockedCompareExchangePointer((void **)&git, tmp, NULL))
+        IGlobalInterfaceTable_Release(tmp);
+    return git;
+}
+
 static struct list accprop_entries = LIST_INIT(accprop_entries);
 static CRITICAL_SECTION accprop_cs;
 static CRITICAL_SECTION_DEBUG accprop_cs_debug =
@@ -109,6 +134,13 @@ static CRITICAL_SECTION accprop_cs = { &accprop_cs_debug, -1, 0, 0, 0, 0 };
 static void accprop_entry_destroy(struct accprop_entry *entry)
 {
     list_remove(&entry->entry);
+    if (entry->server_cookie)
+    {
+        IGlobalInterfaceTable *git = accprop_git();
+
+        if (git)
+            IGlobalInterfaceTable_RevokeInterfaceFromGlobal(git, entry->server_cookie);
+    }
     if (entry->server)
         IAccPropServer_Release(entry->server);
     else
@@ -173,8 +205,15 @@ static HRESULT accprop_set(const BYTE *id, DWORD id_len, MSAAPROPID prop,
     VariantInit(&entry->var);
     if (server)
     {
+        IGlobalInterfaceTable *git = accprop_git();
+
         IAccPropServer_AddRef(server);
         entry->server = server;
+#ifndef SG_MUTANT_ACCPROP_NO_GIT
+        if (git)
+            IGlobalInterfaceTable_RegisterInterfaceInGlobal(git, (IUnknown *)server, &IID_IAccPropServer,
+                    &entry->server_cookie);
+#endif
     }
     else if (var)
     {
@@ -460,6 +499,127 @@ static const IAccPropServicesVtbl AccPropServicesVtbl = {
     AccPropServices_DecomposeHmenuIdentityString
 };
 
+
+/*
+ * Read side of the table.  Real MSAA has no public call for it: the
+ * Dynamic Annotation wrapper reads it.  UI Automation's annotation provider
+ * does the same through this Wine-private export.  Returns S_OK and the value
+ * when an annotation (a stored value or an answer from a registered server)
+ * exists for the identity and property, S_FALSE when there is none.
+ */
+HRESULT WINAPI WineAccPropGetValue(const BYTE *id, DWORD id_len, const GUID *prop, VARIANT *out)
+{
+    struct accprop_entry *entry;
+    IAccPropServer *server = NULL;
+    DWORD cookie = 0;
+    HRESULT hr = S_FALSE;
+
+    TRACE("(%p %lu %s %p)\n", id, id_len, debugstr_guid(prop), out);
+
+    if (!id || !id_len || !prop || !out)
+        return E_INVALIDARG;
+    VariantInit(out);
+
+    EnterCriticalSection(&accprop_cs);
+    LIST_FOR_EACH_ENTRY(entry, &accprop_entries, struct accprop_entry, entry)
+    {
+        if (!accprop_id_equal(entry->id, entry->id_len, id, id_len) || !IsEqualGUID(&entry->prop, prop))
+            continue;
+        if (entry->server)
+        {
+            cookie = entry->server_cookie;
+            if (!cookie)
+            {
+                server = entry->server;
+                IAccPropServer_AddRef(server);
+            }
+            hr = S_OK;
+        }
+        else
+            hr = VariantCopy(out, &entry->var) == S_OK ? S_OK : E_OUTOFMEMORY;
+        break;
+    }
+    LeaveCriticalSection(&accprop_cs);
+
+    if (cookie)
+    {
+        IGlobalInterfaceTable *git = accprop_git();
+
+        hr = S_FALSE;
+        if (git && FAILED(IGlobalInterfaceTable_GetInterfaceFromGlobal(git, cookie, &IID_IAccPropServer,
+                (void **)&server)))
+            server = NULL;
+    }
+
+    if (server)
+    {
+        BOOL has_prop = FALSE;
+
+        hr = IAccPropServer_GetPropValue(server, id, id_len, *prop, out, &has_prop);
+        IAccPropServer_Release(server);
+        if (SUCCEEDED(hr) && !has_prop)
+        {
+            VariantClear(out);
+            hr = S_FALSE;
+        }
+    }
+    else if (cookie)
+        hr = S_FALSE;
+    return hr;
+}
+
+/*
+ * IAccIdentity for the objects this module creates: the identity string of
+ * (window, object id, child id) in the form ComposeHwndIdentityString makes.
+ */
+static inline struct acc_identity *impl_from_acc_identity(IAccIdentity *iface)
+{
+    return CONTAINING_RECORD(iface, struct acc_identity, IAccIdentity_iface);
+}
+
+static HRESULT WINAPI acc_identity_QueryInterface(IAccIdentity *iface, REFIID riid, void **ppv)
+{
+    return IUnknown_QueryInterface(impl_from_acc_identity(iface)->outer, riid, ppv);
+}
+
+static ULONG WINAPI acc_identity_AddRef(IAccIdentity *iface)
+{
+    return IUnknown_AddRef(impl_from_acc_identity(iface)->outer);
+}
+
+static ULONG WINAPI acc_identity_Release(IAccIdentity *iface)
+{
+    return IUnknown_Release(impl_from_acc_identity(iface)->outer);
+}
+
+static HRESULT WINAPI acc_identity_GetIdentityString(IAccIdentity *iface, DWORD child, BYTE **str, DWORD *len)
+{
+    struct acc_identity *This = impl_from_acc_identity(iface);
+
+    TRACE("(%p)->(%lu %p %p)\n", This, child, str, len);
+
+    if (!str || !len)
+        return E_POINTER;
+    *str = NULL;
+    *len = 0;
+    return AccPropServices_ComposeHwndIdentityString(NULL, This->hwnd, This->objid, child, str, len);
+}
+
+static const IAccIdentityVtbl acc_identity_vtbl = {
+    acc_identity_QueryInterface,
+    acc_identity_AddRef,
+    acc_identity_Release,
+    acc_identity_GetIdentityString
+};
+
+void acc_identity_init(struct acc_identity *id, IUnknown *outer, HWND hwnd, DWORD objid)
+{
+    id->IAccIdentity_iface.lpVtbl = &acc_identity_vtbl;
+    id->outer = outer;
+    id->hwnd = hwnd;
+    id->objid = objid;
+}
+
 static IAccPropServices AccPropServices = { &AccPropServicesVtbl };
 
 static HRESULT WINAPI ClassFactory_QueryInterface(IClassFactory *iface, REFIID riid, void **ppv)
