From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3d9: ComposeRects (3693)

d3d9: ComposeRects

IDirect3DDevice9Ex::ComposeRects copies the rectangles named by the
destination descriptors (source rectangle index and position) from the
source surface into the destination surface, shifted by the offset, with
COPY, OR, AND or NEG, clipped to both surfaces.
---
diff --git a/dlls/d3d9/device.c b/dlls/d3d9/device.c
index 382fa58..c39b1fb 100644
--- a/dlls/d3d9/device.c
+++ b/dlls/d3d9/device.c
@@ -4178,16 +4178,125 @@ static HRESULT WINAPI d3d9_device_SetConvolutionMonoKernel(IDirect3DDevice9Ex *i
     return E_NOTIMPL;
 }
 
+struct compose_rect_desc { USHORT x, y, width, height; };
+struct compose_rect_dest { USHORT src_index, reserved, x, y; };
+
+static UINT compose_format_bytes(D3DFORMAT format)
+{
+    switch (format)
+    {
+    case D3DFMT_A8: case D3DFMT_L8: case D3DFMT_P8: return 1;
+    case D3DFMT_R5G6B5: case D3DFMT_X1R5G5B5: case D3DFMT_A1R5G5B5: case D3DFMT_A4R4G4B4: case D3DFMT_A8L8:
+    case D3DFMT_L16: case D3DFMT_R16F: return 2;
+    case D3DFMT_R8G8B8: return 3;
+    case D3DFMT_A8R8G8B8: case D3DFMT_X8R8G8B8: case D3DFMT_A8B8G8R8: case D3DFMT_X8B8G8R8: case D3DFMT_A2R10G10B10:
+    case D3DFMT_A2B10G10R10: case D3DFMT_G16R16: case D3DFMT_R32F: case D3DFMT_G16R16F: return 4;
+    case D3DFMT_A16B16G16R16: case D3DFMT_A16B16G16R16F: case D3DFMT_G32R32F: return 8;
+    case D3DFMT_A32B32G32R32F: return 16;
+    default: return 0;
+    }
+}
+
+/* Compose rectangles of the source surface into the destination surface: the source descriptors
+ * name rectangles of the source, the destination descriptors say which of them goes where
+ * (plus the offset); COPY replaces the destination pixels, OR, AND combine them bitwise and NEG
+ * writes the inverted source (the combination rules are not verified against native). */
 static HRESULT WINAPI d3d9_device_ComposeRects(IDirect3DDevice9Ex *iface,
         IDirect3DSurface9 *src_surface, IDirect3DSurface9 *dst_surface, IDirect3DVertexBuffer9 *src_descs,
         UINT rect_count, IDirect3DVertexBuffer9 *dst_descs, D3DCOMPOSERECTSOP operation, INT offset_x, INT offset_y)
 {
-    FIXME("iface %p, src_surface %p, dst_surface %p, src_descs %p, rect_count %u, "
-            "dst_descs %p, operation %#x, offset_x %u, offset_y %u stub!\n",
+    D3DSURFACE_DESC sdesc, ddesc;
+    D3DVERTEXBUFFER_DESC sbdesc, dbdesc;
+    struct compose_rect_desc *sd = NULL;
+    struct compose_rect_dest *dd = NULL;
+    D3DLOCKED_RECT sl, dl;
+    UINT bpp, i, src_count;
+    HRESULT hr;
+
+    TRACE("iface %p, src_surface %p, dst_surface %p, src_descs %p, rect_count %u, "
+            "dst_descs %p, operation %#x, offset_x %d, offset_y %d.\n",
             iface, src_surface, dst_surface, src_descs, rect_count,
             dst_descs, operation, offset_x, offset_y);
 
-    return E_NOTIMPL;
+    if (!src_surface || !dst_surface || !src_descs || !dst_descs || operation < D3DCOMPOSERECTS_COPY
+            || operation > D3DCOMPOSERECTS_NEG)
+        return D3DERR_INVALIDCALL;
+    IDirect3DSurface9_GetDesc(src_surface, &sdesc);
+    IDirect3DSurface9_GetDesc(dst_surface, &ddesc);
+    IDirect3DVertexBuffer9_GetDesc(src_descs, &sbdesc);
+    IDirect3DVertexBuffer9_GetDesc(dst_descs, &dbdesc);
+    if (sdesc.Format != ddesc.Format || !(bpp = compose_format_bytes(sdesc.Format))
+            || dbdesc.Size < rect_count * sizeof(*dd))
+        return D3DERR_INVALIDCALL;
+    src_count = sbdesc.Size / sizeof(*sd);
+
+    if (FAILED(hr = IDirect3DVertexBuffer9_Lock(src_descs, 0, 0, (void **)&sd, D3DLOCK_READONLY))) return hr;
+    if (FAILED(hr = IDirect3DVertexBuffer9_Lock(dst_descs, 0, 0, (void **)&dd, D3DLOCK_READONLY)))
+    {
+        IDirect3DVertexBuffer9_Unlock(src_descs);
+        return hr;
+    }
+    if (FAILED(hr = IDirect3DSurface9_LockRect(src_surface, &sl, NULL, D3DLOCK_READONLY))) goto done;
+    if (FAILED(hr = IDirect3DSurface9_LockRect(dst_surface, &dl, NULL, 0)))
+    {
+        IDirect3DSurface9_UnlockRect(src_surface);
+        goto done;
+    }
+    for (i = 0; i < rect_count; ++i)
+    {
+        const struct compose_rect_desc *r;
+        INT x, y, w, h, dx, dy, row;
+
+        if (dd[i].src_index >= src_count) continue;
+#ifdef SG_MUTANT_COMPOSE_INDEX
+        r = &sd[0];
+#else
+        r = &sd[dd[i].src_index];
+#endif
+        w = r->width;
+        h = r->height;
+#ifdef SG_MUTANT_COMPOSE_OFFSET
+        offset_x = offset_y = 0;
+#endif
+        dx = (INT)dd[i].x + offset_x;
+        dy = (INT)dd[i].y + offset_y;
+        x = r->x;
+        y = r->y;
+        /* clip to both surfaces */
+        if (dx < 0) { x -= dx; w += dx; dx = 0; }
+        if (dy < 0) { y -= dy; h += dy; dy = 0; }
+        if (x + w > (INT)sdesc.Width) w = sdesc.Width - x;
+        if (y + h > (INT)sdesc.Height) h = sdesc.Height - y;
+        if (dx + w > (INT)ddesc.Width) w = ddesc.Width - dx;
+        if (dy + h > (INT)ddesc.Height) h = ddesc.Height - dy;
+        if (w <= 0 || h <= 0 || x < 0 || y < 0) continue;
+        for (row = 0; row < h; ++row)
+        {
+            const BYTE *from = (const BYTE *)sl.pBits + (y + row) * sl.Pitch + x * bpp;
+            BYTE *to = (BYTE *)dl.pBits + (dy + row) * dl.Pitch + dx * bpp;
+            INT n = w * bpp, k;
+
+            switch (operation)
+            {
+            case D3DCOMPOSERECTS_COPY: memcpy(to, from, n); break;
+            case D3DCOMPOSERECTS_OR: for (k = 0; k < n; ++k) to[k] |= from[k]; break;
+            case D3DCOMPOSERECTS_AND: for (k = 0; k < n; ++k) to[k] &= from[k]; break;
+            default:
+#ifdef SG_MUTANT_COMPOSE_NEG
+                memcpy(to, from, n);
+#else
+                for (k = 0; k < n; ++k) to[k] = ~from[k];
+#endif
+                break;
+            }
+        }
+    }
+    IDirect3DSurface9_UnlockRect(dst_surface);
+    IDirect3DSurface9_UnlockRect(src_surface);
+done:
+    IDirect3DVertexBuffer9_Unlock(dst_descs);
+    IDirect3DVertexBuffer9_Unlock(src_descs);
+    return hr;
 }
 
 static HRESULT WINAPI DECLSPEC_HOTPATCH d3d9_device_PresentEx(IDirect3DDevice9Ex *iface,
