From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dbghelp: thread info, memory info and unloaded modules in minidumps (9550)

Crash reporters ask MiniDumpWriteDump for these (Breakpad: unloaded
modules and memory info; .NET's createdump and games' handlers: all
three), and Windows writes them; Wine wrote nothing:

- MiniDumpWithThreadInfo: ThreadInfoListStream -- for each thread the
  thread list holds, its create/exit/kernel/user times, its start
  address (the Win32 start routine), affinity and exit status, with
  MINIDUMP_THREAD_INFO_EXITED_THREAD / _INVALID_INFO as Windows sets
  them;
- MiniDumpWithFullMemoryInfo: MemoryInfoListStream -- every region of
  the address space as VirtualQueryEx reports it, free ones included,
  so a debugger can tell what an address was (image, mapped, private,
  reserved, its protection);
- MiniDumpWithUnloadedModules: UnloadedModuleListStream -- ntdll's
  unload event trace (base, size, checksum, timestamp, name), read from
  the target as Windows' dbghelp does: through RtlGetUnloadEventTraceEx
  of the dumper's own ntdll at the same offset in the target's (a crash
  in a DLL that was unloaded is otherwise unreadable). Entries are read
  with the element size the target reports. A target of the other
  bitness gets an empty list.

The MINIDUMP_THREAD_INFO_* flags join minidumpapiset.h.

Gate: test/dumpstreams-gate.sh (64- and 32-bit; the probe's own process
and a child process, each stream parsed by hand). Mutants
SG_MUTANT_NO_THREAD_INFO, SG_MUTANT_NO_MEMORY_INFO,
SG_MUTANT_NO_UNLOADED_STREAM, SG_MUTANT_NO_UNLOADED_MODULES
(dbghelp/minidump.c).
---
diff --git a/dlls/dbghelp/dbghelp_private.h b/dlls/dbghelp/dbghelp_private.h
--- a/dlls/dbghelp/dbghelp_private.h
+++ b/dlls/dbghelp/dbghelp_private.h
@@ -607,6 +607,7 @@ struct dump_thread
     ULONG                               tid;
     ULONG                               prio_class;
     ULONG                               curr_prio;
+    ULONG                               write_flags; /* what dump_threads wrote for it, 0 when left out */
 };
 
 struct dump_context
diff --git a/dlls/dbghelp/minidump.c b/dlls/dbghelp/minidump.c
--- a/dlls/dbghelp/minidump.c
+++ b/dlls/dbghelp/minidump.c
@@ -883,9 +883,13 @@ static  unsigned        dump_threads(struct dump_context* dc)
 
             cbout.ThreadWriteFlags = flags_out;
             if (!dc->cb->CallbackRoutine(dc->cb->CallbackParam, &cbin, &cbout))
+            {
+                dc->threads[i].write_flags = 0;
                 continue;
+            }
             flags_out &= cbout.ThreadWriteFlags;
         }
+        dc->threads[i].write_flags = (flags_out & ThreadWriteThread) ? flags_out : 0;
         if (flags_out & ThreadWriteThread)
         {
             if (ctx.ContextFlags && (flags_out & ThreadWriteContext))
@@ -1131,6 +1135,213 @@ static unsigned dump_handle_data(struct dump_context* dc)
     return sizeof(hdr) + hdr.NumberOfDescriptors * sizeof(desc);
 }
 
+
+/******************************************************************
+ *		dump_thread_info_list
+ *
+ * Stained Glass OS: MiniDumpWithThreadInfo -- each written thread's times,
+ * start address, affinity and exit status (ThreadInfoListStream), for the
+ * threads the thread list holds.
+ */
+static unsigned dump_thread_info_list(struct dump_context* dc)
+{
+    MINIDUMP_THREAD_INFO_LIST   hdr;
+    MINIDUMP_THREAD_INFO        info;
+    THREAD_BASIC_INFORMATION    tbi;
+    KERNEL_USER_TIMES           times;
+    ULONG_PTR                   start;
+    HANDLE                      thread;
+    unsigned                    i;
+
+    hdr.SizeOfHeader = sizeof(hdr);
+    hdr.SizeOfEntry = sizeof(info);
+    hdr.NumberOfEntries = 0;
+    for (i = 0; i < dc->num_threads; i++)
+        if (dc->threads[i].write_flags & ThreadWriteThreadInfo) hdr.NumberOfEntries++;
+    append(dc, &hdr, sizeof(hdr));
+
+    for (i = 0; i < dc->num_threads; i++)
+    {
+        if (!(dc->threads[i].write_flags & ThreadWriteThreadInfo)) continue;
+        memset(&info, 0, sizeof(info));
+        info.ThreadId = dc->threads[i].tid;
+        if (!(thread = OpenThread(THREAD_QUERY_INFORMATION, FALSE, dc->threads[i].tid)))
+        {
+            info.DumpFlags = MINIDUMP_THREAD_INFO_INVALID_INFO;
+            info.DumpError = HRESULT_FROM_WIN32(GetLastError());
+        }
+        else
+        {
+            if (!NtQueryInformationThread(thread, ThreadBasicInformation, &tbi, sizeof(tbi), NULL))
+            {
+                info.ExitStatus = tbi.ExitStatus;
+                info.Affinity = tbi.AffinityMask;
+                if (tbi.ExitStatus != STILL_ACTIVE) info.DumpFlags |= MINIDUMP_THREAD_INFO_EXITED_THREAD;
+            }
+            else info.DumpFlags |= MINIDUMP_THREAD_INFO_INVALID_INFO;
+            if (!NtQueryInformationThread(thread, ThreadTimes, &times, sizeof(times), NULL))
+            {
+                info.CreateTime = times.CreateTime.QuadPart;
+                info.ExitTime = times.ExitTime.QuadPart;
+                info.KernelTime = times.KernelTime.QuadPart;
+                info.UserTime = times.UserTime.QuadPart;
+            }
+            if (!NtQueryInformationThread(thread, ThreadQuerySetWin32StartAddress, &start, sizeof(start), NULL))
+                info.StartAddress = start;
+            CloseHandle(thread);
+        }
+        append(dc, &info, sizeof(info));
+    }
+    return sizeof(hdr) + hdr.NumberOfEntries * sizeof(info);
+}
+
+/******************************************************************
+ *		dump_memory_info_list
+ *
+ * Stained Glass OS: MiniDumpWithFullMemoryInfo -- every region of the
+ * address space as VirtualQueryEx reports it, free ones included
+ * (MemoryInfoListStream).
+ */
+static unsigned dump_memory_info_list(struct dump_context* dc)
+{
+    MINIDUMP_MEMORY_INFO_LIST   hdr;
+    MINIDUMP_MEMORY_INFO        info;
+    MEMORY_BASIC_INFORMATION    mbi;
+    RVA                         rva_base = dc->rva;
+    ULONG_PTR                   addr = 0;
+
+    hdr.SizeOfHeader = sizeof(hdr);
+    hdr.SizeOfEntry = sizeof(info);
+    hdr.NumberOfEntries = 0;
+    dc->rva += sizeof(hdr);
+    while (VirtualQueryEx(dc->process->handle, (LPCVOID)addr, &mbi, sizeof(mbi)))
+    {
+        memset(&info, 0, sizeof(info));
+        info.BaseAddress = (ULONG_PTR)mbi.BaseAddress;
+        info.AllocationBase = (ULONG_PTR)mbi.AllocationBase;
+        info.AllocationProtect = mbi.AllocationProtect;
+        info.RegionSize = mbi.RegionSize;
+        info.State = mbi.State;
+        info.Protect = mbi.Protect;
+        info.Type = mbi.Type;
+        append(dc, &info, sizeof(info));
+        hdr.NumberOfEntries++;
+        if ((ULONG_PTR)mbi.BaseAddress + mbi.RegionSize <= addr) break;
+        addr = (ULONG_PTR)mbi.BaseAddress + mbi.RegionSize;
+        if (!addr) break;
+    }
+    writeat(dc, rva_base, &hdr, sizeof(hdr));
+    return sizeof(hdr) + hdr.NumberOfEntries * sizeof(info);
+}
+
+/******************************************************************
+ *		dump_unloaded_modules
+ *
+ * Stained Glass OS: MiniDumpWithUnloadedModules -- the modules the process
+ * has unloaded, from ntdll's unload event trace (UnloadedModuleListStream).
+ * As on Windows the trace is found through RtlGetUnloadEventTraceEx in the
+ * dumper's own ntdll, at the same offset in the target's.
+ */
+/* an entry of ntdll's unload event trace (RtlGetUnloadEventTraceEx); later
+ * Windows versions add fields at the end, so entries are read with the
+ * element size the target reports */
+struct unload_event_trace
+{
+    void   *BaseAddress;
+    SIZE_T  SizeOfImage;
+    ULONG   Sequence;
+    ULONG   TimeDateStamp;
+    ULONG   CheckSum;
+    WCHAR   ImageName[32];
+};
+
+void WINAPI RtlGetUnloadEventTraceEx(ULONG **size, ULONG **count, void **trace);
+
+static unsigned dump_unloaded_modules(struct dump_context* dc)
+{
+    static const WCHAR ntdllW[] = L"ntdll.dll";
+    MINIDUMP_UNLOADED_MODULE_LIST   hdr;
+    MINIDUMP_UNLOADED_MODULE        mod;
+    struct unload_event_trace       trace[64];
+    ULONG                           *psize, *pcount, size = 0, count = 0, i;
+    char                            *raw;
+    void                            *ptrace, *array = NULL;
+    ULONG64                         local_base, remote_base = 0, delta;
+    RVA                             rva_base = dc->rva;
+    const WCHAR                     *name;
+    unsigned                        n, len;
+
+    hdr.SizeOfHeader = sizeof(hdr);
+    hdr.SizeOfEntry = sizeof(mod);
+    hdr.NumberOfEntries = 0;
+    dc->rva += sizeof(hdr);
+
+    for (i = 0; i < dc->num_modules; i++)
+    {
+        if (dc->modules[i].is_elf) continue;
+        name = wcsrchr(dc->modules[i].name, '\\');
+        name = name ? name + 1 : dc->modules[i].name;
+        if (!wcsicmp(name, ntdllW)) { remote_base = dc->modules[i].base; break; }
+    }
+    local_base = (ULONG_PTR)GetModuleHandleW(ntdllW);
+    /* the trace of the target's own bitness: the dumper's ntdll is the same image */
+#ifndef SG_MUTANT_NO_UNLOADED_MODULES
+    if (remote_base && local_base && dc->process->is_64bit == (sizeof(void*) == 8))
+    {
+        RtlGetUnloadEventTraceEx(&psize, &pcount, &ptrace);
+        delta = remote_base - local_base;
+        if (read_process_memory(dc->process, (ULONG_PTR)psize + delta, &size, sizeof(size)) &&
+            read_process_memory(dc->process, (ULONG_PTR)pcount + delta, &count, sizeof(count)) &&
+            read_process_memory(dc->process, (ULONG_PTR)ptrace + delta, &array, sizeof(array)) &&
+            array && size >= sizeof(trace[0]) && size <= 1024 && count && count <= ARRAY_SIZE(trace) &&
+            (raw = HeapAlloc(GetProcessHeap(), 0, count * size)))
+        {
+            if (read_process_memory(dc->process, (ULONG_PTR)array, raw, count * size))
+            {
+                for (i = 0; i < count; i++)
+                {
+                    memcpy(&trace[i], raw + i * size, sizeof(trace[i]));
+                    if (trace[i].BaseAddress) hdr.NumberOfEntries++;
+                }
+            }
+            else count = 0;
+            HeapFree(GetProcessHeap(), 0, raw);
+        }
+        else count = 0;
+    }
+#endif
+    /* the entries, then their names */
+    n = 0;
+    for (i = 0; i < count; i++)
+    {
+        if (!trace[i].BaseAddress) continue;
+        mod.BaseOfImage = (ULONG_PTR)trace[i].BaseAddress;
+        mod.SizeOfImage = trace[i].SizeOfImage;
+        mod.CheckSum = trace[i].CheckSum;
+        mod.TimeDateStamp = trace[i].TimeDateStamp;
+        mod.ModuleNameRva = 0;
+        writeat(dc, rva_base + sizeof(hdr) + n++ * sizeof(mod), &mod, sizeof(mod));
+    }
+    dc->rva = rva_base + sizeof(hdr) + n * sizeof(mod);
+    n = 0;
+    for (i = 0; i < count; i++)
+    {
+        ULONG ms_len;
+
+        if (!trace[i].BaseAddress) continue;
+        len = wcsnlen(trace[i].ImageName, ARRAY_SIZE(trace[i].ImageName));
+        ms_len = len * sizeof(WCHAR);
+        mod.ModuleNameRva = dc->rva;
+        append(dc, &ms_len, sizeof(ms_len));
+        append(dc, trace[i].ImageName, ms_len);
+        append(dc, L"", sizeof(WCHAR));
+        writeat(dc, rva_base + sizeof(hdr) + n++ * sizeof(mod) + FIELD_OFFSET(MINIDUMP_UNLOADED_MODULE, ModuleNameRva),
+                &mod.ModuleNameRva, sizeof(mod.ModuleNameRva));
+    }
+    writeat(dc, rva_base, &hdr, sizeof(hdr));
+    return sizeof(hdr) + hdr.NumberOfEntries * sizeof(mod);
+}
+
 /******************************************************************
  *		dump_memory64_info
  *
@@ -1212,6 +1423,8 @@ static DWORD CALLBACK write_minidump(void *_args)
 
     /* 1) init */
     nStreams = 7 + (dc->except_param ? 1 : 0) + ((dc->type & MiniDumpWithHandleData) ? 1 : 0) +
+        ((dc->type & MiniDumpWithThreadInfo) ? 1 : 0) + ((dc->type & MiniDumpWithFullMemoryInfo) ? 1 : 0) +
+        ((dc->type & MiniDumpWithUnloadedModules) ? 1 : 0) +
         (dc->user_stream ? dc->user_stream->UserStreamCount : 0);
 
     /* pad the directory size to a multiple of 4 for alignment purposes */
@@ -1276,6 +1489,37 @@ static DWORD CALLBACK write_minidump(void *_args)
     }
 #endif
 
+#ifndef SG_MUTANT_NO_THREAD_INFO
+    if (dc->type & MiniDumpWithThreadInfo)
+    {
+        mdDir.StreamType = ThreadInfoListStream;
+        mdDir.Location.Rva = dc->rva;
+        mdDir.Location.DataSize = dump_thread_info_list(dc);
+        writeat(dc, mdHead.StreamDirectoryRva + idx_stream++ * sizeof(mdDir),
+                &mdDir, sizeof(mdDir));
+    }
+#endif
+#ifndef SG_MUTANT_NO_UNLOADED_STREAM
+    if (dc->type & MiniDumpWithUnloadedModules)
+    {
+        mdDir.StreamType = UnloadedModuleListStream;
+        mdDir.Location.Rva = dc->rva;
+        mdDir.Location.DataSize = dump_unloaded_modules(dc);
+        writeat(dc, mdHead.StreamDirectoryRva + idx_stream++ * sizeof(mdDir),
+                &mdDir, sizeof(mdDir));
+    }
+#endif
+#ifndef SG_MUTANT_NO_MEMORY_INFO
+    if (dc->type & MiniDumpWithFullMemoryInfo)
+    {
+        mdDir.StreamType = MemoryInfoListStream;
+        mdDir.Location.Rva = dc->rva;
+        mdDir.Location.DataSize = dump_memory_info_list(dc);
+        writeat(dc, mdHead.StreamDirectoryRva + idx_stream++ * sizeof(mdDir),
+                &mdDir, sizeof(mdDir));
+    }
+#endif
+
     if (!(dc->type & MiniDumpWithFullMemory))
     {
         mdDir.StreamType = MemoryListStream;
diff --git a/include/minidumpapiset.h b/include/minidumpapiset.h
--- a/include/minidumpapiset.h
+++ b/include/minidumpapiset.h
@@ -412,6 +412,13 @@ typedef struct _MINIDUMP_HANDLE_DESCRIPTOR_2
     ULONG32 Reserved0;
 } MINIDUMP_HANDLE_DESCRIPTOR_2, *PMINIDUMP_HANDLE_DESCRIPTOR_2;
 
+#define MINIDUMP_THREAD_INFO_ERROR_THREAD    0x00000001
+#define MINIDUMP_THREAD_INFO_WRITING_THREAD  0x00000002
+#define MINIDUMP_THREAD_INFO_EXITED_THREAD   0x00000004
+#define MINIDUMP_THREAD_INFO_INVALID_INFO    0x00000008
+#define MINIDUMP_THREAD_INFO_INVALID_CONTEXT 0x00000010
+#define MINIDUMP_THREAD_INFO_INVALID_TEB     0x00000020
+
 typedef struct _MINIDUMP_THREAD_INFO
 {
     ULONG32 ThreadId;
