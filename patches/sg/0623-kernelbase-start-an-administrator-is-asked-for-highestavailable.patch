From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase, start: an administrator is asked for a highestAvailable program

A program whose manifest asks for the highest level available (NSIS
"RequestExecutionLevel highest": Geany's installer) ran as the invoker for
everyone. Windows asks an administrator for consent and runs it elevated;
Geany otherwise installed into the user's profile, unregistered. In an
administrator's session (SG_USER_ADMIN=1, from sg-session-start) it now needs
elevation like requireAdministrator; a standard user's still runs as the
user. And start (Wine's start.exe) ran programs with CreateProcess only: one
that needs an administrator failed with "could not be started"; it now goes
on to ShellExecuteEx, which asks, as Windows' start does.
---
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -703,10 +703,20 @@
  * Only where the elevation broker exists (sg-elevate), only for a caller that
  * is not elevated and has no linked token of its own to elevate with, and
  * never inside a program the broker started. highestAvailable runs as the
- * invoker, as it does for a standard user on Windows. */
+ * invoker for a standard user, as on Windows; in an administrator's session
+ * (SG_USER_ADMIN, set by sg-session-start for the administrators' group) it
+ * asks, as Windows asks an administrator: Geany's installer (NSIS "highest")
+ * otherwise installed into the user's profile, unregistered. */
+static BOOL sg_user_is_admin(void)
+{
+    WCHAR v[4];
+    return GetEnvironmentVariableW( L"SG_USER_ADMIN", v, ARRAY_SIZE(v) ) == 1 && v[0] == '1';
+}
+
 static BOOL sg_elevation_required( const WCHAR *app_name, HANDLE token )
 {
     static const char tag[] = "requestedexecutionlevel", level[] = "requireadministrator";
+    static const char highest[] = "highestavailable";
     HANDLE tok = token ? token : GetCurrentThreadEffectiveToken();
     TOKEN_ELEVATION_TYPE type;
     TOKEN_ELEVATION elevation;
@@ -766,6 +776,13 @@
                 for (j = 0; j < sizeof(level) - 1 && (xml[i + j] | 0x20) == level[j]; j++);
                 if (j == sizeof(level) - 1) ret = TRUE;
             }
+            if (in_tag && len - i >= sizeof(highest) - 1)
+            {
+                for (j = 0; j < sizeof(highest) - 1 && (xml[i + j] | 0x20) == highest[j]; j++);
+#ifndef SG_MUTANT_HIGHEST_INVOKER
+                if (j == sizeof(highest) - 1 && sg_user_is_admin()) ret = TRUE;
+#endif
+            }
         }
     }
     FreeLibrary( module );
--- a/programs/start/start.c
+++ b/programs/start/start.c
@@ -584,14 +584,19 @@
                     si.StartupInfo.dwFlags |= STARTF_USESHOWWINDOW;
                     si.StartupInfo.lpTitle = opts.title;
 
-                    if (!CreateProcessW( opts.sei.lpFile, commandline, NULL, NULL, opts.cp_inherit,
-                                         opts.creation_flags, NULL, opts.sei.lpDirectory,
-                                         &si.StartupInfo, &process_information ))
+                    if (CreateProcessW( opts.sei.lpFile, commandline, NULL, NULL, opts.cp_inherit,
+                                        opts.creation_flags, NULL, opts.sei.lpDirectory,
+                                        &si.StartupInfo, &process_information ))
                     {
-			fatal_string_error(STRING_EXECFAIL, GetLastError(), opts.sei.lpFile);
+                        opts.sei.hProcess = process_information.hProcess;
+                        goto done;
                     }
-                    opts.sei.hProcess = process_information.hProcess;
-                    goto done;
+                    /* Stained Glass OS: a program that needs an administrator
+                     * (ERROR_ELEVATION_REQUIRED) goes through ShellExecuteEx,
+                     * which asks for consent, as Windows' start does */
+                    if (GetLastError() != ERROR_ELEVATION_REQUIRED)
+                        fatal_string_error(STRING_EXECFAIL, GetLastError(), opts.sei.lpFile);
+                    free(commandline);
         }
 
         if (!ShellExecuteExW(&opts.sei))
