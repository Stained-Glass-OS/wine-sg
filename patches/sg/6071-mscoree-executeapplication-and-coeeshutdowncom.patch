From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscoree: ICLRRuntimeHost::ExecuteApplication and CoEEShutDownCOM (6071)

ExecuteApplication gave E_NOTIMPL. It runs a ClickOnce application that
is already in place: the manifest with an entry point names the program
and its parameters, which run in the default domain with the activation
data as further arguments; the exit code is returned. CoEEShutDownCOM was
a FIXME; with the runtime started it collects and runs the pending
finalizers, which releases the COM objects nothing references.
---
diff --git a/dlls/mscoree/corruntimehost.c b/dlls/mscoree/corruntimehost.c
index 3e954de..f023acc 100644
--- a/dlls/mscoree/corruntimehost.c
+++ b/dlls/mscoree/corruntimehost.c
@@ -20,6 +20,7 @@
 #define COBJMACROS
 
 #include <assert.h>
+#include <ctype.h>
 #include <stdarg.h>
 
 #include "windef.h"
@@ -1286,12 +1287,181 @@ static HRESULT WINAPI CLRRuntimeHost_GetCurrentAppDomainId(ICLRRuntimeHost* ifac
     *pdwAppDomainId = mono_domain_get_id(domain);
     return S_OK;
 }
+/* CoEEShutDownCOM: the COM objects held for managed code that nothing references any more are released, by a
+ * collection and the finalizers it queues. Mono keeps no list of its runtime callable wrappers, so those
+ * still referenced stay. */
+void RuntimeHost_ReleaseUnusedComObjects(RuntimeHost *host)
+{
+    MonoDomain *domain;
+    MonoObject *result;
+
+    if (FAILED(RuntimeHost_GetDefaultDomain(host, NULL, &domain))) return;
+#ifndef SG_MUTANT_EESHUTDOWN_NOTHING
+    RuntimeHost_Invoke(host, domain, NULL, "System", "GC", "Collect", NULL, NULL, 0, &result);
+    RuntimeHost_Invoke(host, domain, NULL, "System", "GC", "WaitForPendingFinalizers", NULL, NULL, 0, &result);
+#endif
+}
+
+/* the value of an attribute of the first element named tag (with or without a namespace prefix)
+ * after start in a manifest's text */
+static char *manifest_attr( const char *text, const char *tag, const char *attr )
+{
+    const char *p = text, *end, *a;
+    size_t taglen = strlen( tag ), attrlen = strlen( attr );
+
+    while ((p = strchr( p, '<' )))
+    {
+        const char *name = ++p, *colon;
+
+        while (*p && !isspace( (unsigned char)*p ) && *p != '>' && *p != '/') p++;
+        colon = memchr( name, ':', p - name );
+        if (colon) name = colon + 1;
+        if ((size_t)(p - name) != taglen || memcmp( name, tag, taglen )) continue;
+        if (!(end = strchr( p, '>' ))) return NULL;
+        for (a = p; a < end; a++)
+        {
+            char quote;
+            const char *v, *vend;
+            char *ret;
+
+            if (!isspace( (unsigned char)a[-1] ) || strncmp( a, attr, attrlen )) continue;
+            v = a + attrlen;
+            while (isspace( (unsigned char)*v )) v++;
+            if (*v++ != '=') continue;
+            while (isspace( (unsigned char)*v )) v++;
+            if ((quote = *v) != '"' && quote != '\'') continue;
+            if (!(vend = strchr( ++v, quote )) || vend > end) return NULL;
+            if ((ret = malloc( vend - v + 1 )))
+            {
+                memcpy( ret, v, vend - v );
+                ret[vend - v] = 0;
+            }
+            return ret;
+        }
+        return NULL;
+    }
+    return NULL;
+}
+
+static char *read_text_file( const WCHAR *path )
+{
+    HANDLE file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    DWORD size, read;
+    char *text = NULL;
+
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    if ((size = GetFileSize( file, NULL )) != INVALID_FILE_SIZE && size < 16 * 1024 * 1024 &&
+        (text = malloc( size + 1 )))
+    {
+        if (ReadFile( file, text, size, &read, NULL )) text[read] = 0;
+        else
+        {
+            free( text );
+            text = NULL;
+        }
+    }
+    CloseHandle( file );
+    return text;
+}
+
+/* A ClickOnce application: the manifest with an entry point names its program (commandLine file, relative
+ * to the manifest) and its parameters; the program runs in the default domain with the parameters and the
+ * activation data as its arguments, and its exit code is the return value. There is no deployment
+ * service here: the application must already be where its manifests say. */
 static HRESULT WINAPI CLRRuntimeHost_ExecuteApplication(ICLRRuntimeHost* iface,
     LPCWSTR pwzAppFullName, DWORD dwManifestPaths, LPCWSTR *ppwzManifestPaths,
     DWORD dwActivationData, LPCWSTR *ppwzActivationData, int *pReturnValue)
 {
-    FIXME("(%p,%s,%lu,%lu)\n", iface, debugstr_w(pwzAppFullName), dwManifestPaths, dwActivationData);
-    return E_NOTIMPL;
+    RuntimeHost *This = impl_from_ICLRRuntimeHost( iface );
+    char *text = NULL, *file = NULL, *params = NULL, *exeA = NULL, **argv = NULL, *p;
+    WCHAR exe[MAX_PATH], *slash;
+    MonoDomain *domain, *prev_domain;
+    MonoAssembly *assembly;
+    MonoImageOpenStatus status;
+    HRESULT hr;
+    DWORD i;
+    int argc = 0, ret, act_start = 0;
+
+    TRACE("(%p,%s,%lu,%p,%lu,%p,%p)\n", iface, debugstr_w(pwzAppFullName), dwManifestPaths, ppwzManifestPaths,
+          dwActivationData, ppwzActivationData, pReturnValue);
+
+    if (!pwzAppFullName || !pReturnValue) return E_POINTER;
+    if (!dwManifestPaths || !ppwzManifestPaths || (dwActivationData && !ppwzActivationData)) return E_INVALIDARG;
+
+    /* the application manifest is the one with the entry point (the deployment manifest comes first) */
+    for (i = 0; i < dwManifestPaths && !file; i++)
+    {
+        free( text );
+        if (!ppwzManifestPaths[i] || !(text = read_text_file( ppwzManifestPaths[i] ))) continue;
+        TRACE("manifest %s\n", debugstr_w(ppwzManifestPaths[i]));
+        if ((file = manifest_attr( text, "commandLine", "file" )))
+        {
+            params = manifest_attr( text, "commandLine", "parameters" );
+            lstrcpynW( exe, ppwzManifestPaths[i], MAX_PATH );
+        }
+    }
+    free( text );
+    if (!file)
+    {
+        WARN("no manifest names an entry point\n");
+        return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    }
+    /* the program is relative to its manifest */
+    for (p = file; *p; p++) if (*p == '/') *p = '\\';
+    if ((slash = wcsrchr( exe, '\\' ))) slash[1] = 0;
+    else exe[0] = 0;
+    i = wcslen( exe );
+    MultiByteToWideChar( CP_UTF8, 0, file, -1, exe + i, MAX_PATH - i );
+    free( file );
+    if (GetFileAttributesW( exe ) == INVALID_FILE_ATTRIBUTES)
+    {
+        WARN("%s is not there\n", debugstr_w(exe));
+        free( params );
+        return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    }
+
+    /* the program, its parameters (split at spaces), then the activation data */
+    if (!(argv = calloc( dwActivationData + 2 + (params ? strlen( params ) / 2 + 1 : 0), sizeof(*argv) )) ||
+        !(exeA = WtoA( exe )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    argv[argc++] = exeA;
+    for (p = params ? strtok( params, " \t" ) : NULL; p; p = strtok( NULL, " \t" )) argv[argc++] = p;
+    act_start = argc;
+    for (i = 0; i < dwActivationData; i++)
+        if (ppwzActivationData[i] && !(argv[argc++] = WtoA( ppwzActivationData[i] )))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+
+    if (FAILED(hr = RuntimeHost_GetDefaultDomain( This, NULL, &domain ))) goto done;
+    prev_domain = domain_attach( domain );
+    if (!(assembly = mono_assembly_open( exeA, &status )))
+    {
+        ERR("couldn't load %s, status=%d\n", debugstr_a(exeA), status);
+        hr = COR_E_BADIMAGEFORMAT;
+    }
+    else
+    {
+        ret = mono_jit_exec( domain, assembly, argc, argv );
+#ifdef SG_MUTANT_CLICKONCE_NO_EXIT_CODE
+        ret = 0;
+#endif
+        *pReturnValue = ret;
+        hr = S_OK;
+    }
+    domain_restore( prev_domain );
+
+done:
+    if (argv && act_start)
+        for (i = act_start; i < (DWORD)argc; i++) free( argv[i] );
+    free( argv );
+    free( exeA );
+    free( params );
+    return hr;
 }
 
 static HRESULT WINAPI CLRRuntimeHost_ExecuteInDefaultAppDomain(ICLRRuntimeHost* iface,
diff --git a/dlls/mscoree/metahost.c b/dlls/mscoree/metahost.c
index 0dbca0b..950b568 100644
--- a/dlls/mscoree/metahost.c
+++ b/dlls/mscoree/metahost.c
@@ -556,6 +556,19 @@ static HRESULT CLRRuntimeInfo_GetRuntimeHost(CLRRuntimeInfo *This, RuntimeHost *
     return hr;
 }
 
+/* the runtime this process started, if it did */
+RuntimeHost *get_started_runtime_host(void)
+{
+    RuntimeHost *host = NULL;
+    unsigned int i;
+
+    if (!is_mono_started || is_mono_shutdown) return NULL;
+    EnterCriticalSection(&runtime_list_cs);
+    for (i = 0; i < NUM_RUNTIMES && !host; i++) host = runtimes[i].loaded_runtime;
+    LeaveCriticalSection(&runtime_list_cs);
+    return host;
+}
+
 void expect_no_runtimes(void)
 {
     if (mono_handle && is_mono_started && !is_mono_shutdown)
diff --git a/dlls/mscoree/mscoree_main.c b/dlls/mscoree/mscoree_main.c
index 001a095..219330a 100644
--- a/dlls/mscoree/mscoree_main.c
+++ b/dlls/mscoree/mscoree_main.c
@@ -1074,7 +1074,10 @@ HRESULT WINAPI DllUnregisterServer(void)
 
 void WINAPI CoEEShutDownCOM(void)
 {
-    FIXME("stub.\n");
+    RuntimeHost *host = get_started_runtime_host();
+
+    TRACE("runtime %p\n", host);
+    if (host) RuntimeHost_ReleaseUnusedComObjects(host);
 }
 
 INT WINAPI ND_RU1( const void *ptr, INT offset )
diff --git a/dlls/mscoree/mscoree_private.h b/dlls/mscoree/mscoree_private.h
index 6cd4c4b..d9ef380 100644
--- a/dlls/mscoree/mscoree_private.h
+++ b/dlls/mscoree/mscoree_private.h
@@ -177,6 +177,8 @@ typedef enum {
 } MonoAotMode;
 
