+static HRESULT STDMETHODCALLTYPE d2d_bounds_sink_DrawRectangle(ID2D1CommandSink *iface, const D2D1_RECT_F *rect,
+        ID2D1Brush *brush, float stroke_width, ID2D1StrokeStyle *style)
+{
+    D2D1_RECT_F r = {min(rect->left, rect->right), min(rect->top, rect->bottom),
+            max(rect->left, rect->right), max(rect->top, rect->bottom)};
+
+    bounds_sink_add_local(impl_from_bounds_sink(iface), &r, stroke_margin(stroke_width, style));
+    return S_OK;
+}
