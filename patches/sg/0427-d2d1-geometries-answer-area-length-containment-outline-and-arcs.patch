+static HRESULT STDMETHODCALLTYPE d2d_bounds_sink_DrawImage(ID2D1CommandSink *iface, ID2D1Image *image,
+        const D2D1_POINT_2F *offset, const D2D1_RECT_F *image_rect, D2D1_INTERPOLATION_MODE mode,
+        D2D1_COMPOSITE_MODE composite)
+{
+    struct d2d_bounds_sink *sink = impl_from_bounds_sink(iface);
+    D2D1_RECT_L rect;
+    D2D1_RECT_F r;
+
+    if (FAILED(d2d_image_get_rect(image, 0, &rect)))
+        return S_OK;
+    d2d_rect_f_from_rect_l(&r, &rect, 1.0f, 1.0f);
+    if (image_rect)
+    {
+        r.left = max(r.left, image_rect->left);
+        r.top = max(r.top, image_rect->top);
+        r.right = min(r.right, image_rect->right);
+        r.bottom = min(r.bottom, image_rect->bottom);
+        /* the rectangle's top left goes to the offset */
+        r.right -= image_rect->left;
+        r.bottom -= image_rect->top;
+        r.left -= image_rect->left;
+        r.top -= image_rect->top;
+    }
+    if (r.left <= -FLT_MAX || r.top <= -FLT_MAX || r.right >= FLT_MAX || r.bottom >= FLT_MAX)
+    {
+        if (sink->clip_count)
+            bounds_sink_add(sink, &sink->clips[sink->clip_count - 1]);
+        else
+            sink->infinite = TRUE;
+        return S_OK;
+    }
+    if (offset)
+    {
+        r.left += offset->x;
+        r.right += offset->x;
+        r.top += offset->y;
+        r.bottom += offset->y;
+    }
+    bounds_sink_add_local(sink, &r, 0.0f);
+    return S_OK;
+}
