+/*
+ * What any geometry can answer once it is flattened to lines: its bounds,
+ * widened bounds, whether it (or its stroke) contains a point, its area,
+ * length, the point at a length, its outline and how it relates to another
+ * geometry. Each geometry type's own methods call these when they have no
+ * quicker answer. Areas and outlines go through the union of the geometry
+ * with itself (geometry_combine.c), which resolves self-overlap and the fill
+ * mode; strokes through Widen.
+ */
+
+#include "d2d1_private.h"
+
+
+struct flat_figure
+{
+    D2D1_POINT_2F *points;
+    size_t count, size;
+    BOOL closed;
+};
+
+struct flat_sink
+{
+    ID2D1SimplifiedGeometrySink ID2D1SimplifiedGeometrySink_iface;
+    struct flat_figure *figures;
+    size_t figure_count, figure_size;
+    D2D1_FILL_MODE fill_mode;
+    HRESULT hr;
+};
+
+static struct flat_sink *flat_from_sink(ID2D1SimplifiedGeometrySink *iface)
+{
+    return CONTAINING_RECORD(iface, struct flat_sink, ID2D1SimplifiedGeometrySink_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE flat_QueryInterface(ID2D1SimplifiedGeometrySink *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_ID2D1SimplifiedGeometrySink) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE flat_AddRef(ID2D1SimplifiedGeometrySink *iface)
+{
+    return 2;
+}
+
+static ULONG STDMETHODCALLTYPE flat_Release(ID2D1SimplifiedGeometrySink *iface)
+{
+    return 1;
+}
+
+static void STDMETHODCALLTYPE flat_SetFillMode(ID2D1SimplifiedGeometrySink *iface, D2D1_FILL_MODE mode)
+{
+    flat_from_sink(iface)->fill_mode = mode;
+}
+
+static void STDMETHODCALLTYPE flat_SetSegmentFlags(ID2D1SimplifiedGeometrySink *iface, D2D1_PATH_SEGMENT flags)
+{
+}
+
+static void flat_add_point(struct flat_sink *sink, D2D1_POINT_2F p)
+{
+    struct flat_figure *f;
+
+    if (!sink->figure_count)
+        return;
+    f = &sink->figures[sink->figure_count - 1];
+    if (f->count && f->points[f->count - 1].x == p.x && f->points[f->count - 1].y == p.y)
+        return;
+    if (!d2d_array_reserve((void **)&f->points, &f->size, f->count + 1, sizeof(*f->points)))
+    {
+        sink->hr = E_OUTOFMEMORY;
+        return;
+    }
+    f->points[f->count++] = p;
+}
+
+static void STDMETHODCALLTYPE flat_BeginFigure(ID2D1SimplifiedGeometrySink *iface,
+        D2D1_POINT_2F start, D2D1_FIGURE_BEGIN begin)
+{
+    struct flat_sink *sink = flat_from_sink(iface);
+
+    if (!d2d_array_reserve((void **)&sink->figures, &sink->figure_size, sink->figure_count + 1,
+            sizeof(*sink->figures)))
+    {
+        sink->hr = E_OUTOFMEMORY;
+        return;
+    }
+    memset(&sink->figures[sink->figure_count++], 0, sizeof(*sink->figures));
+    flat_add_point(sink, start);
+}
+
+static void STDMETHODCALLTYPE flat_AddLines(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_POINT_2F *points, UINT32 count)
+{
+    struct flat_sink *sink = flat_from_sink(iface);
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+        flat_add_point(sink, points[i]);
+}
+
+static void STDMETHODCALLTYPE flat_AddBeziers(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_BEZIER_SEGMENT *beziers, UINT32 count)
+{
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+        flat_AddLines(iface, &beziers[i].point3, 1);
+}
+
+static void STDMETHODCALLTYPE flat_EndFigure(ID2D1SimplifiedGeometrySink *iface, D2D1_FIGURE_END end)
+{
+    struct flat_sink *sink = flat_from_sink(iface);
+
+    if (sink->figure_count)
+        sink->figures[sink->figure_count - 1].closed = end == D2D1_FIGURE_END_CLOSED;
+}
+
+static HRESULT STDMETHODCALLTYPE flat_Close(ID2D1SimplifiedGeometrySink *iface)
+{
+    return S_OK;
+}
+
+static const ID2D1SimplifiedGeometrySinkVtbl flat_sink_vtbl =
+{
+    flat_QueryInterface,
+    flat_AddRef,
+    flat_Release,
+    flat_SetFillMode,
+    flat_SetSegmentFlags,
+    flat_BeginFigure,
+    flat_AddLines,
+    flat_AddBeziers,
+    flat_EndFigure,
+    flat_Close,
+};
+
+static void flat_init(struct flat_sink *sink)
+{
+    memset(sink, 0, sizeof(*sink));
+    sink->ID2D1SimplifiedGeometrySink_iface.lpVtbl = &flat_sink_vtbl;
+    sink->fill_mode = D2D1_FILL_MODE_ALTERNATE;
+}
+
+static void flat_cleanup(struct flat_sink *sink)
+{
+    size_t i;
+
+    for (i = 0; i < sink->figure_count; ++i)
+        free(sink->figures[i].points);
+    free(sink->figures);
+}
+
+static float fix_tolerance(float tolerance)
+{
+    return tolerance > 0.0f ? tolerance : D2D1_DEFAULT_FLATTENING_TOLERANCE;
+}
+
+static HRESULT flatten(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform, float tolerance,
+        struct flat_sink *sink)
+{
+    HRESULT hr;
+
+    flat_init(sink);
+    if (FAILED(hr = ID2D1Geometry_Simplify(geometry, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_LINES, transform,
+            fix_tolerance(tolerance), &sink->ID2D1SimplifiedGeometrySink_iface)))
+        return hr;
+    return sink->hr;
+}
+
+/* the geometry's union with itself: no overlaps, filled by its fill mode */
+static HRESULT flatten_filled(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform, float tolerance,
+        struct flat_sink *sink)
+{
+    ID2D1TransformedGeometry *transformed = NULL;
+    ID2D1Factory *factory;
+    HRESULT hr;
+
+    flat_init(sink);
+    if (transform)
+    {
+        ID2D1Geometry_GetFactory(geometry, &factory);
+        hr = ID2D1Factory_CreateTransformedGeometry(factory, geometry, transform, &transformed);
+        ID2D1Factory_Release(factory);
+        if (FAILED(hr))
+            return hr;
+        geometry = (ID2D1Geometry *)transformed;
+    }
+    hr = d2d_geometry_combine(geometry, geometry, D2D1_COMBINE_MODE_UNION, NULL, fix_tolerance(tolerance),
+            &sink->ID2D1SimplifiedGeometrySink_iface);
+    if (transformed)
+        ID2D1TransformedGeometry_Release(transformed);
+    return FAILED(hr) ? hr : sink->hr;
+}
+
+static void flat_bounds(const struct flat_sink *sink, D2D1_RECT_F *bounds)
+{
+    size_t i, j;
+
+    bounds->left = bounds->top = INFINITY;
+    bounds->right = bounds->bottom = -INFINITY;
+    for (i = 0; i < sink->figure_count; ++i)
+    {
+        for (j = 0; j < sink->figures[i].count; ++j)
+        {
+            const D2D1_POINT_2F *p = &sink->figures[i].points[j];
+
+            bounds->left = min(bounds->left, p->x);
+            bounds->top = min(bounds->top, p->y);
+            bounds->right = max(bounds->right, p->x);
+            bounds->bottom = max(bounds->bottom, p->y);
+        }
+    }
+    /* an empty geometry's bounds are inverted, as Direct2D reports them */
+}
+
+HRESULT d2d_geometry_ops_get_bounds(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform,
+        D2D1_RECT_F *bounds)
+{
+    struct flat_sink sink;
+    HRESULT hr;
+
+    if (!bounds)
+        return E_INVALIDARG;
+    if (SUCCEEDED(hr = flatten(geometry, transform, 0.01f, &sink)))
+        flat_bounds(&sink, bounds);
+    flat_cleanup(&sink);
+    return hr;
+}
+
+HRESULT d2d_geometry_ops_get_widened_bounds(ID2D1Geometry *geometry, float stroke_width,
+        ID2D1StrokeStyle *stroke_style, const D2D1_MATRIX_3X2_F *transform, float tolerance, D2D1_RECT_F *bounds)
+{
+    struct flat_sink sink;
+    HRESULT hr;
+
+    if (!bounds)
+        return E_INVALIDARG;
+    /* the stroke is widened in the geometry's space, then transformed */
+    flat_init(&sink);
+    hr = d2d_geometry_widen(geometry, stroke_width, stroke_style, NULL, fix_tolerance(tolerance),
+            &sink.ID2D1SimplifiedGeometrySink_iface);
+    if (SUCCEEDED(hr) && transform)
+    {
+        size_t i, j;
+
+        for (i = 0; i < sink.figure_count; ++i)
+        {
+            for (j = 0; j < sink.figures[i].count; ++j)
+            {
+                D2D1_POINT_2F p = sink.figures[i].points[j];
+
+                d2d_point_transform(&sink.figures[i].points[j], transform, p.x, p.y);
+            }
+        }
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = sink.hr))
+        flat_bounds(&sink, bounds);
+    flat_cleanup(&sink);
+    return hr;
+}
+
+/* winding number of the flattened figures around a point (every figure closed) */
+static int flat_winding(const struct flat_sink *sink, D2D1_POINT_2F p)
+{
+    int winding = 0;
+    size_t i, j;
+
+    for (i = 0; i < sink->figure_count; ++i)
+    {
+        const struct flat_figure *f = &sink->figures[i];
+
+        for (j = 0; j < f->count; ++j)
+        {
+            D2D1_POINT_2F a = f->points[j], b = f->points[(j + 1) % f->count];
+            float cross;
+
+            if (a.y <= p.y)
+            {
+                if (b.y > p.y && (cross = (b.x - a.x) * (p.y - a.y) - (p.x - a.x) * (b.y - a.y)) > 0.0f)
+                    ++winding;
+            }
+            else if (b.y <= p.y && (cross = (b.x - a.x) * (p.y - a.y) - (p.x - a.x) * (b.y - a.y)) < 0.0f)
+                --winding;
+        }
+    }
+    return winding;
+}
+
+static float segment_distance(D2D1_POINT_2F p, D2D1_POINT_2F a, D2D1_POINT_2F b)
+{
+    float dx = b.x - a.x, dy = b.y - a.y, len2 = dx * dx + dy * dy, t;
+
+    t = len2 > 0.0f ? ((p.x - a.x) * dx + (p.y - a.y) * dy) / len2 : 0.0f;
+    t = max(0.0f, min(1.0f, t));
+    dx = a.x + t * dx - p.x;
+    dy = a.y + t * dy - p.y;
+    return sqrtf(dx * dx + dy * dy);
+}
+
+/* inside the fill, or within the tolerance of its edge */
+static BOOL flat_contains(const struct flat_sink *sink, D2D1_POINT_2F p, D2D1_FILL_MODE mode, float tolerance)
+{
+    int winding = flat_winding(sink, p);
+    size_t i, j;
+
+    if (mode == D2D1_FILL_MODE_ALTERNATE ? (winding & 1) : winding)
+        return TRUE;
+    for (i = 0; i < sink->figure_count; ++i)
+    {
+        const struct flat_figure *f = &sink->figures[i];
+
+        for (j = 0; j < f->count; ++j)
+        {
+            if (segment_distance(p, f->points[j], f->points[(j + 1) % f->count]) <= tolerance)
+                return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+HRESULT d2d_geometry_ops_fill_contains_point(ID2D1Geometry *geometry, D2D1_POINT_2F point,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, BOOL *contains)
+{
+    struct flat_sink sink;
+    HRESULT hr;
+
+    if (!contains)
+        return E_INVALIDARG;
+    *contains = FALSE;
+    if (SUCCEEDED(hr = flatten(geometry, transform, tolerance, &sink)))
+        *contains = flat_contains(&sink, point, sink.fill_mode, fix_tolerance(tolerance));
+    flat_cleanup(&sink);
+    return hr;
+}
+
+HRESULT d2d_geometry_ops_stroke_contains_point(ID2D1Geometry *geometry, D2D1_POINT_2F point, float stroke_width,
+        ID2D1StrokeStyle *stroke_style, const D2D1_MATRIX_3X2_F *transform, float tolerance, BOOL *contains)
+{
+    D2D1_MATRIX_3X2_F inverse;
+    struct flat_sink sink;
+    HRESULT hr;
+
+    if (!contains)
+        return E_INVALIDARG;
+    *contains = FALSE;
+    /* the point back in the geometry's space, where the stroke is widened */
+    if (transform)
+    {
+        if (!d2d_matrix_invert(&inverse, transform))
+            return S_OK;
+        d2d_point_transform(&point, &inverse, point.x, point.y);
+    }
+    flat_init(&sink);
+    if (SUCCEEDED(hr = d2d_geometry_widen(geometry, stroke_width, stroke_style, NULL, fix_tolerance(tolerance),
+            &sink.ID2D1SimplifiedGeometrySink_iface)) && SUCCEEDED(hr = sink.hr))
+        *contains = flat_contains(&sink, point, D2D1_FILL_MODE_WINDING, fix_tolerance(tolerance));
+    flat_cleanup(&sink);
+    return hr;
+}
+
+static double flat_area(const struct flat_sink *sink)
+{
+    double area = 0.0, a;
+    size_t i, j;
+
+    for (i = 0; i < sink->figure_count; ++i)
+    {
+        const struct flat_figure *f = &sink->figures[i];
+
+        for (a = 0.0, j = 0; j < f->count; ++j)
+        {
+            D2D1_POINT_2F p = f->points[j], q = f->points[(j + 1) % f->count];
+
+            a += (double)p.x * q.y - (double)q.x * p.y;
+        }
+        area += fabs(a) / 2.0;
+    }
+    return area;
+}
+
+HRESULT d2d_geometry_ops_compute_area(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform, float tolerance,
+        float *area)
+{
+    struct flat_sink sink;
+    HRESULT hr;
+
+    if (!area)
+        return E_INVALIDARG;
+    *area = 0.0f;
+    if (SUCCEEDED(hr = flatten_filled(geometry, transform, tolerance, &sink)))
+        *area = flat_area(&sink);
+    flat_cleanup(&sink);
+    return hr;
+}
+
+/* the segments of a figure, the closing one included when it is closed */
+static size_t figure_segment_count(const struct flat_figure *f)
+{
+    if (f->count < 2)
+        return 0;
+    return f->closed ? f->count : f->count - 1;
+}
+
+HRESULT d2d_geometry_ops_compute_length(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform,
+        float tolerance, float *length)
+{
+    struct flat_sink sink;
+    double total = 0.0;
+    size_t i, j;
+    HRESULT hr;
+
+    if (!length)
+        return E_INVALIDARG;
+    *length = 0.0f;
+    if (SUCCEEDED(hr = flatten(geometry, transform, tolerance, &sink)))
+    {
+        for (i = 0; i < sink.figure_count; ++i)
+        {
+            const struct flat_figure *f = &sink.figures[i];
+
+            for (j = 0; j < figure_segment_count(f); ++j)
+            {
+                D2D1_POINT_2F a = f->points[j], b = f->points[(j + 1) % f->count];
+
+                total += sqrt((double)(b.x - a.x) * (b.x - a.x) + (double)(b.y - a.y) * (b.y - a.y));
+            }
+        }
+        *length = total;
+    }
+    flat_cleanup(&sink);
+    return hr;
+}
+
+HRESULT d2d_geometry_ops_compute_point_at_length(ID2D1Geometry *geometry, float length,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, D2D1_POINT_2F *point, D2D1_POINT_2F *tangent)
+{
+    D2D1_POINT_2F last_point = {0}, last_tangent = {1.0f, 0.0f};
+    struct flat_sink sink;
+    BOOL found = FALSE, any = FALSE;
+    double left = max(length, 0.0f);
+    size_t i, j;
+    HRESULT hr;
+
+    if (FAILED(hr = flatten(geometry, transform, tolerance, &sink)))
+        goto done;
+    for (i = 0; i < sink.figure_count && !found; ++i)
+    {
+        const struct flat_figure *f = &sink.figures[i];
+
+        for (j = 0; j < figure_segment_count(f) && !found; ++j)
+        {
+            D2D1_POINT_2F a = f->points[j], b = f->points[(j + 1) % f->count];
+            double dx = b.x - a.x, dy = b.y - a.y, d = sqrt(dx * dx + dy * dy);
+
+            if (d <= 0.0)
+                continue;
+            any = TRUE;
+            last_tangent.x = dx / d;
+            last_tangent.y = dy / d;
+            if (left <= d)
+            {
+                last_point.x = a.x + dx * (left / d);
+                last_point.y = a.y + dy * (left / d);
+                found = TRUE;
+            }
+            else
+            {
+                left -= d;
+                last_point = b;
+            }
+        }
+    }
+    /* beyond the end: the end point */
+    if (!any)
+        hr = D2DERR_BAD_NUMBER;
+    else
+    {
+        if (point) *point = last_point;
+        if (tangent) *tangent = last_tangent;
+    }
+done:
+    flat_cleanup(&sink);
+    return hr;
+}
+
+HRESULT d2d_geometry_ops_outline(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform, float tolerance,
+        ID2D1SimplifiedGeometrySink *out)
+{
+    struct flat_sink sink;
+    size_t i;
+    HRESULT hr;
+
+    if (!out)
+        return E_INVALIDARG;
+    if (SUCCEEDED(hr = flatten_filled(geometry, transform, tolerance, &sink)))
+    {
+        ID2D1SimplifiedGeometrySink_SetFillMode(out, D2D1_FILL_MODE_WINDING);
+        for (i = 0; i < sink.figure_count; ++i)
+        {
+            const struct flat_figure *f = &sink.figures[i];
+
+            if (f->count < 3)
+                continue;
+            ID2D1SimplifiedGeometrySink_BeginFigure(out, f->points[0], D2D1_FIGURE_BEGIN_FILLED);
+            ID2D1SimplifiedGeometrySink_AddLines(out, f->points + 1, f->count - 1);
+            ID2D1SimplifiedGeometrySink_EndFigure(out, D2D1_FIGURE_END_CLOSED);
+        }
+    }
+    flat_cleanup(&sink);
+    return hr;
+}
+
+HRESULT d2d_geometry_ops_compare(ID2D1Geometry *geometry, ID2D1Geometry *other, const D2D1_MATRIX_3X2_F *transform,
+        float tolerance, D2D1_GEOMETRY_RELATION *relation)
+{
+    struct flat_sink sink;
+    float area_this, area_other, area_both;
+    double epsilon;
+    HRESULT hr;
+
+    if (!relation || !other)
+        return E_INVALIDARG;
+    *relation = D2D1_GEOMETRY_RELATION_UNKNOWN;
+    if (FAILED(hr = d2d_geometry_ops_compute_area(geometry, NULL, tolerance, &area_this))
+            || FAILED(hr = d2d_geometry_ops_compute_area(other, transform, tolerance, &area_other)))
+        return hr;
+    flat_init(&sink);
+    if (FAILED(hr = d2d_geometry_combine(geometry, other, D2D1_COMBINE_MODE_INTERSECT, transform,
+            fix_tolerance(tolerance), &sink.ID2D1SimplifiedGeometrySink_iface)) || FAILED(hr = sink.hr))
+    {
+        flat_cleanup(&sink);
+        return hr;
+    }
+    area_both = flat_area(&sink);
+    flat_cleanup(&sink);
+
+    epsilon = max(1e-3, 0.001 * max(area_this, area_other));
+    if (area_both <= epsilon)
+        *relation = D2D1_GEOMETRY_RELATION_DISJOINT;
+    else if (fabs(area_both - area_this) <= epsilon)
+        *relation = D2D1_GEOMETRY_RELATION_IS_CONTAINED;
+    else if (fabs(area_both - area_other) <= epsilon)
+        *relation = D2D1_GEOMETRY_RELATION_CONTAINS;
+    else
+        *relation = D2D1_GEOMETRY_RELATION_OVERLAP;
+    return S_OK;
+}
