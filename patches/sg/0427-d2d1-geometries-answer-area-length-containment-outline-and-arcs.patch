+static HRESULT STDMETHODCALLTYPE d2d_bounds_sink_DrawGlyphRun(ID2D1CommandSink *iface, D2D1_POINT_2F origin,
+        const DWRITE_GLYPH_RUN *run, const DWRITE_GLYPH_RUN_DESCRIPTION *desc, ID2D1Brush *brush,
+        DWRITE_MEASURING_MODE mode)
+{
+    struct d2d_bounds_sink *sink = impl_from_bounds_sink(iface);
+    float advance = 0.0f, em = run->fontEmSize;
+    D2D1_RECT_F r;
+    UINT32 i;
+
+    /* the advances and an em above and below the baseline, generously */
+    for (i = 0; i < run->glyphCount; ++i)
+        advance += run->glyphAdvances ? fabsf(run->glyphAdvances[i]) : em;
+    r.left = origin.x - em;
+    r.right = origin.x + advance + em;
+    r.top = origin.y - 1.5f * em;
+    r.bottom = origin.y + em;
+    bounds_sink_add_local(sink, &r, 0.0f);
+    return S_OK;
+}
+
+static float stroke_margin(float stroke_width, ID2D1StrokeStyle *style)
+{
+    float m = fabsf(stroke_width) / 2.0f;
+
+    /* miter joins can reach out further */
+    if (style && ID2D1StrokeStyle_GetLineJoin(style) == D2D1_LINE_JOIN_MITER)
+        m *= max(1.0f, ID2D1StrokeStyle_GetMiterLimit(style));
+    else
+        m *= 1.5f;
+    return m;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_bounds_sink_DrawLine(ID2D1CommandSink *iface, D2D1_POINT_2F p0,
+        D2D1_POINT_2F p1, ID2D1Brush *brush, float stroke_width, ID2D1StrokeStyle *style)
+{
+    D2D1_RECT_F r = {min(p0.x, p1.x), min(p0.y, p1.y), max(p0.x, p1.x), max(p0.y, p1.y)};
+
+    bounds_sink_add_local(impl_from_bounds_sink(iface), &r, stroke_margin(stroke_width, style));
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_bounds_sink_DrawGeometry(ID2D1CommandSink *iface, ID2D1Geometry *geometry,
+        ID2D1Brush *brush, float stroke_width, ID2D1StrokeStyle *style)
+{
+    struct d2d_bounds_sink *sink = impl_from_bounds_sink(iface);
+    D2D1_RECT_F r;
+
+    if (SUCCEEDED(ID2D1Geometry_GetBounds(geometry, NULL, &r)))
+        bounds_sink_add_local(sink, &r, stroke_margin(stroke_width, style));
+    else
+        sink->infinite = TRUE;
+    return S_OK;
+}
