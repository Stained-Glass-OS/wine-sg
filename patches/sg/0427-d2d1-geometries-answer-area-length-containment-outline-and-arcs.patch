+/* A command list's bounds: what its drawing covers, in its own space (the
+ * space it was recorded in, in DIPs), as GetImageLocalBounds reports and
+ * effects that take it as an input need. Clear covers everything. */
+struct d2d_bounds_sink
+{
+    ID2D1CommandSink ID2D1CommandSink_iface;
+    D2D1_MATRIX_3X2_F transform;
+    D2D1_RECT_F bounds;
+    D2D1_RECT_F clips[64];
+    unsigned int clip_count;
+    BOOL infinite;
+};
+
+static inline struct d2d_bounds_sink *impl_from_bounds_sink(ID2D1CommandSink *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_bounds_sink, ID2D1CommandSink_iface);
+}
+
+static void bounds_sink_add(struct d2d_bounds_sink *sink, const D2D1_RECT_F *world)
+{
+    D2D1_RECT_F r = *world;
+    unsigned int i;
+
+    if (!(r.left < r.right) || !(r.top < r.bottom))
+        return;
+    for (i = 0; i < sink->clip_count; ++i)
+    {
+        r.left = max(r.left, sink->clips[i].left);
+        r.top = max(r.top, sink->clips[i].top);
+        r.right = min(r.right, sink->clips[i].right);
+        r.bottom = min(r.bottom, sink->clips[i].bottom);
+    }
+    if (!(r.left < r.right) || !(r.top < r.bottom))
+        return;
+    if (sink->bounds.left >= sink->bounds.right)
+        sink->bounds = r;
+    else
+    {
+        sink->bounds.left = min(sink->bounds.left, r.left);
+        sink->bounds.top = min(sink->bounds.top, r.top);
+        sink->bounds.right = max(sink->bounds.right, r.right);
+        sink->bounds.bottom = max(sink->bounds.bottom, r.bottom);
+    }
+}
+
+/* a rectangle in the current space, grown by a margin there, into the list's space */
+static void bounds_sink_add_local(struct d2d_bounds_sink *sink, const D2D1_RECT_F *local, float margin)
+{
+    const D2D1_MATRIX_3X2_F *m = &sink->transform;
+    float x[4], y[4];
+    D2D1_RECT_F r;
+    unsigned int i;
+
+    x[0] = x[2] = local->left - margin;
+    x[1] = x[3] = local->right + margin;
+    y[0] = y[1] = local->top - margin;
+    y[2] = y[3] = local->bottom + margin;
+    r.left = r.top = FLT_MAX;
+    r.right = r.bottom = -FLT_MAX;
+    for (i = 0; i < 4; ++i)
+    {
+        float tx = x[i] * m->_11 + y[i] * m->_21 + m->_31, ty = x[i] * m->_12 + y[i] * m->_22 + m->_32;
+
+        r.left = min(r.left, tx);
+        r.top = min(r.top, ty);
+        r.right = max(r.right, tx);
+        r.bottom = max(r.bottom, ty);
+    }
+    bounds_sink_add(sink, &r);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_bounds_sink_QueryInterface(ID2D1CommandSink *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_ID2D1CommandSink) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
