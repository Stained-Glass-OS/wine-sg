+static HRESULT STDMETHODCALLTYPE d2d_bounds_sink_PushAxisAlignedClip(ID2D1CommandSink *iface,
+        const D2D1_RECT_F *rect, D2D1_ANTIALIAS_MODE mode)
+{
+    struct d2d_bounds_sink *sink = impl_from_bounds_sink(iface);
+    struct d2d_bounds_sink tmp = *sink;
+
+    if (sink->clip_count >= ARRAY_SIZE(sink->clips))
+        return S_OK;
+    /* the clip's rectangle as it lands in the list's space */
+    tmp.clip_count = 0;
+    tmp.bounds.left = tmp.bounds.right = 0.0f;
+    bounds_sink_add_local(&tmp, rect, 0.0f);
+    if (tmp.bounds.left >= tmp.bounds.right)
+        tmp.bounds.left = tmp.bounds.right = tmp.bounds.top = tmp.bounds.bottom = 0.0f;
+    sink->clips[sink->clip_count++] = tmp.bounds;
+    return S_OK;
+}
