+static HRESULT STDMETHODCALLTYPE d2d_bounds_sink_Clear(ID2D1CommandSink *iface, const D2D1_COLOR_F *color)
+{
+    struct d2d_bounds_sink *sink = impl_from_bounds_sink(iface);
+
+    if (sink->clip_count)
+    {
+        D2D1_RECT_F all = {-FLT_MAX, -FLT_MAX, FLT_MAX, FLT_MAX};
+        bounds_sink_add(sink, &all);
+    }
+    else
+        sink->infinite = TRUE;
+    return S_OK;
+}
