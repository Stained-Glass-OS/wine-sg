+static HRESULT STDMETHODCALLTYPE d2d_bounds_sink_DrawBitmap(ID2D1CommandSink *iface, ID2D1Bitmap *bitmap,
+        const D2D1_RECT_F *dst_rect, float opacity, D2D1_INTERPOLATION_MODE mode, const D2D1_RECT_F *src_rect,
+        const D2D1_MATRIX_4X4_F *perspective)
+{
+    D2D1_SIZE_F size = ID2D1Bitmap_GetSize(bitmap);
+    D2D1_RECT_F r = {0.0f, 0.0f, size.width, size.height};
+
+    if (dst_rect)
+    {
+        r.left = min(dst_rect->left, dst_rect->right);
+        r.top = min(dst_rect->top, dst_rect->bottom);
+        r.right = max(dst_rect->left, dst_rect->right);
+        r.bottom = max(dst_rect->top, dst_rect->bottom);
+    }
+    else if (src_rect)
+    {
+        r.right = src_rect->right - src_rect->left;
+        r.bottom = src_rect->bottom - src_rect->top;
+    }
+    bounds_sink_add_local(impl_from_bounds_sink(iface), &r, 0.0f);
+    return S_OK;
+}
