From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 00:59:48 -0700
Subject: [PATCH] vbscript: Cannot use parentheses when calling a Sub (error
 1044)

A call statement with several arguments in parentheses reports error 1044 at
the end of the statement instead of a plain failure at the start. The error
position test of run.c passes now (its todo mark is removed).

diff --git a/dlls/vbscript/parser.y b/dlls/vbscript/parser.y
index 66a9ac8..259dc74 100644
--- a/dlls/vbscript/parser.y
+++ b/dlls/vbscript/parser.y
@@ -739,8 +739,18 @@ static call_expression_t *make_call_expression(parser_ctx_t *ctx, expression_t *
     }
 
     if(call_expr->args->next) {
-        FIXME("Invalid syntax: invalid use of parentheses for arguments\n");
+        const WCHAR *end = ctx->ptr;
+
+        /* Cannot use parentheses when calling a Sub: reported at the end of the statement */
+        WARN("Invalid syntax: invalid use of parentheses for arguments\n");
+        while(end > ctx->code && (end[-1] == '\n' || end[-1] == '\r'))
+            end--;
+        ctx->error_loc = end - ctx->code;
+#ifdef SG_MUTANT_VB_NOPARENS
         ctx->hres = E_FAIL;
+#else
+        ctx->hres = MAKE_VBSERROR(VBSE_CANT_USE_PARENS);
+#endif
         return NULL;
     }
 
diff --git a/dlls/vbscript/tests/run.c b/dlls/vbscript/tests/run.c
index 91ab207..fc154ee 100644
--- a/dlls/vbscript/tests/run.c
+++ b/dlls/vbscript/tests/run.c
@@ -2716,7 +2716,7 @@ static void test_parse_errors(void)
         {
             /* invalid use of parentheses for call statement */
             L"strcomp(\"x\", \"y\")",
-            0, -17
+            0, 17
         },
         {
             L"\n\n\n  cint _\n   throwInt(&h80001234&)",
@@ -2783,8 +2783,7 @@ static void test_parse_errors(void)
 
         ok(error_line == invalid_scripts[i].error_line, "[%u] error line %lu expected %u\n",
            i, error_line, invalid_scripts[i].error_line);
-        todo_wine_if(invalid_scripts[i].error_char < 0)
-        ok(error_char == abs(invalid_scripts[i].error_char), "[%u] error char %ld expected %d\n",
+        ok(error_char == invalid_scripts[i].error_char, "[%u] error char %ld expected %d\n",
            i, error_char, invalid_scripts[i].error_char);
     }
 }
diff --git a/dlls/vbscript/vbscript.rc b/dlls/vbscript/vbscript.rc
index 3ee4ffb..1dc496a 100644
--- a/dlls/vbscript/vbscript.rc
+++ b/dlls/vbscript/vbscript.rc
@@ -61,6 +61,7 @@ STRINGTABLE
     VBSE_UNQUALIFIED_REFERENCE         "Invalid or unqualified reference"
     VBSE_SYNTAX_ERROR                  "Syntax error"
     VBSE_NAME_REDEFINED                "Name redefined"
+    VBSE_CANT_USE_PARENS               "Cannot use parentheses when calling a Sub"
 
     VBS_COMPILE_ERROR                  "Microsoft VBScript compilation error"
     VBS_RUNTIME_ERROR                  "Microsoft VBScript runtime error"
diff --git a/dlls/vbscript/vbscript_defs.h b/dlls/vbscript/vbscript_defs.h
index 7b27bc4..061a6da 100644
--- a/dlls/vbscript/vbscript_defs.h
+++ b/dlls/vbscript/vbscript_defs.h
@@ -272,6 +272,7 @@
 #define VBSE_UNQUALIFIED_REFERENCE        505
 #define VBSE_SYNTAX_ERROR                1002
 #define VBSE_NAME_REDEFINED              1041
+#define VBSE_CANT_USE_PARENS             1044
 
 #define VBS_COMPILE_ERROR                4096
 #define VBS_RUNTIME_ERROR                4097
