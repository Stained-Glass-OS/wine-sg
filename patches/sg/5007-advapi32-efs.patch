From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: Answer EFS calls for a file system that cannot encrypt.

EncryptFile, DecryptFile and FileEncryptionStatus (A and W) answer for a file
system that cannot encrypt, which is what Unix file systems are here.
FileEncryptionStatus says FILE_SYSTEM_NOT_SUPPORT and fails for a file that
does not exist; EncryptFile fails with ERROR_VOLUME_NOT_SUPPORT_EFS instead of
claiming success; DecryptFile of a plain file succeeds, but like Windows it
needs the file to itself and fails on a read-only one. The A functions go
through the W ones. The stubs claimed every call worked.

Gate: test/advapi32-efs-gate.sh (64/32).
---
 dlls/advapi32/security.c | 103 +++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 90 insertions(+), 13 deletions(-)

diff --git a/dlls/advapi32/security.c b/dlls/advapi32/security.c
index 9e4a22d..8cac0d6 100644
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -3457,12 +3457,56 @@ DWORD WINAPI GetNamedSecurityInfoExA( LPCSTR object, SE_OBJECT_TYPE type,
     return ERROR_CALL_NOT_IMPLEMENTED;
 }
 
+/* Unix file systems have no EFS: no file is ever encrypted. */
+
+static WCHAR *efs_name_AtoW( const char *name )
+{
+    UNICODE_STRING str;
+
+    if (!name) return NULL;
+    if (!RtlCreateUnicodeStringFromAsciiz( &str, name ))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return (WCHAR *)~(ULONG_PTR)0;
+    }
+    return str.Buffer;
+}
+
+static void efs_free_name( WCHAR *name )
+{
+    if (name && name != (WCHAR *)~(ULONG_PTR)0) HeapFree( GetProcessHeap(), 0, name );
+}
+
 /******************************************************************************
  * DecryptFileW [ADVAPI32.@]
+ *
+ * The file is not encrypted, which succeeds; like Windows it still needs the
+ * file for itself and fails on a read-only one.
  */
 BOOL WINAPI DecryptFileW(LPCWSTR lpFileName, DWORD dwReserved)
 {
-    FIXME("(%s, %08lx): stub\n", debugstr_w(lpFileName), dwReserved);
+    DWORD attrs;
+    HANDLE file;
+
+    TRACE("(%s, %08lx)\n", debugstr_w(lpFileName), dwReserved);
+
+    if (!lpFileName)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if ((attrs = GetFileAttributesW( lpFileName )) == INVALID_FILE_ATTRIBUTES) return FALSE;
+#ifndef SG_MUTANT_EFS_DECRYPT_NO_CHECKS
+    if (attrs & FILE_ATTRIBUTE_READONLY)
+    {
+        SetLastError( ERROR_FILE_READ_ONLY );
+        return FALSE;
+    }
+    file = CreateFileW( lpFileName, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING,
+                        FILE_FLAG_BACKUP_SEMANTICS, NULL );
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    CloseHandle( file );
+#endif
     return TRUE;
 }
 
@@ -3471,17 +3515,36 @@ BOOL WINAPI DecryptFileW(LPCWSTR lpFileName, DWORD dwReserved)
  */
 BOOL WINAPI DecryptFileA(LPCSTR lpFileName, DWORD dwReserved)
 {
-    FIXME("(%s, %08lx): stub\n", debugstr_a(lpFileName), dwReserved);
-    return TRUE;
+    WCHAR *nameW = efs_name_AtoW( lpFileName );
+    BOOL ret;
+
+    if (nameW == (WCHAR *)~(ULONG_PTR)0) return FALSE;
+    ret = DecryptFileW( nameW, dwReserved );
+    efs_free_name( nameW );
+    return ret;
 }
 
 /******************************************************************************
  * EncryptFileW [ADVAPI32.@]
+ *
+ * The file system cannot encrypt (see FileEncryptionStatusW).
  */
 BOOL WINAPI EncryptFileW(LPCWSTR lpFileName)
 {
-    FIXME("(%s): stub\n", debugstr_w(lpFileName));
+    TRACE("(%s)\n", debugstr_w(lpFileName));
+
+    if (!lpFileName)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (GetFileAttributesW( lpFileName ) == INVALID_FILE_ATTRIBUTES) return FALSE;
+#ifndef SG_MUTANT_EFS_ENCRYPT_SUCCEEDS
+    SetLastError( ERROR_VOLUME_NOT_SUPPORT_EFS );
+    return FALSE;
+#else
     return TRUE;
+#endif
 }
 
 /******************************************************************************
@@ -3489,8 +3552,13 @@ BOOL WINAPI EncryptFileW(LPCWSTR lpFileName)
  */
 BOOL WINAPI EncryptFileA(LPCSTR lpFileName)
 {
-    FIXME("(%s): stub\n", debugstr_a(lpFileName));
-    return TRUE;
+    WCHAR *nameW = efs_name_AtoW( lpFileName );
+    BOOL ret;
+
+    if (nameW == (WCHAR *)~(ULONG_PTR)0) return FALSE;
+    ret = EncryptFileW( nameW );
+    efs_free_name( nameW );
+    return ret;
 }
 
 /******************************************************************************
@@ -3498,9 +3566,16 @@ BOOL WINAPI EncryptFileA(LPCSTR lpFileName)
  */
 BOOL WINAPI FileEncryptionStatusW(LPCWSTR lpFileName, LPDWORD lpStatus)
 {
-    FIXME("(%s %p): stub\n", debugstr_w(lpFileName), lpStatus);
-    if (!lpStatus)
+    TRACE("(%s %p)\n", debugstr_w(lpFileName), lpStatus);
+
+    if (!lpFileName || !lpStatus)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
         return FALSE;
+    }
+#ifndef SG_MUTANT_EFS_STATUS_NO_FILE_CHECK
+    if (GetFileAttributesW( lpFileName ) == INVALID_FILE_ATTRIBUTES) return FALSE;
+#endif
     *lpStatus = FILE_SYSTEM_NOT_SUPPORT;
     return TRUE;
 }
@@ -3510,11 +3585,13 @@ BOOL WINAPI FileEncryptionStatusW(LPCWSTR lpFileName, LPDWORD lpStatus)
  */
 BOOL WINAPI FileEncryptionStatusA(LPCSTR lpFileName, LPDWORD lpStatus)
 {
-    FIXME("(%s %p): stub\n", debugstr_a(lpFileName), lpStatus);
-    if (!lpStatus)
-        return FALSE;
-    *lpStatus = FILE_SYSTEM_NOT_SUPPORT;
-    return TRUE;
+    WCHAR *nameW = efs_name_AtoW( lpFileName );
+    BOOL ret;
+
+    if (nameW == (WCHAR *)~(ULONG_PTR)0) return FALSE;
+    ret = FileEncryptionStatusW( nameW, lpStatus );
+    efs_free_name( nameW );
+    return ret;
 }
 
 /* No file is encrypted (FileEncryptionStatus: the file system has no
