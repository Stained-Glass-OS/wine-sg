+                memset(pb.buf + off, 0, slot_size);
+                break;
+            case SLOT_PROPVARIANT:
+                if(!(elem = array_append((void **)&pk->rgPROPVARIANT, &pk->cPROPVARIANT, sizeof(PROPVARIANT)))) { hr = E_OUTOFMEMORY; break; }
+                if(deep) hr = PropVariantCopy(elem, (PROPVARIANT *)(src_row + b[i].obValue));
+                else memcpy(elem, src_row + b[i].obValue, sizeof(PROPVARIANT));
