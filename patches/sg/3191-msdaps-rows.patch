+/* ICommand::Execute with parameters.
+ *
+ * DBPARAMS holds cParamSets rows of parameter data in the layout of an accessor's bindings. The rows
+ * travel as one RMTPACK: the bytes of the rows (and the data that value slots point to, appended after
+ * them) are the first BSTR of rgBSTR, and every slot that holds an owned pointer (BSTR, VARIANT,
+ * PROPVARIANT, IUnknown, IDispatch, SAFEARRAY, or any BYREF data) holds the 1-based position of its
+ * content in the pack's arrays instead (BYREF data: 1 + offset into the bytes). The row stride
+ * travels in ulGuidOffset. Output and input/output parameters come back the same way in pOutputParams. */
+
+#define PARAM_IO_IN  1
+#define PARAM_IO_OUT 2
+
+enum slot_kind { SLOT_NONE, SLOT_BSTR, SLOT_VARIANT, SLOT_PROPVARIANT, SLOT_UNKNOWN, SLOT_DISPATCH, SLOT_ARRAY,
+                 SLOT_BYREF, SLOT_VECTOR };
+
+static size_t dbtype_fixed_size(DBTYPE type)
+{
+    switch(type)
+    {
+    case DBTYPE_I1: case DBTYPE_UI1: return 1;
+    case DBTYPE_I2: case DBTYPE_UI2: case DBTYPE_BOOL: return 2;
+    case DBTYPE_I4: case DBTYPE_UI4: case DBTYPE_R4: case DBTYPE_ERROR: return 4;
+    case DBTYPE_I8: case DBTYPE_UI8: case DBTYPE_R8: case DBTYPE_CY: case DBTYPE_DATE: case DBTYPE_FILETIME: return 8;
+    case DBTYPE_DECIMAL: return sizeof(DECIMAL);
+    case DBTYPE_GUID: return sizeof(GUID);
+    case DBTYPE_NUMERIC: return sizeof(DB_NUMERIC);
+    case DBTYPE_DBDATE: return sizeof(DBDATE);
+    case DBTYPE_DBTIME: return sizeof(DBTIME);
+    case DBTYPE_DBTIMESTAMP: return sizeof(DBTIMESTAMP);
+    case DBTYPE_HCHAPTER: return sizeof(HCHAPTER);
+    case DBTYPE_VARIANT: return sizeof(VARIANT);
+    case DBTYPE_PROPVARIANT: return sizeof(PROPVARIANT);
+    case DBTYPE_BSTR: case DBTYPE_IUNKNOWN: case DBTYPE_IDISPATCH: return sizeof(void *);
+    default: return 0;
+    }
+}
+
+static enum slot_kind binding_slot_kind(DBTYPE type)
+{
+    if(type & DBTYPE_BYREF) return SLOT_BYREF;
+    if(type & DBTYPE_ARRAY) return SLOT_ARRAY;
+    if(type & DBTYPE_VECTOR) return SLOT_VECTOR;
+    switch(type)
+    {
+    case DBTYPE_BSTR: return SLOT_BSTR;
+    case DBTYPE_VARIANT: return SLOT_VARIANT;
+    case DBTYPE_PROPVARIANT: return SLOT_PROPVARIANT;
+    case DBTYPE_IUNKNOWN: return SLOT_UNKNOWN;
+    case DBTYPE_IDISPATCH: return SLOT_DISPATCH;
+    default: return SLOT_NONE;
+    }
+}
+
+/* size of the value slot of a binding in the row */
+static size_t binding_slot_size(const DBBINDING *b)
+{
+    DBTYPE t = b->wType;
+
+    if(t & (DBTYPE_BYREF | DBTYPE_ARRAY)) return sizeof(void *);
+    if(t & DBTYPE_VECTOR) return sizeof(DBVECTOR);
+    switch(t)
+    {
+    case DBTYPE_STR: case DBTYPE_WSTR: case DBTYPE_BYTES: case DBTYPE_VARNUMERIC: case DBTYPE_UDT:
+        return b->cbMaxLen;
+    default:
+        return dbtype_fixed_size(t);
+    }
+}
+
+static BOOL binding_in_io(const DBBINDING *b, DWORD io)
+{
+    DWORD have = b->eParamIO ? b->eParamIO : DBPARAMIO_INPUT;
+    return (have & io) != 0;
+}
+
+static size_t bindings_row_extent(const DBBINDING *b, DBCOUNTITEM n)
+{
+    size_t extent = 0, end;
+    DBCOUNTITEM i;
+
+    for(i = 0; i < n; i++)
+    {
+        if((b[i].dwPart & DBPART_STATUS) && (end = b[i].obStatus + sizeof(DBSTATUS)) > extent) extent = end;
+        if((b[i].dwPart & DBPART_LENGTH) && (end = b[i].obLength + sizeof(DBLENGTH)) > extent) extent = end;
+        if((b[i].dwPart & DBPART_VALUE) && (end = b[i].obValue + binding_slot_size(&b[i])) > extent) extent = end;
+    }
+    return extent;
+}
+
+/* the row sizes the accessors were created with: the stride between parameter sets cannot be got back
+   from the provider */
+static struct { HACCESSOR handle; DBLENGTH row_size; } accessor_sizes[64];
+static CRITICAL_SECTION accessor_sizes_cs;
+static CRITICAL_SECTION_DEBUG accessor_sizes_cs_debug =
+{
+    0, 0, &accessor_sizes_cs, { &accessor_sizes_cs_debug.ProcessLocksList, &accessor_sizes_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": accessor_sizes_cs") }
+};
+static CRITICAL_SECTION accessor_sizes_cs = { &accessor_sizes_cs_debug, -1, 0, 0, 0, 0 };
+
+static void remember_accessor_size(HACCESSOR handle, DBLENGTH row_size)
+{
+    unsigned int i, free_slot = ~0u;
+
+    EnterCriticalSection(&accessor_sizes_cs);
+    for(i = 0; i < ARRAY_SIZE(accessor_sizes); i++)
+    {
+        if(accessor_sizes[i].handle == handle) { free_slot = i; break; }
+        if(!accessor_sizes[i].handle && free_slot == ~0u) free_slot = i;
+    }
+    if(free_slot != ~0u)
+    {
+        accessor_sizes[free_slot].handle = handle;
+        accessor_sizes[free_slot].row_size = row_size;
+    }
+    LeaveCriticalSection(&accessor_sizes_cs);
+}
+
+static void forget_accessor_size(HACCESSOR handle)
+{
+    unsigned int i;
+
+    EnterCriticalSection(&accessor_sizes_cs);
+    for(i = 0; i < ARRAY_SIZE(accessor_sizes); i++)
+        if(accessor_sizes[i].handle == handle) accessor_sizes[i].handle = 0;
+    LeaveCriticalSection(&accessor_sizes_cs);
+}
+
+static DBLENGTH recalled_accessor_size(HACCESSOR handle)
+{
+    DBLENGTH ret = 0;
+    unsigned int i;
+
+    EnterCriticalSection(&accessor_sizes_cs);
+    for(i = 0; i < ARRAY_SIZE(accessor_sizes); i++)
+        if(accessor_sizes[i].handle == handle) ret = accessor_sizes[i].row_size;
+    LeaveCriticalSection(&accessor_sizes_cs);
+    return ret;
+}
+
+/* the number of bytes a BYREF or VECTOR slot's data takes, 0 when there is no data */
+static HRESULT byref_data_size(const DBBINDING *b, const BYTE *row, const void *ptr, size_t *size)
+{
+    DBTYPE base = b->wType & ~(DBTYPE_BYREF | DBTYPE_VECTOR | DBTYPE_ARRAY);
+    DBLENGTH len = 0;
+    BOOL have_len = (b->dwPart & DBPART_LENGTH) != 0;
+
+    if(have_len) memcpy(&len, row + b->obLength, sizeof(len));
+    switch(base)
+    {
+    case DBTYPE_STR:
+        *size = have_len ? len + 1 : strlen(ptr) + 1;
+        return S_OK;
+    case DBTYPE_WSTR:
+        *size = have_len ? len + sizeof(WCHAR) : (lstrlenW(ptr) + 1) * sizeof(WCHAR);
+#ifdef SG_MUTANT_MSD_BYREF_LEN
+        *size -= sizeof(WCHAR);
+#endif
+        return S_OK;
+    case DBTYPE_BYTES: case DBTYPE_VARNUMERIC: case DBTYPE_UDT:
+        if(!have_len) return DB_E_BADBINDINFO;
+        *size = len;
+        return S_OK;
+    default:
+        *size = dbtype_fixed_size(base);
+        return *size ? S_OK : DB_E_BADBINDINFO;
+    }
+}
+
+struct pack_builder
+{
+    BYTE *buf;
+    size_t len, cap;
+    RMTPACK *pk;
+    BOOL deep;
+};
+
+static void *array_append(void **arr, ULONG *count, size_t elem)
+{
+    void *p = CoTaskMemRealloc(*arr, (*count + 1) * elem);
+
+    if(!p) return NULL;
+    *arr = p;
+    memset((BYTE *)p + *count * elem, 0, elem);
+    return (BYTE *)p + (*count)++ * elem;
+}
+
+static HRESULT builder_append_data(struct pack_builder *pb, const void *data, size_t size, ULONG_PTR *off)
+{
+    if(pb->len + size > pb->cap)
+    {
+        size_t cap = max(pb->cap * 2, pb->len + size);
+        BYTE *p = CoTaskMemRealloc(pb->buf, cap);
+        if(!p) return E_OUTOFMEMORY;
+        pb->buf = p;
+        pb->cap = cap;
+    }
+    memcpy(pb->buf + pb->len, data, size);
+    *off = pb->len;
+    pb->len += size;
+    return S_OK;
+}
+
+static void free_pack(RMTPACK *pk, BOOL deep)
+{
+    ULONG i;
+
+    if(deep)
+    {
+        for(i = 1; i < pk->cBSTR; i++) SysFreeString(pk->rgBSTR[i]);
+        for(i = 0; i < pk->cVARIANT; i++) VariantClear(&pk->rgVARIANT[i]);
+        for(i = 0; i < pk->cArray; i++) VariantClear(&pk->rgArray[i]);
+        for(i = 0; i < pk->cPROPVARIANT; i++) PropVariantClear(&pk->rgPROPVARIANT[i]);
+        for(i = 0; i < pk->cIUNKNOWN; i++) if(pk->rgIUNKNOWN[i]) IUnknown_Release(pk->rgIUNKNOWN[i]);
+        for(i = 0; i < pk->cIDISPATCH; i++) if(pk->rgIDISPATCH[i]) IDispatch_Release(pk->rgIDISPATCH[i]);
+    }
+    if(pk->cBSTR) SysFreeString(pk->rgBSTR[0]);
+    CoTaskMemFree(pk->rgBSTR);
+    CoTaskMemFree(pk->rgVARIANT);
+    CoTaskMemFree(pk->rgIDISPATCH);
+    CoTaskMemFree(pk->rgIUNKNOWN);
+    CoTaskMemFree(pk->rgPROPVARIANT);
+    CoTaskMemFree(pk->rgArray);
+    memset(pk, 0, sizeof(*pk));
+}
+
+/* Packs the rows. Slots of bindings that don't go the way io says are zeroed. With deep the pack owns
