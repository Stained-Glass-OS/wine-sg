+static HRESULT pack_bookmarks(DBCOUNTITEM count, const DBBKMARK rgcb[], const BYTE *ptrs[], ULONG *len, BYTE **out)
+{
+    ULONG_PTR total = 0, off = 0;
+    DBCOUNTITEM i;
+    BYTE *buf;
+
+    for(i = 0; i < count; i++)
+    {
+        if(rgcb[i] && !ptrs[i]) return E_INVALIDARG;
+        if(rgcb[i] > 0x7fffffff || total + rgcb[i] > 0x7fffffff) return E_INVALIDARG;
+        total += rgcb[i];
+    }
+
+    buf = CoTaskMemAlloc(total ? total : 1);
+    if(!buf) return E_OUTOFMEMORY;
+    for(i = 0; i < count; i++)
+    {
+        if(rgcb[i]) memcpy(buf + off, ptrs[i], rgcb[i]);
+#ifndef SG_MUTANT_MSD_BM_OFFSET
+        off += rgcb[i];
+#endif
+    }
+    *len = total;
+    *out = buf;
+    return S_OK;
+}
