+                    idx = pk->cIUNKNOWN;
+                }
+                else
+                {
+                    if(!(elem = array_append((void **)&pk->rgIDISPATCH, &pk->cIDISPATCH, sizeof(IDispatch *)))) { hr = E_OUTOFMEMORY; break; }
