+                if(!(elem = array_append((void **)&pk->rgArray, &pk->cArray, sizeof(VARIANT)))) { hr = E_OUTOFMEMORY; break; }
+                V_VT((VARIANT *)elem) = VT_ARRAY | (b[i].wType & VT_TYPEMASK);
+                if(deep) hr = SafeArrayCopy(sa, &V_ARRAY((VARIANT *)elem));
+                else V_ARRAY((VARIANT *)elem) = sa;
+                idx = pk->cArray;
+                break;
+            }
+            case SLOT_BYREF:
+            {
+                const void *ptr;
+                size_t size;
+                ULONG_PTR where = 0;
+                memcpy(&ptr, src_row + b[i].obValue, sizeof(ptr));
+                if(!ptr) break;
+                hr = byref_data_size(&b[i], src_row, ptr, &size);
+                if(SUCCEEDED(hr)) hr = builder_append_data(&pb, ptr, size, &where);
+                idx = where + 1;
+                break;
+            }
+            case SLOT_VECTOR:
+            {
+                DBVECTOR vec;
+                DBTYPE base = b[i].wType & ~DBTYPE_VECTOR;
+                size_t size = dbtype_fixed_size(base);
+                ULONG_PTR where;
+                memcpy(&vec, src_row + b[i].obValue, sizeof(vec));
+                if(!vec.ptr || !vec.size) break;
+                if(!size || base == DBTYPE_BSTR || base == DBTYPE_VARIANT || base == DBTYPE_PROPVARIANT ||
+                   base == DBTYPE_IUNKNOWN || base == DBTYPE_IDISPATCH)
+                {
+                    FIXME("vector of type %04x in a parameter\n", base);
+                    hr = DB_E_BADBINDINFO;
+                    break;
+                }
+                hr = builder_append_data(&pb, vec.ptr, vec.size * size, &where);
+                idx = where + 1;
+                break;
+            }
+            default:
+                break;
+            }
+            if(FAILED(hr)) break;
+
+            if(kind == SLOT_VECTOR)
+            {
+                DBVECTOR vec;
+                memcpy(&vec, src_row + b[i].obValue, sizeof(vec));
+                vec.ptr = (void *)idx;
+                memcpy(pb.buf + off, &vec, sizeof(vec));
+            }
+            else if(kind == SLOT_VARIANT || kind == SLOT_PROPVARIANT)
+                memcpy(pb.buf + off, &idx, sizeof(idx));
+            else
+                memcpy(pb.buf + off, &idx, sizeof(idx));
+        }
+    }
+
+    if(SUCCEEDED(hr))
+    {
+        /* the slot positions in the pack refer to the arrays; BSTR 0 holds the bytes */
+        first = &pk->rgBSTR[0];
+        *first = SysAllocStringByteLen((const char *)pb.buf, pb.len);
+        if(!*first) hr = E_OUTOFMEMORY;
+        pk->cbData = pb.len;
+    }
+    CoTaskMemFree(pb.buf);
+    if(FAILED(hr)) free_pack(pk, deep);
+    return hr;
+}
+
+static size_t bounded_strlen(const BYTE *p, size_t max)
+{
+    size_t n = 0;
+    while(n < max && p[n]) n++;
+    return n;
+}
+
+static size_t bounded_wcslen(const BYTE *p, size_t max)
+{
+    size_t n = 0;
+    WCHAR c;
+    while((n + 1) * sizeof(WCHAR) <= max)
+    {
+        memcpy(&c, p + n * sizeof(WCHAR), sizeof(c));
+        if(!c) break;
+        n++;
+    }
+    return n;
+}
+
+/* Reads the content that a slot of the packed rows stands for into a fresh allocation. */
+static HRESULT unpack_slot(const DBBINDING *b, const RMTPACK *pk, const BYTE *packed, size_t packed_len,
+                           const BYTE *slot, BYTE *out)
+{
+    enum slot_kind kind = binding_slot_kind(b->wType);
+    ULONG_PTR idx;
+    HRESULT hr = S_OK;
+
+    if(kind == SLOT_VECTOR)
+    {
+        DBVECTOR vec;
+        memcpy(&vec, slot, sizeof(vec));
+        idx = (ULONG_PTR)vec.ptr;
+    }
+    else
+        memcpy(&idx, slot, sizeof(idx));
+
+    if(!idx)
+    {
+        memset(out, 0, binding_slot_size(b));
+        return S_OK;
+    }
+
+    switch(kind)
+    {
+    case SLOT_BSTR:
+    {
+        BSTR str;
+        if(idx >= pk->cBSTR) return E_INVALIDARG;
+        str = SysAllocStringByteLen((const char *)pk->rgBSTR[idx], SysStringByteLen(pk->rgBSTR[idx]));
+        if(!str) return E_OUTOFMEMORY;
+        memcpy(out, &str, sizeof(str));
+        break;
+    }
+    case SLOT_VARIANT:
+        if(idx > pk->cVARIANT) return E_INVALIDARG;
+        VariantInit((VARIANT *)out);
+        hr = VariantCopy((VARIANT *)out, &pk->rgVARIANT[idx - 1]);
+        break;
+    case SLOT_PROPVARIANT:
+        if(idx > pk->cPROPVARIANT) return E_INVALIDARG;
+        PropVariantInit((PROPVARIANT *)out);
+        hr = PropVariantCopy((PROPVARIANT *)out, &pk->rgPROPVARIANT[idx - 1]);
+        break;
+    case SLOT_UNKNOWN:
+        if(idx > pk->cIUNKNOWN) return E_INVALIDARG;
+        if(pk->rgIUNKNOWN[idx - 1]) IUnknown_AddRef(pk->rgIUNKNOWN[idx - 1]);
+        memcpy(out, &pk->rgIUNKNOWN[idx - 1], sizeof(IUnknown *));
+        break;
+    case SLOT_DISPATCH:
+        if(idx > pk->cIDISPATCH) return E_INVALIDARG;
+        if(pk->rgIDISPATCH[idx - 1]) IDispatch_AddRef(pk->rgIDISPATCH[idx - 1]);
+        memcpy(out, &pk->rgIDISPATCH[idx - 1], sizeof(IDispatch *));
+        break;
+    case SLOT_ARRAY:
+    {
+        SAFEARRAY *sa = NULL;
+        if(idx > pk->cArray) return E_INVALIDARG;
+        if(V_ARRAY(&pk->rgArray[idx - 1])) hr = SafeArrayCopy(V_ARRAY(&pk->rgArray[idx - 1]), &sa);
+        memcpy(out, &sa, sizeof(sa));
+        break;
+    }
+    case SLOT_BYREF: case SLOT_VECTOR:
+    {
+        size_t size, off = idx - 1;
+        void *copy;
+        if(kind == SLOT_BYREF)
+        {
+            /* the size comes from the bytes themselves: a string ends with its terminator, and the other
+               types are as long as the length part says; the row the length part is in is the one
+               this slot is in */
+            DBTYPE base = b->wType & ~DBTYPE_BYREF;
+            if(base == DBTYPE_STR) size = off < packed_len ? bounded_strlen(packed + off, packed_len - off) + 1 : 0;
+            else if(base == DBTYPE_WSTR)
+                size = off < packed_len ? (bounded_wcslen(packed + off, packed_len - off) + 1) * sizeof(WCHAR) : 0;
+            else if(base == DBTYPE_BYTES || base == DBTYPE_VARNUMERIC || base == DBTYPE_UDT)
+            {
+                DBLENGTH len = 0;
+                if(b->dwPart & DBPART_LENGTH) memcpy(&len, slot - b->obValue + b->obLength, sizeof(len));
+                size = len;
+            }
+            else
+                size = dbtype_fixed_size(base);
+        }
+        else
+        {
+            DBVECTOR vec;
+            memcpy(&vec, slot, sizeof(vec));
+            size = vec.size * dbtype_fixed_size(b->wType & ~DBTYPE_VECTOR);
+        }
+        if(off > packed_len || size > packed_len - off) return E_INVALIDARG;
+        copy = CoTaskMemAlloc(size ? size : 1);
+        if(!copy) return E_OUTOFMEMORY;
+        memcpy(copy, packed + off, size);
+        if(kind == SLOT_VECTOR)
+        {
+            DBVECTOR vec;
+            memcpy(&vec, slot, sizeof(vec));
+            vec.ptr = copy;
+            memcpy(out, &vec, sizeof(vec));
+        }
+        else
+            memcpy(out, &copy, sizeof(copy));
+        break;
+    }
+    default:
+        break;
+    }
+    return hr;
+}
+
+/* Releases what the slots of the rows that go the way io says own. */
+static void free_param_slots(const DBBINDING *b, DBCOUNTITEM nb, BYTE *data, size_t stride, DBCOUNTITEM nsets, DWORD io)
+{
+    DBCOUNTITEM s, i;
+
+    for(s = 0; s < nsets; s++)
+    {
+        for(i = 0; i < nb; i++)
+        {
+            enum slot_kind kind = binding_slot_kind(b[i].wType);
+            BYTE *slot = data + s * stride + b[i].obValue;
+
+            if(kind == SLOT_NONE || !(b[i].dwPart & DBPART_VALUE) || !binding_in_io(&b[i], io)) continue;
+            switch(kind)
+            {
+            case SLOT_BSTR: { BSTR str; memcpy(&str, slot, sizeof(str)); SysFreeString(str); break; }
+            case SLOT_VARIANT: VariantClear((VARIANT *)slot); break;
+            case SLOT_PROPVARIANT: PropVariantClear((PROPVARIANT *)slot); break;
+            case SLOT_UNKNOWN: case SLOT_DISPATCH:
+            {
+                IUnknown *unk;
+                memcpy(&unk, slot, sizeof(unk));
+                if(unk) IUnknown_Release(unk);
+                break;
+            }
+            case SLOT_ARRAY: { SAFEARRAY *sa; memcpy(&sa, slot, sizeof(sa)); if(sa) SafeArrayDestroy(sa); break; }
+            case SLOT_BYREF: { void *p; memcpy(&p, slot, sizeof(p)); CoTaskMemFree(p); break; }
+            case SLOT_VECTOR: { DBVECTOR v; memcpy(&v, slot, sizeof(v)); CoTaskMemFree(v.ptr); break; }
+            default: break;
+            }
+            memset(slot, 0, binding_slot_size(&b[i]));
+        }
+    }
+}
+
+/* Unpacks into dest. With whole every byte of the rows is copied (dest is a new buffer) and the slots
+   that go the way io says get fresh allocations; otherwise only the status, length and value of the
+   bindings that go the way io says are replaced (dest is the caller's data). */
+static HRESULT unpack_params(const DBBINDING *b, DBCOUNTITEM nb, const RMTPACK *pk, size_t stride, DBCOUNTITEM nsets,
+                             DWORD io, BOOL whole, BYTE *dest)
+{
+    const BYTE *packed;
+    size_t packed_len;
+    DBCOUNTITEM s, i;
+    HRESULT hr = S_OK;
+
+    if(!pk->cBSTR || !pk->rgBSTR[0]) return E_INVALIDARG;
+    packed = (const BYTE *)pk->rgBSTR[0];
+    packed_len = SysStringByteLen(pk->rgBSTR[0]);
+    if(stride * nsets > packed_len) return E_INVALIDARG;
+    if(whole) memcpy(dest, packed, stride * nsets);
+
+    for(s = 0; SUCCEEDED(hr) && s < nsets; s++)
+    {
+        const BYTE *src_row = packed + s * stride;
+        BYTE *dst_row = dest + s * stride;
+
+        for(i = 0; SUCCEEDED(hr) && i < nb; i++)
+        {
+            enum slot_kind kind = binding_slot_kind(b[i].wType);
+
+            if(!binding_in_io(&b[i], io)) continue;
+            if(!whole)
+            {
+                if(b[i].dwPart & DBPART_STATUS) memcpy(dst_row + b[i].obStatus, src_row + b[i].obStatus, sizeof(DBSTATUS));
+                if(b[i].dwPart & DBPART_LENGTH) memcpy(dst_row + b[i].obLength, src_row + b[i].obLength, sizeof(DBLENGTH));
+                if((b[i].dwPart & DBPART_VALUE) && kind == SLOT_NONE)
+                    memcpy(dst_row + b[i].obValue, src_row + b[i].obValue, binding_slot_size(&b[i]));
+            }
+            if(kind != SLOT_NONE && (b[i].dwPart & DBPART_VALUE))
+                hr = unpack_slot(&b[i], pk, packed, packed_len, src_row + b[i].obValue, dst_row + b[i].obValue);
+        }
+    }
+    return hr;
+}
