+    for(s = 0; SUCCEEDED(hr) && s < nsets; s++)
+    {
+        for(i = 0; SUCCEEDED(hr) && i < nb; i++)
+        {
+            enum slot_kind kind = binding_slot_kind(b[i].wType);
+            const BYTE *src_row = data + s * stride;
+            size_t off = s * stride + b[i].obValue, slot_size = binding_slot_size(&b[i]);
+            ULONG_PTR idx = 0;
+            void *elem;
