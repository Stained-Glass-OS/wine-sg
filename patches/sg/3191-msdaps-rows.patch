+/* An object the server hands back for a rowset it created from a provider object (GetSourceRowset,
+   GetReferencedRowset): it marshals as a new rowset server around that object. */
+typedef struct
+{
+    IUnknown IUnknown_iface;
+    LONG ref;
+    IWineRowServer *server;
+    IMarshal *marshal;
+    IUnknown *inner;
+} wrapped_rowset;
+
+static inline wrapped_rowset *impl_from_wrapped(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, wrapped_rowset, IUnknown_iface);
+}
+
+static HRESULT WINAPI wrapped_QueryInterface(IUnknown *iface, REFIID riid, void **obj)
+{
+    wrapped_rowset *This = impl_from_wrapped(iface);
+
+    *obj = NULL;
+    if(IsEqualIID(riid, &IID_IUnknown))
+        *obj = iface;
+    else if(IsEqualIID(riid, &IID_IMarshal))
+        *obj = This->marshal;
+    else
+        return IUnknown_QueryInterface(This->inner, riid, obj);
+
+    IUnknown_AddRef((IUnknown *)*obj);
+    return S_OK;
+}
+
+static ULONG WINAPI wrapped_AddRef(IUnknown *iface)
+{
+    wrapped_rowset *This = impl_from_wrapped(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI wrapped_Release(IUnknown *iface)
+{
+    wrapped_rowset *This = impl_from_wrapped(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref)
+    {
+        IMarshal_Release(This->marshal);
+        IWineRowServer_Release(This->server);
+        IUnknown_Release(This->inner);
+        HeapFree(GetProcessHeap(), 0, This);
+    }
+    return ref;
+}
+
+static const IUnknownVtbl wrapped_vtbl = { wrapped_QueryInterface, wrapped_AddRef, wrapped_Release };
+
+/* Checks that rowset supports riid, then returns an object that marshals as a rowset server for it. */
+static HRESULT wrap_rowset(IUnknown *rowset, REFIID riid, IUnknown **out)
+{
+    wrapped_rowset *w;
+    IUnknown *check;
+    HRESULT hr;
+
+    *out = NULL;
+    hr = IUnknown_QueryInterface(rowset, riid, (void **)&check);
+    if(FAILED(hr)) return hr;
+    IUnknown_Release(check);
+
+    w = HeapAlloc(GetProcessHeap(), 0, sizeof(*w));
+    if(!w) return E_OUTOFMEMORY;
+
+    hr = CoCreateInstance(&CLSID_wine_rowset_server, NULL, CLSCTX_INPROC_SERVER, &IID_IWineRowServer,
+                          (void **)&w->server);
+    if(FAILED(hr))
+    {
+        HeapFree(GetProcessHeap(), 0, w);
+        return hr;
+    }
+    IWineRowServer_SetInnerUnk(w->server, rowset);
+    IWineRowServer_GetMarshal(w->server, &w->marshal);
+    IUnknown_AddRef(rowset);
+    w->inner = rowset;
+    w->IUnknown_iface.lpVtbl = &wrapped_vtbl;
+    w->ref = 1;
+    *out = &w->IUnknown_iface;
+    return S_OK;
+}
+
+/* The bookmark arrays travel as one buffer: bookmark i is rgcb[i] bytes long. */
+static HRESULT unpack_bookmarks(DBCOUNTITEM count, const DBBKMARK rgcb[], ULONG packed_len, const BYTE *packed,
+                                const BYTE ***ptrs)
+{
+    const BYTE **p;
+    ULONG_PTR off = 0;
+    DBCOUNTITEM i;
+
+    *ptrs = NULL;
+    if(!count) return S_OK;
+    p = CoTaskMemAlloc(count * sizeof(*p));
+    if(!p) return E_OUTOFMEMORY;
+    for(i = 0; i < count; i++)
+    {
+        if(rgcb[i] > packed_len || off + rgcb[i] > packed_len)
+        {
+            CoTaskMemFree(p);
+            return E_INVALIDARG;
+        }
+        p[i] = packed + off;
+        off += rgcb[i];
+    }
+    *ptrs = p;
+    return S_OK;
+}
