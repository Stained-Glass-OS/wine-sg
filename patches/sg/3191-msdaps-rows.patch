+    pb.deep = deep;
+    pb.len = stride * nsets;
+    pb.cap = pb.len ? pb.len : 1;
+    pb.buf = CoTaskMemAlloc(pb.cap);
+    if(!pb.buf) return E_OUTOFMEMORY;
+    memcpy(pb.buf, data, pb.len);
