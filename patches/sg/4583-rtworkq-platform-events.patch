From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rtworkq: Implement RtwqRegisterPlatformEvents and RtwqUnregisterPlatformEvents.

RtwqRegisterPlatformEvents lets a program listen to RtwqStartup and
RtwqShutdown: a registered IRtwqPlatformEvents hears InitializationComplete
when RtwqStartup starts the platform, and ShutdownStart, then
ShutdownComplete, around the shutdown of the work queues when the last
RtwqShutdown stops it. The listeners are called outside the lock.
RtwqUnregisterPlatformEvents removes one again.

Gate: test/rtworkq-platform-events-gate.sh (64/32).
---
 dlls/rtworkq/queue.c | 100 ++++++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 96 insertions(+), 4 deletions(-)

diff --git a/dlls/rtworkq/queue.c b/dlls/rtworkq/queue.c
index 9046a70..21d6b99 100644
--- a/dlls/rtworkq/queue.c
+++ b/dlls/rtworkq/queue.c
@@ -1178,6 +1178,51 @@ HRESULT WINAPI RtwqUnlockPlatform(void)
     return S_OK;
 }
 
+/* RtwqRegisterPlatformEvents: listeners told about RtwqStartup and RtwqShutdown */
+static CRITICAL_SECTION platform_events_cs;
+static CRITICAL_SECTION_DEBUG platform_events_cs_debug =
+{
+    0, 0, &platform_events_cs,
+    { &platform_events_cs_debug.ProcessLocksList, &platform_events_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": platform_events_cs") }
+};
+static CRITICAL_SECTION platform_events_cs = { &platform_events_cs_debug, -1, 0, 0, 0, 0 };
+static IRtwqPlatformEvents **platform_events;
+static size_t platform_events_count, platform_events_capacity;
+
+enum platform_event { PLATFORM_INITIALIZED, PLATFORM_SHUTDOWN_START, PLATFORM_SHUTDOWN_COMPLETE };
+
+/* calls each listener outside the lock, on a referenced copy of the list */
+static void notify_platform_events(enum platform_event event)
+{
+    IRtwqPlatformEvents **list = NULL;
+    size_t i, count;
+
+    EnterCriticalSection(&platform_events_cs);
+    if ((count = platform_events_count) && (list = malloc(count * sizeof(*list))))
+    {
+        for (i = 0; i < count; ++i)
+        {
+            list[i] = platform_events[i];
+            IRtwqPlatformEvents_AddRef(list[i]);
+        }
+    }
+    else count = 0;
+    LeaveCriticalSection(&platform_events_cs);
+
+    for (i = 0; i < count; ++i)
+    {
+        switch (event)
+        {
+        case PLATFORM_INITIALIZED: IRtwqPlatformEvents_InitializationComplete(list[i]); break;
+        case PLATFORM_SHUTDOWN_START: IRtwqPlatformEvents_ShutdownStart(list[i]); break;
+        case PLATFORM_SHUTDOWN_COMPLETE: IRtwqPlatformEvents_ShutdownComplete(list[i]); break;
+        }
+        IRtwqPlatformEvents_Release(list[i]);
+    }
+    free(list);
+}
+
 static void init_system_queues(void)
 {
     struct queue_desc desc;
@@ -1209,6 +1254,7 @@ HRESULT WINAPI RtwqStartup(void)
     if (InterlockedIncrement(&platform_lock) == 1)
     {
         init_system_queues();
+        notify_platform_events(PLATFORM_INITIALIZED);
     }
 
     return S_OK;
@@ -1239,7 +1285,11 @@ HRESULT WINAPI RtwqShutdown(void)
 
     if (InterlockedExchangeAdd(&platform_lock, -1) == 1)
     {
+#ifndef SG_MUTANT_RTWQ_NO_SHUTDOWN_START
+        notify_platform_events(PLATFORM_SHUTDOWN_START);
+#endif
         shutdown_system_queues();
+        notify_platform_events(PLATFORM_SHUTDOWN_COMPLETE);
     }
 
     return S_OK;
@@ -1642,14 +1692,56 @@ HRESULT WINAPI RtwqEndUnregisterWorkQueueWithMMCSS(IRtwqAsyncResult *result)
 
 HRESULT WINAPI RtwqRegisterPlatformEvents(IRtwqPlatformEvents *events)
 {
-    FIXME("%p.\n", events);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p.\n", events);
+
+    if (!events)
+        return E_POINTER;
+
+    EnterCriticalSection(&platform_events_cs);
+    if (platform_events_count == platform_events_capacity)
+    {
+        size_t capacity = max(4, platform_events_capacity * 2);
+        IRtwqPlatformEvents **list = realloc(platform_events, capacity * sizeof(*list));
+
+        if (list)
+        {
+            platform_events = list;
+            platform_events_capacity = capacity;
+        }
+        else hr = E_OUTOFMEMORY;
+    }
+    if (SUCCEEDED(hr))
+    {
+        platform_events[platform_events_count++] = events;
+        IRtwqPlatformEvents_AddRef(events);
+    }
+    LeaveCriticalSection(&platform_events_cs);
+
+    return hr;
 }
 
 HRESULT WINAPI RtwqUnregisterPlatformEvents(IRtwqPlatformEvents *events)
 {
-    FIXME("%p.\n", events);
+    HRESULT hr = RTWQ_E_NOT_FOUND;
+    size_t i;
 
-    return E_NOTIMPL;
+    TRACE("%p.\n", events);
+
+    EnterCriticalSection(&platform_events_cs);
+    for (i = 0; i < platform_events_count; ++i)
+    {
+        if (platform_events[i] != events) continue;
+#ifndef SG_MUTANT_RTWQ_UNREGISTER_KEEPS
+        memmove(&platform_events[i], &platform_events[i + 1], (platform_events_count - i - 1) * sizeof(*platform_events));
+        --platform_events_count;
+        IRtwqPlatformEvents_Release(events);
+#endif
+        hr = S_OK;
+        break;
+    }
+    LeaveCriticalSection(&platform_events_cs);
+
+    return hr;
 }
