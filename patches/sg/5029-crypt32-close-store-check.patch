From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: Honour CERT_CLOSE_STORE_CHECK_FLAG in collection and provider stores.

CertCloseStore with CERT_CLOSE_STORE_CHECK_FLAG fails with
CRYPT_E_PENDING_CLOSE while references remain for collection stores (system
stores among them) and provider stores (registry, file), as it already did
for memory stores (crypt32 store tests on Windows). The registry provider
takes the close flags without a FIXME: they are about context references,
which the store handles before it calls the provider.

Gate: test/crypt32-closecheck-gate.sh (64/32).
---
 dlls/crypt32/collectionstore.c | 7 ++++++-
 dlls/crypt32/provstore.c       | 6 +++++-
 dlls/crypt32/regstore.c        | 4 ++--
 3 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/dlls/crypt32/collectionstore.c b/dlls/crypt32/collectionstore.c
index 0193be8..fe6a8bf 100644
--- a/dlls/crypt32/collectionstore.c
+++ b/dlls/crypt32/collectionstore.c
@@ -51,13 +51,18 @@ static DWORD Collection_release(WINECRYPT_CERTSTORE *store, DWORD flags)
     WINE_STORE_LIST_ENTRY *entry, *next;
     LONG ref;
 
-    if(flags)
+    if(flags & ~CERT_CLOSE_STORE_CHECK_FLAG)
         FIXME("Unimplemented flags %lx\n", flags);
 
     ref = InterlockedDecrement(&cs->hdr.ref);
     TRACE("(%p) ref=%ld\n", store, ref);
     if(ref)
+#ifndef SG_MUTANT_CLOSE_CHECK_IGNORED
+        /* as for memory stores: the store stays for the other references */
+        return (flags & CERT_CLOSE_STORE_CHECK_FLAG) ? CRYPT_E_PENDING_CLOSE : ERROR_SUCCESS;
+#else
         return ERROR_SUCCESS;
+#endif
 
     LIST_FOR_EACH_ENTRY_SAFE(entry, next, &cs->stores, WINE_STORE_LIST_ENTRY, entry)
     {
diff --git a/dlls/crypt32/provstore.c b/dlls/crypt32/provstore.c
index c186fb5..40dacd8 100644
--- a/dlls/crypt32/provstore.c
+++ b/dlls/crypt32/provstore.c
@@ -55,14 +55,18 @@ static DWORD ProvStore_release(WINECRYPT_CERTSTORE *cert_store, DWORD flags)
     WINE_PROVIDERSTORE *store = (WINE_PROVIDERSTORE*)cert_store;
     LONG ref;
 
-    if(flags)
+    if(flags & ~CERT_CLOSE_STORE_CHECK_FLAG)
         FIXME("Unimplemented flags %lx\n", flags);
 
     ref = InterlockedDecrement(&store->hdr.ref);
     TRACE("(%p) ref=%ld\n", store, ref);
 
     if(ref)
+#ifndef SG_MUTANT_CLOSE_CHECK_IGNORED
+        return (flags & CERT_CLOSE_STORE_CHECK_FLAG) ? CRYPT_E_PENDING_CLOSE : ERROR_SUCCESS;
+#else
         return ERROR_SUCCESS;
+#endif
 
     if (store->provCloseStore)
         store->provCloseStore(store->hStoreProv, flags);
diff --git a/dlls/crypt32/regstore.c b/dlls/crypt32/regstore.c
index c537e27..ba471a2 100644
--- a/dlls/crypt32/regstore.c
+++ b/dlls/crypt32/regstore.c
@@ -324,9 +324,9 @@ static void WINAPI CRYPT_RegCloseStore(HCERTSTORE hCertStore, DWORD dwFlags)
 {
     WINE_REGSTOREINFO *store = hCertStore;
 
+    /* the close flags are about context references, which the store
+     * itself handles before calling here */
     TRACE("(%p, %08lx)\n", store, dwFlags);
-    if (dwFlags)
-        FIXME("Unimplemented flags: %08lx\n", dwFlags);
 
     CRYPT_RegFlushStore(store, FALSE);
     RegCloseKey(store->key);
