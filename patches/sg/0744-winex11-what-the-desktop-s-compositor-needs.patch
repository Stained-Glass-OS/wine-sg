From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: what the desktop's compositor needs

David: "The apps need to have drop shadows like in windows. We also should
support alpha in windows." Every Windows program's window is an X child of
the virtual desktop's window, which X never blends and the Wayland
compositor sees as one; sg-compositor's sg-deskcomp now composites the
desktop's children itself. winex11 tells it what it needs:

  - the desktop's picture (0610's background pixmap) stays alive and is
    named on the desktop window as _SG_DESKTOP_PIXMAP, to paint under the
    windows;
  - _SG_SHADOW on each window: 1 a window with a title bar, 2 a popup whose
    class asks for a shadow (CS_DROPSHADOW: menus, tooltips) or a popup
    menu, 0 none (a layered window draws its own edges);
  - while the compositor owns the selection _SG_DESKCOMP_S0, an alpha
    popup takes no backdrop (0611): the compositor blends it over what is
    below it, live.
---
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -286,7 +286,21 @@
     XPutImage( gdi_display, pixmap, gc, image, 0, 0, 0, 0, bg->width, bg->height );
     XSetWindowBackgroundPixmap( gdi_display, root_window, pixmap );
     XFreeGC( gdi_display, gc );
+#ifndef SG_MUTANT_NODESKTOPPIXMAP
+    {
+        /* and for the desktop's compositor (sg-compositor's sg-deskcomp),
+         * which paints the windows over it: the pixmap stays, named on the
+         * desktop window, until the next picture replaces it */
+        static Pixmap published;
+        static Atom prop;
+        if (!prop) prop = XInternAtom( gdi_display, "_SG_DESKTOP_PIXMAP", False );
+        XChangeProperty( gdi_display, root_window, prop, XA_PIXMAP, 32, PropModeReplace, (unsigned char *)&pixmap, 1 );
+        if (published) XFreePixmap( gdi_display, published );
+        published = pixmap;
+    }
+#else
     XFreePixmap( gdi_display, pixmap );
+#endif
     XFlush( gdi_display );
     image->data = NULL;
     XDestroyImage( image );
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -942,6 +942,20 @@
 }
 
 
+/* Stained Glass OS: the virtual desktop has a compositor (sg-compositor's
+ * sg-deskcomp, owner of this selection while it runs), which blends windows
+ * with an alpha channel over what is below them -- no backdrop to take */
+static BOOL desktop_is_composited( Display *display )
+{
+#ifdef SG_MUTANT_NODESKCOMPCHECK
+    return FALSE;
+#else
+    static Atom selection;
+    if (!selection) selection = XInternAtom( display, "_SG_DESKCOMP_S0", False );
+    return XGetSelectionOwner( display, selection ) != None;
+#endif
+}
+
 /***********************************************************************
  *              set_style_hints
  */
@@ -977,6 +991,25 @@
     XChangeProperty(data->display, data->whole_window, x11drv_atom(_NET_WM_WINDOW_TYPE),
 		    XA_ATOM, 32, PropModeReplace, (unsigned char*)&window_type, 1);
 
+    {
+        /* Stained Glass OS: the shadow the desktop's compositor (sg-compositor's
+         * sg-deskcomp) gives the window, as Windows gives them: 1 a window with
+         * a title bar, 2 a popup whose class asks for one (CS_DROPSHADOW:
+         * menus, tooltips), 0 none -- a layered window draws its own edges */
+        static Atom shadow_atom;
+        unsigned long shadow = 0;
+#ifdef SG_MUTANT_NOSHADOWPROP
+        if (data) return;
+#endif
+        if (!shadow_atom) shadow_atom = XInternAtom( data->display, "_SG_SHADOW", False );
+        if ((style & WS_CAPTION) == WS_CAPTION && !(ex_style & WS_EX_LAYERED)) shadow = 1;
+        else if ((NtUserGetClassLongW( data->hwnd, GCL_STYLE ) & CS_DROPSHADOW) ||
+                 NtUserGetClassLongW( data->hwnd, GCW_ATOM ) == 32768 /* a popup menu */)
+            shadow = 2;
+        XChangeProperty( data->display, data->whole_window, shadow_atom, XA_CARDINAL, 32,
+                         PropModeReplace, (unsigned char *)&shadow, 1 );
+    }
+
     if ((wm_hints = XAllocWMHints()))
     {
         wm_hints->flags = InputHint | StateHint | WindowGroupHint;
@@ -1624,7 +1657,7 @@
              * sheet of glass (a swap chain with alpha: Chrome's bubbles):
              * what is under it, to blend over */
             if (is_virtual_desktop() && !data->managed && data->vis.depth == 32 &&
-                data->whole_window != root_window &&
+                data->whole_window != root_window && !desktop_is_composited( data->display ) &&
                 (data->layered || (data->glass && (NtUserGetWindowLongW( data->hwnd, GWL_STYLE ) & (WS_POPUP | WS_CHILD)) == WS_POPUP)))
             {
                 POINT pt = virtual_screen_to_root( data->rects.visible.left, data->rects.visible.top );
