From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, ntdll: a folder made where the users may make things
 keeps their write

On Windows the users may make files and folders in any folder under
ProgramData (an inheritable Users create right): a program the user runs
can make its own folder in one a SYSTEM service or an installer made, and
owns it. Here that right is the group's write, from the default ACL that
ProgramData (and C:\, Public) pass down. A folder made with a program's own
security descriptor got the descriptor's mode -- 0755 -- and, under the
process's umask, an ACL mask of r-x: the group's inherited write was gone.
The Ambir scanner's driver could not make its calibration folder in
ProgramData\AmbirTechnology, made by Ambir's SYSTEM service: "a read write
error" (David 2026-10-02).

- server: a folder made in a folder whose default ACL gives a group all
  rights (sg_dir_shares_write) keeps the group's rights in the mode the
  client applies; a security descriptor set on such a folder keeps them too.
  A default ACL giving the group r-x (Program Files) changes nothing.
- ntdll: a file or folder a client made under a folder with a default ACL is
  not given the umask, as POSIX's open() and mkdir() would not.

Test: test/dirshare-gate.sh (mutants DIR_MODE_NARROWS, UMASK_ALWAYS).
---
--- a/server/file.c
+++ b/server/file.c
@@ -278,6 +278,27 @@
             mode |= S_IXOTH;
     }
 
+    /* Stained Glass OS: a folder made where the users may make things keeps
+     * the group's rights (sg_dir_shares_write) */
+    if ((options & FILE_DIRECTORY_FILE) && (mode & S_IRWXG) != S_IRWXG)
+    {
+        char *slash = strrchr( name, '/' );
+        int parent = -1;
+        if (slash == name) parent = open( "/", O_RDONLY | O_DIRECTORY );
+        else if (slash)
+        {
+            *slash = 0;
+            parent = root ? openat( get_unix_fd( root ), name, O_RDONLY | O_DIRECTORY ) : open( name, O_RDONLY | O_DIRECTORY );
+            *slash = '/';
+        }
+        else if (root) parent = dup( get_unix_fd( root ) );
+        if (parent != -1)
+        {
+            if (sg_dir_shares_write( parent, NULL )) mode |= S_IRWXG;
+            close( parent );
+        }
+    }
+
     /* Stained Glass OS: a client that created the file itself applies this
      * mode to it (ADR 0013), as open() would have applied it here. */
     *create_mode = mode;
@@ -668,9 +689,40 @@
 #endif
 }
 
+/* Stained Glass OS: a directory whose default ACL gives a group all rights
+ * (ProgramData's, C:\'s, Public's: "the users may make things in here and
+ * below", Windows' inheritable Users create right) keeps that group's
+ * rights, whatever mode a program's security descriptor maps to: a folder an
+ * installer or a SYSTEM service made with its own descriptor became 0755,
+ * its ACL mask r-x, and a user's program could make nothing in it -- the
+ * Ambir scanner's calibration folder under ProgramData\AmbirTechnology, "a
+ * read write error" (David 2026-10-02). Program Files' default ACL gives the
+ * group r-x only: it stays the administrators'. */
+int sg_dir_shares_write( int fd, const char *path )
+{
+    unsigned char buf[4 + 8 * 32];
+    ssize_t n, i;
+
+#ifdef SG_MUTANT_DIR_MODE_NARROWS
+    return 0;
+#endif
+    n = fd != -1 ? fgetxattr( fd, "system.posix_acl_default", buf, sizeof(buf) )
+                 : getxattr( path, "system.posix_acl_default", buf, sizeof(buf) );
+    for (i = 4; i + 8 <= n; i += 8)
+    {
+        unsigned int tag = buf[i] | buf[i + 1] << 8, perm = buf[i + 2] | buf[i + 3] << 8;
+        if ((tag == 0x04 /* ACL_GROUP_OBJ */ || tag == 0x08 /* ACL_GROUP */) && (perm & 7) == 7) return 1;
+    }
+    return 0;
+}
+
 int sg_set_unix_mode( int unix_fd, mode_t mode )
 {
     int ret, err;
+    struct stat st;
+
+    if (!fstat( unix_fd, &st ) && S_ISDIR( st.st_mode ) && sg_dir_shares_write( unix_fd, NULL ))
+        mode |= S_IRWXG;
 
     if (current && current->process->peer_uid != getuid())
     {
--- a/server/fd.c
+++ b/server/fd.c
@@ -2070,6 +2070,14 @@
                 goto error;
             }
         }
+        else if ((*mode & S_IRWXG) != S_IRWXG && sg_dir_shares_write( -1, name ))
+        {
+            /* Stained Glass OS: made where the users may make things (its
+             * inherited default ACL says so): the mode from a program's
+             * descriptor does not take that from it (sg_dir_shares_write) */
+            struct stat st;
+            if (!stat( name, &st )) chmod( name, (st.st_mode & 07777) | S_IRWXG );
+        }
         flags &= ~(O_CREAT | O_EXCL | O_TRUNC);
     }
 
--- a/server/file.h
+++ b/server/file.h
@@ -173,6 +173,7 @@
 extern mode_t sd_to_mode( const struct security_descriptor *sd, const struct sid *owner );
 struct stat;
 extern void sg_users_group( int unix_fd, const struct stat *st );
+extern int sg_dir_shares_write( int fd, const char *path );
 extern int is_file_executable( const char *name );
 
 /* file mapping functions */
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -4510,7 +4510,32 @@
     /* a file this call created gets the mode the server chose for it -- from
      * the security descriptor, or the default -- under this process's umask,
      * as open() would have applied it */
-    if (created && !status) fchmod( fd, mode & 07777 & ~sg_umask() );
+    if (created && !status)
+    {
+        /* Stained Glass OS: made under a folder with a default ACL (the ACL
+         * it got from there says so), the umask is not applied -- POSIX's
+         * rule, as open() and mkdir() would have done: 022 took the users'
+         * write from a folder made in ProgramData */
+        mode_t m = mode & 07777;
+        BOOL inherited = FALSE;
+        struct stat st;
+#ifndef SG_MUTANT_UMASK_ALWAYS
+        if (!fstat( fd, &st ) && S_ISDIR( st.st_mode ))   /* a folder has its parent's default ACL */
+            inherited = fgetxattr( fd, "system.posix_acl_default", NULL, 0 ) > 0;
+        else if (unix_name[0] == '/')
+        {
+            char *parent = strdup( unix_name ), *slash;
+            if (parent && (slash = strrchr( parent, '/' )))
+            {
+                if (slash == parent) slash[1] = 0; else *slash = 0;
+                inherited = getxattr( parent, "system.posix_acl_default", NULL, 0 ) > 0;
+            }
+            free( parent );
+        }
+#endif
+        if (!inherited) m &= ~sg_umask();
+        fchmod( fd, m );
+    }
     close( fd );
     free( objattr );
     return status;
