From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: an added font is found by fonts created before it (6015)

Adding a font forgets the cached realized fonts, so a LOGFONT that was
mapped to a substitute before the font came maps to the new font.
---
diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
index fbc72e6..c7d7030 100644
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -3044,6 +3044,28 @@ static void release_gdi_font( struct gdi_font *font )
     pthread_mutex_unlock( &font_lock );
 }
 
+/* Stained Glass OS: fonts realized before a font is added may have been
+ * substitutes for it (a face name that was no font yet): they are not found
+ * by their LOGFONT any more, so that the new font is selected; those in use
+ * go when they are released. font_lock is held. */
+static void forget_cached_fonts(void)
+{
+    struct gdi_font *font, *next;
+
+#ifdef SG_MUTANT_FONT_CACHE_KEPT
+    return;
+#endif
+    LIST_FOR_EACH_ENTRY_SAFE( font, next, &gdi_font_list, struct gdi_font, entry )
+    {
+        list_remove( &font->entry );
+        list_init( &font->entry );
+        if (font->refcount) continue;
+        list_remove( &font->unused_entry );
+        unused_font_count--;
+        free_gdi_font( font );
+    }
+}
+
 /* the fonts AddFontMemResourceEx added, by the handle it returned */
 struct mem_font_resource
 {
@@ -6693,6 +6715,12 @@ static int add_font_resource( LPCWSTR file, DWORD flags )
     else if (!wcschr( file, '\\' ))
         ret = add_system_font_resource( file, ADDFONT_ALLOW_BITMAP | ADDFONT_ADD_RESOURCE );
 
+    if (ret)
+    {
+        pthread_mutex_lock( &font_lock );
+        forget_cached_fonts();
+        pthread_mutex_unlock( &font_lock );
+    }
     return ret;
 }
 
@@ -7130,6 +7158,7 @@ HANDLE WINAPI NtGdiAddFontMemResourceEx( void *ptr, DWORD size, void *dv, ULONG
 
     pthread_mutex_lock( &font_lock );
     num_fonts = font_funcs->add_mem_font( copy, size, ADDFONT_ALLOW_BITMAP | ADDFONT_ADD_RESOURCE );
+    if (num_fonts) forget_cached_fonts();
     pthread_mutex_unlock( &font_lock );
 
     if (!num_fonts)
