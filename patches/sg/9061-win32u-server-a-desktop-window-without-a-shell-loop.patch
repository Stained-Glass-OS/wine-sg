From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, server: a desktop's window is made without starting explorer after explorer

On Windows win32k makes every desktop's window; no process is started for it.
Wine makes it through an explorer started by the first process that needs it,
with that process's token. When that token may not make windows there -- a
sandboxed process connected with MAXIMUM_ALLOWED (9060) to Chromium's
alternate desktop, which denies RESTRICTED DESKTOP_CREATEWINDOW, or any
desktop whose DACL denies everyone -- the explorer failed, and so did the
fallback (the server made the desktop window only for a thread with
DESKTOP_CREATEWINDOW). The explorer then started another explorer for the
same desktop, which started another: a test run left 13,370 explorer
processes that filled 31 GB of memory and swap, and they outlived their
wineserver because the next one in the chain started a new one.

- The server makes a desktop's own window and message window
  (get_desktop_window, force) without DESKTOP_CREATEWINDOW, as win32k does.
- A desktop's own explorer ("explorer.exe /desktop...") never starts
  another; any other process starts one at most once per desktop, and the
  desktop window is otherwise made directly.

Gate: test/logondesk-gate.sh (a USER_LIMITED child alone on an alternate
desktop: it returns, and processes do not pile up in the gate's scope).
Mutants SG_MUTANT_DESKTOP_WINDOW_NEEDS_CREATEWINDOW (server/window.c),
SG_MUTANT_DESKTOP_SHELL_RESPAWNS (dlls/win32u/winstation.c; QA VM only).
---
--- a/dlls/win32u/winstation.c
+++ b/dlls/win32u/winstation.c
@@ -813,13 +813,44 @@
 static inline TEB64 *NtCurrentTeb64(void) { return (TEB64 *)NtCurrentTeb()->GdiBatchCount; }
 #endif
 
+static pthread_mutex_t sg_shell_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+/* Stained Glass OS 9061: whether this process may start an explorer for its thread's desktop
+ * (get_desktop_window): not if it is a desktop's explorer itself ("explorer.exe /desktop..."), and
+ * once per desktop otherwise */
+static BOOL sg_may_start_desktop_shell(void)
+{
+    static const WCHAR explorerW[] = {'\\','e','x','p','l','o','r','e','r','.','e','x','e'};
+    static const WCHAR desktopW[] = {'/','d','e','s','k','t','o','p'};
+    static HDESK tried[16];
+    static unsigned int tried_count;
+    RTL_USER_PROCESS_PARAMETERS *params = NtCurrentTeb()->Peb->ProcessParameters;
+    const UNICODE_STRING *image = &params->ImagePathName, *cmd = &params->CommandLine;
+    HDESK desk = NtUserGetThreadDesktop( GetCurrentThreadId() );
+    size_t n = ARRAY_SIZE(explorerW), m = ARRAY_SIZE(desktopW), i;
+    BOOL ret = TRUE;
+
+    if (image->Length >= n * sizeof(WCHAR) &&
+        !wcsnicmp( image->Buffer + image->Length / sizeof(WCHAR) - n, explorerW, n ))
+    {
+        for (i = 0; i + m <= cmd->Length / sizeof(WCHAR); i++)
+            if (!wcsnicmp( cmd->Buffer + i, desktopW, m )) return FALSE;
+    }
+    pthread_mutex_lock( &sg_shell_mutex );
+    for (i = 0; i < tried_count; i++) if (tried[i] == desk) ret = FALSE;
+    if (ret && tried_count < ARRAY_SIZE(tried)) tried[tried_count++] = desk;
+    else if (ret) ret = FALSE;  /* sixteen desktops tried already */
+    pthread_mutex_unlock( &sg_shell_mutex );
+    return ret;
+}
+
 HWND get_desktop_window(void)
 {
     static const WCHAR wine_service_station_name[] =
         {'_','_','w','i','n','e','s','e','r','v','i','c','e','_','w','i','n','s','t','a','t','i','o','n',0};
     struct ntuser_thread_info *thread_info = NtUserGetThreadInfo();
     WCHAR name[MAX_PATH];
-    BOOL is_service;
+    BOOL is_service, no_shell = FALSE;
 
     if (thread_info->top_window) return UlongToHandle( thread_info->top_window );
 
@@ -855,7 +886,29 @@
         return 0;
     }
 
-    if (!thread_info->top_window)
+    /* Stained Glass OS 9061: an explorer is started for a desktop at most once per process, and
+     * never by a desktop's own explorer. When the desktop window cannot be made at all (a sandboxed
+     * process allowed no DESKTOP_CREATEWINDOW there, a desktop whose DACL denies everyone), the
+     * explorer started for it failed the same way and started another, which started another: a
+     * renderer on such a desktop left tens of thousands of explorers that filled memory and swap.
+     * On Windows win32k makes desktop windows and no process is started for them at all. */
+#ifndef SG_MUTANT_DESKTOP_SHELL_RESPAWNS
+    if (!thread_info->top_window && !sg_may_start_desktop_shell())
+    {
+        no_shell = TRUE;
+        SERVER_START_REQ( get_desktop_window )
+        {
+            req->force = 1;
+            if (!wine_server_call( req ))
+            {
+                thread_info->top_window = reply->top_window;
+                thread_info->msg_window = reply->msg_window;
+            }
+        }
+        SERVER_END_REQ;
+    }
+#endif
+    if (!thread_info->top_window && !no_shell)
     {
         static const WCHAR appnameW[] = {'\\','?','?','\\','C',':','\\','w','i','n','d','o','w','s',
             '\\','s','y','s','t','e','m','3','2','\\','e','x','p','l','o','r','e','r','.','e','x','e',0};
--- a/server/window.c
+++ b/server/window.c
@@ -728,6 +728,11 @@
     if (win && win->thread) post_message( win->handle, message, wparam, lparam );
 }
 
+/* Stained Glass OS 9061: set while get_desktop_window makes a desktop's own window or message
+ * window, which on Windows the system makes (win32k): no DESKTOP_CREATEWINDOW is needed for them --
+ * a sandboxed process denied it, alone on its desktop, had no desktop window, and hung */
+static int sg_system_window;
+
 /* create a new window structure (note: the window is not linked in the window tree) */
 static struct window *create_window( struct window *parent, struct window *owner,
                                      atom_t atom, mod_handle_t instance )
@@ -737,7 +742,7 @@
     struct desktop *desktop;
     struct window_class *class;
 
-    if (!(desktop = get_thread_desktop( current, DESKTOP_CREATEWINDOW ))) return NULL;
+    if (!(desktop = get_thread_desktop( current, sg_system_window ? 0 : DESKTOP_CREATEWINDOW ))) return NULL;
 
     if (!(class = grab_class( current->process, atom, instance, &extra_bytes )))
     {
@@ -2517,6 +2522,9 @@
 
     if (!desktop) return;
 
+#ifndef SG_MUTANT_DESKTOP_WINDOW_NEEDS_CREATEWINDOW
+    sg_system_window = 1;  /* 9061 */
+#endif
     if (!desktop->top_window && req->force)  /* create it */
     {
         if ((desktop->top_window = create_window( NULL, NULL, DESKTOP_ATOM, 0 )))
@@ -2537,6 +2545,7 @@
             desktop->msg_window->style = WS_POPUP | WS_CLIPSIBLINGS | WS_CLIPCHILDREN;
         }
     }
+    sg_system_window = 0;
 
     reply->top_window = desktop->top_window ? desktop->top_window->handle : 0;
     reply->msg_window = desktop->msg_window ? desktop->msg_window->handle : 0;
