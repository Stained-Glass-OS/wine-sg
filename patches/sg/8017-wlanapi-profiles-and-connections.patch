+/* ---- Stained Glass OS (wine-sg 8017): profiles and connections, through sg-netctl (NetworkManager) ----
+ * A profile is a saved Wi-Fi network ("wifi saved"), named after its SSID as Windows names the profiles it
+ * makes; all of them are all-user profiles (dwFlags 0). WlanConnect checks its arguments and the profile,
+ * then connects on a thread of its own and reports the outcome to the notification callback
+ * (connection_start, connection_attempt_fail, connection_complete), as Windows does. A temporary profile
+ * (XML) gives the SSID, the authentication and the key; open, WPA/WPA2-Personal and WPA3-Personal are
+ * what NetworkManager is asked for here, the rest is ERROR_NOT_SUPPORTED. */
+
+struct saved_wifi
+{
+    WCHAR name[WLAN_MAX_NAME_LENGTH];
+    WCHAR hex[DOT11_SSID_MAX_LENGTH * 2 + 1];
+    DOT11_SSID ssid;
+    BOOL autoconnect;
+};
+
+static DWORD netctl_error(const struct sgnet_reply *r, int ret)
+{
+    if (ret < 0) return ERROR_SERVICE_NOT_ACTIVE;
+    if (!wcscmp(r->kind, L"denied")) return ERROR_ACCESS_DENIED;
+    if (!wcscmp(r->kind, L"notfound")) return ERROR_NOT_FOUND;
+    if (!wcscmp(r->kind, L"invalid")) return ERROR_INVALID_PARAMETER;
+    if (!wcscmp(r->kind, L"unsupported")) return ERROR_NOT_SUPPORTED;
+    return ERROR_GEN_FAILURE;
+}
+
+static void ssid_from_hex(const WCHAR *hex, DOT11_SSID *ssid)
+{
+    int j;
+
+    for (j = 0; hex[j * 2] && hex[j * 2 + 1] && j < DOT11_SSID_MAX_LENGTH; j++)
+    {
+        int hi = hex_digit(hex[j * 2]), lo = hex_digit(hex[j * 2 + 1]);
+        if (hi < 0 || lo < 0) break;
+        ssid->ucSSID[j] = hi * 16 + lo;
+    }
+    ssid->uSSIDLength = j;
+}
+
+static void ssid_to_hex(const DOT11_SSID *ssid, WCHAR *hex)
+{
+    ULONG i;
+
+    for (i = 0; i < ssid->uSSIDLength && i < DOT11_SSID_MAX_LENGTH; i++)
+        swprintf(hex + i * 2, 3, L"%02x", ssid->ucSSID[i]);
+    hex[i * 2] = 0;
+}
+
+/* the saved networks: SAVED uuid TAB autoconnect TAB ssid in hex TAB name */
+static int get_saved_wifi(struct saved_wifi **ret, DWORD *err)
+{
+    const WCHAR *args[] = { L"wifi", L"saved" };
+    struct saved_wifi *list = NULL, *new;
+    struct sgnet_reply r;
+    int i, n = 0, rc;
+
+    *ret = NULL;
+    if ((rc = sgnet_request(args, 2, &r)) != 1)
+    {
+        *err = netctl_error(&r, rc);
+        sgnet_free(&r);
+        return -1;
+    }
+    for (i = 0; i < r.count; i++)
+    {
+        WCHAR *f[4], *p, buf[600];
+        int k = 0;
+
+        if (wcsncmp(r.lines[i], L"SAVED ", 6)) continue;
+        lstrcpynW(buf, r.lines[i] + 6, ARRAY_SIZE(buf));
+        for (p = buf, f[k++] = p; *p && k < 4; p++)
+            if (*p == '\t') { *p = 0; f[k++] = p + 1; }
+        if (k < 4 || !f[3][0]) continue;
+        if (!(new = realloc(list, (n + 1) * sizeof(*list)))) break;
+        list = new;
+        memset(&list[n], 0, sizeof(*list));
+        lstrcpynW(list[n].name, f[3], ARRAY_SIZE(list[n].name));
+        lstrcpynW(list[n].hex, f[2], ARRAY_SIZE(list[n].hex));
+        ssid_from_hex(f[2], &list[n].ssid);
+        list[n].autoconnect = !wcscmp(f[1], L"yes");
+        n++;
+    }
+    sgnet_free(&r);
+    *ret = list;
+    return n;
+}
+
+static struct saved_wifi *find_saved(struct saved_wifi *list, int n, const WCHAR *name)
+{
+    int i;
+
+    for (i = 0; i < n; i++) if (!wcscmp(list[i].name, name)) return &list[i];
+    for (i = 0; i < n; i++) if (!wcsicmp(list[i].name, name)) return &list[i];
+    return NULL;
+}
+
+/* checks the handle and the interface; the adapter's device name */
+static DWORD check_interface(HANDLE handle, const GUID *guid, WCHAR *dev, DWORD len)
+{
+    struct wifi_adapter *adapters, *adapter;
+    int count;
+
+    if (!handle_index(handle)) return ERROR_INVALID_HANDLE;
+    count = get_wifi_adapters(&adapters);
+    if (!(adapter = find_adapter(adapters, count, guid)))
+    {
+        free(adapters);
+        return ERROR_NOT_FOUND;
+    }
+    if (dev) lstrcpynW(dev, adapter->dev, len);
+    free(adapters);
+    return ERROR_SUCCESS;
+}
+
+static void notify_acm(HANDLE handle, const GUID *guid, DWORD code, void *data, DWORD size)
+{
+    struct wine_wlan *wlan = handle_index(handle);
+    WLAN_NOTIFICATION_DATA n = { 0 };
+
+    if (!wlan || !wlan->callback || !(wlan->notify_source & WLAN_NOTIFICATION_SOURCE_ACM)) return;
+    n.NotificationSource = WLAN_NOTIFICATION_SOURCE_ACM;
+    n.NotificationCode = code;
+    n.InterfaceGuid = *guid;
+    n.dwDataSize = size;
+    n.pData = data;
+    wlan->callback(&n, wlan->context);
+}
+
+DWORD WINAPI WlanGetProfileList(HANDLE handle, const GUID *guid, void *reserved, WLAN_PROFILE_INFO_LIST **profile_list)
+{
+    struct saved_wifi *saved;
+    WLAN_PROFILE_INFO_LIST *list;
+    DWORD err;
+    int i, n;
+
+    TRACE("(%p, %s, %p, %p)\n", handle, wine_dbgstr_guid(guid), reserved, profile_list);
+
+    if (!handle || !guid || reserved || !profile_list) return ERROR_INVALID_PARAMETER;
+    if ((err = check_interface(handle, guid, NULL, 0))) return err;
+    if ((n = get_saved_wifi(&saved, &err)) < 0) return err;
+    if (!(list = WlanAllocateMemory(offsetof(WLAN_PROFILE_INFO_LIST, ProfileInfo[n ? n : 1]))))
+    {
+        free(saved);
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    memset(list, 0, offsetof(WLAN_PROFILE_INFO_LIST, ProfileInfo[n ? n : 1]));
+    for (i = 0; i < n; i++) lstrcpynW(list->ProfileInfo[i].strProfileName, saved[i].name, WLAN_MAX_NAME_LENGTH);
+    free(saved);
+    list->dwNumberOfItems = n;
+    list->dwIndex = 0;
+    *profile_list = list;
+    return ERROR_SUCCESS;
+}
+
+DWORD WINAPI WlanDeleteProfile(HANDLE handle, const GUID *guid, const WCHAR *name, void *reserved)
+{
+    const WCHAR *args[4] = { L"wifi", L"forget", L"--ssid-hex" };
+    struct saved_wifi *saved, *s;
+    struct sgnet_reply r;
+    DWORD err;
+    int n, rc;
+
+    TRACE("(%p, %s, %s, %p)\n", handle, wine_dbgstr_guid(guid), debugstr_w(name), reserved);
+
+    if (!handle || !guid || !name || !name[0] || reserved) return ERROR_INVALID_PARAMETER;
+    if ((err = check_interface(handle, guid, NULL, 0))) return err;
+    if ((n = get_saved_wifi(&saved, &err)) < 0) return err;
+    if (!(s = find_saved(saved, n, name)))
+    {
+        free(saved);
+        return ERROR_NOT_FOUND;
+    }
+    args[3] = s->hex;
+#ifdef SG_MUTANT_NO_WLAN_PROFILES
+    rc = 1; memset(&r, 0, sizeof(r));
+#else
+    rc = sgnet_request(args, 4, &r);
+#endif
+    err = rc == 1 ? ERROR_SUCCESS : netctl_error(&r, rc);
+    sgnet_free(&r);
+    free(saved);
+    return err;
+}
+
+struct connect_request
+{
+    HANDLE handle;
+    GUID guid;
+    WCHAR dev[64];
+    WCHAR hex[DOT11_SSID_MAX_LENGTH * 2 + 1];
+    const WCHAR *security;        /* NULL: the saved profile's */
+    char *key;                    /* the key, NUL-terminated, newline ended */
+    BOOL hidden, keep;
+    WLAN_CONNECTION_NOTIFICATION_DATA data;
+};
+
+static DWORD WINAPI connect_thread(void *arg)
+{
+    struct connect_request *req = arg;
+    const WCHAR *args[12];
+    struct sgnet_reply r;
+    int n = 0, rc;
+
+    args[n++] = L"wifi";
+    args[n++] = L"connect";
+    args[n++] = L"--ssid-hex";
+    args[n++] = req->hex;
+    args[n++] = L"--device";
+    args[n++] = req->dev;
+    if (req->security) { args[n++] = L"--security"; args[n++] = req->security; }
+    if (req->hidden) args[n++] = L"--hidden";
+    if (!req->keep) args[n++] = L"--no-autoconnect";
+    if (req->key) args[n++] = L"--password-stdin";
+
+    notify_acm(req->handle, &req->guid, wlan_notification_acm_connection_start, &req->data, sizeof(req->data));
+    rc = sgnet_request_input(args, n, req->key, &r);
+    if (rc == 1) req->data.wlanReasonCode = WLAN_REASON_CODE_SUCCESS;
+    else
+    {
+        req->data.wlanReasonCode = !wcscmp(r.kind, L"auth") ? WLAN_REASON_CODE_MSMSEC_PSK_MISMATCH_SUSPECTED :
+                                   !wcscmp(r.kind, L"notfound") ? WLAN_REASON_CODE_NETWORK_NOT_AVAILABLE :
+                                   !wcscmp(r.kind, L"unsupported") ? WLAN_REASON_CODE_UNSUPPORTED_SECURITY_SET :
+                                   !wcscmp(r.kind, L"denied") ? WLAN_REASON_CODE_USER_DENIED :
+                                   WLAN_REASON_CODE_ASSOCIATION_FAILURE;
+        WARN("could not connect: %s %s\n", debugstr_w(r.kind), debugstr_w(r.message));
+        notify_acm(req->handle, &req->guid, wlan_notification_acm_connection_attempt_fail, &req->data, sizeof(req->data));
+    }
+    sgnet_free(&r);
+    notify_acm(req->handle, &req->guid, wlan_notification_acm_connection_complete, &req->data, sizeof(req->data));
+    if (req->key) { SecureZeroMemory(req->key, strlen(req->key)); free(req->key); }
+    free(req);
+    return 0;
+}
+
+/* the text of the first <tag>...</tag> in xml after `from` (if given), XML entities decoded */
+static BOOL xml_text(const WCHAR *xml, const WCHAR *from, const WCHAR *tag, WCHAR *buf, DWORD len)
+{
+    WCHAR open[64], close[64];
+    const WCHAR *start, *end, *p;
+    DWORD i = 0;
+
+    if (from && !(xml = wcsstr(xml, from))) return FALSE;
+    swprintf(open, ARRAY_SIZE(open), L"<%s>", tag);
+    swprintf(close, ARRAY_SIZE(close), L"</%s>", tag);
+    if (!(start = wcsstr(xml, open))) return FALSE;
+    start += wcslen(open);
+    if (!(end = wcsstr(start, close))) return FALSE;
+    for (p = start; p < end && i + 1 < len; i++)
+    {
+        if (!wcsncmp(p, L"&amp;", 5)) { buf[i] = '&'; p += 5; }
+        else if (!wcsncmp(p, L"&lt;", 4)) { buf[i] = '<'; p += 4; }
+        else if (!wcsncmp(p, L"&gt;", 4)) { buf[i] = '>'; p += 4; }
+        else if (!wcsncmp(p, L"&quot;", 6)) { buf[i] = '"'; p += 6; }
+        else if (!wcsncmp(p, L"&apos;", 6)) { buf[i] = '\''; p += 6; }
+        else buf[i] = *p++;
+    }
+    buf[i] = 0;
+    return TRUE;
+}
+
+static char *key_line(const WCHAR *key)
+{
+    int len = WideCharToMultiByte(CP_UTF8, 0, key, -1, NULL, 0, NULL, NULL);
+    char *ret = malloc(len + 1);
+
+    if (!ret) return NULL;
+    WideCharToMultiByte(CP_UTF8, 0, key, -1, ret, len, NULL, NULL);
+    strcat(ret, "\n");
+    return ret;
+}
+
+/* a temporary profile: its SSID, security and key */
+static DWORD parse_temp_profile(const WCHAR *xml, struct connect_request *req)
+{
+    WCHAR text[256], auth[64];
+    DOT11_SSID ssid = { 0 };
+
+    if (!wcsstr(xml, L"<WLANProfile")) return ERROR_BAD_PROFILE;
+    if (xml_text(xml, L"<SSID>", L"hex", text, ARRAY_SIZE(text)))
+        ssid_from_hex(text, &ssid);
+    else if (xml_text(xml, L"<SSID>", L"name", text, ARRAY_SIZE(text)))
+    {
+        char utf8[DOT11_SSID_MAX_LENGTH + 1];
+        int len = WideCharToMultiByte(CP_UTF8, 0, text, -1, utf8, sizeof(utf8), NULL, NULL);
+        if (len <= 1) return ERROR_BAD_PROFILE;
+        ssid.uSSIDLength = len - 1;
+        memcpy(ssid.ucSSID, utf8, len - 1);
+    }
+    if (!ssid.uSSIDLength) return ERROR_BAD_PROFILE;
+    ssid_to_hex(&ssid, req->hex);
+    req->data.dot11Ssid = ssid;
+    if (xml_text(xml, NULL, L"name", text, ARRAY_SIZE(text)))
+        lstrcpynW(req->data.strProfileName, text, WLAN_MAX_NAME_LENGTH);
+    req->hidden = xml_text(xml, NULL, L"nonBroadcast", text, ARRAY_SIZE(text)) && !wcscmp(text, L"true");
+
+    if (!xml_text(xml, L"<authEncryption>", L"authentication", auth, ARRAY_SIZE(auth))) wcscpy(auth, L"open");
+    if (!wcscmp(auth, L"open"))
+    {
+        if (xml_text(xml, L"<authEncryption>", L"encryption", text, ARRAY_SIZE(text)) && wcscmp(text, L"none"))
+            return ERROR_NOT_SUPPORTED;   /* WEP */
+        req->security = L"open";
+        return ERROR_SUCCESS;
+    }
+    if (!wcscmp(auth, L"WPA2PSK") || !wcscmp(auth, L"WPAPSK")) req->security = L"wpa-psk";
+    else if (!wcscmp(auth, L"WPA3SAE")) req->security = L"sae";
+    else return ERROR_NOT_SUPPORTED;      /* enterprise (802.1X), shared-key WEP, OWE */
+    req->data.bSecurityEnabled = TRUE;
+    if (xml_text(xml, L"<sharedKey>", L"protected", text, ARRAY_SIZE(text)) && !wcscmp(text, L"true"))
+        return ERROR_NOT_SUPPORTED;      /* a key encrypted for another machine's account */
+    if (!xml_text(xml, L"<sharedKey>", L"keyMaterial", text, ARRAY_SIZE(text)) || !text[0]) return ERROR_BAD_PROFILE;
+    if (!(req->key = key_line(text))) return ERROR_NOT_ENOUGH_MEMORY;
+    SecureZeroMemory(text, sizeof(text));
+    return ERROR_SUCCESS;
+}
+
+DWORD WINAPI WlanConnect(HANDLE handle, const GUID *guid, const WLAN_CONNECTION_PARAMETERS *params, void *reserved)
+{
+    struct connect_request *req;
+    struct saved_wifi *saved, *s;
+    HANDLE thread;
+    DWORD err;
+    int n;
+
+    TRACE("(%p, %s, %p, %p)\n", handle, wine_dbgstr_guid(guid), params, reserved);
+
+    if (!handle || !guid || !params || reserved) return ERROR_INVALID_PARAMETER;
+    if (params->dot11BssType != dot11_BSS_type_infrastructure && params->dot11BssType != dot11_BSS_type_any)
+        return params->dot11BssType == dot11_BSS_type_independent ? ERROR_NOT_SUPPORTED : ERROR_INVALID_PARAMETER;
+    if (!(req = calloc(1, sizeof(*req)))) return ERROR_NOT_ENOUGH_MEMORY;
+    if ((err = check_interface(handle, guid, req->dev, ARRAY_SIZE(req->dev)))) goto fail;
+    req->handle = handle;
+    req->guid = *guid;
+    req->data.wlanConnectionMode = params->wlanConnectionMode;
+    req->data.dot11BssType = dot11_BSS_type_infrastructure;
+    req->hidden = (params->dwFlags & WLAN_CONNECTION_HIDDEN_NETWORK) != 0;
+
+    switch (params->wlanConnectionMode)
+    {
+    case wlan_connection_mode_profile:
+        err = ERROR_INVALID_PARAMETER;
+        if (!params->strProfile || !params->strProfile[0]) goto fail;
+        if ((n = get_saved_wifi(&saved, &err)) < 0) goto fail;
+        if (!(s = find_saved(saved, n, params->strProfile)))
+        {
+            free(saved);
+            err = ERROR_NOT_FOUND;
+            goto fail;
+        }
+        lstrcpynW(req->hex, s->hex, ARRAY_SIZE(req->hex));
+        lstrcpynW(req->data.strProfileName, s->name, WLAN_MAX_NAME_LENGTH);
+        req->data.dot11Ssid = s->ssid;
+        req->keep = TRUE;
+        free(saved);
+        break;
+    case wlan_connection_mode_temporary_profile:
+        err = ERROR_INVALID_PARAMETER;
+        if (!params->strProfile || !params->strProfile[0]) goto fail;
+        if ((err = parse_temp_profile(params->strProfile, req))) goto fail;
+        req->keep = FALSE;
+        break;
+    case wlan_connection_mode_discovery_unsecure:
+        err = ERROR_INVALID_PARAMETER;
+        if (!params->pDot11Ssid || !params->pDot11Ssid->uSSIDLength ||
+            params->pDot11Ssid->uSSIDLength > DOT11_SSID_MAX_LENGTH) goto fail;
+        req->data.dot11Ssid = *params->pDot11Ssid;
+        ssid_to_hex(params->pDot11Ssid, req->hex);
+        req->security = L"open";
+        req->keep = FALSE;
+        break;
+    case wlan_connection_mode_discovery_secure:
+        err = ERROR_NOT_SUPPORTED;   /* needs a security discovery (a 802.1X or WPS exchange) */
+        goto fail;
+    default:
+        err = ERROR_INVALID_PARAMETER;
+        goto fail;
+    }
+
+#ifdef SG_MUTANT_NO_WLAN_CONNECT
+    err = ERROR_SUCCESS;
+    goto fail;
+#endif
+    if (!(thread = CreateThread(NULL, 0, connect_thread, req, 0, NULL)))
+    {
+        err = GetLastError();
+        goto fail;
+    }
+    CloseHandle(thread);
+    return ERROR_SUCCESS;
+
+fail:
+    if (req->key) { SecureZeroMemory(req->key, strlen(req->key)); free(req->key); }
+    free(req);
+    return err;
+}
+
+DWORD WINAPI WlanDisconnect(HANDLE handle, const GUID *guid, void *reserved)
+{
+    const WCHAR *args[3] = { L"wifi", L"disconnect" };
+    WLAN_CONNECTION_NOTIFICATION_DATA data = { 0 };
+    struct sgnet_reply r;
+    WCHAR dev[64];
+    DWORD err;
+    int rc;
+
+    TRACE("(%p, %s, %p)\n", handle, wine_dbgstr_guid(guid), reserved);
+
+    if (!handle || !guid || reserved) return ERROR_INVALID_PARAMETER;
+    if ((err = check_interface(handle, guid, dev, ARRAY_SIZE(dev)))) return err;
+    args[2] = dev;
+    notify_acm(handle, guid, wlan_notification_acm_disconnecting, &data, sizeof(data));
+    rc = sgnet_request(args, 3, &r);
+    err = rc == 1 ? ERROR_SUCCESS : netctl_error(&r, rc);
+    sgnet_free(&r);
+    if (!err) notify_acm(handle, guid, wlan_notification_acm_disconnected, &data, sizeof(data));
+    return err;
+}
+
