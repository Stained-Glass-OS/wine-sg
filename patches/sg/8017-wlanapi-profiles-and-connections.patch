+
+DWORD WINAPI WlanReasonCodeToString(DWORD code, DWORD size, WCHAR *buffer, void *reserved)
+{
+    const WCHAR *text = NULL;
+    WCHAR other[64];
+    unsigned int i;
+
+    TRACE("(%#lx, %lu, %p, %p)\n", code, size, buffer, reserved);
+
+    if (!buffer || !size || reserved) return ERROR_INVALID_PARAMETER;
+    for (i = 0; i < ARRAY_SIZE(reason_texts); i++)
+        if (reason_texts[i].code == code) { text = reason_texts[i].text; break; }
+    if (!text)
+    {
+        swprintf(other, ARRAY_SIZE(other), L"Reason code %#lx.", code);
+        text = other;
+    }
+    lstrcpynW(buffer, text, size);
+    return ERROR_SUCCESS;
+}
