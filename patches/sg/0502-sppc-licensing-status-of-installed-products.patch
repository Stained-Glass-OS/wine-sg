From: Stained Glass OS <dev@stained-glass.example>
Subject: sppc: SLGetLicensingStatusInformation reports the installed products, unlicensed

The status of every product (SKU) the installed licenses name for the
application asked about -- read from each license's applicationId and
productSkuId -- instead of a stub error. Nothing is activated by this
store, so each is unlicensed for want of a product key
(SL_E_PKEY_NOT_INSTALLED); the list is freed with LocalFree. Office asks for
it when its right is not granted, and closed with "cannot verify the
license" on the stub's error.

Gate: test/sppc-gate.sh (make test-sppc).

--- a/dlls/sppc/sppc.c
+++ b/dlls/sppc/sppc.c
@@ -18,6 +18,9 @@
  */
 
 #include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
@@ -31,12 +34,117 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(slc);
 
+static BOOL store_dir(const WCHAR *kind, WCHAR *dir);
+
+/* a GUID attribute of a license: <... name="NAME">{GUID}</...> */
+static BOOL license_guid(const char *text, const char *name, GUID *guid)
+{
+    char pattern[64], value[39];
+    const char *p;
+    int i;
+
+    snprintf(pattern, sizeof(pattern), "name=\"%s\">", name);
+    if (!(p = strstr(text, pattern))) return FALSE;
+    p += strlen(pattern);
+    for (i = 0; i < 38 && p[i] && p[i] != '<'; i++) value[i] = p[i];
+    value[i] = 0;
+    if (i != 38) return FALSE;
+    {
+        unsigned int d[11];
+        if (sscanf(value, "{%8x-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x}", &d[0], &d[1], &d[2], &d[3], &d[4],
+                   &d[5], &d[6], &d[7], &d[8], &d[9], &d[10]) != 11)
+            return FALSE;
+        guid->Data1 = d[0];
+        guid->Data2 = d[1];
+        guid->Data3 = d[2];
+        for (i = 0; i < 8; i++) guid->Data4[i] = d[3 + i];
+    }
+    return TRUE;
+}
+
+/* Stained Glass OS: the status of every product (SKU) the installed licenses
+ * name for the application asked about (and the product, if one is given).
+ * Nothing is activated here -- no product key or activation ever makes one
+ * licensed -- so each is honestly unlicensed, for want of a product key
+ * (SL_E_PKEY_NOT_INSTALLED); the product's own activation (Office: signing
+ * in) decides what the user may do. A stub here made Office say it "cannot
+ * verify the license" and close instead of offering to activate. */
 HRESULT WINAPI SLGetLicensingStatusInformation(HSLC handle, const SLID *app, const SLID *product,
                                                LPCWSTR name, UINT *count, SL_LICENSING_STATUS **status)
 {
-    FIXME("(%p %p %p %s %p %p) stub\n", handle, app, product, debugstr_w(name), count, status );
-
-    return SL_E_RIGHT_NOT_CONSUMED;
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH], path[MAX_PATH];
+    SL_LICENSING_STATUS *list = NULL, *grown;
+    WIN32_FIND_DATAW fd;
+    HANDLE find, file;
+    UINT n = 0, max = 0, i;
+
+    TRACE("(%p %s %s %s %p %p)\n", handle, debugstr_guid(app), debugstr_guid(product), debugstr_w(name), count, status);
+
+    if (!handle || !count || !status) return E_INVALIDARG;
+    *count = 0;
+    *status = NULL;
+    if (!store_dir(L"licenses", dir)) return SL_E_RIGHT_NOT_CONSUMED;
+    swprintf(pattern, MAX_PATH, L"%s\\*", dir);
+    if ((find = FindFirstFileW(pattern, &fd)) == INVALID_HANDLE_VALUE) return SL_E_RIGHT_NOT_CONSUMED;
+    do
+    {
+        GUID lic_app, sku;
+        DWORD size, got;
+        char *text;
+        BOOL seen = FALSE;
+
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        swprintf(path, MAX_PATH, L"%s\\%s", dir, fd.cFileName);
+        file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+        if (file == INVALID_HANDLE_VALUE) continue;
+        size = GetFileSize(file, NULL);
+        if (size == INVALID_FILE_SIZE || size > 16 * 1024 * 1024 || !(text = malloc(size + 1)))
+        {
+            CloseHandle(file);
+            continue;
+        }
+        if (!ReadFile(file, text, size, &got, NULL)) got = 0;
+        CloseHandle(file);
+        text[got] = 0;
+        if (license_guid(text, "productSkuId", &sku) &&
+            (!app || (license_guid(text, "applicationId", &lic_app) && IsEqualGUID(&lic_app, app))) &&
+            (!product || IsEqualGUID(&sku, product)))
+        {
+            for (i = 0; i < n; i++) if (IsEqualGUID(&list[i].SkuId, &sku)) seen = TRUE;
+            if (!seen && n == max)
+            {
+                max = max ? 2 * max : 8;
+                if (!(grown = realloc(list, max * sizeof(*list)))) seen = TRUE;
+                else list = grown;
+            }
+            if (!seen)
+            {
+                memset(&list[n], 0, sizeof(list[n]));
+                list[n].SkuId = sku;
+                list[n].eStatus = SL_LICENSING_STATUS_UNLICENSED;
+                list[n].hrReason = SL_E_PKEY_NOT_INSTALLED;
+                n++;
+            }
+        }
+        free(text);
+    } while (FindNextFileW(find, &fd));
+    FindClose(find);
+
+    if (!n)
+    {
+        free(list);
+        return SL_E_RIGHT_NOT_CONSUMED;
+    }
+    /* the caller frees the list with LocalFree */
+    if (!(*status = LocalAlloc(LMEM_FIXED, n * sizeof(**status))))
+    {
+        free(list);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(*status, list, n * sizeof(**status));
+    *count = n;
+    free(list);
+    return S_OK;
 }
 
 /* Stained Glass OS: a store for the licenses and product keys programs
