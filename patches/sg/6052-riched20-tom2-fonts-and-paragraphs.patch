From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: TOM2 fonts and paragraphs (6052)

ITextRange2::GetFont2/SetFont2/GetPara2/SetPara2 gave E_NOTIMPL, and the
fonts and paragraphs did not answer ITextFont2/ITextPara2. Programs
written against RichEdit 8's TOM2 ask for them first.

ITextFont2 and ITextPara2 are declared in tom.idl. A range's font is an
ITextFont2: GetEffects/SetEffects as tom effect bits on the text (with a
mask of what is the same over it), the link type and the character
repertoire of the text, and the layout options riched20 does not lay out
(ligatures, autospace, compression, double strike, scaling and the like,
extra properties by type) kept by the font and its duplicates; IsEqual2,
GetDuplicate2/SetDuplicate2. A range's paragraph is an ITextPara2:
GetEffects/SetEffects as PARAFORMAT2 effects, the East Asian options kept,
GetBorders E_NOTIMPL. A duplicate of a range's font now takes the text's
values at the time, not those of when the font was made.
---
diff --git a/dlls/riched20/richole.c b/dlls/riched20/richole.c
index 444752f..de2f780 100644
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -54,6 +54,8 @@ DEFINE_GUID(IID_ITextRange2, 0xc241f5e2, 0x7206, 0x11d8, 0xa2, 0xc7, 0x00, 0xa0,
 DEFINE_GUID(IID_ITextSelection2, 0xc241f5e1, 0x7206, 0x11d8, 0xa2, 0xc7, 0x00, 0xa0, 0xd1, 0xd6, 0xc6, 0xb3);
 DEFINE_GUID(IID_ITextFont, 0x8cc497c3, 0xa1df, 0x11ce, 0x80, 0x98, 0x00, 0xaa, 0x00, 0x47, 0xbe, 0x5d);
 DEFINE_GUID(IID_ITextPara, 0x8cc497c4, 0xa1df, 0x11ce, 0x80, 0x98, 0x00, 0xaa, 0x00, 0x47, 0xbe, 0x5d);
+DEFINE_GUID(IID_ITextFont2, 0xc241f5e3, 0x7206, 0x11d8, 0xa2, 0xc7, 0x00, 0xa0, 0xd1, 0xd6, 0xc6, 0xb3);
+DEFINE_GUID(IID_ITextPara2, 0xc241f5e4, 0x7206, 0x11d8, 0xa2, 0xc7, 0x00, 0xa0, 0xd1, 0xd6, 0xc6, 0xb3);
 
 static ITypeLib *typelib;
 
@@ -220,6 +222,23 @@ struct ITextRangeImpl {
     LONG start, end;
 };
 
+/* ITextFont2's options riched20 keeps but does not lay out */
+struct font2_state {
+    LONG autoligatures, autospace_alpha, autospace_numeric, autospace_parens, compression, cookie;
+    LONG double_strike, math_zone, mod_width_pairs, mod_width_space, old_numbers, overlapping;
+    LONG position_subsuper, scaling, underline_position, effects2, effects2_mask;
+    FLOAT space_extension;
+    LONG charrep;             /* a duplicate's; a range's is its text's */
+    UINT prop_count;
+    struct { LONG type, value; } props[16];
+};
+
+struct para2_state {
+    LONG font_alignment, hanging_punctuation, snap_to_grid, trim_punctuation;
+    UINT prop_count;
+    struct { LONG type, value; } props[16];
+};
+
 typedef struct ITextFontImpl {
     ITextFont ITextFont_iface;
     LONG ref;
@@ -229,6 +248,7 @@ typedef struct ITextFontImpl {
     BOOL get_cache_enabled;
     BOOL set_cache_enabled;
     LONG style;               /* ITextFont::SetStyle: a handle whose meaning is left to the implementation */
+    struct font2_state x;
 } ITextFontImpl;
 
 typedef struct ITextParaImpl {
@@ -237,6 +257,7 @@ typedef struct ITextParaImpl {
 
     ITextRange *range;   /* NULL for a duplicate: it then keeps its own format in fmt */
     PARAFORMAT2 fmt;
+    struct para2_state x;
 } ITextParaImpl;
 
 struct IOleClientSiteImpl {
@@ -4290,6 +4311,9 @@ static HRESULT WINAPI TextFont_QueryInterface(ITextFont *iface, REFIID riid, voi
     TRACE("(%p)->(%s %p)\n", This, debugstr_guid(riid), ppv);
 
     if (IsEqualIID(riid, &IID_ITextFont) ||
+#ifndef SG_MUTANT_NO_FONT2
+        IsEqualIID(riid, &IID_ITextFont2) ||
+#endif
         IsEqualIID(riid, &IID_IDispatch) ||
         IsEqualIID(riid, &IID_IUnknown))
     {
@@ -4406,7 +4430,7 @@ static HRESULT WINAPI TextFont_GetDuplicate(ITextFont *iface, ITextFont **ret)
     return create_textfont(NULL, This, ret);
 }
 
-static ITextFontVtbl textfontvtbl;
+static ITextFont2Vtbl textfontvtbl;
 
 static HRESULT WINAPI TextFont_SetDuplicate(ITextFont *iface, ITextFont *pFont)
 {
@@ -4428,7 +4452,7 @@ static HRESULT WINAPI TextFont_SetDuplicate(ITextFont *iface, ITextFont *pFont)
         return S_OK;
     }
 
-    if (pFont->lpVtbl != &textfontvtbl)
+    if ((const void *)pFont->lpVtbl != (const void *)&textfontvtbl)
         return E_INVALIDARG;
     src = impl_from_ITextFont(pFont);
     for (id = FONT_PROPID_FIRST; id < FONT_PROPID_LAST; id++)
@@ -4476,7 +4500,7 @@ static HRESULT WINAPI TextFont_IsEqual(ITextFont *iface, ITextFont *font, LONG *
     *ret = tomFalse;
     if (!font)
         return S_FALSE;
-    if (font->lpVtbl != &textfontvtbl)
+    if ((const void *)font->lpVtbl != (const void *)&textfontvtbl)
         return S_FALSE;
     other = impl_from_ITextFont(font);
 
@@ -5071,69 +5095,519 @@ static HRESULT WINAPI TextFont_SetWeight(ITextFont *iface, LONG value)
     return set_textfont_propl(This, FONT_WEIGHT, value);
 }
 
-static ITextFontVtbl textfontvtbl = {
-    TextFont_QueryInterface,
-    TextFont_AddRef,
-    TextFont_Release,
-    TextFont_GetTypeInfoCount,
-    TextFont_GetTypeInfo,
-    TextFont_GetIDsOfNames,
-    TextFont_Invoke,
-    TextFont_GetDuplicate,
-    TextFont_SetDuplicate,
-    TextFont_CanChange,
-    TextFont_IsEqual,
-    TextFont_Reset,
-    TextFont_GetStyle,
-    TextFont_SetStyle,
-    TextFont_GetAllCaps,
-    TextFont_SetAllCaps,
-    TextFont_GetAnimation,
-    TextFont_SetAnimation,
-    TextFont_GetBackColor,
-    TextFont_SetBackColor,
-    TextFont_GetBold,
-    TextFont_SetBold,
-    TextFont_GetEmboss,
-    TextFont_SetEmboss,
-    TextFont_GetForeColor,
-    TextFont_SetForeColor,
-    TextFont_GetHidden,
-    TextFont_SetHidden,
-    TextFont_GetEngrave,
-    TextFont_SetEngrave,
-    TextFont_GetItalic,
-    TextFont_SetItalic,
-    TextFont_GetKerning,
-    TextFont_SetKerning,
-    TextFont_GetLanguageID,
-    TextFont_SetLanguageID,
-    TextFont_GetName,
-    TextFont_SetName,
-    TextFont_GetOutline,
-    TextFont_SetOutline,
-    TextFont_GetPosition,
-    TextFont_SetPosition,
-    TextFont_GetProtected,
-    TextFont_SetProtected,
-    TextFont_GetShadow,
-    TextFont_SetShadow,
-    TextFont_GetSize,
-    TextFont_SetSize,
-    TextFont_GetSmallCaps,
-    TextFont_SetSmallCaps,
-    TextFont_GetSpacing,
-    TextFont_SetSpacing,
-    TextFont_GetStrikeThrough,
-    TextFont_SetStrikeThrough,
-    TextFont_GetSubscript,
-    TextFont_SetSubscript,
-    TextFont_GetSuperscript,
-    TextFont_SetSuperscript,
-    TextFont_GetUnderline,
-    TextFont_SetUnderline,
-    TextFont_GetWeight,
-    TextFont_SetWeight
+/* Stained Glass OS: ITextFont2. The TOM2 character properties: what
+ * CHARFORMAT2 holds (effects, the character set as a character repertoire,
+ * links) is read from and written to the range; the OpenType and East Asian
+ * layout options riched20 does not lay out are kept by the font object
+ * (and its duplicates), so they read back as set. */
+
+static const struct
+{
+    LONG effect;                /* tom effect bit, without its high bit */
+    enum textfont_prop_id prop; /* FONT_PROPID_LAST: CHARFORMAT2 only */
+    DWORD cfm, cfe;
+}
+font2_effects[] =
+{
+    { 0x00000001, FONT_BOLD,          CFM_BOLD,        CFE_BOLD },
+    { 0x00000002, FONT_ITALIC,        CFM_ITALIC,      CFE_ITALIC },
+    { 0x00000004, FONT_UNDERLINE,     CFM_UNDERLINE,   CFE_UNDERLINE },
+    { 0x00000008, FONT_STRIKETHROUGH, CFM_STRIKEOUT,   CFE_STRIKEOUT },
+    { 0x00000010, FONT_PROTECTED,     CFM_PROTECTED,   CFE_PROTECTED },
+    { 0x00000020, FONT_PROPID_LAST,   CFM_LINK,        CFE_LINK },
+    { 0x00000040, FONT_SMALLCAPS,     CFM_SMALLCAPS,   CFE_SMALLCAPS },
+    { 0x00000080, FONT_ALLCAPS,       CFM_ALLCAPS,     CFE_ALLCAPS },
+    { 0x00000100, FONT_HIDDEN,        CFM_HIDDEN,      CFE_HIDDEN },
+    { 0x00000200, FONT_OUTLINE,       CFM_OUTLINE,     CFE_OUTLINE },
+    { 0x00000400, FONT_SHADOW,        CFM_SHADOW,      CFE_SHADOW },
+    { 0x00000800, FONT_EMBOSS,        CFM_EMBOSS,      CFE_EMBOSS },
+    { 0x00001000, FONT_ENGRAVE,       CFM_IMPRINT,     CFE_IMPRINT },
+    { 0x00002000, FONT_PROPID_LAST,   CFM_DISABLED,    CFE_DISABLED },
+    { 0x00004000, FONT_PROPID_LAST,   CFM_REVISED,     CFE_REVISED },
+    { 0x00010000, FONT_SUBSCRIPT,     CFM_SUBSCRIPT,   CFE_SUBSCRIPT },
+    { 0x00020000, FONT_SUPERSCRIPT,   CFM_SUPERSCRIPT, CFE_SUPERSCRIPT },
+};
+
+/* tomAnsi .. tomMac, as character sets */
+static const BYTE charrep_charsets[] =
+{
+    ANSI_CHARSET, EASTEUROPE_CHARSET, RUSSIAN_CHARSET, GREEK_CHARSET, TURKISH_CHARSET, HEBREW_CHARSET,
+    ARABIC_CHARSET, BALTIC_CHARSET, VIETNAMESE_CHARSET, DEFAULT_CHARSET, SYMBOL_CHARSET, THAI_CHARSET,
+    SHIFTJIS_CHARSET, GB2312_CHARSET, HANGEUL_CHARSET, CHINESEBIG5_CHARSET, 254 /* PC437 */, OEM_CHARSET,
+    MAC_CHARSET,
+};
+
+static LONG charset_to_charrep(BYTE charset)
+{
+    LONG i;
+    for (i = 0; i < ARRAY_SIZE(charrep_charsets); i++)
+        if (charrep_charsets[i] == charset) return i;
+    return 9; /* tomDefaultCharRep */
+}
+
+static inline ITextFontImpl *impl_from_ITextFont2(ITextFont2 *iface)
+{
+    return CONTAINING_RECORD((ITextFont *)iface, ITextFontImpl, ITextFont_iface);
+}
+
+static BOOL font2_live(const ITextFontImpl *font)
+{
+    return font->range && !font->get_cache_enabled;
+}
+
+/* the range's character format: what is the same over all of it is in dwMask */
+static HRESULT font2_get_format(ITextFontImpl *font, CHARFORMAT2W *fmt)
+{
+    const struct text_services *services;
+    ME_Cursor from, to;
+    LONG start, end;
+
+    if (!(services = get_range_reole(font->range))) return CO_E_RELEASED;
+    memset(fmt, 0, sizeof(*fmt));
+    fmt->cbSize = sizeof(*fmt);
+    fmt->dwMask = CFM_ALL2;
+    ITextRange_GetStart(font->range, &start);
+    ITextRange_GetEnd(font->range, &end);
+    cursor_from_char_ofs( services->editor, start, &from );
+    if (end > start) cursor_from_char_ofs( services->editor, end, &to );
+    else
+    {
+        to = from;
+        ME_MoveCursorChars( services->editor, &to, 1, FALSE );
+    }
+    ME_GetCharFormat( services->editor, &from, &to, fmt );
+    return S_OK;
+}
+
+static HRESULT font2_set_format(ITextFontImpl *font, CHARFORMAT2W *fmt)
+{
+    const struct text_services *services;
+    ME_Cursor from, to;
+    LONG start, end;
+
+    if (!(services = get_range_reole(font->range))) return CO_E_RELEASED;
+    fmt->cbSize = sizeof(*fmt);
+    ITextRange_GetStart(font->range, &start);
+    ITextRange_GetEnd(font->range, &end);
+    cursor_from_char_ofs( services->editor, start, &from );
+    cursor_from_char_ofs( services->editor, end, &to );
+    ME_SetCharFormat( services->editor, &from, &to, fmt );
+    ME_CommitUndo( services->editor );
+    ME_WrapMarkedParagraphs( services->editor );
+    ME_UpdateScrollBar( services->editor );
+    return S_OK;
+}
+
+static HRESULT WINAPI TextFont2_GetCount(ITextFont2 *iface, LONG *count)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+    TRACE("(%p)->(%p)\n", This, count);
+    if (!count) return E_INVALIDARG;
+    *count = This->x.prop_count;
+    return S_OK;
+}
+
+/* the kept options: tomTrue, tomFalse or tomToggle for the switches */
+static HRESULT font2_set_switch(ITextFontImpl *font, LONG *field, LONG value)
+{
+    if (value == tomUndefined) return S_OK;
+    if (value == tomToggle) value = *field == tomTrue ? tomFalse : tomTrue;
+    if (value != tomTrue && value != tomFalse) return E_INVALIDARG;
+    *field = value;
+    return S_OK;
+}
+
+#define FONT2_SWITCH(name, field) \
+    static HRESULT WINAPI TextFont2_Get##name(ITextFont2 *iface, LONG *value) \
+    { \
+        ITextFontImpl *This = impl_from_ITextFont2(iface); \
+        TRACE("(%p)->(%p)\n", This, value); \
+        if (!value) return E_INVALIDARG; \
+        *value = This->x.field; \
+        return S_OK; \
+    } \
+    static HRESULT WINAPI TextFont2_Set##name(ITextFont2 *iface, LONG value) \
+    { \
+        ITextFontImpl *This = impl_from_ITextFont2(iface); \
+        TRACE("(%p)->(%ld)\n", This, value); \
+        return font2_set_switch(This, &This->x.field, value); \
+    }
+
+#define FONT2_VALUE(name, field) \
+    static HRESULT WINAPI TextFont2_Get##name(ITextFont2 *iface, LONG *value) \
+    { \
+        ITextFontImpl *This = impl_from_ITextFont2(iface); \
+        TRACE("(%p)->(%p)\n", This, value); \
+        if (!value) return E_INVALIDARG; \
+        *value = This->x.field; \
+        return S_OK; \
+    } \
+    static HRESULT WINAPI TextFont2_Set##name(ITextFont2 *iface, LONG value) \
+    { \
+        ITextFontImpl *This = impl_from_ITextFont2(iface); \
+        TRACE("(%p)->(%ld)\n", This, value); \
+        if (value != tomUndefined) This->x.field = value; \
+        return S_OK; \
+    }
+
+FONT2_SWITCH(AutoLigatures, autoligatures)
+FONT2_SWITCH(AutospaceAlpha, autospace_alpha)
+FONT2_SWITCH(AutospaceNumeric, autospace_numeric)
+FONT2_SWITCH(AutospaceParens, autospace_parens)
+FONT2_VALUE(CompressionMode, compression)
+FONT2_VALUE(Cookie, cookie)
+FONT2_SWITCH(DoubleStrike, double_strike)
+FONT2_SWITCH(MathZone, math_zone)
+FONT2_SWITCH(ModWidthPairs, mod_width_pairs)
+FONT2_SWITCH(ModWidthSpace, mod_width_space)
+FONT2_SWITCH(OldNumbers, old_numbers)
+FONT2_SWITCH(Overlapping, overlapping)
+FONT2_VALUE(PositionSubSuper, position_subsuper)
+FONT2_VALUE(Scaling, scaling)
+FONT2_VALUE(UnderlinePositionMode, underline_position)
+
+static HRESULT WINAPI TextFont2_GetCharRep(ITextFont2 *iface, LONG *value)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+    CHARFORMAT2W fmt;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, value);
+    if (!value) return E_INVALIDARG;
+    if (!font2_live(This))
+    {
+        *value = This->x.charrep;
+        return S_OK;
+    }
+    if (FAILED(hr = font2_get_format(This, &fmt))) return hr;
+    *value = fmt.dwMask & CFM_CHARSET ? charset_to_charrep(fmt.bCharSet) : tomUndefined;
+    return S_OK;
+}
+
+static HRESULT WINAPI TextFont2_SetCharRep(ITextFont2 *iface, LONG value)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+    CHARFORMAT2W fmt;
+
+    TRACE("(%p)->(%ld)\n", This, value);
+    if (value == tomUndefined) return S_OK;
+    if (value < 0 || value >= ARRAY_SIZE(charrep_charsets)) return E_INVALIDARG;
+    if (!This->range || This->set_cache_enabled)
+    {
+        This->x.charrep = value;
+        return S_OK;
+    }
+    memset(&fmt, 0, sizeof(fmt));
+    fmt.dwMask = CFM_CHARSET;
+    fmt.bCharSet = charrep_charsets[value];
+    return font2_set_format(This, &fmt);
+}
+
+static HRESULT WINAPI TextFont2_GetDuplicate2(ITextFont2 *iface, ITextFont2 **ret)
+{
+    TRACE("(%p)->(%p)\n", iface, ret);
+    return ITextFont_GetDuplicate((ITextFont *)iface, (ITextFont **)ret);
+}
+
+static HRESULT WINAPI TextFont2_SetDuplicate2(ITextFont2 *iface, ITextFont2 *font)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, font);
+    if (!font) return E_INVALIDARG;
+    if (FAILED(hr = ITextFont_SetDuplicate((ITextFont *)iface, (ITextFont *)font))) return hr;
+    if ((const void *)font->lpVtbl == (const void *)&textfontvtbl)
+    {
+        const ITextFontImpl *src = impl_from_ITextFont2(font);
+        LONG charrep = src->x.charrep;
+
+        if (font2_live(src)) TextFont2_GetCharRep(font, &charrep);
+        This->x = src->x;
+        if (charrep != tomUndefined) TextFont2_SetCharRep(iface, charrep);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI TextFont2_GetLinkType(ITextFont2 *iface, LONG *value)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+    CHARFORMAT2W fmt;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, value);
+    if (!value) return E_INVALIDARG;
+    *value = 0; /* tomNoLink */
+    if (!font2_live(This)) return S_OK;
+    if (FAILED(hr = font2_get_format(This, &fmt))) return hr;
+    if (!(fmt.dwMask & CFM_LINK)) *value = tomUndefined;
+    else if (fmt.dwEffects & CFE_LINK) *value = 1; /* tomClientLink */
+    return S_OK;
+}
+
+static HRESULT WINAPI TextFont2_GetSpaceExtension(ITextFont2 *iface, FLOAT *value)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+    if (!value) return E_INVALIDARG;
+    *value = This->x.space_extension;
+    return S_OK;
+}
+
+static HRESULT WINAPI TextFont2_SetSpaceExtension(ITextFont2 *iface, FLOAT value)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+    if (value != tomUndefined) This->x.space_extension = value;
+    return S_OK;
+}
+
+/* the effects that are the same over the font's text, as tom effect bits */
+static HRESULT WINAPI TextFont2_GetEffects(ITextFont2 *iface, LONG *value, LONG *mask)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+    CHARFORMAT2W fmt;
+    LONG v = 0, m = 0, prop;
+    BOOL live = font2_live(This);
+    HRESULT hr;
+    UINT i;
+
+    TRACE("(%p)->(%p %p)\n", This, value, mask);
+    if (!value || !mask) return E_INVALIDARG;
+    if (live && FAILED(hr = font2_get_format(This, &fmt))) return hr;
+    for (i = 0; i < ARRAY_SIZE(font2_effects); i++)
+    {
+        /* the font's own properties where it has them (they tell mixed text), CHARFORMAT2 for the rest */
+        if (live && font2_effects[i].prop == FONT_PROPID_LAST)
+        {
+            if (!(fmt.dwMask & font2_effects[i].cfm)) continue;
+            m |= font2_effects[i].effect;
+            if (fmt.dwEffects & font2_effects[i].cfe) v |= font2_effects[i].effect;
+            continue;
+        }
+        if (font2_effects[i].prop == FONT_PROPID_LAST) continue;
+        if (FAILED(get_textfont_propl(This, font2_effects[i].prop, &prop)) || prop == tomUndefined) continue;
+        m |= font2_effects[i].effect;
+        if (prop == tomTrue) v |= font2_effects[i].effect;
+    }
+#ifdef SG_MUTANT_FONT2_EFFECTS_NONE
+    v = m = 0;
+#endif
+    *value = v ? v | 0x80000000 : 0;
+    *mask = m ? m | 0x80000000 : 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI TextFont2_SetEffects(ITextFont2 *iface, LONG value, LONG mask)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+    CHARFORMAT2W fmt;
+    UINT i;
+
+    TRACE("(%p)->(%#lx %#lx)\n", This, value, mask);
+    value &= 0x7fffffff;
+    mask &= 0x7fffffff;
+    if (This->range && !This->set_cache_enabled)
+    {
+        memset(&fmt, 0, sizeof(fmt));
+        for (i = 0; i < ARRAY_SIZE(font2_effects); i++)
+        {
+            if (!(mask & font2_effects[i].effect)) continue;
+            fmt.dwMask |= font2_effects[i].cfm;
+            if (value & font2_effects[i].effect) fmt.dwEffects |= font2_effects[i].cfe;
+        }
+        return fmt.dwMask ? font2_set_format(This, &fmt) : S_OK;
+    }
+    for (i = 0; i < ARRAY_SIZE(font2_effects); i++)
+    {
+        if (!(mask & font2_effects[i].effect) || font2_effects[i].prop == FONT_PROPID_LAST) continue;
+        set_textfont_propl(This, font2_effects[i].prop, value & font2_effects[i].effect ? tomTrue : tomFalse);
+    }
+    return S_OK;
+}
+
+/* the second set of effects (tomAutoTextColor and the like) are kept */
+static HRESULT WINAPI TextFont2_GetEffects2(ITextFont2 *iface, LONG *value, LONG *mask)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+    if (!value || !mask) return E_INVALIDARG;
+    *value = This->x.effects2;
+    *mask = This->x.effects2_mask;
+    return S_OK;
+}
+
+static HRESULT WINAPI TextFont2_SetEffects2(ITextFont2 *iface, LONG value, LONG mask)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+    This->x.effects2 = (This->x.effects2 & ~mask) | (value & mask);
+    This->x.effects2_mask |= mask;
+    return S_OK;
+}
+
+/* the extra properties, by type */
+static HRESULT WINAPI TextFont2_GetProperty(ITextFont2 *iface, LONG type, LONG *value)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+    UINT i;
+
+    TRACE("(%p)->(%#lx %p)\n", This, type, value);
+    if (!value) return E_INVALIDARG;
+    *value = tomUndefined;
+    for (i = 0; i < This->x.prop_count; i++)
+        if (This->x.props[i].type == type) *value = This->x.props[i].value;
+    return S_OK;
+}
+
+static HRESULT WINAPI TextFont2_GetPropertyInfo(ITextFont2 *iface, LONG index, LONG *type, LONG *value)
+{
+    ITextFontImpl *This = impl_from_ITextFont2(iface);
+
