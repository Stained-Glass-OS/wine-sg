+/* a job's port: the printer and job it is for, and through the driver's
+ * language monitor (its OpenPortEx is given the port monitor to use), as
+ * Windows' spooler does */
+static void open_port_for_job(port_t *port, const WCHAR *port_name)
+{
+    struct scheduling *sched = scheduling_tls != TLS_OUT_OF_INDEXES ? TlsGetValue(scheduling_tls) : NULL;
+    WCHAR monitor[MAX_PATH];
+    BOOL ok = FALSE;
+
+    if (!sched) return;
+    port->printer = wcsdup(sched->printer);
+    port->job_id = sched->job_id;
+    port->port_name = wcsdup(port_name);
+#ifdef SG_MUTANT_LANGMON
+    return;
+#endif
+    if (!driver_monitor(sched->printer, monitor, ARRAY_SIZE(monitor))) return;
+    if (!(port->lm = monitor_load(monitor, NULL))) return;
+    if (port->lm->monitor.pfnOpenPortEx && port->lm->monitor.pfnStartDocPort && port->lm->monitor.pfnWritePort &&
+        port->lm->monitor.pfnEndDocPort && port->lm->monitor.pfnClosePort)
+    {
+        /* a maker's monitor that fails here is left out: the job still prints */
+        __TRY
+        {
+            ok = port->lm->monitor.pfnOpenPortEx(port->lm->hmon, port->mon->hmon, (WCHAR *)port_name, port->printer,
+                                                 &port->hlm, (MONITOR2 *)&port->mon->monitor);
+        }
+        __EXCEPT_ALL
+        {
+            WARN("language monitor %s failed opening %s\n", debugstr_w(monitor), debugstr_w(port_name));
+            ok = FALSE;
+        }
+        __ENDTRY
+    }
+    if (!ok)
+    {
+        WARN("language monitor %s did not open %s; the port is used directly\n", debugstr_w(monitor),
+             debugstr_w(port_name));
+        monitor_unload(port->lm);
+        port->lm = NULL;
+        port->hlm = NULL;
+        return;
+    }
+    TRACE("%s through language monitor %s\n", debugstr_w(port_name), debugstr_w(monitor));
+}
