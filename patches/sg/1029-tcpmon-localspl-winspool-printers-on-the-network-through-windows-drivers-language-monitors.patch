+/*
+ * A Windows printer driver's job, sent to a printer on the network as
+ * Windows' Standard TCP/IP Port does: raw on a TCP port (9100, "JetDirect")
+ * or by the LPR protocol (RFC 1179).  Ports are made and changed through the
+ * monitor's documented Xcv interface (tcpxcv.h: AddPort, ConfigPort,
+ * DeletePort, GetConfigInfo with PORT_DATA_1) and kept where Windows keeps
+ * them, so the spooler finds their monitor by their name.  A port named by
+ * a URL (ipp://, ipps://, http://, https://) sends the job by IPP
+ * (RFC 8011, Print-Job) to that printer.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "winsock2.h"
+#include "ws2tcpip.h"
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "winspool.h"
+#include "winhttp.h"
+#include "ddk/winsplp.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(tcpmon);
+
+/* tcpxcv.h */
+#define PROTOCOL_RAWTCP_TYPE 1
+#define PROTOCOL_LPR_TYPE    2
+#define MAX_PORTNAME_LEN            64
+#define MAX_NETWORKNAME_LEN         49
+#define MAX_SNMP_COMMUNITY_STR_LEN  33
+#define MAX_QUEUENAME_LEN           33
+#define MAX_IPADDR_STR_LEN          16
+
+typedef struct
+{
+    WCHAR sztPortName[MAX_PORTNAME_LEN];
+    DWORD dwVersion;
+    DWORD dwProtocol;
+    DWORD cbSize;
+    DWORD dwReserved;
+    WCHAR sztHostAddress[MAX_NETWORKNAME_LEN];
+    WCHAR sztSNMPCommunity[MAX_SNMP_COMMUNITY_STR_LEN];
+    DWORD dwDoubleSpool;
+    WCHAR sztQueue[MAX_QUEUENAME_LEN];
+    WCHAR sztIPAddress[MAX_IPADDR_STR_LEN];
+    BYTE  Reserved[540];
+    DWORD dwPortNumber;
+    DWORD dwSNMPEnabled;
+    DWORD dwSNMPDevIndex;
+} PORT_DATA_1;
+
+typedef struct
+{
+    WCHAR psztPortName[MAX_PORTNAME_LEN];
+    BYTE  Reserved[98];
+    DWORD dwVersion;
+    DWORD dwReserved;
+} DELETE_PORT_DATA_1;
+
+#define MONITOR_NAME L"Standard TCP/IP Port"
+#define PORTS_KEY L"System\\CurrentControlSet\\Control\\Print\\Monitors\\Standard TCP/IP Port\\Ports"
+
+enum protocol { PROTO_RAW = PROTOCOL_RAWTCP_TYPE, PROTO_LPR = PROTOCOL_LPR_TYPE, PROTO_IPP };
+
+struct port
+{
+    WCHAR    name[MAX_PATH];
+    enum protocol protocol;
+    WCHAR    host[256];
+    DWORD    number;
+    WCHAR    queue[MAX_PATH];
+    WCHAR    url[MAX_PATH];         /* an IPP printer's */
+    SOCKET   sock;                  /* raw: while a job goes */
+    HANDLE   spool;                 /* LPR and IPP: the job, until it is whole */
+    WCHAR    spool_path[MAX_PATH];
+    WCHAR    printer[MAX_PATH];
+    WCHAR    document[MAX_PATH];
+    DWORD    job;
+    BOOL     failed;
+};
+
+struct xcv
+{
+    WCHAR       name[MAX_PATH];
+    ACCESS_MASK access;
+};
+
+static BOOL winsock_started;
+
+static void start_winsock(void)
+{
+    WSADATA data;
+    if (!winsock_started && !WSAStartup( MAKEWORD( 2, 2 ), &data )) winsock_started = TRUE;
+}
+
+static BOOL is_url( const WCHAR *name )
+{
+    return !wcsnicmp( name, L"ipp://", 6 ) || !wcsnicmp( name, L"ipps://", 7 ) ||
+           !wcsnicmp( name, L"http://", 7 ) || !wcsnicmp( name, L"https://", 8 );
+}
+
+/* ---- the ports' settings, where Windows keeps them ---- */
+
+static BOOL read_port( const WCHAR *name, struct port *port )
+{
+    HKEY key;
+    WCHAR path[MAX_PATH * 2];
+    DWORD size, value;
+
+    memset( port, 0, sizeof(*port) );
+    port->sock = INVALID_SOCKET;
+    port->spool = INVALID_HANDLE_VALUE;
+    lstrcpynW( port->name, name, ARRAY_SIZE(port->name) );
+    if (is_url( name ))
+    {
+        port->protocol = PROTO_IPP;
+        lstrcpynW( port->url, name, ARRAY_SIZE(port->url) );
+        return TRUE;
+    }
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", PORTS_KEY, name );
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key )) return FALSE;
+    size = sizeof(value);
+    port->protocol = !RegQueryValueExW( key, L"Protocol", NULL, NULL, (BYTE *)&value, &size ) &&
+                     value == PROTOCOL_LPR_TYPE ? PROTO_LPR : PROTO_RAW;
+    size = sizeof(port->host);
+    if (RegQueryValueExW( key, L"HostName", NULL, NULL, (BYTE *)port->host, &size ) || !port->host[0])
+    {
+        size = sizeof(port->host);
+        RegQueryValueExW( key, L"IPAddress", NULL, NULL, (BYTE *)port->host, &size );
+    }
+    size = sizeof(value);
+    port->number = !RegQueryValueExW( key, L"PortNumber", NULL, NULL, (BYTE *)&value, &size ) && value ? value :
+                   port->protocol == PROTO_LPR ? 515 : 9100;
+    size = sizeof(port->queue);
+    RegQueryValueExW( key, L"Queue", NULL, NULL, (BYTE *)port->queue, &size );
+    RegCloseKey( key );
+    TRACE( "%s: %s %s:%lu %s\n", debugstr_w(name), port->protocol == PROTO_LPR ? "LPR" : "RAW",
+           debugstr_w(port->host), port->number, debugstr_w(port->queue) );
+    return port->host[0] != 0;
+}
+
+static DWORD write_port_data( const PORT_DATA_1 *data, BOOL create )
+{
+    WCHAR path[MAX_PATH * 2];
+    DWORD value, disp;
+    HKEY key;
+    LONG res;
+
+    if (!data || !data->sztPortName[0] || wcschr( data->sztPortName, '\\' )) return ERROR_INVALID_PARAMETER;
+    if (data->dwProtocol != PROTOCOL_RAWTCP_TYPE && data->dwProtocol != PROTOCOL_LPR_TYPE)
+        return ERROR_INVALID_PARAMETER;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", PORTS_KEY, data->sztPortName );
+    if (create)
+    {
+        if ((res = RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, &disp )))
+            return res;
+        if (disp == REG_OPENED_EXISTING_KEY)
+        {
+            RegCloseKey( key );
+            return ERROR_ALREADY_EXISTS;
+        }
+    }
+    else if ((res = RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_ALL_ACCESS, &key ))) return res;
+
+    value = data->dwProtocol;
+    RegSetValueExW( key, L"Protocol", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+    value = 1;
+    RegSetValueExW( key, L"Version", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+    RegSetValueExW( key, L"HostName", 0, REG_SZ, (BYTE *)data->sztHostAddress,
+                    (wcslen( data->sztHostAddress ) + 1) * sizeof(WCHAR) );
+    RegSetValueExW( key, L"IPAddress", 0, REG_SZ, (BYTE *)data->sztIPAddress,
+                    (wcslen( data->sztIPAddress ) + 1) * sizeof(WCHAR) );
+    value = data->dwPortNumber ? data->dwPortNumber : data->dwProtocol == PROTOCOL_LPR_TYPE ? 515 : 9100;
+    RegSetValueExW( key, L"PortNumber", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+    RegSetValueExW( key, L"Queue", 0, REG_SZ, (BYTE *)data->sztQueue, (wcslen( data->sztQueue ) + 1) * sizeof(WCHAR) );
+    value = data->dwDoubleSpool;
+    RegSetValueExW( key, L"Double Spool", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+    RegSetValueExW( key, L"SNMP Community", 0, REG_SZ, (BYTE *)data->sztSNMPCommunity,
+                    (wcslen( data->sztSNMPCommunity ) + 1) * sizeof(WCHAR) );
+    value = data->dwSNMPEnabled;
+    RegSetValueExW( key, L"SNMP Enabled", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+    value = data->dwSNMPDevIndex;
+    RegSetValueExW( key, L"SNMP Index", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+    RegCloseKey( key );
+    TRACE( "%s %s\n", create ? "added" : "configured", debugstr_w(data->sztPortName) );
+    return ERROR_SUCCESS;
+}
+
+/* ---- the network ---- */
+
+static SOCKET connect_to( const WCHAR *host, DWORD number )
+{
+    ADDRINFOW hints, *result, *ai;
+    WCHAR service[16];
+    SOCKET sock = INVALID_SOCKET;
+    DWORD timeout = 30000;
+
+    start_winsock();
+    memset( &hints, 0, sizeof(hints) );
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_protocol = IPPROTO_TCP;
+    swprintf( service, ARRAY_SIZE(service), L"%lu", number );
+    if (GetAddrInfoW( host, service, &hints, &result ))
+    {
+        WARN( "cannot find %s\n", debugstr_w(host) );
+        return INVALID_SOCKET;
+    }
+    for (ai = result; ai && sock == INVALID_SOCKET; ai = ai->ai_next)
+    {
+        if ((sock = socket( ai->ai_family, ai->ai_socktype, ai->ai_protocol )) == INVALID_SOCKET) continue;
+        setsockopt( sock, SOL_SOCKET, SO_SNDTIMEO, (char *)&timeout, sizeof(timeout) );
+        setsockopt( sock, SOL_SOCKET, SO_RCVTIMEO, (char *)&timeout, sizeof(timeout) );
+        if (connect( sock, ai->ai_addr, ai->ai_addrlen ))
+        {
+            closesocket( sock );
+            sock = INVALID_SOCKET;
+        }
+    }
+    FreeAddrInfoW( result );
+    if (sock == INVALID_SOCKET) WARN( "cannot reach %s:%lu\n", debugstr_w(host), number );
+    return sock;
+}
+
+static BOOL send_all( SOCKET sock, const void *buf, DWORD size )
+{
+    const char *p = buf;
+    while (size)
+    {
+        int n = send( sock, p, min( size, 65536 ), 0 );
+        if (n <= 0) return FALSE;
+        p += n;
+        size -= n;
+    }
+    return TRUE;
+}
+
+/* RFC 1179: a zero byte says yes */
+static BOOL lpr_ack( SOCKET sock )
+{
+    char c;
+    return recv( sock, &c, 1, 0 ) == 1 && !c;
+}
+
+/* a value for a line of the protocol: no line ends in it, and no spaces
+ * where the protocol separates by them */
+static void to_ascii( const WCHAR *in, char *out, int size, BOOL spaces )
+{
+    char *p;
+    WideCharToMultiByte( CP_UTF8, 0, in, -1, out, size, NULL, NULL );
+    out[size - 1] = 0;
+    for (p = out; *p; p++) if (*p == '\n' || *p == '\r' || (!spaces && *p == ' ')) *p = '_';
+}
+
+static BOOL send_file( SOCKET sock, HANDLE file )
+{
+    char buf[65536];
+    DWORD got;
+
+    SetFilePointer( file, 0, NULL, FILE_BEGIN );
+    while (ReadFile( file, buf, sizeof(buf), &got, NULL ) && got)
+        if (!send_all( sock, buf, got )) return FALSE;
+    return TRUE;
+}
+
+static BOOL lpr_send( struct port *port )
+{
+    char queue[128], host[64], user[64], title[128], file[128], control[1024], cmd[512];
+    DWORD size = GetFileSize( port->spool, NULL ), user_len = ARRAY_SIZE(user);
+    WCHAR userW[64];
+    unsigned int job = port->job % 1000;
+    SOCKET sock;
+    BOOL ret = FALSE;
+    int len;
+
+    if ((sock = connect_to( port->host, port->number )) == INVALID_SOCKET) return FALSE;
+    to_ascii( port->queue[0] ? port->queue : L"lp", queue, sizeof(queue), FALSE );
+    gethostname( host, sizeof(host) );
+    host[31] = 0;
+    if (!GetUserNameW( userW, &user_len )) wcscpy( userW, L"user" );
+    to_ascii( userW, user, sizeof(user), FALSE );
+    to_ascii( port->document[0] ? port->document : L"document", title, sizeof(title), TRUE );
+    to_ascii( port->document[0] ? port->document : L"document", file, sizeof(file), FALSE );
+
+    len = snprintf( control, sizeof(control), "H%s\nP%s\nJ%s\nldfA%03u%s\nUdfA%03u%s\nN%s\n", host, user, title, job,
+                    host, job, host, file );
+    snprintf( cmd, sizeof(cmd), "\002%s\n", queue );
+    if (!send_all( sock, cmd, strlen( cmd ) ) || !lpr_ack( sock )) goto done;
+    snprintf( cmd, sizeof(cmd), "\002%d cfA%03u%s\n", len, job, host );
+    if (!send_all( sock, cmd, strlen( cmd ) ) || !lpr_ack( sock )) goto done;
+    if (!send_all( sock, control, len + 1 /* and a zero byte */ ) || !lpr_ack( sock )) goto done;
+    snprintf( cmd, sizeof(cmd), "\003%lu dfA%03u%s\n", size, job, host );
+    if (!send_all( sock, cmd, strlen( cmd ) ) || !lpr_ack( sock )) goto done;
+    if (!send_file( sock, port->spool ) || !send_all( sock, "", 1 ) || !lpr_ack( sock )) goto done;
+    ret = TRUE;
+done:
+    if (!ret) WARN( "LPR to %s queue %s failed\n", debugstr_w(port->host), queue );
+    closesocket( sock );
+    return ret;
+}
+
+/* ---- IPP (RFC 8010/8011): Print-Job ---- */
+
+static BYTE *ipp_attr( BYTE *p, BYTE tag, const char *name, const char *value )
+{
+    size_t n = strlen( name ), v = strlen( value );
+    *p++ = tag;
+    *p++ = n >> 8; *p++ = n & 0xff;
+    memcpy( p, name, n ); p += n;
+    *p++ = v >> 8; *p++ = v & 0xff;
+    memcpy( p, value, v ); p += v;
+    return p;
+}
+
+static BOOL ipp_send( struct port *port )
+{
+    URL_COMPONENTSW url;
+    WCHAR scheme[16], host[256], path[1024];
+    char printer_uri[1100], user[64], title[256];
+    BYTE header[4096], *p = header;
+    WCHAR userW[64];
+    DWORD user_len = ARRAY_SIZE(userW), size = GetFileSize( port->spool, NULL ), status = 0, got;
+    HINTERNET session = NULL, connect = NULL, request = NULL;
+    INTERNET_PORT number;
+    BOOL secure, ret = FALSE;
+    BYTE reply[16];
+    char buf[65536];
+
+    memset( &url, 0, sizeof(url) );
+    url.dwStructSize = sizeof(url);
+    url.lpszScheme = scheme; url.dwSchemeLength = ARRAY_SIZE(scheme);
+    url.lpszHostName = host; url.dwHostNameLength = ARRAY_SIZE(host);
+    url.lpszUrlPath = path; url.dwUrlPathLength = ARRAY_SIZE(path);
+    {
+        /* ipp:// is http:// on port 631, ipps:// https:// */
+        WCHAR http_url[MAX_PATH + 8];
+        if (!wcsnicmp( port->url, L"ipps://", 7 )) swprintf( http_url, ARRAY_SIZE(http_url), L"https://%s", port->url + 7 );
+        else if (!wcsnicmp( port->url, L"ipp://", 6 )) swprintf( http_url, ARRAY_SIZE(http_url), L"http://%s", port->url + 6 );
+        else lstrcpynW( http_url, port->url, ARRAY_SIZE(http_url) );
+        if (!WinHttpCrackUrl( http_url, 0, 0, &url )) return FALSE;
+    }
+    secure = url.nScheme == INTERNET_SCHEME_HTTPS;
+    number = url.nPort;
+    if ((!wcsnicmp( port->url, L"ipp://", 6 ) || !wcsnicmp( port->url, L"ipps://", 7 )) &&
+        !wcschr( port->url + 7, ':' ))
+        number = 631;
+    if (!path[0]) wcscpy( path, L"/ipp/print" );
+
+    WideCharToMultiByte( CP_UTF8, 0, port->url, -1, printer_uri, sizeof(printer_uri), NULL, NULL );
+    if (!GetUserNameW( userW, &user_len )) wcscpy( userW, L"user" );
+    WideCharToMultiByte( CP_UTF8, 0, userW, -1, user, sizeof(user), NULL, NULL );
+    WideCharToMultiByte( CP_UTF8, 0, port->document[0] ? port->document : L"document", -1, title, sizeof(title),
+                         NULL, NULL );
+    *p++ = 1; *p++ = 1;                 /* version 1.1 */
+    *p++ = 0; *p++ = 2;                 /* Print-Job */
+    *p++ = 0; *p++ = 0; *p++ = 0; *p++ = 1;   /* request-id */
+    *p++ = 0x01;                        /* operation attributes */
+    p = ipp_attr( p, 0x47, "attributes-charset", "utf-8" );
+    p = ipp_attr( p, 0x48, "attributes-natural-language", "en" );
+    p = ipp_attr( p, 0x45, "printer-uri", printer_uri );
+    p = ipp_attr( p, 0x42, "requesting-user-name", user );
+    p = ipp_attr( p, 0x42, "job-name", title );
+    p = ipp_attr( p, 0x49, "document-format", "application/octet-stream" );
+    *p++ = 0x03;                        /* end of attributes */
+
+    if (!(session = WinHttpOpen( L"Stained Glass print monitor", WINHTTP_ACCESS_TYPE_NO_PROXY, NULL, NULL, 0 )))
+        goto done;
+    if (!(connect = WinHttpConnect( session, host, number, 0 ))) goto done;
+    if (!(request = WinHttpOpenRequest( connect, L"POST", path, NULL, NULL, NULL, secure ? WINHTTP_FLAG_SECURE : 0 )))
+        goto done;
+    if (secure)
+    {
+        /* printers' certificates are their own, as Windows' IPP client accepts them */
+        DWORD flags = SECURITY_FLAG_IGNORE_UNKNOWN_CA | SECURITY_FLAG_IGNORE_CERT_CN_INVALID |
+                      SECURITY_FLAG_IGNORE_CERT_DATE_INVALID;
+        WinHttpSetOption( request, WINHTTP_OPTION_SECURITY_FLAGS, &flags, sizeof(flags) );
+    }
+    if (!WinHttpSendRequest( request, L"Content-Type: application/ipp\r\n", -1, header, p - header,
+                             (p - header) + size, 0 ))
+        goto done;
+    SetFilePointer( port->spool, 0, NULL, FILE_BEGIN );
+    while (ReadFile( port->spool, buf, sizeof(buf), &got, NULL ) && got)
+    {
+        DWORD written;
+        if (!WinHttpWriteData( request, buf, got, &written )) goto done;
+    }
+    if (!WinHttpReceiveResponse( request, NULL )) goto done;
+    got = sizeof(status);
+    WinHttpQueryHeaders( request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, NULL, &status, &got, NULL );
+    if (status != 200 || !WinHttpReadData( request, reply, sizeof(reply), &got ) || got < 4) goto done;
+    /* the status-code: successful-ok and its variants are 0x0000-0x00ff */
+    ret = reply[2] == 0;
+    TRACE( "IPP status %02x%02x\n", reply[2], reply[3] );
+done:
+    if (!ret) WARN( "IPP to %s failed (HTTP %lu, error %lu)\n", debugstr_w(port->url), status, GetLastError() );
+    if (request) WinHttpCloseHandle( request );
+    if (connect) WinHttpCloseHandle( connect );
+    if (session) WinHttpCloseHandle( session );
+    return ret;
+}
+
+/* ---- the monitor ---- */
+
+static BOOL WINAPI tcpmon_EnumPorts( HANDLE monitor, WCHAR *name, DWORD level, BYTE *buf, DWORD size,
+                                     DWORD *needed, DWORD *returned )
+{
+    WCHAR names[64][MAX_PORTNAME_LEN];
+    DWORD count = 0, i, len, entry = level == 1 ? sizeof(PORT_INFO_1W) : sizeof(PORT_INFO_2W), total;
+    HKEY key;
+    WCHAR *strings;
+
+    TRACE( "(%p %s %lu %p %lu)\n", monitor, debugstr_w(name), level, buf, size );
+    if (level != 1 && level != 2)
+    {
+        SetLastError( ERROR_INVALID_LEVEL );
+        return FALSE;
+    }
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, PORTS_KEY, 0, KEY_READ, &key ))
+    {
+        for (i = 0; count < ARRAY_SIZE(names); i++)
+        {
+            len = ARRAY_SIZE(names[0]);
+            if (RegEnumKeyExW( key, i, names[count], &len, NULL, NULL, NULL, NULL )) break;
+            count++;
+        }
+        RegCloseKey( key );
+    }
+    total = count * entry;
+    for (i = 0; i < count; i++)
+    {
+        total += (wcslen( names[i] ) + 1) * sizeof(WCHAR);
+        if (level == 2) total += 2 * sizeof(MONITOR_NAME);
+    }
+    *needed = total;
+    *returned = 0;
+    if (!buf || size < total)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    strings = (WCHAR *)(buf + count * entry);
+    for (i = 0; i < count; i++)
+    {
+        WCHAR *port_name = strings;
+        wcscpy( strings, names[i] );
+        strings += wcslen( names[i] ) + 1;
+        if (level == 1) ((PORT_INFO_1W *)buf)[i].pName = port_name;
+        else
+        {
+            PORT_INFO_2W *pi = &((PORT_INFO_2W *)buf)[i];
+            pi->pPortName = port_name;
+            pi->pMonitorName = strings;
+            wcscpy( strings, MONITOR_NAME );
+            strings += ARRAY_SIZE(MONITOR_NAME);
+            pi->pDescription = strings;
+            wcscpy( strings, MONITOR_NAME );
+            strings += ARRAY_SIZE(MONITOR_NAME);
+            pi->fPortType = PORT_TYPE_WRITE | PORT_TYPE_READ;
+            pi->Reserved = 0;
+        }
+    }
+    *returned = count;
+    return TRUE;
+}
+
+static BOOL WINAPI tcpmon_OpenPort( HANDLE monitor, WCHAR *name, HANDLE *handle )
+{
+    struct port *port = malloc( sizeof(*port) );
+
+    TRACE( "(%p %s %p)\n", monitor, debugstr_w(name), handle );
+    if (!port || !read_port( name, port ))
+    {
+        free( port );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *handle = port;
+    return TRUE;
+}
+
+static BOOL WINAPI tcpmon_StartDocPort( HANDLE handle, WCHAR *printer, DWORD job, DWORD level, BYTE *info )
+{
+    struct port *port = handle;
+    DOC_INFO_1W *doc = (DOC_INFO_1W *)info;
+    WCHAR dir[MAX_PATH];
+
+    TRACE( "(%p %s %lu)\n", handle, debugstr_w(printer), job );
+    port->failed = FALSE;
+    port->job = job;
+    lstrcpynW( port->printer, printer ? printer : L"", ARRAY_SIZE(port->printer) );
+    lstrcpynW( port->document, doc && doc->pDocName ? doc->pDocName : L"", ARRAY_SIZE(port->document) );
+    if (port->protocol == PROTO_RAW)
+    {
+        if (port->sock != INVALID_SOCKET) return TRUE;
+#ifndef SG_MUTANT_RAWPORT
+        port->sock = connect_to( port->host, port->number );
+#endif
+        if (port->sock == INVALID_SOCKET)
+        {
+            SetLastError( ERROR_NOT_READY );
+            return FALSE;
+        }
+        return TRUE;
+    }
+    /* LPR and IPP send the whole job at once: it is gathered first */
+    if (port->spool != INVALID_HANDLE_VALUE) return TRUE;
+    GetTempPathW( ARRAY_SIZE(dir), dir );
+    GetTempFileNameW( dir, L"tcp", 0, port->spool_path );
+    port->spool = CreateFileW( port->spool_path, GENERIC_READ | GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
+                               FILE_ATTRIBUTE_TEMPORARY | FILE_FLAG_DELETE_ON_CLOSE, NULL );
+    return port->spool != INVALID_HANDLE_VALUE;
+}
+
+static BOOL WINAPI tcpmon_WritePort( HANDLE handle, BYTE *buf, DWORD size, DWORD *written )
+{
+    struct port *port = handle;
+
+    *written = 0;
+    if (port->protocol == PROTO_RAW)
+    {
+        if (port->sock == INVALID_SOCKET || !send_all( port->sock, buf, size ))
+        {
+            port->failed = TRUE;
+            SetLastError( ERROR_NOT_READY );
+            return FALSE;
+        }
+        *written = size;
+        return TRUE;
+    }
+    return WriteFile( port->spool, buf, size, written, NULL );
+}
+
+static BOOL WINAPI tcpmon_ReadPort( HANDLE handle, BYTE *buf, DWORD size, DWORD *read )
+{
+    struct port *port = handle;
+    u_long avail = 0;
+    int n;
+
+    /* what a raw-port printer says back, for a language monitor */
+    *read = 0;
+    if (port->protocol != PROTO_RAW || port->sock == INVALID_SOCKET) return TRUE;
+    if (ioctlsocket( port->sock, FIONREAD, &avail ) || !avail) return TRUE;
+    if ((n = recv( port->sock, (char *)buf, min( size, avail ), 0 )) > 0) *read = n;
+    return TRUE;
+}
+
+static BOOL WINAPI tcpmon_EndDocPort( HANDLE handle )
+{
+    struct port *port = handle;
+    BOOL ret = TRUE;
+    HANDLE printer;
+
+    TRACE( "(%p)\n", handle );
+    switch (port->protocol)
+    {
+    case PROTO_RAW:
+        if (port->sock != INVALID_SOCKET)
+        {
+            shutdown( port->sock, SD_SEND );
+            closesocket( port->sock );
+            port->sock = INVALID_SOCKET;
+        }
+        ret = !port->failed;
+        break;
+    case PROTO_LPR:
+#ifndef SG_MUTANT_LPR
+        if (port->spool != INVALID_HANDLE_VALUE) ret = lpr_send( port );
+#endif
+        break;
+    case PROTO_IPP:
+#ifndef SG_MUTANT_IPP
+        if (port->spool != INVALID_HANDLE_VALUE) ret = ipp_send( port );
+#endif
+        break;
+    }
+    if (port->spool != INVALID_HANDLE_VALUE)
+    {
+        CloseHandle( port->spool );
+        port->spool = INVALID_HANDLE_VALUE;
+    }
+    /* the job has gone to the printer */
+    if (port->printer[0] && OpenPrinterW( port->printer, &printer, NULL ))
+    {
+        SetJobW( printer, port->job, 0, NULL, JOB_CONTROL_SENT_TO_PRINTER );
+        ClosePrinter( printer );
+    }
+    if (!ret) SetLastError( ERROR_NOT_READY );
+    return ret;
+}
+
+static BOOL WINAPI tcpmon_ClosePort( HANDLE handle )
+{
+    struct port *port = handle;
+
+    if (port->sock != INVALID_SOCKET) closesocket( port->sock );
+    if (port->spool != INVALID_HANDLE_VALUE) CloseHandle( port->spool );
+    free( port );
+    return TRUE;
+}
+
+static BOOL WINAPI tcpmon_XcvOpenPort( HANDLE monitor, const WCHAR *name, ACCESS_MASK access, HANDLE *handle )
+{
+    struct xcv *xcv = calloc( 1, sizeof(*xcv) );
+
+    TRACE( "(%p %s %#lx)\n", monitor, debugstr_w(name), access );
+    if (!xcv) return FALSE;
+    lstrcpynW( xcv->name, name ? name : L"", ARRAY_SIZE(xcv->name) );
+    xcv->access = access;
+    *handle = xcv;
+    return TRUE;
+}
+
+static void fill_port_data( const struct port *port, PORT_DATA_1 *data )
+{
+    memset( data, 0, sizeof(*data) );
+    lstrcpynW( data->sztPortName, port->name, MAX_PORTNAME_LEN );
+    data->dwVersion = 1;
+    data->dwProtocol = port->protocol == PROTO_LPR ? PROTOCOL_LPR_TYPE : PROTOCOL_RAWTCP_TYPE;
+    data->cbSize = sizeof(*data);
+    lstrcpynW( data->sztHostAddress, port->host, MAX_NETWORKNAME_LEN );
+    lstrcpynW( data->sztQueue, port->queue, MAX_QUEUENAME_LEN );
+    data->dwPortNumber = port->number;
+}
+
+static DWORD WINAPI tcpmon_XcvDataPort( HANDLE handle, const WCHAR *name, BYTE *in, DWORD in_size, BYTE *out,
+                                        DWORD out_size, DWORD *needed )
+{
+    struct xcv *xcv = handle;
+    struct port port;
+    WCHAR path[MAX_PATH * 2];
+
+    TRACE( "(%p %s %p %lu %p %lu)\n", handle, debugstr_w(name), in, in_size, out, out_size );
+    if (needed) *needed = 0;
+    if (!wcscmp( name, L"AddPort" ) || !wcscmp( name, L"ConfigPort" ))
+    {
+        if (!(xcv->access & SERVER_ACCESS_ADMINISTER)) return ERROR_ACCESS_DENIED;
+        if (!in || in_size < sizeof(PORT_DATA_1)) return ERROR_INVALID_PARAMETER;
+#ifdef SG_MUTANT_XCVADDPORT
+        return ERROR_SUCCESS;
+#endif
+        return write_port_data( (const PORT_DATA_1 *)in, !wcscmp( name, L"AddPort" ) );
+    }
+    if (!wcscmp( name, L"DeletePort" ))
+    {
+        const DELETE_PORT_DATA_1 *data = (const DELETE_PORT_DATA_1 *)in;
+        if (!(xcv->access & SERVER_ACCESS_ADMINISTER)) return ERROR_ACCESS_DENIED;
+        if (!in || in_size < sizeof(*data) || !data->psztPortName[0]) return ERROR_INVALID_PARAMETER;
+        swprintf( path, ARRAY_SIZE(path), L"%s\\%s", PORTS_KEY, data->psztPortName );
+        return RegDeleteKeyW( HKEY_LOCAL_MACHINE, path );
+    }
+    if (!wcscmp( name, L"GetConfigInfo" ))
+    {
+        const WCHAR *port_name = wcschr( xcv->name, ',' ) ? NULL : xcv->name;
+        if (needed) *needed = sizeof(PORT_DATA_1);
+        if (!out || out_size < sizeof(PORT_DATA_1)) return ERROR_INSUFFICIENT_BUFFER;
+        if (!port_name || !read_port( port_name, &port )) return ERROR_INVALID_PARAMETER;
+        fill_port_data( &port, (PORT_DATA_1 *)out );
+        return ERROR_SUCCESS;
+    }
+    if (!wcscmp( name, L"MonitorUI" )) return ERROR_INVALID_PARAMETER;   /* no UI DLL of ours */
+    FIXME( "%s\n", debugstr_w(name) );
+    return ERROR_INVALID_PARAMETER;
+}
+
+static BOOL WINAPI tcpmon_XcvClosePort( HANDLE handle )
+{
+    free( handle );
+    return TRUE;
+}
+
+static void WINAPI tcpmon_Shutdown( HANDLE monitor )
+{
+    if (winsock_started) WSACleanup();
+    winsock_started = FALSE;
+}
+
+static MONITOR2 tcpmon_monitor =
+{
+    sizeof(MONITOR2),
+    tcpmon_EnumPorts,
+    tcpmon_OpenPort,
+    NULL,                   /* OpenPortEx: a port monitor */
+    tcpmon_StartDocPort,
+    tcpmon_WritePort,
+    tcpmon_ReadPort,
+    tcpmon_EndDocPort,
+    tcpmon_ClosePort,
+    NULL, NULL, NULL, NULL, NULL, NULL,
+    tcpmon_XcvOpenPort,
+    tcpmon_XcvDataPort,
+    tcpmon_XcvClosePort,
+    tcpmon_Shutdown,
+};
+
