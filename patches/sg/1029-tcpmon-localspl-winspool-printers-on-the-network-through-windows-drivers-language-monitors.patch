+/* the language monitor of a printer's driver (DRIVER_INFO_3's pMonitorName) */
+static BOOL driver_monitor(const WCHAR *printer, WCHAR *monitor, DWORD size)
+{
+    WCHAR path[MAX_PATH * 2], driver[MAX_PATH];
+    DWORD len = sizeof(driver);
+    HKEY key;
+
+    monitor[0] = 0;
+    swprintf(path, ARRAY_SIZE(path), L"%s\\%s", printersW, printer);
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key)) return FALSE;
+    if (RegQueryValueExW(key, L"Printer Driver", NULL, NULL, (BYTE *)driver, &len)) driver[0] = 0;
+    RegCloseKey(key);
+    if (!driver[0]) return FALSE;
+    swprintf(path, ARRAY_SIZE(path), fmt_driversW, env_arch.envname, L"\\Version-3\\");
+    wcscat(path, driver);
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key)) return FALSE;
+    len = size * sizeof(WCHAR);
+    if (RegQueryValueExW(key, L"Monitor", NULL, NULL, (BYTE *)monitor, &len)) monitor[0] = 0;
+    RegCloseKey(key);
+    return monitor[0] != 0;
+}
