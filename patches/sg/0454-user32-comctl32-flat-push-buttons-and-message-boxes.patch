 /**********************************************************************
  *       Push Button Functions
  */
+
+/* Stained Glass OS: push buttons as Windows 10 draws them -- flat, a light
+ * face and a one-pixel border; the default or focused button's border in the
+ * highlight colour, and no dotted focus rectangle. Wine drew the Windows 95
+ * bevel and a dotted rectangle (field report: Setup's Next, installers'
+ * message boxes looked old). */
+static COLORREF sg_mix( COLORREF a, COLORREF b, int pct_b )
+{
+    return RGB( (GetRValue(a) * (100 - pct_b) + GetRValue(b) * pct_b) / 100,
+                (GetGValue(a) * (100 - pct_b) + GetGValue(b) * pct_b) / 100,
+                (GetBValue(a) * (100 - pct_b) + GetBValue(b) * pct_b) / 100 );
+}
+
+static void sg_draw_push_button( HDC dc, const RECT *rc, BOOL enabled, BOOL pushed, BOOL hot, BOOL accent )
+{
+    COLORREF face = GetSysColor( COLOR_BTNFACE ), hi = GetSysColor( COLOR_HIGHLIGHT );
+    COLORREF fill = sg_mix( face, RGB(0,0,0), 7 ), border = sg_mix( face, RGB(0,0,0), 30 );
+    HBRUSH brush;
+    RECT r = *rc;
+    int i;
+
+    if (!enabled) { fill = sg_mix( face, RGB(0,0,0), 4 ); border = sg_mix( face, RGB(0,0,0), 18 ); }
+    else if (pushed) { fill = sg_mix( face, hi, 28 ); border = sg_mix( hi, RGB(0,0,0), 20 ); }
+    else if (hot) { fill = sg_mix( face, hi, 12 ); border = hi; }
+    else if (accent) border = hi;
+
+    brush = CreateSolidBrush( border );
+    for (i = 0; i < ((accent && enabled && !pushed) ? 2 : 1); i++)
+    {
+        FrameRect( dc, &r, brush );
+        InflateRect( &r, -1, -1 );
+    }
+    DeleteObject( brush );
+    brush = CreateSolidBrush( fill );
+    FillRect( dc, &r, brush );
+    DeleteObject( brush );
+}
 static void PB_Paint( HWND hwnd, HDC hDC, UINT action )
 {
     RECT     rc, r;
