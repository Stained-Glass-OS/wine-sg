+   case WM_ERASEBKGND:
+   {
+       static const int ids[] = { IDOK, IDCANCEL, IDABORT, IDRETRY, IDIGNORE, IDYES, IDNO, IDTRYAGAIN, IDCONTINUE, IDHELP };
+       HDC dc = (HDC)wParam;
+       RECT client, band, r;
+       int i, top = -1;
+       HWND b;
+
+       GetClientRect( hwnd, &client );
+       for (i = 0; i < ARRAY_SIZE(ids); i++)
+       {
+           if (!(b = GetDlgItem( hwnd, ids[i] )) || !IsWindowVisible( b )) continue;
+           GetWindowRect( b, &r );
+           MapWindowPoints( 0, hwnd, (POINT *)&r, 2 );
+           if (top < 0 || r.top < top) top = r.top;
+       }
+       FillRect( dc, &client, GetSysColorBrush( COLOR_WINDOW ) );
