From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 22:53:40 -0700
Subject: [PATCH] wininet: FindFirstUrlCacheEntryEx and FindNextUrlCacheEntryEx

Both were stubs that found nothing. They now enumerate the cache the way
FindFirstUrlCacheEntry does, keeping the entries that have one of the type
bits of dwFilter (0: all) and the container chosen by the search pattern.
A cache group id is refused with ERROR_FILE_NOT_FOUND (groups are not kept).

diff --git a/dlls/wininet/urlcache.c b/dlls/wininet/urlcache.c
index 3a5b580..eecb9ef 100644
--- a/dlls/wininet/urlcache.c
+++ b/dlls/wininet/urlcache.c
@@ -191,6 +191,7 @@ typedef struct
     DWORD container_idx;
     DWORD hash_table_idx;
     DWORD hash_entry_idx;
+    DWORD filter; /* CacheEntryType bits an entry needs one of, 0: all */
 } find_handle;
 
 /* List of all containers available */
@@ -3391,6 +3392,47 @@ BOOL WINAPI FindNextUrlCacheContainerW( HANDLE handle, LPVOID p1, LPVOID p2 )
     return FALSE;
 }
 
+static BOOL urlcache_find_next_entry(HANDLE, LPINTERNET_CACHE_ENTRY_INFOA, LPDWORD, BOOL);
+
+static HANDLE find_first_entry_ex(const char *pattern, DWORD flags, DWORD filter, GROUPID group,
+        void *info, DWORD *size, BOOL unicode)
+{
+    find_handle *handle;
+
+    if (group)
+    {
+        /* cache groups are not kept */
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return NULL;
+    }
+    if (!size)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return NULL;
+    }
+    if (!(handle = malloc(sizeof(*handle))))
+        return NULL;
+    handle->magic = URLCACHE_FIND_ENTRY_HANDLE_MAGIC;
+    handle->url_search_pattern = pattern ? strdup(pattern) : NULL;
+    if (pattern && !handle->url_search_pattern)
+    {
+        free(handle);
+        return NULL;
+    }
+    handle->container_idx = 0;
+    handle->hash_table_idx = 0;
+    handle->hash_entry_idx = 0;
+    handle->filter = filter;
+
+    if (!urlcache_find_next_entry(handle, info, size, unicode))
+    {
+        free(handle->url_search_pattern);
+        free(handle);
+        return NULL;
+    }
+    return handle;
+}
+
 HANDLE WINAPI FindFirstUrlCacheEntryExA(
   LPCSTR lpszUrlSearchPattern,
   DWORD dwFlags,
@@ -3403,11 +3445,11 @@ HANDLE WINAPI FindFirstUrlCacheEntryExA(
   LPVOID lpReserved3
 )
 {
-    FIXME("(%s, 0x%08lx, 0x%08lx, 0x%s, %p, %p, %p, %p, %p) stub\n", debugstr_a(lpszUrlSearchPattern),
+    TRACE("(%s, 0x%08lx, 0x%08lx, 0x%s, %p, %p, %p, %p, %p)\n", debugstr_a(lpszUrlSearchPattern),
           dwFlags, dwFilter, wine_dbgstr_longlong(GroupId), lpFirstCacheEntryInfo,
           lpdwFirstCacheEntryInfoBufferSize, lpReserved, pcbReserved2,lpReserved3);
-    SetLastError(ERROR_FILE_NOT_FOUND);
-    return NULL;
+    return find_first_entry_ex(lpszUrlSearchPattern, dwFlags, dwFilter, GroupId, lpFirstCacheEntryInfo,
+                               lpdwFirstCacheEntryInfoBufferSize, FALSE);
 }
 
 HANDLE WINAPI FindFirstUrlCacheEntryExW(
@@ -3422,11 +3464,18 @@ HANDLE WINAPI FindFirstUrlCacheEntryExW(
   LPVOID lpReserved3
 )
 {
-    FIXME("(%s, 0x%08lx, 0x%08lx, 0x%s, %p, %p, %p, %p, %p) stub\n", debugstr_w(lpszUrlSearchPattern),
+    char *pattern = NULL;
+    HANDLE ret;
+
+    TRACE("(%s, 0x%08lx, 0x%08lx, 0x%s, %p, %p, %p, %p, %p)\n", debugstr_w(lpszUrlSearchPattern),
           dwFlags, dwFilter, wine_dbgstr_longlong(GroupId), lpFirstCacheEntryInfo,
           lpdwFirstCacheEntryInfoBufferSize, lpReserved, pcbReserved2,lpReserved3);
-    SetLastError(ERROR_FILE_NOT_FOUND);
-    return NULL;
+    if (lpszUrlSearchPattern && !(pattern = strdupWtoA(lpszUrlSearchPattern)))
+        return NULL;
+    ret = find_first_entry_ex(pattern, dwFlags, dwFilter, GroupId, lpFirstCacheEntryInfo,
+                              lpdwFirstCacheEntryInfoBufferSize, TRUE);
+    free(pattern);
+    return ret;
 }
 
 /***********************************************************************
@@ -3459,6 +3508,7 @@ INTERNETAPI HANDLE WINAPI FindFirstUrlCacheEntryA(LPCSTR lpszUrlSearchPattern,
     pEntryHandle->container_idx = 0;
     pEntryHandle->hash_table_idx = 0;
     pEntryHandle->hash_entry_idx = 0;
+    pEntryHandle->filter = 0;
 
     if (!FindNextUrlCacheEntryA(pEntryHandle, lpFirstCacheEntryInfo, lpdwFirstCacheEntryInfoBufferSize))
     {
@@ -3498,6 +3548,7 @@ INTERNETAPI HANDLE WINAPI FindFirstUrlCacheEntryW(LPCWSTR lpszUrlSearchPattern,
     pEntryHandle->container_idx = 0;
     pEntryHandle->hash_table_idx = 0;
     pEntryHandle->hash_entry_idx = 0;
+    pEntryHandle->filter = 0;
 
     if (!FindNextUrlCacheEntryW(pEntryHandle, lpFirstCacheEntryInfo, lpdwFirstCacheEntryInfoBufferSize))
     {
@@ -3553,6 +3604,10 @@ static BOOL urlcache_find_next_entry(
                     continue;
 
                 pUrlEntry = (const entry_url *)pEntry;
+#ifndef SG_MUTANT_WININET_NOFILTER
+                if (pEntryHandle->filter && !(pUrlEntry->cache_entry_type & pEntryHandle->filter))
+                    continue;
+#endif
                 TRACE("Found URL: %s\n",
                       debugstr_a((LPCSTR)pUrlEntry + pUrlEntry->url_off));
                 TRACE("Header info: %s\n",
@@ -3659,9 +3714,10 @@ BOOL WINAPI FindNextUrlCacheEntryExA(
   LPVOID lpReserved3
 )
 {
-    FIXME("(%p, %p, %p, %p, %p, %p) stub\n", hEnumHandle, lpFirstCacheEntryInfo, lpdwFirstCacheEntryInfoBufferSize,
+    TRACE("(%p, %p, %p, %p, %p, %p)\n", hEnumHandle, lpFirstCacheEntryInfo, lpdwFirstCacheEntryInfoBufferSize,
           lpReserved, pcbReserved2, lpReserved3);
-    return FALSE;
+    return urlcache_find_next_entry(hEnumHandle, (LPINTERNET_CACHE_ENTRY_INFOA)lpFirstCacheEntryInfo,
+                                    lpdwFirstCacheEntryInfoBufferSize, FALSE);
 }
 
 BOOL WINAPI FindNextUrlCacheEntryExW(
@@ -3673,9 +3729,10 @@ BOOL WINAPI FindNextUrlCacheEntryExW(
   LPVOID lpReserved3
 )
 {
-    FIXME("(%p, %p, %p, %p, %p, %p) stub\n", hEnumHandle, lpFirstCacheEntryInfo, lpdwFirstCacheEntryInfoBufferSize,
+    TRACE("(%p, %p, %p, %p, %p, %p)\n", hEnumHandle, lpFirstCacheEntryInfo, lpdwFirstCacheEntryInfoBufferSize,
           lpReserved, pcbReserved2, lpReserved3);
-    return FALSE;
+    return urlcache_find_next_entry(hEnumHandle, (LPINTERNET_CACHE_ENTRY_INFOA)lpFirstCacheEntryInfo,
+                                    lpdwFirstCacheEntryInfoBufferSize, TRUE);
 }
 
 BOOL WINAPI FindNextUrlCacheGroup( HANDLE hFind, GROUPID* lpGroupId, LPVOID lpReserved )
