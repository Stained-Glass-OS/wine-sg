 extern NTSTATUS logon_ticket( void *args );
+
+/* Stained Glass OS (1711): ask the broker to start a program as a launch
+ * ticket's account. No pointers. Returns STATUS_SUCCESS (started),
+ * STATUS_ACCESS_DENIED (refused), STATUS_NO_LOGON_SERVERS (no broker) or
+ * STATUS_UNSUCCESSFUL. */
+struct launch_request_params
+{
+    char         ticket[40];   /* 32 hex digits */
+    char         cwd[1024];    /* Unix path, UTF-8; "" for the account's home */
+    unsigned int args_len;     /* bytes of args used */
+    char         args[8192];   /* the command line's arguments, UTF-8, each NUL-terminated */
+};
+
+extern NTSTATUS launch_request( void *args );
--- a/dlls/advapi32/logon_unix.c
+++ b/dlls/advapi32/logon_unix.c
@@ -128,3 +128,38 @@ NTSTATUS logon_ticket( void *args )
     strcpy( params->ticket, line + 7 );
     return STATUS_SUCCESS;
 }
+
+/* The broker's request to start a program for a launch ticket (1711):
+ * "@launch", LAUNCH_TICKET and LAUNCH_CWD, an empty string, then the
+ * program's arguments; the answer a status byte (0 started). */
+NTSTATUS launch_request( void *args )
+{
+    struct launch_request_params *params = args;
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    const char *path = getenv( "SG_BROKER_SOCK" );
+    char blob[sizeof(params->args) + sizeof(params->cwd) + 128];
+    unsigned char status = 2;
+    uint32_t len;
+    int fd, ret;
+
+    if (!path || !*path) path = "/run/stained-glass-broker/broker.sock";
+    if (strlen( path ) >= sizeof(addr.sun_path)) return STATUS_NO_LOGON_SERVERS;
+    strcpy( addr.sun_path, path );
+    params->ticket[sizeof(params->ticket) - 1] = 0;
+    params->cwd[sizeof(params->cwd) - 1] = 0;
+    if (params->args_len > sizeof(params->args) || !params->args_len) return STATUS_INVALID_PARAMETER;
+
+    ret = snprintf( blob, sizeof(blob), "@launch%cLAUNCH_TICKET=%s%cLAUNCH_CWD=%s%c",
+                    0, params->ticket, 0, params->cwd, 0 );
+    if (ret < 0 || (size_t)ret + 1 + params->args_len > sizeof(blob)) return STATUS_INVALID_PARAMETER;
+    memcpy( blob + ret + 1, params->args, params->args_len );
+    len = ret + 1 + params->args_len;
+
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) < 0) return STATUS_NO_LOGON_SERVERS;
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ) < 0) { close( fd ); return STATUS_NO_LOGON_SERVERS; }
+    if (write_all( fd, &len, sizeof(len) ) || write_all( fd, blob, len )) { close( fd ); return STATUS_UNSUCCESSFUL; }
+    while ((ret = read( fd, &status, 1 )) < 0 && errno == EINTR) ;
+    close( fd );
+    if (ret != 1) return STATUS_UNSUCCESSFUL;
+    return !status ? STATUS_SUCCESS : status == 1 ? STATUS_ACCESS_DENIED : STATUS_UNSUCCESSFUL;
+}
