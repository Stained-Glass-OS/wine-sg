+/******************************************************************************
+ * CreateProcessWithLogonW
+ */
+/* Stained Glass OS (1711): a program for another account. Each process of
+ * a shared prefix runs as its Unix account, so a program for another account
+ * is started by the elevation broker's root monitor, as that account, with
+ * an environment made from that account alone: given a launch ticket, which
+ * the wineserver makes only for SYSTEM (CreateProcessAsUser:
+ * SeAssignPrimaryTokenPrivilege) or for whoever LogonUser gave the token to,
+ * and never for root, SYSTEM or another system account. The new process
+ * names the ticket when it starts; this waits for it and returns its
+ * handles. Its environment, creation flags and startup information are its
+ * account's own, not the caller's. */
+static BOOL token_is_other_account( HANDLE token )
+{
+    char mine[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE], theirs[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE];
+    DWORD len;
+
+    if (!token) return FALSE;
+    if (!GetTokenInformation( GetCurrentProcessToken(), TokenUser, mine, sizeof(mine), &len ) ||
+        !GetTokenInformation( token, TokenUser, theirs, sizeof(theirs), &len ))
+        return FALSE;
+    return !EqualSid( ((TOKEN_USER *)mine)->User.Sid, ((TOKEN_USER *)theirs)->User.Sid );
+}
+
+/* one argument of a command line, as the C runtime splits it */
+static const WCHAR *next_arg( const WCHAR *p, WCHAR *out, DWORD max )
+{
+    DWORD n = 0;
+    BOOL quoted = FALSE;
+
+    while (*p == ' ' || *p == '\t') p++;
+    if (!*p) return NULL;
+    while (*p && (quoted || (*p != ' ' && *p != '\t')))
+    {
+        if (*p == '\\')
+        {
+            unsigned int bs = 0;
+            while (*p == '\\') { bs++; p++; }
+            if (*p == '"')
+            {
+                while (bs >= 2 && n + 1 < max) { out[n++] = '\\'; bs -= 2; }
+                if (bs) { if (n + 1 < max) out[n++] = '"'; p++; }
+            }
+            else while (bs-- && n + 1 < max) out[n++] = '\\';
+            continue;
+        }
+        if (*p == '"')
+        {
+            if (quoted && p[1] == '"') { if (n + 1 < max) out[n++] = '"'; p += 2; continue; }
+            quoted = !quoted;
+            p++;
+            continue;
+        }
+        if (n + 1 < max) out[n++] = *p;
+        p++;
+    }
+    out[n] = 0;
+    return p;
+}
+
+static BOOL add_launch_arg( struct launch_request_params *params, const WCHAR *arg )
+{
+    int n = WideCharToMultiByte( CP_UTF8, 0, arg, -1, params->args + params->args_len,
+                                 sizeof(params->args) - params->args_len, NULL, NULL );
+    if (!n) return FALSE;
+    params->args_len += n;
+    return TRUE;
+}
+
+static INIT_ONCE launch_once = INIT_ONCE_STATIC_INIT;
+static BOOL launch_unix_ready;
+
+static BOOL CALLBACK launch_init( INIT_ONCE *once, void *param, void **context )
+{
+    launch_unix_ready = !__wine_init_unix_call();
+    return TRUE;
+}
+
+static BOOL launch_as( HANDLE token, const WCHAR *app, const WCHAR *cmdline, const WCHAR *dir,
+                       PROCESS_INFORMATION *info )
+{
+    struct launch_request_params *params;
+    WCHAR arg[MAX_PATH * 2], cwd[MAX_PATH];
+    const WCHAR *p = cmdline;
+    static char * (CDECL *get_unix_name)( const WCHAR * );
+    char *unix_cwd;
+    NTSTATUS status;
+    DWORD i;
+
+    if (!(params = calloc( 1, sizeof(*params) ))) { SetLastError( ERROR_NOT_ENOUGH_MEMORY ); return FALSE; }
+    SERVER_START_REQ( make_launch_ticket )
+    {
+        req->token = wine_server_obj_handle( token );
+        wine_server_set_reply( req, params->ticket, sizeof(params->ticket) - 1 );
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    if (status) { free( params ); SetLastError( RtlNtStatusToDosError( status ) ); return FALSE; }
+
+    /* the program, then its arguments */
+    if (app && *app)
+    {
+        add_launch_arg( params, app );
+        if (p) p = next_arg( p, arg, ARRAY_SIZE(arg) );  /* the command line's own first word */
+    }
+    else if (!p || !(p = next_arg( p, arg, ARRAY_SIZE(arg) )) || !add_launch_arg( params, arg ))
+    {
+        free( params );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    while (p && (p = next_arg( p, arg, ARRAY_SIZE(arg) )))
+        if (!add_launch_arg( params, arg )) { free( params ); SetLastError( ERROR_INVALID_PARAMETER ); return FALSE; }
+
+    if (!dir && GetCurrentDirectoryW( ARRAY_SIZE(cwd), cwd )) dir = cwd;
+    if (!get_unix_name)
+        get_unix_name = (void *)GetProcAddress( GetModuleHandleW( L"kernel32" ), "wine_get_unix_file_name" );
+    if (dir && get_unix_name && (unix_cwd = get_unix_name( dir )))
+    {
+        lstrcpynA( params->cwd, unix_cwd, sizeof(params->cwd) );
+        HeapFree( GetProcessHeap(), 0, unix_cwd );
+    }
+
+    InitOnceExecuteOnce( &launch_once, launch_init, NULL, NULL );
+    status = launch_unix_ready ? WINE_UNIX_CALL( unix_launch_request, params ) : STATUS_NO_LOGON_SERVERS;
+    if (status)
+    {
+        free( params );
+        SetLastError( status == STATUS_ACCESS_DENIED ? ERROR_ACCESS_DENIED :
+                      status == STATUS_NO_LOGON_SERVERS ? ERROR_SERVICE_NOT_ACTIVE : ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+
+    /* the new process names its ticket when it starts */
+    for (i = 0; i < 600; i++)
+    {
+        SERVER_START_REQ( claim_launch )
+        {
+            wine_server_add_data( req, params->ticket, 32 );
+            if (!(status = wine_server_call( req )))
+            {
+                info->hProcess = wine_server_ptr_handle( reply->process );
+                info->hThread = wine_server_ptr_handle( reply->thread );
+                info->dwProcessId = reply->pid;
+                info->dwThreadId = reply->tid;
+            }
+        }
+        SERVER_END_REQ;
+        if (status != STATUS_PENDING) break;
+        Sleep( 50 );
+    }
+    free( params );
+    if (status)
+    {
+        SetLastError( status == STATUS_PENDING ? ERROR_TIMEOUT : RtlNtStatusToDosError( status ) );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/******************************************************************************
+ * CreateProcessAsUserW   [ADVAPI32.@]
+ */
+BOOL WINAPI CreateProcessAsUserW( HANDLE token, const WCHAR *app, WCHAR *cmdline, SECURITY_ATTRIBUTES *process_attr,
+                                  SECURITY_ATTRIBUTES *thread_attr, BOOL inherit, DWORD flags, void *env,
+                                  const WCHAR *dir, STARTUPINFOW *startup, PROCESS_INFORMATION *info )
+{
+    TRACE( "%p %s %s %#lx\n", token, debugstr_w(app), debugstr_w(cmdline), flags );
+
+    if (token_is_other_account( token )) return launch_as( token, app, cmdline, dir, info );
+    return CreateProcessInternalW( token, app, cmdline, process_attr, thread_attr, inherit, flags, env,
+                                   dir, startup, info, NULL );
+}
