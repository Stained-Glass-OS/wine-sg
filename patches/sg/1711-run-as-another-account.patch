+
+/* Stained Glass OS (1711): running a program as another account
+ * (CreateProcessAsUser, CreateProcessWithTokenW, CreateProcessWithLogonW). A
+ * process of this server runs as its Unix account, so a program for another
+ * account is started by the elevation broker's root monitor, as that account
+ * -- given a launch ticket made here, which says who may have what: SYSTEM
+ * (SeAssignPrimaryTokenPrivilege: a service starting a program on a user's
+ * desktop with WTSQueryUserToken's token), or whoever LogonUser gave the
+ * token to. Never root, the SYSTEM account or another system account
+ * (below 1000). The new process names its ticket when it starts
+ * (register_launch); the requester then gets handles to it (claim_launch). */
+#define SG_LAUNCH_MAX 32
+#define SG_LAUNCH_LIFETIME 30
+static struct sg_launch
+{
+    char            name[33];
+    unsigned int    uid;
+    struct process *requester;   /* not referenced: compared only */
+    process_id_t    requester_id;
+    struct process *process;     /* the started process, referenced */
+    time_t          expires;
+} sg_launches[SG_LAUNCH_MAX];
+
+static const char *sg_ticket_dir(void)
+{
+    static const char *dir;
+    if (!dir && !(dir = getenv( "SG_LOGON_TICKET_DIR" ))) dir = "/run/stained-glass-broker/tickets";
+    return dir;
+}
+
+static void sg_launch_free( struct sg_launch *l )
+{
+    if (l->process) release_object( l->process );
+    memset( l, 0, sizeof(*l) );
+}
+
+static struct sg_launch *sg_launch_find( const char *name, data_size_t len )
+{
+    unsigned int i;
+    time_t now = time( NULL );
+
+    for (i = 0; i < SG_LAUNCH_MAX; i++)
+    {
+        if (!sg_launches[i].name[0]) continue;
+        if (sg_launches[i].expires < now) { sg_launch_free( &sg_launches[i] ); continue; }
+        if (len == 32 && !memcmp( sg_launches[i].name, name, 32 )) return &sg_launches[i];
+    }
+    return NULL;
+}
+
+DECL_HANDLER(make_launch_ticket)
+{
+    struct token *token;
+    struct sg_launch *l = NULL;
+    unsigned char rnd[16];
+    char path[512], text[160];
+    unsigned int i;
+    int fd, n, allowed;
+
+    if (!sg_system_prefix) { set_error( STATUS_NOT_SUPPORTED ); return; }
+    if (!(token = (struct token *)get_handle_obj( current->process, req->token,
+                                                   TOKEN_QUERY | TOKEN_ASSIGN_PRIMARY | TOKEN_DUPLICATE, &token_ops )))
+        return;
+    allowed = sg_requester_is_admin() || token->sg_logon_for == current->process->peer_uid;
+    if (!allowed) set_error( STATUS_PRIVILEGE_NOT_HELD );
+    else if (token->sg_unix_uid == ~0u || token->sg_unix_uid < 1000 || token->sg_unix_uid == sg_system_prefix_uid)
+        set_error( STATUS_ACCESS_DENIED );
+    else
+    {
+        sg_launch_find( "", 0 );  /* drop expired ones */
+        for (i = 0; i < SG_LAUNCH_MAX && !l; i++) if (!sg_launches[i].name[0]) l = &sg_launches[i];
+        if (!l) set_error( STATUS_TOO_MANY_SECRETS );
+    }
+    if (get_error() || !l) { release_object( token ); return; }
+
+    if (getrandom( rnd, sizeof(rnd), 0 ) != sizeof(rnd)) { set_error( STATUS_UNSUCCESSFUL ); release_object( token ); return; }
+    for (i = 0; i < 16; i++) snprintf( l->name + 2 * i, 3, "%02x", rnd[i] );
+    l->uid = token->sg_unix_uid;
+    l->requester = current->process;
+    l->requester_id = current->process->id;
+    l->expires = time( NULL ) + SG_LAUNCH_LIFETIME;
+    release_object( token );
+
+    snprintf( path, sizeof(path), "%s/%s", sg_ticket_dir(), l->name );
+    n = snprintf( text, sizeof(text), "kind=launch\nuid=%u\nfor=%u\nexpires=%lld\n", l->uid,
+                  (unsigned int)current->process->peer_uid, (long long)l->expires );
+    if ((fd = open( path, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600 )) < 0 ||
+        write( fd, text, n ) != n)
+    {
+        if (fd >= 0) { close( fd ); unlink( path ); }
+        memset( l, 0, sizeof(*l) );
+        set_error( STATUS_UNSUCCESSFUL );
+        return;
+    }
+    close( fd );
+    set_reply_data( l->name, 32 );
+}
+
+/* the started process names its ticket: only a process of the account the
+ * ticket is for, once */
+DECL_HANDLER(register_launch)
+{
+    struct sg_launch *l = sg_launch_find( get_req_data(), get_req_data_size() );
+
+    if (!l || l->process || l->uid != current->process->peer_uid) { set_error( STATUS_ACCESS_DENIED ); return; }
+    l->process = (struct process *)grab_object( current->process );
+}
+
+/* the requester gets the started process and its first thread, with full
+ * access, as CreateProcess gives them; STATUS_PENDING until it has started */
+DECL_HANDLER(claim_launch)
+{
+    struct sg_launch *l = sg_launch_find( get_req_data(), get_req_data_size() );
+    struct thread *thread;
+
+    if (!l || l->requester != current->process || l->requester_id != current->process->id)
+    {
+        set_error( STATUS_NOT_FOUND );
+        return;
+    }
+    if (!l->process) { set_error( STATUS_PENDING ); return; }
+    reply->pid = get_process_id( l->process );
+    reply->process = alloc_handle_no_access_check( current->process, l->process, PROCESS_ALL_ACCESS, 0 );
+    if (!list_empty( &l->process->thread_list ) &&
+        (thread = LIST_ENTRY( list_head( &l->process->thread_list ), struct thread, proc_entry )))
+    {
+        reply->tid = get_thread_id( thread );
+        reply->thread = alloc_handle_no_access_check( current->process, thread, THREAD_ALL_ACCESS, 0 );
+    }
+    sg_launch_free( l );
+}
