 static HRESULT WINAPI TextPara_SetIndents(ITextPara *iface, FLOAT StartIndent, FLOAT LeftIndent, FLOAT RightIndent)
 {
     ITextParaImpl *This = impl_from_ITextPara(iface);
-    FIXME("(%p)->(%.2f %.2f %.2f)\n", This, StartIndent, LeftIndent, RightIndent);
-    return E_NOTIMPL;
+    PARAFORMAT2 cur, fmt;
+    FLOAT first = StartIndent, left = LeftIndent;
+    HRESULT hr;
+
+    TRACE("(%p)->(%f %f %f)\n", This, StartIndent, LeftIndent, RightIndent);
+
+    if (FAILED(hr = textpara_get_fmt( This, &cur ))) return hr;
+    memset(&fmt, 0, sizeof(fmt));
+    fmt.cbSize = sizeof(fmt);
+
+    /* the first line is relative to the left indent: the format keeps
+     * where the first line starts and how far the others are from it */
+    if (first == tomUndefined) first = (cur.dwMask & PFM_OFFSET) ? twips_to_points( -cur.dxOffset ) : tomUndefined;
+    if (left == tomUndefined)
+        left = (cur.dwMask & (PFM_STARTINDENT | PFM_OFFSET)) == (PFM_STARTINDENT | PFM_OFFSET) ?
+               twips_to_points( cur.dxStartIndent + cur.dxOffset ) : tomUndefined;
+    if (first != tomUndefined && left != tomUndefined)
+    {
+        LONG first_twips = round_float( points_to_twips( first ) ), left_twips = round_float( points_to_twips( left ) );
