From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: ITextPara reads and writes paragraph formats (2015)

riched20: ITextPara reads and writes paragraph formats (2015)

ITextPara alignment, indents (first line, left, right, SetIndents), space
before/after, line spacing and rule, the keep/page-break/line-number/widow
and hyphenation flags, list type/start/tab, tab stops and style, applied to
the paragraphs the range touches without moving the editor's selection.
---
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -3520,6 +3520,301 @@
     return S_OK;
 }
 
+
+/* Stained Glass OS: ITextPara reads and writes the paragraph format of the
+ * paragraphs its range touches, by selecting the range in the editor for the
+ * duration of the call. */
+enum para_prop_id {
+    PARA_ALIGNMENT, PARA_HYPHENATION, PARA_KEEPTOGETHER, PARA_KEEPWITHNEXT, PARA_NOLINENUMBER,
+    PARA_PAGEBREAKBEFORE, PARA_WIDOWCONTROL, PARA_LEFTINDENT, PARA_FIRSTLINEINDENT, PARA_RIGHTINDENT,
+    PARA_SPACEBEFORE, PARA_SPACEAFTER, PARA_LINESPACING, PARA_LINESPACINGRULE, PARA_LISTTYPE,
+    PARA_LISTSTART, PARA_LISTTAB, PARA_STYLE
+};
+
+static inline LONG round_float(FLOAT f)
+{
+    return (LONG)(f < 0 ? f - 0.5f : f + 0.5f);
+}
+
+static HRESULT textpara_get_fmt(ITextParaImpl *para, PARAFORMAT2 *fmt)
+{
+    const struct text_services *services;
+    ME_Cursor saved[2], from, to;
+    LONG start, end;
+
+    if (!(services = get_range_reole(para->range))) return CO_E_RELEASED;
+
+    memset(fmt, 0, sizeof(*fmt));
+    fmt->cbSize = sizeof(*fmt);
+    ITextRange_GetStart(para->range, &start);
+    ITextRange_GetEnd(para->range, &end);
+    cursor_from_char_ofs( services->editor, start, &from );
+    cursor_from_char_ofs( services->editor, end, &to );
+    saved[0] = services->editor->pCursors[0];
+    saved[1] = services->editor->pCursors[1];
+    services->editor->pCursors[0] = from;
+    services->editor->pCursors[1] = to;
+    editor_get_selection_para_fmt( services->editor, fmt );
+    services->editor->pCursors[0] = saved[0];
+    services->editor->pCursors[1] = saved[1];
+    return S_OK;
+}
+
+static HRESULT textpara_set_fmt(ITextParaImpl *para, const PARAFORMAT2 *fmt)
+{
+    const struct text_services *services;
+    ME_Cursor saved[2], from, to;
+    LONG start, end;
+
+    if (!(services = get_range_reole(para->range))) return CO_E_RELEASED;
+
+    ITextRange_GetStart(para->range, &start);
+    ITextRange_GetEnd(para->range, &end);
+    cursor_from_char_ofs( services->editor, start, &from );
+    cursor_from_char_ofs( services->editor, end, &to );
+    saved[0] = services->editor->pCursors[0];
+    saved[1] = services->editor->pCursors[1];
+    services->editor->pCursors[0] = from;
+    services->editor->pCursors[1] = to;
+#ifdef SG_MUTANT_PARA_RANGE_FIRST_ONLY
+    services->editor->pCursors[1] = from;
+#endif
+    editor_set_selection_para_fmt( services->editor, fmt );
+#ifndef SG_MUTANT_PARA_SEL_KEPT_CHANGED
+    services->editor->pCursors[0] = saved[0];
+    services->editor->pCursors[1] = saved[1];
+#endif
+    ME_WrapMarkedParagraphs( services->editor );
+    ME_UpdateScrollBar( services->editor );
+    ME_CommitUndo( services->editor );
+    return S_OK;
+}
+
+static HRESULT textpara_get_long(ITextParaImpl *para, enum para_prop_id prop, LONG *value)
+{
+    PARAFORMAT2 fmt;
+    DWORD mask = 0, effect = 0;
+    BOOL invert = FALSE;
+    HRESULT hr;
+
+    if (!value) return E_INVALIDARG;
+    if (FAILED(hr = textpara_get_fmt( para, &fmt ))) return hr;
+
+    *value = tomUndefined;
+    switch (prop)
+    {
+    case PARA_HYPHENATION: mask = PFM_DONOTHYPHEN; invert = TRUE; break;
+    case PARA_KEEPTOGETHER: mask = PFM_KEEP; break;
+    case PARA_KEEPWITHNEXT: mask = PFM_KEEPNEXT; break;
+    case PARA_NOLINENUMBER: mask = PFM_NOLINENUMBER; break;
+    case PARA_PAGEBREAKBEFORE: mask = PFM_PAGEBREAKBEFORE; break;
+#ifdef SG_MUTANT_PARA_WIDOW_NOT_INVERTED
+    case PARA_WIDOWCONTROL: mask = PFM_NOWIDOWCONTROL; break;
+#else
+    case PARA_WIDOWCONTROL: mask = PFM_NOWIDOWCONTROL; invert = TRUE; break;
+#endif
+    default: break;
+    }
+    if (mask)
+    {
+        effect = mask >> 16;
+        if (!(fmt.dwMask & mask)) return S_OK;
+        *value = ((fmt.wEffects & effect) != 0) != invert ? tomTrue : tomFalse;
+        return S_OK;
+    }
+
+    switch (prop)
+    {
+    case PARA_ALIGNMENT:
+        if (!(fmt.dwMask & PFM_ALIGNMENT)) break;
+        switch (fmt.wAlignment)
+        {
+        case PFA_CENTER: *value = tomAlignCenter; break;
+        case PFA_RIGHT: *value = tomAlignRight; break;
+        case PFA_JUSTIFY: *value = tomAlignJustify; break;
+        default: *value = tomAlignLeft; break;
+        }
+        break;
+    case PARA_LINESPACINGRULE:
+        if (fmt.dwMask & PFM_LINESPACING) *value = fmt.bLineSpacingRule;
+        break;
+    case PARA_LISTTYPE:
+        if (!(fmt.dwMask & PFM_NUMBERING)) break;
+        *value = fmt.wNumbering;
+        if (fmt.wNumbering && (fmt.dwMask & PFM_NUMBERINGSTYLE)) *value |= (fmt.wNumberingStyle & 0xf00) << 8;
+        break;
+    case PARA_LISTSTART:
+        if (fmt.dwMask & PFM_NUMBERINGSTART) *value = fmt.wNumberingStart;
+        break;
+    case PARA_STYLE:
+        if (fmt.dwMask & PFM_STYLE) *value = fmt.sStyle;
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+    return S_OK;
+}
+
+static HRESULT textpara_get_float(ITextParaImpl *para, enum para_prop_id prop, FLOAT *value)
+{
+    PARAFORMAT2 fmt;
+    HRESULT hr;
+
+    if (!value) return E_INVALIDARG;
+    if (FAILED(hr = textpara_get_fmt( para, &fmt ))) return hr;
+
+    *value = tomUndefined;
+    switch (prop)
+    {
+    case PARA_LEFTINDENT:
+        if ((fmt.dwMask & (PFM_STARTINDENT | PFM_OFFSET)) == (PFM_STARTINDENT | PFM_OFFSET))
+            *value = twips_to_points( fmt.dxStartIndent + fmt.dxOffset );
+        break;
+    case PARA_FIRSTLINEINDENT:
+        if (fmt.dwMask & PFM_OFFSET) *value = twips_to_points( -fmt.dxOffset );
+        break;
+    case PARA_RIGHTINDENT:
+        if (fmt.dwMask & PFM_RIGHTINDENT) *value = twips_to_points( fmt.dxRightIndent );
+        break;
+    case PARA_SPACEBEFORE:
+        if (fmt.dwMask & PFM_SPACEBEFORE) *value = twips_to_points( fmt.dySpaceBefore );
+        break;
+    case PARA_SPACEAFTER:
+        if (fmt.dwMask & PFM_SPACEAFTER) *value = twips_to_points( fmt.dySpaceAfter );
+        break;
+    case PARA_LINESPACING:
+#ifdef SG_MUTANT_PARA_LINESPACING_UNITS
+        if (fmt.dwMask & PFM_LINESPACING) *value = fmt.dyLineSpacing;
+#else
+        if (fmt.dwMask & PFM_LINESPACING) *value = twips_to_points( fmt.dyLineSpacing );
+#endif
+        break;
+    case PARA_LISTTAB:
+        if (fmt.dwMask & PFM_NUMBERINGTAB) *value = twips_to_points( fmt.wNumberingTab );
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+    return S_OK;
+}
+
+static HRESULT textpara_set_long(ITextParaImpl *para, enum para_prop_id prop, LONG value)
+{
+    PARAFORMAT2 fmt;
+    DWORD mask = 0;
+    BOOL invert = FALSE;
+
+    memset(&fmt, 0, sizeof(fmt));
+    fmt.cbSize = sizeof(fmt);
+
+    switch (prop)
+    {
+    case PARA_HYPHENATION: mask = PFM_DONOTHYPHEN; invert = TRUE; break;
+    case PARA_KEEPTOGETHER: mask = PFM_KEEP; break;
+    case PARA_KEEPWITHNEXT: mask = PFM_KEEPNEXT; break;
+    case PARA_NOLINENUMBER: mask = PFM_NOLINENUMBER; break;
+    case PARA_PAGEBREAKBEFORE: mask = PFM_PAGEBREAKBEFORE; break;
+    case PARA_WIDOWCONTROL: mask = PFM_NOWIDOWCONTROL; invert = TRUE; break;
+    default: break;
+    }
+    if (mask)
+    {
+        BOOL on;
+        if (value == tomUndefined) return S_OK;
+        if (value == tomToggle)
+        {
+            PARAFORMAT2 cur;
+            BOOL current;
+            HRESULT hr = textpara_get_fmt( para, &cur );
+            if (FAILED(hr)) return hr;
+            current = (cur.dwMask & mask) && ((cur.wEffects & (mask >> 16)) != 0) != invert;
+            on = !current;
+        }
+        else if (value == tomTrue) on = TRUE;
+        else if (value == tomFalse) on = FALSE;
+        else return E_INVALIDARG;
+        fmt.dwMask = mask;
+        fmt.wEffects = (on != invert) ? (mask >> 16) : 0;
+        return textpara_set_fmt( para, &fmt );
+    }
+
+    switch (prop)
+    {
+    case PARA_ALIGNMENT:
+        if (value == tomUndefined) return S_OK;
+        fmt.dwMask = PFM_ALIGNMENT;
+        switch (value)
+        {
+        case tomAlignLeft: fmt.wAlignment = PFA_LEFT; break;
+        case tomAlignCenter: fmt.wAlignment = PFA_CENTER; break;
+        case tomAlignRight: fmt.wAlignment = PFA_RIGHT; break;
+        case tomAlignJustify: fmt.wAlignment = PFA_JUSTIFY; break;
+        default: return E_INVALIDARG;
+        }
+        break;
+    case PARA_LISTTYPE:
+        if (value == tomUndefined) return S_OK;
+        if ((value & 0xffff) > 6 || ((value >> 16) & 0xffff) > 3) return E_INVALIDARG;
+        fmt.dwMask = PFM_NUMBERING | PFM_NUMBERINGSTYLE;
+        fmt.wNumbering = value & 0xffff;
+        fmt.wNumberingStyle = ((value >> 16) & 0xf) << 8;
+        break;
+    case PARA_LISTSTART:
+        if (value == tomUndefined) return S_OK;
+        if (value < 0 || value > 0xffff) return E_INVALIDARG;
+        fmt.dwMask = PFM_NUMBERINGSTART;
+        fmt.wNumberingStart = value;
+        break;
+    case PARA_STYLE:
+        if (value == tomUndefined) return S_OK;
+        fmt.dwMask = PFM_STYLE;
+        fmt.sStyle = value;
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+    return textpara_set_fmt( para, &fmt );
+}
+
+static HRESULT textpara_set_float(ITextParaImpl *para, enum para_prop_id prop, FLOAT value)
+{
+    PARAFORMAT2 fmt;
+
+    if (value == tomUndefined) return S_OK;
+    memset(&fmt, 0, sizeof(fmt));
+    fmt.cbSize = sizeof(fmt);
+
+    switch (prop)
+    {
+    case PARA_RIGHTINDENT:
+        fmt.dwMask = PFM_RIGHTINDENT;
+        fmt.dxRightIndent = round_float( points_to_twips( value ) );
+        break;
+    case PARA_SPACEBEFORE:
+        if (value < 0) return E_INVALIDARG;
+        fmt.dwMask = PFM_SPACEBEFORE;
+        fmt.dySpaceBefore = round_float( points_to_twips( value ) );
+        break;
+    case PARA_SPACEAFTER:
+        if (value < 0) return E_INVALIDARG;
+        fmt.dwMask = PFM_SPACEAFTER;
+        fmt.dySpaceAfter = round_float( points_to_twips( value ) );
+        break;
+    case PARA_LISTTAB:
+        if (value < 0) return E_INVALIDARG;
+        fmt.dwMask = PFM_NUMBERINGTAB;
+        fmt.wNumberingTab = round_float( points_to_twips( value ) );
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+    return textpara_set_fmt( para, &fmt );
+}
