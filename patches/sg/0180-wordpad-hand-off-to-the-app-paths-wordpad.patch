From: Stained Glass OS <dev@stained-glass.example>
Subject: wordpad: hand off to the App Paths WordPad

sg-shell registers its WordPad in App Paths for wordpad.exe and write.exe,
which ShellExecute and the Run box follow. A program that starts Program
Files' wordpad.exe or system32's write.exe itself (write.exe runs
wordpad.exe), and the rtffile and wrifile associations, got Wine's
Windows 2000-era WordPad. Now, when App Paths names another existing program
for wordpad.exe (not itself, not one in a system directory), Wine's WordPad
starts that one with the same arguments and exits, as taskmgr.exe does
(0121). With nothing registered Wine's WordPad runs as before.

Gate: sg-shell's test/wordpad-check.sh (write.exe and Wine's wordpad.exe
reach sg-wordpad with their arguments).
---
diff --git a/programs/wordpad/wordpad.c b/programs/wordpad/wordpad.c
index 8617c24..48f73d0 100644
--- a/programs/wordpad/wordpad.c
+++ b/programs/wordpad/wordpad.c
@@ -2763,6 +2763,56 @@ static LRESULT CALLBACK WndProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lPara
     return 0;
 }
 
+/* Stained Glass OS: when App Paths registers another program for NAME
+ * (sg-shell's WordPad), start it with this command line's arguments instead,
+ * so programs that run wordpad.exe or write.exe with CreateProcess -- which
+ * never reads App Paths -- and the .rtf/.wri associations get the same one
+ * as ShellExecute and the Run box. Never this program or one in a system
+ * directory: no loop. */
+static BOOL hand_off( const WCHAR *name )
+{
+    WCHAR key[MAX_PATH], target[MAX_PATH], self[MAX_PATH], dir[MAX_PATH], *cmd;
+    const WCHAR *args = GetCommandLineW();
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    DWORD size = sizeof(target);
+    HKEY hkey;
+    size_t len;
+    UINT i;
+
+    swprintf( key, ARRAY_SIZE(key), L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\%s", name );
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, key, 0, KEY_QUERY_VALUE | KEY_WOW64_64KEY, &hkey )) return FALSE;
+    i = RegGetValueW( hkey, NULL, NULL, RRF_RT_REG_SZ, NULL, target, &size );
+    RegCloseKey( hkey );
+    if (i || GetFileAttributesW( target ) == INVALID_FILE_ATTRIBUTES) return FALSE;
+    if (GetModuleFileNameW( NULL, self, MAX_PATH ) && !wcsicmp( target, self )) return FALSE;
+    for (i = 0; i < 2; i++)
+    {
+        size_t n;
+        if (!(i ? GetSystemWow64DirectoryW( dir, MAX_PATH ) : GetSystemDirectoryW( dir, MAX_PATH ))) continue;
+        n = wcslen( dir );
+        if (!wcsnicmp( target, dir, n ) && target[n] == '\\' && !wcschr( target + n + 1, '\\' )) return FALSE;
+    }
+
+    /* this command line without the program's name */
+    if (*args == '"') { args++; while (*args && *args != '"') args++; if (*args) args++; }
+    else while (*args && *args != ' ' && *args != '\t') args++;
+    while (*args == ' ' || *args == '\t') args++;
+
+    len = wcslen( target ) + wcslen( args ) + 4;
+    if (!(cmd = malloc( len * sizeof(WCHAR) ))) return FALSE;
+    swprintf( cmd, len, L"\"%s\"%s%s", target, *args ? L" " : L"", args );
+    if (!CreateProcessW( target, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi ))
+    {
+        free( cmd );
+        return FALSE;
+    }
+    CloseHandle( pi.hThread );
+    CloseHandle( pi.hProcess );
+    free( cmd );
+    return TRUE;
+}
+
 int CALLBACK WinMain(HINSTANCE hInstance, HINSTANCE hOldInstance, LPSTR szCmdParagraph, int nCmdShow)
 {
     INITCOMMONCONTROLSEX classes = {8, ICC_BAR_CLASSES|ICC_COOL_CLASSES|ICC_USEREX_CLASSES};
@@ -2778,6 +2828,8 @@ int CALLBACK WinMain(HINSTANCE hInstance, HINSTANCE hOldInstance, LPSTR szCmdPar
     HMONITOR monitor;
     int x, y;
 
+    if (hand_off( L"wordpad.exe" )) return 0;
+
     InitCommonControlsEx(&classes);
 
     hAccel = LoadAcceleratorsW(hInstance, L"MAINACCELTABLE");
