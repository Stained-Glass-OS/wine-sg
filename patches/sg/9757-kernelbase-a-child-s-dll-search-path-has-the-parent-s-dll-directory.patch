From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: a child's DLL search path has its parent's DLL directory

Windows computes a new process's DLL search path in the parent, with the directory the
parent gave SetDllDirectory: the child's own folder, that directory, the system
folders, PATH. Wireshark relies on it ('Ensure that extcap executables can find
wsutil'): it sets its program folder, and its capture helpers in extcap\ import
libwsutil.dll and GLib from there. Wine's children computed their own path
('Library libwsutil.dll (which is needed by ...\extcap\etwdump.exe) not found').
A process with a DLL directory now gives its children that search path in their
process parameters (DllPath, which the loader already uses); without one nothing
changes.

Gate: test/dlldirchild-gate.sh; mutant SG_MUTANT_NO_INHERITED_DLL_DIRECTORY.
---
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -212,14 +212,36 @@
  */
 static WCHAR *sg_app_environment( const WCHAR *app_name, const WCHAR *env );
 
+/* Stained Glass OS (wine-sg 9757): the DLL search path a new process starts with. A process that set
+ * a DLL directory (SetDllDirectory) gives its children a search path with it, as Windows computes the
+ * child's path in the parent: the child's own folder, that directory, the system folders, PATH. Wireshark
+ * sets its program folder so that the capture helpers in its extcap folder find libwsutil.dll and GLib
+ * ("Library libwsutil.dll ... not found" for etwdump.exe). Without a DLL directory the child computes
+ * its own path, as before. */
+static WCHAR *child_dll_path( const WCHAR *image )
+{
+    WCHAR buffer[MAX_PATH], *path = NULL, *unknown;
+    UNICODE_STRING dir;
+
+#ifdef SG_MUTANT_NO_INHERITED_DLL_DIRECTORY
+    return NULL;
+#endif
+    dir.Buffer = buffer;
+    dir.Length = 0;
+    dir.MaximumLength = sizeof(buffer);
+    if (LdrGetDllDirectory( &dir ) || !dir.Length) return NULL;
+    if (LdrGetDllPath( image, LOAD_WITH_ALTERED_SEARCH_PATH, &path, &unknown )) return NULL;
+    return path;
+}
+
 static RTL_USER_PROCESS_PARAMETERS *create_process_params( const WCHAR *filename, const WCHAR *cmdline,
                                                            const WCHAR *cur_dir, void *env, DWORD flags,
                                                            const STARTUPINFOW *startup )
 {
     RTL_USER_PROCESS_PARAMETERS *params;
-    UNICODE_STRING imageW, curdirW, cmdlineW, titleW, desktopW, runtimeW, newdirW;
+    UNICODE_STRING imageW, curdirW, cmdlineW, titleW, desktopW, runtimeW, newdirW, dllpathW;
     WCHAR imagepath[MAX_PATH];
-    WCHAR *envW = env, *app_env;
+    WCHAR *envW = env, *app_env, *dllpath;
 
     if (!GetLongPathNameW( filename, imagepath, MAX_PATH )) lstrcpynW( imagepath, filename, MAX_PATH );
     if (!GetFullPathNameW( imagepath, MAX_PATH, imagepath, NULL )) lstrcpynW( imagepath, filename, MAX_PATH );
@@ -252,16 +274,20 @@
     runtimeW.Buffer = (WCHAR *)startup->lpReserved2;
     runtimeW.Length = runtimeW.MaximumLength = startup->cbReserved2;
     app_env = sg_app_environment( filename, envW );
-    if (RtlCreateProcessParametersEx( &params, &imageW, NULL, cur_dir ? &curdirW : NULL,
+    dllpath = child_dll_path( imagepath );
+    if (dllpath) RtlInitUnicodeString( &dllpathW, dllpath );
+    if (RtlCreateProcessParametersEx( &params, &imageW, dllpath ? &dllpathW : NULL, cur_dir ? &curdirW : NULL,
                                       &cmdlineW, app_env ? app_env : envW, &titleW, &desktopW,
                                       NULL, &runtimeW, PROCESS_PARAMS_FLAG_NORMALIZED ))
     {
+        if (dllpath) RtlReleasePath( dllpath );
         RtlFreeUnicodeString( &newdirW );
         if (app_env) RtlDestroyEnvironment( app_env );
         if (envW != env) RtlFreeHeap( GetProcessHeap(), 0, envW );
         return NULL;
     }
     if (app_env) RtlDestroyEnvironment( app_env );
+    if (dllpath) RtlReleasePath( dllpath );
     RtlFreeUnicodeString( &newdirW );
 
     if (!(flags & CREATE_NEW_PROCESS_GROUP))
