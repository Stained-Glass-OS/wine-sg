From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmvcore: IWMMetadataEditor2::OpenEx (9103)

The metadata editor had no IWMMetadataEditor2, so fre:ac's WMA tagger, which opens
every file through OpenEx (GENERIC_READ and FILE_SHARE_READ to read tags,
GENERIC_READ | GENERIC_WRITE and no sharing to write them), silently read and wrote
no tags. OpenEx opens the file with the access and sharing asked for and keeps it
open until Close, as Windows does: other openers are kept out as the share mode
says, and Flush on a file opened for reading only is refused (the file is left as
it was). Open is unchanged.
---
--- a/include/wmsdkidl.idl
+++ b/include/wmsdkidl.idl
@@ -685,6 +685,20 @@
 
 [
     object,
+    uuid(203cffe3-2e18-4fdf-b59d-6e71530534cf),
+    pointer_default(unique),
+    local
+]
+interface IWMMetadataEditor2 : IWMMetadataEditor
+{
+    HRESULT OpenEx(
+        [in] const WCHAR *pwszFilename,
+        [in] DWORD dwDesiredAccess,
+        [in] DWORD dwShareMode);
+}
+
+[
+    object,
     uuid(96406bd6-2b2b-11d3-b36b-00c04f6108ff),
     pointer_default(unique),
     local
--- a/dlls/wmvcore/editor.c
+++ b/dlls/wmvcore/editor.c
@@ -27,6 +27,12 @@
  * writer's attribute store); Flush writes the two objects back, the header's other objects
  * kept as they were and the data after it untouched; Close without Flush keeps the file as it
  * was.
+ *
+ * Stained Glass OS (wine-sg 9103): IWMMetadataEditor2::OpenEx was missing, so fre:ac's WMA
+ * tagger, which opens every file through it, read and wrote no tags. OpenEx opens the file with
+ * the access and sharing asked for and keeps it open until Close, as Windows does: others are
+ * kept out as the share mode says, and Flush on a file opened for reading only is refused. Open
+ * is as before (the file read, not held).
  */
 
 #include "wmvcore_private.h"
@@ -62,6 +68,8 @@
     BYTE *objects;          /* the header object's children, as read */
     DWORD objects_size, object_count;
     UINT64 header_size;     /* where the data starts */
+    HANDLE hold;            /* OpenEx: the file, open with the access and sharing asked for */
+    DWORD access, share;
 };
 
 static inline struct editor *impl_from_IWMMetadataEditor(IWMMetadataEditor *iface)
@@ -75,7 +83,8 @@
 
     TRACE("(%p)->(%s %p)\n", editor, debugstr_guid(iid), out);
 
-    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IWMMetadataEditor))
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IWMMetadataEditor)
+            || IsEqualGUID(iid, &IID_IWMMetadataEditor2))
         *out = &editor->IWMMetadataEditor_iface;
     else if (IsEqualGUID(iid, &IID_IWMHeaderInfo) || IsEqualGUID(iid, &IID_IWMHeaderInfo2)
             || IsEqualGUID(iid, &IID_IWMHeaderInfo3))
@@ -98,6 +107,8 @@
 
 static void editor_reset(struct editor *editor)
 {
+    if (editor->hold != INVALID_HANDLE_VALUE) CloseHandle(editor->hold);
+    editor->hold = INVALID_HANDLE_VALUE;
     free(editor->path);
     free(editor->objects);
     editor->path = NULL;
@@ -212,9 +223,8 @@
     }
 }
 
-static HRESULT WINAPI editor_Open(IWMMetadataEditor *iface, const WCHAR *filename)
+static HRESULT open_file(struct editor *editor, const WCHAR *filename, DWORD access, DWORD share, BOOL hold)
 {
-    struct editor *editor = impl_from_IWMMetadataEditor(iface);
     BYTE header[HEADER_SIZE];
     UINT64 size;
     DWORD read, pos, i;
@@ -222,8 +232,6 @@
     HANDLE file;
     HRESULT hr;
 
-    TRACE("(%p)->(%s)\n", editor, debugstr_w(filename));
-
     if (!filename) return E_INVALIDARG;
     EnterCriticalSection(&editor->cs);
     if (editor->path)
@@ -232,7 +240,7 @@
         return NS_E_INVALID_REQUEST;
     }
 
-    file = CreateFileW(filename, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    file = CreateFileW(filename, access, share, NULL, OPEN_EXISTING, 0, NULL);
     if (file == INVALID_HANDLE_VALUE)
     {
         hr = HRESULT_FROM_WIN32(GetLastError());
@@ -279,9 +287,18 @@
     editor->header_size = size;
     editor->path = wcsdup(filename);
     hr = editor->path ? S_OK : E_OUTOFMEMORY;
+#ifndef SG_MUTANT_WMED2_NO_HOLD
+    if (SUCCEEDED(hr) && hold)
+    {
+        editor->hold = file;
+        editor->access = access;
+        editor->share = share;
+        file = INVALID_HANDLE_VALUE;
+    }
+#endif
 
 done:
-    CloseHandle(file);
+    if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
     if (FAILED(hr))
     {
         WARN("%s: %#lx\n", debugstr_w(filename), hr);
@@ -291,6 +308,25 @@
     return hr;
 }
 
+static HRESULT WINAPI editor_Open(IWMMetadataEditor *iface, const WCHAR *filename)
+{
+    struct editor *editor = impl_from_IWMMetadataEditor(iface);
+
+    TRACE("(%p)->(%s)\n", editor, debugstr_w(filename));
+
+    return open_file(editor, filename, GENERIC_READ, FILE_SHARE_READ, FALSE);
+}
+
+static HRESULT WINAPI editor_OpenEx(IWMMetadataEditor *iface, const WCHAR *filename, DWORD access, DWORD share)
+{
+    struct editor *editor = impl_from_IWMMetadataEditor(iface);
+
+    TRACE("(%p)->(%s, %#lx, %#lx)\n", editor, debugstr_w(filename), access, share);
+
+    if (!(access & GENERIC_READ)) return E_INVALIDARG;
+    return open_file(editor, filename, access, share, TRUE);
+}
+
 static HRESULT WINAPI editor_Close(IWMMetadataEditor *iface)
 {
     struct editor *editor = impl_from_IWMMetadataEditor(iface);
@@ -470,6 +506,7 @@
     UINT64 size, file_size = 0;
     LARGE_INTEGER at;
     HANDLE in = INVALID_HANDLE_VALUE, outfile = INVALID_HANDLE_VALUE;
+    BOOL reopen = FALSE;
     HRESULT hr = S_OK;
 
     TRACE("(%p)\n", editor);
@@ -481,6 +518,20 @@
         return NS_E_INVALID_REQUEST;
     }
 
+    if (editor->hold != INVALID_HANDLE_VALUE)
+    {
+        /* a file opened for reading only is not written */
+        if (!(editor->access & GENERIC_WRITE))
+        {
+            LeaveCriticalSection(&editor->cs);
+            return HRESULT_FROM_WIN32(ERROR_ACCESS_DENIED);
+        }
+        /* the rewrite below opens the file itself: the editor's own handle is let go meanwhile */
+        CloseHandle(editor->hold);
+        editor->hold = INVALID_HANDLE_VALUE;
+        reopen = TRUE;
+    }
+
     /* the header's objects but the two descriptions, then the new descriptions */
     asf_put(&out, header, sizeof(header));
     for (i = 0, pos = 0; i < editor->object_count; i++)
@@ -580,19 +631,25 @@
     }
     if (in != INVALID_HANDLE_VALUE) CloseHandle(in);
     free(out.data);
+    if (reopen)
+    {
+        editor->hold = CreateFileW(editor->path, editor->access, editor->share, NULL, OPEN_EXISTING, 0, NULL);
+        if (editor->hold == INVALID_HANDLE_VALUE) WARN("%s not open again: %lu\n", debugstr_w(editor->path), GetLastError());
+    }
     LeaveCriticalSection(&editor->cs);
     if (FAILED(hr)) WARN("%#lx\n", hr);
     return hr;
 }
 
-static const IWMMetadataEditorVtbl editor_vtbl =
+static const IWMMetadataEditor2Vtbl editor_vtbl =
 {
-    editor_QueryInterface,
-    editor_AddRef,
-    editor_Release,
-    editor_Open,
-    editor_Close,
-    editor_Flush,
+    (void *)editor_QueryInterface,
+    (void *)editor_AddRef,
+    (void *)editor_Release,
+    (void *)editor_Open,
+    (void *)editor_Close,
+    (void *)editor_Flush,
+    (void *)editor_OpenEx,
 };
 
 HRESULT WINAPI WMCreateEditor(IWMMetadataEditor **out)
@@ -604,7 +661,8 @@
     if (!out) return E_POINTER;
     *out = NULL;
     if (!(editor = calloc(1, sizeof(*editor)))) return E_OUTOFMEMORY;
-    editor->IWMMetadataEditor_iface.lpVtbl = &editor_vtbl;
+    editor->IWMMetadataEditor_iface.lpVtbl = (const IWMMetadataEditorVtbl *)&editor_vtbl;
+    editor->hold = INVALID_HANDLE_VALUE;
     editor->ref = 1;
     InitializeCriticalSectionEx(&editor->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
     editor->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": editor.cs");
