From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] oleaut32: Marshal HFONT as a local handle.

HFONT_UserSize/Marshal/Unmarshal/Free marshal an HFONT as a local handle
(RemotableHandle, WDT_INPROC_CALL), as combase does for the other GDI
handles: a font handle does not leave the machine. They were stubs
returning NULL, so IFont::get_hFont through a proxy failed.

Gate: test/oleaut32-hfont-gate.sh (64/32).
---
 dlls/oleaut32/usrmarshal.c | 51 ++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 43 insertions(+), 8 deletions(-)

diff --git a/dlls/oleaut32/usrmarshal.c b/dlls/oleaut32/usrmarshal.c
index 25bce31..42cf7f1 100644
--- a/dlls/oleaut32/usrmarshal.c
+++ b/dlls/oleaut32/usrmarshal.c
@@ -1201,28 +1201,63 @@ void WINAPI LPSAFEARRAY_UserFree(ULONG *pFlags, LPSAFEARRAY *ppsa)
 }
 
 
+/* An HFONT is a local handle (RemotableHandle, WDT_INPROC_CALL), as the
+ * other GDI handles are in combase: it does not leave the machine. */
 ULONG WINAPI HFONT_UserSize(ULONG *pFlags, ULONG Start, HFONT *phfont)
 {
-    FIXME(":stub\n");
-    return 0;
+    TRACE("%#lx, %lu, %p.\n", *pFlags, Start, phfont);
+
+    if (LOWORD(*pFlags) == MSHCTX_DIFFERENTMACHINE)
+    {
+        ERR("can't remote a local handle\n");
+        RaiseException(RPC_S_INVALID_TAG, 0, 0, NULL);
+        return Start;
+    }
+    ALIGN_LENGTH(Start, 3);
+    return Start + sizeof(RemotableHandle);
 }
 
 unsigned char * WINAPI HFONT_UserMarshal(ULONG *pFlags, unsigned char *Buffer, HFONT *phfont)
 {
-    FIXME(":stub\n");
-    return NULL;
+    RemotableHandle *remhandle;
+
+    TRACE("%#lx, %p, %p.\n", *pFlags, Buffer, phfont);
+
+    if (LOWORD(*pFlags) == MSHCTX_DIFFERENTMACHINE)
+    {
+        ERR("can't remote a local handle\n");
+        RaiseException(RPC_S_INVALID_TAG, 0, 0, NULL);
+        return Buffer;
+    }
+    ALIGN_POINTER(Buffer, 3);
+    remhandle = (RemotableHandle *)Buffer;
+    remhandle->fContext = WDT_INPROC_CALL;
+#ifndef SG_MUTANT_HFONT_NOT_MARSHALLED
+    remhandle->u.hInproc = (LONG_PTR)*phfont;
+#else
+    remhandle->u.hInproc = 0;
+#endif
+    return Buffer + sizeof(RemotableHandle);
 }
 
 unsigned char * WINAPI HFONT_UserUnmarshal(ULONG *pFlags, unsigned char *Buffer, HFONT *phfont)
 {
-    FIXME(":stub\n");
-    return NULL;
+    RemotableHandle *remhandle;
+
+    TRACE("%#lx, %p, %p.\n", *pFlags, Buffer, phfont);
+
+    ALIGN_POINTER(Buffer, 3);
+    remhandle = (RemotableHandle *)Buffer;
+    if (remhandle->fContext != WDT_INPROC_CALL)
+        RaiseException(RPC_X_BAD_STUB_DATA, 0, 0, NULL);
+    *phfont = (HFONT)(LONG_PTR)remhandle->u.hInproc;
+    return Buffer + sizeof(RemotableHandle);
 }
 
 void WINAPI HFONT_UserFree(ULONG *pFlags, HFONT *phfont)
 {
-    FIXME(":stub\n");
-    return;
+    /* nothing to free: the handle stays its owner's */
+    TRACE("%#lx, %p.\n", *pFlags, phfont);
 }
 
 
