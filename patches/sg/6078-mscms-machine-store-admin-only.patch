From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscms: the system's colour profile store is for administrators

InstallColorProfile, UninstallColorProfile, AssociateColorProfileWithDevice and
DisassociateColorProfileFromDevice, and the system-wide scope of WcsSetDefaultColorProfile,
WcsAssociateColorProfileWithDevice, WcsDisassociateColorProfileFromDevice and
WcsSetDefaultRenderingIntent changed machine configuration for any caller. As on Windows,
where the COLOR directory and the machine's ICM keys belong to administrators, a caller whose
token is not an enabled member of Administrators now gets ERROR_ACCESS_DENIED; the current-user
scope stays open.
---
diff --git a/dlls/mscms/profile.c b/dlls/mscms/profile.c
index fa6974a..d656a10 100644
--- a/dlls/mscms/profile.c
+++ b/dlls/mscms/profile.c
@@ -54,6 +54,34 @@ static inline WCHAR *strdupW( const char *str )
 
 WINE_DEFAULT_DEBUG_CHANNEL(mscms);
 
+/* The system's colour profile store (the COLOR directory, the machine's associations under HKLM) is
+ * machine configuration: as on Windows, where only administrators may change it, a caller whose token is
+ * not an enabled member of the Administrators group gets ERROR_ACCESS_DENIED. The user's own settings
+ * (the current-user scope) stay open to everyone. */
+static BOOL machine_store_writable(void)
+{
+    SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+    PSID admins = NULL;
+    BOOL member = FALSE;
+
+    if (AllocateAndInitializeSid( &nt, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS, 0, 0, 0, 0, 0, 0,
+                                  &admins ))
+    {
+        if (!CheckTokenMembership( NULL, admins, &member )) member = FALSE;
+        FreeSid( admins );
+    }
+#ifdef SG_MUTANT_ICM_ANYONE
+    member = TRUE;
+#endif
+    if (!member)
+    {
+        WARN( "the system's colour profile store is for administrators\n" );
+        SetLastError( ERROR_ACCESS_DENIED );
+    }
+    return member;
+}
+
+
 /******************************************************************************
  * AssociateColorProfileWithDeviceA               [MSCMS.@]
  */
@@ -105,6 +133,8 @@ static BOOL set_profile_device_key( PCWSTR file, const BYTE *value, DWORD size )
     profile.pProfileData = (PVOID)file;
     profile.cbDataSize = (lstrlenW( file ) + 1) * sizeof(WCHAR);
 
+    if (!machine_store_writable()) return FALSE;
+
     /* FIXME is the profile installed? */
     if (!(handle = OpenColorProfileW( &profile, PROFILE_READ, 0, OPEN_EXISTING )))
     {
@@ -1141,6 +1171,7 @@ BOOL WINAPI InstallColorProfileW( PCWSTR machine, PCWSTR profile )
     TRACE( "( %s )\n", debugstr_w(profile) );
 
     if (machine || !profile) return FALSE;
+    if (!machine_store_writable()) return FALSE;
 
     if (!GetColorDirectoryW( machine, dest, &size )) return FALSE;
 
@@ -1333,6 +1364,7 @@ BOOL WINAPI UninstallColorProfileW( PCWSTR machine, PCWSTR profile, BOOL delete
     TRACE( "( %s, %x )\n", debugstr_w(profile), delete );
 
     if (machine || !profile) return FALSE;
+    if (!machine_store_writable()) return FALSE;
 
     if (delete) return DeleteFileW( profile );
     return TRUE;
@@ -1859,6 +1891,7 @@ BOOL WINAPI WcsSetDefaultColorProfile( WCS_PROFILE_MANAGEMENT_SCOPE scope, PCWST
         return FALSE;
     }
     root = scope_root( scope );
+    if (root == HKEY_LOCAL_MACHINE && !machine_store_writable()) return FALSE;
     list = get_associations( root, device_name, NULL );
     if (!(edited = edit_associations( list, profile, TRUE, FALSE, &found )))
     {
@@ -1894,6 +1927,7 @@ BOOL WINAPI WcsAssociateColorProfileWithDevice( WCS_PROFILE_MANAGEMENT_SCOPE sco
         return FALSE;
     }
     root = scope_root( scope );
+    if (root == HKEY_LOCAL_MACHINE && !machine_store_writable()) return FALSE;
     list = get_associations( root, device_name, NULL );
     if (!(edited = edit_associations( list, profile, FALSE, FALSE, &found )))
     {
@@ -1925,6 +1959,7 @@ BOOL WINAPI WcsDisassociateColorProfileFromDevice( WCS_PROFILE_MANAGEMENT_SCOPE
         return FALSE;
     }
     root = scope_root( scope );
+    if (root == HKEY_LOCAL_MACHINE && !machine_store_writable()) return FALSE;
     list = get_associations( root, device_name, NULL );
     if (!(edited = edit_associations( list, profile, FALSE, TRUE, &found )))
     {
@@ -2013,6 +2048,7 @@ BOOL WINAPI WcsSetDefaultRenderingIntent( WCS_PROFILE_MANAGEMENT_SCOPE scope, DW
         SetLastError( ERROR_INVALID_PARAMETER );
         return FALSE;
     }
+    if (scope_root( scope ) == HKEY_LOCAL_MACHINE && !machine_store_writable()) return FALSE;
     if ((res = RegCreateKeyExW( scope_root( scope ), icm_root, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL )))
     {
         SetLastError( res );
