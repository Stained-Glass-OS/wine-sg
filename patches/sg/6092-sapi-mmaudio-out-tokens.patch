From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sapi: the MMAudioOut enumerator's audio output tokens

AudioOutput's DefaultDefaultTokenId names the MMAudioOut token enumerator's root (TokenEnums\MMAudioOut\), whose
CLSID is CLSID_SpMMAudioEnum, which Wine does not have: a token set to the default audio output made no ISpAudio
(REGDB_E_CLASSNOTREG) and ScummVM's text to speech said 'Could not initialize TTS audio'. Such ids are now the
enumerator's tokens -- the root the default device, '\N' waveOut device N -- with CLSID_SpMMAudioOut, the device's
name and, for a numbered device, its DeviceId, kept in a volatile key of the user's.
---
diff --git a/dlls/sapi/token.c b/dlls/sapi/token.c
index 8e1cfd0..e1ebc74 100644
--- a/dlls/sapi/token.c
+++ b/dlls/sapi/token.c
@@ -30,6 +30,7 @@
 #include "sperror.h"
 #include "shlobj.h"
 #include "oleauto.h"
+#include "mmsystem.h"
 
 #include "wine/debug.h"
 
@@ -2619,6 +2620,48 @@ static HRESULT WINAPI token_EnumValues( ISpObjectToken *iface,
     return ISpRegDataKey_EnumValues( This->data_key, index, value );
 }
 
+/* Stained Glass OS: the audio output tokens the MMAudioOut token enumerator
+ * makes (TokenEnums\MMAudioOut, CLSID_SpMMAudioEnum -- not a class here).
+ * AudioOutput's DefaultDefaultTokenId names the enumerator's root with a
+ * trailing backslash: that is its default token, the default device; a
+ * number after it is that waveOut device. Such a token's data lives in a
+ * volatile key of the user's: its name, CLSID_SpMMAudioOut and DeviceId. */
+static const WCHAR mmaudio_out_enum[] = L"SOFTWARE\\Microsoft\\Speech\\AudioOutput\\TokenEnums\\MMAudioOut\\";
+
+static LSTATUS open_mmaudio_out_token( const WCHAR *suffix, HKEY *ret )
+{
+    WCHAR path[128], clsid[39], name[MAXPNAMELEN + 1], number[16];
+    WAVEOUTCAPSW caps;
+    UINT device = WAVE_MAPPER;
+    LSTATUS res;
+    HKEY key;
+
+    if (*suffix)
+    {
+        WCHAR *end;
+        device = wcstoul( suffix, &end, 10 );
+        if (*end || device >= waveOutGetNumDevs()) return ERROR_FILE_NOT_FOUND;
+    }
+    swprintf( path, ARRAY_SIZE(path), L"Software\\Wine\\Speech\\MMAudioOut\\%s", *suffix ? suffix : L"Default" );
+    if ((res = RegCreateKeyExW( HKEY_CURRENT_USER, path, 0, NULL, REG_OPTION_VOLATILE, KEY_ALL_ACCESS, NULL, &key, NULL )))
+        return res;
+    if (!waveOutGetDevCapsW( device == WAVE_MAPPER ? WAVE_MAPPER : device, &caps, sizeof(caps) ))
+        lstrcpynW( name, caps.szPname, ARRAY_SIZE(name) );
+    else
+        lstrcpyW( name, L"Default audio output" );
+    RegSetValueExW( key, NULL, 0, REG_SZ, (const BYTE *)name, (wcslen( name ) + 1) * sizeof(WCHAR) );
+    StringFromGUID2( &CLSID_SpMMAudioOut, clsid, ARRAY_SIZE(clsid) );
+    RegSetValueExW( key, L"CLSID", 0, REG_SZ, (const BYTE *)clsid, sizeof(clsid) );
+    if (device != WAVE_MAPPER)
+    {
+        swprintf( number, ARRAY_SIZE(number), L"%u", device );
+        RegSetValueExW( key, L"DeviceId", 0, REG_SZ, (const BYTE *)number, (wcslen( number ) + 1) * sizeof(WCHAR) );
+    }
+    else RegDeleteValueW( key, L"DeviceId" );
+    *ret = key;
+    return ERROR_SUCCESS;
+}
+
 static HRESULT WINAPI token_SetId( ISpObjectToken *iface,
                                    LPCWSTR category_id, LPCWSTR token_id,
                                    BOOL create )
@@ -2639,6 +2682,11 @@ static HRESULT WINAPI token_SetId( ISpObjectToken *iface,
     hr = parse_cat_id( token_id, &root, &subkey );
     if (hr != S_OK) return SPERR_NOT_FOUND;
 
+#ifndef SG_MUTANT_NO_MMAUDIO_TOKENS
+    if (root == HKEY_LOCAL_MACHINE && !wcsnicmp( subkey, mmaudio_out_enum, wcslen( mmaudio_out_enum ) ))
+        res = open_mmaudio_out_token( subkey + wcslen( mmaudio_out_enum ), &key );
+    else
+#endif
     if (create)
         res = RegCreateKeyExW( root, subkey, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL);
     else
