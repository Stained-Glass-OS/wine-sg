From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] actxprxy: proxies for the network list manager's interfaces

netprofm calls its event sinks through the global interface table, in their
own apartments, which marshals each sink. INetworkCostManagerEvents and the
other network list manager interfaces that are not automation compatible
had no proxy: every Office start logged "CoMarshalInterface failed" for
{dcb00009-...}, and cost events never reached their sinks. actxprxy now
builds and registers proxies for netlistmgr.idl's interfaces.
---
diff --git a/dlls/actxprxy/Makefile.in b/dlls/actxprxy/Makefile.in
index cd3391b..ba170c4 100644
--- a/dlls/actxprxy/Makefile.in
+++ b/dlls/actxprxy/Makefile.in
@@ -8,6 +8,7 @@ SOURCES = \
 	actxprxy_hlink.idl \
 	actxprxy_htiface.idl \
 	actxprxy_htiframe.idl \
+	actxprxy_netlistmgr.idl \
 	actxprxy_notification.idl \
 	actxprxy_objsafe.idl \
 	actxprxy_ocmm.idl \
@@ -15,6 +16,7 @@ SOURCES = \
 	actxprxy_shldisp.idl \
 	actxprxy_shobjidl.idl \
 	actxprxy_urlhist.idl \
+	netlistmgr_guid.c \
 	usrmarshal.c
 
 dlldata_EXTRADEFS = -DWINE_REGISTER_DLL -DPROXY_DELEGATION
diff --git a/dlls/actxprxy/actxprxy_netlistmgr.idl b/dlls/actxprxy/actxprxy_netlistmgr.idl
new file mode 100644
index 0000000..f13951d
--- /dev/null
+++ b/dlls/actxprxy/actxprxy_netlistmgr.idl
@@ -0,0 +1,33 @@
+/*
+ * Proxies for the network list manager's interfaces (Stained Glass OS)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* netprofm calls its sinks through the global interface table, in their own apartments: the
+ * event interfaces that are not automation compatible (INetworkCostManagerEvents,
+ * INetworkConnectionCostEvents) need proxies for that. */
+
+#pragma makedep proxy
+#pragma makedep register
+
+#define __WINE_NETLISTMGR_PROXY_ONLY
+#include "netlistmgr.idl"
+
+[
+    threading(both),
+    uuid(b8da6310-e19b-11d0-933c-00a0c90dcaa9)  /* IActiveScriptStats */
+]
+coclass PSFactoryBuffer { interface IPSFactoryBuffer; }
diff --git a/dlls/actxprxy/netlistmgr_guid.c b/dlls/actxprxy/netlistmgr_guid.c
new file mode 100644
index 0000000..387a6f5
--- /dev/null
+++ b/dlls/actxprxy/netlistmgr_guid.c
@@ -0,0 +1,28 @@
+/*
+ * The network list manager's interface ids, for its proxies (Stained Glass OS)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "oaidl.h"
+#include "ocidl.h"
+
+#include "initguid.h"
+#include "netlistmgr.h"
diff --git a/include/netlistmgr.idl b/include/netlistmgr.idl
index f9e82dd..815915a 100644
--- a/include/netlistmgr.idl
+++ b/include/netlistmgr.idl
@@ -264,11 +264,13 @@ interface INetworkListManager : IDispatch
         [out, retval] NLM_CONNECTIVITY *pConnectivity);
 }
 
+#ifndef __WINE_NETLISTMGR_PROXY_ONLY  /* actxprxy builds proxies from this file */
 [
     threading(both),
     uuid(dcb00c01-570f-4a9b-8d69-199fdba5723b)
 ]
 coclass NetworkListManager { interface INetworkListManager; }
+#endif
 
 [
     object,
