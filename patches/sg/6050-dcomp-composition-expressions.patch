+/*
+ * An expression is parsed once into a tree and evaluated as often as asked:
+ * numbers, true and false, names (a parameter, "this.StartingValue",
+ * "this.CurrentValue", "this.FinalValue", "this.Target.Property", a
+ * reference parameter's property, with ".X", ".XY"... components), unary -
+ * and !, * / %, + -, comparisons, && ||, ?:, and the functions below. Names
+ * and functions are matched without regard to case. Matrices are not
+ * supported.
+ */
+
+#include <math.h>
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "objidl.h"
+#include "composition_private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+enum node_type
+{
+    NODE_NUMBER,
+    NODE_BOOLEAN,
+    NODE_NAME,
+    NODE_CALL,
+    NODE_UNARY,
+    NODE_BINARY,
+    NODE_CONDITIONAL,
+};
+
+#define MAX_ARGS 4
+
+struct expr_node
+{
+    enum node_type type;
+    WCHAR op;                   /* unary and binary: '-', '!', '*', '/', '%', '+', '<', 'l' (<=), '>', 'g' (>=), '=', 'n' (!=), '&', '|' */
+    float number;
+    WCHAR *name;                /* a name, or a function */
+    struct expr_node *args[MAX_ARGS];
+    UINT argc;
+    /* a reference's property, found on first use */
+    BOOL resolved;
+    struct anim_property prop;
+    const WCHAR *swizzle;       /* in name: components after a value */
+};
+
+struct parser
+{
+    const WCHAR *p;
+    BOOL error;
+};
+
+static void skip_spaces( struct parser *ps )
+{
+    while (*ps->p == ' ' || *ps->p == '\t' || *ps->p == '\r' || *ps->p == '\n') ps->p++;
+}
+
+static struct expr_node *new_node( struct parser *ps, enum node_type type )
+{
+    struct expr_node *node;
+
+    if (!(node = calloc( 1, sizeof(*node) ))) ps->error = TRUE;
+    else node->type = type;
+    return node;
+}
+
+void expr_free( struct expr_node *node )
+{
+    UINT i;
+
+    if (!node) return;
+    for (i = 0; i < node->argc; i++) expr_free( node->args[i] );
+    free( node->name );
+    free( node );
+}
+
+static struct expr_node *parse_conditional( struct parser *ps );
+
+static BOOL is_name_char( WCHAR c )
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
+}
+
+static struct expr_node *parse_primary( struct parser *ps )
+{
+    struct expr_node *node;
+    const WCHAR *start;
+
+    skip_spaces( ps );
+    if (ps->error) return NULL;
+    if ((*ps->p >= '0' && *ps->p <= '9') || (*ps->p == '.' && ps->p[1] >= '0' && ps->p[1] <= '9'))
+    {
+        WCHAR *end;
+        double value = wcstod( ps->p, &end );
+
+        if (!(node = new_node( ps, NODE_NUMBER ))) return NULL;
+        node->number = value;
+        ps->p = end;
+        if (*ps->p == 'f' || *ps->p == 'F') ps->p++;
+        return node;
+    }
+    if (*ps->p == '(')
+    {
+        ps->p++;
+        node = parse_conditional( ps );
+        skip_spaces( ps );
+        if (*ps->p != ')') ps->error = TRUE;
+        else ps->p++;
+        return node;
+    }
+    if (!is_name_char( *ps->p ))
+    {
+        ps->error = TRUE;
+        return NULL;
+    }
+
+    /* a dotted name, or a function */
+    start = ps->p;
+    while (is_name_char( *ps->p ) || (*ps->p == '.' && is_name_char( ps->p[1] ))) ps->p++;
+    skip_spaces( ps );
+    if (!(node = new_node( ps, NODE_NAME ))) return NULL;
+    if (!(node->name = malloc( (ps->p - start + 1) * sizeof(WCHAR) )))
+    {
+        ps->error = TRUE;
+        return node;
+    }
+    memcpy( node->name, start, (ps->p - start) * sizeof(WCHAR) );
+    node->name[ps->p - start] = 0;
+    while (node->name[0] && (node->name[wcslen( node->name ) - 1] == ' ')) node->name[wcslen( node->name ) - 1] = 0;
+
+    if (*ps->p == '(')
+    {
+        node->type = NODE_CALL;
+        ps->p++;
+        skip_spaces( ps );
+        if (*ps->p == ')')
+        {
+            ps->p++;
+            return node;
+        }
+        for (;;)
+        {
+            if (node->argc == MAX_ARGS)
+            {
+                ps->error = TRUE;
+                return node;
+            }
+            node->args[node->argc++] = parse_conditional( ps );
+            if (ps->error) return node;
+            skip_spaces( ps );
+            if (*ps->p == ',') { ps->p++; continue; }
+            if (*ps->p == ')') { ps->p++; break; }
+            ps->error = TRUE;
+            return node;
+        }
+        return node;
+    }
+    if (!wcsicmp( node->name, L"true" ) || !wcsicmp( node->name, L"false" ))
+    {
+        node->type = NODE_BOOLEAN;
+        node->number = !wcsicmp( node->name, L"true" );
+    }
+    return node;
+}
+
+static struct expr_node *parse_unary( struct parser *ps )
+{
+    struct expr_node *node;
+
+    skip_spaces( ps );
+    if (*ps->p == '-' || *ps->p == '!' || *ps->p == '+')
+    {
+        WCHAR op = *ps->p++;
+        struct expr_node *arg = parse_unary( ps );
+
+        if (op == '+') return arg;
+        if (!(node = new_node( ps, NODE_UNARY )))
+        {
+            expr_free( arg );
+            return NULL;
+        }
+        node->op = op;
+        node->args[node->argc++] = arg;
+        return node;
+    }
+    return parse_primary( ps );
+}
+
+static struct expr_node *binary( struct parser *ps, WCHAR op, struct expr_node *left, struct expr_node *right )
+{
+    struct expr_node *node;
+
+    if (!(node = new_node( ps, NODE_BINARY )))
+    {
+        expr_free( left );
+        expr_free( right );
+        return NULL;
+    }
+    node->op = op;
+    node->args[0] = left;
+    node->args[1] = right;
+    node->argc = 2;
+    return node;
+}
+
+static struct expr_node *parse_multiplicative( struct parser *ps )
+{
+    struct expr_node *node = parse_unary( ps );
+
+    for (;;)
+    {
+        WCHAR op;
+        skip_spaces( ps );
+        if (ps->error || (*ps->p != '*' && *ps->p != '/' && *ps->p != '%')) return node;
+        op = *ps->p++;
+        node = binary( ps, op, node, parse_unary( ps ) );
+    }
+}
+
+static struct expr_node *parse_additive( struct parser *ps )
+{
+    struct expr_node *node = parse_multiplicative( ps );
+
+    for (;;)
+    {
+        WCHAR op;
+        skip_spaces( ps );
+        if (ps->error || (*ps->p != '+' && *ps->p != '-')) return node;
+        op = *ps->p++;
+        node = binary( ps, op, node, parse_multiplicative( ps ) );
+    }
+}
+
+static struct expr_node *parse_relational( struct parser *ps )
+{
+    struct expr_node *node = parse_additive( ps );
+
+    for (;;)
+    {
+        WCHAR op;
+        skip_spaces( ps );
+        if (ps->error) return node;
+        if (ps->p[0] == '<' && ps->p[1] == '=') { op = 'l'; ps->p += 2; }
+        else if (ps->p[0] == '>' && ps->p[1] == '=') { op = 'g'; ps->p += 2; }
+        else if (ps->p[0] == '=' && ps->p[1] == '=') { op = '='; ps->p += 2; }
+        else if (ps->p[0] == '!' && ps->p[1] == '=') { op = 'n'; ps->p += 2; }
+        else if (ps->p[0] == '<' || ps->p[0] == '>') op = *ps->p++;
+        else return node;
+        node = binary( ps, op, node, parse_additive( ps ) );
+    }
+}
+
+static struct expr_node *parse_logical( struct parser *ps )
+{
+    struct expr_node *node = parse_relational( ps );
+
+    for (;;)
+    {
+        WCHAR op;
+        skip_spaces( ps );
+        if (ps->error) return node;
+        if (ps->p[0] == '&' && ps->p[1] == '&') op = '&';
+        else if (ps->p[0] == '|' && ps->p[1] == '|') op = '|';
+        else return node;
+        ps->p += 2;
+        node = binary( ps, op, node, parse_relational( ps ) );
+    }
+}
+
+static struct expr_node *parse_conditional( struct parser *ps )
+{
+    struct expr_node *cond = parse_logical( ps ), *node;
+
+    skip_spaces( ps );
+    if (ps->error || *ps->p != '?') return cond;
+    ps->p++;
+    if (!(node = new_node( ps, NODE_CONDITIONAL )))
+    {
+        expr_free( cond );
+        return NULL;
+    }
+    node->args[0] = cond;
+    node->args[1] = parse_conditional( ps );
+    node->argc = 2;
+    skip_spaces( ps );
+    if (*ps->p != ':')
+    {
+        ps->error = TRUE;
+        return node;
+    }
+    ps->p++;
+    node->args[2] = parse_conditional( ps );
+    node->argc = 3;
+    return node;
+}
+
+HRESULT expr_parse( const WCHAR *text, struct expr_node **out )
+{
+    struct parser ps = { text, FALSE };
+    struct expr_node *node;
+
+    node = parse_conditional( &ps );
+    skip_spaces( &ps );
+    if (!ps.error && *ps.p) ps.error = TRUE;
+    if (ps.error || !node)
+    {
+        WARN( "could not parse %s at %s.\n", debugstr_w( text ), debugstr_w( ps.p ) );
+        expr_free( node );
+        *out = NULL;
+        return E_INVALIDARG;
+    }
+    *out = node;
+    return S_OK;
+}
+
+/***********************************************************************
+ *          Evaluation
+ */
+
+static UINT value_size( enum anim_kind kind )
+{
+    switch (kind)
+    {
+    case ANIM_SCALAR:
+    case ANIM_BOOLEAN: return 1;
+    case ANIM_VECTOR2: return 2;
+    case ANIM_VECTOR3: return 3;
+    case ANIM_VECTOR4:
+    case ANIM_COLOR:
+    case ANIM_QUATERNION: return 4;
+    default: return 0;
+    }
+}
+
+static const enum anim_kind vector_kinds[] = { ANIM_NONE, ANIM_SCALAR, ANIM_VECTOR2, ANIM_VECTOR3, ANIM_VECTOR4 };
+
+static void set_scalar( struct expr_value *value, float v )
+{
+    memset( value, 0, sizeof(*value) );
+    value->kind = ANIM_SCALAR;
+    value->v[0] = v;
+}
+
+static void set_boolean( struct expr_value *value, BOOL v )
+{
+    memset( value, 0, sizeof(*value) );
+    value->kind = ANIM_BOOLEAN;
+    value->v[0] = v ? 1.0f : 0.0f;
+}
+
+/* ".X", ".YZ" after a value */
+static BOOL apply_swizzle( struct expr_value *value, const WCHAR *swizzle )
+{
+    struct expr_value out = { 0 };
+    UINT size = value_size( value->kind ), i;
+
+    if (!swizzle || !*swizzle) return TRUE;
+    if (value->kind != ANIM_VECTOR2 && value->kind != ANIM_VECTOR3 && value->kind != ANIM_VECTOR4
+            && value->kind != ANIM_QUATERNION && value->kind != ANIM_COLOR)
+        return FALSE;
+    for (i = 0; swizzle[i]; i++)
+    {
+        WCHAR c = towupper( swizzle[i] );
+        UINT index;
+
+        if (i >= 4) return FALSE;
+        if (value->kind == ANIM_COLOR)
+        {
+            /* colours are A, R, G, B here */
+            if (c == 'A') index = 0;
+            else if (c == 'R') index = 1;
+            else if (c == 'G') index = 2;
+            else if (c == 'B') index = 3;
+            else return FALSE;
+        }
+        else if (c == 'W') index = 3;
+        else if (c >= 'X' && c <= 'Z') index = c - 'X';
+        else return FALSE;
+        if (index >= size) return FALSE;
+        out.v[i] = value->v[index];
+    }
+    out.kind = vector_kinds[i];
+    *value = out;
+    return TRUE;
+}
+
+static BOOL read_property( const struct anim_property *prop, struct expr_value *value )
+{
+    memset( value, 0, sizeof(*value) );
+    if (prop->base_kind == ANIM_BOOLEAN)
+    {
+        set_boolean( value, *(boolean *)prop->data );
+        return TRUE;
+    }
+    if (!value_size( prop->kind )) return FALSE;
+    anim_prop_read( prop, value->v );
+    value->kind = prop->kind;
+    return TRUE;
+}
+
+static const struct expr_param *find_param( const struct expr_context *ctx, const WCHAR *name, size_t len )
+{
+    UINT i;
+
+    for (i = 0; i < ctx->param_count; i++)
+        if (wcslen( ctx->params[i].name ) == len && !wcsnicmp( ctx->params[i].name, name, len ))
+            return &ctx->params[i];
+    return NULL;
+}
+
+/* the rest of a name after a reference: a property and maybe its components */
+static BOOL eval_reference( struct expr_node *node, struct expr_context *ctx, ICompositionObject *object,
+                            const WCHAR *rest, struct expr_value *value )
+{
+    if (!rest || !*rest) return FALSE;
+    if (!node->resolved)
+    {
+        if (!ctx->resolve( ctx, object, rest, &node->prop ))
+        {
+            /* a swizzle on what the resolver could not take: "Offset.XY" is resolved whole */
+            return FALSE;
+        }
+        node->resolved = TRUE;
+    }
+    return read_property( &node->prop, value );
+}
+
+static BOOL eval_name( struct expr_node *node, struct expr_context *ctx, struct expr_value *value )
+{
+    const WCHAR *name = node->name, *dot = wcschr( name, '.' ), *rest = dot ? dot + 1 : NULL;
+    size_t len = dot ? dot - name : wcslen( name );
+    const struct expr_param *param;
+
+    if (len == 4 && !wcsnicmp( name, L"this", 4 ) && rest)
+    {
+        const WCHAR *dot2 = wcschr( rest, '.' ), *swizzle = dot2 ? dot2 + 1 : NULL;
+        size_t len2 = dot2 ? dot2 - rest : wcslen( rest );
+
+        if ((len2 == 13 && !wcsnicmp( rest, L"StartingValue", 13 ))
+                || (len2 == 10 && !wcsnicmp( rest, L"FinalValue", 10 )))
+        {
+            memset( value, 0, sizeof(*value) );
+            value->kind = ctx->kind;
+            memcpy( value->v, ctx->start, sizeof(float) * 4 );
+            return apply_swizzle( value, swizzle );
+        }
+        if (len2 == 12 && !wcsnicmp( rest, L"CurrentValue", 12 ))
+        {
+            if (!ctx->target || !read_property( ctx->target, value )) return FALSE;
+            return apply_swizzle( value, swizzle );
+        }
+        if (len2 == 6 && !wcsnicmp( rest, L"Target", 6 ) && ctx->target_object)
+            return eval_reference( node, ctx, ctx->target_object, swizzle, value );
+        return FALSE;
+    }
+    if (!(param = find_param( ctx, name, len ))) return FALSE;
+    if (param->object) return eval_reference( node, ctx, param->object, rest, value );
+    memset( value, 0, sizeof(*value) );
+    value->kind = param->kind;
+    memcpy( value->v, param->value, sizeof(value->v) );
+    if (!value_size( value->kind )) return FALSE;
+    return apply_swizzle( value, rest );
+}
+
+static BOOL is_vector( const struct expr_value *v )
+{
+    return v->kind == ANIM_VECTOR2 || v->kind == ANIM_VECTOR3 || v->kind == ANIM_VECTOR4 || v->kind == ANIM_QUATERNION
+            || v->kind == ANIM_COLOR;
+}
+
+static BOOL truth( const struct expr_value *v )
+{
+    return v->v[0] != 0.0f;
+}
+
+static BOOL eval_binary( WCHAR op, struct expr_value *a, struct expr_value *b, struct expr_value *out )
+{
+    UINT i, size;
+
+    switch (op)
+    {
+    case '&': set_boolean( out, truth( a ) && truth( b ) ); return TRUE;
+    case '|': set_boolean( out, truth( a ) || truth( b ) ); return TRUE;
+    case '=': case 'n':
+    {
+        BOOL equal = a->kind == b->kind || (value_size( a->kind ) == 1 && value_size( b->kind ) == 1);
+        for (i = 0; equal && i < value_size( a->kind ); i++) equal = a->v[i] == b->v[i];
+        set_boolean( out, op == '=' ? equal : !equal );
+        return TRUE;
+    }
+    case '<': case '>': case 'l': case 'g':
+        if (value_size( a->kind ) != 1 || value_size( b->kind ) != 1) return FALSE;
+        set_boolean( out, op == '<' ? a->v[0] < b->v[0] : op == '>' ? a->v[0] > b->v[0]
+                        : op == 'l' ? a->v[0] <= b->v[0] : a->v[0] >= b->v[0] );
+        return TRUE;
+    }
+
+    /* arithmetic: like kinds component by component, or a scalar with a vector */
+    if (a->kind == ANIM_BOOLEAN || b->kind == ANIM_BOOLEAN) return FALSE;
+    if (a->kind != b->kind)
+    {
+        if (a->kind == ANIM_SCALAR && is_vector( b ))
+            for (i = 1; i < 4; i++) a->v[i] = a->v[0];
+        else if (b->kind == ANIM_SCALAR && is_vector( a ))
+            for (i = 1; i < 4; i++) b->v[i] = b->v[0];
+        else return FALSE;
+    }
+    memset( out, 0, sizeof(*out) );
+    out->kind = a->kind == ANIM_SCALAR ? b->kind : a->kind;
+    size = value_size( out->kind );
+    for (i = 0; i < size; i++)
+    {
+        switch (op)
+        {
+        case '+': out->v[i] = a->v[i] + b->v[i]; break;
+        case '-': out->v[i] = a->v[i] - b->v[i]; break;
+        case '*': out->v[i] = a->v[i] * b->v[i]; break;
+        case '/': out->v[i] = a->v[i] / b->v[i]; break;
+        case '%': out->v[i] = fmodf( a->v[i], b->v[i] ); break;
+        default: return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+static float length( const struct expr_value *v )
+{
+    float sum = 0;
+    UINT i;
+
+    for (i = 0; i < value_size( v->kind ); i++) sum += v->v[i] * v->v[i];
+    return sqrtf( sum );
+}
+
+typedef float (*unary_fn)( float );
+
+static float to_radians( float v ) { return v * (float)M_PI / 180.0f; }
+static float to_degrees( float v ) { return v * 180.0f / (float)M_PI; }
+static float square( float v ) { return v * v; }
+static float round_half_away( float v ) { return roundf( v ); }
+
+static const struct
+{
+    const WCHAR *name;
+    unary_fn fn;
+}
+unary_functions[] =
+{
+    { L"Abs", fabsf }, { L"Acos", acosf }, { L"Asin", asinf }, { L"Atan", atanf }, { L"Ceil", ceilf },
+    { L"Cos", cosf }, { L"Floor", floorf }, { L"Ln", logf }, { L"Log10", log10f }, { L"Round", round_half_away },
+    { L"Sin", sinf }, { L"Sqrt", sqrtf }, { L"Square", square }, { L"Tan", tanf }, { L"ToDegrees", to_degrees },
+    { L"ToRadians", to_radians },
+};
+
+static BOOL same_shape( const struct expr_value *a, const struct expr_value *b )
+{
+    return a->kind == b->kind;
+}
+
+static BOOL eval_call( struct expr_node *node, struct expr_context *ctx, struct expr_value *value )
+{
+    struct expr_value args[MAX_ARGS];
+    const WCHAR *name = node->name;
+    UINT i, j;
+
+    for (i = 0; i < node->argc; i++)
+        if (!expr_eval( node->args[i], ctx, &args[i] )) return FALSE;
+
+    for (i = 0; i < ARRAY_SIZE(unary_functions); i++)
+    {
+        if (wcsicmp( name, unary_functions[i].name )) continue;
+        if (node->argc != 1 || args[0].kind == ANIM_BOOLEAN) return FALSE;
+        *value = args[0];
+        for (j = 0; j < value_size( value->kind ); j++) value->v[j] = unary_functions[i].fn( value->v[j] );
+        return TRUE;
+    }
+
+    if (!wcsicmp( name, L"Vector2" ) || !wcsicmp( name, L"Vector3" ) || !wcsicmp( name, L"Vector4" )
+            || !wcsicmp( name, L"Quaternion" ))
+    {
+        UINT want = !wcsicmp( name, L"Vector2" ) ? 2 : !wcsicmp( name, L"Vector3" ) ? 3 : 4, n = 0;
+
+        memset( value, 0, sizeof(*value) );
+        /* scalars and smaller vectors, in order */
+        for (i = 0; i < node->argc; i++)
+            for (j = 0; j < value_size( args[i].kind ); j++)
+            {
+                if (n == want || args[i].kind == ANIM_BOOLEAN) return FALSE;
+                value->v[n++] = args[i].v[j];
+            }
+        if (n != want) return FALSE;
+        value->kind = !wcsicmp( name, L"Quaternion" ) ? ANIM_QUATERNION : vector_kinds[want];
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"ColorRgb" ) || !wcsicmp( name, L"ColorArgb" ))
+    {
+        if (node->argc != 4) return FALSE;
+        memset( value, 0, sizeof(*value) );
+        value->kind = ANIM_COLOR;
+        for (i = 0; i < 4; i++) value->v[i] = args[i].v[0];
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Min" ) || !wcsicmp( name, L"Max" ))
+    {
+        BOOL min = !wcsicmp( name, L"Min" );
+        if (node->argc != 2 || !same_shape( &args[0], &args[1] )) return FALSE;
+        *value = args[0];
+        for (j = 0; j < value_size( value->kind ); j++)
+            value->v[j] = min ? fminf( args[0].v[j], args[1].v[j] ) : fmaxf( args[0].v[j], args[1].v[j] );
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Clamp" ))
+    {
+        if (node->argc != 3) return FALSE;
+        *value = args[0];
+        for (j = 0; j < value_size( value->kind ); j++)
+        {
+            float lo = args[1].v[value_size( args[1].kind ) == 1 ? 0 : j];
+            float hi = args[2].v[value_size( args[2].kind ) == 1 ? 0 : j];
+            value->v[j] = fminf( fmaxf( value->v[j], lo ), hi );
+        }
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Lerp" ) || !wcsicmp( name, L"ColorLerp" ) || !wcsicmp( name, L"ColorLerpRgb" ))
+    {
+        float t;
+        if (node->argc != 3 || !same_shape( &args[0], &args[1] )) return FALSE;
+        t = args[2].v[0];
+        *value = args[0];
+        for (j = 0; j < value_size( value->kind ); j++)
+            value->v[j] = args[0].v[j] + (args[1].v[j] - args[0].v[j]) * t;
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Mod" ) || !wcsicmp( name, L"Pow" ))
+    {
+        BOOL mod = !wcsicmp( name, L"Mod" );
+        if (node->argc != 2 || value_size( args[1].kind ) != 1) return FALSE;
+        *value = args[0];
+        for (j = 0; j < value_size( value->kind ); j++)
+            value->v[j] = mod ? fmodf( value->v[j], args[1].v[0] ) : powf( value->v[j], args[1].v[0] );
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Scale" ))
+    {
+        if (node->argc != 2 || value_size( args[1].kind ) != 1) return FALSE;
+        *value = args[0];
+        for (j = 0; j < value_size( value->kind ); j++) value->v[j] *= args[1].v[0];
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Length" ) || !wcsicmp( name, L"LengthSquared" ))
+    {
+        float l;
+        if (node->argc != 1) return FALSE;
+        l = length( &args[0] );
+        set_scalar( value, !wcsicmp( name, L"Length" ) ? l : l * l );
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Distance" ) || !wcsicmp( name, L"DistanceSquared" ))
+    {
+        struct expr_value d;
+        float l;
+        if (node->argc != 2 || !same_shape( &args[0], &args[1] )) return FALSE;
+        d = args[0];
+        for (j = 0; j < value_size( d.kind ); j++) d.v[j] -= args[1].v[j];
+        l = length( &d );
+        set_scalar( value, !wcsicmp( name, L"Distance" ) ? l : l * l );
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Normalize" ))
+    {
+        float l;
+        if (node->argc != 1) return FALSE;
+        *value = args[0];
+        if (!(l = length( value ))) return TRUE;
+        for (j = 0; j < value_size( value->kind ); j++) value->v[j] /= l;
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Slerp" ))
+    {
+        if (node->argc != 3 || args[0].kind != ANIM_QUATERNION || args[1].kind != ANIM_QUATERNION) return FALSE;
+        memset( value, 0, sizeof(*value) );
+        value->kind = ANIM_QUATERNION;
+        anim_slerp( args[0].v, args[1].v, args[2].v[0], value->v );
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"CreateFromAxisAngle" ))
+    {
+        float half, s, l;
+        if (node->argc != 2 || args[0].kind != ANIM_VECTOR3) return FALSE;
+        half = args[1].v[0] / 2.0f;
+        s = sinf( half );
+        l = length( &args[0] );
+        if (!l) l = 1.0f;
+        memset( value, 0, sizeof(*value) );
+        value->kind = ANIM_QUATERNION;
+        for (j = 0; j < 3; j++) value->v[j] = args[0].v[j] / l * s;
+        value->v[3] = cosf( half );
+        return TRUE;
+    }
+    FIXME( "function %s not supported.\n", debugstr_w( name ) );
+    return FALSE;
+}
+
+BOOL expr_eval( struct expr_node *node, struct expr_context *ctx, struct expr_value *value )
+{
+    struct expr_value a, b;
+    UINT i;
+
+    switch (node->type)
+    {
+    case NODE_NUMBER:
+        set_scalar( value, node->number );
+        return TRUE;
+    case NODE_BOOLEAN:
+        set_boolean( value, node->number != 0 );
+        return TRUE;
+    case NODE_NAME:
+        return eval_name( node, ctx, value );
+    case NODE_CALL:
+        return eval_call( node, ctx, value );
+    case NODE_UNARY:
+        if (!expr_eval( node->args[0], ctx, value )) return FALSE;
+        if (node->op == '!')
+        {
+            set_boolean( value, !truth( value ) );
+            return TRUE;
+        }
+        if (value->kind == ANIM_BOOLEAN) return FALSE;
+        for (i = 0; i < value_size( value->kind ); i++) value->v[i] = -value->v[i];
+        return TRUE;
+    case NODE_BINARY:
+#ifdef SG_MUTANT_EXPR_LEFT_ONLY
+        return expr_eval( node->args[0], ctx, value );
+#endif
+        if (!expr_eval( node->args[0], ctx, &a ) || !expr_eval( node->args[1], ctx, &b )) return FALSE;
+        return eval_binary( node->op, &a, &b, value );
+    case NODE_CONDITIONAL:
+        if (!expr_eval( node->args[0], ctx, &a )) return FALSE;
+        return expr_eval( node->args[truth( &a ) ? 1 : 2], ctx, value );
+    }
+    return FALSE;
+}
