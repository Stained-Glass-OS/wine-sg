+/* under the lock: a copy of the animation's parameters */
+static BOOL snapshot_params( struct running *r, struct animation *anim )
+{
+    struct parameter *parameter;
+    UINT count = list_count( &anim->parameters ), i = 0;
+
+    if (!count) return TRUE;
+    if (!(r->params = calloc( count, sizeof(*r->params) ))) return FALSE;
+    LIST_FOR_EACH_ENTRY( parameter, &anim->parameters, struct parameter, entry )
+    {
+        r->params[i] = parameter->p;
+        if (!(r->params[i].name = wcsdup( parameter->p.name ))) break;
+        if (r->params[i].object) ICompositionObject_AddRef( r->params[i].object );
+        i++;
+    }
+    r->param_count = i;
+    return i == count;
+}
+
+/* an object's property by name, asked through its StartAnimation with an internal animation */
+static BOOL resolve_reference( struct expr_context *ctx, ICompositionObject *object, const WCHAR *path,
+                               struct anim_property *prop )
+{
+    struct running *r = ctx->user;
+    HSTRING name;
+    BOOL found;
+
+#ifdef SG_MUTANT_EXPR_NO_REFERENCES
+    return FALSE;
+#endif
+    if (!r->probe && FAILED(animation_create( r->probe_compositor, ANIM_NONE, &expression_vtbl, &r->probe )))
+        return FALSE;
+    if (FAILED(WindowsCreateString( path, wcslen( path ), &name ))) return FALSE;
+    r->probe->probe = prop;
+    r->probe->probe_found = FALSE;
+    ICompositionObject_StartAnimation( object, name, &r->probe->ICompositionAnimation_iface );
+    found = r->probe->probe_found;
+    r->probe->probe = NULL;
+    WindowsDeleteString( name );
+    if (!found) WARN( "no property %s on %p.\n", debugstr_w( path ), object );
+    return found;
+}
+
+static void running_context( struct running *r, struct expr_context *ctx )
+{
+    memset( ctx, 0, sizeof(*ctx) );
+    ctx->kind = r->prop.kind;
+    ctx->start = r->start;
+    ctx->target = &r->prop;
+    ctx->target_object = r->target_object;
+    ctx->params = r->params;
+    ctx->param_count = r->param_count;
+    ctx->resolve = resolve_reference;
+    ctx->user = r;
+}
+
+/* under the lock: evaluates the expression key frames once, when started */
+static void evaluate_keyframes( struct running *r, const struct animation *anim )
+{
+    struct expr_context ctx;
+    struct expr_value value;
+    struct expr_node *node;
+    UINT i;
+
+    running_context( r, &ctx );
+    for (i = 0; i < r->count; i++)
+    {
+        struct keyframe *frame = &r->frames[i];
+        const WCHAR *text = anim->frames[i].expression;
+
+        frame->expression = NULL;
+        if (frame->source != KEYFRAME_EXPRESSION) continue;
+        frame->source = KEYFRAME_HOLD;
+        if (FAILED(expr_parse( text, &node ))) continue;
+        if (expr_eval( node, &ctx, &value ) && value.kind == r->kind)
+        {
+            memcpy( frame->value, value.v, sizeof(frame->value) );
+            frame->source = KEYFRAME_VALUE;
+        }
+        else FIXME( "expression key frame %s not evaluated.\n", debugstr_w( text ) );
+        expr_free( node );
+    }
+}
+
+/* under the lock: an expression animation's value now; TRUE if it changed the property */
+static BOOL evaluate_expression( struct running *r )
+{
+    struct expr_context ctx;
+    struct expr_value value;
+    float current[4];
+
+    running_context( r, &ctx );
+    if (!expr_eval( r->expr, &ctx, &value )) return FALSE;
+    if (value.kind != r->prop.kind) return FALSE;
+    anim_prop_read( &r->prop, current );
+    if (!memcmp( current, value.v, kind_size( r->prop.kind ) * sizeof(float) )) return FALSE;
+    prop_write( &r->prop, value.v );
+    return TRUE;
+}
