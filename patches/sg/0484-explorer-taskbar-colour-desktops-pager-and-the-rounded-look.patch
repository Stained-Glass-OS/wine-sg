+/* a rectangle with round ends or corners, filled */
+static void sg_fill_round( HDC hdc, const RECT *rect, int radius, COLORREF color )
+{
+    HBRUSH brush = CreateSolidBrush( color ), oldb = SelectObject( hdc, brush );
+    HPEN pen = CreatePen( PS_SOLID, 1, color ), oldp = SelectObject( hdc, pen );
+    RoundRect( hdc, rect->left, rect->top, rect->right, rect->bottom, 2 * radius, 2 * radius );
+    SelectObject( hdc, oldb );
+    SelectObject( hdc, oldp );
+    DeleteObject( brush );
+    DeleteObject( pen );
+}
+
+/* a button's background: the whole button filled, as Windows 10 does, or in
+ * the Rounded style the bar with a rounded plate under the pointer or the
+ * foreground window, as newer Windows does */
+static void sg_button_back( HDC hdc, const RECT *rect, COLORREF bg )
+{
+    RECT plate = *rect;
+
+    if (!sg_rounded || bg == SG_COL_BAR)
+    {
+        sg_fill( hdc, rect, bg );
+        return;
+    }
+    sg_fill( hdc, rect, SG_COL_BAR );
+    InflateRect( &plate, -2, -4 );
+    sg_fill_round( hdc, &plate, 4, bg );
+}
