 /* Stained Glass OS: the Windows mode decides the bar's palette */
+static DWORD sg_reg_dword( const WCHAR *key, const WCHAR *name, DWORD def );
+
+static COLORREF sg_mix( COLORREF a, COLORREF b, int percent_b )
+{
+    return RGB( (GetRValue(a) * (100 - percent_b) + GetRValue(b) * percent_b) / 100,
+                (GetGValue(a) * (100 - percent_b) + GetGValue(b) * percent_b) / 100,
+                (GetBValue(a) * (100 - percent_b) + GetBValue(b) * percent_b) / 100 );
+}
+
 static void sg_load_mode(void)
 {
     DWORD light = 0, size = sizeof(light);
 
     RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
                   L"SystemUsesLightTheme", RRF_RT_REG_DWORD, NULL, &light, &size );
-    sg_pal = light ? &sg_light_palette : &sg_dark_palette;
+    sg_rounded = sg_reg_dword( L"Software\\Stained Glass\\Style", L"Rounded", 0 ) != 0;
+    switch (sg_reg_dword( L"Software\\Stained Glass\\Taskbar", L"Color", 0 ))
+    {
+    case 1: sg_pal = &sg_dark_palette; break;
+    case 2: sg_pal = &sg_light_palette; break;
+    case 3: sg_pal = &sg_blue_palette; break;
+    case 4:
+    {
+        COLORREF accent = taskbar_accent();
+        sg_accent_palette.bar = sg_mix( accent, RGB(0,0,0), 45 );
+        sg_accent_palette.hover = sg_mix( accent, RGB(0,0,0), 25 );
+        sg_accent_palette.active = sg_mix( accent, RGB(0xFF,0xFF,0xFF), 10 );
+        sg_accent_palette.text = RGB(0xFF,0xFF,0xFF);
+        sg_pal = &sg_accent_palette;
+        break;
+    }
+    default:
+        sg_pal = !light ? &sg_dark_palette : sg_rounded ? &sg_blue_palette : &sg_light_palette;
+        break;
+    }
 }
 
