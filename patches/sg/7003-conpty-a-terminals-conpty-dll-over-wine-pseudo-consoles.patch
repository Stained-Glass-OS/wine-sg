diff --git a/programs/conhost/conhost.c b/programs/conhost/conhost.c
index c3aaa69..82c4f67 100644
--- a/programs/conhost/conhost.c
+++ b/programs/conhost/conhost.c
@@ -3919,6 +3919,35 @@ static void resize_pseudo_console( struct console *console, unsigned int width,
     }
 }
 
+/* Stained Glass OS (wine-sg 7003): the terminal cleared its view (ConptyClearPseudoConsole,
+ * VS Code's "Clear"): the buffer is cleared but the cursor's line, which moves to the top,
+ * so that nothing cleared is drawn again. The terminal keeps that line at its top too. */
+static void clear_pseudo_console( struct console *console )
+{
+    struct screen_buffer *sb = console->active;
+    unsigned int row, i, count;
+
+    if (!sb || !sb->data) return;
+    row = min( sb->cursor_y, sb->height - 1 );
+    TRACE( "keeping row %u\n", row );
+#ifndef SG_MUTANT_CONPTY_CLEAR_IGNORED
+    if (row)
+    {
+        memmove( sb->data, sb->data + row * sb->width, sb->width * sizeof(*sb->data) );
+        if (sb->rgb_fg) memmove( sb->rgb_fg, sb->rgb_fg + row * sb->width, sb->width * sizeof(*sb->rgb_fg) );
+        if (sb->rgb_bg) memmove( sb->rgb_bg, sb->rgb_bg + row * sb->width, sb->width * sizeof(*sb->rgb_bg) );
+    }
+    count = (sb->height - 1) * sb->width;
+    for (i = 0; i < count; i++) sb->data[sb->width + i] = empty_char_info;
+    if (sb->rgb_fg) memset( sb->rgb_fg + sb->width, 0, count * sizeof(*sb->rgb_fg) );
+    if (sb->rgb_bg) memset( sb->rgb_bg + sb->width, 0, count * sizeof(*sb->rgb_bg) );
+    sb->cursor_y = 0;
+    sb->win.bottom -= sb->win.top;
+    sb->win.top = 0;
+    if (console->tty_output && console->tty_cursor_y >= row) console->tty_cursor_y -= row;
+#endif
+}
+
 static int main_loop( struct console *console, HANDLE signal )
 {
     HANDLE signal_event = NULL;
@@ -3993,6 +4022,22 @@ static int main_loop( struct console *console, HANDLE signal )
                     LeaveCriticalSection( &console_section );
                 }
             }
+            else if (signal_id == 2)  /* ConptyClearPseudoConsole */
+            {
+                EnterCriticalSection( &console_section );
+                clear_pseudo_console( console );
+                LeaveCriticalSection( &console_section );
+            }
+            else if (signal_id == 1 || signal_id == 3)
+            {
+                /* show/hide (a 16-bit flag) and reparent (a 64-bit window): a pseudo
+                 * console has no window of its own; the data is read so the next
+                 * signal is found */
+                UINT64 data;
+                IO_STATUS_BLOCK io;
+                NtReadFile( signal, NULL, NULL, NULL, &io, &data,
+                            signal_id == 1 ? sizeof(unsigned short) : sizeof(UINT64), NULL, NULL );
+            }
             else FIXME( "unimplemented signal %x\n", signal_id );
             status = NtReadFile( signal, signal_event, NULL, NULL, &signal_io, &signal_id,
                                  sizeof(signal_id), NULL, NULL );
