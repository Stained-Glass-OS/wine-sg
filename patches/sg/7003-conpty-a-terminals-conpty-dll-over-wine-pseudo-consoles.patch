new file mode 100644
index 0000000..5d95bb0
--- /dev/null
+++ b/dlls/conpty/conpty.spec
@@ -0,0 +1,10 @@
+@ stdcall ConptyCreatePseudoConsole(long ptr ptr long ptr)
