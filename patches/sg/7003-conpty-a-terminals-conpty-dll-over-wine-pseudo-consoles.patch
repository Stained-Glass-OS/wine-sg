diff --git a/dlls/conpty/conpty.c b/dlls/conpty/conpty.c
new file mode 100644
index 0000000..6910f12
--- /dev/null
+++ b/dlls/conpty/conpty.c
@@ -0,0 +1,174 @@
+/*
+ * conpty.dll: the ConPTY library that terminals ship (Windows Terminal,
+ * node-pty for VS Code and other Electron terminals), over Wine's pseudo
+ * consoles.
+ *
+ * The library programs carry starts its own console host (OpenConsole.exe)
+ * on the kernel's console driver (\Device\ConDrv\Server), neither of which
+ * exists here; Wine's pseudo consoles are hosted by conhost.exe. This builtin
+ * replaces it (HKLM\Software\Wine\DllOverrides "conpty"="builtin", wine.inf)
+ * and keeps its calls: the pseudo console is kernelbase's, and the signals
+ * the library sends its host -- resize, clear, show/hide, reparent -- go
+ * down the same signal pipe to conhost.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "wincon.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(console);
+
+/* kernelbase's HPCON (dlls/kernelbase/kernelbase.h): the signal pipe to the
+ * host, the console reference, and the host's process */
+struct pseudo_console
+{
+    HANDLE signal;
+    HANDLE reference;
+    HANDLE process;
+};
+
+/* the signals a ConPTY host reads from its signal pipe: a 16-bit code, then its data */
+#define PTY_SIGNAL_SHOWHIDE_WINDOW  1
+#define PTY_SIGNAL_CLEAR_WINDOW     2
+#define PTY_SIGNAL_REPARENT_WINDOW  3
+#define PTY_SIGNAL_RESIZE_WINDOW    8
+
+static HRESULT send_signal( HPCON handle, const void *msg, DWORD size )
+{
+    struct pseudo_console *pc = handle;
+    DWORD written;
+
+    if (!pc || !pc->signal) return E_INVALIDARG;
+    if (!WriteFile( pc->signal, msg, size, &written, NULL ) || written != size)
+        return HRESULT_FROM_WIN32( GetLastError() );
+    return S_OK;
+}
+
+HRESULT WINAPI ConptyCreatePseudoConsole( COORD size, HANDLE input, HANDLE output, DWORD flags, HPCON *ret )
+{
+    TRACE( "(%u,%u) %p %p %#lx %p\n", size.X, size.Y, input, output, flags, ret );
+    return CreatePseudoConsole( size, input, output, flags, ret );
+}
+
+HRESULT WINAPI ConptyCreatePseudoConsoleAsUser( HANDLE token, COORD size, HANDLE input, HANDLE output,
+                                                DWORD flags, HPCON *ret )
+{
+    TRACE( "%p (%u,%u) %p %p %#lx %p\n", token, size.X, size.Y, input, output, flags, ret );
+    /* the host runs as the caller; another user's host is not supported */
+    if (token)
+    {
+        FIXME( "host as another user (token %p) not supported\n", token );
+        return E_NOTIMPL;
+    }
+    return CreatePseudoConsole( size, input, output, flags, ret );
+}
+
+HRESULT WINAPI ConptyResizePseudoConsole( HPCON handle, COORD size )
+{
+    TRACE( "%p (%u,%u)\n", handle, size.X, size.Y );
+    return ResizePseudoConsole( handle, size );
+}
+
+/* the terminal cleared its view: the host clears its buffer but the cursor's line */
+HRESULT WINAPI ConptyClearPseudoConsole( HPCON handle )
+{
+    unsigned short msg = PTY_SIGNAL_CLEAR_WINDOW;
+
+    TRACE( "%p\n", handle );
+    return send_signal( handle, &msg, sizeof(msg) );
+}
+
+HRESULT WINAPI ConptyShowHidePseudoConsole( HPCON handle, BOOL show )
+{
+    unsigned short msg[2] = { PTY_SIGNAL_SHOWHIDE_WINDOW, show ? 1 : 0 };
+
+    TRACE( "%p %d\n", handle, show );
+    return send_signal( handle, msg, sizeof(msg) );
+}
+
+HRESULT WINAPI ConptyReparentPseudoConsole( HPCON handle, HWND parent )
+{
+    BYTE msg[sizeof(unsigned short) + sizeof(UINT64)];
+    unsigned short code = PTY_SIGNAL_REPARENT_WINDOW;
+    UINT64 hwnd = (ULONG_PTR)parent;
+
+    TRACE( "%p %p\n", handle, parent );
+    /* the code, then the window as a 64-bit value, in one write */
+    memcpy( msg, &code, sizeof(code) );
+    memcpy( msg + sizeof(code), &hwnd, sizeof(hwnd) );
+    return send_signal( handle, msg, sizeof(msg) );
+}
+
+/* let the host exit once its last client goes, without closing the signal pipe */
+HRESULT WINAPI ConptyReleasePseudoConsole( HPCON handle )
+{
+    struct pseudo_console *pc = handle;
+
+    TRACE( "%p\n", handle );
+    if (!pc) return E_INVALIDARG;
+#ifndef SG_MUTANT_CONPTY_RELEASE_KEEPS
+    if (pc->reference)
+    {
+        CloseHandle( pc->reference );
+        pc->reference = NULL;
+    }
+#endif
+    return S_OK;
+}
+
+void WINAPI ConptyClosePseudoConsole( HPCON handle )
+{
+    TRACE( "%p\n", handle );
+    ClosePseudoConsole( handle );
+}
+
+void WINAPI ConptyClosePseudoConsoleTimeout( HPCON handle, DWORD timeout )
+{
+    struct pseudo_console *pc = handle;
+
+    TRACE( "%p %lu\n", handle, timeout );
+    if (!pc) return;
+    if (pc->signal) CloseHandle( pc->signal );
+    pc->signal = NULL;
+    if (pc->process)
+    {
+        WaitForSingleObject( pc->process, timeout );
+        CloseHandle( pc->process );
+        pc->process = NULL;
+    }
+    if (pc->reference) CloseHandle( pc->reference );
+    pc->reference = NULL;
+}
+
+/* a pseudo console from the handles of a host started elsewhere; they now belong to it */
+HRESULT WINAPI ConptyPackPseudoConsole( HANDLE process, HANDLE reference, HANDLE signal, HPCON *ret )
+{
+    struct pseudo_console *pc;
+
+    TRACE( "%p %p %p %p\n", process, reference, signal, ret );
+    if (!ret) return E_INVALIDARG;
+    if (!(pc = HeapAlloc( GetProcessHeap(), 0, sizeof(*pc) ))) return E_OUTOFMEMORY;
+    pc->signal = signal;
+    pc->reference = reference;
+    pc->process = process;
+    *ret = pc;
+    return S_OK;
+}
