From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: register access routines.

READ_REGISTER_BUFFER_UCHAR did nothing; it, READ_REGISTER_UCHAR/USHORT/
ULONG, READ_REGISTER_BUFFER_USHORT/ULONG and the WRITE_REGISTER_ family
were unimplemented exports. They read or write one register of the width or
Count registers in a row, with a memory barrier.

Gate: test/ntoskrnl-regs-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -4102,7 +4102,96 @@
  */
 VOID WINAPI READ_REGISTER_BUFFER_UCHAR(PUCHAR Register, PUCHAR Buffer, ULONG Count)
 {
-    FIXME("stub\n");
+    ULONG i;
+
+    MemoryBarrier();
+    for (i = 0; i < Count; i++) Buffer[i] = ((volatile UCHAR *)Register)[i];
+}
+
+/* the register access routines read or write one register of the given width, the buffer
+ * variants Count registers in a row; each is a memory barrier as well */
+UCHAR WINAPI READ_REGISTER_UCHAR(PUCHAR Register)
+{
+    MemoryBarrier();
+    return *(volatile UCHAR *)Register;
+}
+
+USHORT WINAPI READ_REGISTER_USHORT(PUSHORT Register)
+{
+    MemoryBarrier();
+#ifdef SG_MUTANT_REGISTER_WIDTH
+    return *(volatile UCHAR *)Register;
+#else
+    return *(volatile USHORT *)Register;
+#endif
+}
+
+ULONG WINAPI READ_REGISTER_ULONG(PULONG Register)
+{
+    MemoryBarrier();
+    return *(volatile ULONG *)Register;
+}
+
+VOID WINAPI READ_REGISTER_BUFFER_USHORT(PUSHORT Register, PUSHORT Buffer, ULONG Count)
+{
+    ULONG i;
+
+    MemoryBarrier();
+    for (i = 0; i < Count; i++) Buffer[i] = ((volatile USHORT *)Register)[i];
+}
+
+VOID WINAPI READ_REGISTER_BUFFER_ULONG(PULONG Register, PULONG Buffer, ULONG Count)
+{
+    ULONG i;
+
+    MemoryBarrier();
+    for (i = 0; i < Count; i++) Buffer[i] = ((volatile ULONG *)Register)[i];
+}
+
+VOID WINAPI WRITE_REGISTER_UCHAR(PUCHAR Register, UCHAR Value)
+{
+    *(volatile UCHAR *)Register = Value;
+    MemoryBarrier();
+}
+
+VOID WINAPI WRITE_REGISTER_USHORT(PUSHORT Register, USHORT Value)
+{
+    *(volatile USHORT *)Register = Value;
+    MemoryBarrier();
+}
+
+VOID WINAPI WRITE_REGISTER_ULONG(PULONG Register, ULONG Value)
+{
+    *(volatile ULONG *)Register = Value;
+    MemoryBarrier();
+}
+
+VOID WINAPI WRITE_REGISTER_BUFFER_UCHAR(PUCHAR Register, PUCHAR Buffer, ULONG Count)
+{
+    ULONG i;
+
+    for (i = 0; i < Count; i++) ((volatile UCHAR *)Register)[i] = Buffer[i];
+    MemoryBarrier();
+}
+
+VOID WINAPI WRITE_REGISTER_BUFFER_USHORT(PUSHORT Register, PUSHORT Buffer, ULONG Count)
+{
+    ULONG i;
+
+    for (i = 0; i < Count; i++) ((volatile USHORT *)Register)[i] = Buffer[i];
+    MemoryBarrier();
+}
+
+VOID WINAPI WRITE_REGISTER_BUFFER_ULONG(PULONG Register, PULONG Buffer, ULONG Count)
+{
+    ULONG i;
+
+#ifdef SG_MUTANT_REGISTER_COUNT
+    for (i = 0; i + 1 < Count; i++) ((volatile ULONG *)Register)[i] = Buffer[i];
+#else
+    for (i = 0; i < Count; i++) ((volatile ULONG *)Register)[i] = Buffer[i];
+#endif
+    MemoryBarrier();
 }
 
 /*****************************************************
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
--- a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
+++ b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
@@ -983,11 +983,11 @@
 @ stdcall PsTerminateSystemThread(long)
 @ extern PsThreadType
 @ stdcall READ_REGISTER_BUFFER_UCHAR(ptr ptr long)
-@ stub READ_REGISTER_BUFFER_ULONG
-@ stub READ_REGISTER_BUFFER_USHORT
-@ stub READ_REGISTER_UCHAR
-@ stub READ_REGISTER_ULONG
-@ stub READ_REGISTER_USHORT
+@ stdcall READ_REGISTER_BUFFER_ULONG(ptr ptr long)
+@ stdcall READ_REGISTER_BUFFER_USHORT(ptr ptr long)
+@ stdcall READ_REGISTER_UCHAR(ptr)
+@ stdcall READ_REGISTER_ULONG(ptr)
+@ stdcall READ_REGISTER_USHORT(ptr)
 @ stdcall RtlAbsoluteToSelfRelativeSD(ptr ptr ptr)
 @ stdcall RtlAddAccessAllowedAce(ptr long long ptr)
 @ stdcall RtlAddAccessAllowedAceEx(ptr long long long ptr)
@@ -1384,12 +1384,12 @@
 @ stub VfFailDriver
 @ stub VfFailSystemBIOS
 @ stub VfIsVerificationEnabled
-@ stub WRITE_REGISTER_BUFFER_UCHAR
-@ stub WRITE_REGISTER_BUFFER_ULONG
-@ stub WRITE_REGISTER_BUFFER_USHORT
-@ stub WRITE_REGISTER_UCHAR
-@ stub WRITE_REGISTER_ULONG
-@ stub WRITE_REGISTER_USHORT
+@ stdcall WRITE_REGISTER_BUFFER_UCHAR(ptr ptr long)
+@ stdcall WRITE_REGISTER_BUFFER_ULONG(ptr ptr long)
+@ stdcall WRITE_REGISTER_BUFFER_USHORT(ptr ptr long)
+@ stdcall WRITE_REGISTER_UCHAR(ptr long)
+@ stdcall WRITE_REGISTER_ULONG(ptr long)
+@ stdcall WRITE_REGISTER_USHORT(ptr long)
 @ stub WmiFlushTrace
 @ stub WmiQueryTrace
 @ stub WmiQueryTraceInformation
