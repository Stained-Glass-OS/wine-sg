From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:54:02 -0700
Subject: [PATCH] newdev: InstallNewDevice leaves *pReboot at 0 (3267)

InstallNewDevice returned TRUE without writing pReboot; it now reports no restart needed (0).

diff --git a/dlls/newdev/main.c b/dlls/newdev/main.c
index e8cd519..5e78f3d 100644
--- a/dlls/newdev/main.c
+++ b/dlls/newdev/main.c
@@ -43,7 +43,11 @@ WINE_DEFAULT_DEBUG_CHANNEL(setupapi);
  */
 BOOL WINAPI InstallNewDevice(HWND hwndParent, LPGUID ClassGuid, PDWORD pReboot)
 {
-    FIXME("Stub!\n");
+    FIXME("(%p, %s, %p) no device selection UI\n", hwndParent, debugstr_guid(ClassGuid), pReboot);
+    /* nothing was installed, so nothing needs a restart */
+#ifndef SG_MUTANT_NEWDEV
+    if (pReboot) *pReboot = 0;
+#endif
     return TRUE;
 }
 
