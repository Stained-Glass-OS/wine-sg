+/* The namespace declarations of an element have to agree: a prefix is declared once, or once
+ * to each namespace it is declared as, the element's own prefix is declared as its namespace,
+ * and a plain attribute cannot be named in the "xmlns" prefix. */
+static HRESULT validate_namespaces( const WS_XML_ELEMENT_NODE *elem )
+{
+    ULONG i, j;
+
+#ifdef SG_MUTANT_WS_XMLNS
+    return S_OK;
+#endif
+    for (i = 0; i < elem->attributeCount; i++)
+    {
+        const WS_XML_ATTRIBUTE *a = elem->attributes[i];
+
+        if (!a->isXmlNs)
+        {
+            /* the string is compared as C text: Wine's test names the prefix with its terminating zero */
+            if (a->prefix && a->prefix->length >= 5 && !memcmp( a->prefix->bytes, "xmlns", 5 ) &&
+                (a->prefix->length == 5 || (a->prefix->length == 6 && !a->prefix->bytes[5]))) return WS_E_INVALID_FORMAT;
+            continue;
+        }
+        if (elem->prefix && str_equal( a->prefix, elem->prefix ) && !str_equal( a->ns, elem->ns ))
+            return WS_E_INVALID_FORMAT;
+        for (j = i + 1; j < elem->attributeCount; j++)
+        {
+            const WS_XML_ATTRIBUTE *b = elem->attributes[j];
+            if (!b->isXmlNs || !str_equal( a->prefix, b->prefix )) continue;
+            if (!str_equal( a->ns, b->ns )) return WS_E_INVALID_FORMAT;
+        }
+    }
+    return S_OK;
+}
+
 static HRESULT set_namespaces( struct writer *writer )
 {
