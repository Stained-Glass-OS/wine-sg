From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: keep hidden/system attributes of read-only files

Found by the conformance comparison (shell32 shelldialogs, a test of
stubs-7e 5811 that failed on integ): the hidden and system attributes are
kept in a user extended attribute, which needs write permission on the
file; fd_set_file_info removed the write permission first, so a read-only
file could never be hidden (also when made read-only and hidden at once),
and a file created read-only and hidden lost "hidden" the same way. The
attribute is now written while the owner may write the file, then the
mode is set. Present on origin/main too (kernel32 file: one failure fewer).

CORE review: ntdll file attributes (a temporary owner-write bit while the
extended attribute is written, on files the caller may already change).
Gate rohidden; mutant SG_MUTANT_RO_XATTR_AFTER_CHMOD.
---
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -1815,15 +1815,26 @@ static NTSTATUS fd_set_file_info( int fd, UINT attr, BOOL force_set_xattr )
         /* add write permission only where we already have read permission */
         st.st_mode |= (0600 | ((st.st_mode & 044) >> 1)) & (~start_umask);
     }
-    if (fchmod( fd, st.st_mode ) == -1) return errno_to_status( errno );
-
     /* if the file has multiple names, we can't be sure that it is safe to not
        set the extended attribute, since any of the names could start with a dot */
     force_set_xattr = force_set_xattr || st.st_nlink > 1;
 
+    /* Stained Glass OS: a user extended attribute needs write permission on the file, so the
+     * hidden/system attributes of a read-only file (or one being made read-only) are written
+     * while the owner may still write it, and the mode is set afterwards (they were lost) */
+#ifndef SG_MUTANT_RO_XATTR_AFTER_CHMOD
+    if (!S_ISDIR( st.st_mode ) && !(st.st_mode & 0200)) fchmod( fd, st.st_mode | 0200 );
+    else if (fchmod( fd, st.st_mode ) == -1) return errno_to_status( errno );
     if (fd_set_dos_attrib( fd, attr, force_set_xattr ) == -1 && errno != ENOTSUP)
         WARN( "Failed to set extended attribute " SAMBA_XATTR_DOS_ATTRIB ". errno %d (%s)\n",
               errno, strerror( errno ) );
+    if (fchmod( fd, st.st_mode ) == -1) return errno_to_status( errno );
+#else
+    if (fchmod( fd, st.st_mode ) == -1) return errno_to_status( errno );
+    if (fd_set_dos_attrib( fd, attr, force_set_xattr ) == -1 && errno != ENOTSUP)
+        WARN( "Failed to set extended attribute " SAMBA_XATTR_DOS_ATTRIB ". errno %d (%s)\n",
+              errno, strerror( errno ) );
+#endif
 
     return STATUS_SUCCESS;
 }
@@ -4724,9 +4735,16 @@ NTSTATUS WINAPI NtCreateFile( HANDLE *handle, ACCESS_MASK access, OBJECT_ATTRIBU
             /* set any DOS extended attributes */
             if (!server_get_unix_fd( *handle, 0, &fd, &needs_close, NULL, NULL ))
             {
+                struct stat st;
+                /* Stained Glass OS: a file created read-only can not take a user extended
+                 * attribute: write it with the owner's write permission, then restore the mode */
+                BOOL ro = !fstat( fd, &st ) && S_ISREG( st.st_mode ) && !(st.st_mode & 0200);
+
+                if (ro) fchmod( fd, st.st_mode | 0200 );
                 if (fd_set_dos_attrib( fd, attributes, TRUE ) == -1 && errno != ENOTSUP)
                     WARN( "Failed to set extended attribute " SAMBA_XATTR_DOS_ATTRIB ". errno %d (%s)",
                           errno, strerror( errno ) );
+                if (ro) fchmod( fd, st.st_mode );
                 if (needs_close) close( fd );
             }
         }
