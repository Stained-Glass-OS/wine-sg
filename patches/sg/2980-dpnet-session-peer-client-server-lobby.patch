+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "objbase.h"
+
+#include "dpnet_private.h"
+
+
+#define DP8_APPDESC_FLAGS (DPNSESSION_CLIENT_SERVER | DPNSESSION_MIGRATE_HOST | DPNSESSION_NODPNSVR | \
+        DPNSESSION_REQUIREPASSWORD | DPNSESSION_NOENUMS | DPNSESSION_FAST_SIGNED | DPNSESSION_FULL_SIGNED)
+#define DP8_SEND_FLAGS (DPNOP_SYNC | DPNSEND_NOCOPY | DPNSEND_NOCOMPLETE | DPNSEND_COMPLETEONPROCESS | \
+        DPNSEND_GUARANTEED | DPNSEND_NONSEQUENTIAL | DPNSEND_NOLOOPBACK | DPNSEND_PRIORITY_LOW | \
+        DPNSEND_PRIORITY_HIGH | DPNSEND_COALESCE)
+#define DP8_CANCEL_FLAGS (DPNCANCEL_CONNECT | DPNCANCEL_ENUM | DPNCANCEL_SEND | DPNCANCEL_ALL_OPERATIONS | \
+        DPNCANCEL_PLAYER_SENDS | 0x00070000)
+
+static LONG next_dpnid = 0x00010000;
+static LONG next_handle = 0x00001000;
+
+/* ---------------------------------------------------------------- helpers */
+
+static DPNID alloc_dpnid(void)
+{
+    return InterlockedIncrement(&next_dpnid);
+}
+
+static DPNHANDLE alloc_handle(void)
+{
+    return InterlockedIncrement(&next_handle);
+}
+
+static void appdesc_free(DPN_APPLICATION_DESC *d)
+{
+    free(d->pwszSessionName);
+    free(d->pwszPassword);
+    free(d->pvReservedData);
+    free(d->pvApplicationReservedData);
+    memset(d, 0, sizeof(*d));
+}
+
+static HRESULT appdesc_validate(const DPN_APPLICATION_DESC *d)
+{
+    if (!d || d->dwSize != sizeof(*d)) return DPNERR_INVALIDPARAM;
+    if (d->dwFlags & ~DP8_APPDESC_FLAGS) return DPNERR_INVALIDFLAGS;
+    if (d->dwReservedDataSize && !d->pvReservedData) return DPNERR_INVALIDPARAM;
+    if (d->dwApplicationReservedDataSize && !d->pvApplicationReservedData) return DPNERR_INVALIDPARAM;
+    if (d->dwReservedDataSize > DPN_MAX_APPDESC_RESERVEDDATA_SIZE ||
+        d->dwApplicationReservedDataSize > DPN_MAX_APPDESC_RESERVEDDATA_SIZE)
+        return DPNERR_INVALIDPARAM;
+    if ((d->dwFlags & DPNSESSION_REQUIREPASSWORD) && !d->pwszPassword) return DPNERR_INVALIDPARAM;
+    return DPN_OK;
+}
+
+/* dst must be zeroed or freed */
+static HRESULT appdesc_copy(DPN_APPLICATION_DESC *dst, const DPN_APPLICATION_DESC *src)
+{
+    *dst = *src;
+    dst->pwszSessionName = NULL;
+    dst->pwszPassword = NULL;
+    dst->pvReservedData = NULL;
+    dst->pvApplicationReservedData = NULL;
+
+    if (src->pwszSessionName && !(dst->pwszSessionName = wcsdup(src->pwszSessionName))) goto oom;
+    if (src->pwszPassword && !(dst->pwszPassword = wcsdup(src->pwszPassword))) goto oom;
+    if (src->dwReservedDataSize)
+    {
+        if (!(dst->pvReservedData = malloc(src->dwReservedDataSize))) goto oom;
+        memcpy(dst->pvReservedData, src->pvReservedData, src->dwReservedDataSize);
+    }
+    if (src->dwApplicationReservedDataSize)
+    {
+        if (!(dst->pvApplicationReservedData = malloc(src->dwApplicationReservedDataSize))) goto oom;
+        memcpy(dst->pvApplicationReservedData, src->pvApplicationReservedData,
+                src->dwApplicationReservedDataSize);
+    }
+    return DPN_OK;
+
+oom:
+    appdesc_free(dst);
+    return E_OUTOFMEMORY;
+}
+
+static struct dp8_player *find_player(struct dp8_session *s, DPNID id)
+{
+    struct dp8_player *p;
+
+    LIST_FOR_EACH_ENTRY(p, &s->players, struct dp8_player, entry)
+        if (p->id == id) return p;
+    return NULL;
+}
+
+static struct dp8_group *find_group(struct dp8_session *s, DPNID id)
+{
+    struct dp8_group *g;
+
+    LIST_FOR_EACH_ENTRY(g, &s->groups, struct dp8_group, entry)
+        if (g->id == id) return g;
+    return NULL;
+}
+
+static BOOL group_has(const struct dp8_group *g, DPNID id)
+{
+    DWORD i;
+
+    for (i = 0; i < g->count; i++)
+        if (g->members[i] == id) return TRUE;
+    return FALSE;
+}
+
+static void group_free(struct dp8_group *g)
+{
+    free(g->name);
+    free(g->data);
+    free(g->members);
+    free(g);
+}
+
+static DWORD count_clients(struct dp8_session *s)
+{
+    struct dp8_player *p;
+    DWORD n = 0;
+
+    LIST_FOR_EACH_ENTRY(p, &s->players, struct dp8_player, entry)
+        if (!p->hidden) n++;
+    return n;
+}
+
+static BOOL in_session(const struct dp8_session *s)
+{
+    return s->state == DP8_HOSTING || s->state == DP8_CONNECTED;
+}
+
+static HRESULT check_init(struct dp8_session *s)
+{
+#ifdef SG_MUTANT_UNINIT
+    return DPN_OK;
+#endif
+    return s->msghandler ? DPN_OK : DPNERR_UNINITIALIZED;
+}
+
+static HRESULT send_msg(struct dp8_session *s, DWORD id, void *msg)
+{
+    PFNDPNMESSAGEHANDLER handler;
+    void *ctx;
+
+    EnterCriticalSection(&s->cs);
+    handler = s->msghandler;
+    ctx = s->usercontext;
+    LeaveCriticalSection(&s->cs);
+
+    if (!handler) return DPN_OK;
+    return handler(ctx, id, msg);
+}
+
+static void init_caps(DPN_CAPS_EX *caps)
+{
+    memset(caps, 0, sizeof(*caps));
+    caps->dwSize = sizeof(*caps);
+    caps->dwConnectTimeout = 200;
+    caps->dwConnectRetries = 14;
+    caps->dwTimeoutUntilKeepAlive = 60000;
+    caps->dwMaxRecvMsgSize = 65536;
+    caps->dwNumSendRetries = 10;
+    caps->dwMaxSendRetryInterval = 5000;
+    caps->dwDropThresholdRate = 8;
+    caps->dwThrottleRate = 12;
+    caps->dwNumHardDisconnectSends = 3;
+    caps->dwMaxHardDisconnectPeriod = 500;
+}
+
+void dp8s_init(struct dp8_session *s, enum dp8_role role, IUnknown *owner)
+{
+    memset(s, 0, sizeof(*s));
+    s->role = role;
+    s->owner = owner;
+    InitializeCriticalSection(&s->cs);
+    list_init(&s->players);
+    list_init(&s->groups);
+    list_init(&s->ops);
+    init_dpn_sp_caps(&s->spcaps);
+    init_caps(&s->caps);
+}
+
+static void free_lists(struct dp8_session *s)
+{
+    struct dp8_player *p, *p2;
+    struct dp8_group *g, *g2;
+    struct dp8_op *o, *o2;
+    DWORD i;
+
+    LIST_FOR_EACH_ENTRY_SAFE(p, p2, &s->players, struct dp8_player, entry)
+    {
+        list_remove(&p->entry);
+        free(p);
+    }
+    LIST_FOR_EACH_ENTRY_SAFE(g, g2, &s->groups, struct dp8_group, entry)
+    {
+        list_remove(&g->entry);
+        group_free(g);
+    }
+    LIST_FOR_EACH_ENTRY_SAFE(o, o2, &s->ops, struct dp8_op, entry)
+    {
+        list_remove(&o->entry);
+        free(o);
+    }
+    for (i = 0; i < s->num_devices; i++)
+        IDirectPlay8Address_Release(s->devices[i]);
+    free(s->devices);
+    s->devices = NULL;
+    s->num_devices = 0;
+}
+
+void dp8s_destroy(struct dp8_session *s)
+{
+    free_lists(s);
+    appdesc_free(&s->appdesc);
+    free(s->info_name);
+    free(s->info_data);
+    DeleteCriticalSection(&s->cs);
+}
+
+/* ------------------------------------------------- asynchronous operations */
+
+static struct dp8_op *op_add(struct dp8_session *s, enum dp8_op_type type, void *context)
+{
+    struct dp8_op *op = calloc(1, sizeof(*op));
+
+    if (!op) return NULL;
+    op->handle = alloc_handle();
+    op->context = context;
+    op->type = type;
+    EnterCriticalSection(&s->cs);
+    list_add_tail(&s->ops, &op->entry);
+    LeaveCriticalSection(&s->cs);
+    return op;
+}
+
+/* caller holds the lock; returns the detached op or NULL */
+static struct dp8_op *op_take(struct dp8_session *s, DPNHANDLE handle)
+{
+    struct dp8_op *op;
+
+    LIST_FOR_EACH_ENTRY(op, &s->ops, struct dp8_op, entry)
+    {
+        if (op->handle != handle) continue;
+        list_remove(&op->entry);
+        return op;
+    }
+    return NULL;
+}
+
+static void deliver_completion(struct dp8_session *s, enum dp8_op_type type, DPNHANDLE handle,
+        void *context, HRESULT hr)
+{
+    if (type == DP8_OP_CONNECT)
+    {
+        DPNMSG_CONNECT_COMPLETE msg;
+
+        EnterCriticalSection(&s->cs);
+        if (s->state == DP8_CONNECTING) s->state = DP8_IDLE;
+        LeaveCriticalSection(&s->cs);
+
+        memset(&msg, 0, sizeof(msg));
+        msg.dwSize = sizeof(msg);
+        msg.hAsyncOp = handle;
+        msg.pvUserContext = context;
+        msg.hResultCode = hr;
+        send_msg(s, DPN_MSGID_CONNECT_COMPLETE, &msg);
+    }
+    else if (type == DP8_OP_SEND)
+    {
+        DPNMSG_SEND_COMPLETE msg;
+
+        memset(&msg, 0, sizeof(msg));
+        msg.dwSize = sizeof(msg);
+        msg.hAsyncOp = handle;
+        msg.pvUserContext = context;
+        msg.hResultCode = hr;
+        send_msg(s, DPN_MSGID_SEND_COMPLETE, &msg);
+    }
+    else
+    {
+        DPNMSG_ASYNC_OP_COMPLETE msg;
+
+        msg.dwSize = sizeof(msg);
+        msg.hAsyncOp = handle;
+        msg.pvUserContext = context;
+        msg.hResultCode = hr;
+        send_msg(s, DPN_MSGID_ASYNC_OP_COMPLETE, &msg);
+    }
+}
+
+struct dp8_work
+{
+    struct dp8_session *session;
+    IUnknown *owner;
+    DPNHANDLE handle;
+    HRESULT hr;
+    DWORD delay;
+};
+
+static DWORD WINAPI work_proc(void *arg)
+{
+    struct dp8_work *w = arg;
+    struct dp8_op *op;
+
+    if (w->delay) Sleep(w->delay);
+
+    EnterCriticalSection(&w->session->cs);
+    op = op_take(w->session, w->handle);
+    LeaveCriticalSection(&w->session->cs);
+
+    if (op)
+    {
+        deliver_completion(w->session, op->type, op->handle, op->context, w->hr);
+        free(op);
+    }
+
+    IUnknown_Release(w->owner);
+    free(w);
+    return 0;
+}
+
+/* Finish an operation that was carried out (or failed) locally: synchronous
+ * callers get the result, asynchronous ones a handle and a completion message
+ * delivered afterwards. */
+static HRESULT finish_op(struct dp8_session *s, DWORD flags, void *context, DPNHANDLE *phandle,
+        enum dp8_op_type type, HRESULT completion, DWORD delay)
+{
+    struct dp8_work *w;
+    struct dp8_op *op;
+
+    if (flags & DPNOP_SYNC) return completion;
+
+    if (!(op = op_add(s, type, context))) return E_OUTOFMEMORY;
+    if (phandle) *phandle = op->handle;
+
+    if (!(w = calloc(1, sizeof(*w)))) goto inline_completion;
+    w->session = s;
+    w->owner = s->owner;
+    w->handle = op->handle;
+    w->hr = completion;
+    w->delay = delay;
+    IUnknown_AddRef(w->owner);
+    if (!QueueUserWorkItem(work_proc, w, WT_EXECUTEDEFAULT))
+    {
+        IUnknown_Release(w->owner);
+        free(w);
+        goto inline_completion;
+    }
+    return DPNSUCCESS_PENDING;
+
+inline_completion:
+    EnterCriticalSection(&s->cs);
+    op = op_take(s, op->handle);
+    LeaveCriticalSection(&s->cs);
+    if (op)
+    {
+        deliver_completion(s, type, op->handle, context, completion);
+        free(op);
+    }
+    return DPNSUCCESS_PENDING;
+}
+
+HRESULT dp8s_cancel(struct dp8_session *s, DPNHANDLE handle, DWORD flags)
+{
+    struct dp8_op *op, *op2;
+    struct list cancelled;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+
+    if (handle)
+    {
+        if (flags) return DPNERR_INVALIDFLAGS;
+
+        EnterCriticalSection(&s->cs);
+        LIST_FOR_EACH_ENTRY(op, &s->ops, struct dp8_op, entry)
+        {
+            if (op->handle != handle) continue;
+            if (op->type == DP8_OP_LOCAL)
+            {
+                LeaveCriticalSection(&s->cs);
+                return DPNERR_CANNOTCANCEL;
+            }
+            break;
+        }
+        op = op_take(s, handle);
+        LeaveCriticalSection(&s->cs);
+
+        if (!op) return DPNERR_INVALIDHANDLE;
+#ifdef SG_MUTANT_ASYNC
+        deliver_completion(s, op->type, op->handle, op->context, DPN_OK);
+#else
+        deliver_completion(s, op->type, op->handle, op->context, DPNERR_USERCANCEL);
+#endif
+        free(op);
+        return DPN_OK;
+    }
+
+    if (!flags) return DPNERR_INVALIDHANDLE;
+    if (flags & ~DP8_CANCEL_FLAGS) return DPNERR_INVALIDFLAGS;
+
+    list_init(&cancelled);
+    EnterCriticalSection(&s->cs);
+    LIST_FOR_EACH_ENTRY_SAFE(op, op2, &s->ops, struct dp8_op, entry)
+    {
+        BOOL take = FALSE;
+
+        if (op->type == DP8_OP_ENUM) take = flags & (DPNCANCEL_ENUM | DPNCANCEL_ALL_OPERATIONS);
+        else if (op->type == DP8_OP_CONNECT) take = flags & (DPNCANCEL_CONNECT | DPNCANCEL_ALL_OPERATIONS);
+        else if (op->type == DP8_OP_SEND) take = flags & (DPNCANCEL_SEND | DPNCANCEL_ALL_OPERATIONS);
+        if (!take) continue;
+        list_remove(&op->entry);
+        list_add_tail(&cancelled, &op->entry);
+    }
+    LeaveCriticalSection(&s->cs);
+
+    LIST_FOR_EACH_ENTRY_SAFE(op, op2, &cancelled, struct dp8_op, entry)
+    {
+        list_remove(&op->entry);
+        deliver_completion(s, op->type, op->handle, op->context, DPNERR_USERCANCEL);
+        free(op);
+    }
+    return DPN_OK;
+}
+
+/* ------------------------------------------------------ initialize / close */
+
+HRESULT dp8s_initialize(struct dp8_session *s, void *context, PFNDPNMESSAGEHANDLER pfn, DWORD flags)
+{
+    if (!pfn) return DPNERR_INVALIDPARAM;
+
+    EnterCriticalSection(&s->cs);
+    s->usercontext = context;
+    s->msghandler = pfn;
+    s->flags = flags;
+    LeaveCriticalSection(&s->cs);
+
+    init_winsock();
+    return DPN_OK;
+}
+
+HRESULT dp8s_close(struct dp8_session *s, DWORD flags)
+{
+    struct list ops, players, groups;
+    struct dp8_op *op, *op2;
+    struct dp8_player *p, *p2;
+    struct dp8_group *g, *g2;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags & ~DPNCLOSE_IMMEDIATE) return DPNERR_INVALIDFLAGS;
+
+    list_init(&ops);
+    list_init(&players);
+    list_init(&groups);
+
+    EnterCriticalSection(&s->cs);
+    list_move_tail(&ops, &s->ops);
+    list_move_tail(&players, &s->players);
+    list_move_tail(&groups, &s->groups);
+    LeaveCriticalSection(&s->cs);
+
+    /* Outstanding operations are cancelled, then the session members go away. */
+    LIST_FOR_EACH_ENTRY_SAFE(op, op2, &ops, struct dp8_op, entry)
+    {
+        list_remove(&op->entry);
+        if (op->type != DP8_OP_LOCAL)
+            deliver_completion(s, op->type, op->handle, op->context, DPNERR_USERCANCEL);
+        free(op);
+    }
+
+    LIST_FOR_EACH_ENTRY_SAFE(g, g2, &groups, struct dp8_group, entry)
+    {
+        DPNMSG_DESTROY_GROUP msg;
+
+        msg.dwSize = sizeof(msg);
+        msg.dpnidGroup = g->id;
+        msg.pvGroupContext = g->context;
+        msg.dwReason = DPNDESTROYGROUPREASON_NORMAL;
+        send_msg(s, DPN_MSGID_DESTROY_GROUP, &msg);
+        list_remove(&g->entry);
+        group_free(g);
+    }
+
+    LIST_FOR_EACH_ENTRY_SAFE(p, p2, &players, struct dp8_player, entry)
+    {
+        DPNMSG_DESTROY_PLAYER msg;
+
+        msg.dwSize = sizeof(msg);
+        msg.dpnidPlayer = p->id;
+        msg.pvPlayerContext = p->context;
+        msg.dwReason = DPNDESTROYPLAYERREASON_NORMAL;
+        send_msg(s, DPN_MSGID_DESTROY_PLAYER, &msg);
+        list_remove(&p->entry);
+        free(p);
+    }
+
+    EnterCriticalSection(&s->cs);
+    s->state = DP8_IDLE;
+    s->msghandler = NULL;
+    s->usercontext = NULL;
+    s->local_id = 0;
+    s->lobby_registered = FALSE;
+    appdesc_free(&s->appdesc);
+    free_lists(s);
+    LeaveCriticalSection(&s->cs);
+
+    return DPN_OK;
+}
+
+/* ------------------------------------------------------- host and connect */
+
+static HRESULT check_device(IDirectPlay8Address *addr, HRESULT invalid)
+{
+    GUID sp;
+
+    if (!addr) return invalid;
+    if (FAILED(IDirectPlay8Address_GetSP(addr, &sp))) return invalid;
+    return DPN_OK;
+}
+
+HRESULT dp8s_host(struct dp8_session *s, const DPN_APPLICATION_DESC *desc,
+        IDirectPlay8Address * const *devices, DWORD num_devices, void *player_context, DWORD flags)
+{
+    DPNMSG_CREATE_PLAYER msg;
+    struct dp8_player *player;
+    DPN_APPLICATION_DESC copy;
+    DWORD i;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags & ~DPNHOST_OKTOQUERYFORADDRESSING) return DPNERR_INVALIDFLAGS;
+    if (!desc || !devices || !num_devices) return DPNERR_INVALIDPARAM;
+    if (FAILED(hr = appdesc_validate(desc))) return hr;
+    for (i = 0; i < num_devices; i++)
+        if (FAILED(hr = check_device(devices[i], DPNERR_INVALIDDEVICEADDRESS))) return hr;
+
+    EnterCriticalSection(&s->cs);
+    if (s->state == DP8_HOSTING) hr = DPNERR_HOSTING;
+    else if (s->state == DP8_CONNECTED) hr = DPNERR_ALREADYCONNECTED;
+    else if (s->state == DP8_CONNECTING) hr = DPNERR_CONNECTING;
+    if (hr != DPN_OK)
+    {
+        LeaveCriticalSection(&s->cs);
+        return hr;
+    }
+
+    memset(&copy, 0, sizeof(copy));
+    if (FAILED(hr = appdesc_copy(&copy, desc))) goto done;
+    player = calloc(1, sizeof(*player));
+    if (!player || !(s->devices = calloc(num_devices, sizeof(*s->devices))))
+    {
+        free(player);
+        appdesc_free(&copy);
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    for (i = 0; i < num_devices; i++)
+    {
+        s->devices[i] = devices[i];
+        IDirectPlay8Address_AddRef(devices[i]);
+    }
+    s->num_devices = num_devices;
+
+    appdesc_free(&s->appdesc);
+    s->appdesc = copy;
+    CoCreateGuid(&s->appdesc.guidInstance);
+    if (s->role == DP8_ROLE_SERVER) s->appdesc.dwFlags |= DPNSESSION_CLIENT_SERVER;
+
+    player->id = alloc_dpnid();
+    player->context = player_context;
+    player->flags = DPNPLAYER_LOCAL | DPNPLAYER_HOST;
+    player->hidden = s->role == DP8_ROLE_SERVER;
+    list_add_tail(&s->players, &player->entry);
+    s->local_id = player->id;
+    s->state = DP8_HOSTING;
+
+    msg.dwSize = sizeof(msg);
+    msg.dpnidPlayer = player->id;
+    msg.pvPlayerContext = player_context;
+    hr = DPN_OK;
+
+done:
+    LeaveCriticalSection(&s->cs);
+    if (hr == DPN_OK) send_msg(s, DPN_MSGID_CREATE_PLAYER, &msg);
+    return hr;
+}
+
+HRESULT dp8s_connect(struct dp8_session *s, const DPN_APPLICATION_DESC *desc,
+        IDirectPlay8Address *host, IDirectPlay8Address *device, const void *connect_data,
+        DWORD connect_data_size, void *async_context, DPNHANDLE *phandle, DWORD flags)
+{
+    HRESULT hr;
+    WCHAR hostname[8];
+    DWORD size, type;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags & ~(DPNOP_SYNC | DPNCONNECT_OKTOQUERYFORADDRESSING)) return DPNERR_INVALIDFLAGS;
+    if (!desc || desc->dwSize != sizeof(*desc) || !host || !device) return DPNERR_INVALIDPARAM;
+    if ((flags & DPNOP_SYNC) && phandle) return DPNERR_INVALIDPARAM;
+    if (connect_data_size && !connect_data) return DPNERR_INVALIDPOINTER;
+    if (FAILED(hr = check_device(host, DPNERR_INVALIDHOSTADDRESS))) return hr;
+    if (FAILED(hr = check_device(device, DPNERR_INVALIDDEVICEADDRESS))) return hr;
+
+    size = sizeof(hostname);
+    hr = IDirectPlay8Address_GetComponentByName(host, DPNA_KEY_HOSTNAME, hostname, &size, &type);
+    if (hr == DPNERR_DOESNOTEXIST && !(flags & DPNCONNECT_OKTOQUERYFORADDRESSING))
+        return DPNERR_INCOMPLETEADDRESS;
+
+    EnterCriticalSection(&s->cs);
+    if (s->state == DP8_HOSTING) hr = DPNERR_HOSTING;
+    else if (s->state == DP8_CONNECTED) hr = DPNERR_ALREADYCONNECTED;
+    else if (s->state == DP8_CONNECTING) hr = DPNERR_CONNECTING;
+    else hr = DPN_OK;
+    if (hr == DPN_OK && !(flags & DPNOP_SYNC)) s->state = DP8_CONNECTING;
+    LeaveCriticalSection(&s->cs);
+    if (hr != DPN_OK) return hr;
+
+    /* Nothing answers on the host address: a synchronous connect fails at
+     * once, an asynchronous one completes with the same result. */
+#ifdef SG_MUTANT_CONNECT
+    if (flags & DPNOP_SYNC) return DPN_OK;
+#endif
+    if (flags & DPNOP_SYNC) return DPNERR_NORESPONSE;
+    /* the answer takes as long as the connect time-out */
+    return finish_op(s, flags, async_context, phandle, DP8_OP_CONNECT, DPNERR_NORESPONSE,
+            min(s->caps.dwConnectTimeout, 2000));
+}
+
+HRESULT dp8s_enum_hosts(struct dp8_session *s, const DPN_APPLICATION_DESC *desc,
+        IDirectPlay8Address *host, IDirectPlay8Address *device, DWORD data_size, void *context,
+        DPNHANDLE *phandle, DWORD flags)
+{
+    struct dp8_op *op;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags & ~(DPNOP_SYNC | DPNENUMHOSTS_OKTOQUERYFORADDRESSING | DPNENUMHOSTS_NOBROADCASTFALLBACK))
+        return DPNERR_INVALIDFLAGS;
+    if (!desc || desc->dwSize != sizeof(*desc) || !device) return DPNERR_INVALIDPARAM;
+    if ((flags & DPNOP_SYNC) && phandle) return DPNERR_INVALIDPARAM;
+    if (data_size > s->spcaps.dwMaxEnumPayloadSize) return DPNERR_ENUMQUERYTOOLARGE;
+
+    if (flags & DPNOP_SYNC) return DPN_OK;
+
+    /* The enumeration runs until it is cancelled or the object is closed. */
+    if (!(op = op_add(s, DP8_OP_ENUM, context))) return E_OUTOFMEMORY;
+    if (phandle) *phandle = op->handle;
+    return DPNSUCCESS_PENDING;
+}
+
+/* -------------------------------------------------------------- sending */
+
+HRESULT dp8s_send(struct dp8_session *s, DPNID target, const DPN_BUFFER_DESC *bufs, DWORD num_bufs,
+        void *async_context, DPNHANDLE *phandle, DWORD flags, BOOL to_server)
+{
+    BOOL deliver = FALSE;
+    DPNMSG_RECEIVE msg;
+    BYTE *data = NULL;
+    DWORD size = 0, i;
+    struct dp8_player *local;
+    DPNID sender = 0;
+    void *ctx = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags & ~DP8_SEND_FLAGS) return DPNERR_INVALIDFLAGS;
+    if ((flags & DPNSEND_PRIORITY_LOW) && (flags & DPNSEND_PRIORITY_HIGH)) return DPNERR_INVALIDFLAGS;
+    if (!bufs || !num_bufs) return DPNERR_INVALIDPARAM;
+    if ((flags & DPNOP_SYNC) && phandle) return DPNERR_INVALIDPARAM;
+    for (i = 0; i < num_bufs; i++)
+    {
+        if (bufs[i].dwBufferSize && !bufs[i].pBufferData) return DPNERR_INVALIDPOINTER;
+        size += bufs[i].dwBufferSize;
+    }
+
+    EnterCriticalSection(&s->cs);
+    if (!in_session(s))
+    {
+        LeaveCriticalSection(&s->cs);
+        return DPNERR_NOCONNECTION;
+    }
+
+    if (!to_server)
+    {
+        struct dp8_group *g = NULL;
+
+        local = find_player(s, s->local_id);
+        if (target && !find_player(s, target) && !(g = find_group(s, target)))
+            hr = DPNERR_INVALIDPLAYER;
+        else if (target && !g && find_player(s, target)->hidden)
+            hr = DPNERR_INVALIDPLAYER;
+        else if (s->role == DP8_ROLE_PEER && local &&
+#ifndef SG_MUTANT_SEND
+                !(flags & DPNSEND_NOLOOPBACK) &&
+#endif
+                (!target || target == local->id || (g && group_has(g, local->id))))
+            deliver = TRUE;
+    }
+    if (hr == DPN_OK && deliver)
+    {
+        data = malloc(size ? size : 1);
+        if (!data) hr = E_OUTOFMEMORY;
+        else
+        {
+            for (i = 0, size = 0; i < num_bufs; size += bufs[i++].dwBufferSize)
+                memcpy(data + size, bufs[i].pBufferData, bufs[i].dwBufferSize);
+            sender = local->id;
+            ctx = local->context;
+        }
+    }
+    LeaveCriticalSection(&s->cs);
+    if (hr != DPN_OK) return hr;
+
+    if (deliver)
+    {
+        memset(&msg, 0, sizeof(msg));
+        msg.dwSize = sizeof(msg);
+        msg.dpnidSender = sender;
+        msg.pvPlayerContext = ctx;
+        msg.pReceiveData = data;
+        msg.dwReceiveDataSize = size;
+        if (flags & DPNSEND_GUARANTEED) msg.dwReceiveFlags |= DPNRECEIVE_GUARANTEED;
+        send_msg(s, DPN_MSGID_RECEIVE, &msg);
+        free(data);
+    }
+
+    if (flags & (DPNOP_SYNC | DPNSEND_NOCOMPLETE)) return DPN_OK;
+    return finish_op(s, flags, async_context, phandle, DP8_OP_SEND, DPN_OK, 0);
+}
+
+HRESULT dp8s_get_send_queue(struct dp8_session *s, DPNID target, DWORD *msgs, DWORD *bytes,
+        DWORD flags, BOOL to_server)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags & ~(DPNGETSENDQUEUEINFO_PRIORITY_NORMAL | DPNGETSENDQUEUEINFO_PRIORITY_HIGH |
+            DPNGETSENDQUEUEINFO_PRIORITY_LOW)) return DPNERR_INVALIDFLAGS;
+
+    EnterCriticalSection(&s->cs);
+    if (!in_session(s)) hr = DPNERR_NOCONNECTION;
+    else if (!to_server && (!find_player(s, target) || find_player(s, target)->hidden))
+        hr = DPNERR_INVALIDPLAYER;
+    LeaveCriticalSection(&s->cs);
+    if (hr != DPN_OK) return hr;
+
+    if (msgs) *msgs = 0;
+    if (bytes) *bytes = 0;
+    return DPN_OK;
+}
+
+/* ------------------------------------------------------ application desc */
+
+HRESULT dp8s_get_appdesc(struct dp8_session *s, DPN_APPLICATION_DESC *buf, DWORD *size, DWORD flags)
+{
+    DWORD need, name_len = 0, pass_len = 0;
+    BYTE *p;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!size) return DPNERR_INVALIDPOINTER;
+    if (flags) return DPNERR_INVALIDFLAGS;
+
+    EnterCriticalSection(&s->cs);
+    if (!in_session(s))
+    {
+        LeaveCriticalSection(&s->cs);
+        return DPNERR_NOCONNECTION;
+    }
+
+    if (s->appdesc.pwszSessionName) name_len = (wcslen(s->appdesc.pwszSessionName) + 1) * sizeof(WCHAR);
+    if (s->appdesc.pwszPassword) pass_len = (wcslen(s->appdesc.pwszPassword) + 1) * sizeof(WCHAR);
+    need = sizeof(*buf) + name_len + pass_len + s->appdesc.dwReservedDataSize +
+            s->appdesc.dwApplicationReservedDataSize;
+
+    if (!buf || *size < need)
+    {
+#ifdef SG_MUTANT_BUFFER
+        *size = need - 1;
+#else
+        *size = need;
+#endif
+        LeaveCriticalSection(&s->cs);
+        return DPNERR_BUFFERTOOSMALL;
+    }
+    if (buf->dwSize != sizeof(*buf))
+    {
+        LeaveCriticalSection(&s->cs);
+        return DPNERR_INVALIDPARAM;
+    }
+
+    *buf = s->appdesc;
+    buf->dwCurrentPlayers = count_clients(s);
+    p = (BYTE *)(buf + 1);
+    buf->pwszSessionName = NULL;
+    buf->pwszPassword = NULL;
+    buf->pvReservedData = NULL;
+    buf->pvApplicationReservedData = NULL;
+    if (name_len)
+    {
+        buf->pwszSessionName = (WCHAR *)p;
+        memcpy(p, s->appdesc.pwszSessionName, name_len);
+        p += name_len;
+    }
+    if (pass_len)
+    {
+        buf->pwszPassword = (WCHAR *)p;
+        memcpy(p, s->appdesc.pwszPassword, pass_len);
+        p += pass_len;
+    }
+    if (s->appdesc.dwReservedDataSize)
+    {
+        buf->pvReservedData = p;
+        memcpy(p, s->appdesc.pvReservedData, s->appdesc.dwReservedDataSize);
+        p += s->appdesc.dwReservedDataSize;
+    }
+    if (s->appdesc.dwApplicationReservedDataSize)
+    {
+        buf->pvApplicationReservedData = p;
+        memcpy(p, s->appdesc.pvApplicationReservedData, s->appdesc.dwApplicationReservedDataSize);
+    }
+    *size = need;
+    LeaveCriticalSection(&s->cs);
+    return DPN_OK;
+}
+
+HRESULT dp8s_set_appdesc(struct dp8_session *s, const DPN_APPLICATION_DESC *desc, DWORD flags)
+{
+    DPN_APPLICATION_DESC copy;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags) return DPNERR_INVALIDFLAGS;
+    if (!desc) return DPNERR_INVALIDPARAM;
+    if (FAILED(hr = appdesc_validate(desc))) return hr;
+
+    EnterCriticalSection(&s->cs);
+    if (!in_session(s)) hr = DPNERR_NOCONNECTION;
+    else if (s->state != DP8_HOSTING) hr = DPNERR_NOTHOST;
+    else
+    {
+        memset(&copy, 0, sizeof(copy));
+        if (SUCCEEDED(hr = appdesc_copy(&copy, desc)))
+        {
+            /* Only these members of the description can change once hosting. */
+            free(s->appdesc.pwszSessionName);
+            free(s->appdesc.pwszPassword);
+            free(s->appdesc.pvApplicationReservedData);
+#ifndef SG_MUTANT_APPDESC
+            s->appdesc.dwMaxPlayers = copy.dwMaxPlayers;
+#endif
+            s->appdesc.pwszSessionName = copy.pwszSessionName;
+            s->appdesc.pwszPassword = copy.pwszPassword;
+            s->appdesc.pvApplicationReservedData = copy.pvApplicationReservedData;
+            s->appdesc.dwApplicationReservedDataSize = copy.dwApplicationReservedDataSize;
+            free(copy.pvReservedData);
+        }
+    }
+    LeaveCriticalSection(&s->cs);
+    return hr;
+}
+
+/* ------------------------------------------------------- player and group info */
+
+/* Replaces the name and/or data selected by info->dwInfoFlags. */
+static HRESULT update_name_data(const DPN_PLAYER_INFO *info, WCHAR **name, void **data, DWORD *datasize)
+{
+    WCHAR *new_name = NULL;
+    void *new_data = NULL;
+
+    if ((info->dwInfoFlags & DPNINFO_DATA) && info->dwDataSize && !info->pvData)
+        return DPNERR_INVALIDPOINTER;
+
+    if ((info->dwInfoFlags & DPNINFO_NAME) && info->pwszName && !(new_name = wcsdup(info->pwszName)))
+        return E_OUTOFMEMORY;
+    if ((info->dwInfoFlags & DPNINFO_DATA) && info->dwDataSize)
+    {
+        if (!(new_data = malloc(info->dwDataSize)))
+        {
+            free(new_name);
+            return E_OUTOFMEMORY;
+        }
+        memcpy(new_data, info->pvData, info->dwDataSize);
+    }
+
+    if (info->dwInfoFlags & DPNINFO_NAME)
+    {
+        free(*name);
+        *name = new_name;
+    }
+    if (info->dwInfoFlags & DPNINFO_DATA)
+    {
+        free(*data);
+        *data = new_data;
+        *datasize = info->dwDataSize;
+    }
+    return DPN_OK;
+}
+
+static HRESULT fill_info(DPN_PLAYER_INFO *info, DWORD *psize, const WCHAR *name, const void *data,
+        DWORD datasize, DWORD extra_flags)
+{
+    DWORD need, name_len = name ? (wcslen(name) + 1) * sizeof(WCHAR) : 0;
+    BYTE *p;
+
+    need = sizeof(*info) + name_len + datasize;
+    if (!info || *psize < need)
+    {
+        *psize = need;
+        return DPNERR_BUFFERTOOSMALL;
+    }
+    if (info->dwSize != sizeof(*info)) return DPNERR_INVALIDPARAM;
+
+    memset(info, 0, sizeof(*info));
+    info->dwSize = sizeof(*info);
+    info->dwPlayerFlags = extra_flags;
+    p = (BYTE *)(info + 1);
+#ifdef SG_MUTANT_INFO
+    name = NULL;
+#endif
+    if (name)
+    {
+        info->dwInfoFlags |= DPNINFO_NAME;
+        info->pwszName = (WCHAR *)p;
+        memcpy(p, name, name_len);
+        p += name_len;
+    }
+    if (datasize)
+    {
+        info->dwInfoFlags |= DPNINFO_DATA;
+        info->pvData = p;
+        info->dwDataSize = datasize;
+        memcpy(p, data, datasize);
+    }
+    *psize = need;
+    return DPN_OK;
+}
+
+HRESULT dp8s_set_info(struct dp8_session *s, const DPN_PLAYER_INFO *info, void *async_context,
+        DPNHANDLE *phandle, DWORD flags)
+{
+    HRESULT hr;
+
+    if (!info) return DPNERR_INVALIDPOINTER;
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags & ~DPNOP_SYNC) return DPNERR_INVALIDFLAGS;
+    if (info->dwSize != sizeof(*info)) return DPNERR_INVALIDPARAM;
+    if ((flags & DPNOP_SYNC) && phandle) return DPNERR_INVALIDPARAM;
+
+    EnterCriticalSection(&s->cs);
+    hr = update_name_data(info, &s->info_name, &s->info_data, &s->info_datasize);
+    LeaveCriticalSection(&s->cs);
+    if (FAILED(hr)) return hr;
+
+    return finish_op(s, flags, async_context, phandle, DP8_OP_LOCAL, DPN_OK, 0);
+}
+
+HRESULT dp8s_get_player_info(struct dp8_session *s, DPNID id, DPN_PLAYER_INFO *info, DWORD *size,
+        DWORD flags, BOOL server_of_client)
+{
+    struct dp8_player *p;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!size) return DPNERR_INVALIDPOINTER;
+    if (flags) return DPNERR_INVALIDFLAGS;
+
+    EnterCriticalSection(&s->cs);
+    if (server_of_client)
+    {
+        /* Client::GetServerInfo: the host player of the connected session. */
+        if (!in_session(s)) hr = DPNERR_NOCONNECTION;
+        else if (!(p = find_player(s, s->local_id)) || !(p->flags & DPNPLAYER_HOST)) hr = DPNERR_NOCONNECTION;
+        else hr = fill_info(info, size, s->info_name, s->info_data, s->info_datasize, p->flags);
+    }
+    else if (!(p = find_player(s, id)) || p->hidden) hr = DPNERR_INVALIDPLAYER;
+    else if (p->flags & DPNPLAYER_LOCAL)
+        hr = fill_info(info, size, s->info_name, s->info_data, s->info_datasize, p->flags);
+    else
+        hr = fill_info(info, size, NULL, NULL, 0, p->flags);
+    LeaveCriticalSection(&s->cs);
+    return hr;
+}
+
+/* ------------------------------------------------------------ addresses */
+
+HRESULT dp8s_get_address(struct dp8_session *s, DPNID id, IDirectPlay8Address **addr, DWORD flags,
+        BOOL server_of_client)
+{
+    struct dp8_player *p;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!addr) return DPNERR_INVALIDPOINTER;
+    if (flags) return DPNERR_INVALIDFLAGS;
+    *addr = NULL;
+
+    EnterCriticalSection(&s->cs);
+    if (server_of_client)
+        hr = DPNERR_NOCONNECTION;
+    else if (!(p = find_player(s, id)) || p->hidden)
+        hr = DPNERR_INVALIDPLAYER;
+    else if ((p->flags & DPNPLAYER_LOCAL) && s->num_devices)
+        hr = IDirectPlay8Address_Duplicate(s->devices[0], addr);
+    else
+        hr = DPNERR_INVALIDPLAYER;
+    LeaveCriticalSection(&s->cs);
+    return hr;
+}
+
+HRESULT dp8s_get_local_addresses(struct dp8_session *s, IDirectPlay8Address **addrs, DWORD *count,
+        DWORD flags)
+{
+    DWORD i;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!count) return DPNERR_INVALIDPOINTER;
+    if (flags & ~DPNGETLOCALHOSTADDRESSES_COMBINED) return DPNERR_INVALIDFLAGS;
+
+    EnterCriticalSection(&s->cs);
+    if (!s->num_devices) hr = DPNERR_NOCONNECTION;
+    else if (!addrs || *count < s->num_devices)
+    {
+        *count = s->num_devices;
+        hr = DPNERR_BUFFERTOOSMALL;
+    }
+    else
+    {
+        for (i = 0; i < s->num_devices; i++)
+        {
+            if (FAILED(hr = IDirectPlay8Address_Duplicate(s->devices[i], &addrs[i])))
+            {
+                while (i--) IDirectPlay8Address_Release(addrs[i]);
+                break;
+            }
+        }
+        if (SUCCEEDED(hr)) *count = s->num_devices;
+    }
+    LeaveCriticalSection(&s->cs);
+    return hr;
+}
+
+/* --------------------------------------------------------------- groups */
+
+HRESULT dp8s_create_group(struct dp8_session *s, const DPN_GROUP_INFO *info, void *group_context,
+        void *async_context, DPNHANDLE *phandle, DWORD flags)
+{
+    DPNMSG_CREATE_GROUP msg;
+    struct dp8_group *g;
+    struct dp8_player *owner;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!info) return DPNERR_INVALIDPOINTER;
+    if (flags & ~DPNOP_SYNC) return DPNERR_INVALIDFLAGS;
+    if (info->dwSize != sizeof(*info) || ((flags & DPNOP_SYNC) && phandle)) return DPNERR_INVALIDPARAM;
+    if (info->dwGroupFlags & ~DPNGROUP_AUTODESTRUCT) return DPNERR_INVALIDFLAGS;
+
+    if (!(g = calloc(1, sizeof(*g)))) return E_OUTOFMEMORY;
+    if (FAILED(hr = update_name_data((const DPN_PLAYER_INFO *)info, &g->name, &g->data, &g->datasize)))
+    {
+        free(g);
+        return hr;
+    }
+
+    EnterCriticalSection(&s->cs);
+    if (!in_session(s))
+    {
+        LeaveCriticalSection(&s->cs);
+        group_free(g);
+        return DPNERR_NOCONNECTION;
+    }
+    g->id = alloc_dpnid();
+    g->context = group_context;
+    g->flags = info->dwGroupFlags;
+    list_add_tail(&s->groups, &g->entry);
+    owner = find_player(s, s->local_id);
+
+    msg.dwSize = sizeof(msg);
+    msg.dpnidGroup = g->id;
+    msg.dpnidOwner = owner && !owner->hidden ? owner->id : 0;
+    msg.pvGroupContext = group_context;
+    msg.pvOwnerContext = owner ? owner->context : NULL;
+    LeaveCriticalSection(&s->cs);
+
+    send_msg(s, DPN_MSGID_CREATE_GROUP, &msg);
+    return finish_op(s, flags, async_context, phandle, DP8_OP_LOCAL, DPN_OK, 0);
+}
+
+HRESULT dp8s_destroy_group(struct dp8_session *s, DPNID id, void *async_context, DPNHANDLE *phandle,
+        DWORD flags)
+{
+    DPNMSG_DESTROY_GROUP msg;
+    struct dp8_group *g;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags & ~DPNOP_SYNC) return DPNERR_INVALIDFLAGS;
+    if ((flags & DPNOP_SYNC) && phandle) return DPNERR_INVALIDPARAM;
+
+    EnterCriticalSection(&s->cs);
+    if (!id || !(g = find_group(s, id)))
+    {
+        LeaveCriticalSection(&s->cs);
+        return DPNERR_INVALIDGROUP;
+    }
+    list_remove(&g->entry);
+    msg.dwSize = sizeof(msg);
+    msg.dpnidGroup = g->id;
+    msg.pvGroupContext = g->context;
+    msg.dwReason = DPNDESTROYGROUPREASON_NORMAL;
+    LeaveCriticalSection(&s->cs);
+
+    send_msg(s, DPN_MSGID_DESTROY_GROUP, &msg);
+    group_free(g);
+    return finish_op(s, flags, async_context, phandle, DP8_OP_LOCAL, DPN_OK, 0);
+}
+
+HRESULT dp8s_group_member(struct dp8_session *s, DPNID group, DPNID player, BOOL add,
+        void *async_context, DPNHANDLE *phandle, DWORD flags)
+{
+    DPNMSG_ADD_PLAYER_TO_GROUP add_msg;
+    DPNMSG_REMOVE_PLAYER_FROM_GROUP rem_msg;
+    struct dp8_group *g;
+    struct dp8_player *p;
+    HRESULT hr;
+    DWORD i;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags & ~DPNOP_SYNC) return DPNERR_INVALIDFLAGS;
+    if ((flags & DPNOP_SYNC) && phandle) return DPNERR_INVALIDPARAM;
+
+    EnterCriticalSection(&s->cs);
+    if (!group || !(g = find_group(s, group))) hr = DPNERR_INVALIDGROUP;
+    else if (!(p = find_player(s, player)) || p->hidden) hr = DPNERR_INVALIDPLAYER;
+#ifndef SG_MUTANT_GROUPS
+    else if (add && group_has(g, player)) hr = DPNERR_PLAYERALREADYINGROUP;
+#endif
+    else if (!add && !group_has(g, player)) hr = DPNERR_PLAYERNOTINGROUP;
+    else if (add)
+    {
+        if (g->count == g->size)
+        {
+            DPNID *n = realloc(g->members, (g->size ? g->size * 2 : 4) * sizeof(*n));
+            if (!n) hr = E_OUTOFMEMORY;
+            else
+            {
+                g->members = n;
+                g->size = g->size ? g->size * 2 : 4;
+            }
+        }
+        if (hr == DPN_OK)
+        {
+            g->members[g->count++] = player;
+            add_msg.dwSize = sizeof(add_msg);
+            add_msg.dpnidGroup = group;
+            add_msg.pvGroupContext = g->context;
+            add_msg.dpnidPlayer = player;
+            add_msg.pvPlayerContext = p->context;
+        }
+    }
+    else
+    {
+        for (i = 0; g->members[i] != player; i++) ;
+        memmove(&g->members[i], &g->members[i + 1], (g->count - i - 1) * sizeof(*g->members));
+        g->count--;
+        rem_msg.dwSize = sizeof(rem_msg);
+        rem_msg.dpnidGroup = group;
+        rem_msg.pvGroupContext = g->context;
+        rem_msg.dpnidPlayer = player;
+        rem_msg.pvPlayerContext = p->context;
+    }
+    LeaveCriticalSection(&s->cs);
+    if (hr != DPN_OK) return hr;
+
+    if (add) send_msg(s, DPN_MSGID_ADD_PLAYER_TO_GROUP, &add_msg);
+    else send_msg(s, DPN_MSGID_REMOVE_PLAYER_FROM_GROUP, &rem_msg);
+    return finish_op(s, flags, async_context, phandle, DP8_OP_LOCAL, DPN_OK, 0);
+}
+
+HRESULT dp8s_set_group_info(struct dp8_session *s, DPNID id, const DPN_GROUP_INFO *info,
+        void *async_context, DPNHANDLE *phandle, DWORD flags)
+{
+    DPNMSG_GROUP_INFO msg;
+    struct dp8_group *g;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!info) return DPNERR_INVALIDPOINTER;
+    if (flags & ~DPNOP_SYNC) return DPNERR_INVALIDFLAGS;
+    if (info->dwSize != sizeof(*info) || ((flags & DPNOP_SYNC) && phandle)) return DPNERR_INVALIDPARAM;
+
+    EnterCriticalSection(&s->cs);
+    if (!id || !(g = find_group(s, id))) hr = DPNERR_INVALIDGROUP;
+    else if (SUCCEEDED(hr = update_name_data((const DPN_PLAYER_INFO *)info, &g->name, &g->data, &g->datasize)))
+    {
+        msg.dwSize = sizeof(msg);
+        msg.dpnidGroup = g->id;
+        msg.pvGroupContext = g->context;
+    }
+    LeaveCriticalSection(&s->cs);
+    if (FAILED(hr)) return hr;
+
+    send_msg(s, DPN_MSGID_GROUP_INFO, &msg);
+    return finish_op(s, flags, async_context, phandle, DP8_OP_LOCAL, DPN_OK, 0);
+}
+
+HRESULT dp8s_get_group_info(struct dp8_session *s, DPNID id, DPN_GROUP_INFO *info, DWORD *size,
+        DWORD flags)
+{
+    struct dp8_group *g;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!size) return DPNERR_INVALIDPOINTER;
+    if (flags) return DPNERR_INVALIDFLAGS;
+
+    EnterCriticalSection(&s->cs);
+    if (!id || !(g = find_group(s, id))) hr = DPNERR_INVALIDGROUP;
+    else hr = fill_info((DPN_PLAYER_INFO *)info, size, g->name, g->data, g->datasize, g->flags);
+    LeaveCriticalSection(&s->cs);
+    return hr;
+}
+
+HRESULT dp8s_enum_players_and_groups(struct dp8_session *s, DPNID *ids, DWORD *count, DWORD flags)
+{
+    struct dp8_player *p;
+    struct dp8_group *g;
+    DWORD n = 0;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!count) return DPNERR_INVALIDPOINTER;
+    if (!flags || (flags & ~(DPNENUM_PLAYERS | DPNENUM_GROUPS))) return DPNERR_INVALIDFLAGS;
+
+    EnterCriticalSection(&s->cs);
+    if (!in_session(s))
+    {
+        LeaveCriticalSection(&s->cs);
+        return DPNERR_NOCONNECTION;
+    }
+    if (flags & DPNENUM_PLAYERS) n += count_clients(s);
+    if (flags & DPNENUM_GROUPS) n += list_count(&s->groups);
+
+    if (*count < n || (n && !ids))
+    {
+        *count = n;
+        LeaveCriticalSection(&s->cs);
+        return DPNERR_BUFFERTOOSMALL;
+    }
+
+    n = 0;
+    if (flags & DPNENUM_PLAYERS)
+        LIST_FOR_EACH_ENTRY(p, &s->players, struct dp8_player, entry)
+            if (!p->hidden) ids[n++] = p->id;
+    if (flags & DPNENUM_GROUPS)
+        LIST_FOR_EACH_ENTRY(g, &s->groups, struct dp8_group, entry)
+            ids[n++] = g->id;
+    *count = n;
+    LeaveCriticalSection(&s->cs);
+    return DPN_OK;
+}
+
+HRESULT dp8s_enum_group_members(struct dp8_session *s, DPNID group, DPNID *ids, DWORD *count,
+        DWORD flags)
+{
+    struct dp8_player *p;
+    struct dp8_group *g = NULL;
+    DWORD n;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!count) return DPNERR_INVALIDPOINTER;
+    if (flags) return DPNERR_INVALIDFLAGS;
+
+    EnterCriticalSection(&s->cs);
+    if (group && !(g = find_group(s, group)))
+    {
+        LeaveCriticalSection(&s->cs);
+        return DPNERR_INVALIDGROUP;
+    }
+    if (!group && !in_session(s))
+    {
+        LeaveCriticalSection(&s->cs);
+        return DPNERR_NOCONNECTION;
+    }
+
+    n = g ? g->count : count_clients(s);
+    if (*count < n || (n && !ids))
+    {
+        *count = n;
+        LeaveCriticalSection(&s->cs);
+        return DPNERR_BUFFERTOOSMALL;
+    }
+
+    if (g) memcpy(ids, g->members, n * sizeof(*ids));
+    else
+    {
+        n = 0;
+        LIST_FOR_EACH_ENTRY(p, &s->players, struct dp8_player, entry)
+            if (!p->hidden) ids[n++] = p->id;
+    }
+    *count = n;
+    LeaveCriticalSection(&s->cs);
+    return DPN_OK;
+}
+
+/* ---------------------------------------------------------- players etc */
+
+HRESULT dp8s_destroy_player(struct dp8_session *s, DPNID id, const void *data, DWORD data_size,
+        DWORD flags)
+{
+    struct dp8_player *p;
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags) return DPNERR_INVALIDFLAGS;
+    if (data_size && !data) return DPNERR_INVALIDPOINTER;
+
+    EnterCriticalSection(&s->cs);
+    if (!in_session(s)) hr = DPNERR_NOCONNECTION;
+    else if (s->state != DP8_HOSTING) hr = DPNERR_NOTHOST;
+    else if (!(p = find_player(s, id)) || p->hidden || (p->flags & DPNPLAYER_LOCAL)) hr = DPNERR_INVALIDPLAYER;
+    LeaveCriticalSection(&s->cs);
+    return hr;
+}
+
+HRESULT dp8s_terminate_session(struct dp8_session *s, const void *data, DWORD data_size, DWORD flags)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags) return DPNERR_INVALIDFLAGS;
+    if (data_size && !data) return DPNERR_INVALIDPOINTER;
+
+    EnterCriticalSection(&s->cs);
+    if (!in_session(s)) hr = DPNERR_NOCONNECTION;
+    else if (s->state != DP8_HOSTING) hr = DPNERR_NOTHOST;
+    LeaveCriticalSection(&s->cs);
+    return hr;
+}
+
+HRESULT dp8s_return_buffer(struct dp8_session *s, DPNHANDLE handle, DWORD flags)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags) return DPNERR_INVALIDFLAGS;
+    /* Buffers are only handed out with DPN_MSGID_RECEIVE messages that
+     * carry a buffer handle; this implementation never does. */
+    return DPNERR_INVALIDHANDLE;
+}
+
+HRESULT dp8s_get_context(struct dp8_session *s, DPNID id, void **context, DWORD flags, BOOL group)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!context) return DPNERR_INVALIDPOINTER;
+    if (flags) return DPNERR_INVALIDFLAGS;
+
+    EnterCriticalSection(&s->cs);
+    if (group)
+    {
+        struct dp8_group *g = id ? find_group(s, id) : NULL;
+
+        if (g) *context = g->context;
+        else hr = DPNERR_INVALIDGROUP;
+    }
+    else
+    {
+        struct dp8_player *p = find_player(s, id);
+
+        if (p && !p->hidden) *context = p->context;
+        else hr = DPNERR_INVALIDPLAYER;
+    }
+    LeaveCriticalSection(&s->cs);
+    return hr;
+}
+
+HRESULT dp8s_get_connection_info(struct dp8_session *s, DPNID id, DPN_CONNECTION_INFO *info,
+        DWORD flags, BOOL server_of_client)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!info) return DPNERR_INVALIDPOINTER;
+    if (flags) return DPNERR_INVALIDFLAGS;
+    if (info->dwSize != sizeof(*info)) return DPNERR_INVALIDPARAM;
+
+    EnterCriticalSection(&s->cs);
+    if (server_of_client) hr = DPNERR_NOCONNECTION;
+    else
+    {
+        /* Connection statistics exist for remote players only. */
+        struct dp8_player *p = find_player(s, id);
+
+        if (!p || p->hidden || (p->flags & DPNPLAYER_LOCAL)) hr = DPNERR_INVALIDPLAYER;
+    }
+    LeaveCriticalSection(&s->cs);
+    return hr;
+}
+
+/* ----------------------------------------------------------------- caps */
+
+HRESULT dp8s_get_caps(struct dp8_session *s, DPN_CAPS *caps, DWORD flags)
+{
+    HRESULT hr;
+    DWORD size;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!caps) return DPNERR_INVALIDPOINTER;
+    if (flags) return DPNERR_INVALIDFLAGS;
+    if (caps->dwSize != sizeof(DPN_CAPS) && caps->dwSize != sizeof(DPN_CAPS_EX)) return DPNERR_INVALIDPARAM;
+
+    size = caps->dwSize;
+    EnterCriticalSection(&s->cs);
+    memcpy(caps, &s->caps, size);
+    LeaveCriticalSection(&s->cs);
+    caps->dwSize = size;
+    return DPN_OK;
+}
+
+HRESULT dp8s_set_caps(struct dp8_session *s, const DPN_CAPS *caps, DWORD flags)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (!caps) return DPNERR_INVALIDPOINTER;
+    if (flags) return DPNERR_INVALIDFLAGS;
+    if (caps->dwSize != sizeof(DPN_CAPS) && caps->dwSize != sizeof(DPN_CAPS_EX)) return DPNERR_INVALIDPARAM;
+    if (caps->dwFlags) return DPNERR_INVALIDPARAM;
+
+    EnterCriticalSection(&s->cs);
+    s->caps.dwConnectTimeout = caps->dwConnectTimeout;
+#ifndef SG_MUTANT_CAPS
+    s->caps.dwConnectRetries = caps->dwConnectRetries;
+#endif
+    s->caps.dwTimeoutUntilKeepAlive = caps->dwTimeoutUntilKeepAlive;
+    if (caps->dwSize == sizeof(DPN_CAPS_EX))
+    {
+        const DPN_CAPS_EX *ex = (const DPN_CAPS_EX *)caps;
+
+        s->caps.dwMaxRecvMsgSize = ex->dwMaxRecvMsgSize;
+        s->caps.dwNumSendRetries = ex->dwNumSendRetries;
+        s->caps.dwMaxSendRetryInterval = ex->dwMaxSendRetryInterval;
+        s->caps.dwDropThresholdRate = ex->dwDropThresholdRate;
+        s->caps.dwThrottleRate = ex->dwThrottleRate;
+        s->caps.dwNumHardDisconnectSends = ex->dwNumHardDisconnectSends;
+        s->caps.dwMaxHardDisconnectPeriod = ex->dwMaxHardDisconnectPeriod;
+    }
+    LeaveCriticalSection(&s->cs);
+    return DPN_OK;
+}
+
+HRESULT dp8s_set_sp_caps(struct dp8_session *s, const DPN_SP_CAPS *caps)
+{
+    if (!s->msghandler || !caps || caps->dwSize != sizeof(DPN_SP_CAPS))
+        return DPNERR_INVALIDPARAM;
+
+    /* Only dwSystemBufferSize is set by this call. */
+    s->spcaps.dwSystemBufferSize = caps->dwSystemBufferSize;
+    return DPN_OK;
+}
+
+HRESULT dp8s_get_sp_caps(struct dp8_session *s, DPN_SP_CAPS *caps)
+{
+    if (!s->msghandler) return DPNERR_UNINITIALIZED;
+    if (!caps) return DPNERR_INVALIDPOINTER;
+    if (caps->dwSize != sizeof(DPN_SP_CAPS)) return DPNERR_INVALIDPARAM;
+
+    *caps = s->spcaps;
+    return DPN_OK;
+}
+
+HRESULT dp8s_register_lobby(struct dp8_session *s, DPNHANDLE handle, IUnknown *lobbied, DWORD flags)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = check_init(s))) return hr;
+    if (flags != DPNLOBBY_REGISTER && flags != DPNLOBBY_UNREGISTER) return DPNERR_INVALIDFLAGS;
+
+    EnterCriticalSection(&s->cs);
+    if (flags == DPNLOBBY_UNREGISTER)
+    {
+        if (!s->lobby_registered) hr = DPNERR_NOTREGISTERED;
+        else s->lobby_registered = FALSE;
+    }
+    else if (!lobbied) hr = DPNERR_INVALIDPARAM;
+    else if (s->lobby_registered) hr = DPNERR_ALREADYREGISTERED;
+    else hr = DPNERR_INVALIDHANDLE; /* no lobby connection exists to register against */
+    (void)handle;
+    LeaveCriticalSection(&s->cs);
+    return hr;
+}
