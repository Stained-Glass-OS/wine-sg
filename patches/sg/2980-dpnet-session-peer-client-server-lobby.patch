+    size_t offset;
+} program_values[] =
+{
+    { L"CommandLine",         offsetof(DPL_PROGRAM_DESC, pwszCommandLine) },
+    { L"CurrentDirectory",    offsetof(DPL_PROGRAM_DESC, pwszCurrentDirectory) },
+    { L"Description",         offsetof(DPL_PROGRAM_DESC, pwszDescription) },
