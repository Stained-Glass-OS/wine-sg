+    { L"LauncherPath",        offsetof(DPL_PROGRAM_DESC, pwszLauncherPath) },
+};
+
+static BOOL read_program_guid(HKEY key, GUID *guid)
+{
+    WCHAR buf[64];
+    DWORD size = sizeof(buf), type;
+
+    if (RegQueryValueExW(key, L"Guid", NULL, &type, (BYTE *)buf, &size) || type != REG_SZ) return FALSE;
+    buf[ARRAY_SIZE(buf) - 1] = 0;
+    return SUCCEEDED(CLSIDFromString(buf, guid));
+}
+
+/* Lists the registered lobbyable programs (optionally only one GUID) as an
+ * array of DPL_APPLICATION_INFO followed by the names. */
+HRESULT dpl_enum_programs(const GUID *filter, BYTE *buffer, DWORD *size, DWORD *items)
+{
+    DWORD index, count = 0, need = 0, name_len;
+    DPL_APPLICATION_INFO *info = (DPL_APPLICATION_INFO *)buffer;
+    WCHAR *names = NULL;
+    WCHAR name[256];
+    HKEY root, key;
+    LONG res;
+    GUID guid;
+    int pass;
+
+    for (pass = 0; pass < 2; pass++)
+    {
+        if (pass && (!buffer || *size < need)) break;
+        if (pass) names = (WCHAR *)(info + count);
+        count = 0;
+
+        if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, apps_key, 0, KEY_READ, &root))
+            break;
+
+        for (index = 0; !(res = RegEnumKeyW(root, index, name, ARRAY_SIZE(name))); index++)
+        {
+            if (RegOpenKeyExW(root, name, 0, KEY_READ, &key)) continue;
+            if (read_program_guid(key, &guid) && (!filter || IsEqualGUID(filter, &guid)))
+            {
+                name_len = (wcslen(name) + 1) * sizeof(WCHAR);
+                if (!pass)
+                    need += sizeof(DPL_APPLICATION_INFO) + name_len;
+                else
+                {
+                    memset(&info[count], 0, sizeof(info[count]));
+                    info[count].guidApplication = guid;
+                    info[count].pwszApplicationName = names;
+                    memcpy(names, name, name_len);
+                    names += name_len / sizeof(WCHAR);
+                }
+                count++;
+            }
+            RegCloseKey(key);
+        }
+        RegCloseKey(root);
+        if (!pass) *items = count;
+    }
+
+    if (need && (!buffer || *size < need))
+    {
+        *size = need;
+        return DPNERR_BUFFERTOOSMALL;
+    }
+    *size = need;
+    *items = count;
+    return DPN_OK;
+}
+
+BOOL dpl_program_registered(const GUID *guid)
+{
+    DWORD size = 0, items = 0;
+
+    return dpl_enum_programs(guid, NULL, &size, &items) == DPNERR_BUFFERTOOSMALL && items;
+}
