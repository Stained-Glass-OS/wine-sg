From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] oleaut32: Pass all types through IPropertyBag::Read; implement QuickActivate wrappers.

IPropertyBag::Read's call_as proxy passes every requested type - VT_EMPTY
(the bag's own type), scalars, BSTR, arrays - with the object only for
VT_UNKNOWN/VT_DISPATCH, and the stub hands the object a clean VARIANT of
that type; it returned E_NOTIMPL for anything but objects ("E_NOTIMPL is
not a valid return code"). Byref and vector types keep their FIXME.
IQuickActivate::QuickActivate's call_as proxy and stub forward (the stub
gives the control a QACONTROL with cbSize set: it is [out] on the wire).

Gate: test/oleaut32-propbag-qa-gate.sh (64/32).
---
 dlls/oleaut32/usrmarshal.c | 37 +++++++++++++++++++++++--------------
 1 file changed, 23 insertions(+), 14 deletions(-)

diff --git a/dlls/oleaut32/usrmarshal.c b/dlls/oleaut32/usrmarshal.c
index 96883db..744c5e0 100644
--- a/dlls/oleaut32/usrmarshal.c
+++ b/dlls/oleaut32/usrmarshal.c
@@ -2396,12 +2396,15 @@ HRESULT CALLBACK IPropertyBag_Read_Proxy(
   if(!pVar)
     return E_POINTER;
 
-  if(V_VT(pVar) & (VT_BYREF | VT_ARRAY | VT_VECTOR))
+  if(V_VT(pVar) & (VT_BYREF | VT_VECTOR))
   {
-    FIXME("Variant type %x is byref, array or vector. Not implemented.\n", V_VT(pVar));
+    FIXME("Variant type %x is byref or vector. Not implemented.\n", V_VT(pVar));
     return E_NOTIMPL;
   }
 
+  /* the type the caller asks for travels as varType; an object to read
+   * into travels as pUnkObj; any other type (VT_EMPTY: the bag's own) has
+   * no value to send */
   switch(V_VT(pVar))
   {
     case VT_DISPATCH:
@@ -2410,12 +2413,11 @@ HRESULT CALLBACK IPropertyBag_Read_Proxy(
     case VT_UNKNOWN:
       pUnk = V_UNKNOWN(pVar);
       break;
-    case VT_SAFEARRAY:
-      FIXME("Safearray support not yet implemented.\n");
-      return E_NOTIMPL;
     default:
-      FIXME("Unknown V_VT %d - support not yet implemented.\n", V_VT(pVar));
+#ifdef SG_MUTANT_PROPBAG_SCALARS_NOTIMPL
       return E_NOTIMPL;
+#endif
+      break;
   }
 
   return IPropertyBag_RemoteRead_Proxy(This, pszPropName, pVar, pErrorLog,
@@ -2436,12 +2438,14 @@ HRESULT __RPC_STUB IPropertyBag_Read_Stub(
   TRACE("%p, %s, %p, %p, %lx, %p.\n", This, debugstr_w(pszPropName), pVar,
                                      pErrorLog, varType, pUnkObj);
 
-  if(varType & (VT_BYREF | VT_ARRAY | VT_VECTOR))
+  if(varType & (VT_BYREF | VT_VECTOR))
   {
-    FIXME("Variant type %x is byref, array or vector. Not implemented.\n", V_VT(pVar));
+    FIXME("Variant type %lx is byref or vector. Not implemented.\n", varType);
     return E_NOTIMPL;
   }
 
+  /* an [out] VARIANT: give the object a clean one of the asked type */
+  V_I8(pVar) = 0;
   V_VT(pVar) = varType;
   switch(varType)
   {
@@ -2458,9 +2462,6 @@ HRESULT __RPC_STUB IPropertyBag_Read_Stub(
     case VT_BSTR:
       V_BSTR(pVar) = SysAllocString(L"");
       break;
-    case VT_SAFEARRAY:
-      FIXME("Safearray support not yet implemented.\n");
-      return E_NOTIMPL;
     default:
       break;
   }
@@ -2674,8 +2675,12 @@ HRESULT CALLBACK IQuickActivate_QuickActivate_Proxy(
     QACONTAINER *pQaContainer,
     QACONTROL *pQaControl)
 {
-    FIXME("not implemented\n");
+    TRACE("%p, %p, %p.\n", This, pQaContainer, pQaControl);
+#ifndef SG_MUTANT_QUICKACTIVATE_NOTIMPL
+    return IQuickActivate_RemoteQuickActivate_Proxy(This, pQaContainer, pQaControl);
+#else
     return E_NOTIMPL;
+#endif
 }
 
 HRESULT __RPC_STUB IQuickActivate_QuickActivate_Stub(
@@ -2683,6 +2688,10 @@ HRESULT __RPC_STUB IQuickActivate_QuickActivate_Stub(
     QACONTAINER *pQaContainer,
     QACONTROL *pQaControl)
 {
-    FIXME("not implemented\n");
-    return E_NOTIMPL;
+    TRACE("%p, %p, %p.\n", This, pQaContainer, pQaControl);
+
+    /* [in, out] locally, [out] on the wire: the control reads cbSize */
+    memset(pQaControl, 0, sizeof(*pQaControl));
+    pQaControl->cbSize = sizeof(*pQaControl);
+    return IQuickActivate_QuickActivate(This, pQaContainer, pQaControl);
 }
