From: Stained Glass OS contributors
Subject: comctl32: a task dialog is made of version 6 controls

TaskDialogIndirect exists only in comctl32 6, whose code is isolation aware:
its dialogs are built from version 6 controls whatever the caller's
activation context. Wine built the dialog in the caller's context, so a
program without a common controls manifest -- a .NET program calling
TaskDialogIndirect outside EnableVisualStyles' context, as KeePass 2 does
for its first-run question and its "Emergency Sheet" prompt -- got user32's
buttons: they cannot be command links and do not answer BCM_GETIDEALSIZE,
so each choice was laid out 4 pixels high and could not be clicked.

TaskDialogIndirect now activates comctl32's own manifest context (unless
the caller's already redirects the controls) around the dialog.

Gate: test/taskdialog-gate.sh (a manifest-less probe; 2 of its 3 checks
fail without this patch).
---
--- a/dlls/comctl32/taskdialog.c
+++ b/dlls/comctl32/taskdialog.c
@@ -1366,6 +1366,26 @@
     return TRUE;
 }
 
+/* comctl32's own (version 6) activation context, activated unless the
+ * caller's already redirects the common controls to version 6 */
+static HANDLE taskdialog_activate_v6(ULONG_PTR *cookie)
+{
+    ACTCTX_SECTION_KEYED_DATA data = { sizeof(data) };
+    ACTCTXW ctx = { sizeof(ctx) };
+    HANDLE actctx;
+
+    *cookie = 0;
+    if (FindActCtxSectionStringW(0, NULL, ACTIVATION_CONTEXT_SECTION_WINDOW_CLASS_REDIRECTION, L"Button", &data))
+        return INVALID_HANDLE_VALUE;
+    ctx.dwFlags = ACTCTX_FLAG_HMODULE_VALID | ACTCTX_FLAG_RESOURCE_NAME_VALID;
+    ctx.hModule = COMCTL32_hModule;
+    ctx.lpResourceName = L"WINE_MANIFEST";
+    actctx = CreateActCtxW(&ctx);
+    if (actctx == INVALID_HANDLE_VALUE) return actctx;
+    if (!ActivateActCtx(actctx, cookie)) *cookie = 0;
+    return actctx;
+}
+
 /***********************************************************************
  * TaskDialogIndirect [COMCTL32.@]
  */
@@ -1374,6 +1394,8 @@
 {
     struct taskdialog_info dialog_info;
     DLGTEMPLATE *template;
+    HANDLE actctx;
+    ULONG_PTR cookie = 0;
     INT ret;
 
     TRACE("%p, %p, %p, %p\n", taskconfig, button, radio_button, verification_flag_checked);
@@ -1383,11 +1405,25 @@
 
     dialog_info.taskconfig = taskconfig;
 
+    /* A task dialog is made of version 6 controls (command links, themed
+     * buttons) whatever the caller's activation context: comctl32 6 is
+     * isolation aware. A program without a common controls manifest -- a .NET
+     * program calling TaskDialogIndirect outside EnableVisualStyles' context,
+     * KeePass -- otherwise got user32's buttons, which cannot be command links
+     * and have no ideal size: its choices were 4 pixels high. */
+    actctx = taskdialog_activate_v6(&cookie);
+
     template = create_taskdialog_template(taskconfig);
     ret = (short)DialogBoxIndirectParamW(taskconfig->hInstance, template, taskconfig->hwndParent,
             taskdialog_proc, (LPARAM)&dialog_info);
     Free(template);
 
+    if (actctx != INVALID_HANDLE_VALUE)
+    {
+        if (cookie) DeactivateActCtx(0, cookie);
+        ReleaseActCtx(actctx);
+    }
+
     if (button) *button = ret;
     if (radio_button) *radio_button = dialog_info.selected_radio_id;
     if (verification_flag_checked) *verification_flag_checked = dialog_info.verification_checked;
