+/* Vectors and elements of a property variant */
+
+static ULONG propvar_element_size(VARTYPE vt)
+{
+    switch (vt & ~VT_VECTOR)
+    {
+    case VT_I1: case VT_UI1: return 1;
+    case VT_I2: case VT_UI2: case VT_BOOL: return 2;
+    case VT_I4: case VT_UI4: case VT_R4: case VT_ERROR: return 4;
+    case VT_I8: case VT_UI8: case VT_R8: case VT_CY: case VT_DATE: case VT_FILETIME: return 8;
+    case VT_LPSTR: case VT_LPWSTR: case VT_BSTR: return sizeof(void *);
+    case VT_CLSID: return sizeof(GUID);
+    default: return 0;
+    }
+}
+
+/* The count of elements: a vector's, a one-dimensional array's, 0 for nothing, else 1 */
+ULONG WINAPI PropVariantGetElementCount(REFPROPVARIANT propvar)
+{
+    TRACE("%p\n", propvar);
+
+    if (propvar->vt == VT_EMPTY || propvar->vt == VT_NULL) return 0;
+    if (propvar->vt & VT_VECTOR) return propvar->caub.cElems;
+    if ((propvar->vt & VT_ARRAY) && propvar->parray && SafeArrayGetDim(propvar->parray) == 1)
+    {
+        LONG lower, upper;
+        if (SUCCEEDED(SafeArrayGetLBound(propvar->parray, 1, &lower)) && SUCCEEDED(SafeArrayGetUBound(propvar->parray, 1, &upper)))
+            return upper - lower + 1;
+    }
+#ifdef SG_MUTANT_PROPVEC_COUNT
+    return 0;
+#endif
+    return 1;
+}
+
+/* A shallow copy of one element: of a vector, or the value itself for index 0 */
+static HRESULT propvar_get_element(const PROPVARIANT *pv, ULONG index, PROPVARIANT *elem)
+{
+    ULONG size;
+
+    PropVariantInit(elem);
+    if (!(pv->vt & VT_VECTOR))
+    {
+        if (pv->vt == VT_EMPTY || pv->vt == VT_NULL || (pv->vt & VT_ARRAY) || index) return E_INVALIDARG;
+        *elem = *pv;
+        return S_OK;
+    }
+
+    if (index >= pv->caub.cElems || !(size = propvar_element_size(pv->vt))) return E_INVALIDARG;
+    elem->vt = pv->vt & ~VT_VECTOR;
+    memcpy(&elem->lVal, pv->caub.pElems + index * size, size);
+    return S_OK;
+}
+
+HRESULT WINAPI PropVariantGetBooleanElem(REFPROPVARIANT propvar, ULONG index, BOOL *ret)
+{
+    PROPVARIANT elem;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %p\n", propvar, index, ret);
+
+    if (!ret) return E_INVALIDARG;
+    if (FAILED(hr = propvar_get_element(propvar, index, &elem))) return hr;
+    return PropVariantToBoolean(&elem, ret);
+}
+
+HRESULT WINAPI PropVariantGetFileTimeElem(REFPROPVARIANT propvar, ULONG index, FILETIME *ret)
+{
+    PROPVARIANT elem;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %p\n", propvar, index, ret);
+
+    if (!ret) return E_INVALIDARG;
+    if (FAILED(hr = propvar_get_element(propvar, index, &elem))) return hr;
+    if (elem.vt != VT_FILETIME) return TYPE_E_TYPEMISMATCH;
+    *ret = elem.filetime;
+    return S_OK;
+}
+
+HRESULT WINAPI PropVariantGetStringElem(REFPROPVARIANT propvar, ULONG index, WCHAR **ret)
+{
+    PROPVARIANT elem;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %p\n", propvar, index, ret);
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    if (FAILED(hr = propvar_get_element(propvar, index, &elem))) return hr;
+    return PropVariantToStringAlloc(&elem, ret);
+}
+
+/* Convert each element of a vector (or the value itself) into an array of fixed size items */
+static HRESULT propvar_to_vector(const PROPVARIANT *pv, ULONG count_max, ULONG item_size, void *out, ULONG *count,
+        HRESULT (WINAPI *convert)(REFPROPVARIANT, void *))
+{
+    ULONG n, i;
+    HRESULT hr;
+
+    if (!count) return E_INVALIDARG;
+    *count = 0;
+    n = PropVariantGetElementCount(pv);
+#ifndef SG_MUTANT_PROPVEC_SMALL
+    if (n > count_max) return TYPE_E_BUFFERTOOSMALL;
+#endif
+    for (i = 0; i < n; i++)
+    {
+        PROPVARIANT elem;
+        if (FAILED(hr = propvar_get_element(pv, i, &elem))) return hr;
+        if (FAILED(hr = convert(&elem, (char *)out + i * item_size))) return hr;
+    }
+    *count = n;
+    return S_OK;
+}
+
+static HRESULT propvar_to_vector_alloc(const PROPVARIANT *pv, ULONG item_size, void **out, ULONG *count,
+        HRESULT (WINAPI *convert)(REFPROPVARIANT, void *))
+{
+    ULONG n;
+    HRESULT hr;
+
+    if (!out || !count) return E_INVALIDARG;
+    *out = NULL;
+    *count = 0;
+    n = PropVariantGetElementCount(pv);
+    if (!(*out = CoTaskMemAlloc(max(n, 1) * item_size))) return E_OUTOFMEMORY;
+    if (FAILED(hr = propvar_to_vector(pv, n, item_size, *out, count, convert)))
+    {
+        CoTaskMemFree(*out);
+        *out = NULL;
+        return hr;
+    }
+    return S_OK;
+}
+
+static HRESULT propvar_init_vector(const void *items, ULONG count, ULONG item_size, VARTYPE vt, PROPVARIANT *pv)
+{
+    void *copy;
+
+    if (!pv) return E_INVALIDARG;
+    PropVariantInit(pv);
+    if (!items && count) return E_INVALIDARG;
+    if (!(copy = CoTaskMemAlloc(max(count, 1) * item_size))) return E_OUTOFMEMORY;
+    if (count) memcpy(copy, items, count * item_size);
+    pv->vt = vt | VT_VECTOR;
+    pv->caub.cElems = count;
+    pv->caub.pElems = copy;
+    return S_OK;
+}
+
+HRESULT WINAPI InitPropVariantFromBooleanVector(const BOOL *items, ULONG count, PROPVARIANT *pv)
+{
+    VARIANT_BOOL *copy;
+    ULONG i;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %p\n", items, count, pv);
+
+    if (!items && count) return E_INVALIDARG;
+    if (!(copy = CoTaskMemAlloc(max(count, 1) * sizeof(*copy)))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+#ifdef SG_MUTANT_PROPVEC_BOOL
+        copy[i] = items[i];
+#else
+        copy[i] = items[i] ? VARIANT_TRUE : VARIANT_FALSE;
+#endif
+    }
+    hr = propvar_init_vector(copy, count, sizeof(*copy), VT_BOOL, pv);
+    CoTaskMemFree(copy);
+    return hr;
+}
+
+HRESULT WINAPI InitPropVariantFromFileTimeVector(const FILETIME *items, ULONG count, PROPVARIANT *pv)
+{
+    TRACE("%p, %lu, %p\n", items, count, pv);
+    return propvar_init_vector(items, count, sizeof(*items), VT_FILETIME, pv);
+}
