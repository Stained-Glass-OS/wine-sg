+/* The blend state for what is drawn now: DrawImage's composite mode, else
+ * the primitive blend. Colours are premultiplied, so each mode is a pair of
+ * factors (source, destination), the same for colour and alpha. */
+static ID3D11BlendState *d2d_device_context_get_blend_state(struct d2d_device_context *context)
+{
+    static const struct { D3D11_BLEND src, dst; D3D11_BLEND_OP op; } modes[] =
+    {
+        {D3D11_BLEND_ONE,            D3D11_BLEND_INV_SRC_ALPHA}, /* source over */
+        {D3D11_BLEND_INV_DEST_ALPHA, D3D11_BLEND_ONE},           /* destination over */
+        {D3D11_BLEND_DEST_ALPHA,     D3D11_BLEND_ZERO},          /* source in */
+        {D3D11_BLEND_ZERO,           D3D11_BLEND_SRC_ALPHA},     /* destination in */
+        {D3D11_BLEND_INV_DEST_ALPHA, D3D11_BLEND_ZERO},          /* source out */
+        {D3D11_BLEND_ZERO,           D3D11_BLEND_INV_SRC_ALPHA}, /* destination out */
+        {D3D11_BLEND_DEST_ALPHA,     D3D11_BLEND_INV_SRC_ALPHA}, /* source atop */
+        {D3D11_BLEND_INV_DEST_ALPHA, D3D11_BLEND_SRC_ALPHA},     /* destination atop */
+        {D3D11_BLEND_INV_DEST_ALPHA, D3D11_BLEND_INV_SRC_ALPHA}, /* xor */
+        {D3D11_BLEND_ONE,            D3D11_BLEND_ONE},           /* plus */
+        {D3D11_BLEND_ONE,            D3D11_BLEND_ZERO},          /* source copy */
+        {D3D11_BLEND_ONE,            D3D11_BLEND_ZERO},          /* bounded source copy */
+        {D3D11_BLEND_INV_DEST_COLOR, D3D11_BLEND_INV_SRC_ALPHA}, /* mask invert */
+        {D3D11_BLEND_ONE,            D3D11_BLEND_ONE, D3D11_BLEND_OP_MIN}, /* primitive blend min */
+        {D3D11_BLEND_ONE,            D3D11_BLEND_ONE, D3D11_BLEND_OP_MAX}, /* primitive blend max */
+    };
+    D3D11_BLEND_DESC desc;
+    unsigned int mode;
+
+    if (context->composite_mode > 0)
+        mode = context->composite_mode;
+    else switch (context->drawing_state.primitiveBlend)
+    {
+        case D2D1_PRIMITIVE_BLEND_COPY: mode = D2D1_COMPOSITE_MODE_BOUNDED_SOURCE_COPY; break;
+        case D2D1_PRIMITIVE_BLEND_ADD: mode = D2D1_COMPOSITE_MODE_PLUS; break;
+        case D2D1_PRIMITIVE_BLEND_MIN: mode = D2D1_COMPOSITE_MODE_MASK_INVERT + 1; break;
+        case D2D1_PRIMITIVE_BLEND_MAX: mode = D2D1_COMPOSITE_MODE_MASK_INVERT + 2; break;
+        default: return context->bs;
+    }
+    if (mode >= ARRAY_SIZE(modes))
+        return context->bs;
+    if (!context->blend_states[mode])
+    {
+        memset(&desc, 0, sizeof(desc));
+        desc.RenderTarget[0].BlendEnable = TRUE;
+        desc.RenderTarget[0].SrcBlend = modes[mode].src;
+        desc.RenderTarget[0].DestBlend = modes[mode].dst;
+        desc.RenderTarget[0].BlendOp = modes[mode].op ? modes[mode].op : D3D11_BLEND_OP_ADD;
+        desc.RenderTarget[0].SrcBlendAlpha = modes[mode].src == D3D11_BLEND_INV_DEST_COLOR
+                ? D3D11_BLEND_ONE : modes[mode].src;
+        desc.RenderTarget[0].DestBlendAlpha = modes[mode].dst;
+        desc.RenderTarget[0].BlendOpAlpha = desc.RenderTarget[0].BlendOp;
+        desc.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+        if (FAILED(ID3D11Device1_CreateBlendState(context->d3d_device, &desc, &context->blend_states[mode])))
+            return context->bs;
+    }
+    return context->blend_states[mode];
+}
