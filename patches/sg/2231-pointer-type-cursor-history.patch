From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32, server: GetPointerType ids, GetMouseMovePointsEx desktop

GetPointerType answered PT_MOUSE for any pointer id; an id that is neither
the mouse (1) nor a known pen or touch pointer is ERROR_INVALID_PARAMETER.
GetMouseMovePointsEx read the cursor history from any desktop; a desktop
that does not receive input (another window station's, say) is
ERROR_ACCESS_DENIED.  The matching todo_wine marks are removed from the
user32 input test, and one already satisfied in the ntdll pipe test.

---
--- a/dlls/ntdll/tests/pipe.c
+++ b/dlls/ntdll/tests/pipe.c
@@ -2342,7 +2342,6 @@ static void test_pipe_local_info(HANDLE pipe, BOOL is_server, DWORD state)
         ok(local_info.ReadDataAvailable == 0, "ReadDataAvailable = %lu\n",
            local_info.ReadDataAvailable);
         ok(local_info.OutboundQuota == 200, "OutboundQuota = %lu\n", local_info.OutboundQuota);
-        todo_wine
         ok(local_info.WriteQuotaAvailable == (is_server ? 200 : 100), "WriteQuotaAvailable = %lu\n",
            local_info.WriteQuotaAvailable);
         ok(local_info.NamedPipeState == state, "%s NamedPipeState = %lu, expected %lu\n",
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -1125,7 +1125,17 @@ BOOL WINAPI GetPointerType(UINT32 id, POINTER_INPUT_TYPE *type)
         return FALSE;
     }
 
-    *type = NtUserSgGetPointerData( id, &data ) ? data.type : PT_MOUSE;
+    if (NtUserSgGetPointerData( id, &data )) *type = data.type;
+#ifndef SG_MUTANT_POINTER_TYPE_ANY_ID
+    else if (id == 1) *type = PT_MOUSE;   /* the mouse is pointer 1 */
+    else
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+#else
+    else *type = PT_MOUSE;
+#endif
     return TRUE;
 }
 
--- a/dlls/user32/tests/input.c
+++ b/dlls/user32/tests/input.c
@@ -1897,8 +1897,8 @@ static void test_GetMouseMovePointsEx_process(void)
 
     SetLastError( 0xDEADBEEF );
     retval = pGetMouseMovePointsEx( sizeof(MOUSEMOVEPOINT), &in, out, ARRAY_SIZE(out), GMMP_USE_DISPLAY_POINTS );
-    todo_wine ok( retval == -1, "expected to get -1 mouse move points but got %d\n", retval );
-    todo_wine ok( GetLastError() == ERROR_ACCESS_DENIED, "expected ERROR_ACCESS_DENIED got %ld\n", GetLastError() );
+    ok( retval == -1, "expected to get -1 mouse move points but got %d\n", retval );
+    ok( GetLastError() == ERROR_ACCESS_DENIED, "expected ERROR_ACCESS_DENIED got %ld\n", GetLastError() );
 
     ok( SetProcessWindowStation( winstation0 ), "SetProcessWindowStation has failed\n" );
     ok( SetThreadDesktop( desk0 ), "SetThreadDesktop failed!\n" );
@@ -5442,9 +5442,7 @@ static void test_GetPointerInfo( BOOL mouse_in_pointer_enabled )
     ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
     SetLastError( 0xdeadbeef );
     ret = pGetPointerType( 0xdead, &type );
-    todo_wine
     ok( !ret, "GetPointerType succeeded\n" );
-    todo_wine
     ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
     ret = pGetPointerType( 1, &type );
     ok( ret, "GetPointerType failed, error %lu\n", GetLastError() );
--- a/server/queue.c
+++ b/server/queue.c
@@ -4351,6 +4351,24 @@ DECL_HANDLER(get_cursor_history)
 {
     struct cursor_pos *pos;
     unsigned int i, count = min( 64, get_reply_max_size() / sizeof(*pos) );
+    struct desktop *desktop;
+    int input_desktop;
+
+    /* only the thread of the desktop that receives the input may read its history */
+    if (!(desktop = get_thread_desktop( current, 0 ))) input_desktop = 0;
+    else
+    {
+        input_desktop = desktop == desktop->winstation->input_desktop;
+        release_object( desktop );
+    }
+#ifdef SG_MUTANT_CURSOR_HISTORY_ANY_DESKTOP
+    input_desktop = 1;
+#endif
+    if (!input_desktop)
+    {
+        set_error( STATUS_ACCESS_DENIED );
+        return;
+    }
 
     if ((pos = set_reply_data_size( count * sizeof(*pos) )))
         for (i = 0; i < count; i++)
