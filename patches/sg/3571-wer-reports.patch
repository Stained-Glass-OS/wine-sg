From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wer: report handles keep their data, validation (3571)

wer: report handles keep their parameters, files, dumps and UI options

WerReportSetParameter (id 0..9, value < 260 chars, optional name), WerReportAddFile (type and path checked,
16 files), WerReportAddDump (process, dump type and options checked), WerReportSetUIOption (UI type and text
length checked) store their data in the report and fail with E_INVALIDARG for a handle that is not a live report;
WerReportSubmit validates the handle and consent. Reports are never sent: the result stays WerDisabled.
WerReportCreate without information fills in the application name and path.
---
diff --git a/dlls/wer/main.c b/dlls/wer/main.c
index b0f18b0..4b3f37b 100644
--- a/dlls/wer/main.c
+++ b/dlls/wer/main.c
@@ -29,13 +29,29 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(wer);
 
+#define MAX_REPORT_FILES 16
+#define MAX_PARAM_VALUE 260
+#define MAX_PARAM_NAME 64
+#define MAX_UI_TEXT 512
+
 typedef struct {
     struct list entry;
     WER_REPORT_INFORMATION info;
     WER_REPORT_TYPE reporttype;
+    WCHAR *params[WER_MAX_PARAM_COUNT];
+    WCHAR *param_names[WER_MAX_PARAM_COUNT];
+    WCHAR *ui[WerUIMax];
+    WCHAR *files[MAX_REPORT_FILES];
+    WER_FILE_TYPE file_types[MAX_REPORT_FILES];
+    DWORD file_flags[MAX_REPORT_FILES];
+    unsigned int file_count;
+    unsigned int dump_count;
     WCHAR eventtype[1];
 } report_t;
 
+/* the report for a handle, with the table lock held; NULL for a handle that is not one */
+static report_t *find_report(HREPORT handle);
+
 
 static CRITICAL_SECTION report_table_cs;
 static CRITICAL_SECTION_DEBUG report_table_cs_debug =
@@ -48,6 +64,32 @@ static CRITICAL_SECTION report_table_cs = { &report_table_cs_debug, -1, 0, 0, 0,
 
 static struct list report_table = LIST_INIT(report_table);
 
+static report_t *find_report(HREPORT handle)
+{
+    report_t *cursor;
+
+    LIST_FOR_EACH_ENTRY(cursor, &report_table, report_t, entry)
+        if (cursor == (report_t *)handle) return cursor;
+    return NULL;
+}
+
+static WCHAR *dup_wstr(const WCHAR *s)
+{
+    WCHAR *ret = malloc((lstrlenW(s) + 1) * sizeof(WCHAR));
+    if (ret) lstrcpyW(ret, s);
+    return ret;
+}
+
+static void free_report(report_t *report)
+{
+    unsigned int i;
+
+    for (i = 0; i < WER_MAX_PARAM_COUNT; i++) { free(report->params[i]); free(report->param_names[i]); }
+    for (i = 0; i < WerUIMax; i++) free(report->ui[i]);
+    for (i = 0; i < report->file_count; i++) free(report->files[i]);
+    free(report);
+}
+
 static const WCHAR regpath_exclude[] = L"Software\\Microsoft\\Windows Error Reporting\\ExcludedApplications";
 
 /***********************************************************************
@@ -155,10 +197,27 @@ HRESULT WINAPI WerReportAddDump(HREPORT hReportHandle, HANDLE hProcess, HANDLE h
                                 WER_DUMP_TYPE dumpType, PWER_EXCEPTION_INFORMATION pExceptionParam,
                                 PWER_DUMP_CUSTOM_OPTIONS pDumpCustomOptions, DWORD dwFlags)
 {
-    FIXME("(%p, %p, %p, %d, %p, %p, %lu) :stub\n", hReportHandle, hProcess, hThread, dumpType,
+    report_t *report;
+    HRESULT hr = S_OK;
+    DWORD exit_code;
+
+    TRACE("(%p, %p, %p, %d, %p, %p, %lu)\n", hReportHandle, hProcess, hThread, dumpType,
           pExceptionParam, pDumpCustomOptions, dwFlags);
 
-    return E_NOTIMPL;
+    if (!hProcess || dumpType < WerDumpTypeMicroDump || dumpType >= WerDumpTypeMax)
+        return E_INVALIDARG;
+    if (!GetExitCodeProcess(hProcess, &exit_code))
+        return E_INVALIDARG;
+    if (pDumpCustomOptions && pDumpCustomOptions->dwSize != sizeof(*pDumpCustomOptions))
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&report_table_cs);
+    if (!(report = find_report(hReportHandle)))
+        hr = E_INVALIDARG;
+    else
+        report->dump_count++;  /* the dump is taken when the report is submitted; reporting is disabled here */
+    LeaveCriticalSection(&report_table_cs);
+    return hr;
 }
 
 /***********************************************************************
@@ -179,9 +238,29 @@ HRESULT WINAPI WerReportAddDump(HREPORT hReportHandle, HANDLE hProcess, HANDLE h
  */
 HRESULT WINAPI WerReportAddFile(HREPORT hreport, PCWSTR path, WER_FILE_TYPE type, DWORD flags)
 {
-    FIXME("(%p, %s, %d, 0x%lx) :stub\n", hreport, debugstr_w(path), type, flags);
+    report_t *report;
+    HRESULT hr = S_OK;
 
-    return S_OK;
+    TRACE("(%p, %s, %d, 0x%lx)\n", hreport, debugstr_w(path), type, flags);
+
+    if (!path || !path[0] || type < WerFileTypeMicrodump || type >= WerFileTypeMax)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&report_table_cs);
+    if (!(report = find_report(hreport)))
+        hr = E_INVALIDARG;
+    else if (report->file_count >= MAX_REPORT_FILES)
+        hr = E_OUTOFMEMORY;
+    else if (!(report->files[report->file_count] = dup_wstr(path)))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        report->file_types[report->file_count] = type;
+        report->file_flags[report->file_count] = flags;
+        report->file_count++;
+    }
+    LeaveCriticalSection(&report_table_cs);
+    return hr;
 }
 
 /***********************************************************************
@@ -219,7 +298,7 @@ HRESULT WINAPI WerReportCloseHandle(HREPORT hreport)
     if (!found)
         return E_INVALIDARG;
 
-    free(report);
+    free_report(report);
 
     return S_OK;
 }
@@ -269,7 +348,17 @@ HRESULT WINAPI WerReportCreate(PCWSTR eventtype, WER_REPORT_TYPE reporttype, PWE
     if (reportinfo) {
         report->info = *reportinfo;
     } else {
-        FIXME("build report information from scratch for %p\n", report);
+        WCHAR path[MAX_PATH], *base;
+
+        report->info.dwSize = sizeof(report->info);
+        report->info.hProcess = GetCurrentProcess();
+        if (GetModuleFileNameW(NULL, path, MAX_PATH))
+        {
+            lstrcpynW(report->info.wzApplicationPath, path, MAX_PATH);
+            base = wcsrchr(path, '\\');
+            lstrcpynW(report->info.wzApplicationName, base ? base + 1 : path,
+                    ARRAY_SIZE(report->info.wzApplicationName));
+        }
     }
 
     EnterCriticalSection(&report_table_cs);
@@ -299,9 +388,36 @@ HRESULT WINAPI WerReportCreate(PCWSTR eventtype, WER_REPORT_TYPE reporttype, PWE
  */
 HRESULT WINAPI WerReportSetParameter(HREPORT hreport, DWORD id, PCWSTR name, PCWSTR value)
 {
-    FIXME("(%p, %ld, %s, %s) :stub\n", hreport, id, debugstr_w(name), debugstr_w(value));
+    report_t *report;
+    WCHAR *vcopy, *ncopy = NULL;
+    HRESULT hr = S_OK;
 
-    return S_OK;
+    TRACE("(%p, %ld, %s, %s)\n", hreport, id, debugstr_w(name), debugstr_w(value));
+
+    if (id >= WER_MAX_PARAM_COUNT || !value || lstrlenW(value) >= MAX_PARAM_VALUE
+            || (name && lstrlenW(name) >= MAX_PARAM_NAME))
+        return E_INVALIDARG;
+
+    vcopy = dup_wstr(value);
+    if (name && name[0]) ncopy = dup_wstr(name);
+    if (!vcopy || (name && name[0] && !ncopy))
+    {
+        free(vcopy); free(ncopy);
+        return E_OUTOFMEMORY;
+    }
+    EnterCriticalSection(&report_table_cs);
+    if (!(report = find_report(hreport)))
+        hr = E_INVALIDARG;
+    else
+    {
+        free(report->params[id]); free(report->param_names[id]);
+        report->params[id] = vcopy;
+        report->param_names[id] = ncopy;
+        vcopy = ncopy = NULL;
+    }
+    LeaveCriticalSection(&report_table_cs);
+    free(vcopy); free(ncopy);
+    return hr;
 }
 
 /***********************************************************************
@@ -323,11 +439,20 @@ HRESULT WINAPI WerReportSetParameter(HREPORT hreport, DWORD id, PCWSTR name, PCW
  */
 HRESULT WINAPI WerReportSubmit(HREPORT hreport, WER_CONSENT consent, DWORD flags, PWER_SUBMIT_RESULT presult)
 {
-    FIXME("(%p, %d, 0x%lx, %p) :stub\n", hreport, consent, flags, presult);
+    BOOL valid;
+
+    TRACE("(%p, %d, 0x%lx, %p)\n", hreport, consent, flags, presult);
 
-    if(!presult)
+    if (!presult)
         return E_INVALIDARG;
 
+    EnterCriticalSection(&report_table_cs);
+    valid = find_report(hreport) != NULL;
+    LeaveCriticalSection(&report_table_cs);
+    if (!valid || consent < WerConsentNotAsked || consent >= WerConsentMax)
+        return E_INVALIDARG;
+
+    /* Reports are never sent anywhere from this system: reporting is disabled. */
     *presult = WerDisabled;
     return S_OK;
 }
@@ -337,6 +462,26 @@ HRESULT WINAPI WerReportSubmit(HREPORT hreport, WER_CONSENT consent, DWORD flags
  */
 HRESULT WINAPI WerReportSetUIOption(HREPORT hreport, WER_REPORT_UI uitype, PCWSTR value)
 {
-    FIXME("(%p, %d, %s) :stub\n", hreport, uitype, debugstr_w(value));
-    return E_NOTIMPL;
+    report_t *report;
+    WCHAR *copy;
+    HRESULT hr = S_OK;
+
+    TRACE("(%p, %d, %s)\n", hreport, uitype, debugstr_w(value));
+
+    if (uitype < WerUIAdditionalDataDlgHeader || uitype >= WerUIMax || !value || lstrlenW(value) >= MAX_UI_TEXT)
+        return E_INVALIDARG;
+    if (!(copy = dup_wstr(value))) return E_OUTOFMEMORY;
+
+    EnterCriticalSection(&report_table_cs);
+    if (!(report = find_report(hreport)))
+        hr = E_INVALIDARG;
+    else
+    {
+        free(report->ui[uitype]);
+        report->ui[uitype] = copy;
+        copy = NULL;
+    }
+    LeaveCriticalSection(&report_table_cs);
+    free(copy);
+    return hr;
 }
