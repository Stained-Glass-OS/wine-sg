+/* Stained Glass OS (wine-sg 8012): resource descriptors, the entries of a logical configuration. With no
+ * configuration on any device (8246) no configuration or descriptor handle can exist, so the calls check
+ * their arguments the way Windows does and then report the handle invalid; the frees and edits too. */
+static BOOL res_des_type_valid(RESOURCEID id)
+{
+    return id <= ResType_MAX || id == ResType_ClassSpecific ||
+           (id >= ResType_DevicePrivate && id <= ResType_Connection);
+}
+
+CONFIGRET WINAPI CM_Get_Next_Res_Des_Ex(RES_DES *next, RES_DES current, RESOURCEID type, RESOURCEID *found,
+                                        ULONG flags, HMACHINE machine)
+{
+    TRACE("%p %#Ix %#lx %p %#lx %p\n", next, current, type, found, flags, machine);
+
+    if (!next) return CR_INVALID_POINTER;
+    *next = 0;
+    if (type == ResType_All && !found) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    if (!res_des_type_valid(type)) return CR_INVALID_RESOURCEID;
+#ifdef SG_MUTANT_NO_RESDES
+    return CR_NO_MORE_RES_DES;
+#endif
+    return CR_INVALID_RES_DES;
+}
+
+CONFIGRET WINAPI CM_Get_Next_Res_Des(RES_DES *next, RES_DES current, RESOURCEID type, RESOURCEID *found, ULONG flags)
+{
+    return CM_Get_Next_Res_Des_Ex(next, current, type, found, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Get_Res_Des_Data_Ex(RES_DES res_des, void *buffer, ULONG len, ULONG flags, HMACHINE machine)
+{
+    TRACE("%#Ix %p %lu %#lx %p\n", res_des, buffer, len, flags, machine);
+
+    if (!buffer) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    return CR_INVALID_RES_DES;
+}
+
+CONFIGRET WINAPI CM_Get_Res_Des_Data(RES_DES res_des, void *buffer, ULONG len, ULONG flags)
+{
+    return CM_Get_Res_Des_Data_Ex(res_des, buffer, len, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Get_Res_Des_Data_Size_Ex(ULONG *size, RES_DES res_des, ULONG flags, HMACHINE machine)
+{
+    TRACE("%p %#Ix %#lx %p\n", size, res_des, flags, machine);
+
+    if (!size) return CR_INVALID_POINTER;
+    *size = 0;
+    if (flags) return CR_INVALID_FLAG;
+    return CR_INVALID_RES_DES;
+}
+
+CONFIGRET WINAPI CM_Get_Res_Des_Data_Size(ULONG *size, RES_DES res_des, ULONG flags)
+{
+    return CM_Get_Res_Des_Data_Size_Ex(size, res_des, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Free_Res_Des_Handle(RES_DES res_des)
+{
+    TRACE("%#Ix\n", res_des);
+    return CR_INVALID_RES_DES;
+}
+
+CONFIGRET WINAPI CM_Free_Res_Des_Ex(RES_DES *prev, RES_DES res_des, ULONG flags, HMACHINE machine)
+{
+    TRACE("%p %#Ix %#lx %p\n", prev, res_des, flags, machine);
+
+    if (prev) *prev = 0;
+    if (flags) return CR_INVALID_FLAG;
+    return CR_INVALID_RES_DES;
+}
+
+CONFIGRET WINAPI CM_Free_Res_Des(RES_DES *prev, RES_DES res_des, ULONG flags)
+{
+    return CM_Free_Res_Des_Ex(prev, res_des, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Add_Res_Des_Ex(RES_DES *res_des, LOG_CONF conf, RESOURCEID type, const void *data, ULONG len,
+                                   ULONG flags, HMACHINE machine)
+{
+    TRACE("%p %#Ix %#lx %p %lu %#lx %p\n", res_des, conf, type, data, len, flags, machine);
+
+    if (res_des) *res_des = 0;
+    if (!data || !len) return CR_INVALID_POINTER;
+    if (flags & ~1 /* CM_RESDES_WIDTH_BITS */) return CR_INVALID_FLAG;
+    if (type == ResType_All || !res_des_type_valid(type)) return CR_INVALID_RESOURCEID;
+    return CR_INVALID_LOG_CONF;
+}
+
+CONFIGRET WINAPI CM_Add_Res_Des(RES_DES *res_des, LOG_CONF conf, RESOURCEID type, const void *data, ULONG len, ULONG flags)
+{
+    return CM_Add_Res_Des_Ex(res_des, conf, type, data, len, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Modify_Res_Des_Ex(RES_DES *new_res_des, RES_DES res_des, RESOURCEID type, const void *data,
+                                      ULONG len, ULONG flags, HMACHINE machine)
+{
+    TRACE("%p %#Ix %#lx %p %lu %#lx %p\n", new_res_des, res_des, type, data, len, flags, machine);
+
+    if (!new_res_des || !data || !len) return CR_INVALID_POINTER;
+    *new_res_des = 0;
+    if (flags & ~1 /* CM_RESDES_WIDTH_BITS */) return CR_INVALID_FLAG;
+    if (type == ResType_All || !res_des_type_valid(type)) return CR_INVALID_RESOURCEID;
+    return CR_INVALID_RES_DES;
+}
+
+CONFIGRET WINAPI CM_Modify_Res_Des(RES_DES *new_res_des, RES_DES res_des, RESOURCEID type, const void *data,
+                                   ULONG len, ULONG flags)
+{
+    return CM_Modify_Res_Des_Ex(new_res_des, res_des, type, data, len, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Free_Log_Conf_Ex(LOG_CONF conf, ULONG flags, HMACHINE machine)
+{
+    TRACE("%#Ix %#lx %p\n", conf, flags, machine);
+
+    if (flags) return CR_INVALID_FLAG;
+    return CR_INVALID_LOG_CONF;
+}
+
+CONFIGRET WINAPI CM_Free_Log_Conf(LOG_CONF conf, ULONG flags)
+{
+    return CM_Free_Log_Conf_Ex(conf, flags, NULL);
+}
