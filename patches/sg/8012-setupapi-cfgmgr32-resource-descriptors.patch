+static void test_res_des(void)
+{
+    RESOURCEID type;
+    LOG_CONF conf = 0;
+    RES_DES rd = 1;
+    DEVINST root;
+    ULONG size = 1;
+    BYTE data[16];
+    CONFIGRET cr;
+
+    cr = CM_Locate_DevNodeW(&root, NULL, CM_LOCATE_DEVNODE_NORMAL);
+    ok(cr == CR_SUCCESS, "got %#lx\n", cr);
+    cr = CM_Get_First_Log_Conf(&conf, root, ALLOC_LOG_CONF);
+    if (cr == CR_SUCCESS)
+    {
+        skip("the root device has a configuration\n");
+        CM_Free_Log_Conf_Handle(conf);
+        return;
+    }
+    cr = CM_Get_Next_Res_Des(NULL, conf, ResType_All, &type, 0);
+    ok(cr == CR_INVALID_POINTER, "got %#lx\n", cr);
+    cr = CM_Get_Next_Res_Des(&rd, conf, ResType_Mem, NULL, 1);
+    ok(cr == CR_INVALID_FLAG, "got %#lx\n", cr);
+    cr = CM_Get_Next_Res_Des(&rd, conf, ResType_All, &type, 0);
+    ok(cr != CR_SUCCESS && !rd, "got %#lx, %#Ix\n", cr, rd);
+    cr = CM_Get_Res_Des_Data(rd, NULL, sizeof(data), 0);
+    ok(cr == CR_INVALID_POINTER, "got %#lx\n", cr);
+    cr = CM_Get_Res_Des_Data_Size(&size, rd, 0);
+    ok(cr == CR_INVALID_RES_DES && !size, "got %#lx, %lu\n", cr, size);
+    cr = CM_Free_Res_Des_Handle(rd);
+    ok(cr == CR_INVALID_RES_DES, "got %#lx\n", cr);
+}
+
 START_TEST(cfgmgr32)
 {
     test_CM_MapCrToWin32Err();
+    test_res_des();
 }
