+static BOOL package_file_name( const WCHAR *name )
+{
+    const WCHAR *ext = wcsrchr( name, '.' );
+    return ext && (!wcsicmp( ext, L".appx" ) || !wcsicmp( ext, L".msix" ));
+}
+
+static HRESULT co_string( HRESULT hr, WCHAR *co, WCHAR **out )
+{
+    if (FAILED(hr)) return hr;
+    *out = strdupW( co ? co : L"" );
+    CoTaskMemFree( co );
+    return *out ? S_OK : E_OUTOFMEMORY;
+}
+
+/* the identity and resources of a package, from its manifest */
+static HRESULT read_package_entry( const BYTE *data, SIZE_T size, struct bundle_entry *e )
+{
+    IAppxManifestResourcesEnumerator *resources = NULL;
+    IAppxManifestProperties *props = NULL;
+    IAppxManifestPackageId *id = NULL;
+    IAppxManifestReader *manifest = NULL;
+    IAppxPackageReader *reader;
+    IStream *stream;
+    WCHAR *str;
+    BOOL has, resource_package = FALSE;
+    HRESULT hr;
+
+    if (!(stream = mem_stream( data, size ))) return E_OUTOFMEMORY;
+    hr = package_reader_create( stream, &reader );
+    IStream_Release( stream );
+    if (FAILED(hr)) return hr;
+    hr = IAppxPackageReader_GetManifest( reader, &manifest );
+    if (SUCCEEDED(hr)) hr = IAppxManifestReader_GetPackageId( manifest, &id );
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = IAppxManifestPackageId_GetName( id, &str ))) hr = co_string( hr, str, &e->name );
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = IAppxManifestPackageId_GetPublisher( id, &str ))) hr = co_string( hr, str, &e->publisher );
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = IAppxManifestPackageId_GetResourceId( id, &str ))) hr = co_string( hr, str, &e->resource_id );
+    if (SUCCEEDED(hr)) hr = IAppxManifestPackageId_GetVersion( id, &e->version );
+    if (SUCCEEDED(hr)) hr = IAppxManifestPackageId_GetArchitecture( id, &e->architecture );
+    if (SUCCEEDED(hr) && SUCCEEDED(IAppxManifestReader_GetProperties( manifest, &props )))
+        IAppxManifestProperties_GetBoolValue( props, L"ResourcePackage", &resource_package );
+    /* a resource package says so in its properties */
+    e->resource = resource_package;
+#ifdef SG_MUTANT_BUNDLE_ALL_APPLICATION
+    e->resource = FALSE;
+#endif
+    if (SUCCEEDED(hr) && SUCCEEDED(IAppxManifestReader_GetResources( manifest, &resources )))
+    {
+        for (IAppxManifestResourcesEnumerator_GetHasCurrent( resources, &has ); SUCCEEDED(hr) && has;
+             IAppxManifestResourcesEnumerator_MoveNext( resources, &has ))
+        {
+            WCHAR **grown;
+
+            if (FAILED(hr = IAppxManifestResourcesEnumerator_GetCurrent( resources, &str ))) break;
+            if (e->language_count >= 200 || !(grown = realloc( e->languages, (e->language_count + 1) * sizeof(*grown) )))
+            {
+                CoTaskMemFree( str );
+                continue;
+            }
+            e->languages = grown;
+            if (SUCCEEDED(hr = co_string( hr, str, &grown[e->language_count] ))) e->language_count++;
+        }
+        IAppxManifestResourcesEnumerator_Release( resources );
+    }
+    if (props) IAppxManifestProperties_Release( props );
+    if (id) IAppxManifestPackageId_Release( id );
+    if (manifest) IAppxManifestReader_Release( manifest );
+    IAppxPackageReader_Release( reader );
+    return hr;
+}
+
+static HRESULT bundle_add_package( struct writer *w, const WCHAR *name, IStream *input, BOOL embedded )
+{
+    struct bundle_entry *grown, *e;
+    BYTE *data;
+    SIZE_T size;
+    unsigned int i;
+    HRESULT hr;
+
+    if (!name || !input) return E_INVALIDARG;
+    if (w->closed || w->failed) return E_UNEXPECTED;
+    if (!payload_name_ok( w, name ) || !package_file_name( name )) return E_INVALIDARG;
+    if (!(grown = realloc( w->packages, (w->package_count + 1) * sizeof(*grown) ))) return E_OUTOFMEMORY;
+    w->packages = grown;
+    e = &grown[w->package_count];
+    memset( e, 0, sizeof(*e) );
+
+    if (FAILED(hr = read_whole_stream( input, (SIZE_T)1 << 31, &data, &size ))) return hr;
+    if (!(e->file_name = strdupW( name ))) hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr) && FAILED(hr = read_package_entry( data, size, e )))
+        WARN( "%s is not a package the reader takes (%#lx)\n", debugstr_w( name ), hr );
+    /* a bundle's packages are of one app: one name and publisher */
+    for (i = 0; SUCCEEDED(hr) && i < w->package_count; i++)
+    {
+#ifndef SG_MUTANT_BUNDLE_MIXED_APPS
+        if (wcscmp( w->packages[i].name, e->name ) || wcscmp( w->packages[i].publisher, e->publisher ))
+        {
+            WARN( "%s is %s, not %s\n", debugstr_w( name ), debugstr_w( e->name ), debugstr_w( w->packages[i].name ) );
+            hr = APPX_E_INVALID_MANIFEST;
+        }
+#endif
+    }
+    e->size = size;
+    e->embedded = embedded;
+    if (SUCCEEDED(hr) && embedded)
+    {
+        /* stored as it is: the manifest gives its offset in the bundle */
+        if (SUCCEEDED(hr = add_content_type( w, name, L"application/vnd.ms-appx" )) &&
+            SUCCEEDED(hr = write_file( w, name, data, size, APPX_COMPRESSION_OPTION_NONE, TRUE )))
+            e->offset = w->files[w->count - 1].offset + w->files[w->count - 1].lfh_size;
+        else if (hr != E_INVALIDARG) w->failed = TRUE;
+    }
+    free( data );
+    w->package_count++;     /* so that writer_free frees it */
+    if (FAILED(hr))
+    {
+        struct bundle_entry failed = *e;
+        w->package_count--;
+        free( failed.file_name );
+        free( failed.name );
+        free( failed.publisher );
+        free( failed.resource_id );
+        for (i = 0; i < failed.language_count; i++) free( failed.languages[i] );
+        free( failed.languages );
+    }
+    return hr;
+}
+
+static const char *architecture_name( APPX_PACKAGE_ARCHITECTURE arch )
+{
+    switch (arch)
+    {
+    case APPX_PACKAGE_ARCHITECTURE_X86: return "x86";
+    case APPX_PACKAGE_ARCHITECTURE_ARM: return "arm";
+    case APPX_PACKAGE_ARCHITECTURE_X64: return "x64";
+    case APPX_PACKAGE_ARCHITECTURE_ARM64: return "arm64";
+    default: return "neutral";
+    }
+}
+
+static void version_text( UINT64 version, char *buf )
+{
+    sprintf( buf, "%u.%u.%u.%u", (UINT)(version >> 48), (UINT)(version >> 32) & 0xffff,
+             (UINT)(version >> 16) & 0xffff, (UINT)version & 0xffff );
+}
+
+static HRESULT build_bundle_manifest( struct writer *w, struct text *t )
+{
+    const struct bundle_entry *first = &w->packages[0];
+    char buf[160];
+    unsigned int i, j;
+
+    version_text( w->bundle_version, buf );
+    if (!text_add( t, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+                   "<Bundle xmlns=\"http://schemas.microsoft.com/appx/2013/bundle\" SchemaVersion=\"1.0\">"
+                   "<Identity Name=\"" ) || !text_add_attr( t, first->name ) ||
+        !text_add( t, "\" Publisher=\"" ) || !text_add_attr( t, first->publisher ) ||
+        !text_add( t, "\" Version=\"" ) || !text_add( t, buf ) || !text_add( t, "\"/><Packages>" ))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < w->package_count; i++)
+    {
+        const struct bundle_entry *e = &w->packages[i];
+
+        version_text( e->version, buf );
+        if (!text_add( t, e->resource ? "<Package Type=\"resource\" Version=\"" : "<Package Type=\"application\" Version=\"" ) ||
+            !text_add( t, buf ) || !text_add( t, "\" Architecture=\"" ) || !text_add( t, architecture_name( e->architecture ) ) ||
+            !text_add( t, "\"" ))
+            return E_OUTOFMEMORY;
+        if (e->resource_id && e->resource_id[0] &&
+            (!text_add( t, " ResourceId=\"" ) || !text_add_attr( t, e->resource_id ) || !text_add( t, "\"" )))
+            return E_OUTOFMEMORY;
+        if (!text_add( t, " FileName=\"" ) || !text_add_attr( t, e->file_name ) || !text_add( t, "\"" )) return E_OUTOFMEMORY;
+        /* a referenced package has no offset: it is not in the bundle */
+        if (e->embedded) sprintf( buf, " Offset=\"%I64u\" Size=\"%I64u\">", e->offset, e->size );
+        else sprintf( buf, " Size=\"%I64u\">", e->size );
+        if (!text_add( t, buf ) || !text_add( t, "<Resources>" )) return E_OUTOFMEMORY;
+        for (j = 0; j < e->language_count; j++)
+            if (!text_add( t, "<Resource Language=\"" ) || !text_add_attr( t, e->languages[j] ) || !text_add( t, "\"/>" ))
+                return E_OUTOFMEMORY;
+        if (!text_add( t, "</Resources></Package>" )) return E_OUTOFMEMORY;
+    }
+    return text_add( t, "</Packages></Bundle>" ) ? S_OK : E_OUTOFMEMORY;
+}
+
+/* a version from the time, when none was given: year.month*100+day.hour*100+minute.0, UTC */
+static UINT64 generated_version(void)
+{
+    SYSTEMTIME st;
+
+    GetSystemTime( &st );
+    return (UINT64)st.wYear << 48 | (UINT64)(st.wMonth * 100 + st.wDay) << 32 | (UINT64)(st.wHour * 100 + st.wMinute) << 16;
+}
+
+static HRESULT bundle_close( struct writer *w, const WCHAR *hash_method )
+{
+    struct text manifest = { 0 }, blockmap = { 0 }, types = { 0 };
+    unsigned int i, hash = w->hash;
+    BOOL application = FALSE;
+    HRESULT hr;
+
+    if (w->closed || w->failed) return E_UNEXPECTED;
+    if (hash_method && FAILED(hr = hash_method_from_uri( hash_method, &hash ))) return hr;
+    /* a bundle has an application package at least */
+    for (i = 0; i < w->package_count; i++) if (!w->packages[i].resource) application = TRUE;
+    if (!application)
+    {
+        WARN( "no application package\n" );
+        return APPX_E_INVALID_MANIFEST;
+    }
+    w->hash = hash;
+    w->closed = TRUE;
+    if (!w->bundle_version) w->bundle_version = generated_version();
+    hr = build_bundle_manifest( w, &manifest );
+    if (SUCCEEDED(hr)) hr = write_file( w, L"AppxMetadata\\AppxBundleManifest.xml", (BYTE *)manifest.data, manifest.len,
+                                        APPX_COMPRESSION_OPTION_NORMAL, TRUE );
+    if (SUCCEEDED(hr)) hr = build_blockmap( w, &blockmap );
+    if (SUCCEEDED(hr)) hr = write_file( w, L"AppxBlockMap.xml", (BYTE *)blockmap.data, blockmap.len,
+                                        APPX_COMPRESSION_OPTION_NORMAL, FALSE );
+    if (SUCCEEDED(hr)) hr = add_content_type( w, L"AppxMetadata\\AppxBundleManifest.xml",
+                                              L"application/vnd.ms-appx.bundlemanifest+xml" );
+    if (SUCCEEDED(hr)) hr = add_content_type( w, L"AppxBlockMap.xml", L"application/vnd.ms-appx.blockmap+xml" );
+    if (SUCCEEDED(hr)) hr = build_content_types( w, &types );
+    if (SUCCEEDED(hr)) hr = write_file( w, L"[Content_Types].xml", (BYTE *)types.data, types.len,
+                                        APPX_COMPRESSION_OPTION_NORMAL, FALSE );
+    if (SUCCEEDED(hr)) hr = write_central_directory( w );
+    if (SUCCEEDED(hr)) IStream_Commit( w->output, STGC_DEFAULT );
+    free( manifest.data );
+    free( blockmap.data );
+    free( types.data );
+    if (FAILED(hr)) w->failed = TRUE;
+    return hr;
+}
