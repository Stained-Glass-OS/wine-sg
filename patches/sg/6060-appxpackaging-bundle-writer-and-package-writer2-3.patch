-static HRESULT WINAPI writer_Close( IAppxPackageWriter *iface, IStream *manifest )
+static IStream *mem_stream( const BYTE *data, SIZE_T size )
+{
+    IStream *stream;
+    HGLOBAL mem;
+
+    if (!(mem = GlobalAlloc( GMEM_MOVEABLE, size ? size : 1 ))) return NULL;
+    memcpy( GlobalLock( mem ), data, size );
+    GlobalUnlock( mem );
+    if (FAILED(CreateStreamOnHGlobal( mem, TRUE, &stream )))
+    {
+        GlobalFree( mem );
+        return NULL;
+    }
+    {
+        ULARGE_INTEGER len;
+        len.QuadPart = size;
+        IStream_SetSize( stream, len );
+    }
+    return stream;
+}
+
+/* a content group map is a ContentGroupMap document */
+static HRESULT check_content_group_map( const BYTE *data, SIZE_T size )
+{
+    IXmlReader *reader;
+    IStream *stream;
+    XmlNodeType type;
+    const WCHAR *name;
+    HRESULT hr;
+
+    if (!(stream = mem_stream( data, size ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = CreateXmlReader( &IID_IXmlReader, (void **)&reader, NULL )))
+    {
+        IStream_Release( stream );
+        return hr;
+    }
+    IXmlReader_SetProperty( reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit );
+    if (SUCCEEDED(hr = IXmlReader_SetInput( reader, (IUnknown *)stream )))
+    {
+        while ((hr = IXmlReader_Read( reader, &type )) == S_OK && type != XmlNodeType_Element);
+        if (hr == S_OK && SUCCEEDED(IXmlReader_GetLocalName( reader, &name, NULL )) && !wcscmp( name, L"ContentGroupMap" ))
+            while ((hr = IXmlReader_Read( reader, &type )) == S_OK);
+        else hr = E_FAIL;
+    }
+    IXmlReader_Release( reader );
+    IStream_Release( stream );
+    return hr == S_FALSE ? S_OK : APPX_E_INVALID_CONTENTGROUPMAP;
+}
