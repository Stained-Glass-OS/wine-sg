+/* the files one by one, in order; the memory limit is advice, every file being read whole anyway */
+static HRESULT WINAPI writer3_AddPayloadFiles( IAppxPackageWriter3 *iface, UINT32 count,
+                                               APPX_PACKAGE_WRITER_PAYLOAD_STREAM *files, UINT64 memory_limit )
+{
+    struct writer *w = impl_from_IAppxPackageWriter3( iface );
+    unsigned int i, j;
+    HRESULT hr;
+
+    TRACE( "iface %p, count %u, files %p, memory_limit %s.\n", iface, count, files, wine_dbgstr_longlong( memory_limit ) );
+    if (!files && count) return E_INVALIDARG;
+    if (w->closed || w->failed) return E_UNEXPECTED;
+    /* nothing is written unless every file can be */
+    for (i = 0; i < count; i++)
+    {
+        if (!files[i].fileName || !files[i].contentType || !files[i].inputStream ||
+            (unsigned int)files[i].compressionOption > APPX_COMPRESSION_OPTION_SUPERFAST ||
+            !payload_name_ok( w, files[i].fileName ))
+            return E_INVALIDARG;
+#ifndef SG_MUTANT_WRITER3_NO_PRECHECK
+        for (j = 0; j < i; j++) if (!wcsicmp( files[j].fileName, files[i].fileName )) return E_INVALIDARG;
+#endif
+    }
+    for (i = 0; i < count; i++)
+        if (FAILED(hr = writer_AddPayloadFile( &w->IAppxPackageWriter_iface, files[i].fileName, files[i].contentType,
+                                               files[i].compressionOption, files[i].inputStream )))
+            return hr;
+    (void)j;
+    return S_OK;
+}
