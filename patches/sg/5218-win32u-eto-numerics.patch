From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] win32u: ETO_NUMERICSLOCAL and ETO_NUMERICSLATIN

ExtTextOut substitutes the user's native digits (ETO_NUMERICSLOCAL) or
European digits (ETO_NUMERICSLATIN) instead of ignoring the flags. CORE:
integrator must review (patches/notes/5218.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -3728,6 +3728,8 @@
     return &tables[i];
 }
 
+static const WCHAR *nls_locale_strings;
+
 /* Based on NlsValidateLocale */
 const NLS_LOCALE_DATA *get_locale_data( LCID lcid )
 {
@@ -3765,6 +3767,7 @@
 
         locale_table = (const NLS_LOCALE_HEADER *)((char *)header + header->locales);
         lcids_index = (const NLS_LOCALE_LCID_INDEX *)((char *)locale_table + locale_table->lcids_offset);
+        nls_locale_strings = (const WCHAR *)((const char *)locale_table + locale_table->strings_offset);
     }
 
     max = locale_table->nb_lcids - 1;
@@ -5978,6 +5981,76 @@
     return width;
 }
 
+/* Stained Glass OS: ETO_NUMERICSLOCAL / ETO_NUMERICSLATIN.  The digits of the user's locale
+ * (LOCALE_SNATIVEDIGITS: the user's override in Control Panel\\International, else the locale's) */
+static BOOL get_user_native_digits( WCHAR digits[10] )
+{
+    char buffer[128];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    const NLS_LOCALE_DATA *locale;
+    LCID lcid;
+    HKEY key;
+
+    if ((key = reg_open_hkcu_key( "Control Panel\\International" )))
+    {
+        ULONG len = query_reg_ascii_value( key, "sNativeDigits", info, sizeof(buffer) );
+        NtClose( key );
+        if (len && info->Type == REG_SZ && info->DataLength >= 10 * sizeof(WCHAR))
+        {
+            memcpy( digits, info->Data, 10 * sizeof(WCHAR) );
+            return TRUE;
+        }
+    }
+    if (NtQueryDefaultLocale( TRUE, &lcid ) || !(locale = get_locale_data( lcid )) || !nls_locale_strings) return FALSE;
+    {
+        const WCHAR *array = nls_locale_strings + locale->snativedigits;
+        const DWORD *pos = (const DWORD *)(array + 1);
+        unsigned int i;
+
+        if (array[0] != 10) return FALSE;
+        for (i = 0; i < 10; i++)
+        {
+            if (nls_locale_strings[pos[i]] != 1) return FALSE;
+            digits[i] = nls_locale_strings[pos[i] + 1];
+        }
+    }
+    return TRUE;
+}
+
+/* the text with its digits as the flags ask: ETO_NUMERICSLOCAL the user's own, ETO_NUMERICSLATIN
+ * European (0-9); NULL when nothing changes (or no memory) */
+static WCHAR *substitute_digits( const WCHAR *str, UINT count, UINT flags )
+{
+    WCHAR native[10], *ret;
+    BOOL have_native = get_user_native_digits( native );
+    BOOL changed = FALSE;
+    UINT i, d;
+
+    if (!count || (flags & ETO_GLYPH_INDEX)) return NULL;
+    if (!(ret = malloc( count * sizeof(WCHAR) ))) return NULL;
+    for (i = 0; i < count; i++)
+    {
+        WCHAR c = str[i];
+
+        ret[i] = c;
+        if ((flags & ETO_NUMERICSLOCAL) && have_native && c >= '0' && c <= '9')
+            ret[i] = native[c - '0'];
+        else if (flags & ETO_NUMERICSLATIN)
+        {
+            if (c >= 0x660 && c <= 0x669) ret[i] = '0' + c - 0x660;           /* Arabic-Indic */
+            else if (c >= 0x6f0 && c <= 0x6f9) ret[i] = '0' + c - 0x6f0;      /* Extended Arabic-Indic */
+            else if (have_native && c > '9')
+                for (d = 0; d < 10; d++) if (native[d] == c) { ret[i] = '0' + d; break; }
+        }
+#ifdef SG_MUTANT_ETO_NODIGITS
+        ret[i] = c;
+#endif
+        if (ret[i] != c) changed = TRUE;
+    }
+    if (!changed) { free( ret ); return NULL; }
+    return ret;
+}
+
 /***********************************************************************
  *           NtGdiExtTextOutW    (win32u.@)
  *
@@ -6025,7 +6098,7 @@
     DC * dc = get_dc_ptr( hdc );
     PHYSDEV physdev;
     INT breakRem;
-    static int quietfixme = 0;
+    WCHAR *digits_str = NULL;
 
     if (!dc) return FALSE;
     if (count > INT_MAX) return FALSE;
@@ -6034,10 +6107,9 @@
     breakRem = dc->breakRem;
     layout = dc->attr->layout;
 
-    if (quietfixme == 0 && flags & (ETO_NUMERICSLOCAL | ETO_NUMERICSLATIN))
+    if (flags & (ETO_NUMERICSLOCAL | ETO_NUMERICSLATIN))
     {
-        FIXME("flags ETO_NUMERICSLOCAL | ETO_NUMERICSLATIN unimplemented\n");
-        quietfixme = 1;
+        if ((digits_str = substitute_digits( str, count, flags ))) str = digits_str;
     }
 
     update_dc( dc );
@@ -6350,6 +6422,7 @@
         NtGdiDeleteObjectApp( hbrush );
     }
 
+    free( digits_str );
     release_dc_ptr( dc );
 
     return ret;
