From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: a user's Software\Classes redirected for 32-bit programs as on Windows

Wine had no Wow6432Node in a user's Software\Classes, so a 32-bit program's per-user COM registration went to the 64-bit key: OneDrive's i386 FileSyncShell.dll replaced its 64-bit overlay handlers and Explorer could load none. As on Windows 7 and later, a user's Software\Classes\Wow6432Node now exists and is shared like the machine's: CLSID, DirectShow, Interface, Media Type and MediaFoundation have keys of their own for 32-bit programs and everything else is one key for both. In a hive from before, the 32-bit keys start as a copy of the 64-bit ones, so 32-bit programs keep finding what they registered.
---
diff --git a/server/registry.c b/server/registry.c
index eda7514..bae1933 100644
--- a/server/registry.c
+++ b/server/registry.c
@@ -2422,6 +2422,8 @@ static void init_supported_machines(void)
 static uid_t sg_loaded_uids[SG_MAX_USER_HIVES];
 static unsigned int sg_loaded_uid_count;
 
+static void sg_user_classes_wow( struct key *user );
+
 void sg_ensure_user_hive( uid_t uid )
 {
     const struct sid *sid;
@@ -2447,6 +2449,7 @@ void sg_ensure_user_hive( uid_t uid )
 
     if ((key = open_key( root_key, &path, 0, 0 )))   /* already there */
     {
+        sg_user_classes_wow( key );
         release_object( key );
         free( path_str );
         sg_loaded_uids[sg_loaded_uid_count++] = uid;
@@ -2492,6 +2495,7 @@ void sg_ensure_user_hive( uid_t uid )
             }
         }
         load_init_registry_from_file( filename, key );
+        sg_user_classes_wow( key );
         sg_loaded_uids[sg_loaded_uid_count++] = uid;
         sg_uid_hive_loaded( uid );
     }
@@ -2500,6 +2504,94 @@ void sg_ensure_user_hive( uid_t uid )
     free( path_str );
 }
 
+/* Stained Glass OS 6248: copy a key's values and subkeys (not links) below another key */
+static void sg_copy_key_tree( struct key *dst, const struct key *src, int depth )
+{
+    struct unicode_str name;
+    struct key *sub;
+    int i;
+
+    if (depth > 64) return;
+    for (i = 0; i <= src->last_value; i++)
+    {
+        const struct key_value *value = &src->values[i];
+        name.str = value->name;
+        name.len = value->namelen;
+        set_value( dst, &name, value->type, value->data, value->len );
+        clear_error();
+    }
+    for (i = 0; i <= src->last_subkey; i++)
+    {
+        const struct key *child = src->subkeys[i];
+        if (child->flags & (KEY_SYMLINK | KEY_DELETED | KEY_VOLATILE)) continue;
+        name.str = child->obj.name->name;
+        name.len = child->obj.name->len;
+        if (!(sub = create_key_object( &dst->obj, &name, OBJ_OPENIF, 0, child->modif, NULL ))) { clear_error(); continue; }
+        sg_copy_key_tree( sub, child, depth + 1 );
+        release_object( sub );
+    }
+}
+
+/* Stained Glass OS 6248: a user's Software\Classes as on Windows 7 and later. Its
+ * Wow6432Node is shared like the machine's: of the classes only CLSID, DirectShow,
+ * Interface, Media Type and MediaFoundation have keys of their own for 32-bit programs,
+ * everything else (file types, ProgIDs, AppID, TypeLib) is one key for both views.
+ * Wine made no Wow6432Node in a user's hive, so a 32-bit registration of a per-user
+ * COM server landed on the 64-bit one: OneDrive's i386 FileSyncShell.dll in the 64-bit
+ * CLSID key, and Explorer could load none of its overlay handlers (qa4 2026-11-04). */
+static void sg_user_classes_wow( struct key *user )
+{
+    static const WCHAR classes_i386[] = {'S','o','f','t','w','a','r','e','\\','C','l','a','s','s','e','s','\\',
+                                         'W','o','w','6','4','3','2','N','o','d','e'};
+    static const WCHAR classes_arm[] = {'S','o','f','t','w','a','r','e','\\','C','l','a','s','s','e','s','\\',
+                                        'W','o','w','A','A','3','2','N','o','d','e'};
+    static const WCHAR clsidW[] = {'C','L','S','I','D'};
+    static const WCHAR directshowW[] = {'D','i','r','e','c','t','S','h','o','w'};
+    static const WCHAR interfaceW[] = {'I','n','t','e','r','f','a','c','e'};
+    static const WCHAR mediatypeW[] = {'M','e','d','i','a',' ','T','y','p','e'};
+    static const WCHAR mediafoundationW[] = {'M','e','d','i','a','F','o','u','n','d','a','t','i','o','n'};
+    static const struct unicode_str redirected[] =
+    {
+        { clsidW, sizeof(clsidW) }, { directshowW, sizeof(directshowW) }, { interfaceW, sizeof(interfaceW) },
+        { mediatypeW, sizeof(mediatypeW) }, { mediafoundationW, sizeof(mediafoundationW) },
+    };
+    struct unicode_str name;
+    struct key *node, *key, *classes;
+    unsigned int i, j;
+
+#ifdef SG_MUTANT_NO_USER_CLASSES_WOW
+    return;
+#endif
+    if (!user) return;
+    for (i = 1; i < supported_machines_count; i++)
+    {
+        switch (supported_machines[i])
+        {
+        case IMAGE_FILE_MACHINE_I386:  name.str = classes_i386; name.len = sizeof(classes_i386); break;
+        case IMAGE_FILE_MACHINE_ARMNT: name.str = classes_arm;  name.len = sizeof(classes_arm);  break;
+        default: continue;
+        }
+        if (!(node = create_key_recursive( user, &name, current_time ))) { clear_error(); continue; }
+        node->flags |= KEY_WOWSHARE;
+        classes = get_parent( node );
+        for (j = 0; j < ARRAY_SIZE(redirected); j++)
+        {
+            int index, existed = find_subkey( node, &redirected[j], &index ) != NULL;
+            struct key *old = existed ? NULL : find_subkey( classes, &redirected[j], &index );
+
+            if (!(key = create_key_recursive( node, &redirected[j], current_time ))) { clear_error(); continue; }
+            /* a hive from before: what 32-bit programs registered went to the 64-bit key,
+             * so the 32-bit view starts as a copy of it -- they keep finding their servers
+             * and interfaces, and their next registration goes to their own key */
+#ifndef SG_MUTANT_NO_CLASSES_MIGRATE
+            if (old) sg_copy_key_tree( key, old, 0 );
+#endif
+            release_object( key );
+        }
+        release_object( node );
+    }
+}
+
 /* registry initialisation */
 void init_registry(void)
 {
@@ -2593,6 +2685,7 @@ void init_registry(void)
         fatal_error( "could not create HKEY_CURRENT_USER registry key\n" );
     free( current_user_path );
     load_init_registry_from_file( "user.reg", hkcu );
+    sg_user_classes_wow( hkcu );
 
     /* set the shared flag on Software\Classes\Wow6432Node for all platforms */
     for (i = 1; i < supported_machines_count; i++)
