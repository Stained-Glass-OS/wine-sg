+/* Stained Glass OS: printer change notifications. A notification is an
+ * event the caller waits on; a thread watches the spool directory (a job's
+ * spool file appears, is written and goes, from any process) and the print
+ * registry keys (printers, forms, drivers and print processors, ports), and
+ * sets the event with what changed. */
+struct printer_notify
+{
+    struct list entry;
+    HANDLE event;        /* what the caller waits on */
+    HANDLE stop;
+    HANDLE thread;
+    DWORD filter;        /* PRINTER_CHANGE_* asked for */
+    LONG changes;        /* PRINTER_CHANGE_* seen since the last FindNext */
+    BOOL want_info;      /* notify options were given */
+    /* what the thread watches, armed before FindFirst returns */
+    HANDLE waits[6];     /* stop, spool directory, the keys */
+    HANDLE dir;
+    OVERLAPPED ovl;
+    HKEY keys[4];
+    DWORD counts[4];
+    DWORD buffer[1024];
+};
+
+static struct list printer_notifies = LIST_INIT( printer_notifies );
+static CRITICAL_SECTION printer_notify_cs;
+static CRITICAL_SECTION_DEBUG printer_notify_cs_debug =
+{
+    0, 0, &printer_notify_cs,
+    { &printer_notify_cs_debug.ProcessLocksList, &printer_notify_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": printer_notify_cs") }
+};
+static CRITICAL_SECTION printer_notify_cs = { &printer_notify_cs_debug, -1, 0, 0, 0, 0 };
+
+static const struct
+{
+    const WCHAR *path;
+    DWORD add, set, del;   /* PRINTER_CHANGE_* for more, the same, fewer entries */
+    BOOL values;           /* entries are values, not subkeys */
+}
+notify_keys[] =
+{
+    { L"System\\CurrentControlSet\\Control\\Print\\Printers",
+      PRINTER_CHANGE_ADD_PRINTER, PRINTER_CHANGE_SET_PRINTER, PRINTER_CHANGE_DELETE_PRINTER, FALSE },
+    { L"System\\CurrentControlSet\\Control\\Print\\Forms",
+      PRINTER_CHANGE_ADD_FORM, PRINTER_CHANGE_SET_FORM, PRINTER_CHANGE_DELETE_FORM, TRUE },
+    { L"System\\CurrentControlSet\\Control\\Print\\Environments",
+      PRINTER_CHANGE_ADD_PRINTER_DRIVER, PRINTER_CHANGE_SET_PRINTER_DRIVER, PRINTER_CHANGE_DELETE_PRINTER_DRIVER, FALSE },
+    { L"System\\CurrentControlSet\\Control\\Print\\Monitors",
+      PRINTER_CHANGE_ADD_PORT, PRINTER_CHANGE_CONFIGURE_PORT, PRINTER_CHANGE_DELETE_PORT, FALSE },
+};
+
+static DWORD notify_key_count( HKEY key, BOOL values )
+{
+    DWORD subkeys = 0, num_values = 0;
+
+    RegQueryInfoKeyW( key, NULL, NULL, NULL, &subkeys, NULL, NULL, &num_values, NULL, NULL, NULL, NULL );
+    return values ? num_values : subkeys;
+}
+
+static void printer_notify_add( struct printer_notify *notify, DWORD changes )
+{
+    if (!(changes &= notify->filter)) return;
+    InterlockedOr( &notify->changes, changes );
+    SetEvent( notify->event );
+}
+
+static void printer_notify_read_dir( struct printer_notify *notify )
+{
+    if (notify->dir == INVALID_HANDLE_VALUE) return;
+    ResetEvent( notify->ovl.hEvent );
+    ReadDirectoryChangesW( notify->dir, notify->buffer, sizeof(notify->buffer), FALSE, FILE_NOTIFY_CHANGE_FILE_NAME |
+                           FILE_NOTIFY_CHANGE_LAST_WRITE | FILE_NOTIFY_CHANGE_SIZE, NULL, &notify->ovl, NULL );
+}
+
+/* everything watched is armed before FindFirst returns: a change made
+ * right after it is not missed */
+static void printer_notify_arm( struct printer_notify *notify )
+{
+    WCHAR path[MAX_PATH];
+    DWORD i, n;
+
+    C_ASSERT( ARRAY_SIZE(notify_keys) == ARRAY_SIZE(((struct printer_notify *)0)->keys) );
+    notify->waits[0] = notify->stop;
+    notify->waits[1] = notify->ovl.hEvent = CreateEventW( NULL, TRUE, FALSE, NULL );
+    n = GetSystemDirectoryW( path, MAX_PATH );
+    lstrcpynW( path + n, L"\\spool\\PRINTERS", MAX_PATH - n );
+    CreateDirectoryW( path, NULL );
+    notify->dir = CreateFileW( path, FILE_LIST_DIRECTORY, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                               NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OVERLAPPED, NULL );
+    for (i = 0; i < ARRAY_SIZE(notify_keys); i++)
+    {
+        notify->keys[i] = NULL;
+        notify->waits[2 + i] = CreateEventW( NULL, FALSE, FALSE, NULL );
+        if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, notify_keys[i].path, 0, NULL, 0, KEY_NOTIFY | KEY_QUERY_VALUE,
+                             NULL, &notify->keys[i], NULL ) &&
+            RegOpenKeyExW( HKEY_LOCAL_MACHINE, notify_keys[i].path, 0, KEY_NOTIFY | KEY_QUERY_VALUE, &notify->keys[i] ))
+            notify->keys[i] = NULL;
+        notify->counts[i] = notify->keys[i] ? notify_key_count( notify->keys[i], notify_keys[i].values ) : 0;
+        if (notify->keys[i])
+            RegNotifyChangeKeyValue( notify->keys[i], TRUE, REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET,
+                                     notify->waits[2 + i], TRUE );
+    }
+    printer_notify_read_dir( notify );
+}
+
+static void printer_notify_disarm( struct printer_notify *notify )
+{
+    DWORD i, got;
+
+    if (notify->dir != INVALID_HANDLE_VALUE)
+    {
+        CancelIoEx( notify->dir, &notify->ovl );
+        GetOverlappedResult( notify->dir, &notify->ovl, &got, TRUE );
+        CloseHandle( notify->dir );
+    }
+    if (notify->ovl.hEvent) CloseHandle( notify->ovl.hEvent );
+    for (i = 0; i < ARRAY_SIZE(notify_keys); i++)
+    {
+        if (notify->keys[i]) RegCloseKey( notify->keys[i] );
+        if (notify->waits[2 + i]) CloseHandle( notify->waits[2 + i] );
+    }
+}
+
+static DWORD WINAPI printer_notify_thread( void *arg )
+{
+    struct printer_notify *notify = arg;
+    DWORD i, ret, got;
+
+    for (;;)
+    {
+        ret = WaitForMultipleObjects( ARRAY_SIZE(notify->waits), notify->waits, FALSE, INFINITE );
+        if (ret == WAIT_OBJECT_0 || ret == WAIT_FAILED) break;
+        if (ret == WAIT_OBJECT_0 + 1)
+        {
+            /* the spool files: a job added, written or deleted */
+            if (GetOverlappedResult( notify->dir, &notify->ovl, &got, FALSE ) && got)
+            {
+                FILE_NOTIFY_INFORMATION *info = (FILE_NOTIFY_INFORMATION *)notify->buffer;
+                DWORD changes = 0;
+
+                for (;;)
+                {
+                    if (info->Action == FILE_ACTION_ADDED || info->Action == FILE_ACTION_RENAMED_NEW_NAME)
+                        changes |= PRINTER_CHANGE_ADD_JOB;
+                    else if (info->Action == FILE_ACTION_REMOVED || info->Action == FILE_ACTION_RENAMED_OLD_NAME)
+                        changes |= PRINTER_CHANGE_DELETE_JOB;
+                    else changes |= PRINTER_CHANGE_WRITE_JOB | PRINTER_CHANGE_SET_JOB;
+                    if (!info->NextEntryOffset) break;
+                    info = (FILE_NOTIFY_INFORMATION *)((char *)info + info->NextEntryOffset);
+                }
+                printer_notify_add( notify, changes );
+            }
+            else printer_notify_add( notify, PRINTER_CHANGE_JOB );  /* too many to list */
+            printer_notify_read_dir( notify );
+            continue;
+        }
+        i = ret - WAIT_OBJECT_0 - 2;
+        if (i < ARRAY_SIZE(notify_keys) && notify->keys[i])
+        {
+            DWORD count = notify_key_count( notify->keys[i], notify_keys[i].values );
+
+            printer_notify_add( notify, count > notify->counts[i] ? notify_keys[i].add :
+                                        count < notify->counts[i] ? notify_keys[i].del : notify_keys[i].set );
+            notify->counts[i] = count;
+            RegNotifyChangeKeyValue( notify->keys[i], TRUE, REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET,
+                                     notify->waits[2 + i], TRUE );
+        }
+    }
+    return 0;
+}
+
+static struct printer_notify *find_printer_notify( HANDLE handle )
+{
+    struct printer_notify *notify;
+
+    LIST_FOR_EACH_ENTRY( notify, &printer_notifies, struct printer_notify, entry )
+        if (notify->event == handle) return notify;
+    return NULL;
+}
+
 /*****************************************************************************
  *          FindClosePrinterChangeNotification [WINSPOOL.@]
  *
  */
 BOOL WINAPI FindClosePrinterChangeNotification( HANDLE hChange )
 {
-    FIXME("Stub: %p\n", hChange);
+    struct printer_notify *notify;
+
+    TRACE("%p\n", hChange);
+
+    EnterCriticalSection( &printer_notify_cs );
+    if ((notify = find_printer_notify( hChange ))) list_remove( &notify->entry );
+    LeaveCriticalSection( &printer_notify_cs );
+    if (!notify)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    SetEvent( notify->stop );
+    WaitForSingleObject( notify->thread, INFINITE );
+    CloseHandle( notify->thread );
+    printer_notify_disarm( notify );
+    CloseHandle( notify->stop );
+    CloseHandle( notify->event );
+    free( notify );
     return TRUE;
 }
 
