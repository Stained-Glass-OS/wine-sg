+/* the forms programs added, in the order they were added */
+struct user_form_entry
+{
+    WCHAR name[CCHFORMNAME + 1];
+    struct user_form form;
+};
+
+static DWORD get_user_forms( struct user_form_entry **ret )
+{
+    DWORD count = 0, i, n = 0, name_len, size, type;
+    struct user_form_entry *forms, tmp;
+    HKEY key;
+
+    *ret = NULL;
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, forms_key_path, 0, KEY_QUERY_VALUE, &key )) return 0;
+    RegQueryInfoKeyW( key, NULL, NULL, NULL, NULL, NULL, NULL, &count, NULL, NULL, NULL, NULL );
+    if (!count || !(forms = malloc( count * sizeof(*forms) )))
+    {
+        RegCloseKey( key );
+        return 0;
+    }
+    for (i = 0; i < count; i++)
+    {
+        name_len = ARRAY_SIZE(forms[n].name);
+        size = sizeof(forms[n].form);
+        if (RegEnumValueW( key, i, forms[n].name, &name_len, NULL, &type, (BYTE *)&forms[n].form, &size )) break;
+        if (type == REG_BINARY && size == sizeof(forms[n].form)) n++;
+    }
+    RegCloseKey( key );
+    /* by ordinal: the order they were added */
+    for (i = 1; i < n; i++)
+    {
+        DWORD j = i;
+        tmp = forms[i];
+        while (j && forms[j - 1].form.ordinal > tmp.form.ordinal) { forms[j] = forms[j - 1]; j--; }
+        forms[j] = tmp;
+    }
+    *ret = forms;
+    return n;
 }
 
