+/* Stained Glass OS: forms programs add (AddForm) are kept, as on Windows,
+ * as values of the Forms key: the size, the imageable area, an ordinal and
+ * flags */
+static const WCHAR forms_key_path[] = L"System\\CurrentControlSet\\Control\\Print\\Forms";
+
+struct user_form
+{
+    SIZEL size;
+    RECTL area;
+    DWORD ordinal;
+    DWORD flags;
+};
+
+static const struct builtin_form *find_builtin_form( const WCHAR *name )
+{
+    DWORD i;
+
+    for (i = 0; i < ARRAY_SIZE(builtin_forms); i++)
+        if (!wcscmp( name, builtin_forms[i].name )) return builtin_forms + i;
+    return NULL;
+}
+
+static BOOL get_user_form( const WCHAR *name, struct user_form *form )
+{
+    DWORD size = sizeof(*form), type;
+    HKEY key;
+    LONG ret;
+
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, forms_key_path, 0, KEY_QUERY_VALUE, &key )) return FALSE;
+    ret = RegQueryValueExW( key, name, NULL, &type, (BYTE *)form, &size );
+    RegCloseKey( key );
+    return !ret && type == REG_BINARY && size == sizeof(*form);
+}
+
+static void fill_user_form_info( BYTE **base, WCHAR **strings, const WCHAR *name, const struct user_form *form,
+                                 DWORD level, DWORD size, DWORD *used )
+{
+    FORM_INFO_2W *info = *(FORM_INFO_2W**)base;
+    DWORD name_len = wcslen( name ) + 1, keyword_len = 0, total_size;
+
+    total_size = name_len * sizeof(WCHAR);
+    if (level > 1)
+    {
+        keyword_len = WideCharToMultiByte( CP_ACP, 0, name, -1, NULL, 0, NULL, NULL );
+        keyword_len = (keyword_len + 1) & ~1;
+        total_size += keyword_len;
+    }
+
+    if (*used + total_size <= size)
+    {
+        info->Flags = FORM_USER;
+        info->pName = memcpy( *strings, name, name_len * sizeof(WCHAR) );
+        *strings += name_len;
+        info->Size = form->size;
+        info->ImageableArea = form->area;
+        if (level > 1)
+        {
+            info->pKeyword = (char *)*strings;
+            WideCharToMultiByte( CP_ACP, 0, name, -1, (char *)info->pKeyword, keyword_len, NULL, NULL );
+            *strings += keyword_len / sizeof(WCHAR);
+            info->StringType = STRING_NONE;
+            info->pMuiDll = NULL;
+            info->dwResourceId = 0;
+            info->pDisplayName = NULL;
+            info->wLangId = 0;
+        }
+    }
+
+    *base += form_struct_size( level );
+    *used += total_size;
+}
+
+static BOOL check_form_info( DWORD level, const FORM_INFO_1W *info )
+{
+    if (level != 1 && level != 2)
+    {
+        SetLastError( ERROR_INVALID_LEVEL );
+        return FALSE;
+    }
+    if (!info || !info->pName || !info->pName[0] || info->Size.cx <= 0 || info->Size.cy <= 0 ||
+        info->ImageableArea.left < 0 || info->ImageableArea.top < 0 ||
+        info->ImageableArea.right > info->Size.cx || info->ImageableArea.bottom > info->Size.cy ||
+        info->ImageableArea.left >= info->ImageableArea.right || info->ImageableArea.top >= info->ImageableArea.bottom)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL write_user_form( const WCHAR *name, const struct user_form *form, BOOL create )
+{
+    DWORD count = 0;
+    HKEY key;
+    LONG ret;
+
+    if ((ret = RegCreateKeyExW( HKEY_LOCAL_MACHINE, forms_key_path, 0, NULL, 0,
+                                KEY_SET_VALUE | KEY_QUERY_VALUE, NULL, &key, NULL )))
+    {
+        SetLastError( ret );
+        return FALSE;
+    }
+    {
+        struct user_form copy = *form;
+
+        /* a new form comes after the built-in ones and those added before it */
+        if (create)
+        {
+            RegQueryInfoKeyW( key, NULL, NULL, NULL, NULL, NULL, NULL, &count, NULL, NULL, NULL, NULL );
+            copy.ordinal = ARRAY_SIZE(builtin_forms) + count + 1;
+        }
+        ret = RegSetValueExW( key, name, 0, REG_BINARY, (const BYTE *)&copy, sizeof(copy) );
+    }
+    RegCloseKey( key );
+    if (ret) SetLastError( ret );
+    return !ret;
+}
