From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui: UISettings events reach a handler that is not agile in its own apartment

UISettings raised its Changed events on its watcher thread for every handler. A handler that is not agile (a WRL callback, not free-threaded) is called, as COM would marshal it, in the single-threaded apartment that registered it; Firefox's handlers touch its main thread's state and assert they run there, so turning dark mode on or off (or any colour, scaling or transparency change) while Firefox ran crashed it. There are no proxies for these delegates, so the apartment gets the call through a message-only window of its thread, as toasts do; agile handlers are still called on the watcher's thread.
---
--- a/dlls/windows.ui/uisettings.c
+++ b/dlls/windows.ui/uisettings.c
@@ -82,6 +82,7 @@
     EventRegistrationToken token;
     struct uisettings *sender;
     ITypedEventHandler_UISettings_IInspectable *handler;  /* every handler type has this layout */
+    HWND apartment;   /* (wine-sg 8290) the single-threaded apartment a handler that is not agile lives in */
 };
 
 static CRITICAL_SECTION events_cs;
@@ -631,6 +632,76 @@
     return &args->IInspectable_iface;
 }
 
+/* (wine-sg 8290) A handler that is not agile is called in the apartment that registered it, as COM would
+ * marshal the call; an agile one on the watcher's thread.  Firefox's handlers (WRL callbacks, not agile)
+ * touch its main thread's state and assert they run there: a settings change while it started crashed it.
+ * There are no proxies for these delegates, so a single-threaded apartment gets the call through a
+ * message-only window of its thread, as toasts do. */
+#define WM_UISETTINGS_INVOKE (WM_APP + 4)
+
+struct invocation
+{
+    enum ui_event kind;
+    ITypedEventHandler_UISettings_IInspectable *handler;
+    struct uisettings *sender;
+};
+
+static void invoke( struct invocation *call )
+{
+    IInspectable *args = create_changed_args( call->kind );
+
+    TRACE( "raising event %d, handler %p, thread %04lx\n", call->kind, call->handler, GetCurrentThreadId() );
+    ITypedEventHandler_UISettings_IInspectable_Invoke( call->handler, &call->sender->IUISettings_iface, args );
+    if (args) IInspectable_Release( args );
+    ITypedEventHandler_UISettings_IInspectable_Release( call->handler );
+    IUISettings_Release( &call->sender->IUISettings_iface );
+    free( call );
+}
+
+static LRESULT CALLBACK apartment_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (msg == WM_UISETTINGS_INVOKE)
+    {
+        invoke( (struct invocation *)lparam );
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static HWND apartment_window( IUnknown *handler )
+{
+    static const WCHAR class_name[] = L"WineUISettingsApartment";
+    static ATOM atom;
+    APTTYPEQUALIFIER qualifier;
+    APTTYPE type;
+    IUnknown *agile;
+    HWND hwnd = NULL;
+
+#ifdef SG_MUTANT_UISETTINGS_ANY_THREAD
+    return NULL;
+#endif
+    if (SUCCEEDED(IUnknown_QueryInterface( handler, &IID_IAgileObject, (void **)&agile )))
+    {
+        IUnknown_Release( agile );
+        return NULL;
+    }
+    if (FAILED(CoGetApartmentType( &type, &qualifier )) || (type != APTTYPE_STA && type != APTTYPE_MAINSTA)) return NULL;
+
+    /* one window per thread, found by its class among the thread's windows */
+    while ((hwnd = FindWindowExW( HWND_MESSAGE, hwnd, class_name, NULL )))
+        if (GetWindowThreadProcessId( hwnd, NULL ) == GetCurrentThreadId()) return hwnd;
+
+    if (!atom)
+    {
+        WNDCLASSW class = {0};
+        GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, (const WCHAR *)apartment_wndproc, &class.hInstance );
+        class.lpfnWndProc = apartment_wndproc;
+        class.lpszClassName = class_name;
+        atom = RegisterClassW( &class );
+    }
+    return CreateWindowExW( 0, class_name, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, NULL, NULL );
+}
+
 static void notify_handlers( enum ui_event kind )
 {
     struct handler_entry *entry, **copies = NULL;
@@ -655,12 +726,20 @@
 
     for (i = 0; i < count; i++)
     {
-        IInspectable *args = create_changed_args( kind );
-        TRACE( "raising event %d, handler %p\n", kind, copies[i]->handler );
-        ITypedEventHandler_UISettings_IInspectable_Invoke( copies[i]->handler, &copies[i]->sender->IUISettings_iface, args );
-        if (args) IInspectable_Release( args );
-        ITypedEventHandler_UISettings_IInspectable_Release( copies[i]->handler );
-        IUISettings_Release( &copies[i]->sender->IUISettings_iface );
+        struct invocation *call;
+
+        if (!(call = malloc( sizeof(*call) )))
+        {
+            ITypedEventHandler_UISettings_IInspectable_Release( copies[i]->handler );
+            IUISettings_Release( &copies[i]->sender->IUISettings_iface );
+            free( copies[i] );
+            continue;
+        }
+        call->kind = kind;
+        call->handler = copies[i]->handler;     /* the references taken above go with the call */
+        call->sender = copies[i]->sender;
+        if (!copies[i]->apartment || !PostMessageW( copies[i]->apartment, WM_UISETTINGS_INVOKE, 0, (LPARAM)call ))
+            invoke( call );
         free( copies[i] );
     }
     free( copies );
@@ -792,6 +871,7 @@
     ITypedEventHandler_UISettings_IInspectable_AddRef( entry->handler );
     entry->sender = impl;
     IUISettings_AddRef( &impl->IUISettings_iface );
+    entry->apartment = apartment_window( (IUnknown *)handler );
 
     EnterCriticalSection( &events_cs );
     entry->token.value = ++next_token;
