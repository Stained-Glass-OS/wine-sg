From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] services, sechost, advapi32: EnumDependentServices lists the dependents

EnumDependentServicesA/W were stubs that said no service depended on any
other, and the service control manager's svcctl_EnumDependentServicesW
was not implemented. Installers, updaters and service managers stop a
service's dependents before it, from that list; QueryServiceLockStatusA/W
failed.

The control manager walks its database: the services that depend on the
service by name or on its load order group, and theirs in turn, each once
and the furthest first -- the order they are stopped in -- filtered by
state, packed as the other enumerations are. sechost turns the offsets
into pointers; EnumDependentServicesA makes the strings narrow. The lock
status says what Windows has said since Vista: never locked, no owner.

Wine's advapi32 service tests: no failures, as before.

Gate: test/svcdepend-gate.sh. Mutant SG_MUTANT_NO_DEPENDENT_SERVICES
(sechost/service.c).
---
--- a/dlls/advapi32/service.c
+++ b/dlls/advapi32/service.c
@@ -333,9 +333,31 @@ BOOL WINAPI QueryServiceLockStatusA( SC_HANDLE hSCManager,
                                      LPQUERY_SERVICE_LOCK_STATUSA lpLockStatus,
                                      DWORD cbBufSize, LPDWORD pcbBytesNeeded)
 {
-    FIXME("%p %p %08lx %p\n", hSCManager, lpLockStatus, cbBufSize, pcbBytesNeeded);
+    /* the database is never locked (as on Windows since Vista): unlocked,
+     * no owner */
+    TRACE("%p %p %08lx %p\n", hSCManager, lpLockStatus, cbBufSize, pcbBytesNeeded);
 
-    return FALSE;
+    if (!hSCManager)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    if (!pcbBytesNeeded)
+    {
+        SetLastError( ERROR_INVALID_ADDRESS );
+        return FALSE;
+    }
+    *pcbBytesNeeded = sizeof(*lpLockStatus) + 1;
+    if (!lpLockStatus || cbBufSize < *pcbBytesNeeded)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    lpLockStatus->fIsLocked = FALSE;
+    lpLockStatus->lpLockOwner = (char *)(lpLockStatus + 1);
+    lpLockStatus->lpLockOwner[0] = 0;
+    lpLockStatus->dwLockDuration = 0;
+    return TRUE;
 }
 
 /******************************************************************************
@@ -345,9 +367,29 @@ BOOL WINAPI QueryServiceLockStatusW( SC_HANDLE hSCManager,
                                      LPQUERY_SERVICE_LOCK_STATUSW lpLockStatus,
                                      DWORD cbBufSize, LPDWORD pcbBytesNeeded)
 {
-    FIXME("%p %p %08lx %p\n", hSCManager, lpLockStatus, cbBufSize, pcbBytesNeeded);
+    TRACE("%p %p %08lx %p\n", hSCManager, lpLockStatus, cbBufSize, pcbBytesNeeded);
 
-    return FALSE;
+    if (!hSCManager)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    if (!pcbBytesNeeded)
+    {
+        SetLastError( ERROR_INVALID_ADDRESS );
+        return FALSE;
+    }
+    *pcbBytesNeeded = sizeof(*lpLockStatus) + sizeof(WCHAR);
+    if (!lpLockStatus || cbBufSize < *pcbBytesNeeded)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    lpLockStatus->fIsLocked = FALSE;
+    lpLockStatus->lpLockOwner = (WCHAR *)(lpLockStatus + 1);
+    lpLockStatus->lpLockOwner[0] = 0;
+    lpLockStatus->dwLockDuration = 0;
+    return TRUE;
 }
 
 /******************************************************************************
@@ -417,9 +459,56 @@ BOOL WINAPI EnumDependentServicesA( SC_HANDLE hService, DWORD dwServiceState,
                                     LPENUM_SERVICE_STATUSA lpServices, DWORD cbBufSize,
         LPDWORD pcbBytesNeeded, LPDWORD lpServicesReturned )
 {
-    FIXME("%p 0x%08lx %p 0x%08lx %p %p - stub\n", hService, dwServiceState,
+    ENUM_SERVICE_STATUSW *servicesW;
+    DWORD sz, n, i;
+    BOOL ret;
+    char *p;
+
+    TRACE("%p 0x%08lx %p 0x%08lx %p %p\n", hService, dwServiceState,
           lpServices, cbBufSize, pcbBytesNeeded, lpServicesReturned);
 
+    if (!pcbBytesNeeded || !lpServicesReturned)
+    {
+        SetLastError( ERROR_INVALID_ADDRESS );
+        return FALSE;
+    }
+    /* the wide list, its strings made narrow after the structures */
+    sz = max( 2 * cbBufSize, sizeof(*servicesW) );
+    if (!(servicesW = malloc( sz )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    ret = EnumDependentServicesW( hService, dwServiceState, servicesW, sz, pcbBytesNeeded, lpServicesReturned );
+    if (!ret) goto done;
+    p = (char *)lpServices + *lpServicesReturned * sizeof(ENUM_SERVICE_STATUSA);
+    n = cbBufSize > *lpServicesReturned * sizeof(ENUM_SERVICE_STATUSA) ?
+        cbBufSize - *lpServicesReturned * sizeof(ENUM_SERVICE_STATUSA) : 0;
+    ret = FALSE;
+    for (i = 0; i < *lpServicesReturned; i++)
+    {
+        if (!(sz = WideCharToMultiByte( CP_ACP, 0, servicesW[i].lpServiceName, -1, p, n, NULL, NULL ))) goto toosmall;
+        lpServices[i].lpServiceName = p;
+        p += sz;
+        n -= sz;
+        if (servicesW[i].lpDisplayName)
+        {
+            if (!(sz = WideCharToMultiByte( CP_ACP, 0, servicesW[i].lpDisplayName, -1, p, n, NULL, NULL ))) goto toosmall;
+            lpServices[i].lpDisplayName = p;
+            p += sz;
+            n -= sz;
+        }
+        else lpServices[i].lpDisplayName = NULL;
+        lpServices[i].ServiceStatus = servicesW[i].ServiceStatus;
+    }
+    ret = TRUE;
+    goto done;
+
+toosmall:
+    *pcbBytesNeeded = 2 * cbBufSize + sizeof(ENUM_SERVICE_STATUSA);
     *lpServicesReturned = 0;
-    return TRUE;
+    SetLastError( ERROR_MORE_DATA );
+done:
+    free( servicesW );
+    return ret;
 }
--- a/dlls/sechost/service.c
+++ b/dlls/sechost/service.c
@@ -1442,11 +1442,91 @@ BOOL WINAPI EnumDependentServicesW( SC_HANDLE hService, DWORD dwServiceState,
                                     LPENUM_SERVICE_STATUSW lpServices, DWORD cbBufSize,
                                     LPDWORD pcbBytesNeeded, LPDWORD lpServicesReturned )
 {
+#ifndef SG_MUTANT_NO_DEPENDENT_SERVICES
+    /* the services that depend on this one, which must be stopped before it
+     * (installers and service managers stop them first; the stub said there
+     * were none) -- from the service control manager, as offsets, made
+     * pointers here */
+    DWORD err, i, offset, buflen, count = 0, total_size = 0;
+    struct enum_service_status *entry;
+    const WCHAR *str;
+    BYTE *buf;
+
+    TRACE( "%p 0x%08lx %p 0x%08lx %p %p\n", hService, dwServiceState,
+           lpServices, cbBufSize, pcbBytesNeeded, lpServicesReturned );
+
+    if (!hService) return set_error( ERROR_INVALID_HANDLE );
+    if (!pcbBytesNeeded || !lpServicesReturned) return set_error( ERROR_INVALID_ADDRESS );
+
+    buflen = max( cbBufSize, sizeof(*lpServices) );
+    if (!(buf = malloc( buflen ))) return set_error( ERROR_NOT_ENOUGH_MEMORY );
+
+    __TRY
+    {
+        err = svcctl_EnumDependentServicesW( hService, dwServiceState, buf, buflen, pcbBytesNeeded, &count );
+    }
+    __EXCEPT(rpc_filter)
+    {
+        err = map_exception_code( GetExceptionCode() );
+    }
+    __ENDTRY
+
+    *lpServicesReturned = 0;
+    if (err != ERROR_SUCCESS)
+    {
+        /* the structures here are larger than the ones the manager counted */
+        if (err == ERROR_MORE_DATA) *pcbBytesNeeded *= 2;
+        free( buf );
+        return set_error( err );
+    }
+
+    entry = (struct enum_service_status *)buf;
+    for (i = 0; i < count; i++, entry++)
+    {
+        total_size += sizeof(*lpServices);
+        total_size += (wcslen( (const WCHAR *)(buf + entry->service_name) ) + 1) * sizeof(WCHAR);
+        if (entry->display_name) total_size += (wcslen( (const WCHAR *)(buf + entry->display_name) ) + 1) * sizeof(WCHAR);
+    }
+    if (total_size > cbBufSize)
+    {
+        free( buf );
+        *pcbBytesNeeded = total_size;
+        return set_error( ERROR_MORE_DATA );
+    }
+
+    offset = count * sizeof(*lpServices);
+    entry = (struct enum_service_status *)buf;
+    for (i = 0; i < count; i++, entry++)
+    {
+        DWORD str_size;
+
+        str = (const WCHAR *)(buf + entry->service_name);
+        str_size = (wcslen( str ) + 1) * sizeof(WCHAR);
+        lpServices[i].lpServiceName = (WCHAR *)((char *)lpServices + offset);
+        memcpy( lpServices[i].lpServiceName, str, str_size );
+        offset += str_size;
+        if (!entry->display_name) lpServices[i].lpDisplayName = NULL;
+        else
+        {
+            str = (const WCHAR *)(buf + entry->display_name);
+            str_size = (wcslen( str ) + 1) * sizeof(WCHAR);
+            lpServices[i].lpDisplayName = (WCHAR *)((char *)lpServices + offset);
+            memcpy( lpServices[i].lpDisplayName, str, str_size );
+            offset += str_size;
+        }
+        lpServices[i].ServiceStatus = entry->service_status;
+    }
+    free( buf );
+    *pcbBytesNeeded = 0;
+    *lpServicesReturned = count;
+    return TRUE;
+#else
     FIXME("%p 0x%08lx %p 0x%08lx %p %p - stub\n", hService, dwServiceState,
           lpServices, cbBufSize, pcbBytesNeeded, lpServicesReturned);
 
     *lpServicesReturned = 0;
     return TRUE;
+#endif
 }
 
 /******************************************************************************
--- a/programs/services/rpc.c
+++ b/programs/services/rpc.c
@@ -2233,6 +2233,39 @@ DWORD __cdecl svcctl_SCSetServiceBitsW(void)
     return ERROR_CALL_NOT_IMPLEMENTED;
 }
 
+/* whether "service" depends on "target": by name, or on its load order group */
+static BOOL depends_on(const struct service_entry *service, const struct service_entry *target)
+{
+    const WCHAR *p;
+
+    for (p = service->dependOnServices; p && *p; p += lstrlenW(p) + 1)
+        if (!wcsicmp(p, target->name)) return TRUE;
+    if (target->config.lpLoadOrderGroup && target->config.lpLoadOrderGroup[0])
+        for (p = service->dependOnGroups; p && *p; p += lstrlenW(p) + 1)
+            if (!wcsicmp(p, target->config.lpLoadOrderGroup)) return TRUE;
+    return FALSE;
+}
+
+/* the services that depend on "target", directly or through others, each
+ * once: a service's own dependents come before it, so the list is in the
+ * order they are stopped -- the reverse of the order they start in */
+static void collect_dependents(struct scmdatabase *db, struct service_entry *target,
+                               struct service_entry **list, DWORD *count, DWORD max)
+{
+    struct service_entry *service;
+    DWORD i;
+
+    LIST_FOR_EACH_ENTRY(service, &db->services, struct service_entry, entry)
+    {
+        if (service == target || !depends_on(service, target)) continue;
+        for (i = 0; i < *count; i++) if (list[i] == service) break;
+        if (i < *count) continue;
+        collect_dependents(db, service, list, count, max);
+        for (i = 0; i < *count; i++) if (list[i] == service) break;
+        if (i == *count && *count < max) list[(*count)++] = service;
+    }
+}
+
 DWORD __cdecl svcctl_EnumDependentServicesW(
     SC_RPC_HANDLE service,
     DWORD state,
@@ -2241,8 +2274,68 @@ DWORD __cdecl svcctl_EnumDependentServicesW(
     DWORD *needed_size,
     DWORD *services_ret)
 {
-    WINE_FIXME("\n");
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    struct sc_service_handle *handle;
+    struct service_entry **list, *entry;
+    struct enum_service_status *s;
+    DWORD err, count = 0, max = 0, i, total_size = 0, offset, sz, matched = 0;
+
+    WINE_TRACE("(%p, 0x%lx, %p, %lu, %p, %p)\n", service, state, services, buf_size, needed_size, services_ret);
+
+    if ((err = validate_service_handle(service, SERVICE_ENUMERATE_DEPENDENTS, &handle)) != ERROR_SUCCESS)
+        return err;
+    if (!state || (state & ~SERVICE_STATE_ALL)) return ERROR_INVALID_PARAMETER;
+
+    scmdatabase_lock(handle->service_entry->db);
+    LIST_FOR_EACH_ENTRY(entry, &handle->service_entry->db->services, struct service_entry, entry) max++;
+    if (!(list = malloc(max * sizeof(*list) + 1)))
+    {
+        scmdatabase_unlock(handle->service_entry->db);
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    collect_dependents(handle->service_entry->db, handle->service_entry, list, &count, max);
+
+    for (i = 0; i < count; i++)
+    {
+        entry = list[i];
+        if (!map_state(entry->status.dwCurrentState, state)) continue;
+        total_size += sizeof(*s) + (lstrlenW(entry->name) + 1) * sizeof(WCHAR);
+        if (entry->config.lpDisplayName) total_size += (lstrlenW(entry->config.lpDisplayName) + 1) * sizeof(WCHAR);
+        matched++;
+    }
+    *services_ret = 0;
+    *needed_size = total_size;
+    if (total_size > buf_size)
+    {
+        scmdatabase_unlock(handle->service_entry->db);
+        free(list);
+        return ERROR_MORE_DATA;
+    }
+    s = (struct enum_service_status *)services;
+    offset = matched * sizeof(*s);
+    for (i = 0; i < count; i++)
+    {
+        entry = list[i];
+        if (!map_state(entry->status.dwCurrentState, state)) continue;
+        sz = (lstrlenW(entry->name) + 1) * sizeof(WCHAR);
+        memcpy(services + offset, entry->name, sz);
+        s->service_name = offset;
+        offset += sz;
+        if (!entry->config.lpDisplayName) s->display_name = 0;
+        else
+        {
+            sz = (lstrlenW(entry->config.lpDisplayName) + 1) * sizeof(WCHAR);
+            memcpy(services + offset, entry->config.lpDisplayName, sz);
+            s->display_name = offset;
+            offset += sz;
+        }
+        s->service_status = entry->status;
+        s++;
+    }
+    *services_ret = matched;
+    *needed_size = 0;
+    scmdatabase_unlock(handle->service_entry->db);
+    free(list);
+    return ERROR_SUCCESS;
 }
 
 DWORD __cdecl svcctl_QueryServiceLockStatusW(
