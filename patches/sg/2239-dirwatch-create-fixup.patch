From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: no change notification for the mode a client gives a file it created

A directory watch reported a second, attribute change for every file or
folder created through ntdll: the client creates it (mode 0700), the server
chooses its mode, and the client then fchmod()s the file to it -- which
inotify reports as IN_ATTRIB on the new name, so a watcher armed after the
creation completed got a spurious MODIFIED at once (ntdll/kernel32 change
tests, which pass on stock Wine). The server notes the files a client
created while it handles the open and drops the first attribute event for
each for two seconds; a later real change is still reported.

---
--- a/server/change.c
+++ b/server/change.c
@@ -850,7 +850,19 @@ static void inotify_notify_all( struct inotify_event *ie )
     }
 
     filter = filter_from_event( ie );
-    
+
+    /* the mode a client gives a file it has just created is not a change of it */
+    if ((ie->mask & (IN_ATTRIB | IN_CREATE | IN_DELETE | IN_MODIFY | IN_MOVED_FROM | IN_MOVED_TO)) == IN_ATTRIB)
+    {
+        struct list *head = list_head( &inode->dirs );
+        struct stat st;
+        int dirfd;
+
+        if (head && (dirfd = get_unix_fd( LIST_ENTRY( head, struct dir, in_entry )->fd )) != -1 &&
+            !fstatat( dirfd, ie->name, &st, AT_SYMLINK_NOFOLLOW ) && sg_take_client_create( st.st_dev, st.st_ino ))
+            return;
+    }
+
     if (ie->mask & IN_CREATE)
     {
         if (ie->mask & IN_ISDIR)
--- a/server/fd.c
+++ b/server/fd.c
@@ -1113,6 +1113,39 @@ void sg_discard_client_unlinks(void)
     sg_unlinks_size = 0;
 }
 
+/* Stained Glass OS: a file a client created is given its final mode by the
+ * client right after the server has chosen it (ntdll's open_file), which the
+ * kernel reports as an attribute change on the new name. A directory watch
+ * must not report that as a change of its own: Windows creates a file with
+ * its attributes in one step. The files whose creation is in flight are
+ * remembered briefly, and the first attribute event for one is dropped. */
+#define SG_CREATE_SLOTS 16
+#define SG_CREATE_WINDOW (2 * TICKS_PER_SEC)
+
+static struct { dev_t dev; ino_t ino; timeout_t until; } sg_creates[SG_CREATE_SLOTS];
+static unsigned int sg_creates_next;
+
+void sg_note_client_create( dev_t dev, ino_t ino )
+{
+    sg_creates[sg_creates_next].dev = dev;
+    sg_creates[sg_creates_next].ino = ino;
+    sg_creates[sg_creates_next].until = current_time + SG_CREATE_WINDOW;
+    sg_creates_next = (sg_creates_next + 1) % SG_CREATE_SLOTS;
+}
+
+int sg_take_client_create( dev_t dev, ino_t ino )
+{
+    unsigned int i;
+
+    for (i = 0; i < SG_CREATE_SLOTS; i++)
+    {
+        if (sg_creates[i].dev != dev || sg_creates[i].ino != ino || sg_creates[i].until < current_time) continue;
+        sg_creates[i].until = 0;
+        return 1;
+    }
+    return 0;
+}
+
 /* is unix_fd the same file as fd? */
 int sg_fd_is_same_file( struct fd *fd, int unix_fd )
 {
@@ -2184,6 +2217,7 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
     struct fd *fd;
     int root_fd = -1;
     int rw_mode;
+    int client_created = 0;
     char *path;
 
     if (((options & FILE_DELETE_ON_CLOSE) && !(access & DELETE)) ||
@@ -2213,6 +2247,7 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
     {
         /* the client created and opened it; only the truncation, which must
          * wait for the sharing check, is still ours to do */
+        client_created = (flags & O_CREAT) != 0;
         flags &= ~(O_CREAT | O_EXCL);
         goto opened;
     }
@@ -2282,6 +2317,9 @@ opened:
     fd->unix_name = NULL;
     fstat( fd->unix_fd, &st );
     *mode = st.st_mode;
+#ifndef SG_MUTANT_NO_CREATE_NOTE
+    if (client_created) sg_note_client_create( st.st_dev, st.st_ino );
+#endif
 
     /* only bother with an inode for normal files and directories */
     if (S_ISREG(st.st_mode) || S_ISDIR(st.st_mode))
--- a/server/file.h
+++ b/server/file.h
@@ -83,6 +83,8 @@ extern struct fd *alloc_pseudo_fd( const struct fd_ops *fd_user_ops, struct obje
                                    unsigned int options );
 extern int sg_reopen_client_fd;
 extern int sg_fd_is_same_file( struct fd *fd, int unix_fd );
+extern void sg_note_client_create( dev_t dev, ino_t ino );
+extern int sg_take_client_create( dev_t dev, ino_t ino );
 extern struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_name,
                            int flags, mode_t *mode, unsigned int access,
                            unsigned int sharing, unsigned int options, int client_fd );
