+/* binary object data: runs of numbers go out as one integer or float list, strings are tokens of their own;
+ * the reader supplies the separators between the members of a list itself. */
+static void walk_flush_list(struct walk *w)
+{
+    if (!w->list_count) return;
+#ifdef SG_MUTANT_XOF_BINTOKEN
+    tb_w16(w->out, TOKEN_INTEGER_LIST);
+#else
+    tb_w16(w->out, w->list_kind == 1 ? TOKEN_INTEGER_LIST : TOKEN_FLOAT_LIST);
+#endif
+    tb_w32(w->out, w->list_count);
+    tb_put(w->out, w->list.data, w->list.len);
+    w->list.len = 0;
+    w->list_count = 0;
+    w->list_kind = 0;
+}
+
+static void walk_list_add(struct walk *w, int kind, DWORD value)
+{
+    if (w->list_kind != kind) walk_flush_list(w);
+    w->list_kind = kind;
+    tb_w32(&w->list, value);
+    w->list_count++;
+}
+
+static void walk_prim_bin(struct walk *w, const member *m, const BYTE *p)
+{
+    switch (m->type)
+    {
+    case TOKEN_WORD: walk_list_add(w, 1, *(const WORD *)p); break;
+    case TOKEN_SWORD: walk_list_add(w, 1, (LONG)*(const SHORT *)p); break;
+    case TOKEN_DWORD: case TOKEN_SDWORD: walk_list_add(w, 1, *(const DWORD *)p); break;
+    case TOKEN_CHAR: walk_list_add(w, 1, (LONG)*(const signed char *)p); break;
+    case TOKEN_UCHAR: walk_list_add(w, 1, *p); break;
+    case TOKEN_FLOAT: walk_list_add(w, 2, *(const DWORD *)p); break;
+    case TOKEN_LPSTR:
+    {
+        const char *s = *(const char *const *)p;
+        size_t len = s ? strlen(s) : 0;
+
+        walk_flush_list(w);
+        tb_w16(w->out, TOKEN_STRING);
+        tb_w32(w->out, len);
+        tb_put(w->out, s ? s : "", len);
+        tb_w16(w->out, w->elem_last ? TOKEN_SEMICOLON : TOKEN_COMMA);
+        break;
+    }
+    default:
+        /* the binary format has no 64-bit float lists in a 32-bit file */
+        w->bad_type = TRUE;
+        break;
+    }
+}
