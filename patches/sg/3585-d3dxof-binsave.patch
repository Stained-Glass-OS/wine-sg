+static BOOL save_body_append(IDirectXFileSaveObjectImpl *object, const char *data, size_t len)
+{
+    if (object->body_len + len > object->body_cap)
+    {
+        size_t cap = max(object->body_cap * 2, object->body_len + len + 4096);
+        BYTE *p = realloc(object->body, cap);
+
+        if (!p) return FALSE;
+        object->body = p;
+        object->body_cap = cap;
+    }
+    memcpy(object->body + object->body_len, data, len);
+    object->body_len += len;
+    return TRUE;
+}
+
+static void *zlib_alloc(void *opaque, unsigned int items, unsigned int size)
+{
+    return HeapAlloc(GetProcessHeap(), 0, (SIZE_T)items * size);
+}
+
+static void zlib_free(void *opaque, void *ptr)
+{
+    HeapFree(GetProcessHeap(), 0, ptr);
+}
+
+/* MSZIP: the body in chunks of at most 32768 bytes, each a deflate stream behind the signature "CK". */
+static BOOL write_compressed(IDirectXFileSaveObjectImpl *object, const char *magic)
+{
+    struct tb out = {0};
+    size_t pos;
+    BOOL ok = TRUE;
+    DWORD written;
+
+    tb_put(&out, magic, 16);
+    tb_w32(&out, 16 + object->body_len);
+    for (pos = 0; pos < object->body_len && ok && !out.fail; )
+    {
+        size_t chunk = min(object->body_len - pos, 32768);
+        BYTE comp[32768 + 1024];
+        z_stream z = {0};
+
+        z.zalloc = zlib_alloc;
+        z.zfree = zlib_free;
+        if (deflateInit2(&z, Z_DEFAULT_COMPRESSION, Z_DEFLATED, -MAX_WBITS, 8, Z_DEFAULT_STRATEGY) != Z_OK)
+        {
+            ok = FALSE;
+            break;
+        }
+        comp[0] = 'C';
+#ifdef SG_MUTANT_XOF_NOCK
+        comp[1] = 'X';
+#else
+        comp[1] = 'K';
+#endif
+        z.next_in = object->body + pos;
+        z.avail_in = chunk;
+        z.next_out = comp + 2;
+        z.avail_out = sizeof(comp) - 2;
+        if (deflate(&z, Z_FINISH) != Z_STREAM_END) ok = FALSE;
+        tb_w16(&out, chunk);
+        tb_w16(&out, z.total_out + 2);
+        tb_put(&out, (const char *)comp, z.total_out + 2);
+        deflateEnd(&z);
+        pos += chunk;
+    }
+    if (ok && !out.fail)
+        ok = WriteFile(object->file, out.data, out.len, &written, NULL) && written == out.len;
+    else
+        ok = FALSE;
+    free(out.data);
+    return ok;
+}
+
 void save_object_destroy(IDirectXFileSaveObjectImpl *object)
 {
+    if ((object->format & DXFILEFORMAT_COMPRESSED) && object->header_written)
+    {
+        if (!write_compressed(object, (object->format & DXFILEFORMAT_TEXT) ? "xof 0303tzip0032" : "xof 0303bzip0032"))
+            WARN("Writing the compressed file failed.\n");
+    }
+    free(object->body);
     CloseHandle(object->file);
     IDirectXFile_Release(&object->dxf->IDirectXFile_iface);
     HeapFree(GetProcessHeap(), 0, object);
