From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comctl32: ComboBoxEx callback fields, header order array, edit results (2050)

comctl32: ComboBoxEx callback fields, header order array, edit WM_SIZE/WM_DESTROY.

CBEM_GETITEM now asks the parent (CBEN_GETDISPINFO, once) for the fields of
an item that are callbacks and were asked for, and keeps the answer when the
parent says CBEIF_DI_SETITEM. HDM_SETORDERARRAY moves each valid entry to its
place in turn, so entries out of range or repeated leave the rest in order.
The edit control answers WM_SIZE and WM_DESTROY with 1.
---
--- a/dlls/comctl32/comboex.c
+++ b/dlls/comctl32/comboex.c
@@ -523,6 +523,65 @@
 }
 
 
+/* Ask the parent for the fields of an item the program keeps itself (callbacks) that a
+ * CBEM_GETITEM asks for, in one CBEN_GETDISPINFO; what the parent sets for good is kept. */
+static void COMBOEX_ResolveCallbacks (COMBOEX_INFO *infoPtr, CBE_ITEMDATA *item, CBE_ITEMDATA *out, INT_PTR index, UINT mask)
+{
+    NMCOMBOBOXEXW nmce;
+    WCHAR empty[1] = { 0 };
+    UINT cbmask = 0;
+
+#ifdef SG_MUTANT_COMBOEX_NOCALLBACK
+    return;
+#endif
+    if ((mask & CBEIF_TEXT) && item->pszText == LPSTR_TEXTCALLBACKW) cbmask |= CBEIF_TEXT;
+    if ((mask & CBEIF_IMAGE) && item->iImage == I_IMAGECALLBACK) cbmask |= CBEIF_IMAGE;
+    if ((mask & CBEIF_SELECTEDIMAGE) && item->iSelectedImage == I_IMAGECALLBACK) cbmask |= CBEIF_SELECTEDIMAGE;
+    if ((mask & CBEIF_OVERLAY) && item->iOverlay == I_IMAGECALLBACK) cbmask |= CBEIF_OVERLAY;
+    if ((mask & CBEIF_INDENT) && item->iIndent == I_INDENTCALLBACK) cbmask |= CBEIF_INDENT;
+    if (!cbmask) return;
+
+    ZeroMemory (&nmce, sizeof(nmce));
+    nmce.ceItem.mask = cbmask;
+    nmce.ceItem.iItem = index;
+    nmce.ceItem.lParam = item->lParam;
+    if (cbmask & CBEIF_TEXT) nmce.ceItem.pszText = empty;
+    nmce.ceItem.iImage = item->iImage;
+    nmce.ceItem.iSelectedImage = item->iSelectedImage;
+    nmce.ceItem.iOverlay = item->iOverlay;
+    nmce.ceItem.iIndent = 0;
+    COMBOEX_NotifyItem (infoPtr, CBEN_GETDISPINFOW, &nmce);
+
+    /* the answer is for this call; with CBEIF_DI_SETITEM the item keeps it */
+    if (cbmask & CBEIF_IMAGE) out->iImage = nmce.ceItem.iImage;
+    if (cbmask & CBEIF_SELECTEDIMAGE) out->iSelectedImage = nmce.ceItem.iSelectedImage;
+    if (cbmask & CBEIF_OVERLAY) out->iOverlay = nmce.ceItem.iOverlay;
+    if (cbmask & CBEIF_INDENT) out->iIndent = nmce.ceItem.iIndent;
+    if (nmce.ceItem.mask & CBEIF_DI_SETITEM)
+    {
+        if (cbmask & CBEIF_IMAGE) item->iImage = nmce.ceItem.iImage;
+        if (cbmask & CBEIF_SELECTEDIMAGE) item->iSelectedImage = nmce.ceItem.iSelectedImage;
+        if (cbmask & CBEIF_OVERLAY) item->iOverlay = nmce.ceItem.iOverlay;
+        if (cbmask & CBEIF_INDENT) item->iIndent = nmce.ceItem.iIndent;
+    }
+    if ((cbmask & CBEIF_TEXT) && nmce.ceItem.pszText != empty && nmce.ceItem.pszText)
+    {
+        LPWSTR text = nmce.ceItem.pszText;
+
+        if (is_textW(text) && !infoPtr->NtfUnicode)
+        {
+            INT len = MultiByteToWideChar (CP_ACP, 0, (LPSTR)text, -1, NULL, 0);
+            LPWSTR buf = Alloc (len * sizeof(WCHAR));
+            if (buf) MultiByteToWideChar (CP_ACP, 0, (LPSTR)text, -1, buf, len);
+            text = buf;
+            if (nmce.ceItem.mask & CBEIF_DI_SETITEM) { COMBOEX_FreeText (item); item->pszText = buf; }
+            else { Free (item->pszTemp); item->pszTemp = buf; }
+        }
+        else if (nmce.ceItem.mask & CBEIF_DI_SETITEM) item->pszText = text;
+        out->pszText = text;
+    }
+}
+
 static BOOL COMBOEX_GetItemW (COMBOEX_INFO *infoPtr, COMBOBOXEXITEMW *cit)
 {
     INT_PTR index = cit->iItem;
@@ -538,7 +597,12 @@
 
     if (!(item = COMBOEX_FindItem(infoPtr, index))) return FALSE;
 
-    COMBOEX_CopyItem (item, cit);
+    {
+        CBE_ITEMDATA answer = *item;
+
+        COMBOEX_ResolveCallbacks (infoPtr, item, &answer, index, cit->mask);
+        COMBOEX_CopyItem (&answer, cit);
+    }
 
     return TRUE;
 }
