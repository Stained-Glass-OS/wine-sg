+        if(FAILED(hres))
+            return hres;
+        wrapped = desc.getter;
+    }
+#else
     desc.getter = to_jsdisp(get_object(argv[1]));
     if(!desc.getter) {
         FIXME("getter is not JS object\n");
         return E_NOTIMPL;
     }
+#endif
