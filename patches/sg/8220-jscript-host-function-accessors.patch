From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] jscript: __defineGetter__ and __defineSetter__ take a host function object

A host's function object (an IDispatch called through DISPID_VALUE) given as the accessor is wrapped in a JS function (DispFunction) instead of failing with E_NOTIMPL ("getter is not JS object").
---
--- a/dlls/jscript/function.c
+++ b/dlls/jscript/function.c
@@ -1309,6 +1309,65 @@
     return gc_process_linked_val(gc_ctx, op, &function->function.dispex, &function->this);
 }
 
+#ifndef SG_MUTANT_NO_DISP_ACCESSOR
+/* Stained Glass OS (wine-sg 8220): a host's function object (an IDispatch called through DISPID_VALUE) as a
+ * JS function, for the places that need one -- __defineGetter__ / __defineSetter__ with a host function */
+typedef struct {
+    FunctionInstance function;
+    IDispatch *disp;
+} DispFunction;
+
+static HRESULT DispFunction_call(script_ctx_t *ctx, FunctionInstance *func, jsval_t vthis, unsigned flags,
+         unsigned argc, jsval_t *argv, jsval_t *r)
+{
+    DispFunction *function = (DispFunction*)func;
+
+    if(flags & DISPATCH_CONSTRUCT)
+        return disp_call_value(ctx, function->disp, jsval_undefined(), DISPATCH_CONSTRUCT, argc, argv, r);
+    return disp_call_value(ctx, function->disp, vthis, DISPATCH_METHOD, argc, argv, r);
+}
+
+static HRESULT DispFunction_toString(FunctionInstance *func, jsstr_t **ret)
+{
+    return native_function_string(L"", ret);
+}
+
+static function_code_t *DispFunction_get_code(FunctionInstance *function)
+{
+    return NULL;
+}
+
+static void DispFunction_destructor(FunctionInstance *func)
+{
+    DispFunction *function = (DispFunction*)func;
+    if(function->disp)
+        IDispatch_Release(function->disp);
+}
+
+static const function_vtbl_t DispFunctionVtbl = {
+    DispFunction_call,
+    DispFunction_toString,
+    DispFunction_get_code,
+    DispFunction_destructor,
+    no_gc_traverse
+};
+
+HRESULT create_disp_function(script_ctx_t *ctx, IDispatch *disp, jsdisp_t **ret)
+{
+    DispFunction *function;
+    HRESULT hres;
+
+    hres = create_function(ctx, &HostFunction_info, &DispFunctionVtbl, sizeof(DispFunction), PROPF_METHOD,
+                           FALSE, NULL, (void**)&function);
+    if(FAILED(hres))
+        return hres;
+
+    IDispatch_AddRef(function->disp = disp);
+    *ret = &function->function.dispex;
+    return S_OK;
+}
+#endif
+
 static const function_vtbl_t BindFunctionVtbl = {
     BindFunction_call,
     BindFunction_toString,
--- a/dlls/jscript/jscript.h
+++ b/dlls/jscript/jscript.h
@@ -290,6 +290,7 @@
 HRESULT create_builtin_constructor(script_ctx_t*,builtin_invoke_t,const WCHAR*,const builtin_info_t*,DWORD,
         jsdisp_t*,jsdisp_t**);
 HRESULT create_host_function(script_ctx_t*,const struct property_info*,DWORD,jsdisp_t**);
+HRESULT create_disp_function(script_ctx_t*,IDispatch*,jsdisp_t**);
 HRESULT Function_invoke(jsdisp_t*,jsval_t,WORD,unsigned,jsval_t*,jsval_t*);
 
 HRESULT Function_value(script_ctx_t*,jsval_t,WORD,unsigned,jsval_t*,jsval_t*);
