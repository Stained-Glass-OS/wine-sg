+/* the access key settings of an element */
+void xaml_access_key_info( struct uielem *elem, struct xaml_access_info *info )
+{
+    IInspectable *box = NULL;
+
+    xaml_elements_init();
+    dobj_get_value( &elem->d, prop_access_key_scope, &box );
+    info->is_scope = xunbox_boolean( box, FALSE );
+    if (box) IInspectable_Release( box );
+    box = NULL;
+    dobj_get_value( &elem->d, prop_access_key_owner, &box );
+    info->owner = box ? uielem_from_inspectable( box ) : NULL;   /* no reference: it is in the tree */
+    if (box) IInspectable_Release( box );
+    box = NULL;
+    dobj_get_value( &elem->d, prop_exit_on_invoked, &box );
+    info->exit_on_invoked = xunbox_boolean( box, TRUE );
+    if (box) IInspectable_Release( box );
+    box = NULL;
+    dobj_get_value( &elem->d, prop_key_tip_placement, &box );
+    info->placement = xunbox_enum( box, NULL, 0 );
+    if (box) IInspectable_Release( box );
+    box = NULL;
+    dobj_get_value( &elem->d, prop_key_tip_hoffset, &box );
+    info->hoffset = xunbox_double( box, 0 );
+    if (box) IInspectable_Release( box );
+    box = NULL;
+    dobj_get_value( &elem->d, prop_key_tip_voffset, &box );
+    info->voffset = xunbox_double( box, 0 );
+    if (box) IInspectable_Release( box );
+}
+
+#define UIE_BOOL(n, prop, def) \
+static HRESULT WINAPI uie_get_##n( struct xiface *iface, boolean *value ) \
+{ IInspectable *box = NULL; if (!value) return E_POINTER; dobj_get_value( &elem_from_iface( iface )->d, prop, &box ); \
+  *value = xunbox_boolean( box, def ); if (box) IInspectable_Release( box ); return S_OK; } \
+static HRESULT WINAPI uie_put_##n( struct xiface *iface, boolean value ) \
+{ IInspectable *box = xbox_boolean( value ); HRESULT hr; if (!box) return E_OUTOFMEMORY; \
+  hr = dobj_set_value( &elem_from_iface( iface )->d, prop, box ); IInspectable_Release( box ); return hr; }
+#define UIE_DOUBLE(n, prop) \
+static HRESULT WINAPI uie_get_##n( struct xiface *iface, DOUBLE *value ) \
+{ IInspectable *box = NULL; if (!value) return E_POINTER; dobj_get_value( &elem_from_iface( iface )->d, prop, &box ); \
+  *value = xunbox_double( box, 0 ); if (box) IInspectable_Release( box ); return S_OK; } \
+static HRESULT WINAPI uie_put_##n( struct xiface *iface, DOUBLE value ) \
+{ IInspectable *box = xbox_double( value ); HRESULT hr; if (!box) return E_OUTOFMEMORY; \
+  hr = dobj_set_value( &elem_from_iface( iface )->d, prop, box ); IInspectable_Release( box ); return hr; }
+#define UIE_ENUM(n, prop) \
+static HRESULT WINAPI uie_get_##n( struct xiface *iface, INT32 *value ) \
+{ IInspectable *box = NULL; if (!value) return E_POINTER; dobj_get_value( &elem_from_iface( iface )->d, prop, &box ); \
+  *value = xunbox_enum( box, NULL, 0 ); if (box) IInspectable_Release( box ); return S_OK; } \
+static HRESULT WINAPI uie_put_##n( struct xiface *iface, INT32 value ) \
+{ IInspectable *box = xbox_int32( value ); HRESULT hr; if (!box) return E_OUTOFMEMORY; \
+  hr = dobj_set_value( &elem_from_iface( iface )->d, prop, box ); IInspectable_Release( box ); return hr; }
+
+UIE_BOOL(IsAccessKeyScope, prop_access_key_scope, FALSE)
+UIE_BOOL(ExitDisplayModeOnAccessKeyInvoked, prop_exit_on_invoked, TRUE)
+UIE_ENUM(KeyTipPlacementMode, prop_key_tip_placement)
+UIE_DOUBLE(KeyTipHorizontalOffset, prop_key_tip_hoffset)
+UIE_DOUBLE(KeyTipVerticalOffset, prop_key_tip_voffset)
+
+static HRESULT WINAPI uie_get_AccessKeyScopeOwner( struct xiface *iface, IInspectable **value )
