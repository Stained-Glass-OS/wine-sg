             return TRUE;
         }
         return (wparam >= '0' && wparam <= '9') || (wparam >= 'A' && wparam <= 'Z');   /* typed as WM_CHAR */
@@ -874,14 +954,12 @@ static HRESULT WINAPI akm_IsDisplayModeEnabled( struct xfiface *iface, boolean *
 
