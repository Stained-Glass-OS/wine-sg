 static WCHAR access_typed[16];
 static BOOL alt_alone, access_ate_char;
+static struct handler_list display_mode_changed = { LIST_INIT( display_mode_changed.entries ) };
 
 struct access_list { struct uielem *items[256]; WCHAR *keys[256]; unsigned int count; };
 
-static void collect_access( struct uielem *elem, struct access_list *list )
+/* the elements with an access key in the scope entered: an element belongs to the nearest
+ * IsAccessKeyScope element above it, or to its (or an ancestor's) AccessKeyScopeOwner */
+static void collect_access_in( struct uielem *elem, struct uielem *scope, struct access_list *list, BOOL keys )
 {
-    struct uielem *child;
+    struct xaml_access_info info;
+    struct uielem *child, *mine;
     WCHAR *key;
 
     if (!tab_visible( elem )) return;
-    if (list->count < ARRAY_SIZE(list->items) && (key = xaml_access_key( elem )))
+    xaml_access_key_info( elem, &info );
+    mine = info.owner ? info.owner : scope;
+#ifdef SG_MUTANT_XAML_NO_KEY_SCOPES
+    mine = access_scope;
+    info.is_scope = FALSE;
+#endif
+    if (mine == access_scope && list->count < ARRAY_SIZE(list->items) && (key = xaml_access_key( elem )))
     {
         list->items[list->count] = elem;
-        list->keys[list->count++] = key;
+        if (keys) list->keys[list->count] = key;
+        else free( key );
+        list->count++;
     }
-    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry ) collect_access( child, list );
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry )
+        collect_access_in( child, info.is_scope ? elem : mine, list, keys );
+}
+
+static void collect_access( struct uielem *elem, struct access_list *list )
+{
+    collect_access_in( elem, NULL, list, TRUE );
+}
+
+/* for the key tips */
+unsigned int xaml_access_key_elements( struct uielem *root, struct uielem **out, unsigned int size )
+{
+    struct access_list *list = calloc( 1, sizeof(*list) );
+    unsigned int i, n = 0;
+
+    if (!list) return 0;
+    collect_access_in( root, NULL, list, FALSE );
+    for (i = 0; i < list->count && n < size; i++) out[n++] = list->items[i];
+    free( list );
+    return n;
+}
+
+static void set_access_scope( struct uielem *scope )
+{
+    if (scope) IUnknown_AddRef( scope->d.obj.outer );
+    if (access_scope) IUnknown_Release( access_scope->d.obj.outer );
+    access_scope = scope;
+    access_typed[0] = 0;
+    xaml_invalidate_visuals();
+}
+
+static void display_mode_set( HWND hwnd )
+{
+    BOOL was = access_hwnd != NULL;
+
+    access_hwnd = hwnd;
+    xaml_invalidate_visuals();
+    if (was != (hwnd != NULL)) xaml_raise_routed( &display_mode_changed, NULL, NULL );
 }
 
 static void free_access( struct access_list *list )
@@ -636,17 +686,37 @@ void xaml_access_key_exit(void)
 {
     if (!access_hwnd) return;
     TRACE( "display mode off\n" );
-    access_hwnd = NULL;
-    xaml_invalidate_visuals();
+    set_access_scope( NULL );
+    display_mode_set( NULL );
 }
 
+/* an element invoked: AccessKeyInvoked; unless handled a button clicks, what takes the keyboard takes
+ * the focus. A scope's element enters its scope (display mode goes on); else display mode ends, unless
+ * the element says ExitDisplayModeOnAccessKeyInvoked False */
 static void access_invoke( HWND hwnd, struct uielem *elem )
 {
+    struct xaml_access_info info;
+    BOOL handled;
+
     TRACE( "%p\n", elem );
-    xaml_access_key_exit();
+    xaml_access_key_info( elem, &info );
+#ifdef SG_MUTANT_XAML_NO_KEY_SCOPES
+    info.is_scope = FALSE;
+#endif
     access_typed[0] = 0;
-    if (xaml_access_key_invoked( elem )) return;
-    /* not handled: a button clicks, what takes the keyboard takes the focus */
+    if (info.is_scope && access_hwnd)
+    {
+        set_access_scope( elem );
+        if (!access_hwnd) display_mode_set( hwnd );
+    }
+    else if (info.is_scope)
+    {
+        set_access_scope( elem );
+        display_mode_set( hwnd );
+    }
+    else if (info.exit_on_invoked) xaml_access_key_exit();
+    handled = xaml_access_key_invoked( elem );
+    if (handled) return;
     if (xaml_is_button( elem ) && xaml_is_focus_target( elem )) xaml_button_click( elem );
     else if (xaml_is_focus_target( elem )) xaml_focus_element_state( elem, hwnd, 2 );
 }
