+    return dobj_get_value( &elem_from_iface( iface )->d, prop_access_key_owner, value );
+}
+
+static HRESULT WINAPI uie_put_AccessKeyScopeOwner( struct xiface *iface, IInspectable *value )
+{
+    return dobj_set_value( &elem_from_iface( iface )->d, prop_access_key_owner, value );
+}
