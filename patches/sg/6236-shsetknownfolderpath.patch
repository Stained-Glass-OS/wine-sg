From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHSetKnownFolderPath

SHSetKnownFolderPath was missing, so a program importing it (OneDrive's sync libraries all do, for moving Desktop, Documents and Pictures into the cloud folder) got an unresolved import and crashed if it called it. It now moves a known folder: a per-user folder is written to the user's User Shell Folders (under its legacy name such as Personal, or its id), with the expanded path under Shell Folders, for the current user (no token, or a token of the current user) or the default user (a token of -1); a common folder is written machine-wide, which needs the rights to change HKLM; KF_FLAG_CREATE creates the folder. Fixed folders (Windows, System) are refused with E_INVALIDARG, unknown ones with ERROR_FILE_NOT_FOUND, and another user's folders are not supported.
---
diff --git a/dlls/shell32/shell32.spec b/dlls/shell32/shell32.spec
index dc2ce09..c51ed85 100644
--- a/dlls/shell32/shell32.spec
+++ b/dlls/shell32/shell32.spec
@@ -429,6 +429,7 @@
 @ stdcall SHQueryRecycleBinW(wstr ptr)
 @ stdcall SHQueryUserNotificationState(ptr)
 @ stdcall SHRemoveLocalizedName(wstr)
+@ stdcall SHSetKnownFolderPath(ptr long ptr wstr)
 @ stdcall SHSetLocalizedName(wstr wstr long)
 @ stdcall SHGetTemporaryPropertyForItem(ptr ptr ptr)
 @ stdcall SHSetTemporaryPropertyForItem(ptr ptr ptr)
diff --git a/dlls/shell32/shellpath.c b/dlls/shell32/shellpath.c
index d591ce1..a96db59 100644
--- a/dlls/shell32/shellpath.c
+++ b/dlls/shell32/shellpath.c
@@ -3567,6 +3567,103 @@ HRESULT WINAPI SHGetKnownFolderPath(REFKNOWNFOLDERID rfid, DWORD flags, HANDLE t
     return hr;
 }
 
+/* is the token's user the user running this process? */
+static BOOL token_is_current_user( HANDLE token )
+{
+    WCHAR *mine, *theirs;
+    HANDLE self;
+    BOOL same = FALSE;
+
+    if (!OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &self )) return FALSE;
+    mine = _GetUserSidStringFromToken( self );
+    CloseHandle( self );
+    theirs = _GetUserSidStringFromToken( token );
+    if (mine && theirs) same = !wcscmp( mine, theirs );
+    LocalFree( mine );
+    LocalFree( theirs );
+    return same;
+}
+
+/*************************************************************************
+ * SHSetKnownFolderPath           [SHELL32.@]
+ *
+ * Moves a known folder: the per-user folders in the user's profile (HKCU, or the default user's
+ * for a token of -1), the common ones machine-wide (which needs the rights to change HKLM).  The
+ * path is kept under User Shell Folders, where SHGetKnownFolderPath and SHGetFolderPath read it,
+ * and its expanded form under Shell Folders for the folders that have a legacy name.
+ */
+HRESULT WINAPI SHSetKnownFolderPath( REFKNOWNFOLDERID rfid, DWORD flags, HANDLE token, const WCHAR *path )
+{
+    static const WCHAR user_shell_folders[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\User Shell Folders";
+    static const WCHAR shell_folders[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Shell Folders";
+    int folder = csidl_from_id( rfid );
+    const WCHAR *value;
+    WCHAR guid[39], expanded[MAX_PATH], keypath[300];
+    HKEY root, key;
+    LONG res;
+
+    TRACE( "%s, %#lx, %p, %s\n", debugstr_guid(rfid), flags, token, debugstr_w(path) );
+
+    if (folder < 0) return HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
+    if (!path || !path[0]) return E_INVALIDARG;
+    if (CSIDL_Data[folder].type != CSIDL_Type_User && CSIDL_Data[folder].type != CSIDL_Type_AllUsers
+            && CSIDL_Data[folder].type != CSIDL_Type_ProgramData)
+        return E_INVALIDARG; /* a fixed folder (Windows, System, ...) or a virtual one */
+
+    keypath[0] = 0;
+    if (CSIDL_Data[folder].type != CSIDL_Type_User) root = HKEY_LOCAL_MACHINE;
+    else if (token == (HANDLE)-1)
+    {
+        root = HKEY_USERS;
+        wcscpy( keypath, L".Default\\" );
+    }
+    else if (!token || token_is_current_user( token )) root = HKEY_CURRENT_USER;
+    else
+    {
+        FIXME( "folders of another user are not supported\n" );
+        return E_NOTIMPL;
+    }
+
+    value = CSIDL_Data[folder].value;
+#ifdef SG_MUTANT_SETKF_GUID_NAME
+    value = NULL;
+#endif
+    if (!value)
+    {
+        StringFromGUID2( CSIDL_Data[folder].id, guid, ARRAY_SIZE(guid) );
+        value = guid;
+    }
+
+    res = ExpandEnvironmentStringsW( path, expanded, ARRAY_SIZE(expanded) );
+    if (!res || res > ARRAY_SIZE(expanded)) return HRESULT_FROM_WIN32( ERROR_FILENAME_EXCED_RANGE );
+    if (flags & KF_FLAG_CREATE)
+    {
+        res = SHCreateDirectoryExW( NULL, expanded, NULL );
+        if (res && res != ERROR_ALREADY_EXISTS && res != ERROR_FILE_EXISTS) return HRESULT_FROM_WIN32( res );
+    }
+
+    wcscat( keypath, user_shell_folders );
+    if ((res = RegCreateKeyExW( root, keypath, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL )))
+        return HRESULT_FROM_WIN32( res );
+    res = RegSetValueExW( key, value, 0, wcschr( path, '%' ) ? REG_EXPAND_SZ : REG_SZ, (const BYTE *)path,
+                          (wcslen( path ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    if (res) return HRESULT_FROM_WIN32( res );
+
+    if (CSIDL_Data[folder].value)
+    {
+        keypath[root == HKEY_USERS ? wcslen( L".Default\\" ) : 0] = 0;
+        wcscat( keypath, shell_folders );
+        if (!RegCreateKeyExW( root, keypath, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL ))
+        {
+            RegSetValueExW( key, CSIDL_Data[folder].value, 0, REG_SZ, (const BYTE *)expanded,
+                            (wcslen( expanded ) + 1) * sizeof(WCHAR) );
+            RegCloseKey( key );
+        }
+    }
+    return S_OK;
+}
+
 /*************************************************************************
  * SHGetFolderPathEx           [SHELL32.@]
  */
diff --git a/include/shlobj.h b/include/shlobj.h
index 1b02ebf..abfcd6b 100644
--- a/include/shlobj.h
+++ b/include/shlobj.h
@@ -98,6 +98,7 @@ WINSHELLAPI HRESULT      WINAPI SHGetFolderPathAndSubDirW(HWND,int,HANDLE,DWORD,
 WINSHELLAPI HRESULT      WINAPI SHGetKnownFolderIDList(REFKNOWNFOLDERID,DWORD,HANDLE,PIDLIST_ABSOLUTE*);
 WINSHELLAPI HRESULT      WINAPI SHGetKnownFolderItem(REFKNOWNFOLDERID,KNOWN_FOLDER_FLAG,HANDLE,REFIID,void**);
 WINSHELLAPI HRESULT      WINAPI SHGetKnownFolderPath(REFKNOWNFOLDERID,DWORD,HANDLE,PWSTR*);
+WINSHELLAPI HRESULT      WINAPI SHSetKnownFolderPath(REFKNOWNFOLDERID,DWORD,HANDLE,PCWSTR);
 WINSHELLAPI BOOL         WINAPI SHGetPathFromIDListA(LPCITEMIDLIST,LPSTR);
 WINSHELLAPI BOOL         WINAPI SHGetPathFromIDListW(LPCITEMIDLIST,LPWSTR);
 #define                         SHGetPathFromIDList WINELIB_NAME_AW(SHGetPathFromIDList)
