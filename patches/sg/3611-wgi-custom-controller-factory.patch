+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(input);
+
+static CRITICAL_SECTION weak_cs;
+static CRITICAL_SECTION_DEBUG weak_cs_debug =
+{
+    0, 0, &weak_cs,
+    { &weak_cs_debug.ProcessLocksList, &weak_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": weak_cs") }
+};
+static CRITICAL_SECTION weak_cs = { &weak_cs_debug, -1, 0, 0, 0, 0 };
+
+/* shared between the object and its weak references; obj is cleared when the object dies */
+struct weak_holder
+{
+    LONG refs;
+    IUnknown *obj;
+    LONG *obj_ref;
+};
+
+struct weak_reference
+{
+    IWeakReference IWeakReference_iface;
+    LONG ref;
+    struct weak_holder *holder;
+};
+
+static void holder_release( struct weak_holder *holder )
+{
+    if (!InterlockedDecrement( &holder->refs )) free( holder );
+}
+
+static inline struct weak_reference *impl_from_IWeakReference( IWeakReference *iface )
+{
+    return CONTAINING_RECORD( iface, struct weak_reference, IWeakReference_iface );
+}
+
+static HRESULT WINAPI weak_reference_QueryInterface( IWeakReference *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IWeakReference ))
+    {
+        IWeakReference_AddRef( (*out = iface) );
+        return S_OK;
+    }
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI weak_reference_AddRef( IWeakReference *iface )
+{
+    struct weak_reference *impl = impl_from_IWeakReference( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI weak_reference_Release( IWeakReference *iface )
+{
+    struct weak_reference *impl = impl_from_IWeakReference( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        holder_release( impl->holder );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI weak_reference_Resolve( IWeakReference *iface, REFIID iid, IInspectable **out )
+{
+    struct weak_reference *impl = impl_from_IWeakReference( iface );
+    IUnknown *obj = NULL;
+    LONG ref;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+
+    /* take a strong reference only if the object has not reached zero yet */
+    EnterCriticalSection( &weak_cs );
+    if (impl->holder->obj)
+    {
+        do
+        {
+            if (!(ref = *impl->holder->obj_ref)) break;
+        } while (InterlockedCompareExchange( impl->holder->obj_ref, ref + 1, ref ) != ref);
+        if (ref) obj = impl->holder->obj;
+    }
+    LeaveCriticalSection( &weak_cs );
+
+    if (obj)
+    {
+        hr = IUnknown_QueryInterface( obj, iid, (void **)out );
+        IUnknown_Release( obj );
+    }
+    return hr;
+}
+
+static const IWeakReferenceVtbl weak_reference_vtbl =
+{
+    weak_reference_QueryInterface,
+    weak_reference_AddRef,
+    weak_reference_Release,
+    weak_reference_Resolve,
+};
+
+HRESULT weak_holder_get_reference( struct weak_holder **holder, IUnknown *obj, LONG *obj_ref, IWeakReference **out )
+{
+    struct weak_reference *impl;
+    HRESULT hr = S_OK;
+
+    if (!out) return E_INVALIDARG;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    EnterCriticalSection( &weak_cs );
+    if (!*holder && (*holder = calloc( 1, sizeof(**holder) )))
+    {
+        (*holder)->refs = 1;
+        (*holder)->obj = obj;
+        (*holder)->obj_ref = obj_ref;
+    }
+    if (*holder)
+    {
+        InterlockedIncrement( &(*holder)->refs );
+        impl->holder = *holder;
+    }
+    else hr = E_OUTOFMEMORY;
+    LeaveCriticalSection( &weak_cs );
+
+    if (FAILED(hr))
+    {
+        free( impl );
+        return hr;
+    }
+    impl->IWeakReference_iface.lpVtbl = &weak_reference_vtbl;
+    impl->ref = 1;
+    *out = &impl->IWeakReference_iface;
+    return S_OK;
+}
+
+/* called by the object, while its reference count is zero, before it is freed */
+void weak_holder_detach( struct weak_holder **holder )
+{
+    struct weak_holder *detached;
+
+    EnterCriticalSection( &weak_cs );
+    if ((detached = *holder)) detached->obj = NULL;
+    *holder = NULL;
+    LeaveCriticalSection( &weak_cs );
+
+    if (detached) holder_release( detached );
+}
