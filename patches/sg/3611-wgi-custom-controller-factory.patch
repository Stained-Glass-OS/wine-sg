+enum hid_report_op { HID_GET_FEATURE, HID_SET_FEATURE, HID_SET_OUTPUT };
+
+/* the HID calls want the report id in front of the data, the interface passes them apart */
+static HRESULT hid_provider_report( struct provider *impl, enum hid_report_op op, BYTE id, UINT32 report_len,
+                                    BYTE *report_buf )
+{
+    HRESULT hr = S_OK;
+    BOOL ret = FALSE;
+    BYTE *tmp;
+
+    if (!impl->device || impl->device == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+    if (!report_buf && report_len) return E_POINTER;
+    if (report_len >= 0x10000) return E_INVALIDARG;
+    if (!(tmp = calloc( 1, report_len + 1 ))) return E_OUTOFMEMORY;
+
+    tmp[0] = id;
+    if (op != HID_GET_FEATURE) memcpy( tmp + 1, report_buf, report_len );
+    switch (op)
+    {
+    case HID_GET_FEATURE: ret = HidD_GetFeature( impl->device, tmp, report_len + 1 ); break;
+    case HID_SET_FEATURE: ret = HidD_SetFeature( impl->device, tmp, report_len + 1 ); break;
+    case HID_SET_OUTPUT: ret = HidD_SetOutputReport( impl->device, tmp, report_len + 1 ); break;
+    }
+    if (!ret) hr = HRESULT_FROM_WIN32( GetLastError() );
+    else if (op == HID_GET_FEATURE) memcpy( report_buf, tmp + 1, report_len );
+
+    free( tmp );
+    return hr;
+}
+
+static HRESULT WINAPI hid_provider_GetFeatureReport( IHidGameControllerProvider *iface, BYTE id, UINT32 report_len,
