+/* a controller that implements the input sink hears when its input starts and stops */
+static void controller_notify_input( struct controller *controller, BOOL resumed )
+{
+    IGameControllerInputSink *sink;
+    UINT64 timestamp = GetTickCount64() * 10000;
+
+    if (FAILED(IInspectable_QueryInterface( controller->IInspectable_inner, &IID_IGameControllerInputSink,
+                                            (void **)&sink ))) return;
+    if (resumed) IGameControllerInputSink_OnInputResumed( sink, timestamp );
+    else IGameControllerInputSink_OnInputSuspended( sink, timestamp );
+    IGameControllerInputSink_Release( sink );
+}
