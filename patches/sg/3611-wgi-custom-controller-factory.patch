new file mode 100644
index 0000000..931a336
--- /dev/null
+++ b/dlls/windows.gaming.input/weakref.c
@@ -0,0 +1,178 @@
+/* WinRT Windows.Gaming.Input implementation: weak references
+ *
+ * Copyright 2026 Stained Glass OS
+ *
