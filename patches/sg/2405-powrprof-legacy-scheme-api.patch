+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* Schemes 0 to 5 are the ones Windows has always had (Home/Office Desk,
+ * Portable/Laptop, Presentation, Always On, Minimal Power Management, Max
+ * Battery). Their policies are not stored: they come from the settings of the
+ * GUID scheme each one stands for (balanced, high performance, power saver),
+ * so the two APIs agree, until a program writes a policy, which is then kept
+ * under HKCU\Control Panel\PowerCfg:
+ *   PowerPolicies\<id>      Name, Description, Policies (a POWER_POLICY)
+ *   ProcessorPolicies\<id>  Policies (a MACHINE_PROCESSOR_POWER_POLICY)
+ *   GlobalPowerPolicy       Policies (a GLOBAL_POWER_POLICY)
+ *   CurrentPowerPolicy      the active scheme's id (with the GUID scheme that
+ *                           was active when it was set: if the other API has
+ *                           changed it since, that wins)
+ *   LastID                  the last id handed out to a new scheme
+ * New schemes are numbered from 6. */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winnt.h"
+#include "winreg.h"
+#include "winternl.h"
+#include "powrprof.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(powrprof);
+
+#define POWERCFG_KEY L"Control Panel\\PowerCfg"
+#define LAST_BUILTIN 5
+#define POWER_ACTION_QUERY_ALLOWED 0x00000001
+#define POWER_ACTION_UI_ALLOWED    0x00000002
+#ifndef NEWSCHEME
+#define NEWSCHEME ((UINT)-1)
+#endif
+
+static const GUID scheme_balanced = {0x381b4222,0xf694,0x41f0,{0x96,0x85,0xff,0x5b,0xb2,0x60,0xdf,0x2e}};
+static const GUID scheme_high     = {0x8c5e7fda,0xe8bf,0x4a96,{0x9a,0x85,0xa6,0xe2,0x3a,0x8c,0x63,0x5c}};
+static const GUID scheme_saver    = {0xa1841308,0x3541,0x4fab,{0xbc,0x81,0xf7,0x15,0x56,0xf2,0x0b,0x4a}};
+
+static const GUID set_video_off    = {0x3c0bc021,0xc8a8,0x4e07,{0xa9,0x73,0x6b,0x14,0xcb,0xcb,0x2b,0x7e}};
+static const GUID set_disk_off     = {0x6738e2c4,0xe8a5,0x4a42,{0xb1,0x6a,0xe0,0x40,0xe7,0x69,0x75,0x6e}};
+static const GUID set_standby      = {0x29f6c1db,0x86da,0x48c5,{0x9f,0xdb,0xf2,0xb6,0x7b,0x1f,0x44,0xda}};
+static const GUID set_hibernate    = {0x9d7815a6,0x7ee4,0x497e,{0x88,0x88,0x51,0x5a,0x05,0xf0,0x23,0x64}};
+static const GUID set_lid          = {0x5ca83367,0x6e45,0x459f,{0xa2,0x7b,0x47,0x6b,0x1d,0x01,0xc9,0x36}};
+static const GUID set_power_button = {0x7648efa3,0xdd9c,0x4e3e,{0xb5,0x66,0x50,0xf9,0x29,0x38,0x62,0x80}};
+static const GUID set_sleep_button = {0x96996bc0,0xad50,0x47ec,{0x92,0x3b,0x6f,0x41,0x87,0x4d,0xd9,0xeb}};
+static const GUID set_cpu_min      = {0x893dee8e,0x2bef,0x41e0,{0x89,0xc6,0xb5,0x5d,0x09,0x29,0x96,0x4c}};
+static const GUID set_cpu_max      = {0xbc5038f7,0x23e0,0x4960,{0x96,0xda,0x33,0xab,0xaf,0x59,0x35,0xec}};
+static const GUID set_crit_action  = {0x637ea02f,0xbbcb,0x4015,{0x8e,0x2c,0xa1,0xc7,0xb9,0xc0,0xb5,0x46}};
+static const GUID set_crit_level   = {0x9a66d8d7,0x4ff7,0x4ef9,{0xb5,0xa2,0x5a,0x32,0x6c,0xa2,0xa4,0x69}};
+static const GUID set_low_action   = {0xd8742dcb,0x3e6a,0x4b3c,{0xb3,0xfe,0x37,0x46,0x23,0xcd,0xcf,0x06}};
+static const GUID set_low_level    = {0x8183ba9a,0xe910,0x48da,{0x87,0x69,0x14,0xae,0x6d,0xc1,0x17,0x0a}};
+
+static const struct
+{
+    const WCHAR *name;
+    const WCHAR *description;
+    const GUID *guid;
+} builtin[] =
+{
+    { L"Home/Office Desk", L"This scheme is suited to most desktop computers.", &scheme_balanced },
+    { L"Portable/Laptop", L"This scheme is suited to portable computers.", &scheme_balanced },
+    { L"Presentation", L"This scheme keeps the display on during presentations.", &scheme_high },
+    { L"Always On", L"This scheme keeps the computer running at full power.", &scheme_high },
+    { L"Minimal Power Management", L"This scheme saves some power without getting in the way.", &scheme_balanced },
+    { L"Max Battery", L"This scheme saves as much power as possible.", &scheme_saver },
+};
+
+static HKEY open_powercfg( BOOL create )
+{
+    HKEY key;
+    LSTATUS ret;
+
+    if (create) ret = RegCreateKeyExW( HKEY_CURRENT_USER, POWERCFG_KEY, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL );
+    else ret = RegOpenKeyExW( HKEY_CURRENT_USER, POWERCFG_KEY, 0, KEY_READ, &key );
+    return ret ? NULL : key;
+}
+
+static HKEY open_sub( const WCHAR *sub, UINT id, BOOL create )
+{
+    WCHAR path[64];
+    HKEY root, key = NULL;
+
+    if (!(root = open_powercfg( create ))) return NULL;
+    if (id == NEWSCHEME) swprintf( path, ARRAY_SIZE(path), L"%s", sub );
+    else swprintf( path, ARRAY_SIZE(path), L"%s\\%u", sub, id );
+    if (create) RegCreateKeyExW( root, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL );
+    else if (RegOpenKeyExW( root, path, 0, KEY_READ, &key )) key = NULL;
+    RegCloseKey( root );
+    return key;
+}
+
+static BOOL fail( DWORD error )
+{
+    SetLastError( error );
+    return FALSE;
+}
+
+static BOOL is_deleted( UINT id )
+{
+    HKEY key = open_sub( L"PowerPolicies", id, FALSE );
+    DWORD deleted = 0, size = sizeof(deleted), type;
+
+    if (key)
+    {
+        if (RegQueryValueExW( key, L"Deleted", NULL, &type, (BYTE *)&deleted, &size ) || type != REG_DWORD) deleted = 0;
+        RegCloseKey( key );
+    }
+    return deleted;
+}
+
+static BOOL has_stored_scheme( UINT id )
+{
+    HKEY key = open_sub( L"PowerPolicies", id, FALSE );
+    DWORD size = 0;
+    BOOL ret = FALSE;
+
+    if (key)
+    {
+        ret = !RegQueryValueExW( key, L"Name", NULL, NULL, NULL, &size ) && !is_deleted( id );
+        RegCloseKey( key );
+    }
+    return ret;
+}
+
+static BOOL scheme_exists( UINT id )
+{
+    if (id <= LAST_BUILTIN) return !is_deleted( id );
+    return has_stored_scheme( id );
+}
+
+/* the GUID scheme a legacy scheme stands for */
+static const GUID *scheme_guid( UINT id )
+{
+    return id <= LAST_BUILTIN ? builtin[id].guid : &scheme_balanced;
+}
+
+static DWORD index_of( const GUID *scheme, const GUID *setting, BOOL dc )
+{
+    DWORD value = 0;
+    if (dc) PowerReadDCValueIndex( NULL, scheme, NULL, setting, &value );
+    else PowerReadACValueIndex( NULL, scheme, NULL, setting, &value );
+    return value;
+}
+
+/* the power action the GUID API's action index stands for */
+static POWER_ACTION to_action( DWORD index )
+{
+    switch (index)
+    {
+    case 1: return PowerActionSleep;
+    case 2: return PowerActionHibernate;
+    case 3: return PowerActionShutdown;
+    default: return PowerActionNone;
+    }
+}
+
+static void fill_action( POWER_ACTION_POLICY *policy, DWORD index )
+{
+    memset( policy, 0, sizeof(*policy) );
+    policy->Action = to_action( index );
+    if (policy->Action != PowerActionNone) policy->Flags = POWER_ACTION_QUERY_ALLOWED | POWER_ACTION_UI_ALLOWED;
+}
+
+static void default_policy( UINT id, POWER_POLICY *policy )
+{
+    const GUID *g = scheme_guid( id );
+    DWORD standby_ac = index_of( g, &set_standby, FALSE ), standby_dc = index_of( g, &set_standby, TRUE );
+    DWORD cpu_max_ac = index_of( g, &set_cpu_max, FALSE ), cpu_max_dc = index_of( g, &set_cpu_max, TRUE );
+
+    memset( policy, 0, sizeof(*policy) );
+    policy->user.Revision = 1;
+    policy->mach.Revision = 1;
+
+    fill_action( &policy->user.IdleAc, standby_ac ? 1 : 0 );
+    fill_action( &policy->user.IdleDc, standby_dc ? 1 : 0 );
+    policy->user.IdleTimeoutAc = standby_ac;
+    policy->user.IdleTimeoutDc = standby_dc;
+    policy->user.IdleSensitivityAc = 50;
+    policy->user.IdleSensitivityDc = 50;
+    policy->user.ThrottlePolicyAc = cpu_max_ac < 100 ? PO_THROTTLE_ADAPTIVE : PO_THROTTLE_NONE;
+    policy->user.ThrottlePolicyDc = cpu_max_dc < 100 ? PO_THROTTLE_ADAPTIVE : PO_THROTTLE_NONE;
+    policy->user.MaxSleepAc = PowerSystemSleeping3;
+    policy->user.MaxSleepDc = PowerSystemSleeping3;
+    policy->user.VideoTimeoutAc = index_of( g, &set_video_off, FALSE );
+    policy->user.VideoTimeoutDc = index_of( g, &set_video_off, TRUE );
+    policy->user.SpindownTimeoutAc = index_of( g, &set_disk_off, FALSE );
+    policy->user.SpindownTimeoutDc = index_of( g, &set_disk_off, TRUE );
+    policy->user.OptimizeForPowerAc = FALSE;
+    policy->user.OptimizeForPowerDc = TRUE;
+    policy->user.FanThrottleToleranceAc = 100;
+    policy->user.FanThrottleToleranceDc = 80;
+    policy->user.ForcedThrottleAc = 100;
+    policy->user.ForcedThrottleDc = 100;
+
+    policy->mach.MinSleepAc = PowerSystemSleeping1;
+    policy->mach.MinSleepDc = PowerSystemSleeping1;
+    policy->mach.ReducedLatencySleepAc = PowerSystemSleeping1;
+    policy->mach.ReducedLatencySleepDc = PowerSystemSleeping1;
+    policy->mach.DozeTimeoutAc = 0;
+    policy->mach.DozeTimeoutDc = 0;
+    policy->mach.DozeS4TimeoutAc = index_of( g, &set_hibernate, FALSE );
+    policy->mach.DozeS4TimeoutDc = index_of( g, &set_hibernate, TRUE );
+    policy->mach.MinThrottleAc = index_of( g, &set_cpu_min, FALSE );
+    policy->mach.MinThrottleDc = index_of( g, &set_cpu_min, TRUE );
+}
+
+static BOOL read_blob( HKEY key, void *data, DWORD size )
+{
+    DWORD got = size, type;
+    return !RegQueryValueExW( key, L"Policies", NULL, &type, data, &got ) && type == REG_BINARY && got == size;
+}
+
+static BOOL read_text( HKEY key, const WCHAR *name, WCHAR **str, DWORD *bytes )
+{
+    DWORD size = 0, type;
+    WCHAR *buf;
+
+    *str = NULL;
+    if (RegQueryValueExW( key, name, NULL, &type, NULL, &size ) || type != REG_SZ) size = 0;
+    if (!(buf = calloc( 1, size + 2 * sizeof(WCHAR) ))) return FALSE;
+    if (size && RegQueryValueExW( key, name, NULL, &type, (BYTE *)buf, &size )) size = 0;
+    *str = buf;
+    *bytes = (wcslen( buf ) + 1) * sizeof(WCHAR);
+    return TRUE;
+}
+
+static void scheme_policy( UINT id, POWER_POLICY *policy )
+{
+    HKEY key = open_sub( L"PowerPolicies", id, FALSE );
+
+    if (key && read_blob( key, policy, sizeof(*policy) ))
+    {
+        RegCloseKey( key );
+        return;
+    }
+    if (key) RegCloseKey( key );
+    default_policy( id, policy );
+}
+
+/***********************************************************************
+ *		ReadPwrScheme (POWRPROF.@)
+ */
+BOOLEAN WINAPI ReadPwrScheme( UINT id, PPOWER_POLICY policy )
+{
+    TRACE( "(%u,%p)\n", id, policy );
+
+    if (!policy) return fail( ERROR_INVALID_PARAMETER );
+    if (!scheme_exists( id )) return fail( ERROR_FILE_NOT_FOUND );
+    scheme_policy( id, policy );
+    return TRUE;
+}
+
+static BOOL store_scheme( UINT id, const WCHAR *name, const WCHAR *description, const POWER_POLICY *policy )
+{
+    HKEY key = open_sub( L"PowerPolicies", id, TRUE );
+    DWORD deleted = 0;
+    LSTATUS ret;
+
+    if (!key) return fail( ERROR_ACCESS_DENIED );
+    ret = RegSetValueExW( key, L"Name", 0, REG_SZ, (const BYTE *)name, (wcslen( name ) + 1) * sizeof(WCHAR) );
+    if (!ret) ret = RegSetValueExW( key, L"Description", 0, REG_SZ, (const BYTE *)description,
+                                    (wcslen( description ) + 1) * sizeof(WCHAR) );
+    if (!ret) ret = RegSetValueExW( key, L"Policies", 0, REG_BINARY, (const BYTE *)policy, sizeof(*policy) );
+    if (!ret) ret = RegSetValueExW( key, L"Deleted", 0, REG_DWORD, (BYTE *)&deleted, sizeof(deleted) );
+    RegCloseKey( key );
+    return ret ? fail( ret ) : TRUE;
+}
+
+static UINT last_id(void)
+{
+    HKEY key = open_powercfg( FALSE );
+    UINT last = LAST_BUILTIN;
+    DWORD size, type;
+    WCHAR str[16];
+    WCHAR name[16];
+    HKEY sub;
+    DWORD i;
+
+    if (!key) return last;
+    size = sizeof(str) - sizeof(WCHAR);
+    memset( str, 0, sizeof(str) );
+    if (!RegQueryValueExW( key, L"LastID", NULL, &type, (BYTE *)str, &size ) && type == REG_SZ)
+        last = max( last, wcstoul( str, NULL, 10 ));
+    if (!RegOpenKeyExW( key, L"PowerPolicies", 0, KEY_READ, &sub ))
+    {
+        for (i = 0; ; i++)
+        {
+            DWORD len = ARRAY_SIZE(name);
+            if (RegEnumKeyExW( sub, i, name, &len, NULL, NULL, NULL, NULL )) break;
+            last = max( last, wcstoul( name, NULL, 10 ));
+        }
+        RegCloseKey( sub );
+    }
+    RegCloseKey( key );
+    return last;
+}
+
+/***********************************************************************
+ *		WritePwrScheme (POWRPROF.@)
+ */
+BOOLEAN WINAPI WritePwrScheme( PUINT id, LPWSTR name, LPWSTR description, PPOWER_POLICY policy )
+{
+    UINT scheme;
+    HKEY key;
+    WCHAR str[16];
+
+    TRACE( "(%p,%s,%s,%p)\n", id, debugstr_w(name), debugstr_w(description), policy );
+
+    if (!id || !name || !description || !policy) return fail( ERROR_INVALID_PARAMETER );
+    if (*id == NEWSCHEME)
+    {
+#ifdef SG_MUTANT_LPW_NEWID
+        scheme = LAST_BUILTIN;
+#else
+        scheme = last_id() + 1;
+#endif
+        if ((key = open_powercfg( TRUE )))
+        {
+            swprintf( str, ARRAY_SIZE(str), L"%u", scheme );
+            RegSetValueExW( key, L"LastID", 0, REG_SZ, (BYTE *)str, (wcslen( str ) + 1) * sizeof(WCHAR) );
+            RegCloseKey( key );
+        }
+    }
+    else scheme = *id;
+
+    if (!store_scheme( scheme, name, description, policy )) return FALSE;
+    *id = scheme;
+    return TRUE;
+}
+
+/***********************************************************************
+ *		DeletePwrScheme (POWRPROF.@)
+ */
+BOOLEAN WINAPI DeletePwrScheme( UINT id )
+{
+    UINT active;
+    HKEY key;
+
+    TRACE( "(%u)\n", id );
+
+    if (!scheme_exists( id )) return fail( ERROR_FILE_NOT_FOUND );
+    if (GetActivePwrScheme( &active ) && active == id
+#ifdef SG_MUTANT_LPW_DELETE_ACTIVE
+            && FALSE
+#endif
+            ) return fail( ERROR_ACCESS_DENIED );
+
+    if (id <= LAST_BUILTIN)
+    {
+        DWORD one = 1;
+        if (!(key = open_sub( L"PowerPolicies", id, TRUE ))) return fail( ERROR_ACCESS_DENIED );
+        RegSetValueExW( key, L"Deleted", 0, REG_DWORD, (BYTE *)&one, sizeof(one) );
+        RegCloseKey( key );
+    }
+    else
+    {
+        HKEY root = open_sub( L"PowerPolicies", NEWSCHEME, TRUE );
+        WCHAR name[16];
+        if (!root) return fail( ERROR_ACCESS_DENIED );
+        swprintf( name, ARRAY_SIZE(name), L"%u", id );
+        RegDeleteTreeW( root, name );
+        RegCloseKey( root );
+    }
+    if ((key = open_sub( L"ProcessorPolicies", id, FALSE )))
+    {
+        WCHAR name[16];
+        HKEY root = open_sub( L"ProcessorPolicies", NEWSCHEME, TRUE );
+        RegCloseKey( key );
+        if (root)
+        {
+            swprintf( name, ARRAY_SIZE(name), L"%u", id );
+            RegDeleteTreeW( root, name );
+            RegCloseKey( root );
+        }
+    }
+    return TRUE;
+}
+
+static int compare_uint( const void *a, const void *b )
+{
+    UINT x = *(const UINT *)a, y = *(const UINT *)b;
+    return x < y ? -1 : x > y;
+}
+
+/***********************************************************************
+ *		EnumPwrSchemes (POWRPROF.@)
+ */
+BOOLEAN WINAPI EnumPwrSchemes( PWRSCHEMESENUMPROC proc, LPARAM param )
+{
+    UINT ids[128];
+    unsigned int count = 0, i;
+    HKEY key;
+    WCHAR name[16];
+
+    TRACE( "(%p,%Id)\n", proc, param );
+
+    if (!proc) return fail( ERROR_INVALID_PARAMETER );
+
+    for (i = 0; i <= LAST_BUILTIN; i++) if (!is_deleted( i )) ids[count++] = i;
+    if ((key = open_sub( L"PowerPolicies", NEWSCHEME, FALSE )))
+    {
+        for (i = 0; count < ARRAY_SIZE(ids); i++)
+        {
+            DWORD len = ARRAY_SIZE(name);
+            UINT id;
+            if (RegEnumKeyExW( key, i, name, &len, NULL, NULL, NULL, NULL )) break;
+            id = wcstoul( name, NULL, 10 );
+            if (id > LAST_BUILTIN && has_stored_scheme( id )) ids[count++] = id;
+        }
+        RegCloseKey( key );
+    }
+    qsort( ids, count, sizeof(ids[0]), compare_uint );
+
+    for (i = 0; i < count; i++)
+    {
+        POWER_POLICY policy;
+        WCHAR *scheme_name, *desc;
+        DWORD name_bytes, desc_bytes;
+        BOOLEAN cont;
+
+        if ((key = open_sub( L"PowerPolicies", ids[i], FALSE )))
+        {
+            read_text( key, L"Name", &scheme_name, &name_bytes );
+            read_text( key, L"Description", &desc, &desc_bytes );
+            RegCloseKey( key );
+        }
+        else
+        {
+            scheme_name = wcsdup( L"" ); name_bytes = sizeof(WCHAR);
+            desc = wcsdup( L"" ); desc_bytes = sizeof(WCHAR);
+        }
+        if (ids[i] <= LAST_BUILTIN && !*scheme_name)
+        {
+            free( scheme_name ); free( desc );
+            scheme_name = wcsdup( builtin[ids[i]].name );
+            desc = wcsdup( builtin[ids[i]].description );
+            name_bytes = (wcslen( scheme_name ) + 1) * sizeof(WCHAR);
+            desc_bytes = (wcslen( desc ) + 1) * sizeof(WCHAR);
+        }
+#ifdef SG_MUTANT_LPW_NAMESIZE
+        name_bytes -= sizeof(WCHAR);
+#endif
+        scheme_policy( ids[i], &policy );
+        cont = proc( ids[i], name_bytes, scheme_name, desc_bytes, desc, &policy, param );
+        free( scheme_name );
+        free( desc );
+#ifndef SG_MUTANT_LPW_ENUM_STOP
+        if (!cont) break;
+#endif
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *		ReadGlobalPwrPolicy (POWRPROF.@)
+ */
+BOOLEAN WINAPI ReadGlobalPwrPolicy( PGLOBAL_POWER_POLICY policy )
+{
+    HKEY key;
+    GUID *active = NULL;
+    const GUID *g = &scheme_balanced;
+    unsigned int i;
+    static const struct { const GUID *level, *action; } discharge[2] =
+        { { &set_crit_level, &set_crit_action }, { &set_low_level, &set_low_action } };
+
+    TRACE( "(%p)\n", policy );
+
+    if (!policy) return fail( ERROR_INVALID_PARAMETER );
+    if ((key = open_sub( L"GlobalPowerPolicy", NEWSCHEME, FALSE )))
+    {
+        BOOL found = read_blob( key, policy, sizeof(*policy) );
+        RegCloseKey( key );
+        if (found) return TRUE;
+    }
+
+    if (!PowerGetActiveScheme( NULL, &active )) g = active;
+    memset( policy, 0, sizeof(*policy) );
+    policy->user.Revision = 1;
+    policy->mach.Revision = 1;
+    fill_action( &policy->user.PowerButtonAc, index_of( g, &set_power_button, FALSE ) );
+    fill_action( &policy->user.PowerButtonDc, index_of( g, &set_power_button, TRUE ) );
+    fill_action( &policy->user.SleepButtonAc, index_of( g, &set_sleep_button, FALSE ) );
+    fill_action( &policy->user.SleepButtonDc, index_of( g, &set_sleep_button, TRUE ) );
+    fill_action( &policy->user.LidCloseAc, index_of( g, &set_lid, FALSE ) );
+    fill_action( &policy->user.LidCloseDc, index_of( g, &set_lid, TRUE ) );
+    for (i = 0; i < 2; i++)
+    {
+        policy->user.DischargePolicy[i].Enable = TRUE;
+        policy->user.DischargePolicy[i].BatteryLevel = index_of( g, discharge[i].level, TRUE );
+        fill_action( &policy->user.DischargePolicy[i].PowerPolicy, index_of( g, discharge[i].action, TRUE ) );
+        policy->user.DischargePolicy[i].MinSystemState = PowerSystemSleeping1;
+    }
+    policy->user.GlobalFlags = EnableSysTrayBatteryMeter | EnableMultiBatteryDisplay;
+    policy->mach.LidOpenWakeAc = PowerSystemWorking;
+    policy->mach.LidOpenWakeDc = PowerSystemWorking;
+    policy->mach.BroadcastCapacityResolution = 100;
+    LocalFree( active );
+    return TRUE;
+}
+
+/***********************************************************************
+ *		WriteGlobalPwrPolicy (POWRPROF.@)
+ */
+BOOLEAN WINAPI WriteGlobalPwrPolicy( PGLOBAL_POWER_POLICY policy )
+{
+    HKEY key;
+    LSTATUS ret;
+
+    TRACE( "(%p)\n", policy );
+
+    if (!policy) return fail( ERROR_INVALID_PARAMETER );
+    if (!(key = open_sub( L"GlobalPowerPolicy", NEWSCHEME, TRUE ))) return fail( ERROR_ACCESS_DENIED );
+    ret = RegSetValueExW( key, L"Policies", 0, REG_BINARY, (BYTE *)policy, sizeof(*policy) );
+    RegCloseKey( key );
+    return ret ? fail( ret ) : TRUE;
+}
+
+/***********************************************************************
+ *		ReadProcessorPwrScheme (POWRPROF.@)
+ */
+BOOLEAN WINAPI ReadProcessorPwrScheme( UINT id, PMACHINE_PROCESSOR_POWER_POLICY policy )
+{
+    HKEY key;
+    unsigned int i, j;
+
+    TRACE( "(%u,%p)\n", id, policy );
+
+    if (!policy) return fail( ERROR_INVALID_PARAMETER );
+    if (!scheme_exists( id )) return fail( ERROR_FILE_NOT_FOUND );
+    if ((key = open_sub( L"ProcessorPolicies", id, FALSE )))
+    {
+        BOOL found = read_blob( key, policy, sizeof(*policy) );
+        RegCloseKey( key );
+        if (found) return TRUE;
+    }
+
+    /* the throttling the GUID scheme asks for: none for a scheme that runs
+     * the processor flat out, adaptive for one that lets it drop */
+    memset( policy, 0, sizeof(*policy) );
+    policy->Revision = 1;
+    for (j = 0; j < 2; j++)
+    {
+        PROCESSOR_POWER_POLICY *p = j ? &policy->ProcessorPolicyDc : &policy->ProcessorPolicyAc;
+        DWORD max = index_of( scheme_guid( id ), &set_cpu_max, j );
+
+        p->Revision = 1;
+        p->DynamicThrottle = max < 100 ? PO_THROTTLE_ADAPTIVE : PO_THROTTLE_NONE;
+        p->PolicyCount = 3;
+        for (i = 0; i < 3; i++)
+        {
+            p->Policy[i].TimeCheck = 100000;
+            p->Policy[i].DemotePercent = 50;
+            p->Policy[i].PromotePercent = 50;
+            p->Policy[i].AllowDemotion = 1;
+            p->Policy[i].AllowPromotion = 1;
+        }
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *		WriteProcessorPwrScheme (POWRPROF.@)
+ */
+BOOLEAN WINAPI WriteProcessorPwrScheme( UINT id, PMACHINE_PROCESSOR_POWER_POLICY policy )
+{
+    HKEY key;
+    LSTATUS ret;
+
+    TRACE( "(%u,%p)\n", id, policy );
+
+    if (!policy) return fail( ERROR_INVALID_PARAMETER );
+    if (!scheme_exists( id )) return fail( ERROR_FILE_NOT_FOUND );
+    if (!(key = open_sub( L"ProcessorPolicies", id, TRUE ))) return fail( ERROR_ACCESS_DENIED );
+    ret = RegSetValueExW( key, L"Policies", 0, REG_BINARY, (BYTE *)policy, sizeof(*policy) );
+    RegCloseKey( key );
+    return ret ? fail( ret ) : TRUE;
+}
+
+/***********************************************************************
+ *		GetActivePwrScheme (POWRPROF.@)
+ */
+BOOLEAN WINAPI GetActivePwrScheme( PUINT id )
+{
+    GUID *active = NULL;
+    HKEY key;
+    WCHAR str[16], guid_str[64];
+    DWORD size, type;
+    UINT current = (UINT)-1;
+    BOOL same_guid = FALSE;
+    UINT derived = 0;
+
+    TRACE( "(%p)\n", id );
+
+    if (!id) return fail( ERROR_INVALID_PARAMETER );
+
+    if (!PowerGetActiveScheme( NULL, &active ))
+    {
+        if (IsEqualGUID( active, &scheme_high )) derived = 3;
+        else if (IsEqualGUID( active, &scheme_saver )) derived = 5;
+    }
+    if ((key = open_powercfg( FALSE )))
+    {
+        memset( str, 0, sizeof(str) );
+        size = sizeof(str) - sizeof(WCHAR);
+        if (!RegQueryValueExW( key, L"CurrentPowerPolicy", NULL, &type, (BYTE *)str, &size ) && type == REG_SZ)
+            current = wcstoul( str, NULL, 10 );
+        memset( guid_str, 0, sizeof(guid_str) );
+        size = sizeof(guid_str) - sizeof(WCHAR);
+        if (active && !RegQueryValueExW( key, L"CurrentPowerPolicyGuid", NULL, &type, (BYTE *)guid_str, &size )
+                && type == REG_SZ)
+        {
+            GUID stored;
+            UNICODE_STRING us;
+            RtlInitUnicodeString( &us, guid_str );
+            same_guid = !RtlGUIDFromString( &us, &stored ) && IsEqualGUID( &stored, active );
+        }
+        RegCloseKey( key );
+    }
+#ifdef SG_MUTANT_LPW_ACTIVE_STALE
+    same_guid = TRUE;
+#endif
+    LocalFree( active );
+    *id = (same_guid && current != (UINT)-1 && scheme_exists( current )) ? current : derived;
+    return TRUE;
+}
+
+/***********************************************************************
+ *		SetActivePwrScheme (POWRPROF.@)
+ */
+BOOLEAN WINAPI SetActivePwrScheme( UINT id, PGLOBAL_POWER_POLICY global, PPOWER_POLICY policy )
+{
+    HKEY key;
+    WCHAR str[16], guid_str[64];
+    const GUID *guid;
+    UNICODE_STRING us;
+
+    TRACE( "(%u,%p,%p)\n", id, global, policy );
+
+    if (!scheme_exists( id )) return fail( ERROR_FILE_NOT_FOUND );
+    if (global && !WriteGlobalPwrPolicy( global )) return FALSE;
+    if (policy)
+    {
+        HKEY sub = open_sub( L"PowerPolicies", id, TRUE );
+        LSTATUS ret;
+
+        if (!sub) return fail( ERROR_ACCESS_DENIED );
+        ret = RegSetValueExW( sub, L"Policies", 0, REG_BINARY, (BYTE *)policy, sizeof(*policy) );
+        RegCloseKey( sub );
+        if (ret) return fail( ret );
+    }
+
+    guid = scheme_guid( id );
+    if (PowerSetActiveScheme( NULL, guid )) return fail( ERROR_ACCESS_DENIED );
+
+    if (!(key = open_powercfg( TRUE ))) return fail( ERROR_ACCESS_DENIED );
+    swprintf( str, ARRAY_SIZE(str), L"%u", id );
+    RegSetValueExW( key, L"CurrentPowerPolicy", 0, REG_SZ, (BYTE *)str, (wcslen( str ) + 1) * sizeof(WCHAR) );
+    if (!RtlStringFromGUID( guid, &us ))
+    {
+        wcscpy( guid_str, us.Buffer );
+        RtlFreeUnicodeString( &us );
+        RegSetValueExW( key, L"CurrentPowerPolicyGuid", 0, REG_SZ, (BYTE *)guid_str, (wcslen( guid_str ) + 1) * sizeof(WCHAR) );
+    }
+    RegCloseKey( key );
+    return TRUE;
+}
+
+/***********************************************************************
+ *		GetCurrentPowerPolicies (POWRPROF.@)
+ */
+BOOLEAN WINAPI GetCurrentPowerPolicies( PGLOBAL_POWER_POLICY global, PPOWER_POLICY policy )
+{
+    UINT id;
+
+    TRACE( "(%p,%p)\n", global, policy );
+
+    if (global && !ReadGlobalPwrPolicy( global )) return FALSE;
+    if (policy)
+    {
+        if (!GetActivePwrScheme( &id ) || !ReadPwrScheme( id, policy )) return FALSE;
+    }
+    return TRUE;
+}
