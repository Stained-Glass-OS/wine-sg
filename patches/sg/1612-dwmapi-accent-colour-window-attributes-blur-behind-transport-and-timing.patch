@@ -217,9 +289,14 @@ HRESULT WINAPI DwmGetGraphicsStreamClient(UINT uIndex, UUID *pClientUuid)
  */
 HRESULT WINAPI DwmGetTransportAttributes(BOOL *pfIsRemoting, BOOL *pfIsConnected, DWORD *pDwGeneration)
 {
-    FIXME("(%p, %p, %p) stub\n", pfIsRemoting, pfIsConnected, pDwGeneration);
+    /* a local session: composed here, not remoted */
+    TRACE("(%p, %p, %p)\n", pfIsRemoting, pfIsConnected, pDwGeneration);
 
-    return DWM_E_COMPOSITIONDISABLED;
+    if (!pfIsRemoting || !pfIsConnected || !pDwGeneration) return E_INVALIDARG;
+    *pfIsRemoting = GetSystemMetrics( SM_REMOTESESSION ) != 0;
+    *pfIsConnected = TRUE;
+    *pDwGeneration = 0;
+    return S_OK;
 }
 
