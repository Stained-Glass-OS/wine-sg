@@ -99,11 +101,41 @@ HRESULT WINAPI DwmExtendFrameIntoClientArea(HWND hwnd, const MARGINS* margins)
 /**********************************************************************
  *           DwmGetColorizationColor      (DWMAPI.@)
  */
+/* The accent colour Settings > Personalization > Colours keeps: DWM's
+ * ColorizationColor (ARGB), else the accent (ABGR) with the usual alpha, else
+ * Stained Glass purple; and whether transparency is off. */
+static DWORD get_colorization( BOOL *opaque )
+{
+    DWORD value, size = sizeof(value), color = 0xc47b2fbe;
+
+    if (!RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\DWM", L"ColorizationColor",
+                       RRF_RT_REG_DWORD, NULL, &value, &size ))
+        color = value;
+    else if (size = sizeof(value), !RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\DWM",
+                                                  L"AccentColor", RRF_RT_REG_DWORD, NULL, &value, &size ))
+        color = 0xc4000000 | (value & 0xff) << 16 | (value & 0xff00) | (value >> 16 & 0xff);
+    if (opaque)
+    {
+        size = sizeof(value);
+        *opaque = !RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
+                                 L"EnableTransparency", RRF_RT_REG_DWORD, NULL, &value, &size ) && !value;
+    }
+    return color;
+}
+
 HRESULT WINAPI DwmGetColorizationColor(DWORD *colorization, BOOL *opaque_blend)
 {
+#ifndef SG_MUTANT_NO_DWM_ATTRIBUTES
+    TRACE("(%p, %p)\n", colorization, opaque_blend);
+
+    if (!colorization || !opaque_blend) return E_INVALIDARG;
+    *colorization = get_colorization( opaque_blend );
+    return S_OK;
+#else
     FIXME("(%p, %p) stub\n", colorization, opaque_blend);
 
     return E_NOTIMPL;
+#endif
 }
 
