 HRESULT WINAPI DwmSetWindowAttribute(HWND hwnd, DWORD attributenum, LPCVOID attribute, DWORD size)
 {
+#ifdef SG_MUTANT_NO_DWM_ATTRIBUTES
     static BOOL once;
+#endif
     DWORD pid;
 
     if (attributenum == DWMWA_CLOAK)
@@ -197,9 +230,48 @@ HRESULT WINAPI DwmSetWindowAttribute(HWND hwnd, DWORD attributenum, LPCVOID attr
         return S_OK;
     }
 
+#ifndef SG_MUTANT_NO_DWM_ATTRIBUTES
+    /* The rest change how DWM would treat the window (transitions, peek,
+     * Flip3D, iconic previews, the border colour, the backdrop); they are
+     * kept as properties of the window, checked as Windows checks them, and
+     * the non-client rendering policy is read back. Unknown attributes and
+     * get-only ones are refused, as Windows refuses them. */
+    {
+        static const WCHAR *names[DWMWA_LAST] =
+        {
+            [DWMWA_NCRENDERING_POLICY] = L"__wine_dwm_ncrp",
+            [DWMWA_TRANSITIONS_FORCEDISABLED] = L"__wine_dwm_notransitions",
+            [DWMWA_ALLOW_NCPAINT] = L"__wine_dwm_ncpaint",
+            [DWMWA_NONCLIENT_RTL_LAYOUT] = L"__wine_dwm_ncrtl",
+            [DWMWA_FORCE_ICONIC_REPRESENTATION] = L"__wine_dwm_iconic",
+            [DWMWA_FLIP3D_POLICY] = L"__wine_dwm_flip3d",
+            [DWMWA_HAS_ICONIC_BITMAP] = L"__wine_dwm_iconic_bitmap",
+            [DWMWA_DISALLOW_PEEK] = L"__wine_dwm_nopeek",
+            [DWMWA_EXCLUDED_FROM_PEEK] = L"__wine_dwm_peek_excluded",
+            [DWMWA_FREEZE_REPRESENTATION] = L"__wine_dwm_freeze",
+            [DWMWA_PASSIVE_UPDATE_MODE] = L"__wine_dwm_passive",
+            [DWMWA_USE_HOSTBACKDROPBRUSH] = L"__wine_dwm_hostbackdrop",
+            [DWMWA_BORDER_COLOR] = L"__wine_dwm_border_color",
+            [DWMWA_SYSTEMBACKDROP_TYPE] = L"__wine_dwm_backdrop",
+        };
+        DWORD value;
+
+        if (attributenum >= DWMWA_LAST || !names[attributenum]) return E_INVALIDARG;
+        if (!attribute || size < sizeof(DWORD)) return E_INVALIDARG;
+        if (!GetWindowThreadProcessId(hwnd, &pid)) return E_HANDLE;
+        value = *(const DWORD *)attribute;
+        if (attributenum == DWMWA_NCRENDERING_POLICY && value >= DWMNCRP_LAST) return E_INVALIDARG;
+        if (attributenum == DWMWA_FLIP3D_POLICY && value >= DWMFLIP3D_LAST) return E_INVALIDARG;
+        if (attributenum == DWMWA_SYSTEMBACKDROP_TYPE && value > 4) return E_INVALIDARG;
+        /* stored + 1, so that 0 is not "unset" */
+        SetPropW(hwnd, names[attributenum], (HANDLE)(ULONG_PTR)((ULONG_PTR)value + 1));
+        return S_OK;
+    }
+#else
     if (!once++) FIXME("(%p, %lx, %p, %lx) stub\n", hwnd, attributenum, attribute, size);
 
     return S_OK;
+#endif
 }
 
