@@ -237,7 +314,8 @@ HRESULT WINAPI DwmUnregisterThumbnail(HTHUMBNAIL thumbnail)
  */
 HRESULT WINAPI DwmEnableMMCSS(BOOL enableMMCSS)
 {
-    FIXME("(%d) stub\n", enableMMCSS);
+    /* composition here has no thread to schedule */
+    TRACE("(%d)\n", enableMMCSS);
 
     return S_OK;
 }
@@ -257,9 +335,26 @@ HRESULT WINAPI DwmGetGraphicsStreamTransformHint(UINT uIndex, MilMatrix3x2D *pTr
  */
 HRESULT WINAPI DwmEnableBlurBehindWindow(HWND hWnd, const DWM_BLURBEHIND *pBlurBuf)
 {
+#ifndef SG_MUTANT_NO_DWM_ATTRIBUTES
+    /* Kept as a property of the window (the compositor's glass reads such
+     * properties); failing with E_NOTIMPL made programs drop their glass
+     * windows' alpha altogether. */
+    TRACE("%p %p\n", hWnd, pBlurBuf);
+
+    if (!pBlurBuf) return E_INVALIDARG;
+    if (!IsWindow(hWnd)) return E_HANDLE;
+    if (GetWindowLongW(hWnd, GWL_STYLE) & WS_CHILD) return E_INVALIDARG;
+    if (pBlurBuf->dwFlags & DWM_BB_ENABLE)
+    {
+        if (pBlurBuf->fEnable) SetPropW(hWnd, L"__wine_dwm_blur", (HANDLE)1);
+        else RemovePropW(hWnd, L"__wine_dwm_blur");
+    }
+    return S_OK;
+#else
     FIXME("%p %p\n", hWnd, pBlurBuf);
 
     return E_NOTIMPL;
+#endif
 }
 
 /**********************************************************************
@@ -267,9 +362,9 @@ HRESULT WINAPI DwmEnableBlurBehindWindow(HWND hWnd, const DWM_BLURBEHIND *pBlurB
  */
 BOOL WINAPI DwmDefWindowProc(HWND hWnd, UINT Msg, WPARAM wParam, LPARAM lParam, LRESULT *plResult)
 {
-    static int i;
-
-    if (!i++) FIXME("stub\n");
+    /* DWM draws no caption buttons of its own into extended frames here:
+     * the window's own procedure handles every message */
+    TRACE("%p %#x %#Ix %#Ix %p\n", hWnd, Msg, wParam, lParam, plResult);
 
     return FALSE;
 }
@@ -330,10 +425,59 @@ HRESULT WINAPI DwmGetWindowAttribute(HWND hwnd, DWORD attribute, PVOID pv_attrib
         *(BOOL *)pv_attribute = GetPropW(hwnd, L"__wine_dark_caption") != NULL;
         hr = S_OK;
         break;
+#ifndef SG_MUTANT_NO_DWM_ATTRIBUTES
+    case DWMWA_NCRENDERING_ENABLED:
+    {
+        ULONG_PTR policy = (ULONG_PTR)GetPropW(hwnd, L"__wine_dwm_ncrp");
+
+        /* the frame is composed unless the window turned it off */
+        if (!pv_attribute) return E_INVALIDARG;
+        if (size < sizeof(BOOL)) return E_NOT_SUFFICIENT_BUFFER;
+        *(BOOL *)pv_attribute = !(policy && policy - 1 == DWMNCRP_DISABLED);
+        hr = S_OK;
+        break;
+    }
+    case DWMWA_CAPTION_BUTTON_BOUNDS:
+    {
+        /* the caption buttons' rectangle, in window coordinates */
+        RECT *rect = pv_attribute, window;
+        LONG style = GetWindowLongW(hwnd, GWL_STYLE), exstyle = GetWindowLongW(hwnd, GWL_EXSTYLE);
+        int buttons = 0, frame, width;
+
+        if (!rect) return E_INVALIDARG;
+        if (size < sizeof(*rect)) return E_NOT_SUFFICIENT_BUFFER;
+        if ((style & WS_CAPTION) != WS_CAPTION || !GetWindowRect(hwnd, &window)) return E_INVALIDARG;
+        if (style & WS_SYSMENU)
+        {
+            buttons = 1;
+            if (style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX)) buttons += 2;
+            else if (exstyle & WS_EX_CONTEXTHELP) buttons++;
+        }
+        frame = (style & WS_THICKFRAME) ? GetSystemMetrics(SM_CXSIZEFRAME) : GetSystemMetrics(SM_CXFIXEDFRAME);
+        width = window.right - window.left;
+        rect->right = width - frame;
+        rect->left = rect->right - buttons * GetSystemMetrics(SM_CXSIZE);
+        rect->top = (style & WS_THICKFRAME) ? GetSystemMetrics(SM_CYSIZEFRAME) : GetSystemMetrics(SM_CYFIXEDFRAME);
+        rect->bottom = rect->top + GetSystemMetrics(SM_CYCAPTION) - 1;
+        hr = S_OK;
+        break;
+    }
+    case DWMWA_VISIBLE_FRAME_BORDER_THICKNESS:
+        if (!pv_attribute) return E_INVALIDARG;
+        if (size < sizeof(UINT)) return E_NOT_SUFFICIENT_BUFFER;
+        *(UINT *)pv_attribute = 1;
+        hr = S_OK;
+        break;
+    default:
+        /* set-only and unknown attributes */
+        hr = E_INVALIDARG;
+        break;
+#else
     default:
         FIXME("attribute %ld not implemented.\n", attribute);
         hr = E_NOTIMPL;
         break;
+#endif
     }
 
     return hr;
@@ -374,7 +518,7 @@ static int get_display_frequency(void)
 HRESULT WINAPI DwmGetCompositionTimingInfo(HWND hwnd, DWM_TIMING_INFO *info)
 {
     LARGE_INTEGER performance_frequency, qpc;
-    static int i, display_frequency;
+    static int display_frequency;
 
     if (!info)
         return E_INVALIDARG;
@@ -382,7 +526,7 @@ HRESULT WINAPI DwmGetCompositionTimingInfo(HWND hwnd, DWM_TIMING_INFO *info)
     if (info->cbSize != sizeof(DWM_TIMING_INFO))
         return MILERR_MISMATCHED_SIZE;
 
-    if(!i++) FIXME("(%p %p)\n", hwnd, info);
+    TRACE("(%p %p)\n", hwnd, info);
 
     memset(info, 0, info->cbSize);
     info->cbSize = sizeof(DWM_TIMING_INFO);
@@ -398,6 +542,23 @@ HRESULT WINAPI DwmGetCompositionTimingInfo(HWND hwnd, DWM_TIMING_INFO *info)
 
     QueryPerformanceCounter(&qpc);
     info->qpcVBlank = (qpc.QuadPart / info->qpcRefreshPeriod) * info->qpcRefreshPeriod;
+    /* refreshes and composed frames counted from the clock: one per vblank */
+    info->cRefresh = qpc.QuadPart / info->qpcRefreshPeriod;
+    info->cDXRefresh = info->cRefresh;
+    info->qpcCompose = info->qpcVBlank + info->qpcRefreshPeriod;
+    info->cFrame = info->cRefresh;
+    info->cDXPresent = info->cRefresh;
+    info->cRefreshFrame = info->cRefresh;
+    info->cFrameSubmitted = info->cRefresh;
+    info->cDXPresentSubmitted = info->cRefresh;
+    info->cFrameConfirmed = info->cRefresh;
+    info->cDXPresentConfirmed = info->cRefresh;
+    info->cRefreshConfirmed = info->cRefresh;
+    info->cDXRefreshConfirmed = info->cRefresh;
+    info->cFramesLate = 0;
+    info->cFramePending = 0;
+    info->cRefreshNextDisplayed = info->cRefresh + 1;
+    info->cRefreshNextPresented = info->cRefresh + 1;
 
     return S_OK;
 }
@@ -461,6 +622,23 @@ HRESULT WINAPI DwmSetIconicThumbnail(HWND hwnd, HBITMAP hbmp, DWORD flags)
  */
 HRESULT WINAPI DwmpGetColorizationParameters(void *params)
 {
-    FIXME("(%p) stub\n", params);
-    return E_NOTIMPL;
+    /* the undocumented colorization parameters custom themes read the
+     * accent from: colour, afterglow, their balances, blur balance, glass
+     * reflection intensity, opaque blend */
+    struct
+    {
+        DWORD color, afterglow, color_balance, afterglow_balance, blur_balance, reflection, opaque;
+    } *p = params;
+    BOOL opaque;
+
+    TRACE("(%p)\n", params);
+
+    if (!p) return E_INVALIDARG;
+    p->color = p->afterglow = get_colorization( &opaque );
+    p->color_balance = 8;
+    p->afterglow_balance = 43;
+    p->blur_balance = 49;
+    p->reflection = 0;
+    p->opaque = opaque;
+    return S_OK;
 }
