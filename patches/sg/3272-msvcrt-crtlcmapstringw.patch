From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:55:06 -0700
Subject: [PATCH] msvcrt: __crtLCMapStringW cuts a counted source at its first
 null (3272)

A positive source length is reduced to the length of the string before its first null character, as the C runtime does, before LCMapStringW is called.

diff --git a/dlls/msvcrt/locale.c b/dlls/msvcrt/locale.c
index 85714a7..8846b8f 100644
--- a/dlls/msvcrt/locale.c
+++ b/dlls/msvcrt/locale.c
@@ -932,9 +932,18 @@ done:
 int CDECL __crtLCMapStringW(LCID lcid, DWORD mapflags, const wchar_t *src,
         int srclen, wchar_t *dst, int dstlen, unsigned int codepage, int xflag)
 {
-    FIXME("(lcid %lx, flags %lx, %s(%d), %p(%d), %x, %d), partial stub!\n",
+    TRACE("(lcid %lx, flags %lx, %s(%d), %p(%d), %x, %d)\n",
             lcid, mapflags, debugstr_w(src), srclen, dst, dstlen, codepage, xflag);
 
+#ifndef SG_MUTANT_CRTLCMAP
+    /* a counted source is cut at its first null character */
+    if (src && srclen > 0)
+    {
+        int len = 0;
+        while (len < srclen && src[len]) len++;
+        srclen = len;
+    }
+#endif
     return LCMapStringW(lcid, mapflags, src, srclen, dst, dstlen);
 }
 
