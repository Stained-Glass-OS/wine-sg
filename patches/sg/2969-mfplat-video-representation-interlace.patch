From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfplat: IMFVideoMediaType::GetVideoRepresentation, field-interleaved interlace mapping

GetVideoRepresentation was E_NOTIMPL: the AM_MEDIA_TYPE representation is returned, other GUIDs give
MF_E_UNSUPPORTED_REPRESENTATION. Interlace mapping between MF_MT_INTERLACE_MODE and VIDEOINFOHEADER2 flags
gains FieldInterleavedUpperFirst (Field1First) / LowerFirst; FIXMEs on correct returns dropped.
Gate: test/mfplat-vidrep-gate.sh
---
diff --git a/dlls/mfplat/mediatype.c b/dlls/mfplat/mediatype.c
index 38e17d1..09ec252 100644
--- a/dlls/mfplat/mediatype.c
+++ b/dlls/mfplat/mediatype.c
@@ -649,7 +649,7 @@ static HRESULT WINAPI mediatype_GetRepresentation(IMFMediaType *iface, GUID guid
             || IsEqualGUID(&guid, &FORMAT_MFVideoFormat))
         return MFCreateAMMediaTypeFromMFMediaType(iface, guid, (AM_MEDIA_TYPE **)representation);
 
-    FIXME("Format %s not implemented!\n", debugstr_guid(&guid));
+    WARN("Unsupported representation %s.\n", debugstr_guid(&guid));
     return MF_E_UNSUPPORTED_REPRESENTATION;
 }
 
@@ -1060,9 +1060,19 @@ static const MFVIDEOFORMAT * WINAPI video_mediatype_GetVideoFormat(IMFVideoMedia
 static HRESULT WINAPI video_mediatype_GetVideoRepresentation(IMFVideoMediaType *iface, GUID representation,
         void **data, LONG stride)
 {
-    FIXME("%p, %s, %p, %ld.\n", iface, debugstr_guid(&representation), data, stride);
+    TRACE("%p, %s, %p, %ld.\n", iface, debugstr_guid(&representation), data, stride);
 
-    return E_NOTIMPL;
+    if (!data)
+        return E_POINTER;
+
+    /* only the DirectShow AM_MEDIA_TYPE representation is supported; the stride does not alter the format block */
+#ifndef SG_MUTANT_VIDREP_UNSUPPORTED
+    if (IsEqualGUID(&representation, &AM_MEDIA_TYPE_REPRESENTATION))
+        return MFCreateAMMediaTypeFromMFMediaType((IMFMediaType *)iface, GUID_NULL, (AM_MEDIA_TYPE **)data);
+#endif
+
+    *data = NULL;
+    return MF_E_UNSUPPORTED_REPRESENTATION;
 }
 
 static const IMFVideoMediaTypeVtbl videomediatypevtbl =
@@ -4447,8 +4457,14 @@ static HRESULT init_media_type_from_video_info(IMFMediaType *media_type, const V
             mediatype_set_uint32(media_type, &MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive, &hr);
         else if (vih->dwInterlaceFlags & AMINTERLACE_DisplayModeBobOrWeave)
             mediatype_set_uint32(media_type, &MF_MT_INTERLACE_MODE, MFVideoInterlace_MixedInterlaceOrProgressive, &hr);
+#ifdef SG_MUTANT_INTERLACE_UPPER
+        else if (0)
+#else
+        else if (vih->dwInterlaceFlags & AMINTERLACE_Field1First)
+#endif
+            mediatype_set_uint32(media_type, &MF_MT_INTERLACE_MODE, MFVideoInterlace_FieldInterleavedUpperFirst, &hr);
         else
-            FIXME("dwInterlaceFlags %#lx not implemented\n", vih->dwInterlaceFlags);
+            mediatype_set_uint32(media_type, &MF_MT_INTERLACE_MODE, MFVideoInterlace_FieldInterleavedLowerFirst, &hr);
     }
 
     if (SUCCEEDED(mf_get_stride_for_bitmap_info_header(subtype->Data1, &vih->bmiHeader, &stride)))
@@ -4734,8 +4750,12 @@ static void init_video_info_header2(VIDEOINFOHEADER2 *vih, const GUID *subtype,
     case MFVideoInterlace_MixedInterlaceOrProgressive:
         vih->dwInterlaceFlags = AMINTERLACE_DisplayModeBobOrWeave | AMINTERLACE_IsInterlaced;
         break;
+#ifndef SG_MUTANT_INTERLACE_UPPER
+    case MFVideoInterlace_FieldInterleavedUpperFirst:
+        vih->dwInterlaceFlags = AMINTERLACE_IsInterlaced | AMINTERLACE_Field1First;
+#endif
+        break;
     default:
-        FIXME("MF_MT_INTERLACE_MODE %u not implemented!\n", value);
         vih->dwInterlaceFlags = AMINTERLACE_IsInterlaced;
         break;
     }
