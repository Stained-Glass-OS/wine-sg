+ */
+
+import "unknwn.idl";
+
+cpp_quote("typedef INT64 AudioStateMonitorRegistrationHandle;")
+
+typedef enum AudioStateMonitorSoundLevel
+{
+    Muted,
+    Low,
+    Full,
+} AudioStateMonitorSoundLevel;
+
+interface IAudioStateMonitor;
+
+cpp_quote("typedef void (CALLBACK *PAudioStateMonitorCallback)(IAudioStateMonitor *audio_state_monitor, void *context);")
+
+/* The IID is not published in the documentation: an assumption, see the note. */
+[
+    local,
+    object,
+    uuid(63bd8738-e30d-4c77-bf5c-834e87c657e2)
+]
+interface IAudioStateMonitor : IUnknown
+{
+    AudioStateMonitorSoundLevel GetSoundLevel();
+    HRESULT RegisterCallback([in] void *callback, [in, optional] void *context,
+                             [out] INT64 *registration);
+    void UnregisterCallback([in] INT64 registration);
+}
diff --git a/dlls/windows.media.mediacontrol/audiostate.c b/dlls/windows.media.mediacontrol/audiostate.c
new file mode 100644
index 0000000..68f3b0f
--- /dev/null
+++ b/dlls/windows.media.mediacontrol/audiostate.c
@@ -0,0 +1,209 @@
+/* audiostatemonitorapi.h: IAudioStateMonitor and its eight factory functions.
+ *
+ * Written from the documentation. Windows lowers or mutes streams for system
+ * events (alarms, background capture); nothing here ever does, so a monitor
+ * always reports Full and never calls its callbacks. Registrations are kept
+ * until UnregisterCallback so the handles behave.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "initguid.h"
+#include "audiosessiontypes.h"
+#include "mmdeviceapi.h"
+#include "audio.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mediacontrol);
+
+typedef void (CALLBACK *audio_state_callback)( IAudioStateMonitor *monitor, void *context );
+
+struct registration
+{
+    struct list entry;
+    INT64 handle;
+    audio_state_callback callback;
+    void *context;
+};
+
+struct audio_state_monitor
+{
+    IAudioStateMonitor IAudioStateMonitor_iface;
+    LONG ref;
+    BOOL capture;
+    CRITICAL_SECTION cs;
+    struct list registrations;
+    INT64 next_handle;
+};
+
+static inline struct audio_state_monitor *impl_from_IAudioStateMonitor( IAudioStateMonitor *iface )
+{
+    return CONTAINING_RECORD( iface, struct audio_state_monitor, IAudioStateMonitor_iface );
+}
+
+static HRESULT WINAPI monitor_QueryInterface( IAudioStateMonitor *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAudioStateMonitor ))
+    {
+        *out = iface;
+        IAudioStateMonitor_AddRef( iface );
+        return S_OK;
+    }
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI monitor_AddRef( IAudioStateMonitor *iface )
+{
+    struct audio_state_monitor *impl = impl_from_IAudioStateMonitor( iface );
+#ifdef SG_MUTANT_ASM_REF
+    ULONG ref = impl->ref;
+#else
+    ULONG ref = InterlockedIncrement( &impl->ref );
+#endif
+    TRACE( "iface %p, ref %lu\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI monitor_Release( IAudioStateMonitor *iface )
+{
+    struct audio_state_monitor *impl = impl_from_IAudioStateMonitor( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    struct registration *reg, *next;
+
+    TRACE( "iface %p, ref %lu\n", iface, ref );
+    if (!ref)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE( reg, next, &impl->registrations, struct registration, entry )
+        {
+            list_remove( &reg->entry );
+            free( reg );
+        }
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static AudioStateMonitorSoundLevel WINAPI monitor_GetSoundLevel( IAudioStateMonitor *iface )
+{
+    TRACE( "iface %p\n", iface );
+#ifdef SG_MUTANT_ASM_LEVEL
+    return Low;
+#else
+    return Full;
+#endif
+}
+
+static HRESULT WINAPI monitor_RegisterCallback( IAudioStateMonitor *iface, void *callback, void *context,
+                                                INT64 *registration )
+{
+    struct audio_state_monitor *impl = impl_from_IAudioStateMonitor( iface );
+    struct registration *reg;
+
+    TRACE( "iface %p, callback %p, context %p, registration %p\n", iface, callback, context, registration );
+
+    if (!registration) return E_POINTER;
+    *registration = 0;
+    if (!callback) return E_INVALIDARG;
+    if (!(reg = calloc( 1, sizeof(*reg) ))) return E_OUTOFMEMORY;
+    reg->callback = callback;
+    reg->context = context;
+
+    EnterCriticalSection( &impl->cs );
+#ifdef SG_MUTANT_ASM_HANDLE
+    reg->handle = 1;
+#else
+    reg->handle = impl->next_handle++;
+#endif
+    list_add_tail( &impl->registrations, &reg->entry );
+    *registration = reg->handle;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static void WINAPI monitor_UnregisterCallback( IAudioStateMonitor *iface, INT64 registration )
+{
+    struct audio_state_monitor *impl = impl_from_IAudioStateMonitor( iface );
+    struct registration *reg;
+
+    TRACE( "iface %p, registration %I64d\n", iface, registration );
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( reg, &impl->registrations, struct registration, entry )
+    {
+        if (reg->handle != registration) continue;
+        list_remove( &reg->entry );
+        free( reg );
+        break;
+    }
+    LeaveCriticalSection( &impl->cs );
+}
+
+static const IAudioStateMonitorVtbl monitor_vtbl =
+{
+    monitor_QueryInterface,
+    monitor_AddRef,
+    monitor_Release,
+    monitor_GetSoundLevel,
+    monitor_RegisterCallback,
+    monitor_UnregisterCallback,
+};
+
+static HRESULT create_monitor( BOOL capture, IAudioStateMonitor **out )
+{
+    struct audio_state_monitor *impl;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAudioStateMonitor_iface.lpVtbl = &monitor_vtbl;
+    impl->ref = 1;
+    impl->capture = capture;
+    impl->next_handle = 1;
+    list_init( &impl->registrations );
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": audio_state_monitor.cs");
+    *out = &impl->IAudioStateMonitor_iface;
+    return S_OK;
+}
+
+/* Which streams a monitor covers (category, device) only matters when the
+ * system lowers them, which it never does here: the arguments are accepted. */
+
+HRESULT WINAPI CreateCaptureAudioStateMonitor( IAudioStateMonitor **monitor )
+{
+    TRACE( "monitor %p\n", monitor );
+    return create_monitor( TRUE, monitor );
+}
+
+HRESULT WINAPI CreateRenderAudioStateMonitor( IAudioStateMonitor **monitor )
+{
+    TRACE( "monitor %p\n", monitor );
+    return create_monitor( FALSE, monitor );
+}
