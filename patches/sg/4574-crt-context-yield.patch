From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcrt: Implement Context::Yield, Context::Oversubscribe and the context's Alloc/Free.

Context::Yield and the context's Yield slot let another thread run (an
external context has no virtual processor of its own to hand over, so it
yields the thread). Context::Oversubscribe and the context's slot pair begin
and end calls and throw invalid_oversubscribe_operation for an end without a
begin, as documented; the thread scheduler gives every chore a thread, so
the extra virtual processor itself changes nothing. The context's Alloc and
Free slots use the Concurrency suballocator.

Gate: test/crt-context-yield-gate.sh (msvcr100, msvcr110, msvcr120, concrt140).
---
 dlls/msvcrt/concurrency.c | 64 +++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 56 insertions(+), 8 deletions(-)

diff --git a/dlls/msvcrt/concurrency.c b/dlls/msvcrt/concurrency.c
index ea0328d..3370dfb 100644
--- a/dlls/msvcrt/concurrency.c
+++ b/dlls/msvcrt/concurrency.c
@@ -77,6 +77,10 @@ typedef struct {
         Context*, (Context*, unsigned int), (this, flags))
 #define call_Context_Block(this) CALL_VTBL_FUNC(this, 24, \
         void, (Context*), (this))
+#define call_Context_Yield(this) CALL_VTBL_FUNC(this, 28, \
+        void, (Context*), (this))
+#define call_Context_Oversubscribe(this, begin) CALL_VTBL_FUNC(this, 36, \
+        void, (Context*, bool), (this, begin))
 
 typedef struct {
     Context *context;
@@ -114,6 +118,7 @@ typedef struct {
     CRITICAL_SECTION beacons_cs;
     struct list beacons;
     size_t inline_depth;  /* _StackGuard::_GetCurrentInlineDepth */
+    LONG oversubscribed;  /* Context::Oversubscribe(true) calls not yet ended */
 } ExternalContextBase;
 extern const vtable_ptr ExternalContextBase_vtable;
 static void ExternalContextBase_ctor(ExternalContextBase*);
@@ -883,6 +888,14 @@ invalid_oversubscribe_operation* __thiscall invalid_oversubscribe_operation_ctor
     return invalid_oversubscribe_operation_ctor_str(this, NULL);
 }
 
+DEFINE_THISCALL_WRAPPER(invalid_oversubscribe_operation_copy_ctor, 8)
+invalid_oversubscribe_operation* __thiscall invalid_oversubscribe_operation_copy_ctor(
+        invalid_oversubscribe_operation *this, const invalid_oversubscribe_operation *rhs)
+{
+    TRACE("(%p %p)\n", this, rhs);
+    return __exception_copy_ctor(this, rhs, &invalid_oversubscribe_operation_vtable);
+}
+
 
 /* ??0message_not_found@Concurrency@@QAE@PBD@Z */
 /* ??0message_not_found@Concurrency@@QEAA@PEBD@Z */
@@ -1099,6 +1112,7 @@ DEFINE_CXX_DATA1(improper_lock, &cexception_cxx_type_info, cexception_dtor)
 DEFINE_CXX_DATA1(improper_scheduler_attach, &cexception_cxx_type_info, cexception_dtor)
 DEFINE_CXX_DATA1(improper_scheduler_detach, &cexception_cxx_type_info, cexception_dtor)
 DEFINE_CXX_DATA1(invalid_multiple_scheduling, &cexception_cxx_type_info, cexception_dtor)
+DEFINE_CXX_DATA1(invalid_oversubscribe_operation, &cexception_cxx_type_info, cexception_dtor)
 DEFINE_CXX_DATA1(invalid_scheduler_policy_key, &cexception_cxx_type_info, cexception_dtor)
 DEFINE_CXX_DATA1(invalid_scheduler_policy_thread_specification, &cexception_cxx_type_info, cexception_dtor)
 DEFINE_CXX_DATA1(invalid_scheduler_policy_value, &cexception_cxx_type_info, cexception_dtor)
@@ -1285,10 +1299,10 @@ void __cdecl Context_Block(void)
 /* ?_Yield@_Context@details@Concurrency@@SAXXZ */
 void __cdecl Context_Yield(void)
 {
-    static unsigned int once;
+    Context *ctx = get_current_context();
 
-    if (!once++)
-        FIXME("()\n");
+    TRACE("()\n");
+    call_Context_Yield(ctx);
 }
 
 /* ?_SpinYield@Context@Concurrency@@SAXXZ */
@@ -1317,7 +1331,10 @@ bool __cdecl Context_IsCurrentTaskCollectionCanceling(void)
 /* ?Oversubscribe@Context@Concurrency@@SAX_N@Z */
 void __cdecl Context_Oversubscribe(bool begin)
 {
-    FIXME("(%x)\n", begin);
+    Context *ctx = get_current_context();
+
+    TRACE("(%x)\n", begin);
+    call_Context_Oversubscribe(ctx, begin);
 }
 
 /* ?ScheduleGroupId@Context@Concurrency@@SAIXZ */
@@ -1453,7 +1470,13 @@ void __thiscall ExternalContextBase_Block(ExternalContextBase *this)
 DEFINE_THISCALL_WRAPPER(ExternalContextBase_Yield, 4)
 void __thiscall ExternalContextBase_Yield(ExternalContextBase *this)
 {
-    FIXME("(%p)->() stub\n", this);
+    TRACE("(%p)->()\n", this);
+
+    /* an external context runs on no virtual processor of the scheduler, so
+     * there is no other context to switch to: let another thread run */
+#ifndef SG_MUTANT_YIELD_NOOP
+    SwitchToThread();
+#endif
 }
 
 DEFINE_THISCALL_WRAPPER(ExternalContextBase_SpinYield, 4)
@@ -1466,20 +1489,44 @@ DEFINE_THISCALL_WRAPPER(ExternalContextBase_Oversubscribe, 8)
 void __thiscall ExternalContextBase_Oversubscribe(
         ExternalContextBase *this, bool oversubscribe)
 {
-    FIXME("(%p)->(%x) stub\n", this, oversubscribe);
+    TRACE("(%p)->(%x)\n", this, oversubscribe);
+
+    /* the thread scheduler runs every chore on a thread of its own, so an
+     * extra virtual processor changes nothing; only the pairing is checked */
+    if (oversubscribe)
+    {
+        this->oversubscribed++;
+        return;
+    }
+#ifndef SG_MUTANT_OVERSUBSCRIBE_UNCHECKED
+    if (!this->oversubscribed)
+    {
+        invalid_oversubscribe_operation e;
+        invalid_oversubscribe_operation_ctor_str(&e, "Oversubscribe(false) without Oversubscribe(true)");
+        _CxxThrowException(&e, &invalid_oversubscribe_operation_exception_type);
+    }
+#endif
+    this->oversubscribed--;
 }
 
+void * CDECL Concurrency_Alloc(size_t);
+void CDECL Concurrency_Free(void*);
+
 DEFINE_THISCALL_WRAPPER(ExternalContextBase_Alloc, 8)
 void* __thiscall ExternalContextBase_Alloc(ExternalContextBase *this, size_t size)
 {
-    FIXME("(%p)->(%Iu) stub\n", this, size);
+    TRACE("(%p)->(%Iu)\n", this, size);
+#ifdef SG_MUTANT_CTX_ALLOC_NULL
     return NULL;
+#endif
+    return Concurrency_Alloc(size);
 }
 
 DEFINE_THISCALL_WRAPPER(ExternalContextBase_Free, 8)
 void __thiscall ExternalContextBase_Free(ExternalContextBase *this, void *addr)
 {
-    FIXME("(%p)->(%p) stub\n", this, addr);
+    TRACE("(%p)->(%p)\n", this, addr);
+    Concurrency_Free(addr);
 }
 
 DEFINE_THISCALL_WRAPPER(ExternalContextBase_EnterCriticalRegionHelper, 4)
@@ -4293,6 +4340,7 @@ void msvcrt_init_concurrency(void *base)
     init_improper_scheduler_attach_cxx(base);
     init_improper_scheduler_detach_cxx(base);
     init_invalid_multiple_scheduling_cxx(base);
+    init_invalid_oversubscribe_operation_cxx(base);
     init_invalid_scheduler_policy_key_cxx(base);
     init_invalid_scheduler_policy_thread_specification_cxx(base);
     init_invalid_scheduler_policy_value_cxx(base);
