From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscoree: GetAssemblyMDImport trace crash (3508)

mscoree: GetAssemblyMDImport dereferenced its output pointer in a trace

The FIXME printed *ppIUnk, which is not set (and may be NULL), instead of the pointer. The stubs keep their FIXMEs.
---
--- a/dlls/mscoree/mscoree_main.c
+++ b/dlls/mscoree/mscoree_main.c
@@ -515,7 +515,7 @@ HRESULT WINAPI CoInitializeCor(DWORD fFlags)
 
 HRESULT WINAPI GetAssemblyMDImport(LPCWSTR szFileName, REFIID riid, IUnknown **ppIUnk)
 {
-    FIXME("(%p %s, %s, %p): stub\n", szFileName, debugstr_w(szFileName), debugstr_guid(riid), *ppIUnk);
+    FIXME("(%p %s, %s, %p): stub\n", szFileName, debugstr_w(szFileName), debugstr_guid(riid), ppIUnk);
     return ERROR_CALL_NOT_IMPLEMENTED;
 }
 
