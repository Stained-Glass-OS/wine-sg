From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comdlg32: Save As takes the name as typed

Since 0582, GetSaveFileName shows the item dialog (IFileSaveDialog's), and
it handled a typed name unlike the old dialog and unlike Windows:
- the name it suggests ("Document") was not selected, so a typed name went
  in front of it: WordPad's Save As of "typed.rtf" wrote
  "typed.rtfDocument.rtf";
- a name typed with the extension of another of its types got the chosen
  type's after it: "pic.rtf" with Word Document chosen was saved as
  "pic.rtf.docx".
sg-shell's wordpad-check failed 21 checks over these.

The suggested name is selected when the dialog opens. A typed extension
that is one of the dialog's types, or a registered one, is kept (unless
FOS_STRICTFILETYPES); a name without one, or with one the dialog does not
know, still gets the chosen type's.

Test: test/savename-gate.sh; mutants SG_MUTANT_NAME_UNSELECTED and
SG_MUTANT_TYPED_EXT_REPLACED (comdlg32 itemdlg.c). test/ofn-gate.sh and
sg-shell wordpad-check pass.
---
--- a/dlls/comdlg32/itemdlg.c
+++ b/dlls/comdlg32/itemdlg.c
@@ -578,6 +578,48 @@
     return ext;
 }
 
+#ifndef SG_MUTANT_TYPED_EXT_REPLACED
+/* Stained Glass OS: a name typed with the extension of another of the
+ * dialog's types (or of a registered one) is saved under that name, as on
+ * Windows; only a name without one, or with one the dialog does not know,
+ * gets the chosen type's. "pic.rtf" typed with Word Document chosen was
+ * saved as "pic.rtf.docx" (GetSaveFileName goes through this dialog since
+ * 0582; the old one kept any typed extension). FOS_STRICTFILETYPES keeps
+ * the chosen type's. */
+static BOOL spec_has_ext(const WCHAR *spec, const WCHAR *ext)
+{
+    size_t n = lstrlenW(ext);
+    const WCHAR *p = spec;
+
+    while (p && *p)
+    {
+        const WCHAR *end = wcschr(p, ';');
+        size_t len = end ? (size_t)(end - p) : lstrlenW(p);
+        while (len && *p == ' ') { p++; len--; }
+        if (len == n + 1 && *p == '*' && !wcsnicmp(p + 1, ext, n)) return TRUE;
+        p = end ? end + 1 : NULL;
+    }
+    return FALSE;
+}
+
+static BOOL keep_typed_ext(FileDialogImpl *This, const WCHAR *ext)
+{
+    UINT i;
+    HKEY key;
+
+    if (!ext[0] || !ext[1] || wcspbrk(ext, L"*? ")) return FALSE;
+    if (This->options & FOS_STRICTFILETYPES) return FALSE;
+    for (i = 0; i < This->filterspec_count; i++)
+        if (This->filterspecs[i].pszSpec && spec_has_ext(This->filterspecs[i].pszSpec, ext)) return TRUE;
+    if (!RegOpenKeyExW(HKEY_CLASSES_ROOT, ext, 0, KEY_READ, &key))
+    {
+        RegCloseKey(key);
+        return TRUE;
+    }
+    return FALSE;
+}
+#endif
+
 static BOOL shell_item_exists(IShellItem* shellitem)
 {
     LPWSTR filename;
@@ -673,7 +715,11 @@
                 if(newext)
                 {
                     WCHAR *ext = PathFindExtensionW(canon_filename);
+#ifndef SG_MUTANT_TYPED_EXT_REPLACED
+                    if(lstrcmpiW(ext, newext) && !keep_typed_ext(This, ext))
+#else
                     if(lstrcmpiW(ext, newext))
+#endif
                         lstrcatW(canon_filename, newext);
                 }
             }
@@ -2305,7 +2351,16 @@
         events_OnTypeChange(This);
 
     if ((hitem = GetDlgItem(This->dlg_hwnd, IDC_FILENAME)))
+    {
         SetFocus(hitem);
+#ifndef SG_MUTANT_NAME_UNSELECTED
+        /* Stained Glass OS: the name it suggests is selected, as Windows
+         * shows it, so a name typed replaces it -- GetSaveFileName goes
+         * through this dialog since 0582, and "typed.rtf" came out as
+         * "typed.rtfDocument.rtf" (the old dialog's combo box selected it) */
+        SendMessageW(hitem, EM_SETSEL, 0, -1);
+#endif
+    }
 
     return FALSE;
 }
