From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: geometry groups are filled and outlined

A Direct2D geometry group kept no triangles or outline of its own, so FillGeometry and DrawGeometry drew nothing for it. react-native-svg puts every shape it draws in a group, so OneDrive's illustrations (sign-in, tutorial pages, the tray flyout) and any other React Native SVG came out blank. A group is now drawn as its members' figures in one path under the group's fill mode (overlaps are holes under ALTERNATE and filled under WINDING), made the first time the group is drawn and kept with it.
---
diff --git a/dlls/d2d1/d2d1_private.h b/dlls/d2d1/d2d1_private.h
index 8febf0d..da05603 100644
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -642,6 +642,7 @@ struct d2d_geometry
             ID2D1Geometry **src_geometries;
             UINT32 geometry_count;
             D2D1_FILL_MODE fill_mode;
+            ID2D1PathGeometry1 *flat;   /* its figures as one path, to fill and draw, made when first needed */
         } group;
     } u;
 };
@@ -655,6 +656,7 @@ HRESULT d2d_rounded_rectangle_geometry_init(struct d2d_geometry *geometry,
         ID2D1Factory *factory, const D2D1_ROUNDED_RECT *rounded_rect);
 void d2d_transformed_geometry_init(struct d2d_geometry *geometry, ID2D1Factory *factory,
         ID2D1Geometry *src_geometry, const D2D_MATRIX_3X2_F *transform);
+const struct d2d_geometry *d2d_geometry_drawable(const struct d2d_geometry *geometry);
 HRESULT d2d_geometry_group_init(struct d2d_geometry *geometry, ID2D1Factory *factory,
         D2D1_FILL_MODE fill_mode, ID2D1Geometry **src_geometries, unsigned int geometry_count);
 struct d2d_geometry *unsafe_impl_from_ID2D1Geometry(ID2D1Geometry *iface);
diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index faa8c52..e9a6240 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -1051,7 +1051,7 @@ static void STDMETHODCALLTYPE d2d_device_context_DrawGeometry(ID2D1DeviceContext
             stroke_width /= context->drawing_state.transform.m11;
     }
 
-    d2d_device_context_draw_geometry(context, geometry_impl, brush_impl, stroke_width);
+    d2d_device_context_draw_geometry(context, d2d_geometry_drawable(geometry_impl), brush_impl, stroke_width);
 }
 
 static void d2d_device_context_fill_geometry(struct d2d_device_context *render_target,
@@ -1171,7 +1171,7 @@ static void STDMETHODCALLTYPE d2d_device_context_FillGeometry(ID2D1DeviceContext
     if (context->target.type == D2D_TARGET_COMMAND_LIST)
         d2d_command_list_fill_geometry(context->target.command_list, context, geometry, brush, opacity_brush);
     else
-        d2d_device_context_fill_geometry(context, geometry_impl, brush_impl, opacity_brush_impl);
+        d2d_device_context_fill_geometry(context, d2d_geometry_drawable(geometry_impl), brush_impl, opacity_brush_impl);
 }
 
 #define D2D_MESH_CHUNK 20000
diff --git a/dlls/d2d1/geometry.c b/dlls/d2d1/geometry.c
index 7297e79..f4db8b8 100644
--- a/dlls/d2d1/geometry.c
+++ b/dlls/d2d1/geometry.c
@@ -5470,6 +5470,8 @@ static ULONG STDMETHODCALLTYPE d2d_geometry_group_Release(ID2D1GeometryGroup *if
         for (i = 0; i < geometry->u.group.geometry_count; ++i)
             ID2D1Geometry_Release(geometry->u.group.src_geometries[i]);
         free(geometry->u.group.src_geometries);
+        if (geometry->u.group.flat)
+            ID2D1PathGeometry1_Release(geometry->u.group.flat);
         d2d_geometry_cleanup(geometry);
         free(geometry);
     }
@@ -5803,6 +5805,50 @@ HRESULT d2d_geometry_group_init(struct d2d_geometry *geometry, ID2D1Factory *fac
     return S_OK;
 }
 
+/* What a device context fills or outlines for a geometry: a group keeps no triangles or outline
+ * of its own, so its members' figures are put into one path with the group's fill mode, the way
+ * the group is filled (Stained Glass OS 6243: react-native-svg draws every shape as a group). */
+const struct d2d_geometry *d2d_geometry_drawable(const struct d2d_geometry *geometry)
+{
+    struct d2d_geometry *group = (struct d2d_geometry *)geometry;
+    ID2D1PathGeometry1 *path;
+    ID2D1GeometrySink *sink;
+    ID2D1Factory1 *factory1;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_D2D_GROUP_NOT_DRAWN
+    return geometry;
+#endif
+    if (!geometry || geometry->ID2D1Geometry_iface.lpVtbl != (const ID2D1GeometryVtbl *)&d2d_geometry_group_vtbl)
+        return geometry;
+    if (group->u.group.flat)
+        return unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)group->u.group.flat);
+
+    if (FAILED(ID2D1Factory_QueryInterface(group->factory, &IID_ID2D1Factory1, (void **)&factory1)))
+        return geometry;
+    hr = ID2D1Factory1_CreatePathGeometry(factory1, &path);
+    ID2D1Factory1_Release(factory1);
+    if (FAILED(hr))
+        return geometry;
+    if (SUCCEEDED(hr = ID2D1PathGeometry1_Open(path, &sink)))
+    {
+        hr = ID2D1Geometry_Simplify(&group->ID2D1Geometry_iface, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_CUBICS_AND_LINES,
+                NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE, (ID2D1SimplifiedGeometrySink *)sink);
+        if (SUCCEEDED(hr))
+            hr = ID2D1GeometrySink_Close(sink);
+        ID2D1GeometrySink_Release(sink);
+    }
+    if (FAILED(hr))
+    {
+        WARN("Failed to flatten group %p, hr %#lx.\n", group, hr);
+        ID2D1PathGeometry1_Release(path);
+        return geometry;
+    }
+    if (InterlockedCompareExchangePointer((void **)&group->u.group.flat, path, NULL))
+        ID2D1PathGeometry1_Release(path);   /* made meanwhile by another thread */
+    return unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)group->u.group.flat);
+}
+
 struct d2d_geometry *unsafe_impl_from_ID2D1Geometry(ID2D1Geometry *iface)
 {
     if (!iface)
