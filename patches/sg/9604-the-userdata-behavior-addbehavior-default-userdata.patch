From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mshtml: the userData behavior (addBehavior("#default#userData")) (9604)

HTML applications and old intranet pages keep their settings with the
userData behavior: el.addBehavior("#default#userData"), setAttribute,
save("name"), and on a later visit load("name") and getAttribute.
addBehavior was E_NOTIMPL. While the behavior is attached the element's
getAttribute/setAttribute/removeAttribute work on its store (a name the
store lacks is the element's own attribute), save writes the store as an
XML document (<ROOTSTUB name="value"/>) under
%APPDATA%\Microsoft\Internet Explorer\UserData\<site>_<folder hash>\, and
load reads it back (a store never saved is empty), as Internet Explorer
5-9 persist it. removeBehavior takes it away with its cookie. Behaviors
in HTC files are not loaded: addBehavior gives 0, as for a behavior that
could not be attached.
---
--- a/dlls/mshtml/htmlelem.c
+++ b/dlls/mshtml/htmlelem.c
@@ -1417,6 +1419,10 @@
 
     TRACE("(%p)->(%s %s %08lx)\n", This, debugstr_w(strAttributeName), debugstr_variant(&AttributeValue), lFlags);
 
+    /* the userData behavior's store */
+    if(user_data_set(This, strAttributeName, &AttributeValue, &hres))
+        return hres;
+
     if(compat_mode < COMPAT_MODE_IE9 || !This->dom_element) {
         hres = dispex_get_id(&This->node.event_target.dispex, translate_attr_name(strAttributeName, compat_mode),
                 (lFlags&ATTRFLAG_CASESENSITIVE ? fdexNameCaseSensitive : fdexNameCaseInsensitive) | fdexNameEnsure, &dispid);
@@ -1538,6 +1544,10 @@
     if(lFlags & ~(ATTRFLAG_CASESENSITIVE|ATTRFLAG_ASSTRING))
         FIXME("Unsupported flags %lx\n", lFlags);
 
+    /* the userData behavior's store; a name it does not have is the element's */
+    if(user_data_get(This, strAttributeName, AttributeValue))
+        return S_OK;
+
     if(compat_mode < COMPAT_MODE_IE9 || !This->dom_element) {
         hres = dispex_get_id(&This->node.event_target.dispex, translate_attr_name(strAttributeName, compat_mode),
                              lFlags & ATTRFLAG_CASESENSITIVE ? fdexNameCaseSensitive : fdexNameCaseInsensitive, &dispid);
@@ -1586,6 +1596,9 @@
 
     TRACE("(%p)->(%s %lx %p)\n", This, debugstr_w(strAttributeName), lFlags, pfSuccess);
 
+    if(user_data_remove(This, strAttributeName, pfSuccess))
+        return S_OK;
+
     if(compat_mode < COMPAT_MODE_IE9 || !This->dom_element) {
         hres = dispex_get_id(&This->node.event_target.dispex, translate_attr_name(strAttributeName, compat_mode),
                              lFlags & ATTRFLAG_CASESENSITIVE ? fdexNameCaseSensitive : fdexNameCaseInsensitive, &id);
@@ -4540,16 +4743,24 @@
                                                VARIANT *pvarFactory, LONG *pCookie)
 {
     HTMLElement *This = impl_from_IHTMLElement2(iface);
-    FIXME("(%p)->(%s %p %p)\n", This, debugstr_w(bstrUrl), pvarFactory, pCookie);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%s %p %p)\n", This, debugstr_w(bstrUrl), pvarFactory, pCookie);
+
+    if(!pCookie)
+        return E_POINTER;
+    return elem_add_behavior(This, bstrUrl, pCookie);
 }
 
 static HRESULT WINAPI HTMLElement2_removeBehavior(IHTMLElement2 *iface, LONG cookie,
                                                   VARIANT_BOOL *pfResult)
 {
     HTMLElement *This = impl_from_IHTMLElement2(iface);
-    FIXME("(%p)->(%ld %p)\n", This, cookie, pfResult);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%ld %p)\n", This, cookie, pfResult);
+
+    if(!pfResult)
+        return E_POINTER;
+    return elem_remove_behavior(This, cookie, pfResult);
 }
 
 static HRESULT WINAPI HTMLElement2_get_runtimeStyle(IHTMLElement2 *iface, IHTMLStyle **p)
--- /dev/null
+++ b/dlls/mshtml/behavior.c
@@ -0,0 +1,560 @@
