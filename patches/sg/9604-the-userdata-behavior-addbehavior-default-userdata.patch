+/*
+ * The userData behavior keeps a store of name/value pairs for an element:
+ * while it is attached, the element's getAttribute, setAttribute and
+ * removeAttribute work on the store, save(name) writes it to the person's
+ * profile and load(name) reads it back, the way Internet Explorer 5-9 persist
+ * it (an XML document per name, under the folder of the page's site, in
+ * %APPDATA%\Microsoft\Internet Explorer\UserData). Behaviors written in HTC
+ * files are not loaded: addBehavior gives 0 for them, as for a behavior that
+ * could not be attached.
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "ole2.h"
+#include "shlwapi.h"
+#include "shlobj.h"
+
+#include "wine/debug.h"
+
+#include "mshtml_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mshtml);
+
+struct user_data_item
+{
+    WCHAR *name;
+    WCHAR *value;
+};
+
+typedef struct BehaviorMethod BehaviorMethod;
+
+struct user_data
+{
+    LONG cookie;
+    BehaviorMethod *methods[2];         /* save, load: told when the behavior goes */
+    struct user_data_item *items;
+    unsigned count;
+};
+
+static LONG next_cookie;
+
+enum { METHOD_SAVE, METHOD_LOAD };
+
+struct BehaviorMethod
+{
+    IDispatch IDispatch_iface;
+    LONG ref;
+    HTMLElement *elem;                  /* NULL once the behavior or the element is gone */
+    int method;
+};
+
+static inline BehaviorMethod *impl_from_IDispatch(IDispatch *iface)
+{
+    return CONTAINING_RECORD(iface, BehaviorMethod, IDispatch_iface);
+}
+
+static void free_items(struct user_data *data)
+{
+    unsigned i;
+
+    for(i = 0; i < data->count; i++) {
+        free(data->items[i].name);
+        free(data->items[i].value);
+    }
+    free(data->items);
+    data->items = NULL;
+    data->count = 0;
+}
+
+static struct user_data_item *find_item(struct user_data *data, const WCHAR *name)
+{
+    unsigned i;
+
+    for(i = 0; i < data->count; i++)
+        if(!wcsicmp(data->items[i].name, name))
+            return &data->items[i];
+    return NULL;
+}
+
+static HRESULT set_item(struct user_data *data, const WCHAR *name, const WCHAR *value)
+{
+    struct user_data_item *item, *items;
+    WCHAR *copy;
+
+    if(!(copy = wcsdup(value ? value : L"")))
+        return E_OUTOFMEMORY;
+    if((item = find_item(data, name))) {
+        free(item->value);
+        item->value = copy;
+        return S_OK;
+    }
+    if(!(items = realloc(data->items, (data->count + 1) * sizeof(*items)))) {
+        free(copy);
+        return E_OUTOFMEMORY;
+    }
+    data->items = items;
+    if(!(items[data->count].name = wcsdup(name))) {
+        free(copy);
+        return E_OUTOFMEMORY;
+    }
+    items[data->count++].value = copy;
+    return S_OK;
+}
+
+/* a store name may only be a plain name: it becomes a file name */
+static BOOL valid_store_name(const WCHAR *name)
+{
+    const WCHAR *p;
+
+    if(!name || !*name || wcslen(name) > 64)
+        return FALSE;
+    for(p = name; *p; p++)
+        if(!iswalnum(*p) && *p != '_' && *p != '-' && *p != '.')
+            return FALSE;
+    return name[0] != '.';
+}
+
+/* %APPDATA%\Microsoft\Internet Explorer\UserData\<site>\<name>.xml */
+static HRESULT store_path(HTMLElement *elem, const WCHAR *name, WCHAR *path, BOOL create)
+{
+    HTMLDocumentNode *doc = elem->node.doc;
+    const WCHAR *url = NULL;
+    WCHAR host[256] = L"", dir[64], *p;
+    DWORD len = ARRAY_SIZE(host), hash = 5381;
+    const WCHAR *last_slash;
+
+    if(!valid_store_name(name))
+        return E_INVALIDARG;
+    if(doc && doc->window && doc->window->base.outer_window)
+        url = doc->window->base.outer_window->url;
+    if(!url)
+        url = L"about:blank";
+    if(FAILED(UrlGetPartW(url, host, &len, URL_PART_HOSTNAME, 0)) || !*host)
+        lstrcpyW(host, L"local");
+    for(p = host; *p; p++)
+        if(!iswalnum(*p) && *p != '.' && *p != '-')
+            *p = '_';
+    /* pages of the same folder of the site share their stores */
+    last_slash = wcsrchr(url, '/');
+    if(!last_slash) last_slash = wcsrchr(url, '\\');
+    for(p = (WCHAR*)url; *p && (!last_slash || p < last_slash); p++)
+        hash = hash * 33 + towlower(*p);
+    swprintf(dir, ARRAY_SIZE(dir), L"%08lx", hash);
+
+    if(FAILED(SHGetFolderPathW(NULL, CSIDL_APPDATA | (create ? CSIDL_FLAG_CREATE : 0), NULL, 0, path)))
+        return E_FAIL;
+    if(wcslen(path) + wcslen(host) + wcslen(dir) + wcslen(name) + 64 > MAX_PATH)
+        return E_INVALIDARG;
+    lstrcatW(path, L"\\Microsoft");
+    if(create) CreateDirectoryW(path, NULL);
+    lstrcatW(path, L"\\Internet Explorer");
+    if(create) CreateDirectoryW(path, NULL);
+    lstrcatW(path, L"\\UserData");
+    if(create) CreateDirectoryW(path, NULL);
+    lstrcatW(path, L"\\");
+    lstrcatW(path, host);
+    lstrcatW(path, L"_");
+    lstrcatW(path, dir);
+    if(create) CreateDirectoryW(path, NULL);
+    lstrcatW(path, L"\\");
+    lstrcatW(path, name);
+    lstrcatW(path, L".xml");
+    return S_OK;
+}
+
+static void append_escaped(WCHAR **out, const WCHAR *str)
+{
+    for(; *str; str++) {
+        const WCHAR *rep = NULL;
+        switch(*str) {
+        case '&': rep = L"&amp;"; break;
+        case '<': rep = L"&lt;"; break;
+        case '>': rep = L"&gt;"; break;
+        case '"': rep = L"&quot;"; break;
+        }
+        if(rep) {
+            lstrcpyW(*out, rep);
+            *out += lstrlenW(rep);
+        }else {
+            *(*out)++ = *str;
+        }
+    }
+}
+
+static HRESULT user_data_save(HTMLElement *elem, const WCHAR *name)
+{
+    struct user_data *data = elem->user_data;
+    WCHAR path[MAX_PATH], *xml, *p;
+    size_t len = 32;
+    unsigned i;
+    char *utf8;
+    int size;
+    HANDLE file;
+    DWORD written;
+    HRESULT hres;
+
+    if(FAILED(hres = store_path(elem, name, path, TRUE)))
+        return hres;
+    for(i = 0; i < data->count; i++)
+        len += (wcslen(data->items[i].name) + wcslen(data->items[i].value)) * 6 + 8;
+    if(!(xml = malloc(len * sizeof(WCHAR))))
+        return E_OUTOFMEMORY;
+    p = xml;
+    lstrcpyW(p, L"<ROOTSTUB");
+    p += lstrlenW(p);
+    for(i = 0; i < data->count; i++) {
+        *p++ = ' ';
+        append_escaped(&p, data->items[i].name);
+        *p++ = '=';
+        *p++ = '"';
+        append_escaped(&p, data->items[i].value);
+        *p++ = '"';
+    }
+    lstrcpyW(p, L"/>");
+
+    size = WideCharToMultiByte(CP_UTF8, 0, xml, -1, NULL, 0, NULL, NULL);
+    if(!(utf8 = malloc(size))) {
+        free(xml);
+        return E_OUTOFMEMORY;
+    }
+    WideCharToMultiByte(CP_UTF8, 0, xml, -1, utf8, size, NULL, NULL);
+    free(xml);
+    file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if(file == INVALID_HANDLE_VALUE) {
+        free(utf8);
+        return HRESULT_FROM_WIN32(GetLastError());
+    }
+    hres = WriteFile(file, utf8, size - 1, &written, NULL) ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+    CloseHandle(file);
+    free(utf8);
+    TRACE("saved %u items to %s\n", data->count, debugstr_w(path));
+    return hres;
+}
+
+static WCHAR *unescape(const WCHAR *start, const WCHAR *end)
+{
+    WCHAR *ret, *p;
+
+    if(!(ret = malloc((end - start + 1) * sizeof(WCHAR))))
+        return NULL;
+    for(p = ret; start < end; start++) {
+        if(*start == '&') {
+            static const struct { const WCHAR *ent; WCHAR ch; } ents[] = {
+                {L"&amp;", '&'}, {L"&lt;", '<'}, {L"&gt;", '>'}, {L"&quot;", '"'}, {L"&apos;", '\''}
+            };
+            unsigned i;
+            for(i = 0; i < ARRAY_SIZE(ents); i++)
+                if(end - start >= lstrlenW(ents[i].ent) && !wcsncmp(start, ents[i].ent, lstrlenW(ents[i].ent)))
+                    break;
+            if(i < ARRAY_SIZE(ents)) {
+                *p++ = ents[i].ch;
+                start += lstrlenW(ents[i].ent) - 1;
+                continue;
+            }
+        }
+        *p++ = *start;
+    }
+    *p = 0;
+    return ret;
+}
+
+static HRESULT user_data_load(HTMLElement *elem, const WCHAR *name)
+{
+    struct user_data *data = elem->user_data;
+    WCHAR path[MAX_PATH], *xml, *p;
+    char *buf;
+    HANDLE file;
+    DWORD size, read;
+    int len;
+    HRESULT hres;
+
+    if(FAILED(hres = store_path(elem, name, path, FALSE)))
+        return hres;
+    /* a store never saved loads as empty */
+    free_items(data);
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if(file == INVALID_HANDLE_VALUE)
+        return S_OK;
+    size = GetFileSize(file, NULL);
+    if(size == INVALID_FILE_SIZE || size > 1024 * 1024 || !(buf = malloc(size + 1))) {
+        CloseHandle(file);
+        return E_OUTOFMEMORY;
+    }
+    if(!ReadFile(file, buf, size, &read, NULL))
+        read = 0;
+    CloseHandle(file);
+    len = MultiByteToWideChar(CP_UTF8, 0, buf, read, NULL, 0);
+    if(!(xml = malloc((len + 1) * sizeof(WCHAR)))) {
+        free(buf);
+        return E_OUTOFMEMORY;
+    }
+    MultiByteToWideChar(CP_UTF8, 0, buf, read, xml, len);
+    xml[len] = 0;
+    free(buf);
+
+    /* the attributes of the root element */
+    p = wcschr(xml, '<');
+    if(p) {
+        p++;
+        while(*p && !iswspace(*p) && *p != '/' && *p != '>') p++;
+        while(*p && *p != '/' && *p != '>') {
+            const WCHAR *name_start, *name_end, *value_start;
+            WCHAR quote, *attr_name, *attr_value;
+
+            while(iswspace(*p)) p++;
+            name_start = p;
+            while(*p && *p != '=' && !iswspace(*p) && *p != '/' && *p != '>') p++;
+            name_end = p;
+            while(iswspace(*p)) p++;
+            if(*p != '=' || name_start == name_end) break;
+            p++;
+            while(iswspace(*p)) p++;
+            if(*p != '"' && *p != '\'') break;
+            quote = *p++;
+            value_start = p;
+            while(*p && *p != quote) p++;
+            if(!*p) break;
+            attr_name = unescape(name_start, name_end);
+            attr_value = unescape(value_start, p);
+            if(attr_name && attr_value)
+                set_item(data, attr_name, attr_value);
+            free(attr_name);
+            free(attr_value);
+            p++;
+        }
+    }
+    free(xml);
+    TRACE("loaded %u items from %s\n", data->count, debugstr_w(path));
+    return S_OK;
+}
+
+static HRESULT WINAPI BehaviorMethod_QueryInterface(IDispatch *iface, REFIID riid, void **ppv)
+{
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch)) {
+        *ppv = iface;
+        IDispatch_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI BehaviorMethod_AddRef(IDispatch *iface)
+{
+    return InterlockedIncrement(&impl_from_IDispatch(iface)->ref);
+}
+
+static ULONG WINAPI BehaviorMethod_Release(IDispatch *iface)
+{
+    BehaviorMethod *This = impl_from_IDispatch(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref)
+        free(This);
+    return ref;
+}
+
+static HRESULT WINAPI BehaviorMethod_GetTypeInfoCount(IDispatch *iface, UINT *count)
+{
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI BehaviorMethod_GetTypeInfo(IDispatch *iface, UINT index, LCID lcid, ITypeInfo **ti)
+{
+    *ti = NULL;
+    return DISP_E_BADINDEX;
+}
+
+static HRESULT WINAPI BehaviorMethod_GetIDsOfNames(IDispatch *iface, REFIID riid, LPOLESTR *names, UINT count,
+        LCID lcid, DISPID *ids)
+{
+    UINT i;
+    for(i = 0; i < count; i++)
+        ids[i] = DISPID_UNKNOWN;
+    return DISP_E_UNKNOWNNAME;
+}
+
+static HRESULT WINAPI BehaviorMethod_Invoke(IDispatch *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *params, VARIANT *res, EXCEPINFO *ei, UINT *argerr)
+{
+    BehaviorMethod *This = impl_from_IDispatch(iface);
+    UINT positional;
+    VARIANT name;
+    HRESULT hres;
+
+    if(id != DISPID_VALUE || !(flags & DISPATCH_METHOD))
+        return DISP_E_MEMBERNOTFOUND;
+    /* the element's behavior has gone */
+    if(!This->elem || !This->elem->user_data)
+        return E_UNEXPECTED;
+    positional = params ? params->cArgs - params->cNamedArgs : 0;
+    if(!positional)
+        return DISP_E_PARAMNOTOPTIONAL;
+    V_VT(&name) = VT_EMPTY;
+    /* the first positional argument is the last one in rgvarg */
+    if(FAILED(hres = VariantChangeType(&name, &params->rgvarg[params->cArgs - 1], 0, VT_BSTR)))
+        return hres;
+    hres = This->method == METHOD_SAVE ? user_data_save(This->elem, V_BSTR(&name))
+                                       : user_data_load(This->elem, V_BSTR(&name));
+    VariantClear(&name);
+    if(res)
+        V_VT(res) = VT_EMPTY;
+    return hres;
+}
+
+static const IDispatchVtbl BehaviorMethodVtbl = {
+    BehaviorMethod_QueryInterface,
+    BehaviorMethod_AddRef,
+    BehaviorMethod_Release,
+    BehaviorMethod_GetTypeInfoCount,
+    BehaviorMethod_GetTypeInfo,
+    BehaviorMethod_GetIDsOfNames,
+    BehaviorMethod_Invoke
+};
+
+/* save and load become methods of the element */
+static HRESULT add_method(HTMLElement *elem, const WCHAR *name, int method)
+{
+    BehaviorMethod *func;
+    VARIANT *var;
+    HRESULT hres;
+
+    hres = dispex_get_dprop_ref(&elem->node.event_target.dispex, name, TRUE, &var);
+    if(FAILED(hres))
+        return hres;
+    if(!(func = malloc(sizeof(*func))))
+        return E_OUTOFMEMORY;
+    func->IDispatch_iface.lpVtbl = &BehaviorMethodVtbl;
+    func->ref = 1;
+    /* no reference: the element owns the property holding the method */
+    func->elem = elem;
+    func->method = method;
+    elem->user_data->methods[method] = func;
+    VariantClear(var);
+    V_VT(var) = VT_DISPATCH;
+    V_DISPATCH(var) = &func->IDispatch_iface;
+    return S_OK;
+}
+
+HRESULT elem_add_behavior(HTMLElement *elem, const WCHAR *url, LONG *cookie)
+{
+    struct user_data *data;
+    HRESULT hres;
+
+    *cookie = 0;
+#ifdef SG_MUTANT_NO_USERDATA
+    return E_NOTIMPL;
+#endif
+    if(!url || wcsicmp(url, L"#default#userData")) {
+        FIXME("behavior %s not supported\n", debugstr_w(url));
+        return S_OK;
+    }
+    if(elem->user_data) {
+        *cookie = elem->user_data->cookie;
+        return S_OK;
+    }
+    if(!(data = calloc(1, sizeof(*data))))
+        return E_OUTOFMEMORY;
+    data->cookie = InterlockedIncrement(&next_cookie);
+    elem->user_data = data;
+    if(FAILED(hres = add_method(elem, L"save", METHOD_SAVE)) ||
+       FAILED(hres = add_method(elem, L"load", METHOD_LOAD))) {
+        elem_free_behaviors(elem);
+        return hres;
+    }
+    *cookie = data->cookie;
+    return S_OK;
+}
+
+HRESULT elem_remove_behavior(HTMLElement *elem, LONG cookie, VARIANT_BOOL *ret)
+{
+    if(elem->user_data && elem->user_data->cookie == cookie) {
+        elem_free_behaviors(elem);
+        *ret = VARIANT_TRUE;
+    }else {
+        *ret = VARIANT_FALSE;
+    }
+    return S_OK;
+}
+
+void elem_free_behaviors(HTMLElement *elem)
+{
+    unsigned i;
+
+    if(!elem->user_data)
+        return;
+    for(i = 0; i < ARRAY_SIZE(elem->user_data->methods); i++)
+        if(elem->user_data->methods[i])
+            elem->user_data->methods[i]->elem = NULL;
+    free_items(elem->user_data);
+    free(elem->user_data);
+    elem->user_data = NULL;
+}
+
+/* getAttribute, setAttribute and removeAttribute while the userData behavior is attached */
+BOOL user_data_get(HTMLElement *elem, const WCHAR *name, VARIANT *ret)
+{
+    struct user_data_item *item;
+
+    if(!elem->user_data || !name || !(item = find_item(elem->user_data, name)))
+        return FALSE;
+    V_VT(ret) = VT_BSTR;
+    V_BSTR(ret) = SysAllocString(item->value);
+    return TRUE;
+}
+
+BOOL user_data_set(HTMLElement *elem, const WCHAR *name, VARIANT *value, HRESULT *hres)
+{
+    VARIANT str;
+
+    if(!elem->user_data || !name)
+        return FALSE;
+    V_VT(&str) = VT_EMPTY;
+    if(SUCCEEDED(*hres = VariantChangeType(&str, value, 0, VT_BSTR))) {
+        *hres = set_item(elem->user_data, name, V_BSTR(&str));
+        VariantClear(&str);
+    }
+    return TRUE;
+}
+
+BOOL user_data_remove(HTMLElement *elem, const WCHAR *name, VARIANT_BOOL *ret)
+{
+    struct user_data *data = elem->user_data;
+    struct user_data_item *item;
+
+    if(!data || !name || !(item = find_item(data, name)))
+        return FALSE;
+    free(item->name);
+    free(item->value);
+    memmove(item, item + 1, (data->items + data->count - item - 1) * sizeof(*item));
+    data->count--;
+    *ret = VARIANT_TRUE;
+    return TRUE;
+}
