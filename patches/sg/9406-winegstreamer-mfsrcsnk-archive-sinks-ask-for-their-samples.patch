From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winegstreamer, mfsrcsnk: Archive sinks ask for their samples; AAC streams keep their codec data (9406)

The MPEG-4/MP3/ADTS/AC-3 sinks (winegstreamer's media sink) and the WAVE sink never sent
MEStreamSinkRequestSample. The sink writer, like Windows', hands a stream sink a sample only when the
sink asks for one, and the media session does the same: every sink writer to a file (NAudio's
MediaFoundationEncoder, screen recorders' .mp4 writers) queued its samples and hung in Finalize. The
sinks now ask when they start and after each sample, as Windows' archive sinks do.
Also: mf_media_type_to_wg_format kept only the AudioSpecificConfig of an AAC type, while
wg_format_to_caps reads the HEAACWAVEINFO tail and the AudioSpecificConfig: the MPEG-4 sink's AAC caps had
no codec_data and the file no samples.
---
--- a/dlls/winegstreamer/media_sink.c
+++ b/dlls/winegstreamer/media_sink.c
@@ -770,7 +770,14 @@
 
     media_sink->state = STATE_STARTED;
 
-    return media_sink_queue_stream_event(media_sink, MEStreamSinkStarted);
+    if (FAILED(hr = media_sink_queue_stream_event(media_sink, MEStreamSinkStarted)))
+        return hr;
+    /* Stained Glass OS (wine-sg 9406): an archive sink asks for its samples, as on Windows: the sink
+     * writer and the media session send a stream sink nothing before MEStreamSinkRequestSample */
+#ifdef SG_MUTANT_SINK_NO_REQUEST
+    return hr;
+#endif
+    return media_sink_queue_stream_event(media_sink, MEStreamSinkRequestSample);
 }
 
 static HRESULT media_sink_stop(struct media_sink *media_sink)
@@ -1560,6 +1567,10 @@
             }
             else if (FAILED(hr = media_sink_process(media_sink, command->u.process.sample, command->u.process.stream_id)))
                 WARN("Failed to process sample, hr %#lx.\n", hr);
+            /* Stained Glass OS (wine-sg 9406): and the next one */
+            if (stream_sink && media_sink->state == STATE_STARTED)
+                IMFMediaEventQueue_QueueEventParamVar(stream_sink->event_queue, MEStreamSinkRequestSample,
+                        &GUID_NULL, S_OK, NULL);
             break;
         }
         case ASYNC_MARKER:
--- a/dlls/mfsrcsnk/wave.c
+++ b/dlls/mfsrcsnk/wave.c
@@ -713,6 +713,11 @@
             }
         }
 
+        /* Stained Glass OS (wine-sg 9406): the sink asks for its next sample, as on Windows */
+        if (SUCCEEDED(hr))
+            IMFMediaEventQueue_QueueEventParamVar(sink->stream_event_queue, MEStreamSinkRequestSample,
+                    &GUID_NULL, S_OK, NULL);
+
         if (buffer)
             IMFMediaBuffer_Release(buffer);
     }
@@ -817,7 +822,11 @@
 
     TRACE("%p, %s, %s.\n", iface, debugstr_time(systime), debugstr_time(offset));
 
-    return IMFMediaEventQueue_QueueEventParamVar(sink->stream_event_queue, MEStreamSinkStarted, &GUID_NULL, S_OK, NULL);
+    HRESULT hr;
+
+    if (FAILED(hr = IMFMediaEventQueue_QueueEventParamVar(sink->stream_event_queue, MEStreamSinkStarted, &GUID_NULL, S_OK, NULL)))
+        return hr;
+    return IMFMediaEventQueue_QueueEventParamVar(sink->stream_event_queue, MEStreamSinkRequestSample, &GUID_NULL, S_OK, NULL);
 }
 
 static HRESULT WINAPI wave_sink_clock_sink_OnClockStop(IMFClockStateSink *iface, MFTIME systime)
@@ -844,7 +853,11 @@
 
     TRACE("%p, %s.\n", iface, debugstr_time(systime));
 
-    return IMFMediaEventQueue_QueueEventParamVar(sink->stream_event_queue, MEStreamSinkStarted, &GUID_NULL, S_OK, NULL);
+    HRESULT hr;
+
+    if (FAILED(hr = IMFMediaEventQueue_QueueEventParamVar(sink->stream_event_queue, MEStreamSinkStarted, &GUID_NULL, S_OK, NULL)))
+        return hr;
+    return IMFMediaEventQueue_QueueEventParamVar(sink->stream_event_queue, MEStreamSinkRequestSample, &GUID_NULL, S_OK, NULL);
 }
 
 static HRESULT WINAPI wave_sink_clock_sink_OnClockSetRate(IMFClockStateSink *iface, MFTIME systime, float rate)
--- a/dlls/winegstreamer/mfplat.c
+++ b/dlls/winegstreamer/mfplat.c
@@ -588,18 +588,30 @@
         return;
     }
 
+    /* Stained Glass OS (wine-sg 9406): the format's codec data is the HEAACWAVEINFO tail and the
+     * AudioSpecificConfig, as wg_format_to_caps_audio_mpeg4 and mf_media_type_from_wg_format_audio_mpeg4
+     * read and write it; the AudioSpecificConfig alone left the muxer's caps without codec_data (the
+     * MPEG-4 sink then wrote no samples). Raw AAC's user data is the AudioSpecificConfig only. */
     raw_aac = IsEqualGUID(subtype, &MFAudioFormat_RAW_AAC);
-    if (!raw_aac)
-        codec_data_size -= min(codec_data_size, sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX));
+    if (raw_aac)
+        codec_data_size += sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX);
     if (codec_data_size > sizeof(format->u.audio.codec_data))
     {
         FIXME("Codec data needs %u bytes.\n", codec_data_size);
         return;
     }
     if (raw_aac)
-        memcpy(format->u.audio.codec_data, (BYTE *)(&wfx->wfInfo.wfx + 1), codec_data_size);
+    {
+        memset(format->u.audio.codec_data, 0, sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX));
+        memcpy(format->u.audio.codec_data + sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX),
+                (BYTE *)(&wfx->wfInfo.wfx + 1), codec_data_size - (sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX)));
+    }
     else
-        memcpy(format->u.audio.codec_data, wfx->pbAudioSpecificConfig, codec_data_size);
+#ifndef SG_MUTANT_AAC_FORMAT_ASC_ONLY
+        memcpy(format->u.audio.codec_data, (BYTE *)(&wfx->wfInfo.wfx + 1), codec_data_size);
+#else
+        memcpy(format->u.audio.codec_data, wfx->pbAudioSpecificConfig, codec_data_size -= 12);
+#endif
 
     format->major_type = WG_MAJOR_TYPE_AUDIO_MPEG4;
 
