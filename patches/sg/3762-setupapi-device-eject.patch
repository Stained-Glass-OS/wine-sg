From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] setupapi: CM_Request_Device_Eject (3762)

CM_Request_Device_Eject was a stub that said "success" for every device. It
now checks its arguments, vetoes (CR_REMOVE_VETOED, with the veto type and
name) a device whose Capabilities say it can neither be ejected nor removed,
ejects the media of a CD-ROM drive through its device interface
(IOCTL_STORAGE_EJECT_MEDIA, vetoing if the drive has no interface, can not be
opened or refuses), and reports any other removable device as removed.
CORE review (patches/notes/3762.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

Rebased at integration (integ-2026-10) onto earlier integration patches: clean 3-way merge.
---
diff --git a/dlls/setupapi/devinst.c b/dlls/setupapi/devinst.c
--- a/dlls/setupapi/devinst.c
+++ b/dlls/setupapi/devinst.c
@@ -4588,6 +4588,92 @@ BOOL WINAPI SetupDiDeleteDevRegKey(HDEVINFO devinfo, SP_DEVINFO_DATA *device_dat
 #define ROOT_DEVNODE 0x7fff0000
 static const WCHAR root_id[] = L"HTREE\\ROOT\\0";
 
+/***********************************************************************
+ *              CM_Request_Device_EjectW  (SETUPAPI.@)
+ *
+ * Stained Glass OS: prepares a device for removal and ejects it if it can be.  A device that says it can
+ * neither be ejected nor removed (its Capabilities) is vetoed.  A CD-ROM drive has its media ejected through
+ * the device interface of the drive the prefix has (IOCTL_STORAGE_EJECT_MEDIA, the drive's own unix device
+ * as the prefix configures it); a drive that has no interface, can not be opened or fails the request vetoes
+ * it.  Any other removable device has nothing in this prefix to stop: it is reported as removed.
+ * The privilege checks of the documentation (SeUndockPrivilege, SeLoadDriverPrivilege) are not made.
+ */
+static const GUID cdrom_class_guid = {0x4d36e965, 0xe325, 0x11ce, {0xbf,0xc1,0x08,0x00,0x2b,0xe1,0x03,0x18}};
+static const GUID cdrom_iface_guid = {0x53f56308, 0xb6bf, 0x11d0, {0x94,0xf2,0x00,0xa0,0xc9,0x1e,0xfb,0x8b}};
+
+static CONFIGRET eject_veto(PNP_VETO_TYPE *type, WCHAR *name, ULONG length, PNP_VETO_TYPE veto, const WCHAR *text)
+{
+    if (type) *type = veto;
+    if (name && length) lstrcpynW(name, text, length);
+    return CR_REMOVE_VETOED;
+}
+
+CONFIGRET WINAPI CM_Request_Device_EjectW(DEVINST dev, PPNP_VETO_TYPE type, LPWSTR name, ULONG length, ULONG flags)
+{
+    struct device *device = dev == ROOT_DEVNODE ? NULL : get_devnode_device(dev);
+    DWORD caps = 0, size = sizeof(caps), value_type;
+    struct device_iface *iface;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    CONFIGRET ret;
+    DWORD bytes;
+    BOOL found = FALSE;
+
+    TRACE("%#lx, %p, %p, %lu, %#lx\n", dev, type, name, length, flags);
+
+    if (!device) return CR_INVALID_DEVNODE;
+    if (flags) return CR_INVALID_FLAG;
+    if (name && !length) return CR_INVALID_POINTER;
+    if (type) *type = PNP_VetoTypeUnknown;
+    if (name) name[0] = 0;
+    if (device->phantom) return CR_NO_SUCH_DEVNODE;
+
+    if (RegQueryValueExW(device->key, L"Capabilities", NULL, &value_type, (BYTE *)&caps, &size) || value_type != REG_DWORD)
+        caps = 0;
+    if (!(caps & (CM_DEVCAP_EJECTSUPPORTED | CM_DEVCAP_REMOVABLE)))
+        return eject_veto(type, name, length, PNP_VetoNonDisableable, device->instanceId);
+
+    if (!IsEqualGUID(&device->class, &cdrom_class_guid)) return CR_SUCCESS;
+
+    LIST_FOR_EACH_ENTRY(iface, &device->interfaces, struct device_iface, entry)
+    {
+        if (!IsEqualGUID(&iface->class, &cdrom_iface_guid) || !(iface->flags & SPINT_ACTIVE)) continue;
+        found = TRUE;
+        file = CreateFileW(iface->symlink, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+        if (file != INVALID_HANDLE_VALUE) break;
+    }
+    if (!found) return eject_veto(type, name, length, PNP_VetoDevice, device->instanceId);
+    if (file == INVALID_HANDLE_VALUE)
+        return eject_veto(type, name, length, GetLastError() == ERROR_SHARING_VIOLATION ? PNP_VetoOutstandingOpen : PNP_VetoDevice,
+                          device->instanceId);
+    ret = DeviceIoControl(file, IOCTL_STORAGE_EJECT_MEDIA, NULL, 0, NULL, 0, &bytes, NULL) ? CR_SUCCESS
+            : eject_veto(type, name, length, GetLastError() == ERROR_ACCESS_DENIED ? PNP_VetoInsufficientRights : PNP_VetoDevice,
+                         device->instanceId);
+    CloseHandle(file);
+    return ret;
+}
+
+/***********************************************************************
+ *              CM_Request_Device_EjectA  (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Request_Device_EjectA(DEVINST dev, PPNP_VETO_TYPE type, LPSTR name, ULONG length, ULONG flags)
+{
+    WCHAR *nameW = NULL;
+    CONFIGRET ret;
+
+    if (name && !length) return CR_INVALID_POINTER;
+    if (name && length && !(nameW = malloc(length * sizeof(WCHAR)))) return CR_OUT_OF_MEMORY;
+    ret = CM_Request_Device_EjectW(dev, type, nameW, length, flags);
+    if (nameW)
+    {
+        if (name) WideCharToMultiByte(CP_ACP, 0, nameW, -1, name, length, NULL, NULL);
+        if (name && length) name[length - 1] = 0;
+        free(nameW);
+    }
+    else if (name && length) name[0] = 0;
+    return ret;
+}
+
+
 CONFIGRET WINAPI CM_Get_Device_IDA(DEVINST devnode, char *buffer, ULONG len, ULONG flags)
 {
     struct device *device = get_devnode_device(devnode);
