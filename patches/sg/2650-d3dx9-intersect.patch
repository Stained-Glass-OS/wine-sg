From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dx9: D3DXIntersect

D3DXIntersect returned E_NOTIMPL. It now tests the ray against every face of the mesh (positions
from the declaration, 16 or 32 bit indices) and gives whether it hit, the face, barycentric
coordinates and distance of the closest hit, the number of hits and, when asked for, the buffer
with a D3DXINTERSECTINFO for every hit (in the order of the faces).
---
--- a/dlls/d3dx9_36/mesh.c
+++ b/dlls/d3dx9_36/mesh.c
@@ -8095,10 +8095,110 @@ HRESULT WINAPI D3DXComputeNormals(struct ID3DXBaseMesh *mesh, const DWORD *adjac
 HRESULT WINAPI D3DXIntersect(ID3DXBaseMesh *mesh, const D3DXVECTOR3 *ray_pos, const D3DXVECTOR3 *ray_dir,
         BOOL *hit, DWORD *face_index, float *u, float *v, float *distance, ID3DXBuffer **all_hits, DWORD *count_of_hits)
 {
-    FIXME("mesh %p, ray_pos %p, ray_dir %p, hit %p, face_index %p, u %p, v %p, distance %p, all_hits %p, "
-            "count_of_hits %p stub!\n", mesh, ray_pos, ray_dir, hit, face_index, u, v, distance, all_hits, count_of_hits);
+    D3DVERTEXELEMENT9 declaration[MAX_FVF_DECL_SIZE];
+    D3DXINTERSECTINFO *infos = NULL, best = {0};
+    DWORD num_faces, vertex_stride, position_offset = 0, count = 0, i, f;
+    const BYTE *vertices = NULL;
+    const void *indices = NULL;
+    BOOL is_32bit, found_position = FALSE;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("mesh %p, ray_pos %p, ray_dir %p, hit %p, face_index %p, u %p, v %p, distance %p, all_hits %p, "
+            "count_of_hits %p.\n", mesh, ray_pos, ray_dir, hit, face_index, u, v, distance, all_hits, count_of_hits);
+
+    if (!mesh || !ray_pos || !ray_dir)
+        return D3DERR_INVALIDCALL;
+
+    if (FAILED(hr = mesh->lpVtbl->GetDeclaration(mesh, declaration)))
+        return hr;
+    for (i = 0; declaration[i].Stream != 0xff; ++i)
+    {
+        if (declaration[i].Usage == D3DDECLUSAGE_POSITION && !declaration[i].UsageIndex && !declaration[i].Stream)
+        {
+            position_offset = declaration[i].Offset;
+            found_position = TRUE;
+            break;
+        }
+    }
+    if (!found_position)
+        return D3DERR_INVALIDCALL;
+
+    num_faces = mesh->lpVtbl->GetNumFaces(mesh);
+    vertex_stride = mesh->lpVtbl->GetNumBytesPerVertex(mesh);
+    is_32bit = !!(mesh->lpVtbl->GetOptions(mesh) & D3DXMESH_32BIT);
+
+    if (num_faces && !(infos = malloc(num_faces * sizeof(*infos))))
+        return E_OUTOFMEMORY;
+
+    if (FAILED(hr = mesh->lpVtbl->LockVertexBuffer(mesh, D3DLOCK_READONLY, (void **)&vertices)))
+        goto done;
+    if (FAILED(hr = mesh->lpVtbl->LockIndexBuffer(mesh, D3DLOCK_READONLY, (void **)&indices)))
+    {
+        mesh->lpVtbl->UnlockVertexBuffer(mesh);
+        goto done;
+    }
+
+    /* every face the ray goes through, in the order of the faces */
+    for (f = 0; f < num_faces; ++f)
+    {
+        const D3DXVECTOR3 *p[3];
+        float tu, tv, dist;
+
+        for (i = 0; i < 3; ++i)
+        {
+            DWORD index = is_32bit ? ((const DWORD *)indices)[f * 3 + i] : ((const WORD *)indices)[f * 3 + i];
+
+            p[i] = (const D3DXVECTOR3 *)(vertices + index * vertex_stride + position_offset);
+        }
+
+        if (D3DXIntersectTri(p[0], p[1], p[2], ray_pos, ray_dir, &tu, &tv, &dist))
+        {
+            infos[count].FaceIndex = f;
+            infos[count].U = tu;
+            infos[count].V = tv;
+            infos[count].Dist = dist;
+#ifdef SG_MUTANT_D3DXISECT_FIRST
+            if (!count)
+#else
+            if (!count || dist < best.Dist)
+#endif
+                best = infos[count];
+            ++count;
+        }
+    }
+
+    mesh->lpVtbl->UnlockIndexBuffer(mesh);
+    mesh->lpVtbl->UnlockVertexBuffer(mesh);
+
+    if (hit)
+        *hit = !!count;
+    if (face_index)
+        *face_index = count ? best.FaceIndex : ~0u;
+    if (u)
+        *u = count ? best.U : 0.0f;
+    if (v)
+        *v = count ? best.V : 0.0f;
+    if (distance)
+        *distance = count ? best.Dist : 0.0f;
+    if (count_of_hits)
+        *count_of_hits = count;
+    if (all_hits)
+    {
+        *all_hits = NULL;
+#ifdef SG_MUTANT_D3DXISECT_NO_ALL
+        if (0)
+#else
+        if (count && FAILED(hr = D3DXCreateBuffer(count * sizeof(*infos), all_hits)))
+#endif
+            goto done;
+        if (*all_hits)
+            memcpy(ID3DXBuffer_GetBufferPointer(*all_hits), infos, count * sizeof(*infos));
+    }
+    hr = D3D_OK;
+
+done:
+    free(infos);
+    return hr;
 }
 
 HRESULT WINAPI D3DXTessellateNPatches(ID3DXMesh *mesh, const DWORD *adjacency_in, float num_segs,
