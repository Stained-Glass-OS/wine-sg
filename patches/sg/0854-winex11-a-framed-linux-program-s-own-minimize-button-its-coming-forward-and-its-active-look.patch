+/* A program's own minimize button (GTK's header bar, SG Office's, Firefox's
+ * with its tabs in the title bar) asks the window manager with WM_CHANGE_STATE
+ * (XIconifyWindow, ICCCM 4.1.4) -- for a framed window nobody listened: the
+ * button did nothing. Its frame is minimized, as by its own button. */
+static void handle_change_state( Display *d, Window root, XEvent *ev )
+{
+    Window r, parent, *children = NULL;
+    unsigned int n;
+    long on = 1;
+
+#ifdef SG_MUTANT_EMBED_NO_ICONIFY
+    return;
+#endif
+    if (ev->xclient.data.l[0] != IconicState) return;
+    /* only a window we framed: its parent is not the root */
+    if (!XQueryTree( d, ev->xclient.window, &r, &parent, &children, &n )) return;
+    if (children) XFree( children );
+    if (parent == root) return;
+    XChangeProperty( d, ev->xclient.window, minimize_atom( d ), XA_CARDINAL, 32, PropModeReplace,
+                     (unsigned char *)&on, 1 );
+}
+
+/* A program brings its window forward itself (_NET_ACTIVE_WINDOW: GTK's
+ * gtk_window_present, Firefox given a link by another program, a second
+ * start of a program that shows its first window instead): the window
+ * manager does it, and for a framed window none did -- it stayed minimized
+ * or behind. Its frame is restored and made the active window. */
+static void handle_active_window( Display *d, Window root, XEvent *ev )
+{
+    Window r, parent, *children = NULL;
+    unsigned int n;
+    long on = 1;
+
+#ifdef SG_MUTANT_EMBED_NO_ACTIVE_WINDOW
+    return;
+#endif
+    if (!XQueryTree( d, ev->xclient.window, &r, &parent, &children, &n )) return;
+    if (children) XFree( children );
+    if (parent == root) return;
+    XChangeProperty( d, ev->xclient.window, activate_atom( d ), XA_CARDINAL, 32, PropModeReplace,
+                     (unsigned char *)&on, 1 );
+}
+
