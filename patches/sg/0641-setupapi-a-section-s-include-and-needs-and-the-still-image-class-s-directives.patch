+/* Stained Glass OS: what the still image (scanner, camera) class installer
+ * does with a device section on Windows -- its STI directives, into the
+ * device's driver key: SubClass, DeviceType, DeviceSubType, Capabilities,
+ * DeviceData (a section of values, the DeviceData subkey: the vendor's
+ * library and TWAIN source names, its settings) and Events (a section of
+ * name = description, guid, application lines: Events\<name>). Scanner
+ * software reads them through SetupDiOpenClassRegKeyEx (the Ambir ImageScan
+ * Pro 490i's said "not connected" without them). Wine had no such installer. */
+static void install_sti_directives(HINF hinf, const WCHAR *section, HKEY driver_key)
+{
+    static const WCHAR *const strings[] = { L"SubClass", L"DeviceDescription" };
+    static const WCHAR *const numbers[] = { L"DeviceType", L"DeviceSubType", L"Capabilities" };
+    WCHAR value[MAX_INF_STRING_LENGTH], name[MAX_INF_STRING_LENGTH], sub[MAX_INF_STRING_LENGTH];
+    INFCONTEXT ctx, line;
+    HKEY key, event;
+    unsigned int i;
+    INT n;
+
+#ifdef SG_MUTANT_NOSTI
+    return;
+#endif
+    if (!SetupFindFirstLineW(hinf, section, L"SubClass", &ctx) &&
+        !SetupFindFirstLineW(hinf, section, L"DeviceData", &ctx)) return;
+
+    for (i = 0; i < ARRAY_SIZE(strings); i++)
+        if (SetupFindFirstLineW(hinf, section, strings[i], &ctx) &&
+            SetupGetStringFieldW(&ctx, 1, value, ARRAY_SIZE(value), NULL))
+            RegSetValueExW(driver_key, strings[i], 0, REG_SZ, (BYTE *)value, (lstrlenW(value) + 1) * sizeof(WCHAR));
+    for (i = 0; i < ARRAY_SIZE(numbers); i++)
+        if (SetupFindFirstLineW(hinf, section, numbers[i], &ctx) && SetupGetIntField(&ctx, 1, &n))
+            RegSetValueExW(driver_key, numbers[i], 0, REG_DWORD, (BYTE *)&n, sizeof(n));
+
+    /* DeviceData: its lines, as values of the DeviceData subkey */
+    if (SetupFindFirstLineW(hinf, section, L"DeviceData", &ctx) &&
+        SetupGetStringFieldW(&ctx, 1, sub, ARRAY_SIZE(sub), NULL) &&
+        !RegCreateKeyExW(driver_key, L"DeviceData", 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL))
+    {
+        if (SetupFindFirstLineW(hinf, sub, NULL, &line))
+        {
+            do
+            {
+                if (!SetupGetStringFieldW(&line, 0, name, ARRAY_SIZE(name), NULL) || !name[0]) continue;
+                if (!SetupGetStringFieldW(&line, 1, value, ARRAY_SIZE(value), NULL)) value[0] = 0;
+                RegSetValueExW(key, name, 0, REG_SZ, (BYTE *)value, (lstrlenW(value) + 1) * sizeof(WCHAR));
+            } while (SetupFindNextLine(&line, &line));
+        }
+        RegCloseKey(key);
+    }
+
+    /* Events: Events\<name>, its description, GUID and launch applications */
+    if (SetupFindFirstLineW(hinf, section, L"Events", &ctx) &&
+        SetupGetStringFieldW(&ctx, 1, sub, ARRAY_SIZE(sub), NULL) &&
+        !RegCreateKeyExW(driver_key, L"Events", 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL))
+    {
+        if (SetupFindFirstLineW(hinf, sub, NULL, &line))
+        {
+            do
+            {
+                if (!SetupGetStringFieldW(&line, 0, name, ARRAY_SIZE(name), NULL) || !name[0]) continue;
+                if (RegCreateKeyExW(key, name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &event, NULL)) continue;
+                if (SetupGetStringFieldW(&line, 1, value, ARRAY_SIZE(value), NULL))
+                    RegSetValueExW(event, NULL, 0, REG_SZ, (BYTE *)value, (lstrlenW(value) + 1) * sizeof(WCHAR));
+                if (SetupGetStringFieldW(&line, 2, value, ARRAY_SIZE(value), NULL))
+                    RegSetValueExW(event, L"GUID", 0, REG_SZ, (BYTE *)value, (lstrlenW(value) + 1) * sizeof(WCHAR));
+                if (SetupGetStringFieldW(&line, 3, value, ARRAY_SIZE(value), NULL))
+                    RegSetValueExW(event, L"LaunchApplications", 0, REG_SZ, (BYTE *)value, (lstrlenW(value) + 1) * sizeof(WCHAR));
+                RegCloseKey(event);
+            } while (SetupFindNextLine(&line, &line));
+        }
+        RegCloseKey(key);
+    }
+}
+
+/* the service a .Services section associates with the device (an AddService
+ * line with SPSVCINST_ASSOCSERVICE) */
+static BOOL assoc_service(HINF hinf, const WCHAR *section, WCHAR *svc_name, DWORD len)
+{
+    INFCONTEXT ctx;
+
+    if (!SetupFindFirstLineW(hinf, section, L"AddService", &ctx)) return FALSE;
+    do
+    {
+        INT flags;
+
+        if (SetupGetIntField(&ctx, 2, &flags) && (flags & SPSVCINST_ASSOCSERVICE))
+            return SetupGetStringFieldW(&ctx, 1, svc_name, len, NULL) && svc_name[0];
+    } while (SetupFindNextMatchLineW(&ctx, L"AddService", &ctx));
+    return FALSE;
+}
+
