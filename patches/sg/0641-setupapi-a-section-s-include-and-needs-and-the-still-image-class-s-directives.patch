+    return install_services( *(HINF *)((void **)arg)[0], needed, *(DWORD *)((void **)arg)[1] );
+}
+
 BOOL WINAPI SetupInstallServicesFromInfSectionW( HINF hinf, PCWSTR section, DWORD flags )
 {
+    void *args[2] = { &hinf, &flags };
+
+    include_infs( hinf, section );
+    if (!for_each_needed( hinf, section, install_needed_services, args )) return FALSE;
+    return install_services( hinf, section, flags );
+}
