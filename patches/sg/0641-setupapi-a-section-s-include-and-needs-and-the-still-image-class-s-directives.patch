From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] setupapi: a section's Include and Needs, and the still image class's directives

A device INF's section may Include= other INF files and Need= sections of
them, installed first as part of the same operation; a .Services section may
Need another's services. Scanner INFs say "Include=sti.inf /
Needs=STI.USBSection" and "Needs=STI.USBSection.Services" (the usbscan
driver), and carry the still image class installer's lines: SubClass,
DeviceType, DeviceSubType, Capabilities, DeviceData (values of a DeviceData
subkey) and Events (Events\<name>), which go into the device's driver key.
Wine read none of them; the Ambir ImageScan Pro 490i's library found no
scanner. A section a .Services section Needs may also name the device's
service.
---
--- a/dlls/setupapi/install.c
+++ b/dlls/setupapi/install.c
@@ -1100,6 +1100,89 @@
 }
 
 
+/* Stained Glass OS: a section's Include= and Needs=. Include names INF files
+ * (in %windir%\inf) whose sections this one may use; Needs names sections of
+ * them that are installed with it, first, as the same operation -- a device
+ * INF's "Include=sti.inf / Needs=STI.USBSection" (scanners: the Ambir
+ * ImageScan Pro 490i's), and its .Services section's "Needs=
+ * STI.USBSection.Services", which adds the usbscan service. Wine read
+ * neither, and the device had no driver. A needed section's own Needs are
+ * not followed, as on Windows. */
+static void include_infs( HINF hinf, PCWSTR section )
+{
+    WCHAR name[MAX_PATH];
+    INFCONTEXT context;
+    int i;
+
+#ifdef SG_MUTANT_NONEEDS
+    return;
+#endif
+    if (!SetupFindFirstLineW( hinf, section, L"Include", &context )) return;
+    do
+    {
+        for (i = 1; SetupGetStringFieldW( &context, i, name, ARRAY_SIZE(name), NULL ); i++)
+        {
+            if (!name[0] || PARSER_has_inf_file( hinf, name )) continue;
+            if (!SetupOpenAppendInfFileW( name, hinf, NULL ))
+                WARN( "%s: Include=%s not found\n", debugstr_w(section), debugstr_w(name) );
+        }
+    } while (SetupFindNextMatchLineW( &context, L"Include", &context ));
+}
+
+/* calls fn for each section the section Needs */
+static BOOL for_each_needed( HINF hinf, PCWSTR section, BOOL (*fn)( PCWSTR needed, void *ctx ), void *ctx )
+{
+    WCHAR needed[MAX_INF_STRING_LENGTH];
+    INFCONTEXT context;
+    int i;
+
+#ifdef SG_MUTANT_NONEEDS
+    return TRUE;
+#endif
+    if (!SetupFindFirstLineW( hinf, section, L"Needs", &context )) return TRUE;
+    do
+    {
+        for (i = 1; SetupGetStringFieldW( &context, i, needed, ARRAY_SIZE(needed), NULL ); i++)
+        {
+            if (!needed[0]) continue;
+            if (!SetupFindFirstLineW( hinf, needed, NULL, &(INFCONTEXT){0} ))
+            {
+                WARN( "%s: Needs=%s not found\n", debugstr_w(section), debugstr_w(needed) );
+                continue;
+            }
+            if (!fn( needed, ctx )) return FALSE;
+        }
+    } while (SetupFindNextMatchLineW( &context, L"Needs", &context ));
+    return TRUE;
+}
+
+struct install_needed_ctx
+{
+    HWND owner;
+    HINF hinf;
+    UINT flags;
+    HKEY key_root;
+    PCWSTR src_root;
+    UINT copy_flags;
+    PSP_FILE_CALLBACK_W callback;
+    PVOID context;
+    HDEVINFO devinfo;
+    PSP_DEVINFO_DATA devinfo_data;
+};
+
+static BOOL install_section( HWND owner, HINF hinf, PCWSTR section, UINT flags,
+                             HKEY key_root, PCWSTR src_root, UINT copy_flags,
+                             PSP_FILE_CALLBACK_W callback, PVOID context,
+                             HDEVINFO devinfo, PSP_DEVINFO_DATA devinfo_data );
+
+static BOOL install_needed( PCWSTR needed, void *arg )
+{
+    struct install_needed_ctx *c = arg;
+    TRACE( "installing needed section %s\n", debugstr_w(needed) );
+    return install_section( c->owner, c->hinf, needed, c->flags, c->key_root, c->src_root, c->copy_flags,
+                            c->callback, c->context, c->devinfo, c->devinfo_data );
+}
+
