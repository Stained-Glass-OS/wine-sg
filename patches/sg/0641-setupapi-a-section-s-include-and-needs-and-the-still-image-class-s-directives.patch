+/* Stained Glass OS: whether hinf (or a file appended to it) is the INF
+ * named name -- an Include= is appended once (install.c) */
+BOOL PARSER_has_inf_file( HINF hinf, const WCHAR *name )
+{
+    struct inf_file *file;
+    const WCHAR *base;
+
+    for (file = hinf; file; file = file->next)
+    {
+        if (!file->filename) continue;
+        base = wcsrchr( file->filename, '\\' );
+        base = base ? base + 1 : file->filename;
+        if (!wcsicmp( base, name ) || !wcsicmp( file->filename, name )) return TRUE;
+    }
+    return FALSE;
+}
