From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, wow64: NtQueryMultipleValueKey, NtQueryKey flag classes, NtSetInformationKey validation

- NtQueryMultipleValueKey was a stub that returned success without touching
  the caller's buffers, and had the wrong prototype: the buffer length is a
  PULONG (in: size, out: bytes used), not a ULONG. It now queries each named
  value, lays the data out 8-byte aligned in the caller's buffer and fills
  every entry's DataLength / DataOffset / Type; a missing value is
  STATUS_OBJECT_NAME_NOT_FOUND; a buffer too small is STATUS_BUFFER_OVERFLOW
  with the size needed in the last argument. The wow64 thunk converts the
  32-bit entry array (4-byte name pointers) and copies the results back.
- NtQueryKey: KeyVirtualizationInformation, KeyHandleTagsInformation and
  KeyTrustInformation answer one zero ULONG (a plain key is not virtualized,
  has no handle tags and is not a trusted key); a bad handle is still an
  error and no room is STATUS_BUFFER_TOO_SMALL.
- NtSetInformationKey accepted any class and length with a FIXME: an unknown
  class is now STATUS_INVALID_INFO_CLASS, a short buffer
  STATUS_INFO_LENGTH_MISMATCH, a bad handle an error. KeyWriteTime still needs
  server support and keeps its FIXME.
- NtEnumerateValueKey: KeyValuePartialInformationAlign64 (NtQueryValueKey had
  it already). NtOpenKeyEx: REG_OPTION_BACKUP_RESTORE and the DONT_VIRTUALIZE
  bit no longer log "options not implemented".

---
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -320,7 +320,7 @@
 @ stdcall -syscall NtQueryIoCompletion(long long ptr long ptr)
 @ stdcall -syscall NtQueryKey(long long ptr long ptr)
 @ stdcall -syscall NtQueryLicenseValue(ptr ptr ptr long ptr)
-@ stdcall -syscall NtQueryMultipleValueKey(long ptr long ptr long ptr)
+@ stdcall -syscall NtQueryMultipleValueKey(long ptr long ptr ptr ptr)
 @ stdcall -syscall NtQueryMutant(long long ptr long ptr)
 @ stdcall -syscall NtQueryObject(long long ptr long ptr)
 # @ stub NtQueryOpenSubKeys
@@ -1392,7 +1392,7 @@
 @ stdcall -private -syscall ZwQueryIoCompletion(long long ptr long ptr) NtQueryIoCompletion
 @ stdcall -private -syscall ZwQueryKey(long long ptr long ptr) NtQueryKey
 @ stdcall -private -syscall ZwQueryLicenseValue(ptr ptr ptr long ptr) NtQueryLicenseValue
-@ stdcall -private -syscall ZwQueryMultipleValueKey(long ptr long ptr long ptr) NtQueryMultipleValueKey
+@ stdcall -private -syscall ZwQueryMultipleValueKey(long ptr long ptr ptr ptr) NtQueryMultipleValueKey
 @ stdcall -private -syscall ZwQueryMutant(long long ptr long ptr) NtQueryMutant
 @ stdcall -private -syscall ZwQueryObject(long long ptr long ptr) NtQueryObject
 # @ stub ZwQueryOpenSubKeys
--- a/dlls/ntdll/signal_arm64ec.c
+++ b/dlls/ntdll/signal_arm64ec.c
@@ -483,7 +483,7 @@ DEFINE_SYSCALL(NtQueryInstallUILanguage, (LANGID *lang))
 DEFINE_SYSCALL(NtQueryIoCompletion, (HANDLE handle, IO_COMPLETION_INFORMATION_CLASS class, void *buffer, ULONG len, ULONG *ret_len))
 DEFINE_SYSCALL(NtQueryKey, (HANDLE handle, KEY_INFORMATION_CLASS info_class, void *info, DWORD length, DWORD *result_len))
 DEFINE_SYSCALL(NtQueryLicenseValue, (const UNICODE_STRING *name, ULONG *type, void *data, ULONG length, ULONG *retlen))
-DEFINE_SYSCALL(NtQueryMultipleValueKey, (HANDLE key, KEY_MULTIPLE_VALUE_INFORMATION *info, ULONG count, void *buffer, ULONG length, ULONG *retlen))
+DEFINE_SYSCALL(NtQueryMultipleValueKey, (HANDLE key, KEY_MULTIPLE_VALUE_INFORMATION *info, ULONG count, void *buffer, ULONG *length, ULONG *retlen))
 DEFINE_SYSCALL(NtQueryMutant, (HANDLE handle, MUTANT_INFORMATION_CLASS class, void *info, ULONG len, ULONG *ret_len))
 DEFINE_SYSCALL(NtQueryObject, (HANDLE handle, OBJECT_INFORMATION_CLASS info_class, void *ptr, ULONG len, ULONG *used_len))
 DEFINE_SYSCALL(NtQueryPerformanceCounter, (LARGE_INTEGER *counter, LARGE_INTEGER *frequency))
--- a/dlls/ntdll/unix/registry.c
+++ b/dlls/ntdll/unix/registry.c
@@ -167,7 +167,7 @@ NTSTATUS WINAPI NtOpenKeyEx( HANDLE *key, ACCESS_MASK access, const OBJECT_ATTRI
 
     TRACE( "(%p,%s,%x,%p)\n", attr->RootDirectory, debugstr_us(attr->ObjectName), (int)access, key );
 
-    if (options & ~REG_OPTION_OPEN_LINK) FIXME( "options %x not implemented\n", (int)options );
+    if (options & ~(REG_OPTION_OPEN_LINK | REG_OPTION_BACKUP_RESTORE | 0x10 /* REG_OPTION_DONT_VIRTUALIZE */)) FIXME( "options %x not implemented\n", (int)options );
 
     attributes = attr->Attributes | OBJ_CASE_INSENSITIVE;
 
@@ -258,6 +258,30 @@ NTSTATUS WINAPI NtRenameKey( HANDLE key, UNICODE_STRING *name )
 }
 
 
+static NTSTATUS enumerate_key( HANDLE handle, int index, KEY_INFORMATION_CLASS info_class,
+                               void *info, DWORD length, DWORD *result_len );
+
+/* NtQueryKey classes that return one ULONG of flag bits; the key itself is only
+ * validated (handle and access) through a cached-information query */
+static NTSTATUS query_key_flags_class( HANDLE handle, KEY_INFORMATION_CLASS info_class,
+                                       void *info, DWORD length, DWORD *result_len )
+{
+    NTSTATUS ret;
+    ULONG value = 0;
+    KEY_CACHED_INFORMATION cached;
+    DWORD dummy;
+
+    if (!result_len) return STATUS_ACCESS_VIOLATION;
+    ret = enumerate_key( handle, -1, KeyCachedInformation, &cached, sizeof(cached), &dummy );
+    if (ret && ret != STATUS_BUFFER_OVERFLOW) return ret;
+    *result_len = sizeof(value);
+    if (length < sizeof(value)) return STATUS_BUFFER_TOO_SMALL;
+    if (!info) return STATUS_ACCESS_VIOLATION;
+    memcpy( info, &value, sizeof(value) );
+    return STATUS_SUCCESS;
+}
+
+
 /******************************************************************************
  *     enumerate_key
  *
@@ -278,7 +302,17 @@ static NTSTATUS enumerate_key( HANDLE handle, int index, KEY_INFORMATION_CLASS i
     case KeyNodeInformation:   data_ptr = ((KEY_NODE_INFORMATION *)info)->Name;  break;
     case KeyNameInformation:   data_ptr = ((KEY_NAME_INFORMATION *)info)->Name;  break;
     case KeyCachedInformation: data_ptr = ((KEY_CACHED_INFORMATION *)info)+1;    break;
+#ifndef SG_MUTANT_NO_FLAGCLASSES
+    case KeyVirtualizationInformation:
+    case KeyHandleTagsInformation:
+    case KeyTrustInformation:
+        /* single-ULONG classes with no per-key state in Wine: a plain key is
+         * not virtualized, has no handle tags and is not a trusted key */
+        if (index != -1) return STATUS_INVALID_PARAMETER;
+        return query_key_flags_class( handle, info_class, info, length, result_len );
+#endif
     default:
+        if (info_class < 0 || info_class > KeyLayerInformation) return STATUS_INVALID_PARAMETER;
         FIXME( "Information class %d not implemented\n", info_class );
         return STATUS_INVALID_PARAMETER;
     }
@@ -404,7 +438,39 @@ NTSTATUS WINAPI NtQueryKey( HANDLE handle, KEY_INFORMATION_CLASS info_class,
  */
 NTSTATUS WINAPI NtSetInformationKey( HANDLE key, int class, void *info, ULONG length )
 {
-    FIXME( "(%p,0x%08x,%p,0x%08x) stub\n", key, class, info, (int)length );
+    static const ULONG sizes[] =
+    {
+        sizeof(LARGE_INTEGER),  /* KeyWriteTimeInformation */
+        sizeof(ULONG),          /* KeyWow64FlagsInformation */
+        sizeof(ULONG),          /* KeyControlFlagsInformation */
+        sizeof(ULONG),          /* KeySetVirtualizationInformation */
+        sizeof(ULONG),          /* KeySetDebugInformation */
+        sizeof(ULONG),          /* KeySetHandleTagsInformation */
+        sizeof(ULONG),          /* KeySetLayerInformation */
+    };
+    KEY_CACHED_INFORMATION cached;
+    DWORD dummy;
+    NTSTATUS ret;
+
+    TRACE( "(%p,0x%08x,%p,0x%08x)\n", key, class, info, (int)length );
+
+#ifndef SG_MUTANT_SETINFO_NOCHECK
+    if (class < 0 || class >= ARRAY_SIZE(sizes)) return STATUS_INVALID_INFO_CLASS;
+    if (length < sizes[class]) return STATUS_INFO_LENGTH_MISMATCH;
+#endif
+    if (!info) return STATUS_ACCESS_VIOLATION;
+
+    /* the handle has to be a valid key handle */
+    ret = enumerate_key( key, -1, KeyCachedInformation, &cached, sizeof(cached), &dummy );
+    if (ret && ret != STATUS_BUFFER_OVERFLOW) return ret;
+
+    if (class == 0)  /* KeyWriteTimeInformation needs server support */
+    {
+        FIXME( "KeyWriteTimeInformation not implemented\n" );
+        return STATUS_SUCCESS;
+    }
+    /* the remaining classes only carry per-handle flags (WOW64 view, virtualization,
+     * handle tags, layers) that have no observable effect in this registry */
     return STATUS_SUCCESS;
 }
 
@@ -484,6 +550,8 @@ NTSTATUS WINAPI NtEnumerateValueKey( HANDLE handle, ULONG index, KEY_VALUE_INFOR
     case KeyValueBasicInformation:   ptr = ((KEY_VALUE_BASIC_INFORMATION *)info)->Name; break;
     case KeyValueFullInformation:    ptr = ((KEY_VALUE_FULL_INFORMATION *)info)->Name; break;
     case KeyValuePartialInformation: ptr = ((KEY_VALUE_PARTIAL_INFORMATION *)info)->Data; break;
+    case KeyValuePartialInformationAlign64:
+        ptr = ((KEY_VALUE_PARTIAL_INFORMATION_ALIGN64 *)info)->Data; break;
     default:
         FIXME( "Information class %d not implemented\n", info_class );
         return STATUS_INVALID_PARAMETER;
@@ -494,7 +562,8 @@ NTSTATUS WINAPI NtEnumerateValueKey( HANDLE handle, ULONG index, KEY_VALUE_INFOR
     {
         req->hkey       = wine_server_obj_handle( handle );
         req->index      = index;
-        req->info_class = info_class;
+        /* the server only knows the three basic layouts */
+        req->info_class = (info_class == KeyValuePartialInformationAlign64) ? KeyValuePartialInformation : info_class;
         if (length > fixed_size) wine_server_set_reply( req, ptr, length - fixed_size );
         if (!(ret = wine_server_call( req )))
         {
@@ -587,10 +656,55 @@ NTSTATUS WINAPI NtQueryValueKey( HANDLE handle, const UNICODE_STRING *name,
  *              NtQueryMultipleValueKey  (NTDLL.@)
  */
 NTSTATUS WINAPI NtQueryMultipleValueKey( HANDLE key, KEY_MULTIPLE_VALUE_INFORMATION *info,
-                                         ULONG count, void *buffer, ULONG length, ULONG *retlen )
+                                         ULONG count, void *buffer, ULONG *length, ULONG *retlen )
 {
-    FIXME( "(%p,%p,0x%08x,%p,0x%08x,%p) stub!\n", key, info, (int)count, buffer, (int)length, retlen );
-    return STATUS_SUCCESS;
+    KEY_VALUE_PARTIAL_INFORMATION *tmp;
+    ULONG tmp_size = 256, required = 0, i;
+    NTSTATUS ret = STATUS_SUCCESS, status;
+    BOOL overflow = FALSE;
+
+    TRACE( "(%p,%p,%u,%p,%p,%p)\n", key, info, (int)count, buffer, length, retlen );
+
+    if (!length) return STATUS_ACCESS_VIOLATION;
+    if (count && !info) return STATUS_ACCESS_VIOLATION;
+    if (*length && !buffer) return STATUS_ACCESS_VIOLATION;
+
+    if (!(tmp = malloc( tmp_size ))) return STATUS_NO_MEMORY;
+
+    for (i = 0; i < count; i++)
+    {
+        ULONG size, offset = (required + 7) & ~7;
+
+        if (!info[i].ValueName) { ret = STATUS_ACCESS_VIOLATION; break; }
+        for (;;)
+        {
+            status = NtQueryValueKey( key, info[i].ValueName, KeyValuePartialInformation,
+                                      tmp, tmp_size, &size );
+            if (status != STATUS_BUFFER_OVERFLOW && status != STATUS_BUFFER_TOO_SMALL) break;
+            free( tmp );
+            tmp_size = max( size, tmp_size * 2 );
+            if (!(tmp = malloc( tmp_size ))) return STATUS_NO_MEMORY;
+        }
+        if (status) { ret = status; break; }
+
+        required = offset + tmp->DataLength;
+        info[i].DataLength = tmp->DataLength;
+        info[i].DataOffset = offset;
+        info[i].Type       = tmp->Type;
+        if (required > *length) overflow = TRUE;
+#ifndef SG_MUTANT_MULTI_NOCOPY
+        else memcpy( (char *)buffer + offset, tmp->Data, tmp->DataLength );
+#endif
+    }
+    free( tmp );
+
+    if (!ret)
+    {
+        if (retlen) *retlen = required;
+        if (overflow) ret = STATUS_BUFFER_OVERFLOW;
+        else *length = required;
+    }
+    return ret;
 }
 
 
--- a/dlls/wow64/registry.c
+++ b/dlls/wow64/registry.c
@@ -367,14 +367,42 @@ NTSTATUS WINAPI wow64_NtQueryKey( UINT *args )
 NTSTATUS WINAPI wow64_NtQueryMultipleValueKey( UINT *args )
 {
     HANDLE handle = get_handle( &args );
-    KEY_MULTIPLE_VALUE_INFORMATION *info = get_ptr( &args );
+    struct { ULONG ValueName; ULONG DataLength; ULONG DataOffset; ULONG Type; } *info32 = get_ptr( &args );
     ULONG count = get_ulong( &args );
     void *ptr = get_ptr( &args );
-    ULONG len = get_ulong( &args );
+    ULONG *len = get_ptr( &args );
     ULONG *retlen = get_ptr( &args );
 
-    FIXME( "%p %p %lu %p %lu %p: stub\n", handle, info, count, ptr, len, retlen );
-    return STATUS_SUCCESS;
+    KEY_MULTIPLE_VALUE_INFORMATION *info = NULL;
+    UNICODE_STRING *names = NULL;
+    NTSTATUS status;
+    ULONG i;
+
+    if (count)
+    {
+        if (!info32) return STATUS_ACCESS_VIOLATION;
+        if (count > 0x10000) return STATUS_INVALID_PARAMETER;
+        if (!(info = Wow64AllocateTemp( count * (sizeof(*info) + sizeof(*names)) ))) return STATUS_NO_MEMORY;
+        names = (UNICODE_STRING *)(info + count);
+        for (i = 0; i < count; i++)
+        {
+            info[i].ValueName = info32[i].ValueName ? unicode_str_32to64( &names[i], ULongToPtr( info32[i].ValueName )) : NULL;
+            info[i].DataLength = info32[i].DataLength;
+            info[i].DataOffset = info32[i].DataOffset;
+            info[i].Type       = info32[i].Type;
+        }
+    }
+    status = NtQueryMultipleValueKey( handle, info, count, ptr, len, retlen );
+    if (!status || status == STATUS_BUFFER_OVERFLOW)
+    {
+        for (i = 0; i < count; i++)
+        {
+            info32[i].DataLength = info[i].DataLength;
+            info32[i].DataOffset = info[i].DataOffset;
+            info32[i].Type       = info[i].Type;
+        }
+    }
+    return status;
 }
 
 
--- a/include/winternl.h
+++ b/include/winternl.h
@@ -4719,7 +4719,7 @@ NTSYSAPI NTSTATUS  WINAPI NtQueryInstallUILanguage(LANGID*);
 NTSYSAPI NTSTATUS  WINAPI NtQueryIntervalProfile(KPROFILE_SOURCE,PULONG);
 NTSYSAPI NTSTATUS  WINAPI NtQueryIoCompletion(HANDLE,IO_COMPLETION_INFORMATION_CLASS,PVOID,ULONG,PULONG);
 NTSYSAPI NTSTATUS  WINAPI NtQueryKey(HANDLE,KEY_INFORMATION_CLASS,void *,DWORD,DWORD *);
-NTSYSAPI NTSTATUS  WINAPI NtQueryMultipleValueKey(HANDLE,PKEY_MULTIPLE_VALUE_INFORMATION,ULONG,PVOID,ULONG,PULONG);
+NTSYSAPI NTSTATUS  WINAPI NtQueryMultipleValueKey(HANDLE,PKEY_MULTIPLE_VALUE_INFORMATION,ULONG,PVOID,PULONG,PULONG);
 NTSYSAPI NTSTATUS  WINAPI NtQueryMutant(HANDLE,MUTANT_INFORMATION_CLASS,PVOID,ULONG,PULONG);
 NTSYSAPI NTSTATUS  WINAPI NtQueryObject(HANDLE, OBJECT_INFORMATION_CLASS, PVOID, ULONG, PULONG);
 NTSYSAPI NTSTATUS  WINAPI NtQueryOpenSubKeys(POBJECT_ATTRIBUTES,PULONG);
