+/* Stained Glass OS (wine-sg 8202): the image functions and ICLRStrongName */
+
+/* the bytes of the file at PATH; with too small a buffer, the size it needs */
+BOOLEAN WINAPI StrongNameGetBlob( const WCHAR *path, BYTE *blob, DWORD *blob_len )
+{
+    BYTE *data;
+    DWORD size;
+
+    TRACE( "(%s, %p, %p)\n", debugstr_w(path), blob, blob_len );
+
+    if (!path || !blob || !blob_len) return fail( E_POINTER );
+    if (!read_file( path, &data, &size )) return FALSE;
+    if (size > *blob_len)
+    {
+        *blob_len = size;
+        free( data );
+        return fail( HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER ) );
+    }
+    memcpy( blob, data, size );
+    *blob_len = size;
+    free( data );
+    return TRUE;
+}
+
+BOOLEAN WINAPI StrongNameGetBlobFromImage( BYTE *base, DWORD length, BYTE *blob, DWORD *blob_len )
+{
+    TRACE( "(%p, %lu, %p, %p)\n", base, length, blob, blob_len );
+
+    if (!base || !blob || !blob_len) return fail( E_POINTER );
+    if (length > *blob_len)
+    {
+        *blob_len = length;
+        return fail( HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER ) );
+    }
+    memcpy( blob, base, length );
+    *blob_len = length;
+    return TRUE;
+}
+
+/* an image as the loader mapped it (BASE, LENGTH bytes), laid out again as its file: the headers and each
+ * section's raw data at its file offset */
+static BOOLEAN unmap_image( const BYTE *base, DWORD length, BYTE **data, DWORD *size )
+{
+    DWORD pe, nsect, opt_size, sect, headers, i, end;
+    BYTE *out;
+
+    if (length < 0x40 || base[0] != 'M' || base[1] != 'Z') return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+    pe = rd32( base + 0x3c );
+    if (pe < 0x40 || pe > length || length - pe < 24 + 64 || rd32( base + pe ) != 0x4550)
+        return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+    nsect = rd16( base + pe + 6 );
+    opt_size = rd16( base + pe + 20 );
+    sect = pe + 24 + opt_size;
+    if (opt_size < 64 || sect > length || nsect > (length - sect) / SN_SECTION_SIZE)
+        return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+    headers = rd32( base + pe + 24 + 60 );   /* SizeOfHeaders */
+    if (headers < sect + nsect * SN_SECTION_SIZE || headers > length) headers = sect + nsect * SN_SECTION_SIZE;
+    end = headers;
+    for (i = 0; i < nsect; i++)
+    {
+        const BYTE *s = base + sect + i * SN_SECTION_SIZE;
+        DWORD va = rd32( s + 12 ), rsize = rd32( s + 16 ), raw = rd32( s + 20 );
+
+        if (va > length || rsize > length - va || raw > SN_MAX_FILE || rsize > SN_MAX_FILE - raw)
+            return fail( CORSEC_E_INVALID_IMAGE_FORMAT );
+        end = max( end, raw + rsize );
+    }
+    if (!(out = calloc( 1, end ))) return fail( E_OUTOFMEMORY );
+    memcpy( out, base, headers );
+    for (i = 0; i < nsect; i++)
+    {
+        const BYTE *s = base + sect + i * SN_SECTION_SIZE;
+#ifndef SG_MUTANT_SN_IMAGE_FLAT
+        memcpy( out + rd32( s + 20 ), base + rd32( s + 12 ), rd32( s + 16 ) );
+#else
+        memcpy( out + rd32( s + 20 ), base + rd32( s + 20 ), min( rd32( s + 16 ), length - rd32( s + 20 ) ) );
+#endif
+    }
+    *data = out;
+    *size = end;
+    return TRUE;
+}
+
+/* the signature of a mapped image; an image from memory has no location, so a framework (ECMA-keyed)
+ * assembly is not trusted by where it is */
+BOOLEAN WINAPI StrongNameSignatureVerificationFromImage( BYTE *base, DWORD length, DWORD flags, DWORD *out_flags )
+{
+    struct sn_image img;
+    struct sn_assembly as;
+    BYTE *data;
+    DWORD size;
+    BOOLEAN ret;
+
+    TRACE( "(%p, %lu, %#lx, %p)\n", base, length, flags, out_flags );
+
+    if (out_flags) *out_flags = 0;
+    if (!base) return fail( E_POINTER );
+    if (!unmap_image( base, length, &data, &size )) return FALSE;
+    if (!parse_image( &img, data, size ) || !read_assembly( &img, &as ))
+    {
+        free( data );
+        return FALSE;
+    }
+    if (!(flags & SN_INFLAG_FORCE_VER) && skip_registered( &as )) ret = TRUE;
+    else if ((ret = verify_image( &img, &as, NULL )) && out_flags) *out_flags = SN_OUTFLAG_WAS_VERIFIED;
+    free( as.key );
+    free( data );
+    return ret;
+}
+
+/* (shimhash.c) */
+extern HRESULT WINAPI GetHashFromAssemblyFile( const char *path, DWORD *alg, BYTE *out, DWORD size, DWORD *len );
+extern HRESULT WINAPI GetHashFromAssemblyFileW( const WCHAR *path, DWORD *alg, BYTE *out, DWORD size, DWORD *len );
+extern HRESULT WINAPI GetHashFromBlob( BYTE *blob, DWORD blob_len, DWORD *alg, BYTE *out, DWORD size, DWORD *len );
+extern HRESULT WINAPI GetHashFromFile( const char *path, DWORD *alg, BYTE *out, DWORD size, DWORD *len );
