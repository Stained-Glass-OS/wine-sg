+
+/* ICLRStrongName (ICLRRuntimeInfo::GetInterface(CLSID_CLRStrongName)): the functions above, with the
+ * error as the HRESULT */
+static HRESULT sn_result( BOOLEAN ret )
+{
+    HRESULT hr;
+
+    if (ret) return S_OK;
+    hr = StrongNameErrorInfo();
+#ifdef SG_MUTANT_SN_IFACE_OK
+    hr = S_OK;
+#endif
+    return FAILED(hr) ? hr : E_FAIL;
+}
