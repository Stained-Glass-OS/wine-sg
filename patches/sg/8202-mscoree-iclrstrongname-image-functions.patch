+static HRESULT WINAPI clrsn_QueryInterface( ICLRStrongName *iface, REFIID riid, void **ppv )
+{
+    if (IsEqualGUID( riid, &IID_ICLRStrongName ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
