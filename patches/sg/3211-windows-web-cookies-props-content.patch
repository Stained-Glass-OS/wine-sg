+/* A completed operation whose result is a number (e.g. BufferAllAsync, WriteToStreamAsync). */
+HRESULT http_async_complete_u64( const GUID *iid, UINT64 result, IInspectable **out )
+{
+    struct async_op *impl = async_alloc( iid );
+    if (!impl) return E_OUTOFMEMORY;
+    impl->is_u64 = TRUE;
+    impl->result_u64 = result;
+    *out = (IInspectable *)&impl->lpVtbl;
+    return S_OK;
