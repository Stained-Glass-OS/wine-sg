+static HRESULT WINAPI cview_get_Size( IVectorView_HttpCookie *iface, UINT32 *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = view_from_IVectorView( iface )->count;
+    return S_OK;
+}
+static HRESULT WINAPI cview_IndexOf( IVectorView_HttpCookie *iface, IHttpCookie *element, UINT32 *index, boolean *found )
+{
+    struct cookie_view *impl = view_from_IVectorView( iface );
+    UINT32 i;
+    TRACE( "iface %p, element %p, index %p, found %p.\n", iface, element, index, found );
+    *found = FALSE;
+    *index = 0;
+    for (i = 0; i < impl->count; i++)
+    {
+        if (impl->items[i] == (IHttpCookie *)element) { *index = i; *found = TRUE; break; }
+    }
+    return S_OK;
+}
+static HRESULT WINAPI cview_GetMany( IVectorView_HttpCookie *iface, UINT32 start, UINT32 capacity, IHttpCookie **items, UINT32 *actual )
+{
+    struct cookie_view *impl = view_from_IVectorView( iface );
+    UINT32 n = 0;
+    TRACE( "iface %p, start %u, capacity %u, items %p, actual %p.\n", iface, start, capacity, items, actual );
+    *actual = 0;
+    if (start > impl->count) return E_BOUNDS;
+    while (n < capacity && start + n < impl->count)
+    {
+        IHttpCookie_AddRef( impl->items[start + n] );
+        items[n] = (IHttpCookie *)impl->items[start + n];
+        n++;
+    }
+    *actual = n;
+    return S_OK;
+}
+
+static const IVectorView_HttpCookieVtbl cview_vtbl =
+{
+    cview_QueryInterface, cview_AddRef, cview_Release,
+    cview_GetIids, cview_GetRuntimeClassName, cview_GetTrustLevel,
+    cview_GetAt, cview_get_Size, cview_IndexOf, cview_GetMany,
+};
+
+static HRESULT WINAPI cit_QueryInterface( IIterable_HttpCookie *iface, REFIID iid, void **out )
+{
+    return cview_qi( view_from_IIterable( iface ), iid, out );
+}
+static ULONG WINAPI cit_AddRef( IIterable_HttpCookie *iface ) { return InterlockedIncrement( &view_from_IIterable( iface )->ref ); }
+static ULONG WINAPI cit_Release( IIterable_HttpCookie *iface ) { return cview_release( view_from_IIterable( iface ) ); }
+static HRESULT WINAPI cit_GetIids( IIterable_HttpCookie *iface, ULONG *count, IID **iids ) { return cview_get_iids( count, iids ); }
+static HRESULT WINAPI cit_GetRuntimeClassName( IIterable_HttpCookie *iface, HSTRING *name ) { return cview_class_name( name ); }
+static HRESULT WINAPI cit_GetTrustLevel( IIterable_HttpCookie *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI cit_First( IIterable_HttpCookie *iface, IIterator_HttpCookie **value )
+{
+    struct cookie_view *view = view_from_IIterable( iface );
+    struct cookie_iterator *it;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!(it = calloc( 1, sizeof(*it) ))) return E_OUTOFMEMORY;
+    it->IIterator_iface.lpVtbl = &citer_vtbl;
+    it->ref = 1;
+    it->view = view;
+    InterlockedIncrement( &view->ref );
+    *value = &it->IIterator_iface;
+    return S_OK;
+}
+
+static const IIterable_HttpCookieVtbl cit_vtbl =
+{
+    cit_QueryInterface, cit_AddRef, cit_Release,
+    cit_GetIids, cit_GetRuntimeClassName, cit_GetTrustLevel,
+    cit_First,
+};
+
+/* takes ownership of the cookie references in items */
+static HRESULT cookie_view_create( IHttpCookie **items, UINT32 count, IVectorView_HttpCookie **out )
+{
+    struct cookie_view *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        while (count--) IHttpCookie_Release( items[count] );
+        free( items );
+        return E_OUTOFMEMORY;
+    }
+    impl->IVectorView_iface.lpVtbl = &cview_vtbl;
+    impl->IIterable_iface.lpVtbl = &cit_vtbl;
+    impl->ref = 1;
+    impl->items = items;
+    impl->count = count;
+    *out = &impl->IVectorView_iface;
+    return S_OK;
+}
