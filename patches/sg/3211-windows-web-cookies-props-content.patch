+/* IInspectable::GetIids for an object implementing the given interfaces */
+HRESULT web_get_iids( const IID *const *ids, ULONG count, ULONG *out_count, IID **out )
+{
+    IID *list;
+    ULONG i;
+
+    if (!out_count || !out) return E_POINTER;
+    if (!(list = CoTaskMemAlloc( count * sizeof(*list) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++) list[i] = *ids[i];
+    *out_count = count;
+    *out = list;
+    return S_OK;
+}
+
+HRESULT web_class_name( const WCHAR *name, HSTRING *out )
+{
+    if (!out) return E_POINTER;
+    return WindowsCreateString( name, wcslen( name ), out );
+}
+
+/* Wait for a foreign IAsyncInfo operation to leave the Started state. */
+HRESULT web_wait_async( IInspectable *op, HRESULT *error )
+{
+    IAsyncInfo *info;
+    AsyncStatus status = Started;
+    DWORD start = GetTickCount();
+    HRESULT hr;
+
+    *error = S_OK;
+    if (FAILED( hr = IInspectable_QueryInterface( op, &IID_IAsyncInfo, (void **)&info ) )) return hr;
+    while (SUCCEEDED( hr = IAsyncInfo_get_Status( info, &status ) ) && status == Started)
+    {
+        if (GetTickCount() - start > 60000) { hr = HRESULT_FROM_WIN32( ERROR_TIMEOUT ); break; }
+        Sleep( 1 );
+    }
+    if (SUCCEEDED( hr ))
+    {
+        if (status == Error) IAsyncInfo_get_ErrorCode( info, error );
+        else if (status == Canceled) *error = HRESULT_FROM_WIN32( ERROR_CANCELLED );
+    }
+    IAsyncInfo_Release( info );
+    return hr;
+}
+
+/* A Windows.Storage.Streams.Buffer holding a copy of the bytes. */
+HRESULT web_buffer_create( const BYTE *data, UINT32 len, IBuffer **out )
+{
+    IBufferFactory *factory;
+    IBufferByteAccess *access;
+    HSTRING name;
+    IBuffer *buffer;
+    BYTE *dst;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED( hr = WindowsCreateString( RuntimeClass_Windows_Storage_Streams_Buffer,
+                                          wcslen( RuntimeClass_Windows_Storage_Streams_Buffer ), &name ) )) return hr;
+    hr = RoGetActivationFactory( name, &IID_IBufferFactory, (void **)&factory );
+    WindowsDeleteString( name );
+    if (FAILED( hr )) return hr;
+    hr = IBufferFactory_Create( factory, len, &buffer );
+    IBufferFactory_Release( factory );
+    if (FAILED( hr )) return hr;
+    if (SUCCEEDED( hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&access ) ))
+    {
+        if (SUCCEEDED( hr = access->lpVtbl->Buffer( access, &dst ) ))
+        {
+            if (len) memcpy( dst, data, len );
+#ifdef SG_MUTANT_WEBB1_LENGTH
+            len = 0;
+#endif
+            hr = IBuffer_put_Length( buffer, len );
+        }
+        access->lpVtbl->Release( access );
+    }
+    if (FAILED( hr )) { IBuffer_Release( buffer ); return hr; }
+    *out = buffer;
+    return S_OK;
+}
+
+HRESULT web_buffer_get_bytes( IBuffer *buffer, BYTE **data, UINT32 *len )
+{
+    IBufferByteAccess *access;
+    HRESULT hr;
+
+    if (FAILED( hr = IBuffer_get_Length( buffer, len ) )) return hr;
+    if (FAILED( hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&access ) )) return hr;
+    hr = access->lpVtbl->Buffer( access, data );
+    access->lpVtbl->Release( access );
+    return hr;
+}
+
+/* An in-memory stream holding the bytes, as the input stream positioned at its start. */
+HRESULT web_stream_create( const BYTE *data, UINT32 len, IInputStream **out )
+{
+    IRandomAccessStream *stream;
+    IOutputStream *output;
+    IInspectable *inspectable, *op;
+    IBuffer *buffer;
+    HSTRING name;
+    HRESULT hr, error;
+
+    *out = NULL;
+    if (FAILED( hr = WindowsCreateString( RuntimeClass_Windows_Storage_Streams_InMemoryRandomAccessStream,
+                                          wcslen( RuntimeClass_Windows_Storage_Streams_InMemoryRandomAccessStream ), &name ) ))
+        return hr;
+    hr = RoActivateInstance( name, &inspectable );
+    WindowsDeleteString( name );
+    if (FAILED( hr )) return hr;
+    hr = IInspectable_QueryInterface( inspectable, &IID_IRandomAccessStream, (void **)&stream );
+    IInspectable_Release( inspectable );
+    if (FAILED( hr )) return hr;
+
+    if (len)
+    {
+        if (SUCCEEDED( hr = web_buffer_create( data, len, &buffer ) ))
+        {
+            if (SUCCEEDED( hr = IRandomAccessStream_QueryInterface( stream, &IID_IOutputStream, (void **)&output ) ))
