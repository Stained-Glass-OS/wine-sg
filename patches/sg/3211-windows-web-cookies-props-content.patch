+static HRESULT WINAPI map_Insert( IMap_HSTRING_IInspectable *iface, HSTRING key, IInspectable *value, boolean *replaced )
+{
+    struct prop_map *impl = impl_from_IMap( iface );
+    UINT32 i;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, key %s, value %p, replaced %p.\n", iface, debugstr_hstring( key ), value, replaced );
+    if (!replaced) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    if ((i = entries_find( impl->entries, impl->count, key )) != ~0u)
+    {
+        if (value) IInspectable_AddRef( value );
+        if (impl->entries[i].value) IInspectable_Release( impl->entries[i].value );
+        impl->entries[i].value = value;
+        *replaced = TRUE;
+#ifdef SG_MUTANT_WEBB1_REPLACE
+        *replaced = FALSE;
+#endif
+    }
+    else
+    {
+        if (impl->count == impl->capacity)
+        {
+            UINT32 cap = impl->capacity ? impl->capacity * 2 : 8;
+            struct entry *grown = realloc( impl->entries, cap * sizeof(*grown) );
+            if (grown) { impl->entries = grown; impl->capacity = cap; }
+            else hr = E_OUTOFMEMORY;
+        }
+        if (SUCCEEDED( hr ) && SUCCEEDED( hr = WindowsDuplicateString( key, &impl->entries[impl->count].key ) ))
+        {
+            if ((impl->entries[impl->count].value = value)) IInspectable_AddRef( value );
