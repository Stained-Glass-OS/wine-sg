+/* ---- HttpCookie --------------------------------------------------------- */
+struct cookie
+{
+    IHttpCookie IHttpCookie_iface;
+    IStringable IStringable_iface;
+    LONG ref;
+    WCHAR *name, *domain, *path, *value;
+    IReference_DateTime *expires;
+    boolean http_only, secure;
+};
+
+static inline struct cookie *impl_from_IHttpCookie( IHttpCookie *iface )
+{
+    return CONTAINING_RECORD( iface, struct cookie, IHttpCookie_iface );
+}
+
+static inline struct cookie *impl_from_cookie_IStringable( IStringable *iface )
+{
+    return CONTAINING_RECORD( iface, struct cookie, IStringable_iface );
+}
+
+static WCHAR *hstring_dup( HSTRING s )
+{
+    UINT32 len = 0;
+    const WCHAR *buf = WindowsGetStringRawBuffer( s, &len );
+    WCHAR *out = malloc( (len + 1) * sizeof(WCHAR) );
+    if (out) { if (len) memcpy( out, buf, len * sizeof(WCHAR) ); out[len] = 0; }
+    return out;
+}
+
+static WCHAR *wcsdup_n( const WCHAR *s, size_t n )
+{
+    WCHAR *out = malloc( (n + 1) * sizeof(WCHAR) );
+    if (out) { memcpy( out, s, n * sizeof(WCHAR) ); out[n] = 0; }
+    return out;
+}
+
+static HRESULT string_to_hstring( const WCHAR *s, HSTRING *out )
+{
+    return WindowsCreateString( s, s ? wcslen( s ) : 0, out );
+}
+
+static HRESULT cookie_qi( struct cookie *impl, REFIID iid, void **out )
+{
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IHttpCookie ))
+        *out = &impl->IHttpCookie_iface;
+    else if (IsEqualGUID( iid, &IID_IStringable ))
+        *out = &impl->IStringable_iface;
+    if (!*out)
+    {
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG cookie_release( struct cookie *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->expires) IReference_DateTime_Release( impl->expires );
+        free( impl->name ); free( impl->domain ); free( impl->path ); free( impl->value );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI cookie_QueryInterface( IHttpCookie *iface, REFIID iid, void **out )
+{
+    return cookie_qi( impl_from_IHttpCookie( iface ), iid, out );
+}
+static ULONG WINAPI cookie_AddRef( IHttpCookie *iface ) { return InterlockedIncrement( &impl_from_IHttpCookie( iface )->ref ); }
+static ULONG WINAPI cookie_Release( IHttpCookie *iface ) { return cookie_release( impl_from_IHttpCookie( iface ) ); }
+static HRESULT WINAPI cookie_GetIids( IHttpCookie *iface, ULONG *count, IID **iids )
+{
+    static const IID *const ids[] = { &IID_IHttpCookie, &IID_IStringable };
+    return web_get_iids( ids, ARRAY_SIZE(ids), count, iids );
+}
+static HRESULT WINAPI cookie_GetRuntimeClassName( IHttpCookie *iface, HSTRING *name )
+{
+    return web_class_name( RuntimeClass_Windows_Web_Http_HttpCookie, name );
+}
+static HRESULT WINAPI cookie_GetTrustLevel( IHttpCookie *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI cookie_get_Name( IHttpCookie *iface, HSTRING *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return string_to_hstring( impl_from_IHttpCookie( iface )->name, value );
+}
+static HRESULT WINAPI cookie_get_Domain( IHttpCookie *iface, HSTRING *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return string_to_hstring( impl_from_IHttpCookie( iface )->domain, value );
+}
+static HRESULT WINAPI cookie_get_Path( IHttpCookie *iface, HSTRING *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return string_to_hstring( impl_from_IHttpCookie( iface )->path, value );
+}
+static HRESULT WINAPI cookie_get_Expires( IHttpCookie *iface, IReference_DateTime **value )
+{
+    struct cookie *impl = impl_from_IHttpCookie( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if ((*value = impl->expires)) IReference_DateTime_AddRef( *value );
+    return S_OK;
+}
+static HRESULT WINAPI cookie_put_Expires( IHttpCookie *iface, IReference_DateTime *value )
+{
+    struct cookie *impl = impl_from_IHttpCookie( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (value) IReference_DateTime_AddRef( value );
+    if (impl->expires) IReference_DateTime_Release( impl->expires );
+    impl->expires = value;
+    return S_OK;
+}
+static HRESULT WINAPI cookie_get_HttpOnly( IHttpCookie *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = impl_from_IHttpCookie( iface )->http_only;
+    return S_OK;
+}
+static HRESULT WINAPI cookie_put_HttpOnly( IHttpCookie *iface, boolean value )
+{
+    TRACE( "iface %p, value %d.\n", iface, value );
+    impl_from_IHttpCookie( iface )->http_only = !!value;
+    return S_OK;
+}
+static HRESULT WINAPI cookie_get_Secure( IHttpCookie *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = impl_from_IHttpCookie( iface )->secure;
+    return S_OK;
+}
+static HRESULT WINAPI cookie_put_Secure( IHttpCookie *iface, boolean value )
+{
+    TRACE( "iface %p, value %d.\n", iface, value );
+    impl_from_IHttpCookie( iface )->secure = !!value;
+    return S_OK;
+}
+static HRESULT WINAPI cookie_get_Value( IHttpCookie *iface, HSTRING *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return string_to_hstring( impl_from_IHttpCookie( iface )->value, value );
+}
+static HRESULT WINAPI cookie_put_Value( IHttpCookie *iface, HSTRING value )
+{
+    struct cookie *impl = impl_from_IHttpCookie( iface );
+    WCHAR *copy;
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+    if (!(copy = hstring_dup( value ))) return E_OUTOFMEMORY;
+    free( impl->value );
+    impl->value = copy;
+    return S_OK;
+}
+
+static const IHttpCookieVtbl cookie_vtbl =
+{
+    cookie_QueryInterface, cookie_AddRef, cookie_Release,
+    cookie_GetIids, cookie_GetRuntimeClassName, cookie_GetTrustLevel,
+    cookie_get_Name, cookie_get_Domain, cookie_get_Path,
+    cookie_get_Expires, cookie_put_Expires,
+    cookie_get_HttpOnly, cookie_put_HttpOnly,
+    cookie_get_Secure, cookie_put_Secure,
+    cookie_get_Value, cookie_put_Value,
+};
+
+static HRESULT WINAPI cookie_str_QueryInterface( IStringable *iface, REFIID iid, void **out )
+{
+    return cookie_qi( impl_from_cookie_IStringable( iface ), iid, out );
+}
+static ULONG WINAPI cookie_str_AddRef( IStringable *iface ) { return InterlockedIncrement( &impl_from_cookie_IStringable( iface )->ref ); }
+static ULONG WINAPI cookie_str_Release( IStringable *iface ) { return cookie_release( impl_from_cookie_IStringable( iface ) ); }
+static HRESULT WINAPI cookie_str_GetIids( IStringable *iface, ULONG *count, IID **iids )
+{
+    return cookie_GetIids( &impl_from_cookie_IStringable( iface )->IHttpCookie_iface, count, iids );
+}
+static HRESULT WINAPI cookie_str_GetRuntimeClassName( IStringable *iface, HSTRING *name )
+{
+    return web_class_name( RuntimeClass_Windows_Web_Http_HttpCookie, name );
+}
+static HRESULT WINAPI cookie_str_GetTrustLevel( IStringable *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+/* "name=value", the form a client sends back in a Cookie header (the exact text Windows returns is not
+ * documented; this is a guess) */
+static HRESULT WINAPI cookie_str_ToString( IStringable *iface, HSTRING *value )
+{
+    struct cookie *impl = impl_from_cookie_IStringable( iface );
+    size_t n = wcslen( impl->name ) + 1 + wcslen( impl->value );
+    WCHAR *buf = malloc( (n + 1) * sizeof(WCHAR) );
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!buf) return E_OUTOFMEMORY;
+    swprintf( buf, n + 1, L"%ls=%ls", impl->name, impl->value );
+    hr = WindowsCreateString( buf, n, value );
+    free( buf );
+    return hr;
+}
+
+static const IStringableVtbl cookie_str_vtbl =
+{
+    cookie_str_QueryInterface, cookie_str_AddRef, cookie_str_Release,
+    cookie_str_GetIids, cookie_str_GetRuntimeClassName, cookie_str_GetTrustLevel,
+    cookie_str_ToString,
+};
+
+static struct cookie *cookie_alloc( const WCHAR *name, const WCHAR *domain, const WCHAR *path, const WCHAR *value )
+{
+    struct cookie *impl = calloc( 1, sizeof(*impl) );
+
+    if (!impl) return NULL;
+    impl->IHttpCookie_iface.lpVtbl = &cookie_vtbl;
+    impl->IStringable_iface.lpVtbl = &cookie_str_vtbl;
+    impl->ref = 1;
+    impl->name = wcsdup_n( name, wcslen( name ) );
+    impl->domain = wcsdup_n( domain, wcslen( domain ) );
+    impl->path = wcsdup_n( path, wcslen( path ) );
+    impl->value = wcsdup_n( value, wcslen( value ) );
+    if (!impl->name || !impl->domain || !impl->path || !impl->value)
+    {
+        cookie_release( impl );
+        return NULL;
+    }
+    return impl;
+}
+
+/* a cookie name is a token: no separators, controls or spaces */
+static BOOL valid_cookie_name( const WCHAR *name )
+{
+    if (!*name) return FALSE;
+    for (; *name; name++)
+    {
+        if (*name <= 0x20 || *name >= 0x7f || wcschr( L"()<>@,;:\\\"/[]?={}", *name )) return FALSE;
+    }
+    return TRUE;
+}
+
+static HRESULT cookie_create( const WCHAR *name, const WCHAR *domain, const WCHAR *path, IHttpCookie **out )
+{
+    struct cookie *impl;
+
+    if (!valid_cookie_name( name )) return E_INVALIDARG;
+    if (!(impl = cookie_alloc( name, domain, path, L"" ))) return E_OUTOFMEMORY;
+    *out = &impl->IHttpCookie_iface;
+    return S_OK;
+}
+
+/* a copy of a cookie, as the manager stores and hands out */
+static struct cookie *cookie_copy( struct cookie *src )
+{
+    struct cookie *impl = cookie_alloc( src->name, src->domain, src->path, src->value );
+
+    if (!impl) return NULL;
+    impl->http_only = src->http_only;
+    impl->secure = src->secure;
+    if ((impl->expires = src->expires)) IReference_DateTime_AddRef( impl->expires );
+    return impl;
+}
+
+static struct cookie *cookie_from_iface( IHttpCookie *iface )
+{
+    if (!iface || iface->lpVtbl != &cookie_vtbl) return NULL;
+    return impl_from_IHttpCookie( iface );
+}
+
+/* ---- HttpCookie activation factory -------------------------------------- */
+struct cookie_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IHttpCookieFactory IHttpCookieFactory_iface;
+    LONG ref;
+};
+
+static inline struct cookie_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct cookie_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI cf_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct cookie_factory *impl = impl_from_IActivationFactory( iface );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface; IInspectable_AddRef( *out ); return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IHttpCookieFactory ))
+    {
+        *out = &impl->IHttpCookieFactory_iface; IInspectable_AddRef( *out ); return S_OK;
+    }
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI cf_AddRef( IActivationFactory *iface ) { return InterlockedIncrement( &impl_from_IActivationFactory( iface )->ref ); }
+static ULONG WINAPI cf_Release( IActivationFactory *iface ) { return InterlockedDecrement( &impl_from_IActivationFactory( iface )->ref ); }
+static HRESULT WINAPI cf_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    static const IID *const ids[] = { &IID_IActivationFactory, &IID_IHttpCookieFactory };
+    return web_get_iids( ids, ARRAY_SIZE(ids), count, iids );
+}
+static HRESULT WINAPI cf_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return web_class_name( RuntimeClass_Windows_Web_Http_HttpCookie, name );
+}
+static HRESULT WINAPI cf_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+/* HttpCookie is only constructed with a name, domain and path */
+static HRESULT WINAPI cf_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    WARN( "iface %p: HttpCookie has no default activation.\n", iface );
+    *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const IActivationFactoryVtbl cf_activation_vtbl =
+{
+    cf_QueryInterface, cf_AddRef, cf_Release, cf_GetIids, cf_GetRuntimeClassName, cf_GetTrustLevel,
+    cf_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( cf_ifactory, IHttpCookieFactory, struct cookie_factory, IActivationFactory_iface )
+
+static HRESULT WINAPI cf_Create( IHttpCookieFactory *iface, HSTRING name, HSTRING domain, HSTRING path, IHttpCookie **value )
+{
+    WCHAR *n, *d, *p;
+    IHttpCookie *cookie;
+    HRESULT hr;
+
+    TRACE( "iface %p, name %s, domain %s, path %s, value %p.\n", iface, debugstr_hstring( name ),
+           debugstr_hstring( domain ), debugstr_hstring( path ), value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    n = hstring_dup( name ); d = hstring_dup( domain ); p = hstring_dup( path );
+    if (!n || !d || !p) hr = E_OUTOFMEMORY;
+    else if (SUCCEEDED( hr = cookie_create( n, d, p, &cookie ) )) *value = (IHttpCookie *)cookie;
+    free( n ); free( d ); free( p );
+    return hr;
+}
+
+static const IHttpCookieFactoryVtbl cf_factory_vtbl =
+{
+    cf_ifactory_QueryInterface, cf_ifactory_AddRef, cf_ifactory_Release,
+    cf_ifactory_GetIids, cf_ifactory_GetRuntimeClassName, cf_ifactory_GetTrustLevel,
+    cf_Create,
+};
+
+static struct cookie_factory cookie_factory_singleton =
+{
+    {&cf_activation_vtbl},
+    {&cf_factory_vtbl},
+    1,
+};
+
+IActivationFactory *http_cookie_factory = &cookie_factory_singleton.IActivationFactory_iface;
