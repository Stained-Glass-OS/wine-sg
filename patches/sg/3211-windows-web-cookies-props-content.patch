+}
+
+static HRESULT WINAPI citer_QueryInterface( IIterator_HttpCookie *iface, REFIID iid, void **out )
+{
+    struct cookie_iterator *impl = impl_from_IIterator( iface );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterator_HttpCookie ))
+    {
+        *out = &impl->IIterator_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI citer_AddRef( IIterator_HttpCookie *iface ) { return InterlockedIncrement( &impl_from_IIterator( iface )->ref ); }
+static ULONG WINAPI citer_Release( IIterator_HttpCookie *iface )
+{
+    struct cookie_iterator *impl = impl_from_IIterator( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        cview_release( impl->view );
+        free( impl );
+    }
+    return ref;
+}
+static HRESULT WINAPI citer_GetIids( IIterator_HttpCookie *iface, ULONG *count, IID **iids )
+{
+    static const IID *const ids[] = { &IID_IIterator_HttpCookie };
+    return web_get_iids( ids, ARRAY_SIZE(ids), count, iids );
+}
+static HRESULT WINAPI citer_GetRuntimeClassName( IIterator_HttpCookie *iface, HSTRING *name )
+{
+    return web_class_name( L"Windows.Foundation.Collections.IIterator`1<Windows.Web.Http.HttpCookie>", name );
+}
+static HRESULT WINAPI citer_GetTrustLevel( IIterator_HttpCookie *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI citer_get_Current( IIterator_HttpCookie *iface, IHttpCookie **value )
+{
+    struct cookie_iterator *impl = impl_from_IIterator( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = NULL;
+    if (impl->index >= impl->view->count) return E_BOUNDS;
+    IHttpCookie_AddRef( impl->view->items[impl->index] );
+    *value = (IHttpCookie *)impl->view->items[impl->index];
+    return S_OK;
+}
+static HRESULT WINAPI citer_get_HasCurrent( IIterator_HttpCookie *iface, boolean *value )
+{
+    struct cookie_iterator *impl = impl_from_IIterator( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = impl->index < impl->view->count;
+    return S_OK;
+}
+static HRESULT WINAPI citer_MoveNext( IIterator_HttpCookie *iface, boolean *value )
+{
+    struct cookie_iterator *impl = impl_from_IIterator( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (impl->index < impl->view->count) impl->index++;
+    *value = impl->index < impl->view->count;
+    return S_OK;
+}
+static HRESULT WINAPI citer_GetMany( IIterator_HttpCookie *iface, UINT32 capacity, IHttpCookie **items, UINT32 *actual )
+{
+    struct cookie_iterator *impl = impl_from_IIterator( iface );
+    UINT32 n = 0;
+    TRACE( "iface %p, capacity %u, items %p, actual %p.\n", iface, capacity, items, actual );
+    while (n < capacity && impl->index < impl->view->count)
+    {
+        IHttpCookie_AddRef( impl->view->items[impl->index] );
+        items[n++] = (IHttpCookie *)impl->view->items[impl->index++];
+    }
+    *actual = n;
+    return S_OK;
+}
