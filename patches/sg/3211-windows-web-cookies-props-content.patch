+/* ======================================================================== */
+/* IMap<HSTRING, IInspectable *>: the property bag of a request message      */
+/* ======================================================================== */
+
+struct entry
+{
+    HSTRING key;
+    IInspectable *value;   /* may be NULL */
+};
+
+/* A frozen copy of the entries: the IMapView, its iterator and the key/value pairs share this layout
+ * (all methods take the interface pointer as an opaque pointer). */
+struct snapshot
+{
+    const void *const *lpVtbl;
+    const void *const *iterable_vtbl;   /* secondary IIterable<IKeyValuePair<HSTRING, IInspectable *>> */
+    LONG ref;
+    struct entry *entries;
+    UINT32 count;
+    UINT32 index;           /* iterator position, kvp: the entry shown */
+};
+
+static const void *const view_vtbl[], *const iterable_vtbl[], *const iter_vtbl[], *const kvp_vtbl[];
+
+static inline struct snapshot *snap_from( void *iface ) { return CONTAINING_RECORD( iface, struct snapshot, lpVtbl ); }
+static inline struct snapshot *snap_from_iterable( void *iface ) { return CONTAINING_RECORD( iface, struct snapshot, iterable_vtbl ); }
+
+static const WCHAR *const map_names[] =
+{
+    L"Windows.Foundation.Collections.IMapView`2<String, Object>",
+    L"Windows.Foundation.Collections.IIterator`1<Windows.Foundation.Collections.IKeyValuePair`2<String, Object>>",
+    L"Windows.Foundation.Collections.IKeyValuePair`2<String, Object>",
+};
+
+static ULONG snap_addref( struct snapshot *impl ) { return InterlockedIncrement( &impl->ref ); }
+static ULONG snap_release( struct snapshot *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        UINT32 i;
+        for (i = 0; i < impl->count; i++)
+        {
+            WindowsDeleteString( impl->entries[i].key );
+            if (impl->entries[i].value) IInspectable_Release( impl->entries[i].value );
+        }
+        free( impl->entries );
+        free( impl );
+    }
+    return ref;
+}
+
+static struct snapshot *snapshot_create( const void *const *vtbl, const struct entry *entries, UINT32 count )
+{
+    struct snapshot *impl = calloc( 1, sizeof(*impl) );
+    UINT32 i;
+
+    if (!impl) return NULL;
+    impl->lpVtbl = vtbl;
+    impl->iterable_vtbl = iterable_vtbl;
+    impl->ref = 1;
+    if (count && !(impl->entries = calloc( count, sizeof(*impl->entries) ))) { free( impl ); return NULL; }
+    for (i = 0; i < count; i++)
+    {
+        WindowsDuplicateString( entries[i].key, &impl->entries[i].key );
+        if ((impl->entries[i].value = entries[i].value)) IInspectable_AddRef( entries[i].value );
+    }
+    impl->count = count;
+    return impl;
+}
+
+static UINT32 entries_find( const struct entry *entries, UINT32 count, HSTRING key )
+{
+    INT32 order;
+    UINT32 i;
+
+    for (i = 0; i < count; i++)
+        if (SUCCEEDED( WindowsCompareStringOrdinal( entries[i].key, key, &order ) ) && !order) return i;
+    return ~0u;
+}
