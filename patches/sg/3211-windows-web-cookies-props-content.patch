+/* ---- IVectorView<HttpCookie> ------------------------------------------- */
+struct cookie_view
+{
+    IVectorView_HttpCookie IVectorView_iface;
+    IIterable_HttpCookie IIterable_iface;
+    LONG ref;
+    IHttpCookie **items;
+    UINT32 count;
+};
+
+static inline struct cookie_view *view_from_IVectorView( IVectorView_HttpCookie *iface )
+{
+    return CONTAINING_RECORD( iface, struct cookie_view, IVectorView_iface );
+}
+static inline struct cookie_view *view_from_IIterable( IIterable_HttpCookie *iface )
+{
+    return CONTAINING_RECORD( iface, struct cookie_view, IIterable_iface );
+}
+
+static HRESULT cview_qi( struct cookie_view *impl, REFIID iid, void **out )
+{
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IVectorView_HttpCookie ))
+        *out = &impl->IVectorView_iface;
+    else if (IsEqualGUID( iid, &IID_IIterable_HttpCookie ))
+        *out = &impl->IIterable_iface;
+    if (!*out) return E_NOINTERFACE;
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG cview_release( struct cookie_view *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        UINT32 i;
+        for (i = 0; i < impl->count; i++) IHttpCookie_Release( impl->items[i] );
+        free( impl->items );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT cview_get_iids( ULONG *count, IID **iids )
+{
+    static const IID *const ids[] = { &IID_IVectorView_HttpCookie, &IID_IIterable_HttpCookie };
+    return web_get_iids( ids, ARRAY_SIZE(ids), count, iids );
+}
