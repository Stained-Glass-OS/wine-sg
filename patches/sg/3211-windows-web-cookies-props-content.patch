+/* ---- HttpCookieManager -------------------------------------------------- */
+/* The cookies of an app: one store shared by every filter of the process. */
+struct manager
+{
+    IHttpCookieManager IHttpCookieManager_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    struct cookie **cookies;
+    unsigned int count, capacity;
+};
+
+static inline struct manager *impl_from_IHttpCookieManager( IHttpCookieManager *iface )
+{
+    return CONTAINING_RECORD( iface, struct manager, IHttpCookieManager_iface );
+}
+
+static struct manager *global_manager;
+
+static HRESULT WINAPI manager_QueryInterface( IHttpCookieManager *iface, REFIID iid, void **out )
+{
+    struct manager *impl = impl_from_IHttpCookieManager( iface );
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IHttpCookieManager ))
+    {
+        *out = &impl->IHttpCookieManager_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI manager_AddRef( IHttpCookieManager *iface ) { return InterlockedIncrement( &impl_from_IHttpCookieManager( iface )->ref ); }
+/* the store lives as long as the process: this reference only guards against underflow */
+static ULONG WINAPI manager_Release( IHttpCookieManager *iface )
+{
+    struct manager *impl = impl_from_IHttpCookieManager( iface );
+    return InterlockedDecrement( &impl->ref );
+}
+static HRESULT WINAPI manager_GetIids( IHttpCookieManager *iface, ULONG *count, IID **iids )
+{
+    static const IID *const ids[] = { &IID_IHttpCookieManager };
+    return web_get_iids( ids, ARRAY_SIZE(ids), count, iids );
+}
+static HRESULT WINAPI manager_GetRuntimeClassName( IHttpCookieManager *iface, HSTRING *name )
+{
+    return web_class_name( RuntimeClass_Windows_Web_Http_HttpCookieManager, name );
+}
+static HRESULT WINAPI manager_GetTrustLevel( IHttpCookieManager *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+/* 100ns ticks since 1601, the DateTime and FILETIME epoch */
+static BOOL cookie_expired( struct cookie *cookie )
+{
+    FILETIME ft;
+    DateTime when;
+    UINT64 now;
+
+    if (!cookie->expires || FAILED( IReference_DateTime_get_Value( cookie->expires, &when ) )) return FALSE;
+    GetSystemTimeAsFileTime( &ft );
+    now = ((UINT64)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    return (UINT64)when.UniversalTime <= now;
+}
+
+static BOOL same_cookie( struct cookie *a, struct cookie *b )
+{
+    return !wcscmp( a->name, b->name ) && !wcsicmp( a->domain, b->domain ) && !wcscmp( a->path, b->path );
+}
+
+/* the domain of a cookie without the leading dot of a domain cookie */
+static const WCHAR *bare_domain( const WCHAR *domain )
+{
+    return *domain == '.' ? domain + 1 : domain;
+}
+
+static BOOL domain_matches( const WCHAR *cookie_domain, const WCHAR *host )
+{
+    const WCHAR *domain = bare_domain( cookie_domain );
+    size_t dlen = wcslen( domain ), hlen = wcslen( host );
+
+#ifdef SG_MUTANT_WEBB1_DOMAIN
+    return TRUE;
+#endif
+
+    if (!dlen) return FALSE;
+    if (hlen == dlen) return !wcsicmp( domain, host );
+    return hlen > dlen && host[hlen - dlen - 1] == '.' && !wcsicmp( host + hlen - dlen, domain );
+}
+
+static BOOL path_matches( const WCHAR *cookie_path, const WCHAR *path )
+{
+    size_t clen = wcslen( cookie_path );
+
+#ifdef SG_MUTANT_WEBB1_PATH
+    return TRUE;
+#endif
+
+    if (!clen || !wcscmp( cookie_path, L"/" )) return TRUE;
+    if (wcsncmp( path, cookie_path, clen )) return FALSE;
+    return !path[clen] || cookie_path[clen - 1] == '/' || path[clen] == '/';
+}
+
+static void manager_remove_at( struct manager *impl, unsigned int i )
+{
+    cookie_release( impl->cookies[i] );
+    memmove( &impl->cookies[i], &impl->cookies[i + 1], (impl->count - i - 1) * sizeof(*impl->cookies) );
+    impl->count--;
+}
+
+static void manager_prune( struct manager *impl )
+{
+    unsigned int i = 0;
+    while (i < impl->count)
+    {
+        if (cookie_expired( impl->cookies[i] )) manager_remove_at( impl, i );
+        else i++;
+    }
+}
+
+static HRESULT manager_store( struct manager *impl, struct cookie *src, boolean *result )
+{
+    struct cookie *copy;
+    unsigned int i;
+
+    *result = FALSE;
+    /* a cookie without a domain can never be sent anywhere */
+    if (!*bare_domain( src->domain )) return S_OK;
+
+    EnterCriticalSection( &impl->cs );
+    for (i = 0; i < impl->count; i++)
+    {
+        if (same_cookie( impl->cookies[i], src )) { manager_remove_at( impl, i ); break; }
+    }
+    if (cookie_expired( src ))
+    {
+        /* setting an expired cookie deletes it */
+        LeaveCriticalSection( &impl->cs );
+        *result = TRUE;
+        return S_OK;
+    }
+    if (impl->count == impl->capacity)
+    {
+        unsigned int cap = impl->capacity ? impl->capacity * 2 : 8;
+        struct cookie **grown = realloc( impl->cookies, cap * sizeof(*grown) );
+        if (!grown) { LeaveCriticalSection( &impl->cs ); return E_OUTOFMEMORY; }
+        impl->cookies = grown;
+        impl->capacity = cap;
+    }
+    if (!(copy = cookie_copy( src ))) { LeaveCriticalSection( &impl->cs ); return E_OUTOFMEMORY; }
+    impl->cookies[impl->count++] = copy;
+    LeaveCriticalSection( &impl->cs );
+    *result = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI manager_SetCookie( IHttpCookieManager *iface, IHttpCookie *cookie, boolean *result )
+{
+    struct cookie *src = cookie_from_iface( (IHttpCookie *)cookie );
+
+    TRACE( "iface %p, cookie %p, result %p.\n", iface, cookie, result );
+    if (!result) return E_POINTER;
+    if (!src) return E_INVALIDARG;
+    return manager_store( impl_from_IHttpCookieManager( iface ), src, result );
+}
+/* the cookie is first or third party; a third party cookie is kept like any other here */
+static HRESULT WINAPI manager_SetCookieWithThirdParty( IHttpCookieManager *iface, IHttpCookie *cookie,
+        boolean third_party, boolean *result )
+{
+    TRACE( "iface %p, cookie %p, third_party %d, result %p.\n", iface, cookie, third_party, result );
+    return manager_SetCookie( iface, cookie, result );
+}
+static HRESULT WINAPI manager_DeleteCookie( IHttpCookieManager *iface, IHttpCookie *cookie )
+{
+    struct manager *impl = impl_from_IHttpCookieManager( iface );
+    struct cookie *src = cookie_from_iface( (IHttpCookie *)cookie );
+    unsigned int i;
+
+    TRACE( "iface %p, cookie %p.\n", iface, cookie );
+    if (!src) return E_INVALIDARG;
+    EnterCriticalSection( &impl->cs );
+    for (i = 0; i < impl->count; i++)
+    {
+        if (same_cookie( impl->cookies[i], src )) { manager_remove_at( impl, i ); break; }
+    }
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+/* collect copies of the cookies a request for host/path/secure carries */
+static HRESULT manager_collect( struct manager *impl, const WCHAR *host, const WCHAR *path, BOOL secure,
+        IHttpCookie ***items, UINT32 *count )
+{
+    unsigned int i;
+    IHttpCookie **list;
+
+    *items = NULL;
+    *count = 0;
+    EnterCriticalSection( &impl->cs );
+    manager_prune( impl );
+    if (!(list = calloc( impl->count + 1, sizeof(*list) )))
+    {
+        LeaveCriticalSection( &impl->cs );
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < impl->count; i++)
+    {
+        struct cookie *c = impl->cookies[i], *copy;
+
+        if (!domain_matches( c->domain, host ) || !path_matches( c->path, path )) continue;
+        if (c->secure && !secure) continue;
+        if (!(copy = cookie_copy( c ))) continue;
+        list[(*count)++] = &copy->IHttpCookie_iface;
+    }
+    LeaveCriticalSection( &impl->cs );
+    *items = list;
+    return S_OK;
+}
+
+static HRESULT WINAPI manager_GetCookies( IHttpCookieManager *iface, IUriRuntimeClass *uri, IVectorView_HttpCookie **cookies )
+{
+    struct manager *impl = impl_from_IHttpCookieManager( iface );
+    HSTRING host = NULL, path = NULL, scheme = NULL;
+    IHttpCookie **items;
+    UINT32 count;
+    HRESULT hr;
+
+    TRACE( "iface %p, uri %p, cookies %p.\n", iface, uri, cookies );
+    if (!cookies) return E_POINTER;
+    *cookies = NULL;
+    if (!uri) return E_INVALIDARG;
+
+    if (FAILED( hr = IUriRuntimeClass_get_Host( uri, &host ) )) return hr;
+    if (SUCCEEDED( hr = IUriRuntimeClass_get_Path( uri, &path ) ) &&
+        SUCCEEDED( hr = IUriRuntimeClass_get_SchemeName( uri, &scheme ) ))
+    {
+        const WCHAR *p = WindowsGetStringRawBuffer( path, NULL );
+        if (SUCCEEDED( hr = manager_collect( impl, WindowsGetStringRawBuffer( host, NULL ), *p ? p : L"/",
+                                             !wcsicmp( WindowsGetStringRawBuffer( scheme, NULL ), L"https" ),
+                                             &items, &count ) ))
+            hr = cookie_view_create( items, count, cookies );
+    }
+    WindowsDeleteString( host );
+    WindowsDeleteString( path );
+    WindowsDeleteString( scheme );
+    return hr;
+}
+
+static const IHttpCookieManagerVtbl manager_vtbl =
+{
+    manager_QueryInterface, manager_AddRef, manager_Release,
+    manager_GetIids, manager_GetRuntimeClassName, manager_GetTrustLevel,
+    manager_SetCookie, manager_SetCookieWithThirdParty, manager_DeleteCookie, manager_GetCookies,
+};
+
+static struct manager *get_global_manager( void )
+{
+    struct manager *impl, *old;
+
+    if ((impl = global_manager)) return impl;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->IHttpCookieManager_iface.lpVtbl = &manager_vtbl;
+    impl->ref = 1;
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    if ((old = InterlockedCompareExchangePointer( (void **)&global_manager, impl, NULL )))
+    {
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+        return old;
+    }
+    return impl;
+}
+
+HRESULT http_cookie_manager_create( IHttpCookieManager **out )
+{
+    struct manager *impl = get_global_manager();
+
+    if (!impl) return E_OUTOFMEMORY;
+    InterlockedIncrement( &impl->ref );
+    *out = &impl->IHttpCookieManager_iface;
+    return S_OK;
+}
+
+/* ---- transport glue ------------------------------------------------------ */
+/* The Cookie header for a request to url: "name=value; name2=value2", or NULL for none. */
+void http_cookie_manager_request_header( IHttpCookieManager *mgr, const WCHAR *url, WCHAR **header )
+{
+    struct manager *impl = impl_from_IHttpCookieManager( mgr );
+    URL_COMPONENTS uc = { sizeof(uc) };
+    WCHAR host[256], path[2048];
+    IHttpCookie **items;
+    UINT32 count, i;
+    size_t len = 0;
+    WCHAR *out;
+
+    *header = NULL;
+    uc.lpszHostName = host; uc.dwHostNameLength = ARRAY_SIZE(host);
+    uc.lpszUrlPath = path; uc.dwUrlPathLength = ARRAY_SIZE(path);
+    if (!WinHttpCrackUrl( url, 0, 0, &uc )) return;
+    if (FAILED( manager_collect( impl, host, *path ? path : L"/", uc.nScheme == INTERNET_SCHEME_HTTPS, &items, &count ) ))
+        return;
+    for (i = 0; i < count; i++)
+    {
+        struct cookie *c = impl_from_IHttpCookie( items[i] );
+        len += wcslen( c->name ) + wcslen( c->value ) + 3;
+    }
+    if (count && (out = malloc( (len + 1) * sizeof(WCHAR) )))
+    {
+        WCHAR *p = out;
+        for (i = 0; i < count; i++)
+        {
+            struct cookie *c = impl_from_IHttpCookie( items[i] );
+            p += swprintf( p, len + 1 - (p - out), L"%ls%ls=%ls", i ? L"; " : L"", c->name, c->value );
+        }
+        *header = out;
+    }
+    for (i = 0; i < count; i++) IHttpCookie_Release( items[i] );
+    free( items );
+}
+
+static WCHAR *trim_range( WCHAR *s, WCHAR **end )
+{
+    while (*s == ' ' || *s == '\t') s++;
+    while (*end > s && ((*end)[-1] == ' ' || (*end)[-1] == '\t' || (*end)[-1] == '\r')) (*end)--;
+    return s;
+}
+
+static HRESULT date_reference( const SYSTEMTIME *st, IReference_DateTime **out )
+{
+    IPropertyValueStatics *statics;
+    IPropertyValue *unused = NULL;
+    IInspectable *value;
+    HSTRING name;
+    FILETIME ft;
+    DateTime when;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!SystemTimeToFileTime( st, &ft )) return E_INVALIDARG;
+    when.UniversalTime = ((UINT64)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    if (FAILED( hr = WindowsCreateString( RuntimeClass_Windows_Foundation_PropertyValue,
+                                          wcslen( RuntimeClass_Windows_Foundation_PropertyValue ), &name ) )) return hr;
+    hr = RoGetActivationFactory( name, &IID_IPropertyValueStatics, (void **)&statics );
+    WindowsDeleteString( name );
+    if (FAILED( hr )) return hr;
+    hr = IPropertyValueStatics_CreateDateTime( statics, when, &value );
+    IPropertyValueStatics_Release( statics );
+    if (FAILED( hr )) return hr;
+    (void)unused;
+    hr = IInspectable_QueryInterface( value, &IID_IReference_DateTime, (void **)out );
+    IInspectable_Release( value );
+    return hr;
+}
+
+/* Parse one Set-Cookie header value received from url and store the cookie. */
+static void store_set_cookie( struct manager *impl, const WCHAR *host, const WCHAR *req_path, WCHAR *line )
+{
+    WCHAR *p = line, *end, *eq, *attr;
+    WCHAR *domain = NULL, *path = NULL;
+    struct cookie *cookie;
+    BOOL secure = FALSE, http_only = FALSE, has_expiry = FALSE, delete_now = FALSE;
+    SYSTEMTIME expiry_time;
+    LONG max_age = 0;
+    boolean ignored;
+    WCHAR *name, *value, *name_end, *value_end;
+
+    /* name=value */
+    end = wcschr( p, ';' );
+    if (end) *end = 0;
+    if (!(eq = wcschr( p, '=' ))) return;
+    name_end = eq;
+    name = trim_range( p, &name_end );
+    *name_end = 0;
+    value_end = p + wcslen( p );
+    value = trim_range( eq + 1, &value_end );
+    *value_end = 0;
+    if (!valid_cookie_name( name )) return;
+
+    attr = end ? end + 1 : NULL;
+    while (attr && *attr)
+    {
+        WCHAR *next = wcschr( attr, ';' ), *aend, *aname, *aeq, *avalue, *aname_end, *avalue_end;
+        if (next) *next = 0;
+        aend = attr + wcslen( attr );
+        aname = trim_range( attr, &aend );
+        *aend = 0;
+        if ((aeq = wcschr( aname, '=' )))
+        {
+            aname_end = aeq;
+            while (aname_end > aname && (aname_end[-1] == ' ' || aname_end[-1] == '\t')) aname_end--;
+            avalue_end = aname + wcslen( aname );
+            avalue = trim_range( aeq + 1, &avalue_end );
+            *avalue_end = 0;
+            *aname_end = 0;
+            if (!wcsicmp( aname, L"Domain" ) && *avalue) { free( domain ); domain = wcsdup_n( avalue, wcslen( avalue ) ); }
+            else if (!wcsicmp( aname, L"Path" ) && *avalue == '/') { free( path ); path = wcsdup_n( avalue, wcslen( avalue ) ); }
+            else if (!wcsicmp( aname, L"Max-Age" )) { max_age = wcstol( avalue, NULL, 10 ); has_expiry = TRUE; delete_now = max_age <= 0; }
+            else if (!wcsicmp( aname, L"Expires" ) && !has_expiry)
+            {
+                has_expiry = WinHttpTimeToSystemTime( avalue, &expiry_time );
+                if (!has_expiry) WARN( "unparsable Expires %s\n", debugstr_w( avalue ) );
+            }
+        }
+        else if (!wcsicmp( aname, L"Secure" )) secure = TRUE;
+        else if (!wcsicmp( aname, L"HttpOnly" )) http_only = TRUE;
+        attr = next ? next + 1 : NULL;
+    }
+
+    /* the cookie's domain must cover the host that set it; without Domain it is the host itself */
+    if (domain && !domain_matches( domain, host )) { free( domain ); free( path ); return; }
+    if (!domain) domain = wcsdup_n( host, wcslen( host ) );
+    if (!path)
+    {
+        /* default path: the directory of the request path */
+        size_t n = 0;
+        const WCHAR *slash = wcsrchr( req_path, '/' );
+        if (slash && slash != req_path) n = slash - req_path;
+        path = n ? wcsdup_n( req_path, n ) : wcsdup_n( L"/", 1 );
+    }
+
+    if ((cookie = cookie_alloc( name, domain, path, value )))
+    {
+        cookie->secure = secure;
+        cookie->http_only = http_only;
+        if (has_expiry)
+        {
+            if (max_age || delete_now)
+            {
+                FILETIME ft;
+                ULARGE_INTEGER u;
+                GetSystemTimeAsFileTime( &ft );
+                u.LowPart = ft.dwLowDateTime; u.HighPart = ft.dwHighDateTime;
+                u.QuadPart += (ULONGLONG)(LONGLONG)max_age * 10000000;
+                ft.dwLowDateTime = u.LowPart; ft.dwHighDateTime = u.HighPart;
+                FileTimeToSystemTime( &ft, &expiry_time );
+            }
+            date_reference( &expiry_time, &cookie->expires );
+        }
+        manager_store( impl, cookie, &ignored );
+        cookie_release( cookie );
+    }
+    free( domain );
+    free( path );
+}
+
+/* Store the cookies set by a response (raw CRLF separated header lines) to url. */
+void http_cookie_manager_store_response( IHttpCookieManager *mgr, const WCHAR *url, const WCHAR *raw_headers )
+{
+    struct manager *impl = impl_from_IHttpCookieManager( mgr );
+    URL_COMPONENTS uc = { sizeof(uc) };
+    WCHAR host[256], path[2048], *copy, *line, *next;
+
+    if (!raw_headers) return;
+#ifdef SG_MUTANT_WEBB1_SETCOOKIE
+    return;
+#endif
+    uc.lpszHostName = host; uc.dwHostNameLength = ARRAY_SIZE(host);
+    uc.lpszUrlPath = path; uc.dwUrlPathLength = ARRAY_SIZE(path);
+    if (!WinHttpCrackUrl( url, 0, 0, &uc )) return;
+    if (!(copy = wcsdup_n( raw_headers, wcslen( raw_headers ) ))) return;
+    for (line = copy; line && *line; line = next)
+    {
+        if ((next = wcsstr( line, L"\r\n" ))) { *next = 0; next += 2; }
+        else next = NULL;
+        if (!wcsnicmp( line, L"Set-Cookie:", 11 ))
+        {
+            WCHAR *value = line + 11;
+            while (*value == ' ' || *value == '\t') value++;
+            store_set_cookie( impl, host, *path ? path : L"/", value );
+        }
+    }
+    free( copy );
+}
