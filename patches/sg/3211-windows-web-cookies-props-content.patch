+        (is_iter && IsEqualGUID( iid, &IID_IIterator_IKeyValuePair_HSTRING_IInspectable )) ||
+        (!is_view && !is_iter && IsEqualGUID( iid, &IID_IKeyValuePair_HSTRING_IInspectable )))
