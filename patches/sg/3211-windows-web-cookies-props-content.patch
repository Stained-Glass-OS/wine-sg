+/* The WinHTTP security flags that make the transport ignore the listed certificate errors. */
+UINT32 http_cert_errors_security_flags( IVector_ChainValidationResult *errors )
+{
+    struct enum_vec *impl;
+    UINT32 i, flags = 0;
+
+    if (!errors || errors->lpVtbl != &enum_vector_vtbl) return 0;
+    impl = vec_from_IVector( errors );
+    for (i = 0; i < impl->count; i++)
+    {
+        switch (impl->items[i])
+        {
+        case ChainValidationResult_Untrusted:
+        case ChainValidationResult_IncompleteChain:
+            flags |= SECURITY_FLAG_IGNORE_UNKNOWN_CA;
+            break;
+        case ChainValidationResult_Expired:
+            flags |= SECURITY_FLAG_IGNORE_CERT_DATE_INVALID;
+            break;
+        case ChainValidationResult_InvalidName:
+            flags |= SECURITY_FLAG_IGNORE_CERT_CN_INVALID;
+            break;
+        case ChainValidationResult_WrongUsage:
+            flags |= SECURITY_FLAG_IGNORE_CERT_WRONG_USAGE;
+            break;
+        case ChainValidationResult_RevocationInformationMissing:
+        case ChainValidationResult_RevocationFailure:
+            flags |= 0x80;   /* SECURITY_FLAG_IGNORE_REVOCATION */
+            break;
+        default:
+            break;
+        }
+    }
+    return flags;
+}
