+                    if (SUCCEEDED( hr )) hr = error;
+                    IInspectable_Release( op );
+                }
+                IOutputStream_Release( output );
+            }
+            IBuffer_Release( buffer );
+        }
+    }
+    if (SUCCEEDED( hr )) hr = IRandomAccessStream_GetInputStreamAt( stream, 0, out );
+    IRandomAccessStream_Release( stream );
+    return hr;
+}
