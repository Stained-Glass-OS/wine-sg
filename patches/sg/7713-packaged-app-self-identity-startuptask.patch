+static HRESULT op_create( enum op_kind kind, HRESULT status, IUnknown *result, StartupTaskState state, void **out )
+{
+    struct async_op *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    if (kind == OP_TASK) impl->op.task.lpVtbl = &op_task_vtbl;
+    else if (kind == OP_TASKS) impl->op.tasks.lpVtbl = &op_tasks_vtbl;
+    else impl->op.state.lpVtbl = &op_state_vtbl;
+    impl->kind = kind;
+    impl->ref = 1;
+    impl->status = status;
+    if ((impl->result = result)) IUnknown_AddRef( result );
+    impl->state = state;
+    *out = &impl->op;
+    return S_OK;
