+    if (FAILED(hr = WindowsCreateString( class_name, wcslen( class_name ), &class_str ))) return hr;
+    hr = RoActivateInstance( class_str, &inspectable );
+    WindowsDeleteString( class_str );
+    if (FAILED(hr)) return hr;
+    hr = IInspectable_QueryInterface( inspectable, &IID___x_ABI_CWindows_CManagement_CDeployment_CIPackageManager, (void **)&manager );
