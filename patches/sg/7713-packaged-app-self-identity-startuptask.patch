--- a/dlls/kernelbase/version.c
+++ b/dlls/kernelbase/version.c
@@ -1918,13 +1918,49 @@
 }
 
 
+/* Stained Glass OS: a process's package -- ours, or the one whose folder holds its program (another
+ * process's program in an external location is not looked into). DuckDuckGo asks for its own with
+ * GetPackageFamilyName( GetCurrentProcess() ) and, told it had none, stopped at its start. */
+static LONG process_package( HANDLE process, WCHAR *full_name, DWORD size )
+{
+    WCHAR image[MAX_PATH], name[256], path[MAX_PATH];
+    UNICODE_STRING str;
+    DWORD len = ARRAY_SIZE(image), index = 0;
+    const WCHAR *own;
+
+#ifdef SG_MUTANT_NO_PROCESS_PACKAGE
+    return APPMODEL_ERROR_NO_PACKAGE;
+#endif
+    if (process == GetCurrentProcess() || GetProcessId( process ) == GetCurrentProcessId())
+    {
+        if (!(own = current_package())) return APPMODEL_ERROR_NO_PACKAGE;
+        lstrcpynW( full_name, own, size );
+        return ERROR_SUCCESS;
+    }
+    if (!QueryFullProcessImageNameW( process, 0, image, &len )) return GetLastError();
+    RtlInitUnicodeString( &str, image );
+    while (enum_deployed_package( index++, name, ARRAY_SIZE(name) ))
+    {
+        if (!package_location( name, path, ARRAY_SIZE(path) )) continue;
+        if (!image_in_folder( &str, path )) continue;
+        lstrcpynW( full_name, name, size );
+        return ERROR_SUCCESS;
+    }
+    return APPMODEL_ERROR_NO_PACKAGE;
+}
+
 /***********************************************************************
  *         GetPackageFullName   (kernelbase.@)
  */
 LONG WINAPI /* DECLSPEC_HOTPATCH */ GetPackageFullName( HANDLE process, UINT32 *length, WCHAR *name )
 {
-    FIXME( "(%p %p %p): stub\n", process, length, name );
-    return APPMODEL_ERROR_NO_PACKAGE;
+    WCHAR full_name[256];
+    LONG ret;
+
+    TRACE( "(%p %p %p)\n", process, length, name );
+    if (!length) return ERROR_INVALID_PARAMETER;
+    if ((ret = process_package( process, full_name, ARRAY_SIZE(full_name) ))) return ret;
+    return copy_package_string( full_name, length, name );
 }
 
 
@@ -1933,8 +1969,13 @@
  */
 LONG WINAPI /* DECLSPEC_HOTPATCH */ GetPackageFamilyName( HANDLE process, UINT32 *length, WCHAR *name )
 {
-    FIXME( "(%p %p %p): stub\n", process, length, name );
-    return APPMODEL_ERROR_NO_PACKAGE;
+    WCHAR full_name[256];
+    LONG ret;
+
+    TRACE( "(%p %p %p)\n", process, length, name );
+    if (!length) return ERROR_INVALID_PARAMETER;
+    if ((ret = process_package( process, full_name, ARRAY_SIZE(full_name) ))) return ret;
+    return PackageFamilyNameFromFullName( full_name, length, name );
 }
 
