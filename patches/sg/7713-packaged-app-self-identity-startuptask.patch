+
+/*
+ * Stained Glass OS 7713: a packaged desktop application's startup tasks -- the windows.startupTask
+ * extensions of its manifest (TaskId, the program, Enabled). Installing the package registers a
+ * task the manifest enables as the Run value "<family>!<TaskId>" (appxdeploymentclient, 7700);
+ * the shell runs it at sign-in unless the person turned it off in Task Manager's Startup tab
+ * (StartupApproved\Run). So a task is Enabled when its Run value is there, DisabledByUser when it is
+ * turned off there, Disabled otherwise. RequestEnableAsync writes the Run value (not for a task the
+ * person turned off: that stays theirs), Disable removes it. DuckDuckGo, Symphony and others ask for
+ * their tasks at start; without the class, DuckDuckGo stopped there (Environment.FailFast).
+ * The operations are complete when returned.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "winreg.h"
+#include "appmodel.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(model);
+
+LONG WINAPI GetCurrentPackagePath( UINT32 *length, WCHAR *path );
+
+#define RUN_KEY      L"Software\\Microsoft\\Windows\\CurrentVersion\\Run"
+#define APPROVED_KEY L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run"
+
+struct task_info
+{
+    WCHAR *id;
+    WCHAR *exe;          /* the program, a full path */
+};
+
+/* ---- the manifest's tasks ---- */
+
+static WCHAR *attribute( const WCHAR *tag, const WCHAR *end, const WCHAR *name )
+{
+    size_t len = wcslen( name );
+    const WCHAR *p = tag, *v, *q;
+    WCHAR *ret;
+
+    while ((p = wcsstr( p, name )) && p < end)
+    {
+        BOOL start = p == tag || p[-1] == ' ' || p[-1] == '\t' || p[-1] == '\r' || p[-1] == '\n';
+        v = p + len;
+        while (*v == ' ') v++;
+        if (start && *v == '=')
+        {
+            v++;
+            while (*v == ' ') v++;
+            if (*v != '"' && *v != '\'') return NULL;
+            if (!(q = wcschr( v + 1, *v )) || q > end) return NULL;
+            if (!(ret = malloc( (q - v) * sizeof(WCHAR) ))) return NULL;
+            memcpy( ret, v + 1, (q - v - 1) * sizeof(WCHAR) );
+            ret[q - v - 1] = 0;
+            return ret;
+        }
+        p += len;
+    }
+    return NULL;
+}
+
+/* the element's local name (without its namespace prefix) is NAME */
+static BOOL is_element( const WCHAR *tag, const WCHAR *name )
+{
+    const WCHAR *p = tag, *colon = NULL;
+    size_t len;
+
+    while (*p && *p != ' ' && *p != '>' && *p != '/' && *p != '\t' && *p != '\r' && *p != '\n')
+    {
+        if (*p == ':') colon = p;
+        p++;
+    }
+    if (colon) tag = colon + 1;
+    len = p - tag;
+    return len == wcslen( name ) && !wcsncmp( tag, name, len );
+}
+
+static void free_tasks( struct task_info *tasks, UINT32 count )
+{
+    UINT32 i;
+    for (i = 0; i < count; i++)
+    {
+        free( tasks[i].id );
+        free( tasks[i].exe );
+    }
+    free( tasks );
+}
+
+static WCHAR *full_path( const WCHAR *root, const WCHAR *exe )
+{
+    WCHAR *ret, *p;
+    size_t len;
+
+    if (!exe) return NULL;
+    len = wcslen( root ) + wcslen( exe ) + 2;
+    if (!(ret = malloc( len * sizeof(WCHAR) ))) return NULL;
+    swprintf( ret, len, L"%s\\%s", root, exe );
+    for (p = ret; *p; p++) if (*p == '/') *p = '\\';
+    return ret;
+}
+
+static HRESULT read_tasks( struct task_info **out, UINT32 *count )
+{
+    WCHAR root[MAX_PATH], path[MAX_PATH + 32], *text = NULL, *p, *end;
+    WCHAR *app_exe = NULL, *ext_exe = NULL;
+    struct task_info *tasks = NULL, *grown;
+    UINT32 len = ARRAY_SIZE(root), n = 0;
+    BOOL in_task_ext = FALSE;
+    HANDLE file;
+    DWORD size, read;
+    char *data;
+    LONG err;
+    int chars;
+
+    *out = NULL;
+    *count = 0;
+    if ((err = GetCurrentPackagePath( &len, root ))) return HRESULT_FROM_WIN32( err );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\AppxManifest.xml", root );
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+    size = GetFileSize( file, NULL );
+    if (size == INVALID_FILE_SIZE || !(data = malloc( size + 1 )))
+    {
+        CloseHandle( file );
+        return E_OUTOFMEMORY;
+    }
+    if (!ReadFile( file, data, size, &read, NULL )) read = 0;
+    CloseHandle( file );
+    chars = MultiByteToWideChar( CP_UTF8, 0, data, read, NULL, 0 );
+    if (chars > 0 && (text = malloc( (chars + 1) * sizeof(WCHAR) )))
+    {
+        MultiByteToWideChar( CP_UTF8, 0, data, read, text, chars );
+        text[chars] = 0;
+    }
+    free( data );
+    if (!text) return E_FAIL;
+
+    for (p = text; (p = wcschr( p, '<' )); p = end)
+    {
+        BOOL closing = p[1] == '/';
+        const WCHAR *tag = p + (closing ? 2 : 1);
+
+        if (!(end = wcschr( p, '>' ))) break;
+        if (*tag == '?' || *tag == '!') continue;
+        if (is_element( tag, L"Application" ))
+        {
+            if (!closing)
+            {
+                free( app_exe );
+                app_exe = attribute( tag, end, L"Executable" );
+            }
+        }
+        else if (is_element( tag, L"Extension" ))
+        {
+            WCHAR *category;
+
+            if (closing) { in_task_ext = FALSE; continue; }
+            category = attribute( tag, end, L"Category" );
+            in_task_ext = category && !wcscmp( category, L"windows.startupTask" );
+            free( category );
+            free( ext_exe );
+            ext_exe = in_task_ext ? attribute( tag, end, L"Executable" ) : NULL;
+        }
+        else if (!closing && in_task_ext && is_element( tag, L"StartupTask" ))
+        {
+            WCHAR *id = attribute( tag, end, L"TaskId" );
+
+            if (!id) continue;
+            if (!(grown = realloc( tasks, (n + 1) * sizeof(*tasks) )))
+            {
+                free( id );
+                break;
+            }
+            tasks = grown;
+            tasks[n].id = id;
+            tasks[n].exe = full_path( root, ext_exe ? ext_exe : app_exe );
+            n++;
+        }
+    }
+    free( app_exe );
+    free( ext_exe );
+    free( text );
+    *out = tasks;
+    *count = n;
+    return S_OK;
+}
+
+/* ---- the task's state ---- */
+
+static void run_name( const WCHAR *id, WCHAR *name, size_t size )
+{
+    WCHAR family[256];
+    UINT32 len = ARRAY_SIZE(family);
+
+    if (GetCurrentPackageFamilyName( &len, family )) family[0] = 0;
+    swprintf( name, size, L"%s!%s", family, id );
+}
+
+static BOOL has_value( HKEY root, const WCHAR *path, const WCHAR *name, REGSAM view )
+{
+    HKEY key;
+    BOOL ret;
+
+    if (RegOpenKeyExW( root, path, 0, KEY_QUERY_VALUE | view, &key )) return FALSE;
+    ret = !RegQueryValueExW( key, name, NULL, NULL, NULL, NULL );
+    RegCloseKey( key );
+    return ret;
+}
+
+/* turned off in Task Manager: StartupApproved\Run NAME, first byte odd */
+static BOOL turned_off( HKEY root, const WCHAR *name )
+{
+    BYTE data[12];
+    DWORD size = sizeof(data), type;
+    HKEY key;
+    BOOL off = FALSE;
+
+    if (RegOpenKeyExW( root, APPROVED_KEY, 0, KEY_QUERY_VALUE, &key )) return FALSE;
+    if (!RegQueryValueExW( key, name, NULL, &type, data, &size ) && type == REG_BINARY && size >= 1) off = data[0] & 1;
+    RegCloseKey( key );
+    return off;
+}
+
+static StartupTaskState task_state( const WCHAR *id )
+{
+    WCHAR name[400];
+    BOOL user, machine;
+
+    run_name( id, name, ARRAY_SIZE(name) );
+    user = has_value( HKEY_CURRENT_USER, RUN_KEY, name, 0 );
+    machine = has_value( HKEY_LOCAL_MACHINE, RUN_KEY, name, KEY_WOW64_64KEY );
+    if (!user && !machine) return StartupTaskState_Disabled;
+    if ((user && turned_off( HKEY_CURRENT_USER, name )) || (machine && turned_off( HKEY_LOCAL_MACHINE, name )))
+        return StartupTaskState_DisabledByUser;
+    return StartupTaskState_Enabled;
+}
+
+/* ---- the operations: complete when made ---- */
+
+enum op_kind { OP_TASK, OP_TASKS, OP_STATE };
+
+struct async_op
+{
+    IAsyncInfo IAsyncInfo_iface;
+    union
+    {
+        IAsyncOperation_StartupTask task;
+        IAsyncOperation_IVectorView_StartupTask tasks;
+        IAsyncOperation_StartupTaskState state;
+    } op;
+    enum op_kind kind;
+    LONG ref;
+    HRESULT status;
+    IUnknown *result;            /* OP_TASK, OP_TASKS */
+    StartupTaskState state;      /* OP_STATE */
+    IUnknown *handler;
+    BOOL handler_set;
+};
+
+static const IID *op_iid( enum op_kind kind )
+{
+    if (kind == OP_TASK) return &IID_IAsyncOperation_StartupTask;
+    if (kind == OP_TASKS) return &IID_IAsyncOperation_IVectorView_StartupTask;
+    return &IID_IAsyncOperation_StartupTaskState;
+}
+
+static inline struct async_op *op_from_info( IAsyncInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct async_op, IAsyncInfo_iface );
+}
+
+static inline struct async_op *op_from_op( void *iface )
+{
+    return CONTAINING_RECORD( (IAsyncOperation_StartupTask *)iface, struct async_op, op.task );
+}
+
+static HRESULT op_query( struct async_op *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, op_iid( impl->kind ) ))
+        *out = &impl->op;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &impl->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG op_release( struct async_op *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->result) IUnknown_Release( impl->result );
+        if (impl->handler) IUnknown_Release( impl->handler );
+        free( impl );
+    }
+    return ref;
+}
+
+/* IAsyncInfo */
+static HRESULT WINAPI info_QueryInterface( IAsyncInfo *iface, REFIID iid, void **out )
+{
+    return op_query( op_from_info( iface ), iid, out );
+}
+static ULONG WINAPI info_AddRef( IAsyncInfo *iface ) { return InterlockedIncrement( &op_from_info( iface )->ref ); }
+static ULONG WINAPI info_Release( IAsyncInfo *iface ) { return op_release( op_from_info( iface ) ); }
+static HRESULT WINAPI info_GetIids( IAsyncInfo *iface, ULONG *count, IID **iids )
+{
+    struct async_op *impl = op_from_info( iface );
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( 2 * sizeof(IID) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = *op_iid( impl->kind );
+    (*iids)[1] = IID_IAsyncInfo;
+    *count = 2;
+    return S_OK;
+}
+static HRESULT WINAPI info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *name )
+{
+    return inspectable_name( L"Windows.Foundation.IAsyncOperation`1", name );
+}
+static HRESULT WINAPI info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    *id = 1;
+    return S_OK;
+}
+static HRESULT WINAPI info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    *status = SUCCEEDED(op_from_info( iface )->status) ? Completed : Error;
+    return S_OK;
+}
+static HRESULT WINAPI info_get_ErrorCode( IAsyncInfo *iface, HRESULT *code )
+{
+    *code = op_from_info( iface )->status;
+    return S_OK;
+}
+static HRESULT WINAPI info_Cancel( IAsyncInfo *iface ) { return S_OK; }
+static HRESULT WINAPI info_Close( IAsyncInfo *iface ) { return S_OK; }
+
+static const struct IAsyncInfoVtbl info_vtbl =
+{
+    info_QueryInterface, info_AddRef, info_Release,
+    info_GetIids, info_GetRuntimeClassName, info_GetTrustLevel,
+    info_get_Id, info_get_Status, info_get_ErrorCode, info_Cancel, info_Close,
+};
+
+/* the three operation interfaces: the same shape, their own types */
+static HRESULT op_put_completed( struct async_op *impl, IUnknown *handler, void *op )
+{
+    AsyncStatus status = SUCCEEDED(impl->status) ? Completed : Error;
+
+    if (impl->handler_set) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    impl->handler_set = TRUE;
+    if (!handler) return S_OK;
+    impl->handler = handler;
+    IUnknown_AddRef( handler );
+    /* complete already: the handler runs now */
+    if (impl->kind == OP_TASK)
+        IAsyncOperationCompletedHandler_StartupTask_Invoke( (IAsyncOperationCompletedHandler_StartupTask *)handler, op, status );
+    else if (impl->kind == OP_TASKS)
+        IAsyncOperationCompletedHandler_IVectorView_StartupTask_Invoke( (IAsyncOperationCompletedHandler_IVectorView_StartupTask *)handler, op, status );
+    else
+        IAsyncOperationCompletedHandler_StartupTaskState_Invoke( (IAsyncOperationCompletedHandler_StartupTaskState *)handler, op, status );
+    return S_OK;
+}
+
+#define DEFINE_OP( pfx, op_type, handler_type, result_type, get_result )                                       \
+    static HRESULT WINAPI pfx##_QueryInterface( op_type *iface, REFIID iid, void **out )                      \
+    { return op_query( op_from_op( iface ), iid, out ); }                                                     \
+    static ULONG WINAPI pfx##_AddRef( op_type *iface ) { return InterlockedIncrement( &op_from_op( iface )->ref ); } \
+    static ULONG WINAPI pfx##_Release( op_type *iface ) { return op_release( op_from_op( iface ) ); }        \
+    static HRESULT WINAPI pfx##_GetIids( op_type *iface, ULONG *count, IID **iids )                          \
+    { return info_GetIids( &op_from_op( iface )->IAsyncInfo_iface, count, iids ); }                          \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( op_type *iface, HSTRING *name )                        \
+    { return info_GetRuntimeClassName( NULL, name ); }                                                        \
+    static HRESULT WINAPI pfx##_GetTrustLevel( op_type *iface, TrustLevel *level )                           \
+    { *level = BaseTrust; return S_OK; }                                                                      \
+    static HRESULT WINAPI pfx##_put_Completed( op_type *iface, handler_type *handler )                        \
