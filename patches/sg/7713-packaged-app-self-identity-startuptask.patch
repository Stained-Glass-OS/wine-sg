+static HRESULT deployment_package( IPackage **value )
+{
+    static const WCHAR class_name[] = L"Windows.Management.Deployment.PackageManager";
+    __x_ABI_CWindows_CManagement_CDeployment_CIPackageManager *manager;
+    IInspectable *inspectable;
