+    TRACE( "task %s\n", debugstr_w( impl->id ) );
+    run_name( impl->id, name, ARRAY_SIZE(name) );
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, RUN_KEY, 0, KEY_SET_VALUE, &key ))
