+static HRESULT WINAPI statics_GetForCurrentPackageAsync( IStartupTaskStatics *iface,
+                                                         IAsyncOperation_IVectorView_StartupTask **operation )
+{
+    struct task_info *tasks;
+    struct task_list *list;
+    UINT32 count, i;
+    HRESULT hr;
+
+    TRACE( "operation %p\n", operation );
+    if (!operation) return E_POINTER;
+#ifdef SG_MUTANT_STARTUP_NO_TASKS
+    return E_NOTIMPL;
+#endif
+    /* a process without package identity: as on Windows, the operation fails */
+    if (FAILED(hr = read_tasks( &tasks, &count )))
+        return op_create( OP_TASKS, hr, NULL, 0, (void **)operation );
+    if (!(list = calloc( 1, sizeof(*list) )) || (count && !(list->items = calloc( count, sizeof(*list->items) ))))
+    {
+        free( list );
+        free_tasks( tasks, count );
+        return E_OUTOFMEMORY;
+    }
+    list->IVectorView_StartupTask_iface.lpVtbl = &list_vtbl;
+    list->IIterable_StartupTask_iface.lpVtbl = &iterable_vtbl;
+    list->ref = 1;
+    for (i = 0; i < count; i++)
+        if (SUCCEEDED(task_create( &tasks[i], &list->items[list->count] ))) list->count++;
+    free_tasks( tasks, count );
+    hr = op_create( OP_TASKS, S_OK, (IUnknown *)&list->IVectorView_StartupTask_iface, 0, (void **)operation );
+    IVectorView_StartupTask_Release( &list->IVectorView_StartupTask_iface );
+    return hr;
+}
+
+static HRESULT WINAPI statics_GetAsync( IStartupTaskStatics *iface, HSTRING task_id, IAsyncOperation_StartupTask **operation )
+{
+    const WCHAR *id = WindowsGetStringRawBuffer( task_id, NULL );
+    struct task_info *tasks;
+    IStartupTask *task = NULL;
+    UINT32 count, i;
+    HRESULT hr;
+
+    TRACE( "task %s, operation %p\n", debugstr_w( id ), operation );
+    if (!operation) return E_POINTER;
+#ifdef SG_MUTANT_STARTUP_NO_TASKS
+    return E_NOTIMPL;
+#endif
+    if (FAILED(hr = read_tasks( &tasks, &count )))
+        return op_create( OP_TASK, hr, NULL, 0, (void **)operation );
+    for (i = 0; i < count; i++)
+        if (!wcscmp( tasks[i].id, id ))
+        {
+            task_create( &tasks[i], &task );
+            break;
+        }
+    free_tasks( tasks, count );
+    /* a task the manifest does not declare: the operation fails, as on Windows */
+    hr = op_create( OP_TASK, task ? S_OK : HRESULT_FROM_WIN32( ERROR_NOT_FOUND ), (IUnknown *)task, 0, (void **)operation );
+    if (task) IStartupTask_Release( task );
+    return hr;
+}
