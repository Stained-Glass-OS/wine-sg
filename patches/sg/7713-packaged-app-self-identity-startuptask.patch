+static HRESULT WINAPI task_RequestEnableAsync( IStartupTask *iface, IAsyncOperation_StartupTaskState **operation )
+{
+    struct startup_task *impl = impl_from_IStartupTask( iface );
+    StartupTaskState state = task_state( impl->id );
+    WCHAR name[400], command[MAX_PATH + 4];
+    HKEY key;
+
+    TRACE( "task %s, state %d\n", debugstr_w( impl->id ), state );
+    if (!operation) return E_POINTER;
+#ifndef SG_MUTANT_STARTUP_ENABLE_NOOP
+    /* the person's choice in Task Manager stays theirs */
+    if (state == StartupTaskState_Disabled && impl->exe)
+    {
+        run_name( impl->id, name, ARRAY_SIZE(name) );
+        swprintf( command, ARRAY_SIZE(command), L"\"%s\"", impl->exe );
+        if (!RegCreateKeyExW( HKEY_CURRENT_USER, RUN_KEY, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL ))
+        {
+            RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)command, (wcslen( command ) + 1) * sizeof(WCHAR) );
+            RegCloseKey( key );
+        }
+        state = task_state( impl->id );
+    }
+#endif
+    return op_create( OP_STATE, S_OK, NULL, state, (void **)operation );
