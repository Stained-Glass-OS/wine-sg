+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+
+#include "objbase.h"
+#include "rpc.h"
+#include "rpcproxy.h"
+
+#include "wine/exception.h"
+#include "wine/debug.h"
+
+#include "ndr_misc.h"
+#include "ndr_stubless.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(rpc);
+
+#define NDR_TABLE_MASK 127
+
+/* what the application sees of a pipe: the struct MIDL (and widl) declares for a pipe type */
+struct ndr_pipe_struct
+{
+    void (WINAPI *Pull)(char *state, void *buf, ULONG esize, ULONG *ecount);
+    void (WINAPI *Push)(char *state, void *buf, ULONG ecount);
+    void (WINAPI *Alloc)(char *state, ULONG bsize, void **buf, ULONG *bcount);
+    char *state;
+};
+
+struct ndr_pipes;
+
+struct ndr_pipe
+{
+    struct ndr_pipes *pipes;
+    const NDR_PARAM_OIF *param;
+    const unsigned char *elem_format;   /* the type of an element */
+    ULONG mem_size;                     /* of an element */
+    BOOL is_in, is_out;
+    struct ndr_pipe_struct *app;        /* the struct on the stack (or the pointer to it) */
+    struct ndr_pipe_struct own;         /* server: what the stack gets */
+    /* server, [in]: the chunk being read */
+    ULONG left;
+    BOOL in_end;
+    /* server, [out]: the terminating chunk was written */
+    BOOL out_end;
+};
+
+struct ndr_pipes
+{
+    MIDL_STUB_MESSAGE *msg;
+    BOOL server;
+    unsigned int count;
+    struct ndr_pipe *pipe;
+    /* where the elements of the [in] pipes are read from: the request of a server, the response
+     * of a client */
+    unsigned char *rbuf, *rend, *rcur;
+    /* where the chunks are written: the request of a client, the response of a server */
+    unsigned char *wbuf;
+    ULONG wlen, wcap;
+    BOOL wown;                          /* wbuf is ours (server) */
+};
+
+static inline void align_pointer_clear( unsigned char **ptr, unsigned int align )
+{
+    ULONG_PTR mask = align - 1;
+    unsigned char *aligned = (unsigned char *)(((ULONG_PTR)*ptr + mask) & ~mask);
+
+    memset( *ptr, 0, aligned - *ptr );
+    *ptr = aligned;
+}
+
+static inline void align_length( ULONG *len, unsigned int align )
+{
+    *len = (*len + align - 1) & ~(align - 1);
+}
+
+static struct ndr_pipe_struct *param_pipe_struct( unsigned char *stack, const NDR_PARAM_OIF *param )
+{
+#ifdef _WIN64
+    /* a structure this large is passed by reference */
+    return *(struct ndr_pipe_struct **)(stack + param->stack_offset);
+#else
+    return (struct ndr_pipe_struct *)(stack + param->stack_offset);
+#endif
+}
+
+struct ndr_pipes *ndr_pipes_create( MIDL_STUB_MESSAGE *msg, PFORMAT_STRING params, unsigned int count,
+                                    BOOL server )
+{
+    const NDR_PARAM_OIF *param = (const NDR_PARAM_OIF *)params;
+    struct ndr_pipes *pipes;
+    unsigned int i, n = 0;
+
+    for (i = 0; i < count; i++) if (param[i].attr.IsPipe) n++;
+    if (!n) return NULL;
+
+    pipes = calloc( 1, sizeof(*pipes) );
+    if (pipes) pipes->pipe = calloc( n, sizeof(*pipes->pipe) );
+    if (!pipes || !pipes->pipe)
+    {
+        free( pipes );
+        RpcRaiseException( RPC_X_NO_MEMORY );
+    }
+    pipes->msg = msg;
+    pipes->server = server;
+
+    for (i = 0; i < count; i++)
+    {
+        struct ndr_pipe *pipe;
+        const unsigned char *format;
+
+        if (!param[i].attr.IsPipe) continue;
+        pipe = &pipes->pipe[pipes->count++];
+        pipe->pipes = pipes;
+        pipe->param = &param[i];
+        pipe->is_in = param[i].attr.IsIn;
+        pipe->is_out = param[i].attr.IsOut;
+        format = &msg->StubDesc->pFormatTypes[param[i].u.type_offset];
+        if (*format != FC_PIPE)
+        {
+            ERR( "pipe parameter %u has format 0x%02x\n", i, *format );
+            ndr_pipes_free( pipes );
+            RpcRaiseException( RPC_X_BAD_STUB_DATA );
+        }
+        pipe->elem_format = format + 2 + *(const SHORT *)(format + 2);
+        pipe->mem_size = *(const USHORT *)(format + 4);
+        if (!pipe->mem_size)
+        {
+            ndr_pipes_free( pipes );
+            RpcRaiseException( RPC_X_BAD_STUB_DATA );
+        }
+    }
+    return pipes;
+}
+
+void ndr_pipes_free( struct ndr_pipes *pipes )
+{
+    if (!pipes) return;
+    if (pipes->wown) free( pipes->wbuf );
+    free( pipes->pipe );
+    free( pipes );
+}
+
+static void *grow( void *buf, ULONG *cap, ULONG needed )
+{
+    ULONG new_cap = *cap;
+    void *ret;
+
+    if (needed <= *cap && buf) return buf;
+    if (new_cap < 4096) new_cap = 4096;
+    while (new_cap < needed)
+    {
+        if (new_cap > 0x7fffffff / 2) { new_cap = needed; break; }
+        new_cap *= 2;
+    }
+    if (!(ret = realloc( buf, new_cap ))) RpcRaiseException( RPC_X_NO_MEMORY );
+    *cap = new_cap;
+    return ret;
+}
+
+/* a message to marshal or unmarshal with the stream positioned in, a copy so that the stub's own
+ * state is left alone */
+static void init_msg( struct ndr_pipes *pipes, MIDL_STUB_MESSAGE *msg, RPC_MESSAGE *rpc_msg )
+{
+    *msg = *pipes->msg;
+    *rpc_msg = *pipes->msg->RpcMsg;
+    msg->RpcMsg = rpc_msg;
+}
+
+/* appends a chunk of count elements (none: the end of the pipe) to the stream being written */
+static void put_chunk( struct ndr_pipe *pipe, const unsigned char *elems, ULONG count )
+{
+    struct ndr_pipes *pipes = pipe->pipes;
+    MIDL_STUB_MESSAGE msg;
+    RPC_MESSAGE rpc_msg;
+    NDR_BUFFERSIZE sizer;
+    NDR_MARSHALL marshaller;
+    ULONG i, len = pipes->wlen;
+    unsigned char *p;
+
+    init_msg( pipes, &msg, &rpc_msg );
+
+    sizer = NdrBufferSizer[*pipe->elem_format & NDR_TABLE_MASK];
+    marshaller = NdrMarshaller[*pipe->elem_format & NDR_TABLE_MASK];
+    if (!sizer || !marshaller)
+    {
+        FIXME( "pipe elements of format 0x%02x not supported\n", *pipe->elem_format );
+        RpcRaiseException( RPC_X_BAD_STUB_DATA );
+    }
+
+#ifndef SG_MUTANT_PIPE_NOALIGN
+    align_length( &len, 4 );
+#endif
+    len += 4;
+    msg.BufferLength = len;
+    for (i = 0; i < count; i++) sizer( &msg, (unsigned char *)elems + (SIZE_T)i * pipe->mem_size, (PFORMAT_STRING)pipe->elem_format );
+    if (msg.BufferLength < len || msg.BufferLength > 0x7fffffff) RpcRaiseException( RPC_X_BAD_STUB_DATA );
+
+    pipes->wbuf = grow( pipes->wbuf, &pipes->wcap, msg.BufferLength );
+    rpc_msg.Buffer = pipes->wbuf;
+    rpc_msg.BufferLength = msg.BufferLength;
+    msg.BufferLength = rpc_msg.BufferLength;
+    msg.BufferStart = pipes->wbuf;
+    msg.Buffer = pipes->wbuf + pipes->wlen;
+    p = msg.Buffer;
+#ifndef SG_MUTANT_PIPE_NOALIGN
+    align_pointer_clear( &p, 4 );
+#endif
+    p[0] = count & 0xff;
+    p[1] = (count >> 8) & 0xff;
+    p[2] = (count >> 16) & 0xff;
+    p[3] = (count >> 24) & 0xff;
+    msg.Buffer = p + 4;
+    for (i = 0; i < count; i++) marshaller( &msg, (unsigned char *)elems + (SIZE_T)i * pipe->mem_size, (PFORMAT_STRING)pipe->elem_format );
+    pipes->wlen = msg.Buffer - pipes->wbuf;
+}
+
+/* the number of elements of the next chunk: 0 for the end of the pipe */
+static ULONG get_chunk_count( struct ndr_pipes *pipes )
+{
+    ULONG count;
+
+#ifndef SG_MUTANT_PIPE_NOALIGN
+    align_pointer_clear( &pipes->rcur, 4 );
+#endif
+    if (pipes->rcur + 4 < pipes->rcur || pipes->rcur + 4 > pipes->rend)
+    {
+        ERR( "pipe data ends in the middle of a chunk header\n" );
+        RpcRaiseException( RPC_X_BAD_STUB_DATA );
+    }
+    count = pipes->rcur[0] | (pipes->rcur[1] << 8) | (pipes->rcur[2] << 16) | ((ULONG)pipes->rcur[3] << 24);
+    pipes->rcur += 4;
+    return count;
+}
+
+/* reads count elements of the current chunk */
+static void get_elements( struct ndr_pipe *pipe, unsigned char *dest, ULONG count )
+{
+    struct ndr_pipes *pipes = pipe->pipes;
+    MIDL_STUB_MESSAGE msg;
+    RPC_MESSAGE rpc_msg;
+    NDR_UNMARSHALL unmarshaller;
+    ULONG i;
+
+    unmarshaller = NdrUnmarshaller[*pipe->elem_format & NDR_TABLE_MASK];
+    if (!unmarshaller)
+    {
+        FIXME( "pipe elements of format 0x%02x not supported\n", *pipe->elem_format );
+        RpcRaiseException( RPC_X_BAD_STUB_DATA );
+    }
+    init_msg( pipes, &msg, &rpc_msg );
+    msg.BufferStart = pipes->rbuf;
+    msg.BufferEnd = pipes->rend;
+    msg.Buffer = pipes->rcur;
+    rpc_msg.Buffer = pipes->rbuf;
+    rpc_msg.BufferLength = pipes->rend - pipes->rbuf;
+    msg.BufferLength = rpc_msg.BufferLength;
+    for (i = 0; i < count; i++)
+    {
+        unsigned char *elem = dest + (SIZE_T)i * pipe->mem_size;
+        unmarshaller( &msg, &elem, (PFORMAT_STRING)pipe->elem_format, 0 );
+    }
+    pipes->rcur = msg.Buffer;
+}
+
+/* reads up to max elements, of the current chunk or of the next one: 0 at the end of the pipe */
+static ULONG read_elements( struct ndr_pipe *pipe, unsigned char *dest, ULONG max )
+{
+    ULONG n;
+
+    if (pipe->in_end) return 0;
+    if (!pipe->left)
+    {
+        if (!(pipe->left = get_chunk_count( pipe->pipes )))
+        {
+            pipe->in_end = TRUE;
+            return 0;
+        }
+    }
+    n = min( max, pipe->left );
+    if (n) get_elements( pipe, dest, n );
+    pipe->left -= n;
+    return n;
+}
+
+/* reads the rest of a pipe which was not read to its end */
+static void skip_pipe( struct ndr_pipe *pipe )
+{
+    unsigned char *scratch;
+
+#ifdef SG_MUTANT_PIPE_NOSKIP
+    return;
+#endif
+    if (pipe->in_end) return;
+    if (!(scratch = malloc( pipe->mem_size ))) RpcRaiseException( RPC_X_NO_MEMORY );
+    while (read_elements( pipe, scratch, 1 )) ;
+    free( scratch );
+}
+
+/* client */
+
+#define CLIENT_CHUNK_BYTES 65536
+
+static void CALLBACK ndr_pipes_free_buffer( BOOL normal, void *buf )
+{
+    free( buf );
+}
+
+void ndr_pipes_client_send( struct ndr_pipes *pipes, void **stack_top )
+{
+    MIDL_STUB_MESSAGE *msg = pipes->msg;
+    unsigned int i;
+
+    pipes->wbuf = msg->RpcMsg->Buffer;
+    pipes->wcap = msg->RpcMsg->BufferLength;
+    pipes->wlen = msg->Buffer - (unsigned char *)msg->RpcMsg->Buffer;
+    pipes->wown = FALSE;
+
+    for (i = 0; i < pipes->count; i++)
+    {
+        struct ndr_pipe *pipe = &pipes->pipe[i];
+        struct ndr_pipe_struct *app = param_pipe_struct( (unsigned char *)stack_top, pipe->param );
+        ULONG cap = max( 1, CLIENT_CHUNK_BYTES / pipe->mem_size ), count;
+        unsigned char *buf;
+
+        pipe->app = app;
+        if (!pipe->is_in) continue;
+        if (!app || !app->Pull) RpcRaiseException( RPC_X_NULL_REF_POINTER );
+
+        if (!(buf = malloc( (SIZE_T)cap * pipe->mem_size ))) RpcRaiseException( RPC_X_NO_MEMORY );
+        __TRY
+        {
+            for (;;)
+            {
+                count = 0;
+                app->Pull( app->state, buf, cap, &count );
+                if (count > cap)
+                {
+                    ERR( "the pull routine of pipe %u returned %lu elements for a buffer of %lu\n", i, count, cap );
+                    RpcRaiseException( RPC_X_BAD_STUB_DATA );
+                }
+#ifdef SG_MUTANT_PIPE_NOEND
+                if (!count) break;
+#endif
+                put_chunk( pipe, buf, count );
+                if (!count) break;
+            }
+        }
+        __FINALLY_CTX( ndr_pipes_free_buffer, buf )
+    }
+
+    msg->RpcMsg->Buffer = pipes->wbuf;
+    msg->RpcMsg->BufferLength = pipes->wlen;
+    msg->Buffer = pipes->wbuf + pipes->wlen;
+    msg->BufferLength = pipes->wlen;
+}
+
+/* the response of a client call has arrived: hand the elements of the [out] pipes to the caller */
+void ndr_pipes_client_receive( struct ndr_pipes *pipes, void **stack_top )
+{
+    MIDL_STUB_MESSAGE *msg = pipes->msg;
+    unsigned int i;
+
+    pipes->rbuf = msg->BufferStart;
+    pipes->rend = msg->BufferEnd;
+    pipes->rcur = msg->Buffer;
+
+    for (i = 0; i < pipes->count; i++)
+    {
+        struct ndr_pipe *pipe = &pipes->pipe[i];
+        struct ndr_pipe_struct *app = param_pipe_struct( (unsigned char *)stack_top, pipe->param );
+        ULONG count, got;
+
+        if (!pipe->is_out) continue;
+        if (!app || !app->Push) RpcRaiseException( RPC_X_NULL_REF_POINTER );
+
+        for (;;)
+        {
+            if (!(count = get_chunk_count( pipes ))) break;
+            pipe->left = count;
+            while (pipe->left)
+            {
+                unsigned char *buf = NULL, *own = NULL;
+
+                got = pipe->left;
+                if (app->Alloc)
+                {
+                    ULONG bcount = 0;
+                    app->Alloc( app->state, pipe->left * pipe->mem_size, (void **)&buf, &bcount );
+                    if (!buf || !bcount) RpcRaiseException( RPC_S_OUT_OF_RESOURCES );
+#ifdef SG_MUTANT_PIPE_ALLOCIGNORE
+                    got = pipe->left;
+#else
+                    got = min( bcount, pipe->left );
+#endif
+                }
+                else
+                {
+                    got = min( got, max( 1, CLIENT_CHUNK_BYTES / pipe->mem_size ));
+                    if (!(own = buf = malloc( (SIZE_T)got * pipe->mem_size ))) RpcRaiseException( RPC_X_NO_MEMORY );
+                }
+                __TRY
+                {
+                    get_elements( pipe, buf, got );
+                    pipe->left -= got;
+                    app->Push( app->state, buf, got );
+                }
+                __FINALLY_CTX( ndr_pipes_free_buffer, own )
+            }
+        }
+#ifndef SG_MUTANT_PIPE_CLIENTEND
+        app->Push( app->state, NULL, 0 );
+#endif
+    }
+    msg->Buffer = pipes->rcur;
+}
+
+/* server */
+
+static void WINAPI server_pull( char *state, void *buf, ULONG esize, ULONG *ecount )
+{
+    struct ndr_pipe *pipe = (struct ndr_pipe *)state;
+    struct ndr_pipes *pipes = pipe->pipes;
+    unsigned int i;
+
+    /* the pipes are read in order: what the manager left of the earlier ones is skipped */
+    for (i = 0; &pipes->pipe[i] != pipe; i++)
+        if (pipes->pipe[i].is_in) skip_pipe( &pipes->pipe[i] );
+
+    *ecount = esize ? read_elements( pipe, buf, esize ) : 0;
+}
+
+static void WINAPI server_push( char *state, void *buf, ULONG ecount )
+{
+    struct ndr_pipe *pipe = (struct ndr_pipe *)state;
+
+    if (pipe->out_end)
+    {
+        ERR( "push to a pipe which has ended\n" );
+        RpcRaiseException( RPC_X_PIPE_CLOSED );
+    }
+    if (ecount && !buf) RpcRaiseException( RPC_X_NULL_REF_POINTER );
+    put_chunk( pipe, buf, ecount );
+    if (!ecount) pipe->out_end = TRUE;
+}
+
+static void WINAPI server_alloc( char *state, ULONG bsize, void **buf, ULONG *bcount )
+{
+    struct ndr_pipe *pipe = (struct ndr_pipe *)state;
+
+    *buf = I_RpcAllocate( bsize );
+    *bcount = *buf ? bsize / pipe->mem_size : 0;
+}
+
+/* gives the pipe parameter its struct on the stack of the manager routine */
+void ndr_pipes_server_setup( struct ndr_pipes *pipes, const NDR_PARAM_OIF *param, unsigned char *arg )
+{
+    unsigned int i;
+
+    for (i = 0; i < pipes->count; i++)
+    {
+        struct ndr_pipe *pipe = &pipes->pipe[i];
+
+        if (pipe->param != param) continue;
+        pipe->own.Pull = server_pull;
+        pipe->own.Push = server_push;
+        pipe->own.Alloc = server_alloc;
+        pipe->own.state = (char *)pipe;
+#ifdef _WIN64
+        *(struct ndr_pipe_struct **)arg = &pipe->own;
+#else
+        *(struct ndr_pipe_struct *)arg = pipe->own;
+#endif
+        return;
+    }
+}
+
+/* the [in] parameters have been unmarshalled: the pipes follow */
+void ndr_pipes_server_start( struct ndr_pipes *pipes )
+{
+    MIDL_STUB_MESSAGE *msg = pipes->msg;
+
+    pipes->rbuf = msg->BufferStart;
+    pipes->rend = msg->BufferEnd;
+    pipes->rcur = msg->Buffer;
+}
+
+/* the manager routine has returned: ends the [out] pipes it did not end, and returns the length
+ * of the pipes' data */
+ULONG ndr_pipes_server_finish( struct ndr_pipes *pipes )
+{
+    unsigned int i;
+
+    for (i = 0; i < pipes->count; i++)
+    {
+        struct ndr_pipe *pipe = &pipes->pipe[i];
+
+        if (!pipe->is_out || pipe->out_end) continue;
+#ifdef SG_MUTANT_PIPE_NOTERM
+        continue;
+#endif
+        put_chunk( pipe, NULL, 0 );
+        pipe->out_end = TRUE;
+    }
+    pipes->wown = TRUE;
+    return pipes->wlen;
+}
+
+/* the response buffer: the data of the pipes, with room for the other [out] parameters after it */
+void ndr_pipes_server_get_buffer( struct ndr_pipes *pipes, MIDL_STUB_MESSAGE *msg, RPC_MESSAGE *rpc_msg )
+{
+    pipes->wbuf = grow( pipes->wbuf, &pipes->wcap, max( msg->BufferLength, 1 ) );
+    rpc_msg->Buffer = pipes->wbuf;
+    rpc_msg->BufferLength = msg->BufferLength;
+    pipes->wown = FALSE;  /* the runtime owns the buffer now */
+    msg->Buffer = pipes->wbuf + pipes->wlen;
+}
diff --git a/dlls/rpcrt4/ndr_stubless.c b/dlls/rpcrt4/ndr_stubless.c
--- a/dlls/rpcrt4/ndr_stubless.c
+++ b/dlls/rpcrt4/ndr_stubless.c
@@ -488,6 +488,9 @@
         unsigned char *pArg = pStubMsg->StackTop + params[i].stack_offset;
         PFORMAT_STRING pTypeFormat = (PFORMAT_STRING)&pStubMsg->StubDesc->pFormatTypes[params[i].u.type_offset];
 
+        /* the data of a pipe is not part of the parameters' (see ndr_pipe.c) */
+        if (params[i].attr.IsPipe) continue;
+
 #ifndef __i386__  /* floats are passed as doubles through varargs functions */
         float f;
 
@@ -669,6 +672,7 @@
     void *This;
     PFORMAT_STRING handle_format;
     handle_t hbinding;
+    struct ndr_pipes *pipes;
 };
 
 static void CALLBACK ndr_client_call_finally(BOOL normal, void *arg)
@@ -681,10 +685,7 @@
         NdrCorrelationFree(ctx->stub_msg);
     }
 
-    if (ctx->Oif_flags.HasPipes)
-    {
-        /* NdrPipesDone(...) */
-    }
+    ndr_pipes_free(ctx->pipes);
 
     /* free the full pointer translation tables */
     if (ctx->proc_header->Oi_flags & Oi_FULL_PTR_USED)
@@ -735,6 +736,7 @@
     finally_ctx.This = This;
     finally_ctx.handle_format = handle_format;
     finally_ctx.hbinding = hbinding;
+    finally_ctx.pipes = NULL;
 
     __TRY
     {
