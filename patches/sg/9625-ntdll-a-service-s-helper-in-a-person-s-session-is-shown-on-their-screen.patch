From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: a service's helper in a person's session is shown on their screen

A program started with a token of another session than its starter's -- a
Windows service's helper, started in a person's session with SYSTEM's own
token given that session (9624) -- is in that session, but a Windows
program's screen here is an X server, and SYSTEM has none of the person's:
lending it the person's own would let every program of theirs type into it
and read it (ADR 0012). So, as an elevated program does (B56), it gets an X
server of its own that the person's compositor shows on their screen:
NtCreateUserProcess execs Wine's loader for it through sg-session's
sg-elevated-run --system, for the compositor of the session's user (the
person's seat, a Remote Desktop session's, or the sign-in screen's), which
also tells it the compositor's privileged socket (SG_COMPOSITOR_PRIV) for
screen capture and input (9626) -- granted by the compositor to the Windows
services' control group only (sg-compositor -R).

- Only a program in another session than its starter's, whose user is known
  (get_session_uid), with sg-elevated-run installed and a compositor socket
  for that user; otherwise it starts as before (in the session, without a
  display of its own). sg-elevated-run checks the compositor's socket is
  served by that user and runs only for the SYSTEM account itself.
- The new process keeps its connection to the wineserver through the exec;
  sg-elevated-run keeps nobody else (its X server, itself) holding it.
- SG_ELEVATED_RUN and SG_SEAT_ROOT override the paths, for the gate.

Gate: test/tokensession-gate.sh (a stand-in for sg-elevated-run on a private
seat directory).
---
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -34,6 +34,7 @@
 #include <string.h>
 #include <time.h>
 #include <sys/socket.h>
+#include <sys/stat.h>
 #include <sys/time.h>
 #ifdef HAVE_SYS_TIMES_H
 # include <sys/times.h>
@@ -421,8 +422,91 @@
 /***********************************************************************
  *           spawn_process
  */
+/***********************************************************************
+ *           sg_session_helper_wrapper
+ *
+ * Stained Glass OS (9625): a program started with a token of another session
+ * than ours -- a service's helper, which the service starts in a person's
+ * session with its own (SYSTEM's) token given that session
+ * (SetTokenInformation(TokenSessionId), 9624, SeTcbPrivilege only), as
+ * remote-support tools do (AnyDesk's backend, a VNC server's desktop half).
+ * The server put the process in that session already; on Windows it is then
+ * on the person's desktop, owns windows there and sees and types into it.
+ * Here the person's desktop is their compositor: the program gets a display
+ * of its own that the compositor shows on the person's screen, as an
+ * elevated program does (sg-session's sg-elevated-run --system), and the
+ * compositor's privileged socket for capture and input, which the compositor
+ * grants to the Windows services' control group only (9626, sg-compositor
+ * -R). No user's display is ever lent to SYSTEM's program.
+ *
+ * The argv to exec the loader through, or NULL (the same session, no session
+ * user, no compositor for it, no sg-elevated-run): started as before.
+ */
+static char **sg_session_helper_wrapper( HANDLE token )
+{
+    /* the person's own seat, a Remote Desktop session's, the sign-in screen's */
+    static const char *seats[] = { "%s/seat0/%u/control.sock", "%s/rdp-%u/%u/control.sock",
+                                   "%s/greeter/%u/control.sock" };
+    const char *run = getenv( "SG_ELEVATED_RUN" ), *root = getenv( "SG_SEAT_ROOT" );
+    unsigned int session = 0, uid = 0, i;
+    char path[108], uidstr[16], **argv;
+    struct stat st;
+    NTSTATUS status;
+
+    if (!token) return NULL;
+    SERVER_START_REQ( get_token_info )
+    {
+        req->handle = wine_server_obj_handle( token );
+        if (!(status = wine_server_call( req ))) session = reply->session_id;
+    }
+    SERVER_END_REQ;
+    if (status || session == NtCurrentTeb()->Peb->SessionId) return NULL;
+    SERVER_START_REQ( get_session_uid )
+    {
+        req->session_id = session;
+        if (!(status = wine_server_call( req ))) uid = reply->uid;
+    }
+    SERVER_END_REQ;
+    if (status) return NULL;
+    if (!run || !*run) run = "/usr/libexec/stained-glass/sg-elevated-run";
+    if (access( run, X_OK )) return NULL;
+    if (!root || !*root) root = "/run/stained-glass-seat";
+    for (i = 0; i < ARRAY_SIZE(seats); i++)
+    {
+        if (snprintf( path, sizeof(path), seats[i], root, uid, uid ) >= (int)sizeof(path)) continue;
+        if (!stat( path, &st ) && S_ISSOCK( st.st_mode )) break;
+    }
+    if (i == ARRAY_SIZE(seats))
+    {
+        WARN( "session %u (uid %u) has no compositor: the program has no display\n", session, uid );
+        return NULL;
+    }
+    snprintf( uidstr, sizeof(uidstr), "%u", uid );
+    if (!(argv = malloc( 9 * sizeof(*argv) ))) return NULL;
+    argv[0] = strdup( run );
+    argv[1] = strdup( "--system" );
+    argv[2] = strdup( "--control" );
+    argv[3] = strdup( path );
+    argv[4] = strdup( "--uid" );
+    argv[5] = strdup( uidstr );
+    argv[6] = strdup( "--" );
+    argv[7] = NULL;
+    for (i = 0; i < 7; i++) if (!argv[i]) return NULL;
+    TRACE( "session %u (uid %u): through %s on %s\n", session, uid, run, path );
+    return argv;
+}
+
+static void sg_free_argv( char **argv )
+{
+    char **p;
+    if (!argv) return;
+    for (p = argv; *p; p++) free( *p );
+    free( argv );
+}
+
 static NTSTATUS spawn_process( const RTL_USER_PROCESS_PARAMETERS *params, int socketfd,
-                               int unixdir, char *winedebug, const struct pe_image_info *pe_info )
+                               int unixdir, char *winedebug, const struct pe_image_info *pe_info,
+                               char **wrapper )
 {
     NTSTATUS status = STATUS_SUCCESS;
     int stdin_fd = -1, stdout_fd = -1;
@@ -465,6 +549,7 @@
             }
             argv = build_argv( &params->CommandLine, 2 );
 
+            sg_exec_wrapper = wrapper;
             exec_wineloader( argv, socketfd, pe_info );
             _exit(1);
         }
@@ -750,6 +835,7 @@
     CLIENT_ID id;
     USHORT machine = 0;
     HANDLE parent = 0, debug = 0, token = 0;
+    char **sg_wrapper;
     UNICODE_STRING redir, path = {0};
     OBJECT_ATTRIBUTES attr, empty_attr = { sizeof(empty_attr) };
     SIZE_T i, attr_count = (ps_attr->TotalLength - sizeof(ps_attr->TotalLength)) / sizeof(PS_ATTRIBUTE);
@@ -962,7 +1048,10 @@
 
     /* create the child process */
 
-    if ((status = spawn_process( params, socketfd[0], unixdir, winedebug, &pe_info ))) goto done;
+    sg_wrapper = sg_session_helper_wrapper( token );
+    status = spawn_process( params, socketfd[0], unixdir, winedebug, &pe_info, sg_wrapper );
+    sg_free_argv( sg_wrapper );
+    if (status) goto done;
 
     close( socketfd[0] );
     socketfd[0] = -1;
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -532,6 +532,32 @@
 }
 
 
+/* Stained Glass OS (9625): what the new process is exec'd through, in the
+ * child only (spawn_process): sg-elevated-run, for a service's helper in a
+ * person's session. NULL: the loader itself. */
+char **sg_exec_wrapper = NULL;
+
+static void sg_execv( const char *path, char **argv )
+{
+    if (sg_exec_wrapper && !strcmp( path, argv[0] ))
+    {
+        size_t n = 0, m = 0;
+        char **args;
+
+        while (sg_exec_wrapper[n]) n++;
+        while (argv[m]) m++;
+        if ((args = malloc( (n + m + 1) * sizeof(*args) )))
+        {
+            memcpy( args, sg_exec_wrapper, n * sizeof(*args) );
+            memcpy( args + n, argv, (m + 1) * sizeof(*args) );
+            execv( args[0], args );
+            free( args );
+        }
+        /* no wrapper to run: the program without a display of its own */
+    }
+    execv( path, argv );
+}
+
 static void preloader_exec( char **argv )
 {
 #ifdef HAVE_WINE_PRELOADER
@@ -555,10 +581,10 @@
         posix_spawnattr_destroy( &attr );
     }
 #endif
-    execv( argv[0], argv );
+    sg_execv( argv[0], argv );
     free( argv[0] );
 #endif
-    execv( argv[1], argv + 1 );
+    sg_execv( argv[1], argv + 1 );
 }
 
 /* exec the appropriate wine loader for the specified machine */
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -204,6 +204,7 @@
 extern char **build_envp( const WCHAR *envW );
 extern char *get_alternate_wineloader( WORD machine );
 extern NTSTATUS exec_wineloader( char **argv, int socketfd, const struct pe_image_info *pe_info );
+extern char **sg_exec_wrapper;
 extern NTSTATUS load_builtin( const struct pe_image_info *image_info, WCHAR *filename, USHORT machine,
                               SECTION_IMAGE_INFORMATION *info, void **module, SIZE_T *size,
                               ULONG_PTR limit_low, ULONG_PTR limit_high );
