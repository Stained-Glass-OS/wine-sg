From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] setupapi: a standard user reads a device's own key

setupapi reached a device's key by opening
HKLM\System\CurrentControlSet\Enum with KEY_ALL_ACCESS and creating the
device's key under it. A standard user may not create under HKLM, so for
one every device's key was INVALID_HANDLE_VALUE and every property read
failed with ERROR_INVALID_HANDLE -- hardware IDs, descriptions, device
properties ("fixme:setupapi:get_device_property Unhandled error 0x6", 18
of them when David opened DYMO Connect, 2026-10-05). Windows lets a
standard user read devices' keys. When creating the key is refused it is
now opened, for reading and writing if allowed, else for reading.

Test: test/devkeyread-gate.sh with test/devkeyread-probe.c -- the Enum
key read-only for everyone (mutant SG_MUTANT_DEVKEYREAD).
---
--- a/dlls/setupapi/devinst.c
+++ b/dlls/setupapi/devinst.c
@@ -595,6 +595,22 @@
                 KEY_READ | KEY_WRITE, NULL, &key, NULL);
         RegCloseKey(enumKey);
     }
+#ifndef SG_MUTANT_DEVKEYREAD
+    /* Stained Glass OS: a standard user may not create under HKLM, but may
+     * read a present device's key, as on Windows. Without it every device's
+     * key was INVALID_HANDLE_VALUE for a standard user, and each property
+     * read failed (SetupDiGetDeviceProperty: "Unhandled error 0x6", device
+     * descriptions, hardware IDs: a USB printer's or scanner's software did
+     * not find it). Open it for reading when creating it is refused. */
+    if (key == INVALID_HANDLE_VALUE &&
+        !RegOpenKeyExW(HKEY_LOCAL_MACHINE, Enum, 0, KEY_ENUMERATE_SUB_KEYS, &enumKey))
+    {
+        if (RegOpenKeyExW(enumKey, device->instanceId, 0, KEY_READ | KEY_WRITE, &key) &&
+            RegOpenKeyExW(enumKey, device->instanceId, 0, KEY_READ, &key))
+            key = INVALID_HANDLE_VALUE;
+        RegCloseKey(enumKey);
+    }
+#endif
     return key;
 }
 
