+/* Predicated rendering (ID3D11DeviceContext::SetPredication): commands are
+ * dropped when the predicate's result differs from the value it was set with.
+ * On Windows the GPU evaluates the predicate in the command stream, so the
+ * result is always taken into account: wait for it here, on the CS thread. */
+static bool wined3d_cs_predicate_skips(struct wined3d_cs *cs)
+{
+#ifdef SG_MUTANT_PREDICATE
+    return false;
+#endif
+    struct wined3d_query *query = cs->state.predicate;
+    const struct wined3d_query_data_so_statistics *so;
+    unsigned int tries = 0;
+    BOOL result;
+
+    if (!query || !query->poll_in_cs || query->state != QUERY_SIGNALLED)
+        return false;
+
+    if (query->buffer_object)
+    {
+        while (!wined3d_query_buffer_is_valid(query))
+        {
+            if (++tries > 1000)
+                return false;
+            Sleep(1);
+        }
+    }
+    else if (query->counter_main != query->counter_retrieved)
+    {
+        if (list_empty(&query->poll_list_entry))
+            return false;
+        while (!query->query_ops->query_poll(query, 0))
+        {
+            if (++tries > 1000)
+                return false;
+            Sleep(1);
+        }
+    }
+
+    switch (query->type)
+    {
+        case WINED3D_QUERY_TYPE_OCCLUSION:
+            result = (query->buffer_object ? query->map_ptr[0] : *(const uint64_t *)query->data) != 0;
+            break;
+
+        case WINED3D_QUERY_TYPE_SO_OVERFLOW:
+        case WINED3D_QUERY_TYPE_SO_OVERFLOW_STREAM0:
+        case WINED3D_QUERY_TYPE_SO_OVERFLOW_STREAM1:
+        case WINED3D_QUERY_TYPE_SO_OVERFLOW_STREAM2:
+        case WINED3D_QUERY_TYPE_SO_OVERFLOW_STREAM3:
+            so = query->data;
+            result = so->primitives_generated > so->primitives_written;
+            break;
+
+        default:
+            return false;
+    }
+
+    return result != cs->state.predicate_value;
+}
+
 static void wined3d_cs_exec_clear(struct wined3d_cs *cs, const void *data)
 {
     struct wined3d_device *device = cs->c.device;
     const struct wined3d_cs_clear *op = data;
 
+    if (wined3d_cs_predicate_skips(cs))
+        return;
+
     device->blitter->ops->blitter_clear(device->blitter, device, op->rt_count, &op->fb,
             op->rect_count, op->rects, &op->draw_rect, op->flags, &op->color, op->depth, op->stencil);
 }
@@ -1012,6 +1075,9 @@ static void wined3d_cs_exec_dispatch(struct wined3d_cs *cs, const void *data)
     const struct wined3d_cs_dispatch *op = data;
     struct wined3d_state *state = &cs->state;
 
+    if (wined3d_cs_predicate_skips(cs))
