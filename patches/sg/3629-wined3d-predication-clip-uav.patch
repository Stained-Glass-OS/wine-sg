+/* Unsigned small float with a 5-bit exponent and the given mantissa width
+ * (the 11 and 10 bit components of R11G11B10_FLOAT). */
+static uint32_t float_to_small_float(float f, unsigned int mantissa_bits)
+{
+    double v = f, fr;
+    long m;
+    int e;
+
+    if (v != v)
+        return (0x1fu << mantissa_bits) | 1;
+    if (v <= 0.0)
+        return 0;
+    if (v >= 65504.0)
+        return 0x1fu << mantissa_bits;
+
+    fr = frexp(v, &e);
+    if (e + 14 >= 1)
+    {
+        m = lrint((fr * 2.0 - 1.0) * (1u << mantissa_bits));
+        if (m == (1l << mantissa_bits))
+        {
+            m = 0;
+            ++e;
+        }
+        if (e + 14 >= 31)
+            return 0x1fu << mantissa_bits;
+        return ((uint32_t)(e + 14) << mantissa_bits) | m;
+    }
+
+    m = lrint(ldexp(v, 14 + mantissa_bits));
+    return m;
+}
