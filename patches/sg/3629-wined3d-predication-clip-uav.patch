+static void test_sg_wined3d(void)
+{
+    D3D11_UNORDERED_ACCESS_VIEW_DESC uav_desc;
+    struct d3d11_test_context test_context;
+    ID3D11DeviceContext *immediate_context;
+    ID3D11UnorderedAccessView *uav;
+    ID3D11Predicate *pred_true, *pred_false;
+    ID3D11Buffer *buffer, *staging;
+    D3D11_QUERY_DESC query_desc;
+    D3D11_MAPPED_SUBRESOURCE map;
+    D3D11_BUFFER_DESC buffer_desc;
+    D3D11_RASTERIZER_DESC rs_desc;
+    ID3D11RasterizerState *rs;
+    ID3D11Device *device;
+    D3D11_RECT scissor;
+    BOOL result;
+    DWORD color;
+    HRESULT hr;
+    unsigned i;
+
+    static const float red[] = {1.0f, 0.0f, 0.0f, 1.0f};
+    static const struct vec4 green = {0.0f, 1.0f, 0.0f, 1.0f};
+    static const UINT clear_value[] = {0x11, 0x22, 0x33, 0x44};
+
+    if (!init_test_context(&test_context, NULL))
+        return;
+    device = test_context.device;
+    immediate_context = test_context.immediate_context;
+
+    /* Predicated rendering: a draw is dropped when the predicate's result
+     * differs from the value given to SetPredication(). */
+    query_desc.Query = D3D11_QUERY_OCCLUSION_PREDICATE;
+    query_desc.MiscFlags = 0;
+    hr = ID3D11Device_CreatePredicate(device, &query_desc, &pred_true);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID3D11Device_CreatePredicate(device, &query_desc, &pred_false);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    ID3D11DeviceContext_Begin(immediate_context, (ID3D11Asynchronous *)pred_true);
+    draw_color_quad(&test_context, &green);
+    ID3D11DeviceContext_End(immediate_context, (ID3D11Asynchronous *)pred_true);
+
+    memset(&rs_desc, 0, sizeof(rs_desc));
+    rs_desc.FillMode = D3D11_FILL_SOLID;
+    rs_desc.CullMode = D3D11_CULL_NONE;
+    rs_desc.DepthClipEnable = TRUE;
+    rs_desc.ScissorEnable = TRUE;
+    hr = ID3D11Device_CreateRasterizerState(device, &rs_desc, &rs);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    SetRect(&scissor, 0, 0, 0, 0);
+    ID3D11DeviceContext_RSSetScissorRects(immediate_context, 1, &scissor);
+    ID3D11DeviceContext_RSSetState(immediate_context, rs);
+    ID3D11DeviceContext_Begin(immediate_context, (ID3D11Asynchronous *)pred_false);
+    draw_color_quad(&test_context, &green);
+    ID3D11DeviceContext_End(immediate_context, (ID3D11Asynchronous *)pred_false);
+    ID3D11DeviceContext_RSSetState(immediate_context, NULL);
+
+    for (i = 0; i < 2; ++i)
+    {
+        ID3D11Predicate *pred = i ? pred_false : pred_true;
+
+        for (;;)
+        {
+            hr = ID3D11DeviceContext_GetData(immediate_context, (ID3D11Asynchronous *)pred, &result, sizeof(result), 0);
+            if (hr != S_FALSE)
+                break;
+            Sleep(1);
+        }
+        ok(hr == S_OK && result == !i, "Predicate %u: hr %#lx, result %d.\n", i, hr, result);
+    }
+
+    {
+        static const struct { int pred_true, value, drawn; } tests[] =
+        {
+            {1, TRUE,  1}, {1, FALSE, 0}, {0, TRUE,  0}, {0, FALSE, 1},
+        };
+        unsigned int t;
+
+        for (t = 0; t < ARRAY_SIZE(tests); ++t)
+        {
+            ID3D11DeviceContext_ClearRenderTargetView(immediate_context, test_context.backbuffer_rtv, red);
+            ID3D11DeviceContext_SetPredication(immediate_context,
+                    tests[t].pred_true ? pred_true : pred_false, tests[t].value);
+            draw_color_quad(&test_context, &green);
+            ID3D11DeviceContext_SetPredication(immediate_context, NULL, FALSE);
+            color = get_texture_color(test_context.backbuffer, 320, 240);
+            ok(compare_color(color, tests[t].drawn ? 0xff00ff00 : 0xff0000ff, 1),
+                    "Test %u: got unexpected colour 0x%08lx.\n", t, color);
+        }
+    }
+    ID3D11RasterizerState_Release(rs);
+    ID3D11Predicate_Release(pred_true);
+    ID3D11Predicate_Release(pred_false);
+
+    /* Clearing a typed buffer UAV of a narrow format. */
+    buffer_desc.ByteWidth = 64;
+    buffer_desc.Usage = D3D11_USAGE_DEFAULT;
+    buffer_desc.BindFlags = D3D11_BIND_UNORDERED_ACCESS;
+    buffer_desc.CPUAccessFlags = 0;
+    buffer_desc.MiscFlags = 0;
+    buffer_desc.StructureByteStride = 0;
+    hr = ID3D11Device_CreateBuffer(device, &buffer_desc, NULL, &buffer);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    buffer_desc.Usage = D3D11_USAGE_STAGING;
+    buffer_desc.BindFlags = 0;
+    buffer_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    hr = ID3D11Device_CreateBuffer(device, &buffer_desc, NULL, &staging);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    memset(&uav_desc, 0, sizeof(uav_desc));
+    uav_desc.Format = DXGI_FORMAT_R8G8B8A8_UINT;
+    uav_desc.ViewDimension = D3D11_UAV_DIMENSION_BUFFER;
+    uav_desc.Buffer.NumElements = 16;
+    hr = ID3D11Device_CreateUnorderedAccessView(device, (ID3D11Resource *)buffer, &uav_desc, &uav);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID3D11DeviceContext_ClearUnorderedAccessViewUint(immediate_context, uav, clear_value);
+    ID3D11DeviceContext_CopyResource(immediate_context, (ID3D11Resource *)staging, (ID3D11Resource *)buffer);
+    hr = ID3D11DeviceContext_Map(immediate_context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &map);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        const unsigned char *data = map.pData;
+        for (i = 0; i < 16; ++i)
+            ok(data[i * 4] == 0x11 && data[i * 4 + 1] == 0x22 && data[i * 4 + 2] == 0x33 && data[i * 4 + 3] == 0x44,
+                    "Element %u: got %02x %02x %02x %02x.\n", i, data[i * 4], data[i * 4 + 1],
+                    data[i * 4 + 2], data[i * 4 + 3]);
+        ID3D11DeviceContext_Unmap(immediate_context, (ID3D11Resource *)staging, 0);
+    }
+    ID3D11UnorderedAccessView_Release(uav);
+    ID3D11Buffer_Release(staging);
+    ID3D11Buffer_Release(buffer);
+
+    release_test_context(&test_context);
+}
