+static BOOL d3d_query_is_predicate_type(D3D11_QUERY type)
+{
+    return type == D3D11_QUERY_OCCLUSION_PREDICATE
+            || type == D3D11_QUERY_SO_OVERFLOW_PREDICATE
+            || type == D3D11_QUERY_SO_OVERFLOW_PREDICATE_STREAM0
+            || type == D3D11_QUERY_SO_OVERFLOW_PREDICATE_STREAM1
+            || type == D3D11_QUERY_SO_OVERFLOW_PREDICATE_STREAM2
+            || type == D3D11_QUERY_SO_OVERFLOW_PREDICATE_STREAM3;
+}
+
+/* The data of a predicate query is a BOOL, whatever the counter behind it. */
+unsigned int d3d_query_get_data_size(struct d3d_query *query)
+{
+#ifndef SG_MUTANT_PREDSIZE
+    if (d3d_query_is_predicate_type(query->desc.Query))
+        return sizeof(BOOL);
+#endif
+    return wined3d_query_get_data_size(query->wined3d_query);
+}
+
+/* Called with the wined3d mutex held. */
+HRESULT d3d_query_get_data(struct d3d_query *query, void *data, UINT data_size, unsigned int wined3d_flags)
+{
+    union
+    {
+        UINT64 samples;
+        struct { UINT64 written, generated; } so;
+    } raw;
+    HRESULT hr;
+
+    if (!d3d_query_is_predicate_type(query->desc.Query))
+        return wined3d_query_get_data(query->wined3d_query, data, data_size, wined3d_flags);
+
+    if (data_size && data_size != sizeof(BOOL))
+        return E_INVALIDARG;
+
+    if (FAILED(hr = wined3d_query_get_data(query->wined3d_query, data ? &raw : NULL,
+            data ? sizeof(raw) : 0, wined3d_flags)) || !data)
+        return hr;
+
+    if (query->desc.Query == D3D11_QUERY_OCCLUSION_PREDICATE)
+        *(BOOL *)data = raw.samples != 0;
+    else
+        *(BOOL *)data = raw.so.generated > raw.so.written;
+    return hr;
+}
