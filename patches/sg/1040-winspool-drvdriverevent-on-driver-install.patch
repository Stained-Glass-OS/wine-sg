From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winspool: a newly installed driver is told so (DrvDriverEvent)

Windows' spooler calls the configuration DLL's DrvDriverEvent with
DRIVER_EVENT_INITIALIZE once a driver is installed (Microsoft Learn,
DrvDriverEvent), with a DRIVER_INFO_3 of its installed files. Makers'
drivers set themselves up there: Epson's makes its HKLM\Software\EPSON
entries (its URLs). Drivers for another architecture are not called; a
crash in the call is caught.

Epson XP-230's preferences still crash: they want
HKLM\Software\EPSON\STM3\Driver\<model> (value Profile), which neither the
driver nor its events make. Its catalog package carries the status monitor's
programs as driver files but no installer for them; the key comes from
Epson's full setup bundle, which is not in the package.

Test: test/drvpkg-gate.sh (mutant SG_MUTANT_DRIVEREVENT).
---
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -42,6 +42,7 @@
 #include "winternl.h"
 #include "winnls.h"
 #include "wine/windef16.h"
+#include "wine/exception.h"
 #include "wine/debug.h"
 #include "wine/list.h"
 #include "wine/rbtree.h"
@@ -7092,6 +7093,54 @@
     return FALSE;
 }
 
+/* the newly installed driver is told so (DrvDriverEvent, DRIVER_EVENT_INITIALIZE)
+ * by its configuration DLL, as Windows' spooler does: makers' drivers set up
+ * what they need there (Epson's status monitor settings) */
+static void driver_event( DWORD event, const DRIVER_INFO_3W *info )
+{
+    BOOL (WINAPI *event_func)( DWORD, DWORD, BYTE *, LPARAM );
+    WCHAR dir[MAX_PATH], paths[3][MAX_PATH];
+    const WCHAR *files[3] = { info->pDriverPath, info->pDataFile, info->pConfigFile }, *base;
+    DRIVER_INFO_3W di;
+    HMODULE module;
+    DWORD size;
+    unsigned int i;
+
+    if (!info->pConfigFile || !info->pName) return;
+    if (info->pEnvironment && info->pEnvironment[0] && wcsicmp( info->pEnvironment, env_arch.envname )) return;
+    if (!GetPrinterDriverDirectoryW( NULL, NULL, 1, (BYTE *)dir, sizeof(dir), &size )) return;
+    for (i = 0; i < 3; i++)
+    {
+        paths[i][0] = 0;
+        if (!files[i]) continue;
+        base = wcsrchr( files[i], '\\' );
+        swprintf( paths[i], MAX_PATH, L"%s\\3\\%s", dir, base ? base + 1 : files[i] );
+    }
+    if (!(module = LoadLibraryExW( paths[2], NULL, LOAD_WITH_ALTERED_SEARCH_PATH ))) return;
+    if ((event_func = (void *)GetProcAddress( module, "DrvDriverEvent" )))
+    {
+        memset( &di, 0, sizeof(di) );
+        di = *info;
+        di.cVersion = 3;
+        di.pDriverPath = paths[0];
+        di.pDataFile = paths[1];
+        di.pConfigFile = paths[2];
+        if (!di.pEnvironment || !di.pEnvironment[0]) di.pEnvironment = (WCHAR *)env_arch.envname;
+        TRACE( "%s: DrvDriverEvent %lu\n", debugstr_w(info->pName), event );
+        __TRY
+        {
+            if (!event_func( event, 3, (BYTE *)&di, 0 ))
+                WARN( "%s: DrvDriverEvent %lu failed\n", debugstr_w(info->pName), event );
+        }
+        __EXCEPT_ALL
+        {
+            WARN( "%s: DrvDriverEvent %lu crashed\n", debugstr_w(info->pName), event );
+        }
+        __ENDTRY
+    }
+    FreeLibrary( module );
+}
+
 /******************************************************************************
  *  AddPrinterDriverExW (WINSPOOL.@)
  *
@@ -7124,7 +7173,11 @@
         return FALSE;
     }
 
-    return backend->fpAddPrinterDriverEx(pName, level, pDriverInfo, dwFileCopyFlags);
+    if (!backend->fpAddPrinterDriverEx(pName, level, pDriverInfo, dwFileCopyFlags)) return FALSE;
+#ifndef SG_MUTANT_DRIVEREVENT
+    if (!pName) driver_event( DRIVER_EVENT_INITIALIZE, (DRIVER_INFO_3W *)pDriverInfo );
+#endif
+    return TRUE;
 }
 
 /******************************************************************************
