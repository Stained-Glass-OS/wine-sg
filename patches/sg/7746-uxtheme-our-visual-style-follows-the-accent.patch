--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -562,8 +562,9 @@
     watch_theme_manager();
 
     read_theme_config(&active, theme, color, sizeof(color), size, sizeof(size));
+    /* a new accent re-made the style's images and colours too (wine-sg 7746) */
     if (active == bThemeActive && !lstrcmpiW(theme, szCurrentTheme) &&
-        !lstrcmpiW(color, szCurrentColor) && !lstrcmpiW(size, szCurrentSize))
+        !lstrcmpiW(color, szCurrentColor) && !lstrcmpiW(size, szCurrentSize) && !MSSTYLES_AccentStale())
         return;
     if (active && theme[0] &&
         SUCCEEDED(MSSTYLES_OpenThemeFile(theme, color[0] ? color : NULL, size[0] ? size : NULL, &pt)))
@@ -650,6 +651,22 @@
     EnumWindows(redraw_frame_proc, 0);
 }
 
+/* the scheme's system colours that are shades of the accent (the selection's,
+ * the hot track's, the menu's highlight) are not the ones in use; the others
+ * are left as the person may have set them */
+static BOOL sys_colors_differ(PTHEME_FILE tf)
+{
+    int elements[NUM_SYS_COLORS], count, i;
+    COLORREF colors[NUM_SYS_COLORS];
+
+    count = MSSTYLES_GetThemeSysColors(tf, elements, colors, NUM_SYS_COLORS);
+    for (i = 0; i < count; i++)
+        if (elements[i] >= 0 && elements[i] < NUM_SYS_COLORS && elements[i] != COLOR_BACKGROUND &&
+            MSSTYLES_IsAccentShade(tf, colors[i]) && GetSysColor(elements[i]) != colors[i])
+            return TRUE;
+    return FALSE;
+}
+
 /**********************************************************************
  *      RefreshImmersiveColorPolicyState                  (UXTHEME.104)
  *
@@ -691,7 +708,15 @@
     if (SUCCEEDED(MSSTYLES_OpenThemeFile(theme, NULL, size[0] ? size : NULL, &light)))
     {
         want = rounded ? rounded : dark_mode ? dark : light;
-        if (lstrcmpiW(color, want->pszSelectedColor) || lstrcmpiW(szCurrentColor, want->pszSelectedColor))
+        /* ...and on a new accent, the same scheme again, made with it; and when
+         * the system colours kept from before are not the scheme's as the accent
+         * makes them -- a person who chose another accent before the style
+         * followed it (wine-sg 7746) */
+        if (lstrcmpiW(color, want->pszSelectedColor) || lstrcmpiW(szCurrentColor, want->pszSelectedColor)
+#ifndef SG_MUTANT_THEME_KEEPS_ACCENT
+            || MSSTYLES_AccentStale() || sys_colors_differ(want)
+#endif
+            )
             UXTHEME_ApplyColorScheme(want);
         MSSTYLES_CloseThemeFile(light);
     }
