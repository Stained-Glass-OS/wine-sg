 HRESULT MSSTYLES_SetActiveTheme(PTHEME_FILE tf, BOOL setMetrics);
 int MSSTYLES_GetThemeSysColors(PTHEME_FILE tf, int *elements, COLORREF *colors, int max);
+COLORREF MSSTYLES_ReadAccent(void);
+BOOL MSSTYLES_AccentStale(void);
+BOOL MSSTYLES_IsAccentShade(PTHEME_FILE tf, COLORREF color);
