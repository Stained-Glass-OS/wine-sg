From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uxtheme: our visual style follows the accent colour

David 2026-11-12: "when you change from purple to a diff accent color it
does not change every icon, just most, and some places seem to still use a
hard coded purple. We need to make sure we get acent color to be full and
system wide."

light.msstyles carries the default accent (Stained Glass purple, 0x7B2FBE,
0031) at several shades and tints, in its images and in its colours: the
buttons, check boxes, sliders and progress bars under the pointer, the
selection, the system colours Hilight, HotTrackingColor and MenuHilight.
None of it followed the accent Settings > Personalization > Colors sets
(HKCU DWM AccentColor), so drop-downs' selection, list selections and every
themed control stayed purple whatever the person chose.

- A style of our own (a Wine builtin, by the signature after its DOS header;
  a style someone installed is never touched) is opened with the accent:
  its images are re-hued as they are loaded and its colours as they are
  read (GetThemeColor, the [SysMetrics] system colours). The key hue becomes
  the accent's; saturation and value keep their place relative to the key's
  -- below it they scale, above it the rest of the way to full scales -- so
  a pale tint stays pale over the accent and a deep shade deep.
- RefreshImmersiveColorPolicyState (the shell calls it on "ImmersiveColorSet"
  and when it starts) applies the scheme again when the accent changed, and
  when the system colours kept from before are not the ones the accent
  makes (a person who chose another accent before the style followed it);
  only the colours that are shades of the accent are compared, so colours a
  person set themselves stay. Every process follows the reloaded style as it
  follows a scheme change (the ThemeManager key it watches).
---
--- a/dlls/uxtheme/msstyles.c
+++ b/dlls/uxtheme/msstyles.c
@@ -20,12 +20,14 @@
 
 #include <stdarg.h>
 #include <stdlib.h>
+#include <math.h>
 
 #include "windef.h"
 #include "winbase.h"
 #include "wingdi.h"
 #include "winuser.h"
 #include "winnls.h"
+#include "winreg.h"
 #include "vfwmsgs.h"
 #include "uxtheme.h"
 #include "vssym32.h"
@@ -53,6 +55,175 @@
 
 static PTHEME_FILE tfActiveTheme;
 
+/***********************************************************************
+ * Stained Glass OS: our visual style follows the accent colour (wine-sg 7746)
+ *
+ * light.msstyles carries the default accent (Stained Glass purple, 0x7B2FBE)
+ * at several shades and tints, in its images and in its colours: buttons,
+ * check boxes, sliders, progress bars, the selection, the system colours
+ * Hilight, HotTrackingColor and MenuHilight. A style of our own -- a Wine
+ * builtin, by the signature after its DOS header -- gets that hue turned into
+ * the accent's as its images are loaded and its colours read, each shade
+ * keeping its place: the key colour becomes the accent, lighter tints stay as
+ * light over it, darker shades as dark. A style someone installed is never
+ * touched. The accent is Personalization's, HKCU DWM AccentColor (0xAABBGGRR).
+ */
+#define SG_KEY_COLOR RGB(0x7b, 0x2f, 0xbe)
+#define SG_KEY_HUE   271.88
+#define SG_KEY_SAT   0.7526
+#define SG_KEY_VAL   0.7451
+
+COLORREF MSSTYLES_ReadAccent(void)
+{
+    DWORD value, size = sizeof(value);
+
+#ifdef SG_MUTANT_THEME_ACCENT_FIXED
+    return SG_KEY_COLOR;
+#endif
+    if (!RegGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\DWM", L"AccentColor",
+                      RRF_RT_REG_DWORD, NULL, &value, &size))
+        return value & 0xffffff;
+    return SG_KEY_COLOR;
+}
+
+/* the accent changed since the active style was made */
+BOOL MSSTYLES_AccentStale(void)
+{
+    return tfActiveTheme && tfActiveTheme->sg_ours && tfActiveTheme->sg_accent != MSSTYLES_ReadAccent();
+}
+
+static void sg_rgb_to_hsv(double r, double g, double b, double *h, double *s, double *v);
+
+/* a colour of the accent's hue: one the style made from its key colour */
+BOOL MSSTYLES_IsAccentShade(PTHEME_FILE tf, COLORREF color)
+{
+    double h, s, v, ah, as, av, dh;
+
+    if (!tf || !tf->sg_ours) return FALSE;
+    sg_rgb_to_hsv(GetRValue(color) / 255.0, GetGValue(color) / 255.0, GetBValue(color) / 255.0, &h, &s, &v);
+    sg_rgb_to_hsv(GetRValue(tf->sg_accent) / 255.0, GetGValue(tf->sg_accent) / 255.0,
+                  GetBValue(tf->sg_accent) / 255.0, &ah, &as, &av);
+    dh = fabs(h - ah);
+    if (dh > 180) dh = 360 - dh;
+    return dh <= 22 && s >= 0.04 && v >= 0.15;
+}
+
+static BOOL sg_theme_file_is_ours(const WCHAR *file)
+{
+    static const char signature[] = "Wine builtin DLL";
+    char header[sizeof(IMAGE_DOS_HEADER) + sizeof(signature)];
+    HANDLE handle;
+    DWORD read = 0;
+
+    handle = CreateFileW(file, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                         OPEN_EXISTING, 0, NULL);
+    if (handle == INVALID_HANDLE_VALUE) return FALSE;
+    ReadFile(handle, header, sizeof(header), &read, NULL);
+    CloseHandle(handle);
+    return read == sizeof(header) && header[0] == 'M' && header[1] == 'Z' &&
+           !memcmp(header + sizeof(IMAGE_DOS_HEADER), signature, sizeof(signature));
+}
+
+static void sg_rgb_to_hsv(double r, double g, double b, double *h, double *s, double *v)
+{
+    double hi = max(r, max(g, b)), lo = min(r, min(g, b)), d = hi - lo;
+
+    *v = hi;
+    *s = hi > 0 ? d / hi : 0;
+    if (d <= 0) *h = 0;
+    else if (hi == r) *h = 60 * ((g - b) / d);
+    else if (hi == g) *h = 60 * ((b - r) / d + 2);
+    else *h = 60 * ((r - g) / d + 4);
+    if (*h < 0) *h += 360;
+}
+
+static void sg_hsv_to_rgb(double h, double s, double v, double *r, double *g, double *b)
+{
+    double c = v * s, x, m = v - c, hh = h / 60;
+    int i = (int)hh % 6;
+
+    x = c * (1 - fabs(fmod(hh, 2) - 1));
+    switch (i)
+    {
+    case 0: *r = c; *g = x; *b = 0; break;
+    case 1: *r = x; *g = c; *b = 0; break;
+    case 2: *r = 0; *g = c; *b = x; break;
+    case 3: *r = 0; *g = x; *b = c; break;
+    case 4: *r = x; *g = 0; *b = c; break;
+    default: *r = c; *g = 0; *b = x; break;
+    }
+    *r += m; *g += m; *b += m;
+}
+
+/* one channel's place relative to the key's, kept relative to the accent's:
+ * below the key it scales, above it the rest of the way to 1 scales */
+static double sg_shift(double x, double key, double accent)
+{
+    if (x <= key) return x * accent / key;
+    return accent + (x - key) / (1 - key) * (1 - accent);
+}
+
+/* r, g, b in 0..1; FALSE: not of the key's hue, left as it was */
+static BOOL sg_rehue(double *r, double *g, double *b, COLORREF accent)
+{
+    double ah, as, av, h, s, v, dh;
+
+    sg_rgb_to_hsv(*r, *g, *b, &h, &s, &v);
+    dh = fabs(h - SG_KEY_HUE);
+    if (dh > 180) dh = 360 - dh;
+    if (dh > 22 || s < 0.04 || v < 0.15) return FALSE;
+    sg_rgb_to_hsv(GetRValue(accent) / 255.0, GetGValue(accent) / 255.0, GetBValue(accent) / 255.0, &ah, &as, &av);
+    sg_hsv_to_rgb(ah, min(1.0, sg_shift(s, SG_KEY_SAT, as)), min(1.0, sg_shift(v, SG_KEY_VAL, av)), r, g, b);
+    return TRUE;
+}
+
+static COLORREF sg_rehue_color(PTHEME_FILE tf, COLORREF color)
+{
+    double r = GetRValue(color) / 255.0, g = GetGValue(color) / 255.0, b = GetBValue(color) / 255.0;
+
+    if (!tf || !tf->sg_ours || tf->sg_accent == SG_KEY_COLOR) return color;
+    if (!sg_rehue(&r, &g, &b, tf->sg_accent)) return color;
+    return RGB((BYTE)(r * 255 + 0.5), (BYTE)(g * 255 + 0.5), (BYTE)(b * 255 + 0.5));
+}
+
+/* a style image as it is loaded, before its alpha is premultiplied */
+static void sg_rehue_bitmap(PTHEME_FILE tf, HBITMAP bitmap)
+{
+    BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER) }};
+    BOOL changed = FALSE;
+    DWORD *bits, i, count;
+    double r, g, b;
+    BITMAP bm;
+    HDC hdc;
+
+    if (!tf || !tf->sg_ours || tf->sg_accent == SG_KEY_COLOR) return;
+    if (!bitmap || !GetObjectW(bitmap, sizeof(bm), &bm) || bm.bmBitsPixel <= 8) return;
+    info.bmiHeader.biWidth = bm.bmWidth;
+    info.bmiHeader.biHeight = -bm.bmHeight;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    count = bm.bmWidth * bm.bmHeight;
+    if (!count || !(bits = malloc(count * 4))) return;
+    hdc = CreateCompatibleDC(NULL);
+    if (GetDIBits(hdc, bitmap, 0, bm.bmHeight, bits, &info, DIB_RGB_COLORS))
+    {
+        for (i = 0; i < count; i++)
+        {
+            DWORD p = bits[i];
+
+            r = ((p >> 16) & 0xff) / 255.0; g = ((p >> 8) & 0xff) / 255.0; b = (p & 0xff) / 255.0;
+            if (!sg_rehue(&r, &g, &b, tf->sg_accent)) continue;
+            bits[i] = (p & 0xff000000) | ((DWORD)min(r * 255 + 0.5, 255) << 16) |
+                      ((DWORD)min(g * 255 + 0.5, 255) << 8) | (DWORD)min(b * 255 + 0.5, 255);
+            changed = TRUE;
+        }
+        if (changed) SetDIBits(hdc, bitmap, 0, bm.bmHeight, bits, &info, DIB_RGB_COLORS);
+    }
+    DeleteDC(hdc);
+    free(bits);
+}
+
 /***********************************************************************/
 
 /**********************************************************************
@@ -171,6 +342,8 @@
     (*tf)->pszSelectedColor = pszSelectedColor;
     (*tf)->pszSelectedSize = pszSelectedSize;
     (*tf)->refcount = 1;
+    if (((*tf)->sg_ours = sg_theme_file_is_ours((*tf)->szThemeFile)))
+        (*tf)->sg_accent = MSSTYLES_ReadAccent();
     return S_OK;
 
 invalid_theme:
@@ -792,7 +965,7 @@
     for (i = 0; i < state.colorCount && i < max; i++)
     {
         elements[i] = state.colorElements[i];
-        colors[i] = state.colorRgb[i];
+        colors[i] = sg_rehue_color(tf, state.colorRgb[i]);
     }
     return i;
 }
@@ -1005,6 +1178,10 @@
             }
             if (setMetrics) 
             {
+                int i;
+
+                for (i = 0; i < colorState.colorCount; i++)
+                    colorState.colorRgb[i] = sg_rehue_color(tf, colorState.colorRgb[i]);
                 parse_apply_color (&colorState);
 		parse_apply_nonclient (&nonClientState);
 	    }
@@ -1373,6 +1550,7 @@
     /* Not found? Load from resources */
     img = malloc(sizeof(*img));
     img->image = LoadImageW(tc->hTheme, szFile, IMAGE_BITMAP, 0, 0, LR_CREATEDIBSECTION);
+    sg_rehue_bitmap(tc->tf, img->image);
     prepare_alpha (img->image, hasAlpha, &has_default);
     img->hasAlpha = *hasAlpha;
     img->hasDefaultTransparentColour = has_default;
@@ -1479,7 +1657,7 @@
         TRACE("Could not parse color property\n");
         return E_PROP_ID_UNSUPPORTED;
     }
-    *pColor = RGB(red,green,blue);
+    *pColor = sg_rehue_color(tfActiveTheme, RGB(red,green,blue));
     return S_OK;
 }
 
