From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] setupapi: device property errors and deletion, interface lists by device id (2051)

setupapi: device registry property errors and deletion, interface class lists by device id.

SetupDiGetDeviceRegistryProperty and SetupDiSetDeviceRegistryProperty (A and
W) report ERROR_INVALID_REG_PROPERTY for a property they do not know.
Setting a property with no data deletes it (and fails when it is not there),
so a later read fails with ERROR_INVALID_DATA. SetupDiGetClassDevs with
DIGCF_DEVICEINTERFACE takes an enumerator string only as the id of one device
(enumerator\device\instance), else ERROR_INVALID_DATA.
---
--- a/dlls/setupapi/devinst.c
+++ b/dlls/setupapi/devinst.c
@@ -838,13 +838,28 @@
 {
     if (prop < ARRAY_SIZE(PropertyMap) && PropertyMap[prop].nameW)
     {
-        LONG ret = RegSetValueExW(device->key, PropertyMap[prop].nameW, 0,
-                PropertyMap[prop].regType, buffer, size);
+        LONG ret;
+
+        /* no data deletes the property, which has to be there */
+        if (!buffer && !size)
+        {
+#ifdef SG_MUTANT_DEVPROP_DELETE
+            ret = RegSetValueExW(device->key, PropertyMap[prop].nameW, 0, PropertyMap[prop].regType, buffer, size);
+#else
+            ret = RegDeleteValueW(device->key, PropertyMap[prop].nameW);
+            if (ret == ERROR_FILE_NOT_FOUND) ret = ERROR_INVALID_DATA;
+#endif
+        }
+        else
+            ret = RegSetValueExW(device->key, PropertyMap[prop].nameW, 0,
+                    PropertyMap[prop].regType, buffer, size);
         if (!ret)
             return TRUE;
 
         SetLastError(ret);
+        return FALSE;
     }
+    SetLastError(ERROR_INVALID_REG_PROPERTY);
     return FALSE;
 }
 
@@ -2847,6 +2862,24 @@
     if (flags & DIGCF_ALLCLASSES)
         class = NULL;
 
+    /* for interfaces the enumerator string is the id of one device: enumerator\\device\\instance */
+    if ((flags & DIGCF_DEVICEINTERFACE) && enumstr && *enumstr)
+    {
+        unsigned int parts = 1;
+        PCWSTR p;
+
+        for (p = enumstr; *p; p++)
+            if (*p == '\\') parts++;
+#ifdef SG_MUTANT_GETCLASSDEVS_ID
+        parts = 3;
+#endif
+        if (parts != 3)
+        {
+            SetLastError(ERROR_INVALID_DATA);
+            return INVALID_HANDLE_VALUE;
+        }
+    }
+
     if (flags & unsupportedFlags)
         WARN("unsupported flags %08lx\n", flags & unsupportedFlags);
     if (deviceset)
@@ -3359,6 +3392,8 @@
         if (RequiredSize)
             *RequiredSize = size;
     }
+    else
+        SetLastError(ERROR_INVALID_REG_PROPERTY);
     return ret;
 }
 
@@ -3401,6 +3436,10 @@
         if (RequiredSize)
             *RequiredSize = size;
     }
+#ifndef SG_MUTANT_DEVPROP_INVALID
+    else
+        SetLastError(ERROR_INVALID_REG_PROPERTY);
+#endif
     return ret;
 }
 
@@ -3421,14 +3460,25 @@
 
     if (Property < ARRAY_SIZE(PropertyMap) && PropertyMap[Property].nameA)
     {
-        LONG l = RegSetValueExA(device->key, PropertyMap[Property].nameA, 0,
-                PropertyMap[Property].regType, PropertyBuffer,
-                PropertyBufferSize);
+        LONG l;
+
+        /* no data deletes the property, which has to be there */
+        if (!PropertyBuffer && !PropertyBufferSize)
+        {
+            l = RegDeleteValueA(device->key, PropertyMap[Property].nameA);
+            if (l == ERROR_FILE_NOT_FOUND) l = ERROR_INVALID_DATA;
+        }
+        else
+            l = RegSetValueExA(device->key, PropertyMap[Property].nameA, 0,
+                    PropertyMap[Property].regType, PropertyBuffer,
+                    PropertyBufferSize);
         if (!l)
             ret = TRUE;
         else
             SetLastError(l);
     }
+    else
+        SetLastError(ERROR_INVALID_REG_PROPERTY);
     return ret;
 }
 
