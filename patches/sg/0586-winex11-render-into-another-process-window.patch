From: Stained Glass OS <ke7oxh@gmail.com>
Subject: winex11: a process renders into another process's window with Vulkan

Chromium's GPU process (Chrome, Edge, Electron and CEF programs, Steam)
renders into the browser process's window. winex11 made a Vulkan surface
only for its own windows ("Failed to allocate client window"), so the
swap chain failed and Chrome showed "Compositing: Software only" -- no
GPU in the web (David: proper sandbox and GPU in the web). Another
process's top-level now gets a client X window inside its X window, over
its client area; another process's child window an offscreen X window of
its client size, whose frames are copied into its top-level at its client
offset. Chrome's chrome://gpu then shows hardware compositing, WebGL and
WebGPU (QA VM, lavapipe and DXVK).

Gate: make test-xproc-vk (whether the swap chain is made; Xvfb shows no
Vulkan surface, so the drawing itself was verified on the QA VM).
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -2079,7 +2079,59 @@
     {
         /* explicitly create data for HWND_MESSAGE windows since they can be used for OpenGL */
         HWND parent = NtUserGetAncestor( hwnd, GA_PARENT );
-        if (parent == NtUserGetDesktopWindow() || NtUserGetAncestor( parent, GA_PARENT )) return 0;
+        if (parent == NtUserGetDesktopWindow())
+        {
+            /* Stained Glass OS: another process's top-level window (Chromium's
+             * GPU process renders into the browser's): the client window goes
+             * inside its X window, over its client area */
+            Window whole = X11DRV_get_whole_window( hwnd );
+            RECT window_rect;
+            POINT origin = { 0, 0 };
+            UINT dpi = NtUserGetWinMonitorDpi( hwnd, MDT_RAW_DPI );
+
+            if (!whole || !NtUserGetWindowRect( hwnd, &window_rect, dpi )) return 0;
+            NtUserMapWindowPoints( hwnd, 0, &origin, 1, dpi );
+            NtUserGetClientRect( hwnd, &client_rect, NtUserGetDpiForWindow( hwnd ) );
+            cx = min( max( 1, client_rect.right - client_rect.left ), 65535 );
+            cy = min( max( 1, client_rect.bottom - client_rect.top ), 65535 );
+            attr.colormap = colormap;
+            attr.bit_gravity = NorthWestGravity;
+            attr.win_gravity = NorthWestGravity;
+            attr.backing_store = NotUseful;
+            attr.border_pixel = 0;
+            XSync( gdi_display, False );
+            ret = XCreateWindow( gdi_display, whole, origin.x - window_rect.left, origin.y - window_rect.top,
+                                 cx, cy, 0, default_visual.depth, InputOutput, visual->visual,
+                                 CWBitGravity | CWWinGravity | CWBackingStore | CWColormap | CWBorderPixel, &attr );
+            if (ret) XMapWindow( gdi_display, ret );
+            TRACE( "%p: client window %lx in another process's window %lx\n", hwnd, ret, whole );
+            return ret;
+        }
+        if (NtUserGetAncestor( parent, GA_PARENT ))
+        {
+            /* Stained Glass OS: a child window this thread keeps no data for
+             * -- another process's: Chromium's GPU process (Chrome, Edge,
+             * Electron and CEF programs, Steam) renders into the browser's
+             * child window. It had no surface at all ("Failed to allocate
+             * client window"), and they fell back to software compositing. A
+             * child window is always rendered offscreen and each frame copied
+             * into its top-level (vulkan_surface_presented), so an offscreen
+             * X window of its client size is all it needs. */
+            NtUserGetClientRect( hwnd, &client_rect, NtUserGetDpiForWindow( hwnd ) );
+            cx = min( max( 1, client_rect.right - client_rect.left ), 65535 );
+            cy = min( max( 1, client_rect.bottom - client_rect.top ), 65535 );
+            attr.colormap = colormap;
+            attr.bit_gravity = NorthWestGravity;
+            attr.win_gravity = NorthWestGravity;
+            attr.backing_store = NotUseful;
+            attr.border_pixel = 0;
+            ret = XCreateWindow( gdi_display, dummy_parent, 0, 0, cx, cy, 0, default_visual.depth, InputOutput,
+                                 visual->visual, CWBitGravity | CWWinGravity | CWBackingStore | CWColormap |
+                                 CWBorderPixel, &attr );
+            if (ret) XMapWindow( gdi_display, ret );
+            TRACE( "%p: offscreen client window %lx for a window of another thread\n", hwnd, ret );
+            return ret;
+        }
         if (!(data = alloc_win_data( thread_init_display(), hwnd ))) return 0;
         NtUserGetClientRect( hwnd, &data->rects.client, NtUserGetWinMonitorDpi( hwnd, MDT_RAW_DPI ) );
         data->rects.window = data->rects.visible = data->rects.client;
