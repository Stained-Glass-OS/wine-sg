From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] quartz: filter mapper enumerator Skip and Clone

quartz's filter mapper enumerators: IEnumRegFilters::Skip and
IEnumMoniker::Skip move the position and return S_FALSE when they run
past the end (the position then sits at the end); Clone of both returns
an independent enumerator at the same position (the moniker clone holds
references of its own), E_POINTER for a NULL output.
FilterMapper RegisterFilterInstance / UnregisterFilterInstance stay
E_NOTIMPL, which is the documented answer of the mapper.

---
diff --git a/dlls/quartz/filtermapper.c b/dlls/quartz/filtermapper.c
index 87d7c4b..2707378 100644
--- a/dlls/quartz/filtermapper.c
+++ b/dlls/quartz/filtermapper.c
@@ -129,8 +129,20 @@ static HRESULT WINAPI enum_reg_filters_Next(IEnumRegFilters *iface, ULONG count,
 
 static HRESULT WINAPI enum_reg_filters_Skip(IEnumRegFilters *iface, ULONG count)
 {
-    TRACE("iface %p, count %lu, unimplemented.\n", iface, count);
-    return E_NOTIMPL;
+    struct enum_reg_filters *enumerator = impl_from_IEnumRegFilters(iface);
+
+    TRACE("iface %p, count %lu.\n", iface, count);
+
+#ifndef SG_MUTANT_FM_SKIP
+    if (count > enumerator->count - enumerator->index)
+    {
+        enumerator->index = enumerator->count;
+        return S_FALSE;
+    }
+#endif
+
+    enumerator->index += count;
+    return S_OK;
 }
 
 static HRESULT WINAPI enum_reg_filters_Reset(IEnumRegFilters *iface)
@@ -143,10 +155,21 @@ static HRESULT WINAPI enum_reg_filters_Reset(IEnumRegFilters *iface)
     return S_OK;
 }
 
+static HRESULT enum_reg_filters_create(REGFILTER *filters, unsigned int count, IEnumRegFilters **out);
+
 static HRESULT WINAPI enum_reg_filters_Clone(IEnumRegFilters *iface, IEnumRegFilters **out)
 {
-    TRACE("iface %p, out %p, unimplemented.\n", iface, out);
-    return E_NOTIMPL;
+    struct enum_reg_filters *enumerator = impl_from_IEnumRegFilters(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return E_POINTER;
+
+    if (SUCCEEDED(hr = enum_reg_filters_create(enumerator->filters, enumerator->count, out)))
+        impl_from_IEnumRegFilters(*out)->index = enumerator->index;
+    return hr;
 }
 
 static const IEnumRegFiltersVtbl enum_reg_filters_vtbl =
@@ -276,6 +299,12 @@ static HRESULT WINAPI enum_moniker_Skip(IEnumMoniker *iface, ULONG count)
 
     TRACE("iface %p, count %lu.\n", iface, count);
 
+    if (count > enumerator->count - enumerator->index)
+    {
+        enumerator->index = enumerator->count;
+        return S_FALSE;
+    }
+
     enumerator->index += count;
     return S_OK;
 }
@@ -290,10 +319,34 @@ static HRESULT WINAPI enum_moniker_Reset(IEnumMoniker *iface)
     return S_OK;
 }
 
+static HRESULT enum_moniker_create(IMoniker **filters, unsigned int count, IEnumMoniker **out);
+
 static HRESULT WINAPI enum_moniker_Clone(IEnumMoniker *iface, IEnumMoniker **out)
 {
-    TRACE("iface %p, out %p, unimplemented.\n", iface, out);
-    return E_NOTIMPL;
+    struct enum_moniker *enumerator = impl_from_IEnumMoniker(iface);
+    unsigned int i;
+    HRESULT hr;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return E_POINTER;
+
+    /* The clone owns references of its own. */
+    for (i = 0; i < enumerator->count; ++i)
+        IMoniker_AddRef(enumerator->filters[i]);
+
+    if (FAILED(hr = enum_moniker_create(enumerator->filters, enumerator->count, out)))
+    {
+        for (i = 0; i < enumerator->count; ++i)
+            IMoniker_Release(enumerator->filters[i]);
+        return hr;
+    }
+
+#ifndef SG_MUTANT_FM_CLONE
+    impl_from_IEnumMoniker(*out)->index = enumerator->index;
+#endif
+    return S_OK;
 }
 
 static const IEnumMonikerVtbl enum_moniker_vtbl =
