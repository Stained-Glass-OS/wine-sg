From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msdasql: IColumnsRowset::GetColumnsRowset

A columns rowset over the rowset's column information: the mandatory columns (DBCOLUMN_IDNAME ... DBCOLUMN_FLAGS) and the optional ones asked for (DBCOLUMN_BASECOLUMNNAME and DBCOLUMN_BASETABLENAME from the driver's SQL_DESC_BASE_COLUMN_NAME / SQL_DESC_BASE_TABLE_NAME, DBCOLUMN_KEYCOLUMN), one row per column, in memory (it restarts). It was E_NOTIMPL.
---
--- a/dlls/msdasql/session.c
+++ b/dlls/msdasql/session.c
@@ -838,6 +838,7 @@
     SQLSMALLINT *sqltypes;
     BOOL *unsigned_cols;
     const struct schema_desc *schema; /* Stained Glass OS: a schema rowset (OLE DB columns of an ODBC catalog call) */
+    struct colrs *colrs;              /* (wine-sg 8221) a columns rowset: the column metadata of another rowset */
 };
 
 /* Stained Glass OS: the columns of an OLE DB schema rowset and the ODBC catalog
@@ -861,6 +862,11 @@
 };
 
 static HRESULT schema_fetch_row( void *ctx, struct cell *cells, DBORDINAL ncols );
+static HRESULT colrs_fetch_row( void *ctx, struct cell *cells, DBORDINAL ncols );
+static HRESULT colrs_restart( void *ctx );
+static HRESULT colrs_column_info( const struct colrs *colrs, DBORDINAL *columns, DBCOLUMNINFO **colinfo,
+                                  OLECHAR **strings );
+static void colrs_free( struct colrs *colrs );
 static HRESULT schema_column_info( const struct schema_desc *desc, DBORDINAL *columns, DBCOLUMNINFO **colinfo,
                                    OLECHAR **strings );
 
@@ -968,6 +974,7 @@
         rt_free(&rowset->table);
         free(rowset->sqltypes);
         free(rowset->unsigned_cols);
+        colrs_free(rowset->colrs);
         free(rowset);
     }
     return refs;
@@ -1139,8 +1146,8 @@
 
     TRACE("%p, %Id, %Id, %Id, %p, %p\n", rowset, reserved, offset, count, obtained, rows);
 
-    return rt_get_next_rows(&rowset->table, rowset->schema ? schema_fetch_row : stmt_fetch_row, rowset, reserved,
-                            offset, count, obtained, rows);
+    return rt_get_next_rows(&rowset->table, rowset->colrs ? colrs_fetch_row : rowset->schema ? schema_fetch_row
+                            : stmt_fetch_row, rowset, reserved, offset, count, obtained, rows);
 }
 
 static HRESULT WINAPI msdasql_rowset_ReleaseRows(IRowset *iface, DBCOUNTITEM count,
@@ -1160,8 +1167,9 @@
     TRACE("%p, %Id\n", rowset, reserved);
 
     if (reserved) return DB_E_BADCHAPTER;
-    /* the cursor is forward only: restarting is only possible before the first fetch */
-    return rt_restart(&rowset->table, NULL, NULL);
+    /* the cursor is forward only: restarting is only possible before the first fetch (a columns rowset is in
+     * memory and restarts) */
+    return rt_restart(&rowset->table, rowset->colrs ? colrs_restart : NULL, rowset);
 }
 
 static const struct IRowsetVtbl msdasql_rowset_vtbl =
@@ -1428,6 +1436,11 @@
 
     TRACE("%p, %p, %p, %p\n", rowset, columns, colinfo, stringsbuffer);
 
+    if (rowset->colrs)
+    {
+        if (!columns || !colinfo || !stringsbuffer) return E_INVALIDARG;
+        return colrs_column_info(rowset->colrs, columns, colinfo, stringsbuffer);
+    }
     if (rowset->schema)
     {
         if (!columns || !colinfo || !stringsbuffer) return E_INVALIDARG;
@@ -1443,14 +1456,15 @@
 
     TRACE("%p, %Id, %p, %p\n", rowset, column_ids, dbids, columns);
 
-    if (rowset->schema)
+    if (rowset->schema || rowset->colrs)
     {
         DBCOLUMNINFO *info;
         DBORDINAL ncols;
         OLECHAR *strings;
         HRESULT hr;
 
-        if (FAILED(hr = schema_column_info(rowset->schema, &ncols, &info, &strings))) return hr;
+        if (FAILED(hr = rowset->colrs ? colrs_column_info(rowset->colrs, &ncols, &info, &strings)
+                                      : schema_column_info(rowset->schema, &ncols, &info, &strings))) return hr;
         hr = rt_map_column_ids(column_ids, dbids, ncols, info, columns);
         CoTaskMemFree(info);
         CoTaskMemFree(strings);
@@ -1577,6 +1591,325 @@
     return S_OK;
 }
 
+static HRESULT create_stmt_rowset( IUnknown *caller, SQLHSTMT hstmt, const struct schema_desc *schema,
+                                   REFIID riid, IUnknown **out );
+
+#ifndef SG_MUTANT_NO_COLUMNS_ROWSET
+/* Stained Glass OS (wine-sg 8221): IColumnsRowset::GetColumnsRowset -- one row per column of this rowset, the
+ * mandatory columns-rowset columns, then the optional ones asked for (base column and table names from the
+ * ODBC driver; the key column is not known: NULL) */
+enum colrs_col { CR_IDNAME, CR_GUID, CR_PROPID, CR_NAME, CR_NUMBER, CR_TYPE, CR_TYPEINFO, CR_COLUMNSIZE,
+                 CR_PRECISION, CR_SCALE, CR_FLAGS, CR_BASECOLUMNNAME, CR_BASETABLENAME, CR_KEYCOLUMN, CR_COUNT };
+
+static const struct { const WCHAR *name; DBTYPE type; const DBID *id; } colrs_cols[CR_COUNT] =
+{
+    { L"DBCOLUMN_IDNAME", DBTYPE_WSTR, &DBCOLUMN_IDNAME },
+    { L"DBCOLUMN_GUID", DBTYPE_GUID, &DBCOLUMN_GUID },
+    { L"DBCOLUMN_PROPID", DBTYPE_UI4, &DBCOLUMN_PROPID },
+    { L"DBCOLUMN_NAME", DBTYPE_WSTR, &DBCOLUMN_NAME },
+    { L"DBCOLUMN_NUMBER", DBTYPE_UI4, &DBCOLUMN_NUMBER },
+    { L"DBCOLUMN_TYPE", DBTYPE_UI2, &DBCOLUMN_TYPE },
+    { L"DBCOLUMN_TYPEINFO", DBTYPE_IUNKNOWN, &DBCOLUMN_TYPEINFO },
+    { L"DBCOLUMN_COLUMNSIZE", DBTYPE_UI4, &DBCOLUMN_COLUMNSIZE },
+    { L"DBCOLUMN_PRECISION", DBTYPE_UI2, &DBCOLUMN_PRECISION },
+    { L"DBCOLUMN_SCALE", DBTYPE_I2, &DBCOLUMN_SCALE },
+    { L"DBCOLUMN_FLAGS", DBTYPE_UI4, &DBCOLUMN_FLAGS },
+    { L"DBCOLUMN_BASECOLUMNNAME", DBTYPE_WSTR, &DBCOLUMN_BASECOLUMNNAME },
+    { L"DBCOLUMN_BASETABLENAME", DBTYPE_WSTR, &DBCOLUMN_BASETABLENAME },
+    { L"DBCOLUMN_KEYCOLUMN", DBTYPE_BOOL, &DBCOLUMN_KEYCOLUMN },
+};
+#define CR_MANDATORY CR_BASECOLUMNNAME
+
+struct colrs_row
+{
+    DBCOLUMNINFO info;          /* its strings in names */
+    WCHAR *name, *idname, *base_column, *base_table;
+};
+
+struct colrs
+{
+    struct colrs_row *rows;
+    DBORDINAL nrows, next;
+    DBORDINAL ncols;
+    enum colrs_col cols[CR_COUNT];
+};
+
+static void colrs_free( struct colrs *colrs )
+{
+    DBORDINAL i;
+
+    if (!colrs) return;
+    for (i = 0; i < colrs->nrows; i++)
+    {
+        free( colrs->rows[i].name );
+        free( colrs->rows[i].idname );
+        free( colrs->rows[i].base_column );
+        free( colrs->rows[i].base_table );
+    }
+    free( colrs->rows );
+    free( colrs );
+}
+
+static HRESULT colrs_restart( void *ctx )
+{
+    struct msdasql_rowset *rowset = ctx;
+    rowset->colrs->next = 0;
+    return S_OK;
+}
+
+static void *cell_value( struct cell *cell, DBTYPE type, const void *data, DBLENGTH len )
+{
+    void *buf = calloc( 1, len + sizeof(WCHAR) );
+    if (!buf) return NULL;
+    memcpy( buf, data, len );
+    cell->type = type;
+    cell->len = len;
+    cell->data = buf;
+    cell->status = DBSTATUS_S_OK;
+    return buf;
+}
+
+static HRESULT colrs_fetch_row( void *ctx, struct cell *cells, DBORDINAL ncols )
+{
+    struct msdasql_rowset *rowset = ctx;
+    struct colrs *colrs = rowset->colrs;
+    struct colrs_row *row;
+    DBORDINAL i;
+
+    if (colrs->next >= colrs->nrows) return DB_S_ENDOFROWSET;
+    row = &colrs->rows[colrs->next++];
+    for (i = 0; i < ncols && i < colrs->ncols; i++)
+    {
+        const DBCOLUMNINFO *info = &row->info;
+        const DBID *id = &info->columnid;
+        enum colrs_col col = colrs->cols[i];
+        BOOL ok = TRUE;
+        ULONG u4;
+        USHORT u2;
+        SHORT i2;
+        VARIANT_BOOL b;
+
+        cells[i].status = DBSTATUS_S_ISNULL;
+        cells[i].type = colrs_cols[col].type;
+        cells[i].len = 0;
+        cells[i].data = NULL;
+        switch (col)
+        {
+        case CR_IDNAME:
+            if (row->idname) ok = !!cell_value( &cells[i], DBTYPE_WSTR, row->idname, wcslen( row->idname ) * sizeof(WCHAR) );
+            break;
+        case CR_GUID:
+            if (id->eKind == DBKIND_GUID_NAME || id->eKind == DBKIND_GUID_PROPID || id->eKind == DBKIND_GUID)
+                ok = !!cell_value( &cells[i], DBTYPE_GUID, &id->uGuid.guid, sizeof(GUID) );
+            break;
+        case CR_PROPID:
+            if (id->eKind == DBKIND_GUID_PROPID || id->eKind == DBKIND_PGUID_PROPID || id->eKind == DBKIND_PROPID)
+            {
+                u4 = id->uName.ulPropid;
+                ok = !!cell_value( &cells[i], DBTYPE_UI4, &u4, 4 );
+            }
+            break;
+        case CR_NAME:
+            if (row->name) ok = !!cell_value( &cells[i], DBTYPE_WSTR, row->name, wcslen( row->name ) * sizeof(WCHAR) );
+            break;
+        case CR_NUMBER:
+            u4 = info->iOrdinal;
+            ok = !!cell_value( &cells[i], DBTYPE_UI4, &u4, 4 );
+            break;
+        case CR_TYPE:
+            u2 = info->wType;
+            ok = !!cell_value( &cells[i], DBTYPE_UI2, &u2, 2 );
+            break;
+        case CR_COLUMNSIZE:
+            u4 = info->ulColumnSize;
+            ok = !!cell_value( &cells[i], DBTYPE_UI4, &u4, 4 );
+            break;
+        case CR_PRECISION:
+            if (info->bPrecision != (BYTE)~0)
+            {
+                u2 = info->bPrecision;
+                ok = !!cell_value( &cells[i], DBTYPE_UI2, &u2, 2 );
+            }
+            break;
+        case CR_SCALE:
+            if (info->bScale != (BYTE)~0)
+            {
+                i2 = info->bScale;
+                ok = !!cell_value( &cells[i], DBTYPE_I2, &i2, 2 );
+            }
+            break;
+        case CR_FLAGS:
+            u4 = info->dwFlags;
+            ok = !!cell_value( &cells[i], DBTYPE_UI4, &u4, 4 );
+            break;
+        case CR_BASECOLUMNNAME:
+            if (row->base_column && *row->base_column)
+                ok = !!cell_value( &cells[i], DBTYPE_WSTR, row->base_column, wcslen( row->base_column ) * sizeof(WCHAR) );
+            break;
+        case CR_BASETABLENAME:
+            if (row->base_table && *row->base_table)
+                ok = !!cell_value( &cells[i], DBTYPE_WSTR, row->base_table, wcslen( row->base_table ) * sizeof(WCHAR) );
+            break;
+        case CR_KEYCOLUMN:
+            if (info->dwFlags & DBCOLUMNFLAGS_ISROWID)
+            {
+                b = VARIANT_TRUE;
+                ok = !!cell_value( &cells[i], DBTYPE_BOOL, &b, 2 );
+            }
+            break;
+        default:  /* DBCOLUMN_TYPEINFO: always NULL */
+            break;
+        }
+        if (!ok) return E_OUTOFMEMORY;
+    }
+    return S_OK;
+}
+
+static HRESULT colrs_column_info( const struct colrs *colrs, DBORDINAL *columns, DBCOLUMNINFO **colinfo,
+                                  OLECHAR **strings )
+{
+    DBCOLUMNINFO *info;
+    OLECHAR *ptr;
+    size_t size = 0;
+    DBORDINAL i;
+
+    for (i = 0; i < colrs->ncols; i++) size += wcslen( colrs_cols[colrs->cols[i]].name ) + 1;
+    if (!(info = CoTaskMemAlloc( colrs->ncols * sizeof(*info) ))) return E_OUTOFMEMORY;
+    if (!(ptr = *strings = CoTaskMemAlloc( size * sizeof(WCHAR) )))
+    {
+        CoTaskMemFree( info );
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < colrs->ncols; i++)
+    {
+        enum colrs_col col = colrs->cols[i];
+
+        memset( &info[i], 0, sizeof(info[i]) );
+        wcscpy( ptr, colrs_cols[col].name );
+        info[i].pwszName = ptr;
+        ptr += wcslen( ptr ) + 1;
+        info[i].iOrdinal = i + 1;
+        info[i].dwFlags = col == CR_NUMBER || col == CR_TYPE || col == CR_FLAGS || col == CR_COLUMNSIZE ? 0
+                          : DBCOLUMNFLAGS_ISNULLABLE | DBCOLUMNFLAGS_MAYBENULL;
+        info[i].wType = colrs_cols[col].type;
+        switch (colrs_cols[col].type)
+        {
+        case DBTYPE_WSTR: info[i].ulColumnSize = 128; break;
+        case DBTYPE_GUID: info[i].ulColumnSize = sizeof(GUID); break;
+        case DBTYPE_IUNKNOWN: info[i].ulColumnSize = sizeof(IUnknown *); break;
+        case DBTYPE_BOOL: case DBTYPE_I2: case DBTYPE_UI2: info[i].ulColumnSize = 2; break;
+        default: info[i].ulColumnSize = 4; break;
+        }
+        info[i].bPrecision = ~0;
+        info[i].bScale = ~0;
+        info[i].columnid = *colrs_cols[col].id;
+    }
+    *columns = colrs->ncols;
+    *colinfo = info;
+    return S_OK;
+}
+
+static WCHAR *colrs_attribute( SQLHSTMT hstmt, SQLUSMALLINT column, SQLUSMALLINT field )
+{
+    WCHAR text[256];
+    SQLSMALLINT len = 0;
+
+    if (!hstmt || !column || !SQL_SUCCEEDED(SQLColAttributeW( hstmt, column, field, text, sizeof(text), &len, NULL )))
+        return NULL;
+    text[min( len / sizeof(WCHAR), ARRAY_SIZE(text) - 1 )] = 0;
+    return wcsdup( text );
+}
+
+static HRESULT WINAPI column_rs_GetColumnsRowset(IColumnsRowset *iface, IUnknown *outer, DBORDINAL count,
+        const DBID columns[], REFIID riid, ULONG property_cnt, DBPROPSET property_sets[], IUnknown **unk_rs)
+{
+    struct msdasql_rowset *rowset = impl_from_IColumnsRowset( iface );
+    struct msdasql_rowset *created;
+    DBCOLUMNINFO *info = NULL;
+    OLECHAR *strings = NULL;
+    struct colrs *colrs;
+    DBORDINAL ncols = 0, i, j;
+    IUnknown *unk = NULL;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p, %Id, %p, %s, %lu, %p, %p)\n", rowset, outer, count, columns, debugstr_guid(riid),
+          property_cnt, property_sets, unk_rs);
+
+    if (!unk_rs || (count && !columns)) return E_INVALIDARG;
+    *unk_rs = NULL;
+    if (outer && !IsEqualGUID( riid, &IID_IUnknown )) return DB_E_NOAGGREGATION;
+    if (outer) FIXME("aggregation not supported\n");
+
+    if (!(colrs = calloc( 1, sizeof(*colrs) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < CR_MANDATORY; i++) colrs->cols[colrs->ncols++] = i;
+    for (i = 0; i < count; i++)
+    {
+        for (j = CR_MANDATORY; j < CR_COUNT; j++)
+            if (!memcmp( &columns[i], colrs_cols[j].id, sizeof(DBID) )) break;
+        if (j == CR_COUNT)
+        {
+            colrs_free( colrs );
+            return DB_E_BADCOLUMNID;
+        }
+        if (colrs->ncols < CR_COUNT) colrs->cols[colrs->ncols++] = j;
+    }
+
+    hr = IColumnsInfo_GetColumnInfo( &rowset->IColumnsInfo_iface, &ncols, &info, &strings );
+    if (SUCCEEDED(hr) && ncols && !(colrs->rows = calloc( ncols, sizeof(*colrs->rows) ))) hr = E_OUTOFMEMORY;
+    for (i = 0; SUCCEEDED(hr) && i < ncols; i++)
+    {
+        struct colrs_row *row = &colrs->rows[colrs->nrows++];
+
+        row->info = info[i];
+        row->info.pwszName = NULL;
+        row->info.pTypeInfo = NULL;
+        if (info[i].pwszName && !(row->name = wcsdup( info[i].pwszName ))) hr = E_OUTOFMEMORY;
+        if (info[i].columnid.eKind == DBKIND_NAME || info[i].columnid.eKind == DBKIND_GUID_NAME)
+        {
+            if (info[i].columnid.uName.pwszName && !(row->idname = wcsdup( info[i].columnid.uName.pwszName )))
+                hr = E_OUTOFMEMORY;
+        }
+        row->info.columnid.uName.pwszName = NULL;
+        if (info[i].columnid.eKind == DBKIND_GUID_PROPID || info[i].columnid.eKind == DBKIND_PROPID)
+            row->info.columnid.uName.ulPropid = info[i].columnid.uName.ulPropid;
+        if (!rowset->schema)
+        {
+            row->base_column = colrs_attribute( rowset->hstmt, info[i].iOrdinal, SQL_DESC_BASE_COLUMN_NAME );
+            row->base_table = colrs_attribute( rowset->hstmt, info[i].iOrdinal, SQL_DESC_BASE_TABLE_NAME );
+        }
+    }
+    CoTaskMemFree( info );
+    CoTaskMemFree( strings );
+    if (FAILED(hr))
+    {
+        colrs_free( colrs );
+        return hr;
+    }
+
+    if (FAILED(hr = create_stmt_rowset( rowset->caller, SQL_NULL_HSTMT, NULL, &IID_IUnknown, &unk )))
+    {
+        colrs_free( colrs );
+        return hr;
+    }
+    created = impl_from_IRowset( (IRowset *)unk );
+    created->colrs = colrs;
+    rt_free( &created->table );
+    rt_init( &created->table, colrs->ncols );
+    free( created->sqltypes );
+    free( created->unsigned_cols );
+    created->sqltypes = calloc( colrs->ncols, sizeof(*created->sqltypes) );
+    created->unsigned_cols = calloc( colrs->ncols, sizeof(*created->unsigned_cols) );
+    hr = IUnknown_QueryInterface( unk, riid, (void **)unk_rs );
+    IUnknown_Release( unk );
+    return hr;
+}
+#else
+static void colrs_free( struct colrs *colrs ) { }
+static HRESULT colrs_fetch_row( void *ctx, struct cell *cells, DBORDINAL ncols ) { return DB_S_ENDOFROWSET; }
+static HRESULT colrs_restart( void *ctx ) { return S_OK; }
+static HRESULT colrs_column_info( const struct colrs *colrs, DBORDINAL *columns, DBCOLUMNINFO **colinfo,
+                                  OLECHAR **strings ) { return E_FAIL; }
+
 static HRESULT WINAPI column_rs_GetColumnsRowset(IColumnsRowset *iface, IUnknown *outer, DBORDINAL count,
         const DBID columns[], REFIID riid, ULONG property_cnt, DBPROPSET property_sets[], IUnknown **unk_rs)
 {
@@ -1585,6 +1918,7 @@
           property_cnt, property_sets, unk_rs);
     return E_NOTIMPL;
 }
+#endif
 
 struct IColumnsRowsetVtbl columnrs_rs_vtbl =
 {
