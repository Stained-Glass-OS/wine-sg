From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, wine.inf: the long path policy and RtlAreLongPathsEnabled

Paths longer than MAX_PATH work in Wine without the \\?\ prefix, but the machine
did not say so: no LongPathsEnabled policy value (MusicBrainz Picard: 'Failed reading
LongPathsEnabled from registry', and it keeps file names short to fit MAX_PATH) and
no ntdll!RtlAreLongPathsEnabled, which Windows 10 exports. wine.inf sets the policy
(HKLM\System\CurrentControlSet\Control\FileSystem LongPathsEnabled = 1, kept when
an administrator changed it) and RtlAreLongPathsEnabled answers by it (yes when no
policy value says otherwise). On Windows the policy also needs the program's manifest;
here long paths work for every program, so the policy is what is asked.

Gate: test/longpathpolicy-gate.sh; mutant SG_MUTANT_NO_LONG_PATHS.
---
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -873,6 +873,7 @@
 HKLM,Software\Registered Applications,,16
 HKLM,System\CurrentControlSet\Control\Filesystem,"NtfsDisable8dot3NameCreation",0x10003,0
 HKLM,System\CurrentControlSet\Control\Filesystem,"NtfsDisableLastAccessUpdate",0x10003,0x80000002
+HKLM,System\CurrentControlSet\Control\Filesystem,"LongPathsEnabled",0x10003,1
 HKLM,System\CurrentControlSet\Control\hivelist,,16
 HKLM,System\CurrentControlSet\Control\Lsa,"Security Packages",0x10002,kerberos,schannel
 HKLM,System\CurrentControlSet\Control\Lsa\Kerberos,,16
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -543,6 +543,7 @@
 @ stub RtlApplyRXactNoFlush
 @ stdcall RtlAreAllAccessesGranted(long long)
 @ stdcall RtlAreAnyAccessesGranted(long long)
+@ stdcall RtlAreLongPathsEnabled()
 @ stdcall RtlAreBitsClear(ptr long long)
 @ stdcall RtlAreBitsSet(ptr long long)
 # @ stub RtlAssert2
--- a/dlls/ntdll/path.c
+++ b/dlls/ntdll/path.c
@@ -876,6 +876,46 @@
 }
 
 
+/*************************************************************************
+ * RtlAreLongPathsEnabled    [NTDLL.@]
+ *
+ * Stained Glass OS (wine-sg 9755): whether paths longer than MAX_PATH work without the \\?\
+ * prefix. Windows says so when the machine's LongPathsEnabled policy is on (and the program's
+ * manifest asks for it); here they always work, so it is the policy as the machine keeps it
+ * (HKLM\System\CurrentControlSet\Control\FileSystem LongPathsEnabled, which wine.inf sets),
+ * and yes when no policy says otherwise.
+ */
+BOOLEAN WINAPI RtlAreLongPathsEnabled(void)
+{
+    static const WCHAR keyW[] = L"\\Registry\\Machine\\System\\CurrentControlSet\\Control\\FileSystem";
+    static LONG cached = -1;
+    char buffer[offsetof( KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(DWORD)] )];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    UNICODE_STRING name;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE key;
+    DWORD size;
+    LONG enabled = 1;
+
+#ifdef SG_MUTANT_NO_LONG_PATHS
+    return FALSE;
+#endif
+    if (cached != -1) return cached;
+    RtlInitUnicodeString( &name, keyW );
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (!NtOpenKey( &key, KEY_QUERY_VALUE, &attr ))
+    {
+        RtlInitUnicodeString( &name, L"LongPathsEnabled" );
+        if (!NtQueryValueKey( key, &name, KeyValuePartialInformation, buffer, sizeof(buffer), &size ) &&
+            info->Type == REG_DWORD && info->DataLength == sizeof(DWORD))
+            enabled = *(DWORD *)info->Data != 0;
+        NtClose( key );
+    }
+    InterlockedExchange( &cached, enabled );
+    return enabled;
+}
+
+
 /******************************************************************
  *             RtlDoesFileExists_U   (NTDLL.@)
  */
--- a/include/winternl.h
+++ b/include/winternl.h
@@ -4956,6 +4956,7 @@
 NTSYSAPI NTSTATUS  WINAPI RtlAppendUnicodeToString(UNICODE_STRING *,LPCWSTR);
 NTSYSAPI BOOLEAN   WINAPI RtlAreAllAccessesGranted(ACCESS_MASK,ACCESS_MASK);
 NTSYSAPI BOOLEAN   WINAPI RtlAreAnyAccessesGranted(ACCESS_MASK,ACCESS_MASK);
+NTSYSAPI BOOLEAN   WINAPI RtlAreLongPathsEnabled(void);
 NTSYSAPI BOOLEAN   WINAPI RtlAreBitsSet(PCRTL_BITMAP,ULONG,ULONG);
 NTSYSAPI BOOLEAN   WINAPI RtlAreBitsClear(PCRTL_BITMAP,ULONG,ULONG);
 NTSYSAPI NTSTATUS  WINAPI RtlCharToInteger(PCSZ,ULONG,PULONG);
