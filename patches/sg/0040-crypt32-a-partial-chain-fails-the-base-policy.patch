From: Stained Glass OS <dev@stained-glass.example>
Subject: crypt32: a partial chain fails the base and Authenticode policies

Security. verify_base_policy never looked at CERT_TRUST_IS_PARTIAL_CHAIN, so
a chain that stops short of any root -- a signer from an unknown issuer --
passed the base and Authenticode policies. Fail it with CERT_E_CHAINING, as
Windows does.

--- a/dlls/crypt32/chain.c
+++ b/dlls/crypt32/chain.c
@@ -3017,6 +3017,18 @@
         /* For a cyclic chain, which element is a cycle isn't meaningful */
         pPolicyStatus->lElementIndex = -1;
     }
+    /* A chain that stops short of any root says nothing about who signed:
+     * it fails, as on Windows. Without this, a signature from an unknown
+     * issuer verified as trusted under the base and Authenticode policies. */
+    if (!pPolicyStatus->dwError &&
+     pChainContext->TrustStatus.dwErrorStatus & CERT_TRUST_IS_PARTIAL_CHAIN)
+    {
+        pPolicyStatus->dwError = CERT_E_CHAINING;
+        find_element_with_error(pChainContext, CERT_TRUST_IS_PARTIAL_CHAIN,
+         &pPolicyStatus->lChainIndex, &pPolicyStatus->lElementIndex);
+        if (pPolicyStatus->lElementIndex == -1 && pPolicyStatus->lChainIndex == -1)
+            pPolicyStatus->lChainIndex = 0;
+    }
     if (!pPolicyStatus->dwError &&
      pChainContext->TrustStatus.dwErrorStatus & CERT_TRUST_IS_UNTRUSTED_ROOT &&
      !(checks & CERT_CHAIN_POLICY_ALLOW_UNKNOWN_CA_FLAG))
