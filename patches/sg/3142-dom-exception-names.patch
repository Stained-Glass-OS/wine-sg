From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 01:58:38 -0700
Subject: [PATCH] mshtml, jscript: DOM exceptions with name and code

IE10+ throws DOMException objects for DOM errors. The host reports them as
0x80700000 | code (the value IE uses, already seen for
NoModificationAllowedError); jscript turns such an error into an Error object
with name (InvalidStateError, NoModificationAllowedError, ...), code and the
number. map_nsresult maps the engine's DOM exception codes the same way and
XMLHttpRequest.responseType in a wrong state throws InvalidStateError.

Removes seven todo_wine marks in dom.js and xhr.js.

diff --git a/dlls/jscript/error.c b/dlls/jscript/error.c
index 8f4a5c8..c32b5b0 100644
--- a/dlls/jscript/error.c
+++ b/dlls/jscript/error.c
@@ -539,6 +539,46 @@ jsdisp_t *create_builtin_error(script_ctx_t *ctx)
         }
     }
 
+    /* DOM exceptions are reported by the host as 0x80700000 | code (as IE does) */
+#ifdef SG_MUTANT_JS_NODOMEX
+    if(0) {
+#else
+    if(((UINT)ei->error & 0xffff0000) == 0x80700000) {
+#endif
+        static const struct { unsigned code; const WCHAR *name; } dom_names[] = {
+            {1, L"IndexSizeError"}, {3, L"HierarchyRequestError"}, {4, L"WrongDocumentError"},
+            {5, L"InvalidCharacterError"}, {7, L"NoModificationAllowedError"}, {8, L"NotFoundError"},
+            {9, L"NotSupportedError"}, {11, L"InvalidStateError"}, {12, L"SyntaxError"},
+            {13, L"InvalidModificationError"}, {14, L"NamespaceError"}, {15, L"InvalidAccessError"},
+            {17, L"TypeMismatchError"}, {18, L"SecurityError"}, {19, L"NetworkError"}, {20, L"AbortError"},
+            {21, L"URLMismatchError"}, {22, L"QuotaExceededError"}, {23, L"TimeoutError"},
+            {24, L"InvalidNodeTypeError"}, {25, L"DataCloneError"}
+        };
+        unsigned i, code = (UINT)ei->error & 0xffff;
+
+        for(i = 0; i < ARRAY_SIZE(dom_names); i++)
+            if(dom_names[i].code == code)
+                break;
+        if(i < ARRAY_SIZE(dom_names)) {
+            jsstr_t *name = jsstr_alloc(dom_names[i].name);
+            if(!name)
+                return NULL;
+            hres = create_error(ctx, constr, ei->error, ei->message && jsstr_length(ei->message) ? ei->message : name, &r);
+            if(SUCCEEDED(hres)) {
+                hres = jsdisp_define_data_property(r, L"name", PROPF_WRITABLE | PROPF_CONFIGURABLE, jsval_string(name));
+                if(SUCCEEDED(hres))
+                    hres = jsdisp_define_data_property(r, L"code", PROPF_WRITABLE | PROPF_CONFIGURABLE,
+                                                       jsval_number(code));
+                if(FAILED(hres)) {
+                    jsdisp_release(r);
+                    r = NULL;
+                }
+            }
+            jsstr_release(name);
+            return SUCCEEDED(hres) ? r : NULL;
+        }
+    }
+
     hres = create_error(ctx, constr, ei->error, ei->message ? ei->message : jsstr_empty(), &r);
     return SUCCEEDED(hres) ? r : NULL;
 }
diff --git a/dlls/mshtml/nsembed.c b/dlls/mshtml/nsembed.c
index b06c08f..27ed0e6 100644
--- a/dlls/mshtml/nsembed.c
+++ b/dlls/mshtml/nsembed.c
@@ -920,6 +920,9 @@ HRESULT map_nsresult(nsresult nsres)
     case NS_BINDING_ABORTED:
         return E_ABORT;
     }
+    /* other DOM exceptions: 0x80700000 | code, which jscript turns into a DOMException */
+    if((nsres & 0xffff0000) == 0x80530000 && (nsres & 0xffff) > 0 && (nsres & 0xffff) < 26)
+        return 0x80700000 | (nsres & 0xffff);
     return E_FAIL;
 }
 
