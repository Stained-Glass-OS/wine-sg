+/* a language given, else the user's; a region given, else the language's */
+static HRESULT formatter_create( const WCHAR *language, HSTRING region, INumberFormatter **out )
+{
+    struct formatter *impl;
+    WCHAR geo[16];
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->INumberFormatter_iface.lpVtbl = &formatter_vtbl;
+    impl->INumberFormatter2_iface.lpVtbl = &formatter2_vtbl;
+    impl->INumberFormatterOptions_iface.lpVtbl = &options_vtbl;
+    impl->INumberParser_iface.lpVtbl = &parser_vtbl;
+    impl->INumberRounderOption_iface.lpVtbl = &rounder_option_vtbl;
+    impl->ISignedZeroOption_iface.lpVtbl = &signed_zero_vtbl;
+    impl->ISignificantDigitsOption_iface.lpVtbl = &significant_option_vtbl;
+    impl->ref = 1;
+    impl->integer_digits = 1;
+    if (language && *language) lstrcpynW( impl->language, language, ARRAY_SIZE(impl->language) );
+    else if (!GetUserDefaultLocaleName( impl->language, ARRAY_SIZE(impl->language) )) wcscpy( impl->language, L"en-US" );
+    if (WindowsGetStringLen( region )) hr = WindowsDuplicateString( region, &impl->region );
+    else
+    {
+        if (!GetLocaleInfoEx( impl->language, LOCALE_SISO3166CTRYNAME, geo, ARRAY_SIZE(geo) )) wcscpy( geo, L"US" );
+        hr = WindowsCreateString( geo, wcslen( geo ), &impl->region );
+    }
+    if (SUCCEEDED(hr)) hr = WindowsCreateString( L"Latn", 4, &impl->numeral_system );
+    if (FAILED(hr))
+    {
+        INumberFormatter_Release( &impl->INumberFormatter_iface );
+        return hr;
+    }
+    formatter_separators( impl );
+    *out = &impl->INumberFormatter_iface;
+    return S_OK;
+}
