+DEFINE_IINSPECTABLE_( decimal_factory, IDecimalFormatterFactory, struct number_factory, impl_from_IDecimalFormatterFactory,
+                      IDecimalFormatterFactory_iface, &impl->IActivationFactory_iface )
+
+/* the first language of the list */
+static HRESULT WINAPI decimal_factory_CreateDecimalFormatter( IDecimalFormatterFactory *iface, IIterable_HSTRING *languages,
+                                                              HSTRING region, INumberFormatter **result )
+{
+    IIterator_HSTRING *it = NULL;
+    HSTRING language = NULL;
+    boolean has = FALSE;
+    HRESULT hr;
+
+    TRACE( "iface %p, languages %p, region %s, result %p.\n", iface, languages, debugstr_hstring( region ), result );
+    if (!languages || !result) return E_POINTER;
+    if (FAILED(hr = IIterable_HSTRING_First( languages, &it ))) return hr;
+    if (SUCCEEDED(IIterator_HSTRING_get_HasCurrent( it, &has )) && has) IIterator_HSTRING_get_Current( it, &language );
+    IIterator_HSTRING_Release( it );
+    hr = formatter_create( WindowsGetStringRawBuffer( language, NULL ), region, result );
+    WindowsDeleteString( language );
+    return hr;
+}
+
+static const struct IDecimalFormatterFactoryVtbl decimal_factory_vtbl =
+{
+    decimal_factory_QueryInterface, decimal_factory_AddRef, decimal_factory_Release,
+    decimal_factory_GetIids, decimal_factory_GetRuntimeClassName, decimal_factory_GetTrustLevel,
+    decimal_factory_CreateDecimalFormatter,
+};
+
