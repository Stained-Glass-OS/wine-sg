+/*
+ * DecimalFormatter formats numbers with the decimal and grouping separators of its language
+ * (the user's when none is given): at least IntegerDigits integer digits and FractionDigits
+ * fraction digits, at least SignificantDigits significant ones, grouped when IsGrouped, through its
+ * NumberRounder first when it has one.  It parses what it formats (and plain numbers), giving null
+ * for text that is no number.  SignificantDigitsNumberRounder and IncrementNumberRounder round to
+ * a number of significant digits or to a multiple of an increment, by their RoundingAlgorithm
+ * (RoundHalfUp unless set).  WinUI 2's NumberBox makes both.
+ */
+
+#include <math.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include "private.h"
+#include "roapi.h"
+#include "initguid.h"
+#define WIDL_using_Windows_Globalization_NumberFormatting
+#include "windows.globalization.numberformatting.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(locale);
+
+/* ---- rounding ---- */
+
+static DOUBLE round_by( DOUBLE x, RoundingAlgorithm algorithm )
+{
+    DOUBLE f = floor( x ), frac = x - f;
+
+    switch (algorithm)
+    {
+    case RoundingAlgorithm_RoundDown: return f;
+    case RoundingAlgorithm_RoundUp: return ceil( x );
+    case RoundingAlgorithm_RoundTowardsZero: return trunc( x );
+    case RoundingAlgorithm_RoundAwayFromZero: return x < 0 ? floor( x ) : ceil( x );
+    case RoundingAlgorithm_RoundHalfDown: return frac > 0.5 ? f + 1 : f;
+    case RoundingAlgorithm_RoundHalfTowardsZero:
+        if (frac != 0.5) return floor( x + 0.5 );
+        return x < 0 ? f + 1 : f;
+    case RoundingAlgorithm_RoundHalfAwayFromZero:
+        if (frac != 0.5) return floor( x + 0.5 );
+        return x < 0 ? f : f + 1;
+    case RoundingAlgorithm_RoundHalfToEven:
+        if (frac != 0.5) return floor( x + 0.5 );
+        return fmod( f, 2 ) == 0 ? f : f + 1;
+    case RoundingAlgorithm_RoundHalfToOdd:
+        if (frac != 0.5) return floor( x + 0.5 );
+        return fmod( f, 2 ) != 0 ? f : f + 1;
+    case RoundingAlgorithm_RoundHalfUp:
+    default:
+        return frac >= 0.5 ? f + 1 : f;
+    }
+}
+
+struct rounder
+{
+    INumberRounder INumberRounder_iface;
+    ISignificantDigitsNumberRounder ISignificantDigitsNumberRounder_iface;
+    IIncrementNumberRounder IIncrementNumberRounder_iface;
+    LONG ref;
+    BOOL increment;                 /* an IncrementNumberRounder, else a significant digits one */
+    RoundingAlgorithm algorithm;
+    UINT32 digits;
+    DOUBLE step;
+};
+
+static DOUBLE rounder_round( struct rounder *impl, DOUBLE value )
+{
+    DOUBLE scale;
+    int exponent;
+
+    if (!isfinite( value ) || value == 0) return value;
+    if (impl->increment) return round_by( value / impl->step, impl->algorithm ) * impl->step;
+    if (!impl->digits) return value;
+    exponent = (int)floor( log10( fabs( value ) ) );
+    scale = pow( 10, (int)impl->digits - 1 - exponent );
+#ifdef SG_MUTANT_ROUNDER_TRUNCATES
+    return trunc( value * scale ) / scale;
+#endif
+    return round_by( value * scale, impl->algorithm ) / scale;
+}
+
+static inline struct rounder *impl_from_INumberRounder( INumberRounder *iface )
+{
+    return CONTAINING_RECORD( iface, struct rounder, INumberRounder_iface );
+}
+
+static HRESULT WINAPI rounder_QueryInterface( INumberRounder *iface, REFIID iid, void **out )
+{
+    struct rounder *impl = impl_from_INumberRounder( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_INumberRounder ))
+        *out = &impl->INumberRounder_iface;
+    else if (!impl->increment && IsEqualGUID( iid, &IID_ISignificantDigitsNumberRounder ))
+        *out = &impl->ISignificantDigitsNumberRounder_iface;
+    else if (impl->increment && IsEqualGUID( iid, &IID_IIncrementNumberRounder ))
+        *out = &impl->IIncrementNumberRounder_iface;
+    else
+    {
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI rounder_AddRef( INumberRounder *iface )
+{
+    return InterlockedIncrement( &impl_from_INumberRounder( iface )->ref );
+}
+
+static ULONG WINAPI rounder_Release( INumberRounder *iface )
+{
+    struct rounder *impl = impl_from_INumberRounder( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI rounder_GetIids( INumberRounder *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI rounder_GetRuntimeClassName( INumberRounder *iface, HSTRING *class_name )
+{
+    struct rounder *impl = impl_from_INumberRounder( iface );
+    const WCHAR *name = impl->increment ? RuntimeClass_Windows_Globalization_NumberFormatting_IncrementNumberRounder
+                                        : RuntimeClass_Windows_Globalization_NumberFormatting_SignificantDigitsNumberRounder;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI rounder_GetTrustLevel( INumberRounder *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI rounder_RoundInt32( INumberRounder *iface, INT32 value, INT32 *result )
+{
+    if (!result) return E_POINTER;
+    *result = (INT32)rounder_round( impl_from_INumberRounder( iface ), value );
+    return S_OK;
+}
+
+static HRESULT WINAPI rounder_RoundUInt32( INumberRounder *iface, UINT32 value, UINT32 *result )
+{
+    if (!result) return E_POINTER;
+    *result = (UINT32)rounder_round( impl_from_INumberRounder( iface ), value );
+    return S_OK;
+}
+
+static HRESULT WINAPI rounder_RoundInt64( INumberRounder *iface, INT64 value, INT64 *result )
+{
+    if (!result) return E_POINTER;
+    *result = (INT64)rounder_round( impl_from_INumberRounder( iface ), value );
+    return S_OK;
+}
+
+static HRESULT WINAPI rounder_RoundUInt64( INumberRounder *iface, UINT64 value, UINT64 *result )
+{
+    if (!result) return E_POINTER;
+    *result = (UINT64)rounder_round( impl_from_INumberRounder( iface ), value );
+    return S_OK;
+}
+
+static HRESULT WINAPI rounder_RoundSingle( INumberRounder *iface, FLOAT value, FLOAT *result )
+{
+    if (!result) return E_POINTER;
+    *result = (FLOAT)rounder_round( impl_from_INumberRounder( iface ), value );
+    return S_OK;
+}
+
+static HRESULT WINAPI rounder_RoundDouble( INumberRounder *iface, DOUBLE value, DOUBLE *result )
+{
+    if (!result) return E_POINTER;
+    *result = rounder_round( impl_from_INumberRounder( iface ), value );
+    return S_OK;
+}
+
+static const struct INumberRounderVtbl rounder_vtbl =
+{
+    rounder_QueryInterface, rounder_AddRef, rounder_Release,
+    rounder_GetIids, rounder_GetRuntimeClassName, rounder_GetTrustLevel,
+    rounder_RoundInt32, rounder_RoundUInt32, rounder_RoundInt64, rounder_RoundUInt64, rounder_RoundSingle, rounder_RoundDouble,
+};
+
+DEFINE_IINSPECTABLE_( significant, ISignificantDigitsNumberRounder, struct rounder, impl_from_ISignificantDigitsNumberRounder,
+                      ISignificantDigitsNumberRounder_iface, &impl->INumberRounder_iface )
+
+static HRESULT WINAPI significant_get_RoundingAlgorithm( ISignificantDigitsNumberRounder *iface, RoundingAlgorithm *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ISignificantDigitsNumberRounder( iface )->algorithm;
+    return S_OK;
+}
+
+static HRESULT WINAPI significant_put_RoundingAlgorithm( ISignificantDigitsNumberRounder *iface, RoundingAlgorithm value )
+{
+    if (value <= RoundingAlgorithm_None || value > RoundingAlgorithm_RoundHalfToOdd) return E_INVALIDARG;
+    impl_from_ISignificantDigitsNumberRounder( iface )->algorithm = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI significant_get_SignificantDigits( ISignificantDigitsNumberRounder *iface, UINT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ISignificantDigitsNumberRounder( iface )->digits;
+    return S_OK;
+}
+
+static HRESULT WINAPI significant_put_SignificantDigits( ISignificantDigitsNumberRounder *iface, UINT32 value )
+{
+    impl_from_ISignificantDigitsNumberRounder( iface )->digits = value;
+    return S_OK;
+}
+
+static const struct ISignificantDigitsNumberRounderVtbl significant_vtbl =
+{
+    significant_QueryInterface, significant_AddRef, significant_Release,
+    significant_GetIids, significant_GetRuntimeClassName, significant_GetTrustLevel,
+    significant_get_RoundingAlgorithm, significant_put_RoundingAlgorithm,
+    significant_get_SignificantDigits, significant_put_SignificantDigits,
+};
+
+DEFINE_IINSPECTABLE_( increment, IIncrementNumberRounder, struct rounder, impl_from_IIncrementNumberRounder,
+                      IIncrementNumberRounder_iface, &impl->INumberRounder_iface )
+
+static HRESULT WINAPI increment_get_RoundingAlgorithm( IIncrementNumberRounder *iface, RoundingAlgorithm *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_IIncrementNumberRounder( iface )->algorithm;
+    return S_OK;
+}
+
+static HRESULT WINAPI increment_put_RoundingAlgorithm( IIncrementNumberRounder *iface, RoundingAlgorithm value )
+{
+    if (value <= RoundingAlgorithm_None || value > RoundingAlgorithm_RoundHalfToOdd) return E_INVALIDARG;
+    impl_from_IIncrementNumberRounder( iface )->algorithm = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI increment_get_Increment( IIncrementNumberRounder *iface, DOUBLE *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_IIncrementNumberRounder( iface )->step;
+    return S_OK;
+}
+
+/* an increment of 10^n for n <= 0, or 1/k for a whole k: as the documentation allows */
+static HRESULT WINAPI increment_put_Increment( IIncrementNumberRounder *iface, DOUBLE value )
+{
+    if (!(value > 0) || value > 1) return E_INVALIDARG;
+    impl_from_IIncrementNumberRounder( iface )->step = value;
+    return S_OK;
+}
+
+static const struct IIncrementNumberRounderVtbl increment_vtbl =
+{
+    increment_QueryInterface, increment_AddRef, increment_Release,
+    increment_GetIids, increment_GetRuntimeClassName, increment_GetTrustLevel,
+    increment_get_RoundingAlgorithm, increment_put_RoundingAlgorithm, increment_get_Increment, increment_put_Increment,
+};
+
+static HRESULT rounder_create( BOOL increment, IInspectable **out )
+{
+    struct rounder *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->INumberRounder_iface.lpVtbl = &rounder_vtbl;
+    impl->ISignificantDigitsNumberRounder_iface.lpVtbl = &significant_vtbl;
+    impl->IIncrementNumberRounder_iface.lpVtbl = &increment_vtbl;
+    impl->ref = 1;
+    impl->increment = increment;
+    impl->algorithm = RoundingAlgorithm_RoundHalfUp;
+    impl->step = 1;
+    *out = (IInspectable *)&impl->INumberRounder_iface;
+    return S_OK;
+}
+
+/* ---- DecimalFormatter ---- */
+
+struct formatter
+{
+    INumberFormatter INumberFormatter_iface;
+    INumberFormatter2 INumberFormatter2_iface;
+    INumberFormatterOptions INumberFormatterOptions_iface;
+    INumberParser INumberParser_iface;
+    INumberRounderOption INumberRounderOption_iface;
+    ISignedZeroOption ISignedZeroOption_iface;
+    ISignificantDigitsOption ISignificantDigitsOption_iface;
+    LONG ref;
+    WCHAR language[LOCALE_NAME_MAX_LENGTH];
+    HSTRING region;
+    INT32 integer_digits, fraction_digits, significant_digits;
+    boolean grouped, point_always, zero_signed;
+    HSTRING numeral_system;
+    INumberRounder *rounder;
+    WCHAR decimal[8], group[8];
+};
+
+static void formatter_separators( struct formatter *impl )
+{
+    if (!GetLocaleInfoEx( impl->language, LOCALE_SDECIMAL, impl->decimal, ARRAY_SIZE(impl->decimal) ))
+        wcscpy( impl->decimal, L"." );
+    if (!GetLocaleInfoEx( impl->language, LOCALE_STHOUSAND, impl->group, ARRAY_SIZE(impl->group) ))
+        wcscpy( impl->group, L"," );
+#ifdef SG_MUTANT_FORMATTER_LOCALE_IGNORED
+    wcscpy( impl->decimal, L"." );
+    wcscpy( impl->group, L"," );
+#endif
+}
+
+/* the text of a number by the formatter's options */
+static HRESULT format_number( struct formatter *impl, DOUBLE value, BOOL integer, HSTRING *result )
+{
+    char digits[400], *point;
+    WCHAR out[512];
+    size_t int_len, frac_len, o = 0, i;
+    int fraction, sig_int, sig_frac;
+    BOOL negative;
+
+    if (!result) return E_POINTER;
+    if (impl->rounder) INumberRounder_RoundDouble( impl->rounder, value, &value );
+    if (isnan( value )) return WindowsCreateString( L"NaN", 3, result );
+    if (isinf( value )) return WindowsCreateString( value < 0 ? L"-\x221e" : L"\x221e", value < 0 ? 2 : 1, result );
+    negative = signbit( value ) && (value != 0 || impl->zero_signed);
+    value = fabs( value );
+    /* the digits it has (up to 15 significant ones), without an exponent */
+    if (integer) snprintf( digits, sizeof(digits), "%.0f", value );
+    else
+    {
+        int exponent = value ? (int)floor( log10( value ) ) : 0;
+        fraction = max( 0, 14 - exponent );
+        if (fraction > 300) fraction = 300;
+        snprintf( digits, sizeof(digits), "%.*f", fraction, value );
+        if ((point = strchr( digits, '.' )))
+        {
+            char *end = point + strlen( point ) - 1;
+            while (end > point && *end == '0') *end-- = 0;
+            if (end == point) *end = 0;
+        }
+    }
+    point = strchr( digits, '.' );
+    int_len = point ? (size_t)(point - digits) : strlen( digits );
+    frac_len = point ? strlen( point + 1 ) : 0;
+    if (int_len == 1 && digits[0] == '0') int_len = 0;   /* no integer digits of its own */
+    /* SignificantDigits: as many as asked, from the fraction */
+    sig_int = int_len;
+    sig_frac = 0;
+    if (impl->significant_digits > sig_int)
+    {
+        size_t lead = 0;
+        if (!int_len && point) while (point[1 + lead] == '0') lead++;
+        sig_frac = impl->significant_digits - sig_int + (int)lead;
+    }
+    if (negative) out[o++] = '-';
+    for (i = int_len; (INT32)i < impl->integer_digits && o < 64; i++) out[o++] = '0';
+    for (i = 0; i < int_len && o < 400; i++)
+    {
+        out[o++] = digits[i];
+        if (impl->grouped && (int_len - i - 1) && !((int_len - i - 1) % 3))
+        {
+            const WCHAR *g;
+            for (g = impl->group; *g && o < 400; g++) out[o++] = *g;
+        }
+    }
+    fraction = max( max( (int)frac_len, impl->fraction_digits ), sig_frac );
+    if (fraction || impl->point_always)
+    {
+        const WCHAR *d;
+        for (d = impl->decimal; *d; d++) out[o++] = *d;
+        for (i = 0; (int)i < fraction && o < 500; i++) out[o++] = i < frac_len ? point[1 + i] : '0';
+    }
+    if (!o || (o == 1 && negative)) out[o++] = '0';
+    return WindowsCreateString( out, o, result );
+}
+
+/* a number in text: optional sign, digits with the grouping separator, the decimal separator */
+static BOOL parse_number( struct formatter *impl, HSTRING text, BOOL integer, DOUBLE *value )
+{
+    const WCHAR *s = WindowsGetStringRawBuffer( text, NULL ), *g = impl->group, *d = impl->decimal;
+    char buf[400];
+    size_t o = 0, glen = wcslen( g ), dlen = wcslen( d );
+    BOOL digit = FALSE, point = FALSE;
+
+    while (*s == ' ' || *s == '\t') s++;
+    if (*s == '-' || *s == '+') buf[o++] = *s++;
+    for (; *s && o < sizeof(buf) - 2; )
+    {
+        if (*s >= '0' && *s <= '9') { buf[o++] = *s++; digit = TRUE; }
+        else if (!point && dlen && !wcsncmp( s, d, dlen )) { buf[o++] = '.'; s += dlen; point = TRUE; }
+        else if (!point && digit && glen && !wcsncmp( s, g, glen )) s += glen;
+        else break;
+    }
+    while (*s == ' ' || *s == '\t') s++;
+    if (*s || !digit || (integer && point)) return FALSE;
+    buf[o] = 0;
+    *value = strtod( buf, NULL );
+    return TRUE;
+}
+
+static inline struct formatter *impl_from_INumberFormatter( INumberFormatter *iface )
+{
+    return CONTAINING_RECORD( iface, struct formatter, INumberFormatter_iface );
+}
+
+static HRESULT WINAPI formatter_QueryInterface( INumberFormatter *iface, REFIID iid, void **out )
+{
+    struct formatter *impl = impl_from_INumberFormatter( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_INumberFormatter ))
+        *out = &impl->INumberFormatter_iface;
+    else if (IsEqualGUID( iid, &IID_INumberFormatter2 )) *out = &impl->INumberFormatter2_iface;
+    else if (IsEqualGUID( iid, &IID_INumberFormatterOptions )) *out = &impl->INumberFormatterOptions_iface;
+#ifndef SG_MUTANT_FORMATTER_NO_PARSER
+    else if (IsEqualGUID( iid, &IID_INumberParser )) *out = &impl->INumberParser_iface;
+#endif
+    else if (IsEqualGUID( iid, &IID_INumberRounderOption )) *out = &impl->INumberRounderOption_iface;
+    else if (IsEqualGUID( iid, &IID_ISignedZeroOption )) *out = &impl->ISignedZeroOption_iface;
+    else if (IsEqualGUID( iid, &IID_ISignificantDigitsOption )) *out = &impl->ISignificantDigitsOption_iface;
+    else
+    {
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI formatter_AddRef( INumberFormatter *iface )
+{
+    return InterlockedIncrement( &impl_from_INumberFormatter( iface )->ref );
+}
+
+static ULONG WINAPI formatter_Release( INumberFormatter *iface )
+{
+    struct formatter *impl = impl_from_INumberFormatter( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->region );
+        WindowsDeleteString( impl->numeral_system );
+        if (impl->rounder) INumberRounder_Release( impl->rounder );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI formatter_GetIids( INumberFormatter *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI formatter_GetRuntimeClassName( INumberFormatter *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_Globalization_NumberFormatting_DecimalFormatter;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI formatter_GetTrustLevel( INumberFormatter *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI formatter_FormatInt( INumberFormatter *iface, INT64 value, HSTRING *result )
+{
+    return format_number( impl_from_INumberFormatter( iface ), (DOUBLE)value, TRUE, result );
