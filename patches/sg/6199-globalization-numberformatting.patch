+DEFINE_IINSPECTABLE_( parser, INumberParser, struct formatter, impl_from_INumberParser,
+                      INumberParser_iface, &impl->INumberFormatter_iface )
+
+static HRESULT box_number( DOUBLE value, int kind, void **result )
+{
+    static const WCHAR name[] = L"Windows.Foundation.PropertyValue";
+    IPropertyValueStatics *statics = NULL;
+    IInspectable *box = NULL;
+    HSTRING str;
+    HRESULT hr;
+
+    if (FAILED(hr = WindowsCreateString( name, wcslen( name ), &str ))) return hr;
+    hr = RoGetActivationFactory( str, &IID_IPropertyValueStatics, (void **)&statics );
+    WindowsDeleteString( str );
+    if (FAILED(hr)) return hr;
+    switch (kind)
+    {
+    case 0: hr = IPropertyValueStatics_CreateInt64( statics, (INT64)value, &box ); break;
+    case 1: hr = IPropertyValueStatics_CreateUInt64( statics, (UINT64)value, &box ); break;
+    default: hr = IPropertyValueStatics_CreateDouble( statics, value, &box ); break;
+    }
+    IPropertyValueStatics_Release( statics );
+    if (FAILED(hr)) return hr;
+    hr = IInspectable_QueryInterface( box, kind == 0 ? &IID_IReference_INT64 : kind == 1 ? &IID_IReference_UINT64 : &IID_IReference_DOUBLE,
+                                      result );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static HRESULT WINAPI parser_ParseInt( INumberParser *iface, HSTRING text, IReference_INT64 **result )
+{
+    DOUBLE value;
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!parse_number( impl_from_INumberParser( iface ), text, TRUE, &value )) return S_OK;
+    return box_number( value, 0, (void **)result );
+}
+
+static HRESULT WINAPI parser_ParseUInt( INumberParser *iface, HSTRING text, IReference_UINT64 **result )
+{
+    DOUBLE value;
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!parse_number( impl_from_INumberParser( iface ), text, TRUE, &value ) || value < 0) return S_OK;
+    return box_number( value, 1, (void **)result );
+}
+
+static HRESULT WINAPI parser_ParseDouble( INumberParser *iface, HSTRING text, IReference_DOUBLE **result )
+{
+    DOUBLE value;
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!parse_number( impl_from_INumberParser( iface ), text, FALSE, &value )) return S_OK;
+    return box_number( value, 2, (void **)result );
+}
+
