+{
+    {&factory_vtbl}, {&decimal_factory_vtbl}, RuntimeClass_Windows_Globalization_NumberFormatting_DecimalFormatter,
+};
+static struct number_factory significant_rounder_statics =
+{
+    {&factory_vtbl}, {&decimal_factory_vtbl}, RuntimeClass_Windows_Globalization_NumberFormatting_SignificantDigitsNumberRounder,
+};
+static struct number_factory increment_rounder_statics =
+{
+    {&factory_vtbl}, {&decimal_factory_vtbl}, RuntimeClass_Windows_Globalization_NumberFormatting_IncrementNumberRounder,
+};
+
+IActivationFactory *number_formatting_factory( const WCHAR *name )
+{
+    if (!wcscmp( name, decimal_formatter_statics.name )) return &decimal_formatter_statics.IActivationFactory_iface;
+    if (!wcscmp( name, significant_rounder_statics.name )) return &significant_rounder_statics.IActivationFactory_iface;
+    if (!wcscmp( name, increment_rounder_statics.name )) return &increment_rounder_statics.IActivationFactory_iface;
+    return NULL;
+}
