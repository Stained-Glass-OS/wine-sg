+struct scan_request
+{
+    HANDLE handle;
+    GUID guid;
+};
+
+static DWORD WINAPI scan_thread(void *param)
+{
+    struct scan_request *req = param;
+    const WCHAR *args[] = { L"wifi", L"scan", L"--rescan" };
+    struct wine_wlan *wlan = handle_index(req->handle);
+    struct sgnet_reply r;
+
+    sgnet_request(args, 3, &r);
+    sgnet_free(&r);
+    if (wlan && wlan->magic == WLAN_MAGIC && wlan->callback && (wlan->notify_source & WLAN_NOTIFICATION_SOURCE_ACM))
+    {
+        WLAN_NOTIFICATION_DATA data = { 0 };
+
+        data.NotificationSource = WLAN_NOTIFICATION_SOURCE_ACM;
+        data.NotificationCode = WLAN_NOTIFICATION_ACM_SCAN_COMPLETE;
+        data.InterfaceGuid = req->guid;
+        wlan->callback(&data, wlan->context);
+    }
+    free(req);
+    return 0;
+}
+
 DWORD WINAPI WlanScan(HANDLE handle, const GUID *guid, const DOT11_SSID *ssid,
                       const WLAN_RAW_DATA *raw, void *reserved)
 {
-    FIXME("(%p, %s, %p, %p, %p) stub\n",
-          handle, wine_dbgstr_guid(guid), ssid, raw, reserved);
+    struct wifi_adapter *adapters;
+    struct scan_request *req;
+    BOOL known;
+    int count;
+    HANDLE thread;
 
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    TRACE("(%p, %s, %p, %p, %p)\n", handle, wine_dbgstr_guid(guid), ssid, raw, reserved);
+
+    if (!handle || !guid || reserved)
+        return ERROR_INVALID_PARAMETER;
+    if (!handle_index(handle))
+        return ERROR_INVALID_HANDLE;
+    count = get_wifi_adapters(&adapters);
+    known = find_adapter(adapters, count, guid) != NULL;
+    free(adapters);
+    if (!known)
+        return ERROR_NOT_FOUND;
+
+    /* the scan runs on its own; the completion goes to the notification callback */
+    if (!(req = malloc(sizeof(*req))))
+        return ERROR_NOT_ENOUGH_MEMORY;
+    req->handle = handle;
+    req->guid = *guid;
+    if (!(thread = CreateThread(NULL, 0, scan_thread, req, 0, NULL)))
+    {
+        free(req);
+        return GetLastError();
+    }
+    CloseHandle(thread);
+    return ERROR_SUCCESS;
 }
 
 DWORD WINAPI WlanRegisterNotification(HANDLE handle, DWORD notify_source, BOOL ignore_dup,
                                       WLAN_NOTIFICATION_CALLBACK callback, void *context,
                                       void *reserved, DWORD *notify_prev)
 {
-    FIXME("(%p, %ld, %d, %p, %p, %p, %p) stub\n",
+    struct wine_wlan *wlan;
+
+    TRACE("(%p, %ld, %d, %p, %p, %p, %p)\n",
           handle, notify_source, ignore_dup, callback, context, reserved, notify_prev);
 
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    if (!handle || reserved)
+        return ERROR_INVALID_PARAMETER;
+    if (!(wlan = handle_index(handle)))
+        return ERROR_INVALID_HANDLE;
+    /* the sources: none (0, which removes the registration), ACM (8), MSM (0x10), security (0x20), IHV (0x40), all (0xffff) */
+    if (notify_source && !(notify_source & 0xffff))
+        return ERROR_INVALID_PARAMETER;
+    if (notify_source && !callback)
+        return ERROR_INVALID_PARAMETER;
+
+    if (notify_prev)
+        *notify_prev = wlan->notify_source;
+    wlan->notify_source = notify_source;
+    wlan->callback = notify_source ? callback : NULL;
+    wlan->context = notify_source ? context : NULL;
+    return ERROR_SUCCESS;
+}
+
+static int hex_digit(WCHAR c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
 }
 
 DWORD WINAPI WlanGetAvailableNetworkList(HANDLE handle, const GUID *guid, DWORD flags,
                                          void *reserved, WLAN_AVAILABLE_NETWORK_LIST **network_list)
 {
-    FIXME("(%p, %s, 0x%lx, %p, %p) stub\n",
-          handle, wine_dbgstr_guid(guid), flags, reserved, network_list);
+    const WCHAR *args[] = { L"wifi", L"scan" };
+    struct wifi_adapter *adapters;
+    struct sgnet_reply r;
+    WLAN_AVAILABLE_NETWORK_LIST *list;
+    int i, count, n = 0;
 
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    TRACE("(%p, %s, 0x%lx, %p, %p)\n", handle, wine_dbgstr_guid(guid), flags, reserved, network_list);
+
+    if (!handle || !guid || reserved || !network_list)
+        return ERROR_INVALID_PARAMETER;
+    if (!handle_index(handle))
+        return ERROR_INVALID_HANDLE;
+    count = get_wifi_adapters(&adapters);
+    i = find_adapter(adapters, count, guid) != NULL;
+    free(adapters);
+    if (!i)
+        return ERROR_NOT_FOUND;
+
+    if (sgnet_request(args, 2, &r) != 1)
+    {
+        sgnet_free(&r);
+        return ERROR_SERVICE_NOT_ACTIVE;
+    }
+    list = WlanAllocateMemory(offsetof(WLAN_AVAILABLE_NETWORK_LIST, Network[r.count ? r.count : 1]));
+    if (!list)
+    {
+        sgnet_free(&r);
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    memset(list, 0, offsetof(WLAN_AVAILABLE_NETWORK_LIST, Network[r.count ? r.count : 1]));
+
+    for (i = 0; i < r.count; i++)
+    {
+        /* WIFI signal TAB security TAB in-use TAB saved TAB ssid in hex TAB name */
+        WCHAR *f[6], *p, buf[512];
+        WLAN_AVAILABLE_NETWORK *net;
+        int k = 0, j;
+
+        if (wcsncmp(r.lines[i], L"WIFI ", 5)) continue;
+        lstrcpynW(buf, r.lines[i] + 5, ARRAY_SIZE(buf));
+        for (p = buf, f[k++] = p; *p && k < 6; p++)
+            if (*p == '\t') { *p = 0; f[k++] = p + 1; }
+        if (k < 6) continue;
+
+        net = &list->Network[n++];
+        for (j = 0; f[4][j * 2] && f[4][j * 2 + 1] && j < DOT11_SSID_MAX_LENGTH; j++)
+        {
+            int hi = hex_digit(f[4][j * 2]), lo = hex_digit(f[4][j * 2 + 1]);
+
+            if (hi < 0 || lo < 0) break;
+            net->dot11Ssid.ucSSID[j] = hi * 16 + lo;
+        }
+        net->dot11Ssid.uSSIDLength = j;
+        if (!wcscmp(f[3], L"yes"))
+            lstrcpynW(net->strProfileName, f[5], ARRAY_SIZE(net->strProfileName));
+        net->dot11BssType = dot11_BSS_type_infrastructure;
+        net->uNumberOfBssids = 1;
+        net->bNetworkConnectable = TRUE;
+        net->wlanSignalQuality = _wtoi(f[0]);
+        net->bSecurityEnabled = wcscmp(f[1], L"open") != 0;
+        net->dot11DefaultAuthAlgorithm = net->bSecurityEnabled ? DOT11_AUTH_ALGO_RSNA_PSK : DOT11_AUTH_ALGO_80211_OPEN;
+        net->dot11DefaultCipherAlgorithm = net->bSecurityEnabled ? DOT11_CIPHER_ALGO_CCMP : DOT11_CIPHER_ALGO_NONE;
+        net->dwFlags = (!wcscmp(f[2], L"yes") ? 1 : 0) | (net->strProfileName[0] ? 2 : 0);   /* connected, has a profile */
+    }
+    sgnet_free(&r);
+    list->dwNumberOfItems = n;
+    list->dwIndex = 0;
+    *network_list = list;
+    return ERROR_SUCCESS;
 }
 
 DWORD WINAPI WlanQueryInterface(HANDLE handle, const GUID *guid, WLAN_INTF_OPCODE opcode,
                     void *reserved, DWORD *data_size, void **data, WLAN_OPCODE_VALUE_TYPE *opcode_type)
 {
-    FIXME("(%p, %s, 0x%x, %p, %p, %p, %p) stub\n",
+    struct wifi_adapter *adapters, *adapter;
+    DWORD value = 0;
+    int count;
+    DWORD ret = ERROR_SUCCESS;
+
+    TRACE("(%p, %s, 0x%x, %p, %p, %p, %p)\n",
           handle, wine_dbgstr_guid(guid), opcode, reserved, data_size, data, opcode_type);
 
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    if (!handle || !guid || reserved || !data_size || !data)
+        return ERROR_INVALID_PARAMETER;
+    if (!handle_index(handle))
+        return ERROR_INVALID_HANDLE;
+    count = get_wifi_adapters(&adapters);
+    if (!(adapter = find_adapter(adapters, count, guid)))
+    {
+        free(adapters);
+        return ERROR_NOT_FOUND;
+    }
+
+    switch (opcode)
+    {
+    case wlan_intf_opcode_autoconf_enabled:
+    case wlan_intf_opcode_background_scan_enabled:
+        value = TRUE;
+        break;
+    case wlan_intf_opcode_media_streaming_mode:
+    case wlan_intf_opcode_hosted_network_capable:
+        value = FALSE;
+        break;
+    case wlan_intf_opcode_bss_type:
+        value = dot11_BSS_type_infrastructure;
+        break;
+    case wlan_intf_opcode_interface_state:
+        value = adapter->state;
+        break;
+    default:
+        FIXME("opcode 0x%x is not supported.\n", opcode);
+        ret = ERROR_NOT_SUPPORTED;
+        break;
+    }
+    free(adapters);
+    if (ret)
+        return ret;
+
+    if (!(*data = WlanAllocateMemory(sizeof(value))))
+        return ERROR_NOT_ENOUGH_MEMORY;
+    *(DWORD *)*data = value;
+    *data_size = sizeof(value);
+    if (opcode_type)
+        *opcode_type = wlan_opcode_value_type_query_only;
+    return ERROR_SUCCESS;
 }
 
 /* There is no Hosted Network here: the Wireless LAN AutoConfig service that provides it is not running,
