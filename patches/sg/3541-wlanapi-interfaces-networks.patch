+#define WLAN_NOTIFICATION_SOURCE_ACM 0x00000008
+#define WLAN_NOTIFICATION_ACM_SCAN_COMPLETE 7
+
+/* ---- the wireless adapters, as sg-netctl (NetworkManager) sees them ---- */
+
+struct wifi_adapter
+{
+    WCHAR dev[64];
+    GUID guid;
+    WLAN_INTERFACE_STATE state;
+};
+
+static BOOL parse_guid(const WCHAR *str, GUID *guid)
+{
+    unsigned int d1, d2, d3, b[8];
+    int i;
+
+    if (swscanf(str, L"{%8x-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x}", &d1, &d2, &d3, b, b + 1, b + 2, b + 3, b + 4, b + 5,
+                b + 6, b + 7) != 11)
+        return FALSE;
+    guid->Data1 = d1;
+    guid->Data2 = d2;
+    guid->Data3 = d3;
+    for (i = 0; i < 8; i++) guid->Data4[i] = b[i];
+    return TRUE;
+}
+
+/* the interface guid of a unix device: the adapter name iphlpapi gives the device */
+static BOOL device_guid(const WCHAR *dev, GUID *guid)
+{
+    IP_ADAPTER_ADDRESSES *list = NULL, *p;
+    ULONG size = 16384, err;
+    BOOL found = FALSE;
+
+    for (;;)
+    {
+        if (!(list = realloc(list, size))) return FALSE;
+        if ((err = GetAdaptersAddresses(AF_UNSPEC, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST |
+                GAA_FLAG_SKIP_DNS_SERVER, NULL, list, &size)) != ERROR_BUFFER_OVERFLOW)
+            break;
+    }
+    if (!err)
+    {
+        for (p = list; p && !found; p = p->Next)
+        {
+            WCHAR name[64];
+
+            if (!p->Description || wcsicmp(p->Description, dev)) continue;
+            MultiByteToWideChar(CP_ACP, 0, p->AdapterName, -1, name, ARRAY_SIZE(name));
+            found = parse_guid(name, guid);
+        }
+    }
+    free(list);
+    return found;
+}
+
+static int get_wifi_adapters(struct wifi_adapter **ret)
+{
+    struct wifi_adapter *adapters = NULL;
+    struct sgnet_reply r;
+    const WCHAR *args[] = { L"adapters" };
+    int i, count = 0;
+
+    *ret = NULL;
+    if (sgnet_request(args, 1, &r) != 1)
+    {
+        sgnet_free(&r);
+        return 0;
+    }
+    for (i = 0; i < r.count; i++)
+    {
+        const WCHAR *type, *state;
+        struct wifi_adapter *new;
+
+        if (wcsncmp(r.lines[i], L"ADAPTER ", 8)) continue;
+        if (!(type = sgnet_field(&r, i, L"TYPE", 0)) || wcscmp(type, L"wifi")) continue;
+        state = sgnet_field(&r, i, L"STATE", 0);
+        if (!(new = realloc(adapters, (count + 1) * sizeof(*adapters)))) break;
+        adapters = new;
+        memset(&adapters[count], 0, sizeof(*adapters));
+        lstrcpynW(adapters[count].dev, r.lines[i] + 8, ARRAY_SIZE(adapters[count].dev));
+        if (!device_guid(adapters[count].dev, &adapters[count].guid))
+            adapters[count].guid.Data1 = 0;   /* no guid for it: the device name's hash below */
+        if (!adapters[count].guid.Data1)
+        {
+            DWORD h = 5381;
+            const WCHAR *c;
+
+            for (c = adapters[count].dev; *c; c++) h = h * 33 + *c;
+            adapters[count].guid.Data1 = h;
+            adapters[count].guid.Data2 = 0x5747;   /* "WG" */
+            adapters[count].guid.Data3 = 0x4c41;
+        }
+        adapters[count].state = state && !wcscmp(state, L"connected") ? wlan_interface_state_connected :
+                                state && !wcscmp(state, L"disconnected") ? wlan_interface_state_disconnected :
+                                wlan_interface_state_not_ready;
+        count++;
+    }
+    sgnet_free(&r);
+    *ret = adapters;
+    return count;
+}
+
+static struct wifi_adapter *find_adapter(struct wifi_adapter *adapters, int count, const GUID *guid)
+{
+    int i;
+
+    for (i = 0; i < count; i++)
+        if (IsEqualGUID(&adapters[i].guid, guid)) return &adapters[i];
+    return NULL;
+}
