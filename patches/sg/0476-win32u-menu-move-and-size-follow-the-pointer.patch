From: Stained Glass OS contributors
Subject: win32u: a window menu's Move and Size follow the pointer until a click

The move/size loop, after dispatching any message that was not a mouse move
or key, ended as soon as it found the left button up -- meant for a drag
whose button-up a window procedure swallowed. A Move or Size chosen from the
window's menu (the taskbar button's, Alt+Space) holds no button, so the loop
ended at the first timer or paint: David -- "Move just moves it to the mouse
and lets go right away", "Size resizes once". Now that check applies only to
a drag started with the button down; a move or size from the menu follows
the pointer until a click, Return or Escape, as on Windows.

--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -669,6 +669,7 @@
     UINT syscommand = wparam & 0xfff0;
     UINT style = get_window_long( hwnd, GWL_STYLE );
     POINT capture_point, pt;
+    BOOL mouse_drag;
     MINMAXINFO minmax;
     HWND parent;
     UINT dpi;
@@ -768,6 +769,12 @@
     NtUserNotifyWinEvent( EVENT_SYSTEM_MOVESIZESTART, hwnd, OBJID_WINDOW, CHILDID_SELF );
     set_capture_window( hwnd, GUI_INMOVESIZE, NULL );
 
+    /* Stained Glass OS: a move or size chosen from the window's menu (or with
+     * Alt+Space) follows the pointer with no button held, until a click, Return
+     * or Escape, as on Windows; only a drag started with the button down ends
+     * when the button is found up. It ended at the first other message. */
+    mouse_drag = (NtUserGetKeyState( VK_LBUTTON ) & 0x8000) != 0;
+
     for (;;)
     {
         int dx = 0, dy = 0;
@@ -775,7 +782,10 @@
         if (!NtUserGetMessage( &msg, 0, 0, 0 )) break;
         if (NtUserCallMsgFilter( &msg, MSGF_SIZE )) continue;
 
-        /* Exit on button-up, Return, or Esc */
+        /* Exit on button-up, Return, or Esc -- or, following the pointer
+         * without a button, on a click */
+        if (!mouse_drag && (msg.message == WM_LBUTTONDOWN || msg.message == WM_RBUTTONDOWN))
+            break;
         if (msg.message == WM_LBUTTONUP ||
             (msg.message == WM_KEYDOWN && (msg.wParam == VK_RETURN || msg.wParam == VK_ESCAPE)))
             break;
@@ -787,7 +797,7 @@
 
             /* It's possible that the window proc that handled the dispatch consumed a
              * WM_LBUTTONUP. Detect that and terminate the loop as if we'd gotten it. */
-            if (!(NtUserGetKeyState( VK_LBUTTON ) & 0x8000))
+            if (mouse_drag && !(NtUserGetKeyState( VK_LBUTTON ) & 0x8000))
             {
                 DWORD last_pos = NtUserGetThreadInfo()->message_pos;
                 pt.x = ((int)(short)LOWORD( last_pos ));
