From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] localspl, winspool, splwow64: a 32-bit installer adds a 64-bit port monitor and its printer

Windows' spooler is a 64-bit service; Wine's print provider runs in the caller. CutePDF Writer's 32-bit Setup could not add its 64-bit monitor (LoadLibrary 193) or its port; AddMonitor and AddPort from a WOW64 process now go to the 64-bit print host splwow64, which also puts the monitor DLL in system32. AddPrinter from a WOW64 process finds a driver of the x64 environment. A port the monitor keeps to itself is found by asking each monitor's EnumPorts.
---
diff --git a/dlls/localspl/provider.c b/dlls/localspl/provider.c
index b6acc39..4f33bd6 100644
--- a/dlls/localspl/provider.c
+++ b/dlls/localspl/provider.c
@@ -1184,6 +1184,33 @@ static monitor_t * monitor_load_by_port(LPCWSTR portname)
             }
             id++;
         }
+#ifndef SG_MUTANT_PORT_BY_REGISTRY_ONLY
+        /* Stained Glass OS: the spooler asks the monitors themselves: a
+         * monitor keeps its ports where it likes (CutePDF Writer's keeps
+         * "CPW4:" in its own key, not in Ports), and a job to that port found
+         * no monitor -- EndDoc failed, no PDF */
+        for (id = 0; pm == NULL && id < registered; id++)
+        {
+            monitor_t *candidate;
+            buffer[0] = '\0';
+            if (RegEnumKeyW(hroot, id, buffer, MAX_PATH)) continue;
+            if (!(candidate = monitor_load(buffer, NULL))) continue;
+            if (candidate->monitor.pfnEnumPorts)
+            {
+                DWORD needed = 0, returned = 0, i;
+                PORT_INFO_1W *pi;
+                candidate->monitor.pfnEnumPorts(candidate->hmon, NULL, 1, NULL, 0, &needed, &returned);
+                if (needed && (pi = malloc(needed)))
+                {
+                    if (candidate->monitor.pfnEnumPorts(candidate->hmon, NULL, 1, (BYTE *)pi, needed, &needed, &returned))
+                        for (i = 0; i < returned; i++)
+                            if (pi[i].pName && !wcsicmp(pi[i].pName, portname)) pm = candidate;
+                    free(pi);
+                }
+            }
+            if (pm != candidate) monitor_unload(candidate);
+        }
+#endif
         LeaveCriticalSection(&monitor_handles_cs);
         RegCloseKey(hroot);
     }
@@ -2216,6 +2243,48 @@ static BOOL myAddPrinterDriverEx(DWORD level, LPBYTE pDriverInfo, DWORD dwFileCo
  *  All Files for the Monitor must already be copied to %winsysdir% ("%SystemRoot%\system32")
  *
  */
+/* Stained Glass OS: a 32-bit process on a 64-bit system, adding a 64-bit
+ * port monitor (CutePDF Writer's installer: AddMonitor of cpwmon64_v40.dll,
+ * then AddPort). Windows' spooler is a 64-bit service that loads it; here the
+ * provider runs in the caller, and LoadLibrary of the 64-bit DLL failed
+ * (ERROR_BAD_EXE_FORMAT): no monitor, no port, no printer. Such calls go to
+ * the 64-bit print host, splwow64. Returns the call's error, or -1 when the
+ * call is ours to make. */
+static LONG sg_spl_host( const WCHAR *verb, const WCHAR *a1, const WCHAR *a2, const WCHAR *a3 )
+{
+#ifdef __i386__
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    WCHAR host[MAX_PATH], *cmd;
+    DWORD code = 1;
+    BOOL wow64 = FALSE;
+    size_t len;
+
+#ifdef SG_MUTANT_SPL_NO_HOST
+    return -1;
+#endif
+    if (!IsWow64Process( GetCurrentProcess(), &wow64 ) || !wow64) return -1;
+    GetWindowsDirectoryW( host, MAX_PATH - 32 );
+    lstrcatW( host, L"\\sysnative\\splwow64.exe" );
+    len = wcslen( host ) + wcslen( verb ) + 16 + (a1 ? wcslen( a1 ) : 0) + (a2 ? wcslen( a2 ) : 0) + (a3 ? wcslen( a3 ) : 0);
+    if (!(cmd = malloc( len * sizeof(WCHAR) ))) return ERROR_OUTOFMEMORY;
+    swprintf( cmd, len, L"\"%s\" %s \"%s\" \"%s\" \"%s\"", host, verb, a1 ? a1 : L"", a2 ? a2 : L"", a3 ? a3 : L"" );
+    TRACE( "%s\n", debugstr_w(cmd) );
+    if (CreateProcessW( host, cmd, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi ))
+    {
+        WaitForSingleObject( pi.hProcess, INFINITE );
+        GetExitCodeProcess( pi.hProcess, &code );
+        CloseHandle( pi.hProcess );
+        CloseHandle( pi.hThread );
+    }
+    else code = GetLastError();
+    free( cmd );
+    return code;
+#else
+    return -1;
+#endif
+}
+
 static BOOL WINAPI fpAddMonitor(LPWSTR pName, DWORD Level, LPBYTE pMonitors)
 {
     const printenv_t * env;
@@ -2252,6 +2321,17 @@ static BOOL WINAPI fpAddMonitor(LPWSTR pName, DWORD Level, LPBYTE pMonitors)
         return FALSE;
     }
 
+    /* a monitor for the 64-bit spooler, added from a 32-bit process */
+    if (env == &env_x64)
+    {
+        LONG code = sg_spl_host( L"addmonitor", mi2w->pName, env->envname, mi2w->pDLLName );
+        if (code != -1)
+        {
+            SetLastError( code );
+            return !code;
+        }
+    }
+
     if (RegCreateKeyW(HKEY_LOCAL_MACHINE, monitorsW, &hroot) != ERROR_SUCCESS) {
         ERR("unable to create key %s\n", debugstr_w(monitorsW));
         return FALSE;
@@ -2346,6 +2426,16 @@ static BOOL WINAPI fpAddPort(LPWSTR pName, HWND hWnd, LPWSTR pMonitorName)
     }
 
     pm = monitor_load(pMonitorName, NULL);
+    if (!pm && !hWnd)
+    {
+        /* a 64-bit monitor, from a 32-bit process: the 64-bit host adds the port */
+        LONG code = sg_spl_host( L"addport", pMonitorName, NULL, NULL );
+        if (code != -1)
+        {
+            SetLastError( code );
+            return !code;
+        }
+    }
     if (pm && pm->monitor.pfnAddPort) {
         res = pm->monitor.pfnAddPort(pm->hmon, pName, hWnd, pMonitorName);
         TRACE("got %ld with %lu (%s)\n", res, GetLastError(), debugstr_w(pm->dllname));
diff --git a/dlls/winspool.drv/info.c b/dlls/winspool.drv/info.c
index 119bba7..003343a 100644
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -3398,13 +3398,33 @@ HANDLE WINAPI AddPrinterW(LPWSTR pName, DWORD Level, LPBYTE pPrinter)
 	RegCloseKey( printers_key );
 	return 0;
     }
-    if(RegOpenKeyW(hkeyDrivers, pi->pDriverName, &hkeyDriver) !=
-       ERROR_SUCCESS) {
+    if(RegOpenKeyW(hkeyDrivers, pi->pDriverName, &hkeyDriver) != ERROR_SUCCESS)
+    {
+#ifndef SG_MUTANT_ADDPRINTER_NATIVE_DRIVER
+        /* Stained Glass OS: a 32-bit installer adds a printer of a 64-bit
+         * driver it just added (CutePDF Writer); the spooler is 64-bit */
+        const WCHAR *env = NULL;
+#ifdef __i386__
+        BOOL wow64 = FALSE;
+        if (IsWow64Process( GetCurrentProcess(), &wow64 ) && wow64) env = env_x64.envname;
+#endif
+        if (env)
+        {
+            RegCloseKey( hkeyDrivers );
+            if ((hkeyDrivers = WINSPOOL_OpenDriverReg( env )) &&
+                RegOpenKeyW( hkeyDrivers, pi->pDriverName, &hkeyDriver ) != ERROR_SUCCESS)
+                hkeyDriver = NULL;
+        }
+        else hkeyDriver = NULL;
+        if (!hkeyDriver)
+#endif
+        {
         WARN("Can't find driver %s\n", debugstr_w(pi->pDriverName));
 	RegCloseKey( printers_key );
 	RegCloseKey(hkeyDrivers);
 	SetLastError(ERROR_UNKNOWN_PRINTER_DRIVER);
 	return 0;
+        }
     }
     RegCloseKey(hkeyDriver);
     RegCloseKey(hkeyDrivers);
diff --git a/programs/splwow64/main.c b/programs/splwow64/main.c
index e69b22e..6d70d9f 100644
--- a/programs/splwow64/main.c
+++ b/programs/splwow64/main.c
@@ -587,6 +587,36 @@ static int install_drivers( void )
     return 0;
 }
 
+/* Stained Glass OS: a 32-bit installer adds a 64-bit port monitor (CutePDF
+ * Writer's cpwmon64_v40.dll): the spooler that loads it is 64-bit on Windows,
+ * and a 32-bit process cannot; localspl hands the call to this 64-bit host.
+ * The exit code is the call's error (0: done). */
+static int add_monitor( WCHAR *name, WCHAR *env, WCHAR *dll )
+{
+    MONITOR_INFO_2W mi = { name, env, dll };
+    WCHAR sys[MAX_PATH], found[MAX_PATH];
+
+    /* the monitor where the spooler loads it from: an installer that has it
+     * beside itself only (CutePDF's Setup, in its temporary folder: our
+     * current directory) would have no monitor once that folder is gone */
+    if (!wcschr( dll, '\\' ) && GetSystemDirectoryW( sys, MAX_PATH - wcslen( dll ) - 2 ))
+    {
+        lstrcatW( sys, L"\\" );
+        lstrcatW( sys, dll );
+        if (GetFileAttributesW( sys ) == INVALID_FILE_ATTRIBUTES &&
+            SearchPathW( NULL, dll, NULL, MAX_PATH, found, NULL ))
+            CopyFileW( found, sys, TRUE );
+    }
+    if (AddMonitorW( NULL, 2, (BYTE *)&mi )) return 0;
+    return GetLastError() ? GetLastError() : 1;
+}
+
+static int add_port( WCHAR *monitor )
+{
+    if (AddPortW( NULL, NULL, monitor )) return 0;
+    return GetLastError() ? GetLastError() : 1;
+}
+
 int __cdecl wmain( int argc, WCHAR *argv[] )
 {
     BOOL (WINAPI *render)( const WCHAR *, const WCHAR *, const WCHAR *, const WCHAR *, const WCHAR *, DWORD );
@@ -617,6 +647,8 @@ int __cdecl wmain( int argc, WCHAR *argv[] )
     if (argc >= 7 && !wcscmp( argv[1], L"print" )) return print_pages( argv[2], argv[3], argv[4], argv[5], argc - 6, argv + 6 );
     if (argc >= 2 && !wcscmp( argv[1], L"drivers" )) return install_drivers();
     if (argc >= 2 && !wcscmp( argv[1], L"list" )) return list_printers( argc > 2 ? argv[2] : NULL );
+    if (argc >= 5 && !wcscmp( argv[1], L"addmonitor" )) return add_monitor( argv[2], argv[3], argv[4] );
+    if (argc >= 3 && !wcscmp( argv[1], L"addport" )) return add_port( argv[2] );
     WINE_MESSAGE( "usage: splwow64 render PRINTER SPOOLFILE DEVMODEFILE OUTFILE JOBID DOCNAME\n"
                   "       splwow64 caps PRINTER DEVMODEFILE OUTFILE\n"
                   "       splwow64 devprops PRINTER DEVMODEFILE OUTFILE MODE HWND\n"
@@ -625,6 +657,8 @@ int __cdecl wmain( int argc, WCHAR *argv[] )
                   "       splwow64 drivers\n"
                   "       splwow64 list [OUTFILE]\n"
                   "       splwow64 ppd PRINTER OUTFILE\n"
-                  "       splwow64 print PRINTER PAPER COPIES TITLE PAGE.ppm...\n" );
+                  "       splwow64 print PRINTER PAPER COPIES TITLE PAGE.ppm...\n"
+                  "       splwow64 addmonitor NAME ENVIRONMENT DLL\n"
+                  "       splwow64 addport MONITOR\n" );
     return 2;
 }
