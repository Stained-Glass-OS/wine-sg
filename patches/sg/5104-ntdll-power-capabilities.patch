Subject: [PATCH] ntdll: SystemPowerCapabilities from the host (patch 5104)

Lid and buttons from the input devices, real S3, disk spin-down; gap-CORE item
55. Gate with four mutants.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/ntdll/unix/system.c b/dlls/ntdll/unix/system.c
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -4732,6 +4732,47 @@
     closedir( dir );
     return TRUE;
 }
+
+/* Whether the kernel lists an input device of this name (the ACPI buttons and the lid switch
+ * are input devices): 1 yes, 0 no, -1 when the list cannot be read. */
+static int input_device_present( const char *name )
+{
+    char line[256], want[96];
+    int ret = 0;
+    FILE *f;
+
+    if (!(f = fopen( "/proc/bus/input/devices", "r" ))) return -1;
+    snprintf( want, sizeof(want), "Name=\"%s\"", name );
+    while (!ret && fgets( line, sizeof(line), f ))
+        ret = line[0] == 'N' && strstr( line, want ) != NULL;
+    fclose( f );
+    return ret;
+}
+
+/* Whether a rotating disk is attached, the kind that is spun down to save power. */
+static BOOL spinning_disk_present(void)
+{
+    struct dirent *entry;
+    BOOL ret = FALSE;
+    DIR *dir;
+
+    if (!(dir = opendir( "/sys/block" ))) return FALSE;
+    while (!ret && (entry = readdir( dir )))
+    {
+        char path[300], value[8] = "";
+        FILE *f;
+
+        if (entry->d_name[0] == '.' || !strncmp( entry->d_name, "loop", 4 ) || !strncmp( entry->d_name, "ram", 3 )
+            || !strncmp( entry->d_name, "zram", 4 ) || !strncmp( entry->d_name, "dm-", 3 )
+            || !strncmp( entry->d_name, "sr", 2 ) || !strncmp( entry->d_name, "nbd", 3 )) continue;
+        snprintf( path, sizeof(path), "/sys/block/%s/queue/rotational", entry->d_name );
+        if (!(f = fopen( path, "r" ))) continue;
+        if (fgets( value, sizeof(value), f )) ret = value[0] == '1';
+        fclose( f );
+    }
+    closedir( dir );
+    return ret;
+}
 #endif
 
 /******************************************************************************
@@ -5046,7 +5087,7 @@
     case SystemPowerCapabilities:
     {
         PSYSTEM_POWER_CAPABILITIES PowerCaps = output;
-        FIXME("semi-stub: SystemPowerCapabilities\n");
+        TRACE( "SystemPowerCapabilities\n" );
         if (out_size < sizeof(SYSTEM_POWER_CAPABILITIES)) return STATUS_BUFFER_TOO_SMALL;
         /* FIXME: These values are based off a native XP desktop, should probably use APM/ACPI to get the 'real' values */
         PowerCaps->PowerButtonPresent = TRUE;
@@ -5088,15 +5129,37 @@
         {
             SYSTEM_BATTERY_STATE bs;
             unsigned int min_khz = 0, max_khz = 0;
+            int lid = input_device_present( "Lid Switch" );
+            int power_button = input_device_present( "Power Button" );
+            int sleep_button = input_device_present( "Sleep Button" );
             FILE *f;
 
             memset( &bs, 0, sizeof(bs) );
             fill_battery_state( &bs );
             PowerCaps->SystemBatteriesPresent = bs.BatteryPresent;
-            PowerCaps->LidPresent = dir_exists( "/proc/acpi/button/lid" ) || sys_file_has( "/proc/acpi/button/lid/LID0/state", NULL );
+            PowerCaps->LidPresent = lid > 0 || dir_exists( "/proc/acpi/button/lid" ) || sys_file_has( "/proc/acpi/button/lid/LID0/state", NULL );
+#ifdef SG_MUTANT_POWER_LID
+            PowerCaps->LidPresent = !PowerCaps->LidPresent;
+#endif
             PowerCaps->SystemS1 = sys_file_has( "/sys/power/state", "standby" ) || sys_file_has( "/sys/power/state", "freeze" );
-            PowerCaps->SystemS3 = sys_file_has( "/sys/power/state", "mem" );
+            /* "mem" suspends to idle ("s2idle") or really to RAM ("deep"), the S3 of Windows */
+            PowerCaps->SystemS3 = sys_file_has( "/sys/power/mem_sleep", NULL ) ? sys_file_has( "/sys/power/mem_sleep", "deep" )
+                                                                              : sys_file_has( "/sys/power/state", "mem" );
+#ifdef SG_MUTANT_POWER_S3
+            PowerCaps->SystemS3 = !PowerCaps->SystemS3;
+#endif
             PowerCaps->SystemS4 = sys_file_has( "/sys/power/state", "disk" );
+            /* the buttons the machine has, where the kernel says (a machine that does not say keeps
+             * the desktop answer: a power button, no sleep button) */
+            if (power_button == 0) PowerCaps->PowerButtonPresent = FALSE;
+            PowerCaps->SleepButtonPresent = sleep_button > 0;
+#ifdef SG_MUTANT_POWER_BUTTONS
+            PowerCaps->SleepButtonPresent = !PowerCaps->SleepButtonPresent;
+#endif
+            PowerCaps->DiskSpinDown = spinning_disk_present();
+#ifdef SG_MUTANT_POWER_SPIN
+            PowerCaps->DiskSpinDown = !PowerCaps->DiskSpinDown;
+#endif
             PowerCaps->HiberFilePresent = PowerCaps->SystemS4;
             PowerCaps->ThermalControl = dir_exists( "/sys/class/thermal/thermal_zone0" );
             if ((f = fopen( "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_min_freq", "r" )))
