+static DWORD open_line( HLINEAPP handle, DWORD device, HLINE *line )
+{
+    DWORD ret;
+
+    if ((ret = check_app( handle, NULL ))) return ret;
+    if (!line) return LINEERR_INVALPOINTER;
+#ifndef SG_MUTANT_TAPI_MAPPER /* the line mapper is treated as a device id */
+    if (device == SG_LINEMAPPER) return LINEERR_LINEMAPPERFAILED;
