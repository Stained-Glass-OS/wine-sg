+/***********************************************************************
+ *		lineRegisterRequestRecipient (TAPI32.@)
+ */
+DWORD WINAPI lineRegisterRequestRecipient( HLINEAPP handle, DWORD instance, DWORD mode, DWORD enable )
+{
+    struct line_app *app;
+    DWORD ret = 0;
+
+    TRACE( "(%p, %08lx, %08lx, %08lx)\n", handle, instance, mode, enable );
+
+    EnterCriticalSection( &apps_cs );
+    if (!(app = find_app( handle ))) ret = LINEERR_INVALAPPHANDLE;
+    else if (!mode || (mode & ~(SG_REQMODE_MAKECALL | SG_REQMODE_MEDIACALL | SG_REQMODE_DROP)))
+        ret = LINEERR_INVALREQUESTMODE;
+    else if (enable) app->registered_modes |= mode;
+    else app->registered_modes &= ~mode;
+    LeaveCriticalSection( &apps_cs );
+    return ret;
+}
+
+/***********************************************************************
+ *		lineGetRequest (TAPI32.@)
+ */
+DWORD WINAPI lineGetRequestA( HLINEAPP handle, DWORD mode, LPVOID buffer )
+{
+    struct line_app *app;
+    DWORD ret;
+
+    TRACE( "(%p, %08lx, %p)\n", handle, mode, buffer );
+
+    EnterCriticalSection( &apps_cs );
+    if (!(app = find_app( handle ))) ret = LINEERR_INVALAPPHANDLE;
+    else if (mode != SG_REQMODE_MAKECALL && mode != SG_REQMODE_MEDIACALL && mode != SG_REQMODE_DROP)
+        ret = LINEERR_INVALREQUESTMODE;
+    else if (!buffer) ret = LINEERR_INVALPOINTER;
+#ifndef SG_MUTANT_TAPI_REGMODE /* registration is ignored */
+    else if (!(app->registered_modes & mode)) ret = LINEERR_NOTREGISTERED;
+#endif
+    else ret = LINEERR_NOREQUEST;
+    LeaveCriticalSection( &apps_cs );
+    return ret;
+}
