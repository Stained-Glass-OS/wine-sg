+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* This models a machine that has TAPI but no telephony devices: every
+ * application can initialise and shut down, the device count is zero, and
+ * everything that names a device, a line or a call fails the way TAPI fails
+ * for an identifier that does not exist. */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "tapi.h"
+#include "wine/debug.h"
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(tapi);
+
+#define TAPI_LOW_API_VERSION   0x00010003
+#define TAPI_HIGH_API_VERSION  0x00030001
+/* The Windows header packs these structures to one byte, Wine's does not;
+ * the size an application passes is the packed one. */
+#define EXPARAMS_SIZE          (FIELD_OFFSET(LINEINITIALIZEEXPARAMS, dwCompletionKey) + sizeof(DWORD))
+#define SG_LINEMAPPER          0xffffffff
+
+#define SG_REQMODE_MAKECALL    0x00000001
+#define SG_REQMODE_MEDIACALL   0x00000002
+#define SG_REQMODE_DROP        0x00000004
+
+#define SG_TOLLLIST_ADD        0x00000001
+#define SG_TOLLLIST_REMOVE     0x00000002
+
+struct line_app
+{
+    struct list entry;
+    DWORD id;
+    DWORD options;
+    HANDLE event;
+    DWORD registered_modes;
+};
+
+static const DWORD num_devices = 0; /* no telephony hardware */
+
+static struct list line_apps = LIST_INIT( line_apps );
+static DWORD next_app_id = 0x10001;
+
+static CRITICAL_SECTION apps_cs;
+static CRITICAL_SECTION_DEBUG apps_cs_debug =
+{
+    0, 0, &apps_cs,
+    { &apps_cs_debug.ProcessLocksList, &apps_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": apps_cs") }
+};
+static CRITICAL_SECTION apps_cs = { &apps_cs_debug, -1, 0, 0, 0, 0 };
+
+/* TAPI handles are 32-bit values in the Windows headers; they travel as
+ * HANDLE here and only the low 32 bits count. */
+static struct line_app *find_app( HLINEAPP handle )
+{
+    struct line_app *app;
+
+    LIST_FOR_EACH_ENTRY( app, &line_apps, struct line_app, entry )
+#ifdef SG_MUTANT_TAPI_APPH /* any handle value finds the first application */
+        return app;
+#else
+        if ((DWORD)(ULONG_PTR)handle == app->id) return app;
+#endif
+    return NULL;
+}
+
+/* Returns 0 and the options of a live application, or LINEERR_INVALAPPHANDLE. */
+static DWORD check_app( HLINEAPP handle, DWORD *options )
+{
+    struct line_app *app;
+    DWORD ret = LINEERR_INVALAPPHANDLE;
+
+    EnterCriticalSection( &apps_cs );
+    if ((app = find_app( handle )))
+    {
+        if (options) *options = app->options;
+        ret = 0;
+    }
+    LeaveCriticalSection( &apps_cs );
+    return ret;
+}
+
+static DWORD check_device( DWORD device )
+{
+#ifdef SG_MUTANT_TAPI_NDEV /* every device id is accepted */
+    return 0;
+#else
+    return device < num_devices ? 0 : LINEERR_BADDEVICEID;
+#endif
+}
+
+static DWORD init_app( HLINEAPP *out, LINECALLBACK callback, DWORD *num_devs, DWORD *api_version,
+                       LINEINITIALIZEEXPARAMS *ex, BOOL is_ex )
+{
+    DWORD option = LINEINITIALIZEEXOPTION_USEHIDDENWINDOW;
+    struct line_app *app;
+
+#ifdef SG_MUTANT_TAPI_INITPTR /* NULL pointers are not rejected */
+    if (!out) return LINEERR_INVALPOINTER;
+#else
+    if (!out || !num_devs) return LINEERR_INVALPOINTER;
+#endif
+    if (is_ex && !api_version) return LINEERR_INVALPOINTER;
+
+    if (ex)
+    {
+        if (ex->dwTotalSize < EXPARAMS_SIZE) return LINEERR_STRUCTURETOOSMALL;
+        option = ex->dwOptions & ~LINEINITIALIZEEXOPTION_CALLHUBTRACKING;
+#ifdef SG_MUTANT_TAPI_EXOPT /* any option value is taken */
+        if (0 &&
+#else
+        if (option != LINEINITIALIZEEXOPTION_USEHIDDENWINDOW &&
+#endif
+            option != LINEINITIALIZEEXOPTION_USEEVENT &&
+            option != LINEINITIALIZEEXOPTION_USECOMPLETIONPORT)
+            return LINEERR_INVALPARAM;
+    }
+    if (option == LINEINITIALIZEEXOPTION_USEHIDDENWINDOW && !callback) return LINEERR_INVALPOINTER;
+
+    if (api_version)
+    {
+        if (*api_version < TAPI_LOW_API_VERSION) return LINEERR_INCOMPATIBLEAPIVERSION;
+#ifndef SG_MUTANT_TAPI_VER /* the version is not clamped */
+        if (*api_version > TAPI_HIGH_API_VERSION) *api_version = TAPI_HIGH_API_VERSION;
+#endif
+    }
+
+    if (!(app = calloc( 1, sizeof(*app) ))) return LINEERR_NOMEM;
+    app->options = option;
+#ifdef SG_MUTANT_TAPI_EVENT /* no event is created */
+    if (0 &&
+#else
+    if (option == LINEINITIALIZEEXOPTION_USEEVENT &&
+#endif
+        !(app->event = CreateEventW( NULL, FALSE, FALSE, NULL )))
+    {
+        free( app );
+        return LINEERR_NOMEM;
+    }
+
+    EnterCriticalSection( &apps_cs );
+    app->id = next_app_id++;
+    list_add_tail( &line_apps, &app->entry );
+    LeaveCriticalSection( &apps_cs );
+
+    if (ex)
+    {
+        ex->dwNeededSize = ex->dwUsedSize = EXPARAMS_SIZE;
+        if (option == LINEINITIALIZEEXOPTION_USEEVENT) ex->Handles.hEvent = app->event;
+    }
+    *num_devs = num_devices;
+    *(DWORD *)out = app->id; /* TAPI handles are 32-bit even though the header says HANDLE */
+    return 0;
+}
+
+/***********************************************************************
+ *		lineInitialize (TAPI32.@)
+ */
+DWORD WINAPI lineInitialize( LPHLINEAPP app, HINSTANCE instance, LINECALLBACK callback,
+                             LPCSTR app_name, LPDWORD num_devs )
+{
+    TRACE( "(%p, %p, %p, %s, %p)\n", app, instance, callback, debugstr_a(app_name), num_devs );
+    return init_app( app, callback, num_devs, NULL, NULL, FALSE );
+}
+
+/***********************************************************************
+ *              lineInitializeExA (TAPI32.@)
+ */
+LONG WINAPI lineInitializeExA( LPHLINEAPP app, HINSTANCE instance, LINECALLBACK callback,
+                               LPCSTR app_name, LPDWORD num_devs, LPDWORD api_version,
+                               LPLINEINITIALIZEEXPARAMS params )
+{
+    TRACE( "(%p, %p, %p, %s, %p, %p, %p)\n", app, instance, callback, debugstr_a(app_name),
+           num_devs, api_version, params );
+    return init_app( app, callback, num_devs, api_version, params, TRUE );
+}
+
+/***********************************************************************
+ *              lineInitializeExW (TAPI32.@)
+ */
+LONG WINAPI lineInitializeExW( LPHLINEAPP app, HINSTANCE instance, LINECALLBACK callback,
+                               LPCWSTR app_name, LPDWORD num_devs, LPDWORD api_version,
+                               LPLINEINITIALIZEEXPARAMS params )
+{
+    TRACE( "(%p, %p, %p, %s, %p, %p, %p)\n", app, instance, callback, debugstr_w(app_name),
+           num_devs, api_version, params );
+    return init_app( app, callback, num_devs, api_version, params, TRUE );
+}
+
+/***********************************************************************
+ *		lineShutdown (TAPI32.@)
+ */
+DWORD WINAPI lineShutdown( HLINEAPP handle )
+{
+    struct line_app *app;
+
+    TRACE( "(%p)\n", handle );
+
+    EnterCriticalSection( &apps_cs );
+    if (!(app = find_app( handle )))
+    {
+        LeaveCriticalSection( &apps_cs );
+        return LINEERR_INVALAPPHANDLE;
+    }
+#ifdef SG_MUTANT_TAPI_SHUTDOWN /* the application stays registered */
+    LeaveCriticalSection( &apps_cs );
+    return 0;
+#endif
+    list_remove( &app->entry );
+    LeaveCriticalSection( &apps_cs );
+
+    if (app->event) CloseHandle( app->event );
+    free( app );
+    return 0;
+}
+
+/***********************************************************************
+ *              lineGetMessage (TAPI32.@)
+ */
+DWORD WINAPI lineGetMessage( HLINEAPP handle, LPLINEMESSAGE msg, DWORD timeout )
+{
+    DWORD options, ret;
+
+    TRACE( "(%p, %p, %08lx)\n", handle, msg, timeout );
+
+    if ((ret = check_app( handle, &options ))) return ret;
+    if (options == LINEINITIALIZEEXOPTION_USEHIDDENWINDOW) return LINEERR_INVALAPPHANDLE;
+    if (!msg) return LINEERR_INVALPOINTER;
+
+    /* No device can ever produce a message. A bounded wait just times out;
+     * waiting forever would hang the caller, so that fails at once. */
+    if (timeout && timeout != INFINITE) Sleep( timeout );
+    return LINEERR_OPERATIONFAILED;
+}
+
+/***********************************************************************
+ *		lineNegotiateAPIVersion (TAPI32.@)
+ */
+DWORD WINAPI lineNegotiateAPIVersion( HLINEAPP handle, DWORD device, DWORD low, DWORD high,
+                                      LPDWORD version, LPLINEEXTENSIONID ext_id )
+{
+    DWORD ret;
+
+    TRACE( "(%p, %ld, %08lx, %08lx, %p, %p)\n", handle, device, low, high, version, ext_id );
+
+    if ((ret = check_app( handle, NULL ))) return ret;
+    if (!version || !ext_id) return LINEERR_INVALPOINTER;
+    return check_device( device );
+}
+
+/***********************************************************************
+ *		lineNegotiateExtVersion (TAPI32.@)
+ */
+DWORD WINAPI lineNegotiateExtVersion( HLINEAPP handle, DWORD device, DWORD version, DWORD low,
+                                      DWORD high, LPDWORD ext_version )
+{
+    DWORD ret;
+
+    TRACE( "(%p, %ld, %08lx, %08lx, %08lx, %p)\n", handle, device, version, low, high, ext_version );
+
+    if ((ret = check_app( handle, NULL ))) return ret;
+    if (!ext_version) return LINEERR_INVALPOINTER;
+    return check_device( device );
+}
+
+static DWORD get_caps( HLINEAPP handle, DWORD device, void *caps )
+{
+    DWORD ret;
+
+    if ((ret = check_app( handle, NULL ))) return ret;
+    if (!caps) return LINEERR_INVALPOINTER;
+    return check_device( device );
+}
