--- a/server/file.c
+++ b/server/file.c
@@ -505,6 +505,23 @@
     return new_mode;
 }
 
+/* Stained Glass OS (ADR 0013): the mode a new DACL maps to is applied by the
+ * server only for its own account. For another user it is handed back to
+ * that user's client (set_security_object's reply), which applies it with its
+ * own rights -- so only a file's owner can change its permissions, as the
+ * kernel intends, and never through the server's ownership of system files. */
+int sg_client_chmod = -1;
+
+int sg_set_unix_mode( int unix_fd, mode_t mode )
+{
+    if (current && current->process->peer_uid != getuid())
+    {
+        sg_client_chmod = mode & 07777;
+        return 0;
+    }
+    return fchmod( unix_fd, mode );
+}
+
 static int file_set_sd( struct object *obj, const struct security_descriptor *sd,
                         unsigned int set_info )
 {
@@ -546,7 +563,7 @@
         mode = st.st_mode & (S_ISUID|S_ISGID|S_ISVTX);
         mode |= sd_to_mode( sd, owner );
 
-        if (((st.st_mode ^ mode) & (S_IRWXU|S_IRWXG|S_IRWXO)) && fchmod( unix_fd, mode ) == -1)
+        if (((st.st_mode ^ mode) & (S_IRWXU|S_IRWXG|S_IRWXO)) && sg_set_unix_mode( unix_fd, mode ) == -1)
         {
             file_set_error();
             return 0;
--- a/server/handle.c
+++ b/server/handle.c
@@ -750,7 +750,10 @@
 
     if (!(obj = get_handle_obj( current->process, req->handle, access, NULL ))) return;
 
+    sg_client_chmod = -1;
     obj->ops->set_sd( obj, sd, req->security_info );
+    reply->unix_mode = get_error() ? -1 : sg_client_chmod;
+    sg_client_chmod = -1;
     release_object( obj );
 }
 
