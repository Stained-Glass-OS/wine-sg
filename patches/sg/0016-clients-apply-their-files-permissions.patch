From: Stained Glass OS <dev@stained-glass.example>
Subject: Clients apply their files' new permissions themselves

Part of Stained Glass ADR 0013 (multi-user debt D14). Setting a file's or
directory's DACL (SetFileSecurity, SetSecurityInfo, NtSetSecurityObject) maps
it to a Unix mode, which the server applied with fchmod() on its own
descriptor -- with the shared machine-level server's rights, which are
SYSTEM's. For another user that either failed (the user's own files are not
the server's to chmod, so standard users could not change their own files'
permissions) or, worse, could succeed on a file the server's account owns.

Now, for a client that is not the server's own Unix account, the server
computes the mode as before but returns it in set_security_object's reply
(unix_mode; -1 when there is nothing to apply) and the client applies it to
its own descriptor with fchmod(): the kernel then allows it only to the
file's owner. EPERM/EACCES/EROFS are reported as STATUS_ACCESS_DENIED.

Tested: advapi32:security and advapi32:lsa as the server's own user in an
ordinary prefix, no failures. As a second Unix user on a shared server,
advapi32:security's 13 SetNamedSecurityInfo/NtSetSecurityObject/
SetFileSecurity failures on the user's own files are gone; the 4 left are
token-model differences for a standard user (not an administrator), outside
file access.

--- a/server/protocol.def
+++ b/server/protocol.def
@@ -3506,6 +3506,8 @@
     obj_handle_t    handle;       /* handle to the object */
     unsigned int    security_info; /* which parts of security descriptor to set */
     VARARG(sd,security_descriptor); /* security descriptor to set */
+@REPLY
+    int             unix_mode;    /* a file's new Unix mode, for the client to apply; -1 if none */
 @END
 
 @REQ(get_security_object)
--- a/dlls/ntdll/unix/security.c
+++ b/dlls/ntdll/unix/security.c
@@ -23,9 +23,12 @@
 #pragma makedep unix
 #endif
 
+#include <errno.h>
 #include <stdarg.h>
 #include <stdlib.h>
 #include <string.h>
+#include <unistd.h>
+#include <sys/stat.h>
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
@@ -966,6 +969,7 @@
     data_size_t len;
     OBJECT_ATTRIBUTES attr;
     unsigned int status;
+    int unix_mode = -1;
 
     TRACE( "%p 0x%08x %p\n", handle, (int)info, descr );
 
@@ -994,9 +998,25 @@
         req->security_info = info;
         wine_server_add_data( req, sd, objattr->sd_len );
         status = wine_server_call( req );
+        unix_mode = reply->unix_mode;
     }
     SERVER_END_REQ;
     free( objattr );
+
+    /* Stained Glass OS (ADR 0013): a file's new permissions, which the server
+     * leaves to this process to apply with its own rights */
+    if (!status && unix_mode != -1)
+    {
+        int fd, needs_close;
+
+        if (!(status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )))
+        {
+            if (fchmod( fd, unix_mode ) == -1)
+                status = (errno == EPERM || errno == EACCES || errno == EROFS) ? STATUS_ACCESS_DENIED
+                                                                                 : errno_to_status( errno );
+            if (needs_close) close( fd );
+        }
+    }
     return status;
 }
 
