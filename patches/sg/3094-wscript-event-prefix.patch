From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 19:31:08 -0700
Subject: [PATCH] wscript: event sinks by prefix (CreateObject with a prefix,
 ConnectObject, DisconnectObject)

WScript.CreateObject(progid, prefix) and WScript.ConnectObject(object, prefix) connect the
object's default event interface (found through its class information) to a sink that calls
the script's procedure named prefix followed by the event's name, with the event's arguments;
an event the script has no procedure for is ignored. DisconnectObject ends the connection.

diff --git a/programs/wscript/host.c b/programs/wscript/host.c
index 2e6ed96..1ec2c15 100644
--- a/programs/wscript/host.c
+++ b/programs/wscript/host.c
@@ -24,6 +24,8 @@
 #include <windef.h>
 #include <winbase.h>
 #include <ole2.h>
+#include <ocidl.h>
+#include <activscp.h>
 
 #include "wscript.h"
 
@@ -281,6 +283,265 @@ static HRESULT WINAPI Host_put_Timeout(IHost *iface, LONG v)
     return E_NOTIMPL;
 }
 
+
+/*
+ * Events of objects a script makes with a prefix (CreateObject(progid, prefix),
+ * ConnectObject): the object's event interface is connected to a sink that
+ * calls the script's procedure named prefix + event.
+ */
+struct event_sink
+{
+    IDispatch IDispatch_iface;
+    LONG ref;
+    WCHAR *prefix;
+    IID iid;
+    ITypeInfo *typeinfo;        /* of the event interface */
+    IUnknown *object;           /* the source, by its identity */
+    IConnectionPoint *cp;
+    DWORD cookie;
+    struct event_sink *next;
+};
+
+static struct event_sink *event_sinks;
+
+static inline struct event_sink *impl_from_event_IDispatch(IDispatch *iface)
+{
+    return CONTAINING_RECORD(iface, struct event_sink, IDispatch_iface);
+}
+
+static HRESULT WINAPI EventSink_QueryInterface(IDispatch *iface, REFIID riid, void **ppv)
+{
+    struct event_sink *This = impl_from_event_IDispatch(iface);
+
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch) || IsEqualGUID(riid, &This->iid)) {
+        IDispatch_AddRef((*ppv = iface));
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EventSink_AddRef(IDispatch *iface)
+{
+    return InterlockedIncrement(&impl_from_event_IDispatch(iface)->ref);
+}
+
+static ULONG WINAPI EventSink_Release(IDispatch *iface)
+{
+    struct event_sink *This = impl_from_event_IDispatch(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref) {
+        ITypeInfo_Release(This->typeinfo);
+        IUnknown_Release(This->object);
+        IConnectionPoint_Release(This->cp);
+        free(This->prefix);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI EventSink_GetTypeInfoCount(IDispatch *iface, UINT *count)
+{
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI EventSink_GetTypeInfo(IDispatch *iface, UINT index, LCID lcid, ITypeInfo **ti)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI EventSink_GetIDsOfNames(IDispatch *iface, REFIID riid, LPOLESTR *names, UINT count,
+        LCID lcid, DISPID *ids)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI EventSink_Invoke(IDispatch *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *argerr)
+{
+    struct event_sink *This = impl_from_event_IDispatch(iface);
+    IDispatch *script_disp;
+    BSTR event_name;
+    WCHAR *name;
+    UINT n;
+    HRESULT hres;
+    DISPID proc;
+
+    if(!active_script)
+        return S_OK;
+    hres = ITypeInfo_GetNames(This->typeinfo, id, &event_name, 1, &n);
+    if(FAILED(hres) || !n)
+        return S_OK;
+
+    name = malloc((wcslen(This->prefix) + SysStringLen(event_name) + 1) * sizeof(WCHAR));
+    if(!name) {
+        SysFreeString(event_name);
+        return E_OUTOFMEMORY;
+    }
+    wcscpy(name, This->prefix);
+    wcscat(name, event_name);
+    SysFreeString(event_name);
+
+    hres = IActiveScript_GetScriptDispatch(active_script, NULL, &script_disp);
+    if(SUCCEEDED(hres)) {
+        hres = IDispatch_GetIDsOfNames(script_disp, &IID_NULL, &name, 1, lcid, &proc);
+        /* an event the script does not handle is not an error */
+        if(SUCCEEDED(hres))
+            hres = IDispatch_Invoke(script_disp, proc, &IID_NULL, lcid, DISPATCH_METHOD, params, result, excep, argerr);
+        else
+            hres = S_OK;
+        IDispatch_Release(script_disp);
+    }
+    free(name);
+    return hres;
+}
+
+static const IDispatchVtbl EventSinkVtbl = {
+    EventSink_QueryInterface,
+    EventSink_AddRef,
+    EventSink_Release,
+    EventSink_GetTypeInfoCount,
+    EventSink_GetTypeInfo,
+    EventSink_GetIDsOfNames,
+    EventSink_Invoke
+};
+
+/* the event interface of a coclass: its default source, with its type information */
+static HRESULT get_source_interface(IUnknown *object, IID *iid, ITypeInfo **source)
+{
+    IProvideClassInfo *info;
+    ITypeInfo *coclass;
+    TYPEATTR *attr;
+    HRESULT hres;
+    UINT i;
+
+    hres = IUnknown_QueryInterface(object, &IID_IProvideClassInfo, (void**)&info);
+    if(FAILED(hres))
+        return hres;
+    hres = IProvideClassInfo_GetClassInfo(info, &coclass);
+    IProvideClassInfo_Release(info);
+    if(FAILED(hres))
+        return hres;
+
+    hres = ITypeInfo_GetTypeAttr(coclass, &attr);
+    if(FAILED(hres)) {
+        ITypeInfo_Release(coclass);
+        return hres;
+    }
+    hres = E_NOINTERFACE;
+    for(i = 0; i < attr->cImplTypes; i++) {
+        INT flags;
+        HREFTYPE href;
+        ITypeInfo *ti;
+        TYPEATTR *ti_attr;
+
+        if(FAILED(ITypeInfo_GetImplTypeFlags(coclass, i, &flags)) || !(flags & IMPLTYPEFLAG_FSOURCE))
+            continue;
+        if(FAILED(ITypeInfo_GetRefTypeOfImplType(coclass, i, &href)) || FAILED(ITypeInfo_GetRefTypeInfo(coclass, href, &ti)))
+            continue;
+        if(SUCCEEDED(ITypeInfo_GetTypeAttr(ti, &ti_attr))) {
+            *iid = ti_attr->guid;
+            ITypeInfo_ReleaseTypeAttr(ti, ti_attr);
+            *source = ti;
+            hres = S_OK;
+            if(flags & IMPLTYPEFLAG_FDEFAULT)
+                break;
+            /* a source that is not the default is used only when there is no default */
+            ti = NULL;
+            continue;
+        }
+        ITypeInfo_Release(ti);
+    }
+    ITypeInfo_ReleaseTypeAttr(coclass, attr);
+    ITypeInfo_Release(coclass);
+    return hres;
+}
+
+static HRESULT connect_events(IDispatch *object, const WCHAR *prefix)
+{
+    IConnectionPointContainer *container;
+    struct event_sink *sink;
+    IUnknown *identity;
+    IID iid;
+    ITypeInfo *typeinfo = NULL;
+    HRESULT hres;
+
+    if(!prefix || !*prefix)
+        return S_OK;
+#ifdef SG_MUTANT_WSH_NO_EVENTS
+    return S_OK;
+#endif
+
+    hres = IDispatch_QueryInterface(object, &IID_IUnknown, (void**)&identity);
+    if(FAILED(hres))
+        return hres;
+    /* an object with no events has nothing to connect */
+    hres = get_source_interface(identity, &iid, &typeinfo);
+    if(FAILED(hres)) {
+        IUnknown_Release(identity);
+        return S_OK;
+    }
+    hres = IDispatch_QueryInterface(object, &IID_IConnectionPointContainer, (void**)&container);
+    if(FAILED(hres)) {
+        ITypeInfo_Release(typeinfo);
+        IUnknown_Release(identity);
+        return S_OK;
+    }
+
+    sink = calloc(1, sizeof(*sink));
+    if(!sink) {
+        IConnectionPointContainer_Release(container);
+        ITypeInfo_Release(typeinfo);
+        IUnknown_Release(identity);
+        return E_OUTOFMEMORY;
+    }
+    sink->IDispatch_iface.lpVtbl = &EventSinkVtbl;
+    sink->ref = 1;
+    sink->iid = iid;
+    sink->typeinfo = typeinfo;
+    sink->object = identity;
+    sink->prefix = wcsdup(prefix);
+
+    hres = IConnectionPointContainer_FindConnectionPoint(container, &iid, &sink->cp);
+    IConnectionPointContainer_Release(container);
+    if(SUCCEEDED(hres))
+        hres = IConnectionPoint_Advise(sink->cp, (IUnknown*)&sink->IDispatch_iface, &sink->cookie);
+    if(FAILED(hres)) {
+        if(sink->cp) IConnectionPoint_Release(sink->cp);
+        ITypeInfo_Release(typeinfo);
+        IUnknown_Release(identity);
+        free(sink->prefix);
+        free(sink);
+        return hres;
+    }
+    sink->next = event_sinks;
+    event_sinks = sink;
+    return S_OK;
+}
+
+static HRESULT disconnect_events(IDispatch *object)
+{
+    struct event_sink **link, *sink;
+    IUnknown *identity;
+    HRESULT hres;
+
+    hres = IDispatch_QueryInterface(object, &IID_IUnknown, (void**)&identity);
+    if(FAILED(hres))
+        return hres;
+    for(link = &event_sinks; (sink = *link); ) {
+        if(sink->object == identity) {
+            *link = sink->next;
+            IConnectionPoint_Unadvise(sink->cp, sink->cookie);
+            IDispatch_Release(&sink->IDispatch_iface);
+        }else
+            link = &sink->next;
+    }
+    IUnknown_Release(identity);
+    return S_OK;
+}
+
 static HRESULT WINAPI Host_CreateObject(IHost *iface, BSTR ProgID, BSTR Prefix,
         IDispatch **out_Dispatch)
 {
@@ -290,11 +551,6 @@ static HRESULT WINAPI Host_CreateObject(IHost *iface, BSTR ProgID, BSTR Prefix,
 
     TRACE("(%s %s %p)\n", wine_dbgstr_w(ProgID), wine_dbgstr_w(Prefix), out_Dispatch);
 
-    if(Prefix && *Prefix) {
-        FIXME("Prefix %s not supported\n", debugstr_w(Prefix));
-        return E_NOTIMPL;
-    }
-
     hres = CLSIDFromProgID(ProgID, &guid);
     if(FAILED(hres))
         return hres;
@@ -306,6 +562,13 @@ static HRESULT WINAPI Host_CreateObject(IHost *iface, BSTR ProgID, BSTR Prefix,
 
     hres = IUnknown_QueryInterface(unk, &IID_IDispatch, (void**)out_Dispatch);
     IUnknown_Release(unk);
+    if(SUCCEEDED(hres) && Prefix && *Prefix) {
+        hres = connect_events(*out_Dispatch, Prefix);
+        if(FAILED(hres)) {
+            IDispatch_Release(*out_Dispatch);
+            *out_Dispatch = NULL;
+        }
+    }
     return hres;
 }
 
@@ -389,8 +652,11 @@ static HRESULT WINAPI Host_GetObject(IHost *iface, BSTR Pathname, BSTR ProgID,
 
 static HRESULT WINAPI Host_DisconnectObject(IHost *iface, IDispatch *Object)
 {
-    WINE_FIXME("(%p)\n", Object);
-    return E_NOTIMPL;
+    TRACE("(%p)\n", Object);
+
+    if(!Object)
+        return E_INVALIDARG;
+    return disconnect_events(Object);
 }
 
 static HRESULT WINAPI Host_Sleep(IHost *iface, LONG Time)
@@ -404,8 +670,11 @@ static HRESULT WINAPI Host_Sleep(IHost *iface, LONG Time)
 
 static HRESULT WINAPI Host_ConnectObject(IHost *iface, IDispatch *Object, BSTR Prefix)
 {
-    WINE_FIXME("(%p %s)\n", Object, wine_dbgstr_w(Prefix));
-    return E_NOTIMPL;
+    TRACE("(%p %s)\n", Object, wine_dbgstr_w(Prefix));
+
+    if(!Object || !Prefix || !*Prefix)
+        return E_INVALIDARG;
+    return connect_events(Object, Prefix);
 }
 
 static HRESULT WINAPI Host_get_StdIn(IHost *iface, ITextStream **ppts)
diff --git a/programs/wscript/main.c b/programs/wscript/main.c
index 1257118..e94e893 100644
--- a/programs/wscript/main.c
+++ b/programs/wscript/main.c
@@ -353,6 +353,8 @@ static BSTR get_script_str(const WCHAR *filename)
     return ret;
 }
 
+IActiveScript *active_script;
+
 static void run_script(const WCHAR *filename, IActiveScript *script, IActiveScriptParse *parser)
 {
     BSTR text;
@@ -452,7 +454,9 @@ int WINAPI wWinMain(HINSTANCE hInst, HINSTANCE hPrevInst, LPWSTR cmdline, int cm
     }
 
     if(init_engine(script, parser)) {
+        active_script = script;
         run_script(filename, script, parser);
+        active_script = NULL;
         IActiveScript_Close(script);
         ITypeInfo_Release(host_ti);
     }else {
diff --git a/programs/wscript/wscript.h b/programs/wscript/wscript.h
index d624a2d..7ec4598 100644
--- a/programs/wscript/wscript.h
+++ b/programs/wscript/wscript.h
@@ -20,6 +20,9 @@
 
