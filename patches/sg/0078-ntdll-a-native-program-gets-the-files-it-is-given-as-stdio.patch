From: Stained Glass OS <dev@stained-glass.example>
Subject: ntdll: a native program gets the files it is given as stdio

A Windows program starting a native (Unix) program with STARTF_USESTDHANDLES
got nothing back when it had no console -- a GUI program, or
CREATE_NO_WINDOW: fork_and_exec detached the child and closed its stdin and
stdout, even when they were files it was given. Its standard error was
never passed at all. Now the files (and anything else with a Unix fd) it is
given are its stdin, stdout and stderr whether or not it is detached from
our console; a console it is not given is still not inherited.

Wine's pipes have no Unix fd, so a pipe is still not passed: programs use a
file (see include/wine/sgnetctl.h).

Gate: test/netsh-gate.sh (nativeio-probe: a console and a detached parent).
---
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -584,7 +584,8 @@
                                const RTL_USER_PROCESS_PARAMETERS *params )
 {
     pid_t pid;
-    int fd[2], stdin_fd = -1, stdout_fd = -1;
+    int fd[2], stdin_fd = -1, stdout_fd = -1, stderr_fd = -1;
+    BOOL stdin_handle, stdout_handle;  /* a pipe or a file was given, not a console */
     char **argv, **envp;
     char *unix_name;
     NTSTATUS status;
@@ -605,14 +606,19 @@
         fcntl( fd[1], F_SETFD, FD_CLOEXEC );
     }
 
-    if (wine_server_handle_to_fd( params->hStdInput, FILE_READ_DATA, &stdin_fd, NULL ) &&
+    if (!(stdin_handle = !wine_server_handle_to_fd( params->hStdInput, FILE_READ_DATA, &stdin_fd, NULL )) &&
         isatty(0) && is_unix_console_handle( params->hStdInput ))
         stdin_fd = 0;
 
-    if (wine_server_handle_to_fd( params->hStdOutput, FILE_WRITE_DATA, &stdout_fd, NULL ) &&
+    if (!(stdout_handle = !wine_server_handle_to_fd( params->hStdOutput, FILE_WRITE_DATA, &stdout_fd, NULL )) &&
         isatty(1) && is_unix_console_handle( params->hStdOutput ))
         stdout_fd = 1;
 
+    /* the standard error it was given, if a pipe or a file; otherwise it
+     * keeps ours, as before */
+    if (!params->hStdError || wine_server_handle_to_fd( params->hStdError, FILE_WRITE_DATA, &stderr_fd, NULL ))
+        stderr_fd = -1;
+
     if (!(pid = fork()))  /* child */
     {
         if (!(pid = fork()))  /* grandchild */
@@ -624,10 +630,17 @@
                 params->ConsoleHandle == CONSOLE_HANDLE_ALLOC_NO_WINDOW ||
                 params->ConsoleHandle == NULL)
             {
+                /* detached from our console -- but the pipes and files it
+                 * was given are its standard handles, as on Windows */
                 setsid();
-                set_stdio_fd( -1, -1 );  /* close stdin and stdout */
+                set_stdio_fd( stdin_handle ? stdin_fd : -1, stdout_handle ? stdout_fd : -1 );
             }
             else set_stdio_fd( stdin_fd, stdout_fd );
+            if (stderr_fd != -1 && stderr_fd != 2)
+            {
+                dup2( stderr_fd, 2 );
+                close( stderr_fd );
+            }
 
             if (stdin_fd != -1 && stdin_fd != 0) close( stdin_fd );
             if (stdout_fd != -1 && stdout_fd != 1) close( stdout_fd );
@@ -679,6 +692,7 @@
     close( fd[0] );
     if (stdin_fd != -1 && stdin_fd != 0) close( stdin_fd );
     if (stdout_fd != -1 && stdout_fd != 1) close( stdout_fd );
+    if (stderr_fd != -1) close( stderr_fd );
 done:
     free( unix_name );
     return status;
