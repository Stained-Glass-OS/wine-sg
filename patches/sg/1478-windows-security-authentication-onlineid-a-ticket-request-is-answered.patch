+
+HRESULT ticket_request_create( HSTRING service, HSTRING policy, IOnlineIdServiceTicketRequest **out )
+{
+    struct request *impl;
+
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IOnlineIdServiceTicketRequest_iface.lpVtbl = &request_vtbl;
+    impl->ref = 1;
+    WindowsDuplicateString( service, &impl->service );
+    WindowsDuplicateString( policy, &impl->policy );
+    *out = &impl->IOnlineIdServiceTicketRequest_iface;
+    return S_OK;
+}
