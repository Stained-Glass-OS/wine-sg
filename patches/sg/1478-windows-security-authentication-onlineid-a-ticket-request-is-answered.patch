+static inline struct request *impl_from_IOnlineIdServiceTicketRequest( IOnlineIdServiceTicketRequest *iface )
+{
+    return CONTAINING_RECORD( iface, struct request, IOnlineIdServiceTicketRequest_iface );
+}
+
+static HRESULT WINAPI request_QueryInterface( IOnlineIdServiceTicketRequest *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IOnlineIdServiceTicketRequest ))
+    {
+        *out = iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI request_AddRef( IOnlineIdServiceTicketRequest *iface )
+{
+    return InterlockedIncrement( &impl_from_IOnlineIdServiceTicketRequest( iface )->ref );
+}
+
+static ULONG WINAPI request_Release( IOnlineIdServiceTicketRequest *iface )
+{
+    struct request *impl = impl_from_IOnlineIdServiceTicketRequest( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->service );
+        WindowsDeleteString( impl->policy );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI request_GetIids( IOnlineIdServiceTicketRequest *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI request_GetRuntimeClassName( IOnlineIdServiceTicketRequest *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Security_Authentication_OnlineId_OnlineIdServiceTicketRequest,
+                                wcslen( RuntimeClass_Windows_Security_Authentication_OnlineId_OnlineIdServiceTicketRequest ),
+                                name );
+}
+
+static HRESULT WINAPI request_GetTrustLevel( IOnlineIdServiceTicketRequest *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI request_get_Service( IOnlineIdServiceTicketRequest *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( impl_from_IOnlineIdServiceTicketRequest( iface )->service, value );
