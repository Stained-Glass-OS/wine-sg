+}
+
+static HRESULT WINAPI info_get_ErrorCode( IAsyncInfo *iface, HRESULT *code )
+{
+    *code = S_OK;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_Cancel( IAsyncInfo *iface )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI info_Close( IAsyncInfo *iface )
+{
+    return S_OK;
+}
+
+static const IAsyncInfoVtbl info_vtbl =
+{
+    info_QueryInterface,
+    info_AddRef,
+    info_Release,
+    info_GetIids,
+    info_GetRuntimeClassName,
+    info_GetTrustLevel,
+    info_get_Id,
+    info_get_Status,
+    info_get_ErrorCode,
+    info_Cancel,
+    info_Close,
+};
+
+/* The answer to every ticket request: no ticket, and why. */
+HRESULT ticket_failed_operation( OnlineIdSystemTicketStatus status, HRESULT error,
+                                 IAsyncOperation_OnlineIdSystemTicketResult **out )
+{
+    struct operation *op;
+    struct result *res;
+
+    *out = NULL;
+    if (!(res = calloc( 1, sizeof(*res) ))) return E_OUTOFMEMORY;
+    res->IOnlineIdSystemTicketResult_iface.lpVtbl = &result_vtbl;
+    res->ref = 1;
+    res->status = status;
+    res->error = error;
+
+    if (!(op = calloc( 1, sizeof(*op) )))
+    {
+        free( res );
+        return E_OUTOFMEMORY;
+    }
+    op->IAsyncOperation_iface.lpVtbl = &operation_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    op->ref = 1;
+    op->result = &res->IOnlineIdSystemTicketResult_iface;
+    op->status = Completed;
+
+    *out = &op->IAsyncOperation_iface;
+    return S_OK;
+}
