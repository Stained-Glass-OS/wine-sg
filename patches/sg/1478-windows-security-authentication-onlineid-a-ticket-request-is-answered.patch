+/* the answer is ready before anyone can ask for it, so a handler is called at once */
+static HRESULT WINAPI operation_put_Completed( IAsyncOperation_OnlineIdSystemTicketResult *iface,
+                                               IAsyncOperationCompletedHandler_OnlineIdSystemTicketResult *handler )
+{
+    struct operation *impl = impl_from_IAsyncOperation( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (impl->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if (!handler) return S_OK;
+    IAsyncOperationCompletedHandler_OnlineIdSystemTicketResult_AddRef( (impl->handler = handler) );
+    IAsyncOperationCompletedHandler_OnlineIdSystemTicketResult_Invoke( handler, iface, impl->status );
+    return S_OK;
+}
+
+static HRESULT WINAPI operation_get_Completed( IAsyncOperation_OnlineIdSystemTicketResult *iface,
+                                               IAsyncOperationCompletedHandler_OnlineIdSystemTicketResult **handler )
+{
+    struct operation *impl = impl_from_IAsyncOperation( iface );
+
+    if ((*handler = impl->handler)) IAsyncOperationCompletedHandler_OnlineIdSystemTicketResult_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI operation_GetResults( IAsyncOperation_OnlineIdSystemTicketResult *iface,
+                                            IOnlineIdSystemTicketResult **results )
+{
+    struct operation *impl = impl_from_IAsyncOperation( iface );
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    IOnlineIdSystemTicketResult_AddRef( (*results = impl->result) );
+    return S_OK;
+}
