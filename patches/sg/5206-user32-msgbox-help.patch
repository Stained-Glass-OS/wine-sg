From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] user32: the Help button of a message box

Clicking the Help button of an MB_HELP message box sends WM_HELP with a
HELPINFO naming the button, to the callback or the owner; the WM_HELP handler
now reports the message as handled instead of letting the owner get it twice.
CORE: integrator must review (patches/notes/5206.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/user32/msgbox.c b/dlls/user32/msgbox.c
--- a/dlls/user32/msgbox.c
+++ b/dlls/user32/msgbox.c
@@ -389,8 +389,22 @@
       EndDialog(hwnd, wParam);
       break;
      case IDHELP:
-      FIXME("Help button not supported yet\n");
-      break;
+     {
+        /* the Help button is the same request as F1 on the message box: WM_HELP to the owner
+         * (or the callback), with the button as the item that asked */
+        HELPINFO hi;
+
+        hi.cbSize = sizeof(hi);
+        hi.iContextType = HELPINFO_WINDOW;
+        hi.iCtrlId = IDHELP;
+        hi.hItemHandle = GetDlgItem(hwnd, IDHELP);
+        hi.dwContextId = 0;
+        GetCursorPos(&hi.MousePos);
+#ifndef SG_MUTANT_MSGBOX_NOHELP
+        SendMessageW(hwnd, WM_HELP, 0, (LPARAM)&hi);
+#endif
+        break;
+     }
     }
     break;
 
@@ -406,7 +420,9 @@
             callback(&hi);
         else
             SendMessageW(GetWindow(hwnd, GW_OWNER), WM_HELP, 0, (LPARAM)&hi);
-	break;
+        /* handled: the dialog manager must not pass it on to the owner a second time */
+        SetWindowLongPtrW(hwnd, DWLP_MSGRESULT, TRUE);
+        return TRUE;
    }
 
    default:
