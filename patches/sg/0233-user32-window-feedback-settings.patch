From: Stained Glass OS <dev@stained-glass.example>
Subject: user32: SetWindowFeedbackSetting and GetWindowFeedbackSetting

Paint.NET turns off touch feedback on its windows at start, and the missing
export ended the process. There is no touch feedback to show or hide. The
settings are kept on the window as a property per feedback type; with none
set, GetWindowFeedbackSetting reports the system's (size 0).

Gate: test/wuicomp-gate.sh.
---
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -560,6 +560,76 @@
 }
 
 /**********************************************************************
+ * SetWindowFeedbackSetting [USER32.@]
+ *
+ * The visual feedback for touch and pen input (contact circles, flick
+ * arrows). There is none to show or hide; the settings are kept on the
+ * window, in a property per feedback type, for GetWindowFeedbackSetting.
+ */
+static void feedback_prop_name( FEEDBACK_TYPE feedback, WCHAR *name )
+{
+    swprintf( name, 32, L"__wine_feedback_%u", feedback );
+}
+
+BOOL WINAPI SetWindowFeedbackSetting( HWND hwnd, FEEDBACK_TYPE feedback, DWORD flags, UINT32 size,
+                                      const void *config )
+{
+    WCHAR name[32];
+
+    TRACE( "hwnd %p, feedback %u, flags %#lx, size %u, config %p.\n", hwnd, feedback, flags, size, config );
+
+    if (!IsWindow( hwnd ))
+    {
+        SetLastError( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    if ((size && size != sizeof(BOOL)) || (size && !config))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    feedback_prop_name( feedback, name );
+    if (!size)
+        RemovePropW( hwnd, name );
+    else
+        SetPropW( hwnd, name, (HANDLE)(ULONG_PTR)(*(const BOOL *)config ? 2 : 1) );
+    return TRUE;
+}
+
+/**********************************************************************
+ * GetWindowFeedbackSetting [USER32.@]
+ */
+BOOL WINAPI GetWindowFeedbackSetting( HWND hwnd, FEEDBACK_TYPE feedback, DWORD flags, UINT32 *size, void *config )
+{
+    WCHAR name[32];
+    ULONG_PTR value;
+
+    TRACE( "hwnd %p, feedback %u, flags %#lx, size %p, config %p.\n", hwnd, feedback, flags, size, config );
+
+    if (!IsWindow( hwnd ) || !size)
+    {
+        SetLastError( !size ? ERROR_INVALID_PARAMETER : ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    feedback_prop_name( feedback, name );
+    if (!(value = (ULONG_PTR)GetPropW( hwnd, name )))
+    {
+        /* nothing set on the window: the system's setting */
+        *size = 0;
+        return TRUE;
+    }
+    if (*size < sizeof(BOOL) || !config)
+    {
+        *size = sizeof(BOOL);
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    *(BOOL *)config = value == 2;
+    *size = sizeof(BOOL);
+    return TRUE;
+}
+
+/**********************************************************************
  * IsWindowArranged [USER32.@]
  *
  * Whether a window is snapped (arranged) by the shell. Nothing arranges
--- a/dlls/user32/user32.spec
+++ b/dlls/user32/user32.spec
@@ -704,7 +704,7 @@
 @ stdcall GetWindowDisplayAffinity(long ptr)
 @ stdcall GetWindowDpiAwarenessContext(long)
 @ stdcall GetWindowDpiHostingBehavior(long)
-# @ stub GetWindowFeedbackSetting
+@ stdcall GetWindowFeedbackSetting(long long long ptr ptr)
 @ stdcall GetWindowInfo(long ptr)
 @ stdcall GetWindowLongA(long long)
 @ stdcall -arch=win64 GetWindowLongPtrA(long long)
@@ -1108,7 +1108,7 @@
 # @ stub SetWindowCompositionTransition
 @ stdcall SetWindowContextHelpId(long long)
 @ stdcall SetWindowDisplayAffinity(long long)
-# @ stub SetWindowFeedbackSetting
+@ stdcall SetWindowFeedbackSetting(long long long long ptr)
 @ stdcall SetWindowLongA(long long long)
