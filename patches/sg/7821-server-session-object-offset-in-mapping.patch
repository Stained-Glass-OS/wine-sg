From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: a shared session object's locator is its offset in
 the whole mapping

---
 server/mapping.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/server/mapping.c b/server/mapping.c
index 5cd566a..310cef8 100644
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -1445,7 +1445,16 @@ const volatile void *alloc_shared_object(void)
 
         if (!(block = find_free_session_block( size ))) return NULL;
         object = (struct session_object *)(block->data + block->used_size);
+#ifndef SG_MUTANT_SESSION_OFFSET_IN_BLOCK
+        /* Stained Glass OS (wine-sg 7821): the offset in the whole mapping, as clients find the object --
+         * not in its block. In a block added when the mapping grew (grow_session_mapping) the object's
+         * locator pointed into the first block: the client read another object there ("Session object
+         * id doesn't match"), a desktop made after the growth had no shared memory, its processes no
+         * monitors, and a consent prompt's window was 0x0 on a black secure screen */
+        object->offset = block->offset + ((char *)&object->obj - block->data);
+#else
         object->offset = (char *)&object->obj - block->data;
+#endif
         block->used_size += size;
     }
 
