+static BOOL is_url(const char *s)
+{
+    return strstr(s, "://") != NULL;
+}
+
+/* fetch one component into the download directory */
+static HRESULT fetch_component(InstallEngine *This, struct component *c)
+{
+    char src[2 * MAX_PATH], dir[MAX_PATH], dest[MAX_PATH], *base;
+
+    if (!c->url || !*c->url) return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    if (is_url(c->url) || (c->url[0] && c->url[1] == ':') || c->url[0] == '\\' || c->url[0] == '/')
+        lstrcpynA(src, c->url, sizeof(src));
+    else if (This->base_url && *This->base_url)
+    {
+        lstrcpynA(src, This->base_url, sizeof(src));
+        if (src[0] && src[strlen(src) - 1] != '/' && src[strlen(src) - 1] != '\\') strcat(src, "/");
+        lstrcpynA(src + strlen(src), c->url, (int)(sizeof(src) - strlen(src)));
+    }
+    else if (This->cif_path)
+    {
+        lstrcpynA(src, This->cif_path, sizeof(src));
+        PathRemoveFileSpecA(src);
+        PathAppendA(src, c->url);
+    }
+    else
+        lstrcpynA(src, c->url, sizeof(src));
+
+    if (This->download_dir) lstrcpynA(dir, This->download_dir, MAX_PATH);
+    else GetTempPathA(MAX_PATH, dir);
+    CreateDirectoryA(dir, NULL);
+    base = strrchr(c->url, '/');
+    if (!base) base = strrchr(c->url, '\\');
+    PathCombineA(dest, dir, base ? base + 1 : c->url);
+
+    if (!strncmp(src, "file://", 7))
+    {
+        memmove(src, src + 7, strlen(src + 7) + 1);
+        if (src[0] == '/' && src[1] && src[2] == ':') memmove(src, src + 1, strlen(src));
+    }
+    if (is_url(src))
+    {
+        HMODULE urlmon = LoadLibraryA("urlmon.dll");
+        HRESULT (WINAPI *dl)(IUnknown *, const char *, const char *, DWORD, void *);
+        HRESULT hr;
+        dl = urlmon ? (void *)GetProcAddress(urlmon, "URLDownloadToFileA") : NULL;
+        if (!dl) { if (urlmon) FreeLibrary(urlmon); return E_FAIL; }
+        hr = dl(NULL, src, dest, 0, NULL);
+        FreeLibrary(urlmon);
+        if (FAILED(hr)) return hr;
+    }
+    else if (!CopyFileA(src, dest, FALSE))
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    free(c->local_path);
+    c->local_path = dup_a(dest);
+    c->downloaded = TRUE;
+    return S_OK;
+}
+
+static void wait_if_suspended(InstallEngine *This)
+{
+    while (This->suspended && !This->abort) Sleep(20);
+}
+
+typedef HRESULT (*component_op)(InstallEngine *, struct component *);
+
+static HRESULT run_components(InstallEngine *This, DWORD flags, DWORD running_status, component_op op, BOOL need_download)
+{
+    unsigned int i;
+    DWORD dl_total = 0, inst_total = 0;
+    HRESULT hr = S_OK;
+
+    if (!This->comps) return HRESULT_FROM_WIN32(ERROR_INVALID_STATE);
+
+    This->abort = FALSE;
+    for (i = 0; i < This->comp_count; i++)
+        if (This->comps[i].action == SG_ACTION_INSTALL)
+        {
+            dl_total += This->comps[i].dl_size;
+            inst_total += This->comps[i].inst_size;
+        }
+    set_status(This, running_status);
+    if (This->callback) IInstallEngineCallback_OnStartInstall(This->callback, dl_total, inst_total);
+
+    for (i = 0; i < This->comp_count && SUCCEEDED(hr); i++)
+    {
+        struct component *c = &This->comps[i];
+        if (c->action != SG_ACTION_INSTALL) continue;
+        if (need_download && c->downloaded && !(flags & 1)) continue;
+        wait_if_suspended(This);
+#ifndef SG_MUTANT_INSENG_ABORT
+        if (This->abort) { hr = E_ABORT; break; }
+#endif
+        if (This->callback)
+            IInstallEngineCallback_OnStartComponent(This->callback, c->id, c->dl_size, c->inst_size, c->id);
+        hr = op(This, c);
+#ifdef SG_MUTANT_INSENG_CB
+        if (0)
+#else
+        if (This->callback)
+#endif
+            IInstallEngineCallback_OnStopComponent(This->callback, c->id, hr, 0, NULL, 0);
+    }
+
+    if (This->callback)
+        IInstallEngineCallback_OnStopInstall(This->callback, hr, NULL, 0);
+    set_status(This, SUCCEEDED(hr) ? SG_ENGINE_DONE : SG_ENGINE_READY);
+    return hr;
+}
+
+static HRESULT download_op(InstallEngine *This, struct component *c)
+{
+    return fetch_component(This, c);
+}
+
+static HRESULT install_op(InstallEngine *This, struct component *c)
+{
+    char cmd[2 * MAX_PATH];
+    STARTUPINFOA si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    DWORD code = 0;
+
+    if (c->command && *c->command)
+    {
+        if (c->local_path)
+        {
+            char dir[MAX_PATH];
+            lstrcpynA(dir, c->local_path, MAX_PATH);
+            PathRemoveFileSpecA(dir);
+            snprintf(cmd, sizeof(cmd), "\"%s\\%s\"", dir, c->command);
+            if (GetFileAttributesA(cmd + 1) == INVALID_FILE_ATTRIBUTES)
+                lstrcpynA(cmd, c->command, sizeof(cmd));
+        }
+        else
+            lstrcpynA(cmd, c->command, sizeof(cmd));
+    }
+    else if (c->local_path)
+        snprintf(cmd, sizeof(cmd), "\"%s\"", c->local_path);
+    else
+        return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+
+    if (!CreateProcessA(NULL, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi))
+        return HRESULT_FROM_WIN32(GetLastError());
+    WaitForSingleObject(pi.hProcess, INFINITE);
+    GetExitCodeProcess(pi.hProcess, &code);
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    return code ? HRESULT_FROM_WIN32(code) : S_OK;
 }
 
