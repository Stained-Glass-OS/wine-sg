+static int parse_version(const char *s, unsigned int v[4])
+{
+    int n = 0;
+    memset(v, 0, 4 * sizeof(*v));
+    while (*s && n < 4)
+    {
+        v[n++] = strtoul(s, (char **)&s, 10);
+        if (*s == ',' || *s == '.') s++; else break;
+    }
+    return n;
+}
+
+static int cmp_version(const char *a, const char *b)
+{
+    unsigned int va[4], vb[4];
+    int i;
+    parse_version(a, va);
+    parse_version(b, vb);
+    for (i = 0; i < 4; i++)
+        if (va[i] != vb[i]) return va[i] < vb[i] ? -1 : 1;
+    return 0;
 }
 
