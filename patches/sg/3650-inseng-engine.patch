+static char *dup_a(const char *s)
+{
+    char *r;
+    if (!s) return NULL;
+    r = malloc(strlen(s) + 1);
+    if (r) strcpy(r, s);
+    return r;
+}
+
+static void free_components(InstallEngine *This)
+{
+    unsigned int i;
+    for (i = 0; i < This->comp_count; i++)
+    {
+        free(This->comps[i].id);
+        free(This->comps[i].guid);
+        free(This->comps[i].version);
+        free(This->comps[i].command);
+        free(This->comps[i].url);
+        free(This->comps[i].local_path);
+    }
+    free(This->comps);
+    This->comps = NULL;
+    This->comp_count = 0;
+}
+
+static char *read_key(const char *file, const char *section, const char *key)
+{
+    char buf[1024];
+    GetPrivateProfileStringA(section, key, "", buf, sizeof(buf), file);
+    return dup_a(buf);
+}
+
+/* Parse the INI style component information file: every section except
+ * [Version] describes one component. */
+static HRESULT load_cif(InstallEngine *This, const char *path)
+{
+    char *names, *p;
+    DWORD size = 4096, len;
+    unsigned int count = 0;
+    struct component *comps = NULL;
+
+    for (;;)
+    {
+        names = malloc(size);
+        if (!names) return E_OUTOFMEMORY;
+        len = GetPrivateProfileSectionNamesA(names, size, path);
+        if (len < size - 2) break;
+        free(names);
+        size *= 2;
+    }
+
+    for (p = names; *p; p += strlen(p) + 1)
+    {
+        struct component *c, *n;
+        char *sizes;
+
+        if (!lstrcmpiA(p, "Version")) continue;
+        n = realloc(comps, (count + 1) * sizeof(*comps));
+        if (!n) { free(names); This->comps = comps; This->comp_count = count; free_components(This); return E_OUTOFMEMORY; }
+        comps = n;
+        c = &comps[count++];
+        memset(c, 0, sizeof(*c));
+        c->id = dup_a(p);
+        c->guid = read_key(path, p, "GUID");
+        c->version = read_key(path, p, "Version");
+        c->command = read_key(path, p, "Command1");
+        c->url = read_key(path, p, "URL1");
+        if (c->url)
+        {
+            char *comma = strchr(c->url, ',');
+            if (comma) *comma = 0;
+        }
+        sizes = read_key(path, p, "Size");
+        if (sizes)
+        {
+            unsigned long a = 0, b = 0;
+            if (sscanf(sizes, "%lu,%lu", &a, &b) < 2) b = 0;
+            c->dl_size = a;
+            c->inst_size = b;
+            free(sizes);
+        }
+    }
+    free(names);
+
+    free_components(This);
+    This->comps = comps;
+    This->comp_count = count;
+    return S_OK;
+}
+
+static struct component *find_component(InstallEngine *This, const char *id)
+{
+    unsigned int i;
+    if (!id) return NULL;
+    for (i = 0; i < This->comp_count; i++)
+        if (!lstrcmpiA(This->comps[i].id, id)) return &This->comps[i];
+    return NULL;
+}
