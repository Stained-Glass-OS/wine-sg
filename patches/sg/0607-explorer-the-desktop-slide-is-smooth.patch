From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the desktop slide is smooth

David: switching desktops did not slide smoothly. The slide moved a
whole-screen window every 15 ms, and only the desktop being left moved.
Now a still window covers the work area and draws both desktops side by
side at the step's offset: the old one from the screen, the new one put
together after the switch from what the desktop and each of its windows
last drew (PrintWindow). Repainted every 10 ms.
---
--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -360,16 +360,21 @@
 }
 
 /* Stained Glass OS: switching desktops slides -- the desktop being left moves
- * off to the side, uncovering the other (David 2026-09-29: "apps panning when
- * you switch desktop"), as Windows 10 does. A picture of the work area rides a
- * topmost, click-through window that the switch happens under. With "Show
+ * off to the side and the other comes in beside it (David 2026-09-29: "apps
+ * panning when you switch desktop"; 2026-09-30: "not smooth"), as a PC
+ * does. A topmost, click-through window covers the work area and stays still;
+ * the switch happens under it; it draws both desktops' pictures, side by side
+ * at the step's offset -- the old one taken from the screen, the new one put
+ * together from what the desktop and each window last drew (PrintWindow).
+ * Moving a whole-screen window every step was what stuttered. With "Show
  * animations in Windows" on and HKCU\Software\Stained Glass\Effects
  * SlideDesktops (on unless 0). SG_DESKTOP_SLIDE_MS sets the length (gates). */
 static BOOL tv_animations(void);
 static HWND slide_wnd;
-static HBITMAP slide_bmp;
+static HBITMAP slide_bmp, slide_new;
 static DWORD slide_start;
-static int slide_dir, slide_w;
+static int slide_dir, slide_w, slide_h;
+static double slide_e;   /* how far along, eased: 0 to 1 */
 
 static int slide_ms(void)
 {
@@ -395,28 +400,34 @@
     {
         PAINTSTRUCT ps;
         HDC dc = BeginPaint( hwnd, &ps ), mdc = CreateCompatibleDC( dc );
-        RECT rc;
-        GetClientRect( hwnd, &rc );
+        int off = (int)(slide_w * slide_e);
+        /* the old desktop going, the new one coming in beside it */
         SelectObject( mdc, slide_bmp );
-        BitBlt( dc, 0, 0, rc.right, rc.bottom, mdc, 0, 0, SRCCOPY );
+        BitBlt( dc, -slide_dir * off, 0, slide_w, slide_h, mdc, 0, 0, SRCCOPY );
+        if (slide_new)
+        {
+            SelectObject( mdc, slide_new );
+            BitBlt( dc, slide_dir * (slide_w - off), 0, slide_w, slide_h, mdc, 0, 0, SRCCOPY );
+        }
         DeleteDC( mdc );
         EndPaint( hwnd, &ps );
         return 0;
     }
     case WM_TIMER:
     {
-        RECT work;
-        double t = (double)(GetTickCount() - slide_start) / slide_ms(), e;
+        double t;
+        if (!slide_new) return 0;   /* the switch has not happened yet */
+        t = (double)(GetTickCount() - slide_start) / slide_ms();
         if (t >= 1.0) { DestroyWindow( hwnd ); return 0; }
-        e = t * t * (3.0 - 2.0 * t);   /* smooth step */
-        SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
-        SetWindowPos( hwnd, HWND_TOPMOST, work.left - slide_dir * (int)(slide_w * e), work.top, 0, 0,
-                      SWP_NOSIZE | SWP_NOACTIVATE );
+        slide_e = t * t * (3.0 - 2.0 * t);   /* smooth step */
+        InvalidateRect( hwnd, NULL, FALSE );
+        UpdateWindow( hwnd );
         return 0;
     }
     case WM_DESTROY:
         if (slide_bmp) DeleteObject( slide_bmp );
-        slide_bmp = 0;
+        if (slide_new) DeleteObject( slide_new );
+        slide_bmp = slide_new = 0;
         slide_wnd = 0;
         return 0;
     case WM_NCHITTEST:
@@ -443,6 +454,9 @@
     }
     SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
     slide_w = work.right - work.left;
+    slide_h = work.bottom - work.top;
+    slide_e = 0;
+    slide_new = 0;
     screen = GetDC( 0 );
     mdc = CreateCompatibleDC( screen );
     slide_bmp = CreateCompatibleBitmap( screen, slide_w, work.bottom - work.top );
@@ -457,8 +471,62 @@
     if (!slide_wnd) { DeleteObject( slide_bmp ); slide_bmp = 0; return; }
     ShowWindow( slide_wnd, SW_SHOWNOACTIVATE );
     UpdateWindow( slide_wnd );
+    SetTimer( slide_wnd, 1, 10, NULL );
+}
+
+/* the windows of the desktop switched to, bottom first, put on the picture */
+struct compose { HDC dc; RECT work; HWND list[256]; int n; };
+
+static BOOL CALLBACK compose_proc( HWND hwnd, LPARAM lparam )
+{
+    struct compose *c = (struct compose *)lparam;
+    if (hwnd != slide_wnd && c->n < ARRAY_SIZE(c->list) && IsWindowVisible( hwnd ) && !IsIconic( hwnd ) &&
+        is_app_window( hwnd ) && !(GetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_TOPMOST) &&
+        (int)(INT_PTR)GetPropW( hwnd, prop_desktop ) - 1 == vd_current)
+        c->list[c->n++] = hwnd;   /* EnumWindows goes top first */
+    return TRUE;
+}
+
+/* After the switch: the new desktop's picture, and the slide starts */
+static void slide_go(void)
+{
+    struct compose c;
+    HDC screen, part;
+    HBITMAP bmp;
+    RECT rc;
+    int i;
+
+    if (!slide_wnd) return;
+    SystemParametersInfoW( SPI_GETWORKAREA, 0, &c.work, 0 );
+    screen = GetDC( 0 );
+    c.dc = CreateCompatibleDC( screen );
+    part = CreateCompatibleDC( screen );
+    slide_new = CreateCompatibleBitmap( screen, slide_w, slide_h );
+    SelectObject( c.dc, slide_new );
+    /* the desktop -- its picture and icons -- then the windows on it */
+    bmp = CreateCompatibleBitmap( screen, c.work.right, c.work.bottom );
+    SelectObject( part, bmp );
+    if (PrintWindow( GetDesktopWindow(), part, PW_RENDERFULLCONTENT ))
+        BitBlt( c.dc, 0, 0, slide_w, slide_h, part, c.work.left, c.work.top, SRCCOPY );
+    else
+        FillRect( c.dc, &(RECT){ 0, 0, slide_w, slide_h }, GetSysColorBrush( COLOR_DESKTOP ));
+    DeleteObject( bmp );
+    c.n = 0;
+    EnumWindows( compose_proc, (LPARAM)&c );
+    for (i = c.n - 1; i >= 0; i--)
+    {
+        if (!GetWindowRect( c.list[i], &rc ) || rc.right <= rc.left || rc.bottom <= rc.top) continue;
+        bmp = CreateCompatibleBitmap( screen, rc.right - rc.left, rc.bottom - rc.top );
+        SelectObject( part, bmp );
+        if (PrintWindow( c.list[i], part, PW_RENDERFULLCONTENT ))
+            BitBlt( c.dc, rc.left - c.work.left, rc.top - c.work.top, rc.right - rc.left, rc.bottom - rc.top,
+                    part, 0, 0, SRCCOPY );
+        DeleteObject( bmp );
+    }
+    DeleteDC( part );
+    DeleteDC( c.dc );
+    ReleaseDC( 0, screen );
     slide_start = GetTickCount();
-    SetTimer( slide_wnd, 1, 15, NULL );
 }
 
 void vd_switch( int d, BOOL indicate )
@@ -474,6 +542,7 @@
     EnumWindows( apply_proc, 0 );
     save_state();
     activate_top();
+    slide_go();
     taskbar_windows_changed();
     if (pager) InvalidateRect( pager, NULL, TRUE );
     if (indicate && !taskview) show_osd();
