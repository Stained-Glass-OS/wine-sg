From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: a thread stack's limit is the edge of the stack in use (6025)

The TEB StackLimit was the bottom of the reserve, so [StackLimit,
StackBase) was the whole stack: Crashpad (Chromium, Electron, Dropbox,
Spotify) dumped megabytes per thread, 436 MB per dump. As on Windows the
limit is now the top commit, with a guard page under it that moves down
as the stack grows; the kernel writing into that guard page grows the
stack too. The pages under it stay read-write (Wine's own large frames
are not probed), so frames below the limit are still valid frames.
---
diff --git a/dlls/ntdll/ntdll_misc.h b/dlls/ntdll/ntdll_misc.h
index fd44dd2..3800bcd 100644
--- a/dlls/ntdll/ntdll_misc.h
+++ b/dlls/ntdll/ntdll_misc.h
@@ -67,9 +67,14 @@ extern void WINAPI process_breakpoint(void);
 
 static inline BOOL is_valid_frame( ULONG_PTR frame )
 {
+    void *low = NtCurrentTeb()->Tib.StackLimit;
+
     if (frame & (sizeof(void*) - 1)) return FALSE;
-    return ((void *)frame >= NtCurrentTeb()->Tib.StackLimit &&
-            (void *)frame <= NtCurrentTeb()->Tib.StackBase);
+    /* Stained Glass OS: the stack limit follows the guard page down, and a frame that stepped over it (the
+     * pages under it are read-write here) is a frame of the stack too */
+    if (NtCurrentTeb()->DeallocationStack && NtCurrentTeb()->DeallocationStack < low)
+        low = NtCurrentTeb()->DeallocationStack;
+    return ((void *)frame >= low && (void *)frame <= NtCurrentTeb()->Tib.StackBase);
 }
 
 extern void WINAPI LdrInitializeThunk(CONTEXT*,ULONG_PTR,ULONG_PTR,ULONG_PTR);
diff --git a/dlls/ntdll/tests/virtual.c b/dlls/ntdll/tests/virtual.c
index f74c078..72bd94e 100644
--- a/dlls/ntdll/tests/virtual.c
+++ b/dlls/ntdll/tests/virtual.c
@@ -1023,7 +1023,7 @@ static DWORD WINAPI test_stack_size_thread(void *ptr)
 
     committed = (char *)NtCurrentTeb()->Tib.StackBase - (char *)NtCurrentTeb()->Tib.StackLimit;
     reserved = (char *)NtCurrentTeb()->Tib.StackBase - (char *)NtCurrentTeb()->DeallocationStack;
-    todo_wine ok( committed == 0x9000, "unexpected stack committed size %lx, expected 9000\n", committed );
+    ok( committed == 0x9000, "unexpected stack committed size %lx, expected 9000\n", committed );
     ok( reserved == args->expect_reserved, "unexpected stack reserved size %lx, expected %lx\n", reserved, args->expect_reserved );
 
 
@@ -1183,16 +1183,16 @@ static DWORD WINAPI test_stack_growth_thread(void *ptr)
     size = 0x1000;
     status = NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, PAGE_READWRITE | PAGE_GUARD, &prot );
     ok( !status, "NtProtectVirtualMemory returned %08lx\n", status );
-    todo_wine ok( prot == PAGE_READWRITE, "unexpected prot %#lx, expected %#x\n", prot, PAGE_READWRITE );
+    ok( prot == PAGE_READWRITE, "unexpected prot %#lx, expected %#x\n", prot, PAGE_READWRITE );
 
     committed = (char *)NtCurrentTeb()->Tib.StackBase - (char *)NtCurrentTeb()->Tib.StackLimit;
     todo_wine ok( committed == 0x6000, "unexpected stack committed size %lx, expected 6000\n", committed );
 
     status = NtQueryVirtualMemory( NtCurrentProcess(), (char *)addr - 0x2000, MemoryBasicInformation, &mbi, sizeof(mbi), &size );
     ok( !status, "NtQueryVirtualMemory returned %08lx\n", status );
-    todo_wine ok( mbi.RegionSize == 0x2000, "unexpected RegionSize %I64x, expected 2000\n", (UINT64)mbi.RegionSize );
+    ok( mbi.RegionSize == 0x2000, "unexpected RegionSize %I64x, expected 2000\n", (UINT64)mbi.RegionSize );
     ok( mbi.State == MEM_COMMIT, "unexpected State %#lx, expected %#x\n", mbi.State, MEM_COMMIT );
-    todo_wine ok( mbi.Protect == PAGE_READWRITE, "unexpected Protect %#lx, expected %#x\n", mbi.Protect, PAGE_READWRITE );
+    ok( mbi.Protect == PAGE_READWRITE, "unexpected Protect %#lx, expected %#x\n", mbi.Protect, PAGE_READWRITE );
 
     status = NtQueryVirtualMemory( NtCurrentProcess(), addr, MemoryBasicInformation, &mbi, sizeof(mbi), &size );
     ok( !status, "NtQueryVirtualMemory returned %08lx\n", status );
@@ -1205,7 +1205,7 @@ static DWORD WINAPI test_stack_growth_thread(void *ptr)
     ok( !status, "NtQueryVirtualMemory returned %08lx\n", status );
     todo_wine ok( mbi.RegionSize == 0x6000, "unexpected RegionSize %I64x, expected 6000\n", (UINT64)mbi.RegionSize );
     ok( mbi.State == MEM_COMMIT, "unexpected State %#lx, expected %#x\n", mbi.State, MEM_COMMIT );
-    todo_wine ok( mbi.Protect == PAGE_READWRITE, "unexpected Protect %#lx, expected %#x\n", mbi.Protect, PAGE_READWRITE );
+    ok( mbi.Protect == PAGE_READWRITE, "unexpected Protect %#lx, expected %#x\n", mbi.Protect, PAGE_READWRITE );
 
 
     /* clearing the guard pages doesn't change StackLimit back */
@@ -1216,7 +1216,7 @@ static DWORD WINAPI test_stack_growth_thread(void *ptr)
     size = 0x1000;
     status = NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, PAGE_READWRITE | PAGE_GUARD, &prot );
     ok( !status, "NtProtectVirtualMemory returned %08lx\n", status );
-    todo_wine ok( prot == PAGE_READWRITE, "unexpected prot %#lx, expected %#x\n", prot, PAGE_READWRITE );
+    ok( prot == PAGE_READWRITE, "unexpected prot %#lx, expected %#x\n", prot, PAGE_READWRITE );
 
     committed = (char *)NtCurrentTeb()->Tib.StackBase - (char *)NtCurrentTeb()->Tib.StackLimit;
     todo_wine ok( committed == 0x6000, "unexpected stack committed size %lx, expected 6000\n", committed );
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 9c5500c..565af84 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -3959,6 +3959,31 @@ NTSTATUS virtual_alloc_thread_stack( INITIAL_TEB *stack, ULONG_PTR limit_low, UL
     stack->DeallocationStack = view->base;
     stack->StackBase = (char *)view->base + view->size;
     stack->StackLimit = (char *)view->base + (guard_page ? 2 * page_size : 0);
+
+    /* Stained Glass OS: as on Windows, the limit is the edge of what the thread has used: the commit at the
+     * top, with a guard page under it that moves down as the stack grows (grow_thread_stack). Programs read
+     * [StackLimit, StackBase) as the stack in use -- Crashpad dumps it for every thread. Unlike Windows the
+     * pages under the guard page stay read-write: Wine's own code does not probe its large frames (its
+     * __chkstk does nothing), and a frame that steps over the guard page must not fault. */
+    if (guard_page)
+    {
+        SIZE_T top = max( (commit_size + page_mask) & ~page_mask, 0x4000 );
+
+#ifndef SG_MUTANT_STACK_LIMIT_BOTTOM
+        if (top + 4 * page_size <= view->size)
+        {
+            char *limit = (char *)stack->StackBase - top;
+
+            /* the region under the guard page is one read-write region, as Windows' reserve is one region;
+             * its lowest page still stops a runaway stack (no access, whatever the region says) */
+            set_page_vprot( view->base, limit - page_size - (char *)view->base, VPROT_READ | VPROT_WRITE | VPROT_COMMITTED );
+            set_page_vprot( limit - page_size, page_size, VPROT_READ | VPROT_WRITE | VPROT_COMMITTED | VPROT_GUARD );
+            mprotect_range( view->base, limit - (char *)view->base, 0, 0 );
+            mprotect( view->base, page_size, PROT_NONE );
+            stack->StackLimit = limit;
+        }
+#endif
+    }
 done:
     server_leave_uninterrupted_section( &virtual_mutex, &sigset );
     return status;
@@ -4162,11 +4187,17 @@ void *virtual_setup_exception( void *stack_ptr, size_t size, EXCEPTION_RECORD *r
     else if (stack < stack_info.limit)
     {
         mutex_lock( &virtual_mutex );  /* no need for signal masking inside signal handler */
-        if ((get_page_vprot( stack ) & VPROT_GUARD) &&
-            grow_thread_stack( ROUND_ADDR( stack, page_mask ), &stack_info ))
+        /* Stained Glass OS: the frame may reach past the guard page into the reserved pages: the stack
+         * grows down to it, a page at a time */
+        while (stack < stack_info.limit && (get_page_vprot( stack_info.limit - page_size ) & VPROT_GUARD))
         {
-            rec->ExceptionCode = STATUS_STACK_OVERFLOW;
-            rec->NumberParameters = 0;
+            if (grow_thread_stack( stack_info.limit - page_size, &stack_info ))
+            {
+                rec->ExceptionCode = STATUS_STACK_OVERFLOW;
+                rec->NumberParameters = 0;
+                break;
+            }
+            stack_info.limit -= page_size;
         }
         mutex_unlock( &virtual_mutex );
     }
@@ -4193,6 +4224,15 @@ static NTSTATUS check_write_access( void *base, size_t size, BOOL *has_write_wat
     for (i = 0; i < size; i += page_size)
     {
         BYTE vprot = get_page_vprot( addr + i );
+        struct thread_stack_info stack_info;
+
+        /* Stained Glass OS: the kernel writing into the guard page of the thread's stack grows the
+         * stack, as a fault there does (Windows' fault handler does the same for kernel-mode writes) */
+        if ((vprot & VPROT_GUARD) && is_inside_thread_stack( addr + i, &stack_info ))
+        {
+            grow_thread_stack( addr + i, &stack_info );
+            vprot = get_page_vprot( addr + i );
+        }
         if (vprot & VPROT_WRITEWATCH) *has_write_watch = TRUE;
         if (!(get_unix_prot( vprot & ~VPROT_WRITEWATCH ) & PROT_WRITE))
             return STATUS_INVALID_USER_BUFFER;
