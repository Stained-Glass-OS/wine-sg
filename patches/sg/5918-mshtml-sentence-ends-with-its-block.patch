From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mshtml: a text range sentence ends with its block

Found at integration (gate fastmshtmlunits, 3116's own): a sentence did not
end at the end of its paragraph, so moveEnd('sentence') from the last
sentence of a paragraph ran on into the next one ("Five six?Next para.").
move_next_char gives no character for a block boundary, so the comment
"or with the end of a block" of find_sentence_end was never true. The
sentence now also ends before the first character that lies in another
block element than the sentence's first character.

Mutant: SG_MUTANT_RANGE_SENTENCE_NOBLOCK (fastmshtmlunits).
---
diff --git a/dlls/mshtml/range.c b/dlls/mshtml/range.c
--- a/dlls/mshtml/range.c
+++ b/dlls/mshtml/range.c
@@ -810,11 +810,62 @@ static BOOL is_sentence_end_char(WCHAR c)
     return c == '.' || c == '!' || c == '?';
 }
 
+static BOOL is_block_elem(nsIDOMNode *node)
+{
+    static const WCHAR *blocks[] = { L"p", L"div", L"li", L"td", L"th", L"tr", L"table", L"h1", L"h2", L"h3",
+        L"h4", L"h5", L"h6", L"blockquote", L"pre", L"ul", L"ol", L"dl", L"dt", L"dd", L"address", L"center",
+        L"form", L"fieldset", L"body" };
+    unsigned int i;
+
+    if(get_node_type(node) != ELEMENT_NODE)
+        return FALSE;
+    for(i = 0; i < ARRAY_SIZE(blocks); i++)
+        if(is_elem_tag(node, blocks[i]))
+            return TRUE;
+    return FALSE;
+}
+
+/* The nearest block element holding the node (a reference), NULL when none. */
+static nsIDOMNode *get_block_ancestor(nsIDOMNode *node)
+{
+    nsIDOMNode *parent;
+
+    if(!node)
+        return NULL;
+    nsIDOMNode_AddRef(node);
+    while(node && !is_block_elem(node)) {
+        parent = NULL;
+        nsIDOMNode_GetParentNode(node, &parent);
+        nsIDOMNode_Release(node);
+        node = parent;
+    }
+    return node;
+}
+
+/* Does the character just passed (iter is after it) lie in another block than blk? */
+static BOOL left_block(const rangepoint_t *iter, nsIDOMNode *blk)
+{
+    nsIDOMNode *cur;
+    BOOL ret;
+
+#ifdef SG_MUTANT_RANGE_SENTENCE_NOBLOCK
+    return FALSE;
+#endif
+    if(iter->type != TEXT_NODE)
+        return FALSE;
+    cur = get_block_ancestor(iter->node);
+    ret = cur != blk;
+    if(cur)
+        nsIDOMNode_Release(cur);
+    return ret;
+}
+
 /* A sentence ends with ".", "!" or "?" and the white space that follows it, or
- * with the end of a block. */
+ * with the end of a block (the next character is in another paragraph). */
 static BOOL find_sentence_end(rangepoint_t *iter)
 {
     BOOL consumed = FALSE, term = FALSE, space = FALSE;
+    nsIDOMNode *blk = NULL; /* the block of the first character of the sentence */
     rangepoint_t prev;
     WCHAR c;
 
@@ -823,20 +874,29 @@ static BOOL find_sentence_end(rangepoint_t *iter)
         c = move_next_char(iter);
         if(!c) {
             free_rangepoint(&prev);
+            if(blk)
+                nsIDOMNode_Release(blk);
             return consumed;
         }
-        if(term && space && !iswspace(c)) {
+        if((term && space && !iswspace(c)) || (blk && !iswspace(c) && left_block(iter, blk))) {
             free_rangepoint(iter);
             *iter = prev;
+            if(blk)
+                nsIDOMNode_Release(blk);
             return TRUE;
         }
         free_rangepoint(&prev);
         consumed = TRUE;
-        if(c == '\n')
+        if(c == '\n') {
+            if(blk)
+                nsIDOMNode_Release(blk);
             return TRUE;
+        }
         if(iswspace(c)) {
             space = TRUE;
         }else {
+            if(!blk && iter->type == TEXT_NODE)
+                blk = get_block_ancestor(iter->node);
             term = is_sentence_end_char(c);
             space = FALSE;
         }
