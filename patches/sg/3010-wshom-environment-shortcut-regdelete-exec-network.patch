+static void key_event(WORD vk, BOOL up)
+{
+    INPUT input = { 0 };
+
+    input.type = INPUT_KEYBOARD;
+    input.ki.wVk = vk;
+    input.ki.wScan = MapVirtualKeyW(vk, MAPVK_VK_TO_VSC);
+    input.ki.dwFlags = up ? KEYEVENTF_KEYUP : 0;
+    if (vk == VK_RIGHT || vk == VK_LEFT || vk == VK_UP || vk == VK_DOWN || vk == VK_HOME || vk == VK_END ||
+            vk == VK_PRIOR || vk == VK_NEXT || vk == VK_INSERT || vk == VK_DELETE)
+        input.ki.dwFlags |= KEYEVENTF_EXTENDEDKEY;
+    SendInput(1, &input, sizeof(input));
+}
+
+static void send_vk(WORD vk, BYTE mods, int repeat)
+{
+    while (repeat--)
+    {
+        if (mods & 1) key_event(VK_SHIFT, FALSE);
+        if (mods & 2) key_event(VK_CONTROL, FALSE);
+        if (mods & 4) key_event(VK_MENU, FALSE);
+        key_event(vk, FALSE);
+        key_event(vk, TRUE);
+        if (mods & 4) key_event(VK_MENU, TRUE);
+        if (mods & 2) key_event(VK_CONTROL, TRUE);
+        if (mods & 1) key_event(VK_SHIFT, TRUE);
+    }
+}
+
+static void send_char(WCHAR ch, BYTE mods, int repeat)
+{
+    SHORT scan = VkKeyScanW(ch);
+
+    if (scan == -1)
+    {
+        INPUT input[2] = { { 0 } };
+
+        input[0].type = input[1].type = INPUT_KEYBOARD;
+        input[0].ki.wScan = input[1].ki.wScan = ch;
+        input[0].ki.dwFlags = KEYEVENTF_UNICODE;
+        input[1].ki.dwFlags = KEYEVENTF_UNICODE | KEYEVENTF_KEYUP;
+        while (repeat--) SendInput(2, input, sizeof(*input));
+        return;
+    }
+    send_vk(LOBYTE(scan), mods | ((HIBYTE(scan) & 1) ? 1 : 0) | ((HIBYTE(scan) & 2) ? 2 : 0) |
+            ((HIBYTE(scan) & 4) ? 4 : 0), repeat);
+}
+
+static const struct { const WCHAR *name; WORD vk; } sendkeys_names[] =
+{
+    { L"BACKSPACE", VK_BACK }, { L"BS", VK_BACK }, { L"BKSP", VK_BACK }, { L"BREAK", VK_CANCEL },
+    { L"CAPSLOCK", VK_CAPITAL }, { L"DELETE", VK_DELETE }, { L"DEL", VK_DELETE }, { L"DOWN", VK_DOWN },
+    { L"END", VK_END }, { L"ENTER", VK_RETURN }, { L"ESC", VK_ESCAPE }, { L"HELP", VK_HELP },
+    { L"HOME", VK_HOME }, { L"INSERT", VK_INSERT }, { L"INS", VK_INSERT }, { L"LEFT", VK_LEFT },
+    { L"NUMLOCK", VK_NUMLOCK }, { L"PGDN", VK_NEXT }, { L"PGUP", VK_PRIOR }, { L"PRTSC", VK_SNAPSHOT },
+    { L"RIGHT", VK_RIGHT }, { L"SCROLLLOCK", VK_SCROLL }, { L"TAB", VK_TAB }, { L"UP", VK_UP },
+};
