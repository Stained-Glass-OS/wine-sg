+static LSTATUS env_open_key(int type, REGSAM access, HKEY *key)
+{
+    switch (type)
+    {
+    case ENV_SYSTEM:
+        return RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment",
+                0, access, key);
+    case ENV_USER:
+        return RegOpenKeyExW(HKEY_CURRENT_USER, L"Environment", 0, access, key);
+    case ENV_VOLATILE:
+        return RegOpenKeyExW(HKEY_CURRENT_USER, L"Volatile Environment", 0, access, key);
+    }
+    return ERROR_INVALID_PARAMETER;
+}
+
+static void env_broadcast_change(void)
+{
+    DWORD_PTR result;
+
+    SendMessageTimeoutW(HWND_BROADCAST, WM_SETTINGCHANGE, 0, (LPARAM)L"Environment",
+            SMTO_ABORTIFHUNG, 200, &result);
+}
