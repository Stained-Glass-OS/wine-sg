+
+/* Collects the "NAME=value" strings of an environment. */
+static HRESULT env_collect(int type, BSTR **list, ULONG *count)
+{
+    BSTR *items = NULL;
+    ULONG n = 0, cap = 0;
+
+    *list = NULL;
+    *count = 0;
+
+#define ADD_ITEM(str) do { \
+        if (n + 1 >= cap) { \
+            BSTR *tmp = realloc(items, (cap = cap ? cap * 2 : 32) * sizeof(*items)); \
+            if (!tmp) goto nomem; \
+            items = tmp; \
+        } \
+        if (!(items[n] = (str))) goto nomem; \
+        n++; \
+    } while (0)
+
+    if (type == ENV_PROCESS)
+    {
+        WCHAR *env = GetEnvironmentStringsW(), *ptr;
+
+        if (!env) return E_OUTOFMEMORY;
+        for (ptr = env; *ptr; ptr += lstrlenW(ptr) + 1)
+        {
+            if (*ptr == '=') continue;
+            ADD_ITEM(SysAllocString(ptr));
+        }
+        FreeEnvironmentStringsW(env);
+    }
+    else
+    {
+        WCHAR name[256], *data;
+        DWORD namelen, datalen, valtype, index = 0;
+        HKEY key;
+
+        if (!env_open_key(type, KEY_QUERY_VALUE, &key))
+        {
+            DWORD maxdata;
+
+            RegQueryInfoKeyW(key, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, &maxdata, NULL, NULL);
+            if (!(data = malloc(maxdata + sizeof(WCHAR))))
+            {
+                RegCloseKey(key);
+                goto nomem;
+            }
+            for (;;)
+            {
+                namelen = ARRAY_SIZE(name);
+                datalen = maxdata;
+                if (RegEnumValueW(key, index++, name, &namelen, NULL, &valtype, (BYTE *)data, &datalen))
+                    break;
+                if (valtype != REG_SZ && valtype != REG_EXPAND_SZ) continue;
+                data[datalen / sizeof(WCHAR)] = 0;
+                {
+                    BSTR str = SysAllocStringLen(NULL, namelen + 1 + lstrlenW(data));
+
+                    if (str) swprintf(str, namelen + 2 + lstrlenW(data), L"%s=%s", name, data);
+                    ADD_ITEM(str);
+                }
+            }
+            free(data);
+            RegCloseKey(key);
+        }
+    }
+#undef ADD_ITEM
+
+    *list = items;
+    *count = n;
+    return S_OK;
+
+nomem:
+    while (n--) SysFreeString(items[n]);
+    free(items);
+    return E_OUTOFMEMORY;
 }
 
