+static HRESULT send_keys_string(const WCHAR *keys, BYTE group_mods, BYTE pending, const WCHAR **end)
+{
+    BYTE mods = pending;
+
+    while (*keys)
+    {
+        WCHAR ch = *keys++;
+
+        switch (ch)
+        {
+        case '+': mods |= 1; continue;
+        case '^': mods |= 2; continue;
+        case '%': mods |= 4; continue;
+        case '~': send_vk(VK_RETURN, mods | group_mods, 1); break;
+        case '(':
+        {
+            const WCHAR *close;
+            HRESULT hr = send_keys_string(keys, mods | group_mods, 0, &close);
+
+            if (FAILED(hr)) return hr;
+            keys = close;
+            break;
+        }
+        case ')':
+            if (end) *end = keys;
+            return S_OK;
+        case '{':
+        {
+            const WCHAR *close = wcschr(keys, '}'), *sp;
+            WCHAR name[16];
+            size_t len;
+            int repeat = 1;
+            unsigned int i;
+
+            if (close && close == keys) close = wcschr(keys + 1, '}'); /* "{}}" */
+            if (!close) return E_INVALIDARG;
+
+            len = close - keys;
+            for (sp = keys; sp < keys + len && *sp != ' '; sp++) ;
+            if (sp == keys + len) sp = NULL;
+            if (sp)
+            {
+                repeat = wcstol(sp + 1, NULL, 10);
+                len = sp - keys;
+            }
+            if (!len || len >= ARRAY_SIZE(name)) return E_INVALIDARG;
+            memcpy(name, keys, len * sizeof(WCHAR));
+            name[len] = 0;
+            keys = close + 1;
+
+            if (len == 1)
+            {
+                send_char(name[0], mods | group_mods, repeat);
+                break;
+            }
+            for (i = 0; i < ARRAY_SIZE(sendkeys_names); i++)
+                if (!wcsicmp(name, sendkeys_names[i].name)) break;
+            if (i < ARRAY_SIZE(sendkeys_names))
+                send_vk(sendkeys_names[i].vk, mods | group_mods, repeat);
+            else if ((name[0] == 'F' || name[0] == 'f') && wcstol(name + 1, NULL, 10) >= 1 &&
+                    wcstol(name + 1, NULL, 10) <= 16)
+                send_vk(VK_F1 + wcstol(name + 1, NULL, 10) - 1, mods | group_mods, repeat);
+            else
+                return E_INVALIDARG;
+            break;
+        }
+        default:
+            send_char(ch, mods | group_mods, 1);
+            break;
+        }
+        mods = 0;
+    }
+
+    if (end) *end = keys;
+    return S_OK;
+}
+
+static HRESULT send_keys(const WCHAR *keys, BOOL wait)
+{
+    HRESULT hr;
+
+    if (!keys) return E_POINTER;
+
+    hr = send_keys_string(keys, 0, 0, NULL);
+    if (wait) Sleep(50);
+    return hr;
+}
