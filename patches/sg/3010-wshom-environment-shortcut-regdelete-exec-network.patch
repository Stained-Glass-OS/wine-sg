+static BOOL CALLBACK activate_enum_proc(HWND hwnd, LPARAM lparam)
+{
+    struct activate_data *data = (struct activate_data *)lparam;
+    WCHAR text[256];
+    size_t len;
+
+    if (!IsWindowVisible(hwnd)) return TRUE;
+
+    if (!data->title)
+    {
+        DWORD pid;
+
+        GetWindowThreadProcessId(hwnd, &pid);
+        if (pid == data->pid && GetWindow(hwnd, GW_OWNER) == NULL)
+        {
+            data->found = hwnd;
+            return FALSE;
+        }
+        return TRUE;
+    }
+
+    if (!(len = GetWindowTextW(hwnd, text, ARRAY_SIZE(text)))) return TRUE;
+
+    switch (data->pass)
+    {
+    case 0:
+        if (len == data->len && !wcsicmp(text, data->title)) data->found = hwnd;
+        break;
+    case 1:
+        if (len >= data->len && !wcsnicmp(text, data->title, data->len)) data->found = hwnd;
+        break;
+    case 2:
+        if (len >= data->len && !wcsicmp(text + len - data->len, data->title)) data->found = hwnd;
+        break;
+    }
+    return !data->found;
