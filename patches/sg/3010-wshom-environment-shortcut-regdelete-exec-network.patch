+
+struct strenum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+    BSTR *items;
+    ULONG count;
+    ULONG pos;
+};
+
+static inline struct strenum *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, struct strenum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI strenum_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **obj)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), obj);
+
+    if (IsEqualIID(riid, &IID_IEnumVARIANT) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        IEnumVARIANT_AddRef(iface);
+        return S_OK;
+    }
+
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI strenum_AddRef(IEnumVARIANT *iface)
+{
+    struct strenum *This = impl_from_IEnumVARIANT(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI strenum_Release(IEnumVARIANT *iface)
+{
+    struct strenum *This = impl_from_IEnumVARIANT(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        ULONG i;
+
+        for (i = 0; i < This->count; i++)
+            SysFreeString(This->items[i]);
+        free(This->items);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI strenum_Next(IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched)
+{
+    struct strenum *This = impl_from_IEnumVARIANT(iface);
+    ULONG n = 0;
+
+    TRACE("%p, %lu, %p, %p.\n", iface, celt, var, fetched);
+
+    if (!var) return E_POINTER;
+
+    while (n < celt && This->pos < This->count)
+    {
+        V_VT(&var[n]) = VT_BSTR;
+        if (!(V_BSTR(&var[n]) = SysAllocString(This->items[This->pos])))
+        {
+            while (n--) VariantClear(&var[n]);
+            return E_OUTOFMEMORY;
+        }
+        This->pos++;
+        n++;
+    }
+
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI strenum_Skip(IEnumVARIANT *iface, ULONG celt)
+{
+    struct strenum *This = impl_from_IEnumVARIANT(iface);
+
+    TRACE("%p, %lu.\n", iface, celt);
+
+    if (celt > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI strenum_Reset(IEnumVARIANT *iface)
+{
+    struct strenum *This = impl_from_IEnumVARIANT(iface);
+
+    TRACE("%p.\n", iface);
+
+    This->pos = 0;
+    return S_OK;
+}
+
+static HRESULT strenum_create(BSTR *items, ULONG count, IEnumVARIANT **ret);
+
+static HRESULT WINAPI strenum_Clone(IEnumVARIANT *iface, IEnumVARIANT **ret)
+{
+    struct strenum *This = impl_from_IEnumVARIANT(iface);
+    BSTR *copy;
+    ULONG i;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, ret);
+
+    if (!ret) return E_POINTER;
+    if (!(copy = calloc(This->count + 1, sizeof(*copy)))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++)
+        copy[i] = SysAllocString(This->items[i]);
+
+    if (SUCCEEDED(hr = strenum_create(copy, This->count, ret)))
+        impl_from_IEnumVARIANT(*ret)->pos = This->pos;
+    return hr;
+}
+
+static const IEnumVARIANTVtbl strenumvtbl =
+{
+    strenum_QueryInterface,
+    strenum_AddRef,
+    strenum_Release,
+    strenum_Next,
+    strenum_Skip,
+    strenum_Reset,
+    strenum_Clone
+};
+
+/* Takes ownership of the array and of the strings. */
+static HRESULT strenum_create(BSTR *items, ULONG count, IEnumVARIANT **ret)
+{
+    struct strenum *This;
+
+    if (!(This = calloc(1, sizeof(*This))))
+    {
+        ULONG i;
+
+        for (i = 0; i < count; i++)
+            SysFreeString(items[i]);
+        free(items);
+        return E_OUTOFMEMORY;
+    }
+
+    This->IEnumVARIANT_iface.lpVtbl = &strenumvtbl;
+    This->ref = 1;
+    This->items = items;
+    This->count = count;
+    *ret = &This->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static BSTR *copy_strings(BSTR *items, ULONG count)
+{
+    BSTR *copy;
+    ULONG i;
+
+    if (!(copy = calloc(count + 1, sizeof(*copy)))) return NULL;
+    for (i = 0; i < count; i++)
+        copy[i] = SysAllocString(items[i]);
+    return copy;
+}
