 static HRESULT WINAPI WshEnvironment_get_Item(IWshEnvironment *iface, BSTR name, BSTR *value)
 {
     WshEnvironment *This = impl_from_IWshEnvironment(iface);
+    DWORD size, type;
+    HKEY key;
+    LSTATUS ret;
 
     TRACE("(%p)->(%s %p)\n", This, debugstr_w(name), value);
 
     if (!value)
         return E_POINTER;
 
-    return get_env_var(name, value);
+    if (This->type == ENV_PROCESS || !name)
+        return get_env_var(name, value);
+
+    *value = NULL;
+    if ((ret = env_open_key(This->type, KEY_QUERY_VALUE, &key)))
+        return get_env_var(NULL, value);
+
+    size = 0;
+    ret = RegQueryValueExW(key, name, NULL, &type, NULL, &size);
+    if (!ret && (type == REG_SZ || type == REG_EXPAND_SZ))
+    {
+        WCHAR *buf = malloc(size + sizeof(WCHAR));
+
+        if (!buf)
+        {
+            RegCloseKey(key);
+            return E_OUTOFMEMORY;
+        }
+        ret = RegQueryValueExW(key, name, NULL, &type, (BYTE *)buf, &size);
+        if (!ret)
+        {
+            buf[size / sizeof(WCHAR)] = 0;
+            *value = SysAllocString(buf);
+        }
+        free(buf);
+    }
+    RegCloseKey(key);
+
+    if (!*value)
+        *value = SysAllocStringLen(NULL, 0);
+    return *value ? S_OK : E_OUTOFMEMORY;
 }
 
