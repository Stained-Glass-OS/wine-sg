-     cbSignerInfoCountersignature, pciCountersigner);
-    return FALSE;
+    TRACE("(%08Ix, %08lx, %p, %ld, %p, %ld, %p)\n", hCryptProv, dwEncodingType, pbSignerInfo, cbSignerInfo,
+     pbSignerInfoCountersignature, cbSignerInfoCountersignature, pciCountersigner);
