+/* ---- countersignatures ---- */
+
+/* The countersignature of a signer is a signer of the signer's signature value: a detached
+ * signed message over those bytes, of which the signer is wanted. */
+BOOL WINAPI CryptMsgCountersignEncoded(DWORD dwEncodingType, PBYTE pbSignerInfo, DWORD cbSignerInfo,
+ DWORD cCountersigners, PCMSG_SIGNER_ENCODE_INFO rgCountersigners, PBYTE pbCountersignature,
+ PDWORD pcbCountersignature)
+{
+    CMSG_SIGNED_ENCODE_INFO info;
+    CMSG_SIGNER_INFO *signer = NULL;
+    HCRYPTMSG msg;
+    DWORD size;
+    BOOL ret = FALSE;
+
+    TRACE("(%08lx, %p, %ld, %ld, %p, %p, %p)\n", dwEncodingType, pbSignerInfo, cbSignerInfo, cCountersigners,
+     rgCountersigners, pbCountersignature, pcbCountersignature);
+
+    if (GET_CMSG_ENCODING_TYPE(dwEncodingType) != PKCS_7_ASN_ENCODING || cCountersigners != 1 || !rgCountersigners ||
+        !pcbCountersignature || !pbSignerInfo)
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (!CryptDecodeObjectEx(dwEncodingType, PKCS7_SIGNER_INFO, pbSignerInfo, cbSignerInfo, CRYPT_DECODE_ALLOC_FLAG,
+     NULL, &signer, &size))
+        return FALSE;
+    memset(&info, 0, sizeof(info));
+    info.cbSize = sizeof(info);
+    info.cSigners = cCountersigners;
+    info.rgSigners = rgCountersigners;
+    if ((msg = CryptMsgOpenToEncode(dwEncodingType, CMSG_DETACHED_FLAG, CMSG_SIGNED, &info, NULL, NULL)))
+    {
+        ret = CryptMsgUpdate(msg, signer->EncryptedHash.pbData, signer->EncryptedHash.cbData, TRUE) &&
+              CryptMsgGetParam(msg, CMSG_ENCODED_SIGNER, 0, pbCountersignature, pcbCountersignature);
+        CryptMsgClose(msg);
+    }
+    LocalFree(signer);
+    return ret;
+}
+
+BOOL WINAPI CryptMsgCountersign(HCRYPTMSG hCryptMsg, DWORD dwIndex, DWORD cCountersigners,
+ PCMSG_SIGNER_ENCODE_INFO rgCountersigners)
+{
+    BYTE *signer = NULL, *counter = NULL, *attr_enc = NULL;
+    DWORD signer_size = 0, counter_size = 0, attr_size = 0;
+    CRYPT_ATTRIBUTE attr;
+    CRYPT_ATTR_BLOB value;
+    CMSG_CTRL_ADD_SIGNER_UNAUTH_ATTR_PARA para;
+    BOOL ret = FALSE;
+
+    TRACE("(%p, %ld, %ld, %p)\n", hCryptMsg, dwIndex, cCountersigners, rgCountersigners);
+
+    if (!hCryptMsg || cCountersigners != 1 || !rgCountersigners)
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (!CryptMsgGetParam(hCryptMsg, CMSG_ENCODED_SIGNER, dwIndex, NULL, &signer_size) ||
+        !(signer = CryptMemAlloc(signer_size)) ||
+        !CryptMsgGetParam(hCryptMsg, CMSG_ENCODED_SIGNER, dwIndex, signer, &signer_size))
+        goto done;
+    if (!CryptMsgCountersignEncoded(PKCS_7_ASN_ENCODING, signer, signer_size, cCountersigners, rgCountersigners, NULL,
+     &counter_size) || !(counter = CryptMemAlloc(counter_size)) ||
+        !CryptMsgCountersignEncoded(PKCS_7_ASN_ENCODING, signer, signer_size, cCountersigners, rgCountersigners,
+         counter, &counter_size))
+        goto done;
+    value.cbData = counter_size;
+    value.pbData = counter;
+    attr.pszObjId = (char *)szOID_RSA_counterSign;
+    attr.cValue = 1;
+    attr.rgValue = &value;
+    if (!CryptEncodeObjectEx(PKCS_7_ASN_ENCODING, PKCS_ATTRIBUTE, &attr, CRYPT_ENCODE_ALLOC_FLAG, NULL, &attr_enc,
+     &attr_size))
+        goto done;
+    para.cbSize = sizeof(para);
+    para.dwSignerIndex = dwIndex;
+    para.blob.cbData = attr_size;
+    para.blob.pbData = attr_enc;
+    ret = CryptMsgControl(hCryptMsg, 0, CMSG_CTRL_ADD_SIGNER_UNAUTH_ATTR, &para);
+done:
+    LocalFree(attr_enc);
+    CryptMemFree(counter);
+    CryptMemFree(signer);
+    return ret;
+}
