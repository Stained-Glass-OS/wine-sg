+/* A countersignature signs the signature value of the signer it counters: its hash is made of
+ * those bytes (or, with authenticated attributes, of the attributes, which then hold the
+ * hash of those bytes as their message digest). */
+static BOOL verify_countersignature(HCRYPTPROV_LEGACY hCryptProv, DWORD dwEncodingType, BYTE *pbSignerInfo,
+ DWORD cbSignerInfo, BYTE *pbCounter, DWORD cbCounter, CERT_PUBLIC_KEY_INFO *keyInfo)
+{
+    CMSG_SIGNER_INFO *signer = NULL, *counter = NULL;
+    HCRYPTHASH hash = 0, attrHash = 0, sigHash;
+    HCRYPTPROV prov = hCryptProv;
+    BOOL ret = FALSE;
+    DWORD size;
+    ALG_ID alg;
+
+    if (GET_CMSG_ENCODING_TYPE(dwEncodingType) != PKCS_7_ASN_ENCODING)
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (!CryptDecodeObjectEx(dwEncodingType, PKCS7_SIGNER_INFO, pbSignerInfo, cbSignerInfo, CRYPT_DECODE_ALLOC_FLAG,
+     NULL, &signer, &size) ||
+        !CryptDecodeObjectEx(dwEncodingType, PKCS7_SIGNER_INFO, pbCounter, cbCounter, CRYPT_DECODE_ALLOC_FLAG, NULL,
+         &counter, &size))
+        goto done;
+    if (!(alg = CertOIDToAlgId(counter->HashAlgorithm.pszObjId)))
+    {
+        SetLastError(CRYPT_E_UNKNOWN_ALGO);
+        goto done;
+    }
+    if (!prov) prov = I_CryptGetDefaultCryptProv(alg);
+    if (!CryptCreateHash(prov, alg, 0, 0, &hash) ||
+        !CryptHashData(hash, signer->EncryptedHash.pbData, signer->EncryptedHash.cbData, 0))
+        goto done;
+    sigHash = hash;
+    if (counter->AuthAttrs.cAttr)
+    {
+        DWORD i, digestSize = 0;
+        BYTE *digest = NULL;
+        CRYPT_DATA_BLOB *wanted = NULL;
+        BYTE *encodedAttrs;
+        BOOL found = FALSE;
+
+        for (i = 0; i < counter->AuthAttrs.cAttr; i++)
+        {
+            CRYPT_ATTRIBUTE *attr = &counter->AuthAttrs.rgAttr[i];
+
+            if (strcmp(attr->pszObjId, szOID_RSA_messageDigest) || attr->cValue != 1) continue;
+            if (CryptDecodeObjectEx(X509_ASN_ENCODING, X509_OCTET_STRING, attr->rgValue[0].pbData,
+             attr->rgValue[0].cbData, CRYPT_DECODE_ALLOC_FLAG, NULL, &wanted, &size))
+                found = TRUE;
+            break;
+        }
+        if (!found)
+        {
+            SetLastError(CRYPT_E_AUTH_ATTR_MISSING);
+            goto done;
+        }
+        CryptGetHashParam(hash, HP_HASHVAL, NULL, &digestSize, 0);
+        if ((digest = CryptMemAlloc(digestSize)))
+            CryptGetHashParam(hash, HP_HASHVAL, digest, &digestSize, 0);
+#ifdef SG_MUTANT_CS_NODIGEST
+        if (0)
+#else
+        if (!digest || wanted->cbData != digestSize || memcmp(wanted->pbData, digest, digestSize))
+#endif
+        {
+            CryptMemFree(digest);
+            LocalFree(wanted);
+            SetLastError(CRYPT_E_HASH_VALUE);
+            goto done;
+        }
+        CryptMemFree(digest);
+        LocalFree(wanted);
+        if (!CryptEncodeObjectEx(X509_ASN_ENCODING, PKCS_ATTRIBUTES, &counter->AuthAttrs, CRYPT_ENCODE_ALLOC_FLAG, NULL,
+         &encodedAttrs, &size))
+            goto done;
+        ret = CryptCreateHash(prov, alg, 0, 0, &attrHash) && CryptHashData(attrHash, encodedAttrs, size, 0);
+        LocalFree(encodedAttrs);
+        if (!ret) goto done;
+        ret = FALSE;
+#ifndef SG_MUTANT_CS_NOATTRHASH
+        sigHash = attrHash;
+#endif
+    }
+    if (!keyInfo)
+        ret = TRUE;  /* no signer to check the signature against */
+    else
+    {
+        HCRYPTKEY key;
+        CRYPT_HASH_BLOB reversed;
+
+        if (CryptImportPublicKeyInfo(prov, X509_ASN_ENCODING, keyInfo, &key))
+        {
+            if (CRYPT_ConstructBlob(&reversed, &counter->EncryptedHash))
+            {
+                CRYPT_ReverseBytes(&reversed);
+#ifdef SG_MUTANT_CS_NOSIG
+                ret = TRUE;
+#else
+                ret = CryptVerifySignatureW(sigHash, reversed.pbData, reversed.cbData, key, NULL, 0);
+#endif
+                CryptMemFree(reversed.pbData);
+            }
+            CryptDestroyKey(key);
+        }
+    }
+done:
+    if (attrHash) CryptDestroyHash(attrHash);
+    if (hash) CryptDestroyHash(hash);
+    LocalFree(signer);
+    LocalFree(counter);
+    return ret;
+}
+
