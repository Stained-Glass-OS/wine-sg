+/* ---- CryptEnumOIDFunction (Stained Glass OS) ---- */
+
+static const char oid_root_key[] = "Software\\Microsoft\\Cryptography\\OID";
+
+/* the callback is given the values of one registered function (a registry key) */
+static BOOL enum_oid_values(HKEY key, DWORD encoding, const char *func, const char *oid, void *arg,
+ PFN_CRYPT_ENUM_OID_FUNC callback)
+{
+    DWORD count = 0, max_name = 0, max_data = 0, i;
+    DWORD *types = NULL, *sizes = NULL;
+    WCHAR **names = NULL;
+    BYTE **datas = NULL;
+    BOOL ret = TRUE;
+    LPCSTR oid_arg = oid;
+
+    if (RegQueryInfoKeyW(key, NULL, NULL, NULL, NULL, NULL, NULL, &count, &max_name, &max_data, NULL, NULL))
+        return TRUE;
+    if (count)
+    {
+        types = CryptMemAlloc(count * sizeof(*types));
+        sizes = CryptMemAlloc(count * sizeof(*sizes));
+        names = CryptMemAlloc(count * sizeof(*names));
+        datas = CryptMemAlloc(count * sizeof(*datas));
+        if (!types || !sizes || !names || !datas)
+        {
+            ret = TRUE;
+            goto done;
+        }
+        memset(names, 0, count * sizeof(*names));
+        memset(datas, 0, count * sizeof(*datas));
+    }
+    for (i = 0; i < count; i++)
+    {
+        DWORD name_len = max_name + 1, data_len = max_data;
+
+        names[i] = CryptMemAlloc((max_name + 1) * sizeof(WCHAR));
+        datas[i] = CryptMemAlloc(max_data + sizeof(WCHAR));
+        if (!names[i] || !datas[i]) { count = i; break; }
+        if (RegEnumValueW(key, i, names[i], &name_len, NULL, &types[i], datas[i], &data_len))
+        {
+            count = i;
+            break;
+        }
+        sizes[i] = data_len;
+        memset(datas[i] + data_len, 0, sizeof(WCHAR));  /* strings are read as terminated */
+    }
+    /* a numeric OID is passed as the number, as the registry name "#n" stands for it */
+    if (oid[0] == '#' && oid[1]) oid_arg = (LPCSTR)(DWORD_PTR)strtoul(oid + 1, NULL, 10);
+    ret = callback(encoding, func, oid_arg, count, types, (LPCWSTR const *)names, (const BYTE * const *)datas, sizes, arg);
+done:
+    for (i = 0; names && i < count; i++) { CryptMemFree(names[i]); CryptMemFree(datas[i]); }
+    CryptMemFree(types);
+    CryptMemFree(sizes);
+    CryptMemFree(names);
+    CryptMemFree(datas);
+    return ret;
+}
+
+/* Goes through the registered OID functions: the encoding types (all of them when
+ * the given one is CRYPT_MATCH_ANY_ENCODING_TYPE), function names and OIDs matching
+ * the arguments (a NULL name or OID matches any), the callback getting each one's values.
+ * The DEFAULT entries of a function are among them. It stops when the callback returns
+ * FALSE, and the call then fails with that. */
+BOOL WINAPI CryptEnumOIDFunction(DWORD dwEncodingType, LPCSTR pszFuncName, LPCSTR pszOID, DWORD dwFlags, void *pvArg,
+ PFN_CRYPT_ENUM_OID_FUNC pfnEnumOIDFunc)
+{
+    HKEY root;
+    DWORD ti, fi, oi, enc_matches = 0;
+    char type_name[64], func_name[256], oid_name[256], numeric[16];
+    const char *want_oid = pszOID;
+    BOOL ret = TRUE;
+    LONG rc;
+
+    TRACE("(%lx, %s, %s, %lx, %p, %p)\n", dwEncodingType, debugstr_a(pszFuncName), debugstr_a(pszOID), dwFlags, pvArg,
+     pfnEnumOIDFunc);
+
+    if (dwFlags || !pfnEnumOIDFunc)
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (pszOID && IS_INTOID(pszOID))
+    {
+        snprintf(numeric, sizeof(numeric), "#%d", LOWORD(pszOID));
+        want_oid = numeric;
+    }
+    if ((rc = RegOpenKeyExA(HKEY_LOCAL_MACHINE, oid_root_key, 0, KEY_READ, &root)))
+        return TRUE;  /* nothing is registered */
+
+    for (ti = 0; ret && !RegEnumKeyA(root, ti, type_name, sizeof(type_name)); ti++)
+    {
+        DWORD type;
+        HKEY type_key;
+
+        if (strncmp(type_name, "EncodingType ", 13)) continue;
+        type = strtoul(type_name + 13, NULL, 10);
+        if (dwEncodingType != CRYPT_MATCH_ANY_ENCODING_TYPE && GET_CERT_ENCODING_TYPE(dwEncodingType) != type) continue;
+        enc_matches++;
+        if (RegOpenKeyExA(root, type_name, 0, KEY_READ, &type_key)) continue;
+        for (fi = 0; ret && !RegEnumKeyA(type_key, fi, func_name, sizeof(func_name)); fi++)
+        {
+            HKEY func_key;
+
+            if (pszFuncName && stricmp(pszFuncName, func_name)) continue;
+            if (RegOpenKeyExA(type_key, func_name, 0, KEY_READ, &func_key)) continue;
+            for (oi = 0; ret && !RegEnumKeyA(func_key, oi, oid_name, sizeof(oid_name)); oi++)
+            {
+                HKEY oid_key;
+
+                if (want_oid && stricmp(want_oid, oid_name)) continue;
+                if (RegOpenKeyExA(func_key, oid_name, 0, KEY_READ, &oid_key)) continue;
+#ifdef SG_MUTANT_ENUM_ONEONLY
+                if (oi) { RegCloseKey(oid_key); continue; }
+#endif
+                ret = enum_oid_values(oid_key, type, func_name, oid_name, pvArg, pfnEnumOIDFunc);
+                RegCloseKey(oid_key);
+            }
+            RegCloseKey(func_key);
+        }
+        RegCloseKey(type_key);
+    }
+    RegCloseKey(root);
+    return ret;
+}
