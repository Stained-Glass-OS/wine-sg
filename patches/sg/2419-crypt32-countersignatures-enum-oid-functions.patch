+
+/* CMSG_CTRL_ADD_SIGNER_UNAUTH_ATTR on a decoded signed message: the attribute (an encoded
+ * CRYPT_ATTRIBUTE) joins the signer's unauthenticated attributes. The message's own
+ * encoded form is unchanged; the signer, as CMSG_ENCODED_SIGNER or
+ * CMSG_SIGNER_UNAUTH_ATTR_PARAM give it, carries the attribute. */
+static BOOL CDecodeSignedMsg_AddUnauthAttr(CDecodeMsg *msg, const CMSG_CTRL_ADD_SIGNER_UNAUTH_ATTR_PARA *para)
+{
+    CRYPT_SIGNED_INFO *info = msg->u.signed_data.info;
+    CRYPT_ATTRIBUTE *attr = NULL, *array, **list;
+    CMSG_CMS_SIGNER_INFO *signer;
+    DWORD size, count;
+
+    if (para->cbSize != sizeof(*para))
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (!info)
+    {
+        SetLastError(CRYPT_E_INVALID_MSG_TYPE);
+        return FALSE;
+    }
+    if (para->dwSignerIndex >= info->cSignerInfo)
+    {
+        SetLastError(CRYPT_E_INVALID_INDEX);
+        return FALSE;
+    }
+    if (!CryptDecodeObjectEx(X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, PKCS_ATTRIBUTE, para->blob.pbData,
+     para->blob.cbData, CRYPT_DECODE_ALLOC_FLAG, NULL, &attr, &size))
+        return FALSE;
+    if (!msg->owned_attr_arrays)
+    {
+        if (!(msg->owned_attr_arrays = CryptMemAlloc(info->cSignerInfo * sizeof(*msg->owned_attr_arrays))))
+            goto nomem;
+        memset(msg->owned_attr_arrays, 0, info->cSignerInfo * sizeof(*msg->owned_attr_arrays));
+        msg->n_owned_arrays = info->cSignerInfo;
+    }
+    signer = &info->rgSignerInfo[para->dwSignerIndex];
+    count = signer->UnauthAttrs.cAttr;
+    if (!(array = CryptMemAlloc((count + 1) * sizeof(*array)))) goto nomem;
+    if (count) memcpy(array, signer->UnauthAttrs.rgAttr, count * sizeof(*array));
+    array[count] = *attr;
+    if (!(list = CryptMemRealloc(msg->added_attrs, (msg->n_added_attrs + 1) * sizeof(*list))))
+    {
+        CryptMemFree(array);
+        goto nomem;
+    }
+    msg->added_attrs = list;
+    msg->added_attrs[msg->n_added_attrs++] = attr;
+    CryptMemFree(msg->owned_attr_arrays[para->dwSignerIndex]);
+    msg->owned_attr_arrays[para->dwSignerIndex] = array;
+#ifdef SG_MUTANT_CS_REPLACE
+    array[0] = array[count];
+    count = 0;
+#endif
+    signer->UnauthAttrs.cAttr = count + 1;
+    signer->UnauthAttrs.rgAttr = array;
+    return TRUE;
+nomem:
+    LocalFree(attr);
+    SetLastError(ERROR_OUTOFMEMORY);
+    return FALSE;
+}
