From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: Open the named GPU in D3DKMTOpenAdapterFromDeviceName.

D3DKMTOpenAdapterFromDeviceName opens the GPU that a
GUID_DISPLAY_DEVICE_ARRIVAL interface path names, with that GPU's LUID, and
refuses GUID_DEVINTERFACE_DISPLAY_ADAPTER paths and other names with
STATUS_INVALID_PARAMETER, as the gdi32 driver test shows on Windows. It
opened the first adapter for any name. Two todo marks removed.

Gate: test/win32u-openadaptername-gate.sh (64/32, private Xvfb).
---
 dlls/gdi32/tests/driver.c    |  4 ++--
 dlls/win32u/d3dkmt.c         |  7 ++++++-
 dlls/win32u/sysparams.c      | 37 +++++++++++++++++++++++++++++++++++++
 dlls/win32u/win32u_private.h |  1 +
 4 files changed, 46 insertions(+), 3 deletions(-)

diff --git a/dlls/gdi32/tests/driver.c b/dlls/gdi32/tests/driver.c
index df33b71..60de9a7 100644
--- a/dlls/gdi32/tests/driver.c
+++ b/dlls/gdi32/tests/driver.c
@@ -918,7 +918,7 @@ static void test_D3DKMTOpenAdapterFromDeviceName_deviface(const GUID *devinterfa
             if (ret)
             {
                 ret = RtlEqualLuid( &luid, &device_name.AdapterLuid);
-                todo_wine ok(ret, "Luid does not match.\n");
+                ok(ret, "Luid does not match.\n");
             }
             else
             {
@@ -958,7 +958,7 @@ static void test_D3DKMTOpenAdapterFromDeviceName(void)
     ok(status == STATUS_INVALID_PARAMETER, "Got unexpected status %#lx.\n", status);
 
     winetest_push_context("GUID_DEVINTERFACE_DISPLAY_ADAPTER");
-    test_D3DKMTOpenAdapterFromDeviceName_deviface(&GUID_DEVINTERFACE_DISPLAY_ADAPTER, STATUS_INVALID_PARAMETER, TRUE);
+    test_D3DKMTOpenAdapterFromDeviceName_deviface(&GUID_DEVINTERFACE_DISPLAY_ADAPTER, STATUS_INVALID_PARAMETER, FALSE);
     winetest_pop_context();
 
     winetest_push_context("GUID_DISPLAY_DEVICE_ARRIVAL");
diff --git a/dlls/win32u/d3dkmt.c b/dlls/win32u/d3dkmt.c
index 331f17a..4118b85 100644
--- a/dlls/win32u/d3dkmt.c
+++ b/dlls/win32u/d3dkmt.c
@@ -203,11 +203,16 @@ NTSTATUS WINAPI NtGdiDdDDIOpenAdapterFromDeviceName( D3DKMT_OPENADAPTERFROMDEVIC
     D3DKMT_OPENADAPTERFROMLUID desc_luid;
     NTSTATUS status;
 
-    FIXME( "desc %p stub.\n", desc );
+    TRACE( "desc %p\n", desc );
 
     if (!desc || !desc->pDeviceName) return STATUS_INVALID_PARAMETER;
 
     memset( &desc_luid, 0, sizeof(desc_luid) );
+#ifndef SG_MUTANT_OPENADAPTER_NAME_ANY
+    /* the GPU of a display device arrival interface (gdi32 driver tests) */
+    if (!get_gpu_luid_from_interface_path( desc->pDeviceName, &desc_luid.AdapterLuid ))
+        return STATUS_INVALID_PARAMETER;
+#endif
     if ((status = NtGdiDdDDIOpenAdapterFromLuid( &desc_luid ))) return status;
 
     desc->AdapterLuid = desc_luid.AdapterLuid;
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index 497c269..83d4661 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -3477,6 +3477,43 @@ BOOL get_display_source_luid( const WCHAR *name, LUID *luid, UINT *source_id )
     return ret;
 }
 
+/* The LUID of the GPU a GUID_DISPLAY_DEVICE_ARRIVAL interface path
+ * (\\?\PCI#VEN_...#...#{1CA05180-...}) names; other interfaces, the display
+ * adapter one among them, name no adapter (D3DKMTOpenAdapterFromDeviceName). */
+BOOL get_gpu_luid_from_interface_path( const WCHAR *path, LUID *luid )
+{
+    char instance[MAX_PATH];
+    const WCHAR *guid;
+    struct gpu *gpu;
+    UINT i, len;
+    BOOL ret = FALSE;
+
+    static const WCHAR prefixW[] = {'\\','\\','?','\\'};
+
+    if (wcsncmp( path, prefixW, 4 ) || !(guid = wcsrchr( path, '#' ))) return FALSE;
+    len = guid - (path + 4);
+    if (len >= ARRAY_SIZE(instance) || wcslen( guid + 1 ) != strlen( guid_display_device_arrivalA )) return FALSE;
+    for (i = 0; guid_display_device_arrivalA[i]; i++)
+        if (towupper( guid[1 + i] ) != (unsigned char)guid_display_device_arrivalA[i]) return FALSE;
+    for (i = 0; i < len; i++)
+    {
+        if (path[4 + i] > 0x7f) return FALSE;
+        instance[i] = path[4 + i] == '#' ? '\\' : path[4 + i];
+    }
+    instance[len] = 0;
+
+    if (!lock_display_devices( FALSE )) return FALSE;
+    LIST_FOR_EACH_ENTRY(gpu, &gpus, struct gpu, entry)
+    {
+        if (strcasecmp( gpu->path, instance )) continue;
+        *luid = gpu->luid;
+        ret = TRUE;
+        break;
+    }
+    unlock_display_devices();
+    return ret;
+}
+
 /* Find and acquire the source matching name, or primary source if name is NULL.
  * If not NULL, the returned source needs to be released with source_release.
  */
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
index 15960dd..c19dfaf 100644
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -225,6 +225,7 @@ extern BOOL system_dpi_follows_scale(void);
 extern void post_display_change(void);
 extern BOOL update_display_cache( BOOL force );
 extern BOOL get_display_source_luid( const WCHAR *name, LUID *luid, UINT *source_id );
+extern BOOL get_gpu_luid_from_interface_path( const WCHAR *path, LUID *luid );
 extern void reset_monitor_update_serial(void);
 extern void user_lock(void);
 extern void user_unlock(void);
