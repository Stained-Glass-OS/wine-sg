From: Stained Glass OS <dev@stained-glass.example>
Subject: winex11: national keys have their layout's scan codes; the tables follow a layout switch

Three things kept Wine's keyboard tables from matching the X layout:

- In a UTF-8 locale X11DRV_InitKeyboard never matched a key whose keysym
  is not ASCII: XkbTranslateKeySym gives no single byte for it, and the
  fallback was 0, while the layout tables (and X11DRV_KEYBOARD_DetectLayout,
  whose fallback is the keysym's low byte) are in each layout's ISO-8859 code
  page. So German ß ü ö ä, French é è à ç ù ... got a spare virtual key
  and a made-up scan code (0x60 up): MapVirtualKeyEx from their real scan
  codes answered 0, and an on-screen keyboard (or a program sending scan
  codes) could not reach them. It now takes the low byte, as DetectLayout.
- Dead keys never reached the matching (only keys that produce characters
  did), and the German table had no entry for the acute/grave key: it has
  them now.
- A program is not always given a MappingNotify when the layout changes
  (setxkbmap, a layout switch in the session) -- Xlib reads the new XKB map
  by itself -- or gets it before Xlib has the new map; its tables stayed the
  old layout's while its keysyms were the new one's, so a German Z typed Y.
  The keysyms the tables were built from are kept, compared (locally, no
  server round trip) before the tables are used, and the tables built again
  when they differ.

Gates: test/kbdlayout-gate.sh (make test-kbdlayout); sg-shell's
test/osk-layout-check.sh (the On-Screen Keyboard's labels and typing across
US, German and French; without the rebuild a German Z types y).
---
diff --git a/dlls/winex11.drv/keyboard.c b/dlls/winex11.drv/keyboard.c
index 7b7371e..d46b366 100644
--- a/dlls/winex11.drv/keyboard.c
+++ b/dlls/winex11.drv/keyboard.c
@@ -68,6 +68,33 @@ static int NumLockMask, ScrollLockMask, AltGrMask; /* mask in the XKeyEvent stat
 
 static pthread_mutex_t kbd_mutex = PTHREAD_MUTEX_INITIALIZER;
 
+/* Stained Glass OS: the keysyms the tables were built from. When the X
+ * keyboard layout changes (setxkbmap, a layout switch in the session), Xlib
+ * reads the new XKB map by itself, but a program is not always given a
+ * MappingNotify -- or gets it before Xlib has the new map -- and kept the
+ * previous layout's virtual keys and scan codes while its keysyms were the
+ * new layout's (German Z typed as Y). Before the tables are used they are
+ * compared with the keysyms now (a local lookup, no server round trip) and
+ * built again when they differ. */
+static KeySym keyc2sym[256][2];
+
+static void check_keyboard_mapping( Display *display )
+{
+    int keyc;
+    BOOL changed = FALSE;
+
+    pthread_mutex_lock( &kbd_mutex );
+    for (keyc = min_keycode; keyc <= max_keycode && keyc < 256 && !changed; keyc++)
+        changed = XkbKeycodeToKeysym( display, keyc, 0, 0 ) != keyc2sym[keyc][0] ||
+                  XkbKeycodeToKeysym( display, keyc, 0, 1 ) != keyc2sym[keyc][1];
+    pthread_mutex_unlock( &kbd_mutex );
+    if (changed)
+    {
+        TRACE( "the keyboard mapping changed: building the tables again\n" );
+        X11DRV_InitKeyboard( display );
+    }
+}
+
 static char KEYBOARD_MapDeadKeysym(KeySym keysym);
 
 /* Keyboard translation tables */
@@ -283,7 +310,7 @@ static const char main_key_IS[MAIN_LEN][4] =
 /*** German keyboard layout (setxkbmap de [-variant nodeadkeys|deadacute etc.]) */
 static const char main_key_DE[MAIN_LEN][4] =
 {
- "^\xb0","1!","2\"","3\xa7","4$","5%","6&","7/","8(","9)","0=","\xdf?","",
+ "^\xb0","1!","2\"","3\xa7","4$","5%","6&","7/","8(","9)","0=","\xdf?","\xb4`",
  "qQ","wW","eE","rR","tT","zZ","uU","iI","oO","pP","\xfc\xdc","+*",
  "aA","sS","dD","fF","gG","hH","jJ","kK","lL","\xf6\xd6","\xe4\xc4","#'",
  "yY","xX","cC","vV","bB","nN","mM",",;",".:","-_",
@@ -1337,6 +1364,8 @@ BOOL X11DRV_KeyEvent( HWND hwnd, XEvent *xev )
     DWORD event_time = EVENT_x11_time_to_win32_time(event->time);
     Status status = 0;
 
+    check_keyboard_mapping( event->display );
+
     TRACE_(key)("type %d, window %lx, state 0x%04x, keycode %u\n",
 		event->type, event->window, event->state, event->keycode);
 
@@ -1635,8 +1664,11 @@ void X11DRV_InitKeyboard( Display *display )
             } else if (keysym == 0x20) {                 /* Spacebar */
 	        vkey = VK_SPACE;
 		scan = 0x39;
-	    } else if (have_chars) {
-	      /* we seem to need to search the layout-dependent scancodes */
+	    } else if (have_chars || KEYBOARD_MapDeadKeysym(keysym)) {
+	      /* we seem to need to search the layout-dependent scancodes
+	       * (Stained Glass OS: dead keys too -- the tables have their accents,
+	       * as DetectLayout reads them; without this the German ´ key got
+	       * no scan code) */
 	      int maxlen=0,maxval=-1,ok;
 	      for (i=0; i<syms; i++) {
 		keysym = XkbKeycodeToKeysym( display, keyc, 0, i );
@@ -1644,11 +1676,14 @@ void X11DRV_InitKeyboard( Display *display )
                 {
                     if (!XkbTranslateKeySym(display, &keysym, 0, &ckey[i], 1, NULL))
                     {
-                        /* FIXME: query what keysym is used as Mode_switch, fill XKeyEvent
-                         * with appropriate ShiftMask and Mode_switch, use XLookupString
-                         * to get character in the local encoding.
-                         */
-                        ckey[i] = (keysym <= 0x7F) ? keysym : 0;
+                        /* Stained Glass OS: as X11DRV_KEYBOARD_DetectLayout does. The
+                         * layout tables are in each layout's ISO-8859 code page, which
+                         * is the low byte of X's Latin-n keysyms; in a UTF-8 locale
+                         * XkbTranslateKeySym gives no single byte for them, and the
+                         * national keys (German ß ü ö ä ´, French é è à ...) never
+                         * matched their table entry: they got a spare virtual key and a
+                         * made-up scan code instead of their layout's. */
+                        ckey[i] = keysym & 0xFF;
                     }
 		} else {
 		  ckey[i] = KEYBOARD_MapDeadKeysym(keysym);
@@ -1799,6 +1834,11 @@ void X11DRV_InitKeyboard( Display *display )
 	keyc2scan[keyc]=scan++;
       }
 
+    for (keyc = min_keycode; keyc <= max_keycode && keyc < 256; keyc++)
+    {
+        keyc2sym[keyc][0] = XkbKeycodeToKeysym( display, keyc, 0, 0 );
+        keyc2sym[keyc][1] = XkbKeycodeToKeysym( display, keyc, 0, 1 );
+    }
     pthread_mutex_unlock( &kbd_mutex );
 }
 
@@ -1853,6 +1893,8 @@ SHORT X11DRV_VkKeyScanEx( WCHAR wChar, HKL hkl )
     CHAR cChar;
     SHORT ret;
 
+    check_keyboard_mapping( display );
+
     /* FIXME: what happens if wChar is not a Latin1 character and CP_UNIXCP
      * is UTF-8 (multibyte encoding)?
      */
@@ -1932,6 +1974,7 @@ UINT X11DRV_MapVirtualKeyEx( UINT wCode, UINT wMapType, HKL hkl )
     int keyc;
     Display *display = thread_init_display();
 
+    check_keyboard_mapping( display );
     TRACE("wCode=0x%x, wMapType=%d, hkl %p\n", wCode, wMapType, hkl);
 
     pthread_mutex_lock( &kbd_mutex );
@@ -2077,6 +2120,8 @@ INT X11DRV_GetKeyNameText( LONG lParam, LPWSTR lpBuffer, INT nSize )
   KeySym keys;
   char *name;
 
+  check_keyboard_mapping( display );
+
   scanCode = lParam >> 16;
   scanCode &= 0x1ff;  /* keep "extended-key" flag with code */
 
@@ -2295,6 +2340,8 @@ INT X11DRV_ToUnicodeEx( UINT virtKey, UINT scanCode, const BYTE *lpKeyState,
     XIC xic;
     Status status = 0;
 
+    check_keyboard_mapping( display );
+
     if (scanCode & 0x8000)
     {
         TRACE_(key)("Key UP, doing nothing\n" );
