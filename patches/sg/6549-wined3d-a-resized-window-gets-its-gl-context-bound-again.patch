From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wined3d: A resized window gets its GL context bound again (6549)

Mesa's software rasterizer (llvmpipe through drisw: machines and VMs
without a GPU driver, Xvfb) learns a window's new size only when a context
is bound to it or a frame is swapped; DRI3 drivers hear the window's
ConfigureNotify, drisw does not. ddraw's windowed primary draws into the
front buffer and never swaps. A program that went back from exclusive
fullscreen to DDSCL_NORMAL while its window was still screen-sized, and
then shrank the window (SDL 1.2's directx driver: DOSBox, Alt+Enter twice),
kept a context sized for the screen: every frame was placed for the old
height, below the shrunk window, which kept showing its last picture.

The context notes its window's client size whenever it is bound. When it
is activated for the window (onscreen) and the size changed since, it is
unbound and bound again, which makes the driver ask for the new size.
---
diff --git a/dlls/wined3d/context_gl.c b/dlls/wined3d/context_gl.c
index e150e2b..a7aa810 100644
--- a/dlls/wined3d/context_gl.c
+++ b/dlls/wined3d/context_gl.c
@@ -1258,6 +1258,37 @@ success:
     return TRUE;
 }
 
+/* Stained Glass OS (wine-sg 6549): a GL driver may learn a window's new size only when a
+ * context is bound to it or a frame is swapped. Mesa's software rasterizer (llvmpipe, used by
+ * machines and VMs without a GPU driver) keeps the old size until then. ddraw draws to the
+ * front buffer of a windowed primary and never swaps, so after a program left exclusive mode
+ * and shrank its window again (DOSBox and other SDL 1.2 programs going back from fullscreen),
+ * every frame was placed for the old size: off the window, which kept its last picture.
+ * The client size is noted whenever the context is bound; this returns TRUE when it changed
+ * since. */
+static void wined3d_context_gl_note_drawable_size(struct wined3d_context_gl *context_gl)
+{
+    RECT rect;
+
+    if (context_gl->window && GetClientRect(context_gl->window, &rect))
+    {
+        context_gl->sg_drawable_size.cx = rect.right;
+        context_gl->sg_drawable_size.cy = rect.bottom;
+    }
+}
+
+static BOOL wined3d_context_gl_drawable_size_changed(struct wined3d_context_gl *context_gl)
+{
+    RECT rect;
+
+    if (!context_gl->window || context_gl->dc_is_private || !GetClientRect(context_gl->window, &rect))
+        return FALSE;
+#ifdef SG_MUTANT_GL_NO_REBIND_ON_RESIZE
+    return FALSE;
+#endif
+    return rect.right != context_gl->sg_drawable_size.cx || rect.bottom != context_gl->sg_drawable_size.cy;
+}
+
 static BOOL wined3d_context_gl_set_gl_context(struct wined3d_context_gl *context_gl)
 {
     struct wined3d_device_gl *device_gl = wined3d_device_gl(context_gl->c.device);
@@ -1316,6 +1347,7 @@ static BOOL wined3d_context_gl_set_gl_context(struct wined3d_context_gl *context
         context_gl->valid = 1;
     }
     context_gl->needs_set = 0;
+    wined3d_context_gl_note_drawable_size(context_gl);
 
     return TRUE;
 }
@@ -4302,6 +4334,15 @@ static void wined3d_context_gl_activate(struct wined3d_context_gl *context_gl,
         if (!wined3d_context_gl_set_current(context_gl))
             ERR("Failed to activate the new context.\n");
     }
+    else if (texture && !wined3d_resource_is_offscreen(&texture->resource)
+            && wined3d_context_gl_drawable_size_changed(context_gl))
+    {
+        /* The window was resized while this context stayed current on it: bind it again. */
+        TRACE("Window %p client size changed from %ldx%ld, binding context %p again.\n", context_gl->window,
+                context_gl->sg_drawable_size.cx, context_gl->sg_drawable_size.cy, context_gl);
+        wglMakeCurrent(NULL, NULL);
+        wined3d_context_gl_set_gl_context(context_gl);
+    }
     else if (context_gl->needs_set)
     {
         wined3d_context_gl_set_gl_context(context_gl);
diff --git a/dlls/wined3d/wined3d_gl.h b/dlls/wined3d/wined3d_gl.h
index 24d7ebf..a5717fc 100644
--- a/dlls/wined3d/wined3d_gl.h
+++ b/dlls/wined3d/wined3d_gl.h
@@ -632,6 +632,7 @@ struct wined3d_context_gl
     HDC dc;
     int pixel_format;
     HWND window;
+    SIZE sg_drawable_size; /* wine-sg 6549: client size the GL drawable was last bound at */
     GLint aux_buffers;
 
     /* FBOs. */
