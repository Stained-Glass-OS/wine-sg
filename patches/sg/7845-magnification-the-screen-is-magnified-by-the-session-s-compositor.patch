+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/un.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "unixlib.h"
+
+/* The compositor draws the magnified screen (sg-compositor's magnifier.c): a
+ * MAGNIFY connection on its control socket says what to show, a line each,
+ * and magnification lasts as long as the connection does -- so it ends with
+ * the process that asked for it, however that ends. Nothing comes back but
+ * OK or ERR: no pixels. */
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static int conn = -1;
+
+static const char *control_path( char *buf, size_t size )
+{
+    const char *path = getenv( "SG_LOCK_CONTROL" );
+
+    if (path && *path) return path;
+    snprintf( buf, size, "/run/stained-glass-seat/seat0/%u/control.sock", (unsigned int)getuid() );
+    return buf;
+}
+
+static int read_line( int fd, char *line, size_t size )
+{
+    size_t n = 0;
+    char c;
+
+    for (;;)
+    {
+        ssize_t r = read( fd, &c, 1 );
+        if (r < 0 && errno == EINTR) continue;
+        if (r <= 0) break;
+        if (c == '\n')
+        {
+            line[n] = 0;
+            return 1;
+        }
+        if (n + 1 < size) line[n++] = c;
+    }
+    line[0] = 0;
+    return 0;
+}
+
+static int connect_compositor(void)
+{
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    struct timeval tv = { .tv_sec = 2 };
+    char buf[128], line[64];
+    const char *path = control_path( buf, sizeof(buf) );
+    int fd;
+
+    if (strlen( path ) >= sizeof(addr.sun_path)) return -1;
+    strcpy( addr.sun_path, path );
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) < 0) return -1;
+    setsockopt( fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv) );
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ) < 0 ||
+        write( fd, "MAGNIFY\n", 8 ) != 8 ||
+        !read_line( fd, line, sizeof(line) ) || strcmp( line, "OK magnify" ))
+    {
+        close( fd );
+        return -1;
+    }
+    return fd;
+}
+
+static NTSTATUS mag_command( void *args )
+{
+    struct mag_command_params *params = args;
+    char line[sizeof(params->line) + 1], reply[16];
+    size_t len;
+    int tries;
+
+    params->line[sizeof(params->line) - 1] = 0;
+    if (strchr( params->line, '\n' )) return STATUS_INVALID_PARAMETER;
+    len = snprintf( line, sizeof(line), "%s\n", params->line );
+
+    pthread_mutex_lock( &lock );
+    for (tries = 0; tries < 2; tries++)
+    {
+        /* a compositor that restarted: once more on a new connection */
+        if (conn < 0 && (conn = connect_compositor()) < 0) break;
+        if (send( conn, line, len, MSG_NOSIGNAL ) == (ssize_t)len && read_line( conn, reply, sizeof(reply) ))
+        {
+            pthread_mutex_unlock( &lock );
+            return strcmp( reply, "OK" ) ? STATUS_INVALID_PARAMETER : STATUS_SUCCESS;
+        }
+        close( conn );
+        conn = -1;
+    }
+    pthread_mutex_unlock( &lock );
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS mag_close( void *args )
+{
+    pthread_mutex_lock( &lock );
+#ifndef SG_MUTANT_MAG_KEEP_CONNECTION
+    if (conn >= 0) close( conn );
+    conn = -1;
+#endif
+    pthread_mutex_unlock( &lock );
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    mag_command,
+    mag_close,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    mag_command,
+    mag_close,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif
