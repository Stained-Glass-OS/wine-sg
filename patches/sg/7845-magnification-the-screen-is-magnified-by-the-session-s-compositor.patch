index ddbb171..c8031c8 100644
--- a/dlls/magnification/magnification.spec
+++ b/dlls/magnification/magnification.spec
@@ -1,21 +1,22 @@
-@ stub MagSetFullscreenUseBitmapSmoothing
+@ stdcall MagSetFullscreenUseBitmapSmoothing(long)
 @ stub MagSetLensUseBitmapSmoothing
 @ stub MagGetColorEffect
-@ stub MagGetFullscreenColorEffect
-@ stub MagGetFullscreenTransform
+@ stdcall MagGetFullscreenColorEffect(ptr)
+@ stdcall MagGetFullscreenTransform(ptr ptr ptr)
 @ stub MagGetImageScalingCallback
 @ stub MagGetInputTransform
 @ stub MagGetWindowFilterList
 @ stub MagGetWindowSource
 @ stub MagGetWindowTransform
-@ stub MagInitialize
+@ stdcall MagInitialize()
 @ stub MagSetColorEffect
-@ stub MagSetFullscreenColorEffect
-@ stub MagSetFullscreenTransform
+@ stdcall MagSetFullscreenColorEffect(ptr)
+@ stdcall MagSetFullscreenTransform(float long long)
 @ stub MagSetImageScalingCallback
 @ stub MagSetInputTransform
 @ stub MagSetWindowFilterList
 @ stub MagSetWindowSource
 @ stub MagSetWindowTransform
-@ stub MagShowSystemCursor
-@ stub MagUninitialize
+@ stdcall MagShowSystemCursor(long)
+@ stdcall MagUninitialize()
+@ stdcall SgMagCommand(str)
diff --git a/dlls/magnification/unixlib.c b/dlls/magnification/unixlib.c
new file mode 100644
index 0000000..14d8ef6
--- /dev/null
+++ b/dlls/magnification/unixlib.c
@@ -0,0 +1,161 @@
+/*
+ * Magnification API on the session's compositor (Stained Glass OS)
+ *
+ * Copyright 2026 Stained Glass OS
+ *
