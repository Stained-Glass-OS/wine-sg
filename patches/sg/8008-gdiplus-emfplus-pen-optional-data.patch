From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: an EMF+ pen's transform, dash cap, dash pattern, alignment and compound lines.

Played back, a pen object's PenDataTransform, PenDataDashedLineCap, PenDataDashedLine,
PenDataNonCenter and PenDataCompoundLine were skipped as "not supported", so a dashed pen in a
metafile (Office's charts and drawings) drew solid; they now set the pen's transform, dash cap,
dash array, alignment and compound array (MS-EMFPLUS 2.2.2.33). Recorded, a pen's alignment was
written as a float where the format has a 32-bit integer, and its compound lines were left out.
(How Wine's GDI+ draws dash caps, alignments, compound lines and pen transforms is not changed.)
---
diff --git a/dlls/gdiplus/metafile.c b/dlls/gdiplus/metafile.c
index 35af25e..9f719d9 100644
--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -2667,9 +2667,18 @@ static GpStatus METAFILE_PlaybackObject(GpMetafile *metafile, UINT flags, UINT d
 
         offset = FIELD_OFFSET(EmfPlusPenData, OptionalData);
 
+        /* Stained Glass OS: the pen's transform, dash cap, dash pattern, alignment and compound
+         * lines (MS-EMFPLUS 2.2.2.33 EmfPlusPenOptionalData) */
         if (pendata->PenDataFlags & PenDataTransform)
         {
-            FIXME("PenDataTransform is not supported.\n");
+            const EmfPlusTransformMatrix *m = (const EmfPlusTransformMatrix *)((BYTE *)pendata + offset);
+            GpMatrix matrix;
+
+            memcpy(matrix.matrix, m->TransformMatrix, sizeof(matrix.matrix));
+#ifndef SG_MUTANT_EMFP_PENDATA
+            if ((status = GdipSetPenTransform(pen, &matrix)) != Ok)
+                goto penfailed;
+#endif
             offset += sizeof(EmfPlusTransformMatrix);
         }
 
@@ -2710,7 +2719,10 @@ static GpStatus METAFILE_PlaybackObject(GpMetafile *metafile, UINT flags, UINT d
 
         if (pendata->PenDataFlags & PenDataDashedLineCap)
         {
-            FIXME("PenDataDashedLineCap is not supported.\n");
+#ifndef SG_MUTANT_EMFP_PENDATA
+            if ((status = GdipSetPenDashCap197819(pen, *(DWORD *)((BYTE *)pendata + offset))) != Ok)
+                goto penfailed;
+#endif
             offset += sizeof(DWORD);
         }
 
@@ -2724,20 +2736,31 @@ static GpStatus METAFILE_PlaybackObject(GpMetafile *metafile, UINT flags, UINT d
         if (pendata->PenDataFlags & PenDataDashedLine)
         {
             EmfPlusDashedLineData *dashedline = (EmfPlusDashedLineData *)((BYTE *)pendata + offset);
-            FIXME("PenDataDashedLine is not supported.\n");
+#ifndef SG_MUTANT_EMFP_PENDATA
+            if (dashedline->DashedLineDataSize &&
+                (status = GdipSetPenDashArray(pen, (const REAL *)dashedline->data, dashedline->DashedLineDataSize)) != Ok)
+                goto penfailed;
+#endif
             offset += FIELD_OFFSET(EmfPlusDashedLineData, data) + dashedline->DashedLineDataSize * sizeof(float);
         }
 
         if (pendata->PenDataFlags & PenDataNonCenter)
         {
-            FIXME("PenDataNonCenter is not supported.\n");
+#ifndef SG_MUTANT_EMFP_PENDATA
+            if ((status = GdipSetPenMode(pen, *(DWORD *)((BYTE *)pendata + offset))) != Ok)
+                goto penfailed;
+#endif
             offset += sizeof(DWORD);
         }
 
         if (pendata->PenDataFlags & PenDataCompoundLine)
         {
             EmfPlusCompoundLineData *compoundline = (EmfPlusCompoundLineData *)((BYTE *)pendata + offset);
-            FIXME("PenDataCompoundLine is not supported.\n");
+#ifndef SG_MUTANT_EMFP_PENDATA
+            if ((status = GdipSetPenCompoundArray(pen, (const REAL *)compoundline->data,
+                                                  compoundline->CompoundLineDataSize)) != Ok)
+                goto penfailed;
+#endif
             offset += FIELD_OFFSET(EmfPlusCompoundLineData, data) + compoundline->CompoundLineDataSize * sizeof(float);
         }
 
@@ -5498,7 +5521,12 @@ static GpStatus METAFILE_AddPenObject(GpMetafile *metafile, GpPen *pen, DWORD *i
         data_flags |= PenDataNonCenter;
         pen_data_size += sizeof(DWORD);
     }
-    /* TODO: Add support for PenDataCompoundLine */
+    /* Stained Glass OS: compound lines are recorded too */
+    if (pen->compound_array_size)
+    {
+        data_flags |= PenDataCompoundLine;
+        pen_data_size += sizeof(DWORD) + pen->compound_array_size * sizeof(REAL);
+    }
     if (pen->customstart)
     {
         data_flags |= PenDataCustomStartCap;
@@ -5597,8 +5625,16 @@ static GpStatus METAFILE_AddPenObject(GpMetafile *metafile, GpPen *pen, DWORD *i
     }
     if (data_flags & PenDataNonCenter)
     {
-        *(REAL*)(pen_data->OptionalData + i) = pen->align;
+        /* a PenAlignment is a 32-bit integer (MS-EMFPLUS), not a float */
+        *(DWORD*)(pen_data->OptionalData + i) = pen->align;
+        i += sizeof(DWORD);
+    }
+    if (data_flags & PenDataCompoundLine)
+    {
+        *(DWORD*)(pen_data->OptionalData + i) = pen->compound_array_size;
         i += sizeof(DWORD);
+        memcpy(pen_data->OptionalData + i, pen->compound_array, pen->compound_array_size * sizeof(REAL));
+        i += pen->compound_array_size * sizeof(REAL);
     }
     if (data_flags & PenDataCustomStartCap)
     {
