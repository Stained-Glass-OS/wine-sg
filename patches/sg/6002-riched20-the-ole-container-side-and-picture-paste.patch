+/* Stained Glass OS: a picture (from Paint, a screenshot) is pasted as a picture
+ * object, as by the rich edit control of Windows */
+static HRESULT paste_bitmap_handle(ME_TextEditor *editor, HBITMAP bmp)
+{
+    HRESULT hr;
+    BITMAP info;
+    SIZEL sz;
+    HDC hdc = GetDC( NULL );
+    int dpi_x = GetDeviceCaps( hdc, LOGPIXELSX ), dpi_y = GetDeviceCaps( hdc, LOGPIXELSY );
+
+    ReleaseDC( NULL, hdc );
+#ifdef SG_MUTANT_RE_NO_BITMAP_PASTE
+    return DV_E_FORMATETC;
+#endif
+    if (!GetObjectW( bmp, sizeof(info), &info )) return E_FAIL;
+    /* twips */
+    sz.cx = MulDiv( info.bmWidth, 1440, dpi_x );
+    sz.cy = MulDiv( info.bmHeight, 1440, dpi_y );
+    hr = insert_static_object( editor, NULL, bmp, &sz );
+    if (SUCCEEDED(hr))
+    {
+        ME_CommitUndo( editor );
+        ME_UpdateRepaint( editor, FALSE );
+    }
+    return hr;
+}
+
+static HRESULT paste_bitmap(ME_TextEditor *editor, FORMATETC *fmt, STGMEDIUM *med)
+{
+    HRESULT hr;
+    HBITMAP copy;
+
+    /* the object's cache takes the bitmap it is given: give it a copy of the medium's */
+    copy = CopyImage( med->hBitmap, IMAGE_BITMAP, 0, 0, 0 );
+    ReleaseStgMedium( med );
+    if (!copy) return E_OUTOFMEMORY;
+    hr = paste_bitmap_handle( editor, copy );
+    if (FAILED(hr)) DeleteObject( copy );
+    return hr;
+}
+
+static HRESULT paste_dib(ME_TextEditor *editor, FORMATETC *fmt, STGMEDIUM *med)
+{
+    BITMAPINFO *bi = GlobalLock( med->hGlobal );
+    HBITMAP bmp = NULL;
+    HRESULT hr = E_FAIL;
+
+    if (bi)
+    {
+        const BITMAPINFOHEADER *h = &bi->bmiHeader;
+        UINT colors = h->biClrUsed ? h->biClrUsed : (h->biBitCount <= 8 ? 1u << h->biBitCount : 0);
+        const BYTE *bits = (const BYTE *)bi + h->biSize + colors * sizeof(RGBQUAD) +
+                           (h->biCompression == BI_BITFIELDS && h->biSize == sizeof(BITMAPINFOHEADER) ? 12 : 0);
+        HDC hdc = GetDC( NULL );
+
+        bmp = CreateDIBitmap( hdc, h, CBM_INIT, bits, bi, DIB_RGB_COLORS );
+        ReleaseDC( NULL, hdc );
+        GlobalUnlock( med->hGlobal );
+    }
+    ReleaseStgMedium( med );
+    if (bmp && FAILED(hr = paste_bitmap_handle( editor, bmp ))) DeleteObject( bmp );
+    return hr;
+}
