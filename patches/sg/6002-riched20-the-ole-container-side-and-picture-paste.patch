+/* IRichEditOle::ImportDataObject: the data object (or, with no data object, the
+ * clipboard) replaces the selection, in format cf or the best one it offers */
+HRESULT editor_import_data_object(ME_TextEditor *editor, IDataObject *data, CLIPFORMAT cf)
+{
+    HRESULT hr;
+
+    if (editor->props & TXTBIT_READONLY) return E_ACCESSDENIED;
+    if (!data)
+    {
+        if (FAILED(hr = OleGetClipboard( &data ))) return hr;
+    }
+    else IDataObject_AddRef( data );
+    hr = paste_data_object_format( editor, data, cf, FALSE );
+    IDataObject_Release( data );
+    if (hr == S_OK)
+    {
+        ME_CommitUndo( editor );
+        ME_UpdateRepaint( editor, FALSE );
+    }
+    return hr;
