+    struct re_object *reobj;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%s %s)\n", services, debugstr_guid(rclsid), debugstr_guid(rclsidAs) );
+
+    if (!rclsid || !rclsidAs) return E_INVALIDARG;
+    /* objects of the old class are treated as the new class from now on, and
+     * the ones in the control are unloaded and loaded again as that class */
+    if (FAILED(hr = CoTreatAsClass( rclsid, rclsidAs ))) return hr;
+#ifndef SG_MUTANT_RE_ACTIVATEAS_NORELOAD
+    LIST_FOR_EACH_ENTRY( reobj, &services->editor->reobj_list, struct re_object, entry )
+        if (IsEqualCLSID( &reobj->obj.clsid, rclsid )) reole_reload_object( services, reobj );
+#endif
+    return S_OK;
 }
 
