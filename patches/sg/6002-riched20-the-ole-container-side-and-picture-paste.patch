+/* Stained Glass OS: the object iob names (an index, REO_IOB_SELECTION or, with
+ * cp, REO_IOB_USE_CP), or NULL */
+static struct re_object *reole_object( struct text_services *services, LONG iob, LONG cp )
+{
+    struct re_object *reobj;
+    ME_Cursor cursor, *from, *to;
+    LONG count = 0;
+
+    if (iob == REO_IOB_USE_CP)
+    {
+        cursor_from_char_ofs( services->editor, cp, &cursor );
+        return cursor.run->reobj;
+    }
+    if (iob == REO_IOB_SELECTION)
+    {
+        ME_GetSelection( services->editor, &from, &to );
+        return from->run->reobj;
+    }
+    LIST_FOR_EACH_ENTRY( reobj, &services->editor->reobj_list, struct re_object, entry )
+        if (count++ == iob) return reobj;
+    return NULL;
+}
+
+/* save an object to its storage, drop it and load it again from there (an object
+ * whose class changed: ConvertObject, ActivateAs) */
+static HRESULT reole_reload_object( struct text_services *services, struct re_object *reobj )
+{
+    IPersistStorage *persist;
+    IOleObject *obj;
+    HRESULT hr;
+
+    if (!reobj->obj.pstg || !reobj->obj.poleobj) return E_FAIL;
+    if (SUCCEEDED(IOleObject_QueryInterface( reobj->obj.poleobj, &IID_IPersistStorage, (void **)&persist )))
+    {
+        hr = OleSave( persist, reobj->obj.pstg, TRUE );
+        IPersistStorage_SaveCompleted( persist, NULL );
+        IPersistStorage_Release( persist );
+        if (FAILED(hr)) return hr;
+    }
+    IOleObject_Close( reobj->obj.poleobj, OLECLOSE_NOSAVE );
+    if (FAILED(hr = OleLoad( reobj->obj.pstg, &IID_IOleObject, reobj->obj.polesite, (void **)&obj ))) return hr;
+    if (services->editor->host_app) IOleObject_SetHostNames( obj, services->editor->host_app, services->editor->host_obj );
+    if (services->editor->inplace_obj == reobj->obj.poleobj) services->editor->inplace_obj = NULL;
+    IOleObject_Release( reobj->obj.poleobj );
+    reobj->obj.poleobj = obj;
+    ReadClassStg( reobj->obj.pstg, &reobj->obj.clsid );
+    ITextHost_TxInvalidateRect( services->editor->texthost, NULL, TRUE );
+    ME_Repaint( services->editor );
+    return S_OK;
+}
