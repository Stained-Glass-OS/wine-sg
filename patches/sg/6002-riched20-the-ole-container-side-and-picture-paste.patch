+/* the rectangle of an object in the control's client area */
+static BOOL client_site_object_rect( IOleClientSiteImpl *site, RECT *rect )
+{
+    ME_TextEditor *editor = site->child.reole->editor;
+    struct re_object *reobj = client_site_object( site );
+    ME_Cursor cursor;
+    int x, y, height;
+    SIZE size;
+    ME_Context c;
+    HDC hdc;
+
+    if (!reobj || !reobj->run) return FALSE;
+    cursor_from_char_ofs( editor, run_char_ofs( reobj->run, 0 ), &cursor );
+    cursor_coords( editor, &cursor, &x, &y, &height );
+    hdc = ITextHost_TxGetDC( editor->texthost );
+    ME_InitContext( &c, editor, hdc );
+    ME_GetOLEObjectSize( &c, reobj->run, &size );
+    ME_DestroyContext( &c );
+    ITextHost_TxReleaseDC( editor->texthost, hdc );
+    rect->left = x;
+    rect->right = x + size.cx;
+    rect->bottom = y + height;
+    rect->top = rect->bottom - size.cy;
+    return TRUE;
 }
 
