-void vd_paint_button( HDC dc, const RECT *rect, COLORREF fg )
+/* s8: the bar's scale, in eighths (as large as the bar is) */
+void vd_paint_button( HDC dc, const RECT *rect, COLORREF fg, int s8 )
 {
     int cx = (rect->left + rect->right) / 2, cy = (rect->top + rect->bottom) / 2;
+    int line = s8 >= 12 ? 2 : 1;
     RECT a, b;
+#define U(v) (((v) * s8 + 4) / 8)
 
-    SetRect( &a, cx - 8, cy - 7, cx + 4, cy + 3 );
-    SetRect( &b, cx - 4, cy - 3, cx + 8, cy + 7 );
-    frame( dc, &a, fg, 1 );
-    frame( dc, &b, fg, 1 );
+    SetRect( &a, cx - U(8), cy - U(7), cx + U(4), cy + U(3) );
+    SetRect( &b, cx - U(4), cy - U(3), cx + U(8), cy + U(7) );
+#undef U
+    frame( dc, &a, fg, line );
+    frame( dc, &b, fg, line );
 }
 
