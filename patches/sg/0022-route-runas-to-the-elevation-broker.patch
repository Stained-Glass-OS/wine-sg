From: Stained Glass OS <dev@stained-glass.example>
Subject: Route "Run as administrator" to the elevation broker

Stained Glass ADR 0012. Since patch 0019 a standard user (and an administrator
whose split token is not linked in this prefix) has no administrator token, so
ShellExecute's "runas" verb ran the program unelevated -- "Run as
administrator" silently did nothing. Elevation on Stained Glass runs the
program as the SYSTEM account, started by the broker after consent on the
secure surface (never by handing the session its own elevated token, which
under one Unix uid would not be a boundary).

When "runas" is asked and there is no token to elevate with directly,
SHELL_ExecuteW now launches the broker's client, sg-elevate, through
\\?\unix\, passing the command with --wine so the broker runs it under Wine as
the SYSTEM account. Guarded three ways: only for the "runas" verb with no
usable token, only when sg-elevate is actually installed, and never inside a
program the broker itself started (SG_IN_BROKER), so an elevated program's own
ShellExecute("runas") does not loop. When sg-elevate is absent the old path is
taken unchanged, so ordinary Wine is unaffected.
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -349,6 +349,40 @@
     if (psei->lpVerb && !wcsicmp(psei->lpVerb, L"runas"))
         token = get_admin_token();
 
+    /* Stained Glass OS (ADR 0012): "Run as administrator" for a user with no
+     * administrator token of their own (get_admin_token() returned NULL) goes
+     * to the elevation broker, which prompts on the secure surface and starts
+     * the program as the SYSTEM account. sg-elevate (its client) and the
+     * broker are Unix programs, reached through \\?\unix\; --wine tells
+     * sg-elevate the rest is a Windows command to run under Wine as SYSTEM.
+     * Guarded so it only fires with the client installed, and never inside a
+     * program the broker itself launched (SG_IN_BROKER). */
+    if (psei->lpVerb && !wcsicmp( psei->lpVerb, L"runas" ) && !token &&
+        !GetEnvironmentVariableW( L"SG_IN_BROKER", NULL, 0 ) &&
+        GetFileAttributesW( L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-elevate" ) != INVALID_FILE_ATTRIBUTES)
+    {
+        static const WCHAR headW[] = L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-elevate --wine ";
+        size_t len = wcslen( headW ) + wcslen( lpCmd ) + 1;
+        WCHAR *broker_cmd = malloc( len * sizeof(WCHAR) );
+
+        if (broker_cmd)
+        {
+            wcscpy( broker_cmd, headW );
+            wcscat( broker_cmd, lpCmd );
+            if (CreateProcessW( NULL, broker_cmd, NULL, NULL, FALSE, dwCreationFlags, env, NULL, &startup, &info ))
+            {
+                free( broker_cmd );
+                if (psei->fMask & SEE_MASK_NOCLOSEPROCESS) psei_out->hProcess = info.hProcess;
+                else CloseHandle( info.hProcess );
+                CloseHandle( info.hThread );
+                TRACE( "routed runas to the elevation broker\n" );
+                retval = 33;
+                goto sg_done;
+            }
+            free( broker_cmd );
+        }
+    }
+
     if (CreateProcessAsUserW(token, NULL, (LPWSTR)lpCmd, NULL, NULL, FALSE,
             dwCreationFlags, env, NULL, &startup, &info))
     {
@@ -372,6 +406,7 @@
 
     CloseHandle(token);
 
+sg_done:
     TRACE("returning %Iu\n", retval);
 
     psei_out->hInstApp = (HINSTANCE)retval;
