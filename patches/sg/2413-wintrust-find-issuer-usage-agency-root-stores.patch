+/***********************************************************************
+ *		WTHelperCertFindIssuerCertificate
+ *
+ * Looks for the issuer of pChildContext in the given stores and says how far
+ * it can be trusted as the issuer, in *pdwConfidence (CERT_CONFIDENCE_*):
+ * its signature on the child checks out (SIG), the issuer is valid at
+ * psftVerifyAsOf (TIME), the child's validity lies within the issuer's
+ * (TIMENEST), the child names the issuer by key identifier and the issuer
+ * has that identifier (AUTHIDEXT) and the issuer may act as a CA (HYGIENE).
+ * Of several candidates the one with the most confidence wins. *pdwError is
+ * 0 when SIG, TIME and TIMENEST hold, else the first failing check's error.
+ * The function is documented only by its signature; the meaning of the
+ * confidence bits beyond SIG and TIME and the error values are best guesses.
+ * The result is to be freed with CertFreeCertificateContext.
+ */
+static DWORD issuer_confidence(PCCERT_CONTEXT child, PCCERT_CONTEXT issuer, DWORD store_flags,
+                               const FILETIME *asof, DWORD *error)
+{
+    DWORD conf = 0, size;
+    CERT_EXTENSION *aki, *ski;
+
+    *error = 0;
+#ifndef SG_MUTANT_WT2_FINDSIG
+    if (!(store_flags & CERT_STORE_SIGNATURE_FLAG)) conf |= CERT_CONFIDENCE_SIG;
+    else *error = TRUST_E_CERT_SIGNATURE;
+#else
+    conf |= CERT_CONFIDENCE_SIG;
+#endif
+    if (!CertVerifyTimeValidity((FILETIME *)asof, issuer->pCertInfo)) conf |= CERT_CONFIDENCE_TIME;
+    else if (!*error) *error = CERT_E_EXPIRED;
+    if (CompareFileTime(&child->pCertInfo->NotBefore, &issuer->pCertInfo->NotBefore) >= 0 &&
+        CompareFileTime(&child->pCertInfo->NotAfter, &issuer->pCertInfo->NotAfter) <= 0)
+        conf |= CERT_CONFIDENCE_TIMENEST;
+    else if (!*error) *error = CERT_E_VALIDITYPERIODNESTING;
+
+    aki = CertFindExtension(szOID_AUTHORITY_KEY_IDENTIFIER2, child->pCertInfo->cExtension, child->pCertInfo->rgExtension);
+    ski = CertFindExtension(szOID_SUBJECT_KEY_IDENTIFIER, issuer->pCertInfo->cExtension, issuer->pCertInfo->rgExtension);
+    if (aki && ski)
+    {
+        CERT_AUTHORITY_KEY_ID2_INFO *id = NULL;
+        CRYPT_DATA_BLOB *keyid = NULL;
+
+        if (CryptDecodeObjectEx(X509_ASN_ENCODING, X509_AUTHORITY_KEY_ID2, aki->Value.pbData, aki->Value.cbData,
+                                CRYPT_DECODE_ALLOC_FLAG, NULL, &id, &size) && id)
+        {
+            if (CryptDecodeObjectEx(X509_ASN_ENCODING, X509_OCTET_STRING, ski->Value.pbData, ski->Value.cbData,
+                                    CRYPT_DECODE_ALLOC_FLAG, NULL, &keyid, &size) && keyid)
+            {
+                if (id->KeyId.cbData == keyid->cbData && !memcmp(id->KeyId.pbData, keyid->pbData, keyid->cbData))
+                    conf |= CERT_CONFIDENCE_AUTHIDEXT;
+                LocalFree(keyid);
+            }
+            LocalFree(id);
+        }
+    }
+    {
+        CERT_EXTENSION *bc = CertFindExtension(szOID_BASIC_CONSTRAINTS2, issuer->pCertInfo->cExtension,
+                                               issuer->pCertInfo->rgExtension);
+        CERT_BASIC_CONSTRAINTS2_INFO *info = NULL;
+
+        if (!bc) conf |= CERT_CONFIDENCE_HYGIENE;
+        else if (CryptDecodeObjectEx(X509_ASN_ENCODING, X509_BASIC_CONSTRAINTS2, bc->Value.pbData, bc->Value.cbData,
+                                     CRYPT_DECODE_ALLOC_FLAG, NULL, &info, &size) && info)
+        {
+            if (info->fCA) conf |= CERT_CONFIDENCE_HYGIENE;
+            LocalFree(info);
+        }
+    }
+    return conf;
+}
+
+PCCERT_CONTEXT WINAPI WTHelperCertFindIssuerCertificate(PCCERT_CONTEXT child, DWORD stores_count,
+        HCERTSTORE *stores, FILETIME *verify_as_of, DWORD encoding, DWORD *confidence, DWORD *error_out)
+{
+    PCCERT_CONTEXT best = NULL, issuer;
+    DWORD best_conf = 0, best_error = 0, i, dummy;
+    FILETIME now;
+
+    TRACE("(%p, %ld, %p, %p, %#lx, %p, %p)\n", child, stores_count, stores, verify_as_of, encoding, confidence,
+          error_out);
+
+    if (!confidence) confidence = &dummy;
+    if (!error_out) error_out = &dummy;
+    *confidence = 0;
+    *error_out = 0;
+    if (!child || (stores_count && !stores))
+    {
+        *error_out = ERROR_INVALID_PARAMETER;
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return NULL;
+    }
+    if (!verify_as_of)
+    {
+        GetSystemTimeAsFileTime(&now);
+        verify_as_of = &now;
+    }
+
+    for (i = 0; i < stores_count; i++)
+    {
+        DWORD flags;
+
+        issuer = NULL;
+        for (;;)
+        {
+            DWORD conf, err;
+
+            flags = CERT_STORE_SIGNATURE_FLAG;
+            issuer = CertGetIssuerCertificateFromStore(stores[i], child, issuer, &flags);
+            if (!issuer) break;
+            conf = issuer_confidence(child, issuer, flags, verify_as_of, &err);
+            if (!best || conf > best_conf)
+            {
+                if (best) CertFreeCertificateContext(best);
+                best = CertDuplicateCertificateContext(issuer);
+                best_conf = conf;
+                best_error = err;
+            }
+            if (best_conf >= CERT_CONFIDENCE_HIGHEST)
+            {
+                CertFreeCertificateContext(issuer);
+                break;
+            }
+        }
+        if (best_conf >= CERT_CONFIDENCE_HIGHEST) break;
+    }
+    if (!best)
+    {
+        *error_out = CERT_E_CHAINING;
+        SetLastError(CRYPT_E_NOT_FOUND);
+        return NULL;
+    }
+    *confidence = best_conf;
+    *error_out = best_error;
+    return best;
+}
+
+/***********************************************************************
+ *		WTHelperCheckCertUsage
+ *
+ * Whether the certificate may be used for the given purpose (an OID string):
+ * it names it among its enhanced key usages, or names none at all (no
+ * extension and no property: good for any purpose).
+ */
+BOOL WINAPI WTHelperCheckCertUsage(PCCERT_CONTEXT cert, LPCSTR oid)
+{
+    CERT_ENHKEY_USAGE *usage;
+    DWORD size = 0, i;
+    BOOL ret = FALSE;
+
+    TRACE("(%p, %s)\n", cert, debugstr_a(oid));
+
+    if (!cert || !oid)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+#ifdef SG_MUTANT_WT2_USAGE
+    return TRUE;
+#endif
+    SetLastError(0);
+    if (!CertGetEnhancedKeyUsage(cert, 0, NULL, &size)) return FALSE;
+    if (!(usage = malloc(size)))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    SetLastError(0);
+    if (CertGetEnhancedKeyUsage(cert, 0, usage, &size))
+    {
+        if (!usage->cUsageIdentifier)
+            ret = GetLastError() == CRYPT_E_NOT_FOUND;  /* none named at all: any purpose; an empty list: none */
+        for (i = 0; i < usage->cUsageIdentifier && !ret; i++)
+            if (!strcmp(usage->rgpszUsageIdentifier[i], oid)) ret = TRUE;
+    }
+    free(usage);
+    if (!ret) SetLastError(CRYPT_E_NOT_FOUND);
+    return ret;
+}
+
+/***********************************************************************
+ *		WTHelperGetAgencyInfo
+ *
+ * The policy-provider (agency) information in the certificate's
+ * SPC_SP_AGENCY_INFO extension, decoded into the caller's buffer.
+ */
+BOOL WINAPI WTHelperGetAgencyInfo(PCCERT_CONTEXT cert, DWORD *size, SPC_SP_AGENCY_INFO *info)
+{
+    CERT_EXTENSION *ext;
+
+    TRACE("(%p, %p, %p)\n", cert, size, info);
+
+    if (!cert || !size)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(ext = CertFindExtension(SPC_SP_AGENCY_INFO_OBJID, cert->pCertInfo->cExtension, cert->pCertInfo->rgExtension)))
+    {
+        SetLastError(CRYPT_E_NOT_FOUND);
+        return FALSE;
+    }
+    return CryptDecodeObject(X509_ASN_ENCODING, SPC_SP_AGENCY_INFO_STRUCT, ext->Value.pbData, ext->Value.cbData, 0,
+                             info, size);
+}
+
+/***********************************************************************
+ *		WTHelperIsInRootStore
+ *
+ * Whether this very certificate (issuer and serial number) is in the
+ * trusted root store.
+ */
+BOOL WINAPI WTHelperIsInRootStore(DWORD encoding, CERT_INFO *cert)
+{
+    HCERTSTORE root;
+    PCCERT_CONTEXT found;
+    BOOL ret = FALSE;
+
+    TRACE("(%#lx, %p)\n", encoding, cert);
+
+    if (!cert)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(root = CertOpenStore(CERT_STORE_PROV_SYSTEM_W, 0, 0, CERT_STORE_OPEN_EXISTING_FLAG | CERT_STORE_READONLY_FLAG |
+                               CERT_SYSTEM_STORE_CURRENT_USER, L"Root")))
+        return FALSE;
+#ifdef SG_MUTANT_WT2_ROOT
+    ret = CertEnumCertificatesInStore(root, NULL) != NULL;
+#else
+    if ((found = CertFindCertificateInStore(root, encoding ? encoding : X509_ASN_ENCODING, 0, CERT_FIND_SUBJECT_CERT,
+                                            cert, NULL)))
+    {
+        CertFreeCertificateContext(found);
+        ret = TRUE;
+    }
+#endif
+    CertCloseStore(root, 0);
+    return ret;
+}
+
+/***********************************************************************
+ *		WTHelperOpenKnownStores
+ *
+ * Opens the system stores a trust decision looks in (Root, Trust, CA, My)
+ * and adds them to the provider data's stores.
+ */
+BOOL WINAPI WTHelperOpenKnownStores(CRYPT_PROVIDER_DATA *data)
+{
+    static const WCHAR *names[] = { L"Root", L"Trust", L"CA", L"My" };
+    unsigned int i;
+
+    TRACE("(%p)\n", data);
+
+    if (!data || data->cbStruct < FIELD_OFFSET(CRYPT_PROVIDER_DATA, pasSigners) || !data->psPfns ||
+        !data->psPfns->pfnAddStore2Chain)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        HCERTSTORE store = CertOpenStore(CERT_STORE_PROV_SYSTEM_W, 0, 0,
+                                         CERT_STORE_READONLY_FLAG | CERT_SYSTEM_STORE_CURRENT_USER, names[i]);
+        BOOL ok;
+
+        if (!store) return FALSE;
+#ifdef SG_MUTANT_WT2_STORES
+        ok = TRUE;
+#else
+        ok = data->psPfns->pfnAddStore2Chain(data, store);
+#endif
+        CertCloseStore(store, 0);
+        if (!ok) return FALSE;
+    }
+    return TRUE;
+}
