From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wintrust: the certificate helpers WTHelperCertFindIssuerCertificate, CheckCertUsage, GetAgencyInfo, IsInRootStore, OpenKnownStores

Five WTHelper* exports were stubs.

- WTHelperCertFindIssuerCertificate searches the given stores for the
  issuer of a certificate and returns the candidate with the most
  confidence (CERT_CONFIDENCE_*: signature, validity at the given time,
  validity nesting, authority key identifier match, CA). *pdwError names
  the first check that failed; no issuer is NULL with CERT_E_CHAINING.
- WTHelperCheckCertUsage is true when the certificate names the purpose
  among its enhanced key usages or names none at all.
- WTHelperGetAgencyInfo decodes the SPC_SP_AGENCY_INFO extension; the
  WVTAsn1SpcSpAgencyInfo codec behind SPC_SP_AGENCY_INFO_STRUCT, also a
  stub, is written (policy link, display text, logo link; the logo image
  is not carried).
- WTHelperIsInRootStore is true for the very certificate (issuer and
  serial) in the current user's root store.
- WTHelperOpenKnownStores adds the Root, Trust, CA and My stores to the
  provider data.
Prototypes are added to wintrust.h.
---
--- a/dlls/wintrust/asn.c
+++ b/dlls/wintrust/asn.c
@@ -880,6 +880,87 @@ BOOL WINAPI WVTAsn1SpcSpOpusInfoEncode(DWORD dwCertEncodingType,
     return ret;
 }
 
+/* SPC_SP_AGENCY_INFO: [0] policy link, [1] policy display text, [2] logo image,
+ * [3] logo link, each optional and explicitly tagged. The logo image is not
+ * carried: encoding one fails, and decoding drops it (pLogoImage stays NULL). */
+BOOL WINAPI WVTAsn1SpcSpAgencyInfoEncode(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, BYTE *pbEncoded,
+ DWORD *pcbEncoded)
+{
+    BOOL ret = FALSE;
+
+    TRACE("(0x%08lx, %s, %p, %p, %p)\n", dwCertEncodingType,
+     debugstr_a(lpszStructType), pvStructInfo, pbEncoded, pcbEncoded);
+
+    __TRY
+    {
+        const SPC_SP_AGENCY_INFO *info = pvStructInfo;
+        const SPC_LINK *links[2] = { info->pPolicyInformation, info->pLogoLink };
+        int i;
+
+        for (i = 0; i < 2; i++)
+            if (links[i] && links[i]->dwLinkChoice != SPC_URL_LINK_CHOICE &&
+             links[i]->dwLinkChoice != SPC_MONIKER_LINK_CHOICE &&
+             links[i]->dwLinkChoice != SPC_FILE_LINK_CHOICE)
+            {
+                SetLastError(E_INVALIDARG);
+                goto done;
+            }
+        if (info->pLogoImage)
+            SetLastError(ERROR_NOT_SUPPORTED);
+        else
+        {
+            struct AsnEncodeSequenceItem items[3] = { { 0 } };
+            struct AsnConstructedItem constructed[3] = { { 0 } };
+            struct AsnEncodeTagSwappedItem swapped;
+            DWORD cItem = 0, cConstructed = 0;
+
+            if (info->pPolicyInformation)
+            {
+                constructed[cConstructed].tag = 0;
+                constructed[cConstructed].pvStructInfo = info->pPolicyInformation;
+                constructed[cConstructed].encodeFunc = WVTAsn1SpcLinkEncode;
+                items[cItem].pvStructInfo = &constructed[cConstructed];
+                items[cItem].encodeFunc = CRYPT_AsnEncodeConstructed;
+                cConstructed++;
+                cItem++;
+            }
+            if (info->pwszPolicyDisplayText)
+            {
+                swapped.tag = ASN_CONTEXT;
+                swapped.pvStructInfo = info->pwszPolicyDisplayText;
+                swapped.encodeFunc = CRYPT_AsnEncodeBMPString;
+                constructed[cConstructed].tag = 1;
+                constructed[cConstructed].pvStructInfo = &swapped;
+                constructed[cConstructed].encodeFunc = CRYPT_AsnEncodeSwapTag;
+                items[cItem].pvStructInfo = &constructed[cConstructed];
+                items[cItem].encodeFunc = CRYPT_AsnEncodeConstructed;
+                cConstructed++;
+                cItem++;
+            }
+            if (info->pLogoLink)
+            {
+                constructed[cConstructed].tag = 3;
+                constructed[cConstructed].pvStructInfo = info->pLogoLink;
+                constructed[cConstructed].encodeFunc = WVTAsn1SpcLinkEncode;
+                items[cItem].pvStructInfo = &constructed[cConstructed];
+                items[cItem].encodeFunc = CRYPT_AsnEncodeConstructed;
+                cConstructed++;
+                cItem++;
+            }
+            ret = CRYPT_AsnEncodeSequence(X509_ASN_ENCODING,
+             items, cItem, pbEncoded, pcbEncoded);
+        }
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+done:
+    return ret;
+}
+
 static BOOL CRYPT_AsnEncodeInteger(DWORD dwCertEncodingType,
  LPCSTR lpszStructType, const void *pvStructInfo, BYTE *pbEncoded,
  DWORD *pcbEncoded)
@@ -2183,6 +2264,52 @@ BOOL WINAPI WVTAsn1SpcSpOpusInfoDecode(DWORD dwCertEncodingType,
     return ret;
 }
 
+/* SPC_SP_AGENCY_INFO, see the encoder: the logo image is skipped. */
+BOOL WINAPI WVTAsn1SpcSpAgencyInfoDecode(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const BYTE *pbEncoded, DWORD cbEncoded, DWORD dwFlags,
+ void *pvStructInfo, DWORD *pcbStructInfo)
+{
+    BOOL ret = FALSE;
+
+    TRACE("%p, %ld, %08lx, %p, %ld\n", pbEncoded, cbEncoded, dwFlags,
+     pvStructInfo, *pcbStructInfo);
+
+    __TRY
+    {
+        struct AsnDecodeSequenceItem items[] = {
+         { ASN_CONSTRUCTOR | ASN_CONTEXT,
+           offsetof(SPC_SP_AGENCY_INFO, pPolicyInformation),
+           CRYPT_AsnDecodeSPCLinkPointer, sizeof(PSPC_LINK), TRUE, TRUE,
+           offsetof(SPC_SP_AGENCY_INFO, pPolicyInformation), 0 },
+#ifdef SG_MUTANT_WT2_AGENCY
+         { ASN_CONSTRUCTOR | ASN_CONTEXT | 5,
+#else
+         { ASN_CONSTRUCTOR | ASN_CONTEXT | 1,
+#endif
+           offsetof(SPC_SP_AGENCY_INFO, pwszPolicyDisplayText),
+           CRYPT_AsnDecodeProgramName, sizeof(LPCWSTR), TRUE, TRUE,
+           offsetof(SPC_SP_AGENCY_INFO, pwszPolicyDisplayText), 0 },
+         { ASN_CONSTRUCTOR | ASN_CONTEXT | 2,
+           offsetof(SPC_SP_AGENCY_INFO, pLogoImage),
+           NULL, sizeof(PSPC_IMAGE), TRUE, FALSE, 0, 0 },
+         { ASN_CONSTRUCTOR | ASN_CONTEXT | 3,
+           offsetof(SPC_SP_AGENCY_INFO, pLogoLink),
+           CRYPT_AsnDecodeSPCLinkPointer, sizeof(PSPC_LINK), TRUE, TRUE,
+           offsetof(SPC_SP_AGENCY_INFO, pLogoLink), 0 },
+        };
+
+        ret = CRYPT_AsnDecodeSequence(dwCertEncodingType, items, ARRAY_SIZE(items),
+         pbEncoded, cbEncoded, dwFlags, pvStructInfo, pcbStructInfo, NULL);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    TRACE("returning %d\n", ret);
+    return ret;
+}
