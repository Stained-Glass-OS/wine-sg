From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dcomp: a compositor ends once; releases during or after its end find it ended

OneDrive crashed in the compositor's last release, a minute after "Use this folder", since React Native's animations could run (6240): the compositor's lock had already been deleted when its release went on, which happens when it is ended a second time, either by something taking and dropping a reference while it ends or by a release more than were held. A compositor now ends once: while it ends, references taken and dropped do not end it again, and once ended it is kept rather than freed, so a later release (logged as an error, to find who releases too often) and the objects of it still alive find it ended instead of freed memory.
---
diff --git a/dlls/dcomp/composition.c b/dlls/dcomp/composition.c
index 18d548c..da18f5b 100644
--- a/dlls/dcomp/composition.c
+++ b/dlls/dcomp/composition.c
@@ -1734,8 +1734,13 @@ struct compositor
     BOOL dirty, notified;
     struct anim_clock *clock;           /* its animations and batches */
     CRITICAL_SECTION cs;
+    BOOL ended;                         /* released for the last time: kept, not freed */
 };
 
+/* the reference count while a compositor ends: what lets go of it on the way (its animations'
+ * objects, their handlers) may take and drop references, which must not end it again */
+#define COMPOSITOR_ENDING 0x40000000
+
 #define WM_COMPOSITION_CHANGED (WM_USER + 1)
 #define WM_COMPOSITION_WAKE    (WM_USER + 2)
 #define ANIMATION_TIMER        1
@@ -2385,11 +2390,23 @@ static ULONG WINAPI compositor_AddRef( ICompositor *iface )
 static ULONG WINAPI compositor_Release( ICompositor *iface )
 {
     struct compositor *impl = impl_from_ICompositor( iface );
-    ULONG ref = InterlockedDecrement( &impl->ref );
+    ULONG ref;
 
+#ifndef SG_MUTANT_COMPOSITOR_FREED
+    if (impl->ended)
+    {
+        ERR( "compositor %p released after it ended\n", iface );
+        return 0;
+    }
+#endif
+    ref = InterlockedDecrement( &impl->ref );
     TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+    if ((LONG)ref < 0) ERR( "compositor %p released too often (%ld)\n", iface, (LONG)ref );
     if (!ref)
     {
+#ifndef SG_MUTANT_COMPOSITOR_FREED
+        impl->ref = COMPOSITOR_ENDING;
+#endif
         if (impl->notify_window)
         {
             SetWindowLongPtrW( impl->notify_window, GWLP_USERDATA, 0 );
@@ -2398,9 +2415,17 @@ static ULONG WINAPI compositor_Release( ICompositor *iface )
         animations_free( impl );
         WindowsDeleteString( impl->comment );
         if (impl->d2d_device) ID2D1Device_Release( impl->d2d_device );
+#ifndef SG_MUTANT_COMPOSITOR_FREED
+        /* not freed, its lock kept: a program that releases it once more than it should (OneDrive's
+         * React Native windows have been seen to), or objects of it still alive then, find it ended
+         * rather than freed memory */
+        impl->ended = TRUE;
+        impl->ref = 0;
+#else
         impl->cs.DebugInfo->Spare[0] = 0;
         DeleteCriticalSection( &impl->cs );
         free( impl );
+#endif
     }
     return ref;
 }
