+/* The text form is the transport address followed by the port, as WSAAddressToString writes it:
+ * "192.0.2.1:3702" or "[fe80::1%3]:3702".  (The format is not documented.) */
 static HRESULT WINAPI IWSDUdpAddressImpl_Serialize(IWSDUdpAddress *This, LPWSTR pszBuffer, DWORD cchLength, BOOL fSafe)
 {
-    FIXME("(%p, %p, %ld, %d)\n", This, pszBuffer, cchLength, fSafe);
-    return E_NOTIMPL;
+    IWSDUdpAddressImpl *impl = impl_from_IWSDUdpAddress(This);
+    SOCKADDR_STORAGE storage;
+    WCHAR text[96];
+    DWORD size = ARRAY_SIZE(text);
+    int len;
+
+    TRACE("(%p, %p, %ld, %d)\n", This, pszBuffer, cchLength, fSafe);
+
+    if (pszBuffer == NULL)
+        return E_POINTER;
+
+    memcpy(&storage, &impl->sockAddr, sizeof(storage));
+
+    switch (((SOCKADDR_IN *) &storage)->sin_family)
+    {
+        case AF_INET:
+#ifndef SG_MUTANT_WSD_SER_PORT
+            ((SOCKADDR_IN *) &storage)->sin_port = htons(impl->port);
+#endif
+            len = sizeof(SOCKADDR_IN);
+            break;
+
+        case AF_INET6:
+            ((SOCKADDR_IN6 *) &storage)->sin6_port = htons(impl->port);
+#ifndef SG_MUTANT_WSD_SER_SCOPE
+            if (!fSafe)
+                ((SOCKADDR_IN6 *) &storage)->sin6_scope_id = 0;
+#endif
+            len = sizeof(SOCKADDR_IN6);
+            break;
+
+        default:
+            return E_FAIL;
+    }
+
+    if (WSAAddressToStringW((LPSOCKADDR) &storage, len, NULL, text, &size) != 0)
+        return HRESULT_FROM_WIN32(WSAGetLastError());
+
+    if (size > cchLength)
+        return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+
+    memcpy(pszBuffer, text, size * sizeof(WCHAR));
+    return S_OK;
 }
 
 static HRESULT WINAPI IWSDUdpAddressImpl_Deserialize(IWSDUdpAddress *This, LPCWSTR pszBuffer)
 {
-    FIXME("(%p, %s)\n", This, debugstr_w(pszBuffer));
-    return E_NOTIMPL;
+    IWSDUdpAddressImpl *impl = impl_from_IWSDUdpAddress(This);
+    SOCKADDR_STORAGE storage;
+    int len = sizeof(storage);
+    WORD port;
+
+    TRACE("(%p, %s)\n", This, debugstr_w(pszBuffer));
+
+    if (pszBuffer == NULL)
+        return E_INVALIDARG;
+
+    memset(&storage, 0, sizeof(storage));
+
+    if (WSAStringToAddressW((LPWSTR) pszBuffer, AF_INET, NULL, (LPSOCKADDR) &storage, &len) != 0)
+    {
+        len = sizeof(storage);
+        memset(&storage, 0, sizeof(storage));
+        if (WSAStringToAddressW((LPWSTR) pszBuffer, AF_INET6, NULL, (LPSOCKADDR) &storage, &len) != 0)
+            return HRESULT_FROM_WIN32(WSAGetLastError());
+    }
+
+    if (((SOCKADDR_IN *) &storage)->sin_family == AF_INET)
+    {
+        port = ntohs(((SOCKADDR_IN *) &storage)->sin_port);
+        ((SOCKADDR_IN *) &storage)->sin_port = 0;
+    }
+    else
+    {
+        port = ntohs(((SOCKADDR_IN6 *) &storage)->sin6_port);
+        ((SOCKADDR_IN6 *) &storage)->sin6_port = 0;
+    }
+
+    memcpy(&impl->sockAddr, &storage, sizeof(storage));
+    if (port) impl->port = port;
+    return S_OK;
 }
 
