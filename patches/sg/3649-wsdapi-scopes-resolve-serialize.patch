 static HRESULT WINAPI IWSDiscoveryPublisherImpl_RegisterScopeMatchingRule(IWSDiscoveryPublisher *This, IWSDScopeMatchingRule *pScopeMatchingRule)
 {
-    FIXME("(%p, %p)\n", This, pScopeMatchingRule);
-    return E_NOTIMPL;
+    IWSDiscoveryPublisherImpl *impl = impl_from_IWSDiscoveryPublisher(This);
+    struct scope_rule *rule;
+    LPCWSTR uri = NULL;
+    HRESULT hr;
+
+    TRACE("(%p, %p)\n", This, pScopeMatchingRule);
+
+    if (pScopeMatchingRule == NULL)
+        return E_INVALIDARG;
+
+    /* the rule has to name itself and may not replace one of the standard rules */
+    hr = IWSDScopeMatchingRule_GetScopeRule(pScopeMatchingRule, &uri);
+    if (FAILED(hr)) return hr;
+    if (uri == NULL || !uri[0] || lstrlenW(uri) > WSD_MAX_TEXT_LENGTH || !lstrcmpW(uri, RULE_RFC3986)
+            || !lstrcmpW(uri, RULE_UUID) || !lstrcmpW(uri, RULE_LDAP) || !lstrcmpW(uri, RULE_STRCMP0))
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&impl->scope_rules_critical_section);
+    LIST_FOR_EACH_ENTRY(rule, &impl->scope_rules, struct scope_rule, entry)
+    {
+        LPCWSTR other = NULL;
+
+#ifdef SG_MUTANT_WSD_RULE_DUP
+        if (0 &&
+#else
+        if (rule->rule == pScopeMatchingRule ||
+#endif
+                (SUCCEEDED(IWSDScopeMatchingRule_GetScopeRule(rule->rule, &other)) && other && !lstrcmpW(other, uri)))
+        {
+            LeaveCriticalSection(&impl->scope_rules_critical_section);
+            return E_INVALIDARG;
+        }
+    }
+
+    rule = calloc(1, sizeof(*rule));
+    if (!rule)
+    {
+        LeaveCriticalSection(&impl->scope_rules_critical_section);
+        return E_OUTOFMEMORY;
+    }
+    rule->rule = pScopeMatchingRule;
+    IWSDScopeMatchingRule_AddRef(pScopeMatchingRule);
+    list_add_tail(&impl->scope_rules, &rule->entry);
+    LeaveCriticalSection(&impl->scope_rules_critical_section);
+    return S_OK;
 }
 
 static HRESULT WINAPI IWSDiscoveryPublisherImpl_UnRegisterScopeMatchingRule(IWSDiscoveryPublisher *This, IWSDScopeMatchingRule *pScopeMatchingRule)
 {
-    FIXME("(%p, %p)\n", This, pScopeMatchingRule);
-    return E_NOTIMPL;
+    IWSDiscoveryPublisherImpl *impl = impl_from_IWSDiscoveryPublisher(This);
+    struct scope_rule *rule;
+
+    TRACE("(%p, %p)\n", This, pScopeMatchingRule);
+
+    if (pScopeMatchingRule == NULL)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&impl->scope_rules_critical_section);
+    LIST_FOR_EACH_ENTRY(rule, &impl->scope_rules, struct scope_rule, entry)
+    {
+        if (rule->rule == pScopeMatchingRule)
+        {
+            list_remove(&rule->entry);
+            LeaveCriticalSection(&impl->scope_rules_critical_section);
+            IWSDScopeMatchingRule_Release(rule->rule);
+            free(rule);
+            return S_OK;
+        }
+    }
+    LeaveCriticalSection(&impl->scope_rules_critical_section);
+    return E_INVALIDARG;
 }
 
