+static SOCKET listen_socket(struct sockaddr_in *addr)
+{
+    SOCKET s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    int len = sizeof(*addr);
+    DWORD timeout = 1500;
+
+    memset(addr, 0, sizeof(*addr));
+    addr->sin_family = AF_INET;
+    addr->sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    if (bind(s, (struct sockaddr *) addr, sizeof(*addr)) || getsockname(s, (struct sockaddr *) addr, &len))
+    {
+        closesocket(s);
+        return INVALID_SOCKET;
+    }
+    setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, (const char *) &timeout, sizeof(timeout));
+    return s;
+}
+
+/* the publisher may send a message more than once: only one that answers message_id counts */
+static char *receive_message(SOCKET s, const char *message_id)
+{
+    static char buffer[16384];
+
+    for (;;)
+    {
+        int len = recv(s, buffer, sizeof(buffer) - 1, 0);
+
+        if (len <= 0) return NULL;
+        buffer[len] = 0;
+        if (strstr(buffer, message_id)) return buffer;
+    }
+}
+
+static void make_params(const struct sockaddr_in *addr, IWSDMessageParameters **params)
+{
+    IWSDUdpMessageParameters *udp;
+    IWSDUdpAddress *remote;
+    SOCKADDR_STORAGE sock;
+    HRESULT hr;
+
+    hr = WSDCreateUdpMessageParameters(&udp);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = WSDCreateUdpAddress(&remote);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    memset(&sock, 0, sizeof(sock));
+    memcpy(&sock, addr, sizeof(*addr));
+    IWSDUdpAddress_SetSockaddr(remote, &sock);
+    IWSDUdpMessageParameters_SetRemoteAddress(udp, (IWSDAddress *) remote);
+    IWSDUdpAddress_Release(remote);
+    *params = (IWSDMessageParameters *) udp;
+}
+
+static BOOL probe_matches(IWSDiscoveryPublisher *publisher, SOCKET s, const struct sockaddr_in *addr,
+        const WCHAR *match_by, const WCHAR **probe_scopes, const WCHAR **target_scopes)
+{
+    WSD_URI_LIST probe_list[2], target_list[2];
+    WSD_SCOPES scopes;
+    WSD_PROBE probe;
+    WSD_SOAP_MESSAGE msg;
+    IWSDMessageParameters *params;
+    HRESULT hr;
+    int i;
+    char *text, id[64];
+    WCHAR idw[64];
+    static int counter;
+
+    sprintf(id, "urn:uuid:11111111-2222-3333-4444-%012d", ++counter);
+    MultiByteToWideChar(CP_ACP, 0, id, -1, idw, ARRAY_SIZE(idw));
+    memset(&probe, 0, sizeof(probe));
+    memset(&msg, 0, sizeof(msg));
+    for (i = 0; i < 2; i++)
+    {
+        probe_list[i].Element = probe_scopes ? probe_scopes[i] : NULL;
+        probe_list[i].Next = i == 0 && probe_scopes && probe_scopes[1] ? &probe_list[1] : NULL;
+        target_list[i].Element = target_scopes ? target_scopes[i] : NULL;
+        target_list[i].Next = i == 0 && target_scopes && target_scopes[1] ? &target_list[1] : NULL;
+    }
+    if (probe_scopes)
+    {
+        scopes.MatchBy = match_by;
+        scopes.Scopes = probe_list;
+        probe.Scopes = &scopes;
+    }
+    msg.Header.MessageID = idw;
+    msg.Body = &probe;
+
+    make_params(addr, &params);
+    hr = IWSDiscoveryPublisher_MatchProbeEx(publisher, &msg, params, L"urn:uuid:aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee", 1, 1, 1,
+            L"urn:uuid:99999999-8888-7777-6666-555555555555", NULL, target_scopes ? target_list : NULL, NULL, NULL, NULL,
+            NULL, NULL, NULL);
+    ok(hr == S_OK, "MatchProbeEx failed %#lx.\n", hr);
+    IWSDMessageParameters_Release(params);
+
+    text = receive_message(s, id);
+    if (text) ok(strstr(text, "ProbeMatches") != NULL, "Got %s.\n", text);
+    return !!text;
+}
+
+static void test_scope_matching(void)
+{
+    static const WCHAR *probe_a[] = { L"http://sg.test/a/b", NULL };
+    static const WCHAR *probe_ab[] = { L"http://sg.test/ab", NULL };
+    static const WCHAR *probe_a1[] = { L"http://sg.test/a", NULL };
+    static const WCHAR *target_abc[] = { L"http://sg.test/abc", NULL };
+    static const WCHAR *probe_two[] = { L"http://sg.test/a", L"http://sg.test/zzz" };
+    static const WCHAR *target[] = { L"http://SG.test/a/b/c", L"http://sg.test/other" };
+    static const WCHAR *target_x[] = { L"x-urn:sg:one", NULL };
+    static const WCHAR *probe_x[] = { L"urn:sg:one", NULL };
+    static const WCHAR *probe_str[] = { L"http://sg.test/a/b/c", NULL };
+    static const WCHAR *probe_str_ok[] = { L"http://sg.test/other", NULL };
+    static const WCHAR *probe_uuid[] = { L"uuid:ABCDEF", NULL };
+    static const WCHAR *target_uuid[] = { L"uuid:abcdef", NULL };
+    IWSDiscoveryPublisherNotify notify = { (void *) &notify_vtbl };
+    test_rule rule = { { &rule_vtbl }, 1, 0 };
+    struct sockaddr_in addr;
+    IWSDiscoveryPublisher *publisher;
+    WSADATA data;
+    SOCKET s;
+    HRESULT hr;
+
+    WSAStartup(MAKEWORD(2, 2), &data);
+    s = listen_socket(&addr);
+    if (s == INVALID_SOCKET)
+    {
+        skip("Cannot create a socket.\n");
+        return;
+    }
+
+    hr = WSDCreateDiscoveryPublisher(NULL, &publisher);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IWSDiscoveryPublisher_SetAddressFamily(publisher, WSDAPI_ADDRESSFAMILY_IPV4);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IWSDiscoveryPublisher_RegisterNotificationSink(publisher, &notify);
+    if (hr != S_OK)
+    {
+        skip("The publisher cannot start (%#lx).\n", hr);
+        goto done;
+    }
+
+    ok(probe_matches(publisher, s, &addr, NULL, NULL, NULL), "A probe without scopes did not match.\n");
+    ok(probe_matches(publisher, s, &addr, NULL, probe_a, target), "The rfc3986 default did not match a path prefix.\n");
+    ok(!probe_matches(publisher, s, &addr, NULL, probe_ab, target), "rfc3986 matched in the middle of a segment.\n");
+    ok(!probe_matches(publisher, s, &addr, NULL, probe_a1, target_abc), "rfc3986 matched a partial segment.\n");
+    ok(!probe_matches(publisher, s, &addr, NULL, probe_two, target), "A probe matched with one scope missing.\n");
+    ok(!probe_matches(publisher, s, &addr, NULL, probe_a, NULL), "A probe with scopes matched a target without.\n");
+    ok(!probe_matches(publisher, s, &addr, L"http://schemas.xmlsoap.org/ws/2005/04/discovery/strcmp0", probe_str, target),
+            "strcmp0 ignored the case.\n");
+    ok(probe_matches(publisher, s, &addr, L"http://schemas.xmlsoap.org/ws/2005/04/discovery/strcmp0", probe_str_ok, target),
+            "strcmp0 did not match the same text.\n");
+    ok(probe_matches(publisher, s, &addr, L"http://schemas.xmlsoap.org/ws/2005/04/discovery/uuid", probe_uuid, target_uuid),
+            "uuid did not ignore the case.\n");
+    ok(!probe_matches(publisher, s, &addr, L"urn:sg:rule", probe_x, target_x), "An unregistered rule matched.\n");
+
+    hr = IWSDiscoveryPublisher_RegisterScopeMatchingRule(publisher, NULL);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = IWSDiscoveryPublisher_RegisterScopeMatchingRule(publisher, &rule.IWSDScopeMatchingRule_iface);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IWSDiscoveryPublisher_RegisterScopeMatchingRule(publisher, &rule.IWSDScopeMatchingRule_iface);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    ok(probe_matches(publisher, s, &addr, L"urn:sg:rule", probe_x, target_x), "The registered rule did not match.\n");
+    ok(rule.calls > 0, "The rule was not asked.\n");
+    hr = IWSDiscoveryPublisher_UnRegisterScopeMatchingRule(publisher, &rule.IWSDScopeMatchingRule_iface);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IWSDiscoveryPublisher_UnRegisterScopeMatchingRule(publisher, &rule.IWSDScopeMatchingRule_iface);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    ok(!probe_matches(publisher, s, &addr, L"urn:sg:rule", probe_x, target_x), "An unregistered rule still matched.\n");
+    ok(rule.ref == 1, "Got ref %ld.\n", rule.ref);
+
+    /* Resolve */
+    {
+        WSD_ENDPOINT_REFERENCE epr = { 0 };
+        WSD_RESOLVE resolve = { &epr, NULL };
+        WSD_SOAP_MESSAGE msg = { { 0 } };
+        WSD_URI_LIST scope = { NULL, L"http://sg.test/scope" }, xaddr = { NULL, L"http://127.0.0.1:5357/x" };
+        IWSDMessageParameters *params;
+        char *text;
+
+        msg.Header.MessageID = L"urn:uuid:11111111-2222-3333-4444-999999999999";
+        msg.Body = &resolve;
+        make_params(&addr, &params);
+
+        epr.Address = L"urn:uuid:aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee";
+        hr = IWSDiscoveryPublisher_MatchResolve(publisher, &msg, params, L"urn:uuid:aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee", 7, 1,
+                1, L"urn:uuid:99999999-8888-7777-6666-555555555555", NULL, &scope, &xaddr);
+        ok(hr == S_OK, "MatchResolve failed %#lx.\n", hr);
+        text = receive_message(s, "999999999999");
+        ok(text != NULL, "No ResolveMatches message.\n");
+        if (text)
+        {
+            ok(strstr(text, "discovery/ResolveMatches") != NULL, "Got %s.\n", text);
+            ok(strstr(text, "ResolveMatch>") != NULL && strstr(text, "ResolveMatches>") != NULL, "Got %s.\n", text);
+            ok(strstr(text, "http://sg.test/scope") != NULL && strstr(text, "http://127.0.0.1:5357/x") != NULL, "Got %s.\n", text);
+            ok(strstr(text, "ProbeMatch") == NULL, "Got %s.\n", text);
+        }
+
+        msg.Header.MessageID = L"urn:uuid:11111111-2222-3333-4444-888888888888";
+        epr.Address = L"urn:uuid:ffffffff-bbbb-cccc-dddd-eeeeeeeeeeee";
+        hr = IWSDiscoveryPublisher_MatchResolve(publisher, &msg, params, L"urn:uuid:aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee", 7, 1,
+                1, L"urn:uuid:99999999-8888-7777-6666-555555555555", NULL, &scope, &xaddr);
+        ok(hr == S_OK, "MatchResolve failed %#lx.\n", hr);
+        ok(!receive_message(s, "888888888888"), "A Resolve for another endpoint was answered.\n");
+
+        hr = IWSDiscoveryPublisher_MatchResolve(publisher, NULL, params, L"urn:uuid:aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee", 7, 1, 1,
+                NULL, NULL, &scope, &xaddr);
+        ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+        IWSDMessageParameters_Release(params);
+    }
+
+    IWSDiscoveryPublisher_UnRegisterNotificationSink(publisher, &notify);
+done:
+    IWSDiscoveryPublisher_Release(publisher);
+    closesocket(s);
+    WSACleanup();
+}
+
+START_TEST(sgcalls)
+{
+    CoInitialize(NULL);
+
+    test_udp_address_serialize();
+    test_lower_parameters();
+    test_xml_context_registration();
+    test_scope_matching();
+
+    CoUninitialize();
+}
