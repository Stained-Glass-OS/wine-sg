+static WSD_URI_LIST *build_uri_list_from_string(void *parent, LPCWSTR text)
+{
+    WSD_URI_LIST *head = NULL, **tail = &head;
+    LPCWSTR p = text;
+
+    while (*p)
+    {
+        LPCWSTR start;
+        WSD_URI_LIST *item;
+        int len;
+
+        while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
+        if (!*p) break;
+        start = p;
+        while (*p && *p != ' ' && *p != '\t' && *p != '\r' && *p != '\n') p++;
+        len = p - start;
+
+        item = WSDAllocateLinkedMemory(parent, sizeof(*item));
+        if (!item) return NULL;
+        item->Next = NULL;
+        item->Element = WSDAllocateLinkedMemory(item, (len + 1) * sizeof(WCHAR));
+        if (!item->Element) return NULL;
+        memcpy((WCHAR *) item->Element, start, len * sizeof(WCHAR));
+        ((WCHAR *) item->Element)[len] = 0;
+        *tail = item;
+        tail = &item->Next;
+    }
+
+    return head;
+}
