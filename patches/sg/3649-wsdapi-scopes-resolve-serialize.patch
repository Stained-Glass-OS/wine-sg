+#define RULE_RFC3986 L"http://schemas.xmlsoap.org/ws/2005/04/discovery/rfc3986"
+#define RULE_UUID    L"http://schemas.xmlsoap.org/ws/2005/04/discovery/uuid"
+#define RULE_LDAP    L"http://schemas.xmlsoap.org/ws/2005/04/discovery/ldap"
+#define RULE_STRCMP0 L"http://schemas.xmlsoap.org/ws/2005/04/discovery/strcmp0"
+
+/* splits "scheme://authority/path" (a query or fragment is ignored) */
+static BOOL split_uri(const WCHAR *uri, WCHAR *scheme, WCHAR *authority, WCHAR *path)
+{
+    const WCHAR *p = wcschr(uri, ':'), *start, *end;
+
+    if (!p || p == uri) return FALSE;
+    if (p - uri >= WSD_MAX_TEXT_LENGTH) return FALSE;
+    memcpy(scheme, uri, (p - uri) * sizeof(WCHAR));
+    scheme[p - uri] = 0;
+    p++;
+    authority[0] = 0;
+    if (p[0] == '/' && p[1] == '/')
+    {
+        start = p + 2;
+        end = start + wcscspn(start, L"/?#");
+        if (end - start >= WSD_MAX_TEXT_LENGTH) return FALSE;
+        memcpy(authority, start, (end - start) * sizeof(WCHAR));
+        authority[end - start] = 0;
+        p = end;
+    }
+    end = p + wcscspn(p, L"?#");
+    if (end - p >= WSD_MAX_TEXT_LENGTH) return FALSE;
+    memcpy(path, p, (end - p) * sizeof(WCHAR));
+    path[end - p] = 0;
+    return TRUE;
+}
+
+/* the path of the probe scope has to be a prefix of the path of the target, by whole segments */
+static BOOL path_is_prefix(const WCHAR *prefix, const WCHAR *path)
+{
+    size_t len = wcslen(prefix);
+
+    while (len && prefix[len - 1] == '/') len--;
+    if (wcsncmp(prefix, path, len)) return FALSE;
+#ifdef SG_MUTANT_WSD_PREFIX
+    return TRUE;
+#endif
+    return path[len] == 0 || path[len] == '/' || (len == 0);
+}
+
+static BOOL match_rfc3986(const WCHAR *probe, const WCHAR *target)
+{
+    WCHAR s1[WSD_MAX_TEXT_LENGTH], a1[WSD_MAX_TEXT_LENGTH], p1[WSD_MAX_TEXT_LENGTH];
+    WCHAR s2[WSD_MAX_TEXT_LENGTH], a2[WSD_MAX_TEXT_LENGTH], p2[WSD_MAX_TEXT_LENGTH];
+
+    if (!split_uri(probe, s1, a1, p1) || !split_uri(target, s2, a2, p2)) return FALSE;
+    if (_wcsicmp(s1, s2) || _wcsicmp(a1, a2)) return FALSE;
+    return path_is_prefix(p1, p2);
+}
+
+BOOL match_scopes(IWSDiscoveryPublisherImpl *impl, const WCHAR *match_by, const WSD_URI_LIST *probe_scopes,
+    const WSD_URI_LIST *scopes)
+{
+    const WSD_URI_LIST *probe_scope, *scope;
+    IWSDScopeMatchingRule *custom = NULL;
+    struct scope_rule *rule;
+
+    if (!match_by) match_by = RULE_RFC3986;
+#ifdef SG_MUTANT_WSD_SCOPE_SKIP
+    return TRUE;
+#endif
+
+    if (lstrcmpW(match_by, RULE_RFC3986) && lstrcmpW(match_by, RULE_UUID) && lstrcmpW(match_by, RULE_LDAP)
+            && lstrcmpW(match_by, RULE_STRCMP0))
+    {
+        EnterCriticalSection(&impl->scope_rules_critical_section);
+        LIST_FOR_EACH_ENTRY(rule, &impl->scope_rules, struct scope_rule, entry)
+        {
+            LPCWSTR uri = NULL;
+
+            if (SUCCEEDED(IWSDScopeMatchingRule_GetScopeRule(rule->rule, &uri)) && uri && !lstrcmpW(uri, match_by))
+            {
+                custom = rule->rule;
+                IWSDScopeMatchingRule_AddRef(custom);
+                break;
+            }
+        }
+        LeaveCriticalSection(&impl->scope_rules_critical_section);
+        if (!custom) return FALSE;
+    }
+
+    /* every scope of the probe has to match one of the target's scopes */
+    for (probe_scope = probe_scopes; probe_scope; probe_scope = probe_scope->Next)
+    {
+        BOOL found = FALSE;
+
+        for (scope = scopes; scope && !found; scope = scope->Next)
+        {
+            if (custom)
+            {
+                BOOL match = FALSE;
+                found = SUCCEEDED(IWSDScopeMatchingRule_MatchScopes(custom, probe_scope->Element, scope->Element, &match))
+                        && match;
+            }
+            else if (!lstrcmpW(match_by, RULE_STRCMP0))
+                found = !lstrcmpW(probe_scope->Element, scope->Element);
+            else if (!lstrcmpW(match_by, RULE_UUID) || !lstrcmpW(match_by, RULE_LDAP))
+                found = !_wcsicmp(probe_scope->Element, scope->Element);
+            else
+                found = match_rfc3986(probe_scope->Element, scope->Element);
+        }
+
+        if (!found)
+        {
+            if (custom) IWSDScopeMatchingRule_Release(custom);
+            return FALSE;
+        }
+    }
+
+    if (custom) IWSDScopeMatchingRule_Release(custom);
+    return TRUE;
+}
