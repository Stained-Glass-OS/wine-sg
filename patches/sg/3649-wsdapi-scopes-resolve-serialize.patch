+static void test_udp_address_serialize(void)
+{
+    IWSDUdpAddress *addr, *addr2;
+    SOCKADDR_STORAGE sock;
+    SOCKADDR_IN *in = (SOCKADDR_IN *) &sock;
+    SOCKADDR_IN6 *in6 = (SOCKADDR_IN6 *) &sock;
+    WCHAR buffer[100];
+    WORD port;
+    HRESULT hr;
+
+    hr = WSDCreateUdpAddress(&addr);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    hr = IWSDUdpAddress_Serialize(addr, buffer, ARRAY_SIZE(buffer), FALSE);
+    ok(hr == E_FAIL, "Got hr %#lx.\n", hr);
+    hr = IWSDUdpAddress_Serialize(addr, NULL, 10, FALSE);
+    ok(hr == E_POINTER, "Got hr %#lx.\n", hr);
+
+    memset(&sock, 0, sizeof(sock));
+    in->sin_family = AF_INET;
+    in->sin_addr.s_addr = htonl(0xc0000201);
+    hr = IWSDUdpAddress_SetSockaddr(addr, &sock);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IWSDUdpAddress_SetPort(addr, 3702);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    memset(buffer, 0xcc, sizeof(buffer));
+    hr = IWSDUdpAddress_Serialize(addr, buffer, ARRAY_SIZE(buffer), FALSE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(!lstrcmpW(buffer, L"192.0.2.1:3702"), "Got %s.\n", wine_dbgstr_w(buffer));
+
+    hr = IWSDUdpAddress_Serialize(addr, buffer, 5, FALSE);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER), "Got hr %#lx.\n", hr);
+
+    hr = WSDCreateUdpAddress(&addr2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IWSDUdpAddress_Deserialize(addr2, L"192.0.2.1:3702");
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    memset(&sock, 0, sizeof(sock));
+    hr = IWSDUdpAddress_GetSockaddr(addr2, &sock);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(in->sin_family == AF_INET && in->sin_addr.s_addr == htonl(0xc0000201), "Got family %d, address %#lx.\n",
+            in->sin_family, in->sin_addr.s_addr);
+    port = 0;
+    hr = IWSDUdpAddress_GetPort(addr2, &port);
+    ok(hr == S_OK && port == 3702, "Got hr %#lx, port %u.\n", hr, port);
+
+    hr = IWSDUdpAddress_Deserialize(addr2, NULL);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = IWSDUdpAddress_Deserialize(addr2, L"not an address");
+    ok(FAILED(hr), "Got hr %#lx.\n", hr);
+
+    /* IPv6 with a scope: only kept when safe */
+    memset(&sock, 0, sizeof(sock));
+    in6->sin6_family = AF_INET6;
+    in6->sin6_addr.s6_addr[0] = 0xfe;
+    in6->sin6_addr.s6_addr[1] = 0x80;
+    in6->sin6_addr.s6_addr[15] = 1;
+    in6->sin6_scope_id = 3;
+    hr = IWSDUdpAddress_SetSockaddr(addr, &sock);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IWSDUdpAddress_Serialize(addr, buffer, ARRAY_SIZE(buffer), TRUE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(!lstrcmpW(buffer, L"[fe80::1%3]:3702"), "Got %s.\n", wine_dbgstr_w(buffer));
+    hr = IWSDUdpAddress_Serialize(addr, buffer, ARRAY_SIZE(buffer), FALSE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(!lstrcmpW(buffer, L"[fe80::1]:3702"), "Got %s.\n", wine_dbgstr_w(buffer));
+
+    hr = IWSDUdpAddress_Deserialize(addr2, L"[fe80::1]:3703");
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    memset(&sock, 0, sizeof(sock));
+    hr = IWSDUdpAddress_GetSockaddr(addr2, &sock);
+    ok(hr == S_OK && in6->sin6_family == AF_INET6 && in6->sin6_addr.s6_addr[1] == 0x80, "Got hr %#lx.\n", hr);
+    port = 0;
+    IWSDUdpAddress_GetPort(addr2, &port);
+    ok(port == 3703, "Got port %u.\n", port);
+
+    IWSDUdpAddress_Release(addr2);
+    IWSDUdpAddress_Release(addr);
+}
