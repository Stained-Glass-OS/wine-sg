+
+static test_rule *impl_rule(IWSDScopeMatchingRule *iface)
+{
+    return CONTAINING_RECORD(iface, test_rule, IWSDScopeMatchingRule_iface);
+}
+
+static HRESULT WINAPI rule_QueryInterface(IWSDScopeMatchingRule *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IWSDScopeMatchingRule))
+    {
+        *ppv = iface;
+        IWSDScopeMatchingRule_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI rule_AddRef(IWSDScopeMatchingRule *iface)
+{
+    return InterlockedIncrement(&impl_rule(iface)->ref);
+}
+
+static ULONG WINAPI rule_Release(IWSDScopeMatchingRule *iface)
+{
+    return InterlockedDecrement(&impl_rule(iface)->ref);
+}
+
+static HRESULT WINAPI rule_GetScopeRule(IWSDScopeMatchingRule *iface, LPCWSTR *rule)
+{
+    *rule = L"urn:sg:rule";
+    return S_OK;
+}
+
+static HRESULT WINAPI rule_MatchScopes(IWSDScopeMatchingRule *iface, LPCWSTR s1, LPCWSTR s2, BOOL *match)
+{
+    impl_rule(iface)->calls++;
+    /* the same text apart from a leading "x-" on the target */
+    *match = !lstrcmpW(s2 + 2, s1) && s2[0] == 'x' && s2[1] == '-';
+    return S_OK;
+}
