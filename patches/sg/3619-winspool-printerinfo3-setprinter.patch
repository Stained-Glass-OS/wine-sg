From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winspool.drv: PRINTER_INFO_3, SetPrinter levels 3/5/6 and commands, deletion calls, datatypes (A) (3619)

winspool.drv: PRINTER_INFO_3, SetPrinter levels 3/5/6 and commands, deletion calls, datatypes (A)

GetPrinter answers level 3 (the printer's security descriptor: the stored one,
else one that lets everyone print and administrators manage; GetPrinterA passes
it through). SetPrinter now stores a level 3 descriptor, takes the level 5
attributes/port/timeouts, and runs the commands (pause, resume, purge, set
status through level 6) instead of ignoring them; SetPrinterA converts levels 3,
5 and 6. EnumPrintProcessorDatatypesA calls the wide version and converts.
DeletePrinterConnection says the name is not a connection (none is made here);
DeletePrintProcessor and DeletePrintProvidor delete the registered entry (for
administrators, never the default winprint processor or the spooler's own
providers) and report unknown ones, instead of always succeeding.

Office-facing: printing uses these through the spooler; run the printing
checks at integration.
---
diff --git a/dlls/winspool.drv/info.c b/dlls/winspool.drv/info.c
index 2c1293d..3e78640 100644
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -40,6 +40,7 @@
 #include "wingdi.h"
 #include "winspool.h"
 #include "winternl.h"
+#include "sddl.h"
 #include "winnls.h"
 #include "wine/windef16.h"
 #include "wine/exception.h"
@@ -1991,6 +1992,20 @@ static void *printer_info_AtoW( const void *data, DWORD level )
         break;
     }
 
+    case 3:
+    case 6:
+        break; /* no strings */
+
+    case 5:
+    {
+        const PRINTER_INFO_5A *piA = (const PRINTER_INFO_5A *)data;
+        PRINTER_INFO_5W *piW = (PRINTER_INFO_5W *)ret;
+
+        piW->pPrinterName = asciitounicode( &usBuffer, piA->pPrinterName );
+        piW->pPortName = asciitounicode( &usBuffer, piA->pPortName );
+        break;
+    }
+
     case 8:
     case 9:
     {
@@ -2038,6 +2053,19 @@ static void free_printer_info( void *data, DWORD level )
         break;
     }
 
+    case 3:
+    case 6:
+        break;
+
+    case 5:
+    {
+        PRINTER_INFO_5W *piW = (PRINTER_INFO_5W *)data;
+
+        free( piW->pPrinterName );
+        free( piW->pPortName );
+        break;
+    }
+
     case 8:
     case 9:
     {
@@ -3698,13 +3726,100 @@ BOOL WINAPI SetPrinterW( HANDLE printer, DWORD level, LPBYTE data, DWORD command
 
     TRACE( "(%p, %ld, %p, %ld)\n", printer, level, data, command );
 
-    if (command != 0) FIXME( "Ignoring command %ld\n", command );
-
     if (WINSPOOL_GetOpenedPrinterRegKey( printer, &key ))
         return FALSE;
 
+    if (command)
+    {
+        DWORD status = get_dword_from_reg( key, L"Status" );
+
+        switch (command)
+        {
+        case PRINTER_CONTROL_PAUSE:
+#ifndef SG_MUTANT_SP_PAUSE
+            set_reg_DWORD( key, L"Status", status | PRINTER_STATUS_PAUSED );
+#endif
+            break;
+        case PRINTER_CONTROL_RESUME:
+            set_reg_DWORD( key, L"Status", status & ~PRINTER_STATUS_PAUSED );
+            break;
+        case PRINTER_CONTROL_PURGE:
+            break; /* no job is kept here: everything is already sent on */
+        case PRINTER_CONTROL_SET_STATUS:
+            if (level != 6 || !data)
+            {
+                SetLastError( ERROR_INVALID_PARAMETER );
+                RegCloseKey( key );
+                return FALSE;
+            }
+            set_reg_DWORD( key, L"Status", ((PRINTER_INFO_6 *)data)->dwStatus );
+            break;
+        default:
+            SetLastError( ERROR_INVALID_PARAMETER );
+            RegCloseKey( key );
+            return FALSE;
+        }
+        /* the commands carry no information to set */
+        RegCloseKey( key );
+        return TRUE;
+    }
+
     switch (level)
     {
+    case 0:
+        /* nothing to set */
+        SetLastError( ERROR_INVALID_PARAMETER );
+        break;
+
+    case 3:
+    {
+        PRINTER_INFO_3 *pi3 = (PRINTER_INFO_3 *)data;
+        SECURITY_DESCRIPTOR_CONTROL control;
+        DWORD revision, len = 0;
+        BYTE *rel;
+
+        if (!pi3 || !pi3->pSecurityDescriptor || !IsValidSecurityDescriptor( pi3->pSecurityDescriptor ))
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            break;
+        }
+        GetSecurityDescriptorControl( pi3->pSecurityDescriptor, &control, &revision );
+        if (control & SE_SELF_RELATIVE)
+            len = GetSecurityDescriptorLength( pi3->pSecurityDescriptor );
+        else
+        {
+            MakeSelfRelativeSD( pi3->pSecurityDescriptor, NULL, &len );
+            if (!len || !(rel = malloc( len )))
+                break;
+            if (!MakeSelfRelativeSD( pi3->pSecurityDescriptor, rel, &len ))
+            {
+                free( rel );
+                break;
+            }
+            ret = !RegSetValueExW( key, L"Security", 0, REG_BINARY, rel, len );
+            free( rel );
+            break;
+        }
+#ifdef SG_MUTANT_SP_SD
+        ret = TRUE;
+#else
+        ret = !RegSetValueExW( key, L"Security", 0, REG_BINARY, (BYTE *)pi3->pSecurityDescriptor, len );
+#endif
+        break;
+    }
+
+    case 5:
+    {
+        PRINTER_INFO_5W *pi5 = (PRINTER_INFO_5W *)data;
+
+        set_reg_szW( key, L"Port", pi5->pPortName );
+        set_reg_DWORD( key, L"Attributes", pi5->Attributes );
+        set_reg_DWORD( key, L"dnsTimeout", pi5->DeviceNotSelectedTimeout );
+        set_reg_DWORD( key, L"txTimeout", pi5->TransmissionRetryTimeout );
+        ret = TRUE;
+        break;
+    }
+
     case 2:
     {
         PRINTER_INFO_2W *pi2 = (PRINTER_INFO_2W *)data;
@@ -4573,6 +4688,61 @@ static BOOL WINSPOOL_GetPrinter_2(HKEY hkeyPrinter, PRINTER_INFO_2W *pi2,
     return space;
 }
 
+/*********************************************************************
+ *    WINSPOOL_GetPrinter_3
+ *
+ * Fills out a PRINTER_INFO_3 with the printer's security descriptor (self relative) stored after it.
+ */
+static BOOL WINSPOOL_GetPrinter_3(HKEY hkeyPrinter, PRINTER_INFO_3 *pi3, LPBYTE buf,
+                                  DWORD cbBuf, LPDWORD pcbNeeded)
+{
+    DWORD size = 0, type;
+    BYTE *sd = NULL;
+    BOOL space = cbBuf > 0;
+
+    *pcbNeeded = 0;
+
+    /* the descriptor kept for the printer, else the one a new printer gets: everyone prints,
+     * administrators manage the printer and its documents */
+    if (!RegQueryValueExW( hkeyPrinter, L"Security", NULL, &type, NULL, &size ) && type == REG_BINARY && size &&
+        (sd = malloc( size )))
+    {
+        if (RegQueryValueExW( hkeyPrinter, L"Security", NULL, NULL, sd, &size ) ||
+            !IsValidSecurityDescriptor( sd ))
+        {
+            free( sd );
+            sd = NULL;
+        }
+    }
+    if (!sd)
+    {
+        PSECURITY_DESCRIPTOR conv;
+        ULONG len;
+
+        if (!ConvertStringSecurityDescriptorToSecurityDescriptorW( L"O:BAG:SYD:(A;;SWRC;;;WD)(A;;LCSWSDRCWDWO;;;BA)"
+                L"(A;OIIO;RPWPSDRCWDWO;;;BA)(A;OIIO;RC;;;WD)", SDDL_REVISION_1, &conv, &len ))
+            return FALSE;
+        sd = malloc( len );
+        if (sd) memcpy( sd, conv, len );
+        size = len;
+        LocalFree( conv );
+        if (!sd) return FALSE;
+    }
+    *pcbNeeded = size;
+    if (pi3 && space && size <= cbBuf)
+    {
+        memcpy( buf, sd, size );
+        pi3->pSecurityDescriptor = buf;
+    }
+    else
+    {
+        space = FALSE;
+        if (pi3) memset( pi3, 0, sizeof(*pi3) );
+    }
+    free( sd );
+    return space;
+}
+
 /*********************************************************************
  *    WINSPOOL_GetPrinter_4
  *
@@ -4784,6 +4954,24 @@ BOOL WINAPI GetPrinterW(HANDLE hPrinter, DWORD Level, LPBYTE pPrinter,
 	break;
       }
 
+    case 3:
+      {
+        PRINTER_INFO_3 *pi3 = (PRINTER_INFO_3 *)pPrinter;
+
+        size = sizeof(PRINTER_INFO_3);
+        if (size <= cbBuf) {
+            ptr = pPrinter + size;
+            cbBuf -= size;
+            memset(pPrinter, 0, size);
+        } else {
+            pi3 = NULL;
+            cbBuf = 0;
+        }
+        ret = WINSPOOL_GetPrinter_3(hkeyPrinter, pi3, ptr, cbBuf, &needed);
+        needed += size;
+        break;
+      }
+
     case 4:
       {
 	PRINTER_INFO_4W *pi4 = (PRINTER_INFO_4W *)pPrinter;
@@ -4908,6 +5096,9 @@ BOOL WINAPI GetPrinterA(HANDLE hPrinter, DWORD Level, LPBYTE pPrinter,
     BOOL ret;
     LPBYTE buf = NULL;
 
+    /* a security descriptor holds no strings: the same structure for both */
+    if (Level == 3) return GetPrinterW(hPrinter, Level, pPrinter, cbBuf, pcbNeeded);
+
     if (cbBuf)
         buf = malloc(cbBuf);
 
@@ -7670,8 +7861,15 @@ HANDLE WINAPI ConnectToPrinterDlg( HWND hWnd, DWORD Flags )
  */
 BOOL WINAPI DeletePrinterConnectionA( LPSTR pName )
 {
-    FIXME("%s\n", debugstr_a(pName));
-    return TRUE;
+    UNICODE_STRING name;
+    BOOL ret;
+
+    TRACE("%s\n", debugstr_a(pName));
+    if (!pName) { SetLastError(ERROR_INVALID_PRINTER_NAME); return FALSE; }
+    asciitounicode( &name, pName );
+    ret = DeletePrinterConnectionW( name.Buffer );
+    RtlFreeUnicodeString( &name );
+    return ret;
 }
 
 /******************************************************************************
@@ -7679,8 +7877,11 @@ BOOL WINAPI DeletePrinterConnectionA( LPSTR pName )
  */
 BOOL WINAPI DeletePrinterConnectionW( LPWSTR pName )
 {
-    FIXME("%s\n", debugstr_w(pName));
-    return TRUE;
+    TRACE("%s\n", debugstr_w(pName));
+
+    /* connections to printers shared by another machine are never made here: whatever the name, it is not one */
+    SetLastError(ERROR_INVALID_PRINTER_NAME);
+    return FALSE;
 }
 
 /******************************************************************************
@@ -7840,9 +8041,18 @@ DWORD WINAPI DeletePrinterKeyA( HANDLE printer, const char *key_name )
  */
 BOOL WINAPI DeletePrintProcessorA(LPSTR pName, LPSTR pEnvironment, LPSTR pPrintProcessorName)
 {
-    FIXME("%s %s %s\n", debugstr_a(pName), debugstr_a(pEnvironment),
-          debugstr_a(pPrintProcessorName));
-    return TRUE;
+    UNICODE_STRING name, env, proc;
+    BOOL ret;
+
+    TRACE("%s %s %s\n", debugstr_a(pName), debugstr_a(pEnvironment), debugstr_a(pPrintProcessorName));
+    asciitounicode( &name, pName );
+    asciitounicode( &env, pEnvironment );
+    asciitounicode( &proc, pPrintProcessorName );
+    ret = DeletePrintProcessorW( name.Buffer, env.Buffer, proc.Buffer );
+    RtlFreeUnicodeString( &name );
+    RtlFreeUnicodeString( &env );
+    RtlFreeUnicodeString( &proc );
+    return ret;
 }
 
 /******************************************************************************
@@ -7850,8 +8060,52 @@ BOOL WINAPI DeletePrintProcessorA(LPSTR pName, LPSTR pEnvironment, LPSTR pPrintP
  */
 BOOL WINAPI DeletePrintProcessorW(LPWSTR pName, LPWSTR pEnvironment, LPWSTR pPrintProcessorName)
 {
-    FIXME("%s %s %s\n", debugstr_w(pName), debugstr_w(pEnvironment),
-          debugstr_w(pPrintProcessorName));
+    WCHAR path[MAX_PATH * 2];
+    LONG ret;
+
+    TRACE("%s %s %s\n", debugstr_w(pName), debugstr_w(pEnvironment), debugstr_w(pPrintProcessorName));
+
+    if (pName && *pName)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!pPrintProcessorName || !*pPrintProcessorName)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!validate_envW(pEnvironment))
+        return FALSE;
+    if (!can_install_drivers())
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+    /* the processor every printer uses by default stays */
+    if (!wcsicmp(pPrintProcessorName, L"winprint"))
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+    swprintf(path, ARRAY_SIZE(path), L"System\\CurrentControlSet\\Control\\Print\\Environments\\%s\\Print Processors",
+             validate_envW(pEnvironment)->envname);
+    {
+        HKEY key;
+
+        if ((ret = RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_ALL_ACCESS, &key)))
+        {
+            SetLastError(ERROR_UNKNOWN_PRINTPROCESSOR);
+            return FALSE;
+        }
+        ret = RegDeleteTreeW(key, pPrintProcessorName);
+        RegCloseKey(key);
+    }
+    if (ret)
+    {
+        SetLastError(ret == ERROR_FILE_NOT_FOUND ? ERROR_UNKNOWN_PRINTPROCESSOR : ret);
+        return FALSE;
+    }
     return TRUE;
 }
 
@@ -7860,9 +8114,18 @@ BOOL WINAPI DeletePrintProcessorW(LPWSTR pName, LPWSTR pEnvironment, LPWSTR pPri
  */
 BOOL WINAPI DeletePrintProvidorA(LPSTR pName, LPSTR pEnvironment, LPSTR pPrintProviderName)
 {
-    FIXME("%s %s %s\n", debugstr_a(pName), debugstr_a(pEnvironment),
-          debugstr_a(pPrintProviderName));
-    return TRUE;
+    UNICODE_STRING name, env, prov;
+    BOOL ret;
+
+    TRACE("%s %s %s\n", debugstr_a(pName), debugstr_a(pEnvironment), debugstr_a(pPrintProviderName));
+    asciitounicode( &name, pName );
+    asciitounicode( &env, pEnvironment );
+    asciitounicode( &prov, pPrintProviderName );
+    ret = DeletePrintProvidorW( name.Buffer, env.Buffer, prov.Buffer );
+    RtlFreeUnicodeString( &name );
+    RtlFreeUnicodeString( &env );
+    RtlFreeUnicodeString( &prov );
+    return ret;
 }
 
 /******************************************************************************
@@ -7870,8 +8133,43 @@ BOOL WINAPI DeletePrintProvidorA(LPSTR pName, LPSTR pEnvironment, LPSTR pPrintPr
  */
 BOOL WINAPI DeletePrintProvidorW(LPWSTR pName, LPWSTR pEnvironment, LPWSTR pPrintProviderName)
 {
-    FIXME("%s %s %s\n", debugstr_w(pName), debugstr_w(pEnvironment),
-          debugstr_w(pPrintProviderName));
+    HKEY key;
+    LONG ret;
+
+    TRACE("%s %s %s\n", debugstr_w(pName), debugstr_w(pEnvironment), debugstr_w(pPrintProviderName));
+
+    if ((pName && *pName) || !pPrintProviderName || !*pPrintProviderName)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!validate_envW(pEnvironment))
+        return FALSE;
+    if (!can_install_drivers())
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+    /* the providers the spooler is made of stay */
+    if (!wcsicmp(pPrintProviderName, L"Internet Print Provider") || !wcsicmp(pPrintProviderName, L"Windows NT Remote Printers")
+            || !wcsicmp(pPrintProviderName, L"Windows NT Local Print Providor"))
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+    if ((ret = RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Print\\Providers", 0,
+                             KEY_ALL_ACCESS, &key)))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    ret = RegDeleteTreeW(key, pPrintProviderName);
+    RegCloseKey(key);
+    if (ret)
+    {
+        SetLastError(ret == ERROR_FILE_NOT_FOUND ? ERROR_INVALID_PARAMETER : ret);
+        return FALSE;
+    }
     return TRUE;
 }
 
@@ -8307,10 +8605,66 @@ BOOL WINAPI EnumPrintProcessorDatatypesA(LPSTR pName, LPSTR pPrintProcessorName,
                                          DWORD Level, LPBYTE pDatatypes, DWORD cbBuf,
                                          LPDWORD pcbNeeded, LPDWORD pcReturned)
 {
-    FIXME("Stub: %s %s %ld %p %ld %p %p\n", debugstr_a(pName),
-          debugstr_a(pPrintProcessorName), Level, pDatatypes, cbBuf,
-          pcbNeeded, pcReturned);
-    return FALSE;
+    UNICODE_STRING name, proc;
+    BYTE *bufW = NULL;
+    BOOL ret;
+    DWORD needed = 0, returned = 0;
+
+    TRACE("%s %s %ld %p %ld %p %p\n", debugstr_a(pName), debugstr_a(pPrintProcessorName), Level, pDatatypes,
+          cbBuf, pcbNeeded, pcReturned);
+
+    if (!pcbNeeded || !pcReturned)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (Level != 1)
+    {
+        SetLastError(ERROR_INVALID_LEVEL);
+        return FALSE;
+    }
+    /* wide strings take twice the room of the ANSI ones: ask in wide characters, hand back the ANSI form */
+    if (cbBuf && !(bufW = malloc(cbBuf * 2))) return FALSE;
+    asciitounicode( &name, pName );
+    asciitounicode( &proc, pPrintProcessorName );
+    ret = EnumPrintProcessorDatatypesW( name.Buffer, proc.Buffer, Level, bufW, cbBuf * 2, &needed, &returned );
+    RtlFreeUnicodeString( &name );
+    RtlFreeUnicodeString( &proc );
+    if (!ret && GetLastError() != ERROR_INSUFFICIENT_BUFFER)
+    {
+        free(bufW);
+        return FALSE;
+    }
+    {
+        DATATYPES_INFO_1W *infoW = (DATATYPES_INFO_1W *)bufW;
+        DATATYPES_INFO_1A *infoA = (DATATYPES_INFO_1A *)pDatatypes;
+        DWORD i, total = ret ? returned * sizeof(*infoA) : 0, len;
+        char *ptr;
+
+        if (ret)
+            for (i = 0; i < returned; i++)
+                total += WideCharToMultiByte(CP_ACP, 0, infoW[i].pName, -1, NULL, 0, NULL, NULL);
+        else
+            total = needed / 2 + returned * sizeof(*infoA); /* an upper bound of the ANSI size */
+        *pcbNeeded = total;
+        *pcReturned = 0;
+        if (!ret || total > cbBuf)
+        {
+            free(bufW);
+            SetLastError(ERROR_INSUFFICIENT_BUFFER);
+            return FALSE;
+        }
+        ptr = (char *)(infoA + returned);
+        for (i = 0; i < returned; i++)
+        {
+            infoA[i].pName = ptr;
+            len = WideCharToMultiByte(CP_ACP, 0, infoW[i].pName, -1, ptr, cbBuf - (ptr - (char *)pDatatypes), NULL, NULL);
+            ptr += len;
+        }
+        *pcReturned = returned;
+    }
+    free(bufW);
+    return TRUE;
 }
 
 /*****************************************************************************
