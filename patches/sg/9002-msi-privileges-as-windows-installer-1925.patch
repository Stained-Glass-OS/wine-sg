 }
 
+/* Stained Glass OS 9002: whether this install runs with an administrator's privileges, as Windows
+ * Installer decides its Privileged property -- elevated, or (Wine's own model, a prefix of one's own)
+ * holding a linked administrator's token the custom action server can use. A standard user or an
+ * unelevated administrator of a shared prefix is neither: Wine said "always admin and privileged",
+ * and an all-users package went on as them and failed half way on Program Files. */
+BOOL msi_sg_privileged(void)
+{
+    HANDLE token = GetCurrentThreadEffectiveToken(), dup;
+    TOKEN_ELEVATION elevation;
+    TOKEN_LINKED_TOKEN linked;
+    BOOL ret = FALSE;
+    DWORD size;
+
+#ifdef SG_MUTANT_MSI_ALWAYS_PRIVILEGED
+    return TRUE;
+#endif
+    if (GetTokenInformation( token, TokenElevation, &elevation, sizeof(elevation), &size ) &&
+        elevation.TokenIsElevated) return TRUE;
+    if (GetTokenInformation( token, TokenLinkedToken, &linked, sizeof(linked), &size ))
+    {
+        if ((ret = DuplicateTokenEx( linked.LinkedToken, 0, NULL, SecurityAnonymous, TokenPrimary, &dup )))
+            CloseHandle( dup );
+        CloseHandle( linked.LinkedToken );
+    }
+    return ret;
+}
+
+static void set_privilege_properties( MSIPACKAGE *package )
+{
+    BOOL privileged = msi_sg_privileged();
+    WCHAR admin[4];
+
+    /* an administrator, elevated or not (SG_USER_ADMIN: sg-session-start, for the administrators' group) */
+    if (privileged || (GetEnvironmentVariableW( L"SG_USER_ADMIN", admin, ARRAY_SIZE(admin) ) == 1 && admin[0] == '1'))
+    {
+        msi_set_property( package->db, L"AdminUser", L"1", -1 );
+        msi_set_property( package->db, L"MsiTrueAdminUser", L"1", -1 );
+    }
+    else
+    {
+        msi_set_property( package->db, L"AdminUser", NULL, -1 );
+        msi_set_property( package->db, L"MsiTrueAdminUser", NULL, -1 );
+    }
+    msi_set_property( package->db, L"Privileged", privileged ? L"1" : NULL, -1 );
+    msi_set_property( package->db, L"MsiRunningElevated", privileged ? L"1" : NULL, -1 );
+}
+
 void msi_adjust_privilege_properties( MSIPACKAGE *package )
 {
-    /* FIXME: this should depend on the user's privileges */
+    /* ALLUSERS=2, as Windows Installer 5 resolves it: per user with MSIINSTALLPERUSER=1, else for all
+     * users (9002; MSIINSTALLPERUSER was not looked at) */
     if (msi_get_property_int( package->db, L"ALLUSERS", 0 ) == 2)
     {
-        TRACE("resetting ALLUSERS property from 2 to 1\n");
-        msi_set_property( package->db, L"ALLUSERS", L"1", -1 );
+        if (msi_get_property_int( package->db, L"MSIINSTALLPERUSER", 0 ) == 1)
+        {
+            TRACE("ALLUSERS 2 with MSIINSTALLPERUSER 1: per user\n");
+            msi_set_property( package->db, L"ALLUSERS", NULL, -1 );
+        }
+        else
+        {
+            TRACE("resetting ALLUSERS property from 2 to 1\n");
+            msi_set_property( package->db, L"ALLUSERS", L"1", -1 );
+        }
     }
-    msi_set_property( package->db, L"AdminUser", L"1", -1 );
-    msi_set_property( package->db, L"Privileged", L"1", -1 );
-    msi_set_property( package->db, L"MsiRunningElevated", L"1", -1 );
-    msi_set_property( package->db, L"MsiTrueAdminUser", L"1", -1 );
+    set_privilege_properties( package );
 
