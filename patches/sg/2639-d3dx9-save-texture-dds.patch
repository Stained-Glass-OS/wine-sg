     ok(hr == D3D_OK, "D3DXSaveTextureToFileInMemory returned %#lx, expected %#lx\n", hr, D3D_OK);
     if (SUCCEEDED(hr))
@@ -3153,7 +3152,6 @@ static void test_D3DXSaveTextureToFileInMemory(IDirect3DDevice9 *device)
         ok(info.ImageFileFormat == D3DXIFF_DDS, "Got file format %#x, expected %#x\n", info.ImageFileFormat, D3DXIFF_DDS);
         ID3DXBuffer_Release(buffer);
     }
-    }
 
     IDirect3DTexture9_Release(texture);
 
@@ -3208,7 +3206,6 @@ static void test_D3DXSaveTextureToFileInMemory(IDirect3DDevice9 *device)
         ID3DXBuffer_Release(buffer);
     }
 
-    todo_wine {
     hr = D3DXSaveTextureToFileInMemory(&buffer, D3DXIFF_DDS, (IDirect3DBaseTexture9 *)cube_texture, NULL);
     ok(hr == D3D_OK, "D3DXSaveTextureToFileInMemory returned %#lx, expected %#lx\n", hr, D3D_OK);
     if (SUCCEEDED(hr))
@@ -3225,7 +3222,6 @@ static void test_D3DXSaveTextureToFileInMemory(IDirect3DDevice9 *device)
         ok(info.ImageFileFormat == D3DXIFF_DDS, "Got file format %#x, expected %#x\n", info.ImageFileFormat, D3DXIFF_DDS);
         ID3DXBuffer_Release(buffer);
     }
-    }
 
     IDirect3DCubeTexture9_Release(cube_texture);
 
@@ -3237,7 +3233,6 @@ static void test_D3DXSaveTextureToFileInMemory(IDirect3DDevice9 *device)
         return;
     }
 
-    todo_wine {
     hr = D3DXSaveTextureToFileInMemory(&buffer, D3DXIFF_BMP, (IDirect3DBaseTexture9 *)volume_texture, NULL);
     ok(hr == D3D_OK, "D3DXSaveTextureToFileInMemory returned %#lx, expected %#lx\n", hr, D3D_OK);
     if (SUCCEEDED(hr))
@@ -3273,7 +3268,6 @@ static void test_D3DXSaveTextureToFileInMemory(IDirect3DDevice9 *device)
         ok(info.ImageFileFormat == D3DXIFF_DDS, "Got file format %#x, expected %#x\n", info.ImageFileFormat, D3DXIFF_DDS);
         ID3DXBuffer_Release(buffer);
     }
-    }
 
     IDirect3DVolumeTexture9_Release(volume_texture);
 }
--- a/dlls/d3dx9_36/texture.c
+++ b/dlls/d3dx9_36/texture.c
@@ -1866,10 +1866,7 @@ HRESULT WINAPI D3DXSaveTextureToFileInMemory(ID3DXBuffer **dst_buffer, D3DXIMAGE
     if (!dst_buffer || !src_texture) return D3DERR_INVALIDCALL;
 
     if (file_format == D3DXIFF_DDS)
-    {
-        FIXME("DDS file format isn't supported yet\n");
-        return E_NOTIMPL;
-    }
+        return save_dds_texture_to_memory(dst_buffer, src_texture, src_palette);
 
     type = IDirect3DBaseTexture9_GetType(src_texture);
     switch (type)
@@ -1879,8 +1876,44 @@ HRESULT WINAPI D3DXSaveTextureToFileInMemory(ID3DXBuffer **dst_buffer, D3DXIMAGE
             hr = get_surface(type, src_texture, D3DCUBEMAP_FACE_POSITIVE_X, 0, &surface);
             break;
         case D3DRTYPE_VOLUMETEXTURE:
-            FIXME("Volume textures aren't supported yet\n");
-            return E_NOTIMPL;
+        {
+            /* the first slice of the volume */
+            IDirect3DVolumeTexture9 *volume = (IDirect3DVolumeTexture9 *)src_texture;
+            D3DVOLUME_DESC desc;
+            D3DLOCKED_BOX box;
+            const struct pixel_format_desc *fmt;
+            IDirect3DDevice9 *device;
+
+            if (FAILED(hr = IDirect3DVolumeTexture9_GetLevelDesc(volume, 0, &desc)))
+                return hr;
+            fmt = get_format_info(desc.Format);
+            if (is_unknown_format(fmt))
+                return E_NOTIMPL;
+            if (FAILED(hr = IDirect3DVolumeTexture9_GetDevice(volume, &device)))
+                return hr;
+            hr = IDirect3DDevice9_CreateOffscreenPlainSurface(device, desc.Width, desc.Height, desc.Format,
+                    D3DPOOL_SYSTEMMEM, &surface, NULL);
+            IDirect3DDevice9_Release(device);
+            if (FAILED(hr))
+                return hr;
+            if (SUCCEEDED(hr = IDirect3DVolumeTexture9_LockBox(volume, 0, &box, NULL, D3DLOCK_READONLY)))
+            {
+                D3DLOCKED_RECT rect;
+
+                if (SUCCEEDED(hr = IDirect3DSurface9_LockRect(surface, &rect, NULL, 0)))
+                {
+                    struct volume size;
+
+                    set_volume_struct(&size, desc.Width, desc.Height, 1);
+                    copy_pixels(box.pBits, box.RowPitch, box.SlicePitch, rect.pBits, rect.Pitch, 0, &size, fmt);
+                    IDirect3DSurface9_UnlockRect(surface);
+                }
+                IDirect3DVolumeTexture9_UnlockBox(volume, 0);
+            }
+            if (FAILED(hr))
+                IDirect3DSurface9_Release(surface);
+            break;
+        }
         default:
             return D3DERR_INVALIDCALL;
     }
