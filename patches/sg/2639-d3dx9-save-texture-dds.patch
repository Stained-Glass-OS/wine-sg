From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dx9: D3DXSaveTextureToFileInMemory writes DDS files of textures and volumes

D3DXSaveTextureToFile{A,W,InMemory} refused DDS (E_NOTIMPL) and volume textures. The Wine tests
(todo) record what native does:

 - DDS: the file holds all the mip levels of a texture, all six faces of a cube texture
   (positive X first) with their levels, and all slices and levels of a volume texture, with
   the mip count, the cube map caps and the depth in the header; the formats that have a
   DDS pixel format are saved as they are, with the palette of a palettized one.
 - A volume texture saved as an image file is its first slice (resource type texture).
 - Removed the todo_wine blocks of texture.c for these cases (3 blocks, 10 checks).
---
--- a/dlls/d3dx9_36/d3dx9_private.h
+++ b/dlls/d3dx9_36/d3dx9_private.h
@@ -312,6 +312,8 @@ void point_filter_argb_pixels(const BYTE *src, UINT src_row_pitch, UINT src_slic
     BYTE *dst, UINT dst_row_pitch, UINT dst_slice_pitch, const struct volume *dst_size,
     const struct pixel_format_desc *dst_format, D3DCOLOR color_key, const PALETTEENTRY *palette);
 
+HRESULT save_dds_texture_to_memory(ID3DXBuffer **dst_buffer, IDirect3DBaseTexture9 *texture,
+        const PALETTEENTRY *palette);
 HRESULT lock_surface(IDirect3DSurface9 *surface, const RECT *surface_rect, D3DLOCKED_RECT *lock,
         IDirect3DSurface9 **temp_surface, BOOL write);
 HRESULT unlock_surface(IDirect3DSurface9 *surface, const RECT *surface_rect,
--- a/dlls/d3dx9_36/surface.c
+++ b/dlls/d3dx9_36/surface.c
@@ -482,6 +482,28 @@ static HRESULT d3dx_init_dds_header(struct dds_header *header, D3DRESOURCETYPE r
     header->height = size->height;
     header->width = size->width;
     header->caps = DDS_CAPS_TEXTURE;
+    if (mip_levels > 1)
+    {
+        header->flags |= DDS_MIPMAPCOUNT;
+        header->miplevels = mip_levels;
+        header->caps |= DDS_CAPS_COMPLEX | DDS_CAPS_MIPMAP;
+    }
+    if (resource_type == D3DRTYPE_CUBETEXTURE)
+    {
+        header->caps |= DDS_CAPS_COMPLEX;
+        header->caps2 |= DDS_CAPS2_CUBEMAP | DDS_CAPS2_CUBEMAP_ALL_FACES;
+    }
+    else if (resource_type == D3DRTYPE_VOLUMETEXTURE)
+    {
+        header->flags |= DDS_DEPTH;
+#ifdef SG_MUTANT_D3DXSAVE_NO_DEPTH
+        header->depth = 1;
+#else
+        header->depth = size->depth;
+#endif
+        header->caps |= DDS_CAPS_COMPLEX;
+        header->caps2 |= DDS_CAPS2_VOLUME;
+    }
     if (header->pixel_format.flags & DDS_PF_ALPHA || header->pixel_format.flags & DDS_PF_ALPHA_ONLY)
         header->caps |= DDSCAPS_ALPHA;
     if (header->pixel_format.flags & DDS_PF_INDEXED)
@@ -559,6 +581,138 @@ exit:
     return hr;
 }
 
+/* a texture with all its levels (and faces) as a DDS file */
+HRESULT save_dds_texture_to_memory(ID3DXBuffer **dst_buffer, IDirect3DBaseTexture9 *texture,
+        const PALETTEENTRY *palette)
+{
+    const struct pixel_format_desc *fmt_desc;
+    D3DRESOURCETYPE type = IDirect3DBaseTexture9_GetType(texture);
+    uint32_t levels = IDirect3DBaseTexture9_GetLevelCount(texture), layers = 1, level, layer, header_size;
+#ifdef SG_MUTANT_D3DXSAVE_ONE_LEVEL
+    levels = 1;
+#endif
+    uint32_t row_pitch, slice_pitch, layer_size;
+    struct volume size, dims;
+    D3DFORMAT format;
+    ID3DXBuffer *buffer;
+    struct dds_header *header;
+    uint8_t *dst;
+    HRESULT hr;
+
+    switch (type)
+    {
+        case D3DRTYPE_TEXTURE:
+        {
+            D3DSURFACE_DESC desc;
+
+            IDirect3DTexture9_GetLevelDesc((IDirect3DTexture9 *)texture, 0, &desc);
+            format = desc.Format;
+            set_volume_struct(&size, desc.Width, desc.Height, 1);
+            break;
+        }
+        case D3DRTYPE_CUBETEXTURE:
+        {
+            D3DSURFACE_DESC desc;
+
+            IDirect3DCubeTexture9_GetLevelDesc((IDirect3DCubeTexture9 *)texture, 0, &desc);
+            format = desc.Format;
+            set_volume_struct(&size, desc.Width, desc.Height, 1);
+            layers = 6;
+            break;
+        }
+        case D3DRTYPE_VOLUMETEXTURE:
+        {
+            D3DVOLUME_DESC desc;
+
+            IDirect3DVolumeTexture9_GetLevelDesc((IDirect3DVolumeTexture9 *)texture, 0, &desc);
+            format = desc.Format;
+            set_volume_struct(&size, desc.Width, desc.Height, desc.Depth);
+            break;
+        }
+        default:
+            return D3DERR_INVALIDCALL;
+    }
+
+    fmt_desc = get_format_info(format);
+    if (is_unknown_format(fmt_desc))
+        return E_NOTIMPL;
+    if (is_index_format(fmt_desc) && !palette)
+        return E_NOTIMPL;
+    if (FAILED(hr = dds_pixel_format_from_d3dx_pixel_format_id(NULL, fmt_desc->format)))
+        return hr;
+
+    layer_size = d3dx_calculate_layer_pixels_size(fmt_desc->format, size.width, size.height, size.depth, levels);
+    if (!layer_size)
+        return E_NOTIMPL;
+    header_size = is_index_format(fmt_desc) ? sizeof(*header) + DDS_PALETTE_SIZE : sizeof(*header);
+    if (FAILED(hr = D3DXCreateBuffer(header_size + (SIZE_T)layer_size * layers, &buffer)))
+        return hr;
+
+    header = ID3DXBuffer_GetBufferPointer(buffer);
+    dst = (uint8_t *)header + header_size;
+    if (FAILED(hr = d3dx_init_dds_header(header, type, fmt_desc->format, &size, levels)))
+        goto fail;
+    if (is_index_format(fmt_desc))
+        memcpy((uint8_t *)header + sizeof(*header), palette, DDS_PALETTE_SIZE);
+
+    for (layer = 0; layer < layers; ++layer)
+    {
+        dims = size;
+        for (level = 0; level < levels; ++level)
+        {
+            if (FAILED(hr = d3dx_calculate_pixels_size(fmt_desc->format, dims.width, dims.height, &row_pitch,
+                    &slice_pitch)))
+                goto fail;
+
+            if (type == D3DRTYPE_VOLUMETEXTURE)
+            {
+                D3DLOCKED_BOX box;
+
+                if (FAILED(hr = IDirect3DVolumeTexture9_LockBox((IDirect3DVolumeTexture9 *)texture, level, &box,
+                        NULL, D3DLOCK_READONLY)))
+                    goto fail;
+                copy_pixels(box.pBits, box.RowPitch, box.SlicePitch, dst, row_pitch, slice_pitch, &dims, fmt_desc);
+                IDirect3DVolumeTexture9_UnlockBox((IDirect3DVolumeTexture9 *)texture, level);
+            }
+            else
+            {
+                IDirect3DSurface9 *surface, *temp_surface;
+                D3DLOCKED_RECT locked;
+
+                if (type == D3DRTYPE_TEXTURE)
+                    hr = IDirect3DTexture9_GetSurfaceLevel((IDirect3DTexture9 *)texture, level, &surface);
+                else
+#ifdef SG_MUTANT_D3DXSAVE_ONE_FACE
+                    hr = IDirect3DCubeTexture9_GetCubeMapSurface((IDirect3DCubeTexture9 *)texture, 0, level, &surface);
+#else
+                    hr = IDirect3DCubeTexture9_GetCubeMapSurface((IDirect3DCubeTexture9 *)texture, layer, level,
+                            &surface);
+#endif
+                if (FAILED(hr))
+                    goto fail;
+                if (FAILED(hr = lock_surface(surface, NULL, &locked, &temp_surface, FALSE)))
+                {
+                    IDirect3DSurface9_Release(surface);
+                    goto fail;
+                }
+                copy_pixels(locked.pBits, locked.Pitch, 0, dst, row_pitch, slice_pitch, &dims, fmt_desc);
+                unlock_surface(surface, NULL, temp_surface, FALSE);
+                IDirect3DSurface9_Release(surface);
+            }
+
+            dst += slice_pitch * dims.depth;
+            d3dx_get_next_mip_level_size(&dims);
+        }
+    }
+
+    *dst_buffer = buffer;
+    return D3D_OK;
+
+fail:
+    ID3DXBuffer_Release(buffer);
+    return hr;
+}
+
 static HRESULT save_dds_surface_to_memory(ID3DXBuffer **dst_buffer, IDirect3DSurface9 *src_surface,
         const PALETTEENTRY *src_palette, const RECT *src_rect)
 {
--- a/dlls/d3dx9_36/tests/texture.c
+++ b/dlls/d3dx9_36/tests/texture.c
@@ -3136,7 +3136,6 @@ static void test_D3DXSaveTextureToFileInMemory(IDirect3DDevice9 *device)
         }
     }
 
