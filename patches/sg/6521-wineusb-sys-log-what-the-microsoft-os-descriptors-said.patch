From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wineusb.sys: Log what the Microsoft OS descriptors said (6521)

A registry property with an unreadable name, a DeviceInterfaceGUID
value that is not a GUID, and a device that declares WinUSB without
naming one are now warned about instead of being silently taken as no
GUID (a malformed descriptor on qa5 looked like none). The parsed
properties are traced. A declaration after a statement in 6520's
transfer callback is moved.
---
diff --git a/dlls/wineusb.sys/unixlib.c b/dlls/wineusb.sys/unixlib.c
index c6b133f..3d73f82 100644
--- a/dlls/wineusb.sys/unixlib.c
+++ b/dlls/wineusb.sys/unixlib.c
@@ -190,20 +190,31 @@ static void ms_os_set_guid(struct ms_os_info *info, int interface, const unsigne
         info->guid[slot][n++] = c;
     }
     info->guid[slot][n] = 0;
+    /* Stained Glass OS (wine-sg 6521): what was parsed is logged, and a value that is not a
+     * GUID is said so, not taken as none */
+    if (n != 38 || info->guid[slot][0] != '{' || info->guid[slot][37] != '}')
+    {
+        WARN("interface %d: DeviceInterfaceGUID is not a GUID (%u bytes: %s)\n", interface, size,
+             debugstr_wn(info->guid[slot], n));
+        info->guid[slot][0] = 0;
+    }
+    else TRACE("interface %d: DeviceInterfaceGUID %s\n", interface, debugstr_w(info->guid[slot]));
 }
 
 static bool ms_os_property_is_guid(const unsigned char *name, unsigned int size)
 {
     static const char want1[] = "DeviceInterfaceGUID", want2[] = "DeviceInterfaceGUIDs";
-    char ascii[32];
+    char ascii[64];
     unsigned int i, n = 0;
 
     for (i = 0; i + 1 < size && n < sizeof(ascii) - 1; i += 2)
     {
         if (!name[i] && !name[i + 1]) break;
-        ascii[n++] = name[i];
+        ascii[n++] = name[i] >= 0x20 && name[i] < 0x7f && !name[i + 1] ? name[i] : '?';
     }
     ascii[n] = 0;
+    if (!n) WARN("a registry property with an empty or unreadable name (%u bytes)\n", size);
+    else TRACE("registry property %s (%u bytes)\n", debugstr_a(ascii), size);
     return !strcasecmp(ascii, want1) || !strcasecmp(ascii, want2);
 }
 
@@ -619,13 +630,13 @@ static int submit_tracked(struct libusb_transfer *transfer)
 
 static void LIBUSB_CALL transfer_cb(struct libusb_transfer *transfer)
 {
-    track_transfer(transfer, false);
     struct transfer_ctx *transfer_ctx = transfer->user_data;
     IRP *irp = transfer_ctx->irp;
     URB *urb = IoGetCurrentIrpStackLocation(irp)->Parameters.Others.Argument1;
     unsigned char *transfer_buffer = transfer_ctx->transfer_buffer;
     struct usb_event event;
 
+    track_transfer(transfer, false);
     TRACE("Completing IRP %p, status %#x.\n", irp, transfer->status);
 
     free(transfer_ctx);
diff --git a/dlls/wineusb.sys/wineusb.c b/dlls/wineusb.sys/wineusb.c
index 96d60a6..3c6eaa9 100644
--- a/dlls/wineusb.sys/wineusb.c
+++ b/dlls/wineusb.sys/wineusb.c
@@ -191,7 +191,10 @@ static void add_unix_device(const struct usb_add_device_event *event)
     memcpy(device->interface_guid, event->interface_guid, sizeof(device->interface_guid));
     device->interface_guid[ARRAY_SIZE(device->interface_guid) - 1] = 0;
     winusb_admin_list(device);
-    if (device->winusb)
+    if (device->winusb && !device->interface_guid[0])
+        WARN("%04x:%04x declares WinUSB but names no device interface GUID: programs find it only as a USB device.\n",
+             device->vendor, device->product);
+    else if (device->winusb)
         TRACE("WinUSB, interface GUID %s.\n", debugstr_w(device->interface_guid));
 
     EnterCriticalSection(&wineusb_cs);
