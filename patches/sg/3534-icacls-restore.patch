From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] icacls: /restore (3534)

icacls: /restore

icacls DIR /restore FILE reads the name and SDDL pairs that /save wrote (UTF-16) and sets owner, group and DACL on each object (names relative to DIR, or absolute), printing 'processed file:' per object.
---
--- a/programs/icacls/icacls_main.c
+++ b/programs/icacls/icacls_main.c
@@ -511,6 +511,70 @@
     return TRUE;
 }
 
+
+/* /restore: the file /save wrote holds a name line and an SDDL line per object (UTF-16, names relative to the
+ * directory given, or absolute); each object gets the owner, group and DACL back. */
+static int restore_acls( const WCHAR *dir, const WCHAR *aclfile )
+{
+    HANDLE file = CreateFileW( aclfile, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+    DWORD size, read;
+    WCHAR *text, *p, *name, *sddl, *next;
+
+    if (file == INVALID_HANDLE_VALUE) { error_line( aclfile, GetLastError() ); return 1; }
+    size = GetFileSize( file, NULL );
+    if (size == INVALID_FILE_SIZE || size > 64 * 1024 * 1024 || !(text = malloc( size + sizeof(WCHAR) )))
+    {
+        CloseHandle( file );
+        return 1;
+    }
+    if (!ReadFile( file, text, size, &read, NULL )) read = 0;
+    CloseHandle( file );
+    text[read / sizeof(WCHAR)] = 0;
+    p = text;
+    if (*p == 0xfeff) p++;
+
+    while (*p)
+    {
+        WCHAR full[MAX_PATH * 2];
+        PSECURITY_DESCRIPTOR sd = NULL;
+        PSID owner = NULL, group = NULL;
+        ACL *dacl = NULL;
+        BOOL present = FALSE, defaulted;
+        SECURITY_INFORMATION info = 0;
+        DWORD err;
+
+        name = p;
+        if (!(next = wcsstr( p, L"\r\n" ))) break;
+        *next = 0;
+        sddl = next + 2;
+        if (!(next = wcsstr( sddl, L"\r\n" ))) next = sddl + wcslen( sddl ); else { *next = 0; next += 2; }
+        p = next;
+        if (!*name) continue;
+
+        if (name[0] == '\\' || (name[0] && name[1] == ':') || !dir) wcscpy( full, name );
+        else swprintf( full, ARRAY_SIZE(full), L"%ls\\%ls", dir, name );
+
+        if (!ConvertStringSecurityDescriptorToSecurityDescriptorW( sddl, SDDL_REVISION_1, &sd, NULL ))
+            err = GetLastError();
+        else
+        {
+            if (GetSecurityDescriptorOwner( sd, &owner, &defaulted ) && owner) info |= OWNER_SECURITY_INFORMATION;
+            if (GetSecurityDescriptorGroup( sd, &group, &defaulted ) && group) info |= GROUP_SECURITY_INFORMATION;
+            if (GetSecurityDescriptorDacl( sd, &present, &dacl, &defaulted ) && present) info |= DACL_SECURITY_INFORMATION;
+            err = SetNamedSecurityInfoW( full, SE_FILE_OBJECT, info, owner, group, dacl, NULL );
+            LocalFree( sd );
+        }
+        if (err) { error_line( full, err ); processed_failed++; if (!opt_continue) break; }
+        else
+        {
+            processed_ok++;
+            if (!opt_quiet) out( L"processed file: %ls\n", full );
+        }
+    }
+    free( text );
+    return processed_failed ? 1 : 0;
+}
+
 static void process_one( const WCHAR *path, HANDLE save )
 {
     int i;
@@ -653,8 +717,11 @@
     {
