From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase: a COM surrogate has the bitness of its class's server

A class whose AppID has a DllSurrogate value (empty: the default dllhost)
ran in syswow64's dllhost for every 64-bit caller, so a class registered in
the 64-bit registry view failed with "class not registered" (the 32-bit
dllhost looks in the other view). The surrogate now matches the class's
server: system32's for a 64-bit class, syswow64's for a 32-bit one,
whatever the caller is.
---
--- a/dlls/combase/rpc.c
+++ b/dlls/combase/rpc.c
@@ -601,7 +601,7 @@ static HRESULT create_surrogate_server(REFCLSID rclsid, HANDLE *process)
     HKEY key;
     int arch = (sizeof(void *) > sizeof(int)) ? 64 : 32;
     REGSAM opposite = (arch == 64) ? KEY_WOW64_32KEY : KEY_WOW64_64KEY;
-    BOOL is_wow64 = FALSE, is_opposite = FALSE;
+    BOOL is_wow64 = FALSE, is_opposite = FALSE, want_64;
     HRESULT hr;
     WCHAR command[MAX_PATH + ARRAY_SIZE(processidW) + CHARS_IN_GUID];
     DWORD size;
@@ -643,12 +643,18 @@ static HRESULT create_surrogate_server(REFCLSID rclsid, HANDLE *process)
     {
         TRACE("No value for DllSurrogate key\n");
 
-        if ((sizeof(void *) == 8 || is_wow64) && opposite == KEY_WOW64_32KEY)
-            GetSystemWow64DirectoryW(command, MAX_PATH - ARRAY_SIZE(L"\\dllhost.exe"));
-        else
-            GetSystemDirectoryW(command, MAX_PATH - ARRAY_SIZE(L"\\dllhost.exe"));
+        /* The surrogate has the bitness of the class's server: the registry view
+         * the class was found in says which (the caller's own, or the opposite
+         * one). The 64-bit dllhost is in system32 and the 32-bit one in
+         * syswow64; a 32-bit caller reaches the first by the unredirected path. */
+        want_64 = (arch == 64) ? !is_opposite : is_opposite;
+#ifdef SG_MUTANT_DLLHOST_ARCH
+        want_64 = !((sizeof(void *) == 8 || is_wow64) && opposite == KEY_WOW64_32KEY) && arch == 64;
+#endif
 
-        wcscat(command, L"\\dllhost.exe");
+        GetWindowsDirectoryW(command, MAX_PATH - ARRAY_SIZE(L"\\syswow64\\dllhost.exe"));
+        wcscat(command, want_64 ? L"\\system32\\dllhost.exe" : L"\\syswow64\\dllhost.exe");
+        is_opposite = (arch == 32) && want_64;   /* the unredirected 64-bit path from a 32-bit caller */
     }
 
     /* Surrogate EXE servers are started with the /PROCESSID:{GUID} switch. */
