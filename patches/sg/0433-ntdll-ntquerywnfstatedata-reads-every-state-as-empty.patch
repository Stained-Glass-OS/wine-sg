+/*********************************************************************
+ *                  NtQueryWnfStateData   (NTDLL.@)
+ *
+ * A Windows Notification Facility state: the system publishes none, so
+ * every state reads as published but empty (change stamp 0, no data). Mail
+ * clients and browsers ask for the quiet-hours / Focus Assist state before
+ * showing a notification -- Thunderbird aborted on the missing export after
+ * downloading mail -- and an empty state means "not quiet".
+ */
+NTSTATUS WINAPI NtQueryWnfStateData( const void *state_name, const void *type_id, const void *scope,
+                                     ULONG *change_stamp, void *buffer, ULONG *size )
+{
+    FIXME( "%p %p %p %p %p %p: no states are published\n", state_name, type_id, scope, change_stamp, buffer, size );
+    if (!state_name || !change_stamp || !size) return STATUS_INVALID_PARAMETER;
+    *change_stamp = 0;
+    *size = 0;
+    return STATUS_SUCCESS;
+}
