From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] start: with its UI: a document with no program asks how to
 open it

---
 programs/start/start.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/programs/start/start.c b/programs/start/start.c
index 736e393..a1b103e 100644
--- a/programs/start/start.c
+++ b/programs/start/start.c
@@ -421,7 +421,15 @@ static void parse_command_line( int argc, WCHAR *argv[] )
 #endif
     opts.sei.nShow = SW_SHOWNORMAL;
     /* Dunno what these mean, but it looks like winMe's start uses them */
+#ifdef SG_MUTANT_START_NO_UI
     opts.sei.fMask = SEE_MASK_FLAG_DDEWAIT | SEE_MASK_FLAG_NO_UI;
+#else
+    /* Stained Glass OS (wine-sg 7830): with its UI, as start on Windows: a document whose type
+     * has no program -- none registered, or its ProgID gone with the program that registered it
+     * (a .docx left naming SG Office's) -- asks "How do you want to open this file?" (OpenWith);
+     * it printed "no application associated" and opened nothing */
+    opts.sei.fMask = SEE_MASK_FLAG_DDEWAIT;
+#endif
     opts.creation_flags = CREATE_NEW_CONSOLE;
     opts.cp_inherit = FALSE;
 
