+/* Stained Glass OS 1681: CERT_CHAIN_FIND_BY_ISSUER (documented): the chains of
+ * the store's certificates that have a private key, are for the usage asked,
+ * pass the caller's callback and have an issuer among those given */
+static BOOL chain_has_issuer(PCCERT_CHAIN_CONTEXT chain, const CERT_CHAIN_FIND_BY_ISSUER_PARA *para,
+ DWORD *chain_index, DWORD *element_index)
+{
+    DWORD c, e, i;
+
+    if (!para->cIssuer) return TRUE;
+    for (c = 0; c < chain->cChain; c++)
+        for (e = 0; e < chain->rgpChain[c]->cElement; e++)
+        {
+            PCCERT_CONTEXT cert = chain->rgpChain[c]->rgpElement[e]->pCertContext;
+            for (i = 0; i < para->cIssuer; i++)
+                if (CertCompareCertificateName(cert->dwCertEncodingType, &cert->pCertInfo->Issuer,
+                                               &para->rgIssuer[i]))
+                {
+                    *chain_index = c;
+                    *element_index = e;
+                    return TRUE;
+                }
+        }
+    return FALSE;
+}
+
+static BOOL cert_has_usage(PCCERT_CONTEXT cert, LPCSTR usage)
+{
+    CERT_ENHKEY_USAGE *eku;
+    DWORD size = 0, i;
+    BOOL ret = FALSE;
+
+    if (!usage) return TRUE;
+    if (!CertGetEnhancedKeyUsage(cert, 0, NULL, &size)) return FALSE;
+    if (!(eku = CryptMemAlloc(size))) return FALSE;
+    SetLastError(0);
+    if (CertGetEnhancedKeyUsage(cert, 0, eku, &size))
+    {
+        /* none listed and CRYPT_E_NOT_FOUND: good for all (documented) */
+        if (!eku->cUsageIdentifier) ret = GetLastError() == CRYPT_E_NOT_FOUND;
+        for (i = 0; i < eku->cUsageIdentifier && !ret; i++)
+            if (!strcmp(eku->rgpszUsageIdentifier[i], usage)) ret = TRUE;
+    }
+    CryptMemFree(eku);
+    return ret;
+}
+
+static BOOL cert_has_key(PCCERT_CONTEXT cert, DWORD flags, const CERT_CHAIN_FIND_BY_ISSUER_PARA *para)
+{
+    CRYPT_KEY_PROV_INFO *info;
+    DWORD size = 0;
+    BOOL ret;
+
+    if (flags & CERT_CHAIN_FIND_BY_ISSUER_NO_KEY_FLAG) return TRUE;
+    if (!CertGetCertificateContextProperty(cert, CERT_KEY_PROV_INFO_PROP_ID, NULL, &size)) return FALSE;
+    if (!(info = CryptMemAlloc(size))) return FALSE;
+    ret = CertGetCertificateContextProperty(cert, CERT_KEY_PROV_INFO_PROP_ID, info, &size);
+    if (ret && para && para->dwKeySpec && info->dwProvType && info->dwKeySpec != para->dwKeySpec) ret = FALSE;
+    CryptMemFree(info);
+    if (ret && (flags & CERT_CHAIN_FIND_BY_ISSUER_COMPARE_KEY_FLAG))
+    {
+        /* the key must be there, and be the certificate's */
+        HCRYPTPROV_OR_NCRYPT_KEY_HANDLE key = 0;
+        DWORD spec = 0;
+        BOOL free_key = FALSE;
+
+        ret = CryptAcquireCertificatePrivateKey(cert, CRYPT_ACQUIRE_COMPARE_KEY_FLAG |
+                                                (para ? para->dwAcquirePrivateKeyFlags : 0), NULL, &key, &spec,
+                                                &free_key);
+        if (ret && free_key)
+        {
+            if (spec == CERT_NCRYPT_KEY_SPEC) NCryptFreeObject(key);
+            else CryptReleaseContext(key, 0);
+        }
+    }
+    return ret;
+}
+
 PCCERT_CHAIN_CONTEXT WINAPI CertFindChainInStore(HCERTSTORE store,
  DWORD certEncodingType, DWORD findFlags, DWORD findType,
  const void *findPara, PCCERT_CHAIN_CONTEXT prevChainContext)
 {
-    FIXME("(%p, %08lx, %08lx, %ld, %p, %p): stub\n", store, certEncodingType,
+    const CERT_CHAIN_FIND_BY_ISSUER_PARA *para = findPara;
+    PCCERT_CONTEXT cert = NULL;
+    PCCERT_CHAIN_CONTEXT chain = NULL;
+    CERT_CHAIN_PARA chain_para;
+    DWORD chain_index = 0, element_index = 0;
+
+    TRACE("(%p, %08lx, %08lx, %ld, %p, %p)\n", store, certEncodingType,
      findFlags, findType, findPara, prevChainContext);
+
+    if (findType != CERT_CHAIN_FIND_BY_ISSUER || !store)
+    {
+        if (prevChainContext) CertFreeCertificateChain(prevChainContext);
+        SetLastError(E_INVALIDARG);
+        return NULL;
+    }
+    if (para && para->cbSize < offsetof(CERT_CHAIN_FIND_BY_ISSUER_PARA, pfnFindCallback))
+    {
+        if (prevChainContext) CertFreeCertificateChain(prevChainContext);
+        SetLastError(E_INVALIDARG);
+        return NULL;
+    }
+#ifdef SG_MUTANT_NO_FIND_CHAIN
+    SetLastError(CRYPT_E_NOT_FOUND);
+    return NULL;
+#endif
+
+    /* go on after the previous chain's certificate */
+    if (prevChainContext)
+    {
+        if (prevChainContext->cChain && prevChainContext->rgpChain[0]->cElement)
+            cert = CertDuplicateCertificateContext(prevChainContext->rgpChain[0]->rgpElement[0]->pCertContext);
+        CertFreeCertificateChain(prevChainContext);
+        if (!cert)
+        {
+            SetLastError(CRYPT_E_NOT_FOUND);
+            return NULL;
+        }
+    }
+
+    memset(&chain_para, 0, sizeof(chain_para));
+    chain_para.cbSize = sizeof(chain_para);
+    if (para && para->pszUsageIdentifier)
+    {
+        chain_para.RequestedUsage.dwType = USAGE_MATCH_TYPE_AND;
+        chain_para.RequestedUsage.Usage.cUsageIdentifier = 1;
+        chain_para.RequestedUsage.Usage.rgpszUsageIdentifier = (LPSTR *)&para->pszUsageIdentifier;
+    }
+
+    while ((cert = CertEnumCertificatesInStore(store, cert)))
+    {
+        if (certEncodingType && !(cert->dwCertEncodingType & certEncodingType)) continue;
+        if (!cert_has_key(cert, findFlags, para)) continue;
+        if (para && !cert_has_usage(cert, para->pszUsageIdentifier)) continue;
+        if (para && para->cbSize >= offsetof(CERT_CHAIN_FIND_BY_ISSUER_PARA, pdwIssuerChainIndex) &&
+            para->pfnFindCallback && !para->pfnFindCallback(cert, para->pvFindArg))
+            continue;
+        if (!CertGetCertificateChain((findFlags & CERT_CHAIN_FIND_BY_ISSUER_LOCAL_MACHINE_FLAG) ?
+                                     HCCE_LOCAL_MACHINE : HCCE_CURRENT_USER, cert, NULL, store, &chain_para,
+                                     (findFlags & CERT_CHAIN_FIND_BY_ISSUER_CACHE_ONLY_FLAG) ?
+                                     CERT_CHAIN_CACHE_ONLY_URL_RETRIEVAL : 0, NULL, &chain))
+            continue;
+        if (para && !chain_has_issuer(chain, para, &chain_index, &element_index))
+        {
+            CertFreeCertificateChain(chain);
+            chain = NULL;
+            continue;
+        }
+        if (para && para->cbSize >= sizeof(*para))
+        {
+            if (para->pdwIssuerChainIndex) *para->pdwIssuerChainIndex = chain_index;
+            if (para->pdwIssuerElementIndex) *para->pdwIssuerElementIndex = element_index;
+        }
+        CertFreeCertificateContext(cert);
+        return chain;
+    }
+    SetLastError(CRYPT_E_NOT_FOUND);
     return NULL;
 }
 
