+/* Stained Glass OS 1681: raw RSA (BCRYPT_PAD_NONE): the block raised to the
+ * key's exponent modulo its modulus. GnuTLS has no call for it; GMP, which
+ * GnuTLS's own arithmetic stands on, does the arithmetic. */
+typedef struct { int alloc; int size; void *d; } gmp_mpz;
+static void (*p__gmpz_init)( gmp_mpz * );
+static void (*p__gmpz_clear)( gmp_mpz * );
+static void (*p__gmpz_import)( gmp_mpz *, size_t, int, size_t, int, size_t, const void * );
+static void *(*p__gmpz_export)( void *, size_t *, int, size_t, int, size_t, const gmp_mpz * );
+static void (*p__gmpz_powm)( gmp_mpz *, const gmp_mpz *, const gmp_mpz *, const gmp_mpz * );
+static int (*p__gmpz_cmp)( const gmp_mpz *, const gmp_mpz * );
+
+static BOOL load_gmp(void)
+{
+    static int loaded = -1;
+    void *handle;
+
+    if (loaded != -1) return loaded;
+    loaded = 0;
+    if (!(handle = dlopen( "libgmp.so.10", RTLD_NOW ))) return FALSE;
+#define LOAD_GMP(f) if (!(p##f = dlsym( handle, #f ))) return FALSE
+    LOAD_GMP(__gmpz_init);
+    LOAD_GMP(__gmpz_clear);
+    LOAD_GMP(__gmpz_import);
+    LOAD_GMP(__gmpz_export);
+    LOAD_GMP(__gmpz_powm);
+    LOAD_GMP(__gmpz_cmp);
+#undef LOAD_GMP
+    loaded = 1;
+    return TRUE;
+}
+
+/* input ^ exponent mod modulus, as many bytes as the modulus (big-endian) */
+static NTSTATUS rsa_raw( const gnutls_datum_t *modulus, const gnutls_datum_t *exponent, const UCHAR *input,
+                         ULONG input_len, UCHAR *output, ULONG output_len, ULONG *ret_len )
+{
+    gmp_mpz m, e, x, r;
+    const UCHAR *mod = modulus->data;
+    ULONG bytes = modulus->size;
+    size_t count = 0;
+    NTSTATUS status = STATUS_SUCCESS;
+
+#ifdef SG_MUTANT_NO_RAW_RSA
+    return STATUS_NOT_IMPLEMENTED;
+#endif
+    while (bytes && !*mod) { mod++; bytes--; }  /* GnuTLS's leading zero */
+    *ret_len = bytes;
+    if (!output) return STATUS_SUCCESS;
+    if (input_len != bytes) return STATUS_INVALID_PARAMETER;  /* a whole block, as Windows asks */
+    if (output_len < bytes) return STATUS_BUFFER_TOO_SMALL;
+    if (!load_gmp()) return STATUS_NOT_SUPPORTED;
+
+    p__gmpz_init( &m ); p__gmpz_init( &e ); p__gmpz_init( &x ); p__gmpz_init( &r );
+    p__gmpz_import( &m, bytes, 1, 1, 1, 0, mod );
+    p__gmpz_import( &e, exponent->size, 1, 1, 1, 0, exponent->data );
+    p__gmpz_import( &x, input_len, 1, 1, 1, 0, input );
+    if (p__gmpz_cmp( &x, &m ) >= 0) status = STATUS_INVALID_PARAMETER;  /* not below the modulus */
+    else
+    {
+        p__gmpz_powm( &r, &x, &e, &m );
+        memset( output, 0, bytes );
+        p__gmpz_export( NULL, &count, 1, 1, 1, 0, &r );
+        if (count > bytes) status = STATUS_INTERNAL_ERROR;
+        else p__gmpz_export( output + bytes - count, &count, 1, 1, 1, 0, &r );
+    }
+    p__gmpz_clear( &m ); p__gmpz_clear( &e ); p__gmpz_clear( &x ); p__gmpz_clear( &r );
+    return status;
+}
+
+static NTSTATUS key_rsa_raw( struct key *key, BOOL private, const UCHAR *input, ULONG input_len, UCHAR *output,
+                             ULONG output_len, ULONG *ret_len )
+{
+    gnutls_datum_t m = { 0 }, e = { 0 }, d = { 0 }, p = { 0 }, q = { 0 }, u = { 0 }, e1 = { 0 }, e2 = { 0 };
+    NTSTATUS status;
+    int ret;
+
+    if (private)
+    {
+        if (!key_data(key)->a.privkey) return STATUS_INVALID_PARAMETER;
+        ret = pgnutls_privkey_export_rsa_raw( key_data(key)->a.privkey, &m, &e, &d, &p, &q, &u, &e1, &e2 );
+        if (p.data) { memset( p.data, 0, p.size ); free( p.data ); }
+        if (q.data) { memset( q.data, 0, q.size ); free( q.data ); }
+        if (u.data) { memset( u.data, 0, u.size ); free( u.data ); }
+        if (e1.data) { memset( e1.data, 0, e1.size ); free( e1.data ); }
+        if (e2.data) { memset( e2.data, 0, e2.size ); free( e2.data ); }
+    }
+    else
+    {
+        if (!key_data(key)->a.pubkey) return STATUS_INVALID_HANDLE;
+        ret = pgnutls_pubkey_export_rsa_raw( key_data(key)->a.pubkey, &m, &e );
+    }
+    if (ret)
+    {
+        pgnutls_perror( ret );
+        return STATUS_INTERNAL_ERROR;
+    }
+    status = rsa_raw( &m, private ? &d : &e, input, input_len, output, output_len, ret_len );
+    free( m.data ); free( e.data );
+    if (d.data)
+    {
+        memset( d.data, 0, d.size );
+        free( d.data );
+    }
+    return status;
+}
