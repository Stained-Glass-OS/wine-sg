From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winspool: old PPD packages listed only for 32-bit Windows install on 64-bit

Many makers' PostScript packages (Brother's BR-Script3 among them) are a
PPD on the system's PostScript core, with an INF whose model list is not
decorated for 64-bit Windows (no "NTamd64"). 64-bit Windows refuses
them; a 64-bit system now takes a model from an undecorated list as a
last resort -- the decorated list still wins when both name a model --
and installs it only when the package carries no code of its own (its
driver and configuration DLLs are the core's, and none of its files is
a DLL or program), since its 32-bit code could not run on 64-bit.

Brother's HL-3070CW BR-Script3 package now installs and prints.

Test: test/drvpkg-gate.sh (mutants SG_MUTANT_DATAONLY, DECORATION).
---
--- a/dlls/winspool.drv/install.c
+++ b/dlls/winspool.drv/install.c
@@ -104,14 +104,22 @@
 }
 
 /* the model section for the environment: the decorated one if the
- * manufacturer line lists it, else the plain one */
-static BOOL find_model( HINF inf, const WCHAR *env, const WCHAR *model, WCHAR *install, DWORD size )
+ * manufacturer line lists it, else the plain one.  A 64-bit system takes
+ * a model only an undecorated (32-bit Windows) list names as a last
+ * resort, and says so in *undecorated: such a package installs only when
+ * it carries no code (a PPD or GPD on the core drivers, as old makers'
+ * PostScript packages are). */
+static BOOL find_model( HINF inf, const WCHAR *env, const WCHAR *model, WCHAR *install, DWORD size,
+                        BOOL *undecorated )
 {
     const WCHAR *deco = env_decoration( env );
     INFCONTEXT mfg, line;
     WCHAR section[MAX_PATH], field[MAX_PATH], name[512];
     DWORD i, count;
+    BOOL last_resort = FALSE;
 
+    if (undecorated) *undecorated = FALSE;
+again:
     if (!SetupFindFirstLineW( inf, L"Manufacturer", NULL, &mfg )) return FALSE;
     do
     {
@@ -133,7 +141,7 @@
         /* a 64-bit system installs only what the package decorates for it,
          * as Windows does: an undecorated list is for 32-bit Windows */
 #ifndef SG_MUTANT_DECORATION
-        if (!decorated && wcscmp( deco, L"NTx86" )) continue;
+        if (!decorated && wcscmp( deco, L"NTx86" ) && !last_resort) continue;
 #endif
         if (!decorated) wcscpy( models, section );
         if (!SetupFindFirstLineW( inf, models, NULL, &line ) && decorated)
@@ -148,9 +156,28 @@
             if (wcsicmp( name, model )) continue;
             if (!get_field( &line, 1, install, size )) continue;
             TRACE( "model %s: %s in %s\n", debugstr_w(model), debugstr_w(install), debugstr_w(models) );
+            if (undecorated) *undecorated = !decorated && wcscmp( deco, L"NTx86" );
             return TRUE;
         } while (SetupFindNextLine( &line, &line ));
     } while (SetupFindNextLine( &mfg, &mfg ));
+#ifndef SG_MUTANT_DATAONLY
+    if (!last_resort && wcscmp( deco, L"NTx86" ))
+    {
+        last_resort = TRUE;
+        goto again;
+    }
+#endif
+    return FALSE;
+}
+
+/* a file that is code (a driver, a plug-in, a monitor...) */
+static BOOL is_code_file( const WCHAR *file )
+{
+    static const WCHAR *exts[] = { L".dll", L".exe", L".drv", L".sys", L".cpl" };
+    const WCHAR *ext = wcsrchr( file, '.' );
+    unsigned int i;
+    if (!ext) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(exts); i++) if (!wcsicmp( ext, exts[i] )) return TRUE;
     return FALSE;
 }
 
@@ -610,12 +637,12 @@
     INFCONTEXT ctx;
     unsigned int i;
     size_t len;
-    BOOL ret = FALSE;
+    BOOL ret = FALSE, undecorated;
 
     memset( &ic, 0, sizeof(ic) );
     ic.inf = SetupOpenInfFileW( inf_path, NULL, INF_STYLE_WIN4, NULL );
     if (ic.inf == INVALID_HANDLE_VALUE) return FALSE;
-    if (!find_model( ic.inf, env, model, install, ARRAY_SIZE(install) )) goto done;
+    if (!find_model( ic.inf, env, model, install, ARRAY_SIZE(install), &undecorated )) goto done;
 
     lstrcpynW( inf_dir, inf_path, ARRAY_SIZE(inf_dir) );
     if ((slash = wcsrchr( inf_dir, '\\' ))) *slash = 0;
@@ -635,6 +662,19 @@
     if (!ic.driver[0]) wcscpy( ic.driver, install );
     if (!ic.data[0]) wcscpy( ic.data, install );
     if (!ic.config[0]) wcscpy( ic.config, ic.driver );
+    if (undecorated)
+    {
+        BOOL code = !is_core_file( ic.driver ) || !is_core_file( ic.config );
+        for (i = 0; !code && i < ic.files.count; i++)
+            code = is_code_file( ic.files.names[i] ) && !is_core_file( ic.files.names[i] );
+        if (code)
+        {
+            WARN( "%s: an x86-only model list, and the package has code of its own\n", debugstr_w(model) );
+            SetLastError( ERROR_UNKNOWN_PRINTER_DRIVER );
+            goto done;
+        }
+        TRACE( "%s: an x86-only model list, but the package is all data on the core drivers\n", debugstr_w(model) );
+    }
 
     find_file( &ic, ic.driver, src[0], MAX_PATH );
     find_file( &ic, ic.data, src[1], MAX_PATH );
@@ -716,7 +756,7 @@
     inf = SetupOpenInfFileW( path, NULL, INF_STYLE_WIN4, NULL );
     if (inf == INVALID_HANDLE_VALUE) return FALSE;
     if (get_value( inf, L"Version", L"Class", cls, ARRAY_SIZE(cls) ) && !wcsicmp( cls, L"Printer" ))
-        ret = find_model( inf, current_env(), model, install, ARRAY_SIZE(install) );
+        ret = find_model( inf, current_env(), model, install, ARRAY_SIZE(install), NULL );
     SetupCloseInfFile( inf );
     return ret;
 }
