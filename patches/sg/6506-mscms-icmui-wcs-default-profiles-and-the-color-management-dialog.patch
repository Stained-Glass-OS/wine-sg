+/******************************************************************************
+ * WcsDisassociateColorProfileFromDevice         [MSCMS.@]
+ */
+BOOL WINAPI WcsDisassociateColorProfileFromDevice( WCS_PROFILE_MANAGEMENT_SCOPE scope, PCWSTR profile, PCWSTR device_name )
+{
+    WCHAR *list, *edited;
+    BOOL found, ret;
+    HKEY root;
+
+    TRACE( "%d, %s, %s\n", scope, debugstr_w(profile), debugstr_w(device_name) );
+
+    if (!valid_scope( scope ) || !profile || !device_name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    root = scope_root( scope );
+    list = get_associations( root, device_name, NULL );
+    if (!(edited = edit_associations( list, profile, FALSE, TRUE, &found )))
+    {
+        free( list );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
