+/******************************************************************************
+ * WcsSetDefaultRenderingIntent      [MSCMS.@]
+ */
+BOOL WINAPI WcsSetDefaultRenderingIntent( WCS_PROFILE_MANAGEMENT_SCOPE scope, DWORD intent )
+{
+    LONG res;
+    HKEY key;
+
+    TRACE( "%d %lu\n", scope, intent );
+
+    if (!valid_scope( scope ) || intent > INTENT_ABSOLUTE_COLORIMETRIC)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
