+/******************************************************************************
+ * WcsGetDefaultRenderingIntent      [MSCMS.@]
+ */
+static BOOL read_intent( HKEY root, DWORD *intent )
+{
+    DWORD value, size = sizeof(value);
+    BOOL ret = FALSE;
+    HKEY key;
+
+    if (RegOpenKeyExW( root, icm_root, 0, KEY_QUERY_VALUE, &key )) return FALSE;
+    if (!RegQueryValueExW( key, L"DefaultRenderingIntent", NULL, NULL, (BYTE *)&value, &size ) &&
+        value <= INTENT_ABSOLUTE_COLORIMETRIC)
+    {
+        *intent = value;
+        ret = TRUE;
+    }
+    RegCloseKey( key );
+    return ret;
+}
+
 BOOL WINAPI WcsGetDefaultRenderingIntent( WCS_PROFILE_MANAGEMENT_SCOPE scope, PDWORD intent)
 {
-    FIXME( "%d %p\n", scope, intent );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    TRACE( "%d %p\n", scope, intent );
+
+    if (!valid_scope( scope ) || !intent)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* the user's own, the system's, or perceptual */
+    if (scope == WCS_PROFILE_MANAGEMENT_SCOPE_CURRENT_USER && read_intent( HKEY_CURRENT_USER, intent )) return TRUE;
+    if (read_intent( HKEY_LOCAL_MACHINE, intent )) return TRUE;
+    *intent = INTENT_PERCEPTUAL;
+    return TRUE;
+}
