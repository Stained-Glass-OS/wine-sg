+    {
+        SetLastError( res );
+        return FALSE;
+    }
+    res = RegSetValueExW( key, L"UsePerUserProfiles", 0, REG_DWORD, (const BYTE *)&value, sizeof(value) );
+    RegCloseKey( key );
+    if (res) SetLastError( res );
+    return !res;
 }
 
