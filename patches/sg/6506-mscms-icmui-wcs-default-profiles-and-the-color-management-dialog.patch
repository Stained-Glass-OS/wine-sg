 }
 
+/* Stained Glass OS (wine-sg 6506): the WCS default profiles and rendering intents. A device's
+ * associated ICC profiles, the first its default, are kept under
+ *   <HKLM or HKCU>\Software\Microsoft\Windows NT\CurrentVersion\ICM\ProfileAssociations\<device>
+ * in "ICMProfile" (REG_MULTI_SZ; "Default" stands for no device), the user's own list used
+ * when "UsePerUserProfiles" (HKCU) is set for the device; the default rendering intent is
+ * "DefaultRenderingIntent" (REG_DWORD) under ...\ICM. A device with no default has the
+ * standard sRGB profile, as Windows gives its monitors. WCS (DMP, CAMP, GMMP) profiles are
+ * not kept here. */
+static const WCHAR icm_root[] = L"Software\\Microsoft\\Windows NT\\CurrentVersion\\ICM";
+
+static HKEY scope_root( WCS_PROFILE_MANAGEMENT_SCOPE scope )
+{
+    return scope == WCS_PROFILE_MANAGEMENT_SCOPE_CURRENT_USER ? HKEY_CURRENT_USER : HKEY_LOCAL_MACHINE;
+}
+
+static BOOL valid_scope( WCS_PROFILE_MANAGEMENT_SCOPE scope )
+{
+    return scope == WCS_PROFILE_MANAGEMENT_SCOPE_SYSTEM_WIDE || scope == WCS_PROFILE_MANAGEMENT_SCOPE_CURRENT_USER;
+}
+
+/* the association key of DEVICE (NULL: "Default"), opened or created */
+static LONG open_association_key( HKEY root, const WCHAR *device, BOOL create, REGSAM access, HKEY *key )
+{
+    WCHAR path[MAX_PATH * 2];
+    const WCHAR *name = device && *device ? device : L"Default";
+    WCHAR *p;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\ProfileAssociations\\", icm_root );
+    p = path + wcslen( path );
+    /* a device name such as \\.\DISPLAY1 becomes one key name */
+    for (; *name && p < path + ARRAY_SIZE(path) - 1; name++) *p++ = *name == '\\' ? '#' : *name;
+    *p = 0;
+    if (create) return RegCreateKeyExW( root, path, 0, NULL, 0, access, NULL, key, NULL );
+    return RegOpenKeyExW( root, path, 0, access, key );
+}
+
+/* the device's list (a multi-string, freed by the caller); NULL: none */
+static WCHAR *get_associations( HKEY root, const WCHAR *device, DWORD *size )
+{
+    DWORD type, len = 0;
+    WCHAR *list;
+    HKEY key;
+
+    if (open_association_key( root, device, FALSE, KEY_QUERY_VALUE, &key )) return NULL;
+    if (RegQueryValueExW( key, L"ICMProfile", NULL, &type, NULL, &len ) || type != REG_MULTI_SZ || len < 2 * sizeof(WCHAR) ||
+        !(list = calloc( 1, len + 2 * sizeof(WCHAR) )))
+    {
+        RegCloseKey( key );
+        return NULL;
+    }
+    RegQueryValueExW( key, L"ICMProfile", NULL, NULL, (BYTE *)list, &len );
+    RegCloseKey( key );
+    if (!*list)
+    {
+        free( list );
+        return NULL;
+    }
+    if (size) *size = len;
+    return list;
+}
+
+static BOOL set_associations( HKEY root, const WCHAR *device, const WCHAR *list )
+{
+    const WCHAR *p;
+    LONG res;
+    HKEY key;
+
+    if ((res = open_association_key( root, device, TRUE, KEY_SET_VALUE, &key )))
+    {
+        SetLastError( res );
+        return FALSE;
+    }
+    for (p = list; *p; p += wcslen( p ) + 1) ;
+    if (p == list) res = RegDeleteValueW( key, L"ICMProfile" );
+    else res = RegSetValueExW( key, L"ICMProfile", 0, REG_MULTI_SZ, (const BYTE *)list, (p - list + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    if (res == ERROR_FILE_NOT_FOUND) res = ERROR_SUCCESS;
+    if (res) SetLastError( res );
+    return !res;
+}
+
+/* the list with PROFILE taken out, and put first (FIRST) or last (!FIRST, unless already in), or not (REMOVE) */
+static WCHAR *edit_associations( const WCHAR *list, const WCHAR *profile, BOOL first, BOOL remove, BOOL *found )
+{
+    size_t len = 1 + wcslen( profile ) + 1;
+    const WCHAR *p;
+    WCHAR *out, *q;
+
+    *found = FALSE;
+    if (list) for (p = list; *p; p += wcslen( p ) + 1) len += wcslen( p ) + 1;
+    if (!(q = out = calloc( len, sizeof(WCHAR) ))) return NULL;
+    if (!remove && first)
+    {
+        wcscpy( q, profile );
+        q += wcslen( q ) + 1;
+    }
+    if (list)
+        for (p = list; *p; p += wcslen( p ) + 1)
+        {
+            if (!wcsicmp( p, profile ))
+            {
+                *found = TRUE;
+                continue;
+            }
+            wcscpy( q, p );
+            q += wcslen( q ) + 1;
+        }
+    if (!remove && !first)
+    {
+        wcscpy( q, profile );
+        q += wcslen( q ) + 1;
+    }
+    *q = 0;
+    return out;
+}
+
+/* is PROFILE (a file name) installed in the color directory? */
+static BOOL profile_installed( const WCHAR *profile )
+{
+    WCHAR path[MAX_PATH];
+    DWORD size = sizeof(path);
+
+    if (!profile || !*profile || wcschr( profile, '\\' ) || wcschr( profile, '/' )) return FALSE;
+    if (!GetColorDirectoryW( NULL, path, &size ) || wcslen( path ) + 1 + wcslen( profile ) >= MAX_PATH) return FALSE;
+    wcscat( path, L"\\" );
+    wcscat( path, profile );
+    return GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES;
+}
+
+/* the root whose list the device uses in SCOPE: the user's when it uses per-user profiles */
+static HKEY effective_root( WCS_PROFILE_MANAGEMENT_SCOPE scope, const WCHAR *device )
+{
+    DWORD value = 0, size = sizeof(value);
+    HKEY key;
+
+    if (scope != WCS_PROFILE_MANAGEMENT_SCOPE_CURRENT_USER) return HKEY_LOCAL_MACHINE;
+    if (!open_association_key( HKEY_CURRENT_USER, device, FALSE, KEY_QUERY_VALUE, &key ))
+    {
+        RegQueryValueExW( key, L"UsePerUserProfiles", NULL, NULL, (BYTE *)&value, &size );
+        RegCloseKey( key );
+    }
+    return value ? HKEY_CURRENT_USER : HKEY_LOCAL_MACHINE;
+}
+
+/* the default profile's file name, allocated; NULL with the last error set */
+static WCHAR *default_profile( WCS_PROFILE_MANAGEMENT_SCOPE scope, const WCHAR *device, COLORPROFILETYPE type,
+                               COLORPROFILESUBTYPE subtype )
+{
+    WCHAR *list, *name;
+
+    if (!valid_scope( scope ) || (type != CPT_ICC && type != CPT_DMP && type != CPT_CAMP && type != CPT_GMMP) ||
+        subtype > CPST_EXTENDED_DISPLAY_COLOR_MODE)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (type != CPT_ICC)
+    {
+        /* no WCS profiles here */
+        SetLastError( ERROR_FILE_NOT_FOUND );
+        return NULL;
+    }
+#ifndef SG_MUTANT_WCS_DEFAULT_IGNORES_LIST
+    if ((list = get_associations( effective_root( scope, device ), device, NULL ))) return list;
+#endif
+    if (!(name = wcsdup( L"sRGB Color Space Profile.icm" )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    return name;
+}
