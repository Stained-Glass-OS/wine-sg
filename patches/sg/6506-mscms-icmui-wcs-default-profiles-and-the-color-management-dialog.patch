From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscms, icmui: WCS default profiles and intents, the color management dialog (6506)

WcsGetDefaultColorProfile(Size) and WcsGetDefaultRenderingIntent were
ERROR_CALL_NOT_IMPLEMENTED; WcsSetDefaultColorProfile,
WcsSetDefaultRenderingIntent, WcsAssociate/DisassociateColorProfile,
WcsEnumColorProfiles and WcsSetUsePerUserProfiles were stubs; and
SetupColorMatchingA/W, the color management dialog programs and printer
drivers show, failed. A device's profiles (its default first) and the
default rendering intent are kept per system and per user in the
registry, the user's used when the device uses per-user profiles; a
device with none has the sRGB profile. The dialog chooses color
management on or off, the monitor and printer profiles, the rendering
intent and proofing, writes the choices back, and calls the hook and the
apply callback.
---
diff --git a/dlls/icmui/Makefile.in b/dlls/icmui/Makefile.in
index b6ca4f5..0876f84 100644
--- a/dlls/icmui/Makefile.in
+++ b/dlls/icmui/Makefile.in
@@ -1,5 +1,6 @@
 MODULE    = icmui.dll
 IMPORTLIB = icmui
+IMPORTS   = mscms user32
 
 SOURCES = \
 	icmui.c
diff --git a/dlls/icmui/icmui.c b/dlls/icmui/icmui.c
index 6ef6a09..d42b98e 100644
--- a/dlls/icmui/icmui.c
+++ b/dlls/icmui/icmui.c
@@ -20,16 +20,360 @@
 
 #include "windef.h"
 #include "winbase.h"
+#include "winnls.h"
 #include "wingdi.h"
 #include "winuser.h"
 #include "icm.h"
+#include <stdlib.h>
+#include <stdio.h>
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(icmui);
 
+/* Stained Glass OS (wine-sg 6506): the color management dialog of a program or a printer
+ * driver: color management on or off, the monitor's and the printer's profiles, the rendering
+ * intent, and proofing (a target device emulated, with its own intent). What the user picks is
+ * written back into the structure; the apply callback (CMS_USEAPPLYCALLBACK) is called by
+ * Apply, the hook (CMS_USEHOOK) sees the dialog's messages first. */
+enum
+{
+    IDC_ENABLE = 1001, IDC_MONITOR, IDC_PRINTER, IDC_INTENT, IDC_PROOF, IDC_TARGET, IDC_PROOF_INTENT, IDC_APPLY,
+    IDC_SOURCE
+};
+
+struct cms_dialog
+{
+    COLORMATCHSETUPW *cms;
+    HFONT font;
+};
+
+static const WCHAR *intent_names[] =
+{
+    L"Pictures (perceptual)",                /* INTENT_PERCEPTUAL */
+    L"Proof (relative colorimetric)",        /* INTENT_RELATIVE_COLORIMETRIC */
+    L"Graphics (saturation)",                /* INTENT_SATURATION */
+    L"Match (absolute colorimetric)",        /* INTENT_ABSOLUTE_COLORIMETRIC */
+};
+
+static HWND add_control( HWND dialog, const WCHAR *class, const WCHAR *text, DWORD style, int id,
+                         int x, int y, int w, int h, HFONT font )
+{
+    RECT r = { x, y, x + w, y + h };
+    HWND hwnd;
+
+    MapDialogRect( dialog, &r );
+    hwnd = CreateWindowExW( 0, class, text, WS_CHILD | WS_VISIBLE | style, r.left, r.top, r.right - r.left,
+                            r.bottom - r.top, dialog, (HMENU)(INT_PTR)id, GetModuleHandleW( NULL ), NULL );
+    if (hwnd && font) SendMessageW( hwnd, WM_SETFONT, (WPARAM)font, FALSE );
+    return hwnd;
+}
+
+/* the installed profiles into COMBO, SELECTED (or the first) chosen */
+static void fill_profiles( HWND combo, const WCHAR *selected )
+{
+    ENUMTYPEW record = { sizeof(record), ENUM_TYPE_VERSION, 0 };
+    DWORD size = 0, count = 0, i;
+    WCHAR *names, *p;
+    INT index = -1;
+
+    EnumColorProfilesW( NULL, &record, NULL, &size, &count );
+    if (size && (names = malloc( size )))
+    {
+        if (EnumColorProfilesW( NULL, &record, (BYTE *)names, &size, &count ))
+            for (p = names, i = 0; *p && i < count; p += wcslen( p ) + 1, i++)
+            {
+                INT at = SendMessageW( combo, CB_ADDSTRING, 0, (LPARAM)p );
+                if (selected && !wcsicmp( p, selected )) index = at;
+            }
+        free( names );
+    }
+    if (index < 0 && selected && *selected) index = SendMessageW( combo, CB_ADDSTRING, 0, (LPARAM)selected );
+    SendMessageW( combo, CB_SETCURSEL, index >= 0 ? index : 0, 0 );
+}
+
+static void fill_intents( HWND combo, DWORD intent )
+{
+    int i;
+    for (i = 0; i < ARRAY_SIZE(intent_names); i++) SendMessageW( combo, CB_ADDSTRING, 0, (LPARAM)intent_names[i] );
+    SendMessageW( combo, CB_SETCURSEL, intent <= INTENT_ABSOLUTE_COLORIMETRIC ? intent : INTENT_PERCEPTUAL, 0 );
+}
+
+static void update_enabled( HWND dialog, const COLORMATCHSETUPW *cms )
+{
+    BOOL on = IsDlgButtonChecked( dialog, IDC_ENABLE ) == BST_CHECKED;
+    BOOL proof = on && IsDlgButtonChecked( dialog, IDC_PROOF ) == BST_CHECKED;
+
+    EnableWindow( GetDlgItem( dialog, IDC_MONITOR ), on );
+    EnableWindow( GetDlgItem( dialog, IDC_PRINTER ), on && cms->pPrinterName );
+    EnableWindow( GetDlgItem( dialog, IDC_INTENT ), on && !(cms->dwFlags & (CMS_DISABLEINTENT | CMS_DISABLERENDERINTENT)) );
+    EnableWindow( GetDlgItem( dialog, IDC_PROOF ), on );
+    EnableWindow( GetDlgItem( dialog, IDC_TARGET ), proof );
+    EnableWindow( GetDlgItem( dialog, IDC_PROOF_INTENT ), proof && !(cms->dwFlags & CMS_DISABLEINTENT) );
+}
+
+/* COMBO's choice into BUFFER (CC characters); FALSE if it does not fit */
+static BOOL get_choice( HWND combo, WCHAR *buffer, DWORD cc )
+{
+    INT index = SendMessageW( combo, CB_GETCURSEL, 0, 0 ), len;
+
+    if (!buffer || !cc) return TRUE;
+    if (index < 0) { buffer[0] = 0; return TRUE; }
+    len = SendMessageW( combo, CB_GETLBTEXTLEN, index, 0 );
+    if (len < 0 || (DWORD)len + 1 > cc) return FALSE;
+    SendMessageW( combo, CB_GETLBTEXT, index, (LPARAM)buffer );
+    return TRUE;
+}
+
+/* the dialog's choices into the structure; FALSE: a profile did not fit its buffer */
+static BOOL store_choices( HWND dialog, COLORMATCHSETUPW *cms )
+{
+    BOOL fits = TRUE;
+
+    cms->dwFlags &= ~(CMS_DISABLEICM | CMS_ENABLEPROOFING | CMS_MONITOROVERFLOW | CMS_PRINTERROVERFLOW | CMS_TARGETOVERFLOW);
+    if (IsDlgButtonChecked( dialog, IDC_ENABLE ) != BST_CHECKED) cms->dwFlags |= CMS_DISABLEICM;
+    if (IsDlgButtonChecked( dialog, IDC_PROOF ) == BST_CHECKED) cms->dwFlags |= CMS_ENABLEPROOFING;
+    cms->dwRenderIntent = SendDlgItemMessageW( dialog, IDC_INTENT, CB_GETCURSEL, 0, 0 );
+    cms->dwProofingIntent = SendDlgItemMessageW( dialog, IDC_PROOF_INTENT, CB_GETCURSEL, 0, 0 );
+    if (!get_choice( GetDlgItem( dialog, IDC_MONITOR ), cms->pMonitorProfile, cms->ccMonitorProfile ))
+    {
+        cms->dwFlags |= CMS_MONITOROVERFLOW;
+        fits = FALSE;
+    }
+    if (cms->pPrinterName && !get_choice( GetDlgItem( dialog, IDC_PRINTER ), cms->pPrinterProfile, cms->ccPrinterProfile ))
+    {
+        cms->dwFlags |= CMS_PRINTERROVERFLOW;
+        fits = FALSE;
+    }
+    if (!get_choice( GetDlgItem( dialog, IDC_TARGET ), cms->pTargetProfile, cms->ccTargetProfile ))
+    {
+        cms->dwFlags |= CMS_TARGETOVERFLOW;
+        fits = FALSE;
+    }
+    return fits;
+}
+
+static INT_PTR CALLBACK cms_dialog_proc( HWND dialog, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    struct cms_dialog *data = (struct cms_dialog *)GetWindowLongPtrW( dialog, DWLP_USER );
+    COLORMATCHSETUPW *cms;
+
+    if (msg == WM_INITDIALOG)
+    {
+        WCHAR title[300], monitor[MAX_PATH] = L"";
+        DWORD size = sizeof(monitor);
+        HFONT font;
+
+        data = (struct cms_dialog *)lparam;
+        cms = data->cms;
+        SetWindowLongPtrW( dialog, DWLP_USER, (LONG_PTR)data );
+        font = data->font = (HFONT)SendMessageW( dialog, WM_GETFONT, 0, 0 );
+        swprintf( title, ARRAY_SIZE(title), L"Color management for %s", cms->pSourceName ? cms->pSourceName : L"" );
+        add_control( dialog, L"Static", title, SS_LEFT, IDC_SOURCE, 7, 7, 236, 10, font );
+        add_control( dialog, L"Button", L"&Enable color management", BS_AUTOCHECKBOX | WS_TABSTOP, IDC_ENABLE, 7, 22, 236, 10, font );
+        add_control( dialog, L"Static", L"&Monitor profile:", SS_LEFT, -1, 7, 38, 80, 10, font );
+        add_control( dialog, L"ComboBox", NULL, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP, IDC_MONITOR, 90, 36, 153, 100, font );
+        add_control( dialog, L"Static", L"&Printer profile:", SS_LEFT, -1, 7, 56, 80, 10, font );
+        add_control( dialog, L"ComboBox", NULL, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP, IDC_PRINTER, 90, 54, 153, 100, font );
+        add_control( dialog, L"Static", L"&Rendering intent:", SS_LEFT, -1, 7, 74, 80, 10, font );
+        add_control( dialog, L"ComboBox", NULL, CBS_DROPDOWNLIST | WS_TABSTOP, IDC_INTENT, 90, 72, 153, 80, font );
+        add_control( dialog, L"Button", L"Proof (&emulate the device below)", BS_AUTOCHECKBOX | WS_TABSTOP, IDC_PROOF, 7, 92, 236, 10, font );
+        add_control( dialog, L"Static", L"Emulated &device:", SS_LEFT, -1, 7, 108, 80, 10, font );
+        add_control( dialog, L"ComboBox", NULL, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP, IDC_TARGET, 90, 106, 153, 100, font );
+        add_control( dialog, L"Static", L"Proofing in&tent:", SS_LEFT, -1, 7, 126, 80, 10, font );
+        add_control( dialog, L"ComboBox", NULL, CBS_DROPDOWNLIST | WS_TABSTOP, IDC_PROOF_INTENT, 90, 124, 153, 80, font );
+        add_control( dialog, L"Button", L"OK", BS_DEFPUSHBUTTON | WS_TABSTOP, IDOK, 85, 146, 50, 14, font );
+        add_control( dialog, L"Button", L"Cancel", BS_PUSHBUTTON | WS_TABSTOP, IDCANCEL, 139, 146, 50, 14, font );
+        if (cms->dwFlags & CMS_USEAPPLYCALLBACK)
+            add_control( dialog, L"Button", L"&Apply", BS_PUSHBUTTON | WS_TABSTOP, IDC_APPLY, 193, 146, 50, 14, font );
+
+        CheckDlgButton( dialog, IDC_ENABLE, cms->dwFlags & CMS_DISABLEICM ? BST_UNCHECKED : BST_CHECKED );
+        CheckDlgButton( dialog, IDC_PROOF, cms->dwFlags & CMS_ENABLEPROOFING ? BST_CHECKED : BST_UNCHECKED );
+        if ((cms->dwFlags & CMS_SETMONITORPROFILE) && cms->pMonitorProfile) lstrcpynW( monitor, cms->pMonitorProfile, MAX_PATH );
+        else WcsGetDefaultColorProfile( WCS_PROFILE_MANAGEMENT_SCOPE_CURRENT_USER, cms->pDisplayName, CPT_ICC,
+                                        CPST_NONE, 0, size, monitor );
+        fill_profiles( GetDlgItem( dialog, IDC_MONITOR ), monitor );
+        fill_profiles( GetDlgItem( dialog, IDC_PRINTER ),
+                       (cms->dwFlags & CMS_SETPRINTERPROFILE) ? cms->pPrinterProfile : NULL );
+        fill_profiles( GetDlgItem( dialog, IDC_TARGET ),
+                       (cms->dwFlags & CMS_SETTARGETPROFILE) ? cms->pTargetProfile : NULL );
+        fill_intents( GetDlgItem( dialog, IDC_INTENT ),
+                      (cms->dwFlags & CMS_SETRENDERINTENT) ? cms->dwRenderIntent : INTENT_PERCEPTUAL );
+        fill_intents( GetDlgItem( dialog, IDC_PROOF_INTENT ),
+                      (cms->dwFlags & CMS_SETPROOFINTENT) ? cms->dwProofingIntent : INTENT_ABSOLUTE_COLORIMETRIC );
+        update_enabled( dialog, cms );
+        if ((cms->dwFlags & CMS_USEHOOK) && cms->lpfnHook) cms->lpfnHook( dialog, WM_INITDIALOG, wparam, cms->lParam );
+        return TRUE;
+    }
+    if (!data) return FALSE;
+    cms = data->cms;
+    if ((cms->dwFlags & CMS_USEHOOK) && cms->lpfnHook && cms->lpfnHook( dialog, msg, wparam, lparam )) return TRUE;
+
+    if (msg == WM_COMMAND)
+    {
+        switch (LOWORD(wparam))
+        {
+        case IDC_ENABLE:
+        case IDC_PROOF:
+            update_enabled( dialog, cms );
+            return TRUE;
+        case IDC_APPLY:
+            store_choices( dialog, cms );
+            if (cms->lpfnApplyCallback) cms->lpfnApplyCallback( cms, cms->lParamApplyCallback );
+            return TRUE;
+        case IDOK:
+#ifndef SG_MUTANT_ICMUI_NOT_STORED
+            EndDialog( dialog, store_choices( dialog, cms ) ? IDOK : IDABORT );
+#else
+            EndDialog( dialog, IDOK );
+#endif
+            return TRUE;
+        case IDCANCEL:
+            EndDialog( dialog, IDCANCEL );
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+/* an empty dialog of 250 x 167 dialog units, in the shell font */
+static DLGTEMPLATE *make_template(void)
+{
+    static const WCHAR caption[] = L"Color Management";
+    static const WCHAR face[] = L"MS Shell Dlg";
+    size_t size = sizeof(DLGTEMPLATE) + 2 * sizeof(WORD) + sizeof(caption) + sizeof(WORD) + sizeof(face);
+    DLGTEMPLATE *t = calloc( 1, size );
+    WORD *p;
+
+    if (!t) return NULL;
+    t->style = DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU;
+    t->cdit = 0;
+    t->cx = 250;
+    t->cy = 167;
+    p = (WORD *)(t + 1);
+    *p++ = 0;   /* no menu */
+    *p++ = 0;   /* the dialog class */
+    memcpy( p, caption, sizeof(caption) );
+    p += ARRAY_SIZE(caption);
+    *p++ = 8;   /* point size */
+    memcpy( p, face, sizeof(face) );
+    return t;
+}
+
 BOOL WINAPI SetupColorMatchingW( COLORMATCHSETUPW *cms )
 {
-    FIXME( "cms %p - stub!\n", cms );
-    SetLastError( ERROR_INVALID_PARAMETER );
+    struct cms_dialog data;
+    DLGTEMPLATE *template;
+    INT_PTR ret;
+
+    TRACE( "cms %p\n", cms );
+
+    if (!cms || cms->dwSize != sizeof(*cms) || cms->dwVersion != COLOR_MATCH_VERSION ||
+        ((cms->dwFlags & CMS_USEHOOK) && !cms->lpfnHook) ||
+        ((cms->dwFlags & CMS_USEAPPLYCALLBACK) && !cms->lpfnApplyCallback))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(template = make_template()))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    data.cms = cms;
+    data.font = NULL;
+    ret = DialogBoxIndirectParamW( GetModuleHandleW( NULL ), template, cms->hwndOwner, cms_dialog_proc, (LPARAM)&data );
+    free( template );
+    if (ret == IDOK)
+    {
+        SetLastError( ERROR_SUCCESS );
+        return TRUE;
+    }
+    SetLastError( ret == IDABORT ? ERROR_INSUFFICIENT_BUFFER : ERROR_SUCCESS );
     return FALSE;
 }
+
+/* the ANSI form: strings converted in and the chosen profiles back */
+struct cms_callback_a
+{
+    COLORMATCHSETUPA *a;
+    COLORMATCHSETUPW *w;
+};
+
+static void cms_w_to_a( const COLORMATCHSETUPW *w, COLORMATCHSETUPA *a )
+{
+    a->dwFlags = w->dwFlags;
+    a->dwRenderIntent = w->dwRenderIntent;
+    a->dwProofingIntent = w->dwProofingIntent;
+    if (a->pMonitorProfile && a->ccMonitorProfile)
+        WideCharToMultiByte( CP_ACP, 0, w->pMonitorProfile, -1, a->pMonitorProfile, a->ccMonitorProfile, NULL, NULL );
+    if (a->pPrinterProfile && a->ccPrinterProfile)
+        WideCharToMultiByte( CP_ACP, 0, w->pPrinterProfile, -1, a->pPrinterProfile, a->ccPrinterProfile, NULL, NULL );
+    if (a->pTargetProfile && a->ccTargetProfile)
+        WideCharToMultiByte( CP_ACP, 0, w->pTargetProfile, -1, a->pTargetProfile, a->ccTargetProfile, NULL, NULL );
+}
+
+static BOOL WINAPI apply_callback_a( COLORMATCHSETUPW *w, LPARAM lparam )
+{
+    struct cms_callback_a *cb = (struct cms_callback_a *)lparam;
+    cms_w_to_a( w, cb->a );
+    return cb->a->lpfnApplyCallback( cb->a, cb->a->lParamApplyCallback );
+}
+
+static WCHAR *strdup_a_to_w( const char *s, DWORD extra )
+{
+    int len;
+    WCHAR *w;
+
+    if (!s && !extra) return NULL;
+    len = s ? MultiByteToWideChar( CP_ACP, 0, s, -1, NULL, 0 ) : 1;
+    if (!(w = calloc( max( (DWORD)len, extra ) + 1, sizeof(WCHAR) ))) return NULL;
+    if (s) MultiByteToWideChar( CP_ACP, 0, s, -1, w, len );
+    return w;
+}
+
+BOOL WINAPI SetupColorMatchingA( COLORMATCHSETUPA *cms )
+{
+    COLORMATCHSETUPW w;
+    struct cms_callback_a cb = { cms, &w };
+    BOOL ret;
+
+    TRACE( "cms %p\n", cms );
+
+    if (!cms || cms->dwSize != sizeof(*cms))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    memset( &w, 0, sizeof(w) );
+    w.dwSize = sizeof(w);
+    w.dwVersion = cms->dwVersion;
+    w.dwFlags = cms->dwFlags;
+    w.hwndOwner = cms->hwndOwner;
+    w.pSourceName = strdup_a_to_w( cms->pSourceName, 0 );
+    w.pDisplayName = strdup_a_to_w( cms->pDisplayName, 0 );
+    w.pPrinterName = strdup_a_to_w( cms->pPrinterName, 0 );
+    w.dwRenderIntent = cms->dwRenderIntent;
+    w.dwProofingIntent = cms->dwProofingIntent;
+    w.pMonitorProfile = strdup_a_to_w( cms->pMonitorProfile, cms->ccMonitorProfile );
+    w.ccMonitorProfile = cms->ccMonitorProfile;
+    w.pPrinterProfile = strdup_a_to_w( cms->pPrinterProfile, cms->ccPrinterProfile );
+    w.ccPrinterProfile = cms->ccPrinterProfile;
+    w.pTargetProfile = strdup_a_to_w( cms->pTargetProfile, cms->ccTargetProfile );
+    w.ccTargetProfile = cms->ccTargetProfile;
+    w.lpfnHook = cms->lpfnHook;
+    w.lParam = cms->lParam;
+    if (cms->dwFlags & CMS_USEAPPLYCALLBACK)
+    {
+        w.lpfnApplyCallback = cms->lpfnApplyCallback ? apply_callback_a : NULL;
+        w.lParamApplyCallback = (LPARAM)&cb;
+    }
+    ret = SetupColorMatchingW( &w );
+    if (ret || GetLastError() == ERROR_INSUFFICIENT_BUFFER) cms_w_to_a( &w, cms );
+    free( (void *)w.pSourceName );
+    free( (void *)w.pDisplayName );
+    free( (void *)w.pPrinterName );
+    free( w.pMonitorProfile );
+    free( w.pPrinterProfile );
+    free( w.pTargetProfile );
+    return ret;
+}
