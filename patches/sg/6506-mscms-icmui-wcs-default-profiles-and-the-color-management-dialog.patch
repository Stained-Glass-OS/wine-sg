+    {
+        SetLastError( res );
+        return FALSE;
+    }
+    res = RegSetValueExW( key, L"DefaultRenderingIntent", 0, REG_DWORD, (const BYTE *)&intent, sizeof(intent) );
+    RegCloseKey( key );
+    if (res) SetLastError( res );
+    return !res;
+}
