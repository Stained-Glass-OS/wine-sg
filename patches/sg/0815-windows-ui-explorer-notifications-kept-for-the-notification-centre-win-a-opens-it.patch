 /* Modifies an existing icon record */
+/* Stained Glass OS: a balloon a program shows from its notification-area
+ * icon is kept in the user's notification history too, as Windows 10 keeps
+ * it in its action centre (windows.ui records toasts the same way): sg-shell's
+ * notification centre (sg-notify) lists the newest 50. */
+static void sg_record_balloon( const struct icon *icon )
+{
+    static const WCHAR key_name[] = L"Software\\Stained Glass\\Notifications\\History";
+    WCHAR name[16], app[MAX_PATH] = {0};
+    DWORD next = 0, size = sizeof(next), proto = 0, pid = 0;
+    ULONGLONG now;
+    FILETIME ft;
+    HKEY key, item;
+    HWND centre;
+
+#ifdef SG_MUTANT_NO_NOTIFICATION_HISTORY
+    return;
+#endif
+    if (!icon->info_text[0] && !icon->info_title[0]) return;
+    /* the program: its icon's tooltip, or its file's name */
+    if (icon->tiptext[0]) lstrcpynW( app, icon->tiptext, ARRAY_SIZE(app) );
+    else if (GetWindowThreadProcessId( icon->owner, &pid ) && pid)
+    {
+        HANDLE process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid );
+        DWORD len = ARRAY_SIZE(app);
+        if (process && QueryFullProcessImageNameW( process, 0, app, &len ))
+        {
+            WCHAR *base = wcsrchr( app, '\\' ), *dot;
+            if (base) memmove( app, base + 1, (wcslen( base + 1 ) + 1) * sizeof(WCHAR) );
+            if ((dot = wcsrchr( app, '.' ))) *dot = 0;
+        }
+        if (process) CloseHandle( process );
+    }
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, key_name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL )) return;
+    RegQueryValueExW( key, L"Next", NULL, NULL, (BYTE *)&next, &size );
+    swprintf( name, ARRAY_SIZE(name), L"%08u", next );
+    if (!RegCreateKeyExW( key, name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &item, NULL ))
+    {
+        GetSystemTimeAsFileTime( &ft );
+        now = (ULONGLONG)ft.dwHighDateTime << 32 | ft.dwLowDateTime;
+        RegSetValueExW( item, L"App", 0, REG_SZ, (const BYTE *)app, (wcslen( app ) + 1) * sizeof(WCHAR) );
+        RegSetValueExW( item, L"Title", 0, REG_SZ, (const BYTE *)icon->info_title, (wcslen( icon->info_title ) + 1) * sizeof(WCHAR) );
+        RegSetValueExW( item, L"Body", 0, REG_SZ, (const BYTE *)icon->info_text, (wcslen( icon->info_text ) + 1) * sizeof(WCHAR) );
+        RegSetValueExW( item, L"Protocol", 0, REG_DWORD, (const BYTE *)&proto, sizeof(proto) );
+        RegSetValueExW( item, L"Time", 0, REG_QWORD, (const BYTE *)&now, sizeof(now) );
+        RegCloseKey( item );
+        if (next >= 50)
+        {
+            swprintf( name, ARRAY_SIZE(name), L"%08u", next - 50 );
+            RegDeleteKeyW( key, name );
+        }
+        next++;
+        RegSetValueExW( key, L"Next", 0, REG_DWORD, (const BYTE *)&next, sizeof(next) );
+    }
+    RegCloseKey( key );
+    if ((centre = FindWindowW( L"SgNotifyTray", NULL )))
+        PostMessageW( centre, RegisterWindowMessageW( L"SgNotificationsChanged" ), 0, 0 );
+}
+
 static BOOL modify_icon( struct icon *icon, NOTIFYICONDATAW *nid )
 {
     TRACE( "id=0x%x, hwnd=%p\n", nid->uID, nid->hWnd );
@@ -1086,6 +1144,7 @@
         if (icon->info_icon) DestroyIcon( icon->info_icon );
         icon->info_icon = CopyIcon( nid->hBalloonIcon );
 
+        sg_record_balloon( icon );
         update_balloon( icon );
     }
     if (icon->state & NIS_HIDDEN) hide_icon( icon );
