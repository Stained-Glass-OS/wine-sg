From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui, explorer: notifications kept for the notification centre; Win+A opens it

Windows 10 keeps every notification in its action centre, opened by the
taskbar's notification button or Win+A: a toast that has gone, or one
sent there only (SuppressPopup), can be read later. Ours showed toasts
(0437) and balloons and kept nothing. Now every toast an application
shows (or sends only to the centre) and every balloon a program shows
from its notification-area icon (Shell_NotifyIcon NIF_INFO) is written to
the user's history -- HKCU\Software\Stained Glass\Notifications\History,
one key per notification (App, Title, Body, Launch, Protocol, Time), the
newest 50 -- and the centre (sg-shell's sg-notify), if running, is told.
Win+A runs sg-notify.exe /toggle through App Paths.

Test: test/toast-gate.sh (history), test/notifycentre-gate.sh with
test/notifycentre-probe.c (mutants SG_MUTANT_NO_NOTIFICATION_HISTORY,
SG_MUTANT_NO_WIN_A).
---
--- a/dlls/windows.ui/toast.c
+++ b/dlls/windows.ui/toast.c
@@ -1341,6 +1341,57 @@
     return doc;
 }
 
+/* Stained Glass OS: every toast shown -- and every one an application sends
+ * only to the notification centre (SuppressPopup) -- is kept in the user's
+ * history, where sg-shell's notification centre (sg-notify, the taskbar's
+ * bell and Win+A) lists it: HKCU\Software\Stained Glass\Notifications\
+ * History\<number>, the newest 50. */
+#define SG_HISTORY_KEY L"Software\\Stained Glass\\Notifications\\History"
+#define SG_HISTORY_MAX 50
+
+static void sg_record_notification( const WCHAR *app, const WCHAR *title, const WCHAR *body, const WCHAR *launch,
+                             BOOL protocol )
+{
+    WCHAR name[16];
+    DWORD next = 0, size = sizeof(next), proto = protocol;
+    ULONGLONG now;
+    FILETIME ft;
+    HKEY key, item;
+    HWND centre;
+
+#ifdef SG_MUTANT_NO_NOTIFICATION_HISTORY
+    return;
+#endif
+    if ((!title || !*title) && (!body || !*body)) return;
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, SG_HISTORY_KEY, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL )) return;
+    RegQueryValueExW( key, L"Next", NULL, NULL, (BYTE *)&next, &size );
+    swprintf( name, ARRAY_SIZE(name), L"%08u", next );
+    if (!RegCreateKeyExW( key, name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &item, NULL ))
+    {
+        GetSystemTimeAsFileTime( &ft );
+        now = (ULONGLONG)ft.dwHighDateTime << 32 | ft.dwLowDateTime;
+        if (app) RegSetValueExW( item, L"App", 0, REG_SZ, (const BYTE *)app, (wcslen( app ) + 1) * sizeof(WCHAR) );
+        if (title) RegSetValueExW( item, L"Title", 0, REG_SZ, (const BYTE *)title, (wcslen( title ) + 1) * sizeof(WCHAR) );
+        if (body) RegSetValueExW( item, L"Body", 0, REG_SZ, (const BYTE *)body, (wcslen( body ) + 1) * sizeof(WCHAR) );
+        if (launch) RegSetValueExW( item, L"Launch", 0, REG_SZ, (const BYTE *)launch, (wcslen( launch ) + 1) * sizeof(WCHAR) );
+        RegSetValueExW( item, L"Protocol", 0, REG_DWORD, (const BYTE *)&proto, sizeof(proto) );
+        RegSetValueExW( item, L"Time", 0, REG_QWORD, (const BYTE *)&now, sizeof(now) );
+        RegCloseKey( item );
+        if (next >= SG_HISTORY_MAX)
+        {
+            /* the oldest beyond the newest 50 */
+            swprintf( name, ARRAY_SIZE(name), L"%08u", next - SG_HISTORY_MAX );
+            RegDeleteKeyW( key, name );
+        }
+        next++;
+        RegSetValueExW( key, L"Next", 0, REG_DWORD, (const BYTE *)&next, sizeof(next) );
+    }
+    RegCloseKey( key );
+    /* the centre, if it runs, says how many are new */
+    if ((centre = FindWindowW( L"SgNotifyTray", NULL )))
+        PostMessageW( centre, RegisterWindowMessageW( L"SgNotificationsChanged" ), 0, 0 );
+}
+
 static struct toast_view *create_view( struct toast *toast, const WCHAR *aumid )
 {
     IXMLDOMDocument *doc;
@@ -1607,13 +1658,18 @@
         close_matching( &match );
     }
 
-    if (toast->suppress_popup) return S_OK;
-    if (!start_toast_thread()) return E_FAIL;
     if (!(view = create_view( toast, impl->aumid )))
     {
         raise_event( toast, TOAST_FAILED, NULL, 0, E_INVALIDARG );
         return S_OK;
     }
+    sg_record_notification( view->app_name, view->title, view->body, view->launch, view->launch_protocol );
+    if (toast->suppress_popup || !start_toast_thread())
+    {
+        BOOL failed = !toast->suppress_popup;
+        free_view( view );
+        return failed ? E_FAIL : S_OK;
+    }
     if (!PostThreadMessageW( ui_thread_id, WM_TOAST_SHOW, 0, (LPARAM)view ))
     {
         free_view( view );
