+/* Stained Glass OS: a child window of another process than the surface's
+ * window paints itself straight into the X window (its process has no part
+ * in the surface): Chromium's GPU process into its "Intermediate D3D Window"
+ * (DirectComposition, drawn with GDI), a plugin or embedded program's
+ * window. The surface's process never paints it, so its area is left out of
+ * the surface as a swap chain's is -- flushed over it, the surface wiped what
+ * the other process drew, for good when that one draws only on change. WPF
+ * hosts WebView2 in a WS_EX_TRANSPARENT child, which its own drawing is not
+ * clipped by (DevToys 2: the page black, or the desktop under its Mica, as
+ * soon as WPF drew after Chromium's last frame). On Windows the compositor
+ * keeps such content above its parents' drawing. */
+static int is_foreign_window( const struct window *win, const struct process *owner )
+{
+#ifdef SG_MUTANT_FOREIGN_CHILD_IN_SURFACE
+    return 0;
+#endif
+    return owner && win->thread && win->thread->process != owner;
+}
+
+static int has_foreign_descendant( const struct window *parent, const struct process *owner )
+{
+    const struct window *ptr;
+
+    if (!owner) return 0;
+    LIST_FOR_EACH_ENTRY( ptr, &parent->children, struct window, entry )
+    {
+        if (!is_shown( ptr )) continue;
+        if (is_foreign_window( ptr, owner ) || has_foreign_descendant( ptr, owner )) return 1;
+    }
+    return 0;
+}
