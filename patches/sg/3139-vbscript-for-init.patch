From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 01:38:23 -0700
Subject: [PATCH] vbscript: For loop with failing expressions under On Error
 Resume Next

Native evaluates the from, to and step expressions first and assigns the loop
variable only after all of them succeeded (a FIXME in the compiler). When one
fails and the error is resumed, the body still runs once with the variable
untouched, and Next raises error 92 "For loop not initialized" (resumed past
the loop).

New OP_forinit assigns the variable from the evaluated from value; the catch of
the for statement now jumps through OP_forbad, which marks the loop state as
not initialized, and OP_incc checks that mark. The three todo_wine checks in
error.vbs are now real checks.

diff --git a/dlls/vbscript/compile.c b/dlls/vbscript/compile.c
index b9ff403..20db8c6 100644
--- a/dlls/vbscript/compile.c
+++ b/dlls/vbscript/compile.c
@@ -868,7 +868,7 @@ static HRESULT compile_foreach_statement(compile_ctx_t *ctx, foreach_statement_t
 static HRESULT compile_forto_statement(compile_ctx_t *ctx, forto_statement_t *stat)
 {
     statement_ctx_t loop_ctx = {2};
-    unsigned step_instr, instr;
+    unsigned step_instr, instr, err_label, body_label;
     BSTR identifier;
     HRESULT hres;
 
@@ -882,13 +882,6 @@ static HRESULT compile_forto_statement(compile_ctx_t *ctx, forto_statement_t *st
     if(!push_instr(ctx, OP_numval))
         return E_OUTOFMEMORY;
 
-    /* FIXME: Assign should happen after both expressions evaluation. */
-    instr = push_instr(ctx, OP_assign_ident);
-    if(!instr)
-        return E_OUTOFMEMORY;
-    instr_ptr(ctx, instr)->arg1.bstr = identifier;
-    instr_ptr(ctx, instr)->arg2.uint = 0;
-
     hres = compile_expression(ctx, stat->to_expr);
     if(FAILED(hres))
         return hres;
@@ -909,6 +902,12 @@ static HRESULT compile_forto_statement(compile_ctx_t *ctx, forto_statement_t *st
             return hres;
     }
 
+    /* The variable is assigned once all three expressions were evaluated. */
+    instr = push_instr(ctx, OP_forinit);
+    if(!instr)
+        return E_OUTOFMEMORY;
+    instr_ptr(ctx, instr)->arg1.bstr = identifier;
+
     loop_ctx.for_end_label = alloc_label(ctx);
     if(!loop_ctx.for_end_label)
         return E_OUTOFMEMORY;
@@ -919,8 +918,21 @@ static HRESULT compile_forto_statement(compile_ctx_t *ctx, forto_statement_t *st
     instr_ptr(ctx, step_instr)->arg2.bstr = identifier;
     instr_ptr(ctx, step_instr)->arg1.uint = loop_ctx.for_end_label;
 
-    if(!emit_catch(ctx, 2))
+    /* An error before the loop is set up (resumed by On Error Resume Next) still runs the
+     * body once, with the loop state marked as not initialized. */
+    err_label = alloc_label(ctx);
+    body_label = alloc_label(ctx);
+    if(!err_label || !body_label)
+        return E_OUTOFMEMORY;
+    if(!emit_catch_jmp(ctx, 2, err_label))
+        return E_OUTOFMEMORY;
+    hres = push_instr_addr(ctx, OP_jmp, body_label);
+    if(FAILED(hres))
+        return hres;
+    label_set_addr(ctx, err_label);
+    if(!push_instr(ctx, OP_forbad))
         return E_OUTOFMEMORY;
+    label_set_addr(ctx, body_label);
 
     hres = compile_statement(ctx, &loop_ctx, stat->body);
     if(FAILED(hres))
diff --git a/dlls/vbscript/interp.c b/dlls/vbscript/interp.c
index 5eb740c..2c8e286 100644
--- a/dlls/vbscript/interp.c
+++ b/dlls/vbscript/interp.c
@@ -2457,6 +2457,41 @@ static HRESULT interp_neg(exec_ctx_t *ctx)
     return stack_push(ctx, &v);
 }
 
+/* Stack on entry: from, to, step. Assigns the loop variable and removes from. */
+static HRESULT interp_forinit(exec_ctx_t *ctx)
+{
+    const BSTR ident = ctx->instr->arg1.bstr;
+    VARIANT from = *stack_top(ctx, 2);
+    DISPPARAMS dp;
+    HRESULT hres;
+
+    TRACE("%s\n", debugstr_w(ident));
+
+    /* from goes on top for the assignment, to and step move down */
+    *stack_top(ctx, 2) = *stack_top(ctx, 1);
+    *stack_top(ctx, 1) = *stack_top(ctx, 0);
+    *stack_top(ctx, 0) = from;
+
+    vbstack_to_dp(ctx, 0, TRUE, &dp);
+    hres = assign_ident(ctx, ident, DISPATCH_PROPERTYPUT, &dp);
+    stack_popn(ctx, 1);
+    return hres;
+}
+
+/* Reached through the catch of a for statement whose expressions failed. */
+static HRESULT interp_forbad(exec_ctx_t *ctx)
+{
+    unsigned i;
+
+    TRACE("\n");
+
+    for(i = 0; i < 2; i++) {
+        VariantClear(stack_top(ctx, i));
+        V_VT(stack_top(ctx, i)) = VT_EMPTY;
+    }
+    return S_OK;
+}
+
 static HRESULT interp_incc(exec_ctx_t *ctx)
 {
     const BSTR ident = ctx->instr->arg1.bstr;
@@ -2466,6 +2501,12 @@ static HRESULT interp_incc(exec_ctx_t *ctx)
 
     TRACE("\n");
 
+    /* the loop was never set up: an error before the first iteration was resumed */
+#ifndef SG_MUTANT_VB_NOFORINIT
+    if(V_VT(stack_top(ctx, 0)) == VT_EMPTY)
+        return MAKE_VBSERROR(VBSE_FOR_LOOP_NOT_INITIALIZED);
+#endif
+
     hres = lookup_identifier(ctx, ident, VBDISP_LET, &ref);
     if(FAILED(hres))
         return hres;
diff --git a/dlls/vbscript/tests/error.vbs b/dlls/vbscript/tests/error.vbs
index 8092843..7e7264d 100644
--- a/dlls/vbscript/tests/error.vbs
+++ b/dlls/vbscript/tests/error.vbs
@@ -209,19 +209,19 @@ sub testThrow
     next
     call ok(y = 1, "y = " & y)
     call ok(x = 6, "x = " & x)
-    call todo_wine_ok(Err.Number = VB_E_FORLOOPNOTINITIALIZED, "Err.Number = " & Err.Number)
+    call ok(Err.Number = VB_E_FORLOOPNOTINITIALIZED, "Err.Number = " & Err.Number)
 
     Err.clear()
     y = 0
     x = 6
     for x = 100 to throwInt(E_TESTERROR)
         call ok(Err.Number = E_TESTERROR, "Err.Number = " & Err.Number)
-        call todo_wine_ok(x = 6, "x = " & x)
+        call ok(x = 6, "x = " & x)
         y = y+1
     next
     call ok(y = 1, "y = " & y)
-    call todo_wine_ok(x = 6, "x = " & x)
-    call todo_wine_ok(Err.Number = VB_E_FORLOOPNOTINITIALIZED, "Err.Number = " & Err.Number)
+    call ok(x = 6, "x = " & x)
+    call ok(Err.Number = VB_E_FORLOOPNOTINITIALIZED, "Err.Number = " & Err.Number)
 
     select case throwInt(E_TESTERROR)
     case true
diff --git a/dlls/vbscript/vbscript.h b/dlls/vbscript/vbscript.h
index 5b8dd95..90c9b5f 100644
--- a/dlls/vbscript/vbscript.h
+++ b/dlls/vbscript/vbscript.h
@@ -264,6 +264,8 @@ typedef enum {
     X(ident,          1, ARG_BSTR,    0)          \
     X(idiv,           1, 0,           0)          \
     X(imp,            1, 0,           0)          \
+    X(forbad,         1, 0,           0)          \
+    X(forinit,        1, ARG_BSTR,    0)          \
     X(incc,           1, ARG_BSTR,    0)          \
     X(int,            1, ARG_INT,     0)          \
     X(is,             1, 0,           0)          \
diff --git a/dlls/vbscript/vbscript.rc b/dlls/vbscript/vbscript.rc
index 1dc496a..805686d 100644
--- a/dlls/vbscript/vbscript.rc
+++ b/dlls/vbscript/vbscript.rc
@@ -41,6 +41,7 @@ STRINGTABLE
     VBSE_PATH_FILE_ACCESS              "Path/File access error"
     VBSE_PATH_NOT_FOUND                "Path not found"
     VBSE_OBJECT_VARIABLE_NOT_SET       "Object variable not set"
+    VBSE_FOR_LOOP_NOT_INITIALIZED      "For loop not initialized"
     VBSE_ILLEGAL_NULL_USE              "Invalid use of Null"
     VBSE_CANT_CREATE_TMP_FILE          "Can't create necessary temporary file"
     VBSE_CANT_CREATE_OBJECT            "ActiveX component can't create object"
diff --git a/dlls/vbscript/vbscript_defs.h b/dlls/vbscript/vbscript_defs.h
index 061a6da..3feba1d 100644
--- a/dlls/vbscript/vbscript_defs.h
+++ b/dlls/vbscript/vbscript_defs.h
@@ -252,6 +252,7 @@
 #define VBSE_PATH_FILE_ACCESS              75
 #define VBSE_PATH_NOT_FOUND                76
 #define VBSE_OBJECT_VARIABLE_NOT_SET       91
+#define VBSE_FOR_LOOP_NOT_INITIALIZED      92
 #define VBSE_ILLEGAL_NULL_USE              94
 #define VBSE_CANT_CREATE_TMP_FILE         322
 #define VBSE_CANT_CREATE_OBJECT           429
