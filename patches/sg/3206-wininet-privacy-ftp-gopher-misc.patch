+/* Gopher locators are menu items in the form of the gopher protocol (RFC 1436):
+ *
+ *   <type character><display string> TAB <selector> TAB <host> TAB <port> [TAB '+']
+ *
+ * which is also what MAX_GOPHER_LOCATOR_LENGTH in wininet.h is built from. The locator is
+ * an opaque token for applications. */
+static const struct { char ch; DWORD type; } gopher_types[] =
+{
+    { '0', GOPHER_TYPE_TEXT_FILE },
+    { '1', GOPHER_TYPE_DIRECTORY },
+    { '2', GOPHER_TYPE_CSO },
+    { '3', GOPHER_TYPE_ERROR },
