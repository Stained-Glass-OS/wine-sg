 BOOL WINAPI CreateMD5SSOHash( PWSTR pszChallengeInfo, PWSTR pwszRealm, PWSTR pwszTarget,
                               PBYTE pbHexHash )
 {
-    FIXME("(%s, %s, %s, %p) stub\n", debugstr_w(pszChallengeInfo), debugstr_w(pwszRealm),
+    static const char hex[] = "0123456789abcdef";
+    const WCHAR *target = pwszTarget ? pwszTarget : pwszRealm ? pwszRealm : L"Passport.Net\\*";
+    CREDENTIALW *cred = NULL;
+    HCRYPTPROV prov = 0;
+    HCRYPTHASH hash = 0;
+    BYTE digest[16];
+    DWORD len = sizeof(digest), i;
+    char *challenge = NULL, *password = NULL;
+    BOOL ret = FALSE;
+    int clen, plen;
+
+    TRACE("(%s, %s, %s, %p)\n", debugstr_w(pszChallengeInfo), debugstr_w(pwszRealm),
           debugstr_w(pwszTarget), pbHexHash);
-    return FALSE;
+
+    if (!pszChallengeInfo || !pbHexHash)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    /* The Passport password lives in the credential store; the target name
+     * convention used here is an assumption (the documentation does not give one). */
+    if (!CredReadW( target, CRED_TYPE_GENERIC, 0, &cred )) return FALSE;
+
+    /* the credential blob is a UTF-16 password, converted to multi-byte like the challenge */
+    plen = WideCharToMultiByte( CP_ACP, 0, (const WCHAR *)cred->CredentialBlob,
+                                cred->CredentialBlobSize / sizeof(WCHAR), NULL, 0, NULL, NULL );
+    clen = WideCharToMultiByte( CP_ACP, 0, pszChallengeInfo, -1, NULL, 0, NULL, NULL );
+    if (!(password = malloc( plen + 1 )) || !(challenge = malloc( clen )))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        goto done;
+    }
+    WideCharToMultiByte( CP_ACP, 0, (const WCHAR *)cred->CredentialBlob,
+                         cred->CredentialBlobSize / sizeof(WCHAR), password, plen, NULL, NULL );
+    WideCharToMultiByte( CP_ACP, 0, pszChallengeInfo, -1, challenge, clen, NULL, NULL );
+    clen--;  /* without the terminator */
+
+    if (!CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT )) goto done;
+    if (!CryptCreateHash( prov, CALG_MD5, 0, 0, &hash )) goto done;
+#ifdef SG_MUTANT_WININET_MD5ORDER
+    if (!CryptHashData( hash, (BYTE *)password, plen, 0 ) ||
+        !CryptHashData( hash, (BYTE *)challenge, clen, 0 ) ||
+#else
+    if (!CryptHashData( hash, (BYTE *)challenge, clen, 0 ) ||
+        !CryptHashData( hash, (BYTE *)password, plen, 0 ) ||
+#endif
+        !CryptGetHashParam( hash, HP_HASHVAL, digest, &len, 0 )) goto done;
+
+    for (i = 0; i < sizeof(digest); i++)
+    {
+        pbHexHash[i * 2]     = hex[digest[i] >> 4];
+        pbHexHash[i * 2 + 1] = hex[digest[i] & 15];
+    }
+    pbHexHash[32] = 0;
+    ret = TRUE;
+
+done:
+    if (hash) CryptDestroyHash( hash );
+    if (prov) CryptReleaseContext( prov, 0 );
+    if (password) { SecureZeroMemory( password, plen ); free( password ); }
+    free( challenge );
+    if (cred) CredFree( cred );
+    return ret;
 }
 
