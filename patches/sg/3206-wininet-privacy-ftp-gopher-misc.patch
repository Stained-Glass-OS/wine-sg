From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 22:29:26 -0700
Subject: [PATCH] wininet: privacy prefs, dial/connect, options, FTP
 size/proxy/EPLF, HTTP seeking, gopher locators (3206)

Privacy zone preferences are stored per zone and cookie type; settings
changes re-read the proxy configuration; INTERNET_OPTION_SUPPRESS_BEHAVIOR
suppresses cookie persistence; INTERNET_OPTION_DIAGNOSTIC_SOCKET_INFO
reports the socket; InternetSetFilePointer supports FILE_END and 64-bit
positions; FtpGetFileSize, TIS FTP proxies with the bypass list and EPLF
listings are implemented; gopher locators can be built and parsed;
CACHE_ENTRY_SYNCTIME_FC read the wrong member.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/wininet/cookie.c b/dlls/wininet/cookie.c
index 3f8baba..a716197 100644
--- a/dlls/wininet/cookie.c
+++ b/dlls/wininet/cookie.c
@@ -391,6 +391,32 @@ static BOOL load_persistent_cookie(substr_t domain, substr_t path)
     return TRUE;
 }
 
+/* process-wide INTERNET_OPTION_SUPPRESS_BEHAVIOR state */
+static BOOL suppress_cookie_policy, suppress_cookie_persist;
+
+void set_cookie_suppression(DWORD behavior)
+{
+    EnterCriticalSection(&cookie_cs);
+    switch(behavior) {
+    case INTERNET_SUPPRESS_RESET_ALL:
+        suppress_cookie_policy = suppress_cookie_persist = FALSE;
+        break;
+    case INTERNET_SUPPRESS_COOKIE_POLICY:
+        suppress_cookie_policy = TRUE;
+        break;
+    case INTERNET_SUPPRESS_COOKIE_POLICY_RESET:
+        suppress_cookie_policy = FALSE;
+        break;
+    case INTERNET_SUPPRESS_COOKIE_PERSIST:
+        suppress_cookie_persist = TRUE;
+        break;
+    case INTERNET_SUPPRESS_COOKIE_PERSIST_RESET:
+        suppress_cookie_persist = FALSE;
+        break;
+    }
+    LeaveCriticalSection(&cookie_cs);
+}
+
 static BOOL save_persistent_cookie(cookie_container_t *container)
 {
     WCHAR cookie_file[MAX_PATH];
@@ -1134,6 +1160,11 @@ DWORD set_cookie(substr_t domain, substr_t path, substr_t name, substr_t data, D
 
     if(!expiry.dwLowDateTime && !expiry.dwHighDateTime)
         cookie_flags |= INTERNET_COOKIE_IS_SESSION;
+#ifndef SG_MUTANT_WININET_PERSISTSUPPRESS
+    else if(suppress_cookie_persist)
+        /* INTERNET_SUPPRESS_COOKIE_PERSIST: keep the cookie, but never write it to disk */
+        cookie_flags |= INTERNET_COOKIE_IS_SESSION;
+#endif
     else
         update_persistent = TRUE;
 
