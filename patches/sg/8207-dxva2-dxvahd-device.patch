+/* As dxva2's progressive video processor does it: the device's StretchRect converts and scales each stream
+ * into the output (YUV to RGB where the device can), ColorFill draws the background. One input stream, no
+ * deinterlacing, filters or alpha: the capabilities say so, and the states are kept as set. */
+
+#define COBJMACROS
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include "windef.h"
+#include "winbase.h"
+#include "d3d9.h"
+#include "dxvahd.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dxva2);
+
+/* the states' data, as the DXVA-HD documentation lays them out */
+typedef struct { BOOL Enable; RECT TargetRect; } blt_target_rect;
+typedef struct { BOOL YCbCr; float Color[4]; } blt_background;   /* RGBA or YCbCrA */
+typedef struct { UINT bits; } colorspace;
+typedef struct { UINT Mode; UINT StreamNumber; } blt_alpha_fill;
+typedef struct { BOOL Enable; SIZE Size; } blt_constriction;
+typedef struct { D3DFORMAT Format; } stream_format;
+typedef struct { DXVAHD_FRAME_FORMAT FrameFormat; } stream_frame_format;
+typedef struct { BOOL RepeatFrame; UINT OutputRate; DXVAHD_RATIONAL CustomRate; } stream_output_rate;
+typedef struct { BOOL Enable; RECT Rect; } stream_rect;
+typedef struct { BOOL Enable; float Alpha; } stream_alpha;
+typedef struct { UINT Count; D3DCOLOR *pEntries; } stream_palette;
+typedef struct { BOOL Enable; float Lower; float Upper; } stream_luma_key;
+typedef struct { BOOL Enable; DXVAHD_RATIONAL Source; DXVAHD_RATIONAL Destination; } stream_aspect;
+typedef struct { BOOL Enable; INT Level; } stream_filter;
+
+#define DXVAHD_OUTPUT_RATE_NORMAL 0
+
+static const D3DFORMAT output_formats[] = { D3DFMT_X8R8G8B8, D3DFMT_A8R8G8B8 };
+static const D3DFORMAT input_formats[] =
+{
+    MAKEFOURCC('N','V','1','2'), MAKEFOURCC('Y','U','Y','2'), MAKEFOURCC('Y','V','1','2'), D3DFMT_X8R8G8B8,
+    D3DFMT_A8R8G8B8,
+};
+
+/* {7f8a3c1e-5b2d-4e6a-9f10-8c3d2b1a0e57}: the one video processor */
+static const GUID dxvahd_processor_guid = {0x7f8a3c1e, 0x5b2d, 0x4e6a, {0x9f, 0x10, 0x8c, 0x3d, 0x2b, 0x1a, 0x0e, 0x57}};
+
+struct dxvahd_device
+{
+    IDXVAHD_Device IDXVAHD_Device_iface;
+    LONG refcount;
+    IDirect3DDevice9Ex *d3d;
+    DXVAHD_CONTENT_DESC desc;
+};
+
+struct dxvahd_processor
+{
+    IDXVAHD_VideoProcessor IDXVAHD_VideoProcessor_iface;
+    LONG refcount;
+    struct dxvahd_device *device;
+    blt_target_rect target;
+    blt_background background;
+    colorspace out_colorspace;
+    blt_alpha_fill alpha_fill;
+    blt_constriction constriction;
+    /* stream 0 */
+    stream_format format;
+    stream_frame_format frame_format;
+    colorspace in_colorspace;
+    stream_output_rate output_rate;
+    stream_rect source, destination;
+    stream_alpha alpha;
+    stream_palette palette;
+    stream_luma_key luma_key;
+    stream_aspect aspect;
+    stream_filter filters[7];
+};
+
+static inline struct dxvahd_device *impl_from_IDXVAHD_Device(IDXVAHD_Device *iface)
+{
+    return CONTAINING_RECORD(iface, struct dxvahd_device, IDXVAHD_Device_iface);
+}
+
+static inline struct dxvahd_processor *impl_from_IDXVAHD_VideoProcessor(IDXVAHD_VideoProcessor *iface)
+{
+    return CONTAINING_RECORD(iface, struct dxvahd_processor, IDXVAHD_VideoProcessor_iface);
+}
+
+/* IDXVAHD_VideoProcessor */
+static HRESULT WINAPI processor_QueryInterface(IDXVAHD_VideoProcessor *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IDXVAHD_VideoProcessor) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        IDXVAHD_VideoProcessor_AddRef(iface);
+        return S_OK;
+    }
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI processor_AddRef(IDXVAHD_VideoProcessor *iface)
+{
+    return InterlockedIncrement(&impl_from_IDXVAHD_VideoProcessor(iface)->refcount);
+}
+
+static ULONG WINAPI processor_Release(IDXVAHD_VideoProcessor *iface)
+{
+    struct dxvahd_processor *processor = impl_from_IDXVAHD_VideoProcessor(iface);
+    ULONG refcount = InterlockedDecrement(&processor->refcount);
+
+    if (!refcount)
+    {
+        IDXVAHD_Device_Release(&processor->device->IDXVAHD_Device_iface);
+        free(processor->palette.pEntries);
+        free(processor);
+    }
+    return refcount;
+}
+
+static HRESULT blt_state(struct dxvahd_processor *processor, DXVAHD_BLT_STATE state, void **data, UINT *size)
+{
+    switch (state)
+    {
+    case DXVAHD_BLT_STATE_TARGET_RECT: *data = &processor->target; *size = sizeof(processor->target); return S_OK;
+    case DXVAHD_BLT_STATE_BACKGROUND_COLOR: *data = &processor->background; *size = sizeof(processor->background); return S_OK;
+    case DXVAHD_BLT_STATE_OUTPUT_COLOR_SPACE: *data = &processor->out_colorspace; *size = sizeof(processor->out_colorspace); return S_OK;
+    case DXVAHD_BLT_STATE_ALPHA_FILL: *data = &processor->alpha_fill; *size = sizeof(processor->alpha_fill); return S_OK;
+    case DXVAHD_BLT_STATE_CONSTRICTION: *data = &processor->constriction; *size = sizeof(processor->constriction); return S_OK;
+    default:
+        WARN("Unknown blt state %u.\n", state);
+        return E_INVALIDARG;
+    }
+}
+
+static HRESULT WINAPI processor_SetVideoProcessBltState(IDXVAHD_VideoProcessor *iface, DXVAHD_BLT_STATE state,
+        UINT size, const void *data)
+{
+    struct dxvahd_processor *processor = impl_from_IDXVAHD_VideoProcessor(iface);
+    void *field;
+    UINT field_size;
+    HRESULT hr;
+
+    TRACE("%p, %u, %u, %p.\n", iface, state, size, data);
+
+    if (!data || FAILED(hr = blt_state(processor, state, &field, &field_size))) return E_INVALIDARG;
+    if (size != field_size) return E_INVALIDARG;
+    if (state == DXVAHD_BLT_STATE_ALPHA_FILL && ((const blt_alpha_fill *)data)->StreamNumber > 0) return E_INVALIDARG;
+    memcpy(field, data, size);
+    return S_OK;
+}
+
+static HRESULT WINAPI processor_GetVideoProcessBltState(IDXVAHD_VideoProcessor *iface, DXVAHD_BLT_STATE state,
+        UINT size, void *data)
+{
+    struct dxvahd_processor *processor = impl_from_IDXVAHD_VideoProcessor(iface);
+    void *field;
+    UINT field_size;
+    HRESULT hr;
+
+    TRACE("%p, %u, %u, %p.\n", iface, state, size, data);
+
+    if (!data || FAILED(hr = blt_state(processor, state, &field, &field_size))) return E_INVALIDARG;
+    if (size != field_size) return E_INVALIDARG;
+    memcpy(data, field, size);
+    return S_OK;
+}
+
+static HRESULT stream_state(struct dxvahd_processor *processor, DXVAHD_STREAM_STATE state, void **data, UINT *size)
+{
+    switch (state)
+    {
+    case DXVAHD_STREAM_STATE_D3DFORMAT: *data = &processor->format; *size = sizeof(processor->format); return S_OK;
+    case DXVAHD_STREAM_STATE_FRAME_FORMAT: *data = &processor->frame_format; *size = sizeof(processor->frame_format); return S_OK;
+    case DXVAHD_STREAM_STATE_INPUT_COLOR_SPACE: *data = &processor->in_colorspace; *size = sizeof(processor->in_colorspace); return S_OK;
+    case DXVAHD_STREAM_STATE_OUTPUT_RATE: *data = &processor->output_rate; *size = sizeof(processor->output_rate); return S_OK;
+    case DXVAHD_STREAM_STATE_SOURCE_RECT: *data = &processor->source; *size = sizeof(processor->source); return S_OK;
+    case DXVAHD_STREAM_STATE_DESTINATION_RECT: *data = &processor->destination; *size = sizeof(processor->destination); return S_OK;
+    case DXVAHD_STREAM_STATE_ALPHA: *data = &processor->alpha; *size = sizeof(processor->alpha); return S_OK;
+    case DXVAHD_STREAM_STATE_PALETTE: *data = &processor->palette; *size = sizeof(processor->palette); return S_OK;
+    case DXVAHD_STREAM_STATE_LUMA_KEY: *data = &processor->luma_key; *size = sizeof(processor->luma_key); return S_OK;
+    case DXVAHD_STREAM_STATE_ASPECT_RATIO: *data = &processor->aspect; *size = sizeof(processor->aspect); return S_OK;
+    default:
+        if (state >= DXVAHD_STREAM_STATE_FILTER_BRIGHTNESS && state <= DXVAHD_STREAM_STATE_FILTER_ANAMORPHIC_SCALING)
+        {
+            *data = &processor->filters[state - DXVAHD_STREAM_STATE_FILTER_BRIGHTNESS];
+            *size = sizeof(processor->filters[0]);
+            return S_OK;
+        }
+        WARN("Unknown stream state %u.\n", state);
+        return E_INVALIDARG;
+    }
+}
+
+static HRESULT WINAPI processor_SetVideoProcessStreamState(IDXVAHD_VideoProcessor *iface, UINT stream_idx,
+        DXVAHD_STREAM_STATE state, UINT size, const void *data)
+{
+    struct dxvahd_processor *processor = impl_from_IDXVAHD_VideoProcessor(iface);
+    void *field;
+    UINT field_size;
+    HRESULT hr;
+
+    TRACE("%p, %u, %u, %u, %p.\n", iface, stream_idx, state, size, data);
+
+    if (stream_idx > 0 || !data || FAILED(hr = stream_state(processor, state, &field, &field_size))) return E_INVALIDARG;
+    if (size != field_size) return E_INVALIDARG;
+    if (state == DXVAHD_STREAM_STATE_PALETTE)
+    {
+        const stream_palette *in = data;
+        D3DCOLOR *entries = NULL;
+
+        if (in->Count && (!in->pEntries || !(entries = malloc(in->Count * sizeof(*entries))))) return E_INVALIDARG;
+        if (in->Count) memcpy(entries, in->pEntries, in->Count * sizeof(*entries));
+        free(processor->palette.pEntries);
+        processor->palette.Count = in->Count;
+        processor->palette.pEntries = entries;
+        return S_OK;
+    }
+    memcpy(field, data, size);
+    return S_OK;
+}
+
+static HRESULT WINAPI processor_GetVideoProcessStreamState(IDXVAHD_VideoProcessor *iface, UINT stream_idx,
+        DXVAHD_STREAM_STATE state, UINT size, void *data)
+{
+    struct dxvahd_processor *processor = impl_from_IDXVAHD_VideoProcessor(iface);
+    void *field;
+    UINT field_size;
+    HRESULT hr;
+
+    TRACE("%p, %u, %u, %u, %p.\n", iface, stream_idx, state, size, data);
+
+    if (stream_idx > 0 || !data || FAILED(hr = stream_state(processor, state, &field, &field_size))) return E_INVALIDARG;
+    if (size != field_size) return E_INVALIDARG;
+    memcpy(data, field, size);
+    return S_OK;
+}
+
+static BYTE to_byte(float v)
+{
+    if (v <= 0.0f) return 0;
+    if (v >= 1.0f) return 255;
+    return (BYTE)(v * 255.0f + 0.5f);
+}
+
+/* the background as the output's RGB: YCbCr (studio range, BT.601) converted */
+static D3DCOLOR background_color(const blt_background *bg)
+{
+    float r = bg->Color[0], g = bg->Color[1], b = bg->Color[2];
+
+    if (bg->YCbCr)
+    {
+        float y = (bg->Color[0] - 16.0f / 255.0f) * 255.0f / 219.0f;
+        float cb = bg->Color[1] - 0.5f, cr = bg->Color[2] - 0.5f;
+
+        r = y + 1.596f * cr;
+        g = y - 0.813f * cr - 0.391f * cb;
+        b = y + 2.018f * cb;
+    }
+    return D3DCOLOR_ARGB(to_byte(bg->Color[3]), to_byte(r), to_byte(g), to_byte(b));
+}
+
+static BOOL intersect(RECT *dst, const RECT *a, const RECT *b)
+{
+    dst->left = max(a->left, b->left);
+    dst->top = max(a->top, b->top);
+    dst->right = min(a->right, b->right);
+    dst->bottom = min(a->bottom, b->bottom);
+    return dst->left < dst->right && dst->top < dst->bottom;
+}
+
+static HRESULT WINAPI processor_VideoProcessBltHD(IDXVAHD_VideoProcessor *iface, IDirect3DSurface9 *surface,
+        UINT frame_idx, UINT stream_count, const DXVAHD_STREAM_DATA *streams)
+{
+    struct dxvahd_processor *processor = impl_from_IDXVAHD_VideoProcessor(iface);
+    IDirect3DDevice9Ex *d3d = processor->device->d3d;
+    D3DSURFACE_DESC out_desc, in_desc;
+    RECT target, src, dst;
+    unsigned int i;
+    HRESULT hr;
+
+    TRACE("%p, %p, %u, %u, %p.\n", iface, surface, frame_idx, stream_count, streams);
+
+    if (!surface || (stream_count && !streams) || stream_count > 1) return E_INVALIDARG;
+    if (FAILED(hr = IDirect3DSurface9_GetDesc(surface, &out_desc))) return hr;
+    SetRect(&target, 0, 0, out_desc.Width, out_desc.Height);
+    if (processor->target.Enable && !intersect(&target, &target, &processor->target.TargetRect)) return S_OK;
+
+#ifndef SG_MUTANT_DXVAHD_NO_BACKGROUND
+    IDirect3DDevice9Ex_ColorFill(d3d, surface, &target, background_color(&processor->background));
+#endif
+    for (i = 0; i < stream_count; i++)
+    {
+        if (!streams[i].Enable || !streams[i].pInputSurface) continue;
+        if (FAILED(IDirect3DSurface9_GetDesc(streams[i].pInputSurface, &in_desc))) continue;
+        if (processor->source.Enable) src = processor->source.Rect;
+        else SetRect(&src, 0, 0, in_desc.Width, in_desc.Height);
+        if (processor->destination.Enable) dst = processor->destination.Rect;
+        else dst = target;
+#ifdef SG_MUTANT_DXVAHD_IGNORE_DEST
+        dst = target;
+#endif
+        if (!intersect(&dst, &dst, &target)) continue;
+        if (FAILED(hr = IDirect3DDevice9Ex_StretchRect(d3d, streams[i].pInputSurface, &src, surface, &dst,
+                                                       D3DTEXF_LINEAR)))
+            WARN("Failed to process stream %u, hr %#lx.\n", i, hr);
+    }
+    return S_OK;
+}
+
+static const IDXVAHD_VideoProcessorVtbl processor_vtbl =
+{
+    processor_QueryInterface,
+    processor_AddRef,
+    processor_Release,
+    processor_SetVideoProcessBltState,
+    processor_GetVideoProcessBltState,
+    processor_SetVideoProcessStreamState,
+    processor_GetVideoProcessStreamState,
+    processor_VideoProcessBltHD,
+};
+
+/* IDXVAHD_Device */
+static HRESULT WINAPI device_QueryInterface(IDXVAHD_Device *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IDXVAHD_Device) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        IDXVAHD_Device_AddRef(iface);
+        return S_OK;
+    }
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI device_AddRef(IDXVAHD_Device *iface)
+{
+    return InterlockedIncrement(&impl_from_IDXVAHD_Device(iface)->refcount);
+}
+
+static ULONG WINAPI device_Release(IDXVAHD_Device *iface)
+{
+    struct dxvahd_device *device = impl_from_IDXVAHD_Device(iface);
+    ULONG refcount = InterlockedDecrement(&device->refcount);
+
+    if (!refcount)
+    {
+        IDirect3DDevice9Ex_Release(device->d3d);
+        free(device);
+    }
+    return refcount;
+}
+
+static BOOL format_in(D3DFORMAT format, const D3DFORMAT *list, unsigned int count)
+{
+    unsigned int i;
+    for (i = 0; i < count; i++) if (list[i] == format) return TRUE;
+    return FALSE;
+}
+
+static HRESULT WINAPI device_CreateVideoSurface(IDXVAHD_Device *iface, UINT width, UINT height, D3DFORMAT format,
+        D3DPOOL pool, DWORD usage, DXVAHD_SURFACE_TYPE type, UINT count, IDirect3DSurface9 **surfaces,
+        HANDLE *shared_handle)
+{
+    struct dxvahd_device *device = impl_from_IDXVAHD_Device(iface);
+    unsigned int i;
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %u, %u, %#x, %u, %#lx, %u, %u, %p, %p.\n", iface, width, height, format, pool, usage, type, count,
+          surfaces, shared_handle);
+
+    if (!surfaces || !count || !width || !height) return E_INVALIDARG;
+    if (type == DXVAHD_SURFACE_TYPE_VIDEO_OUTPUT)
+    {
+        if (!format_in(format, output_formats, ARRAY_SIZE(output_formats))) return E_INVALIDARG;
+    }
+    else if (type == DXVAHD_SURFACE_TYPE_VIDEO_INPUT)
+    {
+        if (!format_in(format, input_formats, ARRAY_SIZE(input_formats))) return E_INVALIDARG;
+    }
+    else return E_INVALIDARG;
+
+    for (i = 0; i < count; i++)
+    {
+        if (type == DXVAHD_SURFACE_TYPE_VIDEO_OUTPUT)
+            hr = IDirect3DDevice9Ex_CreateRenderTarget(device->d3d, width, height, format, D3DMULTISAMPLE_NONE, 0,
+                                                       FALSE, &surfaces[i], i ? NULL : shared_handle);
+        else
+            hr = IDirect3DDevice9Ex_CreateOffscreenPlainSurface(device->d3d, width, height, format, pool,
+                                                                &surfaces[i], i ? NULL : shared_handle);
+        if (FAILED(hr))
+        {
+            WARN("Failed to create surface %u, hr %#lx.\n", i, hr);
+            while (i--)
+            {
+                IDirect3DSurface9_Release(surfaces[i]);
+                surfaces[i] = NULL;
+            }
+            return hr;
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI device_GetVideoProcessorDeviceCaps(IDXVAHD_Device *iface, DXVAHD_VPDEVCAPS *caps)
+{
+    TRACE("%p, %p.\n", iface, caps);
+
+    if (!caps) return E_INVALIDARG;
+    memset(caps, 0, sizeof(*caps));
+    caps->DeviceType = DXVAHD_DEVICE_TYPE_HARDWARE;
+    caps->InputPool = D3DPOOL_DEFAULT;
+    caps->OutputFormatCount = ARRAY_SIZE(output_formats);
+    caps->InputFormatCount = ARRAY_SIZE(input_formats);
+    caps->VideoProcessorCount = 1;
+    caps->MaxInputStreams = 1;
+    caps->MaxStreamStates = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI device_GetVideoProcessorOutputFormats(IDXVAHD_Device *iface, UINT count, D3DFORMAT *formats)
+{
+    TRACE("%p, %u, %p.\n", iface, count, formats);
+
+    if (!formats || count != ARRAY_SIZE(output_formats)) return E_INVALIDARG;
+    memcpy(formats, output_formats, sizeof(output_formats));
+    return S_OK;
+}
+
+static HRESULT WINAPI device_GetVideoProcessorInputFormats(IDXVAHD_Device *iface, UINT count, D3DFORMAT *formats)
+{
+    TRACE("%p, %u, %p.\n", iface, count, formats);
+
+    if (!formats || count != ARRAY_SIZE(input_formats)) return E_INVALIDARG;
+    memcpy(formats, input_formats, sizeof(input_formats));
+    return S_OK;
+}
+
+static HRESULT WINAPI device_GetVideoProcessorCaps(IDXVAHD_Device *iface, UINT count, DXVAHD_VPCAPS *caps)
+{
+    TRACE("%p, %u, %p.\n", iface, count, caps);
+
+    if (!caps || count != 1) return E_INVALIDARG;
+    memset(caps, 0, sizeof(*caps));
+    caps->VPGuid = dxvahd_processor_guid;
+    return S_OK;
+}
+
+static HRESULT WINAPI device_GetVideoProcessorCustomRates(IDXVAHD_Device *iface, const GUID *guid, UINT count,
+        DXVAHD_CUSTOM_RATE_DATA *rates)
+{
+    TRACE("%p, %s, %u, %p.\n", iface, debugstr_guid(guid), count, rates);
+
+    /* no custom rates: none to give */
+    if (!guid || !IsEqualGUID(guid, &dxvahd_processor_guid) || count) return E_INVALIDARG;
+    return S_OK;
+}
+
+static HRESULT WINAPI device_GetVideoProcessorFilterRange(IDXVAHD_Device *iface, DXVAHD_FILTER filter,
+        DXVAHD_FILTER_RANGE_DATA *range)
+{
+    TRACE("%p, %u, %p.\n", iface, filter, range);
+
+    /* no filters (FilterCaps is 0) */
+    return E_INVALIDARG;
+}
+
+static HRESULT WINAPI device_CreateVideoProcessor(IDXVAHD_Device *iface, const GUID *guid,
+        IDXVAHD_VideoProcessor **out)
+{
+    struct dxvahd_device *device = impl_from_IDXVAHD_Device(iface);
+    struct dxvahd_processor *processor;
+
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(guid), out);
+
+    if (!guid || !out) return E_INVALIDARG;
+    *out = NULL;
+    if (!IsEqualGUID(guid, &dxvahd_processor_guid)) return E_INVALIDARG;
+    if (!(processor = calloc(1, sizeof(*processor)))) return E_OUTOFMEMORY;
+    processor->IDXVAHD_VideoProcessor_iface.lpVtbl = &processor_vtbl;
+    processor->refcount = 1;
+    processor->device = device;
+    IDXVAHD_Device_AddRef(iface);
+    /* the documented defaults: black background (opaque), progressive input, normal output rate, the
+     * stream's format the output's, its rectangles off (the whole input into the whole target) */
+    processor->background.Color[3] = 1.0f;
+    processor->alpha.Alpha = 1.0f;
+    processor->format.Format = D3DFMT_A8R8G8B8;
+    processor->frame_format.FrameFormat = DXVAHD_FRAME_FORMAT_PROGRESSIVE;
+    processor->output_rate.OutputRate = DXVAHD_OUTPUT_RATE_NORMAL;
+    processor->luma_key.Upper = 1.0f;
+    *out = &processor->IDXVAHD_VideoProcessor_iface;
+    return S_OK;
+}
+
+static const IDXVAHD_DeviceVtbl device_vtbl =
+{
+    device_QueryInterface,
+    device_AddRef,
+    device_Release,
+    device_CreateVideoSurface,
+    device_GetVideoProcessorDeviceCaps,
+    device_GetVideoProcessorOutputFormats,
+    device_GetVideoProcessorInputFormats,
+    device_GetVideoProcessorCaps,
+    device_GetVideoProcessorCustomRates,
+    device_GetVideoProcessorFilterRange,
+    device_CreateVideoProcessor,
+};
+
+HRESULT WINAPI DXVAHD_CreateDevice(IDirect3DDevice9Ex *d3d9_device, const DXVAHD_CONTENT_DESC *desc,
+        DXVAHD_DEVICE_USAGE usage, PDXVAHDSW_Plugin plugin, IDXVAHD_Device **out)
+{
+    struct dxvahd_device *device;
+
+    TRACE("d3d9_device %p, desc %p, usage %u, plugin %p, device %p.\n", d3d9_device, desc, usage, plugin, out);
+
+    if (!d3d9_device || !desc || !out) return E_INVALIDARG;
+    *out = NULL;
+    if (plugin) FIXME("Software plugin %p ignored: the device's own processing is used.\n", plugin);
+    if (usage > DXVAHD_DEVICE_USAGE_OPTIMAL_QUALITY) return E_INVALIDARG;
+#ifdef SG_MUTANT_DXVAHD_STUB
+    return E_NOTIMPL;
+#endif
+    if (!(device = calloc(1, sizeof(*device)))) return E_OUTOFMEMORY;
+    device->IDXVAHD_Device_iface.lpVtbl = &device_vtbl;
+    device->refcount = 1;
+    device->d3d = d3d9_device;
+    IDirect3DDevice9Ex_AddRef(d3d9_device);
+    device->desc = *desc;
+    *out = &device->IDXVAHD_Device_iface;
+    return S_OK;
+}
