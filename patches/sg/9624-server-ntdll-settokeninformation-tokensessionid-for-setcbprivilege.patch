From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, ntdll: SetTokenInformation(TokenSessionId), for SeTcbPrivilege only

A Windows service starts its per-session helper -- a remote-support tool's
desktop half: AnyDesk's backend, a VNC server's -- by duplicating its own
token, giving the copy the person's session with
SetTokenInformation(TokenSessionId) (the session WTSGetActiveConsoleSessionId
names), and passing it to CreateProcessAsUser: on Windows the helper is
SYSTEM, in the person's session. NtSetInformationToken(TokenSessionId) was a
stub that said yes to everyone and changed nothing, so the helper stayed in
SYSTEM's session, away from the person's desktop.

As on Windows now:

- Only a caller holding SeTcbPrivilege may set it: in a shared prefix
  SYSTEM's processes (root or the prefix's owner, as for WTSQueryUserToken,
  1708). Anyone else gets STATUS_PRIVILEGE_NOT_HELD and the token keeps its
  session -- an administrator's elevated program too (Windows gives an
  administrator no SeTcbPrivilege).
- The handle needs TOKEN_ADJUST_SESSIONID.
- The session must exist: SYSTEM's own, or one a user is logged on to;
  anything else is STATUS_INVALID_PARAMETER. 0, the services' session on
  Windows, is SYSTEM's session here.

The process CreateProcessAsUser starts takes its token's session already
(server/process.c), so the helper is then SYSTEM in the person's session.
Also a new request, get_session_uid, for 9625: whose a session is (the Unix
account; WTSQuerySessionInformation tells anyone the name).

Gate: test/tokensession-gate.sh (sgsystem, sgtest1, sgtest2 against one
machine wineserver). Mutant SG_MUTANT_TOKEN_SESSION_ANYONE.
---
--- a/server/protocol.def
+++ b/server/protocol.def
@@ -3912,6 +3912,22 @@
 @END
 
 
+/* Stained Glass OS (9624): the session of a token (SetTokenInformation(TokenSessionId)),
+ * for a caller holding SeTcbPrivilege only */
+@REQ(set_token_session)
+    obj_handle_t   handle;        /* handle to the token */
+    unsigned int   session_id;    /* the session */
+@END
+
+
+/* Stained Glass OS (9625): the Unix account of the user logged on to a session */
+@REQ(get_session_uid)
+    unsigned int   session_id;    /* the session */
+@REPLY
+    unsigned int   uid;           /* its user's Unix uid */
+@END
+
+
 /* Get detailed fixed-size information about a token */
 @REQ(get_token_info)
     obj_handle_t   handle;        /* handle to the object */
--- a/server/token.c
+++ b/server/token.c
@@ -3326,6 +3326,46 @@
     }
 }
 
+/* Stained Glass OS (9624): SetTokenInformation(TokenSessionId). A service
+ * that starts its helper in a person's session (a remote-support tool's,
+ * AnyDesk's backend, a VNC server's desktop half) duplicates its own token,
+ * gives the copy that session, and passes it to CreateProcessAsUser: the
+ * helper is SYSTEM, in the person's session. As on Windows only a caller
+ * holding SeTcbPrivilege may: in a shared prefix SYSTEM's processes (root or
+ * the prefix's owner), nobody else -- not an administrator's elevated token
+ * either (an administrator holds no SeTcbPrivilege on Windows). The session
+ * must exist: SYSTEM's own, or one a user is logged on to; 0, the services'
+ * session on Windows, is SYSTEM's here. The stub before this succeeded for
+ * anyone and changed nothing. */
+DECL_HANDLER(set_token_session)
+{
+    struct token *caller = current->token ? current->token : current->process->token;
+    unsigned int id = req->session_id;
+    struct token *token;
+    uid_t uid;
+
+#ifndef SG_MUTANT_TOKEN_SESSION_ANYONE
+    if (!caller || !token_find_privilege( caller, SeTcbPrivilege, FALSE ) ||
+        (sg_system_prefix && !sg_requester_is_admin()))
+    {
+        set_error( STATUS_PRIVILEGE_NOT_HELD );
+        return;
+    }
+#endif
+    if (!id) id = default_session_id;
+    if (id != default_session_id && (!sg_system_prefix || !sg_session_user( id, &uid )))
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    if ((token = (struct token *)get_handle_obj( current->process, req->handle, TOKEN_ADJUST_SESSIONID,
+                                                 &token_ops )))
+    {
+        token->session_id = id;
+        release_object( token );
+    }
+}
+
 /* Stained Glass OS (1709): LogonUser. The elevation broker (sg-session's
  * sg-brokerd) checks the account's password against PAM -- the password never
  * comes here -- and leaves a one-time ticket in a directory only the SYSTEM
--- a/server/process.c
+++ b/server/process.c
@@ -1023,6 +1023,21 @@
     return id;
 }
 
+/* Stained Glass OS (9625): whose a session is, as WTSQuerySessionInformation
+ * tells anyone (the name; here the Unix account): a process SYSTEM starts in
+ * a person's session (a service's helper) is shown on that person's screen. */
+DECL_HANDLER(get_session_uid)
+{
+    uid_t uid;
+
+    if (!sg_system_prefix || !sg_session_user( req->session_id, &uid ))
+    {
+        set_error( STATUS_NO_SUCH_LOGON_SESSION );
+        return;
+    }
+    reply->uid = uid;
+}
+
 /* the user a session (sg_session_for_uid) belongs to; 0 for one no user has
  * (SYSTEM's, the default session) */
 int sg_session_user( unsigned int id, uid_t *uid )
--- a/dlls/ntdll/unix/security.c
+++ b/dlls/ntdll/unix/security.c
@@ -766,8 +766,16 @@
             ret = STATUS_ACCESS_VIOLATION;
             break;
         }
-        FIXME("TokenSessionId stub!\n");
-        ret = STATUS_SUCCESS;
+        /* Stained Glass OS (9624): a token's session, for a caller holding
+         * SeTcbPrivilege (the server checks); a service gives its helper's
+         * token the person's session this way */
+        SERVER_START_REQ( set_token_session )
+        {
+            req->handle     = wine_server_obj_handle( token );
+            req->session_id = *(const DWORD *)info;
+            ret = wine_server_call( req );
+        }
+        SERVER_END_REQ;
         break;
 
     case TokenIntegrityLevel:
