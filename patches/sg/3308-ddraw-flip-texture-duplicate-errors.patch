From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 04:16:32 -0700
Subject: [PATCH] ddraw: flippable textures, DuplicateSurface refusals (3308)

CORE review: graphics.

Flippable textures: creating a surface with DDSCAPS_FLIP | DDSCAPS_TEXTURE
(a chain whose members are textures) failed with DDERR_INVALIDCAPS and a
FIXME, although Windows creates it (the Wine tests of ddraw1, 2, 4 and 7
have the case marked todo). Each member of a flip chain already has its
own wined3d texture, so the check is removed; the chain, the caps of its
members and Flip behave as for other flippable surfaces. The todo marks of
the four tests are removed (on 64-bit ddraw7 Windows answers E_NOINTERFACE
for textures, which that test keeps as todo).

DuplicateSurface: the documented refusals - no destination
(DDERR_INVALIDPARAMS), no source (DDERR_INVALIDOBJECT), a primary, 3-D or
implicitly created surface (back buffer, mipmap level: DDERR_CANTDUPLICATE),
a lost surface - and no crash for a NULL pointer through the older
interfaces. The duplicate still does not share the memory of the source.

Test: test/fastddraw-gate.sh (mutants SG_MUTANT_DD_FLIPTEX, SG_MUTANT_DUP_*).

diff --git a/dlls/ddraw/ddraw.c b/dlls/ddraw/ddraw.c
index 271dffd..62f9a6b 100644
--- a/dlls/ddraw/ddraw.c
+++ b/dlls/ddraw/ddraw.c
@@ -3716,8 +3716,31 @@ static HRESULT WINAPI ddraw7_DuplicateSurface(IDirectDraw7 *iface,
         IDirectDrawSurface7 *Src, IDirectDrawSurface7 **Dest)
 {
     struct ddraw_surface *src_surface = unsafe_impl_from_IDirectDrawSurface7(Src);
+    HRESULT hr;
+
+    TRACE("iface %p, src %p, dst %p.\n", iface, Src, Dest);
+
+    if (!Dest)
+        return DDERR_INVALIDPARAMS;
+    *Dest = NULL;
+#ifndef SG_MUTANT_DUP_NOSRC
+    if (!src_surface)
+        return DDERR_INVALIDOBJECT;
+#endif
+
+    /* A primary surface, a 3-D surface or an implicitly created surface (a back
+     * buffer, a mipmap level, ...) cannot be duplicated. */
+#ifndef SG_MUTANT_DUP_CAPS
+    if (src_surface->surface_desc.ddsCaps.dwCaps & (DDSCAPS_PRIMARYSURFACE | DDSCAPS_3DDEVICE)
+            || !src_surface->is_root
+            || (src_surface->surface_desc.ddsCaps.dwCaps & DDSCAPS_BACKBUFFER))
+        return DDERR_CANTDUPLICATE;
+#endif
+
+    if (FAILED(hr = IDirectDrawSurface7_IsLost(Src)))
+        return hr;
 
-    FIXME("iface %p, src %p, dst %p partial stub!\n", iface, Src, Dest);
+    FIXME("The duplicate does not share the surface memory of the source yet.\n");
 
     /* For now, simply create a new, independent surface */
     return IDirectDraw7_CreateSurface(iface, &src_surface->surface_desc, Dest, NULL);
@@ -3734,6 +3757,11 @@ static HRESULT WINAPI ddraw4_DuplicateSurface(IDirectDraw4 *iface, IDirectDrawSu
 
     TRACE("iface %p, src %p, dst %p.\n", iface, src, dst);
 
+#ifndef SG_MUTANT_DUP_NULLDST
+    if (!dst)
+        return DDERR_INVALIDPARAMS;
+#endif
+
     hr = ddraw7_DuplicateSurface(&ddraw->IDirectDraw7_iface,
             src_impl ? &src_impl->IDirectDrawSurface7_iface : NULL, &dst7);
     if (FAILED(hr))
@@ -3760,10 +3788,16 @@ static HRESULT WINAPI ddraw2_DuplicateSurface(IDirectDraw2 *iface,
 
     TRACE("iface %p, src %p, dst %p.\n", iface, src, dst);
 
+    if (!dst)
+        return DDERR_INVALIDPARAMS;
+
     hr = ddraw7_DuplicateSurface(&ddraw->IDirectDraw7_iface,
             src_impl ? &src_impl->IDirectDrawSurface7_iface : NULL, &dst7);
     if (FAILED(hr))
+    {
+        *dst = NULL;
         return hr;
+    }
     dst_impl = impl_from_IDirectDrawSurface7(dst7);
     *dst = &dst_impl->IDirectDrawSurface_iface;
     IDirectDrawSurface_AddRef(*dst);
@@ -3783,10 +3817,16 @@ static HRESULT WINAPI ddraw1_DuplicateSurface(IDirectDraw *iface, IDirectDrawSur
 
     TRACE("iface %p, src %p, dst %p.\n", iface, src, dst);
 
+    if (!dst)
+        return DDERR_INVALIDPARAMS;
+
     hr = ddraw7_DuplicateSurface(&ddraw->IDirectDraw7_iface,
             src_impl ? &src_impl->IDirectDrawSurface7_iface : NULL, &dst7);
     if (FAILED(hr))
+    {
+        *dst = NULL;
         return hr;
+    }
     dst_impl = impl_from_IDirectDrawSurface7(dst7);
     *dst = &dst_impl->IDirectDrawSurface_iface;
     IDirectDrawSurface_AddRef(*dst);
diff --git a/dlls/ddraw/surface.c b/dlls/ddraw/surface.c
index a6c14c2..b89becb 100644
--- a/dlls/ddraw/surface.c
+++ b/dlls/ddraw/surface.c
@@ -6613,12 +6613,14 @@ HRESULT ddraw_surface_create(struct ddraw *ddraw, const DDSURFACEDESC2 *surface_
             return DDERR_INVALIDPARAMS;
         }
 
+
+#ifdef SG_MUTANT_DD_FLIPTEX
         if (desc->ddsCaps.dwCaps & DDSCAPS_TEXTURE)
         {
-            FIXME("Flippable textures not implemented.\n");
             free(texture);
             return DDERR_INVALIDCAPS;
         }
+#endif
     }
     else
     {
