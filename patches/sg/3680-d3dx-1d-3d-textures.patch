+/* Volume helpers: the 2D routines work on one slice, a volume is a stack of slices. */
+static struct img img_slice(const struct img *vol, unsigned int z)
+{
+    struct img s = *vol;
+
+    s.data = vol->data + (SIZE_T)z * vol->slice_pitch;
+    s.depth = 1;
+    return s;
+}
+
+static HRESULT bc_decode_volume(DXGI_FORMAT f, const struct img *src, struct img *out)
+{
+    unsigned int z;
+    HRESULT hr;
+
+    memset(out, 0, sizeof(*out));
+    out->width = src->width;
+    out->height = src->height;
+    out->depth = src->depth;
+    out->pitch = src->width * 4;
+    out->slice_pitch = out->pitch * src->height;
+    if (!(out->data = calloc(src->depth, out->slice_pitch)))
+        return E_OUTOFMEMORY;
+    for (z = 0; z < src->depth; ++z)
+    {
+        struct img in = img_slice(src, z), dec;
+
+        if (FAILED(hr = bc_decode_level(f, &in, &dec)))
+        {
+            free(out->data);
+            out->data = NULL;
+            return hr;
+        }
+        memcpy(out->data + (SIZE_T)z * out->slice_pitch, dec.data, out->slice_pitch);
+        free(dec.data);
+    }
+    return S_OK;
+}
+
+static HRESULT compress_volume(const struct img *rgba, DXGI_FORMAT format, struct img *out)
+{
+    unsigned int z;
+    HRESULT hr;
+
+    memset(out, 0, sizeof(*out));
+    for (z = 0; z < rgba->depth; ++z)
+    {
+        struct img in = img_slice(rgba, z), packed;
+
+        if (FAILED(hr = compress_level(&in, format, &packed)))
+        {
+            free(out->data);
+            memset(out, 0, sizeof(*out));
+            return hr;
+        }
+        if (!z)
+        {
+            BYTE *data = malloc((SIZE_T)packed.slice_pitch * rgba->depth);
+
+            if (!data)
+            {
+                free(packed.data);
+                return E_OUTOFMEMORY;
+            }
+            *out = packed;
+            out->data = data;
+            out->depth = rgba->depth;
+        }
+        memcpy(out->data + (SIZE_T)z * out->slice_pitch, packed.data, out->slice_pitch);
+        free(packed.data);
+    }
+    return S_OK;
+}
+
+/* Resamples a whole volume: each destination slice averages the source slices it covers
+ * (a single source slice with D3DX11_FILTER_POINT or when the depth is unchanged). */
+static void img_resample_volume(DXGI_FORMAT src_fmt, const struct img *src, DXGI_FORMAT dst_fmt, struct img *dst,
+        unsigned int filter)
+{
+    BOOL point = (filter != D3DX11_DEFAULT) && ((filter & 7) == D3DX11_FILTER_POINT || (filter & 7) == D3DX11_FILTER_NONE);
+    unsigned int dst_bpp = get_bpp_from_format(dst_fmt) / 8, z, i;
+
+    for (z = 0; z < dst->depth; ++z)
+    {
+        double z0 = (double)z * src->depth / dst->depth, z1 = (double)(z + 1) * src->depth / dst->depth;
+        unsigned int first = (unsigned int)floor(z0), last = (unsigned int)ceil(z1);
+
+#ifdef TEX_MUT_FIRST_SLICE
+        if (1)
+#else
+        if (point || src->depth == dst->depth || last - first <= 1)
+#endif
+        {
+            img_resample(src_fmt, src, point ? (unsigned int)((z0 + z1) * 0.5) : first, dst_fmt, dst, z, filter);
+        }
+        else
+        {
+            struct img tmp = *dst;
+            unsigned int n = dst->width * dst->height, k, x;
+            double total = 0.0;
+            float *acc;
