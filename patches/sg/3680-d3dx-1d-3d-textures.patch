+/* The description of a 1D, 2D or 3D texture in one shape. */
+static HRESULT get_tex_desc(ID3D10Resource *resource, struct tex_desc *d)
+{
+    HRESULT hr = E_INVALIDARG;
+    void *texture;
+
+    if (!resource)
+        return E_INVALIDARG;
+    memset(d, 0, sizeof(*d));
+    ID3D10Resource_GetType(resource, &d->dim);
+    switch (d->dim)
+    {
+        case D3D10_RESOURCE_DIMENSION_TEXTURE1D:
+        {
+            D3D10_TEXTURE1D_DESC desc;
+
+            if (FAILED(hr = ID3D10Resource_QueryInterface(resource, &IID_ID3D10Texture1D, &texture)))
+                return hr;
+            ID3D10Texture1D_GetDesc(texture, &desc);
+            ID3D10Texture1D_Release(texture);
+            d->width = desc.Width;
+            d->height = d->depth = 1;
+            d->mips = desc.MipLevels;
+            d->array = desc.ArraySize;
+            d->misc = desc.MiscFlags;
+            d->format = desc.Format;
+            return S_OK;
+        }
+        case D3D10_RESOURCE_DIMENSION_TEXTURE2D:
+        {
+            D3D10_TEXTURE2D_DESC desc;
+
+            if (FAILED(hr = ID3D10Resource_QueryInterface(resource, &IID_ID3D10Texture2D, &texture)))
+                return hr;
+            ID3D10Texture2D_GetDesc(texture, &desc);
+            ID3D10Texture2D_Release(texture);
+            d->width = desc.Width;
+            d->height = desc.Height;
+            d->depth = 1;
+            d->mips = desc.MipLevels;
+            d->array = desc.ArraySize;
+            d->misc = desc.MiscFlags;
+            d->format = desc.Format;
+            return S_OK;
+        }
+        case D3D10_RESOURCE_DIMENSION_TEXTURE3D:
+        {
+            D3D10_TEXTURE3D_DESC desc;
+
+            if (FAILED(hr = ID3D10Resource_QueryInterface(resource, &IID_ID3D10Texture3D, &texture)))
+                return hr;
+            ID3D10Texture3D_GetDesc(texture, &desc);
+            ID3D10Texture3D_Release(texture);
+            d->width = desc.Width;
+            d->height = desc.Height;
+            d->depth = desc.Depth;
+            d->mips = desc.MipLevels;
+            d->array = 1;
+            d->misc = desc.MiscFlags;
+            d->format = desc.Format;
+            return S_OK;
+        }
+        default:
+            return E_INVALIDARG;
+    }
