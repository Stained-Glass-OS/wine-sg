+/* Stained Glass OS: the search button -- a magnifier, or Windows 10's box */
+static void sg_draw_magnifier( HDC hdc, int cx, int cy, COLORREF color )
+{
+    HPEN pen = CreatePen( PS_SOLID, 2, color ), oldp = SelectObject( hdc, pen );
+    HBRUSH oldb = SelectObject( hdc, GetStockObject( NULL_BRUSH ));
+    Ellipse( hdc, cx - 7, cy - 7, cx + 4, cy + 4 );
+    MoveToEx( hdc, cx + 3, cy + 3, NULL );
+    LineTo( hdc, cx + 8, cy + 8 );
+    SelectObject( hdc, oldp );
+    SelectObject( hdc, oldb );
+    DeleteObject( pen );
+}
