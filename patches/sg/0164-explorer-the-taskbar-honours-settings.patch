+/* the bar where it belongs: its place, or tucked into the edge while hidden */
+static void sg_place_bar(void)
+{
+    RECT r = sg_bar_rect;
+    int t = sg_vertical() ? r.right - r.left : r.bottom - r.top;
+    HWND after = sg_bar.autohide ? HWND_TOPMOST : HWND_NOTOPMOST;
+    UINT flags = SWP_NOACTIVATE | SWP_SHOWWINDOW;
+
+    if (sg_hidden)
+    {
+        switch (sg_bar.edge)
+        {
+        case ABE_TOP:   OffsetRect( &r, 0, SG_HIDDEN_EDGE - t ); break;
+        case ABE_LEFT:  OffsetRect( &r, SG_HIDDEN_EDGE - t, 0 ); break;
+        case ABE_RIGHT: OffsetRect( &r, t - SG_HIDDEN_EDGE, 0 ); break;
+        default:        OffsetRect( &r, 0, t - SG_HIDDEN_EDGE ); break;
+        }
+    }
+    /* above everything while it hides itself, as Windows' is; back among the
+     * windows when that is turned off */
+    if (!sg_bar.autohide && !sg_topmost) flags |= SWP_NOZORDER;
+    sg_topmost = sg_bar.autohide;
+    SetWindowPos( tray_window, after, r.left, r.top, r.right - r.left, r.bottom - r.top, flags );
+    if (sg_hidden)
+    {
+        RedrawWindow( GetDesktopWindow(), &sg_bar_rect, 0, RDW_INVALIDATE | RDW_ERASE | RDW_UPDATENOW );
+        EnumWindows( sg_repaint_uncovered, (LPARAM)&sg_bar_rect );
+    }
+}
