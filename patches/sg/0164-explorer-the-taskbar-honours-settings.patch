+/* auto-hide: show the bar when the pointer reaches its edge, hide it when the
+ * pointer has been away for a while (not while Start or a menu is open) */
+static void sg_autohide_tick(void)
+{
+    GUITHREADINFO gui = { sizeof(gui) };
+    HWND start = FindWindowW( L"SgStartWindow", NULL );
+    POINT pt;
+    RECT edge = sg_bar_rect;
+
+    if (!sg_bar.autohide) return;
+    GetCursorPos( &pt );
+
+    if (sg_hidden)
+    {
+        switch (sg_bar.edge)
+        {
+        case ABE_TOP:   edge.bottom = edge.top + SG_HIDDEN_EDGE; break;
+        case ABE_LEFT:  edge.right = edge.left + SG_HIDDEN_EDGE; break;
+        case ABE_RIGHT: edge.left = edge.right - SG_HIDDEN_EDGE; break;
+        default:        edge.top = edge.bottom - SG_HIDDEN_EDGE; break;
+        }
+        if (PtInRect( &edge, pt ) || (start && IsWindowVisible( start )))
+        {
+            sg_hidden = FALSE;
+            sg_away = 0;
+            sg_place_bar();
+            sync_taskbar_buttons();
+        }
+        return;
+    }
+    GetGUIThreadInfo( GetCurrentThreadId(), &gui );
+    if (PtInRect( &sg_bar_rect, pt ) || (start && IsWindowVisible( start )) || (gui.flags & GUI_INMENUMODE))
+    {
+        sg_away = 0;
+        return;
+    }
+    if (++sg_away * SG_AUTOHIDE_TICK < SG_AUTOHIDE_DELAY) return;
+    sg_away = 0;
+    sg_hidden = TRUE;
+    sg_place_bar();
+}
