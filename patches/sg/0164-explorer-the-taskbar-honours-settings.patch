+/* Stained Glass OS: the strip of a button along the bar's outer edge */
+static RECT sg_edge_strip( const RECT *rect, int width )
+{
+    RECT r = *rect;
+    switch (sg_bar.edge)
+    {
+    case ABE_TOP:    r.bottom = r.top + width; break;
+    case ABE_LEFT:   r.right = r.left + width; break;
+    case ABE_RIGHT:  r.left = r.right - width; break;
+    default:         r.top = r.bottom - width; break;
+    }
+    return r;
+}
