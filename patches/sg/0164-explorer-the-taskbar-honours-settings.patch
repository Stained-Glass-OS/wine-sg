+static void sg_paint_search( const DRAWITEMSTRUCT *dis, const RECT *rect )
+{
+    COLORREF bg = SG_COL_BAR;
+
+    if (dis->itemState & ODS_SELECTED) bg = SG_COL_ACTIVE;
+    else if (dis->itemState & ODS_HOTLIGHT) bg = SG_COL_HOVER;
+    sg_fill( dis->hDC, rect, bg );
+    if (sg_bar.search == 2 && !sg_vertical())
+    {
+        RECT box = *rect, text;
+        NONCLIENTMETRICSW ncm;
+        HFONT font, old;
+
+        InflateRect( &box, -4, sg_bar.small ? -3 : -5 );
+        sg_fill( dis->hDC, &box, sg_pal == &sg_light_palette ? RGB(0xFF,0xFF,0xFF) : RGB(0xF3,0xF3,0xF3) );
+        sg_draw_magnifier( dis->hDC, box.left + 18, (box.top + box.bottom) / 2, RGB(0x33,0x33,0x33) );
+        ncm.cbSize = sizeof(ncm);
+        SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+        font = CreateFontIndirectW( &ncm.lfMenuFont );
+        old = SelectObject( dis->hDC, font );
+        SetBkMode( dis->hDC, TRANSPARENT );
+        SetTextColor( dis->hDC, RGB(0x6E,0x6E,0x6E) );
+        text = box;
+        text.left += 36;
+        DrawTextW( dis->hDC, L"Type here to search", -1, &text, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS );
+        SelectObject( dis->hDC, old );
+        DeleteObject( font );
+    }
+    else sg_draw_magnifier( dis->hDC, (rect->left + rect->right) / 2, (rect->top + rect->bottom) / 2, SG_COL_TEXT );
+}
