+/* what the bar uncovers when it hides: the desktop (whose surface is not
+ * repainted by itself, see 0069), then the windows over that part of it */
+static BOOL CALLBACK sg_repaint_uncovered( HWND hwnd, LPARAM lparam )
+{
+    const RECT *uncovered = (const RECT *)lparam;
+    RECT rc, dummy;
+
+    if (hwnd == tray_window || !IsWindowVisible( hwnd )) return TRUE;
+    GetWindowRect( hwnd, &rc );
+    if (IntersectRect( &dummy, &rc, uncovered ))
+        RedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+    return TRUE;
+}
