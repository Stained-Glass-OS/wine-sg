+/* Stained Glass OS: a combined button with several windows: choose one */
+static HWND sg_choose_in_group( struct taskbar_button *leader, HWND button )
+{
+    struct taskbar_button *win;
+    HMENU menu = CreatePopupMenu();
+    HWND list[64];
+    int n = 0, cmd;
+    RECT rc;
+
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+    {
+        WCHAR title[128];
+        if (!win->hwnd || !win->visible || win->group != leader || n >= ARRAY_SIZE(list)) continue;
+        if (!GetWindowTextW( win->hwnd, title, ARRAY_SIZE(title) )) lstrcpyW( title, L"(untitled)" );
+        list[n++] = win->hwnd;
+        AppendMenuW( menu, MF_STRING, n, title );
+    }
+    GetWindowRect( button, &rc );
+    cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_NONOTIFY |
+                          (sg_bar.edge == ABE_TOP ? TPM_TOPALIGN : TPM_BOTTOMALIGN),
+                          rc.left, sg_bar.edge == ABE_TOP ? rc.bottom : rc.top, 0, tray_window, NULL );
+    DestroyMenu( menu );
+    return cmd > 0 && cmd <= n ? list[cmd - 1] : NULL;
 }
 
