+/* the buttons follow windows being shown and hidden, renamed and brought
+ * forward -- not only created: a window is usually shown after the
+ * notification of its creation arrives */
+static void CALLBACK sg_window_event( HWINEVENTHOOK hook, DWORD event, HWND hwnd, LONG object,
+                                      LONG child, DWORD thread, DWORD time )
+{
+    if (!hwnd || object != OBJID_WINDOW) return;
+    if (event != EVENT_SYSTEM_FOREGROUND && GetAncestor( hwnd, GA_PARENT ) != GetDesktopWindow()) return;
+    SetTimer( tray_window, SG_SYNC_TIMER, 50, NULL );
+}
+
+static void sg_watch_windows(void)
+{
+    SetWinEventHook( EVENT_SYSTEM_FOREGROUND, EVENT_SYSTEM_FOREGROUND, NULL, sg_window_event, 0, 0,
+                     WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS );
+    SetWinEventHook( EVENT_OBJECT_SHOW, EVENT_OBJECT_HIDE, NULL, sg_window_event, 0, 0,
+                     WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS );
+    SetWinEventHook( EVENT_OBJECT_NAMECHANGE, EVENT_OBJECT_NAMECHANGE, NULL, sg_window_event, 0, 0,
+                     WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS );
+}
