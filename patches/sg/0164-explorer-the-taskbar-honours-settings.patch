+UINT taskbar_state( RECT *rect, UINT *edge )
+{
+    if (!enable_taskbar || !tray_window || IsRectEmpty( &sg_bar_rect )) return 0;   /* not placed yet */
+    if (rect) *rect = sg_bar_rect;
+    if (edge) *edge = sg_bar.edge;
+    return ABS_ALWAYSONTOP | (sg_bar.autohide ? ABS_AUTOHIDE : 0);
+}
