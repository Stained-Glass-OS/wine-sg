+    if (!enable_taskbar) return;
+    if (!RegCreateKeyExW( HKEY_CURRENT_USER, sg_taskbar_key, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL ))
+    {
+        RegSetValueExW( key, L"AutoHide", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+        RegCloseKey( key );
+    }
+    sg_bar.autohide = on;
+    do_show_systray();
+}
