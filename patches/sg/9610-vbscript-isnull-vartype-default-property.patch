From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] vbscript: IsNull, IsEmpty, IsDate and VarType test an object's default property (9610)

ASP pages and admin scripts test database columns with IsNull(rs("name")).
rs("name") is an ADO Field object; Windows' vbscript tests the value of its
default property (Value), so a NULL column is Null. Wine tested the object
itself: IsNull was always False, VarType always vbObject, and the Null branch
of every such script was never taken. The VBScript reference says it for
VarType: "If an object has a default property, VarType(object) returns the
type of its default property"; IsNull, IsEmpty and IsDate work the same way.
An object without a default property (a script class without a Default
member), or one whose default needs arguments (a Dictionary's Item), stays an
object and leaves no error behind; TypeName and IsObject are unchanged.
---
--- a/dlls/vbscript/global.c
+++ b/dlls/vbscript/global.c
@@ -937,8 +937,47 @@
     return return_string(res, ptr);
 }
 
+/* IsNull, IsEmpty, IsDate and VarType test what an object stands for: an object with a default
+ * property (an ADO Field, whose default is Value) is tested by the value of that property, the way
+ * Windows' vbscript does -- IsNull(rs("name")) is True for a NULL column. An object without one (a
+ * script class without a Default member, a Dictionary, whose default Item needs a key) stays an
+ * object. Returns TRUE with the value in *val (to be cleared) when the default was taken. */
+static BOOL take_default_value(BuiltinDisp *This, VARIANT *arg, VARIANT *val)
+{
+    VARIANT next;
+    unsigned depth;
+    HRESULT hres;
+
+#ifdef SG_MUTANT_VBS_NO_DEFAULT_VALUE
+    return FALSE;
+#endif
+    if(V_VT(arg) == (VT_BYREF | VT_VARIANT))
+        arg = V_VARIANTREF(arg);
+    if(V_VT(arg) != VT_DISPATCH || !V_DISPATCH(arg))
+        return FALSE;
+
+    V_VT(val) = VT_EMPTY;
+    /* a default property may hand back another object with a default of its own (a few levels) */
+    for(depth = 0; depth < 4; depth++) {
+        V_VT(&next) = VT_EMPTY;
+        hres = get_disp_value(This->ctx, depth ? V_DISPATCH(val) : V_DISPATCH(arg), &next);
+        if(FAILED(hres)) {
+            if(hres == SCRIPT_E_RECORDED)
+                clear_ei(&This->ctx->ei);
+            VariantClear(&next);
+            return depth > 0; /* *val holds the last object reached */
+        }
+        VariantClear(val);
+        *val = next;
+        if(V_VT(val) != VT_DISPATCH || !V_DISPATCH(val))
+            break;
+    }
+    return TRUE;
+}
+
 static HRESULT Global_VarType(BuiltinDisp *This, VARIANT *arg, unsigned args_cnt, VARIANT *res)
 {
+    VARIANT val;
     VARTYPE vt;
 
     TRACE("(%s)\n", debugstr_variant(arg));
@@ -947,7 +986,12 @@
 
     if(V_VT(arg) == (VT_BYREF | VT_VARIANT))
         arg = V_VARIANTREF(arg);
-    vt = V_VT(arg) & ~VT_BYREF;
+    if(take_default_value(This, arg, &val)) {
+        vt = V_VT(&val);
+        VariantClear(&val);
+    }else {
+        vt = V_VT(arg) & ~VT_BYREF;
+    }
     vt &= VT_TYPEMASK | VT_ARRAY;
 
     return return_short(res, vt);
@@ -955,26 +999,50 @@
 
 static HRESULT Global_IsDate(BuiltinDisp *This, VARIANT *arg, unsigned args_cnt, VARIANT *res)
 {
-    TRACE("%s\n", debugstr_variant(arg));
+    VARIANT val;
+    BOOL r;
 
-    return return_bool(res, V_VT(arg) == VT_DATE);
+    TRACE("(%s)\n", debugstr_variant(arg));
+
+    if(take_default_value(This, arg, &val)) {
+        r = V_VT(&val) == VT_DATE;
+        VariantClear(&val);
+    }else {
+        r = V_VT(arg) == VT_DATE;
+    }
+    return return_bool(res, r);
 }
 
 static HRESULT Global_IsEmpty(BuiltinDisp *This, VARIANT *arg, unsigned args_cnt, VARIANT *res)
 {
+    VARIANT val;
+    BOOL r;
+
     TRACE("(%s)\n", debugstr_variant(arg));
 
-    assert(args_cnt == 1);
-    return return_bool(res, V_VT(arg) == VT_EMPTY);
+    if(take_default_value(This, arg, &val)) {
+        r = V_VT(&val) == VT_EMPTY;
+        VariantClear(&val);
+    }else {
+        r = V_VT(arg) == VT_EMPTY;
+    }
+    return return_bool(res, r);
 }
 
 static HRESULT Global_IsNull(BuiltinDisp *This, VARIANT *arg, unsigned args_cnt, VARIANT *res)
 {
-    TRACE("(%s)\n", debugstr_variant(arg));
+    VARIANT val;
+    BOOL r;
 
-    assert(args_cnt == 1);
+    TRACE("(%s)\n", debugstr_variant(arg));
 
-    return return_bool(res, V_VT(arg) == VT_NULL);
+    if(take_default_value(This, arg, &val)) {
+        r = V_VT(&val) == VT_NULL;
+        VariantClear(&val);
+    }else {
+        r = V_VT(arg) == VT_NULL;
+    }
+    return return_bool(res, r);
 }
 
 static HRESULT Global_IsNumeric(BuiltinDisp *This, VARIANT *arg, unsigned args_cnt, VARIANT *res)
