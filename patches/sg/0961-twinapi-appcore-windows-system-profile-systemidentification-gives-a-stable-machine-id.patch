+ */
+
+/* The identifier is the same every time on one machine, for every program
+ * that asks (a desktop program has no package publisher to tell programs
+ * apart by), and different on every other machine: a SHA-256 hash of the
+ * machine's MachineGuid (HKLM\SOFTWARE\Microsoft\Cryptography, made once
+ * with the machine's Windows side) and what the identifier is for, the
+ * publisher's or a user's.  Remote-desktop and licensing programs (AnyDesk)
+ * use it to know the machine again after a restart. */
+
+#define WIDL_using_Windows_Storage_Streams
+#include "private.h"
+
+#include "winreg.h"
+#include "wincrypt.h"
+#include "sddl.h"
+#include "roapi.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+/* robuffer.h: an IBuffer's bytes */
+typedef struct IBufferByteAccess IBufferByteAccess;
+typedef struct IBufferByteAccessVtbl
+{
+    HRESULT (WINAPI *QueryInterface)( IBufferByteAccess *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( IBufferByteAccess *iface );
+    ULONG (WINAPI *Release)( IBufferByteAccess *iface );
+    HRESULT (WINAPI *Buffer)( IBufferByteAccess *iface, BYTE **value );
+} IBufferByteAccessVtbl;
+struct IBufferByteAccess { const IBufferByteAccessVtbl *lpVtbl; };
+static const GUID IID_IBufferByteAccess_sysid = { 0x905a0fef, 0xbc53, 0x11df, { 0x8c, 0x49, 0x00, 0x1e, 0x4f, 0xc6, 0x86, 0xda } };
+
+#define SYSTEM_ID_SIZE 32
+
+struct system_identification_info
+{
+    ISystemIdentificationInfo ISystemIdentificationInfo_iface;
+    LONG ref;
+    BYTE id[SYSTEM_ID_SIZE];
+};
+
+static inline struct system_identification_info *impl_from_ISystemIdentificationInfo( ISystemIdentificationInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct system_identification_info, ISystemIdentificationInfo_iface );
+}
+
+static HRESULT WINAPI info_QueryInterface( ISystemIdentificationInfo *iface, REFIID iid, void **out )
+{
+    struct system_identification_info *impl = impl_from_ISystemIdentificationInfo( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ISystemIdentificationInfo ))
+    {
+        ISystemIdentificationInfo_AddRef( (*out = &impl->ISystemIdentificationInfo_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI info_AddRef( ISystemIdentificationInfo *iface )
+{
+    struct system_identification_info *impl = impl_from_ISystemIdentificationInfo( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI info_Release( ISystemIdentificationInfo *iface )
+{
+    struct system_identification_info *impl = impl_from_ISystemIdentificationInfo( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI info_GetIids( ISystemIdentificationInfo *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI info_GetRuntimeClassName( ISystemIdentificationInfo *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_System_Profile_SystemIdentificationInfo;
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI info_GetTrustLevel( ISystemIdentificationInfo *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+/* a new Windows.Storage.Streams.Buffer holding the identifier */
+static HRESULT WINAPI info_get_Id( ISystemIdentificationInfo *iface, IBuffer **value )
+{
+    struct system_identification_info *impl = impl_from_ISystemIdentificationInfo( iface );
+    static const WCHAR *name = L"Windows.Storage.Streams.Buffer";
+    IBufferByteAccess *access;
+    IBufferFactory *factory;
+    HSTRING class_name;
+    IBuffer *buffer;
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+
+    if (FAILED(hr = WindowsCreateString( name, wcslen( name ), &class_name ))) return hr;
+    hr = RoGetActivationFactory( class_name, &IID_IBufferFactory, (void **)&factory );
+    WindowsDeleteString( class_name );
+    if (FAILED(hr)) return hr;
+
+    hr = IBufferFactory_Create( factory, SYSTEM_ID_SIZE, &buffer );
+    IBufferFactory_Release( factory );
+    if (FAILED(hr)) return hr;
+
+    if (SUCCEEDED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess_sysid, (void **)&access )))
+    {
+        if (SUCCEEDED(hr = access->lpVtbl->Buffer( access, &bytes )))
+        {
+            memcpy( bytes, impl->id, SYSTEM_ID_SIZE );
+            hr = IBuffer_put_Length( buffer, SYSTEM_ID_SIZE );
+        }
+        access->lpVtbl->Release( access );
+    }
+    if (FAILED(hr))
+    {
+        IBuffer_Release( buffer );
+        return hr;
+    }
+    *value = buffer;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_Source( ISystemIdentificationInfo *iface, SystemIdentificationSource *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    /* made from a value the machine keeps in its registry */
+    *value = SystemIdentificationSource_Registry;
+    return S_OK;
+}
+
+static const struct ISystemIdentificationInfoVtbl info_vtbl =
+{
+    info_QueryInterface,
+    info_AddRef,
+    info_Release,
+    /* IInspectable methods */
+    info_GetIids,
+    info_GetRuntimeClassName,
+    info_GetTrustLevel,
+    /* ISystemIdentificationInfo methods */
+    info_get_Id,
+    info_get_Source,
+};
+
+/* the machine's own GUID, made once with its Windows side */
+static HRESULT get_machine_guid( WCHAR *guid, DWORD size )
+{
+    DWORD type, len = size;
+    LSTATUS ret;
+    HKEY key;
+
+    ret = RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"SOFTWARE\\Microsoft\\Cryptography", 0,
+                         KEY_QUERY_VALUE | KEY_WOW64_64KEY, &key );
+    if (ret) return HRESULT_FROM_WIN32( ret );
+    ret = RegQueryValueExW( key, L"MachineGuid", NULL, &type, (BYTE *)guid, &len );
+    RegCloseKey( key );
+    if (ret) return HRESULT_FROM_WIN32( ret );
+    if (type != REG_SZ || len < 2 * sizeof(WCHAR)) return HRESULT_FROM_WIN32( ERROR_INVALID_DATA );
+    guid[size / sizeof(WCHAR) - 1] = 0;
+    return S_OK;
+}
+
+/* SHA-256 of "<machine guid>|<scope>" */
+static HRESULT make_system_id( const WCHAR *scope, ISystemIdentificationInfo **result )
+{
+    struct system_identification_info *impl;
+    HCRYPTPROV prov = 0;
+    HCRYPTHASH hash = 0;
+    WCHAR guid[64], *text;
+    DWORD len = SYSTEM_ID_SIZE;
+    HRESULT hr;
+    BOOL ok;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+
+    if (FAILED(hr = get_machine_guid( guid, sizeof(guid) )))
+    {
+        WARN( "no MachineGuid, hr %#lx.\n", hr );
+        return hr;
+    }
+    if (!(text = malloc( (wcslen( guid ) + wcslen( scope ) + 2) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    wcscpy( text, guid );
+    wcscat( text, L"|" );
+    wcscat( text, scope );
+
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        free( text );
+        return E_OUTOFMEMORY;
+    }
+    impl->ISystemIdentificationInfo_iface.lpVtbl = &info_vtbl;
+    impl->ref = 1;
+
+    ok = CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_AES, CRYPT_VERIFYCONTEXT ) &&
+         CryptCreateHash( prov, CALG_SHA_256, 0, 0, &hash ) &&
+         CryptHashData( hash, (BYTE *)text, wcslen( text ) * sizeof(WCHAR), 0 ) &&
+         CryptGetHashParam( hash, HP_HASHVAL, impl->id, &len, 0 );
+    hr = ok ? S_OK : HRESULT_FROM_WIN32( GetLastError() );
+    if (hash) CryptDestroyHash( hash );
+    if (prov) CryptReleaseContext( prov, 0 );
+    free( text );
+
+    if (FAILED(hr))
+    {
+        free( impl );
+        return hr;
+    }
+    *result = &impl->ISystemIdentificationInfo_iface;
+    return S_OK;
+}
+
+struct system_identification_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    ISystemIdentificationStatics ISystemIdentificationStatics_iface;
+    LONG ref;
+};
+
+static inline struct system_identification_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct system_identification_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct system_identification_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        IInspectable_AddRef( (*out = &impl->IActivationFactory_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ISystemIdentificationStatics ))
+    {
+        IInspectable_AddRef( (*out = &impl->ISystemIdentificationStatics_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    struct system_identification_statics *impl = impl_from_IActivationFactory( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    struct system_identification_statics *impl = impl_from_IActivationFactory( iface );
+    return InterlockedDecrement( &impl->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **out )
+{
+    FIXME( "iface %p, out %p stub!\n", iface, out );
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( statics, ISystemIdentificationStatics, struct system_identification_statics, IActivationFactory_iface );
+
+static HRESULT WINAPI statics_GetSystemIdForPublisher( ISystemIdentificationStatics *iface,
+                                                       ISystemIdentificationInfo **result )
+{
+    TRACE( "iface %p, result %p.\n", iface, result );
+    /* a desktop program has no package publisher: all of them share one */
+    return make_system_id( L"publisher:", result );
+}
+
+/* the user's SID (the calling user's: a Windows.System.User names no one
+ * else here), as a string */
+static HRESULT get_user_sid( WCHAR **sid )
+{
+    BYTE buffer[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE];
+    TOKEN_USER *user = (TOKEN_USER *)buffer;
+    HANDLE token;
+    DWORD len;
+    BOOL ok;
+
+    if (!OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token ) &&
+        !OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+        return HRESULT_FROM_WIN32( GetLastError() );
+    ok = GetTokenInformation( token, TokenUser, buffer, sizeof(buffer), &len ) &&
+         ConvertSidToStringSidW( user->User.Sid, sid );
+    CloseHandle( token );
+    return ok ? S_OK : HRESULT_FROM_WIN32( GetLastError() );
+}
+
+static HRESULT WINAPI statics_GetSystemIdForUser( ISystemIdentificationStatics *iface, __x_ABI_CWindows_CSystem_CIUser *user,
+                                                  ISystemIdentificationInfo **result )
+{
+    WCHAR *sid, *scope;
+    HRESULT hr;
+
+    TRACE( "iface %p, user %p, result %p.\n", iface, user, result );
+
+    if (FAILED(hr = get_user_sid( &sid ))) return hr;
+    if ((scope = malloc( (wcslen( sid ) + 6) * sizeof(WCHAR) )))
+    {
+        wcscpy( scope, L"user:" );
+        wcscat( scope, sid );
+        hr = make_system_id( scope, result );
+        free( scope );
+    }
+    else hr = E_OUTOFMEMORY;
+    LocalFree( sid );
+    return hr;
+}
+
+static const struct ISystemIdentificationStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface,
+    statics_AddRef,
+    statics_Release,
+    /* IInspectable methods */
+    statics_GetIids,
+    statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    /* ISystemIdentificationStatics methods */
+    statics_GetSystemIdForPublisher,
+    statics_GetSystemIdForUser,
+};
+
+static struct system_identification_statics system_identification_statics =
+{
+    {&factory_vtbl},
+    {&statics_vtbl},
+    1,
+};
+
+IActivationFactory *system_identification_factory = &system_identification_statics.IActivationFactory_iface;
