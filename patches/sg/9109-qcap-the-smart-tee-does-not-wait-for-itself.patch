From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] qcap: the Smart Tee passes capture samples on and drops preview frames, as Windows does (9109)

The Smart Tee copied every sample, for both pins, into a buffer of the source's own
allocator, waiting for one under the filter's lock. A source with one buffer (or
two, one held downstream) made its streaming thread wait for itself: nothing reached
the preview pin, and stopping the graph, which takes the same lock, hung for ever.
OpenCV's DirectShow capture (the capture graph builder puts a Smart Tee in for the
preview stream it renders) froze in VideoCapture.release() over
screen-capture-recorder. As on Windows, the capture pin passes the sample itself on
(its downstream filter was given the input's allocator, read only), and the preview
pin gets a copy in a buffer of an allocator of its own, negotiated downstream, only
when one is free: preview frames are dropped rather than holding capture up.
Nothing is waited for under the filter's lock.
---
--- a/dlls/qcap/smartteefilter.c
+++ b/dlls/qcap/smartteefilter.c
@@ -67,11 +67,34 @@
     return iface->state == State_Paused ? VFW_S_CANT_CUE : S_OK;
 }
 
+/* the preview pin's allocator is the tee's own (wine-sg 9109): it runs with the filter */
+static HRESULT smart_tee_init_stream(struct strmbase_filter *iface)
+{
+    SmartTeeFilter *filter = CONTAINING_RECORD(iface, SmartTeeFilter, filter);
+    HRESULT hr;
+
+    if (filter->preview.pin.peer && filter->preview.pAllocator
+            && FAILED(hr = IMemAllocator_Commit(filter->preview.pAllocator)))
+        ERR("Failed to commit the preview allocator, hr %#lx.\n", hr);
+    return S_OK;
+}
+
+static HRESULT smart_tee_cleanup_stream(struct strmbase_filter *iface)
+{
+    SmartTeeFilter *filter = CONTAINING_RECORD(iface, SmartTeeFilter, filter);
+
+    if (filter->preview.pin.peer && filter->preview.pAllocator)
+        IMemAllocator_Decommit(filter->preview.pAllocator);
+    return S_OK;
+}
+
 static const struct strmbase_filter_ops filter_ops =
 {
     .filter_get_pin = smart_tee_get_pin,
     .filter_destroy = smart_tee_destroy,
     .filter_wait_state = smart_tee_wait_state,
+    .filter_init_stream = smart_tee_init_stream,
+    .filter_cleanup_stream = smart_tee_cleanup_stream,
 };
 
 static HRESULT sink_query_accept(struct strmbase_pin *base, const AM_MEDIA_TYPE *pmt)
@@ -118,7 +141,7 @@
     return S_OK;
 }
 
-static HRESULT copy_sample(IMediaSample *inputSample, IMemAllocator *allocator, IMediaSample **pOutputSample)
+static HRESULT copy_sample(IMediaSample *inputSample, IMemAllocator *allocator, IMediaSample **pOutputSample, DWORD flags)
 {
     REFERENCE_TIME startTime, endTime;
     BOOL haveStartTime = TRUE, haveEndTime = TRUE;
@@ -138,7 +161,7 @@
         goto end;
 
     hr = IMemAllocator_GetBuffer(allocator, &outputSample,
-            haveStartTime ? &startTime : NULL, haveEndTime ? &endTime : NULL, 0);
+            haveStartTime ? &startTime : NULL, haveEndTime ? &endTime : NULL, flags);
     if (FAILED(hr)) goto end;
     if (IMediaSample_GetSize(outputSample) < IMediaSample_GetActualDataLength(inputSample)) {
         ERR("insufficient space in sample\n");
@@ -196,41 +219,70 @@
     return hr;
 }
 
+/* Stained Glass OS (wine-sg 9109): as Windows' Smart Tee does, the capture pin passes the sample on
+ * itself (the capture stream is the input stream; its downstream filter was given the input's
+ * allocator, read only), and the preview pin gets a copy in a buffer of its own allocator only
+ * when one is free: preview frames are dropped rather than holding capture up. Both copies came
+ * from the source's own allocator, waited for under the filter's lock: with a source of one or two
+ * buffers (OpenCV's capture graph over screen-capture-recorder) the streaming thread waited for
+ * itself, and stopping the graph -- which takes the same lock -- hung for ever. */
 static HRESULT WINAPI SmartTeeFilterInput_Receive(struct strmbase_sink *base, IMediaSample *inputSample)
 {
     SmartTeeFilter *This = impl_from_strmbase_pin(&base->pin);
-    IMediaSample *captureSample = NULL;
+    IMemInputPin *capture = NULL, *preview = NULL;
+    IMemAllocator *preview_allocator = NULL;
     IMediaSample *previewSample = NULL;
     HRESULT hrCapture = VFW_E_NOT_CONNECTED, hrPreview = VFW_E_NOT_CONNECTED;
 
     TRACE("(%p)->(%p)\n", This, inputSample);
 
-    /* Modifying the image coming out of one pin doesn't modify the image
-     * coming out of the other. MSDN claims the filter doesn't copy,
-     * but unless it somehow uses copy-on-write, I just don't see how
-     * that's possible. */
-
-    /* FIXME: we should ideally do each of these in a separate thread */
     EnterCriticalSection(&This->filter.filter_cs);
-    if (This->capture.pin.peer)
-        hrCapture = copy_sample(inputSample, This->capture.pAllocator, &captureSample);
+    if (This->capture.pin.peer && (capture = This->capture.pMemInputPin))
+        IMemInputPin_AddRef(capture);
+    if (This->preview.pin.peer && (preview = This->preview.pMemInputPin) && (preview_allocator = This->preview.pAllocator))
+    {
+        IMemInputPin_AddRef(preview);
+        IMemAllocator_AddRef(preview_allocator);
+    }
+    else preview = NULL;
     LeaveCriticalSection(&This->filter.filter_cs);
-    if (SUCCEEDED(hrCapture) && This->capture.pMemInputPin)
-        hrCapture = IMemInputPin_Receive(This->capture.pMemInputPin, captureSample);
-    if (captureSample)
-        IMediaSample_Release(captureSample);
 
-    EnterCriticalSection(&This->filter.filter_cs);
-    if (This->preview.pin.peer)
-        hrPreview = copy_sample(inputSample, This->preview.pAllocator, &previewSample);
-    LeaveCriticalSection(&This->filter.filter_cs);
-    /* No timestamps on preview stream: */
-    if (SUCCEEDED(hrPreview))
-        hrPreview = IMediaSample_SetTime(previewSample, NULL, NULL);
-    if (SUCCEEDED(hrPreview) && This->preview.pMemInputPin)
-        hrPreview = IMemInputPin_Receive(This->preview.pMemInputPin, previewSample);
-    if (previewSample)
-        IMediaSample_Release(previewSample);
+    if (capture)
+    {
+#ifdef SG_MUTANT_SMARTTEE_COPY
+        IMediaSample *captureSample = NULL;
+        if (SUCCEEDED(hrCapture = copy_sample(inputSample, This->sink.pAllocator, &captureSample, 0)))
+        {
+            hrCapture = IMemInputPin_Receive(capture, captureSample);
+            IMediaSample_Release(captureSample);
+        }
+#else
+        hrCapture = IMemInputPin_Receive(capture, inputSample);
+#endif
+        IMemInputPin_Release(capture);
+    }
+
+    if (preview)
+    {
+        hrPreview = copy_sample(inputSample, preview_allocator, &previewSample, AM_GBF_NOWAIT);
+        if (hrPreview == VFW_E_TIMEOUT)
+        {
+            TRACE("No free preview buffer; dropping the preview frame.\n");
+            hrPreview = S_OK;
+        }
+        else
+        {
+            /* No timestamps on preview stream: */
+            if (SUCCEEDED(hrPreview))
+                hrPreview = IMediaSample_SetTime(previewSample, NULL, NULL);
+            if (SUCCEEDED(hrPreview))
+                hrPreview = IMemInputPin_Receive(preview, previewSample);
+        }
+        if (previewSample)
+            IMediaSample_Release(previewSample);
+        IMemInputPin_Release(preview);
+        IMemAllocator_Release(preview_allocator);
+    }
 
     /* FIXME: how to merge the HRESULTs from the 2 pins? */
     if (SUCCEEDED(hrCapture))
@@ -322,14 +374,21 @@
     return smart_tee_source_query_accept(base, amt);
 }
 
-static HRESULT WINAPI SmartTeeFilterPreview_DecideAllocator(struct strmbase_source *base,
-        IMemInputPin *pPin, IMemAllocator **pAlloc)
+/* the preview pin's buffers are its own (wine-sg 9109): as many and as large as the input's */
+static HRESULT WINAPI SmartTeeFilterPreview_DecideBufferSize(struct strmbase_source *base,
+        IMemAllocator *allocator, ALLOCATOR_PROPERTIES *props)
 {
     SmartTeeFilter *This = impl_from_strmbase_pin(&base->pin);
-    TRACE("(%p, %p, %p)\n", This, pPin, pAlloc);
-    *pAlloc = This->sink.pAllocator;
-    IMemAllocator_AddRef(This->sink.pAllocator);
-    return IMemInputPin_NotifyAllocator(pPin, This->sink.pAllocator, TRUE);
+    ALLOCATOR_PROPERTIES input = {0}, actual;
+
+    TRACE("(%p, %p, %p)\n", This, allocator, props);
+
+    if (This->sink.pAllocator)
+        IMemAllocator_GetProperties(This->sink.pAllocator, &input);
+    if (!props->cbAlign) props->cbAlign = 1;
+    props->cbBuffer = max(props->cbBuffer, max(input.cbBuffer, This->sink.pin.mt.lSampleSize));
+    props->cBuffers = max(props->cBuffers, 2);
+    return IMemAllocator_SetProperties(allocator, props, &actual);
 }
 
 static const struct strmbase_source_ops preview_ops =
@@ -337,7 +396,8 @@
     .base.pin_query_accept = preview_query_accept,
     .base.pin_get_media_type = source_get_media_type,
     .pfnAttemptConnection = BaseOutputPinImpl_AttemptConnection,
-    .pfnDecideAllocator = SmartTeeFilterPreview_DecideAllocator,
+    .pfnDecideAllocator = BaseOutputPinImpl_DecideAllocator,
+    .pfnDecideBufferSize = SmartTeeFilterPreview_DecideBufferSize,
 };
 
 HRESULT smart_tee_create(IUnknown *outer, IUnknown **out)
