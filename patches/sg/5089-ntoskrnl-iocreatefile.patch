From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: IoCreateFile options.

IoCreateFileEx and IoCreateFile ignored their Options (and logged a FIXME on
every call). IO_OPEN_TARGET_DIRECTORY opens the file's parent directory;
IO_STOP_ON_SYMLINK on a symbolic link returns STATUS_STOPPED_ON_SYMLINK with
a REPARSE_DATA_BUFFER in IoStatus.Information for the caller to free, and
opens any other file as before. IO_IGNORE_SHARE_ACCESS_CHECK and
IO_FORCE_ACCESS_CHECK are accepted; they do not change what the file layer
checks.

Gate: test/ntoskrnl-iocreate-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -5584,6 +5584,27 @@
     return STATUS_SUCCESS;
 }
 
+#define SG_IO_OPEN_TARGET_DIRECTORY    0x0004
+#define SG_IO_STOP_ON_SYMLINK          0x0008
+
+/* the object attributes with the last component of the name cut off: the file's parent directory */
+static NTSTATUS parent_attributes( const OBJECT_ATTRIBUTES *attr, OBJECT_ATTRIBUTES *parent, UNICODE_STRING *name )
+{
+    USHORT len;
+
+    *parent = *attr;
+    if (!attr->ObjectName) return STATUS_OBJECT_NAME_INVALID;
+    *name = *attr->ObjectName;
+    len = name->Length / sizeof(WCHAR);
+    while (len && name->Buffer[len - 1] == '\\') len--;   /* a trailing separator belongs to the directory */
+    while (len && name->Buffer[len - 1] != '\\') len--;
+    if (!len) return STATUS_OBJECT_NAME_INVALID;
+    /* the separator goes with the name, but stays after a drive letter */
+    name->Length = (len > 1 && name->Buffer[len - 2] != ':' ? len - 1 : len) * sizeof(WCHAR);
+    parent->ObjectName = name;
+    return STATUS_SUCCESS;
+}
+
 /***********************************************************************
  *           IoCreateFileEx (NTOSKRNL.EXE.@)
  */
@@ -5592,9 +5613,68 @@
                               ULONG disposition, ULONG create_options, VOID *ea_buffer, ULONG ea_length,
                               CREATE_FILE_TYPE file_type, VOID *parameters, ULONG options, void *driverctx)
 {
-    FIXME(": semi-stub\n");
-    return NtCreateFile(handle, access, attr, io, alloc_size, attributes, sharing, disposition,
-                        create_options, ea_buffer, ea_length);
+    OBJECT_ATTRIBUTES parent_attr;
+    UNICODE_STRING parent_name;
+    NTSTATUS status;
+
+    TRACE( "handle %p, access %#lx, attr %p, options %#lx\n", handle, access, attr, options );
+
+    /* IO_FORCE_ACCESS_CHECK: the file's security descriptor is always consulted by the create in
+     * Wine, a kernel caller has no way to skip it. IO_IGNORE_SHARE_ACCESS_CHECK only spares the
+     * I/O manager's own check of the file object: "the file system might still perform these
+     * checks", and the share modes of other opens are checked in the file system layer (the
+     * server) as on a file system that does. IO_NO_PARAMETER_CHECKING needs nothing. */
+
+#ifdef SG_MUTANT_IOCREATE_NO_PARENT
+    if (0)
+#else
+    if (options & SG_IO_OPEN_TARGET_DIRECTORY)
+#endif
+    {
+        if ((status = parent_attributes( attr, &parent_attr, &parent_name ))) return status;
+        attr = &parent_attr;
+        create_options = (create_options & ~FILE_NON_DIRECTORY_FILE) | FILE_DIRECTORY_FILE;
+        disposition = FILE_OPEN;
+    }
+
+#ifdef SG_MUTANT_IOCREATE_NO_STOP
+    if (0)
+#else
+    if (options & SG_IO_STOP_ON_SYMLINK)
+#endif
+    {
+        /* open the file itself; when it is a link, stop and hand the reparse data back */
+        FILE_ATTRIBUTE_TAG_INFORMATION tag;
+        IO_STATUS_BLOCK info_io;
+        REPARSE_DATA_BUFFER *buffer;
+        HANDLE file;
+
+        status = NtCreateFile( &file, access | FILE_READ_ATTRIBUTES, attr, io, alloc_size, attributes, sharing,
+                               disposition, create_options | FILE_OPEN_REPARSE_POINT, ea_buffer, ea_length );
+        if (status) return status;
+        if (!NtQueryInformationFile( file, &info_io, &tag, sizeof(tag), FileAttributeTagInformation ) &&
+            (tag.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) && tag.ReparseTag == IO_REPARSE_TAG_SYMLINK &&
+            (buffer = ExAllocatePool( PagedPool, MAXIMUM_REPARSE_DATA_BUFFER_SIZE )))
+        {
+            status = NtFsControlFile( file, NULL, NULL, NULL, &info_io, FSCTL_GET_REPARSE_POINT, NULL, 0,
+                                      buffer, MAXIMUM_REPARSE_DATA_BUFFER_SIZE );
+            if (!status)
+            {
+                NtClose( file );
+                *handle = NULL;
+                io->Status = STATUS_STOPPED_ON_SYMLINK;
+                io->Information = (ULONG_PTR)buffer;
+                return STATUS_STOPPED_ON_SYMLINK;
+            }
+            ExFreePool( buffer );
+        }
+        /* not a link: open it as asked */
+        NtClose( file );
+        io->Information = 0;
+    }
+
+    return NtCreateFile( handle, access, attr, io, alloc_size, attributes, sharing, disposition,
+                         create_options, ea_buffer, ea_length );
 }
 
 /***********************************************************************
@@ -5605,7 +5685,6 @@
                               ULONG disposition, ULONG create_options, VOID *ea_buffer, ULONG ea_length,
                               CREATE_FILE_TYPE file_type, VOID *parameters, ULONG options )
 {
-    FIXME(": semi-stub\n");
     return IoCreateFileEx(handle, access, attr, io, alloc_size, attributes, sharing, disposition,
                           create_options, ea_buffer, ea_length, file_type, parameters, options, NULL);
 }
-- 
2.47.0
