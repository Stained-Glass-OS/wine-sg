From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] t2embed: TTEMBED_SUBSET embeds a subset font

TTEmbedFont, TTEmbedFontEx and TTEmbedFontFromFileA embedded the whole font even with TTEMBED_SUBSET. The requested characters are now looked up in the font's Windows cmap (format 12 UCS-4 before format 4 BMP for CHARSET_UNICODE; the code, then the F000 page, for CHARSET_SYMBOL; glyph indices as given for CHARSET_GLYPHIDX) and the font is subset by fontsub's CreateFontPackage (TTFCFP_SUBSET with a glyph list): those glyphs, their composite components and glyph 0 keep their outlines and indices, the others are emptied. The EOT's Flags say TTEMBED_SUBSET, so TTLoadEmbeddedFont reports TTLOAD_FONT_SUBSETTED. A font whose fsType forbids subsetting (bit 8) is embedded whole and the caller gets TTEMBED_SUBSETCANCEL in its status.
---
--- a/dlls/t2embed/main.c
+++ b/dlls/t2embed/main.c
@@ -26,6 +26,7 @@
 #include "wingdi.h"
 #include "winreg.h"
 #include "t2embapi.h"
+#include "fontsub.h"
 #include "wine/debug.h"
 
 #include "t2embed_private.h"
@@ -35,9 +36,11 @@
 /* Stained Glass OS: fonts embedded in documents, in the Embedded OpenType
  * structure (the EOT file format, W3C member submission 2008): a header naming
  * the font (OS/2 and name table data, embedding permissions) followed by the
- * font's data, optionally XOR-encrypted. MicroType Express compression and
- * subsetting are not done: the whole font is embedded uncompressed, which every
- * reader of the structure accepts. */
+ * font's data, optionally XOR-encrypted. MicroType Express compression is not
+ * done: the font is embedded uncompressed, which every reader of the structure
+ * accepts. TTEMBED_SUBSET embeds a subset (wine-sg 9502): the requested
+ * characters' glyphs, their composite components and glyph 0 keep their
+ * indices, the others are emptied (fontsub's CreateFontPackage, TTFCFP_SUBSET). */
 
 #define EOT_MAGIC        0x504c
 #define EOT_VERSION_1    0x00010000
@@ -139,10 +142,145 @@
     return buffer_add16( b, 0 ) && buffer_add16( b, bytes ) && (!bytes || buffer_add( b, name, bytes ));
 }
 
+/* the glyph of CH in a cmap subtable of format 4 or 12 (0 when none) */
+static unsigned int cmap_subtable_glyph( const BYTE *sub, DWORD len, DWORD ch )
+{
+    DWORD i, count;
+
+    if (len < 4) return 0;
+    switch (get_be16( sub ))
+    {
+    case 4:
+    {
+        DWORD seg_x2, seg, end, start, delta, range;
+
+        if (len < 14 || ch > 0xffff) return 0;
+        seg_x2 = get_be16( sub + 6 );
+        if (16 + seg_x2 * 4 > len) return 0;
+        for (seg = 0; seg < seg_x2; seg += 2)
+        {
+            end = get_be16( sub + 14 + seg );
+            if (ch > end) continue;
+            start = get_be16( sub + 16 + seg_x2 + seg );
+            if (ch < start) return 0;
+            delta = get_be16( sub + 16 + seg_x2 * 2 + seg );
+            range = get_be16( sub + 16 + seg_x2 * 3 + seg );
+            if (!range) return (ch + delta) & 0xffff;
+            i = 16 + seg_x2 * 3 + seg + range + (ch - start) * 2;
+            if (i + 2 > len || !get_be16( sub + i )) return 0;
+            return (get_be16( sub + i ) + delta) & 0xffff;
+        }
+        return 0;
+    }
+    case 12:
+        if (len < 16) return 0;
+        count = get_be32( sub + 12 );
+        for (i = 0; i < count && 16 + (i + 1) * 12 <= len; i++)
+        {
+            const BYTE *group = sub + 16 + i * 12;
+            if (ch >= get_be32( group ) && ch <= get_be32( group + 4 ))
+                return get_be32( group + 8 ) + ch - get_be32( group );
+        }
+        return 0;
+    }
+    return 0;
+}
+
+/* the glyph of a character code of CHARSET (CHARSET_UNICODE or CHARSET_SYMBOL) through the font's
+ * Windows cmap: UCS-4 (3,10) before BMP (3,1) for Unicode; for a symbol font (3,0) the code, then the
+ * code in the F000 private use page where symbol fonts put their characters */
+static unsigned int char_glyph( const BYTE *font, DWORD size, ULONG charset, DWORD ch )
+{
+    static const WORD unicode_encodings[] = { 10, 1 }, symbol_encodings[] = { 0 };
+    const WORD *encodings = charset == CHARSET_SYMBOL ? symbol_encodings : unicode_encodings;
+    unsigned int n = charset == CHARSET_SYMBOL ? 1 : 2, e, glyph;
+    const BYTE *cmap;
+    DWORD len, count, i, offset;
+
+    if (!(cmap = find_table( font, size, TAG('c','m','a','p'), &len )) || len < 4) return 0;
+    count = get_be16( cmap + 2 );
+    for (e = 0; e < n; e++)
+    {
+        for (i = 0; i < count && 4 + (i + 1) * 8 <= len; i++)
+        {
+            const BYTE *rec = cmap + 4 + i * 8;
+            if (get_be16( rec ) != 3 || get_be16( rec + 2 ) != encodings[e]) continue;
+            if ((offset = get_be32( rec + 4 )) >= len) continue;
+            if ((glyph = cmap_subtable_glyph( cmap + offset, len - offset, ch ))) return glyph;
+            if (charset == CHARSET_SYMBOL && ch < 0x100 &&
+                (glyph = cmap_subtable_glyph( cmap + offset, len - offset, 0xf000 | ch ))) return glyph;
+        }
+    }
+    return 0;
+}
+
+static void * __cdecl subset_alloc( size_t size ) { return malloc( size ); }
+static void * __cdecl subset_realloc( void *ptr, size_t size ) { return realloc( ptr, size ); }
+static void __cdecl subset_free( void *ptr ) { free( ptr ); }
+
+static ULONG (__cdecl *pCreateFontPackage)( const unsigned char *, const ULONG, unsigned char **, ULONG *, ULONG *,
+    const unsigned short, const unsigned short, const unsigned short, const unsigned short, const unsigned short,
+    const unsigned short, const unsigned short *, const unsigned short, CFP_ALLOCPROC, CFP_REALLOCPROC,
+    CFP_FREEPROC, void * );
+
+/* the characters to keep, as given to TTEmbedFont (16-bit codes) or TTEmbedFontEx (UCS-4) */
+struct subset
+{
+    ULONG charset;
+    const USHORT *codes16;
+    const ULONG *codes32;
+    USHORT count;
+};
+
+/* the subset font (malloc'ed) of the characters in SUBSET */
+static LONG subset_font( const BYTE *font, DWORD size, const struct subset *subset, BYTE **ret, DWORD *ret_size )
+{
+    unsigned short *glyphs;
+    unsigned char *out = NULL;
+    ULONG out_size = 0, written = 0, err;
+    unsigned int i;
+    DWORD ch;
+
+    if (!(glyphs = malloc( subset->count * sizeof(*glyphs) ))) return E_NOFREEMEMORY;
+    for (i = 0; i < subset->count; i++)
+    {
+        ch = subset->codes32 ? subset->codes32[i] : subset->codes16[i];
+        glyphs[i] = subset->charset == CHARSET_GLYPHIDX ? ch : char_glyph( font, size, subset->charset, ch );
+    }
+    if (!pCreateFontPackage)
+    {
+        HMODULE fontsub = LoadLibraryW( L"fontsub.dll" );
+        if (fontsub) pCreateFontPackage = (void *)GetProcAddress( fontsub, "CreateFontPackage" );
+        if (!pCreateFontPackage)
+        {
+            free( glyphs );
+            return E_SUBSETTINGFAILED;
+        }
+    }
+#ifndef SG_MUTANT_EOT_NO_SUBSET
+    err = pCreateFontPackage( font, size, &out, &out_size, &written, TTFCFP_FLAGS_SUBSET | TTFCFP_FLAGS_GLYPHLIST,
+                             0, TTFCFP_SUBSET, 0, TTFCFP_MS_PLATFORMID, TTFCFP_DONT_CARE, glyphs, subset->count,
+                             subset_alloc, subset_realloc, subset_free, NULL );
+#else
+    err = 1;
+#endif
+    free( glyphs );
+    if (err)
+    {
+        WARN( "subsetting failed %lu\n", err );
+        return E_SUBSETTINGFAILED;
+    }
+    *ret = out;
+    *ret_size = written;
+    return E_NONE;
+}
+
 /* the EOT structure of the font data */
-static LONG embed_font_data( const BYTE *font, DWORD size, ULONG flags, ULONG *priv_status, ULONG *status,
-                             WRITEEMBEDPROC write, void *stream, TTEMBEDINFO *info )
+static LONG embed_font_data( const BYTE *font, DWORD size, ULONG flags, const struct subset *subset,
+                             ULONG *priv_status, ULONG *status, WRITEEMBEDPROC write, void *stream,
+                             TTEMBEDINFO *info )
 {
+    BYTE *subset_data = NULL;
     const BYTE *os2, *head;
     DWORD os2_len, head_len, i;
     struct buffer b = { 0 };
@@ -163,12 +301,33 @@
 #endif
     *status = 0;
 
+    if (flags & TTEMBED_SUBSET)
+    {
+        /* fsType bit 8: the font may not be subsetted; the whole font is embedded and the caller told */
+        if (fstype & 0x0100)
+        {
+            flags &= ~TTEMBED_SUBSET;
+            *status |= TTEMBED_SUBSETCANCEL;
+        }
+        else if (subset && subset->count)
+        {
+            if ((ret = subset_font( font, size, subset, &subset_data, &size ))) return ret;
+            font = subset_data;
+            if (!(os2 = find_table( font, size, TAG('O','S','/','2'), &os2_len )) ||
+                !(head = find_table( font, size, TAG('h','e','a','d'), &head_len )))
+            {
+                free( subset_data );
+                return E_SUBSETTINGFAILED;
+            }
+        }
+    }
+
     for (i = 0; i < 4; i++) names[i] = get_font_name( font, size, ids[i], &bytes[i] );
 
     buffer_add32( &b, 0 );                       /* EOTSize, below */
     buffer_add32( &b, size );                    /* FontDataSize */
     buffer_add32( &b, EOT_VERSION_2_1 );
-    buffer_add32( &b, flags & TTEMBED_XORENCRYPTDATA );
+    buffer_add32( &b, flags & (TTEMBED_SUBSET | TTEMBED_XORENCRYPTDATA) );
     buffer_add( &b, os2 + 32, 10 );              /* PANOSE */
     byte = DEFAULT_CHARSET;
     buffer_add( &b, &byte, 1 );
@@ -202,6 +361,7 @@
     if (write( stream, b.data, b.used ) != b.used) ret = E_SAVETOSTREAMFAILED;
 done:
     free( b.data );
+    free( subset_data );
     return ret;
 }
 
@@ -238,6 +398,7 @@
                          USHORT *pusCharCodeSet, USHORT usCharCodeCount, USHORT usLanguage,
                          TTEMBEDINFO *pTTEmbedInfo)
 {
+    struct subset subset = { ulCharSet, pusCharCodeSet, NULL, usCharCodeCount };
     BYTE *data;
     DWORD size;
     LONG ret;
@@ -250,7 +411,8 @@
     if ((ret = check_embed_args( ulFlags, ulCharSet, pulPrivStatus, pulStatus, lpfnWriteToStream, lpvWriteStream,
                                  pusCharCodeSet, usCharCodeCount ))) return ret;
     if ((ret = embed_font_from_dc( hDC, &data, &size ))) return ret;
-    ret = embed_font_data( data, size, ulFlags, pulPrivStatus, pulStatus, lpfnWriteToStream, lpvWriteStream, pTTEmbedInfo );
+    ret = embed_font_data( data, size, ulFlags, &subset, pulPrivStatus, pulStatus, lpfnWriteToStream,
+                           lpvWriteStream, pTTEmbedInfo );
     free( data );
     return ret;
 }
@@ -261,6 +423,7 @@
                                  USHORT *pusCharCodeSet, USHORT usCharCodeCount, USHORT usLanguage,
                                  TTEMBEDINFO *pTTEmbedInfo)
 {
+    struct subset subset = { ulCharSet, pusCharCodeSet, NULL, usCharCodeCount };
     HANDLE file;
     BYTE *data;
     DWORD size, read;
@@ -310,14 +473,14 @@
                     put_be32( entry + 8, pos );
                     pos += (tlen + 3) & ~3;
                 }
-                if (!ret) ret = embed_font_data( one, total, ulFlags, pulPrivStatus, pulStatus,
+                if (!ret) ret = embed_font_data( one, total, ulFlags, &subset, pulPrivStatus, pulStatus,
                                                  lpfnWriteToStream, lpvWriteStream, pTTEmbedInfo );
                 free( one );
             }
         }
     }
-    else ret = embed_font_data( data, size, ulFlags, pulPrivStatus, pulStatus, lpfnWriteToStream, lpvWriteStream,
-                                pTTEmbedInfo );
+    else ret = embed_font_data( data, size, ulFlags, &subset, pulPrivStatus, pulStatus, lpfnWriteToStream,
+                                lpvWriteStream, pTTEmbedInfo );
     free( data );
     return ret;
 }
@@ -766,6 +929,7 @@
                           WRITEEMBEDPROC lpfnWriteToStream, LPVOID lpvWriteStream, ULONG *pulCharCodeSet,
                           USHORT usCharCodeCount, USHORT usLanguage, TTEMBEDINFO *pTTEmbedInfo)
 {
+    struct subset subset = { ulCharSet, NULL, pulCharCodeSet, usCharCodeCount };
     BYTE *data;
     DWORD size;
     LONG ret;
@@ -773,11 +937,11 @@
     TRACE("%p, %#lx, %lu, %p, %p, %p, %p, %p, %u, %u, %p\n", hDC, ulFlags, ulCharSet, pulPrivStatus, pulStatus,
           lpfnWriteToStream, lpvWriteStream, pulCharCodeSet, usCharCodeCount, usLanguage, pTTEmbedInfo);
 
-    /* the whole font is embedded (no subsetting yet), so the codes only need to be there */
     if ((ret = check_embed_args( ulFlags, ulCharSet, pulPrivStatus, pulStatus, lpfnWriteToStream, lpvWriteStream,
                                  (USHORT *)pulCharCodeSet, usCharCodeCount ))) return ret;
     if ((ret = embed_font_from_dc( hDC, &data, &size ))) return ret;
-    ret = embed_font_data( data, size, ulFlags, pulPrivStatus, pulStatus, lpfnWriteToStream, lpvWriteStream, pTTEmbedInfo );
+    ret = embed_font_data( data, size, ulFlags, &subset, pulPrivStatus, pulStatus, lpfnWriteToStream,
