From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msxml3: MXXMLWriter builds a DOM document (2032)

IMXWriter::put_output accepts an IXMLDOMDocument (VT_DISPATCH or
VT_UNKNOWN): startDocument empties the document, startElement adds the
element at once (name, namespace, attributes), characters are collected
and appear as a text node when the element ends, processing instructions
are added, endDocument finishes. Eighteen passing todo_wine marks removed
in test_mxwriter_domdoc.
---
--- a/dlls/msxml3/mxwriter.c
+++ b/dlls/msxml3/mxwriter.c
@@ -190,6 +190,12 @@
 
     IStream *dest;
 
+    /* a DOM document as the output: nodes are built as the events arrive */
+    IXMLDOMDocument *dom;
+    IXMLDOMNode *dom_node; /* the element that is open, or the document */
+    WCHAR *dom_text;       /* characters not yet added to the document */
+    size_t dom_text_len;
+
     output_buffer buffer;
 } mxwriter;
 
@@ -836,6 +842,180 @@
     return ref;
 }
 
+/* Output to a DOM document */
+static void dom_release_nodes(mxwriter *writer)
+{
+    if (writer->dom_node) IXMLDOMNode_Release(writer->dom_node);
+    writer->dom_node = NULL;
+    free(writer->dom_text);
+    writer->dom_text = NULL;
+    writer->dom_text_len = 0;
+}
+
+static HRESULT dom_flush_text(mxwriter *writer)
+{
+    IXMLDOMText *text;
+    HRESULT hr;
+    BSTR str;
+
+    if (!writer->dom_text_len || !writer->dom_node)
+        return S_OK;
+
+    str = SysAllocStringLen(writer->dom_text, writer->dom_text_len);
+    writer->dom_text_len = 0;
+    if (!str) return E_OUTOFMEMORY;
+
+    hr = IXMLDOMDocument_createTextNode(writer->dom, str, &text);
+    SysFreeString(str);
+    if (SUCCEEDED(hr))
+    {
+        hr = IXMLDOMNode_appendChild(writer->dom_node, (IXMLDOMNode *)text, NULL);
+        IXMLDOMText_Release(text);
+    }
+    return hr;
+}
+
+static HRESULT dom_start_document(mxwriter *writer)
+{
+    IXMLDOMNode *child;
+
+    dom_release_nodes(writer);
+    /* the document is emptied */
+    while (IXMLDOMDocument_get_firstChild(writer->dom, &child) == S_OK && child)
+    {
+        IXMLDOMNode *removed = NULL;
+        HRESULT hr = IXMLDOMDocument_removeChild(writer->dom, child, &removed);
+        IXMLDOMNode_Release(child);
+        if (removed) IXMLDOMNode_Release(removed);
+        if (FAILED(hr)) break;
+    }
+    return IXMLDOMDocument_QueryInterface(writer->dom, &IID_IXMLDOMNode, (void **)&writer->dom_node);
+}
+
+static HRESULT dom_start_element(mxwriter *writer, const WCHAR *uri, int nuri, const WCHAR *qname, int nqname,
+                                 ISAXAttributes *attr)
+{
+    IXMLDOMNode *node = NULL;
+    BSTR name, ns = NULL;
+    VARIANT type;
+    HRESULT hr;
+
+    if (!writer->dom_node && FAILED(hr = dom_start_document(writer)))
+        return hr;
+    if (FAILED(hr = dom_flush_text(writer)))
+        return hr;
+
+    if (nqname < 0) nqname = lstrlenW(qname);
+    name = SysAllocStringLen(qname, nqname);
+    if (uri && nuri != 0 && *uri)
+        ns = SysAllocStringLen(uri, nuri < 0 ? lstrlenW(uri) : nuri);
+
+    V_VT(&type) = VT_I4;
+    V_I4(&type) = NODE_ELEMENT;
+    hr = IXMLDOMDocument_createNode(writer->dom, type, name, ns, &node);
+    SysFreeString(name);
+    SysFreeString(ns);
+    if (FAILED(hr)) return hr;
+
+    if (attr)
+    {
+        IXMLDOMElement *element;
+        int length = 0, i;
+
+        ISAXAttributes_getLength(attr, &length);
+        if (length && SUCCEEDED(IXMLDOMNode_QueryInterface(node, &IID_IXMLDOMElement, (void **)&element)))
+        {
+            for (i = 0; i < length; i++)
+            {
+                const WCHAR *aname, *value;
+                int aname_len = 0, value_len = 0;
+                BSTR an, av;
+                VARIANT v;
+
+                if (FAILED(ISAXAttributes_getQName(attr, i, &aname, &aname_len)) ||
+                    FAILED(ISAXAttributes_getValue(attr, i, &value, &value_len)))
+                    continue;
+                an = SysAllocStringLen(aname, aname_len);
+                av = SysAllocStringLen(value, value_len);
+                V_VT(&v) = VT_BSTR;
+                V_BSTR(&v) = av;
+                IXMLDOMElement_setAttribute(element, an, v);
+                SysFreeString(an);
+                SysFreeString(av);
+            }
+            IXMLDOMElement_Release(element);
+        }
+    }
+
+    hr = IXMLDOMNode_appendChild(writer->dom_node, node, NULL);
+    if (FAILED(hr))
+    {
+        IXMLDOMNode_Release(node);
+        return hr;
+    }
+
+    IXMLDOMNode_Release(writer->dom_node);
+    writer->dom_node = node;
+    return S_OK;
+}
+
+static HRESULT dom_end_element(mxwriter *writer)
+{
+    IXMLDOMNode *parent = NULL;
+    HRESULT hr;
+
+    if (!writer->dom_node)
+        return S_OK;
+    if (FAILED(hr = dom_flush_text(writer)))
+        return hr;
+
+    IXMLDOMNode_get_parentNode(writer->dom_node, &parent);
+    if (parent)
+    {
+        IXMLDOMNode_Release(writer->dom_node);
+        writer->dom_node = parent;
+    }
+    return S_OK;
+}
+
+static HRESULT dom_characters(mxwriter *writer, const WCHAR *chars, int nchars)
+{
+    WCHAR *buf;
+
+    if (nchars < 0) nchars = lstrlenW(chars);
+    if (!nchars) return S_OK;
+    if (!(buf = realloc(writer->dom_text, (writer->dom_text_len + nchars) * sizeof(WCHAR))))
+        return E_OUTOFMEMORY;
+    writer->dom_text = buf;
+    memcpy(buf + writer->dom_text_len, chars, nchars * sizeof(WCHAR));
+    writer->dom_text_len += nchars;
+    return S_OK;
+}
+
+static HRESULT dom_processing_instruction(mxwriter *writer, const WCHAR *target, int ntarget, const WCHAR *data, int ndata)
+{
+    IXMLDOMProcessingInstruction *pi;
+    BSTR t, d;
+    HRESULT hr;
+
+    if (!writer->dom_node && FAILED(hr = dom_start_document(writer)))
+        return hr;
+    if (FAILED(hr = dom_flush_text(writer)))
+        return hr;
+
+    t = SysAllocStringLen(target, ntarget < 0 ? lstrlenW(target) : ntarget);
+    d = SysAllocStringLen(data, !data ? 0 : ndata < 0 ? lstrlenW(data) : ndata);
+    hr = IXMLDOMDocument_createProcessingInstruction(writer->dom, t, d, &pi);
+    SysFreeString(t);
+    SysFreeString(d);
+    if (SUCCEEDED(hr))
+    {
+        hr = IXMLDOMNode_appendChild(writer->dom_node, (IXMLDOMNode *)pi, NULL);
+        IXMLDOMProcessingInstruction_Release(pi);
+    }
+    return hr;
+}
