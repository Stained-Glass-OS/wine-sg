From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3d11: the format support flags CheckFormatSupport left out

CheckFormatSupport was a partial stub (thousands of FIXMEs in the logs).
ANGLE, Chromium and game engines choose formats by these flags:

- DISPLAY and BACK_BUFFER_CAST for the formats a swap chain shows
  (R8G8B8A8 and B8G8R8A8, UNORM and SRGB, from 9_1; R16G16B16A16_FLOAT,
  R10G10B10A2_UNORM and R10G10B10_XR_BIAS_A2_UNORM from 10_0), when they
  can be rendered to;
- CPU_LOCKABLE for every format that can be a buffer or texture;
- SO_BUFFER for the 32-bit component formats from 10_0;
- integer formats are loaded, not sampled: no SHADER_SAMPLE, and no
  MULTISAMPLE_RESOLVE.

Wine's d3d11 tests: the todo_wine on DISPLAY (kept only for
R10G10B10_XR_BIAS_A2_UNORM, which wined3d does not render to) and on
SHADER_SAMPLE for R32G32B32A32_UINT are removed; failures elsewhere as
before.

Gate: test/fmtsupport-gate.sh (Xvfb). Mutants SG_MUTANT_NO_DISPLAY_FORMATS,
SG_MUTANT_SAMPLE_INTEGER (d3d11/device.c).
---
--- a/dlls/d3d11/device.c
+++ b/dlls/d3d11/device.c
@@ -4534,6 +4534,69 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_OpenSharedResource(ID3D11Device2 *
     return E_NOTIMPL;
 }
 
+/* Stained Glass OS: formats with integer components (no filtering,
+ * blending or resolving) */
+static BOOL dxgi_format_is_integer(DXGI_FORMAT format)
+{
+    switch (format)
+    {
+        case DXGI_FORMAT_R32G32B32A32_UINT:
+        case DXGI_FORMAT_R32G32B32A32_SINT:
+        case DXGI_FORMAT_R32G32B32_UINT:
+        case DXGI_FORMAT_R32G32B32_SINT:
+        case DXGI_FORMAT_R16G16B16A16_UINT:
+        case DXGI_FORMAT_R16G16B16A16_SINT:
+        case DXGI_FORMAT_R32G32_UINT:
+        case DXGI_FORMAT_R32G32_SINT:
+        case DXGI_FORMAT_X32_TYPELESS_G8X24_UINT:
+        case DXGI_FORMAT_R10G10B10A2_UINT:
+        case DXGI_FORMAT_R8G8B8A8_UINT:
+        case DXGI_FORMAT_R8G8B8A8_SINT:
+        case DXGI_FORMAT_R16G16_UINT:
+        case DXGI_FORMAT_R16G16_SINT:
+        case DXGI_FORMAT_R32_UINT:
+        case DXGI_FORMAT_R32_SINT:
+        case DXGI_FORMAT_X24_TYPELESS_G8_UINT:
+        case DXGI_FORMAT_R8G8_UINT:
+        case DXGI_FORMAT_R8G8_SINT:
+        case DXGI_FORMAT_R16_UINT:
+        case DXGI_FORMAT_R16_SINT:
+        case DXGI_FORMAT_R8_UINT:
+        case DXGI_FORMAT_R8_SINT:
+            return TRUE;
+        default:
+            return FALSE;
+    }
+}
+
+/* the formats a swap chain can show, and the lowest feature level each
+ * needs */
+static D3D_FEATURE_LEVEL dxgi_format_display_level(DXGI_FORMAT format)
+{
+    switch (format)
+    {
+        case DXGI_FORMAT_R8G8B8A8_UNORM:
+        case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+        case DXGI_FORMAT_B8G8R8A8_UNORM:
+        case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+            return D3D_FEATURE_LEVEL_9_1;
+        case DXGI_FORMAT_R16G16B16A16_FLOAT:
+        case DXGI_FORMAT_R10G10B10A2_UNORM:
+        case DXGI_FORMAT_R10G10B10_XR_BIAS_A2_UNORM:
+            return D3D_FEATURE_LEVEL_10_0;
+        default:
+            return 0;
+    }
+}
+
+/* the formats stream output can write: 32-bit components */
+static BOOL dxgi_format_is_stream_output(DXGI_FORMAT format)
+{
+    return (format >= DXGI_FORMAT_R32G32B32A32_TYPELESS && format <= DXGI_FORMAT_R32G32B32_SINT)
+            || (format >= DXGI_FORMAT_R32G32_TYPELESS && format <= DXGI_FORMAT_R32G32_SINT)
+            || (format >= DXGI_FORMAT_R32_TYPELESS && format <= DXGI_FORMAT_R32_SINT && format != DXGI_FORMAT_D32_FLOAT);
+}
+
 static HRESULT STDMETHODCALLTYPE d3d11_device_CheckFormatSupport(ID3D11Device2 *iface, DXGI_FORMAT format,
         UINT *format_support)
 {
@@ -4569,7 +4632,7 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_CheckFormatSupport(ID3D11Device2 *
     };
     HRESULT hr;
 
-    FIXME("iface %p, format %u, format_support %p partial-stub!\n", iface, format, format_support);
+    TRACE("iface %p, format %u, format_support %p.\n", iface, format, format_support);
 
     wined3d_format = wined3dformat_from_dxgi_format(format);
     if (format && !wined3d_format)
@@ -4610,7 +4673,11 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_CheckFormatSupport(ID3D11Device2 *
             | D3D11_FORMAT_SUPPORT_TEXTURE2D | D3D11_FORMAT_SUPPORT_TEXTURE3D))
     {
         *format_support |= D3D11_FORMAT_SUPPORT_SHADER_LOAD;
-        *format_support |= D3D11_FORMAT_SUPPORT_SHADER_SAMPLE;
+#ifndef SG_MUTANT_SAMPLE_INTEGER
+        /* integer formats are loaded, not sampled */
+        if (!dxgi_format_is_integer(format))
+#endif
+            *format_support |= D3D11_FORMAT_SUPPORT_SHADER_SAMPLE;
         *format_support |= D3D11_FORMAT_SUPPORT_TEXTURECUBE;
 
         if (feature_level >= D3D_FEATURE_LEVEL_10_1)
@@ -4626,6 +4693,19 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_CheckFormatSupport(ID3D11Device2 *
         }
     }
 
+    /* Stained Glass OS: the rest of what the format can do */
+    if (*format_support & (D3D11_FORMAT_SUPPORT_BUFFER | D3D11_FORMAT_SUPPORT_TEXTURE1D
+            | D3D11_FORMAT_SUPPORT_TEXTURE2D | D3D11_FORMAT_SUPPORT_TEXTURE3D))
+        *format_support |= D3D11_FORMAT_SUPPORT_CPU_LOCKABLE;
+#ifndef SG_MUTANT_NO_DISPLAY_FORMATS
+    if (dxgi_format_display_level(format) && feature_level >= dxgi_format_display_level(format)
+            && (*format_support & D3D11_FORMAT_SUPPORT_RENDER_TARGET))
+        *format_support |= D3D11_FORMAT_SUPPORT_DISPLAY | D3D11_FORMAT_SUPPORT_BACK_BUFFER_CAST;
+#endif
+    if (feature_level >= D3D_FEATURE_LEVEL_10_0 && dxgi_format_is_stream_output(format)
+            && (*format_support & D3D11_FORMAT_SUPPORT_BUFFER))
+        *format_support |= D3D11_FORMAT_SUPPORT_SO_BUFFER;
+
     /* d3d11 requires 4 and 8 sample counts support for formats reported to
      * support multisample. */
     if (wined3d_check_device_multisample_type(wined3d_adapter, params.device_type, wined3d_format,
@@ -4633,9 +4713,10 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_CheckFormatSupport(ID3D11Device2 *
             wined3d_check_device_multisample_type(wined3d_adapter, params.device_type, wined3d_format,
             TRUE, WINED3D_MULTISAMPLE_8_SAMPLES, NULL) == WINED3D_OK)
     {
-        *format_support |= D3D11_FORMAT_SUPPORT_MULTISAMPLE_RESOLVE
-                | D3D11_FORMAT_SUPPORT_MULTISAMPLE_RENDERTARGET
+        *format_support |= D3D11_FORMAT_SUPPORT_MULTISAMPLE_RENDERTARGET
                 | D3D11_FORMAT_SUPPORT_MULTISAMPLE_LOAD;
+        if (!dxgi_format_is_integer(format))
+            *format_support |= D3D11_FORMAT_SUPPORT_MULTISAMPLE_RESOLVE;
     }
 
     return *format_support ? S_OK : E_FAIL;
--- a/dlls/d3d11/tests/d3d11.c
+++ b/dlls/d3d11/tests/d3d11.c
@@ -21166,7 +21166,8 @@ static void check_format_support(ID3D11Device *device, const unsigned int *forma
 
         if (formats[i].fl_required <= feature_level)
         {
-            todo_wine_if (feature_flag == D3D11_FORMAT_SUPPORT_DISPLAY)
+            todo_wine_if (feature_flag == D3D11_FORMAT_SUPPORT_DISPLAY
+                    && format == DXGI_FORMAT_R10G10B10_XR_BIAS_A2_UNORM)
                 ok(supported || broken(warp),
                         "Format %#x - %s not supported, format support %#x.\n",
                         format, feature_name, format_support[format]);
@@ -21323,7 +21324,6 @@ static void test_format_support(const D3D_FEATURE_LEVEL feature_level)
 
     ok(format_support[DXGI_FORMAT_R8G8B8A8_UNORM] & D3D11_FORMAT_SUPPORT_SHADER_SAMPLE,
             "SHADER_SAMPLE is not supported for R8G8B8A8_UNORM.\n");
-    todo_wine
     ok(!(format_support[DXGI_FORMAT_R32G32B32A32_UINT] & D3D11_FORMAT_SUPPORT_SHADER_SAMPLE),
             "SHADER_SAMPLE is supported for R32G32B32A32_UINT.\n");
     if (feature_level >= D3D_FEATURE_LEVEL_10_0)
