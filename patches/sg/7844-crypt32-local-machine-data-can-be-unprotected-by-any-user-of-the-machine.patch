From: Stained Glass OS <ke7oxh@gmail.com>
Subject: crypt32: CRYPTPROTECT_LOCAL_MACHINE data can be unprotected by any user of the machine

On Windows, CryptProtectData with CRYPTPROTECT_LOCAL_MACHINE ties the data to
the computer, not to a user, and any user of that computer can unprotect it.
Wine ignored the flag and keyed every blob to the user who made it. Visual
Studio 2022's setup (running as SYSTEM) protects its license data under
HKLM\Software\Classes\Licenses this way (flags 0x5). A standard user's
devenv could not unprotect it and reported "The license for Visual Studio has
expired".

Such data is now marked in the blob (in the DWORD Wine always wrote as 0;
CryptUnprotectData's caller need not pass the flag), and its key leaves out
the user name. A user's own data is unchanged and stays theirs.

Existing installs keep the blobs that setup made per-user before this
change; a Visual Studio repair rewrites them (verified).

Gate: test/dpapimachine-gate.sh. Mutant: SG_MUTANT_DPAPI_MACHINE_IS_USER.

--- a/dlls/crypt32/protectdata.c
+++ b/dlls/crypt32/protectdata.c
@@ -500,7 +500,7 @@
         ERR("count0 != 0x0001 !\n");
         status=FALSE;
     }
-    if (pInfo->null0 != 0x0000)
+    if (pInfo->null0 != 0x0000 && pInfo->null0 != CRYPTPROTECT_LOCAL_MACHINE)
     {
         ERR("null0 != 0x0000 !\n");
         status=FALSE;
@@ -703,7 +703,7 @@
 /* create an encryption key from a given salt and optional entropy */
 static
 BOOL load_encryption_key(HCRYPTPROV hProv, DWORD key_len, const DATA_BLOB *salt,
-                         const DATA_BLOB *pOptionalEntropy, HCRYPTKEY *phKey)
+                         const DATA_BLOB *pOptionalEntropy, BOOL machine, HCRYPTKEY *phKey)
 {
     BOOL rc = TRUE;
     HCRYPTHASH hSaltHash;
@@ -722,7 +722,9 @@
     /* This should be the "logon credentials" instead of username */
     dwError=GetLastError();
     dwUsernameLen = 0;
-    if (!GetUserNameA(NULL, &dwUsernameLen) &&
+    /* Stained Glass OS: CRYPTPROTECT_LOCAL_MACHINE data belongs to the computer, not to a user:
+     * any user of it may unprotect it (as on Windows), so no user name goes into its key */
+    if (!machine && !GetUserNameA(NULL, &dwUsernameLen) &&
         GetLastError() == ERROR_INSUFFICIENT_BUFFER && dwUsernameLen &&
         (szUsername = CryptMemAlloc(dwUsernameLen)))
     {
@@ -868,7 +870,13 @@
     }
 
     /* load key */
-    if (!load_encryption_key(hProv,protect_data.cipher_key_len,&protect_data.salt,pOptionalEntropy,&hKey))
+#ifndef SG_MUTANT_DPAPI_MACHINE_IS_USER
+    /* Stained Glass OS: the computer's data is marked so (in the field Windows keeps its
+     * flags in), for CryptUnprotectData to know -- its caller need not say so */
+    if (dwFlags & CRYPTPROTECT_LOCAL_MACHINE) protect_data.null0 = CRYPTPROTECT_LOCAL_MACHINE;
+#endif
+    if (!load_encryption_key(hProv,protect_data.cipher_key_len,&protect_data.salt,pOptionalEntropy,
+                             protect_data.null0 == CRYPTPROTECT_LOCAL_MACHINE,&hKey))
     {
         goto free_protect_data;
     }
@@ -1047,7 +1055,8 @@
     }
 
     /* load key */
-    if (!load_encryption_key(hProv,protect_data.cipher_key_len,&protect_data.salt,pOptionalEntropy,&hKey))
+    if (!load_encryption_key(hProv,protect_data.cipher_key_len,&protect_data.salt,pOptionalEntropy,
+                             protect_data.null0 == CRYPTPROTECT_LOCAL_MACHINE,&hKey))
     {
         goto free_context;
     }
