From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: ITextDocument2 Range2, RangeFromPoint2, GetSelection2 and the document font.

Range2 and RangeFromPoint2 give the range Range and RangeFromPoint give, as an ITextRange2
(RangeFromPoint2's type may say the point is in client coordinates, tomClientCoord); GetSelection2
gives the selection as an ITextSelection2. GetDocumentFont gives the default character format as
a font of its own (an ITextFont2 not attached to text); SetDocumentFont makes a font's set values
the default format, as EM_SETCHARFORMAT with SCF_DEFAULT does, and text in that format follows.
All were E_NOTIMPL. The value of each font property from a character format, and the character
format of a font's set values, are factored out of the range code to serve both.
---
diff --git a/dlls/riched20/richole.c b/dlls/riched20/richole.c
index de2f780..4e54726 100644
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -442,6 +442,9 @@ static inline FLOAT points_to_twips(FLOAT value)
     return value * 1440 / 72.0;
 }
 
+static HRESULT textfont_prop_from_format(const CHARFORMAT2W *pfmt, enum textfont_prop_id propid,
+    textfont_prop_val *value);
+
 static HRESULT get_textfont_prop_for_pos(const struct text_services *services, int pos, enum textfont_prop_id propid,
     textfont_prop_val *value)
 {
@@ -456,6 +459,14 @@ static HRESULT get_textfont_prop_for_pos(const struct text_services *services, i
     to = from;
     ME_MoveCursorChars( services->editor, &to, 1, FALSE );
     ME_GetCharFormat( services->editor, &from, &to, &fmt );
+    return textfont_prop_from_format( &fmt, propid, value );
+}
+
+/* Stained Glass OS: a font property's value in a character format (a range's, or the document's default) */
+static HRESULT textfont_prop_from_format(const CHARFORMAT2W *pfmt, enum textfont_prop_id propid,
+    textfont_prop_val *value)
+{
+    CHARFORMAT2W fmt = *pfmt;
 
     switch (propid)
     {
@@ -523,9 +534,10 @@ static inline const struct text_services *get_range_reole(ITextRange *range)
     return services;
 }
 
-static void textrange_set_font(ITextRange *range, ITextFont *font)
+/* Stained Glass OS: the character format a font's set values make (what textrange_set_font applies) */
+static void textfont_to_format(ITextFont *font, CHARFORMAT2W *pfmt)
 {
-    CHARFORMAT2W fmt;
+#define fmt (*pfmt)
     HRESULT hr;
     LONG value;
     BSTR str;
@@ -670,6 +682,14 @@ static void textrange_set_font(ITextRange *range, ITextFont *font)
         fmt.wWeight = value;
     }
 
+#undef fmt
+}
+
+static void textrange_set_font(ITextRange *range, ITextFont *font)
+{
+    CHARFORMAT2W fmt;
+
+    textfont_to_format(font, &fmt);
     if (fmt.dwMask)
     {
         const struct text_services *services = get_range_reole(range);
@@ -8173,16 +8193,59 @@ static HRESULT WINAPI ITextDocument2_fnGetDisplays( ITextDocument2 *iface, IText
     return E_NOTIMPL;
 }
 
+/* Stained Glass OS: the document's default character format as a font of its own (not attached to
+ * any text); SetDocumentFont makes a font's set values the default format, as EM_SETCHARFORMAT with
+ * SCF_DEFAULT does */
 static HRESULT WINAPI ITextDocument2_fnGetDocumentFont( ITextDocument2 *iface, ITextFont2 **font )
 {
-    FIXME( "(%p): stub\n", iface );
+    struct text_services *services = impl_from_ITextDocument2( iface );
+    enum textfont_prop_id id;
+    ITextFontImpl *impl;
+    CHARFORMAT2W fmt;
+    ITextFont *ret;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", iface, font );
+    if (!font) return E_INVALIDARG;
+    *font = NULL;
+#ifdef SG_MUTANT_TOM2_DOCFONT
     return E_NOTIMPL;
+#endif
+    /* an empty duplicate, its values those of the default format */
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->x.scaling = 100;
+    impl->x.charrep = tomUndefined;
+    hr = create_textfont( NULL, impl, &ret );
+    free( impl );
+    if (FAILED(hr)) return hr;
+    impl = impl_from_ITextFont( ret );
+    memset( &fmt, 0, sizeof(fmt) );
+    fmt.cbSize = sizeof(fmt);
+    ME_GetDefaultCharFormat( services->editor, &fmt );
+    for (id = FONT_PROPID_FIRST; id < FONT_PROPID_LAST; id++)
+        textfont_prop_from_format( &fmt, id, &impl->props[id] );
+    *font = (ITextFont2 *)ret;
+    return S_OK;
 }
 
 static HRESULT WINAPI ITextDocument2_fnSetDocumentFont( ITextDocument2 *iface, ITextFont2 *font )
 {
-    FIXME( "(%p): stub\n", iface );
-    return E_NOTIMPL;
+    struct text_services *services = impl_from_ITextDocument2( iface );
+    CHARFORMAT2W fmt;
+
+    TRACE( "(%p)->(%p)\n", iface, font );
+    if (!font) return E_INVALIDARG;
+    memset( &fmt, 0, sizeof(fmt) );
+    fmt.cbSize = sizeof(fmt);
+    textfont_to_format( (ITextFont *)font, &fmt );
+    if (fmt.dwMask)
+    {
+        ME_SetDefaultCharFormat( services->editor, &fmt );
+        ME_WrapMarkedParagraphs( services->editor );
+        ME_UpdateScrollBar( services->editor );
+        ITextHost_TxInvalidateRect( services->editor->texthost, NULL, TRUE );
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI ITextDocument2_fnGetDocumentPara( ITextDocument2 *iface, ITextPara2 **para )
@@ -8237,10 +8300,20 @@ static HRESULT WINAPI ITextDocument2_fnSetNotificationMode( ITextDocument2 *ifac
     return S_OK;
 }
 
+/* Stained Glass OS: the selection, which is an ITextSelection2 */
 static HRESULT WINAPI ITextDocument2_fnGetSelection2( ITextDocument2 *iface, ITextSelection2 **selection )
 {
-    FIXME( "(%p): stub\n", iface );
-    return E_NOTIMPL;
+    ITextSelection *sel;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", iface, selection );
+    if (!selection) return E_INVALIDARG;
+    *selection = NULL;
+    if (FAILED(hr = ITextDocument2Old_fnGetSelection( &impl_from_ITextDocument2( iface )->ITextDocument2Old_iface, &sel )))
+        return hr;
+    hr = ITextSelection_QueryInterface( sel, &IID_ITextSelection2, (void **)selection );
+    ITextSelection_Release( sel );
+    return hr;
 }
 
 static HRESULT WINAPI ITextDocument2_fnGetStoryRanges2( ITextDocument2 *iface, ITextStoryRanges2 **stories )
@@ -8330,16 +8403,47 @@ static HRESULT WINAPI ITextDocument2_fnNotify( ITextDocument2 *iface, LONG value
     return S_OK;
 }
 
+/* Stained Glass OS: Range and RangeFromPoint, as ITextRange2 */
 static HRESULT WINAPI ITextDocument2_fnRange2( ITextDocument2 *iface, LONG cp_active, LONG cp_anchor, ITextRange2 **range )
 {
-    FIXME( "(%p): stub\n", iface );
+    ITextRange *r;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%ld, %ld, %p)\n", iface, cp_active, cp_anchor, range );
+    if (!range) return E_INVALIDARG;
+    *range = NULL;
+#ifdef SG_MUTANT_TOM2_RANGE2
     return E_NOTIMPL;
+#endif
+    if (FAILED(hr = ITextDocument2Old_fnRange( &impl_from_ITextDocument2( iface )->ITextDocument2Old_iface,
+                                               cp_active, cp_anchor, &r ))) return hr;
+    hr = ITextRange_QueryInterface( r, &IID_ITextRange2, (void **)range );
+    ITextRange_Release( r );
+    return hr;
 }
 
 static HRESULT WINAPI ITextDocument2_fnRangeFromPoint2( ITextDocument2 *iface, LONG x, LONG y, LONG type, ITextRange2 **range )
 {
-    FIXME( "(%p): stub\n", iface );
-    return E_NOTIMPL;
+    ITextRange *r;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%ld, %ld, %#lx, %p)\n", iface, x, y, type, range );
+    if (!range) return E_INVALIDARG;
+    *range = NULL;
+    /* type: tomStart/tomEnd/tomClientCoord and alignment flags; the point is a screen point unless
+     * tomClientCoord says otherwise */
+    if (type & tomClientCoord)
+    {
+        POINT pt = { x, y };
+        ITextHost_TxClientToScreen( impl_from_ITextDocument2( iface )->editor->texthost, &pt );
+        x = pt.x;
+        y = pt.y;
+    }
+    if (FAILED(hr = ITextDocument2Old_fnRangeFromPoint( &impl_from_ITextDocument2( iface )->ITextDocument2Old_iface,
+                                                        x, y, &r ))) return hr;
+    hr = ITextRange_QueryInterface( r, &IID_ITextRange2, (void **)range );
+    ITextRange_Release( r );
+    return hr;
 }
 
 static HRESULT WINAPI ITextDocument2_fnReleaseCallManager( ITextDocument2 *iface, IUnknown *manager )
