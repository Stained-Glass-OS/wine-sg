From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: CryptImportPKCS8, CryptExportPKCS8, CryptExportPKCS8Ex

All three were spec stubs, so a program that called them crashed. They work as Microsoft documents them:
a PKCS #8 PrivateKeyInfo (or an EncryptedPrivateKeyInfo the caller's decrypt callback opens) goes into the
provider the resolve callback names, else the default provider, and out of a provider the same way (an encrypt
callback makes an EncryptedPrivateKeyInfo). RSA is built in; other algorithms go to the
CryptDllImport/ExportPrivateKeyInfoEx OID functions, else ERROR_UNSUPPORTED_TYPE. A signature-only key carries
the key usage attribute (2.5.29.15, digitalSignature) and imports as AT_SIGNATURE. The SDK's
CRYPT_PKCS8_IMPORT_PARAMS / CRYPT_PKCS8_EXPORT_PARAMS and callback types are added to wincrypt.h.
Gate: test/pkcs8-gate.sh (openssl makes the key and reads the export).
---
--- a/include/wincrypt.h
+++ b/include/wincrypt.h
@@ -813,6 +813,35 @@
     PCRYPT_ATTRIBUTES          pAttributes;
 } CERT_PRIVATE_KEY_INFO, *PCERT_PRIVATE_KEY_INFO;
 
+/* Stained Glass OS (wine-sg 9920): the Windows SDK's names for the PKCS #8 structures, and the
+ * CryptImportPKCS8 / CryptExportPKCS8Ex parameters */
+typedef CERT_PRIVATE_KEY_INFO CRYPT_PRIVATE_KEY_INFO, *PCRYPT_PRIVATE_KEY_INFO;
+typedef CERT_ENCRYPTED_PRIVATE_KEY_INFO CRYPT_ENCRYPTED_PRIVATE_KEY_INFO, *PCRYPT_ENCRYPTED_PRIVATE_KEY_INFO;
+
+typedef BOOL (CALLBACK *PCRYPT_DECRYPT_PRIVATE_KEY_FUNC)(CRYPT_ALGORITHM_IDENTIFIER Algorithm,
+ CRYPT_DATA_BLOB EncryptedPrivateKey, BYTE *pbClearTextKey, DWORD *pcbClearTextKey, LPVOID pVoidDecryptFunc);
+typedef BOOL (CALLBACK *PCRYPT_ENCRYPT_PRIVATE_KEY_FUNC)(CRYPT_ALGORITHM_IDENTIFIER *pAlgorithm,
+ CRYPT_DATA_BLOB *pClearTextPrivateKey, BYTE *pbEncryptedKey, DWORD *pcbEncryptedKey, LPVOID pVoidEncryptFunc);
+typedef BOOL (CALLBACK *PCRYPT_RESOLVE_HCRYPTPROV_FUNC)(CRYPT_PRIVATE_KEY_INFO *pPrivateKeyInfo,
+ HCRYPTPROV *phCryptProv, LPVOID pVoidResolveFunc);
+
+typedef struct _CRYPT_PKCS8_IMPORT_PARAMS {
+    CRYPT_DIGEST_BLOB               PrivateKey;
+    PCRYPT_RESOLVE_HCRYPTPROV_FUNC  pResolvehCryptProvFunc;
+    LPVOID                          pVoidResolveFunc;
+    PCRYPT_DECRYPT_PRIVATE_KEY_FUNC pDecryptPrivateKeyFunc;
+    LPVOID                          pVoidDecryptFunc;
+} CRYPT_PKCS8_IMPORT_PARAMS, *PCRYPT_PKCS8_IMPORT_PARAMS,
+  CRYPT_PRIVATE_KEY_BLOB_AND_PARAMS, *PCRYPT_PRIVATE_KEY_BLOB_AND_PARAMS;
+
+typedef struct _CRYPT_PKCS8_EXPORT_PARAMS {
+    HCRYPTPROV                      hCryptProv;
+    DWORD                           dwKeySpec;
+    LPSTR                           pszPrivateKeyObjId;
+    PCRYPT_ENCRYPT_PRIVATE_KEY_FUNC pEncryptPrivateKeyFunc;
+    LPVOID                          pVoidEncryptFunc;
+} CRYPT_PKCS8_EXPORT_PARAMS, *PCRYPT_PKCS8_EXPORT_PARAMS;
+
 typedef struct _CTL_USAGE {
     DWORD  cUsageIdentifier;
     LPSTR *rgpszUsageIdentifier;
@@ -4553,6 +4582,12 @@
 WINCRYPT32API BOOL WINAPI CryptImportPublicKeyInfoEx(HCRYPTPROV hCryptProv,
  DWORD dwCertEncodingType, PCERT_PUBLIC_KEY_INFO pInfo, ALG_ID aiKeyAlg,
  DWORD dwFlags, void *pvAuxInfo, HCRYPTKEY *phKey);
+WINCRYPT32API BOOL WINAPI CryptImportPKCS8(CRYPT_PKCS8_IMPORT_PARAMS sPrivateKeyAndParams, DWORD dwFlags,
+ HCRYPTPROV *phCryptProv, void *pvAuxInfo);
+WINCRYPT32API BOOL WINAPI CryptExportPKCS8(HCRYPTPROV hCryptProv, DWORD dwKeySpec, LPSTR pszPrivateKeyObjId,
+ DWORD dwFlags, void *pvAuxInfo, BYTE *pbPrivateKeyBlob, DWORD *pcbPrivateKeyBlob);
+WINCRYPT32API BOOL WINAPI CryptExportPKCS8Ex(CRYPT_PKCS8_EXPORT_PARAMS *psExportParams, DWORD dwFlags,
+ void *pvAuxInfo, BYTE *pbPrivateKeyBlob, DWORD *pcbPrivateKeyBlob);
 WINCRYPT32API BOOL WINAPI CryptImportPublicKeyInfoEx2(DWORD dwCertEncodingType,
  PCERT_PUBLIC_KEY_INFO pInfo, DWORD dwFlags, void *pvAuxInfo,
  BCRYPT_KEY_HANDLE *phKey);
--- a/dlls/crypt32/crypt32.spec
+++ b/dlls/crypt32/crypt32.spec
@@ -122,7 +122,8 @@
 @ stdcall CryptEnumOIDFunction(long str str long ptr ptr)
 @ stdcall CryptEnumOIDInfo(long long ptr ptr)
 @ stdcall CryptEnumProvidersU(long ptr long ptr ptr ptr) advapi32.CryptEnumProvidersW
-@ stub CryptExportPKCS8
+@ stdcall CryptExportPKCS8(long long str long ptr ptr ptr)
+@ stdcall CryptExportPKCS8Ex(ptr long ptr ptr ptr)
 @ stdcall CryptExportPublicKeyInfo(long long long ptr ptr)
 @ stdcall CryptExportPublicKeyInfoEx(long long long str long ptr ptr ptr)
 @ stdcall CryptExportPublicKeyInfoFromBCryptKeyHandle(ptr long str long ptr ptr ptr)
@@ -144,7 +145,8 @@
 @ stdcall CryptHashMessage(ptr long long ptr ptr ptr ptr ptr ptr)
 @ stdcall CryptHashPublicKeyInfo(long long long long ptr ptr ptr)
 @ stdcall CryptHashToBeSigned(ptr long ptr long ptr ptr)
-@ stub CryptImportPKCS8
+@ stdcall -arch=win32 CryptImportPKCS8(long ptr ptr ptr ptr ptr long ptr ptr)
+@ stdcall -arch=win64 CryptImportPKCS8(ptr long ptr ptr)
 @ stdcall CryptImportPublicKeyInfo(long long ptr ptr)
 @ stdcall CryptImportPublicKeyInfoEx(long long ptr long long ptr ptr)
 @ stdcall CryptImportPublicKeyInfoEx2(long ptr long ptr ptr)
--- a/dlls/crypt32/pfx.c
+++ b/dlls/crypt32/pfx.c
@@ -17,6 +17,7 @@
  */
 
 #include <stdarg.h>
+#include <string.h>
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
@@ -377,3 +378,302 @@
     CryptMemFree( input );
     return ret;
 }
+
+/* Stained Glass OS (wine-sg 9920): CryptImportPKCS8, CryptExportPKCS8, CryptExportPKCS8Ex, as Microsoft
+ * documents them (both were spec stubs, so a caller crashed). A PKCS #8 PrivateKeyInfo (RFC 5208) --
+ * or an EncryptedPrivateKeyInfo, which the caller's decrypt callback opens -- goes into the provider the
+ * caller's resolve callback names, else the default provider, and out of a provider the same way. RSA keys
+ * (szOID_RSA_RSA) are built in; other algorithms go to the CryptDllImportPrivateKeyInfoEx /
+ * CryptDllExportPrivateKeyInfoEx OID functions, else ERROR_UNSUPPORTED_TYPE. A signature-only key is
+ * marked with the key usage attribute (2.5.29.15, digitalSignature), as Microsoft's PKCS #12 exports mark
+ * it, and such a key is imported as AT_SIGNATURE (otherwise AT_KEYEXCHANGE). */
+
+typedef BOOL (WINAPI *ImportPrivateKeyInfoExFunc)(HCRYPTPROV, CRYPT_PRIVATE_KEY_INFO *, DWORD, void *);
+typedef BOOL (WINAPI *ExportPrivateKeyInfoExFunc)(HCRYPTPROV, DWORD, LPSTR, DWORD, void *,
+                                                  CRYPT_PRIVATE_KEY_INFO *, DWORD *);
+
+static BOOL pkcs8_signature_only( const CRYPT_PRIVATE_KEY_INFO *info )
+{
+    DWORD i, size;
+    CRYPT_BIT_BLOB *usage;
+    BOOL ret = FALSE;
+
+    if (!info->pAttributes) return FALSE;
+    for (i = 0; i < info->pAttributes->cAttr; i++)
+    {
+        const CRYPT_ATTRIBUTE *attr = &info->pAttributes->rgAttr[i];
+
+        if (strcmp( attr->pszObjId, szOID_KEY_USAGE ) || !attr->cValue) continue;
+        if (CryptDecodeObjectEx( X509_ASN_ENCODING, X509_KEY_USAGE, attr->rgValue[0].pbData,
+                                 attr->rgValue[0].cbData, CRYPT_DECODE_ALLOC_FLAG, NULL, &usage, &size ))
+        {
+            BYTE bits = usage->cbData ? usage->pbData[0] : 0;
+            ret = (bits & CERT_DIGITAL_SIGNATURE_KEY_USAGE) &&
+                  !(bits & (CERT_KEY_ENCIPHERMENT_KEY_USAGE | CERT_DATA_ENCIPHERMENT_KEY_USAGE |
+                            CERT_KEY_AGREEMENT_KEY_USAGE));
+            LocalFree( usage );
+        }
+    }
+    return ret;
+}
+
+static BOOL pkcs8_import_rsa( HCRYPTPROV prov, CRYPT_PRIVATE_KEY_INFO *info, DWORD flags )
+{
+    BLOBHEADER *blob;
+    HCRYPTKEY key;
+    DWORD size;
+    BOOL ret;
+
+    if (!CryptDecodeObjectEx( X509_ASN_ENCODING, PKCS_RSA_PRIVATE_KEY, info->PrivateKey.pbData,
+                              info->PrivateKey.cbData, CRYPT_DECODE_ALLOC_FLAG, NULL, &blob, &size ))
+        return FALSE;
+    if (pkcs8_signature_only( info )) blob->aiKeyAlg = CALG_RSA_SIGN;
+    ret = CryptImportKey( prov, (BYTE *)blob, size, 0, flags & (CRYPT_EXPORTABLE | CRYPT_USER_PROTECTED), &key );
+    if (ret) CryptDestroyKey( key );
+    SecureZeroMemory( blob, size );
+    LocalFree( blob );
+    return ret;
+}
+
+BOOL WINAPI CryptImportPKCS8( CRYPT_PKCS8_IMPORT_PARAMS params, DWORD flags, HCRYPTPROV *ret_prov, void *aux )
+{
+    CRYPT_PRIVATE_KEY_INFO *info = NULL;
+    CRYPT_ENCRYPTED_PRIVATE_KEY_INFO *enc = NULL;
+    BYTE *clear = NULL;
+    DWORD size, clear_size = 0, err;
+    HCRYPTPROV prov = 0;
+    BOOL ret = FALSE;
+
+    TRACE( "(%p %lu, %p, %#lx, %p, %p)\n", params.PrivateKey.pbData, params.PrivateKey.cbData,
+           params.pResolvehCryptProvFunc, flags, ret_prov, aux );
+
+    if (ret_prov) *ret_prov = 0;
+    if (!params.PrivateKey.pbData || !params.PrivateKey.cbData)
+    {
+        SetLastError( E_INVALIDARG );
+        return FALSE;
+    }
+    if (!CryptDecodeObjectEx( X509_ASN_ENCODING, PKCS_PRIVATE_KEY_INFO, params.PrivateKey.pbData,
+                              params.PrivateKey.cbData, CRYPT_DECODE_ALLOC_FLAG, NULL, &info, &size ))
+    {
+        /* an EncryptedPrivateKeyInfo: the caller's callback decrypts it */
+        err = GetLastError();
+        if (!params.pDecryptPrivateKeyFunc ||
+            !CryptDecodeObjectEx( X509_ASN_ENCODING, PKCS_ENCRYPTED_PRIVATE_KEY_INFO, params.PrivateKey.pbData,
+                                  params.PrivateKey.cbData, CRYPT_DECODE_ALLOC_FLAG, NULL, &enc, &size ))
+        {
+            SetLastError( err );
+            return FALSE;
+        }
+        if (!params.pDecryptPrivateKeyFunc( enc->EncryptionAlgorithm, enc->EncryptedPrivateKey, NULL,
+                                            &clear_size, params.pVoidDecryptFunc ) ||
+            !(clear = CryptMemAlloc( clear_size )) ||
+            !params.pDecryptPrivateKeyFunc( enc->EncryptionAlgorithm, enc->EncryptedPrivateKey, clear,
+                                            &clear_size, params.pVoidDecryptFunc ) ||
+            !CryptDecodeObjectEx( X509_ASN_ENCODING, PKCS_PRIVATE_KEY_INFO, clear, clear_size,
+                                  CRYPT_DECODE_ALLOC_FLAG, NULL, &info, &size ))
+            goto done;
+    }
+
+    if (params.pResolvehCryptProvFunc)
+    {
+        if (!params.pResolvehCryptProvFunc( info, &prov, params.pVoidResolveFunc )) goto done;
+    }
+    else
+    {
+        /* the default provider, in the user's default key container */
+        if (!CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_FULL, 0 ) &&
+            (GetLastError() != NTE_BAD_KEYSET ||
+             !CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_FULL, CRYPT_NEWKEYSET )))
+            goto done;
+    }
+
+#ifndef SG_MUTANT_PKCS8_RSA_UNSUPPORTED
+    if (info->Algorithm.pszObjId && !strcmp( info->Algorithm.pszObjId, szOID_RSA_RSA ))
+        ret = pkcs8_import_rsa( prov, info, flags );
+    else
+#endif
+    {
+        HCRYPTOIDFUNCSET set = CryptInitOIDFunctionSet( CRYPT_OID_IMPORT_PRIVATE_KEY_INFO_FUNC, 0 );
+        HCRYPTOIDFUNCADDR addr = NULL;
+        ImportPrivateKeyInfoExFunc func = NULL;
+
+        if (info->Algorithm.pszObjId &&
+            CryptGetOIDFunctionAddress( set, X509_ASN_ENCODING, info->Algorithm.pszObjId, 0, (void **)&func, &addr ))
+        {
+            ret = func( prov, info, flags, aux );
+            CryptFreeOIDFunctionAddress( addr, 0 );
+        }
+        else SetLastError( ERROR_UNSUPPORTED_TYPE );
+    }
+
+done:
+    err = GetLastError();
+    if (ret && ret_prov) *ret_prov = prov;
+    else if (prov) CryptReleaseContext( prov, 0 );
+    if (info)
+    {
+        SecureZeroMemory( info->PrivateKey.pbData, info->PrivateKey.cbData );
+        LocalFree( info );
+    }
+    if (clear)
+    {
+        SecureZeroMemory( clear, clear_size );
+        CryptMemFree( clear );
+    }
+    LocalFree( enc );
+    SetLastError( ret ? ERROR_SUCCESS : err );
+    return ret;
+}
+
+static BOOL pkcs8_put( const BYTE *data, DWORD size, BYTE *out, DWORD *out_size )
+{
+    BOOL ret = TRUE;
+
+    if (out)
+    {
+        if (*out_size < size)
+        {
+            SetLastError( ERROR_MORE_DATA );
+            ret = FALSE;
+        }
+        else memcpy( out, data, size );
+    }
+    *out_size = size;
+    return ret;
+}
+
+/* the PrivateKeyInfo of an RSA key in the provider (LocalAlloc'd DER) */
+static BOOL pkcs8_export_rsa( HCRYPTPROV prov, DWORD spec, BYTE **der, DWORD *der_size )
+{
+    static BYTE null_params[] = { ASN_NULL, 0 };
+    static BYTE signature_usage[] = { ASN_BITSTRING, 2, 7, CERT_DIGITAL_SIGNATURE_KEY_USAGE };
+    CRYPT_PRIVATE_KEY_INFO info = { 0 };
+    CRYPT_ATTR_BLOB usage_value = { sizeof(signature_usage), signature_usage };
+    CRYPT_ATTRIBUTE usage = { (char *)szOID_KEY_USAGE, 1, &usage_value };
+    CRYPT_ATTRIBUTES attrs = { 1, &usage };
+    BLOBHEADER *blob = NULL;
+    BYTE *rsa = NULL;
+    HCRYPTKEY key;
+    DWORD size = 0, rsa_size;
+    BOOL ret = FALSE;
+
+    if (!CryptGetUserKey( prov, spec, &key )) return FALSE;
+    if (CryptExportKey( key, 0, PRIVATEKEYBLOB, 0, NULL, &size ) && (blob = CryptMemAlloc( size )) &&
+        CryptExportKey( key, 0, PRIVATEKEYBLOB, 0, (BYTE *)blob, &size ))
+    {
+        if (blob->aiKeyAlg != CALG_RSA_KEYX && blob->aiKeyAlg != CALG_RSA_SIGN)
+            SetLastError( ERROR_UNSUPPORTED_TYPE );
+        else if (CryptEncodeObjectEx( X509_ASN_ENCODING, PKCS_RSA_PRIVATE_KEY, blob, CRYPT_ENCODE_ALLOC_FLAG,
+                                      NULL, &rsa, &rsa_size ))
+        {
+            info.Version = 0;
+            info.Algorithm.pszObjId = (char *)szOID_RSA_RSA;
+            info.Algorithm.Parameters.cbData = sizeof(null_params);
+            info.Algorithm.Parameters.pbData = null_params;
+            info.PrivateKey.cbData = rsa_size;
+            info.PrivateKey.pbData = rsa;
+            if (spec == AT_SIGNATURE) info.pAttributes = &attrs;
+            ret = CryptEncodeObjectEx( X509_ASN_ENCODING, PKCS_PRIVATE_KEY_INFO, &info, CRYPT_ENCODE_ALLOC_FLAG,
+                                       NULL, der, der_size );
+            SecureZeroMemory( rsa, rsa_size );
+            LocalFree( rsa );
+        }
+    }
+    if (blob)
+    {
+        SecureZeroMemory( blob, size );
+        CryptMemFree( blob );
+    }
+    CryptDestroyKey( key );
+    return ret;
+}
+
+/* the PrivateKeyInfo from an OID function installed for the algorithm (LocalAlloc'd DER) */
+static BOOL pkcs8_export_oidfunc( const CRYPT_PKCS8_EXPORT_PARAMS *params, DWORD flags, void *aux,
+                                  BYTE **der, DWORD *der_size )
+{
+    HCRYPTOIDFUNCSET set = CryptInitOIDFunctionSet( CRYPT_OID_EXPORT_PRIVATE_KEY_INFO_FUNC, 0 );
+    HCRYPTOIDFUNCADDR addr = NULL;
+    ExportPrivateKeyInfoExFunc func = NULL;
+    CRYPT_PRIVATE_KEY_INFO *info = NULL;
+    DWORD size = 0;
+    BOOL ret = FALSE;
+
+    if (!CryptGetOIDFunctionAddress( set, X509_ASN_ENCODING, params->pszPrivateKeyObjId, 0, (void **)&func, &addr ))
+    {
+        SetLastError( ERROR_UNSUPPORTED_TYPE );
+        return FALSE;
+    }
+    if (func( params->hCryptProv, params->dwKeySpec, params->pszPrivateKeyObjId, flags, aux, NULL, &size ) &&
+        (info = CryptMemAlloc( size )) &&
+        func( params->hCryptProv, params->dwKeySpec, params->pszPrivateKeyObjId, flags, aux, info, &size ))
+        ret = CryptEncodeObjectEx( X509_ASN_ENCODING, PKCS_PRIVATE_KEY_INFO, info, CRYPT_ENCODE_ALLOC_FLAG,
+                                   NULL, der, der_size );
+    if (info)
+    {
+        SecureZeroMemory( info, size );
+        CryptMemFree( info );
+    }
+    CryptFreeOIDFunctionAddress( addr, 0 );
+    return ret;
+}
+
+BOOL WINAPI CryptExportPKCS8Ex( CRYPT_PKCS8_EXPORT_PARAMS *params, DWORD flags, void *aux,
+                                BYTE *out, DWORD *out_size )
+{
+    BYTE *der = NULL, *crypted = NULL, *enc_der = NULL;
+    DWORD der_size = 0, crypted_size = 0, enc_size = 0;
+    BOOL ret = FALSE;
+
+    TRACE( "(%p, %#lx, %p, %p, %p)\n", params, flags, aux, out, out_size );
+
+    if (!params || !out_size || !params->hCryptProv || !params->pszPrivateKeyObjId)
+    {
+        SetLastError( E_INVALIDARG );
+        return FALSE;
+    }
+#ifndef SG_MUTANT_PKCS8_RSA_UNSUPPORTED
+    if (!strcmp( params->pszPrivateKeyObjId, szOID_RSA_RSA ))
+        ret = pkcs8_export_rsa( params->hCryptProv, params->dwKeySpec, &der, &der_size );
+    else
+#endif
+        ret = pkcs8_export_oidfunc( params, flags, aux, &der, &der_size );
+    if (!ret) return FALSE;
+
+    if (!params->pEncryptPrivateKeyFunc) ret = pkcs8_put( der, der_size, out, out_size );
+    else
+    {
+        CRYPT_ENCRYPTED_PRIVATE_KEY_INFO enc = { { 0 } };
+        CRYPT_DATA_BLOB clear = { der_size, der };
+
+        /* the callback names the algorithm and encrypts; the result is an EncryptedPrivateKeyInfo */
+        ret = params->pEncryptPrivateKeyFunc( &enc.EncryptionAlgorithm, &clear, NULL, &crypted_size,
+                                              params->pVoidEncryptFunc ) &&
+              (crypted = CryptMemAlloc( crypted_size )) &&
+              params->pEncryptPrivateKeyFunc( &enc.EncryptionAlgorithm, &clear, crypted, &crypted_size,
+                                              params->pVoidEncryptFunc );
+        if (ret)
+        {
+            enc.EncryptedPrivateKey.cbData = crypted_size;
+            enc.EncryptedPrivateKey.pbData = crypted;
+            ret = CryptEncodeObjectEx( X509_ASN_ENCODING, PKCS_ENCRYPTED_PRIVATE_KEY_INFO, &enc,
+                                       CRYPT_ENCODE_ALLOC_FLAG, NULL, &enc_der, &enc_size ) &&
+                  pkcs8_put( enc_der, enc_size, out, out_size );
+        }
+        CryptMemFree( crypted );
+        LocalFree( enc_der );
+    }
+    SecureZeroMemory( der, der_size );
+    LocalFree( der );
+    return ret;
+}
+
+BOOL WINAPI CryptExportPKCS8( HCRYPTPROV prov, DWORD spec, LPSTR oid, DWORD flags, void *aux,
+                              BYTE *out, DWORD *out_size )
+{
+    CRYPT_PKCS8_EXPORT_PARAMS params = { prov, spec, oid, NULL, NULL };
+
+    TRACE( "(%Ix, %lu, %s, %#lx, %p, %p, %p)\n", prov, spec, debugstr_a(oid), flags, aux, out, out_size );
+    return CryptExportPKCS8Ex( &params, flags, aux, out, out_size );
+}
