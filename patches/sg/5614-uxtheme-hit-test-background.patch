From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uxtheme: HitTestThemeBackground handles every documented option

uxtheme: HitTestThemeBackground handles every documented option

The part's rectangle is cut into nine segments by the style's sizing margins
(or the system frame, or a template) and the segment is reported as the
documented code for HTTB_BACKGROUNDSEG, FIXEDBORDER, CAPTION and the
RESIZINGBORDER options, honouring the region.
---
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -1013,10 +1013,90 @@ HRESULT WINAPI HitTestThemeBackground(HTHEME hTheme, HDC hdc, int iPartId,
                                      const RECT *pRect, HRGN hrgn,
                                      POINT ptTest, WORD *pwHitTestCode)
 {
-    FIXME("%d %d 0x%08lx: stub\n", iPartId, iStateId, dwOptions);
-    if(!hTheme)
+    MARGINS margins = { 0 };
+    BOOL left, right, top, bottom, resize_hit = FALSE;
+    WORD code;
+
+    TRACE("%d %d 0x%08lx %s %s\n", iPartId, iStateId, dwOptions, wine_dbgstr_rect(pRect),
+          wine_dbgstr_point(&ptTest));
+    if (!hTheme)
         return E_HANDLE;
-    return E_NOTIMPL;
+    if (!pRect || !pwHitTestCode)
+        return E_POINTER;
+
+    /* HTTB_SIZINGTEMPLATE takes precedence over HTTB_SYSTEMSIZINGMARGINS; both are band widths,
+     * from the visual style's sizing margins or from the system's frame */
+    if ((dwOptions & HTTB_SYSTEMSIZINGMARGINS) && !(dwOptions & HTTB_SIZINGTEMPLATE))
+    {
+        margins.cxLeftWidth = margins.cxRightWidth = GetSystemMetrics(SM_CXSIZEFRAME);
+        margins.cyTopHeight = margins.cyBottomHeight = GetSystemMetrics(SM_CYSIZEFRAME);
+    }
+    else if (FAILED(GetThemeMargins(hTheme, hdc, iPartId, iStateId, TMT_SIZINGMARGINS, NULL, &margins)))
+        memset(&margins, 0, sizeof(margins));
+
+    *pwHitTestCode = HTNOWHERE;
+    if (!PtInRect(pRect, ptTest))
+        return S_OK;
+    if (hrgn && !PtInRegion(hrgn, ptTest.x, ptTest.y))
+        return S_OK;
+
+#ifndef SG_MUTANT_HITTEST_NO_MARGINS
+    left = ptTest.x < pRect->left + margins.cxLeftWidth;
+    right = ptTest.x >= pRect->right - margins.cxRightWidth;
+    top = ptTest.y < pRect->top + margins.cyTopHeight;
+    bottom = ptTest.y >= pRect->bottom - margins.cyBottomHeight;
+#else
+    left = right = top = bottom = FALSE;
+#endif
+
+    if (dwOptions & HTTB_RESIZINGBORDER)
+    {
+        BOOL l = left && (dwOptions & HTTB_RESIZINGBORDER_LEFT);
+        BOOL r = right && (dwOptions & HTTB_RESIZINGBORDER_RIGHT);
+        BOOL t = top && (dwOptions & HTTB_RESIZINGBORDER_TOP);
+        BOOL b = bottom && (dwOptions & HTTB_RESIZINGBORDER_BOTTOM);
+
+        if (t && l) code = HTTOPLEFT;
+        else if (t && r) code = HTTOPRIGHT;
+        else if (b && l) code = HTBOTTOMLEFT;
+        else if (b && r) code = HTBOTTOMRIGHT;
+        else if (t) code = HTTOP;
+        else if (b) code = HTBOTTOM;
+        else if (l) code = HTLEFT;
+        else if (r) code = HTRIGHT;
+        else code = 0;
+        if (code)
+        {
+            *pwHitTestCode = code;
+            resize_hit = TRUE;
+        }
+    }
+    if (resize_hit)
+        return S_OK;
+
+    if ((dwOptions & HTTB_CAPTION) && top)
+        code = HTCAPTION;
+    else if (left || right || top || bottom)
+    {
+        if (dwOptions & (HTTB_FIXEDBORDER | HTTB_RESIZINGBORDER))
+            code = HTBORDER;
+        else if (dwOptions & HTTB_CAPTION)
+            code = HTNOWHERE;
+        else if (top && left) code = HTTOPLEFT;
+        else if (top && right) code = HTTOPRIGHT;
+        else if (bottom && left) code = HTBOTTOMLEFT;
+        else if (bottom && right) code = HTBOTTOMRIGHT;
+        else if (top) code = HTTOP;
+        else if (bottom) code = HTBOTTOM;
+        else if (left) code = HTLEFT;
+        else code = HTRIGHT;
+    }
+    else
+        code = (dwOptions & HTTB_CAPTION) && !(dwOptions & (HTTB_FIXEDBORDER | HTTB_RESIZINGBORDER))
+               ? HTNOWHERE : HTCLIENT;
+
+    *pwHitTestCode = code;
+    return S_OK;
 }
 
 /***********************************************************************
--- a/dlls/uxtheme/tests/system.c
+++ b/dlls/uxtheme/tests/system.c
@@ -2795,6 +2795,129 @@ static void test_DrawThemeEdge(void)
     DestroyWindow(hwnd);
 }
 
+static void test_HitTestThemeBackground(void)
+{
+    static const struct { LONG x, y; WORD seg; } cells[] =
+    {
+        { 0, 0, HTTOPLEFT }, { 50, 0, HTTOP }, { 99, 0, HTTOPRIGHT },
+        { 0, 50, HTLEFT }, { 50, 50, HTCLIENT }, { 99, 50, HTRIGHT },
+        { 0, 99, HTBOTTOMLEFT }, { 50, 99, HTBOTTOM }, { 99, 99, HTBOTTOMRIGHT },
+    };
+    const RECT rect = { 0, 0, 100, 100 };
+    MARGINS margins;
+    HRGN region;
+    HTHEME theme;
+    HRESULT hr;
+    HWND hwnd;
+    WORD code;
+    POINT pt;
+    HDC hdc;
+    int i;
+
+    hwnd = CreateWindowA("static", "test", WS_POPUP, 0, 0, 100, 100, 0, 0, 0, 0);
+    theme = OpenThemeData(hwnd, L"Button");
+    if (!theme)
+    {
+        skip("no theme\n");
+        DestroyWindow(hwnd);
+        return;
+    }
+    hdc = GetDC(hwnd);
+
+    pt.x = pt.y = 50;
+    hr = HitTestThemeBackground(NULL, hdc, BP_PUSHBUTTON, PBS_NORMAL, 0, &rect, NULL, pt, &code);
+    ok(hr == E_HANDLE, "got %#lx\n", hr);
+
+    hr = GetThemeMargins(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, TMT_SIZINGMARGINS, NULL, &margins);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (hr != S_OK || margins.cxLeftWidth <= 0 || margins.cxRightWidth <= 0
+            || margins.cyTopHeight <= 0 || margins.cyBottomHeight <= 0
+            || margins.cxLeftWidth + margins.cxRightWidth >= 90 || margins.cyTopHeight + margins.cyBottomHeight >= 90)
+    {
+        skip("the theme's sizing margins are not usable\n");
+        goto done;
+    }
+
+    /* the nine segments of the background */
+    for (i = 0; i < ARRAY_SIZE(cells); i++)
+    {
+        pt.x = cells[i].x;
+        pt.y = cells[i].y;
+        code = 0xffff;
+        hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, HTTB_BACKGROUNDSEG, &rect, NULL, pt, &code);
+        ok(hr == S_OK && code == cells[i].seg, "segment %d: got %#lx, %u, expected %u\n", i, hr, code, cells[i].seg);
+
+        code = 0xffff;
+        hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, HTTB_FIXEDBORDER, &rect, NULL, pt, &code);
+        ok(hr == S_OK && code == (cells[i].seg == HTCLIENT ? HTCLIENT : HTBORDER),
+                "fixed border %d: got %#lx, %u\n", i, hr, code);
+
+        code = 0xffff;
+        hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, HTTB_CAPTION, &rect, NULL, pt, &code);
+        ok(hr == S_OK && code == (cells[i].y == 0 ? HTCAPTION : HTNOWHERE), "caption %d: got %#lx, %u\n", i, hr, code);
+
+        code = 0xffff;
+        hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, HTTB_RESIZINGBORDER, &rect, NULL, pt, &code);
+        ok(hr == S_OK && code == (cells[i].seg == HTCLIENT ? HTCLIENT : cells[i].seg),
+                "resizing border %d: got %#lx, %u\n", i, hr, code);
+    }
+
+    /* single edges: a corner that is not in a requested edge is a plain border */
+    pt.x = 50; pt.y = 0;
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, HTTB_RESIZINGBORDER_TOP, &rect, NULL, pt, &code);
+    ok(hr == S_OK && code == HTTOP, "got %#lx, %u\n", hr, code);
+    pt.x = 0; pt.y = 50;
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, HTTB_RESIZINGBORDER_LEFT, &rect, NULL, pt, &code);
+    ok(hr == S_OK && code == HTLEFT, "got %#lx, %u\n", hr, code);
+    pt.x = 99; pt.y = 50;
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, HTTB_RESIZINGBORDER_RIGHT, &rect, NULL, pt, &code);
+    ok(hr == S_OK && code == HTRIGHT, "got %#lx, %u\n", hr, code);
+    pt.x = 50; pt.y = 99;
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, HTTB_RESIZINGBORDER_BOTTOM, &rect, NULL, pt, &code);
+    ok(hr == S_OK && code == HTBOTTOM, "got %#lx, %u\n", hr, code);
+    pt.x = 0; pt.y = 50;
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, HTTB_RESIZINGBORDER_TOP, &rect, NULL, pt, &code);
+    ok(hr == S_OK && code == HTBORDER, "got %#lx, %u\n", hr, code);
+
+    /* the sizing margins' width is where a segment starts */
+    pt.x = margins.cxLeftWidth - 1; pt.y = 50;
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, 0, &rect, NULL, pt, &code);
+    ok(hr == S_OK && code == HTLEFT, "got %#lx, %u\n", hr, code);
+    pt.x = margins.cxLeftWidth;
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, 0, &rect, NULL, pt, &code);
+    ok(hr == S_OK && code == HTCLIENT, "got %#lx, %u\n", hr, code);
+
+    /* the system frame instead of the style's margins; the template takes precedence */
+    pt.x = GetSystemMetrics(SM_CXSIZEFRAME) - 1; pt.y = 50;
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, HTTB_SYSTEMSIZINGMARGINS, &rect, NULL, pt, &code);
+    ok(hr == S_OK && code == HTLEFT, "got %#lx, %u\n", hr, code);
+    pt.x = GetSystemMetrics(SM_CXSIZEFRAME);
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, HTTB_SYSTEMSIZINGMARGINS, &rect, NULL, pt, &code);
+    ok(hr == S_OK && code == HTCLIENT, "got %#lx, %u\n", hr, code);
+    pt.x = margins.cxLeftWidth - 1;
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, HTTB_SYSTEMSIZINGMARGINS | HTTB_SIZINGTEMPLATE,
+            &rect, NULL, pt, &code);
+    ok(hr == S_OK && code == HTLEFT, "got %#lx, %u\n", hr, code);
+
+    /* outside the rectangle or the region */
+    pt.x = 100; pt.y = 50;
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, 0, &rect, NULL, pt, &code);
+    ok(hr == S_OK && code == HTNOWHERE, "got %#lx, %u\n", hr, code);
+    region = CreateRectRgn(60, 0, 100, 100);
+    pt.x = 50; pt.y = 50;
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, 0, &rect, region, pt, &code);
+    ok(hr == S_OK && code == HTNOWHERE, "got %#lx, %u\n", hr, code);
+    pt.x = 70;
+    hr = HitTestThemeBackground(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, 0, &rect, region, pt, &code);
+    ok(hr == S_OK && code == HTCLIENT, "got %#lx, %u\n", hr, code);
+    DeleteObject(region);
+
+done:
+    ReleaseDC(hwnd, hdc);
+    CloseThemeData(theme);
+    DestroyWindow(hwnd);
+}
+
 START_TEST(system)
 {
     ULONG_PTR ctx_cookie;
@@ -2824,6 +2947,7 @@ START_TEST(system)
     test_ShouldSystemUseDarkMode();
     test_ShouldAppsUseDarkMode();
     test_DrawThemeEdge();
+    test_HitTestThemeBackground();
 
     if (load_v6_module(&ctx_cookie, &ctx))
     {
