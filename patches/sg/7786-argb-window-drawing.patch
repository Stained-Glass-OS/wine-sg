+static BOOL xrender_up;
 
 #define MS_MAKE_TAG( _x1, _x2, _x3, _x4 ) \
           ( ( (ULONG)_x4 << 24 ) |     \
@@ -340,6 +342,7 @@ const struct gdi_dc_funcs *X11DRV_XRender_Init(void)
     LOAD_FUNCPTR(XRenderFreeGlyphSet);
     LOAD_FUNCPTR(XRenderFreePicture);
     LOAD_FUNCPTR(XRenderSetPictureClipRectangles);
+    LOAD_FUNCPTR(XRenderSetPictureClipRegion);
     LOAD_FUNCPTR(XRenderQueryExtension);
 #ifdef HAVE_XRENDERCREATELINEARGRADIENT
     LOAD_OPTIONAL_FUNCPTR(XRenderCreateLinearGradient);
@@ -351,6 +354,7 @@ const struct gdi_dc_funcs *X11DRV_XRender_Init(void)
 #undef LOAD_FUNCPTR
 
     if (!pXRenderQueryExtension(gdi_display, &event_base, &xrender_error_base)) return NULL;
+    xrender_up = TRUE;
 
     TRACE("Xrender is up and running error_base = %d\n", xrender_error_base);
     if(!load_xrender_formats()) /* This fails in buggy versions of libXrender.so */
@@ -1012,6 +1016,12 @@ static INT xrenderdrv_ExtEscape( PHYSDEV dev, INT escape, INT in_count, LPCVOID
             if (ret)
             {
                 free_xrender_picture( physdev );
+#ifndef SG_MUTANT_DC_DEPTH
+                if (in_count >= sizeof(struct x11drv_escape_set_drawable) &&
+                    ((const struct x11drv_escape_set_drawable *)in_data)->depth == 32 && pict_formats[WXR_FORMAT_A8R8G8B8])
+                    set_physdev_format( physdev, WXR_FORMAT_A8R8G8B8 );
+                else
+#endif
                 set_physdev_format( physdev, default_format );
             }
             return ret;
@@ -2266,12 +2276,112 @@ static const struct gdi_dc_funcs xrender_funcs =
     GDI_PRIORITY_GRAPHICS_DRV + 10      /* priority */
 };
 
+/* Stained Glass OS: copy between drawables of different depths -- a child window's
+ * frame (24 bits) into a top-level X window with alpha (32 bits: layered, or a
+ * sheet of DWM glass), where XCopyArea fails with BadMatch. Opaque where the
+ * source has no alpha. CLIP, in the destination's coordinates, may be NULL. */
+static int format_error( Display *display, XErrorEvent *event, void *arg )
+{
+    return 1;
+}
+
+/* a window's picture format is its visual's; a pixmap's its depth's */
+static XRenderPictFormat *format_for_drawable( Drawable drawable )
+{
+    XWindowAttributes attr;
+    Window root;
+    int x, y;
+    unsigned int w, h, border, depth;
+    BOOL is_window;
+
+    X11DRV_expect_error( gdi_display, format_error, NULL );
+    is_window = XGetWindowAttributes( gdi_display, drawable, &attr );
+    if (X11DRV_check_error()) is_window = FALSE;
+    if (is_window) return pXRenderFindVisualFormat( gdi_display, attr.visual );
+    if (!XGetGeometry( gdi_display, drawable, &root, &x, &y, &w, &h, &border, &depth )) return NULL;
+    if (depth == 32 && argb_visual.visual) return pXRenderFindVisualFormat( gdi_display, argb_visual.visual );
+    if (depth == default_visual.depth) return pXRenderFindVisualFormat( gdi_display, default_visual.visual );
+    return NULL;
+}
+
+BOOL xrender_copy_area( Drawable src, Drawable dst, Region clip, int src_x, int src_y, int dst_x, int dst_y,
+                        unsigned int width, unsigned int height )
+{
+    XRenderPictureAttributes pa;
+    XRenderPictFormat *src_format, *dst_format;
+    Picture src_pict, dst_pict;
+
+    if (!xrender_up) return FALSE;
+    if (!(src_format = format_for_drawable( src )) || !(dst_format = format_for_drawable( dst ))) return FALSE;
+    pa.subwindow_mode = IncludeInferiors;
+    /* either may go away meanwhile (another process's window): no error that
+     * would end the process */
+    X11DRV_expect_error( gdi_display, format_error, NULL );
+    src_pict = pXRenderCreatePicture( gdi_display, src, src_format, CPSubwindowMode, &pa );
+    dst_pict = pXRenderCreatePicture( gdi_display, dst, dst_format, 0, &pa );
+    if (clip) pXRenderSetPictureClipRegion( gdi_display, dst_pict, clip );
+    pXRenderComposite( gdi_display, PictOpSrc, src_pict, 0, dst_pict, src_x, src_y, 0, 0,
+                       dst_x, dst_y, width, height );
+    pXRenderFreePicture( gdi_display, src_pict );
+    pXRenderFreePicture( gdi_display, dst_pict );
+    XSync( gdi_display, False );
+    if (X11DRV_check_error())
+    {
+        WARN( "copy %lx -> %lx failed\n", src, dst );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* the frame in SRC put into WINDOW at RECT, clipped by REGION (relative to RECT's
+ * corner; 0: none) -- xrender_copy_area with a GDI region */
+BOOL xrender_copy_frame( Drawable src, Window window, const RECT *rect, HRGN region )
+{
+    Region clip = 0;
+    RGNDATA *data;
+    DWORD size, i;
+    BOOL ret;
+
+    if (region && (size = NtGdiGetRegionData( region, 0, NULL )) && (data = malloc( size )))
+    {
+        if (NtGdiGetRegionData( region, size, data ) && (clip = XCreateRegion()))
+        {
+            const RECT *r = (const RECT *)data->Buffer;
+            for (i = 0; i < data->rdh.nCount; i++)
+            {
+                XRectangle xr;
+                xr.x = r[i].left + rect->left;
+                xr.y = r[i].top + rect->top;
+                xr.width = r[i].right - r[i].left;
+                xr.height = r[i].bottom - r[i].top;
+                XUnionRectWithRegion( &xr, clip, clip );
+            }
+        }
+        free( data );
+    }
+    ret = xrender_copy_area( src, window, clip, 0, 0, rect->left, rect->top,
+                             rect->right - rect->left, rect->bottom - rect->top );
+    if (clip) XDestroyRegion( clip );
+    return ret;
+}
+
 #else /* SONAME_LIBXRENDER */
 
+BOOL xrender_copy_frame( Drawable src, Window window, const RECT *rect, HRGN region )
+{
+    return FALSE;
+}
+
 const struct gdi_dc_funcs *X11DRV_XRender_Init(void)
 {
     TRACE("XRender support not compiled in.\n");
     return NULL;
 }
 
+BOOL xrender_copy_area( Drawable src, Drawable dst, Region clip, int src_x, int src_y, int dst_x, int dst_y,
+                        unsigned int width, unsigned int height )
+{
+    return FALSE;
+}
+
 #endif /* SONAME_LIBXRENDER */
