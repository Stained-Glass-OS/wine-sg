 extern struct opengl_funcs *get_glx_driver(UINT);
 extern UINT X11DRV_VulkanInit( UINT, void *, const struct vulkan_driver_funcs ** );
@@ -407,6 +410,7 @@ struct x11drv_escape_set_drawable
     Drawable                 drawable;     /* X drawable */
