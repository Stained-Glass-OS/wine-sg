From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: a folder's background menu has the programs' verbs and handlers; %V and %W (7503)

Right-clicking the empty part of a folder or of the desktop gave only
shell32's own items. As Windows, the menu now has the verbs and context
menu handlers registered for Directory\Background (and DesktopBackground on
the desktop) -- "Open with Code", "Git Bash Here", "Browse path with
PeaZip", TortoiseGit -- with cascades, before New. A verb runs on the
folder, in the folder; a handler is initialized with the folder and no
items. The New menu handler Directory\Background registers is the menu's
own New, not added twice. ShellExecute's command lines take %V/%v (the item's
path, a folder's for its background: Git's "--cd=%v.") and %W (its folder);
they were left as text.
---
diff --git a/dlls/shell32/shlexec.c b/dlls/shell32/shlexec.c
index 947f2e4..fb35252 100644
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -277,6 +277,33 @@ static BOOL SHELL_ArgifyW(WCHAR* out, int len, const WCHAR* fmt, const WCHAR* lp
 		found_p1 = TRUE;
                 break;
 
+#ifndef SG_MUTANT_NO_PERCENT_V
+            /* Stained Glass OS: %V is the item's path as it is (a folder's for a folder's
+             * background: "Browse path with PeaZip", Git's "--cd=%v."), %W its folder */
+            case 'v':
+            case 'V':
+            case 'w':
+            case 'W':
+                if (lpFile) {
+                    WCHAR dir[MAX_PATH];
+                    cmd = lpFile;
+                    if (*fmt == 'w' || *fmt == 'W')
+                    {
+                        lstrcpynW(dir, lpFile, ARRAY_SIZE(dir));
+                        PathRemoveFileSpecW(dir);
+                        cmd = dir;
+                    }
+                    used += lstrlenW(cmd);
+                    if (used < len)
+                    {
+                        lstrcpyW(res, cmd);
+                        res += lstrlenW(cmd);
+                    }
+                }
+                found_p1 = TRUE;
+                break;
+#endif
+
             case 'i':
             case 'I':
 		if (pidl) {
diff --git a/dlls/shell32/shlview_cmenu.c b/dlls/shell32/shlview_cmenu.c
index 634ddee..883a671 100644
--- a/dlls/shell32/shlview_cmenu.c
+++ b/dlls/shell32/shlview_cmenu.c
@@ -308,6 +308,9 @@ static void ext_add_from(ContextMenu *This, const WCHAR *type, HMENU hmenu, UINT
         if (RegGetValueW(key, name, NULL, RRF_RT_REG_SZ, NULL, clsid_str, &size) || clsid_str[0] != '{')
             lstrcpynW(clsid_str, name, ARRAY_SIZE(clsid_str));
         if (FAILED(CLSIDFromString(clsid_str, &clsid)) || ext_blocked(clsid_str)) continue;
+        /* the background menu's New is the menu's own (Directory\\Background registers the New
+         * menu handler for it, as Windows) */
+        if (IsEqualCLSID(&clsid, &CLSID_NewMenu)) continue;
         for (j = 0; j < This->ext_count; j++)
         {
             IPersist *persist;
@@ -2390,6 +2393,128 @@ static void DoNewType(ContextMenu *This, IShellView *view, int index)
     }
 }
 
+/* Stained Glass OS: the folder's background menu has the programs' verbs and handlers for it,
+ * as Windows: Directory\\Background (and DesktopBackground on the desktop) -- "Open with Code",
+ * "Git Bash Here", "Browse path with PeaZip" -- before New. */
+static const WCHAR *bg_types[] = { L"Directory\\Background", L"DesktopBackground" };
+
+static void bg_build(ContextMenu *This)
+{
+    IPersistFolder2 *pf;
+    unsigned int i;
+
+    for (i = 0; i < This->verb_count; ++i)
+    {
+        free(This->verbs[i].desc);
+        free(This->verbs[i].verb);
+        free(This->verbs[i].klass);
+    }
+    free(This->verbs);
+    This->verbs = NULL;
+    This->verb_count = 0;
+    if (!This->pidl && This->parent &&
+        SUCCEEDED(IShellFolder_QueryInterface(This->parent, &IID_IPersistFolder2, (void **)&pf)))
+    {
+        IPersistFolder2_GetCurFolder(pf, &This->pidl);
+        IPersistFolder2_Release(pf);
+    }
+    if (!This->pidl) return;
+    for (i = 0; i < (This->desktop ? 2 : 1); i++) add_class_verbs(This, bg_types[i], FALSE);
+}
+
+static UINT bg_add_verbs_and_handlers(ContextMenu *This, HMENU hmenu, UINT index, UINT first, UINT last, UINT flags)
+{
+    MENUITEMINFOW mi;
+    HMENU newmenu = find_submenu_of(hmenu, first - FCIDM_BASE + FCIDM_SHVIEW_NEWFOLDER);
+    UINT pos = index, count = GetMenuItemCount(hmenu), i, start, next = EXT_ID_OFFSET, top = 0;
+
+#ifdef SG_MUTANT_NO_BACKGROUND_VERBS
+    return 0;
+#endif
+    if (flags & CMF_DEFAULTONLY) return 0;
+    for (i = 0; i < This->ext_count; i++) IContextMenu_Release(This->ext[i].cm);
+    This->ext_count = 0;
+    bg_build(This);
+    if (!This->pidl) return 0;
+    /* before New (its separator above it), else at the end */
+    if (newmenu)
+        for (i = 0; i < count; i++)
+            if (GetSubMenu(hmenu, i) == newmenu) { pos = i; break; }
+    if (!newmenu || i == count) pos = count;
+    else if (pos && (GetMenuState(hmenu, pos - 1, MF_BYPOSITION) & MF_SEPARATOR)) pos--;
+    start = pos;
+
+    for (i = 0; i < This->verb_count; ++i)
+    {
+        const struct verb *verb = &This->verbs[i];
+        HMENU target = hmenu;
+        UINT at;
+
+        if (verb->extended && !(flags & CMF_EXTENDEDVERBS)) continue;
+        if (first + VERB_ID_OFFSET + i > last) break;
+        if (verb->parent >= 0)
+        {
+            mi.cbSize = sizeof(mi);
+            mi.fMask = MIIM_SUBMENU;
+            if (!GetMenuItemInfoW(hmenu, first + VERB_ID_OFFSET + verb->parent, FALSE, &mi) || !mi.hSubMenu) continue;
+            target = mi.hSubMenu;
+            at = GetMenuItemCount(target);
+        }
+        else at = pos++;
+        mi.cbSize = sizeof(mi);
+        mi.fMask = MIIM_ID | MIIM_FTYPE | MIIM_STATE | MIIM_STRING;
+        mi.dwTypeData = verb->desc;
+        mi.fState = MFS_ENABLED;
+        mi.wID = first + VERB_ID_OFFSET + i;
+        mi.fType = MFT_STRING;
+        if (verb->cascade)
+        {
+            mi.fMask |= MIIM_SUBMENU;
+            mi.hSubMenu = CreatePopupMenu();
+        }
+        InsertMenuItemW(target, at, MF_BYPOSITION, &mi);
+        top = max(top, mi.wID + 1);
+    }
+    if (first + EXT_ID_OFFSET <= last)
+    {
+        UINT ext_last = min(last, first + EXT_ID_LAST);
+        for (i = 0; i < (This->desktop ? 2 : 1); i++)
+            ext_add_from(This, bg_types[i], hmenu, &pos, first, ext_last, flags, NULL, &next);
+        if (next > EXT_ID_OFFSET) top = max(top, first + next);
+    }
+    if (pos > start)
+    {
+        mi.cbSize = sizeof(mi);
+        mi.fMask = MIIM_FTYPE;
+        mi.fType = MFT_SEPARATOR;
+        InsertMenuItemW(hmenu, start, MF_BYPOSITION, &mi);
+    }
+    return top;
+}
+
+/* a background verb runs on the folder, in the folder */
+static void bg_execute_verb(ContextMenu *This, HWND hwnd, const struct verb *entry)
+{
+    SHELLEXECUTEINFOW info = { sizeof(info) };
+    WCHAR dir[MAX_PATH];
+    HKEY store = NULL;
+
+    if (entry->cascade || !This->pidl) return;
+    if (entry->store && RegOpenKeyExW(HKEY_LOCAL_MACHINE,
+            L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\CommandStore", 0, KEY_READ, &store))
+        return;
+    info.fMask = SEE_MASK_IDLIST | (store ? SEE_MASK_CLASSKEY : SEE_MASK_CLASSNAME);
+    info.lpIDList = This->pidl;
+    info.lpClass = entry->klass;
+    info.hkeyClass = store;
+    if (SHGetPathFromIDListW(This->pidl, dir)) info.lpDirectory = dir;
+    info.hwnd = hwnd;
+    info.nShow = SW_SHOWNORMAL;
+    info.lpVerb = entry->verb;
+    ShellExecuteExW(&info);
+    if (store) RegCloseKey(store);
+}
+
 static HRESULT WINAPI BackgroundMenu_QueryContextMenu(
 	IContextMenu3 *iface,
 	HMENU hMenu,
@@ -2433,6 +2558,10 @@ static HRESULT WINAPI BackgroundMenu_QueryContextMenu(
             UINT top = add_new_types( hMenu, idCmdFirst - FCIDM_BASE, idCmdLast );
             if (top > idMax) idMax = top;
         }
+        {
+            UINT top = bg_add_verbs_and_handlers( This, hMenu, indexMenu, idCmdFirst, idCmdLast, uFlags );
+            if (top > idMax) idMax = top;
+        }
         /* The submenus got no ID: a command ID of the menu is what the caller
          * and IContextMenu clients expect of every item (between idCmdFirst and
          * the returned maximum). Give each one an ID after the last command's,
@@ -2539,6 +2668,43 @@ static HRESULT WINAPI BackgroundMenu_InvokeCommand(
 	    IShellView_GetWindow(view, &hWnd);
     }
 
+    if (!HIWORD(lpcmi->lpVerb))
+    {
+        UINT id = LOWORD(lpcmi->lpVerb), own;
+        struct ext_handler *ext;
+
+        if ((ext = ext_for(This, id, &own)))
+        {
+            CMINVOKECOMMANDINFOEX ici;
+            memset(&ici, 0, sizeof(ici));
+            memcpy(&ici, lpcmi, min(lpcmi->cbSize, sizeof(ici)));
+            ici.lpVerb = MAKEINTRESOURCEA(own);
+            if (ici.cbSize >= sizeof(CMINVOKECOMMANDINFOEX)) ici.lpVerbW = (LPCWSTR)MAKEINTRESOURCEW(own);
+            if (view) IShellView_Release(view);
+            return IContextMenu_InvokeCommand(ext->cm, (CMINVOKECOMMANDINFO *)&ici);
+        }
+        if (id >= VERB_ID_OFFSET && id - VERB_ID_OFFSET < This->verb_count)
+        {
+            bg_execute_verb(This, lpcmi->hwnd, &This->verbs[id - VERB_ID_OFFSET]);
+            if (view) IShellView_Release(view);
+            return S_OK;
+        }
+    }
+    else
+    {
+        WCHAR verbW[128];
+        unsigned int i;
+
+        MultiByteToWideChar(CP_ACP, 0, lpcmi->lpVerb, -1, verbW, ARRAY_SIZE(verbW));
+        for (i = 0; i < This->verb_count; i++)
+        {
+            if (wcsicmp(This->verbs[i].verb, verbW) || This->verbs[i].cascade) continue;
+            bg_execute_verb(This, lpcmi->hwnd, &This->verbs[i]);
+            if (view) IShellView_Release(view);
+            return S_OK;
+        }
+    }
+
     if(HIWORD(lpcmi->lpVerb))
     {
         TRACE("%s\n", debugstr_a(lpcmi->lpVerb));
@@ -2625,6 +2791,21 @@ static HRESULT WINAPI BackgroundMenu_GetCommandString(
 
     TRACE("(%p)->(idcom=%Ix flags=%x %p name=%p len=%x)\n",This, idCommand, uFlags, lpReserved, lpszName, uMaxNameLen);
 
+    if (!HIWORD(idCommand))
+    {
+        UINT own;
+        struct ext_handler *ext = ext_for(This, idCommand, &own);
+        if (ext) return IContextMenu_GetCommandString(ext->cm, own, uFlags, lpReserved, lpszName, uMaxNameLen);
+        if ((uFlags == GCS_VERBA || uFlags == GCS_VERBW) && idCommand >= VERB_ID_OFFSET &&
+            idCommand - VERB_ID_OFFSET < This->verb_count)
+        {
+            const WCHAR *name = This->verbs[idCommand - VERB_ID_OFFSET].verb;
+            if (uFlags == GCS_VERBA) WideCharToMultiByte(CP_ACP, 0, name, -1, lpszName, uMaxNameLen, NULL, NULL);
+            else lstrcpynW((WCHAR *)lpszName, name, uMaxNameLen);
+            return S_OK;
+        }
+    }
+
     switch (uFlags)
     {
     case GCS_HELPTEXTA:
