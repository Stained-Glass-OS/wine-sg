+static HRESULT WINAPI results_folder_EnumObjects(IShellFolder2 *iface, HWND hwnd, DWORD flags, IEnumIDList **out)
+{
+    results_folder *This = impl_from_IShellFolder2(iface);
+    IEnumIDListImpl *list;
+    UINT i;
+
+    TRACE("(%p)->(%p, %#lx, %p)\n", This, hwnd, flags, out);
+
+    if (!out) return E_POINTER;
+    if (!(list = IEnumIDList_Constructor())) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++)
+    {
+        const struct result_item *item = &This->items[i];
+        PCUITEMID_CHILD child;
+        IShellFolder *parent;
+        SFGAOF attrs = SFGAO_FOLDER;
+        BOOL is_folder;
+
+        /* the enumeration flags choose between folders and non-folders as for any other folder */
+        if (flags & (SHCONTF_FOLDERS | SHCONTF_NONFOLDERS))
+        {
+            is_folder = FALSE;
+            if (SUCCEEDED(item_parent(item, &IID_IShellFolder, (void **)&parent, &child)))
+            {
+                if (SUCCEEDED(IShellFolder_GetAttributesOf(parent, 1, &child, &attrs))) is_folder = !!(attrs & SFGAO_FOLDER);
+                IShellFolder_Release(parent);
+            }
+            if (is_folder ? !(flags & SHCONTF_FOLDERS) : !(flags & SHCONTF_NONFOLDERS)) continue;
+        }
+        AddToEnumList(list, make_child(item->id));
+    }
+    *out = &list->IEnumIDList_iface;
+    return S_OK;
+}
