+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+#define RESULT_SIG 0x5253  /* "SR" */
+
+#pragma pack(push, 1)
+typedef struct
+{
+    USHORT cb;
+    USHORT sig;
+    DWORD id;
+    USHORT terminator;
+} result_pidl;
+#pragma pack(pop)
+
+struct result_item
+{
+    DWORD id;
+    PIDLIST_ABSOLUTE pidl;
+};
+
+typedef struct
+{
+    IShellFolder2 IShellFolder2_iface;
+    IResultsFolder IResultsFolder_iface;
+    LONG ref;
+    struct result_item *items;
+    UINT count, alloc;
+    DWORD next_id;
+    results_changed_cb changed;
+    void *context;
+} results_folder;
+
+static inline results_folder *impl_from_IShellFolder2(IShellFolder2 *iface)
+{
+    return CONTAINING_RECORD(iface, results_folder, IShellFolder2_iface);
+}
+
+static inline results_folder *impl_from_IResultsFolder(IResultsFolder *iface)
+{
+    return CONTAINING_RECORD(iface, results_folder, IResultsFolder_iface);
+}
+
+static const IShellFolder2Vtbl results_folder_vtbl;
+static const IResultsFolderVtbl results_vtbl;
+
+static LPITEMIDLIST make_child(DWORD id)
+{
+    result_pidl *p = SHAlloc(sizeof(*p));
+
+    if (!p) return NULL;
+    p->cb = sizeof(*p) - sizeof(USHORT);
+    p->sig = RESULT_SIG;
+    p->id = id;
+    p->terminator = 0;
+    return (LPITEMIDLIST)p;
+}
+
+static const struct result_item *find_child(results_folder *This, LPCITEMIDLIST child)
+{
+    const result_pidl *p = (const result_pidl *)child;
+    UINT i;
+
+    if (!child || p->cb != sizeof(*p) - sizeof(USHORT) || p->sig != RESULT_SIG) return NULL;
+    for (i = 0; i < This->count; i++)
+        if (This->items[i].id == p->id) return &This->items[i];
+    return NULL;
+}
+
+static void notify_changed(results_folder *This)
+{
+#ifdef SG_MUTANT_RF_NOREFRESH
+    return;
+#endif
+    if (This->changed) This->changed(This->context);
+}
+
+/* the folder an item lives in and the id inside it; *parent is released by the caller */
+static HRESULT item_parent(const struct result_item *item, REFIID riid, void **parent, PCUITEMID_CHILD *child)
+{
+    return SHBindToParent(item->pidl, riid, parent, child);
+}
+
+static HRESULT strret_to_wstr(STRRET *ret, PCUITEMID_CHILD child)
+{
+    WCHAR *str;
+    HRESULT hr;
+
+    if (ret->uType == STRRET_WSTR) return S_OK;
+    if (FAILED(hr = StrRetToStrW(ret, child, &str))) return hr;
+    ret->uType = STRRET_WSTR;
+    ret->pOleStr = str;
+    return S_OK;
+}
+
+static HRESULT WINAPI results_folder_QueryInterface(IShellFolder2 *iface, REFIID riid, void **ppv)
+{
+    results_folder *This = impl_from_IShellFolder2(iface);
+
+    TRACE("(%p)->(%s, %p)\n", This, shdebugstr_guid(riid), ppv);
+
+    *ppv = NULL;
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IShellFolder) || IsEqualIID(riid, &IID_IShellFolder2))
+        *ppv = &This->IShellFolder2_iface;
+    else if (IsEqualIID(riid, &IID_IResultsFolder))
+        *ppv = &This->IResultsFolder_iface;
+    else
+        return E_NOINTERFACE;
+    IUnknown_AddRef((IUnknown *)*ppv);
+    return S_OK;
+}
+
+static ULONG WINAPI results_folder_AddRef(IShellFolder2 *iface)
+{
+    return InterlockedIncrement(&impl_from_IShellFolder2(iface)->ref);
+}
