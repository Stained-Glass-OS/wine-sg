+static ULONG WINAPI results_folder_Release(IShellFolder2 *iface)
+{
+    results_folder *This = impl_from_IShellFolder2(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    UINT i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) ILFree(This->items[i].pidl);
+        free(This->items);
+        free(This);
+    }
+    return ref;
+}
