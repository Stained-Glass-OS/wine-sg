+    else if (
+#ifdef SG_MUTANT_RF_HEADER
+        TRUE ||
+#endif
+        FAILED(template_folder(This, &parent)))
+    {
+        /* nothing in the folder: a single column */
+        if (column) return E_FAIL;
+        details->fmt = LVCFMT_LEFT;
+        details->cxChar = 30;
+        return SHStrDupW(L"Name", &details->str.pOleStr) == S_OK ? (details->str.uType = STRRET_WSTR, S_OK) : E_OUTOFMEMORY;
+    }
+    hr = IShellFolder2_GetDetailsOf(parent, child, column, details);
+    if (SUCCEEDED(hr)) hr = strret_to_wstr(&details->str, child);
+    IShellFolder2_Release(parent);
