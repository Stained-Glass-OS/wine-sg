+static HRESULT WINAPI results_folder_GetAttributesOf(IShellFolder2 *iface, UINT cidl, LPCITEMIDLIST *apidl, SFGAOF *attrs)
+{
+    results_folder *This = impl_from_IShellFolder2(iface);
+    SFGAOF result = *attrs;
+    UINT i;
+
+    TRACE("(%p)->(%u, %p, %#lx)\n", This, cidl, apidl, *attrs);
+
+    for (i = 0; i < cidl; i++)
+    {
+        const struct result_item *item = find_child(This, apidl[i]);
+        IShellFolder *parent;
+        PCUITEMID_CHILD child;
+        SFGAOF a = *attrs;
+
+#ifdef SG_MUTANT_RF_ATTRS
+        continue;
+#endif
+
+        if (!item) return E_INVALIDARG;
+        if (FAILED(item_parent(item, &IID_IShellFolder, (void **)&parent, &child))) return E_FAIL;
+        IShellFolder_GetAttributesOf(parent, 1, &child, &a);
+        IShellFolder_Release(parent);
+        result &= a;
+    }
+    *attrs = result;
+    return S_OK;
+}
