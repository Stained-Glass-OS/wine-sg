+/**************************************************************************
+ * FillFromObject: the items come from an IDataObject (shell id list format), an IShellItemArray,
+ * an IShellItem or an IShellFolder; a folder gives its children, an item that is no folder itself.
+ */
+struct pidl_array
+{
+    PIDLIST_ABSOLUTE *pidls;
+    UINT count, alloc;
+};
+
+static BOOL pidl_array_add(struct pidl_array *array, PIDLIST_ABSOLUTE pidl)
+{
+    if (array->count == array->alloc)
+    {
+        UINT n = array->alloc ? array->alloc * 2 : 16;
+        PIDLIST_ABSOLUTE *p = realloc(array->pidls, n * sizeof(*p));
+        if (!p) { ILFree(pidl); return FALSE; }
+        array->pidls = p;
+        array->alloc = n;
+    }
+    array->pidls[array->count++] = pidl;
+    return TRUE;
+}
+
+static void pidl_array_free(struct pidl_array *array)
+{
+    UINT i;
+    for (i = 0; i < array->count; i++) ILFree(array->pidls[i]);
+    free(array->pidls);
+    memset(array, 0, sizeof(*array));
+}
+
+static HRESULT add_children(struct pidl_array *array, PCIDLIST_ABSOLUTE folder_pidl, HWND hwnd)
+{
+    IShellFolder *folder;
+    IEnumIDList *list;
+    LPITEMIDLIST child;
+    HRESULT hr;
+
+    if (FAILED(hr = SHBindToObject(NULL, folder_pidl, NULL, &IID_IShellFolder, (void **)&folder))) return hr;
+    hr = IShellFolder_EnumObjects(folder, hwnd, SHCONTF_FOLDERS | SHCONTF_NONFOLDERS | SHCONTF_INCLUDEHIDDEN, &list);
+    if (SUCCEEDED(hr))
+    {
+        while (IEnumIDList_Next(list, 1, &child, NULL) == S_OK)
+        {
+            PIDLIST_ABSOLUTE abs = ILCombine(folder_pidl, child);
+            ILFree(child);
+            if (abs && !pidl_array_add(array, abs)) { hr = E_OUTOFMEMORY; break; }
+        }
+        IEnumIDList_Release(list);
+    }
+    IShellFolder_Release(folder);
+    return hr;
+}
+
+static HRESULT gather_from_data_object(IDataObject *data, struct pidl_array *array)
+{
+    FORMATETC fmt = { 0, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    STGMEDIUM medium;
+    HRESULT hr;
+
+    fmt.cfFormat = RegisterClipboardFormatW(CFSTR_SHELLIDLISTW);
+    if (FAILED(hr = IDataObject_GetData(data, &fmt, &medium))) return hr;
+    {
+        CIDA *cida = GlobalLock(medium.hGlobal);
+        UINT i;
+
+        if (cida)
+        {
+            LPCITEMIDLIST folder = (LPCITEMIDLIST)((BYTE *)cida + cida->aoffset[0]);
+            for (i = 0; i < cida->cidl; i++)
+            {
+                LPCITEMIDLIST child = (LPCITEMIDLIST)((BYTE *)cida + cida->aoffset[i + 1]);
+                PIDLIST_ABSOLUTE abs = ILCombine(folder, child);
+                if (abs && !pidl_array_add(array, abs)) { hr = E_OUTOFMEMORY; break; }
+            }
+            GlobalUnlock(medium.hGlobal);
+        }
+        else hr = E_FAIL;
+    }
+    ReleaseStgMedium(&medium);
+    return hr;
+}
+
+static HRESULT gather_items(ExplorerBrowserImpl *This, IUnknown *punk, struct pidl_array *array)
+{
+    IDataObject *data;
+    IShellItemArray *items;
+    IShellItem *item;
+    IShellFolder *folder;
+    PIDLIST_ABSOLUTE pidl;
+    HRESULT hr;
+
+    if (SUCCEEDED(IUnknown_QueryInterface(punk, &IID_IDataObject, (void **)&data)))
+    {
+        hr = gather_from_data_object(data, array);
+        IDataObject_Release(data);
+        return hr;
+    }
+    if (SUCCEEDED(IUnknown_QueryInterface(punk, &IID_IShellItemArray, (void **)&items)))
+    {
+        DWORD i, count = 0;
+
+        hr = IShellItemArray_GetCount(items, &count);
+        for (i = 0; SUCCEEDED(hr) && i < count; i++)
+        {
+            if (SUCCEEDED(IShellItemArray_GetItemAt(items, i, &item)))
+            {
+                if (SUCCEEDED(SHGetIDListFromObject((IUnknown *)item, &pidl)) && !pidl_array_add(array, pidl))
+                    hr = E_OUTOFMEMORY;
+                IShellItem_Release(item);
+            }
+        }
+        IShellItemArray_Release(items);
+        return hr;
+    }
+    if (SUCCEEDED(IUnknown_QueryInterface(punk, &IID_IShellItem, (void **)&item)))
+    {
+        SFGAOF attrs = 0;
+
+        hr = SHGetIDListFromObject((IUnknown *)item, &pidl);
+        if (SUCCEEDED(hr))
+        {
+            IShellItem_GetAttributes(item, SFGAO_FOLDER, &attrs);
+#ifdef SG_MUTANT_EB_ITEMFOLDER
+            attrs = 0;
+#endif
+            if (attrs & SFGAO_FOLDER) { hr = add_children(array, pidl, This->hwnd_main); ILFree(pidl); }
+            else if (!pidl_array_add(array, pidl)) hr = E_OUTOFMEMORY;
+        }
+        IShellItem_Release(item);
+        return hr;
+    }
+    if (SUCCEEDED(IUnknown_QueryInterface(punk, &IID_IShellFolder, (void **)&folder)))
+    {
+        hr = SHGetIDListFromObject((IUnknown *)folder, &pidl);
+        if (SUCCEEDED(hr)) { hr = add_children(array, pidl, This->hwnd_main); ILFree(pidl); }
+        IShellFolder_Release(folder);
+        return hr;
+    }
+    return E_NOINTERFACE;
+}
+
+static void results_changed(void *context)
+{
+    ExplorerBrowserImpl *This = context;
+
+    if (!This->fill_depth && This->psv) IShellView_Refresh(This->psv);
+}
