+PIDLIST_ABSOLUTE ResultsFolder_ItemPidl(IShellFolder *folder, PCUITEMID_CHILD child)
+{
+    results_folder *This;
+    const struct result_item *item;
+
+    if (!folder || folder->lpVtbl != (const IShellFolderVtbl *)&results_folder_vtbl) return NULL;
+    This = impl_from_IShellFolder2((IShellFolder2 *)folder);
+    return (item = find_child(This, child)) ? item->pidl : NULL;
+}
+
+PITEMID_CHILD ResultsFolder_FindChild(IShellFolder *folder, PCIDLIST_ABSOLUTE pidl)
+{
+    results_folder *This;
+    UINT i;
+
+    if (!folder || folder->lpVtbl != (const IShellFolderVtbl *)&results_folder_vtbl) return NULL;
+    This = impl_from_IShellFolder2((IShellFolder2 *)folder);
+    for (i = 0; i < This->count; i++)
+        if (ILIsEqual(This->items[i].pidl, pidl)) return make_child(This->items[i].id);
+    return NULL;
+}
