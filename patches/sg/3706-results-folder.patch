+static HRESULT WINAPI results_AddIDList(IResultsFolder *iface, PCIDLIST_ABSOLUTE pidl, PITEMID_CHILD *added)
+{
+    results_folder *This = impl_from_IResultsFolder(iface);
+    PIDLIST_ABSOLUTE copy;
+    UINT i;
+    DWORD id;
+
+    TRACE("(%p)->(%p, %p)\n", This, pidl, added);
+
+    if (added) *added = NULL;
+    if (!pidl || _ILIsDesktop(pidl)) return E_INVALIDARG;
+    /* an item is in the folder once */
+#ifndef SG_MUTANT_RF_DEDUP
+    for (i = 0; i < This->count; i++)
+        if (ILIsEqual(This->items[i].pidl, pidl))
+        {
+            id = This->items[i].id;
+            goto have_id;
+        }
+#endif
+    if (This->count == This->alloc)
+    {
+        UINT n = This->alloc ? This->alloc * 2 : 16;
+        struct result_item *items = realloc(This->items, n * sizeof(*items));
+        if (!items) return E_OUTOFMEMORY;
+        This->items = items;
+        This->alloc = n;
+    }
+    if (!(copy = ILClone(pidl))) return E_OUTOFMEMORY;
+    id = ++This->next_id;
+    This->items[This->count].id = id;
+    This->items[This->count].pidl = copy;
+    This->count++;
+    notify_changed(This);
+have_id:
+    if (added) *added = make_child(id);
+    return S_OK;
+}
