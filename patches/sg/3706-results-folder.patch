+    if(FAILED(hr))
+    {
+        pidl_array_free(&items);
+        pidl_array_free(&selected);
+        return hr;
+    }
+
+    if(!This->results)
+    {
+        LPITEMIDLIST desktop;
+
+        hr = ResultsFolder_Create(results_changed, This, &IID_IShellFolder2, (void **)&This->results);
+        if(FAILED(hr)) goto done;
+        This->fill_depth++;
+        hr = create_view_for_folder(This, (IShellFolder *)This->results);
+        This->fill_depth--;
+        if(FAILED(hr))
+        {
+            IShellFolder2_Release(This->results);
+            This->results = NULL;
+            goto done;
+        }
+        This->in_results = TRUE;
+        /* the browser is somewhere no id list names: a location the navigation compares with
+         * nothing, and one to which EBO_NAVIGATEONCE keeps it */
+        desktop = _ILCreateDesktop();
+#ifdef SG_MUTANT_EB_NAVONCE
+        ILFree(desktop); desktop = NULL;
+#endif
+        ILFree(This->current_pidl);
+        This->current_pidl = desktop;
+    }
+
+    IShellFolder2_QueryInterface(This->results, &IID_IResultsFolder, (void **)&results);
+    This->fill_depth++;
+    for(i = 0; i < items.count; i++)
+        IResultsFolder_AddIDList(results, items.pidls[i], NULL);
+    This->fill_depth--;
+    IResultsFolder_Release(results);
+    if(This->psv)
+    {
+        IShellView_Refresh(This->psv);
+#ifdef SG_MUTANT_EB_FILL_SELECT
+        selected.count = 0;
+#endif
+        for(i = 0; i < selected.count; i++)
+        {
+            PITEMID_CHILD child = ResultsFolder_FindChild((IShellFolder *)This->results, selected.pidls[i]);
+            if(child)
+            {
+                IShellView_SelectItem(This->psv, child, SVSI_SELECT | SVSI_ENSUREVISIBLE | (i ? 0 : SVSI_FOCUSED));
+                ILFree(child);
+            }
+        }
+    }
+    hr = S_OK;
+done:
+    pidl_array_free(&items);
+    pidl_array_free(&selected);
+    return hr;
 }
 
