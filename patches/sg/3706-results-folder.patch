+static HRESULT WINAPI results_folder_GetUIObjectOf(IShellFolder2 *iface, HWND hwnd, UINT cidl, LPCITEMIDLIST *apidl,
+        REFIID riid, UINT *reserved, void **ppv)
+{
+    results_folder *This = impl_from_IShellFolder2(iface);
+    PCUITEMID_CHILD *children;
+    LPCITEMIDLIST *absolute;
+    IShellFolder *parent = NULL, *first_parent = NULL;
+    HRESULT hr = E_NOINTERFACE;
+    BOOL same = TRUE;
+    UINT i;
+
+    TRACE("(%p)->(%p, %u, %p, %s, %p)\n", This, hwnd, cidl, apidl, shdebugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!cidl) return E_INVALIDARG;
+    children = calloc(cidl, sizeof(*children));
+    absolute = calloc(cidl, sizeof(*absolute));
+    if (!children || !absolute)
+    {
+        free(children);
+        free(absolute);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < cidl; i++)
+    {
+        const struct result_item *item = find_child(This, apidl[i]);
+        IShellFolder *p;
+
+        if (!item || FAILED(item_parent(item, &IID_IShellFolder, (void **)&p, &children[i])))
+        {
+            hr = E_INVALIDARG;
+            goto done;
+        }
+        absolute[i] = item->pidl;
+        if (!first_parent) first_parent = p;
+        else
+        {
+            LPITEMIDLIST a = ILClone(absolute[0]), b = ILClone(item->pidl);
+            ILRemoveLastID(a);
+            ILRemoveLastID(b);
+            if (!ILIsEqual(a, b)) same = FALSE;
+            ILFree(a);
+            ILFree(b);
+            IShellFolder_Release(p);
+        }
+    }
+#ifdef SG_MUTANT_RF_DATAOBJ
+    if (IsEqualIID(riid, &IID_IDataObject)) { hr = E_NOINTERFACE; goto done; }
+#endif
+    if (IsEqualIID(riid, &IID_IDataObject))
+    {
+        /* the items can come from anywhere: the object names them from the desktop */
+        LPITEMIDLIST root = _ILCreateDesktop();
+        IDataObject *obj = IDataObject_Constructor(hwnd, root, absolute, cidl);
+        ILFree(root);
+        if (obj)
+        {
+            *ppv = obj;
+            hr = S_OK;
+        }
+        else hr = E_OUTOFMEMORY;
+    }
+    else if (same)
+    {
+        parent = first_parent;
+        hr = IShellFolder_GetUIObjectOf(parent, hwnd, cidl, children, riid, reserved, ppv);
+    }
+done:
+    if (first_parent) IShellFolder_Release(first_parent);
+    free(children);
+    free(absolute);
+    return hr;
+}
