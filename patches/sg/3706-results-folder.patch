+static HRESULT WINAPI results_folder_CompareIDs(IShellFolder2 *iface, LPARAM lparam, LPCITEMIDLIST pidl1, LPCITEMIDLIST pidl2)
+{
+    results_folder *This = impl_from_IShellFolder2(iface);
+    const struct result_item *a = find_child(This, pidl1), *b = find_child(This, pidl2);
+    IShellFolder2 *parent_a, *parent_b;
+    PCUITEMID_CHILD child_a, child_b;
+    WCHAR *name_a, *name_b;
+    int cmp = 0;
+
+    TRACE("(%p)->(%#Ix, %p, %p)\n", This, lparam, pidl1, pidl2);
+
+    if (!a || !b) return E_INVALIDARG;
+    if (a == b) return MAKE_HRESULT(SEVERITY_SUCCESS, 0, 0);
+
+    /* two items of one folder are compared by that folder, for any column */
+    if (SUCCEEDED(item_parent(a, &IID_IShellFolder2, (void **)&parent_a, &child_a)))
+    {
+        if (SUCCEEDED(item_parent(b, &IID_IShellFolder2, (void **)&parent_b, &child_b)))
+        {
+            LPITEMIDLIST up_a = ILClone(a->pidl), up_b = ILClone(b->pidl);
+            BOOL same;
+
+            ILRemoveLastID(up_a);
+            ILRemoveLastID(up_b);
+            same = ILIsEqual(up_a, up_b);
+            ILFree(up_a);
+            ILFree(up_b);
+            if (same)
+            {
+                HRESULT hr = IShellFolder2_CompareIDs(parent_a, lparam, child_a, child_b);
+                IShellFolder2_Release(parent_b);
+                IShellFolder2_Release(parent_a);
+                if (SUCCEEDED(hr) && (short)HRESULT_CODE(hr)) return hr;
+                goto by_name;
+            }
+            IShellFolder2_Release(parent_b);
+        }
+        IShellFolder2_Release(parent_a);
+    }
+by_name:
+    if (SUCCEEDED(item_display_name(a, SHGDN_INFOLDER, &name_a)))
+    {
+        if (SUCCEEDED(item_display_name(b, SHGDN_INFOLDER, &name_b)))
+        {
+            cmp = lstrcmpiW(name_a, name_b);
+            CoTaskMemFree(name_b);
+        }
+        CoTaskMemFree(name_a);
+    }
+    if (!cmp) cmp = a->id < b->id ? -1 : a->id > b->id;
+    return MAKE_HRESULT(SEVERITY_SUCCESS, 0, (USHORT)(short)(cmp < 0 ? -1 : cmp > 0));
+}
