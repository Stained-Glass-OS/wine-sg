+static HRESULT WINAPI results_folder_SetNameOf(IShellFolder2 *iface, HWND hwnd, LPCITEMIDLIST pidl, LPCOLESTR name,
+        SHGDNF flags, LPITEMIDLIST *new_pidl)
+{
+    results_folder *This = impl_from_IShellFolder2(iface);
+    const struct result_item *item = find_child(This, pidl);
+    IShellFolder *parent;
+    PCUITEMID_CHILD child;
+    LPITEMIDLIST renamed = NULL;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p, %p, %s, %#lx, %p)\n", This, hwnd, pidl, debugstr_w(name), flags, new_pidl);
+
+    if (!item) return E_INVALIDARG;
+    if (FAILED(hr = item_parent(item, &IID_IShellFolder, (void **)&parent, &child))) return hr;
+    hr = IShellFolder_SetNameOf(parent, hwnd, child, name, flags, &renamed);
+    IShellFolder_Release(parent);
+    if (SUCCEEDED(hr))
+    {
+        /* the entry now names the renamed item */
+        struct result_item *entry = (struct result_item *)item;
+        LPITEMIDLIST new_abs, up = ILClone(entry->pidl);
+
+        ILRemoveLastID(up);
+        new_abs = renamed ? ILCombine(up, renamed) : NULL;
+        ILFree(up);
+        if (new_abs)
+        {
+            ILFree(entry->pidl);
+            entry->pidl = new_abs;
+        }
+        ILFree(renamed);
+        if (new_pidl) *new_pidl = make_child(entry->id);
+    }
+    return hr;
+}
