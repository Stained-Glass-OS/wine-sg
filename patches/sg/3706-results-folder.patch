+static HRESULT WINAPI results_folder_GetDetailsOf(IShellFolder2 *iface, LPCITEMIDLIST pidl, UINT column, SHELLDETAILS *details)
+{
+    results_folder *This = impl_from_IShellFolder2(iface);
+    IShellFolder2 *parent;
+    PCUITEMID_CHILD child = NULL;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p, %u, %p)\n", This, pidl, column, details);
+
+    if (pidl)
+    {
+        const struct result_item *item = find_child(This, pidl);
+        if (!item) return E_INVALIDARG;
+        if (FAILED(hr = item_parent(item, &IID_IShellFolder2, (void **)&parent, &child))) return hr;
