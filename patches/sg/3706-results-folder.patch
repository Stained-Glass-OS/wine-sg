+        hr = gather_from_data_object(data, &selected);
+        IDataObject_Release(data);
+        if(SUCCEEDED(hr) && !selected.count)
+            hr = E_INVALIDARG;
+        if(SUCCEEDED(hr))
+        {
+            parent = ILClone(selected.pidls[0]);
+            ILRemoveLastID(parent);
+#ifdef SG_MUTANT_EB_PEERS
+            { UINT k; for (k = 0; k < selected.count; k++) pidl_array_add(&items, ILClone(selected.pidls[k])); }
+#else
+            hr = add_children(&items, parent, This->hwnd_main);
+#endif
+            ILFree(parent);
+        }
+    }
+    else
