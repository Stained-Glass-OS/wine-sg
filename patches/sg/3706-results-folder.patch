+
+    if (!item) return E_INVALIDARG;
+    if (FAILED(hr = SHGetIDListFromObject((IUnknown *)item, &pidl))) return hr;
+    hr = results_AddIDList(iface, pidl, NULL);
+    ILFree(pidl);
+    return hr;
+}
+
+static HRESULT WINAPI results_RemoveIDList(IResultsFolder *iface, PCIDLIST_ABSOLUTE pidl)
+{
+    results_folder *This = impl_from_IResultsFolder(iface);
+    UINT i;
+
+    TRACE("(%p)->(%p)\n", This, pidl);
+
+    if (!pidl) return E_INVALIDARG;
+    for (i = 0; i < This->count; i++)
+    {
+        if (!ILIsEqual(This->items[i].pidl, pidl)) continue;
+        ILFree(This->items[i].pidl);
+        memmove(&This->items[i], &This->items[i + 1], (This->count - i - 1) * sizeof(*This->items));
+        This->count--;
+        notify_changed(This);
+        return S_OK;
+    }
+    return S_FALSE;
+}
