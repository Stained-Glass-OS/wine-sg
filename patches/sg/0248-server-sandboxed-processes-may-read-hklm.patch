From: Stained Glass OS <dev@stained-glass.example>
Subject: server: sandboxed processes may read HKLM, as on Windows

A restricted token passes an access check only if its restricting SIDs are
granted access too, and an AppContainer token only through its package SIDs.
The shared prefix's HKLM DACL (administrators and SYSTEM write, users read;
0002/0024) and the display keys' DACL (0011) named neither, so a sandboxed
process -- Firefox's content processes, Chromium's renderers -- could read
nothing in HKLM: "Failed to read display config", no window class
(CreateWindow error 1411), and Firefox's tabs died ("Exiting due to channel
error"). Both DACLs now grant RESTRICTED and ALL APPLICATION PACKAGES read,
as Windows' HKLM does. Nothing gains write.

Found by the 2026-09-26 ISO QA pass. Gate: test/sandboxdesk-gate.sh (the
sandboxed child reads HKLM and sees the display).
---
--- a/server/token.c
+++ b/server/token.c
@@ -1229,16 +1229,32 @@
  * may write, everyone else may read. Per-user privacy is not this descriptor's
  * job -- HKCU gets that from being a separate hive per user.
  */
+/* Stained Glass OS (0248): sandboxes read the machine's state too. A
+ * restricted token passes an access check only if its restricting SIDs are
+ * granted access as well, and an AppContainer only through its package SIDs:
+ * Windows' HKLM grants RESTRICTED and ALL APPLICATION PACKAGES read for them.
+ * Without these, Firefox's (and every Chromium) sandboxed process could read
+ * nothing in HKLM -- not even the display configuration -- and could not make
+ * a window. */
+static const struct sid restricted_code_sid = { SID_REVISION, 1, SECURITY_NT_AUTHORITY, { SECURITY_RESTRICTED_CODE_RID } };
+#define SG_SANDBOX_READ_ACES 2
+static struct ace *sg_add_sandbox_read( struct ace *ace )
+{
+    ace = set_ace( ace_next( ace ), &restricted_code_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_READ );
+    return set_ace( ace_next( ace ), &all_app_packages_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_READ );
+}
+#define SG_SANDBOX_READ_SIZE (SG_SANDBOX_READ_ACES * sizeof(struct ace) + sid_len( &restricted_code_sid ) + sid_len( &all_app_packages_sid ))
+
 static struct acl *sg_create_system_dacl( const struct sid *user_sid )
 {
     struct sid alias_admins_sid = { SID_REVISION, 2, SECURITY_NT_AUTHORITY, { SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS }};
     int own = user_sid && !equal_sid( user_sid, &local_system_sid );
-    unsigned int count = own ? 4 : 3;
+    unsigned int count = (own ? 4 : 3) + SG_SANDBOX_READ_ACES;
     struct ace *ace;
     struct acl *dacl;
-    size_t size = sizeof(*dacl) + count * sizeof(*ace) +
+    size_t size = sizeof(*dacl) + (count - SG_SANDBOX_READ_ACES) * sizeof(*ace) +
                   sid_len( &local_system_sid ) + sid_len( &alias_admins_sid ) +
-                  sid_len( &domain_users_sid ) + (own ? sid_len( user_sid ) : 0);
+                  sid_len( &domain_users_sid ) + (own ? sid_len( user_sid ) : 0) + SG_SANDBOX_READ_SIZE;
 
     if (!(dacl = mem_alloc( size ))) return NULL;
 
@@ -1262,7 +1278,8 @@
      * generating a fresh guid and trying again -- forever, at 100% of a core,
      * with a black screen and no error anywhere. */
     if (own) ace = set_ace( ace_next( ace ), user_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
-    set_ace( ace_next( ace ), &domain_users_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_READ );
+    ace = set_ace( ace_next( ace ), &domain_users_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_READ );
+    sg_add_sandbox_read( ace );
     return dacl;
 }
 
@@ -1278,17 +1295,19 @@
     struct ace *ace;
     struct acl *dacl;
     size_t size = sizeof(*dacl) + 3 * sizeof(*ace) +
-                  sid_len( &local_system_sid ) + sid_len( &alias_admins_sid ) + sid_len( &domain_users_sid );
+                  sid_len( &local_system_sid ) + sid_len( &alias_admins_sid ) + sid_len( &domain_users_sid ) +
+                  SG_SANDBOX_READ_SIZE;
 
     if (!(dacl = mem_alloc( size ))) return NULL;
     dacl->revision = ACL_REVISION;
     dacl->pad1 = 0;
     dacl->size = size;
-    dacl->count = 3;
+    dacl->count = 3 + SG_SANDBOX_READ_ACES;
     dacl->pad2 = 0;
     ace = set_ace( ace_first( dacl ), &local_system_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
     ace = set_ace( ace_next( ace ), &alias_admins_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
-    set_ace( ace_next( ace ), &domain_users_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
+    ace = set_ace( ace_next( ace ), &domain_users_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
+    sg_add_sandbox_read( ace );
     return dacl;
 }
 
