+static void test_wsk_socket_connect(void)
+{
+    const WSK_PROVIDER_LISTEN_DISPATCH *ld;
+    const WSK_PROVIDER_CONNECTION_DISPATCH *cd;
+    struct sockaddr_in addr, listen_addr, local, remote, got;
+    static struct socket_context context;
+    struct async accept_irp;
+    WSK_SOCKET *client, *server, *listener;
+    SIZE_T done;
+    NTSTATUS status;
+    char data[16];
+
+    memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+
+    listener = create_test_socket(SOCK_STREAM, IPPROTO_TCP, WSK_FLAG_LISTEN_SOCKET);
+    ld = listener->Dispatch;
+    prepare_irp();
+    status = finish_irp(ld->WskBind(listener, (SOCKADDR *)&addr, 0, wsk_irp));
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    prepare_irp();
+    status = finish_irp(ld->WskGetLocalAddress(listener, (SOCKADDR *)&listen_addr, wsk_irp));
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK + 1);  /* 127.0.0.2: the bind must be honoured */
+
+    /* argument errors */
+    prepare_irp();
+    status = provider_npi.Dispatch->WskSocketConnect(provider_npi.Client, SOCK_STREAM, IPPROTO_TCP,
+            (SOCKADDR *)&addr, (SOCKADDR *)&listen_addr, 1, &context, NULL, NULL, NULL, NULL, wsk_irp);
+    status = finish_irp(status);
+    ok(status == STATUS_INVALID_PARAMETER, "flags: got unexpected status %#lx.\n", status);
+    prepare_irp();
+    status = provider_npi.Dispatch->WskSocketConnect(NULL, SOCK_STREAM, IPPROTO_TCP,
+            (SOCKADDR *)&addr, (SOCKADDR *)&listen_addr, 0, &context, NULL, NULL, NULL, NULL, wsk_irp);
+    ok(status == STATUS_INVALID_HANDLE, "no client: got unexpected status %#lx.\n", status);
+
+    /* create, bind and connect in one call */
+    async_init(&accept_irp);
+    status = ld->WskAccept(listener, 0, NULL, NULL, (SOCKADDR *)&local, (SOCKADDR *)&remote,
+            async_prepare(&accept_irp));
+    ok(status == STATUS_PENDING, "Got unexpected status %#lx.\n", status);
+
+    prepare_irp();
+    status = provider_npi.Dispatch->WskSocketConnect(provider_npi.Client, SOCK_STREAM, IPPROTO_TCP,
+            (SOCKADDR *)&addr, (SOCKADDR *)&listen_addr, 0, &context, NULL, NULL, NULL, NULL, wsk_irp);
+    status = finish_irp(status);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    client = (WSK_SOCKET *)wsk_irp->IoStatus.Information;
+    ok(!!client, "Got no socket.\n");
+    status = async_wait(&accept_irp, STATUS_PENDING, 5000);
+    ok(status == STATUS_SUCCESS, "accept: got unexpected status %#lx.\n", status);
+    server = (WSK_SOCKET *)accept_irp.irp->IoStatus.Information;
+    async_free(&accept_irp);
+
+    if (client && server)
+    {
+        cd = client->Dispatch;
+        memset(&got, 0, sizeof(got));
+        prepare_irp();
+        status = finish_irp(cd->WskGetRemoteAddress(client, (SOCKADDR *)&got, wsk_irp));
+        ok(status == STATUS_SUCCESS && got.sin_port == listen_addr.sin_port, "remote: status %#lx port %u.\n",
+                status, ntohs(got.sin_port));
+        memset(&got, 0, sizeof(got));
+        prepare_irp();
+        status = finish_irp(cd->WskGetLocalAddress(client, (SOCKADDR *)&got, wsk_irp));
+        ok(status == STATUS_SUCCESS && got.sin_port && got.sin_addr.s_addr == htonl(INADDR_LOOPBACK + 1),
+                "local: status %#lx port %u address %#lx.\n", status, ntohs(got.sin_port), got.sin_addr.s_addr);
+
+        status = socket_send(client, "ping", 4, &done);
+        ok(status == STATUS_SUCCESS && done == 4, "send: status %#lx, %Iu bytes.\n", status, done);
+        status = socket_receive(server, data, sizeof(data), &done, 3000);
+        ok(status == STATUS_SUCCESS && done == 4 && !memcmp(data, "ping", 4),
+                "receive: status %#lx, %Iu bytes.\n", status, done);
+    }
+    if (server) close_test_socket(server);
+    if (client) close_test_socket(client);
+    close_test_socket(listener);
+
+    /* nobody listens on the port any more */
+    prepare_irp();
+    status = provider_npi.Dispatch->WskSocketConnect(provider_npi.Client, SOCK_STREAM, IPPROTO_TCP,
+            (SOCKADDR *)&addr, (SOCKADDR *)&listen_addr, 0, &context, NULL, NULL, NULL, NULL, wsk_irp);
+    status = finish_irp(status);
+    ok(status == STATUS_CONNECTION_REFUSED, "refused: got unexpected status %#lx.\n", status);
+    ok(!wsk_irp->IoStatus.Information, "refused: got Information %#Ix.\n", wsk_irp->IoStatus.Information);
+}
+
+#define TEST_NI_NUMERICHOST 0x02
+#define TEST_NI_NUMERICSERV 0x08
+
+static void test_wsk_get_name_info(void)
+{
+    static const struct
+    {
+        BOOL v6;
+        USHORT port;
+        ULONG flags;
+        const WCHAR *node, *service;
+        NTSTATUS status;
+        ULONG node_max, service_max;
+    }
+    tests[] =
+    {
+        {FALSE, 80, TEST_NI_NUMERICHOST | TEST_NI_NUMERICSERV, L"127.0.0.1", L"80", STATUS_SUCCESS, 64, 64},
+        {FALSE, 8080, TEST_NI_NUMERICHOST | TEST_NI_NUMERICSERV, L"127.0.0.1", L"8080", STATUS_SUCCESS, 64, 64},
+        {TRUE, 443, TEST_NI_NUMERICHOST | TEST_NI_NUMERICSERV, L"::1", L"443", STATUS_SUCCESS, 64, 64},
+        {FALSE, 80, TEST_NI_NUMERICHOST | TEST_NI_NUMERICSERV, L"127.0.0.1", L"80", STATUS_BUFFER_TOO_SMALL, 8, 64},
+        {FALSE, 8080, TEST_NI_NUMERICHOST | TEST_NI_NUMERICSERV, L"127.0.0.1", L"8080", STATUS_BUFFER_TOO_SMALL, 64, 4},
+    };
+    UNICODE_STRING node, service;
+    WCHAR node_buf[64], service_buf[64];
+    NTSTATUS status;
+    unsigned int i;
+    union
+    {
+        struct sockaddr_in a4;
+        struct sockaddr_in6 a6;
+    } addr;
+    ULONG len;
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        memset(&addr, 0, sizeof(addr));
+        if (tests[i].v6)
+        {
+            addr.a6.sin6_family = AF_INET6;
+            addr.a6.sin6_port = htons(tests[i].port);
+            addr.a6.sin6_addr.u.Byte[15] = 1;
+            len = sizeof(addr.a6);
+        }
+        else
+        {
+            addr.a4.sin_family = AF_INET;
+            addr.a4.sin_port = htons(tests[i].port);
+            addr.a4.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+            len = sizeof(addr.a4);
+        }
+        node.Buffer = node_buf;
+        node.Length = 0;
+        node.MaximumLength = tests[i].node_max;
+        service.Buffer = service_buf;
+        service.Length = 0;
+        service.MaximumLength = tests[i].service_max;
+
+        prepare_irp();
+        status = provider_npi.Dispatch->WskGetNameInfo(provider_npi.Client, (SOCKADDR *)&addr, len,
+                &node, &service, tests[i].flags, NULL, NULL, wsk_irp);
+        status = finish_irp(status);
+        ok(status == tests[i].status, "%u: got unexpected status %#lx.\n", i, status);
+        if (!status)
+        {
+            ok(node.Length == wcslen(tests[i].node) * sizeof(WCHAR) && !wcscmp(node_buf, tests[i].node),
+                    "%u: got node %ls.\n", i, node_buf);
+            ok(service.Length == wcslen(tests[i].service) * sizeof(WCHAR) && !wcscmp(service_buf, tests[i].service),
+                    "%u: got service %ls.\n", i, service_buf);
+        }
+    }
+
+    /* only one of the names */
+    addr.a4.sin_family = AF_INET;
+    addr.a4.sin_port = htons(81);
+    addr.a4.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    node.Buffer = node_buf;
+    node.Length = 0;
+    node.MaximumLength = sizeof(node_buf);
+    prepare_irp();
+    status = finish_irp(provider_npi.Dispatch->WskGetNameInfo(provider_npi.Client, (SOCKADDR *)&addr,
+            sizeof(addr.a4), &node, NULL, TEST_NI_NUMERICHOST, NULL, NULL, wsk_irp));
+    ok(status == STATUS_SUCCESS && !wcscmp(node_buf, L"127.0.0.1"), "node only: status %#lx.\n", status);
+    service.Buffer = service_buf;
+    service.Length = 0;
+    service.MaximumLength = sizeof(service_buf);
+    prepare_irp();
+    status = finish_irp(provider_npi.Dispatch->WskGetNameInfo(provider_npi.Client, (SOCKADDR *)&addr,
+            sizeof(addr.a4), NULL, &service, TEST_NI_NUMERICSERV, NULL, NULL, wsk_irp));
+    ok(status == STATUS_SUCCESS && !wcscmp(service_buf, L"81"), "service only: status %#lx.\n", status);
+
+    /* invalid combinations */
+    prepare_irp();
+    status = finish_irp(provider_npi.Dispatch->WskGetNameInfo(provider_npi.Client, (SOCKADDR *)&addr,
+            sizeof(addr.a4), NULL, NULL, 0, NULL, NULL, wsk_irp));
+    ok(status == STATUS_INVALID_PARAMETER, "no names: got unexpected status %#lx.\n", status);
+    prepare_irp();
+    status = finish_irp(provider_npi.Dispatch->WskGetNameInfo(provider_npi.Client, (SOCKADDR *)&addr,
+            sizeof(addr.a4), &node, &service, TEST_NI_NUMERICHOST, NULL, (PETHREAD)0x1000, wsk_irp));
+    ok(status == STATUS_INVALID_PARAMETER, "thread without process: got unexpected status %#lx.\n", status);
+    prepare_irp();
+    status = finish_irp(provider_npi.Dispatch->WskGetNameInfo(provider_npi.Client, (SOCKADDR *)&addr,
+            sizeof(SOCKADDR_STORAGE) + 1, &node, &service, TEST_NI_NUMERICHOST, NULL, NULL, wsk_irp));
+    ok(status == STATUS_INVALID_PARAMETER, "long address: got unexpected status %#lx.\n", status);
+}
