+struct wsk_get_name_info_context
+{
+    SOCKADDR_STORAGE address;
+    int length;
+    UNICODE_STRING *node_name;
+    UNICODE_STRING *service_name;
+    ULONG flags;
+    IRP *irp;
+};
+
+static void WINAPI get_name_info_callback(TP_CALLBACK_INSTANCE *instance, void *context_)
+{
+    struct wsk_get_name_info_context *context = context_;
+    WCHAR node[NI_MAXHOST], service[NI_MAXSERV];
+    NTSTATUS status = STATUS_SUCCESS;
+    UNICODE_STRING *name;
+    int ret, len;
+
+    TRACE("instance %p, context %p.\n", instance, context);
+
+    ret = GetNameInfoW((SOCKADDR *)&context->address, context->length,
+            context->node_name ? node : NULL, context->node_name ? ARRAY_SIZE(node) : 0,
+            context->service_name ? service : NULL, context->service_name ? ARRAY_SIZE(service) : 0,
+            context->flags);
+    if (ret)
+    {
+        /* a name that cannot be resolved is STATUS_NO_MATCH here (the docs' list) */
+        status = ret == WSAHOST_NOT_FOUND || ret == WSANO_DATA ? STATUS_NO_MATCH : sock_error_to_ntstatus(ret);
+    }
+    else
+    {
+        /* the caller's buffers hold the name and its terminating NUL */
+        name = context->node_name;
+        if (name)
+        {
+            len = wcslen(node);
+#ifdef SG_MUTANT_NETIO_NAMESIZE
+            if (0)
+#else
+            if ((len + 1) * sizeof(WCHAR) > name->MaximumLength)
+#endif
+                status = STATUS_BUFFER_TOO_SMALL;
+            else
+            {
+                memcpy(name->Buffer, node, (len + 1) * sizeof(WCHAR));
+                name->Length = len * sizeof(WCHAR);
+            }
+        }
+        name = context->service_name;
+        if (name && !status)
+        {
+            len = wcslen(service);
+            if ((len + 1) * sizeof(WCHAR) > name->MaximumLength)
+                status = STATUS_BUFFER_TOO_SMALL;
+            else
+            {
+                memcpy(name->Buffer, service, (len + 1) * sizeof(WCHAR));
+#ifndef SG_MUTANT_NETIO_NAMELEN
+                name->Length = len * sizeof(WCHAR);
+#endif
+            }
+        }
+    }
+
+    context->irp->IoStatus.Information = 0;
+    dispatch_irp(context->irp, status);
+    free(context);
+}
+
 static NTSTATUS WINAPI wsk_get_name_info(WSK_CLIENT *client, SOCKADDR *sock_addr, ULONG sock_addr_length,
         UNICODE_STRING *node_name, UNICODE_STRING *service_name, ULONG flags, PEPROCESS owning_process,
         PETHREAD owning_thread, IRP *irp)
 {
-    FIXME("client %p, sock_addr %p, sock_addr_length %lu, node_name %p, service_name %p, "
-            "flags %#lx, owning_process %p, owning_thread %p, irp %p stub.\n",
+    struct wsk_get_name_info_context *context;
+
+    TRACE("client %p, sock_addr %p, sock_addr_length %lu, node_name %p, service_name %p, "
+            "flags %#lx, owning_process %p, owning_thread %p, irp %p.\n",
             client, sock_addr, sock_addr_length, node_name, service_name, flags,
             owning_process, owning_thread, irp);
 
-    return STATUS_NOT_IMPLEMENTED;
+    if (!irp)
+        return STATUS_INVALID_PARAMETER;
+
+    irp->IoStatus.Information = 0;
+
+    /* at least one name is wanted; a thread needs its process; the address must fit SOCKADDR_STORAGE */
+    if ((!node_name && !service_name) || (owning_thread && !owning_process)
+            || !sock_addr || sock_addr_length < sizeof(sock_addr->sa_family)
+            || sock_addr_length > sizeof(SOCKADDR_STORAGE))
+    {
+        dispatch_irp(irp, STATUS_INVALID_PARAMETER);
+        return STATUS_PENDING;
+    }
+
+    if (!(context = calloc(1, sizeof(*context))))
+    {
+        dispatch_irp(irp, STATUS_NO_MEMORY);
+        return STATUS_PENDING;
+    }
+
+    memcpy(&context->address, sock_addr, sock_addr_length);
+    context->length = sock_addr_length;
+    context->node_name = node_name;
+    context->service_name = service_name;
+    context->flags = flags;
+    context->irp = irp;
+
+    if (!TrySubmitThreadpoolCallback(get_name_info_callback, context, NULL))
+    {
+        dispatch_irp(irp, STATUS_UNSUCCESSFUL);
+        free(context);
+    }
+    return STATUS_PENDING;
 }
 
