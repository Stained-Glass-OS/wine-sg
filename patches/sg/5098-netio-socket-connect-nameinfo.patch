--- a/dlls/netio.sys/netio.c
+++ b/dlls/netio.sys/netio.c
@@ -1215,18 +1215,125 @@
     return status ? status : STATUS_PENDING;
 }
 
+struct wsk_socket_connect_context
+{
+    ADDRESS_FAMILY address_family;
+    USHORT socket_type;
+    ULONG protocol;
+    SOCKADDR_STORAGE local_address, remote_address;
+    const void *client_dispatch;
+    void *client_context;
+    IRP *irp;
+};
+
+static void WINAPI socket_connect_callback(TP_CALLBACK_INSTANCE *instance, void *context_)
+{
+    struct wsk_socket_connect_context *context = context_;
+    struct wsk_socket_internal *socket;
+    NTSTATUS status;
+    SOCKET s;
+
+    TRACE("instance %p, context %p.\n", instance, context);
+
+    context->irp->IoStatus.Information = 0;
+
+    if ((s = WSASocketW(context->address_family, context->socket_type, context->protocol, NULL, 0,
+            WSA_FLAG_OVERLAPPED)) == INVALID_SOCKET)
+    {
+        status = sock_error_to_ntstatus(WSAGetLastError());
+    }
+#ifdef SG_MUTANT_NETIO_SOCKBIND
+    else if (connect(s, (SOCKADDR *)&context->remote_address,
+            sockaddr_length((SOCKADDR *)&context->remote_address)))
+#else
+    else if (bind(s, (SOCKADDR *)&context->local_address, sockaddr_length((SOCKADDR *)&context->local_address))
+            || connect(s, (SOCKADDR *)&context->remote_address,
+            sockaddr_length((SOCKADDR *)&context->remote_address)))
+#endif
+    {
+        status = sock_error_to_ntstatus(WSAGetLastError());
+        closesocket(s);
+    }
+    else if (!(socket = calloc(1, sizeof(*socket))))
+    {
+        status = STATUS_NO_MEMORY;
+        closesocket(s);
+    }
+    else
+    {
+        socket->wsk_socket.Dispatch = &wsk_provider_connection_dispatch;
+        socket->s = s;
+        socket->client_dispatch = context->client_dispatch;
+        socket->client_context = context->client_context;
+        socket->socket_type = context->socket_type;
+        socket->flags = WSK_FLAG_CONNECTION_SOCKET;
+        socket->address_family = context->address_family;
+        socket->protocol = context->protocol;
+        socket->bound = TRUE;
+        socket_init(socket);
+        context->irp->IoStatus.Information = (ULONG_PTR)&socket->wsk_socket;
+        status = STATUS_SUCCESS;
+    }
+
+    dispatch_irp(context->irp, status);
+    free(context);
+}
+
+/* WskSocketConnect: creates, binds and connects a socket, completing asynchronously
+ * from a worker, with the new WSK_SOCKET as the IRP's Information. */
 static NTSTATUS WINAPI wsk_socket_connect(WSK_CLIENT *client, USHORT socket_type, ULONG protocol,
         SOCKADDR *local_address, SOCKADDR *remote_address, ULONG flags, void *socket_context,
         const WSK_CLIENT_CONNECTION_DISPATCH *dispatch, PEPROCESS owning_process, PETHREAD owning_thread,
         SECURITY_DESCRIPTOR *security_descriptor, IRP *irp)
 {
-    FIXME("client %p, socket_type %#x, protocol %#lx, local_address %p, remote_address %p, "
+    struct wsk_socket_connect_context *context;
+    NTSTATUS status;
+
+    TRACE("client %p, socket_type %#x, protocol %#lx, local_address %p, remote_address %p, "
             "flags %#lx, socket_context %p, dispatch %p, owning_process %p, owning_thread %p, "
-            "security_descriptor %p, irp %p stub.\n",
+            "security_descriptor %p, irp %p.\n",
             client, socket_type, protocol, local_address, remote_address, flags, socket_context,
             dispatch, owning_process, owning_thread, security_descriptor, irp);
 
-    return STATUS_NOT_IMPLEMENTED;
+    if (!irp)
+        return STATUS_INVALID_PARAMETER;
+
+    if (!client)
+        return STATUS_INVALID_HANDLE;
+
+    irp->IoStatus.Information = 0;
+
+    /* Flags is reserved; the address family comes from the local address */
+    if (flags || !local_address || !remote_address || local_address->sa_family != remote_address->sa_family)
+    {
+        dispatch_irp(irp, STATUS_INVALID_PARAMETER);
+        return STATUS_PENDING;
+    }
+
+    if (!(context = calloc(1, sizeof(*context))))
+    {
+        dispatch_irp(irp, STATUS_NO_MEMORY);
+        return STATUS_PENDING;
+    }
+
+    context->address_family = local_address->sa_family;
+    context->socket_type = socket_type;
+    context->protocol = protocol;
+    memcpy(&context->local_address, local_address, sockaddr_length(local_address));
+    memcpy(&context->remote_address, remote_address, sockaddr_length(remote_address));
+    context->client_dispatch = dispatch;
+    context->client_context = socket_context;
+    context->irp = irp;
+
+    if (!TrySubmitThreadpoolCallback(socket_connect_callback, context, NULL))
+    {
+        ERR("Could not submit thread pool callback.\n");
+        status = STATUS_UNSUCCESSFUL;
+        dispatch_irp(irp, status);
+        free(context);
+        return STATUS_PENDING;
+    }
+    return STATUS_PENDING;
 }
 
