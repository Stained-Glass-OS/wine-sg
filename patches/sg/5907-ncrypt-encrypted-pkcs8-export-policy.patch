From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ncrypt: an encrypted PKCS #8 export needs NCRYPT_ALLOW_EXPORT_FLAG only (5907)

CORE review: security. NCryptExportKey(PKCS8_PRIVATEKEY) required
NCRYPT_ALLOW_PLAINTEXT_EXPORT_FLAG even for an EncryptedPrivateKeyInfo
(stubs-6d 5621, a password in NCRYPTBUFFER_PKCS_SECRET), because the export
policy was checked before the parameters were looked at. As on Windows, an
export encrypted under a secret needs only NCRYPT_ALLOW_EXPORT_FLAG (the
password protects the blob, as wrapping under another key does); in the
clear the key must still allow plaintext export. A secret counts only when it
is a non-empty string.

Coordinator decision (integration review of 5621/3721, integ-2026-10).
Gate: test/ncrypt-p8policy-gate.sh (no export flag: both refused; ALLOW_EXPORT:
encrypted only; ALLOW_EXPORT|ALLOW_PLAINTEXT_EXPORT: both; 64/32). Mutants
SG_MUTANT_P8_ENC_PLAINPOLICY and the existing SG_MUTANT_EXPORT_ANYTHING.
---
diff --git a/dlls/ncrypt/main.c b/dlls/ncrypt/main.c
--- a/dlls/ncrypt/main.c
+++ b/dlls/ncrypt/main.c
@@ -1263,6 +1263,27 @@ SECURITY_STATUS WINAPI NCryptImportKey(NCRYPT_PROV_HANDLE provider, NCRYPT_KEY_H
     return ERROR_SUCCESS;
 }
 
+/* a PKCS #8 export that the caller asks to encrypt: a password buffer (NCRYPTBUFFER_PKCS_SECRET) that
+ * is a non-empty string; anything else is exported in the clear or refused by pkcs8_export */
+static BOOL is_encrypted_pkcs8(const WCHAR *type, const NCryptBufferDesc *params)
+{
+    ULONG i;
+
+#ifdef SG_MUTANT_P8_ENC_PLAINPOLICY
+    return FALSE;
+#endif
+    if (lstrcmpW(type, L"PKCS8_PRIVATEKEY") || !params) return FALSE;
+    for (i = 0; i < params->cBuffers; i++)
+    {
+        const NCryptBuffer *buf = &params->pBuffers[i];
+
+        if (buf->BufferType == 46 /* NCRYPTBUFFER_PKCS_SECRET */ && buf->pvBuffer && buf->cbBuffer >= 2 * sizeof(WCHAR) &&
+            ((const WCHAR *)buf->pvBuffer)[0])
+            return TRUE;
+    }
+    return FALSE;
+}
+
 static BOOL is_private_blob(const WCHAR *type)
 {
     return !lstrcmpW(type, BCRYPT_RSAPRIVATE_BLOB) || !lstrcmpW(type, BCRYPT_RSAFULLPRIVATE_BLOB) ||
@@ -1509,7 +1530,10 @@ SECURITY_STATUS WINAPI NCryptExportKey(NCRYPT_KEY_HANDLE key, NCRYPT_KEY_HANDLE
     if (is_private_blob(type))
     {
         DWORD policy = get_dword_property(object, NCRYPT_EXPORT_POLICY_PROPERTY, 0);
-        DWORD required = encrypt_key ? NCRYPT_ALLOW_EXPORT_FLAG : NCRYPT_ALLOW_PLAINTEXT_EXPORT_FLAG;
+        /* wrapped for another key, or a PKCS #8 blob encrypted under a secret (5907): the key does
+         * not leave in the clear, so "exportable" is enough; in the clear it must allow plaintext */
+        DWORD required = encrypt_key || is_encrypted_pkcs8(type, params) ? NCRYPT_ALLOW_EXPORT_FLAG
+                                                                       : NCRYPT_ALLOW_PLAINTEXT_EXPORT_FLAG;
 #ifdef SG_MUTANT_WRAP_POLICY
         required = NCRYPT_ALLOW_PLAINTEXT_EXPORT_FLAG;
 #endif
