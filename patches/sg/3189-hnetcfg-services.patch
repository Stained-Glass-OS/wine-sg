+static HRESULT setting_set( LONG type, const WCHAR *sub, const WCHAR *value, DWORD reg_type, const void *data, DWORD size )
+{
+    const WCHAR *names[3];
+    HRESULT hr = S_OK;
+    int i;
+
+    profile_names( type, names );
+    for (i = 0; i < 3 && names[i] && SUCCEEDED(hr); i++) hr = fw_profile_sub_set( names[i], sub, value, reg_type, data, size );
+    return hr;
+}
+
+static DWORD setting_dword( LONG type, const WCHAR *sub, const WCHAR *value, DWORD def )
+{
+    const WCHAR *names[3];
+    DWORD data, size = sizeof(data);
+    profile_names( type, names );
+    return fw_profile_sub_get( names[0], sub, value, REG_DWORD, &data, &size ) == S_OK ? data : def;
+}
