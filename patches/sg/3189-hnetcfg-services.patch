+static HRESULT WINAPI dynamic_ports_get__NewEnum( IDynamicPortMappingCollection *iface, IUnknown **ret )
+{
+    IDispatch **items = NULL;
+    unsigned int i, n = 0, count;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, ret %p.\n", iface, ret );
+    if (!ret) return E_POINTER;
+    *ret = NULL;
+    count = get_port_mapping_count();
+    if (count && !(items = calloc( count, sizeof(*items) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; ++i)
+    {
+        struct port_mapping data;
+        IDynamicPortMapping *m;
+        if (!get_port_mapping_range( i, 1, &data )) break;
+        if (!mapping_is_dynamic( &data )) { free_port_mapping( &data ); continue; }
+        if (FAILED(hr = dynamic_port_mapping_create( &data, &m ))) { free_port_mapping( &data ); break; }
+        items[n++] = (IDispatch *)m;
+    }
+    if (SUCCEEDED(hr)) hr = fw_obj_enum_create( items, n, 0, ret );
+    for (i = 0; i < n; ++i) IDispatch_Release( items[i] );
+    free( items );
+    return hr;
+}
