+/* ---- INetFwServiceRestriction ----
+ *
+ * Which (service, program) pairs are restricted is kept under
+ * ...\FirewallPolicy\RestrictedServices\Configurable\SgServices (value "service|program": 1,
+ * or 2 when the service's SID restricts it too); the registry refuses a standard user. The
+ * rules of the restriction are a collection of their own, kept where Windows keeps them
+ * (...\RestrictedServices\Configurable\System) and never given to Stained Glass Firewall: it
+ * has no per-service switch, so the restriction is recorded and reported, not enforced. */
+#define SG_RESTRICT_KEY SG_FW_POLICY_KEY L"RestrictedServices\\Configurable\\SgServices"
+
+typedef struct fw_restriction
+{
+    INetFwServiceRestriction INetFwServiceRestriction_iface;
+    LONG refs;
+    INetFwRules *rules;
+} fw_restriction;
+
+static inline fw_restriction *impl_from_restriction( INetFwServiceRestriction *iface )
+{
+    return CONTAINING_RECORD(iface, fw_restriction, INetFwServiceRestriction_iface);
+}
+
+static ULONG WINAPI restriction_AddRef( INetFwServiceRestriction *iface )
+{
+    return InterlockedIncrement( &impl_from_restriction( iface )->refs );
+}
+
+static ULONG WINAPI restriction_Release( INetFwServiceRestriction *iface )
+{
+    fw_restriction *This = impl_from_restriction( iface );
+    LONG refs = InterlockedDecrement( &This->refs );
+    if (!refs)
+    {
+        if (This->rules) INetFwRules_Release( This->rules );
+        free( This );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI restriction_QueryInterface( INetFwServiceRestriction *iface, REFIID riid, void **obj )
+{
+    TRACE("%p %s %p\n", iface, debugstr_guid( riid ), obj );
+    if (IsEqualGUID( riid, &IID_INetFwServiceRestriction ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        INetFwServiceRestriction_AddRef( iface );
+        return S_OK;
+    }
+    WARN("interface %s not implemented\n", debugstr_guid( riid ));
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI restriction_GetTypeInfoCount( INetFwServiceRestriction *iface, UINT *pctinfo )
+{
+    *pctinfo = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI restriction_GetTypeInfo( INetFwServiceRestriction *iface, UINT iTInfo, LCID lcid, ITypeInfo **ppTInfo )
+{
+    if (iTInfo) return DISP_E_BADINDEX;
+    return get_typeinfo( INetFwServiceRestriction_tid, ppTInfo );
+}
+
+static HRESULT WINAPI restriction_GetIDsOfNames( INetFwServiceRestriction *iface, REFIID riid, LPOLESTR *names, UINT count,
+                                                 LCID lcid, DISPID *ids )
+{
+    ITypeInfo *typeinfo;
+    HRESULT hr;
+    if (FAILED(hr = get_typeinfo( INetFwServiceRestriction_tid, &typeinfo ))) return hr;
+    hr = ITypeInfo_GetIDsOfNames( typeinfo, names, count, ids );
+    ITypeInfo_Release( typeinfo );
+    return hr;
+}
+
+static HRESULT WINAPI restriction_Invoke( INetFwServiceRestriction *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+                                          DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    ITypeInfo *typeinfo;
+    HRESULT hr;
+    if (FAILED(hr = get_typeinfo( INetFwServiceRestriction_tid, &typeinfo ))) return hr;
+    hr = ITypeInfo_Invoke( typeinfo, iface, id, flags, params, result, excep, arg_err );
+    ITypeInfo_Release( typeinfo );
+    return hr;
+}
+
+static WCHAR *restriction_name( const WCHAR *service, const WCHAR *app )
+{
+    size_t len = wcslen( service ) + 1 + (app ? wcslen( app ) : 0) + 1;
+    WCHAR *name = malloc( len * sizeof(WCHAR) );
+    if (name) swprintf( name, len, L"%s|%s", service, app ? app : L"" );
+    return name;
+}
+
+static HRESULT WINAPI restriction_RestrictService( INetFwServiceRestriction *iface, BSTR service, BSTR app,
+                                                   VARIANT_BOOL do_restrict, VARIANT_BOOL sid_restricted )
+{
+    WCHAR *name;
+    HKEY key;
+    LSTATUS err;
+    DWORD data = sid_restricted ? 2 : 1;
+
+    TRACE("%p %s %s %d %d\n", iface, debugstr_w(service), debugstr_w(app), do_restrict, sid_restricted);
+    if (!service || !*service) return E_INVALIDARG;
+    if (!(name = restriction_name( service, app ))) return E_OUTOFMEMORY;
+    if (do_restrict)
+    {
+        if (!(err = RegCreateKeyExW( HKEY_LOCAL_MACHINE, SG_RESTRICT_KEY, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL )))
+        {
+            err = RegSetValueExW( key, name, 0, REG_DWORD, (BYTE *)&data, sizeof(data) );
+            RegCloseKey( key );
+        }
+    }
+    else if (!(err = RegOpenKeyExW( HKEY_LOCAL_MACHINE, SG_RESTRICT_KEY, 0, KEY_SET_VALUE, &key )))
+    {
+        err = RegDeleteValueW( key, name );
+        RegCloseKey( key );
+        if (err == ERROR_FILE_NOT_FOUND) err = 0;
+    }
+    else if (err == ERROR_FILE_NOT_FOUND) err = 0;
+    free( name );
+    return err ? HRESULT_FROM_WIN32( err ) : S_OK;
+}
+
+static HRESULT WINAPI restriction_ServiceRestricted( INetFwServiceRestriction *iface, BSTR service, BSTR app,
+                                                     VARIANT_BOOL *restricted )
+{
+    WCHAR *name;
+    HKEY key;
+    DWORD data, size = sizeof(data), type;
+    LSTATUS err = ERROR_FILE_NOT_FOUND;
+
+    TRACE("%p %s %s %p\n", iface, debugstr_w(service), debugstr_w(app), restricted);
+    if (!restricted) return E_POINTER;
+    *restricted = VARIANT_FALSE;
+    if (!service || !*service) return E_INVALIDARG;
+    if (!(name = restriction_name( service, app ))) return E_OUTOFMEMORY;
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, SG_RESTRICT_KEY, 0, KEY_QUERY_VALUE, &key ))
+    {
+        err = RegQueryValueExW( key, name, NULL, &type, (BYTE *)&data, &size );
+        RegCloseKey( key );
+    }
+    free( name );
+    if (!err && type == REG_DWORD && data) *restricted = VARIANT_TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI restriction_get_Rules( INetFwServiceRestriction *iface, INetFwRules **rules )
+{
+    fw_restriction *This = impl_from_restriction( iface );
+
+    TRACE("%p %p\n", This, rules);
+    if (!rules) return E_POINTER;
+    *rules = This->rules;
+    INetFwRules_AddRef( *rules );
+    return S_OK;
+}
+
+static const INetFwServiceRestrictionVtbl restriction_vtbl =
+{
+    restriction_QueryInterface,
+    restriction_AddRef,
+    restriction_Release,
+    restriction_GetTypeInfoCount,
+    restriction_GetTypeInfo,
+    restriction_GetIDsOfNames,
+    restriction_Invoke,
+    restriction_RestrictService,
+    restriction_ServiceRestricted,
+    restriction_get_Rules
+};
+
+HRESULT NetFwServiceRestriction_create_rules( INetFwRules *unused, LPVOID *ppObj )
+{
+    fw_restriction *fp;
+    HRESULT hr;
+
+    if (!(fp = calloc( 1, sizeof(*fp) ))) return E_OUTOFMEMORY;
+    fp->INetFwServiceRestriction_iface.lpVtbl = &restriction_vtbl;
+    fp->refs = 1;
+    if (FAILED(hr = create_INetFwRules_s( 1, &fp->rules ))) { free( fp ); return hr; }
+    *ppObj = &fp->INetFwServiceRestriction_iface;
+    return S_OK;
+}
