+    if (!mapping) return E_POINTER;
+    *mapping = NULL;
+    if (!is_valid_protocol( protocol )) return E_INVALIDARG;
+    if (port < 0 || port > 65535) return E_INVALIDARG;
+    if (!find_dynamic_mapping( host, port, protocol, &data )) return HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
+    if (FAILED(hr = dynamic_port_mapping_create( &data, mapping ))) free_port_mapping( &data );
+    return hr;
+}
