+/* an edit is an AddPortMapping for the same remote host, port and protocol: the gateway replaces the entry */
+static HRESULT dynamic_port_mapping_edit( struct dynamic_port_mapping *mapping, BSTR client, LONG internal,
+                                          VARIANT_BOOL enabled, BSTR descr, LONG lease )
+{
+    BSTR new_client = NULL, new_descr = NULL;
+
+    if (!client || !*client || !descr) return E_INVALIDARG;
+    if (internal < 0 || internal > 65535 || lease < 0) return E_INVALIDARG;
+    if (!add_port_mapping_host( mapping->data.external_ip, mapping->data.external, mapping->data.protocol, internal,
+                                client, enabled, descr, lease ))
+        return E_FAIL;
+    if (client != mapping->data.client)
+    {
+        if (!(new_client = SysAllocString( client ))) return E_OUTOFMEMORY;
+        SysFreeString( mapping->data.client );
+        mapping->data.client = new_client;
+    }
+    if (descr != mapping->data.descr)
+    {
+        if (!(new_descr = SysAllocString( descr ))) return E_OUTOFMEMORY;
+        SysFreeString( mapping->data.descr );
+        mapping->data.descr = new_descr;
+    }
+    mapping->data.internal = internal;
+    mapping->data.enabled = enabled ? VARIANT_TRUE : VARIANT_FALSE;
+    mapping->data.lease = lease;
+    return S_OK;
+}
