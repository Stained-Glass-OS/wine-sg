+
+    TRACE( "iface %p, count %p.\n", iface, count );
+    if (!count) return E_POINTER;
+    total = get_port_mapping_count();
+    for (i = 0; i < total; ++i)
+    {
+        struct port_mapping data;
+        if (!get_port_mapping_range( i, 1, &data )) break;
