+{
+    fw_remote_admin *This = impl_from_remote_admin( iface );
+    DWORD v;
+    TRACE("%p %p\n", This, ipVersion);
+    if (!ipVersion) return E_POINTER;
+    v = setting_dword( This->type, RA_SUB, L"IpVersion", NET_FW_IP_VERSION_ANY );
+    *ipVersion = v <= NET_FW_IP_VERSION_ANY ? v : NET_FW_IP_VERSION_ANY;
