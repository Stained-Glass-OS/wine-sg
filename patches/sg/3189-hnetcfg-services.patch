+/* Stained Glass OS: values of a sub-key of a profile (Services\\FileAndPrint, RemoteAdminSettings,
+ * IcmpSettings): a DWORD or a string, read with a default and written (the key made) with the
+ * registry's own access check -- a standard user gets E_ACCESSDENIED, as on Windows. */
+HRESULT fw_profile_sub_get( const WCHAR *profile, const WCHAR *sub, const WCHAR *value, DWORD type, void *out, DWORD *size )
+{
+    WCHAR path[MAX_PATH];
+    DWORD got_type, got = *size;
+    HKEY key;
+    LSTATUS err;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s%s\\%s", SG_FW_POLICY_KEY, profile, sub );
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_QUERY_VALUE, &key )) return S_FALSE;
+    err = RegQueryValueExW( key, value, NULL, &got_type, out, &got );
+    RegCloseKey( key );
+    if (err || got_type != type) return S_FALSE;
+    *size = got;
+    return S_OK;
+}
+
+HRESULT fw_profile_sub_set( const WCHAR *profile, const WCHAR *sub, const WCHAR *value, DWORD type, const void *data, DWORD size )
+{
+    WCHAR path[MAX_PATH];
+    HKEY key;
+    LSTATUS err;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s%s\\%s", SG_FW_POLICY_KEY, profile, sub );
+    if ((err = RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL )))
+        return HRESULT_FROM_WIN32( err );
+    err = RegSetValueExW( key, value, 0, type, data, size );
+    RegCloseKey( key );
+#ifdef SG_MUTANT_HN_ICMP_NOPUSH
+    if (0)
+#else
+    if (!err)
+#endif
+    if (!wcsicmp( sub, L"IcmpSettings" ) && !wcsicmp( value, L"AllowInboundEchoRequest" ) && type == REG_DWORD)
+        firewall_setting_push( profile, L"IcmpSettings\\AllowInboundEchoRequest", TRUE, *(const DWORD *)data );
+    return err ? HRESULT_FROM_WIN32( err ) : S_OK;
+}
