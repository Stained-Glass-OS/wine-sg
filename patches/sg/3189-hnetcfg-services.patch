+/* the interfaces a rule is restricted to, as Windows' array of names (a VARIANT holding a
+ * SAFEARRAY of VARIANT strings); kept with the rule. The firewall has no per-interface rules,
+ * so the restriction is stored and read back but not enforced. */
 static HRESULT WINAPI netfw_rule_get_Interfaces( INetFwRule3 *iface, VARIANT *interfaces )
 {
+    fw_rule *This = impl_from_INetFwRule3( iface );
+    SAFEARRAY *array;
+    WCHAR *copy, *item, *ctx;
+    LONG i = 0, n = 0;
+    HRESULT hr = S_OK;
+
     TRACE("%p, %p\n", iface, interfaces);
     if (!interfaces) return E_POINTER;
     V_VT(interfaces) = VT_EMPTY;
+    if (!This->ifaces) return S_OK;
+    if (!(copy = str_dup( This->ifaces ))) return E_OUTOFMEMORY;
+    for (item = wcstok_s( copy, L",", &ctx ); item; item = wcstok_s( NULL, L",", &ctx )) n++;
+    lstrcpyW( copy, This->ifaces );
+    if (!(array = SafeArrayCreateVector( VT_VARIANT, 0, n ))) { free( copy ); return E_OUTOFMEMORY; }
+    for (item = wcstok_s( copy, L",", &ctx ); item && SUCCEEDED(hr); item = wcstok_s( NULL, L",", &ctx ), i++)
+    {
+        VARIANT v;
+        V_VT(&v) = VT_BSTR;
+        if (!(V_BSTR(&v) = SysAllocString( item ))) { hr = E_OUTOFMEMORY; break; }
+        hr = SafeArrayPutElement( array, &i, &v );
+        VariantClear( &v );
+    }
+    free( copy );
+    if (FAILED(hr)) { SafeArrayDestroy( array ); return hr; }
+    V_VT(interfaces) = VT_ARRAY | VT_VARIANT;
+    V_ARRAY(interfaces) = array;
     return S_OK;
 }
 
 static HRESULT WINAPI netfw_rule_put_Interfaces( INetFwRule3 *iface, VARIANT interfaces )
 {
-    FIXME("%p, %s: kept for all interfaces\n", iface, debugstr_variant(&interfaces));
+    fw_rule *This = impl_from_INetFwRule3( iface );
+    SAFEARRAY *array;
+    LONG lo, hi, i;
+    WCHAR *list = NULL;
+    HRESULT hr = S_OK;
+    VARTYPE vt;
+
+    TRACE("%p, %s\n", iface, debugstr_variant(&interfaces));
+    if (V_VT(&interfaces) == VT_EMPTY || V_VT(&interfaces) == VT_NULL)
+    {
+        free( This->ifaces );
+        This->ifaces = NULL;
+        return S_OK;
+    }
+    if (!(V_VT(&interfaces) & VT_ARRAY) || (V_VT(&interfaces) & VT_BYREF)) return E_INVALIDARG;
+    vt = V_VT(&interfaces) & VT_TYPEMASK;
+    if (vt != VT_VARIANT && vt != VT_BSTR) return E_INVALIDARG;
+    array = V_ARRAY(&interfaces);
+    if (!array || SafeArrayGetDim( array ) != 1) return E_INVALIDARG;
+    if (FAILED(hr = SafeArrayGetLBound( array, 1, &lo )) || FAILED(hr = SafeArrayGetUBound( array, 1, &hi ))) return hr;
+    for (i = lo; i <= hi; i++)
+    {
+        VARIANT v;
+        const WCHAR *name;
+        VariantInit( &v );
+        if (vt == VT_BSTR)
+        {
+            BSTR b = NULL;
+            if (FAILED(hr = SafeArrayGetElement( array, &i, &b ))) break;
+            V_VT(&v) = VT_BSTR;
+            V_BSTR(&v) = b;
+        }
+        else if (FAILED(hr = SafeArrayGetElement( array, &i, &v ))) break;
+        if (V_VT(&v) != VT_BSTR || !V_BSTR(&v) || !*V_BSTR(&v) || wcschr( V_BSTR(&v), ',' ) || wcschr( V_BSTR(&v), '|' ))
+        {
+            VariantClear( &v );
+            hr = E_INVALIDARG;
+            break;
+        }
+        name = V_BSTR(&v);
+        list_append( &list, name );
+        VariantClear( &v );
+    }
+    if (FAILED(hr)) { free( list ); return hr == E_OUTOFMEMORY ? hr : E_INVALIDARG; }
+    free( This->ifaces );
+    This->ifaces = list;
     return S_OK;
 }
 
