+/* ---- the three services the old firewall interfaces know ----
+ *
+ * File and Printer Sharing, UPnP Framework and Remote Desktop. Each is backed by
+ * one of Stained Glass Firewall's built-in groups: whether the service is let
+ * through is the group's setting for the kind of network (the "group" lines of
+ * the firewall's status file; changed through sg-admind's "firewall group", an
+ * administrator's). The Domain profile is the domain network; the Standard
+ * profile is the Private one (the group is never opened to Public from here).
+ * The scope, the remote addresses and the IP version are kept where Windows
+ * keeps them, in the profile's Services\<name> key; the group has no such
+ * restriction, so they are stored and reported but not enforced. */
+struct svc_port { const WCHAR *name; NET_FW_IP_PROTOCOL protocol; LONG port; };
+
+struct svc_def
+{
+    const WCHAR *name;          /* the friendly name */
+    const WCHAR *sub;           /* Services\<name> in the profile's key */
+    const char *group;          /* the firewall group */
+    LONG default_profiles;      /* the group's built-in setting (NET_FW_PROFILE2 bits) */
+    const struct svc_port *ports;
+    int nports;
+};
+
+static const struct svc_port file_print_ports[] =
+{
+    { L"NetBIOS Name Service", NET_FW_IP_PROTOCOL_UDP, 137 },
+    { L"NetBIOS Datagram Service", NET_FW_IP_PROTOCOL_UDP, 138 },
+    { L"NetBIOS Session Service", NET_FW_IP_PROTOCOL_TCP, 139 },
+    { L"SMB over TCP", NET_FW_IP_PROTOCOL_TCP, 445 },
+};
+static const struct svc_port upnp_ports[] =
+{
+    { L"SSDP", NET_FW_IP_PROTOCOL_UDP, 1900 },
+    { L"UPnP", NET_FW_IP_PROTOCOL_TCP, 2869 },
+};
+static const struct svc_port rdp_ports[] =
+{
+    { L"Remote Desktop", NET_FW_IP_PROTOCOL_TCP, 3389 },
+};
+
+static const struct svc_def svc_defs[] =
+{
+    { L"File and Printer Sharing", L"Services\\FileAndPrint", "file-sharing", 3, file_print_ports, ARRAY_SIZE(file_print_ports) },
+    { L"UPnP Framework", L"Services\\UPnPFramework", "network-discovery", 3, upnp_ports, ARRAY_SIZE(upnp_ports) },
+    { L"Remote Desktop", L"Services\\RemoteDesktop", "remote-desktop", 7, rdp_ports, ARRAY_SIZE(rdp_ports) },
+};
+
+static const WCHAR *svc_profile_key( LONG type )
+{
+    return type == NET_FW_PROFILE_DOMAIN ? L"DomainProfile" : L"StandardProfile";
+}
+
+/* the group's networks, from the firewall's status file; FALSE when it does not run */
+static BOOL svc_group_bits( const struct svc_def *def, LONG *bits )
+{
+    char *status = sgfw_status(), key[64], line[160], *tab;
+    BOOL ok = FALSE;
+
+    if (!status) return FALSE;
+    snprintf( key, sizeof(key), "group\t%s", def->group );
+    if (sgfw_status_line( status, key, line, sizeof(line) ))
+    {
+        /* "PROFILES\tNAME" */
+        if ((tab = strchr( line, '\t' ))) *tab = 0;
+        *bits = !strcmp( line, "all" ) ? 7 : !strcmp( line, "none" ) ? 0 : sgfw_profile_bits( line );
+        ok = TRUE;
+    }
+    free( status );
+    return ok;
+}
+
+static LONG svc_profile_bit( LONG type )
+{
+    return type == NET_FW_PROFILE_DOMAIN ? NET_FW_PROFILE2_DOMAIN : NET_FW_PROFILE2_PRIVATE;
+}
+
+static BOOL svc_is_enabled( const struct svc_def *def, LONG type )
+{
+    LONG bits;
+    DWORD data = 0, size = sizeof(data);
+
+    if (svc_group_bits( def, &bits )) return (bits & svc_profile_bit( type )) != 0;
+    /* no firewall running: the setting last stored */
+    if (fw_profile_sub_get( svc_profile_key( type ), def->sub, L"Enabled", REG_DWORD, &data, &size ) == S_OK)
+        return data != 0;
+    return (def->default_profiles & svc_profile_bit( type )) != 0;
+}
