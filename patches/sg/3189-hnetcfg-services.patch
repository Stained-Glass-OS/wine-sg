+/* ---- the profile's remote administration and ICMP settings ----
+ *
+ * Kept where Windows keeps them: the profile's RemoteAdminSettings and
+ * IcmpSettings keys (the Standard profile's go to the Private and the Public
+ * one). Stained Glass Firewall obeys AllowInboundEchoRequest (the change is
+ * handed to it at once); remote administration (RPC/DCOM on this PC) and the
+ * other ICMP types are not something the firewall has a switch for, so they
+ * are stored and reported only. */
+static const WCHAR *profile_names( LONG type, const WCHAR *names[3] )
+{
+    names[0] = type == NET_FW_PROFILE_DOMAIN ? L"DomainProfile" : L"StandardProfile";
+    names[1] = type == NET_FW_PROFILE_DOMAIN ? NULL : L"PublicProfile";
+    names[2] = NULL;
+    return names[0];
+}
