+    DWORD v = ipVersion;
+    TRACE("%p %u\n", This, ipVersion);
+    if (ipVersion != NET_FW_IP_VERSION_V4 && ipVersion != NET_FW_IP_VERSION_V6 && ipVersion != NET_FW_IP_VERSION_ANY)
+        return E_INVALIDARG;
