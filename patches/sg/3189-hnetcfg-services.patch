+static HRESULT WINAPI dynamic_ports_Add( IDynamicPortMappingCollection *iface, BSTR host, LONG external, BSTR protocol,
+                                         LONG internal, BSTR client, VARIANT_BOOL enabled, BSTR description, LONG lease,
+                                         IDynamicPortMapping **mapping )
+{
+    struct port_mapping data;
+    HRESULT hr;
+
+    TRACE( "iface %p, host %s, external %ld, protocol %s, internal %ld, client %s, enabled %d, description %s, lease %ld.\n",
+           iface, debugstr_w(host), external, debugstr_w(protocol), internal, debugstr_w(client), enabled,
+           debugstr_w(description), lease );
+    if (!mapping) return E_POINTER;
+    *mapping = NULL;
+    if (!is_valid_protocol( protocol )) return E_INVALIDARG;
+    if (external < 0 || external > 65535 || internal < 0 || internal > 65535 || lease < 0) return E_INVALIDARG;
+    if (!client || !description) return E_INVALIDARG;
+    if (!add_port_mapping_host( host, external, protocol, internal, client, enabled, description, lease )) return E_FAIL;
+
+    memset( &data, 0, sizeof(data) );
+    data.external_ip = SysAllocString( host ? host : L"" );
+    data.external = external;
+    data.protocol = SysAllocString( protocol );
+    data.internal = internal;
+    data.client = SysAllocString( client );
+    data.enabled = enabled ? VARIANT_TRUE : VARIANT_FALSE;
+    data.descr = SysAllocString( description );
+    data.lease = lease;
+    if (!data.external_ip || !data.protocol || !data.client || !data.descr)
+    {
+        free_port_mapping( &data );
+        return E_OUTOFMEMORY;
+    }
+    if (FAILED(hr = dynamic_port_mapping_create( &data, mapping ))) free_port_mapping( &data );
+    return hr;
