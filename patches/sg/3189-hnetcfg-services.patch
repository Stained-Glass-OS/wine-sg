+static HRESULT WINAPI remote_admin_get_RemoteAddresses( INetFwRemoteAdminSettings *iface, BSTR *remoteAddrs )
+{
+    fw_remote_admin *This = impl_from_remote_admin( iface );
+    const WCHAR *names[3];
+    WCHAR buf[512];
+    DWORD size = sizeof(buf);
+
+    TRACE("%p %p\n", This, remoteAddrs);
+    if (!remoteAddrs) return E_POINTER;
+    profile_names( This->type, names );
+    if (fw_profile_sub_get( names[0], RA_SUB, L"RemoteAddresses", REG_SZ, buf, &size ) != S_OK || !buf[0])
+        lstrcpyW( buf, setting_dword( This->type, RA_SUB, L"Scope", NET_FW_SCOPE_ALL ) == NET_FW_SCOPE_LOCAL_SUBNET ?
+                  L"LocalSubnet" : L"*" );
+    return (*remoteAddrs = SysAllocString( buf )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI remote_admin_put_RemoteAddresses( INetFwRemoteAdminSettings *iface, BSTR remoteAddrs )
+{
+    fw_remote_admin *This = impl_from_remote_admin( iface );
+    DWORD scope;
+    HRESULT hr;
+
+    TRACE("%p %s\n", This, debugstr_w(remoteAddrs));
+    if (!remoteAddrs || !*remoteAddrs) return E_INVALIDARG;
+    scope = !wcscmp( remoteAddrs, L"*" ) ? NET_FW_SCOPE_ALL :
+            !wcsicmp( remoteAddrs, L"LocalSubnet" ) ? NET_FW_SCOPE_LOCAL_SUBNET : NET_FW_SCOPE_CUSTOM;
+    if (FAILED(hr = setting_set( This->type, RA_SUB, L"RemoteAddresses", REG_SZ, remoteAddrs,
+                                 (wcslen( remoteAddrs ) + 1) * sizeof(WCHAR) ))) return hr;
+    return setting_set( This->type, RA_SUB, L"Scope", REG_DWORD, &scope, sizeof(scope) );
