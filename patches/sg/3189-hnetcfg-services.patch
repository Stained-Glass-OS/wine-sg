+static HRESULT WINAPI remote_admin_get_Scope( INetFwRemoteAdminSettings *iface, NET_FW_SCOPE *scope )
+{
+    fw_remote_admin *This = impl_from_remote_admin( iface );
+    DWORD v;
+    TRACE("%p %p\n", This, scope);
+    if (!scope) return E_POINTER;
+    v = setting_dword( This->type, RA_SUB, L"Scope", NET_FW_SCOPE_ALL );
+    *scope = v <= NET_FW_SCOPE_CUSTOM ? v : NET_FW_SCOPE_ALL;
+    return S_OK;
+}
+
+static HRESULT WINAPI remote_admin_put_Scope( INetFwRemoteAdminSettings *iface, NET_FW_SCOPE scope )
+{
+    fw_remote_admin *This = impl_from_remote_admin( iface );
+    DWORD v = scope;
+    HRESULT hr;
+    TRACE("%p %u\n", This, scope);
+    if (scope != NET_FW_SCOPE_ALL && scope != NET_FW_SCOPE_LOCAL_SUBNET && scope != NET_FW_SCOPE_CUSTOM)
+        return E_INVALIDARG;
+    if (FAILED(hr = setting_set( This->type, RA_SUB, L"Scope", REG_DWORD, &v, sizeof(v) ))) return hr;
+    if (scope != NET_FW_SCOPE_CUSTOM)
+    {
+        const WCHAR *addrs = scope == NET_FW_SCOPE_ALL ? L"*" : L"LocalSubnet";
+        hr = setting_set( This->type, RA_SUB, L"RemoteAddresses", REG_SZ, addrs, (wcslen( addrs ) + 1) * sizeof(WCHAR) );
+    }
