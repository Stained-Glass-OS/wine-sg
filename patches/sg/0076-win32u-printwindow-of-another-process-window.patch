From: Stained Glass OS <dev@stained-glass.example>
Subject: win32u: PrintWindow of another process's window

PrintWindow sent WM_PRINT with the caller's DC; another process can not use
that handle, so PrintWindow of another program's window drew nothing --
while on Windows screen recorders, switchers and thumbnails rely on it.

Now the caller makes a shared section, duplicates it into the window's
process, and asks the window's thread (WM_WINE_PRINTWINDOW) to render into
a 32 bpp DIB on it: with WM_PRINT as PrintWindow does, or with
PW_RENDERFULLCONTENT (now defined) by copying what the window last drew on
its surface -- which is there even for a cloaked or covered window, as
Windows' compositor has it. The caller then copies the DIB into its DC.

Gate: test/printwindow-gate.sh (another process's window, both flags, and
cloaked).
---
--- a/include/winuser.h
+++ b/include/winuser.h
@@ -1122,6 +1122,7 @@
 
 /* Used for PrintWindow */
 #define PW_CLIENTONLY   0x00000001
+#define PW_RENDERFULLCONTENT 0x00000002
 
 /****** Window classes ******/
 
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -615,6 +615,7 @@
     WM_WINE_WINDOW_STATE_CHANGED,
     WM_WINE_UPDATEWINDOWSTATE,
     WM_WINE_SETCLOAK,
+    WM_WINE_PRINTWINDOW,
     WM_WINE_FIRST_DRIVER_MSG = 0x80001000,  /* range of messages reserved for the USER driver */
     WM_WINE_CLIPCURSOR = 0x80001ff0, /* internal driver notification messages */
     WM_WINE_SETCURSOR,
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -2193,9 +2193,122 @@
 /************************************************************************
  *           NtUserPrintWindow (win32u.@)
  */
+/* another process's window can not be given our DC: it draws into a shared
+ * section instead, a 32 bpp top-down DIB of the window's size */
+#define PRINT_WINDOW_MAX 16384
+
+static BITMAPINFO print_window_info( int width, int height )
+{
+    BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER), width, -height, 1, 32, BI_RGB }};
+    return info;
+}
+
+/* in the window's own thread (WM_WINE_PRINTWINDOW): render it into the
+ * section. PW_RENDERFULLCONTENT copies what the window last drew on its
+ * surface -- as the compositor has it on Windows, and there even for a
+ * cloaked or covered window; otherwise WM_PRINT, as PrintWindow does. */
+LRESULT print_window_to_section( HWND hwnd, HANDLE section, LPARAM lparam )
+{
+    int width = (lparam >> 15) & 0x7fff, height = lparam & 0x7fff;
+    UINT flags = (lparam >> 30) & 3;
+    BITMAPINFO info = print_window_info( width, height );
+    struct window_surface *surface = NULL;
+    HBITMAP bitmap;
+    void *bits;
+    HDC hdc;
+    WND *win;
+    LRESULT ret = 0;
+
+    if (!width || !height) goto done;
+    if (!(hdc = NtGdiCreateCompatibleDC( 0 ))) goto done;
+    if ((bitmap = NtGdiCreateDIBSection( hdc, section, 0, &info, DIB_RGB_COLORS, 0, 0, 0, &bits )))
+    {
+        NtGdiSelectBitmap( hdc, bitmap );
+        if ((flags & PW_RENDERFULLCONTENT) && (win = get_win_ptr( hwnd )) && win != WND_OTHER_PROCESS &&
+            win != WND_DESKTOP)
+        {
+            if ((surface = win->surface)) window_surface_add_ref( surface );
+            release_win_ptr( win );
+        }
+        if (surface && surface->color_bitmap)
+        {
+            HDC src = NtGdiCreateCompatibleDC( 0 );
+            window_surface_lock( surface );
+            NtGdiSelectBitmap( src, surface->color_bitmap );
+            NtGdiBitBlt( hdc, 0, 0, width, height, src, 0, 0, SRCCOPY, 0, 0 );
+            window_surface_unlock( surface );
+            NtGdiDeleteObjectApp( src );
+        }
+        else
+        {
+            UINT prf = PRF_CHILDREN | PRF_ERASEBKGND | PRF_OWNED | PRF_CLIENT;
+            if (!(flags & PW_CLIENTONLY)) prf |= PRF_NONCLIENT;
+            send_message( hwnd, WM_PRINT, (WPARAM)hdc, prf );
+        }
+        if (surface) window_surface_release( surface );
+        NtGdiFlush();
+        NtGdiDeleteObjectApp( bitmap );
+        ret = 1;
+    }
+    NtGdiDeleteObjectApp( hdc );
+done:
+    NtClose( section );
+    return ret;
+}
+
+static BOOL print_other_process_window( HWND hwnd, HDC hdc, UINT flags )
+{
+    OBJECT_ATTRIBUTES attr = { sizeof(attr) };
+    HANDLE section = 0, process = 0, remote = 0;
+    CLIENT_ID cid = { 0 };
+    LARGE_INTEGER size;
+    BITMAPINFO info;
+    HBITMAP bitmap;
+    RECT rect;
+    DWORD pid;
+    void *bits;
+    HDC mem;
+    int width, height;
+    BOOL ret = FALSE;
+
+    if (flags & PW_CLIENTONLY) get_client_rect( hwnd, &rect, get_thread_dpi() );
+    else if (!get_window_rect( hwnd, &rect, get_thread_dpi() )) return FALSE;
+    width = min( rect.right - rect.left, PRINT_WINDOW_MAX );
+    height = min( rect.bottom - rect.top, PRINT_WINDOW_MAX );
+    if (width <= 0 || height <= 0) return FALSE;
+    if (!get_window_thread( hwnd, &pid )) return FALSE;
+
+    size.QuadPart = (LONGLONG)width * height * 4;
+    if (NtCreateSection( &section, SECTION_ALL_ACCESS, NULL, &size, PAGE_READWRITE, SEC_COMMIT, 0 )) return FALSE;
+    cid.UniqueProcess = ULongToHandle( pid );
+    if (!NtOpenProcess( &process, PROCESS_DUP_HANDLE, &attr, &cid ) &&
+        !NtDuplicateObject( GetCurrentProcess(), section, process, &remote, 0, 0, DUPLICATE_SAME_ACCESS ))
+    {
+        /* the other side closes its handle, whatever it does */
+        if (send_message_timeout( hwnd, WM_WINE_PRINTWINDOW, (WPARAM)remote,
+                                  ((LPARAM)(flags & 3) << 30) | (width << 15) | height,
+                                  SMTO_ABORTIFHUNG, 5000, FALSE ))
+        {
+            info = print_window_info( width, height );
+            mem = NtGdiCreateCompatibleDC( hdc );
+            if ((bitmap = NtGdiCreateDIBSection( mem, section, 0, &info, DIB_RGB_COLORS, 0, 0, 0, &bits )))
+            {
+                NtGdiSelectBitmap( mem, bitmap );
+                ret = NtGdiBitBlt( hdc, 0, 0, width, height, mem, 0, 0, SRCCOPY, 0, 0 );
+                NtGdiDeleteObjectApp( bitmap );
+            }
+            NtGdiDeleteObjectApp( mem );
+        }
+    }
+    if (process) NtClose( process );
+    NtClose( section );
+    return ret;
+}
+
 BOOL WINAPI NtUserPrintWindow( HWND hwnd, HDC hdc, UINT flags )
 {
     UINT prf_flags = PRF_CHILDREN | PRF_ERASEBKGND | PRF_OWNED | PRF_CLIENT;
+    if (!is_current_process_window( hwnd )) return print_other_process_window( hwnd, hdc, flags );
     if (!(flags & PW_CLIENTONLY)) prf_flags |= PRF_NONCLIENT;
     send_message( hwnd, WM_PRINT, (WPARAM)hdc, prf_flags );
     return TRUE;
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2088,6 +2088,8 @@
         return set_window_pos( (WINDOWPOS *)lparam, 0, 0 );
     case WM_WINE_SETCLOAK:
         return set_window_cloak( hwnd, wparam );
+    case WM_WINE_PRINTWINDOW:
+        return print_window_to_section( hwnd, (HANDLE)wparam, lparam );
     case WM_WINE_SHOWWINDOW:
         if (is_desktop_window( hwnd )) return 0;
         return NtUserShowWindow( hwnd, wparam );
