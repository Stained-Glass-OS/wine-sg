+static ULONG WINAPI finished_action_AddRef( IAsyncAction *iface )
+{
+    return InterlockedIncrement( &impl_from_IAsyncAction( iface )->ref );
+}
+
+static ULONG WINAPI finished_action_Release( IAsyncAction *iface )
+{
+    struct finished_action *impl = impl_from_IAsyncAction( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->handler) IAsyncActionCompletedHandler_Release( impl->handler );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI finished_action_GetIids( IAsyncAction *iface, ULONG *count, IID **iids )
+{
