+static HRESULT WINAPI finished_action_get_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler **handler )
+{
+    struct finished_action *impl = impl_from_IAsyncAction( iface );
+    if (!handler) return E_POINTER;
+    if ((*handler = impl->handler)) IAsyncActionCompletedHandler_AddRef( *handler );
+    return S_OK;
+}
