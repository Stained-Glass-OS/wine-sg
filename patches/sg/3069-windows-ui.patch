+static IScheduledToastNotification *new_scheduled( IXmlDocument *content, INT64 delivery )
+{
+    IScheduledToastNotificationFactory *factory;
+    IScheduledToastNotification *scheduled = NULL;
+    HSTRING name = hs( RuntimeClass_Windows_UI_Notifications_ScheduledToastNotification );
+    DateTime time;
+    HRESULT hr;
+
+    hr = RoGetActivationFactory( name, &IID_IScheduledToastNotificationFactory, (void **)&factory );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    WindowsDeleteString( name );
+    if (hr != S_OK) return NULL;
+    time.UniversalTime = delivery;
+    hr = IScheduledToastNotificationFactory_CreateScheduledToastNotification( factory, content, time, &scheduled );
+    ok( hr == S_OK && scheduled, "got hr %#lx\n", hr );
+    IScheduledToastNotificationFactory_Release( factory );
+    return scheduled;
+}
+
+static void test_schedule(void)
+{
+    static const WCHAR toast_xml[] = L"<toast><visual><binding template=\"ToastGeneric\"><text>Hello</text></binding></visual></toast>";
+    IToastNotificationManagerStatics *manager;
+    IToastNotifier *notifier;
+    IScheduledToastNotification *scheduled, *scheduled2, *item;
+    IVectorView_ScheduledToastNotification *list;
+    IScheduledToastNotification2 *scheduled_2;
+    IXmlDocument *content = new_document();
+    FILETIME ft;
+    INT64 now, delivery;
+    HSTRING name, str;
+    DateTime time;
+    UINT32 size;
+    HRESULT hr;
+
+    if (!content) return;
+    load( content, toast_xml, NULL );
+
+    name = hs( RuntimeClass_Windows_UI_Notifications_ToastNotificationManager );
+    hr = RoGetActivationFactory( name, &IID_IToastNotificationManagerStatics, (void **)&manager );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    WindowsDeleteString( name );
+    if (hr != S_OK) goto done;
+    name = hs( L"windows.ui.test" );
+    hr = IToastNotificationManagerStatics_CreateToastNotifierWithId( manager, name, &notifier );
+    ok( hr == S_OK && notifier, "got hr %#lx\n", hr );
+    WindowsDeleteString( name );
+    IToastNotificationManagerStatics_Release( manager );
+
+    GetSystemTimeAsFileTime( &ft );
+    now = ((INT64)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    delivery = now + 3600 * 10000000LL;
+
+    scheduled = new_scheduled( content, delivery );
+    scheduled2 = new_scheduled( content, delivery + 10000000LL );
+    ok( scheduled && scheduled2, "scheduled toasts\n" );
+
+    hr = IScheduledToastNotification_get_DeliveryTime( scheduled, &time );
+    ok( hr == S_OK && time.UniversalTime == delivery, "got hr %#lx\n", hr );
+    hr = IScheduledToastNotification_QueryInterface( scheduled, &IID_IScheduledToastNotification2, (void **)&scheduled_2 );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    str = hs( L"tag1" );
+    hr = IScheduledToastNotification2_put_Tag( scheduled_2, str );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    WindowsDeleteString( str );
+    str = NULL;
+    IScheduledToastNotification2_get_Tag( scheduled_2, &str );
+    check_str( str, L"tag1" );
+    WindowsDeleteString( str );
+    IScheduledToastNotification2_Release( scheduled_2 );
+
+    /* in the past: refused */
+    item = new_scheduled( content, now - 10000000LL );
+    hr = IToastNotifier_AddToSchedule( notifier, item );
+    ok( hr == E_INVALIDARG, "got hr %#lx\n", hr );
+    IScheduledToastNotification_Release( item );
+
+    hr = IToastNotifier_AddToSchedule( notifier, scheduled );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    hr = IToastNotifier_AddToSchedule( notifier, scheduled2 );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+
+    hr = IToastNotifier_GetScheduledToastNotifications( notifier, &list );
+    ok( hr == S_OK && list, "got hr %#lx\n", hr );
+    size = 0;
+    hr = IVectorView_ScheduledToastNotification_get_Size( list, &size );
+    ok( hr == S_OK && size == 2, "got hr %#lx, size %u\n", hr, size );
+    hr = IVectorView_ScheduledToastNotification_GetAt( list, 0, &item );
+    ok( hr == S_OK && item == scheduled, "got hr %#lx, item %p\n", hr, item );
+    if (hr == S_OK) IScheduledToastNotification_Release( item );
+    hr = IVectorView_ScheduledToastNotification_GetAt( list, 2, &item );
+    ok( hr == E_BOUNDS, "got hr %#lx\n", hr );
+    IVectorView_ScheduledToastNotification_Release( list );
+
+    hr = IToastNotifier_RemoveFromSchedule( notifier, scheduled );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    hr = IToastNotifier_GetScheduledToastNotifications( notifier, &list );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    size = 0;
+    IVectorView_ScheduledToastNotification_get_Size( list, &size );
+    ok( size == 1, "got size %u\n", size );
+    IVectorView_ScheduledToastNotification_Release( list );
+    IToastNotifier_RemoveFromSchedule( notifier, scheduled2 );
+
+    IScheduledToastNotification_Release( scheduled );
+    IScheduledToastNotification_Release( scheduled2 );
+    IToastNotifier_Release( notifier );
+done:
+    IXmlDocument_Release( content );
+}
+
+START_TEST(xmldom)
+{
+    HRESULT hr;
+
+    hr = RoInitialize( RO_INIT_MULTITHREADED );
+    ok( hr == S_OK, "RoInitialize failed, hr %#lx\n", hr );
+
+    test_namespaces();
+    test_node_kinds();
+    test_prefix();
+    test_schedule();
+
+    RoUninitialize();
+}
