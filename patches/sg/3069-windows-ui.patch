+    UINT32 i;
+
+    if (!index || !found) return E_POINTER;
+    *index = 0;
+    *found = FALSE;
+    for (i = 0; i < impl->count; i++)
+        if (impl->items[i] == element) { *index = i; *found = TRUE; break; }
+    return S_OK;
