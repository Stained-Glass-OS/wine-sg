+static AsyncStatus finished_status( struct finished_action *impl )
+{
+    return SUCCEEDED( impl->result ) ? Completed : Error;
+}
+
+static HRESULT WINAPI finished_action_put_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler *handler )
+{
+    struct finished_action *impl = impl_from_IAsyncAction( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (impl->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if (!handler) return S_OK;
+    IAsyncActionCompletedHandler_AddRef( (impl->handler = handler) );
+    /* the work is done: the handler hears of it at once */
+    IAsyncActionCompletedHandler_Invoke( handler, iface, finished_status( impl ) );
+    return S_OK;
+}
