+    return impl_from_IScheduledToastNotification( iface );
+}
+
+static INT64 now_ticks(void)
+{
+    FILETIME ft;
+    GetSystemTimeAsFileTime( &ft );
+    return ((INT64)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+}
+
+/* show a due toast through the notifier it was scheduled with */
+static void deliver( struct scheduled *item, struct notifier *notifier )
+{
+    IToastNotification *toast;
+    struct toast *impl;
+
+    if (FAILED( create_toast( item->content, &toast ) )) return;
+    if ((impl = unsafe_impl_from_IToastNotification( toast )))
+    {
+        EnterCriticalSection( &impl->cs );
+        WindowsDuplicateString( item->tag, &impl->tag );
+        WindowsDuplicateString( item->group, &impl->group );
+        impl->suppress_popup = item->suppress_popup;
+        LeaveCriticalSection( &impl->cs );
+    }
+    notifier_Show( &notifier->IToastNotifier_iface, toast );
+    IToastNotification_Release( toast );
+}
+
+static void release_notifier( struct notifier *notifier )
+{
+    if (notifier) IToastNotifier_Release( &notifier->IToastNotifier_iface );
+}
+
+static DWORD WINAPI schedule_thread( void *arg )
+{
+    for (;;)
+    {
+        struct scheduled *due = NULL, *item;
+        struct notifier *notifier = NULL;
+        INT64 now = now_ticks(), next = 0;
+        DWORD wait = INFINITE;
+
+        EnterCriticalSection( &schedule_cs );
+        LIST_FOR_EACH_ENTRY( item, &schedule, struct scheduled, entry )
+            if (!next || item->delivery < next) next = item->delivery;
+        if (next)
+        {
+            if (next <= now)
+            {
+                LIST_FOR_EACH_ENTRY( item, &schedule, struct scheduled, entry )
+                    if (item->delivery == next) { due = item; break; }
+                notifier = due->notifier;
+                IScheduledToastNotification_AddRef( &due->IScheduledToastNotification_iface );
+                IToastNotifier_AddRef( &notifier->IToastNotifier_iface );
+                if (due->snoozes_left)
+                {
+                    /* a repeat: the same entry again after the interval */
+                    due->snoozes_left--;
+                    due->delivery += due->snooze;
+                }
+                else
+                {
+                    list_remove( &due->entry );
+                    list_init( &due->entry );
+                    due->notifier = NULL;
+                    IScheduledToastNotification_Release( &due->IScheduledToastNotification_iface );
+                    release_notifier( notifier );   /* the schedule's reference */
+                }
+                wait = 0;
+            }
+            else
+            {
+                INT64 ms = (next - now) / 10000;
+                wait = ms > 0x7ffffff0 ? 0x7ffffff0 : (DWORD)ms + 1;
+            }
+        }
+        LeaveCriticalSection( &schedule_cs );
+
+        if (due)
+        {
+            deliver( due, notifier );
+            IScheduledToastNotification_Release( &due->IScheduledToastNotification_iface );
+            release_notifier( notifier );
+            continue;
+        }
+        WaitForSingleObject( schedule_event, wait );
+    }
+    return 0;
+}
+
+static BOOL start_schedule_thread(void)
+{
+    HANDLE thread;
+    HMODULE module;
+    BOOL ok;
+
+    EnterCriticalSection( &schedule_cs );
+    if (!schedule_thread_started)
+    {
