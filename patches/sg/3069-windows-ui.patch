+static HSTRING hs( const WCHAR *str )
+{
+    HSTRING ret = NULL;
+    WindowsCreateString( str, wcslen( str ), &ret );
+    return ret;
+}
+
+#define check_str( hstr, expect ) check_str_( __LINE__, hstr, expect )
+static void check_str_( int line, HSTRING str, const WCHAR *expect )
+{
+    UINT32 len;
+    const WCHAR *buf = WindowsGetStringRawBuffer( str, &len );
+    ok_( __FILE__, line )( !wcscmp( buf, expect ), "got %s, expected %s\n", debugstr_w( buf ), debugstr_w( expect ) );
+}
+
+static IInspectable *box_string( const WCHAR *str )
+{
+    IPropertyValueStatics *statics;
+    IInspectable *ret = NULL;
+    HSTRING name = hs( L"Windows.Foundation.PropertyValue" ), value = hs( str );
+    HRESULT hr;
+
+    hr = RoGetActivationFactory( name, &IID_IPropertyValueStatics, (void **)&statics );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        IPropertyValueStatics_CreateString( statics, value, &ret );
+        IPropertyValueStatics_Release( statics );
+    }
+    WindowsDeleteString( name );
+    WindowsDeleteString( value );
+    return ret;
+}
+
+static IXmlDocument *new_document(void)
+{
+    HSTRING name = hs( RuntimeClass_Windows_Data_Xml_Dom_XmlDocument );
+    IInspectable *inspectable = NULL;
+    IXmlDocument *doc = NULL;
+    HRESULT hr;
+
+    hr = RoActivateInstance( name, &inspectable );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        hr = IInspectable_QueryInterface( inspectable, &IID_IXmlDocument, (void **)&doc );
+        ok( hr == S_OK, "got hr %#lx\n", hr );
+        IInspectable_Release( inspectable );
+    }
+    WindowsDeleteString( name );
+    return doc;
+}
+
+static void load( IXmlDocument *doc, const WCHAR *xml, IXmlLoadSettings *settings )
+{
+    IXmlDocumentIO *io;
+    HSTRING str = hs( xml );
+    HRESULT hr;
+
+    hr = IXmlDocument_QueryInterface( doc, &IID_IXmlDocumentIO, (void **)&io );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    if (settings) hr = IXmlDocumentIO_LoadXmlWithSettings( io, str, settings );
+    else hr = IXmlDocumentIO_LoadXml( io, str );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    IXmlDocumentIO_Release( io );
+    WindowsDeleteString( str );
+}
+
+static void test_namespaces(void)
+{
+    static const WCHAR xml[] = L"<r xmlns:a=\"urn:a\" xmlns:b=\"urn:b\"><a:x id=\"1\"/><b:x id=\"2\"/><a:x id=\"3\"/></r>";
+    IXmlDocument *doc = new_document();
+    IXmlNodeSelector *selector;
+    IXmlNodeList *list;
+    IXmlNode *node;
+    IXmlElement *root, *element;
+    IInspectable *ns, *uri;
+    HSTRING str, id;
+    UINT32 size;
+    HRESULT hr;
+
+    if (!doc) return;
+    load( doc, xml, NULL );
+
+    hr = IXmlDocument_QueryInterface( doc, &IID_IXmlNodeSelector, (void **)&selector );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+
+    ns = box_string( L"xmlns:p=\"urn:a\"" );
+    str = hs( L"//p:x" );
+    list = NULL;
+    hr = IXmlNodeSelector_SelectNodesNS( selector, str, ns, &list );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    hr = IXmlNodeList_get_Length( list, &size );
+    ok( hr == S_OK && size == 2, "got hr %#lx, size %u\n", hr, size );
+    IXmlNodeList_Release( list );
+    WindowsDeleteString( str );
+
+    str = hs( L"//p:x[@id='3']" );
+    node = NULL;
+    hr = IXmlNodeSelector_SelectSingleNodeNS( selector, str, ns, &node );
+    ok( hr == S_OK && node, "got hr %#lx, node %p\n", hr, node );
+    if (node) IXmlNode_Release( node );
+    WindowsDeleteString( str );
+    IInspectable_Release( ns );
+    IXmlNodeSelector_Release( selector );
+
+    hr = IXmlDocument_get_DocumentElement( doc, &root );
+    ok( hr == S_OK && root, "got hr %#lx\n", hr );
+
+    /* attributes in a namespace */
+    uri = box_string( L"urn:a" );
+    str = hs( L"a:flag" );
+    id = hs( L"on" );
+    hr = IXmlElement_SetAttributeNS( root, uri, str, id );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    WindowsDeleteString( id );
+    WindowsDeleteString( str );
+    str = hs( L"flag" );
+    id = NULL;
+    hr = IXmlElement_GetAttributeNS( root, uri, str, &id );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    check_str( id, L"on" );
+    WindowsDeleteString( id );
+    id = NULL;
+    IInspectable_Release( uri );
+    uri = box_string( L"urn:b" );
+    hr = IXmlElement_GetAttributeNS( root, uri, str, &id );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    check_str( id, L"" );
+    WindowsDeleteString( id );
+    IInspectable_Release( uri );
+
+    uri = box_string( L"urn:a" );
+    hr = IXmlElement_RemoveAttributeNS( root, uri, str );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    id = NULL;
+    hr = IXmlElement_GetAttributeNS( root, uri, str, &id );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    check_str( id, L"" );
+    WindowsDeleteString( id );
+    IInspectable_Release( uri );
+    WindowsDeleteString( str );
+
+    /* a new element and attribute in a namespace */
+    uri = box_string( L"urn:c" );
+    str = hs( L"c:item" );
+    hr = IXmlDocument_CreateElementNS( doc, uri, str, &element );
+    ok( hr == S_OK && element, "got hr %#lx\n", hr );
+    if (element) IXmlElement_Release( element );
+    {
+        IXmlAttribute *attr = NULL;
+        hr = IXmlDocument_CreateAttributeNS( doc, uri, str, &attr );
+        ok( hr == S_OK && attr, "got hr %#lx\n", hr );
+        if (attr) IXmlAttribute_Release( attr );
+    }
+    WindowsDeleteString( str );
+    IInspectable_Release( uri );
+
+    IXmlElement_Release( root );
+    IXmlDocument_Release( doc );
+}
+
+static void test_node_kinds(void)
+{
+    static const WCHAR xml[] = L"<?xml version=\"1.0\"?><!DOCTYPE r [<!ELEMENT r ANY>]><r/>";
+    IXmlDocument *doc = new_document();
+    IXmlLoadSettings *settings;
+    IInspectable *inspectable;
+    IXmlProcessingInstruction *pi;
+    IXmlEntityReference *entity;
+    IXmlDocumentType *doctype;
+    IXmlDomImplementation *impl;
+    IXmlElement *element;
+    HSTRING name, target, data;
+    IInspectable *version;
+    boolean flag;
+    UINT32 depth;
+    HRESULT hr;
+
+    if (!doc) return;
+
+    name = hs( RuntimeClass_Windows_Data_Xml_Dom_XmlLoadSettings );
+    hr = RoActivateInstance( name, &inspectable );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    WindowsDeleteString( name );
+    hr = IInspectable_QueryInterface( inspectable, &IID_IXmlLoadSettings, (void **)&settings );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    IInspectable_Release( inspectable );
+    hr = IXmlLoadSettings_get_ProhibitDtd( settings, &flag );
+    ok( hr == S_OK && flag, "got hr %#lx, prohibit %d\n", hr, flag );
+    hr = IXmlLoadSettings_get_MaxElementDepth( settings, &depth );
+    ok( hr == S_OK && depth, "got hr %#lx, depth %u\n", hr, depth );
+    hr = IXmlLoadSettings_put_MaxElementDepth( settings, 3 );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    hr = IXmlLoadSettings_get_MaxElementDepth( settings, &depth );
+    ok( hr == S_OK && depth == 3, "got hr %#lx, depth %u\n", hr, depth );
+    IXmlLoadSettings_put_ProhibitDtd( settings, FALSE );
+    IXmlLoadSettings_put_MaxElementDepth( settings, 64 );
+
+    load( doc, xml, settings );
+    IXmlLoadSettings_Release( settings );
+
+    hr = IXmlDocument_get_Doctype( doc, &doctype );
+    ok( hr == S_OK && doctype, "got hr %#lx, doctype %p\n", hr, doctype );
+    if (doctype)
+    {
+        name = NULL;
+        hr = IXmlDocumentType_get_Name( doctype, &name );
+        ok( hr == S_OK, "got hr %#lx\n", hr );
+        check_str( name, L"r" );
+        WindowsDeleteString( name );
+        IXmlDocumentType_Release( doctype );
+    }
+
+    target = hs( L"app" );
+    data = hs( L"mode=\"fast\"" );
+    hr = IXmlDocument_CreateProcessingInstruction( doc, target, data, &pi );
+    ok( hr == S_OK && pi, "got hr %#lx\n", hr );
+    if (pi)
+    {
+        name = NULL;
+        hr = IXmlProcessingInstruction_get_Target( pi, &name );
+        ok( hr == S_OK, "got hr %#lx\n", hr );
+        check_str( name, L"app" );
+        WindowsDeleteString( name );
+        name = NULL;
+        hr = IXmlProcessingInstruction_get_Data( pi, &name );
+        ok( hr == S_OK, "got hr %#lx\n", hr );
+        check_str( name, L"mode=\"fast\"" );
+        WindowsDeleteString( name );
+        WindowsDeleteString( data );
+        data = hs( L"mode=\"slow\"" );
+        hr = IXmlProcessingInstruction_put_Data( pi, data );
+        ok( hr == S_OK, "got hr %#lx\n", hr );
+        name = NULL;
+        IXmlProcessingInstruction_get_Data( pi, &name );
+        check_str( name, L"mode=\"slow\"" );
+        WindowsDeleteString( name );
+        IXmlProcessingInstruction_Release( pi );
+    }
+    WindowsDeleteString( target );
+    WindowsDeleteString( data );
+
+    name = hs( L"amp" );
+    hr = IXmlDocument_CreateEntityReference( doc, name, &entity );
+    ok( hr == S_OK && entity, "got hr %#lx\n", hr );
+    if (entity) IXmlEntityReference_Release( entity );
+    WindowsDeleteString( name );
+
+    hr = IXmlDocument_get_Implementation( doc, &impl );
+    ok( hr == S_OK && impl, "got hr %#lx\n", hr );
+    if (impl)
+    {
+        name = hs( L"XML" );
+        version = box_string( L"1.0" );
+        flag = FALSE;
+        hr = IXmlDomImplementation_HasFeature( impl, name, version, &flag );
+        ok( hr == S_OK && flag, "got hr %#lx, flag %d\n", hr, flag );
+        IInspectable_Release( version );
+        WindowsDeleteString( name );
+        IXmlDomImplementation_Release( impl );
+    }
+
+    name = hs( L"nothing" );
+    element = (IXmlElement *)0xdead;
+    hr = IXmlDocument_GetElementById( doc, name, &element );
+    ok( hr == S_OK && !element, "got hr %#lx, element %p\n", hr, element );
+    WindowsDeleteString( name );
+
+    IXmlDocument_Release( doc );
+}
+
+static void test_prefix(void)
+{
+    IXmlDocument *doc = new_document();
+    IXmlElement *root;
+    IXmlNode *node;
+    IInspectable *prefix;
+    HSTRING name;
+    HRESULT hr;
+
+    if (!doc) return;
+    load( doc, L"<r xmlns:q=\"urn:q\"><c a=\"1\"><d/></c></r>", NULL );
+    hr = IXmlDocument_get_DocumentElement( doc, &root );
+    ok( hr == S_OK && root, "got hr %#lx\n", hr );
+    hr = IXmlElement_QueryInterface( root, &IID_IXmlNode, (void **)&node );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    prefix = box_string( L"q" );
+    hr = IXmlNode_put_Prefix( node, prefix );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    IInspectable_Release( prefix );
+    name = NULL;
+    hr = IXmlNode_get_NodeName( node, &name );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    check_str( name, L"q:r" );
+    WindowsDeleteString( name );
+    IXmlNode_Release( node );
+    IXmlElement_Release( root );
+    IXmlDocument_Release( doc );
+}
