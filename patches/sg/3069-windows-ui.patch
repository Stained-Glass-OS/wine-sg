+static HRESULT scheduled_create( IXmlDocument *content, DateTime delivery, INT64 snooze, UINT32 max_snooze,
+                                 IScheduledToastNotification **out )
+{
+    struct scheduled *impl;
+
+    *out = NULL;
+    if (!content) return E_POINTER;
+    /* a repeat needs both an interval (60 seconds to 60 minutes) and a count (1 to 5) */
+    if (snooze || max_snooze)
+    {
+        if (snooze < 60 * 10000000LL || snooze > 3600 * 10000000LL || max_snooze < 1 || max_snooze > 5)
+            return E_INVALIDARG;
+    }
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IScheduledToastNotification_iface.lpVtbl = &scheduled_vtbl;
+    impl->IScheduledToastNotification2_iface.lpVtbl = &scheduled2_vtbl;
+    impl->IScheduledToastNotification3_iface.lpVtbl = &scheduled3_vtbl;
+    impl->IScheduledToastNotification4_iface.lpVtbl = &scheduled4_vtbl;
+    impl->ref = 1;
+    IXmlDocument_AddRef( (impl->content = content) );
+    impl->delivery = delivery.UniversalTime;
+    impl->snooze = snooze;
+    impl->max_snooze = max_snooze;
+    *out = &impl->IScheduledToastNotification_iface;
+    return S_OK;
+}
