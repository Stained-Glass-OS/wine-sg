+    if (!This->path) return E_FAIL;
+    if (!(sources = operation_sources(item))) return E_INVALIDARG;
+    if (!(dest = calloc(wcslen(This->path) + 2, sizeof(WCHAR))))
+    {
+        free(sources);
+        return E_OUTOFMEMORY;
+    }
+    wcscpy(dest, This->path);
+    VariantInit(&flags);
