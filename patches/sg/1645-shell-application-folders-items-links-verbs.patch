+static HRESULT folder_file_operation(FolderImpl *This, UINT func, VARIANT *item, VARIANT *options)
+{
+    SHFILEOPSTRUCTW op = { 0 };
+    WCHAR *sources, *dest;
+    VARIANT flags;
+    int ret;
