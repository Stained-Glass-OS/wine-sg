+/* Stained Glass OS (1645): an IEnumVARIANT over a collection's objects
+ * (FolderItems, FolderItemVerbs: For Each in scripts) */
+typedef struct {
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+    IDispatch **items;
+    ULONG count;
+    ULONG pos;
+} DispEnum;
+
