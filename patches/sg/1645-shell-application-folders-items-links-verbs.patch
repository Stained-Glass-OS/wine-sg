 static inline ShellDispatch *impl_from_IShellDispatch6(IShellDispatch6 *iface)
 {
     return CONTAINING_RECORD(iface, ShellDispatch, IShellDispatch6_iface);
@@ -200,6 +215,245 @@ HRESULT get_typeinfo(enum tid_t tid, ITypeInfo **typeinfo)
     return S_OK;
 }
 
+
+static inline DispEnum *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, DispEnum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI DispEnum_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumVARIANT))
+    {
+        *ppv = iface;
+        IEnumVARIANT_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI DispEnum_AddRef(IEnumVARIANT *iface)
+{
+    DispEnum *This = impl_from_IEnumVARIANT(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI DispEnum_Release(IEnumVARIANT *iface)
+{
+    DispEnum *This = impl_from_IEnumVARIANT(iface);
+    ULONG ref = InterlockedDecrement(&This->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) if (This->items[i]) IDispatch_Release(This->items[i]);
+        free(This->items);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI DispEnum_Next(IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched)
+{
+    DispEnum *This = impl_from_IEnumVARIANT(iface);
+    ULONG i;
+
+    for (i = 0; i < celt && This->pos < This->count; i++, This->pos++)
+    {
+        V_VT(&var[i]) = VT_DISPATCH;
+        V_DISPATCH(&var[i]) = This->items[This->pos];
+        if (V_DISPATCH(&var[i])) IDispatch_AddRef(V_DISPATCH(&var[i]));
+    }
+    if (fetched) *fetched = i;
+    return i == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI DispEnum_Skip(IEnumVARIANT *iface, ULONG celt)
+{
+    DispEnum *This = impl_from_IEnumVARIANT(iface);
+
+    if (This->count - This->pos < celt)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI DispEnum_Reset(IEnumVARIANT *iface)
+{
+    impl_from_IEnumVARIANT(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_disp_enum(IDispatch **items, ULONG count, ULONG pos, IEnumVARIANT **ret);
+
+static HRESULT WINAPI DispEnum_Clone(IEnumVARIANT *iface, IEnumVARIANT **ret)
+{
+    DispEnum *This = impl_from_IEnumVARIANT(iface);
+    IDispatch **items;
+    ULONG i;
+
+    if (!ret) return E_POINTER;
+    if (!(items = calloc(This->count + 1, sizeof(*items)))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++)
+        if ((items[i] = This->items[i])) IDispatch_AddRef(items[i]);
+    return create_disp_enum(items, This->count, This->pos, ret);
+}
+
+static const IEnumVARIANTVtbl DispEnumVtbl =
+{
+    DispEnum_QueryInterface,
+    DispEnum_AddRef,
+    DispEnum_Release,
+    DispEnum_Next,
+    DispEnum_Skip,
+    DispEnum_Reset,
+    DispEnum_Clone
+};
+
+/* takes the array and its references */
+static HRESULT create_disp_enum(IDispatch **items, ULONG count, ULONG pos, IEnumVARIANT **ret)
+{
+    DispEnum *This;
+    ULONG i;
+
+    if (!(This = malloc(sizeof(*This))))
+    {
+        for (i = 0; i < count; i++) if (items[i]) IDispatch_Release(items[i]);
+        free(items);
+        return E_OUTOFMEMORY;
+    }
+    This->IEnumVARIANT_iface.lpVtbl = &DispEnumVtbl;
+    This->ref = 1;
+    This->items = items;
+    This->count = count;
+    This->pos = pos;
+    *ret = &This->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+/* the text of a verb or menu item without its accelerator mark */
+static void strip_accelerator(const WCHAR *src, WCHAR *dst, size_t size)
+{
+    size_t n = 0;
+
+    for (; *src && n + 1 < size; src++)
+    {
+        if (*src == '&')
+        {
+            if (src[1] == '&') dst[n++] = *++src;
+            continue;
+        }
+        if (*src == '\t') break;
+        dst[n++] = *src;
+    }
+    dst[n] = 0;
+}
+
+/* invoke a context menu's command: a canonical verb ("open", "properties"),
+ * or the text of one of its menu items ("&Open" or "Open"); none: the
+ * default command */
+static HRESULT invoke_context_menu(IContextMenu *menu, HMENU hmenu, const WCHAR *verb, const WCHAR *params)
+{
+    CMINVOKECOMMANDINFOEX info;
+    char verbA[128];
+    UINT id = ~0u;
+    int i, count;
+
+    memset(&info, 0, sizeof(info));
+    info.cbSize = sizeof(info);
+    info.fMask = CMIC_MASK_UNICODE | CMIC_MASK_FLAG_NO_UI;
+    info.nShow = SW_SHOWNORMAL;
+    info.lpParametersW = params;
+    if (params)
+    {
+        info.lpParameters = NULL;
+    }
+
+    if (!verb || !verb[0])
+    {
+        id = GetMenuDefaultItem(hmenu, FALSE, 0);
+        if (id == ~0u) id = GetMenuItemID(hmenu, 0);
+        if (id == ~0u) return S_FALSE;
+    }
+    else
+    {
+        WideCharToMultiByte(CP_ACP, 0, verb, -1, verbA, sizeof(verbA), NULL, NULL);
+        info.lpVerb = verbA;
+        info.lpVerbW = verb;
+        if (SUCCEEDED(IContextMenu_InvokeCommand(menu, (CMINVOKECOMMANDINFO *)&info))) return S_OK;
+
+        /* a menu item's text */
+        count = GetMenuItemCount(hmenu);
+        for (i = 0; i < count; i++)
+        {
+            WCHAR text[256], plain[256], want[256];
+            if (!GetMenuStringW(hmenu, i, text, ARRAY_SIZE(text), MF_BYPOSITION)) continue;
+            strip_accelerator(text, plain, ARRAY_SIZE(plain));
+            strip_accelerator(verb, want, ARRAY_SIZE(want));
+            if (!wcsicmp(plain, want) || !wcsicmp(text, verb))
+            {
+                id = GetMenuItemID(hmenu, i);
+                break;
+            }
+        }
+        if (id == ~0u) return S_FALSE;
+    }
+    info.lpVerb = MAKEINTRESOURCEA(id - FCIDM_SHVIEWFIRST);
+    info.lpVerbW = MAKEINTRESOURCEW(id - FCIDM_SHVIEWFIRST);
+    return IContextMenu_InvokeCommand(menu, (CMINVOKECOMMANDINFO *)&info);
+}
+
+/* a context menu (and its items) for some of a folder's children */
+static HRESULT get_context_menu(const WCHAR **paths, UINT count, IContextMenu **menu, HMENU *hmenu)
+{
+    LPITEMIDLIST *pidls, parent_pidl = NULL;
+    LPCITEMIDLIST *children;
+    IShellFolder *parent = NULL;
+    HRESULT hr = S_OK;
+    UINT i;
+
+    *menu = NULL;
+    *hmenu = NULL;
+    if (!count) return E_INVALIDARG;
+    pidls = calloc(count, sizeof(*pidls));
+    children = calloc(count, sizeof(*children));
+    if (!pidls || !children) hr = E_OUTOFMEMORY;
+    for (i = 0; SUCCEEDED(hr) && i < count; i++)
+    {
+        if (FAILED(hr = SHParseDisplayName(paths[i], NULL, &pidls[i], 0, NULL))) break;
+        children[i] = ILFindLastID(pidls[i]);
+    }
+    if (SUCCEEDED(hr) && (parent_pidl = ILClone(pidls[0])))
+    {
+        ILRemoveLastID(parent_pidl);
+        hr = SHBindToObject(NULL, parent_pidl, NULL, &IID_IShellFolder, (void **)&parent);
+    }
+    else if (SUCCEEDED(hr)) hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr))
+        hr = IShellFolder_GetUIObjectOf(parent, NULL, count, children, &IID_IContextMenu, NULL, (void **)menu);
+    if (SUCCEEDED(hr))
+    {
+        *hmenu = CreatePopupMenu();
+        hr = IContextMenu_QueryContextMenu(*menu, *hmenu, 0, FCIDM_SHVIEWFIRST, FCIDM_SHVIEWLAST, CMF_NORMAL);
+        if (FAILED(hr))
+        {
+            DestroyMenu(*hmenu);
+            *hmenu = NULL;
+            IContextMenu_Release(*menu);
+            *menu = NULL;
+        }
+    }
+    if (parent) IShellFolder_Release(parent);
+    ILFree(parent_pidl);
+    for (i = 0; pidls && i < count; i++) ILFree(pidls[i]);
+    free(pidls);
+    free(children);
+    return hr;
+}
