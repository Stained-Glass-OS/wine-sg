+/* device capabilities: the events a scanner sends */
+
+struct enum_caps
+{
+    IEnumWIA_DEV_CAPS IEnumWIA_DEV_CAPS_iface;
+    LONG ref;
+    ULONG pos;
+};
+
+static const struct { const GUID *guid; const WCHAR *name; } device_events[] =
+{
+    { &WIA_EVENT_DEVICE_CONNECTED, L"Device connected" },
+    { &WIA_EVENT_DEVICE_DISCONNECTED, L"Device disconnected" },
+};
+
+static inline struct enum_caps *impl_from_IEnumWIA_DEV_CAPS(IEnumWIA_DEV_CAPS *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_caps, IEnumWIA_DEV_CAPS_iface);
+}
+
+static HRESULT WINAPI enum_caps_QueryInterface(IEnumWIA_DEV_CAPS *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumWIA_DEV_CAPS))
+    {
+        IEnumWIA_DEV_CAPS_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_caps_AddRef(IEnumWIA_DEV_CAPS *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumWIA_DEV_CAPS(iface)->ref);
+}
+
+static ULONG WINAPI enum_caps_Release(IEnumWIA_DEV_CAPS *iface)
+{
+    struct enum_caps *This = impl_from_IEnumWIA_DEV_CAPS(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref) free(This);
+    return ref;
+}
+
+static HRESULT WINAPI enum_caps_Next(IEnumWIA_DEV_CAPS *iface, ULONG celt, WIA_DEV_CAP *caps, ULONG *fetched)
+{
+    struct enum_caps *This = impl_from_IEnumWIA_DEV_CAPS(iface);
+    ULONG n = 0;
+
+    if (!caps) return E_POINTER;
+    while (n < celt && This->pos < ARRAY_SIZE(device_events))
+    {
+        memset(&caps[n], 0, sizeof(caps[n]));
+        caps[n].guid = *device_events[This->pos].guid;
+        caps[n].ulFlags = WIA_NOTIFICATION_EVENT;
+        caps[n].bstrName = SysAllocString(device_events[This->pos].name);
+        caps[n].bstrDescription = SysAllocString(device_events[This->pos].name);
+        caps[n].bstrIcon = SysAllocString(L"");
+        caps[n].bstrCommandline = SysAllocString(L"");
+        This->pos++;
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_caps_Skip(IEnumWIA_DEV_CAPS *iface, ULONG celt)
+{
+    struct enum_caps *This = impl_from_IEnumWIA_DEV_CAPS(iface);
+    ULONG left = ARRAY_SIZE(device_events) - This->pos;
+
+    This->pos += min(celt, left);
+    return celt <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_caps_Reset(IEnumWIA_DEV_CAPS *iface)
+{
+    impl_from_IEnumWIA_DEV_CAPS(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_enum_caps(ULONG flags, ULONG pos, IEnumWIA_DEV_CAPS **out);
+
+static HRESULT WINAPI enum_caps_Clone(IEnumWIA_DEV_CAPS *iface, IEnumWIA_DEV_CAPS **out)
+{
+    return create_enum_caps(0, impl_from_IEnumWIA_DEV_CAPS(iface)->pos, out);
+}
+
+static HRESULT WINAPI enum_caps_GetCount(IEnumWIA_DEV_CAPS *iface, ULONG *count)
+{
+    if (!count) return E_POINTER;
+    *count = ARRAY_SIZE(device_events);
+    return S_OK;
+}
+
+static const IEnumWIA_DEV_CAPSVtbl enum_caps_vtbl =
+{
+    enum_caps_QueryInterface,
+    enum_caps_AddRef,
+    enum_caps_Release,
+    enum_caps_Next,
+    enum_caps_Skip,
+    enum_caps_Reset,
+    enum_caps_Clone,
+    enum_caps_GetCount,
+};
+
+static HRESULT create_enum_caps(ULONG flags, ULONG pos, IEnumWIA_DEV_CAPS **out)
+{
+    struct enum_caps *This;
+
+    if (!out) return E_POINTER;
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->IEnumWIA_DEV_CAPS_iface.lpVtbl = &enum_caps_vtbl;
+    This->ref = 1;
+    /* a scanner has no commands but synchronize; its events are listed */
+    This->pos = (flags && !(flags & WIA_DEVICE_EVENTS)) ? ARRAY_SIZE(device_events) : pos;
+    *out = &This->IEnumWIA_DEV_CAPS_iface;
+    return S_OK;
+}
