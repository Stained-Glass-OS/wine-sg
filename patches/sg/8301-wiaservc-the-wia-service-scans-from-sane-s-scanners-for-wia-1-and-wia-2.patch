+static HRESULT WINAPI propstg_ReadPropertyNames(IWiaPropertyStorage *iface, ULONG count, const PROPID *ids,
+                                                LPOLESTR *names)
+{
+    struct wia_propstg *This = impl_from_IWiaPropertyStorage(iface);
+    struct wia_prop *prop;
+    BOOL found = FALSE;
+    ULONG i;
+
+    TRACE("(%p, %lu, %p, %p)\n", This, count, ids, names);
+
+    if (!ids || !names) return E_INVALIDARG;
+    EnterCriticalSection(This->props->cs);
+    for (i = 0; i < count; i++)
+    {
+        names[i] = NULL;
+        if (!(prop = props_find(This->props, ids[i])) || !prop->name) continue;
+        if ((names[i] = CoTaskMemAlloc((wcslen(prop->name) + 1) * sizeof(WCHAR)))) wcscpy(names[i], prop->name);
+        found = TRUE;
+    }
+    LeaveCriticalSection(This->props->cs);
+    return found ? S_OK : S_FALSE;
+}
