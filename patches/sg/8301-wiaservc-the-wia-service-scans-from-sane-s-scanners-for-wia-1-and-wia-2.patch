+/* idtGetData: the proxy of the calling program gives a stream of the file it made */
+static HRESULT WINAPI datatransfer_idtGetData(IWiaDataTransfer *iface, STGMEDIUM *medium, IWiaDataCallback *callback)
+{
+    struct wia_item *item = impl_from_IWiaDataTransfer(iface);
+    struct scan_image img;
+    BYTE *data = NULL;
+    SIZE_T size;
+    GUID format;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %p)\n", item, medium, callback);
+
+    if (!medium) return E_INVALIDARG;
+    if (medium->tymed != TYMED_ISTREAM || !medium->pstm) return E_INVALIDARG;
+    if (FAILED(hr = begin_transfer(item))) return hr;
+    hr = scan_one(item, callback, &img);
+    end_transfer(item, hr == S_OK && item_feeds(item));
+    if (hr != S_OK) return hr;
+
+    if (!props_get_guid(&item->props, WIA_IPA_FORMAT, &format)) format = WiaImgFmt_BMP;
+    hr = encode_image(&img, &format, TRUE, &data, &size);
+    free(img.bits);
+    if (SUCCEEDED(hr)) hr = write_stream(medium->pstm, data, size);
+    free(data);
+    if (SUCCEEDED(hr) && callback)
+    {
+        IWiaDataCallback_BandedDataCallback(callback, IT_MSG_STATUS, IT_STATUS_TRANSFER_TO_CLIENT, 100, 0, 0, 0, 0, NULL);
+        IWiaDataCallback_BandedDataCallback(callback, IT_MSG_TERMINATION, IT_STATUS_TRANSFER_TO_CLIENT, 100, 0, 0, 0, 0, NULL);
+    }
+    return hr;
+}
+
+static HRESULT WINAPI datatransfer_idtGetBandedData(IWiaDataTransfer *iface, WIA_DATA_TRANSFER_INFO *info,
+                                                    IWiaDataCallback *callback)
+{
+    struct wia_item *item = impl_from_IWiaDataTransfer(iface);
+    WIA_DATA_CALLBACK_HEADER header;
+    struct scan_image img;
+    BYTE *data = NULL;
+    SIZE_T size, offset, chunk_size;
+    GUID format;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %p)\n", item, info, callback);
+
+    if (!info || !callback) return E_INVALIDARG;
+    if (info->ulSize < sizeof(*info)) return E_INVALIDARG;
+    if (FAILED(hr = begin_transfer(item))) return hr;
+    hr = scan_one(item, callback, &img);
+    end_transfer(item, hr == S_OK && item_feeds(item));
+    if (hr != S_OK) return hr;
+
+    if (!props_get_guid(&item->props, WIA_IPA_FORMAT, &format)) format = WiaImgFmt_MEMORYBMP;
+    /* a callback gets the bitmap without its file header, as Windows' drivers give it */
+    hr = encode_image(&img, &format, FALSE, &data, &size);
+    free(img.bits);
+    if (FAILED(hr)) return hr;
+
+    memset(&header, 0, sizeof(header));
+    header.lSize = sizeof(header);
+    header.guidFormatID = format;
+    header.lBufferSize = size;
+    header.lPageCount = 1;
+    hr = IWiaDataCallback_BandedDataCallback(callback, IT_MSG_DATA_HEADER, IT_STATUS_TRANSFER_TO_CLIENT, 0, 0,
+                                             sizeof(header), 0, sizeof(header), (BYTE *)&header);
+    chunk_size = max(info->ulBufferSize, 4096);
+    for (offset = 0; hr == S_OK && offset < size; offset += chunk_size)
+    {
+        LONG len = min(chunk_size, size - offset);
+        if (InterlockedCompareExchange(&item->cancelled, 0, 0)) hr = S_FALSE;
+        else hr = IWiaDataCallback_BandedDataCallback(callback, IT_MSG_DATA, IT_STATUS_TRANSFER_TO_CLIENT,
+                                                      (LONG)((offset + len) * 100 / size), offset, len, 0, len,
+                                                      data + offset);
+    }
+    free(data);
+    if (hr == S_OK)
+        hr = IWiaDataCallback_BandedDataCallback(callback, IT_MSG_TERMINATION, IT_STATUS_TRANSFER_TO_CLIENT, 100, 0,
+                                                 0, 0, 0, NULL);
+    if (FAILED(hr)) return hr;
+    return hr == S_OK ? S_OK : S_FALSE;
+}
