+static HRESULT WINAPI propstg_GetPropertyAttributes(IWiaPropertyStorage *iface, ULONG count, PROPSPEC *specs,
+                                                    ULONG *flags, PROPVARIANT *values)
+{
+    struct wia_propstg *This = impl_from_IWiaPropertyStorage(iface);
+    struct wia_prop *prop;
+    BOOL found = FALSE;
+    ULONG i;
+
+    TRACE("(%p, %lu, %p, %p, %p)\n", This, count, specs, flags, values);
+
+    if (!specs || !flags || !values) return E_INVALIDARG;
+    EnterCriticalSection(This->props->cs);
+    for (i = 0; i < count; i++)
