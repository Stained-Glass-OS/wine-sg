+static const WCHAR imaging_class_path[] =
+    L"SYSTEM\\CurrentControlSet\\Control\\Class\\{6bdd1fc6-810f-11d0-bec7-08002be2092f}";
+static const WCHAR imaging_class_guid[] = L"{6BDD1FC6-810F-11D0-BEC7-08002BE2092F}";
+
+static INIT_ONCE sane_once = INIT_ONCE_STATIC_INIT;
+static BOOL sane_ready;
+static CRITICAL_SECTION sane_cs;
+static CRITICAL_SECTION_DEBUG sane_cs_debug =
+{
+    0, 0, &sane_cs,
+    { &sane_cs_debug.ProcessLocksList, &sane_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": sane_cs") }
+};
+static CRITICAL_SECTION sane_cs = { &sane_cs_debug, -1, 0, 0, 0, 0 };
+
+static BOOL WINAPI init_sane(INIT_ONCE *once, void *param, void **context)
+{
+    if (__wine_init_unix_call() || SANE_CALL(process_attach, NULL))
+        WARN("SANE is not available: no scanners\n");
+    else sane_ready = TRUE;
+    return TRUE;
+}
+
+BOOL wia_sane_init(void)
+{
+    InitOnceExecuteOnce(&sane_once, init_sane, NULL, NULL);
+    return sane_ready;
+}
+
+static void utf8_to_wide(const char *src, WCHAR *dst, int size)
+{
+    if (!MultiByteToWideChar(CP_UTF8, 0, src, -1, dst, size)) dst[0] = 0;
+    dst[size - 1] = 0;
+}
+
+static void set_reg_string(HKEY key, const WCHAR *name, const WCHAR *value)
+{
+    RegSetValueExW(key, name, 0, REG_SZ, (const BYTE *)value, (wcslen(value) + 1) * sizeof(WCHAR));
+}
+
+/* A SANE device keeps its WIA device ID: it is the number of its key in the imaging class,
+ * as Windows numbers the devices of a class. */
+static void assign_device_id(struct wia_device_info *dev)
+{
+    WCHAR keyname[16], value[256];
+    DWORD index, size, type, number, dword;
+    HKEY class_key, key;
+    BOOL used[1000] = { 0 };
+
+    swprintf(dev->id, ARRAY_SIZE(dev->id), L"%s\\0000", imaging_class_guid);
+    if (RegCreateKeyExW(HKEY_LOCAL_MACHINE, imaging_class_path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &class_key, NULL))
+        return;
+    for (index = 0; !RegEnumKeyW(class_key, index, keyname, ARRAY_SIZE(keyname)); index++)
+    {
+        number = wcstoul(keyname, NULL, 10);
+        if (number < ARRAY_SIZE(used)) used[number] = TRUE;
+        if (RegOpenKeyExW(class_key, keyname, 0, KEY_READ, &key)) continue;
+        size = sizeof(value);
+        if (!RegQueryValueExW(key, L"SaneDevice", NULL, &type, (BYTE *)value, &size) && type == REG_SZ)
+        {
+            char name[256];
+            WideCharToMultiByte(CP_UTF8, 0, value, -1, name, sizeof(name), NULL, NULL);
+            if (!strcmp(name, dev->sane_name))
+            {
+                swprintf(dev->id, ARRAY_SIZE(dev->id), L"%s\\%s", imaging_class_guid, keyname);
+                RegCloseKey(key);
+                RegCloseKey(class_key);
+                return;
+            }
+        }
+        RegCloseKey(key);
+    }
+    for (number = 0; number < ARRAY_SIZE(used) && used[number]; number++) ;
+    swprintf(keyname, ARRAY_SIZE(keyname), L"%04lu", number);
+    swprintf(dev->id, ARRAY_SIZE(dev->id), L"%s\\%s", imaging_class_guid, keyname);
+    if (!RegCreateKeyExW(class_key, keyname, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL))
+    {
+        utf8_to_wide(dev->sane_name, value, ARRAY_SIZE(value));
+        set_reg_string(key, L"SaneDevice", value);
+        set_reg_string(key, L"DeviceID", dev->id);
+        set_reg_string(key, L"FriendlyName", dev->friendly);
+        set_reg_string(key, L"Vendor", dev->vendor);
+        set_reg_string(key, L"DriverDesc", dev->model);
+        set_reg_string(key, L"PortName", dev->port);
+        dword = MAKELONG(0, StiDeviceTypeScanner);
+        RegSetValueExW(key, L"DeviceType", 0, REG_DWORD, (const BYTE *)&dword, sizeof(dword));
+        dword = 0;
+        RegSetValueExW(key, L"Capabilities", 0, REG_DWORD, (const BYTE *)&dword, sizeof(dword));
+        RegCloseKey(key);
+    }
+    RegCloseKey(class_key);
+}
+
+HRESULT wia_enum_devices(struct wia_device_info **devices, unsigned int *count)
+{
+    struct sane_device_params params;
+    struct wia_device_info *list = NULL, *grown;
+    unsigned int n = 0;
+
+    *devices = NULL;
+    *count = 0;
+    if (!wia_sane_init()) return S_OK;
+
+    EnterCriticalSection(&sane_cs);
+    for (params.index = 0; !SANE_CALL(get_device, &params); params.index++)
+    {
+        struct wia_device_info *dev;
+
+        if (!(grown = realloc(list, (n + 1) * sizeof(*list)))) break;
+        list = grown;
+        dev = &list[n++];
+        memset(dev, 0, sizeof(*dev));
+        lstrcpynA(dev->sane_name, params.name, sizeof(dev->sane_name));
+        utf8_to_wide(params.vendor, dev->vendor, ARRAY_SIZE(dev->vendor));
+        utf8_to_wide(params.model, dev->model, ARRAY_SIZE(dev->model));
+        utf8_to_wide(params.name, dev->port, ARRAY_SIZE(dev->port));
+        if (*dev->vendor && wcsicmp(dev->vendor, L"Noname"))
+            swprintf(dev->friendly, ARRAY_SIZE(dev->friendly), L"%s %s", dev->vendor, dev->model);
+        else
+            lstrcpynW(dev->friendly, dev->model, ARRAY_SIZE(dev->friendly));
+        assign_device_id(dev);
+        TRACE("%s: %s (%s)\n", debugstr_w(dev->id), debugstr_w(dev->friendly), debugstr_a(dev->sane_name));
+    }
+    LeaveCriticalSection(&sane_cs);
+    *devices = list;
+    *count = n;
+    return S_OK;
+}
+
+HRESULT wia_device_props(const struct wia_device_info *info, struct wia_props *props, BOOL wia2)
+{
+    props_add_str(props, WIA_DIP_DEV_ID, WIA_PROP_READ, info->id);
+    props_add_str(props, WIA_DIP_VEND_DESC, WIA_PROP_READ, info->vendor);
+    props_add_str(props, WIA_DIP_DEV_DESC, WIA_PROP_READ, info->friendly);
+    props_add_long(props, WIA_DIP_DEV_TYPE, WIA_PROP_READ, MAKELONG(0, StiDeviceTypeScanner));
+    props_add_str(props, WIA_DIP_PORT_NAME, WIA_PROP_READ, info->port);
+    props_add_str(props, WIA_DIP_DEV_NAME, WIA_PROP_READ, info->friendly);
+    props_add_str(props, WIA_DIP_SERVER_NAME, WIA_PROP_READ, L"local");
+    props_add_str(props, WIA_DIP_REMOTE_DEV_ID, WIA_PROP_READ, L"");
+    props_add_str(props, WIA_DIP_UI_CLSID, WIA_PROP_READ, L"{00000000-0000-0000-0000-000000000000}");
+    props_add_long(props, WIA_DIP_HW_CONFIG, WIA_PROP_READ, 0);
+    props_add_str(props, WIA_DIP_BAUDRATE, WIA_PROP_READ, L"");
+    props_add_long(props, WIA_DIP_STI_GEN_CAPABILITIES, WIA_PROP_READ, 0);
+    props_add_str(props, WIA_DIP_WIA_VERSION, WIA_PROP_READ, L"2.0");
+    props_add_str(props, WIA_DIP_DRIVER_VERSION, WIA_PROP_READ, L"1.0.0.0");
+    props_add_str(props, WIA_DIP_PNP_ID, WIA_PROP_READ, info->port);
+    props_add_str(props, WIA_DIP_STI_DRIVER_VERSION, WIA_PROP_READ, L"3");
+    return S_OK;
+}
+
+static BOOL find_device(const WCHAR *id, struct wia_device_info *out)
+{
+    struct wia_device_info *devices;
+    unsigned int count, i;
+    BOOL found = FALSE;
+
+    wia_enum_devices(&devices, &count);
+    for (i = 0; i < count; i++)
+    {
+        if (wcsicmp(devices[i].id, id)) continue;
+        *out = devices[i];
+        found = TRUE;
+        break;
+    }
+    free(devices);
+    return found;
+}
+
+/* item trees: a device as a program sees it after CreateDevice */
+
+enum item_kind { ITEM_ROOT, ITEM_FLATBED, ITEM_FEEDER, ITEM_TOP };
+
+struct scan_caps
+{
+    BOOL flatbed, feeder, duplex;
+    char flatbed_source[64], feeder_source[64], duplex_source[64];
+    char color_mode[64], gray_mode[64], lineart_mode[64];
+    LONG bed_width, bed_height;     /* thousandths of an inch */
+    LONG feed_width, feed_height;
+    LONG res_min, res_max, res_step;
+    LONG res_list[64];
+    unsigned int res_count;         /* 0: a range */
+    LONG optical_res;
+};
+
+struct wia_tree;
+
+struct wia_item
+{
+    IWiaItem IWiaItem_iface;
+    IWiaItem2 IWiaItem2_iface;
+    IWiaDataTransfer IWiaDataTransfer_iface;
+    IWiaTransfer IWiaTransfer_iface;
+    IWiaItemExtras IWiaItemExtras_iface;
+    struct wia_propstg stg;
+    struct wia_tree *tree;
+    enum item_kind kind;
+    WCHAR name[32];
+    WCHAR full_name[64];
+    struct wia_props props;
+    LONG cancelled;
+};
+
+struct wia_tree
+{
+    LONG ref;
+    CRITICAL_SECTION cs;
+    BOOL wia2;
+    struct wia_device_info info;
+    struct scan_caps caps;
+    UINT64 handle;          /* the SANE device while it is open */
+    BOOL batch;             /* a feeder batch is running (WIA 1 hands out a page per transfer) */
+    struct wia_item *items[4];
+    unsigned int count;
+};
+
+static void tree_addref(struct wia_tree *tree)
+{
+    InterlockedIncrement(&tree->ref);
+}
+
+static ULONG tree_release(struct wia_tree *tree)
+{
+    ULONG ref = InterlockedDecrement(&tree->ref);
+    unsigned int i;
+
+    if (!ref)
+    {
+        if (tree->handle)
+        {
+            struct sane_handle_params params = { tree->handle };
+            if (tree->batch) SANE_CALL(cancel, &params);
+            SANE_CALL(close_device, &params);
+        }
+        for (i = 0; i < tree->count; i++)
+        {
+            props_free(&tree->items[i]->props);
+            free(tree->items[i]);
+        }
+        tree->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&tree->cs);
+        free(tree);
+    }
+    return ref;
+}
+
+/* SANE options */
+
+static BOOL find_option(UINT64 handle, const char *name, struct sane_option_params *opt)
+{
+    memset(opt, 0, sizeof(*opt));
+    opt->handle = handle;
+    lstrcpynA(opt->name, name, sizeof(opt->name));
+    SANE_CALL(find_option, opt);
+    return opt->optno != 0;
+}
+
+static int set_option_string(UINT64 handle, const char *name, const char *value)
+{
+    struct sane_option_params opt;
+    struct sane_value_params params = { handle };
+
+    if (!find_option(handle, name, &opt) || !opt.settable || !opt.active) return SANE_UNSUPPORTED;
+    params.optno = opt.optno;
+    lstrcpynA(params.string, value, sizeof(params.string));
+    SANE_CALL(set_value, &params);
+    return params.status;
+}
+
+static int set_option_number(UINT64 handle, const char *name, double value)
+{
+    struct sane_option_params opt;
+    struct sane_value_params params = { handle };
+
+    if (!find_option(handle, name, &opt) || !opt.settable || !opt.active) return SANE_UNSUPPORTED;
+    params.optno = opt.optno;
+    params.value = opt.type == SANE_OPT_FIXED ? SANE_FIX(value) : (int)(value + 0.5);
+    if (opt.constraint == SANE_CONS_RANGE)
+    {
+        if (params.value < opt.min) params.value = opt.min;
+        if (params.value > opt.max) params.value = opt.max;
+    }
+    else if (opt.constraint == SANE_CONS_WORD_LIST && opt.words[0])
+    {
+        int i, best = opt.words[1];
+        for (i = 1; i <= opt.words[0]; i++)
+            if (abs(opt.words[i] - params.value) < abs(best - params.value)) best = opt.words[i];
+        params.value = best;
+    }
+    SANE_CALL(set_value, &params);
+    return params.status;
+}
+
+static double option_number(int type, int value)
+{
+    return type == SANE_OPT_FIXED ? SANE_UNFIX(value) : value;
+}
+
+static BOOL string_in_list(const char *list, const char *const *wanted, char *out, size_t size)
+{
+    const char *p;
+    unsigned int i;
+
+    for (i = 0; wanted[i]; i++)
+        for (p = list; *p; p += strlen(p) + 1)
+            if (!_stricmp(p, wanted[i]) || (wanted[i][0] == '*' && strstr(p, wanted[i] + 1)))
+            {
+                lstrcpynA(out, p, size);
+                return TRUE;
+            }
+    return FALSE;
+}
+
+/* the scan area of the current source, in thousandths of an inch */
+static void read_geometry(UINT64 handle, LONG *width, LONG *height)
+{
+    struct sane_option_params opt;
+
+    *width = 8500;
+    *height = 11690;
+    if (find_option(handle, "br-x", &opt) && opt.constraint == SANE_CONS_RANGE && opt.unit == SANE_UNIT_MM)
+        *width = (LONG)(option_number(opt.type, opt.max) * 1000.0 / 25.4 + 0.5);
+    if (find_option(handle, "br-y", &opt) && opt.constraint == SANE_CONS_RANGE && opt.unit == SANE_UNIT_MM)
+        *height = (LONG)(option_number(opt.type, opt.max) * 1000.0 / 25.4 + 0.5);
+}
+
+static HRESULT open_tree_device(struct wia_tree *tree)
+{
+    struct sane_open_params params;
+
+    if (tree->handle) return S_OK;
+    memset(&params, 0, sizeof(params));
+    lstrcpynA(params.name, tree->info.sane_name, sizeof(params.name));
+    SANE_CALL(open_device, &params);
+    if (params.status == SANE_DEVICE_BUSY) return WIA_ERROR_BUSY;
+    if (params.status) return WIA_ERROR_OFFLINE;
+    tree->handle = params.handle;
+    return S_OK;
+}
+
+static void close_tree_device(struct wia_tree *tree)
+{
+    struct sane_handle_params params = { tree->handle };
+
+    if (!tree->handle) return;
+    SANE_CALL(close_device, &params);
+    tree->handle = 0;
+    tree->batch = FALSE;
+}
+
+static HRESULT read_caps(struct wia_tree *tree)
+{
+    static const char *const flatbed_names[] = { "Flatbed", "Normal", "FlatBed", "*Flatbed", NULL };
+    static const char *const duplex_names[] = { "ADF Duplex", "Duplex", "*Duplex", NULL };
+    static const char *const feeder_names[] = { "ADF", "ADF Front", "Automatic Document Feeder", "*ADF",
+                                                "*Feeder", "*Document", NULL };
+    static const char *const color_names[] = { "Color", "Colour", "*Color", NULL };
+    static const char *const gray_names[] = { "Gray", "Grey", "Grayscale", "*Gray", NULL };
+    static const char *const lineart_names[] = { "Lineart", "Binary", "Black & White", "*Lineart", NULL };
+    struct scan_caps *caps = &tree->caps;
+    struct sane_option_params opt;
+    HRESULT hr;
+    int i;
+
+    if (FAILED(hr = open_tree_device(tree))) return hr;
+
+    if (find_option(tree->handle, "source", &opt) && opt.constraint == SANE_CONS_STRING_LIST)
+    {
+        caps->flatbed = string_in_list(opt.strings, flatbed_names, caps->flatbed_source, sizeof(caps->flatbed_source));
+        caps->duplex = string_in_list(opt.strings, duplex_names, caps->duplex_source, sizeof(caps->duplex_source));
+        caps->feeder = string_in_list(opt.strings, feeder_names, caps->feeder_source, sizeof(caps->feeder_source));
+        if (caps->feeder && caps->duplex && !strcmp(caps->feeder_source, caps->duplex_source)) caps->feeder = FALSE;
+        if (!caps->flatbed && !caps->feeder)
+        {
+            /* a single source of another name: scan from it as from a flatbed */
+            caps->flatbed = TRUE;
+            lstrcpynA(caps->flatbed_source, opt.strings, sizeof(caps->flatbed_source));
+        }
+    }
+    else caps->flatbed = TRUE;
+
+    if (caps->flatbed)
+    {
+        if (*caps->flatbed_source) set_option_string(tree->handle, "source", caps->flatbed_source);
+        read_geometry(tree->handle, &caps->bed_width, &caps->bed_height);
+    }
+    if (caps->feeder)
+    {
+        set_option_string(tree->handle, "source", caps->feeder_source);
+        read_geometry(tree->handle, &caps->feed_width, &caps->feed_height);
+        if (caps->flatbed && *caps->flatbed_source) set_option_string(tree->handle, "source", caps->flatbed_source);
+    }
+
+    if (find_option(tree->handle, "mode", &opt) && opt.constraint == SANE_CONS_STRING_LIST)
+    {
+        string_in_list(opt.strings, color_names, caps->color_mode, sizeof(caps->color_mode));
+        string_in_list(opt.strings, gray_names, caps->gray_mode, sizeof(caps->gray_mode));
+        string_in_list(opt.strings, lineart_names, caps->lineart_mode, sizeof(caps->lineart_mode));
+    }
+    else strcpy(caps->gray_mode, "");
+
+    caps->res_min = 75;
+    caps->res_max = 600;
+    caps->res_step = 1;
+    if (find_option(tree->handle, "resolution", &opt))
+    {
+        if (opt.constraint == SANE_CONS_RANGE)
+        {
+            caps->res_min = max(1, (LONG)option_number(opt.type, opt.min));
+            caps->res_max = max(caps->res_min, (LONG)option_number(opt.type, opt.max));
+            caps->res_step = max(1, (LONG)option_number(opt.type, opt.quant));
+        }
+        else if (opt.constraint == SANE_CONS_WORD_LIST)
+        {
+            for (i = 1; i <= opt.words[0] && caps->res_count < ARRAY_SIZE(caps->res_list); i++)
+                caps->res_list[caps->res_count++] = (LONG)option_number(opt.type, opt.words[i]);
+        }
+    }
+    caps->optical_res = caps->res_count ? caps->res_list[caps->res_count - 1] : caps->res_max;
+    TRACE("flatbed %d %s, feeder %d %s, duplex %d %s, res %ld-%ld/%u, modes %s %s %s\n", caps->flatbed,
+          caps->flatbed_source, caps->feeder, caps->feeder_source, caps->duplex, caps->duplex_source,
+          caps->res_min, caps->res_max, caps->res_count, caps->color_mode, caps->gray_mode, caps->lineart_mode);
+    return S_OK;
+}
+
+static LONG closest_resolution(const struct scan_caps *caps, LONG want)
+{
+    unsigned int i;
+    LONG best;
+
+    if (!caps->res_count)
+    {
+        if (want < caps->res_min) return caps->res_min;
+        if (want > caps->res_max) return caps->res_max;
+        return caps->res_min + (want - caps->res_min) / caps->res_step * caps->res_step;
+    }
+    best = caps->res_list[0];
+    for (i = 1; i < caps->res_count; i++)
+        if (abs(caps->res_list[i] - want) < abs(best - want)) best = caps->res_list[i];
+    return best;
+}
+
+/* item properties */
+
+static const GUID *const item_formats[] =
+    { &WiaImgFmt_BMP, &WiaImgFmt_MEMORYBMP, &WiaImgFmt_PNG, &WiaImgFmt_JPEG, &WiaImgFmt_TIFF, &WiaImgFmt_GIF };
+
+static void item_area(struct wia_item *item, LONG *width, LONG *height)
+{
+    const struct scan_caps *caps = &item->tree->caps;
+    BOOL feeder = item->kind == ITEM_FEEDER;
+
+    if (item->kind == ITEM_TOP)
+        feeder = item->tree->items[0] && (props_get_long(&item->tree->items[0]->props,
+                                                         WIA_DPS_DOCUMENT_HANDLING_SELECT) & FEEDER);
+    *width = feeder ? caps->feed_width : caps->bed_width;
+    *height = feeder ? caps->feed_height : caps->bed_height;
+}
+
+static LONG datatype_depth(LONG datatype)
+{
+    switch (datatype)
+    {
+    case WIA_DATA_THRESHOLD: return 1;
+    case WIA_DATA_GRAYSCALE: return 8;
+    default: return 24;
+    }
+}
+
+/* the values that follow from others: extents and their ranges, the depth, the sizes */
+static void update_item(struct wia_item *item)
+{
+    struct wia_props *props = &item->props;
+    LONG width, height, xres, yres, maxw, maxh, xpos, ypos, xext, yext, depth, stride, palette;
+    GUID format;
+
+    item_area(item, &width, &height);
+    xres = props_get_long(props, WIA_IPS_XRES);
+    yres = props_get_long(props, WIA_IPS_YRES);
+    maxw = max(1, MulDiv(width, xres, 1000));
+    maxh = max(1, MulDiv(height, yres, 1000));
+    xpos = min(props_get_long(props, WIA_IPS_XPOS), maxw - 1);
+    ypos = min(props_get_long(props, WIA_IPS_YPOS), maxh - 1);
+    xext = min(props_get_long(props, WIA_IPS_XEXTENT), maxw - xpos);
+    yext = min(props_get_long(props, WIA_IPS_YEXTENT), maxh - ypos);
+    if (xext < 1) xext = maxw - xpos;
+    if (yext < 1) yext = maxh - ypos;
+    props_set_long(props, WIA_IPS_XPOS, xpos);
+    props_set_long(props, WIA_IPS_YPOS, ypos);
+    props_set_long(props, WIA_IPS_XEXTENT, xext);
+    props_set_long(props, WIA_IPS_YEXTENT, yext);
+    props_set_range(props, WIA_IPS_XPOS, 0, 0, maxw - 1, 1);
+    props_set_range(props, WIA_IPS_YPOS, 0, 0, maxh - 1, 1);
+    props_set_range(props, WIA_IPS_XEXTENT, 1, maxw, maxw, 1);
+    props_set_range(props, WIA_IPS_YEXTENT, 1, maxh, maxh, 1);
+    props_set_long(props, WIA_IPS_MAX_HORIZONTAL_SIZE, width);
+    props_set_long(props, WIA_IPS_MAX_VERTICAL_SIZE, height);
+
+    depth = datatype_depth(props_get_long(props, WIA_IPA_DATATYPE));
+    props_set_long(props, WIA_IPA_DEPTH, depth);
+    props_set_list(props, WIA_IPA_DEPTH, depth, 1, &depth);
+    props_set_long(props, WIA_IPA_CHANNELS_PER_PIXEL, depth == 24 ? 3 : 1);
+    props_set_long(props, WIA_IPA_BITS_PER_CHANNEL, depth == 24 ? 8 : depth);
+    props_set_long(props, WIA_IPA_RAW_BITS_PER_CHANNEL, depth == 24 ? 8 : depth);
+    stride = ((xext * depth + 31) / 32) * 4;
+    palette = depth == 24 ? 0 : (1 << depth) * sizeof(RGBQUAD);
+    props_set_long(props, WIA_IPA_PIXELS_PER_LINE, xext);
+    props_set_long(props, WIA_IPA_NUMBER_OF_LINES, yext);
+    props_set_long(props, WIA_IPA_BYTES_PER_LINE, stride);
+    props_get_guid(props, WIA_IPA_FORMAT, &format);
+    if (IsEqualGUID(&format, &WiaImgFmt_BMP) || IsEqualGUID(&format, &WiaImgFmt_MEMORYBMP))
+        props_set_long(props, WIA_IPA_ITEM_SIZE, sizeof(BITMAPINFOHEADER) + palette + stride * yext +
+                       (IsEqualGUID(&format, &WiaImgFmt_BMP) ? sizeof(BITMAPFILEHEADER) : 0));
+    else
+        props_set_long(props, WIA_IPA_ITEM_SIZE, 0); /* compressed: not known before the scan */
+}
+
+static const WCHAR *format_extension(const GUID *format)
+{
+    if (IsEqualGUID(format, &WiaImgFmt_PNG)) return L"PNG";
+    if (IsEqualGUID(format, &WiaImgFmt_JPEG)) return L"JPG";
+    if (IsEqualGUID(format, &WiaImgFmt_TIFF)) return L"TIF";
+    if (IsEqualGUID(format, &WiaImgFmt_GIF)) return L"GIF";
+    return L"BMP";
+}
+
+static HRESULT item_write(void *ctx, ULONG count, const PROPID *ids, const PROPVARIANT *values)
+{
+    struct wia_item *item = ctx;
+    struct wia_props *props = &item->props;
+    LONG old_xres = props_get_long(props, WIA_IPS_XRES), old_yres = props_get_long(props, WIA_IPS_YRES);
+    BOOL extents_written = FALSE;
+    ULONG i;
+
+    for (i = 0; i < count; i++)
+    {
+        struct wia_prop *prop = props_find(props, ids[i]);
+        PropVariantClear(&prop->value);
+        PropVariantCopy(&prop->value, &values[i]);
+        switch (ids[i])
+        {
+        case WIA_IPS_XPOS: case WIA_IPS_YPOS: case WIA_IPS_XEXTENT: case WIA_IPS_YEXTENT:
+            extents_written = TRUE;
+            break;
+        case WIA_IPA_DEPTH:
+            props_set_long(props, WIA_IPA_DATATYPE, values[i].lVal == 1 ? WIA_DATA_THRESHOLD :
+                           values[i].lVal == 8 ? WIA_DATA_GRAYSCALE : WIA_DATA_COLOR);
+            break;
+        case WIA_IPA_FORMAT:
+            if (values[i].puuid)
+            {
+                struct wia_prop *ext = props_find(props, WIA_IPA_FILENAME_EXTENSION);
+                if (ext)
+                {
+                    SysFreeString(ext->value.bstrVal);
+                    ext->value.bstrVal = SysAllocString(format_extension(values[i].puuid));
+                }
+            }
+            break;
+        case WIA_IPS_CUR_INTENT:
+        {
+            LONG intent = values[i].lVal, res = 0;
+            if (intent & WIA_INTENT_IMAGE_TYPE_COLOR) props_set_long(props, WIA_IPA_DATATYPE, WIA_DATA_COLOR);
+            else if (intent & WIA_INTENT_IMAGE_TYPE_GRAYSCALE) props_set_long(props, WIA_IPA_DATATYPE, WIA_DATA_GRAYSCALE);
+            else if (intent & WIA_INTENT_IMAGE_TYPE_TEXT) props_set_long(props, WIA_IPA_DATATYPE, WIA_DATA_THRESHOLD);
+            if (intent & WIA_INTENT_MINIMIZE_SIZE) res = 150;
+            else if (intent & WIA_INTENT_MAXIMIZE_QUALITY) res = 300;
+            if (res)
+            {
+                res = closest_resolution(&item->tree->caps, res);
+                props_set_long(props, WIA_IPS_XRES, res);
+                props_set_long(props, WIA_IPS_YRES, res);
+            }
+            break;
+        }
+        }
+    }
+
+    /* a new resolution keeps the area: the extents are scaled with it, unless written too */
+    if (!extents_written)
+    {
+        LONG xres = props_get_long(props, WIA_IPS_XRES), yres = props_get_long(props, WIA_IPS_YRES);
+        if (xres != old_xres && old_xres)
+        {
+            props_set_long(props, WIA_IPS_XPOS, MulDiv(props_get_long(props, WIA_IPS_XPOS), xres, old_xres));
+            props_set_long(props, WIA_IPS_XEXTENT, MulDiv(props_get_long(props, WIA_IPS_XEXTENT), xres, old_xres));
+        }
+        if (yres != old_yres && old_yres)
+        {
+            props_set_long(props, WIA_IPS_YPOS, MulDiv(props_get_long(props, WIA_IPS_YPOS), yres, old_yres));
+            props_set_long(props, WIA_IPS_YEXTENT, MulDiv(props_get_long(props, WIA_IPS_YEXTENT), yres, old_yres));
+        }
+    }
+    update_item(item);
+    return S_OK;
+}
+
+static HRESULT root_write(void *ctx, ULONG count, const PROPID *ids, const PROPVARIANT *values)
+{
+    struct wia_item *item = ctx;
+    struct wia_tree *tree = item->tree;
+    ULONG i;
+
+    for (i = 0; i < count; i++)
+    {
+        if (ids[i] == WIA_DPS_DOCUMENT_HANDLING_SELECT)
+        {
+            LONG select = values[i].lVal;
+            /* one source; duplex only with the feeder */
+            if (!(select & (FEEDER | FLATBED)) || (select & FEEDER && select & FLATBED)
+                    || (select & DUPLEX && !(select & FEEDER)))
+                return E_INVALIDARG;
+        }
+    }
+    for (i = 0; i < count; i++)
+    {
+        struct wia_prop *prop = props_find(&item->props, ids[i]);
+        PropVariantClear(&prop->value);
+        PropVariantCopy(&prop->value, &values[i]);
+    }
+    /* the source decides the area of the WIA 1 image item */
+    for (i = 0; i < tree->count; i++)
+        if (tree->items[i]->kind == ITEM_TOP) update_item(tree->items[i]);
+    return S_OK;
+}
+
+static void add_common_item_props(struct wia_item *item, LONG type, const GUID *category)
+{
+    struct wia_props *props = &item->props;
+
+    props_add_str(props, WIA_IPA_ITEM_NAME, WIA_PROP_READ, item->name);
+    props_add_str(props, WIA_IPA_FULL_ITEM_NAME, WIA_PROP_READ, item->full_name);
+    props_add_long(props, WIA_IPA_ITEM_FLAGS, WIA_PROP_READ, type);
+    props_set_flag(props, WIA_IPA_ITEM_FLAGS, type, WiaItemTypeMask);
+    props_add_long(props, WIA_IPA_ACCESS_RIGHTS, WIA_PROP_READ, WIA_ITEM_READ);
+    if (item->tree->wia2) props_add_guid(props, WIA_IPA_ITEM_CATEGORY, WIA_PROP_READ, category);
+}
+
+static void add_image_props(struct wia_item *item)
+{
+    const struct scan_caps *caps = &item->tree->caps;
+    struct wia_props *props = &item->props;
+    LONG datatypes[3], count = 0, res, tymeds[2] = { TYMED_CALLBACK, TYMED_FILE }, tymed;
+    const GUID *formats[ARRAY_SIZE(item_formats)];
+    GUID list[ARRAY_SIZE(item_formats)];
+    unsigned int i, nformats = 0;
+
+    if (*caps->lineart_mode || *caps->gray_mode || *caps->color_mode) datatypes[count++] = WIA_DATA_THRESHOLD;
+    if (*caps->gray_mode || *caps->color_mode) datatypes[count++] = WIA_DATA_GRAYSCALE;
+    if (*caps->color_mode) datatypes[count++] = WIA_DATA_COLOR;
+    if (!count) datatypes[count++] = WIA_DATA_GRAYSCALE;
+
+    props_add_long(props, WIA_IPA_DATATYPE, WIA_PROP_RW, datatypes[count - 1]);
+    props_set_list(props, WIA_IPA_DATATYPE, datatypes[count - 1], count, datatypes);
+    props_add_long(props, WIA_IPA_DEPTH, WIA_PROP_RW, 24);
+    props_add_long(props, WIA_IPA_CHANNELS_PER_PIXEL, WIA_PROP_READ, 3);
+    props_add_long(props, WIA_IPA_BITS_PER_CHANNEL, WIA_PROP_READ, 8);
+    props_add_long(props, WIA_IPA_RAW_BITS_PER_CHANNEL, WIA_PROP_READ, 8);
+    props_add_long(props, WIA_IPA_PLANAR, WIA_PROP_READ, WIA_PACKED_PIXEL);
+    props_add_long(props, WIA_IPS_PHOTOMETRIC_INTERP, WIA_PROP_READ, WIA_PHOTO_WHITE_1);
+
+    /* WIA 2 transfers files and streams; WIA 1 also its callback */
+    for (i = 0; i < ARRAY_SIZE(item_formats); i++)
+        if (!item->tree->wia2 || item_formats[i] != &WiaImgFmt_MEMORYBMP) formats[nformats++] = item_formats[i];
+    for (i = 0; i < nformats; i++) list[i] = *formats[i];
+    tymed = item->tree->wia2 ? TYMED_FILE : TYMED_CALLBACK;
+    props_add_guid(props, WIA_IPA_PREFERRED_FORMAT, WIA_PROP_READ, item->tree->wia2 ? &WiaImgFmt_BMP : &WiaImgFmt_MEMORYBMP);
+    props_add_guid(props, WIA_IPA_FORMAT, WIA_PROP_RW, item->tree->wia2 ? &WiaImgFmt_BMP : &WiaImgFmt_MEMORYBMP);
+    props_set_guid_list(props, WIA_IPA_FORMAT, &list[0], nformats, list);
+    props_add_long(props, WIA_IPA_TYMED, WIA_PROP_RW, tymed);
+    if (item->tree->wia2) props_set_list(props, WIA_IPA_TYMED, TYMED_FILE, 1, &tymeds[1]);
+    else props_set_list(props, WIA_IPA_TYMED, TYMED_CALLBACK, 2, tymeds);
+    props_add_long(props, WIA_IPA_COMPRESSION, WIA_PROP_RW, WIA_COMPRESSION_NONE);
+    props_set_list(props, WIA_IPA_COMPRESSION, WIA_COMPRESSION_NONE, 1, (const LONG[]){ WIA_COMPRESSION_NONE });
+    props_add_str(props, WIA_IPA_FILENAME_EXTENSION, WIA_PROP_READ, L"BMP");
+    props_add_long(props, WIA_IPA_PIXELS_PER_LINE, WIA_PROP_READ, 0);
+    props_add_long(props, WIA_IPA_BYTES_PER_LINE, WIA_PROP_READ, 0);
+    props_add_long(props, WIA_IPA_NUMBER_OF_LINES, WIA_PROP_READ, 0);
+    props_add_long(props, WIA_IPA_ITEM_SIZE, WIA_PROP_READ, 0);
+    props_add_long(props, WIA_IPA_MIN_BUFFER_SIZE, WIA_PROP_READ, 65536);
+    props_add_long(props, WIA_IPA_BUFFER_SIZE, WIA_PROP_READ, 65536);
+
+    props_add_long(props, WIA_IPS_CUR_INTENT, WIA_PROP_RW, WIA_INTENT_NONE);
+    props_set_flag(props, WIA_IPS_CUR_INTENT, WIA_INTENT_NONE, WIA_INTENT_IMAGE_TYPE_MASK | WIA_INTENT_SIZE_MASK);
+    res = closest_resolution(caps, 100);
+    props_add_long(props, WIA_IPS_XRES, WIA_PROP_RW, res);
+    props_add_long(props, WIA_IPS_YRES, WIA_PROP_RW, res);
+    if (caps->res_count)
+    {
+        props_set_list(props, WIA_IPS_XRES, res, caps->res_count, caps->res_list);
+        props_set_list(props, WIA_IPS_YRES, res, caps->res_count, caps->res_list);
+    }
+    else
+    {
+        props_set_range(props, WIA_IPS_XRES, caps->res_min, res, caps->res_max, caps->res_step);
+        props_set_range(props, WIA_IPS_YRES, caps->res_min, res, caps->res_max, caps->res_step);
+    }
+    props_add_long(props, WIA_IPS_XPOS, WIA_PROP_RW, 0);
+    props_add_long(props, WIA_IPS_YPOS, WIA_PROP_RW, 0);
+    props_add_long(props, WIA_IPS_XEXTENT, WIA_PROP_RW, 0);
+    props_add_long(props, WIA_IPS_YEXTENT, WIA_PROP_RW, 0);
+    props_add_long(props, WIA_IPS_BRIGHTNESS, WIA_PROP_RW, 0);
+    props_set_range(props, WIA_IPS_BRIGHTNESS, -1000, 0, 1000, 1);
+    props_add_long(props, WIA_IPS_CONTRAST, WIA_PROP_RW, 0);
+    props_set_range(props, WIA_IPS_CONTRAST, -1000, 0, 1000, 1);
+    props_add_long(props, WIA_IPS_THRESHOLD, WIA_PROP_RW, 128);
+    props_set_range(props, WIA_IPS_THRESHOLD, 0, 128, 255, 1);
+    props_add_long(props, WIA_IPS_ORIENTATION, WIA_PROP_RW, PORTRAIT);
+    props_set_list(props, WIA_IPS_ORIENTATION, PORTRAIT, 1, (const LONG[]){ PORTRAIT });
+    props_add_long(props, WIA_IPS_MAX_HORIZONTAL_SIZE, WIA_PROP_READ, 0);
+    props_add_long(props, WIA_IPS_MAX_VERTICAL_SIZE, WIA_PROP_READ, 0);
+    props_add_long(props, WIA_IPS_MIN_HORIZONTAL_SIZE, WIA_PROP_READ, 1);
+    props_add_long(props, WIA_IPS_MIN_VERTICAL_SIZE, WIA_PROP_READ, 1);
+    props_add_long(props, WIA_IPS_OPTICAL_XRES, WIA_PROP_READ, caps->optical_res);
+    props_add_long(props, WIA_IPS_OPTICAL_YRES, WIA_PROP_READ, caps->optical_res);
+    props_add_long(props, WIA_IPS_WARM_UP_TIME, WIA_PROP_READ, 0);
+    if (item->tree->wia2)
+    {
+        props_add_long(props, WIA_IPS_PREVIEW, WIA_PROP_RW, WIA_FINAL_SCAN);
+        props_set_list(props, WIA_IPS_PREVIEW, WIA_FINAL_SCAN, 2, (const LONG[]){ WIA_FINAL_SCAN, WIA_PREVIEW_SCAN });
+    }
+    if (item->kind == ITEM_FEEDER)
+    {
+        LONG select = FRONT_ONLY, all = FRONT_ONLY;
+        if (item->tree->caps.duplex) all |= DUPLEX;
+        props_add_long(props, WIA_IPS_DOCUMENT_HANDLING_SELECT, WIA_PROP_RW, select);
+        props_set_flag(props, WIA_IPS_DOCUMENT_HANDLING_SELECT, select, all);
+        props_add_long(props, WIA_IPS_PAGES, WIA_PROP_RW, ALL_PAGES);
+        props_set_range(props, WIA_IPS_PAGES, 0, ALL_PAGES, 1000, 1);
+    }
+    item->props.write = item_write;
+    item->props.ctx = item;
+    update_item(item);
+}
+
+static void add_root_props(struct wia_item *item)
+{
+    const struct scan_caps *caps = &item->tree->caps;
+    struct wia_props *props = &item->props;
+    LONG handling = 0, status = 0, select;
+
+    wia_device_props(&item->tree->info, props, item->tree->wia2);
+    if (caps->flatbed)
+    {
+        handling |= FLAT;
+        status |= FLAT_READY;
+        props_add_long(props, WIA_DPS_HORIZONTAL_BED_SIZE, WIA_PROP_READ, caps->bed_width);
+        props_add_long(props, WIA_DPS_VERTICAL_BED_SIZE, WIA_PROP_READ, caps->bed_height);
+    }
+    if (caps->feeder)
+    {
+        handling |= FEED;
+        status |= FEED_READY;
+        props_add_long(props, WIA_DPS_HORIZONTAL_SHEET_FEED_SIZE, WIA_PROP_READ, caps->feed_width);
+        props_add_long(props, WIA_DPS_VERTICAL_SHEET_FEED_SIZE, WIA_PROP_READ, caps->feed_height);
+        props_add_long(props, WIA_DPS_MIN_HORIZONTAL_SHEET_FEED_SIZE, WIA_PROP_READ, 1000);
+        props_add_long(props, WIA_DPS_MIN_VERTICAL_SHEET_FEED_SIZE, WIA_PROP_READ, 1000);
+    }
+    if (caps->duplex) handling |= DUP;
+    props_add_long(props, WIA_DPS_DOCUMENT_HANDLING_CAPABILITIES, WIA_PROP_READ, handling);
+    props_add_long(props, WIA_DPS_DOCUMENT_HANDLING_STATUS, WIA_PROP_READ, status);
+    if (!item->tree->wia2)
+    {
+        select = caps->flatbed ? FLATBED : FEEDER;
+        props_add_long(props, WIA_DPS_DOCUMENT_HANDLING_SELECT, WIA_PROP_RW, select);
+        props_set_flag(props, WIA_DPS_DOCUMENT_HANDLING_SELECT, select,
+                       (caps->flatbed ? FLATBED : 0) | (caps->feeder ? FEEDER : 0) | (caps->duplex ? DUPLEX : 0));
+        props_add_long(props, WIA_DPS_PAGES, WIA_PROP_RW, 1);
+        props_set_range(props, WIA_DPS_PAGES, 0, 1, caps->feeder ? 1000 : 1, 1);
+        props_add_long(props, WIA_DPS_PREVIEW, WIA_PROP_RW, WIA_FINAL_SCAN);
+        props_set_list(props, WIA_DPS_PREVIEW, WIA_FINAL_SCAN, 2, (const LONG[]){ WIA_FINAL_SCAN, WIA_PREVIEW_SCAN });
+        props_add_long(props, WIA_DPS_SHOW_PREVIEW_CONTROL, WIA_PROP_READ, WIA_SHOW_PREVIEW_CONTROL);
+    }
+    props_add_long(props, WIA_DPS_OPTICAL_XRES, WIA_PROP_READ, caps->optical_res);
+    props_add_long(props, WIA_DPS_OPTICAL_YRES, WIA_PROP_READ, caps->optical_res);
+    props_add_long(props, WIA_DPS_MAX_SCAN_TIME, WIA_PROP_READ, 300000);
+    props_add_str(props, WIA_DPA_FIRMWARE_VERSION, WIA_PROP_READ, L"1.0");
+    props_add_long(props, WIA_DPA_CONNECT_STATUS, WIA_PROP_READ, WIA_DEVICE_CONNECTED);
+    add_common_item_props(item, WiaItemTypeRoot | WiaItemTypeFolder | WiaItemTypeDevice, &WIA_CATEGORY_ROOT);
+    item->props.write = root_write;
+    item->props.ctx = item;
+}
+
+static const IWiaItemVtbl item_vtbl;
+static const IWiaItem2Vtbl item2_vtbl;
+static const IWiaDataTransferVtbl datatransfer_vtbl;
+static const IWiaTransferVtbl transfer_vtbl;
+static const IWiaItemExtrasVtbl extras_vtbl;
+
+static IUnknown *item_unknown(struct wia_item *item)
+{
+    return item->tree->wia2 ? (IUnknown *)&item->IWiaItem2_iface : (IUnknown *)&item->IWiaItem_iface;
+}
+
+static struct wia_item *add_item(struct wia_tree *tree, enum item_kind kind, const WCHAR *name, const WCHAR *number)
+{
+    struct wia_item *item;
+
+    if (!(item = calloc(1, sizeof(*item)))) return NULL;
+    item->IWiaItem_iface.lpVtbl = &item_vtbl;
+    item->IWiaItem2_iface.lpVtbl = &item2_vtbl;
+    item->IWiaDataTransfer_iface.lpVtbl = &datatransfer_vtbl;
+    item->IWiaTransfer_iface.lpVtbl = &transfer_vtbl;
+    item->IWiaItemExtras_iface.lpVtbl = &extras_vtbl;
+    item->tree = tree;
+    item->kind = kind;
+    lstrcpynW(item->name, name, ARRAY_SIZE(item->name));
+    if (kind == ITEM_ROOT) swprintf(item->full_name, ARRAY_SIZE(item->full_name), L"%s\\Root", number);
+    else swprintf(item->full_name, ARRAY_SIZE(item->full_name), L"%s\\Root\\%s", number, name);
+    props_init(&item->props, &tree->cs);
+    propstg_init(&item->stg, item_unknown(item), &item->props);
+    tree->items[tree->count++] = item;
+    return item;
+}
+
+HRESULT wia_create_device(const WCHAR *id, BOOL wia2, IUnknown **root)
+{
+    struct wia_tree *tree;
+    struct wia_item *item;
+    const WCHAR *number;
+    HRESULT hr;
+
+    *root = NULL;
+    if (!(tree = calloc(1, sizeof(*tree)))) return E_OUTOFMEMORY;
+    if (!find_device(id, &tree->info))
+    {
+        free(tree);
+        return WIA_S_NO_DEVICE_AVAILABLE;
+    }
+    tree->ref = 1;
+    tree->wia2 = wia2;
+    InitializeCriticalSectionEx(&tree->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    tree->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": wia_tree.cs");
+
+    EnterCriticalSection(&sane_cs);
+    hr = read_caps(tree);
+    /* the device is opened again for each transfer; others may scan in between */
+    close_tree_device(tree);
+    LeaveCriticalSection(&sane_cs);
+    if (FAILED(hr))
+    {
+        tree_release(tree);
+        return hr;
+    }
+
+    number = wcsrchr(tree->info.id, '\\');
+    number = number ? number + 1 : L"0000";
+    item = add_item(tree, ITEM_ROOT, L"Root", number);
+    if (item) add_root_props(item);
+    if (wia2)
+    {
+        if (tree->caps.flatbed && (item = add_item(tree, ITEM_FLATBED, L"Flatbed", number)))
+        {
+            add_common_item_props(item, WiaItemTypeImage | WiaItemTypeFile | WiaItemTypeProgrammableDataSource
+                                  | WiaItemTypeTransfer, &WIA_CATEGORY_FLATBED);
+            add_image_props(item);
+        }
+        if ((tree->caps.feeder || tree->caps.duplex) && (item = add_item(tree, ITEM_FEEDER, L"Feeder", number)))
+        {
+            add_common_item_props(item, WiaItemTypeImage | WiaItemTypeFile | WiaItemTypeProgrammableDataSource
+                                  | WiaItemTypeTransfer, &WIA_CATEGORY_FEEDER);
+            add_image_props(item);
+        }
+    }
+    else if ((item = add_item(tree, ITEM_TOP, L"Top", number)))
+    {
+        add_common_item_props(item, WiaItemTypeImage | WiaItemTypeFile | WiaItemTypeTransfer, NULL);
+        add_image_props(item);
+    }
+    if (!tree->count)
+    {
+        tree_release(tree);
+        return E_OUTOFMEMORY;
+    }
+    *root = item_unknown(tree->items[0]);
+    return S_OK;
+}
+
+/* scanning */
+
+struct scan_image
+{
+    LONG width, height, bpp, stride;     /* bpp 1, 8 or 24; rows top down */
+    LONG xres, yres;
+    BYTE *bits;
+};
+
+typedef HRESULT (*progress_func)(void *ctx, LONG percent);
+
+static HRESULT sane_error(int status)
+{
+    switch (status)
+    {
+    case SANE_NO_DOCS: return WIA_ERROR_PAPER_EMPTY;
+    case SANE_JAMMED: return WIA_ERROR_PAPER_JAM;
+    case SANE_COVER_OPEN: return WIA_ERROR_COVER_OPEN;
+    case SANE_DEVICE_BUSY: return WIA_ERROR_BUSY;
+    case SANE_CANCELLED: return S_FALSE;
+    case SANE_NO_MEM: return E_OUTOFMEMORY;
+    case SANE_ACCESS_DENIED: return E_ACCESSDENIED;
+    case SANE_IO_ERROR: return WIA_ERROR_DEVICE_COMMUNICATION;
+    default: return WIA_ERROR_GENERAL_ERROR;
+    }
+}
+
+/* the source and settings of an item, given to the device */
+static void apply_settings(struct wia_item *item, LONG *datatype)
+{
+    struct wia_tree *tree = item->tree;
+    const struct scan_caps *caps = &tree->caps;
+    struct wia_props *props = &item->props;
+    LONG xres = props_get_long(props, WIA_IPS_XRES), yres = props_get_long(props, WIA_IPS_YRES), select;
+    const char *source = NULL;
+    double l, t, r, b;
+
+    if (item->kind == ITEM_FEEDER)
+        source = props_get_long(props, WIA_IPS_DOCUMENT_HANDLING_SELECT) & DUPLEX ? caps->duplex_source
+                                                                                   : caps->feeder_source;
+    else if (item->kind == ITEM_TOP)
+    {
+        select = props_get_long(&tree->items[0]->props, WIA_DPS_DOCUMENT_HANDLING_SELECT);
+        source = select & FEEDER ? (select & DUPLEX && caps->duplex ? caps->duplex_source : caps->feeder_source)
+                                 : caps->flatbed_source;
+    }
+    else source = caps->flatbed_source;
+    if (source && *source) set_option_string(tree->handle, "source", source);
+
+    *datatype = props_get_long(props, WIA_IPA_DATATYPE);
+    if (*datatype == WIA_DATA_COLOR && *caps->color_mode) set_option_string(tree->handle, "mode", caps->color_mode);
+    else if (*datatype == WIA_DATA_THRESHOLD && *caps->lineart_mode)
+        set_option_string(tree->handle, "mode", caps->lineart_mode);
+    else if (*caps->gray_mode) set_option_string(tree->handle, "mode", caps->gray_mode);
+    else if (*caps->color_mode) set_option_string(tree->handle, "mode", caps->color_mode);
+    if (!(*datatype == WIA_DATA_THRESHOLD && *caps->lineart_mode)) set_option_number(tree->handle, "depth", 8);
+
+    if (set_option_number(tree->handle, "resolution", xres) != SANE_GOOD)
+    {
+        set_option_number(tree->handle, "x-resolution", xres);
+        set_option_number(tree->handle, "y-resolution", yres);
+    }
+    else if (xres != yres) set_option_number(tree->handle, "y-resolution", yres);
+
+    /* pixels at the item's resolution to millimetres */
+    l = props_get_long(props, WIA_IPS_XPOS) * 25.4 / xres;
+    t = props_get_long(props, WIA_IPS_YPOS) * 25.4 / yres;
+    r = l + props_get_long(props, WIA_IPS_XEXTENT) * 25.4 / xres;
+    b = t + props_get_long(props, WIA_IPS_YEXTENT) * 25.4 / yres;
+    set_option_number(tree->handle, "tl-x", l);
+    set_option_number(tree->handle, "tl-y", t);
+    /* a device may round the area to its steps: ask a little more, the image is cut to the extents */
+    set_option_number(tree->handle, "br-x", r + 1.0);
+    set_option_number(tree->handle, "br-y", b + 1.0);
+}
+
+/* the image of exactly the item's extents, as programs expect from the pixels per line and lines
+ * they read (white where the device gave less) */
+static HRESULT fit_image(struct scan_image *img, LONG width, LONG height)
+{
+    LONG stride, y, copy_bytes;
+    BYTE *bits;
+
+    if (width <= 0 || height <= 0 || (img->width == width && img->height == height)) return S_OK;
+    stride = img->bpp == 24 ? width * 3 : img->bpp == 8 ? width : (width + 7) / 8;
+    if (!(bits = malloc((SIZE_T)stride * height))) return E_OUTOFMEMORY;
+    memset(bits, 0xff, (SIZE_T)stride * height);
+    copy_bytes = min(stride, img->stride);
+    for (y = 0; y < min(height, img->height); y++)
+        memcpy(bits + (SIZE_T)y * stride, img->bits + (SIZE_T)y * img->stride, copy_bytes);
+    free(img->bits);
+    img->bits = bits;
+    img->width = width;
+    img->height = height;
+    img->stride = stride;
+    return S_OK;
+}
+
+/* one frame (or the three of a three-pass scanner) into a top-down image */
+static HRESULT read_page(struct wia_item *item, LONG datatype, struct scan_image *img,
+                         progress_func progress, void *ctx)
+{
+    struct wia_tree *tree = item->tree;
+    struct sane_frame_params frame = { tree->handle };
+    struct sane_handle_params start = { tree->handle };
+    struct sane_read_params rd = { tree->handle };
+    BYTE *raw = NULL, *line;
+    LONG x, y, lines, threshold = props_get_long(&item->props, WIA_IPS_THRESHOLD);
+    SIZE_T size = 0, used;
+    int pass = 0, channel = -1, chunk;
+    HRESULT hr = S_OK;
+    BYTE *planes[3] = { NULL };
+
+    memset(img, 0, sizeof(*img));
+    img->xres = props_get_long(&item->props, WIA_IPS_XRES);
+    img->yres = props_get_long(&item->props, WIA_IPS_YRES);
+
+    for (;;)
+    {
+        SANE_CALL(start, &start);
+        if (start.status) return sane_error(start.status);
+        tree->batch = TRUE;
+        SANE_CALL(get_parameters, &frame);
+        if (frame.status) return sane_error(frame.status);
+        TRACE("frame format %d depth %d %dx%d bpl %d last %d\n", frame.format, frame.depth, frame.pixels_per_line,
+              frame.lines, frame.bytes_per_line, frame.last_frame);
+        if (frame.bytes_per_line <= 0 || frame.pixels_per_line <= 0) return WIA_ERROR_INVALID_DRIVER_RESPONSE;
+
+        /* read the frame; a hand scanner does not know its height (-1) */
+        lines = frame.lines > 0 ? frame.lines : 0;
+        size = (SIZE_T)frame.bytes_per_line * (lines ? lines : 64);
+        if (!(raw = malloc(size))) return E_OUTOFMEMORY;
+        used = 0;
+        for (;;)
+        {
+            if (used == size)
+            {
+                BYTE *grown;
+                if (lines || !(grown = realloc(raw, size * 2))) break;
+                raw = grown;
+                size *= 2;
+            }
+            chunk = min(size - used, 1 << 18);
+            rd.buffer = (UINT_PTR)(raw + used);
+            rd.len = chunk;
+            SANE_CALL(read, &rd);
+            used += rd.retlen;
+            if (progress && lines && frame.bytes_per_line)
+            {
+                LONG percent = (LONG)((ULONGLONG)used * 100 / ((SIZE_T)frame.bytes_per_line * lines));
+                if (frame.format >= SANE_FRAME_RED) percent = (pass * 100 + percent) / 3;
+                if ((hr = progress(ctx, min(percent, 99))) != S_OK)
+                {
+                    struct sane_handle_params cancel = { tree->handle };
+                    SANE_CALL(cancel, &cancel);
+                    tree->batch = FALSE;
+                    free(raw);
+                    return S_FALSE;
+                }
+            }
+            if (rd.status == SANE_EOF) break;
+            if (rd.status)
+            {
+                free(raw);
+                return sane_error(rd.status);
+            }
+        }
+        if (!lines) lines = used / frame.bytes_per_line;
+        if (!lines)
+        {
+            free(raw);
+            return WIA_ERROR_INVALID_DRIVER_RESPONSE;
+        }
+
+        if (frame.format >= SANE_FRAME_RED && frame.format <= SANE_FRAME_BLUE)
+        {
+            /* a three-pass scanner: one colour per frame */
+            channel = frame.format - SANE_FRAME_RED;
+            free(planes[channel]);
+            planes[channel] = raw;
+            raw = NULL;
+            if (!img->width) { img->width = frame.pixels_per_line; img->height = lines; }
+            if (!frame.last_frame && ++pass < 3) continue;
+        }
+        break;
+    }
+
+    if (channel >= 0)
+    {
+        /* three planes of 8 bit samples */
+        img->bpp = 24;
+        img->stride = img->width * 3;
+        if (!(img->bits = calloc(img->height, img->stride))) hr = E_OUTOFMEMORY;
+        else
+            for (y = 0; y < img->height; y++)
+                for (x = 0; x < img->width; x++)
+                    for (channel = 0; channel < 3; channel++)
+                        if (planes[channel])
+                            img->bits[y * img->stride + x * 3 + 2 - channel] =
+                                planes[channel][y * frame.bytes_per_line + x * (frame.depth == 16 ? 2 : 1) +
+                                                (frame.depth == 16 ? 1 : 0)];
+        for (channel = 0; channel < 3; channel++) free(planes[channel]);
+        if (FAILED(hr)) return hr;
+        return fit_image(img, props_get_long(&item->props, WIA_IPS_XEXTENT), props_get_long(&item->props, WIA_IPS_YEXTENT));
+    }
+
+    img->width = frame.pixels_per_line;
+    img->height = lines;
+    img->bpp = datatype == WIA_DATA_THRESHOLD ? 1 : frame.format == SANE_FRAME_RGB && datatype != WIA_DATA_GRAYSCALE ? 24 : 8;
+    img->stride = img->bpp == 24 ? img->width * 3 : img->bpp == 8 ? img->width : (img->width + 7) / 8;
+    if (!(img->bits = calloc(img->height, img->stride)))
+    {
+        free(raw);
+        return E_OUTOFMEMORY;
+    }
+    for (y = 0; y < img->height; y++)
+    {
+        BYTE *dst = img->bits + y * img->stride;
+        line = raw + (SIZE_T)y * frame.bytes_per_line;
+        for (x = 0; x < img->width; x++)
+        {
+            BYTE r, g, b, v;
+            if (frame.format == SANE_FRAME_RGB)
+            {
+                if (frame.depth == 16) { r = line[x * 6 + 1]; g = line[x * 6 + 3]; b = line[x * 6 + 5]; }
+                else if (frame.depth == 1)
+                {
+                    r = (line[(x * 3) / 8] >> (7 - (x * 3) % 8)) & 1 ? 0 : 255;
+                    g = (line[(x * 3 + 1) / 8] >> (7 - (x * 3 + 1) % 8)) & 1 ? 0 : 255;
+                    b = (line[(x * 3 + 2) / 8] >> (7 - (x * 3 + 2) % 8)) & 1 ? 0 : 255;
+                }
+                else { r = line[x * 3]; g = line[x * 3 + 1]; b = line[x * 3 + 2]; }
+                v = (r * 299 + g * 587 + b * 114) / 1000;
+            }
+            else
+            {
+                if (frame.depth == 16) v = line[x * 2 + 1];
+                else if (frame.depth == 1) v = (line[x / 8] >> (7 - x % 8)) & 1 ? 0 : 255; /* SANE: 1 is black */
+                else v = line[x];
+                r = g = b = v;
+            }
+            switch (img->bpp)
+            {
+            case 24: dst[x * 3] = b; dst[x * 3 + 1] = g; dst[x * 3 + 2] = r; break;
+            case 8: dst[x] = v; break;
+            default: if (v >= threshold) dst[x / 8] |= 0x80 >> (x % 8); break; /* 1 is white */
+            }
+        }
+    }
+    free(raw);
+#ifdef SG_MUTANT_WIA_NO_FIT
+    return S_OK;
+#endif
+    return fit_image(img, props_get_long(&item->props, WIA_IPS_XEXTENT), props_get_long(&item->props, WIA_IPS_YEXTENT));
+}
+
+/* the DIB of an image: BITMAPINFOHEADER, colours, bottom-up rows; with a BITMAPFILEHEADER for a file */
+static HRESULT make_dib(const struct scan_image *img, BOOL file, BYTE **data, SIZE_T *size)
+{
+    LONG stride = ((img->width * img->bpp + 31) / 32) * 4, y, i, colours = img->bpp == 24 ? 0 : 1 << img->bpp;
+    SIZE_T header = (file ? sizeof(BITMAPFILEHEADER) : 0) + sizeof(BITMAPINFOHEADER) + colours * sizeof(RGBQUAD);
+    BITMAPINFOHEADER *bih;
+    RGBQUAD *pal;
+    BYTE *buf;
+
+    *size = header + (SIZE_T)stride * img->height;
+    if (!(buf = calloc(1, *size))) return E_OUTOFMEMORY;
+    if (file)
+    {
+        BITMAPFILEHEADER *bfh = (BITMAPFILEHEADER *)buf;
+        bfh->bfType = 0x4d42;
+        bfh->bfSize = *size;
+        bfh->bfOffBits = header;
+    }
+    bih = (BITMAPINFOHEADER *)(buf + (file ? sizeof(BITMAPFILEHEADER) : 0));
+    bih->biSize = sizeof(*bih);
+    bih->biWidth = img->width;
+    bih->biHeight = img->height;
+    bih->biPlanes = 1;
+    bih->biBitCount = img->bpp;
+    bih->biCompression = BI_RGB;
+    bih->biSizeImage = stride * img->height;
+    bih->biXPelsPerMeter = MulDiv(img->xres, 10000, 254);
+    bih->biYPelsPerMeter = MulDiv(img->yres, 10000, 254);
+    bih->biClrUsed = colours;
+    pal = (RGBQUAD *)(bih + 1);
+    for (i = 0; i < colours; i++)
+        pal[i].rgbRed = pal[i].rgbGreen = pal[i].rgbBlue = colours == 2 ? i * 255 : i;
+    for (y = 0; y < img->height; y++)
+        memcpy(buf + header + (SIZE_T)(img->height - 1 - y) * stride, img->bits + (SIZE_T)y * img->stride, img->stride);
+    *data = buf;
+    return S_OK;
+}
+
+static HRESULT encode_wic(const struct scan_image *img, const GUID *format, BYTE **data, SIZE_T *size)
+{
+    const GUID *container = IsEqualGUID(format, &WiaImgFmt_PNG) ? &GUID_ContainerFormatPng :
+                            IsEqualGUID(format, &WiaImgFmt_JPEG) ? &GUID_ContainerFormatJpeg :
+                            IsEqualGUID(format, &WiaImgFmt_TIFF) ? &GUID_ContainerFormatTiff : &GUID_ContainerFormatGif;
+    WICPixelFormatGUID pixel = img->bpp == 24 ? GUID_WICPixelFormat24bppBGR :
+                               img->bpp == 8 ? GUID_WICPixelFormat8bppGray : GUID_WICPixelFormatBlackWhite;
+    IWICImagingFactory *factory = NULL;
+    IWICBitmapEncoder *encoder = NULL;
+    IWICBitmapFrameEncode *frame = NULL;
+    IStream *stream = NULL;
+    HGLOBAL global;
+    STATSTG stat;
+    HRESULT hr;
+
+    *data = NULL;
+    if (FAILED(hr = CoCreateInstance(&CLSID_WICImagingFactory, NULL, CLSCTX_INPROC_SERVER,
+                                     &IID_IWICImagingFactory, (void **)&factory))) return hr;
+    if (SUCCEEDED(hr = CreateStreamOnHGlobal(NULL, TRUE, &stream))
+            && SUCCEEDED(hr = IWICImagingFactory_CreateEncoder(factory, container, NULL, &encoder))
+            && SUCCEEDED(hr = IWICBitmapEncoder_Initialize(encoder, stream, WICBitmapEncoderNoCache))
+            && SUCCEEDED(hr = IWICBitmapEncoder_CreateNewFrame(encoder, &frame, NULL))
+            && SUCCEEDED(hr = IWICBitmapFrameEncode_Initialize(frame, NULL))
+            && SUCCEEDED(hr = IWICBitmapFrameEncode_SetSize(frame, img->width, img->height))
+            && SUCCEEDED(hr = IWICBitmapFrameEncode_SetResolution(frame, img->xres, img->yres))
+            && SUCCEEDED(hr = IWICBitmapFrameEncode_SetPixelFormat(frame, &pixel)))
+    {
+        if (!IsEqualGUID(&pixel, img->bpp == 24 ? &GUID_WICPixelFormat24bppBGR : img->bpp == 8 ?
+                         &GUID_WICPixelFormat8bppGray : &GUID_WICPixelFormatBlackWhite))
+        {
+            /* the encoder wants another layout (GIF: indexed); give it a converted copy */
+            IWICBitmap *bitmap;
+            IWICFormatConverter *conv;
+            WICPixelFormatGUID src = img->bpp == 24 ? GUID_WICPixelFormat24bppBGR :
+                                     img->bpp == 8 ? GUID_WICPixelFormat8bppGray : GUID_WICPixelFormatBlackWhite;
+            if (SUCCEEDED(hr = IWICImagingFactory_CreateBitmapFromMemory(factory, img->width, img->height, &src,
+                    img->stride, img->stride * img->height, img->bits, &bitmap)))
+            {
+                if (SUCCEEDED(hr = IWICImagingFactory_CreateFormatConverter(factory, &conv)))
+                {
+                    if (SUCCEEDED(hr = IWICFormatConverter_Initialize(conv, (IWICBitmapSource *)bitmap, &pixel,
+                            WICBitmapDitherTypeNone, NULL, 0.0, WICBitmapPaletteTypeFixedWebPalette)))
+                        hr = IWICBitmapFrameEncode_WriteSource(frame, (IWICBitmapSource *)conv, NULL);
+                    IWICFormatConverter_Release(conv);
+                }
+                IWICBitmap_Release(bitmap);
+            }
+        }
+        else hr = IWICBitmapFrameEncode_WritePixels(frame, img->height, img->stride, img->stride * img->height,
+                                                    img->bits);
+        if (SUCCEEDED(hr)) hr = IWICBitmapFrameEncode_Commit(frame);
+        if (SUCCEEDED(hr)) hr = IWICBitmapEncoder_Commit(encoder);
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = IStream_Stat(stream, &stat, STATFLAG_NONAME))
+            && SUCCEEDED(hr = GetHGlobalFromStream(stream, &global)))
+    {
+        *size = stat.cbSize.QuadPart;
+        if (!(*data = malloc(*size ? *size : 1))) hr = E_OUTOFMEMORY;
+        else
+        {
+            memcpy(*data, GlobalLock(global), *size);
+            GlobalUnlock(global);
+        }
+    }
+    if (frame) IWICBitmapFrameEncode_Release(frame);
+    if (encoder) IWICBitmapEncoder_Release(encoder);
+    if (stream) IStream_Release(stream);
+    IWICImagingFactory_Release(factory);
+    return hr;
+}
+
+static HRESULT encode_image(const struct scan_image *img, const GUID *format, BOOL file, BYTE **data, SIZE_T *size)
+{
+    if (IsEqualGUID(format, &WiaImgFmt_MEMORYBMP)) return make_dib(img, FALSE, data, size);
+    if (IsEqualGUID(format, &WiaImgFmt_BMP)) return make_dib(img, file, data, size);
+#ifdef SG_MUTANT_WIA_NO_ENCODE
+    return make_dib(img, file, data, size);
+#endif
+    return encode_wic(img, format, data, size);
+}
+
+/* begins a transfer: the device is opened (once per tree) under the SANE lock */
+static HRESULT begin_transfer(struct wia_item *item)
+{
+    HRESULT hr;
+
+    if (item->kind == ITEM_ROOT) return E_INVALIDARG;
+    InterlockedExchange(&item->cancelled, 0);
+    EnterCriticalSection(&sane_cs);
+    if (FAILED(hr = open_tree_device(item->tree))) LeaveCriticalSection(&sane_cs);
+    return hr;
+}
+
+static void end_transfer(struct wia_item *item, BOOL keep_batch)
+{
+    struct wia_tree *tree = item->tree;
+    struct sane_handle_params params = { tree->handle };
+
+    if (!keep_batch)
+    {
+        if (tree->batch) SANE_CALL(cancel, &params);
+        close_tree_device(tree);
+    }
+    LeaveCriticalSection(&sane_cs);
+}
