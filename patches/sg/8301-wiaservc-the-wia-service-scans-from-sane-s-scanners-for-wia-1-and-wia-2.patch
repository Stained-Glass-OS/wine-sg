+static BOOL item_feeds(struct wia_item *item)
+{
+    if (item->kind == ITEM_FEEDER) return TRUE;
+    if (item->kind == ITEM_TOP)
+        return (props_get_long(&item->tree->items[0]->props, WIA_DPS_DOCUMENT_HANDLING_SELECT) & FEEDER) != 0;
+    return FALSE;
+}
