+    return celt <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_items2_Reset(IEnumWiaItem2 *iface)
+{
+    impl_from_IEnumWiaItem2(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_items2_Clone(IEnumWiaItem2 *iface, IEnumWiaItem2 **out)
+{
+    struct enum_items *This = impl_from_IEnumWiaItem2(iface), *copy;
