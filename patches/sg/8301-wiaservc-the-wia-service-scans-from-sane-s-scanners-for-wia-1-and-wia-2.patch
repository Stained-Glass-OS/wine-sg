+
+static HRESULT WINAPI enum_items2_Skip(IEnumWiaItem2 *iface, ULONG celt)
+{
+    struct enum_items *This = impl_from_IEnumWiaItem2(iface);
+    ULONG left = This->count - This->pos;
+
