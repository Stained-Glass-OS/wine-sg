+static HRESULT WINAPI propstg_Enum(IWiaPropertyStorage *iface, IEnumSTATPROPSTG **out)
+{
+    struct wia_propstg *This = impl_from_IWiaPropertyStorage(iface);
+    STATPROPSTG *stats;
+    ULONG i, count;
+
+    TRACE("(%p, %p)\n", This, out);
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+    EnterCriticalSection(This->props->cs);
+    count = This->props->count;
+    if (!(stats = calloc(count ? count : 1, sizeof(*stats))))
+    {
+        LeaveCriticalSection(This->props->cs);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        const struct wia_prop *prop = &This->props->props[i];
+        stats[i].propid = prop->id;
+        stats[i].vt = prop->value.vt;
+        if (prop->name && (stats[i].lpwstrName = CoTaskMemAlloc((wcslen(prop->name) + 1) * sizeof(WCHAR))))
+            wcscpy(stats[i].lpwstrName, prop->name);
+    }
+    LeaveCriticalSection(This->props->cs);
+    return create_enum_stat(stats, count, 0, out);
+}
