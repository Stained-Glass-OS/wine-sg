+static const IWiaPropertyStorageVtbl propstg_vtbl =
+{
+    propstg_QueryInterface,
+    propstg_AddRef,
+    propstg_Release,
+    propstg_ReadMultiple,
+    propstg_WriteMultiple,
+    propstg_DeleteMultiple,
+    propstg_ReadPropertyNames,
+    propstg_WritePropertyNames,
+    propstg_DeletePropertyNames,
+    propstg_Commit,
+    propstg_Revert,
+    propstg_Enum,
+    propstg_SetTimes,
+    propstg_SetClass,
+    propstg_Stat,
+    propstg_GetPropertyAttributes,
+    propstg_GetCount,
+    propstg_GetPropertyStream,
+    propstg_SetPropertyStream,
+};
+
+void propstg_init(struct wia_propstg *stg, IUnknown *outer, struct wia_props *props)
+{
+    stg->IWiaPropertyStorage_iface.lpVtbl = &propstg_vtbl;
+    stg->outer = outer;
+    stg->props = props;
+}
