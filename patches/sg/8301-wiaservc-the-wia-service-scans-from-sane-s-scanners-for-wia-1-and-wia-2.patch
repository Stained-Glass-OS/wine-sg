+static BOOL load_sane(void)
+{
+    void *lib = dlopen( "libsane.so.1", RTLD_NOW );
+
+    if (!lib) lib = dlopen( "libsane.so", RTLD_NOW );
+    if (!lib)
+    {
+        WARN( "libsane not found\n" );
+        return FALSE;
+    }
+#define DO(f) if (!(p_##f = dlsym( lib, #f ))) { WARN( "no %s\n", #f ); dlclose( lib ); return FALSE; }
