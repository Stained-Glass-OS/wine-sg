+        const GUID *event, BSTR app, BSTR args, BSTR name, BSTR description, BSTR icon)
+{
+    WCHAR *command;
+    HRESULT hr;
+
+    TRACE("(%p, %#lx, %s, %s, %s, %s, %s)\n", iface, flags, debugstr_w(id), debugstr_guid(event),
+          debugstr_w(app), debugstr_w(args), debugstr_w(name));
+
+    if (!app || !name) return E_POINTER;
+    /* the program and its arguments make the command line WIA 1 keeps */
+    if (!(command = malloc((wcslen(app) + (args ? wcslen(args) : 0) + 4) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    swprintf(command, wcslen(app) + (args ? wcslen(args) : 0) + 4, L"\"%s\"%s%s", app, args && *args ? L" " : L"",
+             args ? args : L"");
+    hr = register_persistent_handler(flags, id, event, name, name, description, icon, command, NULL);
+    free(command);
+    return hr;
+}
+
+static HRESULT WINAPI wiadevmgr2_RegisterEventCallbackCLSID(IWiaDevMgr2 *iface, LONG flags, BSTR id,
+        const GUID *event, const GUID *clsid, BSTR name, BSTR description, BSTR icon)
+{
+    return wiadevmgr_RegisterEventCallbackCLSID(&impl_from_IWiaDevMgr2(iface)->IWiaDevMgr_iface, flags, id, event,
+                                                clsid, name, description, icon);
+}
