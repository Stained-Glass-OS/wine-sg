+/* SANE's values, for the PE side */
+enum
+{
+    SANE_GOOD, SANE_UNSUPPORTED, SANE_CANCELLED, SANE_DEVICE_BUSY, SANE_INVAL, SANE_EOF, SANE_JAMMED,
+    SANE_NO_DOCS, SANE_COVER_OPEN, SANE_IO_ERROR, SANE_NO_MEM, SANE_ACCESS_DENIED
+};
+enum { SANE_FRAME_GRAY, SANE_FRAME_RGB, SANE_FRAME_RED, SANE_FRAME_GREEN, SANE_FRAME_BLUE };
+enum { SANE_UNIT_NONE, SANE_UNIT_PIXEL, SANE_UNIT_BIT, SANE_UNIT_MM, SANE_UNIT_DPI };
+#define SANE_FIX(v)   ((int)((v) * 65536.0))
+#define SANE_UNFIX(v) ((double)(v) / 65536.0)
