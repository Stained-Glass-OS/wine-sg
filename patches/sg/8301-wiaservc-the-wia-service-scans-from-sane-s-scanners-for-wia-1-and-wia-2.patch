+struct enum_formats
+{
+    IEnumWIA_FORMAT_INFO IEnumWIA_FORMAT_INFO_iface;
+    LONG ref;
+    WIA_FORMAT_INFO formats[16];
+    ULONG count, pos;
+};
+
+static inline struct enum_formats *impl_from_IEnumWIA_FORMAT_INFO(IEnumWIA_FORMAT_INFO *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_formats, IEnumWIA_FORMAT_INFO_iface);
+}
+
+static HRESULT WINAPI enum_formats_QueryInterface(IEnumWIA_FORMAT_INFO *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumWIA_FORMAT_INFO))
+    {
+        IEnumWIA_FORMAT_INFO_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_formats_AddRef(IEnumWIA_FORMAT_INFO *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumWIA_FORMAT_INFO(iface)->ref);
+}
+
+static ULONG WINAPI enum_formats_Release(IEnumWIA_FORMAT_INFO *iface)
+{
+    struct enum_formats *This = impl_from_IEnumWIA_FORMAT_INFO(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref) free(This);
+    return ref;
+}
+
+static HRESULT WINAPI enum_formats_Next(IEnumWIA_FORMAT_INFO *iface, ULONG celt, WIA_FORMAT_INFO *out, ULONG *fetched)
+{
+    struct enum_formats *This = impl_from_IEnumWIA_FORMAT_INFO(iface);
+    ULONG n = 0;
+
+    if (!out) return E_POINTER;
+    while (n < celt && This->pos < This->count) out[n++] = This->formats[This->pos++];
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_formats_Skip(IEnumWIA_FORMAT_INFO *iface, ULONG celt)
+{
+    struct enum_formats *This = impl_from_IEnumWIA_FORMAT_INFO(iface);
+    ULONG left = This->count - This->pos;
+
+    This->pos += min(celt, left);
+    return celt <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_formats_Reset(IEnumWIA_FORMAT_INFO *iface)
+{
+    impl_from_IEnumWIA_FORMAT_INFO(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_formats_Clone(IEnumWIA_FORMAT_INFO *iface, IEnumWIA_FORMAT_INFO **out)
+{
+    struct enum_formats *This = impl_from_IEnumWIA_FORMAT_INFO(iface), *copy;
+
+    if (!out) return E_POINTER;
+    if (!(copy = malloc(sizeof(*copy)))) return E_OUTOFMEMORY;
+    *copy = *This;
+    copy->ref = 1;
+    *out = &copy->IEnumWIA_FORMAT_INFO_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_formats_GetCount(IEnumWIA_FORMAT_INFO *iface, ULONG *count)
+{
+    if (!count) return E_POINTER;
+    *count = impl_from_IEnumWIA_FORMAT_INFO(iface)->count;
+    return S_OK;
+}
+
+static const IEnumWIA_FORMAT_INFOVtbl enum_formats_vtbl =
+{
+    enum_formats_QueryInterface,
+    enum_formats_AddRef,
+    enum_formats_Release,
+    enum_formats_Next,
+    enum_formats_Skip,
+    enum_formats_Reset,
+    enum_formats_Clone,
+    enum_formats_GetCount,
+};
+
+static HRESULT create_enum_formats(struct wia_item *item, IEnumWIA_FORMAT_INFO **out)
+{
+    struct enum_formats *This;
+    unsigned int i;
+
+    if (!out) return E_POINTER;
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->IEnumWIA_FORMAT_INFO_iface.lpVtbl = &enum_formats_vtbl;
+    This->ref = 1;
+    if (!item->tree->wia2)
+    {
+        This->formats[This->count].guidFormatID = WiaImgFmt_MEMORYBMP;
+        This->formats[This->count++].lTymed = TYMED_CALLBACK;
+        This->formats[This->count].guidFormatID = WiaImgFmt_BMP;
+        This->formats[This->count++].lTymed = TYMED_CALLBACK;
+    }
+    for (i = 0; i < ARRAY_SIZE(item_formats); i++)
+    {
+        if (item_formats[i] == &WiaImgFmt_MEMORYBMP) continue;
+        This->formats[This->count].guidFormatID = *item_formats[i];
+        This->formats[This->count++].lTymed = TYMED_FILE;
+    }
+    *out = &This->IEnumWIA_FORMAT_INFO_iface;
+    return S_OK;
+}
