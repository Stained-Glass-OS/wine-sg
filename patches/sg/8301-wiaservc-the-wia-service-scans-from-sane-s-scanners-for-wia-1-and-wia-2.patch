+static HRESULT write_stream(IStream *stream, const BYTE *data, SIZE_T size)
+{
+    SIZE_T done = 0;
+    ULONG written;
+    HRESULT hr;
+
+    while (done < size)
+    {
+        ULONG chunk = min(size - done, 1 << 20);
+        if (FAILED(hr = IStream_Write(stream, data + done, chunk, &written))) return hr;
+        if (!written) return STG_E_MEDIUMFULL;
+        done += written;
+    }
+    return S_OK;
+}
