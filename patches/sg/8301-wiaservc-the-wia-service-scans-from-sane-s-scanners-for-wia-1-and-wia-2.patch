+static HRESULT item_query_interface(struct wia_item *item, REFIID riid, void **obj)
+{
+    BOOL image = item->kind != ITEM_ROOT;
+
+    *obj = NULL;
+    if (IsEqualGUID(riid, &IID_IUnknown)) *obj = item_unknown(item);
+    else if (IsEqualGUID(riid, &IID_IWiaItem) && !item->tree->wia2) *obj = &item->IWiaItem_iface;
+    else if (IsEqualGUID(riid, &IID_IWiaItem2) && item->tree->wia2) *obj = &item->IWiaItem2_iface;
+    else if (IsEqualGUID(riid, &IID_IWiaPropertyStorage)) *obj = &item->stg.IWiaPropertyStorage_iface;
+    else if (IsEqualGUID(riid, &IID_IWiaDataTransfer) && image && !item->tree->wia2)
+        *obj = &item->IWiaDataTransfer_iface;
+    else if (IsEqualGUID(riid, &IID_IWiaTransfer) && image && item->tree->wia2) *obj = &item->IWiaTransfer_iface;
+    else if (IsEqualGUID(riid, &IID_IWiaItemExtras)) *obj = &item->IWiaItemExtras_iface;
+    if (!*obj)
+    {
+        TRACE("interface %s not supported\n", debugstr_guid(riid));
+        return E_NOINTERFACE;
+    }
+    tree_addref(item->tree);
+    return S_OK;
+}
