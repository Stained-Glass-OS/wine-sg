+
+const WCHAR *wia_prop_name(PROPID id)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(prop_names); i++)
+        if (prop_names[i].id == id) return prop_names[i].name;
+    return NULL;
+}
+
+void props_init(struct wia_props *props, CRITICAL_SECTION *cs)
+{
+    memset(props, 0, sizeof(*props));
+    props->cs = cs;
+}
+
+void props_free(struct wia_props *props)
+{
+    unsigned int i;
+
+    for (i = 0; i < props->count; i++)
+    {
+        PropVariantClear(&props->props[i].value);
+        PropVariantClear(&props->props[i].valid);
+    }
+    free(props->props);
+    props->props = NULL;
+    props->count = props->size = 0;
+}
+
+struct wia_prop *props_find(struct wia_props *props, PROPID id)
+{
+    unsigned int i;
+
+    for (i = 0; i < props->count; i++)
+        if (props->props[i].id == id) return &props->props[i];
+    return NULL;
+}
+
+struct wia_prop *props_find_name(struct wia_props *props, const WCHAR *name)
+{
+    unsigned int i;
+
+    for (i = 0; i < props->count; i++)
+        if (props->props[i].name && !wcsicmp(props->props[i].name, name)) return &props->props[i];
+    return NULL;
+}
+
+static struct wia_prop *props_add(struct wia_props *props, PROPID id, ULONG flags)
+{
+    struct wia_prop *prop;
+
+    if ((prop = props_find(props, id)))
+    {
+        PropVariantClear(&prop->value);
+        prop->flags = flags | (prop->flags & (WIA_PROP_RANGE | WIA_PROP_LIST | WIA_PROP_FLAG));
+        return prop;
+    }
+    if (props->count == props->size)
+    {
+        unsigned int size = props->size ? props->size * 2 : 32;
+        struct wia_prop *grown = realloc(props->props, size * sizeof(*grown));
+        if (!grown) return NULL;
+        props->props = grown;
+        props->size = size;
+    }
+    prop = &props->props[props->count++];
+    memset(prop, 0, sizeof(*prop));
+    prop->id = id;
+    prop->name = wia_prop_name(id);
+    prop->flags = flags | WIA_PROP_NONE;
+    return prop;
+}
+
+void props_add_long(struct wia_props *props, PROPID id, ULONG flags, LONG value)
+{
+    struct wia_prop *prop = props_add(props, id, flags);
+
+    if (!prop) return;
+    prop->value.vt = VT_I4;
+    prop->value.lVal = value;
+}
+
+void props_add_str(struct wia_props *props, PROPID id, ULONG flags, const WCHAR *value)
+{
+    struct wia_prop *prop = props_add(props, id, flags);
+
+    if (!prop) return;
+    prop->value.vt = VT_BSTR;
+    prop->value.bstrVal = SysAllocString(value ? value : L"");
+}
+
+void props_add_guid(struct wia_props *props, PROPID id, ULONG flags, const GUID *value)
+{
+    struct wia_prop *prop = props_add(props, id, flags);
+
+    if (!prop) return;
+    prop->value.vt = VT_CLSID;
+    if ((prop->value.puuid = CoTaskMemAlloc(sizeof(GUID)))) *prop->value.puuid = *value;
+}
+
+void props_set_long(struct wia_props *props, PROPID id, LONG value)
+{
+    struct wia_prop *prop = props_find(props, id);
+
+    if (prop && prop->value.vt == VT_I4) prop->value.lVal = value;
+}
+
+LONG props_get_long(struct wia_props *props, PROPID id)
+{
+    struct wia_prop *prop = props_find(props, id);
+
+    return prop && prop->value.vt == VT_I4 ? prop->value.lVal : 0;
+}
+
+BOOL props_get_guid(struct wia_props *props, PROPID id, GUID *guid)
+{
+    struct wia_prop *prop = props_find(props, id);
+
+    if (!prop || prop->value.vt != VT_CLSID || !prop->value.puuid) return FALSE;
+    *guid = *prop->value.puuid;
+    return TRUE;
+}
+
+void props_set_guid(struct wia_props *props, PROPID id, const GUID *value)
+{
+    struct wia_prop *prop = props_find(props, id);
+
+    if (prop && prop->value.vt == VT_CLSID && prop->value.puuid) *prop->value.puuid = *value;
+}
+
+static void set_valid_longs(struct wia_prop *prop, ULONG kind, unsigned int count, const LONG *values)
+{
+    PropVariantClear(&prop->valid);
+    prop->flags = (prop->flags & ~(WIA_PROP_NONE | WIA_PROP_RANGE | WIA_PROP_LIST | WIA_PROP_FLAG)) | kind;
+    prop->valid.vt = VT_VECTOR | VT_I4;
+    if (!(prop->valid.cal.pElems = CoTaskMemAlloc(count * sizeof(LONG)))) return;
+    memcpy(prop->valid.cal.pElems, values, count * sizeof(LONG));
+    prop->valid.cal.cElems = count;
+}
+
+void props_set_range(struct wia_props *props, PROPID id, LONG min, LONG nom, LONG max, LONG step)
+{
+    struct wia_prop *prop = props_find(props, id);
+    LONG values[4];
+
+    if (!prop) return;
+    values[WIA_RANGE_MIN] = min;
+    values[WIA_RANGE_NOM] = nom;
+    values[WIA_RANGE_MAX] = max;
+    values[WIA_RANGE_STEP] = step;
+    set_valid_longs(prop, WIA_PROP_RANGE, 4, values);
+}
+
+void props_set_list(struct wia_props *props, PROPID id, LONG nom, unsigned int count, const LONG *values)
+{
+    struct wia_prop *prop = props_find(props, id);
+    LONG *list;
+
+    if (!prop || !(list = malloc((count + WIA_LIST_VALUES) * sizeof(LONG)))) return;
+    list[WIA_LIST_COUNT] = count;
+    list[WIA_LIST_NOM] = nom;
+    memcpy(list + WIA_LIST_VALUES, values, count * sizeof(LONG));
+    set_valid_longs(prop, WIA_PROP_LIST, count + WIA_LIST_VALUES, list);
+    free(list);
+}
+
+void props_set_guid_list(struct wia_props *props, PROPID id, const GUID *nom, unsigned int count, const GUID *values)
+{
+    struct wia_prop *prop = props_find(props, id);
+    GUID *list;
+
+    if (!prop) return;
+    PropVariantClear(&prop->valid);
+    prop->flags = (prop->flags & ~(WIA_PROP_NONE | WIA_PROP_RANGE | WIA_PROP_FLAG)) | WIA_PROP_LIST;
+    /* laid out like a list of numbers: an unused count element, the nominal value, then the values */
+    if (!(list = CoTaskMemAlloc((count + WIA_LIST_VALUES) * sizeof(GUID)))) return;
+    list[WIA_LIST_COUNT] = GUID_NULL;
+    list[WIA_LIST_NOM] = *nom;
+    memcpy(list + WIA_LIST_VALUES, values, count * sizeof(GUID));
+    prop->valid.vt = VT_VECTOR | VT_CLSID;
+    prop->valid.cauuid.cElems = count + WIA_LIST_VALUES;
+    prop->valid.cauuid.pElems = list;
+}
+
+void props_set_flag(struct wia_props *props, PROPID id, LONG nom, LONG all)
+{
+    struct wia_prop *prop = props_find(props, id);
+    LONG values[2];
+
+    if (!prop) return;
+    values[WIA_FLAG_NOM] = nom;
+    values[WIA_FLAG_VALUES] = all;
+    set_valid_longs(prop, WIA_PROP_FLAG, 2, values);
+}
+
+BOOL props_valid_long(const struct wia_prop *prop, LONG value)
+{
+    const LONG *v = prop->valid.cal.pElems;
+    unsigned int i;
+
+    if (prop->flags & WIA_PROP_RANGE)
+    {
+        if (value < v[WIA_RANGE_MIN] || value > v[WIA_RANGE_MAX]) return FALSE;
+        return v[WIA_RANGE_STEP] <= 1 || !((value - v[WIA_RANGE_MIN]) % v[WIA_RANGE_STEP]);
+    }
+    if (prop->flags & WIA_PROP_LIST)
+    {
+        for (i = WIA_LIST_VALUES; i < prop->valid.cal.cElems; i++)
+            if (v[i] == value) return TRUE;
+        return FALSE;
+    }
+    if (prop->flags & WIA_PROP_FLAG) return !(value & ~v[WIA_FLAG_VALUES]);
+    return TRUE;
+}
+
+static BOOL valid_guid(const struct wia_prop *prop, const GUID *guid)
+{
+    unsigned int i;
+
+    if (!(prop->flags & WIA_PROP_LIST) || prop->valid.vt != (VT_VECTOR | VT_CLSID)) return TRUE;
+    for (i = WIA_LIST_VALUES; i < prop->valid.cauuid.cElems; i++)
+        if (IsEqualGUID(&prop->valid.cauuid.pElems[i], guid)) return TRUE;
+    return FALSE;
+}
+
+/* IEnumSTATPROPSTG over a copy of the property list */
+
+struct enum_statpropstg
+{
+    IEnumSTATPROPSTG IEnumSTATPROPSTG_iface;
+    LONG ref;
+    STATPROPSTG *stats;
+    ULONG count, pos;
+};
+
+static inline struct enum_statpropstg *impl_from_IEnumSTATPROPSTG(IEnumSTATPROPSTG *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_statpropstg, IEnumSTATPROPSTG_iface);
+}
+
+static HRESULT WINAPI enum_stat_QueryInterface(IEnumSTATPROPSTG *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumSTATPROPSTG))
+    {
+        IEnumSTATPROPSTG_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_stat_AddRef(IEnumSTATPROPSTG *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumSTATPROPSTG(iface)->ref);
+}
+
+static ULONG WINAPI enum_stat_Release(IEnumSTATPROPSTG *iface)
+{
+    struct enum_statpropstg *This = impl_from_IEnumSTATPROPSTG(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    ULONG i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) CoTaskMemFree(This->stats[i].lpwstrName);
+        free(This->stats);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enum_stat_Next(IEnumSTATPROPSTG *iface, ULONG celt, STATPROPSTG *rgelt, ULONG *fetched)
+{
+    struct enum_statpropstg *This = impl_from_IEnumSTATPROPSTG(iface);
+    ULONG n = 0;
+
+    if (!rgelt) return E_POINTER;
+    while (n < celt && This->pos < This->count)
+    {
+        const STATPROPSTG *src = &This->stats[This->pos++];
+        rgelt[n] = *src;
+        if (src->lpwstrName && (rgelt[n].lpwstrName = CoTaskMemAlloc((wcslen(src->lpwstrName) + 1) * sizeof(WCHAR))))
+            wcscpy(rgelt[n].lpwstrName, src->lpwstrName);
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_stat_Skip(IEnumSTATPROPSTG *iface, ULONG celt)
+{
+    struct enum_statpropstg *This = impl_from_IEnumSTATPROPSTG(iface);
+    ULONG left = This->count - This->pos;
+
+    This->pos += min(celt, left);
+    return celt <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_stat_Reset(IEnumSTATPROPSTG *iface)
+{
+    impl_from_IEnumSTATPROPSTG(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_enum_stat(STATPROPSTG *stats, ULONG count, ULONG pos, IEnumSTATPROPSTG **out);
+
+static HRESULT WINAPI enum_stat_Clone(IEnumSTATPROPSTG *iface, IEnumSTATPROPSTG **out)
+{
+    struct enum_statpropstg *This = impl_from_IEnumSTATPROPSTG(iface);
+    STATPROPSTG *copy;
+    ULONG i;
+
+    if (!out) return E_POINTER;
+    if (!(copy = calloc(This->count ? This->count : 1, sizeof(*copy)))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++)
+    {
+        copy[i] = This->stats[i];
+        if (This->stats[i].lpwstrName && (copy[i].lpwstrName = CoTaskMemAlloc((wcslen(This->stats[i].lpwstrName) + 1) * sizeof(WCHAR))))
+            wcscpy(copy[i].lpwstrName, This->stats[i].lpwstrName);
+    }
+    return create_enum_stat(copy, This->count, This->pos, out);
+}
+
+static const IEnumSTATPROPSTGVtbl enum_stat_vtbl =
+{
+    enum_stat_QueryInterface,
+    enum_stat_AddRef,
+    enum_stat_Release,
+    enum_stat_Next,
+    enum_stat_Skip,
+    enum_stat_Reset,
+    enum_stat_Clone,
+};
+
+static HRESULT create_enum_stat(STATPROPSTG *stats, ULONG count, ULONG pos, IEnumSTATPROPSTG **out)
+{
+    struct enum_statpropstg *This;
+
+    if (!(This = calloc(1, sizeof(*This))))
+    {
+        free(stats);
+        return E_OUTOFMEMORY;
+    }
+    This->IEnumSTATPROPSTG_iface.lpVtbl = &enum_stat_vtbl;
+    This->ref = 1;
+    This->stats = stats;
+    This->count = count;
+    This->pos = pos;
+    *out = &This->IEnumSTATPROPSTG_iface;
+    return S_OK;
+}
+
+/* IWiaPropertyStorage */
+
+static inline struct wia_propstg *impl_from_IWiaPropertyStorage(IWiaPropertyStorage *iface)
+{
+    return CONTAINING_RECORD(iface, struct wia_propstg, IWiaPropertyStorage_iface);
+}
+
+static HRESULT WINAPI propstg_QueryInterface(IWiaPropertyStorage *iface, REFIID riid, void **obj)
+{
+    return IUnknown_QueryInterface(impl_from_IWiaPropertyStorage(iface)->outer, riid, obj);
+}
+
+static ULONG WINAPI propstg_AddRef(IWiaPropertyStorage *iface)
+{
+    return IUnknown_AddRef(impl_from_IWiaPropertyStorage(iface)->outer);
+}
+
+static ULONG WINAPI propstg_Release(IWiaPropertyStorage *iface)
+{
+    return IUnknown_Release(impl_from_IWiaPropertyStorage(iface)->outer);
+}
+
+static struct wia_prop *find_spec(struct wia_props *props, const PROPSPEC *spec)
+{
+    if (spec->ulKind == PRSPEC_PROPID) return props_find(props, spec->propid);
+    if (spec->ulKind == PRSPEC_LPWSTR && spec->lpwstr) return props_find_name(props, spec->lpwstr);
+    return NULL;
+}
+
+static HRESULT WINAPI propstg_ReadMultiple(IWiaPropertyStorage *iface, ULONG count, const PROPSPEC *specs,
+                                           PROPVARIANT *values)
+{
+    struct wia_propstg *This = impl_from_IWiaPropertyStorage(iface);
+    struct wia_prop *prop;
+    BOOL found = FALSE;
+    HRESULT hr = S_OK;
+    ULONG i;
+
+    TRACE("(%p, %lu, %p, %p)\n", This, count, specs, values);
+
+    if (!count) return S_FALSE;
+    if (!specs || !values) return E_INVALIDARG;
+    EnterCriticalSection(This->props->cs);
+    for (i = 0; i < count; i++)
+    {
+        PropVariantInit(&values[i]);
+        if (!(prop = find_spec(This->props, &specs[i]))) continue;
+        if (FAILED(hr = PropVariantCopy(&values[i], &prop->value))) break;
+        found = TRUE;
+    }
+    LeaveCriticalSection(This->props->cs);
+    if (FAILED(hr))
+    {
+        for (i = 0; i < count; i++) PropVariantClear(&values[i]);
+        return hr;
+    }
+    return found ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI propstg_WriteMultiple(IWiaPropertyStorage *iface, ULONG count, const PROPSPEC *specs,
+                                            const PROPVARIANT *values, PROPID first)
+{
+    struct wia_propstg *This = impl_from_IWiaPropertyStorage(iface);
+    struct wia_prop *prop;
+    PROPID *ids;
+    PROPVARIANT *conv;
+    HRESULT hr = S_OK;
+    ULONG i;
+
+    TRACE("(%p, %lu, %p, %p, %lu)\n", This, count, specs, values, first);
+
+    if (!count) return S_OK;
+    if (!specs || !values) return E_INVALIDARG;
+    if (!(ids = calloc(count, sizeof(*ids))) || !(conv = calloc(count, sizeof(*conv))))
+    {
+        free(ids);
+        return E_OUTOFMEMORY;
+    }
+
+    EnterCriticalSection(This->props->cs);
+    /* every value is checked before any is written */
+    for (i = 0; i < count && SUCCEEDED(hr); i++)
+    {
+        if (!(prop = find_spec(This->props, &specs[i])))
+        {
+            hr = E_INVALIDARG;
+            break;
+        }
+        if (!(prop->flags & WIA_PROP_WRITE))
+        {
+            hr = E_ACCESSDENIED;
+            break;
+        }
+        ids[i] = prop->id;
+        if (prop->value.vt == VT_I4)
+        {
+            LONG value;
+            if (FAILED(PropVariantToInt32(&values[i], &value))) hr = E_INVALIDARG;
+#ifndef SG_MUTANT_WIA_NO_VALIDATE
+            else if (!props_valid_long(prop, value)) hr = E_INVALIDARG;
+#endif
+            else
+            {
+                conv[i].vt = VT_I4;
+                conv[i].lVal = value;
+            }
+        }
+        else if (prop->value.vt == VT_CLSID)
+        {
+            if (values[i].vt != VT_CLSID || !values[i].puuid || !valid_guid(prop, values[i].puuid)) hr = E_INVALIDARG;
+            else hr = PropVariantCopy(&conv[i], &values[i]);
+        }
+        else if (prop->value.vt == VT_BSTR)
+        {
+            if (values[i].vt == VT_BSTR) hr = PropVariantCopy(&conv[i], &values[i]);
+            else if (values[i].vt == VT_LPWSTR)
+            {
+                conv[i].vt = VT_BSTR;
+                if (!(conv[i].bstrVal = SysAllocString(values[i].pwszVal))) hr = E_OUTOFMEMORY;
+            }
+            else hr = E_INVALIDARG;
+        }
+        else hr = PropVariantCopy(&conv[i], &values[i]);
+    }
+
+    if (SUCCEEDED(hr))
+    {
+        if (This->props->write) hr = This->props->write(This->props->ctx, count, ids, conv);
+        else
+        {
+            for (i = 0; i < count; i++)
+            {
+                prop = props_find(This->props, ids[i]);
+                PropVariantClear(&prop->value);
+                PropVariantCopy(&prop->value, &conv[i]);
+            }
+        }
+    }
+    LeaveCriticalSection(This->props->cs);
+
+    for (i = 0; i < count; i++) PropVariantClear(&conv[i]);
+    free(conv);
+    free(ids);
+    return hr;
+}
+
+static HRESULT WINAPI propstg_DeleteMultiple(IWiaPropertyStorage *iface, ULONG count, const PROPSPEC *specs)
+{
+    TRACE("(%p, %lu, %p)\n", iface, count, specs);
+    /* the properties of a device are its own: none can be removed */
+    return STG_E_ACCESSDENIED;
+}
