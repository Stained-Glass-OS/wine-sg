+/* child item enumerators */
+
+struct enum_items
+{
+    IEnumWiaItem IEnumWiaItem_iface;
+    IEnumWiaItem2 IEnumWiaItem2_iface;
+    LONG ref;
+    struct wia_tree *tree;
+    struct wia_item *items[4];
+    ULONG count, pos;
+};
+
+static const IEnumWiaItemVtbl enum_items_vtbl;
+static const IEnumWiaItem2Vtbl enum_items2_vtbl;
+
+static HRESULT create_enum_items(struct wia_tree *tree, const GUID *category, ULONG pos, struct enum_items **out)
+{
+    struct enum_items *This;
+    unsigned int i;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->IEnumWiaItem_iface.lpVtbl = &enum_items_vtbl;
+    This->IEnumWiaItem2_iface.lpVtbl = &enum_items2_vtbl;
+    This->ref = 1;
+    This->tree = tree;
+    tree_addref(tree);
+    for (i = 1; i < tree->count; i++)
+    {
+        if (category && !IsEqualGUID(category, &GUID_NULL))
+        {
+            GUID item_category;
+            if (!props_get_guid(&tree->items[i]->props, WIA_IPA_ITEM_CATEGORY, &item_category)
+                    || !IsEqualGUID(&item_category, category))
+                continue;
+        }
+        This->items[This->count++] = tree->items[i];
+    }
+    This->pos = min(pos, This->count);
+    *out = This;
+    return S_OK;
+}
+
+static ULONG enum_items_release(struct enum_items *This)
+{
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        tree_release(This->tree);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT enum_items_next(struct enum_items *This, ULONG celt, void **out, ULONG *fetched, BOOL wia2)
+{
+    ULONG n = 0;
+
+    if (!out) return E_POINTER;
+    if (!fetched && celt != 1) return E_POINTER;
+    while (n < celt && This->pos < This->count)
+    {
+        struct wia_item *item = This->items[This->pos++];
+        out[n++] = wia2 ? (void *)&item->IWiaItem2_iface : (void *)&item->IWiaItem_iface;
+        tree_addref(item->tree);
+    }
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static inline struct enum_items *impl_from_IEnumWiaItem(IEnumWiaItem *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_items, IEnumWiaItem_iface);
+}
+
+static HRESULT WINAPI enum_items_QueryInterface(IEnumWiaItem *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumWiaItem))
+    {
+        IEnumWiaItem_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_items_AddRef(IEnumWiaItem *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumWiaItem(iface)->ref);
+}
+
+static ULONG WINAPI enum_items_Release(IEnumWiaItem *iface)
+{
+    return enum_items_release(impl_from_IEnumWiaItem(iface));
+}
+
+static HRESULT WINAPI enum_items_Next(IEnumWiaItem *iface, ULONG celt, IWiaItem **items, ULONG *fetched)
+{
+    return enum_items_next(impl_from_IEnumWiaItem(iface), celt, (void **)items, fetched, FALSE);
+}
+
+static HRESULT WINAPI enum_items_Skip(IEnumWiaItem *iface, ULONG celt)
+{
+    struct enum_items *This = impl_from_IEnumWiaItem(iface);
+    ULONG left = This->count - This->pos;
+
+    This->pos += min(celt, left);
+    return celt <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_items_Reset(IEnumWiaItem *iface)
+{
+    impl_from_IEnumWiaItem(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_items_Clone(IEnumWiaItem *iface, IEnumWiaItem **out)
+{
+    struct enum_items *This = impl_from_IEnumWiaItem(iface), *copy;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    if (FAILED(hr = create_enum_items(This->tree, NULL, This->pos, &copy))) return hr;
+    *out = &copy->IEnumWiaItem_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_items_GetCount(IEnumWiaItem *iface, ULONG *count)
+{
+    if (!count) return E_POINTER;
+    *count = impl_from_IEnumWiaItem(iface)->count;
+    return S_OK;
+}
+
+static const IEnumWiaItemVtbl enum_items_vtbl =
+{
+    enum_items_QueryInterface,
+    enum_items_AddRef,
+    enum_items_Release,
+    enum_items_Next,
+    enum_items_Skip,
+    enum_items_Reset,
+    enum_items_Clone,
+    enum_items_GetCount,
+};
