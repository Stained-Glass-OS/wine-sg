+/* WIA 1: IWiaDataCallback */
+
+struct banded_ctx
+{
+    IWiaDataCallback *callback;
+};
+
+static HRESULT banded_progress(void *ctx, LONG percent)
+{
+    struct banded_ctx *banded = ctx;
+    HRESULT hr;
+
+    if (!banded->callback) return S_OK;
+    hr = IWiaDataCallback_BandedDataCallback(banded->callback, IT_MSG_STATUS, IT_STATUS_TRANSFER_FROM_DEVICE,
+                                             percent, 0, 0, 0, 0, NULL);
+    return hr == S_OK ? S_OK : S_FALSE;
+}
+
+/* scans one page for WIA 1; a feeder keeps its batch between transfers (a page each) */
+static HRESULT scan_one(struct wia_item *item, IWiaDataCallback *callback, struct scan_image *img)
+{
+    struct banded_ctx ctx = { callback };
+    LONG datatype;
+    HRESULT hr;
+
+    if (!item->tree->batch) apply_settings(item, &datatype);
+    else datatype = props_get_long(&item->props, WIA_IPA_DATATYPE);
+    hr = read_page(item, datatype, img, banded_progress, &ctx);
+    if (hr != S_OK) free(img->bits);
+    return hr;
+}
