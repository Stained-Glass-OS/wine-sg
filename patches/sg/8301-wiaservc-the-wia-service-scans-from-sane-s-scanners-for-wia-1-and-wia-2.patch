+static NTSTATUS set_value( void *args )
+{
+    struct sane_value_params *params = args;
+    SANE_Handle handle = (SANE_Handle)(UINT_PTR)params->handle;
+    const SANE_Option_Descriptor *opt = sane_get_option_descriptor( handle, params->optno );
+    SANE_Int info = 0;
+    char buffer[256];
+
+    if (!opt) return STATUS_INVALID_PARAMETER;
+    if (opt->type == SANE_TYPE_STRING)
+    {
+        copy_string( buffer, params->string, sizeof(buffer) );
+        params->status = sane_control_option( handle, params->optno, SANE_ACTION_SET_VALUE, buffer, &info );
+    }
+    else if (opt->size == sizeof(SANE_Word))
+        params->status = sane_control_option( handle, params->optno, SANE_ACTION_SET_VALUE, &params->value, &info );
+    else
+        params->status = SANE_STATUS_UNSUPPORTED;
+    params->info = info;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS start( void *args )
+{
+    struct sane_handle_params *params = args;
+
+    params->status = sane_start( (SANE_Handle)(UINT_PTR)params->handle );
+    TRACE( "sane_start: %s\n", sane_strstatus( params->status ) );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS get_parameters( void *args )
+{
+    struct sane_frame_params *params = args;
+    SANE_Parameters frame;
+
+    params->status = sane_get_parameters( (SANE_Handle)(UINT_PTR)params->handle, &frame );
+    if (params->status) return STATUS_SUCCESS;
+    params->format = frame.format;
+    params->last_frame = frame.last_frame;
+    params->bytes_per_line = frame.bytes_per_line;
+    params->pixels_per_line = frame.pixels_per_line;
+    params->lines = frame.lines;
+    params->depth = frame.depth;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS read_data( void *args )
+{
+    struct sane_read_params *params = args;
+    SANE_Handle handle = (SANE_Handle)(UINT_PTR)params->handle;
+    unsigned char *buffer = (unsigned char *)(UINT_PTR)params->buffer;
+    SANE_Int got;
+
+    params->retlen = 0;
+    params->status = SANE_STATUS_GOOD;
+    while (params->retlen < params->len)
+    {
+        params->status = sane_read( handle, buffer + params->retlen, params->len - params->retlen, &got );
+        if (params->status != SANE_STATUS_GOOD) break;
+        params->retlen += got;
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS cancel( void *args )
+{
+    struct sane_handle_params *params = args;
+
+    sane_cancel( (SANE_Handle)(UINT_PTR)params->handle );
+    return STATUS_SUCCESS;
+}
