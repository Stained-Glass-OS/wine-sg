+static const SANE_Device **device_list;
+
+static void copy_string( char *dst, const char *src, size_t size )
+{
+    size_t len = src ? strlen( src ) : 0;
+
+    if (len >= size) len = size - 1;
+    if (len) memcpy( dst, src, len );
+    dst[len] = 0;
+}
+
+static NTSTATUS process_attach( void *args )
+{
+    SANE_Int version;
+
+    if (!load_sane()) return STATUS_NOT_SUPPORTED;
+    sane_init( &version, NULL );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS process_detach( void *args )
+{
+    if (p_sane_exit) sane_exit();
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS get_device( void *args )
+{
+    struct sane_device_params *params = args;
+    const SANE_Device *dev;
+    UINT i;
+
+    if (!params->index || !device_list) sane_get_devices( &device_list, SANE_TRUE );
+    if (!device_list) return STATUS_NO_MORE_ENTRIES;
+    for (i = 0; i < params->index; i++) if (!device_list[i]) return STATUS_NO_MORE_ENTRIES;
+    if (!(dev = device_list[params->index])) return STATUS_NO_MORE_ENTRIES;
+    copy_string( params->name, dev->name, sizeof(params->name) );
+    copy_string( params->vendor, dev->vendor, sizeof(params->vendor) );
+    copy_string( params->model, dev->model, sizeof(params->model) );
+    copy_string( params->type, dev->type, sizeof(params->type) );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS open_device( void *args )
+{
+    struct sane_open_params *params = args;
+    SANE_Handle handle = NULL;
+
+    params->status = sane_open( params->name, &handle );
+    params->handle = params->status == SANE_STATUS_GOOD ? (UINT_PTR)handle : 0;
+    if (params->status) WARN( "sane_open(%s): %s\n", params->name, sane_strstatus( params->status ) );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS close_device( void *args )
+{
+    struct sane_handle_params *params = args;
+
+    if (params->handle) sane_close( (SANE_Handle)(UINT_PTR)params->handle );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS find_option( void *args )
+{
+    struct sane_option_params *params = args;
+    SANE_Handle handle = (SANE_Handle)(UINT_PTR)params->handle;
+    const SANE_Option_Descriptor *opt;
+    int i, j, len;
+    char *p;
+
+    params->optno = 0;
+    for (i = 1; (opt = sane_get_option_descriptor( handle, i )); i++)
+    {
+        if (!opt->name || strcmp( opt->name, params->name )) continue;
+        params->optno = i;
+        params->type = opt->type;
+        params->unit = opt->unit;
+        params->size = opt->size;
+        params->active = SANE_OPTION_IS_ACTIVE( opt->cap );
+        params->settable = SANE_OPTION_IS_SETTABLE( opt->cap );
+        params->constraint = opt->constraint_type;
+        params->words[0] = 0;
+        params->strings[0] = params->strings[1] = 0;
+        switch (opt->constraint_type)
+        {
+        case SANE_CONSTRAINT_RANGE:
+            params->min = opt->constraint.range->min;
+            params->max = opt->constraint.range->max;
+            params->quant = opt->constraint.range->quant;
+            break;
+        case SANE_CONSTRAINT_WORD_LIST:
+            len = opt->constraint.word_list[0];
+            if (len > 64) len = 64;
+            params->words[0] = len;
+            for (j = 1; j <= len; j++) params->words[j] = opt->constraint.word_list[j];
+            break;
+        case SANE_CONSTRAINT_STRING_LIST:
+            p = params->strings;
+            for (j = 0; opt->constraint.string_list[j]; j++)
+            {
+                len = strlen( opt->constraint.string_list[j] ) + 1;
+                if (p + len + 1 > params->strings + sizeof(params->strings)) break;
+                memcpy( p, opt->constraint.string_list[j], len );
+                p += len;
+            }
+            *p = 0;
+            break;
+        default:
+            break;
+        }
+        return STATUS_SUCCESS;
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS get_value( void *args )
+{
+    struct sane_value_params *params = args;
+    SANE_Handle handle = (SANE_Handle)(UINT_PTR)params->handle;
+    const SANE_Option_Descriptor *opt = sane_get_option_descriptor( handle, params->optno );
+    char buffer[256];
+
+    if (!opt) return STATUS_INVALID_PARAMETER;
+    if (opt->type == SANE_TYPE_STRING)
+    {
+        if (opt->size > sizeof(buffer)) return STATUS_BUFFER_TOO_SMALL;
+        params->status = sane_control_option( handle, params->optno, SANE_ACTION_GET_VALUE, buffer, NULL );
+        copy_string( params->string, buffer, sizeof(params->string) );
+    }
+    else if (opt->size == sizeof(SANE_Word))
+        params->status = sane_control_option( handle, params->optno, SANE_ACTION_GET_VALUE, &params->value, NULL );
+    else
+        params->status = SANE_STATUS_UNSUPPORTED;
+    return STATUS_SUCCESS;
+}
