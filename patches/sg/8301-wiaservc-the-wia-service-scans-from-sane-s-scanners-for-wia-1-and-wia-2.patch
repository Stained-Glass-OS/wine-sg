+/* The property stream: the writable values, as id, type and value, so a program can save
+ * the settings of an item and put them back later. */
+static HRESULT WINAPI propstg_GetPropertyStream(IWiaPropertyStorage *iface, GUID *compat, IStream **out)
+{
+    struct wia_propstg *This = impl_from_IWiaPropertyStorage(iface);
+    IStream *stream;
+    HRESULT hr;
+    ULONG i;
+
+    TRACE("(%p, %p, %p)\n", This, compat, out);
+
+    if (!compat || !out) return E_INVALIDARG;
+    *out = NULL;
+    *compat = GUID_NULL;
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &stream))) return hr;
+    EnterCriticalSection(This->props->cs);
+    for (i = 0; i < This->props->count && SUCCEEDED(hr); i++)
+    {
+        const struct wia_prop *prop = &This->props->props[i];
+        if (!(prop->flags & WIA_PROP_WRITE)) continue;
+        if (prop->value.vt == VT_I4)
+        {
+            LONG rec[3] = { prop->id, VT_I4, prop->value.lVal };
+            hr = IStream_Write(stream, rec, sizeof(rec), NULL);
+        }
+        else if (prop->value.vt == VT_CLSID && prop->value.puuid)
+        {
+            LONG rec[2] = { prop->id, VT_CLSID };
+            if (SUCCEEDED(hr = IStream_Write(stream, rec, sizeof(rec), NULL)))
+                hr = IStream_Write(stream, prop->value.puuid, sizeof(GUID), NULL);
+        }
+    }
+    LeaveCriticalSection(This->props->cs);
+    if (SUCCEEDED(hr))
+    {
+        LARGE_INTEGER zero = {{0}};
+        IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+        *out = stream;
+        return S_OK;
+    }
+    IStream_Release(stream);
+    return hr;
+}
+
+static HRESULT WINAPI propstg_SetPropertyStream(IWiaPropertyStorage *iface, GUID *compat, IStream *stream)
+{
+    struct wia_propstg *This = impl_from_IWiaPropertyStorage(iface);
+    LONG rec[2];
+    ULONG got;
+
+    TRACE("(%p, %p, %p)\n", This, compat, stream);
+
+    if (!stream) return S_OK;
+    while (SUCCEEDED(IStream_Read(stream, rec, sizeof(rec), &got)) && got == sizeof(rec))
+    {
+        PROPSPEC spec;
+        PROPVARIANT value;
+        GUID guid;
+
+        spec.ulKind = PRSPEC_PROPID;
+        spec.propid = rec[0];
+        if (rec[1] == VT_I4)
+        {
+            if (FAILED(IStream_Read(stream, &value.lVal, sizeof(LONG), &got)) || got != sizeof(LONG)) break;
+            value.vt = VT_I4;
+        }
+        else if (rec[1] == VT_CLSID)
+        {
+            if (FAILED(IStream_Read(stream, &guid, sizeof(guid), &got)) || got != sizeof(guid)) break;
+            value.vt = VT_CLSID;
+            value.puuid = &guid;
+        }
+        else return E_INVALIDARG;
+        propstg_WriteMultiple(iface, 1, &spec, &value, 2);
+    }
+    return S_OK;
+}
