+struct transfer_ctx
+{
+    struct wia_item *item;
+    IWiaTransferCallback *callback;
+    ULONG64 bytes;
+};
+
+static HRESULT transfer_status(struct transfer_ctx *ctx, LONG message, LONG percent, HRESULT status)
+{
+    WiaTransferParams params;
+    HRESULT hr;
+
+    params.lMessage = message;
+    params.lPercentComplete = percent;
+    params.ulTransferredBytes = ctx->bytes;
+    params.hrErrorStatus = status;
+    hr = IWiaTransferCallback_TransferCallback(ctx->callback, 0, &params);
+    if (InterlockedCompareExchange(&ctx->item->cancelled, 0, 0)) return S_FALSE;
+    return hr;
+}
+
+static HRESULT transfer_progress(void *data, LONG percent)
+{
+    struct transfer_ctx *ctx = data;
+    HRESULT hr = transfer_status(ctx, WIA_TRANSFER_MSG_STATUS, percent, S_OK);
+
+    return hr == S_OK ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI transfer_Download(IWiaTransfer *iface, LONG flags, IWiaTransferCallback *callback)
+{
+    struct wia_item *item = impl_from_IWiaTransfer(iface);
+    struct transfer_ctx ctx = { item, callback };
+    LONG pages, page, datatype;
+    BSTR name, full_name;
+    HRESULT hr;
+    GUID format;
+
+    TRACE("(%p, %#lx, %p)\n", item, flags, callback);
+
+    if (!callback) return E_INVALIDARG;
+    if (FAILED(hr = begin_transfer(item))) return hr;
+    if (!props_get_guid(&item->props, WIA_IPA_FORMAT, &format)) format = WiaImgFmt_BMP;
+    pages = item->kind == ITEM_FEEDER ? props_get_long(&item->props, WIA_IPS_PAGES) : 1;
+    name = SysAllocString(item->name);
+    full_name = SysAllocString(item->full_name);
+    apply_settings(item, &datatype);
+
+    for (page = 0; !pages || page < pages; page++)
+    {
+        struct scan_image img;
+        IStream *stream = NULL;
+        BYTE *data = NULL;
+        SIZE_T size;
+
+        hr = read_page(item, datatype, &img, transfer_progress, &ctx);
+        if (hr == WIA_ERROR_PAPER_EMPTY && page)
+        {
+            hr = S_OK; /* the feeder is empty: the batch is done */
+            break;
+        }
+        if (hr != S_OK) break;
+        hr = encode_image(&img, &format, TRUE, &data, &size);
+        free(img.bits);
+        if (SUCCEEDED(hr)) hr = IWiaTransferCallback_GetNextStream(callback, 0, name, full_name, &stream);
+        if (hr == S_OK && stream)
+        {
+            if (SUCCEEDED(hr = write_stream(stream, data, size)))
+            {
+                ctx.bytes += size;
+                hr = transfer_status(&ctx, WIA_TRANSFER_MSG_END_OF_STREAM, 100, S_OK);
+            }
+            IStream_Release(stream);
+        }
+        else if (hr == S_OK) hr = E_POINTER;
+        free(data);
+        if (hr != S_OK) break;
+        if (!item_feeds(item)) break;
+    }
+    end_transfer(item, FALSE);
+    if (hr == S_OK) hr = transfer_status(&ctx, WIA_TRANSFER_MSG_END_OF_TRANSFER, 100, S_OK);
+    SysFreeString(name);
+    SysFreeString(full_name);
+    if (FAILED(hr)) return hr;
+    return hr == S_OK ? S_OK : S_FALSE;
+}
