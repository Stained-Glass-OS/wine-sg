From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: the firewall is told which program listens

Stained Glass Firewall (sg-session's sg-firewall, 2026-10-07) blocks
connections other computers start, and opens the ports an allowed program
listens on while it listens; a program with no rule makes the person's
session ask, as Windows does ("... has blocked some features of this
app"). A Windows program's sockets are made and listened on by wineserver,
so the system says only that wineserver listens: the firewall could not
tell Sonos from any other program, nor ask about it.

When a TCP socket starts listening, or a UDP socket is bound, on an address
other computers can reach (not the loopback), Wine now tells the firewall:
a datagram to /run/stained-glass-firewall/notify (SG_FIREWALL_NOTIFY for
tests) carrying the program's Windows path and the socket itself
(SCM_RIGHTS -- proof it is this program's socket; the kernel adds the
sender's uid and pid). It never waits: with no firewall running nothing
changes.

Test: test/fwlisten-gate.sh with test/fwlisten-probe.c (mutant
SG_MUTANT_FW_LISTEN_NOTIFY).
---
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -6725,8 +6725,12 @@
     }
 
     if (status == STATUS_NOT_SUPPORTED || status == STATUS_BAD_DEVICE_TYPE)
-        return server_ioctl_file( handle, event, apc, apc_context, io, code,
-                                  in_buffer, in_size, out_buffer, out_size );
+    {
+        status = server_ioctl_file( handle, event, apc, apc_context, io, code,
+                                    in_buffer, in_size, out_buffer, out_size );
+        /* Stained Glass OS: the firewall learns which program listens */
+        if (!status && (device == FILE_DEVICE_BEEP || device == FILE_DEVICE_NETWORK)) sg_firewall_notify( handle, code );
+    }
     return status;
 }
 
--- a/dlls/ntdll/unix/socket.c
+++ b/dlls/ntdll/unix/socket.c
@@ -28,6 +28,7 @@
 #include <sys/types.h>
 #include <sys/socket.h>
 #include <sys/ioctl.h>
+#include <sys/un.h>
 #include <unistd.h>
 #ifdef HAVE_IFADDRS_H
 # include <ifaddrs.h>
@@ -1528,6 +1529,82 @@
 }
 
 
+/* Stained Glass OS: the firewall (sg-session's sg-firewall) opens the ports
+ * an allowed program listens on, while it listens, and asks the person about
+ * a program with no rule. A Windows program's socket is wineserver's -- the
+ * server made it and listens on it -- so the firewall cannot tell from the
+ * system whose it is. Tell it: the program's path, with the socket itself
+ * (SCM_RIGHTS: proof it is this program's; the kernel adds our uid and pid).
+ * Only a TCP socket that listens and a UDP socket that is bound, on an
+ * address other computers can reach; never waits: a firewall that is not
+ * running changes nothing. */
+void sg_firewall_notify( HANDLE handle, ULONG code )
+{
+#ifndef SG_MUTANT_FW_LISTEN_NOTIFY
+    static const char default_path[] = "/run/stained-glass-firewall/notify";
+    union unix_sockaddr addr;
+    socklen_t len = sizeof(addr), tlen;
+    struct sockaddr_un to;
+    struct msghdr msg;
+    struct iovec iov;
+    char control[CMSG_SPACE(sizeof(int))], text[1100];
+    struct cmsghdr *cmsg;
+    const UNICODE_STRING *image;
+    const char *path;
+    int fd, needs_close = FALSE, type = 0, out, n;
+
+    if (code != IOCTL_AFD_LISTEN && code != IOCTL_AFD_BIND) return;
+    if (server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )) return;
+    tlen = sizeof(type);
+    if (getsockopt( fd, SOL_SOCKET, SO_TYPE, &type, &tlen ) ||
+        type != (code == IOCTL_AFD_LISTEN ? SOCK_STREAM : SOCK_DGRAM)) goto done;
+    if (getsockname( fd, &addr.addr, &len )) goto done;
+    if (addr.addr.sa_family == AF_INET)
+    {
+        if ((ntohl( addr.in.sin_addr.s_addr ) >> 24) == 127) goto done;
+    }
+    else if (addr.addr.sa_family == AF_INET6)
+    {
+        if (IN6_IS_ADDR_LOOPBACK( &addr.in6.sin6_addr )) goto done;
+        if (IN6_IS_ADDR_V4MAPPED( &addr.in6.sin6_addr ) && addr.in6.sin6_addr.s6_addr[12] == 127) goto done;
+    }
+    else goto done;
+
+    image = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    memcpy( text, "SGFW1\n", 6 );
+    n = ntdll_wcstoumbs( image->Buffer, image->Length / sizeof(WCHAR), text + 6, sizeof(text) - 8, FALSE );
+    if (n <= 0) goto done;
+    text[6 + n] = '\n';
+
+    if (!(path = getenv( "SG_FIREWALL_NOTIFY" )) || !path[0]) path = default_path;
+    if (strlen( path ) >= sizeof(to.sun_path)) goto done;
+    memset( &to, 0, sizeof(to) );
+    to.sun_family = AF_UNIX;
+    strcpy( to.sun_path, path );
+    if ((out = socket( AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC, 0 )) == -1) goto done;
+    iov.iov_base = text;
+    iov.iov_len = 7 + n;
+    memset( &msg, 0, sizeof(msg) );
+    msg.msg_name = &to;
+    msg.msg_namelen = sizeof(to);
+    msg.msg_iov = &iov;
+    msg.msg_iovlen = 1;
+    msg.msg_control = control;
+    msg.msg_controllen = sizeof(control);
+    cmsg = CMSG_FIRSTHDR( &msg );
+    cmsg->cmsg_level = SOL_SOCKET;
+    cmsg->cmsg_type = SCM_RIGHTS;
+    cmsg->cmsg_len = CMSG_LEN( sizeof(int) );
+    memcpy( CMSG_DATA( cmsg ), &fd, sizeof(int) );
+    if (sendmsg( out, &msg, MSG_DONTWAIT | MSG_NOSIGNAL ) == -1)
+        TRACE( "firewall not told: %s\n", strerror( errno ) );
+    close( out );
+done:
+    if (needs_close) close( fd );
+#endif
+}
+
+
 NTSTATUS sock_ioctl( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, void *apc_user, IO_STATUS_BLOCK *io,
                      UINT code, void *in_buffer, UINT in_size, void *out_buffer, UINT out_size )
 {
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -336,6 +336,7 @@
                                         IO_STATUS_BLOCK *io, UINT code, void *in_buffer,
                                         UINT in_size, void *out_buffer, UINT out_size );
 extern NTSTATUS serial_FlushBuffersFile( int fd );
+extern void sg_firewall_notify( HANDLE handle, ULONG code );
 extern NTSTATUS sock_ioctl( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, void *apc_user, IO_STATUS_BLOCK *io,
                             UINT code, void *in_buffer, UINT in_size, void *out_buffer, UINT out_size );
 extern NTSTATUS sock_read( HANDLE handle, int fd, HANDLE event, PIO_APC_ROUTINE apc, void *apc_user,
