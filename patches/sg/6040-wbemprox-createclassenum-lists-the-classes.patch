From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wbemprox: CreateClassEnum lists the classes (6040)

IWbemServices::CreateClassEnum and CreateClassEnumAsync returned
WBEM_E_FAILED, so SWbemServices.SubclassesOf, Get-WmiObject -List and WMI
browsers listed nothing. They now give the namespace's classes as class
objects: all of them, or the subclasses of a superclass (an abstract CIM
class too), deep or WBEM_FLAG_SHALLOW, with the classes applications
stored; an unknown superclass is WBEM_E_INVALID_CLASS. The definitions
come from a query that is not run, so no table is filled.
---
diff --git a/dlls/wbemprox/query.c b/dlls/wbemprox/query.c
index dc85a2e..6d8ebe3 100644
--- a/dlls/wbemprox/query.c
+++ b/dlls/wbemprox/query.c
@@ -829,6 +829,27 @@ done:
     return hr;
 }
 
+/* Stained Glass OS: a query of the class that is not run: its definition without filling its table
+ * (CIM_DataFile's would list the disk) */
+HRESULT exec_class_query( enum wbm_namespace ns, const WCHAR *class, IEnumWbemClassObject **result )
+{
+    static const WCHAR select_allW[] = L"SELECT * FROM ";
+    struct query *query;
+    WCHAR *str;
+    HRESULT hr;
+
+    *result = NULL;
+    if (!(str = malloc( (wcslen( select_allW ) + wcslen( class ) + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    wcscpy( str, select_allW );
+    wcscat( str, class );
+    if (!(query = create_query( ns ))) { free( str ); return E_OUTOFMEMORY; }
+    hr = parse_query( ns, str, &query->view, &query->mem );
+    free( str );
+    if (hr == S_OK) hr = EnumWbemClassObject_create( query, (void **)result );
+    release_query( query );
+    return hr;
+}
+
 BOOL is_result_prop( const struct view *view, const WCHAR *name )
 {
     const struct property *prop = view->proplist;
diff --git a/dlls/wbemprox/services.c b/dlls/wbemprox/services.c
index 26c5f9b..2dfb8b1 100644
--- a/dlls/wbemprox/services.c
+++ b/dlls/wbemprox/services.c
@@ -668,6 +668,261 @@ static HRESULT WINAPI wbem_services_DeleteClassAsync(
     return WBEM_E_FAILED;
 }
 
+/* ---- Stained Glass OS: the classes of a namespace (CreateClassEnum) --------------------------- */
+
+#ifndef WBEM_FLAG_SHALLOW
+#define WBEM_FLAG_SHALLOW 1   /* WBEM_QUERY_FLAG_TYPE: only the direct subclasses */
+#endif
+
+struct object_list_enum
+{
+    IEnumWbemClassObject IEnumWbemClassObject_iface;
+    LONG refs;
+    IWbemClassObject **objects;
+    ULONG count, pos;
+};
+
+static inline struct object_list_enum *impl_from_object_list( IEnumWbemClassObject *iface )
+{
+    return CONTAINING_RECORD( iface, struct object_list_enum, IEnumWbemClassObject_iface );
+}
+
+static HRESULT WINAPI object_list_QueryInterface( IEnumWbemClassObject *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IEnumWbemClassObject ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        IEnumWbemClassObject_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI object_list_AddRef( IEnumWbemClassObject *iface )
+{
+    return InterlockedIncrement( &impl_from_object_list( iface )->refs );
+}
+
+static ULONG WINAPI object_list_Release( IEnumWbemClassObject *iface )
+{
+    struct object_list_enum *list = impl_from_object_list( iface );
+    LONG refs = InterlockedDecrement( &list->refs );
+    ULONG i;
+
+    if (!refs)
+    {
+        for (i = 0; i < list->count; i++) IWbemClassObject_Release( list->objects[i] );
+        free( list->objects );
+        free( list );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI object_list_Reset( IEnumWbemClassObject *iface )
+{
+    impl_from_object_list( iface )->pos = 0;
+    return WBEM_S_NO_ERROR;
+}
+
+static HRESULT WINAPI object_list_Next( IEnumWbemClassObject *iface, LONG timeout, ULONG count,
+                                        IWbemClassObject **objects, ULONG *returned )
+{
+    struct object_list_enum *list = impl_from_object_list( iface );
+    ULONG n = 0;
+
+    if (!objects || !returned) return WBEM_E_INVALID_PARAMETER;
+    if (timeout != WBEM_INFINITE && timeout < 0) return WBEM_E_INVALID_PARAMETER;
+    while (n < count && list->pos < list->count)
+    {
+        objects[n] = list->objects[list->pos++];
+        IWbemClassObject_AddRef( objects[n++] );
+    }
+    *returned = n;
+    return n == count ? WBEM_S_NO_ERROR : WBEM_S_FALSE;
+}
+
+static HRESULT WINAPI object_list_NextAsync( IEnumWbemClassObject *iface, ULONG count, IWbemObjectSink *sink )
+{
+    FIXME( "%p, %lu, %p\n", iface, count, sink );
+    return WBEM_E_FAILED;
+}
+
+static HRESULT object_list_create( IWbemClassObject **objects, ULONG count, ULONG pos, IEnumWbemClassObject **ret );
+
+static HRESULT WINAPI object_list_Clone( IEnumWbemClassObject *iface, IEnumWbemClassObject **ret )
+{
+    struct object_list_enum *list = impl_from_object_list( iface );
+    IWbemClassObject **copy;
+    ULONG i;
+    HRESULT hr;
+
+    if (!ret) return WBEM_E_INVALID_PARAMETER;
+    if (!(copy = malloc( max( list->count, 1 ) * sizeof(*copy) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < list->count; i++) IWbemClassObject_AddRef( (copy[i] = list->objects[i]) );
+    if (FAILED(hr = object_list_create( copy, list->count, list->pos, ret )))
+    {
+        for (i = 0; i < list->count; i++) IWbemClassObject_Release( copy[i] );
+        free( copy );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI object_list_Skip( IEnumWbemClassObject *iface, LONG timeout, ULONG count )
+{
+    struct object_list_enum *list = impl_from_object_list( iface );
+    ULONG left = list->count - list->pos;
+
+    if (timeout != WBEM_INFINITE && timeout < 0) return WBEM_E_INVALID_PARAMETER;
+    list->pos += min( left, count );
+    return count <= left ? WBEM_S_NO_ERROR : WBEM_S_FALSE;
+}
+
+static const IEnumWbemClassObjectVtbl object_list_vtbl =
+{
+    object_list_QueryInterface,
+    object_list_AddRef,
+    object_list_Release,
+    object_list_Reset,
+    object_list_Next,
+    object_list_NextAsync,
+    object_list_Clone,
+    object_list_Skip
+};
+
+/* takes the array and the references in it */
+static HRESULT object_list_create( IWbemClassObject **objects, ULONG count, ULONG pos, IEnumWbemClassObject **ret )
+{
+    struct object_list_enum *list;
+
+    if (!(list = calloc( 1, sizeof(*list) ))) return E_OUTOFMEMORY;
+    list->IEnumWbemClassObject_iface.lpVtbl = &object_list_vtbl;
+    list->refs = 1;
+    list->objects = objects;
+    list->count = count;
+    list->pos = pos;
+    *ret = &list->IEnumWbemClassObject_iface;
+    return S_OK;
+}
+
+/* the class object of a class (not one of its instances) */
+static HRESULT get_class_definition( enum wbm_namespace ns, const WCHAR *name, IWbemClassObject **obj )
+{
+    IEnumWbemClassObject *iter;
+    HRESULT hr;
+
+    *obj = NULL;
+#ifdef SG_MUTANT_WMI_CLASSENUM_FILL
+    {
+        struct path *path;
+        if ((hr = parse_path( name, &path )) != S_OK) return hr;
+        hr = create_instance_enum( ns, path, &iter );
+        free_path( path );
+        if (hr != S_OK) return hr;
+    }
+#else
+    if ((hr = exec_class_query( ns, name, &iter )) != S_OK) return hr;
+#endif
+    hr = create_class_only_object( iter, ns, obj );
+    IEnumWbemClassObject_Release( iter );
+    return hr;
+}
+
+/* whether the class is one CreateClassEnum gives for the superclass (NULL: from the top) */
+static BOOL class_matches( const WCHAR *class, const WCHAR *superclass, BOOL shallow )
+{
+    const WCHAR *parent = get_class_parent( class );
+
+    if (!superclass || !superclass[0]) return !shallow || !parent;
+    if (!wcsicmp( class, superclass )) return FALSE;
+    if (shallow) return parent && !wcsicmp( parent, superclass );
+#ifdef SG_MUTANT_WMI_CLASSENUM_SHALLOW_ONLY
+    return parent && !wcsicmp( parent, superclass );
+#endif
+    for (; parent; parent = get_class_parent( parent ))
+        if (!wcsicmp( parent, superclass )) return TRUE;
+    return FALSE;
+}
+
+static BOOL name_listed( WCHAR **names, UINT count, const WCHAR *name )
+{
+    UINT i;
+    for (i = 0; i < count; i++) if (!wcsicmp( names[i], name )) return TRUE;
+    return FALSE;
+}
+
+static HRESULT create_class_enum( enum wbm_namespace ns, const WCHAR *superclass, LONG flags, IEnumWbemClassObject **ret )
+{
+    WCHAR **names = NULL, **stored = NULL, **grown;
+    UINT count = 0, stored_count = 0, i;
+    IWbemClassObject **objects = NULL, **more, *obj;
+    ULONG n = 0;
+    HRESULT hr;
+    BOOL shallow = (flags & WBEM_FLAG_SHALLOW) != 0;
+
+    /* the namespace's classes: its own, and those stored for it */
+    hr = list_table_names( ns, &names, &count );
+#ifndef SG_MUTANT_WMI_CLASSENUM_NO_STORED
+    if (hr == S_OK) hr = list_user_classes( ns, &stored, &stored_count );
+#endif
+    for (i = 0; hr == S_OK && i < stored_count; i++)
+    {
+        if (name_listed( names, count, stored[i] )) continue;
+        if (!(grown = realloc( names, (count + 1) * sizeof(*names) ))) { hr = E_OUTOFMEMORY; break; }
+        names = grown;
+        names[count++] = stored[i];
+        stored[i] = NULL;
+    }
+    for (i = 0; i < stored_count; i++) free( stored[i] );
+    free( stored );
+
+    /* the superclass must be a class */
+    if (hr == S_OK && superclass && superclass[0])
+    {
+        if (get_class_definition( ns, superclass, &obj ) == S_OK) IWbemClassObject_Release( obj );
+        else if (!name_listed( names, count, superclass ))
+        {
+            /* an abstract class (CIM_...) has no table but is some class's parent */
+            BOOL parent = FALSE;
+            for (i = 0; i < count && !parent; i++)
+            {
+                const WCHAR *p;
+                for (p = get_class_parent( names[i] ); p && !parent; p = get_class_parent( p ))
+                    parent = !wcsicmp( p, superclass );
+            }
+            if (!parent) hr = WBEM_E_INVALID_CLASS;
+        }
+    }
+
+    for (i = 0; hr == S_OK && i < count; i++)
+    {
+        /* the definition first: a stored class's superclass is known once it is read */
+        if (get_class_definition( ns, names[i], &obj ) != S_OK) continue;
+        if (!class_matches( names[i], superclass, shallow ))
+        {
+            IWbemClassObject_Release( obj );
+            continue;
+        }
+        if (!(more = realloc( objects, (n + 1) * sizeof(*objects) )))
+        {
+            IWbemClassObject_Release( obj );
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+        objects = more;
+        objects[n++] = obj;
+    }
+    for (i = 0; i < count; i++) free( names[i] );
+    free( names );
+    if (hr == S_OK) hr = object_list_create( objects, n, 0, ret );
+    if (hr != S_OK)
+    {
+        for (i = 0; i < n; i++) IWbemClassObject_Release( objects[i] );
+        free( objects );
+    }
+    return hr;
+}
+
 static HRESULT WINAPI wbem_services_CreateClassEnum(
     IWbemServices *iface,
     const BSTR strSuperclass,
@@ -675,8 +930,16 @@ static HRESULT WINAPI wbem_services_CreateClassEnum(
     IWbemContext *pCtx,
     IEnumWbemClassObject **ppEnum )
 {
-    FIXME("\n");
-    return WBEM_E_FAILED;
+    struct wbem_services *services = impl_from_IWbemServices( iface );
+
+    TRACE( "%p, %s, %#lx, %p, %p\n", iface, debugstr_w(strSuperclass), lFlags, pCtx, ppEnum );
+
+    if (!ppEnum) return WBEM_E_INVALID_PARAMETER;
+    *ppEnum = NULL;
+    if (lFlags & ~(WBEM_FLAG_SHALLOW | WBEM_FLAG_RETURN_IMMEDIATELY | WBEM_FLAG_FORWARD_ONLY |
+                   WBEM_FLAG_BIDIRECTIONAL | WBEM_FLAG_USE_AMENDED_QUALIFIERS))
+        return WBEM_E_INVALID_PARAMETER;
+    return create_class_enum( services->ns, strSuperclass, lFlags, ppEnum );
 }
 
 static HRESULT WINAPI wbem_services_CreateClassEnumAsync(
@@ -686,8 +949,28 @@ static HRESULT WINAPI wbem_services_CreateClassEnumAsync(
     IWbemContext *pCtx,
     IWbemObjectSink *pResponseHandler )
 {
-    FIXME("\n");
-    return WBEM_E_FAILED;
+    struct wbem_services *services = impl_from_IWbemServices( iface );
+    IEnumWbemClassObject *list;
+    IWbemClassObject *obj;
+    ULONG count;
+    HRESULT hr;
+
+    TRACE( "%p, %s, %#lx, %p, %p\n", iface, debugstr_w(strSuperclass), lFlags, pCtx, pResponseHandler );
+
+    if (!pResponseHandler) return WBEM_E_INVALID_PARAMETER;
+    /* the classes are given to the sink before this returns */
+    hr = create_class_enum( services->ns, strSuperclass, lFlags, &list );
+    if (hr == S_OK)
+    {
+        while (IEnumWbemClassObject_Next( list, WBEM_INFINITE, 1, &obj, &count ) == S_OK && count)
+        {
+            IWbemObjectSink_Indicate( pResponseHandler, 1, &obj );
+            IWbemClassObject_Release( obj );
+        }
+        IEnumWbemClassObject_Release( list );
+    }
+    IWbemObjectSink_SetStatus( pResponseHandler, WBEM_STATUS_COMPLETE, hr, NULL, NULL );
+    return hr == WBEM_E_INVALID_CLASS ? hr : S_OK;
 }
 
 static HRESULT WINAPI wbem_services_PutInstance(
diff --git a/dlls/wbemprox/table.c b/dlls/wbemprox/table.c
index bceaed2..8080ba2 100644
--- a/dlls/wbemprox/table.c
+++ b/dlls/wbemprox/table.c
@@ -538,3 +538,30 @@ WCHAR *get_first_key_property( enum wbm_namespace ns, const WCHAR *class )
     release_table( table );
     return ret;
 }
+
+/* Stained Glass OS: the names of the namespace's named classes (tables); free each and the array */
+HRESULT list_table_names( enum wbm_namespace ns, WCHAR ***names, UINT *count )
+{
+    struct table *table;
+    WCHAR **list = NULL, **grown;
+    HRESULT hr = S_OK;
+    UINT n = 0, i;
+
+    EnterCriticalSection( &table_list_cs );
+    LIST_FOR_EACH_ENTRY( table, table_list[ns], struct table, entry )
+    {
+        BOOL dup = FALSE;
+
+        if (table->removed || (table->flags & TABLE_FLAG_SPAWNED) || !table->name || is_unnamed_class( table )) continue;
+        for (i = 0; i < n && !dup; i++) dup = !wcsicmp( list[i], table->name );
+        if (dup) continue;
+        if (!(grown = realloc( list, (n + 1) * sizeof(*list) ))) { hr = E_OUTOFMEMORY; break; }
+        list = grown;
+        if (!(list[n] = wcsdup( table->name ))) { hr = E_OUTOFMEMORY; break; }
+        n++;
+    }
+    LeaveCriticalSection( &table_list_cs );
+    *names = list;
+    *count = n;
+    return hr;
+}
diff --git a/dlls/wbemprox/userclass.c b/dlls/wbemprox/userclass.c
index 2214e13..aa0ff6f 100644
--- a/dlls/wbemprox/userclass.c
+++ b/dlls/wbemprox/userclass.c
@@ -432,6 +432,37 @@ HRESULT put_user_class( enum wbm_namespace ns, const struct table *def, LONG fla
     return reg_error( err );
 }
 
+/* the names of the classes stored for the namespace; free each and the array */
+HRESULT list_user_classes( enum wbm_namespace ns, WCHAR ***names, UINT *count )
+{
+    WCHAR *path, name[256];
+    DWORD index = 0, len;
+    WCHAR **list = NULL, **grown;
+    UINT n = 0;
+    HKEY key;
+
+    *names = NULL;
+    *count = 0;
+    if (!(path = classes_key_path( ns, NULL ))) return E_OUTOFMEMORY;
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key ))
+    {
+        free( path );
+        return S_OK;
+    }
+    free( path );
+    while (len = ARRAY_SIZE(name), !RegEnumKeyExW( key, index++, name, &len, NULL, NULL, NULL, NULL ))
+    {
+        if (!(grown = realloc( list, (n + 1) * sizeof(*list) ))) break;
+        list = grown;
+        if (!(list[n] = wcsdup( name ))) break;
+        n++;
+    }
+    RegCloseKey( key );
+    *names = list;
+    *count = n;
+    return S_OK;
+}
+
 HRESULT delete_user_class( enum wbm_namespace ns, const WCHAR *name )
 {
     WCHAR *path;
diff --git a/dlls/wbemprox/wbemprox_private.h b/dlls/wbemprox/wbemprox_private.h
index 5a667cf..6448c4f 100644
--- a/dlls/wbemprox/wbemprox_private.h
+++ b/dlls/wbemprox/wbemprox_private.h
@@ -278,6 +278,9 @@ BOOL is_result_prop( const struct view *, const WCHAR * );
 #define NUM_SYSTEM_PROPS 10
 const WCHAR *system_prop_name( UINT );
 const WCHAR *get_class_parent( const WCHAR * );
+HRESULT list_user_classes( enum wbm_namespace, WCHAR ***, UINT * );
+HRESULT list_table_names( enum wbm_namespace, WCHAR ***, UINT * );
