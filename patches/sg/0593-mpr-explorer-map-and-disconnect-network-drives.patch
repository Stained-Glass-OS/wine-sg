+WINE_DEFAULT_DEBUG_CHANNEL(mpr);
+
+#define ID_DRIVE     101
+#define ID_FOLDER    102
+#define ID_RECONNECT 103
+#define ID_OTHERCRED 104
+#define ID_LIST      105
+
+struct mapdlg
+{
+    HFONT font, big;
+    HWND drive, folder, reconnect, othercred, list;
+    int result;
+};
+
+static int scale(int x)
+{
+    HDC dc = GetDC(NULL);
+    int dpi = GetDeviceCaps(dc, LOGPIXELSY);
+    ReleaseDC(NULL, dc);
+    return MulDiv(x, dpi, 96);
+}
+
+static HFONT ui_font(int size)
+{
+    NONCLIENTMETRICSW ncm = { sizeof(ncm) };
+    SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0);
+    if (size) ncm.lfMessageFont.lfHeight = -MulDiv(size, GetDeviceCaps(GetDC(NULL), LOGPIXELSY), 72);
+    return CreateFontIndirectW(&ncm.lfMessageFont);
+}
+
+static HWND control(HWND parent, const WCHAR *cls, const WCHAR *text, DWORD style, int x, int y, int w, int h,
+                    int id, HFONT font)
+{
+    HWND c = CreateWindowExW(!wcscmp(cls, L"Edit") ? WS_EX_CLIENTEDGE : 0, cls, text, WS_CHILD | WS_VISIBLE | style,
+                             scale(x), scale(y), scale(w), scale(h), parent, (HMENU)(INT_PTR)id,
+                             GetModuleHandleW(NULL), NULL);
+    SendMessageW(c, WM_SETFONT, (WPARAM)font, FALSE);
+    return c;
+}
+
+static LRESULT CALLBACK mapdlg_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct mapdlg *d = (struct mapdlg *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+
+    switch (msg)
+    {
+    case WM_CREATE:
+        SetWindowLongPtrW(hwnd, GWLP_USERDATA, (LONG_PTR)((CREATESTRUCTW *)lp)->lpCreateParams);
+        return 0;
+    case WM_CTLCOLORSTATIC:
+    case WM_CTLCOLORBTN:
+        SetBkColor((HDC)wp, GetSysColor(COLOR_WINDOW));
+        return (LRESULT)GetSysColorBrush(COLOR_WINDOW);
+    case WM_ERASEBKGND:
+    {
+        RECT rc;
+        GetClientRect(hwnd, &rc);
+        FillRect((HDC)wp, &rc, GetSysColorBrush(COLOR_WINDOW));
+        return 1;
+    }
+    case WM_COMMAND:
+        if (LOWORD(wp) == IDOK || LOWORD(wp) == IDCANCEL) d->result = LOWORD(wp);
+        return 0;
+    case WM_CLOSE:
+        d->result = IDCANCEL;
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+static HWND make_dialog(struct mapdlg *d, HWND owner, const WCHAR *title, int w, int h)
+{
+    WNDCLASSW wc = { 0 };
+    RECT rc, orc;
+
+    wc.lpfnWndProc = mapdlg_proc;
+    wc.hInstance = GetModuleHandleW(NULL);
+    wc.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW);
+    wc.lpszClassName = L"SGMapNetworkDrive";
+    RegisterClassW(&wc);
+    d->font = ui_font(0);
+    d->big = ui_font(12);
+    SetRect(&rc, 0, 0, scale(w), scale(h));
+    AdjustWindowRectEx(&rc, WS_CAPTION | WS_SYSMENU, FALSE, WS_EX_DLGMODALFRAME);
+    if (!owner || !GetWindowRect(owner, &orc)) SystemParametersInfoW(SPI_GETWORKAREA, 0, &orc, 0);
+    return CreateWindowExW(WS_EX_DLGMODALFRAME, L"SGMapNetworkDrive", title, WS_POPUP | WS_CAPTION | WS_SYSMENU,
+                           max(0, orc.left + (orc.right - orc.left - (rc.right - rc.left)) / 2),
+                           max(0, orc.top + (orc.bottom - orc.top - (rc.bottom - rc.top)) / 3),
+                           rc.right - rc.left, rc.bottom - rc.top, owner, NULL, GetModuleHandleW(NULL), d);
+}
+
+static void run_dialog(struct mapdlg *d, HWND hwnd, HWND owner)
+{
+    MSG msg;
+
+    if (owner) EnableWindow(owner, FALSE);
+    ShowWindow(hwnd, SW_SHOWNORMAL);
+    SetForegroundWindow(hwnd);
+    d->result = 0;
+    while (!d->result && GetMessageW(&msg, NULL, 0, 0))
+    {
+        if (IsDialogMessageW(hwnd, &msg)) continue;
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+    if (owner) EnableWindow(owner, TRUE);
+}
+
+static void error_box(HWND owner, const WCHAR *what, DWORD err)
+{
+    WCHAR text[512], msg[256] = L"";
+
+    FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL, err, 0, msg, ARRAY_SIZE(msg), NULL);
+    swprintf(text, ARRAY_SIZE(text), L"%s\n\n%s", what, msg[0] ? msg : L"The network path was not found.");
+    MessageBoxW(owner, text, L"Map Network Drive", MB_OK | MB_ICONERROR);
+}
+
+/* the drive letters not in use, last first, as Windows offers them */
+static void fill_letters(HWND combo, const WCHAR *want)
+{
+    DWORD used = GetLogicalDrives();
+    WCHAR name[4] = L"A:";
+    int i, sel = -1;
+
+    for (i = 25; i >= 3; i--)
+    {
+        if (used & (1u << i)) continue;
+        name[0] = 'A' + i;
+        SendMessageW(combo, CB_ADDSTRING, 0, (LPARAM)name);
+        if (want && towupper(want[0]) == name[0]) sel = SendMessageW(combo, CB_GETCOUNT, 0, 0) - 1;
+    }
+    SendMessageW(combo, CB_SETCURSEL, sel >= 0 ? sel : 0, 0);
+}
+
+DWORD mpr_connection_dialog(LPCONNECTDLGSTRUCTW cs)
+{
+    struct mapdlg d = { 0 };
+    HWND hwnd, owner = cs->hwndOwner;
+    NETRESOURCEW *nr = cs->lpConnRes;
+    DWORD ret = WN_CANCEL;
+
+    if (nr && nr->dwType != RESOURCETYPE_DISK && nr->dwType != RESOURCETYPE_ANY) return WN_BAD_VALUE;
+    hwnd = make_dialog(&d, owner, L"Map Network Drive", 470, 270);
+    control(hwnd, L"Static", L"What network folder would you like to map?", 0, 20, 14, 430, 24, 0, d.big);
+    control(hwnd, L"Static", L"Specify the drive letter for the connection and the folder that you want to connect to:",
+            0, 20, 46, 430, 32, 0, d.font);
+    control(hwnd, L"Static", L"&Drive:", 0, 20, 90, 60, 20, 0, d.font);
+    d.drive = control(hwnd, L"ComboBox", NULL, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP, 90, 86, 70, 300, ID_DRIVE, d.font);
+    control(hwnd, L"Static", L"F&older:", 0, 20, 122, 60, 20, 0, d.font);
+    d.folder = control(hwnd, L"Edit", nr && nr->lpRemoteName ? nr->lpRemoteName : L"", ES_AUTOHSCROLL | WS_TABSTOP,
+                       90, 118, 350, 24, ID_FOLDER, d.font);
+    control(hwnd, L"Static", L"Example: \\\\server\\share", 0, 90, 146, 350, 20, 0, d.font);
+    d.reconnect = control(hwnd, L"Button", L"&Reconnect at sign-in", BS_AUTOCHECKBOX | WS_TABSTOP, 90, 170, 300, 22,
+                          ID_RECONNECT, d.font);
+    SendMessageW(d.reconnect, BM_SETCHECK, BST_CHECKED, 0);
+    d.othercred = control(hwnd, L"Button", L"Connect using different &credentials", BS_AUTOCHECKBOX | WS_TABSTOP,
+                          90, 194, 300, 22, ID_OTHERCRED, d.font);
+    control(hwnd, L"Button", L"&Finish", BS_DEFPUSHBUTTON | WS_TABSTOP, 264, 232, 88, 28, IDOK, d.font);
+    control(hwnd, L"Button", L"Cancel", BS_PUSHBUTTON | WS_TABSTOP, 362, 232, 88, 28, IDCANCEL, d.font);
+    fill_letters(d.drive, nr ? nr->lpLocalName : NULL);
+    SetFocus(d.folder);
+
+    for (;;)
+    {
+        WCHAR letter[4] = L"", remote[MAX_PATH] = L"", user[CREDUI_MAX_USERNAME_LENGTH + 1] = L"";
+        WCHAR pass[CREDUI_MAX_PASSWORD_LENGTH + 1] = L"";
+        NETRESOURCEW res = { 0 };
+        BOOL save = FALSE, other;
+        DWORD flags, err;
+
+        run_dialog(&d, hwnd, owner);
+        if (d.result != IDOK) break;
+        GetWindowTextW(d.drive, letter, ARRAY_SIZE(letter));
+        GetWindowTextW(d.folder, remote, ARRAY_SIZE(remote));
+        if (remote[0] != '\\' || remote[1] != '\\' || !wcschr(remote + 2, '\\'))
+        {
+            MessageBoxW(hwnd, L"The folder you entered is not valid. Enter a network folder, such as \\\\server\\share.",
+                        L"Map Network Drive", MB_OK | MB_ICONWARNING);
+            continue;
+        }
+        other = SendMessageW(d.othercred, BM_GETCHECK, 0, 0) == BST_CHECKED;
+        if (other)
+        {
+            CREDUI_INFOW ui = { sizeof(ui), hwnd, L"Enter the user name and password to connect to this folder.",
+                                L"Map Network Drive" };
+            HMODULE credui = LoadLibraryW(L"credui.dll");
+            DWORD (WINAPI *prompt)(CREDUI_INFOW *, const WCHAR *, void *, DWORD, WCHAR *, ULONG, WCHAR *, ULONG, BOOL *, DWORD);
+
+            prompt = credui ? (void *)GetProcAddress(credui, "CredUIPromptForCredentialsW") : NULL;
+            if (!prompt || prompt(&ui, remote, NULL, 0, user, ARRAY_SIZE(user), pass, ARRAY_SIZE(pass), &save,
+                                  CREDUI_FLAGS_DO_NOT_PERSIST | CREDUI_FLAGS_GENERIC_CREDENTIALS))
+                continue;
+        }
+        res.dwType = RESOURCETYPE_DISK;
+        res.lpLocalName = letter;
+        res.lpRemoteName = remote;
+        flags = SendMessageW(d.reconnect, BM_GETCHECK, 0, 0) == BST_CHECKED ? CONNECT_UPDATE_PROFILE : 0;
+        SetCursor(LoadCursorW(NULL, (LPCWSTR)IDC_WAIT));
+        err = WNetAddConnection2W(&res, other ? pass : NULL, other ? user : NULL, flags);
+        SecureZeroMemory(pass, sizeof(pass));
+        SetCursor(LoadCursorW(NULL, (LPCWSTR)IDC_ARROW));
+        TRACE("%s -> %s: %lu\n", debugstr_w(letter), debugstr_w(remote), err);
+        if (err)
+        {
+            error_box(hwnd, L"The folder cannot be reached.", err);
+            continue;
+        }
+        if (cs->cbStructure >= sizeof(*cs)) cs->dwDevNum = towupper(letter[0]) - 'A' + 1;
+        ret = WN_SUCCESS;
+        break;
+    }
+    DestroyWindow(hwnd);
+    DeleteObject(d.font);
+    DeleteObject(d.big);
+    return ret;
+}
+
+DWORD mpr_disconnect_dialog(HWND owner)
+{
+    struct mapdlg d = { 0 };
+    HANDLE e;
+    HWND hwnd;
+    DWORD ret = WN_CANCEL, count, size;
+    BYTE buffer[16384];
+    NETRESOURCEW *nr = (NETRESOURCEW *)buffer;
+    unsigned int i;
+    int n = 0;
+
+    hwnd = make_dialog(&d, owner, L"Disconnect Network Drives", 420, 260);
+    control(hwnd, L"Static", L"Select the network drives you want to disconnect:", 0, 20, 14, 380, 22, 0, d.font);
+    d.list = control(hwnd, L"ListBox", NULL, LBS_NOTIFY | LBS_EXTENDEDSEL | LBS_USETABSTOPS | WS_VSCROLL | WS_BORDER | WS_TABSTOP,
+                     20, 40, 380, 164, ID_LIST, d.font);
+    control(hwnd, L"Button", L"OK", BS_DEFPUSHBUTTON | WS_TABSTOP, 214, 218, 88, 28, IDOK, d.font);
+    control(hwnd, L"Button", L"Cancel", BS_PUSHBUTTON | WS_TABSTOP, 312, 218, 88, 28, IDCANCEL, d.font);
+    /* the drive letters that are network drives (the provider may not
+     * enumerate its connections) */
+    for (i = 0; i < 26; i++)
+    {
+        WCHAR root[4] = L"A:\\", local[3] = L"A:", remote[MAX_PATH], line[MAX_PATH + 8];
+        DWORD len = ARRAY_SIZE(remote);
+
+        root[0] = local[0] = 'A' + i;
+        if (!(GetLogicalDrives() & (1u << i)) || GetDriveTypeW(root) != DRIVE_REMOTE) continue;
+        if (WNetGetConnectionW(local, remote, &len)) lstrcpyW(remote, L"(network drive)");
+        swprintf(line, ARRAY_SIZE(line), L"%s\t%s", local, remote);
+        SendMessageW(d.list, LB_ADDSTRING, 0, (LPARAM)line);
+        n++;
+    }
+    if (!n && !WNetOpenEnumW(RESOURCE_CONNECTED, RESOURCETYPE_DISK, 0, NULL, &e))
+    {
+        for (;;)
+        {
+            count = ~0u;
+            size = sizeof(buffer);
+            if (WNetEnumResourceW(e, &count, buffer, &size) || !count) break;
+            for (i = 0; i < count; i++)
+            {
+                WCHAR line[MAX_PATH + 8];
+                if (!nr[i].lpLocalName || !nr[i].lpRemoteName) continue;
+                swprintf(line, ARRAY_SIZE(line), L"%s\t%s", nr[i].lpLocalName, nr[i].lpRemoteName);
+                SendMessageW(d.list, LB_ADDSTRING, 0, (LPARAM)line);
+                n++;
+            }
+        }
+        WNetCloseEnum(e);
+    }
+    if (!n) SendMessageW(d.list, LB_ADDSTRING, 0, (LPARAM)L"(No network drives are mapped.)");
+    run_dialog(&d, hwnd, owner);
+    if (d.result == IDOK && n)
+    {
+        int sel[32], k = SendMessageW(d.list, LB_GETSELITEMS, ARRAY_SIZE(sel), (LPARAM)sel);
+        for (i = 0; i < (unsigned int)max(k, 0); i++)
+        {
+            WCHAR line[MAX_PATH + 8], *tab;
+            SendMessageW(d.list, LB_GETTEXT, sel[i], (LPARAM)line);
+            if ((tab = wcschr(line, '\t'))) *tab = 0;
+            if (WNetCancelConnection2W(line, CONNECT_UPDATE_PROFILE, TRUE) == WN_SUCCESS) ret = WN_SUCCESS;
+        }
+    }
+    DestroyWindow(hwnd);
+    DeleteObject(d.font);
+    DeleteObject(d.big);
+    return ret;
+}
