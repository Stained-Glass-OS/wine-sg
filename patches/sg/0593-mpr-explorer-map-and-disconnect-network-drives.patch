+/* Stained Glass OS: This PC read again after a drive was mapped or
+ * disconnected (the tree kept what it had read once) */
+static void fill_pc_tree(void);
+
+static void reload_pc_tree(void)
+{
+    TVITEMW tvi = { TVIF_STATE, tree_pc };
+    HTREEITEM child;
+    BOOL expanded;
+
+    if (!tree_pc) return;
+    tvi.stateMask = TVIS_EXPANDED;
+    SendMessageW(fe.tree, TVM_GETITEMW, 0, (LPARAM)&tvi);
+    expanded = (tvi.state & TVIS_EXPANDED) != 0;
+    while ((child = (HTREEITEM)SendMessageW(fe.tree, TVM_GETNEXTITEM, TVGN_CHILD, (LPARAM)tree_pc)))
+        SendMessageW(fe.tree, TVM_DELETEITEM, 0, (LPARAM)child);
+    fill_pc_tree();
+    if (expanded) SendMessageW(fe.tree, TVM_EXPAND, TVE_EXPAND, (LPARAM)tree_pc);
+}
