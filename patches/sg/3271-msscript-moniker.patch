From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:54:53 -0700
Subject: [PATCH] msscript.ocx: IOleObject GetMoniker and SetMoniker (3271)

SetMoniker returns S_OK (the control is not a link source), GetMoniker returns E_UNEXPECTED without a client site and the site's moniker otherwise; E_NOTIMPL is not a documented result for either.

diff --git a/dlls/msscript.ocx/msscript.c b/dlls/msscript.ocx/msscript.c
index 0761f90..99ac9a5 100644
--- a/dlls/msscript.ocx/msscript.c
+++ b/dlls/msscript.ocx/msscript.c
@@ -3221,7 +3221,11 @@ static HRESULT WINAPI OleObject_SetMoniker(IOleObject *iface, DWORD which, IMoni
 
     TRACE("(%p)->(%ld %p)\n", This, which, moniker);
 
+#ifdef SG_MUTANT_MSSCRIPT_MONIKER
     return E_NOTIMPL;
+#endif
+    /* the control is not a link source: there is no name to register or announce */
+    return S_OK;
 }
 
 static HRESULT WINAPI OleObject_GetMoniker(IOleObject *iface, DWORD assign, DWORD which, IMoniker **moniker)
@@ -3230,8 +3234,14 @@ static HRESULT WINAPI OleObject_GetMoniker(IOleObject *iface, DWORD assign, DWOR
 
     TRACE("(%p)->(%ld %ld %p)\n", This, assign, which, moniker);
 
-    if (moniker) *moniker = NULL;
+    if (!moniker) return E_POINTER;
+    *moniker = NULL;
+#ifdef SG_MUTANT_MSSCRIPT_MONIKER
     return E_NOTIMPL;
+#endif
+    /* the moniker is the one of the client site */
+    if (!This->site) return E_UNEXPECTED;
+    return IOleClientSite_GetMoniker(This->site, assign, which, moniker);
 }
 
 static HRESULT WINAPI OleObject_InitFromData(IOleObject *iface, IDataObject *dataobj, BOOL creation,
