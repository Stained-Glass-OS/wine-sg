From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ole32: IEnumGUID::Skip of the categories manager (patch 5106)

Skip steps over entries through Next and says S_FALSE past the end; gap-CORE
items 985 and 986. Gate with two mutants.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/ole32/comcat.c b/dlls/ole32/comcat.c
--- a/dlls/ole32/comcat.c
+++ b/dlls/ole32/comcat.c
@@ -1000,12 +1000,21 @@
     IEnumGUID *iface,
     ULONG celt)
 {
-    CLSID_IEnumGUIDImpl *This = impl_from_IEnumCLSID(iface);
-
     TRACE("\n");
 
-    This->next_index += celt;
-    FIXME("Never returns S_FALSE\n");
+    /* skipping is fetching and dropping: the entries are filtered by the categories as they are fetched,
+     * and S_FALSE says there were fewer left than asked for */
+#ifdef SG_MUTANT_ENUMSKIP
+    return S_OK;
+#endif
+    while (celt)
+    {
+        GUID dummy;
+        ULONG fetched = 0;
+
+        if (CLSIDEnumGUID_Next(iface, 1, &dummy, &fetched) != S_OK || !fetched) return S_FALSE;
+        celt--;
+    }
     return S_OK;
 }
 
@@ -1186,12 +1195,21 @@
     IEnumGUID *iface,
     ULONG celt)
 {
-    CATID_IEnumGUIDImpl *This = impl_from_IEnumCATID(iface);
-
     TRACE("\n");
 
-    This->next_index += celt;
-    FIXME("Never returns S_FALSE\n");
+    /* skipping is fetching and dropping: the entries are filtered by the categories as they are fetched,
+     * and S_FALSE says there were fewer left than asked for */
+#ifdef SG_MUTANT_ENUMSKIP_CATID
+    return S_OK;
+#endif
+    while (celt)
+    {
+        GUID dummy;
+        ULONG fetched = 0;
+
+        if (CATIDEnumGUID_Next(iface, 1, &dummy, &fetched) != S_OK || !fetched) return S_FALSE;
+        celt--;
+    }
     return S_OK;
 }
 
