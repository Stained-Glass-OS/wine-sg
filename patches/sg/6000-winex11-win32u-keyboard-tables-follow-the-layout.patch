diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
index f73a2ed..4461ce6 100644
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -437,19 +437,35 @@ static void kbd_tables_init_vsc2vk( const KBDTABLES *tables, USHORT vsc2vk[0x300
 
 #define NEXT_ENTRY(t, e) ((void *)&(e)->wch[(t)->nModifications])
 
-static void kbd_tables_init_vk2char( const KBDTABLES *tables, BYTE vk2char[0x100] )
+/* Stained Glass OS: a dead key's entry (WCH_DEAD) is followed by an entry
+ * with VirtualKey 0xff holding the characters the dead key stands for, as in
+ * the kbd*.dll tables; those follow-up entries are not keys of their own. */
+static const VK_TO_WCHARS1 *kbd_tables_dead_entry( const VK_TO_WCHAR_TABLE *table, const VK_TO_WCHARS1 *entry )
+{
+    const VK_TO_WCHARS1 *next = NEXT_ENTRY(table, entry);
+    return next->VirtualKey == 0xff ? next : NULL;
+}
+
+static void kbd_tables_init_vk2char( const KBDTABLES *tables, UINT vk2char[0x100] )
 {
     const VK_TO_WCHAR_TABLE *table;
-    const VK_TO_WCHARS1 *entry;
+    const VK_TO_WCHARS1 *entry, *dead;
 
-    memset( vk2char, 0, 0x100 );
+    memset( vk2char, 0, 0x100 * sizeof(*vk2char) );
 
     for (table = tables->pVkToWcharTable; table->pVkToWchars; table++)
     {
         for (entry = table->pVkToWchars; entry->VirtualKey; entry = NEXT_ENTRY(table, entry))
         {
-            if (entry->VirtualKey & ~0xff) continue;
-            vk2char[entry->VirtualKey] = entry->wch[0];
+            if (entry->VirtualKey == 0xff) continue;
+#ifndef SG_MUTANT_KBD_NO_DEAD
+            /* MapVirtualKey MAPVK_VK_TO_CHAR marks a dead key with the top bit */
+            if (entry->wch[0] == WCH_DEAD && (dead = kbd_tables_dead_entry( table, entry )))
+                vk2char[entry->VirtualKey] = 0x80000000 | dead->wch[0];
+            else
+#endif
+            if (entry->wch[0] == WCH_NONE || entry->wch[0] == WCH_DEAD) vk2char[entry->VirtualKey] = 0;
+            else vk2char[entry->VirtualKey] = entry->wch[0];
         }
     }
 }
@@ -483,30 +499,44 @@ static WORD kbd_tables_wchar_to_vkey( const KBDTABLES *tables, WCHAR wch )
 {
     const VK_TO_WCHAR_TABLE *table;
     const VK_TO_WCHARS1 *entry;
-    WORD bits;
+    WORD bits, best = 0;
+    UINT best_mod = ~0u;
     BYTE mod;
 
     if (wch == '\x001b') return VK_ESCAPE;
 
+    /* Stained Glass OS: of the keys that type the character, the one needing the
+     * fewest modifiers (French '^' is its dead key, not AltGr+9); Caps Lock
+     * entries (SGCAPS) are no shift state of their own */
     for (table = tables->pVkToWcharTable; table->pVkToWchars; table++)
     {
         for (entry = table->pVkToWchars; entry->VirtualKey; entry = NEXT_ENTRY(table, entry))
         {
-            for (mod = 0; mod < table->nModifications; ++mod)
+            const VK_TO_WCHARS1 *dead = kbd_tables_dead_entry( table, entry );
+            if (entry->VirtualKey == 0xff) continue;
+            if (entry->Attributes & SGCAPS) continue;
+            for (mod = 0; mod < table->nModifications && mod < best_mod; ++mod)
             {
-                if (entry->wch[mod] == WCH_NONE || entry->wch[mod] != wch) continue;
+                WCHAR ch = entry->wch[mod];
+                if (ch == WCH_DEAD && dead) ch = dead->wch[mod];
+                if (ch == WCH_NONE || ch == WCH_DEAD || ch != wch) continue;
                 bits = kbd_tables_get_mod_bits( tables, mod );
-                return (bits << 8) | entry->VirtualKey;
+                best = (bits << 8) | entry->VirtualKey;
+                best_mod = mod;
+                break;
             }
         }
     }
+    if (best_mod != ~0u) return best;
 
     if (wch >= 0x0001 && wch <= 0x001a) return (0x200) | ('A' + wch - 1);  /* CTRL + A-Z */
     return wch >= 0x0080 ? -1 : 0;
 }
 
-static WCHAR kbd_tables_vkey_to_wchar( const KBDTABLES *tables, UINT vkey, const BYTE *state )
+static WCHAR kbd_tables_vkey_to_wchar( const KBDTABLES *tables, UINT vkey, const BYTE *state, BOOL *is_dead )
 {
+    const VK_TO_WCHARS1 *dead;
+    WCHAR ch;
     UINT mod, caps_mod, alt, ctrl, caps;
     const VK_TO_WCHAR_TABLE *table;
     const VK_TO_WCHARS1 *entry;
@@ -538,8 +568,16 @@ static WCHAR kbd_tables_vkey_to_wchar( const KBDTABLES *tables, UINT vkey, const
              * with the mapping when Caps Lock is off.
              */
             if ((entry->Attributes & SGCAPS) && !caps) entry = NEXT_ENTRY(table, entry);
-            if ((entry->Attributes & CAPLOK) && table->nModifications > caps_mod) return entry->wch[caps_mod];
-            return entry->wch[mod];
+            if ((entry->Attributes & CAPLOK) && table->nModifications > caps_mod) mod = caps_mod;
+            ch = entry->wch[mod];
+            if (ch == WCH_DEAD)
+            {
+                /* a dead key gives the character it stands for, and says so */
+                if (!(dead = kbd_tables_dead_entry( table, entry ))) return WCH_NONE;
+                if (is_dead) *is_dead = TRUE;
+                return dead->wch[mod];
+            }
+            return ch;
         }
     }
 
