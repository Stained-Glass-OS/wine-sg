+    { 0x0405, "cz" },     { 0x041b, "sk" },     { 0x040e, "hu" },     { 0x0424, "si" },
+    { 0x041a, "hr" },     { 0x0418, "ro" },     { 0x0402, "bg" },     { 0x0419, "ru" },
+    { 0x0422, "ua" },     { 0x0423, "by" },     { 0x0408, "gr" },     { 0x041f, "tr" },
+    { 0x040d, "il" },     { 0x0401, "ara" },    { 0x0429, "ir" },     { 0x0411, "jp" },
+    { 0x0412, "kr" },     { 0x0804, "cn" },     { 0x0404, "tw" },     { 0x041e, "th" },
