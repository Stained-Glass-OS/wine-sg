+/* the character a dead key stands for, as the Windows layouts give it */
+static WCHAR dead_char( xkb_keysym_t sym )
+{
+    switch (sym)
+    {
+    case XKB_KEY_dead_grave:        return 0x0060;
+    case XKB_KEY_dead_acute:        return 0x00b4;
+    case XKB_KEY_dead_circumflex:   return 0x005e;
+    case XKB_KEY_dead_tilde:        return 0x007e;
+    case XKB_KEY_dead_macron:       return 0x00af;
+    case XKB_KEY_dead_breve:        return 0x02d8;
+    case XKB_KEY_dead_abovedot:     return 0x02d9;
+    case XKB_KEY_dead_diaeresis:    return 0x00a8;
+    case XKB_KEY_dead_abovering:    return 0x00b0;
+    case XKB_KEY_dead_doubleacute:  return 0x02dd;
+    case XKB_KEY_dead_caron:        return 0x02c7;
+    case XKB_KEY_dead_cedilla:      return 0x00b8;
+    case XKB_KEY_dead_ogonek:       return 0x02db;
+    case XKB_KEY_dead_iota:         return 0x037a;
+    case XKB_KEY_dead_voiced_sound: return 0x309b;
+    case XKB_KEY_dead_semivoiced_sound: return 0x309c;
+    }
+    return 0;
+}
+
+#define NB_MODS 6  /* none, shift, ctrl, shift+ctrl, altgr (ctrl+alt), shift+altgr */
+
+typedef struct
+{
+    BYTE VirtualKey;
+    BYTE Attributes;
+    WCHAR wch[NB_MODS];
+} SG_VK_TO_WCHARS6;
+
+struct foreign_layout
+{
+    struct list entry;
+    LANGID lang;
+    BOOL valid;            /* FALSE: the layout could not be built, the X map answers */
+    KBDTABLES tables;
+    USHORT vsc2vk[0x80];
+    VK_TO_WCHAR_TABLE vk_to_wchar_table[2];
+    SG_VK_TO_WCHARS6 vk_to_wchars[0x100 * 3 + 1]; /* SGCAPS and dead-key entries take two */
+    VK_TO_BIT vk2bit[4];
+    union
+    {
+        MODIFIERS modifiers;
+        char modifiers_buf[offsetof(MODIFIERS, ModNumber[8])];
+    };
+};
+
+static const VSC_LPWSTR no_key_names[] = { {0} };
+
+static pthread_mutex_t foreign_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct list foreign_layouts = LIST_INIT( foreign_layouts );
+static struct xkb_context *xkb_context;
+static char x_layout[64], x_variant[64];
+static BOOL x_names_known;
+
+/* the X map's own layout, from the XKB rules names on the root window */
+static void read_x_layout_names(void)
+{
+    Display *display = thread_init_display();
+    Atom type, prop = XInternAtom( display, "_XKB_RULES_NAMES", True );
+    unsigned long count, remaining;
+    unsigned char *data = NULL;
+    const char *p, *end;
+    int format, i;
+
+    x_layout[0] = x_variant[0] = 0;
+    x_names_known = TRUE;
+    if (!prop) return;
+    if (XGetWindowProperty( display, DefaultRootWindow( display ), prop, 0, 1024, False,
+                            XA_STRING, &type, &format, &count, &remaining, &data ) != Success || !data)
+        return;
+    if (type == XA_STRING && format == 8)
+    {
+        /* rules, model, layout, variant, options; the first layout of a list */
+        for (p = (const char *)data, end = p + count, i = 0; p < end && i < 4; p += strlen( p ) + 1, i++)
+        {
+            char *dst = i == 2 ? x_layout : i == 3 ? x_variant : NULL;
+            size_t len;
+            if (!dst) continue;
+            len = strcspn( p, "," );
+            if (len >= 64) len = 63;
+            memcpy( dst, p, len );
+            dst[len] = 0;
+        }
+    }
+    XFree( data );
+    TRACE( "X keyboard map: layout %s variant %s\n", debugstr_a(x_layout), debugstr_a(x_variant) );
+}
+
+static WORD vkey_for_key( struct xkb_state *state, xkb_keycode_t keyc, BYTE scan, const USHORT *base )
+{
+    uint32_t ch;
+
+    xkb_state_update_mask( state, 0, 0, 0, 0, 0, 0 );
+    ch = xkb_state_key_get_utf32( state, keyc );
+    /* Windows names a key by the letter it types */
+    if (ch >= 'a' && ch <= 'z') return ch - 'a' + 'A';
+    if (ch >= 'A' && ch <= 'Z') return ch;
+    return base[scan];
+}
+
+static void add_chars( struct foreign_layout *layout, struct xkb_keymap *keymap, struct xkb_state *state,
+                       xkb_keycode_t keyc, WORD vkey, SG_VK_TO_WCHARS6 **out, BOOL numlock )
+{
+    xkb_mod_mask_t shift = 1 << xkb_keymap_mod_get_index( keymap, XKB_MOD_NAME_SHIFT );
+    xkb_mod_mask_t caps = 1 << xkb_keymap_mod_get_index( keymap, XKB_MOD_NAME_CAPS );
+    xkb_mod_mask_t num = 1 << xkb_keymap_mod_get_index( keymap, XKB_MOD_NAME_NUM );
+    xkb_mod_mask_t altgr = 1 << xkb_keymap_mod_get_index( keymap, "Mod5" );
+    SG_VK_TO_WCHARS6 plain = {.VirtualKey = vkey}, capsed = plain, dead = {.VirtualKey = 0xff};
+    BOOL found = FALSE, caps_differs = FALSE, has_dead = FALSE;
+    unsigned int mod;
+
+    for (mod = 0; mod < NB_MODS; mod++)
+    {
+        xkb_mod_mask_t mask = numlock ? num : 0;
+        xkb_keysym_t sym;
+        uint32_t ch, caps_ch;
+        WCHAR d;
+
+        plain.wch[mod] = capsed.wch[mod] = dead.wch[mod] = WCH_NONE;
+        if (mod == 2 || mod == 3) continue; /* Ctrl+key: win32u's own rules */
+        if (mod & 1) mask |= shift;
+        if (mod & 4) mask |= altgr;
+
+        xkb_state_update_mask( state, mask, 0, 0, 0, 0, 0 );
+        sym = xkb_state_key_get_one_sym( state, keyc );
+        ch = xkb_state_key_get_utf32( state, keyc );
+        if ((d = dead_char( sym )))
+        {
+            plain.wch[mod] = WCH_DEAD;
+            dead.wch[mod] = d;
+            has_dead = found = TRUE;
+            continue;
+        }
+        if (ch && ch < 0x10000 && ch != 0x7f) { plain.wch[mod] = ch; found = TRUE; }
+        /* a key with no AltGr level types its plain character with AltGr: none */
+        if ((mod & 4) && plain.wch[mod] == plain.wch[mod & 1]) plain.wch[mod] = WCH_NONE;
+
+        xkb_state_update_mask( state, mask, 0, caps, 0, 0, 0 );
+        caps_ch = xkb_state_key_get_utf32( state, keyc );
+        if (caps_ch && caps_ch < 0x10000 && caps_ch != ch && !((mod & 4) && plain.wch[mod] == WCH_NONE))
+        {
+            capsed.wch[mod] = caps_ch;
+            caps_differs = TRUE;
+        }
+    }
+    if (!found) return;
+
+    if (caps_differs)
+    {
+        /* Caps Lock behaves as Shift for letters (CAPLOK), otherwise the key
+         * needs its own Caps Lock entry (SGCAPS) */
+        if (capsed.wch[0] == plain.wch[1] && (capsed.wch[1] == plain.wch[0] || capsed.wch[1] == WCH_NONE)
+            && capsed.wch[4] == WCH_NONE && capsed.wch[5] == WCH_NONE)
+            plain.Attributes |= CAPLOK;
+        else if (!has_dead)
+        {
+            for (mod = 0; mod < NB_MODS; mod++) if (capsed.wch[mod] == WCH_NONE) capsed.wch[mod] = plain.wch[mod];
+            capsed.Attributes = SGCAPS;
+            *(*out)++ = capsed;
+        }
+    }
+    *(*out)++ = plain;
+    if (has_dead) *(*out)++ = dead;
+}
+
+static void build_layout( struct foreign_layout *layout, int name )
+{
+    struct xkb_rule_names names = {.rules = "evdev", .model = "pc105"};
+    const USHORT *base = scan2vk_us;
+    SG_VK_TO_WCHARS6 *out = layout->vk_to_wchars;
+    struct xkb_keymap *keymap;
+    struct xkb_state *state;
+    USHORT vk_fr[0x80], vk_de[0x80];
+    unsigned int i, mod;
+    BYTE scan;
+
+    names.layout = xkb_names[name].layout;
+    names.variant = xkb_names[name].variant;
+
+    if (!xkb_context && !(xkb_context = xkb_context_new( XKB_CONTEXT_NO_FLAGS ))) return;
+    if (!(keymap = xkb_keymap_new_from_names( xkb_context, &names, XKB_KEYMAP_COMPILE_NO_FLAGS )))
+    {
+        WARN( "no XKB layout %s(%s)\n", names.layout, debugstr_a(names.variant) );
+        return;
+    }
+    if (!(state = xkb_state_new( keymap )))
+    {
+        xkb_keymap_unref( keymap );
+        return;
+    }
+
+    memcpy( vk_fr, scan2vk_us, sizeof(vk_fr) );
+    memcpy( vk_de, scan2vk_us, sizeof(vk_de) );
+    for (i = 0; oem_fr[i].scan; i++) vk_fr[oem_fr[i].scan] = oem_fr[i].vk;
+    for (i = 0; oem_de[i].scan; i++) vk_de[oem_de[i].scan] = oem_de[i].vk;
+    if (!strcmp( names.layout, "fr" ) && !names.variant) base = vk_fr;
+    else if ((!strcmp( names.layout, "de" ) || !strcmp( names.layout, "at" )) && !names.variant) base = vk_de;
+
+    /* the main block and keypad: evdev key codes there are the scan codes */
+    for (scan = 0; scan < 0x59; scan++)
+        layout->vsc2vk[scan] = scan ? vkey_for_key( state, scan + 8, scan, base ) | (base[scan] & 0xff00) : 0;
+    for (; scan < 0x80; scan++) layout->vsc2vk[scan] = scan2vk_us[scan];
+#ifdef SG_MUTANT_KBD_US_VKEYS
+    memcpy( layout->vsc2vk, scan2vk_us, sizeof(layout->vsc2vk) );
+#endif
+
+    for (scan = 1; scan < 0x59; scan++)
+    {
+        WORD vkey = layout->vsc2vk[scan];
+        if (vkey & KBDNUMPAD) continue; /* numpad digits: kbdus, by win32u */
+        add_chars( layout, keymap, state, scan + 8, vkey & 0xff, &out, FALSE );
+    }
+    add_chars( layout, keymap, state, 0x53 + 8, VK_DECIMAL, &out, TRUE );
+    add_chars( layout, keymap, state, 98 /* KEY_KPSLASH */ + 8, VK_DIVIDE, &out, FALSE );
+    out->VirtualKey = 0;
+
+    xkb_state_unref( state );
+    xkb_keymap_unref( keymap );
+
+    layout->tables.pKeyNames = (VSC_LPWSTR *)no_key_names;
+    layout->tables.pKeyNamesExt = (VSC_LPWSTR *)no_key_names;
+    layout->tables.bMaxVSCtoVK = ARRAY_SIZE(layout->vsc2vk) - 1;
+    layout->tables.pusVSCtoVK = layout->vsc2vk;
+    layout->tables.pVSCtoVK_E0 = (VSC_VK *)scan2vk_e0;
+    layout->tables.pVSCtoVK_E1 = (VSC_VK *)scan2vk_e1;
+    layout->tables.pCharModifiers = &layout->modifiers;
+    layout->tables.pVkToWcharTable = layout->vk_to_wchar_table;
+    layout->tables.fLocaleFlags = MAKELONG( KLLF_ALTGR, KBD_VERSION );
+
+    layout->vk_to_wchar_table[0].pVkToWchars = (VK_TO_WCHARS1 *)layout->vk_to_wchars;
+    layout->vk_to_wchar_table[0].cbSize = sizeof(*layout->vk_to_wchars);
+    layout->vk_to_wchar_table[0].nModifications = NB_MODS;
+
+    layout->vk2bit[0].Vk = VK_SHIFT;
+    layout->vk2bit[0].ModBits = KBDSHIFT;
+    layout->vk2bit[1].Vk = VK_CONTROL;
+    layout->vk2bit[1].ModBits = KBDCTRL;
+    layout->vk2bit[2].Vk = VK_MENU;
+    layout->vk2bit[2].ModBits = KBDALT;
+    layout->modifiers.pVkToBit = layout->vk2bit;
+    layout->modifiers.wMaxModBits = 7;
+    /* as kbdus: Alt alone types the plain character; Ctrl+Alt is AltGr */
+    for (mod = 0; mod <= 7; mod++)
+    {
+        static const BYTE numbers[8] = {0, 1, 2, 3, 0, 1, 4, 5};
+        layout->modifiers.ModNumber[mod] = numbers[mod];
+    }
+    layout->valid = TRUE;
+}
