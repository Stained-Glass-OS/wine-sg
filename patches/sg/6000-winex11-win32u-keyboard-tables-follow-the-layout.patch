+/***********************************************************************
+ *		x11drv_foreign_kbd_tables
+ *
+ * The tables of HKL's layout when it is not the X map's, or NULL: the X map
+ * answers for that layout.
+ */
+const KBDTABLES *x11drv_foreign_kbd_tables( HKL hkl )
+{
+    struct foreign_layout *layout;
+    LANGID lang = HIWORD( (UINT_PTR)hkl );
+    LCID locale;
+    int name;
+
+    if (!hkl || (lang & 0xf000) == 0xf000) return NULL; /* layout ids: the X map */
+    NtQueryDefaultLocale( TRUE, &locale );
+    if (lang == LANGIDFROMLCID( locale )) return NULL; /* the session's own layout is the X map */
+    if ((name = find_xkb_name( lang )) < 0) return NULL;
+
+    pthread_mutex_lock( &foreign_mutex );
+    if (!x_names_known) read_x_layout_names();
+#ifndef SG_MUTANT_KBD_ALWAYS_X
+    if (x_layout[0] && !strcmp( x_layout, xkb_names[name].layout ) &&
+        !strcmp( x_variant, xkb_names[name].variant ? xkb_names[name].variant : "" ))
+#endif
+    {
+        pthread_mutex_unlock( &foreign_mutex );
+        return NULL;
+    }
+
+    LIST_FOR_EACH_ENTRY( layout, &foreign_layouts, struct foreign_layout, entry )
+        if (layout->lang == xkb_names[name].lang) goto done;
+
+    if ((layout = calloc( 1, sizeof(*layout) )))
+    {
+        layout->lang = xkb_names[name].lang;
+        build_layout( layout, name );
+        list_add_tail( &foreign_layouts, &layout->entry );
+        TRACE( "hkl %p: layout %s(%s) %s\n", hkl, xkb_names[name].layout,
+               debugstr_a(xkb_names[name].variant), layout->valid ? "built" : "unavailable" );
+    }
+done:
+    pthread_mutex_unlock( &foreign_mutex );
+    return layout && layout->valid ? &layout->tables : NULL;
+}
+
+/* the X map changed: its layout is read again */
+void x11drv_foreign_kbd_reset(void)
+{
+    pthread_mutex_lock( &foreign_mutex );
+    x_names_known = FALSE;
+    pthread_mutex_unlock( &foreign_mutex );
+}
