+    { 0x0c0c, "ca" },     { 0x100c, "ch", "fr" }, { 0x140c, "fr" },   { 0x0407, "de" },
+    { 0x0807, "ch" },     { 0x0c07, "at" },     { 0x1007, "de" },     { 0x1407, "de" },
