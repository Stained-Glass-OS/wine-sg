+
+#ifdef HAVE_XKBCOMMON_XKBCOMMON_H
+#include <xkbcommon/xkbcommon.h>
+#endif
+
+WINE_DEFAULT_DEBUG_CHANNEL(keyboard);
+
+#ifdef HAVE_XKBCOMMON_XKBCOMMON_H
+
