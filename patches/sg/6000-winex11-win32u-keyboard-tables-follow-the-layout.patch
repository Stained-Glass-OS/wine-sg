+static int find_xkb_name( LANGID lang )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(xkb_names); i++) if (xkb_names[i].lang == lang) return i;
+    for (i = 0; i < ARRAY_SIZE(xkb_names); i++)
+        if (PRIMARYLANGID(xkb_names[i].lang) == PRIMARYLANGID(lang)) return i;
+    return -1;
+}
