+static void add_task(ITaskScheduler *sched, const WCHAR *name)
+{
+    ITask *task;
+    HRESULT hr;
+
+    ITaskScheduler_Delete(sched, name);
+    hr = ITaskScheduler_NewWorkItem(sched, name, &CLSID_CTask, &IID_ITask, (IUnknown **)&task);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = ITaskScheduler_AddWorkItem(sched, name, (IScheduledWorkItem *)task);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ITask_Release(task);
+}
+
+static void test_clone(ITaskScheduler *sched)
+{
+    IEnumWorkItems *tasks, *clone, *clone2;
+    WCHAR **names, **names2;
+    ULONG fetched, fetched2, total = 0, n_clone = 0, i;
+    HRESULT hr;
+
+    hr = ITaskScheduler_Enum(sched, &tasks);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    hr = IEnumWorkItems_Clone(tasks, NULL);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+
+    /* clone before the enumeration started: independent, starts at the beginning */
+    hr = IEnumWorkItems_Clone(tasks, &clone);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IEnumWorkItems_Next(clone, 1, &names, &fetched);
+    ok(hr == S_OK && fetched == 1, "got %#lx %lu\n", hr, fetched);
+    CoTaskMemFree(names[0]);
+    CoTaskMemFree(names);
+
+    /* the original is unaffected by the clone's progress */
+    hr = IEnumWorkItems_Next(tasks, 1, &names, &fetched);
+    ok(hr == S_OK && fetched == 1, "got %#lx %lu\n", hr, fetched);
+    CoTaskMemFree(names[0]);
+    CoTaskMemFree(names);
+    IEnumWorkItems_Release(clone);
+
+    /* clone in the middle: both continue with the same names */
+    hr = IEnumWorkItems_Clone(tasks, &clone);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    for (;;)
+    {
+        hr = IEnumWorkItems_Next(tasks, 1, &names, &fetched);
+        if (hr != S_OK) break;
+        hr = IEnumWorkItems_Next(clone, 1, &names2, &fetched2);
+        ok(hr == S_OK && fetched2 == 1, "got %#lx\n", hr);
+        if (hr != S_OK) { CoTaskMemFree(names[0]); CoTaskMemFree(names); break; }
+        ok(!lstrcmpW(names[0], names2[0]), "%s != %s\n", wine_dbgstr_w(names[0]), wine_dbgstr_w(names2[0]));
+        CoTaskMemFree(names[0]); CoTaskMemFree(names);
+        CoTaskMemFree(names2[0]); CoTaskMemFree(names2);
+        total++;
+    }
+    ok(total >= 1, "got %lu\n", total);
+    hr = IEnumWorkItems_Next(clone, 1, &names2, &fetched2);
+    ok(hr == S_FALSE, "clone must end together with the original: %#lx\n", hr);
+
+    /* a clone of an exhausted enumeration is exhausted; Reset restarts a clone */
+    hr = IEnumWorkItems_Clone(tasks, &clone2);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IEnumWorkItems_Next(clone2, 1, &names2, &fetched2);
+    ok(hr == S_FALSE, "got %#lx\n", hr);
+    hr = IEnumWorkItems_Reset(clone2);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    for (;;)
+    {
+        hr = IEnumWorkItems_Next(clone2, 1, &names2, &fetched2);
+        if (hr != S_OK) break;
+        CoTaskMemFree(names2[0]); CoTaskMemFree(names2);
+        n_clone++;
+    }
+    ok(n_clone >= total, "got %lu vs %lu\n", n_clone, total);
+    (void)i;
+
+    IEnumWorkItems_Release(clone2);
+    IEnumWorkItems_Release(clone);
+    IEnumWorkItems_Release(tasks);
+}
+
+static void test_task(ITaskScheduler *sched)
+{
+    ITask *task;
+    IPersistFile *file;
+    DWORD flags;
+    WORD val = 0xbeef;
+    HRESULT hr;
+
+    hr = ITaskScheduler_NewWorkItem(sched, task_b, &CLSID_CTask, &IID_ITask, (IUnknown **)&task);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    hr = ITask_SetTaskFlags(task, 0);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    flags = 0xdeadbeef;
+    hr = ITask_GetTaskFlags(task, &flags);
+    ok(hr == S_OK && flags == 0, "got %#lx %#lx\n", hr, flags);
+
+    hr = ITask_SetTaskFlags(task, 0x10);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    flags = 0;
+    hr = ITask_GetTaskFlags(task, &flags);
+    ok(hr == S_OK && flags == 0x10, "got %#lx %#lx\n", hr, flags);
+
+    /* task flags are separate from the work item flags */
+    flags = 0xdeadbeef;
+    hr = ITask_GetFlags(task, &flags);
+    ok(hr == S_OK && flags == 0, "got %#lx %#lx\n", hr, flags);
+
+    hr = ITask_SetErrorRetryCount(task, 3);
+    ok(hr == E_NOTIMPL, "got %#lx\n", hr);
+    hr = ITask_SetErrorRetryInterval(task, 3);
+    ok(hr == E_NOTIMPL, "got %#lx\n", hr);
+    hr = ITask_GetErrorRetryCount(task, &val);
+    ok(hr == E_NOTIMPL, "got %#lx\n", hr);
+    hr = ITask_GetErrorRetryInterval(task, &val);
+    ok(hr == E_NOTIMPL, "got %#lx\n", hr);
+
+    hr = ITask_QueryInterface(task, &IID_IPersistFile, (void **)&file);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IPersistFile_SaveCompleted(file, NULL);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IPersistFile_Release(file);
+
+    ITask_Release(task);
+}
+
+struct edit_params { const WCHAR *title; BOOL accept; BOOL found; int triggers_listed; };
+
+static BOOL ends_with(const WCHAR *s, const WCHAR *suffix)
+{
+    int a = s ? lstrlenW(s) : 0, b = lstrlenW(suffix);
+    return a >= b && !lstrcmpiW(s + a - b, suffix);
+}
+
+static HWND find_sheet(const WCHAR *title)
+{
+    DWORD i;
+    for (i = 0; i < 200; i++)
+    {
+        HWND hwnd = FindWindowW(L"#32770", title);
+        if (hwnd && GetWindowThreadProcessId(hwnd, NULL) == GetCurrentThreadId()) return hwnd;
+        if (hwnd) return hwnd;
+        Sleep(50);
+    }
+    return NULL;
+}
+
+static HWND edit_control;
+static BOOL CALLBACK find_ctrl(HWND hwnd, LPARAM lp)
+{
+    if (GetDlgCtrlID(hwnd) == (int)lp) { edit_control = hwnd; return FALSE; }
+    return TRUE;
+}
+
+static HWND ctrl(HWND sheet, int id)
+{
+    edit_control = NULL;
+    EnumChildWindows(sheet, find_ctrl, id);
+    return edit_control;
+}
+
+static DWORD WINAPI edit_thread(void *arg)
+{
+    struct edit_params *p = arg;
+    HWND sheet = find_sheet(p->title), c;
+
+    p->found = sheet != NULL;
+    if (!sheet) return 0;
+    Sleep(200);
+
+    c = ctrl(sheet, 100);
+    ok(c != NULL, "no Run edit\n");
+    if (c)
+    {
+        WCHAR buf[64];
+        GetWindowTextW(c, buf, 64);
+        ok(ends_with(buf, L"calc.exe"), "got %s\n", wine_dbgstr_w(buf));
+        SetWindowTextW(c, L"notepad.exe");
+    }
+    c = ctrl(sheet, 103);
+    if (c) SetWindowTextW(c, L"edited comment");
+    c = ctrl(sheet, 105);
+    ok(c != NULL, "no Enabled box\n");
+    if (c) SendMessageW(c, BM_SETCHECK, BST_UNCHECKED, 0);
+
+    SendMessageW(sheet, PSM_SETCURSEL, 1, 0);
+    c = ctrl(sheet, 200);
+    ok(c != NULL, "no trigger list\n");
+    if (c) p->triggers_listed = SendMessageW(c, LB_GETCOUNT, 0, 0);
+
+    SendMessageW(sheet, PSM_SETCURSEL, 2, 0);
+    c = ctrl(sheet, 306);   /* hidden */
+    ok(c != NULL, "no hidden box\n");
+    if (c) SendMessageW(c, BM_SETCHECK, BST_CHECKED, 0);
+
+    SendMessageW(sheet, WM_COMMAND, p->accept ? IDOK : IDCANCEL, 0);
+    return 0;
+}
+
+static void test_edit(ITaskScheduler *sched)
+{
+    struct edit_params params = { L"sgcalls_e", TRUE };
+    ITask *task, *task2;
+    IPersistFile *file;
+    WORD idx;
+    ITaskTrigger *trigger;
+    TASK_TRIGGER tt;
+    HANDLE thread;
+    WCHAR *str;
+    DWORD flags;
+    HRESULT hr;
+
+    ITaskScheduler_Delete(sched, task_e);
+    hr = ITaskScheduler_NewWorkItem(sched, task_e, &CLSID_CTask, &IID_ITask, (IUnknown **)&task);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ITask_SetApplicationName(task, L"calc.exe");
+    ITask_SetComment(task, L"original");
+    hr = ITask_CreateTrigger(task, &idx, &trigger);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    memset(&tt, 0, sizeof(tt));
+    tt.cbTriggerSize = sizeof(tt);
+    tt.wBeginYear = 2020; tt.wBeginMonth = 1; tt.wBeginDay = 1;
+    tt.TriggerType = TASK_TIME_TRIGGER_DAILY;
+    tt.Type.Daily.DaysInterval = 1;
+    ITaskTrigger_SetTrigger(trigger, &tt);
+    ITaskTrigger_Release(trigger);
+    hr = ITaskScheduler_AddWorkItem(sched, task_e, (IScheduledWorkItem *)task);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    hr = ITask_EditWorkItem(task, NULL, 1);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+
+    /* cancel leaves the task untouched */
+    params.accept = FALSE;
+    thread = CreateThread(NULL, 0, edit_thread, &params, 0, NULL);
+    hr = ITask_EditWorkItem(task, NULL, 0);
+    WaitForSingleObject(thread, 5000);
+    CloseHandle(thread);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(params.found, "sheet window not found\n");
+    ok(params.triggers_listed == 1, "got %d\n", params.triggers_listed);
+    str = NULL;
+    ITask_GetApplicationName(task, &str);
+    ok(ends_with(str, L"calc.exe"), "got %s\n", wine_dbgstr_w(str));
+    CoTaskMemFree(str);
+    ITask_GetFlags(task, &flags);
+    ok(!(flags & TASK_FLAG_HIDDEN), "got %#lx\n", flags);
+
+    /* OK applies and saves */
+    params.accept = TRUE;
+    params.found = FALSE;
+    thread = CreateThread(NULL, 0, edit_thread, &params, 0, NULL);
+    hr = ITask_EditWorkItem(task, NULL, 0);
+    WaitForSingleObject(thread, 5000);
+    CloseHandle(thread);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    str = NULL;
+    ITask_GetApplicationName(task, &str);
+    ok(ends_with(str, L"notepad.exe"), "got %s\n", wine_dbgstr_w(str));
+    CoTaskMemFree(str);
+    str = NULL;
+    ITask_GetComment(task, &str);
+    ok(str && !lstrcmpW(str, L"edited comment"), "got %s\n", wine_dbgstr_w(str));
+    CoTaskMemFree(str);
+    ITask_GetFlags(task, &flags);
+    ok((flags & TASK_FLAG_HIDDEN) && (flags & TASK_FLAG_DISABLED), "got %#lx\n", flags);
+
+    hr = ITask_QueryInterface(task, &IID_IPersistFile, (void **)&file);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IPersistFile_Release(file);
+    ITask_Release(task);
+
+    hr = ITaskScheduler_Activate(sched, task_e, &IID_ITask, (IUnknown **)&task2);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (hr == S_OK)
+    {
+        str = NULL;
+        ITask_GetApplicationName(task2, &str);
+        ok(ends_with(str, L"notepad.exe"), "saved: got %s\n", wine_dbgstr_w(str));
+        CoTaskMemFree(str);
+        ITask_GetFlags(task2, &flags);
+        ok(flags & TASK_FLAG_DISABLED, "saved: got %#lx\n", flags);
+        ITask_Release(task2);
+    }
+    ITaskScheduler_Delete(sched, task_e);
+}
+
+START_TEST(sgcalls)
+{
+    ITaskScheduler *sched;
+    HRESULT hr;
+
+    CoInitialize(NULL);
+    hr = CoCreateInstance(&CLSID_CTaskScheduler, NULL, CLSCTX_INPROC_SERVER,
+            &IID_ITaskScheduler, (void **)&sched);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    add_task(sched, task_a);
+    add_task(sched, task_c);
+    add_task(sched, task_d);
+    test_clone(sched);
+    test_task(sched);
+    test_edit(sched);
+    ITaskScheduler_Delete(sched, task_a);
+    ITaskScheduler_Delete(sched, task_c);
+    ITaskScheduler_Delete(sched, task_d);
+    ITaskScheduler_Release(sched);
+    CoUninitialize();
+}
