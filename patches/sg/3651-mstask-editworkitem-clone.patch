+++ b/dlls/mstask/Makefile.in
@@ -1,8 +1,9 @@
 MODULE    = mstask.dll
-IMPORTS   = rpcrt4 ole32 oleaut32
+IMPORTS   = rpcrt4 ole32 oleaut32 user32
 
 SOURCES = \
 	atsvc.idl \
+	editor.c \
 	factory.c \
 	mstask_local.idl \
 	mstask_main.c \
