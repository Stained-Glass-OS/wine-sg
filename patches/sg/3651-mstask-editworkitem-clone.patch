+static HRESULT create_task_enum(IEnumWorkItems **ret);
+
 static HRESULT WINAPI EnumWorkItems_Clone(IEnumWorkItems *iface, IEnumWorkItems **cloned)
 {
     EnumWorkItemsImpl *This = impl_from_IEnumWorkItems(iface);
-    FIXME("(%p)->(%p): stub\n", This, cloned);
-    return E_NOTIMPL;
+    EnumWorkItemsImpl *copy;
+    IEnumWorkItems *new_enum;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, cloned);
+
+    if (!cloned) return E_INVALIDARG;
+    *cloned = NULL;
+
+    hr = create_task_enum(&new_enum);
+    if (FAILED(hr)) return hr;
+    copy = impl_from_IEnumWorkItems(new_enum);
+
+    if (This->handle != INVALID_HANDLE_VALUE)
+    {
+        WCHAR path[MAX_PATH];
+        WIN32_FIND_DATAW data;
+        ULONG i;
+
+        GetWindowsDirectoryW(path, MAX_PATH);
+        lstrcatW(path, L"\\Tasks\\*");
+        copy->handle = FindFirstFileW(path, &data);
+        if (copy->handle == INVALID_HANDLE_VALUE)
+        {
+            IEnumWorkItems_Release(new_enum);
+            return E_UNEXPECTED;
+        }
+        copy->pos = 1;
+#ifdef SG_MUTANT_MSTASK_CLONE
+        This = (void *)copy;
+#endif
+        for (i = 1; i < This->pos; i++)
+        {
+            if (!FindNextFileW(copy->handle, &data))
+            {
+                IEnumWorkItems_Release(new_enum);
+                return E_UNEXPECTED;
+            }
+            copy->pos++;
+        }
+    }
+
+    *cloned = new_enum;
+    return S_OK;
 }
 
 static const IEnumWorkItemsVtbl EnumWorkItemsVtbl = {
@@ -266,6 +314,7 @@ static HRESULT create_task_enum(IEnumWorkItems **ret)
     tasks->IEnumWorkItems_iface.lpVtbl = &EnumWorkItemsVtbl;
     tasks->ref = 1;
     tasks->handle = INVALID_HANDLE_VALUE;
+    tasks->pos = 0;
 
     *ret = &tasks->IEnumWorkItems_iface;
     InterlockedIncrement(&dll_ref);
