+
+#define ID_RUN        100
+#define ID_PARAMS     101
+#define ID_STARTIN    102
+#define ID_COMMENT    103
+#define ID_RUNAS      104
+#define ID_ENABLED    105
+#define ID_TRIGGERS   200
+#define ID_FLAG_BASE  300
+
+static const struct { DWORD flag; const WCHAR *text; } flag_checks[] =
+{
+    { TASK_FLAG_DELETE_WHEN_DONE,           L"Delete the task if it is not scheduled to run again" },
+    { TASK_FLAG_START_ONLY_IF_IDLE,         L"Only start the task if the computer is idle" },
+    { TASK_FLAG_KILL_ON_IDLE_END,           L"Stop the task if the computer ceases to be idle" },
+    { TASK_FLAG_DONT_START_IF_ON_BATTERIES, L"Don't start the task if the computer is running on batteries" },
+    { TASK_FLAG_KILL_IF_GOING_ON_BATTERIES, L"Stop the task if battery mode begins" },
+    { TASK_FLAG_RUN_ONLY_IF_DOCKED,         L"Only run the task if the computer is docked" },
+    { TASK_FLAG_HIDDEN,                     L"Hidden task" },
+    { TASK_FLAG_RUN_IF_CONNECTED_TO_INTERNET, L"Only run the task if connected to the Internet" },
+    { TASK_FLAG_RESTART_ON_IDLE_RESUME,     L"Restart the task when the computer becomes idle again" },
+    { TASK_FLAG_SYSTEM_REQUIRED,            L"Wake the computer to run this task" },
+    { TASK_FLAG_RUN_ONLY_IF_LOGGED_ON,      L"Only run the task if the user is logged on" },
+};
+
+/* in-memory dialog template builder */
+struct tmpl { WORD *buf; size_t len, cap; };
+
+static BOOL tmpl_put(struct tmpl *t, const void *data, size_t words)
+{
+    if (t->len + words > t->cap)
+    {
+        size_t cap = max(t->cap * 2, t->len + words + 256);
+        WORD *n = realloc(t->buf, cap * sizeof(WORD));
+        if (!n) return FALSE;
+        t->buf = n;
+        t->cap = cap;
+    }
+    memcpy(t->buf + t->len, data, words * sizeof(WORD));
+    t->len += words;
+    return TRUE;
+}
+
+static void tmpl_align(struct tmpl *t)
+{
+    static const WORD zero;
+    if (t->len & 1) tmpl_put(t, &zero, 1);
+}
+
+static void tmpl_str(struct tmpl *t, const WCHAR *s)
+{
+    tmpl_put(t, s, lstrlenW(s) + 1);
+}
+
+static void tmpl_begin(struct tmpl *t, WORD items)
+{
+    DLGTEMPLATE d = { WS_CHILD | WS_VISIBLE | DS_SETFONT | DS_CONTROL, 0, items, 0, 0, 240, 160 };
+    static const WORD no_menu_class[2] = { 0, 0 };
+    static const WORD fontsize = 8;
+
+    tmpl_put(t, &d, sizeof(d) / sizeof(WORD));
+    tmpl_put(t, no_menu_class, 2);
+    tmpl_str(t, L"");
+    tmpl_put(t, &fontsize, 1);
+    tmpl_str(t, L"MS Shell Dlg");
+}
+
+static void tmpl_item(struct tmpl *t, DWORD style, short x, short y, short cx, short cy, WORD id,
+        const WCHAR *cls, const WCHAR *text)
+{
+    DLGITEMTEMPLATE it = { style | WS_CHILD | WS_VISIBLE, 0, x, y, cx, cy, id };
+    static const WORD no_data;
+
+    tmpl_align(t);
+    tmpl_put(t, &it, sizeof(it) / sizeof(WORD));
+    tmpl_str(t, cls);
+    tmpl_str(t, text);
+    tmpl_put(t, &no_data, 1);
+}
+
+static void get_text(HWND hwnd, int id, WCHAR **out)
+{
+    int len = GetWindowTextLengthW(GetDlgItem(hwnd, id));
+    *out = malloc((len + 1) * sizeof(WCHAR));
+    if (*out) GetDlgItemTextW(hwnd, id, *out, len + 1);
+}
+
+static void set_from_task(HWND hwnd, int id, HRESULT (WINAPI *getter)(ITask *, WCHAR **), ITask *task)
+{
+    WCHAR *s = NULL;
+    if (getter(task, &s) == S_OK && s)
+    {
+        SetDlgItemTextW(hwnd, id, s);
+        CoTaskMemFree(s);
+    }
+}
+
+static HRESULT WINAPI get_app(ITask *t, WCHAR **s) { return ITask_GetApplicationName(t, s); }
+static HRESULT WINAPI get_params(ITask *t, WCHAR **s) { return ITask_GetParameters(t, s); }
+static HRESULT WINAPI get_dir(ITask *t, WCHAR **s) { return ITask_GetWorkingDirectory(t, s); }
+static HRESULT WINAPI get_comment(ITask *t, WCHAR **s) { return ITask_GetComment(t, s); }
+static HRESULT WINAPI get_account(ITask *t, WCHAR **s) { return ITask_GetAccountInformation(t, s); }
+
+static ITask *page_task(HWND hwnd)
+{
+    return (ITask *)GetWindowLongPtrW(hwnd, DWLP_USER);
+}
+
+static INT_PTR CALLBACK task_page_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        ITask *task = (ITask *)((PROPSHEETPAGEW *)lp)->lParam;
+        DWORD flags = 0;
+
+        SetWindowLongPtrW(hwnd, DWLP_USER, (LONG_PTR)task);
+        set_from_task(hwnd, ID_RUN, get_app, task);
+        set_from_task(hwnd, ID_PARAMS, get_params, task);
+        set_from_task(hwnd, ID_STARTIN, get_dir, task);
+        set_from_task(hwnd, ID_COMMENT, get_comment, task);
+        set_from_task(hwnd, ID_RUNAS, get_account, task);
+        ITask_GetFlags(task, &flags);
+        CheckDlgButton(hwnd, ID_ENABLED, (flags & TASK_FLAG_DISABLED) ? BST_UNCHECKED : BST_CHECKED);
+        return TRUE;
+    }
+    case WM_NOTIFY:
+        if (((NMHDR *)lp)->code == PSN_APPLY)
+        {
+            ITask *task = page_task(hwnd);
+            WCHAR *s;
+            DWORD flags = 0;
+
+            get_text(hwnd, ID_RUN, &s);
+            if (s) { ITask_SetApplicationName(task, s); free(s); }
+            get_text(hwnd, ID_PARAMS, &s);
+            if (s) { ITask_SetParameters(task, s); free(s); }
+            get_text(hwnd, ID_STARTIN, &s);
+            if (s) { ITask_SetWorkingDirectory(task, s); free(s); }
+            get_text(hwnd, ID_COMMENT, &s);
+            if (s) { ITask_SetComment(task, s); free(s); }
+            ITask_GetFlags(task, &flags);
+            if (IsDlgButtonChecked(hwnd, ID_ENABLED) == BST_CHECKED) flags &= ~TASK_FLAG_DISABLED;
+            else flags |= TASK_FLAG_DISABLED;
+            ITask_SetFlags(task, flags);
+            SetWindowLongPtrW(hwnd, DWLP_MSGRESULT, PSNRET_NOERROR);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+static INT_PTR CALLBACK schedule_page_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    if (msg == WM_INITDIALOG)
+    {
+        ITask *task = (ITask *)((PROPSHEETPAGEW *)lp)->lParam;
+        WORD count = 0, i;
+
+        SetWindowLongPtrW(hwnd, DWLP_USER, (LONG_PTR)task);
+        ITask_GetTriggerCount(task, &count);
+        for (i = 0; i < count; i++)
+        {
+            WCHAR *str = NULL;
+            if (ITask_GetTriggerString(task, i, &str) == S_OK && str)
+            {
+                SendDlgItemMessageW(hwnd, ID_TRIGGERS, LB_ADDSTRING, 0, (LPARAM)str);
+                CoTaskMemFree(str);
+            }
+        }
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static INT_PTR CALLBACK settings_page_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    unsigned int i;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        ITask *task = (ITask *)((PROPSHEETPAGEW *)lp)->lParam;
+        DWORD flags = 0;
+
+        SetWindowLongPtrW(hwnd, DWLP_USER, (LONG_PTR)task);
+        ITask_GetFlags(task, &flags);
+        for (i = 0; i < ARRAY_SIZE(flag_checks); i++)
+            CheckDlgButton(hwnd, ID_FLAG_BASE + i, (flags & flag_checks[i].flag) ? BST_CHECKED : BST_UNCHECKED);
+        return TRUE;
+    }
+    case WM_NOTIFY:
+        if (((NMHDR *)lp)->code == PSN_APPLY)
+        {
+            ITask *task = page_task(hwnd);
+            DWORD flags = 0;
+
+            ITask_GetFlags(task, &flags);
+            for (i = 0; i < ARRAY_SIZE(flag_checks); i++)
+            {
+                if (IsDlgButtonChecked(hwnd, ID_FLAG_BASE + i) == BST_CHECKED) flags |= flag_checks[i].flag;
+                else flags &= ~flag_checks[i].flag;
+            }
+#ifndef SG_MUTANT_MSTASK_NOFLAGS
+            ITask_SetFlags(task, flags);
+#endif
+            SetWindowLongPtrW(hwnd, DWLP_MSGRESULT, PSNRET_NOERROR);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+HRESULT task_edit_work_item(ITask *task, HWND parent, const WCHAR *title)
+{
+    struct tmpl tp = {0}, sp = {0}, gp = {0};
+    PROPSHEETPAGEW pages[3];
+    PROPSHEETHEADERW hdr;
+    HMODULE comctl;
+    INT_PTR (WINAPI *propsheet)(PROPSHEETHEADERW *);
+    INT_PTR res;
+    unsigned int i;
+    int len;
+    WCHAR caption[MAX_PATH];
+    HRESULT hr = E_OUTOFMEMORY;
+    static const struct { const WCHAR *label; WORD id; short y; } rows[] =
+    {
+        { L"Run:", ID_RUN, 12 }, { L"Parameters:", ID_PARAMS, 34 }, { L"Start in:", ID_STARTIN, 56 },
+        { L"Comments:", ID_COMMENT, 78 }, { L"Run as:", ID_RUNAS, 100 },
+    };
+
+    {
+        const WCHAR *p = wcsrchr(title, '\\');
+        if (p) title = p + 1;
+        len = lstrlenW(title);
+        if (len > 4 && !wcsicmp(title + len - 4, L".job")) len -= 4;
+        memcpy(caption, title, len * sizeof(WCHAR));
+        caption[len] = 0;
+    }
+
+    TRACE("(%p, %p, %s)\n", task, parent, debugstr_w(title));
+
+    comctl = LoadLibraryW(L"comctl32.dll");
+    propsheet = comctl ? (void *)GetProcAddress(comctl, "PropertySheetW") : NULL;
+    if (!propsheet) { if (comctl) FreeLibrary(comctl); return E_FAIL; }
+
+    tmpl_begin(&tp, 2 * ARRAY_SIZE(rows) + 1);
+    for (i = 0; i < ARRAY_SIZE(rows); i++)
+    {
+        tmpl_item(&tp, SS_LEFT, 8, rows[i].y, 40, 10, 0xffff, L"Static", rows[i].label);
+        tmpl_item(&tp, WS_BORDER | WS_TABSTOP | ES_AUTOHSCROLL | (rows[i].id == ID_RUNAS ? ES_READONLY : 0),
+                52, rows[i].y - 2, 170, 12, rows[i].id, L"Edit", L"");
+    }
+    tmpl_item(&tp, BS_AUTOCHECKBOX | WS_TABSTOP, 8, 126, 200, 10, ID_ENABLED, L"Button", L"Enabled (scheduled task runs at the specified time)");
+
+    tmpl_begin(&sp, 2);
+    tmpl_item(&sp, SS_LEFT, 8, 8, 200, 10, 0xffff, L"Static", L"Schedule:");
+    tmpl_item(&sp, WS_BORDER | WS_VSCROLL | LBS_NOTIFY, 8, 22, 220, 110, ID_TRIGGERS, L"ListBox", L"");
+
+    tmpl_begin(&gp, ARRAY_SIZE(flag_checks));
+    for (i = 0; i < ARRAY_SIZE(flag_checks); i++)
+        tmpl_item(&gp, BS_AUTOCHECKBOX | WS_TABSTOP, 8, 6 + i * 13, 225, 11, ID_FLAG_BASE + i, L"Button", flag_checks[i].text);
+
+    if (!tp.buf || !sp.buf || !gp.buf) goto done;
+
+    memset(pages, 0, sizeof(pages));
+    for (i = 0; i < 3; i++)
+    {
+        pages[i].dwSize = sizeof(pages[i]);
+        pages[i].dwFlags = PSP_DLGINDIRECT | PSP_USETITLE;
+        pages[i].lParam = (LPARAM)task;
+    }
+    pages[0].pResource = (DLGTEMPLATE *)tp.buf; pages[0].pfnDlgProc = task_page_proc; pages[0].pszTitle = L"Task";
+    pages[1].pResource = (DLGTEMPLATE *)sp.buf; pages[1].pfnDlgProc = schedule_page_proc; pages[1].pszTitle = L"Schedule";
+    pages[2].pResource = (DLGTEMPLATE *)gp.buf; pages[2].pfnDlgProc = settings_page_proc; pages[2].pszTitle = L"Settings";
+
+    memset(&hdr, 0, sizeof(hdr));
+    hdr.dwSize = sizeof(hdr);
+    hdr.dwFlags = PSH_PROPSHEETPAGE | PSH_NOAPPLYNOW | PSH_NOCONTEXTHELP;
+    hdr.hwndParent = parent;
+    hdr.hInstance = GetModuleHandleW(NULL);
+    hdr.pszCaption = caption;
+    hdr.nPages = 3;
+    hdr.ppsp = pages;
+
+    res = propsheet(&hdr);
+    if (res > 0)
+    {
+        IPersistFile *file;
+        hr = ITask_QueryInterface(task, &IID_IPersistFile, (void **)&file);
+        if (SUCCEEDED(hr))
+        {
+#ifndef SG_MUTANT_MSTASK_NOSAVE
+            hr = IPersistFile_Save(file, NULL, TRUE);
+#endif
+            IPersistFile_Release(file);
+        }
+    }
+    else
+        hr = res < 0 ? E_FAIL : S_OK;
+
+done:
+    free(tp.buf);
+    free(sp.buf);
+    free(gp.buf);
+    FreeLibrary(comctl);
+    return hr;
+}
