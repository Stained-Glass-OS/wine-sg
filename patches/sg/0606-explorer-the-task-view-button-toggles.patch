From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the Task View button toggles

David: the Task View button reopened Task View on every click. The click
first takes the foreground from Task View, which closes it, and then the
button opened it again. A toggle within 400 ms of such a close is that same
click: it stays closed. Win+Tab is unchanged.
---
--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -936,6 +936,11 @@
  * Task View was left pointing at a window already gone -- the next Task View
  * button press "closed" that and nothing opened (after adding a desktop in
  * Task View, then switching with Win+Ctrl+Right). */
+/* when Task View last closed by losing the foreground: a click on the
+ * taskbar's Task View button does that first, and the click itself must then
+ * not open it again -- it is the button's second click, "close" (David) */
+static DWORD tv_closed_at;
+
 static void tv_close(void)
 {
     HWND hwnd = taskview;
@@ -1160,7 +1165,11 @@
         break;
 
     case WM_ACTIVATE:
-        if (LOWORD(wp) == WA_INACTIVE && !GetCapture() && hwnd == taskview) tv_close();
+        if (LOWORD(wp) == WA_INACTIVE && !GetCapture() && hwnd == taskview)
+        {
+            tv_closed_at = GetTickCount();
+            tv_close();
+        }
         return 0;
 
     case WM_DESTROY:
@@ -1182,6 +1191,7 @@
 
     if (taskview && !IsWindow( taskview )) taskview = 0;
     if (taskview) { if (toggle) tv_close(); return; }
+    if (toggle && tv_closed_at && GetTickCount() - tv_closed_at < 400) { tv_closed_at = 0; return; }
     EnumWindows( refresh_thumb_proc, 0 );
     SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
     taskview = CreateWindowExW( WS_EX_TOPMOST | WS_EX_TOOLWINDOW, L"SgTaskView", L"Task View", WS_POPUP,
