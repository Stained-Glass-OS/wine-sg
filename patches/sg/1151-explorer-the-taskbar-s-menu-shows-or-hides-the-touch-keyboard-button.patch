From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the taskbar's menu shows or hides the touch keyboard button

A computer without a keyboard (a Surface without its Type Cover) needs a
way to bring the touch keyboard up, and Windows 10's is a button beside
the clock that the taskbar's menu turns on or off ("Show touch keyboard
button"). The bar's menu had no such item.

It has now: checked as Windows' TipbandDesiredVisibility (HKCU\Software\
Microsoft\TabletTip\1.7) says, which when not set is on for a computer
with a touch screen or pen (GetSystemMetrics SM_DIGITIZER, 1150) and off
otherwise. Choosing it writes the value and says so (WM_SETTINGCHANGE
"TraySettings"); sg-shell's touch keyboard (sg-touchkbd, TabTip.exe)
adds or removes its button in the notification area at once, and turned
on, it is started when it is not running (TabTip.exe /background, through
App Paths).

Test: test/keybutton-gate.sh with test/keybutton-probe.c (mutant
SG_MUTANT_NO_KEYBOARD_BUTTON in explorer systray.c).
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -3809,7 +3809,20 @@
  * settings. It writes what Settings > Personalization > Taskbar writes, and
  * the bar follows the same way (WM_SETTINGCHANGE "TraySettings"). */
 enum { SG_MENU_SEARCH_OFF = 1, SG_MENU_SEARCH_ICON, SG_MENU_SEARCH_BOX, SG_MENU_TASKVIEW, SG_MENU_DESKTOP,
-       SG_MENU_TASKMGR, SG_MENU_LOCK, SG_MENU_SETTINGS };
+       SG_MENU_TASKMGR, SG_MENU_LOCK, SG_MENU_SETTINGS, SG_MENU_KEYBOARD };
+
+/* Stained Glass OS: the touch keyboard's button (sg-shell's sg-touchkbd puts
+ * it in the notification area): Windows' TipbandDesiredVisibility, not set,
+ * on for a computer with a touch screen or pen -- a computer without a
+ * keyboard needs it to bring the keyboard up */
+static const WCHAR sg_tip_key[] = L"Software\\Microsoft\\TabletTip\\1.7";
+
+static BOOL sg_keyboard_button(void)
+{
+    BOOL touch = (GetSystemMetrics( SM_DIGITIZER ) & (NID_INTEGRATED_TOUCH | NID_EXTERNAL_TOUCH |
+                                                      NID_INTEGRATED_PEN | NID_EXTERNAL_PEN)) != 0;
+    return sg_reg_dword( sg_tip_key, L"TipbandDesiredVisibility", touch ) != 0;
+}
 
 static void sg_set_dword( const WCHAR *key, const WCHAR *name, DWORD value )
 {
@@ -3832,6 +3845,10 @@
     AppendMenuW( search, MF_STRING | (sg_bar.search == 2 ? MF_CHECKED : 0), SG_MENU_SEARCH_BOX, L"Show search &box" );
     AppendMenuW( menu, MF_POPUP, (UINT_PTR)search, L"S&earch" );
     AppendMenuW( menu, MF_STRING | (sg_bar.taskview ? MF_CHECKED : 0), SG_MENU_TASKVIEW, L"Show Task &View button" );
+#ifndef SG_MUTANT_NO_KEYBOARD_BUTTON
+    AppendMenuW( menu, MF_STRING | (sg_keyboard_button() ? MF_CHECKED : 0), SG_MENU_KEYBOARD,
+                 L"Show touch ke&yboard button" );
+#endif
     AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
     AppendMenuW( menu, MF_STRING, SG_MENU_DESKTOP, L"Show the &desktop" );
     AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
@@ -3854,6 +3871,17 @@
         sg_set_dword( search_key, L"SearchboxTaskbarMode", cmd - SG_MENU_SEARCH_OFF );
         break;
     case SG_MENU_TASKVIEW: sg_set_dword( sg_advanced_key, L"ShowTaskViewButton", !sg_bar.taskview ); break;
+    case SG_MENU_KEYBOARD:
+    {
+        BOOL on = !sg_keyboard_button();
+        /* the keyboard's own program adds or removes its button
+         * ("TraySettings"); turned on, it is started if it is not running
+         * (TabTip.exe, App Paths: sg-touchkbd) */
+        sg_set_dword( sg_tip_key, L"TipbandDesiredVisibility", on );
+        if (on && !FindWindowW( L"IPTip_Main_Window", NULL ))
+            ShellExecuteW( NULL, NULL, L"TabTip.exe", L"/background", NULL, SW_SHOWNOACTIVATE );
+        break;
+    }
     case SG_MENU_DESKTOP: shell_show_desktop(); break;
     case SG_MENU_TASKMGR: ShellExecuteW( NULL, NULL, L"taskmgr.exe", NULL, NULL, SW_SHOWNORMAL ); break;
     case SG_MENU_LOCK: sg_set_dword( sg_advanced_key, L"TaskbarSizeMove", locked ); break;
