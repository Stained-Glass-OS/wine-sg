+static HRESULT read_other_action_child(IXmlReader *reader, const WCHAR *name, void *ctx)
+{
+    struct other_action_ctx *c = ctx;
+    WCHAR *value;
+    HRESULT hr;
+
+    if (c->type == TASK_ACTION_SEND_EMAIL)
+    {
+        IEmailAction *mail = (IEmailAction *)c->action;
+
+        if (!wcscmp(name, L"HeaderFields"))
+        {
+            ITaskNamedValueCollection *fields;
+
+            if (FAILED(hr = IEmailAction_get_HeaderFields(mail, &fields))) return hr;
+            ITaskNamedValueCollection_Clear(fields);
+            hr = read_action_children(reader, read_header_fields_child, fields);
+            ITaskNamedValueCollection_Release(fields);
+            return hr;
+        }
+        if (!wcscmp(name, L"Attachments"))
+        {
+            SAFEARRAY *files = NULL;
+
+            if (SUCCEEDED(hr = read_action_children(reader, read_attachments_child, &files)))
+                hr = IEmailAction_put_Attachments(mail, files);
+            SafeArrayDestroy(files);
+            return hr;
+        }
+    }
+    if (IXmlReader_IsEmptyElement(reader)) value = (WCHAR *)L"";
+    else if (FAILED(hr = read_text_value(reader, &value))) return hr;
+
+    switch (c->type)
+    {
+    case TASK_ACTION_COM_HANDLER:
+        if (!wcscmp(name, L"ClassId")) IComHandlerAction_put_ClassId((IComHandlerAction *)c->action, value);
+        else if (!wcscmp(name, L"Data")) IComHandlerAction_put_Data((IComHandlerAction *)c->action, value);
+        break;
+    case TASK_ACTION_SHOW_MESSAGE:
+        if (!wcscmp(name, L"Title")) IShowMessageAction_put_Title((IShowMessageAction *)c->action, value);
+        else if (!wcscmp(name, L"Body")) IShowMessageAction_put_MessageBody((IShowMessageAction *)c->action, value);
+        break;
+    case TASK_ACTION_SEND_EMAIL:
+    {
+        IEmailAction *mail = (IEmailAction *)c->action;
+
+        if (!wcscmp(name, L"Server")) IEmailAction_put_Server(mail, value);
+        else if (!wcscmp(name, L"Subject")) IEmailAction_put_Subject(mail, value);
+        else if (!wcscmp(name, L"To")) IEmailAction_put_To(mail, value);
+        else if (!wcscmp(name, L"Cc")) IEmailAction_put_Cc(mail, value);
+        else if (!wcscmp(name, L"Bcc")) IEmailAction_put_Bcc(mail, value);
+        else if (!wcscmp(name, L"ReplyTo")) IEmailAction_put_ReplyTo(mail, value);
+        else if (!wcscmp(name, L"From")) IEmailAction_put_From(mail, value);
+        else if (!wcscmp(name, L"Body")) IEmailAction_put_Body(mail, value);
+        break;
+    }
+    default:
+        break;
+    }
+    return S_OK;
+}
+
+static HRESULT read_other_action(IXmlReader *reader, IActionCollection *actions, TASK_ACTION_TYPE type)
+{
+    struct other_action_ctx ctx;
+    const WCHAR *name, *value;
+    IAction *action;
+    HRESULT hr;
+
+    if (FAILED(hr = IActionCollection_Create(actions, type, &action))) return hr;
+    for (hr = IXmlReader_MoveToFirstAttribute(reader); hr == S_OK; hr = IXmlReader_MoveToNextAttribute(reader))
+    {
+        if (FAILED(IXmlReader_GetLocalName(reader, &name, NULL)) || FAILED(IXmlReader_GetValue(reader, &value, NULL)))
+            break;
+        if (!lstrcmpW(name, L"id")) IAction_put_Id(action, (BSTR)value);
+    }
+    IXmlReader_MoveToElement(reader);
+    ctx.action = action;
+    ctx.type = type;
+    hr = read_action_children(reader, read_other_action_child, &ctx);
+    IAction_Release(action);
+    return hr;
+}
