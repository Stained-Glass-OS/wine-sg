+/* reads to the end of the element the reader is on */
+static HRESULT skip_action_element(IXmlReader *reader)
+{
+    XmlNodeType type;
+    UINT depth, d;
+
+    if (IXmlReader_IsEmptyElement(reader)) return S_OK;
+    IXmlReader_GetDepth(reader, &depth);
+    while (IXmlReader_Read(reader, &type) == S_OK)
+    {
+        if (type != XmlNodeType_EndElement) continue;
+        IXmlReader_GetDepth(reader, &d);
+        if (d <= depth + 1) return S_OK;
+    }
+    return SCHED_E_MALFORMEDXML;
+}
+
+/* the children of the element the reader is on, to fn; fn must leave the
+ * reader at the end of the child it was called for */
+static HRESULT read_action_children(IXmlReader *reader, HRESULT (*fn)(IXmlReader *, const WCHAR *, void *), void *ctx)
+{
+    const WCHAR *name;
+    XmlNodeType type;
+    UINT depth, d;
+    HRESULT hr;
+
+    if (IXmlReader_IsEmptyElement(reader)) return S_OK;
+    IXmlReader_GetDepth(reader, &depth);
+    while (IXmlReader_Read(reader, &type) == S_OK)
+    {
+        if (type == XmlNodeType_EndElement)
+        {
+            IXmlReader_GetDepth(reader, &d);
+            if (d <= depth + 1) return S_OK;
+            continue;
+        }
+        if (type != XmlNodeType_Element) continue;
+        if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL))) return hr;
+        if (FAILED(hr = fn(reader, name, ctx))) return hr;
+    }
+    return SCHED_E_MALFORMEDXML;
+}
