+/* The other kinds of action: a few string properties each. One object, and
+ * the vtable it has says which interface it is. */
+enum simple_prop
+{
+    PROP_CLASS_ID, PROP_DATA,                                  /* COM handler */
+    PROP_SERVER, PROP_SUBJECT, PROP_TO, PROP_CC, PROP_BCC, PROP_REPLY_TO, PROP_FROM, PROP_BODY,   /* e-mail */
+    PROP_TITLE, PROP_MESSAGE_BODY,                             /* message */
+    PROP_COUNT
+};
+
+typedef struct
+{
+    IAction IAction_iface;
+    LONG ref;
+    TASK_ACTION_TYPE type;
+    WCHAR *id;
+    WCHAR *props[PROP_COUNT];
+    ITaskNamedValueCollection *headers;   /* e-mail */
+    SAFEARRAY *attachments;               /* e-mail: a vector of VT_VARIANT holding strings */
+} SimpleAction;
+
+static inline SimpleAction *impl_from_simple(void *iface)
+{
+    return CONTAINING_RECORD(iface, SimpleAction, IAction_iface);
+}
+
+static HRESULT simple_get(void *iface, enum simple_prop prop, BSTR *value)
+{
+    SimpleAction *action = impl_from_simple(iface);
+
+    if (!value) return E_POINTER;
+    if (!action->props[prop]) *value = NULL;
+    else if (!(*value = SysAllocString(action->props[prop]))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT simple_put(void *iface, enum simple_prop prop, BSTR value)
+{
+    SimpleAction *action = impl_from_simple(iface);
+    WCHAR *str = NULL;
+
+    if (value && !(str = wcsdup(value))) return E_OUTOFMEMORY;
+    free(action->props[prop]);
+    action->props[prop] = str;
+    return S_OK;
+}
+
+static ULONG WINAPI SimpleAction_AddRef(IAction *iface)
+{
+    return InterlockedIncrement(&impl_from_simple(iface)->ref);
+}
+
+static ULONG WINAPI SimpleAction_Release(IAction *iface)
+{
+    SimpleAction *action = impl_from_simple(iface);
+    LONG ref = InterlockedDecrement(&action->ref);
+    unsigned int i;
+
+    if (!ref)
+    {
+        TRACE("destroying %p\n", iface);
+        for (i = 0; i < PROP_COUNT; i++) free(action->props[i]);
+        free(action->id);
+        if (action->headers) ITaskNamedValueCollection_Release(action->headers);
+        SafeArrayDestroy(action->attachments);
+        free(action);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI SimpleAction_get_Id(IAction *iface, BSTR *id)
+{
+    SimpleAction *action = impl_from_simple(iface);
+
+    if (!id) return E_POINTER;
+    if (!action->id) *id = NULL;
+    else if (!(*id = SysAllocString(action->id))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT WINAPI SimpleAction_put_Id(IAction *iface, BSTR id)
+{
+    SimpleAction *action = impl_from_simple(iface);
+    WCHAR *str = NULL;
+
+    if (id && !(str = wcsdup(id))) return E_OUTOFMEMORY;
+    free(action->id);
+    action->id = str;
+    return S_OK;
+}
+
+static HRESULT WINAPI SimpleAction_get_Type(IAction *iface, TASK_ACTION_TYPE *type)
+{
+    if (!type) return E_POINTER;
+    *type = impl_from_simple(iface)->type;
+    return S_OK;
+}
+
+#define SIMPLE_ACTION(T) \
+static ULONG WINAPI impl_##T##_AddRef(T *iface) { return SimpleAction_AddRef((IAction *)iface); } \
+static ULONG WINAPI impl_##T##_Release(T *iface) { return SimpleAction_Release((IAction *)iface); } \
+static HRESULT WINAPI impl_##T##_QueryInterface(T *iface, REFIID riid, void **obj) \
+{ \
+    if (!riid || !obj) return E_INVALIDARG; \
+    if (IsEqualGUID(riid, &IID_##T) || IsEqualGUID(riid, &IID_IAction) || IsEqualGUID(riid, &IID_IDispatch) || \
+        IsEqualGUID(riid, &IID_IUnknown)) \
+    { \
+        impl_##T##_AddRef(iface); \
+        *obj = iface; \
+        return S_OK; \
+    } \
+    WARN("interface %s is not implemented\n", debugstr_guid(riid)); \
+    *obj = NULL; \
+    return E_NOINTERFACE; \
+} \
+static HRESULT WINAPI impl_##T##_GetTypeInfoCount(T *iface, UINT *count) { *count = 1; return S_OK; } \
+static HRESULT WINAPI impl_##T##_GetTypeInfo(T *iface, UINT index, LCID lcid, ITypeInfo **info) \
+{ return index ? DISP_E_BADINDEX : get_typeinfo(&IID_##T, info); } \
+static HRESULT WINAPI impl_##T##_GetIDsOfNames(T *iface, REFIID riid, LPOLESTR *names, UINT count, LCID lcid, DISPID *dispid) \
+{ return dispatch_get_ids(&IID_##T, names, count, dispid); } \
+static HRESULT WINAPI impl_##T##_Invoke(T *iface, DISPID dispid, REFIID riid, LCID lcid, WORD flags, DISPPARAMS *params, \
+                                 VARIANT *result, EXCEPINFO *excepinfo, UINT *argerr) \
+{ return dispatch_invoke((IDispatch *)iface, &IID_##T, dispid, flags, params, result, excepinfo, argerr); } \
+static HRESULT WINAPI impl_##T##_get_Id(T *iface, BSTR *id) { return SimpleAction_get_Id((IAction *)iface, id); } \
+static HRESULT WINAPI impl_##T##_put_Id(T *iface, BSTR id) { return SimpleAction_put_Id((IAction *)iface, id); } \
+static HRESULT WINAPI impl_##T##_get_Type(T *iface, TASK_ACTION_TYPE *type) \
+{ return SimpleAction_get_Type((IAction *)iface, type); }
+
+#define SIMPLE_VTBL_COMMON(T) \
+    impl_##T##_QueryInterface, impl_##T##_AddRef, impl_##T##_Release, impl_##T##_GetTypeInfoCount, impl_##T##_GetTypeInfo, impl_##T##_GetIDsOfNames, \
+    impl_##T##_Invoke, impl_##T##_get_Id, impl_##T##_put_Id, impl_##T##_get_Type
+
+#define SIMPLE_PROP(T, name, prop) \
+static HRESULT WINAPI impl_##T##_get_##name(T *iface, BSTR *v) { return simple_get(iface, prop, v); } \
+static HRESULT WINAPI impl_##T##_put_##name(T *iface, BSTR v) { return simple_put(iface, prop, v); }
+
+SIMPLE_ACTION(IComHandlerAction)
+SIMPLE_PROP(IComHandlerAction, ClassId, PROP_CLASS_ID)
+SIMPLE_PROP(IComHandlerAction, Data, PROP_DATA)
+static const IComHandlerActionVtbl com_handler_vtbl =
+{
+    SIMPLE_VTBL_COMMON(IComHandlerAction),
+    impl_IComHandlerAction_get_ClassId, impl_IComHandlerAction_put_ClassId,
+    impl_IComHandlerAction_get_Data, impl_IComHandlerAction_put_Data
+};
+
+SIMPLE_ACTION(IShowMessageAction)
+SIMPLE_PROP(IShowMessageAction, Title, PROP_TITLE)
+SIMPLE_PROP(IShowMessageAction, MessageBody, PROP_MESSAGE_BODY)
+static const IShowMessageActionVtbl show_message_vtbl =
+{
+    SIMPLE_VTBL_COMMON(IShowMessageAction),
+    impl_IShowMessageAction_get_Title, impl_IShowMessageAction_put_Title,
+    impl_IShowMessageAction_get_MessageBody, impl_IShowMessageAction_put_MessageBody
+};
+
+SIMPLE_ACTION(IEmailAction)
+SIMPLE_PROP(IEmailAction, Server, PROP_SERVER)
+SIMPLE_PROP(IEmailAction, Subject, PROP_SUBJECT)
+SIMPLE_PROP(IEmailAction, To, PROP_TO)
+SIMPLE_PROP(IEmailAction, Cc, PROP_CC)
+SIMPLE_PROP(IEmailAction, Bcc, PROP_BCC)
+SIMPLE_PROP(IEmailAction, ReplyTo, PROP_REPLY_TO)
+SIMPLE_PROP(IEmailAction, From, PROP_FROM)
+SIMPLE_PROP(IEmailAction, Body, PROP_BODY)
+
+static HRESULT WINAPI impl_IEmailAction_get_HeaderFields(IEmailAction *iface, ITaskNamedValueCollection **fields)
+{
+    SimpleAction *action = impl_from_simple(iface);
+    HRESULT hr;
+
+    if (!fields) return E_POINTER;
+    if (!action->headers && FAILED(hr = NamedValues_create(&action->headers))) return hr;
+    ITaskNamedValueCollection_AddRef(*fields = action->headers);
+    return S_OK;
+}
+
+static HRESULT WINAPI impl_IEmailAction_put_HeaderFields(IEmailAction *iface, ITaskNamedValueCollection *fields)
+{
+    SimpleAction *action = impl_from_simple(iface);
+    ITaskNamedValueCollection *copy;
+    HRESULT hr;
+
+    if (!fields) return E_POINTER;
+    if (fields == action->headers) return S_OK;
+    if (FAILED(hr = NamedValues_copy(fields, &copy))) return hr;
+    if (action->headers) ITaskNamedValueCollection_Release(action->headers);
+    action->headers = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI impl_IEmailAction_get_Attachments(IEmailAction *iface, SAFEARRAY **attachments)
+{
+    SimpleAction *action = impl_from_simple(iface);
+
+    if (!attachments) return E_POINTER;
+    *attachments = NULL;
+    if (!action->attachments) return S_OK;
+    return SafeArrayCopy(action->attachments, attachments);
+}
+
+static HRESULT WINAPI impl_IEmailAction_put_Attachments(IEmailAction *iface, SAFEARRAY *attachments)
+{
+    SimpleAction *action = impl_from_simple(iface);
+    SAFEARRAY *copy = NULL;
+    HRESULT hr;
+
+    if (attachments)
+    {
+        VARTYPE vt;
+
+        if (SafeArrayGetDim(attachments) != 1 || FAILED(SafeArrayGetVartype(attachments, &vt)) || vt != VT_VARIANT)
+            return E_INVALIDARG;
+        if (FAILED(hr = SafeArrayCopy(attachments, &copy))) return hr;
+    }
+    SafeArrayDestroy(action->attachments);
+    action->attachments = copy;
+    return S_OK;
+}
+
+static const IEmailActionVtbl email_vtbl =
+{
+    SIMPLE_VTBL_COMMON(IEmailAction),
+    impl_IEmailAction_get_Server, impl_IEmailAction_put_Server,
+    impl_IEmailAction_get_Subject, impl_IEmailAction_put_Subject,
+    impl_IEmailAction_get_To, impl_IEmailAction_put_To,
+    impl_IEmailAction_get_Cc, impl_IEmailAction_put_Cc,
+    impl_IEmailAction_get_Bcc, impl_IEmailAction_put_Bcc,
+    impl_IEmailAction_get_ReplyTo, impl_IEmailAction_put_ReplyTo,
+    impl_IEmailAction_get_From, impl_IEmailAction_put_From,
+    impl_IEmailAction_get_HeaderFields, impl_IEmailAction_put_HeaderFields,
+    impl_IEmailAction_get_Body, impl_IEmailAction_put_Body,
+    impl_IEmailAction_get_Attachments, impl_IEmailAction_put_Attachments
+};
+
+static HRESULT SimpleAction_create(TASK_ACTION_TYPE type, IAction **obj)
+{
+    SimpleAction *action;
+    const void *vtbl;
+
+    switch (type)
+    {
+    case TASK_ACTION_COM_HANDLER: vtbl = &com_handler_vtbl; break;
+    case TASK_ACTION_SEND_EMAIL: vtbl = &email_vtbl; break;
+    case TASK_ACTION_SHOW_MESSAGE: vtbl = &show_message_vtbl; break;
+    default: return E_NOTIMPL;
+    }
+    if (!(action = calloc(1, sizeof(*action)))) return E_OUTOFMEMORY;
+    action->IAction_iface.lpVtbl = vtbl;
+    action->ref = 1;
+    action->type = type;
+    *obj = &action->IAction_iface;
+    return S_OK;
+}
+
+/* ours, or NULL for an action made elsewhere */
+static SimpleAction *unsafe_simple_action(IAction *iface)
+{
+    const void *vtbl = iface ? iface->lpVtbl : NULL;
+
+    if (vtbl == &com_handler_vtbl || vtbl == &email_vtbl || vtbl == &show_message_vtbl)
+        return impl_from_simple(iface);
+    return NULL;
+}
+
+/* the contents of one of our actions, into a new one of the same kind */
+static HRESULT SimpleAction_copy_into(SimpleAction *from, SimpleAction *to)
+{
+    unsigned int i;
+    HRESULT hr;
+
+    for (i = 0; i < PROP_COUNT; i++)
+    {
+        WCHAR *copy = from->props[i] ? wcsdup(from->props[i]) : NULL;
+
+        if (from->props[i] && !copy) return E_OUTOFMEMORY;
+        free(to->props[i]);
+        to->props[i] = copy;
+    }
+    if (from->id)
+    {
+        WCHAR *copy = wcsdup(from->id);
+
+        if (!copy) return E_OUTOFMEMORY;
+        free(to->id);
+        to->id = copy;
+    }
+    if (from->headers)
+    {
+        ITaskNamedValueCollection *copy;
+
+        if (FAILED(hr = NamedValues_copy(from->headers, &copy))) return hr;
+        if (to->headers) ITaskNamedValueCollection_Release(to->headers);
+        to->headers = copy;
+    }
+    if (from->attachments)
+    {
+        SAFEARRAY *copy;
+
+        if (FAILED(hr = SafeArrayCopy(from->attachments, &copy))) return hr;
+        SafeArrayDestroy(to->attachments);
+        to->attachments = copy;
+    }
+    return S_OK;
+}
