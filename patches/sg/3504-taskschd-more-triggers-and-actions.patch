+
+static HRESULT read_days_of_month_child(IXmlReader *reader, const WCHAR *name, struct trigger *trigger)
+{
+    WCHAR *value;
+    HRESULT hr;
+
+    if (FAILED(hr = read_text(reader, &value))) return hr;
+    if (!wcscmp(name, L"Day"))
+    {
+        if (!wcscmp(value, L"Last")) trigger->run_on_last = TRUE;
+        else
+        {
+            int day = wcstol(value, NULL, 10);
+            if (day >= 1 && day <= 31) trigger->days_of_month |= 1 << (day - 1);
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT read_weeks_child(IXmlReader *reader, const WCHAR *name, struct trigger *trigger)
+{
+    WCHAR *value;
+    HRESULT hr;
+
+    if (FAILED(hr = read_text(reader, &value))) return hr;
+    if (!wcscmp(name, L"Week"))
+    {
+        if (!wcscmp(value, L"Last")) trigger->run_on_last = TRUE;
+        else
+        {
+            int week = wcstol(value, NULL, 10);
+            if (week >= 1 && week <= 4) trigger->weeks_of_month |= 1 << (week - 1);
+        }
+    }
+    return S_OK;
+}
