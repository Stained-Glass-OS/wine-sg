+HRESULT NamedValues_create(ITaskNamedValueCollection **obj)
+{
+    struct named_values *values;
+    HRESULT hr;
+
+    if (FAILED(hr = values_create(&values))) return hr;
+    *obj = &values->ITaskNamedValueCollection_iface;
+    return S_OK;
+}
+
+/* a collection of the pairs the one given has now */
+HRESULT NamedValues_copy(ITaskNamedValueCollection *from, ITaskNamedValueCollection **obj)
+{
+    ITaskNamedValueCollection *copy;
+    LONG count = 0, i;
+    HRESULT hr;
+
+    if (FAILED(hr = NamedValues_create(&copy))) return hr;
+    ITaskNamedValueCollection_get_Count(from, &count);
+    for (i = 1; i <= count && SUCCEEDED(hr); i++)
+    {
+        ITaskNamedValuePair *pair, *created;
+        VARIANT v;
+        BSTR name = NULL, value = NULL;
+
+        V_VT(&v) = VT_I4;
+        V_I4(&v) = i;
+        if (FAILED(hr = ITaskNamedValueCollection_get_Item(from, v, &pair))) break;
+        ITaskNamedValuePair_get_Name(pair, &name);
+        ITaskNamedValuePair_get_Value(pair, &value);
+        if (SUCCEEDED(hr = ITaskNamedValueCollection_Create(copy, name ? name : (BSTR)L"", value, &created)))
+            ITaskNamedValuePair_Release(created);
+        SysFreeString(name);
+        SysFreeString(value);
+        ITaskNamedValuePair_Release(pair);
+    }
+    if (FAILED(hr))
+    {
+        ITaskNamedValueCollection_Release(copy);
+        return hr;
+    }
+    *obj = copy;
+    return S_OK;
+}
