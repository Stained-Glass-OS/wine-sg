+
+struct named_pair
+{
+    ITaskNamedValuePair ITaskNamedValuePair_iface;
+    LONG ref;
+    WCHAR *name, *value;
+};
+
+static inline struct named_pair *impl_from_ITaskNamedValuePair(ITaskNamedValuePair *iface)
+{
+    return CONTAINING_RECORD(iface, struct named_pair, ITaskNamedValuePair_iface);
+}
+
+static HRESULT WINAPI pair_QueryInterface(ITaskNamedValuePair *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch) ||
+        IsEqualGUID(riid, &IID_ITaskNamedValuePair))
+    {
+        ITaskNamedValuePair_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI pair_AddRef(ITaskNamedValuePair *iface)
+{
+    return InterlockedIncrement(&impl_from_ITaskNamedValuePair(iface)->ref);
+}
+
+static ULONG WINAPI pair_Release(ITaskNamedValuePair *iface)
+{
+    struct named_pair *pair = impl_from_ITaskNamedValuePair(iface);
+    LONG ref = InterlockedDecrement(&pair->ref);
+
+    if (!ref)
+    {
+        free(pair->name);
+        free(pair->value);
+        free(pair);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI pair_GetTypeInfoCount(ITaskNamedValuePair *iface, UINT *count)
+{
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI pair_GetTypeInfo(ITaskNamedValuePair *iface, UINT index, LCID lcid, ITypeInfo **info)
+{
+    if (index) return DISP_E_BADINDEX;
+    return get_typeinfo(&IID_ITaskNamedValuePair, info);
+}
+
+static HRESULT WINAPI pair_GetIDsOfNames(ITaskNamedValuePair *iface, REFIID riid, LPOLESTR *names, UINT count,
+                                         LCID lcid, DISPID *dispid)
+{
+    return dispatch_get_ids(&IID_ITaskNamedValuePair, names, count, dispid);
+}
+
+static HRESULT WINAPI pair_Invoke(ITaskNamedValuePair *iface, DISPID dispid, REFIID riid, LCID lcid, WORD flags,
+                                  DISPPARAMS *params, VARIANT *result, EXCEPINFO *excepinfo, UINT *argerr)
+{
+    return dispatch_invoke((IDispatch *)iface, &IID_ITaskNamedValuePair, dispid, flags, params, result, excepinfo,
+                           argerr);
+}
+
+static HRESULT WINAPI pair_get_Name(ITaskNamedValuePair *iface, BSTR *name)
+{
+    return get_string(impl_from_ITaskNamedValuePair(iface)->name, name);
+}
+
+static HRESULT WINAPI pair_put_Name(ITaskNamedValuePair *iface, BSTR name)
+{
+    return put_string(&impl_from_ITaskNamedValuePair(iface)->name, name);
+}
+
+static HRESULT WINAPI pair_get_Value(ITaskNamedValuePair *iface, BSTR *value)
+{
+    return get_string(impl_from_ITaskNamedValuePair(iface)->value, value);
+}
+
+static HRESULT WINAPI pair_put_Value(ITaskNamedValuePair *iface, BSTR value)
+{
+    return put_string(&impl_from_ITaskNamedValuePair(iface)->value, value);
+}
+
+static const ITaskNamedValuePairVtbl pair_vtbl =
+{
+    pair_QueryInterface, pair_AddRef, pair_Release, pair_GetTypeInfoCount, pair_GetTypeInfo, pair_GetIDsOfNames,
+    pair_Invoke, pair_get_Name, pair_put_Name, pair_get_Value, pair_put_Value
