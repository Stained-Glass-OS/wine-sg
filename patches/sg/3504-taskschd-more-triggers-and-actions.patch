+
+static HRESULT pair_create(const WCHAR *name, const WCHAR *value, struct named_pair **out)
+{
+    struct named_pair *pair;
+
+    if (!(pair = calloc(1, sizeof(*pair)))) return E_OUTOFMEMORY;
+    pair->ITaskNamedValuePair_iface.lpVtbl = &pair_vtbl;
+    pair->ref = 1;
+    if (FAILED(put_string(&pair->name, name)) || FAILED(put_string(&pair->value, value)))
+    {
+        pair_Release(&pair->ITaskNamedValuePair_iface);
+        return E_OUTOFMEMORY;
+    }
+    *out = pair;
+    return S_OK;
+}
