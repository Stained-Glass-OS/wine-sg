+static HRESULT WINAPI impl_IEventTrigger_get_ValueQueries(IEventTrigger *iface, ITaskNamedValueCollection **queries)
+{
+    struct trigger *trigger = impl_from_ITrigger((ITrigger *)iface);
+    HRESULT hr;
+
+    if (!queries) return E_POINTER;
+    if (!trigger->queries && FAILED(hr = values_create(&trigger->queries))) return hr;
+    ITaskNamedValueCollection_AddRef(*queries = &trigger->queries->ITaskNamedValueCollection_iface);
+    return S_OK;
+}
+static HRESULT WINAPI impl_IEventTrigger_put_ValueQueries(IEventTrigger *iface, ITaskNamedValueCollection *queries)
+{
+    struct trigger *trigger = impl_from_ITrigger((ITrigger *)iface);
+    struct named_values *copy;
+    LONG count = 0, i;
+    HRESULT hr;
+
+    if (!queries) return E_POINTER;
+    if (queries->lpVtbl == &values_vtbl && impl_from_ITaskNamedValueCollection(queries) == trigger->queries)
+        return S_OK;
+    if (FAILED(hr = values_create(&copy))) return hr;
+    /* the pairs are taken as they are now: the collection given stays the caller's */
+    ITaskNamedValueCollection_get_Count(queries, &count);
+    for (i = 1; i <= count && SUCCEEDED(hr); i++)
+    {
+        ITaskNamedValuePair *pair, *created;
+        VARIANT v;
+        BSTR name = NULL, value = NULL;
+
+        V_VT(&v) = VT_I4;
+        V_I4(&v) = i;
+        if (FAILED(hr = ITaskNamedValueCollection_get_Item(queries, v, &pair))) break;
+        ITaskNamedValuePair_get_Name(pair, &name);
+        ITaskNamedValuePair_get_Value(pair, &value);
+        if (SUCCEEDED(hr = ITaskNamedValueCollection_Create(&copy->ITaskNamedValueCollection_iface, name, value,
+                                                            &created)))
+            ITaskNamedValuePair_Release(created);
+        SysFreeString(name);
+        SysFreeString(value);
+        ITaskNamedValuePair_Release(pair);
+    }
+    if (FAILED(hr))
+    {
+        ITaskNamedValueCollection_Release(&copy->ITaskNamedValueCollection_iface);
+        return hr;
+    }
+    if (trigger->queries) ITaskNamedValueCollection_Release(&trigger->queries->ITaskNamedValueCollection_iface);
+    trigger->queries = copy;
+    return S_OK;
+}
