+struct header_ctx
+{
+    BSTR name, value;
+};
+
+static HRESULT read_header_field_child(IXmlReader *reader, const WCHAR *name, void *ctx)
+{
+    struct header_ctx *header = ctx;
+    WCHAR *value;
+    HRESULT hr;
+
+    if (FAILED(hr = read_text_value(reader, &value))) return hr;
+    if (!wcscmp(name, L"Name")) { SysFreeString(header->name); header->name = SysAllocString(value); }
+    else if (!wcscmp(name, L"Value")) { SysFreeString(header->value); header->value = SysAllocString(value); }
+    return S_OK;
+}
+
+static HRESULT read_header_fields_child(IXmlReader *reader, const WCHAR *name, void *ctx)
+{
+    ITaskNamedValueCollection *fields = ctx;
+    struct header_ctx header = {0};
+    ITaskNamedValuePair *pair;
+    HRESULT hr;
+
+    if (wcscmp(name, L"HeaderField")) return skip_action_element(reader);
+    if (SUCCEEDED(hr = read_action_children(reader, read_header_field_child, &header)))
+    {
+        if (SUCCEEDED(hr = ITaskNamedValueCollection_Create(fields, header.name ? header.name : (BSTR)L"",
+                                                            header.value, &pair)))
+            ITaskNamedValuePair_Release(pair);
+    }
+    SysFreeString(header.name);
+    SysFreeString(header.value);
+    return hr;
+}
+
+static HRESULT read_attachments_child(IXmlReader *reader, const WCHAR *name, void *ctx)
+{
+    SAFEARRAY **files = ctx;
+    WCHAR *value;
+    HRESULT hr;
+
+    if (wcscmp(name, L"File")) return skip_action_element(reader);
+    if (FAILED(hr = read_text_value(reader, &value))) return hr;
+    {
+        SAFEARRAY *grown;
+        LONG count = *files ? (*files)->rgsabound[0].cElements : 0;
+        SAFEARRAYBOUND bound = { count + 1, 0 };
+        VARIANT v;
+        LONG i;
+
+        if (!(grown = SafeArrayCreate(VT_VARIANT, 1, &bound))) return E_OUTOFMEMORY;
+        for (i = 0; i < count; i++)
+        {
+            VariantInit(&v);
+            SafeArrayGetElement(*files, &i, &v);
+            SafeArrayPutElement(grown, &i, &v);
+            VariantClear(&v);
+        }
+        V_VT(&v) = VT_BSTR;
+        V_BSTR(&v) = SysAllocString(value);
+        SafeArrayPutElement(grown, &count, &v);
+        VariantClear(&v);
+        SafeArrayDestroy(*files);
+        *files = grown;
+    }
+    return S_OK;
+}
