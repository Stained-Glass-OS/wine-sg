+
+static HRESULT WINAPI values_get_Item(ITaskNamedValueCollection *iface, VARIANT index, ITaskNamedValuePair **pair)
+{
+    struct named_values *values = impl_from_ITaskNamedValueCollection(iface);
+    VARIANT v;
+    LONG i;
+
+    if (!pair) return E_POINTER;
+    VariantInit(&v);
+    if (FAILED(VariantChangeType(&v, &index, 0, VT_I4))) return E_INVALIDARG;
+    i = V_I4(&v);
+    if (i < 1 || i > values->count) return E_INVALIDARG;
+    ITaskNamedValuePair_AddRef(*pair = &values->items[i - 1]->ITaskNamedValuePair_iface);
+    return S_OK;
+}
+
+static HRESULT WINAPI values_get__NewEnum(ITaskNamedValueCollection *iface, IUnknown **penum)
+{
+    SAFEARRAY *array;
+    IEnumVARIANT *e;
+    LONG count = 0, i;
+    HRESULT hr = S_OK;
+
+    if (!penum) return E_POINTER;
+    ITaskNamedValueCollection_get_Count(iface, &count);
+    if (!(array = SafeArrayCreateVector(VT_VARIANT, 0, count))) return E_OUTOFMEMORY;
+    for (i = 0; i < count && SUCCEEDED(hr); i++)
+    {
+        ITaskNamedValuePair *pair;
+        VARIANT v;
+
+        V_VT(&v) = VT_I4;
+        V_I4(&v) = i + 1;
+        if (FAILED(hr = ITaskNamedValueCollection_get_Item(iface, v, &pair))) break;
+        V_VT(&v) = VT_DISPATCH;
+        V_DISPATCH(&v) = (IDispatch *)pair;
+        hr = SafeArrayPutElement(array, &i, &v);
+        ITaskNamedValuePair_Release(pair);
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = variant_array_enum_create(array, &e))) *penum = (IUnknown *)e;
+    SafeArrayDestroy(array);
+    return hr;
+}
+
+static HRESULT values_add(struct named_values *values, struct named_pair *pair)
+{
+    if (values->count == values->size)
+    {
+        LONG size = max(4, values->size * 2);
+        struct named_pair **items = realloc(values->items, size * sizeof(*items));
+
+        if (!items) return E_OUTOFMEMORY;
+        values->items = items;
+        values->size = size;
+    }
+    ITaskNamedValuePair_AddRef(&(values->items[values->count++] = pair)->ITaskNamedValuePair_iface);
+    return S_OK;
+}
+
+static HRESULT WINAPI values_Create(ITaskNamedValueCollection *iface, BSTR name, BSTR value,
+                                    ITaskNamedValuePair **out)
+{
+    struct named_values *values = impl_from_ITaskNamedValueCollection(iface);
+    struct named_pair *pair;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    if (!name) return E_INVALIDARG;
+    if (FAILED(hr = pair_create(name, value, &pair))) return hr;
+    if (FAILED(hr = values_add(values, pair)))
+    {
+        ITaskNamedValuePair_Release(&pair->ITaskNamedValuePair_iface);
+        return hr;
+    }
+    *out = &pair->ITaskNamedValuePair_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI values_Remove(ITaskNamedValueCollection *iface, LONG index)
+{
+    struct named_values *values = impl_from_ITaskNamedValueCollection(iface);
+
+    if (index < 1 || index > values->count) return E_INVALIDARG;
+    ITaskNamedValuePair_Release(&values->items[index - 1]->ITaskNamedValuePair_iface);
+    memmove(&values->items[index - 1], &values->items[index], (values->count - index) * sizeof(*values->items));
+    values->count--;
+    return S_OK;
