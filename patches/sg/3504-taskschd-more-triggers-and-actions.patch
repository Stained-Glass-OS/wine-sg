+static HRESULT read_value_query(IXmlReader *reader, const WCHAR *name, struct trigger *trigger)
+{
+    WCHAR *value, *query_name = NULL;
+    const WCHAR *attr, *attr_value;
+    struct named_pair *pair;
+    HRESULT hr;
+
+    if (wcscmp(name, L"Value")) return skip_element(reader);
+    for (hr = IXmlReader_MoveToFirstAttribute(reader); hr == S_OK; hr = IXmlReader_MoveToNextAttribute(reader))
+    {
+        if (FAILED(IXmlReader_GetLocalName(reader, &attr, NULL)) || FAILED(IXmlReader_GetValue(reader, &attr_value, NULL)))
+            break;
+        if (!wcscmp(attr, L"name") && !(query_name = wcsdup(attr_value))) return E_OUTOFMEMORY;
+    }
+    IXmlReader_MoveToElement(reader);
+    if (FAILED(hr = read_text(reader, &value)))
+    {
+        free(query_name);
+        return hr;
+    }
+    if (!trigger->queries && FAILED(hr = values_create(&trigger->queries)))
+    {
+        free(query_name);
+        return hr;
+    }
+    if (SUCCEEDED(hr = pair_create(query_name ? query_name : L"", value, &pair)))
+    {
+        hr = values_add(trigger->queries, pair);
+        ITaskNamedValuePair_Release(&pair->ITaskNamedValuePair_iface);
+    }
+    free(query_name);
+    return hr;
+}
