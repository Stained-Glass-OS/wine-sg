+static void write_action_element_start(IStream *stream, const WCHAR *name, BSTR id)
+{
+    if (id)
+    {
+        xml_write_indent(stream);
+        xml_write_string(stream, L"<");
+        xml_write_string(stream, name);
+        xml_write_string(stream, L" id=\"");
+        xml_write_escaped(stream, id);
+        xml_write_string(stream, L"\">\n");
+    }
+    else
+        xml_write_element(stream, name);
+    xml_push_indent();
+}
+
+static void write_text_if(IStream *stream, const WCHAR *name, BSTR value)
+{
+    if (value) xml_write_text_value(stream, name, value);
+    SysFreeString(value);
+}
+
+static void write_other_action(IStream *stream, IAction *action, TASK_ACTION_TYPE type)
+{
+    BSTR id = NULL, value;
+
+    IAction_get_Id(action, &id);
+    if (type == TASK_ACTION_COM_HANDLER)
+    {
+        IComHandlerAction *com;
+
+        if (FAILED(IAction_QueryInterface(action, &IID_IComHandlerAction, (void **)&com))) goto done;
+        write_action_element_start(stream, L"ComHandler", id);
+        value = NULL; IComHandlerAction_get_ClassId(com, &value); write_text_if(stream, L"ClassId", value);
+        value = NULL; IComHandlerAction_get_Data(com, &value);
+        if (value && *value) xml_write_text_value(stream, L"Data", value);
+        SysFreeString(value);
+        xml_pop_indent();
+        xml_write_element_end(stream, L"ComHandler");
+        IComHandlerAction_Release(com);
+    }
+    else if (type == TASK_ACTION_SHOW_MESSAGE)
+    {
+        IShowMessageAction *msg;
+
+        if (FAILED(IAction_QueryInterface(action, &IID_IShowMessageAction, (void **)&msg))) goto done;
+        write_action_element_start(stream, L"ShowMessage", id);
+        value = NULL; IShowMessageAction_get_Title(msg, &value); write_text_if(stream, L"Title", value);
+        value = NULL; IShowMessageAction_get_MessageBody(msg, &value); write_text_if(stream, L"Body", value);
+        xml_pop_indent();
+        xml_write_element_end(stream, L"ShowMessage");
+        IShowMessageAction_Release(msg);
+    }
+    else if (type == TASK_ACTION_SEND_EMAIL)
+    {
+        IEmailAction *mail;
+        ITaskNamedValueCollection *fields = NULL;
+        SAFEARRAY *files = NULL;
+        LONG count = 0, i;
+
+        if (FAILED(IAction_QueryInterface(action, &IID_IEmailAction, (void **)&mail))) goto done;
+        write_action_element_start(stream, L"SendEmail", id);
+        value = NULL; IEmailAction_get_Server(mail, &value); write_text_if(stream, L"Server", value);
+        value = NULL; IEmailAction_get_Subject(mail, &value); write_text_if(stream, L"Subject", value);
+        value = NULL; IEmailAction_get_To(mail, &value); write_text_if(stream, L"To", value);
+        value = NULL; IEmailAction_get_Cc(mail, &value); write_text_if(stream, L"Cc", value);
+        value = NULL; IEmailAction_get_Bcc(mail, &value); write_text_if(stream, L"Bcc", value);
+        value = NULL; IEmailAction_get_ReplyTo(mail, &value); write_text_if(stream, L"ReplyTo", value);
+        value = NULL; IEmailAction_get_From(mail, &value); write_text_if(stream, L"From", value);
+        if (SUCCEEDED(IEmailAction_get_HeaderFields(mail, &fields)) && fields)
+        {
+            ITaskNamedValueCollection_get_Count(fields, &count);
+            if (count)
+            {
+                xml_write_element(stream, L"HeaderFields");
+                xml_push_indent();
+                for (i = 1; i <= count; i++)
+                {
+                    ITaskNamedValuePair *pair;
+                    VARIANT v;
+                    BSTR name = NULL, field = NULL;
+
+                    V_VT(&v) = VT_I4;
+                    V_I4(&v) = i;
+                    if (FAILED(ITaskNamedValueCollection_get_Item(fields, v, &pair))) continue;
+                    ITaskNamedValuePair_get_Name(pair, &name);
+                    ITaskNamedValuePair_get_Value(pair, &field);
+                    xml_write_element(stream, L"HeaderField");
+                    xml_push_indent();
+                    xml_write_text_value(stream, L"Name", name ? name : L"");
+                    xml_write_text_value(stream, L"Value", field ? field : L"");
+                    xml_pop_indent();
+                    xml_write_element_end(stream, L"HeaderField");
+                    SysFreeString(name);
+                    SysFreeString(field);
+                    ITaskNamedValuePair_Release(pair);
+                }
+                xml_pop_indent();
+                xml_write_element_end(stream, L"HeaderFields");
+            }
+            ITaskNamedValueCollection_Release(fields);
+        }
+        value = NULL; IEmailAction_get_Body(mail, &value); write_text_if(stream, L"Body", value);
+        if (SUCCEEDED(IEmailAction_get_Attachments(mail, &files)) && files)
+        {
+            LONG lower, upper;
+
+            if (SUCCEEDED(SafeArrayGetLBound(files, 1, &lower)) && SUCCEEDED(SafeArrayGetUBound(files, 1, &upper))
+                && upper >= lower)
+            {
+                xml_write_element(stream, L"Attachments");
+                xml_push_indent();
+                for (i = lower; i <= upper; i++)
+                {
+                    VARIANT v;
+
+                    VariantInit(&v);
+                    if (SUCCEEDED(SafeArrayGetElement(files, &i, &v)) && V_VT(&v) == VT_BSTR && V_BSTR(&v))
+                        xml_write_text_value(stream, L"File", V_BSTR(&v));
+                    VariantClear(&v);
+                }
+                xml_pop_indent();
+                xml_write_element_end(stream, L"Attachments");
+            }
+            SafeArrayDestroy(files);
+        }
+        xml_pop_indent();
+        xml_write_element_end(stream, L"SendEmail");
+        IEmailAction_Release(mail);
+    }
+done:
+    SysFreeString(id);
+}
