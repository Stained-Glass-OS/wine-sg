From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui: the input pane shows the keyboard only after a touch

InputPane.TryShow started the on-screen keyboard whatever the last input was. Windows shows it only
when that was a touch or a pen; Chromium (WebView2: Word's "Describe what you'd like to draft" box)
asks for it on every focused text field, so a mouse click brought up the keyboard. TryShow now
requires the last input to be the touch wine-sg 1150 stamps (__wine_sg_touch_time).
---
diff --git a/dlls/windows.ui/inputpane.c b/dlls/windows.ui/inputpane.c
--- a/dlls/windows.ui/inputpane.c
+++ b/dlls/windows.ui/inputpane.c
@@ -476,6 +476,25 @@
 
 DEFINE_IINSPECTABLE( inputpane2, IInputPane2, struct inputpane, IInputPane_iface );
 
+/* Stained Glass OS: the last input was a touch or a pen (wine-sg 1150 stamps
+ * the desktop window's __wine_sg_touch_time when one goes down): Windows
+ * shows the keyboard for TryShow only then. Chromium (WebView2: Word's
+ * "Describe what you'd like to draft" box) asks for it whenever a text field
+ * is focused, and a click with the mouse brought up the keyboard. */
+static BOOL last_input_was_touch(void)
+{
+    DWORD touch = HandleToULong( GetPropW( GetDesktopWindow(), L"__wine_sg_touch_time" ) );
+    LASTINPUTINFO lii = { sizeof(lii) };
+
+#ifdef SG_MUTANT_PANE_ANY_INPUT
+    return TRUE;
+#endif
+    if (!touch) return FALSE;
+    if (!GetLastInputInfo( &lii )) return TRUE;
+    /* nothing but the touch since (its own input counts; a moment's slack) */
+    return (LONG)(lii.dwTime - touch) <= 500;
+}
+
 static HRESULT WINAPI inputpane2_TryShow( IInputPane2 *iface, boolean *result )
 {
     HWND kbd = keyboard_window();
@@ -483,6 +502,11 @@
     TRACE( "iface %p, result %p.\n", iface, result );
 
     if (!result) return E_POINTER;
+    if (!last_input_was_touch())
+    {
+        *result = FALSE;
+        return S_OK;
+    }
     if (kbd)
     {
         if (!IsWindowVisible( kbd ) || IsIconic( kbd )) ShowWindowAsync( kbd, SW_SHOWNOACTIVATE );
