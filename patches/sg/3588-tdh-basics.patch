diff --git a/dlls/tdh/tdh_main.c b/dlls/tdh/tdh_main.c
index 60f3297..e8ab628 100644
--- a/dlls/tdh/tdh_main.c
+++ b/dlls/tdh/tdh_main.c
@@ -23,7 +23,10 @@
 #include "windef.h"
 #include "winbase.h"
 #include "winternl.h"
+#include "winreg.h"
 #include "wine/debug.h"
+#include <stdlib.h>
+#include <stddef.h>
 
 WINE_DEFAULT_DEBUG_CHANNEL(tdh);
 
@@ -38,3 +41,141 @@ ULONG WINAPI TdhLoadManifestFromBinary(LPWSTR binary)
     FIXME("(%s): stub\n", debugstr_w(binary));
     return STATUS_SUCCESS;
 }
+
+/* Structures of the Trace Data Helper API (from its published documentation). */
+typedef struct
+{
+    GUID ProviderGuid;
+    ULONG SchemaSource;
+    ULONG ProviderNameOffset;
+} TRACE_PROVIDER_INFO;
+
+typedef struct
+{
+    ULONG NumberOfProviders;
+    ULONG Reserved;
+    TRACE_PROVIDER_INFO TraceProviderInfoArray[1];
+} PROVIDER_ENUMERATION_INFO;
+
+#define SCHEMA_SOURCE_XML_MANIFEST 0
+
+struct provider { GUID guid; WCHAR name[128]; };
+
+struct decoding_handle
+{
+    ULONG magic;
+};
+#define DECODING_MAGIC 0x54444831
+
+/* A decoding handle carries no state of its own here: events are decoded from manifests only. */
+ULONG WINAPI TdhOpenDecodingHandle(HANDLE *handle)
+{
+    struct decoding_handle *h;
+
+    TRACE("(%p)\n", handle);
+
+    if (!handle) return ERROR_INVALID_PARAMETER;
+    if (!(h = calloc(1, sizeof(*h)))) return ERROR_OUTOFMEMORY;
+    h->magic = DECODING_MAGIC;
+    *handle = h;
+    return ERROR_SUCCESS;
+}
+
+ULONG WINAPI TdhCloseDecodingHandle(HANDLE handle)
+{
+    struct decoding_handle *h = handle;
+
+    TRACE("(%p)\n", handle);
+
+    if (!h || h->magic != DECODING_MAGIC) return ERROR_INVALID_HANDLE;
+    h->magic = 0;
+    free(h);
+    return ERROR_SUCCESS;
+}
+
+ULONG WINAPI TdhUnloadManifest(const WCHAR *manifest)
+{
+    TRACE("(%s)\n", debugstr_w(manifest));
+    if (!manifest) return ERROR_INVALID_PARAMETER;
+    return ERROR_SUCCESS;
+}
+
+/* No schema for any event is known (no manifest is ever really loaded). */
+ULONG WINAPI TdhGetEventInformation(void *event, ULONG count, void *context, void *info, ULONG *size)
+{
+    TRACE("(%p %lu %p %p %p)\n", event, count, context, info, size);
+
+    if (!event || !size) return ERROR_INVALID_PARAMETER;
+    return ERROR_NOT_FOUND;
+}
+
+/* The providers are those that registered a publisher with the event log:
+ * HKLM\Software\Microsoft\Windows\CurrentVersion\WINEVT\Publishers\{guid}, default value the name. */
+ULONG WINAPI TdhEnumerateProviders(PROVIDER_ENUMERATION_INFO *buffer, ULONG *size)
+{
+    static const WCHAR pubs[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Publishers";
+    ULONG i, count = 0, needed, names = 0, offset;
+    WCHAR *name_pool = NULL;
+    HKEY key;
+    struct provider *list = NULL;
+    ULONG status = ERROR_SUCCESS;
+
+    TRACE("(%p %p)\n", buffer, size);
+    if (!size) return ERROR_INVALID_PARAMETER;
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, pubs, 0, KEY_READ, &key) == ERROR_SUCCESS)
+    {
+        WCHAR sub[64];
+        DWORD len, index;
+
+        for (index = 0; len = ARRAY_SIZE(sub), RegEnumKeyExW(key, index, sub, &len, NULL, NULL, NULL, NULL) == ERROR_SUCCESS; index++)
+        {
+            struct provider *tmp;
+            UNICODE_STRING us;
+            HKEY sk;
+            DWORD vlen;
+
+            RtlInitUnicodeString(&us, sub);
+            if (sub[0] != '{') continue;
+            if (!(tmp = realloc(list, (count + 1) * sizeof(*list)))) { status = ERROR_OUTOFMEMORY; break; }
+            list = tmp;
+            if (RtlGUIDFromString(&us, &list[count].guid)) continue;
+            list[count].name[0] = 0;
+            if (!RegOpenKeyExW(key, sub, 0, KEY_READ, &sk))
+            {
+                vlen = sizeof(list[count].name) - sizeof(WCHAR);
+                if (RegQueryValueExW(sk, NULL, NULL, NULL, (BYTE *)list[count].name, &vlen)) list[count].name[0] = 0;
+                else list[count].name[vlen / sizeof(WCHAR)] = 0;
+                RegCloseKey(sk);
+            }
+            names += (wcslen(list[count].name) + 1) * sizeof(WCHAR);
+            count++;
+        }
+        RegCloseKey(key);
+    }
+    if (status) { free(list); return status; }
+
+    offset = offsetof(PROVIDER_ENUMERATION_INFO, TraceProviderInfoArray) + count * sizeof(TRACE_PROVIDER_INFO);
+    needed = max(offset + names, sizeof(PROVIDER_ENUMERATION_INFO));
+    if (!buffer || *size < needed)
+    {
+        *size = needed;
+        free(list);
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    buffer->NumberOfProviders = count;
+    buffer->Reserved = 0;
+    name_pool = (WCHAR *)((BYTE *)buffer + offset);
+    for (i = 0; i < count; i++)
+    {
+        ULONG len = (wcslen(list[i].name) + 1) * sizeof(WCHAR);
+
+        buffer->TraceProviderInfoArray[i].ProviderGuid = list[i].guid;
+        buffer->TraceProviderInfoArray[i].SchemaSource = SCHEMA_SOURCE_XML_MANIFEST;
+        buffer->TraceProviderInfoArray[i].ProviderNameOffset = (BYTE *)name_pool - (BYTE *)buffer;
+        memcpy(name_pool, list[i].name, len);
+        name_pool = (WCHAR *)((BYTE *)name_pool + len);
+    }
+    *size = needed;
+    free(list);
+    return ERROR_SUCCESS;
+}
