+/* DropShadow (8215): a sprite visual's shadow -- BlurRadius, Color, Mask, Offset, Opacity, SourcePolicy kept
+ * (Windows' defaults: radius 9, black, opaque); not drawn yet */
+struct shadow
+{
+    struct { const void * const *vtbl; } ICompositionShadow_iface;
+    struct { const void * const *vtbl; } IDropShadow_iface;
+    struct { const void * const *vtbl; } IDropShadow2_iface;
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    IInspectable ICompositionObject4_iface;
+    LONG ref;
+    struct compositor *compositor;
+    FLOAT blur_radius, opacity;
+    Color color;
+    Vector3 offset;
+    ICompositionBrush *mask;
+    INT32 source_policy;
+    ICompositionPropertySet *properties;
+};
+
+static struct shadow *impl_from_shadow( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct shadow, ICompositionShadow_iface );
+}
+
+static HRESULT WINAPI shadow_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    struct shadow *impl = impl_from_shadow( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICompositionShadow_x ))
+        *out = &impl->ICompositionShadow_iface;
+    else if (IsEqualGUID( iid, &IID_IDropShadow_x ))
+        *out = &impl->IDropShadow_iface;
+    else if (IsEqualGUID( iid, &IID_IDropShadow2_x ))
+        *out = &impl->IDropShadow2_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject4_x ))
+        *out = &impl->ICompositionObject4_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject ))
+        *out = &impl->ICompositionObject_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI shadow_AddRef( void *iface )
+{
+    return InterlockedIncrement( &impl_from_shadow( iface )->ref );
+}
+
+static ULONG WINAPI shadow_Release( void *iface )
+{
+    struct shadow *impl = impl_from_shadow( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->mask) ICompositionBrush_Release( impl->mask );
+        ICompositor_Release( (ICompositor *)impl->compositor );
+        object_release_properties( impl->properties );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI shadow_GetIids( void *iface, ULONG *iid_count, IID **iids )
+{
+    static const IID *const list[] = { &IID_IDropShadow_x, &IID_IDropShadow2_x, &IID_ICompositionShadow_x,
+                                       &IID_ICompositionObject, &IID_IClosable };
+    return get_iids( iid_count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI shadow_GetRuntimeClassName( void *iface, HSTRING *class_name )
+{
+    return runtime_class_name( class_drop_shadow, class_name );
+}
+
+static HRESULT WINAPI shadow_GetTrustLevel( void *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static const void * const shadow_vtbl[] =
+{
+    shadow_QueryInterface, shadow_AddRef, shadow_Release, shadow_GetIids, shadow_GetRuntimeClassName,
+    shadow_GetTrustLevel,
+};
