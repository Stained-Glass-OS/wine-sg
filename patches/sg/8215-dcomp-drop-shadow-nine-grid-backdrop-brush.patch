+    {                                                                                              \
+        if (!value) return E_POINTER;                                                              \
+        *value = drop_shadow_impl( iface )->field;                                                 \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static HRESULT WINAPI drop_shadow_put_##name( void *iface, type value )                        \
