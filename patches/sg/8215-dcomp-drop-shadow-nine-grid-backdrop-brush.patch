+static HRESULT shadow_create( struct compositor *compositor, struct shadow **out )
+{
+    struct shadow *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->ICompositionShadow_iface.vtbl = shadow_vtbl;
+    impl->IDropShadow_iface.vtbl = drop_shadow_vtbl;
+    impl->IDropShadow2_iface.vtbl = drop_shadow2_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &shadow_object_vtbl;
+    impl->IClosable_iface.lpVtbl = &shadow_closable_vtbl;
+    impl->ICompositionObject4_iface.lpVtbl = (const IInspectableVtbl *)shadow_object4_vtbl;
+    impl->ref = 1;
+    impl->compositor = compositor;
+    ICompositor_AddRef( (ICompositor *)compositor );
+    impl->blur_radius = 9.0f;
+    impl->opacity = 1.0f;
+    impl->color.A = 255;
+    *out = impl;
+    return S_OK;
