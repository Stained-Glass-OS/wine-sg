+/* a nine-grid brush (8215): its source's nine parts, corners at their inset sizes times the scales, edges
+ * stretched along, the centre both ways or left out when hollow */
+static void draw_nine_grid_brush( ID2D1DeviceContext *ctx, Vector2 size, struct brush *brush, float opacity,
+        const D2D1_MATRIX_3X2_F *world, struct swapchain_place *places, unsigned int max_places, unsigned int *count,
+        unsigned int depth )
+{
+    struct brush *source = unsafe_brush( brush->source );
+    float dx[4], dy[4], sx[4], sy[4], sw = 0, sh = 0;
+    struct drawing_surface *surface = NULL;
+    ID2D1SolidColorBrush *solid = NULL;
+    unsigned int i, j;
+
+    if (!source || depth > 8) return;
+    dx[0] = 0; dx[1] = brush->ng_left * brush->ng_left_scale;
+    dx[3] = size.X; dx[2] = size.X - brush->ng_right * brush->ng_right_scale;
+    dy[0] = 0; dy[1] = brush->ng_top * brush->ng_top_scale;
+    dy[3] = size.Y; dy[2] = size.Y - brush->ng_bottom * brush->ng_bottom_scale;
+
+    if (source->surface_brush)
+    {
+        surface = unsafe_drawing_surface( (IUnknown *)source->surface );
+        if (!surface || !surface->bitmap || draw_render_target_only) return;
+        sw = surface->size.width;
+        sh = surface->size.height;
+        sx[0] = 0; sx[1] = brush->ng_left; sx[2] = sw - brush->ng_right; sx[3] = sw;
+        sy[0] = 0; sy[1] = brush->ng_top; sy[2] = sh - brush->ng_bottom; sy[3] = sh;
+    }
+    else if (!source->mask_brush && !source->nine_grid && !source->backdrop)
+    {
+        D2D1_COLOR_F color = { source->color.R / 255.0f, source->color.G / 255.0f, source->color.B / 255.0f,
+                               source->color.A / 255.0f * opacity };
+        if (FAILED(ID2D1DeviceContext_CreateSolidColorBrush( ctx, &color, NULL, &solid ))) return;
+    }
+    else
+    {
+        FIXME( "a nine-grid brush over a %s brush draws it whole\n", source->mask_brush ? "mask" : "nine-grid" );
+        draw_brush( ctx, size, source, opacity, world, places, max_places, count, depth + 1 );
+        return;
+    }
+
+    for (j = 0; j < 3; j++)
+    {
+        for (i = 0; i < 3; i++)
+        {
+            D2D1_RECT_F dst = { dx[i], dy[j], dx[i + 1], dy[j + 1] };
+
+            if (i == 1 && j == 1 && brush->ng_hollow) continue;
+            if (dst.right <= dst.left || dst.bottom <= dst.top) continue;
+            if (solid)
+                ID2D1DeviceContext_FillRectangle( ctx, &dst, (ID2D1Brush *)solid );
+            else
+            {
+                D2D1_RECT_F src = { sx[i], sy[j], sx[i + 1], sy[j + 1] };
+                if (src.right <= src.left || src.bottom <= src.top) continue;
+                ID2D1DeviceContext_DrawBitmap( ctx, (ID2D1Bitmap *)surface->bitmap, &dst, opacity,
+                        source->interpolation == CompositionBitmapInterpolationMode_NearestNeighbor
+                        ? D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR : D2D1_INTERPOLATION_MODE_LINEAR, &src, NULL );
+            }
+        }
+    }
+    if (solid) ID2D1SolidColorBrush_Release( solid );
+}
