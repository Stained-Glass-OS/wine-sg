+/* Stained Glass OS (multi-user debt D18): a per-object security descriptor
+ * granting the owning user full access, as Windows gives a process's or
+ * thread's owner. Upstream's default names Administrators only -- fine when
+ * every process is its user's administrator, but in a shared prefix a standard
+ * user could not open, debug or set the affinity of even their own processes.
+ * The user, Local System and Administrators get full access; the owner is the
+ * user. Returned malloc'd and absolute, to be stored in obj->sd (freed on
+ * destroy). GENERIC_ALL is mapped per object by the access check. */
+struct security_descriptor *sg_create_owner_sd( const struct sid *user_sid )
+{
+    struct sid alias_admins_sid = { SID_REVISION, 2, SECURITY_NT_AUTHORITY, { SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS }};
+    int own = user_sid && !equal_sid( user_sid, &local_system_sid );
+    unsigned int count = own ? 3 : 2;
+    struct security_descriptor *sd;
+    size_t owner_len = sid_len( own ? user_sid : &local_system_sid );
+    size_t group_len = sid_len( &domain_users_sid );
+    size_t dacl_len = sizeof(struct acl) + count * sizeof(struct ace) +
+                      sid_len( &local_system_sid ) + sid_len( &alias_admins_sid ) +
+                      (own ? sid_len( user_sid ) : 0);
+    struct acl *dacl;
+    struct ace *ace;
+    char *ptr;
+
+    if (!(sd = mem_alloc( sizeof(*sd) + owner_len + group_len + dacl_len ))) return NULL;
+    sd->control   = SE_DACL_PRESENT;
+    sd->owner_len = owner_len;
+    sd->group_len = group_len;
+    sd->sacl_len  = 0;
+    sd->dacl_len  = dacl_len;
+    ptr = (char *)(sd + 1);
+    copy_sid( (struct sid *)ptr, own ? user_sid : &local_system_sid ); ptr += owner_len;
+    copy_sid( (struct sid *)ptr, &domain_users_sid ); ptr += group_len;
+    dacl = (struct acl *)ptr;
+    dacl->revision = ACL_REVISION;
+    dacl->pad1     = 0;
+    dacl->size     = dacl_len;
+    dacl->count    = count;
+    dacl->pad2     = 0;
+    ace = set_ace( ace_first( dacl ), &local_system_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
+    ace = set_ace( ace_next( ace ), &alias_admins_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
+    if (own) set_ace( ace_next( ace ), user_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
+    return sd;
+}
