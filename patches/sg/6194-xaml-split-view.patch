+
+/*
+ * A SplitView lays out its Pane beside its Content (Inline, CompactInline) or over it (Overlay,
+ * CompactOverlay): the pane is OpenPaneLength wide when open, CompactPaneLength in the compact modes
+ * when closed, hidden otherwise; PanePlacement Right mirrors it.  It is drawn by us, not by a
+ * template: PaneBackground under the pane.  Opening and closing raise PaneOpening/PaneOpened and
+ * PaneClosing (which may cancel) /PaneClosed.  Interface identity per windows-rs 0.30.0 (MIT).
+ */
+
+#include <stdlib.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+enum { MODE_OVERLAY, MODE_INLINE, MODE_COMPACT_OVERLAY, MODE_COMPACT_INLINE };
+
+struct template_settings;
+
+struct splitview
+{
+    struct control c;
+    struct xiface ISplitView_iface, ISplitView2_iface, ISplitView3_iface;
+    struct handler_list closing, closed, opening, opened;
+    struct uielem *content, *pane;  /* children */
+    struct template_settings *settings;   /* its TemplateSettings, once asked for (a reference) */
+    BOOL reverting;                 /* IsPaneOpen set back after a cancelled PaneClosing */
+};
+
+static struct xaml_property *prop_content, *prop_pane, *prop_is_open, *prop_open_length, *prop_compact_length,
+                            *prop_placement, *prop_mode, *prop_settings, *prop_pane_background, *prop_dismiss_mode;
+
+static struct splitview *splitview_from_elem( struct uielem *elem )
+{
+    return CONTAINING_RECORD( elem, struct splitview, c.e );
+}
+
+static struct splitview *splitview_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct splitview, c.e.d.obj );
+}
+
+static struct splitview *splitview_from_dobj( struct dobj *obj )
+{
+    return splitview_from_elem( CONTAINING_RECORD( obj, struct uielem, d ) );
+}
+
+static DOUBLE get_double( struct splitview *sv, struct xaml_property *prop, DOUBLE def )
+{
+    IInspectable *box = NULL;
+    DOUBLE ret;
+
+    dobj_get_value( &sv->c.e.d, prop, &box );
+    ret = xunbox_double( box, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static INT32 get_enum( struct splitview *sv, struct xaml_property *prop, INT32 def )
+{
+    IInspectable *box = NULL;
+    INT32 ret;
+
+    dobj_get_value( &sv->c.e.d, prop, &box );
+    ret = xunbox_enum( box, NULL, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static boolean is_open( struct splitview *sv )
+{
+    IInspectable *box = NULL;
+    boolean ret;
+
+    dobj_get_value( &sv->c.e.d, prop_is_open, &box );
+    ret = xunbox_boolean( box, FALSE );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static HRESULT put_box( struct splitview *sv, struct xaml_property *prop, IInspectable *box )
+{
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &sv->c.e.d, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+/* the pane's width now, and how much of the content's side it takes */
+static void pane_widths( struct splitview *sv, FLOAT *pane, FLOAT *inset )
+{
+    INT32 mode = get_enum( sv, prop_mode, MODE_OVERLAY );
+    FLOAT open = get_double( sv, prop_open_length, 320 ), compact = get_double( sv, prop_compact_length, 48 );
+    BOOL compact_mode = mode == MODE_COMPACT_OVERLAY || mode == MODE_COMPACT_INLINE;
+
+    if (is_open( sv )) *pane = open;
+    else *pane = compact_mode ? compact : 0;
+#ifdef SG_MUTANT_SPLITVIEW_PANE_OVER
+    *inset = 0;
+    return;
+#endif
+    if (mode == MODE_INLINE || mode == MODE_COMPACT_INLINE) *inset = *pane;
+    else *inset = compact_mode ? compact : 0;
+}
+
+static void splitview_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct splitview *sv = splitview_from_elem( elem );
+    FLOAT pane, inset;
+    struct xsize size;
+
+    pane_widths( sv, &pane, &inset );
+    desired->width = desired->height = 0;
+    if (sv->content)
+    {
+        size.width = available.width > inset ? available.width - inset : 0;
+        size.height = available.height;
+        uielem_measure( sv->content, size );
+        desired->width = sv->content->desired.width;
+        desired->height = sv->content->desired.height;
+    }
+    if (sv->pane)
+    {
+        size.width = pane;
+        size.height = available.height;
+        uielem_measure( sv->pane, size );
+        if (sv->pane->desired.height > desired->height) desired->height = sv->pane->desired.height;
+    }
+    desired->width += inset;
+    if (desired->width > available.width) desired->width = available.width;
+}
+
+static void splitview_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct splitview *sv = splitview_from_elem( elem );
+    BOOL right = get_enum( sv, prop_placement, 0 ) == 1;
+    FLOAT pane, inset;
+    struct xrect rect;
+
+    pane_widths( sv, &pane, &inset );
+    if (sv->content)
+    {
+        rect.width = final.width > inset ? final.width - inset : 0;
+        rect.height = final.height;
+        rect.x = right ? 0 : inset;
+        rect.y = 0;
+        uielem_arrange( sv->content, rect );
+    }
+    if (sv->pane)
+    {
+        rect.width = pane;
+        rect.height = final.height;
+        rect.x = right ? final.width - pane : 0;
+        rect.y = 0;
+        uielem_arrange( sv->pane, rect );
+    }
+    *used = final;
+}
+
+static void splitview_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct splitview *sv = splitview_from_elem( elem );
+    BOOL right = get_enum( sv, prop_placement, 0 ) == 1;
+    IInspectable *brush = NULL;
+    struct xcolor color;
+    FLOAT pane, inset;
+    struct xrect rect;
+
+    control_render( elem, draw );
+    pane_widths( sv, &pane, &inset );
+    if (!pane) return;
+    rect.x = right ? elem->render.width - pane : 0;
+    rect.y = 0;
+    rect.width = pane;
+    rect.height = elem->render.height;
+    dobj_get_value( &elem->d, prop_pane_background, &brush );
+    if (brush && xaml_brush_color( brush, &color )) xdraw_fill( draw, &rect, color, NULL );
+    if (brush) IInspectable_Release( brush );
+}
+
+static const struct elem_ops splitview_ops = { splitview_measure, splitview_arrange, splitview_render };
+
+/* ---- the properties' changes ---- */
+
+static void set_part( struct splitview *sv, struct uielem **part, IInspectable *value )
+{
+    struct uielem *elem = value ? uielem_from_inspectable( value ) : NULL;
+
+    if (*part == elem) return;
+    if (*part) uielem_remove_child( &sv->c.e, *part );
+    *part = elem;
+    if (elem) uielem_add_child( &sv->c.e, elem );
+    /* the content first: an overlay pane is drawn over it */
+    if (sv->content && elem == sv->content)
+    {
+        /* moved, not removed and added again: the pane is not unloaded */
+        list_remove( &sv->content->entry );
+        list_add_head( &sv->c.e.children, &sv->content->entry );
+    }
+    uielem_invalidate_measure( &sv->c.e );
+}
+
+static void content_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct splitview *sv = splitview_from_dobj( obj );
+    set_part( sv, &sv->content, new_value );
+}
+
+static void pane_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct splitview *sv = splitview_from_dobj( obj );
+    set_part( sv, &sv->pane, new_value );
+}
+
+static void layout_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    uielem_invalidate_measure( CONTAINING_RECORD( obj, struct uielem, d ) );
+}
+
+/* SplitViewPaneClosingEventArgs */
+struct closing_args
+{
+    struct xobj obj;
+    struct xiface iface;
+    boolean cancel;
+};
+
+static HRESULT WINAPI closing_args_get_Cancel( struct xiface *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = CONTAINING_RECORD( iface->obj, struct closing_args, obj )->cancel;
+    return S_OK;
+}
+
+static HRESULT WINAPI closing_args_put_Cancel( struct xiface *iface, boolean value )
+{
+    CONTAINING_RECORD( iface->obj, struct closing_args, obj )->cancel = value;
+    return S_OK;
+}
+
+static const void *closing_args_vtbl[] =
+{
+    ISplitViewPaneClosingEventArgs_STUBS,
+    [ISplitViewPaneClosingEventArgs_Cancel] = closing_args_get_Cancel,
+    [ISplitViewPaneClosingEventArgs_SetCancel] = closing_args_put_Cancel,
+};
+
+static void closing_args_destroy( struct xobj *obj )
+{
+    free( CONTAINING_RECORD( obj, struct closing_args, obj ) );
+}
+
+static const struct xiface_entry closing_args_ifaces[] =
+{
+    { &IID_ISplitViewPaneClosingEventArgs, offsetof(struct closing_args, iface) },
+};
+
+static const struct xclass closing_args_class =
+{
+    L"Windows.UI.Xaml.Controls.SplitViewPaneClosingEventArgs", closing_args_ifaces, ARRAY_SIZE(closing_args_ifaces),
+    closing_args_destroy,
+};
+
+static void open_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct splitview *sv = splitview_from_dobj( obj );
+    IInspectable *sender = (IInspectable *)&sv->ISplitView_iface;
+    boolean open = xunbox_boolean( new_value, FALSE );
+
+    TRACE( "%p: pane %s\n", sv, open ? "opens" : "closes" );
+    uielem_invalidate_measure( &sv->c.e );
+    if (sv->reverting) return;
+    if (open)
+    {
+        xaml_raise_routed( &sv->opening, sender, NULL );
+        xaml_raise_routed( &sv->opened, sender, NULL );
+    }
+    else
+    {
+        struct closing_args *args = calloc( 1, sizeof(*args) );
+        BOOL cancel = FALSE;
+
+        if (args)
+        {
+            args->iface.vtbl = closing_args_vtbl;
+            xobj_init( &args->obj, &closing_args_class, NULL );
+            xaml_raise_routed( &sv->closing, sender, (IInspectable *)&args->iface );
+            cancel = args->cancel;
+            IInspectable_Release( (IInspectable *)&args->iface );
+        }
+#ifdef SG_MUTANT_SPLITVIEW_NO_CANCEL
+        cancel = FALSE;
+#endif
+        if (cancel)
+        {
+            sv->reverting = TRUE;
+            put_box( sv, prop_is_open, xbox_boolean( TRUE ) );
+            sv->reverting = FALSE;
+            return;
+        }
+        xaml_raise_routed( &sv->closed, sender, NULL );
+    }
+}
+
+static BOOL WINAPI init_splitviews( INIT_ONCE *once, void *param, void **context )
+{
+    static const WCHAR sv[] = L"Windows.UI.Xaml.Controls.SplitView";
+
+    xaml_controls_init();
+    prop_content = xaml_property_register( sv, L"Content", L"Windows.UI.Xaml.UIElement", NULL, FALSE, content_changed );
+    prop_pane = xaml_property_register( sv, L"Pane", L"Windows.UI.Xaml.UIElement", NULL, FALSE, pane_changed );
+    prop_is_open = xaml_property_register( sv, L"IsPaneOpen", L"Boolean", xbox_boolean( FALSE ), FALSE, open_changed );
+    prop_open_length = xaml_property_register( sv, L"OpenPaneLength", L"Double", xbox_double( 320 ), FALSE, layout_changed );
+    prop_compact_length = xaml_property_register( sv, L"CompactPaneLength", L"Double", xbox_double( 48 ), FALSE, layout_changed );
+    prop_placement = xaml_property_register( sv, L"PanePlacement", L"Windows.UI.Xaml.Controls.SplitViewPanePlacement",
+                                             xbox_int32( 0 ), FALSE, layout_changed );
+    prop_mode = xaml_property_register( sv, L"DisplayMode", L"Windows.UI.Xaml.Controls.SplitViewDisplayMode",
+                                        xbox_int32( MODE_OVERLAY ), FALSE, layout_changed );
+    prop_settings = xaml_property_register( sv, L"TemplateSettings", L"Windows.UI.Xaml.Controls.Primitives.SplitViewTemplateSettings",
+                                            NULL, FALSE, NULL );
+    prop_pane_background = xaml_property_register( sv, L"PaneBackground", L"Windows.UI.Xaml.Media.Brush", NULL, FALSE, layout_changed );
+    prop_dismiss_mode = xaml_property_register( sv, L"LightDismissOverlayMode", L"Windows.UI.Xaml.Controls.LightDismissOverlayMode",
+                                                xbox_int32( 0 ), FALSE, NULL );
+    return TRUE;
+}
+
+static void splitviews_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_splitviews, NULL, NULL );
+}
+
+/* ---- SplitViewTemplateSettings: computed from the SplitView when asked for ---- */
+
+struct template_settings
+{
+    struct xobj obj;
+    struct xiface iface;
+    struct splitview *sv;           /* no reference: NULL once the SplitView is gone */
+};
+
+static struct splitview *settings_sv( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct template_settings, obj )->sv;
+}
+
+static HRESULT settings_double( struct xiface *iface, DOUBLE *value, int which )
+{
+    struct splitview *sv = settings_sv( iface );
+    DOUBLE open, compact;
+
+    if (!value) return E_POINTER;
+    if (!sv) return RO_E_CLOSED;
+    open = get_double( sv, prop_open_length, 320 );
+    compact = get_double( sv, prop_compact_length, 48 );
+    switch (which)
+    {
+    case 0: *value = open; break;
+    case 1: *value = -open; break;
+    case 2: *value = open - compact; break;
+    default: *value = compact - open; break;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI settings_get_OpenPaneLength( struct xiface *iface, DOUBLE *value ) { return settings_double( iface, value, 0 ); }
