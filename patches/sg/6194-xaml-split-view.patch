diff --git a/dlls/windows.ui.xaml/splitview.c b/dlls/windows.ui.xaml/splitview.c
new file mode 100644
index 0000000..4e9ce1d
--- /dev/null
+++ b/dlls/windows.ui.xaml/splitview.c
@@ -0,0 +1,633 @@
+/*
+ * Windows.UI.Xaml.Controls.SplitView
+ *
+ * Copyright 2026 Stained Glass OS
+ *
