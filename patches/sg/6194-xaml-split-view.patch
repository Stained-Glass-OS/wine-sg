+static HRESULT WINAPI settings_get_NegativeOpenPaneLengthMinusCompactLength( struct xiface *iface, DOUBLE *value ) { return settings_double( iface, value, 3 ); }
+
+static HRESULT WINAPI settings_get_OpenPaneGridLength( struct xiface *iface, struct xgrid_length *value )
+{
+    if (!value) return E_POINTER;
+    if (!settings_sv( iface )) return RO_E_CLOSED;
+    value->value = get_double( settings_sv( iface ), prop_open_length, 320 );
+    value->unit = XGRID_PIXEL;
+    return S_OK;
+}
+
+static HRESULT WINAPI settings_get_CompactPaneGridLength( struct xiface *iface, struct xgrid_length *value )
+{
+    if (!value) return E_POINTER;
+    if (!settings_sv( iface )) return RO_E_CLOSED;
+    value->value = get_double( settings_sv( iface ), prop_compact_length, 48 );
+    value->unit = XGRID_PIXEL;
+    return S_OK;
+}
