From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.media.speech: SSML prosody, say-as characters and sub; msttsengine: Volume 0 is silence

SynthesizeSsmlToStreamAsync read SSML down to its text and breaks. Now prosody rate, pitch and volume (named values as Microsoft's SSML documents them, percentages, multiples) become each run's SAPI rate, pitch and volume, say-as characters/spell-out is spelled and sub speaks its alias. msttsengine took a fragment's Volume 0 as full volume; SAPI and the WinRT synthesizer give every fragment its volume, so 0 is silence, as in SAPI.
---
--- a/dlls/windows.media.speech/synthesizer.c
+++ b/dlls/windows.media.speech/synthesizer.c
@@ -1233,23 +1233,146 @@
     return 500;
 }
 
-/* the plain text (entities decoded, tags gone) and its pieces; FALSE for text that is not SSML */
+/* (wine-sg 9805) an attribute's value of a tag (between its quotes), in buf; FALSE when it has none */
+static BOOL ssml_attr( const WCHAR *tag, ULONG len, const WCHAR *name, WCHAR *buf, ULONG size )
+{
+    ULONG n = wcslen(name), i, j, k;
+    WCHAR quote;
+
+    for (i = 1; i + n < len; i++)
+    {
+        if (!iswspace(tag[i - 1]) || wcsnicmp(tag + i, name, n)) continue;
+        for (j = i + n; j < len && iswspace(tag[j]); j++) ;
+        if (j >= len || tag[j] != '=') continue;
+        for (j++; j < len && iswspace(tag[j]); j++) ;
+        if (j >= len || (tag[j] != '"' && tag[j] != '\'')) continue;
+        quote = tag[j++];
+        for (k = 0; j < len && tag[j] != quote && k + 1 < size; ) buf[k++] = tag[j++];
+        buf[k] = 0;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* the text state SSML gives a run: prosody (as SAPI adjustments) and spelling */
+struct ssml_state
+{
+    LONG rate_adj, pitch_adj;
+    USHORT volume;
+    BOOL spell;
+};
+
+/* a relative or absolute value: "+20%", "-3st", "1.5", "+10Hz"; returns the number, sets unit to %, s (st),
+ * h (Hz) or 0 and relative when signed */
+static double ssml_number( const WCHAR *text, WCHAR *unit, BOOL *relative )
+{
+    WCHAR *end;
+    double n;
+
+    while (iswspace(*text)) text++;
+    *relative = *text == '+' || *text == '-';
+    n = wcstod(text, &end);
+    *unit = 0;
+    if (end == text) { *unit = '?'; return 0; }
+    while (iswspace(*end)) end++;
+    if (*end == '%') *unit = '%';
+    else if (!wcsnicmp(end, L"st", 2)) *unit = 's';
+    else if (!wcsnicmp(end, L"hz", 2)) *unit = 'h';
+    return n;
+}
+
+/* <prosody rate pitch volume>, with the named values Microsoft's SSML documents (rate x-slow 0.5, slow 0.64,
+ * medium 1, fast 1.55, x-fast 2; volume silent 0, x-soft 20, soft 40, medium 60, loud 80, x-loud 100;
+ * pitch x-low -50%, low -25%, medium 0, high +25%, x-high +50%). A rate is a multiple of the speed (SAPI's
+ * rate steps are powers of 3^(1/10)); a pitch change of 50% is SAPI's 10 steps, a semitone one step. */
+static void ssml_prosody( const WCHAR *tag, ULONG len, struct ssml_state *state )
+{
+    static const struct { const WCHAR *name; double value; } rates[] =
+    {
+        { L"x-slow", 0.5 }, { L"slow", 0.64 }, { L"medium", 1.0 }, { L"fast", 1.55 }, { L"x-fast", 2.0 }, { L"default", 1.0 },
+    }, volumes[] =
+    {
+        { L"silent", 0 }, { L"x-soft", 20 }, { L"soft", 40 }, { L"medium", 60 }, { L"loud", 80 }, { L"x-loud", 100 },
+        { L"default", 100 },
+    }, pitches[] =
+    {
+        { L"x-low", -50 }, { L"low", -25 }, { L"medium", 0 }, { L"high", 25 }, { L"x-high", 50 }, { L"default", 0 },
+    };
+    WCHAR buf[64], unit;
+    BOOL relative, named;
+    double n;
+    ULONG i;
+
+    if (ssml_attr(tag, len, L"rate", buf, ARRAY_SIZE(buf)))
+    {
+        for (i = 0, named = FALSE; i < ARRAY_SIZE(rates); i++)
+            if (!wcsicmp(buf, rates[i].name)) { n = rates[i].value; named = TRUE; break; }
+        if (!named)
+        {
+            n = ssml_number(buf, &unit, &relative);
+            if (unit == '%') n = 1.0 + n / 100.0;
+            else if (unit) n = 1.0;
+        }
+        if (n > 0.01) state->rate_adj += (LONG)floor(10.0 * log(n) / log(3.0) + 0.5);
+    }
+    if (ssml_attr(tag, len, L"pitch", buf, ARRAY_SIZE(buf)))
+    {
+        for (i = 0, named = FALSE; i < ARRAY_SIZE(pitches); i++)
+            if (!wcsicmp(buf, pitches[i].name)) { n = pitches[i].value; named = TRUE; break; }
+        if (named) state->pitch_adj += (LONG)floor(n / 5.0 + 0.5);
+        else
+        {
+            n = ssml_number(buf, &unit, &relative);
+            if (unit == '%') state->pitch_adj += (LONG)floor(n / 5.0 + 0.5);
+            else if (unit == 's') state->pitch_adj += (LONG)floor(n + 0.5);
+            else if (unit == 'h' && relative) state->pitch_adj += (LONG)floor(n / 10.0 + 0.5);
+        }
+    }
+    if (ssml_attr(tag, len, L"volume", buf, ARRAY_SIZE(buf)))
+    {
+        for (i = 0, named = FALSE; i < ARRAY_SIZE(volumes); i++)
+            if (!wcsicmp(buf, volumes[i].name)) { n = volumes[i].value; named = TRUE; break; }
+        if (!named)
+        {
+            n = ssml_number(buf, &unit, &relative);
+            if (unit == '%') n = state->volume * (1.0 + n / 100.0);
+            else if (unit) n = state->volume;
+            else if (relative) n = state->volume + n;
+        }
+        state->volume = (USHORT)max(0.0, min(100.0, n + 0.5));
+    }
+    state->rate_adj = max(-10, min(10, state->rate_adj));
+    state->pitch_adj = max(-10, min(10, state->pitch_adj));
+}
+
+/* the plain text (entities decoded, tags gone) and its pieces; FALSE for text that is not SSML. Each run of
+ * text is a piece with its state: <prosody>, <say-as interpret-as="characters"> (spelled), <sub alias> (the
+ * alias spoken instead); <break> is a pause; <emphasis>, <voice>, <mark>, <phoneme> keep their text. */
 static BOOL ssml_to_pieces( const WCHAR *ssml, UINT32 len, WCHAR **plain_out, struct ssml_piece **pieces_out, UINT32 *count )
 {
+    struct ssml_state stack[32], *state = stack;
     WCHAR *plain = malloc((len + 1) * sizeof(WCHAR));
-    struct ssml_piece *pieces = malloc((len + 2) * sizeof(*pieces));
-    ULONG n = 0, run = 0, i = 0;
+    struct ssml_piece *pieces = malloc((2 * len + 2) * sizeof(*pieces));
+    ULONG n = 0, run = 0, i = 0, depth = 0, skip_sub = 0;
     BOOL in_speak = FALSE, seen_speak = FALSE;
 
     *count = 0;
+    memset(state, 0, sizeof(*state));
+    state->volume = 100;
     if (!plain || !pieces) goto fail;
+#define FLUSH_RUN() do { if (n > run) { pieces[*count].start = run; pieces[*count].len = n - run; \
+        pieces[*count].is_break = FALSE; pieces[*count].rate_adj = state->rate_adj; \
+        pieces[*count].pitch_adj = state->pitch_adj; pieces[*count].volume = state->volume; \
+        pieces[(*count)++].spell = state->spell; run = n; } } while (0)
     while (i < len)
     {
         if (ssml[i] == '<')
         {
             ULONG end = i;
+            BOOL closing = i + 1 < len && ssml[i + 1] == '/', empty;
             while (end < len && ssml[end] != '>') end++;
             if (end >= len) goto fail;
+            empty = ssml[end - 1] == '/';
             if (!wcsncmp(ssml + i, L"<!--", 4))
             {
                 const WCHAR *close = wcsstr(ssml + i, L"-->");
@@ -1261,24 +1384,62 @@
                 in_speak = seen_speak = TRUE;
             else if (!wcsnicmp(ssml + i, L"</speak", 7))
                 in_speak = FALSE;
+            else if (in_speak && skip_sub)
+            {
+                if (!wcsnicmp(ssml + i, L"</sub", 5)) skip_sub = 0;
+            }
             else if (in_speak && !wcsnicmp(ssml + i, L"<break", 6))
             {
-                if (n > run)
-                {
-                    pieces[*count].start = run;
-                    pieces[*count].len = n - run;
-                    pieces[(*count)++].is_break = FALSE;
-                }
+                FLUSH_RUN();
+                memset(&pieces[*count], 0, sizeof(pieces[*count]));
                 pieces[*count].is_break = TRUE;
+                pieces[*count].volume = 100;
                 pieces[(*count)++].silence = ssml_break_msecs(ssml + i, end - i);
                 run = n;
             }
             else if (in_speak && (!wcsnicmp(ssml + i, L"<p", 2) || !wcsnicmp(ssml + i, L"</p", 3) ||
-                                  !wcsnicmp(ssml + i, L"<s", 2) || !wcsnicmp(ssml + i, L"</s", 3)))
+                                  !wcsnicmp(ssml + i, L"<s", 2) || !wcsnicmp(ssml + i, L"</s", 3)) &&
+                     (iswspace(ssml[i + 2 + closing]) || ssml[i + 2 + closing] == '>' || ssml[i + 2 + closing] == '/'))
             {
                 /* paragraphs and sentences: a word gap */
                 if (n && plain[n - 1] != ' ') plain[n++] = ' ';
             }
+#ifndef SG_MUTANT_SSML_NO_PROSODY
+            else if (in_speak && !closing && !empty && (!wcsnicmp(ssml + i, L"<prosody", 8) || !wcsnicmp(ssml + i, L"<say-as", 7)))
+            {
+                FLUSH_RUN();
+                if (depth + 1 < ARRAY_SIZE(stack))
+                {
+                    WCHAR buf[32];
+                    stack[depth + 1] = *state;
+                    state = &stack[++depth];
+                    if (ssml[i + 1] == 'p' || ssml[i + 1] == 'P') ssml_prosody(ssml + i, end - i, state);
+                    else if (ssml_attr(ssml + i, end - i, L"interpret-as", buf, ARRAY_SIZE(buf)) &&
+                             (!wcsicmp(buf, L"characters") || !wcsicmp(buf, L"spell-out") || !wcsicmp(buf, L"letters")))
+                        state->spell = TRUE;
+                }
+                else depth++;
+            }
+            else if (in_speak && closing && (!wcsnicmp(ssml + i, L"</prosody", 9) || !wcsnicmp(ssml + i, L"</say-as", 8)))
+            {
+                FLUSH_RUN();
+                if (depth)
+                {
+                    depth--;
+                    if (depth + 1 < ARRAY_SIZE(stack)) state = &stack[depth];
+                }
+            }
+            else if (in_speak && !closing && !wcsnicmp(ssml + i, L"<sub", 4) && iswspace(ssml[i + 4]))
+            {
+                WCHAR alias[256];
+                ULONG k;
+                if (ssml_attr(ssml + i, end - i, L"alias", alias, ARRAY_SIZE(alias)))
+                {
+                    for (k = 0; alias[k] && n < len; k++) plain[n++] = alias[k];
+                    if (!empty) skip_sub = 1;
+                }
+            }
+#endif
             i = end + 1;
             continue;
         }
@@ -1288,6 +1449,11 @@
             i++;
             continue;
         }
+        if (skip_sub)
+        {
+            i++;
+            continue;
+        }
         if (ssml[i] == '&')
         {
             static const struct { const WCHAR *name; WCHAR ch; } entities[] =
@@ -1326,12 +1492,8 @@
         plain[n++] = ssml[i++];
     }
     if (!seen_speak) goto fail;
-    if (n > run)
-    {
-        pieces[*count].start = run;
-        pieces[*count].len = n - run;
-        pieces[(*count)++].is_break = FALSE;
-    }
+    FLUSH_RUN();
+#undef FLUSH_RUN
     plain[n] = 0;
     *plain_out = plain;
     *pieces_out = pieces;
@@ -1375,6 +1537,9 @@
         plain_piece.start = 0;
         plain_piece.len = request->len;
         plain_piece.is_break = FALSE;
+        plain_piece.rate_adj = plain_piece.pitch_adj = 0;
+        plain_piece.volume = 100;
+        plain_piece.spell = FALSE;
         pieces = &plain_piece;
         count = request->len ? 1 : 0;
     }
--- a/dlls/windows.media.speech/sapi_engine.c
+++ b/dlls/windows.media.speech/sapi_engine.c
@@ -238,8 +238,9 @@
         {
             frags[i].pNext = i + 1 < count ? &frags[i + 1] : NULL;
             frags[i].State.LangID = langid;
-            frags[i].State.Volume = 100;
-            frags[i].State.PitchAdj.MiddleAdj = pitch;
+            frags[i].State.Volume = pieces[i].volume;
+            frags[i].State.RateAdj = pieces[i].rate_adj;
+            frags[i].State.PitchAdj.MiddleAdj = max(-10, min(10, pitch + pieces[i].pitch_adj));
             if (pieces[i].is_break)
             {
                 frags[i].State.eAction = SPVA_Silence;
@@ -248,7 +249,7 @@
             }
             else
             {
-                frags[i].State.eAction = SPVA_Speak;
+                frags[i].State.eAction = pieces[i].spell ? SPVA_SpellOut : SPVA_Speak;
                 frags[i].pTextStart = plain + pieces[i].start;
                 frags[i].ulTextLen = pieces[i].len;
                 frags[i].ulTextSrcOffset = pieces[i].start;
--- a/dlls/windows.media.speech/sapi_engine.h
+++ b/dlls/windows.media.speech/sapi_engine.h
@@ -29,6 +29,10 @@
     ULONG start, len;   /* in the plain text */
     ULONG silence;      /* a break, in milliseconds */
     BOOL is_break;
+    /* (wine-sg 9805) the run's SSML prosody as SAPI adjustments, and spelling (say-as characters) */
+    LONG rate_adj, pitch_adj;
+    USHORT volume;      /* 0 .. 100 */
+    BOOL spell;
 };
 
 struct sapi_event
--- a/dlls/msttsengine/tts.c
+++ b/dlls/msttsengine/tts.c
@@ -260,7 +260,14 @@
     params.text = (ULONG_PTR)utf8;
     params.text_len = utf8_len;
     params.rate = max(80, min(450, (INT32)(175 * speed)));
+    /* SPVSTATE's Volume 0 is silence (SAPI XML <volume level="0"/>, SSML volume="silent"): SAPI and
+     * Windows.Media.SpeechSynthesis give every fragment its volume, 100 unless the text says otherwise
+     * (wine-sg 9805; it was taken as 100) */
+#ifdef SG_MUTANT_TTS_ZERO_VOLUME_LOUD
     params.volume = (INT32)site_volume * (vstate->Volume ? vstate->Volume : 100) / 100;
+#else
+    params.volume = (INT32)site_volume * min(vstate->Volume, 100) / 100;
+#endif
     params.pitch = max(0, min(99, 50 + vstate->PitchAdj.MiddleAdj * 5));
     params.language = (ULONG_PTR)espeak_language(vstate->LangID ? vstate->LangID : MAKELANGID(LANG_ENGLISH, SUBLANG_ENGLISH_US));
     status = WINE_UNIX_CALL(unix_tts_synth, &params);
