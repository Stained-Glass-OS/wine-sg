From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcrt: _heapmin succeeds when the heap has nothing to give back

msvcrt: _heapmin succeeds when the heap has nothing to give back

HeapCompact returns 0 with no error when there is no free block to
return; _heapmin took that for a failure and returned -1. It now returns 0
unless HeapCompact failed with an error set.
---
--- a/dlls/msvcrt/heap.c
+++ b/dlls/msvcrt/heap.c
@@ -252,13 +252,23 @@ int CDECL _heapchk(void)
   return _HEAPOK;
 }
 
+static BOOL compact_heap_ok(HANDLE h)
+{
+    /* HeapCompact returns 0 without an error when the heap has no free block */
+    SetLastError(NO_ERROR);
+#ifdef SG_MUTANT_HEAPMIN_STRICT
+    return HeapCompact(h, 0);
+#endif
+    return HeapCompact(h, 0) || GetLastError() == NO_ERROR;
+}
+
 /*********************************************************************
  *		_heapmin (MSVCRT.@)
  */
 int CDECL _heapmin(void)
 {
-  if (!HeapCompact( heap, 0 ) ||
-          (sb_heap && !HeapCompact( sb_heap, 0 )))
+  if (!compact_heap_ok( heap ) ||
+          (sb_heap && !compact_heap_ok( sb_heap )))
   {
     if (GetLastError() != ERROR_CALL_NOT_IMPLEMENTED)
       msvcrt_set_errno(GetLastError());
