 #define BCRYPT_CHAIN_MODE_CBC       L"ChainingModeCBC"
@@ -191,6 +197,12 @@ static const WCHAR BCRYPT_SHA1_ALGORITHM[] = {'S','H','A','1',0};
 static const WCHAR BCRYPT_SHA256_ALGORITHM[] = {'S','H','A','2','5','6',0};
 static const WCHAR BCRYPT_SHA384_ALGORITHM[] = {'S','H','A','3','8','4',0};
 static const WCHAR BCRYPT_SHA512_ALGORITHM[] = {'S','H','A','5','1','2',0};
+static const WCHAR BCRYPT_SHA3_256_ALGORITHM[] = {'S','H','A','3','-','2','5','6',0};
+static const WCHAR BCRYPT_SHA3_384_ALGORITHM[] = {'S','H','A','3','-','3','8','4',0};
+static const WCHAR BCRYPT_SHA3_512_ALGORITHM[] = {'S','H','A','3','-','5','1','2',0};
+static const WCHAR BCRYPT_PBKDF2_ALGORITHM[] = {'P','B','K','D','F','2',0};
+static const WCHAR BCRYPT_HKDF_ALGORITHM[] = {'H','K','D','F',0};
+static const WCHAR BCRYPT_SP80056A_CONCAT_ALGORITHM[] = {'S','P','8','0','0','_','5','6','A','_','C','O','N','C','A','T',0};
 
 static const WCHAR BCRYPT_CHAIN_MODE_NA[] = {'C','h','a','i','n','i','n','g','M','o','d','e','N','/','A',0};
 static const WCHAR BCRYPT_CHAIN_MODE_CBC[] = {'C','h','a','i','n','i','n','g','M','o','d','e','C','B','C',0};
@@ -533,6 +545,12 @@ typedef PVOID BCRYPT_SECRET_HANDLE;
 #define BCRYPT_TLS1_2_KDF_ALG_HANDLE        ((BCRYPT_ALG_HANDLE)0x00000371)
 #define BCRYPT_XTS_AES_ALG_HANDLE           ((BCRYPT_ALG_HANDLE)0x00000381)
 #define BCRYPT_HKDF_ALG_HANDLE              ((BCRYPT_ALG_HANDLE)0x00000391)
+#define BCRYPT_SHA3_256_ALG_HANDLE          ((BCRYPT_ALG_HANDLE)0x000003a1)
+#define BCRYPT_SHA3_384_ALG_HANDLE          ((BCRYPT_ALG_HANDLE)0x000003b1)
+#define BCRYPT_SHA3_512_ALG_HANDLE          ((BCRYPT_ALG_HANDLE)0x000003c1)
+#define BCRYPT_HMAC_SHA3_256_ALG_HANDLE     ((BCRYPT_ALG_HANDLE)0x000003d1)
+#define BCRYPT_HMAC_SHA3_384_ALG_HANDLE     ((BCRYPT_ALG_HANDLE)0x000003e1)
+#define BCRYPT_HMAC_SHA3_512_ALG_HANDLE     ((BCRYPT_ALG_HANDLE)0x000003f1)
 
 /* Flags for BCryptGenRandom */
 #define BCRYPT_RNG_USE_ENTROPY_IN_BUFFER 0x00000001
