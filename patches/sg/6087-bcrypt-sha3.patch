From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: SHA3-256, SHA3-384 and SHA3-512

BCryptOpenAlgorithmProvider(SHA3-256/384/512) was not supported (LibreOffice's xmlsec CNG back end asks for
them at start). Our own Keccak-f[1600] sponge written from FIPS 202: hashing, HMAC with the sponge's rate as the
block, the SHA3 and HMAC-SHA3 pseudo-handles, and the HashBlockLength property (for every hash). include: the
SHA3, PBKDF2, HKDF and SP800_56A_CONCAT algorithm names and the SHA3 pseudo-handles.
---
diff --git a/dlls/bcrypt/Makefile.in b/dlls/bcrypt/Makefile.in
index df4de00..1ae190f 100644
--- a/dlls/bcrypt/Makefile.in
+++ b/dlls/bcrypt/Makefile.in
@@ -10,5 +10,6 @@ SOURCES = \
 	gnutls.c \
 	md2.c \
 	sha256.c \
+	sha3.c \
 	sha512.c \
 	version.rc
diff --git a/dlls/bcrypt/bcrypt_internal.h b/dlls/bcrypt/bcrypt_internal.h
index 4938cea..c78a5ca 100644
--- a/dlls/bcrypt/bcrypt_internal.h
+++ b/dlls/bcrypt/bcrypt_internal.h
@@ -54,6 +54,16 @@ void sha512_init(SHA512_CTX *ctx);
 void sha512_update(SHA512_CTX *ctx, const UCHAR *buffer, ULONG len);
 void sha512_finalize(SHA512_CTX *ctx, UCHAR *buffer);
 
+typedef struct
+{
+    ULONG64 st[25];
+    unsigned int rate, pos, outlen;
+} SHA3_CTX;
+
+void sha3_init(SHA3_CTX *ctx, unsigned int bits);
+void sha3_update(SHA3_CTX *ctx, const UCHAR *buffer, ULONG len);
+void sha3_finalize(SHA3_CTX *ctx, UCHAR *buffer);
+
 void sha384_init(SHA512_CTX *ctx);
 #define sha384_update sha512_update
 void sha384_finalize(SHA512_CTX *ctx, UCHAR *buffer);
@@ -127,6 +137,9 @@ enum alg_id
     ALG_ID_MD5,
     ALG_ID_MD4,
     ALG_ID_MD2,
+    ALG_ID_SHA3_256,
+    ALG_ID_SHA3_384,
+    ALG_ID_SHA3_512,
 
     /* asymmetric encryption */
     ALG_ID_RSA,
diff --git a/dlls/bcrypt/bcrypt_main.c b/dlls/bcrypt/bcrypt_main.c
index 361913c..f96242b 100644
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -45,7 +45,7 @@ void WINAPI BCryptFreeBuffer( void *buffer )
 }
 
 #define MAX_HASH_OUTPUT_BYTES 64
-#define MAX_HASH_BLOCK_BITS 1024
+#define MAX_HASH_BLOCK_BITS 1152  /* SHA3-256: a rate of 1088 bits */
 
 /* ordered by class, keep in sync with enum alg_id */
 static const struct
@@ -68,6 +68,10 @@ builtin_algorithms[] =
     {  BCRYPT_MD5_ALGORITHM,        BCRYPT_HASH_INTERFACE,                  274,   16,  512 },
     {  BCRYPT_MD4_ALGORITHM,        BCRYPT_HASH_INTERFACE,                  270,   16,  512 },
     {  BCRYPT_MD2_ALGORITHM,        BCRYPT_HASH_INTERFACE,                  270,   16,  128 },
+    /* SHA-3: the HMAC block is the sponge's rate */
+    {  BCRYPT_SHA3_256_ALGORITHM,   BCRYPT_HASH_INTERFACE,                  512,   32, 1088 },
+    {  BCRYPT_SHA3_384_ALGORITHM,   BCRYPT_HASH_INTERFACE,                  512,   48,  832 },
+    {  BCRYPT_SHA3_512_ALGORITHM,   BCRYPT_HASH_INTERFACE,                  512,   64,  576 },
     {  BCRYPT_RSA_ALGORITHM,        BCRYPT_ASYMMETRIC_ENCRYPTION_INTERFACE, 0,      0,    0 },
     {  BCRYPT_DH_ALGORITHM,         BCRYPT_SECRET_AGREEMENT_INTERFACE,      0,      0,    0 },
     {  BCRYPT_ECDH_P256_ALGORITHM,  BCRYPT_SECRET_AGREEMENT_INTERFACE,      0,      0,    0 },
@@ -203,6 +207,20 @@ static const struct algorithm pseudo_algorithms[] =
     {{ MAGIC_ALG }, ALG_ID_ECDSA_P384 },
     {{ 0 }}, /* ECDSA_P512 */
     {{ MAGIC_ALG }, ALG_ID_RSA_SIGN },
+    {{ 0 }}, /* CAPI_KDF */
+    {{ 0 }}, /* PBKDF2 */
+    {{ 0 }}, /* SP800108_CTR_HMAC */
+    {{ 0 }}, /* SP80056A_CONCAT */
+    {{ 0 }}, /* TLS1_1_KDF */
+    {{ 0 }}, /* TLS1_2_KDF */
+    {{ 0 }}, /* XTS_AES */
+    {{ 0 }}, /* HKDF */
+    {{ MAGIC_ALG }, ALG_ID_SHA3_256 },
+    {{ MAGIC_ALG }, ALG_ID_SHA3_384 },
+    {{ MAGIC_ALG }, ALG_ID_SHA3_512 },
+    {{ MAGIC_ALG }, ALG_ID_SHA3_256, 0, BCRYPT_ALG_HANDLE_HMAC_FLAG },
+    {{ MAGIC_ALG }, ALG_ID_SHA3_384, 0, BCRYPT_ALG_HANDLE_HMAC_FLAG },
+    {{ MAGIC_ALG }, ALG_ID_SHA3_512, 0, BCRYPT_ALG_HANDLE_HMAC_FLAG },
 };
 
 /* Algorithm pseudo-handles are denoted by having the lowest bit set.
@@ -419,6 +437,7 @@ struct hash_impl
         SHA_CTX sha1;
         SHA256_CTX sha256;
         SHA512_CTX sha512;
+        SHA3_CTX sha3;
     } u;
 };
 
@@ -454,6 +473,23 @@ static NTSTATUS hash_init( struct hash_impl *hash, enum alg_id alg_id )
         sha512_init( &hash->u.sha512 );
         break;
 
+    case ALG_ID_SHA3_256:
+        sha3_init( &hash->u.sha3, 256 );
+        break;
+
+    case ALG_ID_SHA3_384:
+        sha3_init( &hash->u.sha3, 384 );
+        break;
+
+    case ALG_ID_SHA3_512:
+#ifndef SG_MUTANT_SHA3_WRONG_RATE
+        sha3_init( &hash->u.sha3, 512 );
+#else
+        sha3_init( &hash->u.sha3, 384 );
+        hash->u.sha3.outlen = 64;
+#endif
+        break;
+
     default:
         ERR( "unhandled id %u\n", alg_id );
         return STATUS_NOT_IMPLEMENTED;
@@ -493,6 +529,12 @@ static NTSTATUS hash_update( struct hash_impl *hash, enum alg_id alg_id, UCHAR *
         sha512_update( &hash->u.sha512, input, size );
         break;
 
+    case ALG_ID_SHA3_256:
+    case ALG_ID_SHA3_384:
+    case ALG_ID_SHA3_512:
+        sha3_update( &hash->u.sha3, input, size );
+        break;
+
     default:
         ERR( "unhandled id %u\n", alg_id );
         return STATUS_NOT_IMPLEMENTED;
@@ -534,6 +576,12 @@ static NTSTATUS hash_finish( struct hash_impl *hash, enum alg_id alg_id, UCHAR *
         sha512_finalize( &hash->u.sha512, output );
         break;
 
+    case ALG_ID_SHA3_256:
+    case ALG_ID_SHA3_384:
+    case ALG_ID_SHA3_512:
+        sha3_finalize( &hash->u.sha3, output );
+        break;
+
     default:
         ERR( "unhandled id %u\n", alg_id );
         return STATUS_NOT_IMPLEMENTED;
@@ -585,6 +633,17 @@ static NTSTATUS generic_alg_property( enum alg_id id, const WCHAR *prop, UCHAR *
         return STATUS_SUCCESS;
     }
 
+    if (!wcscmp( prop, BCRYPT_HASH_BLOCK_LENGTH ) && builtin_algorithms[id].class == BCRYPT_HASH_INTERFACE)
+    {
+        /* the block HMAC pads its key to: 64 or 128 bytes, the sponge's rate for SHA-3 */
+        *ret_size = sizeof(ULONG);
+        if (size < sizeof(ULONG))
+            return STATUS_BUFFER_TOO_SMALL;
+        if (buf)
+            *(ULONG *)buf = builtin_algorithms[id].block_bits / 8;
+        return STATUS_SUCCESS;
+    }
+
     if (!wcscmp( prop, BCRYPT_ALGORITHM_NAME ))
     {
         *ret_size = (lstrlenW(builtin_algorithms[id].name) + 1) * sizeof(WCHAR);
diff --git a/dlls/bcrypt/sha3.c b/dlls/bcrypt/sha3.c
new file mode 100644
index 0000000..705fcc6
--- /dev/null
+++ b/dlls/bcrypt/sha3.c
@@ -0,0 +1,108 @@
+/*
+ * SHA-3 (FIPS 202): Keccak-f[1600] and the SHA3-256/384/512 sponge
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * Written from the FIPS 202 specification: the state is 25 lanes of 64
+ * bits, the round is theta, rho, pi, chi, iota, 24 rounds; SHA3-d uses a
+ * rate of 1600 - 2d bits and the domain padding 01 then pad10*1.
+ */
+
+#include "bcrypt_internal.h"
+
+static const ULONG64 round_constants[24] =
+{
+    0x0000000000000001ull, 0x0000000000008082ull, 0x800000000000808aull, 0x8000000080008000ull,
+    0x000000000000808bull, 0x0000000080000001ull, 0x8000000080008081ull, 0x8000000000008009ull,
+    0x000000000000008aull, 0x0000000000000088ull, 0x0000000080008009ull, 0x000000008000000aull,
+    0x000000008000808bull, 0x800000000000008bull, 0x8000000000008089ull, 0x8000000000008003ull,
+    0x8000000000008002ull, 0x8000000000000080ull, 0x000000000000800aull, 0x800000008000000aull,
+    0x8000000080008081ull, 0x8000000000008080ull, 0x0000000080000001ull, 0x8000000080008008ull,
+};
+
+/* rho offsets, indexed by lane x + 5y */
+static const unsigned int rho[25] =
+{
+     0,  1, 62, 28, 27,
+    36, 44,  6, 55, 20,
+     3, 10, 43, 25, 39,
+    41, 45, 15, 21,  8,
+    18,  2, 61, 56, 14,
+};
+
+static inline ULONG64 rotl( ULONG64 v, unsigned int n )
+{
+    return n ? (v << n) | (v >> (64 - n)) : v;
+}
+
+static void keccak_f( ULONG64 *a )
+{
+    ULONG64 c[5], d[5], b[25];
+    unsigned int round, x, y;
+
+    for (round = 0; round < 24; round++)
+    {
+        /* theta */
+        for (x = 0; x < 5; x++) c[x] = a[x] ^ a[x + 5] ^ a[x + 10] ^ a[x + 15] ^ a[x + 20];
+        for (x = 0; x < 5; x++) d[x] = c[(x + 4) % 5] ^ rotl( c[(x + 1) % 5], 1 );
+        for (y = 0; y < 25; y += 5) for (x = 0; x < 5; x++) a[y + x] ^= d[x];
+        /* rho and pi: B[y][2x+3y] = rot(A[x][y]) */
+        for (y = 0; y < 5; y++)
+            for (x = 0; x < 5; x++)
+                b[y + 5 * ((2 * x + 3 * y) % 5)] = rotl( a[x + 5 * y], rho[x + 5 * y] );
+        /* chi */
+        for (y = 0; y < 25; y += 5)
+            for (x = 0; x < 5; x++)
+                a[y + x] = b[y + x] ^ (~b[y + (x + 1) % 5] & b[y + (x + 2) % 5]);
+        /* iota */
+        a[0] ^= round_constants[round];
+    }
+}
+
+void sha3_init( SHA3_CTX *ctx, unsigned int bits )
+{
+    memset( ctx, 0, sizeof(*ctx) );
+    ctx->outlen = bits / 8;
+    ctx->rate = 200 - 2 * ctx->outlen;
+}
+
+static void absorb_byte( SHA3_CTX *ctx, UCHAR byte )
+{
+    ctx->st[ctx->pos / 8] ^= (ULONG64)byte << (8 * (ctx->pos % 8));
+    if (++ctx->pos == ctx->rate)
+    {
+        keccak_f( ctx->st );
+        ctx->pos = 0;
+    }
+}
+
+void sha3_update( SHA3_CTX *ctx, const UCHAR *buffer, ULONG len )
+{
+    while (len--) absorb_byte( ctx, *buffer++ );
+}
+
+void sha3_finalize( SHA3_CTX *ctx, UCHAR *buffer )
+{
+    unsigned int i;
+
+    /* SHA-3 domain bits 01, then the first and last padding bits */
+    ctx->st[ctx->pos / 8] ^= (ULONG64)0x06 << (8 * (ctx->pos % 8));
+    ctx->st[(ctx->rate - 1) / 8] ^= (ULONG64)0x80 << (8 * ((ctx->rate - 1) % 8));
+    keccak_f( ctx->st );
+    for (i = 0; i < ctx->outlen; i++) buffer[i] = ctx->st[i / 8] >> (8 * (i % 8));
+    memset( ctx, 0, sizeof(*ctx) );
+}
