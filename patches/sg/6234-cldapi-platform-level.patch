From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cldapi: report platform integration 0x500 and implement its always-full and forced-conversion flags

CfGetPlatformInfo reported integration number 0 and revision 0. A sync provider reads the integration number to learn what the cloud files platform can do, and 0 says it can do less than the first Windows 10 release, so a provider such as OneDrive can turn Files On-Demand off. The platform now reports 0x500 and the revision the system is serviced at (UBR), and the capabilities documented for 0x500 are implemented: always-full placeholders (CF_PLACEHOLDER_CREATE_FLAG_ALWAYS_FULL, CF_CONVERT_FLAG_ALWAYS_FULL, CF_UPDATE_FLAG_ALWAYS_FULL; dehydrating one fails with ERROR_CLOUD_FILE_DEHYDRATION_DISALLOWED until CF_UPDATE_FLAG_ALLOW_PARTIAL clears the state, and both flags together are ERROR_CLOUD_FILE_INVALID_REQUEST) and CF_CONVERT_FLAG_FORCE_CONVERT_TO_CLOUD_FILE.
---
diff --git a/dlls/cldapi/main.c b/dlls/cldapi/main.c
index ceda744..1f4a326 100644
--- a/dlls/cldapi/main.c
+++ b/dlls/cldapi/main.c
@@ -235,13 +235,23 @@ typedef struct { LARGE_INTEGER StartingOffset, Length; } CF_FILE_RANGE;
 #define CF_REGISTER_FLAG_UPDATE 0x1
 #define CF_PLACEHOLDER_CREATE_FLAG_MARK_IN_SYNC 0x2
 #define CF_PLACEHOLDER_CREATE_FLAG_SUPERSEDE 0x4
+#define CF_PLACEHOLDER_CREATE_FLAG_ALWAYS_FULL 0x8
 #define CF_CREATE_FLAG_STOP_ON_ERROR 0x1
 #define CF_CONVERT_FLAG_MARK_IN_SYNC 0x1
 #define CF_CONVERT_FLAG_DEHYDRATE 0x2
+#define CF_CONVERT_FLAG_ALWAYS_FULL 0x8
+#define CF_CONVERT_FLAG_FORCE_CONVERT_TO_CLOUD_FILE 0x10
 #define CF_UPDATE_FLAG_MARK_IN_SYNC 0x2
 #define CF_UPDATE_FLAG_DEHYDRATE 0x4
 #define CF_UPDATE_FLAG_REMOVE_FILE_IDENTITY 0x20
 #define CF_UPDATE_FLAG_CLEAR_IN_SYNC 0x40
+#define CF_UPDATE_FLAG_ALWAYS_FULL 0x200
+#define CF_UPDATE_FLAG_ALLOW_PARTIAL 0x400
+
+/* The platform level reported by CfGetPlatformInfo: the always-full placeholder flags and forced
+ * conversion are the capabilities documented for integration number 0x500, and this
+ * implementation has them; CfGetPlaceholderRangeInfoForHydration (0x600) is not here. */
+#define CF_INTEGRATION_NUMBER 0x500
 #define CF_PIN_FLAG_RECURSE 0x1
 #define CF_PIN_FLAG_RECURSE_ONLY 0x2
 
@@ -296,6 +306,7 @@ static BOOL path_under(const WCHAR *root, const WCHAR *path)
 #define META_PLACEHOLDER 0x1
 #define META_IN_SYNC 0x2
 #define META_FULL 0x4
+#define META_ALWAYS_FULL 0x8 /* once hydrated, the file may not be dehydrated */
 
 struct range { LONGLONG start, length; };
 
@@ -599,6 +610,7 @@ static void root_key_name(const WCHAR *provider, const WCHAR *root, WCHAR *name,
 HRESULT WINAPI CfGetPlatformInfo( struct CF_PLATFORM_INFO *info )
 {
     RTL_OSVERSIONINFOEXW ver = { .dwOSVersionInfoSize = sizeof(ver) };
+    DWORD ubr, size;
 
     TRACE( "%p\n", info );
 
@@ -606,7 +618,15 @@ HRESULT WINAPI CfGetPlatformInfo( struct CF_PLATFORM_INFO *info )
     RtlGetVersion( &ver );
     info->BuildNumber = ver.dwBuildNumber;
     info->RevisionNumber = 0;
+    size = sizeof(ubr);
+    if (!RegGetValueW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows NT\\CurrentVersion", L"UBR",
+                       RRF_RT_REG_DWORD, NULL, &ubr, &size ))
+        info->RevisionNumber = ubr; /* the platform is serviced with the system */
+#ifndef SG_MUTANT_CF_INTEGRATION_ZERO
+    info->IntegrationNumber = CF_INTEGRATION_NUMBER;
+#else
     info->IntegrationNumber = 0;
+#endif
     return S_OK;
 }
 
@@ -857,6 +877,7 @@ static HRESULT create_one_placeholder( const WCHAR *base, CF_PLACEHOLDER_CREATE_
     CloseHandle( file );
     meta_init( &meta, info->FileSize.QuadPart, info->FileIdentity, info->FileIdentityLength );
     if (info->Flags & CF_PLACEHOLDER_CREATE_FLAG_MARK_IN_SYNC) meta.flags |= META_IN_SYNC;
+    if (info->Flags & CF_PLACEHOLDER_CREATE_FLAG_ALWAYS_FULL) meta.flags |= META_ALWAYS_FULL;
     if (!info->FileSize.QuadPart) meta.flags |= META_FULL;
     if (!meta_write( path, &meta ))
     {
@@ -917,10 +938,17 @@ HRESULT WINAPI CfConvertToPlaceholder( HANDLE handle, const void *identity, DWOR
     if (!sync_root_for_path( path, root, ARRAY_SIZE(root) )) return HRESULT_FROM_WIN32( ERROR_CLOUD_FILE_NOT_UNDER_SYNC_ROOT );
     if (meta_read( path, &meta )) return S_OK;
     if (!GetFileSizeEx( handle, &size )) return hr_last();
+    /* CF_CONVERT_FLAG_FORCE_CONVERT_TO_CLOUD_FILE converts a file carrying another provider's
+     * reparse data: placeholders here carry none, so a plain conversion is all it needs */
     meta_init( &meta, size.QuadPart, identity, len );
     meta_add_range( &meta, 0, size.QuadPart );
     meta.flags |= META_FULL;
     if (flags & CF_CONVERT_FLAG_MARK_IN_SYNC) meta.flags |= META_IN_SYNC;
+    if ((flags & CF_CONVERT_FLAG_ALWAYS_FULL) && !(GetFileAttributesW( path ) & FILE_ATTRIBUTE_DIRECTORY))
+    {
+        if (flags & CF_CONVERT_FLAG_DEHYDRATE) return HRESULT_FROM_WIN32( ERROR_CLOUD_FILE_DEHYDRATION_DISALLOWED );
+        meta.flags |= META_ALWAYS_FULL;
+    }
     if (flags & CF_CONVERT_FLAG_DEHYDRATE)
     {
         LARGE_INTEGER zero = {{0}};
@@ -946,7 +974,17 @@ HRESULT WINAPI CfUpdatePlaceholder( HANDLE handle, const void *metadata_, const
     TRACE( "%p %p %p %lu %p %lu %#lx %p %p\n", handle, fs, identity, len, ranges, count, flags, usn, overlapped );
 
     if (len > META_MAX_IDENTITY || (len && !identity)) return E_INVALIDARG;
+    if ((flags & (CF_UPDATE_FLAG_ALWAYS_FULL | CF_UPDATE_FLAG_ALLOW_PARTIAL))
+            == (CF_UPDATE_FLAG_ALWAYS_FULL | CF_UPDATE_FLAG_ALLOW_PARTIAL))
+        return HRESULT_FROM_WIN32( ERROR_CLOUD_FILE_INVALID_REQUEST );
     if (FAILED(hr = open_meta( handle, path, &meta ))) return hr;
+    if (flags & CF_UPDATE_FLAG_ALLOW_PARTIAL) meta.flags &= ~META_ALWAYS_FULL;
+    if ((flags & CF_UPDATE_FLAG_ALWAYS_FULL) && !(GetFileAttributesW( path ) & FILE_ATTRIBUTE_DIRECTORY))
+        meta.flags |= META_ALWAYS_FULL;
+#ifndef SG_MUTANT_CF_ALWAYS_FULL_IGNORED
+    if ((flags & CF_UPDATE_FLAG_DEHYDRATE) && (meta.flags & META_ALWAYS_FULL))
+        return HRESULT_FROM_WIN32( ERROR_CLOUD_FILE_DEHYDRATION_DISALLOWED );
+#endif
 
     if (fs)
     {
