From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] user32: GetDataHere and GetCanonicalFormatEtc of the XDnD data object

The drag-and-drop data object copies its data into a caller-provided
HGLOBAL (GetDataHere) and answers GetCanonicalFormatEtc with the input format
(DATA_S_SAMEFORMATETC). CORE: integrator must review (patches/notes/5221.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/user32/clipboard.c b/dlls/user32/clipboard.c
--- a/dlls/user32/clipboard.c
+++ b/dlls/user32/clipboard.c
@@ -875,8 +875,35 @@
 static HRESULT WINAPI data_object_GetDataHere( IDataObject *iface, FORMATETC *format, STGMEDIUM *medium )
 {
     struct data_object *object = data_object_from_IDataObject( iface );
-    FIXME( "object %p, format %p, medium %p stub!\n", object, format, medium );
-    return DATA_E_FORMATETC;
+    struct format_entry *iter;
+    HRESULT hr;
+    SIZE_T size;
+    void *dst;
+
+    TRACE( "object %p, format %p (%s), medium %p\n", object, format, debugstr_format(format->cfFormat), medium );
+
+    /* the caller's medium is filled: only an HGLOBAL, which can not be resized or replaced */
+    if (!medium) return E_INVALIDARG;
+    if (medium->tymed != TYMED_HGLOBAL || !medium->hGlobal) return DV_E_TYMED;
+    if (FAILED(hr = IDataObject_QueryGetData( iface, format ))) return hr;
+
+    for (iter = object->entries; iter < object->entries_end; iter = next_format( iter ))
+    {
+        if (iter->format != format->cfFormat) continue;
+
+        size = GlobalSize( medium->hGlobal );
+#ifdef SG_MUTANT_DATAOBJ_NOSIZE
+        if (0)
+#endif
+        if (!size || size < iter->size) return STG_E_MEDIUMFULL;
+        if (!(dst = GlobalLock( medium->hGlobal ))) return E_OUTOFMEMORY;
+        memcpy( dst, iter->data, iter->size );
+        GlobalUnlock( medium->hGlobal );
+        medium->pUnkForRelease = NULL;
+        return S_OK;
+    }
+
+    return DV_E_FORMATETC;
 }
 
 static HRESULT WINAPI data_object_QueryGetData( IDataObject *iface, FORMATETC *format )
@@ -910,9 +937,27 @@
 static HRESULT WINAPI data_object_GetCanonicalFormatEtc( IDataObject *iface, FORMATETC *format, FORMATETC *out )
 {
     struct data_object *object = data_object_from_IDataObject( iface );
-    FIXME( "object %p, format %p, out %p stub!\n", object, format, out );
+    struct format_entry *iter;
+
+    TRACE( "object %p, format %p (%s), out %p\n", object, format, debugstr_format(format->cfFormat), out );
+
+    if (!out) return E_INVALIDARG;
+
+    /* the data never depends on a target device: the canonical format is the input one without
+     * its device (the tymed is not significant) */
+    for (iter = object->entries; iter < object->entries_end; iter = next_format( iter ))
+    {
+        if (iter->format != format->cfFormat) continue;
+        *out = *format;
+        out->ptd = NULL;
+#ifdef SG_MUTANT_DATAOBJ_CANON_OK
+        return S_OK;
+#endif
+        return DATA_S_SAMEFORMATETC;
+    }
+
     out->ptd = NULL;
-    return E_NOTIMPL;
+    return DV_E_FORMATETC;
 }
 
 static HRESULT WINAPI data_object_SetData( IDataObject *iface, FORMATETC *format, STGMEDIUM *medium, BOOL release )
