From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: known folder manager lookups by path and id list, folder type (3601)

shell32: known folder manager lookups by path and id list, folder type

IKnownFolderManager::FindFolderFromPath finds the known folder at a path
(exact) or the nearest enclosing one; FindFolderFromIDList finds it from an
id list; neither finding one gives S_FALSE and no folder.
IKnownFolder::GetFolderType returns the type id of the folder definition.
---
diff --git a/dlls/shell32/shellpath.c b/dlls/shell32/shellpath.c
index 827a367..928f34d 100644
--- a/dlls/shell32/shellpath.c
+++ b/dlls/shell32/shellpath.c
@@ -4036,10 +4036,19 @@ static HRESULT WINAPI knownfolder_GetFolderType(
     IKnownFolder *iface,
     FOLDERTYPEID *pftid)
 {
-    FIXME("%p\n", pftid);
-    return E_NOTIMPL;
-}
+    KNOWNFOLDER_DEFINITION kfd;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", iface, pftid);
 
+    if (!pftid) return E_INVALIDARG;
+
+    if (FAILED(hr = IKnownFolder_GetFolderDefinition(iface, &kfd)))
+        return hr;
+    *pftid = kfd.ftidType;
+    FreeKnownFolderDefinitionFields(&kfd);
+    return S_OK;
+}
 static HRESULT WINAPI knownfolder_GetRedirectionCapabilities(
     IKnownFolder *iface,
     KF_REDIRECTION_CAPABILITIES *pCapabilities)
@@ -4418,19 +4427,90 @@ static HRESULT WINAPI foldermanager_FindFolderFromPath(
     FFFP_MODE mode,
     IKnownFolder **ppkf)
 {
-    FIXME("%s, 0x%08x, %p\n", debugstr_w(pszPath), mode, ppkf);
-    return E_NOTIMPL;
-}
+    struct foldermanager *fm = impl_from_IKnownFolderManager( iface );
+    WCHAR path[MAX_PATH], folder_path[MAX_PATH];
+    int len, best_len = -1;
+    UINT i, best_i = 0;
+
+    TRACE("%s, 0x%08x, %p\n", debugstr_w(pszPath), mode, ppkf);
 
+    if (!ppkf) return E_INVALIDARG;
+    *ppkf = NULL;
+    if (!pszPath) return E_INVALIDARG;
+    if (mode != FFFP_EXACTMATCH && mode != FFFP_NEARESTPARENTMATCH) return E_INVALIDARG;
+    if (lstrlenW(pszPath) >= MAX_PATH) return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+
+    lstrcpyW(path, pszPath);
+    len = lstrlenW(path);
+    while (len > 3 && path[len - 1] == '\\') path[--len] = 0;
+
+    for (i = 0; i < fm->num_ids; i++)
+    {
+        WCHAR *str;
+        int plen;
+
+        if (FAILED(get_known_folder_path_by_id(&fm->ids[i], NULL, KF_FLAG_DONT_VERIFY, &str)))
+            continue;
+        plen = lstrlenW(str);
+        if (plen < MAX_PATH)
+        {
+            lstrcpyW(folder_path, str);
+            while (plen > 3 && folder_path[plen - 1] == '\\') folder_path[--plen] = 0;
+#ifdef SG_MUTANT_KFM_BOUNDARY
+            if (plen && (plen == len || (mode == FFFP_NEARESTPARENTMATCH && plen < len)) &&
+#else
+            if (plen && (plen == len || (mode == FFFP_NEARESTPARENTMATCH && plen < len &&
+                (path[plen] == '\\' || folder_path[plen - 1] == '\\'))) &&
+#endif
+                !wcsnicmp(path, folder_path, plen) && plen > best_len)
+            {
+                best_len = plen;
+                best_i = i;
+            }
+        }
+        CoTaskMemFree(str);
+        if (best_len == len) break; /* nothing beats an exact match */
+    }
+
+#ifdef SG_MUTANT_KFM_NOMATCH
+    if (best_len < 0) return S_OK;
+#endif
+    if (best_len < 0) return S_FALSE;
+    return IKnownFolderManager_GetFolder(iface, &fm->ids[best_i], ppkf);
+}
 static HRESULT WINAPI foldermanager_FindFolderFromIDList(
     IKnownFolderManager *iface,
     PCIDLIST_ABSOLUTE pidl,
     IKnownFolder **ppkf)
 {
-    FIXME("%p, %p\n", pidl, ppkf);
-    return E_NOTIMPL;
-}
+    struct foldermanager *fm = impl_from_IKnownFolderManager( iface );
+    WCHAR path[MAX_PATH];
+    UINT i;
+
+    TRACE("%p, %p\n", pidl, ppkf);
+
+    if (!ppkf) return E_INVALIDARG;
+    *ppkf = NULL;
+    if (!pidl) return E_INVALIDARG;
 
+    for (i = 0; i < fm->num_ids; i++)
+    {
+        PIDLIST_ABSOLUTE folder_pidl;
+        BOOL equal;
+
+        if (FAILED(SHGetKnownFolderIDList(&fm->ids[i], KF_FLAG_DONT_VERIFY, NULL, &folder_pidl)))
+            continue;
+        equal = ILIsEqual(pidl, folder_pidl);
+        ILFree(folder_pidl);
+        if (equal)
+            return IKnownFolderManager_GetFolder(iface, &fm->ids[i], ppkf);
+    }
+
+    if (SHGetPathFromIDListW(pidl, path))
+        return foldermanager_FindFolderFromPath(iface, path, FFFP_EXACTMATCH, ppkf);
+
+    return S_FALSE;
+}
 static HRESULT WINAPI foldermanager_Redirect(
     IKnownFolderManager *iface,
     REFKNOWNFOLDERID rfid,
