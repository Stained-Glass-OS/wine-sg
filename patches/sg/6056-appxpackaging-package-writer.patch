diff --git a/dlls/appxpackaging/writer.c b/dlls/appxpackaging/writer.c
new file mode 100644
index 0000000..605cebe
--- /dev/null
+++ b/dlls/appxpackaging/writer.c
@@ -0,0 +1,696 @@
