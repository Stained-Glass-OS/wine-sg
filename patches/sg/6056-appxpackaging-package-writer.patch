 HRESULT validated_blockmap_reader_create( IStream *stream, const WCHAR *signature, IAppxBlockMapReader **reader );
 HRESULT read_whole_stream( IStream *stream, SIZE_T max, BYTE **data, SIZE_T *size );
 
