-static HRESULT WINAPI recordset_Save( _Recordset *iface, VARIANT destination, PersistFormatEnum persist_format )
+/* ---- Stained Glass OS (wine-sg 9454): opening a persisted recordset (MSPersist) -------------------
+ *
+ * Recordset.Open of a file (adCmdFile, Provider=MSPersist, or a file name without a connection) or of a
+ * Stream reads what Save wrote in ADO's XML format: the schema's fields, then the rows. Rows inside
+ * rs:insert are rows added and not yet written, rows inside rs:update are changed ones (with their
+ * rs:original values), rows inside rs:delete deleted ones: the changes pending when it was saved, for
+ * UpdateBatch. The recordset is a disconnected, static, client-cursor one with batch updates. */
+
+static const GUID sg_CLSID_DOMDocument30 = {0xf5078f32,0xc551,0x11d3,{0x89,0xb9,0x00,0x00,0xf8,0x1f,0xe2,0x21}};
+static const GUID sg_IID_IXMLDOMDocument = {0x2933bf81,0x7b36,0x11d2,{0xb2,0x0e,0x00,0xc0,0x4f,0x98,0x3e,0x60}};
+static const GUID sg_IID_IXMLDOMNode = {0x2933bf80,0x7b36,0x11d2,{0xb2,0x0e,0x00,0xc0,0x4f,0x98,0x3e,0x60}};
+
+#define XMLNS_S  L"uuid:BDC6E3F0-6DA3-11d1-A2A3-00AA00C14882"
+#define XMLNS_DT L"uuid:C2F41010-65B3-11d1-A29F-00AA00C14882"
+#define XMLNS_RS L"urn:schemas-microsoft-com:rowset"
+
+/* the value of an attribute (namespace, name) of a node, or NULL */
+static BSTR xml_attr( IXMLDOMNode *node, const WCHAR *ns, const WCHAR *name )
+{
+    IXMLDOMNamedNodeMap *map;
+    IXMLDOMNode *attr = NULL;
+    BSTR bname, bns = NULL, text = NULL;
+
+    if (FAILED(IXMLDOMNode_get_attributes( node, &map )) || !map) return NULL;
+    bname = SysAllocString( name );
+    if (ns) bns = SysAllocString( ns );
+    if (ns) IXMLDOMNamedNodeMap_getQualifiedItem( map, bname, bns, &attr );
+    else IXMLDOMNamedNodeMap_getNamedItem( map, bname, &attr );
+    if (attr)
+    {
+        IXMLDOMNode_get_text( attr, &text );
+        IXMLDOMNode_Release( attr );
+    }
+    SysFreeString( bname );
+    SysFreeString( bns );
+    IXMLDOMNamedNodeMap_Release( map );
+    return text;
+}
+
+/* is the node the element (namespace, name) */
+static BOOL xml_is( IXMLDOMNode *node, const WCHAR *ns, const WCHAR *name )
+{
+    DOMNodeType type;
+    BSTR base = NULL, uri = NULL;
+    BOOL ret;
+
+    if (FAILED(IXMLDOMNode_get_nodeType( node, &type )) || type != NODE_ELEMENT) return FALSE;
+    IXMLDOMNode_get_baseName( node, &base );
+    IXMLDOMNode_get_namespaceURI( node, &uri );
+    ret = base && !wcscmp( base, name ) && uri && !wcsicmp( uri, ns );
+    SysFreeString( base );
+    SysFreeString( uri );
+    return ret;
+}
+
+/* the next child element (namespace, name) after prev (or the first), referenced */
+static IXMLDOMNode *xml_next( IXMLDOMNode *parent, IXMLDOMNode *prev, const WCHAR *ns, const WCHAR *name )
+{
+    IXMLDOMNode *node = NULL, *next;
+
+    if (prev) IXMLDOMNode_get_nextSibling( prev, &node );
+    else IXMLDOMNode_get_firstChild( parent, &node );
+    while (node && !xml_is( node, ns, name ))
+    {
+        next = NULL;
+        IXMLDOMNode_get_nextSibling( node, &next );
+        IXMLDOMNode_Release( node );
+        node = next;
+    }
+    return node;
+}
+
+static BOOL xml_true( BSTR text )
+{
+    return text && (!wcsicmp( text, L"true" ) || !wcscmp( text, L"1" ) || !wcscmp( text, L"-1" ));
+}
+
+/* the field type of an XML data type, as ADO's persistence names them */
+static DataTypeEnum persisted_type( const WCHAR *dt, const WCHAR *dbtype, LONG size, BOOL is_long, BOOL fixed )
+{
+    if (!dt) dt = L"string";
+    if (!dbtype) dbtype = L"";
+    if (!wcscmp( dt, L"string" ))
+    {
+        if (!wcsicmp( dbtype, L"str" )) return is_long ? adLongVarChar : fixed ? adChar : adVarChar;
+        return is_long ? adLongVarWChar : fixed ? adWChar : adVarWChar;
+    }
+    if (!wcscmp( dt, L"int" ) || !wcscmp( dt, L"i4" )) return adInteger;
+    if (!wcscmp( dt, L"i1" )) return adTinyInt;
+    if (!wcscmp( dt, L"i2" )) return adSmallInt;
+    if (!wcscmp( dt, L"i8" )) return !wcsicmp( dbtype, L"currency" ) ? adCurrency : adBigInt;
+    if (!wcscmp( dt, L"ui1" )) return adUnsignedTinyInt;
+    if (!wcscmp( dt, L"ui2" )) return adUnsignedSmallInt;
+    if (!wcscmp( dt, L"ui4" )) return adUnsignedInt;
+    if (!wcscmp( dt, L"ui8" )) return adUnsignedBigInt;
+    if (!wcscmp( dt, L"r4" )) return adSingle;
+    if (!wcscmp( dt, L"float" ) || !wcscmp( dt, L"r8" )) return size == 4 ? adSingle : adDouble;
+    if (!wcscmp( dt, L"number" ) || !wcscmp( dt, L"fixed.14.4" ))
+    {
+        if (!wcsicmp( dbtype, L"currency" ) || !wcscmp( dt, L"fixed.14.4" )) return adCurrency;
+        if (!wcsicmp( dbtype, L"decimal" )) return adDecimal;
+        if (!wcsicmp( dbtype, L"varnumeric" )) return adVarNumeric;
+        return adNumeric;
+    }
+    if (!wcscmp( dt, L"dateTime" ) || !wcscmp( dt, L"dateTime.tz" ))
+    {
+        if (!wcsicmp( dbtype, L"timestamp" )) return adDBTimeStamp;
+        if (!wcsicmp( dbtype, L"filetime" )) return adFileTime;
+        return adDate;
+    }
+    if (!wcscmp( dt, L"date" )) return adDBDate;
+    if (!wcscmp( dt, L"time" ) || !wcscmp( dt, L"time.tz" )) return adDBTime;
+    if (!wcscmp( dt, L"boolean" )) return adBoolean;
+    if (!wcscmp( dt, L"uuid" )) return adGUID;
+    if (!wcscmp( dt, L"bin.hex" ) || !wcscmp( dt, L"bin.base64" ))
+        return is_long ? adLongVarBinary : fixed ? adBinary : adVarBinary;
+    return adVarWChar;
+}
+
+/* "YYYY-MM-DDTHH:MM:SS[.fff]", "YYYY-MM-DD" or "HH:MM:SS" */
+static BOOL persisted_date( const WCHAR *text, DATE *date )
+{
+    SYSTEMTIME st = { 1899, 12, 0, 30 };
+    UINT y, mo, d, h = 0, mi = 0, s = 0;
+
+    if (swscanf( text, L"%u-%u-%u", &y, &mo, &d ) == 3)
+    {
+        st.wYear = y; st.wMonth = mo; st.wDay = d;
+        if ((text = wcschr( text, 'T' )) && swscanf( text + 1, L"%u:%u:%u", &h, &mi, &s ) < 2) return FALSE;
+    }
+    else if (swscanf( text, L"%u:%u:%u", &h, &mi, &s ) < 2) return FALSE;
+    st.wHour = h; st.wMinute = mi; st.wSecond = s;
+    return SystemTimeToVariantTime( &st, date );
+}
+
+static HRESULT persisted_value( DataTypeEnum type, BSTR text, VARIANT *value )
+{
+    LCID lcid = MAKELCID( MAKELANGID( LANG_ENGLISH, SUBLANG_ENGLISH_US ), SORT_DEFAULT );
+    VARTYPE vt;
+    VARIANT str;
+    HRESULT hr;
+
+    VariantInit( value );
+    if (!text) { V_VT(value) = VT_NULL; return S_OK; }
+    switch (type)
+    {
+    case adDate: case adDBDate: case adDBTime: case adDBTimeStamp: case adFileTime:
+        V_VT(value) = VT_DATE;
+        if (!persisted_date( text, &V_DATE(value) )) { V_VT(value) = VT_EMPTY; return MAKE_ADO_HRESULT( adErrDataConversion ); }
+        return S_OK;
+    case adBoolean:
+        V_VT(value) = VT_BOOL;
+        V_BOOL(value) = xml_true( text ) ? VARIANT_TRUE : VARIANT_FALSE;
+        return S_OK;
+    case adBinary: case adVarBinary: case adLongVarBinary:
+    {
+        UINT len = SysStringLen( text ) / 2, i;
+        SAFEARRAY *sa = SafeArrayCreateVector( VT_UI1, 0, len );
+        BYTE *bytes;
+
+        if (!sa) return E_OUTOFMEMORY;
+        SafeArrayAccessData( sa, (void **)&bytes );
+        for (i = 0; i < len; i++)
+        {
+            unsigned int b = 0;
+            swscanf( text + 2 * i, L"%2x", &b );
+            bytes[i] = b;
+        }
+        SafeArrayUnaccessData( sa );
+        V_VT(value) = VT_ARRAY | VT_UI1;
+        V_ARRAY(value) = sa;
+        return S_OK;
+    }
+    case adTinyInt: vt = VT_I1; break;
+    case adSmallInt: vt = VT_I2; break;
+    case adInteger: vt = VT_I4; break;
+    case adBigInt: vt = VT_I8; break;
+    case adUnsignedTinyInt: vt = VT_UI1; break;
+    case adUnsignedSmallInt: vt = VT_UI2; break;
+    case adUnsignedInt: vt = VT_UI4; break;
+    case adUnsignedBigInt: vt = VT_UI8; break;
+    case adSingle: vt = VT_R4; break;
+    case adDouble: vt = VT_R8; break;
+    case adCurrency: vt = VT_CY; break;
+    case adNumeric: case adDecimal: case adVarNumeric: vt = VT_DECIMAL; break;
+    default:
+        V_VT(value) = VT_BSTR;
+        return (V_BSTR(value) = SysAllocString( text )) ? S_OK : E_OUTOFMEMORY;
+    }
+    V_VT(&str) = VT_BSTR;
+    V_BSTR(&str) = text;
+    hr = VariantChangeTypeEx( value, &str, lcid, 0, vt );
+    return FAILED(hr) ? MAKE_ADO_HRESULT( adErrDataConversion ) : S_OK;
+}
+
+struct persisted_field
+{
+    BSTR name;      /* the attribute name in the rows */
+    DataTypeEnum type;
+};
+
+/* the values of a z:row: cols variants */
+static HRESULT persisted_row( IXMLDOMNode *row, const struct persisted_field *pf, LONG cols, VARIANT *values )
+{
+    HRESULT hr;
+    LONG c;
+
+    for (c = 0; c < cols; c++)
+    {
+        BSTR text = xml_attr( row, NULL, pf[c].name );
+        hr = persisted_value( pf[c].type, text, &values[c] );
+        SysFreeString( text );
+        if (FAILED(hr)) return hr;
+    }
+    return S_OK;
+}
+
+/* a row appended with the values, and its change state */
+static HRESULT persisted_append( struct recordset *recordset, VARIANT *values, BYTE state, VARIANT *original )
+{
+    LONG cols = get_column_count( recordset ), row = recordset->count;
+    struct row_track *track;
+
+    if (!resize_recordset( recordset, row + 1 )) return E_OUTOFMEMORY;
+    memcpy( recordset->data + row * cols, values, cols * sizeof(*values) );
+    if (state != TRACK_NONE && (track = recordset_row_track( recordset, row )))
+    {
+        track->state = state;
+        track->original = original;
+    }
+    else free_row_values( recordset, original );
+    return S_OK;
+}
+
+static HRESULT persisted_load( struct recordset *recordset, IXMLDOMDocument *doc, LockTypeEnum lock_type )
+{
+    IXMLDOMNode *root = NULL, *schema, *etype, *attr = NULL, *data;
+    IXMLDOMElement *elem = NULL;
+    struct persisted_field *pf = NULL;
+    LONG cols = 0, c;
+    HRESULT hr = S_OK;
+
+    if (FAILED(IXMLDOMDocument_get_documentElement( doc, &elem )) || !elem) return E_FAIL;
+    IXMLDOMElement_QueryInterface( elem, &sg_IID_IXMLDOMNode, (void **)&root );
+    IXMLDOMElement_Release( elem );
+    if (!(schema = xml_next( root, NULL, XMLNS_S, L"Schema" )) ||
+        !(etype = xml_next( schema, NULL, XMLNS_S, L"ElementType" )))
+    {
+        if (schema) IXMLDOMNode_Release( schema );
+        IXMLDOMNode_Release( root );
+        return E_FAIL;   /* "Recordset cannot be created. Source XML is incomplete or invalid." */
+    }
+    IXMLDOMNode_Release( schema );
+
+    if (!recordset->fields && FAILED(hr = fields_create( recordset, &recordset->fields ))) goto done;
+    while (SUCCEEDED(hr) && (attr = xml_next( etype, attr, XMLNS_S, L"AttributeType" )))
+    {
+        IXMLDOMNode *dtype = xml_next( attr, NULL, XMLNS_S, L"datatype" );
+        BSTR name = xml_attr( attr, NULL, L"name" ), shown = xml_attr( attr, XMLNS_RS, L"name" );
+        BSTR dt = NULL, dbtype = NULL, maxlen = NULL, is_long = NULL, fixed = NULL, maybenull = NULL, prec = NULL, scale = NULL;
+        BSTR write = xml_attr( attr, XMLNS_RS, L"write" ), nullable = xml_attr( attr, XMLNS_RS, L"nullable" );
+        struct persisted_field *grown;
+        LONG size, attrs = 0;
+
+        /* the data type is on s:datatype, or on the attribute type itself */
+        IXMLDOMNode *typed = dtype ? dtype : attr;
+        dt = xml_attr( typed, XMLNS_DT, L"type" );
+        maxlen = xml_attr( typed, XMLNS_DT, L"maxLength" );
+        dbtype = xml_attr( typed, XMLNS_RS, L"dbtype" );
+        is_long = xml_attr( typed, XMLNS_RS, L"long" );
+        fixed = xml_attr( typed, XMLNS_RS, L"fixedlength" );
+        maybenull = xml_attr( typed, XMLNS_RS, L"maybenull" );
+        prec = xml_attr( typed, XMLNS_RS, L"precision" );
+        scale = xml_attr( typed, XMLNS_RS, L"scale" );
+        size = maxlen ? wcstol( maxlen, NULL, 10 ) : 0;
+
+        if (!name) hr = E_FAIL;
+        else if (!(grown = realloc( pf, (cols + 1) * sizeof(*pf) ))) hr = E_OUTOFMEMORY;
+        else
+        {
+            pf = grown;
+            pf[cols].name = name;
+            pf[cols].type = persisted_type( dt, dbtype, size, xml_true( is_long ), xml_true( fixed ) );
+            name = NULL;
+            if (!maybenull || xml_true( maybenull )) attrs |= adFldMayBeNull;
+            if (!nullable || xml_true( nullable )) attrs |= adFldIsNullable;
+            if (xml_true( is_long )) attrs |= adFldLong;
+            if (xml_true( fixed )) attrs |= adFldFixed;
+            if (!write || xml_true( write )) attrs |= adFldUpdatable;
+            if (SUCCEEDED(hr = append_field( recordset->fields, shown ? shown : pf[cols].name, pf[cols].type, size,
+                                             attrs, NULL )))
+            {
+                struct field *field = impl_from_Field( recordset->fields->field[cols] );
+                if (prec) field->precision = wcstol( prec, NULL, 10 );
+                if (scale) field->scale = wcstol( scale, NULL, 10 );
+            }
+            cols++;
+        }
+        SysFreeString( name ); SysFreeString( shown ); SysFreeString( dt ); SysFreeString( dbtype );
+        SysFreeString( maxlen ); SysFreeString( is_long ); SysFreeString( fixed ); SysFreeString( maybenull );
+        SysFreeString( prec ); SysFreeString( scale ); SysFreeString( write ); SysFreeString( nullable );
+        if (dtype) IXMLDOMNode_Release( dtype );
+    }
+    if (attr) IXMLDOMNode_Release( attr );
+    IXMLDOMNode_Release( etype );
+    if (FAILED(hr)) goto done;
+
+    if ((data = xml_next( root, NULL, XMLNS_RS, L"data" )))
+    {
+        IXMLDOMNode *child = NULL, *next;
+
+        IXMLDOMNode_get_firstChild( data, &child );
+        for (; child && SUCCEEDED(hr); next = NULL, IXMLDOMNode_get_nextSibling( child, &next ), IXMLDOMNode_Release( child ), child = next)
+        {
+            VARIANT *values, *original = NULL;
+            BOOL insert = xml_is( child, XMLNS_RS, L"insert" ), update = xml_is( child, XMLNS_RS, L"update" );
+
+            if (xml_is( child, L"#RowsetSchema", L"row" ))
+            {
+                if (!(values = calloc( max( cols, 1 ), sizeof(*values) ))) { hr = E_OUTOFMEMORY; break; }
+                if (SUCCEEDED(hr = persisted_row( child, pf, cols, values ))) hr = persisted_append( recordset, values, TRACK_NONE, NULL );
+                free( values );
+            }
+            else if (insert || xml_is( child, XMLNS_RS, L"delete" ))
+            {
+                IXMLDOMNode *row = NULL;
+
+                while (SUCCEEDED(hr) && (row = xml_next( child, row, L"#RowsetSchema", L"row" )))
+                {
+                    if (!(values = calloc( max( cols, 1 ), sizeof(*values) ))) { hr = E_OUTOFMEMORY; break; }
+                    if (FAILED(hr = persisted_row( row, pf, cols, values ))) { free_row_values( recordset, values ); break; }
+                    if (insert)
+                    {
+                        hr = persisted_append( recordset, values, TRACK_ADDED, NULL );
+                        free( values );
+                    }
+                    else
+                    {
+                        /* a deleted row: for UpdateBatch */
+                        VARIANT **grown = realloc( recordset->deleted, (recordset->deleted_count + 1) * sizeof(*grown) );
+                        if (!grown) { free_row_values( recordset, values ); hr = E_OUTOFMEMORY; break; }
+                        recordset->deleted = grown;
+                        recordset->deleted[recordset->deleted_count++] = values;
+                    }
+                }
+                if (row) IXMLDOMNode_Release( row );
+            }
+            else if (update)
+            {
+                /* pairs of <rs:original><z:row (as read)/></rs:original> and <z:row (what changed)/> */
+                IXMLDOMNode *o = NULL;
+
+                while (SUCCEEDED(hr) && (o = xml_next( child, o, XMLNS_RS, L"original" )))
+                {
+                    IXMLDOMNode *orow = xml_next( o, NULL, L"#RowsetSchema", L"row" ), *crow = NULL, *n;
+
+                    IXMLDOMNode_get_nextSibling( o, &crow );
+                    while (crow && !xml_is( crow, L"#RowsetSchema", L"row" ))
+                    {
+                        n = NULL;
+                        IXMLDOMNode_get_nextSibling( crow, &n );
+                        IXMLDOMNode_Release( crow );
+                        crow = n;
+                    }
+                    values = NULL;
+                    if (!orow || !crow) hr = E_FAIL;
+                    else if (!(original = calloc( max( cols, 1 ), sizeof(*original) )) ||
+                             !(values = calloc( max( cols, 1 ), sizeof(*values) ))) hr = E_OUTOFMEMORY;
+                    else if (SUCCEEDED(hr = persisted_row( orow, pf, cols, original )) &&
+                             SUCCEEDED(hr = persisted_row( crow, pf, cols, values )))
+                    {
+                        LONG k;
+
+                        /* the columns the change does not name keep the values they had */
+                        for (k = 0; k < cols; k++)
+                        {
+                            BSTR there = xml_attr( crow, NULL, pf[k].name );
+                            if (!there) { VariantClear( &values[k] ); VariantCopy( &values[k], &original[k] ); }
+                            SysFreeString( there );
+                        }
+                        hr = persisted_append( recordset, values, TRACK_MODIFIED, original );
+                        free( values );
+                        values = original = NULL;
+                    }
+                    free_row_values( recordset, values );
+                    free_row_values( recordset, original );
+                    original = NULL;
+                    if (orow) IXMLDOMNode_Release( orow );
+                    if (crow) IXMLDOMNode_Release( crow );
+                }
+                if (o) IXMLDOMNode_Release( o );
+            }
+        }
+        if (child) IXMLDOMNode_Release( child );
+        IXMLDOMNode_Release( data );
+    }
+
+done:
+    for (c = 0; c < cols; c++) SysFreeString( pf[c].name );
+    free( pf );
+    IXMLDOMNode_Release( root );
+    if (FAILED(hr)) return hr;
+
+    VariantClear( &recordset->active_connection );
+    V_VT(&recordset->active_connection) = VT_DISPATCH;
+    V_DISPATCH(&recordset->active_connection) = NULL;
+    recordset->cursor_location = adUseClient;
+    recordset->cursor_type = adOpenStatic;
+    recordset->lock_type = lock_type == adLockReadOnly ? adLockReadOnly : adLockBatchOptimistic;
+    recordset->index = recordset->count ? 0 : -1;
+    recordset->state = adStateOpen;
+    return S_OK;
+}
+
+/* is this Open one of a persisted recordset: a Stream, a file (adCmdFile or MSPersist), or a file name
+ * given without a connection */
+static BOOL recordset_source_is_persisted( struct recordset *recordset, const VARIANT *source,
+                                           const VARIANT *connection, LONG options )
+{
+    _Stream *stream;
+    DWORD attrs;
+
+    if (V_VT(source) == VT_DISPATCH && V_DISPATCH(source) &&
+        SUCCEEDED(IDispatch_QueryInterface( V_DISPATCH(source), &IID__Stream, (void **)&stream )))
+    {
+        _Stream_Release( stream );
+        return TRUE;
+    }
+    if (V_VT(source) != VT_BSTR || !V_BSTR(source)) return FALSE;
+    if (options != -1 && (options & adCmdFile)) return TRUE;
+    if (V_VT(connection) == VT_BSTR && V_BSTR(connection))
+    {
+        const WCHAR *p;
+        for (p = V_BSTR(connection); *p; p++) if (!wcsnicmp( p, L"MSPersist", 9 )) return TRUE;
+    }
+    if (V_VT(connection) == VT_DISPATCH && V_DISPATCH(connection)) return FALSE;
+    if (V_VT(connection) == VT_BSTR) return FALSE;
+    if (V_VT(&recordset->active_connection) == VT_DISPATCH && V_DISPATCH(&recordset->active_connection)) return FALSE;
+    if (V_VT(&recordset->active_connection) == VT_BSTR) return FALSE;
+    attrs = GetFileAttributesW( V_BSTR(source) );
+    return attrs != INVALID_FILE_ATTRIBUTES && !(attrs & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+static HRESULT recordset_open_persisted( struct recordset *recordset, const VARIANT *source, LockTypeEnum lock_type )
+{
+    IXMLDOMDocument *doc;
+    VARIANT_BOOL ok = VARIANT_FALSE;
+    _Stream *stream;
+    HRESULT hr;
+
+    if (FAILED(hr = CoCreateInstance( &sg_CLSID_DOMDocument30, NULL, CLSCTX_INPROC_SERVER, &sg_IID_IXMLDOMDocument, (void **)&doc )))
+        return hr;
+    IXMLDOMDocument_put_async( doc, VARIANT_FALSE );
+    IXMLDOMDocument_put_resolveExternals( doc, VARIANT_FALSE );
+    IXMLDOMDocument_put_validateOnParse( doc, VARIANT_FALSE );
+
+    if (V_VT(source) == VT_BSTR)
+    {
+        if (GetFileAttributesW( V_BSTR(source) ) == INVALID_FILE_ATTRIBUTES) hr = MAKE_ADO_HRESULT( adErrOpeningFile );
+        else hr = IXMLDOMDocument_load( doc, *source, &ok );
+    }
+    else if (SUCCEEDED(hr = IDispatch_QueryInterface( V_DISPATCH(source), &IID__Stream, (void **)&stream )))
+    {
+        StreamTypeEnum type = adTypeBinary;
+        ADO_LONGPTR pos = 0, size = 0;
+        VARIANT bytes;
+        BSTR text = NULL;
+
+        /* from where the stream is, or from its start when it is at its end (just written) */
+        _Stream_get_Position( stream, &pos );
+        _Stream_get_Size( stream, &size );
+        if (pos >= size) _Stream_put_Position( stream, 0 );
+        _Stream_get_Type( stream, &type );
+        VariantInit( &bytes );
+        if (type == adTypeText)
+        {
+            if (SUCCEEDED(hr = _Stream_ReadText( stream, adReadAll, &text ))) hr = IXMLDOMDocument_loadXML( doc, text, &ok );
+            SysFreeString( text );
+        }
+        else if (SUCCEEDED(hr = _Stream_Read( stream, adReadAll, &bytes )))
+        {
+            hr = IXMLDOMDocument_load( doc, bytes, &ok );
+            VariantClear( &bytes );
+        }
+        _Stream_Release( stream );
+    }
+    if (SUCCEEDED(hr) && !ok) hr = E_FAIL;   /* not XML: "Source XML is incomplete or invalid." */
+    if (SUCCEEDED(hr)) hr = persisted_load( recordset, doc, lock_type );
+    IXMLDOMDocument_Release( doc );
+    if (FAILED(hr)) close_recordset( recordset );
+    return hr;
+}
