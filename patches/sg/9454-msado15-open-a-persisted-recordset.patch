 #include "sqlucode.h"
 
+#include "msxml2.h"
+
 #include "wine/debug.h"
 
 #include "msado15_private.h"
@@ -704,6 +706,11 @@
     if (rs->edit_backup && rs->edit_row == rs->index)
         return VariantCopy( val, &rs->edit_backup[field->index] );
 #endif
+    /* Stained Glass OS (wine-sg 9454): a row changed in a batch (or saved with its change pending) has
+     * the values it was read with */
+    if (rs->track && rs->index >= 0 && rs->index < rs->count && rs->index < rs->track_allocated &&
+        rs->track[rs->index].state == TRACK_MODIFIED && rs->track[rs->index].original)
+        return VariantCopy( val, &rs->track[rs->index].original[field->index] );
     return Field_get_Value( iface, val );
 }
 
@@ -4005,6 +4012,10 @@
     }
 }
 
