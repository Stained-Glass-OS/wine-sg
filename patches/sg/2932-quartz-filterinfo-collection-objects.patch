+#include "quartz_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(quartz);
+
+static ITypeLib *info_typelib;
+
+static HRESULT get_info_typeinfo(REFIID iid, ITypeInfo **ret)
+{
+    HRESULT hr;
+
+    if (!info_typelib)
+    {
+        ITypeLib *typelib;
+
+        if (FAILED(hr = LoadRegTypeLib(&LIBID_QuartzTypeLib, 1, 0, LOCALE_SYSTEM_DEFAULT, &typelib)))
+        {
+            ERR("Failed to load typelib, hr %#lx.\n", hr);
+            return hr;
+        }
+        if (InterlockedCompareExchangePointer((void **)&info_typelib, typelib, NULL))
+            ITypeLib_Release(typelib);
+    }
+    return ITypeLib_GetTypeInfoOfGuid(info_typelib, iid, ret);
+}
+
+void filterinfo_release_typelib(void)
+{
+    if (info_typelib)
+        ITypeLib_Release(info_typelib);
+    info_typelib = NULL;
+}
+
+#define DEFINE_INFO_DISPATCH(prefix, type, iid) \
+static HRESULT WINAPI prefix##_GetTypeInfoCount(type *iface, UINT *count) \
+{ \
+    *count = 1; \
+    return S_OK; \
+} \
+static HRESULT WINAPI prefix##_GetTypeInfo(type *iface, UINT index, LCID lcid, ITypeInfo **typeinfo) \
+{ \
+    if (index) \
+        return DISP_E_BADINDEX; \
+    return get_info_typeinfo(&(iid), typeinfo); \
+} \
+static HRESULT WINAPI prefix##_GetIDsOfNames(type *iface, REFIID riid, LPOLESTR *names, \
+        UINT count, LCID lcid, DISPID *ids) \
+{ \
+    ITypeInfo *typeinfo; \
+    HRESULT hr; \
+    if (SUCCEEDED(hr = get_info_typeinfo(&(iid), &typeinfo))) \
+    { \
+        hr = ITypeInfo_GetIDsOfNames(typeinfo, names, count, ids); \
+        ITypeInfo_Release(typeinfo); \
+    } \
+    return hr; \
+} \
+static HRESULT WINAPI prefix##_Invoke(type *iface, DISPID id, REFIID riid, LCID lcid, WORD flags, \
+        DISPPARAMS *params, VARIANT *result, EXCEPINFO *excepinfo, UINT *error_arg) \
+{ \
+    ITypeInfo *typeinfo; \
+    HRESULT hr; \
+    if (SUCCEEDED(hr = get_info_typeinfo(&(iid), &typeinfo))) \
+    { \
+        hr = ITypeInfo_Invoke(typeinfo, iface, id, flags, params, result, excepinfo, error_arg); \
+        ITypeInfo_Release(typeinfo); \
+    } \
+    return hr; \
+}
+
+/* Object creators, defined below. */
+static HRESULT create_pin_info(IPin *pin, IDispatch **out);
+static HRESULT create_media_type_info(const GUID *major, const GUID *sub, IDispatch **out);
+static HRESULT create_collection(IUnknown **items, LONG count, IDispatch **out);
+
+static BSTR guid_to_bstr(const GUID *guid)
+{
+    WCHAR buffer[40];
+
+    StringFromGUID2(guid, buffer, ARRAY_SIZE(buffer));
+    return SysAllocString(buffer);
+}
+
+/* ---------------------------------------------------------------- IAMCollection */
+
+struct collection
+{
+    IAMCollection IAMCollection_iface;
+    LONG ref;
+    IUnknown **items;
+    LONG count;
+};
+
+static struct collection *impl_from_IAMCollection(IAMCollection *iface)
+{
+    return CONTAINING_RECORD(iface, struct collection, IAMCollection_iface);
+}
+
+static HRESULT WINAPI collection_QueryInterface(IAMCollection *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDispatch)
+            || IsEqualGUID(iid, &IID_IAMCollection))
+    {
+        IAMCollection_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI collection_AddRef(IAMCollection *iface)
+{
+    struct collection *collection = impl_from_IAMCollection(iface);
+    return InterlockedIncrement(&collection->ref);
+}
+
+static ULONG WINAPI collection_Release(IAMCollection *iface)
+{
+    struct collection *collection = impl_from_IAMCollection(iface);
+    ULONG ref = InterlockedDecrement(&collection->ref);
+    LONG i;
+
+    if (!ref)
+    {
+        for (i = 0; i < collection->count; ++i)
+            IUnknown_Release(collection->items[i]);
+        free(collection->items);
+        free(collection);
+    }
+    return ref;
+}
+
+DEFINE_INFO_DISPATCH(collection, IAMCollection, IID_IAMCollection)
+
+static HRESULT WINAPI collection_get_Count(IAMCollection *iface, LONG *count)
+{
+    struct collection *collection = impl_from_IAMCollection(iface);
+
+    TRACE("iface %p, count %p.\n", iface, count);
+
+    if (!count)
+        return E_POINTER;
+#ifdef SG_MUTANT_COLL_COUNT
+    *count = collection->count + 1;
+#else
+    *count = collection->count;
+#endif
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_Item(IAMCollection *iface, LONG index, IUnknown **out)
+{
+    struct collection *collection = impl_from_IAMCollection(iface);
+
+    TRACE("iface %p, index %ld, out %p.\n", iface, index, out);
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    /* Assumption: indices are zero-based. */
+#ifdef SG_MUTANT_COLL_ITEM
+    ++index;
+#endif
+    if (index < 0 || index >= collection->count)
+        return E_INVALIDARG;
+    *out = collection->items[index];
+    IUnknown_AddRef(*out);
+    return S_OK;
+}
+
+struct enum_variant
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+    struct collection *collection;
+    LONG index;
+};
+
+static struct enum_variant *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_variant, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI enum_variant_QueryInterface(IEnumVARIANT *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IEnumVARIANT))
+    {
+        IEnumVARIANT_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_variant_AddRef(IEnumVARIANT *iface)
+{
+    struct enum_variant *e = impl_from_IEnumVARIANT(iface);
+    return InterlockedIncrement(&e->ref);
+}
+
+static ULONG WINAPI enum_variant_Release(IEnumVARIANT *iface)
+{
+    struct enum_variant *e = impl_from_IEnumVARIANT(iface);
+    ULONG ref = InterlockedDecrement(&e->ref);
+
+    if (!ref)
+    {
+        IAMCollection_Release(&e->collection->IAMCollection_iface);
+        free(e);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enum_variant_Next(IEnumVARIANT *iface, ULONG count, VARIANT *vars, ULONG *fetched)
+{
+    struct enum_variant *e = impl_from_IEnumVARIANT(iface);
+    ULONG i = 0;
+
+    TRACE("iface %p, count %lu, vars %p, fetched %p.\n", iface, count, vars, fetched);
+
+    while (i < count && e->index < e->collection->count)
+    {
+        IDispatch *disp;
+
+#ifdef SG_MUTANT_ENUM_SKIP
+        if (!e->index) ++e->index;
+        if (e->index >= e->collection->count) break;
+#endif
+        VariantInit(&vars[i]);
+        if (FAILED(IUnknown_QueryInterface(e->collection->items[e->index], &IID_IDispatch, (void **)&disp)))
+            break;
+        V_VT(&vars[i]) = VT_DISPATCH;
+        V_DISPATCH(&vars[i]) = disp;
+        ++i;
+        ++e->index;
+    }
+    if (fetched)
+        *fetched = i;
+    return i == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_variant_Skip(IEnumVARIANT *iface, ULONG count)
+{
+    struct enum_variant *e = impl_from_IEnumVARIANT(iface);
+
+    e->index += count;
+    if (e->index > e->collection->count)
+    {
+        e->index = e->collection->count;
+        return S_FALSE;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_variant_Reset(IEnumVARIANT *iface)
+{
+    impl_from_IEnumVARIANT(iface)->index = 0;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl enum_variant_vtbl;
+
+static HRESULT WINAPI enum_variant_Clone(IEnumVARIANT *iface, IEnumVARIANT **out)
+{
+    struct enum_variant *e = impl_from_IEnumVARIANT(iface), *clone;
+
+    if (!(clone = calloc(1, sizeof(*clone))))
+        return E_OUTOFMEMORY;
+    clone->IEnumVARIANT_iface.lpVtbl = &enum_variant_vtbl;
+    clone->ref = 1;
+    clone->index = e->index;
+    clone->collection = e->collection;
+    IAMCollection_AddRef(&clone->collection->IAMCollection_iface);
+    *out = &clone->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl enum_variant_vtbl =
+{
+    enum_variant_QueryInterface,
+    enum_variant_AddRef,
+    enum_variant_Release,
+    enum_variant_Next,
+    enum_variant_Skip,
+    enum_variant_Reset,
+    enum_variant_Clone,
+};
+
+static HRESULT WINAPI collection_get__NewEnum(IAMCollection *iface, IUnknown **out)
+{
+    struct collection *collection = impl_from_IAMCollection(iface);
+    struct enum_variant *e;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return E_POINTER;
+    if (!(e = calloc(1, sizeof(*e))))
+        return E_OUTOFMEMORY;
+    e->IEnumVARIANT_iface.lpVtbl = &enum_variant_vtbl;
+    e->ref = 1;
+    e->collection = collection;
+    IAMCollection_AddRef(iface);
+    *out = (IUnknown *)&e->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static const IAMCollectionVtbl collection_vtbl =
+{
+    collection_QueryInterface,
+    collection_AddRef,
+    collection_Release,
+    collection_GetTypeInfoCount,
+    collection_GetTypeInfo,
+    collection_GetIDsOfNames,
+    collection_Invoke,
+    collection_get_Count,
+    collection_Item,
+    collection_get__NewEnum,
+};
+
+/* Takes ownership of the references in items (but not of the array itself on failure). */
+static HRESULT create_collection(IUnknown **items, LONG count, IDispatch **out)
+{
+    struct collection *collection;
+
+    if (!(collection = calloc(1, sizeof(*collection))))
+        return E_OUTOFMEMORY;
+    collection->IAMCollection_iface.lpVtbl = &collection_vtbl;
+    collection->ref = 1;
+    collection->items = items;
+    collection->count = count;
+    *out = (IDispatch *)&collection->IAMCollection_iface;
+    return S_OK;
+}
+
+static void free_items(IUnknown **items, LONG count)
+{
+    LONG i;
+
+    for (i = 0; i < count; ++i)
+        IUnknown_Release(items[i]);
+    free(items);
+}
+
+/* ---------------------------------------------------------------- IMediaTypeInfo */
+
+struct media_type_info
+{
+    IMediaTypeInfo IMediaTypeInfo_iface;
+    LONG ref;
+    GUID major, sub;
+};
+
+static struct media_type_info *impl_from_IMediaTypeInfo(IMediaTypeInfo *iface)
+{
+    return CONTAINING_RECORD(iface, struct media_type_info, IMediaTypeInfo_iface);
+}
+
+static HRESULT WINAPI mt_info_QueryInterface(IMediaTypeInfo *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDispatch)
+            || IsEqualGUID(iid, &IID_IMediaTypeInfo))
+    {
+        IMediaTypeInfo_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI mt_info_AddRef(IMediaTypeInfo *iface)
+{
+    return InterlockedIncrement(&impl_from_IMediaTypeInfo(iface)->ref);
+}
+
+static ULONG WINAPI mt_info_Release(IMediaTypeInfo *iface)
+{
+    struct media_type_info *info = impl_from_IMediaTypeInfo(iface);
+    ULONG ref = InterlockedDecrement(&info->ref);
+
+    if (!ref)
+        free(info);
+    return ref;
+}
+
+DEFINE_INFO_DISPATCH(mt_info, IMediaTypeInfo, IID_IMediaTypeInfo)
+
+static HRESULT WINAPI mt_info_get_Type(IMediaTypeInfo *iface, BSTR *str)
+{
+    struct media_type_info *info = impl_from_IMediaTypeInfo(iface);
+
+    TRACE("iface %p, str %p.\n", iface, str);
+
+    if (!str)
+        return E_POINTER;
+    return (*str = guid_to_bstr(&info->major)) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI mt_info_get_Subtype(IMediaTypeInfo *iface, BSTR *str)
+{
+    struct media_type_info *info = impl_from_IMediaTypeInfo(iface);
+
+    TRACE("iface %p, str %p.\n", iface, str);
+
+    if (!str)
+        return E_POINTER;
+#ifdef SG_MUTANT_MT_SUBTYPE
+    return (*str = guid_to_bstr(&info->major)) ? S_OK : E_OUTOFMEMORY;
+#else
+    return (*str = guid_to_bstr(&info->sub)) ? S_OK : E_OUTOFMEMORY;
+#endif
+}
+
+static const IMediaTypeInfoVtbl mt_info_vtbl =
+{
+    mt_info_QueryInterface,
+    mt_info_AddRef,
+    mt_info_Release,
+    mt_info_GetTypeInfoCount,
+    mt_info_GetTypeInfo,
+    mt_info_GetIDsOfNames,
+    mt_info_Invoke,
+    mt_info_get_Type,
+    mt_info_get_Subtype,
+};
+
+static HRESULT create_media_type_info(const GUID *major, const GUID *sub, IDispatch **out)
+{
+    struct media_type_info *info;
+
+    if (!(info = calloc(1, sizeof(*info))))
+        return E_OUTOFMEMORY;
+    info->IMediaTypeInfo_iface.lpVtbl = &mt_info_vtbl;
+    info->ref = 1;
+    info->major = *major;
+    info->sub = *sub;
+    *out = (IDispatch *)&info->IMediaTypeInfo_iface;
+    return S_OK;
+}
+
+/* ---------------------------------------------------------------- IPinInfo */
+
+struct pin_info
+{
+    IPinInfo IPinInfo_iface;
+    LONG ref;
+    IPin *pin;
+};
+
+static struct pin_info *impl_from_IPinInfo(IPinInfo *iface)
+{
+    return CONTAINING_RECORD(iface, struct pin_info, IPinInfo_iface);
+}
+
+static HRESULT WINAPI pin_info_QueryInterface(IPinInfo *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDispatch)
+            || IsEqualGUID(iid, &IID_IPinInfo))
+    {
+        IPinInfo_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI pin_info_AddRef(IPinInfo *iface)
+{
+    return InterlockedIncrement(&impl_from_IPinInfo(iface)->ref);
+}
+
+static ULONG WINAPI pin_info_Release(IPinInfo *iface)
+{
+    struct pin_info *info = impl_from_IPinInfo(iface);
+    ULONG ref = InterlockedDecrement(&info->ref);
+
+    if (!ref)
+    {
+        IPin_Release(info->pin);
+        free(info);
+    }
+    return ref;
+}
+
+DEFINE_INFO_DISPATCH(pin_info, IPinInfo, IID_IPinInfo)
+
+static HRESULT WINAPI pin_info_get_Pin(IPinInfo *iface, IUnknown **out)
+{
+    struct pin_info *info = impl_from_IPinInfo(iface);
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return E_POINTER;
+    IPin_AddRef(info->pin);
+    *out = (IUnknown *)info->pin;
+    return S_OK;
+}
+
+static HRESULT WINAPI pin_info_get_ConnectedTo(IPinInfo *iface, IDispatch **out)
+{
+    struct pin_info *info = impl_from_IPinInfo(iface);
+    IPin *peer;
+    HRESULT hr;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = IPin_ConnectedTo(info->pin, &peer)))
+        return hr;
+    hr = create_pin_info(peer, out);
+    IPin_Release(peer);
+    return hr;
+}
+
+static HRESULT WINAPI pin_info_get_ConnectionMediaType(IPinInfo *iface, IDispatch **out)
+{
+    struct pin_info *info = impl_from_IPinInfo(iface);
+    AM_MEDIA_TYPE mt;
+    HRESULT hr;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = IPin_ConnectionMediaType(info->pin, &mt)))
+        return hr;
+    hr = create_media_type_info(&mt.majortype, &mt.subtype, out);
+    CoTaskMemFree(mt.pbFormat);
+    if (mt.pUnk)
+        IUnknown_Release(mt.pUnk);
+    return hr;
+}
+
+static HRESULT WINAPI pin_info_get_FilterInfo(IPinInfo *iface, IDispatch **out)
+{
+    struct pin_info *info = impl_from_IPinInfo(iface);
+    PIN_INFO pin_info;
+    HRESULT hr;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = IPin_QueryPinInfo(info->pin, &pin_info)))
+        return hr;
+    if (!pin_info.pFilter)
+        return VFW_E_NOT_FOUND;
+    hr = filterinfo_create(pin_info.pFilter, out);
+    IBaseFilter_Release(pin_info.pFilter);
+    return hr;
+}
+
+static HRESULT WINAPI pin_info_get_Name(IPinInfo *iface, BSTR *name)
+{
+    struct pin_info *info = impl_from_IPinInfo(iface);
+    PIN_INFO pin_info;
+    HRESULT hr;
+
+    TRACE("iface %p, name %p.\n", iface, name);
+
+    if (!name)
+        return E_POINTER;
+    *name = NULL;
+    if (FAILED(hr = IPin_QueryPinInfo(info->pin, &pin_info)))
+        return hr;
+    if (pin_info.pFilter)
+        IBaseFilter_Release(pin_info.pFilter);
+    return (*name = SysAllocString(pin_info.achName)) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI pin_info_get_Direction(IPinInfo *iface, LONG *direction)
+{
+    struct pin_info *info = impl_from_IPinInfo(iface);
+    PIN_DIRECTION dir;
+    HRESULT hr;
+
+    TRACE("iface %p, direction %p.\n", iface, direction);
+
+    if (!direction)
+        return E_POINTER;
+    if (FAILED(hr = IPin_QueryDirection(info->pin, &dir)))
+        return hr;
+#ifdef SG_MUTANT_PIN_DIR
+    dir = !dir;
+#endif
+    *direction = dir;
+    return S_OK;
+}
+
+static HRESULT WINAPI pin_info_get_PinID(IPinInfo *iface, BSTR *id)
+{
+    struct pin_info *info = impl_from_IPinInfo(iface);
+    WCHAR *str;
+    HRESULT hr;
+
+    TRACE("iface %p, id %p.\n", iface, id);
+
+    if (!id)
+        return E_POINTER;
+    *id = NULL;
+    if (FAILED(hr = IPin_QueryId(info->pin, &str)))
+        return hr;
+#ifdef SG_MUTANT_PIN_ID
+    *id = SysAllocString(L"Pin");
+#else
+    *id = SysAllocString(str);
+#endif
+    CoTaskMemFree(str);
+    return *id ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI pin_info_get_MediaTypes(IPinInfo *iface, IDispatch **out)
+{
+    struct pin_info *info = impl_from_IPinInfo(iface);
+    IUnknown **items = NULL;
+    IEnumMediaTypes *enum_mt;
+    AM_MEDIA_TYPE *mt;
+    LONG count = 0, capacity = 0;
+    HRESULT hr;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = IPin_EnumMediaTypes(info->pin, &enum_mt)))
+        return hr;
+
+    while (IEnumMediaTypes_Next(enum_mt, 1, &mt, NULL) == S_OK)
+    {
+        IDispatch *disp;
+
+        hr = create_media_type_info(&mt->majortype, &mt->subtype, &disp);
+        CoTaskMemFree(mt->pbFormat);
+        if (mt->pUnk)
+            IUnknown_Release(mt->pUnk);
+        CoTaskMemFree(mt);
+        if (FAILED(hr))
+            break;
+        if (count == capacity)
+        {
+            IUnknown **new_items = realloc(items, (capacity ? capacity * 2 : 4) * sizeof(*items));
+            if (!new_items)
+            {
+                IDispatch_Release(disp);
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+            items = new_items;
+            capacity = capacity ? capacity * 2 : 4;
+        }
+        items[count++] = (IUnknown *)disp;
+    }
+    IEnumMediaTypes_Release(enum_mt);
+
+    if (SUCCEEDED(hr))
+        hr = create_collection(items, count, out);
+    if (FAILED(hr))
+        free_items(items, count);
+    return hr;
+}
+
+static IFilterGraph *get_pin_graph(IPin *pin)
+{
+    IFilterGraph *graph = NULL;
+    PIN_INFO pin_info;
+    FILTER_INFO filter_info;
+
+    if (FAILED(IPin_QueryPinInfo(pin, &pin_info)) || !pin_info.pFilter)
+        return NULL;
+    if (SUCCEEDED(IBaseFilter_QueryFilterInfo(pin_info.pFilter, &filter_info)))
+        graph = filter_info.pGraph;
+    IBaseFilter_Release(pin_info.pFilter);
+    return graph;
+}
+
+/* Connect two pins, ordering them as (output, input). */
+static HRESULT connect_pins(IPin *self, IUnknown *other_unk, const AM_MEDIA_TYPE *mt, BOOL direct)
+{
+    IFilterGraph *graph;
+    IGraphBuilder *builder;
+    IPin *other, *out_pin, *in_pin;
+    PIN_DIRECTION dir;
+    HRESULT hr;
+
+    if (!other_unk)
+        return E_POINTER;
+    if (FAILED(hr = IUnknown_QueryInterface(other_unk, &IID_IPin, (void **)&other)))
+        return hr;
+    if (!(graph = get_pin_graph(self)))
+    {
+        IPin_Release(other);
+        return VFW_E_NOT_IN_GRAPH;
+    }
+
+    IPin_QueryDirection(self, &dir);
+    out_pin = dir == PINDIR_OUTPUT ? self : other;
+    in_pin = dir == PINDIR_OUTPUT ? other : self;
+
+    if (direct)
+        hr = IFilterGraph_ConnectDirect(graph, out_pin, in_pin, mt);
+    else if (SUCCEEDED(hr = IFilterGraph_QueryInterface(graph, &IID_IGraphBuilder, (void **)&builder)))
+    {
+        hr = IGraphBuilder_Connect(builder, out_pin, in_pin);
+        IGraphBuilder_Release(builder);
+    }
+    IFilterGraph_Release(graph);
+    IPin_Release(other);
+    return hr;
+}
+
+static HRESULT WINAPI pin_info_Connect(IPinInfo *iface, IUnknown *pin)
+{
+    TRACE("iface %p, pin %p.\n", iface, pin);
+    return connect_pins(impl_from_IPinInfo(iface)->pin, pin, NULL, FALSE);
+}
+
+static HRESULT WINAPI pin_info_ConnectDirect(IPinInfo *iface, IUnknown *pin)
+{
+    TRACE("iface %p, pin %p.\n", iface, pin);
+    return connect_pins(impl_from_IPinInfo(iface)->pin, pin, NULL, TRUE);
+}
+
+static HRESULT WINAPI pin_info_ConnectWithType(IPinInfo *iface, IUnknown *pin, IDispatch *type)
+{
+    IMediaTypeInfo *mt_info;
+    AM_MEDIA_TYPE mt = {{0}};
+    BSTR str;
+    HRESULT hr;
+
+    TRACE("iface %p, pin %p, type %p.\n", iface, pin, type);
+
+    if (!type)
+        return connect_pins(impl_from_IPinInfo(iface)->pin, pin, NULL, TRUE);
+
+    if (FAILED(hr = IDispatch_QueryInterface(type, &IID_IMediaTypeInfo, (void **)&mt_info)))
+        return hr;
+    if (SUCCEEDED(hr = IMediaTypeInfo_get_Type(mt_info, &str)))
+    {
+        hr = CLSIDFromString(str, &mt.majortype);
+        SysFreeString(str);
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = IMediaTypeInfo_get_Subtype(mt_info, &str)))
+    {
+        hr = CLSIDFromString(str, &mt.subtype);
+        SysFreeString(str);
+    }
+    IMediaTypeInfo_Release(mt_info);
+    if (FAILED(hr))
+        return hr;
+    return connect_pins(impl_from_IPinInfo(iface)->pin, pin, &mt, TRUE);
+}
+
+static HRESULT WINAPI pin_info_Disconnect(IPinInfo *iface)
+{
+    struct pin_info *info = impl_from_IPinInfo(iface);
+    IFilterGraph *graph;
+    IPin *peer;
+    HRESULT hr;
+
+    TRACE("iface %p.\n", iface);
+
+    if (FAILED(hr = IPin_ConnectedTo(info->pin, &peer)))
+        return hr;
+    if (!(graph = get_pin_graph(info->pin)))
+    {
+        IPin_Release(peer);
+        return VFW_E_NOT_IN_GRAPH;
+    }
+    hr = IFilterGraph_Disconnect(graph, info->pin);
+#ifndef SG_MUTANT_DISCONNECT_PEER
+    if (SUCCEEDED(hr))
+        hr = IFilterGraph_Disconnect(graph, peer);
+#endif
+    IFilterGraph_Release(graph);
+    IPin_Release(peer);
+    return hr;
+}
+
+static HRESULT WINAPI pin_info_Render(IPinInfo *iface)
+{
+    struct pin_info *info = impl_from_IPinInfo(iface);
+    IFilterGraph *graph;
+    IGraphBuilder *builder;
+    HRESULT hr;
+
+    TRACE("iface %p.\n", iface);
+
+    if (!(graph = get_pin_graph(info->pin)))
+        return VFW_E_NOT_IN_GRAPH;
+    if (SUCCEEDED(hr = IFilterGraph_QueryInterface(graph, &IID_IGraphBuilder, (void **)&builder)))
+    {
+        hr = IGraphBuilder_Render(builder, info->pin);
+        IGraphBuilder_Release(builder);
+    }
+    IFilterGraph_Release(graph);
+    return hr;
+}
+
+static const IPinInfoVtbl pin_info_vtbl =
+{
+    pin_info_QueryInterface,
+    pin_info_AddRef,
+    pin_info_Release,
+    pin_info_GetTypeInfoCount,
+    pin_info_GetTypeInfo,
+    pin_info_GetIDsOfNames,
+    pin_info_Invoke,
+    pin_info_get_Pin,
+    pin_info_get_ConnectedTo,
+    pin_info_get_ConnectionMediaType,
+    pin_info_get_FilterInfo,
+    pin_info_get_Name,
+    pin_info_get_Direction,
+    pin_info_get_PinID,
+    pin_info_get_MediaTypes,
+    pin_info_Connect,
+    pin_info_ConnectDirect,
+    pin_info_ConnectWithType,
+    pin_info_Disconnect,
+    pin_info_Render,
+};
+
+static HRESULT create_pin_info(IPin *pin, IDispatch **out)
+{
+    struct pin_info *info;
+
+    if (!(info = calloc(1, sizeof(*info))))
+        return E_OUTOFMEMORY;
+    info->IPinInfo_iface.lpVtbl = &pin_info_vtbl;
+    info->ref = 1;
+    IPin_AddRef(info->pin = pin);
+    *out = (IDispatch *)&info->IPinInfo_iface;
+    return S_OK;
+}
+
+/* ---------------------------------------------------------------- IFilterInfo */
+
+struct filter_info
+{
+    IFilterInfo IFilterInfo_iface;
+    LONG ref;
+    IBaseFilter *filter;
+};
+
+static struct filter_info *impl_from_IFilterInfo(IFilterInfo *iface)
+{
+    return CONTAINING_RECORD(iface, struct filter_info, IFilterInfo_iface);
+}
+
+static HRESULT WINAPI filter_info_QueryInterface(IFilterInfo *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDispatch)
+            || IsEqualGUID(iid, &IID_IFilterInfo))
+    {
+        IFilterInfo_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI filter_info_AddRef(IFilterInfo *iface)
+{
+    return InterlockedIncrement(&impl_from_IFilterInfo(iface)->ref);
+}
+
+static ULONG WINAPI filter_info_Release(IFilterInfo *iface)
+{
+    struct filter_info *info = impl_from_IFilterInfo(iface);
+    ULONG ref = InterlockedDecrement(&info->ref);
+
+    if (!ref)
+    {
+        IBaseFilter_Release(info->filter);
+        free(info);
+    }
+    return ref;
+}
+
+DEFINE_INFO_DISPATCH(filter_info, IFilterInfo, IID_IFilterInfo)
+
+static HRESULT WINAPI filter_info_FindPin(IFilterInfo *iface, BSTR id, IDispatch **out)
+{
+    struct filter_info *info = impl_from_IFilterInfo(iface);
+    IPin *pin;
+    HRESULT hr;
+
+    TRACE("iface %p, id %s, out %p.\n", iface, debugstr_w(id), out);
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = IBaseFilter_FindPin(info->filter, id, &pin)))
+        return hr;
+    hr = create_pin_info(pin, out);
+    IPin_Release(pin);
+    return hr;
+}
+
+static HRESULT WINAPI filter_info_get_Name(IFilterInfo *iface, BSTR *name)
+{
+    struct filter_info *info = impl_from_IFilterInfo(iface);
+    FILTER_INFO filter_info;
+    HRESULT hr;
+
+    TRACE("iface %p, name %p.\n", iface, name);
+
+    if (!name)
+        return E_POINTER;
+    *name = NULL;
+    if (FAILED(hr = IBaseFilter_QueryFilterInfo(info->filter, &filter_info)))
+        return hr;
+    if (filter_info.pGraph)
+        IFilterGraph_Release(filter_info.pGraph);
+    return (*name = SysAllocString(filter_info.achName)) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI filter_info_get_VendorInfo(IFilterInfo *iface, BSTR *vendor)
+{
+    struct filter_info *info = impl_from_IFilterInfo(iface);
+    WCHAR *str = NULL;
+    HRESULT hr;
+
+    TRACE("iface %p, vendor %p.\n", iface, vendor);
+
+    if (!vendor)
+        return E_POINTER;
+    *vendor = NULL;
+    if (FAILED(hr = IBaseFilter_QueryVendorInfo(info->filter, &str)))
+        return hr;
+    if (str)
+    {
+        *vendor = SysAllocString(str);
+        CoTaskMemFree(str);
+        if (!*vendor)
+            return E_OUTOFMEMORY;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI filter_info_get_Filter(IFilterInfo *iface, IUnknown **out)
+{
+    struct filter_info *info = impl_from_IFilterInfo(iface);
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return E_POINTER;
+    IBaseFilter_AddRef(info->filter);
+    *out = (IUnknown *)info->filter;
+    return S_OK;
+}
+
+static HRESULT WINAPI filter_info_get_Pins(IFilterInfo *iface, IDispatch **out)
+{
+    struct filter_info *info = impl_from_IFilterInfo(iface);
+    IUnknown **items = NULL;
+    IEnumPins *enum_pins;
+    IPin *pin;
+    LONG count = 0, capacity = 0;
+    HRESULT hr;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = IBaseFilter_EnumPins(info->filter, &enum_pins)))
+        return hr;
+
+    while (IEnumPins_Next(enum_pins, 1, &pin, NULL) == S_OK)
+    {
+        IDispatch *disp;
+
+        hr = create_pin_info(pin, &disp);
+        IPin_Release(pin);
+        if (FAILED(hr))
+            break;
+        if (count == capacity)
+        {
+            IUnknown **new_items = realloc(items, (capacity ? capacity * 2 : 4) * sizeof(*items));
+            if (!new_items)
+            {
+                IDispatch_Release(disp);
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+            items = new_items;
+            capacity = capacity ? capacity * 2 : 4;
+        }
+        items[count++] = (IUnknown *)disp;
+    }
+    IEnumPins_Release(enum_pins);
+
+    if (SUCCEEDED(hr))
+        hr = create_collection(items, count, out);
+    if (FAILED(hr))
+        free_items(items, count);
+    return hr;
+}
+
+static HRESULT WINAPI filter_info_get_IsFileSource(IFilterInfo *iface, LONG *is_source)
+{
+    struct filter_info *info = impl_from_IFilterInfo(iface);
+    IFileSourceFilter *source;
+
+    TRACE("iface %p, is_source %p.\n", iface, is_source);
+
+    if (!is_source)
+        return E_POINTER;
+    if (SUCCEEDED(IBaseFilter_QueryInterface(info->filter, &IID_IFileSourceFilter, (void **)&source)))
+    {
+        IFileSourceFilter_Release(source);
+#ifdef SG_MUTANT_IS_SOURCE
+        *is_source = 1;
+#else
+        *is_source = -1; /* OATRUE */
+#endif
+    }
+    else
+        *is_source = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI filter_info_get_Filename(IFilterInfo *iface, BSTR *filename)
+{
+    struct filter_info *info = impl_from_IFilterInfo(iface);
+    IFileSourceFilter *source;
+    WCHAR *str = NULL;
+    HRESULT hr;
+
+    TRACE("iface %p, filename %p.\n", iface, filename);
+
+    if (!filename)
+        return E_POINTER;
+    *filename = NULL;
+    if (FAILED(hr = IBaseFilter_QueryInterface(info->filter, &IID_IFileSourceFilter, (void **)&source)))
+        return hr;
+    hr = IFileSourceFilter_GetCurFile(source, &str, NULL);
+    IFileSourceFilter_Release(source);
+    if (FAILED(hr))
+        return hr;
+    if (str)
+    {
+        *filename = SysAllocString(str);
+        CoTaskMemFree(str);
+        if (!*filename)
+            return E_OUTOFMEMORY;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI filter_info_put_Filename(IFilterInfo *iface, BSTR filename)
+{
+    struct filter_info *info = impl_from_IFilterInfo(iface);
+    IFileSourceFilter *source;
+    HRESULT hr;
+
+    TRACE("iface %p, filename %s.\n", iface, debugstr_w(filename));
+
+    if (FAILED(hr = IBaseFilter_QueryInterface(info->filter, &IID_IFileSourceFilter, (void **)&source)))
+        return hr;
+#ifdef SG_MUTANT_PUT_FILENAME
+    hr = S_OK;
+#else
+    hr = IFileSourceFilter_Load(source, filename, NULL);
+#endif
+    IFileSourceFilter_Release(source);
+    return hr;
+}
+
+static const IFilterInfoVtbl filter_info_vtbl =
+{
+    filter_info_QueryInterface,
+    filter_info_AddRef,
+    filter_info_Release,
+    filter_info_GetTypeInfoCount,
+    filter_info_GetTypeInfo,
+    filter_info_GetIDsOfNames,
+    filter_info_Invoke,
+    filter_info_FindPin,
+    filter_info_get_Name,
+    filter_info_get_VendorInfo,
+    filter_info_get_Filter,
+    filter_info_get_Pins,
+    filter_info_get_IsFileSource,
+    filter_info_get_Filename,
+    filter_info_put_Filename,
+};
+
+HRESULT filterinfo_create(IBaseFilter *filter, IDispatch **out)
+{
+    struct filter_info *info;
+
+    if (!(info = calloc(1, sizeof(*info))))
+        return E_OUTOFMEMORY;
+    info->IFilterInfo_iface.lpVtbl = &filter_info_vtbl;
+    info->ref = 1;
+    IBaseFilter_AddRef(info->filter = filter);
+    *out = (IDispatch *)&info->IFilterInfo_iface;
+    return S_OK;
+}
+
+HRESULT filterinfo_create_filter_collection(IFilterGraph2 *graph, IDispatch **out)
+{
+    IUnknown **items = NULL;
+    IEnumFilters *enum_filters;
+    IBaseFilter *filter;
+    LONG count = 0, capacity = 0;
+    HRESULT hr;
+
+    if (FAILED(hr = IFilterGraph2_EnumFilters(graph, &enum_filters)))
+        return hr;
+
+    while (IEnumFilters_Next(enum_filters, 1, &filter, NULL) == S_OK)
+    {
+        IDispatch *disp;
+
+        hr = filterinfo_create(filter, &disp);
+        IBaseFilter_Release(filter);
+        if (FAILED(hr))
+            break;
+        if (count == capacity)
+        {
+            IUnknown **new_items = realloc(items, (capacity ? capacity * 2 : 4) * sizeof(*items));
+            if (!new_items)
+            {
+                IDispatch_Release(disp);
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+            items = new_items;
+            capacity = capacity ? capacity * 2 : 4;
+        }
+        items[count++] = (IUnknown *)disp;
+    }
+    IEnumFilters_Release(enum_filters);
+
+    if (SUCCEEDED(hr))
+        hr = create_collection(items, count, out);
+    if (FAILED(hr))
+        free_items(items, count);
+    return hr;
+}
