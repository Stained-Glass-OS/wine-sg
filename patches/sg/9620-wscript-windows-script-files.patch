From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wscript, cscript: Windows Script Files (.wsf) run (9620)

cscript and wscript ran nothing for a .wsf (no engine is registered for the
extension; the host gave up silently). Windows Script Host's job files are
now read: <package> of <job id> (or one <job>), //job:id picks a job, else
the first; <script language="..." [src="..."]> blocks run in document order,
each in its language's engine, and every engine sees the others' globals, so
a VBScript block calls a JScript block's functions and reads its variables;
<object id progid|classid> are named objects; <reference object|guid
[version]> loads a type library's constants (for a class without a TypeLib
key, its server's type library); errors name the line in the .wsf. As WSH
does, a file without an <?xml?> declaration is read leniently (code as it is),
with one entities are decoded outside CDATA sections.
---
--- a/programs/wscript/main.c
+++ b/programs/wscript/main.c
@@ -53,6 +53,8 @@
 ITypeInfo *arguments_ti;
 
 static HRESULT query_interface(REFIID,void**);
+static HRESULT wsf_item_info(const WCHAR *name, DWORD mask, IUnknown **unk, ITypeInfo **ti);
+static const WCHAR *wsf_job_id;
 
 static HRESULT WINAPI ActiveScriptSite_QueryInterface(IActiveScriptSite *iface,
                                                       REFIID riid, void **ppv)
@@ -84,7 +86,7 @@
     WINE_TRACE("(%s %lx %p %p)\n", wine_dbgstr_w(pstrName), dwReturnMask, ppunkItem, ppti);
 
     if(lstrcmpW(pstrName, L"WSH") && lstrcmpW(pstrName, L"WScript"))
-        return E_FAIL;
+        return wsf_item_info(pstrName, dwReturnMask, ppunkItem, ppti);
 
     if(dwReturnMask & SCRIPTINFO_ITYPEINFO) {
         ITypeInfo_AddRef(host_ti);
@@ -423,6 +425,501 @@
     }
 }
 
+/* Windows Script Files (.wsf, Stained Glass OS, wine-sg 9620): an XML-ish file of jobs
+ * (<package><job id="...">...</job></package>, or one <job>) whose <script language="..."
+ * [src="..."]> blocks run in document order, each in the engine of its language, every engine
+ * seeing the others' globals (a VBScript block calls a JScript block's function);
+ * <object id="..." progid|classid="..."/> are named objects, <reference object|guid="..."/>
+ * load a type library's constants. //job:id picks a job, else the first. As Windows Script
+ * Host does, a file without an <?xml?> declaration is read leniently (script text as it is);
+ * with one, entities are decoded outside CDATA sections. */
+
+struct wsf_object { WCHAR *id; IUnknown *unk; };
+struct wsf_engine { WCHAR *lang; IActiveScript *script; IActiveScriptParse *parser; };
+
+static struct wsf_object *wsf_objects;
+static unsigned wsf_object_count;
+static struct wsf_engine *wsf_engines;
+static unsigned wsf_engine_count;
+
+static HRESULT wsf_item_info(const WCHAR *name, DWORD mask, IUnknown **unk, ITypeInfo **ti)
+{
+    unsigned i;
+
+    for(i = 0; i < wsf_object_count; i++) {
+        if(wcsicmp(name, wsf_objects[i].id))
+            continue;
+        if(mask & SCRIPTINFO_ITYPEINFO) {
+            IProvideClassInfo *pci;
+            *ti = NULL;
+            if(SUCCEEDED(IUnknown_QueryInterface(wsf_objects[i].unk, &IID_IProvideClassInfo, (void **)&pci))) {
+                IProvideClassInfo_GetClassInfo(pci, ti);
+                IProvideClassInfo_Release(pci);
+            }
+            if(!*ti) return TYPE_E_ELEMENTNOTFOUND;
+        }
+        if(mask & SCRIPTINFO_IUNKNOWN) {
+            IUnknown_AddRef(wsf_objects[i].unk);
+            *unk = wsf_objects[i].unk;
+        }
+        return S_OK;
+    }
+    if(!wcsncmp(name, L"SG.wsf.engine.", 14)) {
+        unsigned n = wcstoul(name + 14, NULL, 10);
+        IDispatch *disp;
+
+        if(n >= wsf_engine_count || (mask & SCRIPTINFO_ITYPEINFO))
+            return TYPE_E_ELEMENTNOTFOUND;
+        if(FAILED(IActiveScript_GetScriptDispatch(wsf_engines[n].script, NULL, &disp)))
+            return E_FAIL;
+        *unk = (IUnknown *)disp;
+        return S_OK;
+    }
+    return E_FAIL;
+}
+
+/* the value of attribute name in the tag text [tag, end) */
+static WCHAR *wsf_attr(const WCHAR *tag, const WCHAR *end, const WCHAR *name)
+{
+    size_t len = wcslen(name);
+    const WCHAR *p = tag;
+
+    while(p < end && !iswspace(*p) && *p != '>' && *p != '/') p++; /* the tag name */
+    while(p < end) {
+        const WCHAR *n, *v;
+        WCHAR q;
+
+        while(p < end && (iswspace(*p) || *p == '/')) p++;
+        if(p >= end || *p == '>' || *p == '?') break;
+        n = p;
+        while(p < end && *p != '=' && !iswspace(*p) && *p != '>') p++;
+        if((size_t)(p - n) == len && !wcsnicmp(n, name, len)) {
+            while(p < end && iswspace(*p)) p++;
+            if(p >= end || *p != '=') return NULL;
+            p++;
+            while(p < end && iswspace(*p)) p++;
+            q = (*p == '"' || *p == '\'') ? *p++ : 0;
+            v = p;
+            while(p < end && (q ? *p != q : (!iswspace(*p) && *p != '>'))) p++;
+            {
+                WCHAR *ret = malloc((p - v + 1) * sizeof(WCHAR));
+                if(ret) { memcpy(ret, v, (p - v) * sizeof(WCHAR)); ret[p - v] = 0; }
+                return ret;
+            }
+        }
+        while(p < end && iswspace(*p)) p++;
+        if(p < end && *p == '=') {
+            p++;
+            while(p < end && iswspace(*p)) p++;
+            if(p < end && (*p == '"' || *p == '\'')) {
+                WCHAR q2 = *p++;
+                while(p < end && *p != q2) p++;
+                if(p < end) p++;
+            }else {
+                while(p < end && !iswspace(*p) && *p != '>') p++;
+            }
+        }
+    }
+    return NULL;
+}
+
+/* finds the next tag named name (case insensitive, "<name" then a space, '>' or '/') at or after p */
+static const WCHAR *wsf_find_tag(const WCHAR *p, const WCHAR *end, const WCHAR *name)
+{
+    size_t len = wcslen(name);
+
+    for(; p + len + 1 < end; p++) {
+        if(p[0] == '<' && p[1] == '!' && p[2] == '-' && p[3] == '-') {
+            const WCHAR *c = wcsstr(p + 4, L"-->");
+            if(!c || c >= end) return NULL;
+            p = c + 2;
+            continue;
+        }
+        if(p[0] != '<' || wcsnicmp(p + 1, name, len)) continue;
+        if(iswspace(p[len + 1]) || p[len + 1] == '>' || p[len + 1] == '/') return p;
+    }
+    return NULL;
+}
+
+static const WCHAR *wsf_find_close(const WCHAR *p, const WCHAR *end, const WCHAR *name)
+{
+    size_t len = wcslen(name);
+
+    for(; p + len + 2 < end; p++) {
+        if(p[0] == '<' && p[1] == '!' && !wcsncmp(p, L"<![CDATA[", 9)) {
+            const WCHAR *c = wcsstr(p + 9, L"]]>");
+            if(!c || c >= end) return NULL;
+            p = c + 2;
+            continue;
+        }
+        if(p[0] == '<' && p[1] == '/' && !wcsnicmp(p + 2, name, len) && (p[len + 2] == '>' || iswspace(p[len + 2])))
+            return p;
+    }
+    return NULL;
+}
+
+static const WCHAR *wsf_tag_end(const WCHAR *p, const WCHAR *end)
+{
+    WCHAR q = 0;
+
+    for(; p < end; p++) {
+        if(q) { if(*p == q) q = 0; }
+        else if(*p == '"' || *p == '\'') q = *p;
+        else if(*p == '>') return p;
+    }
+    return NULL;
+}
+
+/* the text of a script element: CDATA sections as they are; in strict (XML) files entities
+ * decoded outside them */
+static WCHAR *wsf_text(const WCHAR *p, const WCHAR *end, BOOL strict)
+{
+    WCHAR *ret = malloc((end - p + 1) * sizeof(WCHAR)), *o = ret;
+
+    if(!ret) return NULL;
+    while(p < end) {
+        if(!wcsncmp(p, L"<![CDATA[", 9)) {
+            const WCHAR *c = wcsstr(p + 9, L"]]>");
+            if(!c || c > end) c = end;
+            memcpy(o, p + 9, (c - p - 9) * sizeof(WCHAR));
+            o += c - p - 9;
+            p = c < end ? c + 3 : end;
+            continue;
+        }
+        if(strict && *p == '&') {
+            static const struct { const WCHAR *ent; WCHAR c; } ents[] = {
+                { L"&lt;", '<' }, { L"&gt;", '>' }, { L"&amp;", '&' }, { L"&quot;", '"' }, { L"&apos;", '\'' } };
+            unsigned i;
+            for(i = 0; i < ARRAY_SIZE(ents); i++)
+                if(!wcsncmp(p, ents[i].ent, wcslen(ents[i].ent))) break;
+            if(i < ARRAY_SIZE(ents)) {
+                *o++ = ents[i].c;
+                p += wcslen(ents[i].ent);
+                continue;
+            }
+            if(p[1] == '#') {
+                WCHAR *e;
+                unsigned long v = p[2] == 'x' ? wcstoul(p + 3, &e, 16) : wcstoul(p + 2, &e, 10);
+                if(*e == ';' && v && v < 0x10000) {
+                    *o++ = v;
+                    p = e + 1;
+                    continue;
+                }
+            }
+        }
+        *o++ = *p++;
+    }
+    *o = 0;
+    return ret;
+}
+
+static struct wsf_engine *wsf_engine(const WCHAR *lang)
+{
+    struct wsf_engine *e;
+    CLSID clsid;
+    unsigned i;
+
+    for(i = 0; i < wsf_engine_count; i++)
+        if(!wcsicmp(wsf_engines[i].lang, lang)) return &wsf_engines[i];
+    if(FAILED(CLSIDFromProgID(lang, &clsid))) {
+        if(wcsicmp(lang, L"JavaScript") || FAILED(CLSIDFromProgID(L"JScript", &clsid))) return NULL;
+    }
+    if(!(e = realloc(wsf_engines, (wsf_engine_count + 1) * sizeof(*e)))) return NULL;
+    wsf_engines = e;
+    e = &wsf_engines[wsf_engine_count];
+    if(!create_engine(&clsid, &e->script, &e->parser)) return NULL;
+    if(!init_engine(e->script, e->parser)) {
+        IActiveScriptParse_Release(e->parser);
+        IActiveScript_Release(e->script);
+        return NULL;
+    }
+    e->lang = wcsdup(lang);
+    wsf_engine_count++;
+    return e;
+}
+
+/* the script file's text for <script src="...">, relative to the .wsf's folder */
+static BSTR wsf_src(const WCHAR *src)
+{
+    WCHAR path[MAX_PATH], *slash;
+
+    if(!(src[0] && src[1] == ':') && src[0] != '\\' && src[0] != '/') {
+        lstrcpynW(path, scriptFullName, ARRAY_SIZE(path));
+        if((slash = wcsrchr(path, '\\'))) slash[1] = 0;
+        if(wcslen(path) + wcslen(src) >= ARRAY_SIZE(path)) return NULL;
+        wcscat(path, src);
+    }else {
+        lstrcpynW(path, src, ARRAY_SIZE(path));
+    }
+    return get_script_str(path);
+}
+
+static void wsf_reference(const WCHAR *tag, const WCHAR *tag_end)
+{
+    WCHAR *object = wsf_attr(tag, tag_end, L"object"), *guid = wsf_attr(tag, tag_end, L"guid");
+    WCHAR *version = wsf_attr(tag, tag_end, L"version"), key[96], buf[64];
+    DWORD major = 0, minor = 0, size;
+    GUID libid;
+    CLSID clsid;
+    unsigned i;
+    HKEY hkey;
+    BOOL ok = FALSE;
+
+    if(object && SUCCEEDED(CLSIDFromProgID(object, &clsid))) {
+        StringFromGUID2(&clsid, buf, ARRAY_SIZE(buf));
+        swprintf(key, ARRAY_SIZE(key), L"CLSID\\%s\\TypeLib", buf);
+        size = sizeof(buf);
+        if(!RegGetValueW(HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ, NULL, buf, &size)) {
+            ok = SUCCEEDED(CLSIDFromString(buf, &libid));
+        }else {
+            /* a class without a TypeLib key: the type library of its server */
+            WCHAR path[MAX_PATH];
+            ITypeLib *tl;
+            TLIBATTR *attr;
+
+            StringFromGUID2(&clsid, buf, ARRAY_SIZE(buf));
+            swprintf(key, ARRAY_SIZE(key), L"CLSID\\%s\\InprocServer32", buf);
+            size = sizeof(path);
+            if(!RegGetValueW(HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ, NULL, path, &size) &&
+               SUCCEEDED(LoadTypeLibEx(path, REGKIND_NONE, &tl))) {
+                if(SUCCEEDED(ITypeLib_GetLibAttr(tl, &attr))) {
+                    libid = attr->guid;
+                    if(!version) {
+                        major = attr->wMajorVerNum;
+                        minor = attr->wMinorVerNum;
+                        ok = TRUE;
+                    }
+                    ITypeLib_ReleaseTLibAttr(tl, attr);
+                }
+                ITypeLib_Release(tl);
+                if(ok) goto add;
+                ok = TRUE;
+            }
+        }
+    }else if(guid) {
+        ok = SUCCEEDED(CLSIDFromString(guid, &libid));
+    }
+    if(ok && version) {
+        swscanf(version, L"%lu.%lu", &major, &minor);
+    }else if(ok) {
+        /* the highest version registered */
+        StringFromGUID2(&libid, buf, ARRAY_SIZE(buf));
+        swprintf(key, ARRAY_SIZE(key), L"TypeLib\\%s", buf);
+        if(!RegOpenKeyExW(HKEY_CLASSES_ROOT, key, 0, KEY_READ, &hkey)) {
+            WCHAR name[32];
+            for(i = 0; size = ARRAY_SIZE(name), !RegEnumKeyExW(hkey, i, name, &size, NULL, NULL, NULL, NULL); i++) {
+                DWORD ma = 0, mi = 0;
+                if(swscanf(name, L"%lx.%lx", &ma, &mi) >= 1 && (ma > major || (ma == major && mi > minor))) {
+                    major = ma;
+                    minor = mi;
+                }
+            }
+            RegCloseKey(hkey);
+        }
+    }
+add:
+    if(ok) {
+        for(i = 0; i < wsf_engine_count; i++)
+            IActiveScript_AddTypeLib(wsf_engines[i].script, &libid, major, minor, 0);
+    }else {
+        WINE_WARN("reference %s %s not found\n", debugstr_w(object), debugstr_w(guid));
+    }
+    free(object);
+    free(guid);
+    free(version);
+}
+
+static void run_wsf(const WCHAR *filename)
+{
+    const WCHAR *text, *end, *job, *job_end, *p;
+    unsigned i, j, line;
+    BOOL strict;
+    BSTR file;
+    struct { const WCHAR *tag, *tag_end, *body, *body_end; int kind; } *items = NULL;
+    unsigned item_count = 0;
+
+    if(!(file = get_script_str(filename))) {
+        WCHAR msg[MAX_PATH + 64];
+        swprintf(msg, ARRAY_SIZE(msg), L"Input Error: Can not find script file \"%ls\".", scriptFullName);
+        report_host_error(msg);
+        return;
+    }
+    text = file;
+    end = text + SysStringLen(file);
+    p = text;
+    while(p < end && iswspace(*p)) p++;
+    strict = !wcsncmp(p, L"<?xml", 5);
+
+    /* the job: by //job:id, else the first */
+    for(job = wsf_find_tag(text, end, L"job"); job; job = wsf_find_tag(job + 4, end, L"job")) {
+        const WCHAR *te = wsf_tag_end(job, end);
+        WCHAR *id;
+        BOOL match;
+
+        if(!te) { job = NULL; break; }
+        if(!wsf_job_id) break;
+        id = wsf_attr(job, te, L"id");
+        match = id && !wcsicmp(id, wsf_job_id);
+        free(id);
+        if(match) break;
+    }
+    if(!job) {
+        WCHAR msg[MAX_PATH + 96];
+        if(wsf_job_id)
+            swprintf(msg, ARRAY_SIZE(msg), L"Input Error: Unable to find job \"%ls\".", wsf_job_id);
+        else
+            swprintf(msg, ARRAY_SIZE(msg), L"Input Error: There is no job in \"%ls\".", scriptFullName);
+        report_host_error(msg);
+        SysFreeString(file);
+        return;
+    }
+    job = wsf_tag_end(job, end) + 1;
+    job_end = wsf_find_close(job, end, L"job");
+    if(!job_end) job_end = end;
+
+    /* the job's elements in document order */
+    for(p = job; p < job_end; ) {
+        static const WCHAR *const names[] = { L"script", L"object", L"reference" };
+        const WCHAR *best = NULL, *te;
+        int kind = -1;
+
+        for(i = 0; i < ARRAY_SIZE(names); i++) {
+            const WCHAR *t = wsf_find_tag(p, job_end, names[i]);
+            if(t && (!best || t < best)) { best = t; kind = i; }
+        }
+        if(!best || !(te = wsf_tag_end(best, job_end))) break;
+        items = realloc(items, (item_count + 1) * sizeof(*items));
+        if(!items) break;
+        items[item_count].tag = best;
+        items[item_count].tag_end = te;
+        items[item_count].kind = kind;
+        items[item_count].body = items[item_count].body_end = te + 1;
+        p = te + 1;
+        if(kind == 0 && te[-1] != '/') {
+            const WCHAR *c = wsf_find_close(te + 1, job_end, L"script");
+            items[item_count].body_end = c ? c : job_end;
+            p = c ? c + 9 : job_end;
+        }
+        item_count++;
+    }
+
+    /* the engines first (every language of the job), then the objects, the references */
+    for(i = 0; i < item_count; i++) {
+        WCHAR *lang;
+        if(items[i].kind != 0) continue;
+        if(!(lang = wsf_attr(items[i].tag, items[i].tag_end, L"language"))) continue;
+        if(!wsf_engine(lang)) {
+            WCHAR msg[160];
+            swprintf(msg, ARRAY_SIZE(msg), L"Input Error: There is no script engine for \"%ls\".", lang);
+            report_host_error(msg);
+            free(lang);
+            goto done;
+        }
+        free(lang);
+    }
+    for(i = 0; i < item_count; i++) {
+        WCHAR *id, *progid, *classid;
+        CLSID clsid;
+        IUnknown *unk;
+        HRESULT hres = E_FAIL;
+
+        if(items[i].kind != 1) continue;
+        id = wsf_attr(items[i].tag, items[i].tag_end, L"id");
+        progid = wsf_attr(items[i].tag, items[i].tag_end, L"progid");
+        classid = wsf_attr(items[i].tag, items[i].tag_end, L"classid");
+        if(classid && !wcsnicmp(classid, L"clsid:", 6)) hres = CLSIDFromString(classid + 6, &clsid);
+        else if(classid) hres = CLSIDFromString(classid, &clsid);
+        else if(progid) hres = CLSIDFromProgID(progid, &clsid);
+        if(id && SUCCEEDED(hres))
+            hres = CoCreateInstance(&clsid, NULL, CLSCTX_INPROC_SERVER | CLSCTX_LOCAL_SERVER, &IID_IUnknown, (void **)&unk);
+        if(id && SUCCEEDED(hres) && (wsf_objects = realloc(wsf_objects, (wsf_object_count + 1) * sizeof(*wsf_objects)))) {
+            wsf_objects[wsf_object_count].id = id;
+            wsf_objects[wsf_object_count].unk = unk;
+            wsf_object_count++;
+            for(j = 0; j < wsf_engine_count; j++)
+                IActiveScript_AddNamedItem(wsf_engines[j].script, id, SCRIPTITEM_ISVISIBLE);
+            id = NULL;
+        }else if(id) {
+            WINE_WARN("object %s (%s) not created: %08lx\n", debugstr_w(id), debugstr_w(progid ? progid : classid), hres);
+        }
+        free(id);
+        free(progid);
+        free(classid);
+    }
+    for(i = 0; i < item_count; i++)
+        if(items[i].kind == 2) wsf_reference(items[i].tag, items[i].tag_end);
+    /* each engine sees the others' globals */
+    for(i = 0; i < wsf_engine_count; i++) {
+        for(j = 0; j < wsf_engine_count; j++) {
+            WCHAR name[32];
+            if(i == j) continue;
+            swprintf(name, ARRAY_SIZE(name), L"SG.wsf.engine.%u", j);
+            IActiveScript_AddNamedItem(wsf_engines[i].script, name, SCRIPTITEM_ISVISIBLE | SCRIPTITEM_GLOBALMEMBERS);
+        }
+    }
+    for(i = 0; i < wsf_engine_count; i++)
+        IActiveScript_SetScriptState(wsf_engines[i].script, SCRIPTSTATE_STARTED);
+    if(wsf_engine_count)
+        active_script = wsf_engines[0].script;
+
+    /* the blocks in document order */
+    for(i = 0; i < item_count; i++) {
+        WCHAR *lang, *src;
+        struct wsf_engine *e;
+        BSTR code = NULL;
+        HRESULT hres;
+
+        if(items[i].kind != 0) continue;
+        if(!(lang = wsf_attr(items[i].tag, items[i].tag_end, L"language"))) continue;
+        e = wsf_engine(lang);
+        free(lang);
+        if(!e) continue;
+        line = 1;
+        if((src = wsf_attr(items[i].tag, items[i].tag_end, L"src"))) {
+            code = wsf_src(src);
+            if(!code) {
+                WCHAR msg[MAX_PATH + 64];
+                swprintf(msg, ARRAY_SIZE(msg), L"Input Error: Can not find script file \"%ls\".", src);
+                report_host_error(msg);
+                free(src);
+                break;
+            }
+            free(src);
+        }else {
+            WCHAR *t = wsf_text(items[i].body, items[i].body_end, strict);
+            for(p = text; p < items[i].body; p++) if(*p == '\n') line++;
+            code = t ? SysAllocString(t) : NULL;
+            free(t);
+        }
+        if(!code) continue;
+        active_script = e->script;
+        hres = IActiveScriptParse_ParseScriptText(e->parser, code, NULL, NULL, NULL, 1, line,
+                SCRIPTTEXT_HOSTMANAGESSOURCE|SCRIPTITEM_ISVISIBLE, NULL, NULL);
+        SysFreeString(code);
+        if(FAILED(hres)) {
+            WINE_WARN("ParseScriptText failed: %08lx\n", hres);
+            script_exit_code = 1;
+            break;
+        }
+    }
+
+done:
+    active_script = NULL;
+    for(i = 0; i < wsf_engine_count; i++) {
+        IActiveScript_Close(wsf_engines[i].script);
+        IActiveScript_Release(wsf_engines[i].script);
+        IActiveScriptParse_Release(wsf_engines[i].parser);
+        free(wsf_engines[i].lang);
+    }
+    for(i = 0; i < wsf_object_count; i++) {
+        IUnknown_Release(wsf_objects[i].unk);
+        free(wsf_objects[i].id);
+    }
+    if(host_ti) ITypeInfo_Release(host_ti);
+    free(items);
+    SysFreeString(file);
+}
+
 /* The message the script host gives when WScript.Timeout runs out: a message box for the
  * interactive host, the error stream for batch mode (//B). */
 void report_timeout(void)
