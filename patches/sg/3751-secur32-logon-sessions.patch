From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] secur32: LsaEnumerateLogonSessions and LsaGetLogonSessionData (3751)

secur32: LsaEnumerateLogonSessions and LsaGetLogonSessionData

The SYSTEM session and the session of the process token are listed and their
data (user, domain, SID, logon type, session, server) read from the token and
the account database; other sessions are STATUS_NO_SUCH_LOGON_SESSION.
---
diff --git a/dlls/secur32/lsa.c b/dlls/secur32/lsa.c
index 3f119df..5164bc4 100644
--- a/dlls/secur32/lsa.c
+++ b/dlls/secur32/lsa.c
@@ -163,13 +163,43 @@ NTSTATUS WINAPI LsaDeregisterLogonProcess(HANDLE LsaHandle)
     return STATUS_SUCCESS;
 }
 
+/* Stained Glass OS: the logon sessions that exist are the session of the token this process runs under (the
+ * interactive session of the user) and the SYSTEM session (LUID 0x3e7, a service logon).  The data comes
+ * from the token and the account database (read only; nothing is created, changed or deleted). */
+#define SYSTEM_LOGON_ID 0x3e7
+
+static BOOL get_current_logon_id(LUID *id)
+{
+    TOKEN_STATISTICS stats;
+    HANDLE token;
+    DWORD size;
+    BOOL ret;
+
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return FALSE;
+    ret = GetTokenInformation(token, TokenStatistics, &stats, sizeof(stats), &size);
+    CloseHandle(token);
+    if (ret) *id = stats.AuthenticationId;
+    return ret;
+}
+
 NTSTATUS WINAPI LsaEnumerateLogonSessions(PULONG LogonSessionCount,
         PLUID* LogonSessionList)
 {
-    FIXME("%p %p stub\n", LogonSessionCount, LogonSessionList);
+    LUID current, *list;
+    ULONG count = 1;
+
+    TRACE("%p %p\n", LogonSessionCount, LogonSessionList);
+
+    if (!LogonSessionCount || !LogonSessionList) return STATUS_INVALID_PARAMETER;
     *LogonSessionCount = 0;
     *LogonSessionList = NULL;
-
+    if (!get_current_logon_id(&current)) return STATUS_UNSUCCESSFUL;
+    if (!(current.HighPart == 0 && current.LowPart == SYSTEM_LOGON_ID)) count++;
+    if (!(list = calloc(count, sizeof(*list)))) return STATUS_NO_MEMORY;
+    list[0].LowPart = SYSTEM_LOGON_ID;
+    if (count > 1) list[1] = current;
+    *LogonSessionCount = count;
+    *LogonSessionList = list;
     return STATUS_SUCCESS;
 }
 
@@ -180,32 +210,107 @@ NTSTATUS WINAPI LsaFreeReturnBuffer(PVOID buffer)
     return STATUS_SUCCESS;
 }
 
+static ULONG string_bytes(const WCHAR *str) { return (wcslen(str) + 1) * sizeof(WCHAR); }
+
+static WCHAR *pack_string(LSA_UNICODE_STRING *dst, WCHAR *pos, const WCHAR *str)
+{
+    ULONG len = wcslen(str) * sizeof(WCHAR);
+
+    memcpy(pos, str, len + sizeof(WCHAR));
+    dst->Length = len;
+    dst->MaximumLength = len + sizeof(WCHAR);
+    dst->Buffer = pos;
+    return pos + len / sizeof(WCHAR) + 1;
+}
+
 NTSTATUS WINAPI LsaGetLogonSessionData(PLUID LogonId,
         PSECURITY_LOGON_SESSION_DATA* ppLogonSessionData)
 {
     SECURITY_LOGON_SESSION_DATA *data;
-    int authpkg_len;
-    WCHAR *end;
-
-    FIXME("%p %p semi-stub\n", LogonId, ppLogonSessionData);
-
-    authpkg_len = wcslen(default_authentication_package) * sizeof(WCHAR);
-
-    data = calloc(1, sizeof(*data) + authpkg_len + sizeof(WCHAR));
-    if (!data) return STATUS_NO_MEMORY;
+    WCHAR user[256], domain[256], server[MAX_COMPUTERNAME_LENGTH + 1], *pos;
+    BYTE sid_buf[SECURITY_MAX_SID_SIZE];
+    SID *sid = (SID *)sid_buf;
+    LUID current;
+    ULONG size, sid_len, session = 0, type;
+    FILETIME now;
+    ULONGLONG boot;
+    BOOL system;
+
+    TRACE("%p %p\n", LogonId, ppLogonSessionData);
+
+    if (!LogonId || !ppLogonSessionData) return STATUS_INVALID_PARAMETER;
+    *ppLogonSessionData = NULL;
+    if (!get_current_logon_id(&current)) return STATUS_UNSUCCESSFUL;
+    system = !LogonId->HighPart && LogonId->LowPart == SYSTEM_LOGON_ID;
+    if (!system && memcmp(LogonId, &current, sizeof(LUID))) return STATUS_NO_SUCH_LOGON_SESSION;
+
+    if (system)
+    {
+        SID_NAME_USE use;
+        ULONG ulen = ARRAY_SIZE(user), dlen = ARRAY_SIZE(domain);
+
+        size = sizeof(sid_buf);
+        CreateWellKnownSid(WinLocalSystemSid, NULL, sid, &size);
+        wcscpy(user, L"SYSTEM");
+        wcscpy(domain, L"NT AUTHORITY");
+        LookupAccountSidW(NULL, sid, user, &ulen, domain, &dlen, &use);
+        type = Service;
+        session = 0;
+    }
+    else
+    {
+        TOKEN_USER *tu;
+        HANDLE token;
+        SID_NAME_USE use;
+        ULONG ulen = ARRAY_SIZE(user), dlen = ARRAY_SIZE(domain);
+
+        if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return STATUS_UNSUCCESSFUL;
+        GetTokenInformation(token, TokenUser, NULL, 0, &size);
+        if (!(tu = malloc(size)) || !GetTokenInformation(token, TokenUser, tu, size, &size))
+        {
+            free(tu);
+            CloseHandle(token);
+            return STATUS_UNSUCCESSFUL;
+        }
+        size = sizeof(sid_buf);
+        CopySid(size, sid, tu->User.Sid);
+        free(tu);
+        size = sizeof(session);
+        if (!GetTokenInformation(token, TokenSessionId, &session, size, &size)) session = 0;
+        CloseHandle(token);
+        wcscpy(user, L"?");
+        domain[0] = 0;
+        LookupAccountSidW(NULL, sid, user, &ulen, domain, &dlen, &use);
+        type = Interactive;
+    }
+    size = ARRAY_SIZE(server);
+    if (!GetComputerNameW(server, &size)) server[0] = 0;
+    sid_len = GetLengthSid(sid);
 
+    size = sizeof(*data) + string_bytes(user) + string_bytes(domain) + string_bytes(default_authentication_package) +
+           string_bytes(server) + string_bytes(L"") + string_bytes(L"") + sid_len + sizeof(void *);
+    if (!(data = calloc(1, size))) return STATUS_NO_MEMORY;
     data->Size = sizeof(*data);
     data->LogonId = *LogonId;
-
-    end = (WCHAR *)(data + 1);
-    wcscpy(end, default_authentication_package);
-
-    data->AuthenticationPackage.Length = authpkg_len;
-    data->AuthenticationPackage.MaximumLength = authpkg_len + sizeof(WCHAR);
-    data->AuthenticationPackage.Buffer = end;
+    pos = (WCHAR *)(data + 1);
+    pos = pack_string(&data->UserName, pos, user);
+    pos = pack_string(&data->LogonDomain, pos, domain);
+    pos = pack_string(&data->AuthenticationPackage, pos, default_authentication_package);
+    pos = pack_string(&data->LogonServer, pos, server);
+    pos = pack_string(&data->DnsDomainName, pos, L"");
+    pos = pack_string(&data->Upn, pos, L"");
+    data->LogonType = type;
+    data->Session = session;
+    /* the SID is kept on a pointer boundary behind the strings */
+    pos = (WCHAR *)(((ULONG_PTR)pos + sizeof(void *) - 1) & ~(ULONG_PTR)(sizeof(void *) - 1));
+    data->Sid = pos;
+    memcpy(pos, sid, sid_len);
+    /* GUESS: a session began when the machine did */
+    GetSystemTimeAsFileTime(&now);
+    boot = (((ULONGLONG)now.dwHighDateTime << 32) | now.dwLowDateTime) - GetTickCount64() * 10000;
+    data->LogonTime.QuadPart = boot;
 
     *ppLogonSessionData = data;
-
     return STATUS_SUCCESS;
 }
 
