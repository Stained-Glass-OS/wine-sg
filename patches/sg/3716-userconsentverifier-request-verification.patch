+    TRACE( "clsid %s, riid %s, out %p.\n", debugstr_guid( clsid ), debugstr_guid( riid ), out );
+#ifndef SG_MUTANT_UCV_GCO
+    if (out) *out = NULL;
+#endif
     return CLASS_E_CLASSNOTAVAILABLE;
 }
 
