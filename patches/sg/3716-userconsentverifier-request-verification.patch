From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.security.credentials.ui.userconsentverifier: RequestVerificationAsync and the IInspectable members (3716)

windows.security.credentials.ui.userconsentverifier: RequestVerificationAsync and the IInspectable members

RequestVerificationAsync answers DeviceNotPresent (what CheckAvailabilityAsync
reports); GetIids/GetRuntimeClassName/GetTrustLevel of the factory and of the
asynchronous operations; DllGetClassObject clears its out pointer.
---
diff --git a/dlls/windows.security.credentials.ui.userconsentverifier/async.c b/dlls/windows.security.credentials.ui.userconsentverifier/async.c
index 89edb50..59c0869 100644
--- a/dlls/windows.security.credentials.ui.userconsentverifier/async.c
+++ b/dlls/windows.security.credentials.ui.userconsentverifier/async.c
@@ -26,6 +26,24 @@ WINE_DEFAULT_DEBUG_CHANNEL(credentials);
 #define Closed 4
 #define HANDLER_NOT_SET ((void *)~(ULONG_PTR)0)
 
+/* IInspectable::GetIids: the runtime interfaces of an object, not IUnknown, IInspectable or IAgileObject */
+HRESULT get_iids( ULONG *iid_count, IID **iids, const IID *const *list, ULONG count )
+{
+    ULONG i;
+
+    if (!iid_count || !iids) return E_POINTER;
+#ifdef SG_MUTANT_GETIIDS
+    return E_NOTIMPL;
+#endif
+    *iid_count = 0;
+    *iids = NULL;
+    if (!count) return S_OK;
+    if (!(*iids = CoTaskMemAlloc( count * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++) (*iids)[i] = *list[i];
+    *iid_count = count;
+    return S_OK;
+}
+
 struct async_info
 {
     IWineAsyncInfoImpl IWineAsyncInfoImpl_iface;
@@ -71,7 +89,7 @@ static HRESULT WINAPI async_impl_QueryInterface( IWineAsyncInfoImpl *iface, REFI
         return S_OK;
     }
 
-    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
 }
@@ -418,8 +436,9 @@ static ULONG WINAPI async_user_consent_verifier_availability_Release( IAsyncOper
 
 static HRESULT WINAPI async_user_consent_verifier_availability_GetIids( IAsyncOperation_UserConsentVerifierAvailability *iface, ULONG *iid_count, IID **iids )
 {
-    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
-    return E_NOTIMPL;
+    static const IID *const list[] = { &IID_IAsyncOperation_UserConsentVerifierAvailability, &IID_IAsyncInfo };
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+    return get_iids( iid_count, iids, list, ARRAY_SIZE(list) );
 }
 
 static HRESULT WINAPI async_user_consent_verifier_availability_GetRuntimeClassName( IAsyncOperation_UserConsentVerifierAvailability *iface, HSTRING *class_name )
@@ -431,8 +450,10 @@ static HRESULT WINAPI async_user_consent_verifier_availability_GetRuntimeClassNa
 
 static HRESULT WINAPI async_user_consent_verifier_availability_GetTrustLevel( IAsyncOperation_UserConsentVerifierAvailability *iface, TrustLevel *trust_level )
 {
-    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
-    return E_NOTIMPL;
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
 }
 
 static HRESULT WINAPI async_user_consent_verifier_availability_put_Completed( IAsyncOperation_UserConsentVerifierAvailability *iface,
@@ -507,3 +528,153 @@ HRESULT async_operation_user_consent_verifier_availability_create( IUnknown *inv
     TRACE( "created IAsyncOperation_UserConsentVerifierAvailability %p\n", *out );
     return S_OK;
 }
+
+struct async_user_consent_verification_result
+{
+    IAsyncOperation_UserConsentVerificationResult IAsyncOperation_UserConsentVerificationResult_iface;
+    IWineAsyncInfoImpl *IWineAsyncInfoImpl_inner;
+    LONG ref;
+};
+
+static inline struct async_user_consent_verification_result *impl_from_IAsyncOperation_UserConsentVerificationResult( IAsyncOperation_UserConsentVerificationResult *iface )
+{
+    return CONTAINING_RECORD( iface, struct async_user_consent_verification_result, IAsyncOperation_UserConsentVerificationResult_iface );
+}
+
+static HRESULT WINAPI async_user_consent_verification_result_QueryInterface( IAsyncOperation_UserConsentVerificationResult *iface, REFIID iid, void **out )
+{
+    struct async_user_consent_verification_result *impl = impl_from_IAsyncOperation_UserConsentVerificationResult( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IAsyncOperation_UserConsentVerificationResult ))
+    {
+        IInspectable_AddRef( (*out = &impl->IAsyncOperation_UserConsentVerificationResult_iface) );
+        return S_OK;
+    }
+
+    return IWineAsyncInfoImpl_QueryInterface( impl->IWineAsyncInfoImpl_inner, iid, out );
+}
+
+static ULONG WINAPI async_user_consent_verification_result_AddRef( IAsyncOperation_UserConsentVerificationResult *iface )
+{
+    struct async_user_consent_verification_result *impl = impl_from_IAsyncOperation_UserConsentVerificationResult( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI async_user_consent_verification_result_Release( IAsyncOperation_UserConsentVerificationResult *iface )
+{
+    struct async_user_consent_verification_result *impl = impl_from_IAsyncOperation_UserConsentVerificationResult( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        /* guard against re-entry if inner releases an outer iface */
+        InterlockedIncrement( &impl->ref );
+        IWineAsyncInfoImpl_Release( impl->IWineAsyncInfoImpl_inner );
+        free( impl );
+    }
+
+    return ref;
+}
+
+static HRESULT WINAPI async_user_consent_verification_result_GetIids( IAsyncOperation_UserConsentVerificationResult *iface, ULONG *iid_count, IID **iids )
+{
+    static const IID *const list[] = { &IID_IAsyncOperation_UserConsentVerificationResult, &IID_IAsyncInfo };
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+    return get_iids( iid_count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI async_user_consent_verification_result_GetRuntimeClassName( IAsyncOperation_UserConsentVerificationResult *iface, HSTRING *class_name )
+{
+    return WindowsCreateString( L"Windows.Foundation.IAsyncOperation`1<Windows.Security.Credentials.UI.UserConsentVerificationResult>",
+                                ARRAY_SIZE(L"Windows.Foundation.IAsyncOperation`1<Windows.Security.Credentials.UI.UserConsentVerificationResult>"),
+                                class_name );
+}
+
+static HRESULT WINAPI async_user_consent_verification_result_GetTrustLevel( IAsyncOperation_UserConsentVerificationResult *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI async_user_consent_verification_result_put_Completed( IAsyncOperation_UserConsentVerificationResult *iface,
+    IAsyncOperationCompletedHandler_UserConsentVerificationResult *UserConsentVerificationResult_handler )
+{
+    IWineAsyncOperationCompletedHandler *handler = (IWineAsyncOperationCompletedHandler *)UserConsentVerificationResult_handler;
+    struct async_user_consent_verification_result *impl = impl_from_IAsyncOperation_UserConsentVerificationResult( iface );
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    return IWineAsyncInfoImpl_put_Completed( impl->IWineAsyncInfoImpl_inner, (IWineAsyncOperationCompletedHandler *)handler );
+}
+
+static HRESULT WINAPI async_user_consent_verification_result_get_Completed( IAsyncOperation_UserConsentVerificationResult *iface,
+    IAsyncOperationCompletedHandler_UserConsentVerificationResult **UserConsentVerificationResult_handler )
+{
+    IWineAsyncOperationCompletedHandler **handler = (IWineAsyncOperationCompletedHandler **)UserConsentVerificationResult_handler;
+    struct async_user_consent_verification_result *impl = impl_from_IAsyncOperation_UserConsentVerificationResult( iface );
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    return IWineAsyncInfoImpl_get_Completed( impl->IWineAsyncInfoImpl_inner, (IWineAsyncOperationCompletedHandler **)handler );
+}
+
+static HRESULT WINAPI async_user_consent_verification_result_GetResults( IAsyncOperation_UserConsentVerificationResult *iface, UserConsentVerificationResult *results )
+{
+    struct async_user_consent_verification_result *impl = impl_from_IAsyncOperation_UserConsentVerificationResult( iface );
+    PROPVARIANT result = {.vt = VT_UI4};
+    HRESULT hr;
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    hr = IWineAsyncInfoImpl_get_Result( impl->IWineAsyncInfoImpl_inner, &result );
+
+    *results = result.ulVal;
+    PropVariantClear( &result );
+    return hr;
+}
+
+static const struct IAsyncOperation_UserConsentVerificationResultVtbl async_user_consent_verification_result_vtbl =
+{
+    /* IUnknown methods */
+    async_user_consent_verification_result_QueryInterface,
+    async_user_consent_verification_result_AddRef,
+    async_user_consent_verification_result_Release,
+    /* IInspectable methods */
+    async_user_consent_verification_result_GetIids,
+    async_user_consent_verification_result_GetRuntimeClassName,
+    async_user_consent_verification_result_GetTrustLevel,
+    /* IAsyncOperation<UserConsentVerificationResult> */
+    async_user_consent_verification_result_put_Completed,
+    async_user_consent_verification_result_get_Completed,
+    async_user_consent_verification_result_GetResults,
+};
+
+HRESULT async_operation_user_consent_verification_result_create( IUnknown *invoker, IUnknown *param, async_operation_callback callback,
+                                                                   IAsyncOperation_UserConsentVerificationResult **out )
+{
+    struct async_user_consent_verification_result *impl;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAsyncOperation_UserConsentVerificationResult_iface.lpVtbl = &async_user_consent_verification_result_vtbl;
+    impl->ref = 1;
+
+    if (FAILED(hr = async_info_create( invoker, param, callback, (IInspectable *)&impl->IAsyncOperation_UserConsentVerificationResult_iface, &impl->IWineAsyncInfoImpl_inner )) ||
+        FAILED(hr = IWineAsyncInfoImpl_Start( impl->IWineAsyncInfoImpl_inner )))
+    {
+        if (impl->IWineAsyncInfoImpl_inner) IWineAsyncInfoImpl_Release( impl->IWineAsyncInfoImpl_inner );
+        free( impl );
+        return hr;
+    }
+
+    *out = &impl->IAsyncOperation_UserConsentVerificationResult_iface;
+    TRACE( "created IAsyncOperation_UserConsentVerificationResult %p\n", *out );
+    return S_OK;
+}
