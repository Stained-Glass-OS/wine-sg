From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: Binary blob credentials (6058)

CredMarshalCredential and CredUnmarshalCredential failed for
BinaryBlobCredential, and CredIsMarshaledCredential did not recognize
one (DECISIONS-2 SEC-CRED). A blob is marshaled like a user name target:
"@@D", its size, then its bytes, in the credential encoding; unmarshaled
into one block with the bytes after the structure.
---
diff --git a/dlls/advapi32/cred.c b/dlls/advapi32/cred.c
index f6d9bf0..aaf3bf2 100644
--- a/dlls/advapi32/cred.c
+++ b/dlls/advapi32/cred.c
@@ -2331,8 +2331,26 @@ BOOL WINAPI CredMarshalCredentialW( CRED_MARSHAL_TYPE type, PVOID cred, LPWSTR *
         break;
     }
     case BinaryBlobCredential:
-        FIXME("BinaryBlobCredential not implemented\n");
-        return FALSE;
+    {
+        /* as a user name target: the size, then the bytes */
+        BINARY_BLOB_CREDENTIAL_INFO *blob = cred;
+
+        if (!blob->pbBlob && blob->cbBlob)
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return FALSE;
+        }
+        size = (sizeof(DWORD) + blob->cbBlob + 2) * 4 / 3;
+        if (!(p = malloc( (size + 8) * sizeof(WCHAR) ))) return FALSE;
+        p[0] = '@';
+        p[1] = '@';
+        p[2] = 'A' + type;
+        size = blob->cbBlob;
+        len = cred_encode( (const char *)&size, sizeof(DWORD), p + 3 );
+        len += cred_encode( (const char *)blob->pbBlob, size, p + 3 + len );
+        p[len + 3] = 0;
+        break;
+    }
     default:
         return FALSE;
     }
@@ -2473,8 +2491,31 @@ BOOL WINAPI CredUnmarshalCredentialW( LPCWSTR cred, PCRED_MARSHAL_TYPE type, PVO
         break;
     }
     case BinaryBlobCredential:
-        FIXME("BinaryBlobCredential not implemented\n");
-        return FALSE;
+    {
+        BINARY_BLOB_CREDENTIAL_INFO *blob;
+        DWORD size;
+
+        if (len < 6 || !cred_decode( cred + 3, 6, (char *)&size ) || len - 6 != (size * 4 + 2) / 3)
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return FALSE;
+        }
+        buflen = sizeof(*blob) + size;
+        if (!(blob = malloc( buflen ))) return FALSE;
+        if (size && !cred_decode( cred + 9, len - 6, (char *)(blob + 1) ))
+        {
+            free( blob );
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return FALSE;
+        }
+        blob->cbBlob = size;
+        blob->pbBlob = size ? (BYTE *)(blob + 1) : NULL;
+#ifdef SG_MUTANT_CRED_BLOB_SIZE_ONLY
+        memset( blob + 1, 0, size );
+#endif
+        *out = blob;
+        break;
+    }
     default:
         WARN("unhandled type %u\n", *type);
         SetLastError( ERROR_INVALID_PARAMETER );
@@ -2512,8 +2553,9 @@ BOOL WINAPI CredIsMarshaledCredentialW(LPCWSTR name)
             (len >= 9) && cred_decode(name + 3, 6, (char *)&size) && size)
             return TRUE;
 
-        if ((name[2] - 'A') == BinaryBlobCredential)
-            FIXME("BinaryBlobCredential not checked\n");
+        if ((name[2] - 'A') == BinaryBlobCredential &&
+            len >= 6 && cred_decode(name + 3, 6, (char *)&size) && len - 6 == (size * 4 + 2) / 3)
+            return TRUE;
 
         if ((name[2] - 'A') > BinaryBlobCredential)
             TRACE("unknown type: %d\n", (name[2] - 'A'));
