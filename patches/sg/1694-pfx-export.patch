 };
 
+/* Stained Glass OS 1694: a PFX from certificates and keys. The input is one
+ * buffer: a DWORD count, then for each a DWORD certificate size, a DWORD
+ * key size (0 for none), a 20-byte local key id, the certificate (DER) and
+ * the key (a PRIVATEKEYBLOB). */
+struct export_pfx_params
+{
+    const BYTE *input;
+    DWORD input_size;
+    const WCHAR *password;
+    void *buf;
+    DWORD *buf_size;
+};
+
