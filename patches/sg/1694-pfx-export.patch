+/* a datum over a big-endian number made by reverse() */
+static void datum_from_le( gnutls_datum_t *d, const BYTE *src, unsigned int len )
+{
+    d->data = (unsigned char *)src;
+    d->size = len;
+}
+
+/* a little-endian number of len bytes, big-endian */
+static BYTE *reverse( const BYTE *src, unsigned int len )
+{
+    BYTE *ret = malloc( len );
+    unsigned int i;
+
+    if (ret) for (i = 0; i < len; i++) ret[i] = src[len - 1 - i];
+    return ret;
+}
+
+/* a PRIVATEKEYBLOB (RSA) as a gnutls key */
+static int import_rsa_blob( gnutls_x509_privkey_t key, const BYTE *blob, DWORD size )
+{
+    const BLOBHEADER *hdr = (const BLOBHEADER *)blob;
+    const RSAPUBKEY *rsa = (const RSAPUBKEY *)(hdr + 1);
+    const BYTE *p = (const BYTE *)(rsa + 1);
+    unsigned int bytes, half, i;
+    gnutls_datum_t m, e, d, pr, q, u, e1, e2;
+    BYTE exp[4], *parts[8] = { 0 };
+    int ret = GNUTLS_E_INVALID_REQUEST;
+
+    if (size < sizeof(*hdr) + sizeof(*rsa) || hdr->bType != PRIVATEKEYBLOB || rsa->magic != RSA_MAGIC_KEY) return ret;
+    bytes = rsa->bitlen / 8;
+    half = rsa->bitlen / 16;
+    if (size < sizeof(*hdr) + sizeof(*rsa) + bytes * 2 + half * 5) return ret;
+    for (i = 0; i < 4; i++) exp[i] = (rsa->pubexp >> (24 - 8 * i)) & 0xff;
+    e.data = exp;
+    e.size = 4;
+    if (!(parts[0] = reverse( p, bytes ))) goto done;                                   /* modulus */
+    if (!(parts[1] = reverse( p + bytes, half ))) goto done;                            /* prime1 */
+    if (!(parts[2] = reverse( p + bytes + half, half ))) goto done;                     /* prime2 */
+    if (!(parts[3] = reverse( p + bytes + 2 * half, half ))) goto done;                 /* exponent1 */
+    if (!(parts[4] = reverse( p + bytes + 3 * half, half ))) goto done;                 /* exponent2 */
+    if (!(parts[5] = reverse( p + bytes + 4 * half, half ))) goto done;                 /* coefficient */
+    if (!(parts[6] = reverse( p + bytes + 5 * half, bytes ))) goto done;                /* private exponent */
+    datum_from_le( &m, parts[0], bytes );
+    datum_from_le( &pr, parts[1], half );
+    datum_from_le( &q, parts[2], half );
+    datum_from_le( &e1, parts[3], half );
+    datum_from_le( &e2, parts[4], half );
+    datum_from_le( &u, parts[5], half );
+    datum_from_le( &d, parts[6], bytes );
+    /* as import_store_key exports them: u is the blob's coefficient */
+    ret = pgnutls_x509_privkey_import_rsa_raw2( key, &m, &e, &d, &pr, &q, &u, &e1, &e2 );
+done:
+    for (i = 0; i < 8; i++) free( parts[i] );
+    return ret;
+}
+
+static NTSTATUS export_pfx( void *args )
+{
+    struct export_pfx_params *params = args;
+    const BYTE *p = params->input, *end = params->input + params->input_size;
+    gnutls_pkcs12_t p12 = NULL;
+    gnutls_pkcs12_bag_t bag;
+    unsigned int count, n;
+    size_t out_size = 0;
+    char *pwd = NULL;
+    NTSTATUS status = STATUS_INVALID_PARAMETER;
+    static const WCHAR empty[] = { 0 };
+    void *out = NULL;
+    int ret = 0;
+
+    if (!libgnutls_handle) return STATUS_DLL_NOT_FOUND;
+    if (params->input_size < sizeof(DWORD)) return STATUS_INVALID_PARAMETER;
+    if (!(pwd = password_to_ascii( params->password ? params->password : empty ))) return STATUS_NO_MEMORY;
+    if ((ret = pgnutls_pkcs12_init( &p12 )) < 0) goto done;
+    count = *(const DWORD *)p;
+    p += sizeof(DWORD);
+    for (n = 0; n < count; n++)
+    {
+        DWORD cert_size, key_size;
+        gnutls_datum_t data, id;
+        gnutls_x509_crt_t crt;
+        int idx;
+
+        if (end - p < 2 * sizeof(DWORD) + 20) goto done;
+        cert_size = ((const DWORD *)p)[0];
+        key_size = ((const DWORD *)p)[1];
+        id.data = (unsigned char *)p + 2 * sizeof(DWORD);
+        id.size = 20;
+        p += 2 * sizeof(DWORD) + 20;
+        if ((size_t)(end - p) < (size_t)cert_size + key_size) goto done;
+
+        /* the certificate, in a bag of its own, encrypted */
+        data.data = (unsigned char *)p;
+        data.size = cert_size;
+        if ((ret = pgnutls_x509_crt_init( &crt )) < 0) goto done;
+        if ((ret = pgnutls_x509_crt_import( crt, &data, GNUTLS_X509_FMT_DER )) < 0)
+        {
+            pgnutls_x509_crt_deinit( crt );
+            goto done;
+        }
+        if ((ret = pgnutls_pkcs12_bag_init( &bag )) < 0)
+        {
+            pgnutls_x509_crt_deinit( crt );
+            goto done;
+        }
+        idx = pgnutls_pkcs12_bag_set_crt( bag, crt );
+        pgnutls_x509_crt_deinit( crt );
+        if (idx < 0 || (ret = pgnutls_pkcs12_bag_set_key_id( bag, idx, &id )) < 0 ||
+            (ret = pgnutls_pkcs12_bag_encrypt( bag, pwd, GNUTLS_PKCS_PKCS12_3DES )) < 0 ||
+            (ret = pgnutls_pkcs12_set_bag( p12, bag )) < 0)
+        {
+            pgnutls_pkcs12_bag_deinit( bag );
+            goto done;
+        }
+        pgnutls_pkcs12_bag_deinit( bag );
+        p += cert_size;
+
+        /* its key, shrouded */
+        if (key_size)
+        {
+            gnutls_x509_privkey_t key;
+
+            if ((ret = pgnutls_x509_privkey_init( &key )) < 0) goto done;
+            if ((ret = import_rsa_blob( key, p, key_size )) < 0 || (ret = pgnutls_pkcs12_bag_init( &bag )) < 0)
+            {
+                pgnutls_x509_privkey_deinit( key );
+                goto done;
+            }
+            idx = pgnutls_pkcs12_bag_set_privkey( bag, key, pwd, GNUTLS_PKCS_PKCS12_3DES );
+            pgnutls_x509_privkey_deinit( key );
+            if (idx < 0 || (ret = pgnutls_pkcs12_bag_set_key_id( bag, idx, &id )) < 0 ||
+                (ret = pgnutls_pkcs12_set_bag( p12, bag )) < 0)
+            {
+                pgnutls_pkcs12_bag_deinit( bag );
+                goto done;
+            }
+            pgnutls_pkcs12_bag_deinit( bag );
+            p += key_size;
+        }
+    }
+    if ((ret = pgnutls_pkcs12_generate_mac( p12, pwd )) < 0) goto done;
+    ret = pgnutls_pkcs12_export( p12, GNUTLS_X509_FMT_DER, NULL, &out_size );
+    if (ret != GNUTLS_E_SHORT_MEMORY_BUFFER && ret < 0) goto done;
+    if (!params->buf || *params->buf_size < out_size)
+    {
+        *params->buf_size = out_size;
+        status = params->buf ? STATUS_BUFFER_TOO_SMALL : STATUS_SUCCESS;
+        goto done;
+    }
+    if (!(out = malloc( out_size ))) { status = STATUS_NO_MEMORY; goto done; }
+    if ((ret = pgnutls_pkcs12_export( p12, GNUTLS_X509_FMT_DER, out, &out_size )) < 0) goto done;
+    memcpy( params->buf, out, out_size );
+    *params->buf_size = out_size;
+    status = STATUS_SUCCESS;
+
+done:
+    if (status == STATUS_INVALID_PARAMETER && ret < 0) pgnutls_perror( ret );
+    free( out );
+    if (p12) pgnutls_pkcs12_deinit( p12 );
+    free( pwd );
+    return status;
+}
