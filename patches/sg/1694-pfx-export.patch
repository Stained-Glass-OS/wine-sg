+/* Stained Glass OS 1694: a certificate's private key, as a PRIVATEKEYBLOB */
+static BYTE *export_cert_key( PCCERT_CONTEXT cert, DWORD *size )
+{
+    CRYPT_KEY_PROV_INFO *info = NULL;
+    HCRYPTPROV prov = 0;
+    HCRYPTKEY key = 0;
+    DWORD len = 0, spec = AT_KEYEXCHANGE;
+    BOOL release = FALSE;
+    BYTE *blob = NULL;
+
+    *size = 0;
+    len = sizeof(prov);
+    if (CertGetCertificateContextProperty( cert, CERT_KEY_CONTEXT_PROP_ID, NULL, &len ))
+    {
+        CERT_KEY_CONTEXT ctx;
+        len = sizeof(ctx);
+        if (CertGetCertificateContextProperty( cert, CERT_KEY_CONTEXT_PROP_ID, &ctx, &len ))
+        {
+            prov = ctx.hCryptProv;
+            spec = ctx.dwKeySpec;
+        }
+    }
+    if (!prov)
+    {
+        len = 0;
+        if (!CertGetCertificateContextProperty( cert, CERT_KEY_PROV_INFO_PROP_ID, NULL, &len ) ||
+            !(info = CryptMemAlloc( len )) ||
+            !CertGetCertificateContextProperty( cert, CERT_KEY_PROV_INFO_PROP_ID, info, &len ) ||
+            !CryptAcquireContextW( &prov, info->pwszContainerName, info->pwszProvName, info->dwProvType,
+                                   info->dwFlags & CRYPT_MACHINE_KEYSET ))
+        {
+            CryptMemFree( info );
+            return NULL;
+        }
+        spec = info->dwKeySpec;
+        release = TRUE;
+        CryptMemFree( info );
+    }
+    if (CryptGetUserKey( prov, spec, &key ) && CryptExportKey( key, 0, PRIVATEKEYBLOB, 0, NULL, &len ) &&
+        (blob = CryptMemAlloc( len )) && CryptExportKey( key, 0, PRIVATEKEYBLOB, 0, blob, &len ))
+        *size = len;
+    else
+    {
+        CryptMemFree( blob );
+        blob = NULL;
+    }
+    if (key) CryptDestroyKey( key );
+    if (release) CryptReleaseContext( prov, 0 );
+    return blob;
+}
+
 BOOL WINAPI PFXExportCertStoreEx( HCERTSTORE store, CRYPT_DATA_BLOB *pfx, const WCHAR *password, void *reserved,
                                   DWORD flags )
 {
-    FIXME( "(%p, %p, %p, %p, %08lx): stub\n", store, pfx, password, reserved, flags );
-    return FALSE;
+    PCCERT_CONTEXT cert = NULL;
+    BYTE *input = NULL, *tmp, *key;
+    DWORD input_size = sizeof(DWORD), count = 0, key_size, id_size, size;
+    struct export_pfx_params params;
+    NTSTATUS status;
+    BOOL ret = FALSE;
+
+    TRACE( "(%p, %p, %p, %p, %08lx)\n", store, pfx, password, reserved, flags );
+
+    if (!store || !pfx)
+    {
+        SetLastError( E_INVALIDARG );
+        return FALSE;
+    }
+    if (!(input = CryptMemAlloc( input_size ))) return FALSE;
+    while ((cert = CertEnumCertificatesInStore( store, cert )))
+    {
+        key = NULL;
+        key_size = 0;
+        if (flags & EXPORT_PRIVATE_KEYS)
+        {
+            DWORD has_key = 0;
+            BOOL with_key = CertGetCertificateContextProperty( cert, CERT_KEY_PROV_INFO_PROP_ID, NULL, &has_key ) ||
+                            CertGetCertificateContextProperty( cert, CERT_KEY_CONTEXT_PROP_ID, NULL, &has_key );
+
+            if (with_key) key = export_cert_key( cert, &key_size );
+            if ((!with_key && (flags & REPORT_NO_PRIVATE_KEY)) ||
+                (with_key && !key && (flags & REPORT_NOT_ABLE_TO_EXPORT_PRIVATE_KEY)))
+            {
+                SetLastError( with_key ? NTE_BAD_KEY_STATE : (DWORD)CRYPT_E_NOT_FOUND );
+                CertFreeCertificateContext( cert );
+                goto done;
+            }
+        }
+        size = input_size + 2 * sizeof(DWORD) + 20 + cert->cbCertEncoded + key_size;
+        if (!(tmp = CryptMemRealloc( input, size )))
+        {
+            CryptMemFree( key );
+            CertFreeCertificateContext( cert );
+            goto done;
+        }
+        input = tmp;
+        tmp = input + input_size;
+        ((DWORD *)tmp)[0] = cert->cbCertEncoded;
+        ((DWORD *)tmp)[1] = key_size;
+        id_size = 20;
+        CertGetCertificateContextProperty( cert, CERT_SHA1_HASH_PROP_ID, tmp + 2 * sizeof(DWORD), &id_size );
+        memcpy( tmp + 2 * sizeof(DWORD) + 20, cert->pbCertEncoded, cert->cbCertEncoded );
+        if (key_size) memcpy( tmp + 2 * sizeof(DWORD) + 20 + cert->cbCertEncoded, key, key_size );
+        CryptMemFree( key );
+        input_size = size;
+        count++;
+    }
+    *(DWORD *)input = count;
+
+    params.input = input;
+    params.input_size = input_size;
+    params.password = password;
+    params.buf = pfx->pbData;
+    params.buf_size = &pfx->cbData;
+#ifdef SG_MUTANT_NO_PFX_EXPORT
+    status = STATUS_NOT_IMPLEMENTED;
+#else
+    status = CRYPT32_CALL( export_pfx, &params );
+#endif
+    if (status == STATUS_BUFFER_TOO_SMALL) SetLastError( ERROR_MORE_DATA );
+    else if (status) SetLastError( RtlNtStatusToDosError( status ) );
+    else ret = TRUE;
+
+done:
+    CryptMemFree( input );
+    return ret;
 }
