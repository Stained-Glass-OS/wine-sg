From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfplat: IMFPluginControl preferred/disabled plug-in store

MFGetPluginControl returned an object whose six methods were E_NOTIMPL FIXMEs, so MFTEnum
never saw preferred or disabled transforms. Preferred CLSIDs (per plug-in type and selector, NULL clears) and
disabled CLSIDs are now kept per user in the registry; lookups return MF_E_NOT_FOUND / MF_E_NO_MORE_TYPES /
S_FALSE as documented. The unsupported-interface FIXME in QueryInterface becomes a WARN (E_NOINTERFACE is right).
Gate: test/mfplat-plugin-gate.sh
---
diff --git a/dlls/mfplat/main.c b/dlls/mfplat/main.c
index 2dbf0bb..8852db1 100644
--- a/dlls/mfplat/main.c
+++ b/dlls/mfplat/main.c
@@ -6069,7 +6069,7 @@ static HRESULT WINAPI MFPluginControl_QueryInterface(IMFPluginControl *iface, RE
         TRACE("(IID_IMFPluginControl %p)\n", ppv);
         *ppv = iface;
     }else {
-        FIXME("(%s %p)\n", debugstr_guid(riid), ppv);
+        WARN("Unsupported interface %s.\n", debugstr_guid(riid));
         *ppv = NULL;
         return E_NOINTERFACE;
     }
@@ -6090,43 +6090,187 @@ static ULONG WINAPI MFPluginControl_Release(IMFPluginControl *iface)
     return 1;
 }
 
+/* Plug-in preferences are kept per user in the registry:
+ *   Software\Microsoft\Windows Media Foundation\Plugins\Preferred\<type>: value name = selector, data = CLSID string
+ *   Software\Microsoft\Windows Media Foundation\Plugins\Disabled\<type>: value name = CLSID string
+ * The key layout is private to this implementation. */
+static const WCHAR plugin_root_keyW[] = L"Software\\Microsoft\\Windows Media Foundation\\Plugins";
+
+static BOOL plugin_get_key(const WCHAR *kind, DWORD plugin_type, BOOL create, HKEY *key)
+{
+    WCHAR path[256];
+    LSTATUS ret;
+
+    swprintf(path, ARRAY_SIZE(path), L"%ls\\%ls\\%lu", plugin_root_keyW, kind, plugin_type);
+    if (create)
+        ret = RegCreateKeyExW(HKEY_CURRENT_USER, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, key, NULL);
+    else
+        ret = RegOpenKeyExW(HKEY_CURRENT_USER, path, 0, KEY_ALL_ACCESS, key);
+    return !ret;
+}
+
 static HRESULT WINAPI MFPluginControl_GetPreferredClsid(IMFPluginControl *iface, DWORD plugin_type,
         const WCHAR *selector, CLSID *clsid)
 {
-    FIXME("(%ld %s %p)\n", plugin_type, debugstr_w(selector), clsid);
-    return E_NOTIMPL;
+    WCHAR str[64];
+    DWORD size = sizeof(str), type;
+    HRESULT hr;
+    HKEY key;
+
+    TRACE("(%ld %s %p)\n", plugin_type, debugstr_w(selector), clsid);
+
+    if (!selector || !clsid)
+        return E_POINTER;
+    if (plugin_type > MF_Plugin_Type_MediaSource)
+        return E_INVALIDARG;
+#ifdef SG_MUTANT_PLUGIN_NO_PREFERRED
+    return MF_E_NOT_FOUND;
+#endif
+    if (!plugin_get_key(L"Preferred", plugin_type, FALSE, &key))
+        return MF_E_NOT_FOUND;
+    if (RegQueryValueExW(key, selector, NULL, &type, (BYTE *)str, &size) || type != REG_SZ)
+        hr = MF_E_NOT_FOUND;
+    else
+        hr = CLSIDFromString(str, clsid);
+    RegCloseKey(key);
+    return hr == S_OK ? S_OK : MF_E_NOT_FOUND;
 }
 
 static HRESULT WINAPI MFPluginControl_GetPreferredClsidByIndex(IMFPluginControl *iface, DWORD plugin_type,
         DWORD index, WCHAR **selector, CLSID *clsid)
 {
-    FIXME("(%ld %ld %p %p)\n", plugin_type, index, selector, clsid);
-    return E_NOTIMPL;
+    WCHAR name[256], str[64];
+    DWORD name_len = ARRAY_SIZE(name), size = sizeof(str), type;
+    HRESULT hr = S_OK;
+    HKEY key;
+
+    TRACE("(%ld %ld %p %p)\n", plugin_type, index, selector, clsid);
+
+    if (!selector || !clsid)
+        return E_POINTER;
+    if (plugin_type > MF_Plugin_Type_MediaSource)
+        return E_INVALIDARG;
+    if (!plugin_get_key(L"Preferred", plugin_type, FALSE, &key))
+        return MF_E_NO_MORE_TYPES;
+    if (RegEnumValueW(key, index, name, &name_len, NULL, &type, (BYTE *)str, &size) || type != REG_SZ)
+        hr = MF_E_NO_MORE_TYPES;
+    else if (FAILED(CLSIDFromString(str, clsid)))
+        hr = MF_E_NO_MORE_TYPES;
+    else if (!(*selector = CoTaskMemAlloc((name_len + 1) * sizeof(WCHAR))))
+        hr = E_OUTOFMEMORY;
+    else
+        wcscpy(*selector, name);
+    RegCloseKey(key);
+    return hr;
 }
 
 static HRESULT WINAPI MFPluginControl_SetPreferredClsid(IMFPluginControl *iface, DWORD plugin_type,
         const WCHAR *selector, const CLSID *clsid)
 {
-    FIXME("(%ld %s %s)\n", plugin_type, debugstr_w(selector), debugstr_guid(clsid));
-    return E_NOTIMPL;
+    WCHAR str[64];
+    HKEY key;
+
+    TRACE("(%ld %s %s)\n", plugin_type, debugstr_w(selector), debugstr_guid(clsid));
+
+    if (!selector)
+        return E_POINTER;
+    if (plugin_type > MF_Plugin_Type_MediaSource)
+        return E_INVALIDARG;
+
+    if (!clsid)
+    {
+        /* a NULL CLSID clears the preference */
+        if (plugin_get_key(L"Preferred", plugin_type, FALSE, &key))
+        {
+            RegDeleteValueW(key, selector);
+            RegCloseKey(key);
+        }
+        return S_OK;
+    }
+
+    if (!plugin_get_key(L"Preferred", plugin_type, TRUE, &key))
+        return E_FAIL;
+    StringFromGUID2(clsid, str, ARRAY_SIZE(str));
+    RegSetValueExW(key, selector, 0, REG_SZ, (const BYTE *)str, (wcslen(str) + 1) * sizeof(WCHAR));
+    RegCloseKey(key);
+    return S_OK;
 }
 
 static HRESULT WINAPI MFPluginControl_IsDisabled(IMFPluginControl *iface, DWORD plugin_type, REFCLSID clsid)
 {
-    FIXME("(%ld %s)\n", plugin_type, debugstr_guid(clsid));
-    return E_NOTIMPL;
+    WCHAR str[64];
+    HRESULT hr = S_FALSE;
+    HKEY key;
+
+    TRACE("(%ld %s)\n", plugin_type, debugstr_guid(clsid));
+
+    if (!clsid)
+        return E_POINTER;
+    if (plugin_type > MF_Plugin_Type_MediaSource)
+        return E_INVALIDARG;
+    if (!plugin_get_key(L"Disabled", plugin_type, FALSE, &key))
+        return S_FALSE;
+    StringFromGUID2(clsid, str, ARRAY_SIZE(str));
+    if (!RegQueryValueExW(key, str, NULL, NULL, NULL, NULL))
+        hr = S_OK;
+    RegCloseKey(key);
+    return hr;
 }
 
 static HRESULT WINAPI MFPluginControl_GetDisabledByIndex(IMFPluginControl *iface, DWORD plugin_type, DWORD index, CLSID *clsid)
 {
-    FIXME("(%ld %ld %p)\n", plugin_type, index, clsid);
-    return E_NOTIMPL;
+    WCHAR name[64];
+    DWORD len = ARRAY_SIZE(name);
+    HRESULT hr;
+    HKEY key;
+
+    TRACE("(%ld %ld %p)\n", plugin_type, index, clsid);
+
+    if (!clsid)
+        return E_POINTER;
+    if (plugin_type > MF_Plugin_Type_MediaSource)
+        return E_INVALIDARG;
+    if (!plugin_get_key(L"Disabled", plugin_type, FALSE, &key))
+        return MF_E_NO_MORE_TYPES;
+    if (RegEnumValueW(key, index, name, &len, NULL, NULL, NULL, NULL))
+        hr = MF_E_NO_MORE_TYPES;
+    else
+        hr = CLSIDFromString(name, clsid) == S_OK ? S_OK : MF_E_NO_MORE_TYPES;
+    RegCloseKey(key);
+    return hr;
 }
 
 static HRESULT WINAPI MFPluginControl_SetDisabled(IMFPluginControl *iface, DWORD plugin_type, REFCLSID clsid, BOOL disabled)
 {
-    FIXME("(%ld %s %x)\n", plugin_type, debugstr_guid(clsid), disabled);
-    return E_NOTIMPL;
+    WCHAR str[64];
+    DWORD one = 1;
+    HKEY key;
+
+    TRACE("(%ld %s %x)\n", plugin_type, debugstr_guid(clsid), disabled);
+
+    if (!clsid)
+        return E_POINTER;
+    if (plugin_type > MF_Plugin_Type_MediaSource)
+        return E_INVALIDARG;
+
+    StringFromGUID2(clsid, str, ARRAY_SIZE(str));
+    if (!disabled)
+    {
+        if (plugin_get_key(L"Disabled", plugin_type, FALSE, &key))
+        {
+            RegDeleteValueW(key, str);
+            RegCloseKey(key);
+        }
+        return S_OK;
+    }
+#ifdef SG_MUTANT_PLUGIN_NO_DISABLE
+    return S_OK;
+#endif
+    if (!plugin_get_key(L"Disabled", plugin_type, TRUE, &key))
+        return E_FAIL;
+    RegSetValueExW(key, str, 0, REG_DWORD, (const BYTE *)&one, sizeof(one));
+    RegCloseKey(key);
+    return S_OK;
 }
 
 static const IMFPluginControlVtbl MFPluginControlVtbl = {
