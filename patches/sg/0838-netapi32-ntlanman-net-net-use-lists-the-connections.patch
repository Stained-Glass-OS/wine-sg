From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] netapi32, ntlanman, net: NET USE lists the connections

NET USE with no arguments printed nothing at all -- not the connections,
not "There are no entries in the list." -- because NetUseEnum was a stub;
programs asking what is mapped got ERROR_NOT_SUPPORTED. NetUseEnum now
lists the user's drive letters mapped to shares (levels 0, 1 and 2, as the
network provider reports them), and NET USE prints them as Windows does,
ending with "The command completed successfully."

A drive mapped with a name and password (net use X: \\server\share
/user:name, Map network drive with other credentials, wine-sg 0474) is a
link into the user's own connections, which the network provider did not
recognise: it was "not connected" to NET USE, to Disconnect network drive
and to File Explorer's drive names. It is now.

USE_INFO_0 is added to lmuse.h.

Test: test/netuse-gate.sh with test/netuse-probe.c (mutants
SG_MUTANT_NETUSEENUM_STUB in dlls/netapi32/netapi32.c,
SG_MUTANT_USER_DRIVE_UNKNOWN in dlls/ntlanman/ntlanman.c).
---
--- a/dlls/netapi32/Makefile.in
+++ b/dlls/netapi32/Makefile.in
@@ -2,6 +2,7 @@
 UNIXLIB   = netapi32.so
 IMPORTLIB = netapi32
 IMPORTS   = rpcrt4 iphlpapi ws2_32 advapi32 dnsapi netutils
+DELAYIMPORTS = mpr
 
 SOURCES = \
 	atsvc.idl \
--- a/dlls/netapi32/netapi32.c
+++ b/dlls/netapi32/netapi32.c
@@ -39,6 +39,7 @@
 #include "lmremutl.h"
 #include "lmshare.h"
 #include "lmwksta.h"
+#include "winnetwk.h"
 #include "netbios.h"
 #include "ifmib.h"
 #include "iphlpapi.h"
@@ -295,12 +296,84 @@
     return res;
 }
 
+/* Stained Glass OS: the connections a user has made -- the drive letters
+ * mapped to shares (net use, Map network drive, a logon script, a Group
+ * Policy drive map). NetUseEnum was a stub, so NET USE listed nothing, not
+ * even "There are no entries in the list.", and programs could not see what
+ * was mapped. Each letter's share is the network provider's answer
+ * (WNetGetConnection). */
 NET_API_STATUS WINAPI NetUseEnum(LMSTR server, DWORD level, LPBYTE* bufptr, DWORD prefmaxsize,
                           LPDWORD entriesread, LPDWORD totalentries, LPDWORD resumehandle)
 {
+#ifdef SG_MUTANT_NETUSEENUM_STUB
     FIXME("stub (%p, %ld, %p, %ld, %p, %p, %p)\n", server, level, bufptr, prefmaxsize,
            entriesread, totalentries, resumehandle);
     return ERROR_NOT_SUPPORTED;
+#else
+    WCHAR remote[26][MAX_PATH];
+    DWORD count = 0, mask, size, i, n, entry_size, strings = 0;
+    BYTE *buf, *p;
+    WCHAR *str;
+    int letters[26];
+
+    TRACE("(%s, %ld, %p, %ld, %p, %p, %p)\n", debugstr_w(server), level, bufptr, prefmaxsize,
+          entriesread, totalentries, resumehandle);
+
+    if (server && server[0] && !NETAPI_IsLocalComputer(server)) return ERROR_NOT_SUPPORTED;
+    if (!bufptr || !entriesread || !totalentries) return ERROR_INVALID_PARAMETER;
+    switch (level)
+    {
+    case 0: entry_size = sizeof(USE_INFO_0); break;
+    case 1: entry_size = sizeof(USE_INFO_1); break;
+    case 2: entry_size = sizeof(USE_INFO_2); break;
+    default: return ERROR_INVALID_LEVEL;
+    }
+    *bufptr = NULL;
+    *entriesread = *totalentries = 0;
+    if (resumehandle && *resumehandle) return NERR_Success;   /* all were given the first time */
+
+    mask = GetLogicalDrives();
+    for (i = 0; i < 26; i++)
+    {
+        WCHAR local[3] = { 'A' + i, ':', 0 };
+        if (!(mask & (1 << i))) continue;
+        size = MAX_PATH;
+        if (WNetGetConnectionW(local, remote[count], &size) != NO_ERROR) continue;
+        letters[count++] = i;
+        strings += 3 + lstrlenW(remote[count - 1]) + 1;
+    }
+    if (!count) return NERR_Success;
+    if (NetApiBufferAllocate(count * entry_size + strings * sizeof(WCHAR), (void **)&buf)) return ERROR_NOT_ENOUGH_MEMORY;
+    str = (WCHAR *)(buf + count * entry_size);
+    for (n = 0, p = buf; n < count; n++, p += entry_size)
+    {
+        WCHAR *local = str, *rem;
+        local[0] = 'A' + letters[n]; local[1] = ':'; local[2] = 0;
+        rem = local + 3;
+        lstrcpyW(rem, remote[n]);
+        str = rem + lstrlenW(rem) + 1;
+        ((USE_INFO_0 *)p)->ui0_local = local;
+        ((USE_INFO_0 *)p)->ui0_remote = rem;
+        if (level >= 1)
+        {
+            USE_INFO_1 *info = (USE_INFO_1 *)p;
+            info->ui1_password = NULL;
+            info->ui1_status = USE_OK;
+            info->ui1_asg_type = USE_DISKDEV;
+            info->ui1_refcount = 0;
+            info->ui1_usecount = 1;
+        }
+        if (level == 2)
+        {
+            ((USE_INFO_2 *)p)->ui2_username = NULL;
+            ((USE_INFO_2 *)p)->ui2_domainname = NULL;
+        }
+    }
+    *bufptr = buf;
+    *entriesread = *totalentries = count;
+    if (resumehandle) *resumehandle = count;
+    return NERR_Success;
+#endif
 }
 
 NET_API_STATUS WINAPI NetScheduleJobAdd(LPCWSTR server, LPBYTE bufptr, LPDWORD jobid)
--- a/dlls/ntlanman/ntlanman.c
+++ b/dlls/ntlanman/ntlanman.c
@@ -43,6 +43,7 @@
 WINE_DEFAULT_DEBUG_CHANNEL(mpr);
 
 static const char unc_root[] = "/run/stained-glass-net/unc/";
+static const char user_root[] = "/run/stained-glass-net/users/";
 
 static BOOL WINAPI init_unix( INIT_ONCE *once, void *param, void **context )
 {
@@ -251,15 +252,26 @@
 {
     struct get_drive_params drive;
     char unc[1024], *p;
+    const char *rest;
     DWORD len;
 
     TRACE( "%s %p %p\n", debugstr_w(local), remote, size );
     if (!drive_letter( local, &drive.letter )) return WN_NOT_CONNECTED;
     if (!unix_ready() || WINE_UNIX_CALL( unix_get_drive, &drive )) return WN_NOT_CONNECTED;
-    if (strncmp( drive.target, unc_root, strlen(unc_root) )) return WN_NOT_CONNECTED;
+    if (!strncmp( drive.target, unc_root, strlen(unc_root) )) rest = drive.target + strlen(unc_root);
+#ifndef SG_MUTANT_USER_DRIVE_UNKNOWN
+    /* Stained Glass OS: a letter on a connection made with a name and
+     * password (net use /user:, wine-sg 0474) is a link into the user's own
+     * /run/stained-glass-net/users/<uid>/unc/: it was "not connected", so
+     * NET USE, Disconnect network drive and File Explorer did not know it */
+    else if (!strncmp( drive.target, user_root, strlen(user_root) ) &&
+             (rest = strstr( drive.target + strlen(user_root), "/unc/" )))
+        rest += 5;
+#endif
+    else return WN_NOT_CONNECTED;
 
     /* /run/stained-glass-net/unc/server/share/dir -> \\server\share\dir */
-    snprintf( unc, sizeof(unc), "\\\\%s", drive.target + strlen(unc_root) );
+    snprintf( unc, sizeof(unc), "\\\\%s", rest );
     for (p = unc; *p; p++) if (*p == '/') *p = '\\';
     len = MultiByteToWideChar( CP_UTF8, 0, unc, -1, NULL, 0 );
     if (!remote || *size < len)
--- a/include/lmuse.h
+++ b/include/lmuse.h
@@ -47,6 +47,12 @@
 #define USE_CHARDEV                2
 #define USE_IPC                    3
 
+typedef struct _USE_INFO_0
+{
+    LMSTR ui0_local;
+    LMSTR ui0_remote;
+} USE_INFO_0, *PUSE_INFO_0, *LPUSE_INFO_0;
+
 typedef struct _USE_INFO_1
 {
     LMSTR ui1_local;
--- a/programs/net/net.c
+++ b/programs/net/net.c
@@ -138,9 +138,11 @@
             output_string(STRING_USE_HEADER);
             for (i = 0, connection = buffer; i < read; ++i, ++connection)
                 output_string(STRING_USE_ENTRY, status[connection->ui2_status], connection->ui2_local,
-				connection->ui2_remote, connection->ui2_refcount);
+				connection->ui2_remote);
 
             if (buffer != NULL) NetApiBufferFree(buffer);
+            /* Stained Glass OS: as Windows' NET USE ends its list */
+            if (rc == ERROR_SUCCESS) output_string(STRING_CMD_SUCCESS);
         } while (rc == ERROR_MORE_DATA);
 
         /* Release the status strings */
--- a/programs/net/net.rc
+++ b/programs/net/net.rc
@@ -44,8 +44,8 @@
     STRING_NO_ENTRIES, "There are no entries in the list.\n"
     STRING_CMD_SUCCESS, "The command completed successfully.\n"
     STRING_USE_USAGE, "Usage:\n\nNET USE [device:] [\\\\computer\\share[\\directory]]\nNET USE device: /DELETE\n"
-    STRING_USE_HEADER, "\nStatus  Local   Remote\n---------------------------------------------------------------\n"
-    STRING_USE_ENTRY,  "%1      %2      %3      Open resources: %4!u!\n"
+    STRING_USE_HEADER, "\nStatus       Local     Remote\n\n-------------------------------------------------------------------------------\n"
+    STRING_USE_ENTRY,  "%1!-13s!%2!-10s!%3\n"
     STRING_OK, "OK"
     STRING_PAUSED, "Paused"
     STRING_SESSLOST, "Disconnected"
