+    if (needs_close) close( fd );
+    if ((status = server_get_unix_name( handle, &link ))) return status;
+    if (lstat( link, &st ) == -1) status = errno_to_status( errno );
+    else if (!S_ISLNK( st.st_mode )) status = STATUS_NOT_A_REPARSE_POINT;
