+/* Stained Glass OS: symbolic links and junctions.
+ *
+ * A reparse point of tag IO_REPARSE_TAG_SYMLINK or IO_REPARSE_TAG_MOUNT_POINT
+ * becomes a Unix symbolic link in place of the empty file or directory it is
+ * set on. Stock Wine 10.0 had neither: CreateSymbolicLinkW was a stub that
+ * reported success, so the EA app's installer "linked" EA Desktop to its
+ * versioned folder, found no service binary there and rolled back
+ * (INST-14-1627); Python's os.symlink, std::filesystem::create_symlink, cmd's
+ * mklink and junction-making installers were all silently broken the same way.
+ *
+ * The link is made by this process with its own Unix rights, never by the
+ * server (ADR 0013). A relative link stays relative; its target's letter case
+ * is taken from the file system where the target exists, since the Unix
+ * kernel, not Wine, follows the link. Both tags are stored the same way, so a
+ * junction reads back as a symbolic link. */
+#ifndef SYMLINK_FLAG_RELATIVE
+#define SYMLINK_FLAG_RELATIVE 1
+#endif
+
+static const WCHAR sg_nt_prefixW[] = {'\\','?','?','\\',0};
+
+static char *sg_relative_unix_path( const char *from_dir, const char *to )
+{
+    const char *f = from_dir, *t = to, *fc, *tc;
+    size_t ups = 0, len;
+    char *ret, *p;
+
+    /* skip the common leading components */
+    for (;;)
+    {
+        while (*f == '/') f++;
+        while (*t == '/') t++;
+        if (!*f) break;
+        fc = strchr( f, '/' ); if (!fc) fc = f + strlen( f );
+        tc = strchr( t, '/' ); if (!tc) tc = t + strlen( t );
+        if (fc - f != tc - t || memcmp( f, t, fc - f )) break;
+        f = fc; t = tc;
+    }
+    for (fc = f; *fc; )
+    {
+        while (*fc == '/') fc++;
+        if (!*fc) break;
+        ups++;
+        while (*fc && *fc != '/') fc++;
+    }
+    len = ups * 3 + strlen( t ) + 2;
+    if (!(ret = malloc( len ))) return NULL;
+    for (p = ret; ups--; p += 3) memcpy( p, "../", 3 );
+    strcpy( p, t );
+    len = strlen( ret );
+    if (len && ret[len - 1] == '/') ret[len - 1] = 0;
+    if (!ret[0]) strcpy( ret, "." );
+    return ret;
+}
+
+/* "\x\.\y\..\z" -> "\x\z", past a leading "\??\X:" */
+static void sg_collapse_nt_path( WCHAR *path )
+{
+    WCHAR *start = path, *src, *dst;
+
+    if (!wcsncmp( path, sg_nt_prefixW, 4 )) start = path + 4;
+    if (start[0] && start[1] == ':') start += 2;
+    src = dst = start;
+    while (*src)
+    {
+        if (*src == '\\' && src[1] == '.' && (!src[2] || src[2] == '\\'))
+        {
+            src += 2;
+            continue;
+        }
+        if (*src == '\\' && src[1] == '.' && src[2] == '.' && (!src[3] || src[3] == '\\'))
+        {
+            src += 3;
+            while (dst > start && *--dst != '\\') ;
+            continue;
+        }
+        if (*src == '\\' && src[1] == '\\') { src++; continue; }
+        *dst++ = *src++;
+    }
+    *dst = 0;
+}
+
+static char *sg_literal_unix_path( const WCHAR *path, USHORT len )
+{
+    char *ret = malloc( len * 3 + 1 ), *p;
+    int n;
+
+    if (!ret) return NULL;
+    n = ntdll_wcstoumbs( path, len, ret, len * 3, FALSE );
+    if (n < 0) { free( ret ); return NULL; }
+    ret[n] = 0;
+    for (p = ret; *p; p++) if (*p == '\\') *p = '/';
+    return ret;
+}
+
+/* realpath() of a path whose last component may not exist yet */
+static char *sg_real_path( const char *path )
+{
+    char *ret, *dir, *real, *slash;
+
+    if ((ret = realpath( path, NULL ))) return ret;
+    if (!(dir = strdup( path )) || !(slash = strrchr( dir, '/' )) || slash == dir)
+    {
+        free( dir );
+        return NULL;
+    }
+    *slash = 0;
+    if ((real = realpath( dir, NULL )) && (ret = malloc( strlen( real ) + strlen( slash + 1 ) + 2 )))
+        sprintf( ret, "%s/%s", real, slash + 1 );
+    free( real );
+    free( dir );
+    return ret;
+}
+
+static NTSTATUS sg_reparse_unix_target( const char *link, const WCHAR *path, USHORT len, BOOL relative,
+                                        char **ret )
+{
+    UNICODE_STRING nt;
+    OBJECT_ATTRIBUTES attr;
+    WCHAR *link_nt = NULL, *buf, *sep;
+    char *abs = NULL, *dir, *real;
+    NTSTATUS status;
+    size_t prefix = 0;
+
+    *ret = NULL;
+    if (relative)
+    {
+        if (unix_to_nt_file_name( link, &link_nt ) || !(sep = wcsrchr( link_nt, '\\' )))
+        {
+            free( link_nt );
+            return (*ret = sg_literal_unix_path( path, len )) ? STATUS_SUCCESS : STATUS_NO_MEMORY;
+        }
+        prefix = sep - link_nt + 1;
+    }
+    if (!(buf = malloc( (prefix + len + 1) * sizeof(WCHAR) )))
+    {
+        free( link_nt );
+        return STATUS_NO_MEMORY;
+    }
+    if (prefix) memcpy( buf, link_nt, prefix * sizeof(WCHAR) );
+    memcpy( buf + prefix, path, len * sizeof(WCHAR) );
+    buf[prefix + len] = 0;
+    free( link_nt );
+    sg_collapse_nt_path( buf );
+
+    init_unicode_string( &nt, buf );
+    InitializeObjectAttributes( &attr, &nt, OBJ_CASE_INSENSITIVE, 0, NULL );
+    status = nt_to_unix_file_name( &attr, &abs, FILE_OPEN_IF );
+    if (status && status != STATUS_NO_SUCH_FILE) abs = NULL;
+
+    if (!abs && !relative)
+    {
+        /* a link to a path that does not exist yet: "\??\X:\rest" through the drive */
+        if (wcslen( buf ) >= 7 && !wcsncmp( buf, sg_nt_prefixW, 4 ) && buf[5] == ':' && buf[6] == '\\')
+        {
+            char *rest = sg_literal_unix_path( buf + 7, wcslen( buf + 7 ) );
+            if (rest && (abs = malloc( strlen( config_dir ) + strlen( rest ) + 32 )))
+                sprintf( abs, "%s/dosdevices/%c:/%s", config_dir, (char)towlower( buf[4] ), rest );
+            free( rest );
+        }
+        free( buf );
+        if (!abs) return STATUS_OBJECT_PATH_NOT_FOUND;
+        *ret = abs;
+        return STATUS_SUCCESS;
+    }
+    free( buf );
+    if (!abs) return (*ret = sg_literal_unix_path( path, len )) ? STATUS_SUCCESS : STATUS_NO_MEMORY;
+    if (!relative)
+    {
+        *ret = abs;
+        return STATUS_SUCCESS;
+    }
+    /* both sides as real paths: the link's directory comes from the server
+     * resolved, the target through dosdevices */
+    if ((real = sg_real_path( abs )))
+    {
+        free( abs );
+        abs = real;
+    }
+    if ((dir = strdup( link )))
+    {
+        char *slash = strrchr( dir, '/' );
+        if (slash) *slash = 0;
+        if ((real = sg_real_path( dir ))) { free( dir ); dir = real; }
+        *ret = sg_relative_unix_path( dir, abs );
+        free( dir );
+    }
+    free( abs );
+    return *ret ? STATUS_SUCCESS : STATUS_NO_MEMORY;
+}
+
+static NTSTATUS sg_set_reparse_point( HANDLE handle, const void *in, ULONG in_size )
+{
+    const BYTE *buf = in;
+    ULONG tag, hdr;
+    USHORT data_len, subst_off, subst_len;
+    BOOL relative = FALSE;
+    WCHAR *path;
+    char *link = NULL, *target = NULL;
+    struct stat st;
+    NTSTATUS status;
+    int fd, needs_close;
+
+    if (!in || in_size < 8) return STATUS_IO_REPARSE_DATA_INVALID;
+    memcpy( &tag, buf, sizeof(tag) );
+    memcpy( &data_len, buf + 4, sizeof(data_len) );
+    if (tag == IO_REPARSE_TAG_SYMLINK) hdr = 20;
+    else if (tag == IO_REPARSE_TAG_MOUNT_POINT) hdr = 16;
+    else
+    {
+        FIXME( "reparse tag %#x not supported\n", (int)tag );
+        return STATUS_IO_REPARSE_TAG_NOT_HANDLED;
+    }
+    if (8 + (ULONG)data_len > in_size || 8 + (ULONG)data_len < hdr) return STATUS_IO_REPARSE_DATA_INVALID;
+    memcpy( &subst_off, buf + 8, sizeof(subst_off) );
+    memcpy( &subst_len, buf + 10, sizeof(subst_len) );
+    if (tag == IO_REPARSE_TAG_SYMLINK)
+    {
+        ULONG flags;
+        memcpy( &flags, buf + 16, sizeof(flags) );
+        relative = (flags & SYMLINK_FLAG_RELATIVE) != 0;
+    }
+    if (!subst_len || (subst_off | subst_len) & 1 || hdr + subst_off + subst_len > 8 + (ULONG)data_len)
+        return STATUS_IO_REPARSE_DATA_INVALID;
+
+    /* the handle must allow changing the file */
+    if ((status = server_get_unix_fd( handle, FILE_WRITE_ATTRIBUTES, &fd, &needs_close, NULL, NULL )))
+        return status;
+    if (needs_close) close( fd );
+
+    if (!(path = malloc( subst_len ))) return STATUS_NO_MEMORY;
+    memcpy( path, buf + hdr + subst_off, subst_len );
+    if ((status = server_get_unix_name( handle, &link ))) goto done;
+    if ((status = sg_reparse_unix_target( link, path, subst_len / sizeof(WCHAR), relative, &target ))) goto done;
+    TRACE( "%s -> %s\n", debugstr_a(link), debugstr_a(target) );
+
+    if (lstat( link, &st ) == -1) { status = errno_to_status( errno ); goto done; }
+    if (S_ISLNK( st.st_mode ))
+    {
+        if (unlink( link ) == -1) { status = errno_to_status( errno ); goto done; }
+    }
+    else if (S_ISDIR( st.st_mode ))
+    {
+        if (rmdir( link ) == -1)
+        {
+            status = (errno == ENOTEMPTY || errno == EEXIST) ? STATUS_DIRECTORY_NOT_EMPTY : errno_to_status( errno );
+            goto done;
+        }
+    }
+    else if (S_ISREG( st.st_mode ) && !st.st_size)
+    {
+        if (unlink( link ) == -1) { status = errno_to_status( errno ); goto done; }
+    }
+    else
+    {
+        status = STATUS_IO_REPARSE_DATA_INVALID;
+        goto done;
+    }
+    if (symlink( target, link ) == -1)
+    {
+        status = errno_to_status( errno );
+        /* put the placeholder back */
+        if (S_ISDIR( st.st_mode )) mkdir( link, st.st_mode & 07777 );
+        else if (S_ISREG( st.st_mode )) close( open( link, O_CREAT | O_WRONLY, st.st_mode & 07777 ) );
+    }
+
+done:
+    free( path );
+    free( link );
+    free( target );
+    return status;
+}
+
+static NTSTATUS sg_get_reparse_point( HANDLE handle, void *out, ULONG out_size, ULONG_PTR *ret_size )
+{
+    char *link = NULL, target[PATH_MAX];
+    WCHAR *nt = NULL, *subst, *print;
+    USHORT subst_len, print_len;
+    ULONG flags = 0, total;
+    BYTE *buf;
+    ssize_t n;
+    NTSTATUS status;
+    int i;
+
+    if (!out || !out_size) return STATUS_INVALID_USER_BUFFER;
+    if ((status = server_get_unix_name( handle, &link ))) return status;
+    n = readlink( link, target, sizeof(target) - 1 );
+    free( link );
+    if (n == -1) return errno == EINVAL ? STATUS_NOT_A_REPARSE_POINT : errno_to_status( errno );
+    target[n] = 0;
+
+    if (target[0] == '/')
+    {
+        if ((status = unix_to_nt_file_name( target, &nt ))) return status;
+        subst = nt;
+        subst_len = wcslen( nt ) * sizeof(WCHAR);
+        print = nt + 4;  /* without "\??\" */
+        print_len = subst_len - 4 * sizeof(WCHAR);
+    }
+    else
+    {
+        if (!(nt = malloc( (n + 1) * sizeof(WCHAR) ))) return STATUS_NO_MEMORY;
+        i = ntdll_umbstowcs( target, n, nt, n );
+        nt[i] = 0;
+        for (i = 0; nt[i]; i++) if (nt[i] == '/') nt[i] = '\\';
+        subst = print = nt;
+        subst_len = print_len = wcslen( nt ) * sizeof(WCHAR);
+        flags = SYMLINK_FLAG_RELATIVE;
+    }
+
+    total = 20 + subst_len + print_len;
+    if (!(buf = calloc( 1, total ))) { free( nt ); return STATUS_NO_MEMORY; }
+    *(ULONG *)buf = IO_REPARSE_TAG_SYMLINK;
+    *(USHORT *)(buf + 4) = total - 8;
+    *(USHORT *)(buf + 8) = 0;                /* SubstituteNameOffset */
+    *(USHORT *)(buf + 10) = subst_len;
+    *(USHORT *)(buf + 12) = subst_len;       /* PrintNameOffset */
+    *(USHORT *)(buf + 14) = print_len;
+    *(ULONG *)(buf + 16) = flags;
+    memcpy( buf + 20, subst, subst_len );
+    memcpy( buf + 20 + subst_len, print, print_len );
+    free( nt );
+
+    if (out_size < 20) status = STATUS_BUFFER_TOO_SMALL;
+    else
+    {
+        *ret_size = min( total, out_size );
+        memcpy( out, buf, *ret_size );
