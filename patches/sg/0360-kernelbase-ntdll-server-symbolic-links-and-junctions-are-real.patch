+static NTSTATUS sg_delete_reparse_point( HANDLE handle, const void *in, ULONG in_size )
+{
+    char *link = NULL;
+    struct stat st, target_st;
+    BOOL dir;
+    NTSTATUS status;
+    int fd, needs_close;
+
+    if (!in || in_size < 8) return STATUS_IO_REPARSE_DATA_INVALID;
+    if ((status = server_get_unix_fd( handle, FILE_WRITE_ATTRIBUTES, &fd, &needs_close, NULL, NULL )))
