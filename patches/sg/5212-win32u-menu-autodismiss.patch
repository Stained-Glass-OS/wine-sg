From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] win32u: MNS_AUTODISMISS

A menu with MNS_AUTODISMISS ends its tracking after ten seconds with the
mouse outside it. CORE: integrator must review (patches/notes/5212.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/win32u/menu.c b/dlls/win32u/menu.c
--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -875,7 +875,6 @@
 
     if (info->fMask & MIM_STYLE)
     {
-        if (info->dwStyle & MNS_AUTODISMISS) FIXME("MNS_AUTODISMISS unimplemented\n");
         if (info->dwStyle & MNS_DRAGDROP) FIXME("MNS_DRAGDROP unimplemented\n");
         if (info->dwStyle & MNS_MODELESS) FIXME("MNS_MODELESS unimplemented\n");
     }
@@ -4106,8 +4105,37 @@
     return -1;
 }
 
+/* Stained Glass OS: MNS_AUTODISMISS, the menu ends when the mouse has been outside it for about
+ * ten seconds.  Returns the milliseconds left (INFINITE when the style is not set), 0 when over. */
+#define MENU_AUTODISMISS_MS 10000
+static DWORD menu_autodismiss_left( HMENU top, DWORD *outside_since )
+{
+    struct menu *menu = unsafe_menu_ptr( top );
+    DWORD now, passed;
+    POINT pt;
+
+    if (!menu || !(menu->dwStyle & MNS_AUTODISMISS)) return INFINITE;
+    NtUserGetCursorPos( &pt );
+    now = NtGetTickCount();
+#ifdef SG_MUTANT_MENU_NORESET
+    if (menu_from_point( top, pt )) ;
+#else
+    if (menu_from_point( top, pt )) *outside_since = 0;
+#endif
+    else if (!*outside_since) *outside_since = now ? now : 1;
+    TRACE( "autodismiss top %p pt %s outside_since %lu now %lu\n", top, wine_dbgstr_point( &pt ), (long)*outside_since, (long)now );
+    if (!*outside_since) return MENU_AUTODISMISS_MS;
+    passed = now - *outside_since;
+#ifdef SG_MUTANT_MENU_NODISMISS
+    return INFINITE;
+#endif
+    return passed >= MENU_AUTODISMISS_MS ? 0 : MENU_AUTODISMISS_MS - passed;
+}
+
 static BOOL track_menu( HMENU hmenu, UINT flags, int x, int y, HWND hwnd, const RECT *rect )
 {
+    DWORD outside_since = 0;
+    BOOL dismissed = FALSE;
     BOOL enter_idle_sent = FALSE;
     int executed_menu_id = -1;
     HWND capture_win;
@@ -4165,16 +4193,26 @@
             }
             else
             {
+                DWORD wait_ms;
+
                 if (!enter_idle_sent)
                 {
                     HWND win = (menu->wFlags & MF_POPUP) ? menu->hWnd : 0;
                     enter_idle_sent = TRUE;
                     send_message( mt.hOwnerWnd, WM_ENTERIDLE, MSGF_MENU, (LPARAM)win );
                 }
-                NtUserMsgWaitForMultipleObjectsEx( 0, NULL, INFINITE, QS_ALLINPUT, 0 );
+                wait_ms = menu_autodismiss_left( mt.hTopMenu, &outside_since );
+                if (!wait_ms) { dismissed = TRUE; break; }
+                NtUserMsgWaitForMultipleObjectsEx( 0, NULL, wait_ms, QS_ALLINPUT, 0 );
             }
         }
 
+        if (dismissed)
+        {
+            exit_menu = TRUE;
+            break;
+        }
+
         /* check if NtUserEndMenu() tried to cancel us, by posting this message */
         if (msg.message == WM_CANCELMODE)
         {
