From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 22:24:42 -0700
Subject: [PATCH] scrobj: connection point and connection enumerators (3287)

IConnectionPointContainer::EnumConnectionPoints and IConnectionPoint::EnumConnections of a script component instance return enumerators (the one event connection point, and a snapshot of the connected sinks with their cookies) instead of E_NOTIMPL.

diff --git a/dlls/scrobj/scrobj.c b/dlls/scrobj/scrobj.c
index 7925206..5204328 100644
--- a/dlls/scrobj/scrobj.c
+++ b/dlls/scrobj/scrobj.c
@@ -768,6 +768,7 @@ static HRESULT WINAPI ActiveScriptSite_OnStateChange(IActiveScriptSite *iface, S
 
     TRACE("(%p, %d)\n", This, state);
 
+    /* Windows' scrobj answers E_NOTIMPL (Wine's conformance test records it) */
     return E_NOTIMPL;
 }
 
@@ -1593,10 +1594,238 @@ static ULONG WINAPI instance_cpc_Release(IConnectionPointContainer *iface)
     return scriptlet_Release(&impl_from_instance_IConnectionPointContainer(iface)->IDispatchEx_iface);
 }
 
+/* the enumerators of the component's connection points and of a connection point's sinks: snapshots */
+struct enum_cps
+{
+    IEnumConnectionPoints IEnumConnectionPoints_iface;
+    LONG ref;
+    IConnectionPoint *cp;
+    ULONG pos;
+};
+
+static inline struct enum_cps *impl_from_IEnumConnectionPoints(IEnumConnectionPoints *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_cps, IEnumConnectionPoints_iface);
+}
+
+static HRESULT WINAPI enum_cps_QueryInterface(IEnumConnectionPoints *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumConnectionPoints))
+    {
+        IEnumConnectionPoints_AddRef(iface);
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_cps_AddRef(IEnumConnectionPoints *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumConnectionPoints(iface)->ref);
+}
+
+static ULONG WINAPI enum_cps_Release(IEnumConnectionPoints *iface)
+{
+    struct enum_cps *This = impl_from_IEnumConnectionPoints(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        IConnectionPoint_Release(This->cp);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enum_cps_Next(IEnumConnectionPoints *iface, ULONG count, IConnectionPoint **cps, ULONG *fetched)
+{
+    struct enum_cps *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG n = 0;
+
+    if (!cps || (!fetched && count != 1)) return E_POINTER;
+#ifdef SG_MUTANT_SCROBJ_ENUMCP
+    This->pos = 1;
+#endif
+    if (count && !This->pos)
+    {
+        IConnectionPoint_AddRef((cps[0] = This->cp));
+        This->pos = 1;
+        n = 1;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_cps_Skip(IEnumConnectionPoints *iface, ULONG count)
+{
+    struct enum_cps *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG left = This->pos ? 0 : 1;
+
+    if (count) This->pos = 1;
+    return count > left ? S_FALSE : S_OK;
+}
+
+static HRESULT WINAPI enum_cps_Reset(IEnumConnectionPoints *iface)
+{
+    impl_from_IEnumConnectionPoints(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_cps_Clone(IEnumConnectionPoints *iface, IEnumConnectionPoints **ret)
+{
+    struct enum_cps *This = impl_from_IEnumConnectionPoints(iface), *copy;
+
+    if (!ret) return E_POINTER;
+    if (!(copy = malloc(sizeof(*copy)))) return E_OUTOFMEMORY;
+    *copy = *This;
+    copy->ref = 1;
+    IConnectionPoint_AddRef(copy->cp);
+    *ret = &copy->IEnumConnectionPoints_iface;
+    return S_OK;
+}
+
+static const IEnumConnectionPointsVtbl enum_cps_vtbl =
+{
+    enum_cps_QueryInterface,
+    enum_cps_AddRef,
+    enum_cps_Release,
+    enum_cps_Next,
+    enum_cps_Skip,
+    enum_cps_Reset,
+    enum_cps_Clone
+};
+
+struct enum_conns
+{
+    IEnumConnections IEnumConnections_iface;
+    LONG ref;
+    CONNECTDATA *data;
+    ULONG count, pos;
+};
+
+static inline struct enum_conns *impl_from_IEnumConnections(IEnumConnections *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_conns, IEnumConnections_iface);
+}
+
+static HRESULT WINAPI enum_conns_QueryInterface(IEnumConnections *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumConnections))
+    {
+        IEnumConnections_AddRef(iface);
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_conns_AddRef(IEnumConnections *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumConnections(iface)->ref);
+}
+
+static ULONG WINAPI enum_conns_Release(IEnumConnections *iface)
+{
+    struct enum_conns *This = impl_from_IEnumConnections(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    ULONG i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) IUnknown_Release(This->data[i].pUnk);
+        free(This->data);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enum_conns_Next(IEnumConnections *iface, ULONG count, CONNECTDATA *out, ULONG *fetched)
+{
+    struct enum_conns *This = impl_from_IEnumConnections(iface);
+    ULONG n = 0;
+
+    if (!out || (!fetched && count != 1)) return E_POINTER;
+    while (n < count && This->pos < This->count)
+    {
+        out[n] = This->data[This->pos++];
+        IUnknown_AddRef(out[n].pUnk);
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_conns_Skip(IEnumConnections *iface, ULONG count)
+{
+    struct enum_conns *This = impl_from_IEnumConnections(iface);
+
+    if (count > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_conns_Reset(IEnumConnections *iface)
+{
+    impl_from_IEnumConnections(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_conns_Clone(IEnumConnections *iface, IEnumConnections **ret)
+{
+    struct enum_conns *This = impl_from_IEnumConnections(iface), *copy;
+    ULONG i;
+
+    if (!ret) return E_POINTER;
+    if (!(copy = calloc(1, sizeof(*copy)))) return E_OUTOFMEMORY;
+    if (This->count && !(copy->data = malloc(This->count * sizeof(*copy->data))))
+    {
+        free(copy);
+        return E_OUTOFMEMORY;
+    }
+    copy->IEnumConnections_iface.lpVtbl = This->IEnumConnections_iface.lpVtbl;
+    copy->ref = 1;
+    copy->count = This->count;
+    copy->pos = This->pos;
+    for (i = 0; i < This->count; i++)
+    {
+        copy->data[i] = This->data[i];
+        IUnknown_AddRef(copy->data[i].pUnk);
+    }
+    *ret = &copy->IEnumConnections_iface;
+    return S_OK;
+}
+
+static const IEnumConnectionsVtbl enum_conns_vtbl =
+{
+    enum_conns_QueryInterface,
+    enum_conns_AddRef,
+    enum_conns_Release,
+    enum_conns_Next,
+    enum_conns_Skip,
+    enum_conns_Reset,
+    enum_conns_Clone
+};
+
 static HRESULT WINAPI instance_cpc_EnumConnectionPoints(IConnectionPointContainer *iface, IEnumConnectionPoints **ret)
 {
-    FIXME("(%p)\n", ret);
-    return E_NOTIMPL;
+    struct scriptlet_instance *This = impl_from_instance_IConnectionPointContainer(iface);
+    struct enum_cps *e;
+
+    TRACE("(%p)->(%p)\n", This, ret);
+
+    if (!ret) return E_POINTER;
+    if (!(e = calloc(1, sizeof(*e)))) return E_OUTOFMEMORY;
+    e->IEnumConnectionPoints_iface.lpVtbl = &enum_cps_vtbl;
+    e->ref = 1;
+    IConnectionPoint_AddRef((e->cp = &This->IConnectionPoint_iface));
+    *ret = &e->IEnumConnectionPoints_iface;
+    return S_OK;
 }
 
 static HRESULT WINAPI instance_cpc_FindConnectionPoint(IConnectionPointContainer *iface, REFIID riid, IConnectionPoint **ret)
@@ -1713,8 +1942,33 @@ static HRESULT WINAPI instance_cp_Unadvise(IConnectionPoint *iface, DWORD cookie
 
 static HRESULT WINAPI instance_cp_EnumConnections(IConnectionPoint *iface, IEnumConnections **ret)
 {
-    FIXME("(%p)\n", ret);
-    return E_NOTIMPL;
+    struct scriptlet_instance *This = impl_from_instance_IConnectionPoint(iface);
+    struct enum_conns *e;
+    ULONG i;
+
+    TRACE("(%p)->(%p)\n", This, ret);
+
+    if (!ret) return E_POINTER;
+    if (!(e = calloc(1, sizeof(*e)))) return E_OUTOFMEMORY;
+    e->IEnumConnections_iface.lpVtbl = &enum_conns_vtbl;
+    e->ref = 1;
+    if (This->sink_count && !(e->data = calloc(This->sink_count, sizeof(*e->data))))
+    {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < This->sink_count; i++)
+    {
+        if (!This->sinks[i]) continue;
+#ifndef SG_MUTANT_SCROBJ_ENUMCONN
+        e->data[e->count].pUnk = (IUnknown *)This->sinks[i];
+        e->data[e->count].dwCookie = i + 1;
+        IUnknown_AddRef(e->data[e->count].pUnk);
+        e->count++;
+#endif
+    }
+    *ret = &e->IEnumConnections_iface;
+    return S_OK;
 }
 
 static const IConnectionPointVtbl instance_cp_vtbl =
