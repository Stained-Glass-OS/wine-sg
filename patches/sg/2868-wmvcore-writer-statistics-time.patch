From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmvcore: IWMWriterAdvanced statistics and writer time

GetWriterTime (0 while idle), GetStatistics and GetStatisticsEx: NULL is
E_INVALIDARG, no profile NS_E_INVALIDPROFILE, an absent stream E_INVALIDARG
(stream 0 is the whole profile); idle statistics are zero except the expected
bit rate taken from the profile's stream bit rates.
---
diff --git a/dlls/wmvcore/writer.c b/dlls/wmvcore/writer.c
index 88c442e..1bf50f2 100644
--- a/dlls/wmvcore/writer.c
+++ b/dlls/wmvcore/writer.c
@@ -33,6 +33,7 @@ struct writer_input
     WM_MEDIA_TYPE *stream_mt;   /* the media type of the profile's stream, if it has one */
     WCHAR *connection;
     WM_MEDIA_TYPE *chosen;      /* set by SetInputProps */
+    DWORD bitrate;              /* the stream's bit rate in the profile */
 };
 
 typedef struct {
@@ -471,6 +472,7 @@ static HRESULT writer_load_inputs(WMWriter *writer, IWMProfile *profile)
             return hr;
         IWMStreamConfig_GetStreamType(config, &input->type);
         IWMStreamConfig_GetStreamNumber(config, &input->stream_number);
+        IWMStreamConfig_GetBitrate(config, &input->bitrate);
         if (SUCCEEDED(IWMStreamConfig_GetConnectionName(config, NULL, &len)) && len > 1
                 && (input->connection = malloc(len * sizeof(WCHAR))))
             IWMStreamConfig_GetConnectionName(config, input->connection, &len);
@@ -1059,15 +1061,61 @@ static HRESULT WINAPI WMWriterAdvanced_IsRealTime(IWMWriterAdvanced3 *iface, BOO
 static HRESULT WINAPI WMWriterAdvanced_GetWriterTime(IWMWriterAdvanced3 *iface, QWORD *current_time)
 {
     WMWriter *This = impl_from_IWMWriterAdvanced3(iface);
-    FIXME("(%p)->(%p)\n", This, current_time);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, current_time);
+
+    if (!current_time)
+        return E_INVALIDARG;
+    /* Writing never starts here: the writer time stays at its start. */
+    *current_time = 0;
+    return S_OK;
+}
+
+/* The bit rate the profile expects for one stream (0 for all of them). */
+static HRESULT writer_expected_bitrate(WMWriter *This, WORD stream_num, DWORD *bitrate)
+{
+    HRESULT hr = S_OK;
+    DWORD i;
+
+    *bitrate = 0;
+    EnterCriticalSection(&This->cs);
+    if (!This->profile)
+        hr = NS_E_INVALIDPROFILE;
+    else if (stream_num)
+    {
+        hr = E_INVALIDARG;
+        for (i = 0; i < This->input_count; i++)
+            if (This->inputs[i].stream_number == stream_num)
+            {
+                *bitrate = This->inputs[i].bitrate;
+                hr = S_OK;
+            }
+    }
+    else
+        for (i = 0; i < This->input_count; i++)
+            *bitrate += This->inputs[i].bitrate;
+    LeaveCriticalSection(&This->cs);
+    return hr;
 }
 
 static HRESULT WINAPI WMWriterAdvanced_GetStatistics(IWMWriterAdvanced3 *iface, WORD stream_num, WM_WRITER_STATISTICS *stats)
 {
     WMWriter *This = impl_from_IWMWriterAdvanced3(iface);
-    FIXME("(%p)->(%u %p)\n", This, stream_num, stats);
-    return E_NOTIMPL;
+    DWORD bitrate;
+    HRESULT hr;
+
+    TRACE("(%p)->(%u %p)\n", This, stream_num, stats);
+
+    if (!stats)
+        return E_INVALIDARG;
+    if (FAILED(hr = writer_expected_bitrate(This, stream_num, &bitrate)))
+        return hr;
+    /* Nothing was written: only the expected bit rate is known. */
+    memset(stats, 0, sizeof(*stats));
+#ifndef SG_MUTANT_WMVW_NOEXPECTED
+    stats->dwExpectedBitrate = bitrate;
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI WMWriterAdvanced_SetSyncTolerance(IWMWriterAdvanced3 *iface, DWORD window)
@@ -1117,8 +1165,18 @@ static HRESULT WINAPI WMWriterAdvanced3_GetStatisticsEx(IWMWriterAdvanced3 *ifac
         WM_WRITER_STATISTICS_EX *stats)
 {
     WMWriter *This = impl_from_IWMWriterAdvanced3(iface);
-    FIXME("(%p)->(%u %p)\n", This, stream_num, stats);
-    return E_NOTIMPL;
+    DWORD bitrate;
+    HRESULT hr;
+
+    TRACE("(%p)->(%u %p)\n", This, stream_num, stats);
+
+    if (!stats)
+        return E_INVALIDARG;
+    if (FAILED(hr = writer_expected_bitrate(This, stream_num, &bitrate)))
+        return hr;
+    /* No samples were written, so none were dropped and there is no overhead. */
+    memset(stats, 0, sizeof(*stats));
+    return S_OK;
 }
 
 static HRESULT WINAPI WMWriterAdvanced3_SetNonBlocking(IWMWriterAdvanced3 *iface)
