From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.networking.hostname: IHostNameStatics and IStringable (3665)

windows.networking.hostname: IHostNameStatics and IStringable

The HostName activation factory also exposes IHostNameStatics (Compare is a
case-insensitive ordinal comparison returning the sign) and HostName objects
expose IStringable (ToString returns the display name). GetIids lists both.
---
diff --git a/dlls/windows.networking.hostname/hostname.c b/dlls/windows.networking.hostname/hostname.c
index 4e1d509..69d5caf 100644
--- a/dlls/windows.networking.hostname/hostname.c
+++ b/dlls/windows.networking.hostname/hostname.c
@@ -30,6 +30,7 @@ struct hostname_statics
 {
     IActivationFactory IActivationFactory_iface;
     IHostNameFactory IHostNameFactory_iface;
+    IHostNameStatics IHostNameStatics_iface;
     LONG ref;
 };
 
@@ -61,6 +62,13 @@ static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID
         return S_OK;
     }
 
+    if (IsEqualGUID( iid, &IID_IHostNameStatics ))
+    {
+        *out = &impl->IHostNameStatics_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
     FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
@@ -82,19 +90,15 @@ static ULONG WINAPI factory_Release( IActivationFactory *iface )
     return ref;
 }
 
-static HRESULT get_one_iid( const GUID *iid, ULONG *iid_count, IID **iids )
-{
-    if (!iid_count || !iids) return E_POINTER;
-    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
-    **iids = *iid;
-    *iid_count = 1;
-    return S_OK;
-}
-
 static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
 {
     TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
-    return get_one_iid( &IID_IHostNameFactory, iid_count, iids );
+    if (!iid_count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( 2 * sizeof(IID) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IHostNameFactory;
+    (*iids)[1] = IID_IHostNameStatics;
+    *iid_count = 2;
+    return S_OK;
 }
 
 static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
@@ -135,6 +139,7 @@ static const struct IActivationFactoryVtbl factory_vtbl =
 struct hostname
 {
     IHostName IHostName_iface;
+    IStringable IStringable_iface;
     LONG ref;
 
     HSTRING raw_name;
@@ -161,6 +166,13 @@ static HRESULT WINAPI hostname_QueryInterface( IHostName *iface, REFIID iid, voi
         return S_OK;
     }
 
+    if (IsEqualGUID( iid, &IID_IStringable ))
+    {
+        *out = &impl->IStringable_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
     FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
@@ -193,7 +205,12 @@ static ULONG WINAPI hostname_Release( IHostName *iface )
 static HRESULT WINAPI hostname_GetIids( IHostName *iface, ULONG *iid_count, IID **iids )
 {
     TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
-    return get_one_iid( &IID_IHostName, iid_count, iids );
+    if (!iid_count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( 2 * sizeof(IID) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IHostName;
+    (*iids)[1] = IID_IStringable;
+    *iid_count = 2;
+    return S_OK;
 }
 
 static HRESULT WINAPI hostname_GetRuntimeClassName( IHostName *iface, HSTRING *class_name )
@@ -327,6 +344,35 @@ static const struct IHostNameVtbl hostname_vtbl =
     hostname_IsEqual,
 };
 
+DEFINE_IINSPECTABLE( hostname_stringable, IStringable, struct hostname, IHostName_iface )
+
+/* IStringable::ToString is the display name, which is the raw name */
+static HRESULT WINAPI hostname_stringable_ToString( IStringable *iface, HSTRING *value )
+{
+    struct hostname *impl = impl_from_IStringable( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_INVALIDARG;
+#ifdef SG_MUTANT_HOST_TOSTRING
+    return WindowsCreateString( L"x", 1, value );
+#endif
+    return WindowsDuplicateString( impl->raw_name, value );
+}
+
+static const struct IStringableVtbl hostname_stringable_vtbl =
+{
+    hostname_stringable_QueryInterface,
+    hostname_stringable_AddRef,
+    hostname_stringable_Release,
+    /* IInspectable methods */
+    hostname_stringable_GetIids,
+    hostname_stringable_GetRuntimeClassName,
+    hostname_stringable_GetTrustLevel,
+    /* IStringable methods */
+    hostname_stringable_ToString,
+};
+
 DEFINE_IINSPECTABLE( hostname_factory, IHostNameFactory, struct hostname_statics, IActivationFactory_iface )
 
 static HRESULT WINAPI hostname_factory_CreateHostName( IHostNameFactory *iface, HSTRING name, IHostName **value )
@@ -340,6 +386,7 @@ static HRESULT WINAPI hostname_factory_CreateHostName( IHostNameFactory *iface,
     if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
 
     impl->IHostName_iface.lpVtbl = &hostname_vtbl;
+    impl->IStringable_iface.lpVtbl = &hostname_stringable_vtbl;
     impl->ref = 1;
     WindowsDuplicateString( name, &impl->raw_name );
 
@@ -361,10 +408,50 @@ static const struct IHostNameFactoryVtbl hostname_factory_vtbl =
     hostname_factory_CreateHostName,
 };
 
+DEFINE_IINSPECTABLE( hostname_statics, IHostNameStatics, struct hostname_statics, IActivationFactory_iface )
+
+/* HostName.Compare: case-insensitive ordinal comparison; callers use the sign of the result
+ * (the exact magnitude is not documented: -1/0/1 here). */
+static HRESULT WINAPI hostname_statics_Compare( IHostNameStatics *iface, HSTRING value1, HSTRING value2,
+                                                INT32 *result )
+{
+    const WCHAR *a, *b;
+    UINT32 la, lb;
+    int cmp;
+
+    TRACE( "iface %p, value1 %s, value2 %s, result %p.\n", iface, debugstr_hstring( value1 ),
+           debugstr_hstring( value2 ), result );
+
+    if (!result) return E_INVALIDARG;
+    a = WindowsGetStringRawBuffer( value1, &la );
+    b = WindowsGetStringRawBuffer( value2, &lb );
+    cmp = CompareStringOrdinal( a, la, b, lb, TRUE );
+    if (!cmp) return HRESULT_FROM_WIN32( GetLastError() );
+#ifdef SG_MUTANT_HOST_CASE
+    cmp = CompareStringOrdinal( a, la, b, lb, FALSE );
+#endif
+    *result = cmp - CSTR_EQUAL;
+    return S_OK;
+}
+
+static const struct IHostNameStaticsVtbl hostname_statics_vtbl =
+{
+    hostname_statics_QueryInterface,
+    hostname_statics_AddRef,
+    hostname_statics_Release,
+    /* IInspectable methods */
+    hostname_statics_GetIids,
+    hostname_statics_GetRuntimeClassName,
+    hostname_statics_GetTrustLevel,
+    /* IHostNameStatics methods */
+    hostname_statics_Compare,
+};
+
 static struct hostname_statics hostname_statics =
 {
     {&factory_vtbl},
     {&hostname_factory_vtbl},
+    {&hostname_statics_vtbl},
     1,
 };
 
diff --git a/dlls/windows.networking.hostname/tests/hostname.c b/dlls/windows.networking.hostname/tests/hostname.c
index 3e0fe79..26af82a 100644
--- a/dlls/windows.networking.hostname/tests/hostname.c
+++ b/dlls/windows.networking.hostname/tests/hostname.c
@@ -103,6 +103,64 @@ static void test_HostName_properties( IHostNameFactory *factory, IHostName *ipna
     ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
 }
 
+static void test_statics_and_stringable( IActivationFactory *factory, IHostName *hostname )
+{
+    static const struct { const WCHAR *a, *b; int sign; } cmps[] =
+    {
+        { L"WineHQ.org", L"winehq.ORG", 0 },
+        { L"abc", L"abd", -1 },
+        { L"b", L"A", 1 },
+        { L"", L"", 0 },
+        { L"a", L"", 1 },
+    };
+    IHostNameStatics *statics;
+    IStringable *stringable;
+    HSTRING_HEADER h1, h2;
+    HSTRING s1, s2, text;
+    IID *iids;
+    ULONG count;
+    INT32 res;
+    HRESULT hr;
+    int i, cmp;
+
+    hr = IActivationFactory_QueryInterface( factory, &IID_IHostNameStatics, (void **)&statics );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    for (i = 0; i < ARRAY_SIZE(cmps); i++)
+    {
+        WindowsCreateStringReference( cmps[i].a, wcslen( cmps[i].a ), &h1, &s1 );
+        WindowsCreateStringReference( cmps[i].b, wcslen( cmps[i].b ), &h2, &s2 );
+        res = 0x1234;
+        hr = IHostNameStatics_Compare( statics, s1, s2, &res );
+        ok( hr == S_OK, "%d: got hr %#lx.\n", i, hr );
+        ok( (res < 0 ? -1 : res > 0 ? 1 : 0) == cmps[i].sign, "%d: got result %d.\n", i, res );
+    }
+    WindowsCreateStringReference( L"x", 1, &h1, &s1 );
+    hr = IHostNameStatics_Compare( statics, s1, s1, NULL );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = IHostNameStatics_Compare( statics, NULL, s1, &res );
+    ok( hr == S_OK && res < 0, "got hr %#lx, res %d.\n", hr, res );
+
+    hr = IHostNameStatics_GetIids( statics, &count, &iids );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( count == 2, "got count %lu.\n", count );
+    CoTaskMemFree( iids );
+    IHostNameStatics_Release( statics );
+
+    hr = IHostName_QueryInterface( hostname, &IID_IStringable, (void **)&stringable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IStringable_ToString( stringable, NULL );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = IStringable_ToString( stringable, &text );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IHostName_get_DisplayName( hostname, &s2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    WindowsCompareStringOrdinal( text, s2, &cmp );
+    ok( !cmp, "got ToString %s.\n", debugstr_hstring( text ) );
+    WindowsDeleteString( text );
+    WindowsDeleteString( s2 );
+    IStringable_Release( stringable );
+}
+
 static void test_HostnameStatics(void)
 {
     static const WCHAR *hostname_statics_name = L"Windows.Networking.HostName";
@@ -162,6 +220,7 @@ static void test_HostnameStatics(void)
     ok( str != rawname, "got same HSTRINGs %p, %p.\n", str, rawname );
 
     test_HostName_properties( hostnamefactory, hostname );
+    test_statics_and_stringable( factory, hostname );
 
     WindowsDeleteString( str );
     WindowsDeleteString( rawname );
