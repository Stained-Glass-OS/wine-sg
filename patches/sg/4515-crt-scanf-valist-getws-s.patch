diff --git a/dlls/msvcrt/file.c b/dlls/msvcrt/file.c
index b21d448..85f9292 100644
--- a/dlls/msvcrt/file.c
+++ b/dlls/msvcrt/file.c
@@ -4901,6 +4901,49 @@ wchar_t* CDECL _getws(wchar_t* buf)
     return ws;
 }
 
+#if _MSVCR_VER>=80
+/*********************************************************************
+ *		_getws_s (MSVCR80.@)
+ */
+wchar_t * CDECL _getws_s(wchar_t *buf, size_t len)
+{
+    wchar_t *buf_start = buf;
+    wint_t cc;
+
+    if (!MSVCRT_CHECK_PMT(buf != NULL)) return NULL;
+    if (!MSVCRT_CHECK_PMT(len != 0)) return NULL;
+
+    _lock_file(stdin);
+    for (cc = _fgetwc_nolock(stdin); len != 0 && cc != WEOF && cc != '\n';
+         cc = _fgetwc_nolock(stdin))
+    {
+        if (cc != '\r')
+        {
+            *buf++ = (wchar_t)cc;
+            len--;
+        }
+    }
+    _unlock_file(stdin);
+
+    if (!len)
+    {
+        *buf_start = 0;
+        _invalid_parameter(NULL, NULL, NULL, 0, 0);
+        return NULL;
+    }
+
+    if ((cc == WEOF) && (buf_start == buf))
+    {
+        TRACE(":nothing read\n");
+        return NULL;
+    }
+    *buf = '\0';
+
+    TRACE("got %s\n", debugstr_w(buf_start));
+    return buf_start;
+}
+#endif
+
 /*********************************************************************
  *		putc (MSVCRT.@)
  */
diff --git a/dlls/msvcrt/scanf.c b/dlls/msvcrt/scanf.c
index c776497..5b89ffd 100644
--- a/dlls/msvcrt/scanf.c
+++ b/dlls/msvcrt/scanf.c
@@ -817,4 +817,107 @@ int CDECL vswscanf(const wchar_t *buffer, const wchar_t *format, va_list valist)
     return vswscanf_l(buffer, format, NULL, valist);
 }
 
+/*********************************************************************
+ *		vfscanf (MSVCR120.@)
+ */
+int CDECL vfscanf(FILE *file, const char *format, va_list valist)
+{
+    if (!MSVCRT_CHECK_PMT(file != NULL && format != NULL)) return EOF;
+
+    return vfscanf_l(file, format, NULL, valist);
+}
+
+/*********************************************************************
+ *		vfscanf_s (MSVCR120.@)
+ */
+int CDECL vfscanf_s(FILE *file, const char *format, va_list valist)
+{
+    if (!MSVCRT_CHECK_PMT(file != NULL && format != NULL)) return EOF;
+
+    return vfscanf_s_l(file, format, NULL, valist);
+}
+
+/*********************************************************************
+ *		vfwscanf (MSVCR120.@)
+ */
+int CDECL vfwscanf(FILE *file, const wchar_t *format, va_list valist)
+{
+    if (!MSVCRT_CHECK_PMT(file != NULL && format != NULL)) return EOF;
+
+    return vfwscanf_l(file, format, NULL, valist);
+}
+
+/*********************************************************************
+ *		vfwscanf_s (MSVCR120.@)
+ */
+int CDECL vfwscanf_s(FILE *file, const wchar_t *format, va_list valist)
+{
+    if (!MSVCRT_CHECK_PMT(file != NULL && format != NULL)) return EOF;
+
+    return vfwscanf_s_l(file, format, NULL, valist);
+}
+
+/*********************************************************************
+ *		vscanf (MSVCR120.@)
+ */
+int CDECL vscanf(const char *format, va_list valist)
+{
+    if (!MSVCRT_CHECK_PMT(format != NULL)) return EOF;
+
+    return vfscanf_l(stdin, format, NULL, valist);
+}
+
+/*********************************************************************
+ *		vscanf_s (MSVCR120.@)
+ */
+int CDECL vscanf_s(const char *format, va_list valist)
+{
+    if (!MSVCRT_CHECK_PMT(format != NULL)) return EOF;
+
+    return vfscanf_s_l(stdin, format, NULL, valist);
+}
+
+/*********************************************************************
+ *		vwscanf (MSVCR120.@)
+ */
+int CDECL vwscanf(const wchar_t *format, va_list valist)
+{
+    if (!MSVCRT_CHECK_PMT(format != NULL)) return EOF;
+
+    return vfwscanf_l(stdin, format, NULL, valist);
+}
+
+/*********************************************************************
+ *		vwscanf_s (MSVCR120.@)
+ */
+int CDECL vwscanf_s(const wchar_t *format, va_list valist)
+{
+    if (!MSVCRT_CHECK_PMT(format != NULL)) return EOF;
+
+    return vfwscanf_s_l(stdin, format, NULL, valist);
+}
+
+/*********************************************************************
+ *		vsscanf_s (MSVCR120.@)
+ */
+int CDECL vsscanf_s(const char *buffer, const char *format, va_list valist)
+{
+    if (!MSVCRT_CHECK_PMT(buffer != NULL && format != NULL)) return EOF;
+
+#ifdef SG_MUTANT_VSSCANF_S_NOT_SECURE
+    return vsscanf_l(buffer, format, NULL, valist);
+#endif
+    return vsscanf_s_l(buffer, format, NULL, valist);
+}
+
+/*********************************************************************
+ *		vswscanf_s (MSVCR120.@)
+ */
+int CDECL vswscanf_s(const wchar_t *buffer, const wchar_t *format, va_list valist)
+{
+    if (!MSVCRT_CHECK_PMT(buffer != NULL && format != NULL)) return EOF;
+
+    return vswscanf_s_l(buffer, format, NULL, valist);
+}
+
 #endif /* _MSVCR_VER>=120 */
