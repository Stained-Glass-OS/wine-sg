diff --git a/dlls/msvcp90/misc.c b/dlls/msvcp90/misc.c
index 89fbd2c..9efb41a 100644
--- a/dlls/msvcp90/misc.c
+++ b/dlls/msvcp90/misc.c
@@ -811,6 +811,31 @@ int __cdecl _Mtx_trylock(_Mtx_arg_t mtx)
     return 0;
 }
 
+/* waits for the lock until xt; _Thrd_timedout (2) when it does not come */
+int __cdecl _Mtx_timedlock(_Mtx_arg_t mtx, const xtime *xt)
+{
+    _Mtx_t m = MTX_T_FROM_ARG(mtx);
+
+    TRACE("(%p %p)\n", mtx, xt);
+
+    if(m->thread_id == GetCurrentThreadId()) {
+        if(!(m->flags & MTX_RECURSIVE) && m->flags != MTX_PLAIN)
+            return MTX_LOCKED;
+        m->count++;
+        return 0;
+    }
+    while(!cs_trylock(&m->cs)) {
+#ifndef SG_MUTANT_TIMEDLOCK_NO_WAIT
+        if(_Xtime_diff_to_millis(xt) <= 0)
+#endif
+            return 2;
+        Sleep(1);
+    }
+    m->thread_id = GetCurrentThreadId();
+    m->count++;
+    return 0;
+}
+
 void* __cdecl _Mtx_getconcrtcs(_Mtx_arg_t mtx)
 {
     return &MTX_T_FROM_ARG(mtx)->cs;
@@ -1411,6 +1436,108 @@ int __cdecl _Thrd_detach(_Thrd_t thr)
     return CloseHandle(thr.hnd) ? 0 : _THRD_ERROR;
 }
 
+/* the thread ends with code res */
+void __cdecl _Thrd_exit(int res)
+{
+    TRACE("(%d)\n", res);
+    ExitThread(res);
+}
+
+/* a fatal error of the threads library: the message on stderr, then abort */
+void __cdecl _Thrd_abort(const char *msg)
+{
+    fputs(msg, stderr);
+    fputc('\n', stderr);
+    abort();
+}
+
+#if _MSVCP_VER <= 120
+/* C11-style thread specific storage: each value sits in a fiber local
+ * storage cell with its key, so the destructor of the key runs at thread
+ * exit, and not after _Tss_delete. */
+typedef void (__cdecl *_Tss_dtor_t)(void *);
+
+#define TSS_KEYS 4096
+static _Tss_dtor_t tss_dtors[TSS_KEYS];
+static BOOL tss_live[TSS_KEYS];
+
+struct tss_cell
+{
+    int key;
+    void *value;
+};
+
+static void WINAPI tss_callback(void *data)
+{
+    struct tss_cell *cell = data;
+    _Tss_dtor_t dtor;
+
+    if (!cell) return;
+    dtor = tss_live[cell->key] ? tss_dtors[cell->key] : NULL;
+    if (dtor && cell->value) dtor(cell->value);
+    free(cell);
+}
+
+int __cdecl _Tss_create(int *key, _Tss_dtor_t dtor)
+{
+    DWORD idx = FlsAlloc(tss_callback);
+
+    TRACE("(%p %p)\n", key, dtor);
+
+    if (idx == FLS_OUT_OF_INDEXES) return _THRD_ERROR;
+    if (idx >= TSS_KEYS)
+    {
+        FlsFree(idx);
+        return _THRD_ERROR;
+    }
+    tss_dtors[idx] = dtor;
+    tss_live[idx] = TRUE;
+    *key = idx;
+    return 0;
+}
+
+int __cdecl _Tss_delete(int key)
+{
+    TRACE("(%d)\n", key);
+    if (key < 0 || key >= TSS_KEYS || !tss_live[key]) return _THRD_ERROR;
+    tss_live[key] = FALSE;
+    FlsFree(key);
+    return 0;
+}
+
+int __cdecl _Tss_set(int key, void *value)
+{
+    struct tss_cell *cell;
+
+    TRACE("(%d %p)\n", key, value);
+    if (key < 0 || key >= TSS_KEYS || !tss_live[key]) return _THRD_ERROR;
+    if (!(cell = FlsGetValue(key)))
+    {
+        if (!(cell = malloc(sizeof(*cell)))) return _THRD_ERROR;
+        cell->key = key;
+        if (!FlsSetValue(key, cell))
+        {
+            free(cell);
+            return _THRD_ERROR;
+        }
+    }
+#ifndef SG_MUTANT_TSS_SET_NOP
+    cell->value = value;
+#endif
+    return 0;
+}
+
+void * __cdecl _Tss_get(int key)
+{
+    struct tss_cell *cell;
+
+    TRACE("(%d)\n", key);
+    if (key < 0 || key >= TSS_KEYS || !tss_live[key]) return NULL;
+    cell = FlsGetValue(key);
+    return cell ? cell->value : NULL;
+}
+#endif
+
 typedef struct
 {
     const vtable_ptr *vtable;
@@ -1995,3 +2122,45 @@ void __cdecl _Rng_abort(const char *msg)
     abort();
 }
 #endif
+
+#if _MSVCP_VER >= 100
+/* the recursive mutex of the library's own locks (xmtx.h: a critical section) */
+void __cdecl _Mtxinit(CRITICAL_SECTION *cs)
+{
+    TRACE("(%p)\n", cs);
+    InitializeCriticalSectionEx(cs, 4000, 0);
+}
+
+void __cdecl _Mtxdst(CRITICAL_SECTION *cs)
+{
+    TRACE("(%p)\n", cs);
+    DeleteCriticalSection(cs);
+}
+
+void __cdecl _Mtxlock(CRITICAL_SECTION *cs)
+{
+    EnterCriticalSection(cs);
+}
+
+void __cdecl _Mtxunlock(CRITICAL_SECTION *cs)
+{
+    LeaveCriticalSection(cs);
+}
+#endif
+
+#if _MSVCP_VER >= 100 && _MSVCP_VER <= 120
+/* calls func once for the flag: 0 at first, 1 while running, 2 after */
+void __cdecl _Once(LONG *flag, void (__cdecl *func)(void))
+{
+    TRACE("(%p %p)\n", flag, func);
+
+    if (ReadAcquire(flag) == 2) return;
+    if (!InterlockedCompareExchange(flag, 1, 0))
+    {
+        func();
+        WriteRelease(flag, 2);
+        return;
+    }
+    while (ReadAcquire(flag) != 2) Sleep(0);
+}
+#endif
