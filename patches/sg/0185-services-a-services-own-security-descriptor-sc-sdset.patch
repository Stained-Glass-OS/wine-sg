+#define SD_PARTS (OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION)
+
+/* A self-relative copy of the parts of sd that info names, in *out (free()). */
+static DWORD sd_parts( PSECURITY_DESCRIPTOR sd, SECURITY_INFORMATION info, BYTE **out, DWORD *size )
+{
+    SECURITY_DESCRIPTOR abs;
+    PSID owner = NULL, group = NULL;
+    PACL dacl = NULL;
+    BOOL present = FALSE, defaulted;
+
+    InitializeSecurityDescriptor( &abs, SECURITY_DESCRIPTOR_REVISION );
+    if ((info & OWNER_SECURITY_INFORMATION) && GetSecurityDescriptorOwner( sd, &owner, &defaulted ))
+        SetSecurityDescriptorOwner( &abs, owner, FALSE );
+    if ((info & GROUP_SECURITY_INFORMATION) && GetSecurityDescriptorGroup( sd, &group, &defaulted ))
+        SetSecurityDescriptorGroup( &abs, group, FALSE );
+    if ((info & DACL_SECURITY_INFORMATION) && GetSecurityDescriptorDacl( sd, &present, &dacl, &defaulted ) && present)
+        SetSecurityDescriptorDacl( &abs, TRUE, dacl, FALSE );
+    *size = 0;
+    MakeSelfRelativeSD( &abs, NULL, size );
+    if (!*size || !(*out = malloc( *size ))) return ERROR_NOT_ENOUGH_SERVER_MEMORY;
+    if (!MakeSelfRelativeSD( &abs, *out, size ))
+    {
+        free( *out );
+        return GetLastError();
+    }
+    return ERROR_SUCCESS;
+}
