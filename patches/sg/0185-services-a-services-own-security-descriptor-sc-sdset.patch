+/* "[SC] Function FAILED n:", then the system's text for n, as Windows' sc prints it. */
+static DWORD report_failure( const char *function, DWORD err )
+{
+    WCHAR msg[512];
+
+    printf( "[SC] %s FAILED %lu:\n\n", function, err );
+    if (FormatMessageW( FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL, err, 0, msg,
+                        ARRAY_SIZE(msg), NULL ))
+        printf( "%ls\n", msg );
+    return err;
+}
+
+/* sc sdshow NAME: the service's security descriptor (its DACL) in SDDL. */
+static DWORD sd_show( SC_HANDLE manager, const WCHAR *name )
+{
+    SC_HANDLE service;
+    PSECURITY_DESCRIPTOR sd;
+    WCHAR *sddl;
+    DWORD size = 0, err;
+
+    if (!(service = OpenServiceW( manager, name, READ_CONTROL )))
+        return report_failure( "OpenService", GetLastError() );
+    if (!QueryServiceObjectSecurity( service, DACL_SECURITY_INFORMATION, NULL, 0, &size ) &&
+        GetLastError() != ERROR_INSUFFICIENT_BUFFER)
+    {
+        err = GetLastError();
+        CloseServiceHandle( service );
+        return report_failure( "QueryServiceObjectSecurity", err );
+    }
+    sd = malloc( size );
+    if (!QueryServiceObjectSecurity( service, DACL_SECURITY_INFORMATION, sd, size, &size ))
+    {
+        err = GetLastError();
+        free( sd );
+        CloseServiceHandle( service );
+        return report_failure( "QueryServiceObjectSecurity", err );
+    }
+    CloseServiceHandle( service );
+    if (!ConvertSecurityDescriptorToStringSecurityDescriptorW( sd, SDDL_REVISION_1, DACL_SECURITY_INFORMATION,
+                                                               &sddl, NULL ))
+    {
+        err = GetLastError();
+        free( sd );
+        return report_failure( "ConvertSecurityDescriptorToStringSecurityDescriptor", err );
+    }
+    printf( "\n%ls\n", sddl );
+    LocalFree( sddl );
+    free( sd );
+    return ERROR_SUCCESS;
+}
+
+/* sc sdset NAME SDDL: replace the parts the SDDL string has (owner, group, DACL). */
+static DWORD sd_set( SC_HANDLE manager, const WCHAR *name, const WCHAR *sddl )
+{
+    SECURITY_INFORMATION info = 0;
+    PSECURITY_DESCRIPTOR sd;
+    SC_HANDLE service;
+    PSID sid;
+    PACL acl;
+    BOOL present, defaulted;
+    DWORD access = 0, err = ERROR_SUCCESS;
+
+    if (!ConvertStringSecurityDescriptorToSecurityDescriptorW( sddl, SDDL_REVISION_1, &sd, NULL ))
+        return report_failure( "ConvertStringSecurityDescriptorToSecurityDescriptor", GetLastError() );
+    if (GetSecurityDescriptorOwner( sd, &sid, &defaulted ) && sid) info |= OWNER_SECURITY_INFORMATION;
+    if (GetSecurityDescriptorGroup( sd, &sid, &defaulted ) && sid) info |= GROUP_SECURITY_INFORMATION;
+    if (GetSecurityDescriptorDacl( sd, &present, &acl, &defaulted ) && present) info |= DACL_SECURITY_INFORMATION;
+    if (info & DACL_SECURITY_INFORMATION) access |= WRITE_DAC;
+    if (info & (OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION)) access |= WRITE_OWNER;
+    if (!info)
+    {
+        LocalFree( sd );
+        return report_failure( "SetServiceObjectSecurity", ERROR_INVALID_PARAMETER );
+    }
+    if (!(service = OpenServiceW( manager, name, access )))
+        err = report_failure( "OpenService", GetLastError() );
+    else
+    {
+        if (!SetServiceObjectSecurity( service, info, sd ))
+            err = report_failure( "SetServiceObjectSecurity", GetLastError() );
+        else
+            printf( "[SC] SetServiceObjectSecurity SUCCESS\n" );
+        CloseServiceHandle( service );
+    }
+    LocalFree( sd );
+    return err;
+}
