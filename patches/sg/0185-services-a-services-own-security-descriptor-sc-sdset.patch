+/* The service's own security descriptor, as Windows keeps it: the value
+ * Security of its Security subkey, a self-relative descriptor (sc sdset). */
+static void load_service_security(HKEY key, struct service_entry *entry)
+{
+    DWORD type, size = 0;
+    BYTE *sd;
+
+    if (RegGetValueW(key, L"Security", L"Security", RRF_RT_REG_BINARY, &type, NULL, &size) || !size)
+        return;
+    if (!(sd = malloc(size))) return;
+    if (RegGetValueW(key, L"Security", L"Security", RRF_RT_REG_BINARY, &type, sd, &size) ||
+        !IsValidSecurityDescriptor(sd) || GetSecurityDescriptorLength(sd) > size)
+    {
+        WINE_WARN("%s: ignoring an invalid security descriptor\n", wine_dbgstr_w(entry->name));
+        free(sd);
+        return;
+    }
+    entry->sd = sd;
+    entry->sd_size = size;
+}
+
+DWORD save_service_security(struct service_entry *entry)
+{
+    HKEY key;
+    DWORD err;
+
+    if ((err = RegCreateKeyExW(entry->db->root_key, entry->name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL)))
+        return err;
+    if (entry->sd)
+        err = RegSetKeyValueW(key, L"Security", L"Security", REG_BINARY, entry->sd, entry->sd_size);
+    else if ((err = RegDeleteTreeW(key, L"Security")) == ERROR_FILE_NOT_FOUND)
+        err = ERROR_SUCCESS;
+    RegCloseKey(key);
+    return err;
+}
+
