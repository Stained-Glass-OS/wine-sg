+        SetSecurityDescriptorGroup(&abs, group, FALSE);
+        SetSecurityDescriptorDacl(&abs, present, dacl, FALSE);
+        size = 0;
+        MakeSelfRelativeSD(&abs, NULL, &size);
+        if (!(sd = malloc(size))) err = ERROR_NOT_ENOUGH_SERVER_MEMORY;
+        else if (!MakeSelfRelativeSD(&abs, sd, &size))
+        {
+            err = GetLastError();
+            free(sd);
+        }
