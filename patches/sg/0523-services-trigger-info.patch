+/* SERVICE_CONFIG_TRIGGER_INFO: services.exe returns the triggers pointer-size
+ * independent (struct service_trigger_list); lay them out as the caller's
+ * SERVICE_TRIGGER_INFO, the triggers, subtypes, data items and data following
+ * the structure in the caller's buffer, as Windows does. */
+static SIZE_T align_up( SIZE_T pos, SIZE_T align )
+{
+    return (pos + align - 1) & ~(align - 1);
+}
+
+static DWORD get_trigger_blob( SC_HANDLE service, BYTE **ret, DWORD *ret_len )
+{
+    DWORD size = 256, needed = 0, err;
+    BYTE *blob = NULL;
+
+    for (;;)
+    {
+        free( blob );
+        if (!(blob = malloc( size ))) return ERROR_NOT_ENOUGH_MEMORY;
+        __TRY
+        {
+            err = svcctl_QueryServiceConfig2W( service, SERVICE_CONFIG_TRIGGER_INFO, blob, size, &needed );
+        }
+        __EXCEPT(rpc_filter)
+        {
+            err = map_exception_code( GetExceptionCode() );
+        }
+        __ENDTRY
+        if (err != ERROR_INSUFFICIENT_BUFFER || needed <= size) break;
+        size = needed;
+    }
+    if (err) { free( blob ); return err; }
+    *ret = blob;
+    *ret_len = needed;
+    return ERROR_SUCCESS;
+}
+
+static BOOL trigger_range_ok( DWORD blob_len, DWORD offset, SIZE_T size )
+{
+    return offset <= blob_len && size <= blob_len - offset;
+}
+
+static DWORD layout_triggers( const BYTE *blob, DWORD blob_len, BYTE *out, DWORD size,
+                              DWORD *needed, BOOL ansi )
+{
+    const struct service_trigger_list *list = (const struct service_trigger_list *)blob;
+    DWORD count, i, j, pass;
+    SIZE_T pos = 0;
+
+    if (blob_len < sizeof(DWORD)) return ERROR_INVALID_DATA;
+    count = list->count;
+    if (count && !trigger_range_ok( blob_len, 0, FIELD_OFFSET(struct service_trigger_list, triggers[count]) ))
+        return ERROR_INVALID_DATA;
+
+    for (pass = 0; pass < 2; pass++)
+    {
+        SERVICE_TRIGGER_INFO *info = (SERVICE_TRIGGER_INFO *)out;
+        SERVICE_TRIGGER *triggers = NULL;
+
+        if (pass == 1)
+        {
+            *needed = pos;
+            if (size < pos) return ERROR_INSUFFICIENT_BUFFER;
+            memset( out, 0, pos );
+        }
+        pos = sizeof(SERVICE_TRIGGER_INFO);
+        if (count)
+        {
+            pos = align_up( pos, sizeof(void *) );
+            triggers = (SERVICE_TRIGGER *)(out + pos);
+            pos += count * sizeof(SERVICE_TRIGGER);
+        }
+        if (pass == 1)
+        {
+            info->cTriggers = count;
+            info->pTriggers = count ? triggers : NULL;
+            info->pReserved = NULL;
+        }
+        for (i = 0; i < count; i++)
+        {
+            const struct service_trigger *t = &list->triggers[i];
+            SERVICE_TRIGGER_SPECIFIC_DATA_ITEM *items = NULL;
+
+            if (pass == 1)
+            {
+                triggers[i].dwTriggerType = t->type;
+                triggers[i].dwAction = t->action;
+                triggers[i].cDataItems = t->data_count;
+            }
+            if (t->subtype_offset)
+            {
+                if (!trigger_range_ok( blob_len, t->subtype_offset, sizeof(GUID) )) return ERROR_INVALID_DATA;
+                pos = align_up( pos, sizeof(DWORD) );
+                if (pass == 1)
+                {
+                    triggers[i].pTriggerSubtype = (GUID *)(out + pos);
+                    memcpy( out + pos, blob + t->subtype_offset, sizeof(GUID) );
+                }
+                pos += sizeof(GUID);
+            }
+            if (!t->data_count) continue;
+            if (!trigger_range_ok( blob_len, t->data_offset, (SIZE_T)t->data_count * sizeof(struct service_trigger_data) ))
+                return ERROR_INVALID_DATA;
+            pos = align_up( pos, sizeof(void *) );
+            items = (SERVICE_TRIGGER_SPECIFIC_DATA_ITEM *)(out + pos);
+            if (pass == 1) triggers[i].pDataItems = items;
+            pos += t->data_count * sizeof(SERVICE_TRIGGER_SPECIFIC_DATA_ITEM);
+            for (j = 0; j < t->data_count; j++)
+            {
+                const struct service_trigger_data *d = (const struct service_trigger_data *)(blob + t->data_offset) + j;
+                DWORD len = d->size;
+
+                if (!trigger_range_ok( blob_len, d->offset, d->size )) return ERROR_INVALID_DATA;
+                if (ansi && d->data_type == SERVICE_TRIGGER_DATA_TYPE_STRING)
+                    len = WideCharToMultiByte( CP_ACP, 0, (const WCHAR *)(blob + d->offset), d->size / sizeof(WCHAR),
+                                               NULL, 0, NULL, NULL );
+                if (pass == 1)
+                {
+                    items[j].dwDataType = d->data_type;
+                    items[j].cbData = len;
+                    items[j].pData = len ? out + pos : NULL;
+                    if (ansi && d->data_type == SERVICE_TRIGGER_DATA_TYPE_STRING)
+                        WideCharToMultiByte( CP_ACP, 0, (const WCHAR *)(blob + d->offset), d->size / sizeof(WCHAR),
+                                             (char *)out + pos, len, NULL, NULL );
+                    else if (len)
+                        memcpy( out + pos, blob + d->offset, len );
+                }
+                pos += len;
+            }
+        }
+    }
+    return ERROR_SUCCESS;
+}
+
+static BOOL query_service_triggers( SC_HANDLE service, BYTE *buffer, DWORD size, DWORD *ret_size, BOOL ansi )
+{
+    BYTE *blob;
+    DWORD len, needed = 0, err;
+
+    if (!ret_size) return set_error( ERROR_INVALID_ADDRESS );
+    if ((err = get_trigger_blob( service, &blob, &len ))) return set_error( err );
+    err = layout_triggers( blob, len, buffer, size, &needed, ansi );
+    free( blob );
+    if (!err || err == ERROR_INSUFFICIENT_BUFFER) *ret_size = needed;
+    return set_error( err );
+}
