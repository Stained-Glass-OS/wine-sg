+/* Service triggers (SERVICE_CONFIG_TRIGGER_INFO), kept where Windows keeps
+ * them: Services\<name>\TriggerInfo\<n>, with Type, Action, GUID and, per data
+ * item, Data<i> and DataType<i>. */
+DWORD save_service_triggers(struct service_entry *entry, const SERVICE_TRIGGER_INFO *info)
+{
+    HKEY key, triggers, sub;
+    WCHAR name[32];
+    DWORD i, j, err;
+
+    if ((err = RegOpenKeyExW(entry->db->root_key, entry->name, 0, KEY_ALL_ACCESS, &key))) return err;
+    if ((err = RegDeleteTreeW(key, L"TriggerInfo")) == ERROR_FILE_NOT_FOUND) err = ERROR_SUCCESS;
+    if (!err && info->cTriggers && !(err = RegCreateKeyW(key, L"TriggerInfo", &triggers)))
+    {
+        for (i = 0; !err && i < info->cTriggers; i++)
+        {
+            const SERVICE_TRIGGER *t = &info->pTriggers[i];
+
+            swprintf(name, ARRAY_SIZE(name), L"%u", i);
+            if ((err = RegCreateKeyW(triggers, name, &sub))) break;
+            err = RegSetValueExW(sub, L"Type", 0, REG_DWORD, (const BYTE *)&t->dwTriggerType, sizeof(DWORD));
+            if (!err) err = RegSetValueExW(sub, L"Action", 0, REG_DWORD, (const BYTE *)&t->dwAction, sizeof(DWORD));
+            if (!err && t->pTriggerSubtype)
+                err = RegSetValueExW(sub, L"GUID", 0, REG_BINARY, (const BYTE *)t->pTriggerSubtype, sizeof(GUID));
+            for (j = 0; !err && j < t->cDataItems; j++)
+            {
+                const SERVICE_TRIGGER_SPECIFIC_DATA_ITEM *d = &t->pDataItems[j];
+
+                swprintf(name, ARRAY_SIZE(name), L"Data%u", j);
+                err = RegSetValueExW(sub, name, 0, REG_BINARY, d->pData, d->cbData);
+                swprintf(name, ARRAY_SIZE(name), L"DataType%u", j);
+                if (!err) err = RegSetValueExW(sub, name, 0, REG_DWORD, (const BYTE *)&d->dwDataType, sizeof(DWORD));
+            }
+            RegCloseKey(sub);
+        }
+        RegCloseKey(triggers);
+    }
+    RegCloseKey(key);
+    return err;
+}
+
+struct trigger_blob
+{
+    BYTE *data;
+    DWORD len, cap;
+};
+
+static DWORD blob_reserve(struct trigger_blob *b, DWORD size, DWORD align)
+{
+    DWORD offset = (b->len + align - 1) & ~(align - 1);
+
+    if (offset + size > b->cap)
+    {
+        DWORD cap = max(b->cap * 2, offset + size + 256);
+        BYTE *p = realloc(b->data, cap);
+        if (!p) return 0;
+        memset(p + b->cap, 0, cap - b->cap);
+        b->data = p;
+        b->cap = cap;
+    }
+    b->len = offset + size;
+    return offset;
+}
+
+/* The triggers in the pointer-size independent form of svcctl.idl
+ * (struct service_trigger_list). */
+DWORD query_service_triggers(struct service_entry *entry, BYTE *buffer, DWORD size, DWORD *needed)
+{
+    struct trigger_blob b = { 0 };
+    HKEY key, sub;
+    WCHAR name[32];
+    DWORD count = 0, i, j, err = ERROR_SUCCESS, header;
+
+    if (!RegOpenKeyExW(entry->db->root_key, entry->name, 0, KEY_READ, &key))
+    {
+        HKEY triggers;
+        if (!RegOpenKeyExW(key, L"TriggerInfo", 0, KEY_READ, &triggers))
+        {
+            for (count = 0;; count++)
+            {
+                swprintf(name, ARRAY_SIZE(name), L"%u", count);
+                if (RegOpenKeyExW(triggers, name, 0, KEY_READ, &sub)) break;
+                RegCloseKey(sub);
+            }
+            RegCloseKey(key);
+            key = triggers;
+        }
+        else
+        {
+            RegCloseKey(key);
+            key = NULL;
+        }
+    }
+    else key = NULL;
+
+    header = count ? FIELD_OFFSET(struct service_trigger_list, triggers[count]) : sizeof(DWORD);
+    if (blob_reserve(&b, header, 4) != 0 || !b.data) { free(b.data); if (key) RegCloseKey(key); return ERROR_NOT_ENOUGH_MEMORY; }
+    ((struct service_trigger_list *)b.data)->count = count;
+
+    for (i = 0; i < count && !err; i++)
+    {
+        struct service_trigger *t;
+        DWORD type = 0, action = 0, len, items = 0, items_offset = 0, off;
+        GUID guid;
+
+        swprintf(name, ARRAY_SIZE(name), L"%u", i);
+        if (RegOpenKeyExW(key, name, 0, KEY_READ, &sub)) { err = ERROR_FILE_NOT_FOUND; break; }
+        load_reg_dword(sub, L"Type", &type);
+        load_reg_dword(sub, L"Action", &action);
+        for (;;)
+        {
+            swprintf(name, ARRAY_SIZE(name), L"DataType%u", items);
+            if (RegQueryValueExW(sub, name, NULL, NULL, NULL, NULL)) break;
+            items++;
+        }
+        t = &((struct service_trigger_list *)b.data)->triggers[i];
+        t->type = type;
+        t->action = action;
+        t->data_count = items;
+        len = sizeof(guid);
+        if (!RegQueryValueExW(sub, L"GUID", NULL, NULL, (BYTE *)&guid, &len) && len == sizeof(guid))
+        {
+            if (!(off = blob_reserve(&b, sizeof(guid), 4))) err = ERROR_NOT_ENOUGH_MEMORY;
+            else
+            {
+                memcpy(b.data + off, &guid, sizeof(guid));
+                ((struct service_trigger_list *)b.data)->triggers[i].subtype_offset = off;
+            }
+        }
+        if (!err && items)
+        {
+            if (!(items_offset = blob_reserve(&b, items * sizeof(struct service_trigger_data), 4))) err = ERROR_NOT_ENOUGH_MEMORY;
+            else ((struct service_trigger_list *)b.data)->triggers[i].data_offset = items_offset;
+        }
+        for (j = 0; j < items && !err; j++)
+        {
+            struct service_trigger_data *d;
+            DWORD data_type = 0;
+
+            swprintf(name, ARRAY_SIZE(name), L"DataType%u", j);
+            load_reg_dword(sub, name, &data_type);
+            swprintf(name, ARRAY_SIZE(name), L"Data%u", j);
+            len = 0;
+            RegQueryValueExW(sub, name, NULL, NULL, NULL, &len);
+            if (!(off = blob_reserve(&b, len, 1)) && len) { err = ERROR_NOT_ENOUGH_MEMORY; break; }
+            if (len) RegQueryValueExW(sub, name, NULL, NULL, b.data + off, &len);
+            d = (struct service_trigger_data *)(b.data + items_offset) + j;
+            d->data_type = data_type;
+            d->size = len;
+            d->offset = len ? off : 0;
+        }
+        RegCloseKey(sub);
+    }
+    if (key) RegCloseKey(key);
+
+    if (!err)
+    {
+        *needed = b.len;
+        if (size >= b.len) memcpy(buffer, b.data, b.len);
+        else err = ERROR_INSUFFICIENT_BUFFER;
+    }
+    free(b.data);
+    return err;
+}
