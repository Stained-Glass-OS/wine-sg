 MODULE    = uxtheme.dll
 IMPORTLIB = uxtheme
 IMPORTS   = user32 gdi32 advapi32
-DELAYIMPORTS = msimg32
+DELAYIMPORTS = msimg32 dwmapi
 
 SOURCES = \
