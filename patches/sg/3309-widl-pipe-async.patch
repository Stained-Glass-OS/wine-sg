+/* FC_PIPE, FC_PAD, the offset of the description of the element type, the memory size and the
+ * wire size of an element.  A basic element type is described by a two byte entry (its format
+ * character, FC_PAD) written in front. */
+static unsigned int write_pipe_tfs(FILE *file, type_t *type, const char *name,
+                                   unsigned int *typeformat_offset)
+{
+    type_t *elem = type_pipe_get_element(type);
+    unsigned int start_offset, elem_offset, align, wire_size;
+    short reloff;
+    unsigned short mem_size;
+
+    if (processed(type)) return type->typestring_offset;
+
+    switch (typegen_detect_type(elem, NULL, TDT_ALL_TYPES))
+    {
+    case TGT_BASIC:
+    case TGT_ENUM:
+    {
+        unsigned char fc = type_get_type(elem) == TYPE_ENUM ? get_enum_fc(elem) : get_basic_fc_signed(elem);
+
+        elem_offset = *typeformat_offset;
+        print_file(file, 0, "/* %u */\n", elem_offset);
+        print_file(file, 2, "0x%02x,\t/* %s */\n", fc, string_of_type(fc));
+        print_file(file, 2, "0x%x,\t/* FC_PAD */\n", FC_PAD);
+        *typeformat_offset += 2;
+        break;
+    }
+    case TGT_STRUCT:
+    case TGT_UNION:
+        elem_offset = write_type_tfs(file, NULL, FALSE, elem, name, TYPE_CONTEXT_CONTAINER, typeformat_offset);
+        if (!elem_offset) elem_offset = elem->typestring_offset;
+        break;
+    default:
+        error("the element type of the pipe %s is not supported (basic types, enums, structures and unions only)\n",
+              name ? name : "");
+        return 0;
+    }
+
+    mem_size = type_memsize(elem);
+    wire_size = get_required_buffer_size_type(elem, NULL, NULL, FALSE, FALSE, &align);
+    start_offset = *typeformat_offset;
+    reloff = elem_offset - (start_offset + 2);
+    print_file(file, 0, "/* %u */\n", start_offset);
+    print_file(file, 2, "0x%x,\t/* FC_PIPE */\n", FC_PIPE);
+    print_file(file, 2, "0x%x,\t/* FC_PAD */\n", FC_PAD);
+    print_file(file, 2, "NdrFcShort(0x%hx),\t/* Offset= %hd (%u) */\n", (unsigned short)reloff, reloff, elem_offset);
+    print_file(file, 2, "NdrFcShort(0x%hx),\t/* memory size = %hu */\n", mem_size, mem_size);
+    print_file(file, 2, "NdrFcShort(0x%x),\t/* wire size = %u */\n", wire_size, wire_size);
+    update_tfsoff(type, start_offset, file);
+    *typeformat_offset += 8;
+    return start_offset;
+}
+
 static unsigned int write_type_tfs(FILE *file, const attr_list_t *attrs, int toplevel_attrs,
                                    type_t *type, const char *name,
                                    enum type_context context,
@@ -3896,6 +3983,8 @@ static unsigned int write_type_tfs(FILE *file, const attr_list_t *attrs, int top
