--- a/tools/widl/client.c
+++ b/tools/widl/client.c
@@ -57,7 +57,12 @@ static void write_client_func_decl( const type_t *iface, const var_t *func )
     fprintf(client, " %s ", callconv);
     fprintf(client, "%s%s(\n", prefix_client, get_name(func));
     indent++;
-    if (args) write_args(client, args, iface->name, 0, TRUE, NAME_DEFAULT);
+    if (is_async_rpc_func(iface, func))
+    {
+        print_client("PRPC_ASYNC_STATE %s_AsyncHandle%s", get_name(func), args ? ",\n" : "");
+        if (args) write_args(client, args, iface->name, 0, TRUE, NAME_DEFAULT);
+    }
+    else if (args) write_args(client, args, iface->name, 0, TRUE, NAME_DEFAULT);
     else
         print_client("void");
     fprintf(client, ")\n");
