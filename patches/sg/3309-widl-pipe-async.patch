     }
 
     return t;
 }
 
+static var_t *pipe_arg(const char *name, type_t *type)
+{
+    var_t *arg = make_var(xstrdup(name));
+    arg->declspec.type = type;
+    return arg;
+}
+
+static type_t *pipe_callback(const struct location *where, var_list_t *args)
+{
+    type_t *func = type_new_function(args);
+
+    func->details.function->retval->declspec.type = type_new_void();
+    func->attrs = append_attr(NULL, attr_ptr(*where, ATTR_CALLCONV, xstrdup("__RPC_USER")));
+    return type_new_pointer(func);
+}
+
+/* a pipe is a structure of the three callbacks the stubs use to move its elements and a state
+ * pointer: typedef pipe long P;  declares what MIDL declares, a P with Pull, Push, Alloc and state. */
+type_t *type_new_pipe(const decl_spec_t *elem, struct namespace *namespace, const struct location *where)
+{
+    type_t *ulong_t = type_new_int(TYPE_BASIC_LONG, 1);
