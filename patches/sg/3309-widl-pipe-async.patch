-    if (target.cpu == CPU_i386 && args) needs_params = is_object( iface ) || list_count( args ) > 1;
+    if (target.cpu == CPU_i386 && args) needs_params = is_object( iface ) || async_handle || list_count( args ) > 1;
 
     print_file( file, 0, "{\n");
     if (needs_params)
     {
         if (has_ret) print_file( file, 1, "%s", "CLIENT_CALL_RETURN _RetVal;\n" );
-        write_func_param_struct( file, iface, func->declspec.type, "__params", FALSE );
+        write_func_param_struct( file, iface, func->declspec.type, "__params", FALSE, async_handle );
         if (is_object( iface )) print_file( file, 1, "__params.This = This;\n" );
+        if (async_handle) print_file( file, 1, "__params.%s = %s;\n", async_handle, async_handle );
         if (args)
             LIST_FOR_EACH_ENTRY( arg, args, const var_t, entry )
                 print_file( file, 1, "__params.%s = %s;\n", arg->name, arg->name );
@@ -5241,7 +5339,7 @@ void write_client_call_routine( FILE *file, const type_t *iface, const var_t *fu
 
     len = fprintf( file, "    %s%s( ",
                    has_ret ? "_RetVal = " : "",
-                   interpreted_mode ? "NdrClientCall2" : "NdrClientCall" );
+                   async_handle ? "NdrAsyncClientCall" : interpreted_mode ? "NdrClientCall2" : "NdrClientCall" );
     fprintf( file, "&%s_StubDesc,", prefix );
     fprintf( file, "\n%*s&__MIDL_ProcFormatString.Format[%u]", len, "", proc_offset );
     if (needs_params)
@@ -5251,6 +5349,7 @@ void write_client_call_routine( FILE *file, const type_t *iface, const var_t *fu
     else if (target.cpu != CPU_i386)
     {
         if (is_object( iface )) fprintf( file, ",\n%*sThis", len, "" );
+        if (async_handle) fprintf( file, ",\n%*s%s", len, "", async_handle );
         if (args)
             LIST_FOR_EACH_ENTRY( arg, args, const var_t, entry )
                 fprintf( file, ",\n%*s%s", len, "", arg->name );
@@ -5258,6 +5357,7 @@ void write_client_call_routine( FILE *file, const type_t *iface, const var_t *fu
     else
     {
         if (is_object( iface )) fprintf( file, ",\n%*s&This", len, "" );
+        else if (async_handle) fprintf( file, ",\n%*s&%s", len, "", async_handle );
         else if (args)
         {
             arg = LIST_ENTRY( list_head(args), const var_t, entry );
diff --git a/tools/widl/typegen.h b/tools/widl/typegen.h
