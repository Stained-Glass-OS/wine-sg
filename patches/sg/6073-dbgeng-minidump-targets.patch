+static HRESULT debug_client_open_dump(struct debug_client *debug_client, const WCHAR *filename, ULONG64 file)
+{
+    const MINIDUMP_MISC_INFO *misc;
+    struct target_process *target;
+    struct dump_target *dump;
+    unsigned int i;
+    ULONG len;
+    HRESULT hr;
+
+    if (!filename && !file)
+        return E_INVALIDARG;
+    if (FAILED(hr = dump_open(filename, (HANDLE)(ULONG_PTR)file, &dump)))
+        return hr;
+    if (!(target = calloc(1, sizeof(*target))))
+    {
+        dump_free(dump);
+        return E_OUTOFMEMORY;
+    }
+    EnterCriticalSection(&dump_cs);
+    for (i = 0; i < ARRAY_SIZE(dump_targets); i++)
+        if (!dump_targets[i])
+        {
+            dump_targets[i] = target;
+            break;
+        }
+    LeaveCriticalSection(&dump_cs);
+    if (i == ARRAY_SIZE(dump_targets))
+    {
+        dump_free(dump);
+        free(target);
+        return E_OUTOFMEMORY;
+    }
+    target->dump = dump;
