From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dbgeng: Minidump targets for OpenDumpFile (6073)

OpenDumpFile and OpenDumpFileWide gave E_NOTIMPL. A user-mode minidump
becomes a target: its threads, their recorded contexts, its modules, its
memory ranges and its exception; what it leaves out of a module (code,
unwind data) is read from the module's image file when that is still the
same file, so stacks walk as in a debugger. WaitForEvent reports the
dump's exception once; registers and memory do not change.
---
diff --git a/dlls/dbgeng/dbgeng.c b/dlls/dbgeng/dbgeng.c
index 7b53a1f..1ccc274 100644
--- a/dlls/dbgeng/dbgeng.c
+++ b/dlls/dbgeng/dbgeng.c
@@ -275,6 +275,7 @@ struct target_process
     unsigned int dll_count;
     ULONG64 dll_bases[256];
     char dll_names[256][64];
+    struct dump_target *dump;           /* OpenDumpFile: the process as a minidump recorded it */
 };
 
 struct debug_client
@@ -373,15 +374,445 @@ static HRESULT debug_target_return_string(const char *str, char *buffer, unsigne
     return len < buffer_size ? S_OK : S_FALSE;
 }
 
+/* ---- minidump targets ----
+ *
+ * OpenDumpFile makes a target of a user-mode minidump: its threads (and their contexts), modules, memory
+ * ranges and exception come from the file's streams. Such a target has no process: its handle is a value that
+ * names it for dbghelp (symbols, stack walks with our memory reader), never a real handle, and nothing
+ * runs or changes in it.
+ */
+struct dump_range
+{
+    ULONG64 start, size;
+    const BYTE *data;
+};
+
+/* a module's image file, for what a dump leaves out of it (code, unwind data): as loaded, from its sections */
+struct dump_image
+{
+    BOOL tried;
+    BYTE *file;
+    SIZE_T file_size;
+    const IMAGE_SECTION_HEADER *sections;
+    unsigned int section_count;
+    DWORD headers_size;
+};
+
+struct dump_target
+{
+    WCHAR *path;
+    struct dump_image *images;          /* one per module */
+    HANDLE file, mapping;
+    const BYTE *base;
+    SIZE_T size;
+    const MINIDUMP_THREAD_LIST *threads;
+    const MINIDUMP_MODULE_LIST *modules;
+    const MINIDUMP_EXCEPTION_STREAM *exception;
+    struct dump_range *ranges;
+    unsigned int range_count;
+    USHORT arch;                        /* PROCESSOR_ARCHITECTURE_* */
+    ULONG flags;                        /* the header's MINIDUMP_TYPE */
+    BOOL event_reported;
+};
+
+#define DUMP_HANDLE_BASE 0x7fe00000
+static struct target_process *dump_targets[64];
+static CRITICAL_SECTION dump_cs;
+static CRITICAL_SECTION_DEBUG dump_cs_debug =
+{
+    0, 0, &dump_cs,
+    { &dump_cs_debug.ProcessLocksList, &dump_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": dump_cs") }
+};
+static CRITICAL_SECTION dump_cs = { &dump_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct target_process *dump_target_from_handle(HANDLE handle)
+{
+    ULONG_PTR i = ((ULONG_PTR)handle - DUMP_HANDLE_BASE) / 4;
+    struct target_process *target = NULL;
+
+    if ((ULONG_PTR)handle < DUMP_HANDLE_BASE || i >= ARRAY_SIZE(dump_targets)) return NULL;
+    EnterCriticalSection(&dump_cs);
+    target = dump_targets[i];
+    LeaveCriticalSection(&dump_cs);
+    return target;
+}
+
+static const void *dump_at(const struct dump_target *dump, RVA64 rva, ULONG64 size)
+{
+    if (rva > dump->size || size > dump->size - rva) return NULL;
+    return dump->base + rva;
+}
+
+static const void *dump_stream(const struct dump_target *dump, ULONG type, ULONG *size)
+{
+    const MINIDUMP_HEADER *hdr = (const MINIDUMP_HEADER *)dump->base;
+    const MINIDUMP_DIRECTORY *dir = dump_at(dump, hdr->StreamDirectoryRva,
+            (ULONG64)hdr->NumberOfStreams * sizeof(*dir));
+    ULONG i;
+
+    if (!dir) return NULL;
+    for (i = 0; i < hdr->NumberOfStreams; i++)
+    {
+        if (dir[i].StreamType != type) continue;
+        if (size) *size = dir[i].Location.DataSize;
+        return dump_at(dump, dir[i].Location.Rva, dir[i].Location.DataSize);
+    }
+    return NULL;
+}
+
+static BOOL dump_add_range(struct dump_target *dump, ULONG64 start, ULONG64 size, const BYTE *data)
+{
+    struct dump_range *ranges;
+
+    if (!data || !size) return TRUE;
+    if (!(ranges = realloc(dump->ranges, (dump->range_count + 1) * sizeof(*ranges)))) return FALSE;
+    dump->ranges = ranges;
+    ranges[dump->range_count].start = start;
+    ranges[dump->range_count].size = size;
+    ranges[dump->range_count++].data = data;
+    return TRUE;
+}
+
+static void dump_free(struct dump_target *dump)
+{
+    if (!dump) return;
+    /* the module list is in the mapped file */
+    if (dump->images && dump->modules)
+    {
+        ULONG i;
+        for (i = 0; i < dump->modules->NumberOfModules; i++) free(dump->images[i].file);
+    }
+    if (dump->base) UnmapViewOfFile(dump->base);
+    if (dump->mapping) CloseHandle(dump->mapping);
+    if (dump->file && dump->file != INVALID_HANDLE_VALUE) CloseHandle(dump->file);
+    free(dump->images);
+    free(dump->ranges);
+    free(dump->path);
+    free(dump);
+}
+
+/* the image file a dump module was loaded from, if it is still that file (time stamp and size) */
+static const struct dump_image *dump_module_image(struct dump_target *dump, ULONG index)
+{
+    const MINIDUMP_MODULE *m = &dump->modules->Modules[index];
+    struct dump_image *image = &dump->images[index];
+    const MINIDUMP_STRING *name;
+    const IMAGE_DOS_HEADER *dos;
+    const IMAGE_NT_HEADERS *nt;
+    WCHAR path[MAX_PATH];
+    LARGE_INTEGER size;
+    HANDLE file;
+    DWORD read;
+
+    if (image->tried) return image->file ? image : NULL;
+    image->tried = TRUE;
+    if (!(name = dump_at(dump, m->ModuleNameRva, sizeof(ULONG))) || !dump_at(dump, m->ModuleNameRva + sizeof(ULONG), name->Length) ||
+        name->Length / sizeof(WCHAR) >= MAX_PATH)
+        return NULL;
+    memcpy(path, name->Buffer, name->Length);
+    path[name->Length / sizeof(WCHAR)] = 0;
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    if (GetFileSizeEx(file, &size) && size.QuadPart < 512 * 1024 * 1024 && (image->file = malloc(size.QuadPart)) &&
+        (!ReadFile(file, image->file, size.QuadPart, &read, NULL) || read != size.QuadPart))
+    {
+        free(image->file);
+        image->file = NULL;
+    }
+    CloseHandle(file);
+    if (!image->file) return NULL;
+    image->file_size = size.QuadPart;
+    dos = (const IMAGE_DOS_HEADER *)image->file;
+    if (image->file_size < sizeof(*dos) || dos->e_magic != IMAGE_DOS_SIGNATURE ||
+        dos->e_lfanew + sizeof(IMAGE_NT_HEADERS32) > image->file_size)
+        goto bad;
+    nt = (const IMAGE_NT_HEADERS *)(image->file + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE || nt->FileHeader.TimeDateStamp != m->TimeDateStamp)
+        goto bad;
+    image->sections = (const IMAGE_SECTION_HEADER *)((const BYTE *)&nt->OptionalHeader + nt->FileHeader.SizeOfOptionalHeader);
+    image->section_count = nt->FileHeader.NumberOfSections;
+    if ((const BYTE *)(image->sections + image->section_count) > image->file + image->file_size)
+        goto bad;
+    image->headers_size = nt->FileHeader.Machine == IMAGE_FILE_MACHINE_I386 ?
+            ((const IMAGE_NT_HEADERS32 *)nt)->OptionalHeader.SizeOfHeaders :
+            ((const IMAGE_NT_HEADERS64 *)nt)->OptionalHeader.SizeOfHeaders;
+    return image;
+bad:
+    WARN("%s is not the image the dump recorded\n", debugstr_w(path));
+    free(image->file);
+    image->file = NULL;
+    return NULL;
+}
+
+/* bytes of a module's image at a relative address, as the loader lays them out */
+static SIZE_T dump_image_read(const struct dump_image *image, ULONG64 rva, BYTE *buffer, SIZE_T size)
+{
+    unsigned int i;
+
+    if (rva < image->headers_size)
+    {
+        SIZE_T n = min(size, image->headers_size - rva);
+        if (rva + n > image->file_size) return 0;
+        memcpy(buffer, image->file + rva, n);
+        return n;
+    }
+    for (i = 0; i < image->section_count; i++)
+    {
+        const IMAGE_SECTION_HEADER *sec = &image->sections[i];
+        ULONG64 vsize = max(sec->Misc.VirtualSize, sec->SizeOfRawData), off;
+        SIZE_T n;
+
+        if (rva < sec->VirtualAddress || rva - sec->VirtualAddress >= vsize) continue;
+        off = rva - sec->VirtualAddress;
+        n = min(size, vsize - off);
+        if (off >= sec->SizeOfRawData) memset(buffer, 0, n);
+        else
+        {
+            SIZE_T raw = min(n, sec->SizeOfRawData - off);
+            if (sec->PointerToRawData + off + raw > image->file_size) return 0;
+            memcpy(buffer, image->file + sec->PointerToRawData + off, raw);
+            memset(buffer + raw, 0, n - raw);
+        }
+        return n;
+    }
+    return 0;
+}
+
+static HRESULT dump_open(const WCHAR *path, HANDLE file_handle, struct dump_target **out)
+{
+    const MINIDUMP_MEMORY_LIST *memory;
+    const MINIDUMP_MEMORY64_LIST *memory64;
+    const MINIDUMP_SYSTEM_INFO *sysinfo;
+    struct dump_target *dump;
+    LARGE_INTEGER size;
+    ULONG len, i;
+    HRESULT hr = HRESULT_FROM_WIN32(ERROR_BAD_FORMAT);
+
+    *out = NULL;
+    if (!(dump = calloc(1, sizeof(*dump)))) return E_OUTOFMEMORY;
+    if (path && !(dump->path = wcsdup(path))) { dump_free(dump); return E_OUTOFMEMORY; }
+    if (file_handle) DuplicateHandle(GetCurrentProcess(), file_handle, GetCurrentProcess(), &dump->file, 0, FALSE,
+            DUPLICATE_SAME_ACCESS);
+    else dump->file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (!dump->file || dump->file == INVALID_HANDLE_VALUE)
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        dump_free(dump);
+        return hr;
+    }
+    if (!GetFileSizeEx(dump->file, &size) || size.QuadPart < sizeof(MINIDUMP_HEADER) ||
+        !(dump->mapping = CreateFileMappingW(dump->file, NULL, PAGE_READONLY, 0, 0, NULL)) ||
+        !(dump->base = MapViewOfFile(dump->mapping, FILE_MAP_READ, 0, 0, 0)))
+        goto fail;
+    dump->size = size.QuadPart;
+    if (((const MINIDUMP_HEADER *)dump->base)->Signature != MINIDUMP_SIGNATURE ||
+        (((const MINIDUMP_HEADER *)dump->base)->Version & 0xffff) != (MINIDUMP_VERSION & 0xffff))
+        goto fail;
+    dump->flags = ((const MINIDUMP_HEADER *)dump->base)->Flags;
+
+    if ((dump->threads = dump_stream(dump, ThreadListStream, &len)) &&
+        (len < sizeof(ULONG) || (ULONG64)dump->threads->NumberOfThreads * sizeof(MINIDUMP_THREAD) > len - sizeof(ULONG)))
+        dump->threads = NULL;
+    if ((dump->modules = dump_stream(dump, ModuleListStream, &len)) &&
+        (len < sizeof(ULONG) || (ULONG64)dump->modules->NumberOfModules * sizeof(MINIDUMP_MODULE) > len - sizeof(ULONG)))
+        dump->modules = NULL;
+    if (dump->modules && dump->modules->NumberOfModules &&
+        !(dump->images = calloc(dump->modules->NumberOfModules, sizeof(*dump->images))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto fail;
+    }
+    if ((dump->exception = dump_stream(dump, ExceptionStream, &len)) && len < sizeof(MINIDUMP_EXCEPTION_STREAM))
+        dump->exception = NULL;
+    dump->arch = PROCESSOR_ARCHITECTURE_UNKNOWN;
+    if ((sysinfo = dump_stream(dump, SystemInfoStream, &len)) && len >= sizeof(*sysinfo))
+        dump->arch = sysinfo->ProcessorArchitecture;
+
+    /* the memory: the ranges of the memory lists, and the threads' stacks */
+    if ((memory = dump_stream(dump, MemoryListStream, &len)) && len >= sizeof(ULONG))
+        for (i = 0; i < memory->NumberOfMemoryRanges && (i + 1) * sizeof(MINIDUMP_MEMORY_DESCRIPTOR) <= len - sizeof(ULONG); i++)
+        {
+            const MINIDUMP_MEMORY_DESCRIPTOR *d = &memory->MemoryRanges[i];
+            if (!dump_add_range(dump, d->StartOfMemoryRange, d->Memory.DataSize,
+                    dump_at(dump, d->Memory.Rva, d->Memory.DataSize))) { hr = E_OUTOFMEMORY; goto fail; }
+        }
+    if ((memory64 = dump_stream(dump, Memory64ListStream, &len)) && len >= 2 * sizeof(ULONG64))
+    {
+        RVA64 rva = memory64->BaseRva;
+        for (i = 0; i < memory64->NumberOfMemoryRanges &&
+                (i + 1) * sizeof(MINIDUMP_MEMORY_DESCRIPTOR64) <= len - 2 * sizeof(ULONG64); i++)
+        {
+            const MINIDUMP_MEMORY_DESCRIPTOR64 *d = &memory64->MemoryRanges[i];
+            if (!dump_add_range(dump, d->StartOfMemoryRange, d->DataSize, dump_at(dump, rva, d->DataSize)))
+            { hr = E_OUTOFMEMORY; goto fail; }
+            rva += d->DataSize;
+        }
+    }
+    if (dump->threads)
+        for (i = 0; i < dump->threads->NumberOfThreads; i++)
+        {
+            const MINIDUMP_MEMORY_DESCRIPTOR *d = &dump->threads->Threads[i].Stack;
+            if (!dump_add_range(dump, d->StartOfMemoryRange, d->Memory.DataSize,
+                    dump_at(dump, d->Memory.Rva, d->Memory.DataSize))) { hr = E_OUTOFMEMORY; goto fail; }
+        }
+    *out = dump;
+    return S_OK;
+
+fail:
+    WARN("%s is not a minidump this engine reads\n", debugstr_w(path));
+    dump_free(dump);
+    return hr;
+}
+
+/* as ReadProcessMemory: the bytes the dump recorded from the address on (a range ending early is a partial copy) */
+static BOOL dump_read(const struct dump_target *dump, ULONG64 addr, void *buffer, SIZE_T size, SIZE_T *got)
+{
+    SIZE_T done = 0;
+    unsigned int i;
+
+    while (done < size)
+    {
+        ULONG64 at = addr + done;
+        const struct dump_range *r = NULL;
+
+        for (i = 0; i < dump->range_count; i++)
+            if (at >= dump->ranges[i].start && at - dump->ranges[i].start < dump->ranges[i].size)
+            {
+                r = &dump->ranges[i];
+                break;
+            }
+        if (!r)
+        {
+            /* what the dump left out of a module, from its image file */
+            const struct dump_image *image;
+            SIZE_T n = 0;
+            ULONG m;
+
+            for (m = 0; dump->modules && m < dump->modules->NumberOfModules; m++)
+            {
+                const MINIDUMP_MODULE *mod = &dump->modules->Modules[m];
+
+                if (at < mod->BaseOfImage || at - mod->BaseOfImage >= mod->SizeOfImage) continue;
+#ifndef SG_MUTANT_DUMP_NO_IMAGES
+                if ((image = dump_module_image((struct dump_target *)dump, m)))
+                    n = dump_image_read(image, at - mod->BaseOfImage, (BYTE *)buffer + done,
+                            min(size - done, mod->SizeOfImage - (at - mod->BaseOfImage)));
+#endif
+                break;
+            }
+            if (!n) break;
+            done += n;
+            continue;
+        }
+        {
+            SIZE_T n = min(size - done, r->size - (at - r->start));
+            memcpy((BYTE *)buffer + done, r->data + (at - r->start), n);
+            done += n;
+        }
+    }
+#ifdef SG_MUTANT_DUMP_NO_MEMORY
+    done = 0;
+#endif
+    if (got) *got = done;
+    if (done == size) return TRUE;
+    SetLastError(ERROR_PARTIAL_COPY);
+    return FALSE;
+}
+
+static BOOL target_read_memory(struct target_process *target, const void *addr, void *buffer, SIZE_T size, SIZE_T *got)
+{
+    if (target->dump) return dump_read(target->dump, (ULONG_PTR)addr, buffer, size, got);
+    return ReadProcessMemory(target->handle, addr, buffer, size, got);
+}
+
+/* StackWalk64's reader for a dump target */
+static BOOL CALLBACK dump_read_cb(HANDLE process, DWORD64 addr, void *buffer, DWORD size, DWORD *read)
+{
+    struct target_process *target = dump_target_from_handle(process);
+    SIZE_T got = 0;
+    BOOL ret;
+
+    if (!target || !target->dump) return FALSE;
+    ret = dump_read(target->dump, addr, buffer, size, &got);
+    if (read) *read = got;
+    return ret;
+}
+
+static const MINIDUMP_THREAD *dump_find_thread(const struct dump_target *dump, DWORD tid)
+{
+    ULONG i;
+
+    if (!dump->threads) return NULL;
+    for (i = 0; i < dump->threads->NumberOfThreads; i++)
+        if (dump->threads->Threads[i].ThreadId == tid) return &dump->threads->Threads[i];
+    return NULL;
+}
+
+/* the context the dump recorded for a thread: the one of the exception for its thread */
+static HRESULT dump_get_context(const struct dump_target *dump, DWORD tid, CONTEXT *ctx)
+{
+    const MINIDUMP_THREAD *thread = dump_find_thread(dump, tid);
+    const MINIDUMP_LOCATION_DESCRIPTOR *loc;
+    const void *data;
+
+#ifdef __x86_64__
+    if (dump->arch != PROCESSOR_ARCHITECTURE_AMD64) return E_NOTIMPL;
+#elif defined(__i386__)
+    if (dump->arch != PROCESSOR_ARCHITECTURE_INTEL) return E_NOTIMPL;
+#elif defined(__aarch64__)
+    if (dump->arch != PROCESSOR_ARCHITECTURE_ARM64) return E_NOTIMPL;
+#endif
+    if (dump->exception && dump->exception->ThreadId == tid) loc = &dump->exception->ThreadContext;
+    else if (thread) loc = &thread->ThreadContext;
+    else return E_INVALIDARG;
+    if (!(data = dump_at(dump, loc->Rva, loc->DataSize))) return E_FAIL;
+    memset(ctx, 0, sizeof(*ctx));
+    memcpy(ctx, data, min(loc->DataSize, sizeof(*ctx)));
+    return S_OK;
+}
+
+static HRESULT dump_init_modules(struct target_process *target)
+{
+    const struct dump_target *dump = target->dump;
+    ULONG i, count = dump->modules ? dump->modules->NumberOfModules : 0;
+
+    if (count && !(target->modules.info = calloc(count, sizeof(*target->modules.info)))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        const MINIDUMP_MODULE *m = &dump->modules->Modules[i];
+        const MINIDUMP_STRING *name = dump_at(dump, m->ModuleNameRva, sizeof(ULONG));
+
+        target->modules.info[i].params.Base = m->BaseOfImage;
+        target->modules.info[i].params.Size = m->SizeOfImage;
+        target->modules.info[i].params.TimeDateStamp = m->TimeDateStamp;
+        target->modules.info[i].params.Checksum = m->CheckSum;
+        if (name && dump_at(dump, m->ModuleNameRva + sizeof(ULONG), name->Length))
+            WideCharToMultiByte(CP_ACP, 0, name->Buffer, name->Length / sizeof(WCHAR),
+                    target->modules.info[i].image_name, sizeof(target->modules.info[i].image_name) - 1, NULL, NULL);
+    }
+    switch (dump->arch)
+    {
+    case PROCESSOR_ARCHITECTURE_AMD64: target->cpu_type = IMAGE_FILE_MACHINE_AMD64; break;
+    case PROCESSOR_ARCHITECTURE_ARM64: target->cpu_type = IMAGE_FILE_MACHINE_ARM64; break;
+    case PROCESSOR_ARCHITECTURE_ARM: target->cpu_type = IMAGE_FILE_MACHINE_ARMNT; break;
+    default: target->cpu_type = IMAGE_FILE_MACHINE_I386; break;
+    }
+    target->modules.loaded = count;
+    target->modules.unloaded = 0;
+    target->modules.initialized = TRUE;
+    return S_OK;
+}
+
