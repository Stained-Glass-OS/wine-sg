From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs: fast metadata encoder (6014)

CreateFastMetadataEncoderFromDecoder/FromFrameDecode for the formats with
in-place metadata; Commit reports that the file has no padding (G-WIC).
---
diff --git a/dlls/windowscodecs/imgfactory.c b/dlls/windowscodecs/imgfactory.c
index 0c4c8d2..2b974b7 100644
--- a/dlls/windowscodecs/imgfactory.c
+++ b/dlls/windowscodecs/imgfactory.c
@@ -1030,20 +1030,169 @@ static HRESULT WINAPI ImagingFactory_CreateComponentEnumerator(IWICImagingFactor
 static HRESULT create_metadata_writer(REFGUID format, const GUID *vendor, DWORD options,
         IWICMetadataWriter **writer);
 
+/* Stained Glass OS: the fast (in-place) metadata encoder. The metadata can
+ * be read and changed through its query writer; written back in place it
+ * only fits where the file kept padding for it, which no file read here does:
+ * Commit answers WINCODEC_ERR_TOOMUCHMETADATA, as Windows does for a file
+ * without that padding, and a program then writes a new file with the
+ * metadata (the documented fallback). Formats without in-place editing
+ * (only JPEG, TIFF and JPEG XR have it) are refused at creation. */
+struct fast_metadata_encoder
+{
+    IWICFastMetadataEncoder IWICFastMetadataEncoder_iface;
+    LONG ref;
+    IWICImagingFactory2 *factory;
+    IWICMetadataQueryReader *reader;
+    GUID container;
+    BOOL committed;
+};
+
+static inline struct fast_metadata_encoder *impl_from_IWICFastMetadataEncoder(IWICFastMetadataEncoder *iface)
+{
+    return CONTAINING_RECORD(iface, struct fast_metadata_encoder, IWICFastMetadataEncoder_iface);
+}
+
+static HRESULT WINAPI FastMetadataEncoder_QueryInterface(IWICFastMetadataEncoder *iface, REFIID iid, void **ppv)
+{
+    struct fast_metadata_encoder *This = impl_from_IWICFastMetadataEncoder(iface);
+
+    TRACE("(%p,%s,%p)\n", iface, debugstr_guid(iid), ppv);
+
+    if (!ppv) return E_INVALIDARG;
+    if (IsEqualIID(&IID_IUnknown, iid) || IsEqualIID(&IID_IWICFastMetadataEncoder, iid))
+    {
+        *ppv = &This->IWICFastMetadataEncoder_iface;
+        IWICFastMetadataEncoder_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI FastMetadataEncoder_AddRef(IWICFastMetadataEncoder *iface)
+{
+    struct fast_metadata_encoder *This = impl_from_IWICFastMetadataEncoder(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI FastMetadataEncoder_Release(IWICFastMetadataEncoder *iface)
+{
+    struct fast_metadata_encoder *This = impl_from_IWICFastMetadataEncoder(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        if (This->reader) IWICMetadataQueryReader_Release(This->reader);
+        IWICImagingFactory2_Release(This->factory);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI FastMetadataEncoder_Commit(IWICFastMetadataEncoder *iface)
+{
+    struct fast_metadata_encoder *This = impl_from_IWICFastMetadataEncoder(iface);
+
+    TRACE("(%p)\n", iface);
+
+    if (This->committed) return WINCODEC_ERR_WRONGSTATE;
+    This->committed = TRUE;
+#ifdef SG_MUTANT_FAST_ENCODER_COMMIT_OK
+    return S_OK;
+#endif
+    return WINCODEC_ERR_TOOMUCHMETADATA;
+}
+
+static HRESULT WINAPI FastMetadataEncoder_GetMetadataQueryWriter(IWICFastMetadataEncoder *iface,
+        IWICMetadataQueryWriter **writer)
+{
+    struct fast_metadata_encoder *This = impl_from_IWICFastMetadataEncoder(iface);
+
+    TRACE("(%p,%p)\n", iface, writer);
+
+    if (!writer) return E_INVALIDARG;
+    *writer = NULL;
+    if (This->committed) return WINCODEC_ERR_WRONGSTATE;
+    /* the metadata the image has, to change */
+    if (This->reader)
+        return IWICImagingFactory2_CreateQueryWriterFromReader(This->factory, This->reader, NULL, writer);
+    return IWICImagingFactory2_CreateQueryWriter(This->factory, &This->container, NULL, writer);
+}
+
+static const IWICFastMetadataEncoderVtbl FastMetadataEncoder_Vtbl =
+{
+    FastMetadataEncoder_QueryInterface,
+    FastMetadataEncoder_AddRef,
+    FastMetadataEncoder_Release,
+    FastMetadataEncoder_Commit,
+    FastMetadataEncoder_GetMetadataQueryWriter
+};
+
+static HRESULT create_fast_metadata_encoder(IWICImagingFactory2 *factory, const GUID *container,
+        IWICMetadataQueryReader *reader, IWICFastMetadataEncoder **out)
+{
+    struct fast_metadata_encoder *This;
+
+#ifndef SG_MUTANT_FAST_ENCODER_ALL_FORMATS
+    if (!IsEqualGUID(container, &GUID_ContainerFormatJpeg) && !IsEqualGUID(container, &GUID_ContainerFormatTiff) &&
+        !IsEqualGUID(container, &GUID_ContainerFormatWmp))
+        return WINCODEC_ERR_UNSUPPORTEDOPERATION;
+#endif
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->IWICFastMetadataEncoder_iface.lpVtbl = &FastMetadataEncoder_Vtbl;
+    This->ref = 1;
+    This->factory = factory;
+    IWICImagingFactory2_AddRef(factory);
+    This->reader = reader;
+    if (reader) IWICMetadataQueryReader_AddRef(reader);
+    This->container = *container;
+    *out = &This->IWICFastMetadataEncoder_iface;
+    return S_OK;
+}
+
 static HRESULT WINAPI ImagingFactory_CreateFastMetadataEncoderFromDecoder(
     IWICImagingFactory2 *iface, IWICBitmapDecoder *pIDecoder,
     IWICFastMetadataEncoder **ppIFastEncoder)
 {
-    FIXME("(%p,%p,%p): stub\n", iface, pIDecoder, ppIFastEncoder);
-    return E_NOTIMPL;
+    IWICMetadataQueryReader *reader = NULL;
+    GUID container;
+    HRESULT hr;
+
+    TRACE("(%p,%p,%p)\n", iface, pIDecoder, ppIFastEncoder);
+
+    if (!pIDecoder || !ppIFastEncoder) return E_INVALIDARG;
+    *ppIFastEncoder = NULL;
+    if (FAILED(hr = IWICBitmapDecoder_GetContainerFormat(pIDecoder, &container))) return hr;
+    /* the container's own metadata, where it has any */
+    if (FAILED(IWICBitmapDecoder_GetMetadataQueryReader(pIDecoder, &reader))) reader = NULL;
+    hr = create_fast_metadata_encoder(iface, &container, reader, ppIFastEncoder);
+    if (reader) IWICMetadataQueryReader_Release(reader);
+    return hr;
 }
 
 static HRESULT WINAPI ImagingFactory_CreateFastMetadataEncoderFromFrameDecode(
     IWICImagingFactory2 *iface, IWICBitmapFrameDecode *pIFrameDecoder,
     IWICFastMetadataEncoder **ppIFastEncoder)
 {
-    FIXME("(%p,%p,%p): stub\n", iface, pIFrameDecoder, ppIFastEncoder);
-    return E_NOTIMPL;
+    IWICMetadataQueryReader *reader = NULL;
+    IWICMetadataBlockReader *blocks;
+    GUID container;
+    HRESULT hr;
+
+    TRACE("(%p,%p,%p)\n", iface, pIFrameDecoder, ppIFastEncoder);
+
+    if (!pIFrameDecoder || !ppIFastEncoder) return E_INVALIDARG;
+    *ppIFastEncoder = NULL;
+    /* the frame's container format, from its block reader */
+    if (FAILED(hr = IWICBitmapFrameDecode_QueryInterface(pIFrameDecoder, &IID_IWICMetadataBlockReader, (void **)&blocks)))
+        return WINCODEC_ERR_UNSUPPORTEDOPERATION;
+    hr = IWICMetadataBlockReader_GetContainerFormat(blocks, &container);
+    IWICMetadataBlockReader_Release(blocks);
+    if (FAILED(hr)) return hr;
+    if (FAILED(IWICBitmapFrameDecode_GetMetadataQueryReader(pIFrameDecoder, &reader))) reader = NULL;
+    hr = create_fast_metadata_encoder(iface, &container, reader, ppIFastEncoder);
+    if (reader) IWICMetadataQueryReader_Release(reader);
+    return hr;
 }
 
 /* A block writer that belongs to no encoder: the blocks of a query writer made
