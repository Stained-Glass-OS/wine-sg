From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: a new console opens in the default terminal

David 2026-10-03: "All the terminal apps should support Tabs. Including the
Linux and Windows terminal." PowerShell or cmd started from the Start menu,
a shortcut or Explorer opened in a console window of its own, without tabs.

As Windows 11 hands a new console to Windows Terminal, a console that would
open a window now opens in the terminal named by wt.exe's App Paths entry
(sg-terminal): it is started with the console's server handle
(--sg-handoff 0xHANDLE --title TITLE) and runs a headless conhost on it in a
new tab, as for its own pseudo consoles. The program itself is started as
before -- its process handle, exit code and console are its own, so
start /wait and CreateProcess callers see no difference. Only for a
terminal that says it takes the handoff (SgConsoleHandoff = 1 beside its
App Paths entry; sg-shell's defaults set it): an older terminal would leave
the program on a console no conhost serves. Not for a console
started hidden (SW_HIDE), nor when Default terminal is the console host
(HKCU\Console\%%Startup DelegationTerminal = conhost's CLSID, as Windows
keeps it), nor for wt.exe or conhost themselves; with no terminal, or one
that cannot start, conhost opens its window as ever.

A terminal taking the handoff must give conhost an overlapped signal pipe
(as CreatePseudoConsole does): conhost reads it asynchronously, and a
synchronous pipe blocks its main loop before the first request.

Test: test/defterm-gate.sh with the stand-in terminal test/defterm-term.c
(mutant SG_MUTANT_NO_DEFTERM).
---
--- a/dlls/kernelbase/console.c
+++ b/dlls/kernelbase/console.c
@@ -36,6 +36,7 @@
 #include "winnls.h"
 #include "winerror.h"
 #include "wincon.h"
+#include "winreg.h"
 #include "winternl.h"
 #include "wine/condrv.h"
 #include "wine/exception.h"
@@ -419,6 +420,69 @@
 
 static BOOL alloc_console_ex( BOOL headless, BOOL keep_std_handles );
 
+/* Stained Glass OS: the default terminal (David 2026-10-03: "All the terminal
+ * apps should support Tabs"). As Windows 11 hands a new console to Windows
+ * Terminal, a console that would open a window of its own opens as a tab of
+ * the terminal (the App Paths entry of wt.exe, sg-terminal) instead: the
+ * terminal is given the console's server handle (--sg-handoff) and runs a
+ * headless conhost on it, as for its own pseudo consoles. The program is
+ * started as before -- its process, exit code and console are its own -- and
+ * only the window differs. Only for a terminal that says it takes the
+ * handoff (SgConsoleHandoff = 1 beside its App Paths entry); not for a
+ * console started hidden, nor when Default terminal is set to the console
+ * host (DelegationTerminal, as Windows keeps it); without such a terminal,
+ * or when it cannot start, conhost opens its window as ever. */
+static BOOL sg_delegate_console( STARTUPINFOEXW *console_si, HANDLE server )
+{
+    static const WCHAR conhost_clsid[] = L"{B23D10C0-E52E-411E-9D5B-C09FDF709C7D}";
+    WCHAR term[MAX_PATH], self[MAX_PATH], value[64], title[256], cmd[MAX_PATH + 320];
+    const WCHAR *t = console_si->StartupInfo.lpTitle, *name;
+    PROCESS_INFORMATION pi;
+    DWORD size, handoff = 0;
+    unsigned int i = 0;
+
+#ifdef SG_MUTANT_NO_DEFTERM
+    return FALSE;
+#endif
+    if ((console_si->StartupInfo.dwFlags & STARTF_USESHOWWINDOW) && console_si->StartupInfo.wShowWindow == 0 /* SW_HIDE */)
+        return FALSE;
+    size = sizeof(value);
+    if (!RegGetValueW( HKEY_CURRENT_USER, L"Console\\%%Startup", L"DelegationTerminal", RRF_RT_REG_SZ, NULL,
+                       value, &size ) && !wcsicmp( value, conhost_clsid ))
+        return FALSE;
+    /* only a terminal that says it takes the handoff (SgConsoleHandoff = 1): one
+     * that did not would leave the program on a console no conhost serves */
+    size = sizeof(handoff);
+    if (RegGetValueW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\wt.exe",
+                      L"SgConsoleHandoff", RRF_RT_REG_DWORD, NULL, &handoff, &size ) || handoff != 1)
+        return FALSE;
+    size = sizeof(term);
+    if (RegGetValueW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\wt.exe", NULL,
+                      RRF_RT_REG_SZ, NULL, term, &size ))
+        return FALSE;
+    if (GetFileAttributesW( term ) == INVALID_FILE_ATTRIBUTES) return FALSE;
+    /* the terminal itself, should it ever want a console window, keeps conhost's */
+    if (GetModuleFileNameW( 0, self, ARRAY_SIZE(self) ))
+    {
+        name = wcsrchr( self, '\\' ) ? wcsrchr( self, '\\' ) + 1 : self;
+        if (!wcsicmp( self, term ) || !wcsicmp( name, L"wt.exe" ) || !wcsicmp( name, L"conhost.exe" )) return FALSE;
+    }
+    /* the window's first title (the program's path), without quotes */
+    if (t) for (; *t && i < ARRAY_SIZE(title) - 1; t++) if (*t != '"') title[i++] = *t;
+    title[i] = 0;
+    swprintf( cmd, ARRAY_SIZE(cmd), L"\"%s\" --sg-handoff 0x%x --title \"%s\"", term, condrv_handle( server ), title );
+    if (!CreateProcessW( term, cmd, NULL, NULL, TRUE, DETACHED_PROCESS | EXTENDED_STARTUPINFO_PRESENT,
+                         NULL, NULL, &console_si->StartupInfo, &pi ))
+    {
+        WARN( "default terminal %s did not start (%lu): conhost's window instead\n", debugstr_w(term), GetLastError() );
+        return FALSE;
+    }
+    TRACE( "console handed to %s, pid %04lx\n", debugstr_w(term), pi.dwProcessId );
+    CloseHandle( pi.hThread );
+    CloseHandle( pi.hProcess );
+    return TRUE;
+}
+
 static BOOL alloc_console( BOOL headless )
 {
     return alloc_console_ex( headless, FALSE );
@@ -489,10 +553,18 @@
     swprintf( conhost_path, ARRAY_SIZE(conhost_path), L"%s\\conhost.exe", system_dir );
     swprintf( cmd, ARRAY_SIZE(cmd),  L"\"%s\" --server 0x%x", conhost_path, condrv_handle( server ));
     if (headless) wcscat( cmd, L" --headless" );
-    Wow64DisableWow64FsRedirection( &redir );
-    ret = CreateProcessW( conhost_path, cmd, NULL, NULL, TRUE, DETACHED_PROCESS | EXTENDED_STARTUPINFO_PRESENT,
-                          NULL, NULL, &console_si.StartupInfo, &pi );
-    Wow64RevertWow64FsRedirection( redir );
+    if (!headless && sg_delegate_console( &console_si, server ))
+    {
+        ret = TRUE;
+        pi.dwProcessId = pi.dwThreadId = 0;
+    }
+    else
+    {
+        Wow64DisableWow64FsRedirection( &redir );
+        ret = CreateProcessW( conhost_path, cmd, NULL, NULL, TRUE, DETACHED_PROCESS | EXTENDED_STARTUPINFO_PRESENT,
+                              NULL, NULL, &console_si.StartupInfo, &pi );
+        Wow64RevertWow64FsRedirection( redir );
+    }
 
     if (!ret || !create_console_connection( console)) goto error;
     if (!init_console_std_handles( !keep_std_handles && !(app_si.dwFlags & STARTF_USESTDHANDLES) )) goto error;
