From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] webservices: HTTP header authentication on HTTP channels

N-WEBSERVICES transports, first step (wine-sg 7811). WsCreateChannel
ignored its security description. An HTTP channel now takes
WS_HTTP_HEADER_AUTH_SECURITY_BINDING (schemes, target, a string or the
default Windows-integrated credential) and WS_SSL_TRANSPORT_SECURITY_BINDING
(the https URL already secures it; client certificates are not supported):
challenged with 401 (or 407 for a proxy target), the request is sent again
with the credential, in a scheme the caller allows, the server's first if
it is one, else the strongest both have; the user's own credentials only go
to Negotiate and NTLM. A refusal, 403 and 404 are reported as
WS_E_ENDPOINT_ACCESS_DENIED and WS_E_ENDPOINT_NOT_FOUND instead of being
parsed as the reply. include/webservices.h gets the structures and scheme
flags the documentation describes.
---
 dlls/webservices/channel.c | 197 +++++++++++++++++++++++++++++++++++--
 include/webservices.h      |  48 +++++++++
 2 files changed, 237 insertions(+), 8 deletions(-)

diff --git a/dlls/webservices/channel.c b/dlls/webservices/channel.c
index f72f5b7..868b725 100644
--- a/dlls/webservices/channel.c
+++ b/dlls/webservices/channel.c
@@ -215,6 +215,15 @@ struct channel
     struct dictionary       dict_recv;
     struct queue            send_q;
     struct queue            recv_q;
+    /* HTTP header authentication (wine-sg 7811): schemes the caller allows, 0 for none, and its credential */
+    struct
+    {
+        ULONG  schemes;
+        DWORD  target;     /* WINHTTP_AUTH_TARGET_* */
+        BOOL   defaults;   /* the user's own (logon) credentials */
+        WCHAR *username;   /* domain\user when a domain is given */
+        WCHAR *password;
+    } auth;
     union
     {
         struct
@@ -399,6 +408,12 @@ static void free_channel( struct channel *channel )
     free( channel->read_buf );
     free( channel->send_buf );
     free_props( channel );
+    free( channel->auth.username );
+    if (channel->auth.password)
+    {
+        SecureZeroMemory( channel->auth.password, wcslen( channel->auth.password ) * sizeof(WCHAR) );
+        free( channel->auth.password );
+    }
 
     channel->send_q.cs.DebugInfo->Spare[0] = 0;
     channel->recv_q.cs.DebugInfo->Spare[0] = 0;
@@ -572,6 +587,100 @@ static HRESULT create_channel( WS_CHANNEL_TYPE type, WS_CHANNEL_BINDING binding,
     return S_OK;
 }
 
+static WCHAR *dup_ws_string( const WS_STRING *str, const WS_STRING *prefix )
+{
+    ULONG len = str->length + (prefix && prefix->length ? prefix->length + 1 : 0);
+    WCHAR *ret, *p;
+
+    if (!(p = ret = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+    if (prefix && prefix->length)
+    {
+        memcpy( p, prefix->chars, prefix->length * sizeof(WCHAR) );
+        p += prefix->length;
+        *p++ = '\\';
+    }
+    memcpy( p, str->chars, str->length * sizeof(WCHAR) );
+    ret[len] = 0;
+    return ret;
+}
+
+/* the security description of an HTTP channel: SSL (the URL's https says it), and HTTP header
+ * authentication with the caller's credential (wine-sg 7811) */
+static HRESULT set_channel_security( struct channel *channel, const WS_SECURITY_DESCRIPTION *desc )
+{
+    ULONG i, j;
+
+    for (i = 0; i < desc->securityBindingCount; i++)
+    {
+        const WS_SECURITY_BINDING *binding = desc->securityBindings[i];
+
+        if (!binding) return E_INVALIDARG;
+        switch (binding->bindingType)
+        {
+        case WS_SSL_TRANSPORT_SECURITY_BINDING_TYPE:
+            if (channel->binding != WS_HTTP_CHANNEL_BINDING) return E_INVALIDARG;
+            if (((const WS_SSL_TRANSPORT_SECURITY_BINDING *)binding)->localCertCredential)
+                FIXME( "client certificates not supported\n" );
+            break;
+
+        case WS_HTTP_HEADER_AUTH_SECURITY_BINDING_TYPE:
+        {
+            const WS_HTTP_HEADER_AUTH_SECURITY_BINDING *http = (const WS_HTTP_HEADER_AUTH_SECURITY_BINDING *)binding;
+            const WS_WINDOWS_INTEGRATED_AUTH_CREDENTIAL *cred = http->clientCredential;
+            ULONG schemes = WS_HTTP_HEADER_AUTH_SCHEME_NEGOTIATE;
+            WS_HTTP_HEADER_AUTH_TARGET target = WS_HTTP_HEADER_AUTH_TARGET_SERVICE;
+
+            if (channel->binding != WS_HTTP_CHANNEL_BINDING || !cred) return E_INVALIDARG;
+            for (j = 0; j < binding->propertyCount; j++)
+            {
+                const WS_SECURITY_BINDING_PROPERTY *prop = &binding->properties[j];
+                switch (prop->id)
+                {
+                case WS_SECURITY_BINDING_PROPERTY_HTTP_HEADER_AUTH_SCHEME:
+                    if (prop->valueSize != sizeof(ULONG) || !prop->value) return E_INVALIDARG;
+                    schemes = *(const ULONG *)prop->value;
+                    break;
+                case WS_SECURITY_BINDING_PROPERTY_HTTP_HEADER_AUTH_TARGET:
+                    if (prop->valueSize != sizeof(target) || !prop->value) return E_INVALIDARG;
+                    target = *(const WS_HTTP_HEADER_AUTH_TARGET *)prop->value;
+                    if (target != WS_HTTP_HEADER_AUTH_TARGET_SERVICE && target != WS_HTTP_HEADER_AUTH_TARGET_PROXY)
+                        return E_INVALIDARG;
+                    break;
+                default:
+                    FIXME( "ignoring security binding property %u\n", prop->id );
+                    break;
+                }
+            }
+            if (!schemes || (schemes & ~0x3f)) return E_INVALIDARG;
+            switch (cred->credentialType)
+            {
+            case WS_STRING_WINDOWS_INTEGRATED_AUTH_CREDENTIAL_TYPE:
+            {
+                const WS_STRING_WINDOWS_INTEGRATED_AUTH_CREDENTIAL *str = (const void *)cred;
+                if (!(channel->auth.username = dup_ws_string( &str->username, &str->domain )) ||
+                    !(channel->auth.password = dup_ws_string( &str->password, NULL ))) return E_OUTOFMEMORY;
+                break;
+            }
+            case WS_DEFAULT_WINDOWS_INTEGRATED_AUTH_CREDENTIAL_TYPE:
+                channel->auth.defaults = TRUE;
+                break;
+            default:
+                FIXME( "credential type %u not supported\n", cred->credentialType );
+                return E_NOTIMPL;
+            }
+            channel->auth.schemes = schemes;
+            channel->auth.target = target == WS_HTTP_HEADER_AUTH_TARGET_PROXY ? WINHTTP_AUTH_TARGET_PROXY
+                                                                              : WINHTTP_AUTH_TARGET_SERVER;
+            break;
+        }
+        default:
+            FIXME( "security binding type %u not supported, ignored\n", binding->bindingType );
+            break;
+        }
+    }
+    return S_OK;
+}
+
 static HRESULT WsCreateChannel_impl( WS_CHANNEL_TYPE type, WS_CHANNEL_BINDING binding,
                                 const WS_CHANNEL_PROPERTY *properties, ULONG count,
                                 const WS_SECURITY_DESCRIPTION *desc, WS_CHANNEL **handle,
@@ -581,7 +690,6 @@ static HRESULT WsCreateChannel_impl( WS_CHANNEL_TYPE type, WS_CHANNEL_BINDING bi
     HRESULT hr;
 
     TRACE( "%u %u %p %lu %p %p %p\n", type, binding, properties, count, desc, handle, error );
-    if (desc) FIXME( "ignoring security description\n" );
 
     if (!handle) return E_INVALIDARG;
 
@@ -604,6 +712,11 @@ static HRESULT WsCreateChannel_impl( WS_CHANNEL_TYPE type, WS_CHANNEL_BINDING bi
     }
 
     if ((hr = create_channel( type, binding, properties, count, &channel )) != S_OK) return hr;
+    if (desc && (hr = set_channel_security( channel, desc )) != S_OK)
+    {
+        free_channel( channel );
+        return hr;
+    }
 
     TRACE( "created %p\n", channel );
     *handle = (WS_CHANNEL *)channel;
@@ -1334,16 +1447,84 @@ HRESULT WINAPI WsOpenChannel( WS_CHANNEL *handle, const WS_ENDPOINT_ADDRESS *end
     return set_error( error, WsOpenChannel_impl( handle, endpoint, ctx, error ) );
 }
 
-static HRESULT send_message_http( HINTERNET request, BYTE *data, ULONG len )
+/* the scheme to answer a challenge with: the server's first if the caller allows it, else the strongest
+ * both have. The user's own credentials only go to the integrated schemes, never in clear text. */
+static DWORD pick_auth_scheme( ULONG allowed, DWORD supported, DWORD first, BOOL defaults )
 {
-    if (!WinHttpSendRequest( request, NULL, 0, data, len, len, 0 ))
-        return HRESULT_FROM_WIN32( GetLastError() );
+    static const struct { ULONG ws; DWORD winhttp; } schemes[] =
+    {
+        { WS_HTTP_HEADER_AUTH_SCHEME_NEGOTIATE, WINHTTP_AUTH_SCHEME_NEGOTIATE },
+        { WS_HTTP_HEADER_AUTH_SCHEME_NTLM,      WINHTTP_AUTH_SCHEME_NTLM },
+        { WS_HTTP_HEADER_AUTH_SCHEME_DIGEST,    WINHTTP_AUTH_SCHEME_DIGEST },
+        { WS_HTTP_HEADER_AUTH_SCHEME_BASIC,     WINHTTP_AUTH_SCHEME_BASIC },
+        { WS_HTTP_HEADER_AUTH_SCHEME_PASSPORT,  WINHTTP_AUTH_SCHEME_PASSPORT },
+    };
+    const ULONG integrated = WS_HTTP_HEADER_AUTH_SCHEME_NEGOTIATE | WS_HTTP_HEADER_AUTH_SCHEME_NTLM;
+    ULONG i;
 
-    if (!WinHttpReceiveResponse( request, NULL ))
-        return HRESULT_FROM_WIN32( GetLastError() );
-    return S_OK;
+    if (defaults) allowed &= integrated;
+    for (i = 0; i < ARRAY_SIZE(schemes); i++)
+        if ((allowed & schemes[i].ws) && schemes[i].winhttp == first) return first;
+    for (i = 0; i < ARRAY_SIZE(schemes); i++)
+        if ((allowed & schemes[i].ws) && (supported & schemes[i].winhttp)) return schemes[i].winhttp;
+    return 0;
 }
 
+static DWORD http_status( HINTERNET request )
+{
+    DWORD status = 0, size = sizeof(status);
+    WinHttpQueryHeaders( request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, NULL, &status, &size, NULL );
+    return status;
+}
+
+static HRESULT send_message_http( struct channel *channel, HINTERNET request, BYTE *data, ULONG len )
+{
+    DWORD status, supported, first, target, scheme;
+    int tries = 0;
+
+    for (;;)
+    {
+        if (!WinHttpSendRequest( request, NULL, 0, data, len, len, 0 ))
+            return HRESULT_FROM_WIN32( GetLastError() );
+
+        if (!WinHttpReceiveResponse( request, NULL ))
+            return HRESULT_FROM_WIN32( GetLastError() );
+
+        status = http_status( request );
+        if (status != HTTP_STATUS_DENIED && status != HTTP_STATUS_PROXY_AUTH_REQ) break;
+        /* challenged: answered with the caller's credential, if it has one for that target */
+        if (!channel->auth.schemes || tries++ >= 2) break;
+        if ((status == HTTP_STATUS_DENIED) != (channel->auth.target == WINHTTP_AUTH_TARGET_SERVER)) break;
+        if (!WinHttpQueryAuthSchemes( request, &supported, &first, &target )) break;
+#ifndef SG_MUTANT_WS_AUTH_ANY_SCHEME
+        if (!(scheme = pick_auth_scheme( channel->auth.schemes, supported, first, channel->auth.defaults ))) break;
+#else
+        scheme = first;
+#endif
+        if (channel->auth.defaults)
+        {
+            DWORD policy = WINHTTP_AUTOLOGON_SECURITY_LEVEL_LOW;
+            WinHttpSetOption( request, WINHTTP_OPTION_AUTOLOGON_POLICY, &policy, sizeof(policy) );
+        }
+        if (!WinHttpSetCredentials( request, channel->auth.target, scheme, channel->auth.username,
+                                    channel->auth.password, NULL ))
+            return HRESULT_FROM_WIN32( GetLastError() );
+    }
+
+    switch (status)
+    {
+    case HTTP_STATUS_DENIED:
+    case HTTP_STATUS_PROXY_AUTH_REQ:
+    case HTTP_STATUS_FORBIDDEN:
+        return WS_E_ENDPOINT_ACCESS_DENIED;
+    case HTTP_STATUS_NOT_FOUND:
+        return WS_E_ENDPOINT_NOT_FOUND;
+    default:
+        return S_OK;
+    }
+}
+
+
 static ULONG get_max_buffer_size( struct channel *channel )
 {
     ULONG size;
@@ -1634,7 +1815,7 @@ static HRESULT send_message_bytes( struct channel *channel, WS_MESSAGE *msg )
         }
         if ((hr = open_http_request( channel, &channel->u.http.request )) != S_OK) return hr;
         if ((hr = message_insert_http_headers( msg, channel->u.http.request )) != S_OK) return hr;
-        return send_message_http( channel->u.http.request, buf.bytes, buf.length );
+        return send_message_http( channel, channel->u.http.request, buf.bytes, buf.length );
 
     case WS_TCP_CHANNEL_BINDING:
         if (channel->type & WS_CHANNEL_TYPE_SESSION)
diff --git a/include/webservices.h b/include/webservices.h
index 0e30ed7..fd5cea8 100644
--- a/include/webservices.h
+++ b/include/webservices.h
@@ -1041,6 +1041,54 @@ struct _WS_SSL_TRANSPORT_SECURITY_BINDING_TEMPLATE {
     WS_CERT_CREDENTIAL *localCertCredential;
 };
 
+typedef struct _WS_SSL_TRANSPORT_SECURITY_BINDING {
+    WS_SECURITY_BINDING binding;
+    WS_CERT_CREDENTIAL *localCertCredential;
+} WS_SSL_TRANSPORT_SECURITY_BINDING;
+
+#define WS_HTTP_HEADER_AUTH_SCHEME_NONE         0x1
+#define WS_HTTP_HEADER_AUTH_SCHEME_BASIC        0x2
+#define WS_HTTP_HEADER_AUTH_SCHEME_DIGEST       0x4
+#define WS_HTTP_HEADER_AUTH_SCHEME_NTLM         0x8
+#define WS_HTTP_HEADER_AUTH_SCHEME_NEGOTIATE    0x10
+#define WS_HTTP_HEADER_AUTH_SCHEME_PASSPORT     0x20
+
+typedef enum {
+    WS_HTTP_HEADER_AUTH_TARGET_SERVICE  = 1,
+    WS_HTTP_HEADER_AUTH_TARGET_PROXY    = 2
+} WS_HTTP_HEADER_AUTH_TARGET;
+
+typedef enum {
+    WS_STRING_WINDOWS_INTEGRATED_AUTH_CREDENTIAL_TYPE   = 1,
+    WS_DEFAULT_WINDOWS_INTEGRATED_AUTH_CREDENTIAL_TYPE  = 2,
+    WS_OPAQUE_WINDOWS_INTEGRATED_AUTH_CREDENTIAL_TYPE   = 3
+} WS_WINDOWS_INTEGRATED_AUTH_CREDENTIAL_TYPE;
+
+typedef struct _WS_WINDOWS_INTEGRATED_AUTH_CREDENTIAL {
+    WS_WINDOWS_INTEGRATED_AUTH_CREDENTIAL_TYPE credentialType;
+} WS_WINDOWS_INTEGRATED_AUTH_CREDENTIAL;
+
+typedef struct _WS_STRING_WINDOWS_INTEGRATED_AUTH_CREDENTIAL {
+    WS_WINDOWS_INTEGRATED_AUTH_CREDENTIAL credential;
+    WS_STRING username;
+    WS_STRING password;
+    WS_STRING domain;
+} WS_STRING_WINDOWS_INTEGRATED_AUTH_CREDENTIAL;
+
+typedef struct _WS_DEFAULT_WINDOWS_INTEGRATED_AUTH_CREDENTIAL {
+    WS_WINDOWS_INTEGRATED_AUTH_CREDENTIAL credential;
+} WS_DEFAULT_WINDOWS_INTEGRATED_AUTH_CREDENTIAL;
+
+typedef struct _WS_OPAQUE_WINDOWS_INTEGRATED_AUTH_CREDENTIAL {
+    WS_WINDOWS_INTEGRATED_AUTH_CREDENTIAL credential;
+    void *opaqueAuthIdentity;
+} WS_OPAQUE_WINDOWS_INTEGRATED_AUTH_CREDENTIAL;
+
+typedef struct _WS_HTTP_HEADER_AUTH_SECURITY_BINDING {
+    WS_SECURITY_BINDING binding;
+    WS_WINDOWS_INTEGRATED_AUTH_CREDENTIAL *clientCredential;
+} WS_HTTP_HEADER_AUTH_SECURITY_BINDING;
+
 struct _WS_HTTP_BINDING_TEMPLATE {
     WS_CHANNEL_PROPERTIES channelProperties;
 };
