+/* ---------------------------------------------------------------------- */
+/* Router configuration of the local machine: empty                       */
+
+#define CONFIG_MAGIC 0x4d505243
+
+struct config
+{
+    struct list entry;
+    DWORD       magic;
+};
+
+static struct list configs = LIST_INIT( configs );
+static CRITICAL_SECTION configs_cs = { NULL, -1, 0, 0, 0, 0 };
+
+static BOOL valid_config( HANDLE handle )
+{
+    struct config *c;
+    BOOL ret = FALSE;
+
+    EnterCriticalSection( &configs_cs );
+    LIST_FOR_EACH_ENTRY( c, &configs, struct config, entry ) if (c == handle) { ret = TRUE; break; }
+    LeaveCriticalSection( &configs_cs );
+    return ret;
+}
+
+DWORD WINAPI MprConfigServerConnect( LPWSTR server, HANDLE *handle )
+{
+    struct config *c;
+
+    TRACE( "(%s, %p)\n", debugstr_w(server), handle );
+
+    if (!handle) return ERROR_INVALID_PARAMETER;
+    *handle = NULL;
+    if (!is_local_server( server )) return RPC_S_SERVER_UNAVAILABLE;
+    if (!(c = HeapAlloc( GetProcessHeap(), 0, sizeof(*c) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    c->magic = CONFIG_MAGIC;
+    EnterCriticalSection( &configs_cs );
+    list_add_tail( &configs, &c->entry );
+    LeaveCriticalSection( &configs_cs );
+    *handle = c;
+    return ERROR_SUCCESS;
+}
+
+void WINAPI MprConfigServerDisconnect( HANDLE handle )
+{
+    struct config *c = handle;
+
+    TRACE( "%p\n", handle );
+
+    if (!valid_config( handle )) return;
+    EnterCriticalSection( &configs_cs );
+    list_remove( &c->entry );
+    LeaveCriticalSection( &configs_cs );
+    c->magic = 0;
+    HeapFree( GetProcessHeap(), 0, c );
+}
+
+DWORD WINAPI MprConfigServerRefresh( HANDLE handle )
+{
+    TRACE( "%p\n", handle );
+    return valid_config( handle ) ? ERROR_SUCCESS : ERROR_INVALID_HANDLE;
+}
+
+static DWORD config_enum( HANDLE handle, DWORD level, LPBYTE *buffer, DWORD *read, DWORD *total, DWORD *resume )
+{
+    if (!valid_config( handle )) return ERROR_INVALID_HANDLE;
+    if (!buffer || !read || !total) return ERROR_INVALID_PARAMETER;
+    if (level) return ERROR_INVALID_LEVEL;
+    /* no interfaces or transports are configured */
+    *buffer = NULL;
+    *read = 0;
+    *total = 0;
+    if (resume) *resume = 0;
+    return ERROR_SUCCESS;
+}
+
+DWORD WINAPI MprConfigInterfaceEnum( HANDLE handle, DWORD level, LPBYTE *buffer, DWORD max, DWORD *read, DWORD *total,
+                                     DWORD *resume )
+{
+    TRACE( "%p, %lu, %p, %lu, %p, %p, %p\n", handle, level, buffer, max, read, total, resume );
+    return config_enum( handle, level, buffer, read, total, resume );
+}
+
+DWORD WINAPI MprConfigTransportEnum( HANDLE handle, DWORD level, LPBYTE *buffer, DWORD max, DWORD *read, DWORD *total,
+                                     DWORD *resume )
+{
+    TRACE( "%p, %lu, %p, %lu, %p, %p, %p\n", handle, level, buffer, max, read, total, resume );
+    return config_enum( handle, level, buffer, read, total, resume );
+}
+
+DWORD WINAPI MprConfigInterfaceTransportEnum( HANDLE handle, HANDLE iface, DWORD level, LPBYTE *buffer, DWORD max,
+                                              DWORD *read, DWORD *total, DWORD *resume )
+{
+    TRACE( "%p, %p, %lu, %p, %lu, %p, %p, %p\n", handle, iface, level, buffer, max, read, total, resume );
+    if (!valid_config( handle )) return ERROR_INVALID_HANDLE;
+    return ERROR_INVALID_HANDLE;   /* no interface can exist */
+}
+
+DWORD WINAPI MprConfigInterfaceGetHandle( HANDLE handle, LPWSTR name, HANDLE *iface )
+{
+    TRACE( "%p, %s, %p\n", handle, debugstr_w(name), iface );
+    if (!valid_config( handle )) return ERROR_INVALID_HANDLE;
+    if (!name || !iface) return ERROR_INVALID_PARAMETER;
+    *iface = NULL;
+    return ERROR_NO_SUCH_INTERFACE;
+}
+
+DWORD WINAPI MprConfigTransportGetHandle( HANDLE handle, DWORD id, HANDLE *transport )
+{
+    TRACE( "%p, %lu, %p\n", handle, id, transport );
+    if (!valid_config( handle )) return ERROR_INVALID_HANDLE;
+    if (!transport) return ERROR_INVALID_PARAMETER;
+    *transport = NULL;
+    return ERROR_UNKNOWN_PROTOCOL_ID;
+}
