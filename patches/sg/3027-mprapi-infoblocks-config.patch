+
+static BOOL is_local_server( const WCHAR *name )
+{
+    WCHAR buf[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD len = ARRAY_SIZE(buf);
+
+    if (!name || !*name) return TRUE;
+    if (name[0] == '\\' && name[1] == '\\') name += 2;
+    if (!GetComputerNameW( buf, &len )) return FALSE;
+    return !wcsicmp( name, buf );
