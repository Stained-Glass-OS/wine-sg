+/* ---------------------------------------------------------------------- */
+/* Router information blocks: a header, a table of contents and the blocks
+ *
+ *   ULONG Version, Size, TocEntriesCount; {InfoType, InfoSize, Count, Offset}[]
+ *
+ * The offsets count from the start of the header; blocks start on 4 byte boundaries. */
+
+struct toc_entry { ULONG type, size, count, offset; };
+struct info_header { ULONG version, size, toc_count; struct toc_entry toc[1]; };
+
+#define HEADER_SIZE_EMPTY FIELD_OFFSET( struct info_header, toc )
+
+static DWORD info_alloc( ULONG toc_count, ULONG data_size, struct info_header **ret )
+{
+    ULONG size = HEADER_SIZE_EMPTY + toc_count * sizeof(struct toc_entry) + data_size;
+    struct info_header *h;
+
+    /* an empty header still has room for the first table entry, as the declared structure has */
+    if (size < sizeof(*h)) size = sizeof(*h);
+    if (!(h = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, size ))) return ERROR_NOT_ENOUGH_MEMORY;
+    h->size = size;
+    *ret = h;
+    return ERROR_SUCCESS;
+}
+
+static ULONG align4( ULONG v ) { return (v + 3) & ~3u; }
+
+DWORD WINAPI MprInfoCreate( DWORD version, LPVOID *new_header )
+{
+    struct info_header *h;
+    DWORD ret;
+
+    TRACE( "%lu, %p\n", version, new_header );
+
+    if (!new_header) return ERROR_INVALID_PARAMETER;
+    if (version != 1) return ERROR_INVALID_PARAMETER;
+    if ((ret = info_alloc( 0, 0, &h ))) return ret;
+    h->version = version;
+    h->toc_count = 0;
+    *new_header = h;
+    return ERROR_SUCCESS;
+}
+
+DWORD WINAPI MprInfoDelete( LPVOID header )
+{
+    TRACE( "%p\n", header );
+
+    if (!header) return ERROR_INVALID_PARAMETER;
+    HeapFree( GetProcessHeap(), 0, header );
+    return ERROR_SUCCESS;
+}
+
+static BOOL header_valid( const struct info_header *h )
+{
+    return h && h->size >= HEADER_SIZE_EMPTY + h->toc_count * sizeof(struct toc_entry);
+}
+
+DWORD WINAPI MprInfoRemoveAll( LPVOID header, LPVOID *new_header )
+{
+    struct info_header *h = header, *n;
+    DWORD ret;
+
+    TRACE( "%p, %p\n", header, new_header );
+
+    if (!header_valid( h ) || !new_header) return ERROR_INVALID_PARAMETER;
+    if ((ret = info_alloc( 0, 0, &n ))) return ret;
+    n->version = h->version;
+    *new_header = n;
+    return ERROR_SUCCESS;
+}
+
+DWORD WINAPI MprInfoDuplicate( LPVOID header, LPVOID *new_header )
 {
-    FIXME("server_name %s, hmprconfig %p stub.\n", debugstr_w(server_name), hmprconfig);
+    struct info_header *h = header;
+    void *copy;
 
-    *hmprconfig = NULL;
+    TRACE( "%p, %p\n", header, new_header );
 
-    return ERROR_NOT_SUPPORTED;
+    if (!header_valid( h ) || !new_header) return ERROR_INVALID_PARAMETER;
+    if (!(copy = HeapAlloc( GetProcessHeap(), 0, h->size ))) return ERROR_NOT_ENOUGH_MEMORY;
+    memcpy( copy, h, h->size );
+    *new_header = copy;
+    return ERROR_SUCCESS;
+}
+
+static struct toc_entry *find_toc( const struct info_header *h, ULONG type )
+{
+    ULONG i;
+    for (i = 0; i < h->toc_count; i++) if (h->toc[i].type == type) return (struct toc_entry *)&h->toc[i];
+    return NULL;
+}
+
+/* rebuild the header with the block of the given type replaced (data != NULL), added or removed (remove) */
+static DWORD info_rebuild( const struct info_header *h, ULONG type, BOOL remove, ULONG size, ULONG count, const BYTE *data,
+                           struct info_header **ret )
+{
+    ULONG i, n = 0, data_total = 0, toc_count = 0, offset;
+    const struct toc_entry *e;
+    struct info_header *out;
+    DWORD err;
+
+    for (i = 0; i < h->toc_count; i++)
+    {
+        if (h->toc[i].type == type) continue;
+        toc_count++;
+        data_total += align4( h->toc[i].size * h->toc[i].count );
+    }
+    if (!remove)
+    {
+        toc_count++;
+        data_total += align4( size * count );
+    }
+    if ((err = info_alloc( toc_count, data_total, &out ))) return err;
+    out->version = h->version;
+    out->toc_count = toc_count;
+    offset = HEADER_SIZE_EMPTY + toc_count * sizeof(struct toc_entry);
+    for (i = 0; i < h->toc_count; i++)
+    {
+        e = &h->toc[i];
+        if (e->type == type) continue;
+        out->toc[n] = *e;
+        out->toc[n].offset = offset;
+        if (e->offset < h->size) memcpy( (BYTE *)out + offset, (const BYTE *)h + e->offset, e->size * e->count );
+        offset += align4( e->size * e->count );
+        n++;
+    }
+    if (!remove)
+    {
+        out->toc[n].type = type;
+        out->toc[n].size = size;
+        out->toc[n].count = count;
+        out->toc[n].offset = offset;
+        if (size * count != 0) memcpy( (BYTE *)out + offset, data, size * count );
+        offset += align4( size * count );
+    }
+    if (offset > out->size) out->size = offset;
+    *ret = out;
+    return ERROR_SUCCESS;
+}
+
+DWORD WINAPI MprInfoBlockAdd( LPVOID header, DWORD type, DWORD size, DWORD count, LPBYTE data, LPVOID *new_header )
+{
+    struct info_header *h = header;
+
+    TRACE( "%p, %lu, %lu, %lu, %p, %p\n", header, type, size, count, data, new_header );
+
+    if (!header_valid( h ) || !new_header || (size * count != 0 && !data)) return ERROR_INVALID_PARAMETER;
+    if (find_toc( h, type )) return ERROR_ALREADY_EXISTS;
+    return info_rebuild( h, type, FALSE, size, count, data, (struct info_header **)new_header );
+}
+
+DWORD WINAPI MprInfoBlockRemove( LPVOID header, DWORD type, LPVOID *new_header )
+{
+    struct info_header *h = header;
+
+    TRACE( "%p, %lu, %p\n", header, type, new_header );
+
+    if (!header_valid( h ) || !new_header) return ERROR_INVALID_PARAMETER;
+    if (!find_toc( h, type )) return ERROR_NOT_FOUND;
+    return info_rebuild( h, type, TRUE, 0, 0, NULL, (struct info_header **)new_header );
+}
+
+DWORD WINAPI MprInfoBlockSet( LPVOID header, DWORD type, DWORD size, DWORD count, LPBYTE data, LPVOID *new_header )
+{
+    struct info_header *h = header;
+
+    TRACE( "%p, %lu, %lu, %lu, %p, %p\n", header, type, size, count, data, new_header );
+
+    if (!header_valid( h ) || !new_header || (size * count != 0 && !data)) return ERROR_INVALID_PARAMETER;
+    return info_rebuild( h, type, FALSE, size, count, data, (struct info_header **)new_header );
+}
+
+DWORD WINAPI MprInfoBlockFind( LPVOID header, DWORD type, LPDWORD size, LPDWORD count, LPBYTE *data )
+{
+    struct info_header *h = header;
+    const struct toc_entry *e;
+
+    TRACE( "%p, %lu, %p, %p, %p\n", header, type, size, count, data );
+
+    if (!header_valid( h )) return ERROR_INVALID_PARAMETER;
+    if (!(e = find_toc( h, type ))) return ERROR_NOT_FOUND;
+    if (size) *size = e->size;
+    if (count) *count = e->count;
+    if (data) *data = e->offset < h->size ? (BYTE *)h + e->offset : NULL;
+    return ERROR_SUCCESS;
+}
+
+DWORD WINAPI MprInfoBlockQuerySize( LPVOID header )
+{
+    struct info_header *h = header;
+
+    TRACE( "%p\n", header );
+    return header_valid( h ) ? h->size : 0;
+}
