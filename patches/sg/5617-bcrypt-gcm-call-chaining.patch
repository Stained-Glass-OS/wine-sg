From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: AES-GCM call chaining

bcrypt: AES-GCM call chaining

With BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG, BCryptEncrypt and BCryptDecrypt take a
message in pieces: the first call starts from the nonce and takes the
authenticated data, later calls carry on with the key's state, and the tag is
produced (or checked) by the call that clears the flag.
---
--- a/dlls/bcrypt/bcrypt_internal.h
+++ b/dlls/bcrypt/bcrypt_internal.h
@@ -171,6 +171,7 @@ struct key_symmetric
     ULONG            vector_len;
     UCHAR           *secret;
     unsigned         secret_len;
+    BOOL             chain_in_progress; /* an authenticated mode call chain is open */
     CRITICAL_SECTION cs;
 };
 
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -1607,16 +1607,21 @@ static NTSTATUS key_symmetric_encrypt( struct key *key,  UCHAR *input, ULONG inp
     if (key->u.s.mode == CHAIN_MODE_GCM)
     {
         BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO *auth_info = padding;
+        BOOL chain, continuing;
 
         if (!auth_info) return STATUS_INVALID_PARAMETER;
         if (!auth_info->pbNonce) return STATUS_INVALID_PARAMETER;
         if (!auth_info->pbTag) return STATUS_INVALID_PARAMETER;
         if (auth_info->cbTag < 12 || auth_info->cbTag > 16) return STATUS_INVALID_PARAMETER;
-        if (auth_info->dwFlags & BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG)
-            FIXME( "call chaining not implemented\n" );
+        chain = auth_info->dwFlags & BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG;
+        continuing = auth_info->dwFlags & BCRYPT_AUTH_MODE_IN_PROGRESS_FLAG;
 
-        if ((status = key_symmetric_set_vector( key, auth_info->pbNonce, auth_info->cbNonce, TRUE )))
-            return status;
+#ifdef SG_MUTANT_BCRYPT_GCM_NOCHAIN
+        chain = continuing = FALSE;
+#endif
+        /* the cipher takes whole blocks until the last call */
+        if (chain && (input_len & 15)) return STATUS_INVALID_BUFFER_SIZE;
+        if (continuing && !key->u.s.chain_in_progress) return STATUS_INVALID_PARAMETER;
 
         *ret_len = input_len;
         if (flags & BCRYPT_BLOCK_PADDING)
@@ -1627,13 +1632,24 @@ static NTSTATUS key_symmetric_encrypt( struct key *key,  UCHAR *input, ULONG inp
 #endif
             return STATUS_INVALID_PARAMETER;
         }
+
+        /* the first call of a chain, or a call on its own, starts from the nonce and takes the
+         * authenticated data; the later calls only carry on with the key's state */
+        if (!continuing)
+        {
+            if ((status = key_symmetric_set_vector( key, auth_info->pbNonce, auth_info->cbNonce, TRUE )))
+                return status;
+        }
         if (input && !output) return STATUS_SUCCESS;
         if (output_len < *ret_len) return STATUS_BUFFER_TOO_SMALL;
 
-        auth_params.key = key;
-        auth_params.auth_data = auth_info->pbAuthData;
-        auth_params.len = auth_info->cbAuthData;
-        if ((status = UNIX_CALL( key_symmetric_set_auth_data, &auth_params ))) return status;
+        if (!continuing)
+        {
+            auth_params.key = key;
+            auth_params.auth_data = auth_info->pbAuthData;
+            auth_params.len = auth_info->cbAuthData;
+            if ((status = UNIX_CALL( key_symmetric_set_auth_data, &auth_params ))) return status;
+        }
 
         encrypt_params.key = key;
         encrypt_params.input = input;
@@ -1642,6 +1658,23 @@ static NTSTATUS key_symmetric_encrypt( struct key *key,  UCHAR *input, ULONG inp
         encrypt_params.output_len = output_len;
         if ((status = UNIX_CALL( key_symmetric_encrypt, &encrypt_params ))) return status;
 
+        if (chain)
+        {
+            if (!continuing) auth_info->cbAAD = 0;
+            auth_info->cbAAD += continuing ? 0 : auth_info->cbAuthData;
+            auth_info->cbData += input_len;
+            auth_info->dwFlags |= BCRYPT_AUTH_MODE_IN_PROGRESS_FLAG;
+            key->u.s.chain_in_progress = TRUE;
+            return STATUS_SUCCESS;
+        }
+        if (continuing)
+        {
+            key->u.s.chain_in_progress = FALSE;
+            auth_info->dwFlags &= ~BCRYPT_AUTH_MODE_IN_PROGRESS_FLAG;
+            auth_info->cbAAD = 0;
+            auth_info->cbData = 0;
+        }
+
         tag_params.key = key;
         tag_params.tag = auth_info->pbTag;
         tag_params.len = auth_info->cbTag;
@@ -1719,6 +1752,7 @@ static NTSTATUS key_symmetric_decrypt( struct key *key, UCHAR *input, ULONG inpu
     if (key->u.s.mode == CHAIN_MODE_GCM)
     {
         BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO *auth_info = padding;
+        BOOL chain, continuing;
         UCHAR tag[16];
 
         if (!auth_info) return STATUS_INVALID_PARAMETER;
@@ -1726,7 +1760,18 @@ static NTSTATUS key_symmetric_decrypt( struct key *key, UCHAR *input, ULONG inpu
         if (!auth_info->pbTag) return STATUS_INVALID_PARAMETER;
         if (auth_info->cbTag < 12 || auth_info->cbTag > 16) return STATUS_INVALID_PARAMETER;
 
-        if ((status = key_symmetric_set_vector( key, auth_info->pbNonce, auth_info->cbNonce, TRUE )))
+        chain = auth_info->dwFlags & BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG;
+        continuing = auth_info->dwFlags & BCRYPT_AUTH_MODE_IN_PROGRESS_FLAG;
+
+#ifdef SG_MUTANT_BCRYPT_GCM_NOCHAIN
+        chain = continuing = FALSE;
+#endif
+        /* the cipher takes whole blocks until the last call */
+        if (chain && (input_len & 15)) return STATUS_INVALID_BUFFER_SIZE;
+        if (continuing && !key->u.s.chain_in_progress) return STATUS_INVALID_PARAMETER;
+
+        if (!continuing &&
+            (status = key_symmetric_set_vector( key, auth_info->pbNonce, auth_info->cbNonce, TRUE )))
             return status;
 
         *ret_len = input_len;
@@ -1734,10 +1779,13 @@ static NTSTATUS key_symmetric_decrypt( struct key *key, UCHAR *input, ULONG inpu
         if (!output) return STATUS_SUCCESS;
         if (output_len < *ret_len) return STATUS_BUFFER_TOO_SMALL;
 
-        auth_params.key = key;
-        auth_params.auth_data = auth_info->pbAuthData;
-        auth_params.len = auth_info->cbAuthData;
-        if ((status = UNIX_CALL( key_symmetric_set_auth_data, &auth_params ))) return status;
+        if (!continuing)
+        {
+            auth_params.key = key;
+            auth_params.auth_data = auth_info->pbAuthData;
+            auth_params.len = auth_info->cbAuthData;
+            if ((status = UNIX_CALL( key_symmetric_set_auth_data, &auth_params ))) return status;
+        }
 
         decrypt_params.key = key;
         decrypt_params.input = input;
@@ -1746,6 +1794,23 @@ static NTSTATUS key_symmetric_decrypt( struct key *key, UCHAR *input, ULONG inpu
         decrypt_params.output_len = output_len;
         if ((status = UNIX_CALL( key_symmetric_decrypt, &decrypt_params ))) return status;
 
+        if (chain)
+        {
+            if (!continuing) auth_info->cbAAD = 0;
+            auth_info->cbAAD += continuing ? 0 : auth_info->cbAuthData;
+            auth_info->cbData += input_len;
+            auth_info->dwFlags |= BCRYPT_AUTH_MODE_IN_PROGRESS_FLAG;
+            key->u.s.chain_in_progress = TRUE;
+            return STATUS_SUCCESS;
+        }
+        if (continuing)
+        {
+            key->u.s.chain_in_progress = FALSE;
+            auth_info->dwFlags &= ~BCRYPT_AUTH_MODE_IN_PROGRESS_FLAG;
+            auth_info->cbAAD = 0;
+            auth_info->cbData = 0;
+        }
+
         tag_params.key = key;
         tag_params.tag = tag;
         tag_params.len = sizeof(tag);
--- a/dlls/bcrypt/tests/bcrypt.c
+++ b/dlls/bcrypt/tests/bcrypt.c
@@ -1323,6 +1323,105 @@ static void test_BCryptEncrypt(void)
     for (i = 0; i < 16; i++)
         ok(tag[i] == expected_tag[i], "%lu: %02x != %02x\n", i, tag[i], expected_tag[i]);
 
+    /* call chaining: the tag comes with the last call, the state is kept between them */
+    {
+        static const ULONG chunks[] = { 16, 16, 16 };
+        static UCHAR aad[] = { 1, 2, 3, 4, 5 };
+        UCHAR chained[48], whole[48], whole_tag[16], mac_context[16], data48[48];
+        ULONG offset = 0, n;
+
+        memcpy(data48, data2, 32);
+        memcpy(data48 + 32, data2, 16);
+
+        /* with authenticated data, as one call */
+        auth_info.pbAuthData = aad;
+        auth_info.cbAuthData = sizeof(aad);
+        memset(whole, 0, sizeof(whole));
+        memset(whole_tag, 0, sizeof(whole_tag));
+        auth_info.pbTag = whole_tag;
+        ret = BCryptEncrypt(key, data48, 48, &auth_info, NULL, 0, whole, 48, &size, 0);
+        ok(ret == STATUS_SUCCESS, "got %#lx\n", ret);
+        auth_info.pbTag = tag;
+        auth_info.pbAuthData = NULL;
+        auth_info.cbAuthData = 0;
+
+        for (n = 0; n < ARRAY_SIZE(chunks); n++)
+        {
+            memset(tag, 0xff, sizeof(tag));
+            auth_info.pbMacContext = mac_context;
+            auth_info.cbMacContext = sizeof(mac_context);
+            if (!n)
+            {
+                auth_info.pbAuthData = aad;
+                auth_info.cbAuthData = sizeof(aad);
+                auth_info.dwFlags = BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG;
+            }
+            else
+            {
+                auth_info.pbAuthData = NULL;
+                auth_info.cbAuthData = 0;
+                ok(auth_info.dwFlags & BCRYPT_AUTH_MODE_IN_PROGRESS_FLAG, "%lu: got flags %#lx\n", n, auth_info.dwFlags);
+                if (n == ARRAY_SIZE(chunks) - 1) auth_info.dwFlags &= ~BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG;
+            }
+            ret = BCryptEncrypt(key, data48 + offset, chunks[n], &auth_info, NULL, 0, chained + offset, chunks[n], &size, 0);
+            ok(ret == STATUS_SUCCESS, "%lu: got %#lx\n", n, ret);
+            ok(size == chunks[n], "%lu: got %lu\n", n, size);
+            if (n < ARRAY_SIZE(chunks) - 1)
+            {
+                ok(auth_info.dwFlags == (BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG | BCRYPT_AUTH_MODE_IN_PROGRESS_FLAG),
+                        "%lu: got flags %#lx\n", n, auth_info.dwFlags);
+                ok(auth_info.cbAAD == sizeof(aad), "%lu: got cbAAD %lu\n", n, auth_info.cbAAD);
+                ok(auth_info.cbData == offset + chunks[n], "%lu: got cbData %I64u\n", n, auth_info.cbData);
+                ok(tag[0] == 0xff, "%lu: the tag was written before the last call\n", n);
+            }
+            offset += chunks[n];
+        }
+        ok(!(auth_info.dwFlags & (BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG | BCRYPT_AUTH_MODE_IN_PROGRESS_FLAG)),
+                "got flags %#lx\n", auth_info.dwFlags);
+        ok(!memcmp(chained, whole, 48), "the chained ciphertext differs\n");
+        ok(!memcmp(tag, whole_tag, 16), "the chained tag differs\n");
+
+        /* decrypting in chunks checks the tag on the last call */
+        offset = 0;
+        for (n = 0; n < ARRAY_SIZE(chunks); n++)
+        {
+            UCHAR plain[48];
+
+            auth_info.pbMacContext = mac_context;
+            auth_info.cbMacContext = sizeof(mac_context);
+            auth_info.pbAuthData = n ? NULL : aad;
+            auth_info.cbAuthData = n ? 0 : sizeof(aad);
+            if (!n) auth_info.dwFlags = BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG;
+            if (n == ARRAY_SIZE(chunks) - 1) auth_info.dwFlags &= ~BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG;
+            memcpy(tag, whole_tag, 16);
+            if (n == ARRAY_SIZE(chunks) - 1) tag[3] ^= 1;
+            ret = BCryptDecrypt(key, whole + offset, chunks[n], &auth_info, NULL, 0, plain + offset, chunks[n], &size, 0);
+            if (n < ARRAY_SIZE(chunks) - 1)
+                ok(ret == STATUS_SUCCESS, "%lu: got %#lx\n", n, ret);
+            else
+                ok(ret == STATUS_AUTH_TAG_MISMATCH, "%lu: got %#lx\n", n, ret);
+            offset += chunks[n];
+        }
+        memset(&auth_info.dwFlags, 0, sizeof(auth_info.dwFlags));
+        auth_info.pbMacContext = NULL;
+        auth_info.cbMacContext = 0;
+        auth_info.cbAAD = 0;
+        auth_info.cbData = 0;
+
+        /* an intermediate chunk is whole blocks */
+        auth_info.dwFlags = BCRYPT_AUTH_MODE_CHAIN_CALLS_FLAG;
+        ret = BCryptEncrypt(key, data48, 10, &auth_info, NULL, 0, chained, 10, &size, 0);
+        ok(ret == STATUS_INVALID_BUFFER_SIZE, "got %#lx\n", ret);
+        auth_info.dwFlags = 0;
+
+        /* a call that says it carries on, with nothing to carry on */
+        auth_info.dwFlags = BCRYPT_AUTH_MODE_IN_PROGRESS_FLAG;
+        ret = BCryptEncrypt(key, data2, 16, &auth_info, NULL, 0, chained, 16, &size, 0);
+        ok(ret == STATUS_INVALID_PARAMETER, "got %#lx\n", ret);
+        auth_info.dwFlags = 0;
+        auth_info.pbTag = tag;
+    }
+
     /* all zero initialization vector */
     size = 0;
     memset(ciphertext, 0xff, sizeof(ciphertext));
