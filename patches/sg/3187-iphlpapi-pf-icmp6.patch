+/***********************************************************************
+ *    Icmp6ParseReplies (IPHLPAPI.@)
+ *
+ * The reply is an ICMPV6_ECHO_REPLY: the sender's IPV6_ADDRESS_EX (26 bytes), the status
+ * and the round trip time. A request nobody answered has no sender.
+ */
+DWORD WINAPI Icmp6ParseReplies( void *reply, DWORD reply_size )
+{
+    BYTE *r = reply;
+    DWORD status, k;
+
+    if (!r || reply_size < ICMP6_REPLY_SIZE) return 0;
+#ifdef SG_MUTANT_ICMP6_NOPARSE
+    return 0;
+#endif
+    memcpy( &status, r + 28, sizeof(status) );
+    for (k = 0; k < 26; k++) if (r[k]) return 1;
+    SetLastError( status );
+    return 0;
 }
 
