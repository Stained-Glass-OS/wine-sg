+/* The old IP filter driver's API. Microsoft's documentation of every one of
+ * these functions says that they were made for Windows 2000 and Windows
+ * Server 2003 and that from Windows Vista on (it says "Longhorn") they return
+ * ERROR_CALL_NOT_SUPPORTED (Win32 has no such constant; the code is 120,
+ * ERROR_CALL_NOT_IMPLEMENTED, "not supported on this system"), pointing to the Windows Filtering Platform and
+ * MprConfigInterfaceTransportSetInfo instead. Windows 10 and 11 do exactly
+ * that, so this does too: nothing is created, enforced or kept, and no firewall
+ * rule is touched. The only check made before the error is the one the
+ * documentation lists for PfAddFiltersToInterface: PFERROR_NO_FILTERS_GIVEN
+ * when neither input nor output filters are given. */
+
+#include <stdarg.h>
+#define IPHLPAPI_DLL_LINKAGE
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "winsock2.h"
+#include "iphlpapi.h"
+#include "fltdefs.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(iphlpapi);
+
+#define PF_UNSUPPORTED ERROR_CALL_NOT_IMPLEMENTED
+
+DWORD WINAPI PfCreateInterface( DWORD name, PFFORWARD_ACTION in_action, PFFORWARD_ACTION out_action,
+                                BOOL use_log, BOOL must_be_unique, INTERFACE_HANDLE *handle )
+{
+    TRACE( "(%ld, %d, %d, %d, %d, %p): not supported\n", name, in_action, out_action, use_log, must_be_unique, handle );
+#ifdef SG_MUTANT_PF_SUCCEED
+    if (handle) *handle = (INTERFACE_HANDLE)1;
+    return NO_ERROR;
+#endif
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfDeleteInterface( INTERFACE_HANDLE handle )
+{
+    TRACE( "(%p): not supported\n", handle );
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfBindInterfaceToIPAddress( INTERFACE_HANDLE handle, PFADDRESSTYPE type, PBYTE ip )
+{
+    TRACE( "(%p, %d, %p): not supported\n", handle, type, ip );
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfBindInterfaceToIndex( INTERFACE_HANDLE handle, DWORD index, PFADDRESSTYPE type, PBYTE link_ip )
+{
+    TRACE( "(%p, %ld, %d, %p): not supported\n", handle, index, type, link_ip );
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfUnBindInterface( INTERFACE_HANDLE handle )
+{
+    TRACE( "(%p): not supported\n", handle );
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfAddFiltersToInterface( INTERFACE_HANDLE handle, DWORD in_count, PPF_FILTER_DESCRIPTOR in,
+                                      DWORD out_count, PPF_FILTER_DESCRIPTOR out, PFILTER_HANDLE handles )
+{
+    TRACE( "(%p, %ld, %p, %ld, %p, %p): not supported\n", handle, in_count, in, out_count, out, handles );
+#ifndef SG_MUTANT_PF_NOCHECK
+    if (!in_count && !out_count) return PFERROR_NO_FILTERS_GIVEN;
+#endif
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfRemoveFiltersFromInterface( INTERFACE_HANDLE handle, DWORD in_count, PPF_FILTER_DESCRIPTOR in,
+                                           DWORD out_count, PPF_FILTER_DESCRIPTOR out )
+{
+    TRACE( "(%p, %ld, %p, %ld, %p): not supported\n", handle, in_count, in, out_count, out );
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfRemoveFilterHandles( INTERFACE_HANDLE handle, DWORD count, PFILTER_HANDLE handles )
+{
+    TRACE( "(%p, %ld, %p): not supported\n", handle, count, handles );
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfRebindFilters( INTERFACE_HANDLE handle, PPF_LATEBIND_INFO info )
+{
+    TRACE( "(%p, %p): not supported\n", handle, info );
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfAddGlobalFilterToInterface( INTERFACE_HANDLE handle, GLOBAL_FILTER filter )
+{
+    TRACE( "(%p, %d): not supported\n", handle, filter );
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfRemoveGlobalFilterFromInterface( INTERFACE_HANDLE handle, GLOBAL_FILTER filter )
+{
+    TRACE( "(%p, %d): not supported\n", handle, filter );
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfGetInterfaceStatistics( INTERFACE_HANDLE handle, PPF_INTERFACE_STATS stats, PDWORD size, BOOL reset )
+{
+    TRACE( "(%p, %p, %p, %d): not supported\n", handle, stats, size, reset );
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfTestPacket( INTERFACE_HANDLE in_handle, INTERFACE_HANDLE out_handle, DWORD len, PBYTE pkt,
+                           PPFFORWARD_ACTION action )
+{
+    TRACE( "(%p, %p, %ld, %p, %p): not supported\n", in_handle, out_handle, len, pkt, action );
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfMakeLog( HANDLE event )
+{
+    TRACE( "(%p): not supported\n", event );
+#ifdef SG_MUTANT_PF_LOG
+    return ERROR_ACCESS_DENIED;
+#endif
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfSetLogBuffer( PBYTE buffer, DWORD size, DWORD threshold, DWORD entries, PDWORD logged, PDWORD lost,
+                             PDWORD used )
+{
+    TRACE( "(%p, %ld, %ld, %ld, %p, %p, %p): not supported\n", buffer, size, threshold, entries, logged, lost, used );
+    return PF_UNSUPPORTED;
+}
+
+DWORD WINAPI PfDeleteLog(void)
+{
+    TRACE( "(): not supported\n" );
+    return PF_UNSUPPORTED;
+}
