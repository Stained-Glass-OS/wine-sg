diff --git a/dlls/nsiproxy.sys/icmp_echo.c b/dlls/nsiproxy.sys/icmp_echo.c
index e92fa43..5b59093 100644
--- a/dlls/nsiproxy.sys/icmp_echo.c
+++ b/dlls/nsiproxy.sys/icmp_echo.c
@@ -508,6 +508,164 @@ static const struct family_ops ipv4_linux_ping =
 };
 #endif
 
+#ifdef __linux__
+/* ICMPv6: the reply is an ICMPV6_ECHO_REPLY -- the sender as an IPV6_ADDRESS_EX (port, flow info,
+ * eight network-order words, scope id: 26 bytes packed), the status at 28, the round trip time at
+ * 32, 36 bytes -- and the echoed data after it.  The kernel makes the checksum and neither raw nor
+ * ping sockets carry the IP header. */
+#define V6_REPLY_SIZE 36
+#define V6_ST_ECHO_REQUEST 128
+#define V6_ST_ECHO_REPLY   129
+
+static void ipv6_init_icmp_hdr( struct icmp_data *data, struct icmp_hdr *icmp_hdr )
+{
+    icmp_hdr->type = V6_ST_ECHO_REQUEST;
+    icmp_hdr->code = 0;
+    icmp_hdr->checksum = 0;
+    icmp_hdr->un.echo.id = data->id = getpid() & 0xffff; /* the kernel's for ping sockets */
+    icmp_hdr->un.echo.sequence = data->seq = InterlockedIncrement( &icmp_sequence ) & 0xffff;
+}
+
+static int ipv6_set_reply_ip_status( IP_STATUS ip_status, unsigned int bits, void *out )
+{
+    memset( out, 0, V6_REPLY_SIZE );
+    memcpy( (BYTE *)out + 28, &ip_status, sizeof(ip_status) );
+    return V6_REPLY_SIZE;
+}
+
+static void ipv6_set_socket_opts( struct icmp_data *data, struct icmp_send_echo_params *params )
+{
+    static const int on = 1;
+    int val = params->ttl;
+
+    if (val) setsockopt( data->socket, IPPROTO_IPV6, IPV6_UNICAST_HOPS, &val, sizeof(val) );
+    setsockopt( data->socket, IPPROTO_IPV6, IPV6_RECVHOPLIMIT, &on, sizeof(on) );
+}
+
+static int ipv6_reply_buffer_len( struct icmp_listen_params *params )
+{
+    /* room for an error's original IPv6 header and request as well as the echoed data */
+    return 8 + 40 + 8 + 8 + (params->reply_len > V6_REPLY_SIZE ? params->reply_len - V6_REPLY_SIZE : 0);
+}
+
+static BOOL ipv6_parse_ip_hdr( struct msghdr *msg, int recvd, int *ip_hdr_len, struct icmp_reply_ctx *ctx )
+{
+    struct cmsghdr *cmsg;
+
+    *ip_hdr_len = 0;
+    ctx->options_data = NULL;
+    ctx->ttl = 0;
+    ctx->tos = 0;
+    ctx->flags = 0;
+    ctx->options_size = 0;
+    for (cmsg = CMSG_FIRSTHDR( msg ); cmsg; cmsg = CMSG_NXTHDR( msg, cmsg ))
+        if (cmsg->cmsg_level == IPPROTO_IPV6 && cmsg->cmsg_type == IPV6_HOPLIMIT)
+            ctx->ttl = *(int *)CMSG_DATA( cmsg );
+    return TRUE;
+}
+
+static int ipv6_parse_icmp_hdr_( struct icmp_data *data, struct icmp_hdr *icmp, int icmp_size,
+                                 struct icmp_reply_ctx *ctx, int ping_socket )
+{
+    const struct icmp_hdr *orig_icmp;
+    const BYTE *orig_ip6;
+    IP_STATUS status;
+
+    switch (icmp->type)
+    {
+    case V6_ST_ECHO_REPLY:
+        if ((!ping_socket && icmp->un.echo.id != data->id) || icmp->un.echo.sequence != data->seq) return -1;
+        ctx->status = IP_SUCCESS;
+        return icmp_size - sizeof(*icmp);
+
+    case 1:   /* destination unreachable */
+        switch (icmp->code)
+        {
