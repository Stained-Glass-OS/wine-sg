 /***********************************************************************
  *    Icmp6CreateFile (IPHLPAPI.@)
  */
 HANDLE WINAPI Icmp6CreateFile( void )
 {
-    FIXME( "stub\n" );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return INVALID_HANDLE_VALUE;
