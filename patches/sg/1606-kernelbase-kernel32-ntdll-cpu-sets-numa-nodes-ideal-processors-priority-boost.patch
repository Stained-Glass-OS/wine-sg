 /***********************************************************************
  *           SetThreadSelectedCpuSets   (kernelbase.@)
  */
+/* CPU sets. A selection is kept by the process (GetThreadSelectedCpuSets
+ * and GetProcessDefaultCpuSets read it back) and applied as the affinity:
+ * games (Unreal Engine, id Tech) put their threads on CPU sets. Selections
+ * of other processes' threads apply but are not read back. */
+struct cpu_set_selection
+{
+    struct list entry;
+    DWORD       tid;
+    ULONG       count;
+    ULONG       ids[64];
+};
+
+static struct list thread_cpu_sets = LIST_INIT( thread_cpu_sets );
+static ULONG process_cpu_set_count, process_cpu_set_ids[64];
+static CRITICAL_SECTION cpu_set_cs;
+static CRITICAL_SECTION_DEBUG cpu_set_cs_debug =
+{
+    0, 0, &cpu_set_cs,
+    { &cpu_set_cs_debug.ProcessLocksList, &cpu_set_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": cpu_set_cs") }
+};
+static CRITICAL_SECTION cpu_set_cs = { &cpu_set_cs_debug, -1, 0, 0, 0, 0 };
+
+/* the affinity of a list of CPU set ids; FALSE for an unknown id */
+static BOOL cpu_sets_to_mask( const ULONG *ids, ULONG count, KAFFINITY *mask )
+{
+    SYSTEM_CPU_SET_INFORMATION *info, *entry;
+    ULONG len = 0, i, offset;
+    HANDLE process = GetCurrentProcess();
+    BOOL found;
+
+    *mask = 0;
+    NtQuerySystemInformationEx( SystemCpuSetInformation, &process, sizeof(process), NULL, 0, &len );
+    if (!len || !(info = HeapAlloc( GetProcessHeap(), 0, len ))) return FALSE;
+    if (NtQuerySystemInformationEx( SystemCpuSetInformation, &process, sizeof(process), info, len, &len ))
+    {
+        HeapFree( GetProcessHeap(), 0, info );
+        return FALSE;
+    }
+    for (i = 0; i < count; i++)
+    {
+        found = FALSE;
+        for (offset = 0; offset < len; offset += entry->Size)
+        {
+            entry = (SYSTEM_CPU_SET_INFORMATION *)((char *)info + offset);
+            if (!entry->Size) break;
+            if (entry->Type != CpuSetInformation || entry->CpuSet.Id != ids[i]) continue;
+            *mask |= (KAFFINITY)1 << entry->CpuSet.LogicalProcessorIndex;
+            found = TRUE;
+            break;
+        }
+        if (!found)
+        {
+            HeapFree( GetProcessHeap(), 0, info );
+            return FALSE;
+        }
+    }
+    HeapFree( GetProcessHeap(), 0, info );
+    return TRUE;
+}
+
+static BOOL get_cpu_set_ids( const ULONG *src, ULONG src_count, ULONG *ids, ULONG count, ULONG *required )
+{
+    *required = src_count;
+    if (count < src_count)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    if (src_count) memcpy( ids, src, src_count * sizeof(*ids) );
+    return TRUE;
+}
+
+/* the affinity calls are kernel32's */
+static BOOL get_affinity( HANDLE process, KAFFINITY *process_mask, KAFFINITY *system_mask )
+{
+    SYSTEM_BASIC_INFORMATION info;
+
+    if (!set_ntstatus( NtQueryInformationProcess( process, ProcessAffinityMask, process_mask,
+                                                  sizeof(*process_mask), NULL ))) return FALSE;
+    if (!set_ntstatus( NtQuerySystemInformation( SystemBasicInformation, &info, sizeof(info), NULL ))) return FALSE;
+    *system_mask = info.ActiveProcessorsAffinityMask;
+    return TRUE;
+}
+
+static DWORD thread_id_of( HANDLE thread )
+{
+    THREAD_BASIC_INFORMATION tbi;
+
+    if (NtQueryInformationThread( thread, ThreadBasicInformation, &tbi, sizeof(tbi), NULL )) return 0;
+    if (HandleToULong( tbi.ClientId.UniqueProcess ) != GetCurrentProcessId()) return 0;
+    return HandleToULong( tbi.ClientId.UniqueThread );
+}
+
 BOOL WINAPI SetThreadSelectedCpuSets(HANDLE thread, const ULONG *cpu_set_ids, ULONG count)
 {
+#ifndef SG_MUTANT_NO_CPU_SETS
+    struct cpu_set_selection *sel, *found = NULL;
+    KAFFINITY mask, process_mask, system_mask;
+    DWORD tid;
+
+    TRACE( "thread %p, cpu_set_ids %p, count %lu\n", thread, cpu_set_ids, count );
+
+    if (count > ARRAY_SIZE(found->ids) || (count && !cpu_sets_to_mask( cpu_set_ids, count, &mask )))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!count)
+    {
+        /* back to the process's default */
+        if (!process_cpu_set_count || !cpu_sets_to_mask( process_cpu_set_ids, process_cpu_set_count, &mask ))
+        {
+            if (!get_affinity( GetCurrentProcess(), &process_mask, &system_mask )) return FALSE;
+            mask = process_mask;
+        }
+    }
+    if (!set_ntstatus( NtSetInformationThread( thread, ThreadAffinityMask, &mask, sizeof(mask) ))) return FALSE;
+
+    if (!(tid = thread_id_of( thread ))) return TRUE;
+    RtlEnterCriticalSection( &cpu_set_cs );
+    LIST_FOR_EACH_ENTRY( sel, &thread_cpu_sets, struct cpu_set_selection, entry )
+        if (sel->tid == tid) { found = sel; break; }
+    if (!count)
+    {
+        if (found)
+        {
+            list_remove( &found->entry );
+            HeapFree( GetProcessHeap(), 0, found );
+        }
+    }
+    else
+    {
+        if (!found && (found = HeapAlloc( GetProcessHeap(), 0, sizeof(*found) )))
+        {
+            found->tid = tid;
+            list_add_tail( &thread_cpu_sets, &found->entry );
+        }
+        if (found)
+        {
+            found->count = count;
+            memcpy( found->ids, cpu_set_ids, count * sizeof(*cpu_set_ids) );
+        }
+    }
+    RtlLeaveCriticalSection( &cpu_set_cs );
+    return TRUE;
+#else
     FIXME( "thread %p, cpu_set_ids %p, count %lu stub.\n", thread, cpu_set_ids, count );
 
     return TRUE;
+#endif
+}
+
+
+/***********************************************************************
+ *           GetThreadSelectedCpuSets   (kernelbase.@)
+ */
+BOOL WINAPI GetThreadSelectedCpuSets(HANDLE thread, ULONG *cpu_set_ids, ULONG count, ULONG *required)
+{
+    struct cpu_set_selection *sel;
+    DWORD tid;
+    BOOL ret = TRUE;
+
+    TRACE( "thread %p, cpu_set_ids %p, count %lu, required %p\n", thread, cpu_set_ids, count, required );
+
+    if (!required)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *required = 0;
+    if (!(tid = thread_id_of( thread ))) return TRUE;
+    RtlEnterCriticalSection( &cpu_set_cs );
+    LIST_FOR_EACH_ENTRY( sel, &thread_cpu_sets, struct cpu_set_selection, entry )
+        if (sel->tid == tid)
+        {
+            ret = get_cpu_set_ids( sel->ids, sel->count, cpu_set_ids, count, required );
+            break;
+        }
+    RtlLeaveCriticalSection( &cpu_set_cs );
+    return ret;
 }
 
 
