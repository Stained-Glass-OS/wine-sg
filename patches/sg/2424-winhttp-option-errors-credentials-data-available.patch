From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winhttp: option errors per handle kind, request credentials, data before a response (todo_wine removed)

Nine todo_wine checks in winhttp's tests record what Windows does; they pass
now and the marks are gone.

- A number that is no option is ERROR_WINHTTP_INVALID_OPTION to set and
  ERROR_INVALID_PARAMETER to query, on any handle. An option that exists but
  not for this kind of handle is ERROR_WINHTTP_INCORRECT_HANDLE_TYPE: setting
  it on a connection, a request or a session, querying it on a connection
  (querying one on a request or a session stays ERROR_INVALID_PARAMETER).
- WINHTTP_OPTION_USERNAME and _PASSWORD belong to the request, not to the
  connection it was opened on; WinHttpSetCredentials does not touch them.
- WinHttpQueryDataAvailable on a request that has no response yet is
  ERROR_WINHTTP_INCORRECT_HANDLE_STATE and leaves the count alone.
---
--- a/dlls/winhttp/request.c
+++ b/dlls/winhttp/request.c
@@ -1141,8 +1141,8 @@ static BOOL do_authorization( struct request *request, DWORD target, DWORD schem
         else
         {
             if (!has_auth_value) return FALSE;
-            username = request->connect->username;
-            password = request->connect->password;
+            username = request->username;
+            password = request->password;
         }
         break;
 
@@ -3109,6 +3109,14 @@ static DWORD query_data_available( struct request *request, DWORD *available, BO
 {
     DWORD ret = ERROR_SUCCESS, count = 0;
 
+    /* the request has not been sent, or its answer not received */
+#ifndef SG_MUTANT_WH_AVAIL
+    if (request->read_reply_status == ERROR_WINHTTP_INCORRECT_HANDLE_STATE)
+    {
+        ret = ERROR_WINHTTP_INCORRECT_HANDLE_STATE;
+        goto done;
+    }
+#endif
     if (end_of_read_data( request )) goto done;
 
     if (!(count = query_data_ready( request )))
--- a/dlls/winhttp/session.c
+++ b/dlls/winhttp/session.c
@@ -95,6 +95,35 @@ static BOOL validate_buffer( void *buffer, DWORD *buflen, DWORD required )
     return TRUE;
 }
 
+/* Option numbers that exist. An option no handle of this kind takes is
+ * ERROR_WINHTTP_INCORRECT_HANDLE_TYPE; a number that is no option at all is
+ * ERROR_WINHTTP_INVALID_OPTION to set and ERROR_INVALID_PARAMETER to query. */
+static BOOL is_known_option( DWORD option )
+{
+    static const struct { DWORD first, last; } ranges[] =
+    {
+        { 1, 7 }, { 9, 9 }, { 12, 13 }, { 21, 21 }, { 24, 24 }, { 31, 32 }, { 34, 34 }, { 36, 36 }, { 38, 39 },
+        { 41, 41 }, { 45, 45 }, { 47, 47 }, { 58, 59 }, { 63, 63 }, { 68, 68 }, { 73, 74 }, { 77, 94 }, { 96, 101 },
+        { 103, 104 }, { 106, 108 }, { 110, 111 }, { 114, 116 }, { 118, 118 }, { 122, 123 }, { 128, 128 },
+        { 131, 131 }, { 133, 134 }, { 136, 136 }, { 138, 147 },
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(ranges); i++)
+        if (option >= ranges[i].first && option <= ranges[i].last) return TRUE;
+    return FALSE;
+}
+
+static void set_option_error( DWORD option, BOOL set )
+{
+#ifdef SG_MUTANT_WH_OPTERR
+    SetLastError( set ? ERROR_WINHTTP_INVALID_OPTION : ERROR_INVALID_PARAMETER );
+    return;
+#endif
+    if (is_known_option( option )) SetLastError( ERROR_WINHTTP_INCORRECT_HANDLE_TYPE );
+    else SetLastError( set ? ERROR_WINHTTP_INVALID_OPTION : ERROR_INVALID_PARAMETER );
+}
+
 static BOOL session_query_option( struct object_header *hdr, DWORD option, void *buffer, DWORD *buflen )
 {
     struct session *session = (struct session *)hdr;
@@ -281,7 +310,7 @@ static BOOL session_set_option( struct object_header *hdr, DWORD option, void *b
 
     default:
         FIXME( "unimplemented option %lu\n", option );
-        SetLastError( ERROR_WINHTTP_INVALID_OPTION );
+        set_option_error( option, TRUE );
         return FALSE;
     }
 }
@@ -368,8 +397,6 @@ static void connect_destroy( struct object_header *hdr )
 
     free( connect->hostname );
     free( connect->servername );
-    free( connect->username );
-    free( connect->password );
     free( connect );
 }
 
@@ -424,7 +451,7 @@ static BOOL connect_query_option( struct object_header *hdr, DWORD option, void
 
     default:
         FIXME( "unimplemented option %lu\n", option );
-        SetLastError( ERROR_INVALID_PARAMETER );
+        set_option_error( option, FALSE );
         return FALSE;
     }
 }
