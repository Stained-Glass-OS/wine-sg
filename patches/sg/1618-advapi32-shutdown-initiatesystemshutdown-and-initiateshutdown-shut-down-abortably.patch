From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32, shutdown: InitiateSystemShutdown and InitiateShutdown shut down, abortably

InitiateSystemShutdownEx(A/W) said yes and did nothing, InitiateShutdownA/W
failed with ERROR_CALL_NOT_IMPLEMENTED, and AbortSystemShutdown aborted
nothing: an installer asking for the restart it needs never got it, and
"shutdown /a" always said no shutdown was in progress.

A shutdown with a delay is shutdown.exe waiting it out: it holds the
"pending" mutex and gives up when the "abort" event is set, which
"shutdown /a" and AbortSystemShutdown do. InitiateSystemShutdownEx and
InitiateShutdown start it (restart or power off, forcing programs closed
when asked, the message as its comment), as Windows does only for a caller
whose token has SeShutdownPrivilege enabled (ERROR_PRIVILEGE_NOT_HELD
otherwise), one at a time (ERROR_SHUTDOWN_IN_PROGRESS), on this computer
only. The machine then goes down through ExitWindowsEx, as Start's does.

Gate: test/sysshutdown-gate.sh (every shutdown asked for is aborted; the
SG_POWERCTL stand-in proves no power request is made). Mutant
SG_MUTANT_NO_SHUTDOWN (advapi32/advapi.c).
---
--- a/dlls/advapi32/advapi.c
+++ b/dlls/advapi32/advapi.c
@@ -121,25 +121,134 @@ BOOL WINAPI IsTextUnicode( LPCVOID buf, INT len, LPINT flags )
 }
 
 
+/* A pending shutdown is shutdown.exe waiting out its delay: it owns the
+ * "pending" mutex and gives up when the "abort" event is set. The stubs
+ * here said yes and did nothing: an installer asking for the restart it
+ * needed never got it, and AbortSystemShutdown aborted nothing. */
+static const WCHAR shutdown_pending[] = L"Global\\__wine_shutdown_pending";
+static const WCHAR shutdown_abort[] = L"Global\\__wine_shutdown_abort";
+
+#ifndef SHUTDOWN_FORCE_OTHERS
+#define SHUTDOWN_FORCE_OTHERS   0x00000001
+#define SHUTDOWN_FORCE_SELF     0x00000002
+#define SHUTDOWN_RESTART        0x00000004
+#define SHUTDOWN_POWEROFF       0x00000008
+#define SHUTDOWN_NOREBOOT       0x00000010
+#endif
+
+/* whether the caller holds SeShutdownPrivilege, enabled, as Windows asks */
+static BOOL have_shutdown_privilege(void)
+{
+    PRIVILEGE_SET set;
+    HANDLE token;
+    BOOL ret = FALSE;
+
+    if (!OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token ) &&
+        !OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+        return FALSE;
+    set.PrivilegeCount = 1;
+    set.Control = PRIVILEGE_SET_ALL_NECESSARY;
+    set.Privilege[0].Attributes = 0;
+    if (!LookupPrivilegeValueW( NULL, L"SeShutdownPrivilege", &set.Privilege[0].Luid ) || !PrivilegeCheck( token, &set, &ret ))
+        ret = FALSE;
+    CloseHandle( token );
+    return ret;
+}
+
+static BOOL is_local_machine( const WCHAR *name )
+{
+    WCHAR computer[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD size = ARRAY_SIZE(computer);
+
+    if (!name || !*name) return TRUE;
+    while (*name == '\\') name++;
+    return GetComputerNameW( computer, &size ) && !wcsicmp( name, computer );
+}
+
+static DWORD start_shutdown( const WCHAR *machine, const WCHAR *message, DWORD timeout, BOOL force, BOOL restart )
+{
+    WCHAR exe[MAX_PATH], *cmd, *p;
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    HANDLE pending;
+    size_t len;
+    int i;
+
+    if (!is_local_machine( machine )) return ERROR_NOT_SUPPORTED;
+    if (!have_shutdown_privilege()) return ERROR_PRIVILEGE_NOT_HELD;
+    if ((pending = OpenMutexW( SYNCHRONIZE, FALSE, shutdown_pending )))
+    {
+        CloseHandle( pending );
+        return ERROR_SHUTDOWN_IN_PROGRESS;
+    }
+
+    GetSystemDirectoryW( exe, MAX_PATH );
+    wcscat( exe, L"\\shutdown.exe" );
+    len = wcslen( exe ) + 64 + (message ? 2 * wcslen( message ) + 8 : 0);
+    if (!(cmd = malloc( len * sizeof(WCHAR) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    swprintf( cmd, len, L"\"%s\" %s /t %lu%s", exe, restart ? L"/r" : L"/s", timeout, force ? L" /f" : L"" );
+    if (message && *message)
+    {
+        /* the comment, its quotes doubled */
+        p = cmd + wcslen( cmd );
+        p += swprintf( p, 6, L" /c \"" );
+        for (i = 0; message[i]; i++)
+        {
+            if (message[i] == '"') *p++ = '"';
+            *p++ = message[i];
+        }
+        *p++ = '"';
+        *p = 0;
+    }
+    if (!CreateProcessW( exe, cmd, NULL, NULL, FALSE, CREATE_NO_WINDOW | CREATE_NEW_PROCESS_GROUP,
+                         NULL, NULL, &si, &pi ))
+    {
+        DWORD err = GetLastError();
+        free( cmd );
+        return err;
+    }
+    free( cmd );
+    CloseHandle( pi.hThread );
+    /* once it waits, the shutdown is pending (and can be aborted) */
+    for (i = 0; i < 100; i++)
+    {
+        if ((pending = OpenMutexW( SYNCHRONIZE, FALSE, shutdown_pending )))
+        {
+            CloseHandle( pending );
+            break;
+        }
+        if (!WaitForSingleObject( pi.hProcess, 20 )) break;
+    }
+    CloseHandle( pi.hProcess );
+    return ERROR_SUCCESS;
+}
+
+static DWORD abort_shutdown( const WCHAR *machine )
+{
+    HANDLE pending, event;
+
+    if (!is_local_machine( machine )) return ERROR_NOT_SUPPORTED;
+    if (!have_shutdown_privilege()) return ERROR_PRIVILEGE_NOT_HELD;
+    if (!(pending = OpenMutexW( SYNCHRONIZE, FALSE, shutdown_pending ))) return ERROR_NO_SHUTDOWN_IN_PROGRESS;
+    CloseHandle( pending );
+    if (!(event = OpenEventW( EVENT_MODIFY_STATE, FALSE, shutdown_abort ))) return ERROR_NO_SHUTDOWN_IN_PROGRESS;
+    SetEvent( event );
+    CloseHandle( event );
+    return ERROR_SUCCESS;
+}
+
