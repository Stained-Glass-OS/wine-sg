  *
  * Stop a system shutdown if one is in progress.
- *
- * PARAMS
- *  lpMachineName [I] Name of machine to not shutdown.
- *
- * RETURNS
- *  Success: TRUE.
- *  Failure: FALSE.
- *
- * NOTES
- *  The Wine implementation of this function is a harmless stub.
  */
 BOOL WINAPI AbortSystemShutdownA( LPSTR lpMachineName )
 {
-    TRACE("stub %s (harmless)\n", debugstr_a(lpMachineName));
-    return TRUE;
+    WCHAR *machine = strdupAW( lpMachineName );
+    BOOL ret = AbortSystemShutdownW( machine );
+
+    free( machine );
+    return ret;
 }
 
 /******************************************************************************
@@ -149,43 +258,38 @@ BOOL WINAPI AbortSystemShutdownA( LPSTR lpMachineName )
  */
 BOOL WINAPI AbortSystemShutdownW( LPWSTR lpMachineName )
 {
-    TRACE("stub %s (harmless)\n", debugstr_w(lpMachineName));
+    DWORD err;
+
+#ifndef SG_MUTANT_NO_SHUTDOWN
+    TRACE("%s\n", debugstr_w(lpMachineName));
+    if ((err = abort_shutdown( lpMachineName )))
+    {
+        SetLastError( err );
+        return FALSE;
+    }
+#else
+    (void)err;
+#endif
     return TRUE;
 }
 
 /******************************************************************************
  * InitiateSystemShutdownExA [ADVAPI32.@]
  *
- * Initiate a shutdown or optionally restart the computer.
- *
- * PARAMS
- *  lpMachineName    [I] Network name of machine to shutdown.
- *  lpMessage        [I] Message displayed in shutdown dialog box.
- *  dwTimeout        [I] Number of seconds dialog is displayed before shutdown.
- *  bForceAppsClosed [I] If TRUE, apps close without saving, else dialog is
- *                       displayed requesting user to close apps.
- *  bRebootAfterShutdown [I] If TRUE, system reboots after restart, else the
- *                           system flushes all caches to disk and clears
- *                           the screen
- *  dwReason [I] Reason for shutting down.  Must be a system shutdown reason
- *               code.
- *
- *  RETURNS
- *   Success: TRUE
- *   Failure: FALSE
- *
- *  NOTES
- *   if lpMachineName is NULL, the local computer is shutdown.
+ * Initiate a shutdown or optionally restart the computer, after a delay
+ * AbortSystemShutdown can cut short. Needs SeShutdownPrivilege enabled.
  */
 BOOL WINAPI InitiateSystemShutdownExA( LPSTR lpMachineName, LPSTR lpMessage,
          DWORD dwTimeout, BOOL bForceAppsClosed, BOOL bRebootAfterShutdown,
          DWORD dwReason)
 {
-     FIXME("%s %s %ld %d %d %#lx\n", debugstr_a(lpMachineName),
-            debugstr_a(lpMessage), dwTimeout, bForceAppsClosed,
-            bRebootAfterShutdown, dwReason);
-     return TRUE;
-} 
+    WCHAR *machine = strdupAW( lpMachineName ), *message = strdupAW( lpMessage );
+    BOOL ret = InitiateSystemShutdownExW( machine, message, dwTimeout, bForceAppsClosed,
+                                          bRebootAfterShutdown, dwReason );
+    free( machine );
+    free( message );
+    return ret;
+}
 
 /******************************************************************************
  * InitiateSystemShutdownExW [ADVAPI32.@]
@@ -196,11 +300,29 @@ BOOL WINAPI InitiateSystemShutdownExW( LPWSTR lpMachineName, LPWSTR lpMessage,
          DWORD dwTimeout, BOOL bForceAppsClosed, BOOL bRebootAfterShutdown,
          DWORD dwReason)
 {
+#ifndef SG_MUTANT_NO_SHUTDOWN
+    DWORD err;
+
+    TRACE("%s %s %ld %d %d %#lx\n", debugstr_w(lpMachineName), debugstr_w(lpMessage), dwTimeout,
+          bForceAppsClosed, bRebootAfterShutdown, dwReason);
+    if (dwTimeout > 315360000)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if ((err = start_shutdown( lpMachineName, lpMessage, dwTimeout, bForceAppsClosed, bRebootAfterShutdown )))
+    {
+        SetLastError( err );
+        return FALSE;
+    }
+    return TRUE;
+#else
      FIXME("%s %s %ld %d %d %#lx\n", debugstr_w(lpMachineName),
             debugstr_w(lpMessage), dwTimeout, bForceAppsClosed,
             bRebootAfterShutdown, dwReason);
      return TRUE;
-} 
+#endif
+}
 
 BOOL WINAPI InitiateSystemShutdownA( LPSTR lpMachineName, LPSTR lpMessage, DWORD dwTimeout,
                                      BOOL bForceAppsClosed, BOOL bRebootAfterShutdown )
@@ -223,8 +345,12 @@ BOOL WINAPI InitiateSystemShutdownW( LPWSTR lpMachineName, LPWSTR lpMessage, DWO
  */
 DWORD WINAPI InitiateShutdownA(char *name, char *message, DWORD seconds, DWORD flags, DWORD reason)
 {
-    FIXME("%s, %s, %ld, %ld, %ld stub\n", debugstr_a(name), debugstr_a(message), seconds, flags, reason);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    WCHAR *nameW = strdupAW( name ), *messageW = strdupAW( message );
+    DWORD ret = InitiateShutdownW( nameW, messageW, seconds, flags, reason );
+
+    free( nameW );
+    free( messageW );
+    return ret;
 }
 
 /***********************************************************************
@@ -232,8 +358,17 @@ DWORD WINAPI InitiateShutdownA(char *name, char *message, DWORD seconds, DWORD f
  */
 DWORD WINAPI InitiateShutdownW(WCHAR *name, WCHAR *message, DWORD seconds, DWORD flags, DWORD reason)
 {
+#ifndef SG_MUTANT_NO_SHUTDOWN
+    /* restart, or power off (SHUTDOWN_POWEROFF, SHUTDOWN_NOREBOOT: the
+     * machine is turned off either way); forcing programs closed */
+    TRACE("%s, %s, %ld, %#lx, %#lx\n", debugstr_w(name), debugstr_w(message), seconds, flags, reason);
+    if (seconds > 315360000) return ERROR_INVALID_PARAMETER;
+    return start_shutdown( name, message, seconds, !!(flags & (SHUTDOWN_FORCE_OTHERS | SHUTDOWN_FORCE_SELF)),
+                           !!(flags & SHUTDOWN_RESTART) );
+#else
     FIXME("%s, %s, %ld, %ld, %ld stub\n", debugstr_w(name), debugstr_w(message), seconds, flags, reason);
     return ERROR_CALL_NOT_IMPLEMENTED;
+#endif
 }
 
 BOOL WINAPI LogonUserA( LPCSTR lpszUsername, LPCSTR lpszDomain, LPCSTR lpszPassword,
--- a/programs/shutdown/main.c
+++ b/programs/shutdown/main.c
@@ -95,9 +95,24 @@ int __cdecl wmain( int argc, WCHAR *argv[] )
         usage();
         return 0;
     case ABORT:
-        /* delays run in this process: there is nothing pending elsewhere */
-        fputs( "Unable to abort the system shutdown because no shutdown was in progress.(1116)\n", stderr );
-        return ERROR_NO_SHUTDOWN_IN_PROGRESS;
+    {
+        /* a pending shutdown is another shutdown.exe waiting out its delay
+         * (or InitiateSystemShutdown's); tell it to give up */
+        HANDLE pending = OpenMutexW( SYNCHRONIZE, FALSE, L"Global\\__wine_shutdown_pending" );
+        HANDLE abort_event = OpenEventW( EVENT_MODIFY_STATE, FALSE, L"Global\\__wine_shutdown_abort" );
+
+        if (!pending || !abort_event)
+        {
+            if (pending) CloseHandle( pending );
+            if (abort_event) CloseHandle( abort_event );
+            fputs( "Unable to abort the system shutdown because no shutdown was in progress.(1116)\n", stderr );
+            return ERROR_NO_SHUTDOWN_IN_PROGRESS;
+        }
+        SetEvent( abort_event );
+        CloseHandle( abort_event );
+        CloseHandle( pending );
+        return 0;
+    }
     case HIBERNATE:
         return SetSuspendState( TRUE, FALSE, FALSE ) ? 0 : GetLastError();
     case LOGOFF:
@@ -113,8 +128,24 @@ int __cdecl wmain( int argc, WCHAR *argv[] )
     if (comment) printf( "%ls\n", comment );
     if (delay)
     {
+        HANDLE pending, abort_event;
+
+        /* pending until the delay is out, unless "shutdown /a" (or
+         * AbortSystemShutdown) sets the abort event; one at a time */
+        pending = CreateMutexW( NULL, TRUE, L"Global\\__wine_shutdown_pending" );
+        if (pending && GetLastError() == ERROR_ALREADY_EXISTS)
+        {
+            fputs( "A system shutdown is in progress.(1115)\n", stderr );
+            return ERROR_SHUTDOWN_IN_PROGRESS;
+        }
+        abort_event = CreateEventW( NULL, TRUE, FALSE, L"Global\\__wine_shutdown_abort" );
+        if (abort_event) ResetEvent( abort_event );
         TRACE( "waiting %lu s\n", delay );
-        Sleep( delay * 1000 );
+        if (abort_event && !WaitForSingleObject( abort_event, delay * 1000 ))
+        {
+            TRACE( "aborted\n" );
+            return 0;
+        }
     }
     flags = action == RESTART ? EWX_REBOOT : EWX_POWEROFF;
     if (force) flags |= EWX_FORCE;
