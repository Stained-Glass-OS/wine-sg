From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer, user32: other programs' icons in the switcher; no stack handles from ExtractIconExW

Under Wine an HICON belongs to the process that made it, so explorer could not draw another program's class
or WM_GETICON icon ("Error retrieving icon frame"): the Alt+Tab switcher and the Task View cards showed no
program icons. They now take the icon of the window's program file, kept per file, as the taskbar's buttons do.
PrivateExtractIconExW (ExtractIconExW) asked for one large and one small icon of a file with none copied an
uninitialised array to the caller: conhost.exe's console windows got a garbage handle on their taskbar button,
drawn as nothing; the handles are now NULL when nothing was extracted.
---
diff --git a/dlls/user32/exticon.c b/dlls/user32/exticon.c
index 415bb98..9db8db8 100644
--- a/dlls/user32/exticon.c
+++ b/dlls/user32/exticon.c
@@ -618,7 +618,11 @@ UINT WINAPI PrivateExtractIconExW (
 
 	if (nIcons == 1 && phIconSmall && phIconLarge)
 	{
+#ifdef SG_MUTANT_EXTICON_GARBAGE
 	  HICON hIcon[2];
+#else
+	  HICON hIcon[2] = {0};
+#endif
 	  cxicon = GetSystemMetrics(SM_CXICON);
 	  cyicon = GetSystemMetrics(SM_CYICON);
 	  cxsmicon = GetSystemMetrics(SM_CXSMICON);
@@ -626,8 +630,14 @@ UINT WINAPI PrivateExtractIconExW (
 
           ret = ICO_ExtractIconExW(lpwstrFile, hIcon, nIndex, 2, cxicon | (cxsmicon<<16),
 	                           cyicon | (cysmicon<<16), NULL, LR_DEFAULTCOLOR);
+	  /* a file without icons extracts none: no handles, not whatever the stack held */
+#ifdef SG_MUTANT_EXTICON_GARBAGE
 	  *phIconLarge = hIcon[0];
 	  *phIconSmall = hIcon[1];
+#else
+	  *phIconLarge = ret && ret != ~0u ? hIcon[0] : 0;
+	  *phIconSmall = ret && ret != ~0u ? hIcon[1] : 0;
+#endif
  	  return ret;
 	}
 
diff --git a/programs/explorer/vdesktop.c b/programs/explorer/vdesktop.c
index 6364bd9..d87962e 100644
--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -878,9 +878,57 @@ static BOOL is_linux_window( HWND hwnd )
            GetClassNameW( hwnd, class, ARRAY_SIZE(class) ) && !wcscmp( class, L"SgLinuxWindow" );
 }
 
+/* another process's icon handles cannot be drawn here (icons are per process
+ * under Wine), so a program's windows show the icon of its file, as the
+ * taskbar's buttons do; kept per file, for every window of it */
+static struct program_icon
+{
+    WCHAR  exe[MAX_PATH];
+    HICON  icon_small, icon_big;
+} program_icons[64];
+static unsigned int program_icon_count, program_icon_next;
+
+static HICON program_icon( DWORD pid, BOOL little )
+{
+    WCHAR exe[MAX_PATH];
+    DWORD len = ARRAY_SIZE(exe);
+    struct program_icon *entry;
+    HANDLE process;
+    unsigned int i;
+    BOOL ok;
+
+    if (!(process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid ))) return 0;
+    ok = QueryFullProcessImageNameW( process, 0, exe, &len );
+    CloseHandle( process );
+    if (!ok) return 0;
+    for (i = 0; i < program_icon_count; i++)
+        if (!wcsicmp( program_icons[i].exe, exe )) break;
+    if (i == program_icon_count)
+    {
+        if (program_icon_count < ARRAY_SIZE(program_icons)) i = program_icon_count++;
+        else i = program_icon_next++ % ARRAY_SIZE(program_icons);
+        entry = &program_icons[i];
+        if (entry->icon_small) DestroyIcon( entry->icon_small );
+        if (entry->icon_big) DestroyIcon( entry->icon_big );
+        entry->icon_small = entry->icon_big = 0;
+        lstrcpynW( entry->exe, exe, ARRAY_SIZE(entry->exe) );
+        ExtractIconExW( exe, 0, &entry->icon_big, &entry->icon_small, 1 );
+    }
+    entry = &program_icons[i];
+    return little && entry->icon_small ? entry->icon_small : entry->icon_big ? entry->icon_big : entry->icon_small;
+}
+
 static HICON window_icon( HWND hwnd, BOOL little )
 {
-    HICON icon = (HICON)GetClassLongPtrW( hwnd, little ? GCLP_HICONSM : GCLP_HICON );
+    HICON icon;
+    DWORD pid;
+
+#ifndef SG_MUTANT_SWITCHER_FOREIGN_ICON
+    if (GetWindowThreadProcessId( hwnd, &pid ) && pid != GetCurrentProcessId()) return program_icon( pid, little );
+#else
+    (void)pid;
+#endif
+    icon = (HICON)GetClassLongPtrW( hwnd, little ? GCLP_HICONSM : GCLP_HICON );
     if (!icon) icon = (HICON)SendMessageW( hwnd, WM_GETICON, little ? ICON_SMALL : ICON_BIG, 0 );
     return icon;
 }
@@ -1570,7 +1618,7 @@ static LRESULT CALLBACK switcher_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp
             }
             else
             {
-                HICON icon = (HICON)GetClassLongPtrW( sw.items[i], GCLP_HICON );
+                HICON icon = window_icon( sw.items[i], FALSE );
                 fill( dc, &pic, COL_TILE_BG );
                 if (!icon) icon = LoadIconW( 0, (const WCHAR *)IDI_APPLICATION );
                 DrawIconEx( dc, (pic.left + pic.right) / 2 - V(24), (pic.top + pic.bottom) / 2 - V(24), icon, V(48), V(48), 0, 0, DI_NORMAL );
@@ -1578,7 +1626,7 @@ static LRESULT CALLBACK switcher_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp
             if (i == sw.sel) frame( dc, &cell, COL_ACCENT, V(2) );
             SetRect( &title, cell.left + V(10), cell.top + V(8), cell.right - V(10), cell.top + V(30) );
             {
-                HICON icon = (HICON)GetClassLongPtrW( sw.items[i], V(16) <= 16 ? GCLP_HICONSM : GCLP_HICON );
+                HICON icon = window_icon( sw.items[i], V(16) <= 16 );
                 if (icon) { DrawIconEx( dc, title.left, title.top + V(3), icon, V(16), V(16), 0, 0, DI_NORMAL ); title.left += V(22); }
             }
             GetWindowTextW( sw.items[i], text, ARRAY_SIZE(text) );
