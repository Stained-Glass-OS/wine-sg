From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: SG Defender trusts Wine's own installed files (the real path, in root's folders)

SG Defender's on-execute check (9456) trusted Wine's own installed files by
comparing their path with the lib/wine above ntdll.so as the loader named it
-- "/opt/wine-sg/bin/../lib/wine/" -- which no descriptor's real path ever
matched: in an installed wine-sg every builtin DLL and EXE, and the prefix's
copies of them, went to the service. A cold notepad start asked it 730
times; with ClamAV's cold scans (0.7 s for 0.6 MB, 6-10 s for 16 MB) the
first start after an update of the definitions stacked them (61.8 s with
everything scanned, against 1.2 s). The real path is taken now.

And the trust is the one Windows gives its catalog-signed system files: a
file under the running Wine's lib/wine, root's, writable by root alone, with
one link, in folders that are root's and writable by root alone all the way
up to / (not /tmp or /var/tmp, sticky or not) -- what dpkg put there and
nobody but root could have changed or swapped. The same files reached
through a folder others can write are scanned. Scans still look at them.

Gate test-defender-trust (an install in root's folders and the same files
through /var/tmp, in a mount namespace; needs root or sudo -n), mutant
SG_MUTANT_DEFENDER_TRUST_NO_CHAIN.
---
--- a/dlls/ntdll/unix/sgdefender.c
+++ b/dlls/ntdll/unix/sgdefender.c
@@ -72,6 +72,33 @@
 
 /* Wine's own install (lib/wine above ntdll.so), root's: its builtin DLLs are
  * the package's, mapped into every process -- not asked about each time */
+/* every folder from the file's up to / is root's and nobody else may write
+ * it (not even with the sticky bit, as /tmp and /var/tmp): what dpkg put
+ * there, nobody but root could have changed or swapped */
+static BOOL root_chain( const char *path )
+{
+    char dir[PATH_MAX], *p;
+    struct stat st;
+
+#ifdef SG_MUTANT_DEFENDER_TRUST_NO_CHAIN
+    return TRUE;
+#endif
+    if (strlen( path ) >= sizeof(dir) || path[0] != '/') return FALSE;
+    strcpy( dir, path );
+    while ((p = strrchr( dir, '/' )))
+    {
+        if (p == dir) p[1] = 0; else *p = 0;
+        if (lstat( dir, &st ) || !S_ISDIR( st.st_mode ) || st.st_uid || (st.st_mode & (S_IWGRP | S_IWOTH)))
+            return FALSE;
+        if (p == dir) return TRUE;
+    }
+    return FALSE;
+}
+
+/* Wine's own files: what the running Wine was installed with (lib/wine above
+ * ntdll.so), root's, writable by root alone, in folders root's alone -- as
+ * Windows trusts its catalog-signed system files and Defender does not make
+ * them wait. Scans still look at them. */
 static BOOL is_wine_own( const char *path, const struct stat *st )
 {
     static char libdir[PATH_MAX];
@@ -81,23 +108,33 @@
 
     if (!done)
     {
-        char *p;
+        char *p, *real;
         done = 1;
         if (dladdr( (void *)is_wine_own, &info ) && info.dli_fname && strlen( info.dli_fname ) < sizeof(libdir))
         {
             strcpy( libdir, info.dli_fname );
             /* .../lib/wine/x86_64-unix/ntdll.so -> .../lib/wine/ */
             if ((p = strrchr( libdir, '/' ))) *p = 0;
-            if ((p = strrchr( libdir, '/' ))) p[1] = 0;
+            if ((p = strrchr( libdir, '/' ))) *p = 0;
+            else libdir[0] = 0;
+            /* the loader names it as it found it ("bin/../lib/wine/..."): the real
+             * path, as the descriptors' are */
+            real = libdir[0] ? realpath( libdir, NULL ) : NULL;
+            if (real && strlen( real ) + 2 < sizeof(libdir))
+            {
+                strcpy( libdir, real );
+                strcat( libdir, "/" );
+            }
             else libdir[0] = 0;
+            free( real );
         }
     }
     /* a build tree: its own objects (a developer's, made with their umask) */
     if (build_dir && !strncmp( path, build_dir, strlen( build_dir ) ) && path[strlen( build_dir )] == '/' &&
         (st->st_uid == getuid() || !st->st_uid)) return TRUE;
-    if (!libdir[0] || st->st_uid || (st->st_mode & (S_IWGRP | S_IWOTH))) return FALSE;
+    if (!libdir[0] || st->st_uid || (st->st_mode & (S_IWGRP | S_IWOTH)) || st->st_nlink != 1) return FALSE;
     len = strlen( libdir );
-    return !strncmp( path, libdir, len );
+    return !strncmp( path, libdir, len ) && !strstr( path + len, "/../" ) && root_chain( path );
 }
 
