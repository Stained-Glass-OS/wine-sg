+        uav_desc.ViewDimension = D3D11_UAV_DIMENSION_BUFFER;
+        uav_desc.Buffer.FirstElement = 0;
+        uav_desc.Buffer.NumElements = result_count;
+        uav_desc.Buffer.Flags = 0;
+        if (FAILED(hr = ID3D11Device1_CreateUnorderedAccessView(r->device, (ID3D11Resource *)result, &uav_desc, &uav)))
+            goto done;
+        ID3D11DeviceContext1_ClearUnorderedAccessViewUint(r->dc, uav, zero);
+    }
+    else
