+#ifndef SG_MUTANT_D2D_NO_ANALYSIS
+        if (SUCCEEDED(hr))
+            fx_analysis(r, node, info, out);
+#endif
         ID3D11PixelShader_Release(ps);
         ID3D11VertexShader_Release(vs);
     }
@@ -2137,6 +2356,7 @@
     {
         struct fx_pass_input pass_inputs[16];
         struct d2d_render_info *info = node->render_info;
+        ID2D1AnalysisTransform *analysis = NULL;
 
         if (n)
             hr = ID2D1ComputeTransform_MapOutputRectToInputRects(compute, &rect, rects, n);
@@ -2153,7 +2373,12 @@
                 pass_inputs[i].texture = &textures[i];
                 pass_inputs[i].filter = fx_filter(info, i);
             }
-            hr = fx_dispatch(r, compute, info, &rect, pass_inputs, min(n, 16), out);
+#ifndef SG_MUTANT_D2D_NO_ANALYSIS
+            if (FAILED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1AnalysisTransform, (void **)&analysis)))
+                analysis = NULL;
+#endif
+            hr = fx_dispatch(r, compute, info, &rect, pass_inputs, min(n, 16), analysis, out);
+            if (analysis) ID2D1AnalysisTransform_Release(analysis);
         }
         ID2D1ComputeTransform_Release(compute);
     }
