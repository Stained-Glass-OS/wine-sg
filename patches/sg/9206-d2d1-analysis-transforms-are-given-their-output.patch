-        static const float transparent[4];
-        ID3D11DeviceContext1_ClearUnorderedAccessViewFloat(r->dc, uav, transparent);
+        /* wine-sg 9206: an analysis compute transform writes RWStructuredBuffer<float> u0, its output
+         * rectangle's values row by row (Paint.NET's Histogram writes Result[4 * (x + y * width) + c]);
+         * Direct2D's constants are then only the inputs' sceneToInputNX/Y */
