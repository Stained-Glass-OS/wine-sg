     if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1DrawTransform, (void **)&draw)))
     {
@@ -2129,6 +2344,10 @@
         hr = fx_draw(r, vs, ps, &rect, pass_inputs, min(n, 16), info->ps_constants, info->ps_constants_size,
                 NULL, FALSE, out);
