@@ -1172,6 +1220,31 @@
     ID3D11DeviceContext1_CSSetShader(r->dc, NULL, NULL, 0);
     hr = S_OK;
 
+#ifndef SG_MUTANT_D2D_NO_ANALYSIS
+    if (analysis)
+    {
+        D3D11_MAPPED_SUBRESOURCE map;
+        ID3D11Buffer *staging;
+
+        buffer_desc.ByteWidth = result_count * sizeof(float);
+        buffer_desc.Usage = D3D11_USAGE_STAGING;
+        buffer_desc.BindFlags = 0;
+        buffer_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        buffer_desc.MiscFlags = 0;
+        buffer_desc.StructureByteStride = 0;
+        if (SUCCEEDED(ID3D11Device1_CreateBuffer(r->device, &buffer_desc, NULL, &staging)))
+        {
+            ID3D11DeviceContext1_CopyResource(r->dc, (ID3D11Resource *)staging, (ID3D11Resource *)result);
+            if (SUCCEEDED(ID3D11DeviceContext1_Map(r->dc, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &map)))
+            {
