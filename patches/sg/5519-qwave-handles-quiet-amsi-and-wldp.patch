From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] qwave: QOS handles are real; amsi and wldp log quietly

qwave: QOSCreateHandle failed with ERROR_SERVICE_ALREADY_RUNNING (a code the
documentation does not give for it); the Wine tests, taken from Windows, say
it succeeds and that QOSCloseHandle of a handle that is not a QOS handle sets
ERROR_INVALID_HANDLE. A QOS handle is now an event object (the page says it
is usable for overlapped I/O) that QOSCloseHandle closes and forgets;
QOSAddSocketToFlow answers ERROR_INVALID_PARAMETER ("the QOSHandle parameter
is invalid") for a handle that is not one, and ERROR_NOT_SUPPORTED for a real
one, since no flow can be set up without the qWAVE service. The tests' todo_wine
are removed.

amsi and wldp: the results are the documented ones for a machine with no
antimalware provider and no Device Guard policy (AMSI_RESULT_NOT_DETECTED,
no dynamic code policy, the lockdown flag the Windows test expects); the
FIXMEs only made every Office or PowerShell start noisy.

Rebased at integration (integ-2026-10) onto fast-b 3723 (amsi) and fast-a 3248 (qwave) (RECONCILE-CLOUD: qwave KEEP-A, drop the amsi hunk). 5519 keeps its wldp hunk and its qwave conformance test; the test's expectation for QOSAddSocketToFlow on a handle that is not a QOS handle is ERROR_INVALID_HANDLE (the documented error, which fast-a 3248 returns), not ERROR_INVALID_PARAMETER.
---
diff --git a/dlls/qwave/tests/qos.c b/dlls/qwave/tests/qos.c
--- a/dlls/qwave/tests/qos.c
+++ b/dlls/qwave/tests/qos.c
@@ -85,14 +85,51 @@ static void test_QOSCloseHandle(void)
     ok(ret == TRUE, "Expected TRUE, got %d\n", ret);
     ok(GetLastError() == 0xdeadbeef, "Expected 0xdeadbeef, got %ld\n", GetLastError());
 
+    SetLastError(0xdeadbeef);
+    ret = QOSCloseHandle(h);
+    ok(ret == FALSE, "Expected FALSE, got %d\n", ret);
+    ok(GetLastError() == ERROR_INVALID_HANDLE, "Expected ERROR_INVALID_HANDLE, got %ld\n", GetLastError());
+
     SetLastError(0xdeadbeef);
     ret = QOSCloseHandle((HANDLE)0xdeadbeef);
     ok(ret == FALSE, "Expected FALSE, got %d\n", ret);
     ok(GetLastError() == ERROR_INVALID_HANDLE, "Expected ERROR_INVALID_HANDLE, got %ld\n", GetLastError());
 }
 
+static void test_QOSAddSocketToFlow(void)
+{
+    QOS_VERSION ver = {1, 0};
+    QOS_FLOWID flow = 0;
+    HANDLE h, event;
+    BOOL ret;
+
+    /* a handle that is not a QOS handle */
+    event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    SetLastError(0xdeadbeef);
+    ret = QOSAddSocketToFlow(event, INVALID_SOCKET, NULL, QOSTrafficTypeBestEffort, 0, &flow);
+    ok(ret == FALSE, "Expected FALSE, got %d\n", ret);
+    ok(GetLastError() == ERROR_INVALID_HANDLE, "Expected ERROR_INVALID_HANDLE, got %ld\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = QOSCloseHandle(event);
+    ok(ret == FALSE, "Expected FALSE, got %d\n", ret);
+    ok(GetLastError() == ERROR_INVALID_HANDLE, "Expected ERROR_INVALID_HANDLE, got %ld\n", GetLastError());
+    ok(CloseHandle(event), "the event was closed by QOSCloseHandle\n");
+
+    ret = QOSCreateHandle(&ver, &h);
+    ok(ret == TRUE, "Expected TRUE, got %d\n", ret);
+    ok(h != NULL && h != INVALID_HANDLE_VALUE, "got handle %p\n", h);
+    SetLastError(0xdeadbeef);
+    ret = SetEvent(h);
+    ok(ret, "a QOS handle is a kernel object: %ld\n", GetLastError());
+    QOSCloseHandle(h);
+    SetLastError(0xdeadbeef);
+    ret = SetEvent(h);
+    ok(!ret && GetLastError() == ERROR_INVALID_HANDLE, "the handle is closed by QOSCloseHandle: %d %ld\n", ret, GetLastError());
+}
+
 START_TEST(qos)
 {
+    test_QOSAddSocketToFlow();
     test_QOSCreateHandle();
     test_QOSCloseHandle();
 }
diff --git a/dlls/wldp/wldp.c b/dlls/wldp/wldp.c
--- a/dlls/wldp/wldp.c
+++ b/dlls/wldp/wldp.c
@@ -33,8 +33,9 @@ WINE_DEFAULT_DEBUG_CHANNEL(wldp);
  */
 HRESULT WINAPI WldpIsDynamicCodePolicyEnabled(BOOL *is_enabled)
 {
-    FIXME("%p\n", is_enabled);
+    TRACE("%p\n", is_enabled);
 
+    /* no Device Guard policy is enforced here, so .NET dynamic code is not restricted */
     *is_enabled = FALSE;
     return S_OK;
 }
@@ -44,7 +45,7 @@ HRESULT WINAPI WldpIsDynamicCodePolicyEnabled(BOOL *is_enabled)
  */
 HRESULT WINAPI WldpGetLockdownPolicy(WLDP_HOST_INFORMATION *info, DWORD *state, DWORD flags)
 {
-    FIXME("%p %p %lx\n", info, state, flags);
+    TRACE("%p %p %lx\n", info, state, flags);
 
     *state = WLDP_LOCKDOWN_DEFINED_FLAG;
     if (!info) return HRESULT_FROM_NT(0);
