 void WINAPI AmsiUninitialize( HAMSICONTEXT context )
 {
-    FIXME( "%p\n", context );
+    TRACE( "%p\n", context );
 }
--- a/dlls/qwave/main.c
+++ b/dlls/qwave/main.c
@@ -26,26 +26,91 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(qwave);
 
+/* A QOS handle is a kernel object of its own (the page says it can be used for
+ * overlapped I/O and associated with a completion port), and the ones that are
+ * open are remembered so that QOSCloseHandle and QOSAddSocketToFlow can tell a
+ * QOS handle from any other. No flow is ever set up: there is no qWAVE service
+ * to mark or schedule traffic. */
+struct qos_handle
+{
+    struct qos_handle *next;
+    HANDLE handle;
+};
+
+static struct qos_handle *qos_handles;
+static SRWLOCK qos_lock = SRWLOCK_INIT;
+
+static BOOL qos_handle_valid(HANDLE handle)
+{
+    struct qos_handle *iter;
+    BOOL found = FALSE;
+
+    AcquireSRWLockShared( &qos_lock );
+    for (iter = qos_handles; iter; iter = iter->next) if (iter->handle == handle) { found = TRUE; break; }
+    ReleaseSRWLockShared( &qos_lock );
+    return found;
+}
+
 BOOL WINAPI QOSCreateHandle(PQOS_VERSION version, PHANDLE handle)
 {
-    FIXME("%p %p stub!\n", version, handle);
+    struct qos_handle *entry;
+    HANDLE event;
+
+    TRACE("%p %p\n", version, handle);
     if (!version || !((version->MajorVersion == 1) && (version->MinorVersion == 0)) || !handle)
+    {
         SetLastError(ERROR_INVALID_PARAMETER);
-    else
-        SetLastError(ERROR_SERVICE_ALREADY_RUNNING);
-    return FALSE;
+        return FALSE;
+    }
+
+    if (!(event = CreateEventW(NULL, FALSE, FALSE, NULL))) return FALSE;
+    if (!(entry = HeapAlloc(GetProcessHeap(), 0, sizeof(*entry))))
+    {
+        CloseHandle(event);
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+    entry->handle = event;
+    AcquireSRWLockExclusive( &qos_lock );
+    entry->next = qos_handles;
+    qos_handles = entry;
+    ReleaseSRWLockExclusive( &qos_lock );
+    *handle = event;
+    return TRUE;
 }
 
 BOOL WINAPI QOSAddSocketToFlow(HANDLE handle, SOCKET socket, PSOCKADDR addr,
                                QOS_TRAFFIC_TYPE traffictype, DWORD flags, PQOS_FLOWID flowid)
 {
     FIXME("%p, %Ix, %p, %d, 0x%08lx, %p stub!\n", handle, socket, addr, traffictype, flags, flowid);
-    SetLastError(ERROR_NOT_SUPPORTED);
+    SetLastError(qos_handle_valid(handle) ? ERROR_NOT_SUPPORTED : ERROR_INVALID_PARAMETER);
     return FALSE;
 }
 
 BOOL WINAPI QOSCloseHandle(HANDLE handle)
 {
-    FIXME("%p stub!\n", handle);
-    return FALSE;
+    struct qos_handle **iter, *entry = NULL;
+
+    TRACE("%p\n", handle);
+
+    AcquireSRWLockExclusive( &qos_lock );
+    for (iter = &qos_handles; *iter; iter = &(*iter)->next)
+    {
+        if ((*iter)->handle != handle) continue;
+        entry = *iter;
+        *iter = entry->next;
+        break;
+    }
+    ReleaseSRWLockExclusive( &qos_lock );
+
+    if (!entry)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+#ifndef SG_MUTANT_QOS_LEAK
+    CloseHandle(handle);
+#endif
+    HeapFree(GetProcessHeap(), 0, entry);
+    return TRUE;
 }
--- a/dlls/qwave/tests/qos.c
+++ b/dlls/qwave/tests/qos.c
@@ -47,7 +47,7 @@ static void test_QOSCreateHandle(void)
     ver.MajorVersion = 1;
     ver.MinorVersion = 0;
     ret = QOSCreateHandle(&ver, &h);
-    todo_wine ok(ret == TRUE, "Expected TRUE, got %d\n", ret);
+    ok(ret == TRUE, "Expected TRUE, got %d\n", ret);
 
     SetLastError(0xdeadbeef);
     ver.MajorVersion = 1;
@@ -73,26 +73,63 @@ static void test_QOSCloseHandle(void)
     SetLastError(0xdeadbeef);
     ret = QOSCloseHandle(NULL);
     ok(ret == FALSE, "Expected FALSE, got %d\n", ret);
-    todo_wine ok(GetLastError() == ERROR_INVALID_HANDLE, "Expected ERROR_INVALID_HANDLE, got %ld\n", GetLastError());
+    ok(GetLastError() == ERROR_INVALID_HANDLE, "Expected ERROR_INVALID_HANDLE, got %ld\n", GetLastError());
 
     ver.MajorVersion = 1;
     ver.MinorVersion = 0;
     ret = QOSCreateHandle(&ver, &h);
-    todo_wine ok(ret == TRUE, "Expected TRUE, got %d\n", ret);
+    ok(ret == TRUE, "Expected TRUE, got %d\n", ret);
 
     SetLastError(0xdeadbeef);
     ret = QOSCloseHandle(h);
-    todo_wine ok(ret == TRUE, "Expected TRUE, got %d\n", ret);
+    ok(ret == TRUE, "Expected TRUE, got %d\n", ret);
     ok(GetLastError() == 0xdeadbeef, "Expected 0xdeadbeef, got %ld\n", GetLastError());
 
+    SetLastError(0xdeadbeef);
+    ret = QOSCloseHandle(h);
+    ok(ret == FALSE, "Expected FALSE, got %d\n", ret);
+    ok(GetLastError() == ERROR_INVALID_HANDLE, "Expected ERROR_INVALID_HANDLE, got %ld\n", GetLastError());
+
     SetLastError(0xdeadbeef);
     ret = QOSCloseHandle((HANDLE)0xdeadbeef);
     ok(ret == FALSE, "Expected FALSE, got %d\n", ret);
-    todo_wine ok(GetLastError() == ERROR_INVALID_HANDLE, "Expected ERROR_INVALID_HANDLE, got %ld\n", GetLastError());
+    ok(GetLastError() == ERROR_INVALID_HANDLE, "Expected ERROR_INVALID_HANDLE, got %ld\n", GetLastError());
+}
+
+static void test_QOSAddSocketToFlow(void)
+{
+    QOS_VERSION ver = {1, 0};
+    QOS_FLOWID flow = 0;
+    HANDLE h, event;
+    BOOL ret;
+
+    /* a handle that is not a QOS handle */
+    event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    SetLastError(0xdeadbeef);
+    ret = QOSAddSocketToFlow(event, INVALID_SOCKET, NULL, QOSTrafficTypeBestEffort, 0, &flow);
+    ok(ret == FALSE, "Expected FALSE, got %d\n", ret);
+    ok(GetLastError() == ERROR_INVALID_PARAMETER, "Expected ERROR_INVALID_PARAMETER, got %ld\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = QOSCloseHandle(event);
+    ok(ret == FALSE, "Expected FALSE, got %d\n", ret);
+    ok(GetLastError() == ERROR_INVALID_HANDLE, "Expected ERROR_INVALID_HANDLE, got %ld\n", GetLastError());
+    ok(CloseHandle(event), "the event was closed by QOSCloseHandle\n");
+
+    ret = QOSCreateHandle(&ver, &h);
+    ok(ret == TRUE, "Expected TRUE, got %d\n", ret);
+    ok(h != NULL && h != INVALID_HANDLE_VALUE, "got handle %p\n", h);
+    SetLastError(0xdeadbeef);
+    ret = SetEvent(h);
+    ok(ret, "a QOS handle is a kernel object: %ld\n", GetLastError());
+    QOSCloseHandle(h);
+    SetLastError(0xdeadbeef);
+    ret = SetEvent(h);
+    ok(!ret && GetLastError() == ERROR_INVALID_HANDLE, "the handle is closed by QOSCloseHandle: %d %ld\n", ret, GetLastError());
 }
 
 START_TEST(qos)
 {
+    test_QOSAddSocketToFlow();
     test_QOSCreateHandle();
     test_QOSCloseHandle();
 }
