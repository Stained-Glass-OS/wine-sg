+UINT TABLET_GetContextHandles(HCTX *handles, UINT max)
+{
+    LPOPENCONTEXT ptr;
+    UINT count = 0;
+
+    EnterCriticalSection(&csTablet);
+    for (ptr = gOpenContexts; ptr && count < max; ptr = ptr->next)
+        handles[count++] = ptr->handle;
+    LeaveCriticalSection(&csTablet);
+    return count;
+}
+
+HWND TABLET_GetContextOwner(HCTX hCtx)
+{
+    LPOPENCONTEXT context;
+    HWND ret = NULL;
+
+    EnterCriticalSection(&csTablet);
+    if ((context = TABLET_FindOpenContext(hCtx))) ret = context->hwndOwner;
+    LeaveCriticalSection(&csTablet);
+    return ret;
+}
+
 int TABLET_PostTabletMessage(LPOPENCONTEXT newcontext, UINT msg, WPARAM wParam,
                              LPARAM lParam, BOOL send_always)
 {
+    UINT offset = msg - newcontext->context.lcMsgBase;
+
+    /* Managers hear about opening, closing, updating and overlapping of contexts. */
+    if (offset >= 1 && offset <= 4)
+        TABLET_NotifyManagers(offset, wParam, lParam);
+
     if ((send_always) || (newcontext->context.lcOptions & CXO_MESSAGES))
