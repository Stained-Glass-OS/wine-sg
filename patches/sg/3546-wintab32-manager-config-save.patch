+/* The default contexts of a manager are contexts opened (disabled) at the manager window with the driver defaults. */
+static HCTX manager_default_context(HMGR hMgr, UINT device, BOOL system)
+{
+    UINT category = (system ? WTI_DSCTXS : WTI_DDCTXS) + device;
+    struct manager *m;
+    HCTX *slot, ret;
+    LOGCONTEXTW lc;
+    HWND hwnd;
+
+    EnterCriticalSection(&csTablet);
+    if (!(m = find_manager(hMgr)))
+    {
+        LeaveCriticalSection(&csTablet);
+        return NULL;
+    }
+    hwnd = m->hwnd;
+    slot = system ? &m->def_sysctx : &m->def_context;
+    ret = device ? NULL : *slot;
+    LeaveCriticalSection(&csTablet);
+
+    if (ret) return ret;
+    if (!WTInfoW(category, 0, &lc)) return NULL;
+    if (!(ret = WTOpenW(hwnd, &lc, FALSE))) return NULL;
+
+    if (!device)
+    {
+        EnterCriticalSection(&csTablet);
+        if ((m = find_manager(hMgr))) *slot = ret;
+        LeaveCriticalSection(&csTablet);
+    }
+    return ret;
 }
 
