+BOOL WINAPI WTMgrConfigReplaceExW(HMGR hMgr, BOOL fInstall, LPWSTR lpszModule, LPSTR lpszProc)
 {
-    FIXME("(%p, %u, %p): stub\n", hMgr, wDevice, hWnd);
