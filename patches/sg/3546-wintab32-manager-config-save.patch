+/* Manager handles. A manager gets the context notifications of all contexts at a window, at its own message base. */
+
+struct manager
+{
+    struct manager *next;
+    HMGR handle;
+    HWND hwnd;
+    UINT msg_base;
+    HCTX def_context, def_sysctx;
+};
+
+static struct manager *managers;
+static HMGR top_manager = (HMGR)0xd00;
+static WCHAR *config_module; /* kept for removal */
+static BOOL (WINAPI *config_proc)(HCTX, HWND);
+
+static struct manager *find_manager(HMGR handle)
+{
+    struct manager *m;
+
+    for (m = managers; m; m = m->next)
+        if (m->handle == handle) return m;
+    return NULL;
+}
+
+/* Context messages are passed on to every manager, with the message numbers the manager asked for. */
+void TABLET_NotifyManagers(UINT offset, WPARAM wparam, LPARAM lparam)
+{
+    struct manager *m;
+    HWND targets[16];
+    UINT bases[16], count = 0, i;
+
+    EnterCriticalSection(&csTablet);
+    for (m = managers; m && count < ARRAY_SIZE(targets); m = m->next)
+    {
+        targets[count] = m->hwnd;
+        bases[count++] = m->msg_base;
+    }
+    LeaveCriticalSection(&csTablet);
+
+    for (i = 0; i < count; i++)
+        PostMessageA(targets[i], bases[i] + offset, wparam, lparam);
+}
+
 /***********************************************************************
  *		WTMgrOpen (WINTAB32.100)
  */
 HMGR WINAPI WTMgrOpen(HWND hWnd, UINT wMsgBase)
 {
-    FIXME("(%p, %u): stub\n", hWnd, wMsgBase);
+    struct manager *m;
 
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    TRACE("(%p, %u)\n", hWnd, wMsgBase);
 
-    return NULL;
+    if (!IsWindow(hWnd))
+    {
+        SetLastError(ERROR_INVALID_WINDOW_HANDLE);
+        return NULL;
+    }
+
+    if (!(m = calloc(1, sizeof(*m)))) return NULL;
+    m->hwnd = hWnd;
+    m->msg_base = wMsgBase;
+
+    EnterCriticalSection(&csTablet);
+    m->handle = top_manager;
+    top_manager = (HMGR)((UINT_PTR)top_manager + 1);
+    m->next = managers;
+    managers = m;
+    LeaveCriticalSection(&csTablet);
+
+    return m->handle;
 }
 
