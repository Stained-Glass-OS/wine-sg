-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    TRACE("(%p)\n", hMgr);
 
-    return FALSE;
+    EnterCriticalSection(&csTablet);
+    for (p = &managers; *p; p = &(*p)->next)
+    {
+        if ((*p)->handle != hMgr) continue;
+        m = *p;
+        *p = m->next;
+        defaults[0] = m->def_context;
+        defaults[1] = m->def_sysctx;
+        break;
+    }
+    LeaveCriticalSection(&csTablet);
+
+    if (!m) return FALSE;
+    if (defaults[0]) WTClose(defaults[0]);
+    if (defaults[1]) WTClose(defaults[1]);
+    free(m);
+    return TRUE;
 }
 
