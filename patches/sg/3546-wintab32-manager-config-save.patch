+    TRACE("(%p, %u, %s, %s)\n", hMgr, fInstall, debugstr_w(lpszModule), debugstr_a(lpszProc));
 
-    return 0;
+    EnterCriticalSection(&csTablet);
+    known = find_manager(hMgr) != NULL;
+    LeaveCriticalSection(&csTablet);
+    if (!known) return FALSE;
+
+    if (fInstall)
+    {
+        BOOL (WINAPI *proc)(HCTX, HWND);
+        HMODULE module;
+
+        if (!lpszModule || !lpszProc) return FALSE;
+        if (!(module = LoadLibraryW(lpszModule))) return FALSE;
+        if (!(proc = (void *)GetProcAddress(module, lpszProc)))
+        {
+            FreeLibrary(module);
+            return FALSE;
+        }
+
+        EnterCriticalSection(&csTablet);
+        if (!config_proc)
+        {
+            config_proc = proc;
+            config_module = wcsdup(lpszModule);
+            ret = TRUE;
+        }
+        LeaveCriticalSection(&csTablet);
+        if (!ret) FreeLibrary(module);
+    }
+    else
+    {
+        EnterCriticalSection(&csTablet);
+        if (config_proc)
+        {
+            HMODULE module = GetModuleHandleW(config_module);
+
+            config_proc = NULL;
+            free(config_module);
+            config_module = NULL;
+            if (module) FreeLibrary(module);
+            ret = TRUE;
+        }
+        LeaveCriticalSection(&csTablet);
+    }
+    return ret;
 }
 
