From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32, wine.inf: known-folder redirection flags, ProgramW6432Dir

Windows Terminal's start-up stopped twice outside XAML. It asks SHGetKnownFolderPath for its LocalAppData with KF_FLAG_FORCE_APP_DATA_REDIRECTION (0x80000); Wine answered E_INVALIDARG for any flag it did not know, and the terminal's settings did not load. The package and app-data redirection flags (0x10000 to 0x80000) change nothing for an unpackaged program, so they are now ignored, as Windows does. Then, rebuilding a new shell's environment, the terminal reads ProgramW6432Dir and CommonW6432Dir from HKLM\Software\Microsoft\Windows\CurrentVersion; 64-bit Windows has them and Wine did not, and the missing value aborted the shell's start. wine.inf now writes them (C:\Program Files and C:\Program Files\Common Files) on 64-bit installs.
---
diff --git a/dlls/shell32/shellpath.c b/dlls/shell32/shellpath.c
index 29c3c82..d591ce1 100644
--- a/dlls/shell32/shellpath.c
+++ b/dlls/shell32/shellpath.c
@@ -3519,6 +3519,14 @@ HRESULT WINAPI SHGetKnownFolderPath(REFKNOWNFOLDERID rfid, DWORD flags, HANDLE t
     if (folder < 0)
         return HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
 
+    /* the package and app-data redirection flags (KF_FLAG_NO_PACKAGE_REDIRECTION 0x10000,
+     * KF_FLAG_FORCE_PACKAGE_REDIRECTION 0x20000, KF_FLAG_RETURN_FILTER_REDIRECTION_TARGET 0x40000,
+     * KF_FLAG_FORCE_APP_DATA_REDIRECTION 0x80000) change nothing outside a package: ignored, as
+     * Windows does for an unpackaged program (Windows Terminal asks for its LocalAppData so) */
+#ifndef SG_MUTANT_KF_REDIRECTION_REJECTED
+    if (flags & 0xf0000) TRACE( "ignoring redirection flags %#lx\n", flags & 0xf0000 );
+    flags &= ~0xf0000;
+#endif
     if (flags & ~(KF_FLAG_CREATE|KF_FLAG_SIMPLE_IDLIST|KF_FLAG_DONT_UNEXPAND|
         KF_FLAG_DONT_VERIFY|KF_FLAG_NO_ALIAS|KF_FLAG_INIT|KF_FLAG_DEFAULT_PATH|KF_FLAG_NOT_PARENT_RELATIVE|
         KF_FLAG_NO_APPCONTAINER_REDIRECTION))
diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index a158840..2f28ee4 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -616,6 +616,10 @@ HKLM,%CurrentVersionNT%\Winlogon,"Shell",,"explorer.exe"
 [CurrentVersionWow64.ntamd64]
 HKLM,%CurrentVersion%,"ProgramFilesDir (x86)",,"%16426%"
 HKLM,%CurrentVersion%,"CommonFilesDir (x86)",,"%16428%"
+; Stained Glass OS: the 64-bit directories under their own names, as 64-bit Windows has them
+; (Windows Terminal reads them to rebuild a new shell's environment and fails without them)
+HKLM,%CurrentVersion%,"ProgramW6432Dir",,"C:\Program Files"
+HKLM,%CurrentVersion%,"CommonW6432Dir",,"C:\Program Files\Common Files"
 HKLM,Software\Microsoft\Wow64\x86,,2,"wow64cpu.dll"
 
 [CurrentVersionWow64.ntarm64]
@@ -623,6 +627,8 @@ HKLM,%CurrentVersion%,"ProgramFilesDir (x86)",,"%16426%"
 HKLM,%CurrentVersion%,"CommonFilesDir (x86)",,"%16428%"
 HKLM,%CurrentVersion%,"ProgramFilesDir (Arm)",,"C:\Program Files (Arm)"
 HKLM,%CurrentVersion%,"CommonFilesDir (Arm)",,"C:\Program Files (Arm)\Common Files"
+HKLM,%CurrentVersion%,"ProgramW6432Dir",,"C:\Program Files"
+HKLM,%CurrentVersion%,"CommonW6432Dir",,"C:\Program Files\Common Files"
 HKLM,Software\Microsoft\Wow64\amd64,,2,"xtajit64.dll"
 HKLM,Software\Microsoft\Wow64\arm,,2,"wowarmhw.dll"
 HKLM,Software\Microsoft\Wow64\x86,,2,"xtajit.dll"
