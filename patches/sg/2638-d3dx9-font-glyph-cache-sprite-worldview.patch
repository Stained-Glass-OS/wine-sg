From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dx9: glyph cache textures and boxes of ID3DXFont, ID3DXSprite world-view setters

Results the Wine tests record from Windows, which were todo.

 - The textures of the glyph cache of ID3DXFont have a mip chain that ends at the size of a
   glyph cell (2, 4, 5, 5, 8, 9 or 10 levels for the font heights of the test) instead of a
   full chain.
 - The box GetGlyphData reports for a glyph holds a pixel of margin all around the glyph (two
   pixels wider and higher than the glyph's black box); the glyph itself stays where it was
   drawn, and the cell increments already counted the margin.
 - ID3DXSprite::SetWorldViewLH and SetWorldViewRH return D3D_OK and keep the matrices (a missing
   one is the identity) instead of E_NOTIMPL; the billboard and object space modes are not
   implemented, so the matrices are not used yet.
 - Removed 85 todo_wine marks from core.c.
---
--- a/dlls/d3dx9_36/font.c
+++ b/dlls/d3dx9_36/font.c
@@ -300,7 +300,8 @@ static HRESULT WINAPI ID3DXFontImpl_PreloadGlyphs(ID3DXFont *iface, UINT first,
     static const MAT2 mat = { {0,1}, {0,0}, {0,0}, {0,1} };
     struct d3dx_font *font = impl_from_ID3DXFont(iface);
     IDirect3DTexture9 *current_texture = NULL;
-    unsigned int size, stride, glyph, x, y;
+    unsigned int size, stride, glyph, x, y, levels;
+    int glyph_left, glyph_top;
     struct d3dx_glyph *current_glyph;
     D3DLOCKED_RECT lockrect;
     GLYPHMETRICS metrics;
@@ -369,8 +370,15 @@ static HRESULT WINAPI ID3DXFontImpl_PreloadGlyphs(ID3DXFont *iface, UINT first,
             }
             font->textures = new_textures;
 
+            /* the mip chain ends at the size of a glyph cell */
+#ifdef SG_MUTANT_D3DXFONT_LEVELS
+            levels = 0;
+#else
+            for (levels = 1; (font->glyph_size >> levels) > 0; ++levels)
+                ;
+#endif
             if (FAILED(hr = IDirect3DDevice9_CreateTexture(font->device, font->texture_size,
-                    font->texture_size, 0, 0, D3DFMT_A8R8G8B8, D3DPOOL_MANAGED,
+                    font->texture_size, levels, 0, D3DFMT_A8R8G8B8, D3DPOOL_MANAGED,
                     &font->textures[font->texture_count], NULL)))
             {
                 free(buffer);
@@ -394,11 +402,20 @@ static HRESULT WINAPI ID3DXFontImpl_PreloadGlyphs(ID3DXFont *iface, UINT first,
         x = morton_decode(font->texture_pos) * font->glyph_size;
         y = morton_decode(font->texture_pos >> 1) * font->glyph_size;
 
-        current_glyph->black_box.left = x - metrics.gmptGlyphOrigin.x + font->glyph_size / 2
-                - metrics.gmBlackBoxX / 2;
-        current_glyph->black_box.top = y - metrics.gmptGlyphOrigin.y + font->metrics.tmAscent + 1;
-        current_glyph->black_box.right = current_glyph->black_box.left + metrics.gmBlackBoxX;
-        current_glyph->black_box.bottom = current_glyph->black_box.top + metrics.gmBlackBoxY;
+        glyph_left = x - metrics.gmptGlyphOrigin.x + font->glyph_size / 2 - metrics.gmBlackBoxX / 2;
+        glyph_top = y - metrics.gmptGlyphOrigin.y + font->metrics.tmAscent + 1;
+        /* the box of a glyph holds a pixel of margin all around it */
+#ifdef SG_MUTANT_D3DXFONT_NO_MARGIN
+        current_glyph->black_box.left = glyph_left;
+        current_glyph->black_box.top = glyph_top;
+        current_glyph->black_box.right = glyph_left + metrics.gmBlackBoxX;
+        current_glyph->black_box.bottom = glyph_top + metrics.gmBlackBoxY;
+#else
+        current_glyph->black_box.left = glyph_left - 1;
+        current_glyph->black_box.top = glyph_top - 1;
+        current_glyph->black_box.right = glyph_left + metrics.gmBlackBoxX + 1;
+        current_glyph->black_box.bottom = glyph_top + metrics.gmBlackBoxY + 1;
+#endif
         current_glyph->cell_inc.x = metrics.gmptGlyphOrigin.x - 1;
         current_glyph->cell_inc.y = font->metrics.tmAscent - metrics.gmptGlyphOrigin.y - 1;
         current_glyph->texture = current_texture;
@@ -407,8 +424,8 @@ static HRESULT WINAPI ID3DXFontImpl_PreloadGlyphs(ID3DXFont *iface, UINT first,
         stride = (metrics.gmBlackBoxX + 3) & ~3;
         for (y = 0; y < metrics.gmBlackBoxY; ++y)
             for (x = 0; x < metrics.gmBlackBoxX; ++x)
-                pixel_data[(current_glyph->black_box.top + y) * lockrect.Pitch / 4
-                        + current_glyph->black_box.left + x] =
+                pixel_data[(glyph_top + y) * lockrect.Pitch / 4
+                        + glyph_left + x] =
                         (buffer[y * stride + x] * 255 / 64 << 24) | 0x00ffffffu;
 
         free(buffer);
--- a/dlls/d3dx9_36/sprite.c
+++ b/dlls/d3dx9_36/sprite.c
@@ -53,6 +53,7 @@ struct d3dx9_sprite
     IDirect3DStateBlock9 *stateblock;
     D3DXMATRIX transform;
     D3DXMATRIX view;
+    D3DXMATRIX world, world_view_view; /* SetWorldView*(); used by the billboard and object space modes */
     DWORD flags;
     BOOL ready;
 
@@ -176,20 +177,43 @@ static HRESULT WINAPI d3dx9_sprite_SetTransform(ID3DXSprite *iface, const D3DXMA
     return D3D_OK;
 }
 
+static HRESULT sprite_set_world_view(struct d3dx9_sprite *sprite, const D3DXMATRIX *world, const D3DXMATRIX *view)
+{
+    /* a missing matrix is the identity */
+#ifdef SG_MUTANT_D3DXSPRITE_WV_NULL
+    if (!world || !view)
+        return D3DERR_INVALIDCALL;
+#endif
+    if (world)
+        sprite->world = *world;
+    else
+        D3DXMatrixIdentity(&sprite->world);
+    if (view)
+        sprite->world_view_view = *view;
+    else
+        D3DXMatrixIdentity(&sprite->world_view_view);
+
+    return D3D_OK;
+}
+
 static HRESULT WINAPI d3dx9_sprite_SetWorldViewRH(ID3DXSprite *iface,
         const D3DXMATRIX *world, const D3DXMATRIX *view)
 {
-    FIXME("iface %p, world %p, view %p stub!\n", iface, world, view);
+    struct d3dx9_sprite *sprite = impl_from_ID3DXSprite(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, world %p, view %p.\n", iface, world, view);
+
+    return sprite_set_world_view(sprite, world, view);
 }
 
 static HRESULT WINAPI d3dx9_sprite_SetWorldViewLH(ID3DXSprite *iface,
         const D3DXMATRIX *world, const D3DXMATRIX *view)
 {
-    FIXME("iface %p, world %p, view %p stub!\n", iface, world, view);
+    struct d3dx9_sprite *sprite = impl_from_ID3DXSprite(iface);
+
+    TRACE("iface %p, world %p, view %p.\n", iface, world, view);
 
-    return E_NOTIMPL;
+    return sprite_set_world_view(sprite, world, view);
 }
 
 /* Helper function */
@@ -582,6 +606,8 @@ HRESULT WINAPI D3DXCreateSprite(struct IDirect3DDevice9 *device, struct ID3DXSpr
 
     D3DXMatrixIdentity(&object->transform);
     D3DXMatrixIdentity(&object->view);
+    D3DXMatrixIdentity(&object->world);
+    D3DXMatrixIdentity(&object->world_view_view);
 
     IDirect3DDevice9_GetDeviceCaps(device, &caps);
     object->texfilter_caps=caps.TextureFilterCaps;
