@@ -461,13 +461,149 @@ int WINAPI SysStringLen16(BSTR16 str)
 	return strlen(BSTR_GetAddr(str));
 }
 
+/* conversions between the 16 bit variants and the 32 bit ones */
+
+static void variant16_free(VARIANT16 *v)
+{
+    if (v->vt == VT_BSTR && v->u.bstrVal) SysFreeString16((BSTR16)v->u.bstrVal);
+    v->vt = VT_EMPTY;
+}
+
+static HRESULT variant16_to_32(const VARIANT16 *src, VARIANT *dst)
+{
+    VariantInit(dst);
+
+    switch (src->vt)
+    {
+    case VT_EMPTY:
+    case VT_NULL:
+    case VT_I2:
+    case VT_I4:
+    case VT_R4:
+    case VT_R8:
+    case VT_CY:
+    case VT_DATE:
+    case VT_ERROR:
+    case VT_BOOL:
+    case VT_UI1:
+        V_VT(dst) = src->vt;
+        /* the value fields have the same layout */
+        memcpy(&V_I8(dst), &src->u, 8);
+        return S_OK;
+
+    case VT_BSTR:
+    {
+        const char *str = BSTR_GetAddr((BSTR16)src->u.bstrVal);
+        int len;
+        BSTR bstr;
+
+        if (!str)
+        {
+            V_VT(dst) = VT_BSTR;
+            return S_OK;
+        }
+        len = MultiByteToWideChar(CP_ACP, 0, str, -1, NULL, 0);
+        if (!(bstr = SysAllocStringLen(NULL, len - 1))) return E_OUTOFMEMORY;
+        MultiByteToWideChar(CP_ACP, 0, str, -1, bstr, len);
+        V_VT(dst) = VT_BSTR;
+        V_BSTR(dst) = bstr;
+        return S_OK;
+    }
+
+    default:
+        /* arrays, references and objects hold 16 bit pointers */
+        if (src->vt & (VT_BYREF | VT_ARRAY | VT_VECTOR)) return DISP_E_BADVARTYPE;
+        return E_NOTIMPL;
+    }
+}
+
+static HRESULT variant32_to_16(const VARIANT *src, VARIANT16 *dst)
+{
+    memset(dst, 0, sizeof(*dst));
+
+    switch (V_VT(src))
+    {
+    case VT_BSTR:
+    {
+        int len;
+        char *str;
+        BSTR16 bstr;
+
+        if (!V_BSTR(src))
+        {
+            dst->vt = VT_BSTR;
+            return S_OK;
+        }
+        len = WideCharToMultiByte(CP_ACP, 0, V_BSTR(src), SysStringLen(V_BSTR(src)), NULL, 0, NULL, NULL);
+        if (!(str = HeapAlloc(GetProcessHeap(), 0, len + 1))) return E_OUTOFMEMORY;
+        WideCharToMultiByte(CP_ACP, 0, V_BSTR(src), SysStringLen(V_BSTR(src)), str, len, NULL, NULL);
+        str[len] = 0;
+        bstr = SysAllocStringLen16(str, len);
+        HeapFree(GetProcessHeap(), 0, str);
+        if (!bstr) return E_OUTOFMEMORY;
+        dst->vt = VT_BSTR;
+        dst->u.bstrVal = (SEGPTR)bstr;
+        return S_OK;
+    }
+
+    case VT_EMPTY:
+    case VT_NULL:
+    case VT_I2:
+    case VT_I4:
+    case VT_R4:
+    case VT_R8:
+    case VT_CY:
+    case VT_DATE:
+    case VT_ERROR:
+    case VT_BOOL:
+    case VT_UI1:
+        dst->vt = V_VT(src);
+        memcpy(&dst->u, &V_I8(src), 8);
+        return S_OK;
+
+    default:
+        return E_NOTIMPL;
+    }
+}
+
+static HRESULT change_type16(VARIANT16 *dest, const VARIANT16 *src, LCID lcid, USHORT flags, VARTYPE vt)
+{
+    VARIANT src32, dst32;
+    HRESULT hr;
+
+    if (!dest || !src) return E_INVALIDARG;
+
+    /* only the types without 16 bit pointers can be converted */
+    if (vt & (VT_BYREF | VT_ARRAY | VT_VECTOR)) return DISP_E_BADVARTYPE;
+    if (vt != VT_EMPTY && vt != VT_NULL && vt != VT_I2 && vt != VT_I4 && vt != VT_R4 && vt != VT_R8 &&
+        vt != VT_CY && vt != VT_DATE && vt != VT_BSTR && vt != VT_ERROR && vt != VT_BOOL && vt != VT_UI1)
+        return E_NOTIMPL;
+
+    if (FAILED(hr = variant16_to_32(src, &src32))) return hr;
+    VariantInit(&dst32);
+    hr = VariantChangeTypeEx(&dst32, &src32, lcid, flags, vt);
+    VariantClear(&src32);
+    if (FAILED(hr)) return hr;
+
+    {
+        VARIANT16 result;
+
+        hr = variant32_to_16(&dst32, &result);
+        VariantClear(&dst32);
+        if (FAILED(hr)) return hr;
+        variant16_free(dest);
+        *dest = result;
+    }
+    return S_OK;
+}
+
 /******************************************************************************
  * VariantChangeType [OLE2DISP.12]
  */
-HRESULT WINAPI VariantChangeType16(VARIANTARG *vargDest, VARIANTARG *varSrc, unsigned short flags, VARTYPE vt)
+HRESULT WINAPI VariantChangeType16(VARIANTARG16 *vargDest, VARIANTARG16 *varSrc, unsigned short flags, VARTYPE vt)
 {
-    FIXME("stub: (%p, %p, %d, %d)\n", vargDest, varSrc, flags, vt);
-    return E_NOTIMPL;
+    TRACE("(%p, %p, %d, %d)\n", vargDest, varSrc, flags, vt);
+    return change_type16(vargDest, varSrc, LOCALE_USER_DEFAULT, flags, vt);
 }
 
 
