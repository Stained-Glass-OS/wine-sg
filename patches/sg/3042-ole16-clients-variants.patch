@@ -762,17 +765,56 @@ HRESULT WINAPI CoCreateGuid16(GUID *pguid)
  *           CoCreateInstance [COMPOBJ.13]
  */
 HRESULT WINAPI CoCreateInstance16(
-	REFCLSID rclsid,
-	LPUNKNOWN pUnkOuter,
+	SEGPTR rclsid,
+	SEGPTR pUnkOuter,
 	DWORD dwClsContext,
-	REFIID iid,
-	LPVOID *ppv)
-{
-  FIXME("(%s, %p, %lx, %s, %p), stub!\n",
-	debugstr_guid(rclsid), pUnkOuter, dwClsContext, debugstr_guid(iid),
-	ppv
-  );
-  return E_NOTIMPL;
+	SEGPTR iid,
+	SEGPTR ppv)
+{
+    static const GUID iid_classfactory = { 0x00000001, 0, 0, { 0xc0, 0, 0, 0, 0, 0, 0, 0x46 } };
+    SEGPTR factory = 0, factory_seg, iid_seg, vtbl, method;
+    SEGPTR *ppvl = MapSL(ppv);
+    WORD args[8];
+    DWORD ret = 0;
+    HRESULT hr;
+
+    TRACE("(%s, %04x:%04x, %lx, %s, %04x:%04x)\n", debugstr_guid(MapSL(rclsid)),
+          HIWORD(pUnkOuter), LOWORD(pUnkOuter), dwClsContext, debugstr_guid(MapSL(iid)),
+          HIWORD(ppv), LOWORD(ppv));
+
+    if (!ppvl) return E_INVALIDARG;
+    *ppvl = 0;
+
+    /* get the class factory, then ask it for the object */
+    factory_seg = MapLS(&factory);
+    iid_seg = MapLS((void *)&iid_classfactory);
+    hr = CoGetClassObject16(rclsid, dwClsContext, NULL, iid_seg, factory_seg);
+    UnMapLS(iid_seg);
+    UnMapLS(factory_seg);
+    if (FAILED(hr)) return hr;
+    if (!factory) return E_NOINTERFACE;
+
+    /* IClassFactory::CreateInstance(This, pUnkOuter, riid, ppvObject) */
+    vtbl = *(SEGPTR *)MapSL(factory);
+    method = *(SEGPTR *)MapSL(vtbl + 3 * sizeof(SEGPTR));
+    args[7] = SELECTOROF(factory);
+    args[6] = OFFSETOF(factory);
+    args[5] = SELECTOROF(pUnkOuter);
+    args[4] = OFFSETOF(pUnkOuter);
+    args[3] = SELECTOROF(iid);
+    args[2] = OFFSETOF(iid);
+    args[1] = SELECTOROF(ppv);
+    args[0] = OFFSETOF(ppv);
+    WOWCallback16Ex((DWORD)method, WCB16_PASCAL, 8 * sizeof(WORD), args, &ret);
+    hr = ret;
+
+    /* IClassFactory::Release(This) */
+    method = *(SEGPTR *)MapSL(vtbl + 2 * sizeof(SEGPTR));
+    args[1] = SELECTOROF(factory);
+    args[0] = OFFSETOF(factory);
+    WOWCallback16Ex((DWORD)method, WCB16_PASCAL, 2 * sizeof(WORD), args, &ret);
+
+    return hr;
 }
 
