From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, explorer: a Linux program's dialog is its window's owned window

A Linux program's dialog (ICCCM WM_TRANSIENT_FOR: an Open or Save dialog,
Preferences, About) was framed by the shell as a window of its own: a
taskbar button of its own, and behind its program's window at that
window's first click -- a modal dialog out of sight, its program looking
hung (David 2026-11-27: Linux programs first class; "dialogs over their
owners").

As a Windows dialog is its program window's owned window: explorer asks
winex11 whose dialog a Linux window is (SG_EMBED_OWNER, 0x80001010:
XGetTransientForHint) as it frames it, and a dialog of another framed
window is that frame's owned window, without WS_EX_APPWINDOW: no taskbar
button of its own, minimized with its window (SC_MINIMIZE hides owned
windows), above it in Wine's Z order. And winex11 keeps it above in X:
a window given the focus in a virtual desktop went to the top of its band
(set_input_focus) -- above its own dialog, where Wine's Z order had the
dialog; it now stays right below a window it owns.

Gate: test/linuxdialog-gate.sh (mutants SG_MUTANT_EMBED_DIALOG_UNOWNED in
explorer, SG_MUTANT_FOCUS_OVER_OWNED in winex11's event.c).
---
--- a/dlls/winex11.drv/event.c
+++ b/dlls/winex11.drv/event.c
@@ -645,6 +645,21 @@
  *
  * Try to force focus for embedded or non-managed windows.
  */
+/* Stained Glass OS 9515: the visible window above this one in Wine's Z order
+ * is one it owns (a dialog): activated, it stays right below it, as Windows
+ * keeps owned windows above their owner */
+static BOOL owned_predecessor( HWND hwnd )
+{
+    HWND prev = NtUserGetWindowRelative( hwnd, GW_HWNDPREV ), owner;
+    int i;
+
+    while (prev && !(NtUserGetWindowLongW( prev, GWL_STYLE ) & WS_VISIBLE))
+        prev = NtUserGetWindowRelative( prev, GW_HWNDPREV );
+    for (owner = prev, i = 0; owner && i < 8; i++)
+        if ((owner = NtUserGetWindowRelative( owner, GW_OWNER )) == hwnd) return TRUE;
+    return FALSE;
+}
+
 static void set_input_focus( struct x11drv_win_data *data )
 {
     XWindowChanges changes;
@@ -677,7 +692,12 @@
      * window brings it to the top of its band, never above a topmost one of
      * this process (Word's topmost error box over its splash); otherwise it
      * is raised. */
-    if (get_stack_predecessor( data->hwnd, data->managed, &below, &topmost ) || !topmost ||
+    if (get_stack_predecessor( data->hwnd, data->managed, &below, &topmost ) ||
+#ifndef SG_MUTANT_FOCUS_OVER_OWNED
+        (!topmost && !owned_predecessor( data->hwnd )) ||
+#else
+        !topmost ||
+#endif
         (NtUserGetWindowLongW( data->hwnd, GWL_EXSTYLE ) & WS_EX_TOPMOST) ||
         !stack_window_below( data->display, data->whole_window, below ))
     {
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -1435,6 +1435,21 @@
     {
     case WM_X11DRV_SG_EMBED_QUERY:
         return sg_embed_query( hwnd, (Window)wp );
+    case WM_X11DRV_SG_EMBED_OWNER:
+    {
+        /* 9515: the window the Linux window WP is a dialog of (ICCCM
+         * WM_TRANSIENT_FOR), for its frame to be that window's frame's owned
+         * window, as a Windows dialog is its program window's */
+        Window owner = None;
+        if (!(data = get_win_data( hwnd ))) return 0;
+        display = data->display;
+        release_win_data( data );
+        X11DRV_expect_error( display, ignore_error, NULL );
+        if (!XGetTransientForHint( display, (Window)wp, &owner )) owner = None;
+        if (sync_check_error( display )) owner = None;
+        if (owner == DefaultRootWindow( display )) owner = None;
+        return (LRESULT)owner;
+    }
     case WM_X11DRV_SG_EMBED_ATTACH:
     {
         LRESULT ret = sg_embed_attach( hwnd, (Window)wp );
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3951,6 +3951,7 @@
     case WM_X11DRV_SG_EMBED_FOCUS:
     case WM_X11DRV_SG_EMBED_MOVESIZE_DONE:
     case WM_X11DRV_SG_EMBED_ATTENTION:
+    case WM_X11DRV_SG_EMBED_OWNER:
         return sg_embed_message( hwnd, msg, wp, lp );
     case WM_X11DRV_SG_GL_RESHOW:
         return sg_gl_reshow( hwnd );
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -711,7 +711,8 @@
     WM_X11DRV_SG_EMBED_FOCUS,
     WM_X11DRV_SG_EMBED_MOVESIZE_DONE,
     WM_X11DRV_SG_GL_RESHOW,        /* 6096: show the offscreen OpenGL frame again */
-    WM_X11DRV_SG_EMBED_ATTENTION   /* 9513: the Linux program in it asks for attention, or no longer */
+    WM_X11DRV_SG_EMBED_ATTENTION,  /* 9513: the Linux program in it asks for attention, or no longer */
+    WM_X11DRV_SG_EMBED_OWNER       /* 9515: whose dialog a Linux window is (explorer sends it by number, 0x80001010) */
 };
 
 /* a window whose OpenGL frames are rendered offscreen and copied into its top-level (6096) */
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -3156,6 +3156,7 @@
 #define SG_EMBED_QUERY   0x80001004
 #define SG_EMBED_ATTACH  0x80001005
 #define SG_EMBED_CLOSE   0x80001006
+#define SG_EMBED_OWNER   0x80001010   /* 9515: the X window a Linux window is a dialog of (WM_TRANSIENT_FOR) */
 #define WM_SG_EMBED_SHOWN (WM_USER + 0x5350)
 #define WM_SG_EMBED_GONE  (WM_USER + 0x5351)
 
@@ -3701,6 +3702,25 @@
     rc.top = (short)((g >> 16) & 0xffff);
     rc.right = rc.left + (int)((g >> 32) & 0x7fff);
     rc.bottom = rc.top + (int)((g >> 48) & 0x7fff);
+#ifndef SG_MUTANT_EMBED_DIALOG_UNOWNED
+    {
+        /* 9515: a dialog of another framed Linux window (WM_TRANSIENT_FOR: an Open or
+         * Save dialog, Preferences, About) is that window's frame's owned window, as a
+         * Windows dialog is its program window's: no taskbar button of its own, always
+         * above its window -- it fell behind it at the window's first click, and its
+         * program looked hung (a modal dialog out of sight) -- and minimized with it */
+        unsigned long owner = (unsigned long)sg_embed_call( frame, SG_EMBED_OWNER, xid );
+        struct taskbar_button *other;
+        if (owner)
+            LIST_FOR_EACH_ENTRY( other, &taskbar_buttons, struct taskbar_button, entry )
+            {
+                if (other->embedded != owner || !other->hwnd) continue;
+                SetWindowLongW( frame, GWL_EXSTYLE, GetWindowLongW( frame, GWL_EXSTYLE ) & ~WS_EX_APPWINDOW );
+                SetWindowLongPtrW( frame, GWLP_HWNDPARENT, (LONG_PTR)other->hwnd );
+                break;
+            }
+    }
+#endif
     if (g >> 63)
     {
         /* the program draws its own title bar (it asked for no decorations):
