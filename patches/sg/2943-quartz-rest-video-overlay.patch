From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] quartz: video renderer IOverlay

quartz's video renderer IOverlay (the pin's overlay interface): the
palette (SetPalette, up to 256 entries, GetPalette hands out a copy or
VFW_E_NO_PALETTE_AVAILABLE), the colour key (GetColorKey returns
VFW_E_NO_COLOR_KEY_SET until one is set, GetDefaultColorKey is magenta),
GetVideoPosition / GetClipList (the client area in screen coordinates,
no clip rectangles while the window is hidden) and Advise / Unadvise
(one IOverlayNotify, VFW_E_ADVISE_ALREADY_SET / VFW_E_NO_ADVISE_SET,
palette and colour key changes are reported according to the flags).

---
diff --git a/dlls/quartz/videorenderer.c b/dlls/quartz/videorenderer.c
index bbd3467..9e75370 100644
--- a/dlls/quartz/videorenderer.c
+++ b/dlls/quartz/videorenderer.c
@@ -42,6 +42,14 @@ struct video_renderer
     struct video_window window;
 
     IOverlay IOverlay_iface;
+    /* State kept for IOverlay: a palette and colour key set by the source, and
+     * the notification sink registered by IOverlay::Advise(). */
+    PALETTEENTRY *overlay_palette;
+    DWORD overlay_palette_count;
+    COLORKEY overlay_color_key;
+    BOOL overlay_has_color_key;
+    IOverlayNotify *overlay_sink;
+    DWORD overlay_flags;
 
     LONG VideoWidth;
     LONG VideoHeight;
@@ -128,6 +136,9 @@ static void video_renderer_destroy(struct strmbase_renderer *iface)
     struct video_renderer *filter = impl_from_strmbase_renderer(iface);
 
     video_window_cleanup(&filter->window);
+    if (filter->overlay_sink)
+        IOverlayNotify_Release(filter->overlay_sink);
+    free(filter->overlay_palette);
     strmbase_renderer_cleanup(&filter->renderer);
     free(filter);
 }
@@ -393,32 +404,145 @@ static ULONG WINAPI overlay_Release(IOverlay *iface)
 
 static HRESULT WINAPI overlay_GetPalette(IOverlay *iface, DWORD *count, PALETTEENTRY **palette)
 {
-    FIXME("iface %p, count %p, palette %p, stub!\n", iface, count, palette);
-    return E_NOTIMPL;
+    struct video_renderer *filter = impl_from_IOverlay(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("filter %p, count %p, palette %p.\n", filter, count, palette);
+
+    if (!count || !palette)
+        return E_POINTER;
+
+    EnterCriticalSection(&filter->renderer.filter.filter_cs);
+
+    if (!filter->overlay_palette_count)
+    {
+        *count = 0;
+        *palette = NULL;
+        hr = VFW_E_NO_PALETTE_AVAILABLE;
+    }
+    else if (!(*palette = CoTaskMemAlloc(filter->overlay_palette_count * sizeof(PALETTEENTRY))))
+    {
+        *count = 0;
+        hr = E_OUTOFMEMORY;
+    }
+    else
+    {
+        memcpy(*palette, filter->overlay_palette, filter->overlay_palette_count * sizeof(PALETTEENTRY));
+        *count = filter->overlay_palette_count;
+    }
+
+    LeaveCriticalSection(&filter->renderer.filter.filter_cs);
+    return hr;
 }
 
 static HRESULT WINAPI overlay_SetPalette(IOverlay *iface, DWORD count, PALETTEENTRY *palette)
 {
-    FIXME("iface %p, count %lu, palette %p, stub!\n", iface, count, palette);
-    return E_NOTIMPL;
+    struct video_renderer *filter = impl_from_IOverlay(iface);
+    IOverlayNotify *sink = NULL;
+    PALETTEENTRY *copy = NULL;
+
+    TRACE("filter %p, count %lu, palette %p.\n", filter, count, palette);
+
+    if (count > 256)
+        return E_INVALIDARG;
+    if (count && !palette)
+        return E_POINTER;
+
+    if (count)
+    {
+        if (!(copy = malloc(count * sizeof(*copy))))
+            return E_OUTOFMEMORY;
+        memcpy(copy, palette, count * sizeof(*copy));
+    }
+
+    EnterCriticalSection(&filter->renderer.filter.filter_cs);
+    free(filter->overlay_palette);
+    filter->overlay_palette = copy;
+    filter->overlay_palette_count = count;
+#ifndef SG_MUTANT_OV_FLAGS
+    if (filter->overlay_sink && (filter->overlay_flags & ADVISE_PALETTE))
+#else
+    if (filter->overlay_sink)
+#endif
+        IOverlayNotify_AddRef(sink = filter->overlay_sink);
+    LeaveCriticalSection(&filter->renderer.filter.filter_cs);
+
+    if (sink)
+    {
+        IOverlayNotify_OnPaletteChange(sink, count, palette);
+        IOverlayNotify_Release(sink);
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI overlay_GetDefaultColorKey(IOverlay *iface, COLORKEY *key)
 {
-    FIXME("iface %p, key %p, stub!\n", iface, key);
-    return E_NOTIMPL;
+    struct video_renderer *filter = impl_from_IOverlay(iface);
+
+    TRACE("filter %p, key %p.\n", filter, key);
+
+    if (!key)
+        return E_POINTER;
+
+    /* A colour the video is unlikely to contain. */
+    key->KeyType = CK_RGB;
+    key->PaletteIndex = 0;
+#ifdef SG_MUTANT_OV_DEFKEY
+    key->LowColorValue = key->HighColorValue = 0;
+#else
+    key->LowColorValue = key->HighColorValue = RGB(0xff, 0, 0xff);
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI overlay_GetColorKey(IOverlay *iface, COLORKEY *key)
 {
-    FIXME("iface %p, key %p, stub!\n", iface, key);
-    return E_NOTIMPL;
+    struct video_renderer *filter = impl_from_IOverlay(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("filter %p, key %p.\n", filter, key);
+
+    if (!key)
+        return E_POINTER;
+
+    EnterCriticalSection(&filter->renderer.filter.filter_cs);
+#ifndef SG_MUTANT_OV_KEY
+    if (filter->overlay_has_color_key)
+#else
+    if (1)
+#endif
+        *key = filter->overlay_color_key;
+    else
+        hr = VFW_E_NO_COLOR_KEY_SET;
+    LeaveCriticalSection(&filter->renderer.filter.filter_cs);
+    return hr;
 }
 
 static HRESULT WINAPI overlay_SetColorKey(IOverlay *iface, COLORKEY *key)
 {
-    FIXME("iface %p, key %p, stub!\n", iface, key);
-    return E_NOTIMPL;
+    struct video_renderer *filter = impl_from_IOverlay(iface);
+    IOverlayNotify *sink = NULL;
+
+    TRACE("filter %p, key %p.\n", filter, key);
+
+    if (!key)
+        return E_POINTER;
+    if (key->KeyType & ~(CK_INDEX | CK_RGB))
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&filter->renderer.filter.filter_cs);
+    filter->overlay_color_key = *key;
+    filter->overlay_has_color_key = TRUE;
+    if (filter->overlay_sink && (filter->overlay_flags & ADVISE_COLORKEY))
+        IOverlayNotify_AddRef(sink = filter->overlay_sink);
+    LeaveCriticalSection(&filter->renderer.filter.filter_cs);
+
+    if (sink)
+    {
+        IOverlayNotify_OnColorKeyChange(sink, key);
+        IOverlayNotify_Release(sink);
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI overlay_GetWindowHandle(IOverlay *iface, HWND *window)
@@ -431,28 +555,105 @@ static HRESULT WINAPI overlay_GetWindowHandle(IOverlay *iface, HWND *window)
     return S_OK;
 }
 
+/* The window is never overlapped by anything the filter knows of, so its clip
+ * region is its whole client area (screen coordinates) while it is visible. */
+static void overlay_get_rects(struct video_renderer *filter, RECT *source, RECT *dest)
+{
+    *source = filter->window.src;
+    GetClientRect(filter->window.hwnd, dest);
+    MapWindowPoints(filter->window.hwnd, NULL, (POINT *)dest, 2);
+}
+
 static HRESULT WINAPI overlay_GetClipList(IOverlay *iface, RECT *source, RECT *dest, RGNDATA **region)
 {
-    FIXME("iface %p, source %p, dest %p, region %p, stub!\n", iface, source, dest, region);
-    return E_NOTIMPL;
+    struct video_renderer *filter = impl_from_IOverlay(iface);
+    unsigned int count;
+    RGNDATA *data;
+
+    TRACE("filter %p, source %p, dest %p, region %p.\n", filter, source, dest, region);
+
+    if (!source || !dest || !region)
+        return E_POINTER;
+
+    overlay_get_rects(filter, source, dest);
+    count = IsWindowVisible(filter->window.hwnd) && !IsRectEmpty(dest);
+
+    if (!(data = CoTaskMemAlloc(sizeof(RGNDATAHEADER) + count * sizeof(RECT))))
+        return E_OUTOFMEMORY;
+    memset(data, 0, sizeof(RGNDATAHEADER));
+    data->rdh.dwSize = sizeof(RGNDATAHEADER);
+    data->rdh.iType = RDH_RECTANGLES;
+    data->rdh.nCount = count;
+    data->rdh.nRgnSize = count * sizeof(RECT);
+    if (count)
+    {
+        memcpy(data->Buffer, dest, sizeof(RECT));
+        data->rdh.rcBound = *dest;
+    }
+    *region = data;
+    return S_OK;
 }
 
 static HRESULT WINAPI overlay_GetVideoPosition(IOverlay *iface, RECT *source, RECT *dest)
 {
-    FIXME("iface %p, source %p, dest %p, stub!\n", iface, source, dest);
-    return E_NOTIMPL;
+    struct video_renderer *filter = impl_from_IOverlay(iface);
+
+    TRACE("filter %p, source %p, dest %p.\n", filter, source, dest);
+
+    if (!source || !dest)
+        return E_POINTER;
+
+    overlay_get_rects(filter, source, dest);
+    return S_OK;
 }
 
 static HRESULT WINAPI overlay_Advise(IOverlay *iface, IOverlayNotify *sink, DWORD flags)
 {
-    FIXME("iface %p, sink %p, flags %#lx, stub!\n", iface, sink, flags);
-    return E_NOTIMPL;
+    struct video_renderer *filter = impl_from_IOverlay(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("filter %p, sink %p, flags %#lx.\n", filter, sink, flags);
+
+    if (!sink)
+        return E_POINTER;
+    if (flags & ~ADVISE_ALL)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&filter->renderer.filter.filter_cs);
+#ifndef SG_MUTANT_OV_ADVISE
+    if (filter->overlay_sink)
+#else
+    if (0)
+#endif
+    {
+        hr = VFW_E_ADVISE_ALREADY_SET;
+    }
+    else
+    {
+        IOverlayNotify_AddRef(filter->overlay_sink = sink);
+        filter->overlay_flags = flags;
+    }
+    LeaveCriticalSection(&filter->renderer.filter.filter_cs);
+    return hr;
 }
 
 static HRESULT WINAPI overlay_Unadvise(IOverlay *iface)
 {
-    FIXME("iface %p, stub!\n", iface);
-    return E_NOTIMPL;
+    struct video_renderer *filter = impl_from_IOverlay(iface);
+    IOverlayNotify *sink;
+
+    TRACE("filter %p.\n", filter);
+
+    EnterCriticalSection(&filter->renderer.filter.filter_cs);
+    sink = filter->overlay_sink;
+    filter->overlay_sink = NULL;
+    filter->overlay_flags = 0;
+    LeaveCriticalSection(&filter->renderer.filter.filter_cs);
+
+    if (!sink)
+        return VFW_E_NO_ADVISE_SET;
+    IOverlayNotify_Release(sink);
+    return S_OK;
 }
 
 static const IOverlayVtbl overlay_vtbl =
