From: Stained Glass OS <dev@stained-glass.example>
Subject: d2d1: a premultiplied DC render target composites onto its DC

ID2D1DCRenderTarget drew into a bitmap that started transparent black and
BitBlt'ed all of it over the DC: whatever a program did not draw inside the
bound rectangle became black. LibreOffice prints (and, without Skia, shows)
its text through a premultiplied DC render target bound to each line's
bounds and never clears it -- every printed line came out as a black box.

A premultiplied target now starts each BeginDraw transparent and is
composited with GdiAlphaBlend at EndDraw, so only what was drawn reaches the
DC (Wine's own d2d1 tests, written against Windows, still hold: a full
opaque Clear is a copy). D2D1_ALPHA_MODE_IGNORE keeps the opaque BitBlt.

Gate: test/dcrt-print-gate.sh (screen half).
---
--- a/dlls/d2d1/dc_render_target.c
+++ b/dlls/d2d1/dc_render_target.c
@@ -43,8 +43,21 @@
         return S_OK;
     }
 
-    BitBlt(render_target->hdc, dst_rect->left, dst_rect->top, dst_rect->right - dst_rect->left,
-            dst_rect->bottom - dst_rect->top, src_hdc, 0, 0, SRCCOPY);
+    /* A premultiplied target is composited onto what the DC already holds,
+     * as Windows does: an application that only draws text (LibreOffice's
+     * DirectWrite renderer, printing included) must not paint a black box
+     * over the rest of the rectangle. */
+    if (render_target->desc.pixelFormat.alphaMode == D2D1_ALPHA_MODE_PREMULTIPLIED)
+    {
+        BLENDFUNCTION blend = {AC_SRC_OVER, 0, 255, AC_SRC_ALPHA};
+
+        GdiAlphaBlend(render_target->hdc, dst_rect->left, dst_rect->top, dst_rect->right - dst_rect->left,
+                dst_rect->bottom - dst_rect->top, src_hdc, 0, 0, dst_rect->right - dst_rect->left,
+                dst_rect->bottom - dst_rect->top, blend);
+    }
+    else
+        BitBlt(render_target->hdc, dst_rect->left, dst_rect->top, dst_rect->right - dst_rect->left,
+                dst_rect->bottom - dst_rect->top, src_hdc, 0, 0, SRCCOPY);
 
     SetRectEmpty(&empty_rect);
     IDXGISurface1_ReleaseDC(render_target->dxgi_surface, &empty_rect);
@@ -590,6 +603,13 @@
     TRACE("iface %p.\n", iface);
 
     ID2D1RenderTarget_BeginDraw(render_target->dxgi_target);
+    /* Start from transparent: what is not drawn leaves the DC as it was. */
+    if (render_target->desc.pixelFormat.alphaMode == D2D1_ALPHA_MODE_PREMULTIPLIED)
+    {
+        static const D2D1_COLOR_F transparent;
+
+        ID2D1RenderTarget_Clear(render_target->dxgi_target, &transparent);
+    }
 }
 
 static HRESULT STDMETHODCALLTYPE d2d_dc_render_target_EndDraw(ID2D1DCRenderTarget *iface,
