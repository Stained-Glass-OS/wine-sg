From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: the font set of a collection does not count as a reference of the factory

IDWriteFontCollection1::GetFontSet made a set that kept a reference of the factory; the Wine
tests (EXPECT_REF on the collection and the factory) record that native leaves both counts
as they were (the set of IDWriteFactory3::GetSystemFontSet does hold one). Patch 2635 had
marked those checks todo; they hold again and the marks are gone.

 - The factory counts objects that must keep it alive without being references of it
   (internal references); when the last reference goes while one of those is left the factory
   is freed only when the set is released.
 - The set made by a collection takes such an internal reference in place of a reference.
---
--- a/dlls/dwrite/dwrite_private.h
+++ b/dlls/dwrite/dwrite_private.h
@@ -319,6 +319,8 @@ extern HRESULT create_text_format(const WCHAR *family_name, IDWriteFontCollectio
         DWRITE_FONT_STYLE style, DWRITE_FONT_STRETCH stretch, float size, const WCHAR *locale, REFIID riid,
         void **out);
 extern HRESULT create_textlayout(const struct textlayout_desc*,IDWriteTextLayout**);
+extern void factory_add_internal_ref(IDWriteFactory7 *factory);
+extern void factory_release_internal_ref(IDWriteFactory7 *factory);
 extern HRESULT create_trimmingsign(IDWriteFactory7 *factory, IDWriteTextFormat *format,
         IDWriteInlineObject **sign);
 extern HRESULT create_typography(IDWriteTypography**);
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -518,6 +518,7 @@ struct dwrite_fontset
     IDWriteFontSet3 IDWriteFontSet3_iface;
     LONG refcount;
     IDWriteFactory7 *factory;
+    BOOL weak_factory;         /* the set does not count as a reference of the factory */
 
     struct dwrite_fontset_entry **entries;
     unsigned int count;
@@ -3625,6 +3626,17 @@ static HRESULT fontcollection_get_fontset(struct dwrite_fontcollection *collecti
     }
     hr = fontset_create_from_font_data(collection->factory, fonts, count, fontset);
     free(fonts);
+#ifndef SG_MUTANT_DWSET_FACTORY_REF
+    if (SUCCEEDED(hr))
+    {
+        /* the set of a collection leaves the references of the factory as they were */
+        struct dwrite_fontset *set = CONTAINING_RECORD(*fontset, struct dwrite_fontset, IDWriteFontSet3_iface);
+
+        factory_add_internal_ref(set->factory);
+        set->weak_factory = TRUE;
+        IDWriteFactory7_Release(set->factory);
+    }
+#endif
     return hr;
 }
 
@@ -8245,7 +8257,10 @@ static ULONG WINAPI dwritefontset_Release(IDWriteFontSet3 *iface)
 
     if (!refcount)
     {
-        IDWriteFactory7_Release(set->factory);
+        if (set->weak_factory)
+            factory_release_internal_ref(set->factory);
+        else
+            IDWriteFactory7_Release(set->factory);
         for (i = 0; i < set->count; ++i)
             release_fontset_entry(set->entries[i]);
         free(set->entries);
--- a/dlls/dwrite/main.c
+++ b/dlls/dwrite/main.c
@@ -596,6 +596,7 @@ struct dwritefactory
 {
     IDWriteFactory7 IDWriteFactory7_iface;
     LONG refcount;
+    LONG internal_refs; /* objects that need the factory alive but are not counted in its references */
 
     IDWriteFontCollection *system_collections[DWRITE_FONT_FAMILY_MODEL_WEIGHT_STRETCH_STYLE + 1];
     IDWriteFontCollection1 *eudc_collection;
@@ -778,12 +779,27 @@ static ULONG WINAPI dwritefactory_Release(IDWriteFactory7 *iface)
 
     TRACE("%p, refcount %lu.\n", iface, refcount);
 
-    if (!refcount)
+    if (!refcount && !InterlockedCompareExchange(&factory->internal_refs, 0, 0))
         release_dwritefactory(factory);
 
     return refcount;
 }
 
+void factory_add_internal_ref(IDWriteFactory7 *iface)
+{
+    struct dwritefactory *factory = impl_from_IDWriteFactory7(iface);
+
+    InterlockedIncrement(&factory->internal_refs);
+}
+
+void factory_release_internal_ref(IDWriteFactory7 *iface)
+{
+    struct dwritefactory *factory = impl_from_IDWriteFactory7(iface);
+
+    if (!InterlockedDecrement(&factory->internal_refs) && !InterlockedCompareExchange(&factory->refcount, 0, 0))
+        release_dwritefactory(factory);
+}
+
 static HRESULT WINAPI dwritefactory_GetSystemFontCollection(IDWriteFactory7 *iface,
         IDWriteFontCollection **collection, BOOL check_for_updates)
 {
--- a/dlls/dwrite/tests/font.c
+++ b/dlls/dwrite/tests/font.c
@@ -2606,7 +2606,7 @@ static void test_system_fontcollection(void)
         ok(hr == S_OK, "Failed to get fontset, hr %#lx.\n", hr);
     if (hr == S_OK) {
         EXPECT_REF(collection1, 2);
-        todo_wine EXPECT_REF(factory, 2);
+        EXPECT_REF(factory, 2);
         EXPECT_REF(fontset, 1);
 
         hr = IDWriteFontCollection1_GetFontSet(collection1, &fontset2);
@@ -2618,12 +2618,12 @@ static void test_system_fontcollection(void)
         hr = IDWriteFactory_QueryInterface(factory, &IID_IDWriteFactory3, (void **)&factory3);
         ok(hr == S_OK, "Failed to get IDWriteFactory3 interface, hr %#lx.\n", hr);
 
-        todo_wine EXPECT_REF(factory, 3);
+        EXPECT_REF(factory, 3);
         hr = IDWriteFactory3_GetSystemFontSet(factory3, &fontset2);
         ok(hr == S_OK, "Failed to get system font set, hr %#lx.\n", hr);
         ok(fontset != fontset2, "Expected new fontset instance.\n");
         EXPECT_REF(fontset2, 1);
-        todo_wine EXPECT_REF(factory, 4);
+        EXPECT_REF(factory, 4);
 
         IDWriteFontSet_Release(fontset2);
         IDWriteFontSet_Release(fontset);
