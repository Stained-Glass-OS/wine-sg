From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:18:06 -0700
Subject: [PATCH] riched20: ShowObject scrolls to the object, OnShowWindow
 shades it (3257)

Finishes the client site of 3255, which only answered S_OK.

- IOleClientSite::ShowObject finds the inserted object of the site and
  scrolls the editor so that the object is visible (the same rule as the
  caret), as documented.
- IOleClientSite::OnShowWindow(TRUE) marks the object as open in its own
  window and the editor draws it shaded (every other pixel painted
  white); OnShowWindow(FALSE) removes the shading.

diff --git a/dlls/riched20/caret.c b/dlls/riched20/caret.c
index 9b94bcb..b2e8889 100644
--- a/dlls/riched20/caret.c
+++ b/dlls/riched20/caret.c
@@ -453,6 +453,7 @@ static struct re_object* create_re_object(const REOBJECT *reo, ME_Run *run)
   }
   ME_CopyReObject(&reobj->obj, reo, REO_GETOBJ_ALL_INTERFACES);
   reobj->run = run;
+  reobj->shaded = FALSE;
   return reobj;
 }
 
diff --git a/dlls/riched20/editstr.h b/dlls/riched20/editstr.h
index 6418113..79d3f78 100644
--- a/dlls/riched20/editstr.h
+++ b/dlls/riched20/editstr.h
@@ -154,6 +154,7 @@ struct re_object
   struct list entry;
   REOBJECT obj;
   struct tagME_Run *run; /* ptr to the reobj's run */
+  BOOL shaded; /* IOleClientSite::OnShowWindow(TRUE): the object is open in its own window */
 };
 
 typedef struct tagME_Run
diff --git a/dlls/riched20/richole.c b/dlls/riched20/richole.c
index 9236a39..265b40b 100644
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -1054,25 +1054,59 @@ static HRESULT WINAPI IOleClientSite_fnGetContainer(IOleClientSite *iface,
     return E_NOTIMPL;
 }
 
+/* the object of the editor that this site was given to, if it has been inserted */
+static struct re_object *client_site_object( IOleClientSiteImpl *site )
+{
+    struct re_object *reobj;
+
+    LIST_FOR_EACH_ENTRY( reobj, &site->child.reole->editor->reobj_list, struct re_object, entry )
+        if (reobj->obj.polesite == &site->IOleClientSite_iface) return reobj;
+    return NULL;
+}
+
 static HRESULT WINAPI IOleClientSite_fnShowObject(IOleClientSite *iface)
 {
     IOleClientSiteImpl *This = impl_from_IOleClientSite(iface);
+    struct re_object *reobj;
+    ME_Cursor cursor;
+
     if (!This->child.reole)
         return CO_E_RELEASED;
 
     TRACE("%p\n", iface);
-    /* the container has nothing to bring into view: the object is in the editor's window */
+
+#ifdef SG_MUTANT_RE_SHOWOBJECT
+    return S_OK;
+#endif
+    /* bring the object into the visible part of the editor's window */
+    if ((reobj = client_site_object( This )) && reobj->run)
+    {
+        cursor_from_char_ofs( This->child.reole->editor, run_char_ofs( reobj->run, 0 ), &cursor );
+        editor_ensure_visible( This->child.reole->editor, &cursor );
+    }
     return S_OK;
 }
 
 static HRESULT WINAPI IOleClientSite_fnOnShowWindow(IOleClientSite *iface, BOOL fShow)
 {
     IOleClientSiteImpl *This = impl_from_IOleClientSite(iface);
+    struct re_object *reobj;
+
     if (!This->child.reole)
         return CO_E_RELEASED;
 
     TRACE("%p %d\n", iface, fShow);
-    /* the notification asks the container to shade the object while it is open in its own window: nothing is drawn shaded */
+
+#ifdef SG_MUTANT_RE_ONSHOWWINDOW
+    return S_OK;
+#endif
+    /* the object is open in its own window: draw it shaded until that window closes */
+    if ((reobj = client_site_object( This )) && reobj->shaded != !!fShow)
+    {
+        reobj->shaded = !!fShow;
+        ITextHost_TxInvalidateRect( This->child.reole->editor->texthost, NULL, TRUE );
+        ME_Repaint( This->child.reole->editor );
+    }
     return S_OK;
 }
 
@@ -7785,6 +7819,27 @@ void ME_GetOLEObjectSize(const ME_Context *c, ME_Run *run, SIZE *pSize)
   }
 }
 
+/* an object open in its own window is drawn with every other pixel painted white */
+static void shade_object( HDC hdc, const RECTL *bounds )
+{
+    static const WORD pattern[8] = { 0xaa, 0x55, 0xaa, 0x55, 0xaa, 0x55, 0xaa, 0x55 };
+    HBITMAP bitmap = CreateBitmap( 8, 8, 1, 1, pattern );
+    HBRUSH brush = CreatePatternBrush( bitmap ), old;
+    COLORREF text = SetTextColor( hdc, RGB(0,0,0) ), back = SetBkColor( hdc, RGB(255,255,255) );
+
+    if (brush)
+    {
+        old = SelectObject( hdc, brush );
+        /* destination OR pattern: the pattern's white pixels hide the object */
+        PatBlt( hdc, bounds->left, bounds->top, bounds->right - bounds->left, bounds->bottom - bounds->top, 0xfa0089 );
+        SelectObject( hdc, old );
+        DeleteObject( brush );
+    }
+    SetTextColor( hdc, text );
+    SetBkColor( hdc, back );
+    DeleteObject( bitmap );
+}
+
 void draw_ole( ME_Context *c, int x, int y, ME_Run *run, BOOL selected )
 {
   IDataObject*  ido;
@@ -7826,6 +7881,7 @@ void draw_ole( ME_Context *c, int x, int y, ME_Run *run, BOOL selected )
     {
       WARN("failed to draw object: %#08lx\n", hr);
     }
+    if (run->reobj->shaded) shade_object( c->hDC, &bounds );
 
     IViewObject_Release(ivo);
     return;
