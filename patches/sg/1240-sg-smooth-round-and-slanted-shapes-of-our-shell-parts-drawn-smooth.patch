From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer, notepad, user32, comctl32, shell32, windows.ui: our round and slanted shapes are drawn smooth

GDI draws rounded rectangles, ellipses, polygons and slanted lines without
antialiasing, and the shell parts we draw ourselves used them for their
glyphs and round shapes: the Rounded taskbar's search box, plates and
pills, the Horizon and Glass buttons' outlines, File Explorer's and
Notepad's tabs and the tabs' close marks, the flat drop-down lists'
chevrons (user32 and comctl32), the list view groups' chevrons, the file
conflict dialog's choice glyphs and a toast's close mark. All had stepped
edges, the more visible at 150% and above (David 2026-10-06: review all
the icons we draw and get them rendered at a better resolution).

include/wine/sg_smooth.h draws such a shape four times larger over a copy
of what is already there and averages it down: the same pixels covered,
with soft edges (a large rounded rectangle's straight edges stay GDI's
own; only its corners are supersampled). Drop-ins take GDI's arguments
(sgs_round_rect, sgs_ellipse, sgs_polygon, sgs_polyline, sgs_arc,
sgs_line); a glyph drawn with several calls is drawn in a region
(sgs_begin/sgs_end). sg-shell's src/sg-smooth.h is the shell's copy.

Test: test/smoothshapes-gate.sh with test/smoothshapes-combo.c (mutant
SG_MUTANT_JAGGED at the top of explorer/systray.c, explorer/fileexplorer.c,
notepad/main.c and user32/combo.c fails each of its four checks).
---
--- a/include/Makefile.in
+++ b/include/Makefile.in
@@ -960,6 +960,7 @@
 	wine/server.h \
 	wine/server_protocol.h \
 	wine/sgnetctl.h \
+	wine/sg_smooth.h \
 	wine/sgshellnew.h \
 	wine/strmbase.h \
 	wine/svcctl.idl \
--- /dev/null
+++ b/include/wine/sg_smooth.h
@@ -0,0 +1,327 @@
+/*
+ * Stained Glass OS: soft-edged GDI shapes for our own drawing
+ *
+ * GDI draws ellipses, rounded rectangles, polygons, arcs and slanted lines
+ * without antialiasing, so the glyphs and round shapes our shell parts draw
+ * with them (the taskbar's plates and pills, File Explorer's tab marks,
+ * drop-down chevrons, toast and dialog glyphs) had stepped edges, the worse
+ * on a scaled screen. These draw the same shape SGS_SS times larger over a
+ * copy of what is already there, and average it down: the same pixels
+ * covered, with soft edges. sg-shell's src/sg-smooth.h is the shell's copy.
+ *
+ *   Drop-ins, with the pen and brush selected into hdc, GDI's arguments:
+ *       sgs_ellipse, sgs_round_rect         (bounding box: pixel edges)
+ *       sgs_polygon, sgs_polyline, sgs_line (points: pixel centres)
+ *       sgs_arc
+ *   A region, for a glyph drawn with several calls:
+ *       struct sgs_region rg;
+ *       HDC big = sgs_begin( &rg, hdc, x, y, w, h, stroke );
+ *       ... draw on big at hdc's coordinates; pens selected into big after
+ *       sgs_begin are scaled; stroke: the glyph's line width ...
+ *       sgs_end( &rg );
+ *
+ * SG_MUTANT_JAGGED (defined before including this): plain GDI, as before.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef __WINE_SG_SMOOTH_H
+#define __WINE_SG_SMOOTH_H
+
+#include <stdlib.h>
+#include <string.h>
+#include <windef.h>
+#include <wingdi.h>
+
+#define SGS_SS 4
+
+struct sgs_region { HDC dc, big; HBITMAP bmp, old; HPEN own_pen; BYTE *bits; int x, y, w, h; };
+
+/* hdc's current pen, SGS_SS times wider, for the big DC (width 0 is 1) */
+static inline HPEN sgs_big_pen( HDC hdc, BOOL inside )
+{
+    HPEN pen = GetCurrentObject( hdc, OBJ_PEN );
+    LOGBRUSH lb = { BS_SOLID, 0, 0 };
+    DWORD style, width;
+    EXTLOGPEN elp;
+    LOGPEN lp;
+
+    if (GetObjectType( pen ) == OBJ_EXTPEN && GetObjectW( pen, sizeof(elp), &elp ))
+    {
+        style = elp.elpPenStyle; width = elp.elpWidth; lb.lbColor = elp.elpColor;
+        if (!(style & PS_GEOMETRIC)) width = 1;
+    }
+    else if (GetObjectW( pen, sizeof(lp), &lp ))
+    {
+        style = lp.lopnStyle | PS_ENDCAP_ROUND | PS_JOIN_ROUND; width = lp.lopnWidth.x; lb.lbColor = lp.lopnColor;
+    }
+    else return NULL;
+    if (pen == GetStockObject( DC_PEN )) lb.lbColor = GetDCPenColor( hdc );
+    if ((style & PS_STYLE_MASK) == PS_NULL) return NULL;
+    if (!width) width = 1;
+    style = (style & ~(PS_TYPE_MASK | PS_STYLE_MASK)) | PS_GEOMETRIC |
+            (inside ? PS_INSIDEFRAME : (style & PS_STYLE_MASK) == PS_INSIDEFRAME ? PS_SOLID : (style & PS_STYLE_MASK));
+    return ExtCreatePen( style, width * SGS_SS, &lb, 0, NULL );
+}
+
+static inline int sgs_pen_width( HDC hdc )
+{
+    HPEN pen = GetCurrentObject( hdc, OBJ_PEN );
+    EXTLOGPEN elp;
+    LOGPEN lp;
+
+    if (GetObjectType( pen ) == OBJ_EXTPEN && GetObjectW( pen, sizeof(elp), &elp ))
+        return (elp.elpPenStyle & PS_STYLE_MASK) == PS_NULL ? 0 : (elp.elpPenStyle & PS_GEOMETRIC) ? (int)elp.elpWidth : 1;
+    if (GetObjectW( pen, sizeof(lp), &lp )) return (lp.lopnStyle & PS_STYLE_MASK) == PS_NULL ? 0 : max( 1, lp.lopnWidth.x );
+    return 1;
+}
+
+/* a big DC over (x, y, w, h) of hdc, what is there copied up */
+static inline HDC sgs_open( struct sgs_region *rg, HDC hdc, int x, int y, int w, int h )
+{
+    BITMAPINFO bi;
+
+    memset( rg, 0, sizeof(*rg) );
+    rg->dc = hdc; rg->x = x; rg->y = y; rg->w = w; rg->h = h;
+    if (w <= 0 || h <= 0 || w > 4096 || h > 4096) return NULL;
+    memset( &bi, 0, sizeof(bi) );
+    bi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    bi.bmiHeader.biWidth = w * SGS_SS;
+    bi.bmiHeader.biHeight = -h * SGS_SS;
+    bi.bmiHeader.biPlanes = 1;
+    bi.bmiHeader.biBitCount = 32;
+    if (!(rg->big = CreateCompatibleDC( hdc ))) return NULL;
+    if (!(rg->bmp = CreateDIBSection( hdc, &bi, DIB_RGB_COLORS, (void **)&rg->bits, NULL, 0 )))
+    {
+        DeleteDC( rg->big );
+        rg->big = NULL;
+        return NULL;
+    }
+    rg->old = SelectObject( rg->big, rg->bmp );
+    SetStretchBltMode( rg->big, COLORONCOLOR );
+    StretchBlt( rg->big, 0, 0, w * SGS_SS, h * SGS_SS, hdc, x, y, w, h, SRCCOPY );
+    SetBkMode( rg->big, GetBkMode( hdc ));
+    SetBkColor( rg->big, GetBkColor( hdc ));
+    SetTextColor( rg->big, GetTextColor( hdc ));
+    SetPolyFillMode( rg->big, GetPolyFillMode( hdc ));
+    SetArcDirection( rg->big, GetArcDirection( hdc ));
+    SetDCBrushColor( rg->big, GetDCBrushColor( hdc ));
+    SetDCPenColor( rg->big, GetDCPenColor( hdc ));
+    SelectObject( rg->big, GetCurrentObject( hdc, OBJ_BRUSH ));
+    return rg->big;
+}
+
+static inline void sgs_end( struct sgs_region *rg )
+{
+    BITMAPINFO bi;
+    HDC sdc;
+    HBITMAP sbmp, sold;
+    BYTE *sbits;
+    int px, py, sx, sy, n = SGS_SS * SGS_SS, W = rg->w * SGS_SS;
+
+    if (!rg->big) return;
+    GdiFlush();
+    memset( &bi, 0, sizeof(bi) );
+    bi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    bi.bmiHeader.biWidth = rg->w;
+    bi.bmiHeader.biHeight = -rg->h;
+    bi.bmiHeader.biPlanes = 1;
+    bi.bmiHeader.biBitCount = 32;
+    sdc = CreateCompatibleDC( rg->dc );
+    sbmp = CreateDIBSection( rg->dc, &bi, DIB_RGB_COLORS, (void **)&sbits, NULL, 0 );
+    if (sdc && sbmp)
+    {
+        sold = SelectObject( sdc, sbmp );
+        for (py = 0; py < rg->h; py++)
+            for (px = 0; px < rg->w; px++)
+            {
+                unsigned int c[3] = { 0, 0, 0 };
+                BYTE *out = sbits + (py * rg->w + px) * 4;
+                for (sy = 0; sy < SGS_SS; sy++)
+                    for (sx = 0; sx < SGS_SS; sx++)
+                    {
+                        const BYTE *p = rg->bits + ((py * SGS_SS + sy) * W + px * SGS_SS + sx) * 4;
+                        c[0] += p[0]; c[1] += p[1]; c[2] += p[2];
+                    }
+                out[0] = (c[0] + n / 2) / n; out[1] = (c[1] + n / 2) / n; out[2] = (c[2] + n / 2) / n; out[3] = 255;
+            }
+        BitBlt( rg->dc, rg->x, rg->y, rg->w, rg->h, sdc, 0, 0, SRCCOPY );
+        SelectObject( sdc, sold );
+    }
+    if (sbmp) DeleteObject( sbmp );
+    if (sdc) DeleteDC( sdc );
+    SelectObject( rg->big, GetStockObject( BLACK_PEN ));
+    SelectObject( rg->big, GetStockObject( WHITE_BRUSH ));
+    if (rg->own_pen) DeleteObject( rg->own_pen );
+    SelectObject( rg->big, rg->old );
+    DeleteObject( rg->bmp );
+    DeleteDC( rg->big );
+    rg->big = NULL;
+}
+
+static inline HDC sgs_begin( struct sgs_region *rg, HDC hdc, int x, int y, int w, int h, int stroke )
+{
+#ifndef SG_MUTANT_JAGGED
+    /* a line of odd width is centred on a pixel's centre, of even width on its edge */
+    int o = stroke % 2 ? SGS_SS / 2 : 0;
+    XFORM xf = { (FLOAT)SGS_SS, 0, 0, (FLOAT)SGS_SS, (FLOAT)(-x * SGS_SS + o), (FLOAT)(-y * SGS_SS + o) };
+    HDC big = sgs_open( rg, hdc, x, y, w, h );
+
+    if (!big) return hdc;
+    SetGraphicsMode( big, GM_ADVANCED );
+    SetWorldTransform( big, &xf );
+    SelectObject( big, GetCurrentObject( hdc, OBJ_PEN ));
+    return big;
+#else
+    memset( rg, 0, sizeof(*rg) );
+    return hdc;
+#endif
+}
+
+/* a big DC round a shape's box, with hdc's pen made big; ox, oy: its origin */
+static inline HDC sgs_shape( struct sgs_region *rg, HDC hdc, int l, int t, int r, int b, BOOL inside, int *ox, int *oy )
+{
+    int m = sgs_pen_width( hdc ) + 2;
+    HDC big;
+
+    *ox = min( l, r ) - m;
+    *oy = min( t, b ) - m;
+    if (!(big = sgs_open( rg, hdc, *ox, *oy, abs( r - l ) + 2 * m + 1, abs( b - t ) + 2 * m + 1 ))) return NULL;
+    rg->own_pen = sgs_big_pen( hdc, inside );
+    SelectObject( big, rg->own_pen ? (HGDIOBJ)rg->own_pen : GetStockObject( NULL_PEN ));
+    return big;
+}
+
+#define SGS_E(v, o) (((v) - (o)) * SGS_SS)                 /* a box edge in big pixels */
+#define SGS_P(v, o) (((v) - (o)) * SGS_SS + SGS_SS / 2)    /* a point: a pixel's centre */
+
+static inline BOOL sgs_ellipse( HDC hdc, int l, int t, int r, int b )
+{
+#ifndef SG_MUTANT_JAGGED
+    struct sgs_region rg;
+    int ox, oy;
+    HDC big = sgs_shape( &rg, hdc, l, t, r, b, TRUE, &ox, &oy );
+
+    if (big)
+    {
+        Ellipse( big, SGS_E(l, ox), SGS_E(t, oy), SGS_E(r, ox), SGS_E(b, oy) );
+        sgs_end( &rg );
+        return TRUE;
+    }
+#endif
+    return Ellipse( hdc, l, t, r, b );
+}
+
+static inline BOOL sgs_round_rect( HDC hdc, int l, int t, int r, int b, int rw, int rh )
+{
+#ifndef SG_MUTANT_JAGGED
+    struct sgs_region rg;
+    int ox, oy, pw = sgs_pen_width( hdc );
+    int cw = min( abs( r - l ), rw / 2 + pw + 2 ), ch = min( abs( b - t ), rh / 2 + pw + 2 );
+    HDC big;
+
+    /* a big one: GDI draws all but the corners (straight edges are not stepped) */
+    if (r > l && b > t && r - l > 2 * cw + 8 && b - t > 2 * ch + 8)
+    {
+        int i, cx[4], cy[4], saved = SaveDC( hdc );
+
+        cx[0] = cx[2] = l; cx[1] = cx[3] = r - cw;
+        cy[0] = cy[1] = t; cy[2] = cy[3] = b - ch;
+        for (i = 0; i < 4; i++) ExcludeClipRect( hdc, cx[i], cy[i], cx[i] + cw, cy[i] + ch );
+        RoundRect( hdc, l, t, r, b, rw, rh );
+        RestoreDC( hdc, saved );
+        for (i = 0; i < 4; i++)
+        {
+            if (!(big = sgs_open( &rg, hdc, cx[i], cy[i], cw, ch ))) continue;
+            rg.own_pen = sgs_big_pen( hdc, TRUE );
+            SelectObject( big, rg.own_pen ? (HGDIOBJ)rg.own_pen : GetStockObject( NULL_PEN ));
+            RoundRect( big, SGS_E(l, cx[i]), SGS_E(t, cy[i]), SGS_E(r, cx[i]), SGS_E(b, cy[i]), rw * SGS_SS, rh * SGS_SS );
+            sgs_end( &rg );
+        }
+        return TRUE;
+    }
+    if ((big = sgs_shape( &rg, hdc, l, t, r, b, TRUE, &ox, &oy )))
+    {
+        RoundRect( big, SGS_E(l, ox), SGS_E(t, oy), SGS_E(r, ox), SGS_E(b, oy), rw * SGS_SS, rh * SGS_SS );
+        sgs_end( &rg );
+        return TRUE;
+    }
+#endif
+    return RoundRect( hdc, l, t, r, b, rw, rh );
+}
+
+/* an arc: GDI's pen runs along the pixels just inside the box */
+static inline BOOL sgs_arc( HDC hdc, int l, int t, int r, int b, int x1, int y1, int x2, int y2 )
+{
+#ifndef SG_MUTANT_JAGGED
+    struct sgs_region rg;
+    int ox, oy;
+    HDC big = sgs_shape( &rg, hdc, l, t, r, b, FALSE, &ox, &oy );
+
+    if (big)
+    {
+        Arc( big, SGS_E(l, ox) + SGS_SS / 2, SGS_E(t, oy) + SGS_SS / 2, SGS_E(r, ox) - SGS_SS / 2, SGS_E(b, oy) - SGS_SS / 2,
+             SGS_P(x1, ox), SGS_P(y1, oy), SGS_P(x2, ox), SGS_P(y2, oy) );
+        sgs_end( &rg );
+        return TRUE;
+    }
+#endif
+    return Arc( hdc, l, t, r, b, x1, y1, x2, y2 );
+}
+
+static inline BOOL sgs_points( HDC hdc, const POINT *p, int n, BOOL fill )
+{
+#ifndef SG_MUTANT_JAGGED
+    struct sgs_region rg;
+    POINT few[64], *q;
+    int i, l, t, r, b, ox, oy;
+    HDC big;
+
+    if (n <= 0) return FALSE;
+    if (!(q = n <= 64 ? few : malloc( n * sizeof(POINT) ))) return FALSE;
+    l = r = p[0].x; t = b = p[0].y;
+    for (i = 1; i < n; i++)
+    {
+        l = min( l, p[i].x ); r = max( r, p[i].x );
+        t = min( t, p[i].y ); b = max( b, p[i].y );
+    }
+    if ((big = sgs_shape( &rg, hdc, l, t, r, b, FALSE, &ox, &oy )))
+    {
+        for (i = 0; i < n; i++) { q[i].x = SGS_P(p[i].x, ox); q[i].y = SGS_P(p[i].y, oy); }
+        if (fill) Polygon( big, q, n ); else Polyline( big, q, n );
+        sgs_end( &rg );
+        if (q != few) free( q );
+        return TRUE;
+    }
+    if (q != few) free( q );
+#endif
+    return fill ? Polygon( hdc, p, n ) : Polyline( hdc, p, n );
+}
+
+static inline BOOL sgs_polygon( HDC hdc, const POINT *p, int n ) { return sgs_points( hdc, p, n, TRUE ); }
+static inline BOOL sgs_polyline( HDC hdc, const POINT *p, int n ) { return sgs_points( hdc, p, n, FALSE ); }
+
+/* a line, as MoveToEx and LineTo (the last point not drawn); level and upright ones by GDI */
+static inline void sgs_line( HDC hdc, int x0, int y0, int x1, int y1 )
+{
+    POINT p[2];
+
+    if (x0 != x1 && y0 != y1)
+    {
+        p[0].x = x0; p[0].y = y0; p[1].x = x1; p[1].y = y1;
+        if (sgs_points( hdc, p, 2, FALSE ))
+        {
+            MoveToEx( hdc, x1, y1, NULL );
+            return;
+        }
+    }
+    MoveToEx( hdc, x0, y0, NULL );
+    LineTo( hdc, x1, y1 );
+}
+
+#endif /* __WINE_SG_SMOOTH_H */
