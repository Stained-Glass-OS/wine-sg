+
+/* takes ownership of d on success */
+static HRESULT propdesc_create(struct desc *d, REFIID riid, void **ppv)
+{
+    struct propdesc *obj;
+    HRESULT hr;
+
+    if (!(obj = calloc(1, sizeof(*obj)))) return E_OUTOFMEMORY;
+    obj->IPropertyDescription2_iface.lpVtbl = &propdesc_vtbl;
+    obj->ref = 1;
+    obj->d = *d;
+    hr = IPropertyDescription2_QueryInterface(&obj->IPropertyDescription2_iface, riid, ppv);
+    IPropertyDescription2_Release(&obj->IPropertyDescription2_iface);
+    if (FAILED(hr)) memset(d, 0, sizeof(*d)); /* freed with the object */
+    return hr;
+}
+
+/* ---- IPropertyDescriptionList -------------------------------------------------------- */
+
+struct proplist
+{
+    IPropertyDescriptionList IPropertyDescriptionList_iface;
+    LONG ref;
+    struct desc *descs;
+    UINT count;
+};
+
+static struct proplist *impl_from_IPropertyDescriptionList(IPropertyDescriptionList *iface)
+{
+    return CONTAINING_RECORD(iface, struct proplist, IPropertyDescriptionList_iface);
+}
+
+static HRESULT WINAPI proplist_QueryInterface(IPropertyDescriptionList *iface, REFIID iid, void **out)
+{
+    if (!out) return E_POINTER;
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IPropertyDescriptionList))
+    {
+        *out = iface;
+        IPropertyDescriptionList_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI proplist_AddRef(IPropertyDescriptionList *iface)
+{
+    return InterlockedIncrement(&impl_from_IPropertyDescriptionList(iface)->ref);
+}
+
+static ULONG WINAPI proplist_Release(IPropertyDescriptionList *iface)
+{
+    struct proplist *This = impl_from_IPropertyDescriptionList(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        UINT i;
+        for (i = 0; i < This->count; i++) desc_free(&This->descs[i]);
+        free(This->descs);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI proplist_GetCount(IPropertyDescriptionList *iface, UINT *count)
+{
+    if (!count) return E_POINTER;
+    *count = impl_from_IPropertyDescriptionList(iface)->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI proplist_GetAt(IPropertyDescriptionList *iface, UINT index, REFIID riid, void **ppv)
+{
+    struct proplist *This = impl_from_IPropertyDescriptionList(iface);
+    struct desc copy;
+    HRESULT hr;
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (index >= This->count) return E_INVALIDARG;
+    if (!desc_copy(&copy, &This->descs[index])) return E_OUTOFMEMORY;
+    if (FAILED(hr = propdesc_create(&copy, riid, ppv))) desc_free(&copy);
+    return hr;
+}
+
+static const IPropertyDescriptionListVtbl proplist_vtbl =
+{
+    proplist_QueryInterface,
+    proplist_AddRef,
+    proplist_Release,
+    proplist_GetCount,
+    proplist_GetAt,
+};
+
+static HRESULT proplist_create(struct desc *descs, UINT count, REFIID riid, void **ppv)
+{
+    struct proplist *obj;
+    HRESULT hr;
+
+    if (!(obj = calloc(1, sizeof(*obj))))
+    {
+        UINT i;
+        for (i = 0; i < count; i++) desc_free(&descs[i]);
+        free(descs);
+        return E_OUTOFMEMORY;
+    }
+    obj->IPropertyDescriptionList_iface.lpVtbl = &proplist_vtbl;
+    obj->ref = 1;
+    obj->descs = descs;
+    obj->count = count;
+    hr = IPropertyDescriptionList_QueryInterface(&obj->IPropertyDescriptionList_iface, riid, ppv);
+    IPropertyDescriptionList_Release(&obj->IPropertyDescriptionList_iface);
+    return hr;
+}
+
+/* ---- exports ------------------------------------------------------------------------- */
+
+HRESULT WINAPI PSGetPropertyDescription(REFPROPERTYKEY propkey, REFIID riid, void **ppv)
+{
+    struct desc d;
+    HRESULT hr;
+
+    TRACE("%p, %s, %p\n", propkey, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!propkey) return E_POINTER;
+    if (FAILED(hr = desc_lookup_key(propkey, &d))) return hr;
+    if (FAILED(hr = propdesc_create(&d, riid, ppv))) desc_free(&d);
+    return hr;
+}
+
+HRESULT WINAPI PSGetPropertyDescriptionByName(PCWSTR name, REFIID riid, void **ppv)
+{
+    struct desc d;
+    HRESULT hr;
+
+    TRACE("%s, %s, %p\n", debugstr_w(name), debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!name) return E_POINTER;
+    if (FAILED(hr = desc_lookup_name(name, &d))) return hr;
+    if (FAILED(hr = propdesc_create(&d, riid, ppv))) desc_free(&d);
+    return hr;
+}
+
+HRESULT WINAPI PSEnumeratePropertyDescriptions(PROPDESC_ENUMFILTER filter, REFIID riid, void **ppv)
+{
+    struct desc *descs;
+    UINT count = 0, i, cap;
+
+    TRACE("%d, %s, %p\n", filter, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (filter < PDEF_ALL || filter > PDEF_COLUMN) return E_INVALIDARG;
+
+    EnterCriticalSection(&schema_cs);
+    if (!custom_loaded) custom_load();
+    cap = CANONICAL_PROPKEY_COUNT + custom_count;
+    if (!(descs = calloc(cap, sizeof(*descs))))
+    {
+        LeaveCriticalSection(&schema_cs);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < cap; i++)
+    {
+        struct desc cur;
+        BOOL ok, keep = FALSE;
+
+        if (i < custom_count) ok = desc_copy(&cur, &custom_descs[i]);
+        else ok = desc_from_builtin(&cur, i - custom_count);
+        if (!ok) continue;
+        switch (filter)
+        {
+        case PDEF_ALL: keep = TRUE; break;
+        case PDEF_SYSTEM: keep = !!(cur.typeflags & PDTF_ISSYSTEMPROPERTY); break;
+        case PDEF_NONSYSTEM: keep = !(cur.typeflags & PDTF_ISSYSTEMPROPERTY); break;
+        case PDEF_VIEWABLE: keep = !!(cur.typeflags & PDTF_ISVIEWABLE); break;
+        case PDEF_QUERYABLE: keep = !!(cur.typeflags & PDTF_ISQUERYABLE); break;
+        case PDEF_INFULLTEXTQUERY: keep = !!(cur.typeflags & PDTF_INCLUDEINFULLTEXTQUERY); break;
+        case PDEF_COLUMN: keep = (cur.typeflags & PDTF_ISVIEWABLE) && !(cur.typeflags & PDTF_MULTIPLEVALUES); break;
+        }
+        if (keep) descs[count++] = cur;
+        else desc_free(&cur);
+    }
+    LeaveCriticalSection(&schema_cs);
+    return proplist_create(descs, count, riid, ppv);
+}
+
+HRESULT WINAPI PSGetPropertyDescriptionListFromString(LPCWSTR proplist, REFIID riid, void **ppv)
+{
+    struct desc *descs = NULL;
+    UINT count = 0;
+    WCHAR *copy, *p, *tok, *next;
+    HRESULT hr = S_OK;
+
+    TRACE("%s, %s, %p\n", debugstr_w(proplist), debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!proplist) return E_POINTER;
+    if (!(copy = dup_string(proplist))) return E_OUTOFMEMORY;
+
+    p = copy;
+    while (iswspace(*p)) p++;
+    if (!wcsnicmp(p, L"prop:", 5)) p += 5;
+
+    for (tok = p; tok && *tok; tok = next)
+    {
+        struct desc d, *n;
+        WCHAR *end;
+        PROPERTYKEY key;
+
+        next = wcschr(tok, ';');
+        if (next) *next++ = 0;
+        while (iswspace(*tok)) tok++;
+        end = tok + wcslen(tok);
+        while (end > tok && iswspace(end[-1])) *--end = 0;
+        while (*tok == '-' || *tok == '*' || *tok == '~') tok++;
+        if (!*tok) continue;
+
+        if (*tok == '{' && SUCCEEDED(PSPropertyKeyFromString(tok, &key))) hr = desc_lookup_key(&key, &d);
+        else hr = desc_lookup_name(tok, &d);
+        if (FAILED(hr)) break;
+        if (!(n = realloc(descs, (count + 1) * sizeof(*descs))))
+        {
+            desc_free(&d);
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+        descs = n;
+        descs[count++] = d;
+    }
+    free(copy);
+    if (FAILED(hr))
+    {
+        UINT i;
+        for (i = 0; i < count; i++) desc_free(&descs[i]);
+        free(descs);
+        return hr;
+    }
+    return proplist_create(descs, count, riid, ppv);
+}
+
+HRESULT WINAPI PSCoerceToCanonicalValue(REFPROPERTYKEY key, PROPVARIANT *pv)
+{
+    struct desc d;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", key, pv);
+
+    if (!key || !pv) return E_POINTER;
+    if (FAILED(hr = desc_lookup_key(key, &d))) return hr;
+    hr = desc_coerce(&d, pv);
+    desc_free(&d);
+    return hr;
+}
+
+HRESULT WINAPI PSFormatForDisplayAlloc(REFPROPERTYKEY key, REFPROPVARIANT pv, PROPDESC_FORMAT_FLAGS flags, WCHAR **text)
+{
+    struct desc d;
+    HRESULT hr;
+
+    TRACE("%p, %p, %#x, %p\n", key, pv, flags, text);
+
+    if (!text) return E_POINTER;
+    *text = NULL;
+    if (!key || !pv) return E_POINTER;
+    if (FAILED(hr = desc_lookup_key(key, &d))) return hr;
+    hr = desc_format(&d, pv, flags, text);
+    desc_free(&d);
+    return hr;
+}
+
+HRESULT WINAPI PSFormatForDisplay(REFPROPERTYKEY key, REFPROPVARIANT pv, PROPDESC_FORMAT_FLAGS flags,
+        WCHAR *buffer, DWORD cch)
+{
+    WCHAR *text;
+    HRESULT hr;
+
+    TRACE("%p, %p, %#x, %p, %lu\n", key, pv, flags, buffer, cch);
+
+    if (!buffer) return E_POINTER;
+    if (cch) buffer[0] = 0;
+    if (FAILED(hr = PSFormatForDisplayAlloc(key, pv, flags, &text))) return hr;
+    if (wcslen(text) + 1 > cch)
+    {
+        if (cch) lstrcpynW(buffer, text, cch);
+        hr = HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+    }
+    else wcscpy(buffer, text);
+    CoTaskMemFree(text);
+    return hr;
+}
+
+HRESULT WINAPI PSFormatPropertyValue(IPropertyStore *store, IPropertyDescription *desc,
+        PROPDESC_FORMAT_FLAGS flags, WCHAR **text)
+{
+    PROPERTYKEY key;
+    PROPVARIANT pv;
+    HRESULT hr;
+
+    TRACE("%p, %p, %#x, %p\n", store, desc, flags, text);
+
+    if (!text) return E_POINTER;
+    *text = NULL;
+    if (!store || !desc) return E_POINTER;
+    if (FAILED(hr = IPropertyDescription_GetPropertyKey(desc, &key))) return hr;
+    PropVariantInit(&pv);
+    if (FAILED(hr = IPropertyStore_GetValue(store, &key, &pv))) return hr;
+    hr = IPropertyDescription_FormatForDisplay(desc, &pv, flags, text);
+    PropVariantClear(&pv);
+    return hr;
+}
+
+HRESULT WINAPI PSGetPropertyValue(IPropertyStore *store, IPropertyDescription *desc, PROPVARIANT *value)
+{
+    PROPERTYKEY key;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", store, desc, value);
+
+    if (!value) return E_POINTER;
+    PropVariantInit(value);
+    if (!store || !desc) return E_POINTER;
+    if (FAILED(hr = IPropertyDescription_GetPropertyKey(desc, &key))) return hr;
+    return IPropertyStore_GetValue(store, &key, value);
+}
+
+HRESULT WINAPI PSSetPropertyValue(IPropertyStore *store, IPropertyDescription *desc, REFPROPVARIANT value)
+{
+    PROPERTYKEY key;
+    PROPVARIANT pv;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", store, desc, value);
+
+    if (!store || !desc || !value) return E_POINTER;
+    if (FAILED(hr = IPropertyDescription_GetPropertyKey(desc, &key))) return hr;
+    if (FAILED(hr = PropVariantCopy(&pv, value))) return hr;
+    if (SUCCEEDED(hr = IPropertyDescription_CoerceToCanonicalValue(desc, &pv)))
+        hr = IPropertyStore_SetValue(store, &key, &pv);
+    PropVariantClear(&pv);
+    return hr;
+}
+
+/* ---- canonical names (moved here from propsys_main.c) -------------------------------- */
+
+HRESULT WINAPI PSGetPropertyKeyFromName(PCWSTR name, PROPERTYKEY *key)
+{
+    const struct canonical_propkey *entry = NULL;
+
+    TRACE("%s, %p\n", debugstr_w(name), key);
+
+    if (!name || !key)
+        return E_POINTER;
+
+#ifndef SG_MUTANT_PROPKEYFROMNAME
+    entry = bsearch(name, canonical_propkeys, CANONICAL_PROPKEY_COUNT,
+            sizeof(canonical_propkeys[0]), canonical_propkey_cmp);
+#endif
+    if (!entry)
+    {
+        struct desc d;
+
+        /* names from registered schema files */
+        if (SUCCEEDED(desc_lookup_name(name, &d)))
+        {
+            *key = d.key;
+            desc_free(&d);
+            return S_OK;
+        }
+        WARN("canonical name %s not found\n", debugstr_w(name));
+        return E_INVALIDARG;
+    }
+
+    *key = entry->key;
+    return S_OK;
+}
+
+HRESULT WINAPI PSGetNameFromPropertyKey(REFPROPERTYKEY key, WCHAR **name)
+{
+    ULONG i;
+    struct desc d;
+
+    TRACE("%p, %p\n", key, name);
+
+    if (!name) return E_POINTER;
+    *name = NULL;
+    if (!key) return E_POINTER;
+
+    for (i = 0; i < CANONICAL_PROPKEY_COUNT; i++)
+    {
+        const struct canonical_propkey *entry = &canonical_propkeys[i];
+        SIZE_T len;
+
+#ifdef SG_MUTANT_PSNAME
+        if (entry->key.pid != key->pid) continue;
+#else
+        if (!IsEqualGUID(&entry->key.fmtid, &key->fmtid) || entry->key.pid != key->pid) continue;
+#endif
+        len = (lstrlenW(entry->name) + 1) * sizeof(WCHAR);
+        if (!(*name = CoTaskMemAlloc(len))) return E_OUTOFMEMORY;
+        memcpy(*name, entry->name, len);
+        return S_OK;
+    }
+    if (SUCCEEDED(desc_lookup_key(key, &d)))
+    {
+        *name = alloc_string(d.name);
+        desc_free(&d);
+        return *name ? S_OK : E_OUTOFMEMORY;
+    }
+    return TYPE_E_ELEMENTNOTFOUND;
+}
