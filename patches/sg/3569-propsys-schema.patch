+struct attr_scan
+{
+    const WCHAR *p, *end;
+};
+
+static WCHAR *xml_decode(const WCHAR *s, size_t len)
+{
+    WCHAR *out = malloc((len + 1) * sizeof(WCHAR)), *o = out;
+    size_t i;
+
+    if (!out) return NULL;
+    for (i = 0; i < len;)
+    {
+        if (s[i] == '&')
+        {
+            if (!wcsncmp(s + i, L"&amp;", 5)) { *o++ = '&'; i += 5; continue; }
+            if (!wcsncmp(s + i, L"&lt;", 4)) { *o++ = '<'; i += 4; continue; }
+            if (!wcsncmp(s + i, L"&gt;", 4)) { *o++ = '>'; i += 4; continue; }
+            if (!wcsncmp(s + i, L"&quot;", 6)) { *o++ = '"'; i += 6; continue; }
+            if (!wcsncmp(s + i, L"&apos;", 6)) { *o++ = '\''; i += 6; continue; }
+        }
+        *o++ = s[i++];
+    }
+    *o = 0;
+    return out;
+}
+
+/* finds attribute 'name' in the tag text [tag, tag_end); returns a decoded copy */
+static WCHAR *tag_attr(const WCHAR *tag, const WCHAR *tag_end, const WCHAR *name)
+{
+    size_t nlen = wcslen(name);
+    const WCHAR *p = tag;
+
+    while (p < tag_end)
+    {
+        const WCHAR *start, *vend;
+        WCHAR quote;
+
+        while (p < tag_end && (iswspace(*p) || *p == '/')) p++;
+        start = p;
+        while (p < tag_end && !iswspace(*p) && *p != '=' && *p != '/') p++;
+        if (p >= tag_end) break;
+        if (*p != '=')
+        {
+            continue;
+        }
+        {
+            size_t klen = p - start;
+            p++;
+            if (p >= tag_end || (*p != '"' && *p != '\'')) continue;
+            quote = *p++;
+            vend = p;
+            while (vend < tag_end && *vend != quote) vend++;
+            if (klen == nlen && !wcsnicmp(start, name, nlen))
+                return xml_decode(p, vend - p);
+            p = vend < tag_end ? vend + 1 : vend;
+        }
+    }
+    return NULL;
+}
+
+static BOOL attr_bool(const WCHAR *tag, const WCHAR *tag_end, const WCHAR *name, BOOL def)
+{
+    WCHAR *v = tag_attr(tag, tag_end, name);
+    BOOL ret = def;
+
+    if (v)
+    {
+        if (!wcsicmp(v, L"true") || !wcscmp(v, L"1")) ret = TRUE;
+        else if (!wcsicmp(v, L"false") || !wcscmp(v, L"0")) ret = FALSE;
+        free(v);
+    }
+    return ret;
+}
+
+static const struct { const WCHAR *name; VARTYPE vt; } type_names[] =
+{
+    { L"String", VT_LPWSTR }, { L"Boolean", VT_BOOL }, { L"Byte", VT_UI1 }, { L"Int16", VT_I2 },
+    { L"UInt16", VT_UI2 }, { L"Int32", VT_I4 }, { L"UInt32", VT_UI4 }, { L"Int64", VT_I8 },
+    { L"UInt64", VT_UI8 }, { L"Double", VT_R8 }, { L"Float", VT_R4 }, { L"DateTime", VT_FILETIME },
+    { L"Guid", VT_CLSID }, { L"Buffer", VT_VECTOR | VT_UI1 }, { L"Blob", VT_BLOB },
+    { L"Stream", VT_STREAM }, { L"Object", VT_UNKNOWN },
+};
+
+static const WCHAR *const reltype_names[] = { L"General", L"Date", L"Size", L"Count", L"Revision",
+    L"Length", L"Duration", L"Speed", L"Rate", L"Rating", L"Priority" };
+static const WCHAR *const disptype_names[] = { L"String", L"Number", L"Boolean", L"DateTime", L"Enumerated" };
+static const WCHAR *const grouping_names[] = { L"Discrete", L"Alphanumeric", L"Size", L"Dynamic", L"Date",
+    L"Percent", L"Enumerated" };
+static const WCHAR *const sortdir_names[] = { L"General", L"A-Z", L"Lowest-Highest", L"Smallest-Biggest",
+    L"Oldest-Newest" };
+static const WCHAR *const aggr_names[] = { L"Default", L"First", L"Sum", L"Average", L"DateRange", L"Union",
+    L"Max", L"Min" };
+
+static int name_index(const WCHAR *const *names, unsigned int count, const WCHAR *v)
+{
+    unsigned int i;
+    for (i = 0; i < count; i++) if (!wcsicmp(names[i], v)) return i;
+    return -1;
+}
+
+static WCHAR *read_text_file(const WCHAR *path)
+{
+    HANDLE file;
+    DWORD size, read;
+    BYTE *buf;
+    WCHAR *text = NULL;
+
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    size = GetFileSize(file, NULL);
+    if (size == INVALID_FILE_SIZE || size > 16 * 1024 * 1024 || !(buf = malloc(size + 2)))
+    {
+        CloseHandle(file);
+        return NULL;
+    }
+    if (!ReadFile(file, buf, size, &read, NULL)) read = 0;
+    CloseHandle(file);
+    buf[read] = buf[read + 1] = 0;
+    if (read >= 2 && buf[0] == 0xff && buf[1] == 0xfe)
+    {
+        text = dup_string((WCHAR *)(buf + 2));
+    }
+    else
+    {
+        BYTE *src = buf;
+        int len;
+        DWORD n = read;
+
+        if (n >= 3 && buf[0] == 0xef && buf[1] == 0xbb && buf[2] == 0xbf) { src += 3; n -= 3; }
+        len = MultiByteToWideChar(CP_UTF8, 0, (char *)src, n, NULL, 0);
+        if ((text = malloc((len + 1) * sizeof(WCHAR))))
+        {
+            MultiByteToWideChar(CP_UTF8, 0, (char *)src, n, text, len);
+            text[len] = 0;
+        }
+    }
+    free(buf);
+    return text;
+}
+
+static BOOL custom_add(struct desc *d)
+{
+    struct desc *n = realloc(custom_descs, (custom_count + 1) * sizeof(*custom_descs));
+
+    if (!n) return FALSE;
+    custom_descs = n;
+    custom_descs[custom_count++] = *d;
+    return TRUE;
+}
+
+/* applies one child element of a propertyDescription to d */
+static void apply_element(struct desc *d, const WCHAR *name, size_t nlen, const WCHAR *tag, const WCHAR *tag_end)
+{
+    WCHAR *v;
+    int idx;
+
+    if (nlen == 8 && !wcsnicmp(name, L"typeInfo", 8))
+    {
+        if ((v = tag_attr(tag, tag_end, L"type")))
+        {
+            unsigned int i;
+            for (i = 0; i < ARRAY_SIZE(type_names); i++)
+                if (!wcsicmp(type_names[i].name, v)) { d->vt = type_names[i].vt; break; }
+            free(v);
+        }
+        d->typeflags = 0x80000000 & d->typeflags;
+#define TFLAG(attr, flag, def) if (attr_bool(tag, tag_end, attr, def)) d->typeflags |= flag
+        TFLAG(L"multipleValues", PDTF_MULTIPLEVALUES, FALSE);
+        TFLAG(L"isInnate", PDTF_ISINNATE, FALSE);
+        TFLAG(L"isGroup", PDTF_ISGROUP, FALSE);
+        TFLAG(L"canGroupBy", PDTF_CANGROUPBY, FALSE);
+        TFLAG(L"canStackBy", PDTF_CANSTACKBY, FALSE);
+        TFLAG(L"isTreeProperty", PDTF_ISTREEPROPERTY, FALSE);
+        TFLAG(L"includeInFullTextQuery", PDTF_INCLUDEINFULLTEXTQUERY, FALSE);
+        TFLAG(L"isViewable", PDTF_ISVIEWABLE, TRUE);
+        TFLAG(L"isQueryable", PDTF_ISQUERYABLE, FALSE);
+        TFLAG(L"searchRawValue", PDTF_SEARCHRAWVALUE, FALSE);
+        TFLAG(L"canBePurged", PDTF_CANBEPURGED, TRUE);
+#undef TFLAG
+        if ((d->typeflags & PDTF_MULTIPLEVALUES) && !(d->vt & VT_VECTOR) && d->vt != VT_BLOB && d->vt != VT_STREAM)
+            d->vt |= VT_VECTOR;
+        if ((v = tag_attr(tag, tag_end, L"conditionType")))
+        {
+            static const WCHAR *const c[] = { L"None", L"String", L"Size", L"DateTime", L"Boolean", L"Number" };
+            if ((idx = name_index(c, ARRAY_SIZE(c), v)) >= 0) d->condtype = idx;
+            free(v);
+        }
+        if ((v = tag_attr(tag, tag_end, L"aggregationType")))
+        {
+            if ((idx = name_index(aggr_names, ARRAY_SIZE(aggr_names), v)) >= 0) d->aggregation = idx;
+            free(v);
+        }
+        if ((v = tag_attr(tag, tag_end, L"groupingRange")))
+        {
+            if ((idx = name_index(grouping_names, ARRAY_SIZE(grouping_names), v)) >= 0) d->grouping = idx;
+            free(v);
+        }
+    }
+    else if (nlen == 9 && !wcsnicmp(name, L"labelInfo", 9))
+    {
+        if ((v = tag_attr(tag, tag_end, L"label"))) { free(d->label); d->label = v; }
+        if ((v = tag_attr(tag, tag_end, L"invitationText"))) { free(d->invitation); d->invitation = v; }
+    }
+    else if (nlen == 11 && !wcsnicmp(name, L"displayInfo", 11))
+    {
+        if ((v = tag_attr(tag, tag_end, L"displayType")))
+        {
+            if ((idx = name_index(disptype_names, ARRAY_SIZE(disptype_names), v)) >= 0) d->disp = idx;
+            free(v);
+        }
+        if ((v = tag_attr(tag, tag_end, L"defaultColumnWidth")))
+        {
+            d->width = wcstoul(v, NULL, 10);
+            free(v);
+        }
+        if ((v = tag_attr(tag, tag_end, L"alignment")))
+        {
+            d->viewflags &= ~(PDVF_CENTERALIGN | PDVF_RIGHTALIGN);
+            if (!wcsicmp(v, L"Right")) d->viewflags |= PDVF_RIGHTALIGN;
+            else if (!wcsicmp(v, L"Center")) d->viewflags |= PDVF_CENTERALIGN;
+            free(v);
+        }
+        if ((v = tag_attr(tag, tag_end, L"relativeDescriptionType")))
+        {
+            if ((idx = name_index(reltype_names, ARRAY_SIZE(reltype_names), v)) >= 0) d->reltype = idx;
+            free(v);
+        }
+        if ((v = tag_attr(tag, tag_end, L"defaultSortDirection")))
+        {
+            if ((idx = name_index(sortdir_names, ARRAY_SIZE(sortdir_names), v)) >= 0) d->sortdesc = idx;
+            free(v);
+        }
+#define VFLAG(attr, flag) if (attr_bool(tag, tag_end, attr, FALSE)) d->viewflags |= flag
+        VFLAG(L"beginNewGroup", PDVF_BEGINNEWGROUP);
+        VFLAG(L"fillArea", PDVF_FILLAREA);
+        VFLAG(L"showOnlyIfPresent", PDVF_SHOWONLYIFPRESENT);
+        VFLAG(L"showByDefault", PDVF_SHOWBYDEFAULT);
+        VFLAG(L"showInPrimaryList", PDVF_SHOWINPRIMARYLIST);
+        VFLAG(L"showInSecondaryList", PDVF_SHOWINSECONDARYLIST);
+        VFLAG(L"hideLabel", PDVF_HIDELABEL);
+        VFLAG(L"hidden", PDVF_HIDDEN);
+        VFLAG(L"canWrap", PDVF_CANWRAP);
+#undef VFLAG
+    }
+    else if (nlen == 10 && !wcsnicmp(name, L"searchInfo", 10))
+    {
+        if (attr_bool(tag, tag_end, L"isColumn", FALSE)) d->typeflags |= PDTF_ISQUERYABLE;
+        if (attr_bool(tag, tag_end, L"inInvertedIndex", FALSE)) d->typeflags |= PDTF_INCLUDEINFULLTEXTQUERY;
+    }
+}
+
+static void parse_schema(const WCHAR *text)
+{
+    const WCHAR *p = text;
+    struct desc cur;
+    BOOL in_prop = FALSE;
+
+    memset(&cur, 0, sizeof(cur));
+    while ((p = wcschr(p, '<')))
+    {
+        const WCHAR *name, *tag, *tag_end;
+        size_t nlen;
+        BOOL closing = FALSE;
+
+        p++;
+        if (!wcsncmp(p, L"!--", 3))
+        {
+            const WCHAR *e = wcsstr(p + 3, L"-->");
+            if (!e) break;
+            p = e + 3;
+            continue;
+        }
+        if (*p == '?' || *p == '!')
+        {
+            const WCHAR *e = wcschr(p, '>');
+            if (!e) break;
+            p = e + 1;
+            continue;
+        }
+        if (*p == '/') { closing = TRUE; p++; }
+        name = p;
+        while (*p && !iswspace(*p) && *p != '>' && *p != '/') p++;
+        nlen = p - name;
+        tag = p;
+        /* the end of the tag: '>' outside of quoted values */
+        {
+            WCHAR quote = 0;
+            while (*p && (quote || *p != '>'))
+            {
+                if (quote) { if (*p == quote) quote = 0; }
+                else if (*p == '"' || *p == '\'') quote = *p;
+                p++;
+            }
+        }
+        if (!*p) break;
+        tag_end = p;
+        p++;
+
+        if (nlen == 19 && !wcsnicmp(name, L"propertyDescription", 19))
+        {
+            if (closing)
+            {
+                if (in_prop && cur.name && (cur.key.pid || !IsEqualGUID(&cur.key.fmtid, &GUID_NULL)))
+                {
+                    desc_finish(&cur);
+                    if (!custom_add(&cur)) desc_free(&cur);
+                    memset(&cur, 0, sizeof(cur));
+                }
+                else desc_free(&cur);
+                in_prop = FALSE;
+                continue;
+            }
+            {
+                WCHAR *n = tag_attr(tag, tag_end, L"name");
+                WCHAR *fmt = tag_attr(tag, tag_end, L"formatID");
+                WCHAR *pid = tag_attr(tag, tag_end, L"propID");
+
+                desc_free(&cur);
+                in_prop = FALSE;
+                if (n && fmt && pid && SUCCEEDED(CLSIDFromString(fmt, &cur.key.fmtid)))
+                {
+                    cur.key.pid = wcstoul(pid, NULL, 0);
+                    cur.name = n;
+                    n = NULL;
+                    cur.vt = VT_LPWSTR;
+                    cur.typeflags = PDTF_ISVIEWABLE;
+                    cur.disp = PDDT_STRING;
+                    cur.width = 20;
+                    cur.colstate = SHCOLSTATE_TYPE_STR;
+                    in_prop = TRUE;
+                }
+                free(n); free(fmt); free(pid);
+                /* a self-closing element has no children */
+                if (in_prop && tag_end > tag && tag_end[-1] == '/')
+                {
+                    desc_finish(&cur);
+                    if (!custom_add(&cur)) desc_free(&cur);
+                    memset(&cur, 0, sizeof(cur));
+                    in_prop = FALSE;
+                }
+            }
+            continue;
+        }
+        if (in_prop && !closing) apply_element(&cur, name, nlen, tag, tag_end);
+    }
+    desc_free(&cur);
+}
+
+static void custom_clear(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < custom_count; i++) desc_free(&custom_descs[i]);
+    free(custom_descs);
+    custom_descs = NULL;
+    custom_count = 0;
+}
+
+static void custom_load(void)
+{
+    HKEY key;
+    DWORD i, namelen;
+    WCHAR *name;
+
+    custom_clear();
+    custom_loaded = TRUE;
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, schema_key_path, 0, KEY_READ, &key)) return;
+    for (i = 0;; i++)
+    {
+        WCHAR *text;
+
+        namelen = 0;
+        if (RegQueryInfoKeyW(key, NULL, NULL, NULL, NULL, NULL, NULL, NULL, &namelen, NULL, NULL, NULL)) break;
+        if (!(name = malloc((namelen + 2) * sizeof(WCHAR)))) break;
+        namelen++;
+        if (RegEnumValueW(key, i, name, &namelen, NULL, NULL, NULL, NULL))
+        {
+            free(name);
+            break;
+        }
+        if ((text = read_text_file(name)))
+        {
+            parse_schema(text);
+            free(text);
+        }
+        else WARN("cannot read schema file %s\n", debugstr_w(name));
+        free(name);
+    }
+    RegCloseKey(key);
+}
+
+void propsys_schema_refresh(void)
+{
+    EnterCriticalSection(&schema_cs);
+    custom_load();
+    LeaveCriticalSection(&schema_cs);
+}
+
+/* finds a description by key; the result is owned by the caller */
+static HRESULT desc_lookup_key(const PROPERTYKEY *key, struct desc *out)
+{
+    unsigned int idx, i;
+    HRESULT hr = TYPE_E_ELEMENTNOTFOUND;
+
+    EnterCriticalSection(&schema_cs);
+    if (!custom_loaded) custom_load();
+    for (i = 0; i < custom_count; i++)
+    {
+        if (custom_descs[i].key.pid == key->pid && IsEqualGUID(&custom_descs[i].key.fmtid, &key->fmtid))
+        {
+            hr = desc_copy(out, &custom_descs[i]) ? S_OK : E_OUTOFMEMORY;
+            break;
+        }
+    }
+    LeaveCriticalSection(&schema_cs);
+    if (i < custom_count) return hr;
+    if (builtin_find_key(key, &idx)) return desc_from_builtin(out, idx) ? S_OK : E_OUTOFMEMORY;
+    return TYPE_E_ELEMENTNOTFOUND;
+}
+
+static HRESULT desc_lookup_name(const WCHAR *name, struct desc *out)
+{
+    unsigned int idx, i;
+    HRESULT hr = TYPE_E_ELEMENTNOTFOUND;
+
+    EnterCriticalSection(&schema_cs);
+    if (!custom_loaded) custom_load();
+    for (i = 0; i < custom_count; i++)
+    {
+        if (!wcsicmp(custom_descs[i].name, name))
+        {
+            hr = desc_copy(out, &custom_descs[i]) ? S_OK : E_OUTOFMEMORY;
+            break;
+        }
+    }
+    LeaveCriticalSection(&schema_cs);
+    if (i < custom_count) return hr;
+    if (builtin_find_name(name, &idx)) return desc_from_builtin(out, idx) ? S_OK : E_OUTOFMEMORY;
+    return TYPE_E_ELEMENTNOTFOUND;
+}
