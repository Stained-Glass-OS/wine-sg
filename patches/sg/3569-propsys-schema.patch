+static WCHAR *dup_string(const WCHAR *s)
+{
+    WCHAR *ret;
+    if (!s) return NULL;
+    if ((ret = malloc((wcslen(s) + 1) * sizeof(WCHAR)))) wcscpy(ret, s);
+    return ret;
+}
+
+static void desc_free(struct desc *d)
+{
+    free(d->name);
+    free(d->label);
+    free(d->invitation);
+    memset(d, 0, sizeof(*d));
+}
+
+static BOOL desc_copy(struct desc *dst, const struct desc *src)
+{
+    *dst = *src;
+    dst->name = dup_string(src->name);
+    dst->label = dup_string(src->label);
+    dst->invitation = dup_string(src->invitation);
+    if ((src->name && !dst->name) || (src->label && !dst->label) || (src->invitation && !dst->invitation))
+    {
+        desc_free(dst);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static int __cdecl canonical_propkey_cmp(const void *a, const void *b)
+{
+    const WCHAR *name = a;
+    const struct canonical_propkey *entry = b;
+    return wcsicmp(name, entry->name);
+}
+
+static UINT condtype_for_vt(VARTYPE vt, UINT reltype)
+{
+    switch (vt & ~VT_VECTOR)
+    {
+    case VT_BOOL: return PDCOT_BOOLEAN;
+    case VT_FILETIME: case VT_DATE: return PDCOT_DATETIME;
+    case VT_I1: case VT_UI1: case VT_I2: case VT_UI2: case VT_I4: case VT_UI4: case VT_I8: case VT_UI8:
+    case VT_R4: case VT_R8: case VT_INT: case VT_UINT:
+        return reltype == PDRDT_SIZE ? PDCOT_SIZE : PDCOT_NUMBER;
+    case VT_LPWSTR: case VT_BSTR: case VT_LPSTR: return PDCOT_STRING;
+    default: return PDCOT_NONE;
+    }
+}
+
+static void desc_finish(struct desc *d)
+{
+    d->condtype = condtype_for_vt(d->vt, d->reltype);
+    switch (d->condtype)
+    {
+    case PDCOT_STRING: d->condop = COP_VALUE_CONTAINS; break;
+    case PDCOT_BOOLEAN: d->condop = COP_EQUAL; break;
+    case PDCOT_NONE: d->condop = COP_IMPLICIT; break;
+    default: d->condop = COP_EQUAL; break;
+    }
+    if (!d->grouping)
+    {
+        switch (d->condtype)
+        {
+        case PDCOT_STRING: d->grouping = PDGR_ALPHANUMERIC; break;
+        case PDCOT_SIZE: d->grouping = PDGR_SIZE; break;
+        case PDCOT_DATETIME: d->grouping = PDGR_DATE; break;
+        default: d->grouping = PDGR_DISCRETE; break;
+        }
+    }
+}
+
+static BOOL desc_from_builtin(struct desc *d, unsigned int idx)
+{
+    const struct canonical_propkey *c = &canonical_propkeys[idx];
+    const struct propdesc_info *i = &propdesc_info[idx];
+
+    memset(d, 0, sizeof(*d));
+    d->key = c->key;
+    d->vt = i->vt;
+    d->typeflags = i->typeflags;
+    d->viewflags = i->viewflags;
+    d->disp = i->disp;
+    d->reltype = i->reltype;
+    d->sortdesc = i->sortdesc;
+    d->width = i->width;
+    d->colstate = i->colstate;
+    d->aggregation = (i->vt == VT_UI8 && i->reltype == PDRDT_SIZE) ? PDAT_SUM : PDAT_DEFAULT;
+    if (!(d->name = dup_string(c->name)) || !(d->label = dup_string(i->label)))
+    {
+        desc_free(d);
+        return FALSE;
+    }
+    desc_finish(d);
+    return TRUE;
+}
+
+static BOOL builtin_find_key(const PROPERTYKEY *key, unsigned int *idx)
+{
+    unsigned int i;
+
+    for (i = 0; i < CANONICAL_PROPKEY_COUNT; i++)
+    {
+        if (canonical_propkeys[i].key.pid == key->pid
+                && IsEqualGUID(&canonical_propkeys[i].key.fmtid, &key->fmtid))
+        {
+            *idx = i;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static BOOL builtin_find_name(const WCHAR *name, unsigned int *idx)
+{
+    const struct canonical_propkey *entry;
+
+    entry = bsearch(name, canonical_propkeys, CANONICAL_PROPKEY_COUNT,
+            sizeof(canonical_propkeys[0]), canonical_propkey_cmp);
+    if (!entry) return FALSE;
+    *idx = entry - canonical_propkeys;
+    return TRUE;
+}
