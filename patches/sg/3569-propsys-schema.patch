+/* ---- IPropertyDescription ------------------------------------------------------------ */
+
+struct propdesc
+{
+    IPropertyDescription2 IPropertyDescription2_iface;
+    LONG ref;
+    struct desc d;
+};
+
+static struct propdesc *impl_from_IPropertyDescription2(IPropertyDescription2 *iface)
+{
+    return CONTAINING_RECORD(iface, struct propdesc, IPropertyDescription2_iface);
+}
+
+static HRESULT WINAPI propdesc_QueryInterface(IPropertyDescription2 *iface, REFIID iid, void **out)
+{
+    TRACE("%p, %s, %p\n", iface, debugstr_guid(iid), out);
+
+    if (!out) return E_POINTER;
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IPropertyDescription)
+            || IsEqualIID(iid, &IID_IPropertyDescription2))
+    {
+        *out = iface;
+        IPropertyDescription2_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    WARN("no interface %s\n", debugstr_guid(iid));
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI propdesc_AddRef(IPropertyDescription2 *iface)
+{
+    struct propdesc *This = impl_from_IPropertyDescription2(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI propdesc_Release(IPropertyDescription2 *iface)
+{
+    struct propdesc *This = impl_from_IPropertyDescription2(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        desc_free(&This->d);
+        free(This);
+    }
+    return ref;
+}
