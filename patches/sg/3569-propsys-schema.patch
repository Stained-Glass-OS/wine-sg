+/* description data, owned by whoever holds the struct */
+struct desc
+{
+    PROPERTYKEY key;
+    WCHAR *name;
+    WCHAR *label;
+    WCHAR *invitation;
+    VARTYPE vt;
+    DWORD typeflags, viewflags;
+    UINT disp, reltype, sortdesc, width, colstate, grouping, aggregation, condtype, condop;
+};
+
