+    { &schema_cs_debug.ProcessLocksList, &schema_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": schema_cs") }
+};
+static CRITICAL_SECTION schema_cs = { &schema_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct desc *custom_descs;
+static unsigned int custom_count;
+static BOOL custom_loaded;
