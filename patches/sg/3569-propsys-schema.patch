+/* ---- formatting --------------------------------------------------------------------- */
+
+static WCHAR *alloc_string(const WCHAR *s)
+{
+    WCHAR *ret = CoTaskMemAlloc((wcslen(s) + 1) * sizeof(WCHAR));
+    if (ret) wcscpy(ret, s);
+    return ret;
+}
+
+static BOOL propvar_to_i64(const PROPVARIANT *pv, LONGLONG *out)
+{
+    switch (pv->vt)
+    {
+    case VT_I1: *out = pv->cVal; return TRUE;
+    case VT_UI1: *out = pv->bVal; return TRUE;
+    case VT_I2: *out = pv->iVal; return TRUE;
+    case VT_UI2: *out = pv->uiVal; return TRUE;
+    case VT_I4: case VT_INT: *out = pv->lVal; return TRUE;
+    case VT_UI4: case VT_UINT: *out = pv->ulVal; return TRUE;
+    case VT_I8: *out = pv->hVal.QuadPart; return TRUE;
+    case VT_UI8: *out = pv->uhVal.QuadPart; return TRUE;
+    default: return FALSE;
+    }
+}
+
+static HRESULT format_filetime(const FILETIME *ft, DWORD flags, WCHAR **out)
+{
+    FILETIME local, now_ft, now_local;
+    SYSTEMTIME st, now;
+    WCHAR date[128] = L"", time[128] = L"", buf[300];
+    BOOL want_date = !(flags & PDFF_HIDEDATE), want_time = !(flags & PDFF_HIDETIME);
+
+    if (!ft->dwLowDateTime && !ft->dwHighDateTime) { *out = alloc_string(L""); return *out ? S_OK : E_OUTOFMEMORY; }
+    if (!FileTimeToLocalFileTime(ft, &local) || !FileTimeToSystemTime(&local, &st)) return E_FAIL;
+
+    if (want_date)
+    {
+        BOOL relative = FALSE;
+
+        if (flags & PDFF_RELATIVEDATE)
+        {
+            GetSystemTimeAsFileTime(&now_ft);
+            FileTimeToLocalFileTime(&now_ft, &now_local);
+            FileTimeToSystemTime(&now_local, &now);
+            if (st.wYear == now.wYear && st.wMonth == now.wMonth && st.wDay == now.wDay)
+            {
+                wcscpy(date, L"Today");
+                relative = TRUE;
+            }
+            else
+            {
+                ULARGE_INTEGER a;
+                SYSTEMTIME y = now;
+                FILETIME yft;
+
+                SystemTimeToFileTime(&now, &yft);
+                a.LowPart = yft.dwLowDateTime; a.HighPart = yft.dwHighDateTime;
+                a.QuadPart -= (ULONGLONG)864000000000;
+                yft.dwLowDateTime = a.LowPart; yft.dwHighDateTime = a.HighPart;
+                FileTimeToSystemTime(&yft, &y);
+                if (st.wYear == y.wYear && st.wMonth == y.wMonth && st.wDay == y.wDay)
+                {
+                    wcscpy(date, L"Yesterday");
+                    relative = TRUE;
+                }
+            }
+        }
+        if (!relative && !GetDateFormatW(LOCALE_USER_DEFAULT, (flags & PDFF_LONGDATE) ? DATE_LONGDATE : DATE_SHORTDATE,
+                &st, NULL, date, ARRAY_SIZE(date)))
+            date[0] = 0;
+    }
+    if (want_time)
+    {
+        DWORD tf = (flags & PDFF_LONGTIME) ? 0 : TIME_NOSECONDS;
+        if (!GetTimeFormatW(LOCALE_USER_DEFAULT, tf, &st, NULL, time, ARRAY_SIZE(time))) time[0] = 0;
+    }
+    if (date[0] && time[0]) swprintf(buf, ARRAY_SIZE(buf), L"%s %s", date, time);
+    else wcscpy(buf, date[0] ? date : time);
+    *out = alloc_string(buf);
+    return *out ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT format_scalar(const struct desc *d, const PROPVARIANT *pv, DWORD flags, WCHAR **out)
+{
+    LONGLONG n;
+    WCHAR buf[200];
+
+    switch (pv->vt)
+    {
+    case VT_BOOL:
+        *out = alloc_string(pv->boolVal ? L"Yes" : L"No");
+        return *out ? S_OK : E_OUTOFMEMORY;
+    case VT_FILETIME:
+        return format_filetime(&pv->filetime, flags, out);
+    case VT_DATE:
+    {
+        SYSTEMTIME st;
+        FILETIME ft, utc;
+        if (!VariantTimeToSystemTime(pv->date, &st) || !SystemTimeToFileTime(&st, &ft)) return E_FAIL;
+        LocalFileTimeToFileTime(&ft, &utc);
+        return format_filetime(&utc, flags, out);
+    }
+    case VT_R4:
+    case VT_R8:
+    {
+        BSTR b;
+        HRESULT hr = pv->vt == VT_R4 ? VarBstrFromR4(pv->fltVal, LOCALE_USER_DEFAULT, 0, &b)
+                : VarBstrFromR8(pv->dblVal, LOCALE_USER_DEFAULT, 0, &b);
+        if (FAILED(hr)) return hr;
+        *out = alloc_string(b);
+        SysFreeString(b);
+        return *out ? S_OK : E_OUTOFMEMORY;
+    }
+    case VT_CLSID:
+        if (!pv->puuid) break;
+        StringFromGUID2(pv->puuid, buf, ARRAY_SIZE(buf));
+        *out = alloc_string(buf);
+        return *out ? S_OK : E_OUTOFMEMORY;
+    default:
+        break;
+    }
+
+    if (propvar_to_i64(pv, &n))
+    {
+        if (d->reltype == PDRDT_SIZE && n >= 0)
+        {
+            if (flags & PDFF_ALWAYSKB) StrFormatKBSizeW(n, buf, ARRAY_SIZE(buf));
+            else StrFormatByteSizeW(n, buf, ARRAY_SIZE(buf));
+        }
+        else if (d->reltype == PDRDT_DURATION && pv->vt == VT_UI8)
+        {
+            ULONGLONG s = pv->uhVal.QuadPart / 10000000;
+            swprintf(buf, ARRAY_SIZE(buf), L"%02u:%02u:%02u", (unsigned)(s / 3600), (unsigned)(s / 60 % 60), (unsigned)(s % 60));
+        }
+        else
+        {
+            WCHAR raw[40];
+            NUMBERFMTW fmt;
+            WCHAR dec[8], grp[8];
+
+            swprintf(raw, ARRAY_SIZE(raw), pv->vt == VT_UI8 ? L"%I64u" : L"%I64d", n);
+            memset(&fmt, 0, sizeof(fmt));
+            GetLocaleInfoW(LOCALE_USER_DEFAULT, LOCALE_SDECIMAL, dec, ARRAY_SIZE(dec));
+            GetLocaleInfoW(LOCALE_USER_DEFAULT, LOCALE_STHOUSAND, grp, ARRAY_SIZE(grp));
+            fmt.lpDecimalSep = dec;
+            fmt.lpThousandSep = grp;
+            fmt.Grouping = 3;
+            fmt.NegativeOrder = 1;
+            if (!GetNumberFormatW(LOCALE_USER_DEFAULT, 0, raw, &fmt, buf, ARRAY_SIZE(buf))) wcscpy(buf, raw);
+        }
+        *out = alloc_string(buf);
+        return *out ? S_OK : E_OUTOFMEMORY;
+    }
+
+    return PropVariantToStringAlloc(pv, out);
+}
+
+static HRESULT desc_format(const struct desc *d, const PROPVARIANT *pv, DWORD flags, WCHAR **out)
+{
+    HRESULT hr;
+    WCHAR *text;
+
+    *out = NULL;
+    if (pv->vt == VT_EMPTY || pv->vt == VT_NULL) { *out = alloc_string(L""); return *out ? S_OK : E_OUTOFMEMORY; }
+
+    if (pv->vt & VT_VECTOR)
+    {
+        ULONG i, count = PropVariantGetElementCount(pv);
+        WCHAR *joined = NULL;
+        size_t len = 1;
+
+        for (i = 0; i < count; i++)
+        {
+            PROPVARIANT elem;
+            WCHAR *part;
+
+            PropVariantInit(&elem);
+            if (pv->vt == (VT_VECTOR | VT_LPWSTR)) { elem.vt = VT_LPWSTR; elem.pwszVal = pv->calpwstr.pElems[i]; }
+            else if (pv->vt == (VT_VECTOR | VT_UI1)) return alloc_string(L"") ? S_OK : E_OUTOFMEMORY; /* a blob */
+            else if (pv->vt == (VT_VECTOR | VT_I4)) { elem.vt = VT_I4; elem.lVal = pv->cal.pElems[i]; }
+            else if (pv->vt == (VT_VECTOR | VT_UI4)) { elem.vt = VT_UI4; elem.ulVal = pv->caul.pElems[i]; }
+            else if (pv->vt == (VT_VECTOR | VT_UI2)) { elem.vt = VT_UI2; elem.uiVal = pv->caui.pElems[i]; }
+            else if (pv->vt == (VT_VECTOR | VT_I2)) { elem.vt = VT_I2; elem.iVal = pv->cai.pElems[i]; }
+            else if (pv->vt == (VT_VECTOR | VT_UI8)) { elem.vt = VT_UI8; elem.uhVal.QuadPart = pv->cauh.pElems[i].QuadPart; }
+            else if (pv->vt == (VT_VECTOR | VT_I8)) { elem.vt = VT_I8; elem.hVal.QuadPart = pv->cah.pElems[i].QuadPart; }
+            else if (pv->vt == (VT_VECTOR | VT_R8)) { elem.vt = VT_R8; elem.dblVal = pv->cadbl.pElems[i]; }
+            else if (pv->vt == (VT_VECTOR | VT_FILETIME)) { elem.vt = VT_FILETIME; elem.filetime = pv->cafiletime.pElems[i]; }
+            else { free(joined); return PropVariantToStringAlloc(pv, out); }
+            if (FAILED(hr = format_scalar(d, &elem, flags, &part))) { free(joined); return hr; }
+            len += wcslen(part) + 2;
+            joined = realloc(joined, len * sizeof(WCHAR));
+            if (!joined) { CoTaskMemFree(part); return E_OUTOFMEMORY; }
+            if (i) wcscat(joined, L"; "); else joined[0] = 0;
+            wcscat(joined, part);
+            CoTaskMemFree(part);
+        }
+        text = alloc_string(joined ? joined : L"");
+        free(joined);
+        if (!text) return E_OUTOFMEMORY;
+        hr = S_OK;
+    }
+    else if (FAILED(hr = format_scalar(d, pv, flags, &text)))
+        return hr;
+
+    if ((flags & PDFF_PREFIXNAME) && d->label)
+    {
+        size_t len = wcslen(d->label) + 2 + wcslen(text) + 1;
+        *out = CoTaskMemAlloc(len * sizeof(WCHAR));
+        if (!*out) { CoTaskMemFree(text); return E_OUTOFMEMORY; }
+        swprintf(*out, len, L"%s: %s", d->label, text);
+        CoTaskMemFree(text);
+        return S_OK;
+    }
+    *out = text;
+    return S_OK;
+}
+
+static HRESULT desc_coerce(const struct desc *d, PROPVARIANT *pv)
+{
+    PROPVARIANT tmp;
+    HRESULT hr;
+    VARTYPE target = d->vt;
+
+    if (pv->vt == target || pv->vt == VT_EMPTY || pv->vt == VT_NULL) return S_OK;
+
+    if (target & VT_VECTOR)
+    {
+        PROPVARIANT scalar;
+
+        if (pv->vt & VT_VECTOR) return DISP_E_TYPEMISMATCH;
+        PropVariantInit(&scalar);
+        if (FAILED(hr = PropVariantChangeType(&scalar, pv, 0, target & ~VT_VECTOR))) return hr;
+        hr = InitPropVariantVectorFromPropVariant(&scalar, &tmp);
+        PropVariantClear(&scalar);
+        if (FAILED(hr)) return hr;
+        PropVariantClear(pv);
+        *pv = tmp;
+        return S_OK;
+    }
+    if (pv->vt & VT_VECTOR) return DISP_E_TYPEMISMATCH;
+
+    PropVariantInit(&tmp);
+    if (FAILED(hr = PropVariantChangeType(&tmp, pv, 0, target))) return hr;
+    PropVariantClear(pv);
+    *pv = tmp;
+    return S_OK;
+}
