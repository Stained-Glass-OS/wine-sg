+
+/* ---- a store that forwards to another one (PSCreateAdapterFromPropertyStore) --------- */
+
+struct fwd_store
+{
+    IPropertyStore IPropertyStore_iface;
+    LONG ref;
+    IPropertyStore *inner;
+};
+
+static struct fwd_store *fwd_from_iface(IPropertyStore *iface)
+{
+    return CONTAINING_RECORD(iface, struct fwd_store, IPropertyStore_iface);
+}
+
+static HRESULT WINAPI fwd_QueryInterface(IPropertyStore *iface, REFIID iid, void **out)
+{
+    struct fwd_store *This = fwd_from_iface(iface);
+
+    if (!out) return E_POINTER;
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IPropertyStore))
+    {
+        *out = iface;
+        IPropertyStore_AddRef(iface);
+        return S_OK;
+    }
+    /* other interfaces of the wrapped store (capabilities, cache, ...) */
+    return IPropertyStore_QueryInterface(This->inner, iid, out);
+}
+
+static ULONG WINAPI fwd_AddRef(IPropertyStore *iface)
+{
+    return InterlockedIncrement(&fwd_from_iface(iface)->ref);
+}
+
+static ULONG WINAPI fwd_Release(IPropertyStore *iface)
+{
+    struct fwd_store *This = fwd_from_iface(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        IPropertyStore_Release(This->inner);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI fwd_GetCount(IPropertyStore *iface, DWORD *count)
+{
+    return IPropertyStore_GetCount(fwd_from_iface(iface)->inner, count);
+}
+
+static HRESULT WINAPI fwd_GetAt(IPropertyStore *iface, DWORD index, PROPERTYKEY *key)
+{
+    return IPropertyStore_GetAt(fwd_from_iface(iface)->inner, index, key);
+}
+
+static HRESULT WINAPI fwd_GetValue(IPropertyStore *iface, REFPROPERTYKEY key, PROPVARIANT *value)
+{
+    return IPropertyStore_GetValue(fwd_from_iface(iface)->inner, key, value);
+}
+
+static HRESULT WINAPI fwd_SetValue(IPropertyStore *iface, REFPROPERTYKEY key, REFPROPVARIANT value)
+{
+    return IPropertyStore_SetValue(fwd_from_iface(iface)->inner, key, value);
+}
+
+static HRESULT WINAPI fwd_Commit(IPropertyStore *iface)
+{
+    return IPropertyStore_Commit(fwd_from_iface(iface)->inner);
+}
+
+static const IPropertyStoreVtbl fwd_vtbl =
+{
+    fwd_QueryInterface, fwd_AddRef, fwd_Release, fwd_GetCount, fwd_GetAt, fwd_GetValue, fwd_SetValue, fwd_Commit
+};
+
+HRESULT propsys_create_wrapper(IPropertyStore *inner, REFIID riid, void **ppv)
+{
+    struct fwd_store *obj;
+    HRESULT hr;
+
+    if (!(obj = calloc(1, sizeof(*obj)))) return E_OUTOFMEMORY;
+    obj->IPropertyStore_iface.lpVtbl = &fwd_vtbl;
+    obj->ref = 1;
+    obj->inner = inner;
+    IPropertyStore_AddRef(inner);
+    hr = IPropertyStore_QueryInterface(&obj->IPropertyStore_iface, riid, ppv);
+    IPropertyStore_Release(&obj->IPropertyStore_iface);
+    return hr;
+}
+
+HRESULT WINAPI PSCreateAdapterFromPropertyStore(IPropertyStore *store, REFIID riid, void **ppv)
+{
+    TRACE("%p, %s, %p\n", store, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!store) return E_POINTER;
+    return propsys_create_wrapper(store, riid, ppv);
+}
+
+/* ---- multiplex store ---------------------------------------------------------------- */
+
+struct multiplex
+{
+    IPropertyStore IPropertyStore_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    DWORD count;
+    IPropertyStore **stores;
+    /* delayed: stores are created on demand */
+    IDelayedPropertyStoreFactory *factory;
+    GETPROPERTYSTOREFLAGS flags;
+    DWORD *ids;
+};
+
+static struct multiplex *mux_from_iface(IPropertyStore *iface)
+{
+    return CONTAINING_RECORD(iface, struct multiplex, IPropertyStore_iface);
+}
+
+static HRESULT WINAPI mux_QueryInterface(IPropertyStore *iface, REFIID iid, void **out)
+{
+    if (!out) return E_POINTER;
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IPropertyStore))
+    {
+        *out = iface;
+        IPropertyStore_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI mux_AddRef(IPropertyStore *iface)
+{
+    return InterlockedIncrement(&mux_from_iface(iface)->ref);
+}
+
+static ULONG WINAPI mux_Release(IPropertyStore *iface)
+{
+    struct multiplex *This = mux_from_iface(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        DWORD i;
+
+        for (i = 0; i < This->count; i++)
+            if (This->stores[i]) IPropertyStore_Release(This->stores[i]);
+        if (This->factory) IDelayedPropertyStoreFactory_Release(This->factory);
+        DeleteCriticalSection(&This->cs);
+        free(This->stores);
+        free(This->ids);
+        free(This);
+    }
+    return ref;
+}
+
+/* store i, created on first use for a delayed multiplexer */
+static IPropertyStore *mux_store(struct multiplex *This, DWORD i)
+{
+    IPropertyStore *store;
+
+    EnterCriticalSection(&This->cs);
+    if (!This->stores[i] && This->factory)
+    {
+        IPropertyStore *created = NULL;
+
+        if (SUCCEEDED(IDelayedPropertyStoreFactory_GetDelayedPropertyStore(This->factory, This->flags,
+                This->ids[i], &IID_IPropertyStore, (void **)&created)))
+            This->stores[i] = created;
+    }
+    store = This->stores[i];
+    LeaveCriticalSection(&This->cs);
+    return store;
+}
+
+static HRESULT WINAPI mux_GetCount(IPropertyStore *iface, DWORD *count)
+{
+    struct multiplex *This = mux_from_iface(iface);
+    DWORD i, total = 0;
+
+    if (!count) return E_POINTER;
+    for (i = 0; i < This->count; i++)
+    {
+        IPropertyStore *store = mux_store(This, i);
+        DWORD n;
+
+        if (store && SUCCEEDED(IPropertyStore_GetCount(store, &n))) total += n;
+    }
+    *count = total;
+    return S_OK;
+}
+
+static HRESULT WINAPI mux_GetAt(IPropertyStore *iface, DWORD index, PROPERTYKEY *key)
+{
+    struct multiplex *This = mux_from_iface(iface);
+    DWORD i;
+
+    if (!key) return E_POINTER;
+    for (i = 0; i < This->count; i++)
+    {
+        IPropertyStore *store = mux_store(This, i);
+        DWORD n;
+
+        if (!store || FAILED(IPropertyStore_GetCount(store, &n))) continue;
+        if (index < n) return IPropertyStore_GetAt(store, index, key);
+        index -= n;
+    }
+    return E_INVALIDARG;
+}
+
+static HRESULT WINAPI mux_GetValue(IPropertyStore *iface, REFPROPERTYKEY key, PROPVARIANT *value)
+{
+    struct multiplex *This = mux_from_iface(iface);
+    DWORD i;
+
+    if (!key || !value) return E_POINTER;
+    PropVariantInit(value);
+    for (i = 0; i < This->count; i++)
+    {
+        IPropertyStore *store = mux_store(This, i);
+        PROPVARIANT pv;
+
+        if (!store) continue;
+        PropVariantInit(&pv);
+        if (SUCCEEDED(IPropertyStore_GetValue(store, key, &pv)) && pv.vt != VT_EMPTY)
+        {
+            *value = pv;
+            return S_OK;
+        }
+        PropVariantClear(&pv);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI mux_SetValue(IPropertyStore *iface, REFPROPERTYKEY key, REFPROPVARIANT value)
+{
+    struct multiplex *This = mux_from_iface(iface);
+    HRESULT hr = STG_E_ACCESSDENIED;
+    DWORD i;
+
+    if (!key || !value) return E_POINTER;
+    for (i = 0; i < This->count; i++)
+    {
+        IPropertyStore *store = mux_store(This, i);
+        PROPVARIANT pv;
+
+        if (!store) continue;
+        /* a store that already holds the property takes the change; otherwise the first writable one */
+        PropVariantInit(&pv);
+        if (SUCCEEDED(IPropertyStore_GetValue(store, key, &pv)) && pv.vt != VT_EMPTY)
+        {
+            PropVariantClear(&pv);
+            return IPropertyStore_SetValue(store, key, value);
+        }
+        PropVariantClear(&pv);
+    }
+    for (i = 0; i < This->count; i++)
+    {
+        IPropertyStore *store = mux_store(This, i);
+        HRESULT h;
+
+        if (!store) continue;
+        if (SUCCEEDED(h = IPropertyStore_SetValue(store, key, value))) return h;
+        hr = h;
+    }
+    return hr;
+}
+
+static HRESULT WINAPI mux_Commit(IPropertyStore *iface)
+{
+    struct multiplex *This = mux_from_iface(iface);
+    HRESULT hr = S_OK;
+    DWORD i;
+
+    for (i = 0; i < This->count; i++)
+    {
+        IPropertyStore *store = mux_store(This, i);
+        HRESULT h;
+
+        if (store && FAILED(h = IPropertyStore_Commit(store)) && SUCCEEDED(hr)) hr = h;
+    }
+    return hr;
+}
+
+static const IPropertyStoreVtbl mux_vtbl =
+{
+    mux_QueryInterface, mux_AddRef, mux_Release, mux_GetCount, mux_GetAt, mux_GetValue, mux_SetValue, mux_Commit
+};
+
+static struct multiplex *mux_alloc(DWORD count)
+{
+    struct multiplex *obj = calloc(1, sizeof(*obj));
+
+    if (!obj) return NULL;
+    obj->IPropertyStore_iface.lpVtbl = &mux_vtbl;
+    obj->ref = 1;
+    obj->count = count;
+    InitializeCriticalSectionEx(&obj->cs, 0, RTL_CRITICAL_SECTION_FLAG_NO_DEBUG_INFO);
+    if (!(obj->stores = calloc(count ? count : 1, sizeof(*obj->stores))))
+    {
+        DeleteCriticalSection(&obj->cs);
+        free(obj);
+        return NULL;
+    }
+    return obj;
+}
+
+HRESULT WINAPI PSCreateMultiplexPropertyStore(IUnknown **units, DWORD count, REFIID riid, void **ppv)
+{
+    struct multiplex *obj;
+    HRESULT hr = S_OK;
+    DWORD i;
+
+    TRACE("%p, %lu, %s, %p\n", units, count, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!units && count) return E_POINTER;
+    if (!(obj = mux_alloc(count))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        if (!units[i] || FAILED(hr = IUnknown_QueryInterface(units[i], &IID_IPropertyStore, (void **)&obj->stores[i])))
+        {
+            if (SUCCEEDED(hr)) hr = E_POINTER;
+            IPropertyStore_Release(&obj->IPropertyStore_iface);
+            return hr;
+        }
+    }
+    hr = IPropertyStore_QueryInterface(&obj->IPropertyStore_iface, riid, ppv);
+    IPropertyStore_Release(&obj->IPropertyStore_iface);
+    return hr;
+}
+
+HRESULT WINAPI PSCreateDelayedMultiplexPropertyStore(GETPROPERTYSTOREFLAGS flags,
+        IDelayedPropertyStoreFactory *factory, const DWORD *ids, DWORD count, REFIID riid, void **ppv)
+{
+    struct multiplex *obj;
+    HRESULT hr;
+
+    TRACE("%#x, %p, %p, %lu, %s, %p\n", flags, factory, ids, count, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!factory || (!ids && count)) return E_POINTER;
+    if (!(obj = mux_alloc(count))) return E_OUTOFMEMORY;
+    if (!(obj->ids = malloc((count ? count : 1) * sizeof(*ids))))
+    {
+        IPropertyStore_Release(&obj->IPropertyStore_iface);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(obj->ids, ids, count * sizeof(*ids));
+    obj->flags = flags;
+    obj->factory = factory;
+    IDelayedPropertyStoreFactory_AddRef(factory);
+    hr = IPropertyStore_QueryInterface(&obj->IPropertyStore_iface, riid, ppv);
+    IPropertyStore_Release(&obj->IPropertyStore_iface);
+    return hr;
+}
+
+/* ---- store over an IPropertySetStorage ---------------------------------------------- */
+
+struct setstore
+{
+    IPropertyStore IPropertyStore_iface;
+    LONG ref;
+    IPropertySetStorage *sets;
+    DWORD mode;
+};
+
+static struct setstore *set_from_iface(IPropertyStore *iface)
+{
+    return CONTAINING_RECORD(iface, struct setstore, IPropertyStore_iface);
+}
+
+static HRESULT WINAPI set_QueryInterface(IPropertyStore *iface, REFIID iid, void **out)
+{
+    if (!out) return E_POINTER;
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IPropertyStore))
+    {
+        *out = iface;
+        IPropertyStore_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI set_AddRef(IPropertyStore *iface)
+{
+    return InterlockedIncrement(&set_from_iface(iface)->ref);
+}
+
+static ULONG WINAPI set_Release(IPropertyStore *iface)
+{
+    struct setstore *This = set_from_iface(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        IPropertySetStorage_Release(This->sets);
+        free(This);
+    }
+    return ref;
+}
+
+/* walks every (set, property) pair; calls cb until it returns FALSE */
+typedef BOOL (*prop_cb)(const GUID *fmtid, PROPID pid, void *ctx);
+
+static void walk_props(struct setstore *This, prop_cb cb, void *ctx)
+{
+    IEnumSTATPROPSETSTG *sets;
+    STATPROPSETSTG ss;
+
+    if (FAILED(IPropertySetStorage_Enum(This->sets, &sets))) return;
+    while (IEnumSTATPROPSETSTG_Next(sets, 1, &ss, NULL) == S_OK)
+    {
+        IPropertyStorage *ps;
+        BOOL go = TRUE;
+
+        if (SUCCEEDED(IPropertySetStorage_Open(This->sets, &ss.fmtid, STGM_READ | STGM_SHARE_EXCLUSIVE, &ps)))
+        {
+            IEnumSTATPROPSTG *props;
+
+            if (SUCCEEDED(IPropertyStorage_Enum(ps, &props)))
+            {
+                STATPROPSTG sp;
+
+                while (go && IEnumSTATPROPSTG_Next(props, 1, &sp, NULL) == S_OK)
+                {
+                    if (!sp.lpwstrName) go = cb(&ss.fmtid, sp.propid, ctx);
+                    CoTaskMemFree(sp.lpwstrName);
+                }
+                IEnumSTATPROPSTG_Release(props);
+            }
+            IPropertyStorage_Release(ps);
+        }
+        if (!go) break;
+    }
+    IEnumSTATPROPSETSTG_Release(sets);
+}
+
+struct count_ctx { DWORD count; };
+static BOOL count_cb(const GUID *fmtid, PROPID pid, void *ctx)
+{
+    ((struct count_ctx *)ctx)->count++;
+    return TRUE;
+}
+
+struct at_ctx { DWORD index; BOOL found; PROPERTYKEY key; };
+static BOOL at_cb(const GUID *fmtid, PROPID pid, void *ctx)
+{
+    struct at_ctx *at = ctx;
+
+    if (at->index--) return TRUE;
+    at->key.fmtid = *fmtid;
+    at->key.pid = pid;
+    at->found = TRUE;
+    return FALSE;
+}
+
+static HRESULT WINAPI set_GetCount(IPropertyStore *iface, DWORD *count)
+{
+    struct count_ctx ctx = { 0 };
+
+    if (!count) return E_POINTER;
+    walk_props(set_from_iface(iface), count_cb, &ctx);
+    *count = ctx.count;
+    return S_OK;
+}
+
+static HRESULT WINAPI set_GetAt(IPropertyStore *iface, DWORD index, PROPERTYKEY *key)
+{
+    struct at_ctx ctx = { index, FALSE };
+
+    if (!key) return E_POINTER;
+    walk_props(set_from_iface(iface), at_cb, &ctx);
+    if (!ctx.found) return E_INVALIDARG;
+    *key = ctx.key;
+    return S_OK;
+}
+
+static HRESULT WINAPI set_GetValue(IPropertyStore *iface, REFPROPERTYKEY key, PROPVARIANT *value)
+{
+    struct setstore *This = set_from_iface(iface);
+    IPropertyStorage *ps;
+    PROPSPEC spec;
+    HRESULT hr;
+
+    if (!key || !value) return E_POINTER;
+    PropVariantInit(value);
+    if (FAILED(IPropertySetStorage_Open(This->sets, &key->fmtid, STGM_READ | STGM_SHARE_EXCLUSIVE, &ps)))
+        return S_OK;
+    spec.ulKind = PRSPEC_PROPID;
+    spec.propid = key->pid;
+    hr = IPropertyStorage_ReadMultiple(ps, 1, &spec, value);
+    IPropertyStorage_Release(ps);
+    if (hr == S_FALSE) { PropVariantInit(value); return S_OK; }
+    return hr;
+}
+
+static HRESULT WINAPI set_SetValue(IPropertyStore *iface, REFPROPERTYKEY key, REFPROPVARIANT value)
+{
+    struct setstore *This = set_from_iface(iface);
+    IPropertyStorage *ps;
+    PROPSPEC spec;
+    HRESULT hr;
+
+    if (!key || !value) return E_POINTER;
+    if ((This->mode & (STGM_WRITE | STGM_READWRITE)) == 0) return STG_E_ACCESSDENIED;
+    hr = IPropertySetStorage_Open(This->sets, &key->fmtid, STGM_READWRITE | STGM_SHARE_EXCLUSIVE, &ps);
+    if (FAILED(hr))
+        hr = IPropertySetStorage_Create(This->sets, &key->fmtid, NULL, PROPSETFLAG_DEFAULT,
+                STGM_READWRITE | STGM_SHARE_EXCLUSIVE, &ps);
+    if (FAILED(hr)) return hr;
+    spec.ulKind = PRSPEC_PROPID;
+    spec.propid = key->pid;
+    hr = IPropertyStorage_WriteMultiple(ps, 1, &spec, value, PID_FIRST_USABLE);
+    if (SUCCEEDED(hr)) hr = IPropertyStorage_Commit(ps, STGC_DEFAULT);
+    IPropertyStorage_Release(ps);
+    return hr;
+}
+
+static HRESULT WINAPI set_Commit(IPropertyStore *iface)
+{
+    return S_OK;
+}
+
+static const IPropertyStoreVtbl set_vtbl =
+{
+    set_QueryInterface, set_AddRef, set_Release, set_GetCount, set_GetAt, set_GetValue, set_SetValue, set_Commit
+};
+
+HRESULT WINAPI PSCreatePropertyStoreFromPropertySetStorage(IPropertySetStorage *sets, DWORD mode, REFIID riid,
+        void **ppv)
+{
+    struct setstore *obj;
+    HRESULT hr;
+
+    TRACE("%p, %#lx, %s, %p\n", sets, mode, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!sets) return E_POINTER;
+    if (!(obj = calloc(1, sizeof(*obj)))) return E_OUTOFMEMORY;
+    obj->IPropertyStore_iface.lpVtbl = &set_vtbl;
+    obj->ref = 1;
+    obj->sets = sets;
+    obj->mode = mode;
+    IPropertySetStorage_AddRef(sets);
+    hr = IPropertyStore_QueryInterface(&obj->IPropertyStore_iface, riid, ppv);
+    IPropertyStore_Release(&obj->IPropertyStore_iface);
+    return hr;
+}
