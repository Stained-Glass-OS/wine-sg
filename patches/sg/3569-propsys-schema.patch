+/* ---- IPropertyChange / IPropertyChangeArray ----------------------------------------- */
+
+struct change
+{
+    IPropertyChange IPropertyChange_iface;
+    LONG ref;
+    PROPERTYKEY key;
+    PKA_FLAGS flags;
+    PROPVARIANT value;
+};
+
+static struct change *change_from_iface(IPropertyChange *iface)
+{
+    return CONTAINING_RECORD(iface, struct change, IPropertyChange_iface);
+}
+
+static HRESULT WINAPI change_QueryInterface(IPropertyChange *iface, REFIID iid, void **out)
+{
+    if (!out) return E_POINTER;
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IObjectWithPropertyKey)
+            || IsEqualIID(iid, &IID_IPropertyChange))
+    {
+        *out = iface;
+        IPropertyChange_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI change_AddRef(IPropertyChange *iface)
+{
+    return InterlockedIncrement(&change_from_iface(iface)->ref);
+}
+
+static ULONG WINAPI change_Release(IPropertyChange *iface)
+{
+    struct change *This = change_from_iface(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        PropVariantClear(&This->value);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI change_SetPropertyKey(IPropertyChange *iface, REFPROPERTYKEY key)
+{
+    if (!key) return E_POINTER;
+    change_from_iface(iface)->key = *key;
+    return S_OK;
+}
+
+static HRESULT WINAPI change_GetPropertyKey(IPropertyChange *iface, PROPERTYKEY *key)
+{
+    if (!key) return E_POINTER;
+    *key = change_from_iface(iface)->key;
+    return S_OK;
+}
+
+static HRESULT append_value(const PROPVARIANT *in, const PROPVARIANT *add, PROPVARIANT *out)
+{
+    VARTYPE elem = add->vt & ~VT_VECTOR;
+    PROPVARIANT vec, extra;
+    HRESULT hr;
+    ULONG n1, n2, i;
+
+    /* the result is a vector of the added value's type */
+    if (in->vt == VT_EMPTY)
+        return InitPropVariantVectorFromPropVariant(add, out);
+    if ((in->vt & ~VT_VECTOR) != elem) return DISP_E_TYPEMISMATCH;
+
+    PropVariantInit(&vec);
+    PropVariantInit(&extra);
+    if (FAILED(hr = InitPropVariantVectorFromPropVariant(in, &vec))) return hr;
+    if (FAILED(hr = InitPropVariantVectorFromPropVariant(add, &extra))) { PropVariantClear(&vec); return hr; }
+    n1 = vec.caub.cElems;
+    n2 = extra.caub.cElems;
+    if (elem == VT_LPWSTR)
+    {
+        PROPVARIANT res;
+        LPWSTR *items = CoTaskMemAlloc((n1 + n2) * sizeof(*items));
+
+        if (!items) hr = E_OUTOFMEMORY;
+        else
+        {
+            for (i = 0; i < n1; i++) items[i] = vec.calpwstr.pElems[i];
+            for (i = 0; i < n2; i++) items[n1 + i] = extra.calpwstr.pElems[i];
+            res.vt = VT_LPWSTR | VT_VECTOR;
+            res.calpwstr.cElems = n1 + n2;
+            res.calpwstr.pElems = items;
+            /* ownership of the strings moves into the result */
+            CoTaskMemFree(vec.calpwstr.pElems);
+            CoTaskMemFree(extra.calpwstr.pElems);
+            *out = res;
+            return S_OK;
+        }
+    }
+    else
+    {
+        static const struct { VARTYPE vt; UINT size; } sizes[] = {
+            { VT_I1, 1 }, { VT_UI1, 1 }, { VT_I2, 2 }, { VT_UI2, 2 }, { VT_I4, 4 }, { VT_UI4, 4 },
+            { VT_I8, 8 }, { VT_UI8, 8 }, { VT_R4, 4 }, { VT_R8, 8 }, { VT_BOOL, 2 }, { VT_FILETIME, 8 } };
+        UINT size = 0;
+        BYTE *data;
+
+        for (i = 0; i < ARRAY_SIZE(sizes); i++) if (sizes[i].vt == elem) size = sizes[i].size;
+        if (!size) hr = DISP_E_TYPEMISMATCH;
+        else if (!(data = CoTaskMemAlloc((SIZE_T)(n1 + n2) * size))) hr = E_OUTOFMEMORY;
+        else
+        {
+            memcpy(data, vec.caub.pElems, (SIZE_T)n1 * size);
+            memcpy(data + (SIZE_T)n1 * size, extra.caub.pElems, (SIZE_T)n2 * size);
+            out->vt = elem | VT_VECTOR;
+            out->caub.cElems = n1 + n2;
+            out->caub.pElems = data;
+            hr = S_OK;
+        }
+    }
+    PropVariantClear(&vec);
+    PropVariantClear(&extra);
+    return hr;
+}
+
+static HRESULT WINAPI change_ApplyToPropVariant(IPropertyChange *iface, REFPROPVARIANT in, PROPVARIANT *out)
+{
+    struct change *This = change_from_iface(iface);
+
+    if (!in || !out) return E_POINTER;
+    switch (This->flags)
+    {
+    case PKA_SET:
+        return PropVariantCopy(out, &This->value);
+    case PKA_APPEND:
+    {
+        PROPVARIANT res;
+        HRESULT hr;
+
+        PropVariantInit(&res);
+        if (FAILED(hr = append_value(in, &This->value, &res))) return hr;
+        *out = res;
+        return S_OK;
+    }
+    case PKA_DELETE:
+        PropVariantInit(out);
+        return S_OK;
+    default:
+        return E_INVALIDARG;
+    }
+}
+
+static const IPropertyChangeVtbl change_vtbl =
+{
+    change_QueryInterface, change_AddRef, change_Release, change_SetPropertyKey, change_GetPropertyKey,
+    change_ApplyToPropVariant
+};
+
+static HRESULT change_create(PKA_FLAGS flags, const PROPERTYKEY *key, const PROPVARIANT *value, REFIID riid,
+        void **ppv)
+{
+    struct change *obj;
+    HRESULT hr;
+
+    if (!(obj = calloc(1, sizeof(*obj)))) return E_OUTOFMEMORY;
+    obj->IPropertyChange_iface.lpVtbl = &change_vtbl;
+    obj->ref = 1;
+    obj->key = *key;
+    obj->flags = flags;
+    if (value && FAILED(hr = PropVariantCopy(&obj->value, value)))
+    {
+        free(obj);
+        return hr;
+    }
+    hr = IPropertyChange_QueryInterface(&obj->IPropertyChange_iface, riid, ppv);
+    IPropertyChange_Release(&obj->IPropertyChange_iface);
+    return hr;
+}
+
+HRESULT WINAPI PSCreateSimplePropertyChange(PKA_FLAGS flags, REFPROPERTYKEY key, REFPROPVARIANT value,
+        REFIID riid, void **ppv)
+{
+    TRACE("%d, %p, %p, %s, %p\n", flags, key, value, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!key || !value) return E_POINTER;
+    if (flags < PKA_SET || flags > PKA_DELETE) return E_INVALIDARG;
+    return change_create(flags, key, value, riid, ppv);
+}
+
+struct change_array
+{
+    IPropertyChangeArray IPropertyChangeArray_iface;
+    LONG ref;
+    IPropertyChange **items;
+    UINT count, capacity;
+};
+
+static struct change_array *array_from_iface(IPropertyChangeArray *iface)
+{
+    return CONTAINING_RECORD(iface, struct change_array, IPropertyChangeArray_iface);
+}
+
+static HRESULT WINAPI array_QueryInterface(IPropertyChangeArray *iface, REFIID iid, void **out)
+{
+    if (!out) return E_POINTER;
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IPropertyChangeArray))
+    {
+        *out = iface;
+        IPropertyChangeArray_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI array_AddRef(IPropertyChangeArray *iface)
+{
+    return InterlockedIncrement(&array_from_iface(iface)->ref);
+}
+
+static ULONG WINAPI array_Release(IPropertyChangeArray *iface)
+{
+    struct change_array *This = array_from_iface(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        UINT i;
+        for (i = 0; i < This->count; i++) IPropertyChange_Release(This->items[i]);
+        free(This->items);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI array_GetCount(IPropertyChangeArray *iface, UINT *count)
+{
+    if (!count) return E_POINTER;
+    *count = array_from_iface(iface)->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI array_GetAt(IPropertyChangeArray *iface, UINT index, REFIID riid, void **ppv)
+{
+    struct change_array *This = array_from_iface(iface);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (index >= This->count) return E_INVALIDARG;
+    return IPropertyChange_QueryInterface(This->items[index], riid, ppv);
+}
+
+static HRESULT array_insert(struct change_array *This, UINT index, IPropertyChange *change)
+{
+    if (!change) return E_POINTER;
+    if (index > This->count) return E_INVALIDARG;
+    if (This->count == This->capacity)
+    {
+        UINT cap = This->capacity ? This->capacity * 2 : 4;
+        IPropertyChange **n = realloc(This->items, cap * sizeof(*n));
+
+        if (!n) return E_OUTOFMEMORY;
+        This->items = n;
+        This->capacity = cap;
+    }
+    memmove(&This->items[index + 1], &This->items[index], (This->count - index) * sizeof(*This->items));
+    This->items[index] = change;
+    IPropertyChange_AddRef(change);
+    This->count++;
+    return S_OK;
+}
+
+static HRESULT WINAPI array_InsertAt(IPropertyChangeArray *iface, UINT index, IPropertyChange *change)
+{
+    return array_insert(array_from_iface(iface), index, change);
+}
+
+static HRESULT WINAPI array_Append(IPropertyChangeArray *iface, IPropertyChange *change)
+{
+    struct change_array *This = array_from_iface(iface);
+    return array_insert(This, This->count, change);
+}
+
+static int array_find(struct change_array *This, const PROPERTYKEY *key)
+{
+    UINT i;
+
+    for (i = 0; i < This->count; i++)
+    {
+        PROPERTYKEY k;
+
+        if (SUCCEEDED(IPropertyChange_GetPropertyKey(This->items[i], &k)) && IsEqualPropertyKey(k, *key))
+            return i;
+    }
+    return -1;
+}
+
+static HRESULT WINAPI array_AppendOrReplace(IPropertyChangeArray *iface, IPropertyChange *change)
+{
+    struct change_array *This = array_from_iface(iface);
+    PROPERTYKEY key;
+    HRESULT hr;
+    int idx;
+
+    if (!change) return E_POINTER;
+    if (FAILED(hr = IPropertyChange_GetPropertyKey(change, &key))) return hr;
+    if ((idx = array_find(This, &key)) < 0) return array_insert(This, This->count, change);
+    IPropertyChange_AddRef(change);
+    IPropertyChange_Release(This->items[idx]);
+    This->items[idx] = change;
+    return S_OK;
+}
+
+static HRESULT WINAPI array_RemoveAt(IPropertyChangeArray *iface, UINT index)
+{
+    struct change_array *This = array_from_iface(iface);
+
+    if (index >= This->count) return E_INVALIDARG;
+    IPropertyChange_Release(This->items[index]);
+    memmove(&This->items[index], &This->items[index + 1], (This->count - index - 1) * sizeof(*This->items));
+    This->count--;
+    return S_OK;
+}
+
+static HRESULT WINAPI array_IsKeyInArray(IPropertyChangeArray *iface, REFPROPERTYKEY key)
+{
+    if (!key) return E_POINTER;
+    return array_find(array_from_iface(iface), key) >= 0 ? S_OK : S_FALSE;
+}
+
+static const IPropertyChangeArrayVtbl array_vtbl =
+{
+    array_QueryInterface, array_AddRef, array_Release, array_GetCount, array_GetAt, array_InsertAt, array_Append,
+    array_AppendOrReplace, array_RemoveAt, array_IsKeyInArray
+};
+
+HRESULT WINAPI PSCreatePropertyChangeArray(const PROPERTYKEY *keys, const PKA_FLAGS *flags,
+        const PROPVARIANT *values, UINT count, REFIID riid, void **ppv)
+{
+    struct change_array *obj;
+    HRESULT hr = S_OK;
+    UINT i;
+
+    TRACE("%p, %p, %p, %u, %s, %p\n", keys, flags, values, count, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (count && (!keys || !flags || !values)) return E_POINTER;
+    if (!(obj = calloc(1, sizeof(*obj)))) return E_OUTOFMEMORY;
+    obj->IPropertyChangeArray_iface.lpVtbl = &array_vtbl;
+    obj->ref = 1;
+    for (i = 0; i < count && SUCCEEDED(hr); i++)
+    {
+        IPropertyChange *change;
+
+        if (SUCCEEDED(hr = PSCreateSimplePropertyChange(flags[i], &keys[i], &values[i], &IID_IPropertyChange,
+                (void **)&change)))
+        {
+            hr = array_insert(obj, obj->count, change);
+            IPropertyChange_Release(change);
+        }
+    }
+    if (SUCCEEDED(hr)) hr = IPropertyChangeArray_QueryInterface(&obj->IPropertyChangeArray_iface, riid, ppv);
+    IPropertyChangeArray_Release(&obj->IPropertyChangeArray_iface);
+    return hr;
+}
+
+/* ---- serialized property storage ----------------------------------------------------- */
+
+#include "pshpack1.h"
+struct sps_header { DWORD size; DWORD version; GUID fmtid; };
+struct sps_value { DWORD size; DWORD id; BYTE reserved; };
+#include "poppack.h"
+
+#define SPS_VERSION 0x53505331  /* "1SPS" */
+
+static const GUID FMTID_Named = { 0xd5cdd505, 0x2e9c, 0x101b, { 0x93, 0x97, 0x08, 0x00, 0x2b, 0x2c, 0xf9, 0xae } };
+
+/* walks the values of the storage blocks in [psps, psps + cb); the callback returns TRUE to stop */
+typedef BOOL (*sps_cb)(const GUID *fmtid, const struct sps_value *val, const BYTE *name, DWORD name_len,
+        const SERIALIZEDPROPERTYVALUE *prop, ULONG prop_len, void *ctx);
+
+static HRESULT sps_walk(const BYTE *psps, DWORD cb, sps_cb cb_fn, void *ctx)
+{
+    DWORD pos = 0;
+
+    while (pos + sizeof(DWORD) <= cb)
+    {
+        const struct sps_header *hdr = (const struct sps_header *)(psps + pos);
+        DWORD end, vpos;
+
+        if (!hdr->size) return S_OK;  /* terminator */
+        if (hdr->size < sizeof(*hdr) || pos + hdr->size > cb) return E_INVALIDARG;
+        if (hdr->version != SPS_VERSION) return E_INVALIDARG;
+        end = pos + hdr->size;
+        vpos = pos + sizeof(*hdr);
+        while (vpos + sizeof(DWORD) <= end)
+        {
+            const struct sps_value *val = (const struct sps_value *)(psps + vpos);
+            const BYTE *name = NULL;
+            DWORD name_len = 0, data_off = sizeof(*val);
+
+            if (!val->size) break;
+            if (val->size < sizeof(*val) || vpos + val->size > end) return E_INVALIDARG;
+            if (IsEqualGUID(&hdr->fmtid, &FMTID_Named))
+            {
+                name_len = val->id;
+                if (sizeof(*val) + name_len > val->size) return E_INVALIDARG;
+                name = (const BYTE *)(val + 1);
+                data_off += name_len;
+            }
+            if (data_off + sizeof(DWORD) > val->size) return E_INVALIDARG;
+            if (cb_fn(&hdr->fmtid, val, name, name_len, (const SERIALIZEDPROPERTYVALUE *)(psps + vpos + data_off),
+                    val->size - data_off, ctx))
+                return S_OK;
+            vpos += val->size;
+        }
+        pos = end;
+    }
+    return S_OK;
+}
+
+struct find_ctx
+{
+    const PROPERTYKEY *key;
+    const WCHAR *name;
+    PROPVARIANT *out;
+    HRESULT hr;
+    BOOL found;
+};
+
+static BOOL find_cb(const GUID *fmtid, const struct sps_value *val, const BYTE *name, DWORD name_len,
+        const SERIALIZEDPROPERTYVALUE *prop, ULONG prop_len, void *ctx)
+{
+    struct find_ctx *f = ctx;
+
+    if (f->name)
+    {
+        WCHAR buf[256];
+
+        if (!name || name_len < sizeof(WCHAR) || name_len >= sizeof(buf)) return FALSE;
+        memcpy(buf, name, name_len);
+        buf[name_len / sizeof(WCHAR) - 1] = 0;
+        if (wcsicmp(buf, f->name)) return FALSE;
+    }
+    else
+    {
+        if (!IsEqualGUID(fmtid, &f->key->fmtid) || val->id != f->key->pid) return FALSE;
+    }
+    f->found = TRUE;
+    f->hr = StgDeserializePropVariant(prop, prop_len, f->out);
+    return TRUE;
+}
+
+HRESULT WINAPI PSGetPropertyFromPropertyStorage(PCUSERIALIZEDPROPSTORAGE psps, DWORD cb, REFPROPERTYKEY key,
+        PROPVARIANT *value)
+{
+    struct find_ctx ctx = { key, NULL, value, S_OK, FALSE };
+    HRESULT hr;
+
+    TRACE("%p, %lu, %p, %p\n", psps, cb, key, value);
+
+    if (!value) return E_POINTER;
+    PropVariantInit(value);
+    if (!psps || !key) return E_POINTER;
+    if (FAILED(hr = sps_walk((const BYTE *)psps, cb, find_cb, &ctx))) return hr;
+    return ctx.found ? ctx.hr : HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+}
+
+HRESULT WINAPI PSGetNamedPropertyFromPropertyStorage(PCUSERIALIZEDPROPSTORAGE psps, DWORD cb, LPCWSTR name,
+        PROPVARIANT *value)
+{
+    struct find_ctx ctx = { NULL, name, value, S_OK, FALSE };
+    HRESULT hr;
+
+    TRACE("%p, %lu, %s, %p\n", psps, cb, debugstr_w(name), value);
+
+    if (!value) return E_POINTER;
+    PropVariantInit(value);
+    if (!psps || !name) return E_POINTER;
+    if (FAILED(hr = sps_walk((const BYTE *)psps, cb, find_cb, &ctx))) return hr;
+    return ctx.found ? ctx.hr : HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+}
+
+/* ---- property handlers --------------------------------------------------------------- */
+
+static const WCHAR handlers_key[] =
+    L"Software\\Microsoft\\Windows\\CurrentVersion\\PropertySystem\\PropertyHandlers";
+
+HRESULT WINAPI PSLookupPropertyHandlerCLSID(PCWSTR path, CLSID *clsid)
+{
+    const WCHAR *ext;
+    WCHAR keyname[300], value[80];
+    DWORD size = sizeof(value);
+    HKEY key;
+    LONG ls;
+
+    TRACE("%s, %p\n", debugstr_w(path), clsid);
+
+    if (!clsid) return E_POINTER;
+    memset(clsid, 0, sizeof(*clsid));
+    if (!path) return E_POINTER;
+
+    ext = PathFindExtensionW(path);
+    if (!ext || !*ext || wcslen(ext) > 200) return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    swprintf(keyname, ARRAY_SIZE(keyname), L"%s\\%s", handlers_key, ext);
+    if ((ls = RegOpenKeyExW(HKEY_LOCAL_MACHINE, keyname, 0, KEY_READ, &key)))
+        return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    ls = RegQueryValueExW(key, NULL, NULL, NULL, (BYTE *)value, &size);
+    RegCloseKey(key);
+    if (ls) return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    value[ARRAY_SIZE(value) - 1] = 0;
+    return CLSIDFromString(value, clsid);
+}
+
+HRESULT WINAPI PSGetItemPropertyHandlerWithCreateObject(IUnknown *item, BOOL read_write, IUnknown *create_object,
+        REFIID riid, void **ppv)
+{
+    IShellItem *shitem = NULL;
+    IUnknown *handler = NULL;
+    WCHAR *path = NULL;
+    DWORD mode = read_write ? STGM_READWRITE : STGM_READ;
+    CLSID clsid;
+    HRESULT hr;
+
+    TRACE("%p, %d, %p, %s, %p\n", item, read_write, create_object, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!item) return E_POINTER;
+
+    if (FAILED(hr = IUnknown_QueryInterface(item, &IID_IShellItem, (void **)&shitem))) return hr;
+    if (FAILED(hr = IShellItem_GetDisplayName(shitem, SIGDN_FILESYSPATH, &path))) goto done;
+    if (FAILED(hr = PSLookupPropertyHandlerCLSID(path, &clsid))) goto done;
+
+    {
+        ICreateObject *creator = NULL;
+
+        if (create_object && SUCCEEDED(IUnknown_QueryInterface(create_object, &IID_ICreateObject, (void **)&creator)))
+        {
+            hr = ICreateObject_CreateObject(creator, &clsid, NULL, &IID_IUnknown, (void **)&handler);
+            ICreateObject_Release(creator);
+        }
+        else
+            hr = CoCreateInstance(&clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)&handler);
+    }
+    if (FAILED(hr)) goto done;
+
+    {
+        IInitializeWithItem *with_item;
+        IInitializeWithFile *with_file;
+        IInitializeWithStream *with_stream;
+
+        if (SUCCEEDED(IUnknown_QueryInterface(handler, &IID_IInitializeWithItem, (void **)&with_item)))
+        {
+            hr = IInitializeWithItem_Initialize(with_item, shitem, mode);
+            IInitializeWithItem_Release(with_item);
+        }
+        else if (SUCCEEDED(IUnknown_QueryInterface(handler, &IID_IInitializeWithFile, (void **)&with_file)))
+        {
+            hr = IInitializeWithFile_Initialize(with_file, path, mode);
+            IInitializeWithFile_Release(with_file);
+        }
+        else if (SUCCEEDED(IUnknown_QueryInterface(handler, &IID_IInitializeWithStream, (void **)&with_stream)))
+        {
+            IStream *stream;
+
+            if (SUCCEEDED(hr = SHCreateStreamOnFileEx(path, mode | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream)))
+            {
+                hr = IInitializeWithStream_Initialize(with_stream, stream, mode);
+                IStream_Release(stream);
+            }
+            IInitializeWithStream_Release(with_stream);
+        }
+    }
+    if (SUCCEEDED(hr)) hr = IUnknown_QueryInterface(handler, riid, ppv);
+
+done:
+    if (handler) IUnknown_Release(handler);
+    CoTaskMemFree(path);
+    IShellItem_Release(shitem);
+    return hr;
+}
+
+HRESULT WINAPI PSGetItemPropertyHandler(IUnknown *item, BOOL read_write, REFIID riid, void **ppv)
+{
+    return PSGetItemPropertyHandlerWithCreateObject(item, read_write, NULL, riid, ppv);
+}
