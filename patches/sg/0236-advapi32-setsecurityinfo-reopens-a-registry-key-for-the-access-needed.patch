From: Stained Glass OS <dev@stained-glass.example>
Subject: advapi32: SetSecurityInfo reopens a registry key for the access the change needs

Google's updater creates HKLM\...\ClientStateMedium with KEY_WRITE and sets
its DACL through that handle (ATL's AtlSetDacl -> SetSecurityInfo). Windows
does this: its security API reopens a registry key for WRITE_DAC /
WRITE_OWNER / ACCESS_SYSTEM_SECURITY when the handle lacks them. Wine failed
with ERROR_ACCESS_DENIED, and the updater's COM service shut down. Now, when
NtSetSecurityObject on a key is denied, the key is reopened relative to the
handle with the needed access (the ordinary access check decides) and the
change retried.

Gate: test/appfix-gate.sh.
---
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -3253,8 +3253,31 @@
     case SE_FILE_OBJECT:
     case SE_KERNEL_OBJECT:
     case SE_WMIGUID_OBJECT:
+        status = NtSetSecurityObject(handle, SecurityInfo, &sd);
+        break;
+
     case SE_REGISTRY_KEY:
         status = NtSetSecurityObject(handle, SecurityInfo, &sd);
+        if (status == STATUS_ACCESS_DENIED)
+        {
+            /* Like Windows, reopen the key with the access the change needs:
+             * a key opened for writing only (Google's updater's service does
+             * that) may still have its DACL set by whoever may do so. */
+            static UNICODE_STRING empty = { 0 };
+            OBJECT_ATTRIBUTES attr;
+            ACCESS_MASK access = 0;
+            HANDLE key;
+
+            if (SecurityInfo & (OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION)) access |= WRITE_OWNER;
+            if (SecurityInfo & DACL_SECURITY_INFORMATION) access |= WRITE_DAC;
+            if (SecurityInfo & SACL_SECURITY_INFORMATION) access |= ACCESS_SYSTEM_SECURITY;
+            InitializeObjectAttributes(&attr, &empty, 0, handle, NULL);
+            if (access && !NtOpenKeyEx(&key, access, &attr, 0))
+            {
+                status = NtSetSecurityObject(key, SecurityInfo, &sd);
+                NtClose(key);
+            }
+        }
         break;
 
     default:
