+/***********************************************************************
+ *           CLIPOBJ_bEnum    (GDI32.@)
+ */
+BOOL WINAPI CLIPOBJ_bEnum( CLIPOBJ *clip, ULONG size, ULONG *buf )
+{
+    ENUMRECTS *rects = (ENUMRECTS *)buf;
+    if (size < sizeof(ENUMRECTS)) return FALSE;
+    rects->c = clip ? 1 : 0;
+    if (clip) rects->arcl[0] = clip->rclBounds;
+    return FALSE;
+}
