+/***********************************************************************
+ *           EngCopyBits    (GDI32.@)
+ */
+BOOL WINAPI EngCopyBits( SURFOBJ *dst, SURFOBJ *src, CLIPOBJ *clip, XLATEOBJ *xlate, RECTL *rect, POINTL *pt )
+{
+    return EngBitBlt( dst, src, NULL, clip, xlate, rect, pt, NULL, NULL, NULL, 0xcccc );
+}
+
+/***********************************************************************
+ *           EngEraseSurface    (GDI32.@)
+ */
+BOOL WINAPI EngEraseSurface( SURFOBJ *so, RECTL *rect, ULONG color )
+{
+    if (!bitmap_surface( so ) || !rect) return FALSE;
+    fill_rect( so, rect, color );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           EngStretchBlt    (GDI32.@)
+ */
+BOOL WINAPI EngStretchBlt( SURFOBJ *dst, SURFOBJ *src, SURFOBJ *mask, CLIPOBJ *clip, XLATEOBJ *xlate,
+                           void *ca, POINTL *brush_org, RECTL *dst_rect, RECTL *src_rect, POINTL *mask_pt,
+                           ULONG mode )
+{
+    POINTL pt;
+    if (!dst_rect || !src_rect) return FALSE;
+    if (dst_rect->right - dst_rect->left != src_rect->right - src_rect->left ||
+        dst_rect->bottom - dst_rect->top != src_rect->bottom - src_rect->top)
+    {
+        FIXME( "scaling not supported\n" );
+        return FALSE;
+    }
+    pt.x = src_rect->left;
+    pt.y = src_rect->top;
+    return EngBitBlt( dst, src, mask, clip, xlate, dst_rect, &pt, mask_pt, NULL, NULL, 0xcccc );
+}
+
+/***********************************************************************
+ *           BRUSHOBJ_ulGetBrushColor    (GDI32.@)
+ */
+ULONG WINAPI BRUSHOBJ_ulGetBrushColor( BRUSHOBJ *brush )
+{
+    return brush ? brush->iSolidColor : 0;
+}
+
+/***********************************************************************
+ *           XLATEOBJ_iXlate    (GDI32.@)
+ */
+ULONG WINAPI XLATEOBJ_iXlate( XLATEOBJ *xlate, ULONG color )
+{
+    if (xlate && xlate->pulXlate && color < xlate->cEntries) return xlate->pulXlate[color];
+    return color;
+}
