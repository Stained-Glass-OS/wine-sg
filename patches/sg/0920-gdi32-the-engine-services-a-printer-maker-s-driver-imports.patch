+/*
+ * A printer graphics driver running in user mode imports these from gdi32:
+ * it makes its drawing surface with EngCreateBitmap, ties it to the device
+ * with EngAssociateSurface and sends its output with EngWritePrinter.  The
+ * print processor that hosts the driver draws the job's pages into that
+ * surface.  Drivers that draw through the engine's own drawing services get
+ * the simple cases (copies and solid fills); the rest answer that they could
+ * not draw.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winspool.h"
+#include "ddk/winddi.h"
+#include "wine/printdrv.h"
+#include "wine/list.h"
+#include "wine/exception.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(gdi);
+
+#define SURFACE_MAGIC 0x46525553
+
+struct eng_surface
+{
+    SURFOBJ  so;         /* first: EngLockSurface hands it out */
+    DWORD    magic;
+    BYTE    *alloc;      /* bits we allocated */
+    FLONG    hooks;
+    BOOL     banding;
+};
+
+struct device_entry
+{
+    struct list entry;
+    struct wine_eng_device *dev;
+};
+
+static struct list devices = LIST_INIT( devices );
+static CRITICAL_SECTION eng_cs;
+static CRITICAL_SECTION_DEBUG eng_cs_debug =
+{
+    0, 0, &eng_cs,
+    { &eng_cs_debug.ProcessLocksList, &eng_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": eng_cs") }
+};
+static CRITICAL_SECTION eng_cs = { &eng_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct eng_surface *get_surface( HSURF hsurf )
+{
+    struct eng_surface *surf = (struct eng_surface *)hsurf;
+    if (!surf) return NULL;
+    __TRY
+    {
+        if (surf->magic != SURFACE_MAGIC) surf = NULL;
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        surf = NULL;
+    }
+    __ENDTRY
+    return surf;
+}
+
+static struct wine_eng_device *get_device( HDEV hdev )
+{
+    struct wine_eng_device *dev = (struct wine_eng_device *)hdev;
+    return dev && dev->magic == WINE_ENG_DEVICE_MAGIC ? dev : NULL;
+}
+
+/***********************************************************************
+ *           __wine_eng_register_device    (GDI32.@)
+ */
+BOOL WINAPI __wine_eng_register_device( struct wine_eng_device *dev, BOOL add )
+{
+    struct device_entry *entry, *next;
+
+    EnterCriticalSection( &eng_cs );
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &devices, struct device_entry, entry )
+    {
+        if (entry->dev != dev) continue;
+        list_remove( &entry->entry );
+        free( entry );
+    }
+    if (add && (entry = malloc( sizeof(*entry) )))
+    {
+        entry->dev = dev;
+        list_add_head( &devices, &entry->entry );
+    }
+    LeaveCriticalSection( &eng_cs );
+    return TRUE;
+}
+
+static int format_bpp( ULONG format )
+{
+    switch (format)
+    {
+    case BMF_1BPP:  return 1;
+    case BMF_4BPP:  return 4;
+    case BMF_8BPP:  return 8;
+    case BMF_16BPP: return 16;
+    case BMF_24BPP: return 24;
+    case BMF_32BPP: return 32;
+    }
+    return 0;
+}
+
+/***********************************************************************
+ *           EngCreateBitmap    (GDI32.@)
+ */
+HSURF WINAPI EngCreateBitmap( SIZEL size, LONG width, ULONG format, FLONG flags, void *bits )
+{
+    struct eng_surface *surf;
+    int bpp = format_bpp( format );
+    LONG stride;
+
+    TRACE( "%ldx%ld width %ld format %lu flags %#lx bits %p\n", size.cx, size.cy, width, format, flags, bits );
+    if (!bpp || size.cx <= 0 || size.cy <= 0) return NULL;
+    stride = width > 0 ? width : ((size.cx * bpp + 31) / 32) * 4;
+    if (!(surf = calloc( 1, sizeof(*surf) ))) return NULL;
+    if (!bits)
+    {
+        if (!(surf->alloc = (flags & BMF_NOZEROINIT) ? malloc( (SIZE_T)stride * size.cy )
+                                                       : calloc( size.cy, stride )))
+        {
+            free( surf );
+            return NULL;
+        }
+        bits = surf->alloc;
+    }
+    surf->magic = SURFACE_MAGIC;
+    surf->so.hsurf = (HSURF)surf;
+    surf->so.sizlBitmap = size;
+    surf->so.cjBits = stride * size.cy;
+    surf->so.pvBits = bits;
+    if (flags & BMF_TOPDOWN)
+    {
+        surf->so.pvScan0 = bits;
+        surf->so.lDelta = stride;
+    }
+    else
+    {
+        surf->so.pvScan0 = (BYTE *)bits + (SIZE_T)stride * (size.cy - 1);
+        surf->so.lDelta = -stride;
+    }
+    surf->so.iUniq = 1;
+    surf->so.iBitmapFormat = format;
+    surf->so.iType = STYPE_BITMAP;
+    surf->so.fjBitmap = flags & BMF_TOPDOWN;
+    return (HSURF)surf;
+}
+
+/***********************************************************************
+ *           EngCreateDeviceSurface    (GDI32.@)
+ */
+HSURF WINAPI EngCreateDeviceSurface( DHSURF dhsurf, SIZEL size, ULONG format )
+{
+    struct eng_surface *surf;
+
+    TRACE( "%p %ldx%ld %lu\n", dhsurf, size.cx, size.cy, format );
+    if (!(surf = calloc( 1, sizeof(*surf) ))) return NULL;
+    surf->magic = SURFACE_MAGIC;
+    surf->so.dhsurf = dhsurf;
+    surf->so.hsurf = (HSURF)surf;
+    surf->so.sizlBitmap = size;
+    surf->so.iBitmapFormat = format;
+    surf->so.iType = STYPE_DEVICE;
+    return (HSURF)surf;
+}
+
+/***********************************************************************
+ *           EngCreateDeviceBitmap    (GDI32.@)
+ */
+HBITMAP WINAPI EngCreateDeviceBitmap( DHSURF dhsurf, SIZEL size, ULONG format )
+{
+    struct eng_surface *surf = (struct eng_surface *)EngCreateDeviceSurface( dhsurf, size, format );
+    if (surf) surf->so.iType = STYPE_DEVBITMAP;
+    return (HBITMAP)surf;
+}
+
+/***********************************************************************
+ *           EngAssociateSurface    (GDI32.@)
+ */
+BOOL WINAPI EngAssociateSurface( HSURF hsurf, HDEV hdev, FLONG hooks )
+{
+    struct eng_surface *surf = get_surface( hsurf );
+    struct wine_eng_device *dev = get_device( hdev );
+
+    TRACE( "%p %p %#lx\n", hsurf, hdev, hooks );
+    if (!surf) return FALSE;
+    surf->so.hdev = hdev;
+    surf->hooks = hooks;
+    if (dev)
+    {
+        surf->so.dhpdev = dev->dhpdev;
+        dev->surface = hsurf;
+        if (surf->banding) dev->banding = TRUE;
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *           EngMarkBandingSurface    (GDI32.@)
+ */
+BOOL WINAPI EngMarkBandingSurface( HSURF hsurf )
+{
+    struct eng_surface *surf = get_surface( hsurf );
+    struct wine_eng_device *dev;
+
+    TRACE( "%p\n", hsurf );
+    if (!surf) return FALSE;
+    surf->banding = TRUE;
+    if ((dev = get_device( surf->so.hdev ))) dev->banding = TRUE;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           EngDeleteSurface    (GDI32.@)
+ */
+BOOL WINAPI EngDeleteSurface( HSURF hsurf )
+{
+    struct eng_surface *surf = get_surface( hsurf );
+    struct wine_eng_device *dev;
+
+    TRACE( "%p\n", hsurf );
+    if (!surf) return FALSE;
+    if ((dev = get_device( surf->so.hdev )) && dev->surface == hsurf) dev->surface = NULL;
+    surf->magic = 0;
+    free( surf->alloc );
+    free( surf );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           EngLockSurface    (GDI32.@)
+ */
+SURFOBJ * WINAPI EngLockSurface( HSURF hsurf )
+{
+    struct eng_surface *surf = get_surface( hsurf );
+    return surf ? &surf->so : NULL;
+}
+
+/***********************************************************************
+ *           EngUnlockSurface    (GDI32.@)
+ */
+void WINAPI EngUnlockSurface( SURFOBJ *so )
+{
+}
+
+/***********************************************************************
+ *           EngWritePrinter    (GDI32.@)
+ */
+BOOL WINAPI EngWritePrinter( HANDLE printer, void *buf, DWORD size, DWORD *written )
+{
+    struct device_entry *entry;
+    HANDLE output = printer, file = NULL;
+
+    EnterCriticalSection( &eng_cs );
+    LIST_FOR_EACH_ENTRY( entry, &devices, struct device_entry, entry )
+    {
+        if (entry->dev->printer != printer) continue;
+        output = entry->dev->output;
+        file = entry->dev->file;
+        break;
+    }
+    LeaveCriticalSection( &eng_cs );
+    TRACE( "%p -> %p/%p, %lu bytes\n", printer, output, file, size );
+#ifdef SG_MUTANT_ENGWRITE
+    *written = size;
+    return TRUE;
+#endif
+    if (file) return WriteFile( file, buf, size, written, NULL );
+    return WritePrinter( output, buf, size, written );
+}
+
+/***********************************************************************
+ *           EngCheckAbort    (GDI32.@)
+ */
+BOOL WINAPI EngCheckAbort( SURFOBJ *so )
+{
+    return FALSE;
+}
+
+/***********************************************************************
+ *           EngGetPrinterData    (GDI32.@)
+ */
+DWORD WINAPI EngGetPrinterData( HANDLE printer, WCHAR *name, DWORD *type, BYTE *data, DWORD size, DWORD *needed )
+{
+    return GetPrinterDataW( printer, name, type, data, size, needed );
+}
+
+/***********************************************************************
+ *           EngSetPrinterData    (GDI32.@)
+ */
+DWORD WINAPI EngSetPrinterData( HANDLE printer, WCHAR *name, DWORD type, BYTE *data, DWORD size )
+{
+    return SetPrinterDataW( printer, name, type, data, size );
+}
+
+/***********************************************************************
+ *           EngGetPrinter    (GDI32.@)
+ */
+BOOL WINAPI EngGetPrinter( HANDLE printer, DWORD level, BYTE *buf, DWORD size, DWORD *needed )
+{
+    return GetPrinterW( printer, level, buf, size, needed );
+}
+
+/***********************************************************************
+ *           EngGetPrinterDriver    (GDI32.@)
+ */
+BOOL WINAPI EngGetPrinterDriver( HANDLE printer, WCHAR *env, DWORD level, BYTE *buf, DWORD size, DWORD *needed )
+{
+    return GetPrinterDriverW( printer, env, level, buf, size, needed );
+}
+
+/***********************************************************************
+ *           EngEnumForms    (GDI32.@)
+ */
+BOOL WINAPI EngEnumForms( HANDLE printer, DWORD level, BYTE *buf, DWORD size, DWORD *needed, DWORD *count )
+{
+    return EnumFormsW( printer, level, buf, size, needed, count );
+}
+
+/***********************************************************************
+ *           EngGetForm    (GDI32.@)
+ */
+BOOL WINAPI EngGetForm( HANDLE printer, WCHAR *name, DWORD level, BYTE *buf, DWORD size, DWORD *needed )
+{
+    return GetFormW( printer, name, level, buf, size, needed );
+}
+
+/***********************************************************************
+ *           EngCreatePalette    (GDI32.@)
+ */
+HPALETTE WINAPI EngCreatePalette( ULONG mode, ULONG count, ULONG *colors, FLONG red, FLONG green, FLONG blue )
+{
+    ULONG *pal;
+
+    TRACE( "%lu %lu %p %#lx %#lx %#lx\n", mode, count, colors, red, green, blue );
+    /* the palette is only handed back to us; keep what we were given */
+    if (!(pal = calloc( 5 + (mode == PAL_INDEXED ? count : 0), sizeof(ULONG) ))) return NULL;
+    pal[0] = mode;
+    pal[1] = count;
+    pal[2] = red;
+    pal[3] = green;
+    pal[4] = blue;
+    if (mode == PAL_INDEXED && colors) memcpy( pal + 5, colors, count * sizeof(ULONG) );
+    return (HPALETTE)pal;
+}
+
+/***********************************************************************
+ *           EngDeletePalette    (GDI32.@)
+ */
+BOOL WINAPI EngDeletePalette( HPALETTE pal )
+{
+    free( pal );
+    return TRUE;
+}
+
+static BOOL bitmap_surface( SURFOBJ *so )
+{
+    return so && so->pvScan0 && so->iType == STYPE_BITMAP;
+}
+
+static void fill_rect( SURFOBJ *dst, const RECTL *rect, ULONG color )
+{
+    int bpp = format_bpp( dst->iBitmapFormat ), x, y;
+    RECTL r = *rect;
+
+    if (r.left < 0) r.left = 0;
+    if (r.top < 0) r.top = 0;
+    if (r.right > dst->sizlBitmap.cx) r.right = dst->sizlBitmap.cx;
+    if (r.bottom > dst->sizlBitmap.cy) r.bottom = dst->sizlBitmap.cy;
+    for (y = r.top; y < r.bottom; y++)
+    {
+        BYTE *row = (BYTE *)dst->pvScan0 + (LONG_PTR)y * dst->lDelta;
+        for (x = r.left; x < r.right; x++)
+        {
+            switch (bpp)
+            {
+            case 1:
+                if (color & 1) row[x / 8] |= 0x80 >> (x % 8);
+                else row[x / 8] &= ~(0x80 >> (x % 8));
+                break;
+            case 8: row[x] = color; break;
+            case 16: ((WORD *)row)[x] = color; break;
+            case 24: row[x * 3] = color; row[x * 3 + 1] = color >> 8; row[x * 3 + 2] = color >> 16; break;
+            case 32: ((DWORD *)row)[x] = color; break;
+            }
+        }
+    }
+}
+
+static BOOL copy_rect( SURFOBJ *dst, SURFOBJ *src, const RECTL *rect, const POINTL *pt )
+{
+    int bpp = format_bpp( dst->iBitmapFormat ), y, x;
+    int w = rect->right - rect->left, h = rect->bottom - rect->top;
+
+    if (!bitmap_surface( src ) || src->iBitmapFormat != dst->iBitmapFormat) return FALSE;
+    for (y = 0; y < h; y++)
+    {
+        int sy = pt->y + y, dy = rect->top + y;
+        BYTE *drow, *srow;
+        if (sy < 0 || sy >= src->sizlBitmap.cy || dy < 0 || dy >= dst->sizlBitmap.cy) continue;
+        drow = (BYTE *)dst->pvScan0 + (LONG_PTR)dy * dst->lDelta;
+        srow = (BYTE *)src->pvScan0 + (LONG_PTR)sy * src->lDelta;
+        if (bpp >= 8)
+        {
+            int bytes = bpp / 8, dx = rect->left, sx = pt->x, n = w;
+            if (dx < 0) { sx -= dx; n += dx; dx = 0; }
+            if (sx < 0) { dx -= sx; n += sx; sx = 0; }
+            n = min( n, min( dst->sizlBitmap.cx - dx, src->sizlBitmap.cx - sx ) );
+            if (n > 0) memmove( drow + dx * bytes, srow + sx * bytes, n * bytes );
+        }
+        else if (bpp == 1)
+        {
+            for (x = 0; x < w; x++)
+            {
+                int sx = pt->x + x, dx = rect->left + x;
+                if (sx < 0 || sx >= src->sizlBitmap.cx || dx < 0 || dx >= dst->sizlBitmap.cx) continue;
+                if (srow[sx / 8] & (0x80 >> (sx % 8))) drow[dx / 8] |= 0x80 >> (dx % 8);
+                else drow[dx / 8] &= ~(0x80 >> (dx % 8));
+            }
+        }
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *           EngBitBlt    (GDI32.@)
+ */
+BOOL WINAPI EngBitBlt( SURFOBJ *dst, SURFOBJ *src, SURFOBJ *mask, CLIPOBJ *clip, XLATEOBJ *xlate, RECTL *rect,
+                       POINTL *src_pt, POINTL *mask_pt, BRUSHOBJ *brush, POINTL *brush_org, ROP4 rop )
+{
+    TRACE( "%p %p rop %#lx\n", dst, src, rop );
+    if (!bitmap_surface( dst ) || !rect) return FALSE;
+    if (clip && clip->iDComplexity != DC_TRIVIAL)
+    {
+        /* only the clip's bounds */
+        RECTL r = *rect;
+        if (r.left < clip->rclBounds.left) r.left = clip->rclBounds.left;
+        if (r.top < clip->rclBounds.top) r.top = clip->rclBounds.top;
+        if (r.right > clip->rclBounds.right) r.right = clip->rclBounds.right;
+        if (r.bottom > clip->rclBounds.bottom) r.bottom = clip->rclBounds.bottom;
+        if (r.left >= r.right || r.top >= r.bottom) return TRUE;
+        if (src_pt)
+        {
+            POINTL p = { src_pt->x + r.left - rect->left, src_pt->y + r.top - rect->top };
+            return EngBitBlt( dst, src, mask, NULL, xlate, &r, &p, mask_pt, brush, brush_org, rop );
+        }
+        return EngBitBlt( dst, src, mask, NULL, xlate, &r, src_pt, mask_pt, brush, brush_org, rop );
+    }
+    switch (rop & 0xff)
+    {
+    case 0xcc: /* SRCCOPY */
+        return src_pt && copy_rect( dst, src, rect, src_pt );
+    case 0xf0: /* PATCOPY */
+        if (!brush || brush->iSolidColor == 0xffffffff) return FALSE;
+        fill_rect( dst, rect, brush->iSolidColor );
+        return TRUE;
+    case 0x00: fill_rect( dst, rect, 0 ); return TRUE;
+    case 0xff: fill_rect( dst, rect, 0xffffffff ); return TRUE;
+    }
+    FIXME( "rop %#lx not supported\n", rop );
+    return FALSE;
+}
