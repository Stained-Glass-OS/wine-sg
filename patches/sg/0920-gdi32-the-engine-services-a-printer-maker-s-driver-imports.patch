+#define WINE_ENG_DEVICE_MAGIC 0x56444557
+struct wine_eng_device
+{
+    DWORD   magic;
+    DHPDEV  dhpdev;    /* what the driver's DrvEnablePDEV returned */
+    HANDLE  printer;   /* the handle the driver was given */
+    HANDLE  output;    /* where the driver's EngWritePrinter data goes: a port */
+    HANDLE  file;      /* ... or a file, when the driver runs in our 64-bit host */
+    BOOL    banding;   /* the driver marked its surface for banding */
+    HSURF   surface;   /* the surface associated with the device */
+};
+
+/* what an HPALETTE made by EngCreatePalette points to */
