+                                          BRUSHOBJ *, BRUSHOBJ *, POINTL *, MIX );
+typedef DWORD (WINAPI *sg_write_abort_fn)( sg_devobj *, void *, DWORD, DWORD );
+
+typedef struct sg_drvprocs
+{
