+/* progress while the device scans */
+
+struct progress
+{
+    HWND hwnd;
+    BOOL cancelled;
+};
+
+static INT_PTR CALLBACK progress_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct progress *progress = (struct progress *)GetWindowLongPtrW(hwnd, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        SetWindowLongPtrW(hwnd, DWLP_USER, lparam);
+        SendDlgItemMessageW(hwnd, IDC_PROGRESS_BAR, PBM_SETRANGE32, 0, 100);
+        return TRUE;
+    case WM_COMMAND:
+        if (LOWORD(wparam) == IDCANCEL)
+        {
+            progress->cancelled = TRUE;
+            EnableWindow(GetDlgItem(hwnd, IDCANCEL), FALSE);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+static void progress_open(struct progress *progress, HWND parent, UINT text_id, int page)
+{
+    WCHAR fmt[128], text[160];
+
+    progress->cancelled = FALSE;
+    progress->hwnd = CreateDialogParamW(STI_hInstance, MAKEINTRESOURCEW(IDD_PROGRESS), parent, progress_proc,
+                                        (LPARAM)progress);
+    if (!progress->hwnd) return;
+    load_string(text_id, fmt, ARRAY_SIZE(fmt));
+    swprintf(text, ARRAY_SIZE(text), fmt, page);
+    SetDlgItemTextW(progress->hwnd, IDC_PROGRESS_TEXT, text);
+    ShowWindow(progress->hwnd, SW_SHOW);
+    UpdateWindow(progress->hwnd);
+}
+
+static BOOL progress_update(struct progress *progress, LONG percent)
+{
+    MSG msg;
+
+    if (!progress->hwnd) return TRUE;
+    SendDlgItemMessageW(progress->hwnd, IDC_PROGRESS_BAR, PBM_SETPOS, percent, 0);
+    while (PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE))
+    {
+        if (!IsDialogMessageW(progress->hwnd, &msg))
+        {
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+    }
+    return !progress->cancelled;
+}
+
+static void progress_close(struct progress *progress)
+{
+    if (progress->hwnd) DestroyWindow(progress->hwnd);
+    progress->hwnd = NULL;
+}
+
+static void show_error(HWND parent, HRESULT hr)
+{
+    WCHAR title[64], text[256];
+    UINT id = hr == WIA_ERROR_PAPER_EMPTY ? IDS_PAPER_EMPTY : hr == WIA_ERROR_BUSY ? IDS_DEVICE_BUSY
+                                                                                   : IDS_SCAN_FAILED;
+
+    load_string(IDS_TITLE, title, ARRAY_SIZE(title));
+    load_string(id, text, ARRAY_SIZE(text));
+    MessageBoxW(parent, text, title, MB_OK | MB_ICONEXCLAMATION);
+}
