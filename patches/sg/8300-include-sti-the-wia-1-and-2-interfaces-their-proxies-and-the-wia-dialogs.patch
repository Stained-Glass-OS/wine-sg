+
+/* a DIB (with or without its file header) as a bitmap of the pane */
+static HBITMAP bitmap_from_dib(const BYTE *data, SIZE_T size)
+{
+    const BITMAPINFO *bmi = (const BITMAPINFO *)data;
+    const BYTE *bits;
+    HBITMAP bitmap;
+    HDC hdc;
+    LONG colours;
+
+    if (size >= sizeof(BITMAPFILEHEADER) && data[0] == 'B' && data[1] == 'M')
+    {
+        bmi = (const BITMAPINFO *)(data + sizeof(BITMAPFILEHEADER));
+        size -= sizeof(BITMAPFILEHEADER);
+    }
+    if (size < sizeof(BITMAPINFOHEADER) || bmi->bmiHeader.biSize < sizeof(BITMAPINFOHEADER)) return NULL;
+    colours = bmi->bmiHeader.biClrUsed ? bmi->bmiHeader.biClrUsed :
+              bmi->bmiHeader.biBitCount <= 8 ? 1 << bmi->bmiHeader.biBitCount : 0;
+    bits = (const BYTE *)bmi + bmi->bmiHeader.biSize + colours * sizeof(RGBQUAD);
+    hdc = GetDC(NULL);
+    bitmap = CreateDIBitmap(hdc, &bmi->bmiHeader, CBM_INIT, bits, bmi, DIB_RGB_COLORS);
+    ReleaseDC(NULL, hdc);
+    return bitmap;
+}
+
+/* sets the area to scan on an item, from the pane's selection */
+static void apply_area(IWiaPropertyStorage *stg, const struct preview *pv, LONG bed_width, LONG bed_height)
+{
+    LONG xres = read_long(stg, WIA_IPS_XRES, 100), yres = read_long(stg, WIA_IPS_YRES, 100);
+    LONG w = MulDiv(bed_width, xres, 1000), h = MulDiv(bed_height, yres, 1000);
+    PROPSPEC specs[4];
+    PROPVARIANT values[4];
+    int i;
+
+    for (i = 0; i < 4; i++)
+    {
+        specs[i].ulKind = PRSPEC_PROPID;
+        values[i].vt = VT_I4;
+    }
+    specs[0].propid = WIA_IPS_XPOS;
+    values[0].lVal = (LONG)(pv->sel[0] * w);
+    specs[1].propid = WIA_IPS_YPOS;
+    values[1].lVal = (LONG)(pv->sel[1] * h);
+    specs[2].propid = WIA_IPS_XEXTENT;
+    values[2].lVal = max(1, (LONG)((pv->sel[2] - pv->sel[0]) * w));
+    specs[3].propid = WIA_IPS_YEXTENT;
+    values[3].lVal = max(1, (LONG)((pv->sel[3] - pv->sel[1]) * h));
+    if (values[0].lVal + values[2].lVal > w) values[2].lVal = w - values[0].lVal;
+    if (values[1].lVal + values[3].lVal > h) values[3].lVal = h - values[1].lVal;
+    IWiaPropertyStorage_WriteMultiple(stg, 4, specs, values, WIA_IPA_FIRST);
+}
+
+/* Scan using <device> (WIA 1) */
+
+enum picture_choice { CHOICE_COLOR, CHOICE_GRAY, CHOICE_BW, CHOICE_CUSTOM };
+
+struct scan_dlg
+{
+    IWiaItem *root, *item;
+    IWiaPropertyStorage *root_stg, *stg;
+    LONG flags, intent;
+    BOOL flatbed, feeder;
+    enum picture_choice choice;
+    LONG brightness, contrast, resolution, datatype;   /* the custom settings */
+    struct preview preview;
+};
+
+static LONG bed_width(struct scan_dlg *dlg, BOOL feeder)
+{
+    return read_long(dlg->root_stg, feeder ? WIA_DPS_HORIZONTAL_SHEET_FEED_SIZE : WIA_DPS_HORIZONTAL_BED_SIZE, 8500);
+}
+
+static LONG bed_height(struct scan_dlg *dlg, BOOL feeder)
+{
+    return read_long(dlg->root_stg, feeder ? WIA_DPS_VERTICAL_SHEET_FEED_SIZE : WIA_DPS_VERTICAL_BED_SIZE, 11000);
+}
+
+static BOOL dlg_uses_feeder(HWND hwnd, struct scan_dlg *dlg)
+{
+    if (!dlg->feeder) return FALSE;
+    if (!dlg->flatbed) return TRUE;
+    return SendDlgItemMessageW(hwnd, IDC_SOURCE, CB_GETCURSEL, 0, 0) == 1;
+}
+
+/* the settings of the dialog, on the device's item */
+static void apply_choice(HWND hwnd, struct scan_dlg *dlg)
+{
+    static const LONG intents[] = { WIA_INTENT_IMAGE_TYPE_COLOR, WIA_INTENT_IMAGE_TYPE_GRAYSCALE,
+                                    WIA_INTENT_IMAGE_TYPE_TEXT };
+    BOOL feeder = dlg_uses_feeder(hwnd, dlg);
+
+    if (dlg->feeder || dlg->flatbed)
+        write_long(dlg->root_stg, WIA_DPS_DOCUMENT_HANDLING_SELECT, feeder ? FEEDER : FLATBED);
+    if (dlg->choice != CHOICE_CUSTOM)
+    {
+        write_long(dlg->stg, WIA_IPS_CUR_INTENT, intents[dlg->choice] | (dlg->intent & WIA_INTENT_SIZE_MASK));
+        if (!(dlg->intent & WIA_INTENT_SIZE_MASK))
+        {
+            LONG res = closest_valid(dlg->stg, WIA_IPS_XRES, dlg->choice == CHOICE_BW ? 300 : 150);
+            write_long(dlg->stg, WIA_IPS_XRES, res);
+            write_long(dlg->stg, WIA_IPS_YRES, res);
+        }
+    }
+    else
+    {
+        write_long(dlg->stg, WIA_IPA_DATATYPE, dlg->datatype);
+        write_long(dlg->stg, WIA_IPS_XRES, closest_valid(dlg->stg, WIA_IPS_XRES, dlg->resolution));
+        write_long(dlg->stg, WIA_IPS_YRES, closest_valid(dlg->stg, WIA_IPS_YRES, dlg->resolution));
+        write_long(dlg->stg, WIA_IPS_BRIGHTNESS, dlg->brightness);
+        write_long(dlg->stg, WIA_IPS_CONTRAST, dlg->contrast);
+    }
+    apply_area(dlg->stg, &dlg->preview, bed_width(dlg, feeder), bed_height(dlg, feeder));
+}
+
+static void do_preview(HWND hwnd, struct scan_dlg *dlg)
+{
+    struct memory_callback cb = { { &memcb_vtbl }, 1 };
+    WIA_DATA_TRANSFER_INFO info = { sizeof(info), 0, 65536 };
+    struct preview *pv = &dlg->preview;
+    struct progress progress;
+    IWiaDataTransfer *transfer;
+    LONG res, xres, yres, datatype;
+    HRESULT hr;
+    GUID format;
+
+    if (FAILED(IWiaItem_QueryInterface(dlg->item, &IID_IWiaDataTransfer, (void **)&transfer))) return;
+    xres = read_long(dlg->stg, WIA_IPS_XRES, 100);
+    yres = read_long(dlg->stg, WIA_IPS_YRES, 100);
+    datatype = read_long(dlg->stg, WIA_IPA_DATATYPE, WIA_DATA_COLOR);
+    if (dlg->feeder || dlg->flatbed)
+        write_long(dlg->root_stg, WIA_DPS_DOCUMENT_HANDLING_SELECT, dlg_uses_feeder(hwnd, dlg) ? FEEDER : FLATBED);
+    /* the whole bed at a low resolution */
+    res = closest_valid(dlg->stg, WIA_IPS_XRES, 50);
+    write_long(dlg->stg, WIA_IPS_XRES, res);
+    write_long(dlg->stg, WIA_IPS_YRES, res);
+    write_long(dlg->stg, WIA_IPS_XPOS, 0);
+    write_long(dlg->stg, WIA_IPS_YPOS, 0);
+    write_long(dlg->stg, WIA_IPS_XEXTENT, MulDiv(dlg->preview.bed_width, res, 1000));
+    write_long(dlg->stg, WIA_IPS_YEXTENT, MulDiv(dlg->preview.bed_height, res, 1000));
+    write_long(dlg->stg, WIA_IPA_DATATYPE, dlg->choice == CHOICE_GRAY ? WIA_DATA_GRAYSCALE :
+               list_has(dlg->stg, WIA_IPA_DATATYPE, WIA_DATA_COLOR) ? WIA_DATA_COLOR : WIA_DATA_GRAYSCALE);
+    format = WiaImgFmt_MEMORYBMP;
+    write_guid(dlg->stg, WIA_IPA_FORMAT, &format);
+    write_long(dlg->stg, WIA_IPA_TYMED, TYMED_CALLBACK);
+
+    progress_open(&progress, hwnd, IDS_PREVIEWING, 0);
+    cb.progress = &progress;
+    EnableWindow(hwnd, FALSE);
+    hr = IWiaDataTransfer_idtGetBandedData(transfer, &info, &cb.IWiaDataCallback_iface);
+    EnableWindow(hwnd, TRUE);
+    progress_close(&progress);
+    IWiaDataTransfer_Release(transfer);
+
+    if (hr == S_OK && cb.used)
+    {
+        if (pv->bitmap) DeleteObject(pv->bitmap);
+        pv->bitmap = bitmap_from_dib(cb.data, cb.used);
+        pv->sel[0] = pv->sel[1] = 0.0;
+        pv->sel[2] = pv->sel[3] = 1.0;
+        InvalidateRect(pv->hwnd, NULL, FALSE);
+    }
+    else if (FAILED(hr)) show_error(hwnd, hr);
+    free(cb.data);
+    write_long(dlg->stg, WIA_IPA_DATATYPE, datatype);
+    write_long(dlg->stg, WIA_IPS_XRES, xres);
+    write_long(dlg->stg, WIA_IPS_YRES, yres);
+}
+
+static void set_slider(HWND hwnd, int slider, int label, LONG value)
+{
+    WCHAR text[16];
+
+    SendDlgItemMessageW(hwnd, slider, TBM_SETPOS, TRUE, value);
+    swprintf(text, ARRAY_SIZE(text), L"%ld", value);
+    SetDlgItemTextW(hwnd, label, text);
+}
