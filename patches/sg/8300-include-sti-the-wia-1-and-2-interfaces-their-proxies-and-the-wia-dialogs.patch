+ * release an item once more than they got it (NAPS2's WIA driver releases an item and then the same
+ * pointer again as its property storage) work on Windows; here the second release would free the
+ * proxy under the program's other references. */
+static void keep_item(IUnknown *item)
+{
+#ifndef SG_MUTANT_WIA_NO_KEEP
+    if (item) IUnknown_AddRef(item);
+#endif
+}
