+/* progress of a WIA 1 file transfer */
+
+struct progress_callback
+{
+    IWiaDataCallback IWiaDataCallback_iface;
+    struct progress *progress;
+};
+
+static HRESULT WINAPI progcb_BandedDataCallback(IWiaDataCallback *iface, LONG message, LONG status, LONG percent,
+                                                LONG offset, LONG length, LONG reserved, LONG res_length,
+                                                BYTE *buffer)
+{
+    struct progress_callback *This = CONTAINING_RECORD(iface, struct progress_callback, IWiaDataCallback_iface);
+
+    return progress_update(This->progress, percent) ? S_OK : S_FALSE;
+}
+
+static ULONG WINAPI progcb_AddRef(IWiaDataCallback *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI progcb_Release(IWiaDataCallback *iface)
+{
+    return 1;
+}
+
+static const IWiaDataCallbackVtbl progcb_vtbl =
+{
+    memcb_QueryInterface,
+    progcb_AddRef,
+    progcb_Release,
+    progcb_BandedDataCallback,
+};
+
+HRESULT wiaui_transfer_file(HWND parent, IWiaItem *item, BSTR filename, GUID *format)
+{
+    struct progress_callback cb = { { &progcb_vtbl } };
+    IWiaPropertyStorage *stg = storage_of((IUnknown *)item);
+    IWiaDataTransfer *transfer;
+    struct progress progress;
+    STGMEDIUM medium;
+    HRESULT hr;
+
+    if (!stg) return E_NOINTERFACE;
+    if (IsEqualGUID(format, &GUID_NULL) || FAILED(write_guid(stg, WIA_IPA_FORMAT, format)))
+    {
+        *format = WiaImgFmt_BMP;
+        write_guid(stg, WIA_IPA_FORMAT, format);
+    }
+    write_long(stg, WIA_IPA_TYMED, TYMED_FILE);
+    IWiaPropertyStorage_Release(stg);
+    if (FAILED(hr = IWiaItem_QueryInterface(item, &IID_IWiaDataTransfer, (void **)&transfer))) return hr;
+
+    progress_open(&progress, parent, IDS_TRANSFERRING, 1);
+    cb.progress = &progress;
+    memset(&medium, 0, sizeof(medium));
+    medium.tymed = TYMED_FILE;
+    medium.lpszFileName = filename;
+    hr = IWiaDataTransfer_idtGetData(transfer, &medium, &cb.IWiaDataCallback_iface);
+    progress_close(&progress);
+    IWiaDataTransfer_Release(transfer);
+    if (FAILED(hr)) show_error(parent, hr);
+    return hr;
+}
+
+/* New Scan (WIA 2) */
+
+struct transfer_callback
+{
+    IWiaTransferCallback IWiaTransferCallback_iface;
+    LONG ref;
+    struct progress *progress;
+    const WCHAR *folder, *filename, *ext;
+    IStream *memory;           /* a preview goes to memory */
+    BSTR *paths;
+    LONG count;
+    int page;
+};
+
+static inline struct transfer_callback *impl_from_IWiaTransferCallback(IWiaTransferCallback *iface)
+{
+    return CONTAINING_RECORD(iface, struct transfer_callback, IWiaTransferCallback_iface);
+}
+
+static HRESULT WINAPI tcb_QueryInterface(IWiaTransferCallback *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IWiaTransferCallback))
+    {
+        IWiaTransferCallback_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI tcb_AddRef(IWiaTransferCallback *iface)
+{
+    return InterlockedIncrement(&impl_from_IWiaTransferCallback(iface)->ref);
+}
+
+static ULONG WINAPI tcb_Release(IWiaTransferCallback *iface)
+{
+    return InterlockedDecrement(&impl_from_IWiaTransferCallback(iface)->ref);
+}
+
+static HRESULT WINAPI tcb_TransferCallback(IWiaTransferCallback *iface, LONG flags, WiaTransferParams *params)
+{
+    struct transfer_callback *This = impl_from_IWiaTransferCallback(iface);
+
+    if (!params) return E_INVALIDARG;
+    if (params->lMessage == WIA_TRANSFER_MSG_END_OF_STREAM && This->progress && This->progress->hwnd)
+    {
+        WCHAR fmt[128], text[160];
+        load_string(IDS_SCANNING_PAGE, fmt, ARRAY_SIZE(fmt));
+        swprintf(text, ARRAY_SIZE(text), fmt, This->page + 1);
+        SetDlgItemTextW(This->progress->hwnd, IDC_PROGRESS_TEXT, text);
+    }
+    if (This->progress && !progress_update(This->progress, params->lPercentComplete)) return S_FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI tcb_GetNextStream(IWiaTransferCallback *iface, LONG flags, BSTR name, BSTR full_name,
+                                        IStream **stream)
+{
+    struct transfer_callback *This = impl_from_IWiaTransferCallback(iface);
+    WCHAR path[MAX_PATH], folder[MAX_PATH];
+    size_t len;
+    BSTR *grown;
+    HRESULT hr;
+    int n;
+
+    if (!stream) return E_POINTER;
+    *stream = NULL;
+    if (This->memory)
+    {
+        IStream_AddRef(This->memory);
+        *stream = This->memory;
+        return S_OK;
+    }
+    /* "name.ext", then "name (2).ext" and so on, as Windows names further pages */
+    lstrcpynW(folder, This->folder, ARRAY_SIZE(folder));
+    if ((len = wcslen(folder)) && folder[len - 1] == '\\') folder[len - 1] = 0;
+    for (n = 1; ; n++)
+    {
+        if (n == 1) swprintf(path, ARRAY_SIZE(path), L"%s\\%s.%s", folder, This->filename, This->ext);
+        else swprintf(path, ARRAY_SIZE(path), L"%s\\%s (%d).%s", folder, This->filename, n, This->ext);
+        if (GetFileAttributesW(path) == INVALID_FILE_ATTRIBUTES) break;
+        if (n > 9999) return HRESULT_FROM_WIN32(ERROR_FILE_EXISTS);
+    }
+    if (FAILED(hr = SHCreateStreamOnFileEx(path, STGM_CREATE | STGM_WRITE | STGM_SHARE_EXCLUSIVE,
+                                           FILE_ATTRIBUTE_NORMAL, TRUE, NULL, stream)))
+        return hr;
+    if ((grown = CoTaskMemRealloc(This->paths, (This->count + 1) * sizeof(BSTR))))
+    {
+        This->paths = grown;
+        This->paths[This->count++] = SysAllocString(path);
+    }
+    This->page++;
+    return S_OK;
+}
+
+static const IWiaTransferCallbackVtbl tcb_vtbl =
+{
+    tcb_QueryInterface,
+    tcb_AddRef,
+    tcb_Release,
+    tcb_TransferCallback,
+    tcb_GetNextStream,
+};
+
+struct scan2_dlg
+{
+    IWiaItem2 *root, *flatbed, *feeder, *chosen;
+    IWiaPropertyStorage *root_stg;
+    BSTR folder, filename;
+    LONG flags;
+    BOOL duplex;
+    struct preview preview;
+    struct transfer_callback cb;
+};
+
+static IWiaItem2 *dlg2_item(HWND hwnd, struct scan2_dlg *dlg, BOOL *duplex)
+{
+    int source = SendDlgItemMessageW(hwnd, IDC_SOURCE, CB_GETCURSEL, 0, 0);
+    int index = 0;
+
+    *duplex = FALSE;
+    if (dlg->flatbed && source == index++) return dlg->flatbed;
+    if (dlg->feeder && source == index++) return dlg->feeder;
+    if (dlg->feeder && dlg->duplex && source == index)
+    {
+        *duplex = TRUE;
+        return dlg->feeder;
+    }
+    return dlg->flatbed ? dlg->flatbed : dlg->feeder;
+}
+
+static void dlg2_bed(struct scan2_dlg *dlg, IWiaItem2 *item, LONG *width, LONG *height)
+{
+    IWiaPropertyStorage *stg = storage_of((IUnknown *)item);
+
+    *width = 8500;
+    *height = 11000;
+    if (!stg) return;
+    *width = read_long(stg, WIA_IPS_MAX_HORIZONTAL_SIZE, *width);
+    *height = read_long(stg, WIA_IPS_MAX_VERTICAL_SIZE, *height);
+    IWiaPropertyStorage_Release(stg);
+}
+
+static const GUID *dlg2_format(HWND hwnd, const WCHAR **ext)
+{
+    static const GUID *const formats[] = { &WiaImgFmt_BMP, &WiaImgFmt_JPEG, &WiaImgFmt_PNG, &WiaImgFmt_TIFF };
+    static const WCHAR *const exts[] = { L"bmp", L"jpg", L"png", L"tif" };
+    int i = SendDlgItemMessageW(hwnd, IDC_FILE_TYPE, CB_GETCURSEL, 0, 0);
+
+    if (i < 0 || i >= ARRAY_SIZE(formats)) i = 1;
+    if (ext) *ext = exts[i];
+    return formats[i];
+}
+
+/* the dialog's settings on an item */
+static void dlg2_apply(HWND hwnd, struct scan2_dlg *dlg, IWiaPropertyStorage *stg, BOOL duplex, BOOL area)
+{
+    int colour = SendDlgItemMessageW(hwnd, IDC_COLOR_FORMAT, CB_GETCURSEL, 0, 0);
+    LONG res = closest_valid(stg, WIA_IPS_XRES, GetDlgItemInt(hwnd, IDC_RESOLUTION, NULL, FALSE));
+    LONG width, height;
+
+    write_long(stg, WIA_IPA_DATATYPE, colour == 0 ? WIA_DATA_COLOR : colour == 1 ? WIA_DATA_GRAYSCALE
+                                                                                  : WIA_DATA_THRESHOLD);
+    write_long(stg, WIA_IPS_XRES, res);
+    write_long(stg, WIA_IPS_YRES, res);
+    write_long(stg, WIA_IPS_BRIGHTNESS, SendDlgItemMessageW(hwnd, IDC_BRIGHTNESS, TBM_GETPOS, 0, 0) * 10);
+    write_long(stg, WIA_IPS_CONTRAST, SendDlgItemMessageW(hwnd, IDC_CONTRAST, TBM_GETPOS, 0, 0) * 10);
+    write_guid(stg, WIA_IPA_FORMAT, dlg2_format(hwnd, NULL));
+    if (dlg->feeder && dlg->duplex) write_long(stg, WIA_IPS_DOCUMENT_HANDLING_SELECT, duplex ? DUPLEX : FRONT_ONLY);
+    if (area)
+    {
+        width = read_long(stg, WIA_IPS_MAX_HORIZONTAL_SIZE, 8500);
+        height = read_long(stg, WIA_IPS_MAX_VERTICAL_SIZE, 11000);
+        apply_area(stg, &dlg->preview, width, height);
+    }
+}
+
+static HRESULT dlg2_download(HWND hwnd, struct scan2_dlg *dlg, IWiaItem2 *item, struct transfer_callback *cb,
+                             UINT text_id)
+{
+    struct progress progress;
+    IWiaTransfer *transfer;
+    HRESULT hr;
+
+    if (FAILED(hr = IWiaItem2_QueryInterface(item, &IID_IWiaTransfer, (void **)&transfer))) return hr;
+    progress_open(&progress, hwnd, text_id, 1);
+    cb->progress = &progress;
+    EnableWindow(hwnd, FALSE);
+    hr = IWiaTransfer_Download(transfer, 0, &cb->IWiaTransferCallback_iface);
+    EnableWindow(hwnd, TRUE);
+    progress_close(&progress);
+    cb->progress = NULL;
+    IWiaTransfer_Release(transfer);
+    return hr;
+}
+
+static void dlg2_preview(HWND hwnd, struct scan2_dlg *dlg)
+{
+    struct transfer_callback cb = { { &tcb_vtbl }, 1 };
+    IWiaPropertyStorage *stg;
+    IWiaItem2 *item;
+    BOOL duplex;
+    HGLOBAL global;
+    STATSTG stat;
+    LONG res, width, height;
+    HRESULT hr;
+
+    item = dlg2_item(hwnd, dlg, &duplex);
+    if (!(stg = storage_of((IUnknown *)item))) return;
+    if (FAILED(CreateStreamOnHGlobal(NULL, TRUE, &cb.memory)))
+    {
+        IWiaPropertyStorage_Release(stg);
+        return;
+    }
+    dlg2_apply(hwnd, dlg, stg, duplex, FALSE);
+    res = closest_valid(stg, WIA_IPS_XRES, 50);
+    width = read_long(stg, WIA_IPS_MAX_HORIZONTAL_SIZE, 8500);
+    height = read_long(stg, WIA_IPS_MAX_VERTICAL_SIZE, 11000);
+    write_long(stg, WIA_IPS_XRES, res);
+    write_long(stg, WIA_IPS_YRES, res);
+    write_long(stg, WIA_IPS_XPOS, 0);
+    write_long(stg, WIA_IPS_YPOS, 0);
+    write_long(stg, WIA_IPS_XEXTENT, MulDiv(width, res, 1000));
+    write_long(stg, WIA_IPS_YEXTENT, MulDiv(height, res, 1000));
+    write_guid(stg, WIA_IPA_FORMAT, &WiaImgFmt_BMP);
+    write_long(stg, WIA_IPS_PREVIEW, WIA_PREVIEW_SCAN);
+    hr = dlg2_download(hwnd, dlg, item, &cb, IDS_PREVIEWING);
+    write_long(stg, WIA_IPS_PREVIEW, WIA_FINAL_SCAN);
+    IWiaPropertyStorage_Release(stg);
+
+    if (hr == S_OK && SUCCEEDED(IStream_Stat(cb.memory, &stat, STATFLAG_NONAME))
+            && SUCCEEDED(GetHGlobalFromStream(cb.memory, &global)))
+    {
+        if (dlg->preview.bitmap) DeleteObject(dlg->preview.bitmap);
+        dlg->preview.bitmap = bitmap_from_dib(GlobalLock(global), stat.cbSize.LowPart);
+        GlobalUnlock(global);
+        dlg->preview.bed_width = width;
+        dlg->preview.bed_height = height;
+        dlg->preview.sel[0] = dlg->preview.sel[1] = 0.0;
+        dlg->preview.sel[2] = dlg->preview.sel[3] = 1.0;
+        InvalidateRect(dlg->preview.hwnd, NULL, FALSE);
+    }
+    else if (FAILED(hr)) show_error(hwnd, hr);
+    IStream_Release(cb.memory);
+}
+
+static void dlg2_add(HWND hwnd, int id, UINT string)
+{
+    WCHAR text[128];
+
+    load_string(string, text, ARRAY_SIZE(text));
+    SendDlgItemMessageW(hwnd, id, CB_ADDSTRING, 0, (LPARAM)text);
+}
+
+static void dlg2_profile(HWND hwnd, struct scan2_dlg *dlg)
+{
+    BOOL documents = SendDlgItemMessageW(hwnd, IDC_PROFILE, CB_GETCURSEL, 0, 0) == 1;
+    IWiaPropertyStorage *stg;
+    BOOL duplex;
+
+    /* Photo: colour, 200 dpi, JPG; Documents: greyscale, 300 dpi, TIF */
+    SendDlgItemMessageW(hwnd, IDC_COLOR_FORMAT, CB_SETCURSEL, documents ? 1 : 0, 0);
+    SendDlgItemMessageW(hwnd, IDC_FILE_TYPE, CB_SETCURSEL, documents ? 3 : 1, 0);
+    if ((stg = storage_of((IUnknown *)dlg2_item(hwnd, dlg, &duplex))))
+    {
+        SetDlgItemInt(hwnd, IDC_RESOLUTION, closest_valid(stg, WIA_IPS_XRES, documents ? 300 : 200), FALSE);
+        IWiaPropertyStorage_Release(stg);
+    }
+}
+
+static INT_PTR CALLBACK scan2_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct scan2_dlg *dlg = (struct scan2_dlg *)GetWindowLongPtrW(hwnd, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        IWiaPropertyStorage *stg;
+        LONG min, max, step, *list, width, height;
+        ULONG count;
+        BSTR name;
+        BOOL duplex;
+
+        dlg = (struct scan2_dlg *)lparam;
+        SetWindowLongPtrW(hwnd, DWLP_USER, lparam);
+        name = read_bstr(dlg->root_stg, WIA_DIP_DEV_NAME);
+        SetDlgItemTextW(hwnd, IDC_SCANNER, name ? name : L"");
+        SysFreeString(name);
+        dlg2_add(hwnd, IDC_PROFILE, IDS_PROFILE_PHOTO);
+        dlg2_add(hwnd, IDC_PROFILE, IDS_PROFILE_DOCS);
+        SendDlgItemMessageW(hwnd, IDC_PROFILE, CB_SETCURSEL, 0, 0);
+        if (dlg->flatbed) dlg2_add(hwnd, IDC_SOURCE, IDS_FLATBED);
+        if (dlg->feeder) dlg2_add(hwnd, IDC_SOURCE, IDS_FEEDER);
+        if (dlg->feeder && dlg->duplex) dlg2_add(hwnd, IDC_SOURCE, IDS_FEEDER_DUPLEX);
+        SendDlgItemMessageW(hwnd, IDC_SOURCE, CB_SETCURSEL, 0, 0);
+        dlg2_add(hwnd, IDC_COLOR_FORMAT, IDS_COLOR);
+        dlg2_add(hwnd, IDC_COLOR_FORMAT, IDS_GRAYSCALE);
+        dlg2_add(hwnd, IDC_COLOR_FORMAT, IDS_BLACK_WHITE);
+        dlg2_add(hwnd, IDC_FILE_TYPE, IDS_TYPE_BMP);
+        dlg2_add(hwnd, IDC_FILE_TYPE, IDS_TYPE_JPG);
+        dlg2_add(hwnd, IDC_FILE_TYPE, IDS_TYPE_PNG);
+        dlg2_add(hwnd, IDC_FILE_TYPE, IDS_TYPE_TIF);
+        SendDlgItemMessageW(hwnd, IDC_BRIGHTNESS, TBM_SETRANGE, TRUE, MAKELONG(-100, 100));
+        SendDlgItemMessageW(hwnd, IDC_CONTRAST, TBM_SETRANGE, TRUE, MAKELONG(-100, 100));
+        set_slider(hwnd, IDC_BRIGHTNESS, IDC_BRIGHTNESS_VAL, 0);
+        set_slider(hwnd, IDC_CONTRAST, IDC_CONTRAST_VAL, 0);
+        if ((stg = storage_of((IUnknown *)dlg2_item(hwnd, dlg, &duplex))))
+        {
+            if (read_valid(stg, WIA_IPS_XRES, &min, &max, &step, &list, &count))
+                SendDlgItemMessageW(hwnd, IDC_RESOLUTION_SPIN, UDM_SETRANGE32, min, max);
+            free(list);
+            if (!list_has(stg, WIA_IPA_DATATYPE, WIA_DATA_COLOR))
+                SendDlgItemMessageW(hwnd, IDC_COLOR_FORMAT, CB_DELETESTRING, 0, 0);
+            IWiaPropertyStorage_Release(stg);
+        }
+        dlg2_profile(hwnd, dlg);
+        dlg2_bed(dlg, dlg2_item(hwnd, dlg, &duplex), &width, &height);
+        preview_attach(&dlg->preview, GetDlgItem(hwnd, IDC_PREVIEW), width, height);
+        EnableWindow(GetDlgItem(hwnd, IDC_DO_PREVIEW), dlg2_item(hwnd, dlg, &duplex) == dlg->flatbed);
+        return TRUE;
+    }
+    case WM_HSCROLL:
+    {
+        int id = GetDlgCtrlID((HWND)lparam);
+        LONG pos = SendMessageW((HWND)lparam, TBM_GETPOS, 0, 0);
+        set_slider(hwnd, id, id == IDC_BRIGHTNESS ? IDC_BRIGHTNESS_VAL : IDC_CONTRAST_VAL, pos);
+        return TRUE;
+    }
+    case WM_COMMAND:
+        switch (LOWORD(wparam))
+        {
+        case IDC_PROFILE:
+            if (HIWORD(wparam) == CBN_SELCHANGE) dlg2_profile(hwnd, dlg);
+            return TRUE;
+        case IDC_SOURCE:
+            if (HIWORD(wparam) == CBN_SELCHANGE)
+            {
+                BOOL duplex;
+                IWiaItem2 *item = dlg2_item(hwnd, dlg, &duplex);
+                dlg2_bed(dlg, item, &dlg->preview.bed_width, &dlg->preview.bed_height);
+                if (dlg->preview.bitmap)
+                {
+                    DeleteObject(dlg->preview.bitmap);
+                    dlg->preview.bitmap = NULL;
+                }
+                dlg->preview.sel[0] = dlg->preview.sel[1] = 0.0;
+                dlg->preview.sel[2] = dlg->preview.sel[3] = 1.0;
+                EnableWindow(GetDlgItem(hwnd, IDC_DO_PREVIEW), item == dlg->flatbed);
+                InvalidateRect(dlg->preview.hwnd, NULL, FALSE);
+            }
+            return TRUE;
+        case IDC_DO_PREVIEW:
+            dlg2_preview(hwnd, dlg);
+            return TRUE;
+        case IDOK:
+        {
+            IWiaPropertyStorage *stg;
+            BOOL duplex;
+            HRESULT hr;
+            IWiaItem2 *item = dlg2_item(hwnd, dlg, &duplex);
+
+            if (!(stg = storage_of((IUnknown *)item))) return TRUE;
+            dlg2_apply(hwnd, dlg, stg, duplex, TRUE);
+            IWiaPropertyStorage_Release(stg);
+            dlg->cb.folder = dlg->folder;
+            dlg->cb.filename = dlg->filename;
+            dlg2_format(hwnd, &dlg->cb.ext);
+            hr = dlg2_download(hwnd, dlg, item, &dlg->cb, IDS_SCANNING);
+            if (FAILED(hr))
+            {
+                show_error(hwnd, hr);
+                return TRUE;
+            }
+            if (hr != S_OK) return TRUE; /* cancelled: the dialog stays */
+            dlg->chosen = item;
+            EndDialog(hwnd, IDOK);
+            return TRUE;
+        }
+        case IDCANCEL:
+            EndDialog(hwnd, IDCANCEL);
+            return TRUE;
+        }
+        break;
+    case WM_DESTROY:
+        if (dlg && dlg->preview.bitmap) DeleteObject(dlg->preview.bitmap);
+        break;
+    }
+    return FALSE;
+}
+
+HRESULT wiaui_scan_dialog2(HWND parent, IWiaItem2 *start, LONG flags, BSTR folder, BSTR filename, LONG *count,
+                           BSTR **paths, IWiaItem2 **item)
+{
+    struct scan2_dlg dlg = { 0 };
+    IEnumWiaItem2 *children;
+    IWiaItem2 *child;
+    ULONG fetched;
+    HRESULT hr = S_OK;
+    INT_PTR ret;
+    LONG i;
+
+    if (FAILED(IWiaItem2_GetRootItem(start, &dlg.root))) return E_INVALIDARG;
+    dlg.root_stg = storage_of((IUnknown *)dlg.root);
+    dlg.folder = folder;
+    dlg.filename = filename;
+    dlg.flags = flags;
+    dlg.cb.IWiaTransferCallback_iface.lpVtbl = &tcb_vtbl;
+    dlg.cb.ref = 1;
+    if (SUCCEEDED(IWiaItem2_EnumChildItems(dlg.root, NULL, &children)))
+    {
+        while (IEnumWiaItem2_Next(children, 1, &child, &fetched) == S_OK && fetched == 1)
+        {
+            GUID category;
+            if (SUCCEEDED(IWiaItem2_GetItemCategory(child, &category)))
+            {
+                if (IsEqualGUID(&category, &WIA_CATEGORY_FLATBED) && !dlg.flatbed)
+                {
+                    dlg.flatbed = child;
+                    continue;
+                }
+                if (IsEqualGUID(&category, &WIA_CATEGORY_FEEDER) && !dlg.feeder)
+                {
+                    dlg.feeder = child;
+                    continue;
+                }
+            }
+            IWiaItem2_Release(child);
+        }
+        IEnumWiaItem2_Release(children);
+    }
+    if (dlg.root_stg) dlg.duplex = (read_long(dlg.root_stg, WIA_DPS_DOCUMENT_HANDLING_CAPABILITIES, 0) & DUP) != 0;
+    if (!dlg.root_stg || (!dlg.flatbed && !dlg.feeder)) hr = E_INVALIDARG;
+    else
+    {
+        init_controls();
+        register_preview_class();
+        ret = DialogBoxParamW(STI_hInstance, MAKEINTRESOURCEW(IDD_SCAN2), parent, scan2_proc, (LPARAM)&dlg);
+        if (ret == IDOK)
+        {
+            *count = dlg.cb.count;
+            *paths = dlg.cb.paths;
+            dlg.cb.paths = NULL;
+            if (item)
+            {
+                if (*item) IWiaItem2_Release(*item);
+                IWiaItem2_AddRef(dlg.chosen);
+                *item = dlg.chosen;
+            }
+        }
+        else hr = ret == IDCANCEL ? S_FALSE : E_FAIL;
+    }
+    for (i = 0; i < dlg.cb.count && dlg.cb.paths; i++)
+    {
+        /* a cancelled dialog keeps no files */
+        DeleteFileW(dlg.cb.paths[i]);
+        SysFreeString(dlg.cb.paths[i]);
+    }
+    CoTaskMemFree(dlg.cb.paths);
+    if (dlg.flatbed) IWiaItem2_Release(dlg.flatbed);
+    if (dlg.feeder) IWiaItem2_Release(dlg.feeder);
+    if (dlg.root_stg) IWiaPropertyStorage_Release(dlg.root_stg);
+    IWiaItem2_Release(dlg.root);
+    return hr;
+}
