+/* the scanner glyph of the dialogs, drawn rather than loaded */
+static HICON make_device_icon(int size)
+{
+    BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER), size, -size, 1, 32, BI_RGB }};
+    ICONINFO info = { TRUE };
+    HDC hdc = CreateCompatibleDC(NULL);
+    HBITMAP color, mask, old;
+    HBRUSH body, glass, lid;
+    HPEN pen;
+    DWORD *bits;
+    HICON icon;
+    int i, s = size;
+
+    color = CreateDIBSection(hdc, &bmi, DIB_RGB_COLORS, (void **)&bits, NULL, 0);
+    mask = CreateBitmap(size, size, 1, 1, NULL);
+    old = SelectObject(hdc, color);
+    memset(bits, 0, size * size * 4);
+    body = CreateSolidBrush(RGB(0xe8, 0xe8, 0xe8));
+    lid = CreateSolidBrush(RGB(0x9a, 0x9a, 0x9a));
+    glass = CreateSolidBrush(RGB(0x3a, 0x6e, 0xa5));
+    pen = CreatePen(PS_SOLID, max(1, s / 32), RGB(0x50, 0x50, 0x50));
+    SelectObject(hdc, pen);
+    SelectObject(hdc, lid);
+    RoundRect(hdc, s / 16, s * 5 / 16, s - s / 16, s * 7 / 16, s / 8, s / 8);
+    SelectObject(hdc, body);
+    RoundRect(hdc, s / 16, s * 7 / 16, s - s / 16, s * 13 / 16, s / 8, s / 8);
+    SelectObject(hdc, glass);
+    Rectangle(hdc, s * 3 / 16, s * 9 / 16, s - s * 3 / 16, s * 11 / 16);
+    SelectObject(hdc, old);
+    /* everything drawn is opaque */
+    for (i = 0; i < size * size; i++) if (bits[i]) bits[i] |= 0xff000000;
+    info.hbmColor = color;
+    info.hbmMask = mask;
+    icon = CreateIconIndirect(&info);
+    DeleteObject(color);
+    DeleteObject(mask);
+    DeleteObject(body);
+    DeleteObject(lid);
+    DeleteObject(glass);
+    DeleteObject(pen);
+    DeleteDC(hdc);
+    return icon;
+}
+
+/* Select Device */
+
+struct device_entry
+{
+    BSTR id, name, vendor, description;
+};
+
+struct select_dlg
+{
+    struct device_entry *devices;
+    ULONG count;
+    int chosen;
+};
+
+static void update_selection(HWND hwnd, struct select_dlg *dlg)
+{
+    int sel = SendDlgItemMessageW(hwnd, IDC_DEVICES, LVM_GETNEXTITEM, -1, LVNI_SELECTED);
+
+    SetDlgItemTextW(hwnd, IDC_MANUFACTURER, sel >= 0 ? dlg->devices[sel].vendor : L"");
+    SetDlgItemTextW(hwnd, IDC_DESCRIPTION, sel >= 0 ? dlg->devices[sel].description : L"");
+    EnableWindow(GetDlgItem(hwnd, IDOK), sel >= 0);
+    EnableWindow(GetDlgItem(hwnd, IDC_PROPERTIES), sel >= 0);
+}
+
+static INT_PTR CALLBACK select_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct select_dlg *dlg = (struct select_dlg *)GetWindowLongPtrW(hwnd, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        HWND list = GetDlgItem(hwnd, IDC_DEVICES);
+        HIMAGELIST images = ImageList_Create(48, 48, ILC_COLOR32 | ILC_MASK, 1, 1);
+        HICON icon = make_device_icon(48);
+        LVITEMW item = { LVIF_TEXT | LVIF_IMAGE };
+        ULONG i;
+
+        dlg = (struct select_dlg *)lparam;
+        SetWindowLongPtrW(hwnd, DWLP_USER, lparam);
+        ImageList_AddIcon(images, icon);
+        DestroyIcon(icon);
+        SendMessageW(list, LVM_SETIMAGELIST, LVSIL_NORMAL, (LPARAM)images);
+        for (i = 0; i < dlg->count; i++)
+        {
+            item.iItem = i;
+            item.pszText = dlg->devices[i].name;
+            item.iImage = 0;
+            SendMessageW(list, LVM_INSERTITEMW, 0, (LPARAM)&item);
+        }
+        item.mask = LVIF_STATE;
+        item.state = item.stateMask = LVIS_SELECTED | LVIS_FOCUSED;
+        SendMessageW(list, LVM_SETITEMSTATE, 0, (LPARAM)&item);
+        update_selection(hwnd, dlg);
+        SetFocus(list);
+        return FALSE;
+    }
+    case WM_NOTIFY:
+    {
+        NMHDR *hdr = (NMHDR *)lparam;
+        if (hdr->idFrom != IDC_DEVICES) break;
+        if (hdr->code == LVN_ITEMCHANGED) update_selection(hwnd, dlg);
+        else if (hdr->code == NM_DBLCLK && SendDlgItemMessageW(hwnd, IDC_DEVICES, LVM_GETNEXTITEM, -1, LVNI_SELECTED) >= 0)
+            PostMessageW(hwnd, WM_COMMAND, IDOK, 0);
+        break;
+    }
+    case WM_COMMAND:
+        switch (LOWORD(wparam))
+        {
+        case IDOK:
+            dlg->chosen = SendDlgItemMessageW(hwnd, IDC_DEVICES, LVM_GETNEXTITEM, -1, LVNI_SELECTED);
+            if (dlg->chosen < 0) return TRUE;
+            EndDialog(hwnd, IDOK);
+            return TRUE;
+        case IDCANCEL:
+            EndDialog(hwnd, IDCANCEL);
+            return TRUE;
+        case IDC_PROPERTIES:
+        {
+            int sel = SendDlgItemMessageW(hwnd, IDC_DEVICES, LVM_GETNEXTITEM, -1, LVNI_SELECTED);
+            WCHAR text[512];
+            if (sel < 0) return TRUE;
+            swprintf(text, ARRAY_SIZE(text), L"%s\n\n%s\n%s", dlg->devices[sel].name, dlg->devices[sel].vendor,
+                     dlg->devices[sel].description);
+            MessageBoxW(hwnd, text, dlg->devices[sel].name, MB_OK | MB_ICONINFORMATION);
+            return TRUE;
+        }
+        }
+        break;
+    }
+    return FALSE;
+}
+
+HRESULT wiaui_select_device(HWND parent, IUnknown *manager, BOOL wia2, LONG type, LONG flags, BSTR *id)
+{
+    struct select_dlg dlg = { NULL, 0, -1 };
+    IEnumWIA_DEV_INFO *devices;
+    IWiaPropertyStorage *stg;
+    ULONG fetched, i;
+    HRESULT hr;
+
+    *id = NULL;
+    if (wia2) hr = IWiaDevMgr2_EnumDeviceInfo((IWiaDevMgr2 *)manager, WIA_DEVINFO_ENUM_LOCAL, &devices);
+    else hr = IWiaDevMgr_EnumDeviceInfo((IWiaDevMgr *)manager, WIA_DEVINFO_ENUM_LOCAL, &devices);
+    if (FAILED(hr)) return hr;
+    while (IEnumWIA_DEV_INFO_Next(devices, 1, &stg, &fetched) == S_OK && fetched == 1)
+    {
+        struct device_entry *grown;
+        LONG devtype = read_long(stg, WIA_DIP_DEV_TYPE, 0);
+
+        if (type != StiDeviceTypeDefault && GET_STIDEVICE_TYPE(devtype) != type)
+        {
+            IWiaPropertyStorage_Release(stg);
+            continue;
+        }
+        if ((grown = realloc(dlg.devices, (dlg.count + 1) * sizeof(*grown))))
+        {
+            dlg.devices = grown;
+            grown[dlg.count].id = read_bstr(stg, WIA_DIP_DEV_ID);
+            grown[dlg.count].name = read_bstr(stg, WIA_DIP_DEV_NAME);
+            grown[dlg.count].vendor = read_bstr(stg, WIA_DIP_VEND_DESC);
+            grown[dlg.count].description = read_bstr(stg, WIA_DIP_DEV_DESC);
+            if (grown[dlg.count].id) dlg.count++;
+        }
+        IWiaPropertyStorage_Release(stg);
+    }
+    IEnumWIA_DEV_INFO_Release(devices);
+
+    if (!dlg.count) hr = WIA_S_NO_DEVICE_AVAILABLE;
+#ifdef SG_MUTANT_WIA_DLG_NO_SELECT
+    else if (dlg.count)
+#else
+    else if (dlg.count == 1 && !(flags & WIA_SELECT_DEVICE_NODEFAULT))
+#endif
+    {
+        /* one device: it is taken without asking, as Windows does */
+        dlg.chosen = 0;
+        hr = S_OK;
+    }
+    else
+    {
+        init_controls();
+        hr = DialogBoxParamW(STI_hInstance, MAKEINTRESOURCEW(IDD_SELECT_DEVICE), parent, select_proc,
+                             (LPARAM)&dlg) == IDOK ? S_OK : S_FALSE;
+    }
+    if (hr == S_OK) *id = SysAllocString(dlg.devices[dlg.chosen].id);
+    for (i = 0; i < dlg.count; i++)
+    {
+        SysFreeString(dlg.devices[i].id);
+        SysFreeString(dlg.devices[i].name);
+        SysFreeString(dlg.devices[i].vendor);
+        SysFreeString(dlg.devices[i].description);
+    }
+    free(dlg.devices);
+    return hr;
+}
