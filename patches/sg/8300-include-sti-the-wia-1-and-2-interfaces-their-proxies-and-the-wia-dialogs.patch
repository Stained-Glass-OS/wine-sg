+/* IWiaDataTransfer: the file is the calling program's; the service writes into a stream of it */
+
+HRESULT CALLBACK IWiaDataTransfer_idtGetData_Proxy(IWiaDataTransfer *This, STGMEDIUM *medium,
+                                                   IWiaDataCallback *callback)
+{
+    WCHAR path[MAX_PATH], dir[MAX_PATH];
+    IStream *stream;
+    HGLOBAL global;
+    HANDLE file;
+    STATSTG stat;
+    DWORD written;
+    HRESULT hr;
+    BOOL temp = FALSE;
+
+    TRACE("(%p, %p, %p)\n", This, medium, callback);
+
+    if (!medium) return E_INVALIDARG;
+    if (medium->tymed != TYMED_FILE && medium->tymed != TYMED_MULTIPAGE_FILE) return E_INVALIDARG;
+    if (medium->lpszFileName) lstrcpynW(path, medium->lpszFileName, ARRAY_SIZE(path));
+    else
+    {
+        /* no name given: a temporary file, whose name is handed back */
+        GetTempPathW(ARRAY_SIZE(dir), dir);
+        if (!GetTempFileNameW(dir, L"img", 0, path)) return HRESULT_FROM_WIN32(GetLastError());
+        temp = TRUE;
+    }
+
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &stream))) return hr;
+    hr = IWiaDataTransfer_idtGetDataEx_Proxy(This, medium->tymed, stream, callback);
+    if (hr == S_OK && SUCCEEDED(hr = IStream_Stat(stream, &stat, STATFLAG_NONAME))
+            && SUCCEEDED(hr = GetHGlobalFromStream(stream, &global)))
+    {
+        file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (file == INVALID_HANDLE_VALUE) hr = HRESULT_FROM_WIN32(GetLastError());
+        else
+        {
+            if (!WriteFile(file, GlobalLock(global), stat.cbSize.LowPart, &written, NULL)
+                    || written != stat.cbSize.LowPart)
+                hr = HRESULT_FROM_WIN32(GetLastError());
+            GlobalUnlock(global);
+            CloseHandle(file);
+        }
+    }
+    IStream_Release(stream);
+
+    if (hr == S_OK && temp)
+    {
+        if ((medium->lpszFileName = CoTaskMemAlloc((wcslen(path) + 1) * sizeof(WCHAR))))
+            wcscpy(medium->lpszFileName, path);
+        medium->pUnkForRelease = NULL;
+    }
+    else if (temp) DeleteFileW(path);
+    return hr;
+}
+
+HRESULT __RPC_STUB IWiaDataTransfer_idtGetData_Stub(IWiaDataTransfer *This, LONG tymed, IStream *destination,
+                                                    IWiaDataCallback *callback)
+{
+    STGMEDIUM medium;
+
+    medium.tymed = TYMED_ISTREAM;
+    medium.pstm = destination;
+    medium.pUnkForRelease = NULL;
+    return This->lpVtbl->idtGetData(This, &medium, callback);
+}
