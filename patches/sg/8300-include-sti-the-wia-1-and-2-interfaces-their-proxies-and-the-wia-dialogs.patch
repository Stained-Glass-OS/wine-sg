+/* Advanced Properties: the custom settings */
+static INT_PTR CALLBACK advanced_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct scan_dlg *dlg = (struct scan_dlg *)GetWindowLongPtrW(hwnd, DWLP_USER);
+    WCHAR text[64];
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        LONG min, max, step, *list;
+        ULONG count;
+
+        dlg = (struct scan_dlg *)lparam;
+        SetWindowLongPtrW(hwnd, DWLP_USER, lparam);
+        SendDlgItemMessageW(hwnd, IDC_BRIGHTNESS, TBM_SETRANGE, TRUE, MAKELONG(-100, 100));
+        SendDlgItemMessageW(hwnd, IDC_CONTRAST, TBM_SETRANGE, TRUE, MAKELONG(-100, 100));
+        set_slider(hwnd, IDC_BRIGHTNESS, IDC_BRIGHTNESS_VAL, dlg->brightness / 10);
+        set_slider(hwnd, IDC_CONTRAST, IDC_CONTRAST_VAL, dlg->contrast / 10);
+        if (read_valid(dlg->stg, WIA_IPS_XRES, &min, &max, &step, &list, &count))
+            SendDlgItemMessageW(hwnd, IDC_RESOLUTION_SPIN, UDM_SETRANGE32, min, max);
+        free(list);
+        SetDlgItemInt(hwnd, IDC_RESOLUTION, dlg->resolution, FALSE);
+        load_string(IDS_COLOR, text, ARRAY_SIZE(text));
+        SendDlgItemMessageW(hwnd, IDC_PICTURE_TYPE, CB_ADDSTRING, 0, (LPARAM)text);
+        load_string(IDS_GRAYSCALE, text, ARRAY_SIZE(text));
+        SendDlgItemMessageW(hwnd, IDC_PICTURE_TYPE, CB_ADDSTRING, 0, (LPARAM)text);
+        load_string(IDS_BLACK_WHITE, text, ARRAY_SIZE(text));
+        SendDlgItemMessageW(hwnd, IDC_PICTURE_TYPE, CB_ADDSTRING, 0, (LPARAM)text);
+        SendDlgItemMessageW(hwnd, IDC_PICTURE_TYPE, CB_SETCURSEL,
+                            dlg->datatype == WIA_DATA_COLOR ? 0 : dlg->datatype == WIA_DATA_GRAYSCALE ? 1 : 2, 0);
+        return TRUE;
+    }
+    case WM_HSCROLL:
+    {
+        int id = GetDlgCtrlID((HWND)lparam);
+        LONG pos = SendMessageW((HWND)lparam, TBM_GETPOS, 0, 0);
+        set_slider(hwnd, id, id == IDC_BRIGHTNESS ? IDC_BRIGHTNESS_VAL : IDC_CONTRAST_VAL, pos);
+        return TRUE;
+    }
+    case WM_COMMAND:
+        switch (LOWORD(wparam))
+        {
+        case IDC_RESET:
+            set_slider(hwnd, IDC_BRIGHTNESS, IDC_BRIGHTNESS_VAL, 0);
+            set_slider(hwnd, IDC_CONTRAST, IDC_CONTRAST_VAL, 0);
+            SetDlgItemInt(hwnd, IDC_RESOLUTION, closest_valid(dlg->stg, WIA_IPS_XRES, 150), FALSE);
+            SendDlgItemMessageW(hwnd, IDC_PICTURE_TYPE, CB_SETCURSEL, 0, 0);
+            return TRUE;
+        case IDOK:
+        {
+            int type = SendDlgItemMessageW(hwnd, IDC_PICTURE_TYPE, CB_GETCURSEL, 0, 0);
+            dlg->brightness = SendDlgItemMessageW(hwnd, IDC_BRIGHTNESS, TBM_GETPOS, 0, 0) * 10;
+            dlg->contrast = SendDlgItemMessageW(hwnd, IDC_CONTRAST, TBM_GETPOS, 0, 0) * 10;
+            dlg->resolution = closest_valid(dlg->stg, WIA_IPS_XRES, GetDlgItemInt(hwnd, IDC_RESOLUTION, NULL, FALSE));
+            dlg->datatype = type == 0 ? WIA_DATA_COLOR : type == 1 ? WIA_DATA_GRAYSCALE : WIA_DATA_THRESHOLD;
+            EndDialog(hwnd, IDOK);
+            return TRUE;
+        }
+        case IDCANCEL:
+            EndDialog(hwnd, IDCANCEL);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+static void set_choice_icons(HWND hwnd)
+{
+    static const int ids[] = { IDC_ICON_COLOR, IDC_ICON_GRAY, IDC_ICON_BW, IDC_ICON_CUSTOM };
+    static const COLORREF colours[][3] =
+    {
+        { RGB(0xe0, 0x40, 0x40), RGB(0x40, 0xa0, 0x40), RGB(0x40, 0x60, 0xd0) },
+        { RGB(0x40, 0x40, 0x40), RGB(0x90, 0x90, 0x90), RGB(0xd0, 0xd0, 0xd0) },
+        { RGB(0, 0, 0), RGB(0, 0, 0), RGB(0, 0, 0) },
+        { RGB(0xe0, 0x90, 0x30), RGB(0x60, 0x60, 0x60), RGB(0x40, 0x60, 0xd0) },
+    };
+    unsigned int i, j;
+
+    /* small pictures of each kind of picture: three bars of its colours on a page */
+    for (i = 0; i < ARRAY_SIZE(ids); i++)
+    {
+        BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER), 32, -32, 1, 32, BI_RGB }};
+        HDC hdc = CreateCompatibleDC(NULL);
+        HBITMAP bitmap;
+        void *bits;
+        RECT r;
+
+        bitmap = CreateDIBSection(hdc, &bmi, DIB_RGB_COLORS, &bits, NULL, 0);
+        SelectObject(hdc, bitmap);
+        SetRect(&r, 0, 0, 32, 32);
+        FillRect(hdc, &r, GetSysColorBrush(COLOR_BTNFACE));
+        SetRect(&r, 4, 2, 28, 30);
+        FillRect(hdc, &r, GetStockObject(WHITE_BRUSH));
+        FrameRect(hdc, &r, GetStockObject(GRAY_BRUSH));
+        for (j = 0; j < 3; j++)
+        {
+            HBRUSH brush = CreateSolidBrush(colours[i][j]);
+            SetRect(&r, 8, 6 + j * 7, i == 2 && j == 1 ? 18 : 24, 10 + j * 7);
+            FillRect(hdc, &r, brush);
+            DeleteObject(brush);
+        }
+        DeleteDC(hdc);
+        bitmap = (HBITMAP)SendDlgItemMessageW(hwnd, ids[i], STM_SETIMAGE, IMAGE_BITMAP, (LPARAM)bitmap);
+        if (bitmap) DeleteObject(bitmap);
+    }
+}
+
+static INT_PTR CALLBACK scan_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct scan_dlg *dlg = (struct scan_dlg *)GetWindowLongPtrW(hwnd, DWLP_USER);
+    WCHAR text[256], fmt[128];
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        BSTR name;
+        LONG handling;
+
+        dlg = (struct scan_dlg *)lparam;
+        SetWindowLongPtrW(hwnd, DWLP_USER, lparam);
+        name = read_bstr(dlg->root_stg, WIA_DIP_DEV_NAME);
+        load_string(IDS_SCAN_USING, fmt, ARRAY_SIZE(fmt));
+        swprintf(text, ARRAY_SIZE(text), fmt, name ? name : L"");
+        SysFreeString(name);
+        SetWindowTextW(hwnd, text);
+
+        handling = read_long(dlg->root_stg, WIA_DPS_DOCUMENT_HANDLING_CAPABILITIES, FLAT);
+        dlg->flatbed = (handling & FLAT) != 0;
+        dlg->feeder = (handling & FEED) != 0;
+        if (!dlg->flatbed && !dlg->feeder) dlg->flatbed = TRUE;
+        if (dlg->flatbed)
+        {
+            load_string(IDS_FLATBED, text, ARRAY_SIZE(text));
+            SendDlgItemMessageW(hwnd, IDC_SOURCE, CB_ADDSTRING, 0, (LPARAM)text);
+        }
+        if (dlg->feeder)
+        {
+            load_string(IDS_FEEDER, text, ARRAY_SIZE(text));
+            SendDlgItemMessageW(hwnd, IDC_SOURCE, CB_ADDSTRING, 0, (LPARAM)text);
+        }
+        SendDlgItemMessageW(hwnd, IDC_SOURCE, CB_SETCURSEL, 0, 0);
+        EnableWindow(GetDlgItem(hwnd, IDC_SOURCE), dlg->flatbed && dlg->feeder);
+
+        dlg->choice = (dlg->intent & WIA_INTENT_IMAGE_TYPE_GRAYSCALE) ? CHOICE_GRAY :
+                      (dlg->intent & WIA_INTENT_IMAGE_TYPE_TEXT) ? CHOICE_BW : CHOICE_COLOR;
+        if (dlg->choice == CHOICE_COLOR && !list_has(dlg->stg, WIA_IPA_DATATYPE, WIA_DATA_COLOR))
+            dlg->choice = CHOICE_GRAY;
+        EnableWindow(GetDlgItem(hwnd, IDC_COLOR), list_has(dlg->stg, WIA_IPA_DATATYPE, WIA_DATA_COLOR));
+        CheckRadioButton(hwnd, IDC_COLOR, IDC_CUSTOM, IDC_COLOR + dlg->choice);
+        dlg->brightness = read_long(dlg->stg, WIA_IPS_BRIGHTNESS, 0);
+        dlg->contrast = read_long(dlg->stg, WIA_IPS_CONTRAST, 0);
+        dlg->resolution = closest_valid(dlg->stg, WIA_IPS_XRES, 150);
+        dlg->datatype = read_long(dlg->stg, WIA_IPA_DATATYPE, WIA_DATA_COLOR);
+        set_choice_icons(hwnd);
+
+        preview_attach(&dlg->preview, GetDlgItem(hwnd, IDC_PREVIEW), bed_width(dlg, !dlg->flatbed),
+                       bed_height(dlg, !dlg->flatbed));
+        EnableWindow(GetDlgItem(hwnd, IDC_DO_PREVIEW), dlg->flatbed);
+        return TRUE;
+    }
+    case WM_NOTIFY:
+    {
+        NMHDR *hdr = (NMHDR *)lparam;
+        if (hdr->idFrom == IDC_ADJUST && (hdr->code == NM_CLICK || hdr->code == NM_RETURN))
+        {
+            if (DialogBoxParamW(STI_hInstance, MAKEINTRESOURCEW(IDD_ADVANCED), hwnd, advanced_proc,
+                                (LPARAM)dlg) == IDOK)
+            {
+                dlg->choice = CHOICE_CUSTOM;
+                CheckRadioButton(hwnd, IDC_COLOR, IDC_CUSTOM, IDC_CUSTOM);
+            }
+            return TRUE;
+        }
+        break;
+    }
+    case WM_COMMAND:
+        switch (LOWORD(wparam))
+        {
+        case IDC_COLOR: case IDC_GRAY: case IDC_BW: case IDC_CUSTOM:
+            dlg->choice = LOWORD(wparam) - IDC_COLOR;
+            return TRUE;
+        case IDC_SOURCE:
+            if (HIWORD(wparam) == CBN_SELCHANGE)
+            {
+                BOOL feeder = dlg_uses_feeder(hwnd, dlg);
+                dlg->preview.bed_width = bed_width(dlg, feeder);
+                dlg->preview.bed_height = bed_height(dlg, feeder);
+                if (dlg->preview.bitmap && feeder)
+                {
+                    DeleteObject(dlg->preview.bitmap);
+                    dlg->preview.bitmap = NULL;
+                }
+                dlg->preview.sel[0] = dlg->preview.sel[1] = 0.0;
+                dlg->preview.sel[2] = dlg->preview.sel[3] = 1.0;
+                /* a feeder cannot show the page before it is fed */
+                EnableWindow(GetDlgItem(hwnd, IDC_DO_PREVIEW), !feeder);
+                InvalidateRect(dlg->preview.hwnd, NULL, FALSE);
+            }
+            return TRUE;
+        case IDC_DO_PREVIEW:
+            do_preview(hwnd, dlg);
+            return TRUE;
+        case IDOK:
+            apply_choice(hwnd, dlg);
+            EndDialog(hwnd, IDOK);
+            return TRUE;
+        case IDCANCEL:
+            EndDialog(hwnd, IDCANCEL);
+            return TRUE;
+        }
+        break;
+    case WM_DESTROY:
+        if (dlg && dlg->preview.bitmap) DeleteObject(dlg->preview.bitmap);
+        break;
+    }
+    return FALSE;
+}
+
+/* the first image item of a WIA 1 device */
+static IWiaItem *first_child(IWiaItem *root)
+{
+    IEnumWiaItem *items;
+    IWiaItem *child = NULL;
+    ULONG fetched;
+
+    if (FAILED(IWiaItem_EnumChildItems(root, &items))) return NULL;
+    if (IEnumWiaItem_Next(items, 1, &child, &fetched) != S_OK || fetched != 1) child = NULL;
+    IEnumWiaItem_Release(items);
+    return child;
+}
+
+HRESULT wiaui_device_dialog(HWND parent, IWiaItem *root, LONG flags, LONG intent, LONG *count, IWiaItem ***items)
+{
+    struct scan_dlg dlg = { 0 };
+    IWiaItem *top = NULL;
+    HRESULT hr = S_OK;
+    INT_PTR ret;
+
+    if (FAILED(IWiaItem_GetRootItem(root, &top))) return E_INVALIDARG;
+    dlg.root = top;
+    dlg.flags = flags;
+    dlg.intent = intent;
+    if (!(dlg.item = first_child(dlg.root)))
+    {
+        IWiaItem_Release(top);
+        return E_INVALIDARG;
+    }
+    dlg.root_stg = storage_of((IUnknown *)dlg.root);
+    dlg.stg = storage_of((IUnknown *)dlg.item);
+    if (!dlg.root_stg || !dlg.stg) hr = E_NOINTERFACE;
+    else
+    {
+        init_controls();
+        register_preview_class();
+        ret = DialogBoxParamW(STI_hInstance, MAKEINTRESOURCEW(IDD_SCAN), parent, scan_proc, (LPARAM)&dlg);
+        if (ret == IDOK)
+        {
+            if ((*items = CoTaskMemAlloc(sizeof(IWiaItem *))))
+            {
+                IWiaItem_AddRef(dlg.item);
+                (*items)[0] = dlg.item;
+                *count = 1;
+            }
+            else hr = E_OUTOFMEMORY;
+        }
+        else hr = ret == IDCANCEL ? S_FALSE : E_FAIL;
+    }
+    if (dlg.root_stg) IWiaPropertyStorage_Release(dlg.root_stg);
+    if (dlg.stg) IWiaPropertyStorage_Release(dlg.stg);
+    IWiaItem_Release(dlg.item);
+    IWiaItem_Release(top);
+    return hr;
+}
