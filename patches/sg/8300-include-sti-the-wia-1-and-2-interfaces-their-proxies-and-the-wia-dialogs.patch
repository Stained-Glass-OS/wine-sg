+/* IWiaDataCallback that keeps the image in memory (WIA 1 preview) */
+
+struct memory_callback
+{
+    IWiaDataCallback IWiaDataCallback_iface;
+    LONG ref;
+    BYTE *data;
+    SIZE_T size, used;
+    struct progress *progress;
+};
+
+static inline struct memory_callback *impl_from_IWiaDataCallback(IWiaDataCallback *iface)
+{
+    return CONTAINING_RECORD(iface, struct memory_callback, IWiaDataCallback_iface);
+}
+
+static HRESULT WINAPI memcb_QueryInterface(IWiaDataCallback *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IWiaDataCallback))
+    {
+        IWiaDataCallback_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI memcb_AddRef(IWiaDataCallback *iface)
+{
+    return InterlockedIncrement(&impl_from_IWiaDataCallback(iface)->ref);
+}
+
+static ULONG WINAPI memcb_Release(IWiaDataCallback *iface)
+{
+    return InterlockedDecrement(&impl_from_IWiaDataCallback(iface)->ref);
+}
+
+static HRESULT WINAPI memcb_BandedDataCallback(IWiaDataCallback *iface, LONG message, LONG status, LONG percent,
+                                               LONG offset, LONG length, LONG reserved, LONG res_length, BYTE *buffer)
+{
+    struct memory_callback *This = impl_from_IWiaDataCallback(iface);
+
+    switch (message)
+    {
+    case IT_MSG_DATA_HEADER:
+        if (buffer && length >= sizeof(WIA_DATA_CALLBACK_HEADER))
+        {
+            const WIA_DATA_CALLBACK_HEADER *header = (const WIA_DATA_CALLBACK_HEADER *)buffer;
+            if (header->lBufferSize > 0 && (This->data = malloc(header->lBufferSize)))
+                This->size = header->lBufferSize;
+        }
+        break;
+    case IT_MSG_DATA:
+        if (!buffer || offset < 0 || length < 0) break;
+        if ((SIZE_T)offset + length > This->size)
+        {
+            BYTE *grown = realloc(This->data, offset + length);
+            if (!grown) return E_OUTOFMEMORY;
+            This->data = grown;
+            This->size = offset + length;
+        }
+        memcpy(This->data + offset, buffer, length);
+        This->used = max(This->used, (SIZE_T)offset + length);
+        break;
+    }
+    if (This->progress && !progress_update(This->progress, percent)) return S_FALSE;
+    return S_OK;
+}
+
+static const IWiaDataCallbackVtbl memcb_vtbl =
+{
+    memcb_QueryInterface,
+    memcb_AddRef,
+    memcb_Release,
+    memcb_BandedDataCallback,
+};
+
+/* the preview pane: the bed, the preview picture on it and the area to scan */
+
+struct preview
+{
+    HWND hwnd;
+    HBITMAP bitmap;            /* the preview scan, of the whole bed */
+    LONG bed_width, bed_height;
+    double sel[4];             /* left, top, right, bottom as parts of the bed */
+    BOOL dragging;
+    POINT anchor;
+};
+
+static void preview_page_rect(struct preview *pv, RECT *page)
+{
+    RECT client;
+    int w, h;
+
+    GetClientRect(pv->hwnd, &client);
+    InflateRect(&client, -8, -8);
+    w = client.right - client.left;
+    h = client.bottom - client.top;
+    if (pv->bed_width && pv->bed_height)
+    {
+        if ((double)w / h > (double)pv->bed_width / pv->bed_height) w = MulDiv(h, pv->bed_width, pv->bed_height);
+        else h = MulDiv(w, pv->bed_height, pv->bed_width);
+    }
+    page->left = client.left + (client.right - client.left - w) / 2;
+    page->top = client.top + (client.bottom - client.top - h) / 2;
+    page->right = page->left + w;
+    page->bottom = page->top + h;
+}
+
+static LRESULT CALLBACK preview_wndproc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct preview *pv = (struct preview *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+    RECT page;
+
+    switch (msg)
+    {
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint(hwnd, &ps);
+        RECT client, sel;
+
+        GetClientRect(hwnd, &client);
+        FillRect(hdc, &client, GetSysColorBrush(COLOR_BTNSHADOW));
+        if (pv)
+        {
+            preview_page_rect(pv, &page);
+            FillRect(hdc, &page, GetStockObject(WHITE_BRUSH));
+            if (pv->bitmap)
+            {
+                HDC mem = CreateCompatibleDC(hdc);
+                BITMAP bm;
+                GetObjectW(pv->bitmap, sizeof(bm), &bm);
+                SelectObject(mem, pv->bitmap);
+                SetStretchBltMode(hdc, HALFTONE);
+                StretchBlt(hdc, page.left, page.top, page.right - page.left, page.bottom - page.top, mem, 0, 0,
+                           bm.bmWidth, bm.bmHeight, SRCCOPY);
+                DeleteDC(mem);
+            }
+            sel.left = page.left + (LONG)(pv->sel[0] * (page.right - page.left));
+            sel.top = page.top + (LONG)(pv->sel[1] * (page.bottom - page.top));
+            sel.right = page.left + (LONG)(pv->sel[2] * (page.right - page.left));
+            sel.bottom = page.top + (LONG)(pv->sel[3] * (page.bottom - page.top));
+            if (pv->bitmap && (pv->sel[0] > 0 || pv->sel[1] > 0 || pv->sel[2] < 1 || pv->sel[3] < 1))
+            {
+                HPEN pen = CreatePen(PS_DOT, 1, RGB(0, 0x78, 0xd7));
+                HGDIOBJ oldpen = SelectObject(hdc, pen), oldbrush = SelectObject(hdc, GetStockObject(NULL_BRUSH));
+                Rectangle(hdc, sel.left, sel.top, sel.right, sel.bottom);
+                SelectObject(hdc, oldpen);
+                SelectObject(hdc, oldbrush);
+                DeleteObject(pen);
+            }
+        }
+        EndPaint(hwnd, &ps);
+        return 0;
+    }
+    case WM_LBUTTONDOWN:
+        if (!pv || !pv->bitmap) break;
+        SetCapture(hwnd);
+        pv->dragging = TRUE;
+        pv->anchor.x = (short)LOWORD(lparam);
+        pv->anchor.y = (short)HIWORD(lparam);
+        return 0;
+    case WM_MOUSEMOVE:
+    case WM_LBUTTONUP:
+        if (!pv || !pv->dragging) break;
+        {
+            POINT pt = { (short)LOWORD(lparam), (short)HIWORD(lparam) };
+            double x0, y0, x1, y1;
+            preview_page_rect(pv, &page);
+            x0 = (double)(min(pt.x, pv->anchor.x) - page.left) / (page.right - page.left);
+            x1 = (double)(max(pt.x, pv->anchor.x) - page.left) / (page.right - page.left);
+            y0 = (double)(min(pt.y, pv->anchor.y) - page.top) / (page.bottom - page.top);
+            y1 = (double)(max(pt.y, pv->anchor.y) - page.top) / (page.bottom - page.top);
+            pv->sel[0] = max(0.0, min(1.0, x0));
+            pv->sel[1] = max(0.0, min(1.0, y0));
+            pv->sel[2] = max(0.0, min(1.0, x1));
+            pv->sel[3] = max(0.0, min(1.0, y1));
+            if (msg == WM_LBUTTONUP)
+            {
+                pv->dragging = FALSE;
+                ReleaseCapture();
+                /* a click without a drag: the whole bed again */
+                if (pv->sel[2] - pv->sel[0] < 0.01 || pv->sel[3] - pv->sel[1] < 0.01)
+                {
+                    pv->sel[0] = pv->sel[1] = 0.0;
+                    pv->sel[2] = pv->sel[3] = 1.0;
+                }
+            }
+            InvalidateRect(hwnd, NULL, FALSE);
+        }
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
