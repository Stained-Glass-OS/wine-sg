+                                 ICC_PROGRESS_CLASS | ICC_LINK_CLASS | ICC_STANDARD_CLASSES };
+    InitCommonControlsEx(&icc);
+}
+
+/* properties */
+
+static LONG read_long(IWiaPropertyStorage *stg, PROPID id, LONG def)
+{
+    PROPSPEC spec;
+    PROPVARIANT value;
+    LONG ret = def;
+
+    spec.ulKind = PRSPEC_PROPID;
+    spec.propid = id;
+    if (IWiaPropertyStorage_ReadMultiple(stg, 1, &spec, &value) == S_OK)
+    {
+        if (value.vt == VT_I4 || value.vt == VT_UI4) ret = value.lVal;
+        PropVariantClear(&value);
+    }
+    return ret;
+}
+
+static BSTR read_bstr(IWiaPropertyStorage *stg, PROPID id)
+{
+    PROPSPEC spec;
+    PROPVARIANT value;
+    BSTR ret = NULL;
+
+    spec.ulKind = PRSPEC_PROPID;
+    spec.propid = id;
+    if (IWiaPropertyStorage_ReadMultiple(stg, 1, &spec, &value) == S_OK)
+    {
+        if (value.vt == VT_BSTR) ret = SysAllocString(value.bstrVal);
+        PropVariantClear(&value);
+    }
+    return ret;
+}
+
+static HRESULT write_long(IWiaPropertyStorage *stg, PROPID id, LONG v)
+{
+    PROPSPEC spec;
+    PROPVARIANT value;
+
+    spec.ulKind = PRSPEC_PROPID;
+    spec.propid = id;
+    value.vt = VT_I4;
+    value.lVal = v;
+    return IWiaPropertyStorage_WriteMultiple(stg, 1, &spec, &value, WIA_IPA_FIRST);
+}
+
+static HRESULT write_guid(IWiaPropertyStorage *stg, PROPID id, const GUID *guid)
+{
+    PROPSPEC spec;
+    PROPVARIANT value;
+
+    spec.ulKind = PRSPEC_PROPID;
+    spec.propid = id;
+    value.vt = VT_CLSID;
+    value.puuid = (GUID *)guid;
+    return IWiaPropertyStorage_WriteMultiple(stg, 1, &spec, &value, WIA_IPA_FIRST);
+}
+
+/* the valid values of a number property: a range, or a list */
+static BOOL read_valid(IWiaPropertyStorage *stg, PROPID id, LONG *min, LONG *max, LONG *step, LONG **list,
+                       ULONG *count)
+{
+    PROPSPEC spec;
+    PROPVARIANT value;
+    ULONG flags;
+    BOOL ret = FALSE;
+
+    *list = NULL;
+    *count = 0;
+    spec.ulKind = PRSPEC_PROPID;
+    spec.propid = id;
+    if (IWiaPropertyStorage_GetPropertyAttributes(stg, 1, &spec, &flags, &value) != S_OK) return FALSE;
+    if (value.vt == (VT_VECTOR | VT_I4))
+    {
+        if (flags & WIA_PROP_RANGE && value.cal.cElems >= 4)
+        {
+            *min = value.cal.pElems[WIA_RANGE_MIN];
+            *max = value.cal.pElems[WIA_RANGE_MAX];
+            *step = max(1, value.cal.pElems[WIA_RANGE_STEP]);
+            ret = TRUE;
+        }
+        else if (flags & WIA_PROP_LIST && value.cal.cElems > WIA_LIST_VALUES)
+        {
+            *count = value.cal.cElems - WIA_LIST_VALUES;
+            if ((*list = malloc(*count * sizeof(LONG))))
+            {
+                memcpy(*list, value.cal.pElems + WIA_LIST_VALUES, *count * sizeof(LONG));
+                *min = (*list)[0];
+                *max = (*list)[*count - 1];
+                *step = 1;
+                ret = TRUE;
+            }
+        }
+    }
+    PropVariantClear(&value);
+    return ret;
+}
+
+static BOOL list_has(IWiaPropertyStorage *stg, PROPID id, LONG v)
+{
+    LONG min, max, step, *list;
+    ULONG count, i;
+    BOOL ret = FALSE;
+
+    if (!read_valid(stg, id, &min, &max, &step, &list, &count)) return FALSE;
+    if (!list) ret = v >= min && v <= max;
+    for (i = 0; i < count; i++) if (list[i] == v) ret = TRUE;
+    free(list);
+    return ret;
+}
+
+static LONG closest_valid(IWiaPropertyStorage *stg, PROPID id, LONG v)
+{
+    LONG min, max, step, *list, best = v;
+    ULONG count, i;
+
+    if (!read_valid(stg, id, &min, &max, &step, &list, &count)) return v;
+    if (list)
+    {
+        best = list[0];
+        for (i = 1; i < count; i++) if (abs(list[i] - v) < abs(best - v)) best = list[i];
+        free(list);
+        return best;
+    }
+    if (v < min) return min;
+    if (v > max) return max;
+    return min + (v - min) / step * step;
+}
+
+static IWiaPropertyStorage *storage_of(IUnknown *unk)
+{
+    IWiaPropertyStorage *stg = NULL;
+
+    if (unk) IUnknown_QueryInterface(unk, &IID_IWiaPropertyStorage, (void **)&stg);
+    return stg;
+}
