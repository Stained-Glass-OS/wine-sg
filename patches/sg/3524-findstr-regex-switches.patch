+    while (linelen && (line[linelen - 1] == '\n' || line[linelen - 1] == '\r')) linelen--;
+    if (exact) return linelen == len && (cs ? !strncmp(line, lit, len) : !_strnicmp(line, lit, len));
+    if (begin) return linelen >= len && (cs ? !strncmp(line, lit, len) : !_strnicmp(line, lit, len));
+    if (end) return linelen >= len && (cs ? !strncmp(line + linelen - len, lit, len) : !_strnicmp(line + linelen - len, lit, len));
