From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 16:28:35 -0700
Subject: [PATCH] urlmon: IStream::CopyTo and region locks on the download
 stream

The stream of a download now implements CopyTo (reads and writes with the byte counts) and answers LockRegion/UnlockRegion with STG_E_INVALIDFUNCTION; the protocol Suspend/Resume FIXMEs become TRACEs because the documentation lists them as not implemented.

diff --git a/dlls/urlmon/binding.c b/dlls/urlmon/binding.c
index b36fa16..0c5bf9a 100644
--- a/dlls/urlmon/binding.c
+++ b/dlls/urlmon/binding.c
@@ -564,8 +564,42 @@ static HRESULT WINAPI ProtocolStream_CopyTo(IStream *iface, IStream *pstm,
         ULARGE_INTEGER cb, ULARGE_INTEGER *pcbRead, ULARGE_INTEGER *pcbWritten)
 {
     ProtocolStream *This = impl_from_IStream(iface);
-    FIXME("(%p)->(%p %ld %p %p)\n", This, pstm, cb.LowPart, pcbRead, pcbWritten);
-    return E_NOTIMPL;
+    ULARGE_INTEGER total_read = {{0}}, total_written = {{0}};
+    BYTE buf[4096];
+    HRESULT hres = S_OK;
+
+    TRACE("(%p)->(%p %I64u %p %p)\n", This, pstm, cb.QuadPart, pcbRead, pcbWritten);
+
+    if(!pstm)
+        return STG_E_INVALIDPOINTER;
+
+    /* read up to cb bytes from the current position and write them to the destination */
+    while(total_read.QuadPart < cb.QuadPart) {
+        ULONG want = (ULONG)min(sizeof(buf), cb.QuadPart - total_read.QuadPart), got = 0, written;
+
+        hres = IStream_Read(iface, buf, want, &got);
+        if(FAILED(hres) || !got)
+            break;
+        total_read.QuadPart += got;
+#ifndef SG_MUTANT_URLMON_COPY
+        hres = IStream_Write(pstm, buf, got, &written);
+        if(FAILED(hres))
+            break;
+        total_written.QuadPart += written;
+        if(written != got) {
+            hres = STG_E_MEDIUMFULL;
+            break;
+        }
+#endif
+    }
+    if(hres == S_FALSE)
+        hres = S_OK; /* the end of the data */
+
+    if(pcbRead)
+        *pcbRead = total_read;
+    if(pcbWritten)
+        *pcbWritten = total_written;
+    return hres;
 }
 
 static HRESULT WINAPI ProtocolStream_Commit(IStream *iface, DWORD grfCommitFlags)
@@ -590,16 +624,21 @@ static HRESULT WINAPI ProtocolStream_LockRegion(IStream *iface, ULARGE_INTEGER l
                                                ULARGE_INTEGER cb, DWORD dwLockType)
 {
     ProtocolStream *This = impl_from_IStream(iface);
-    FIXME("(%p)->(%ld %ld %ld)\n", This, libOffset.LowPart, cb.LowPart, dwLockType);
+    TRACE("(%p)->(%ld %ld %ld)\n", This, libOffset.LowPart, cb.LowPart, dwLockType);
+
+    /* the data of a download cannot be locked */
+#ifdef SG_MUTANT_URLMON_LOCK
     return E_NOTIMPL;
+#endif
+    return STG_E_INVALIDFUNCTION;
 }
 
 static HRESULT WINAPI ProtocolStream_UnlockRegion(IStream *iface,
         ULARGE_INTEGER libOffset, ULARGE_INTEGER cb, DWORD dwLockType)
 {
     ProtocolStream *This = impl_from_IStream(iface);
-    FIXME("(%p)->(%ld %ld %ld)\n", This, libOffset.LowPart, cb.LowPart, dwLockType);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%ld %ld %ld)\n", This, libOffset.LowPart, cb.LowPart, dwLockType);
+    return STG_E_INVALIDFUNCTION;
 }
 
 static HRESULT WINAPI ProtocolStream_Stat(IStream *iface, STATSTG *pstatstg,
