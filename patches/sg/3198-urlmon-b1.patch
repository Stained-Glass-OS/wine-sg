index 0a7afc7..c4c14a1 100644
--- a/dlls/urlmon/bindprot.c
+++ b/dlls/urlmon/bindprot.c
@@ -410,14 +410,16 @@ static HRESULT WINAPI BindProtocol_Terminate(IInternetProtocolEx *iface, DWORD d
 static HRESULT WINAPI BindProtocol_Suspend(IInternetProtocolEx *iface)
 {
     BindProtocol *This = impl_from_IInternetProtocolEx(iface);
-    FIXME("(%p)\n", This);
+    TRACE("(%p)\n", This);
+    /* documented as not implemented for protocols */
     return E_NOTIMPL;
 }
 
