From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: Application-command keys at retrieval again, with the key state (6526)

6524 moved the WM_APPCOMMAND for VK_BROWSER_BACK..VK_LAUNCH_APP2 into
DefWindowProc. Programs that handle WM_KEYDOWN themselves and act on
WM_APPCOMMAND then lost their media keys: VLC's Qt interface takes the
key and never passes it on. The command is sent again when the key
message is retrieved, as before 6524, now with MK_CONTROL/MK_SHIFT in
the low word. What a window passes to DefWindowProc still goes up to the
shell hooks (HSHELL_APPCOMMAND). A window that handles WM_APPCOMMAND
itself keeps it.
---
diff --git a/dlls/win32u/defwnd.c b/dlls/win32u/defwnd.c
index febadba..53e626f 100644
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -3213,25 +3213,6 @@ LRESULT default_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam,
     return default_window_proc_dpi( hwnd, msg, wparam, lparam, ansi );
 }
 
-/* Stained Glass OS (wine-sg 6524): the application-command keys (VK_BROWSER_BACK to VK_LAUNCH_APP2:
- * browser, volume, media and launch keys) a window leaves to DefWindowProc are WM_APPCOMMAND, as the
- * extra mouse buttons are: up to the top-level window, then to the shell hooks (media keys reach
- * the desktop's player controls through them). */
-static void key_app_command( HWND hwnd, WPARAM vk )
-{
-    WORD keys = 0;
-
-    if (vk < VK_BROWSER_BACK || vk > VK_LAUNCH_APP2) return;
-#ifdef SG_MUTANT_APPCMD_NO_KEY
-    return;
-#endif
-    if (NtUserGetKeyState( VK_CONTROL ) & 0x8000) keys |= MK_CONTROL;
-    if (NtUserGetKeyState( VK_SHIFT ) & 0x8000) keys |= MK_SHIFT;
-    /* APPCOMMAND_BROWSER_BACKWARD (1) to APPCOMMAND_LAUNCH_APP2 (18), in the keys' order */
-    send_message( hwnd, WM_APPCOMMAND, (WPARAM)hwnd,
-                  MAKELPARAM( keys, FAPPCOMMAND_KEY | (vk - VK_BROWSER_BACK + APPCOMMAND_BROWSER_BACKWARD) ));
-}
-
 static LRESULT default_window_proc_dpi( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, BOOL ansi )
 {
     LRESULT result = 0;
@@ -3609,11 +3590,9 @@ static LRESULT default_window_proc_dpi( HWND hwnd, UINT msg, WPARAM wparam, LPAR
 
     case WM_KEYDOWN:
         if (wparam == VK_F10) f10_key = VK_F10;
-        key_app_command( hwnd, wparam );
         break;
 
     case WM_SYSKEYDOWN:
-        key_app_command( hwnd, wparam );
         if (HIWORD( lparam ) & KEYDATA_ALT)
         {
             if ((wparam == VK_MENU || wparam == VK_LMENU || wparam == VK_RMENU) && !menu_sys_key)
diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index 68fba8f..16276f4 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2482,9 +2482,20 @@ static BOOL process_keyboard_message( MSG *msg, UINT hw_id, HWND hwnd_filter,
             {
                 NtUserPostMessage( msg->hwnd, WM_KEYF1, 0, 0 );
             }
-            /* Stained Glass OS (wine-sg 6524): the application-command keys are WM_APPCOMMAND in
-             * DefWindowProc (defwnd.c), as on Windows: not here, for every key, also of a window
-             * that handles WM_KEYDOWN itself (and twice for one that does not) */
+            else if (msg->wParam >= VK_BROWSER_BACK && msg->wParam <= VK_LAUNCH_APP2)
+            {
+                /* Stained Glass OS (wine-sg 6526): back here from DefWindowProc (6524): programs
+                 * that handle the key themselves still get WM_APPCOMMAND (VLC's Qt interface
+                 * takes WM_KEYDOWN and acts on WM_APPCOMMAND), with the key state */
+                WORD keys = 0;
+
+                if (NtUserGetKeyState( VK_CONTROL ) & 0x8000) keys |= MK_CONTROL;
+                if (NtUserGetKeyState( VK_SHIFT ) & 0x8000) keys |= MK_SHIFT;
+#ifndef SG_MUTANT_APPCMD_NO_KEY
+                send_message( msg->hwnd, WM_APPCOMMAND, (WPARAM)msg->hwnd,
+                              MAKELPARAM( keys, FAPPCOMMAND_KEY | (msg->wParam - VK_BROWSER_BACK + APPCOMMAND_BROWSER_BACKWARD) ));
+#endif
+            }
         }
         else if (msg->message == WM_KEYUP)
         {
