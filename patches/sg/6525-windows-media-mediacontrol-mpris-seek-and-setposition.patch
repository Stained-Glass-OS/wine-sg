 };
 
 struct button_event
 {
     UINT64 session;
+    INT64 position_us;
     UINT32 button;
+    UINT32 kind;
 };
 
 static pthread_mutex_t mpris_mutex = PTHREAD_MUTEX_INITIALIZER;
@@ -187,6 +192,30 @@ static void dict_entry_strings( DBusMessageIter *dict, const char *key, const ch
     p_dbus_message_iter_close_container( dict, &entry );
 }
 
+static INT64 elapsed_us( const struct timespec *since )
+{
+    struct timespec now;
+
+    clock_gettime( CLOCK_MONOTONIC, &now );
+    return (now.tv_sec - since->tv_sec) * 1000000 + (now.tv_nsec - since->tv_nsec) / 1000;
+}
+
+/* where the track is now: the program's last position, moved on at its rate while it plays */
+static INT64 current_position( const struct session *s )
+{
+    INT64 pos = s->base_us > 0 ? s->base_us : 0;
+
+    if (s->state.status == MPRIS_PLAYING)
+        pos += (INT64)(elapsed_us( &s->stamp ) * (s->state.rate > 0 ? s->state.rate : 1.0));
+    if (s->state.length_us > 0 && pos > s->state.length_us) pos = s->state.length_us;
+    return pos;
+}
+
+static void get_track_path( const struct session *s, char *path, size_t size )
+{
+    snprintf( path, size, "/org/stainedglass/mpris/track%u", s->track );
+}
+
 /* the Metadata dictionary, as a variant */
 static void append_metadata( DBusMessageIter *iter, struct session *s )
 {
@@ -194,7 +223,7 @@ static void append_metadata( DBusMessageIter *iter, struct session *s )
     char track_path[96], art_url[1100];
     const char *p;
 
-    snprintf( track_path, sizeof(track_path), "/org/stainedglass/mpris/track%u", s->track );
+    get_track_path( s, track_path, sizeof(track_path) );
     p_dbus_message_iter_open_container( iter, DBUS_TYPE_VARIANT, "a{sv}", &variant );
     p_dbus_message_iter_open_container( &variant, DBUS_TYPE_ARRAY, "{sv}", &dict );
     p = track_path;
@@ -272,13 +301,13 @@ static BOOL append_property( DBusMessageIter *iter, struct session *s, const cha
     else if (!strcmp( name, "MinimumRate" ) || !strcmp( name, "MaximumRate" ) || !strcmp( name, "Volume" ))
     { d = 1.0; append_variant( iter, DBUS_TYPE_DOUBLE, &d ); }
     else if (!strcmp( name, "Position" ))
-    { INT64 pos = s->state.position_us > 0 ? s->state.position_us : 0; append_variant( iter, DBUS_TYPE_INT64, &pos ); }
+    { INT64 pos = current_position( s ); append_variant( iter, DBUS_TYPE_INT64, &pos ); }
     else if (!strcmp( name, "Metadata" )) append_metadata( iter, s );
     else if (!strcmp( name, "CanPlay" )) { flag = !!s->state.can_play; append_variant( iter, DBUS_TYPE_BOOLEAN, &flag ); }
     else if (!strcmp( name, "CanPause" )) { flag = !!s->state.can_pause; append_variant( iter, DBUS_TYPE_BOOLEAN, &flag ); }
     else if (!strcmp( name, "CanGoNext" )) { flag = !!s->state.can_next; append_variant( iter, DBUS_TYPE_BOOLEAN, &flag ); }
     else if (!strcmp( name, "CanGoPrevious" )) { flag = !!s->state.can_previous; append_variant( iter, DBUS_TYPE_BOOLEAN, &flag ); }
-    else if (!strcmp( name, "CanSeek" )) append_variant( iter, DBUS_TYPE_BOOLEAN, &no );
+    else if (!strcmp( name, "CanSeek" )) { flag = !!s->state.can_seek; append_variant( iter, DBUS_TYPE_BOOLEAN, &flag ); }
     else if (!strcmp( name, "CanControl" )) append_variant( iter, DBUS_TYPE_BOOLEAN, &yes );
     else return FALSE;
     return TRUE;
@@ -309,7 +338,7 @@ static void append_all( DBusMessageIter *iter, struct session *s, const char *if
 static void emit_changed( struct session *s )
 {
     static const char *const changed[] = { "PlaybackStatus", "LoopStatus", "Shuffle", "Rate", "Metadata", "CanPlay",
-                                           "CanPause", "CanGoNext", "CanGoPrevious", NULL };
+                                           "CanPause", "CanGoNext", "CanGoPrevious", "CanSeek", NULL };
     DBusMessageIter iter, array;
     const char *iface = PLAYER_IFACE;
     DBusMessage *msg;
@@ -365,10 +394,40 @@ static void queue_button( struct session *s, UINT32 button )
     if (event_count < ARRAY_SIZE(events))
     {
         events[event_count].session = s->id;
+        events[event_count].kind = MPRIS_REQUEST_BUTTON;
         events[event_count++].button = button;
     }
 }
 
+/* a position asked for, kept in the program's seekable range */
+static void queue_position( struct session *s, INT64 pos )
+{
+    if (pos < s->state.min_seek_us) pos = s->state.min_seek_us;
+    if (pos > s->state.max_seek_us) pos = s->state.max_seek_us;
+    TRACE( "%s: position %s us\n", s->name, wine_dbgstr_longlong( pos ) );
+#ifndef SG_MUTANT_MPRIS_NO_SEEK
+    if (event_count < ARRAY_SIZE(events))
+    {
+        events[event_count].session = s->id;
+        events[event_count].kind = MPRIS_REQUEST_POSITION;
+        events[event_count++].position_us = pos;
+    }
+#endif
+}
+
+/* the position jumped (the specification's Seeked) */
+static void emit_seeked( struct session *s )
+{
+    DBusMessage *msg;
+    INT64 pos = current_position( s );
+
+    if (!(msg = p_dbus_message_new_signal( MPRIS_PATH, PLAYER_IFACE, "Seeked" ))) return;
+    p_dbus_message_append_args( msg, DBUS_TYPE_INT64, &pos, DBUS_TYPE_INVALID );
+    p_dbus_connection_send( s->conn, msg, NULL );
+    p_dbus_message_unref( msg );
+    p_dbus_connection_flush( s->conn );
+}
+
 /* a method call to the session's player */
 static void handle_call( struct session *s, DBusMessage *msg )
 {
@@ -444,7 +503,46 @@ static void handle_call( struct session *s, DBusMessage *msg )
         else if (!strcmp( member, "Stop" )) { if (s->state.can_stop) queue_button( s, BUTTON_STOP ); }
         else if (!strcmp( member, "Next" )) { if (s->state.can_next) queue_button( s, BUTTON_NEXT ); }
         else if (!strcmp( member, "Previous" )) { if (s->state.can_previous) queue_button( s, BUTTON_PREVIOUS ); }
-        else if (strcmp( member, "Seek" ) && strcmp( member, "SetPosition" ) && strcmp( member, "OpenUri" ))
+        else if (!strcmp( member, "Seek" ))
+        {
+            /* an offset from where the track is; before its start is its start */
+            dbus_int64_t offset;
+            DBusError err;
+
+            p_dbus_error_init( &err );
+            if (!p_dbus_message_get_args( msg, &err, DBUS_TYPE_INT64, &offset, DBUS_TYPE_INVALID ))
+            {
+                reply = p_dbus_message_new_error( msg, DBUS_ERROR_INVALID_ARGS, "invalid arguments" );
+                p_dbus_error_free( &err );
+                goto done;
+            }
+            if (s->state.can_seek)
+            {
+                INT64 pos = current_position( s ) + offset;
+                queue_position( s, pos < 0 ? 0 : pos );
+            }
+        }
+        else if (!strcmp( member, "SetPosition" ))
+        {
+            /* for this track only, and within it */
+            const char *track;
+            char current[96];
+            dbus_int64_t pos;
+            DBusError err;
+
+            p_dbus_error_init( &err );
+            if (!p_dbus_message_get_args( msg, &err, DBUS_TYPE_OBJECT_PATH, &track, DBUS_TYPE_INT64, &pos, DBUS_TYPE_INVALID ))
+            {
+                reply = p_dbus_message_new_error( msg, DBUS_ERROR_INVALID_ARGS, "invalid arguments" );
+                p_dbus_error_free( &err );
+                goto done;
+            }
+            get_track_path( s, current, sizeof(current) );
+            if (s->state.can_seek && !strcmp( track, current ) && pos >= 0 &&
+                (s->state.length_us <= 0 || pos <= s->state.length_us))
+                queue_position( s, pos );
+        }
+        else if (strcmp( member, "OpenUri" ))
         {
             reply = p_dbus_message_new_error( msg, DBUS_ERROR_UNKNOWN_METHOD, "no such method" );
             goto done;
@@ -534,7 +632,8 @@ static NTSTATUS mpris_update( void *args )
 {
     struct mpris_update_params *params = args;
     struct session *s, **prev;
-    BOOL changed_track;
+    BOOL changed_track, seeked = FALSE;
+    INT64 expected;
 
     params->result = 0;
     if (!load_dbus()) return STATUS_NOT_SUPPORTED;
@@ -561,6 +660,8 @@ static NTSTATUS mpris_update( void *args )
         }
         s->id = params->session;
         s->state = *params;
+        s->base_us = params->position_us;
+        clock_gettime( CLOCK_MONOTONIC, &s->stamp );
         if (!open_session( s ))
         {
             free( s );
@@ -572,10 +673,26 @@ static NTSTATUS mpris_update( void *args )
     }
     changed_track = strcmp( s->state.title, params->title ) || strcmp( s->state.artist, params->artist ) ||
                     strcmp( s->state.album, params->album );
+    expected = current_position( s );
+    if (params->timeline)
+    {
+        /* the program's own position; a jump of more than a second is a seek */
+        seeked = llabs( (params->position_us > 0 ? params->position_us : 0) - expected ) > 1000000;
+        s->base_us = params->position_us;
+        clock_gettime( CLOCK_MONOTONIC, &s->stamp );
+    }
+    else if ((s->state.status == MPRIS_PLAYING) != (params->status == MPRIS_PLAYING) ||
+             s->state.rate != params->rate)
+    {
+        /* it stopped, started or changed speed where it was */
+        s->base_us = expected;
+        clock_gettime( CLOCK_MONOTONIC, &s->stamp );
+    }
     s->state = *params;
     if (changed_track) s->track++;
 #ifndef SG_MUTANT_MPRIS_NO_SIGNAL
     emit_changed( s );
+    if (seeked && !changed_track) emit_seeked( s );
 #endif
     params->result = 1;
     pthread_mutex_unlock( &mpris_mutex );
@@ -649,6 +766,8 @@ static NTSTATUS mpris_wait( void *args )
         {
             params->session = events[0].session;
             params->button = events[0].button;
+            params->kind = events[0].kind;
+            params->position_us = events[0].position_us;
             memmove( events, events + 1, --event_count * sizeof(*events) );
             pthread_mutex_unlock( &mpris_mutex );
             return STATUS_SUCCESS;
