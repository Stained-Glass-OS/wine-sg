+/* the position-change request's arguments (wine-sg 6525) */
+struct position_args
+{
+    IPlaybackPositionChangeRequestedEventArgs IPlaybackPositionChangeRequestedEventArgs_iface;
+    LONG ref;
+    TimeSpan position;
+};
+
+static inline struct position_args *impl_from_IPlaybackPositionChangeRequestedEventArgs( IPlaybackPositionChangeRequestedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct position_args, IPlaybackPositionChangeRequestedEventArgs_iface );
+}
+
+static HRESULT WINAPI position_args_QueryInterface( IPlaybackPositionChangeRequestedEventArgs *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IPlaybackPositionChangeRequestedEventArgs ))
+    {
+        *out = iface;
+        IInspectable_AddRef( (IInspectable *)iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI position_args_AddRef( IPlaybackPositionChangeRequestedEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_IPlaybackPositionChangeRequestedEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI position_args_Release( IPlaybackPositionChangeRequestedEventArgs *iface )
+{
+    struct position_args *impl = impl_from_IPlaybackPositionChangeRequestedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI position_args_GetIids( IPlaybackPositionChangeRequestedEventArgs *iface, ULONG *iid_count, IID **iids )
+{
+    return SG_GET_IIDS( iid_count, iids, &IID_IPlaybackPositionChangeRequestedEventArgs );
+}
+
+static HRESULT WINAPI position_args_GetRuntimeClassName( IPlaybackPositionChangeRequestedEventArgs *iface, HSTRING *class_name )
+{
+    return sg_class_name( L"Windows.Media.PlaybackPositionChangeRequestedEventArgs", class_name );
+}
+
+static HRESULT WINAPI position_args_GetTrustLevel( IPlaybackPositionChangeRequestedEventArgs *iface, TrustLevel *trust_level )
+{
+    return sg_get_trust_level( trust_level );
+}
+
+static HRESULT WINAPI position_args_get_RequestedPlaybackPosition( IPlaybackPositionChangeRequestedEventArgs *iface, TimeSpan *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_IPlaybackPositionChangeRequestedEventArgs( iface )->position;
+    return S_OK;
+}
+
+static const struct IPlaybackPositionChangeRequestedEventArgsVtbl position_args_vtbl =
+{
+    position_args_QueryInterface,
+    position_args_AddRef,
+    position_args_Release,
+    position_args_GetIids,
+    position_args_GetRuntimeClassName,
+    position_args_GetTrustLevel,
+    position_args_get_RequestedPlaybackPosition,
+};
+
+/* an event to every handler of a list, outside the lock (the handlers' Invoke( sender, args ) all
+ * have the same layout) */
+static void raise_event( struct media_control *impl, struct list *list, IInspectable *args )
 {
-    struct button_args *args;
     struct handler *entry;
     IUnknown **handlers;
     UINT count = 0, i;
 
-    if (!(args = calloc( 1, sizeof(*args) ))) return;
-    args->ISystemMediaTransportControlsButtonPressedEventArgs_iface.lpVtbl = &button_args_vtbl;
-    args->ref = 1;
-    args->button = button;
-
     AcquireSRWLockShared( &event_lock );
-    LIST_FOR_EACH_ENTRY( entry, &impl->button_handlers, struct handler, entry ) count++;
+    LIST_FOR_EACH_ENTRY( entry, list, struct handler, entry ) count++;
     if ((handlers = calloc( max( count, 1 ), sizeof(*handlers) )))
     {
         count = 0;
-        LIST_FOR_EACH_ENTRY( entry, &impl->button_handlers, struct handler, entry )
+        LIST_FOR_EACH_ENTRY( entry, list, struct handler, entry )
         {
             handlers[count] = entry->handler;
             IUnknown_AddRef( handlers[count] );
@@ -1448,18 +1518,44 @@ static void raise_button_pressed( struct media_control *impl, SystemMediaTranspo
     else count = 0;
     ReleaseSRWLockShared( &event_lock );
 
-    TRACE( "control %p, button %d, %u handlers\n", impl, button, count );
+    TRACE( "control %p, args %p, %u handlers\n", impl, args, count );
     for (i = 0; i < count; i++)
     {
         ITypedEventHandler_SystemMediaTransportControls_SystemMediaTransportControlsButtonPressedEventArgs_Invoke(
             (ITypedEventHandler_SystemMediaTransportControls_SystemMediaTransportControlsButtonPressedEventArgs *)handlers[i],
-            &impl->ISystemMediaTransportControls_iface, &args->ISystemMediaTransportControlsButtonPressedEventArgs_iface );
+            &impl->ISystemMediaTransportControls_iface, (ISystemMediaTransportControlsButtonPressedEventArgs *)args );
         IUnknown_Release( handlers[i] );
     }
     free( handlers );
+}
+
+static void raise_button_pressed( struct media_control *impl, SystemMediaTransportControlsButton button )
+{
+    struct button_args *args;
+
+    if (!(args = calloc( 1, sizeof(*args) ))) return;
+    args->ISystemMediaTransportControlsButtonPressedEventArgs_iface.lpVtbl = &button_args_vtbl;
+    args->ref = 1;
+    args->button = button;
+    TRACE( "control %p, button %d\n", impl, button );
+    raise_event( impl, &impl->button_handlers, (IInspectable *)&args->ISystemMediaTransportControlsButtonPressedEventArgs_iface );
     ISystemMediaTransportControlsButtonPressedEventArgs_Release( &args->ISystemMediaTransportControlsButtonPressedEventArgs_iface );
 }
 
+/* PlaybackPositionChangeRequested, at the timeline's own time (its start plus the request) */
+static void raise_position_requested( struct media_control *impl, INT64 position_us )
+{
+    struct position_args *args;
+
+    if (!(args = calloc( 1, sizeof(*args) ))) return;
+    args->IPlaybackPositionChangeRequestedEventArgs_iface.lpVtbl = &position_args_vtbl;
+    args->ref = 1;
+    args->position.Duration = impl->start_ticks + position_us * 10;
+    TRACE( "control %p, position %s\n", impl, wine_dbgstr_longlong( args->position.Duration ) );
+    raise_event( impl, &impl->position_handlers, (IInspectable *)&args->IPlaybackPositionChangeRequestedEventArgs_iface );
+    IPlaybackPositionChangeRequestedEventArgs_Release( &args->IPlaybackPositionChangeRequestedEventArgs_iface );
+}
+
 /* an asynchronous operation's end, waited for */
 static HRESULT wait_async( IUnknown *operation )
 {
@@ -1675,8 +1771,9 @@ static DWORD WINAPI mpris_thread( void *arg )
         LeaveCriticalSection( &mpris_cs );
         if (found)
         {
+            if (params.kind == MPRIS_REQUEST_POSITION) raise_position_requested( found, params.position_us );
 #ifndef SG_MUTANT_MPRIS_NO_BUTTON
-            raise_button_pressed( found, params.button );
+            else raise_button_pressed( found, params.button );
 #endif
             ISystemMediaTransportControls_Release( &found->ISystemMediaTransportControls_iface );
         }
@@ -1721,6 +1818,11 @@ static void media_control_publish( struct media_control *impl, BOOL art )
     params->rate = impl->playback_rate;
     params->length_us = impl->length_us;
     params->position_us = impl->position_us;
+    params->min_seek_us = impl->min_seek_us;
+    params->max_seek_us = impl->max_seek_us;
+    params->can_seek = impl->can_seek;
+    params->timeline = impl->timeline_pending;
+    impl->timeline_pending = FALSE;
 
     program_name( params->identity, sizeof(params->identity) );
     /* a bus name element: letters, digits and _, not starting with a digit */
@@ -2358,15 +2460,23 @@ static HRESULT WINAPI media_control2_UpdateTimelineProperties( ISystemMediaTrans
     ISystemMediaTransportControlsTimelineProperties *timeline_properties )
 {
     struct media_control *impl = impl_from_ISystemMediaTransportControls2( iface );
-    TimeSpan start = {0}, end = {0}, position = {0};
+    TimeSpan start = {0}, end = {0}, position = {0}, min_seek = {0}, max_seek = {0};
 
     TRACE( "iface %p, timeline_properties %p\n", iface, timeline_properties );
     if (!timeline_properties) return E_POINTER;
     ISystemMediaTransportControlsTimelineProperties_get_StartTime( timeline_properties, &start );
     ISystemMediaTransportControlsTimelineProperties_get_EndTime( timeline_properties, &end );
     ISystemMediaTransportControlsTimelineProperties_get_Position( timeline_properties, &position );
+    ISystemMediaTransportControlsTimelineProperties_get_MinSeekTime( timeline_properties, &min_seek );
+    ISystemMediaTransportControlsTimelineProperties_get_MaxSeekTime( timeline_properties, &max_seek );
     impl->length_us = end.Duration > start.Duration ? (end.Duration - start.Duration) / 10 : -1;
     impl->position_us = position.Duration > start.Duration ? (position.Duration - start.Duration) / 10 : 0;
+    /* (wine-sg 6525) seekable where the program says, between MinSeekTime and MaxSeekTime */
+    impl->start_ticks = start.Duration;
+    impl->min_seek_us = min_seek.Duration > start.Duration ? (min_seek.Duration - start.Duration) / 10 : 0;
+    impl->max_seek_us = max_seek.Duration > start.Duration ? (max_seek.Duration - start.Duration) / 10 : 0;
+    impl->can_seek = max_seek.Duration > min_seek.Duration;
+    impl->timeline_pending = TRUE;
     media_control_publish( impl, FALSE );
     return S_OK;
 }
diff --git a/dlls/windows.media.mediacontrol/unixlib.c b/dlls/windows.media.mediacontrol/unixlib.c
