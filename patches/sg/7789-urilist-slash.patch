From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: files copied in Wine paste into GTK programs (no escaped "/" in text/uri-list)

Wine offered a CF_HDROP on the clipboard as text/uri-list with every byte
of the Unix path escaped, "/" too (file:///%76%61%72%2f...). GLib's
g_filename_from_uri refuses an escaped "/", so a GTK program pasting files
copied in File Explorer got nothing. The URIs now keep "/" and the
unreserved characters as they are, escape the rest, and name the real
path (C: is dosdevices/c:, a link). The XDND drag source (7787) used its
own writer for this; it now uses this one, which also takes an ANSI
DROPFILES.
---
diff --git a/dlls/winex11.drv/clipboard.c b/dlls/winex11.drv/clipboard.c
index 3ddd7b0..21d85d4 100644
--- a/dlls/winex11.drv/clipboard.c
+++ b/dlls/winex11.drv/clipboard.c
@@ -1557,85 +1557,93 @@ static BOOL export_text_html( Display *display, Window win, Atom prop, Atom targ
  *      export_hdrop
  *
  *  Export CF_HDROP format to text/uri-list.
+ *
+ *  Stained Glass OS (wine-sg 7789): RFC 8089 file URIs of the Unix paths with
+ *  their symbolic links resolved (C: is dosdevices/c:, a link), '/' and the
+ *  unreserved characters as they are. Every byte was escaped, '/' too, and
+ *  GLib's g_filename_from_uri refuses an escaped '/': files copied in Wine
+ *  pasted into GTK programs as nothing. Drags (7787) use the same.
  */
 static BOOL export_hdrop( Display *display, Window win, Atom prop, Atom target, void *data, size_t size )
 {
-    char *textUriList = NULL;
-    UINT textUriListSize = 32;
-    UINT next = 0;
-    const WCHAR *ptr;
-    WCHAR *unicode_data = NULL;
+    static const char hex[] = "0123456789ABCDEF";
     DROPFILES *drop_files = data;
+    WCHAR *unicode_data = NULL;
+    const WCHAR *ptr;
+    char *list = NULL, *tmp;
+    size_t len = 0, max = 0;
 
+    if (size < sizeof(*drop_files) || drop_files->pFiles >= size) return FALSE;
     if (!drop_files->fWide)
     {
         char *files = (char *)data + drop_files->pFiles;
         CPTABLEINFO *cp = get_ansi_cp();
-        DWORD len = 0;
+        DWORD count = 0;
 
-        while (files[len]) len += strlen( files + len ) + 1;
-        len++;
+        while (files[count]) count += strlen( files + count ) + 1;
+        count++;
 
-        if (!(ptr = unicode_data = malloc( len * sizeof(WCHAR) ))) goto failed;
+        if (!(ptr = unicode_data = malloc( count * sizeof(WCHAR) ))) return FALSE;
 
         if (cp->CodePage == CP_UTF8)
-            RtlUTF8ToUnicodeN( unicode_data, len * sizeof(WCHAR), &len, files, len );
+            RtlUTF8ToUnicodeN( unicode_data, count * sizeof(WCHAR), &count, files, count );
         else
-            RtlCustomCPToUnicodeN( cp, unicode_data, len * sizeof(WCHAR), &len, files, len );
+            RtlCustomCPToUnicodeN( cp, unicode_data, count * sizeof(WCHAR), &count, files, count );
     }
     else ptr = (const WCHAR *)((char *)data + drop_files->pFiles);
 
-    if (!(textUriList = malloc( textUriListSize ))) goto failed;
-
-    while (*ptr)
+    for (; *ptr; ptr += lstrlenW( ptr ) + 1)
     {
-        char *unixFilename = NULL;
-        UINT uriSize;
-        UINT u;
-
-        unixFilename = get_unix_file_name( ptr );
-        if (unixFilename == NULL) goto failed;
-        ptr += lstrlenW( ptr ) + 1;
-
-        uriSize = 8 + /* file:/// */
-                3 * (lstrlenA(unixFilename) - 1) + /* "%xy" per char except first '/' */
-                2; /* \r\n */
-        if ((next + uriSize) > textUriListSize)
+        char *unix_name, *real, *path;
+        size_t i, need;
+
+        if (!(unix_name = get_unix_file_name( ptr ))) continue;
+        real = realpath( unix_name, NULL );
+        path = real ? real : unix_name;
+        need = strlen( "file://" ) + 3 * strlen( path ) + 2;
+        if (len + need > max)
         {
-            UINT biggerSize = max( 2 * textUriListSize, next + uriSize );
-            void *bigger = realloc( textUriList, biggerSize );
-            if (bigger)
-            {
-                textUriList = bigger;
-                textUriListSize = biggerSize;
-            }
-            else
+            max = max * 2 + need;
+            if (!(tmp = realloc( list, max )))
             {
-                free( unixFilename );
+                free( real );
+                free( unix_name );
                 goto failed;
             }
+            list = tmp;
         }
-        lstrcpyA(&textUriList[next], "file:///");
-        next += 8;
-        /* URL encode everything - unnecessary, but easier/lighter than linking in shlwapi, and can't hurt */
-        for (u = 1; unixFilename[u]; u++)
+        memcpy( list + len, "file://", 7 );
+        len += 7;
+        for (i = 0; path[i]; i++)
         {
-            static const char hex_table[] = "0123456789abcdef";
-            textUriList[next++] = '%';
-            textUriList[next++] = hex_table[(unsigned char)unixFilename[u] >> 4];
-            textUriList[next++] = hex_table[unixFilename[u] & 0xf];
+            unsigned char c = path[i];
+#ifndef SG_MUTANT_URI_SLASH_ESCAPED
+            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || strchr( "/-._~", c ))
+#else
+            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || strchr( "-._~", c ))
+#endif
+                list[len++] = c;
+            else
+            {
+                list[len++] = '%';
+                list[len++] = hex[c >> 4];
+                list[len++] = hex[c & 15];
+            }
         }
-        textUriList[next++] = '\r';
-        textUriList[next++] = '\n';
-        free( unixFilename );
+        list[len++] = '\r';
+        list[len++] = '\n';
+        free( real );
+        free( unix_name );
     }
-    put_property( display, win, prop, target, 8, textUriList, next );
-    free( textUriList );
+    if (!len) goto failed;
+    put_property( display, win, prop, target, 8, list, len );
+    free( list );
+    free( unicode_data );
     return TRUE;
 
 failed:
+    free( list );
     free( unicode_data );
-    free( textUriList );
     return FALSE;
 }
 
@@ -2302,62 +2310,6 @@ void X11DRV_UpdateClipboard(void)
  * 7787, sg_dragsrc.c), offered and converted as the clipboard's: a file list
  * as text/uri-list, text as UTF-8 and Latin-1 strings, HTML, PNG, a DIB.
  */
-/* CF_HDROP as text/uri-list for a drop (RFC 8089 file URIs): the Unix path with
- * its symbolic links resolved (C: is dosdevices/c:, a link), '/' and the
- * unreserved characters as they are -- GLib's g_filename_from_uri refuses an
- * escaped '/', so the clipboard's every-byte escaping gave GTK programs nothing */
-static BOOL export_sg_uri_list( Display *display, Window win, Atom prop, Atom target, void *data, size_t size )
-{
-    static const char hex[] = "0123456789ABCDEF";
-    DROPFILES *drop = data;
-    const WCHAR *ptr;
-    char *list = NULL, *tmp;
-    size_t len = 0, max = 0;
-
-    if (size < sizeof(*drop) || !drop->fWide || drop->pFiles >= size) return FALSE;
-    for (ptr = (const WCHAR *)((char *)data + drop->pFiles); *ptr; ptr += lstrlenW( ptr ) + 1)
-    {
-        char *unix_name, *real, *path;
-        size_t i, need;
-
-        if (!(unix_name = get_unix_file_name( ptr ))) continue;
-        real = realpath( unix_name, NULL );
-        path = real ? real : unix_name;
-        need = strlen( "file://" ) + 3 * strlen( path ) + 2;
-        if (len + need > max)
-        {
-            max = max * 2 + need;
-            if (!(tmp = realloc( list, max ))) { free( real ); free( unix_name ); free( list ); return FALSE; }
-            list = tmp;
-        }
-        len += sprintf( list + len, "file://" );
-        for (i = 0; path[i]; i++)
-        {
-            unsigned char c = path[i];
-#ifndef SG_MUTANT_DRAG_URI_ESCAPED
-            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || strchr( "/-._~", c ))
-#else
-            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || strchr( "-._~", c ))
-#endif
-                list[len++] = c;
-            else
-            {
-                list[len++] = '%';
-                list[len++] = hex[c >> 4];
-                list[len++] = hex[c & 15];
-            }
-        }
-        list[len++] = '\r';
-        list[len++] = '\n';
-        free( real );
-        free( unix_name );
-    }
-    if (!len) { free( list ); return FALSE; }
-    put_property( display, win, prop, target, 8, list, len );
-    free( list );
-    return TRUE;
-}
-
 static const struct
 {
     const WCHAR *name;   /* a registered format's name */
@@ -2366,7 +2318,7 @@ static const struct
     EXPORTFUNC   export;
 } sg_drag_formats[] =
 {
-    { 0, CF_HDROP,              "text/uri-list",            export_sg_uri_list },
+    { 0, CF_HDROP,              "text/uri-list",            export_hdrop },
     { 0, CF_UNICODETEXT,        "text/plain;charset=utf-8", export_utf8_string },
     { 0, CF_UNICODETEXT,        "UTF8_STRING",              export_utf8_string },
     { 0, CF_UNICODETEXT,        "text/plain",               export_string },
