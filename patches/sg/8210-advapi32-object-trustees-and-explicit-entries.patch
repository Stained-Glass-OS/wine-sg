From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: SetEntriesInAclW takes object trustees; GetExplicitEntriesFromAclW returns object and audit ACEs

TRUSTEE_IS_OBJECTS_AND_SID makes an object ACE with the GUIDs ObjectsPresent names (ACL revision 4); TRUSTEE_IS_OBJECTS_AND_NAME without object names is the account's plain ACE, with names ERROR_NONE_MAPPED (no directory to map schema names). A new ACL over an old one keeps its revision. GetExplicitEntriesFromAclW gives audit ACEs as SET_AUDIT_* and object ACEs as OBJECTS_AND_SID entries. Before, the object forms logged a FIXME and the ACE came out for an uninitialised SID. include/winnt.h gains ACL_REVISION_DS.
---
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -2708,12 +2708,36 @@
         }
         break;
     }
+#ifndef SG_MUTANT_NO_OBJECT_TRUSTEE
+    /* Stained Glass OS: the object trustee forms name their SID (or account) inside the
+     * OBJECTS_AND_SID / OBJECTS_AND_NAME structure; the GUIDs go into an object ACE. */
+    case TRUSTEE_IS_OBJECTS_AND_SID:
+    {
+        OBJECTS_AND_SID *os = (OBJECTS_AND_SID *)pTrustee->ptstrName;
+        if (!os || !os->pSid || !CopySid( nDestinationSidLength, pDestinationSid, os->pSid ))
+        {
+            WARN("bad object trustee %p\n", os);
+            return ERROR_INVALID_PARAMETER;
+        }
+        break;
+    }
+    case TRUSTEE_IS_OBJECTS_AND_NAME:
+    {
+        OBJECTS_AND_NAME_W *on = (OBJECTS_AND_NAME_W *)pTrustee->ptstrName;
+        TRUSTEEW tmp = *pTrustee;
+        if (!on || !on->ptstrName) return ERROR_INVALID_PARAMETER;
+        tmp.TrusteeForm = TRUSTEE_IS_NAME;
+        tmp.ptstrName = on->ptstrName;
+        return trustee_to_sid( nDestinationSidLength, pDestinationSid, &tmp );
+    }
+#else
     case TRUSTEE_IS_OBJECTS_AND_SID:
         FIXME("TRUSTEE_IS_OBJECTS_AND_SID unimplemented\n");
         break;
     case TRUSTEE_IS_OBJECTS_AND_NAME:
         FIXME("TRUSTEE_IS_OBJECTS_AND_NAME unimplemented\n");
         break;
+#endif
     default:
         WARN("bad trustee form %d\n", pTrustee->TrusteeForm);
         return ERROR_INVALID_PARAMETER;
@@ -2783,6 +2807,22 @@
 /******************************************************************************
  * SetEntriesInAclW [ADVAPI32.@]
  */
+#ifndef SG_MUTANT_NO_OBJECT_TRUSTEE
+/* Stained Glass OS: an OBJECTS_AND_SID trustee makes an object ACE, with the GUIDs its
+ * ObjectsPresent flags name. */
+static BOOL entry_object_guids( const TRUSTEEW *trustee, GUID **type, GUID **inherited )
+{
+    OBJECTS_AND_SID *os;
+
+    *type = *inherited = NULL;
+    if (trustee->TrusteeForm != TRUSTEE_IS_OBJECTS_AND_SID) return FALSE;
+    os = (OBJECTS_AND_SID *)trustee->ptstrName;
+    if (os->ObjectsPresent & ACE_OBJECT_TYPE_PRESENT) *type = &os->ObjectTypeGuid;
+    if (os->ObjectsPresent & ACE_INHERITED_OBJECT_TYPE_PRESENT) *inherited = &os->InheritedObjectTypeGuid;
+    return TRUE;
+}
+#endif
+
 DWORD WINAPI SetEntriesInAclW( ULONG count, PEXPLICIT_ACCESSW pEntries,
                                PACL OldAcl, PACL* NewAcl )
 {
@@ -2820,6 +2860,21 @@
         ret = trustee_to_sid( FIELD_OFFSET(SID, SubAuthority[SID_MAX_SUB_AUTHORITIES]), ppsid[i], &pEntries[i].Trustee);
         if (ret)
             goto exit;
+#ifndef SG_MUTANT_NO_OBJECT_TRUSTEE
+        /* an object ACE needs room for its flags and both GUIDs at most */
+        if (pEntries[i].Trustee.TrusteeForm == TRUSTEE_IS_OBJECTS_AND_SID)
+            acl_size += sizeof(DWORD) + 2 * sizeof(GUID);
+        /* object type names are directory schema names, and there is no directory to map them */
+        if (pEntries[i].Trustee.TrusteeForm == TRUSTEE_IS_OBJECTS_AND_NAME &&
+            ((OBJECTS_AND_NAME_W *)pEntries[i].Trustee.ptstrName)->ObjectsPresent)
+        {
+            FIXME("object type names %s %s need a directory\n",
+                  debugstr_w(((OBJECTS_AND_NAME_W *)pEntries[i].Trustee.ptstrName)->ObjectTypeName),
+                  debugstr_w(((OBJECTS_AND_NAME_W *)pEntries[i].Trustee.ptstrName)->InheritedObjectTypeName));
+            ret = ERROR_NONE_MAPPED;
+            goto exit;
+        }
+#endif
 
         /* Note: we overestimate the ACL size here as a tradeoff between
          * instructions (simplicity) and memory */
@@ -2865,7 +2920,12 @@
         goto exit;
     }
 
+#ifndef SG_MUTANT_NO_OBJECT_TRUSTEE
+    /* the old ACL's revision carries over (4 when it holds object ACEs) */
+    status = RtlCreateAcl( *NewAcl, acl_size, OldAcl && OldAcl->AclRevision > ACL_REVISION ? OldAcl->AclRevision : ACL_REVISION );
+#else
     status = RtlCreateAcl( *NewAcl, acl_size, ACL_REVISION );
+#endif
     if (status != STATUS_SUCCESS)
     {
         ret = RtlNtStatusToDosError(status);
@@ -2917,6 +2977,10 @@
             for (i = 0; i < count && !drop[j]; i++)
             {
                 if (!EqualSid( ppsid[i], (PSID)sid )) continue;
+#ifndef SG_MUTANT_NO_OBJECT_TRUSTEE
+                /* an object entry is about one object type; it leaves the plain ACEs alone */
+                if (pEntries[i].Trustee.TrusteeForm == TRUSTEE_IS_OBJECTS_AND_SID) continue;
+#endif
                 switch (pEntries[i].grfAccessMode)
                 {
                 case SET_ACCESS:
@@ -2961,6 +3025,38 @@
                 {
                     ACCESS_MASK mask = pEntries[i].grfAccessPermissions | merged[i];
                     DWORD flags = pEntries[i].grfInheritance;
+#ifndef SG_MUTANT_NO_OBJECT_TRUSTEE
+                    GUID *type, *inherited;
+
+                    if (entry_object_guids( &pEntries[i].Trustee, &type, &inherited ))
+                    {
+                        switch (pEntries[i].grfAccessMode)
+                        {
+                        case DENY_ACCESS:
+                            if (pass == 0)
+                                status = RtlAddAccessDeniedObjectAce( *NewAcl, ACL_REVISION_DS, flags, mask, type,
+                                                                      inherited, ppsid[i] );
+                            break;
+                        case GRANT_ACCESS:
+                        case SET_ACCESS:
+                            if (pass == 2)
+                                status = RtlAddAccessAllowedObjectAce( *NewAcl, ACL_REVISION_DS, flags, mask, type,
+                                                                       inherited, ppsid[i] );
+                            break;
+                        case SET_AUDIT_SUCCESS:
+                        case SET_AUDIT_FAILURE:
+                            if (pass == 2)
+                                status = RtlAddAuditAccessObjectAce( *NewAcl, ACL_REVISION_DS, flags, mask, type,
+                                                                     inherited, ppsid[i],
+                                                                     pEntries[i].grfAccessMode == SET_AUDIT_SUCCESS,
+                                                                     pEntries[i].grfAccessMode == SET_AUDIT_FAILURE );
+                            break;
+                        default:
+                            break;
+                        }
+                        continue;
+                    }
+#endif
 
                     switch (pEntries[i].grfAccessMode)
                     {
@@ -2988,7 +3084,7 @@
             {
                 if (RtlGetAce( OldAcl, j, (void **)&ace )) break;
                 if (drop[j]) continue;
-                status = RtlAddAce( *NewAcl, ACL_REVISION, MAXDWORD, (PACE_HEADER)ace, ace->AceSize );
+                status = RtlAddAce( *NewAcl, OldAcl->AclRevision, MAXDWORD, (PACE_HEADER)ace, ace->AceSize );
             }
         }
         free( merged );
@@ -3244,6 +3340,9 @@
     ACL_SIZE_INFORMATION sizeinfo;
     EXPLICIT_ACCESSW *entries;
     MAX_SID *sid_entries;
+#ifndef SG_MUTANT_NO_OBJECT_TRUSTEE
+    OBJECTS_AND_SID *obj_entries;
+#endif
     ACE_HEADER *ace;
     NTSTATUS status;
     int i;
@@ -3263,9 +3362,17 @@
         return ERROR_SUCCESS;
     }
 
+#ifndef SG_MUTANT_NO_OBJECT_TRUSTEE
+    entries = LocalAlloc(LMEM_FIXED | LMEM_ZEROINIT, (sizeof(EXPLICIT_ACCESSW) + sizeof(MAX_SID) + sizeof(OBJECTS_AND_SID))
+                         * sizeinfo.AceCount);
+    if (!entries) return ERROR_OUTOFMEMORY;
+    sid_entries = (MAX_SID *)(entries + sizeinfo.AceCount);
+    obj_entries = (OBJECTS_AND_SID *)(sid_entries + sizeinfo.AceCount);
+#else
     entries = LocalAlloc(LMEM_FIXED | LMEM_ZEROINIT, (sizeof(EXPLICIT_ACCESSW) + sizeof(MAX_SID)) * sizeinfo.AceCount);
     if (!entries) return ERROR_OUTOFMEMORY;
     sid_entries = (MAX_SID *)(entries + sizeinfo.AceCount);
+#endif
 
     for (i = 0; i < sizeinfo.AceCount; i++)
     {
@@ -3306,6 +3413,67 @@
                 break;
             }
 
+#ifndef SG_MUTANT_NO_OBJECT_TRUSTEE
+            /* Stained Glass OS: audit ACEs come back as SET_AUDIT_* entries, object ACEs with an
+             * OBJECTS_AND_SID trustee carrying their GUIDs */
+            case SYSTEM_AUDIT_ACE_TYPE:
+            {
+                SYSTEM_AUDIT_ACE *audit = (SYSTEM_AUDIT_ACE *)ace;
+                entries[i].grfAccessMode = (ace->AceFlags & SUCCESSFUL_ACCESS_ACE_FLAG) ? SET_AUDIT_SUCCESS : SET_AUDIT_FAILURE;
+                entries[i].grfInheritance = ace->AceFlags & ~(SUCCESSFUL_ACCESS_ACE_FLAG | FAILED_ACCESS_ACE_FLAG);
+                entries[i].grfAccessPermissions = audit->Mask;
+
+                CopySid(sizeof(MAX_SID), (PSID)&sid_entries[i], (PSID)&audit->SidStart);
+                entries[i].Trustee.pMultipleTrustee = NULL;
+                entries[i].Trustee.MultipleTrusteeOperation = NO_MULTIPLE_TRUSTEE;
+                entries[i].Trustee.TrusteeForm = TRUSTEE_IS_SID;
+                entries[i].Trustee.TrusteeType = TRUSTEE_IS_UNKNOWN;
+                entries[i].Trustee.ptstrName = (WCHAR *)&sid_entries[i];
+                break;
+            }
+
+            case ACCESS_ALLOWED_OBJECT_ACE_TYPE:
+            case ACCESS_DENIED_OBJECT_ACE_TYPE:
+            case ACCESS_AUDIT_OBJECT_ACE_TYPE:
+            {
+                /* header, mask, flags, the GUIDs present, the SID */
+                const DWORD *p = (const DWORD *)(ace + 1);
+                const BYTE *pos = (const BYTE *)(p + 2);
+                OBJECTS_AND_SID *os = &obj_entries[i];
+
+                if (ace->AceType == ACCESS_ALLOWED_OBJECT_ACE_TYPE)
+                    entries[i].grfAccessMode = GRANT_ACCESS;
+                else if (ace->AceType == ACCESS_DENIED_OBJECT_ACE_TYPE)
+                    entries[i].grfAccessMode = DENY_ACCESS;
+                else
+                    entries[i].grfAccessMode = (ace->AceFlags & SUCCESSFUL_ACCESS_ACE_FLAG) ? SET_AUDIT_SUCCESS
+                                                                                            : SET_AUDIT_FAILURE;
+                entries[i].grfInheritance = ace->AceFlags;
+                if (ace->AceType == ACCESS_AUDIT_OBJECT_ACE_TYPE)
+                    entries[i].grfInheritance &= ~(SUCCESSFUL_ACCESS_ACE_FLAG | FAILED_ACCESS_ACE_FLAG);
+                entries[i].grfAccessPermissions = p[0];
+                os->ObjectsPresent = p[1] & (ACE_OBJECT_TYPE_PRESENT | ACE_INHERITED_OBJECT_TYPE_PRESENT);
+                if (p[1] & ACE_OBJECT_TYPE_PRESENT)
+                {
+                    memcpy( &os->ObjectTypeGuid, pos, sizeof(GUID) );
+                    pos += sizeof(GUID);
+                }
+                if (p[1] & ACE_INHERITED_OBJECT_TYPE_PRESENT)
+                {
+                    memcpy( &os->InheritedObjectTypeGuid, pos, sizeof(GUID) );
+                    pos += sizeof(GUID);
+                }
+                CopySid(sizeof(MAX_SID), (PSID)&sid_entries[i], (PSID)pos);
+                os->pSid = (SID *)&sid_entries[i];
+                entries[i].Trustee.pMultipleTrustee = NULL;
+                entries[i].Trustee.MultipleTrusteeOperation = NO_MULTIPLE_TRUSTEE;
+                entries[i].Trustee.TrusteeForm = TRUSTEE_IS_OBJECTS_AND_SID;
+                entries[i].Trustee.TrusteeType = TRUSTEE_IS_UNKNOWN;
+                entries[i].Trustee.ptstrName = (WCHAR *)os;
+                break;
+            }
+#endif
+
             default:
                 FIXME("Unhandled ace type %d\n", ace->AceType);
                 entries[i].grfAccessMode = NOT_USED_ACCESS;
--- a/include/winnt.h
+++ b/include/winnt.h
@@ -4316,6 +4316,7 @@
 #define MAX_ACL_REVISION ACL_REVISION4
 
 #define ACL_REVISION 2
+#define ACL_REVISION_DS 4
 
 typedef struct _ACL {
     BYTE AclRevision;
