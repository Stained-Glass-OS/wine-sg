-
-    TRACE("%x got tag %d key %d\n", hPQ, tag, key);
-
+    struct pq *pq = get_pq( hPQ );
+    struct pq_item *item, *prev;
+    int tag;
+
+    if (!pq || !(item = find_min( pq, &prev ))) return -1;
+
+    tag = item->tag;
+    if (prev) prev->next = item->next;
+    else pq->items = item->next;
+    pq->count--;
+    TRACE("%x got tag %d key %d\n", hPQ, tag, item->key);
+    HeapFree( GetProcessHeap(), 0, item );
     return tag;
