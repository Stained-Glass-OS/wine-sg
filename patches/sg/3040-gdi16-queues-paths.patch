@@ -48,16 +48,48 @@ static const char Printers[]          = "System\\CurrentControlSet\\Control\\Pri
 /****************** misc. printer related functions */
 
 /*
- * The following function should implement a queuing system
+ * Priority queues of the print spooler: items are (tag, key) pairs and the item with
+ * the smallest key comes out first.
  */
-struct hpq
+struct pq_item
 {
-    struct hpq 	*next;
-    int		 tag;
-    int		 key;
+    struct pq_item *next;
+    int             tag;
+    int             key;
 };
 
-static struct hpq *hpqueue;
+#define MAX_PQ 16
+
+static struct pq
+{
+    BOOL            used;
+    int             size;     /* maximum number of items */
+    int             count;
+    struct pq_item *items;
+} queues[MAX_PQ];
+
+static struct pq *get_pq( HPQ16 hpq )
+{
+    if (!hpq || hpq > MAX_PQ || !queues[hpq - 1].used) return NULL;
+    return &queues[hpq - 1];
+}
+
+/* the item with the smallest key; the earliest inserted one among equals */
+static struct pq_item *find_min( struct pq *pq, struct pq_item **prev_out )
+{
+    struct pq_item *i, *prev = NULL, *best = NULL, *best_prev = NULL;
+
+    for (i = pq->items; i; prev = i, i = i->next)
+    {
+        if (!best || i->key <= best->key)
+        {
+            best = i;
+            best_prev = prev;
+        }
+    }
+    if (prev_out) *prev_out = best_prev;
+    return best;
+}
 
