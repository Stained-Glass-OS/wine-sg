@@ -93,7 +119,19 @@ HPQ16 WINAPI CreatePQ16(INT16 size)
  */
 INT16 WINAPI DeletePQ16(HPQ16 hPQ)
 {
-    return GlobalFree16(hPQ);
+    struct pq *pq = get_pq( hPQ );
+    struct pq_item *item, *next;
+
+    TRACE("(%x)\n", hPQ);
+
+    if (!pq) return hPQ;  /* like GlobalFree16, the handle is returned on failure */
+    for (item = pq->items; item; item = next)
+    {
+        next = item->next;
+        HeapFree( GetProcessHeap(), 0, item );
+    }
+    memset( pq, 0, sizeof(*pq) );
+    return 0;
 }
 
