 INT16 WINAPI ExtractPQ16(HPQ16 hPQ)
 {
-    struct hpq *queue, *prev, *current, *currentPrev;
-    int key = 0, tag = -1;
-    prev = NULL;
-    queue = current = hpqueue;
-    if (current)
