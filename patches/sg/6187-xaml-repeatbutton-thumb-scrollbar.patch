+/* a ScrollBar of the program's template: as a ScrollBar does, its states (CommonStates, the indicator
+ * of its IndicatorMode, expanded with the mouse indicator), its other orientation's parts hidden, and
+ * its parts sized: the thumb as long as the viewport is of the whole, the large decrease before it as
+ * long as the value puts it */
+static void set_double_if( struct uielem *elem, const WCHAR *name, DOUBLE value )
+{
+    struct xaml_property *prop = xaml_property_find( L"Windows.UI.Xaml.FrameworkElement", name );
+    IInspectable *box;
+    DOUBLE old = -1;
+
+    if (!elem || !prop) return;
+    box = NULL;
+    dobj_get_value( &elem->d, prop, &box );
+    old = xunbox_double( box, -1 );
+    if (box) IInspectable_Release( box );
+    if (fabs( old - value ) < 0.5) return;
+    if ((box = xbox_double( value )))
+    {
+        dobj_set_value( &elem->d, prop, box );
+        IInspectable_Release( box );
+    }
+}
+
+static void set_visibility( struct uielem *elem, BOOL visible )
+{
+    struct xaml_property *prop = xaml_property_find( L"Windows.UI.Xaml.UIElement", L"Visibility" );
+    INT32 v = visible ? 0 : 1;
+    IInspectable *box;
+
+    if (!elem || !prop || elem->visibility == (visible ? XVISIBLE : XCOLLAPSED)) return;
+    if ((box = xbox_ref( &IID_IReference_Visibility, &v, sizeof(v) )))
+    {
+        dobj_set_value( &elem->d, prop, box );
+        IInspectable_Release( box );
+    }
+}
+
+static void scroll_bar_states( struct range *range )
+{
+    static const WCHAR *indicators[] = { L"NoIndicator", L"TouchIndicator", L"MouseIndicator" };
+    INT32 mode = dobj_int( &range->c.e.d, prop_indicator_mode, 0 );
+    IInspectable *outer = (IInspectable *)range->c.e.d.obj.outer;
+    boolean done;
+
+    if (mode < 0 || mode > 2) mode = 0;
+#ifdef SG_MUTANT_SCROLL_BAR_NO_STATES
+    return;
+#endif
+    xaml_go_to_state( outer, L"Normal", FALSE, &done );
+    xaml_go_to_state( outer, indicators[mode], FALSE, &done );
+    xaml_go_to_state( outer, mode == 2 ? L"Expanded" : L"Collapsed", FALSE, &done );
+}
+
+static void hook_part( struct range *range, int which, struct uielem *elem );
+enum { PART_SMALL_DEC, PART_SMALL_INC, PART_LARGE_DEC, PART_LARGE_INC, PART_THUMB };
+
+static void scroll_bar_parts( struct range *range, struct xsize final )
+{
+    struct dobj *d = &range->c.e.d;
+    struct uielem *root = range->c.template_root, *small_dec, *small_inc, *thumb, *large_dec;
+    BOOL horizontal = dobj_int( d, prop_orientation, 0 ) == 1;
+    DOUBLE min = get_double( d, prop_minimum, 0 ), max = get_double( d, prop_maximum, 1 );
+    DOUBLE value = get_double( d, prop_value, 0 ), viewport = get_double( d, prop_viewport, 0 );
+    DOUBLE track, length, before, thumb_min;
+    const WCHAR *size = horizontal ? L"Width" : L"Height";
+
+    set_visibility( xaml_find_name( root, L"HorizontalRoot" ), horizontal );
+    set_visibility( xaml_find_name( root, L"VerticalRoot" ), !horizontal );
+    set_visibility( xaml_find_name( root, L"HorizontalPanningRoot" ), horizontal );
+    set_visibility( xaml_find_name( root, L"VerticalPanningRoot" ), !horizontal );
+    small_dec = xaml_find_name( root, horizontal ? L"HorizontalSmallDecrease" : L"VerticalSmallDecrease" );
+    small_inc = xaml_find_name( root, horizontal ? L"HorizontalSmallIncrease" : L"VerticalSmallIncrease" );
+    large_dec = xaml_find_name( root, horizontal ? L"HorizontalLargeDecrease" : L"VerticalLargeDecrease" );
+    thumb = xaml_find_name( root, horizontal ? L"HorizontalThumb" : L"VerticalThumb" );
+    if (!thumb || !large_dec) return;
+    track = horizontal ? final.width : final.height;
+    if (small_dec) track -= horizontal ? small_dec->desired.width : small_dec->desired.height;
+    if (small_inc) track -= horizontal ? small_inc->desired.width : small_inc->desired.height;
+    track = fmax( track, 0 );
+    thumb_min = horizontal ? thumb->min_width : thumb->min_height;
+    if (!(thumb_min > 0)) thumb_min = 0;
+    if (max <= min) length = 0;
+    else length = viewport > 0 ? track * viewport / (max - min + viewport) : track / 10;
+    length = fmin( fmax( length, thumb_min ), track );
+    before = max > min ? (track - length) * fmin( 1, fmax( 0, (value - min) / (max - min) ) ) : 0;
+#ifdef SG_MUTANT_SCROLL_BAR_PARTS_STILL
+    return;
+#endif
+    set_visibility( thumb, max > min );
+    set_double_if( thumb, size, length );
+    set_double_if( large_dec, size, before );
+    range->track_px = track;
+    range->thumb_px = length;
+    hook_part( range, PART_SMALL_DEC, small_dec );
+    hook_part( range, PART_SMALL_INC, small_inc );
+    hook_part( range, PART_LARGE_DEC, large_dec );
+    hook_part( range, PART_LARGE_INC, xaml_find_name( root, horizontal ? L"HorizontalLargeIncrease" : L"VerticalLargeIncrease" ) );
+    hook_part( range, PART_THUMB, thumb );
+}
+
+/* the parts' events: the small and large buttons step Value, the thumb's drag moves it */
+
+struct part_handler
+{
+    IUnknown IUnknown_iface;
+    LONG ref;
+    struct range *range;            /* NULL once the ScrollBar is gone */
+    int which;
+};
+
+static struct part_handler *part_handler_from_iface( IUnknown *iface )
+{
+    return CONTAINING_RECORD( iface, struct part_handler, IUnknown_iface );
+}
+static HRESULT WINAPI part_handler_QueryInterface( IUnknown *iface, REFIID iid, void **out )
+{
+    *out = iface;   /* a delegate: whatever handler interface it is asked as */
+    IUnknown_AddRef( iface );
+    return S_OK;
+}
+static ULONG WINAPI part_handler_AddRef( IUnknown *iface )
+{
+    return InterlockedIncrement( &part_handler_from_iface( iface )->ref );
+}
+static ULONG WINAPI part_handler_Release( IUnknown *iface )
+{
+    struct part_handler *handler = part_handler_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &handler->ref );
+    if (!ref) free( handler );
+    return ref;
+}
+static HRESULT WINAPI part_handler_Invoke( IUnknown *iface, IInspectable *sender, IInspectable *args )
+{
+    struct part_handler *handler = part_handler_from_iface( iface );
+    struct range *range = handler->range;
+    struct dobj *d;
+    DOUBLE min, max, value, step = 0;
+
+    if (!range) return S_OK;
+    d = &range->c.e.d;
+    min = get_double( d, prop_minimum, 0 );
+    max = get_double( d, prop_maximum, 1 );
+    value = get_double( d, prop_value, 0 );
+    switch (handler->which)
+    {
+    case PART_SMALL_DEC: step = -get_double( d, prop_small_change, 0.1 ); break;
+    case PART_SMALL_INC: step = get_double( d, prop_small_change, 0.1 ); break;
+    case PART_LARGE_DEC: step = -get_double( d, prop_large_change, 1 ); break;
+    case PART_LARGE_INC: step = get_double( d, prop_large_change, 1 ); break;
+    case PART_THUMB:
+    {
+        IInspectable *delta;
+        DOUBLE dx = 0, dy = 0;
+        if (FAILED(IInspectable_QueryInterface( args, &IID_IDragDeltaEventArgs, (void **)&delta ))) return S_OK;
+        ((HRESULT (WINAPI *)( IInspectable *, DOUBLE * ))((void **)delta->lpVtbl)[IDragDeltaEventArgs_HorizontalChange])( delta, &dx );
+        ((HRESULT (WINAPI *)( IInspectable *, DOUBLE * ))((void **)delta->lpVtbl)[IDragDeltaEventArgs_VerticalChange])( delta, &dy );
+        IInspectable_Release( delta );
+        if (range->track_px - range->thumb_px > 0)
+            step = (dobj_int( d, prop_orientation, 0 ) == 1 ? dx : dy) * (max - min) / (range->track_px - range->thumb_px);
+        break;
+    }
+    }
+#ifdef SG_MUTANT_SCROLL_BAR_PARTS_INERT
+    step = 0;
+#endif
+    if (!step) return S_OK;
+    put_double( d, prop_value, fmin( max, fmax( min, value + step ) ) );
+    return S_OK;
+}
+static const void *part_handler_vtbl[] =
+{
+    part_handler_QueryInterface, part_handler_AddRef, part_handler_Release, part_handler_Invoke,
+};
+
+static void hook_part( struct range *range, int which, struct uielem *elem )
+{
+    struct part_handler *handler;
+    IInspectable *iface;
+    INT64 token;
+
+    if (!elem || range->part_elems[which] == elem) return;
+    if (range->parts[which]) range->parts[which]->range = NULL;   /* an old part's: inert */
+    range->part_elems[which] = elem;
+    if (!(handler = calloc( 1, sizeof(*handler) ))) return;
+    handler->IUnknown_iface.lpVtbl = (const IUnknownVtbl *)part_handler_vtbl;
+    handler->ref = 1;
+    handler->range = range;
+    handler->which = which;
+    if (range->parts[which]) IUnknown_Release( &range->parts[which]->IUnknown_iface );
+    range->parts[which] = handler;
+    if (which == PART_THUMB)
+    {
+        if (FAILED(IUnknown_QueryInterface( elem->d.obj.outer, &IID_IThumb, (void **)&iface ))) return;
+        ((HRESULT (WINAPI *)( IInspectable *, IUnknown *, INT64 * ))((void **)iface->lpVtbl)[IThumb_DragDelta])(
+                iface, &handler->IUnknown_iface, &token );
+    }
+    else
+    {
+        if (FAILED(IUnknown_QueryInterface( elem->d.obj.outer, &IID_IButtonBase, (void **)&iface ))) return;
+        ((HRESULT (WINAPI *)( IInspectable *, IUnknown *, INT64 * ))((void **)iface->lpVtbl)[IButtonBase_Click])(
+                iface, &handler->IUnknown_iface, &token );
+    }
+    IInspectable_Release( iface );
+}
+
+static void scroll_bar_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct range *range = range_from_elem( elem );
+
+    if (range->kind == SCROLL_BAR && range->c.template_root)
+    {
+        scroll_bar_states( range );
+        scroll_bar_parts( range, final );
+    }
+    control_arrange( elem, final, used );
+}
+
