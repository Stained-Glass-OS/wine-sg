+    [IThumb_IsDragging] = thumb_get_IsDragging,
+    [IThumb_DragStarted] = toggle_add_DragStarted, [IThumb_RemoveDragStarted] = toggle_remove_DragStarted,
+    [IThumb_DragDelta] = toggle_add_DragDelta, [IThumb_RemoveDragDelta] = toggle_remove_DragDelta,
+    [IThumb_DragCompleted] = toggle_add_DragCompleted, [IThumb_RemoveDragCompleted] = toggle_remove_DragCompleted,
+    [IThumb_CancelDrag] = thumb_CancelDrag,
