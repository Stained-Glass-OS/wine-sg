From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: RepeatButton, Thumb and templated ScrollBars

Windows Terminal draws its scroll bar from a template of its own: RepeatButtons for the arrows and the track, a Thumb, and visual states. RepeatButton (clicks when pressed, after Delay and every Interval while held, not again when released) and Thumb (DragStarted, DragDelta, DragCompleted, IsDragging, CancelDrag) are added. A ScrollBar with a template sizes its parts as Windows does (the thumb as long as the viewport is of the whole, the large decrease before it as the value puts it), hides its other orientation's root, steps Value from its buttons, moves it with the thumb's drag, and goes to its states (CommonStates, its IndicatorMode's indicator, Expanded with the mouse indicator) through a program's CustomVisualStateManager. A button with a template draws only its template, not our face under it. A KeySpline written "0,0,0,1", as compiled markup has it, is read.
---
diff --git a/dlls/windows.ui.xaml/animation.c b/dlls/windows.ui.xaml/animation.c
index 6770b86..9eda4ab 100644
--- a/dlls/windows.ui.xaml/animation.c
+++ b/dlls/windows.ui.xaml/animation.c
@@ -1342,11 +1342,31 @@ HRESULT xaml_animation_value_from_string( const WCHAR *type, const WCHAR *str, I
     {
         struct anim *spline;
         const WCHAR *p = str;
-        struct xpoint a, b;
-        if (!parse_point( &p, &a ) || !parse_point( &p, &b )) return E_INVALIDARG;
+        WCHAR *end;
+        DOUBLE v[4];
+        int i;
+        /* "x1,y1 x2,y2", also all commas ("0,0,0,1", as compiled markup has it) */
+        for (i = 0; i < 4; i++)
+        {
+            while (*p == ' ' || *p == ',' || *p == '\t') p++;
+            v[i] = wcstod( p, &end );
+            if (end == p) break;
+            p = end;
+        }
+        while (*p == ' ' || *p == '\t') p++;
+#ifdef SG_MUTANT_KEYSPLINE_SPACE_ONLY
+        if (!wcschr( str, ' ' )) i = 0;
+#endif
+        if (i < 4 || *p)
+        {
+            WARN( "KeySpline %s\n", debugstr_w( str ) );
+            return E_INVALIDARG;
+        }
         if (!(spline = new_anim( A_KEY_SPLINE, NULL ))) return E_OUTOFMEMORY;
-        spline->cp1 = a;
-        spline->cp2 = b;
+        spline->cp1.x = v[0];
+        spline->cp1.y = v[1];
+        spline->cp2.x = v[2];
+        spline->cp2.y = v[3];
         *value = (IInspectable *)&spline->if0;
         return S_OK;
     }
