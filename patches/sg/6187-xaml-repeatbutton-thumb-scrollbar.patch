+/* RepeatButton: Delay and Interval, in milliseconds */
+#define INT_PROP(prefix, name, prop, def) \
+static HRESULT WINAPI prefix##_get_##name( struct xiface *iface, INT32 *value ) \
+{ if (!value) return E_POINTER; *value = get_int( &button_from_iface( iface )->c.e.d, prop, def ); return S_OK; } \
+static HRESULT WINAPI prefix##_put_##name( struct xiface *iface, INT32 value ) \
+{ if (value < 0) return E_INVALIDARG; return put_boxed( &button_from_iface( iface )->c.e.d, prop, xbox_int32( value ) ); }
+
+INT_PROP(repeat, Delay, prop_delay, 250)
+INT_PROP(repeat, Interval, prop_interval, 250)
+
