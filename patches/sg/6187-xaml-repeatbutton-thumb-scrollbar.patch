+/* ---- RepeatButton: Click when pressed, then again after Delay and every Interval while it is held ---- */
+
+static UINT_PTR repeat_timer;
+
+static INT32 get_int( struct dobj *obj, struct xaml_property *prop, INT32 def )
+{
+    IInspectable *box = NULL;
+    INT32 ret;
+
+    dobj_get_value( obj, prop, &box );
+    ret = xunbox_enum( box, NULL, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static void repeat_stop(void)
+{
+    struct button *button = repeating;
+
+    if (repeat_timer) KillTimer( NULL, repeat_timer );
+    repeat_timer = 0;
+    repeating = NULL;
+    if (button) IUnknown_Release( button->c.e.d.obj.outer );
+}
+
+static void CALLBACK repeat_tick( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
+{
+    struct button *button = repeating;
+
+    if (id != repeat_timer || !button) { KillTimer( NULL, id ); return; }
+    KillTimer( NULL, repeat_timer );
+    repeat_timer = SetTimer( NULL, 0, max( 1, get_int( &button->c.e.d, prop_interval, 250 ) ), repeat_tick );
+    /* while the pointer is on it: off it, held, it waits */
+    if (button->pointer_over)
+    {
+        IUnknown_AddRef( button->c.e.d.obj.outer );
+        xaml_button_click( &button->c.e );
+        IUnknown_Release( button->c.e.d.obj.outer );
+    }
+}
+
+static void repeat_pressed( struct button *button, BOOL pressed )
+{
+    if (!pressed)
+    {
+        if (repeating == button) repeat_stop();
+        return;
+    }
+    repeat_stop();
+    IUnknown_AddRef( button->c.e.d.obj.outer );
+    repeating = button;
+    button->press_clicked = FALSE;
+    xaml_button_click( &button->c.e );
+    button->press_clicked = TRUE;
+#ifndef SG_MUTANT_REPEAT_BUTTON_ONCE
+    repeat_timer = SetTimer( NULL, 0, max( 1, get_int( &button->c.e.d, prop_delay, 250 ) ), repeat_tick );
+#endif
+}
+
+/* ---- Thumb: DragStarted when pressed, DragDelta as the pointer moves, DragCompleted when released ---- */
+
+struct drag_args
+{
+    struct xobj obj;
+    struct xiface IDragStartedEventArgs_iface, IDragDeltaEventArgs_iface, IDragCompletedEventArgs_iface;
+    DOUBLE x, y;
+    boolean canceled;
+};
+
+static const struct xiface_entry drag_args_ifaces[] =
+{
+    { &IID_IDragStartedEventArgs, offsetof(struct drag_args, IDragStartedEventArgs_iface) },
+    { &IID_IDragDeltaEventArgs, offsetof(struct drag_args, IDragDeltaEventArgs_iface) },
+    { &IID_IDragCompletedEventArgs, offsetof(struct drag_args, IDragCompletedEventArgs_iface) },
+};
+
+static const struct xclass drag_args_class =
+{
+    L"Windows.UI.Xaml.Controls.Primitives.DragDeltaEventArgs", drag_args_ifaces, ARRAY_SIZE(drag_args_ifaces), NULL,
+};
+
+static struct drag_args *drag_args_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct drag_args, obj );
+}
+static HRESULT WINAPI drag_args_get_x( struct xiface *iface, DOUBLE *value )
+{
+    if (!value) return E_POINTER;
+    *value = drag_args_from_iface( iface )->x;
+    return S_OK;
+}
+static HRESULT WINAPI drag_args_get_y( struct xiface *iface, DOUBLE *value )
+{
+    if (!value) return E_POINTER;
+    *value = drag_args_from_iface( iface )->y;
+    return S_OK;
+}
+static HRESULT WINAPI drag_args_get_Canceled( struct xiface *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = drag_args_from_iface( iface )->canceled;
+    return S_OK;
+}
+static const void *drag_started_vtbl[] =
+{
+    IDragStartedEventArgs_STUBS,
+    [IDragStartedEventArgs_HorizontalOffset] = drag_args_get_x, [IDragStartedEventArgs_VerticalOffset] = drag_args_get_y,
+};
+static const void *drag_delta_vtbl[] =
+{
+    IDragDeltaEventArgs_STUBS,
+    [IDragDeltaEventArgs_HorizontalChange] = drag_args_get_x, [IDragDeltaEventArgs_VerticalChange] = drag_args_get_y,
+};
+static const void *drag_completed_vtbl[] =
+{
+    IDragCompletedEventArgs_STUBS,
+    [IDragCompletedEventArgs_HorizontalChange] = drag_args_get_x, [IDragCompletedEventArgs_VerticalChange] = drag_args_get_y,
+    [IDragCompletedEventArgs_Canceled] = drag_args_get_Canceled,
+};
+
+static void raise_drag( struct button *thumb, struct handler_list *list, DOUBLE x, DOUBLE y, boolean canceled )
+{
+    struct drag_args *args;
+    IInspectable *sender = NULL, *iface;
+
+    if (!(args = calloc( 1, sizeof(*args) ))) return;
+    args->IDragStartedEventArgs_iface.vtbl = drag_started_vtbl;
+    args->IDragDeltaEventArgs_iface.vtbl = drag_delta_vtbl;
+    args->IDragCompletedEventArgs_iface.vtbl = drag_completed_vtbl;
+    args->x = x;
+    args->y = y;
+    args->canceled = canceled;
+    xobj_init( &args->obj, &drag_args_class, NULL );
+    iface = (IInspectable *)(list == &thumb->drag_started ? &args->IDragStartedEventArgs_iface :
+                             list == &thumb->drag_delta ? &args->IDragDeltaEventArgs_iface : &args->IDragCompletedEventArgs_iface);
+    IUnknown_QueryInterface( thumb->c.e.d.obj.outer, &IID_IInspectable, (void **)&sender );
+    xaml_raise_routed( list, sender, iface );
+    if (sender) IInspectable_Release( sender );
+    IInspectable_Release( iface );
+}
+
+/* the pointer, in the island's coordinates, as the last mouse message had it */
+static POINT pointer;
+
+void xaml_pointer_position( LPARAM lparam )
+{
+    pointer.x = (SHORT)LOWORD( lparam );
+    pointer.y = (SHORT)HIWORD( lparam );
+}
+
+static BOOL is_thumb( struct uielem *elem )
+{
+    const struct xclass *cls = elem->d.obj.cls;
+    unsigned int i;
+
+    for (i = 0; cls && i < cls->count; i++) if (cls->ifaces[i].iid == &IID_IThumb) return TRUE;
+    return FALSE;
+}
+
+static void thumb_end( struct button *thumb, boolean canceled )
+{
+    if (!thumb->dragging) return;
+    thumb->dragging = FALSE;
+    put_boxed( &thumb->c.e.d, prop_is_dragging, xbox_boolean( FALSE ) );
+    raise_drag( thumb, &thumb->drag_completed, thumb->drag_last.x - thumb->drag_start.x,
+                thumb->drag_last.y - thumb->drag_start.y, canceled );
+}
+
+static void thumb_pressed( struct button *thumb, BOOL pressed )
+{
+    struct uielem *e;
+    FLOAT x, y;
+
+    if (!pressed) { thumb_end( thumb, FALSE ); return; }
+    if (thumb->dragging) return;
+    thumb->drag_start = thumb->drag_last = pointer;
+    thumb->dragging = TRUE;
+    put_boxed( &thumb->c.e.d, prop_is_dragging, xbox_boolean( TRUE ) );
+    /* where in the thumb it was taken */
+    x = y = 0;
+    for (e = &thumb->c.e; e; e = e->parent) { x += e->offset.x; y += e->offset.y; }
+    raise_drag( thumb, &thumb->drag_started, pointer.x - x, pointer.y - y, FALSE );
+}
+
+/* the pointer moved while an element is pressed: a Thumb's DragDelta, by what it moved since the last */
+void xaml_pressed_moved( struct uielem *elem )
+{
+    struct button *thumb;
+    POINT pt = pointer;
+
+    if (!elem || !is_thumb( elem )) return;
+    thumb = button_from_elem( elem );
+    if (!thumb->dragging) return;
+    if (pt.x == thumb->drag_last.x && pt.y == thumb->drag_last.y) return;
+#ifndef SG_MUTANT_THUMB_NO_DELTA
+    raise_drag( thumb, &thumb->drag_delta, pt.x - thumb->drag_last.x, pt.y - thumb->drag_last.y, FALSE );
+#endif
+    thumb->drag_last = pt;
+}
+
+BOOL xaml_is_thumb( struct uielem *elem )
+{
+    return elem && is_thumb( elem );
+}
+
 void xaml_button_state( struct uielem *elem, BOOL over, BOOL pressed )
 {
     struct button *button;
 
     if (xaml_is_list_item( elem )) { xaml_list_item_state( elem, over, pressed ); return; }
-    if (!xaml_is_button( elem )) return;
+    if (!xaml_is_button( elem ) && !is_thumb( elem )) return;
     button = button_from_elem( elem );
     if (button->pointer_over == over && button->pressed == pressed) return;
     button->pointer_over = over;
@@ -576,6 +795,32 @@ void xaml_button_state( struct uielem *elem, BOOL over, BOOL pressed )
     xaml_invalidate_visuals();
 }
 
+/* the pointer pressed on an element, and released (or its capture lost): a RepeatButton repeats and a
+ * Thumb drags in between, also while the pointer is off them */
+void xaml_press_begin( struct uielem *elem )
+{
+    struct button *button;
+
+    if (!elem || (!xaml_is_button( elem ) && !is_thumb( elem )) || xaml_is_list_item( elem )) return;
+    button = button_from_elem( elem );
+    if (button->kind == REPEAT_BUTTON) repeat_pressed( button, TRUE );
+    if (button->kind == THUMB) thumb_pressed( button, TRUE );
+}
+
+void xaml_press_end( struct uielem *elem, BOOL canceled )
+{
+    struct button *button;
+
+    if (!elem || (!xaml_is_button( elem ) && !is_thumb( elem )) || xaml_is_list_item( elem )) return;
+    button = button_from_elem( elem );
+    if (button->kind == REPEAT_BUTTON)
+    {
+        repeat_pressed( button, FALSE );
+        if (canceled || !button->pointer_over) button->press_clicked = FALSE;   /* no release click follows */
+    }
+    if (button->kind == THUMB) thumb_end( button, canceled );
+}
+
