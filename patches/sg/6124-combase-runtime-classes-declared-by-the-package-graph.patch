From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase: runtime classes declared by the process's packages are activated

RoGetActivationFactory looked in the activation context and in HKLM ActivatableClassId only. A packaged app finds the classes its own package and the frameworks it depends on declare in their manifests (windows.activatableClass.inProcessServer): a WinUI 3 app's Microsoft.UI.Xaml classes come from the Windows App SDK framework package that way, and App Installer stopped at Microsoft.UI.Xaml.PropertyMetadata. The package graph's manifests are read once and their classes looked up before the registry.
---
diff --git a/dlls/combase/roapi.c b/dlls/combase/roapi.c
index c6e4712..9ae9dd1 100644
--- a/dlls/combase/roapi.c
+++ b/dlls/combase/roapi.c
@@ -27,6 +27,7 @@
 #include "roerrorapi.h"
 #include "winstring.h"
 
+#include "appmodel.h"
 #include "combase_private.h"
 
 #include "wine/debug.h"
@@ -43,6 +44,148 @@ struct activatable_class_data
     DWORD threading_model;
 };
 
+/* Stained Glass OS: the classes the process's packages declare.  A packaged app finds the runtime
+ * classes of its own package and of the frameworks it depends on (the Windows App SDK runtime: WinUI
+ * 3's Microsoft.UI.Xaml.dll and the rest) through their manifests' windows.activatableClass.
+ * inProcessServer extensions, not through the registry.  The package graph is read once; each
+ * manifest is scanned for the extension's <Path> and its ActivatableClassId attributes. */
+struct package_class
+{
+    WCHAR *classid;
+    WCHAR *dll;
+};
+
+static struct package_class *package_classes;
+static unsigned int package_class_count;
+
+static WCHAR *read_manifest(const WCHAR *dir)
+{
+    WCHAR path[MAX_PATH];
+    LARGE_INTEGER size;
+    char *data = NULL;
+    WCHAR *text = NULL;
+    HANDLE file;
+    DWORD read;
+    int len;
+
+    if (swprintf(path, ARRAY_SIZE(path), L"%s\\AppxManifest.xml", dir) < 0) return NULL;
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    if (GetFileSizeEx(file, &size) && size.QuadPart < 16 * 1024 * 1024 && (data = malloc(size.u.LowPart + 1)) &&
+        ReadFile(file, data, size.u.LowPart, &read, NULL))
+    {
+        len = MultiByteToWideChar(CP_UTF8, 0, data, read, NULL, 0);
+        if ((text = malloc((len + 1) * sizeof(WCHAR))))
+        {
+            MultiByteToWideChar(CP_UTF8, 0, data, read, text, len);
+            text[len] = 0;
+        }
+    }
+    free(data);
+    CloseHandle(file);
+    return text;
+}
+
+static WCHAR *dup_range(const WCHAR *start, const WCHAR *end)
+{
+    WCHAR *ret = malloc((end - start + 1) * sizeof(WCHAR));
+    if (ret)
+    {
+        memcpy(ret, start, (end - start) * sizeof(WCHAR));
+        ret[end - start] = 0;
+    }
+    return ret;
+}
+
+static void add_package_class(const WCHAR *classid_start, const WCHAR *classid_end, const WCHAR *dir,
+                              const WCHAR *dll_start, const WCHAR *dll_end)
+{
+    struct package_class *classes;
+    WCHAR *dll, *p;
+    size_t dir_len = wcslen(dir);
+
+    if (!(classes = realloc(package_classes, (package_class_count + 1) * sizeof(*classes)))) return;
+    package_classes = classes;
+    if (!(dll = malloc((dir_len + 1 + (dll_end - dll_start) + 1) * sizeof(WCHAR)))) return;
+    memcpy(dll, dir, dir_len * sizeof(WCHAR));
+    dll[dir_len] = '\\';
+    memcpy(dll + dir_len + 1, dll_start, (dll_end - dll_start) * sizeof(WCHAR));
+    dll[dir_len + 1 + (dll_end - dll_start)] = 0;
+    for (p = dll + dir_len + 1; *p; p++) if (*p == '/') *p = '\\';
+    if (!(classes[package_class_count].classid = dup_range(classid_start, classid_end)))
+    {
+        free(dll);
+        return;
+    }
+    classes[package_class_count++].dll = dll;
+}
+
+static void scan_manifest(const WCHAR *dir, const WCHAR *text)
+{
+    static const WCHAR category[] = L"windows.activatableClass.inProcessServer";
+    static const WCHAR id_attr[] = L"ActivatableClassId=\"";
+    const WCHAR *ext = text, *end, *path, *path_end, *id, *id_end;
+
+    while ((ext = wcsstr(ext, category)))
+    {
+        ext += ARRAY_SIZE(category) - 1;
+        if (!(end = wcsstr(ext, L"Extension>"))) break;
+        if (!(path = wcsstr(ext, L"Path>")) || path > end) continue;
+        path += 5;
+        while (*path == ' ' || *path == '\t' || *path == '\r' || *path == '\n') path++;
+        for (path_end = path; *path_end && *path_end != '<'; path_end++);
+        while (path_end > path && (path_end[-1] == ' ' || path_end[-1] == '\r' || path_end[-1] == '\n' || path_end[-1] == '\t'))
+            path_end--;
+        if (path_end == path) continue;
+        for (id = ext; (id = wcsstr(id, id_attr)) && id < end; id = id_end)
+        {
+            id += ARRAY_SIZE(id_attr) - 1;
+            if (!(id_end = wcschr(id, '"'))) break;
+            add_package_class(id, id_end, dir, path, path_end);
+        }
+    }
+}
+
+static BOOL WINAPI init_package_classes(INIT_ONCE *once, void *param, void **context)
+{
+    UINT32 size = 0, count = 0, i;
+    PACKAGE_INFO *info;
+    BYTE *buffer;
+    WCHAR *text;
+
+    if (GetCurrentPackageInfo(PACKAGE_FILTER_HEAD | PACKAGE_FILTER_DIRECT | PACKAGE_INFORMATION_FULL,
+                              &size, NULL, &count) != ERROR_INSUFFICIENT_BUFFER) return TRUE;
+    if (!(buffer = malloc(size))) return TRUE;
+    if (!GetCurrentPackageInfo(PACKAGE_FILTER_HEAD | PACKAGE_FILTER_DIRECT | PACKAGE_INFORMATION_FULL,
+                               &size, buffer, &count))
+    {
+        info = (PACKAGE_INFO *)buffer;
+        for (i = 0; i < count; i++)
+        {
+            if (!info[i].path || !info[i].path[0] || !(text = read_manifest(info[i].path))) continue;
+            scan_manifest(info[i].path, text);
+            free(text);
+        }
+    }
+    free(buffer);
+    TRACE("%u classes declared by the package graph\n", package_class_count);
+    return TRUE;
+}
+
+static WCHAR *package_class_library(const WCHAR *classid)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    unsigned int i;
+
+#ifdef SG_MUTANT_NO_PACKAGE_CLASSES
+    return NULL;
+#endif
+    InitOnceExecuteOnce(&once, init_package_classes, NULL, NULL);
+    for (i = 0; i < package_class_count; i++)
+        if (!wcscmp(package_classes[i].classid, classid)) return wcsdup(package_classes[i].dll);
+    return NULL;
+}
+
 static HRESULT get_library_for_classid(const WCHAR *classid, WCHAR **out)
 {
     ACTCTX_SECTION_KEYED_DATA data;
@@ -64,6 +207,13 @@ static HRESULT get_library_for_classid(const WCHAR *classid, WCHAR **out)
         return S_OK;
     }
 
+    /* the classes of the process's package and its frameworks */
+    if ((*out = package_class_library(classid)))
+    {
+        TRACE("%s from the package graph: %s\n", debugstr_w(classid), debugstr_w(*out));
+        return S_OK;
+    }
+
     /* load class registry key */
     if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\WindowsRuntime\\ActivatableClassId",
                       0, KEY_READ, &hkey_root))
