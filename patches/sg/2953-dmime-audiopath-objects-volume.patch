-static HRESULT WINAPI IDirectMusicAudioPathImpl_SetVolume (IDirectMusicAudioPath *iface, LONG lVolume, DWORD dwDuration)
+static void CALLBACK path_volume_ramp(void *context, BOOLEAN timer_or_wait)
 {
-  struct IDirectMusicAudioPathImpl *This = impl_from_IDirectMusicAudioPath(iface);
-  FIXME("(%p, %li, %ld): stub\n", This, lVolume, dwDuration);
-  return S_OK;
+    struct IDirectMusicAudioPathImpl *This = context;
+    DWORD elapsed;
+    LONG volume;
+
+    EnterCriticalSection(&This->lock);
+    elapsed = GetTickCount() - This->ramp_tick;
+    if (elapsed >= This->ramp_duration) volume = This->ramp_end;
+    else volume = This->ramp_start + (LONGLONG)(This->ramp_end - This->ramp_start) * elapsed / This->ramp_duration;
+    if (This->pDSBuffer) IDirectSoundBuffer_SetVolume(This->pDSBuffer, volume);
+    LeaveCriticalSection(&This->lock);
 }
 
-static HRESULT WINAPI IDirectMusicAudioPathImpl_ConvertPChannel (IDirectMusicAudioPath *iface, DWORD dwPChannelIn, DWORD* pdwPChannelOut)
+static HRESULT WINAPI IDirectMusicAudioPathImpl_SetVolume(IDirectMusicAudioPath *iface, LONG volume, DWORD duration)
 {
-  struct IDirectMusicAudioPathImpl *This = impl_from_IDirectMusicAudioPath(iface);
-  FIXME("(%p, %ld, %p): stub\n", This, dwPChannelIn, pdwPChannelOut);
-  return S_OK;
+    struct IDirectMusicAudioPathImpl *This = impl_from_IDirectMusicAudioPath(iface);
+    HRESULT hr;
+    LONG current;
+
+    TRACE("(%p, %ld, %lu)\n", This, volume, duration);
+
+    if (!This->pDSBuffer) return DMUS_E_AUDIOPATH_NOBUFFER;
+
+    /* a ramp that is still running is replaced */
+#ifdef SG_MUTANT_VOLUME_STOP
+    if (0)
+#else
+    if (This->ramp_timer)
+#endif
+    {
+        DeleteTimerQueueTimer(NULL, This->ramp_timer, INVALID_HANDLE_VALUE);
+        This->ramp_timer = NULL;
+    }
+
+#ifdef SG_MUTANT_VOLUME_RAMP
+    return IDirectSoundBuffer_SetVolume(This->pDSBuffer, volume);
+#endif
+    if (!duration) return IDirectSoundBuffer_SetVolume(This->pDSBuffer, volume);
+
+    /* the volume moves from its current value to the new one over the duration, in milliseconds */
+    if (FAILED(hr = IDirectSoundBuffer_GetVolume(This->pDSBuffer, &current))) return hr;
+    EnterCriticalSection(&This->lock);
+    This->ramp_start = current;
+    This->ramp_end = volume;
+    This->ramp_tick = GetTickCount();
+    This->ramp_duration = duration;
+    LeaveCriticalSection(&This->lock);
+
+    if (!CreateTimerQueueTimer(&This->ramp_timer, NULL, path_volume_ramp, This, 10, 10, WT_EXECUTEDEFAULT))
+        return HRESULT_FROM_WIN32(GetLastError());
+    return S_OK;
+}
+
+static HRESULT WINAPI IDirectMusicAudioPathImpl_ConvertPChannel(IDirectMusicAudioPath *iface, DWORD pchannel_in,
+        DWORD *pchannel_out)
+{
+    struct IDirectMusicAudioPathImpl *This = impl_from_IDirectMusicAudioPath(iface);
+
+    TRACE("(%p, %lu, %p)\n", This, pchannel_in, pchannel_out);
+
+    if (!pchannel_out) return E_POINTER;
+
+    /* broadcast values do not name a single channel, and stay as they are */
+    if (pchannel_in < DMUS_PCHANNEL_ALL)
+    {
+        /* the channels of the path are the first ones of the performance, so they map onto themselves */
+        if (!This->pPerf) return DMUS_E_NOT_INIT;
+#ifndef SG_MUTANT_CONVERT
+        if (FAILED(IDirectMusicPerformance8_PChannelInfo(This->pPerf, pchannel_in, NULL, NULL, NULL)))
+            return DMUS_E_NOT_FOUND;
+#endif
+    }
+
+    *pchannel_out = pchannel_in;
+    return S_OK;
 }
 
