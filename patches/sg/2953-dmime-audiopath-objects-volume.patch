+static HRESULT WINAPI IDirectMusicAudioPathImpl_GetObjectInPath(IDirectMusicAudioPath *iface, DWORD pchannel,
+        DWORD stage, DWORD buffer, REFGUID guid_object, DWORD index, REFGUID iid, void **ret_iface)
+{
+    struct IDirectMusicAudioPathImpl *This = impl_from_IDirectMusicAudioPath(iface);
+    IDirectMusicGraph *graph;
+    IDirectMusicPort *port;
+    HRESULT hr;
+
+    TRACE("(%p, %lu, %#lx, %lu, %s, %lu, %s, %p)\n", This, pchannel, stage, buffer,
+            debugstr_dmguid(guid_object), index, debugstr_dmguid(iid), ret_iface);
+
+    if (!ret_iface) return E_POINTER;
+    *ret_iface = NULL;
+
+    switch (stage)
+    {
+    case DMUS_PATH_AUDIOPATH:
+        return IDirectMusicAudioPath_QueryInterface(iface, iid, ret_iface);
+
+    case DMUS_PATH_PORT:
+        if (!This->pPerf) return DMUS_E_NOT_INIT;
+        if (pchannel >= DMUS_PCHANNEL_ALL) pchannel = 0;
+        if (FAILED(hr = IDirectMusicPerformance8_PChannelInfo(This->pPerf, pchannel, &port, NULL, NULL)))
+            return DMUS_E_NOT_FOUND;
+        hr = IDirectMusicPort_QueryInterface(port, iid, ret_iface);
+        IDirectMusicPort_Release(port);
+        return hr;
+
+    case DMUS_PATH_BUFFER:
+        if (!This->pDSBuffer) return DMUS_E_AUDIOPATH_NOBUFFER;
+#ifndef SG_MUTANT_PATH_BUFFER_IDX
+        if (buffer) return DMUS_E_NOT_FOUND;
+#endif
+        return IDirectSoundBuffer_QueryInterface(This->pDSBuffer, iid, ret_iface);
+
+    case DMUS_PATH_BUFFER_DMO:
+    {
+        IDirectSoundBuffer8 *buffer8;
+
+        if (!This->pDSBuffer) return DMUS_E_AUDIOPATH_NOBUFFER;
+        if (buffer) return DMUS_E_NOT_FOUND;
+        if (FAILED(hr = IDirectSoundBuffer_QueryInterface(This->pDSBuffer, &IID_IDirectSoundBuffer8,
+                (void **)&buffer8)))
+            return hr;
+        hr = IDirectSoundBuffer8_GetObjectInPath(buffer8, guid_object, index, iid, ret_iface);
+        IDirectSoundBuffer8_Release(buffer8);
+        return hr;
+    }
+
+    case DMUS_PATH_PRIMARY_BUFFER:
+        if (!This->pPrimary) return DMUS_E_AUDIOPATH_NOBUFFER;
+        return IDirectSoundBuffer_QueryInterface(This->pPrimary, iid, ret_iface);
+
+    case DMUS_PATH_AUDIOPATH_GRAPH:
+        if (!This->pToolGraph && FAILED(hr = create_dmgraph(&IID_IDirectMusicGraph, (void **)&This->pToolGraph)))
+            return hr;
+        return IDirectMusicGraph_QueryInterface(This->pToolGraph, iid, ret_iface);
+
+    case DMUS_PATH_AUDIOPATH_TOOL:
+        if (!This->pToolGraph) return DMUS_E_NOT_FOUND;
+        return path_get_tool(This->pToolGraph, guid_object, index, iid, ret_iface);
+
+    case DMUS_PATH_PERFORMANCE:
+        if (!This->pPerf) return DMUS_E_NOT_INIT;
+#ifdef SG_MUTANT_PATH_PERF_IID
+        *ret_iface = This->pPerf;
+        IDirectMusicPerformance8_AddRef(This->pPerf);
+        return S_OK;
+#endif
+        return IDirectMusicPerformance8_QueryInterface(This->pPerf, iid, ret_iface);
+
+    case DMUS_PATH_PERFORMANCE_GRAPH:
+        if (!This->pPerf) return DMUS_E_NOT_INIT;
+        if (FAILED(IDirectMusicPerformance8_GetGraph(This->pPerf, &graph)))
+        {
+            if (FAILED(hr = create_dmgraph(&IID_IDirectMusicGraph, (void **)&graph))) return hr;
+            IDirectMusicPerformance8_SetGraph(This->pPerf, graph);
+        }
+        hr = IDirectMusicGraph_QueryInterface(graph, iid, ret_iface);
+        IDirectMusicGraph_Release(graph);
+        return hr;
+
+    case DMUS_PATH_PERFORMANCE_TOOL:
+        if (!This->pPerf) return DMUS_E_NOT_INIT;
+        if (FAILED(IDirectMusicPerformance8_GetGraph(This->pPerf, &graph))) return DMUS_E_NOT_FOUND;
+        hr = path_get_tool(graph, guid_object, index, iid, ret_iface);
+        IDirectMusicGraph_Release(graph);
+        return hr;
+
+    default:
+        WARN("Unsupported stage %#lx\n", stage);
+        return E_INVALIDARG;
+    }
 }
 
