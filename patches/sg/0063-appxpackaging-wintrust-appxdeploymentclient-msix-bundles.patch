+
+static HRESULT WINAPI bundle_GetManifest( IAppxBundleReader *iface, IAppxBundleManifestReader **manifest )
+{
+    struct bundle *impl = impl_from_IAppxBundleReader( iface );
+    if (!manifest) return E_POINTER;
+    *manifest = &impl->manifest->IAppxBundleManifestReader_iface;
+    IAppxBundleManifestReader_AddRef( *manifest );
+    return S_OK;
+}
+
+static HRESULT WINAPI bundle_GetPayloadPackages( IAppxBundleReader *iface, IAppxFilesEnumerator **packages )
+{
+    return package_GetPayloadFiles( &impl_from_IAppxBundleReader( iface )->pkg->IAppxPackageReader_iface, packages );
+}
+
+static HRESULT WINAPI bundle_GetPayloadPackage( IAppxBundleReader *iface, LPCWSTR name, IAppxFile **package )
+{
+    return package_GetPayloadFile( &impl_from_IAppxBundleReader( iface )->pkg->IAppxPackageReader_iface, name, package );
+}
