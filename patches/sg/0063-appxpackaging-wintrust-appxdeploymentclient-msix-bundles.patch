+/* ---- bundles ----------------------------------------------------------------- */
+
+struct bundle_package
+{
+    WCHAR *file_name, *resource_id;
+    UINT64 version, offset, size;
+    APPX_PACKAGE_ARCHITECTURE architecture;
+    APPX_BUNDLE_PAYLOAD_PACKAGE_TYPE type;
+};
+
+struct bundle_manifest
+{
+    IAppxBundleManifestReader IAppxBundleManifestReader_iface;
+    LONG ref;
+    struct package_identity identity;   /* the bundle's own: neutral, resource ID "~" */
+    unsigned int count;
+    struct bundle_package *packages;
+    BYTE *xml;
+    SIZE_T xml_size;
+};
+
+static inline struct bundle_manifest *impl_from_IAppxBundleManifestReader( IAppxBundleManifestReader *iface )
+{
+    return CONTAINING_RECORD( iface, struct bundle_manifest, IAppxBundleManifestReader_iface );
+}
+
+static HRESULT WINAPI bundle_manifest_QueryInterface( IAppxBundleManifestReader *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxBundleManifestReader ))
+    {
+        *out = iface;
+        IUnknown_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI bundle_manifest_AddRef( IAppxBundleManifestReader *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxBundleManifestReader( iface )->ref );
+}
+
+static void bundle_manifest_free( struct bundle_manifest *m )
+{
+    unsigned int i;
+    for (i = 0; i < m->count; i++) { free( m->packages[i].file_name ); free( m->packages[i].resource_id ); }
+    free( m->packages );
+    free( m->identity.name );
+    free( m->identity.publisher );
+    free( m->identity.resource_id );
+    free( m->xml );
+    free( m );
+}
+
+static ULONG WINAPI bundle_manifest_Release( IAppxBundleManifestReader *iface )
+{
+    struct bundle_manifest *m = impl_from_IAppxBundleManifestReader( iface );
+    ULONG ref = InterlockedDecrement( &m->ref );
+    if (!ref) bundle_manifest_free( m );
+    return ref;
+}
+
+static HRESULT WINAPI bundle_manifest_GetPackageId( IAppxBundleManifestReader *iface, IAppxManifestPackageId **id )
+{
+    if (!id) return E_POINTER;
+    return package_id_create( &impl_from_IAppxBundleManifestReader( iface )->identity, id );
+}
