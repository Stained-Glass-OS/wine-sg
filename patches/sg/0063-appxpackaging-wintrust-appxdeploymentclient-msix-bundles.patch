+struct bundle
+{
+    IAppxBundleReader IAppxBundleReader_iface;
+    LONG ref;
+    struct package *pkg;              /* the archive, block map and content types */
+    struct bundle_manifest *manifest;
+};
+
+static inline struct bundle *impl_from_IAppxBundleReader( IAppxBundleReader *iface )
+{
+    return CONTAINING_RECORD( iface, struct bundle, IAppxBundleReader_iface );
+}
+
+static HRESULT WINAPI bundle_QueryInterface( IAppxBundleReader *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxBundleReader ))
+    {
+        *out = iface;
+        IUnknown_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI bundle_AddRef( IAppxBundleReader *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxBundleReader( iface )->ref );
+}
+
+static ULONG WINAPI bundle_Release( IAppxBundleReader *iface )
+{
+    struct bundle *impl = impl_from_IAppxBundleReader( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        IAppxBundleManifestReader_Release( &impl->manifest->IAppxBundleManifestReader_iface );
+        IAppxPackageReader_Release( &impl->pkg->IAppxPackageReader_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI bundle_GetFootprintFile( IAppxBundleReader *iface, APPX_BUNDLE_FOOTPRINT_FILE_TYPE type, IAppxFile **file )
+{
+    static const WCHAR *names[] = { L"AppxMetadata\\AppxBundleManifest.xml", L"AppxBlockMap.xml", L"AppxSignature.p7x" };
+    struct bundle *impl = impl_from_IAppxBundleReader( iface );
+    const struct zip_entry *e;
+
+    if (!file) return E_POINTER;
+    *file = NULL;
+    if ((unsigned int)type >= ARRAY_SIZE(names)) return E_INVALIDARG;
+    if (!(e = zip_find( impl->pkg->zip, names[type] ))) return APPX_E_MISSING_REQUIRED_FILE;
+    return file_create( impl->pkg, e, file );
+}
