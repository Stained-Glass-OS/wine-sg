+static HRESULT WINAPI bundle_manifest_GetStream( IAppxBundleManifestReader *iface, IStream **stream )
+{
+    struct bundle_manifest *m = impl_from_IAppxBundleManifestReader( iface );
+    HGLOBAL mem;
+    HRESULT hr;
+
+    if (!stream) return E_POINTER;
+    if (!(mem = GlobalAlloc( GMEM_MOVEABLE, m->xml_size ? m->xml_size : 1 ))) return E_OUTOFMEMORY;
