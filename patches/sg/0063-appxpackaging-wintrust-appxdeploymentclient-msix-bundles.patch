+/* ---- bundles -------------------------------------------------------------------- */
+
+/* Which architecture a bundle's application package must have, best first. */
+static int architecture_rank( APPX_PACKAGE_ARCHITECTURE arch )
+{
+    SYSTEM_INFO info;
+
+    GetNativeSystemInfo( &info );
+    if (info.wProcessorArchitecture == PROCESSOR_ARCHITECTURE_AMD64)
+    {
+        switch (arch)
+        {
+        case APPX_PACKAGE_ARCHITECTURE_X64: return 3;
+        case APPX_PACKAGE_ARCHITECTURE_NEUTRAL: return 2;
+        case APPX_PACKAGE_ARCHITECTURE_X86: return 1;
+        default: return 0;
+        }
+    }
+    if (info.wProcessorArchitecture == PROCESSOR_ARCHITECTURE_ARM64)
+    {
+        switch (arch)
+        {
+        case APPX_PACKAGE_ARCHITECTURE_ARM64: return 4;
+        case APPX_PACKAGE_ARCHITECTURE_NEUTRAL: return 3;
+        case APPX_PACKAGE_ARCHITECTURE_X64: return 2;
+        case APPX_PACKAGE_ARCHITECTURE_X86: return 1;
+        default: return 0;
+        }
+    }
+    return arch == APPX_PACKAGE_ARCHITECTURE_X86 ? 2 : arch == APPX_PACKAGE_ARCHITECTURE_NEUTRAL ? 1 : 0;
+}
+
+/* A bundle's application package for this machine, as a stream. The bundle's
+ * signature (already verified) covers it: its block map lists every package
+ * in the bundle, and reading it checks it against that. Resource packages
+ * (languages, scales) are not installed yet. */
+static HRESULT open_bundle_payload( IStream *stream, IStream **payload, WCHAR **error_text )
+{
+    IAppxBundleManifestPackageInfoEnumerator *items = NULL;
+    IAppxBundleManifestPackageInfo *info;
+    IAppxBundleManifestReader *manifest = NULL;
+    IAppxBundleFactory *factory = NULL;
+    IAppxBundleReader *bundle = NULL;
+    IAppxFile *file = NULL;
+    WCHAR *best = NULL;
+    int best_rank = 0;
+    BOOL has_current;
+    HRESULT hr;
+
+    if (FAILED(hr = CoCreateInstance( &CLSID_AppxBundleFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IAppxBundleFactory,
+                                      (void **)&factory ))) goto done;
+    if (FAILED(hr = IAppxBundleFactory_CreateBundleReader( factory, stream, &bundle )))
+    {
+        set_error( error_text, L"The bundle could not be read", NULL );
+        goto done;
+    }
+    if (FAILED(hr = IAppxBundleReader_GetManifest( bundle, &manifest )) ||
+        FAILED(hr = IAppxBundleManifestReader_GetPackageInfoItems( manifest, &items ))) goto done;
+    while (SUCCEEDED(IAppxBundleManifestPackageInfoEnumerator_GetHasCurrent( items, &has_current )) && has_current)
+    {
+        APPX_BUNDLE_PAYLOAD_PACKAGE_TYPE type;
+        IAppxManifestPackageId *id;
+        APPX_PACKAGE_ARCHITECTURE arch;
+        WCHAR *name;
+        int rank;
+
+        if (FAILED(IAppxBundleManifestPackageInfoEnumerator_GetCurrent( items, &info ))) break;
+        if (SUCCEEDED(IAppxBundleManifestPackageInfo_GetPackageType( info, &type )) &&
+            type == APPX_BUNDLE_PAYLOAD_PACKAGE_TYPE_APPLICATION &&
+            SUCCEEDED(IAppxBundleManifestPackageInfo_GetPackageId( info, &id )))
+        {
+            if (SUCCEEDED(IAppxManifestPackageId_GetArchitecture( id, &arch )) &&
+                (rank = architecture_rank( arch )) > best_rank &&
+                SUCCEEDED(IAppxBundleManifestPackageInfo_GetFileName( info, &name )))
+            {
+                CoTaskMemFree( best );
+                best = name;
+                best_rank = rank;
+            }
+            IAppxManifestPackageId_Release( id );
+        }
+        IAppxBundleManifestPackageInfo_Release( info );
+        IAppxBundleManifestPackageInfoEnumerator_MoveNext( items, &has_current );
+    }
+    if (!best)
+    {
+        set_error( error_text, L"The bundle has no package for this machine's architecture", NULL );
+        hr = 0x80073cf3; /* ERROR_INSTALL_RESOLVE_DEPENDENCY_FAILED */
+        goto done;
+    }
+    TRACE( "installing %s from the bundle\n", debugstr_w( best ) );
+    if (SUCCEEDED(hr = IAppxBundleReader_GetPayloadPackage( bundle, best, &file )))
+        hr = IAppxFile_GetStream( file, payload );
+
+done:
+    CoTaskMemFree( best );
+    if (file) IAppxFile_Release( file );
+    if (items) IAppxBundleManifestPackageInfoEnumerator_Release( items );
+    if (manifest) IAppxBundleManifestReader_Release( manifest );
+    if (bundle) IAppxBundleReader_Release( bundle );
+    if (factory) IAppxBundleFactory_Release( factory );
+    return hr;
+}
