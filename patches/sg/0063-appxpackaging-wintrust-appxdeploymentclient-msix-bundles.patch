+/* <Bundle><Identity Name Publisher Version/><Packages><Package Type Version
+ * Architecture ResourceId FileName Offset Size/>...</Packages></Bundle> */
+static HRESULT parse_bundle_manifest( const BYTE *data, SIZE_T size, struct bundle_manifest **out )
+{
+    struct bundle_manifest *m;
+    IXmlReader *reader;
+    IStream *stream;
+    XmlNodeType type;
+    const WCHAR *name, *value;
+    BOOL have_identity = FALSE;
+    UINT depth;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!(m = calloc( 1, sizeof(*m) ))) return E_OUTOFMEMORY;
+    m->IAppxBundleManifestReader_iface.lpVtbl = &bundle_manifest_vtbl;
+    m->ref = 1;
+    m->identity.architecture = APPX_PACKAGE_ARCHITECTURE_NEUTRAL;
+    if (!(m->identity.resource_id = strdupW( L"~" )) || !(m->xml = malloc( size ? size : 1 )))
+    {
+        bundle_manifest_free( m );
+        return E_OUTOFMEMORY;
+    }
+    memcpy( m->xml, data, size );
+    m->xml_size = size;
+
+    if (FAILED(hr = xml_reader_on( data, size, &reader, &stream )))
+    {
+        bundle_manifest_free( m );
+        return hr;
+    }
+    while ((hr = IXmlReader_Read( reader, &type )) == S_OK)
+    {
+        if (type != XmlNodeType_Element) continue;
+        IXmlReader_GetLocalName( reader, &name, NULL );
+        IXmlReader_GetDepth( reader, &depth );
+
+        if (depth == 1 && !wcscmp( name, L"Identity" ))
+        {
+            if (get_attr( reader, L"Name", &value ) == S_OK) m->identity.name = strdupW( value );
+            if (get_attr( reader, L"Publisher", &value ) == S_OK) m->identity.publisher = strdupW( value );
+            if (get_attr( reader, L"Version", &value ) != S_OK ||
+                FAILED(identity_parse_version( value, &m->identity.version ))) break;
+            have_identity = TRUE;
+        }
+        else if (depth == 2 && !wcscmp( name, L"Package" ))
+        {
+            struct bundle_package *p, *grown;
+
+            if (!(grown = realloc( m->packages, (m->count + 1) * sizeof(*grown) ))) { hr = E_OUTOFMEMORY; break; }
+            m->packages = grown;
+            p = &m->packages[m->count];
+            memset( p, 0, sizeof(*p) );
+            p->architecture = APPX_PACKAGE_ARCHITECTURE_NEUTRAL;
+            p->type = (get_attr( reader, L"Type", &value ) == S_OK && !wcsicmp( value, L"resource" ))
+                      ? APPX_BUNDLE_PAYLOAD_PACKAGE_TYPE_RESOURCE : APPX_BUNDLE_PAYLOAD_PACKAGE_TYPE_APPLICATION;
+            if (get_attr( reader, L"FileName", &value ) != S_OK || !(p->file_name = strdupW( value ))) break;
+            m->count++;
+            if (get_attr( reader, L"Version", &value ) != S_OK || FAILED(identity_parse_version( value, &p->version )))
+                break;
+            if (get_attr( reader, L"Architecture", &value ) == S_OK &&
