+/* Stained Glass OS (wine-sg 9971): a display's scale, as Windows' Settings
+ * reads and sets it -- DisplayConfigGetDeviceInfo / DisplayConfigSetDeviceInfo
+ * with the types Windows uses for it (-3 and -4; not in the SDK, used by
+ * display tools the same way): for a source, its scale relative to the
+ * recommended one in Windows' list of scales, and the range offered. The set
+ * comes here from user32's DisplayConfigSetDeviceInfo. */
+struct sg_dpi_scale_get
+{
+    DISPLAYCONFIG_DEVICE_INFO_HEADER header;
+    INT32 minScaleRel, curScaleRel, maxScaleRel;
+};
+struct sg_dpi_scale_set
+{
+    DISPLAYCONFIG_DEVICE_INFO_HEADER header;
+    INT32 scaleRel;
+};
+
+static NTSTATUS display_config_dpi_scale( DISPLAYCONFIG_DEVICE_INFO_HEADER *packet )
+{
+    struct monitor *monitor, *target = NULL;
+    BOOL set = (int)packet->type == SG_DISPLAYCONFIG_SET_DPI_SCALE;
+    UINT legacy, width, height;
+    int index, recommended, top;
+
+    if (packet->size < (set ? sizeof(struct sg_dpi_scale_set) : sizeof(struct sg_dpi_scale_get)))
+        return STATUS_INVALID_PARAMETER;
+    if (!lock_display_devices( FALSE )) return STATUS_UNSUCCESSFUL;
+    LIST_FOR_EACH_ENTRY( monitor, &monitors, struct monitor, entry )
+    {
+        if (!monitor->source || monitor->is_clone || packet->id != monitor->source->id) continue;
+        if (memcmp( &packet->adapterId, &monitor->source->gpu->luid, sizeof(monitor->source->gpu->luid) )) continue;
+        target = monitor;
+        break;
+    }
+    if (!target)
+    {
+        unlock_display_devices();
+        return STATUS_INVALID_PARAMETER;
+    }
+    legacy = legacy_scale_dpi();
+    if (getenv( "SG_LOGPIXELS" ) && set)
+    {
+        unlock_display_devices();
+        return STATUS_ACCESS_DENIED;   /* the login screen's scale is the machine's */
+    }
+    index = monitor_scale_index( target, legacy, &recommended );
+    monitor_scale_size( target, &width, &height );
+    top = max_scale_index( width, height, recommended );
+    if (!set)
+    {
+        struct sg_dpi_scale_get *get = (struct sg_dpi_scale_get *)packet;
+        get->minScaleRel = -recommended;
+        get->curScaleRel = index - recommended;
+        get->maxScaleRel = top - recommended;
+        unlock_display_devices();
+        return STATUS_SUCCESS;
+    }
+    else
+    {
+        struct sg_dpi_scale_set *req = (struct sg_dpi_scale_set *)packet;
+        int want = recommended + req->scaleRel;
+
+        if (want < 0 || want > top)
+        {
+            unlock_display_devices();
+            return STATUS_INVALID_PARAMETER;
+        }
+        /* the first scale of the user's own for a monitor: the others keep the
+         * scale they have now (one picked for all monitors before) */
+        if (legacy)
+        {
+            LIST_FOR_EACH_ENTRY( monitor, &monitors, struct monitor, entry )
+            {
+                int rec;
+                if (monitor == target || !monitor->source || monitor->is_clone) continue;
+                set_monitor_scale_steps( monitor, monitor_scale_index( monitor, legacy, &rec ) - rec );
+            }
+        }
+        set_monitor_scale_steps( target, req->scaleRel );
+        unlock_display_devices();
+        /* the windows on it at its new scale, as on Windows at once */
+        sync_monitor_dpi();
+        {
+            static const WCHAR metricsW[] = {'W','i','n','d','o','w','M','e','t','r','i','c','s',0};
+            send_message_timeout( HWND_BROADCAST, WM_SETTINGCHANGE, 0, (LPARAM)metricsW,
+                                  SMTO_ABORTIFHUNG, 2000, FALSE );
+        }
+        return STATUS_SUCCESS;
+    }
+}
