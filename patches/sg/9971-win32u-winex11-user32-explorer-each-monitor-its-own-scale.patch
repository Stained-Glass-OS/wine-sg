 static UINT read_logpixels(void);
 
+/* Stained Glass OS (wine-sg 9971): each monitor has its own scale, as on
+ * Windows, kept for that monitor (HKCU\Control Panel\Desktop\PerMonitorSettings
+ * \<monitor>\DpiValue: steps up or down from the recommended scale, in
+ * Windows' list of scales). The monitor is named by its EDID -- maker,
+ * model, serial number, week and year -- so it keeps its scale on any port
+ * and whatever else is plugged in; one without a serial number, or two alike,
+ * are told apart by their ports too. The recommended scale is the session's rule
+ * (sg-session sg_scale_for, sg-shell scale_for_screen): the shorter side
+ * over 1080 lines, to the nearest 25%, 100% to 400%. Without settings of
+ * the user's own for any monitor, a scale the user picked before per-monitor
+ * scales existed (a LogPixels other than the one the automatic scale wrote,
+ * or ScaleChosen) is every monitor's, as it was; SG_LOGPIXELS (the login screen, Setup) is
+ * every monitor's. Before, LogPixels was every monitor's scale: the
+ * automatic scale followed the main display, and unplugging a 1440p main
+ * display turned every window from 125% to 100% and back. */
+static const UINT monitor_scales[] = {100, 125, 150, 175, 200, 225, 250, 300, 350, 400, 450, 500};
+static const WCHAR dpiValueW[] = {'D','p','i','V','a','l','u','e',0};
+
+static UINT scale_index( UINT percent )
+{
+    UINT i;
+    for (i = 0; i < ARRAY_SIZE(monitor_scales) - 1; i++)
+        if (percent < (monitor_scales[i] + monitor_scales[i + 1]) / 2) return i;
+    return ARRAY_SIZE(monitor_scales) - 1;
+}
+
+UINT recommended_scale_for_size( UINT width, UINT height )
+{
+    UINT side = min( width, height ), q;
+    if (!side) return 100;
+    q = (side * 4 + 540) / 1080;
+    return min( max( q, 4 ), 16 ) * 25;
+}
+
+/* the monitor's name among PerMonitorSettings: BUF of SIZE */
+static void monitor_scale_key( const struct monitor *monitor, char *buf, size_t size )
+{
+    const struct edid_monitor_info *info = &monitor->edid_info;
+    const char *port = monitor->port[0] ? monitor->port : "0";
+    const struct monitor *other;
+    BOOL twin = FALSE;
+
+    if (!(info->flags & MONITOR_INFO_HAS_MONITOR_ID))
+    {
+        snprintf( buf, size, "NOEDID_%s", port );
+        return;
+    }
+    snprintf( buf, size, "%s%08X_%02X_%04X", info->monitor_id_string, info->serial, info->week, 1990 + info->year );
+    LIST_FOR_EACH_ENTRY( other, &monitors, struct monitor, entry )
+    {
+        if (other == monitor || other->is_clone || !(other->edid_info.flags & MONITOR_INFO_HAS_MONITOR_ID)) continue;
+        if (!strcmp( other->edid_info.monitor_id_string, info->monitor_id_string ) &&
+            other->edid_info.serial == info->serial && other->edid_info.week == info->week &&
+            other->edid_info.year == info->year) twin = TRUE;
+    }
+#ifndef SG_MUTANT_SCALE_TWINS_ONE_KEY
+    /* (and one with no serial number: whether a monitor alike is plugged in too
+     * must not change its name -- unplugging one of two kept the other's scale
+     * from it) */
+    if (twin || !info->serial) snprintf( buf + strlen( buf ), size - strlen( buf ), "^%s", port );
+#endif
+}
+
+static BOOL read_hkcu_dword( const char *key, const char *name, DWORD *ret )
+{
+    char buffer[offsetof(KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(DWORD)])];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    BOOL found = FALSE;
+    HKEY hkey;
+
+    if (!(hkey = reg_open_hkcu_key( key ))) return FALSE;
+    if (query_reg_ascii_value( hkey, name, value, sizeof(buffer) ) && value->Type == REG_DWORD)
+    {
+        *ret = *(const DWORD *)value->Data;
+        found = TRUE;
+    }
+    NtClose( hkey );
+    return found;
+}
+
+/* whether the user has a scale of their own for any monitor */
+static BOOL have_monitor_scales(void)
+{
+    char buffer[offsetof(KEY_BASIC_INFORMATION, Name[MAX_PATH])];
+    KEY_BASIC_INFORMATION *info = (void *)buffer;
+    DWORD size;
+    BOOL ret;
+    HKEY hkey;
+
+    if (!(hkey = reg_open_hkcu_key( "Control Panel\\Desktop\\PerMonitorSettings" ))) return FALSE;
+    ret = !NtEnumerateKey( hkey, 0, KeyBasicInformation, info, sizeof(buffer), &size );
+    NtClose( hkey );
+    return ret;
+}
+
+/* the scale the user picked for all monitors before they had their own, or 0 */
+static UINT legacy_scale_dpi(void)
+{
+    DWORD logpixels = 0, chosen = 0, autodpi = 0;
+    const char *env = getenv( "SG_LOGPIXELS" );
+
+    if (env && strtoul( env, NULL, 10 )) return read_logpixels();
+    if (have_monitor_scales()) return 0;
+    if (!read_hkcu_dword( "Control Panel\\Desktop", "LogPixels", &logpixels ) || !logpixels) return 0;
+    read_hkcu_dword( "Software\\Stained Glass\\Display", "ScaleChosen", &chosen );
+    read_hkcu_dword( "Software\\Stained Glass\\Display", "AutoLogPixels", &autodpi );
+    /* (LogPixels the automatic scale wrote follows each monitor's recommended one; any
+     * other -- picked, or written without the automatic scale -- is the user's) */
+    if (chosen || logpixels != autodpi) return read_logpixels();
+    return 0;
+}
+
+/* the monitor's size in pixels, which its recommended scale goes by */
+static void monitor_scale_size( const struct monitor *monitor, UINT *width, UINT *height )
+{
+    DEVMODEW mode = {.dmSize = sizeof(DEVMODEW)};
+    struct source *source = monitor->source;
+
+    *width = *height = 0;
+    if (!source) return;
+    *width = source->physical.dmPelsWidth;
+    *height = source->physical.dmPelsHeight;
+    if ((!*width || !*height) && source_get_current_settings( source, &mode ))
+    {
+        *width = mode.dmPelsWidth;
+        *height = mode.dmPelsHeight;
+    }
+}
+
+/* the largest scale offered for a WxH monitor: as Windows, none that leaves
+ * less than 1024x720 */
+static int max_scale_index( UINT width, UINT height, int recommended )
+{
+    int i;
+    for (i = ARRAY_SIZE(monitor_scales) - 1; i > 0; i--)
+        if (width * 100 / monitor_scales[i] >= 1024 && height * 100 / monitor_scales[i] >= 720) break;
+    return max( i, recommended );
+}
+
+/* the monitor's scale (an index into monitor_scales) and its recommended one;
+ * LEGACY from legacy_scale_dpi */
+static int monitor_scale_index( const struct monitor *monitor, UINT legacy, int *recommended )
+{
+    char key[MAX_PATH], name[96];
+    UINT width, height;
+    DWORD steps;
+    int index;
+
+    monitor_scale_size( monitor, &width, &height );
+    *recommended = scale_index( recommended_scale_for_size( width, height ) );
+    if (legacy) return scale_index( muldiv( legacy, 100, USER_DEFAULT_SCREEN_DPI ) );
+    index = *recommended;
+    monitor_scale_key( monitor, name, sizeof(name) );
+    snprintf( key, sizeof(key), "Control Panel\\Desktop\\PerMonitorSettings\\%s", name );
+    if (read_hkcu_dword( key, "DpiValue", &steps )) index += (int)steps;
+    index = min( max( index, 0 ), (int)ARRAY_SIZE(monitor_scales) - 1 );
+    TRACE( "monitor %s: %u%%\n", name, monitor_scales[index] );
+    return index;
+}
+
+static UINT monitor_scale_dpi( const struct monitor *monitor, UINT legacy )
+{
+    int recommended;
+
+#ifdef SG_MUTANT_SCALE_LOGPIXELS_ONLY
+    return read_logpixels();
+#endif
+    if (legacy) return legacy;
+    return muldiv( monitor_scales[monitor_scale_index( monitor, 0, &recommended )], USER_DEFAULT_SCREEN_DPI, 100 );
+}
+
+/* the user's own scale for MONITOR: STEPS from its recommended one */
+static BOOL set_monitor_scale_steps( const struct monitor *monitor, int steps )
+{
+    char key[MAX_PATH], name[96];
+    DWORD value = steps;
+    HKEY hkey;
+
+    monitor_scale_key( monitor, name, sizeof(name) );
+    snprintf( key, sizeof(key), "Control Panel\\Desktop\\PerMonitorSettings\\%s", name );
+    if (!(hkey = reg_create_ascii_key( hkcu_key, key, 0, NULL ))) return FALSE;
+    set_reg_value( hkey, dpiValueW, REG_DWORD, &value, sizeof(value) );
+    NtClose( hkey );
+    TRACE( "monitor %s: %d steps from the recommended scale\n", name, steps );
+    return TRUE;
+}
+
+/* each monitor's source at the monitor's own scale (display_lock held);
+ * WRITE: into its registry record too. TRUE when one changed */
+static BOOL apply_monitor_scales( BOOL write )
+{
+    static const WCHAR dpi_nameW[] = {'D','p','i',0};
+    UINT legacy = legacy_scale_dpi(), dpi;
+    struct monitor *monitor;
+    BOOL changed = FALSE;
+    HKEY hkey;
+
+    LIST_FOR_EACH_ENTRY( monitor, &monitors, struct monitor, entry )
+    {
+        struct source *source = monitor->source;
+
+        if (!source || monitor->is_clone || !source->dpi) continue;
+        dpi = monitor_scale_dpi( monitor, legacy );
+        if (dpi == source->dpi) continue;
+        TRACE( "source %s dpi %u -> %u\n", debugstr_a(source->path), source->dpi, dpi );
+        source->dpi = dpi;
+        changed = TRUE;
+        if (!write) continue;
+        /* the enumerating process has its record open; the others find it */
+        if (source->key) set_reg_value( source->key, dpi_nameW, REG_DWORD, &source->dpi, sizeof(source->dpi) );
+        else if ((hkey = reg_open_ascii_key( config_key, source->path )))
+        {
+            set_reg_value( hkey, dpi_nameW, REG_DWORD, &source->dpi, sizeof(source->dpi) );
+            NtClose( hkey );
+        }
+    }
+    return changed;
+}
