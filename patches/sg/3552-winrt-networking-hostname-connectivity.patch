+static void test_HostName_properties( IHostNameFactory *factory, IHostName *ipname )
+{
+    static const struct { const WCHAR *raw, *canonical; HostNameType type; } tests[] =
+    {
+        { L"WineHQ.ORG", L"winehq.org", HostNameType_DomainName },
+        { L"192.168.0.0", L"192.168.0.0", HostNameType_Ipv4 },
+        { L"0:0:0:0:0:0:0:1", L"::1", HostNameType_Ipv6 },
+        { L"300.1.1.1", L"300.1.1.1", HostNameType_DomainName },
+    };
+    IIPInformation *info = (IIPInformation *)0xdeadbeef;
+    HSTRING_HEADER header;
+    HSTRING str, name;
+    IHostName *other;
+    HostNameType type;
+    boolean equal;
+    INT32 cmp;
+    HRESULT hr;
+    int i;
+
+    hr = IHostName_get_Type( ipname, NULL );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = IHostName_get_IPInformation( ipname, &info );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !info, "got info %p.\n", info );
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        hr = WindowsCreateStringReference( tests[i].raw, wcslen( tests[i].raw ), &header, &str );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = IHostNameFactory_CreateHostName( factory, str, &other );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+        hr = IHostName_get_Type( other, &type );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( type == tests[i].type, "%d: got type %d.\n", i, type );
+
+        hr = IHostName_get_DisplayName( other, &name );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = WindowsCompareStringOrdinal( str, name, &cmp );
+        ok( hr == S_OK && !cmp, "%d: got display name %s.\n", i, debugstr_hstring( name ) );
+        WindowsDeleteString( name );
+
+        hr = IHostName_get_CanonicalName( other, &name );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( !wcscmp( WindowsGetStringRawBuffer( name, NULL ), tests[i].canonical ), "%d: got canonical %s.\n",
+            i, debugstr_hstring( name ) );
+        WindowsDeleteString( name );
+
+        hr = IHostName_IsEqual( other, other, &equal );
+        ok( hr == S_OK && equal, "got hr %#lx, equal %d.\n", hr, equal );
+        IHostName_Release( other );
+    }
+
+    hr = IHostName_IsEqual( ipname, NULL, &equal );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+}
