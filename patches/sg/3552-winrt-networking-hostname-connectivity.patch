+    return WindowsDuplicateString( impl->raw_name, value );
 }
 
 static HRESULT WINAPI hostname_get_CanonicalName( IHostName *iface, HSTRING *value )
 {
-    FIXME( "iface %p, value %p stub!\n", iface, value );
-    return E_NOTIMPL;
+    struct hostname *impl = impl_from_IHostName( iface );
+    const WCHAR *raw = WindowsGetStringRawBuffer( impl->raw_name, NULL );
+    WCHAR canonical[256];
+    UINT32 len = 0;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_INVALIDARG;
+    if (raw) len = wcslen( raw );
+    if (len >= ARRAY_SIZE(canonical)) return WindowsDuplicateString( impl->raw_name, value );
+    if (!raw) return WindowsDuplicateString( impl->raw_name, value );
+    hostname_classify( raw, canonical, ARRAY_SIZE(canonical) );
+    return WindowsCreateString( canonical, wcslen( canonical ), value );
 }
 
 static HRESULT WINAPI hostname_get_Type( IHostName *iface, HostNameType *value )
 {
-    FIXME( "iface %p, value %p stub!\n", iface, value );
-    return E_NOTIMPL;
+    struct hostname *impl = impl_from_IHostName( iface );
+    const WCHAR *raw = WindowsGetStringRawBuffer( impl->raw_name, NULL );
+    WCHAR canonical[256];
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_INVALIDARG;
+    if (!raw || wcslen( raw ) >= ARRAY_SIZE(canonical)) *value = HostNameType_DomainName;
+    else *value = hostname_classify( raw, canonical, ARRAY_SIZE(canonical) );
+    return S_OK;
 }
 
 static HRESULT WINAPI hostname_IsEqual( IHostName *iface, IHostName *name, boolean *equal )
 {
-    FIXME( "iface %p, name %p, equal %p stub!\n", iface, name, equal );
-    return E_NOTIMPL;
+    HSTRING a = NULL, b = NULL;
+    INT32 cmp;
+    HRESULT hr;
+
+    TRACE( "iface %p, name %p, equal %p.\n", iface, name, equal );
+
+    if (!equal) return E_INVALIDARG;
+    if (!name) return E_INVALIDARG;
+    if (SUCCEEDED(hr = IHostName_get_CanonicalName( iface, &a )) &&
+        SUCCEEDED(hr = IHostName_get_CanonicalName( name, &b )) &&
+        SUCCEEDED(hr = WindowsCompareStringOrdinal( a, b, &cmp )))
+        *equal = !cmp;
+    WindowsDeleteString( a );
+    WindowsDeleteString( b );
+    return hr;
 }
 
