+/* the name of the first connected network */
 static HRESULT WINAPI connection_profile_get_ProfileName( IConnectionProfile *iface, HSTRING *value )
 {
-    FIXME( "iface %p, value %p stub!\n", iface, value );
-    return E_NOTIMPL;
+    struct connection_profile *impl = impl_from_IConnectionProfile( iface );
+    IEnumNetworks *networks;
+    INetwork *network;
+    ULONG fetched = 0;
+    BSTR name;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = INetworkListManager_GetNetworks( impl->network_list_manager, NLM_ENUM_NETWORK_CONNECTED, &networks )))
+        return hr;
+    hr = IEnumNetworks_Next( networks, 1, &network, &fetched );
+    IEnumNetworks_Release( networks );
+    if (hr != S_OK || !fetched) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+
+    hr = INetwork_GetName( network, &name );
+    INetwork_Release( network );
+    if (FAILED(hr)) return hr;
+    hr = WindowsCreateString( name, SysStringLen( name ), value );
+    SysFreeString( name );
+    return hr;
 }
 
