+/* the type of a name and its canonical text (lowercase; addresses in their normal form) */
+static HostNameType hostname_classify( const WCHAR *raw, WCHAR *canonical, SIZE_T size )
+{
+    IN_ADDR a4;
+    IN6_ADDR a6;
+    const WCHAR *end;
+    SIZE_T i;
+
+    if (raw[0] && !RtlIpv4StringToAddressW( raw, TRUE, &end, &a4 ) && !*end)
+    {
+        RtlIpv4AddressToStringW( &a4, canonical );
+        return HostNameType_Ipv4;
+    }
+    if (wcschr( raw, ':' ) && !RtlIpv6StringToAddressW( raw, &end, &a6 ) && !*end)
+    {
+        RtlIpv6AddressToStringW( &a6, canonical );
+        return HostNameType_Ipv6;
+    }
+    for (i = 0; raw[i] && i + 1 < size; i++) canonical[i] = towlower( raw[i] );
+    canonical[i] = 0;
+    return HostNameType_DomainName;
 }
 
