+    if(FAILED(IHTMLDocument2_get_parentWindow(dlg->doc, &window)) || !window)
+        return;
+
+    hres = IHTMLWindow2_QueryInterface(window, &IID_IDispatchEx, (void**)&dispex);
+    IHTMLWindow2_Release(window);
+    if(FAILED(hres))
+        return;
+
+    name = SysAllocString(L"returnValue");
+    hres = IDispatchEx_GetDispID(dispex, name, fdexNameCaseSensitive, &id);
+    SysFreeString(name);
+    if(SUCCEEDED(hres)) {
+        V_VT(&v) = VT_EMPTY;
+        hres = IDispatchEx_InvokeEx(dispex, id, LOCALE_USER_DEFAULT, DISPATCH_PROPERTYGET, &dp, &v, NULL, NULL);
+        if(SUCCEEDED(hres)) {
+            VariantClear(&dlg->result);
+            dlg->result = v;
+        }
+    }
+    IDispatchEx_Release(dispex);
+}
+
+static void dialog_update_title(struct html_dialog *dlg)
+{
+    BSTR title;
+
+    if(!dlg->doc || FAILED(IHTMLDocument2_get_title(dlg->doc, &title)) || !title)
+        return;
+    if(*title)
+        SetWindowTextW(dlg->hwnd, title);
+    SysFreeString(title);
+}
+
+static void dialog_close_ui(struct html_dialog *dlg)
+{
+    if(dlg->done)
+        return;
+    dialog_read_result(dlg);
+    dlg->done = TRUE;
+    if(dlg->hta)
+        PostQuitMessage(0);
+    if(dlg->modal) {
+        if(dlg->parent)
+            EnableWindow(dlg->parent, TRUE);
+        ShowWindow(dlg->hwnd, SW_HIDE);
+    }else
+        DestroyWindow(dlg->hwnd);
+}
+
+static LRESULT CALLBACK dialog_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct html_dialog *dlg = (struct html_dialog*)GetWindowLongPtrW(hwnd, 0);
+
+    switch(msg) {
+    case WM_NCCREATE:
+        SetWindowLongPtrW(hwnd, 0, (LONG_PTR)((CREATESTRUCTW*)lparam)->lpCreateParams);
+        break;
+    case WM_SIZE:
+        if(dlg && dlg->inplace) {
+            RECT rect;
+            GetClientRect(hwnd, &rect);
+            IOleInPlaceObject_SetObjectRects(dlg->inplace, &rect, &rect);
+        }
+        return 0;
+    case WM_TIMER:
+        if(dlg && wparam == TIMER_TITLE)
+            dialog_update_title(dlg);
+        return 0;
+    case WM_CLOSE:
+        if(dlg) {
+            dialog_close_ui(dlg);
+            return 0;
+        }
+        break;
+    case WM_DESTROY:
+        if(dlg) {
+            KillTimer(hwnd, TIMER_TITLE);
+            dlg->done = TRUE;
+            if(dlg->inplace) {
+                IOleInPlaceObject_InPlaceDeactivate(dlg->inplace);
+                IOleInPlaceObject_Release(dlg->inplace);
+                dlg->inplace = NULL;
+            }
+            if(dlg->ole) {
+                IOleObject_Close(dlg->ole, OLECLOSE_NOSAVE);
+                IOleObject_SetClientSite(dlg->ole, NULL);
+                IOleObject_Release(dlg->ole);
+                dlg->ole = NULL;
+            }
+            if(dlg->doc_obj)
+                dlg->doc_obj->dialog = NULL;
+            dlg->doc_obj = NULL;
+            if(dlg->doc) {
+                IHTMLDocument2_Release(dlg->doc);
+                dlg->doc = NULL;
+            }
+            dlg->hwnd = NULL;
+            SetWindowLongPtrW(hwnd, 0, 0);
+            dialog_release(dlg);   /* the window's reference */
+        }
+        break;
+    }
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
+
+static INIT_ONCE class_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK register_class(INIT_ONCE *once, void *param, void **ctx)
+{
+    WNDCLASSW wc = {0};
+
+    wc.lpfnWndProc = dialog_proc;
+    wc.cbWndExtra = sizeof(void*);
+    wc.hInstance = hInst;
+    wc.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW);
+    wc.hbrBackground = (HBRUSH)(COLOR_BTNFACE + 1);
+    wc.lpszClassName = dialog_class_name;
+    RegisterClassW(&wc);
+    return TRUE;
+}
+
+/* ---- the options: "dialogWidth:300px; dialogHeight:200px; center:yes; resizable:no" ---- */
+
+struct dialog_options
+{
+    int width, height, left, top;
+    BOOL has_left, has_top, center, resizable, scroll, status, unadorned, help;
+};
+
+static BOOL parse_yes(const WCHAR *v)
+{
+    return !wcsicmp(v, L"yes") || !wcsicmp(v, L"1") || !wcsicmp(v, L"on") || !wcsicmp(v, L"true");
+}
+
+/* a length in CSS units, in pixels; fails without digits */
+static BOOL parse_length(const WCHAR *v, int *ret)
+{
+    WCHAR *end;
+    double n;
+
+    n = wcstod(v, &end);
+    if(end == v)
+        return FALSE;
+    while(*end == ' ') end++;
+    if(!*end || !wcsicmp(end, L"px"))
+        ;
+    else if(!wcsicmp(end, L"em"))
+        n *= 16;
+    else if(!wcsicmp(end, L"pt"))
+        n = n * 96 / 72;
+    else if(!wcsicmp(end, L"pc"))
+        n = n * 16;
+    else if(!wcsicmp(end, L"in"))
+        n *= 96;
+    else if(!wcsicmp(end, L"cm"))
+        n = n * 96 / 2.54;
+    else if(!wcsicmp(end, L"mm"))
+        n = n * 96 / 25.4;
+    else
+        return FALSE;
+    *ret = (int)n;
+    return TRUE;
+}
+
+static void parse_dialog_options(const WCHAR *str, struct dialog_options *opt)
+{
+    WCHAR *copy, *p, *next;
+
+    memset(opt, 0, sizeof(*opt));
+    opt->width = 480;
+    opt->height = 240;
+    opt->center = TRUE;
+    opt->scroll = TRUE;
+    opt->status = FALSE;
+
+    if(!str || !*str || !(copy = wcsdup(str)))
+        return;
+
+    for(p = copy; p && *p; p = next) {
+        WCHAR *colon, *name, *value;
+        int len;
+
+        next = wcschr(p, ';');
+        if(next) *next++ = 0;
+
+        colon = wcschr(p, ':');
+        if(!colon) colon = wcschr(p, '=');
+        if(!colon) continue;
+        *colon = 0;
+        name = p;
+        value = colon + 1;
+        while(*name == ' ') name++;
+        while(*value == ' ') value++;
+        for(len = lstrlenW(name); len && name[len - 1] == ' '; ) name[--len] = 0;
+        for(len = lstrlenW(value); len && value[len - 1] == ' '; ) value[--len] = 0;
+
+        if(!wcsicmp(name, L"dialogWidth") || !wcsicmp(name, L"width"))
+            parse_length(value, &opt->width);
+        else if(!wcsicmp(name, L"dialogHeight") || !wcsicmp(name, L"height"))
+            parse_length(value, &opt->height);
+        else if(!wcsicmp(name, L"dialogLeft") || !wcsicmp(name, L"left"))
+            opt->has_left = parse_length(value, &opt->left);
+        else if(!wcsicmp(name, L"dialogTop") || !wcsicmp(name, L"top"))
+            opt->has_top = parse_length(value, &opt->top);
+        else if(!wcsicmp(name, L"center"))
+            opt->center = parse_yes(value);
+        else if(!wcsicmp(name, L"resizable"))
+            opt->resizable = parse_yes(value);
+        else if(!wcsicmp(name, L"scroll"))
+            opt->scroll = parse_yes(value);
+        else if(!wcsicmp(name, L"status"))
+            opt->status = parse_yes(value);
+        else if(!wcsicmp(name, L"unadorned"))
+            opt->unadorned = parse_yes(value);
+        else if(!wcsicmp(name, L"help"))
+            opt->help = parse_yes(value);
+        /* edge, dialogHide, minimize, maximize, ...: no effect on a plain frame */
+    }
+    free(copy);
+}
+
+static struct html_dialog *alloc_dialog(void)
+{
+    struct html_dialog *dlg = calloc(1, sizeof(*dlg));
+
+    if(!dlg)
+        return NULL;
+    dlg->IOleClientSite_iface.lpVtbl = &dlg_site_vtbl;
+    dlg->IOleInPlaceSite_iface.lpVtbl = &dlg_ips_vtbl;
+    dlg->IOleInPlaceFrame_iface.lpVtbl = &dlg_frame_vtbl;
+    dlg->IDocHostUIHandler_iface.lpVtbl = &dlg_ui_vtbl;
+    dlg->ref = 1;
+    return dlg;
+}
+
+/* Creates the frame window and loads the document into it. */
+static HRESULT create_dialog(HWND parent, IMoniker *mk, VARIANT *args, const WCHAR *options, BOOL modal,
+        BOOL hta, struct html_dialog **ret)
+{
+    struct dialog_options opt;
+    struct html_dialog *dlg;
+    DWORD style, exstyle;
+    IPersistMoniker *persist;
+    IOleDocumentView *view;
+    RECT rect;
+    int x, y, w, h;
+    HRESULT hres;
+
+    InitOnceExecuteOnce(&class_once, register_class, NULL, NULL);
+
+    dlg = alloc_dialog();
+    if(!dlg)
+        return E_OUTOFMEMORY;
+    dlg->modal = modal;
+    dlg->hta = hta;
+    dlg->parent = parent;
+    if(args)
+        VariantCopy(&dlg->args, args);
+
+    parse_dialog_options(options, &opt);
+    if(hta) {
+        opt.width = 800;
+        opt.height = 600;
+        opt.resizable = TRUE;
+    }
+
+    dlg->ui_flags = DOCHOSTUIFLAG_DIALOG;
+    if(!opt.scroll)
+        dlg->ui_flags |= DOCHOSTUIFLAG_SCROLL_NO;
+    if(opt.unadorned)
+        dlg->ui_flags |= DOCHOSTUIFLAG_NO3DBORDER;
+
+    style = WS_POPUP | WS_CLIPCHILDREN | WS_CLIPSIBLINGS;
+    exstyle = hta ? 0 : WS_EX_DLGMODALFRAME;
+    if(!opt.unadorned)
+        style |= WS_CAPTION | WS_SYSMENU;
+    else
+        style |= WS_BORDER;
+    if(opt.resizable)
+        style |= WS_THICKFRAME | (hta ? WS_MINIMIZEBOX | WS_MAXIMIZEBOX : 0);
+
+    w = opt.width;
+    h = opt.height;
+    if((opt.center && !(opt.has_left && opt.has_top)) || (!opt.has_left && !opt.has_top)) {
+        RECT area;
+        HWND ref = parent ? parent : NULL;
+        if(ref && IsWindow(ref))
+            GetWindowRect(ref, &area);
+        else
+            SystemParametersInfoW(SPI_GETWORKAREA, 0, &area, 0);
+        x = area.left + (area.right - area.left - w) / 2;
+        y = area.top + (area.bottom - area.top - h) / 2;
+    }else {
+        x = opt.has_left ? opt.left : CW_USEDEFAULT;
+        y = opt.has_top ? opt.top : CW_USEDEFAULT;
+    }
+
+    dlg->hwnd = CreateWindowExW(exstyle, dialog_class_name, L"", style, x, y, w, h,
+                                parent && IsWindow(parent) ? parent : NULL, NULL, hInst, dlg);
+    if(!dlg->hwnd) {
+        dialog_release(dlg);
+        return E_FAIL;
+    }
+    /* the window holds a reference of its own, dropped when it is destroyed */
+    InterlockedIncrement(&dlg->ref);
+
+    hres = CoCreateInstance(&CLSID_HTMLDocument, NULL, CLSCTX_INPROC_SERVER, &IID_IHTMLDocument2, (void**)&dlg->doc);
+    if(FAILED(hres))
+        goto fail;
+    dlg->doc_obj = get_doc_obj_from_document2(dlg->doc);
+    if(!dlg->doc_obj) {
+        hres = E_NOINTERFACE;
+        goto fail;
+    }
+    dlg->doc_obj->dialog = dlg;
+
+    hres = IHTMLDocument2_QueryInterface(dlg->doc, &IID_IOleObject, (void**)&dlg->ole);
+    if(FAILED(hres))
+        goto fail;
+    hres = IOleObject_SetClientSite(dlg->ole, &dlg->IOleClientSite_iface);
+    if(FAILED(hres))
+        goto fail;
+
+    if(mk) {
+        hres = IHTMLDocument2_QueryInterface(dlg->doc, &IID_IPersistMoniker, (void**)&persist);
+        if(FAILED(hres))
+            goto fail;
+        hres = IPersistMoniker_Load(persist, FALSE, mk, NULL, STGM_READ);
+        IPersistMoniker_Release(persist);
+        if(FAILED(hres))
+            goto fail;
+    }
+
+    GetClientRect(dlg->hwnd, &rect);
+    hres = IOleObject_DoVerb(dlg->ole, OLEIVERB_INPLACEACTIVATE, NULL, &dlg->IOleClientSite_iface, 0, dlg->hwnd, &rect);
+    if(FAILED(hres))
+        goto fail;
+    IOleObject_QueryInterface(dlg->ole, &IID_IOleInPlaceObject, (void**)&dlg->inplace);
+    if(SUCCEEDED(IHTMLDocument2_QueryInterface(dlg->doc, &IID_IOleDocumentView, (void**)&view))) {
+        IOleDocumentView_UIActivate(view, TRUE);
+        IOleDocumentView_Release(view);
+    }
+    if(dlg->inplace)
+        IOleInPlaceObject_SetObjectRects(dlg->inplace, &rect, &rect);
+
+    SetTimer(dlg->hwnd, TIMER_TITLE, 200, NULL);
+    ShowWindow(dlg->hwnd, SW_SHOW);
+    UpdateWindow(dlg->hwnd);
+    SetForegroundWindow(dlg->hwnd);
+
+    *ret = dlg;
+    return S_OK;
+
+fail:
+    if(dlg->hwnd)
+        DestroyWindow(dlg->hwnd);
+    dialog_release(dlg);
+    return hres;
+}
+
+static void run_message_loop(struct html_dialog *dlg)
+{
+    thread_data_t *thread_data = get_thread_data(FALSE);
+    unsigned prev_locked = 0;
+    MSG msg;
+
+    /* When called by a page script (timer or event task), mshtml's tasks are locked until the script returns,
+     * but the dialog document's navigation needs them. Let them run in this nested loop (like sync XHR). */
+#ifndef SG_MUTANT_B4_SCRIPTDLG
+    if(thread_data && thread_data->tasks_locked) {
+        prev_locked = thread_data->tasks_locked;
+        thread_data->tasks_locked = 0;
+        unblock_tasks_and_timers(thread_data);
+    }
+#endif
+
+    while(!dlg->done) {
+        DWORD ret = MsgWaitForMultipleObjects(0, NULL, FALSE, INFINITE, QS_ALLINPUT);
+        if(ret == WAIT_FAILED)
+            break;
+        while(PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE)) {
+            if(msg.message == WM_QUIT) {
+                PostQuitMessage(msg.wParam);
+                dlg->done = TRUE;
+                break;
+            }
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+    }
+    if(thread_data && prev_locked)
+        thread_data->tasks_locked = prev_locked;
+}
+
+/***********************************************************************
+ * shows a dialog: modal until it is closed (the result goes to argout), or modeless
+ */
+HRESULT show_html_dialog(HWND parent, IMoniker *mk, DWORD flags, VARIANT *argin, const WCHAR *options,
+        VARIANT *argout, IHTMLWindow2 **modeless)
+{
+    struct html_dialog *dlg;
+    BOOL modal = !(flags & HTMLDLG_MODELESS);
+    HRESULT hres;
+
+    TRACE("(%p %p %lx %p %s %p)\n", parent, mk, flags, argin, debugstr_w(options), argout);
+
+    if(modeless)
+        *modeless = NULL;
+
+    hres = create_dialog(parent, mk, argin, options, modal, FALSE, &dlg);
+    if(FAILED(hres))
+        return hres;
+
+    if(!modal) {
+        if(modeless && dlg->doc)
+            IHTMLDocument2_get_parentWindow(dlg->doc, modeless);
+        dialog_release(dlg);
+        return S_OK;
+    }
+
+    if(parent && IsWindow(parent))
+        EnableWindow(parent, FALSE);
+    run_message_loop(dlg);
+    if(dlg->hwnd)
+        DestroyWindow(dlg->hwnd);
+
+    if(argout) {
+        VariantClear(argout);
+        VariantCopy(argout, &dlg->result);
+    }
+    dialog_release(dlg);
+    return S_OK;
+}
+
+/* window.close() of a document that is hosted by a dialog, or by a window of a container that is
+   not a WebBrowser: the window asks to be closed */
+HRESULT window_close_default(HTMLDocumentObj *doc)
+{
+    HWND hwnd;
+
+    if(doc->dialog) {
+        PostMessageW(doc->dialog->hwnd, WM_CLOSE, 0, 0);
+        return S_OK;
+    }
+
+    hwnd = doc->hwnd ? GetAncestor(doc->hwnd, GA_ROOT) : NULL;
+    if(!hwnd || !IsWindow(hwnd))
+        return E_FAIL;
+    PostMessageW(hwnd, WM_CLOSE, 0, 0);
+    return S_OK;
+}
+
+/***********************************************************************
+ *          RunHTMLApplication: loads the .hta named on the command line into a window of its own
+ */
+HRESULT run_html_application(const char *cmdline, int show)
+{
+    struct html_dialog *dlg;
+    WCHAR path[MAX_PATH * 2], *p;
+    IMoniker *mk;
+    HRESULT hres;
+    int len;
+
+#ifdef SG_MUTANT_B4_HTA
+    return E_NOTIMPL;
+#endif
+    while(cmdline && (*cmdline == ' ' || *cmdline == '\t')) cmdline++;
+    if(!cmdline || !*cmdline)
+        return E_INVALIDARG;
+
+    len = MultiByteToWideChar(CP_ACP, 0, cmdline, -1, path, ARRAY_SIZE(path));
+    if(!len)
+        return E_INVALIDARG;
+    p = path;
+    if(*p == '"') {
+        WCHAR *end = wcschr(p + 1, '"');
+        p++;
+        if(end) *end = 0;
+    }else {
+        WCHAR *end = wcschr(p, ' ');
+        if(end) *end = 0;
+    }
+
+    hres = CreateURLMonikerEx(NULL, p, &mk, 0);
+    if(FAILED(hres) || PathIsURLW(p) == FALSE) {
+        /* a file name */
+        WCHAR url[INTERNET_MAX_URL_LENGTH];
+        DWORD size = ARRAY_SIZE(url);
+        WCHAR full[MAX_PATH];
+
+        if(SUCCEEDED(hres)) IMoniker_Release(mk);
+        if(!GetFullPathNameW(p, ARRAY_SIZE(full), full, NULL))
+            return E_INVALIDARG;
+        hres = UrlCreateFromPathW(full, url, &size, 0);
+        if(FAILED(hres))
+            return hres;
+        hres = CreateURLMonikerEx(NULL, url, &mk, 0);
+        if(FAILED(hres))
+            return hres;
+    }
+
+    hres = create_dialog(NULL, mk, NULL, NULL, FALSE, TRUE, &dlg);
+    IMoniker_Release(mk);
+    if(FAILED(hres))
+        return hres;
+
+    ShowWindow(dlg->hwnd, show ? show : SW_SHOWNORMAL);
+    {
+        MSG msg;
+        while(!dlg->done && GetMessageW(&msg, NULL, 0, 0) > 0) {
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+    }
+    dialog_release(dlg);
+    return S_OK;
+}
+
+/* window.showModalDialog and window.showModelessDialog: the URL is relative to the page */
+HRESULT window_show_dialog(HTMLOuterWindow *window, const WCHAR *url, VARIANT *argin, VARIANT *options,
+        BOOL modal, VARIANT *argout, IHTMLWindow2 **modeless)
+{
+    WCHAR full[INTERNET_MAX_URL_LENGTH];
+    DWORD size = ARRAY_SIZE(full);
+    const WCHAR *opt = NULL;
+    VARIANT str;
+    IMoniker *mk;
+    HWND parent = NULL;
+    HRESULT hres;
+
+    if(!url || !*url)
+        return E_INVALIDARG;
+    if(!window->browser || !window->browser->doc)
+        return E_UNEXPECTED;
+
+    if(window->url && SUCCEEDED(CoInternetCombineUrl(window->url, url, URL_ESCAPE_SPACES_ONLY, full, size, &size, 0)))
+        ;
+    else
+        lstrcpynW(full, url, ARRAY_SIZE(full));
+
+    V_VT(&str) = VT_EMPTY;
+    if(options && V_VT(options) != VT_EMPTY && V_VT(options) != VT_ERROR && V_VT(options) != VT_NULL) {
+        hres = VariantChangeType(&str, options, 0, VT_BSTR);
+        if(SUCCEEDED(hres))
+            opt = V_BSTR(&str);
+    }
+
+    hres = CreateURLMonikerEx(NULL, full, &mk, 0);
+    if(FAILED(hres)) {
+        VariantClear(&str);
+        return hres;
+    }
+
+    if(window->browser->doc->hwnd)
+        parent = GetAncestor(window->browser->doc->hwnd, GA_ROOT);
+    hres = show_html_dialog(parent, mk, modal ? HTMLDLG_MODAL : HTMLDLG_MODELESS, argin, opt, argout, modeless);
+    IMoniker_Release(mk);
+    VariantClear(&str);
+    return hres;
+}
