@@ -170,11 +170,91 @@ cleanup:
     return ret;
 }
 
+enum location_part { LOC_PROTOCOL, LOC_HOST, LOC_HOSTNAME, LOC_PORT, LOC_PATHNAME, LOC_SEARCH };
+
+/* navigates to the window's URL with one part replaced */
+static HRESULT location_put_part(HTMLLocation *This, enum location_part part, const WCHAR *v)
+{
+    IUriBuilder *builder;
+    IUri *uri, *new_uri;
+    WCHAR *tmp = NULL;
+    BSTR url;
+    HRESULT hres;
+
+    if(!v)
+        return E_INVALIDARG;
+#ifdef SG_MUTANT_B4_LOC
+    return S_OK;
+#endif
+    if(!(uri = get_uri(This)))
+        return E_FAIL;
+
+    hres = CreateIUriBuilder(uri, 0, 0, &builder);
+    if(FAILED(hres))
+        return hres;
+
+    switch(part) {
+    case LOC_PROTOCOL: {
+        size_t len = lstrlenW(v);
+        if(len && v[len - 1] == ':') {
+            tmp = wcsdup(v);
+            if(tmp) tmp[len - 1] = 0;
+            v = tmp;
+        }
+        hres = IUriBuilder_SetSchemeName(builder, v);
+        break;
+    }
+    case LOC_HOST: {
+        /* host:port */
+        const WCHAR *colon = wcsrchr(v, ':');
+        if(colon && colon != v) {
+            tmp = wcsdup(v);
+            if(tmp) tmp[colon - v] = 0;
+            hres = IUriBuilder_SetHost(builder, tmp ? tmp : v);
+            if(SUCCEEDED(hres))
+                hres = *(colon + 1) ? IUriBuilder_SetPort(builder, TRUE, wcstoul(colon + 1, NULL, 10))
+                                    : IUriBuilder_SetPort(builder, FALSE, 0);
+        }else
+            hres = IUriBuilder_SetHost(builder, v);
+        break;
+    }
+    case LOC_HOSTNAME:
+        hres = IUriBuilder_SetHost(builder, v);
+        break;
+    case LOC_PORT:
+        hres = *v ? IUriBuilder_SetPort(builder, TRUE, wcstoul(v, NULL, 10)) : IUriBuilder_SetPort(builder, FALSE, 0);
+        break;
+    case LOC_PATHNAME:
+        hres = IUriBuilder_SetPath(builder, v);
+        break;
+    default:
+        hres = IUriBuilder_SetQuery(builder, *v == '?' ? v + 1 : v);
+        break;
+    }
+    free(tmp);
+    if(SUCCEEDED(hres))
+        hres = IUriBuilder_CreateUri(builder, 0, 0, 0, &new_uri);
+    IUriBuilder_Release(builder);
+    if(FAILED(hres))
+        return hres;
+
+    hres = IUri_GetAbsoluteUri(new_uri, &url);
+    IUri_Release(new_uri);
+    if(FAILED(hres))
+        return hres;
+
+    hres = navigate_url(This->window, url, get_uri(This), BINDING_NAVIGATED);
+    SysFreeString(url);
+    return hres;
+}
