+static HRESULT dialog_window_prop(HTMLInnerWindow *This, const WCHAR *name, DISPID *dispid)
+{
+    struct html_dialog *dialog;
+    VARIANT v;
+    HRESULT hres;
+
+    if(This->base.outer_window->parent || !This->base.outer_window->browser || !This->base.outer_window->browser->doc)
+        return DISP_E_UNKNOWNNAME;
+    dialog = This->base.outer_window->browser->doc->dialog;
+    if(!dialog)
+        return DISP_E_UNKNOWNNAME;
+
+    if(!wcscmp(name, L"dialogArguments"))
+        hres = dialog_get_arguments(dialog, &v);
+    else if(!wcscmp(name, L"returnValue"))
+        V_VT(&v) = VT_EMPTY, hres = S_OK;
+    else
+        return DISP_E_UNKNOWNNAME;
+    if(FAILED(hres))
+        return hres;
+
+    if(dispex_compat_mode(&This->event_target.dispex) >= COMPAT_MODE_IE9) {
+        hres = dispex_define_property(&This->event_target.dispex, name, PROPF_WRITABLE | PROPF_CONFIGURABLE, &v, dispid);
+    }else {
+        global_prop_t *prop;
+        DISPID id;
+
+        hres = dispex_get_dynid(&This->event_target.dispex, name, TRUE, &id);
+        if(SUCCEEDED(hres)) {
+            prop = alloc_global_prop(This, GLOBAL_DISPEXVAR, name);
+            if(!prop)
