+
+/* the last part of a URL's path ("name.gif"), the whole URL when there is none */
+HRESULT url_name_prop(const WCHAR *url, BSTR *p)
+{
+    const WCHAR *name, *end;
+
+#ifdef SG_MUTANT_B4_URL
+    url = L"";
+#endif
+    if(!url)
+        url = L"";
+    end = wcschr(url, '?');
+    if(!end)
+        end = wcschr(url, '#');
+    if(!end)
+        end = url + lstrlenW(url);
+    for(name = end; name > url && name[-1] != '/'; name--);
+    if(name == end)
+        name = url;
+    *p = SysAllocStringLen(name, end - name);
+    return *p ? S_OK : E_OUTOFMEMORY;
+}
+
+/* the display name of the MIME type that a URL's file name stands for ("GIF Image") */
+HRESULT url_mime_name(const WCHAR *url, BSTR *p)
+{
+    WCHAR *mime = NULL;
+    HRESULT hres;
+
+    if(!url || FAILED(FindMimeFromData(NULL, url, NULL, 0, NULL, 0, &mime, 0)) || !mime) {
+        *p = SysAllocString(L"");
+        return *p ? S_OK : E_OUTOFMEMORY;
+    }
+    hres = get_mime_type_display_name(mime, p);
+    CoTaskMemFree(mime);
+    return hres;
+}
