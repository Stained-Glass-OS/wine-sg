+/* The value changes with the children: the text of a text node child is the value (or a part of it) */
+static HRESULT attr_node_text(IHTMLDOMNode *node, BSTR *text)
+{
+    VARIANT v, str;
+    HRESULT hres;
+
+    *text = NULL;
+    if(!node)
+        return E_INVALIDARG;
+    V_VT(&v) = VT_EMPTY;
+    hres = IHTMLDOMNode_get_nodeValue(node, &v);
+    if(FAILED(hres))
+        return hres;
+    if(V_VT(&v) == VT_EMPTY || V_VT(&v) == VT_NULL)
+        return S_OK;
+    V_VT(&str) = VT_EMPTY;
+    hres = VariantChangeType(&str, &v, 0, VT_BSTR);
+    VariantClear(&v);
+    if(FAILED(hres))
+        return hres;
+    *text = V_BSTR(&str);
+    return S_OK;
+}
+
+static HRESULT attr_set_text(HTMLDOMAttribute *This, const WCHAR *text)
+{
+    VARIANT v;
+    HRESULT hres;
+
+    V_VT(&v) = VT_BSTR;
+    V_BSTR(&v) = SysAllocString(text ? text : L"");
+    if(!V_BSTR(&v))
+        return E_OUTOFMEMORY;
+    hres = IHTMLDOMAttribute_put_nodeValue(&This->IHTMLDOMAttribute_iface, v);
+    VariantClear(&v);
+    return hres;
+}
+
+/* the value after putting the text of new_child before or after the current one */
+static HRESULT attr_add_child(HTMLDOMAttribute *This, IHTMLDOMNode *new_child, BOOL before)
+{
+    BSTR old, add;
+    WCHAR *all;
+    HRESULT hres;
+
+    hres = attr_node_text(new_child, &add);
+    if(FAILED(hres))
+        return hres;
+    hres = attr_value_text(This, &old);
+    if(FAILED(hres)) {
+        SysFreeString(add);
+        return hres;
+    }
+    all = malloc(((add ? lstrlenW(add) : 0) + (old ? lstrlenW(old) : 0) + 1) * sizeof(WCHAR));
+    if(all) {
+        const WCHAR *first = before ? add : old, *second = before ? old : add;
+        all[0] = 0;
+        if(first) lstrcatW(all, first);
+        if(second) lstrcatW(all, second);
+        hres = attr_set_text(This, all);
+        free(all);
+    }else {
+        hres = E_OUTOFMEMORY;
+    }
+    SysFreeString(add);
+    SysFreeString(old);
+    return hres;
+}
