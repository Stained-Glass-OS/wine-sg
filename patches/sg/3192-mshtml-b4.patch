 static HRESULT WINAPI HTMLDOMAttribute2_cloneNode(IHTMLDOMAttribute2 *iface, VARIANT_BOOL fDeep,
         IHTMLDOMAttribute **clonedNode)
 {
     HTMLDOMAttribute *This = impl_from_IHTMLDOMAttribute2(iface);
-    FIXME("(%p)->(%x %p)\n", This, fDeep, clonedNode);
-    return E_NOTIMPL;
+    HTMLDocumentNode *doc = attr_get_doc(This);
+    HTMLDOMAttribute *clone;
+    BSTR name;
+    VARIANT value;
+    HRESULT hres;
+
+    TRACE("(%p)->(%x %p)\n", This, fDeep, clonedNode);
+
+    if(!doc)
+        return E_UNEXPECTED;
+
+    /* a detached attribute with the same name and value; the value is the whole of its content */
+    hres = IHTMLDOMAttribute_get_nodeName(&This->IHTMLDOMAttribute_iface, &name);
+    if(FAILED(hres))
+        return hres;
+    V_VT(&value) = VT_EMPTY;
+    hres = IHTMLDOMAttribute_get_nodeValue(&This->IHTMLDOMAttribute_iface, &value);
+    if(SUCCEEDED(hres))
+        hres = HTMLDOMAttribute_Create(name, NULL, 0, doc, &clone);
+    SysFreeString(name);
+    if(FAILED(hres)) {
+        VariantClear(&value);
+        return hres;
+    }
+    hres = VariantCopy(&clone->value, &value);
+    VariantClear(&value);
+    if(FAILED(hres)) {
+        IHTMLDOMAttribute_Release(&clone->IHTMLDOMAttribute_iface);
+        return hres;
+    }
+    *clonedNode = &clone->IHTMLDOMAttribute_iface;
+    return S_OK;
 }
 
