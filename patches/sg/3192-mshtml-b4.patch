+/* The document an attribute belongs to: its element's, or the one it was made for */
+static HTMLDocumentNode *attr_get_doc(HTMLDOMAttribute *This)
+{
+    if(This->elem)
+        return This->elem->node.doc;
+    return This->window ? This->window->doc : NULL;
+}
+
+/* The text of an attribute's value, NULL when it is empty */
+static HRESULT attr_value_text(HTMLDOMAttribute *This, BSTR *ret)
+{
+    VARIANT v, str;
+    HRESULT hres;
+
+    *ret = NULL;
+    V_VT(&v) = VT_EMPTY;
+    hres = IHTMLDOMAttribute_get_nodeValue(&This->IHTMLDOMAttribute_iface, &v);
+    if(FAILED(hres))
+        return hres;
+    if(V_VT(&v) == VT_EMPTY || V_VT(&v) == VT_NULL)
+        return S_OK;
+    V_VT(&str) = VT_EMPTY;
+    hres = VariantChangeType(&str, &v, 0, VT_BSTR);
+    VariantClear(&v);
+    if(FAILED(hres))
+        return hres;
+    if(V_BSTR(&str) && *V_BSTR(&str))
+        *ret = V_BSTR(&str);
+    else
+        VariantClear(&str);
+    return S_OK;
+}
+
+/* The children of an attribute are the text of its value: a fragment with the one text node, when there is a value */
+static HRESULT attr_children(HTMLDOMAttribute *This, nsIDOMDocumentFragment **ret)
+{
+    HTMLDocumentNode *doc = attr_get_doc(This);
+    nsIDOMDocumentFragment *frag = NULL;
+    nsIDOMText *text;
+    nsIDOMNode *dummy;
+    nsAString nsstr;
+    BSTR value;
+    HRESULT hres;
+
+    *ret = NULL;
+    if(!doc || !doc->dom_document)
+        hres = E_UNEXPECTED;
+    else
+        hres = attr_value_text(This, &value);
+    if(SUCCEEDED(hres) && NS_FAILED(nsIDOMDocument_CreateDocumentFragment(doc->dom_document, &frag)))
+        hres = E_FAIL;
+    if(SUCCEEDED(hres) && value) {
+        nsAString_InitDepend(&nsstr, value);
+        if(NS_SUCCEEDED(nsIDOMDocument_CreateTextNode(doc->dom_document, &nsstr, &text))) {
+            nsIDOMDocumentFragment_AppendChild(frag, (nsIDOMNode*)text, &dummy);
+            if(dummy) nsIDOMNode_Release(dummy);
+            nsIDOMText_Release(text);
+        }
+        nsAString_Finish(&nsstr);
+    }
+    if(SUCCEEDED(hres))
+        SysFreeString(value);
+    if(FAILED(hres)) {
+        if(frag) nsIDOMDocumentFragment_Release(frag);
+        return hres;
+    }
+    *ret = frag;
+    return S_OK;
+}
+
