+/* Reads window.returnValue out of the dialog's document window. */
+static void dialog_read_result(struct html_dialog *dlg)
+{
+    IHTMLWindow2 *window = NULL;
+    IDispatchEx *dispex;
+    DISPPARAMS dp = {NULL, NULL, 0, 0};
