From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: system performance counters from the host, classic trace registrations

- NtQuerySystemInformation(SystemPerformanceInformation) gave the idle
  time and memory and zeros for the rest, with a FIXME (438 in the logs;
  performance monitors and Task-Manager-like tools read it). On Linux the
  host's counters fill it: disk read/write operations and bytes (whole
  disks from /proc/diskstats), page faults, page-read I/Os, pages read,
  paging-file and mapped-file pages written (/proc/vmstat), paged and
  non-paged pool usage (slab), the system cache pages, context switches
  (/proc/stat), and the peak commitment seen.
- EtwRegisterTraceGuidsW gave every registration and trace class the
  handle 0xdeadbeef and took a missing callback, control GUID or handle
  pointer. Each now gets a handle of its own and bad arguments
  ERROR_INVALID_PARAMETER; no trace session ever enables a provider here,
  so the callback is never called, as on Windows with none listening.
  EtwRegisterTraceGuidsA registers likewise (it registered nothing), and
  EtwEventWrite and EtwUnregisterTraceGuids stop logging FIXMEs: an event
  with no session listening goes nowhere and succeeds.

Wine's ntdll info and advapi32 eventlog tests: as before.

Gate: test/perfcount-gate.sh (64- and 32-bit). Mutants
SG_MUTANT_NO_PERF_COUNTERS (ntdll/unix/system.c),
SG_MUTANT_ETW_FIXED_HANDLES (ntdll/misc.c).
---
--- a/dlls/ntdll/misc.c
+++ b/dlls/ntdll/misc.c
@@ -396,25 +396,43 @@ ULONG WINAPI EtwEventWriteTransfer( REGHANDLE handle, PCEVENT_DESCRIPTOR descrip
  *  Success: ERROR_SUCCESS
  *  Failure: System error code
  */
+/* Stained Glass OS: a classic trace provider's registration. No trace
+ * session ever enables a provider here (there is no event tracing to
+ * enable it), so the request callback is never called; the registration
+ * and each trace class get handles of their own, as on Windows. */
+static LONG trace_registrations;
+
 ULONG WINAPI EtwRegisterTraceGuidsW( WMIDPREQUEST RequestAddress,
                 void *RequestContext, const GUID *ControlGuid, ULONG GuidCount,
                 TRACE_GUID_REGISTRATION *TraceGuidReg, const WCHAR *MofImagePath,
                 const WCHAR *MofResourceName, TRACEHANDLE *RegistrationHandle )
 {
-    WARN("(%p, %p, %s, %lu, %p, %s, %s, %p): stub\n", RequestAddress, RequestContext,
+    TRACE("(%p, %p, %s, %lu, %p, %s, %s, %p)\n", RequestAddress, RequestContext,
           debugstr_guid(ControlGuid), GuidCount, TraceGuidReg, debugstr_w(MofImagePath),
           debugstr_w(MofResourceName), RegistrationHandle);
 
+    if (!RequestAddress || !ControlGuid || !RegistrationHandle || (GuidCount && !TraceGuidReg))
+        return ERROR_INVALID_PARAMETER;
+
     if (TraceGuidReg)
     {
         ULONG i;
         for (i = 0; i < GuidCount; i++)
         {
-            FIXME("  register trace class %s\n", debugstr_guid(TraceGuidReg[i].Guid));
+            TRACE("  register trace class %s\n", debugstr_guid(TraceGuidReg[i].Guid));
+            if (!TraceGuidReg[i].Guid) return ERROR_INVALID_PARAMETER;
+#ifndef SG_MUTANT_ETW_FIXED_HANDLES
+            TraceGuidReg[i].RegHandle = ULongToHandle( 0x10000 + InterlockedIncrement( &trace_registrations ) );
+#else
             TraceGuidReg[i].RegHandle = (HANDLE)0xdeadbeef;
+#endif
         }
     }
+#ifndef SG_MUTANT_ETW_FIXED_HANDLES
+    *RegistrationHandle = 0x10000 + InterlockedIncrement( &trace_registrations );
+#else
     *RegistrationHandle = (TRACEHANDLE)0xdeadbeef;
+#endif
     return ERROR_SUCCESS;
 }
 
@@ -426,10 +444,31 @@ ULONG WINAPI EtwRegisterTraceGuidsA( WMIDPREQUEST RequestAddress,
                 TRACE_GUID_REGISTRATION *TraceGuidReg, const char *MofImagePath,
                 const char *MofResourceName, TRACEHANDLE *RegistrationHandle )
 {
-    WARN("(%p, %p, %s, %lu, %p, %s, %s, %p): stub\n", RequestAddress, RequestContext,
+    WCHAR *image = NULL, *resource = NULL;
+    ULONG ret;
+    DWORD len;
+
+    TRACE("(%p, %p, %s, %lu, %p, %s, %s, %p)\n", RequestAddress, RequestContext,
           debugstr_guid(ControlGuid), GuidCount, TraceGuidReg, debugstr_a(MofImagePath),
           debugstr_a(MofResourceName), RegistrationHandle);
-    return ERROR_SUCCESS;
+
+    if (MofImagePath)
+    {
+        len = strlen( MofImagePath ) + 1;
+        if ((image = RtlAllocateHeap( GetProcessHeap(), 0, len * sizeof(WCHAR) )))
+            RtlMultiByteToUnicodeN( image, len * sizeof(WCHAR), NULL, MofImagePath, len );
+    }
+    if (MofResourceName)
+    {
+        len = strlen( MofResourceName ) + 1;
+        if ((resource = RtlAllocateHeap( GetProcessHeap(), 0, len * sizeof(WCHAR) )))
+            RtlMultiByteToUnicodeN( resource, len * sizeof(WCHAR), NULL, MofResourceName, len );
+    }
+    ret = EtwRegisterTraceGuidsW( RequestAddress, RequestContext, ControlGuid, GuidCount, TraceGuidReg,
+                                  image, resource, RegistrationHandle );
+    RtlFreeHeap( GetProcessHeap(), 0, image );
+    RtlFreeHeap( GetProcessHeap(), 0, resource );
+    return ret;
 }
 
 /******************************************************************************
@@ -440,7 +479,7 @@ ULONG WINAPI EtwUnregisterTraceGuids( TRACEHANDLE RegistrationHandle )
     if (!RegistrationHandle)
          return ERROR_INVALID_PARAMETER;
 
-    WARN("%s: stub\n", wine_dbgstr_longlong(RegistrationHandle));
+    TRACE("%s\n", wine_dbgstr_longlong(RegistrationHandle));
     return ERROR_SUCCESS;
 }
 
@@ -459,7 +498,8 @@ BOOLEAN WINAPI EtwEventEnabled( REGHANDLE handle, const EVENT_DESCRIPTOR *descri
 ULONG WINAPI EtwEventWrite( REGHANDLE handle, const EVENT_DESCRIPTOR *descriptor, ULONG count,
     EVENT_DATA_DESCRIPTOR *data )
 {
-    FIXME("(%s, %p, %lu, %p): stub\n", wine_dbgstr_longlong(handle), descriptor, count, data);
+    /* with no session listening, an event goes nowhere, and that succeeds */
+    TRACE("(%s, %p, %lu, %p)\n", wine_dbgstr_longlong(handle), descriptor, count, data);
     return ERROR_SUCCESS;
 }
 
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -2410,6 +2410,70 @@ static void get_performance_info( SYSTEM_PERFORMANCE_INFORMATION *info )
     info->AvailablePages      = freeram / page_size;
     info->TotalCommittedPages = (totalram + totalswap - freeram - freeswap) / page_size;
     info->TotalCommitLimit    = (totalram + totalswap) / page_size;
+
+#if defined(linux) && !defined(SG_MUTANT_NO_PERF_COUNTERS)
+    /* Stained Glass OS: the counters the host keeps -- disk transfers,
+     * page faults and paging, pool usage, context switches */
+    {
+        static ULONG peak_commitment;
+        unsigned long long reads = 0, writes = 0, read_sectors = 0, write_sectors = 0, value;
+        char line[256], name[64], sys[96];
+        unsigned int maj, min;
+        FILE *fp;
+
+        if ((fp = fopen( "/proc/diskstats", "r" )))
+        {
+            unsigned long long r, rm, rs, rt, w, wm, ws;
+
+            while (fgets( line, sizeof(line), fp ))
+            {
+                if (sscanf( line, "%u %u %63s %llu %llu %llu %llu %llu %llu %llu", &maj, &min, name,
+                            &r, &rm, &rs, &rt, &w, &wm, &ws ) != 10)
+                    continue;
+                /* whole disks only, not their partitions again */
+                snprintf( sys, sizeof(sys), "/sys/block/%s", name );
+                if (access( sys, F_OK ) || !strncmp( name, "loop", 4 ) || !strncmp( name, "ram", 3 )) continue;
+                reads += r;
+                read_sectors += rs;
+                writes += w;
+                write_sectors += ws;
+            }
+            fclose( fp );
+        }
+        info->ReadOperationCount = reads;
+        info->WriteOperationCount = writes;
+        info->ReadTransferCount.QuadPart = read_sectors * 512;
+        info->WriteTransferCount.QuadPart = write_sectors * 512;
+
+        if ((fp = fopen( "/proc/vmstat", "r" )))
+        {
+            while (fgets( line, sizeof(line), fp ))
+            {
+                if (sscanf( line, "%63s %llu", name, &value ) != 2) continue;
+                if (!strcmp( name, "pgfault" )) info->PageFaults = value;
+                else if (!strcmp( name, "pgmajfault" )) info->PageReadIos = value;
+                else if (!strcmp( name, "pgpgin" )) info->PagesRead = value * 1024 / page_size;
+                else if (!strcmp( name, "pswpout" ))
+                    info->PagefilePagesWritten = info->PagefilePageWriteIos = value;
+                else if (!strcmp( name, "pgpgout" )) info->MappedFilePagesWritten = value * 1024 / page_size;
+                else if (!strcmp( name, "nr_slab_reclaimable" )) info->PagedPoolUsage = value;
+                else if (!strcmp( name, "nr_slab_unreclaimable" )) info->NonPagedPoolUsage = value;
+                else if (!strcmp( name, "nr_file_pages" )) info->MmSystemCachePage = value;
+            }
+            fclose( fp );
+        }
+
+        if ((fp = fopen( "/proc/stat", "r" )))
+        {
+            while (fgets( line, sizeof(line), fp ))
+                if (sscanf( line, "ctxt %llu", &value ) == 1) info->ContextSwitches = value;
+            fclose( fp );
+        }
+
+        if (info->TotalCommittedPages > peak_commitment) peak_commitment = info->TotalCommittedPages;
+        info->PeakCommitment = peak_commitment;
+    }
+#endif
 }
 
 #ifdef linux
@@ -3019,7 +3083,6 @@ NTSTATUS WINAPI NtQuerySystemInformation( SYSTEM_INFORMATION_CLASS class,
     case SystemPerformanceInformation:  /* 2 */
     {
         SYSTEM_PERFORMANCE_INFORMATION spi;
-        static BOOL fixme_written = FALSE;
 
         get_performance_info( &spi );
         len = sizeof(spi);
@@ -3029,10 +3092,6 @@ NTSTATUS WINAPI NtQuerySystemInformation( SYSTEM_INFORMATION_CLASS class,
             else memcpy( info, &spi, len);
         }
         else ret = STATUS_INFO_LENGTH_MISMATCH;
-        if(!fixme_written) {
-            FIXME("info_class SYSTEM_PERFORMANCE_INFORMATION\n");
-            fixme_written = TRUE;
-        }
         break;
     }
 
