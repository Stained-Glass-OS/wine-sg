From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, win32u, xmllite: device family version, ETW provider information, other threads' keyboard layout

- RtlGetDeviceFamilyInfoEnum gave version 0 (~600 hits in the logs; WinRT
  apps read AnalyticsInfo's DeviceFamilyVersion): it gives the OS version,
  major, minor, build and update revision (UBR) in 16-bit fields.
- EtwEventSetInformation logged a FIXME and accepted anything (~1400 hits:
  .NET and Chrome set traits on every provider). No trace session consumes
  the events here, so the information is only checked as Windows checks it:
  a traits blob must start with its own size, the descriptor type is a
  BOOLEAN, unknown classes are ERROR_NOT_SUPPORTED. evntprov.h's
  EVENT_INFO_CLASS had lost EventProviderSetReserved1, which shifted
  EventProviderSetTraits and EventProviderUseDescriptorType by one.
- GetKeyboardLayout of another thread logged a FIXME on every call (11087
  hits: input indicators and IMEs ask for the foreground window's thread)
  and answered even for threads that do not exist. Layouts are switched on
  the display server, for every thread at once, so another thread's is the
  caller's; a thread that does not exist has none (0).
- IXmlReader::IsDefault and FSCTL_PIPE_IMPERSONATE logged FIXMEs for what
  is right: no DTD attribute defaults are applied, so no attribute is a
  default; the server impersonates the pipe's client (its token captured
  when it connected), not the caller.

Gate: test/devfamily-gate.sh (Xvfb). Mutants
SG_MUTANT_NO_DEVICE_FAMILY_VERSION (ntdll/rtl.c),
SG_MUTANT_NO_ETW_INFO_CHECK (ntdll/misc.c),
SG_MUTANT_NO_OTHER_THREAD_LAYOUT (win32u/input.c).
---
--- a/dlls/ntdll/misc.c
+++ b/dlls/ntdll/misc.c
@@ -330,8 +330,29 @@ ULONG WINAPI EtwEventUnregister( REGHANDLE handle )
 ULONG WINAPI EtwEventSetInformation( REGHANDLE handle, EVENT_INFO_CLASS class, void *info,
                                      ULONG length )
 {
-    FIXME("(%s, %u, %p, %lu) stub\n", wine_dbgstr_longlong(handle), class, info, length);
+    TRACE("(%s, %u, %p, %lu)\n", wine_dbgstr_longlong(handle), class, info, length);
+
+    /* No trace session consumes the events here, so a provider's traits
+     * and descriptor type are only checked, as Windows checks them: .NET
+     * and Chrome set traits on every provider they register. */
+#ifdef SG_MUTANT_NO_ETW_INFO_CHECK
     return ERROR_SUCCESS;
+#endif
+    switch (class)
+    {
+    case EventProviderBinaryTrackInfo:
+    case EventProviderSetReserved1:
+        return ERROR_SUCCESS;
+    case EventProviderSetTraits:
+        /* the traits blob starts with its own total size */
+        if (!info || length < sizeof(USHORT) || *(USHORT *)info != length) return ERROR_INVALID_PARAMETER;
+        return ERROR_SUCCESS;
+    case EventProviderUseDescriptorType:
+        if (!info || length != sizeof(BOOLEAN)) return ERROR_INVALID_PARAMETER;
+        return ERROR_SUCCESS;
+    default:
+        return ERROR_NOT_SUPPORTED;
+    }
 }
 
 /******************************************************************************
--- a/dlls/ntdll/rtl.c
+++ b/dlls/ntdll/rtl.c
@@ -1303,9 +1303,36 @@ char WINAPI RtlQueryProcessPlaceholderCompatibilityMode(void)
  */
 void WINAPI RtlGetDeviceFamilyInfoEnum(ULONGLONG *version, DWORD *family, DWORD *form)
 {
-    FIXME("%p %p %p: stub\n", version, family, form);
-
-    if (version) *version = 0;
+    RTL_OSVERSIONINFOEXW info = { sizeof(info) };
+    KEY_VALUE_PARTIAL_INFORMATION *value;
+    char buffer[offsetof( KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(DWORD)] )];
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING name;
+    ULONG revision = 0, size;
+    HANDLE key;
+
+    TRACE("%p %p %p\n", version, family, form);
+
+    /* the version WinRT apps check (AnalyticsInfo's DeviceFamilyVersion):
+     * major, minor, build and the update revision, 16 bits each; it was 0 */
+    RtlGetVersion( &info );
+    RtlInitUnicodeString( &name, L"\\Registry\\Machine\\Software\\Microsoft\\Windows NT\\CurrentVersion" );
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, NULL, NULL );
+    if (!NtOpenKey( &key, KEY_QUERY_VALUE, &attr ))
+    {
+        RtlInitUnicodeString( &name, L"UBR" );
+        value = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+        if (!NtQueryValueKey( key, &name, KeyValuePartialInformation, buffer, sizeof(buffer), &size ) &&
+            value->Type == REG_DWORD && value->DataLength == sizeof(DWORD))
+            revision = *(DWORD *)value->Data;
+        NtClose( key );
+    }
+#ifdef SG_MUTANT_NO_DEVICE_FAMILY_VERSION
+    info.dwMajorVersion = info.dwMinorVersion = info.dwBuildNumber = revision = 0;
+#endif
+    if (version) *version = ((ULONGLONG)(info.dwMajorVersion & 0xffff) << 48) |
+                            ((ULONGLONG)(info.dwMinorVersion & 0xffff) << 32) |
+                            ((ULONGLONG)(info.dwBuildNumber & 0xffff) << 16) | (revision & 0xffff);
     if (family) *family = DEVICEFAMILYINFOENUM_DESKTOP;
     if (form) *form = DEVICEFAMILYDEVICEFORM_UNKNOWN;
 }
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -7330,7 +7330,9 @@ NTSTATUS WINAPI NtFsControlFile( HANDLE handle, HANDLE event, PIO_APC_ROUTINE ap
         return status;
 
     case FSCTL_PIPE_IMPERSONATE:
-        FIXME("FSCTL_PIPE_IMPERSONATE: impersonating self\n");
+        /* the server gives the thread the client's token, captured when it
+         * connected (Stained Glass OS multi-user) */
+        TRACE("FSCTL_PIPE_IMPERSONATE\n");
         return server_ioctl_file( handle, event, apc, apc_context, io, code,
                                   in_buffer, in_size, out_buffer, out_size );
 
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -951,8 +951,25 @@ HKL WINAPI NtUserGetKeyboardLayout( DWORD thread_id )
     struct user_thread_info *thread = get_user_thread_info();
     HKL layout = thread->kbd_layout;
 
+#ifndef SG_MUTANT_NO_OTHER_THREAD_LAYOUT
     if (thread_id && thread_id != GetCurrentThreadId())
-        FIXME( "couldn't return keyboard layout for thread %04x\n", (int)thread_id );
+    {
+        /* Another thread's: keyboard layouts are switched on the display
+         * server, for every thread at once, so it is this one's; a thread
+         * that does not exist has none (input indicators and IMEs ask for
+         * the foreground window's thread) */
+        OBJECT_ATTRIBUTES attr;
+        CLIENT_ID cid;
+        HANDLE handle;
+
+        InitializeObjectAttributes( &attr, NULL, 0, NULL, NULL );
+        cid.UniqueProcess = 0;
+        cid.UniqueThread = ULongToHandle( thread_id );
+        if (NtOpenThread( &handle, THREAD_QUERY_LIMITED_INFORMATION, &attr, &cid ) == STATUS_INVALID_CID)
+            return 0;
+        if (handle) NtClose( handle );
+    }
+#endif
 
     if (!layout) return get_locale_kbd_layout();
     return layout;
--- a/dlls/xmllite/reader.c
+++ b/dlls/xmllite/reader.c
@@ -3412,7 +3412,9 @@ static HRESULT WINAPI xmlreader_GetBaseUri(IXmlReader* iface,
 
 static BOOL WINAPI xmlreader_IsDefault(IXmlReader* iface)
 {
-    FIXME("%p: stub\n", iface);
+    /* whether the attribute came from the DTD's defaults: DTD attribute
+     * defaults are not applied here, so no attribute ever does */
+    TRACE("%p\n", iface);
     return FALSE;
 }
 
--- a/include/evntprov.h
+++ b/include/evntprov.h
@@ -66,6 +66,7 @@ typedef VOID (NTAPI *PENABLECALLBACK)(LPCGUID,ULONG,UCHAR,ULONGLONG,ULONGLONG,PE
 typedef enum _EVENT_INFO_CLASS
 {
     EventProviderBinaryTrackInfo = 0,
+    EventProviderSetReserved1,
     EventProviderSetTraits,
     EventProviderUseDescriptorType,
     MaxEventInfo
