 };
 
 /* its content shown directly: templates of ScrollViewer name parts (ScrollContentPresenter, scroll bars)
- * we do not make yet, so its template is not applied */
+ * we do not make yet, so its template is not applied.  The content is measured unbounded in the
+ * directions it scrolls, placed at minus the view's offsets and clipped to the viewer; a thin bar
+ * shows where the view is */
+static INT32 sv_bar( struct scroll_viewer *sv, BOOL vertical )
+{
+    return get_int( &sv->c.e.d, vertical ? prop_vbar : prop_hbar );
+}
+
+static struct scroll_viewer *sv_from_elem( struct uielem *elem )
+{
+    return CONTAINING_RECORD( elem, struct scroll_viewer, c.e );
+}
+
 static void scroll_viewer_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
 {
-    struct control *control = control_from_elem( elem );
+    struct scroll_viewer *sv = sv_from_elem( elem );
+    struct xsize inner = available;
+
+    sv->c.template_tried = TRUE;
+#ifndef SG_MUTANT_SCROLL_VIEWER_BOUNDED
+    if (sv_bar( sv, FALSE ) != BAR_DISABLED) inner.width = INFINITY;
+    if (sv_bar( sv, TRUE ) != BAR_DISABLED) inner.height = INFINITY;
+#endif
+    control_measure( elem, inner, desired );
+    sv->extent = *desired;
+    if (desired->width > available.width) desired->width = available.width;
+    if (desired->height > available.height) desired->height = available.height;
+}
 
-    control->template_tried = TRUE;
-    control_measure( elem, available, desired );
+static void sv_clamp( struct scroll_viewer *sv )
+{
+    DOUBLE max_x = fmax( 0, sv->extent.width - sv->viewport.width ), max_y = fmax( 0, sv->extent.height - sv->viewport.height );
+
+    sv->offset[0] = fmin( fmax( sv->offset[0], 0 ), max_x );
+    sv->offset[1] = fmin( fmax( sv->offset[1], 0 ), max_y );
+}
+
+static void scroll_viewer_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct scroll_viewer *sv = sv_from_elem( elem );
+    struct control *control = &sv->c;
+    struct xrect rect;
+
+    *used = final;
+    sv->viewport = final;
+    sv_clamp( sv );
+    if (!control->child) return;
+    rect.x = -sv->offset[0];
+    rect.y = -sv->offset[1];
+    rect.width = fmax( sv->extent.width, final.width );
+    rect.height = fmax( sv->extent.height, final.height );
+    uielem_arrange( control->child, rect );
+}
+
+/* the bar of a direction that scrolls, over the content */
+static void scroll_viewer_render_over( struct uielem *elem, struct xdraw *draw )
+{
+    struct scroll_viewer *sv = sv_from_elem( elem );
+    struct xcolor bar = { 0x80, 0x80, 0x80, 0x80 };
+    struct xrect rect;
+    INT32 v = sv_bar( sv, TRUE ), h = sv_bar( sv, FALSE );
+
+    if ((v == BAR_AUTO || v == BAR_VISIBLE) && sv->extent.height > sv->viewport.height + 0.5 && sv->viewport.height > 0)
+    {
+        rect.width = 3;
+        rect.x = sv->viewport.width - 4;
+        rect.height = fmax( 16, sv->viewport.height * sv->viewport.height / sv->extent.height );
+        rect.y = (sv->viewport.height - rect.height) * sv->offset[1] / (sv->extent.height - sv->viewport.height);
+        xdraw_fill( draw, &rect, bar, NULL );
+    }
+    if ((h == BAR_AUTO || h == BAR_VISIBLE) && sv->extent.width > sv->viewport.width + 0.5 && sv->viewport.width > 0)
+    {
+        rect.height = 3;
+        rect.y = sv->viewport.height - 4;
+        rect.width = fmax( 16, sv->viewport.width * sv->viewport.width / sv->extent.width );
+        rect.x = (sv->viewport.width - rect.width) * sv->offset[0] / (sv->extent.width - sv->viewport.width);
+        xdraw_fill( draw, &rect, bar, NULL );
+    }
 }
 
-static const struct elem_ops scroll_viewer_ops = { scroll_viewer_measure, control_arrange, control_render };
+static const struct elem_ops scroll_viewer_ops =
+{
+    scroll_viewer_measure, scroll_viewer_arrange, control_render, scroll_viewer_render_over,
+};
+
+static const struct xclass scroll_viewer_class;
+
+static BOOL is_scroll_viewer( struct uielem *elem )
+{
+    return elem->d.obj.cls == &scroll_viewer_class;
+}
+
+/* a scroll viewer shows its content inside itself only */
+BOOL xaml_scroll_viewer_clip( struct uielem *elem, struct xrect *rect )
+{
+    if (!is_scroll_viewer( elem )) return FALSE;
+    rect->x = rect->y = 0;
+    rect->width = elem->render.width;
+    rect->height = elem->render.height;
+    return TRUE;
+}
+
+/* ScrollViewerViewChangedEventArgs: the change is done (IsIntermediate FALSE) */
+struct view_changed_args
+{
+    struct xobj obj;
+    struct xiface iface;
+};
+static HRESULT WINAPI view_changed_get_IsIntermediate( struct xiface *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+static const void *view_changed_args_vtbl[] =
+{
+    IScrollViewerViewChangedEventArgs_STUBS, [IScrollViewerViewChangedEventArgs_IsIntermediate] = view_changed_get_IsIntermediate,
+};
+static const struct xiface_entry view_changed_args_ifaces[] =
+{
+    { &IID_IScrollViewerViewChangedEventArgs, offsetof(struct view_changed_args, iface) },
+};
+static void view_changed_args_destroy( struct xobj *obj ) {}
+static const struct xclass view_changed_args_class =
+{
+    L"Windows.UI.Xaml.Controls.ScrollViewerViewChangedEventArgs", view_changed_args_ifaces,
+    ARRAY_SIZE(view_changed_args_ifaces), view_changed_args_destroy,
+};
+
+/* the view moved to (x, y), clamped: laid out again, ViewChanged told */
+static BOOL sv_move( struct scroll_viewer *sv, DOUBLE x, DOUBLE y )
+{
+    struct view_changed_args *args;
+    IInspectable *sender = NULL, *iface;
+    DOUBLE old_x = sv->offset[0], old_y = sv->offset[1];
+
+    sv->offset[0] = x;
+    sv->offset[1] = y;
+    sv_clamp( sv );
+    if (sv->offset[0] == old_x && sv->offset[1] == old_y) return FALSE;
+    TRACE( "%p: view at %.1f,%.1f\n", sv, sv->offset[0], sv->offset[1] );
+    uielem_invalidate_arrange( &sv->c.e );
+    xaml_invalidate_visuals();
+    if (list_empty( &sv->view_changed.entries ) || !(args = calloc( 1, sizeof(*args) ))) return TRUE;
+    args->iface.vtbl = view_changed_args_vtbl;
+    xobj_init( &args->obj, &view_changed_args_class, NULL );
+    iface = xobj_default( &args->obj );
+    IInspectable_Release( (IInspectable *)&args->obj.IInspectable_inner );
+    if (SUCCEEDED(IUnknown_QueryInterface( sv->c.e.d.obj.outer, &IID_IInspectable, (void **)&sender )))
+    {
+        xaml_raise_routed( &sv->view_changed, sender, iface );
+        IInspectable_Release( sender );
+    }
+    IInspectable_Release( iface );
+    return TRUE;
+}
+
+/* the mouse wheel over an element: the nearest scroll viewer that can move that way scrolls (48 a notch) */
+BOOL xaml_scroll_viewer_wheel( struct uielem *elem, INT32 delta, BOOL horizontal )
+{
+#ifdef SG_MUTANT_NO_WHEEL_SCROLL
+    return FALSE;
+#endif
+    for (; elem; elem = elem->parent)
+    {
+        struct scroll_viewer *sv;
+        DOUBLE step = -delta / 120.0 * 48;
+
+        if (!is_scroll_viewer( elem )) continue;
+        sv = sv_from_elem( elem );
+        if (horizontal || sv->extent.height <= sv->viewport.height + 0.5)
+        {
+            if (sv_bar( sv, FALSE ) != BAR_DISABLED && sv->extent.width > sv->viewport.width + 0.5 &&
+                sv_move( sv, sv->offset[0] + (horizontal ? -step : step), sv->offset[1] )) return TRUE;
+            continue;
+        }
+        if (sv_bar( sv, TRUE ) != BAR_DISABLED && sv_move( sv, sv->offset[0], sv->offset[1] + step )) return TRUE;
+    }
+    return FALSE;
+}
+
+/* IScrollViewer: the bars' visibility and modes, the view's numbers, ViewChanged, ScrollTo*Offset */
+static HRESULT WINAPI sv_get_int( struct xiface *iface, struct xaml_property *prop, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = get_int( &sv_from_iface( iface )->c.e.d, prop );
+    return S_OK;
+}
+
+#define SV_INT_PROP(name, prop) \
+static HRESULT WINAPI sv_get_##name( struct xiface *iface, INT32 *value ) { return sv_get_int( iface, prop, value ); } \
+static HRESULT WINAPI sv_put_##name( struct xiface *iface, INT32 value ) \
+{ HRESULT hr = put_box( &sv_from_iface( iface )->c.e.d, prop, xbox_int32( value ) ); uielem_invalidate_measure( &sv_from_iface( iface )->c.e ); return hr; }
+SV_INT_PROP(HorizontalScrollBarVisibility, prop_hbar)
+SV_INT_PROP(VerticalScrollBarVisibility, prop_vbar)
+SV_INT_PROP(HorizontalScrollMode, prop_hmode)
+SV_INT_PROP(VerticalScrollMode, prop_vmode)
+
+#define SV_DOUBLE(name, expr) \
+static HRESULT WINAPI sv_get_##name( struct xiface *iface, DOUBLE *value ) \
+{ struct scroll_viewer *sv = sv_from_iface( iface ); if (!value) return E_POINTER; *value = (expr); return S_OK; }
+SV_DOUBLE(HorizontalOffset, sv->offset[0])
+SV_DOUBLE(VerticalOffset, sv->offset[1])
+SV_DOUBLE(ViewportWidth, sv->viewport.width)
+SV_DOUBLE(ViewportHeight, sv->viewport.height)
+SV_DOUBLE(ExtentWidth, sv->extent.width)
+SV_DOUBLE(ExtentHeight, sv->extent.height)
+SV_DOUBLE(ScrollableWidth, fmax( 0, sv->extent.width - sv->viewport.width ))
+SV_DOUBLE(ScrollableHeight, fmax( 0, sv->extent.height - sv->viewport.height ))
+
+static HRESULT WINAPI sv_get_ComputedHorizontalScrollBarVisibility( struct xiface *iface, INT32 *value )
+{
+    struct scroll_viewer *sv = sv_from_iface( iface );
+    INT32 bar = sv_bar( sv, FALSE );
+    if (!value) return E_POINTER;
+    *value = bar == BAR_VISIBLE || (bar == BAR_AUTO && sv->extent.width > sv->viewport.width + 0.5) ? XVISIBLE : XCOLLAPSED;
+    return S_OK;
+}
+
+static HRESULT WINAPI sv_get_ComputedVerticalScrollBarVisibility( struct xiface *iface, INT32 *value )
+{
+    struct scroll_viewer *sv = sv_from_iface( iface );
+    INT32 bar = sv_bar( sv, TRUE );
+    if (!value) return E_POINTER;
+    *value = bar == BAR_VISIBLE || (bar == BAR_AUTO && sv->extent.height > sv->viewport.height + 0.5) ? XVISIBLE : XCOLLAPSED;
+    return S_OK;
+}
+
+static HRESULT WINAPI sv_get_ZoomFactor( struct xiface *iface, FLOAT *value ) { if (!value) return E_POINTER; *value = 1.0f; return S_OK; }
+
+static HRESULT WINAPI sv_add_ViewChanged( struct xiface *iface, IUnknown *handler, INT64 *token )
+{
+    return handlers_add( &sv_from_iface( iface )->view_changed, handler, token );
+}
+
+static HRESULT WINAPI sv_remove_ViewChanged( struct xiface *iface, INT64 token )
+{
+    return handlers_remove( &sv_from_iface( iface )->view_changed, token );
+}
+
+static HRESULT WINAPI sv_ScrollToHorizontalOffset( struct xiface *iface, DOUBLE offset )
+{
+    struct scroll_viewer *sv = sv_from_iface( iface );
+    sv_move( sv, offset, sv->offset[1] );
+    return S_OK;
+}
