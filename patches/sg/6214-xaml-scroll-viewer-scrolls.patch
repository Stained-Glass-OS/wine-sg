 #ifdef SG_MUTANT_XAML_CLIP_IGNORED
     return FALSE;
 #endif
+    if (xaml_scroll_viewer_clip( elem, rect )) return TRUE;   /* a scroll viewer clips to itself */
     if (!prop_clip || FAILED(dobj_get_value( &elem->d, prop_clip, &clip )) || !clip) return FALSE;
     ret = xaml_geometry_rect( clip, rect );
     IInspectable_Release( clip );
@@ -1398,6 +1399,25 @@ static struct handler_list *routed_event_list( struct uielem *elem, IInspectable
     return NULL;
 }
 
+static const GUID IID_IPropertyValue_elem = { 0x4bd682dd, 0x7554, 0x40e9, { 0x9a, 0x9b, 0x82, 0x65, 0x4e, 0xde, 0x7e, 0x62 } };
+static const GUID IID_nothing_elem = { 0x5f3a2c1e, 0x0b7d, 0x4e9a, { 0x8c, 0x61, 0x2d, 0x9f, 0x40, 0x13, 0x77, 0xa5 } };
+
+/* a handler given boxed (C++/WinRT's box_value: an IReference<T> that is an IPropertyValue too); an
+ * object that answers any interface (no real box does) is taken as the delegate itself */
+static BOOL handler_is_boxed( IInspectable *handler )
+{
+    IUnknown *unk;
+
+    if (FAILED(IInspectable_QueryInterface( handler, &IID_IPropertyValue_elem, (void **)&unk ))) return FALSE;
+    IUnknown_Release( unk );
+    if (SUCCEEDED(IInspectable_QueryInterface( handler, &IID_nothing_elem, (void **)&unk )))
+    {
+        IUnknown_Release( unk );
+        return FALSE;
+    }
+    return TRUE;
+}
+
 static HRESULT WINAPI uielement_AddHandler( struct xiface *iface, IInspectable *routed, IInspectable *handler, boolean handled_too )
 {
     struct uielem *elem = elem_from_iface( iface );
@@ -1418,7 +1438,8 @@ static HRESULT WINAPI uielement_AddHandler( struct xiface *iface, IInspectable *
         IUnknown *delegate = NULL;
         HRESULT hr;
 
-        if (SUCCEEDED(IInspectable_QueryInterface( handler, &IID_IInspectable, (void **)&boxed )))
+        /* a box answers IPropertyValue too (C++/WinRT's references do); a delegate does not */
+        if (handler_is_boxed( handler ) && SUCCEEDED(IInspectable_QueryInterface( handler, &IID_IInspectable, (void **)&boxed )))
         {
             hr = ((HRESULT (WINAPI *)( IInspectable *, IUnknown ** ))((void **)boxed->lpVtbl)[6])( boxed, &delegate );
             IInspectable_Release( boxed );
