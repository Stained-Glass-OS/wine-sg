+static HRESULT WINAPI sv_ScrollToVerticalOffset( struct xiface *iface, DOUBLE offset )
+{
+    struct scroll_viewer *sv = sv_from_iface( iface );
+    sv_move( sv, sv->offset[0], offset );
+    return S_OK;
+}
+
+static HRESULT WINAPI sv_ZoomToFactor( struct xiface *iface, FLOAT factor ) { return S_OK; }
+static HRESULT WINAPI sv_InvalidateScrollInfo( struct xiface *iface )
+{
+    uielem_invalidate_measure( &sv_from_iface( iface )->c.e );
