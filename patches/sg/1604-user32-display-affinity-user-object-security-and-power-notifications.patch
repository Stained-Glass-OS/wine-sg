From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: display affinity, user object security and power notifications

Four user32 stubs that answered wrongly:

- SetWindowDisplayAffinity failed with ERROR_NOT_ENOUGH_MEMORY (Zoom,
  Teams and password managers keep their windows out of screen captures
  with it). The affinity (WDA_NONE, WDA_MONITOR, WDA_EXCLUDEFROMCAPTURE)
  is kept as a property of the window and GetWindowDisplayAffinity reads
  it back; other values are refused, and only the window's own process
  sets it. It is not yet enforced in captures.
- GetUserObjectSecurity made up an empty security descriptor whatever
  the object had, and SetUserObjectSecurity did nothing (Chrome sets its
  alternate desktop's DACL and reads it back). Both go to the window
  station's or desktop's own descriptor (NtQuerySecurityObject,
  NtSetSecurityObject). The server still gives window stations and
  desktops no descriptor of their own until one is set: giving them one
  would start access checks on them.
- RegisterPowerSettingNotification returned 0xdeadbeef and never sent
  anything. A registration is now a handle of its own, and the setting's
  current value is sent at once, as on Windows (WM_POWERBROADCAST,
  PBT_POWERSETTINGCHANGE, to a window of the process or a
  DEVICE_NOTIFY_CALLBACK callback): power source, battery, monitor and
  display state, user presence, power plan, away mode, lid, energy saver.
  Programs learn whether they run on battery from that first message.
  Later changes are not sent. Unregistering a bad handle fails with
  ERROR_INVALID_HANDLE. RegisterSuspendResumeNotification likewise.
- EnableNonClientDpiScaling failed with ERROR_CALL_NOT_IMPLEMENTED; it
  succeeds for a window of the calling thread (frames are drawn for the
  window's DPI already).

Wine's user32 winstation and win tests: no new failures.

Gate: test/userapis-gate.sh (Xvfb). Mutants SG_MUTANT_NO_DISPLAY_AFFINITY
(win.c), SG_MUTANT_NO_USER_OBJECT_SECURITY (winstation.c),
SG_MUTANT_NO_POWER_NOTIFY (misc.c).
---
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -32,6 +32,7 @@
 #include "user_private.h"
 
 #include "wine/debug.h"
+#include "wine/exception.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(win);
 
@@ -404,13 +405,191 @@ BOOL WINAPI UserHandleGrantAccess(HANDLE handle, HANDLE job, BOOL grant)
     return TRUE;
 }
 
+/* Power setting notifications. A registration is a handle of its own, and
+ * as on Windows the setting's current value is sent at once: programs
+ * (browsers, Electron apps, games, media players) learn whether they run on
+ * battery, the display's state and the power plan from that first
+ * WM_POWERBROADCAST, and the stub never sent it. Later changes are not
+ * sent. */
+#ifndef PBT_POWERSETTINGCHANGE
+#define PBT_POWERSETTINGCHANGE 0x8013
+#endif
+#ifndef DEVICE_NOTIFY_CALLBACK
+#define DEVICE_NOTIFY_CALLBACK 0x00000002
+#endif
+
+typedef ULONG (CALLBACK *power_callback_t)( void *context, ULONG type, void *setting );
+struct power_subscribe_params
+{
+    power_callback_t callback;
+    void            *context;
+};
+
+#define POWER_NOTIFY_MAGIC 0x50574e46  /* "PWNF" */
+
+struct power_notify
+{
+    DWORD  magic;
+    BOOL   suspend_resume;
+    HANDLE recipient;
+    DWORD  flags;
+    GUID   guid;
+    struct power_subscribe_params params;
+};
+
+struct power_setting_data
+{
+    GUID  guid;
+    DWORD length;
+    union { DWORD value; GUID scheme; } data;
+};
+
+static const GUID power_acdc_source        = {0x5d3e9a59,0xe9d5,0x4b00,{0xa6,0xbd,0xff,0x34,0xff,0x51,0x65,0x48}};
+static const GUID power_battery_percentage = {0xa7ad8041,0xb45a,0x4cae,{0x87,0xa3,0xee,0xcb,0xb4,0x68,0xa9,0xe1}};
+static const GUID power_monitor_on         = {0x02731015,0x4510,0x4526,{0x99,0xe6,0xe5,0xa1,0x7e,0xbd,0x1a,0xea}};
+static const GUID power_console_display    = {0x6fe69556,0x704a,0x47a0,{0x8f,0x24,0xc2,0x8d,0x93,0x6f,0xda,0x47}};
+static const GUID power_session_display    = {0x2b84c20e,0xad23,0x4ddf,{0x93,0xdb,0x05,0xff,0xbd,0x7e,0xfc,0xa5}};
+static const GUID power_session_presence   = {0x3c0f4548,0xc03f,0x4c4d,{0xb9,0xf2,0x23,0x7e,0xde,0x68,0x63,0x76}};
+static const GUID power_global_presence    = {0x786e8a1d,0xb427,0x4344,{0x92,0x07,0x09,0xe7,0x0b,0xdc,0xbe,0xa9}};
+static const GUID power_scheme_personality = {0x245d8541,0x3943,0x4422,{0xb0,0x25,0x13,0xa7,0x84,0xf6,0x79,0xb7}};
+static const GUID power_active_scheme      = {0x31f9f286,0x5084,0x42fe,{0xb7,0x20,0x2b,0x02,0x64,0x99,0x37,0x63}};
+static const GUID power_balanced_scheme    = {0x381b4222,0xf694,0x41f0,{0x96,0x85,0xff,0x5b,0xb2,0x60,0xdf,0x2e}};
+static const GUID power_away_mode          = {0x98a7f580,0x01f7,0x48aa,{0x9c,0x0f,0x44,0x35,0x2c,0x29,0xe5,0xc0}};
+static const GUID power_lid_state          = {0xba3e0f4d,0xb817,0x4094,{0xa2,0xd1,0xd5,0x63,0x79,0xe6,0xa0,0xf3}};
+static const GUID power_saving_status      = {0xe00958c0,0xc213,0x4ace,{0xac,0x77,0xfe,0xcc,0xed,0x2e,0xee,0xa5}};
+static const GUID power_energy_saver       = {0x550e8400,0xe29b,0x41d4,{0xa7,0x16,0x44,0x66,0x55,0x44,0x00,0x00}};
+
+/* the setting's current value, FALSE when it has none to send */
+static BOOL get_power_setting( const GUID *guid, struct power_setting_data *setting )
+{
+    SYSTEM_POWER_STATUS status;
+
+    setting->guid = *guid;
+    setting->length = sizeof(DWORD);
+    setting->data.value = 0;
+    if (IsEqualGUID( guid, &power_acdc_source ))
+    {
+        /* PoAc 0, PoDc 1 */
+        setting->data.value = GetSystemPowerStatus( &status ) && status.ACLineStatus == 0 ? 1 : 0;
+    }
+    else if (IsEqualGUID( guid, &power_battery_percentage ))
+    {
+        if (!GetSystemPowerStatus( &status ) || status.BatteryLifePercent > 100) return FALSE;
+        setting->data.value = status.BatteryLifePercent;
+    }
+    else if (IsEqualGUID( guid, &power_monitor_on ) || IsEqualGUID( guid, &power_console_display ) ||
+             IsEqualGUID( guid, &power_session_display ) || IsEqualGUID( guid, &power_lid_state ))
+        setting->data.value = 1;  /* on, open */
+    else if (IsEqualGUID( guid, &power_session_presence ) || IsEqualGUID( guid, &power_global_presence ) ||
+             IsEqualGUID( guid, &power_away_mode ) || IsEqualGUID( guid, &power_saving_status ) ||
+             IsEqualGUID( guid, &power_energy_saver ))
+        setting->data.value = 0;  /* present, off */
+    else if (IsEqualGUID( guid, &power_scheme_personality ) || IsEqualGUID( guid, &power_active_scheme ))
+    {
+        setting->length = sizeof(GUID);
+        setting->data.scheme = power_balanced_scheme;
+    }
+    else return FALSE;
+    return TRUE;
+}
+
+static DWORD CALLBACK send_power_setting( void *arg )
+{
+    struct power_notify *notify = arg;
+    struct power_setting_data setting;
+    DWORD pid;
+
+    if (get_power_setting( &notify->guid, &setting ))
+    {
+        if (notify->flags == DEVICE_NOTIFY_CALLBACK)
+            notify->params.callback( notify->params.context, PBT_POWERSETTINGCHANGE, &setting );
+        else if (GetWindowThreadProcessId( notify->recipient, &pid ) && pid == GetCurrentProcessId())
+            SendMessageTimeoutW( notify->recipient, WM_POWERBROADCAST, PBT_POWERSETTINGCHANGE, (LPARAM)&setting,
+                                 SMTO_NORMAL, 10000, NULL );
+    }
+    HeapFree( GetProcessHeap(), 0, notify );
+    return 0;
+}
+
+static HPOWERNOTIFY register_power_notify( HANDLE recipient, const GUID *guid, DWORD flags, BOOL suspend_resume )
+{
+    struct power_notify *notify;
+
+    if (!recipient || (flags != DEVICE_NOTIFY_WINDOW_HANDLE && flags != DEVICE_NOTIFY_SERVICE_HANDLE &&
+                       flags != DEVICE_NOTIFY_CALLBACK) ||
+        (flags == DEVICE_NOTIFY_WINDOW_HANDLE && !IsWindow( recipient )))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (!(notify = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*notify) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    notify->magic = POWER_NOTIFY_MAGIC;
+    notify->suspend_resume = suspend_resume;
+    notify->recipient = recipient;
+    notify->flags = flags;
+    if (guid) notify->guid = *guid;
+    if (flags == DEVICE_NOTIFY_CALLBACK) notify->params = *(struct power_subscribe_params *)recipient;
+
+    if (!suspend_resume && flags != DEVICE_NOTIFY_SERVICE_HANDLE)
+    {
+        struct power_notify *copy = HeapAlloc( GetProcessHeap(), 0, sizeof(*copy) );
+        HANDLE thread;
+
+        if (copy)
+        {
+            *copy = *notify;
+            if ((thread = CreateThread( NULL, 0, send_power_setting, copy, 0, NULL ))) CloseHandle( thread );
+            else HeapFree( GetProcessHeap(), 0, copy );
+        }
+    }
+    return notify;
+}
+
+static BOOL unregister_power_notify( HPOWERNOTIFY handle, BOOL suspend_resume )
+{
+    struct power_notify *notify = handle;
+    BOOL valid = FALSE;
+
+    __TRY
+    {
+        valid = notify && notify->magic == POWER_NOTIFY_MAGIC && notify->suspend_resume == suspend_resume;
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        valid = FALSE;
+    }
+    __ENDTRY
+    if (!valid)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    notify->magic = 0;
+    HeapFree( GetProcessHeap(), 0, notify );
+    return TRUE;
+}
+
 /**********************************************************************
  * RegisterPowerSettingNotification [USER32.@]
  */
 HPOWERNOTIFY WINAPI RegisterPowerSettingNotification(HANDLE recipient, const GUID *guid, DWORD flags)
 {
+#ifndef SG_MUTANT_NO_POWER_NOTIFY
+    TRACE("(%p,%s,%lx)\n", recipient, debugstr_guid(guid), flags);
+    if (!guid)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    return register_power_notify( recipient, guid, flags, FALSE );
+#else
     FIXME("(%p,%s,%lx): stub\n", recipient, debugstr_guid(guid), flags);
     return (HPOWERNOTIFY)0xdeadbeef;
+#endif
 }
 
 /**********************************************************************
@@ -418,8 +597,13 @@ HPOWERNOTIFY WINAPI RegisterPowerSettingNotification(HANDLE recipient, const GUI
  */
 BOOL WINAPI UnregisterPowerSettingNotification(HPOWERNOTIFY handle)
 {
+#ifndef SG_MUTANT_NO_POWER_NOTIFY
+    TRACE("(%p)\n", handle);
+    return unregister_power_notify( handle, FALSE );
+#else
     FIXME("(%p): stub\n", handle);
     return TRUE;
+#endif
 }
 
 /**********************************************************************
@@ -427,8 +611,13 @@ BOOL WINAPI UnregisterPowerSettingNotification(HPOWERNOTIFY handle)
  */
 HPOWERNOTIFY WINAPI RegisterSuspendResumeNotification(HANDLE recipient, DWORD flags)
 {
+#ifndef SG_MUTANT_NO_POWER_NOTIFY
+    TRACE("%p, %#lx\n", recipient, flags);
+    return register_power_notify( recipient, NULL, flags, TRUE );
+#else
     FIXME("%p, %#lx: stub.\n", recipient, flags);
     return (HPOWERNOTIFY)0xdeadbeef;
+#endif
 }
 
 /**********************************************************************
@@ -436,8 +625,13 @@ HPOWERNOTIFY WINAPI RegisterSuspendResumeNotification(HANDLE recipient, DWORD fl
  */
 BOOL WINAPI UnregisterSuspendResumeNotification(HPOWERNOTIFY handle)
 {
+#ifndef SG_MUTANT_NO_POWER_NOTIFY
+    TRACE("%p\n", handle);
+    return unregister_power_notify( handle, TRUE );
+#else
     FIXME("%p: stub.\n", handle);
     return TRUE;
+#endif
 }
 
 /**********************************************************************
--- a/dlls/user32/sysparams.c
+++ b/dlls/user32/sysparams.c
@@ -797,9 +797,22 @@ BOOL WINAPI IsProcessDPIAware(void)
  */
 BOOL WINAPI EnableNonClientDpiScaling( HWND hwnd )
 {
-    FIXME("(%p): stub\n", hwnd);
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    /* Per-monitor (v1) programs call it from WM_NCCREATE so their caption
+     * and menus follow the monitor's DPI; frames here are drawn for the
+     * window's DPI already (v2 behaviour), so it succeeds for a window of
+     * this thread. It failed with ERROR_CALL_NOT_IMPLEMENTED. */
+    TRACE("(%p)\n", hwnd);
+    if (!IsWindow( hwnd ))
+    {
+        SetLastError( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    if (GetWindowThreadProcessId( hwnd, NULL ) != GetCurrentThreadId())
+    {
+        SetLastError( ERROR_ACCESS_DENIED );
+        return FALSE;
+    }
+    return TRUE;
 }
 
 /***********************************************************************
--- a/dlls/user32/win.c
+++ b/dlls/user32/win.c
@@ -1689,17 +1689,34 @@ LONG_PTR WINAPI SetWindowLongPtrA( HWND hwnd, INT offset, LONG_PTR newval )
 /*****************************************************************************
  *              GetWindowDisplayAffinity (USER32.@)
  */
+/* The display affinity a program asked for (Zoom, Teams, password managers
+ * keep their windows out of screen captures with it), kept as a property of
+ * the window; SetWindowDisplayAffinity failed with ERROR_NOT_ENOUGH_MEMORY. */
+#ifndef WDA_EXCLUDEFROMCAPTURE
+#define WDA_EXCLUDEFROMCAPTURE 0x11
+#endif
+static const WCHAR display_affinity_prop[] = L"__wine_display_affinity";
+
 BOOL WINAPI GetWindowDisplayAffinity(HWND hwnd, DWORD *affinity)
 {
-    FIXME("(%p, %p): stub\n", hwnd, affinity);
+    TRACE("(%p, %p)\n", hwnd, affinity);
 
-    if (!hwnd || !affinity)
+    if (!hwnd || !IsWindow(hwnd))
+    {
+        SetLastError(ERROR_INVALID_WINDOW_HANDLE);
+        return FALSE;
+    }
+    if (!affinity)
     {
-        SetLastError(hwnd ? ERROR_NOACCESS : ERROR_INVALID_WINDOW_HANDLE);
+        SetLastError(ERROR_NOACCESS);
         return FALSE;
     }
 
+#ifndef SG_MUTANT_NO_DISPLAY_AFFINITY
+    *affinity = HandleToUlong( GetPropW( hwnd, display_affinity_prop ));
+#else
     *affinity = WDA_NONE;
+#endif
     return TRUE;
 }
 
@@ -1708,6 +1725,31 @@ BOOL WINAPI GetWindowDisplayAffinity(HWND hwnd, DWORD *affinity)
  */
 BOOL WINAPI SetWindowDisplayAffinity(HWND hwnd, DWORD affinity)
 {
+#ifndef SG_MUTANT_NO_DISPLAY_AFFINITY
+    DWORD pid;
+
+    TRACE("(%p, %lu)\n", hwnd, affinity);
+
+    if (!hwnd || !GetWindowThreadProcessId( hwnd, &pid ))
+    {
+        SetLastError(ERROR_INVALID_WINDOW_HANDLE);
+        return FALSE;
+    }
+    if (affinity != WDA_NONE && affinity != WDA_MONITOR && affinity != WDA_EXCLUDEFROMCAPTURE)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    /* only the process that owns the window sets it */
+    if (pid != GetCurrentProcessId())
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+    if (affinity == WDA_NONE) RemovePropW( hwnd, display_affinity_prop );
+    else if (!SetPropW( hwnd, display_affinity_prop, ULongToHandle( affinity ))) return FALSE;
+    return TRUE;
+#else
     FIXME("(%p, %lu): stub\n", hwnd, affinity);
 
     if (!hwnd)
@@ -1718,6 +1760,7 @@ BOOL WINAPI SetWindowDisplayAffinity(HWND hwnd, DWORD affinity)
 
     SetLastError(ERROR_NOT_ENOUGH_MEMORY);
     return FALSE;
+#endif
 }
 
 /**********************************************************************
--- a/dlls/user32/winstation.c
+++ b/dlls/user32/winstation.c
@@ -381,6 +381,28 @@ BOOL WINAPI SetUserObjectInformationA( HANDLE handle, INT index, LPVOID info, DW
 BOOL WINAPI GetUserObjectSecurity( HANDLE handle, PSECURITY_INFORMATION info,
                                    PSECURITY_DESCRIPTOR sid, DWORD len, LPDWORD needed )
 {
+#ifndef SG_MUTANT_NO_USER_OBJECT_SECURITY
+    NTSTATUS status;
+    ULONG size = 0;
+
+    /* the window station's or desktop's own security descriptor: the stub's
+     * empty one (no DACL: everyone has full access) misled sandboxes that
+     * build an alternate desktop's DACL from it (Chrome) */
+    TRACE( "(%p %p %p len=%ld %p)\n", handle, info, sid, len, needed );
+    if (!info)
+    {
+        SetLastError( ERROR_NOACCESS );
+        return FALSE;
+    }
+    status = NtQuerySecurityObject( handle, *info, sid, len, &size );
+    if (needed) *needed = size;
+    if (status)
+    {
+        SetLastError( RtlNtStatusToDosError( status ));
+        return FALSE;
+    }
+    return TRUE;
+#else
     FIXME( "(%p %p %p len=%ld %p),stub!\n", handle, info, sid, len, needed );
     if (needed)
         *needed = sizeof(SECURITY_DESCRIPTOR);
@@ -390,6 +412,7 @@ BOOL WINAPI GetUserObjectSecurity( HANDLE handle, PSECURITY_INFORMATION info,
         return FALSE;
     }
     return InitializeSecurityDescriptor(sid, SECURITY_DESCRIPTOR_REVISION);
+#endif
 }
 
 /***********************************************************************
@@ -398,6 +421,23 @@ BOOL WINAPI GetUserObjectSecurity( HANDLE handle, PSECURITY_INFORMATION info,
 BOOL WINAPI SetUserObjectSecurity( HANDLE handle, PSECURITY_INFORMATION info,
                                    PSECURITY_DESCRIPTOR sid )
 {
+#ifndef SG_MUTANT_NO_USER_OBJECT_SECURITY
+    NTSTATUS status;
+
+    TRACE( "(%p,%p,%p)\n", handle, info, sid );
+    if (!info)
+    {
+        SetLastError( ERROR_NOACCESS );
+        return FALSE;
+    }
+    if ((status = NtSetSecurityObject( handle, *info, sid )))
+    {
+        SetLastError( RtlNtStatusToDosError( status ));
+        return FALSE;
+    }
+    return TRUE;
+#else
     FIXME( "(%p,%p,%p),stub!\n", handle, info, sid );
     return TRUE;
+#endif
 }
