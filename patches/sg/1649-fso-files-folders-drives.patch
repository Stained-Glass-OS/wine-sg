+static HRESULT create_unc_drive(const WCHAR *root, IDrive **drive)
+{
+    struct drive *object;
+    size_t len = wcslen(root);
+
+    *drive = NULL;
+    if (len + 2 > MAX_PATH) return CTL_E_BADFILENAME;
+    if (!(object = malloc(sizeof(*object)))) return E_OUTOFMEMORY;
+    object->IDrive_iface.lpVtbl = &drivevtbl;
+    object->ref = 1;
+    wcscpy(object->root, root);
+    if (len && root[len - 1] != '\\') wcscat(object->root, L"\\");
+    init_classinfo(&CLSID_Drive, (IUnknown *)&object->IDrive_iface, &object->classinfo);
+    *drive = &object->IDrive_iface;
+    return S_OK;
+}
