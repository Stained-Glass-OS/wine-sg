+/* Stained Glass OS (1649): helpers for the File, Folder and Drive objects */
+static HRESULT create_unc_drive(const WCHAR *root, IDrive **drive);
+static HRESULT create_drive(WCHAR letter, IDrive **drive);
+
+/* the drive a path is on: its letter, or its \\server\share */
+static HRESULT drive_of_path(const WCHAR *path, IDrive **drive)
+{
+    WCHAR full[MAX_PATH], root[MAX_PATH];
+
+    *drive = NULL;
+    if (!GetFullPathNameW(path, ARRAY_SIZE(full), full, NULL)) return create_error(GetLastError());
+    if (full[0] && full[1] == ':') return create_drive(towupper(full[0]), drive);
+    if (full[0] == '\\' && full[1] == '\\')
+    {
+        wcscpy(root, full);
+        if (!PathStripToRootW(root)) return CTL_E_DEVICEUNAVAILABLE;
+        return create_unc_drive(root, drive);
+    }
+    return CTL_E_DEVICEUNAVAILABLE;
+}
+
+/* the folder a path is in; none for a root */
+static HRESULT parent_of_path(const WCHAR *path, IFolder **folder)
+{
+    WCHAR full[MAX_PATH];
+
+    *folder = NULL;
+    if (!GetFullPathNameW(path, ARRAY_SIZE(full), full, NULL)) return create_error(GetLastError());
+    PathRemoveBackslashW(full);
+    if (PathIsRootW(full)) return S_OK;   /* Nothing */
+    if (!PathRemoveFileSpecW(full)) return S_OK;
+    return create_folder(full, folder);
+}
+
+/* the type Explorer shows for it */
+static HRESULT type_of_path(const WCHAR *path, DWORD attributes, BSTR *type)
+{
+    SHFILEINFOW info;
+
+    memset(&info, 0, sizeof(info));
+    if (!SHGetFileInfoW(path, attributes, &info, sizeof(info), SHGFI_TYPENAME | SHGFI_USEFILEATTRIBUTES))
+        info.szTypeName[0] = 0;
+    *type = SysAllocString(info.szTypeName);
+    return *type ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT short_path(const WCHAR *path, BSTR *ret, BOOL name_only)
+{
+    WCHAR buffer[MAX_PATH];
+    const WCHAR *p = buffer;
+
+    if (!GetShortPathNameW(path, buffer, ARRAY_SIZE(buffer))) return create_error(GetLastError());
+    if (name_only)
+    {
+        PathRemoveBackslashW(buffer);
+        p = PathFindFileNameW(buffer);
+    }
+    *ret = SysAllocString(p);
+    return *ret ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT path_dates(const WCHAR *path, int which, DATE *date)
+{
+    WIN32_FILE_ATTRIBUTE_DATA attrs;
+
+    if (!date) return E_POINTER;
+    if (!GetFileAttributesExW(path, GetFileExInfoStandard, &attrs)) return create_error(GetLastError());
+    return get_date_from_filetime(which == 0 ? &attrs.ftCreationTime :
+                                  which == 1 ? &attrs.ftLastWriteTime : &attrs.ftLastAccessTime, date);
+}
+
+/* renames in place: the same folder, a new name */
+static HRESULT rename_path(WCHAR **path_ptr, const WCHAR *name, BOOL bstr)
+{
+    WCHAR full[MAX_PATH], *path = *path_ptr;
+
+    if (!name || !name[0] || wcspbrk(name, L"\\/:*?\"<>|")) return CTL_E_BADFILENAME;
+    wcscpy(full, path);
+    PathRemoveBackslashW(full);
+    if (!PathRemoveFileSpecW(full) && !full[0]) full[0] = 0;
+    if (!PathAppendW(full, name)) return CTL_E_BADFILENAME;
+    if (!MoveFileW(path, full)) return create_error(GetLastError());
+    if (bstr)
+    {
+        BSTR copy = SysAllocString(full);
+        if (!copy) return E_OUTOFMEMORY;
+        SysFreeString(path);
+        *path_ptr = copy;
+    }
+    else
+    {
+        WCHAR *copy = wcsdup(full);
+        if (!copy) return E_OUTOFMEMORY;
+        free(path);
+        *path_ptr = copy;
+    }
+    return S_OK;
+}
+
+/* the total size of a folder's files, all the way down */
+static void folder_size(const WCHAR *folder, ULONGLONG *size)
+{
+    WCHAR pattern[MAX_PATH], sub[MAX_PATH];
+    WIN32_FIND_DATAW fd;
+    HANDLE find;
+
+    if (!PathCombineW(pattern, folder, L"*")) return;
+    if ((find = FindFirstFileW(pattern, &fd)) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        if (!wcscmp(fd.cFileName, L".") || !wcscmp(fd.cFileName, L"..")) continue;
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+        {
+            if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) && PathCombineW(sub, folder, fd.cFileName))
+                folder_size(sub, size);
+        }
+        else *size += ((ULONGLONG)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+    } while (FindNextFileW(find, &fd));
+    FindClose(find);
+}
+
+/* MoveFile and MoveFolder: wildcards, or a destination ending in a
+ * separator, move into that folder */
+static HRESULT move_paths(const WCHAR *source, const WCHAR *destination, BOOL folders)
+{
+    WCHAR dir[MAX_PATH], from[MAX_PATH], to[MAX_PATH];
+    WIN32_FIND_DATAW fd;
+    HANDLE find;
+    size_t len = wcslen(destination);
+    BOOL into = len && (destination[len - 1] == '\\' || destination[len - 1] == '/');
+    BOOL found = FALSE;
+
+    if (!wcspbrk(source, L"*?") && !into)
+        return MoveFileW(source, destination) ? S_OK : create_error(GetLastError());
+
+    wcscpy(dir, source);
+    PathRemoveFileSpecW(dir);
+    if ((find = FindFirstFileW(source, &fd)) == INVALID_HANDLE_VALUE)
+        return folders ? CTL_E_PATHNOTFOUND : CTL_E_FILENOTFOUND;
+    do
+    {
+        if (!wcscmp(fd.cFileName, L".") || !wcscmp(fd.cFileName, L"..")) continue;
+        if (!!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != folders) continue;
+        found = TRUE;
+        if (!PathCombineW(from, dir, fd.cFileName) || !PathCombineW(to, destination, fd.cFileName))
+        {
+            FindClose(find);
+            return CTL_E_BADFILENAME;
+        }
+        if (!MoveFileW(from, to))
+        {
+            FindClose(find);
+            return create_error(GetLastError());
+        }
+    } while (FindNextFileW(find, &fd));
+    FindClose(find);
+    if (!found) return folders ? CTL_E_PATHNOTFOUND : CTL_E_FILENOTFOUND;
+    return S_OK;
+}
