+/* The textures of a device without a keyed mutex hand over what they hold when the device is flushed: the
+ * creator of a resource that has readers puts its pixels in the content, a reader takes what is new. */
+void d3d_kmt_shares_sync(ID3D11Device2 *device)
+{
+    struct d3d_kmt_share *share;
+
+    AcquireSRWLockShared(&kmt_lock);
+    LIST_FOR_EACH_ENTRY(share, &d3d_kmt_shares, struct d3d_kmt_share, entry)
+    {
+        if (share->mutex || share->texture->device != device)
+            continue;
+        if (share->creator)
+            d3d_texture2d_share_push(share->texture);
+        else
+            d3d_texture2d_share_pull(share->texture);
+    }
+    ReleaseSRWLockShared(&kmt_lock);
+}
+
+/* The creating texture of a resource in this process hands over its pixels, to a texture that just opened it. */
+void d3d_kmt_shares_push_creator(UINT64 id)
+{
+    struct d3d_kmt_share *share;
+
+    AcquireSRWLockShared(&kmt_lock);
+    LIST_FOR_EACH_ENTRY(share, &d3d_kmt_shares, struct d3d_kmt_share, entry)
+    {
+        if (share->creator && !share->mutex && share->id == id)
+        {
+            d3d_texture2d_share_push_force(share->texture);
+            break;
+        }
+    }
+    ReleaseSRWLockShared(&kmt_lock);
+}
