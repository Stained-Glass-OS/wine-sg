+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "d3d11_private.h"
+#include "wine/kmtshare.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3d11);
+
+#define KMT_STATUS_TIMEOUT          ((NTSTATUS)0x00000102)
+#define KMT_STATUS_ABANDONED        ((NTSTATUS)0x00000080)
+#define KMT_STATUS_BUFFER_TOO_SMALL ((NTSTATUS)0xc0000023)
+
+/* The content of a shared resource follows its header. */
+#define D3D_SHARED_CONTENT_HEADER   sizeof(struct d3d_shared_content)
+
+static SRWLOCK kmt_lock = SRWLOCK_INIT;
+static D3DKMT_HANDLE kmt_adapter, kmt_device;
+static struct list d3d_kmt_shares = LIST_INIT(d3d_kmt_shares);
+
+/* The legacy shared handle of D3DKMT is a number with this bit set, and no handle has it. */
+BOOL d3d_kmt_share_handle_is_legacy(HANDLE handle)
+{
+    return ((ULONG_PTR)handle & 0xc0000000) == 0x40000000;
+}
+
+/* The D3DKMT device that the process makes its resources on; one is enough. */
+static HRESULT kmt_init(const LUID *luid)
+{
+    D3DKMT_OPENADAPTERFROMLUID adapter = {{0}};
+    D3DKMT_CREATEDEVICE device = {0};
+
+    AcquireSRWLockExclusive(&kmt_lock);
+    if (!kmt_device)
+    {
+        adapter.AdapterLuid = *luid;
+        if (D3DKMTOpenAdapterFromLuid(&adapter))
+        {
+            ReleaseSRWLockExclusive(&kmt_lock);
+            WARN("Failed to open the adapter.\n");
+            return E_FAIL;
+        }
+        device.hAdapter = adapter.hAdapter;
+        if (D3DKMTCreateDevice(&device))
+        {
+            D3DKMT_CLOSEADAPTER close = {adapter.hAdapter};
+            D3DKMTCloseAdapter(&close);
+            ReleaseSRWLockExclusive(&kmt_lock);
+            WARN("Failed to create the device.\n");
+            return E_FAIL;
+        }
+        kmt_adapter = adapter.hAdapter;
+        kmt_device = device.hDevice;
+    }
+    ReleaseSRWLockExclusive(&kmt_lock);
+    return S_OK;
+}
+
+static HRESULT hresult_from_ntstatus(NTSTATUS status)
+{
+    switch (status)
+    {
+        case 0: return S_OK;
+        case KMT_STATUS_TIMEOUT: return WAIT_TIMEOUT;
+        case KMT_STATUS_ABANDONED: return WAIT_ABANDONED;
+        case KMT_STATUS_BUFFER_TOO_SMALL: return E_INVALIDARG;
+        default: return DXGI_ERROR_INVALID_CALL;
+    }
+}
+
+HRESULT d3d_kmt_share_create(const struct d3d_shared_runtime *runtime, BOOL keyed, BOOL nt_handle,
+        struct d3d_kmt_share **out)
+{
+    struct wine_kmt_alloc_data data = {D3D_SHARED_CONTENT_HEADER};
+    struct d3d_shared_runtime rt = *runtime;
+    D3DDDI_ALLOCATIONINFO info = {0};
+    D3DKMT_CREATEALLOCATION create = {0};
+    struct d3d_kmt_share *share;
+    NTSTATUS status;
+    HRESULT hr;
+
+    if (FAILED(hr = kmt_init(&runtime->luid)))
+        return hr;
+    if (!(share = calloc(1, sizeof(*share))))
+        return E_OUTOFMEMORY;
+
+    data.size += runtime->content_size;
+    share->nt_handle = nt_handle;
+    share->creator = TRUE;
+    share->content_size = data.size;
+    share->pitch = runtime->pitch;
+
+    if (keyed)
+    {
+        D3DKMT_CREATEKEYEDMUTEX2 mutex = {0};
+
+        mutex.Flags.NtSecuritySharing = nt_handle;
+        if ((status = D3DKMTCreateKeyedMutex2(&mutex)))
+        {
+            WARN("Failed to create the keyed mutex, status %#lx.\n", status);
+            free(share);
+            return E_FAIL;
+        }
+        share->mutex = mutex.hKeyedMutex;
+        share->global_mutex = mutex.hSharedHandle;
+        rt.mutex_global = mutex.hSharedHandle;
+    }
+
+    create.hDevice = kmt_device;
+    create.pPrivateRuntimeData = &rt;
+    create.PrivateRuntimeDataSize = sizeof(rt);
+    create.NumAllocations = 1;
+    create.pAllocationInfo = &info;
+    create.Flags.CreateResource = 1;
+    create.Flags.CreateShared = 1;
+    create.Flags.NtSecuritySharing = nt_handle;
+    info.pPrivateDriverData = &data;
+    info.PrivateDriverDataSize = sizeof(data);
+    if ((status = D3DKMTCreateAllocation(&create)))
+    {
+        D3DKMT_DESTROYKEYEDMUTEX destroy = {share->mutex};
+
+        WARN("Failed to create the allocation, status %#lx.\n", status);
+        if (share->mutex)
+            D3DKMTDestroyKeyedMutex(&destroy);
+        free(share);
+        return E_FAIL;
+    }
+    share->resource = create.hResource;
+    share->allocation = info.hAllocation;
+    share->global_resource = create.hGlobalShare;
+
+    *out = share;
+    return S_OK;
+}
+
+void d3d_kmt_share_destroy(struct d3d_kmt_share *share)
+{
+    D3DKMT_DESTROYALLOCATION destroy = {0};
+    D3DKMT_DESTROYKEYEDMUTEX destroy_mutex;
+
+    if (!share)
+        return;
+
+    AcquireSRWLockExclusive(&kmt_lock);
+    if (share->entry.next)
+        list_remove(&share->entry);
+    ReleaseSRWLockExclusive(&kmt_lock);
+
+    /* a keyed mutex that is destroyed while it is held is lost */
+    if (share->mutex)
+    {
+        destroy_mutex.hKeyedMutex = share->mutex;
+        D3DKMTDestroyKeyedMutex(&destroy_mutex);
+    }
+    destroy.hDevice = kmt_device;
+    destroy.hResource = share->resource;
+    D3DKMTDestroyAllocation(&destroy);
+    free(share);
+}
+
+void d3d_kmt_share_register(struct d3d_kmt_share *share, struct d3d_texture2d *texture)
+{
+    share->texture = texture;
+    AcquireSRWLockExclusive(&kmt_lock);
+    list_add_tail(&d3d_kmt_shares, &share->entry);
+    ReleaseSRWLockExclusive(&kmt_lock);
+}
+
+/* What the resource of a share holds: a view of its content. */
+HRESULT d3d_kmt_share_map(struct d3d_kmt_share *share, struct d3d_shared_content **content, void **view)
+{
+    struct wine_kmt_escape escape = {WINE_KMT_ESCAPE_MAGIC, WINE_KMT_ESCAPE_MAP_ALLOCATION, share->allocation};
+    D3DKMT_ESCAPE esc = {0};
+    HANDLE section;
+    BYTE *base;
+
+    esc.hAdapter = kmt_adapter;
+    esc.hDevice = kmt_device;
+    esc.Type = D3DKMT_ESCAPE_DRIVERPRIVATE;
+    esc.pPrivateDriverData = &escape;
+    esc.PrivateDriverDataSize = sizeof(escape);
+    if (D3DKMTEscape(&esc))
+        return E_FAIL;
+    section = (HANDLE)(ULONG_PTR)escape.section;
+    base = MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, 0, 0);
+    CloseHandle(section);
+    if (!base)
+        return E_FAIL;
+    *view = base;
+    *content = (struct d3d_shared_content *)(base + escape.offset);
+    return S_OK;
+}
+
+static HRESULT kmt_share_attach(struct d3d_shared_runtime *runtime, struct d3d_kmt_share *share, BOOL nt_handle)
+{
+    struct d3d_shared_content *content;
+    void *view;
+    HRESULT hr;
+
+    share->nt_handle = nt_handle;
+    share->pitch = runtime->pitch;
+    share->content_size = D3D_SHARED_CONTENT_HEADER + runtime->content_size;
+    if (SUCCEEDED(hr = d3d_kmt_share_map(share, &content, &view)))
+    {
+        share->id = content->id;
+        InterlockedIncrement(&content->readers);
+        UnmapViewOfFile(view);
+    }
+    return hr;
+}
+
+static HRESULT kmt_share_open(const LUID *luid, HANDLE handle, BOOL nt_handle,
+        struct d3d_shared_runtime *runtime_out, struct d3d_kmt_share **out)
+{
+    D3DDDI_OPENALLOCATIONINFO2 alloc_info2 = {0};
+    D3DDDI_OPENALLOCATIONINFO alloc_info = {0};
+    struct d3d_shared_runtime runtime = {0};
+    struct d3d_kmt_share *share;
+    char total[256];
+    NTSTATUS status;
+    HRESULT hr;
+
+    if (FAILED(hr = kmt_init(luid)))
+        return hr;
