+/* The adapter of the device that made a shared resource, from the private runtime data its Direct3D runtime put in
+ * the D3DKMT resource. The handle is a global share handle (a number with the bit 0x40000000) or an NT handle. */
+static HRESULT dxgi_shared_resource_luid(HANDLE handle, LUID *luid)
+{
+    struct wine_d3d_shared_header *header;
+    D3DKMT_ENUMADAPTERS2 adapters = {0};
+    D3DKMT_CREATEDEVICE device = {0};
+    BYTE runtime[512];
+    HRESULT hr = DXGI_ERROR_INVALID_CALL;
+    NTSTATUS status = (NTSTATUS)0xc0000001;
+    UINT i;
+
+    if (D3DKMTEnumAdapters2(&adapters) || !adapters.NumAdapters)
+        return hr;
+    if (!(adapters.pAdapters = calloc(adapters.NumAdapters, sizeof(*adapters.pAdapters))))
+        return E_OUTOFMEMORY;
+    if (D3DKMTEnumAdapters2(&adapters) || !adapters.NumAdapters)
+        goto done;
+
+    device.hAdapter = adapters.pAdapters[0].hAdapter;
+    if (D3DKMTCreateDevice(&device))
+        goto done;
+    if (((ULONG_PTR)handle & 0xc0000000) == 0x40000000)
+    {
+        D3DKMT_QUERYRESOURCEINFO query = {0};
+
+        query.hDevice = device.hDevice;
+        query.hGlobalShare = (UINT)(ULONG_PTR)handle;
+        query.pPrivateRuntimeData = runtime;
+        query.PrivateRuntimeDataSize = sizeof(runtime);
+        status = D3DKMTQueryResourceInfo(&query);
+        header = (struct wine_d3d_shared_header *)runtime;
+        if (!status && query.PrivateRuntimeDataSize < sizeof(*header))
+            status = (NTSTATUS)0xc0000001;
+    }
+    else
+    {
+        D3DKMT_QUERYRESOURCEINFOFROMNTHANDLE query = {0};
+
+        query.hDevice = device.hDevice;
+        query.hNtHandle = handle;
+        query.pPrivateRuntimeData = runtime;
+        query.PrivateRuntimeDataSize = sizeof(runtime);
+        status = D3DKMTQueryResourceInfoFromNtHandle(&query);
+        header = (struct wine_d3d_shared_header *)runtime;
+        if (!status && query.PrivateRuntimeDataSize < sizeof(*header))
+            status = (NTSTATUS)0xc0000001;
+    }
+    if (!status && header->magic == WINE_D3D_SHARED_MAGIC)
+    {
+        *luid = header->luid;
+        hr = S_OK;
+    }
+    {
+        D3DKMT_DESTROYDEVICE destroy = {device.hDevice};
+        D3DKMTDestroyDevice(&destroy);
+    }
+
+done:
+    for (i = 0; i < adapters.NumAdapters; ++i)
+    {
+        D3DKMT_CLOSEADAPTER close = {adapters.pAdapters[i].hAdapter};
+        D3DKMTCloseAdapter(&close);
+    }
+    free(adapters.pAdapters);
+    return hr;
+}
