diff --git a/dlls/d3d11/shared.c b/dlls/d3d11/shared.c
new file mode 100644
--- /dev/null
+++ b/dlls/d3d11/shared.c
@@ -0,0 +1,476 @@
+/*
+ * Resources shared between devices and processes, made of D3DKMT objects
+ *
+ * Copyright 2026 Stained Glass OS
+ *
