+/* Names are relative to the session's namespace of named objects, like those of CreateFileMapping. */
+static NTSTATUS get_named_object_directory(HANDLE *dir)
+{
+    NTSTATUS (WINAPI *get_directory)(HANDLE *);
+
+    get_directory = (void *)GetProcAddress(GetModuleHandleW(L"kernelbase.dll"), "BaseGetNamedObjectDirectory");
+    if (!get_directory)
+        return (NTSTATUS)0xc0000002;
+    return get_directory(dir);
+}
+
+HRESULT d3d_kmt_share_open_by_name(const LUID *luid, const WCHAR *name, DWORD access,
+        struct d3d_shared_runtime *runtime, struct d3d_kmt_share **share)
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING string;
+    HANDLE dir, section;
+    HRESULT hr;
+
+    if (!name)
+        return E_INVALIDARG;
+    if (get_named_object_directory(&dir))
+        return E_FAIL;
+    RtlInitUnicodeString(&string, name);
+    InitializeObjectAttributes(&attr, &string, 0, dir, NULL);
+    /* the block is mapped to use it, whatever access the caller names */
+    if (NtOpenSection(&section, access | SECTION_QUERY | SECTION_MAP_READ | SECTION_MAP_WRITE, &attr))
+        return E_INVALIDARG;
+    hr = kmt_share_open(luid, section, TRUE, runtime, share);
+    CloseHandle(section);
+    return hr;
+}
+
+HRESULT d3d_kmt_share_create_handle(struct d3d_kmt_share *share, const SECURITY_ATTRIBUTES *attributes,
+        DWORD access, const WCHAR *name, HANDLE *handle)
+{
+    D3DKMT_HANDLE objects[2] = {share->resource, share->mutex};
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING string;
+    NTSTATUS status;
+
+    if (!share->nt_handle)
+        return E_INVALIDARG;
+
+    InitializeObjectAttributes(&attr, NULL, 0, NULL, NULL);
+    if (attributes)
+    {
+        if (attributes->bInheritHandle)
+            attr.Attributes |= OBJ_INHERIT;
+        attr.SecurityDescriptor = attributes->lpSecurityDescriptor;
+    }
+    if (name)
+    {
+        if (get_named_object_directory(&attr.RootDirectory))
+            return E_FAIL;
+        RtlInitUnicodeString(&string, name);
+        attr.ObjectName = &string;
+    }
+    status = D3DKMTShareObjects(share->mutex ? 2 : 1, objects, &attr, access ? access : GENERIC_ALL, handle);
+    if (status == (NTSTATUS)0xc0000035)
+        return HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS);
+    return status ? E_FAIL : S_OK;
+}
+
+HRESULT d3d_kmt_share_acquire(struct d3d_kmt_share *share, UINT64 key, DWORD timeout)
+{
+    D3DKMT_ACQUIREKEYEDMUTEX acquire = {0};
+    LARGE_INTEGER time;
+
+    acquire.hKeyedMutex = share->mutex;
+    acquire.Key = key;
+    if (timeout != INFINITE)
+    {
+        time.QuadPart = -(LONGLONG)timeout * 10000;
+        acquire.pTimeout = &time;
+    }
+    return hresult_from_ntstatus(D3DKMTAcquireKeyedMutex(&acquire));
+}
+
+HRESULT d3d_kmt_share_release(struct d3d_kmt_share *share, UINT64 key)
+{
+    D3DKMT_RELEASEKEYEDMUTEX release = {0};
+
+    release.hKeyedMutex = share->mutex;
+    release.Key = key;
+    return hresult_from_ntstatus(D3DKMTReleaseKeyedMutex(&release));
+}
