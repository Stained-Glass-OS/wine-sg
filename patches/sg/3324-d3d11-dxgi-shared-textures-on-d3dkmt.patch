+/* A resource that other devices and processes can open (D3D11_RESOURCE_MISC_SHARED*), made of D3DKMT
+ * objects: a resource with its content (a version, the readers, and the pixels), and a keyed mutex. */
+struct d3d_kmt_share
+{
+    struct list entry;                  /* d3d_kmt_shares */
+    struct d3d_texture2d *texture;      /* not referenced */
+    D3DKMT_HANDLE resource, allocation, mutex;
+    UINT global_resource, global_mutex; /* legacy share handles, 0 for NT handle sharing */
+    BOOL nt_handle, creator, mutex_held;
+    UINT64 content_size;
+    UINT64 id;
+    UINT pitch;
+};
+
+/* What the runtime keeps for the resource in the D3DKMT resource: private runtime data. */
+#define D3D_SHARED_MAGIC 0x48533344   /* "D3SH", WINE_D3D_SHARED_MAGIC */
+struct d3d_shared_runtime
+{
+    UINT magic;
+    UINT type;                          /* D3D11_RESOURCE_DIMENSION */
+    LUID luid;                          /* struct wine_d3d_shared_header ends here */
+    UINT mutex_global;
+    UINT pitch;
+    UINT64 content_size;
+    D3D11_TEXTURE2D_DESC desc2d;
+};
+
+/* The content of a shared resource starts with this. */
+struct d3d_shared_content
+{
+    UINT64 version;                     /* grows with every set of pixels that is handed over */
+    UINT64 id;                          /* tells the textures of the creating process which resource it is */
+    LONG readers;                       /* the textures that opened the resource */
+    LONG pad;
+};
