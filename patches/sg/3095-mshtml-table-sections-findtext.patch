+/* the text findText looks at: the characters from a point on, one at a time as the range's text
+ * has them, up to a limit of characters and (when given) to the end of a range */
+typedef struct {
+    WCHAR *chars;
+    DWORD len;
+    DWORD size;
+} found_text_t;
+
+static BOOL found_text_add(found_text_t *text, WCHAR c)
+{
+    if(text->len == text->size) {
+        WCHAR *new_chars = realloc(text->chars, text->size * 2 * sizeof(WCHAR));
+        if(!new_chars)
+            return FALSE;
+        text->chars = new_chars;
+        text->size *= 2;
+    }
+    text->chars[text->len++] = c;
+    return TRUE;
+}
+
+/* whether a point is after the end of the range */
+static BOOL point_after_range_end(nsIDOMRange *probe, nsIDOMRange *range, const rangepoint_t *pt)
+{
+    short cmp = 0;
+
+    nsIDOMRange_SetStart(probe, pt->node, pt->off);
+    nsIDOMRange_SetEnd(probe, pt->node, pt->off);
+    nsIDOMRange_CompareBoundaryPoints(probe, NS_END_TO_END, range, &cmp);
+    return cmp > 0;
+}
+
+static BOOL is_word_char(WCHAR c)
+{
+    return iswalnum(c) || c == '_';
+}
+
 static HRESULT WINAPI HTMLTxtRange_findText(IHTMLTxtRange *iface, BSTR String,
         LONG count, LONG Flags, VARIANT_BOOL *Success)
 {
     HTMLTxtRange *This = impl_from_IHTMLTxtRange(iface);
-    FIXME("(%p)->(%s %ld %08lx %p)\n", This, debugstr_w(String), count, Flags, Success);
-    return E_NOTIMPL;
+    BOOL backward = count < 0 || (Flags & 1), collapsed, match_case = Flags & 4, whole = Flags & 2;
+#ifdef SG_MUTANT_MSHTML_FIND_ANYCASE
+    match_case = FALSE;
+#endif
+    rangepoint_t iter, from;
+    nsIDOMRange *probe = NULL;
+    found_text_t text = {NULL, 0, 256};
+    DWORD limit, len, i, found = ~0u;
+    cpp_bool is_collapsed = FALSE;
+    HRESULT hres = S_OK;
+    WCHAR c;
+
+    TRACE("(%p)->(%s %ld %08lx %p)\n", This, debugstr_w(String), count, Flags, Success);
+
+    if(!Success)
+        return E_POINTER;
+    *Success = VARIANT_FALSE;
+
+    len = String ? lstrlenW(String) : 0;
+    limit = count < 0 ? -(LONGLONG)count : count;
+    if(!len || !limit)
+        return S_OK;
+
+    nsIDOMRange_GetCollapsed(This->nsrange, &is_collapsed);
+    collapsed = is_collapsed;
+
+    /* a range with something in it is searched in, a point is searched from */
+    if(!collapsed && NS_FAILED(nsIDOMRange_CloneRange(This->nsrange, &probe)))
+        return E_FAIL;
+
+    if(!(text.chars = malloc(text.size * sizeof(WCHAR)))) {
+        if(probe) nsIDOMRange_Release(probe);
+        return E_OUTOFMEMORY;
+    }
+
+    if(backward) {
+        /* the characters before the end, last first */
+        DWORD n = 0;
+
+        get_end_point(This, &iter);
+        while(n < limit) {
+            rangepoint_t prev;
+
+            init_rangepoint(&prev, iter.node, iter.off);
+            c = move_prev_char(&iter);
+            if(!c) {
+                free_rangepoint(&prev);
+                break;
+            }
+            if(probe) {
+                /* before the start of the range: stop */
+                short cmp = 0;
+                nsIDOMRange_SetStart(probe, iter.node, iter.off);
+                nsIDOMRange_SetEnd(probe, iter.node, iter.off);
+                nsIDOMRange_CompareBoundaryPoints(probe, NS_START_TO_START, This->nsrange, &cmp);
+                if(cmp < 0) {
+                    free_rangepoint(&iter);
+                    iter = prev;
+                    break;
+                }
+            }
+            free_rangepoint(&prev);
+            if(!found_text_add(&text, c)) { hres = E_OUTOFMEMORY; break; }
+            n++;
+        }
+        from = iter;                    /* the leftmost point reached */
+        for(i = 0; i < text.len / 2; i++) {
+            WCHAR tmp = text.chars[i];
+            text.chars[i] = text.chars[text.len - 1 - i];
+            text.chars[text.len - 1 - i] = tmp;
+        }
+    }else {
+        DWORD n = 0;
+
+        get_start_point(This, &from);
+        init_rangepoint(&iter, from.node, from.off);
+        while(n < limit) {
+            rangepoint_t before;
+
+            init_rangepoint(&before, iter.node, iter.off);
+            c = move_next_char(&iter);
+            if(!c) {
+                free_rangepoint(&before);
+                break;
+            }
+            if(probe && point_after_range_end(probe, This->nsrange, &iter)) {
+                free_rangepoint(&iter);
+                iter = before;
+                break;
+            }
+            free_rangepoint(&before);
+            if(!found_text_add(&text, c)) { hres = E_OUTOFMEMORY; break; }
+            n++;
+        }
+        free_rangepoint(&iter);
+    }
+    if(probe)
+        nsIDOMRange_Release(probe);
+
+    if(SUCCEEDED(hres) && text.len >= len) {
+        for(i = 0; i + len <= text.len; i++) {
+            DWORD k = backward ? text.len - len - i : i;
+            DWORD j;
+
+            for(j = 0; j < len; j++) {
+                WCHAR a = text.chars[k + j], b = String[j];
+                if(match_case ? a != b : towlower(a) != towlower(b))
+                    break;
+            }
+            if(j < len)
+                continue;
+            if(whole && ((k && is_word_char(text.chars[k - 1])) ||
+                         (k + len < text.len && is_word_char(text.chars[k + len]))))
+                continue;
+            found = k;
+            break;
+        }
+    }
+
+    if(found != ~0u) {
+        rangepoint_t start, end;
+
+        init_rangepoint(&start, from.node, from.off);
+        move_by_chars(&start, found);
+        init_rangepoint(&end, start.node, start.off);
+        move_by_chars(&end, len);
+
+        set_start_point(This, &start);
+        set_end_point(This, &end);
+        free_rangepoint(&start);
+        free_rangepoint(&end);
+        *Success = VARIANT_TRUE;
+    }
+
+    free_rangepoint(&from);
+    free(text.chars);
+    return hres;
 }
 
