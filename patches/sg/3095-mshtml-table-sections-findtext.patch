+/* a section or caption of the table, from the element Gecko has for it */
+static HRESULT table_part(nsIDOMHTMLElement *nselem, REFIID riid, void **ret)
+{
+    HTMLDOMNode *node;
+    HRESULT hres;
+
+    *ret = NULL;
+    if(!nselem)
+        return S_OK;
+#ifdef SG_MUTANT_MSHTML_NO_PART
+    return S_OK;
+#endif
+
+    hres = get_node((nsIDOMNode*)nselem, TRUE, &node);
+    if(FAILED(hres))
+        return hres;
+    hres = IHTMLDOMNode_QueryInterface(&node->IHTMLDOMNode_iface, riid, ret);
+    IHTMLDOMNode_Release(&node->IHTMLDOMNode_iface);
+    return hres;
+}
