+/* the element children of a node with a tag name (a section's rows) */
+IHTMLElementCollection *create_collection_from_children(nsIDOMNode *parent, const WCHAR *tag, DispatchEx *owner)
+{
+    nsIDOMNodeList *nslist;
+    elem_vector_t buf = {NULL, 0, 8};
+    UINT32 length = 0, i;
+    HTMLDOMNode *node;
+    nsresult nsres;
+    HRESULT hres;
+
+    nsres = nsIDOMNode_GetChildNodes(parent, &nslist);
+    if(NS_FAILED(nsres))
+        return NULL;
+    if(!(buf.buf = malloc(buf.size * sizeof(*buf.buf)))) {
+        nsIDOMNodeList_Release(nslist);
+        return NULL;
+    }
+    nsIDOMNodeList_GetLength(nslist, &length);
+
+    for(i = 0; i < length; i++) {
+        nsIDOMNode *nsnode;
+        nsAString name_str;
+        const PRUnichar *name;
+        UINT16 type = 0;
+        BOOL match = FALSE;
+
+        nsIDOMNodeList_Item(nslist, i, &nsnode);
+        if(!nsnode)
+            continue;
+        nsIDOMNode_GetNodeType(nsnode, &type);
+        if(type == ELEMENT_NODE) {
+            nsAString_Init(&name_str, NULL);
+            nsres = nsIDOMNode_GetNodeName(nsnode, &name_str);
+            if(NS_SUCCEEDED(nsres)) {
+                nsAString_GetData(&name_str, &name);
+                match = !wcsicmp(name, tag);
+            }
+            nsAString_Finish(&name_str);
+        }
+        if(match) {
+            hres = get_node(nsnode, TRUE, &node);
+            if(SUCCEEDED(hres))
+                elem_vector_add(&buf, elem_from_HTMLDOMNode(node));
+        }
+        nsIDOMNode_Release(nsnode);
+    }
+    nsIDOMNodeList_Release(nslist);
+
+    elem_vector_normalize(&buf);
+    return HTMLElementCollection_Create(buf.buf, buf.len, owner);
+}
