+static HRESULT WINAPI HTMLTableSection_insertRow(IHTMLTableSection *iface, LONG index, IDispatch **row)
+{
+    HTMLTableSection *This = impl_from_IHTMLTableSection(iface);
+    nsIDOMNode *ref = NULL, *inserted = NULL;
+    IHTMLElementCollection *rows;
+    HTMLElement *new_row;
+    LONG count = 0;
+    nsresult nsres;
+    HRESULT hres;
+
+    TRACE("(%p)->(%ld %p)\n", This, index, row);
+
+    if(!row)
+        return E_POINTER;
+    *row = NULL;
+
+    hres = IHTMLTableSection_get_rows(iface, &rows);
+    if(FAILED(hres))
+        return hres;
+    IHTMLElementCollection_get_length(rows, &count);
+
+    if(index < -1 || index > count) {
+        IHTMLElementCollection_Release(rows);
+        return E_INVALIDARG;
+    }
+    if(index != -1 && index < count) {
+        VARIANT idx, nil;
+        IDispatch *disp = NULL;
+
+        V_VT(&idx) = VT_I4;
+        V_I4(&idx) = index;
+        V_VT(&nil) = VT_EMPTY;
+        hres = IHTMLElementCollection_item(rows, idx, nil, &disp);
+        if(SUCCEEDED(hres) && disp) {
+            IHTMLDOMNode *dom_node;
+            if(SUCCEEDED(IDispatch_QueryInterface(disp, &IID_IHTMLDOMNode, (void**)&dom_node))) {
+                HTMLDOMNode *node = unsafe_impl_from_IHTMLDOMNode(dom_node);
+                ref = node->nsnode;
+                nsIDOMNode_AddRef(ref);
+                IHTMLDOMNode_Release(dom_node);
+            }
+            IDispatch_Release(disp);
+        }
+    }
+    IHTMLElementCollection_Release(rows);
+
+    hres = create_element(This->element.node.doc, L"tr", &new_row);
+    if(FAILED(hres)) {
+        if(ref) nsIDOMNode_Release(ref);
+        return hres;
+    }
+
+    nsres = nsIDOMNode_InsertBefore(This->element.node.nsnode, new_row->node.nsnode, ref, &inserted);
+    if(ref) nsIDOMNode_Release(ref);
+    if(inserted) nsIDOMNode_Release(inserted);
+    if(NS_FAILED(nsres)) {
+        ERR("InsertBefore failed: %08lx\n", nsres);
+        IHTMLElement_Release(&new_row->IHTMLElement_iface);
+        return E_FAIL;
+    }
+
+    *row = (IDispatch*)&new_row->IHTMLElement_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLTableSection_deleteRow(IHTMLTableSection *iface, LONG index)
+{
+    HTMLTableSection *This = impl_from_IHTMLTableSection(iface);
+    IHTMLElementCollection *rows;
+    IDispatch *disp = NULL;
+    IHTMLDOMNode *dom_node;
+    nsIDOMNode *removed = NULL;
+    VARIANT idx, nil;
+    LONG count = 0;
+    nsresult nsres;
+    HRESULT hres;
+
+    TRACE("(%p)->(%ld)\n", This, index);
+
+    hres = IHTMLTableSection_get_rows(iface, &rows);
+    if(FAILED(hres))
+        return hres;
+    IHTMLElementCollection_get_length(rows, &count);
+
+    if(index == -1)
+        index = count - 1;
+    if(index < -1 || index >= count) {
+        IHTMLElementCollection_Release(rows);
+        /* deleting the last of none does nothing */
+        return count || index != -1 ? E_INVALIDARG : S_OK;
+    }
+
+    V_VT(&idx) = VT_I4;
+    V_I4(&idx) = index;
+    V_VT(&nil) = VT_EMPTY;
+    hres = IHTMLElementCollection_item(rows, idx, nil, &disp);
+    IHTMLElementCollection_Release(rows);
+    if(FAILED(hres) || !disp)
+        return FAILED(hres) ? hres : E_FAIL;
+
+    hres = IDispatch_QueryInterface(disp, &IID_IHTMLDOMNode, (void**)&dom_node);
+    IDispatch_Release(disp);
+    if(FAILED(hres))
+        return hres;
+
+    nsres = nsIDOMNode_RemoveChild(This->element.node.nsnode, unsafe_impl_from_IHTMLDOMNode(dom_node)->nsnode, &removed);
+    IHTMLDOMNode_Release(dom_node);
+    if(removed) nsIDOMNode_Release(removed);
+    return NS_SUCCEEDED(nsres) ? S_OK : E_FAIL;
+}
