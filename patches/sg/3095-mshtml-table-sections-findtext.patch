+    TRACE("(%p)->(%p)\n", This, p);
+
+    if(!p)
+        return E_POINTER;
+
+    nsres = nsIDOMHTMLTableElement_GetTHead(This->nstable, &nselem);
+    if(NS_FAILED(nsres)) {
+        ERR("GetTHead failed: %08lx\n", nsres);
+        return E_FAIL;
+    }
+
+    hres = table_part(nselem, &IID_IHTMLTableSection, (void**)p);
+    if(nselem)
+        nsIDOMHTMLElement_Release(nselem);
+    return hres;
 }
 
