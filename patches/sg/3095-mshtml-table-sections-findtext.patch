+static HRESULT WINAPI HTMLTableSection_get_rows(IHTMLTableSection *iface, IHTMLElementCollection **p)
+{
+    HTMLTableSection *This = impl_from_IHTMLTableSection(iface);
+
+    TRACE("(%p)->(%p)\n", This, p);
