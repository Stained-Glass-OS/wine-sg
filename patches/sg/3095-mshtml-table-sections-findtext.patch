+#define test_table_section_rows(a,b) _test_table_section_rows(__LINE__,a,b)
+static void _test_table_section_rows(unsigned line, IHTMLTableSection *section, LONG expected)
+{
+    IHTMLElementCollection *col = NULL;
+    LONG len = -1;
+    HRESULT hres;
+
+    hres = IHTMLTableSection_get_rows(section, &col);
+    ok_(__FILE__,line)(hres == S_OK, "get_rows failed: %08lx\n", hres);
+    if(FAILED(hres))
+        return;
+    hres = IHTMLElementCollection_get_length(col, &len);
+    ok_(__FILE__,line)(hres == S_OK, "get_length failed: %08lx\n", hres);
+    ok_(__FILE__,line)(len == expected, "rows length = %ld, expected %ld\n", len, expected);
+    IHTMLElementCollection_Release(col);
+}
+
+static HRESULT table_get_part(IHTMLTable *table, BOOL head, IHTMLTableSection **section)
+{
+    return head ? IHTMLTable_get_tHead(table, section) : IHTMLTable_get_tFoot(table, section);
+}
+
+static HRESULT table_create_part(IHTMLTable *table, BOOL head, IDispatch **disp)
+{
+    return head ? IHTMLTable_createTHead(table, disp) : IHTMLTable_createTFoot(table, disp);
+}
+
+static HRESULT table_delete_part(IHTMLTable *table, BOOL head)
+{
+    return head ? IHTMLTable_deleteTHead(table) : IHTMLTable_deleteTFoot(table);
+}
+
+static void test_table_part_section(IHTMLTable *table, BOOL head)
+{
+    const WCHAR *tag = head ? L"THEAD" : L"TFOOT";
+    IHTMLTableSection *section, *section2;
+    IDispatch *disp, *row1, *row2;
+    IHTMLTableRow *tr;
+    BSTR bstr;
+    VARIANT v;
+    HRESULT hres;
+
+    section = (void*)0xdeadbeef;
+    hres = table_get_part(table, head, &section);
+    ok(hres == S_OK, "%s get failed: %08lx\n", wine_dbgstr_w(tag), hres);
+    ok(!section, "%s = %p, expected NULL\n", wine_dbgstr_w(tag), section);
+
+    hres = table_create_part(table, head, &disp);
+    ok(hres == S_OK, "%s create failed: %08lx\n", wine_dbgstr_w(tag), hres);
+    test_elem_tag((IUnknown*)disp, tag);
+    hres = IDispatch_QueryInterface(disp, &IID_IHTMLTableSection, (void**)&section);
+    ok(hres == S_OK, "QI(IHTMLTableSection) failed: %08lx\n", hres);
+    IDispatch_Release(disp);
+
+    hres = table_get_part(table, head, &section2);
+    ok(hres == S_OK && section2, "%s get failed: %08lx\n", wine_dbgstr_w(tag), hres);
+    ok(iface_cmp((IUnknown*)section, (IUnknown*)section2), "section != section2\n");
+    IHTMLTableSection_Release(section2);
+
+    hres = table_create_part(table, head, &disp);
+    ok(hres == S_OK, "%s create failed: %08lx\n", wine_dbgstr_w(tag), hres);
+    ok(iface_cmp((IUnknown*)section, (IUnknown*)disp), "create again did not return the same section\n");
+    IDispatch_Release(disp);
+
+    test_table_section_rows(section, 0);
+
+    hres = IHTMLTableSection_insertRow(section, -1, &row1);
+    ok(hres == S_OK, "insertRow failed: %08lx\n", hres);
+    test_elem_tag((IUnknown*)row1, L"TR");
+    hres = IDispatch_QueryInterface(row1, &IID_IHTMLTableRow, (void**)&tr);
+    ok(hres == S_OK, "QI(IHTMLTableRow) failed: %08lx\n", hres);
+    IHTMLTableRow_Release(tr);
+    hres = IHTMLTableSection_insertRow(section, 0, &row2);
+    ok(hres == S_OK, "insertRow failed: %08lx\n", hres);
+    test_table_section_rows(section, 2);
+    disp = NULL;
+    {
+        IHTMLElementCollection *col;
+        VARIANT idx, nil;
+
+        hres = IHTMLTableSection_get_rows(section, &col);
+        ok(hres == S_OK, "get_rows failed: %08lx\n", hres);
+        V_VT(&idx) = VT_I4;
+        V_I4(&idx) = 0;
+        V_VT(&nil) = VT_EMPTY;
+        hres = IHTMLElementCollection_item(col, idx, nil, &disp);
+        ok(hres == S_OK && disp, "item failed: %08lx\n", hres);
+        ok(iface_cmp((IUnknown*)disp, (IUnknown*)row2), "row inserted at 0 is not the first row\n");
+        if(disp) IDispatch_Release(disp);
+        IHTMLElementCollection_Release(col);
+    }
+    IDispatch_Release(row1);
+    IDispatch_Release(row2);
+
+    hres = IHTMLTableSection_insertRow(section, 3, &disp);
+    ok(hres == E_INVALIDARG, "insertRow(3) returned %08lx\n", hres);
+    hres = IHTMLTableSection_deleteRow(section, 2);
+    ok(hres == E_INVALIDARG, "deleteRow(2) returned %08lx\n", hres);
+    hres = IHTMLTableSection_deleteRow(section, -1);
+    ok(hres == S_OK, "deleteRow(-1) failed: %08lx\n", hres);
+    test_table_section_rows(section, 1);
+    hres = IHTMLTableSection_deleteRow(section, 0);
+    ok(hres == S_OK, "deleteRow(0) failed: %08lx\n", hres);
+    test_table_section_rows(section, 0);
+
+    bstr = SysAllocString(L"center");
+    hres = IHTMLTableSection_put_align(section, bstr);
+    ok(hres == S_OK, "put_align failed: %08lx\n", hres);
+    SysFreeString(bstr);
+    hres = IHTMLTableSection_get_align(section, &bstr);
+    ok(hres == S_OK, "get_align failed: %08lx\n", hres);
+    ok(!lstrcmpW(bstr, L"center"), "align = %s\n", wine_dbgstr_w(bstr));
+    SysFreeString(bstr);
+
+    bstr = SysAllocString(L"top");
+    hres = IHTMLTableSection_put_vAlign(section, bstr);
+    ok(hres == S_OK, "put_vAlign failed: %08lx\n", hres);
+    SysFreeString(bstr);
+    hres = IHTMLTableSection_get_vAlign(section, &bstr);
+    ok(hres == S_OK, "get_vAlign failed: %08lx\n", hres);
+    ok(!lstrcmpW(bstr, L"top"), "vAlign = %s\n", wine_dbgstr_w(bstr));
+    SysFreeString(bstr);
+
+    V_VT(&v) = VT_BSTR;
+    V_BSTR(&v) = SysAllocString(L"#ff0000");
+    hres = IHTMLTableSection_put_bgColor(section, v);
+    ok(hres == S_OK, "put_bgColor failed: %08lx\n", hres);
+    VariantClear(&v);
+    VariantInit(&v);
+    hres = IHTMLTableSection_get_bgColor(section, &v);
+    ok(hres == S_OK, "get_bgColor failed: %08lx\n", hres);
+    ok(V_VT(&v) == VT_BSTR && !lstrcmpW(V_BSTR(&v), L"#ff0000"), "bgColor = %s\n", wine_dbgstr_variant(&v));
+    VariantClear(&v);
+
+    IHTMLTableSection_Release(section);
+
+    hres = table_delete_part(table, head);
+    ok(hres == S_OK, "delete failed: %08lx\n", hres);
+    section = (void*)0xdeadbeef;
+    hres = table_get_part(table, head, &section);
+    ok(hres == S_OK && !section, "%s after delete: %08lx %p\n", wine_dbgstr_w(tag), hres, section);
+}
+
+static void test_table_sections(IHTMLTable *orig)
+{
+    IHTMLDOMNode *node = clone_node((IUnknown*)orig, VARIANT_TRUE);
+    IHTMLElementCollection *col;
+    IHTMLTableCaption *caption, *caption2;
+    IHTMLTableSection *section;
+    IHTMLTable *table;
+    IDispatch *disp;
+    BSTR bstr;
+    HRESULT hres;
+
+    hres = IHTMLDOMNode_QueryInterface(node, &IID_IHTMLTable, (void**)&table);
+    ok(hres == S_OK, "QI(IHTMLTable) failed: %08lx\n", hres);
+    IHTMLDOMNode_Release(node);
+
+    test_table_part_section(table, TRUE);
+    test_table_part_section(table, FALSE);
+
+    /* the body */
+    hres = IHTMLTable_get_tBodies(table, &col);
+    ok(hres == S_OK, "get_tBodies failed: %08lx\n", hres);
+    {
+        VARIANT idx, nil;
+        V_VT(&idx) = VT_I4;
+        V_I4(&idx) = 0;
+        V_VT(&nil) = VT_EMPTY;
+        hres = IHTMLElementCollection_item(col, idx, nil, &disp);
+        ok(hres == S_OK && disp, "item failed: %08lx\n", hres);
+    }
+    IHTMLElementCollection_Release(col);
+    test_elem_tag((IUnknown*)disp, L"TBODY");
+    hres = IDispatch_QueryInterface(disp, &IID_IHTMLTableSection, (void**)&section);
+    ok(hres == S_OK, "QI(IHTMLTableSection) for tbody failed: %08lx\n", hres);
+    IDispatch_Release(disp);
+    if(section) {
+        test_table_section_rows(section, 2);
+        IHTMLTableSection_Release(section);
+    }
+
+    /* the caption */
+    caption = (void*)0xdeadbeef;
+    hres = IHTMLTable_get_caption(table, &caption);
+    ok(hres == S_OK && !caption, "caption before create: %08lx %p\n", hres, caption);
+    hres = IHTMLTable_createCaption(table, &caption);
+    ok(hres == S_OK && caption, "createCaption failed: %08lx\n", hres);
+    test_elem_tag((IUnknown*)caption, L"CAPTION");
+    hres = IHTMLTable_get_caption(table, &caption2);
+    ok(hres == S_OK && caption2, "get_caption failed: %08lx\n", hres);
+    ok(iface_cmp((IUnknown*)caption, (IUnknown*)caption2), "caption != caption2\n");
+    IHTMLTableCaption_Release(caption2);
+
+    bstr = SysAllocString(L"bottom");
+    hres = IHTMLTableCaption_put_vAlign(caption, bstr);
+    ok(hres == S_OK, "put_vAlign failed: %08lx\n", hres);
+    SysFreeString(bstr);
+    hres = IHTMLTableCaption_get_vAlign(caption, &bstr);
+    ok(hres == S_OK && !lstrcmpW(bstr, L"bottom"), "vAlign = %08lx %s\n", hres, wine_dbgstr_w(bstr));
+    SysFreeString(bstr);
+    bstr = SysAllocString(L"right");
+    hres = IHTMLTableCaption_put_align(caption, bstr);
+    ok(hres == S_OK, "put_align failed: %08lx\n", hres);
+    SysFreeString(bstr);
+    hres = IHTMLTableCaption_get_align(caption, &bstr);
+    ok(hres == S_OK && !lstrcmpW(bstr, L"right"), "align = %08lx %s\n", hres, wine_dbgstr_w(bstr));
+    SysFreeString(bstr);
+    IHTMLTableCaption_Release(caption);
+
+    hres = IHTMLTable_deleteCaption(table);
+    ok(hres == S_OK, "deleteCaption failed: %08lx\n", hres);
+    caption = (void*)0xdeadbeef;
+    hres = IHTMLTable_get_caption(table, &caption);
+    ok(hres == S_OK && !caption, "caption after delete: %08lx %p\n", hres, caption);
+
+    IHTMLTable_Release(table);
+}
