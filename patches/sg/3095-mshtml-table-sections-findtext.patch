+static HRESULT WINAPI HTMLTableSection_put_bgColor(IHTMLTableSection *iface, VARIANT v)
+{
+    HTMLTableSection *This = impl_from_IHTMLTableSection(iface);
+    nsAString name, val;
+    nsresult nsres;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_variant(&v));
+
+    if(!variant_to_nscolor(&v, &val))
+        return S_OK;
+
+    nsAString_InitDepend(&name, L"bgcolor");
+    nsres = nsIDOMElement_SetAttribute(This->element.dom_element, &name, &val);
+    nsAString_Finish(&name);
+    nsAString_Finish(&val);
+    return NS_SUCCEEDED(nsres) ? S_OK : E_FAIL;
+}
+
+static HRESULT WINAPI HTMLTableSection_get_bgColor(IHTMLTableSection *iface, VARIANT *p)
+{
+    HTMLTableSection *This = impl_from_IHTMLTableSection(iface);
+    const PRUnichar *color;
+    nsAString val;
+    nsresult nsres;
+    HRESULT hres = S_OK;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    if(!p)
+        return E_POINTER;
+
+    nsres = get_elem_attr_value(This->element.dom_element, L"bgcolor", &val, &color);
+    if(NS_FAILED(nsres))
+        return E_FAIL;
+
+    V_VT(p) = VT_BSTR;
+    if(*color)
+        hres = nscolor_to_str(color, &V_BSTR(p));
+    else
+        V_BSTR(p) = NULL;
+    nsAString_Finish(&val);
+    return hres;
+}
