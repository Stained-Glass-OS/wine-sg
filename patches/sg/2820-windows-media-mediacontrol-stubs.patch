+/* A string property: get hands out a copy, put keeps one (NULL is the empty string). */
+static HRESULT get_string_property( HSTRING stored, HSTRING *value )
+{
+    if (!value) return E_POINTER;
+    return WindowsDuplicateString( stored, value );
+}
+
+static HRESULT put_string_property( HSTRING *stored, HSTRING value )
+{
+    HSTRING copy;
+    HRESULT hr;
+
+    if (FAILED( hr = WindowsDuplicateString( value, &copy ) )) return hr;
+    WindowsDeleteString( *stored );
+    *stored = copy;
+    return S_OK;
 }
 
