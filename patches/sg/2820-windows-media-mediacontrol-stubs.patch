+static HRESULT music_properties_create( struct music_properties **out )
+{
+    struct music_properties *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->IMusicDisplayProperties_iface.lpVtbl = &music_properties_vtbl;
+    impl->IMusicDisplayProperties2_iface.lpVtbl = &music_properties2_vtbl;
+    impl->ref = 1;
+    if (FAILED( hr = hstring_vector_create( &impl->genres ) ))
+    {
+        free( impl );
+        return hr;
+    }
+    *out = impl;
+    return S_OK;
+}
+
+static void music_properties_clear( struct music_properties *impl )
+{
+    WindowsDeleteString( impl->title );
