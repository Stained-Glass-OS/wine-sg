+/* Make room for one more element at position index; the vector is locked. */
+static HRESULT vec_reserve( struct hs_vector *impl )
+{
+    if (impl->size == impl->capacity)
+    {
+        UINT32 capacity = impl->capacity ? impl->capacity * 2 : 4;
+        HSTRING *items = realloc( impl->items, capacity * sizeof(*items) );
+        if (!items) return E_OUTOFMEMORY;
+        impl->items = items;
+        impl->capacity = capacity;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_SetAt( IVector_HSTRING *iface, UINT32 index, HSTRING value )
+{
+    struct hs_vector *impl = impl_from_IVector_HSTRING( iface );
+    HSTRING copy;
+    HRESULT hr;
+
+    TRACE( "iface %p, index %u, value %s.\n", iface, index, debugstr_hstring( value ) );
+
+    EnterCriticalSection( &impl->cs );
+    if (index >= impl->size) hr = E_BOUNDS;
+    else if (SUCCEEDED( hr = WindowsDuplicateString( value, &copy ) ))
+    {
+        WindowsDeleteString( impl->items[index] );
+        impl->items[index] = copy;
+        impl->version++;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI vector_InsertAt( IVector_HSTRING *iface, UINT32 index, HSTRING value )
+{
+    struct hs_vector *impl = impl_from_IVector_HSTRING( iface );
+    HSTRING copy;
+    HRESULT hr;
+
+    TRACE( "iface %p, index %u, value %s.\n", iface, index, debugstr_hstring( value ) );
+
+    EnterCriticalSection( &impl->cs );
+    if (index > impl->size) hr = E_BOUNDS;
+    else if (SUCCEEDED( hr = WindowsDuplicateString( value, &copy ) ))
+    {
+        if (FAILED( hr = vec_reserve( impl ) )) WindowsDeleteString( copy );
+        else
+        {
+            memmove( impl->items + index + 1, impl->items + index, (impl->size - index) * sizeof(*impl->items) );
+            impl->items[index] = copy;
+            impl->size++;
+            impl->version++;
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI vector_RemoveAt( IVector_HSTRING *iface, UINT32 index )
+{
+    struct hs_vector *impl = impl_from_IVector_HSTRING( iface );
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, index %u.\n", iface, index );
+
+    EnterCriticalSection( &impl->cs );
+    if (index >= impl->size) hr = E_BOUNDS;
+    else
+    {
+        WindowsDeleteString( impl->items[index] );
+        memmove( impl->items + index, impl->items + index + 1, (impl->size - index - 1) * sizeof(*impl->items) );
+        impl->size--;
+        impl->version++;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI vector_Append( IVector_HSTRING *iface, HSTRING value )
+{
+    struct hs_vector *impl = impl_from_IVector_HSTRING( iface );
+    UINT32 size;
+
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+
+    EnterCriticalSection( &impl->cs );
+    size = impl->size;
+    LeaveCriticalSection( &impl->cs );
+    return vector_InsertAt( iface, size, value );
+}
+
+static HRESULT WINAPI vector_RemoveAtEnd( IVector_HSTRING *iface )
+{
+    struct hs_vector *impl = impl_from_IVector_HSTRING( iface );
+    UINT32 size;
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &impl->cs );
