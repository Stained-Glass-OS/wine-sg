+static HRESULT WINAPI vector_ReplaceAll( IVector_HSTRING *iface, UINT32 count, HSTRING *items )
+{
+    struct hs_vector *impl = impl_from_IVector_HSTRING( iface );
+    HRESULT hr = S_OK;
+    UINT32 i;
+
+    TRACE( "iface %p, count %u, items %p.\n", iface, count, items );
+
+    if (count && !items) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    vec_clear( impl );
+    for (i = 0; i < count && SUCCEEDED( hr ); i++)
+    {
+        HSTRING copy;
+        if (SUCCEEDED( hr = WindowsDuplicateString( items[i], &copy ) ))
+        {
+            if (FAILED( hr = vec_reserve( impl ) )) WindowsDeleteString( copy );
+            else impl->items[impl->size++] = copy;
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
