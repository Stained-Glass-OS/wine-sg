+/* Event sources: handlers kept with the token handed to the caller. The
+ * source is never raised: the system raises ButtonPressed and PropertyChanged,
+ * and there is no system media UI here. */
+struct handler
+{
+    struct list entry;
+    EventRegistrationToken token;
+    IUnknown *handler;
+};
+
+static SRWLOCK event_lock = SRWLOCK_INIT;
+static LONG64 next_token;
+
+static HRESULT event_add( struct list *list, IUnknown *handler, EventRegistrationToken *token )
+{
+    struct handler *entry;
+
+    if (!token) return E_POINTER;
+    token->value = 0;
+    if (!handler) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    entry->handler = handler;
+    IUnknown_AddRef( handler );
+    entry->token.value = InterlockedIncrement64( &next_token );
+    AcquireSRWLockExclusive( &event_lock );
+    list_add_tail( list, &entry->entry );
+    ReleaseSRWLockExclusive( &event_lock );
+    *token = entry->token;
+    return S_OK;
+}
+
+/* Removing a token that is not registered is not an error. */
+static HRESULT event_remove( struct list *list, EventRegistrationToken token )
+{
+    struct handler *entry;
+
+    AcquireSRWLockExclusive( &event_lock );
+    LIST_FOR_EACH_ENTRY( entry, list, struct handler, entry )
+    {
+#ifdef SG_MUTANT_MC_EVENT_REMOVE
+        break;
+#endif
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        ReleaseSRWLockExclusive( &event_lock );
+        IUnknown_Release( entry->handler );
+        free( entry );
+        return S_OK;
+    }
+    ReleaseSRWLockExclusive( &event_lock );
+    return S_OK;
+}
+
+static void event_clear( struct list *list )
+{
+    struct handler *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, list, struct handler, entry )
+    {
+        list_remove( &entry->entry );
+        IUnknown_Release( entry->handler );
+        free( entry );
+    }
+}
