diff --git a/dlls/windows.media.mediacontrol/vector.c b/dlls/windows.media.mediacontrol/vector.c
new file mode 100644
index 0000000..0aeac68
--- /dev/null
+++ b/dlls/windows.media.mediacontrol/vector.c
@@ -0,0 +1,740 @@
+/* IVector<HSTRING> for the Genres lists of the display properties.
+ *
+ * The vector, its (live) view and its iterator follow the documented
+ * Windows.Foundation.Collections contracts: out-of-range indexes are
+ * E_BOUNDS, and an iterator whose vector was modified after it was created
+ * fails with E_CHANGED_STATE.
+ */
+
+#include "private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mediacontrol);
+
+struct hs_vector
+{
+    IVector_HSTRING IVector_HSTRING_iface;
+    IIterable_HSTRING IIterable_HSTRING_iface;
+    LONG ref;
+
+    CRITICAL_SECTION cs;
+    HSTRING *items;
+    UINT32 size, capacity;
+    UINT32 version;
+};
+
+struct hs_view
+{
+    IVectorView_HSTRING IVectorView_HSTRING_iface;
+    IIterable_HSTRING IIterable_HSTRING_iface;
+    LONG ref;
+    struct hs_vector *vec;
+};
+
+struct hs_iterator
+{
+    IIterator_HSTRING IIterator_HSTRING_iface;
+    LONG ref;
+    struct hs_vector *vec;
+    UINT32 index, version;
+};
+
+static const WCHAR vector_class[] = L"Windows.Foundation.Collections.IVector`1<String>";
+static const WCHAR view_class[] = L"Windows.Foundation.Collections.IVectorView`1<String>";
+static const WCHAR iterator_class[] = L"Windows.Foundation.Collections.IIterator`1<String>";
+
+static inline struct hs_vector *impl_from_IVector_HSTRING( IVector_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct hs_vector, IVector_HSTRING_iface );
+}
+static inline struct hs_view *impl_from_IVectorView_HSTRING( IVectorView_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct hs_view, IVectorView_HSTRING_iface );
+}
+static inline struct hs_iterator *impl_from_IIterator_HSTRING( IIterator_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct hs_iterator, IIterator_HSTRING_iface );
+}
+
+/* Shared element operations, on the locked vector. */
+static HRESULT vec_get_at( struct hs_vector *vec, UINT32 index, HSTRING *value )
+{
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    EnterCriticalSection( &vec->cs );
+    if (index >= vec->size) hr = E_BOUNDS;
+    else hr = WindowsDuplicateString( vec->items[index], value );
+    LeaveCriticalSection( &vec->cs );
+    return hr;
+}
+
+static HRESULT vec_index_of( struct hs_vector *vec, HSTRING element, UINT32 *index, BOOLEAN *found )
+{
+    UINT32 i;
+
+    if (!index || !found) return E_POINTER;
+    *index = 0;
+    *found = FALSE;
+    EnterCriticalSection( &vec->cs );
+    for (i = 0; i < vec->size; i++)
+    {
+        INT32 cmp;
+        if (SUCCEEDED( WindowsCompareStringOrdinal( vec->items[i], element, &cmp ) ) && !cmp)
+        {
+            *index = i;
+            *found = TRUE;
+            break;
+        }
+    }
+    LeaveCriticalSection( &vec->cs );
+    return S_OK;
+}
+
+static HRESULT vec_get_many( struct hs_vector *vec, UINT32 start, UINT32 items_size, HSTRING *items, UINT32 *count )
+{
+    HRESULT hr = S_OK;
+    UINT32 i, n = 0;
+
+    if (!count) return E_POINTER;
+    *count = 0;
+    EnterCriticalSection( &vec->cs );
+    if (start > vec->size) hr = E_BOUNDS;
+    else
+    {
+        if (!items && items_size) hr = E_POINTER;
+        for (i = start; SUCCEEDED( hr ) && i < vec->size && n < items_size; i++, n++)
+            hr = WindowsDuplicateString( vec->items[i], &items[n] );
+        if (FAILED( hr )) while (n--) WindowsDeleteString( items[n] ), items[n] = NULL;
+        else *count = n;
+    }
+    LeaveCriticalSection( &vec->cs );
+    return hr;
+}
+
+/* Iterator */
+
+static HRESULT WINAPI iterator_QueryInterface( IIterator_HSTRING *iface, REFIID iid, void **out )
+{
+    struct hs_iterator *impl = impl_from_IIterator_HSTRING( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterator_HSTRING ))
+    {
+        *out = &impl->IIterator_HSTRING_iface;
+        IIterator_HSTRING_AddRef( *out );
+        return S_OK;
+    }
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI iterator_AddRef( IIterator_HSTRING *iface )
+{
+    struct hs_iterator *impl = impl_from_IIterator_HSTRING( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI iterator_Release( IIterator_HSTRING *iface )
+{
+    struct hs_iterator *impl = impl_from_IIterator_HSTRING( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IVector_HSTRING_Release( &impl->vec->IVector_HSTRING_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI iterator_GetIids( IIterator_HSTRING *iface, ULONG *count, IID **iids )
+{
+    TRACE( "iface %p, count %p, iids %p.\n", iface, count, iids );
+    return SG_GET_IIDS( count, iids, &IID_IIterator_HSTRING );
+}
+
+static HRESULT WINAPI iterator_GetRuntimeClassName( IIterator_HSTRING *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return sg_class_name( iterator_class, class_name );
+}
+
+static HRESULT WINAPI iterator_GetTrustLevel( IIterator_HSTRING *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    return sg_get_trust_level( trust_level );
+}
+
