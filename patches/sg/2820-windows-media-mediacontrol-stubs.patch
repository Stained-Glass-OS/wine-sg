+/* IInspectable::GetIids: a CoTaskMem copy of the interfaces an object answers to. */
+static inline HRESULT sg_get_iids( ULONG *count, IID **iids, const GUID *const *list, ULONG n )
+{
+    IID *out;
+    ULONG i;
+
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = NULL;
+#ifdef SG_MUTANT_MC_IIDS
+    if (n > 1) n--;
+#endif
+    if (!(out = CoTaskMemAlloc( n * sizeof(*out) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < n; i++) out[i] = *list[i];
+    *count = n;
+    *iids = out;
+    return S_OK;
+}
+#define SG_GET_IIDS( count, iids, ... ) \
+    sg_get_iids( count, iids, (const GUID *const[]){ __VA_ARGS__ }, ARRAY_SIZE( ((const GUID *const[]){ __VA_ARGS__ }) ) )
+
+static inline HRESULT sg_get_trust_level( TrustLevel *trust_level )
+{
+    if (!trust_level) return E_POINTER;
+#ifdef SG_MUTANT_MC_TRUST
+    *trust_level = PartialTrust;
+#else
+    *trust_level = BaseTrust;
+#endif
+    return S_OK;
+}
+
+static inline HRESULT sg_class_name( const WCHAR *name, HSTRING *class_name )
+{
+    if (!class_name) return E_POINTER;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
