From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] newdev: DiUninstallDevice

A spec stub before (Chromium's interactive_ui_tests imports it). As Learn describes it: an administrator (else ERROR_ACCESS_DENIED) removes the device through its class installer (DIF_REMOVE, so a co-installer or class installer sees it), its child devices first; Flags must be 0 (ERROR_INVALID_FLAGS); NeedReboot is FALSE -- nothing here needs a restart to remove a device.
---
--- a/include/newdev.h
+++ b/include/newdev.h
@@ -46,5 +46,6 @@
 BOOL WINAPI DiInstallDriverA(HWND parent, const char *inf_path, DWORD flags, BOOL *reboot);
 BOOL WINAPI DiInstallDriverW(HWND parent, const WCHAR *inf_path, DWORD flags, BOOL *reboot);
 #define DiInstallDriver WINELIB_NAME_AW(DiInstallDriver)
+BOOL WINAPI DiUninstallDevice(HWND parent, HDEVINFO devinfo, SP_DEVINFO_DATA *device_data, DWORD flags, BOOL *reboot);
 
 #endif
--- a/dlls/newdev/main.c
+++ b/dlls/newdev/main.c
@@ -481,3 +481,68 @@
 
     return install_inf_on_devices(dest, flags, FALSE, reboot, NULL, NULL);
 }
+
+/* Stained Glass OS (wine-sg 8016): DiUninstallDevice as Learn describes it -- an administrator removes the
+ * device through its class installer (DIF_REMOVE), its child devices first; flags must be 0. */
+static BOOL uninstall_device_tree(HWND parent, HDEVINFO devinfo, SP_DEVINFO_DATA *device_data, int depth)
+{
+    DEVINST child, next;
+    WCHAR id[MAX_DEVICE_ID_LEN];
+
+    if (depth < 16 && !CM_Get_Child(&child, device_data->DevInst, 0))
+    {
+        do
+        {
+            HDEVINFO set;
+            SP_DEVINFO_DATA data = { sizeof(data) };
+
+            if (CM_Get_Sibling(&next, child, 0)) next = 0;
+            if (!CM_Get_Device_IDW(child, id, ARRAY_SIZE(id), 0) &&
+                (set = SetupDiCreateDeviceInfoList(NULL, parent)) != INVALID_HANDLE_VALUE)
+            {
+                if (SetupDiOpenDeviceInfoW(set, id, parent, 0, &data))
+                    uninstall_device_tree(parent, set, &data, depth + 1);
+                SetupDiDestroyDeviceInfoList(set);
+            }
+            child = next;
+        } while (child);
+    }
+#ifdef SG_MUTANT_NO_DIUNINSTALL
+    return TRUE;
+#endif
+    return SetupDiCallClassInstaller(DIF_REMOVE, devinfo, device_data);
+}
+
+BOOL WINAPI DiUninstallDevice(HWND parent, HDEVINFO devinfo, SP_DEVINFO_DATA *device_data, DWORD flags, BOOL *reboot)
+{
+    SP_DEVINFO_DATA data = { sizeof(data) };
+
+    TRACE("(%p, %p, %p, %#lx, %p)\n", parent, devinfo, device_data, flags, reboot);
+
+    if (reboot) *reboot = FALSE;
+    if (flags)
+    {
+        SetLastError(ERROR_INVALID_FLAGS);
+        return FALSE;
+    }
+    if (!devinfo || devinfo == INVALID_HANDLE_VALUE || !device_data)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    /* the device must belong to the set */
+    if (device_data->cbSize != sizeof(SP_DEVINFO_DATA))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!SetupDiGetDeviceInstanceIdW(devinfo, device_data, NULL, 0, NULL) && GetLastError() != ERROR_INSUFFICIENT_BUFFER)
+        return FALSE;
+    if (!is_admin())
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+    data = *device_data;
+    return uninstall_device_tree(parent, devinfo, &data, 0);
+}
--- a/dlls/newdev/newdev.spec
+++ b/dlls/newdev/newdev.spec
@@ -4,7 +4,7 @@
 @ stdcall DiInstallDriverW(ptr wstr long ptr)
 @ stub DiRollbackDriver
 @ stub DiShowUpdateDevice
-@ stub DiUninstallDevice
+@ stdcall DiUninstallDevice(long ptr ptr long ptr)
 @ stdcall InstallNewDevice(long ptr ptr)
 @ stdcall InstallSelectedDriver(long ptr wstr long ptr)
 @ stub InstallWindowsUpdateDriver
