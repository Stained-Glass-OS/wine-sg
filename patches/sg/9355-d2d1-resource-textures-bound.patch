From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: a custom effect's resource textures are bound for its shader

ID2D1DrawInfo::SetResourceTexture kept the texture but the effect renderer never bound it: a custom shader's lookup table read zeros -- Paint.NET's Posterize preview went transparent and its Curves preview black. A resource texture is now made a 1D, 2D or 3D texture of its data in the format its buffer precision and channel depth give (R8/R8G8B8A8 UNORM, sRGB, 16-bit UNORM or float, 32-bit float), bound at the register the draw info gave it, with a sampler of its filter and extend modes (clamp, wrap, mirror).
---
--- a/dlls/d2d1/effect_render.c
+++ b/dlls/d2d1/effect_render.c
@@ -674,6 +674,7 @@
     ID3D11Device1 *device;
     ID3D11DeviceContext1 *dc;
     unsigned int depth;
+    const struct d2d_render_info *resources;    /* the custom node being drawn: its resource textures */
 };
 
 static void fx_texture_release(struct fx_texture *t)
@@ -882,7 +883,7 @@
         float o[4];
         float i[16][4];
     } vs_constants;
-    ID3D11ShaderResourceView *srvs[16] = { 0 };
+    ID3D11ShaderResourceView *srvs[16] = { 0 }, *res_srvs[16] = { 0 };
     ID3D11SamplerState *samplers[16] = { 0 };
     ID3D11Buffer *vs_cb = NULL, *ps_cb = NULL;
     ID3D11RenderTargetView *rtv = NULL;
@@ -932,6 +933,21 @@
             goto done;
     }
 
+#ifndef SG_MUTANT_D2D_RESOURCE_TEXTURES_UNBOUND
+    /* wine-sg 9355: a custom shader's resource textures at the registers it gave them */
+    if (r->resources)
+    {
+        for (i = 0; i < min(r->resources->texture_count, 16); ++i)
+        {
+            if (!r->resources->textures[i] || srvs[i])
+                continue;
+            if (FAILED(hr = d2d_resource_texture_bind(r->resources->textures[i], r->device, &res_srvs[i], &samplers[i])))
+                goto done;
+            srvs[i] = res_srvs[i];
+        }
+    }
+#endif
+
     buffer_desc.ByteWidth = sizeof(vs_constants);
     buffer_desc.Usage = D3D11_USAGE_DEFAULT;
     buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
@@ -997,6 +1013,8 @@
 done:
     for (i = 0; i < ARRAY_SIZE(samplers); ++i)
         if (samplers[i]) ID3D11SamplerState_Release(samplers[i]);
+    for (i = 0; i < ARRAY_SIZE(res_srvs); ++i)
+        if (res_srvs[i]) ID3D11ShaderResourceView_Release(res_srvs[i]);
     if (vs_cb) ID3D11Buffer_Release(vs_cb);
     if (ps_cb) ID3D11Buffer_Release(ps_cb);
     if (rtv) ID3D11RenderTargetView_Release(rtv);
@@ -1942,8 +1960,10 @@
             pass_inputs[i].texture = &textures[i];
             pass_inputs[i].filter = fx_filter(info, i);
         }
+        r->resources = info;
         hr = fx_draw(r, vs, ps, &rect, pass_inputs, min(n, 16), info->ps_constants, info->ps_constants_size,
                 NULL, FALSE, out);
+        r->resources = NULL;
         ID3D11PixelShader_Release(ps);
         ID3D11VertexShader_Release(vs);
     }
--- a/dlls/d2d1/objects.c
+++ b/dlls/d2d1/objects.c
@@ -1697,6 +1697,9 @@
     UINT32 extents[3];
     UINT32 elem_size;                   /* bytes of one texel */
     BYTE *data;
+    DXGI_FORMAT format;                 /* wine-sg 9355: what the shader reads */
+    D2D1_FILTER filter;
+    D2D1_EXTEND_MODE extend[3];
 };
 
 static inline struct d2d_resource_texture *impl_from_ID2D1ResourceTexture(ID2D1ResourceTexture *iface)
@@ -1840,6 +1843,22 @@
     for (i = 0; i < props->dimensions; ++i)
         texture->extents[i] = props->extents[i];
     texture->elem_size = channels * depth;
+    texture->filter = props->filter;
+    for (i = 0; i < 3; ++i)
+        texture->extend[i] = props->extendModes && i < props->dimensions ? props->extendModes[i] : D2D1_EXTEND_MODE_CLAMP;
+    switch (props->bufferPrecision)
+    {
+        case D2D1_BUFFER_PRECISION_8BPC_UNORM_SRGB:
+            texture->format = channels == 4 ? DXGI_FORMAT_R8G8B8A8_UNORM_SRGB : DXGI_FORMAT_R8_UNORM; break;
+        case D2D1_BUFFER_PRECISION_16BPC_UNORM:
+            texture->format = channels == 4 ? DXGI_FORMAT_R16G16B16A16_UNORM : DXGI_FORMAT_R16_UNORM; break;
+        case D2D1_BUFFER_PRECISION_16BPC_FLOAT:
+            texture->format = channels == 4 ? DXGI_FORMAT_R16G16B16A16_FLOAT : DXGI_FORMAT_R16_FLOAT; break;
+        case D2D1_BUFFER_PRECISION_32BPC_FLOAT:
+            texture->format = channels == 4 ? DXGI_FORMAT_R32G32B32A32_FLOAT : DXGI_FORMAT_R32_FLOAT; break;
+        default:
+            texture->format = channels == 4 ? DXGI_FORMAT_R8G8B8A8_UNORM : DXGI_FORMAT_R8_UNORM; break;
+    }
     if (!(texture->data = calloc(size, texture->elem_size)))
     {
         free(texture);
@@ -1853,3 +1872,70 @@
     *out = &texture->ID2D1ResourceTexture_iface;
     return S_OK;
 }
+
+/* wine-sg 9355: a resource texture as a custom effect's shader reads it -- a 1D, 2D or 3D texture of its data at
+ * the register the draw info gave it, sampled with the texture's filter and extend modes. The textures were
+ * kept but never bound: a shader's lookup table read zeros (Paint.NET's Posterize preview transparent, Curves
+ * black). */
+static D3D11_TEXTURE_ADDRESS_MODE d2d_resource_texture_address(D2D1_EXTEND_MODE mode)
+{
+    if (mode == D2D1_EXTEND_MODE_WRAP) return D3D11_TEXTURE_ADDRESS_WRAP;
+    if (mode == D2D1_EXTEND_MODE_MIRROR) return D3D11_TEXTURE_ADDRESS_MIRROR;
+    return D3D11_TEXTURE_ADDRESS_CLAMP;
+}
+
+HRESULT d2d_resource_texture_bind(ID2D1ResourceTexture *iface, ID3D11Device1 *device,
+        ID3D11ShaderResourceView **srv, ID3D11SamplerState **sampler)
+{
+    struct d2d_resource_texture *texture = impl_from_ID2D1ResourceTexture(iface);
+    UINT32 row = texture->extents[0] * texture->elem_size;
+    D3D11_SUBRESOURCE_DATA data;
+    D3D11_SAMPLER_DESC sampler_desc;
+    ID3D11Resource *resource;
+    HRESULT hr;
+
+    *srv = NULL;
+    *sampler = NULL;
+    data.pSysMem = texture->data;
+    data.SysMemPitch = row;
+    data.SysMemSlicePitch = row * (texture->dimensions > 1 ? texture->extents[1] : 1);
+    if (texture->dimensions == 1)
+    {
+        D3D11_TEXTURE1D_DESC desc = { texture->extents[0], 1, 1, texture->format, D3D11_USAGE_IMMUTABLE,
+                D3D11_BIND_SHADER_RESOURCE, 0, 0 };
+        hr = ID3D11Device1_CreateTexture1D(device, &desc, &data, (ID3D11Texture1D **)&resource);
+    }
+    else if (texture->dimensions == 2)
+    {
+        D3D11_TEXTURE2D_DESC desc = { texture->extents[0], texture->extents[1], 1, 1, texture->format, {1, 0},
+                D3D11_USAGE_IMMUTABLE, D3D11_BIND_SHADER_RESOURCE, 0, 0 };
+        hr = ID3D11Device1_CreateTexture2D(device, &desc, &data, (ID3D11Texture2D **)&resource);
+    }
+    else
+    {
+        D3D11_TEXTURE3D_DESC desc = { texture->extents[0], texture->extents[1], texture->extents[2], 1,
+                texture->format, D3D11_USAGE_IMMUTABLE, D3D11_BIND_SHADER_RESOURCE, 0, 0 };
+        hr = ID3D11Device1_CreateTexture3D(device, &desc, &data, (ID3D11Texture3D **)&resource);
+    }
+    if (FAILED(hr))
+        return hr;
+    hr = ID3D11Device1_CreateShaderResourceView(device, resource, NULL, srv);
+    ID3D11Resource_Release(resource);
+    if (FAILED(hr))
+        return hr;
+
+    memset(&sampler_desc, 0, sizeof(sampler_desc));
+    sampler_desc.Filter = (D3D11_FILTER)texture->filter;
+    sampler_desc.AddressU = d2d_resource_texture_address(texture->extend[0]);
+    sampler_desc.AddressV = d2d_resource_texture_address(texture->extend[1]);
+    sampler_desc.AddressW = d2d_resource_texture_address(texture->extend[2]);
+    sampler_desc.MaxAnisotropy = 1;
+    sampler_desc.ComparisonFunc = D3D11_COMPARISON_NEVER;
+    sampler_desc.MaxLOD = D3D11_FLOAT32_MAX;
+    if (FAILED(hr = ID3D11Device1_CreateSamplerState(device, &sampler_desc, sampler)))
+    {
+        ID3D11ShaderResourceView_Release(*srv);
+        *srv = NULL;
+    }
+    return hr;
+}
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -1244,5 +1244,7 @@
 HRESULT d2d_gdi_metafile_create(ID2D1Factory *factory, IStream *stream, ID2D1GdiMetafile **out);
 void d2d_draw_gdi_metafile(ID2D1DeviceContext6 *context, ID2D1GdiMetafile *mf, const D2D1_POINT_2F *offset,
         const D2D1_RECT_F *dst_rect, const D2D1_RECT_F *src_rect);
+HRESULT d2d_resource_texture_bind(ID2D1ResourceTexture *texture, ID3D11Device1 *device,
+        ID3D11ShaderResourceView **srv, ID3D11SamplerState **sampler);
 HRESULT d2d_resource_texture_create(const D2D1_RESOURCE_TEXTURE_PROPERTIES *props, const BYTE *data,
         const UINT32 *strides, UINT32 data_size, ID2D1ResourceTexture **out);
