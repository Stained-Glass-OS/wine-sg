+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* The trace sessions of the machine (StartTrace in sechost) and the
+ * providers they enable (EnableTraceEx2) live in a named section that every
+ * process maps: providers (ntdll's EtwEventRegister) learn from it which of
+ * their events a session wants, and write them to the session -- to its log
+ * file, or to a ring of its own that a real-time consumer (OpenTrace,
+ * ProcessTrace) reads. A named mutex guards both; a process with providers
+ * keeps a named event its controllers set when something changes. */
+
+#ifndef __WINE_SG_ETW_H
+#define __WINE_SG_ETW_H
+
+#include <evntprov.h>
+#include <evntcons.h>
+
+#define SG_ETW_MAGIC           0x31575445  /* "ETW1" */
+#define SG_ETW_MAX_SESSIONS    64
+#define SG_ETW_MAX_PROVIDERS   64
+#define SG_ETW_MAX_PROCESSES   512
+#define SG_ETW_NAME_LEN        128
+#define SG_ETW_RING_SIZE       (1024 * 1024)
+
+#define SG_ETW_SECTION_NAME    L"\\BaseNamedObjects\\SgEtwControl"
+#define SG_ETW_MUTEX_NAME      L"\\BaseNamedObjects\\SgEtwMutex"
+#define SG_ETW_NOTIFY_PREFIX   L"\\BaseNamedObjects\\SgEtwNotify"    /* + pid */
+#define SG_ETW_RING_PREFIX     L"\\BaseNamedObjects\\SgEtwRing"      /* + logger id */
+#define SG_ETW_RING_EVENT_PREFIX L"\\BaseNamedObjects\\SgEtwRingEvent" /* + logger id */
+
+struct sg_etw_provider
+{
+    GUID      guid;
+    UCHAR     level;       /* 0: every level */
+    UCHAR     classic;     /* enabled with EnableTrace (classic providers) */
+    USHORT    reserved;
+    ULONG     enable_property;
+    ULONG     capture;     /* EVENT_CONTROL_CODE_CAPTURE_STATE requests, counted */
+    ULONG     reserved2;
+    ULONGLONG any;         /* 0: every keyword */
+    ULONGLONG all;
+};
+
+struct sg_etw_session
+{
+    LONG      in_use;
+    ULONG     logger_id;
+    ULONG     mode;                /* EVENT_TRACE_*_MODE */
+    ULONG     buffer_size;
+    ULONG     min_buffers;
+    ULONG     max_buffers;
+    ULONG     max_file_size;
+    ULONG     flush_timer;
+    ULONG     enable_flags;
+    LONG      age_limit;
+    ULONG     events_lost;
+    ULONG     buffers_written;
+    ULONG     events_written;
+    ULONG     rt_consumers;
+    LONGLONG  start_time;
+    GUID      guid;
+    ULONG     provider_count;
+    ULONG     reserved;
+    WCHAR     name[SG_ETW_NAME_LEN];
+    WCHAR     logfile[MAX_PATH];
+    struct sg_etw_provider providers[SG_ETW_MAX_PROVIDERS];
+};
+
+struct sg_etw_shared
+{
+    ULONG     magic;
+    ULONG     reserved;
+    LONGLONG  boot_time;   /* the system's start: sessions do not outlive it */
+    ULONG     generation;
+    ULONG     next_logger_id;
+    ULONG     process_count;
+    DWORD     processes[SG_ETW_MAX_PROCESSES];
+    struct sg_etw_session sessions[SG_ETW_MAX_SESSIONS];
+};
+
+/* a session's ring of events, for real-time consumers */
+struct sg_etw_ring
+{
+    ULONG     head;      /* bytes ever written */
+    ULONG     tail;      /* bytes ever read */
+    ULONG     size;
+    ULONG     lost;
+    BYTE      data[1];
+};
+
+/* an event as written to a log file or a ring */
+#define SG_ETW_RECORD_EVENT   1
+#define SG_ETW_RECORD_HEADER  2
+
+struct sg_etw_record
+{
+    ULONG        size;             /* all of it, user data included, rounded to 8 */
+    ULONG        kind;
+    EVENT_HEADER header;
+    GUID         related_activity;
+    ULONG        has_related;
+    ULONG        user_data_length;
+    ULONG        pointer_size;
+    ULONG        reserved;
+    /* the user data follows */
+};
+
+#define SG_ETW_FILE_MAGIC "SGETW\0\0\1"
+
+struct sg_etw_file_header
+{
+    char      magic[8];
+    ULONG     version;
+    ULONG     mode;
+    LONGLONG  start_time;
+    ULONG     pointer_size;
+    ULONG     buffer_size;
+    WCHAR     logger_name[SG_ETW_NAME_LEN];
+};
+
+/* The sessions and the rings are kept in files under
+ * %SystemRoot%\system32\LogFiles\WMI, so that they outlive the processes
+ * that made them (a session started by a tool that exits goes on), as on
+ * Windows; the named sections over them are what processes share. */
+static inline HANDLE sg_etw_backing_file( const WCHAR *leaf )
+{
+    static const WCHAR *const parts[] = { L"\\system32\\LogFiles", L"\\WMI" };
+    const WCHAR *root = (const WCHAR *)((const BYTE *)0x7ffe0000 + 0x30);  /* KUSER_SHARED_DATA.NtSystemRoot */
+    WCHAR path[MAX_PATH + 64];
+    UNICODE_STRING str;
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    HANDLE handle;
+    unsigned int i;
+
+    swprintf( path, ARRAY_SIZE(path), L"\\??\\%s", root );
+    for (i = 0; i < ARRAY_SIZE(parts); i++)
+    {
+        wcscat( path, parts[i] );
+        RtlInitUnicodeString( &str, path );
+        InitializeObjectAttributes( &attr, &str, OBJ_CASE_INSENSITIVE, 0, NULL );
+        if (!NtCreateFile( &handle, SYNCHRONIZE | FILE_LIST_DIRECTORY, &attr, &io, NULL, FILE_ATTRIBUTE_DIRECTORY,
+                           FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_OPEN_IF,
+                           FILE_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT, NULL, 0 ))
+            NtClose( handle );
+    }
+    wcscat( path, L"\\" );
+    wcscat( path, leaf );
+    RtlInitUnicodeString( &str, path );
+    InitializeObjectAttributes( &attr, &str, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (NtCreateFile( &handle, GENERIC_READ | GENERIC_WRITE | SYNCHRONIZE, &attr, &io, NULL, FILE_ATTRIBUTE_NORMAL,
+                      FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OPEN_IF,
+                      FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE, NULL, 0 ))
+        return 0;
+    return handle;
+}
+
+/* a shared view of a named section over a backing file */
+static inline void *sg_etw_map( const WCHAR *object_name, const WCHAR *leaf, ULONG size, HANDLE *section_ret )
+{
+    UNICODE_STRING str;
+    OBJECT_ATTRIBUTES attr;
+    LARGE_INTEGER max;
+    HANDLE file, section;
+    SIZE_T view = 0;
+    void *ptr = NULL;
+
+    RtlInitUnicodeString( &str, object_name );
+    InitializeObjectAttributes( &attr, &str, OBJ_OPENIF, 0, NULL );
+    max.QuadPart = size;
+    if (!(file = sg_etw_backing_file( leaf ))) return NULL;
+    if (NtCreateSection( &section, SECTION_ALL_ACCESS, &attr, &max, PAGE_READWRITE, SEC_COMMIT, file ) < 0)
+    {
+        NtClose( file );
+        return NULL;
+    }
+    NtClose( file );
+    if (NtMapViewOfSection( section, (HANDLE)~(ULONG_PTR)0, &ptr, 0, 0, NULL, &view, ViewShare, 0, PAGE_READWRITE ))
+    {
+        NtClose( section );
+        return NULL;
+    }
+    /* the handle stays: the section's name lasts only while one does */
+    *section_ret = section;
+    return ptr;
+}
+
+/* sessions of a previous start of the system are gone; with the mutex held */
+static inline void sg_etw_check_boot( struct sg_etw_shared *shared )
+{
+    SYSTEM_TIMEOFDAY_INFORMATION tod;
+
+    if (NtQuerySystemInformation( SystemTimeOfDayInformation, &tod, sizeof(tod), NULL )) return;
+    if (shared->magic == SG_ETW_MAGIC && shared->boot_time == tod.BootTime.QuadPart) return;
+    memset( shared, 0, sizeof(*shared) );
+    shared->magic = SG_ETW_MAGIC;
+    shared->boot_time = tod.BootTime.QuadPart;
+}
+
+#endif /* __WINE_SG_ETW_H */
