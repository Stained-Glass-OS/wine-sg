+        consumer->logfile_a->BuffersRead = consumer->logfile.BuffersRead;
+        ret = consumer->logfile_a->BufferCallback( consumer->logfile_a );
+    }
+    else
+    {
+        if (!consumer->logfile.BufferCallback) return TRUE;
+        ret = consumer->logfile.BufferCallback( &consumer->logfile );
