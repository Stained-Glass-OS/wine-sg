+        if (consumer->closing) return ERROR_CANCELLED;
+        if (!ReadFile( consumer->file, &header, sizeof(header), &read, NULL ) || read != sizeof(header)) break;
+        if (header.size < sizeof(header) || header.size > 16 * 1024 * 1024) return ERROR_BAD_FORMAT;
+        if (!(record = malloc( header.size ))) return ERROR_NOT_ENOUGH_MEMORY;
+        *record = header;
+        if (!ReadFile( consumer->file, record + 1, header.size - sizeof(header), &read, NULL ) ||
+            read != header.size - sizeof(header))
+        {
+            free( record );
+            break;
+        }
+        if (record->kind == SG_ETW_RECORD_EVENT && in_window( record, start, end )) deliver( consumer, record );
+        free( record );
+        if (!(++count % 64) && !buffer_callback( consumer )) return ERROR_SUCCESS;
+    }
+    buffer_callback( consumer );
+    return ERROR_SUCCESS;
+}
+
+/* drain a real-time ring; FALSE when the session has gone */
+static BOOL process_ring( struct consumer *consumer, ULONG *status )
+{
+    WCHAR buffer[128];
+    struct sg_etw_ring *ring = NULL;
+    struct sg_etw_record *record;
+    HANDLE section;
+    BOOL alive, any = FALSE;
+
+    lock_shared();
+    alive = find_session( consumer->logger_id, NULL ) != NULL;
+    unlock_shared();
+
+    {
+        WCHAR leaf[64];
+        named_object( buffer, SG_ETW_RING_PREFIX, consumer->logger_id, TRUE );
+        swprintf( leaf, ARRAY_SIZE(leaf), L"SgEtwRing%u.dat", consumer->logger_id );
+        if (!(ring = sg_etw_map( buffer, leaf, offsetof(struct sg_etw_ring, data[SG_ETW_RING_SIZE]), &section )))
+            return FALSE;
+        if (ring->size != SG_ETW_RING_SIZE)
+        {
+            NtUnmapViewOfSection( GetCurrentProcess(), ring );
+            CloseHandle( section );
+            return alive;
+        }
+    }
+    for (;;)
+    {
+        ULONG size, pos, first;
+
+        lock_shared();
+        if (ring->head == ring->tail)
+        {
+            unlock_shared();
+            break;
+        }
+        pos = ring->tail % ring->size;
+        first = min( sizeof(ULONG), ring->size - pos );
+        memcpy( &size, ring->data + pos, first );
+        memcpy( (BYTE *)&size + first, ring->data, sizeof(ULONG) - first );
+        if (size < sizeof(*record) || size > ring->head - ring->tail || !(record = malloc( size )))
+        {
+            ring->tail = ring->head;  /* damaged: dropped */
+            unlock_shared();
+            break;
+        }
+        first = min( size, ring->size - pos );
+        memcpy( record, ring->data + pos, first );
+        memcpy( (BYTE *)record + first, ring->data, size - first );
+        ring->tail += size;
+        consumer->logfile.EventsLost = ring->lost;
+        unlock_shared();
+        deliver( consumer, record );
+        free( record );
+        any = TRUE;
+        if (consumer->closing) break;
+    }
+    NtUnmapViewOfSection( GetCurrentProcess(), ring );
+    CloseHandle( section );
+    if (any && !buffer_callback( consumer ))
+    {
+        *status = ERROR_SUCCESS;
+        return FALSE;
+    }
+    return alive;
 }
 
 /******************************************************************************
- *     CloseTrace   (sechost.@)
+ *     ProcessTrace   (sechost.@)
  */
-ULONG WINAPI CloseTrace( TRACEHANDLE handle )
+ULONG WINAPI ProcessTrace( TRACEHANDLE *handles, ULONG count, FILETIME *start_time, FILETIME *end_time )
+{
+    struct consumer *list[64];
+    HANDLE events[64];
+    ULONG i, n_rt = 0, ret = ERROR_SUCCESS;
+
+    TRACE("%p %lu %p %p\n", handles, count, start_time, end_time);
+
+    if (!handles || !count || count > ARRAY_SIZE(list)) return ERROR_INVALID_PARAMETER;
+    EnterCriticalSection( &consumers_cs );
+    for (i = 0; i < count; i++)
+    {
+        if (!(list[i] = get_consumer( handles[i] )))
+        {
+            LeaveCriticalSection( &consumers_cs );
+            return ERROR_INVALID_HANDLE;
+        }
+        if (list[i]->real_time && i && !list[0]->real_time)
+        {
+            /* real-time sessions and files are not processed together */
+            LeaveCriticalSection( &consumers_cs );
+            return ERROR_INVALID_PARAMETER;
+        }
+    }
+    for (i = 0; i < count; i++) InterlockedIncrement( &list[i]->processing );
+    LeaveCriticalSection( &consumers_cs );
+
+    for (i = 0; i < count && !ret; i++)
+    {
+        if (list[i]->real_time)
+        {
+            WCHAR buffer[128];
+            UNICODE_STRING str;
+            OBJECT_ATTRIBUTES attr;
+
+            named_object( buffer, SG_ETW_RING_EVENT_PREFIX, list[i]->logger_id, TRUE );
+            RtlInitUnicodeString( &str, buffer );
+            InitializeObjectAttributes( &attr, &str, 0, 0, NULL );
+            if (NtOpenEvent( &events[n_rt], SYNCHRONIZE | EVENT_MODIFY_STATE, &attr )) events[n_rt] = 0;
+            list[i]->ring_event = events[n_rt];
+            n_rt++;
+        }
+        else ret = process_file( list[i], start_time, end_time );
+    }
+
+    if (n_rt && !ret)
+    {
+        /* until every session has stopped, or the consumer closes */
+        BOOL alive = TRUE;
+        while (alive)
+        {
+            alive = FALSE;
+            for (i = 0; i < count; i++)
+            {
+                if (list[i]->closing)
+                {
+                    ret = ERROR_CANCELLED;
+                    continue;
+                }
+                if (process_ring( list[i], &ret )) alive = TRUE;
+            }
+            if (ret == ERROR_CANCELLED) break;
+            if (alive)
+            {
+                HANDLE wait[64];
+                ULONG w = 0;
+                for (i = 0; i < n_rt; i++) if (events[i]) wait[w++] = events[i];
+                if (w) WaitForMultipleObjects( w, wait, FALSE, 200 );
+                else Sleep( 200 );
+            }
+        }
+        for (i = 0; i < n_rt; i++) if (events[i]) CloseHandle( events[i] );
+    }
+
+    for (i = 0; i < count; i++) InterlockedDecrement( &list[i]->processing );
+    /* consumers closed while they were processed go now */
+    EnterCriticalSection( &consumers_cs );
+    for (i = 0; i < count; i++)
+        if (list[i]->closing && !list[i]->processing && get_consumer( handles[i] ) == list[i])
+        {
+            consumers[handles[i] & 0xffff] = NULL;
+            if (list[i]->file != INVALID_HANDLE_VALUE) CloseHandle( list[i]->file );
+            free( list[i] );
+        }
+    LeaveCriticalSection( &consumers_cs );
+    return ret;
+}
