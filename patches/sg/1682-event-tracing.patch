+
+/* Stained Glass OS 1682: event tracing providers, as documented: a provider
+ * (EventRegister, or the classic RegisterTraceGuids) is told when trace
+ * sessions enable it (its callback, with the level and keywords they ask),
+ * answers EventEnabled from that, and its events (EventWrite and its kin,
+ * TraceEvent) go to the sessions that want them -- to a session's log file
+ * or its real-time ring. The sessions live in a section every process maps
+ * (include/wine/sg_etw.h); sechost's StartTrace and EnableTraceEx2 change
+ * it and set the named event of each process with providers. */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wmistr.h"
+#include "evntrace.h"
+#include "evntprov.h"
+#include "evntcons.h"
+#include "ntdll_misc.h"
+#include "wine/sg_etw.h"
+#include "wine/list.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(etw);
+
+#ifndef EVENT_ACTIVITY_CTRL_GET_ID
+#define EVENT_ACTIVITY_CTRL_GET_ID        1
+#define EVENT_ACTIVITY_CTRL_SET_ID        2
+#define EVENT_ACTIVITY_CTRL_CREATE_ID     3
+#define EVENT_ACTIVITY_CTRL_GET_SET_ID    4
+#define EVENT_ACTIVITY_CTRL_CREATE_SET_ID 5
+#endif
+
+struct etw_reg
+{
+    struct list      entry;
+    ULONG_PTR        id;
+    GUID             guid;
+    /* manifest providers */
+    PENABLECALLBACK  callback;
+    void            *context;
+    /* classic providers */
+    WMIDPREQUEST     request;
+    TRACEHANDLE      classic_logger;
+    ULONG            classic_flags;
+    UCHAR            classic_level;
+    BOOL             classic;
+    /* what the sessions ask of it */
+    BOOL             enabled;
+    UCHAR            level;
+    ULONGLONG        any, all;
+    ULONG            capture;
+};
+
+static const GUID GUID_NULL_ETW;
+static struct list registrations = LIST_INIT( registrations );
+static ULONG_PTR next_reg_id = 0x1000;
+static RTL_CRITICAL_SECTION etw_cs;
+static RTL_CRITICAL_SECTION_DEBUG etw_cs_debug =
+{
+    0, 0, &etw_cs,
+    { &etw_cs_debug.ProcessLocksList, &etw_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": etw_cs") }
+};
+static RTL_CRITICAL_SECTION etw_cs = { &etw_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct sg_etw_shared *shared;
+static HANDLE shared_mutex, notify_event;
+static TP_WAIT *notify_wait;
+static ULONG seen_generation = ~0u;
+
+/* ---- the shared section ---- */
+
+static void named_object( UNICODE_STRING *str, WCHAR *buffer, const WCHAR *path, ULONG suffix, BOOL with_suffix )
+{
+    const WCHAR *name = path + wcslen( L"\\BaseNamedObjects\\" );
+    if (with_suffix)
+        swprintf( buffer, 128, L"\\Sessions\\%u\\BaseNamedObjects\\%s%u", NtCurrentTeb()->Peb->SessionId, name, suffix );
+    else
+        swprintf( buffer, 128, L"\\Sessions\\%u\\BaseNamedObjects\\%s", NtCurrentTeb()->Peb->SessionId, name );
+    RtlInitUnicodeString( str, buffer );
+}
+
+/* the sessions, mapped; created empty if no controller has made them yet */
+static BOOL map_shared(void)
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING str;
+    WCHAR buffer[128];
+    HANDLE section;
+    void *ptr;
+
+    if (shared) return TRUE;
+    named_object( &str, buffer, SG_ETW_MUTEX_NAME, 0, FALSE );
+    InitializeObjectAttributes( &attr, &str, OBJ_OPENIF, 0, NULL );
+    if (!shared_mutex && NtCreateMutant( &shared_mutex, MUTANT_ALL_ACCESS, &attr, FALSE ) < 0) return FALSE;
+    named_object( &str, buffer, SG_ETW_SECTION_NAME, 0, FALSE );
+    if (!(ptr = sg_etw_map( buffer, L"SgEtwControl.dat", sizeof(struct sg_etw_shared), &section ))) return FALSE;
+    shared = ptr;
+    return TRUE;
+}
+
+static void lock_shared(void)
+{
+    NtWaitForSingleObject( shared_mutex, FALSE, NULL );
+    sg_etw_check_boot( shared );
+}
+
+static void unlock_shared(void)
+{
+    NtReleaseMutant( shared_mutex, NULL );
+}
+
+/* ---- enabling ---- */
+
+static BOOL keywords_match( ULONGLONG keyword, ULONGLONG any, ULONGLONG all )
+{
+    if (!keyword) return TRUE;
+    if (any && !(keyword & any)) return FALSE;
+    return (keyword & all) == all;
+}
+
+static BOOL level_matches( UCHAR level, UCHAR enabled_level )
+{
+    return !enabled_level || !level || level <= enabled_level;
+}
+
+/* what the sessions ask of a provider; with the section locked */
+static void compute_enable( const GUID *guid, BOOL *enabled, UCHAR *level, ULONGLONG *any, ULONGLONG *all,
+                            ULONG *capture, TRACEHANDLE *logger, ULONG *flags )
+{
+    unsigned int s, p;
+
+    *enabled = FALSE;
+    *level = 0;
+    *any = 0;
+    *all = ~(ULONGLONG)0;
+    *capture = 0;
+    *logger = 0;
+    *flags = 0;
+    for (s = 0; s < SG_ETW_MAX_SESSIONS; s++)
+    {
+        const struct sg_etw_session *session = &shared->sessions[s];
+        if (!session->in_use) continue;
+        for (p = 0; p < session->provider_count && p < SG_ETW_MAX_PROVIDERS; p++)
+        {
+            const struct sg_etw_provider *prov = &session->providers[p];
+            if (!IsEqualGUID( &prov->guid, guid )) continue;
+            if (!*enabled || !prov->level || (*level && prov->level > *level))
+                *level = prov->level;
+            *any = prov->any ? (*any | prov->any) : ~(ULONGLONG)0;
+            *all &= prov->all;
+            *capture += prov->capture;
+            if (!*enabled) *logger = session->logger_id;
+            *flags |= (ULONG)prov->any;
+            *enabled = TRUE;
+        }
+    }
+    if (!*enabled) *all = 0;
+}
+
+/* tell the providers of this process what changed */
+static void refresh_registrations( BOOL force )
+{
+    struct etw_reg *reg;
+    struct pending { struct etw_reg reg; ULONG code; struct pending *next; } *calls = NULL, *call;
+
+    if (!shared) return;
+    /* nothing changed since: no lock taken (EventEnabled is called often) */
+    if (!force && ReadNoFence( (LONG *)&shared->generation ) == (LONG)seen_generation) return;
+    RtlEnterCriticalSection( &etw_cs );
+    lock_shared();
+    if (!force && shared->generation == seen_generation)
+    {
+        unlock_shared();
+        RtlLeaveCriticalSection( &etw_cs );
+        return;
+    }
+    seen_generation = shared->generation;
+    LIST_FOR_EACH_ENTRY( reg, &registrations, struct etw_reg, entry )
+    {
+        BOOL enabled;
+        UCHAR level;
+        ULONGLONG any, all;
+        ULONG capture, flags;
+        TRACEHANDLE logger;
+
+        compute_enable( &reg->guid, &enabled, &level, &any, &all, &capture, &logger, &flags );
+        if (enabled != reg->enabled || level != reg->level || any != reg->any || all != reg->all ||
+            capture != reg->capture)
+        {
+            ULONG code = enabled ? EVENT_CONTROL_CODE_ENABLE_PROVIDER : EVENT_CONTROL_CODE_DISABLE_PROVIDER;
+            if (enabled && reg->enabled && capture != reg->capture && level == reg->level && any == reg->any)
+                code = EVENT_CONTROL_CODE_CAPTURE_STATE;
+            reg->enabled = enabled;
+            reg->level = level;
+            reg->any = any;
+            reg->all = all;
+            reg->capture = capture;
+            reg->classic_logger = enabled ? logger : 0;
+            reg->classic_flags = flags;
+            reg->classic_level = level;
+            /* called outside the locks: a callback may write events */
+            if ((reg->callback || reg->request) && (call = RtlAllocateHeap( GetProcessHeap(), 0, sizeof(*call) )))
+            {
+                call->reg = *reg;
+                call->code = code;
+                call->next = calls;
+                calls = call;
+            }
+        }
+    }
+    unlock_shared();
+    RtlLeaveCriticalSection( &etw_cs );
+
+    while ((call = calls))
+    {
+        calls = call->next;
+        TRACE( "provider %s: control %lu, level %u, any %s\n", debugstr_guid( &call->reg.guid ), call->code,
+               call->reg.level, wine_dbgstr_longlong( call->reg.any ) );
+        if (call->reg.callback)
+            call->reg.callback( &GUID_NULL_ETW, call->code, call->reg.level, call->reg.any, call->reg.all, NULL,
+                                call->reg.context );
+        else if (call->reg.request)
+        {
+            WNODE_HEADER header;
+            ULONG size = sizeof(header);
+
+            memset( &header, 0, sizeof(header) );
+            header.BufferSize = sizeof(header);
+            header.HistoricalContext = call->reg.classic_logger;
+            header.Guid = call->reg.guid;
+            header.Flags = WNODE_FLAG_TRACED_GUID;
+            call->reg.request( call->code == EVENT_CONTROL_CODE_DISABLE_PROVIDER ? WMI_DISABLE_EVENTS :
+                               WMI_ENABLE_EVENTS, call->reg.context, &size, &header );
+        }
+        RtlFreeHeap( GetProcessHeap(), 0, call );
+    }
+}
+
+static void CALLBACK notify_callback( TP_CALLBACK_INSTANCE *instance, void *context, TP_WAIT *wait, TP_WAIT_RESULT result )
+{
+    refresh_registrations( FALSE );
+    TpSetWait( notify_wait, notify_event, NULL );
+}
+
+/* this process listens for changes once it has a provider */
+static void start_listening(void)
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING str;
+    WCHAR buffer[128];
+    DWORD pid = HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess );
+    unsigned int i;
+
+    if (notify_wait || !map_shared()) return;
+    named_object( &str, buffer, SG_ETW_NOTIFY_PREFIX, pid, TRUE );
+    InitializeObjectAttributes( &attr, &str, OBJ_OPENIF, 0, NULL );
+    if (NtCreateEvent( &notify_event, EVENT_ALL_ACCESS, &attr, SynchronizationEvent, FALSE )) return;
+    lock_shared();
+    for (i = 0; i < shared->process_count && i < SG_ETW_MAX_PROCESSES; i++)
+        if (shared->processes[i] == pid) break;
+    if (i == shared->process_count && i < SG_ETW_MAX_PROCESSES) shared->processes[shared->process_count++] = pid;
+    unlock_shared();
+    if (TpAllocWait( &notify_wait, notify_callback, NULL, NULL )) return;
+    TpSetWait( notify_wait, notify_event, NULL );
+}
+
+static struct etw_reg *get_reg( ULONG_PTR id )
+{
+    struct etw_reg *reg;
+    LIST_FOR_EACH_ENTRY( reg, &registrations, struct etw_reg, entry )
+        if (reg->id == id) return reg;
+    return NULL;
+}
+
+static ULONG add_registration( const GUID *guid, PENABLECALLBACK callback, WMIDPREQUEST request, void *context,
+                               ULONG_PTR *ret )
+{
+    struct etw_reg *reg;
+
+    if (!(reg = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*reg) ))) return ERROR_OUTOFMEMORY;
+    reg->guid = *guid;
+    reg->callback = callback;
+    reg->request = request;
+    reg->classic = request != NULL;
+    reg->context = context;
+    RtlEnterCriticalSection( &etw_cs );
+    reg->id = next_reg_id++;
+    list_add_tail( &registrations, &reg->entry );
+    RtlLeaveCriticalSection( &etw_cs );
+    *ret = reg->id;
+    start_listening();
+    /* a session that enabled the provider already: its callback now */
+    refresh_registrations( TRUE );
+    return ERROR_SUCCESS;
+}
+
+/* ---- writing ---- */
+
+static void write_to_file( const WCHAR *path, const void *data, ULONG size )
+{
+    UNICODE_STRING nt_name;
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    HANDLE file;
+
+    if (!RtlDosPathNameToNtPathName_U( path, &nt_name, NULL, NULL )) return;
+    InitializeObjectAttributes( &attr, &nt_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (!NtCreateFile( &file, FILE_APPEND_DATA | SYNCHRONIZE, &attr, &io, NULL, FILE_ATTRIBUTE_NORMAL,
+                       FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OPEN,
+                       FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE, NULL, 0 ))
+    {
+        LARGE_INTEGER end;
+        end.u.LowPart = 0xffffffff;  /* FILE_WRITE_TO_END_OF_FILE */
+        end.u.HighPart = -1;
+        NtWriteFile( file, 0, NULL, NULL, &io, data, size, &end, NULL );
+        NtClose( file );
+    }
+    RtlFreeUnicodeString( &nt_name );
+}
+
+static BOOL write_to_ring( struct sg_etw_session *session, const void *data, ULONG size )
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING str;
+    WCHAR buffer[128], leaf[64];
+    HANDLE section, event;
+    struct sg_etw_ring *ring;
+    BOOL ret = FALSE;
+
+    named_object( &str, buffer, SG_ETW_RING_PREFIX, session->logger_id, TRUE );
+    swprintf( leaf, ARRAY_SIZE(leaf), L"SgEtwRing%u.dat", session->logger_id );
+    if (!(ring = sg_etw_map( buffer, leaf, offsetof(struct sg_etw_ring, data[SG_ETW_RING_SIZE]), &section )))
+        return FALSE;
+    if (ring->size == SG_ETW_RING_SIZE)
+    {
+        ULONG used = ring->head - ring->tail, pos, first;
+        if (size <= ring->size - used)
+        {
+            pos = ring->head % ring->size;
+            first = min( size, ring->size - pos );
+            memcpy( ring->data + pos, data, first );
+            memcpy( ring->data, (const BYTE *)data + first, size - first );
+            ring->head += size;
+            ret = TRUE;
+        }
+        else ring->lost++;
+    }
+    NtUnmapViewOfSection( NtCurrentProcess(), ring );
+    NtClose( section );
+    named_object( &str, buffer, SG_ETW_RING_EVENT_PREFIX, session->logger_id, TRUE );
+    InitializeObjectAttributes( &attr, &str, 0, 0, NULL );
+    if (ret && !NtOpenEvent( &event, EVENT_MODIFY_STATE, &attr ))
+    {
+        NtSetEvent( event, NULL );
+        NtClose( event );
+    }
+    return ret;
+}
+
+/* an event to every session that wants it (logger 0), or to one session */
+static ULONG write_event( const GUID *provider, const EVENT_DESCRIPTOR *descriptor, USHORT flags, const GUID *activity,
+                          const GUID *related, ULONG count, const EVENT_DATA_DESCRIPTOR *data, ULONG logger )
+{
+    struct sg_etw_record *record;
+    ULONG size = 0, i, s, p;
+    LARGE_INTEGER now;
+    BYTE *ptr;
+
+#ifdef SG_MUTANT_NO_EVENT_WRITE
+    return ERROR_SUCCESS;
+#endif
+    for (i = 0; i < count; i++) size += data[i].Size;
+    size = (sizeof(*record) + size + 7) & ~7;
+    if (!(record = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, size ))) return ERROR_NOT_ENOUGH_MEMORY;
+    record->size = size;
+    record->kind = SG_ETW_RECORD_EVENT;
+    record->pointer_size = sizeof(void *);
+    record->header.Size = sizeof(EVENT_HEADER);
+    record->header.Flags = flags | (sizeof(void *) == 8 ? EVENT_HEADER_FLAG_64_BIT_HEADER : EVENT_HEADER_FLAG_32_BIT_HEADER);
+    record->header.ThreadId = HandleToULong( NtCurrentTeb()->ClientId.UniqueThread );
+    record->header.ProcessId = HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess );
+    NtQuerySystemTime( &now );
+    record->header.TimeStamp = now;
+    record->header.ProviderId = *provider;
+    record->header.EventDescriptor = *descriptor;
+    record->header.ActivityId = activity ? *activity : NtCurrentTeb()->ActivityId;
+    if (related)
+    {
+        record->related_activity = *related;
+        record->has_related = 1;
+    }
+    ptr = (BYTE *)(record + 1);
+    for (i = 0; i < count; i++)
+    {
+        if (data[i].Size && data[i].Ptr) memcpy( ptr, (const void *)(ULONG_PTR)data[i].Ptr, data[i].Size );
+        ptr += data[i].Size;
+    }
+    record->user_data_length = ptr - (BYTE *)(record + 1);
+
+    lock_shared();
+    for (s = 0; s < SG_ETW_MAX_SESSIONS; s++)
+    {
+        struct sg_etw_session *session = &shared->sessions[s];
+        BOOL wanted = FALSE;
+
+        if (!session->in_use) continue;
+        if (logger) wanted = session->logger_id == logger;
+        else
+            for (p = 0; p < session->provider_count && p < SG_ETW_MAX_PROVIDERS && !wanted; p++)
+                wanted = IsEqualGUID( &session->providers[p].guid, provider ) &&
+                         level_matches( descriptor->Level, session->providers[p].level ) &&
+                         keywords_match( descriptor->Keyword, session->providers[p].any, session->providers[p].all );
+        if (!wanted) continue;
+        record->header.EventDescriptor = *descriptor;
+        if ((session->mode & EVENT_TRACE_REAL_TIME_MODE) && !write_to_ring( session, record, size ))
+            session->events_lost++;
+        if (session->logfile[0] && !(session->mode & EVENT_TRACE_BUFFERING_MODE))
+            write_to_file( session->logfile, record, size );
+        session->events_written++;
+    }
+    unlock_shared();
+    RtlFreeHeap( GetProcessHeap(), 0, record );
+    return ERROR_SUCCESS;
+}
+
+/* ---- the provider API ---- */
+
+/******************************************************************************
+ *                  EtwEventRegister (NTDLL.@)
+ */
+ULONG WINAPI EtwEventRegister( LPCGUID provider, PENABLECALLBACK callback, PVOID context,
+                PREGHANDLE handle )
+{
+    ULONG_PTR id;
+    ULONG ret;
+
+    TRACE( "(%s, %p, %p, %p)\n", debugstr_guid(provider), callback, context, handle );
+
+    if (!provider || !handle) return ERROR_INVALID_PARAMETER;
+    if ((ret = add_registration( provider, callback, NULL, context, &id ))) return ret;
+    *handle = id;
+    return ERROR_SUCCESS;
+}
+
+/******************************************************************************
+ *                  EtwEventUnregister (NTDLL.@)
+ */
+ULONG WINAPI EtwEventUnregister( REGHANDLE handle )
+{
+    struct etw_reg *reg;
+
+    TRACE( "(%s)\n", wine_dbgstr_longlong(handle) );
+
+    RtlEnterCriticalSection( &etw_cs );
+    if ((reg = get_reg( handle ))) list_remove( &reg->entry );
+    RtlLeaveCriticalSection( &etw_cs );
+    if (!reg) return ERROR_INVALID_HANDLE;
+    RtlFreeHeap( GetProcessHeap(), 0, reg );
+    return ERROR_SUCCESS;
+}
+
+/* is an event of this level and keyword wanted from the provider? */
+static BOOL reg_wants( REGHANDLE handle, UCHAR level, ULONGLONG keyword, GUID *guid )
+{
+    struct etw_reg *reg;
+    BOOL ret = FALSE;
+
+    refresh_registrations( FALSE );
+    RtlEnterCriticalSection( &etw_cs );
+    if ((reg = get_reg( handle )) && reg->enabled)
+    {
+        ret = level_matches( level, reg->level ) && keywords_match( keyword, reg->any, reg->all );
+        if (guid) *guid = reg->guid;
+    }
+    RtlLeaveCriticalSection( &etw_cs );
+    return ret;
+}
+
+/******************************************************************************
+ *                  EtwEventEnabled (NTDLL.@)
+ */
+BOOLEAN WINAPI EtwEventEnabled( REGHANDLE handle, const EVENT_DESCRIPTOR *descriptor )
+{
+    TRACE( "(%s, %p)\n", wine_dbgstr_longlong(handle), descriptor );
+    if (!descriptor) return FALSE;
+    return reg_wants( handle, descriptor->Level, descriptor->Keyword, NULL );
+}
+
+/******************************************************************************
+ *                  EtwEventProviderEnabled (NTDLL.@)
+ */
+BOOLEAN WINAPI EtwEventProviderEnabled( REGHANDLE handle, UCHAR level, ULONGLONG keyword )
+{
+    TRACE( "%s, %u, %s\n", wine_dbgstr_longlong(handle), level, wine_dbgstr_longlong(keyword) );
+    return reg_wants( handle, level, keyword, NULL );
+}
+
+/******************************************************************************
+ *                  EtwEventWriteTransfer   (NTDLL.@)
+ */
+ULONG WINAPI EtwEventWriteTransfer( REGHANDLE handle, PCEVENT_DESCRIPTOR descriptor, LPCGUID activity,
+                                    LPCGUID related, ULONG count, PEVENT_DATA_DESCRIPTOR data )
+{
+    struct etw_reg *reg;
+    GUID guid;
+
+    TRACE( "%s, %p, %s, %s, %lu, %p\n", wine_dbgstr_longlong(handle), descriptor,
+           debugstr_guid(activity), debugstr_guid(related), count, data );
+
+    RtlEnterCriticalSection( &etw_cs );
+    reg = get_reg( handle );
+    RtlLeaveCriticalSection( &etw_cs );
+    if (!reg) return ERROR_INVALID_HANDLE;
+    if (!descriptor || (count && !data)) return ERROR_INVALID_PARAMETER;
+    if (count > 128) return ERROR_INVALID_PARAMETER;
+    /* nobody listening: nothing to write, and that succeeds */
+    if (!reg_wants( handle, descriptor->Level, descriptor->Keyword, &guid )) return ERROR_SUCCESS;
+    return write_event( &guid, descriptor, 0, activity, related, count, data, 0 );
+}
+
+/******************************************************************************
+ *                  EtwEventWrite (NTDLL.@)
+ */
+ULONG WINAPI EtwEventWrite( REGHANDLE handle, const EVENT_DESCRIPTOR *descriptor, ULONG count,
+    EVENT_DATA_DESCRIPTOR *data )
+{
+    TRACE( "(%s, %p, %lu, %p)\n", wine_dbgstr_longlong(handle), descriptor, count, data );
+    return EtwEventWriteTransfer( handle, descriptor, NULL, NULL, count, data );
+}
+
+/******************************************************************************
+ *                  EtwEventWriteString   (NTDLL.@)
+ */
+ULONG WINAPI EtwEventWriteString( REGHANDLE handle, UCHAR level, ULONGLONG keyword, PCWSTR string )
+{
+    EVENT_DESCRIPTOR descriptor;
+    EVENT_DATA_DESCRIPTOR data;
+    struct etw_reg *reg;
+    GUID guid;
+
+    TRACE( "%s, %u, %s, %s\n", wine_dbgstr_longlong(handle), level, wine_dbgstr_longlong(keyword), debugstr_w(string) );
+
+    RtlEnterCriticalSection( &etw_cs );
+    reg = get_reg( handle );
+    RtlLeaveCriticalSection( &etw_cs );
+    if (!reg) return ERROR_INVALID_HANDLE;
+    if (!string) return ERROR_INVALID_PARAMETER;
+    if (!reg_wants( handle, level, keyword, &guid )) return ERROR_SUCCESS;
+    memset( &descriptor, 0, sizeof(descriptor) );
+    descriptor.Level = level;
+    descriptor.Keyword = keyword;
+    data.Ptr = (ULONG_PTR)string;
+    data.Size = (wcslen( string ) + 1) * sizeof(WCHAR);
+    data.Reserved = 0;
+    return write_event( &guid, &descriptor, EVENT_HEADER_FLAG_STRING_ONLY, NULL, NULL, 1, &data, 0 );
+}
+
+/******************************************************************************
+ *                  EtwEventActivityIdControl (NTDLL.@)
+ */
+ULONG WINAPI EtwEventActivityIdControl( ULONG code, GUID *guid )
+{
+    GUID *current = &NtCurrentTeb()->ActivityId, old;
+
+    TRACE( "0x%lx, %p\n", code, guid );
+
+    if (!guid) return ERROR_INVALID_PARAMETER;
+    switch (code)
+    {
+    case EVENT_ACTIVITY_CTRL_GET_ID:
+        *guid = *current;
+        return ERROR_SUCCESS;
+    case EVENT_ACTIVITY_CTRL_SET_ID:
+        *current = *guid;
+        return ERROR_SUCCESS;
+    case EVENT_ACTIVITY_CTRL_CREATE_ID:
+        NtQuerySystemInformation( SystemInterruptInformation, guid, sizeof(*guid), NULL );
+        guid->Data3 = (guid->Data3 & 0x0fff) | 0x4000;  /* a random GUID, version 4 */
+        guid->Data4[0] = (guid->Data4[0] & 0x3f) | 0x80;
+        return ERROR_SUCCESS;
+    case EVENT_ACTIVITY_CTRL_GET_SET_ID:
+        old = *current;
+        *current = *guid;
+        *guid = old;
+        return ERROR_SUCCESS;
+    case EVENT_ACTIVITY_CTRL_CREATE_SET_ID:
+        old = *current;
+        EtwEventActivityIdControl( EVENT_ACTIVITY_CTRL_CREATE_ID, current );
+        *guid = old;
+        return ERROR_SUCCESS;
+    default:
+        return ERROR_INVALID_PARAMETER;
+    }
+}
+
+/*********************************************************************
+ *                  EtwEventSetInformation   (NTDLL.@)
+ */
+ULONG WINAPI EtwEventSetInformation( REGHANDLE handle, EVENT_INFO_CLASS class, void *info,
+                                     ULONG length )
+{
+    TRACE("(%s, %u, %p, %lu)\n", wine_dbgstr_longlong(handle), class, info, length);
+
+    /* a provider's traits and descriptor type are checked, as Windows
+     * checks them: .NET and Chrome set traits on every provider */
+#ifdef SG_MUTANT_NO_ETW_INFO_CHECK
+    return ERROR_SUCCESS;
+#endif
+    switch (class)
+    {
+    case EventProviderBinaryTrackInfo:
+    case EventProviderSetReserved1:
+        return ERROR_SUCCESS;
+    case EventProviderSetTraits:
+        /* the traits blob starts with its own total size */
+        if (!info || length < sizeof(USHORT) || *(USHORT *)info != length) return ERROR_INVALID_PARAMETER;
+        return ERROR_SUCCESS;
+    case EventProviderUseDescriptorType:
+        if (!info || length != sizeof(BOOLEAN)) return ERROR_INVALID_PARAMETER;
+        return ERROR_SUCCESS;
+    default:
+        return ERROR_NOT_SUPPORTED;
+    }
+}
+
+/* ---- classic providers ---- */
+
+/******************************************************************************
+ *                  EtwRegisterTraceGuidsW (NTDLL.@)
+ */
+ULONG WINAPI EtwRegisterTraceGuidsW( WMIDPREQUEST RequestAddress,
+                void *RequestContext, const GUID *ControlGuid, ULONG GuidCount,
+                TRACE_GUID_REGISTRATION *TraceGuidReg, const WCHAR *MofImagePath,
+                const WCHAR *MofResourceName, TRACEHANDLE *RegistrationHandle )
+{
+    static LONG trace_registrations;
+    ULONG_PTR id;
+    ULONG ret, i;
+
+    TRACE("(%p, %p, %s, %lu, %p, %s, %s, %p)\n", RequestAddress, RequestContext,
+          debugstr_guid(ControlGuid), GuidCount, TraceGuidReg, debugstr_w(MofImagePath),
+          debugstr_w(MofResourceName), RegistrationHandle);
+
+    if (!RequestAddress || !ControlGuid || !RegistrationHandle || (GuidCount && !TraceGuidReg))
+        return ERROR_INVALID_PARAMETER;
+
+    for (i = 0; TraceGuidReg && i < GuidCount; i++)
+    {
+        if (!TraceGuidReg[i].Guid) return ERROR_INVALID_PARAMETER;
+#ifndef SG_MUTANT_ETW_FIXED_HANDLES
+        TraceGuidReg[i].RegHandle = ULongToHandle( 0x10000 + InterlockedIncrement( &trace_registrations ) );
+#else
+        TraceGuidReg[i].RegHandle = (HANDLE)0xdeadbeef;
+#endif
+    }
+    if ((ret = add_registration( ControlGuid, NULL, RequestAddress, RequestContext, &id ))) return ret;
+#ifndef SG_MUTANT_ETW_FIXED_HANDLES
+    *RegistrationHandle = id;
+#else
+    *RegistrationHandle = (TRACEHANDLE)0xdeadbeef;
+#endif
+    return ERROR_SUCCESS;
+}
+
+/******************************************************************************
+ *                  EtwRegisterTraceGuidsA (NTDLL.@)
+ */
+ULONG WINAPI EtwRegisterTraceGuidsA( WMIDPREQUEST RequestAddress,
+                void *RequestContext, const GUID *ControlGuid, ULONG GuidCount,
+                TRACE_GUID_REGISTRATION *TraceGuidReg, const char *MofImagePath,
+                const char *MofResourceName, TRACEHANDLE *RegistrationHandle )
+{
+    WCHAR *image = NULL, *resource = NULL;
+    ULONG ret;
+    DWORD len;
+
+    if (MofImagePath)
+    {
+        len = strlen( MofImagePath ) + 1;
+        if ((image = RtlAllocateHeap( GetProcessHeap(), 0, len * sizeof(WCHAR) )))
+            RtlMultiByteToUnicodeN( image, len * sizeof(WCHAR), NULL, MofImagePath, len );
+    }
+    if (MofResourceName)
+    {
+        len = strlen( MofResourceName ) + 1;
+        if ((resource = RtlAllocateHeap( GetProcessHeap(), 0, len * sizeof(WCHAR) )))
+            RtlMultiByteToUnicodeN( resource, len * sizeof(WCHAR), NULL, MofResourceName, len );
+    }
+    ret = EtwRegisterTraceGuidsW( RequestAddress, RequestContext, ControlGuid, GuidCount, TraceGuidReg,
+                                  image, resource, RegistrationHandle );
+    RtlFreeHeap( GetProcessHeap(), 0, image );
+    RtlFreeHeap( GetProcessHeap(), 0, resource );
+    return ret;
+}
+
+/******************************************************************************
+ *                  EtwUnregisterTraceGuids (NTDLL.@)
+ */
+ULONG WINAPI EtwUnregisterTraceGuids( TRACEHANDLE RegistrationHandle )
+{
+    TRACE("%s\n", wine_dbgstr_longlong(RegistrationHandle));
+    if (!RegistrationHandle) return ERROR_INVALID_PARAMETER;
+    EtwEventUnregister( RegistrationHandle );
+    return ERROR_SUCCESS;
+}
+
+/* the classic provider a session's logger handle was given to */
+static struct etw_reg *classic_reg( TRACEHANDLE logger )
+{
+    struct etw_reg *reg;
+    LIST_FOR_EACH_ENTRY( reg, &registrations, struct etw_reg, entry )
+        if (reg->classic && reg->enabled && reg->classic_logger == logger) return reg;
+    return NULL;
+}
+
+/******************************************************************************
+ *                  EtwGetTraceLoggerHandle (NTDLL.@)
+ */
+TRACEHANDLE WINAPI EtwGetTraceLoggerHandle( PVOID buf )
+{
+    WNODE_HEADER *header = buf;
+
+    TRACE( "(%p)\n", buf );
+    if (!header || !header->HistoricalContext)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return INVALID_PROCESSTRACE_HANDLE;
+    }
+    return header->HistoricalContext;
+}
+
+/******************************************************************************
+ *                  EtwGetTraceEnableFlags (NTDLL.@)
+ */
+ULONG WINAPI EtwGetTraceEnableFlags( TRACEHANDLE handle )
+{
+    struct etw_reg *reg;
+    ULONG ret = 0;
+
+    TRACE( "(%s)\n", wine_dbgstr_longlong(handle) );
+    RtlEnterCriticalSection( &etw_cs );
+    if ((reg = classic_reg( handle ))) ret = reg->classic_flags;
+    RtlLeaveCriticalSection( &etw_cs );
+    if (!reg) RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+    else RtlSetLastWin32Error( ERROR_SUCCESS );
+    return ret;
+}
+
+/******************************************************************************
+ *                  EtwGetTraceEnableLevel (NTDLL.@)
+ */
+UCHAR WINAPI EtwGetTraceEnableLevel( TRACEHANDLE handle )
+{
+    struct etw_reg *reg;
+    UCHAR ret = 0;
+
+    TRACE( "(%s)\n", wine_dbgstr_longlong(handle) );
+    RtlEnterCriticalSection( &etw_cs );
+    if ((reg = classic_reg( handle ))) ret = reg->classic_level;
+    RtlLeaveCriticalSection( &etw_cs );
+    RtlSetLastWin32Error( reg ? ERROR_SUCCESS : ERROR_INVALID_HANDLE );
+    return ret;
+}
+
+/******************************************************************************
+ *                  EtwLogTraceEvent (NTDLL.@)
+ */
+ULONG WINAPI EtwLogTraceEvent( TRACEHANDLE SessionHandle, PEVENT_TRACE_HEADER EventTrace )
+{
+    EVENT_DESCRIPTOR descriptor;
+    EVENT_DATA_DESCRIPTOR data[16];
+    ULONG count = 0;
+
+    TRACE( "%s %p\n", wine_dbgstr_longlong(SessionHandle), EventTrace );
+
+    if (!EventTrace) return ERROR_INVALID_PARAMETER;
+    if (!SessionHandle || SessionHandle == INVALID_PROCESSTRACE_HANDLE) return ERROR_INVALID_HANDLE;
+    if (EventTrace->Size < sizeof(*EventTrace)) return ERROR_INVALID_PARAMETER;
+    if (!map_shared()) return ERROR_INVALID_HANDLE;
+
+    memset( &descriptor, 0, sizeof(descriptor) );
+    descriptor.Opcode = EventTrace->Class.Type;
+    descriptor.Level = EventTrace->Class.Level;
+    descriptor.Version = (UCHAR)EventTrace->Class.Version;
+    if (EventTrace->Flags & WNODE_FLAG_USE_MOF_PTR)
+    {
+        /* MOF_FIELDs after the header: pointers to the data */
+        const MOF_FIELD *fields = (const MOF_FIELD *)(EventTrace + 1);
+        ULONG n = (EventTrace->Size - sizeof(*EventTrace)) / sizeof(MOF_FIELD), i;
+        for (i = 0; i < n && count < ARRAY_SIZE(data); i++)
+        {
+            data[count].Ptr = fields[i].DataPtr;
+            data[count].Size = fields[i].Length;
+            data[count++].Reserved = 0;
+        }
+    }
+    else if (EventTrace->Size > sizeof(*EventTrace))
+    {
+        data[0].Ptr = (ULONG_PTR)(EventTrace + 1);
+        data[0].Size = EventTrace->Size - sizeof(*EventTrace);
+        data[0].Reserved = 0;
+        count = 1;
+    }
+    return write_event( (EventTrace->Flags & WNODE_FLAG_USE_GUID_PTR) ? (const GUID *)(ULONG_PTR)EventTrace->GuidPtr
+                                                                     : &EventTrace->Guid,
+                        &descriptor, EVENT_HEADER_FLAG_CLASSIC_HEADER, NULL, NULL, count, data,
+                        (ULONG)SessionHandle );
+}
+
+/******************************************************************************
+ *                  EtwTraceMessageVa (NTDLL.@)
+ */
+ULONG WINAPI EtwTraceMessageVa( TRACEHANDLE handle, ULONG flags, LPGUID guid, USHORT number,
+                                va_list args )
+{
+    EVENT_DESCRIPTOR descriptor;
+    EVENT_DATA_DESCRIPTOR data[32];
+    ULONG count = 0;
+    void *ptr;
+
+    TRACE( "(%s %lx %s %d)\n", wine_dbgstr_longlong(handle), flags, debugstr_guid(guid), number );
+
+    if (!handle || handle == INVALID_PROCESSTRACE_HANDLE) return ERROR_INVALID_HANDLE;
+    if (!map_shared()) return ERROR_INVALID_HANDLE;
+    /* the arguments: pointer, size pairs, ending with a NULL pointer */
+    while ((ptr = va_arg( args, void * )) && count < ARRAY_SIZE(data))
+    {
+        data[count].Ptr = (ULONG_PTR)ptr;
+        data[count].Size = va_arg( args, SIZE_T );
+        data[count++].Reserved = 0;
+    }
+    memset( &descriptor, 0, sizeof(descriptor) );
+    descriptor.Id = number;
+    return write_event( guid ? guid : &GUID_NULL_ETW, &descriptor, EVENT_HEADER_FLAG_TRACE_MESSAGE, NULL, NULL, count, data,
+                        (ULONG)handle );
+}
+
+/******************************************************************************
+ *                  EtwTraceMessage (NTDLL.@)
+ */
+ULONG WINAPIV EtwTraceMessage( TRACEHANDLE handle, ULONG flags, LPGUID guid, /*USHORT*/ ULONG number, ... )
+{
+    va_list valist;
+    ULONG ret;
+
+    va_start( valist, number );
+    ret = EtwTraceMessageVa( handle, flags, guid, number, valist );
+    va_end( valist );
+    return ret;
+}
