+/* the log file's own first event: EventTraceGuid with the header */
+static void deliver_header( struct consumer *consumer )
+{
+    struct { struct sg_etw_record record; TRACE_LOGFILE_HEADER header; } ev;
+
+    memset( &ev, 0, sizeof(ev) );
+    ev.record.size = sizeof(ev);
+    ev.record.kind = SG_ETW_RECORD_HEADER;
+    ev.record.header.Size = sizeof(EVENT_HEADER);
+    ev.record.header.Flags = EVENT_HEADER_FLAG_CLASSIC_HEADER |
+                             (sizeof(void *) == 8 ? EVENT_HEADER_FLAG_64_BIT_HEADER : EVENT_HEADER_FLAG_32_BIT_HEADER);
+    ev.record.header.TimeStamp.QuadPart = consumer->header.start_time;
+    ev.record.header.ProviderId = EventTraceGuid;
+    ev.record.header.ProcessId = GetCurrentProcessId();
+    ev.record.user_data_length = sizeof(TRACE_LOGFILE_HEADER);
+    ev.header = consumer->logfile.LogfileHeader;
+    deliver( consumer, &ev.record );
