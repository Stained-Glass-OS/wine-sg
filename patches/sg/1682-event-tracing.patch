+/* Stained Glass OS 1682: trace sessions and their consumers, as documented.
+ * StartTrace makes a session -- with a log file, a real-time ring, or both
+ * -- that EnableTraceEx2 enables providers in; ControlTrace queries, flushes,
+ * updates and stops it; QueryAllTraces lists them. OpenTrace opens a log
+ * file or a real-time session, and ProcessTrace hands its events to the
+ * consumer's callbacks until the file ends, the session stops or CloseTrace
+ * is called. The sessions are shared with every process's providers
+ * (ntdll/etw.c, include/wine/sg_etw.h). */
+
 #include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
 #include "windef.h"
 #include "winbase.h"
+#include "winnls.h"
+#include "winternl.h"
 #include "wmistr.h"
 #define _WMI_SOURCE_
+#include "initguid.h"
 #include "evntrace.h"
+#include "evntprov.h"
+#include "evntcons.h"
+#include "wine/sg_etw.h"
 
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(eventlog);
 
+static struct sg_etw_shared *shared;
+static HANDLE shared_mutex;
+
+static void named_object( WCHAR *buffer, const WCHAR *path, ULONG suffix, BOOL with_suffix )
+{
+    const WCHAR *name = path + wcslen( L"\\BaseNamedObjects\\" );
+    if (with_suffix)
+        swprintf( buffer, 128, L"\\Sessions\\%u\\BaseNamedObjects\\%s%u", NtCurrentTeb()->Peb->SessionId, name, suffix );
+    else
+        swprintf( buffer, 128, L"\\Sessions\\%u\\BaseNamedObjects\\%s", NtCurrentTeb()->Peb->SessionId, name );
+}
+
+static BOOL map_shared(void)
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING str;
+    WCHAR buffer[128];
+    HANDLE section;
+    void *ptr;
+
+    if (shared) return TRUE;
+    named_object( buffer, SG_ETW_MUTEX_NAME, 0, FALSE );
+    RtlInitUnicodeString( &str, buffer );
+    InitializeObjectAttributes( &attr, &str, OBJ_OPENIF, 0, NULL );
+    if (!shared_mutex && NtCreateMutant( &shared_mutex, MUTANT_ALL_ACCESS, &attr, FALSE ) < 0) return FALSE;
+    named_object( buffer, SG_ETW_SECTION_NAME, 0, FALSE );
+    if (!(ptr = sg_etw_map( buffer, L"SgEtwControl.dat", sizeof(struct sg_etw_shared), &section ))) return FALSE;
+    shared = ptr;
+    return TRUE;
+}
+
+static void lock_shared(void)
+{
+    WaitForSingleObject( shared_mutex, INFINITE );
+    sg_etw_check_boot( shared );
+}
+
+static void unlock_shared(void)
+{
+    ReleaseMutex( shared_mutex );
+}
+
+/* every process with providers looks again; with the section locked */
+static void notify_providers(void)
+{
+    WCHAR buffer[128];
+    UNICODE_STRING str;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE event;
+    unsigned int i = 0;
+
+    shared->generation++;
+    while (i < shared->process_count && i < SG_ETW_MAX_PROCESSES)
+    {
+        named_object( buffer, SG_ETW_NOTIFY_PREFIX, shared->processes[i], TRUE );
+        RtlInitUnicodeString( &str, buffer );
+        InitializeObjectAttributes( &attr, &str, 0, 0, NULL );
+        if (!NtOpenEvent( &event, EVENT_MODIFY_STATE, &attr ))
+        {
+            NtSetEvent( event, NULL );
+            CloseHandle( event );
+            i++;
+        }
+        else  /* that process has gone */
+            shared->processes[i] = shared->processes[--shared->process_count];
+    }
+}
+
+static struct sg_etw_session *find_session( TRACEHANDLE handle, const WCHAR *name )
+{
+    unsigned int i;
+
+    for (i = 0; i < SG_ETW_MAX_SESSIONS; i++)
+    {
+        struct sg_etw_session *session = &shared->sessions[i];
+        if (!session->in_use) continue;
+        if (name && name[0] && !wcsicmp( session->name, name )) return session;
+        if ((!name || !name[0]) && handle && session->logger_id == handle) return session;
+    }
+    return NULL;
+}
+
+/* ---- sessions ---- */
+
+static void fill_properties( const struct sg_etw_session *session, EVENT_TRACE_PROPERTIES *props )
+{
+    props->Wnode.HistoricalContext = session->logger_id;
+    props->Wnode.Guid = session->guid;
+    props->BufferSize = session->buffer_size;
+    props->MinimumBuffers = session->min_buffers;
+    props->MaximumBuffers = session->max_buffers;
+    props->MaximumFileSize = session->max_file_size;
+    props->LogFileMode = session->mode;
+    props->FlushTimer = session->flush_timer;
+    props->EnableFlags = session->enable_flags;
+    props->AgeLimit = session->age_limit;
+    props->NumberOfBuffers = session->min_buffers;
+    props->FreeBuffers = session->min_buffers;
+    props->EventsLost = session->events_lost;
+    props->BuffersWritten = session->buffers_written;
+    props->LogBuffersLost = 0;
+    props->RealTimeBuffersLost = 0;
+    props->LoggerThreadId = 0;
+    /* the names, where the caller has room for them */
+    if (props->LoggerNameOffset >= sizeof(*props) &&
+        props->LoggerNameOffset + (wcslen( session->name ) + 1) * sizeof(WCHAR) <= props->Wnode.BufferSize)
+        wcscpy( (WCHAR *)((BYTE *)props + props->LoggerNameOffset), session->name );
+    if (props->LogFileNameOffset >= sizeof(*props) &&
+        props->LogFileNameOffset + (wcslen( session->logfile ) + 1) * sizeof(WCHAR) <= props->Wnode.BufferSize)
+        wcscpy( (WCHAR *)((BYTE *)props + props->LogFileNameOffset), session->logfile );
+}
+
+static ULONG create_ring( ULONG logger_id, HANDLE *section_ret, HANDLE *event_ret )
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING str;
+    WCHAR buffer[128], leaf[64];
+    struct sg_etw_ring *ring;
+
+    named_object( buffer, SG_ETW_RING_PREFIX, logger_id, TRUE );
+    swprintf( leaf, ARRAY_SIZE(leaf), L"SgEtwRing%u.dat", logger_id );
+    if (!(ring = sg_etw_map( buffer, leaf, offsetof(struct sg_etw_ring, data[SG_ETW_RING_SIZE]), section_ret )))
+        return ERROR_NO_SYSTEM_RESOURCES;
+    ring->head = ring->tail = ring->lost = 0;
+    ring->size = SG_ETW_RING_SIZE;
+    NtUnmapViewOfSection( GetCurrentProcess(), ring );
+    named_object( buffer, SG_ETW_RING_EVENT_PREFIX, logger_id, TRUE );
+    RtlInitUnicodeString( &str, buffer );
+    InitializeObjectAttributes( &attr, &str, OBJ_OPENIF, 0, NULL );
+    if (NtCreateEvent( event_ret, EVENT_ALL_ACCESS, &attr, SynchronizationEvent, FALSE ))
+    {
+        CloseHandle( *section_ret );
+        return ERROR_NO_SYSTEM_RESOURCES;
+    }
+    return ERROR_SUCCESS;
+}
+
+/* the ring's objects live while some process holds them: the session's
+ * starter keeps them for the session's life */
+static struct { ULONG logger_id; HANDLE section, event; } rings[SG_ETW_MAX_SESSIONS];
+
+static void keep_ring( ULONG logger_id, HANDLE section, HANDLE event )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(rings); i++)
+        if (!rings[i].logger_id)
+        {
+            rings[i].logger_id = logger_id;
+            rings[i].section = section;
+            rings[i].event = event;
+            return;
+        }
+    CloseHandle( section );
+    CloseHandle( event );
+}
+
+static void drop_ring( ULONG logger_id )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(rings); i++)
+        if (rings[i].logger_id == logger_id)
+        {
+            /* wake a consumer, which sees the session gone */
+            SetEvent( rings[i].event );
+            CloseHandle( rings[i].section );
+            CloseHandle( rings[i].event );
+            rings[i].logger_id = 0;
+        }
+}
+
+static ULONG start_trace( TRACEHANDLE *handle, const WCHAR *name, const WCHAR *logfile,
+                          EVENT_TRACE_PROPERTIES *props )
+{
+    struct sg_etw_file_header header;
+    struct sg_etw_session *session = NULL;
+    HANDLE ring_section = 0, ring_event = 0, file;
+    WCHAR full[MAX_PATH];
+    unsigned int i;
+    ULONG ret;
+    DWORD written;
+
+    if (!map_shared()) return ERROR_NO_SYSTEM_RESOURCES;
+    if (logfile && logfile[0])
+    {
+        if (!GetFullPathNameW( logfile, MAX_PATH, full, NULL )) return ERROR_BAD_PATHNAME;
+        logfile = full;
+    }
+
+    lock_shared();
+    if (find_session( 0, name ))
+    {
+        unlock_shared();
+        return ERROR_ALREADY_EXISTS;
+    }
+    for (i = 0; i < SG_ETW_MAX_SESSIONS; i++)
+        if (!shared->sessions[i].in_use)
+        {
+            session = &shared->sessions[i];
+            break;
+        }
+    if (!session)
+    {
+        unlock_shared();
+        return ERROR_NO_SYSTEM_RESOURCES;
+    }
+    memset( session, 0, sizeof(*session) );
+    if (!shared->next_logger_id) shared->next_logger_id = 2;  /* 0 and 1 are never loggers */
+    session->logger_id = shared->next_logger_id++;
+    session->mode = props->LogFileMode;
+    session->buffer_size = props->BufferSize ? props->BufferSize : 64;
+    session->min_buffers = props->MinimumBuffers ? props->MinimumBuffers : 4;
+    session->max_buffers = max( props->MaximumBuffers, session->min_buffers );
+    session->max_file_size = props->MaximumFileSize;
+    session->flush_timer = props->FlushTimer;
+    session->enable_flags = props->EnableFlags;
+    session->age_limit = props->AgeLimit;
+    session->guid = props->Wnode.Guid;
+    GetSystemTimeAsFileTime( (FILETIME *)&session->start_time );
+    lstrcpynW( session->name, name, SG_ETW_NAME_LEN );
+    if (logfile) lstrcpynW( session->logfile, logfile, MAX_PATH );
+
+    if (session->logfile[0])
+    {
+        /* the log file starts with its header */
+        file = CreateFileW( session->logfile, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                            NULL, (session->mode & EVENT_TRACE_FILE_MODE_APPEND) ? OPEN_ALWAYS : CREATE_ALWAYS,
+                            FILE_ATTRIBUTE_NORMAL, NULL );
+        if (file == INVALID_HANDLE_VALUE)
+        {
+            ret = GetLastError() == ERROR_PATH_NOT_FOUND ? ERROR_BAD_PATHNAME : GetLastError();
+            session->in_use = 0;
+            unlock_shared();
+            return ret;
+        }
+        if (!GetFileSize( file, NULL ))
+        {
+            memset( &header, 0, sizeof(header) );
+            memcpy( header.magic, SG_ETW_FILE_MAGIC, sizeof(header.magic) );
+            header.version = 1;
+            header.mode = session->mode;
+            header.start_time = session->start_time;
+            header.pointer_size = sizeof(void *);
+            header.buffer_size = session->buffer_size;
+            lstrcpynW( header.logger_name, session->name, SG_ETW_NAME_LEN );
+            WriteFile( file, &header, sizeof(header), &written, NULL );
+        }
+        CloseHandle( file );
+    }
+    if ((session->mode & EVENT_TRACE_REAL_TIME_MODE) &&
+        (ret = create_ring( session->logger_id, &ring_section, &ring_event )))
+    {
+        unlock_shared();
+        return ret;
+    }
+    session->in_use = 1;
+    *handle = session->logger_id;
+    fill_properties( session, props );
+    notify_providers();
+    unlock_shared();
+    if (ring_section) keep_ring( *handle, ring_section, ring_event );
+    TRACE( "session %s: logger %s, mode %#lx, file %s\n", debugstr_w(name), wine_dbgstr_longlong(*handle),
+           props->LogFileMode, debugstr_w(logfile) );
+    return ERROR_SUCCESS;
+}
+
+/* the checks StartTrace makes of its properties (Wine's tests show them) */
+static ULONG check_start_properties( const void *name, BOOL ansi, EVENT_TRACE_PROPERTIES *props )
+{
+    SIZE_T name_size;
+
+    if (!props || !name) return ERROR_INVALID_PARAMETER;
+    if (props->Wnode.BufferSize < sizeof(*props)) return ERROR_BAD_LENGTH;
+    name_size = ansi ? strlen( name ) + 1 : (wcslen( name ) + 1) * sizeof(WCHAR);
+    if (props->LoggerNameOffset && props->LoggerNameOffset < sizeof(*props)) return ERROR_INVALID_PARAMETER;
+    if (props->LogFileNameOffset && props->LogFileNameOffset < sizeof(*props)) return ERROR_INVALID_PARAMETER;
+    if (props->LoggerNameOffset && props->LoggerNameOffset + name_size > props->Wnode.BufferSize)
+        return ERROR_BAD_LENGTH;
+    if (name_size > SG_ETW_NAME_LEN * (ansi ? 1 : sizeof(WCHAR))) return ERROR_BAD_LENGTH;
+    if ((props->LogFileMode & EVENT_TRACE_FILE_MODE_SEQUENTIAL) && (props->LogFileMode & EVENT_TRACE_FILE_MODE_CIRCULAR))
+        return ERROR_INVALID_PARAMETER;
+    if (IsEqualGUID( &props->Wnode.Guid, &SystemTraceControlGuid ) &&
+        (ansi ? strcmp( name, KERNEL_LOGGER_NAMEA ) : wcscmp( name, KERNEL_LOGGER_NAMEW )))
+        return ERROR_INVALID_PARAMETER;
+    if (!props->LogFileNameOffset &&
+        !(props->LogFileMode & (EVENT_TRACE_REAL_TIME_MODE | EVENT_TRACE_BUFFERING_MODE)))
+        return ERROR_BAD_PATHNAME;
+    return ERROR_SUCCESS;
+}
+
 /******************************************************************************
- *     ControlTraceA   (sechost.@)
+ *     StartTraceW   (sechost.@)
  */
-ULONG WINAPI ControlTraceA( TRACEHANDLE handle, const char *session,
-                            EVENT_TRACE_PROPERTIES *properties, ULONG control )
+ULONG WINAPI StartTraceW( TRACEHANDLE *handle, const WCHAR *session, EVENT_TRACE_PROPERTIES *properties )
+{
+    const WCHAR *logfile = NULL;
+    ULONG ret;
+
+    TRACE("(%p, %s, %p)\n", handle, debugstr_w(session), properties);
+
+    if (!handle) return ERROR_INVALID_PARAMETER;
+    if ((ret = check_start_properties( session, FALSE, properties ))) return ret;
+    if (properties->LogFileNameOffset) logfile = (const WCHAR *)((BYTE *)properties + properties->LogFileNameOffset);
+#ifdef SG_MUTANT_NO_SESSIONS
+    *handle = 0xcafe4242;
+    return ERROR_SUCCESS;
+#endif
+    return start_trace( handle, session, logfile, properties );
+}
+
+static WCHAR *strdupAW( const char *str )
+{
+    WCHAR *ret;
+    int len;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar( CP_ACP, 0, str, -1, NULL, 0 );
+    if ((ret = malloc( len * sizeof(WCHAR) ))) MultiByteToWideChar( CP_ACP, 0, str, -1, ret, len );
+    return ret;
+}
+
+/* the properties with the A names converted, so the session's W names fit
+ * where the caller's ANSI ones were */
+static void write_names_a( EVENT_TRACE_PROPERTIES *props, const struct sg_etw_session *session )
+{
+    if (props->LoggerNameOffset >= sizeof(*props))
+        WideCharToMultiByte( CP_ACP, 0, session->name, -1, (char *)props + props->LoggerNameOffset,
+                             props->Wnode.BufferSize - props->LoggerNameOffset, NULL, NULL );
+    if (props->LogFileNameOffset >= sizeof(*props) && props->LogFileNameOffset < props->Wnode.BufferSize)
+        WideCharToMultiByte( CP_ACP, 0, session->logfile, -1, (char *)props + props->LogFileNameOffset,
+                             props->Wnode.BufferSize - props->LogFileNameOffset, NULL, NULL );
+}
+
+/******************************************************************************
+ *     StartTraceA   (sechost.@)
+ */
+ULONG WINAPI StartTraceA( TRACEHANDLE *handle, const char *session, EVENT_TRACE_PROPERTIES *properties )
+{
+    EVENT_TRACE_PROPERTIES copy;
+    WCHAR *name, *logfile = NULL;
+    struct sg_etw_session *s;
+    ULONG ret;
+
+    TRACE("(%p, %s, %p)\n", handle, debugstr_a(session), properties);
+
+    if (!handle) return ERROR_INVALID_PARAMETER;
+    if ((ret = check_start_properties( session, TRUE, properties ))) return ret;
+    name = strdupAW( session );
+    if (properties->LogFileNameOffset) logfile = strdupAW( (const char *)properties + properties->LogFileNameOffset );
+    /* the W names go nowhere near the caller's buffer */
+    copy = *properties;
+    copy.LoggerNameOffset = copy.LogFileNameOffset = 0;
