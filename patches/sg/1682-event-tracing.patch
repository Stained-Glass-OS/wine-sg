+/* one event to the consumer's callback */
+static void deliver( struct consumer *consumer, struct sg_etw_record *record )
+{
+    EVENT_TRACE_LOGFILEW *logfile = &consumer->logfile;
+    EVENT_HEADER_EXTENDED_DATA_ITEM ext;
+    EVENT_RECORD event;
+
+#ifdef SG_MUTANT_NO_DELIVERY
+    return;
+#endif
+    if (logfile->ProcessTraceMode & PROCESS_TRACE_MODE_EVENT_RECORD)
+    {
+        if (!logfile->EventRecordCallback) return;
+        memset( &event, 0, sizeof(event) );
+        event.EventHeader = record->header;
+        event.BufferContext.LoggerId = (USHORT)consumer->logger_id;
+        event.UserDataLength = (USHORT)min( record->user_data_length, 0xffff );
+        event.UserData = event.UserDataLength ? (void *)(record + 1) : NULL;
+        event.UserContext = logfile->Context;
+        if (record->has_related)
+        {
+            ext.Reserved1 = 0;
+            ext.ExtType = EVENT_HEADER_EXT_TYPE_RELATED_ACTIVITYID;
+            ext.Linkage = 0;
+            ext.DataSize = sizeof(GUID);
+            ext.DataPtr = (ULONG_PTR)&record->related_activity;
+            event.ExtendedData = &ext;
+            event.ExtendedDataCount = 1;
+            event.EventHeader.Flags |= EVENT_HEADER_FLAG_EXTENDED_INFO;
+        }
+        logfile->EventRecordCallback( &event );
+    }
+    else if (logfile->EventCallback)
+    {
+        /* the classic view of it */
+        EVENT_TRACE *trace = &logfile->CurrentEvent;
+
+        memset( trace, 0, sizeof(*trace) );
+        trace->Header.Size = sizeof(EVENT_TRACE_HEADER) + record->user_data_length;
+        trace->Header.Class.Type = record->header.EventDescriptor.Opcode;
+        trace->Header.Class.Level = record->header.EventDescriptor.Level;
+        trace->Header.Class.Version = record->header.EventDescriptor.Version;
+        trace->Header.ThreadId = record->header.ThreadId;
+        trace->Header.ProcessId = record->header.ProcessId;
+        trace->Header.TimeStamp = record->header.TimeStamp;
+        trace->Header.Guid = record->header.ProviderId;
+        trace->MofData = record->user_data_length ? (void *)(record + 1) : NULL;
+        trace->MofLength = record->user_data_length;
+        if (consumer->logfile_a) consumer->logfile_a->CurrentEvent = *trace;
+        logfile->EventCallback( trace );
+    }
+    logfile->CurrentTime = record->header.TimeStamp.QuadPart;
