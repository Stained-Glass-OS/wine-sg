From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, explorer: the taskbar frosted with Transparency effects

Settings > Personalization > Colors > Transparency effects did nothing:
nothing read EnableTransparency (David: the effects switches did not
work). On Windows it frosts the taskbar and Start. The desktop's
compositor (sg-compositor's sg-deskcomp) can now: winex11 hands a window
prop __wine_sg_acrylic (an opacity in percent, set with a frame change) on
to the X window as _SG_ACRYLIC, and sg-deskcomp blurs what is below such a
window and lays it over that, see-through by the rest. The taskbar sets it
while EnableTransparency is on (the default) -- 85%, the Glass look's 72%,
none for Horizon -- read again on "ImmersiveColorSet" and "TraySettings".
---
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -1009,6 +1009,25 @@
         XChangeProperty( data->display, data->whole_window, shadow_atom, XA_CARDINAL, 32,
                          PropModeReplace, (unsigned char *)&shadow, 1 );
     }
+    {
+        /* Stained Glass OS: a frosted window (the taskbar's and Start's
+         * "Transparency effects"): the window prop __wine_sg_acrylic, its
+         * opacity in percent, set by the shell with a frame change, becomes
+         * _SG_ACRYLIC for the desktop's compositor, which blurs what is below
+         * the window and lays it over that, see-through by the rest */
+        static const WCHAR acrylicW[] = {'_','_','w','i','n','e','_','s','g','_','a','c','r','y','l','i','c',0};
+        static Atom acrylic_atom;
+        unsigned long acrylic = (ULONG_PTR)NtUserGetProp( data->hwnd, acrylicW );
+        if (!acrylic_atom) acrylic_atom = XInternAtom( data->display, "_SG_ACRYLIC", False );
+#ifdef SG_MUTANT_NOACRYLIC
+        acrylic = 0;
+#endif
+        if (acrylic && acrylic < 100)
+            XChangeProperty( data->display, data->whole_window, acrylic_atom, XA_CARDINAL, 32,
+                             PropModeReplace, (unsigned char *)&acrylic, 1 );
+        else
+            XDeleteProperty( data->display, data->whole_window, acrylic_atom );
+    }
 
     if ((wm_hints = XAllocWMHints()))
     {
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -2851,6 +2851,26 @@
     }
 }
 
+/* Stained Glass OS: Settings > Personalization > Colors "Transparency
+ * effects" (EnableTransparency, on unless turned off): the bar frosted --
+ * the desktop's compositor (sg-compositor's sg-deskcomp) blurs what is below
+ * it and lays it over that, see-through by a little, as Windows' shell's
+ * bar is; the Glass look's more, Horizon's not at all (its era had none).
+ * winex11 (0745) hands the window prop __wine_sg_acrylic on as _SG_ACRYLIC
+ * at a frame change. */
+static void sg_apply_transparency(void)
+{
+    DWORD on = 1, size = sizeof(on);
+    UINT percent;
+
+    RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
+                  L"EnableTransparency", RRF_RT_REG_DWORD, NULL, &on, &size );
+    percent = !on || sg_look == SG_LOOK_HORIZON ? 0 : sg_look == SG_LOOK_GLASS ? 72 : 85;
+    if (percent) SetPropW( tray_window, L"__wine_sg_acrylic", (HANDLE)(UINT_PTR)percent );
+    else RemovePropW( tray_window, L"__wine_sg_acrylic" );
+    SetWindowPos( tray_window, 0, 0, 0, 0, 0, SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE );
+}
+
 /* Stained Glass OS: the app mode decides the visual style's colour scheme
  * (uxtheme's RefreshImmersiveColorPolicyState, ordinal 104, switches it for
  * every program); the shell applies it when it starts and on
@@ -3335,6 +3355,7 @@
             sg_load_mode();
             /* the Rounded style's taller bar; another look's height */
             if (sg_rounded != was_rounded || sg_look != was_look) do_show_systray();
+            sg_apply_transparency();
             RedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN );
             sg_apply_app_mode();
             /* the switch's repaint can leave the desktop's icons painted over
@@ -3346,6 +3367,7 @@
         {
             sg_load_settings();
             sg_load_mode();     /* the taskbar's colour */
+            sg_apply_transparency();
             sg_reload_pins();   /* and what is pinned to it (Start pins too) */
             sg_hidden = FALSE;
             sg_away = 0;
@@ -3590,6 +3612,7 @@
         sg_load_settings();
         sg_apply_app_mode();
         sg_watch_windows();
+        sg_apply_transparency();
 #ifndef SG_MUTANT_NODEFAULTPINS
         pins_seed_defaults();
 #endif
