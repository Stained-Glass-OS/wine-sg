+/* Stained Glass OS: one remembered drive (HKCU\Network\<letter>) connected
+ * again -- as the signed-in user (a guest, or their Kerberos ticket on a
+ * domain), else with the name and password saved for its server ("Remember
+ * my credentials", net use /savecred) */
+static DWORD restore_one( HKEY network, const WCHAR *letter )
+{
+    WCHAR local[3] = { letter[0], ':', 0 }, remote[MAX_PATH], server[MAX_PATH], *end;
+    DWORD size = sizeof(remote), ret;
+    NETRESOURCEW res = { 0 };
+    CREDENTIALW *cred;
+    HKEY key;
+
+    if (RegOpenKeyExW( network, letter, 0, KEY_READ, &key )) return WN_BAD_LOCALNAME;
+    ret = RegQueryValueExW( key, L"RemotePath", NULL, NULL, (BYTE *)remote, &size );
+    RegCloseKey( key );
+    if (ret || remote[0] != '\\' || remote[1] != '\\') return WN_BAD_NETNAME;
+    if (GetLogicalDrives() & (1u << (towupper( letter[0] ) - 'A'))) return WN_SUCCESS;   /* there already */
+
+    res.dwType = RESOURCETYPE_DISK;
+    res.lpLocalName = local;
+    res.lpRemoteName = remote;
+    ret = WNetAddConnection2W( &res, NULL, NULL, 0 );
+    TRACE( "%s -> %s: %lu\n", debugstr_w(local), debugstr_w(remote), ret );
+    if (ret == WN_SUCCESS) return ret;
+
+    lstrcpynW( server, remote + 2, ARRAY_SIZE(server) );
+    if ((end = wcschr( server, '\\' ))) *end = 0;
+    if (!CredReadW( server, CRED_TYPE_DOMAIN_PASSWORD, 0, &cred )) return ret;
+    {
+        WCHAR password[CREDUI_MAX_PASSWORD_LENGTH + 1] = L"";
+        DWORD len = min( cred->CredentialBlobSize, sizeof(password) - sizeof(WCHAR) );
+
+        memcpy( password, cred->CredentialBlob, len );
+        ret = WNetAddConnection2W( &res, password, cred->UserName, 0 );
+        SecureZeroMemory( password, sizeof(password) );
+        TRACE( "%s -> %s as %s: %lu\n", debugstr_w(local), debugstr_w(remote), debugstr_w(cred->UserName), ret );
+    }
+    CredFree( cred );
+    return ret;
+}
+
 /*****************************************************************
  *  WNetRestoreConnectionW [MPR.@]
+ *
+ * Stained Glass OS: connects the drives remembered with "Reconnect at
+ * sign-in" (CONNECT_UPDATE_PROFILE) again -- one, or all when lpszDevice
+ * is NULL. Nothing did: a drive mapped to come back at sign-in never did.
  */
 DWORD WINAPI WNetRestoreConnectionW( HWND hwndOwner, LPCWSTR lpszDevice )
 {
+#ifdef SG_MUTANT_NO_RESTORE
     FIXME( "(%p, %s), stub\n", hwndOwner, debugstr_w(lpszDevice) );
 
     SetLastError(WN_NO_NETWORK);
     return WN_NO_NETWORK;
+#else
+    WCHAR name[16];
+    DWORD ret = WN_SUCCESS, err, i, len;
+    HKEY user, network;
+
+    TRACE( "(%p, %s)\n", hwndOwner, debugstr_w(lpszDevice) );
+    if (RegOpenCurrentUser( KEY_READ, &user )) return WN_NO_NETWORK;
+    if (RegOpenKeyExW( user, L"Network", 0, KEY_READ, &network ))
+    {
+        RegCloseKey( user );
+        return lpszDevice ? WN_NOT_CONNECTED : WN_SUCCESS;
+    }
+    if (lpszDevice)
+    {
+        WCHAR letter[2] = { lpszDevice[0], 0 };
+        ret = restore_one( network, letter );
+    }
+    else
+    {
+        for (i = 0; len = ARRAY_SIZE(name), !RegEnumKeyExW( network, i, name, &len, NULL, NULL, NULL, NULL ); i++)
+        {
+            if (len != 1 || !iswalpha( name[0] )) continue;
+            if ((err = restore_one( network, name ))) ret = err;
+        }
+    }
+    RegCloseKey( network );
+    RegCloseKey( user );
+    if (ret) SetLastError( ret );
+    return ret;
+#endif
+}
+
+/* Stained Glass OS: "rundll32 mpr.dll,SgRestoreConnections" -- the shell
+ * reconnects the remembered drives at sign-in in a process of its own (a
+ * server out of reach must not hold up the desktop) */
+void WINAPI SgRestoreConnectionsW( HWND hwnd, HINSTANCE inst, WCHAR *cmdline, int show )
+{
+    WNetRestoreConnectionW( NULL, NULL );
 }
 
