+     * at sign-in -- in a process of their own, so that a server out of
+     * reach does not hold up the desktop */
+    {
+        HKEY network;
+        DWORD subkeys = 0;
+
+        if (!RegOpenKeyExW( HKEY_CURRENT_USER, L"Network", 0, KEY_READ, &network ))
+        {
+            RegQueryInfoKeyW( network, NULL, NULL, NULL, &subkeys, NULL, NULL, NULL, NULL, NULL, NULL, NULL );
+            RegCloseKey( network );
+        }
+        if (subkeys)
+        {
+            STARTUPINFOW si = { sizeof(si) };
+            PROCESS_INFORMATION pi;
+            WCHAR cmd[] = L"rundll32.exe mpr.dll,SgRestoreConnections";
+
+            si.dwFlags = STARTF_USESHOWWINDOW;
+            si.wShowWindow = SW_HIDE;
+            if (CreateProcessW( NULL, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi ))
+            {
+                CloseHandle( pi.hThread );
+                CloseHandle( pi.hProcess );
+            }
+        }
+    }
+#endif
     run_once();
     run_key( HKEY_LOCAL_MACHINE, KEY_WOW64_64KEY, L"Run" );
     if (sizeof(void *) == 8 || (IsWow64Process( GetCurrentProcess(), &wow64 ) && wow64))
