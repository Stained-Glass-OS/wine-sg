+/* Stained Glass OS 1671: TBSTYLE_REGISTERDROP. The toolbar is a drop
+ * target; over a button it asks its parent for that button's own drop
+ * target (TBN_GETOBJECT) and hands the drag to it. */
+struct toolbar_drop
+{
+    IDropTarget IDropTarget_iface;
+    LONG ref;
+    TOOLBAR_INFO *info;         /* cleared when the toolbar goes */
+    IDropTarget *current;       /* the button's, while over one */
+    INT current_id;
+};
+
+static INT TOOLBAR_InternalHitTest (const TOOLBAR_INFO *infoPtr, const POINT *lpPt, BOOL *button);
+static INT TOOLBAR_SendNotify (NMHDR *nmhdr, const TOOLBAR_INFO *infoPtr, UINT code);
+
+static inline struct toolbar_drop *impl_from_IDropTarget(IDropTarget *iface)
+{
+    return CONTAINING_RECORD(iface, struct toolbar_drop, IDropTarget_iface);
+}
+
+static HRESULT WINAPI drop_QueryInterface(IDropTarget *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IDropTarget))
+    {
+        *out = iface;
+        IDropTarget_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI drop_AddRef(IDropTarget *iface)
+{
+    return InterlockedIncrement(&impl_from_IDropTarget(iface)->ref);
+}
+
+static ULONG WINAPI drop_Release(IDropTarget *iface)
+{
+    struct toolbar_drop *drop = impl_from_IDropTarget(iface);
+    ULONG ref = InterlockedDecrement(&drop->ref);
+
+    if (!ref)
+    {
+        if (drop->current) IDropTarget_Release(drop->current);
+        Free(drop);
+    }
+    return ref;
+}
+
+/* the drop target of the button under a point (screen coordinates) */
+static IDropTarget *drop_target_at(struct toolbar_drop *drop, POINTL ptl, INT *id)
+{
+    TOOLBAR_INFO *infoPtr = drop->info;
+    NMOBJECTNOTIFY nmo;
+    POINT pt = { ptl.x, ptl.y };
+    BOOL button;
+    INT index;
+
+    *id = -1;
+    if (!infoPtr) return NULL;
+    ScreenToClient(infoPtr->hwndSelf, &pt);
+    index = TOOLBAR_InternalHitTest(infoPtr, &pt, &button);
+    if (index < 0 || !button) return NULL;
+    *id = infoPtr->buttons[index].idCommand;
+    memset(&nmo, 0, sizeof(nmo));
+    nmo.iItem = *id;
+    nmo.piid = &IID_IDropTarget;
+    nmo.hResult = E_NOINTERFACE;
+#ifndef SG_MUTANT_NO_DROP_OBJECT
+    TOOLBAR_SendNotify(&nmo.hdr, infoPtr, TBN_GETOBJECT);
+#endif
+    if (FAILED(nmo.hResult) || !nmo.pObject) return NULL;
+    return nmo.pObject;
+}
+
+static IDataObject *drag_data;
+
+static HRESULT WINAPI drop_DragEnter(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    struct toolbar_drop *drop = impl_from_IDropTarget(iface);
+
+    if (drag_data) IDataObject_Release(drag_data);
+    if ((drag_data = data)) IDataObject_AddRef(data);
+    if (drop->current) IDropTarget_Release(drop->current);
+    drop->current = drop_target_at(drop, pt, &drop->current_id);
+    if (drop->current) return IDropTarget_DragEnter(drop->current, data, keys, pt, effect);
+    *effect = DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_DragOver(IDropTarget *iface, DWORD keys, POINTL pt, DWORD *effect)
+{
+    struct toolbar_drop *drop = impl_from_IDropTarget(iface);
+    IDropTarget *target;
+    INT id;
+
+    target = drop_target_at(drop, pt, &id);
+    if (id == drop->current_id && target == drop->current)
+    {
+        if (target) IDropTarget_Release(target);
+        if (drop->current) return IDropTarget_DragOver(drop->current, keys, pt, effect);
+        *effect = DROPEFFECT_NONE;
+        return S_OK;
+    }
+    /* another button: leave the old one's target, enter the new one's */
+    if (drop->current)
+    {
+        IDropTarget_DragLeave(drop->current);
+        IDropTarget_Release(drop->current);
+    }
+    drop->current = target;
+    drop->current_id = id;
+    if (target && drag_data) return IDropTarget_DragEnter(target, drag_data, keys, pt, effect);
+    *effect = DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_DragLeave(IDropTarget *iface)
+{
+    struct toolbar_drop *drop = impl_from_IDropTarget(iface);
+
+    if (drop->current)
+    {
+        IDropTarget_DragLeave(drop->current);
+        IDropTarget_Release(drop->current);
+        drop->current = NULL;
+    }
+    drop->current_id = -1;
+    if (drag_data) IDataObject_Release(drag_data);
+    drag_data = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_Drop(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    struct toolbar_drop *drop = impl_from_IDropTarget(iface);
+    HRESULT hr = S_OK;
+
+    if (drop->current)
+    {
+        hr = IDropTarget_Drop(drop->current, data, keys, pt, effect);
+        IDropTarget_Release(drop->current);
+        drop->current = NULL;
+    }
+    else *effect = DROPEFFECT_NONE;
+    drop->current_id = -1;
+    if (drag_data) IDataObject_Release(drag_data);
+    drag_data = NULL;
+    return hr;
+}
+
+static const IDropTargetVtbl drop_vtbl =
+{
+    drop_QueryInterface,
+    drop_AddRef,
+    drop_Release,
+    drop_DragEnter,
+    drop_DragOver,
+    drop_DragLeave,
+    drop_Drop,
+};
+
+static HRESULT (WINAPI *pRegisterDragDrop)(HWND, IDropTarget *);
+static HRESULT (WINAPI *pRevokeDragDrop)(HWND);
+
 static void
-TOOLBAR_CheckStyle (const TOOLBAR_INFO *infoPtr)
+TOOLBAR_CheckStyle (TOOLBAR_INFO *infoPtr)
 {
-    if (infoPtr->dwStyle & TBSTYLE_REGISTERDROP)
-	FIXME("[%p] TBSTYLE_REGISTERDROP not implemented\n", infoPtr->hwndSelf);
+    BOOL want = (infoPtr->dwStyle & TBSTYLE_REGISTERDROP) != 0;
+
+    if (want == (infoPtr->drop != NULL)) return;
+    if (!pRegisterDragDrop)
+    {
+        HMODULE ole32 = LoadLibraryW(L"ole32.dll");
+        if (!ole32) return;
+        pRegisterDragDrop = (void *)GetProcAddress(ole32, "RegisterDragDrop");
+        pRevokeDragDrop = (void *)GetProcAddress(ole32, "RevokeDragDrop");
+        if (!pRegisterDragDrop || !pRevokeDragDrop) return;
+    }
+    if (want)
+    {
+        struct toolbar_drop *drop = Alloc(sizeof(*drop));
+        if (!drop) return;
+        drop->IDropTarget_iface.lpVtbl = &drop_vtbl;
+        drop->ref = 1;
+        drop->info = infoPtr;
+        drop->current_id = -1;
+        /* OLE must be initialized by the program for this */
+        if (FAILED(pRegisterDragDrop(infoPtr->hwndSelf, &drop->IDropTarget_iface)))
+        {
+            WARN("[%p] RegisterDragDrop failed\n", infoPtr->hwndSelf);
+            IDropTarget_Release(&drop->IDropTarget_iface);
+            return;
+        }
+        infoPtr->drop = drop;
+    }
+    else
+    {
+        pRevokeDragDrop(infoPtr->hwndSelf);
+        infoPtr->drop->info = NULL;
+        IDropTarget_Release(&infoPtr->drop->IDropTarget_iface);
+        infoPtr->drop = NULL;
+    }
 }
 
 
