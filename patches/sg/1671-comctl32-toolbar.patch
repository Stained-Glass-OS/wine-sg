+/* Stained Glass OS 1671: a standard bitmap (HINST_COMMCTRL) as the
+ * toolbar keeps it: comctl32's own resource, and how many buttons */
+static BOOL TOOLBAR_StandardBitmap(UINT_PTR id, TBITMAP_INFO *info)
+{
+    info->hInst = COMCTL32_hModule;
+    switch (id)
+    {
+    case IDB_STD_SMALL_COLOR:
+    case 2:
+        info->nButtons = 15;
+        info->nID = IDB_STD_SMALL;
+        return TRUE;
+    case IDB_STD_LARGE_COLOR:
+    case 3:
+        info->nButtons = 15;
+        info->nID = IDB_STD_LARGE;
+        return TRUE;
+    case IDB_VIEW_SMALL_COLOR:
+    case 6:
+        info->nButtons = 12;
+        info->nID = IDB_VIEW_SMALL;
+        return TRUE;
+    case IDB_VIEW_LARGE_COLOR:
+    case 7:
+        info->nButtons = 12;
+        info->nID = IDB_VIEW_LARGE;
+        return TRUE;
+    case IDB_HIST_SMALL_COLOR:
+        info->nButtons = 5;
+        info->nID = IDB_HIST_SMALL;
+        return TRUE;
+    case IDB_HIST_LARGE_COLOR:
+        info->nButtons = 5;
+        info->nID = IDB_HIST_LARGE;
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
