From: Stained Glass OS <dev@stained-glass.example>
Subject: kernelbase: the user's regional format is their choice

Wine took the user's locale from the Unix locale the process started with
(LC_MESSAGES) and, at every process start, rewrote Control Panel\International
to match it, so a format chosen in Settings > Region or in the first-run setup
was undone by the next program. As on Windows, a valid LocaleName there now
decides the user's format; the Unix locale still decides the display language.
The other format values are regenerated once per new choice (sg-FormatLocale
names the locale they were last generated for), and a country chosen apart
from the format (Geo\Nation) is kept.

Gate: test/region-gate.sh (make test-region).
---
--- a/dlls/kernelbase/locale.c	2025-01-21 08:42:16.000000000 -0800
+++ b/dlls/kernelbase/locale.c	2026-09-25 11:07:10.688045659 -0700
@@ -1850,6 +1850,8 @@
 
 
 /* update all registry values upon user locale change */
+static BOOL keep_user_geo;
+
 static void update_locale_registry(void)
 {
     WCHAR buffer[80];
@@ -1901,7 +1903,8 @@
     update_registry_value( LOCALE_NOUSEROVERRIDE | LOCALE_SABBREVLANGNAME, NULL, L"sLanguage" );
     update_registry_value( LOCALE_NOUSEROVERRIDE | LOCALE_SCOUNTRY, NULL, L"sCountry" );
     update_registry_value( LOCALE_NOUSEROVERRIDE | LOCALE_SNAME, NULL, L"LocaleName" );
-    SetUserGeoID( user_locale->igeoid );
+    /* A country chosen apart from the format stays chosen. */
+    if (!keep_user_geo) SetUserGeoID( user_locale->igeoid );
 }
 
 
@@ -1915,7 +1918,8 @@
     WCHAR bufferW[LOCALE_NAME_MAX_LENGTH];
     DYNAMIC_TIME_ZONE_INFORMATION timezone;
     const WCHAR *user_locale_name;
-    DWORD count;
+    BOOL user_choice = FALSE;
+    DWORD count, type;
     SIZE_T size;
     HKEY hkey;
 
@@ -1953,6 +1957,30 @@
     RegCreateKeyExW( HKEY_CURRENT_USER, L"Control Panel\\International",
                      0, NULL, REG_OPTION_NON_VOLATILE, KEY_ALL_ACCESS, NULL, &intl_key, NULL );
 
+    /* The regional format is the user's choice, as on Windows: a LocaleName
+     * in Control Panel\International (written by the Region settings or the
+     * first-run setup) decides it, not the Unix locale the process was
+     * started with, which decides only the display language. */
+    count = sizeof(bufferW);
+    if (!RegQueryValueExW( intl_key, L"LocaleName", NULL, &type, (BYTE *)bufferW, &count ) && type == REG_SZ)
+    {
+        LCID lcid;
+        const NLS_LOCALE_DATA *chosen = get_locale_by_name( bufferW, &lcid );
+
+        if (chosen)
+        {
+            user_choice = TRUE;
+            if (chosen != user_locale)
+            {
+                TRACE( "user format %s chosen over %s\n", debugstr_w(bufferW),
+                       debugstr_w(locale_strings + user_locale->sname + 1) );
+                user_locale = chosen;
+                user_lcid = chosen->ilanguage;
+                if (user_lcid == LOCALE_CUSTOM_UNSPECIFIED) user_lcid = LOCALE_CUSTOM_DEFAULT;
+            }
+        }
+    }
+
     current_locale_sort = get_language_sort( LOCALE_NAME_USER_DEFAULT );
 
     if (GetDynamicTimeZoneInformation( &timezone ) != TIME_ZONE_ID_INVALID &&
@@ -1970,16 +1998,23 @@
      * This simulates the action of the Windows control panel. */
 
     user_locale_name = locale_strings + user_locale->sname + 1;
-    count = sizeof(bufferW);
-    if (!RegQueryValueExW( intl_key, L"LocaleName", NULL, NULL, (BYTE *)bufferW, &count ))
+    if (user_choice)
     {
-        if (!wcscmp( bufferW, user_locale_name )) return; /* unchanged */
-        TRACE( "updating registry, locale changed %s -> %s\n",
-               debugstr_w(bufferW), debugstr_w(user_locale_name) );
+        /* The format values follow the chosen name once: the values a
+         * choice was last applied to are named in sg-FormatLocale. */
+        count = sizeof(bufferW);
+        if (!RegQueryValueExW( intl_key, L"sg-FormatLocale", NULL, NULL, (BYTE *)bufferW, &count ) &&
+            !wcscmp( bufferW, user_locale_name )) return;
+        TRACE( "applying the chosen format %s\n", debugstr_w(user_locale_name) );
+        count = sizeof(bufferW);
+        keep_user_geo = !RegGetValueW( intl_key, L"Geo", L"Nation", RRF_RT_REG_SZ, NULL, bufferW, &count );
     }
-    else TRACE( "updating registry, locale changed none -> %s\n", debugstr_w(user_locale_name) );
+    else
+        TRACE( "updating registry, locale changed none -> %s\n", debugstr_w(user_locale_name) );
 
     update_locale_registry();
+    RegSetValueExW( intl_key, L"sg-FormatLocale", 0, REG_SZ, (BYTE *)user_locale_name,
+                    (lstrlenW(user_locale_name) + 1) * sizeof(WCHAR) );
 
     if (!RegCreateKeyExW( nls_key, L"Codepage",
                           0, NULL, REG_OPTION_NON_VOLATILE, KEY_ALL_ACCESS, NULL, &hkey, NULL ))
