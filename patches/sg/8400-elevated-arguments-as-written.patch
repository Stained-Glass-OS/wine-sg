 }
 
+/* Stained Glass OS (wine-sg 8400): the elevated program gets its arguments as the caller wrote
+ * them, as on Windows, where ShellExecuteEx "runas" hands lpParameters over verbatim. SgElevate
+ * passes the command to sg-elevate as separate arguments (CommandLineToArgvW's), and Wine's loader
+ * writes the Windows command line again from those -- which moves quotes: advpack's
+ * LaunchINFSectionEx "C:\P F\x.inf",DefaultUninstall arrived as "C:\P F\x.inf,DefaultUninstall"
+ * (Notepad2's uninstaller left everything in place), and an installer's PROP="a b" as
+ * "PROP=a b". When writing the arguments again would not give back the caller's text, they go as
+ * one argument, the text itself behind SG_RAW_ARGS_MARK, which the loader (ntdll's
+ * build_initial_params, and start.exe /exec) puts in the command line unchanged. */
+#define SG_RAW_ARGS_MARK L"/sg-raw-args:"
+
+/* the end of the argument at s, as CommandLineToArgvW reads one that is not the first */
+static const WCHAR *sg_arg_end( const WCHAR *s )
+{
+    int qcount = 0, bcount = 0;
+
+    while (*s)
+    {
+        if ((*s == ' ' || *s == '\t') && !qcount) break;
+        if (*s == '\\') { bcount++; s++; continue; }
+        if (*s == '"')
+        {
+            if (!(bcount & 1)) qcount++;
+            s++;
+            bcount = 0;
+            while (*s == '"') { qcount++; s++; }
+            qcount %= 3;
+            if (qcount == 2) qcount = 0;
+            continue;
+        }
+        bcount = 0;
+        s++;
+    }
+    return s;
+}
+
+/* the end of the first argument at s (the program): to the next quote, or the next blank */
+static const WCHAR *sg_arg0_end( const WCHAR *s )
+{
+    if (*s == '"')
+    {
+        for (s++; *s; ) if (*s++ == '"') break;
+        return s;
+    }
+    while (*s && *s != ' ' && *s != '\t') s++;
+    return s;
+}
+
+static const WCHAR *sg_skip_blanks( const WCHAR *s )
+{
+    while (*s == ' ' || *s == '\t') s++;
+    return s;
+}
+
+/* what Wine's loader makes of arguments (ntdll's build_command_line, for those after the first) */
+static WCHAR *sg_loader_args( WCHAR **args, int count )
+{
+    WCHAR *ret, *p;
+    int i, len = 1;
+
+    for (i = 0; i < count; i++) if (args[i]) len += 3 + 2 * wcslen( args[i] );
+    if (!(ret = p = malloc( len * sizeof(WCHAR) ))) return NULL;
+    for (i = 0; i < count; i++)
+    {
+        const WCHAR *a;
+        BOOL space, quote;
+        int bcount = 0, k;
+
+        if (!args[i]) continue;
+        if (p > ret) *p++ = ' ';
+        space = !*args[i] || wcschr( args[i], ' ' ) || wcschr( args[i], '\t' );
+        quote = wcschr( args[i], '"' ) != NULL;
+        if (space) *p++ = '"';
+        for (a = args[i]; *a; a++)
+        {
+            if (*a == '\\') bcount++;
+            else
+            {
+                if (*a == '"' && (space || quote)) for (k = 0; k <= bcount; k++) *p++ = '\\';
+                bcount = 0;
+            }
+            *p++ = *a;
+        }
+        if (space)
+        {
+            for (k = 0; k < bcount; k++) *p++ = '\\';
+            *p++ = '"';
+        }
+    }
+    *p = 0;
+    return ret;
+}
+
+/* The caller's text of args[first..count-1], from cmdline, without the arguments args[] has
+ * NULLed (NSIS's /UAC:); NULL when that text is what the loader writes from args[] anyway. */
+static WCHAR *sg_raw_args( const WCHAR *cmdline, WCHAR **args, int count, int first )
+{
+    const WCHAR *p = sg_skip_blanks( cmdline ), *end, *gap = NULL;
+    WCHAR *raw, *q, *loader;
+    int i;
+
+#ifdef SG_MUTANT_RUNAS_REQUOTES
+    return NULL;
+#endif
+    if (first < 1 || first > count) return NULL;
+    /* past the arguments before these: the program, and /sgready: before it */
+    for (i = 0; i < first; i++) p = sg_skip_blanks( i ? sg_arg_end( p ) : sg_arg0_end( p ) );
+    if (!(raw = q = malloc( (wcslen( p ) + 2) * sizeof(WCHAR) ))) return NULL;
+    for (i = first; i < count && *p; i++)
+    {
+        end = sg_arg_end( p );
+        if (args[i])
+        {
+            /* the blanks between two arguments as the caller wrote them; one where one was left out */
+            if (gap) { memcpy( q, gap, (p - gap) * sizeof(WCHAR) ); q += p - gap; }
+            else if (q > raw) *q++ = ' ';
+            memcpy( q, p, (end - p) * sizeof(WCHAR) );
+            q += end - p;
+        }
+        gap = args[i] ? end : NULL;
+        p = sg_skip_blanks( end );
+    }
+    *q = 0;
+    loader = sg_loader_args( args + first, count - first );
+    if (!loader || !wcscmp( loader, raw ))
+    {
+        free( loader );
+        free( raw );
+        return NULL;
+    }
+    TRACE( "raw arguments %s (the loader would write %s)\n", debugstr_w(raw), debugstr_w(loader) );
+    free( loader );
+    return raw;
+}
+
 void WINAPI SgElevateW( HWND hwnd, HINSTANCE inst, LPWSTR cmdline, INT show )
 {
     LONG (WINAPI *spawnvp)( char * const argv[], int wait );
@@ -661,8 +796,8 @@
     const WCHAR *ready_path, *code_path = NULL;
     WCHAR code_file[MAX_PATH];
     struct sg_ready *ready = NULL;
-    WCHAR **args, value[MAX_PATH];
-    int count = 0, i, len, n;
+    WCHAR **args, value[MAX_PATH], *raw;
+    int count = 0, i, k, len, n;
     WCHAR ** (WINAPI *to_argv)( const WCHAR *, int * );
     LONG ret;
 
@@ -706,15 +841,28 @@
     }
 #endif
     argv[n++] = (char *)"--wine";
+    /* NSIS's UAC plugin (Firefox's installer, many others) starts itself
+     * elevated with /UAC:<window> and has the elevated copy call back to
+     * that window. An elevated program here is on a display and desktop
+     * of its own, where the window is out of reach, and the copy gave up
+     * and installed nothing. Without the switch the elevated copy installs
+     * by itself, as the plugin does when its caller is gone. */
+    for (k = i; k < count; k++) if (!wcsnicmp( args[k], L"/UAC:", 5 )) args[k] = NULL;
+    /* the program, then its arguments as the caller wrote them (8400) */
+    if (i < count && args[i] && (raw = sg_raw_args( cmdline, args, count, i + 1 )))
+    {
+        WCHAR *marked = malloc( (wcslen( SG_RAW_ARGS_MARK ) + wcslen( raw ) + 1) * sizeof(WCHAR) );
+
+        if (!marked) ExitProcess( 2 );
+        wcscpy( marked, SG_RAW_ARGS_MARK );
+        wcscat( marked, raw );
+        free( raw );
+        args[i + 1] = marked;
+        count = i + 2;
+    }
     for (; i < count; i++)
     {
-        /* NSIS's UAC plugin (Firefox's installer, many others) starts itself
-         * elevated with /UAC:<window> and has the elevated copy call back to
-         * that window. An elevated program here is on a display and desktop
-         * of its own, where the window is out of reach, and the copy gave up
-         * and installed nothing. Without the switch the elevated copy installs
-         * by itself, as the plugin does when its caller is gone. */
-        if (!wcsnicmp( args[i], L"/UAC:", 5 )) continue;
+        if (!args[i]) continue;
         len = WideCharToMultiByte( CP_UNIXCP, 0, args[i], -1, NULL, 0, NULL, NULL );
         if (!(argv[n] = malloc( len ))) ExitProcess( 2 );
         WideCharToMultiByte( CP_UNIXCP, 0, args[i], -1, argv[n++], len, NULL, NULL );
