+static HRESULT WINAPI asmemit_DefineFile(IMetaDataAssemblyEmit *iface, const WCHAR *name, const void *hash, ULONG cbhash,
+                                         DWORD flags, ULONG32 *pmdf)
+{
+    ASMEMIT_ENTER;
+    ULONG row, nm, r;
+
+    TRACE("%p %s %p %lu %#lx %p\n", iface, debugstr_w(name), hash, cbhash, flags, pmdf);
+    if (!name || !*name || !pmdf) return E_INVALIDARG;
+    nm = str_w(md, name, &ok);
+    NO_MEM(ok);
+    for (r = 1; r <= MROWS(md, T_FILE); r++)
+        if (*mc(md, T_FILE, r, 1) == nm) return CLDB_E_RECORD_DUPLICATE;
+    NO_MEM(row = row_add(md, T_FILE));
+    *mc(md, T_FILE, row, 0) = flags;
+    *mc(md, T_FILE, row, 1) = nm;
+    *mc(md, T_FILE, row, 2) = blob_of(md, hash, cbhash, &ok);
+    NO_MEM(ok);
+    m->dirty = TRUE;
+    *pmdf = MKTK(T_FILE, row);
+    return S_OK;
+}
