+static HRESULT WINAPI emit_DefineMethod(IMetaDataEmit2 *iface, ULONG32 td, const WCHAR *name, DWORD flags,
+                                        const BYTE *sig, ULONG cbsig, ULONG rva, DWORD implflags, ULONG32 *pmd)
+{
+    EMIT_ENTER;
+    ULONG owner, rid, nm, sg, params;
+
+    TRACE("%p %#x %s %#lx %p %lu %lu %#lx %p\n", iface, td, debugstr_w(name), flags, sig, cbsig, rva, implflags, pmd);
+    if (!name || !pmd) return E_INVALIDARG;
+    if (FAILED(hr = owner_rid(md, td, &owner))) return hr;
+    nm = str_w(md, name, &ok);
+    sg = blob_of(md, sig, cbsig, &ok);
+    NO_MEM(ok);
+    NO_MEM(rid = member_add(md, T_TYPEDEF, owner, 5, T_METHOD));
+    params = MROWS(md, ptr_table(T_PARAM)) + 1;
+    *mc(md, T_METHOD, rid, 0) = rva;
+    *mc(md, T_METHOD, rid, 1) = implflags;
+    *mc(md, T_METHOD, rid, 2) = flags;
+    *mc(md, T_METHOD, rid, 3) = nm;
+    *mc(md, T_METHOD, rid, 4) = sg;
+    *mc(md, T_METHOD, rid, 5) = params;
+    m->dirty = TRUE;
+    *pmd = MKTK(T_METHOD, rid);
+    return S_OK;
+}
