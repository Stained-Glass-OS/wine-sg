+static HRESULT define_typedef(struct md_scope *m, const WCHAR *name, DWORD flags, ULONG32 ext, const ULONG32 *impls,
+                              ULONG32 encloser, BOOL nested, ULONG32 *ptd)
+{
+    struct md_model *md = m->model;
+    ULONG ns = 0, nm = 0, extv, rid;
+    BOOL ok = TRUE;
+    HRESULT hr;
+
+    if (!name || !ptd) return E_INVALIDARG;
+    if (nested && !tok_ok(md, encloser) ) return CLDB_E_INDEX_NOTFOUND;
+    if (nested && TK_T(encloser) != T_TYPEDEF) return E_INVALIDARG;
+    if (ext && TK_T(ext) != T_TYPEDEF && TK_T(ext) != T_TYPEREF && TK_T(ext) != T_TYPESPEC) return E_INVALIDARG;
+    if (FAILED(hr = coded_of(md, CI_TYPEDEFORREF, ext, &extv))) return hr;
+    if (nested) nm = str_w(md, name, &ok);
+    else ok = str_ns_name(md, name, &ns, &nm);
+    NO_MEM(ok);
+#ifndef SG_MUTANT_EMIT_DUP
+    if (type_exists(md, ns, nm, nested ? TK_R(encloser) : 0)) return CLDB_E_RECORD_DUPLICATE;
+#endif
+
+    NO_MEM(rid = row_add(md, T_TYPEDEF));
+    *mc(md, T_TYPEDEF, rid, 0) = flags;
+    *mc(md, T_TYPEDEF, rid, 1) = nm;
+    *mc(md, T_TYPEDEF, rid, 2) = ns;
+    *mc(md, T_TYPEDEF, rid, 3) = extv;
+    *mc(md, T_TYPEDEF, rid, 4) = MROWS(md, ptr_table(T_FIELD)) + 1;
+    *mc(md, T_TYPEDEF, rid, 5) = MROWS(md, ptr_table(T_METHOD)) + 1;
+#ifdef SG_MUTANT_EMIT_NESTED
+    if (0)
+#else
+    if (nested)
+#endif
+    {
+        ULONG n;
+
+        NO_MEM(n = row_add(md, T_NESTED));
+        *mc(md, T_NESTED, n, 0) = rid;
+        *mc(md, T_NESTED, n, 1) = TK_R(encloser);
+    }
+    m->dirty = TRUE;
+    if (FAILED(hr = add_interfaces(md, rid, impls))) return hr;
+    *ptd = MKTK(T_TYPEDEF, rid);
+    return S_OK;
+}
