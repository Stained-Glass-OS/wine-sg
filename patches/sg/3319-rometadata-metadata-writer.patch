+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* attribute flags of ECMA-335 II.23.1 (corhdr.h does not have them) */
+#define afPublicKey        0x0001
+#define fdSpecialName      0x0200
+#define fdRTSpecialName    0x0400
+#define fdPinvokeImpl      0x2000
+#define fdHasFieldMarshal  0x1000
+#define fdHasFieldRVA      0x0100
+#define fdHasDefault       0x8000
+#define mdSpecialName      0x0800
+#define mdRTSpecialName    0x1000
+#define mdPinvokeImpl      0x2000
+#define mdHasSecurity      0x4000
+#define pdHasDefault       0x1000
+#define pdHasFieldMarshal  0x2000
+#define prHasDefault       0x1000
+#define tdSpecialName      0x00000400
+#define tdRTSpecialName    0x00000800
+#define tdHasSecurity      0x00040000
+
+/* ---- heaps ---- */
+
+enum heap_kind { H_STR, H_BLOB };   /* #US shares the blob encoding */
+
+struct heap
+{
+    BYTE *d;
+    SIZE_T n, cap;
+    enum heap_kind kind;
+    ULONG *tab;                 /* hash table of entry offsets, 0 = empty */
+    ULONG tabsize, count;
+    BOOL indexed;
+};
+
+struct md_model
+{
+    struct { ULONG rows, cap; ULONG *c; } tbl[NUM_TABLES];
+    struct heap str, us, blob;
+    BYTE *guid;
+    ULONG nguid;
+    char *version;
+    IUnknown *handler;
+    void **old;                 /* buffers of earlier serialisations, kept until the scope dies */
+    ULONG nold;
+};
+
+static ULONG hash_bytes(const BYTE *p, ULONG n)
+{
+    ULONG h = 2166136261u;
+
+    while (n--) h = (h ^ *p++) * 16777619u;
+    return h ? h : 1;
+}
+
+static BOOL heap_reserve(struct heap *h, SIZE_T extra)
+{
+    BYTE *p;
+    SIZE_T cap;
+
+    if (h->n + extra <= h->cap) return TRUE;
+    cap = (h->n + extra) * 2 + 64;
+    if (!(p = realloc(h->d, cap))) return FALSE;
+    h->d = p;
+    h->cap = cap;
+    return TRUE;
+}
+
+static ULONG put_compressed(BYTE *out, ULONG v)
+{
+    if (v < 0x80) { out[0] = v; return 1; }
+    if (v < 0x4000) { out[0] = 0x80 | (v >> 8); out[1] = v; return 2; }
+    out[0] = 0xc0 | (v >> 24); out[1] = v >> 16; out[2] = v >> 8; out[3] = v;
+    return 4;
+}
+
+/* the bytes of the entry at off: for strings up to the NUL, otherwise after the compressed length */
+static BOOL heap_entry(const struct heap *h, ULONG off, const BYTE **data, ULONG *len)
+{
+    ULONG l, hdr;
+
+    if (off >= h->n) return FALSE;
+    if (h->kind == H_STR)
+    {
+        const BYTE *z = memchr(h->d + off, 0, h->n - off);
+
+        if (!z) return FALSE;
+        *data = h->d + off;
+        *len = z - (h->d + off);
+        return TRUE;
+    }
+    if (!uncompress(h->d + off, h->d + h->n, &l, &hdr) || l > h->n - off - hdr) return FALSE;
+    *data = h->d + off + hdr;
+    *len = l;
+    return TRUE;
+}
+
+static BOOL heap_tab_insert(struct heap *h, ULONG off, ULONG hash)
+{
+    ULONG i;
+
+    if (h->count * 2 >= h->tabsize)
+    {
+        ULONG *old = h->tab, oldsize = h->tabsize, k;
+
+        h->tabsize = h->tabsize ? h->tabsize * 2 : 256;
+        if (!(h->tab = calloc(h->tabsize, sizeof(ULONG)))) { h->tab = old; h->tabsize = oldsize; return FALSE; }
+        for (k = 0; k < oldsize; k++)
+        {
+            const BYTE *d;
+            ULONG l, j;
+
+            if (!old[k] || !heap_entry(h, old[k], &d, &l)) continue;
+            for (j = hash_bytes(d, l) % h->tabsize; h->tab[j]; j = (j + 1) % h->tabsize) ;
+            h->tab[j] = old[k];
+        }
+        free(old);
+    }
+    for (i = hash % h->tabsize; h->tab[i]; i = (i + 1) % h->tabsize) ;
+    h->tab[i] = off;
+    h->count++;
+    return TRUE;
+}
+
+/* index the entries already in the heap (a heap loaded from a file) */
+static void heap_index(struct heap *h)
+{
+    ULONG off = 1;
+
+    if (h->indexed) return;
+    h->indexed = TRUE;
+    while (off < h->n)
+    {
+        const BYTE *d;
+        ULONG l, hdr;
+
+        if (h->kind == H_STR)
+        {
+            if (!heap_entry(h, off, &d, &l)) break;
+            if (l) heap_tab_insert(h, off, hash_bytes(d, l));
+            off += l + 1;
+        }
+        else
+        {
+            if (!uncompress(h->d + off, h->d + h->n, &l, &hdr) || l > h->n - off - hdr) break;
+            heap_tab_insert(h, off, hash_bytes(h->d + off + hdr, l));
+            off += hdr + l;
+        }
+    }
+}
+
+/* add an entry (or find the existing one); returns 0 on failure for non-empty data */
+static ULONG heap_add(struct heap *h, const void *data, ULONG len)
+{
+    ULONG hash, i, off;
+    BYTE hdr[4];
+
+    if (!len && h->kind == H_STR) return 0;
+    heap_index(h);
+    hash = hash_bytes(data, len);
+    if (h->tabsize)
+        for (i = hash % h->tabsize; h->tab[i]; i = (i + 1) % h->tabsize)
+        {
+            const BYTE *d;
+            ULONG l;
+
+            if (heap_entry(h, h->tab[i], &d, &l) && l == len && !memcmp(d, data, len)) return h->tab[i];
+        }
+    off = h->n;
+    if (h->kind == H_STR)
+    {
+        if (!heap_reserve(h, len + 1)) return 0;
+        memcpy(h->d + h->n, data, len);
+        h->d[h->n + len] = 0;
+        h->n += len + 1;
+    }
+    else
+    {
+        ULONG hl = put_compressed(hdr, len);
+
+        if (!heap_reserve(h, hl + len)) return 0;
+        memcpy(h->d + h->n, hdr, hl);
+        memcpy(h->d + h->n + hl, data, len);
+        h->n += hl + len;
+    }
+    if (!heap_tab_insert(h, off, hash)) return 0;
+    return off;
+}
+
+/* ---- the model ---- */
+
+static ULONG *mc(struct md_model *md, unsigned int t, ULONG rid, unsigned int col)
+{
+    return &md->tbl[t].c[(SIZE_T)(rid - 1) * MAX_COLS + col];
+}
+
+#define MROWS(md, tt) ((md)->tbl[tt].rows)
+
+static BOOL model_heaps_init(struct md_model *md)
+{
+    md->str.kind = H_STR;
+    md->blob.kind = H_BLOB;
+    md->us.kind = H_BLOB;
+    if (!heap_reserve(&md->str, 1) || !heap_reserve(&md->blob, 1) || !heap_reserve(&md->us, 1)) return FALSE;
+    md->str.d[0] = 0; md->str.n = 1;
+    md->blob.d[0] = 0; md->blob.n = 1;
+    md->us.d[0] = 0; md->us.n = 1;
+    return TRUE;
+}
+
+static void model_free(struct md_model *md)
+{
+    unsigned int t;
+    ULONG i;
+
+    if (!md) return;
+    for (t = 0; t < NUM_TABLES; t++) free(md->tbl[t].c);
+    free(md->str.d); free(md->str.tab);
+    free(md->us.d); free(md->us.tab);
+    free(md->blob.d); free(md->blob.tab);
+    free(md->guid);
+    free(md->version);
+    if (md->handler) IUnknown_Release(md->handler);
+    for (i = 0; i < md->nold; i++) free(md->old[i]);
+    free(md->old);
+    free(md);
+}
+
+static ULONG row_add(struct md_model *md, unsigned int t)
+{
+    ULONG rid = md->tbl[t].rows + 1;
+
+    if (rid > md->tbl[t].cap)
+    {
+        ULONG cap = md->tbl[t].cap ? md->tbl[t].cap * 2 : 16;
+        ULONG *p = realloc(md->tbl[t].c, (SIZE_T)cap * MAX_COLS * sizeof(ULONG));
+
+        if (!p) return 0;
+        md->tbl[t].c = p;
+        md->tbl[t].cap = cap;
+    }
+    memset(mc(md, t, rid, 0), 0, MAX_COLS * sizeof(ULONG));
+    md->tbl[t].rows = rid;
+    return rid;
+}
+
+static BOOL is_list_col(unsigned int t, unsigned int c)
+{
+    return (t == T_TYPEDEF && (c == 4 || c == 5)) || (t == T_METHOD && c == 5) ||
+           (t == T_EVENTMAP && c == 1) || (t == T_PROPMAP && c == 1);
+}
+
+/* shift (delta +1 at/after pos, or -1 after pos with refs to pos cleared) every reference to rows of table t */
+static void fix_refs(struct md_model *md, unsigned int t, ULONG pos, int delta, BOOL include_lists)
+{
+    unsigned int x, c;
+    ULONG r;
+
+    for (x = 0; x < NUM_TABLES; x++)
+    {
+        for (c = 0; c < MAX_COLS && schema[x][c]; c++)
+        {
+            BYTE col = schema[x][c];
+
+            if (col == t && col < NUM_TABLES)
+            {
+                if (!include_lists && is_list_col(x, c)) continue;
+                for (r = 1; r <= md->tbl[x].rows; r++)
+                {
+                    ULONG *v = mc(md, x, r, c);
+
+                    if (delta > 0) { if (*v >= pos) (*v)++; }
+                    else if (*v == pos && !is_list_col(x, c)) *v = 0;
+                    else if (*v > pos) (*v)--;
+                }
+            }
+            else if (is_coded(col))
+            {
+                enum coded_kind k = col - C_CODED;
+                unsigned int i, bits = coded_info[k].bits;
+
+                for (i = 0; i < coded_info[k].count; i++)
+                    if (coded_info[k].tables[i] == t) break;
+                if (i == coded_info[k].count) continue;
+                for (r = 1; r <= md->tbl[x].rows; r++)
+                {
+                    ULONG *v = mc(md, x, r, c), rid = *v >> bits;
+
+                    if ((*v & ((1u << bits) - 1)) != i || !rid) continue;
+                    if (delta > 0) { if (rid >= pos) *v = ((rid + 1) << bits) | i; }
+                    else if (rid == pos) *v = 0;
+                    else if (rid > pos) *v = ((rid - 1) << bits) | i;
+                }
+            }
+        }
+    }
+}
+
+/* remove row rid of a table that no list points into; references to it are cleared, later rows renumbered */
+static void row_remove(struct md_model *md, unsigned int t, ULONG rid)
+{
+    ULONG rows = md->tbl[t].rows;
+
+    if (rid < rows)
+        memmove(mc(md, t, rid, 0), mc(md, t, rid + 1, 0), (SIZE_T)(rows - rid) * MAX_COLS * sizeof(ULONG));
+    md->tbl[t].rows--;
+    fix_refs(md, t, rid, -1, TRUE);
+}
+
+/* The children of a parent (the fields or methods of a type, the parameters of a method, the events and
+ * properties of a type) are listed by the parent's list column, in the position space of the pointer table of
+ * the child table; the child rows themselves are never moved, so their tokens stay valid. A list of an owner
+ * ends where the next owner's list starts. */
+static ULONG member_add(struct md_model *md, unsigned int owner_t, ULONG owner, unsigned int lc, unsigned int child_t)
+{
+    unsigned int pt = ptr_table(child_t);
+    ULONG rid, pos, j, rows;
+
+    if (!(rid = row_add(md, child_t)) || !row_add(md, pt)) return 0;
+    rows = MROWS(md, pt);
+    pos = owner < MROWS(md, owner_t) ? *mc(md, owner_t, owner + 1, lc) : rows;
+    if (pos < rows)
+        memmove(mc(md, pt, pos + 1, 0), mc(md, pt, pos, 0), (SIZE_T)(rows - pos) * MAX_COLS * sizeof(ULONG));
+    *mc(md, pt, pos, 0) = rid;
+    for (j = owner + 1; j <= MROWS(md, owner_t); j++) (*mc(md, owner_t, j, lc))++;
+    return rid;
+}
+
+/* the owner row of a child row, or 0 */
+static ULONG member_owner(struct md_model *md, unsigned int owner_t, unsigned int lc, unsigned int child_t, ULONG rid)
+{
+    unsigned int pt = ptr_table(child_t);
+    ULONG idx, o, best = 0;
+
+    for (idx = 1; idx <= MROWS(md, pt); idx++)
+        if (*mc(md, pt, idx, 0) == rid) break;
+    if (idx > MROWS(md, pt)) return 0;
+    for (o = 1; o <= MROWS(md, owner_t); o++)
+        if (*mc(md, owner_t, o, lc) <= idx) best = o;
+    return best;
+}
+
+/* a row of a table that is sorted when it is saved: appended here, so that its token does not change */
+static ULONG sorted_add(struct md_model *md, unsigned int t, unsigned int keycol, ULONG key)
+{
+    ULONG rid = row_add(md, t);
+
+    if (rid) *mc(md, t, rid, keycol) = key;
+    return rid;
+}
+
+static BOOL tok_ok(struct md_model *md, ULONG32 tk)
+{
+    ULONG t = TK_T(tk), rid = TK_R(tk);
+
+    if (t == (mdtString >> 24)) return rid && rid < md->us.n;
+    return t < NUM_TABLES && rid >= 1 && rid <= md->tbl[t].rows;
+}
+
+/* the coded value of a token; a nil token is 0; HRESULT on a bad token */
+static HRESULT coded_of(struct md_model *md, enum coded_kind k, ULONG32 tk, ULONG *v)
+{
+    if (!tk) { *v = 0; return S_OK; }
+    if ((*v = encode_coded(k, tk)) == ~0u) return E_INVALIDARG;
+    if (!tok_ok(md, tk)) return CLDB_E_INDEX_NOTFOUND;
+    return S_OK;
+}
+
+static char *w_to_utf8(const WCHAR *w, int cch)
+{
+    int n = WideCharToMultiByte(CP_UTF8, 0, w, cch, NULL, 0, NULL, NULL);
+    char *ret;
+
+    if (n <= 0) return _strdup("");
+    if (!(ret = malloc(n + 1))) return NULL;
+    WideCharToMultiByte(CP_UTF8, 0, w, cch, ret, n, NULL, NULL);
+    ret[n] = 0;
+    if (cch == -1) ret[n - 1] = 0;
+    return ret;
+}
+
+/* heap index of a wide string (0 for empty or NULL); *ok is cleared on failure */
+static ULONG str_w(struct md_model *md, const WCHAR *w, BOOL *ok)
+{
+    char *u;
+    ULONG ret;
+
+    if (!w || !*w) return 0;
+    if (!(u = w_to_utf8(w, -1))) { *ok = FALSE; return 0; }
+    ret = heap_add(&md->str, u, strlen(u));
+    if (!ret && *u) *ok = FALSE;
+    free(u);
+    return ret;
+}
+
+/* "Ns.Name" split at the last dot into two string heap indexes */
+static BOOL str_ns_name(struct md_model *md, const WCHAR *w, ULONG *ns, ULONG *name)
+{
+    char *u = w_to_utf8(w, -1), *dot;
+    BOOL ok = TRUE;
+
+    if (!u) return FALSE;
+    dot = strrchr(u, '.');
+    if (dot)
+    {
+        *dot = 0;
+        *ns = *u ? heap_add(&md->str, u, strlen(u)) : 0;
+        *name = heap_add(&md->str, dot + 1, strlen(dot + 1));
+        ok = (*ns || !*u) && (*name || !dot[1]);
+    }
+    else
+    {
+        *ns = 0;
+        *name = heap_add(&md->str, u, strlen(u));
+        ok = *name || !*u;
+    }
+    free(u);
+    return ok;
+}
+
+static ULONG blob_of(struct md_model *md, const void *data, ULONG len, BOOL *ok)
+{
+    ULONG ret;
+
+    if (!data || !len) return 0;
+    ret = heap_add(&md->blob, data, len);
+    if (!ret) *ok = FALSE;
+    return ret;
+}
+
+static ULONG guid_add(struct md_model *md, const GUID *g)
+{
+    BYTE *p = realloc(md->guid, (md->nguid + 1) * 16);
+
+    if (!p) return 0;
+    md->guid = p;
+    memcpy(p + md->nguid * 16, g, 16);
+    return ++md->nguid;
+}
+
+static struct md_model *model_new(void)
+{
+    struct md_model *md = calloc(1, sizeof(*md));
+    GUID mvid;
+    ULONG rid;
+
+    if (!md) return NULL;
+    if (!model_heaps_init(md) || !(md->version = _strdup("v4.0.30319"))) goto fail;
+    CoCreateGuid(&mvid);
+    if (!(rid = row_add(md, T_MODULE))) goto fail;
+    *mc(md, T_MODULE, rid, 2) = guid_add(md, &mvid);
+    /* the global type <Module> */
+    if (!(rid = row_add(md, T_TYPEDEF))) goto fail;
+    *mc(md, T_TYPEDEF, rid, 1) = heap_add(&md->str, "<Module>", 8);
+    *mc(md, T_TYPEDEF, rid, 4) = 1;
+    *mc(md, T_TYPEDEF, rid, 5) = 1;
+    return md;
+fail:
+    model_free(md);
+    return NULL;
+}
+
+/* a model holding the rows and heaps of a parsed scope (to edit an existing file) */
+static struct md_model *model_from_reader(const struct md_scope *r)
+{
+    struct md_model *md = calloc(1, sizeof(*md));
+    unsigned int t, c;
+    ULONG rid;
+
+    if (!md) return NULL;
+    md->str.kind = H_STR;
+    md->blob.kind = H_BLOB;
+    md->us.kind = H_BLOB;
+    if (!(md->version = malloc(r->version_len + 1))) goto fail;
+    memcpy(md->version, r->version, r->version_len);
+    md->version[r->version_len] = 0;
+    for (t = 0; t < NUM_TABLES; t++)
+    {
+        if ((t == 0x1e || t == 0x1f) && r->tables[t].rows) goto fail;      /* edit-and-continue logs */
+        for (rid = 1; rid <= r->tables[t].rows; rid++)
+        {
+            ULONG row = row_add(md, t);
+
+            if (!row) goto fail;
+            for (c = 0; c < MAX_COLS && schema[t][c]; c++) *mc(md, t, row, c) = cell(r, t, rid, c);
+        }
+    }
+    if (!md->tbl[T_MODULE].rows) goto fail;
+    /* every list works in the position space of a pointer table: make one (identity) where the file has none */
+    {
+        static const BYTE children[5] = { T_FIELD, T_METHOD, T_PARAM, T_EVENT, T_PROPERTY };
+        unsigned int k;
+
+        for (k = 0; k < 5; k++)
+        {
+            unsigned int pt = ptr_table(children[k]);
+
+            if (md->tbl[pt].rows) continue;
+            for (rid = 1; rid <= md->tbl[children[k]].rows; rid++)
+            {
+                ULONG row = row_add(md, pt);
+
+                if (!row) goto fail;
+                *mc(md, pt, row, 0) = rid;
+            }
+        }
+    }
+#define COPY_HEAP(h, src, size) \
+    if (size) { if (!heap_reserve(&md->h, size)) goto fail; memcpy(md->h.d, src, size); md->h.n = size; } \
+    else if (!heap_reserve(&md->h, 1)) goto fail; else { md->h.d[0] = 0; md->h.n = 1; }
+    COPY_HEAP(str, r->strings, r->strings_size)
+    COPY_HEAP(us, r->us, r->us_size)
+    COPY_HEAP(blob, r->blob, r->blob_size)
+#undef COPY_HEAP
+    if (r->guid_size)
+    {
+        if (!(md->guid = malloc(r->guid_size))) goto fail;
+        memcpy(md->guid, r->guid, r->guid_size);
+        md->nguid = r->guid_size / 16;
+    }
+    return md;
+fail:
+    model_free(md);
+    return NULL;
+}
+
+/* ---- serialisation ---- */
+
+struct out
+{
+    BYTE *d;
+    SIZE_T n, cap;
+    BOOL fail;
+};
+
+static void out_put(struct out *o, const void *data, SIZE_T len)
+{
+    if (o->fail) return;
+    if (o->n + len > o->cap)
+    {
+        SIZE_T cap = (o->n + len) * 2 + 256;
+        BYTE *p = realloc(o->d, cap);
+
+        if (!p) { o->fail = TRUE; return; }
+        o->d = p;
+        o->cap = cap;
+    }
+    memcpy(o->d + o->n, data, len);
+    o->n += len;
+}
+
+static void out_uint(struct out *o, ULONG64 v, unsigned int width)
+{
+    BYTE b[8];
+    unsigned int i;
+
+    for (i = 0; i < width; i++) b[i] = v >> (8 * i);
+    out_put(o, b, width);
+}
+
+static void out_pad4(struct out *o)
+{
+    static const BYTE zero[4];
+
+    if (o->n & 3) out_put(o, zero, 4 - (o->n & 3));
+}
+
+/* the tables that ECMA-335 requires to be sorted, which the model keeps sorted */
+#define SORTED_MASK ((1ull << T_IFACEIMPL) | (1ull << T_CONSTANT) | (1ull << T_CA) | (1ull << T_FMARSHAL) | \
+                     (1ull << T_DECLSEC) | (1ull << T_CLASSLAYOUT) | (1ull << T_FIELDLAYOUT) | \
+                     (1ull << T_METHODSEM) | (1ull << T_METHODIMPL) | (1ull << T_IMPLMAP) | \
+                     (1ull << T_FIELDRVA) | (1ull << T_NESTED) | (1ull << T_GENERICPARAM) | (1ull << T_GPC))
+
+/* ---- compaction: what Save writes ---- */
+
+/* The model keeps every row where it was defined, so tokens do not change while a scope is edited. A saved file
+ * has the children of each parent in one run, no pointer tables, and the sorted tables sorted: Save renumbers. */
+
+struct tokmap { ULONG *m[NUM_TABLES]; ULONG n[NUM_TABLES]; };
+
+static void tokmap_free(struct tokmap *tm)
+{
+    unsigned int t;
+
+    for (t = 0; t < NUM_TABLES; t++) free(tm->m[t]);
+}
+
+static BOOL col_refs_table(unsigned int x, unsigned int c, unsigned int t, unsigned int *bits, unsigned int *tag)
+{
+    BYTE col = schema[x][c];
+
+    if (col == t && col < NUM_TABLES) { *bits = 0; return TRUE; }
+    if (is_coded(col))
+    {
+        enum coded_kind k = col - C_CODED;
+        unsigned int i;
+
+        for (i = 0; i < coded_info[k].count; i++)
+            if (coded_info[k].tables[i] == t) { *bits = coded_info[k].bits; *tag = i; return TRUE; }
+    }
+    return FALSE;
+}
+
+/* rewrite the references to rows of table t through map (old rid -> new rid) */
+static void remap_refs(struct md_model *c, unsigned int t, const ULONG *map)
+{
+    unsigned int x, col, bits = 0, tag = 0;
+    ULONG r;
+
+    for (x = 0; x < NUM_TABLES; x++)
+    {
+        if (x == 3 || x == 5 || x == 7 || x == 0x13 || x == 0x16) continue;     /* pointer tables are dropped */
+        for (col = 0; col < MAX_COLS && schema[x][col]; col++)
+        {
+            if (!col_refs_table(x, col, t, &bits, &tag) || is_list_col(x, col)) continue;
+            for (r = 1; r <= c->tbl[x].rows; r++)
+            {
+                ULONG *v = mc(c, x, r, col), rid;
+
+                if (!bits)
+                {
+                    if (*v && *v <= c->tbl[t].rows) *v = map[*v];
+                    continue;
+                }
+                if ((*v & ((1u << bits) - 1)) != tag) continue;
+                rid = *v >> bits;
+                if (rid && rid <= c->tbl[t].rows) *v = (map[rid] << bits) | tag;
+            }
+        }
+    }
+}
+
+/* put the rows of table t in the order given by map (old -> new) */
+static BOOL permute_rows(struct md_model *c, unsigned int t, const ULONG *map)
+{
+    ULONG rows = c->tbl[t].rows, r;
+    ULONG *n;
+
+    if (!rows) return TRUE;
+    if (!(n = malloc((SIZE_T)rows * MAX_COLS * sizeof(ULONG)))) return FALSE;
+    for (r = 1; r <= rows; r++) memcpy(&n[(SIZE_T)(map[r] - 1) * MAX_COLS], mc(c, t, r, 0), MAX_COLS * sizeof(ULONG));
+    memcpy(c->tbl[t].c, n, (SIZE_T)rows * MAX_COLS * sizeof(ULONG));
+    free(n);
+    return TRUE;
+}
+
+struct sortkey { ULONG k1, k2, idx; };
+
+static int cmp_sortkey(const void *a, const void *b)
+{
+    const struct sortkey *x = a, *y = b;
+
+    if (x->k1 != y->k1) return x->k1 < y->k1 ? -1 : 1;
+    if (x->k2 != y->k2) return x->k2 < y->k2 ? -1 : 1;
+    return x->idx < y->idx ? -1 : x->idx > y->idx;
+}
+
+/* stable sort of a table by one or two columns; fills map (old -> new) */
+static BOOL sort_table(struct md_model *c, unsigned int t, int col1, int col2, ULONG **map)
+{
+    ULONG rows = c->tbl[t].rows, r;
+    struct sortkey *keys;
+
+    if (!(*map = calloc(rows + 1, sizeof(ULONG)))) return FALSE;
+    if (!rows) return TRUE;
+    if (!(keys = malloc(rows * sizeof(*keys)))) return FALSE;
+    for (r = 1; r <= rows; r++)
+    {
+        keys[r - 1].k1 = *mc(c, t, r, col1);
+        keys[r - 1].k2 = col2 >= 0 ? *mc(c, t, r, col2) : 0;
+        keys[r - 1].idx = r;
+    }
+#ifndef SG_MUTANT_EMIT_NOSORT
+    qsort(keys, rows, sizeof(*keys), cmp_sortkey);
+#endif
+    for (r = 1; r <= rows; r++) (*map)[keys[r - 1].idx] = r;
+    free(keys);
+    return permute_rows(c, t, *map);
+}
+
+static struct md_model *model_compact(struct md_model *md, struct tokmap *tm)
+{
+    static const struct { BYTE owner, col, child; } rel[5] =
+    {
+        { T_TYPEDEF, 4, T_FIELD }, { T_TYPEDEF, 5, T_METHOD }, { T_EVENTMAP, 1, T_EVENT },
+        { T_PROPMAP, 1, T_PROPERTY }, { T_METHOD, 5, T_PARAM },
+    };
+    struct md_model *c = malloc(sizeof(*c));
+    ULONG *newlist[5] = {0}, *inv_method = NULL;
+    ULONG o, i, r;
+    unsigned int t, k;
+    BOOL ok = TRUE;
+
+    memset(tm, 0, sizeof(*tm));
+    if (!c) return NULL;
+    *c = *md;
+    for (t = 0; t < NUM_TABLES; t++)
+    {
+        c->tbl[t].c = NULL;
+        c->tbl[t].cap = 0;
+        c->tbl[t].rows = 0;
+    }
+    for (t = 0; t < NUM_TABLES; t++)
+    {
+        ULONG n = md->tbl[t].rows;
+
+        if (!n) continue;
+        if (!(c->tbl[t].c = malloc((SIZE_T)n * MAX_COLS * sizeof(ULONG)))) { ok = FALSE; break; }
+        memcpy(c->tbl[t].c, md->tbl[t].c, (SIZE_T)n * MAX_COLS * sizeof(ULONG));
+        c->tbl[t].rows = c->tbl[t].cap = n;
+    }
+    if (!ok) goto fail;
+
+    /* phase 1: the new order of the children, parent by parent */
+    for (k = 0; k < 5 && ok; k++)
+    {
+        unsigned int ot = rel[k].owner, child = rel[k].child, pt = ptr_table(child);
+        ULONG orows = md->tbl[ot].rows, crows = md->tbl[child].rows, counter = 0, *map, n;
+
+        if (!(map = calloc(crows + 1, sizeof(ULONG))) || !(newlist[k] = calloc(orows + 1, sizeof(ULONG)))) { free(map); ok = FALSE; break; }
+        tm->m[child] = map;
+        tm->n[child] = crows;
+        for (n = 1; n <= orows; n++)
+        {
+            /* the Param lists are taken in the new order of the methods */
+            ULONG owner = k == 4 ? inv_method[n] : n, s = *mc(md, ot, owner, rel[k].col),
+                  e = owner < orows ? *mc(md, ot, owner + 1, rel[k].col) : MROWS(md, pt) + 1;
+
+            newlist[k][n] = counter + 1;
+            for (i = s; i < e && i <= MROWS(md, pt); i++)
+            {
+                ULONG ch = *mc(md, pt, i, 0);
+
+                if (ch && ch <= crows && !map[ch]) map[ch] = ++counter;
+            }
+        }
+#ifdef SG_MUTANT_EMIT_NOPACK
+        memset(map, 0, (crows + 1) * sizeof(*map));
+        counter = 0;
+#endif
+        for (r = 1; r <= crows; r++) if (!map[r]) map[r] = ++counter;       /* children in no list */
+        if (k == 1)
+        {
+            if (!(inv_method = calloc(crows + 1, sizeof(ULONG)))) { ok = FALSE; break; }
+            for (r = 1; r <= crows; r++) inv_method[map[r]] = r;
+        }
+    }
+    if (!ok) goto fail;
+
+    /* phase 2: move the children and write the new lists */
+    for (k = 0; k < 5 && ok; k++) ok = permute_rows(c, rel[k].child, tm->m[rel[k].child]);
+    if (!ok) goto fail;
+    for (k = 0; k < 5; k++)
+    {
+        unsigned int ot = rel[k].owner;
+
+        for (o = 1; o <= c->tbl[ot].rows; o++) *mc(c, ot, o, rel[k].col) = newlist[k][o];
+    }
+    for (t = 3; t < NUM_TABLES; t++) if (t == 3 || t == 5 || t == 7 || t == 0x13 || t == 0x16) c->tbl[t].rows = 0;
+#ifndef SG_MUTANT_EMIT_NOREMAP
+    for (k = 0; k < 5; k++) remap_refs(c, rel[k].child, tm->m[rel[k].child]);
+#endif
+
+    /* phase 3: the sorted tables; those that others point to are sorted first */
+    {
+        static const struct { BYTE t; signed char k1, k2; } a[] =
+        {
+            { T_IFACEIMPL, 0, -1 }, { T_CONSTANT, 2, -1 }, { T_FMARSHAL, 0, -1 }, { T_DECLSEC, 1, -1 },
+            { T_CLASSLAYOUT, 2, -1 }, { T_FIELDLAYOUT, 1, -1 }, { T_METHODSEM, 2, -1 }, { T_METHODIMPL, 0, -1 },
+            { T_IMPLMAP, 1, -1 }, { T_FIELDRVA, 1, -1 }, { T_NESTED, 0, -1 }, { T_GENERICPARAM, 2, 0 },
+            { T_GPC, 0, -1 }, { T_CA, 0, -1 },
+        };
+
+        for (i = 0; i < ARRAY_SIZE(a) && ok; i++)
+        {
+            ok = sort_table(c, a[i].t, a[i].k1, a[i].k2, &tm->m[a[i].t]);
+            tm->n[a[i].t] = c->tbl[a[i].t].rows;
+            if (ok) remap_refs(c, a[i].t, tm->m[a[i].t]);
+            /* the generic parameter constraints are sorted by the owner, which has moved above */
+        }
+    }
+    if (!ok) goto fail;
+    free(inv_method);
+    for (k = 0; k < 5; k++) free(newlist[k]);
+    return c;
+fail:
+    free(inv_method);
+    for (k = 0; k < 5; k++) free(newlist[k]);
+    for (t = 0; t < NUM_TABLES; t++) free(c->tbl[t].c);
+    free(c);
+    tokmap_free(tm);
+    return NULL;
+}
+
+static void compact_free(struct md_model *c)
+{
+    unsigned int t;
+
+    for (t = 0; t < NUM_TABLES; t++) free(c->tbl[t].c);
+    free(c);
+}
+
+/* tell the handler (an IMapToken) about every token that Save changed */
+static void notify_tokens(IUnknown *handler, const struct tokmap *tm)
+{
+    IMapToken *map;
+    unsigned int t;
+    ULONG r, n;
+
+    if (!handler || FAILED(IUnknown_QueryInterface(handler, &IID_IMapToken, (void **)&map))) return;
+    for (t = 0; t < NUM_TABLES; t++)
+    {
+        if (!tm->m[t]) continue;
+        n = tm->n[t];
+        for (r = 1; r <= n; r++)
+            if (tm->m[t][r] != r) IMapToken_Map(map, MKTK(t, r), MKTK(t, tm->m[t][r]));
+    }
+    IMapToken_Release(map);
+}
+
+static BOOL write_metadata(struct md_model *md, BOOL saved, BYTE **data, SIZE_T *size)
+{
+    struct md_scope tmp;
+    struct out tb = {0}, root = {0};
+    unsigned int t, c;
+    ULONG64 valid = 0;
+    ULONG i, vlen;
+    ULONG str_size = (md->str.n + 3) & ~3u, us_size = (md->us.n + 3) & ~3u, blob_size = (md->blob.n + 3) & ~3u;
+    ULONG guid_size = md->nguid * 16;
+    BYTE heap_bits = 0;
+    BOOL skip[NUM_TABLES] = {0};
+    static const BYTE zero[4];
+
+    /* a pointer table that maps each position to the same row is left out of the file */
+    for (t = 0; t < NUM_TABLES; t++)
+    {
+        ULONG r;
+
+        if (t != 3 && t != 5 && t != 7 && t != 0x13 && t != 0x16) continue;
+        skip[t] = TRUE;
+#ifndef SG_MUTANT_EMIT_PTRLIVE
+        for (r = 1; r <= md->tbl[t].rows; r++) if (*mc(md, t, r, 0) != r) skip[t] = FALSE;
+#endif
+    }
+
+    memset(&tmp, 0, sizeof(tmp));
+    if (md->str.n > 0xffff) heap_bits |= 1;
+    if (md->nguid > 0xffff) heap_bits |= 2;
+    if (md->blob.n > 0xffff) heap_bits |= 4;
+    tmp.heap_sizes = heap_bits;
+    for (t = 0; t < NUM_TABLES; t++)
+    {
+        tmp.tables[t].rows = skip[t] ? 0 : md->tbl[t].rows;
+        if (tmp.tables[t].rows) valid |= (ULONG64)1 << t;
+    }
+
+    /* the #~ stream */
+    out_uint(&tb, 0, 4);
+    out_uint(&tb, 2, 1);
+    out_uint(&tb, 0, 1);
+    out_uint(&tb, heap_bits, 1);
+    out_uint(&tb, 1, 1);
+    out_uint(&tb, valid, 8);
+    out_uint(&tb, saved ? SORTED_MASK : 0, 8);
+    for (t = 0; t < NUM_TABLES; t++)
+        if (tmp.tables[t].rows) out_uint(&tb, tmp.tables[t].rows, 4);
+    for (t = 0; t < NUM_TABLES; t++)
+    {
+        ULONG r;
+
+        for (r = 1; r <= tmp.tables[t].rows; r++)
+            for (c = 0; c < MAX_COLS && schema[t][c]; c++)
+                out_uint(&tb, *mc(md, t, r, c), col_width(&tmp, schema[t][c]));
+    }
+    out_pad4(&tb);
+
+    /* the root and the stream headers */
+    vlen = (strlen(md->version) + 1 + 3) & ~3u;
+    {
+        static const char *names[5] = { "#~", "#Strings", "#US", "#GUID", "#Blob" };
+        ULONG sizes[5] = { tb.n, str_size, us_size, guid_size, blob_size };
+        ULONG hdr = 16 + vlen + 4, off;
+
+        for (i = 0; i < 5; i++) hdr += 8 + ((strlen(names[i]) + 1 + 3) & ~3u);
+        out_uint(&root, 0x424a5342, 4);
+        out_uint(&root, 1, 2);
+        out_uint(&root, 1, 2);
+        out_uint(&root, 0, 4);
+        out_uint(&root, vlen, 4);
+        out_put(&root, md->version, strlen(md->version) + 1);
+        for (i = strlen(md->version) + 1; i < vlen; i++) out_put(&root, zero, 1);
+        out_uint(&root, 0, 2);
+        out_uint(&root, 5, 2);
+        for (off = hdr, i = 0; i < 5; i++)
+        {
+            ULONG nl = (strlen(names[i]) + 1 + 3) & ~3u;
+
+            out_uint(&root, off, 4);
+            out_uint(&root, sizes[i], 4);
+            out_put(&root, names[i], strlen(names[i]) + 1);
+            out_put(&root, zero, nl - strlen(names[i]) - 1);
+            off += sizes[i];
+        }
+    }
+    out_put(&root, tb.d, tb.n);
+    out_put(&root, md->str.d, md->str.n);
+    out_put(&root, zero, str_size - md->str.n);
+    out_put(&root, md->us.d, md->us.n);
+    out_put(&root, zero, us_size - md->us.n);
+    out_put(&root, md->guid, guid_size);
+    out_put(&root, md->blob.d, md->blob.n);
+    out_put(&root, zero, blob_size - md->blob.n);
+    free(tb.d);
+    if (root.fail) { free(root.d); return FALSE; }
+    *data = root.d;
+    *size = root.n;
+    return TRUE;
+}
+
+/* the metadata as the reader should see it while the scope is edited */
+static BOOL model_serialize_live(struct md_model *md, BYTE **data, SIZE_T *size)
+{
+    return write_metadata(md, FALSE, data, size);
+}
+
+/* the metadata as a file: renumbered and sorted; the handler hears about the changed tokens */
+static BOOL model_serialize(struct md_model *md, BYTE **data, SIZE_T *size, BOOL notify)
+{
+    struct tokmap tm;
+    struct md_model *c;
+    BOOL ret;
+
+    if (!(c = model_compact(md, &tm))) return FALSE;
+    ret = write_metadata(c, TRUE, data, size);
+#ifndef SG_MUTANT_EMIT_NOMAP
+    if (ret && notify) notify_tokens(md->handler, &tm);
+#endif
+    compact_free(c);
+    tokmap_free(&tm);
+    return ret;
+}
+
+/* make the reader see the model: serialise and parse again (the old buffer stays valid until release) */
+static void model_sync(struct md_scope *m)
+{
+    struct md_model *md = m->model;
+    BYTE *buf;
+    SIZE_T size;
+    void **old;
+
+    if (!md || !m->dirty) return;
+    if (!model_serialize_live(md, &buf, &size)) return;
+    if (!(old = realloc(md->old, (md->nold + 1) * sizeof(*old)))) { free(buf); return; }
+    md->old = old;
+    if (m->file) md->old[md->nold++] = m->file;
+    memset(m->tables, 0, sizeof(m->tables));
+    m->file = buf;
+    m->file_size = size;
+    if (FAILED(parse_root(m, buf, size))) ERR("the serialised metadata does not parse\n");
+    m->dirty = FALSE;
+}
+
+/* ---- IMetaDataEmit ---- */
+
+static inline struct md_scope *impl_from_emit(IMetaDataEmit2 *iface)
+{
+    return CONTAINING_RECORD(iface, struct md_scope, emit_iface);
+}
+
+static inline struct md_scope *impl_from_asmemit(IMetaDataAssemblyEmit *iface)
+{
+    return CONTAINING_RECORD(iface, struct md_scope, asmemit_iface);
+}
+
+#define UNUSED_VAR __attribute__((unused))
+#define EMIT_ENTER struct md_scope *m = impl_from_emit(iface); struct md_model *md UNUSED_VAR = m->model; \
+                   HRESULT hr UNUSED_VAR; BOOL ok UNUSED_VAR = TRUE
+#define ASMEMIT_ENTER struct md_scope *m = impl_from_asmemit(iface); struct md_model *md UNUSED_VAR = m->model; \
+                      HRESULT hr UNUSED_VAR; BOOL ok UNUSED_VAR = TRUE
+#define UNCHANGED 0xffffffffu
+#define NO_MEM(cond) do { if (!(cond)) return E_OUTOFMEMORY; } while (0)
+
+static HRESULT WINAPI emit_QueryInterface(IMetaDataEmit2 *iface, REFIID riid, void **obj)
+{
+    return scope_qi(impl_from_emit(iface), riid, obj);
+}
+
+static ULONG WINAPI emit_AddRef(IMetaDataEmit2 *iface)
+{
+    return InterlockedIncrement(&impl_from_emit(iface)->refcount);
+}
+
+static ULONG WINAPI emit_Release(IMetaDataEmit2 *iface)
+{
+    return scope_release(impl_from_emit(iface));
+}
+
+static HRESULT WINAPI emit_SetModuleProps(IMetaDataEmit2 *iface, const WCHAR *name)
+{
+    EMIT_ENTER;
+
+    TRACE("%p %s\n", iface, debugstr_w(name));
+    if (!name) return E_INVALIDARG;
+    *mc(md, T_MODULE, 1, 1) = str_w(md, name, &ok);
+    NO_MEM(ok);
+    m->dirty = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI emit_GetSaveSize(IMetaDataEmit2 *iface, DWORD fSave, DWORD *size)
+{
+    EMIT_ENTER;
+    BYTE *data;
+    SIZE_T len;
+
+    TRACE("%p %#lx %p\n", iface, fSave, size);
+    if (!size) return E_INVALIDARG;
+    NO_MEM(model_serialize(md, &data, &len, FALSE));
+    free(data);
+    *size = len;
+    return S_OK;
+}
+
+static HRESULT WINAPI emit_Save(IMetaDataEmit2 *iface, const WCHAR *file, DWORD flags)
+{
+    EMIT_ENTER;
+    BYTE *data;
+    SIZE_T len;
+    HANDLE h;
+    DWORD written;
+    BOOL ret;
+
+    TRACE("%p %s %#lx\n", iface, debugstr_w(file), flags);
+    if (!file) return E_INVALIDARG;
+    NO_MEM(model_serialize(md, &data, &len, TRUE));
+    h = CreateFileW(file, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h == INVALID_HANDLE_VALUE) { free(data); return HRESULT_FROM_WIN32(GetLastError()); }
+    ret = WriteFile(h, data, len, &written, NULL) && written == len;
+    hr = ret ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+    CloseHandle(h);
+    free(data);
+    return hr;
+}
+
+static HRESULT WINAPI emit_SaveToStream(IMetaDataEmit2 *iface, IStream *stream, DWORD flags)
+{
+    EMIT_ENTER;
+    BYTE *data;
+    SIZE_T len;
+    ULONG written;
+
+    TRACE("%p %p %#lx\n", iface, stream, flags);
+    if (!stream) return E_INVALIDARG;
+    NO_MEM(model_serialize(md, &data, &len, TRUE));
+    hr = IStream_Write(stream, data, len, &written);
+    free(data);
+    if (SUCCEEDED(hr) && written != len) hr = E_FAIL;
+    return hr;
+}
+
+static HRESULT WINAPI emit_SaveToMemory(IMetaDataEmit2 *iface, void *buf, ULONG size)
+{
+    EMIT_ENTER;
+    BYTE *data;
+    SIZE_T len;
+
+    TRACE("%p %p %lu\n", iface, buf, size);
+    if (!buf) return E_INVALIDARG;
+    NO_MEM(model_serialize(md, &data, &len, TRUE));
+    if (len > size) { free(data); return CLDB_E_TRUNCATION; }
+    memcpy(buf, data, len);
+    free(data);
+    return S_OK;
+}
+
+/* the TypeDef rows that are not nested, same namespace and name */
+static BOOL type_exists(struct md_model *md, ULONG ns, ULONG name, ULONG encloser)
+{
+    ULONG r, n;
+
+    for (r = 2; r <= MROWS(md, T_TYPEDEF); r++)
+    {
+        ULONG enc = 0;
+
+        if (*mc(md, T_TYPEDEF, r, 1) != name || *mc(md, T_TYPEDEF, r, 2) != ns) continue;
+        for (n = 1; n <= MROWS(md, T_NESTED); n++)
+            if (*mc(md, T_NESTED, n, 0) == r) enc = *mc(md, T_NESTED, n, 1);
+        if (enc == encloser) return TRUE;
+    }
+    return FALSE;
+}
+
+static HRESULT add_interfaces(struct md_model *md, ULONG td, const ULONG32 *impls)
+{
+    HRESULT hr;
+
+    for (; impls && *impls; impls++)
+    {
+        ULONG v, row;
+
+        if (TK_T(*impls) != T_TYPEDEF && TK_T(*impls) != T_TYPEREF && TK_T(*impls) != T_TYPESPEC) return E_INVALIDARG;
+        if (FAILED(hr = coded_of(md, CI_TYPEDEFORREF, *impls, &v))) return hr;
+        if (!(row = sorted_add(md, T_IFACEIMPL, 0, td))) return E_OUTOFMEMORY;
+        *mc(md, T_IFACEIMPL, row, 1) = v;
+    }
+    return S_OK;
+}
