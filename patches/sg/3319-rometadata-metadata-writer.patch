+        if (*mc(md, T_FIELDRVA, r, 1) == TK_R(fd)) break;
+    if (r > MROWS(md, T_FIELDRVA)) NO_MEM(r = sorted_add(md, T_FIELDRVA, 1, TK_R(fd)));
+    *mc(md, T_FIELDRVA, r, 0) = rva;
+    set_flag(md, fd, fdHasFieldRVA, TRUE);
