+/* ---- generics ---- */
+
+static HRESULT add_constraints(struct md_model *md, ULONG gp, const ULONG32 *cons)
+{
+    HRESULT hr;
+
+    for (; cons && *cons; cons++)
+    {
+        ULONG v, row;
+
+        if (TK_T(*cons) != T_TYPEDEF && TK_T(*cons) != T_TYPEREF && TK_T(*cons) != T_TYPESPEC) return E_INVALIDARG;
+        if (FAILED(hr = coded_of(md, CI_TYPEDEFORREF, *cons, &v))) return hr;
+        if (!(row = sorted_add(md, T_GPC, 0, gp))) return E_OUTOFMEMORY;
+        *mc(md, T_GPC, row, 1) = v;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI emit_DefineGenericParam(IMetaDataEmit2 *iface, ULONG32 tk, ULONG seq, DWORD flags,
+                                              const WCHAR *name, DWORD reserved, ULONG32 *cons, ULONG32 *pgp)
+{
+    EMIT_ENTER;
+    ULONG ov, nm, pos;
+
+    TRACE("%p %#x %lu %#lx %s %lu %p %p\n", iface, tk, seq, flags, debugstr_w(name), reserved, cons, pgp);
+    if (!pgp || !tk) return E_INVALIDARG;
+    if (TK_T(tk) != T_TYPEDEF && TK_T(tk) != T_METHOD) return E_INVALIDARG;
+    if (FAILED(hr = coded_of(md, CI_TYPEORMETHODDEF, tk, &ov))) return hr;
+    nm = str_w(md, name, &ok);
+    NO_MEM(ok);
+    NO_MEM(pos = row_add(md, T_GENERICPARAM));
+    *mc(md, T_GENERICPARAM, pos, 0) = seq;
+    *mc(md, T_GENERICPARAM, pos, 1) = flags;
+    *mc(md, T_GENERICPARAM, pos, 2) = ov;
+    *mc(md, T_GENERICPARAM, pos, 3) = nm;
+    m->dirty = TRUE;
+    *pgp = MKTK(T_GENERICPARAM, pos);
+    return add_constraints(md, pos, cons);
+}
+
+static HRESULT WINAPI emit_SetGenericParamProps(IMetaDataEmit2 *iface, ULONG32 gp, DWORD flags, const WCHAR *name,
+                                                DWORD reserved, ULONG32 *cons)
+{
+    EMIT_ENTER;
+    ULONG r;
+
+    TRACE("%p %#x %#lx %s %lu %p\n", iface, gp, flags, debugstr_w(name), reserved, cons);
+    if (TK_T(gp) != T_GENERICPARAM) return E_INVALIDARG;
+    if (!tok_ok(md, gp)) return CLDB_E_INDEX_NOTFOUND;
+    if (flags != UNCHANGED) *mc(md, T_GENERICPARAM, TK_R(gp), 1) = flags;
+    if (name) *mc(md, T_GENERICPARAM, TK_R(gp), 3) = str_w(md, name, &ok);
+    NO_MEM(ok);
+    if (cons)
+    {
+        for (r = MROWS(md, T_GPC); r >= 1; r--)
+            if (*mc(md, T_GPC, r, 0) == TK_R(gp)) row_remove(md, T_GPC, r);
+        m->dirty = TRUE;
+        if (FAILED(hr = add_constraints(md, TK_R(gp), cons))) return hr;
+    }
+    m->dirty = TRUE;
+    return S_OK;
+}
