+/* the owning TypeDef rid for a member definition: a nil token means the global type */
+static HRESULT owner_rid(struct md_model *md, ULONG32 td, ULONG *rid)
+{
+    if (!td) { *rid = 1; return S_OK; }
+    if (TK_T(td) != T_TYPEDEF) return E_INVALIDARG;
+    if (!tok_ok(md, td)) return CLDB_E_INDEX_NOTFOUND;
+    *rid = TK_R(td);
+    return S_OK;
+}
