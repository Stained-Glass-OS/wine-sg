+/* ---- events and properties ---- */
+
+#define MS_SETTER 0x1
+#define MS_GETTER 0x2
+#define MS_OTHER  0x4
+#define MS_ADDON  0x8
+#define MS_REMOVE 0x10
+#define MS_FIRE   0x20
+
+/* the EventMap or PropertyMap row of a type, created when the type gets its first event or property */
+static ULONG map_row(struct md_model *md, unsigned int map_t, unsigned int child_t, ULONG owner)
+{
+    ULONG r;
+
+    for (r = 1; r <= MROWS(md, map_t); r++)
+        if (*mc(md, map_t, r, 0) == owner) return r;
+    if (!(r = row_add(md, map_t))) return 0;
+    *mc(md, map_t, r, 0) = owner;
+    *mc(md, map_t, r, 1) = MROWS(md, ptr_table(child_t)) + 1;
+    return r;
+}
+
+/* the method that has the given role for an event or property; replaced when it exists, except "other" */
+static HRESULT sem_set(struct md_model *md, ULONG32 assoc, DWORD kind, ULONG32 method)
+{
+    ULONG av, r;
+    HRESULT hr;
+
+    if (!method) return S_OK;
+    if (TK_T(method) != T_METHOD) return E_INVALIDARG;
+    if (!tok_ok(md, method)) return CLDB_E_INDEX_NOTFOUND;
+    if (FAILED(hr = coded_of(md, CI_HASSEMANTICS, assoc, &av))) return hr;
+    if (kind != MS_OTHER)
+        for (r = 1; r <= MROWS(md, T_METHODSEM); r++)
+            if (*mc(md, T_METHODSEM, r, 2) == av && *mc(md, T_METHODSEM, r, 0) == kind)
+            {
+                *mc(md, T_METHODSEM, r, 1) = TK_R(method);
+                return S_OK;
+            }
+    if (!(r = sorted_add(md, T_METHODSEM, 2, av))) return E_OUTOFMEMORY;
+    *mc(md, T_METHODSEM, r, 0) = kind;
+    *mc(md, T_METHODSEM, r, 1) = TK_R(method);
+    return S_OK;
+}
+
+static HRESULT sem_others(struct md_model *md, ULONG32 assoc, const ULONG32 *others)
+{
+    HRESULT hr;
+
+    for (; others && *others; others++)
+        if (FAILED(hr = sem_set(md, assoc, MS_OTHER, *others))) return hr;
+    return S_OK;
+}
