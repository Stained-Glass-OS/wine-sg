+    TRACE("%p %#x %s %#lx %p %lu %#lx %p %lu %p\n", iface, td, debugstr_w(name), flags, sig, cbsig, ctype, value, cch, pfd);
+    if (!name || !pfd) return E_INVALIDARG;
