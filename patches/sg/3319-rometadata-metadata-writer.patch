+static HRESULT WINAPI asmemit_DefineAssembly(IMetaDataAssemblyEmit *iface, const void *key, ULONG cbkey, ULONG alg,
+                                             const WCHAR *name, const ASSEMBLYMETADATA *am, DWORD flags, ULONG32 *pma)
+{
+    ASMEMIT_ENTER;
+    ULONG row;
+
+    TRACE("%p %p %lu %#lx %s %p %#lx %p\n", iface, key, cbkey, alg, debugstr_w(name), am, flags, pma);
+    if (!name || !*name || !pma) return E_INVALIDARG;
+    if (MROWS(md, T_ASSEMBLY)) return CLDB_E_RECORD_DUPLICATE;   /* one assembly per manifest */
+    NO_MEM(row = row_add(md, T_ASSEMBLY));
+    if (FAILED(hr = set_assembly(m, row, key, cbkey, alg, name, am, flags))) return hr;
+    *pma = MKTK(T_ASSEMBLY, row);
+    return S_OK;
+}
+
+static HRESULT set_assemblyref(struct md_scope *m, ULONG row, const void *key, ULONG cbkey, const WCHAR *name,
+                               const ASSEMBLYMETADATA *am, const void *hash, ULONG cbhash, DWORD flags)
+{
+    struct md_model *md = m->model;
+    BOOL ok = TRUE;
+
+    put_version(md, T_ASMREF, row, 0, am);
+    *mc(md, T_ASMREF, row, 4) = flags;
+    *mc(md, T_ASMREF, row, 5) = blob_of(md, key, cbkey, &ok);
+    *mc(md, T_ASMREF, row, 6) = str_w(md, name, &ok);
+    *mc(md, T_ASMREF, row, 7) = culture_of(md, am, &ok);
+    *mc(md, T_ASMREF, row, 8) = blob_of(md, hash, cbhash, &ok);
+    m->dirty = TRUE;
+    return ok ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI asmemit_DefineAssemblyRef(IMetaDataAssemblyEmit *iface, const void *key, ULONG cbkey,
+                                                const WCHAR *name, const ASSEMBLYMETADATA *am, const void *hash,
+                                                ULONG cbhash, DWORD flags, ULONG32 *pmdar)
+{
+    ASMEMIT_ENTER;
+    ULONG row, r, nm, ky, cu;
+
+    TRACE("%p %p %lu %s %p %p %lu %#lx %p\n", iface, key, cbkey, debugstr_w(name), am, hash, cbhash, flags, pmdar);
+    if (!name || !*name || !pmdar) return E_INVALIDARG;
+    nm = str_w(md, name, &ok);
+    ky = blob_of(md, key, cbkey, &ok);
+    cu = culture_of(md, am, &ok);
+    NO_MEM(ok);
+    /* the same assembly (name, version, culture, key) is one row */
+    for (r = 1; r <= MROWS(md, T_ASMREF); r++)
+        if (*mc(md, T_ASMREF, r, 6) == nm && *mc(md, T_ASMREF, r, 7) == cu && *mc(md, T_ASMREF, r, 5) == ky &&
+            *mc(md, T_ASMREF, r, 0) == (am ? am->usMajorVersion : 0) &&
+            *mc(md, T_ASMREF, r, 1) == (am ? am->usMinorVersion : 0) &&
+            *mc(md, T_ASMREF, r, 2) == (am ? am->usBuildNumber : 0) &&
+            *mc(md, T_ASMREF, r, 3) == (am ? am->usRevisionNumber : 0))
+        {
+            *pmdar = MKTK(T_ASMREF, r);
+            return S_OK;
+        }
+    NO_MEM(row = row_add(md, T_ASMREF));
+    if (FAILED(hr = set_assemblyref(m, row, key, cbkey, name, am, hash, cbhash, flags))) return hr;
+    *pmdar = MKTK(T_ASMREF, row);
+    return S_OK;
+}
