+/* a name that marks a deleted definition */
+static HRESULT WINAPI emit_DeleteToken(IMetaDataEmit2 *iface, ULONG32 tk)
+{
+    EMIT_ENTER;
+    ULONG rid = TK_R(tk);
+
+    TRACE("%p %#x\n", iface, tk);
+    if (!tok_ok(md, tk)) return CLDB_E_INDEX_NOTFOUND;
+    switch (TK_T(tk))
+    {
+    case T_TYPEDEF:
+        if (rid == 1) return E_INVALIDARG;
+        *mc(md, T_TYPEDEF, rid, 1) = heap_add(&md->str, "_Deleted", 8);
+        *mc(md, T_TYPEDEF, rid, 0) |= tdSpecialName | tdRTSpecialName;
+        break;
+    case T_METHOD:
+        *mc(md, T_METHOD, rid, 3) = heap_add(&md->str, "_Deleted", 8);
+        *mc(md, T_METHOD, rid, 2) |= mdSpecialName | mdRTSpecialName;
+        break;
+    case T_FIELD:
+        *mc(md, T_FIELD, rid, 1) = heap_add(&md->str, "_Deleted", 8);
+        *mc(md, T_FIELD, rid, 0) |= fdSpecialName | fdRTSpecialName;
+        break;
+    case T_CA:
+        row_remove(md, T_CA, rid);
+        break;
+    default:
+        FIXME("token %#x: table not supported\n", tk);
+        return E_NOTIMPL;
+    }
+    m->dirty = TRUE;
+    return S_OK;
+}
