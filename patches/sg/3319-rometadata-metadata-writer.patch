+static HRESULT WINAPI emit_DefineMethodSpec(IMetaDataEmit2 *iface, ULONG32 parent, const BYTE *sig, ULONG cb,
+                                            ULONG32 *pmi)
+{
+    EMIT_ENTER;
+    ULONG pv, sg, r;
+
+    TRACE("%p %#x %p %lu %p\n", iface, parent, sig, cb, pmi);
+    if (!parent || !sig || !cb || !pmi) return E_INVALIDARG;
+    if (TK_T(parent) != T_METHOD && TK_T(parent) != T_MEMBERREF) return E_INVALIDARG;
+    if (FAILED(hr = coded_of(md, CI_METHODDEFORREF, parent, &pv))) return hr;
+    sg = blob_of(md, sig, cb, &ok);
+    NO_MEM(ok);
+    for (r = 1; r <= MROWS(md, T_METHODSPEC); r++)
+        if (*mc(md, T_METHODSPEC, r, 0) == pv && *mc(md, T_METHODSPEC, r, 1) == sg)
+        {
+            *pmi = MKTK(T_METHODSPEC, r);
+            return S_OK;
+        }
+    NO_MEM(r = row_add(md, T_METHODSPEC));
+    *mc(md, T_METHODSPEC, r, 0) = pv;
+    *mc(md, T_METHODSPEC, r, 1) = sg;
+    m->dirty = TRUE;
+    *pmi = MKTK(T_METHODSPEC, r);
+    return S_OK;
+}
