+static HRESULT pinvoke_map(struct md_scope *m, ULONG32 tk, DWORD flags, const WCHAR *name, ULONG32 module, BOOL must_exist)
+{
+    struct md_model *md = m->model;
+    ULONG mv, r, nm = 0;
+    BOOL ok = TRUE;
+    HRESULT hr;
+
+    if (TK_T(tk) != T_METHOD && TK_T(tk) != T_FIELD) return E_INVALIDARG;
+    if (FAILED(hr = coded_of(md, CI_MEMBERFORWARDED, tk, &mv))) return hr;
+    if (module && (TK_T(module) != T_MODULEREF || !tok_ok(md, module))) return module && TK_T(module) != T_MODULEREF ? E_INVALIDARG : CLDB_E_INDEX_NOTFOUND;
+    nm = str_w(md, name, &ok);
+    NO_MEM(ok);
+    for (r = 1; r <= MROWS(md, T_IMPLMAP); r++)
+        if (*mc(md, T_IMPLMAP, r, 1) == mv) break;
+    if (r > MROWS(md, T_IMPLMAP))
+    {
+        if (must_exist) return CLDB_E_RECORD_NOTFOUND;
+        NO_MEM(r = sorted_add(md, T_IMPLMAP, 1, mv));
+    }
+    *mc(md, T_IMPLMAP, r, 0) = flags;
+    *mc(md, T_IMPLMAP, r, 2) = nm;
+    *mc(md, T_IMPLMAP, r, 3) = TK_R(module);
+    set_flag(md, tk, TK_T(tk) == T_METHOD ? mdPinvokeImpl : fdPinvokeImpl, TRUE);
+    m->dirty = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI emit_DefinePinvokeMap(IMetaDataEmit2 *iface, ULONG32 tk, DWORD flags, const WCHAR *name,
+                                            ULONG32 module)
+{
+    TRACE("%p %#x %#lx %s %#x\n", iface, tk, flags, debugstr_w(name), module);
+    return pinvoke_map(impl_from_emit(iface), tk, flags, name, module, FALSE);
+}
+
+static HRESULT WINAPI emit_SetPinvokeMap(IMetaDataEmit2 *iface, ULONG32 tk, DWORD flags, const WCHAR *name,
+                                         ULONG32 module)
+{
+    TRACE("%p %#x %#lx %s %#x\n", iface, tk, flags, debugstr_w(name), module);
+    return pinvoke_map(impl_from_emit(iface), tk, flags, name, module, TRUE);
+}
+
+static HRESULT WINAPI emit_DeletePinvokeMap(IMetaDataEmit2 *iface, ULONG32 tk)
+{
+    EMIT_ENTER;
+    ULONG mv, r;
+
+    TRACE("%p %#x\n", iface, tk);
+    if (TK_T(tk) != T_METHOD && TK_T(tk) != T_FIELD) return E_INVALIDARG;
+    if (FAILED(hr = coded_of(md, CI_MEMBERFORWARDED, tk, &mv))) return hr;
+    for (r = 1; r <= MROWS(md, T_IMPLMAP); r++)
+        if (*mc(md, T_IMPLMAP, r, 1) == mv)
+        {
+            row_remove(md, T_IMPLMAP, r);
+            set_flag(md, tk, TK_T(tk) == T_METHOD ? mdPinvokeImpl : fdPinvokeImpl, FALSE);
+            m->dirty = TRUE;
+            return S_OK;
+        }
+    return CLDB_E_RECORD_NOTFOUND;
+}
