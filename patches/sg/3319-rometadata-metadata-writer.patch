+static HRESULT WINAPI emit_DefineUserString(IMetaDataEmit2 *iface, const WCHAR *str, ULONG cch, ULONG32 *pstk)
+{
+    EMIT_ENTER;
+    BYTE *buf;
+    ULONG i, off;
+    BOOL wide = FALSE;
+
+    TRACE("%p %s %lu %p\n", iface, debugstr_wn(str, cch), cch, pstk);
+    if (!pstk || (!str && cch)) return E_INVALIDARG;
+    NO_MEM(buf = malloc(cch * 2 + 1));
+    for (i = 0; i < cch; i++)
+    {
+        BYTE lo = str[i] & 0xff, hi = str[i] >> 8;
+
+        buf[i * 2] = lo;
+        buf[i * 2 + 1] = hi;
+        /* the final byte: 1 if a character needs special handling (ECMA-335 II.24.2.4) */
+        if (hi || (lo >= 1 && lo <= 8) || (lo >= 0xe && lo <= 0x1f) || lo == 0x27 || lo == 0x2d || lo == 0x7f) wide = TRUE;
+    }
+    buf[cch * 2] = wide;
+    off = heap_add(&md->us, buf, cch * 2 + 1);
+    free(buf);
+    NO_MEM(off);
+    m->dirty = TRUE;
+    *pstk = (mdtString) | off;
+    return S_OK;
+}
