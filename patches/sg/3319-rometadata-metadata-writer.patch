+static HRESULT define_permission_set(struct md_scope *m, ULONG32 tk, DWORD action, const void *perm, ULONG cb,
+                                     BOOL replace, ULONG32 *ppm)
+{
+    struct md_model *md = m->model;
+    ULONG pv, r, bl;
+    BOOL ok = TRUE;
+    HRESULT hr;
+
+    if (TK_T(tk) != T_TYPEDEF && TK_T(tk) != T_METHOD && TK_T(tk) != T_ASSEMBLY) return E_INVALIDARG;
+    if (!perm || !cb) return E_INVALIDARG;
+    if (FAILED(hr = coded_of(md, CI_HASDECLSEC, tk, &pv))) return hr;
+    bl = blob_of(md, perm, cb, &ok);
+    NO_MEM(ok);
+    r = MROWS(md, T_DECLSEC) + 1;
+    if (replace)
+        for (r = 1; r <= MROWS(md, T_DECLSEC); r++)
+            if (*mc(md, T_DECLSEC, r, 1) == pv && *mc(md, T_DECLSEC, r, 0) == action) break;
+    if (r > MROWS(md, T_DECLSEC)) NO_MEM(r = sorted_add(md, T_DECLSEC, 1, pv));
+    *mc(md, T_DECLSEC, r, 0) = action;
+    *mc(md, T_DECLSEC, r, 2) = bl;
+    if (TK_T(tk) == T_TYPEDEF) set_flag(md, tk, tdHasSecurity, TRUE);
+    else if (TK_T(tk) == T_METHOD) set_flag(md, tk, mdHasSecurity, TRUE);
+    m->dirty = TRUE;
+    if (ppm) *ppm = MKTK(T_DECLSEC, r);
+    return S_OK;
+}
+
+static HRESULT WINAPI emit_DefinePermissionSet(IMetaDataEmit2 *iface, ULONG32 tk, DWORD action, const void *perm,
+                                               ULONG cb, ULONG32 *ppm)
+{
+    TRACE("%p %#x %#lx %p %lu %p\n", iface, tk, action, perm, cb, ppm);
+    return define_permission_set(impl_from_emit(iface), tk, action, perm, cb, FALSE, ppm);
+}
+
+static HRESULT WINAPI emit_SetPermissionSetProps(IMetaDataEmit2 *iface, ULONG32 tk, DWORD action, const void *perm,
+                                                 ULONG cb, ULONG32 *ppm)
+{
+    TRACE("%p %#x %#lx %p %lu %p\n", iface, tk, action, perm, cb, ppm);
+    return define_permission_set(impl_from_emit(iface), tk, action, perm, cb, TRUE, ppm);
+}
