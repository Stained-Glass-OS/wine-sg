+/* ---- importing definitions from another scope ---- */
+
+struct xlate
+{
+    struct md_scope *dest;              /* the scope being emitted into */
+    IMetaDataAssemblyImport *ai;
+    const void *hash;
+    ULONG cbhash;
+    IMetaDataImport *imp;
+    IMetaDataAssemblyEmit *ae;
+};
+
+static HRESULT xlate_token(struct xlate *x, ULONG32 tk, ULONG32 *out);
+
+static ULONG tail_token(const BYTE *key, ULONG cb, BYTE token[8])
+{
+    HCRYPTPROV prov;
+    HCRYPTHASH hash;
+    BYTE digest[20];
+    DWORD size = sizeof(digest);
+    BOOL ok = FALSE;
+    int i;
+
+    if (!CryptAcquireContextW(&prov, NULL, NULL, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT)) return 0;
+    if (CryptCreateHash(prov, CALG_SHA1, 0, 0, &hash))
+    {
+        ok = CryptHashData(hash, key, cb, 0) && CryptGetHashParam(hash, HP_HASHVAL, digest, &size, 0);
+        CryptDestroyHash(hash);
+    }
+    CryptReleaseContext(prov, 0);
+    if (!ok) return 0;
+    for (i = 0; i < 8; i++) token[i] = digest[19 - i];
+    return 8;
+}
+
+/* an AssemblyRef in the destination for the assembly of the source scope */
+static HRESULT xlate_assembly_scope(struct xlate *x, ULONG32 *scope)
+{
+    ULONG32 as;
+    const void *key = NULL;
+    ULONG cbkey = 0, len;
+    WCHAR name[512], loc[64];
+    ASSEMBLYMETADATA am;
+    DWORD flags;
+    BYTE token[8];
+    HRESULT hr;
+
+    if (FAILED(hr = IMetaDataAssemblyImport_GetAssemblyFromScope(x->ai, &as))) return hr;
+    memset(&am, 0, sizeof(am));
+    am.szLocale = loc;
+    am.cbLocale = ARRAY_SIZE(loc);
+    if (FAILED(hr = IMetaDataAssemblyImport_GetAssemblyProps(x->ai, as, &key, &cbkey, NULL, name, ARRAY_SIZE(name),
+                                                             &len, &am, &flags))) return hr;
+    if (cbkey)
+    {
+        if (!tail_token(key, cbkey, token)) return E_FAIL;
+        key = token;
+        cbkey = 8;
+    }
+    return IMetaDataAssemblyEmit_DefineAssemblyRef(x->ae, key, cbkey, name, &am, x->hash, x->cbhash,
+                                                    flags & ~afPublicKey, scope);
+}
+
+static HRESULT xlate_typedef(struct xlate *x, ULONG32 td, ULONG32 *out)
+{
+    IMetaDataImport2 *imp2;
+    WCHAR name[1024];
+    ULONG len;
+    DWORD flags;
+    ULONG32 ext, enclosing, scope = 0;
+    HRESULT hr;
+
+    if (FAILED(hr = IMetaDataImport_GetTypeDefProps(x->imp, td, name, ARRAY_SIZE(name), &len, &flags, &ext))) return hr;
+    if (SUCCEEDED(IMetaDataImport_QueryInterface(x->imp, &IID_IMetaDataImport2, (void **)&imp2)))
+    {
+        hr = IMetaDataImport2_GetNestedClassProps(imp2, td, &enclosing);
+        IMetaDataImport2_Release(imp2);
+        if (SUCCEEDED(hr))
+        {
+            /* a nested type is named inside its enclosing type's reference */
+            if (FAILED(hr = xlate_typedef(x, enclosing, &scope))) return hr;
+            return IMetaDataEmit_DefineTypeRefByName((IMetaDataEmit *)&x->dest->emit_iface, scope, name, out);
+        }
+    }
+    if (x->ai) { if (FAILED(hr = xlate_assembly_scope(x, &scope))) return hr; }
+    else
+    {
+        WCHAR mod[512];
+        ULONG mlen;
+
+        if (FAILED(hr = IMetaDataImport_GetScopeProps(x->imp, mod, ARRAY_SIZE(mod), &mlen, NULL))) return hr;
+        if (FAILED(hr = IMetaDataEmit_DefineModuleRef((IMetaDataEmit *)&x->dest->emit_iface, mod, &scope))) return hr;
+    }
+    return IMetaDataEmit_DefineTypeRefByName((IMetaDataEmit *)&x->dest->emit_iface, scope, name, out);
+}
+
+static HRESULT xlate_typeref(struct xlate *x, ULONG32 tr, ULONG32 *out)
+{
+    WCHAR name[1024];
+    ULONG len;
+    ULONG32 scope, dscope = 0;
+    HRESULT hr;
+
+    if (FAILED(hr = IMetaDataImport_GetTypeRefProps(x->imp, tr, &scope, name, ARRAY_SIZE(name), &len))) return hr;
+    switch (TK_T(scope))
+    {
+    case T_ASMREF:
+    {
+        const void *key, *hash;
+        ULONG cbkey, cbhash, l;
+        WCHAR an[512], loc[64];
+        ASSEMBLYMETADATA am;
+        DWORD flags;
+
+        if (!x->ai) return E_INVALIDARG;
+        memset(&am, 0, sizeof(am));
+        am.szLocale = loc;
+        am.cbLocale = ARRAY_SIZE(loc);
+        if (FAILED(hr = IMetaDataAssemblyImport_GetAssemblyRefProps(x->ai, scope, &key, &cbkey, an, ARRAY_SIZE(an), &l,
+                                                                    &am, &hash, &cbhash, &flags))) return hr;
+        if (FAILED(hr = IMetaDataAssemblyEmit_DefineAssemblyRef(x->ae, key, cbkey, an, &am, hash, cbhash, flags,
+                                                                 &dscope))) return hr;
+        break;
+    }
+    case T_MODULEREF:
+    {
+        WCHAR mod[512];
+        ULONG l;
+
+        if (FAILED(hr = IMetaDataImport_GetModuleRefProps(x->imp, scope, mod, ARRAY_SIZE(mod), &l))) return hr;
+        if (FAILED(hr = IMetaDataEmit_DefineModuleRef((IMetaDataEmit *)&x->dest->emit_iface, mod, &dscope))) return hr;
+        break;
+    }
+    case T_TYPEREF:
+        if (FAILED(hr = xlate_typeref(x, scope, &dscope))) return hr;
+        break;
+    default:
+        dscope = 0;
+        break;
+    }
+    return IMetaDataEmit_DefineTypeRefByName((IMetaDataEmit *)&x->dest->emit_iface, dscope, name, out);
+}
+
+/* signature rewriting: tokens of the source scope become tokens of the destination */
+
+struct sigbuf { BYTE *p; ULONG n, cap; BOOL fail; };
+struct sigr { const BYTE *p, *end; BOOL fail; };
+
+static void sb_put(struct sigbuf *b, const void *d, ULONG n)
+{
+    if (b->fail) return;
+    if (b->n + n > b->cap)
+    {
+        ULONG cap = (b->n + n) * 2 + 32;
+        BYTE *p = realloc(b->p, cap);
+
+        if (!p) { b->fail = TRUE; return; }
+        b->p = p;
+        b->cap = cap;
+    }
+    memcpy(b->p + b->n, d, n);
+    b->n += n;
+}
+
+static BYTE sr_peek(struct sigr *r) { return r->p < r->end ? *r->p : 0; }
+
+static BYTE sr_byte(struct sigr *r)
+{
+    if (r->p >= r->end) { r->fail = TRUE; return 0; }
+    return *r->p++;
+}
+
+static ULONG sr_comp(struct sigr *r)
+{
+    ULONG v, len;
+
+    if (!uncompress(r->p, r->end, &v, &len)) { r->fail = TRUE; return 0; }
+    r->p += len;
+    return v;
+}
+
+/* copy a compressed integer (also signed ones, whose encoding has the same length) unchanged */
+static void sr_copy_comp(struct sigr *r, struct sigbuf *o)
+{
+    ULONG v, len;
+
+    if (!uncompress(r->p, r->end, &v, &len)) { r->fail = TRUE; return; }
+    sb_put(o, r->p, len);
+    r->p += len;
+}
+
+static void sb_comp(struct sigbuf *o, ULONG v)
+{
+    BYTE b[4];
+
+    sb_put(o, b, put_compressed(b, v));
+}
+
+/* a TypeDefOrRef coded token */
+static HRESULT sig_token(struct xlate *x, struct sigr *r, struct sigbuf *o)
+{
+    ULONG v = sr_comp(r), rid = v >> 2;
+    static const BYTE tables[3] = { T_TYPEDEF, T_TYPEREF, T_TYPESPEC };
+    ULONG32 out;
+    HRESULT hr;
+
+    if (r->fail || (v & 3) == 3) return META_E_BAD_SIGNATURE;
+    if (FAILED(hr = xlate_token(x, MKTK(tables[v & 3], rid), &out))) return hr;
+    for (v = 0; v < 3 && tables[v] != TK_T(out); v++) ;
+    if (v == 3) return META_E_BAD_SIGNATURE;
+    sb_comp(o, (TK_R(out) << 2) | v);
+    return S_OK;
+}
+
+static HRESULT sig_type(struct xlate *x, struct sigr *r, struct sigbuf *o);
+static HRESULT sig_method(struct xlate *x, struct sigr *r, struct sigbuf *o, BYTE conv);
+
+static HRESULT sig_mods_and_type(struct xlate *x, struct sigr *r, struct sigbuf *o)
+{
+    HRESULT hr;
+
+    for (;;)
+    {
+        BYTE b = sr_peek(r);
+
+        if (b == ELEMENT_TYPE_CMOD_REQD || b == ELEMENT_TYPE_CMOD_OPT)
+        {
+            sb_put(o, &b, 1);
+            r->p++;
+            if (FAILED(hr = sig_token(x, r, o))) return hr;
+        }
+        else if (b == ELEMENT_TYPE_PINNED || b == ELEMENT_TYPE_SENTINEL)
+        {
+            sb_put(o, &b, 1);
+            r->p++;
+        }
+        else break;
+    }
+    return sig_type(x, r, o);
+}
+
+static HRESULT sig_type(struct xlate *x, struct sigr *r, struct sigbuf *o)
+{
+    BYTE b = sr_byte(r);
+    ULONG i, n;
+    HRESULT hr;
+
+    if (r->fail) return META_E_BAD_SIGNATURE;
+    sb_put(o, &b, 1);
+    switch (b)
+    {
+    case ELEMENT_TYPE_VOID: case ELEMENT_TYPE_BOOLEAN: case ELEMENT_TYPE_CHAR: case ELEMENT_TYPE_I1:
+    case ELEMENT_TYPE_U1: case ELEMENT_TYPE_I2: case ELEMENT_TYPE_U2: case ELEMENT_TYPE_I4: case ELEMENT_TYPE_U4:
+    case ELEMENT_TYPE_I8: case ELEMENT_TYPE_U8: case ELEMENT_TYPE_R4: case ELEMENT_TYPE_R8: case ELEMENT_TYPE_STRING:
+    case ELEMENT_TYPE_I: case ELEMENT_TYPE_U: case ELEMENT_TYPE_OBJECT: case ELEMENT_TYPE_TYPEDBYREF:
+        return S_OK;
+    case ELEMENT_TYPE_PTR: case ELEMENT_TYPE_BYREF: case ELEMENT_TYPE_SZARRAY:
+        return sig_mods_and_type(x, r, o);
+    case ELEMENT_TYPE_VALUETYPE: case ELEMENT_TYPE_CLASS:
+        return sig_token(x, r, o);
+    case ELEMENT_TYPE_VAR: case ELEMENT_TYPE_MVAR:
+        sr_copy_comp(r, o);
+        return r->fail ? META_E_BAD_SIGNATURE : S_OK;
+    case ELEMENT_TYPE_ARRAY:
+        if (FAILED(hr = sig_mods_and_type(x, r, o))) return hr;
+        sr_copy_comp(r, o);                         /* rank */
+        n = sr_comp(r); sb_comp(o, n);              /* sizes */
+        for (i = 0; i < n && !r->fail; i++) sr_copy_comp(r, o);
+        n = sr_comp(r); sb_comp(o, n);              /* lower bounds */
+        for (i = 0; i < n && !r->fail; i++) sr_copy_comp(r, o);
+        return r->fail ? META_E_BAD_SIGNATURE : S_OK;
+    case ELEMENT_TYPE_GENERICINST:
+        b = sr_byte(r);
+        sb_put(o, &b, 1);
+        if (b != ELEMENT_TYPE_CLASS && b != ELEMENT_TYPE_VALUETYPE) return META_E_BAD_SIGNATURE;
+        if (FAILED(hr = sig_token(x, r, o))) return hr;
+        n = sr_comp(r); sb_comp(o, n);
+        for (i = 0; i < n; i++) if (FAILED(hr = sig_mods_and_type(x, r, o))) return hr;
+        return r->fail ? META_E_BAD_SIGNATURE : S_OK;
+    case ELEMENT_TYPE_FNPTR:
+        b = sr_byte(r);
+        sb_put(o, &b, 1);
+        return sig_method(x, r, o, b);
+    case ELEMENT_TYPE_CMOD_REQD: case ELEMENT_TYPE_CMOD_OPT:
+        if (FAILED(hr = sig_token(x, r, o))) return hr;
+        return sig_type(x, r, o);
+    case ELEMENT_TYPE_PINNED: case ELEMENT_TYPE_SENTINEL:
+        return sig_type(x, r, o);
+    default:
+        return META_E_BAD_SIGNATURE;
+    }
+}
+
+/* after the calling convention byte */
+static HRESULT sig_method(struct xlate *x, struct sigr *r, struct sigbuf *o, BYTE conv)
+{
+    ULONG i, n;
+    HRESULT hr;
+
+    if (conv & 0x10) sr_copy_comp(r, o);       /* generic parameter count */
+    n = sr_comp(r);
+    sb_comp(o, n);
+    if (r->fail) return META_E_BAD_SIGNATURE;
+    for (i = 0; i < n + 1; i++)                /* the return type and the parameters */
+        if (FAILED(hr = sig_mods_and_type(x, r, o))) return hr;
+    return S_OK;
+}
+
+static HRESULT xlate_sig(struct xlate *x, const BYTE *sig, ULONG cb, struct sigbuf *o)
+{
+    struct sigr r = { sig, sig + cb, FALSE };
+    BYTE conv;
+    ULONG i, n;
+    HRESULT hr;
+
+    if (!cb) return META_E_BAD_SIGNATURE;
+    conv = sr_byte(&r);
+    sb_put(o, &conv, 1);
+    switch (conv & 0x0f)
+    {
+    case 0x06:      /* field */
+        hr = sig_mods_and_type(x, &r, o);
+        break;
+    case 0x07:      /* local variables */
+        n = sr_comp(&r);
+        sb_comp(o, n);
+        for (hr = S_OK, i = 0; i < n && SUCCEEDED(hr); i++) hr = sig_mods_and_type(x, &r, o);
+        break;
+    case 0x0a:      /* method instantiation */
+        n = sr_comp(&r);
+        sb_comp(o, n);
+        for (hr = S_OK, i = 0; i < n && SUCCEEDED(hr); i++) hr = sig_mods_and_type(x, &r, o);
+        break;
+    case 0x08:      /* property: parameter count, type, parameters */
+        n = sr_comp(&r);
+        sb_comp(o, n);
+        for (hr = S_OK, i = 0; i < n + 1 && SUCCEEDED(hr); i++) hr = sig_mods_and_type(x, &r, o);
+        break;
+    default:
+        hr = sig_method(x, &r, o, conv);
+        break;
+    }
+    if (SUCCEEDED(hr) && (r.fail || o->fail)) hr = r.fail ? META_E_BAD_SIGNATURE : E_OUTOFMEMORY;
+    return hr;
+}
+
+static HRESULT xlate_token(struct xlate *x, ULONG32 tk, ULONG32 *out)
+{
+    HRESULT hr;
+
+    switch (TK_T(tk))
+    {
+    case T_TYPEDEF: return xlate_typedef(x, tk, out);
+    case T_TYPEREF: return xlate_typeref(x, tk, out);
+    case T_TYPESPEC:
+    {
+        const BYTE *sig;
+        ULONG cb;
+
+        if (FAILED(hr = IMetaDataImport_GetTypeSpecFromToken(x->imp, tk, &sig, &cb))) return hr;
+        {
+            struct sigr r = { sig, sig + cb, FALSE };
+            struct sigbuf t = {0};
+
+            if (SUCCEEDED(hr = sig_mods_and_type(x, &r, &t)))
+                hr = IMetaDataEmit_GetTokenFromTypeSpec((IMetaDataEmit *)&x->dest->emit_iface, t.p, t.n, out);
+            free(t.p);
+        }
+        return hr;
+    }
+    default:
+        return E_INVALIDARG;
+    }
+}
+
+static HRESULT WINAPI emit_DefineImportType(IMetaDataEmit2 *iface, IMetaDataAssemblyImport *ai, const void *hash,
+                                            ULONG cbhash, IMetaDataImport *imp, ULONG32 td,
+                                            IMetaDataAssemblyEmit *ae, ULONG32 *ptr)
+{
+    struct xlate x = { impl_from_emit(iface), ai, hash, cbhash, imp, ae };
+    HRESULT hr;
+
+    TRACE("%p %p %p %lu %p %#x %p %p\n", iface, ai, hash, cbhash, imp, td, ae, ptr);
+    if (!imp || !ptr || (ai && !ae)) return E_INVALIDARG;
+    if (TK_T(td) != T_TYPEDEF) return E_INVALIDARG;
+    hr = xlate_typedef(&x, td, ptr);
+    return hr;
+}
+
+static HRESULT translate_sig(struct xlate *x, const BYTE *sig, ULONG cb, BYTE *out, ULONG max, ULONG *pcb)
+{
+    struct sigbuf o = {0};
+    HRESULT hr = xlate_sig(x, sig, cb, &o);
+
+    if (SUCCEEDED(hr))
+    {
+        if (pcb) *pcb = o.n;
+        if (o.n > max) hr = CLDB_E_TRUNCATION;
+        else if (out) memcpy(out, o.p, o.n);
+    }
+    free(o.p);
+    return hr;
+}
+
+static HRESULT WINAPI emit_TranslateSigWithScope(IMetaDataEmit2 *iface, IMetaDataAssemblyImport *ai, const void *hash,
+                                                 ULONG cbhash, IMetaDataImport *imp, const BYTE *sig, ULONG cb,
+                                                 IMetaDataAssemblyEmit *ae, IMetaDataEmit *emit, BYTE *out,
+                                                 ULONG max, ULONG *pcb)
+{
+    struct xlate x = { impl_from_emit(iface), ai, hash, cbhash, imp, ae };
+
+    TRACE("%p %p %p %lu %p %p %lu %p %p %p %lu %p\n", iface, ai, hash, cbhash, imp, sig, cb, ae, emit, out, max, pcb);
+    if (!imp || !sig || !out || (ai && !ae)) return E_INVALIDARG;
+    return translate_sig(&x, sig, cb, out, max, pcb);
+}
+
+static HRESULT WINAPI emit_DefineImportMember(IMetaDataEmit2 *iface, IMetaDataAssemblyImport *ai, const void *hash,
+                                              ULONG cbhash, IMetaDataImport *imp, ULONG32 member,
+                                              IMetaDataAssemblyEmit *ae, ULONG32 parent, ULONG32 *pmr)
+{
+    struct xlate x = { impl_from_emit(iface), ai, hash, cbhash, imp, ae };
+    WCHAR name[1024];
+    ULONG len, cbsig;
+    const BYTE *sig;
+    struct sigbuf o = {0};
+    ULONG32 cls;
+    DWORD attr, impl, ct;
+    HRESULT hr;
+
+    TRACE("%p %p %p %lu %p %#x %p %#x %p\n", iface, ai, hash, cbhash, imp, member, ae, parent, pmr);
+    if (!imp || !pmr || !parent || (ai && !ae)) return E_INVALIDARG;
+    if (FAILED(hr = IMetaDataImport_GetMemberProps(imp, member, &cls, name, ARRAY_SIZE(name), &len, &attr, &sig, &cbsig,
+                                                    NULL, &impl, &ct, NULL, NULL))) return hr;
+    if (FAILED(hr = xlate_sig(&x, sig, cbsig, &o))) { free(o.p); return hr; }
+    hr = IMetaDataEmit_DefineMemberRef((IMetaDataEmit *)iface, parent, name, o.p, o.n, pmr);
+    free(o.p);
+    return hr;
+}
+
+/* ---- security attribute sets ---- */
+
+/* the assembly-qualified name that a permission set blob stores for an attribute type */
+static BOOL secattr_type_name(struct md_model *md, ULONG32 ctor, char *buf, ULONG max)
+{
+    ULONG32 parent = 0;
+    ULONG ns = 0, nm = 0, asmrow = 0;
+    char name[512];
+    const char *sns, *snm;
+
+    if (TK_T(ctor) == T_MEMBERREF)
+    {
+        ULONG v = *mc(md, T_MEMBERREF, TK_R(ctor), 0);
+
+        parent = decode_coded(CI_MEMBERREFPARENT, v);
+    }
+    else if (TK_T(ctor) == T_METHOD)
+    {
+        ULONG owner = member_owner(md, T_TYPEDEF, 5, T_METHOD, TK_R(ctor));
+
+        parent = MKTK(T_TYPEDEF, owner ? owner : 1);
+    }
+    if (TK_T(parent) == T_TYPEREF)
+    {
+        ULONG scope = decode_coded(CI_RESSCOPE, *mc(md, T_TYPEREF, TK_R(parent), 0));
+
+        nm = *mc(md, T_TYPEREF, TK_R(parent), 1);
+        ns = *mc(md, T_TYPEREF, TK_R(parent), 2);
+        if (TK_T(scope) == T_ASMREF) asmrow = TK_R(scope);
+    }
+    else if (TK_T(parent) == T_TYPEDEF)
+    {
+        nm = *mc(md, T_TYPEDEF, TK_R(parent), 1);
+        ns = *mc(md, T_TYPEDEF, TK_R(parent), 2);
+    }
+    else return FALSE;
+    snm = (const char *)md->str.d + nm;
+    sns = (const char *)md->str.d + ns;
+    if (*sns) snprintf(name, sizeof(name), "%s.%s", sns, snm); else snprintf(name, sizeof(name), "%s", snm);
+    if (asmrow)
+    {
+        char tok[24] = "null";
+        ULONG k = *mc(md, T_ASMREF, asmrow, 5), kl;
+        const BYTE *kd;
+        const char *an = (const char *)md->str.d + *mc(md, T_ASMREF, asmrow, 6);
+        const char *cu = (const char *)md->str.d + *mc(md, T_ASMREF, asmrow, 7);
+
+        if (k && heap_entry(&md->blob, k, &kd, &kl) && kl == 8)
+            snprintf(tok, sizeof(tok), "%02x%02x%02x%02x%02x%02x%02x%02x", kd[0], kd[1], kd[2], kd[3], kd[4], kd[5], kd[6], kd[7]);
+        snprintf(buf, max, "%s, %s, Version=%lu.%lu.%lu.%lu, Culture=%s, PublicKeyToken=%s", name, an,
+                 *mc(md, T_ASMREF, asmrow, 0), *mc(md, T_ASMREF, asmrow, 1), *mc(md, T_ASMREF, asmrow, 2),
+                 *mc(md, T_ASMREF, asmrow, 3), *cu ? cu : "neutral", tok);
+    }
+    else snprintf(buf, max, "%s", name);
+    return TRUE;
+}
+
+static HRESULT WINAPI emit_DefineSecurityAttributeSet(IMetaDataEmit2 *iface, ULONG32 obj, COR_SECATTR *attrs, ULONG count,
+                                                      ULONG *perr)
+{
+    EMIT_ENTER;
+    ULONG i, a;
+    BOOL *used;
+
+    TRACE("%p %#x %p %lu %p\n", iface, obj, attrs, count, perr);
+    if (perr) *perr = 0;
+    if (!attrs || !count) return E_INVALIDARG;
+    if (TK_T(obj) != T_TYPEDEF && TK_T(obj) != T_METHOD && TK_T(obj) != T_ASSEMBLY) return E_INVALIDARG;
+    if (!tok_ok(md, obj)) return CLDB_E_INDEX_NOTFOUND;
+    NO_MEM(used = calloc(count, sizeof(*used)));
+
+    /* one permission set per security action, in the order the actions first appear */
+    for (i = 0; i < count; i++)
+    {
+        struct sigbuf set = {0};
+        ULONG nattrs = 0, action = 0;
+        BOOL first = TRUE;
+
+        if (used[i]) continue;
+        for (a = i; a < count; a++)
+        {
+            const BYTE *c = attrs[a].pCustomAttribute;
+            ULONG cb = attrs[a].cbCustomAttribute, act, nnamed, plen;
+            char name[1024];
+            struct sigr r;
+            struct sigbuf props = {0};
+
+            if (!c || cb < 8 || c[0] != 1 || c[1] != 0 || !secattr_type_name(md, attrs[a].tkCtor, name, sizeof(name)))
+            {
+                if (perr) *perr = a;
+                free(set.p); free(used);
+                return META_E_CA_INVALID_BLOB;
+            }
+            act = rd32(c + 2);
+            if (first) { action = act; first = FALSE; }
+            if (act != action) continue;
+            used[a] = TRUE;
+            if (!nattrs) sb_put(&set, ".", 1);       /* the binary format marker, then the count */
+            nattrs++;
+            nnamed = rd16(c + 6);
+            r.p = c + 8; r.end = c + cb; r.fail = FALSE;
+            sb_comp(&props, nnamed);
+            sb_put(&props, r.p, r.end - r.p);
+            plen = props.n;
+            sb_comp(&set, strlen(name));
+            sb_put(&set, name, strlen(name));
+            sb_comp(&set, plen);
+            sb_put(&set, props.p, props.n);
+            free(props.p);
+        }
+        {
+            /* the count follows the marker: rebuild the blob as marker, count, attributes */
+            struct sigbuf blob = {0};
+            ULONG32 pm;
+
+            sb_put(&blob, ".", 1);
+            sb_comp(&blob, nattrs);
+            sb_put(&blob, set.p + 1, set.n - 1);
+            hr = define_permission_set(m, obj, action, blob.p, blob.n, FALSE, &pm);
+            free(blob.p);
+        }
+        free(set.p);
+        if (FAILED(hr)) { if (perr) *perr = i; free(used); return hr; }
+    }
+    free(used);
+    return S_OK;
+}
