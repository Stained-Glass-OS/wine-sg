+/* ---- IMetaDataAssemblyEmit ---- */
+
+static void put_version(struct md_model *md, unsigned int t, ULONG row, unsigned int col, const ASSEMBLYMETADATA *am)
+{
+    unsigned int i;
+
+    for (i = 0; i < 4; i++) *mc(md, t, row, col + i) = 0;
+    if (!am) return;
+    *mc(md, t, row, col) = am->usMajorVersion;
+    *mc(md, t, row, col + 1) = am->usMinorVersion;
+    *mc(md, t, row, col + 2) = am->usBuildNumber;
+    *mc(md, t, row, col + 3) = am->usRevisionNumber;
+}
+
+static ULONG culture_of(struct md_model *md, const ASSEMBLYMETADATA *am, BOOL *ok)
+{
+    return am && am->szLocale && *am->szLocale ? str_w(md, am->szLocale, ok) : 0;
+}
+
+static HRESULT set_assembly(struct md_scope *m, ULONG row, const void *key, ULONG cbkey, ULONG alg, const WCHAR *name,
+                            const ASSEMBLYMETADATA *am, DWORD flags)
+{
+    struct md_model *md = m->model;
+    BOOL ok = TRUE;
+
+    *mc(md, T_ASSEMBLY, row, 0) = alg;
+    put_version(md, T_ASSEMBLY, row, 1, am);
+    *mc(md, T_ASSEMBLY, row, 5) = flags;
+    *mc(md, T_ASSEMBLY, row, 6) = blob_of(md, key, cbkey, &ok);
+    *mc(md, T_ASSEMBLY, row, 7) = str_w(md, name, &ok);
+    *mc(md, T_ASSEMBLY, row, 8) = culture_of(md, am, &ok);
+    m->dirty = TRUE;
+    return ok ? S_OK : E_OUTOFMEMORY;
+}
