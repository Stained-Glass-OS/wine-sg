+/* the default value of a field, parameter or property */
+static HRESULT set_constant(struct md_scope *m, ULONG32 parent, DWORD type, const void *value, ULONG cch)
+{
+    struct md_model *md = m->model;
+    BOOL ok = TRUE;
+    ULONG pv = encode_coded(CI_HASCONSTANT, parent), size = 0, r, bl;
+
+    if (type == ELEMENT_TYPE_END) return S_OK;
+    if (pv == ~0u) return E_INVALIDARG;
+    switch (type)
+    {
+    case ELEMENT_TYPE_BOOLEAN: case ELEMENT_TYPE_I1: case ELEMENT_TYPE_U1: size = 1; break;
+    case ELEMENT_TYPE_CHAR: case ELEMENT_TYPE_I2: case ELEMENT_TYPE_U2: size = 2; break;
+    case ELEMENT_TYPE_I4: case ELEMENT_TYPE_U4: case ELEMENT_TYPE_R4: size = 4; break;
+    case ELEMENT_TYPE_I8: case ELEMENT_TYPE_U8: case ELEMENT_TYPE_R8: size = 8; break;
+    case ELEMENT_TYPE_STRING:
+        if (!value) return E_INVALIDARG;
+#ifndef SG_MUTANT_EMIT_CONST
+        size = (cch == UNCHANGED ? wcslen(value) : cch) * sizeof(WCHAR);
+#else
+        size = wcslen(value) * sizeof(WCHAR) - 2;
+#endif
+        break;
+    case ELEMENT_TYPE_CLASS: break;      /* a null reference */
+    default: return E_INVALIDARG;
+    }
+    if (size && !value) return E_INVALIDARG;
+    {
+        static const BYTE null_ref[4];
+
+        bl = blob_of(md, type == ELEMENT_TYPE_CLASS ? null_ref : value, type == ELEMENT_TYPE_CLASS ? 4 : size, &ok);
+        NO_MEM(ok);
+    }
+    for (r = 1; r <= MROWS(md, T_CONSTANT); r++)
+        if (*mc(md, T_CONSTANT, r, 2) == pv) break;
+    if (r > MROWS(md, T_CONSTANT)) NO_MEM(r = sorted_add(md, T_CONSTANT, 2, pv));
+    *mc(md, T_CONSTANT, r, 0) = type;
+    *mc(md, T_CONSTANT, r, 3) = bl;
+    m->dirty = TRUE;
+    return S_OK;
+}
