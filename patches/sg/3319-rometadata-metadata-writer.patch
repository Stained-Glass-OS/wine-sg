+
+    TRACE("%p %#x %lu\n", iface, fd, rva);
+    if (TK_T(fd) != T_FIELD) return E_INVALIDARG;
+    if (!tok_ok(md, fd)) return CLDB_E_INDEX_NOTFOUND;
