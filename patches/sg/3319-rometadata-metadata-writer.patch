+static HRESULT WINAPI emit_SetClassLayout(IMetaDataEmit2 *iface, ULONG32 td, DWORD pack, COR_FIELD_OFFSET *offsets,
+                                          ULONG size)
+{
+    EMIT_ENTER;
+    ULONG owner, row;
+
+    TRACE("%p %#x %lu %p %lu\n", iface, td, pack, offsets, size);
+    if (TK_T(td) != T_TYPEDEF) return E_INVALIDARG;
+    if (FAILED(hr = owner_rid(md, td, &owner))) return hr;
+    for (row = 1; row <= MROWS(md, T_CLASSLAYOUT); row++)
+        if (*mc(md, T_CLASSLAYOUT, row, 2) == owner) break;
+    if (row > MROWS(md, T_CLASSLAYOUT)) NO_MEM(row = sorted_add(md, T_CLASSLAYOUT, 2, owner));
+    *mc(md, T_CLASSLAYOUT, row, 0) = pack;
+    *mc(md, T_CLASSLAYOUT, row, 1) = size;
+    m->dirty = TRUE;
+    for (; offsets && offsets->ridOfField; offsets++)
+    {
+        ULONG f = field_rid(offsets->ridOfField), r;
+
+        if (f > MROWS(md, T_FIELD) || member_owner(md, T_TYPEDEF, 4, T_FIELD, f) != owner) return E_INVALIDARG;
+        for (r = 1; r <= MROWS(md, T_FIELDLAYOUT); r++)
+            if (*mc(md, T_FIELDLAYOUT, r, 1) == f) break;
+        if (r > MROWS(md, T_FIELDLAYOUT)) NO_MEM(r = sorted_add(md, T_FIELDLAYOUT, 1, f));
+        *mc(md, T_FIELDLAYOUT, r, 0) = offsets->ulOffset;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI emit_DeleteClassLayout(IMetaDataEmit2 *iface, ULONG32 td)
+{
+    EMIT_ENTER;
+    ULONG owner, r;
+    BOOL found = FALSE;
+
+    TRACE("%p %#x\n", iface, td);
+    if (TK_T(td) != T_TYPEDEF) return E_INVALIDARG;
+    if (FAILED(hr = owner_rid(md, td, &owner))) return hr;
+    for (r = MROWS(md, T_CLASSLAYOUT); r >= 1; r--)
+        if (*mc(md, T_CLASSLAYOUT, r, 2) == owner) { row_remove(md, T_CLASSLAYOUT, r); found = TRUE; }
+    for (r = MROWS(md, T_FIELDLAYOUT); r >= 1; r--)
+        if (member_owner(md, T_TYPEDEF, 4, T_FIELD, *mc(md, T_FIELDLAYOUT, r, 1)) == owner)
+        {
+            row_remove(md, T_FIELDLAYOUT, r);
+            found = TRUE;
+        }
+    m->dirty = TRUE;
+    return found ? S_OK : CLDB_E_RECORD_NOTFOUND;
+}
+
+static void set_flag(struct md_model *md, ULONG32 tk, DWORD flag, BOOL on)
+{
+    ULONG *f;
+
+    switch (TK_T(tk))
+    {
+    case T_TYPEDEF: f = mc(md, T_TYPEDEF, TK_R(tk), 0); break;
+    case T_FIELD: f = mc(md, T_FIELD, TK_R(tk), 0); break;
+    case T_METHOD: f = mc(md, T_METHOD, TK_R(tk), 2); break;
+    case T_PARAM: f = mc(md, T_PARAM, TK_R(tk), 0); break;
+    default: return;
+    }
+    if (on) *f |= flag; else *f &= ~flag;
+}
