+static HRESULT WINAPI emit_SetFieldMarshal(IMetaDataEmit2 *iface, ULONG32 tk, const BYTE *native, ULONG cb)
+{
+    EMIT_ENTER;
+    ULONG pv, r, bl;
+
+    TRACE("%p %#x %p %lu\n", iface, tk, native, cb);
+    if ((TK_T(tk) != T_FIELD && TK_T(tk) != T_PARAM) || !native || !cb) return E_INVALIDARG;
+    if (FAILED(hr = coded_of(md, CI_HASFIELDMARSHAL, tk, &pv))) return hr;
+    bl = blob_of(md, native, cb, &ok);
+    NO_MEM(ok);
+    for (r = 1; r <= MROWS(md, T_FMARSHAL); r++)
+        if (*mc(md, T_FMARSHAL, r, 0) == pv) break;
+    if (r > MROWS(md, T_FMARSHAL)) NO_MEM(r = sorted_add(md, T_FMARSHAL, 0, pv));
+    *mc(md, T_FMARSHAL, r, 1) = bl;
+    set_flag(md, tk, TK_T(tk) == T_FIELD ? fdHasFieldMarshal : pdHasFieldMarshal, TRUE);
+    m->dirty = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI emit_DeleteFieldMarshal(IMetaDataEmit2 *iface, ULONG32 tk)
+{
+    EMIT_ENTER;
+    ULONG pv, r;
+
+    TRACE("%p %#x\n", iface, tk);
+    if (TK_T(tk) != T_FIELD && TK_T(tk) != T_PARAM) return E_INVALIDARG;
+    if (FAILED(hr = coded_of(md, CI_HASFIELDMARSHAL, tk, &pv))) return hr;
+    for (r = 1; r <= MROWS(md, T_FMARSHAL); r++)
+        if (*mc(md, T_FMARSHAL, r, 0) == pv)
+        {
+            row_remove(md, T_FMARSHAL, r);
+            set_flag(md, tk, TK_T(tk) == T_FIELD ? fdHasFieldMarshal : pdHasFieldMarshal, FALSE);
+            m->dirty = TRUE;
+            return S_OK;
+        }
+    return CLDB_E_RECORD_NOTFOUND;
+}
