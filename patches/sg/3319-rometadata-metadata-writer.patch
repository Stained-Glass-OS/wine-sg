+static HRESULT WINAPI emit_DefineProperty(IMetaDataEmit2 *iface, ULONG32 td, const WCHAR *name, DWORD flags,
+                                          const BYTE *sig, ULONG cbsig, DWORD ctype, const void *value, ULONG cch,
+                                          ULONG32 setter, ULONG32 getter, ULONG32 *others, ULONG32 *pprop)
+{
+    EMIT_ENTER;
+    ULONG owner, map, rid, nm, sg;
+
+    TRACE("%p %#x %s %#lx %p %lu %#lx %p %lu %#x %#x %p %p\n", iface, td, debugstr_w(name), flags, sig, cbsig, ctype,
+          value, cch, setter, getter, others, pprop);
+    if (!name || !pprop || !td) return E_INVALIDARG;
+    if (FAILED(hr = owner_rid(md, td, &owner))) return hr;
+    nm = str_w(md, name, &ok);
+    sg = blob_of(md, sig, cbsig, &ok);
+    NO_MEM(ok);
+    NO_MEM(map = map_row(md, T_PROPMAP, T_PROPERTY, owner));
+    NO_MEM(rid = member_add(md, T_PROPMAP, map, 1, T_PROPERTY));
+    if (ctype != ELEMENT_TYPE_END) flags |= prHasDefault;
+    *mc(md, T_PROPERTY, rid, 0) = flags;
+    *mc(md, T_PROPERTY, rid, 1) = nm;
+    *mc(md, T_PROPERTY, rid, 2) = sg;
+    m->dirty = TRUE;
+    *pprop = MKTK(T_PROPERTY, rid);
+    if (FAILED(hr = set_constant(m, *pprop, ctype, value, cch))) return hr;
+    if (FAILED(hr = sem_set(md, *pprop, MS_SETTER, setter))) return hr;
+    if (FAILED(hr = sem_set(md, *pprop, MS_GETTER, getter))) return hr;
+    return sem_others(md, *pprop, others);
+}
