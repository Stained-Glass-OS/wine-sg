+static void test_emit(void)
+{
+    static const BYTE sig[] = { 0x20, 1, 1, 8 };
+    IMetaDataDispenserEx *dispenser;
+    IMetaDataEmit2 *emit;
+    IMetaDataAssemblyEmit *asm_emit;
+    IMetaDataImport2 *import;
+    IMetaDataImport *reopened;
+    mdTypeDef td, td2, found;
+    mdMethodDef method, method2, methods[4];
+    mdTypeRef object;
+    mdAssemblyRef asm_ref;
+    ASSEMBLYMETADATA am = { 4, 0, 0, 0 };
+    HCORENUM enum_handle = NULL;
+    ULONG count, len;
+    WCHAR name[64];
+    DWORD size, flags;
+    mdToken ext;
+    BYTE *data;
+    HRESULT hr;
+
+    hr = MetaDataGetDispenser(&CLSID_CorMetaDataDispenser, &IID_IMetaDataDispenserEx, (void **)&dispenser);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IMetaDataDispenserEx_DefineScope(dispenser, &CLSID_CorMetaDataDispenser, 0, &IID_IMetaDataEmit2, (IUnknown **)&emit);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IMetaDataEmit2_QueryInterface(emit, &IID_IMetaDataAssemblyEmit, (void **)&asm_emit);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IMetaDataEmit2_QueryInterface(emit, &IID_IMetaDataImport2, (void **)&import);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    hr = IMetaDataEmit2_SetModuleProps(emit, L"emitted.dll");
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IMetaDataAssemblyEmit_DefineAssemblyRef(asm_emit, NULL, 0, L"mscorlib", &am, NULL, 0, 0, &asm_ref);
+    ok(hr == S_OK && asm_ref == 0x23000001, "Got unexpected hr %#lx, token %#x.\n", hr, asm_ref);
+    hr = IMetaDataEmit2_DefineTypeRefByName(emit, asm_ref, L"System.Object", &object);
+    ok(hr == S_OK && object == 0x01000001, "Got unexpected hr %#lx, token %#x.\n", hr, object);
+
+    hr = IMetaDataEmit2_DefineTypeDef(emit, L"Ns.One", 1, object, NULL, &td);
+    ok(hr == S_OK && td == 0x02000002, "Got unexpected hr %#lx, token %#x.\n", hr, td);
+    hr = IMetaDataEmit2_DefineTypeDef(emit, L"Ns.One", 1, object, NULL, &td2);
+    ok(hr == CLDB_E_RECORD_DUPLICATE, "Got unexpected hr %#lx.\n", hr);
+    hr = IMetaDataEmit2_DefineTypeDef(emit, L"Ns.Two", 1, object, NULL, &td2);
+    ok(hr == S_OK && td2 == 0x02000003, "Got unexpected hr %#lx, token %#x.\n", hr, td2);
+
+    /* members of an earlier type defined after those of a later one keep their tokens */
+    hr = IMetaDataEmit2_DefineMethod(emit, td, L"A", 6, sig, sizeof(sig), 0, 0, &method);
+    ok(hr == S_OK && method == 0x06000001, "Got unexpected hr %#lx, token %#x.\n", hr, method);
+    hr = IMetaDataEmit2_DefineMethod(emit, td2, L"B", 6, sig, sizeof(sig), 0, 0, &method2);
+    ok(hr == S_OK && method2 == 0x06000002, "Got unexpected hr %#lx, token %#x.\n", hr, method2);
+    hr = IMetaDataEmit2_DefineMethod(emit, td, L"C", 6, sig, sizeof(sig), 0, 0, &methods[0]);
+    ok(hr == S_OK && methods[0] == 0x06000003, "Got unexpected hr %#lx, token %#x.\n", hr, methods[0]);
+
+    hr = IMetaDataImport2_EnumMethods(import, &enum_handle, td, methods, ARRAY_SIZE(methods), &count);
+    ok(hr == S_OK && count == 2 && methods[0] == method && methods[1] == 0x06000003, "Got unexpected hr %#lx, count %lu.\n", hr, count);
+    IMetaDataImport2_CloseEnum(import, enum_handle);
+    enum_handle = NULL;
+    hr = IMetaDataImport2_EnumMethods(import, &enum_handle, td2, methods, ARRAY_SIZE(methods), &count);
+    ok(hr == S_OK && count == 1 && methods[0] == method2, "Got unexpected hr %#lx, count %lu.\n", hr, count);
+    IMetaDataImport2_CloseEnum(import, enum_handle);
+
+    /* Save renumbers: the methods of each type become adjacent */
+    hr = IMetaDataEmit2_GetSaveSize(emit, 0, &size);
+    ok(hr == S_OK && size > 100, "Got unexpected hr %#lx, size %lu.\n", hr, size);
+    data = malloc(size);
+    hr = IMetaDataEmit2_SaveToMemory(emit, data, size);
+    ok(hr == S_OK && !memcmp(data, "BSJB", 4), "Got unexpected hr %#lx.\n", hr);
+    hr = IMetaDataDispenserEx_OpenScopeOnMemory(dispenser, data, size, 0, &IID_IMetaDataImport, (IUnknown **)&reopened);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IMetaDataImport_FindTypeDefByName(reopened, L"Ns.Two", 0, &found);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IMetaDataImport_GetTypeDefProps(reopened, found, name, ARRAY_SIZE(name), &len, &flags, &ext);
+    ok(hr == S_OK && !wcscmp(name, L"Ns.Two") && flags == 1, "Got unexpected hr %#lx, %s.\n", hr, wine_dbgstr_w(name));
+    enum_handle = NULL;
+    hr = IMetaDataImport_EnumMethods(reopened, &enum_handle, found, methods, ARRAY_SIZE(methods), &count);
+    ok(hr == S_OK && count == 1, "Got unexpected hr %#lx, count %lu.\n", hr, count);
+    hr = IMetaDataImport_GetMethodProps(reopened, methods[0], NULL, name, ARRAY_SIZE(name), &len, NULL, NULL, NULL, NULL, NULL);
+    ok(hr == S_OK && !wcscmp(name, L"B"), "Got unexpected hr %#lx, %s.\n", hr, wine_dbgstr_w(name));
+    IMetaDataImport_CloseEnum(reopened, enum_handle);
+    IMetaDataImport_Release(reopened);
+
+    /* a scope read for reading has no emit interface */
+    hr = IMetaDataDispenserEx_OpenScopeOnMemory(dispenser, data, size, 0, &IID_IMetaDataImport, (IUnknown **)&reopened);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    {
+        void *unk = (void *)1;
+
+        hr = IMetaDataImport_QueryInterface(reopened, &IID_IMetaDataEmit, &unk);
+        ok(FAILED(hr) && !unk, "Got unexpected hr %#lx.\n", hr);
+    }
+    IMetaDataImport_Release(reopened);
+    free(data);
+
+    IMetaDataImport2_Release(import);
+    IMetaDataAssemblyEmit_Release(asm_emit);
+    IMetaDataEmit2_Release(emit);
+    IMetaDataDispenserEx_Release(dispenser);
+}
