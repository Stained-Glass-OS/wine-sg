+static HRESULT WINAPI emit_DefineEvent(IMetaDataEmit2 *iface, ULONG32 td, const WCHAR *name, DWORD flags,
+                                       ULONG32 type, ULONG32 add, ULONG32 remove, ULONG32 fire, ULONG32 *others,
+                                       ULONG32 *pev)
+{
+    EMIT_ENTER;
+    ULONG owner, map, rid, nm, tv;
+
+    TRACE("%p %#x %s %#lx %#x %#x %#x %#x %p %p\n", iface, td, debugstr_w(name), flags, type, add, remove, fire, others, pev);
+    if (!name || !pev || !td) return E_INVALIDARG;
+    if (FAILED(hr = owner_rid(md, td, &owner))) return hr;
+    if (FAILED(hr = coded_of(md, CI_TYPEDEFORREF, type, &tv))) return hr;
+    nm = str_w(md, name, &ok);
+    NO_MEM(ok);
+    NO_MEM(map = map_row(md, T_EVENTMAP, T_EVENT, owner));
+    NO_MEM(rid = member_add(md, T_EVENTMAP, map, 1, T_EVENT));
+    *mc(md, T_EVENT, rid, 0) = flags;
+    *mc(md, T_EVENT, rid, 1) = nm;
+    *mc(md, T_EVENT, rid, 2) = tv;
+    m->dirty = TRUE;
+    *pev = MKTK(T_EVENT, rid);
+    if (FAILED(hr = sem_set(md, *pev, MS_ADDON, add))) return hr;
+    if (FAILED(hr = sem_set(md, *pev, MS_REMOVE, remove))) return hr;
+    if (FAILED(hr = sem_set(md, *pev, MS_FIRE, fire))) return hr;
+    return sem_others(md, *pev, others);
+}
+
+static HRESULT WINAPI emit_SetEventProps(IMetaDataEmit2 *iface, ULONG32 ev, DWORD flags, ULONG32 type, ULONG32 add,
+                                         ULONG32 remove, ULONG32 fire, ULONG32 *others)
+{
+    EMIT_ENTER;
+    ULONG tv;
+
+    TRACE("%p %#x %#lx %#x %#x %#x %#x %p\n", iface, ev, flags, type, add, remove, fire, others);
+    if (TK_T(ev) != T_EVENT) return E_INVALIDARG;
+    if (!tok_ok(md, ev)) return CLDB_E_INDEX_NOTFOUND;
+    if (flags != UNCHANGED) *mc(md, T_EVENT, TK_R(ev), 0) = flags;
+    if (type != UNCHANGED)
+    {
+        if (FAILED(hr = coded_of(md, CI_TYPEDEFORREF, type, &tv))) return hr;
+        *mc(md, T_EVENT, TK_R(ev), 2) = tv;
+    }
+    m->dirty = TRUE;
+    if (FAILED(hr = sem_set(md, ev, MS_ADDON, add))) return hr;
+    if (FAILED(hr = sem_set(md, ev, MS_REMOVE, remove))) return hr;
+    if (FAILED(hr = sem_set(md, ev, MS_FIRE, fire))) return hr;
+    return sem_others(md, ev, others);
+}
