+/* StandAloneSig, TypeSpec and ModuleRef rows are found before they are created */
+static HRESULT find_or_add_blob_row(struct md_scope *m, unsigned int t, const BYTE *sig, ULONG cb, ULONG32 *tok)
+{
+    struct md_model *md = m->model;
+    BOOL ok = TRUE;
+    ULONG sg, r;
+
+    if (!sig || !cb || !tok) return E_INVALIDARG;
+    sg = blob_of(md, sig, cb, &ok);
+    NO_MEM(ok);
+    for (r = 1; r <= MROWS(md, t); r++)
+        if (*mc(md, t, r, 0) == sg) { *tok = MKTK(t, r); return S_OK; }
+    NO_MEM(r = row_add(md, t));
+    *mc(md, t, r, 0) = sg;
+    m->dirty = TRUE;
+    *tok = MKTK(t, r);
+    return S_OK;
+}
