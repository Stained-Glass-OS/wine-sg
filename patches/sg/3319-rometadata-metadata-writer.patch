+    m->dirty = TRUE;
+    if (FAILED(hr = sem_set(md, pr, MS_SETTER, setter))) return hr;
+    if (FAILED(hr = sem_set(md, pr, MS_GETTER, getter))) return hr;
+    return sem_others(md, pr, others);
+}
