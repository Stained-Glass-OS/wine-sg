From: Stained Glass OS contributors
Subject: explorer: File Explorer's arrows and chevrons drawn clean

The back, forward and up arrows and the breadcrumb chevrons were separate
round-capped lines meeting at the tip; where they overlapped the
anti-aliasing left knobs, and beside Control Panel's they looked
hand-drawn. An arrowhead or a chevron is now one stroke with a mitred
corner, the shaft stops short of the tip, and the ends are square.

Gate: test/explorer2-gate.sh (make test-explorer2); checked by eye at 4x.
---
--- a/programs/explorer/fileexplorer.c
+++ b/programs/explorer/fileexplorer.c
@@ -349,35 +349,48 @@
 #define R(x1, y1, w, h) GdipDrawRectangle(g, pen, X(x1), Y(y1), (w) * s, (h) * s)
 #define E(x1, y1, w, h) GdipDrawEllipse(g, pen, X(x1), Y(y1), (w) * s, (h) * s)
 #define FE(x1, y1, w, h) GdipFillEllipse(g, (GpBrush *)brush, X(x1), Y(y1), (w) * s, (h) * s)
+/* Stained Glass OS: a corner as one stroke (an arrowhead, a chevron): drawn as
+ * separate lines with round caps, the joins showed knobs -- the arrows looked
+ * hand-drawn beside Control Panel's */
+#define V(x1, y1, x2, y2, x3, y3) do { GpPointF v_[3] = { { X(x1), Y(y1) }, { X(x2), Y(y2) }, { X(x3), Y(y3) } }; \
+                                       GdipDrawLines(g, pen, v_, 3); } while (0)
 
     if (glyph == G_NONE || GdipCreateFromHDC(dc, &g) != Ok) return;
     GdipSetSmoothingMode(g, SmoothingModeAntiAlias);
     GdipSetPixelOffsetMode(g, PixelOffsetModeHalf);
-    GdipCreatePen1(argb, max(1.0f, 1.15f * s), UnitPixel, &pen);
-    GdipSetPenLineJoin(pen, LineJoinRound);
+    GdipCreatePen1(argb, max(1.25f, 1.25f * s), UnitPixel, &pen);
+    GdipSetPenLineJoin(pen, LineJoinMiter);
     GdipSetPenStartCap(pen, LineCapRound);
     GdipSetPenEndCap(pen, LineCapRound);
     GdipCreateSolidFill(argb, &brush);
 
+    /* arrows and chevrons: square ends, so the head's corner and the shaft
+     * meet cleanly */
+    if (glyph == G_BACK || glyph == G_FORWARD || glyph == G_UP || glyph == G_CHEVRON_RIGHT ||
+        glyph == G_CHEVRON_DOWN || glyph == G_CHEVRON_LEFT2)
+    {
+        GdipSetPenStartCap(pen, LineCapFlat);
+        GdipSetPenEndCap(pen, LineCapFlat);
+    }
     switch (glyph)
     {
     case G_BACK:
-        L(13, 8, 3, 8); L(7.5, 3.5, 3, 8); L(3, 8, 7.5, 12.5); break;
+        L(13.5, 8, 4, 8); V(8, 3.5, 3.5, 8, 8, 12.5); break;
     case G_FORWARD:
-        L(3, 8, 13, 8); L(8.5, 3.5, 13, 8); L(13, 8, 8.5, 12.5); break;
+        L(2.5, 8, 12, 8); V(8, 3.5, 12.5, 8, 8, 12.5); break;
     case G_UP:
-        L(8, 13.5, 8, 2.5); L(3.5, 7, 8, 2.5); L(8, 2.5, 12.5, 7); break;
+        L(8, 13.5, 8, 4); V(3.5, 8, 8, 3.5, 12.5, 8); break;
     case G_REFRESH:
         GdipDrawArc(g, pen, X(2.5), Y(2.5), 11 * s, 11 * s, -60, 300);
         L(13.2, 1.8, 13.3, 5.4); L(13.3, 5.4, 9.8, 5.3); break;
     case G_SEARCH:
         E(2, 2, 8.5, 8.5); L(9.5, 9.5, 14, 14); break;
     case G_CHEVRON_RIGHT:
-        L(6, 3.5, 10.5, 8); L(10.5, 8, 6, 12.5); break;
+        V(6, 3.5, 10.5, 8, 6, 12.5); break;
     case G_CHEVRON_DOWN:
-        L(3.5, 6, 8, 10.5); L(8, 10.5, 12.5, 6); break;
+        V(3.5, 6, 8, 10.5, 12.5, 6); break;
     case G_CHEVRON_LEFT2:
-        L(8, 4, 4, 8); L(4, 8, 8, 12); L(12, 4, 8, 8); L(8, 8, 12, 12); break;
+        V(8, 4, 4, 8, 8, 12); V(12, 4, 8, 8, 12, 12); break;
     case G_NEW:
     case G_NEWFOLDER:
     {
@@ -445,6 +458,7 @@
 #undef R
 #undef E
 #undef FE
+#undef V
     GdipDeleteBrush((GpBrush *)brush);
     GdipDeletePen(pen);
     GdipDeleteGraphics(g);
