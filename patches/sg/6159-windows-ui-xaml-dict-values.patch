From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: Color and other value entries of resource dictionaries

A compiled dictionary's literal value entries other than numbers and booleans were kept as text, so a brush whose Color is {StaticResource} to a <Color x:Key> entry was left transparent -- the Fluent (SunValley) styles' TextFillColor brushes, which NanaZip's address bar chevron uses. A compiled Color, Thickness, CornerRadius or FontFamily entry is now its value. Markup text gains value elements too: <Color>, <Thickness>, <CornerRadius>, <x:Double>, <x:Single>, <x:Int32>, <x:Boolean> and <x:String> with their text as the value (they were skipped). Behind the XAML switch of 6131.
---
diff --git a/dlls/windows.ui.xaml/markup.c b/dlls/windows.ui.xaml/markup.c
index 717ebee..b6c4905 100644
--- a/dlls/windows.ui.xaml/markup.c
+++ b/dlls/windows.ui.xaml/markup.c
@@ -1240,9 +1240,67 @@ static HRESULT skip_element( struct text_state *state )
 }
 
 /* the reader is on an element's start: its object, made (or existing: a component's root) */
+/* a value element -- <Color x:Key="...">#AARRGGBB</Color>, <x:Double>12</x:Double> -- its value from its text */
+static const WCHAR *value_element_type( const WCHAR *ns, const WCHAR *name )
+{
+    static const struct { BOOL xaml; const WCHAR *name, *type; } elements[] =
+    {
+        { FALSE, L"Color", L"Windows.UI.Color" },
+        { FALSE, L"Thickness", L"Windows.UI.Xaml.Thickness" },
+        { FALSE, L"CornerRadius", L"Windows.UI.Xaml.CornerRadius" },
+        { TRUE, L"Double", L"Double" },
+        { TRUE, L"Single", L"Single" },
+        { TRUE, L"Int32", L"Int32" },
+        { TRUE, L"Boolean", L"Boolean" },
+        { TRUE, L"String", L"String" },
+    };
+    unsigned int i;
+
+#ifdef SG_MUTANT_XBF_COLOR_AS_STRING
+    return NULL;
+#endif
+    for (i = 0; i < ARRAY_SIZE(elements); i++)
+        if (!wcscmp( name, elements[i].name ) && !wcscmp( ns, elements[i].xaml ? ns_xaml : ns_presentation ))
+            return find_type( name ) ? NULL : elements[i].type;
+    return NULL;
+}
+
+static HRESULT read_value_element( struct text_state *state, const WCHAR *type, IInspectable **out, WCHAR **key )
+{
+    struct text_buffer b = { malloc( 64 * sizeof(WCHAR) ), 0, 64 };
+    const WCHAR *local, *ns, *value;
+    XmlNodeType node;
+    HRESULT hr;
+    BOOL empty = IXmlReader_IsEmptyElement( state->reader );
+
+    if (!b.data) return E_OUTOFMEMORY;
+    b.data[0] = 0;
+    for (hr = IXmlReader_MoveToFirstAttribute( state->reader ); hr == S_OK; hr = IXmlReader_MoveToNextAttribute( state->reader ))
+    {
+        IXmlReader_GetLocalName( state->reader, &local, NULL );
+        IXmlReader_GetNamespaceUri( state->reader, &ns, NULL );
+        IXmlReader_GetValue( state->reader, &value, NULL );
+        if (!wcscmp( ns, ns_xaml ) && !wcscmp( local, L"Key" ) && key && !*key) *key = wcsdup( value );
+    }
+    IXmlReader_MoveToElement( state->reader );
+    while (!empty && (hr = IXmlReader_Read( state->reader, &node )) == S_OK && node != XmlNodeType_EndElement)
+    {
+        if (node == XmlNodeType_Text || node == XmlNodeType_CDATA)
+        {
+            IXmlReader_GetValue( state->reader, &value, NULL );
+            tb_add( &b, value, FALSE );
+        }
+    }
+    if (!b.data) return E_OUTOFMEMORY;
+    hr = value_from_string( type, b.data, out );
+    if (SUCCEEDED(hr) && !*out) hr = E_INVALIDARG;
+    free( b.data );
+    return hr;
+}
+
 static HRESULT read_element( struct text_state *state, IInspectable *existing, IInspectable **out, WCHAR **key )
 {
-    const WCHAR *local, *ns;
+    const WCHAR *local, *ns, *value_type;
     IInspectable *obj = NULL;
     BOOL empty;
     HRESULT hr;
@@ -1256,6 +1314,14 @@ static HRESULT read_element( struct text_state *state, IInspectable *existing, I
     IXmlReader_GetLocalName( state->reader, &local, NULL );
     IXmlReader_GetNamespaceUri( state->reader, &ns, NULL );
     empty = IXmlReader_IsEmptyElement( state->reader );
+    if (!existing && (value_type = value_element_type( ns, local )))
+    {
+        hr = read_value_element( state, value_type, out, key );
+        if (FAILED(hr)) WARN( "value element %s: %#lx\n", debugstr_w( local ), hr );
+        pop_xmlns( state );
+        state->depth--;
+        return FAILED(hr) ? E_NOTIMPL : hr;   /* a bad value is skipped */
+    }
     if (existing) IInspectable_AddRef( (obj = existing) );
     else if (FAILED(hr = xaml_writer_create( state->writer, ns, local, &obj )))
     {
diff --git a/dlls/windows.ui.xaml/xbf.c b/dlls/windows.ui.xaml/xbf.c
index 7506494..92bf562 100644
--- a/dlls/windows.ui.xaml/xbf.c
+++ b/dlls/windows.ui.xaml/xbf.c
@@ -901,7 +901,14 @@ static HRESULT read_nodes( struct xbf_state *s, struct rd *r, enum read_mode mod
                 else if (!wcscmp( tname, L"Double" ) || !wcscmp( tname, L"Single" )) box = xbox_double( wcstod( value, NULL ) );
                 else if (!wcscmp( tname, L"Int32" )) box = xbox_int32( wcstol( value, NULL, 10 ) );
                 else if (!wcscmp( tname, L"Boolean" )) box = xbox_boolean( !wcsicmp( value, L"True" ) );
-                else box = xbox_string( value );
+#ifndef SG_MUTANT_XBF_COLOR_AS_STRING
+                /* <Color x:Key="...">#AARRGGBB</Color> and the other value types a dictionary keeps */
+                else if (!wcscmp( tname, L"Color" )) xaml_value_from_string( L"Windows.UI.Color", value, &box );
+                else if (!wcscmp( tname, L"Thickness" )) xaml_value_from_string( L"Windows.UI.Xaml.Thickness", value, &box );
+                else if (!wcscmp( tname, L"CornerRadius" )) xaml_value_from_string( L"Windows.UI.Xaml.CornerRadius", value, &box );
+                else if (!wcscmp( tname, L"FontFamily" )) xaml_value_from_string( L"Windows.UI.Xaml.Media.FontFamily", value, &box );
+#endif
+                if (!box) box = xbox_string( value );
             }
             free( ns );
             free( tname );
