+/* ICLROnEventManager: a host registers actions for runtime events (domain unload, runtime disabled,
+ * MDA, stack overflow). Mono reports none of these to the host, so the actions are only kept. */
+struct clr_event_action
+{
+    struct list entry;
+    EClrEvent event;
+    IActionOnCLREvent *action;
+};
+
+static struct list clr_event_actions = LIST_INIT(clr_event_actions);
+
+static HRESULT WINAPI clr_events_QueryInterface(ICLROnEventManager *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_ICLROnEventManager))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI clr_events_AddRef(ICLROnEventManager *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI clr_events_Release(ICLROnEventManager *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI clr_events_RegisterActionOnEvent(ICLROnEventManager *iface, EClrEvent event, IActionOnCLREvent *action)
+{
+    struct clr_event_action *entry;
+
+    TRACE("(%d, %p)\n", event, action);
+    if (!action) return E_POINTER;
+    if (event < 0 || event >= MaxClrEvent) return E_INVALIDARG;
+    if (!(entry = malloc(sizeof(*entry)))) return E_OUTOFMEMORY;
+    entry->event = event;
+    entry->action = action;
+    IActionOnCLREvent_AddRef(action);
+    EnterCriticalSection(&host_control_cs);
+    list_add_tail(&clr_event_actions, &entry->entry);
+    LeaveCriticalSection(&host_control_cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI clr_events_UnregisterActionOnEvent(ICLROnEventManager *iface, EClrEvent event, IActionOnCLREvent *action)
+{
+    struct clr_event_action *entry, *found = NULL;
+
+    TRACE("(%d, %p)\n", event, action);
+    if (!action) return E_POINTER;
+    EnterCriticalSection(&host_control_cs);
+    LIST_FOR_EACH_ENTRY(entry, &clr_event_actions, struct clr_event_action, entry)
+    {
+        if (entry->event == event && entry->action == action)
+        {
+            list_remove(&entry->entry);
+            found = entry;
+            break;
+        }
+    }
+    LeaveCriticalSection(&host_control_cs);
+    if (!found) return E_INVALIDARG;
+    IActionOnCLREvent_Release(found->action);
+    free(found);
+    return S_OK;
+}
+
+static const ICLROnEventManagerVtbl clr_events_vtbl =
+{
+    clr_events_QueryInterface,
+    clr_events_AddRef,
+    clr_events_Release,
+    clr_events_RegisterActionOnEvent,
+    clr_events_UnregisterActionOnEvent,
+};
+
+static ICLROnEventManager clr_events = { &clr_events_vtbl };
+
+/* ICLRDomainManager: the AppDomainManager and the properties (AppDomain.GetData) of the default domain */
