+/* what a host set up for the default domain before the runtime started (ICLRControl and
+ * ICLRDomainManager): its properties (AppDomain.GetData) and its AppDomainManager, which the CLR makes
+ * when the default domain starts, lets initialize the domain (InitializeNewDomain) and hands out as
+ * AppDomain.DomainManager */
+static void create_domain_manager(RuntimeHost *This, MonoDomain *domain)
+{
+    MonoObject *manager = NULL, *appdomain = NULL, *setup = NULL, *ignored;
+    MonoClassField *field;
+    MonoClass *klass;
+    WCHAR *name = NULL;
+    void *args[2];
+    HRESULT hr;
+    DWORD i;
+
+    EnterCriticalSection(&host_control_cs);
+    i = default_domain_count || domain_manager_type;
+    LeaveCriticalSection(&host_control_cs);
+    if (!i) return;
+
+    hr = RuntimeHost_Invoke(This, domain, NULL, "System", "AppDomain", "get_CurrentDomain", NULL, NULL, 0, &appdomain);
+    if (FAILED(hr) || !appdomain) return;
+
+    EnterCriticalSection(&host_control_cs);
+    for (i = 0; i < default_domain_count; i++)
+    {
+        char *n = WtoA(default_domain_names[i]), *v = default_domain_values[i] ? WtoA(default_domain_values[i]) : NULL;
+
+        if (n)
+        {
+            args[0] = mono_string_new(domain, n);
+            args[1] = v ? mono_string_new(domain, v) : NULL;
+            hr = RuntimeHost_Invoke(This, domain, NULL, "System", "AppDomain", "SetData", appdomain, args, 2, &ignored);
+            if (FAILED(hr)) WARN("SetData(%s) failed: %#lx\n", debugstr_a(n), hr);
+        }
+        free(n);
+        free(v);
+    }
+    if (domain_manager_type && domain_manager_assembly &&
+        (name = malloc((wcslen(domain_manager_type) + wcslen(domain_manager_assembly) + 3) * sizeof(WCHAR))))
+    {
+        wcscpy(name, domain_manager_type);
+        wcscat(name, L", ");
+        wcscat(name, domain_manager_assembly);
+    }
+    LeaveCriticalSection(&host_control_cs);
+    if (!name) return;
+
+    TRACE("domain manager %s\n", debugstr_w(name));
+    hr = RuntimeHost_CreateManagedInstance(This, name, domain, &manager);
+    free(name);
+    if (FAILED(hr) || !manager)
+    {
+        WARN("the domain manager could not be made: %#lx\n", hr);
+        return;
+    }
+
+    hr = RuntimeHost_Invoke(This, domain, NULL, "System", "AppDomain", "get_SetupInformation", appdomain, NULL, 0, &setup);
+    if (SUCCEEDED(hr))
+    {
+        args[0] = setup;
+        hr = RuntimeHost_VirtualInvoke(This, domain, NULL, "System", "AppDomainManager", "InitializeNewDomain", manager, args, 1, &ignored);
+    }
+    if (FAILED(hr)) WARN("InitializeNewDomain failed: %#lx\n", hr);
+    else if (setup)
+    {
+        /* the manager may give the default domain another configuration file (Visual Studio's names
+         * its per-instance devenv.exe.config): the domain binds by that one from now on */
+        MonoObject *str = NULL;
+        char *configA;
+        WCHAR *configW, base_file[MAX_PATH];
+
+        if (SUCCEEDED(RuntimeHost_Invoke(This, domain, NULL, "System", "AppDomainSetup", "get_ConfigurationFile",
+                                         setup, NULL, 0, &str)) && str &&
+            (configA = mono_string_to_utf8((MonoString *)str)))
+        {
+            configW = configA[0] ? AtoW(configA) : NULL;
+            if (configW && wcsicmp(configW, current_config_file))
+            {
+                char *baseA;
+
+                TRACE("default domain configuration %s\n", debugstr_w(configW));
+                GetModuleFileNameW(NULL, base_file, ARRAY_SIZE(base_file));
+                if ((baseA = WtoA(base_file)))
+                {
+                    char *slash = strrchr(baseA, '\\');
+                    if (slash) slash[1] = 0;
+                    mono_domain_set_config(domain, baseA, configA);
+                    free(baseA);
+                }
+#ifndef SG_MUTANT_MANAGER_CONFIG_IGNORED
+                set_private_path_from_config(configW, base_file, TRUE);
+#endif
+            }
+            free(configW);
+            mono_free(configA);
+        }
+    }
+
+    if ((klass = mono_class_from_name(mono_get_corlib(), "System", "AppDomain")) &&
+        (field = mono_class_get_field_from_name(klass, "_domain_manager")))
+        mono_field_set_value(appdomain, field, manager);
+    else
+        WARN("AppDomain has no domain manager field\n");
+
+#ifndef SG_MUTANT_NO_HOST_SET_MANAGER
+    /* the host hears of the manager (IHostControl::SetAppDomainManager) and talks to it through COM */
+    {
+        IHostControl *control;
+        IUnknown *unk;
+
+        EnterCriticalSection(&host_control_cs);
+        if ((control = host_control)) IHostControl_AddRef(control);
+        LeaveCriticalSection(&host_control_cs);
+        if (control)
+        {
+            if (SUCCEEDED(RuntimeHost_GetIUnknownForObject(This, manager, &unk)))
+            {
+                hr = IHostControl_SetAppDomainManager(control, 1, unk);
+                TRACE("IHostControl::SetAppDomainManager -> %#lx\n", hr);
+                IUnknown_Release(unk);
+            }
+            IHostControl_Release(control);
+        }
+    }
+#endif
+}
