+static DWORD default_domain_count;
+
+static HRESULT WINAPI clr_domains_QueryInterface(ICLRDomainManager *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_ICLRDomainManager))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI clr_domains_AddRef(ICLRDomainManager *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI clr_domains_Release(ICLRDomainManager *iface)
+{
+    return 1;
+}
+
+static HRESULT set_domain_manager_type(LPCWSTR assembly, LPCWSTR type);
+
+static HRESULT WINAPI clr_domains_SetAppDomainManagerType(ICLRDomainManager *iface, LPCWSTR assembly, LPCWSTR type,
+    EInitializeNewDomainFlags flags)
+{
+    TRACE("(%s, %s, %#x)\n", debugstr_w(assembly), debugstr_w(type), flags);
+    return set_domain_manager_type(assembly, type);
+}
+
+static HRESULT WINAPI clr_domains_SetPropertiesForDefaultAppDomain(ICLRDomainManager *iface, DWORD count,
+    LPCWSTR *names, LPCWSTR *values)
+{
+    WCHAR **n, **v;
+    DWORD i;
+
+    TRACE("(%lu, %p, %p)\n", count, names, values);
+    if (count && (!names || !values)) return E_POINTER;
+    if (is_mono_started) return HOST_E_INVALIDOPERATION;
+    n = calloc(count + 1, sizeof(*n));
+    v = calloc(count + 1, sizeof(*v));
+    if (!n || !v) goto oom;
+    for (i = 0; i < count; i++)
+    {
+        TRACE("  %s = %s\n", debugstr_w(names[i]), debugstr_w(values[i]));
+        if (!names[i] || !(n[i] = wcsdup(names[i]))) goto oom;
+        if (values[i] && !(v[i] = wcsdup(values[i]))) goto oom;
+    }
+    EnterCriticalSection(&host_control_cs);
+    for (i = 0; i < default_domain_count; i++)
+    {
+        free(default_domain_names[i]);
+        free(default_domain_values[i]);
+    }
+    free(default_domain_names);
+    free(default_domain_values);
+    default_domain_names = n;
+    default_domain_values = v;
+    default_domain_count = count;
+    LeaveCriticalSection(&host_control_cs);
+    return S_OK;
+oom:
+    for (i = 0; n && i < count; i++) free(n[i]);
+    for (i = 0; v && i < count; i++) free(v[i]);
+    free(n);
+    free(v);
+    return E_OUTOFMEMORY;
+}
+
+static const ICLRDomainManagerVtbl clr_domains_vtbl =
+{
+    clr_domains_QueryInterface,
+    clr_domains_AddRef,
+    clr_domains_Release,
+    clr_domains_SetAppDomainManagerType,
+    clr_domains_SetPropertiesForDefaultAppDomain,
+};
+
+static ICLRDomainManager clr_domains = { &clr_domains_vtbl };
