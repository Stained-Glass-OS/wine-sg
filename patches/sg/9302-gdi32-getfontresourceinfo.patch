From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdi32: GetFontResourceInfoW reads what a font file holds

It was a stub. Types 0 (the number of fonts), 1 (the description: full names, " & " between),
2 (a LOGFONTW of each, as GDI enumerates the font when it is loaded, else from the file's name and
OS/2 tables), 3 (TrueType or not) and 4 (the TrueType file), for TrueType/OpenType files and
collections, read from the file's sfnt tables. OpenTTD asks type 2 for the face name of its own
baseset fonts (added FR_PRIVATE); it fell back to the file name ("OpenTTD-Sans" for "OpenTTD Sans")
and drew with a substitute font. Gate: test/fontresinfo-gate.sh.
---
--- a/dlls/gdi32/text.c
+++ b/dlls/gdi32/text.c
@@ -2628,10 +2628,287 @@
 /***********************************************************************
  *           GetFontResourceInfoW    (GDI32.@)
  */
+/* Stained Glass OS (9302): what a font file holds, read from the file itself
+ * (its sfnt tables, a TrueType collection's fonts each) and matched with the
+ * fonts GDI has loaded from it. Programs that add a font of their own
+ * (AddFontResourceEx FR_PRIVATE) ask it for the face name to create it by:
+ * OpenTTD took the file's name instead ("OpenTTD-Sans" for "OpenTTD Sans") and
+ * drew with a substitute. Types as GDI has them: 0 the number of fonts, 1 the
+ * description (the full names, " & " between), 2 an array of LOGFONTW, 3 a
+ * BOOL, TrueType or not, 4 the TrueType file's path. */
+struct sfnt_face
+{
+    WCHAR family[LF_FACESIZE];
+    WCHAR full[LF_FULLFACESIZE];
+    LONG  weight;
+    BYTE  italic;
+    BYTE  charset;
+};
+
+static BOOL font_file_read( HANDLE file, DWORD offset, void *buf, DWORD len )
+{
+    LARGE_INTEGER pos;
+    DWORD got;
+
+    pos.QuadPart = offset;
+    return SetFilePointerEx( file, pos, NULL, FILE_BEGIN ) && ReadFile( file, buf, len, &got, NULL ) && got == len;
+}
+
+static DWORD sfnt_be32( const BYTE *p ) { return (p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3]; }
+static WORD sfnt_be16( const BYTE *p ) { return (p[0] << 8) | p[1]; }
+
+static BOOL sfnt_find_table( HANDLE file, DWORD font_offset, DWORD tag, DWORD *offset, DWORD *length )
+{
+    BYTE header[12], entry[16];
+    WORD i, count;
+
+    if (!font_file_read( file, font_offset, header, sizeof(header) )) return FALSE;
+    count = sfnt_be16( header + 4 );
+    for (i = 0; i < count && i < 512; i++)
+    {
+        if (!font_file_read( file, font_offset + 12 + i * 16, entry, sizeof(entry) )) return FALSE;
+        if (sfnt_be32( entry ) != tag) continue;
+        *offset = sfnt_be32( entry + 8 );
+        *length = sfnt_be32( entry + 12 );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* name ID ID: the Windows platform's (US English first, else any language), else the Macintosh Roman one */
+static BOOL sfnt_name( const BYTE *table, DWORD len, WORD id, WCHAR *out, int out_len )
+{
+    WORD count, strings, i, j, best = 0xffff;
+    int score = 0, s;
+
+    if (len < 6) return FALSE;
+    count = sfnt_be16( table + 2 );
+    strings = sfnt_be16( table + 4 );
+    for (i = 0; i < count && 6 + (i + 1) * 12 <= len; i++)
+    {
+        const BYTE *rec = table + 6 + i * 12;
+        WORD platform = sfnt_be16( rec ), encoding = sfnt_be16( rec + 2 ), lang = sfnt_be16( rec + 4 );
+
+        if (sfnt_be16( rec + 6 ) != id) continue;
+        if (platform == 3 && (encoding == 1 || encoding == 10 || encoding == 0)) s = lang == 0x409 ? 4 : 3;
+        else if (platform == 1 && encoding == 0) s = lang == 0 ? 2 : 1;
+        else continue;
+        if (s > score) { score = s; best = i; }
+    }
+    if (best == 0xffff) return FALSE;
+    {
+        const BYTE *rec = table + 6 + best * 12;
+        WORD length = sfnt_be16( rec + 8 ), offset = sfnt_be16( rec + 10 );
+        const BYTE *str = table + strings + offset;
+
+        if (strings + offset + length > len) return FALSE;
+        if (sfnt_be16( rec ) == 3)
+            for (j = 0; j < length / 2 && j < out_len - 1; j++) out[j] = sfnt_be16( str + j * 2 );
+        else
+            for (j = 0; j < length && j < out_len - 1; j++) out[j] = str[j] < 0x80 ? str[j] : '?';
+        out[j] = 0;
+    }
+    return out[0] != 0;
+}
+
+static BOOL sfnt_read_face( HANDLE file, DWORD font_offset, struct sfnt_face *face )
+{
+    DWORD offset, length;
+    BYTE *table, os2[64];
+    BOOL ret = FALSE;
+
+    memset( face, 0, sizeof(*face) );
+    face->weight = FW_NORMAL;
+    face->charset = DEFAULT_CHARSET;
+    if (!sfnt_find_table( file, font_offset, 0x6e616d65 /* name */, &offset, &length ) || !length || length > 0x100000)
+        return FALSE;
+    if (!(table = malloc( length ))) return FALSE;
+    if (font_file_read( file, offset, table, length ) && sfnt_name( table, length, 1, face->family, LF_FACESIZE ))
+    {
+        if (!sfnt_name( table, length, 4, face->full, LF_FULLFACESIZE )) lstrcpyW( face->full, face->family );
+        ret = TRUE;
+    }
+    free( table );
+    if (ret && sfnt_find_table( file, font_offset, 0x4f532f32 /* OS/2 */, &offset, &length ) && length >= 64 &&
+        font_file_read( file, offset, os2, sizeof(os2) ))
+    {
+        face->weight = sfnt_be16( os2 + 4 );
+        if (face->weight < 1 || face->weight > 1000) face->weight = FW_NORMAL;
+        face->italic = (sfnt_be16( os2 + 62 ) & 1) ? TRUE : FALSE;
+    }
+    return ret;
+}
+
+/* the fonts in FILE (a font file's path, or a name in the Fonts folder) */
+static int font_file_faces( const WCHAR *str, struct sfnt_face *faces, int max, WCHAR *path, BOOL *truetype )
+{
+    HANDLE file;
+    BYTE header[12];
+    DWORD tag, i, count = 0, offset;
+    WCHAR *part;
+
+    *truetype = FALSE;
+    if (!GetFullPathNameW( str, MAX_PATH, path, &part ) || GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES)
+    {
+        if (wcschr( str, '\\' ) || wcschr( str, '/' ) || !GetWindowsDirectoryW( path, MAX_PATH )) return -1;
+        lstrcatW( path, L"\\Fonts\\" );
+        lstrcatW( path, str );
+    }
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return -1;
+    if (!font_file_read( file, 0, header, sizeof(header) )) { CloseHandle( file ); return -1; }
+    tag = sfnt_be32( header );
+    if (tag == 0x74746366 /* ttcf */)
+    {
+        DWORD fonts = sfnt_be32( header + 8 );
+        BYTE off[4];
+
+        for (i = 0; i < fonts && count < max && i < 256; i++)
+            if (font_file_read( file, 12 + i * 4, off, 4 ) && sfnt_read_face( file, sfnt_be32( off ), &faces[count] ))
+                count++;
+        *truetype = count != 0;
+    }
+    else if (tag == 0x00010000 || tag == 0x4f54544f /* OTTO */ || tag == 0x74727565 /* true */)
+    {
+        offset = 0;
+        if (sfnt_read_face( file, offset, &faces[0] )) count = 1;
+        *truetype = count != 0;
+    }
+    CloseHandle( file );
+    return count;
+}
+
+struct font_enum_match
+{
+    const struct sfnt_face *face;
+    LOGFONTW lf;
+    BOOL found;
+};
+
+static INT CALLBACK font_resource_enum( const LOGFONTW *lf, const TEXTMETRICW *tm, DWORD type, LPARAM param )
+{
+    struct font_enum_match *match = (struct font_enum_match *)param;
+
+    if (match->found) return 1;
+    if (!!lf->lfItalic != !!match->face->italic || (lf->lfWeight > match->face->weight ? lf->lfWeight - match->face->weight : match->face->weight - lf->lfWeight) > 50) return 1;
+    match->lf = *lf;
+    match->found = TRUE;
+    return 1;
+}
+
 BOOL WINAPI GetFontResourceInfoW( const WCHAR *str, DWORD *size, void *buffer, DWORD type )
 {
-    FIXME( "%s %p(%ld) %p %ld\n", debugstr_w(str), size, size ? *size : 0, buffer, type );
+    struct sfnt_face faces[64];
+    WCHAR path[MAX_PATH], *text = NULL;
+    BYTE *result = NULL;
+    DWORD needed = 0, value;
+    BOOL truetype, ret = FALSE;
+    int count, i;
+
+    TRACE( "%s %p(%ld) %p %ld\n", debugstr_w(str), size, size ? *size : 0, buffer, type );
+
+#ifdef SG_MUTANT_NO_FONT_RESOURCE_INFO
     return FALSE;
+#endif
+    if (!str || !size)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if ((count = font_file_faces( str, faces, ARRAY_SIZE(faces), path, &truetype )) < 0)
+    {
+        SetLastError( ERROR_FILE_NOT_FOUND );
+        return FALSE;
+    }
+    if (!count && type != 3 && type != 4)
+    {
+        FIXME( "%s: not a TrueType/OpenType file, type %ld\n", debugstr_w(path), type );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    switch (type)
+    {
+    case 0:  /* the number of fonts */
+    case 3:  /* TrueType or not */
+        value = type == 0 ? count : truetype;
+        needed = sizeof(value);
+        result = (BYTE *)&value;
+        break;
+    case 1:  /* the description */
+        needed = sizeof(WCHAR);
+        for (i = 0; i < count; i++) needed += (lstrlenW( faces[i].full ) + 3) * sizeof(WCHAR);
+        if (!(text = calloc( 1, needed ))) return FALSE;
+        for (i = 0; i < count; i++)
+        {
+            if (i) lstrcatW( text, L" & " );
+            lstrcatW( text, faces[i].full );
+        }
+        needed = (lstrlenW( text ) + 1) * sizeof(WCHAR);
+        result = (BYTE *)text;
+        break;
+    case 2:  /* LOGFONTW of each, as GDI enumerates them */
+    {
+        LOGFONTW *lfs;
+        HDC hdc = NtGdiCreateCompatibleDC( 0 );
+
+        needed = count * sizeof(LOGFONTW);
+        if (!(lfs = calloc( count, sizeof(LOGFONTW) ))) { DeleteDC( hdc ); return FALSE; }
+        for (i = 0; i < count; i++)
+        {
+            struct font_enum_match match = { &faces[i] };
+            LOGFONTW want = { 0 };
+
+            want.lfCharSet = DEFAULT_CHARSET;
+            lstrcpynW( want.lfFaceName, faces[i].family, LF_FACESIZE );
+            if (hdc) EnumFontFamiliesExW( hdc, &want, font_resource_enum, (LPARAM)&match, 0 );
+            if (match.found) lfs[i] = match.lf;
+            else
+            {
+                lfs[i].lfWeight = faces[i].weight;
+                lfs[i].lfItalic = faces[i].italic;
+                lfs[i].lfCharSet = faces[i].charset;
+                lfs[i].lfOutPrecision = OUT_STROKE_PRECIS;
+                lfs[i].lfClipPrecision = CLIP_STROKE_PRECIS;
+                lfs[i].lfQuality = DRAFT_QUALITY;
+                lstrcpynW( lfs[i].lfFaceName, faces[i].family, LF_FACESIZE );
+            }
+        }
+        if (hdc) DeleteDC( hdc );
+        result = (BYTE *)lfs;
+        text = (WCHAR *)lfs;
+        break;
+    }
+    case 4:  /* the TrueType file */
+        if (!truetype) { SetLastError( ERROR_INVALID_PARAMETER ); return FALSE; }
+        needed = (lstrlenW( path ) + 1) * sizeof(WCHAR);
+        result = (BYTE *)path;
+        break;
+    default:
+        FIXME( "%s: type %ld\n", debugstr_w(str), type );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    if (!buffer || !*size)
+    {
+        *size = needed;
+        ret = TRUE;
+    }
+    else if (*size < needed)
+    {
+        *size = needed;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+    }
+    else
+    {
+        memcpy( buffer, result, needed );
+        *size = needed;
+        ret = TRUE;
+    }
+    free( text );
+    return ret;
 }
 
 /***********************************************************************
