From: Stained Glass OS <ke7oxh@gmail.com>
uiautomationcore: tree walker NormalizeElement

NormalizeElement and NormalizeElementBuildCache return the element when the
walker's condition accepts it, else its nearest ancestor that does.
---
--- a/dlls/uiautomationcore/uia_com_client.c
+++ b/dlls/uiautomationcore/uia_com_client.c
@@ -5024,11 +5024,17 @@ static HRESULT WINAPI uia_tree_walker_GetPreviousSiblingElement(IUIAutomationTre
     return IUIAutomationTreeWalker_GetPreviousSiblingElementBuildCache(iface, elem, tree_walker->default_cache_req, prev);
 }
 
+static HRESULT WINAPI uia_tree_walker_NormalizeElementBuildCache(IUIAutomationTreeWalker *iface,
+        IUIAutomationElement *elem, IUIAutomationCacheRequest *cache_req, IUIAutomationElement **normalized);
+
 static HRESULT WINAPI uia_tree_walker_NormalizeElement(IUIAutomationTreeWalker *iface, IUIAutomationElement *elem,
         IUIAutomationElement **normalized)
 {
-    FIXME("%p, %p, %p: stub\n", iface, elem, normalized);
-    return E_NOTIMPL;
+    struct uia_tree_walker *tree_walker = impl_from_IUIAutomationTreeWalker(iface);
+
+    TRACE("%p, %p, %p\n", iface, elem, normalized);
+
+    return uia_tree_walker_NormalizeElementBuildCache(iface, elem, tree_walker->default_cache_req, normalized);
 }
 
 static HRESULT uia_tree_walker_navigate(IUIAutomationTreeWalker *walker, IUIAutomationCacheRequest *cache_req,
@@ -5108,8 +5114,41 @@ static HRESULT WINAPI uia_tree_walker_GetPreviousSiblingElementBuildCache(IUIAut
 static HRESULT WINAPI uia_tree_walker_NormalizeElementBuildCache(IUIAutomationTreeWalker *iface,
         IUIAutomationElement *elem, IUIAutomationCacheRequest *cache_req, IUIAutomationElement **normalized)
 {
-    FIXME("%p, %p, %p, %p: stub\n", iface, elem, cache_req, normalized);
-    return E_NOTIMPL;
+    struct uia_tree_walker *tree_walker = impl_from_IUIAutomationTreeWalker(iface);
+    struct UiaCacheRequest *cache_req_struct;
+    struct uia_element *element;
+    BSTR tree_struct = NULL;
+    SAFEARRAY *sa = NULL;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p, %p\n", iface, elem, cache_req, normalized);
+
+    if (!normalized)
+        return E_POINTER;
+    *normalized = NULL;
+    if (!elem)
+        return E_POINTER;
+
+    if (FAILED(hr = get_uia_cache_request_struct_from_iface(cache_req, &cache_req_struct)))
+        return hr;
+
+    /* the element itself when the walker's view has it, else its nearest ancestor that is in the view */
+    element = impl_from_IUIAutomationElement9((IUIAutomationElement9 *)elem);
+#ifdef SG_MUTANT_UIA_NORMALIZE_SELF
+    hr = UiaGetUpdatedCache(element->node, cache_req_struct, NormalizeState_None, NULL, &sa, &tree_struct);
+#else
+    hr = UiaGetUpdatedCache(element->node, cache_req_struct, NormalizeState_Custom, tree_walker->cond_struct, &sa,
+            &tree_struct);
+#endif
+    if (SUCCEEDED(hr) && sa)
+    {
+        hr = create_uia_element_from_cache_req(normalized, element->from_cui8, cache_req_struct, 0, sa, tree_struct);
+        tree_struct = NULL;
+    }
+
+    SysFreeString(tree_struct);
+    SafeArrayDestroy(sa);
+    return hr;
 }
 
 static HRESULT WINAPI uia_tree_walker_get_Condition(IUIAutomationTreeWalker *iface,
