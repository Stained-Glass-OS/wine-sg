From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: NtQuerySystemInformation answers SystemLeapSecondInformation

.NET 8 programs ask for SystemLeapSecondInformation at start; it was a stub, and in 32-bit processes an unsupported class. It answers that leap seconds are off (the clock here is the host's POSIX time, which has none). ThreadIsIoPending, already answered, no longer logs a FIXME saying it is unsupported.
---
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -4054,6 +4054,25 @@
         break;
     }
 
+#ifndef SG_MUTANT_NO_LEAP_SECOND_INFO
+    case SystemLeapSecondInformation:  /* 206 */
+    {
+        /* (wine-sg 8298) SYSTEM_LEAP_SECOND_INFORMATION { BOOLEAN Enabled; ULONG Flags; }: the clock here
+         * is the host's POSIX time, which has no leap seconds (.NET asks at start) */
+        struct { BOOLEAN Enabled; ULONG Flags; } *leap = info;
+
+        len = sizeof(*leap);
+        if (size != len) ret = STATUS_INFO_LENGTH_MISMATCH;
+        else if (!info) ret = STATUS_ACCESS_VIOLATION;
+        else
+        {
+            leap->Enabled = FALSE;
+            leap->Flags = 0;
+        }
+        break;
+    }
+#endif
+
     case SystemProcessorBrandString:  /* 105 */
         if (!cpu_name[0]) return STATUS_NOT_SUPPORTED;
         if ((ULONG_PTR)info & 3) return STATUS_DATATYPE_MISALIGNMENT;
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -2323,7 +2323,8 @@
     }
 
     case ThreadIsIoPending:
-        FIXME( "ThreadIsIoPending info class not supported yet\n" );
+        /* (wine-sg 8298) answered (no I/O is tracked as pending on a thread): not a FIXME */
+        TRACE( "ThreadIsIoPending\n" );
         if (length != sizeof(BOOL)) return STATUS_INFO_LENGTH_MISMATCH;
         if (!data) return STATUS_ACCESS_DENIED;
 #ifndef SG_MUTANT_IOPENDING_NO_ACCESS
--- a/dlls/wow64/system.c
+++ b/dlls/wow64/system.c
@@ -355,6 +355,9 @@
     case SystemProcessorIdleCycleTimeInformation:  /* ULONG64[] */
     case SystemDynamicTimeZoneInformation:  /* RTL_DYNAMIC_TIME_ZONE_INFORMATION */
     case SystemCodeIntegrityInformation:  /* SYSTEM_CODEINTEGRITY_INFORMATION */
+#ifndef SG_MUTANT_NO_LEAP_SECOND_INFO
+    case SystemLeapSecondInformation:  /* SYSTEM_LEAP_SECOND_INFORMATION (wine-sg 8298) */
+#endif
     case SystemKernelDebuggerInformationEx:  /* SYSTEM_KERNEL_DEBUGGER_INFORMATION_EX */
     case SystemCpuSetInformation:  /* SYSTEM_CPU_SET_INFORMATION */
     case SystemProcessorBrandString:  /* char[] */
