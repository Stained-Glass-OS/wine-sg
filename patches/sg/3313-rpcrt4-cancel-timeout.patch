From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] rpcrt4: RpcMgmtSetCancelTimeout, and the timeout of cancelled calls (3313)

CORE review: RPC (DECISIONS-2 RPC-NDR).

RpcMgmtSetCancelTimeout was a stub and RpcCancelThread/RpcCancelThreadEx
always abandoned the call at once. Now the cancel timeout is per thread (the
default is to wait for ever): a cancel with no time abandons the call, any
other tells the server (PKT_CO_CANCEL, which RpcServerTestCancel sees) and the
call ends with the server's answer, or fails when the time is over -
RPC_S_CALL_CANCELLED after RpcCancelThreadEx, RPC_S_CALL_FAILED after
RpcCancelThread. RpcAsyncCancelCall(FALSE) applies the timeout of the calling
thread to the asynchronous call the same way.
---

diff --git a/dlls/rpcrt4/rpcrt4_main.c b/dlls/rpcrt4/rpcrt4_main.c
--- a/dlls/rpcrt4/rpcrt4_main.c
+++ b/dlls/rpcrt4/rpcrt4_main.c
@@ -52,6 +52,7 @@
 
 #include "rpc_binding.h"
 #include "rpc_server.h"
+#include "rpc_message.h"
 
 #include "wine/debug.h"
 
@@ -93,6 +94,12 @@
     RpcConnection *connection;
     RpcBinding *server_binding;
     struct context_handle_list *context_handle_list;
+    /* seconds to wait for a server to answer a cancelled call: RpcMgmtSetCancelTimeout */
+    LONG cancel_timeout;
+    /* the status the call being received ends with when it was cancelled by a timeout, or 0 */
+    LONG cancel_status;
+    /* changes with every call, for a timer to cancel the call it was started for */
+    ULONG call_serial;
 };
 
 struct interface_header
@@ -933,15 +940,30 @@
     return RPC_S_ENTRY_NOT_FOUND;
 }
 
+static struct threaddata *get_or_create_threaddata(void);
+
 /******************************************************************************
  * RpcMgmtSetCancelTimeout   (rpcrt4.@)
  */
 RPC_STATUS RPC_ENTRY RpcMgmtSetCancelTimeout(LONG Timeout)
 {
-    FIXME("(%ld): stub\n", Timeout);
+    struct threaddata *tdata = get_or_create_threaddata();
+
+    TRACE("(%ld)\n", Timeout);
+
+    if (!tdata) return RPC_S_OUT_OF_MEMORY;
+    /* the calls this thread makes from now on; anything negative waits for ever */
+    tdata->cancel_timeout = Timeout < 0 ? RPC_C_CANCEL_INFINITE_TIMEOUT : Timeout;
     return RPC_S_OK;
 }
 
+/* the cancel timeout of the calling thread */
+LONG RPCRT4_GetThreadCancelTimeout(void)
+{
+    struct threaddata *tdata = get_or_create_threaddata();
+    return tdata ? tdata->cancel_timeout : RPC_C_CANCEL_INFINITE_TIMEOUT;
+}
+
 static struct threaddata *get_or_create_threaddata(void)
 {
     struct threaddata *tdata = NtCurrentTeb()->ReservedForNtRpc;
@@ -953,6 +975,11 @@
         InitializeCriticalSectionEx(&tdata->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
         tdata->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": threaddata.cs");
         tdata->thread_id = GetCurrentThreadId();
+#ifdef SG_MUTANT_CANCELTO_DEFAULT0
+        tdata->cancel_timeout = 0;
+#else
+        tdata->cancel_timeout = RPC_C_CANCEL_INFINITE_TIMEOUT;
+#endif
 
         EnterCriticalSection(&threaddata_cs);
         list_add_tail(&threaddata_list, &tdata->entry);
@@ -971,9 +998,28 @@
 
     EnterCriticalSection(&tdata->cs);
     tdata->connection = Connection;
+    if (Connection)
+    {
+        tdata->call_serial++;
+        tdata->cancel_status = 0;
+    }
     LeaveCriticalSection(&tdata->cs);
 }
 
+/* the status a cancelled call ends with (0 if it was not cancelled by the thread's timeout) */
+LONG RPCRT4_TakeThreadCancelStatus(void)
+{
+    struct threaddata *tdata = get_or_create_threaddata();
+    LONG status;
+
+    if (!tdata) return 0;
+    EnterCriticalSection(&tdata->cs);
+    status = tdata->cancel_status;
+    tdata->cancel_status = 0;
+    LeaveCriticalSection(&tdata->cs);
+    return status;
+}
+
 void RPCRT4_SetThreadCurrentCallHandle(RpcBinding *Binding)
 {
     struct threaddata *tdata = get_or_create_threaddata();
@@ -1043,7 +1089,42 @@
     return context_handle;
 }
 
-static RPC_STATUS rpc_cancel_thread(DWORD target_tid)
+struct cancel_timer
+{
+    DWORD thread_id;
+    ULONG serial;
+    LONG status;
+};
+
+/* the time to wait for the server is over: the call the timer was started for ends */
+static void CALLBACK cancel_timer_proc(PTP_CALLBACK_INSTANCE instance, void *arg, PTP_TIMER pool_timer)
+{
+    struct cancel_timer *timer = arg;
+    struct threaddata *tdata;
+
+    EnterCriticalSection(&threaddata_cs);
+    LIST_FOR_EACH_ENTRY(tdata, &threaddata_list, struct threaddata, entry)
+        if (tdata->thread_id == timer->thread_id)
+        {
+            EnterCriticalSection(&tdata->cs);
+            if (tdata->connection && tdata->call_serial == timer->serial)
+            {
+                tdata->cancel_status = timer->status;
+                rpcrt4_conn_cancel_call(tdata->connection);
+            }
+            LeaveCriticalSection(&tdata->cs);
+            break;
+        }
+    LeaveCriticalSection(&threaddata_cs);
+    free(timer);
+    CloseThreadpoolTimer(pool_timer);
+}
+
+/* Cancels the call a thread is waiting for.  With a timeout of 0 the call is abandoned now.
+ * Otherwise the server is told about the cancel and the call goes on until the server answers,
+ * or for as many seconds as the timeout says (or for ever): then it is abandoned and fails with
+ * status.  timeout is the one of the target thread (RpcMgmtSetCancelTimeout) when use_thread is set. */
+static RPC_STATUS rpc_cancel_thread(DWORD target_tid, LONG timeout, BOOL use_thread, LONG status)
 {
     struct threaddata *tdata;
 
@@ -1052,7 +1133,48 @@
         if (tdata->thread_id == target_tid)
         {
             EnterCriticalSection(&tdata->cs);
-            if (tdata->connection) rpcrt4_conn_cancel_call(tdata->connection);
+            if (use_thread) timeout = tdata->cancel_timeout;
+            if (tdata->connection)
+            {
+#ifdef SG_MUTANT_CANCELTO_ALWAYSNOW
+                timeout = 0;
+#endif
+                if (!timeout)
+                {
+                    tdata->cancel_status = RPC_S_CALL_CANCELLED;
+                    rpcrt4_conn_cancel_call(tdata->connection);
+                }
+                else
+                {
+#ifndef SG_MUTANT_CANCELTO_NOPDU
+                    RPCRT4_SendCancel(tdata->connection);
+#endif
+                    if (timeout > 0)
+                    {
+                        struct cancel_timer *timer = malloc(sizeof(*timer));
+                        PTP_TIMER pool_timer;
+                        FILETIME due;
+                        LONGLONG ticks = -(LONGLONG)min(timeout, 4000000) * 1000 * 10000;
+
+#ifdef SG_MUTANT_CANCELTO_NOTIMER
+                        free(timer); timer = NULL;
+#endif
+                        if (timer)
+                        {
+                            timer->thread_id = target_tid;
+                            timer->serial = tdata->call_serial;
+                            timer->status = status;
+                            if ((pool_timer = CreateThreadpoolTimer(cancel_timer_proc, timer, NULL)))
+                            {
+                                due.dwLowDateTime = (DWORD)ticks;
+                                due.dwHighDateTime = (DWORD)(ticks >> 32);
+                                SetThreadpoolTimer(pool_timer, &due, 0, 0);
+                            }
+                            else free(timer);
+                        }
+                    }
+                }
+            }
             LeaveCriticalSection(&tdata->cs);
             break;
         }
@@ -1066,8 +1188,14 @@
  */
 RPC_STATUS RPC_ENTRY RpcCancelThread(void* ThreadHandle)
 {
+    DWORD target_tid;
+
     TRACE("(%p)\n", ThreadHandle);
-    return RpcCancelThreadEx(ThreadHandle, 0);
+
+    target_tid = GetThreadId(ThreadHandle);
+    if (!target_tid) return RPC_S_INVALID_ARG;
+    /* the target thread's own timeout; if the server does not answer in time the call fails */
+    return rpc_cancel_thread(target_tid, 0, TRUE, RPC_S_CALL_FAILED);
 }
 
 /******************************************************************************
@@ -1077,17 +1205,12 @@
 {
     DWORD target_tid;
 
-    FIXME("(%p, %ld)\n", ThreadHandle, Timeout);
+    TRACE("(%p, %ld)\n", ThreadHandle, Timeout);
 
     target_tid = GetThreadId(ThreadHandle);
     if (!target_tid)
         return RPC_S_INVALID_ARG;
 
-    if (Timeout)
-    {
-        FIXME("(%p, %ld)\n", ThreadHandle, Timeout);
-        return RPC_S_OK;
-    }
-    else
-        return rpc_cancel_thread(target_tid);
+    return rpc_cancel_thread(target_tid, Timeout < 0 ? RPC_C_CANCEL_INFINITE_TIMEOUT : Timeout, FALSE,
+                             RPC_S_CALL_CANCELLED);
 }
diff --git a/dlls/rpcrt4/rpc_async.c b/dlls/rpcrt4/rpc_async.c
--- a/dlls/rpcrt4/rpc_async.c
+++ b/dlls/rpcrt4/rpc_async.c
@@ -29,6 +29,7 @@
 #include "rpcasync.h"
 
 #include "wine/debug.h"
+#include "wine/list.h"
 
 #include "rpc_binding.h"
 #include "rpc_message.h"
@@ -169,6 +170,77 @@
     return I_RpcAsyncAbortCall(pAsync, ExceptionCode);
 }
 
+/* the calls whose cancel timeout is running: ended when the time is over unless they complete first */
+struct async_cancel
+{
+    struct list entry;
+    ULONG64 id;
+    struct async_call_data *data;
+    RpcConnection *conn;
+};
+
+static CRITICAL_SECTION async_cancel_cs;
+static CRITICAL_SECTION_DEBUG async_cancel_cs_debug =
+{
+    0, 0, &async_cancel_cs,
+    { &async_cancel_cs_debug.ProcessLocksList, &async_cancel_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": async_cancel_cs") }
+};
+static CRITICAL_SECTION async_cancel_cs = { &async_cancel_cs_debug, -1, 0, 0, 0, 0 };
+static struct list async_cancels = LIST_INIT(async_cancels);
+static ULONG64 async_cancel_next_id;
+
+/* abandons the call: the thread waiting for the response gives up and the notification is sent; it
+ * may be about to start waiting, when there is nothing to cancel yet: try again for a while */
+static void async_abandon_call(struct async_call_data *data, RpcConnection *conn)
+{
+    int i;
+
+    InterlockedExchange(&data->cancelled, 1);
+    for (i = 0; i < 100 && data->call_status == RPC_S_ASYNC_CALL_PENDING; i++)
+    {
+#ifndef SG_MUTANT_ASYNCRPC_NOCANCELIO
+        rpcrt4_conn_cancel_call(conn);
+#endif
+        Sleep(10);
+    }
+}
+
+static void CALLBACK async_cancel_timer_proc(PTP_CALLBACK_INSTANCE instance, void *arg, PTP_TIMER pool_timer)
+{
+    ULONG64 id = (ULONG_PTR)arg;
+    struct async_cancel *cancel;
+
+    EnterCriticalSection(&async_cancel_cs);
+    LIST_FOR_EACH_ENTRY(cancel, &async_cancels, struct async_cancel, entry)
+        if (cancel->id == id)
+        {
+            /* the call is still there, as it is in the list */
+            list_remove(&cancel->entry);
+            if (cancel->data->call_status == RPC_S_ASYNC_CALL_PENDING)
+                async_abandon_call(cancel->data, cancel->conn);
+            free(cancel);
+            break;
+        }
+    LeaveCriticalSection(&async_cancel_cs);
+    CloseThreadpoolTimer(pool_timer);
+}
+
+/* the call ends: no timer may touch it any more */
+void RPCRT4_ForgetAsyncCancels(struct async_call_data *data)
+{
+    struct async_cancel *cancel, *next;
+
+    EnterCriticalSection(&async_cancel_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(cancel, next, &async_cancels, struct async_cancel, entry)
+        if (cancel->data == data)
+        {
+            list_remove(&cancel->entry);
+            free(cancel);
+        }
+    LeaveCriticalSection(&async_cancel_cs);
+}
+
 /***********************************************************************
  *           RpcAsyncCancelCall [RPCRT4.@]
  *
@@ -189,6 +261,8 @@
 {
     struct async_call_data *data;
     RpcConnection *conn;
+    RPC_STATUS status;
+    LONG timeout;
 
     TRACE("(%p, %s)\n", pAsync, fAbortCall ? "TRUE" : "FALSE");
 
@@ -203,20 +277,52 @@
 
     if (fAbortCall)
     {
-        int i;
+        async_abandon_call(data, conn);
+        return RPC_S_OK;
+    }
 
-        InterlockedExchange(&data->cancelled, 1);
-        /* the thread waiting for the response gives up, and the notification is sent; it may be
-         * about to start waiting, when there is nothing to cancel yet: try again for a while */
-        for (i = 0; i < 100 && data->call_status == RPC_S_ASYNC_CALL_PENDING; i++)
-        {
-#ifndef SG_MUTANT_ASYNCRPC_NOCANCELIO
-            rpcrt4_conn_cancel_call(conn);
+    status = RPCRT4_SendCancel(conn);
+    if (status) return status;
+
+    /* the server has the time of RpcMgmtSetCancelTimeout (of this thread) to answer: none, and the
+     * call is abandoned now, a limit, and it is when the time is over, none, and it goes on */
+    timeout = RPCRT4_GetThreadCancelTimeout();
+#ifdef SG_MUTANT_CANCELTO_ASYNCINFINITE
+    timeout = RPC_C_CANCEL_INFINITE_TIMEOUT;
+#endif
+    if (!timeout) async_abandon_call(data, conn);
+    else if (timeout > 0)
+    {
+        struct async_cancel *cancel = malloc(sizeof(*cancel));
+        PTP_TIMER pool_timer;
+        FILETIME due;
+        LONGLONG ticks = -(LONGLONG)min(timeout, 4000000) * 1000 * 10000;
+
+        if (!cancel) return RPC_S_OUT_OF_MEMORY;
+        cancel->data = data;
+        cancel->conn = conn;
+        EnterCriticalSection(&async_cancel_cs);
+        cancel->id = ++async_cancel_next_id;
+        list_add_tail(&async_cancels, &cancel->entry);
+        LeaveCriticalSection(&async_cancel_cs);
+#ifdef SG_MUTANT_CANCELTO_NOASYNCTIMER
+        if (0)
+#else
+        if ((pool_timer = CreateThreadpoolTimer(async_cancel_timer_proc, (void *)(ULONG_PTR)cancel->id, NULL)))
 #endif
-            Sleep(10);
+        {
+            due.dwLowDateTime = (DWORD)ticks;
+            due.dwHighDateTime = (DWORD)(ticks >> 32);
+            SetThreadpoolTimer(pool_timer, &due, 0, 0);
+        }
+        else
+        {
+            EnterCriticalSection(&async_cancel_cs);
+            list_remove(&cancel->entry);
+            LeaveCriticalSection(&async_cancel_cs);
+            free(cancel);
+            return RPC_S_OUT_OF_RESOURCES;
         }
-        return RPC_S_OK;
     }
-
-    return RPCRT4_SendCancel(conn);
+    return RPC_S_OK;
 }
