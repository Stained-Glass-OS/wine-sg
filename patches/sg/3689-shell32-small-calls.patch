From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHRegDeleteKeyW, class factory LockServer, file BindToStorage, shell link size (3689)

shell32: SHRegDeleteKeyW, class factory LockServer, file BindToStorage, shell link size

SHRegDeleteKeyW deletes the key and its subkeys. The default class
factory's LockServer succeeds. BindToStorage on a file system folder
returns the file as an IStream. IPersistStream::GetSizeMax of a shell link
is the size it would be saved at.
---
diff --git a/dlls/shell32/shelllink.c b/dlls/shell32/shelllink.c
index 8e188ad..14d8ac7 100644
--- a/dlls/shell32/shelllink.c
+++ b/dlls/shell32/shelllink.c
@@ -1463,10 +1463,20 @@ static HRESULT WINAPI IPersistStream_fnGetSizeMax(
 	ULARGE_INTEGER*  pcbSize)
 {
 	IShellLinkImpl *This = impl_from_IPersistStream(iface);
-
-	TRACE("(%p)\n", This);
-
-	return E_NOTIMPL;
+	IStream *stream;
+	STATSTG stat;
+	HRESULT hr;
+
+	TRACE("(%p)->(%p)\n", This, pcbSize);
+
+	if (!pcbSize) return E_INVALIDARG;
+	/* the size of the link as it would be saved */
+	if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &stream))) return hr;
+	if (SUCCEEDED(hr = IPersistStream_fnSave(iface, stream, FALSE)) &&
+	    SUCCEEDED(hr = IStream_Stat(stream, &stat, STATFLAG_NONAME)))
+	    pcbSize->QuadPart = stat.cbSize.QuadPart;
+	IStream_Release(stream);
+	return hr;
 }
 
 static const IPersistStreamVtbl psvt =
diff --git a/dlls/shell32/shellole.c b/dlls/shell32/shellole.c
index d48d2bb..9038164 100644
--- a/dlls/shell32/shellole.c
+++ b/dlls/shell32/shellole.c
@@ -483,8 +483,9 @@ static HRESULT WINAPI IDefClF_fnCreateInstance(
 static HRESULT WINAPI IDefClF_fnLockServer(LPCLASSFACTORY iface, BOOL fLock)
 {
 	IDefClFImpl *This = impl_from_IClassFactory(iface);
-	TRACE("%p->(0x%x), not implemented\n",This, fLock);
-	return E_NOTIMPL;
+	TRACE("%p->(0x%x)\n",This, fLock);
+	/* nothing to keep loaded: shell32 stays in memory */
+	return S_OK;
 }
 
 static const IClassFactoryVtbl dclfvt =
diff --git a/dlls/shell32/shellreg.c b/dlls/shell32/shellreg.c
index dedf67b..71c0e32 100644
--- a/dlls/shell32/shellreg.c
+++ b/dlls/shell32/shellreg.c
@@ -132,8 +132,16 @@ HRESULT WINAPI SHRegDeleteKeyW(
 	HKEY hkey,
 	LPCWSTR pszSubKey)
 {
-	FIXME("hkey=%p, %s\n", hkey, debugstr_w(pszSubKey));
-	return 0;
+    LONG ret;
+
+    TRACE("hkey=%p, %s\n", hkey, debugstr_w(pszSubKey));
+
+    /* the key and everything below it */
+    ret = RegDeleteTreeW(hkey, pszSubKey);
+#ifdef SG_MUTANT_REGDEL
+    ret = RegDeleteKeyW(hkey, pszSubKey);
+#endif
+    return ret;
 }
 
 /*************************************************************************
diff --git a/dlls/shell32/shfldr_fs.c b/dlls/shell32/shfldr_fs.c
index ab38103..a5574cd 100644
--- a/dlls/shell32/shfldr_fs.c
+++ b/dlls/shell32/shfldr_fs.c
@@ -466,11 +466,34 @@ IShellFolder_fnBindToStorage (IShellFolder2 * iface, LPCITEMIDLIST pidl,
 {
     IGenericSFImpl *This = impl_from_IShellFolder2(iface);
 
-    FIXME ("(%p)->(pidl=%p,%p,%s,%p) stub\n", This, pidl, pbcReserved,
-     shdebugstr_guid (riid), ppvOut);
+    WCHAR path[MAX_PATH];
+    LPITEMIDLIST full;
+    HRESULT hr;
+
+    TRACE ("(%p)->(pidl=%p,%p,%s,%p)\n", This, pidl, pbcReserved, shdebugstr_guid (riid), ppvOut);
 
+    if (!ppvOut) return E_INVALIDARG;
     *ppvOut = NULL;
-    return E_NOTIMPL;
+    if (!pidl || !pidl->mkid.cb) return E_INVALIDARG;
+    /* a file as a stream (the storage of a file system item) */
+    if (!IsEqualIID(riid, &IID_IStream) && !IsEqualIID(riid, &IID_ISequentialStream) && !IsEqualIID(riid, &IID_IUnknown))
+        return E_NOINTERFACE;
+    if (!(full = ILCombine(This->pidlRoot, pidl))) return E_OUTOFMEMORY;
+    if (!SHGetPathFromIDListW(full, path) || (GetFileAttributesW(path) & FILE_ATTRIBUTE_DIRECTORY))
+    {
+        ILFree(full);
+        return E_FAIL;
+    }
+    ILFree(full);
+    {
+        IStream *stream;
+
+        hr = SHCreateStreamOnFileEx(path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream);
+        if (FAILED(hr)) return hr;
+        hr = IStream_QueryInterface(stream, riid, ppvOut);
+        IStream_Release(stream);
+    }
+    return hr;
 }
 
 /**************************************************************************
