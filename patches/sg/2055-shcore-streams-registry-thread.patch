+/*************************************************************************
+ *      IStream_Copy        [SHCORE.@]
+ *
+ * Copy cb bytes from the current position of one stream to another.
+ */
+HRESULT WINAPI IStream_Copy(IStream *src, IStream *dst, DWORD size)
+{
+    ULARGE_INTEGER count;
+
+    TRACE("%p, %p, %lu.\n", src, dst, size);
+
+    if (!src || !dst) return E_INVALIDARG;
+#ifdef SG_MUTANT_COPY_ONE
+    size = min(size, 1);
+#endif
+    count.QuadPart = size;
+    return IStream_CopyTo(src, dst, count, NULL, NULL);
+}
+
+/*************************************************************************
+ *      GetDpiForShellUIComponent        [SHCORE.@]
+ *
+ * The scale of a part of the shell, in dots per inch: the system's.
+ */
+UINT WINAPI GetDpiForShellUIComponent(INT component)
+{
+    HDC hdc;
+    UINT dpi = 96;
+
+    TRACE("%d.\n", component);
+
+    if ((hdc = GetDC(NULL)))
+    {
+        dpi = GetDeviceCaps(hdc, LOGPIXELSX);
+        ReleaseDC(NULL, hdc);
+    }
+    return dpi;
+}
+
+/*************************************************************************
+ *      SHRegGetValueFromHKCUHKLM        [SHCORE.122]
+ *
+ * A value of the user's key, else of the machine's.
+ */
+LSTATUS WINAPI SHRegGetValueFromHKCUHKLM(const WCHAR *path, const WCHAR *value, DWORD flags, DWORD *type,
+        void *data, DWORD *size)
+{
+    DWORD cb = size ? *size : 0;
+    LSTATUS ret;
+
+    TRACE("%s, %s, %#lx, %p, %p, %p.\n", debugstr_w(path), debugstr_w(value), flags, type, data, size);
+
+    if (!path) return ERROR_INVALID_PARAMETER;
+    ret = RegGetValueW(HKEY_CURRENT_USER, path, value, flags, type, data, size);
+#ifndef SG_MUTANT_HKCU_ONLY
+    if (ret == ERROR_FILE_NOT_FOUND || ret == ERROR_PATH_NOT_FOUND)
+    {
+        if (size) *size = cb;
+        ret = RegGetValueW(HKEY_LOCAL_MACHINE, path, value, flags, type, data, size);
+    }
+#endif
+    return ret;
+}
+
+/*************************************************************************
+ *      SHRegGetBoolValueFromHKCUHKLM        [SHCORE.123]
+ *
+ * A yes or no of the user's key, else of the machine's: a number that is not
+ * 0, or the text yes, true or 1 (no, false and 0 are no); the default when
+ * there is none.
+ */
+BOOL WINAPI SHRegGetBoolValueFromHKCUHKLM(const WCHAR *path, const WCHAR *value, BOOL def)
+{
+    WCHAR text[32];
+    DWORD size, type, number;
+
+    TRACE("%s, %s, %d.\n", debugstr_w(path), debugstr_w(value), def);
+
+    size = sizeof(number);
+    if (!SHRegGetValueFromHKCUHKLM(path, value, RRF_RT_REG_DWORD, &type, &number, &size))
+        return number != 0;
+
+    size = sizeof(text);
+    if (!SHRegGetValueFromHKCUHKLM(path, value, RRF_RT_REG_SZ, &type, text, &size))
+    {
+        if (!wcsicmp(text, L"yes") || !wcsicmp(text, L"true") || !wcscmp(text, L"1")) return TRUE;
+        if (!wcsicmp(text, L"no") || !wcsicmp(text, L"false") || !wcscmp(text, L"0")) return FALSE;
+    }
+    return def;
+}
+
+/*************************************************************************
+ *      SHIsEmptyStream        [SHCORE.102]
+ *
+ * Whether a stream has nothing in it.
+ */
+BOOL WINAPI SHIsEmptyStream(IStream *stream)
+{
+    STATSTG stat;
+
+    TRACE("%p.\n", stream);
+
+    memset(&stat, 0, sizeof(stat));
+    if (SUCCEEDED(IStream_Stat(stream, &stat, STATFLAG_NONAME)))
+        return !stat.cbSize.QuadPart;
+    else
+    {
+        DWORD dummy, read = 0;
+
+        /* try to read from it, and put it back where it was */
+        if (SUCCEEDED(IStream_Read(stream, &dummy, sizeof(dummy), &read)) && read == sizeof(dummy))
+        {
+            LARGE_INTEGER back;
+
+            back.QuadPart = -(LONGLONG)sizeof(dummy);
+            IStream_Seek(stream, back, STREAM_SEEK_CUR, NULL);
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+/*************************************************************************
+ *      MapWin32ErrorToSTG        [SHCORE.103]
+ *
+ * The storage error for a Win32 one: the storage codes that are the Win32 ones
+ * under the storage facility, else the usual HRESULT.
+ */
+HRESULT WINAPI MapWin32ErrorToSTG(DWORD error)
+{
+    TRACE("%lu.\n", error);
+
+    switch (error)
+    {
+    case ERROR_SUCCESS:
+        return S_OK;
+    case ERROR_INVALID_FUNCTION: case ERROR_FILE_NOT_FOUND: case ERROR_PATH_NOT_FOUND: case ERROR_TOO_MANY_OPEN_FILES:
+    case ERROR_ACCESS_DENIED: case ERROR_INVALID_HANDLE: case ERROR_NOT_ENOUGH_MEMORY: case ERROR_INVALID_ACCESS:
+    case ERROR_NO_MORE_FILES: case ERROR_WRITE_PROTECT: case ERROR_SEEK: case ERROR_WRITE_FAULT: case ERROR_READ_FAULT:
+    case ERROR_SHARING_VIOLATION: case ERROR_LOCK_VIOLATION: case ERROR_FILE_EXISTS: case ERROR_INVALID_PARAMETER:
+    case ERROR_DISK_FULL:
+#ifdef SG_MUTANT_STG_MAP
+        return HRESULT_FROM_WIN32(error);
+#endif
+        return 0x80030000 | error;
+    default:
+        return HRESULT_FROM_WIN32(error);
+    }
+}
