@@ -497,13 +497,18 @@ static NTSTATUS logon_ticket_to_token( const char *ticket, DWORD type, HANDLE *t
 {
     NTSTATUS status;
 
-    SERVER_START_REQ( logon_ticket_token )
+    /* Stained Glass OS 7824: STATUS_PENDING while the server asks the account databases (off its
+     * main loop) whether the account is an administrator: ask again */
+    do
     {
-        req->type = type;
-        wine_server_add_data( req, ticket, strlen( ticket ) );
