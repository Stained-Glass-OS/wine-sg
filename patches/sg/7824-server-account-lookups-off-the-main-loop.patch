diff --git a/server/nssworker.c b/server/nssworker.c
new file mode 100644
index 0000000..95928dc
--- /dev/null
+++ b/server/nssworker.c
@@ -0,0 +1,333 @@
+/*
+ * Account lookups off the server's main loop
+ *
+ * Stained Glass OS (wine-sg 7824). On a shared prefix the server asks the system's account
+ * databases (NSS) whether a connecting account may use it (a member of the prefix's group) and
+ * whether an account is one of the machine's administrators (sg-admins, 7737). Those answers
+ * can come from a network directory: with winbind in nsswitch.conf, getgrouplist() asks winbindd,
+ * which may take minutes to answer while it waits on a domain controller. Asked on the main
+ * loop, that stopped the whole server -- every Windows program of every account waited, and the
+ * server did not even end on SIGTERM.
+ *
+ * Here a thread of its own asks, computing each answer exactly as before and afresh for every
+ * question (nothing is kept between questions), and hands it back through a pipe the main loop
+ * polls. The main loop meanwhile serves everyone else; what waits is only what needs the answer:
+ * the connecting process (admitted, and given its token, when it comes) or the thread whose
+ * request asked (STATUS_PENDING until then; its client asks again).
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <errno.h>
+#include <grp.h>
+#include <pthread.h>
+#include <pwd.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <sys/types.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "winternl.h"
+
+#include "file.h"
+#include "handle.h"
+#include "thread.h"
+#include "process.h"
+#include "request.h"
+#include "security.h"
+
+enum nss_job_kind { NSS_JOB_CONNECT, NSS_JOB_REQUEST };
+
+struct nss_job
+{
+    struct nss_job   *next;
+    enum nss_job_kind kind;
+    uid_t             uid;        /* the account asked about */
+    gid_t             gid;        /* the group to check membership of, or -1 */
+    int               in_group;   /* answer: uid is a member of gid */
+    int               admin;      /* answer: uid is an administrator (sg_uid_is_admin) */
+    int               client;     /* NSS_JOB_CONNECT: the accepted connection */
+    int               admitted;   /* NSS_JOB_CONNECT: already admitted without NSS */
+    thread_id_t       tid;        /* NSS_JOB_REQUEST: the thread that asked */
+};
+
+struct nss_worker
+{
+    struct object  obj;
+    struct fd     *fd;            /* read side of the completion pipe */
+};
+
+static void nss_worker_dump( struct object *obj, int verbose );
+static void nss_worker_destroy( struct object *obj );
+static void nss_worker_poll_event( struct fd *fd, int event );
+
+static const struct object_ops nss_worker_ops =
+{
+    sizeof(struct nss_worker),   /* size */
+    &no_type,                    /* type */
+    nss_worker_dump,             /* dump */
+    no_add_queue,                /* add_queue */
+    NULL,                        /* remove_queue */
+    NULL,                        /* signaled */
+    NULL,                        /* satisfied */
+    no_signal,                   /* signal */
+    no_get_fd,                   /* get_fd */
+    default_map_access,          /* map_access */
+    default_get_sd,              /* get_sd */
+    default_set_sd,              /* set_sd */
+    no_get_full_name,            /* get_full_name */
+    no_lookup_name,              /* lookup_name */
+    no_link_name,                /* link_name */
+    NULL,                        /* unlink_name */
+    no_open_file,                /* open_file */
+    no_kernel_obj_list,          /* get_kernel_obj_list */
+    no_close_handle,             /* close_handle */
+    nss_worker_destroy           /* destroy */
+};
+
+static const struct fd_ops nss_worker_fd_ops =
+{
+    NULL,                        /* get_poll_events */
+    nss_worker_poll_event,       /* poll_event */
+    NULL,                        /* flush */
+    NULL,                        /* get_fd_type */
+    NULL,                        /* ioctl */
+    NULL,                        /* queue_async */
+    NULL                         /* reselect_async */
+};
+
+/* the connecting process's answer while create_process makes its token, else -1 */
+int sg_connect_admin = -1;
+
+static struct nss_worker *worker;
+static int done_pipe[2] = { -1, -1 };
+static pthread_mutex_t queue_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t queue_cond = PTHREAD_COND_INITIALIZER;
+static struct nss_job *queue_head, *queue_tail;
+
+static void nss_worker_dump( struct object *obj, int verbose )
+{
+    fprintf( stderr, "NSS lookup worker\n" );
+}
+
+static void nss_worker_destroy( struct object *obj )
+{
+    struct nss_worker *w = (struct nss_worker *)obj;
+
+    if (w->fd) release_object( w->fd );   /* at the server's end: the thread is left as it is */
+}
+
+/* reentrant versions of request.c's uid_in_group and sg_uid_is_admin: the same questions, asked the
+ * same way, safe beside the main thread's own (non-reentrant) getpw* calls */
+static int nss_uid_in_group( uid_t uid, gid_t gid )
+{
+    struct passwd pwbuf, *pw = NULL;
+    gid_t stack[32], *groups = stack;
+    int i, count = ARRAY_SIZE(stack), ret = 0;
+    char buf[4096];
+
+    if (getpwuid_r( uid, &pwbuf, buf, sizeof(buf), &pw ) || !pw) return 0;
+    if (pw->pw_gid == gid) return 1;
+
+    if (getgrouplist( pw->pw_name, pw->pw_gid, groups, &count ) == -1)
+    {
+        if (!(groups = malloc( count * sizeof(*groups) ))) return 0;
+        if (getgrouplist( pw->pw_name, pw->pw_gid, groups, &count ) == -1) count = 0;
+    }
+    for (i = 0; i < count; i++) if (groups[i] == gid) { ret = 1; break; }
+    if (groups != stack) free( groups );
+    return ret;
+}
+
+static int nss_uid_is_admin( uid_t uid )
+{
+    const char *name = getenv( "SG_ADMIN_GROUP" );
+    struct group grbuf, *gr = NULL;
+    char buf[16384];
+
+    if (!uid) return 0;
+    if (getgrnam_r( name && *name ? name : "sg-admins", &grbuf, buf, sizeof(buf), &gr ) || !gr) return 0;
+    return nss_uid_in_group( uid, gr->gr_gid );
+}
+
+static void *nss_worker_thread( void *arg )
+{
+    sigset_t all;
+
+    /* the server's signals (SIGCHLD, SIGALRM's watchdog, SIGTERM...) are the main thread's */
+    sigfillset( &all );
+    pthread_sigmask( SIG_BLOCK, &all, NULL );
+
+    for (;;)
+    {
+        struct nss_job *job;
+
+        pthread_mutex_lock( &queue_mutex );
+        while (!queue_head) pthread_cond_wait( &queue_cond, &queue_mutex );
+        job = queue_head;
+        if (!(queue_head = job->next)) queue_tail = NULL;
+        pthread_mutex_unlock( &queue_mutex );
+
+        job->in_group = job->gid != (gid_t)-1 ? nss_uid_in_group( job->uid, job->gid ) : 0;
+        job->admin = nss_uid_is_admin( job->uid );
+
+        while (write( done_pipe[1], &job, sizeof(job) ) == -1 && errno == EINTR);
+    }
+    return NULL;
+}
+
+static int init_worker(void)
+{
+    pthread_t thread;
+    pthread_attr_t attr;
+
+    if (worker) return 1;
+    if (pipe( done_pipe ) == -1) return 0;
+    if (!(worker = alloc_object( &nss_worker_ops ))) goto failed;
+    if (!(worker->fd = create_anonymous_fd( &nss_worker_fd_ops, done_pipe[0], &worker->obj, 0 )))
+    {
+        release_object( worker );
+        worker = NULL;
+        done_pipe[0] = -1;   /* closed with the fd */
+        goto failed;
+    }
+    make_object_permanent( &worker->obj );
+    set_fd_events( worker->fd, POLLIN );
+
+    pthread_attr_init( &attr );
+    pthread_attr_setdetachstate( &attr, PTHREAD_CREATE_DETACHED );
+    if (pthread_create( &thread, &attr, nss_worker_thread, NULL ))
+    {
+        pthread_attr_destroy( &attr );
+        fprintf( stderr, "wineserver: cannot start the account lookup thread\n" );
+        return 0;   /* the pipe stays; callers fall back to asking here */
+    }
+    pthread_attr_destroy( &attr );
+    return 1;
+
+failed:
+    if (done_pipe[0] != -1) close( done_pipe[0] );
+    close( done_pipe[1] );
+    done_pipe[0] = done_pipe[1] = -1;
+    return 0;
+}
+
+static int queue_job( struct nss_job *job )
+{
+#ifdef SG_MUTANT_NSS_ON_MAIN_LOOP
+    return 0;
+#endif
+    if (!init_worker()) return 0;
+    job->next = NULL;
+    pthread_mutex_lock( &queue_mutex );
+    if (queue_tail) queue_tail->next = job;
+    else queue_head = job;
+    queue_tail = job;
+    pthread_cond_signal( &queue_cond );
+    pthread_mutex_unlock( &queue_mutex );
+    return 1;
+}
+
+static void finish_connect( struct nss_job *job )
+{
+    struct process *process;
+
+    if (!job->admitted && !job->in_group)
+    {
+        fprintf( stderr, "wineserver: refusing connection from uid %u: not a member of gid %u\n",
+                 (unsigned int)job->uid, (unsigned int)job->gid );
+        close( job->client );
+        return;
+    }
+    sg_connect_admin = job->admin;
+    if ((process = create_process( job->client, NULL, 0, NULL, NULL, NULL, 0, NULL, job->uid )))
+    {
+        create_thread( -1, process, NULL );
+        release_object( process );
+    }
+    sg_connect_admin = -1;
+}
+
+static void finish_request( struct nss_job *job )
+{
+    struct thread *thread = get_thread_from_id( job->tid );
+
+    if (!thread) return;   /* gone meanwhile */
+    if (thread->sg_nss_state == 1 && thread->sg_nss_uid == job->uid)
+    {
+        thread->sg_nss_state = 2;
+        thread->sg_nss_admin = job->admin;
+    }
+    release_object( thread );
+}
+
+static void nss_worker_poll_event( struct fd *fd, int event )
+{
+    struct nss_job *job;
+    ssize_t n;
+
+    /* one answer per event: the pipe stays readable while more are waiting */
+    if ((n = read( done_pipe[0], &job, sizeof(job) )) == sizeof(job))
+    {
+        if (job->kind == NSS_JOB_CONNECT) finish_connect( job );
+        else finish_request( job );
+        free( job );
+    }
+    else if (n == 0 || (n == -1 && errno != EAGAIN && errno != EINTR))
+        fprintf( stderr, "wineserver: account lookup pipe error\n" );
+}
+
+/* The answer for a connecting client: admitted (it may use this server) and, for its token,
+ * administrator or not. Returns 1 when the lookup was handed to the thread (the client is then
+ * admitted or refused later); 0 when it could not be, and the caller asks here as before. */
+int sg_nss_connect_async( int client, uid_t uid, gid_t gid, int admitted )
+{
+    struct nss_job *job = calloc( 1, sizeof(*job) );
+
+    if (!job) return 0;
+    job->kind = NSS_JOB_CONNECT;
+    job->uid = uid;
+    job->gid = admitted ? (gid_t)-1 : gid;
+    job->client = client;
+    job->admitted = admitted;
+    if (queue_job( job )) return 1;
+    free( job );
+    return 0;
+}
+
+/* Is uid an administrator, for a request of the current thread? 1 or 0 when known (answered
+ * for this very request: the answer is used once), -1 when it is being asked (the request
+ * returns STATUS_PENDING and its client asks again). */
+int sg_nss_admin_for_request( uid_t uid )
+{
+    struct nss_job *job;
+
+    if (current->sg_nss_state == 2 && current->sg_nss_uid == uid)
+    {
+        current->sg_nss_state = 0;
+        return current->sg_nss_admin;
+    }
+    if (current->sg_nss_state == 1 && current->sg_nss_uid == uid) return -1;
+
+    if (!(job = calloc( 1, sizeof(*job) ))) return sg_uid_is_admin( uid );
+    job->kind = NSS_JOB_REQUEST;
+    job->uid = uid;
+    job->gid = (gid_t)-1;
+    job->tid = current->id;
+    if (!queue_job( job ))
+    {
+        free( job );
+        return sg_uid_is_admin( uid );   /* no thread: asked here, as before */
+    }
+    current->sg_nss_uid = uid;
+    current->sg_nss_state = 1;
+    return -1;
+}
