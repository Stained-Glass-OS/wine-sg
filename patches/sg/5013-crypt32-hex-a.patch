From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: Support CRYPT_STRING_HEX in CryptBinaryToStringA.

CryptBinaryToStringA supports CRYPT_STRING_HEX: the layout is all ASCII, so it
is CryptBinaryToStringW's, narrowed (same length query, same text, same
ERROR_MORE_DATA). It failed with ERROR_INVALID_PARAMETER and a FIXME.

Gate: test/crypt32-hexa-gate.sh (64/32).
---
 dlls/crypt32/base64.c | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/dlls/crypt32/base64.c b/dlls/crypt32/base64.c
index 298756c..ce83839 100644
--- a/dlls/crypt32/base64.c
+++ b/dlls/crypt32/base64.c
@@ -20,6 +20,8 @@
  */
 
 #include <stdarg.h>
+#include <stdlib.h>
+#include <ctype.h>
 #include "windef.h"
 #include "winbase.h"
 #include "winerror.h"
@@ -299,6 +301,33 @@ static BOOL BinaryToHexRawA(const BYTE *bin, DWORD nbin, DWORD flags, char *str,
     return TRUE;
 }
 
+static BOOL binary_to_hexW(const BYTE *bin, DWORD nbin, DWORD flags, LPWSTR str, DWORD *nstr);
+
+/* the hex layout is all ASCII: the same as the W one, narrowed */
+static BOOL binary_to_hexA(const BYTE *bin, DWORD nbin, DWORD flags, LPSTR str, DWORD *nstr)
+{
+    WCHAR *strW;
+    DWORD i;
+    BOOL ret;
+
+    if (!str) return binary_to_hexW(bin, nbin, flags, NULL, nstr);
+    if (!(strW = malloc(*nstr * sizeof(WCHAR))))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    if ((ret = binary_to_hexW(bin, nbin, flags, strW, nstr)))
+    {
+#ifndef SG_MUTANT_HEXA_UPPER
+        for (i = 0; i <= *nstr; i++) str[i] = strW[i];
+#else
+        for (i = 0; i <= *nstr; i++) str[i] = toupper(strW[i]);
+#endif
+    }
+    free(strW);
+    return ret;
+}
+
 BOOL WINAPI CryptBinaryToStringA(const BYTE *pbBinary,
  DWORD cbBinary, DWORD dwFlags, LPSTR pszString, DWORD *pcchString)
 {
@@ -332,7 +361,13 @@ BOOL WINAPI CryptBinaryToStringA(const BYTE *pbBinary,
     case CRYPT_STRING_HEXRAW:
         encoder = BinaryToHexRawA;
         break;
+#ifndef SG_MUTANT_HEXA_NOTIMPL
+    case CRYPT_STRING_HEX:
+        encoder = binary_to_hexA;
+        break;
+#else
     case CRYPT_STRING_HEX:
+#endif
     case CRYPT_STRING_HEXASCII:
     case CRYPT_STRING_HEXADDR:
     case CRYPT_STRING_HEXASCIIADDR:
