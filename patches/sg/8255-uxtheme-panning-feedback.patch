From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uxtheme: BeginPanningFeedback, UpdatePanningFeedback, EndPanningFeedback

The panning feedback functions were not exported (Firefox, Thunderbird and the other Gecko programs import them). While a pan runs past the end of the content, UpdatePanningFeedback moves the window's top-level window by the total overpan, at most 30 pixels each way, and EndPanningFeedback puts it back where BeginPanningFeedback found it, in one step (no animation); Update and End need a Begin for the same window. uxtheme.h gains them.
---
--- a/dlls/uxtheme/window.c
+++ b/dlls/uxtheme/window.c
@@ -19,6 +19,7 @@
  */
 
 #include <stdarg.h>
+#include <stdlib.h>
 
 #include "windef.h"
 #include "winbase.h"
@@ -26,6 +27,9 @@
 #include "winuser.h"
 #include "uxthemedll.h"
 #include "vssym32.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(uxtheme);
 
 static void uxtheme_draw_menu_button(HTHEME theme, HWND hwnd, HDC hdc, enum NONCLIENT_BUTTON_TYPE type,
                                      RECT rect, BOOL down, BOOL grayed)
@@ -89,3 +93,71 @@
 
     CloseThemeData(theme);
 }
+
+#ifndef SG_MUTANT_NO_PANNING_FEEDBACK
+/* (wine-sg 8255) Panning feedback: while a pan runs past the end of the content, the window's top-level window
+ * is moved by the overpan (at most 30 pixels each way) and put back where it was at the end. Its starting
+ * place is kept on the window as a property between the calls. */
+struct panning_feedback
+{
+    HWND root;
+    POINT origin; /* the top-level window's position in its parent's coordinates */
+};
+
+static const WCHAR panning_feedback_prop[] = L"__wine_sg_panning_feedback";
+
+BOOL WINAPI BeginPanningFeedback( HWND hwnd )
+{
+    struct panning_feedback *feedback;
+    RECT rect;
+    HWND root;
+
+    TRACE( "%p\n", hwnd );
+
+    if (!IsWindow( hwnd ) || !(root = GetAncestor( hwnd, GA_ROOT ))) return FALSE;
+    if ((feedback = GetPropW( hwnd, panning_feedback_prop ))) return TRUE; /* already begun */
+    if (!GetWindowRect( root, &rect ) || !(feedback = malloc( sizeof(*feedback) ))) return FALSE;
+    MapWindowPoints( HWND_DESKTOP, GetParent( root ), (POINT *)&rect, 1 );
+    feedback->root = root;
+    feedback->origin.x = rect.left;
+    feedback->origin.y = rect.top;
+    if (!SetPropW( hwnd, panning_feedback_prop, feedback ))
+    {
+        free( feedback );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+BOOL WINAPI UpdatePanningFeedback( HWND hwnd, LONG offset_x, LONG offset_y, BOOL inertia )
+{
+    struct panning_feedback *feedback;
+
+    TRACE( "%p, %ld, %ld, %d\n", hwnd, offset_x, offset_y, inertia );
+
+    if (!(feedback = GetPropW( hwnd, panning_feedback_prop ))) return FALSE;
+    offset_x = max( -30, min( 30, offset_x ) );
+    offset_y = max( -30, min( 30, offset_y ) );
+    return SetWindowPos( feedback->root, NULL, feedback->origin.x + offset_x, feedback->origin.y + offset_y, 0, 0,
+                         SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER );
+}
+
+BOOL WINAPI EndPanningFeedback( HWND hwnd, BOOL animate )
+{
+    struct panning_feedback *feedback;
+    BOOL ret;
+
+    TRACE( "%p, %d\n", hwnd, animate );
+
+    if (!(feedback = RemovePropW( hwnd, panning_feedback_prop ))) return FALSE;
+    /* the way back is one step: no animation */
+    ret = SetWindowPos( feedback->root, NULL, feedback->origin.x, feedback->origin.y, 0, 0,
+                        SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER );
+    free( feedback );
+    return ret;
+}
+#else
+BOOL WINAPI BeginPanningFeedback( HWND hwnd ) { return FALSE; }
+BOOL WINAPI UpdatePanningFeedback( HWND hwnd, LONG offset_x, LONG offset_y, BOOL inertia ) { return FALSE; }
+BOOL WINAPI EndPanningFeedback( HWND hwnd, BOOL animate ) { return FALSE; }
+#endif
--- a/dlls/uxtheme/uxtheme.spec
+++ b/dlls/uxtheme/uxtheme.spec
@@ -53,6 +53,7 @@
 
 # Standard functions
 @ stdcall BeginBufferedAnimation(ptr ptr ptr long ptr ptr ptr ptr)
+@ stdcall BeginPanningFeedback(ptr)
 @ stdcall BeginBufferedPaint(ptr ptr long ptr ptr)
 @ stdcall BufferedPaintClear(ptr ptr)
 @ stdcall BufferedPaintInit()
@@ -68,6 +69,7 @@
 @ stdcall DrawThemeText(ptr ptr long long wstr long long long ptr)
 @ stdcall DrawThemeTextEx(ptr ptr long long wstr long long ptr ptr)
 @ stdcall EnableThemeDialogTexture(ptr long)
+@ stdcall EndPanningFeedback(ptr long)
 @ stdcall EnableTheming(long)
 @ stdcall EndBufferedAnimation(ptr long)
 @ stdcall EndBufferedPaint(ptr long)
@@ -118,3 +120,4 @@
 @ stdcall SetThemeAppProperties(long)
 @ stdcall SetWindowTheme(ptr wstr wstr)
 @ stdcall SetWindowThemeAttribute(ptr long ptr long)
+@ stdcall UpdatePanningFeedback(ptr long long long)
--- a/include/uxtheme.h
+++ b/include/uxtheme.h
@@ -263,6 +263,9 @@
 #define BPPF_NONCLIENT 0x0004
 
 THEMEAPI_(HPAINTBUFFER) BeginBufferedPaint(HDC, const RECT *, BP_BUFFERFORMAT, BP_PAINTPARAMS *,HDC *);
+BOOL WINAPI BeginPanningFeedback(HWND);
+BOOL WINAPI UpdatePanningFeedback(HWND,LONG,LONG,BOOL);
+BOOL WINAPI EndPanningFeedback(HWND,BOOL);
 THEMEAPI EndBufferedPaint(HPAINTBUFFER, BOOL);
 THEMEAPI BufferedPaintClear(HPAINTBUFFER, const RECT *);
 THEMEAPI BufferedPaintSetAlpha(HPAINTBUFFER, const RECT *, BYTE);
