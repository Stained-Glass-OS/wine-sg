+static CONFIGRET get_iface_list_a(GUID *class, const char *id, char *buffer, ULONG *len, ULONG flags)
+{
+    WCHAR *idW = NULL, *listW;
+    ULONG lenW, size;
+    CONFIGRET ret;
+
+    if (id && !(idW = strdupAtoW(id))) return CR_OUT_OF_MEMORY;
+    if ((ret = get_iface_list(class, idW, NULL, &lenW, flags)))
+    {
+        free(idW);
+        return ret;
+    }
+    if (!(listW = malloc(lenW * sizeof(WCHAR))))
+    {
+        free(idW);
+        return CR_OUT_OF_MEMORY;
+    }
+    ret = get_iface_list(class, idW, listW, &lenW, flags);
+    free(idW);
+    if (!ret)
+    {
+        size = WideCharToMultiByte(CP_ACP, 0, listW, lenW, NULL, 0, NULL, NULL);
+        if (!buffer) *len = size;
+        else if (*len < size) ret = CR_BUFFER_SMALL;
+        else WideCharToMultiByte(CP_ACP, 0, listW, lenW, buffer, *len, NULL, NULL);
+    }
+    free(listW);
+    return ret;
+}
