+CONFIGRET WINAPI CM_Get_Device_Interface_Property_Keys_ExW(const WCHAR *path, DEVPROPKEY *keys, ULONG *count,
+                                                           ULONG flags, HMACHINE machine)
+{
+    SP_DEVICE_INTERFACE_DATA data = { sizeof(data) };
+    HDEVINFO devinfo;
+    CONFIGRET ret;
+    DWORD needed = 0;
+
+    TRACE("%s %p %p %#lx %p\n", debugstr_w(path), keys, count, flags, machine);
+
+    if (machine) return CR_MACHINE_UNAVAILABLE;
+    if (!path || !count || (!keys && *count)) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    if ((devinfo = SetupDiCreateDeviceInfoList(NULL, NULL)) == INVALID_HANDLE_VALUE) return CR_OUT_OF_MEMORY;
+    if (!SetupDiOpenDeviceInterfaceW(devinfo, path, 0, &data)) ret = CR_NO_SUCH_DEVICE_INTERFACE;
+    else
+    {
+        ret = SetupDiGetDeviceInterfacePropertyKeys(devinfo, &data, keys, *count, &needed, 0)
+                ? CR_SUCCESS : map_property_error(GetLastError());
+        *count = needed;
+    }
+    SetupDiDestroyDeviceInfoList(devinfo);
+    return ret;
+}
