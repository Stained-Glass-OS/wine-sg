+/***********************************************************************
+ *		CM_Get_Device_Interface_Property_ExW (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Device_Interface_Property_ExW(const WCHAR *path, const DEVPROPKEY *key, DEVPROPTYPE *type,
+                                                      BYTE *buffer, ULONG *size, ULONG flags, HMACHINE machine)
+{
+    struct DeviceInfoSet *set;
+    struct device_iface *iface;
+    HDEVINFO devinfo;
+    CONFIGRET ret;
+
+    TRACE("%s %p %p %p %p %#lx %p\n", debugstr_w(path), key, type, buffer, size, flags, machine);
+
+    if (machine) return CR_MACHINE_UNAVAILABLE;
+    if (!path || !size || !type) return CR_INVALID_POINTER;
+    if (!key) return CR_INVALID_DATA;
+    if (flags) return CR_INVALID_FLAG;
+    if ((devinfo = SetupDiCreateDeviceInfoList(NULL, NULL)) == INVALID_HANDLE_VALUE) return CR_OUT_OF_MEMORY;
+    set = devinfo;
+    if (!(iface = open_iface_by_path(set, path))) ret = CR_NO_SUCH_DEVICE_INTERFACE;
+    else ret = map_property_error(get_iface_property(iface, key, type, buffer, *size, size, 0));
+    SetupDiDestroyDeviceInfoList(devinfo);
+    return ret;
+}
