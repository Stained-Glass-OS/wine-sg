+CONFIGRET WINAPI CM_Set_Device_Interface_Property_ExW(const WCHAR *path, const DEVPROPKEY *key, DEVPROPTYPE type,
+                                                      const BYTE *buffer, ULONG size, ULONG flags, HMACHINE machine)
+{
+    SP_DEVICE_INTERFACE_DATA data = { sizeof(data) };
+    HDEVINFO devinfo;
+    CONFIGRET ret;
+
+    TRACE("%s %p %#lx %p %lu %#lx %p\n", debugstr_w(path), key, type, buffer, size, flags, machine);
+
+    if (machine) return CR_MACHINE_UNAVAILABLE;
+    if (!path) return CR_INVALID_POINTER;
+    if (!key) return CR_INVALID_DATA;
+    if (flags) return CR_INVALID_FLAG;
+    if ((devinfo = SetupDiCreateDeviceInfoList(NULL, NULL)) == INVALID_HANDLE_VALUE) return CR_OUT_OF_MEMORY;
+    if (!SetupDiOpenDeviceInterfaceW(devinfo, path, 0, &data)) ret = CR_NO_SUCH_DEVICE_INTERFACE;
+    else if (SetupDiSetDeviceInterfacePropertyW(devinfo, &data, key, type, buffer, size, 0)) ret = CR_SUCCESS;
+    else ret = map_property_error(GetLastError());
+    SetupDiDestroyDeviceInfoList(devinfo);
+    return ret;
+}
