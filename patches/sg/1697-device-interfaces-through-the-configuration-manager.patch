+/***********************************************************************
+ *		CM_Register_Device_Interface_ExW (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Register_Device_Interface_ExW(DEVINST devnode, GUID *class, const WCHAR *refstr,
+                                                  WCHAR *buffer, ULONG *len, ULONG flags, HMACHINE machine)
+{
+    SP_DEVINFO_DATA device_data = { sizeof(device_data) };
+    struct device_iface *iface;
+    struct device *device;
+    WCHAR id[MAX_DEVICE_ID_LEN];
+    HDEVINFO devinfo;
+    CONFIGRET ret;
+    ULONG size;
+
+    TRACE("%lu %s %s %p %p %#lx %p\n", devnode, debugstr_guid(class), debugstr_w(refstr), buffer, len, flags, machine);
+
+    if (machine) return CR_MACHINE_UNAVAILABLE;
+    if (!class || !buffer || !len) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    if ((ret = CM_Get_Device_IDW(devnode, id, ARRAY_SIZE(id), 0))) return ret;
+    if ((devinfo = SetupDiCreateDeviceInfoList(NULL, NULL)) == INVALID_HANDLE_VALUE) return CR_OUT_OF_MEMORY;
+    if (!SetupDiOpenDeviceInfoW(devinfo, id, NULL, DIOD_INHERIT_CLASSDRVS, &device_data))
+        ret = CR_NO_SUCH_DEVNODE;
+    else if (!(device = get_device(devinfo, &device_data))
+            || !(iface = SETUPDI_CreateDeviceInterface(device, class, refstr ? refstr : L"")))
+        ret = CR_REGISTRY_ERROR;
+    else
+    {
+        size = wcslen(iface->symlink) + 1;
+        if (*len < size) ret = CR_BUFFER_SMALL;
+        else lstrcpyW(buffer, iface->symlink);
+        *len = size;
+    }
+    SetupDiDestroyDeviceInfoList(devinfo);
+    return ret;
+}
+
+/***********************************************************************
+ *		CM_Register_Device_InterfaceW (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Register_Device_InterfaceW(DEVINST devnode, GUID *class, const WCHAR *refstr,
+                                               WCHAR *buffer, ULONG *len, ULONG flags)
+{
+    return CM_Register_Device_Interface_ExW(devnode, class, refstr, buffer, len, flags, NULL);
+}
+
+/***********************************************************************
+ *		CM_Register_Device_Interface_ExA (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Register_Device_Interface_ExA(DEVINST devnode, GUID *class, const char *refstr,
+                                                  char *buffer, ULONG *len, ULONG flags, HMACHINE machine)
+{
+    WCHAR *refstrW = NULL, bufferW[MAX_PATH * 2];
+    ULONG lenW = ARRAY_SIZE(bufferW), size;
+    CONFIGRET ret;
+
+    if (!buffer || !len) return CR_INVALID_POINTER;
+    if (refstr && !(refstrW = strdupAtoW(refstr))) return CR_OUT_OF_MEMORY;
+    ret = CM_Register_Device_Interface_ExW(devnode, class, refstrW, bufferW, &lenW, flags, machine);
+    free(refstrW);
+    if (ret) return ret;
+    size = WideCharToMultiByte(CP_ACP, 0, bufferW, -1, NULL, 0, NULL, NULL);
+    if (*len < size) ret = CR_BUFFER_SMALL;
+    else WideCharToMultiByte(CP_ACP, 0, bufferW, -1, buffer, *len, NULL, NULL);
+    *len = size;
+    return ret;
+}
+
+/***********************************************************************
+ *		CM_Register_Device_InterfaceA (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Register_Device_InterfaceA(DEVINST devnode, GUID *class, const char *refstr,
+                                               char *buffer, ULONG *len, ULONG flags)
+{
+    return CM_Register_Device_Interface_ExA(devnode, class, refstr, buffer, len, flags, NULL);
+}
+
+/***********************************************************************
+ *		CM_Unregister_Device_Interface_ExW (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Unregister_Device_Interface_ExW(const WCHAR *path, ULONG flags, HMACHINE machine)
+{
+    struct device_iface *iface;
+    HDEVINFO devinfo;
+    CONFIGRET ret = CR_SUCCESS;
+
+    TRACE("%s %#lx %p\n", debugstr_w(path), flags, machine);
+
+    if (machine) return CR_MACHINE_UNAVAILABLE;
+    if (!path) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    if ((devinfo = SetupDiCreateDeviceInfoList(NULL, NULL)) == INVALID_HANDLE_VALUE) return CR_OUT_OF_MEMORY;
+    if (!(iface = open_iface_by_path(devinfo, path))) ret = CR_NO_SUCH_DEVICE_INTERFACE;
+    else remove_device_iface(iface);
+    SetupDiDestroyDeviceInfoList(devinfo);
+    return ret;
+}
+
+/***********************************************************************
+ *		CM_Unregister_Device_InterfaceW (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Unregister_Device_InterfaceW(const WCHAR *path, ULONG flags)
+{
+    return CM_Unregister_Device_Interface_ExW(path, flags, NULL);
+}
+
+/***********************************************************************
+ *		CM_Unregister_Device_Interface_ExA (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Unregister_Device_Interface_ExA(const char *path, ULONG flags, HMACHINE machine)
+{
+    WCHAR *pathW;
+    CONFIGRET ret;
+
+    if (!path) return CR_INVALID_POINTER;
+    if (!(pathW = strdupAtoW(path))) return CR_OUT_OF_MEMORY;
+    ret = CM_Unregister_Device_Interface_ExW(pathW, flags, machine);
+    free(pathW);
+    return ret;
+}
+
+/***********************************************************************
+ *		CM_Unregister_Device_InterfaceA (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Unregister_Device_InterfaceA(const char *path, ULONG flags)
+{
+    return CM_Unregister_Device_Interface_ExA(path, flags, NULL);
+}
