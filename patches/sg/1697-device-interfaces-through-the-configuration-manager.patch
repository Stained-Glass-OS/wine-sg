+/* Stained Glass OS: device interfaces by their paths. An interface's path is
+ * \\?\<device instance, '\' as '#'>#{interface class}[\reference string]; its
+ * key is DeviceClasses\{class}\##?#<device part>, the reference string's key
+ * under it "#<reference string>". */
+static const DEVPROPKEY iface_instance_key =
+    { { 0x78c34fc8, 0x104a, 0x4aca, { 0x9e, 0xa4, 0x52, 0x4d, 0x52, 0x99, 0x6e, 0x57 } }, 256 };
+static const GUID iface_props_fmtid =
+    { 0x026e516e, 0xb814, 0x414b, { 0x83, 0xcd, 0x85, 0x6d, 0x6f, 0xef, 0x48, 0x22 } };
+#define IFACE_PID_FRIENDLYNAME 2
+#define IFACE_PID_ENABLED      3
+#define IFACE_PID_CLASSGUID    4
+#define IFACE_PID_REFSTRING    5
+
+struct iface_path
+{
+    GUID class;
+    WCHAR *key_path;      /* DeviceClasses\{class}\##?#... */
+    WCHAR refstr[MAX_PATH];
+};
+
+static BOOL parse_iface_path(const WCHAR *path, struct iface_path *info)
+{
+    const WCHAR *slash, *guid;
+    WCHAR guidstr[37], *ptr;
+    size_t len;
+
+    info->key_path = NULL;
+    if (!path || wcslen(path) < 4 + 40 || path[0] != '\\' || path[1] != '\\'
+            || (path[2] != '?' && path[2] != '.') || path[3] != '\\')
+        return FALSE;
+    slash = wcschr(path + 4, '\\');
+    len = slash ? slash - path : wcslen(path);
+    if (len < 4 + 40) return FALSE;
+    guid = path + len - 38;
+    if (guid[-1] != '#' || guid[0] != '{' || guid[37] != '}') return FALSE;
+    memcpy(guidstr, guid + 1, 36 * sizeof(WCHAR));
+    guidstr[36] = 0;
+    if (UuidFromStringW(guidstr, &info->class)) return FALSE;
+    info->refstr[0] = 0;
+    if (slash && wcslen(slash + 1) < ARRAY_SIZE(info->refstr)) lstrcpyW(info->refstr, slash + 1);
+    else if (slash) return FALSE;
+
+    if (!(info->key_path = malloc((wcslen(DeviceClasses) + 40 + len + 1) * sizeof(WCHAR)))) return FALSE;
+    lstrcpyW(info->key_path, DeviceClasses);
+    lstrcatW(info->key_path, L"\\");
+    SETUPDI_GuidToString(&info->class, info->key_path + wcslen(info->key_path));
+    lstrcatW(info->key_path, L"\\");
+    ptr = info->key_path + wcslen(info->key_path);
+    memcpy(ptr, path, len * sizeof(WCHAR));
+    ptr[len] = 0;
+    ptr[0] = ptr[1] = ptr[3] = '#';
+    return TRUE;
+}
+
+/* opens the interface's reference string key and gives its device instance */
+static HKEY open_iface_path_key(const WCHAR *path, struct iface_path *info, WCHAR *instance, DWORD instance_len)
+{
+    WCHAR sub[MAX_PATH + 1];
+    HKEY key, refstr_key = NULL;
+    DWORD size, type;
+
+    if (!parse_iface_path(path, info)) return NULL;
+    if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, info->key_path, 0, KEY_READ, &key))
+    {
+        size = instance_len * sizeof(WCHAR);
+        if (!RegQueryValueExW(key, DeviceInstance, NULL, &type, (BYTE *)instance, &size) && type == REG_SZ)
+        {
+            sub[0] = '#';
+            lstrcpyW(sub + 1, info->refstr);
+#ifdef SG_MUTANT_IGNORE_REFSTR
+            sub[1] = 0;
+#endif
+            if (RegOpenKeyExW(key, sub, 0, KEY_READ | KEY_WRITE, &refstr_key))
+                RegOpenKeyExW(key, sub, 0, KEY_READ, &refstr_key);
+        }
+        RegCloseKey(key);
+    }
+    return refstr_key;
+}
+
+static struct device_iface *open_iface_by_path(struct DeviceInfoSet *set, const WCHAR *path)
+{
+    WCHAR instance[MAX_DEVICE_ID_LEN], symlink[MAX_PATH * 2], class_str[40];
+    struct device_iface *iface = NULL;
+    struct iface_path info;
+    struct device *device;
+    GUID device_class = GUID_NULL;
+    HKEY key, dev_key;
+    DWORD size, type;
+
+    if (!(key = open_iface_path_key(path, &info, instance, ARRAY_SIZE(instance))))
+    {
+        free(info.key_path);
+        SetLastError(ERROR_NO_SUCH_DEVICE_INTERFACE);
+        return NULL;
+    }
+    if ((dev_key = open_enum_subkey(instance, NULL)))
+    {
+        size = sizeof(class_str);
+        if (!RegQueryValueExW(dev_key, ClassGUID, NULL, &type, (BYTE *)class_str, &size)
+                && type == REG_SZ && class_str[0] == '{' && class_str[37] == '}')
+        {
+            class_str[37] = 0;
+            UuidFromStringW(class_str + 1, &device_class);
+        }
+        RegCloseKey(dev_key);
+    }
+    if (!IsEqualGUID(&set->ClassGuid, &GUID_NULL) && !IsEqualGUID(&set->ClassGuid, &device_class))
+        SetLastError(ERROR_CLASS_MISMATCH);
+    else if ((device = create_device(set, &device_class, instance, FALSE))
+            && (iface = SETUPDI_CreateDeviceInterface(device, &info.class, info.refstr)))
+    {
+        size = sizeof(symlink);
+        if (!RegQueryValueExW(key, SymbolicLink, NULL, &type, (BYTE *)symlink, &size) && type == REG_SZ)
+            SETUPDI_SetInterfaceSymbolicLink(iface, symlink);
+    }
+    RegCloseKey(key);
+    free(info.key_path);
+    return iface;
+}
+
+/***********************************************************************
+ *		SetupDiOpenDeviceInterfaceW (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiOpenDeviceInterfaceW(HDEVINFO devinfo, const WCHAR *path, DWORD flags,
+                                        SP_DEVICE_INTERFACE_DATA *iface_data)
+{
+    struct DeviceInfoSet *set;
+    struct device_iface *iface;
+
+    TRACE("%p %s %#lx %p\n", devinfo, debugstr_w(path), flags, iface_data);
+
+    if (!(set = get_device_set(devinfo)))
+        return FALSE;
+    if (flags & ~DIODI_NO_ADD)
+    {
+        SetLastError(ERROR_INVALID_FLAGS);
+        return FALSE;
+    }
+    if (iface_data && iface_data->cbSize != sizeof(*iface_data))
+    {
+        SetLastError(ERROR_INVALID_USER_BUFFER);
+        return FALSE;
+    }
+    if (!(iface = open_iface_by_path(set, path)))
+        return FALSE;
+    if (iface_data) copy_device_iface_data(iface_data, iface);
+    return TRUE;
+}
+
+/***********************************************************************
+ *		SetupDiOpenDeviceInterfaceA (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiOpenDeviceInterfaceA(HDEVINFO devinfo, const char *path, DWORD flags,
+                                        SP_DEVICE_INTERFACE_DATA *iface_data)
+{
+    WCHAR *pathW = NULL;
+    BOOL ret;
+
+    TRACE("%p %s %#lx %p\n", devinfo, debugstr_a(path), flags, iface_data);
+
+    if (path && !(pathW = strdupAtoW(path)))
+    {
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+    ret = SetupDiOpenDeviceInterfaceW(devinfo, pathW, flags, iface_data);
+    free(pathW);
+    return ret;
+}
+
+/* the path of the interface of class alias the interface at path's device
+ * has with the same reference string */
+static CONFIGRET find_iface_alias(const WCHAR *path, const GUID *alias, WCHAR *buffer, ULONG *len)
+{
+    WCHAR instance[MAX_DEVICE_ID_LEN], other[MAX_DEVICE_ID_LEN], name[MAX_PATH * 2], sub[MAX_PATH + 1];
+    WCHAR symlink[MAX_PATH * 2];
+    struct iface_path info;
+    HKEY key, class_key, iface_key, refstr_key;
+    DWORD i, size, type;
+    CONFIGRET ret = CR_NO_SUCH_DEVICE_INTERFACE;
+
+    if (!(key = open_iface_path_key(path, &info, instance, ARRAY_SIZE(instance))))
+    {
+        free(info.key_path);
+        return CR_NO_SUCH_DEVICE_INTERFACE;
+    }
+    RegCloseKey(key);
+    free(info.key_path);
+
+    if ((class_key = SetupDiOpenClassRegKeyExW(alias, KEY_READ, DIOCR_INTERFACE, NULL, NULL)) == INVALID_HANDLE_VALUE)
+        return CR_NO_SUCH_DEVICE_INTERFACE;
+    sub[0] = '#';
+    lstrcpyW(sub + 1, info.refstr);
+    for (i = 0; ret == CR_NO_SUCH_DEVICE_INTERFACE; i++)
+    {
+        size = ARRAY_SIZE(name);
+        if (RegEnumKeyExW(class_key, i, name, &size, NULL, NULL, NULL, NULL)) break;
+        if (RegOpenKeyExW(class_key, name, 0, KEY_READ, &iface_key)) continue;
+        size = sizeof(other);
+        if (!RegQueryValueExW(iface_key, DeviceInstance, NULL, &type, (BYTE *)other, &size)
+                && type == REG_SZ && !wcsicmp(other, instance)
+                && !RegOpenKeyExW(iface_key, sub, 0, KEY_READ, &refstr_key))
+        {
+            size = sizeof(symlink);
+            if (!RegQueryValueExW(refstr_key, SymbolicLink, NULL, &type, (BYTE *)symlink, &size) && type == REG_SZ)
+            {
+                size = wcslen(symlink) + 1;
+                if (!buffer || *len < size) ret = CR_BUFFER_SMALL;
+                else
+                {
+                    lstrcpyW(buffer, symlink);
+                    ret = CR_SUCCESS;
+                }
+                *len = size;
+            }
+            RegCloseKey(refstr_key);
+        }
+        RegCloseKey(iface_key);
+    }
+    RegCloseKey(class_key);
+    return ret;
+}
+
+/***********************************************************************
+ *		SetupDiGetDeviceInterfaceAlias (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiGetDeviceInterfaceAlias(HDEVINFO devinfo, SP_DEVICE_INTERFACE_DATA *iface_data,
+                                           const GUID *alias, SP_DEVICE_INTERFACE_DATA *alias_data)
+{
+    struct device_iface *iface, *alias_iface;
+    WCHAR path[MAX_PATH * 2];
+    ULONG len = ARRAY_SIZE(path);
+
+    TRACE("%p %p %s %p\n", devinfo, iface_data, debugstr_guid(alias), alias_data);
+
+    if (!(iface = get_device_iface(devinfo, iface_data)))
+        return FALSE;
+    if (!alias || !alias_data || alias_data->cbSize != sizeof(*alias_data))
+    {
+        SetLastError(ERROR_INVALID_USER_BUFFER);
+        return FALSE;
+    }
+    if (find_iface_alias(iface->symlink, alias, path, &len))
+    {
+        SetLastError(ERROR_NO_SUCH_INTERFACE_DEVICE);
+        return FALSE;
+    }
+    if (!(alias_iface = open_iface_by_path(iface->device->set, path)))
+        return FALSE;
+    copy_device_iface_data(alias_data, alias_iface);
+    return TRUE;
+}
+
+/***********************************************************************
+ *		CM_Get_Device_Interface_Alias_ExW (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Device_Interface_Alias_ExW(const WCHAR *path, GUID *alias, WCHAR *buffer,
+                                                   ULONG *len, ULONG flags, HMACHINE machine)
+{
+    TRACE("%s %s %p %p %#lx %p\n", debugstr_w(path), debugstr_guid(alias), buffer, len, flags, machine);
+
+    if (machine) return CR_MACHINE_UNAVAILABLE;
+    if (!path || !alias || !len) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    return find_iface_alias(path, alias, buffer, len);
+}
