+CONFIGRET WINAPI CM_Get_Device_Interface_Alias_ExA(const char *path, GUID *alias, char *buffer,
+                                                   ULONG *len, ULONG flags, HMACHINE machine)
+{
+    WCHAR *pathW = NULL, bufferW[MAX_PATH * 2];
+    ULONG lenW = ARRAY_SIZE(bufferW), size;
+    CONFIGRET ret;
+
+    TRACE("%s %s %p %p %#lx %p\n", debugstr_a(path), debugstr_guid(alias), buffer, len, flags, machine);
