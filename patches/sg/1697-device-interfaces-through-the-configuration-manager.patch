+/* the interfaces of a class as a list of paths: all of them, or the enabled
+ * ones, or a device's */
+static CONFIGRET get_iface_list(const GUID *class, const WCHAR *id, WCHAR *buffer, ULONG *len, ULONG flags)
+{
+    WCHAR name[MAX_PATH * 2], instance[MAX_DEVICE_ID_LEN], symlink[MAX_PATH * 2];
+    HKEY class_key, iface_key, refstr_key;
+    DWORD i, j, size, type;
+    ULONG needed = 0;
+
+    if (!class || !len) return CR_INVALID_POINTER;
+    if (flags & ~CM_GET_DEVICE_INTERFACE_LIST_BITS) return CR_INVALID_FLAG;
+    if (id && *id)
+    {
+        HKEY dev_key = open_enum_subkey(id, NULL);
+        if (!dev_key) return CR_NO_SUCH_DEVNODE;
+        RegCloseKey(dev_key);
+    }
+
+    if ((class_key = SetupDiOpenClassRegKeyExW(class, KEY_READ, DIOCR_INTERFACE, NULL, NULL)) != INVALID_HANDLE_VALUE)
+    {
+        for (i = 0; ; i++)
+        {
+            size = ARRAY_SIZE(name);
+            if (RegEnumKeyExW(class_key, i, name, &size, NULL, NULL, NULL, NULL)) break;
+            if (RegOpenKeyExW(class_key, name, 0, KEY_READ, &iface_key)) continue;
+            size = sizeof(instance);
+            if (id && *id && (RegQueryValueExW(iface_key, DeviceInstance, NULL, &type, (BYTE *)instance, &size)
+                    || type != REG_SZ || wcsicmp(instance, id)))
+            {
+                RegCloseKey(iface_key);
+                continue;
+            }
+            for (j = 0; ; j++)
+            {
+                size = ARRAY_SIZE(name);
+                if (RegEnumKeyExW(iface_key, j, name, &size, NULL, NULL, NULL, NULL)) break;
+                if (name[0] != '#' || RegOpenKeyExW(iface_key, name, 0, KEY_READ, &refstr_key)) continue;
+                size = sizeof(symlink);
+#ifdef SG_MUTANT_IFACE_ALL_LISTED
+                if ((TRUE || is_linked(refstr_key))
+#else
+                if ((flags & CM_GET_DEVICE_INTERFACE_LIST_ALL_DEVICES || is_linked(refstr_key))
+#endif
+                        && !RegQueryValueExW(refstr_key, SymbolicLink, NULL, &type, (BYTE *)symlink, &size)
+                        && type == REG_SZ)
+                {
+                    size = wcslen(symlink) + 1;
+                    if (buffer && needed + size <= *len) memcpy(buffer + needed, symlink, size * sizeof(WCHAR));
+                    needed += size;
+                }
+                RegCloseKey(refstr_key);
+            }
+            RegCloseKey(iface_key);
+        }
+        RegCloseKey(class_key);
+    }
+
+    needed++;
+    if (buffer)
+    {
+        if (*len < needed) return CR_BUFFER_SMALL;
+        buffer[needed - 1] = 0;
+    }
+    else *len = needed;
+    return CR_SUCCESS;
+}
