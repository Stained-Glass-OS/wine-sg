+/* an interface's properties: what it is (its device, class, reference
+ * string, whether enabled) and what was stored for it */
+static LSTATUS return_iface_property(DEVPROPTYPE type, const void *data, DWORD size, DEVPROPTYPE *prop_type,
+                                     BYTE *buffer, DWORD buffer_size, DWORD *required)
+{
+    *prop_type = type;
+    if (required) *required = size;
+    if (!buffer || buffer_size < size) return ERROR_INSUFFICIENT_BUFFER;
+    memcpy(buffer, data, size);
+    return ERROR_SUCCESS;
+}
+
+static BOOL is_iface_intrinsic_key(const DEVPROPKEY *key)
+{
+    if (IsEqualDevPropKey(*key, iface_instance_key)) return TRUE;
+    return IsEqualGUID(&key->fmtid, &iface_props_fmtid)
+        && (key->pid == IFACE_PID_ENABLED || key->pid == IFACE_PID_CLASSGUID || key->pid == IFACE_PID_REFSTRING);
+}
+
+static LSTATUS get_iface_property(struct device_iface *iface, const DEVPROPKEY *key, DEVPROPTYPE *prop_type,
+                                  BYTE *buffer, DWORD buffer_size, DWORD *required, DWORD flags)
+{
+    LSTATUS ls;
+    HKEY params;
+
+    if (!key) return ERROR_INVALID_DATA;
+    if (!prop_type || (!buffer && buffer_size)) return ERROR_INVALID_USER_BUFFER;
+    if (flags) return ERROR_INVALID_FLAGS;
+
+#ifndef SG_MUTANT_NO_IFACE_INSTANCE
+    if (IsEqualDevPropKey(*key, iface_instance_key))
+#else
+    if (0)
+#endif
+        return return_iface_property(DEVPROP_TYPE_STRING, iface->device->instanceId,
+                                     (wcslen(iface->device->instanceId) + 1) * sizeof(WCHAR),
+                                     prop_type, buffer, buffer_size, required);
+    if (IsEqualGUID(&key->fmtid, &iface_props_fmtid))
+    {
+        if (key->pid == IFACE_PID_ENABLED)
+        {
+            DEVPROP_BOOLEAN enabled = iface->refstr_key && is_linked(iface->refstr_key) ? DEVPROP_TRUE : DEVPROP_FALSE;
+            return return_iface_property(DEVPROP_TYPE_BOOLEAN, &enabled, sizeof(enabled),
+                                         prop_type, buffer, buffer_size, required);
+        }
+        if (key->pid == IFACE_PID_CLASSGUID)
+            return return_iface_property(DEVPROP_TYPE_GUID, &iface->class, sizeof(GUID),
+                                         prop_type, buffer, buffer_size, required);
+        if (key->pid == IFACE_PID_REFSTRING && iface->refstr && *iface->refstr)
+            return return_iface_property(DEVPROP_TYPE_STRING, iface->refstr, (wcslen(iface->refstr) + 1) * sizeof(WCHAR),
+                                         prop_type, buffer, buffer_size, required);
+    }
+    if (!iface->refstr_key)
+    {
+        *prop_type = DEVPROP_TYPE_EMPTY;
+        if (required) *required = 0;
+        return ERROR_NOT_FOUND;
+    }
+
+    ls = get_key_property(iface->refstr_key, key, prop_type, buffer, buffer_size, required, flags);
+    if (ls == ERROR_NOT_FOUND && IsEqualGUID(&key->fmtid, &iface_props_fmtid) && key->pid == IFACE_PID_FRIENDLYNAME
+            && !RegOpenKeyExW(iface->refstr_key, L"Device Parameters", 0, KEY_READ, &params))
+    {
+        WCHAR name[MAX_PATH];
+        DWORD size = sizeof(name) - sizeof(WCHAR), type;
+
+        /* where drivers keep it (an audio endpoint's, a capture device's) */
+        if (!RegQueryValueExW(params, L"FriendlyName", NULL, &type, (BYTE *)name, &size) && type == REG_SZ)
+        {
+            name[size / sizeof(WCHAR)] = 0;
+            ls = return_iface_property(DEVPROP_TYPE_STRING, name, (wcslen(name) + 1) * sizeof(WCHAR),
+                                       prop_type, buffer, buffer_size, required);
+        }
+        RegCloseKey(params);
+    }
+    return ls;
+}
+
+/***********************************************************************
+ *		SetupDiGetDeviceInterfacePropertyW (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiGetDeviceInterfacePropertyW(HDEVINFO devinfo, SP_DEVICE_INTERFACE_DATA *iface_data,
+                                               const DEVPROPKEY *key, DEVPROPTYPE *type, BYTE *buffer,
+                                               DWORD size, DWORD *required, DWORD flags)
+{
+    struct device_iface *iface;
+    LSTATUS ls;
+
+    TRACE("%p %p %p %p %p %lu %p %#lx\n", devinfo, iface_data, key, type, buffer, size, required, flags);
+
+    if (!(iface = get_device_iface(devinfo, iface_data)))
+        return FALSE;
+    ls = get_iface_property(iface, key, type, buffer, size, required, flags);
+    SetLastError(ls);
+    return !ls;
+}
+
+/***********************************************************************
+ *		SetupDiSetDeviceInterfacePropertyW (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiSetDeviceInterfacePropertyW(HDEVINFO devinfo, SP_DEVICE_INTERFACE_DATA *iface_data,
+                                               const DEVPROPKEY *key, DEVPROPTYPE type, const BYTE *buffer,
+                                               DWORD size, DWORD flags)
+{
+    struct device_iface *iface;
+
+    TRACE("%p %p %p %#lx %p %lu %#lx\n", devinfo, iface_data, key, type, buffer, size, flags);
+
+    if (!(iface = get_device_iface(devinfo, iface_data)))
+        return FALSE;
+    if (key && is_iface_intrinsic_key(key))
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+    if (!iface->refstr_key)
+    {
+        SetLastError(ERROR_NO_SUCH_DEVICE_INTERFACE);
+        return FALSE;
+    }
+    return set_key_property(iface->refstr_key, key, type, buffer, size, flags);
+}
+
+/***********************************************************************
+ *		SetupDiGetDeviceInterfacePropertyKeys (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiGetDeviceInterfacePropertyKeys(HDEVINFO devinfo, SP_DEVICE_INTERFACE_DATA *iface_data,
+                                                  DEVPROPKEY *keys, DWORD keys_len, DWORD *required, DWORD flags)
+{
+    struct device_iface *iface;
+    DEVPROPKEY key;
+    DEVPROPTYPE type;
+    DWORD count = 0, i, j, size;
+    WCHAR name[40];
+    HKEY props, fmt_key;
+    GUID fmtid;
+    BOOL have_friendly = FALSE;
+
+    TRACE("%p %p %p %lu %p %#lx\n", devinfo, iface_data, keys, keys_len, required, flags);
+
+    if (flags)
+    {
+        SetLastError(ERROR_INVALID_FLAGS);
+        return FALSE;
+    }
+    if (!keys && keys_len)
+    {
+        SetLastError(ERROR_INVALID_USER_BUFFER);
+        return FALSE;
+    }
+    if (!(iface = get_device_iface(devinfo, iface_data)))
+        return FALSE;
+
+#define ADD_KEY(k) do { if (count < keys_len) keys[count] = (k); count++; } while (0)
+    ADD_KEY(iface_instance_key);
+    key.fmtid = iface_props_fmtid;
+    key.pid = IFACE_PID_ENABLED;
+    ADD_KEY(key);
+    key.pid = IFACE_PID_CLASSGUID;
+    ADD_KEY(key);
+    if (iface->refstr && *iface->refstr)
+    {
+        key.pid = IFACE_PID_REFSTRING;
+        ADD_KEY(key);
+    }
+    if (iface->refstr_key && !RegOpenKeyExW(iface->refstr_key, L"Properties", 0, KEY_READ, &props))
+    {
+        for (i = 0; ; i++)
+        {
+            size = ARRAY_SIZE(name);
+            if (RegEnumKeyExW(props, i, name, &size, NULL, NULL, NULL, NULL)) break;
+            if (size != 38 || name[0] != '{') continue;
+            if (RegOpenKeyExW(props, name, 0, KEY_READ, &fmt_key)) continue;
+            name[37] = 0;
+            if (!UuidFromStringW(name + 1, &fmtid))
+            {
+                for (j = 0; ; j++)
+                {
+                    size = ARRAY_SIZE(name);
+                    if (RegEnumKeyExW(fmt_key, j, name, &size, NULL, NULL, NULL, NULL)) break;
+                    key.fmtid = fmtid;
+                    key.pid = wcstoul(name, NULL, 16);
+                    if (IsEqualGUID(&fmtid, &iface_props_fmtid) && key.pid == IFACE_PID_FRIENDLYNAME)
+                        have_friendly = TRUE;
+                    ADD_KEY(key);
+                }
+            }
+            RegCloseKey(fmt_key);
+        }
+        RegCloseKey(props);
+    }
+    key.fmtid = iface_props_fmtid;
+    key.pid = IFACE_PID_FRIENDLYNAME;
+    if (!have_friendly && get_iface_property(iface, &key, &type, NULL, 0, &size, 0) == ERROR_INSUFFICIENT_BUFFER)
+        ADD_KEY(key);
+#undef ADD_KEY
+
+    if (required) *required = count;
+    if (count > keys_len)
+    {
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+    SetLastError(ERROR_SUCCESS);
+    return TRUE;
+}
+
+static CONFIGRET map_property_error(DWORD error)
+{
+    switch (error)
+    {
+    case ERROR_SUCCESS: return CR_SUCCESS;
+    case ERROR_INVALID_DATA: return CR_INVALID_DATA;
+    case ERROR_INVALID_USER_BUFFER: return CR_INVALID_POINTER;
+    case ERROR_INVALID_FLAGS: return CR_INVALID_FLAG;
+    case ERROR_INSUFFICIENT_BUFFER: return CR_BUFFER_SMALL;
+    case ERROR_NOT_FOUND: return CR_NO_SUCH_VALUE;
+    case ERROR_ACCESS_DENIED: return CR_ACCESS_DENIED;
+    case ERROR_NO_SUCH_DEVICE_INTERFACE: return CR_NO_SUCH_DEVICE_INTERFACE;
+    case ERROR_NOT_ENOUGH_MEMORY: return CR_OUT_OF_MEMORY;
+    }
+    return CR_FAILURE;
+}
