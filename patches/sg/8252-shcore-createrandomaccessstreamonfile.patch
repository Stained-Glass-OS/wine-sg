From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shcore: CreateRandomAccessStreamOnFile

CreateRandomAccessStreamOnFile gives a WinRT random access stream over a file: FileAccessMode_Read opens an existing file for reading, FileAccessMode_ReadWrite opens it for reading and writing, making it when missing; the stream is the one CreateRandomAccessStreamOverStream makes over the file's stream. It was a spec stub; shcore.h gains it.
---
--- a/include/shcore.h
+++ b/include/shcore.h
@@ -27,6 +27,7 @@
   BSOS_PREFERDESTINATIONSTREAM
 } BSOS_OPTIONS;
 
+HRESULT WINAPI CreateRandomAccessStreamOnFile(PCWSTR path, DWORD access, REFIID riid, void **ppv);
 HRESULT WINAPI CreateRandomAccessStreamOverStream(IStream *stream, BSOS_OPTIONS options, REFIID riid, void **ppv);
 
 #endif
--- a/dlls/shcore/main.c
+++ b/dlls/shcore/main.c
@@ -2967,6 +2967,35 @@
     return create(stream, options, riid, ppv);
 }
 
+#ifndef SG_MUTANT_NO_RAS_ON_FILE
+/*************************************************************************
+ * CreateRandomAccessStreamOnFile        [SHCORE.@]
+ *
+ * (wine-sg 8252) A WinRT random access stream over a file: FileAccessMode_Read (0) opens it for reading,
+ * FileAccessMode_ReadWrite (1) for reading and writing (made when missing), and the stream over it is the one
+ * CreateRandomAccessStreamOverStream gives.
+ */
+HRESULT WINAPI CreateRandomAccessStreamOnFile(const WCHAR *path, DWORD access, REFIID riid, void **ppv)
+{
+    IStream *stream;
+    HRESULT hr;
+
+    TRACE("(%s, %lu, %s, %p)\n", debugstr_w(path), access, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!path || !riid || access > 1) return E_INVALIDARG;
+    if (FAILED(hr = SHCreateStreamOnFileEx(path, (access ? STGM_READWRITE : STGM_READ) | STGM_SHARE_DENY_NONE,
+                                           FILE_ATTRIBUTE_NORMAL, access != 0, NULL, &stream)))
+        return hr;
+    hr = CreateRandomAccessStreamOverStream(stream, BSOS_DEFAULT, riid, ppv);
+    IStream_Release(stream);
+    return hr;
+}
+#else
+HRESULT WINAPI CreateRandomAccessStreamOnFile(const WCHAR *path, DWORD access, REFIID riid, void **ppv) { return E_NOTIMPL; }
+#endif
+
 /*************************************************************************
  * CreateStreamOverRandomAccessStream        [SHCORE.@]
  */
--- a/dlls/shcore/shcore.spec
+++ b/dlls/shcore/shcore.spec
@@ -1,6 +1,6 @@
 1 stub -noname SHCreateReadOnlySharedMemoryStream
 @ stdcall CommandLineToArgvW(wstr ptr)
-@ stub CreateRandomAccessStreamOnFile
+@ stdcall CreateRandomAccessStreamOnFile(wstr long ptr ptr)
 @ stdcall CreateRandomAccessStreamOverStream(ptr long ptr ptr)
 @ stdcall CreateStreamOverRandomAccessStream(ptr ptr ptr)
 @ stdcall -private DllCanUnloadNow()
