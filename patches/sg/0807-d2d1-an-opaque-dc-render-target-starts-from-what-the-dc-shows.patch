From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: an opaque DC render target starts from what the DC shows

An ID2D1DCRenderTarget whose alpha mode is not premultiplied started from
a black bitmap and copied all of it to the DC at EndDraw: whatever the
program did not draw came out black. On Windows it starts from what the DC
shows (it is GDI interop). Paint.NET 5 draws its toolbar labels -- "Tool:",
"Brush size:", "Hardness:" -- as text only, through such targets: each
label was a black box with black text in it.

The DC's pixels are now read into the target at every BeginDraw, and a
premultiplied target is cleared to transparent there -- in a device
context op, so both run when the program begins drawing through the
ID2D1DeviceContext the target gives out (Paint.NET does) and not only
through the target's own BeginDraw.

Test: test/dcrt-opaque-gate.sh with test/dcrt-opaque-probe.cpp (mutant
SG_MUTANT_DCRT_NO_READBACK).
---
--- a/dlls/d2d1/dc_render_target.c
+++ b/dlls/d2d1/dc_render_target.c
@@ -603,13 +603,6 @@
     TRACE("iface %p.\n", iface);
 
     ID2D1RenderTarget_BeginDraw(render_target->dxgi_target);
-    /* Start from transparent: what is not drawn leaves the DC as it was. */
-    if (render_target->desc.pixelFormat.alphaMode == D2D1_ALPHA_MODE_PREMULTIPLIED)
-    {
-        static const D2D1_COLOR_F transparent;
-
-        ID2D1RenderTarget_Clear(render_target->dxgi_target, &transparent);
-    }
 }
 
 static HRESULT STDMETHODCALLTYPE d2d_dc_render_target_EndDraw(ID2D1DCRenderTarget *iface,
@@ -734,7 +727,8 @@
     DWORD obj_type;
     HRESULT hr;
 
-    TRACE("iface %p, hdc %p, rect %s.\n", iface, hdc, wine_dbgstr_rect(rect));
+    TRACE("iface %p, hdc %p, rect %s, format %#x, alpha mode %#x.\n", iface, hdc, wine_dbgstr_rect(rect),
+            render_target->desc.pixelFormat.format, render_target->desc.pixelFormat.alphaMode);
 
     obj_type = GetObjectType(hdc);
     if (obj_type != OBJ_DC && obj_type != OBJ_ENHMETADC && obj_type != OBJ_MEMDC)
@@ -837,9 +831,41 @@
     d2d_dc_render_target_BindDC,
 };
 
+/* At every BeginDraw, through this target or the device context it gives
+ * out (Paint.NET draws through that): a premultiplied target starts from
+ * transparent -- what is not drawn leaves the DC as it was -- and an opaque
+ * one from what the DC shows, as on Windows (Paint.NET draws only its
+ * toolbar labels' text: the boxes were black). */
+static void d2d_dc_render_target_begin_draw(IUnknown *outer_unknown)
+{
+    struct d2d_dc_render_target *render_target = impl_from_IUnknown(outer_unknown);
+    const RECT *r = &render_target->dst_rect;
+    RECT empty_rect;
+    HDC dst_hdc;
+
+    if (render_target->desc.pixelFormat.alphaMode == D2D1_ALPHA_MODE_PREMULTIPLIED)
+    {
+        static const D2D1_COLOR_F transparent;
+
+        ID2D1RenderTarget_Clear(render_target->dxgi_target, &transparent);
+        return;
+    }
+#ifndef SG_MUTANT_DCRT_NO_READBACK
+    if (!render_target->hdc || !render_target->dxgi_surface || IsRectEmpty(r))
+        return;
+    if (SUCCEEDED(IDXGISurface1_GetDC(render_target->dxgi_surface, FALSE, &dst_hdc)))
+    {
+        BitBlt(dst_hdc, 0, 0, r->right - r->left, r->bottom - r->top, render_target->hdc, r->left, r->top, SRCCOPY);
+        SetRectEmpty(&empty_rect);
+        IDXGISurface1_ReleaseDC(render_target->dxgi_surface, &empty_rect);
+    }
+#endif
+}
+
 static const struct d2d_device_context_ops d2d_dc_render_target_ops =
 {
     d2d_dc_render_target_present,
+    d2d_dc_render_target_begin_draw,
 };
 
 HRESULT d2d_dc_render_target_init(struct d2d_dc_render_target *render_target, ID2D1Factory1 *factory,
