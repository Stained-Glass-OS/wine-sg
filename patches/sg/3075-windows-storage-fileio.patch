+/*
+ * lines <-> text
+ */
+
+/* split on \r\n, \n and \r; a final line break does not start another line */
+static HRESULT split_lines( const WCHAR *text, DWORD length, struct string_vector *vec )
+{
+    DWORD start = 0, i = 0;
+    HSTRING line;
+    HRESULT hr;
+
+    while (i < length)
+    {
+        if (text[i] == '\r' || text[i] == '\n')
+        {
+            if (FAILED( hr = WindowsCreateString( text + start, i - start, &line ) )) return hr;
+            hr = strings_insert( &vec->s, vec->s.count, line );
+            WindowsDeleteString( line );
+            if (FAILED( hr )) return hr;
+            if (text[i] == '\r' && i + 1 < length && text[i + 1] == '\n') i++;
+            start = ++i;
+        }
+        else i++;
+    }
+    if (start < length)
+    {
+        if (FAILED( hr = WindowsCreateString( text + start, length - start, &line ) )) return hr;
+        hr = strings_insert( &vec->s, vec->s.count, line );
+        WindowsDeleteString( line );
+        if (FAILED( hr )) return hr;
+    }
+    return S_OK;
+}
+
+/* the lines of an iterable, each ending in \r\n */
+static HRESULT join_lines( IIterable_HSTRING *lines, WCHAR **text, DWORD *length )
+{
+    IIterator_HSTRING *it;
+    WCHAR *out = NULL;
+    DWORD len = 0, cap = 0;
+    boolean has;
+    HRESULT hr;
+
+    *text = NULL;
+    if (!lines) return E_INVALIDARG;
+    if (FAILED( hr = IIterable_HSTRING_First( lines, &it ) )) return hr;
+    for (hr = IIterator_HSTRING_get_HasCurrent( it, &has ); SUCCEEDED( hr ) && has;
+         hr = IIterator_HSTRING_MoveNext( it, &has ))
+    {
+        HSTRING line = NULL;
+        UINT32 n;
+        const WCHAR *buf;
+
+        if (FAILED( hr = IIterator_HSTRING_get_Current( it, &line ) )) break;
+        buf = WindowsGetStringRawBuffer( line, &n );
+        if (len + n + 2 + 1 > cap)
+        {
+            DWORD ncap = max( cap * 2, len + n + 2 + 1 + 64 );
+            WCHAR *grown = realloc( out, ncap * sizeof(WCHAR) );
+
+            if (!grown) { WindowsDeleteString( line ); hr = E_OUTOFMEMORY; break; }
+            out = grown;
+            cap = ncap;
+        }
+        memcpy( out + len, buf, n * sizeof(WCHAR) );
+        len += n;
+        out[len++] = '\r';
+        out[len++] = '\n';
+        WindowsDeleteString( line );
+    }
+    IIterator_HSTRING_Release( it );
+    if (FAILED( hr )) { free( out ); return hr; }
+    if (!out && !(out = malloc( sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    out[len] = 0;
+    *text = out;
+    *length = len;
+    return S_OK;
+}
