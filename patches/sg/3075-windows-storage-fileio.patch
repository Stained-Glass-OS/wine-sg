+struct streamed_run
+{
+    IStreamedFileDataRequestedHandler *handler;
+    struct streamed_request *request;
+};
+
+static DWORD WINAPI streamed_thread( void *arg )
 {
-    WARN( "streamed files are not supported\n" );
+    struct streamed_run *run = arg;
+    HRESULT init = RoInitialize( RO_INIT_MULTITHREADED );
+    HRESULT hr;
+
+    hr = IStreamedFileDataRequestedHandler_Invoke( run->handler, &run->request->IStreamedFileDataRequest_iface );
+    if (FAILED( hr ))
+    {
+        WARN( "handler failed, hr %#lx.\n", hr );
+        request_finish( run->request, hr );
+    }
+    if (SUCCEEDED( init )) RoUninitialize();
+    return 0;
+}
+
+/* run the handler to fill the file at path (made, or replaced when it exists) */
+static HRESULT fill_streamed_file( const WCHAR *path, IStreamedFileDataRequestedHandler *handler )
+{
+    struct streamed_run run;
+    struct streamed_request *request;
+    HANDLE file, thread;
+    HRESULT hr;
+    ULONG refs;
+
+    if (!handler) return E_INVALIDARG;
+    file = CreateFileW( path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                        NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+
+    if (!(request = calloc( 1, sizeof(*request) )))
+    {
+        CloseHandle( file );
+        return E_OUTOFMEMORY;
+    }
+    request->IStreamedFileDataRequest_iface.lpVtbl = &request_vtbl;
+    request->IOutputStream_iface.lpVtbl = &request_out_vtbl;
+    request->IClosable_iface.lpVtbl = &request_closable_vtbl;
+    request->ref = 1;
+    request->done = CreateEventW( NULL, TRUE, FALSE, NULL );
+    if (FAILED( hr = file_stream_create( file, TRUE, L"", &request->stream ) ))   /* takes the handle */
+    {
+        CloseHandle( request->done );
+        free( request );
+        return hr;
+    }
+
+    run.handler = handler;
+    run.request = request;
+    if (!(thread = CreateThread( NULL, 0, streamed_thread, &run, 0, NULL )))
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+    else
+    {
+        WaitForSingleObject( thread, 30000 );
+        CloseHandle( thread );
+        /* a handler that did not keep the request is done; one that did closes it later */
+        IStreamedFileDataRequest_AddRef( &request->IStreamedFileDataRequest_iface );
+        refs = IStreamedFileDataRequest_Release( &request->IStreamedFileDataRequest_iface );
+        if (!request->closed && refs <= 1) request_finish( request, S_OK );
+        else if (!request->closed) WaitForSingleObject( request->done, 30000 );
+        if (!request->closed) request_finish( request, HRESULT_FROM_WIN32( ERROR_TIMEOUT ) );
+        hr = request->result;
+    }
+    IStreamedFileDataRequest_Release( &request->IStreamedFileDataRequest_iface );
+    return hr;
+}
