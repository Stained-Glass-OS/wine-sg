+DEFINE_IINSPECTABLE( request_closable, IClosable, struct streamed_request, IStreamedFileDataRequest_iface )
+
+static HRESULT WINAPI request_closable_Close( IClosable *iface )
+{
+    struct streamed_request *impl = CONTAINING_RECORD( iface, struct streamed_request, IClosable_iface );
