+    }
+    else hr = streamed_target( name, &target );
+    if (SUCCEEDED( hr ) && !target) hr = E_OUTOFMEMORY;
+    if (SUCCEEDED( hr ))
+    {
+        if (CopyFileW( source, target, FALSE )) hr = item_from_path( target, FALSE, &file );
+        else hr = HRESULT_FROM_WIN32( GetLastError() );
+    }
+    free( source );
+    free( target );
+    return RET_FILE( file, hr, operation );
 }
 
