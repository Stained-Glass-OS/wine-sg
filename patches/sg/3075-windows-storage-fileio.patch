+/*
+ * Streamed files: a StorageFile whose data an application's handler produces
+ *
+ * The handler runs when the file is made, on a thread of its own, and the data it
+ * writes is kept in a file under the temporary directory; the call returns once the
+ * handler has closed its request (or returned without keeping it).
+ */
+
+struct streamed_request
+{
+    IStreamedFileDataRequest IStreamedFileDataRequest_iface;
+    IOutputStream IOutputStream_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    IRandomAccessStream *stream;
+    HANDLE done;
+    LONG closed;
+    HRESULT result;
+};
+
+static inline struct streamed_request *impl_from_IStreamedFileDataRequest( IStreamedFileDataRequest *iface )
+{
+    return CONTAINING_RECORD( iface, struct streamed_request, IStreamedFileDataRequest_iface );
+}
+
+static HRESULT WINAPI request_QueryInterface( IStreamedFileDataRequest *iface, REFIID iid, void **out )
+{
+    struct streamed_request *impl = impl_from_IStreamedFileDataRequest( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IStreamedFileDataRequest ))
+        *out = &impl->IStreamedFileDataRequest_iface;
+    else if (IsEqualGUID( iid, &IID_IOutputStream ))
+        *out = &impl->IOutputStream_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI request_AddRef( IStreamedFileDataRequest *iface )
+{
+    return InterlockedIncrement( &impl_from_IStreamedFileDataRequest( iface )->ref );
+}
+
+static ULONG WINAPI request_Release( IStreamedFileDataRequest *iface )
+{
+    struct streamed_request *impl = impl_from_IStreamedFileDataRequest( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->stream) IRandomAccessStream_Release( impl->stream );
+        CloseHandle( impl->done );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI request_GetIids( IStreamedFileDataRequest *iface, ULONG *count, IID **iids )
+{
+    IID *list;
+
+    if (!count || !iids) return E_POINTER;
+    if (!(list = CoTaskMemAlloc( 3 * sizeof(IID) ))) return E_OUTOFMEMORY;
+    list[0] = IID_IStreamedFileDataRequest;
+    list[1] = IID_IOutputStream;
+    list[2] = IID_IClosable;
+    *iids = list;
+    *count = 3;
+    return S_OK;
+}
+
+static HRESULT WINAPI request_GetRuntimeClassName( IStreamedFileDataRequest *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Storage_StreamedFileDataRequest,
+                                wcslen( RuntimeClass_Windows_Storage_StreamedFileDataRequest ), name );
+}
+
+static HRESULT WINAPI request_GetTrustLevel( IStreamedFileDataRequest *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+/* finish the request once: close the stream, say how it ended, wake the creator */
+static void request_finish( struct streamed_request *impl, HRESULT result )
+{
+    IClosable *closable;
+
+    if (InterlockedExchange( &impl->closed, 1 )) return;
+    impl->result = result;
+    if (SUCCEEDED( IRandomAccessStream_QueryInterface( impl->stream, &IID_IClosable, (void **)&closable ) ))
+    {
+        IClosable_Close( closable );
+        IClosable_Release( closable );
+    }
+    SetEvent( impl->done );
+}
+
+static HRESULT WINAPI request_FailAndClose( IStreamedFileDataRequest *iface, StreamedFileFailureMode mode )
+{
+    struct streamed_request *impl = impl_from_IStreamedFileDataRequest( iface );
+
+    TRACE( "iface %p, mode %d.\n", iface, mode );
+
+    switch (mode)
+    {
+    case StreamedFileFailureMode_Failed: request_finish( impl, E_FAIL ); break;
+    case StreamedFileFailureMode_CurrentlyUnavailable: request_finish( impl, HRESULT_FROM_WIN32( ERROR_NOT_READY ) ); break;
+    case StreamedFileFailureMode_Incomplete: request_finish( impl, S_OK ); break;
+    default: return E_INVALIDARG;
+    }
+    return S_OK;
+}
+
+static const IStreamedFileDataRequestVtbl request_vtbl =
+{
+    request_QueryInterface, request_AddRef, request_Release,
+    request_GetIids, request_GetRuntimeClassName, request_GetTrustLevel,
+    request_FailAndClose,
+};
