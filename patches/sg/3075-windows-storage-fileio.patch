+static BOOL streamed_name_valid( HSTRING name )
+{
+    UINT32 len, i;
+    const WCHAR *buf;
+
+    if (!name) return FALSE;
+    buf = WindowsGetStringRawBuffer( name, &len );
+    if (!len) return FALSE;
+    for (i = 0; i < len; i++)
+        if (buf[i] < 32 || wcschr( L"\\/:*?\"<>|", buf[i] )) return FALSE;
+    return TRUE;
+}
+
+/* a fresh directory under the temporary directory for the file */
+static HRESULT streamed_target( HSTRING name, WCHAR **path )
+{
+    WCHAR temp[MAX_PATH], dir[MAX_PATH];
+    GUID guid;
+
+    *path = NULL;
+    if (!streamed_name_valid( name )) return E_INVALIDARG;
+    CoCreateGuid( &guid );
+    GetTempPathW( ARRAY_SIZE(temp), temp );
+    swprintf( dir, ARRAY_SIZE(dir), L"%lsStreamedFiles", temp );
+    CreateDirectoryW( dir, NULL );
+    swprintf( dir, ARRAY_SIZE(dir), L"%lsStreamedFiles\\%08lx%04x%04x", temp, guid.Data1, guid.Data2, guid.Data3 );
+    if (!CreateDirectoryW( dir, NULL )) return HRESULT_FROM_WIN32( GetLastError() );
+    if (!(*path = path_join( dir, WindowsGetStringRawBuffer( name, NULL ) ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT streamed_create( HSTRING name, IStreamedFileDataRequestedHandler *handler,
+                                IAsyncOperation_StorageFile **operation )
+{
+    IUnknown *file = NULL;
+    WCHAR *path = NULL;
+    HRESULT hr;
+
     if (!operation) return E_POINTER;
     *operation = NULL;
-    return HR_NOT_SUPPORTED;
+    if (FAILED( hr = streamed_target( name, &path ) )) return hr;
+    if (SUCCEEDED( hr = fill_streamed_file( path, handler ) )) hr = item_from_path( path, FALSE, &file );
+    else DeleteFileW( path );
+    free( path );
+    return RET_FILE( file, hr, operation );
+}
+
+static HRESULT streamed_replace( IStorageFile *target, IStreamedFileDataRequestedHandler *handler,
+                                 IAsyncOperation_StorageFile **operation )
+{
+    IStorageItem *item;
+    IUnknown *file = NULL;
+    HSTRING str = NULL;
+    WCHAR *path = NULL, *part = NULL;
+    HRESULT hr;
+
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    if (!target) return E_INVALIDARG;
+    if (FAILED( hr = IStorageFile_QueryInterface( target, &IID_IStorageItem, (void **)&item ) )) return hr;
+    if (SUCCEEDED( hr = IStorageItem_get_Path( item, &str ) ))
+    {
+        path = wcsdup( WindowsGetStringRawBuffer( str, NULL ) );
+        WindowsDeleteString( str );
+    }
+    IStorageItem_Release( item );
+    if (FAILED( hr )) return hr;
+    if (!path) return E_OUTOFMEMORY;
+
+    /* the old data stays if the handler fails */
+    part = malloc( (wcslen( path ) + 8) * sizeof(WCHAR) );
+    swprintf( part, wcslen( path ) + 8, L"%ls.sgpart", path );
+    if (SUCCEEDED( hr = fill_streamed_file( part, handler ) ))
+    {
+        if (MoveFileExW( part, path, MOVEFILE_REPLACE_EXISTING )) hr = item_from_path( path, FALSE, &file );
+        else hr = HRESULT_FROM_WIN32( GetLastError() );
+    }
+    if (FAILED( hr )) DeleteFileW( part );
+    free( part );
+    free( path );
+    return RET_FILE( file, hr, operation );
+}
