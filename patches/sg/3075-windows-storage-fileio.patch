+/*
+ * the operations, on a path
+ */
+
+static HRESULT op_read_text( const WCHAR *path, int encoding, IAsyncOperation_HSTRING **op )
+{
+    BYTE *data;
+    DWORD size, length;
+    WCHAR *text = NULL;
+    HRESULT hr;
+
+    if (encoding >= 0 && !valid_encoding( encoding )) return E_INVALIDARG;
+    if (SUCCEEDED( hr = read_whole_file( path, &data, &size ) ))
+    {
+        hr = decode_text( data, size, encoding, &text, &length );
+        free( data );
+    }
+    if (hr == E_INVALIDARG && (!path || PathIsRelativeW( path ))) return hr;
+    hr = async_hstring_create( text ? text : L"", hr, op );
+    free( text );
+    return hr;
+}
+
+static HRESULT op_write_text( const WCHAR *path, HSTRING contents, int encoding, BOOL append, IAsyncAction **op )
+{
+    BYTE *data = NULL;
+    DWORD size = 0;
+    UINT32 length = 0;
+    const WCHAR *text = contents ? WindowsGetStringRawBuffer( contents, &length ) : L"";
+    HRESULT hr;
+
+    if (!valid_encoding( encoding )) return E_INVALIDARG;
+    if (!path || PathIsRelativeW( path )) return E_INVALIDARG;
+    if (SUCCEEDED( hr = encode_text( text, length, encoding, &data, &size ) ))
+        hr = write_whole_file( path, data, size, append );
+    free( data );
+    return async_action_create( hr, op );
+}
+
+static HRESULT op_read_lines( const WCHAR *path, int encoding, IAsyncOperation_IVector_HSTRING **op )
+{
+    BYTE *data;
+    DWORD size, length;
+    WCHAR *text = NULL;
+    struct string_vector *vec = NULL;
+    HRESULT hr, ret;
+
+    if (encoding >= 0 && !valid_encoding( encoding )) return E_INVALIDARG;
+    if (!path || PathIsRelativeW( path )) return E_INVALIDARG;
+    if (SUCCEEDED( hr = read_whole_file( path, &data, &size ) ))
+    {
+        if (SUCCEEDED( hr = decode_text( data, size, encoding, &text, &length ) ) &&
+            SUCCEEDED( hr = string_vector_create( &vec ) ))
+            hr = split_lines( text, length, vec );
+        free( data );
+        free( text );
+    }
+    ret = async_ptr_create( &IID_IAsyncOperation_IVector_HSTRING,
+                            L"Windows.Foundation.IAsyncOperation`1<Windows.Foundation.Collections.IVector`1<String>>",
+                            SUCCEEDED( hr ) ? (IUnknown *)&vec->IVector_iface : NULL, hr, (void **)op );
+    if (vec) IVector_HSTRING_Release( &vec->IVector_iface );
+    return ret;
+}
+
+static HRESULT op_write_lines( const WCHAR *path, IIterable_HSTRING *lines, int encoding, BOOL append, IAsyncAction **op )
+{
+    WCHAR *text;
+    DWORD length, size = 0;
+    BYTE *data = NULL;
+    HRESULT hr;
+
+    if (!valid_encoding( encoding )) return E_INVALIDARG;
+    if (!path || PathIsRelativeW( path )) return E_INVALIDARG;
+    if (SUCCEEDED( hr = join_lines( lines, &text, &length ) ))
+    {
+        if (SUCCEEDED( hr = encode_text( text, length, encoding, &data, &size ) ))
+            hr = write_whole_file( path, data, size, append );
+        free( text );
+        free( data );
+    }
+    return async_action_create( hr, op );
+}
+
+static HRESULT op_read_buffer( const WCHAR *path, IAsyncOperation_IBuffer **op )
+{
+    BYTE *data, *dest;
+    DWORD size;
+    IBuffer *buffer = NULL;
+    HRESULT hr, ret;
+
+    if (!path || PathIsRelativeW( path )) return E_INVALIDARG;
+    if (SUCCEEDED( hr = read_whole_file( path, &data, &size ) ))
+    {
+        if (SUCCEEDED( hr = buffer_create( size, &buffer ) ) &&
+            SUCCEEDED( hr = buffer_get_bytes( buffer, &dest, NULL, NULL ) ))
+        {
+            memcpy( dest, data, size );
+            hr = IBuffer_put_Length( buffer, size );
+        }
+        free( data );
+    }
+    ret = async_ptr_create( &IID_IAsyncOperation_IBuffer, L"Windows.Foundation.IAsyncOperation`1<Windows.Storage.Streams.IBuffer>",
+                            SUCCEEDED( hr ) ? (IUnknown *)buffer : NULL, hr, (void **)op );
+    if (buffer) IBuffer_Release( buffer );
+    return ret;
+}
+
+static HRESULT op_write_bytes( const WCHAR *path, const BYTE *bytes, DWORD size, IAsyncAction **op )
+{
+    if (!path || PathIsRelativeW( path )) return E_INVALIDARG;
+    return async_action_create( write_whole_file( path, bytes, size, FALSE ), op );
+}
+
+static HRESULT op_write_buffer( const WCHAR *path, IBuffer *buffer, IAsyncAction **op )
+{
+    BYTE *bytes;
+    UINT32 length;
+    HRESULT hr;
+
+    if (!buffer) return E_INVALIDARG;
+    if (!path || PathIsRelativeW( path )) return E_INVALIDARG;
+    if (SUCCEEDED( hr = buffer_get_bytes( buffer, &bytes, &length, NULL ) ))
+        hr = write_whole_file( path, bytes, length, FALSE );
+    return async_action_create( hr, op );
+}
+
+/*
+ * the two statics: one takes a file, the other a path
+ */
+
+static HRESULT file_path( IStorageFile *file, WCHAR **path )
+{
+    IStorageItem *item;
+    HSTRING str = NULL;
+    HRESULT hr;
+
+    *path = NULL;
+    if (!file) return E_INVALIDARG;
+    if (FAILED( hr = IStorageFile_QueryInterface( file, &IID_IStorageItem, (void **)&item ) )) return hr;
+    if (SUCCEEDED( hr = IStorageItem_get_Path( item, &str ) ))
+    {
+        *path = wcsdup( WindowsGetStringRawBuffer( str, NULL ) );
+        WindowsDeleteString( str );
+        if (!*path) hr = E_OUTOFMEMORY;
+    }
+    IStorageItem_Release( item );
+    return hr;
+}
+
+static HRESULT hstring_path( HSTRING str, WCHAR **path )
+{
+    *path = NULL;
+    if (!str) return E_INVALIDARG;
+    if (!(*path = wcsdup( WindowsGetStringRawBuffer( str, NULL ) ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
