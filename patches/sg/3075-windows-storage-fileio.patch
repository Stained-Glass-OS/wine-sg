+#include "private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(storage);
+
+#define MAX_FILE_SIZE (256 * 1024 * 1024)
+
+/*
+ * file contents <-> text
+ */
+
+static HRESULT read_whole_file( const WCHAR *path, BYTE **data, DWORD *size )
+{
+    HANDLE file;
+    DWORD got;
+    LARGE_INTEGER len;
+    HRESULT hr = S_OK;
+
+    TRACE( "path %s\n", debugstr_w( path ) );
+    *data = NULL;
+    *size = 0;
+    if (!path || PathIsRelativeW( path )) return E_INVALIDARG;
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+    if (!GetFileSizeEx( file, &len ) || len.QuadPart > MAX_FILE_SIZE) hr = len.QuadPart > MAX_FILE_SIZE ? E_OUTOFMEMORY : HRESULT_FROM_WIN32( GetLastError() );
+    else if (!(*data = malloc( len.LowPart ? len.LowPart : 1 ))) hr = E_OUTOFMEMORY;
+    else if (!ReadFile( file, *data, len.LowPart, &got, NULL )) hr = HRESULT_FROM_WIN32( GetLastError() );
+    else *size = got;
+    CloseHandle( file );
+    if (FAILED( hr )) { free( *data ); *data = NULL; }
+    return hr;
+}
+
+static HRESULT write_whole_file( const WCHAR *path, const BYTE *data, DWORD size, BOOL append )
+{
+    HANDLE file;
+    DWORD put;
+    HRESULT hr = S_OK;
+
+    TRACE( "path %s, size %lu, append %d\n", debugstr_w( path ), size, append );
+    if (!path || PathIsRelativeW( path )) return E_INVALIDARG;
+    file = CreateFileW( path, append ? FILE_APPEND_DATA : GENERIC_WRITE, FILE_SHARE_READ, NULL,
+                        append ? OPEN_ALWAYS : CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+    if (size && (!WriteFile( file, data, size, &put, NULL ) || put != size)) hr = HRESULT_FROM_WIN32( GetLastError() );
+    CloseHandle( file );
+    return hr;
+}
+
+/* the text of a file: encoding < 0 detects it by byte order mark (UTF-8 without one) */
+static HRESULT decode_text( const BYTE *data, DWORD size, int encoding, WCHAR **text, DWORD *length )
+{
+    BOOL be = FALSE, utf16 = FALSE;
+    int n;
+
+    *text = NULL;
+    if (encoding < 0)
+    {
+        if (size >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf) { data += 3; size -= 3; }
+        else if (size >= 2 && data[0] == 0xff && data[1] == 0xfe) { data += 2; size -= 2; utf16 = TRUE; }
+        else if (size >= 2 && data[0] == 0xfe && data[1] == 0xff) { data += 2; size -= 2; utf16 = be = TRUE; }
+    }
+    else if (encoding == UnicodeEncoding_Utf8)
+    {
+        if (size >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf) { data += 3; size -= 3; }
+    }
+    else
+    {
+        utf16 = TRUE;
+        be = encoding == UnicodeEncoding_Utf16BE;
+        if (size >= 2 && ((!be && data[0] == 0xff && data[1] == 0xfe) || (be && data[0] == 0xfe && data[1] == 0xff)))
+        {
+            data += 2;
+            size -= 2;
+        }
+    }
+
+    if (utf16)
+    {
+        DWORD i, count = size / 2;
+
+        if (!(*text = malloc( (count + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+        for (i = 0; i < count; i++)
+            (*text)[i] = be ? (data[2 * i] << 8) | data[2 * i + 1] : data[2 * i] | (data[2 * i + 1] << 8);
+        (*text)[count] = 0;
+        *length = count;
+        return S_OK;
+    }
+
+    n = size ? MultiByteToWideChar( CP_UTF8, 0, (const char *)data, size, NULL, 0 ) : 0;
+    if (!(*text = malloc( (n + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    if (n) MultiByteToWideChar( CP_UTF8, 0, (const char *)data, size, *text, n );
+    (*text)[n] = 0;
+    *length = n;
+    return S_OK;
+}
+
+/* the bytes of text in an encoding (no byte order mark) */
+static HRESULT encode_text( const WCHAR *text, DWORD length, int encoding, BYTE **data, DWORD *size )
+{
+    DWORD i;
+
+    *data = NULL;
+    *size = 0;
+    if (encoding == UnicodeEncoding_Utf8)
+    {
+        int n = length ? WideCharToMultiByte( CP_UTF8, 0, text, length, NULL, 0, NULL, NULL ) : 0;
+
+        if (!(*data = malloc( n ? n : 1 ))) return E_OUTOFMEMORY;
+        if (n) WideCharToMultiByte( CP_UTF8, 0, text, length, (char *)*data, n, NULL, NULL );
+        *size = n;
+        return S_OK;
+    }
+    if (!(*data = malloc( length ? length * 2 : 1 ))) return E_OUTOFMEMORY;
+    for (i = 0; i < length; i++)
+    {
+        if (encoding == UnicodeEncoding_Utf16BE) { (*data)[2 * i] = text[i] >> 8; (*data)[2 * i + 1] = text[i] & 0xff; }
+        else { (*data)[2 * i] = text[i] & 0xff; (*data)[2 * i + 1] = text[i] >> 8; }
+    }
+    *size = length * 2;
+    return S_OK;
+}
+
+static BOOL valid_encoding( int encoding )
+{
+    return encoding == UnicodeEncoding_Utf8 || encoding == UnicodeEncoding_Utf16LE || encoding == UnicodeEncoding_Utf16BE;
+}
+
+/*
+ * a vector of strings (the lines of a file) with its view and iterator
+ */
+
+struct strings
+{
+    HSTRING *items;
+    UINT32 count, capacity;
+};
+
+static void strings_free( struct strings *s )
+{
+    UINT32 i;
+    for (i = 0; i < s->count; i++) WindowsDeleteString( s->items[i] );
+    free( s->items );
+    s->items = NULL;
+    s->count = s->capacity = 0;
+}
+
+static HRESULT strings_insert( struct strings *s, UINT32 index, HSTRING value )
+{
+    HSTRING copy = NULL;
+    HRESULT hr;
+
+    if (index > s->count) return E_BOUNDS;
+    if (FAILED( hr = WindowsDuplicateString( value, &copy ) )) return hr;
+    if (s->count == s->capacity)
+    {
+        UINT32 capacity = s->capacity ? s->capacity * 2 : 16;
+        HSTRING *grown = realloc( s->items, capacity * sizeof(*grown) );
+
+        if (!grown) { WindowsDeleteString( copy ); return E_OUTOFMEMORY; }
+        s->items = grown;
+        s->capacity = capacity;
+    }
+    memmove( &s->items[index + 1], &s->items[index], (s->count - index) * sizeof(*s->items) );
+    s->items[index] = copy;
+    s->count++;
+    return S_OK;
+}
+
+static HRESULT strings_copy( const struct strings *src, struct strings *dst )
+{
+    UINT32 i;
+    HRESULT hr;
+
+    memset( dst, 0, sizeof(*dst) );
+    for (i = 0; i < src->count; i++)
+        if (FAILED( hr = strings_insert( dst, dst->count, src->items[i] ) )) { strings_free( dst ); return hr; }
+    return S_OK;
+}
+
+struct string_vector
+{
+    IVector_HSTRING IVector_iface;
+    IIterable_HSTRING IIterable_iface;
+    LONG ref;
+    struct strings s;
+};
+
+struct string_view
+{
+    IVectorView_HSTRING IVectorView_iface;
+    IIterable_HSTRING IIterable_iface;
+    LONG ref;
+    struct strings s;
+};
+
+struct string_iterator
+{
+    IIterator_HSTRING IIterator_iface;
+    LONG ref;
+    struct strings s;
+    UINT32 pos;
+};
+
+static HRESULT string_iterator_create( const struct strings *s, IIterator_HSTRING **out );
+
+static HRESULT inspectable_ids( ULONG *count, IID **iids, const IID *const *list, ULONG n )
+{
+    ULONG i;
+
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    if (!(*iids = CoTaskMemAlloc( n * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < n; i++) (*iids)[i] = *list[i];
+    *count = n;
+    return S_OK;
+}
+
+static HRESULT inspectable_class( const WCHAR *name, HSTRING *out )
+{
+    if (!out) return E_POINTER;
+    return WindowsCreateString( name, wcslen( name ), out );
+}
+
+/* the iterator */
+
+static inline struct string_iterator *impl_from_IIterator( IIterator_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct string_iterator, IIterator_iface );
+}
+
+static HRESULT WINAPI iterator_QueryInterface( IIterator_HSTRING *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterator_HSTRING ))
+    {
+        IIterator_HSTRING_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI iterator_AddRef( IIterator_HSTRING *iface )
+{
+    return InterlockedIncrement( &impl_from_IIterator( iface )->ref );
+}
+
+static ULONG WINAPI iterator_Release( IIterator_HSTRING *iface )
+{
+    struct string_iterator *impl = impl_from_IIterator( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        strings_free( &impl->s );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI iterator_GetIids( IIterator_HSTRING *iface, ULONG *count, IID **iids )
+{
+    const IID *const list[] = { &IID_IIterator_HSTRING };
+    return inspectable_ids( count, iids, list, 1 );
+}
+
+static HRESULT WINAPI iterator_GetRuntimeClassName( IIterator_HSTRING *iface, HSTRING *name )
+{
+    return inspectable_class( L"Windows.Foundation.Collections.IIterator`1<String>", name );
+}
+
+static HRESULT WINAPI iterator_GetTrustLevel( IIterator_HSTRING *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_get_Current( IIterator_HSTRING *iface, HSTRING *value )
+{
+    struct string_iterator *impl = impl_from_IIterator( iface );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (impl->pos >= impl->s.count) return E_BOUNDS;
+    return WindowsDuplicateString( impl->s.items[impl->pos], value );
+}
+
+static HRESULT WINAPI iterator_get_HasCurrent( IIterator_HSTRING *iface, boolean *value )
+{
+    struct string_iterator *impl = impl_from_IIterator( iface );
+
+    if (!value) return E_POINTER;
+    *value = impl->pos < impl->s.count;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_MoveNext( IIterator_HSTRING *iface, boolean *value )
+{
+    struct string_iterator *impl = impl_from_IIterator( iface );
+
+    if (!value) return E_POINTER;
+    if (impl->pos < impl->s.count) impl->pos++;
+    *value = impl->pos < impl->s.count;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetMany( IIterator_HSTRING *iface, UINT32 size, HSTRING *items, UINT32 *actual )
+{
+    struct string_iterator *impl = impl_from_IIterator( iface );
+    UINT32 n = 0;
+
+    if (!actual) return E_POINTER;
+    while (n < size && impl->pos < impl->s.count)
+    {
+        HRESULT hr = WindowsDuplicateString( impl->s.items[impl->pos], &items[n] );
+        if (FAILED( hr ))
+        {
+            while (n) WindowsDeleteString( items[--n] );
+            *actual = 0;
+            return hr;
+        }
+        n++;
+        impl->pos++;
+    }
+    *actual = n;
+    return S_OK;
+}
+
+static const IIterator_HSTRINGVtbl iterator_vtbl =
+{
+    iterator_QueryInterface, iterator_AddRef, iterator_Release,
+    iterator_GetIids, iterator_GetRuntimeClassName, iterator_GetTrustLevel,
+    iterator_get_Current, iterator_get_HasCurrent, iterator_MoveNext, iterator_GetMany,
+};
+
+static HRESULT string_iterator_create( const struct strings *s, IIterator_HSTRING **out )
+{
+    struct string_iterator *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IIterator_iface.lpVtbl = &iterator_vtbl;
+    impl->ref = 1;
+    if (FAILED( hr = strings_copy( s, &impl->s ) ))
+    {
+        free( impl );
+        return hr;
+    }
+    *out = &impl->IIterator_iface;
+    return S_OK;
+}
+
+/* the read-only view */
+
+static inline struct string_view *view_from_IVectorView( IVectorView_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct string_view, IVectorView_iface );
+}
+
+static inline struct string_view *view_from_IIterable( IIterable_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct string_view, IIterable_iface );
+}
+
+static HRESULT WINAPI view_QueryInterface( IVectorView_HSTRING *iface, REFIID iid, void **out )
+{
+    struct string_view *impl = view_from_IVectorView( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IVectorView_HSTRING ))
+        *out = &impl->IVectorView_iface;
+    else if (IsEqualGUID( iid, &IID_IIterable_HSTRING ))
+        *out = &impl->IIterable_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI view_AddRef( IVectorView_HSTRING *iface )
+{
+    return InterlockedIncrement( &view_from_IVectorView( iface )->ref );
+}
+
+static ULONG WINAPI view_Release( IVectorView_HSTRING *iface )
+{
+    struct string_view *impl = view_from_IVectorView( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        strings_free( &impl->s );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI view_GetIids( IVectorView_HSTRING *iface, ULONG *count, IID **iids )
+{
+    const IID *const list[] = { &IID_IVectorView_HSTRING, &IID_IIterable_HSTRING };
+    return inspectable_ids( count, iids, list, 2 );
+}
+
+static HRESULT WINAPI view_GetRuntimeClassName( IVectorView_HSTRING *iface, HSTRING *name )
+{
+    return inspectable_class( L"Windows.Foundation.Collections.IVectorView`1<String>", name );
+}
+
+static HRESULT WINAPI view_GetTrustLevel( IVectorView_HSTRING *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT strings_get_at( const struct strings *s, UINT32 index, HSTRING *value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (index >= s->count) return E_BOUNDS;
+    return WindowsDuplicateString( s->items[index], value );
+}
+
+static HRESULT strings_index_of( const struct strings *s, HSTRING element, UINT32 *index, boolean *found )
+{
+    UINT32 i;
+    INT32 cmp;
+
+    if (!index || !found) return E_POINTER;
+    *index = 0;
+    *found = FALSE;
+    for (i = 0; i < s->count; i++)
+        if (SUCCEEDED( WindowsCompareStringOrdinal( element, s->items[i], &cmp ) ) && !cmp)
+        {
+            *index = i;
+            *found = TRUE;
+            break;
+        }
+    return S_OK;
+}
+
+static HRESULT strings_get_many( const struct strings *s, UINT32 start, UINT32 size, HSTRING *items, UINT32 *actual )
+{
+    UINT32 n = 0;
+
+    if (!actual) return E_POINTER;
+    *actual = 0;
+    if (start > s->count) return E_BOUNDS;
+    while (n < size && start + n < s->count)
+    {
+        HRESULT hr = WindowsDuplicateString( s->items[start + n], &items[n] );
+        if (FAILED( hr ))
+        {
+            while (n) WindowsDeleteString( items[--n] );
+            return hr;
+        }
+        n++;
+    }
+    *actual = n;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_GetAt( IVectorView_HSTRING *iface, UINT32 index, HSTRING *value )
+{
+    return strings_get_at( &view_from_IVectorView( iface )->s, index, value );
+}
+
+static HRESULT WINAPI view_get_Size( IVectorView_HSTRING *iface, UINT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = view_from_IVectorView( iface )->s.count;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_IndexOf( IVectorView_HSTRING *iface, HSTRING element, UINT32 *index, boolean *found )
+{
+    return strings_index_of( &view_from_IVectorView( iface )->s, element, index, found );
+}
+
+static HRESULT WINAPI view_GetMany( IVectorView_HSTRING *iface, UINT32 start, UINT32 size, HSTRING *items, UINT32 *actual )
+{
+    return strings_get_many( &view_from_IVectorView( iface )->s, start, size, items, actual );
+}
+
+static const IVectorView_HSTRINGVtbl view_vtbl =
+{
+    view_QueryInterface, view_AddRef, view_Release,
+    view_GetIids, view_GetRuntimeClassName, view_GetTrustLevel,
+    view_GetAt, view_get_Size, view_IndexOf, view_GetMany,
+};
+
+static HRESULT WINAPI view_iterable_QueryInterface( IIterable_HSTRING *iface, REFIID iid, void **out )
+{
+    return view_QueryInterface( &view_from_IIterable( iface )->IVectorView_iface, iid, out );
+}
+
+static ULONG WINAPI view_iterable_AddRef( IIterable_HSTRING *iface )
+{
+    return view_AddRef( &view_from_IIterable( iface )->IVectorView_iface );
+}
+
+static ULONG WINAPI view_iterable_Release( IIterable_HSTRING *iface )
+{
+    return view_Release( &view_from_IIterable( iface )->IVectorView_iface );
+}
+
+static HRESULT WINAPI view_iterable_GetIids( IIterable_HSTRING *iface, ULONG *count, IID **iids )
+{
+    return view_GetIids( &view_from_IIterable( iface )->IVectorView_iface, count, iids );
+}
+
+static HRESULT WINAPI view_iterable_GetRuntimeClassName( IIterable_HSTRING *iface, HSTRING *name )
+{
+    return view_GetRuntimeClassName( &view_from_IIterable( iface )->IVectorView_iface, name );
+}
+
+static HRESULT WINAPI view_iterable_GetTrustLevel( IIterable_HSTRING *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_iterable_First( IIterable_HSTRING *iface, IIterator_HSTRING **value )
+{
+    if (!value) return E_POINTER;
+    return string_iterator_create( &view_from_IIterable( iface )->s, value );
+}
+
+static const IIterable_HSTRINGVtbl view_iterable_vtbl =
+{
+    view_iterable_QueryInterface, view_iterable_AddRef, view_iterable_Release,
+    view_iterable_GetIids, view_iterable_GetRuntimeClassName, view_iterable_GetTrustLevel,
+    view_iterable_First,
+};
+
+/* the vector */
+
+static inline struct string_vector *vec_from_IVector( IVector_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct string_vector, IVector_iface );
+}
+
+static inline struct string_vector *vec_from_IIterable( IIterable_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct string_vector, IIterable_iface );
+}
+
+static HRESULT WINAPI vec_QueryInterface( IVector_HSTRING *iface, REFIID iid, void **out )
+{
+    struct string_vector *impl = vec_from_IVector( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IVector_HSTRING ))
+        *out = &impl->IVector_iface;
+    else if (IsEqualGUID( iid, &IID_IIterable_HSTRING ))
+        *out = &impl->IIterable_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
