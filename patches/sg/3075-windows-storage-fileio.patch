index c2f0326..9be1034 100644
--- a/dlls/windows.storage/Makefile.in
+++ b/dlls/windows.storage/Makefile.in
@@ -1,10 +1,11 @@
 MODULE  = windows.storage.dll
-IMPORTS = combase shell32 advapi32 userenv
+IMPORTS = combase shell32 advapi32 userenv shlwapi
 
 SOURCES = \
 	async.c \
 	buffer.c \
 	collections.c \
