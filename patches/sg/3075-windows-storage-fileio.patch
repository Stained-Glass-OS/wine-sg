+/* the file a URI names, for the schemes whose data is a local file */
+static HRESULT streamed_uri_source( IUriRuntimeClass *uri, WCHAR **path )
+{
+    HSTRING str = NULL;
+    const WCHAR *url;
+    HRESULT hr;
+
+    *path = NULL;
+    if (!uri) return E_INVALIDARG;
+    if (FAILED( hr = IUriRuntimeClass_get_AbsoluteUri( uri, &str ) )) return hr;
+    url = WindowsGetStringRawBuffer( str, NULL );
+    if (!wcsnicmp( url, L"file:", 5 ))
+    {
+        WCHAR buffer[MAX_PATH];
+        DWORD len = ARRAY_SIZE(buffer);
+
+        if (SUCCEEDED( hr = PathCreateFromUrlW( url, buffer, &len, 0 ) ))
+            hr = (*path = wcsdup( buffer )) ? S_OK : E_OUTOFMEMORY;
+    }
+    else if (!wcsnicmp( url, L"ms-appx:", 8 ) || !wcsnicmp( url, L"ms-appdata:", 11 ))
+        hr = app_uri_path( url, path );
+    else
+    {
+        WARN( "scheme of %s not supported.\n", debugstr_w( url ) );
+        hr = HR_NOT_SUPPORTED;      /* no network fetch */
+    }
+    WindowsDeleteString( str );
+    return hr;
+}
+
+static HRESULT streamed_from_uri( HSTRING name, IStorageFile *replace, IUriRuntimeClass *uri,
+                                  IAsyncOperation_StorageFile **operation )
+{
+    IUnknown *file = NULL;
+    WCHAR *source = NULL, *target = NULL;
+    HRESULT hr;
