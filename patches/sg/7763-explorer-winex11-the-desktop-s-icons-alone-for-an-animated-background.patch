From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer, winex11: the desktop's icons alone, for an animated background

Under an animated background (Living glass, the light) the desktop's compositor drew the icons as
the pixels where the desktop's picture is not the wallpaper, so a selected icon's see-through box
showed the still wallpaper in it over the moving glass. explorer now draws the icons, their boxes
and the rubber band once on black and once on white, works out how see-through each pixel is, and
sends them as a premultiplied picture (X11DRV_SG_DESKTOP_ICONS, _SG_ICONS_PIXMAP) that sg-deskcomp
lays over the moving background.
---
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -346,6 +346,7 @@
     X11DRV_SG_DESKTOP_WALLPAPER = 0x5348,  /* Stained Glass OS: the desktop's picture without its icons */
     X11DRV_SG_DESKTOP_PART = 0x5349,       /* Stained Glass OS: a part of the desktop's picture, drawn again */
     X11DRV_SG_PRINT_FRAMES = 0x534a,       /* Stained Glass OS: a window's swap chains' frames, into its picture */
+    X11DRV_SG_DESKTOP_ICONS = 0x534b,      /* Stained Glass OS: a part of the desktop's icons, on nothing */
 };
 
 /* PrintWindow with PW_RENDERFULLCONTENT (wine-sg 6501): what HWND, a top-level of this
@@ -393,6 +394,13 @@
     const void              *bits;
 };
 
+/* X11DRV_SG_DESKTOP_ICONS takes the same: a rectangle of the desktop's icons,
+ * their boxes and the rubber band on nothing, 32-bit top-down premultiplied
+ * BGRA, put into _SG_ICONS_PIXMAP -- a 32-bit picture the size of the
+ * desktop's -- which the desktop's compositor lays over an animated
+ * background (the selected icons' see-through boxes showed the still
+ * wallpaper through them). */
+
 struct x11drv_escape_set_drawable
 {
     enum x11drv_escape_codes code;         /* escape code (X11DRV_SET_DRAWABLE) */
diff --git a/dlls/winex11.drv/init.c b/dlls/winex11.drv/init.c
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -387,6 +387,55 @@
     return TRUE;
 }
 
+/* Stained Glass OS: the desktop's icons alone, see-through where there are
+ * none (struct x11drv_escape_sg_background_part, X11DRV_SG_DESKTOP_ICONS):
+ * a part put into the 32-bit picture named on the desktop window as
+ * _SG_ICONS_PIXMAP, made again, clear, when the desktop's size changes */
+static BOOL set_desktop_icons( const struct x11drv_escape_sg_background_part *part )
+{
+    static Pixmap icons;
+    static int icons_width, icons_height;
+    static Atom prop;
+    XImage *image;
+    GC gc;
+
+    if (!desktop_pixmap || !is_virtual_desktop() || root_window == DefaultRootWindow( gdi_display )) return FALSE;
+    if (!argb_visual.visual || argb_visual.depth != 32) return FALSE;
+    if (!part->bits || part->width <= 0 || part->height <= 0 || part->x < 0 || part->y < 0 ||
+        part->x + part->width > desktop_pixmap_width || part->y + part->height > desktop_pixmap_height)
+        return FALSE;
+    if (!(image = XCreateImage( gdi_display, argb_visual.visual, 32, ZPixmap, 0,
+                                (char *)part->bits, part->width, part->height, 32, part->width * 4 )))
+        return FALSE;
+    if (image->bits_per_pixel != 32 || image->byte_order != LSBFirst)
+    {
+        image->data = NULL;
+        XDestroyImage( image );
+        return FALSE;
+    }
+    if (!icons || icons_width != desktop_pixmap_width || icons_height != desktop_pixmap_height)
+    {
+        Pixmap pixmap = XCreatePixmap( gdi_display, root_window, desktop_pixmap_width, desktop_pixmap_height, 32 );
+        gc = XCreateGC( gdi_display, pixmap, 0, NULL );
+        XSetForeground( gdi_display, gc, 0 );
+        XFillRectangle( gdi_display, pixmap, gc, 0, 0, desktop_pixmap_width, desktop_pixmap_height );
+        XFreeGC( gdi_display, gc );
+        if (!prop) prop = XInternAtom( gdi_display, "_SG_ICONS_PIXMAP", False );
+        XChangeProperty( gdi_display, root_window, prop, XA_PIXMAP, 32, PropModeReplace, (unsigned char *)&pixmap, 1 );
+        if (icons) XFreePixmap( gdi_display, icons );
+        icons = pixmap;
+        icons_width = desktop_pixmap_width;
+        icons_height = desktop_pixmap_height;
+    }
+    gc = XCreateGC( gdi_display, icons, 0, NULL );
+    XPutImage( gdi_display, icons, gc, image, 0, 0, part->x, part->y, part->width, part->height );
+    XFreeGC( gdi_display, gc );
+    XFlush( gdi_display );
+    image->data = NULL;
+    XDestroyImage( image );
+    return TRUE;
+}
+
 static INT X11DRV_ExtEscape( PHYSDEV dev, INT escape, INT in_count, LPCVOID in_data,
                              INT out_count, LPVOID out_data )
 {
@@ -451,6 +500,10 @@
                 if (in_count >= sizeof(struct x11drv_escape_sg_background))
                     return set_desktop_wallpaper( in_data );
                 break;
+            case X11DRV_SG_DESKTOP_ICONS:
+                if (in_count >= sizeof(struct x11drv_escape_sg_background_part))
+                    return set_desktop_icons( in_data );
+                break;
             case X11DRV_START_EXPOSURES:
                 XSetGraphicsExposures( gdi_display, physDev->gc, True );
                 physDev->exposures = 0;
diff --git a/programs/explorer/desktop.c b/programs/explorer/desktop.c
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -1801,6 +1801,8 @@
 }
 
 static void sg_background_later( HWND hwnd );
+static void sg_send_icons( HDC hdc, const RECT *r );
+static BOOL sg_animated_background;  /* an animated background is chosen: the icons go on their own too */
 
 /* draw the desktop now, before a menu's loop: UpdateWindow gives the desktop window
  * only WM_ERASEBKGND, and its WM_PAINT would wait for the menu to close */
@@ -1875,6 +1877,8 @@
         esc.height = rc.bottom;
         esc.bits = bits;
         ExtEscape( hdc, 6789 /* X11DRV_ESCAPE */, sizeof(esc), (const char *)&esc, 0, NULL );
+        sg_animated_background = animated != 0;
+        if (animated) sg_send_icons( hdc, &rc );
         SelectObject( mem, old );
         DeleteObject( dib );
     }
@@ -1896,6 +1900,71 @@
     const void *bits;            /* 32-bit, top-down */
 };
 
+/* Stained Glass OS: the icons alone, for an animated background (the desktop's
+ * compositor draws it moving and lays them over it): a rectangle of them, of
+ * their boxes and of the rubber band, drawn once on black and once on white
+ * -- how much of the white shows through a pixel is how see-through it is --
+ * and sent as a premultiplied picture (X11DRV_SG_DESKTOP_ICONS). The icons
+ * were the pixels where the desktop's picture is not the wallpaper, so a
+ * selected icon's see-through box showed the still wallpaper in it, over
+ * the moving one (David 2026-11-13: "the wrong background"). */
+static void sg_send_icons( HDC hdc, const RECT *r )
+{
+    BITMAPINFO bi = {{ sizeof(BITMAPINFOHEADER) }};
+    struct sg_background_part_escape esc;
+    int w = r->right - r->left, h = r->bottom - r->top, i;
+    HBITMAP dib[2] = { 0, 0 };
+    DWORD *bits[2];
+    HDC mem;
+
+#ifdef SG_MUTANT_NO_ICON_LAYER
+    return;
+#endif
+    if (w <= 0 || h <= 0) return;
+    bi.bmiHeader.biWidth = w;
+    bi.bmiHeader.biHeight = -h;
+    bi.bmiHeader.biPlanes = 1;
+    bi.bmiHeader.biBitCount = 32;
+    bi.bmiHeader.biCompression = BI_RGB;
+    if (!(mem = CreateCompatibleDC( hdc ))) return;
+    for (i = 0; i < 2; i++)
+    {
+        HGDIOBJ old;
+        if (!(dib[i] = CreateDIBSection( hdc, &bi, DIB_RGB_COLORS, (void **)&bits[i], NULL, 0 ))) goto done;
+        old = SelectObject( mem, dib[i] );
+        SetWindowOrgEx( mem, r->left, r->top, NULL );
+        FillRect( mem, r, GetStockObject( i ? WHITE_BRUSH : BLACK_BRUSH ) );
+        draw_launchers( mem, *r );
+        GdiFlush();
+        SelectObject( mem, old );
+    }
+    for (i = 0; i < w * h; i++)
+    {
+        DWORD b = bits[0][i], wh = bits[1][i], out = 0;
+        /* on white less what it is on black is what shows through */
+        int through = ((int)(wh & 0xff) - (int)(b & 0xff) + (int)((wh >> 8) & 0xff) - (int)((b >> 8) & 0xff) +
+                       (int)((wh >> 16) & 0xff) - (int)((b >> 16) & 0xff)) / 3;
+        int alpha = 255 - (through < 0 ? 0 : through > 255 ? 255 : through), c, shift;
+        /* on black it is its colour times its alpha already */
+        for (shift = 0; shift < 24; shift += 8)
+        {
+            c = (b >> shift) & 0xff;
+            out |= (DWORD)(c > alpha ? alpha : c) << shift;
+        }
+        bits[0][i] = out | (DWORD)alpha << 24;
+    }
+    esc.code = 0x534b;
+    esc.x = r->left;
+    esc.y = r->top;
+    esc.width = w;
+    esc.height = h;
+    esc.bits = bits[0];
+    ExtEscape( hdc, 6789 /* X11DRV_ESCAPE */, sizeof(esc), (const char *)&esc, 0, NULL );
+done:
+    for (i = 0; i < 2; i++) if (dib[i]) DeleteObject( dib[i] );
+    DeleteDC( mem );
+}
+
 static void sg_redraw( HWND hwnd, const RECT *dirty )
 {
     BITMAPINFO bi = {{ sizeof(BITMAPINFOHEADER) }};
@@ -1932,6 +2001,7 @@
             published = ExtEscape( hdc, 6789 /* X11DRV_ESCAPE */, sizeof(esc), (const char *)&esc, 0, NULL ) > 0;
         }
 #endif
+        if (published && sg_animated_background) sg_send_icons( hdc, &r );
         SelectObject( mem, old );
         DeleteObject( bmp );
     }
