@@ -1566,7 +1574,7 @@ static struct token *token_create_for_uid_ex( unsigned primary, int impersonatio
         /* admins last, so it can be dropped by shortening the count */
         { &alias_admins_sid, SE_GROUP_ENABLED|SE_GROUP_ENABLED_BY_DEFAULT|SE_GROUP_MANDATORY|SE_GROUP_OWNER },
     };
-    unsigned int group_count = ARRAY_SIZE( groups ) - (is_admin ? 0 : 1);
