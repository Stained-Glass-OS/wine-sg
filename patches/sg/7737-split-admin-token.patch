+     * caller without SeTcbPrivilege an identification token too; using it (impersonation, a process)
+     * needs consent, which goes through the elevation broker. */
     if ((token = (struct token *)get_handle_obj( current->process, req->handle,
                                                  TOKEN_QUERY, &token_ops )))
