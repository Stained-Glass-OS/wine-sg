@@ -1717,7 +1733,9 @@ int token_sid_present( struct token *token, const struct sid *sid, int deny )
 
     LIST_FOR_EACH_ENTRY( group, &token->groups, struct group, entry )
     {
-        if (!(group->attrs & SE_GROUP_ENABLED)) continue;
+        /* a deny-only group (a filtered administrator's Administrators) is disabled, and still matches
+         * deny ACEs, as on Windows */
+        if (!(group->attrs & SE_GROUP_ENABLED) && !(deny && (group->attrs & SE_GROUP_USE_FOR_DENY_ONLY))) continue;
         if (!deny && (group->attrs & SE_GROUP_USE_FOR_DENY_ONLY)) continue;
         if (equal_sid( &group->sid, sid )) return TRUE;
     }
