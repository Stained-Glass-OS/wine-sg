     const struct sg_domain_name *domain_groups = NULL;
     unsigned int domain_count = sg_domain_groups( uid, &domain_groups ), i;
     struct sid_attrs *all_groups;
@@ -1583,6 +1591,14 @@ static struct token *token_create_for_uid_ex( unsigned primary, int impersonatio
