+/* a browser an elevated program starts (kernelbase's sg_browser_unelevated):
+ * 1, how to show it, the command line, the directory. The answer is the
+ * error and the new process's and thread's ids; they stay open here until
+ * the program that asked has opened them, so the ids are not reused. */
+static void start_for_elevated( HANDLE pipe, const WCHAR *request, DWORD count )
+{
+    struct { DWORD error, pid, tid; } answer = { ERROR_INVALID_PARAMETER };
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi = { 0 };
+    const WCHAR *cmdline, *dir, *end = request + count;
+    WCHAR *cmd = NULL;
+    DWORD done, opened = 0;
+
+    cmdline = dir = request + 2;
+    if (count >= 4 && request[count - 1] == 0)
+        while (dir < end && *dir) dir++;
+    if (count >= 4 && request[count - 1] == 0 && ++dir < end && (cmd = wcsdup( cmdline )))
+    {
+        if (request[1] != 0xffff)
+        {
+            si.dwFlags = STARTF_USESHOWWINDOW;
+            si.wShowWindow = request[1];
+        }
+        TRACE( "starting %s for an elevated program\n", debugstr_w(cmd) );
+        if (CreateProcessW( NULL, cmd, NULL, NULL, FALSE, 0, NULL, *dir ? dir : NULL, &si, &pi ))
+        {
+            answer.error = 0;
+            answer.pid = pi.dwProcessId;
+            answer.tid = pi.dwThreadId;
+        }
+        else answer.error = GetLastError();
+        free( cmd );
+    }
+    WriteFile( pipe, &answer, sizeof(answer), &done, NULL );
+    FlushFileBuffers( pipe );
+    if (!answer.error) ReadFile( pipe, &opened, sizeof(opened), &done, NULL );   /* or the asker is gone */
+    if (pi.hProcess) CloseHandle( pi.hProcess );
+    if (pi.hThread) CloseHandle( pi.hThread );
+}
+
