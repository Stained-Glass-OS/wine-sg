From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: SetEntriesInAclW builds the ACL as Windows does

Every new ACE went in front of the old ones, whatever its kind: a grant
landed before an older deny and overrode it (installers and tools that
grant a group access to a folder with SetEntriesInAcl + SetNamedSecurityInfo
silently lifted denies); SET_ACCESS kept the trustee's denied ACEs where it
"discards any existing access control information for the trustee";
GRANT_ACCESS added a second allowed ACE beside the trustee's old one; and
REVOKE_ACCESS logged "unhandled access mode 4" on every call (559 hits).

New denies now go first and new grants after the old leading denies, so a
canonical ACL stays canonical; the old ACEs keep their order (Wine's
GetExplicitEntriesFromAcl test, written against Windows, expects that).
SET_ACCESS discards the trustee's explicit allowed and denied ACEs,
REVOKE_ACCESS its allowed and audit ACEs (denies stay), GRANT_ACCESS and
DENY_ACCESS fold its allowed (denied) ACE with the same inheritance into
the new one. Inherited ACEs are never touched.

Wine's advapi32 security tests: the same failures as before, no new ones.

Gate: test/aclentries-gate.sh. Mutant SG_MUTANT_OLD_ACL_MERGE
(advapi32/security.c).
---
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -2455,6 +2455,135 @@ DWORD WINAPI SetEntriesInAclW( ULONG count, PEXPLICIT_ACCESSW pEntries,
         ret = RtlNtStatusToDosError(status);
         goto exit;
     }
+#ifndef SG_MUTANT_OLD_ACL_MERGE
+    /* As Windows builds it: new denies first, new grants after the old
+     * leading denies (so a canonical ACL stays canonical), the old ACEs in
+     * their order. An entry for a trustee replaces or folds in that
+     * trustee's explicit ACEs: SET_ACCESS discards its allowed and denied
+     * ACEs, REVOKE_ACCESS its allowed and audit ACEs, GRANT_ACCESS and
+     * DENY_ACCESS fold its allowed (denied) ACEs with the same inheritance
+     * into the new one. Before, every new ACE went in front of the old ones:
+     * a grant landed before an older deny and overrode it, SET_ACCESS kept
+     * the trustee's denies, and REVOKE_ACCESS logged a FIXME. */
+    {
+        ACCESS_MASK *merged = calloc( count ? count : 1, sizeof(ACCESS_MASK) );
+        ULONG pass, j, split;
+        const ACE_HEADER *ace;
+        BOOL *drop = NULL;
+        ULONG old_count = 0;
+
+        if (OldAcl)
+        {
+            ACL_SIZE_INFORMATION size_info;
+            if (!RtlQueryInformationAcl( OldAcl, &size_info, sizeof(size_info), AclSizeInformation ))
+                old_count = size_info.AceCount;
+        }
+        drop = calloc( old_count ? old_count : 1, sizeof(BOOL) );
+        if (!merged || !drop)
+        {
+            free( merged );
+            free( drop );
+            ret = ERROR_OUTOFMEMORY;
+            goto exit;
+        }
+
+        /* which old explicit ACEs the entries replace or fold in */
+        for (j = 0; j < old_count; j++)
+        {
+            const SID *sid;
+
+            if (RtlGetAce( OldAcl, j, (void **)&ace )) break;
+            if (ace->AceFlags & INHERITED_ACE) continue;
+            if (ace->AceType != ACCESS_ALLOWED_ACE_TYPE && ace->AceType != ACCESS_DENIED_ACE_TYPE &&
+                ace->AceType != SYSTEM_AUDIT_ACE_TYPE && ace->AceType != SYSTEM_ALARM_ACE_TYPE)
+                continue;
+            sid = (const SID *)&((const ACCESS_ALLOWED_ACE *)ace)->SidStart;
+            for (i = 0; i < count && !drop[j]; i++)
+            {
+                if (!EqualSid( ppsid[i], (PSID)sid )) continue;
+                switch (pEntries[i].grfAccessMode)
+                {
+                case SET_ACCESS:
+                    drop[j] = ace->AceType == ACCESS_ALLOWED_ACE_TYPE || ace->AceType == ACCESS_DENIED_ACE_TYPE;
+                    break;
+                case REVOKE_ACCESS:
+                    drop[j] = ace->AceType == ACCESS_ALLOWED_ACE_TYPE || ace->AceType == SYSTEM_AUDIT_ACE_TYPE ||
+                              ace->AceType == SYSTEM_ALARM_ACE_TYPE;
+                    break;
+                case GRANT_ACCESS:
+                case DENY_ACCESS:
+                    if (ace->AceType == (pEntries[i].grfAccessMode == GRANT_ACCESS ? ACCESS_ALLOWED_ACE_TYPE
+                                                                                   : ACCESS_DENIED_ACE_TYPE) &&
+                        ace->AceFlags == (pEntries[i].grfInheritance & VALID_INHERIT_FLAGS))
+                    {
+                        merged[i] |= ((const ACCESS_ALLOWED_ACE *)ace)->Mask;
+                        drop[j] = TRUE;
+                    }
+                    break;
+                default:
+                    break;
+                }
+            }
+        }
+
+        /* the old ACEs keep their order: the new denies go in front, the
+         * new grants after the leading explicit denies */
+        for (split = 0; split < old_count; split++)
+        {
+            if (RtlGetAce( OldAcl, split, (void **)&ace )) break;
+            if (drop[split]) continue;
+            if ((ace->AceFlags & INHERITED_ACE) ||
+                (ace->AceType != ACCESS_DENIED_ACE_TYPE && ace->AceType != ACCESS_DENIED_OBJECT_ACE_TYPE))
+                break;
+        }
+        for (pass = 0; pass < 4 && status == STATUS_SUCCESS; pass++)
+        {
+            /* 0: new denies, 1: old leading denies, 2: new grants and audits, 3: the other old ACEs */
+            if (pass == 0 || pass == 2)
+            {
+                for (i = 0; i < count && status == STATUS_SUCCESS; i++)
+                {
+                    ACCESS_MASK mask = pEntries[i].grfAccessPermissions | merged[i];
+                    DWORD flags = pEntries[i].grfInheritance;
+
+                    switch (pEntries[i].grfAccessMode)
+                    {
+                    case DENY_ACCESS:
+                        if (pass == 0) status = RtlAddAccessDeniedAceEx( *NewAcl, ACL_REVISION, flags, mask, ppsid[i] );
+                        break;
+                    case GRANT_ACCESS:
+                    case SET_ACCESS:
+                        if (pass == 2) status = RtlAddAccessAllowedAceEx( *NewAcl, ACL_REVISION, flags, mask, ppsid[i] );
+                        break;
+                    case SET_AUDIT_SUCCESS:
+                    case SET_AUDIT_FAILURE:
+                        if (pass == 2)
+                            status = RtlAddAuditAccessAceEx( *NewAcl, ACL_REVISION, flags, mask, ppsid[i],
+                                                             pEntries[i].grfAccessMode == SET_AUDIT_SUCCESS,
+                                                             pEntries[i].grfAccessMode == SET_AUDIT_FAILURE );
+                        break;
+                    default:  /* REVOKE_ACCESS only removes */
+                        break;
+                    }
+                }
+                continue;
+            }
+            for (j = (pass == 1 ? 0 : split); j < (pass == 1 ? split : old_count) && status == STATUS_SUCCESS; j++)
+            {
+                if (RtlGetAce( OldAcl, j, (void **)&ace )) break;
+                if (drop[j]) continue;
+                status = RtlAddAce( *NewAcl, ACL_REVISION, MAXDWORD, (PACE_HEADER)ace, ace->AceSize );
+            }
+        }
+        free( merged );
+        free( drop );
+        if (status != STATUS_SUCCESS)
+        {
+            WARN("adding an ACE failed with error 0x%08lx\n", status);
+            ret = RtlNtStatusToDosError(status);
+        }
+    }
+#else
 
     for (i = 0; i < count; i++)
     {
@@ -2574,6 +2703,8 @@ DWORD WINAPI SetEntriesInAclW( ULONG count, PEXPLICIT_ACCESSW pEntries,
         }
     }
 
+#endif
+
 exit:
     free(ppsid);
     return ret;
