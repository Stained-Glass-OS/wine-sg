+/* The ProgId that is the default for an association at a level: the user's choice
+ * (AL_USER, and AL_EFFECTIVE first), else the machine's class default (extensions only;
+ * a protocol has no machine ProgId, only the user's choice). */
+static BOOL assoc_progid_at_level(const WCHAR *assoc, ASSOCIATIONLEVEL level, WCHAR *progid, DWORD len)
+{
+    WCHAR key[MAX_PATH + 20];
+    DWORD size = len * sizeof(WCHAR);
+
+    if (level != AL_MACHINE && SHELL_GetUserChoice(assoc, progid, len)) return TRUE;
+    if (level == AL_USER || *assoc != '.' || wcslen(assoc) > MAX_PATH) return FALSE;
+    swprintf(key, ARRAY_SIZE(key), L"Software\\Classes\\%s", assoc);
+    return !RegGetValueW(HKEY_LOCAL_MACHINE, key, NULL, RRF_RT_REG_SZ, NULL, progid, &size) && *progid;
+}
+
+/* The default client of a kind (StartMenuInternet, Mail...) at a level. */
+static BOOL client_at_level(const WCHAR *kind, ASSOCIATIONLEVEL level, WCHAR *name, DWORD len)
+{
+    WCHAR key[MAX_PATH + 20];
+    DWORD size = len * sizeof(WCHAR);
+
+    if (!*kind || wcschr(kind, '\\') || wcslen(kind) > MAX_PATH) return FALSE;
+    swprintf(key, ARRAY_SIZE(key), L"Software\\Clients\\%s", kind);
+    if (level != AL_MACHINE && !RegGetValueW(HKEY_CURRENT_USER, key, NULL, RRF_RT_REG_SZ, NULL, name, &size) && *name)
+        return TRUE;
+    if (level == AL_USER) return FALSE;
+    size = len * sizeof(WCHAR);
+    return !RegGetValueW(HKEY_LOCAL_MACHINE, key, NULL, RRF_RT_REG_SZ, NULL, name, &size) && *name;
+}
+
 static HRESULT WINAPI ApplicationAssociationRegistration_QueryAppIsDefault(IApplicationAssociationRegistration* This, LPCWSTR query,
                                                                            ASSOCIATIONTYPE type, ASSOCIATIONLEVEL level, LPCWSTR appname, BOOL *is_default)
 {
-    FIXME("(%p)->(%s, %d, %d, %s, %p)\n", This, debugstr_w(query), type, level, debugstr_w(appname), is_default);
-    return E_NOTIMPL;
+    WCHAR progid[MAX_PATH], cur[MAX_PATH];
+
+    TRACE("(%p)->(%s, %d, %d, %s, %p)\n", This, debugstr_w(query), type, level, debugstr_w(appname), is_default);
+
+    if (!query || !appname || !is_default) return E_INVALIDARG;
+    *is_default = FALSE;
+    if (level != AL_MACHINE && level != AL_EFFECTIVE && level != AL_USER) return E_INVALIDARG;
+#ifdef SG_MUTANT_QUERYAPP
+    return S_OK;
+#endif
+
+    switch (type)
+    {
+    case AT_STARTMENUCLIENT:
+        if (!*query || wcschr(query, '\\')) return E_INVALIDARG;
+        *is_default = client_at_level(query, level, cur, ARRAY_SIZE(cur)) && !wcsicmp(cur, appname);
+        return S_OK;
+
+    case AT_FILEEXTENSION:
+        if (query[0] != '.') return E_INVALIDARG;
+        /* fall through */
+    case AT_URLPROTOCOL:
+        if (!*query) return E_INVALIDARG;
+        if (FAILED(lookup_registered_app_progid(appname, type == AT_URLPROTOCOL, query, progid, ARRAY_SIZE(progid))))
+            return S_OK; /* the application does not declare it, so it is not the default */
+        *is_default = assoc_progid_at_level(query, level, cur, ARRAY_SIZE(cur)) && !wcsicmp(cur, progid);
+        return S_OK;
+
+    case AT_MIMETYPE:
+    {
+        static const HKEY roots[] = { HKEY_CURRENT_USER, HKEY_LOCAL_MACHINE };
+        WCHAR caps[MAX_PATH], assoc_path[MAX_PATH + 32], path[MAX_PATH + 128];
+        DWORD size, i;
+        BOOL found = FALSE;
+
+        if (!*query) return E_INVALIDARG;
+        for (i = 0; i < ARRAY_SIZE(roots) && !found; i++)
+        {
+            size = sizeof(caps);
+            if (RegGetValueW(roots[i], L"Software\\RegisteredApplications", appname, RRF_RT_REG_SZ, NULL, caps, &size)) continue;
+            swprintf(assoc_path, ARRAY_SIZE(assoc_path), L"%s\\MimeAssociations", caps);
+            size = sizeof(progid);
+            found = !RegGetValueW(HKEY_LOCAL_MACHINE, assoc_path, query, RRF_RT_REG_SZ, NULL, progid, &size) && *progid;
+            size = sizeof(progid);
+            if (!found)
+                found = !RegGetValueW(HKEY_CURRENT_USER, assoc_path, query, RRF_RT_REG_SZ, NULL, progid, &size) && *progid;
+        }
+        if (!found || level == AL_MACHINE) return S_OK;
+        swprintf(path, ARRAY_SIZE(path), L"Software\\Microsoft\\Windows\\Shell\\Associations\\MIMEAssociations\\%s\\UserChoice", query);
+        size = sizeof(cur);
+        *is_default = !RegGetValueW(HKEY_CURRENT_USER, path, L"Progid", RRF_RT_REG_SZ, NULL, cur, &size)
+                && !wcsicmp(cur, progid);
+        return S_OK;
+    }
+
+    default:
+        return E_INVALIDARG;
+    }
+}
+
+struct query_all
+{
+    ASSOCIATIONLEVEL level;
+    BOOL all;
+    BOOL any;
+};
+
+static HRESULT query_all_cb(const WCHAR *assoc, const WCHAR *progid, void *arg)
+{
+    struct query_all *q = arg;
+    WCHAR cur[MAX_PATH];
+
+    q->any = TRUE;
+    if (!assoc_progid_at_level(assoc, q->level, cur, ARRAY_SIZE(cur)) || wcsicmp(cur, progid)) q->all = FALSE;
+    return S_OK;
 }
 
 static HRESULT WINAPI ApplicationAssociationRegistration_QueryAppIsDefaultAll(IApplicationAssociationRegistration* This, ASSOCIATIONLEVEL level,
                                                                               LPCWSTR appname, BOOL *is_default)
 {
-    FIXME("(%p)->(%d, %s, %p)\n", This, level, debugstr_w(appname), is_default);
-    return E_NOTIMPL;
+    struct query_all q;
+
+    TRACE("(%p)->(%d, %s, %p)\n", This, level, debugstr_w(appname), is_default);
+
+    if (!appname || !is_default) return E_INVALIDARG;
+    *is_default = FALSE;
+    if (level != AL_MACHINE && level != AL_EFFECTIVE && level != AL_USER) return E_INVALIDARG;
+#ifdef SG_MUTANT_QUERYAPP
+    return S_OK;
+#endif
+    q.level = level;
+    q.all = TRUE;
+    q.any = FALSE;
+    for_each_app_association(appname, FALSE, query_all_cb, &q);
+    for_each_app_association(appname, TRUE, query_all_cb, &q);
+    *is_default = q.any && q.all;
+    return S_OK;
 }
 
