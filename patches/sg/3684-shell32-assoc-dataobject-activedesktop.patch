+
+static HRESULT WINAPI assochandler_CreateInvoker(IAssocHandler *iface, IDataObject *data, IAssocHandlerInvoker **invoker)
+{
+    struct assochandler_invoker *inv;
+
+    TRACE("(%p)->(%p %p)\n", iface, data, invoker);
+    if (!data || !invoker) return E_INVALIDARG;
+    *invoker = NULL;
+    if (!(inv = calloc(1, sizeof(*inv)))) return E_OUTOFMEMORY;
+    inv->IAssocHandlerInvoker_iface.lpVtbl = &invokervtbl;
+    inv->ref = 1;
+    inv->handler = iface;
+    IAssocHandler_AddRef(iface);
+    inv->data = data;
+    IDataObject_AddRef(data);
+    *invoker = &inv->IAssocHandlerInvoker_iface;
+    return S_OK;
+}
+
