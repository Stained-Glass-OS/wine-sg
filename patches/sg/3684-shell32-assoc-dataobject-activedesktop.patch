+/* SHGDFIL_DESCRIPTIONID: what kind of item a child id list is (SHDID_*), and the CLSID of a
+ * registered (namespace extension) item. */
+static HRESULT get_description_id(LPCITEMIDLIST pidl, SHDESCRIPTIONID *desc, int len)
+{
+    if (len < sizeof(*desc) || !pidl || !pidl->mkid.cb) return E_INVALIDARG;
+    memset(desc, 0, sizeof(*desc));
+    if (_ILIsDrive(pidl))
+    {
+        const char *text = _ILGetTextPointer(pidl);
+        WCHAR root[4] = L"A:\\";
+
+        desc->dwDescriptionId = SHDID_COMPUTER_OTHER;
+        if (text && text[0])
+        {
+            root[0] = (WCHAR)(unsigned char)text[0];
+            switch (GetDriveTypeW(root))
+            {
+            case DRIVE_REMOVABLE:
+                desc->dwDescriptionId = (root[0] == 'A' || root[0] == 'a' || root[0] == 'B' || root[0] == 'b')
+                        ? SHDID_COMPUTER_DRIVE35 : SHDID_COMPUTER_REMOVABLE;
+                break;
+            case DRIVE_FIXED: desc->dwDescriptionId = SHDID_COMPUTER_FIXED; break;
+            case DRIVE_REMOTE: desc->dwDescriptionId = SHDID_COMPUTER_NETDRIVE; break;
+            case DRIVE_CDROM: desc->dwDescriptionId = SHDID_COMPUTER_CDROM; break;
+            case DRIVE_RAMDISK: desc->dwDescriptionId = SHDID_COMPUTER_RAMDISK; break;
+            }
+        }
+    }
+    else if (_ILIsSpecialFolder(pidl))
+    {
+        const GUID *guid = _ILGetGUIDPointer(pidl);
+
+        desc->dwDescriptionId = SHDID_ROOT_REGITEM;
+        if (guid) desc->clsid = *guid;
+    }
+    else if (_ILIsFolder(pidl))
+        desc->dwDescriptionId = SHDID_FS_DIRECTORY;
+    else if (_ILIsValue(pidl))
+        desc->dwDescriptionId = SHDID_FS_FILE;
+    else
+        desc->dwDescriptionId = SHDID_FS_OTHER;
+#ifdef SG_MUTANT_DESCID
+    desc->dwDescriptionId = SHDID_FS_OTHER;
+#endif
+    return S_OK;
+}
