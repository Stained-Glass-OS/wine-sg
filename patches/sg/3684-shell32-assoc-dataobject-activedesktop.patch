+
+static ULONG WINAPI invoker_Release(IAssocHandlerInvoker *iface)
+{
+    struct assochandler_invoker *This = impl_from_IAssocHandlerInvoker(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
 
+    if (!ref)
+    {
+        IAssocHandler_Release(This->handler);
+        IDataObject_Release(This->data);
+        free(This);
+    }
     return ref;
 }
 
+static HRESULT WINAPI invoker_SupportsSelection(IAssocHandlerInvoker *iface)
