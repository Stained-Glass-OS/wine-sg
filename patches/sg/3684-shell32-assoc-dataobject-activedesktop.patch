+
+/* open every file of a data object with the handler's program */
+static HRESULT assochandler_run(struct assochandler *This, IDataObject *data)
+{
+    FORMATETC fmt = { CF_HDROP, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    STGMEDIUM med;
+    HRESULT hr;
+    UINT i, n;
+
+    if (!data) return E_INVALIDARG;
+    if (FAILED(hr = IDataObject_GetData(data, &fmt, &med))) return hr;
+    n = DragQueryFileW(med.hGlobal, ~0u, NULL, 0);
+    hr = n ? S_OK : E_FAIL;
+    for (i = 0; i < n; i++)
+    {
+        WCHAR file[MAX_PATH];
+        SHELLEXECUTEINFOW sei = { sizeof(sei) };
+
+        DragQueryFileW(med.hGlobal, i, file, ARRAY_SIZE(file));
+        sei.fMask = SEE_MASK_CLASSNAME | SEE_MASK_FLAG_NO_UI;
+        sei.lpVerb = L"open";
+        sei.lpFile = file;
+        sei.lpClass = This->info.progid;
+        sei.nShow = SW_SHOWNORMAL;
+        if (!ShellExecuteExW(&sei)) hr = HRESULT_FROM_WIN32(GetLastError());
+    }
+    ReleaseStgMedium(&med);
+    return hr;
+}
+
+static HRESULT WINAPI assochandler_Invoke(IAssocHandler *iface, IDataObject *data)
