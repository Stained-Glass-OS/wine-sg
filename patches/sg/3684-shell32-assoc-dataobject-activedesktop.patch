+/* Delete the UserChoice subkey of every child of HKCU\\parent. */
+static void clear_user_choices(const WCHAR *parent)
+{
+    WCHAR name[MAX_PATH];
+    HKEY hkey;
+    DWORD i;
+
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, parent, 0, KEY_READ | KEY_WRITE, &hkey)) return;
+    for (i = 0; ; i++)
+    {
+        HKEY child;
+        DWORD len = ARRAY_SIZE(name);
+
+        if (RegEnumKeyExW(hkey, i, name, &len, NULL, NULL, NULL, NULL)) break;
+        if (RegOpenKeyExW(hkey, name, 0, KEY_READ | KEY_WRITE, &child)) continue;
+        RegDeleteTreeW(child, L"UserChoice"); /* the child key itself stays, so indexes stay valid */
+        RegCloseKey(child);
+    }
+    RegCloseKey(hkey);
+}
+
 static HRESULT WINAPI ApplicationAssociationRegistration_ClearUserAssociations(IApplicationAssociationRegistration* This)
 {
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+    TRACE("(%p)\n", This);
+
+#ifdef SG_MUTANT_CLEARUSER
+    return S_OK;
+#endif
+    /* The user's choices are the UserChoice keys recorded by SetAppAsDefault and Open With. */
+    clear_user_choices(L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FileExts");
+    clear_user_choices(L"Software\\Microsoft\\Windows\\Shell\\Associations\\UrlAssociations");
+    clear_user_choices(L"Software\\Microsoft\\Windows\\Shell\\Associations\\MIMEAssociations");
+    SHChangeNotify(SHCNE_ASSOCCHANGED, SHCNF_IDLIST, NULL, NULL);
+    return S_OK;
 }
 
 
