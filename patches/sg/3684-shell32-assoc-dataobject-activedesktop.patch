+/* The wallpaper side of IActiveDesktop: changes are held here until ApplyChanges writes them
+ * (the object is shared, as the shell's one active desktop is). */
+#define AD_APPLY_SAVE            0x01
+#define AD_APPLY_HTMLGEN         0x02
+#define AD_APPLY_REFRESH         0x04
+#define AD_APPLY_FORCE           0x08
+#define AD_APPLY_BUFFERED_REFRESH 0x10
+#define AD_APPLY_DYNAMICREFRESH  0x20
+#define AD_GETWP_LAST_APPLIED    0x02
+#define WPSTYLE_CENTER 0
+#define WPSTYLE_TILE   1
+#define WPSTYLE_STRETCH 2
+#define WPSTYLE_MAX    3
+
+static CRITICAL_SECTION ad_cs;
+static CRITICAL_SECTION_DEBUG ad_cs_debug =
+{
+    0, 0, &ad_cs, { &ad_cs_debug.ProcessLocksList, &ad_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": ad_cs") }
+};
+static CRITICAL_SECTION ad_cs = { &ad_cs_debug, -1, 0, 0, 0, 0 };
+static WCHAR ad_wallpaper[MAX_PATH], ad_pattern[MAX_PATH];
+static BOOL ad_has_wallpaper, ad_has_style, ad_has_pattern;
+static DWORD ad_style;
+
+static DWORD ad_registry_style(void)
+{
+    WCHAR buf[16];
+    DWORD size = sizeof(buf);
+
+    if (!RegGetValueW(HKEY_CURRENT_USER, L"Control Panel\\Desktop", L"TileWallpaper", RRF_RT_REG_SZ, NULL, buf, &size)
+            && _wtoi(buf) == 1)
+        return WPSTYLE_TILE;
+    size = sizeof(buf);
+    if (!RegGetValueW(HKEY_CURRENT_USER, L"Control Panel\\Desktop", L"WallpaperStyle", RRF_RT_REG_SZ, NULL, buf, &size)
+            && _wtoi(buf) == 2)
+        return WPSTYLE_STRETCH;
+    return WPSTYLE_CENTER;
+}
+
 static HRESULT WINAPI active_desktop_ApplyChanges(IActiveDesktop *iface, DWORD flags)
 {
-    FIXME("%p, %#lx.\n", iface, flags);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p, %#lx.\n", iface, flags);
+
+#ifdef SG_MUTANT_ADAPPLY
+    return S_OK;
+#endif
+    EnterCriticalSection(&ad_cs);
+    if (flags & (AD_APPLY_SAVE | AD_APPLY_REFRESH | AD_APPLY_FORCE | AD_APPLY_BUFFERED_REFRESH | AD_APPLY_DYNAMICREFRESH))
+    {
+        if (ad_has_pattern)
+        {
+            RegSetKeyValueW(HKEY_CURRENT_USER, L"Control Panel\\Desktop", L"Pattern", REG_SZ, ad_pattern,
+                    (lstrlenW(ad_pattern) + 1) * sizeof(WCHAR));
+            ad_has_pattern = FALSE;
+        }
+        if (ad_has_style)
+        {
+            RegSetKeyValueW(HKEY_CURRENT_USER, L"Control Panel\\Desktop", L"TileWallpaper", REG_SZ,
+                    ad_style == WPSTYLE_TILE ? L"1" : L"0", 2 * sizeof(WCHAR));
+            RegSetKeyValueW(HKEY_CURRENT_USER, L"Control Panel\\Desktop", L"WallpaperStyle", REG_SZ,
+                    ad_style == WPSTYLE_STRETCH ? L"2" : L"0", 2 * sizeof(WCHAR));
+            ad_has_style = FALSE;
+            if (!ad_has_wallpaper)
+            {
+                /* the style alone changed: set the current picture again so that it is redrawn */
+                WCHAR cur[MAX_PATH];
+                if (SystemParametersInfoW(SPI_GETDESKWALLPAPER, ARRAY_SIZE(cur), cur, 0))
+                    SystemParametersInfoW(SPI_SETDESKWALLPAPER, 0, cur, SPIF_UPDATEINIFILE | SPIF_SENDCHANGE);
+            }
+        }
+        if (ad_has_wallpaper)
+        {
+            if (!SystemParametersInfoW(SPI_SETDESKWALLPAPER, 0, ad_wallpaper, SPIF_UPDATEINIFILE | SPIF_SENDCHANGE))
+                hr = E_FAIL;
+            ad_has_wallpaper = FALSE;
+        }
+    }
+    LeaveCriticalSection(&ad_cs);
+    return hr;
 }
 
