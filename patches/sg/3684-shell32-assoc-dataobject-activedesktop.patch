+/* The programs that can open a file type, for IAssocHandler: the first ones (what opens it now,
+ * what the type lists, what says it supports it) are the recommended ones. */
+BOOL SHELL_CollectAssocHandlers(const WCHAR *ext, BOOL recommended_only, struct assoc_handler_info **out, DWORD *count)
+{
+    struct openwith *ow;
+    struct assoc_handler_info *info;
+    int i, n;
+
+    *out = NULL;
+    *count = 0;
+    if (!ext || !*ext || lstrlenW(ext) >= ARRAY_SIZE(ow->ext)) return FALSE;
+    if (!(ow = calloc(1, sizeof(*ow)))) return FALSE;
+    lstrcpyW(ow->ext, ext);
+    collect_apps(ow);
+    n = recommended_only ? ow->first_more : ow->count;
+    if (n && (info = calloc(n, sizeof(*info))))
+    {
+        for (i = 0; i < n; i++)
+        {
+            lstrcpynW(info[i].progid, ow->apps[i].progid, MAX_PATH);
+            lstrcpynW(info[i].exe, ow->apps[i].exe, MAX_PATH);
+            lstrcpynW(info[i].name, ow->apps[i].name, ARRAY_SIZE(info[i].name));
+            info[i].recommended = i < ow->first_more;
+        }
+        *out = info;
+        *count = n;
+    }
+    for (i = 0; i < ow->count; i++) if (ow->apps[i].icon) DestroyIcon(ow->apps[i].icon);
+    free(ow);
+    return TRUE;
+}
+
+/* the program a ProgId runs, described as a handler */
+BOOL SHELL_MakeAssocHandlerInfo(const WCHAR *progid, struct assoc_handler_info *info)
+{
+    memset(info, 0, sizeof(*info));
+    if (!progid || !*progid || !class_command(progid, info->exe)) return FALSE;
+    lstrcpynW(info->progid, progid, MAX_PATH);
+    app_name(info->exe, progid, info->name, ARRAY_SIZE(info->name));
+    return TRUE;
+}
