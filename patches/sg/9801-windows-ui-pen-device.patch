+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* Stained Glass OS (wine-sg 9801): PenDevice.GetFromPointerId. Chromium (Electron programs: Joplin,
+ * Logseq, Tabby, Zulip, Arduino IDE) asks it for every pen pointer, to give the pen event a
+ * persistent device id; the class was not registered at all, which logged an activation error at
+ * start. On Windows a PenDevice exists for a pen whose hardware reports a unique id (a serial number:
+ * PenId is that pen's id), and GetFromPointerId gives null for any other pointer -- a mouse, a touch
+ * contact, a pen without such an id, an unknown pointer id -- which callers take as "no id". The pens
+ * Wine knows (winex11's XInput tablets, Xwayland's tablet tools) carry no hardware serial, so every
+ * answer here is that null, as Windows gives it for such a pen; nothing invents a PenId that would
+ * claim one physical pen is told apart from another. */
+
+#define WIDL_using_Windows_Devices_Input
+#include "private.h"
+#include "winuser.h"
+#include "wine/debug.h"
+#include "windows.devices.input.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ui);
+
+struct pen_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IPenDeviceStatics IPenDeviceStatics_iface;
+};
+
+static inline struct pen_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct pen_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct pen_factory *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IPenDeviceStatics ))
+        *out = &impl->IPenDeviceStatics_iface;
+    if (*out)
+    {
+        IUnknown_AddRef( (IUnknown *)*out );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    INSPECTABLE_IIDS( count, iids, &IID_IActivationFactory, &IID_IPenDeviceStatics );
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return inspectable_name( RuntimeClass_Windows_Devices_Input_PenDevice, name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+/* PenDevice has no public constructor */
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+    if (instance) *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( statics, IPenDeviceStatics, struct pen_factory, IActivationFactory_iface )
+
+static HRESULT WINAPI statics_GetFromPointerId( IPenDeviceStatics *iface, UINT32 pointer_id, IPenDevice **result )
+{
+    POINTER_INPUT_TYPE type = 0;
+
+    TRACE( "iface %p, pointer_id %u, result %p.\n", iface, pointer_id, result );
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!GetPointerType( pointer_id, &type ) || type != PT_PEN) return S_OK;
+    /* a pen, with no hardware id known for it */
+    TRACE( "pointer %u is a pen without a unique id\n", pointer_id );
+    return S_OK;
+}
+
+static const struct IPenDeviceStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface,
+    statics_AddRef,
+    statics_Release,
+    /* IInspectable methods */
+    statics_GetIids,
+    statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    /* IPenDeviceStatics methods */
+    statics_GetFromPointerId,
+};
+
+static struct pen_factory pen_factory =
+{
+    {&factory_vtbl},
+    {&statics_vtbl},
+};
+
+IActivationFactory *pen_device_factory = &pen_factory.IActivationFactory_iface;
