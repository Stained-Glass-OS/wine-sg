@@ -593,6 +614,28 @@ void xaml_apply_visual_state( IInspectable *group_obj, IInspectable *state_obj,
     xaml_invalidate_visuals();
 }
 
+/* an element's visual state groups' current states set again (a theme change: their {ThemeResource} values) */
+void xaml_refresh_visual_states( struct uielem *elem )
+{
+    IInspectable *groups = xaml_visual_state_groups( elem, FALSE );
+    UINT32 i, n = groups ? vector_size( groups ) : 0;
+
+    for (i = 0; i < n; i++)
+    {
+        IInspectable *item = vector_at( groups, i );
+        struct anim *group = anim_from_inspectable( item );
+
+        if (group && group->kind == A_GROUP && group->current)
+        {
+            IInspectable *current = group->current;
+            IInspectable_AddRef( current );
+            xaml_apply_visual_state( item, current, elem );
+            IInspectable_Release( current );
+        }
+        if (item) IInspectable_Release( item );
+    }
+}
