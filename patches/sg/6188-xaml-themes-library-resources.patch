+/* the theme an element is drawn in: its own RequestedTheme or its parents' (1 Light, 2 Dark), 0 when
+ * none is set (the application's) */
+INT32 xaml_element_theme( struct uielem *elem )
+{
+    IInspectable *box;
+    INT32 theme;
+
+    if (!prop_requested_theme) return 0;
+    for (; elem; elem = elem->parent)
+    {
+        box = NULL;
+        dobj_get_value( &elem->d, prop_requested_theme, &box );
+        theme = xunbox_enum( box, &IID_IReference_ElementTheme, 0 );
+        if (box) IInspectable_Release( box );
+        if (theme == 1 || theme == 2) return theme;
+    }
+    return 0;
+}
+
+/* a theme change: the {ThemeResource} values below it looked up again, its visual states set again */
+static void refresh_theme( struct uielem *elem, int depth )
+{
+    struct uielem *child;
+
+    IInspectable *style = NULL;
+
+    if (depth > 256) return;
+    dobj_get_value( &elem->d, prop_style, &style );
+    xaml_refresh_style_theme( elem, style );
+    if (style) IInspectable_Release( style );
+    dobj_refresh_theme( &elem->d, elem );
+    xaml_refresh_visual_states( elem );
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry ) refresh_theme( child, depth + 1 );
+}
+
+static void theme_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+#ifdef SG_MUTANT_THEME_CHANGE_IGNORED
+    return;
+#endif
+    refresh_theme( elem_from_dobj( obj ), 0 );
+    xaml_invalidate_visuals();
+}
