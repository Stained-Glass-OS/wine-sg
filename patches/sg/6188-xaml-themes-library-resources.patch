+
+/* its theme resources looked up again for the element CONTEXT (its own, or the one it is used for) */
+void dobj_refresh_theme( struct dobj *obj, struct uielem *context )
+{
+    struct dvalue *dv, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( dv, next, &obj->values, struct dvalue, entry )
+    {
+        IInspectable *found;
+        WCHAR *key;
+
+        if (!dv->theme_key || !(found = xaml_find_resource( context, NULL, 0, dv->theme_key ))) continue;
+        if (found == dv->local) continue;
+        key = dv->theme_key;
+        dv->theme_key = NULL;
+        IInspectable_AddRef( found );
+        dobj_set_theme_value( obj, dv->prop, found, key );
+        IInspectable_Release( found );
+        free( key );
+    }
+}
