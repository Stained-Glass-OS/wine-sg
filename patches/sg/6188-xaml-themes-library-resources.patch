+        if (themed)
+        {
+            converted = value_for( prop, themed );
+            IInspectable_Release( themed );
+        }
+    }
+    if (converted) ;
+    else if (value) converted = value_for( prop, value );
     else if (value_text && FAILED(xaml_value_from_string( prop->type, value_text, &converted ))) return;
