+/* a local value from {ThemeResource key}: kept with its key, so that a theme change finds it again */
+HRESULT dobj_set_theme_value( struct dobj *obj, struct xaml_property *prop, IInspectable *value, const WCHAR *key )
+{
+    struct dvalue *dv;
+    HRESULT hr;
+
+    if (FAILED(hr = dobj_set_value( obj, prop, value ))) return hr;
+#ifndef SG_MUTANT_THEME_REFS_FORGOTTEN
+    if ((dv = find_value( obj, prop, FALSE )) && dv->has_local) dv->theme_key = wcsdup( key );
+#endif
