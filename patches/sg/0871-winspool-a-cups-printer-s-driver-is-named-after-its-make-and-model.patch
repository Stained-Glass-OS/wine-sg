From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winspool: a CUPS printer's driver is named after its make and model

Wine named the Windows driver of every CUPS queue after the queue
("DYMO_LabelWriter_550"). Windows names a printer's driver after the
printer's model ("DYMO LabelWriter 550"), and programs recognise their
printers by it: DYMO Connect lists only printers whose driver is a
LabelWriter's (Win32_Printer.DriverName), so a CUPS queue for David's
LabelWriter 550 could never appear in it. A new CUPS printer's driver is
now named after the queue's printer-make-and-model (from its PPD), the
queue's own name when CUPS has none; the driver still carries the queue's
PPD, and refreshing a driver refreshes the printer's own driver. Printers
already added keep their driver.

Test: test/cupsmodel-gate.sh with test/wmiprinter-probe.c -- a CUPS
server of the gate's own with a queue for the model, 64- and 32-bit
(mutant SG_MUTANT_CUPSMODEL).
---
--- a/dlls/winspool.drv/cups.c
+++ b/dlls/winspool.drv/cups.c
@@ -279,8 +279,8 @@
 {
     const struct enum_printers_params *params = args;
 #ifdef SONAME_LIBCUPS
-    unsigned int num, i, name_len, comment_len, location_len, needed;
-    WCHAR *comment, *location, *ptr;
+    unsigned int num, i, name_len, comment_len, location_len, model_len, needed;
+    WCHAR *comment, *location, *model, *ptr;
     struct printer_info *info;
     cups_dest_t *dests;
 
@@ -310,11 +310,13 @@
 
         comment = cups_get_optionW( "printer-info", dests[i].num_options, dests[i].options );
         location = cups_get_optionW( "printer-location", dests[i].num_options, dests[i].options );
+        model = cups_get_optionW( "printer-make-and-model", dests[i].num_options, dests[i].options );
 
         name_len = strlen( dests[i].name ) + 1;
         comment_len = comment ? wcslen( comment ) + 1 : 0;
         location_len = location ? wcslen( location ) + 1 : 0;
-        needed += (name_len + comment_len + location_len) * sizeof(WCHAR);
+        model_len = model ? wcslen( model ) + 1 : 0;
+        needed += (name_len + comment_len + location_len + model_len) * sizeof(WCHAR);
 
         if (needed <= *params->size)
         {
@@ -325,11 +327,14 @@
             info->location = location ? ptr + name_len + comment_len : NULL;
             memcpy( info->location, location, location_len * sizeof(WCHAR) );
             info->is_default = dests[i].is_default;
+            info->model = model ? ptr + name_len + comment_len + location_len : NULL;
+            memcpy( info->model, model, model_len * sizeof(WCHAR) );
             info++;
-            ptr += name_len + comment_len + location_len;
+            ptr += name_len + comment_len + location_len + model_len;
         }
         free( comment );
         free( location );
+        free( model );
     }
     pcupsFreeDests( num, dests );
 
@@ -447,6 +452,7 @@
     PTR32 comment;
     PTR32 location;
     BOOL  is_default;
+    PTR32 model;
 };
 
 static NTSTATUS wow64_enum_printers( void *args )
@@ -480,6 +486,7 @@
             info32[i].comment = PtrToUlong(info[i].comment);
             info32[i].location = PtrToUlong(info[i].location);
             info32[i].is_default = info[i].is_default;
+            info32[i].model = PtrToUlong(info[i].model);
         }
     }
     return status;
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -628,9 +628,9 @@
     return ppd;
 }
 
-static BOOL add_printer_driver( const WCHAR *name, const WCHAR *ppd_dir )
+static BOOL add_printer_driver( const WCHAR *name, const WCHAR *driver, const WCHAR *ppd_dir )
 {
-    WCHAR *ppd = get_ppd_filename( ppd_dir, name );
+    WCHAR *ppd = get_ppd_filename( ppd_dir, driver );
     struct get_ppd_params ppd_params;
     UNICODE_STRING nt_ppd = { .Buffer = NULL };
     DRIVER_INFO_3W di3;
@@ -650,7 +650,7 @@
 
     memset( &di3, 0, sizeof(DRIVER_INFO_3W) );
     di3.cVersion         = 3;
-    di3.pName            = (WCHAR *)name;
+    di3.pName            = (WCHAR *)driver;
     di3.pDriverPath      = driver_nt;
     di3.pDataFile        = ppd;
     di3.pConfigFile      = driver_nt;
@@ -757,8 +757,17 @@
         }
         else
         {
+            /* Stained Glass OS: the driver is named after the printer's make
+             * and model, as Windows names a printer's driver after its model
+             * ("DYMO LabelWriter 550"), not after the queue: programs that
+             * recognise their printers by driver name (DYMO Connect, through
+             * Win32_Printer.DriverName) did not know a CUPS queue for one. */
+            const WCHAR *driver = printer->name;
+#ifndef SG_MUTANT_CUPSMODEL
+            if (printer->model && printer->model[0]) driver = printer->model;
+#endif
             if (!ppd_dir && !(ppd_dir = get_ppd_dir())) break;
-            if (!add_printer_driver( printer->name, ppd_dir )) continue;
+            if (!add_printer_driver( printer->name, driver, ppd_dir )) continue;
 
             port = malloc( sizeof(L"CUPS:") + wcslen( printer->name ) * sizeof(WCHAR) );
             wcscpy( port, L"CUPS:" );
@@ -768,7 +777,7 @@
             pi2.pPrinterName    = printer->name;
             pi2.pDatatype       = raw;
             pi2.pPrintProcessor = wineps;
-            pi2.pDriverName     = printer->name;
+            pi2.pDriverName     = (WCHAR *)driver;
             pi2.pComment        = printer->comment;
             pi2.pLocation       = printer->location;
             pi2.pPortName       = port;
@@ -829,7 +838,21 @@
     if (!(ppd_dir = get_ppd_dir())) return FALSE;
 
     TRACE( "updating driver %s\n", debugstr_w( name ) );
-    ret = add_printer_driver( name, ppd_dir );
+    {
+        /* the printer's own driver, which may be named after its model */
+        WCHAR driver[256];
+        DWORD size = sizeof(driver);
+        HKEY key;
+
+        wcscpy( driver, name );
+        if (!open_printer_reg_key( name, &key ))
+        {
+            if (RegQueryValueExW( key, L"Printer Driver", NULL, NULL, (BYTE *)driver, &size ) ||
+                !driver[0]) wcscpy( driver, name );
+            RegCloseKey( key );
+        }
+        ret = add_printer_driver( name, driver, ppd_dir );
+    }
 
     free( ppd_dir );
 
--- a/dlls/winspool.drv/wspool.h
+++ b/dlls/winspool.drv/wspool.h
@@ -43,6 +43,7 @@
     WCHAR *comment;
     WCHAR *location;
     BOOL is_default;
+    WCHAR *model;  /* Stained Glass OS: the queue's make and model, or NULL */
 };
 
 struct enum_printers_params
