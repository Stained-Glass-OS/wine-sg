From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: a tab in a text layout advances to the next incremental tab stop

A tab was as wide as its glyph (nothing). As the Wine tests record from Windows (todo), the width
of a tab cluster is the distance to the next multiple of IDWriteTextFormat's incremental tab stop,
counted from the start of the line, and the glyph that is drawn advances as far so the text after it
is drawn where the layout says.

 - Cluster widths and glyph advances of tab clusters are set when the clusters are made, with the
   x position counted from the last new line (a tab at the start of a line is a whole stop).
 - Changing the tab stop of a layout recomputes it.
 - Not counted: lines broken by wrapping start the tab positions again at the start of the text, not at the
   start of the wrapped line.
 - Removed the todo_wine blocks of the tab width tests (4 checks).
---
--- a/dlls/dwrite/layout.c
+++ b/dlls/dwrite/layout.c
@@ -1185,6 +1185,52 @@ static HRESULT layout_shape_run(struct dwrite_textlayout *layout, struct regular
     return hr;
 }
 
+/* A tab is as wide as the distance to the next multiple of the incremental tab stop from the start of
+   the line (here: from the last new line), and the glyph of it advances as far. */
+static void layout_apply_tab_stops(struct dwrite_textlayout *layout)
+{
+    float x = 0.0f, tabstop = layout->format.tabstop;
+    unsigned int i;
+
+#ifdef SG_MUTANT_DWTAB_NO_STOPS
+    return;
+#endif
+    if (tabstop <= 0.0f)
+        return;
+
+    for (i = 0; i < layout->cluster_count; ++i)
+    {
+        DWRITE_CLUSTER_METRICS *metrics = &layout->clustermetrics[i];
+        const struct layout_cluster *c = &layout->clusters[i];
+
+        if (metrics->isNewline)
+        {
+            x = 0.0f;
+            continue;
+        }
+
+        if (c->run->kind == LAYOUT_RUN_REGULAR && metrics->length == 1
+                && c->run->u.regular.descr.string[c->position] == '\t')
+        {
+            const struct regular_layout_run *run = &c->run->u.regular;
+            float width = tabstop - fmodf(x, tabstop);
+            unsigned int g, first, last;
+
+            /* the last bits of a stop are not a stop */
+            if (width < 0.001f)
+                width = tabstop;
+            metrics->width = width;
+
+            first = run->clustermap[c->position];
+            last = c->position + 1 < run->descr.stringLength ? run->clustermap[c->position + 1] : run->glyphcount;
+            for (g = first; g < last; ++g)
+                run->advances[g] = g == first ? width : 0.0f;
+        }
+
+        x += metrics->width;
+    }
+}
+
 static HRESULT layout_compute_runs(struct dwrite_textlayout *layout)
 {
     struct layout_run *r;
@@ -1270,6 +1316,7 @@ static HRESULT layout_compute_runs(struct dwrite_textlayout *layout)
         layout->cluster_count = cluster;
         if (cluster)
             layout->clustermetrics[cluster-1].canWrapLineAfter = 1;
+        layout_apply_tab_stops(layout);
     }
 
     return hr;
@@ -5030,6 +5077,7 @@ static HRESULT WINAPI dwritetextformat_layout_SetIncrementalTabStop(IDWriteTextF
         return E_INVALIDARG;
 
     layout->format.tabstop = tabstop;
+    layout->recompute = RECOMPUTE_EVERYTHING;
     return S_OK;
 }
 
--- a/dlls/dwrite/tests/layout.c
+++ b/dlls/dwrite/tests/layout.c
@@ -6365,10 +6365,8 @@ static void test_tab_stops(void)
     ok(!clusters[1].isWhitespace, "Unexpected isWhitespace.\n");
     ok(clusters[2].isWhitespace, "Unexpected isWhitespace.\n");
     ok(!clusters[3].isWhitespace, "Unexpected isWhitespace.\n");
-todo_wine {
     ok(clusters[0].width == tabstop, "Unexpected tab width.\n");
     ok(clusters[1].width + clusters[2].width == tabstop, "Unexpected tab width.\n");
-}
     range.startPosition = 0;
     range.length = ~0u;
     hr = IDWriteTextLayout_SetFontSize(layout, 20.0f, range);
@@ -6383,10 +6381,8 @@ todo_wine {
     ok(!clusters[1].isWhitespace, "Unexpected isWhitespace.\n");
     ok(clusters[2].isWhitespace, "Unexpected isWhitespace.\n");
     ok(!clusters[3].isWhitespace, "Unexpected isWhitespace.\n");
-todo_wine {
     ok(clusters[0].width == tabstop, "Unexpected tab width.\n");
     ok(clusters[1].width + clusters[2].width == tabstop, "Unexpected tab width.\n");
-}
     IDWriteTextLayout_Release(layout);
 
     IDWriteTextFormat_Release(format);
