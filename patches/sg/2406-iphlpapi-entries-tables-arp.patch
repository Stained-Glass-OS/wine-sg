+/******************************************************************
+ *    GetIpPathTable (IPHLPAPI.@)
+ *
+ * The path table is a cache of what has been learned about destinations that
+ * were actually used. This system keeps none, so it is empty.
+ */
+DWORD WINAPI GetIpPathTable( ADDRESS_FAMILY family, MIB_IPPATH_TABLE **table )
+{
+    TRACE( "%u, %p\n", family, table );
+
+    if (!table || !is_ip_or_unspec( family )) return ERROR_INVALID_PARAMETER;
+    if (!(*table = heap_alloc_zero( sizeof(**table) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    return NO_ERROR;
+}
+
+/******************************************************************
+ *    GetIpPathEntry (IPHLPAPI.@)
+ */
+DWORD WINAPI GetIpPathEntry( MIB_IPPATH_ROW *row )
+{
+    TRACE( "%p\n", row );
+
+    if (!row || !is_ip_family( row->Destination.si_family )) return ERROR_INVALID_PARAMETER;
+    if (row->Source.si_family != AF_UNSPEC && row->Source.si_family != row->Destination.si_family)
+        return ERROR_INVALID_PARAMETER;
+#ifdef SG_MUTANT_IPE_PATH
+    return NO_ERROR;
+#endif
+    return ERROR_NOT_FOUND;
+}
+
+static int compare_pairs( const void *a, const void *b )
+{
+    const NET_IFINDEX *x = a, *y = b;
+    if (x[0] != y[0]) return x[0] < y[0] ? -1 : 1;
+    return x[1] < y[1] ? -1 : x[1] > y[1];
+}
+
+/* Every interface here is a leaf in both directions: the pair (0, n) says n
+ * has nothing above it, and (n, 0) that it has nothing below. */
+static DWORD get_stack_pairs( NET_IFINDEX **pairs, DWORD *count, BOOL inverted )
+{
+    MIB_IF_TABLE2 *ifs;
+    DWORD err, i;
+
+    if ((err = GetIfTable2( &ifs ))) return err;
+    if (!(*pairs = heap_alloc( max( 1, ifs->NumEntries * 2 ) * 2 * sizeof(NET_IFINDEX) )))
+    {
+        FreeMibTable( ifs );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    *count = ifs->NumEntries * 2;
+    for (i = 0; i < ifs->NumEntries; i++)
+    {
+        NET_IFINDEX index = ifs->Table[i].InterfaceIndex;
+        /* (higher, lower) when ascending, (lower, higher) when inverted: */
+#ifdef SG_MUTANT_IPE_STACK
+        (*pairs)[4 * i] = index;
+#else
+        (*pairs)[4 * i] = inverted ? index : 0;
+#endif
+        (*pairs)[4 * i + 1] = inverted ? 0 : index;
+        (*pairs)[4 * i + 2] = inverted ? 0 : index;
+        (*pairs)[4 * i + 3] = inverted ? index : 0;
+    }
+    FreeMibTable( ifs );
+    qsort( *pairs, *count, 2 * sizeof(NET_IFINDEX), compare_pairs );
+    return NO_ERROR;
+}
+
+/******************************************************************
+ *    GetIfStackTable (IPHLPAPI.@)
+ */
+DWORD WINAPI GetIfStackTable( MIB_IFSTACK_TABLE **table )
+{
+    NET_IFINDEX *pairs;
+    DWORD err, count, i;
+
+    TRACE( "%p\n", table );
+
+    if (!table) return ERROR_INVALID_PARAMETER;
+    if ((err = get_stack_pairs( &pairs, &count, FALSE ))) return err;
+    if (!(*table = heap_alloc_zero( FIELD_OFFSET(MIB_IFSTACK_TABLE, Table[count]) )))
+    {
+        heap_free( pairs );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    (*table)->NumEntries = count;
+    for (i = 0; i < count; i++)
+    {
+        (*table)->Table[i].HigherLayerInterfaceIndex = pairs[2 * i];
+        (*table)->Table[i].LowerLayerInterfaceIndex = pairs[2 * i + 1];
+    }
+    heap_free( pairs );
+    return NO_ERROR;
+}
+
+/******************************************************************
+ *    GetInvertedIfStackTable (IPHLPAPI.@)
+ */
+DWORD WINAPI GetInvertedIfStackTable( MIB_INVERTEDIFSTACK_TABLE **table )
+{
+    NET_IFINDEX *pairs;
+    DWORD err, count, i;
+
+    TRACE( "%p\n", table );
+
+    if (!table) return ERROR_INVALID_PARAMETER;
+    if ((err = get_stack_pairs( &pairs, &count, TRUE ))) return err;
+    if (!(*table = heap_alloc_zero( FIELD_OFFSET(MIB_INVERTEDIFSTACK_TABLE, Table[count]) )))
+    {
+        heap_free( pairs );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    (*table)->NumEntries = count;
+    for (i = 0; i < count; i++)
+    {
+        (*table)->Table[i].LowerLayerInterfaceIndex = pairs[2 * i];
+        (*table)->Table[i].HigherLayerInterfaceIndex = pairs[2 * i + 1];
+    }
+    heap_free( pairs );
+    return NO_ERROR;
+}
