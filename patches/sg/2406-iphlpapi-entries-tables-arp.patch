+/* Name and path of the program that owns a connection, in the caller's
+ * buffer after the two pointers that name them. */
+static DWORD get_owner_module( DWORD pid, TCPIP_OWNER_MODULE_INFO_CLASS class, void *buffer, DWORD *size )
+{
+    TCPIP_OWNER_MODULE_BASIC_INFO *info = buffer;
+    WCHAR path[MAX_PATH], *name;
+    DWORD len = ARRAY_SIZE(path), need;
+    HANDLE process;
+    BOOL ret;
+
+    if (!size || class != TCPIP_OWNER_MODULE_INFO_BASIC) return ERROR_INVALID_PARAMETER;
+
+    if (!(process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid ))) return ERROR_NOT_FOUND;
+    ret = QueryFullProcessImageNameW( process, 0, path, &len );
+    CloseHandle( process );
+    if (!ret) return ERROR_NOT_FOUND;
+
+    if ((name = wcsrchr( path, '\\' ))) name++;
+    else name = path;
+
+    need = sizeof(*info) + (lstrlenW( name ) + 1 + lstrlenW( path ) + 1) * sizeof(WCHAR);
+    if (!buffer || *size < need)
+    {
+        *size = need;
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    info->pModuleName = (WCHAR *)(info + 1);
+#ifdef SG_MUTANT_IPE_OWNER
+    name = path;
+#endif
+    lstrcpyW( info->pModuleName, name );
+    info->pModulePath = info->pModuleName + lstrlenW( name ) + 1;
+    lstrcpyW( info->pModulePath, path );
+    *size = need;
+    return NO_ERROR;
