+static BOOL is_ip_family( ADDRESS_FAMILY family )
+{
+    return family == AF_INET || family == AF_INET6;
+}
+
+static BOOL is_ip_or_unspec( ADDRESS_FAMILY family )
+{
+    return family == AF_UNSPEC || is_ip_family( family );
+}
+
+static BOOL same_address( const SOCKADDR_INET *a, const SOCKADDR_INET *b )
+{
+    if (a->si_family != b->si_family) return FALSE;
+    if (a->si_family == AF_INET) return a->Ipv4.sin_addr.s_addr == b->Ipv4.sin_addr.s_addr;
+    return !memcmp( &a->Ipv6.sin6_addr, &b->Ipv6.sin6_addr, sizeof(a->Ipv6.sin6_addr) );
+}
+
+/* An unset next hop in a lookup key is the on-link address of its family. */
+static BOOL same_next_hop( ADDRESS_FAMILY family, const SOCKADDR_INET *key, const SOCKADDR_INET *row )
+{
+    if (family == AF_INET) return key->Ipv4.sin_addr.s_addr == row->Ipv4.sin_addr.s_addr;
+    return !memcmp( &key->Ipv6.sin6_addr, &row->Ipv6.sin6_addr, sizeof(key->Ipv6.sin6_addr) );
+}
+
+/* The interface of a lookup key is its LUID, or failing that its index. */
+static BOOL same_interface( const NET_LUID *luid, NET_IFINDEX index, const NET_LUID *row_luid, NET_IFINDEX row_index )
+{
+#ifdef SG_MUTANT_IPE_IFACE
+    return TRUE;
+#endif
+    if (luid->Value) return luid->Value == row_luid->Value;
+    return index == row_index;
+}
