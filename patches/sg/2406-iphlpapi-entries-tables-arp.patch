+/******************************************************************
+ *    InitializeIpForwardEntry (IPHLPAPI.@)
+ *
+ * Every setting is "unspecified" for a route about to be created or set.
+ */
+void WINAPI InitializeIpForwardEntry( MIB_IPFORWARD_ROW2 *row )
+{
+    TRACE( "%p\n", row );
+
+    memset( row, 0, sizeof(*row) );
+    row->SitePrefixLength = 0xff;
+    row->ValidLifetime = ~0u;
+    row->PreferredLifetime = ~0u;
+#ifndef SG_MUTANT_IPE_INIT
+    row->Metric = ~0u;
+#endif
+    row->Protocol = ~0u;
+    row->Origin = ~0u;
+}
+
+/******************************************************************
+ *    InitializeUnicastIpAddressEntry (IPHLPAPI.@)
+ */
+void WINAPI InitializeUnicastIpAddressEntry( MIB_UNICASTIPADDRESS_ROW *row )
+{
+    TRACE( "%p\n", row );
+
+    memset( row, 0, sizeof(*row) );
+    row->PrefixOrigin = IpPrefixOriginUnchanged;
+    row->SuffixOrigin = IpSuffixOriginUnchanged;
+    row->ValidLifetime = ~0u;
+    row->PreferredLifetime = ~0u;
+    row->OnLinkPrefixLength = 0xff;
+}
