+/******************************************************************
+ *    GetIpErrorString (IPHLPAPI.@)
+ *
+ * The size is in characters, with the terminating NUL.
+ */
+DWORD WINAPI GetIpErrorString( IP_STATUS status, WCHAR *buffer, DWORD *size )
+{
+    const WCHAR *text = NULL;
+    WCHAR system[256];
+    DWORD i, len;
+
+    TRACE( "%lu, %p, %p\n", status, buffer, size );
+
+    if (!size) return ERROR_INVALID_PARAMETER;
+
+    for (i = 0; i < ARRAY_SIZE(ip_status); i++) if (ip_status[i].code == status) text = ip_status[i].text;
+    if (!text)
+    {
+        if (status > IP_STATUS_BASE && status <= MAX_IP_STATUS) return ERROR_MR_MID_NOT_FOUND;
+        len = FormatMessageW( FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL, status, 0,
+                              system, ARRAY_SIZE(system), NULL );
+        if (!len) return ERROR_MR_MID_NOT_FOUND;
+        while (len && (system[len - 1] == '\r' || system[len - 1] == '\n' || system[len - 1] == ' ')) len--;
+        system[len] = 0;
+        text = system;
+    }
+
+    len = lstrlenW( text ) + 1;
+#ifdef SG_MUTANT_IPE_ERRSTR
+    len--;
+#endif
+    if (!buffer || *size < len)
+    {
+        *size = len;
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    memcpy( buffer, text, len * sizeof(WCHAR) );
+    *size = len;
+    return NO_ERROR;
+}
