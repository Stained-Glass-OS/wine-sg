+/* The IP status codes, in the wording of the usual ping output. */
+static const struct { IP_STATUS code; const WCHAR *text; } ip_status[] =
+{
+    { IP_BUF_TOO_SMALL, L"Buffer too small." },
+    { IP_DEST_NET_UNREACHABLE, L"Destination net unreachable." },
+    { IP_DEST_HOST_UNREACHABLE, L"Destination host unreachable." },
+    { IP_DEST_PROT_UNREACHABLE, L"Destination protocol unreachable." },
+    { IP_DEST_PORT_UNREACHABLE, L"Destination port unreachable." },
+    { IP_NO_RESOURCES, L"No resources." },
+    { IP_BAD_OPTION, L"Bad option." },
+    { IP_HW_ERROR, L"Hardware error." },
+    { IP_PACKET_TOO_BIG, L"Packet needs to be fragmented but DF set." },
+    { IP_REQ_TIMED_OUT, L"Request timed out." },
+    { IP_BAD_REQ, L"Bad request." },
+    { IP_BAD_ROUTE, L"Bad route." },
+    { IP_TTL_EXPIRED_TRANSIT, L"TTL expired in transit." },
+    { IP_TTL_EXPIRED_REASSEM, L"TTL expired during fragment reassembly." },
+    { IP_PARAM_PROBLEM, L"Parameter problem." },
+    { IP_SOURCE_QUENCH, L"Source quench." },
+    { IP_OPTION_TOO_BIG, L"Option too big." },
+    { IP_BAD_DESTINATION, L"Bad destination." },
+    { IP_GENERAL_FAILURE, L"General failure." },
+};
