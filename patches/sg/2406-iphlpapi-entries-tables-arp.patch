+/******************************************************************
+ *    GetMulticastIpAddressTable (IPHLPAPI.@)
+ *
+ * Every interface that has IP enabled belongs to the all-hosts groups of
+ * its family: 224.0.0.1 for IPv4, and ff01::1 and ff02::1 for IPv6.
+ */
+DWORD WINAPI GetMulticastIpAddressTable( ADDRESS_FAMILY family, MIB_MULTICASTIPADDRESS_TABLE **table )
+{
+    static const struct in6_addr all_nodes_if = {{{ 0xff, 0x01, [15] = 1 }}};
+    static const struct in6_addr all_nodes_link = {{{ 0xff, 0x02, [15] = 1 }}};
+    MIB_IPINTERFACE_TABLE *ifaces;
+    DWORD err, i, count = 0;
+
+    TRACE( "%u, %p\n", family, table );
+
+    if (!table || !is_ip_or_unspec( family )) return ERROR_INVALID_PARAMETER;
+
+    if ((err = GetIpInterfaceTable( family, &ifaces ))) return err;
+    for (i = 0; i < ifaces->NumEntries; i++) count += ifaces->Table[i].Family == AF_INET ? 1 : 2;
+
+    if (!(*table = heap_alloc_zero( FIELD_OFFSET(MIB_MULTICASTIPADDRESS_TABLE, Table[count]) )))
+    {
+        FreeMibTable( ifaces );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    (*table)->NumEntries = count;
+    for (i = count = 0; i < ifaces->NumEntries; i++)
+    {
+        const MIB_IPINTERFACE_ROW *iface = ifaces->Table + i;
+        MIB_MULTICASTIPADDRESS_ROW *row = (*table)->Table + count;
+
+        row->InterfaceLuid = iface->InterfaceLuid;
+        row->InterfaceIndex = iface->InterfaceIndex;
+        if (iface->Family == AF_INET)
+        {
+            row->Address.Ipv4.sin_family = AF_INET;
+            row->Address.Ipv4.sin_addr.s_addr = htonl( 0xe0000001 );
+            count++;
+            continue;
+        }
+        row->Address.Ipv6.sin6_family = AF_INET6;
+        row->Address.Ipv6.sin6_addr = all_nodes_if;
+        row->ScopeId.Level = ScopeLevelInterface;
+        row->ScopeId.Zone = iface->InterfaceIndex;
+#ifdef SG_MUTANT_IPE_MCAST
+        row->Address.Ipv6.sin6_addr = all_nodes_link;
+#endif
+        row++;
+        row->InterfaceLuid = iface->InterfaceLuid;
+        row->InterfaceIndex = iface->InterfaceIndex;
+        row->Address.Ipv6.sin6_family = AF_INET6;
+        row->Address.Ipv6.sin6_addr = all_nodes_link;
+        row->ScopeId.Level = ScopeLevelLink;
+        row->ScopeId.Zone = iface->InterfaceIndex;
+        count += 2;
+    }
+    FreeMibTable( ifaces );
+    return NO_ERROR;
+}
+
+/******************************************************************
+ *    GetMulticastIpAddressEntry (IPHLPAPI.@)
+ */
+DWORD WINAPI GetMulticastIpAddressEntry( MIB_MULTICASTIPADDRESS_ROW *row )
+{
+    MIB_MULTICASTIPADDRESS_TABLE *table;
+    DWORD err, i;
+
+    TRACE( "%p\n", row );
+
+    if (!row || !is_ip_family( row->Address.si_family )) return ERROR_INVALID_PARAMETER;
+    if (!row->InterfaceLuid.Value && !row->InterfaceIndex) return ERROR_INVALID_PARAMETER;
+
+    if ((err = GetMulticastIpAddressTable( row->Address.si_family, &table ))) return err;
+    err = ERROR_NOT_FOUND;
+    for (i = 0; i < table->NumEntries; i++)
+    {
+        const MIB_MULTICASTIPADDRESS_ROW *r = table->Table + i;
+
+        if (!same_interface( &row->InterfaceLuid, row->InterfaceIndex, &r->InterfaceLuid, r->InterfaceIndex )) continue;
+        if (!same_address( &r->Address, &row->Address )) continue;
+        *row = *r;
+        err = NO_ERROR;
+        break;
+    }
+    FreeMibTable( table );
+    return err;
+}
