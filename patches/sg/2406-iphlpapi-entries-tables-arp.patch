+/******************************************************************
+ *    GetIpForwardEntry2 (IPHLPAPI.@)
+ */
+DWORD WINAPI GetIpForwardEntry2( MIB_IPFORWARD_ROW2 *row )
+{
+    MIB_IPFORWARD_TABLE2 *table;
+    DWORD err, i;
+
+    TRACE( "%p\n", row );
+
+    if (!row || !is_ip_family( row->DestinationPrefix.Prefix.si_family )) return ERROR_INVALID_PARAMETER;
+    if (!row->InterfaceLuid.Value && !row->InterfaceIndex) return ERROR_INVALID_PARAMETER;
+
+    if ((err = GetIpForwardTable2( row->DestinationPrefix.Prefix.si_family, &table ))) return err;
+    err = ERROR_NOT_FOUND;
+    for (i = 0; i < table->NumEntries; i++)
+    {
+        const MIB_IPFORWARD_ROW2 *r = table->Table + i;
+
+        if (!same_interface( &row->InterfaceLuid, row->InterfaceIndex, &r->InterfaceLuid, r->InterfaceIndex )) continue;
+        if (r->DestinationPrefix.PrefixLength != row->DestinationPrefix.PrefixLength) continue;
+        if (!same_address( &r->DestinationPrefix.Prefix, &row->DestinationPrefix.Prefix )) continue;
+        if (!same_next_hop( row->DestinationPrefix.Prefix.si_family, &row->NextHop, &r->NextHop )) continue;
+        *row = *r;
+        err = NO_ERROR;
+        break;
+    }
+    FreeMibTable( table );
+    return err;
+}
+
+/******************************************************************
+ *    GetIpNetEntry2 (IPHLPAPI.@)
+ */
+DWORD WINAPI GetIpNetEntry2( MIB_IPNET_ROW2 *row )
+{
+    MIB_IPNET_TABLE2 *table;
+    DWORD err, i;
+
+    TRACE( "%p\n", row );
+
+    if (!row || !is_ip_family( row->Address.si_family )) return ERROR_INVALID_PARAMETER;
+#ifndef SG_MUTANT_IPE_NOIFACE
+    if (!row->InterfaceLuid.Value && !row->InterfaceIndex) return ERROR_INVALID_PARAMETER;
+#endif
+
+    if ((err = GetIpNetTable2( row->Address.si_family, &table ))) return err;
+    err = ERROR_NOT_FOUND;
+    for (i = 0; i < table->NumEntries; i++)
+    {
+        const MIB_IPNET_ROW2 *r = table->Table + i;
+
+        if (!same_interface( &row->InterfaceLuid, row->InterfaceIndex, &r->InterfaceLuid, r->InterfaceIndex )) continue;
+        if (!same_address( &r->Address, &row->Address )) continue;
+        *row = *r;
+        err = NO_ERROR;
+        break;
+    }
+    FreeMibTable( table );
+    return err;
+}
