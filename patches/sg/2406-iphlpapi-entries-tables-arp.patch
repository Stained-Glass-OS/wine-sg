+/******************************************************************
+ *    SendARP (IPHLPAPI.@)
+ *
+ * The hardware address of an IPv4 address on a local network: that of this
+ * machine's own interface when the address is one of ours, otherwise whatever
+ * the neighbour table holds, after a datagram to the address has made the
+ * system ask for it when it does not.
+ */
+DWORD WINAPI SendARP( IPAddr dest, IPAddr src, ULONG *mac, ULONG *len )
+{
+    MIB_IPADDRTABLE *addrs;
+    MIB_IPNETTABLE *nets;
+    BYTE found[MAXLEN_PHYSADDR];
+    DWORD err, size, i, found_len = 0;
+    int tries;
+
+    TRACE( "%08lx, %08lx, %p, %p\n", dest, src, mac, len );
+
+    if (!mac || !len) return ERROR_INVALID_PARAMETER;
+    if (!dest) return ERROR_INVALID_PARAMETER;
+
+    /* one of our own addresses */
+    size = 0;
+    GetIpAddrTable( NULL, &size, FALSE );
+    if (size && (addrs = heap_alloc( size )))
+    {
+        if (!GetIpAddrTable( addrs, &size, FALSE ))
+        {
+            for (i = 0; i < addrs->dwNumEntries; i++)
+            {
+                MIB_IFROW ifrow;
+                if (addrs->table[i].dwAddr != dest) continue;
+                memset( &ifrow, 0, sizeof(ifrow) );
+                ifrow.dwIndex = addrs->table[i].dwIndex;
+                if (!GetIfEntry( &ifrow ) && ifrow.dwPhysAddrLen)
+                {
+                    found_len = min( ifrow.dwPhysAddrLen, sizeof(found) );
+                    memcpy( found, ifrow.bPhysAddr, found_len );
+#ifdef SG_MUTANT_IPE_ARP
+                    memset( found, 0, found_len );
+#endif
+                }
+                else
+                {
+                    heap_free( addrs );
+                    return ERROR_NOT_SUPPORTED;
+                }
+                break;
+            }
+        }
+        heap_free( addrs );
+    }
+
+    for (tries = 0; !found_len && tries < 30; tries++)
+    {
+        size = 0;
+        GetIpNetTable( NULL, &size, FALSE );
+        if (size && (nets = heap_alloc( size )))
+        {
+            if (!GetIpNetTable( nets, &size, FALSE ))
+            {
+                for (i = 0; i < nets->dwNumEntries; i++)
+                {
+                    const MIB_IPNETROW *row = nets->table + i;
+                    if (row->dwAddr != dest || row->dwType == MIB_IPNET_TYPE_INVALID || !row->dwPhysAddrLen) continue;
+                    found_len = min( row->dwPhysAddrLen, sizeof(found) );
+                    memcpy( found, row->bPhysAddr, found_len );
+                    break;
+                }
+            }
+            heap_free( nets );
+        }
+        if (!found_len && !tries)
+        {
+            /* have the system resolve it */
+            SOCKET s = socket( AF_INET, SOCK_DGRAM, IPPROTO_UDP );
+            if (s != INVALID_SOCKET)
+            {
+                struct sockaddr_in to = { AF_INET };
+                to.sin_port = htons( 9 );
+                to.sin_addr.s_addr = dest;
+                sendto( s, "", 0, 0, (struct sockaddr *)&to, sizeof(to) );
+                closesocket( s );
+            }
+        }
+        if (!found_len) Sleep( 100 );
+    }
+    if (!found_len) return ERROR_GEN_FAILURE;
+
+    err = NO_ERROR;
+    if (*len < found_len)
+        err = ERROR_BUFFER_OVERFLOW;
+    else
+        memcpy( mac, found, found_len );
+    *len = found_len;
+    return err;
+}
