From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: TOM ranges by word, sentence, paragraph and story (3690)

riched20: TOM ranges by word, sentence, paragraph and story

ITextRange and ITextSelection Move, MoveStart, MoveEnd, StartOf, EndOf and
Expand only knew characters (and the story in places): they now also move
and extend by words (a run of letters and digits or of other marks with
the white space after it), sentences (after . ! or ? and the white space),
paragraphs and the story. Lines, screens, windows, sections and tables
still report E_NOTIMPL.
---
diff --git a/dlls/riched20/richole.c b/dlls/riched20/richole.c
index 6efa748..f431895 100644
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -895,6 +895,226 @@ static void textfont_cache_range_props(ITextFontImpl *font)
     }
 }
 
+/* Units other than characters: words and paragraphs found in the text of the story, and the
+ * story itself (one unit). A word is a run of letters and digits or of other marks, with the
+ * white space after it; a paragraph ends with a carriage return. */
+static BOOL tom_generic_unit(LONG unit)
+{
+    return unit == tomWord || unit == tomSentence || unit == tomParagraph || unit == tomStory;
+}
+
+static int tom_char_class(WCHAR c)
+{
+    if (c == '\r' || c == '\n') return 3;
+    if (iswspace(c)) return 0;
+    if (iswalnum(c) || c == '_') return 1;
+    return 2;
+}
+
+static BOOL tom_is_boundary(const WCHAR *t, LONG len, LONG unit, LONG pos)
+{
+    if (pos <= 0) return TRUE;
+    if (pos >= len) return FALSE;
+    switch (unit)
+    {
+    case tomParagraph:
+#ifdef SG_MUTANT_TOM_PARA
+        return t[pos] == '\r';
+#endif
+        return t[pos - 1] == '\r';
+    case tomSentence:
+    {
+        /* after . ! or ? and the white space that follows, or after a paragraph mark */
+        LONG i = pos;
+
+        if (t[pos - 1] == '\r') return TRUE;
+        if (iswspace(t[pos])) return FALSE;
+        if (!iswspace(t[pos - 1])) return FALSE;
+        while (i > 0 && iswspace(t[i - 1]) && t[i - 1] != '\r') i--;
+        return i > 0 && (t[i - 1] == '.' || t[i - 1] == '!' || t[i - 1] == '?');
+    }
+    case tomWord:
+    {
+        int cur = tom_char_class(t[pos]), prev = tom_char_class(t[pos - 1]);
+
+        if (prev == 3) return TRUE;
+        if (cur == 0) return FALSE;
+#ifdef SG_MUTANT_TOM_WORD
+        return prev == 0;
+#endif
+        return prev == 0 || cur != prev;
+    }
+    default: return FALSE;
+    }
+}
+
+/* the largest boundary at or before pos / the smallest after pos / the largest before pos */
+static LONG tom_unit_start(const WCHAR *t, LONG len, LONG unit, LONG pos)
+{
+    while (pos > 0 && !tom_is_boundary(t, len, unit, pos)) pos--;
+    return pos;
+}
+
+static LONG tom_unit_next(const WCHAR *t, LONG len, LONG unit, LONG pos)
+{
+    do pos++; while (pos < len && !tom_is_boundary(t, len, unit, pos));
+    return min(pos, len);
+}
+
+static LONG tom_unit_prev(const WCHAR *t, LONG len, LONG unit, LONG pos)
+{
+    do pos--; while (pos > 0 && !tom_is_boundary(t, len, unit, pos));
+    return max(pos, 0);
+}
+
+/* the text of the whole story of the range's document */
+static HRESULT tom_story_text(ITextRange *range, WCHAR **text, LONG *len)
+{
+    ITextRange *dup;
+    BSTR str = NULL;
+    HRESULT hr;
+
+    *text = NULL;
+    if (FAILED(hr = ITextRange_GetStoryLength(range, len))) return hr;
+    if (FAILED(hr = ITextRange_GetDuplicate(range, &dup))) return hr;
+    ITextRange_SetStart(dup, 0);
+    ITextRange_SetEnd(dup, *len);
+    hr = ITextRange_GetText(dup, &str);
+    ITextRange_Release(dup);
+    if (FAILED(hr)) return hr;
+    if (!(*text = calloc(*len + 2, sizeof(WCHAR)))) { SysFreeString(str); return E_OUTOFMEMORY; }
+    if (str) memcpy(*text, str, min((LONG)SysStringLen(str), *len) * sizeof(WCHAR));
+    SysFreeString(str);
+    return S_OK;
+}
+
+/* Move a position by whole units (negative: back); returns the units moved. */
+static LONG tom_step(const WCHAR *t, LONG len, LONG unit, LONG *pos, LONG count)
+{
+    LONG moved = 0;
+
+    if (unit == tomStory)
+    {
+        LONG to = count > 0 ? len : 0;
+
+        if (*pos != to) moved = count > 0 ? 1 : -1;
+        *pos = to;
+        return moved;
+    }
+#ifdef SG_MUTANT_TOM_STEP
+    count = count > 0 ? 1 : count;
+#endif
+    while (count > 0 && *pos < len) { *pos = tom_unit_next(t, len, unit, *pos); moved++; count--; }
+    while (count < 0 && *pos > 0) { *pos = tom_unit_prev(t, len, unit, *pos); moved--; count++; }
+    return moved;
+}
+
+static HRESULT tom_generic_move(ITextRange *range, LONG unit, LONG count, LONG *delta)
+{
+    LONG start, end, len, pos, moved;
+    WCHAR *t;
+    HRESULT hr;
+
+    if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
+    ITextRange_GetStart(range, &start);
+    ITextRange_GetEnd(range, &end);
+    /* a range with text collapses to its end (start for a move back) and that counts as one unit */
+    pos = count > 0 ? end : start;
+    moved = tom_step(t, len, unit, &pos, count);
+    if (start != end)
+    {
+        if (count > 0 && moved < count) moved++;
+        else if (count < 0 && -moved < -count) moved--;
+    }
+    if (moved > count && count > 0) moved = count;
+    free(t);
+    if (delta) *delta = moved;
+    ITextRange_SetStart(range, pos);
+    ITextRange_SetEnd(range, pos);
+    return moved ? S_OK : S_FALSE;
+}
+
+static HRESULT tom_generic_moveedge(ITextRange *range, BOOL end_edge, LONG unit, LONG count, LONG *delta)
+{
+    LONG start, end, len, pos, moved;
+    WCHAR *t;
+    HRESULT hr;
+
+    if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
+    ITextRange_GetStart(range, &start);
+    ITextRange_GetEnd(range, &end);
+    pos = end_edge ? end : start;
+    moved = tom_step(t, len, unit, &pos, count);
+    free(t);
+    if (end_edge) { end = pos;
+#ifndef SG_MUTANT_TOM_CLAMP
+        if (end < start) start = end;
+#endif
+    }
+    else { start = pos; if (end < start) end = start; }
+    if (delta) *delta = moved;
+    ITextRange_SetStart(range, start);
+    ITextRange_SetEnd(range, end);
+    return moved ? S_OK : S_FALSE;
+}
+
+/* StartOf (to_end FALSE) and EndOf (TRUE): to the start or end of the unit, keeping the other
+ * end when extending, collapsing when moving */
+static HRESULT tom_generic_edge_of(ITextRange *range, BOOL to_end, LONG unit, LONG extend, LONG *delta)
+{
+    LONG start, end, len, ns, ne;
+    WCHAR *t;
+    HRESULT hr;
+
+    if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
+    ITextRange_GetStart(range, &start);
+    ITextRange_GetEnd(range, &end);
+    ns = start;
+    ne = end;
+    if (unit == tomStory)
+    {
+        if (to_end) ne = len; else ns = 0;
+    }
+    else if (to_end)
+        ne = (end > start && tom_is_boundary(t, len, unit, end)) || end >= len ? end : tom_unit_next(t, len, unit, end);
+    else
+        ns = tom_unit_start(t, len, unit, start);
+    free(t);
+    if (extend != tomExtend
+#ifdef SG_MUTANT_TOM_EDGE
+            && 0
+#endif
+            )
+    {
+        if (to_end) ns = ne; else ne = ns;
+    }
+    if (delta) *delta = to_end ? ne - end : ns - start;
+    ITextRange_SetStart(range, ns);
+    ITextRange_SetEnd(range, ne);
+    return (ns != start || ne != end) ? S_OK : S_FALSE;
+}
+
+static HRESULT tom_generic_expand(ITextRange *range, LONG unit, LONG *delta)
+{
+    LONG start, end, len, ns, ne;
+    WCHAR *t;
+    HRESULT hr;
+
+    if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
+    ITextRange_GetStart(range, &start);
+    ITextRange_GetEnd(range, &end);
+    ns = tom_unit_start(t, len, unit, start);
+#ifdef SG_MUTANT_TOM_EXPAND
+    ns = start;
+#endif
+    ne = (end > start && tom_is_boundary(t, len, unit, end)) || end >= len ? end : tom_unit_next(t, len, unit, end);
+    free(t);
+    if (delta) *delta = (ne - ns) - (end - start);
+    ITextRange_SetStart(range, ns);
+    ITextRange_SetEnd(range, ne);
+    return (ns != start || ne != end) ? S_OK : S_FALSE;
+}
+
 static HRESULT textrange_expand(ITextRange *range, LONG unit, LONG *delta)
 {
     LONG expand_start, expand_end;
@@ -906,8 +1126,12 @@ static HRESULT textrange_expand(ITextRange *range, LONG unit, LONG *delta)
         ITextRange_GetStoryLength(range, &expand_end);
         break;
     default:
-        FIXME("unit %ld is not supported\n", unit);
-        return E_NOTIMPL;
+        if (!tom_generic_unit(unit))
+        {
+            FIXME("unit %ld is not supported\n", unit);
+            return E_NOTIMPL;
+        }
+        return tom_generic_expand(range, unit, delta);
     }
 
     if (delta) {
@@ -2147,8 +2371,12 @@ static HRESULT textrange_startof(ITextRange *range, LONG unit, LONG extend, LONG
         break;
     }
     default:
-        FIXME("unit %ld is not supported\n", unit);
-        return E_NOTIMPL;
+        if (!tom_generic_unit(unit))
+        {
+            FIXME("unit %ld is not supported\n", unit);
+            return E_NOTIMPL;
+        }
+        return tom_generic_edge_of(range, FALSE, unit, extend, delta);
     }
     return hr;
 }
@@ -2200,8 +2428,12 @@ static HRESULT textrange_endof(ITextRange *range, ME_TextEditor *editor, LONG un
         break;
     }
     default:
-        FIXME("unit %ld is not supported\n", unit);
-        return E_NOTIMPL;
+        if (!tom_generic_unit(unit))
+        {
+            FIXME("unit %ld is not supported\n", unit);
+            return E_NOTIMPL;
+        }
+        return tom_generic_edge_of(range, TRUE, unit, extend, delta);
     }
     return hr;
 }
@@ -2274,8 +2506,12 @@ static HRESULT textrange_move(ITextRange *range, ME_TextEditor *editor, LONG uni
         break;
     }
     default:
-        FIXME("unit %ld is not supported\n", unit);
-        return E_NOTIMPL;
+        if (!tom_generic_unit(unit))
+        {
+            FIXME("unit %ld is not supported\n", unit);
+            return E_NOTIMPL;
+        }
+        return tom_generic_move(range, unit, count, delta);
     }
     if (moved == 0)
         hr = S_FALSE;
@@ -2329,8 +2565,12 @@ static HRESULT textrange_movestart(ITextRange *range, ME_TextEditor *editor, LON
         break;
     }
     default:
-        FIXME("unit %ld is not supported\n", unit);
-        return E_NOTIMPL;
+        if (!tom_generic_unit(unit))
+        {
+            FIXME("unit %ld is not supported\n", unit);
+            return E_NOTIMPL;
+        }
+        return tom_generic_moveedge(range, FALSE, unit, count, delta);
     }
     if (new_start == old_start)
         hr = S_FALSE;
@@ -2403,8 +2643,12 @@ static HRESULT textrange_moveend(ITextRange *range, ME_TextEditor *editor, LONG
         }
         break;
     default:
-        FIXME("unit %ld is not supported\n", unit);
-        return E_NOTIMPL;
+        if (!tom_generic_unit(unit))
+        {
+            FIXME("unit %ld is not supported\n", unit);
+            return E_NOTIMPL;
+        }
+        return tom_generic_moveedge(range, TRUE, unit, count, delta);
     }
     if (new_end == old_end)
         hr = S_FALSE;
