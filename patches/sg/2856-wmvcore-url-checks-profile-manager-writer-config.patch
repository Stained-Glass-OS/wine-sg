+/* ASF objects (the Advanced Systems Format specification): the header object
+ * starts a file and the content encryption objects mark a protected one. */
+static const GUID asf_header_object = {0x75b22630, 0x668e, 0x11cf, {0xa6, 0xd9, 0x00, 0xaa, 0x00, 0x62, 0xce, 0x6c}};
+static const GUID asf_content_encryption_object = {0x2211b3fb, 0xbd23, 0x11d2, {0xb4, 0xb7, 0x00, 0xa0, 0xc9, 0x55, 0xfc, 0x6e}};
+static const GUID asf_extended_content_encryption_object = {0x298ae614, 0x2622, 0x4c17, {0xb9, 0x35, 0xda, 0xe0, 0x7e, 0xe9, 0x28, 0x9c}};
+
+static BOOL asf_file_is_protected(const WCHAR *filename)
+{
+    BYTE header[30], *objects = NULL;
+    DWORD read, count, i, pos = 0, size;
+    BOOL ret = FALSE;
+    HANDLE file;
+
+    file = CreateFileW(filename, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        return FALSE;
+
+    if (!ReadFile(file, header, sizeof(header), &read, NULL) || read != sizeof(header)
+            || !IsEqualGUID((GUID *)header, &asf_header_object))
+        goto done;
+
+    memcpy(&count, header + 24, sizeof(count));
+    memcpy(&size, header + 16, sizeof(size));
+    if (header[20] || header[21] || header[22] || header[23] || size < sizeof(header) || size > 64 * 1024 * 1024)
+        goto done;
+    size -= sizeof(header);
+    if (!(objects = malloc(size)))
+        goto done;
+    if (!ReadFile(file, objects, size, &read, NULL))
+        goto done;
+    size = read;
+
+    for (i = 0; i < count && size - pos >= 24; i++)
+    {
+        const GUID *guid = (const GUID *)(objects + pos);
+        DWORD object_size;
+
+#ifdef SG_MUTANT_WMV_PROT_EXT_IGNORED
+        if (IsEqualGUID(guid, &asf_content_encryption_object))
+#else
+        if (IsEqualGUID(guid, &asf_content_encryption_object)
+                || IsEqualGUID(guid, &asf_extended_content_encryption_object))
+#endif
+        {
+            ret = TRUE;
+            break;
+        }
+        memcpy(&object_size, objects + pos + 16, sizeof(object_size));
+        if (objects[pos + 20] || objects[pos + 21] || objects[pos + 22] || objects[pos + 23]
+                || object_size < 24 || object_size > size - pos)
+            break;
+        pos += object_size;
+    }
+
+done:
+    free(objects);
+    CloseHandle(file);
+    return ret;
+}
+
 HRESULT WINAPI WMIsContentProtected(const WCHAR *filename, BOOL *protected)
 {
-    FIXME("(%s %p): semi-stub\n", wine_dbgstr_w(filename), protected);
+    TRACE("(%s %p)\n", wine_dbgstr_w(filename), protected);
 
