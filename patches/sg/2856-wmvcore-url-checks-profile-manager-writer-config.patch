+/* The extension of the file name of the URL: what follows the last dot of the
+ * last path component, leaving out a query or a fragment. */
+static BOOL url_extension_matches(const WCHAR *url, const WCHAR *const *extensions, unsigned int count)
+{
+#ifdef SG_MUTANT_WMV_URL_QUERY
+    const WCHAR *end = url + wcslen(url), *name = url, *dot = NULL, *p;
+#else
+    const WCHAR *end = url + wcscspn(url, L"?#"), *name = url, *dot = NULL, *p;
+#endif
+    unsigned int i;
+
+    for (p = url; p < end; p++)
+    {
+        if (*p == '/' || *p == '\\')
+        {
+            name = p + 1;
+            dot = NULL;
+        }
+        else if (*p == '.' && p >= name)
+            dot = p;
+    }
+    if (!dot)
+        return FALSE;
+
+    for (i = 0; i < count; i++)
+        if (wcslen(extensions[i]) == end - dot - 1 && !_wcsnicmp(dot + 1, extensions[i], end - dot - 1))
+            return TRUE;
+    return FALSE;
+}
+
