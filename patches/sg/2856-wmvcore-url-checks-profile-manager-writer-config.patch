         return E_INVALIDARG;
 
-    *protected = FALSE;
-
-    return S_FALSE;
+    /* S_OK with TRUE for a file that holds protected content, S_FALSE otherwise */
+    *protected = asf_file_is_protected(filename);
+    return *protected ? S_OK : S_FALSE;
 }
 
