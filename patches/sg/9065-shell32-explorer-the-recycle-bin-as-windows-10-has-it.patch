+/* whether the bin holds nothing, on any drive (its icon: empty or full) */
+static BOOL dir_has_entries(const WCHAR *dir)
+{
+    WIN32_FIND_DATAW data;
+    WCHAR pattern[MAX_PATH + 3];
+    HANDLE find;
+    BOOL ret = FALSE;
+
+    swprintf(pattern, ARRAY_SIZE(pattern), L"%s\\*", dir);
+    if ((find = FindFirstFileW(pattern, &data)) == INVALID_HANDLE_VALUE) return FALSE;
+    do ret = wcscmp(data.cFileName, L".") && wcscmp(data.cFileName, L"..");
+    while (!ret && FindNextFileW(find, &data));
+    FindClose(find);
+    return ret;
+}
