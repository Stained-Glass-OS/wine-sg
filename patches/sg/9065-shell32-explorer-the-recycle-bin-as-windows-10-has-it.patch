+/* Stained Glass OS: the drive a path is on, 'C' for C:\... (0 for none) */
+static WCHAR path_drive(const WCHAR *path)
+{
+    if (!path) return 0;
+    if (!wcsncmp(path, L"\\\\?\\", 4)) path += 4;
+    if (path[0] && path[1] == ':' && iswalpha(path[0])) return towupper(path[0]);
+    return 0;
+}
+
+/* the items of the bin, of one drive (DRIVE 0: all of them) */
+static HRESULT enum_drive_items(WCHAR drive, LPITEMIDLIST **pidls, int *count)
+{
+    HRESULT hr;
+    int i, n = 0;
+
+    if (FAILED(hr = enum_trash_items(pidls, count))) return hr;
+    if (!drive) return hr;
+    for (i = 0; i < *count; i++)
+    {
+        const WIN32_FIND_DATAW *data = get_trash_item_data((*pidls)[i]);
+        if (data && path_drive(data->cFileName) == drive) (*pidls)[n++] = (*pidls)[i];
+        else ILFree((*pidls)[i]);
+    }
+    *count = n;
+    return hr;
+}
+
+static void free_items(LPITEMIDLIST *pidls, int count)
+{
+    while (count) ILFree(pidls[--count]);
+    SHFree(pidls);
+}
+
+/* Windows 10 keeps the bin's settings per volume:
+ * HKCU\...\Explorer\BitBucket\Volume\{volume GUID}: MaxCapacity (MB), NukeOnDelete */
+#define BITBUCKET_KEY L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\BitBucket"
+
+static BOOL bin_volume_key(WCHAR drive, WCHAR *key, DWORD len)
+{
+    WCHAR root[4] = { drive, ':', '\\', 0 }, volume[64], *guid;
+
+    if (!drive) return FALSE;
+    if (GetVolumeNameForVolumeMountPointW(root, volume, ARRAY_SIZE(volume)) && (guid = wcschr(volume, '{')) &&
+        wcslen(guid) >= 38)
+        swprintf(key, len, L"%s\\Volume\\%.38s", BITBUCKET_KEY, guid);
+    else  /* no volume GUID (a folder mapped to a letter): the letter names it */
+        swprintf(key, len, L"%s\\Volume\\%c", BITBUCKET_KEY, drive);
+    return TRUE;
+}
+
+/* the default maximum, as Windows makes it: 10% of the first 40 GB and 5% of the rest */
+static DWORD default_max_mb(WCHAR drive)
+{
+    WCHAR root[4] = { drive, ':', '\\', 0 };
+    ULARGE_INTEGER total;
+    ULONGLONG mb;
+
+    InitOnceExecuteOnce( &trash_dir_once, init_trash_dirs, NULL, NULL );
+    /* a drive that tells no size (a pseudo or FUSE file system): the bin's
+     * room comes from where its Trash lies, the home's volume */
+    if ((!GetDiskFreeSpaceExW(root, NULL, &total, NULL) || !(total.QuadPart >> 20)) &&
+        (!trash_dir || !GetDiskFreeSpaceExW(trash_dir, NULL, &total, NULL) || !(total.QuadPart >> 20)))
+        return 4096;
+    mb = total.QuadPart >> 20;
+    if (mb <= 40960) return max(1, (DWORD)(mb / 10));
+    return (DWORD)min(0xffffffffULL, 4096 + (mb - 40960) / 20);
+}
+
+static void recyclebin_get_settings(WCHAR drive, DWORD *max_mb, BOOL *nuke)
+{
+    WCHAR key[MAX_PATH];
+    DWORD value, size;
+
+    *max_mb = default_max_mb(drive);
+    *nuke = FALSE;
+    if (!bin_volume_key(drive, key, ARRAY_SIZE(key))) return;
+    size = sizeof(value);
+    if (!RegGetValueW(HKEY_CURRENT_USER, key, L"MaxCapacity", RRF_RT_REG_DWORD, NULL, &value, &size) && value)
+        *max_mb = value;
+    size = sizeof(value);
+    if (!RegGetValueW(HKEY_CURRENT_USER, key, L"NukeOnDelete", RRF_RT_REG_DWORD, NULL, &value, &size))
+        *nuke = !!value;
+}
+
+static void recyclebin_set_settings(WCHAR drive, DWORD max_mb, BOOL nuke)
+{
+    WCHAR key[MAX_PATH];
+    DWORD value;
+    HKEY hkey;
+
+    if (!bin_volume_key(drive, key, ARRAY_SIZE(key))) return;
+    if (RegCreateKeyExW(HKEY_CURRENT_USER, key, 0, NULL, 0, KEY_SET_VALUE, NULL, &hkey, NULL)) return;
+    value = max(1, max_mb);
+    RegSetValueExW(hkey, L"MaxCapacity", 0, REG_DWORD, (BYTE *)&value, sizeof(value));
+    value = !!nuke;
+    RegSetValueExW(hkey, L"NukeOnDelete", 0, REG_DWORD, (BYTE *)&value, sizeof(value));
+    RegCloseKey(hkey);
+}
+
+/* "Don't move files to the Recycle Bin" for the drive of PATH */
+BOOL recyclebin_nuke_on_delete(const WCHAR *path)
+{
+    DWORD max_mb;
+    BOOL nuke;
+
+    if (!path_drive(path)) return FALSE;
+    recyclebin_get_settings(path_drive(path), &max_mb, &nuke);
+#ifdef SG_MUTANT_RB_NUKE_IGNORED
+    nuke = FALSE;
+#endif
+    return nuke;
+}
