+/* Stained Glass OS: the Recycle Bin is the folder shown */
+static BOOL in_recycle_bin(void)
+{
+    LPITEMIDLIST pidl = NULL;
+    BOOL ret;
+
+    if (fe.content != CONTENT_FOLDER || !fe.pidl) return FALSE;
+    if (FAILED(SHGetFolderLocation(NULL, CSIDL_BITBUCKET, NULL, 0, &pidl)) || !pidl) return FALSE;
+    ret = ILIsEqual(pidl, fe.pidl);
+    ILFree(pidl);
+    return ret;
+}
+
+/* the bin's commands: shown in the bin only; "Restore the selected items"
+ * with a selection, else "Restore all items"; greyed while the bin is empty */
+static void update_bin_commands(int sel)
+{
+    BOOL bin = in_recycle_bin(), relayout = FALSE, any = FALSE;
+    int i;
+
+    if (bin)
+    {
+        /* the view shows the bin's items (this runs on the status timer: no walk of the bin here) */
+        HWND list = get_view_list();
+        any = list && SendMessageW(list, LVM_GETITEMCOUNT, 0, 0) > 0;
+    }
+    for (i = 0; i < fe.ncmds; i++)
+    {
+        struct cmd_item *c = &fe.cmds[i];
+        const WCHAR *label = c->label;
+
+        if (c->id != CMD_EMPTYBIN && c->id != CMD_RESTORE) continue;
+        if (c->id == CMD_RESTORE) label = sel ? L"Restore the selected items" : L"Restore all items";
+        if (c->hidden != !bin || label != c->label)
+        {
+            c->hidden = !bin;
+            c->label = label;
+            relayout = TRUE;
+        }
+    }
+    if (relayout)
+    {
+        cmdbar_layout();
+        InvalidateRect(fe.cmdbar, NULL, TRUE);
+    }
+    set_cmd_enabled(CMD_EMPTYBIN, any);
+    set_cmd_enabled(CMD_RESTORE, any);
+}
+
+/* every item of the Recycle Bin goes back where it was deleted from */
+static void restore_all(void)
+{
+    IShellFolder *folder = NULL;
+    IEnumIDList *items = NULL;
+    LPITEMIDLIST *pidls = NULL, child;
+    IContextMenu *cm;
+    ULONG count = 0, size = 0, got;
+
+    if (FAILED(SHBindToObject(NULL, fe.pidl, NULL, &IID_IShellFolder, (void **)&folder))) return;
+    if (SUCCEEDED(IShellFolder_EnumObjects(folder, fe.hwnd, SHCONTF_FOLDERS | SHCONTF_NONFOLDERS, &items)) && items)
+    {
+        while (IEnumIDList_Next(items, 1, &child, &got) == S_OK && got)
+        {
+            if (count == size)
+            {
+                LPITEMIDLIST *grown = realloc(pidls, (size = size * 2 + 16) * sizeof(*pidls));
+                if (!grown) { CoTaskMemFree(child); break; }
+                pidls = grown;
+            }
+            pidls[count++] = child;
+        }
