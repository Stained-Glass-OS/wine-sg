+/* Stained Glass OS: the Recycle Bin is per user and per drive. What Wine
+ * moves to the bin goes to the user's own Trash (in the home); a Linux
+ * program deleting from another disk puts it in that disk's Trash
+ * ($topdir/.Trash-$uid or $topdir/.Trash/$uid, the freedesktop.org rule). The
+ * bin shows, empties and counts both. An item of the home Trash is named in
+ * its ID list by its name there; one of a drive's Trash by the full path of
+ * its file in that Trash. Only the user's own Trash folders are read: the
+ * folder must belong to the caller's own account. */
+struct trash_place
+{
+    WCHAR *files;     /* X:\.Trash-1000\files */
+    WCHAR *info;      /* X:\.Trash-1000\info */
+    char  *topdir;    /* the drive's root, Unix path: relative Path= names start there */
+};
+
+static BOOL owned_by_caller( const WCHAR *path )
+{
+    PSECURITY_DESCRIPTOR sd = NULL;
+    PSID owner = NULL;
+    HANDLE token;
+    BYTE buffer[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE];
+    DWORD size;
+    BOOL ret = FALSE;
+
+    if (GetNamedSecurityInfoW( path, SE_FILE_OBJECT, OWNER_SECURITY_INFORMATION, &owner, NULL, NULL, NULL, &sd ))
+        return FALSE;
+    if (OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+    {
+        if (GetTokenInformation( token, TokenUser, buffer, sizeof(buffer), &size ))
+            ret = owner && EqualSid( owner, ((TOKEN_USER *)buffer)->User.Sid );
+        CloseHandle( token );
+    }
+    LocalFree( sd );
+    return ret;
+}
+
+static void add_trash_place( struct trash_place **places, unsigned int *count, const WCHAR *dir, const WCHAR *root )
+{
+    WCHAR *files, *info;
+    char *unix_files, *home_files = NULL;
+    struct trash_place *grown;
+    unsigned int i;
+    BOOL same = FALSE;
+    size_t len = lstrlenW( dir ) + 8;
+
+    if (!owned_by_caller( dir )) return;
+    files = malloc( len * sizeof(WCHAR) );
+    info = malloc( len * sizeof(WCHAR) );
+    swprintf( files, len, L"%s\\files", dir );
+    swprintf( info, len, L"%s\\info", dir );
+    if (!(GetFileAttributesW( files ) & FILE_ATTRIBUTE_DIRECTORY) || GetFileAttributesW( files ) == INVALID_FILE_ATTRIBUTES ||
+        !(unix_files = wine_get_unix_file_name( files )))
+    {
+        free( files );
+        free( info );
+        return;
+    }
+    /* the same folder through another drive letter, or the home Trash itself */
+    if (trash_dir && (home_files = wine_get_unix_file_name( trash_dir ))) same = !strcmp( home_files, unix_files );
+    for (i = 0; !same && i < *count; i++)
+    {
+        char *other = wine_get_unix_file_name( (*places)[i].files );
+        if (other) same = !strcmp( other, unix_files );
+        heap_free( other );
+    }
+    heap_free( home_files );
+    heap_free( unix_files );
+    if (same || !(grown = realloc( *places, (*count + 1) * sizeof(**places) )))
+    {
+        free( files );
+        free( info );
+        return;
+    }
+    *places = grown;
+    grown[*count].files = files;
+    grown[*count].info = info;
+    grown[*count].topdir = wine_get_unix_file_name( root );
+    (*count)++;
+}
+
+/* the user's own Trash folders on the drives (not the home's) */
+static unsigned int drive_trash_places( struct trash_place **places )
+{
+    DWORD drives = GetLogicalDrives();
+    unsigned int count = 0, i;
+
+    *places = NULL;
+    InitOnceExecuteOnce( &trash_dir_once, init_trash_dirs, NULL, NULL );
+    for (i = 0; i < 26; i++)
+    {
+        WCHAR root[4] = { 'A' + i, ':', '\\', 0 }, pattern[MAX_PATH], dir[MAX_PATH];
+        WIN32_FIND_DATAW data;
+        HANDLE find;
+        UINT type;
+
+        if (!(drives & (1 << i))) continue;
+        type = GetDriveTypeW( root );
+        if (type != DRIVE_FIXED && type != DRIVE_REMOVABLE) continue;
+        /* $topdir/.Trash-$uid */
+        swprintf( pattern, ARRAY_SIZE(pattern), L"%s.Trash-*", root );
+        if ((find = FindFirstFileW( pattern, &data )) != INVALID_HANDLE_VALUE)
+        {
+            do
+            {
+                if (!(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) continue;
+                swprintf( dir, ARRAY_SIZE(dir), L"%s%s", root, data.cFileName );
+                add_trash_place( places, &count, dir, root );
+            } while (FindNextFileW( find, &data ));
+            FindClose( find );
+        }
+        /* $topdir/.Trash/$uid */
+        swprintf( pattern, ARRAY_SIZE(pattern), L"%s.Trash\\*", root );
+        if ((find = FindFirstFileW( pattern, &data )) != INVALID_HANDLE_VALUE)
+        {
+            do
+            {
+                if (!(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || data.cFileName[0] == '.') continue;
+                swprintf( dir, ARRAY_SIZE(dir), L"%s.Trash\\%s", root, data.cFileName );
+                add_trash_place( places, &count, dir, root );
+            } while (FindNextFileW( find, &data ));
+            FindClose( find );
+        }
+    }
+    return count;
+}
+
+static void free_trash_places( struct trash_place *places, unsigned int count )
+{
+    while (count--)
+    {
+        free( places[count].files );
+        free( places[count].info );
+        heap_free( places[count].topdir );
+    }
+    free( places );
+}
+
+/* an item's file: in the home Trash by its name, else its full path (malloc'd) */
+static WCHAR *item_file_path( const WCHAR *filename )
+{
+    WCHAR *path;
+    ULONG len;
+
+    if (wcschr( filename, '\\' )) return wcsdup( filename );
+    if (!trash_dir) return NULL;
+    len = lstrlenW( trash_dir ) + lstrlenW( filename ) + 2;
+    if (!(path = malloc( len * sizeof(WCHAR) ))) return NULL;
+    swprintf( path, len, L"%s\\%s", trash_dir, filename );
+    return path;
+}
+
+/* an item's .trashinfo (malloc'd; NULL for a Trash without them) */
+static WCHAR *item_info_path( const WCHAR *filename )
+{
+    const WCHAR *name;
+    WCHAR *path, *p;
+    ULONG len;
+
+    if (!wcschr( filename, '\\' ))
+    {
+        if (!trash_info_dir) return NULL;
+        len = lstrlenW( trash_info_dir ) + lstrlenW( filename ) + 12;
+        if (!(path = malloc( len * sizeof(WCHAR) ))) return NULL;
+        swprintf( path, len, L"%s\\%s.trashinfo", trash_info_dir, filename );
+        return path;
+    }
+    /* X:\.Trash-1000\files\NAME -> X:\.Trash-1000\info\NAME.trashinfo */
+    name = PathFindFileNameW( filename );
+    len = lstrlenW( filename ) + 12;
+    if (!(path = malloc( len * sizeof(WCHAR) ))) return NULL;
+    lstrcpynW( path, filename, name - filename );
+    if (!(p = wcsrchr( path, '\\' ))) { free( path ); return NULL; }
+    swprintf( p, len - (p - path), L"\\info\\%s.trashinfo", name );
+    return path;
+}
+
+/* the bytes a file or a folder holds, all of it */
+static ULONGLONG path_size( const WCHAR *path, const WIN32_FIND_DATAW *data )
+{
+    WCHAR *pattern, *child;
+    WIN32_FIND_DATAW sub;
+    ULONGLONG size = 0;
+    HANDLE find;
+    ULONG len;
+
+    if (!(data->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+        return ((ULONGLONG)data->nFileSizeHigh << 32) | data->nFileSizeLow;
+    if (data->dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) return 0;
+    len = lstrlenW( path ) + MAX_PATH + 3;
+    pattern = malloc( len * sizeof(WCHAR) );
+    child = malloc( len * sizeof(WCHAR) );
+    swprintf( pattern, len, L"%s\\*", path );
+    if ((find = FindFirstFileW( pattern, &sub )) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (!wcscmp( sub.cFileName, L"." ) || !wcscmp( sub.cFileName, L".." )) continue;
+            swprintf( child, len, L"%s\\%s", path, sub.cFileName );
+            size += path_size( child, &sub );
+        } while (FindNextFileW( find, &sub ));
+        FindClose( find );
+    }
+    free( pattern );
+    free( child );
+    return size;
+}
+
+/* a file or a folder and everything in it, for good */
+static BOOL remove_path( const WCHAR *path )
+{
+    WIN32_FIND_DATAW sub;
+    WCHAR *pattern, *child;
+    DWORD attrs = GetFileAttributesW( path );
+    HANDLE find;
+    ULONG len;
+
+    if (attrs == INVALID_FILE_ATTRIBUTES) return FALSE;
+    if (attrs & FILE_ATTRIBUTE_READONLY) SetFileAttributesW( path, attrs & ~FILE_ATTRIBUTE_READONLY );
+    if (!(attrs & FILE_ATTRIBUTE_DIRECTORY) || (attrs & FILE_ATTRIBUTE_REPARSE_POINT))
+        return (attrs & FILE_ATTRIBUTE_DIRECTORY) ? RemoveDirectoryW( path ) : DeleteFileW( path );
+    len = lstrlenW( path ) + MAX_PATH + 3;
+    pattern = malloc( len * sizeof(WCHAR) );
+    child = malloc( len * sizeof(WCHAR) );
+    swprintf( pattern, len, L"%s\\*", path );
+    if ((find = FindFirstFileW( pattern, &sub )) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (!wcscmp( sub.cFileName, L"." ) || !wcscmp( sub.cFileName, L".." )) continue;
+            swprintf( child, len, L"%s\\%s", path, sub.cFileName );
+            remove_path( child );
+        } while (FindNextFileW( find, &sub ));
+        FindClose( find );
+    }
+    free( pattern );
+    free( child );
+    return RemoveDirectoryW( path );
+}
