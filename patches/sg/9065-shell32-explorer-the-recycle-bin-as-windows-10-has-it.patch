+/* Before PATH goes to the bin: whether it fits the bin of its drive (the
+ * drive's "Maximum size"). Bigger than the whole bin: RECYCLE_TOO_BIG (the
+ * caller asks to delete it for good, as Windows does); else the oldest
+ * items of that drive go for good until it fits, as Windows makes room.
+ * BUDGET keeps what the bin of the drive holds across one delete's items. */
+int recyclebin_fit(const WCHAR *path, struct recycle_budget *budget)
+{
+    WIN32_FIND_DATAW data;
+    WCHAR drive = path_drive(path);
+    ULONGLONG size, max;
+    LPITEMIDLIST *pidls;
+    HANDLE find;
+    int count, i;
+
+    if (!drive) return RECYCLE_FITS;
+    if ((find = FindFirstFileW(path, &data)) == INVALID_HANDLE_VALUE) return RECYCLE_FITS;
+    FindClose(find);
+    size = path_size(path, &data);
+    if (budget->drive != drive)
+    {
+        DWORD max_mb;
+        BOOL nuke;
+
+        recyclebin_get_settings(drive, &max_mb, &nuke);
+        budget->drive = drive;
+        budget->max = (ULONGLONG)max_mb << 20;
+        budget->used = 0;
+        if (SUCCEEDED(enum_drive_items(drive, &pidls, &count)))
+        {
+            for (i = 0; i < count; i++)
+            {
+                const WIN32_FIND_DATAW *d = get_trash_item_data(pidls[i]);
+                budget->used += ((ULONGLONG)d->nFileSizeHigh << 32) | d->nFileSizeLow;
+            }
+            free_items(pidls, count);
+        }
+    }
+    max = budget->max;
+#ifdef SG_MUTANT_RB_NO_MAX
+    max = ~(ULONGLONG)0;
+#endif
+    if (size > max) return RECYCLE_TOO_BIG;
+    if (budget->used + size > max && SUCCEEDED(enum_drive_items(drive, &pidls, &count)))
+    {
+        LPITEMIDLIST bin = NULL;
+
+        /* the oldest first */
+        qsort(pidls, count, sizeof(*pidls), compare_deleted);
+        SHGetFolderLocation(NULL, CSIDL_BITBUCKET, 0, 0, &bin);
+        for (i = 0; i < count && budget->used + size > max; i++)
+        {
+            const WIN32_FIND_DATAW *d = get_trash_item_data(pidls[i]);
+            ULONGLONG bytes = ((ULONGLONG)d->nFileSizeHigh << 32) | d->nFileSizeLow;
+
+            if (FAILED(erase_trash_item(pidls[i]))) continue;
+            TRACE("made room: %s went for good\n", debugstr_w(d->cFileName));
+            budget->used -= min(budget->used, bytes);
+            if (bin) SHChangeNotify(SHCNE_DELETE, SHCNF_IDLIST, ILCombine(bin, pidls[i]), 0);
+        }
+        ILFree(bin);
+        free_items(pidls, count);
+    }
+    budget->used += size;
+    return RECYCLE_FITS;
+}
