+/* Stained Glass OS: the Recycle Bin's icon shows the bin empty or full, as it
+ * is. The user's Trash folder (where shell32 moves what is deleted) is watched:
+ * when it goes from empty to holding something or back -- a delete here or in
+ * any program, Empty Recycle Bin, a Linux program's delete -- the desktop
+ * reads its icons again, and the bin's is the one its state asks for. */
+static WCHAR *sg_trash_files_dir(void)
+{
+    const WCHAR *home = _wgetenv( L"WINEHOMEDIR" ), *data_home = _wgetenv( L"XDG_DATA_HOME" );
+    WCHAR *dir, *p;
+    size_t len;
+
+    if (data_home && data_home[0] == '/')
+    {
+        len = wcslen( data_home ) + 32;
+        if (!(dir = malloc( len * sizeof(WCHAR) ))) return NULL;
+        swprintf( dir, len, L"\\??\\unix%s/Trash/files", data_home );
+    }
+    else if (home)
+    {
+        len = wcslen( home ) + 32;
+        if (!(dir = malloc( len * sizeof(WCHAR) ))) return NULL;
+        swprintf( dir, len, L"%s/.local/share/Trash/files", home );
+    }
+    else return NULL;
+    dir[1] = '\\';  /* \??\ -> \\?\ */
+    for (p = dir; *p; p++) if (*p == '/') *p = '\\';
+    return dir;
+}
+
+static BOOL sg_dir_has_entries( const WCHAR *dir )
+{
+    WIN32_FIND_DATAW data;
+    WCHAR *pattern = append_path( dir, L"*", -1 );
+    HANDLE find;
+    BOOL ret = FALSE;
+
+    if (!pattern) return FALSE;
+    if ((find = FindFirstFileW( pattern, &data )) != INVALID_HANDLE_VALUE)
+    {
+        do ret = wcscmp( data.cFileName, L"." ) && wcscmp( data.cFileName, L".." );
+        while (!ret && FindNextFileW( find, &data ));
+        FindClose( find );
+    }
+    free( pattern );
+    return ret;
+}
+
+static DWORD CALLBACK watch_trash( LPVOID param )
+{
+    HWND hwnd = param;
+    SHQUERYRBINFO info = { sizeof(info) };
+    char buf[4096];
+    WCHAR *dir;
+    HANDLE handle;
+    DWORD count;
+    BOOL full;
+
+    SHQueryRecycleBinW( NULL, &info );  /* the shell makes its Trash folders */
+    if (!(dir = sg_trash_files_dir())) return 0;
+    handle = CreateFileW( dir, FILE_LIST_DIRECTORY, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                          NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL );
+    if (handle == INVALID_HANDLE_VALUE)
+    {
+        WARN( "cannot watch the Trash %s: %lu\n", debugstr_w(dir), GetLastError() );
+        free( dir );
+        return 0;
+    }
+    full = sg_dir_has_entries( dir );
+    while (ReadDirectoryChangesW( handle, buf, sizeof(buf), FALSE, FILE_NOTIFY_CHANGE_FILE_NAME |
+                                  FILE_NOTIFY_CHANGE_DIR_NAME, &count, NULL, NULL ))
+    {
+        BOOL now = sg_dir_has_entries( dir );
+#ifdef SG_MUTANT_DESK_NO_TRASH_WATCH
+        now = full;
+#endif
+        if (now == full) continue;
+        full = now;
+        PostMessageW( hwnd, WM_SG_DESKTOP_RESCAN, 0, 0 );
+    }
+    CloseHandle( handle );
+    free( dir );
+    return 0;
+}
