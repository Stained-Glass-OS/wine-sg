+static int __cdecl compare_deleted(const void *a, const void *b)
+{
+    const WIN32_FIND_DATAW *da = get_trash_item_data(*(LPCITEMIDLIST *)a), *db = get_trash_item_data(*(LPCITEMIDLIST *)b);
+    return CompareFileTime(&da->ftLastAccessTime, &db->ftLastAccessTime);
+}
