+    props->sel = props->count ? 0 : -1;
+    if (props->count)
+    {
+        LVITEMW item = { 0 };
+        item.stateMask = item.state = LVIS_SELECTED | LVIS_FOCUSED;
+        props->loading = TRUE;
+        SendMessageW(list, LVM_SETITEMSTATE, 0, (LPARAM)&item);
+        props->loading = FALSE;
+    }
+    rb_show_location(dlg, props);
+
+    SHGetSetSettings(&state, SSF_NOCONFIRMRECYCLE, FALSE);
+    if (confirm_policy())
+    {
+        CheckDlgButton(dlg, IDC_RB_CONFIRM, BST_CHECKED);
+        EnableWindow(GetDlgItem(dlg, IDC_RB_CONFIRM), FALSE);
+    }
+    else CheckDlgButton(dlg, IDC_RB_CONFIRM, state.fNoConfirmRecycle ? BST_UNCHECKED : BST_CHECKED);
+}
+
+static void rb_apply(HWND dlg, struct rb_props *props)
+{
+    SHELLSTATE state = { 0 };
+    unsigned int i;
+
+    for (i = 0; i < props->count; i++)
+        recyclebin_set_settings(props->loc[i].drive, props->loc[i].max_mb, props->loc[i].nuke);
+    if (!confirm_policy())
+    {
+        state.fNoConfirmRecycle = IsDlgButtonChecked(dlg, IDC_RB_CONFIRM) != BST_CHECKED;
+        SHGetSetSettings(&state, SSF_NOCONFIRMRECYCLE, TRUE);
+    }
+}
+
+static INT_PTR CALLBACK rb_props_proc(HWND dlg, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct rb_props *props = (struct rb_props *)GetWindowLongPtrW(dlg, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        props = (struct rb_props *)((PROPSHEETPAGEW *)lp)->lParam;
+        SetWindowLongPtrW(dlg, DWLP_USER, (LONG_PTR)props);
+        rb_init(dlg, props);
+        return TRUE;
+
+    case WM_COMMAND:
+        if (!props || props->loading) break;
+        switch (LOWORD(wp))
+        {
+        case IDC_RB_MAXSIZE:
+            if (HIWORD(wp) == EN_CHANGE && props->sel >= 0)
+            {
+                BOOL ok;
+                UINT value = GetDlgItemInt(dlg, IDC_RB_MAXSIZE, &ok, FALSE);
+                if (ok && value) props->loc[props->sel].max_mb = value;
+                SendMessageW(GetParent(dlg), PSM_CHANGED, (WPARAM)dlg, 0);
+            }
+            break;
+        case IDC_RB_CUSTOM:
+        case IDC_RB_NUKE:
+            if (HIWORD(wp) == BN_CLICKED && props->sel >= 0)
+            {
+                props->loc[props->sel].nuke = LOWORD(wp) == IDC_RB_NUKE;
+                rb_show_location(dlg, props);
+                SendMessageW(GetParent(dlg), PSM_CHANGED, (WPARAM)dlg, 0);
+            }
+            break;
+        case IDC_RB_CONFIRM:
+            if (HIWORD(wp) == BN_CLICKED) SendMessageW(GetParent(dlg), PSM_CHANGED, (WPARAM)dlg, 0);
+            break;
+        }
+        break;
+
+    case WM_NOTIFY:
+    {
+        NMHDR *hdr = (NMHDR *)lp;
+
+        if (hdr->idFrom == IDC_RB_LIST && hdr->code == LVN_ITEMCHANGED)
+        {
+            NMLISTVIEW *nm = (NMLISTVIEW *)lp;
+            if (props && !props->loading && (nm->uNewState & LVIS_SELECTED) && !(nm->uOldState & LVIS_SELECTED))
+            {
+                props->sel = nm->iItem;
+                rb_show_location(dlg, props);
+            }
+        }
+        else if (hdr->code == PSN_APPLY)
+        {
+            rb_apply(dlg, props);
+            SetWindowLongPtrW(dlg, DWLP_MSGRESULT, PSNRET_NOERROR);
+            return TRUE;
+        }
+        break;
+    }
+    }
+    return FALSE;
+}
+
+static DWORD WINAPI rb_props_thread(void *arg)
+{
+    struct rb_props props = { 0 };
+    PROPSHEETPAGEW page = { sizeof(page) };
+    PROPSHEETHEADERW psh = { sizeof(psh) };
+    HPROPSHEETPAGE hpage;
+    HMODULE self = arg;
+
+    page.hInstance = shell32_hInstance;
+    page.pszTemplate = MAKEINTRESOURCEW(IDD_RECYCLEBIN_PROPERTIES);
+    page.pfnDlgProc = rb_props_proc;
+    page.lParam = (LPARAM)&props;
+    if ((hpage = CreatePropertySheetPageW(&page)))
+    {
+        psh.dwFlags = PSH_PROPTITLE;
+        psh.hInstance = shell32_hInstance;
+        psh.pszCaption = L"Recycle Bin";
+        psh.nPages = 1;
+        psh.phpage = &hpage;
+        PropertySheetW(&psh);
+    }
+    if (self) FreeLibraryAndExitThread(self, 0);
+    return 0;
+}
+
+/* opens the Recycle Bin's Properties, in a thread of their own as Windows'
+ * sheets are: the desktop or the window that asked goes on */
+void recyclebin_properties(HWND owner)
+{
+    HMODULE self = NULL;
+    HANDLE thread;
+
+    GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, (const WCHAR *)recyclebin_properties, &self);
+    if ((thread = CreateThread(NULL, 0, rb_props_thread, self, 0, NULL))) CloseHandle(thread);
+    else if (self) FreeLibrary(self);
+}
