+BOOL recyclebin_is_empty(void)
+{
+    struct trash_place *places;
+    unsigned int count, i;
+    BOOL empty;
+
+    InitOnceExecuteOnce( &trash_dir_once, init_trash_dirs, NULL, NULL );
+    if (!trash_dir) return TRUE;
+    empty = !dir_has_entries(trash_dir);
+    count = drive_trash_places(&places);
+    for (i = 0; empty && i < count; i++) empty = !dir_has_entries(places[i].files);
+    free_trash_places(places, count);
+    return empty;
