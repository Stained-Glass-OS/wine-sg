+/* Stained Glass OS: the general entities declared in the document type, in declaration order (parameter
+ * entities are the DTD's own), and its notations. Both maps are read-only. */
+static BOOL is_general_entity( xmlNodePtr node )
+{
+    xmlEntityPtr ent = (xmlEntityPtr)node;
+
+    if (node->type != XML_ENTITY_DECL) return FALSE;
+    return ent->etype == XML_INTERNAL_GENERAL_ENTITY || ent->etype == XML_EXTERNAL_GENERAL_PARSED_ENTITY ||
+           ent->etype == XML_EXTERNAL_GENERAL_UNPARSED_ENTITY;
+}
+
+static xmlNodePtr nth_entity( xmlNodePtr dtd, LONG index )
+{
+    xmlNodePtr cur;
+
+    if (index < 0) return NULL;
+    for (cur = dtd->children; cur; cur = cur->next)
+        if (is_general_entity( cur ) && !index--) return cur;
+    return NULL;
+}
+
+static HRESULT entities_get_length( xmlNodePtr dtd, LONG *length )
+{
+    xmlNodePtr cur;
+
+    *length = 0;
+    for (cur = dtd->children; cur; cur = cur->next)
+        if (is_general_entity( cur )) (*length)++;
+    return S_OK;
+}
+
+static HRESULT entities_get_item( xmlNodePtr dtd, LONG index, IXMLDOMNode **item )
+{
+    xmlNodePtr ent = nth_entity( dtd, index );
+
+    *item = ent ? create_node( ent ) : NULL;
+    return *item ? S_OK : S_FALSE;
+}
+
+static HRESULT entities_get_named_item( const xmlNodePtr dtd, BSTR name, IXMLDOMNode **item )
+{
+    xmlChar *str;
+    xmlNodePtr cur;
+
+    *item = NULL;
+    if (!(str = xmlchar_from_wchar( name ))) return E_OUTOFMEMORY;
+    for (cur = dtd->children; cur; cur = cur->next)
+    {
+        if (is_general_entity( cur ) && xmlStrEqual( cur->name, str ))
+        {
+            *item = create_node( cur );
+            break;
+        }
+    }
+    free( str );
+    return *item ? S_OK : S_FALSE;
+}
+
+static HRESULT entities_get_qualified_item( const xmlNodePtr dtd, BSTR name, BSTR uri, IXMLDOMNode **item )
+{
+    *item = NULL;
+    if (uri && *uri) return S_FALSE; /* declarations have no namespace */
+    return entities_get_named_item( dtd, name, item );
+}
+
+static HRESULT entities_next_node( const xmlNodePtr dtd, LONG *iter, IXMLDOMNode **next )
+{
+    xmlNodePtr ent = nth_entity( dtd, *iter );
+
+    *next = NULL;
+    if (!ent) return S_FALSE;
+    (*iter)++;
+    *next = create_node( ent );
+    return *next ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT decl_set_named_item( xmlNodePtr dtd, IXMLDOMNode *item, IXMLDOMNode **out )
+{
+    if (out) *out = NULL;
+    return E_FAIL; /* the declarations are the document's */
+}
+
+static HRESULT decl_remove_named_item( xmlNodePtr dtd, BSTR name, IXMLDOMNode **out )
+{
+    if (out) *out = NULL;
+    return E_FAIL;
+}
+
+static HRESULT decl_remove_qualified_item( xmlNodePtr dtd, BSTR name, BSTR uri, IXMLDOMNode **out )
+{
+    if (out) *out = NULL;
+    return E_FAIL;
+}
+
+static const struct nodemap_funcs entities_map =
+{
+    entities_get_named_item,
+    decl_set_named_item,
+    decl_remove_named_item,
+    entities_get_item,
+    entities_get_length,
+    entities_get_qualified_item,
+    decl_remove_qualified_item,
+    entities_next_node
+};
+
+struct notation_list
+{
+    xmlNotationPtr *items;
+    LONG count, size;
+};
+
+static void collect_notation( void *payload, void *data, const xmlChar *name )
+{
+    struct notation_list *list = data;
+    xmlNotationPtr *grown;
+
+    if (list->count == list->size)
+    {
+        LONG size = list->size ? list->size * 2 : 8;
+        if (!(grown = realloc( list->items, size * sizeof(*grown) ))) return;
+        list->items = grown;
+        list->size = size;
+    }
+    list->items[list->count++] = payload;
+}
+
+static int __cdecl compare_notations( const void *a, const void *b )
+{
+    return xmlStrcmp( (*(xmlNotationPtr const *)a)->name, (*(xmlNotationPtr const *)b)->name );
+}
+
+/* libxml2 keeps them in a hash: by name, so the order stays the same */
+static void get_notations( xmlNodePtr dtd, struct notation_list *list )
+{
+    xmlDtdPtr d = (xmlDtdPtr)dtd;
+
+    memset( list, 0, sizeof(*list) );
+    if (d->notations) xmlHashScan( d->notations, collect_notation, list );
+    if (list->count > 1) qsort( list->items, list->count, sizeof(*list->items), compare_notations );
+}
+
+/* a node for a notation: libxml2's notations are not nodes; the document owns it */
+static IXMLDOMNode *notation_node( xmlNodePtr dtd, xmlNotationPtr nota )
+{
+    xmlNodePtr node;
+    IXMLDOMNode *ret;
+
+    if (!(node = xmlNewDocNode( dtd->doc, NULL, nota->name, NULL ))) return NULL;
+    node->type = XML_NOTATION_NODE;
+    node->psvi = nota;
+    if (dtd->doc) xmldoc_add_orphan( dtd->doc, node );
+    if (!(ret = create_node( node )) && dtd->doc)
+    {
+        xmldoc_remove_orphan( dtd->doc, node );
+        node->type = XML_ELEMENT_NODE;
+        xmlFreeNode( node );
+    }
+    return ret;
+}
+
+static HRESULT notations_get_length( xmlNodePtr dtd, LONG *length )
+{
+    xmlDtdPtr d = (xmlDtdPtr)dtd;
+
+    *length = d->notations ? xmlHashSize( d->notations ) : 0;
+    return S_OK;
+}
+
+static HRESULT notations_get_item( xmlNodePtr dtd, LONG index, IXMLDOMNode **item )
+{
+    struct notation_list list;
+
+    *item = NULL;
+    get_notations( dtd, &list );
+    if (index >= 0 && index < list.count) *item = notation_node( dtd, list.items[index] );
+    free( list.items );
+    return *item ? S_OK : S_FALSE;
+}
+
+static HRESULT notations_get_named_item( const xmlNodePtr dtd, BSTR name, IXMLDOMNode **item )
+{
+    xmlDtdPtr d = (xmlDtdPtr)dtd;
+    xmlNotationPtr nota;
+    xmlChar *str;
+
+    *item = NULL;
+    if (!d->notations) return S_FALSE;
+    if (!(str = xmlchar_from_wchar( name ))) return E_OUTOFMEMORY;
+    if ((nota = xmlHashLookup( d->notations, str ))) *item = notation_node( dtd, nota );
+    free( str );
+    return *item ? S_OK : S_FALSE;
+}
+
+static HRESULT notations_get_qualified_item( const xmlNodePtr dtd, BSTR name, BSTR uri, IXMLDOMNode **item )
+{
+    *item = NULL;
+    if (uri && *uri) return S_FALSE;
+    return notations_get_named_item( dtd, name, item );
+}
+
+static HRESULT notations_next_node( const xmlNodePtr dtd, LONG *iter, IXMLDOMNode **next )
+{
+    HRESULT hr = notations_get_item( dtd, *iter, next );
+    if (hr == S_OK) (*iter)++;
+    return hr;
+}
+
+static const struct nodemap_funcs notations_map =
+{
+    notations_get_named_item,
+    decl_set_named_item,
+    decl_remove_named_item,
+    notations_get_item,
+    notations_get_length,
+    notations_get_qualified_item,
+    decl_remove_qualified_item,
+    notations_next_node
+};
+
 static HRESULT WINAPI domdoctype_get_entities(
     IXMLDOMDocumentType *iface,
     IXMLDOMNamedNodeMap **entityMap)
 {
     domdoctype *This = impl_from_IXMLDOMDocumentType( iface );
-    FIXME("(%p)->(%p): stub\n", This, entityMap);
+
+    TRACE("(%p)->(%p)\n", This, entityMap);
+
+    if (!entityMap) return E_INVALIDARG;
+#ifdef SG_MUTANT_DOCTYPE_NO_ENTITIES
+    *entityMap = NULL;
     return E_NOTIMPL;
+#endif
+    *entityMap = create_nodemap( This->node.node, &entities_map );
+    return *entityMap ? S_OK : E_OUTOFMEMORY;
 }
 
 static HRESULT WINAPI domdoctype_get_notations(
@@ -524,8 +755,12 @@ static HRESULT WINAPI domdoctype_get_notations(
     IXMLDOMNamedNodeMap **notationMap)
 {
     domdoctype *This = impl_from_IXMLDOMDocumentType( iface );
-    FIXME("(%p)->(%p): stub\n", This, notationMap);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, notationMap);
+
+    if (!notationMap) return E_INVALIDARG;
+    *notationMap = create_nodemap( This->node.node, &notations_map );
+    return *notationMap ? S_OK : E_OUTOFMEMORY;
 }
 
