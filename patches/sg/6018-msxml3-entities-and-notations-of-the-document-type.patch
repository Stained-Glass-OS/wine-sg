+} entity;
+
+static const tid_t domentity_se_tids[] = {
+    IXMLDOMNode_tid,
+    IXMLDOMEntity_tid,
+    NULL_tid
+};
+
+static inline entity *impl_from_IXMLDOMEntity( IXMLDOMEntity *iface )
+{
+    return CONTAINING_RECORD(iface, entity, IXMLDOMEntity_iface);
+}
+
+static HRESULT WINAPI entity_QueryInterface(
+    IXMLDOMEntity *iface,
+    REFIID riid,
+    void** ppvObject )
+{
+    entity *This = impl_from_IXMLDOMEntity( iface );
+    TRACE("(%p)->(%s %p)\n", This, debugstr_guid(riid), ppvObject);
+
+    if ( IsEqualGUID( riid, &IID_IXMLDOMEntity ) ||
+         IsEqualGUID( riid, &IID_IXMLDOMNode ) ||
+         IsEqualGUID( riid, &IID_IDispatch ) ||
+         IsEqualGUID( riid, &IID_IUnknown ) )
+    {
+        *ppvObject = iface;
+    }
+    else if(node_query_interface(&This->node, riid, ppvObject))
+    {
+        return *ppvObject ? S_OK : E_NOINTERFACE;
+    }
+    else if (IsEqualGUID( riid, &IID_ISupportErrorInfo ))
+    {
+        return node_create_supporterrorinfo(domentity_se_tids, ppvObject);
+    }
+    else
+    {
+        TRACE("Unsupported interface %s\n", debugstr_guid(riid));
+        *ppvObject = NULL;
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown*)*ppvObject);
+    return S_OK;
+}
+
+static ULONG WINAPI entity_AddRef(
+    IXMLDOMEntity *iface )
+{
+    entity *This = impl_from_IXMLDOMEntity( iface );
+    ULONG ref = InterlockedIncrement( &This->ref );
+    TRACE("%p, refcount %lu.\n", iface, ref);
+    return ref;
+}
+
+static ULONG WINAPI entity_Release(
+    IXMLDOMEntity *iface )
+{
+    entity *This = impl_from_IXMLDOMEntity( iface );
+    ULONG ref = InterlockedDecrement( &This->ref );
+
+    TRACE("%p, refcount %lu.\n", iface, ref);
+
+    if (!ref)
+    {
+        destroy_xmlnode(&This->node);
+        free(This);
+    }
+
+    return ref;
+}
