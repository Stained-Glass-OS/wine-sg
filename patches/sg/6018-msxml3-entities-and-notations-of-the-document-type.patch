+static ULONG WINAPI notation_AddRef(
+    IXMLDOMNotation *iface )
+{
+    notation *This = impl_from_IXMLDOMNotation( iface );
+    ULONG ref = InterlockedIncrement( &This->ref );
+    TRACE("%p, refcount %lu.\n", iface, ref);
+    return ref;
+}
+
+static ULONG WINAPI notation_Release(
+    IXMLDOMNotation *iface )
+{
+    notation *This = impl_from_IXMLDOMNotation( iface );
+    ULONG ref = InterlockedDecrement( &This->ref );
+
+    TRACE("%p, refcount %lu.\n", iface, ref);
+
+    if (!ref)
+    {
+        destroy_xmlnode(&This->node);
+        free(This);
+    }
+
+    return ref;
+}
