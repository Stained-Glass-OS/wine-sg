+static HRESULT WINAPI notation_get_xml(
+    IXMLDOMNotation *iface,
+    BSTR* p)
+{
+    notation *This = impl_from_IXMLDOMNotation( iface );
+
+    xmlNotationPtr nota = get_notation( This );
+    xmlBufferPtr buf;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    if (!p) return E_INVALIDARG;
+    /* libxml2 does not write notations as nodes: the declaration, as in the DTD */
+    if (!nota || !(buf = xmlBufferCreate())) return E_OUTOFMEMORY;
+    xmlBufferCCat( buf, "<!NOTATION " );
+    xmlBufferCat( buf, nota->name );
+    if (nota->PublicID)
+    {
+        xmlBufferCCat( buf, " PUBLIC " );
+        xmlBufferWriteQuotedString( buf, nota->PublicID );
+        if (nota->SystemID)
+        {
+            xmlBufferCCat( buf, " " );
+            xmlBufferWriteQuotedString( buf, nota->SystemID );
+        }
+    }
+    else if (nota->SystemID)
+    {
+        xmlBufferCCat( buf, " SYSTEM " );
+        xmlBufferWriteQuotedString( buf, nota->SystemID );
+    }
+    xmlBufferCCat( buf, ">" );
+    *p = bstr_from_xmlChar( xmlBufferContent( buf ) );
+    xmlBufferFree( buf );
+    return *p ? S_OK : E_OUTOFMEMORY;
+}
