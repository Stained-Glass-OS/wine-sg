+/* [0] EXPLICIT SEQUENCE OF ANY */
+static BOOL CRYPT_AsnDecodeExplicitSequenceOfAny(const BYTE *pbEncoded,
+ DWORD cbEncoded, DWORD dwFlags, void *pvStructInfo, DWORD *pcbStructInfo,
+ DWORD *pcbDecoded)
+{
+    struct AsnArrayDescriptor arrayDesc = { ASN_SEQUENCEOF,
+     offsetof(CRYPT_CONTENT_INFO_SEQUENCE_OF_ANY, cValue),
+     offsetof(CRYPT_CONTENT_INFO_SEQUENCE_OF_ANY, rgValue),
+     FINALMEMBERSIZE(CRYPT_CONTENT_INFO_SEQUENCE_OF_ANY, cValue),
+     CRYPT_AsnDecodeDerBlob, sizeof(CRYPT_DER_BLOB), TRUE,
+     offsetof(CRYPT_DER_BLOB, pbData) };
+    DWORD dataLen, innerDecoded;
+    BYTE lenBytes;
+    BOOL ret;
+
+    if (!(ret = CRYPT_GetLen(pbEncoded, cbEncoded, &dataLen))) return FALSE;
+    lenBytes = GET_LEN_BYTES(pbEncoded[1]);
+    if (!dataLen)
+    {
+        SetLastError(CRYPT_E_ASN1_CORRUPT);
+        return FALSE;
+    }
+    ret = CRYPT_AsnDecodeArray(&arrayDesc, pbEncoded + 1 + lenBytes, dataLen, dwFlags,
+     NULL, pvStructInfo, pcbStructInfo, &innerDecoded);
+    if (ret && innerDecoded != dataLen)
+    {
+        SetLastError(CRYPT_E_ASN1_CORRUPT);
+        ret = FALSE;
+    }
+    if (ret && pcbDecoded) *pcbDecoded = 1 + lenBytes + dataLen;
+    return ret;
+}
