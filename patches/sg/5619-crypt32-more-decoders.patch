+static BOOL WINAPI CRYPT_AsnDecodePrivateKeyInfo(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const BYTE *pbEncoded, DWORD cbEncoded, DWORD dwFlags,
+ CRYPT_DECODE_PARA *pDecodePara, void *pvStructInfo, DWORD *pcbStructInfo)
+{
+    BOOL ret;
+    struct AsnDecodeSequenceItem items[] = {
+     { ASN_INTEGER, offsetof(struct DECODED_PRIVATE_KEY_INFO, info.Version),
+       CRYPT_AsnDecodeIntInternal, sizeof(DWORD), FALSE, FALSE, 0, 0 },
+     { ASN_SEQUENCEOF, offsetof(struct DECODED_PRIVATE_KEY_INFO, info.Algorithm),
+       CRYPT_AsnDecodeAlgorithmId, sizeof(CRYPT_ALGORITHM_IDENTIFIER), FALSE, TRUE,
+       offsetof(struct DECODED_PRIVATE_KEY_INFO, info.Algorithm.pszObjId), 0 },
+     { ASN_OCTETSTRING, offsetof(struct DECODED_PRIVATE_KEY_INFO, info.PrivateKey),
+       CRYPT_AsnDecodeOctets, sizeof(CRYPT_DER_BLOB), FALSE, TRUE,
+       offsetof(struct DECODED_PRIVATE_KEY_INFO, info.PrivateKey.pbData), 0 },
+     { ASN_CONTEXT | ASN_CONSTRUCTOR | 0, offsetof(struct DECODED_PRIVATE_KEY_INFO, attrs.cAttr),
+       CRYPT_AsnDecodePrivateKeyAttributes,
+       FINALMEMBERSIZE(struct DECODED_PRIVATE_KEY_INFO, attrs.cAttr), TRUE, TRUE,
+       offsetof(struct DECODED_PRIVATE_KEY_INFO, attrs.rgAttr), 0 },
+    };
+
+    __TRY
+    {
+        ret = CRYPT_AsnDecodeSequence(items, ARRAY_SIZE(items),
+         pbEncoded, cbEncoded, dwFlags, pDecodePara, pvStructInfo,
+         pcbStructInfo, NULL, NULL);
+        if (ret && pvStructInfo)
+        {
+            struct DECODED_PRIVATE_KEY_INFO *decoded = pvStructInfo;
+
+            if (dwFlags & CRYPT_DECODE_ALLOC_FLAG)
+                decoded = *(struct DECODED_PRIVATE_KEY_INFO **)pvStructInfo;
+#ifndef SG_MUTANT_PKCS8_NO_ATTRS
+            decoded->info.pAttributes = decoded->attrs.cAttr ? &decoded->attrs : NULL;
+#endif
+        }
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+        ret = FALSE;
+    }
+    __ENDTRY
+    return ret;
+}
