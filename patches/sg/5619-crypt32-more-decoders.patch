+static void *sg_decode(LPCSTR type, const BYTE *der, DWORD size, DWORD *len, DWORD *err)
+{
+    DWORD plain_size = 0;
+    BYTE *plain, *alloced = NULL;
+    BOOL ret;
+
+    ret = CryptDecodeObjectEx(X509_ASN_ENCODING, type, der, size, CRYPT_DECODE_ALLOC_FLAG, NULL, &alloced, len);
+    *err = ret ? 0 : GetLastError();
+    if (ret)
+    {
+        /* sizing, then into a caller's buffer, must give the same bytes */
+        ret = CryptDecodeObjectEx(X509_ASN_ENCODING, type, der, size, 0, NULL, NULL, &plain_size);
+        ok(ret, "sizing failed: %08lx\n", GetLastError());
+        ok(plain_size == *len || (plain_size >= *len - 16 && plain_size <= *len + 16), "sizes %lu, %lu\n", plain_size, *len);
+        plain = LocalAlloc(LMEM_ZEROINIT, plain_size + 16);
+        ret = CryptDecodeObjectEx(X509_ASN_ENCODING, type, der, size, 0, NULL, plain, &plain_size);
+        ok(ret, "decode into a buffer failed: %08lx\n", GetLastError());
+        LocalFree(plain);
+    }
+    return alloced;
+}
