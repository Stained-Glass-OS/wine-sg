+     offsetof(struct DECODED_PRIVATE_KEY_INFO, attrs.rgAttr),
+     FINALMEMBERSIZE(struct DECODED_PRIVATE_KEY_INFO, attrs.cAttr),
+     CRYPT_AsnDecodePKCSAttributeInternal, sizeof(CRYPT_ATTRIBUTE), TRUE,
