From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: decoders for DSS, RC2, PKCS #8, certificate pair, request and time request structures

crypt32: decoders for DSS, RC2, PKCS #8, certificate pair, request and time request structures

CryptDecodeObjectEx decodes X509_DSS_PARAMETERS, X509_DSS_SIGNATURE,
PKCS_RC2_CBC_PARAMETERS, PKCS_PRIVATE_KEY_INFO,
PKCS_ENCRYPTED_PRIVATE_KEY_INFO, X509_CERT_PAIR,
X509_CERT_REQUEST_TO_BE_SIGNED, X509_KEYGEN_REQUEST_TO_BE_SIGNED,
PKCS_TIME_REQUEST and PKCS_CONTENT_INFO_SEQUENCE_OF_ANY.
---
--- a/dlls/crypt32/crypt32_private.h
+++ b/dlls/crypt32/crypt32_private.h
@@ -126,6 +126,30 @@ BOOL WINAPI CRYPT_AsnEncodeOctets(DWORD dwCertEncodingType,
  LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
  PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded);
 
+
+/* The public CRYPT_RC2_CBC_PARAMETERS in wine's wincrypt.h has a 4 byte IV; the IV is 8 bytes (RFC 2268) */
+typedef struct _CRYPT_RC2_CBC_PARAMETERS_8
+{
+    DWORD dwVersion;
+    BOOL  fIV;
+    BYTE  rgbIV[8];
+} CRYPT_RC2_CBC_PARAMETERS_8;
+
+/* PKCS #8 (RFC 5208); not in wine's wincrypt.h */
+typedef struct _CRYPT_PRIVATE_KEY_INFO_
+{
+    DWORD                      Version;
+    CRYPT_ALGORITHM_IDENTIFIER Algorithm;
+    CRYPT_DER_BLOB             PrivateKey;
+    CRYPT_ATTRIBUTES          *pAttributes;
+} CRYPT_PRIVATE_KEY_INFO_;
+
+typedef struct _CRYPT_ENCRYPTED_PRIVATE_KEY_INFO_
+{
+    CRYPT_ALGORITHM_IDENTIFIER EncryptionAlgorithm;
+    CRYPT_DATA_BLOB            EncryptedPrivateKey;
+} CRYPT_ENCRYPTED_PRIVATE_KEY_INFO_;
+
 typedef struct _CRYPT_DIGESTED_DATA
 {
     DWORD                      version;
--- a/dlls/crypt32/decode.c
+++ b/dlls/crypt32/decode.c
@@ -6239,6 +6239,505 @@ static BOOL WINAPI CRYPT_AsnDecodeEccSignature(DWORD dwCertEncodingType,
     return ret;
 }
 
+static BOOL WINAPI CRYPT_AsnDecodeDssParameters(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const BYTE *pbEncoded, DWORD cbEncoded, DWORD dwFlags,
+ CRYPT_DECODE_PARA *pDecodePara, void *pvStructInfo, DWORD *pcbStructInfo)
+{
+    BOOL ret;
+    struct AsnDecodeSequenceItem items[] = {
+     { ASN_INTEGER, offsetof(CERT_DSS_PARAMETERS, p),
+       CRYPT_AsnDecodeUnsignedIntegerInternal, sizeof(CRYPT_UINT_BLOB), FALSE,
+       TRUE, offsetof(CERT_DSS_PARAMETERS, p.pbData), 0 },
+     { ASN_INTEGER, offsetof(CERT_DSS_PARAMETERS, q),
+       CRYPT_AsnDecodeUnsignedIntegerInternal, sizeof(CRYPT_UINT_BLOB), FALSE,
+       TRUE, offsetof(CERT_DSS_PARAMETERS, q.pbData), 0 },
+     { ASN_INTEGER, offsetof(CERT_DSS_PARAMETERS, g),
+       CRYPT_AsnDecodeUnsignedIntegerInternal, sizeof(CRYPT_UINT_BLOB), FALSE,
+       TRUE, offsetof(CERT_DSS_PARAMETERS, g.pbData), 0 },
+    };
+
+    __TRY
+    {
+        ret = CRYPT_AsnDecodeSequence(items, ARRAY_SIZE(items),
+         pbEncoded, cbEncoded, dwFlags, pDecodePara, pvStructInfo,
+         pcbStructInfo, NULL, NULL);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+        ret = FALSE;
+    }
+    __ENDTRY
+    return ret;
+}
+
+/* The DSS signature is the 20 bytes of r followed by the 20 bytes of s, each
+ * little-endian and unsigned. */
+static BOOL WINAPI CRYPT_AsnDecodeDssSignature(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const BYTE *pbEncoded, DWORD cbEncoded, DWORD dwFlags,
+ CRYPT_DECODE_PARA *pDecodePara, void *pvStructInfo, DWORD *pcbStructInfo)
+{
+    CERT_ECC_SIGNATURE *sig = NULL;
+    DWORD size = 0;
+    BOOL ret;
+
+    ret = CRYPT_AsnDecodeEccSignature(dwCertEncodingType, lpszStructType, pbEncoded, cbEncoded,
+     CRYPT_DECODE_ALLOC_FLAG, NULL, &sig, &size);
+    if (!ret) return FALSE;
+
+    if (sig->r.cbData > CERT_DSS_R_LEN || sig->s.cbData > CERT_DSS_S_LEN)
+    {
+        SetLastError(ERROR_INVALID_DATA);
+        ret = FALSE;
+    }
+    else if (!pvStructInfo)
+        *pcbStructInfo = CERT_DSS_SIGNATURE_LEN;
+    else if ((ret = CRYPT_DecodeEnsureSpace(dwFlags, pDecodePara, pvStructInfo, pcbStructInfo,
+     CERT_DSS_SIGNATURE_LEN)))
+    {
+        BYTE *out = pvStructInfo;
+
+        if (dwFlags & CRYPT_DECODE_ALLOC_FLAG)
+            out = *(BYTE **)pvStructInfo;
+        memset(out, 0, CERT_DSS_SIGNATURE_LEN);
+#ifndef SG_MUTANT_DSS_SWAPPED
+        memcpy(out, sig->r.pbData, sig->r.cbData);
+        memcpy(out + CERT_DSS_R_LEN, sig->s.pbData, sig->s.cbData);
+#else
+        memcpy(out, sig->s.pbData, sig->s.cbData);
+        memcpy(out + CERT_DSS_R_LEN, sig->r.pbData, sig->r.cbData);
+#endif
+    }
+    LocalFree(sig);
+    return ret;
+}
+
+static BOOL CRYPT_AsnDecodeRc2Iv(const BYTE *pbEncoded, DWORD cbEncoded,
+ DWORD dwFlags, void *pvStructInfo, DWORD *pcbStructInfo, DWORD *pcbDecoded)
+{
+    DWORD dataLen, bytesNeeded = sizeof(BOOL) + 8;
+    BOOL ret;
+
+    if (!(ret = CRYPT_GetLen(pbEncoded, cbEncoded, &dataLen))) return FALSE;
+    if (dataLen != 8)
+    {
+        SetLastError(CRYPT_E_ASN1_CORRUPT);
+        return FALSE;
+    }
+    if (pcbDecoded) *pcbDecoded = 1 + GET_LEN_BYTES(pbEncoded[1]) + dataLen;
+    if (!pvStructInfo)
+        *pcbStructInfo = bytesNeeded;
+    else if (*pcbStructInfo < bytesNeeded)
+    {
+        *pcbStructInfo = bytesNeeded;
+        SetLastError(ERROR_MORE_DATA);
+        ret = FALSE;
+    }
+    else
+    {
+        BOOL *fIV = pvStructInfo;
+
+        *pcbStructInfo = bytesNeeded;
+#ifndef SG_MUTANT_RC2_NO_IV
+        *fIV = TRUE;
+#endif
+        memcpy(fIV + 1, pbEncoded + 1 + GET_LEN_BYTES(pbEncoded[1]), 8);
+    }
+    return ret;
+}
+
+static BOOL WINAPI CRYPT_AsnDecodeRc2CbcParameters(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const BYTE *pbEncoded, DWORD cbEncoded, DWORD dwFlags,
+ CRYPT_DECODE_PARA *pDecodePara, void *pvStructInfo, DWORD *pcbStructInfo)
+{
+    BOOL ret;
+    struct AsnDecodeSequenceItem items[] = {
+     { ASN_INTEGER, offsetof(CRYPT_RC2_CBC_PARAMETERS_8, dwVersion),
+       CRYPT_AsnDecodeIntInternal, sizeof(DWORD), TRUE, FALSE, 0, 0 },
+     { ASN_OCTETSTRING, offsetof(CRYPT_RC2_CBC_PARAMETERS_8, fIV),
+       CRYPT_AsnDecodeRc2Iv, sizeof(BOOL) + 8, TRUE, FALSE, 0, 0 },
+    };
+
+    __TRY
+    {
+        ret = CRYPT_AsnDecodeSequence(items, ARRAY_SIZE(items),
+         pbEncoded, cbEncoded, dwFlags, pDecodePara, pvStructInfo,
+         pcbStructInfo, NULL, NULL);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+        ret = FALSE;
+    }
+    __ENDTRY
+    return ret;
+}
