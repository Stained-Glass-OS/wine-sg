+
 static inline struct json_object_statics *impl_from_IActivationFactory( IActivationFactory *iface )
 {
     return CONTAINING_RECORD( iface, struct json_object_statics, IActivationFactory_iface );
@@ -48,6 +51,15 @@
         IInspectable_AddRef( *out );
         return S_OK;
     }
+#ifndef SG_MUTANT_JSON_NO_PARSE_STATICS
+    /* Stained Glass OS 7721: JsonObject.Parse / TryParse */
+    if (IsEqualGUID( iid, &IID_IJsonObjectStatics ))
+    {
+        *out = &impl->IJsonObjectStatics_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+#endif
 
     FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
@@ -120,9 +132,46 @@
     factory_ActivateInstance,
 };
 
+DEFINE_IINSPECTABLE( object_statics, IJsonObjectStatics, struct json_object_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI object_statics_Parse( IJsonObjectStatics *iface, HSTRING input, IJsonObject **value )
+{
+    IInspectable *parsed;
+    HRESULT hr;
+
+    TRACE( "iface %p, input %s, value %p.\n", iface, debugstr_hstring( input ), value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = json_parse_object( input, &parsed ))) return hr;
+    hr = IInspectable_QueryInterface( parsed, &IID_IJsonObject, (void **)value );
+    IInspectable_Release( parsed );
+    return hr;
+}
+
+static HRESULT WINAPI object_statics_TryParse( IJsonObjectStatics *iface, HSTRING input, IJsonObject **result, boolean *succeeded )
+{
+    HRESULT hr;
+
+    TRACE( "iface %p, input %s, result %p, succeeded %p.\n", iface, debugstr_hstring( input ), result, succeeded );
+    if (!result || !succeeded) return E_POINTER;
+    hr = object_statics_Parse( iface, input, result );
+    *succeeded = SUCCEEDED(hr);
+    /* a text that is not a JSON object is not an error here, the null result says so */
+    if (hr == WEB_E_INVALID_JSON_STRING) hr = S_OK;
+    return hr;
+}
+
+static const struct IJsonObjectStaticsVtbl object_statics_vtbl =
+{
+    object_statics_QueryInterface, object_statics_AddRef, object_statics_Release,
+    object_statics_GetIids, object_statics_GetRuntimeClassName, object_statics_GetTrustLevel,
+    object_statics_Parse, object_statics_TryParse,
+};
+
 static struct json_object_statics json_object_statics =
 {
     {&factory_vtbl},
+    {&object_statics_vtbl},
     1,
 };
 
