     if (!iid_count || !iids) return E_POINTER;
-    if (!(list = CoTaskMemAlloc( 6 * sizeof(*list) ))) return E_OUTOFMEMORY;
+    if (!(list = CoTaskMemAlloc( 7 * sizeof(*list) ))) return E_OUTOFMEMORY;
     if (impl->type == JsonValueType_Object)
     {
         list[n++] = IID_IJsonObject;
+        list[n++] = IID_IJsonObjectWithDefaultValues;
         list[n++] = IID_IMap_HSTRING_IJsonValue;
         list[n++] = IID_IIterable_IKeyValuePair_HSTRING_IJsonValue;
     }
@@ -959,6 +984,96 @@
     json_object_GetNamedBoolean,
 };
 
+/* ---- IJsonObjectWithDefaultValues ---- */
+
+/* Stained Glass OS 7721: the named value, or the default when the object has no such value or it is
+ * of another type (GUESS: Windows' handling of another type is not documented). PowerToys' runner
+ * reads its settings with these (C++/WinRT GetNamed*(name, default)); without the interface it
+ * stopped at its start (E_NOINTERFACE, std::terminate). */
+DEFINE_IINSPECTABLE( json_object_defaults, IJsonObjectWithDefaultValues, struct json_value, IJsonValue_iface )
+
+static IJsonObject *defaults_object( IJsonObjectWithDefaultValues *iface )
+{
+    return &CONTAINING_RECORD( iface, struct json_value, IJsonObjectWithDefaultValues_iface )->IJsonObject_iface;
+}
+
+static HRESULT WINAPI json_object_defaults_GetNamedValueOrDefault( IJsonObjectWithDefaultValues *iface, HSTRING name,
+                                                                   IJsonValue *default_value, IJsonValue **value )
+{
+    TRACE( "iface %p, name %s, default_value %p, value %p.\n", iface, debugstr_hstring( name ), default_value, value );
+    if (!value) return E_POINTER;
+    if (SUCCEEDED(json_object_GetNamedValue( defaults_object( iface ), name, value ))) return S_OK;
+    if ((*value = default_value)) IJsonValue_AddRef( default_value );
+    return S_OK;
+}
+
+static HRESULT WINAPI json_object_defaults_GetNamedObjectOrDefault( IJsonObjectWithDefaultValues *iface, HSTRING name,
+                                                                    IJsonObject *default_value, IJsonObject **value )
+{
+    TRACE( "iface %p, name %s, default_value %p, value %p.\n", iface, debugstr_hstring( name ), default_value, value );
+    if (!value) return E_POINTER;
+    if (SUCCEEDED(json_object_GetNamedObject( defaults_object( iface ), name, value ))) return S_OK;
+    if ((*value = default_value)) IJsonObject_AddRef( default_value );
+    return S_OK;
+}
+
+static HRESULT WINAPI json_object_defaults_GetNamedStringOrDefault( IJsonObjectWithDefaultValues *iface, HSTRING name,
+                                                                    HSTRING default_value, HSTRING *value )
+{
+    TRACE( "iface %p, name %s, default_value %s, value %p.\n", iface, debugstr_hstring( name ), debugstr_hstring( default_value ), value );
+    if (!value) return E_POINTER;
+    if (SUCCEEDED(json_object_GetNamedString( defaults_object( iface ), name, value ))) return S_OK;
+    return WindowsDuplicateString( default_value, value );
+}
+
+static HRESULT WINAPI json_object_defaults_GetNamedArrayOrDefault( IJsonObjectWithDefaultValues *iface, HSTRING name,
+                                                                   IJsonArray *default_value, IJsonArray **value )
+{
+    TRACE( "iface %p, name %s, default_value %p, value %p.\n", iface, debugstr_hstring( name ), default_value, value );
+    if (!value) return E_POINTER;
+    if (SUCCEEDED(json_object_GetNamedArray( defaults_object( iface ), name, value ))) return S_OK;
+    if ((*value = default_value)) IJsonArray_AddRef( default_value );
+    return S_OK;
+}
+
+static HRESULT WINAPI json_object_defaults_GetNamedNumberOrDefault( IJsonObjectWithDefaultValues *iface, HSTRING name,
+                                                                    DOUBLE default_value, DOUBLE *value )
+{
+    TRACE( "iface %p, name %s, default_value %f, value %p.\n", iface, debugstr_hstring( name ), default_value, value );
+    if (!value) return E_POINTER;
+    if (SUCCEEDED(json_object_GetNamedNumber( defaults_object( iface ), name, value ))) return S_OK;
+    *value = default_value;
+    return S_OK;
+}
+
+static HRESULT WINAPI json_object_defaults_GetNamedBooleanOrDefault( IJsonObjectWithDefaultValues *iface, HSTRING name,
+                                                                     boolean default_value, boolean *value )
+{
+    TRACE( "iface %p, name %s, default_value %d, value %p.\n", iface, debugstr_hstring( name ), default_value, value );
+    if (!value) return E_POINTER;
+    if (SUCCEEDED(json_object_GetNamedBoolean( defaults_object( iface ), name, value ))) return S_OK;
+    *value = default_value;
+    return S_OK;
+}
+
+static const IJsonObjectWithDefaultValuesVtbl json_object_defaults_vtbl =
+{
+    json_object_defaults_QueryInterface,
+    json_object_defaults_AddRef,
+    json_object_defaults_Release,
+    /* IInspectable methods */
+    json_object_defaults_GetIids,
+    json_object_defaults_GetRuntimeClassName,
+    json_object_defaults_GetTrustLevel,
+    /* IJsonObjectWithDefaultValues methods */
+    json_object_defaults_GetNamedValueOrDefault,
+    json_object_defaults_GetNamedObjectOrDefault,
+    json_object_defaults_GetNamedStringOrDefault,
+    json_object_defaults_GetNamedArrayOrDefault,
+    json_object_defaults_GetNamedNumberOrDefault,
+    json_object_defaults_GetNamedBooleanOrDefault,
+};
+
 /* ---- IJsonArray ---- */
 
 DEFINE_IINSPECTABLE( json_array, IJsonArray, struct json_value, IJsonValue_iface )
@@ -2017,7 +2132,7 @@
 
 /* ---- the JsonArray class ---- */
 
-struct json_array_factory { IActivationFactory IActivationFactory_iface; LONG ref; };
+struct json_array_factory { IActivationFactory IActivationFactory_iface; IJsonArrayStatics IJsonArrayStatics_iface; LONG ref; };
 
 static inline struct json_array_factory *array_factory_from( IActivationFactory *iface )
 {
@@ -2039,6 +2154,14 @@
         IInspectable_AddRef( *out );
         return S_OK;
     }
+#ifndef SG_MUTANT_JSON_NO_PARSE_STATICS
+    if (IsEqualGUID( iid, &IID_IJsonArrayStatics ))
+    {
+        *out = &impl->IJsonArrayStatics_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+#endif
 
     FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
@@ -2102,7 +2225,42 @@
     array_factory_ActivateInstance,
 };
 
-static struct json_array_factory json_array_statics = { {&array_factory_vtbl}, 1 };
+DEFINE_IINSPECTABLE( array_statics, IJsonArrayStatics, struct json_array_factory, IActivationFactory_iface )
+
+static HRESULT WINAPI array_statics_Parse( IJsonArrayStatics *iface, HSTRING input, IJsonArray **value )
+{
+    IInspectable *parsed;
+    HRESULT hr;
+
+    TRACE( "iface %p, input %s, value %p.\n", iface, debugstr_hstring( input ), value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = json_parse_array( input, &parsed ))) return hr;
+    hr = IInspectable_QueryInterface( parsed, &IID_IJsonArray, (void **)value );
+    IInspectable_Release( parsed );
+    return hr;
+}
+
+static HRESULT WINAPI array_statics_TryParse( IJsonArrayStatics *iface, HSTRING input, IJsonArray **result, boolean *succeeded )
+{
+    HRESULT hr;
+
+    TRACE( "iface %p, input %s, result %p, succeeded %p.\n", iface, debugstr_hstring( input ), result, succeeded );
+    if (!result || !succeeded) return E_POINTER;
+    hr = array_statics_Parse( iface, input, result );
+    *succeeded = SUCCEEDED(hr);
+    if (hr == WEB_E_INVALID_JSON_STRING) hr = S_OK;
+    return hr;
+}
+
+static const struct IJsonArrayStaticsVtbl array_statics_vtbl =
+{
+    array_statics_QueryInterface, array_statics_AddRef, array_statics_Release,
+    array_statics_GetIids, array_statics_GetRuntimeClassName, array_statics_GetTrustLevel,
+    array_statics_Parse, array_statics_TryParse,
+};
+
+static struct json_array_factory json_array_statics = { {&array_factory_vtbl}, {&array_statics_vtbl}, 1 };
 IActivationFactory *json_array_factory = &json_array_statics.IActivationFactory_iface;
 
 /* ---- the JsonValue statics ---- */
