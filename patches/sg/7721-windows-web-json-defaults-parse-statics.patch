--- a/dlls/windows.web/json_value.c
+++ b/dlls/windows.web/json_value.c
@@ -38,10 +38,13 @@
 /* One structure serves JsonValue, JsonObject and JsonArray: the value's
  * interfaces are the same object, as GetObject / GetArray hand back the
  * value itself. */
+static const IJsonObjectWithDefaultValuesVtbl json_object_defaults_vtbl;
+
 struct json_value
 {
     IJsonValue IJsonValue_iface;
     IJsonObject IJsonObject_iface;
+    IJsonObjectWithDefaultValues IJsonObjectWithDefaultValues_iface;
     IJsonArray IJsonArray_iface;
     IStringable IStringable_iface;
     IVector_IJsonValue IVector_IJsonValue_iface;
@@ -233,6 +236,7 @@
     if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
     impl->IJsonValue_iface.lpVtbl = &json_value_vtbl;
     impl->IJsonObject_iface.lpVtbl = &json_object_vtbl;
+    impl->IJsonObjectWithDefaultValues_iface.lpVtbl = &json_object_defaults_vtbl;
     impl->IJsonArray_iface.lpVtbl = &json_array_vtbl;
     impl->IStringable_iface.lpVtbl = &json_stringable_vtbl;
     impl->IVector_IJsonValue_iface.lpVtbl = &json_vector_vtbl;
@@ -572,6 +576,22 @@
     return S_OK;
 }
 
+/* Stained Glass OS 7721: a JSON text that must be an array */
+HRESULT json_parse_array( HSTRING input, IInspectable **out )
+{
+    struct json_value *value;
+    HRESULT hr;
+
+    if (FAILED(hr = json_parse( input, &value ))) return hr;
+    if (value->type != JsonValueType_Array)
+    {
+        IJsonValue_Release( &value->IJsonValue_iface );
+        return WEB_E_INVALID_JSON_STRING;
+    }
+    *out = (IInspectable *)&value->IJsonValue_iface;
+    return S_OK;
+}
+
 HRESULT json_parse_object( HSTRING input, IInspectable **out )
 {
     struct json_value *value;
@@ -604,6 +624,10 @@
         *out = &impl->IStringable_iface;
     else if (impl->type == JsonValueType_Object && IsEqualGUID( iid, &IID_IJsonObject ))
         *out = &impl->IJsonObject_iface;
+#ifndef SG_MUTANT_JSON_NO_DEFAULTS
+    else if (impl->type == JsonValueType_Object && IsEqualGUID( iid, &IID_IJsonObjectWithDefaultValues ))
+        *out = &impl->IJsonObjectWithDefaultValues_iface;
+#endif
     else if (impl->type == JsonValueType_Array && IsEqualGUID( iid, &IID_IJsonArray ))
