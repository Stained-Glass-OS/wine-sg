+    {
+        HRESULT GetNamedValueOrDefault([in] HSTRING name, [in] Windows.Data.Json.JsonValue *default_value, [out, retval] Windows.Data.Json.JsonValue **value);
+        HRESULT GetNamedObjectOrDefault([in] HSTRING name, [in] Windows.Data.Json.JsonObject *default_value, [out, retval] Windows.Data.Json.JsonObject **value);
+        HRESULT GetNamedStringOrDefault([in] HSTRING name, [in] HSTRING default_value, [out, retval] HSTRING *value);
+        HRESULT GetNamedArrayOrDefault([in] HSTRING name, [in] Windows.Data.Json.JsonArray *default_value, [out, retval] Windows.Data.Json.JsonArray **value);
+        HRESULT GetNamedNumberOrDefault([in] HSTRING name, [in] DOUBLE default_value, [out, retval] DOUBLE *value);
+        HRESULT GetNamedBooleanOrDefault([in] HSTRING name, [in] boolean default_value, [out, retval] boolean *value);
+    }
+
     [
         contract(Windows.Foundation.UniversalApiContract, 1.0),
