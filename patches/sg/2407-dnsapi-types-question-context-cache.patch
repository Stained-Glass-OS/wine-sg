+
+#define DNS_CACHE_ENTRY_HOSTS 0x1
+
+static void add_cache_entry( DNS_CACHE_ENTRY ***tail, const char *name, WORD type, WORD data_len )
+{
+    DNS_CACHE_ENTRY *entry;
+    WCHAR *wname;
+
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return;
+    if (!(wname = strdup_uw( name ))) { free( entry ); return; }
+    entry->Name = wname;
+    entry->Type = type;
+    entry->DataLength = data_len;
+    entry->Flags = DNS_CACHE_ENTRY_HOSTS;
+    **tail = entry;
+    *tail = &entry->Next;
+}
+
+/******************************************************************************
+ * DnsGetCacheDataTable               [DNSAPI.@]
+ *
+ * What the resolver knows without asking a server: one A or AAAA entry for
+ * every name in the hosts file, plus localhost. The entries and their names are separate
+ * allocations, each of which can be freed with DnsFree( ..., DnsFreeFlat ).
+ */
+BOOL WINAPI DnsGetCacheDataTable( PDNS_CACHE_ENTRY *table )
+{
+    static const WCHAR hosts[] = L"\\drivers\\etc\\hosts";
+    WCHAR path[MAX_PATH];
+    DNS_CACHE_ENTRY *head = NULL, **tail = &head;
+    HANDLE file;
+    DWORD size, read = 0, pos;
+    char *data;
+    UINT len;
+
+    TRACE( "(%p)\n", table );
+
+    if (!table)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *table = NULL;
+
+    len = GetSystemDirectoryW( path, MAX_PATH );
+    if (!len || len + ARRAY_SIZE(hosts) >= MAX_PATH) return FALSE;
+    lstrcpyW( path + len, hosts );
+
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+                        FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    size = GetFileSize( file, NULL );
+    if (size == INVALID_FILE_SIZE || size > 1024 * 1024 || !(data = malloc( size + 1 )))
+    {
+        CloseHandle( file );
+        return FALSE;
+    }
+    if (!ReadFile( file, data, size, &read, NULL )) read = 0;
+    CloseHandle( file );
+    data[read] = 0;
+
+    for (pos = 0; pos < read;)
+    {
+        char *line = data + pos, *p, *eol = strchr( line, '\n' );
+        BOOL first = TRUE;
+        WORD type = DNS_TYPE_A;
+
+        if (eol) *eol = 0;
+        pos += strlen( line ) + 1;
+        if ((p = strchr( line, '#' ))) *p = 0;
+
+        p = line;
+        for (;;)
+        {
+            char *tok;
+
+            while (*p == ' ' || *p == '\t' || *p == '\r') p++;
+            if (!*p) break;
+            tok = p;
+            while (*p && *p != ' ' && *p != '\t' && *p != '\r') p++;
+            if (*p) *p++ = 0;
+#ifdef SG_MUTANT_DNH_CACHE
+            if (!first) break;
+#endif
+            if (first)
+            {
+                type = strchr( tok, ':' ) ? DNS_TYPE_AAAA : DNS_TYPE_A;
+                first = FALSE;
+            }
+            else add_cache_entry( &tail, tok, type, type == DNS_TYPE_AAAA ? 16 : 4 );
+        }
+    }
+    free( data );
+
+    /* localhost resolves without a hosts file entry */
+    {
+        static const WORD types[] = { DNS_TYPE_A, DNS_TYPE_AAAA };
+        unsigned int i;
+        DNS_CACHE_ENTRY *e;
+
+        for (i = 0; i < ARRAY_SIZE(types); i++)
+        {
+            for (e = head; e; e = e->Next)
+                if (e->Type == types[i] && !wcsicmp( e->Name, L"localhost" )) break;
+            if (!e) add_cache_entry( &tail, "localhost", types[i], types[i] == DNS_TYPE_AAAA ? 16 : 4 );
+        }
+    }
+    *table = head;
+    return head != NULL;
+}
