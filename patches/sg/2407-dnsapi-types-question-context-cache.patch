+/******************************************************************************
+ * DnsRecordStringForType               [DNSAPI.@]
+ *
+ * The name of a record type, NULL when the type has none.
+ */
+const char * WINAPI DnsRecordStringForType( WORD type )
+{
+    unsigned int i;
+
+    TRACE( "%#x\n", type );
+
+#ifdef SG_MUTANT_DNH_TYPES
+    if (type == DNS_TYPE_SRV) return "SVR";
+#endif
+    for (i = 0; i < ARRAY_SIZE(type_names); i++)
+        if (type_names[i].type == type) return type_names[i].name;
+    return NULL;
+}
+
+/******************************************************************************
+ * DnsRecordStringForWritableType       [DNSAPI.@]
+ *
+ * Only the types a record can be built for have a name here: not the query
+ * types (IXFR, AXFR, MAILB, MAILA, ALL) and not OPT or the transaction types.
+ */
+const char * WINAPI DnsRecordStringForWritableType( WORD type )
+{
+    TRACE( "%#x\n", type );
+
+    switch (type)
+    {
+    case DNS_TYPE_OPT:
+    case DNS_TYPE_TKEY:
+    case DNS_TYPE_TSIG:
+    case DNS_TYPE_IXFR:
+    case DNS_TYPE_AXFR:
+    case DNS_TYPE_MAILB:
+    case DNS_TYPE_MAILA:
+#ifndef SG_MUTANT_DNH_WRITABLE
+    case DNS_TYPE_ALL:
+#endif
+        return NULL;
+    }
+    return DnsRecordStringForType( type );
+}
+
+/******************************************************************************
+ * DnsRecordTypeForName                 [DNSAPI.@]
+ *
+ * The type for a name, ignoring case, given its length or -1 or 0 when it is
+ * NUL-terminated. A name of the form TYPEnnn is type nnn. 0 means unknown.
+ */
+WORD WINAPI DnsRecordTypeForName( const char *name, int len )
+{
+    unsigned int i;
+    char *end;
+    unsigned long n;
+
+    TRACE( "%s, %d\n", debugstr_an( name, len > 0 ? len : 0 ), len );
+
+    if (!name) return 0;
+    if (len <= 0) len = strlen( name );
+    if (!len) return 0;
+
+    for (i = 0; i < ARRAY_SIZE(type_names); i++)
+    {
+        if (strlen( type_names[i].name ) == len && 
+#ifdef SG_MUTANT_DNH_CASE
+            !strncmp( name, type_names[i].name, len )
+#else
+            !_strnicmp( name, type_names[i].name, len )
+#endif
+            )
+            return type_names[i].type;
+    }
+    if (len > 4 && len < 10 && !_strnicmp( name, "TYPE", 4 ))
+    {
+        char buf[16];
+        memcpy( buf, name + 4, len - 4 );
+        buf[len - 4] = 0;
+        n = strtoul( buf, &end, 10 );
+        if (!*end && isdigit( (unsigned char)buf[0] ) && n && n <= 0xffff) return n;
+    }
+    return 0;
+}
+
+/* The length of a name in wire format, or 0 if it cannot be written. */
+static int wire_name_length( const char *name )
+{
+    int len = strlen( name ), label = 0, i;
+
+    if (!len || (len == 1 && name[0] == '.')) return 1;
+    if (name[len - 1] == '.') len--;
+    if (!len) return 0;
+    for (i = 0; i < len; i++)
+    {
+        if (name[i] == '.')
+        {
+            if (!label || label > 63) return 0;
+            label = 0;
+        }
+        else label++;
+    }
+    if (!label || label > 63) return 0;
+    if (len + 2 > 255) return 0;
+    return len + 2;
+}
+
+static BYTE *write_wire_name( BYTE *dst, const char *name )
+{
+    int len = strlen( name ), start = 0, i;
+
+    if (len && name[len - 1] == '.') len--;
+    for (i = 0; i <= len; i++)
+    {
+        if (i < len && name[i] != '.') continue;
+        if (i > start)
+        {
+            *dst++ = i - start;
+            memcpy( dst, name + start, i - start );
+            dst += i - start;
+        }
+        start = i + 1;
+    }
+    *dst++ = 0;
+    return dst;
+}
+
+/******************************************************************************
+ * DnsWriteQuestionToBuffer_UTF8          [DNSAPI.@]
+ *
+ * Builds a query for one name and type in the buffer: the header (in host
+ * byte order, as DNS_BYTE_FLIP_HEADER_COUNTS expects it) and the question
+ * in wire format. The size is that of the buffer on input and of the
+ * message on output; when the buffer is too small it is the size needed.
+ */
+BOOL WINAPI DnsWriteQuestionToBuffer_UTF8( DNS_MESSAGE_BUFFER *buffer, DWORD *size, const char *name, WORD type,
+                                           WORD xid, BOOL recurse )
+{
+    int namelen;
+    DWORD need;
+    BYTE *ptr;
+    WORD w;
+
+    TRACE( "%p, %p, %s, %d, %d, %d\n", buffer, size, debugstr_a(name), type, xid, recurse );
+
+    if (!buffer || !size || !name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+#ifdef SG_MUTANT_DNH_NAME
+    if (!(namelen = strlen( name ) + 2) || strstr( name, ".." ) == name)
+#else
+    if (!(namelen = wire_name_length( name )))
+#endif
+    {
+        SetLastError( ERROR_INVALID_NAME );
+        return FALSE;
+    }
+    need = sizeof(DNS_HEADER) + namelen + 4;
+#ifdef SG_MUTANT_DNH_SIZE
+    if (0)
+#else
+    if (*size < need)
+#endif
+    {
+        *size = need;
+        SetLastError( ERROR_MORE_DATA );
+        return FALSE;
+    }
+
+    memset( &buffer->MessageHead, 0, sizeof(buffer->MessageHead) );
+#ifdef SG_MUTANT_DNH_XID
+    buffer->MessageHead.Xid = (xid >> 8) | (xid << 8);
+#else
+    buffer->MessageHead.Xid = xid;
+#endif
+    buffer->MessageHead.RecursionDesired = !!recurse;
+    buffer->MessageHead.QuestionCount = 1;
+    ptr = write_wire_name( (BYTE *)buffer->MessageBody, name );
+    w = type;
+#ifdef SG_MUTANT_DNH_WIRE
+    *ptr++ = w; *ptr++ = w >> 8;
+#else
+    *ptr++ = w >> 8; *ptr++ = w;
+#endif
+    *ptr++ = 0; *ptr++ = 1;  /* class IN */
+    *size = ptr - (BYTE *)buffer;
+    return TRUE;
+}
+
+/******************************************************************************
+ * DnsWriteQuestionToBuffer_W             [DNSAPI.@]
+ */
+BOOL WINAPI DnsWriteQuestionToBuffer_W( DNS_MESSAGE_BUFFER *buffer, DWORD *size, const WCHAR *name, WORD type,
+                                        WORD xid, BOOL recurse )
+{
+    char *utf8;
+    BOOL ret;
+
+    TRACE( "%p, %p, %s, %d, %d, %d\n", buffer, size, debugstr_w(name), type, xid, recurse );
+
+    if (!buffer || !size || !name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(utf8 = strdup_wu( name )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    ret = DnsWriteQuestionToBuffer_UTF8( buffer, size, utf8, type, xid, recurse );
+    free( utf8 );
+    return ret;
+}
+
+struct dns_context
+{
+    DWORD flags;
+    BOOL  has_credentials;
+};
+
+static DNS_STATUS acquire_context( DWORD flags, void *cred, HANDLE *handle )
+{
+    struct dns_context *ctx;
+
+#ifdef SG_MUTANT_DNH_CTX
+    if (!handle) return ERROR_SUCCESS;
+#else
+    if (!handle) return ERROR_INVALID_PARAMETER;
+#endif
+    if (!(ctx = calloc( 1, sizeof(*ctx) ))) return ERROR_OUTOFMEMORY;
+    ctx->flags = flags;
+    ctx->has_credentials = cred != NULL;
+    *handle = ctx;
+    return ERROR_SUCCESS;
+}
+
+/******************************************************************************
+ * DnsAcquireContextHandle_A              [DNSAPI.@]
+ */
+DNS_STATUS WINAPI DnsAcquireContextHandle_A( DWORD flags, void *cred, HANDLE *context )
+{
+    TRACE( "(%#lx, %p, %p)\n", flags, cred, context );
+    return acquire_context( flags, cred, context );
+}
+
+/******************************************************************************
+ * DnsAcquireContextHandle_UTF8              [DNSAPI.@]
+ */
+DNS_STATUS WINAPI DnsAcquireContextHandle_UTF8( DWORD flags, void *cred, HANDLE *context )
+{
+    TRACE( "(%#lx, %p, %p)\n", flags, cred, context );
+    return acquire_context( flags, cred, context );
+}
+
+/******************************************************************************
+ * DnsAcquireContextHandle_W              [DNSAPI.@]
+ */
+DNS_STATUS WINAPI DnsAcquireContextHandle_W( DWORD flags, void *cred, HANDLE *context )
+{
+    TRACE( "(%#lx, %p, %p)\n", flags, cred, context );
+    return acquire_context( flags, cred, context );
+}
+
+/******************************************************************************
+ * DnsReleaseContextHandle                [DNSAPI.@]
+ */
+VOID WINAPI DnsReleaseContextHandle( HANDLE context )
+{
+    TRACE( "(%p)\n", context );
+    free( context );
+}
+
+/******************************************************************************
+ * DnsFlushResolverCache               [DNSAPI.@]
+ *
+ * There is no cache of resolved names to flush: the system resolver keeps
+ * its own, and what is left, the hosts file, is not a cache.
+ */
+VOID WINAPI DnsFlushResolverCache(void)
+{
+    TRACE( "\n" );
+}
