+/******************************************************************************
+ * DnsFlushResolverCacheEntry_A               [DNSAPI.@]
+ */
+BOOL WINAPI DnsFlushResolverCacheEntry_A( PCSTR entry )
+{
+    TRACE( "%s\n", debugstr_a(entry) );
