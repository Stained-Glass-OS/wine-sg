+
+    if (!(style & WS_VISIBLE) || (style & WS_MINIMIZE)) return TRUE;
+    if ((style & WS_CAPTION) != WS_CAPTION) return TRUE;
+    if (exstyle & WS_EX_TOOLWINDOW) return TRUE;
