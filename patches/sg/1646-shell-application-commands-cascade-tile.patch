 static HRESULT WINAPI ShellDispatch_GetSystemInformation(IShellDispatch6 *iface, BSTR name, VARIANT *ret)
 {
-    FIXME("(%s, %p): stub\n", debugstr_w(name), ret);
-    return E_NOTIMPL;
