+    GetNativeSystemInfo(&si);
+
+    if (!wcsicmp(name, L"DirectoryServiceAvailable"))
+    {
+        V_VT(ret) = VT_BOOL;
+        V_BOOL(ret) = IsOS(OS_DOMAINMEMBER) ? VARIANT_TRUE : VARIANT_FALSE;
+    }
+    else if (!wcsicmp(name, L"DoubleClickTime"))
+    {
+        V_VT(ret) = VT_I4;
+        V_I4(ret) = GetDoubleClickTime();
+    }
+    else if (!wcsicmp(name, L"ProcessorLevel"))
+    {
+        V_VT(ret) = VT_I4;
+        V_I4(ret) = si.wProcessorLevel;
+    }
+    else if (!wcsicmp(name, L"ProcessorArchitecture"))
+    {
+        V_VT(ret) = VT_I4;
+        V_I4(ret) = si.wProcessorArchitecture;
+    }
+    else if (!wcsicmp(name, L"ProcessorSpeed"))
+    {
+        DWORD mhz = 0, size = sizeof(mhz);
+        RegGetValueW(HKEY_LOCAL_MACHINE, L"HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0", L"~MHz",
+                     RRF_RT_REG_DWORD, NULL, &mhz, &size);
+        V_VT(ret) = VT_I4;
+        V_I4(ret) = mhz;
+    }
+    else if (!wcsicmp(name, L"PhysicalMemoryInstalled"))
+    {
+        MEMORYSTATUSEX ms = { sizeof(ms) };
+        GlobalMemoryStatusEx(&ms);
+        V_VT(ret) = VT_R8;
+        V_R8(ret) = (double)ms.ullTotalPhys;
+    }
+    else if (!wcsnicmp(name, L"IsOS_", 5))
+    {
+        static const struct { const WCHAR *name; DWORD os; } oses[] =
+        {
+            { L"IsOS_Professional", OS_PROFESSIONAL },
+            { L"IsOS_Personal", OS_HOME },
+            { L"IsOS_DomainMember", OS_DOMAINMEMBER },
+        };
+        unsigned int i;
+
+        for (i = 0; i < ARRAY_SIZE(oses); i++) if (!wcsicmp(name, oses[i].name)) break;
+        if (i == ARRAY_SIZE(oses)) return E_INVALIDARG;
+        V_VT(ret) = VT_BOOL;
+        V_BOOL(ret) = IsOS(oses[i].os) ? VARIANT_TRUE : VARIANT_FALSE;
+    }
+    else
+        return E_INVALIDARG;
+    return S_OK;
+}
