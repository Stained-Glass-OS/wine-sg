+static BOOL tray_command(UINT id)
+{
+    HWND tray = FindWindowW(L"Shell_TrayWnd", NULL);
+
+    if (!tray) return FALSE;
+    PostMessageW(tray, WM_COMMAND, id, 0);
+    return TRUE;
+}
+
+/* a folder given as a path or a CSIDL, as NameSpace takes it */
+static HRESULT pidl_from_variant(VARIANT *dir, LPITEMIDLIST *pidl)
+{
+    VARIANT v;
+    HRESULT hr;
+
+    *pidl = NULL;
+    VariantInit(&v);
+    if (FAILED(hr = VariantCopyInd(&v, dir))) return hr;
+    switch (V_VT(&v))
+    {
+    case VT_I2: case VT_I4: case VT_UI1: case VT_UI2: case VT_UI4: case VT_INT: case VT_UINT:
+        if (FAILED(hr = VariantChangeType(&v, &v, 0, VT_I4))) break;
+        hr = SHGetFolderLocation(NULL, V_I4(&v), NULL, 0, pidl);
+        break;
+    case VT_BSTR:
+        hr = SHParseDisplayName(V_BSTR(&v), NULL, pidl, 0, NULL);
+        break;
+    case VT_DISPATCH:
+    {
+        Folder *folder;
+        if (V_DISPATCH(&v) && SUCCEEDED(IDispatch_QueryInterface(V_DISPATCH(&v), &IID_Folder, (void **)&folder)))
+        {
+            *pidl = ILClone(impl_from_Folder((Folder3 *)folder)->pidl);
+            hr = *pidl ? S_OK : E_OUTOFMEMORY;
+            Folder_Release(folder);
+        }
+        else hr = E_INVALIDARG;
+        break;
+    }
+    default:
+        hr = E_INVALIDARG;
+    }
+    VariantClear(&v);
+    return hr;
+}
+
+static HRESULT open_folder(VARIANT *dir, const WCHAR *verb)
+{
+    SHELLEXECUTEINFOW info = { sizeof(info) };
+    LPITEMIDLIST pidl;
+    HRESULT hr;
+
+    /* a folder that is not there: nothing happens, and no error */
+    if (FAILED(hr = pidl_from_variant(dir, &pidl))) return S_FALSE;
+    info.fMask = SEE_MASK_IDLIST | SEE_MASK_FLAG_NO_UI;
+    info.lpIDList = pidl;
+    info.lpVerb = verb;
+    info.nShow = SW_SHOWNORMAL;
+    hr = ShellExecuteExW(&info) ? S_OK : S_FALSE;
+    ILFree(pidl);
+    return hr;
+}
