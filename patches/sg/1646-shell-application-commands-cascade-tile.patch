+/* start or stop a service, as Windows' Shell.Application does it: the
+ * caller's rights decide; "persistent" also makes it start, or not, with
+ * the system */
+static HRESULT change_service(BSTR name, VARIANT *persistent, VARIANT *ret, BOOL start)
+{
+    SC_HANDLE scm, service;
+    SERVICE_STATUS status;
+    VARIANT persist;
+    BOOL ok;
+
+    if (!ret) return E_POINTER;
+    V_VT(ret) = VT_BOOL;
+    V_BOOL(ret) = VARIANT_FALSE;
+    if (!(scm = OpenSCManagerW(NULL, NULL, SC_MANAGER_CONNECT))) return S_OK;
+    if (!(service = OpenServiceW(scm, name, (start ? SERVICE_START : SERVICE_STOP) | SERVICE_CHANGE_CONFIG)) &&
+        !(service = OpenServiceW(scm, name, start ? SERVICE_START : SERVICE_STOP)))
+    {
+        CloseServiceHandle(scm);
+        return S_OK;
+    }
+    ok = start ? StartServiceW(service, 0, NULL) || GetLastError() == ERROR_SERVICE_ALREADY_RUNNING
+               : ControlService(service, SERVICE_CONTROL_STOP, &status) || GetLastError() == ERROR_SERVICE_NOT_ACTIVE;
+    VariantInit(&persist);
+    if (ok && V_VT(persistent) != VT_ERROR && V_VT(persistent) != VT_EMPTY &&
+        SUCCEEDED(VariantChangeType(&persist, persistent, 0, VT_BOOL)) && V_BOOL(&persist))
+        ChangeServiceConfigW(service, SERVICE_NO_CHANGE, start ? SERVICE_AUTO_START : SERVICE_DEMAND_START,
+                             SERVICE_NO_CHANGE, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
+    V_BOOL(ret) = ok ? VARIANT_TRUE : VARIANT_FALSE;
+    CloseServiceHandle(service);
+    CloseServiceHandle(scm);
+    return S_OK;
 }
 
