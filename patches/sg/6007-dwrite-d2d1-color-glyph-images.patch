+/* Stained Glass OS: glyphs drawn from their images (CBDT/sbix PNG, JPEG, TIFF:
+ * color emoji fonts), each the size of its strike scaled to the run's em size,
+ * placed by the image's origin */
+HRESULT WINAPI WICCreateImagingFactory_Proxy(UINT sdk_version, IWICImagingFactory **factory);
+
+static HRESULT d2d_glyph_image_bitmap(struct d2d_device_context *context, const DWRITE_GLYPH_IMAGE_DATA *data,
+        ID2D1Bitmap1 **bitmap)
+{
+    IWICFormatConverter *converter = NULL;
+    IWICBitmapFrameDecode *frame = NULL;
+    IWICBitmapDecoder *decoder = NULL;
+    IWICImagingFactory *wic;
+    IWICStream *stream = NULL;
+    HRESULT hr;
+
+    *bitmap = NULL;
+    if (FAILED(hr = WICCreateImagingFactory_Proxy(WINCODEC_SDK_VERSION, &wic))) return hr;
+    if (SUCCEEDED(hr = IWICImagingFactory_CreateStream(wic, &stream))
+            && SUCCEEDED(hr = IWICStream_InitializeFromMemory(stream, (BYTE *)data->imageData, data->imageDataSize))
+            && SUCCEEDED(hr = IWICImagingFactory_CreateDecoderFromStream(wic, (IStream *)stream, NULL,
+                    WICDecodeMetadataCacheOnDemand, &decoder))
+            && SUCCEEDED(hr = IWICBitmapDecoder_GetFrame(decoder, 0, &frame))
+            && SUCCEEDED(hr = IWICImagingFactory_CreateFormatConverter(wic, &converter))
+            && SUCCEEDED(hr = IWICFormatConverter_Initialize(converter, (IWICBitmapSource *)frame,
+                    &GUID_WICPixelFormat32bppPBGRA, WICBitmapDitherTypeNone, NULL, 0.0, WICBitmapPaletteTypeCustom)))
+    {
+        D2D1_BITMAP_PROPERTIES1 props = { { DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED },
+                96.0f, 96.0f, D2D1_BITMAP_OPTIONS_NONE, NULL };
+        hr = ID2D1DeviceContext6_CreateBitmapFromWicBitmap(&context->ID2D1DeviceContext6_iface,
+                (IWICBitmapSource *)converter, &props, bitmap);
+    }
+    if (converter) IWICFormatConverter_Release(converter);
+    if (frame) IWICBitmapFrameDecode_Release(frame);
+    if (decoder) IWICBitmapDecoder_Release(decoder);
+    if (stream) IWICStream_Release(stream);
+    IWICImagingFactory_Release(wic);
+    return hr;
+}
+
+/* the strike to ask for: the run's size in device pixels */
+static UINT32 d2d_glyph_run_ppem(struct d2d_device_context *context, const DWRITE_GLYPH_RUN *run)
+{
+    const D2D1_MATRIX_3X2_F *m = &context->drawing_state.transform;
+    float scale = sqrtf(fabsf(m->_11 * m->_22 - m->_12 * m->_21));
+    float ppem = run->fontEmSize * context->desc.dpiY / 96.0f * (scale > 0.0f ? scale : 1.0f);
+    return ppem < 1.0f ? 1 : (UINT32)(ppem + 0.5f);
+}
+
+static float d2d_glyph_advance(IDWriteFontFace *face, const DWRITE_GLYPH_RUN *run, UINT32 i)
+{
+    DWRITE_GLYPH_METRICS metrics;
+    DWRITE_FONT_METRICS font_metrics;
+
+    if (run->glyphAdvances) return run->glyphAdvances[i];
+    IDWriteFontFace_GetMetrics(face, &font_metrics);
+    if (FAILED(IDWriteFontFace_GetDesignGlyphMetrics(face, &run->glyphIndices[i], 1, &metrics, run->isSideways)))
+        return 0.0f;
+    return (float)metrics.advanceWidth * run->fontEmSize / font_metrics.designUnitsPerEm;
+}
+
+/* one glyph's image, the bitmap and the rectangle it covers; S_FALSE: no image */
+static HRESULT d2d_glyph_image(struct d2d_device_context *context, IDWriteFontFace4 *face4,
+        DWRITE_GLYPH_IMAGE_FORMATS format, UINT16 glyph, float em_size, UINT32 ppem, D2D1_POINT_2F origin,
+        ID2D1Bitmap1 **bitmap, D2D1_RECT_F *rect)
+{
+    DWRITE_GLYPH_IMAGE_DATA data;
+    void *image_context;
+    float scale;
+    HRESULT hr;
+
+    *bitmap = NULL;
+    if (FAILED(hr = IDWriteFontFace4_GetGlyphImageData(face4, glyph, ppem, format, &data, &image_context)))
+        return hr;
+    if (!data.imageData || !data.pixelsPerEm)
+    {
+        IDWriteFontFace4_ReleaseGlyphImageData(face4, image_context);
+        return S_FALSE;
+    }
+    if (SUCCEEDED(hr = d2d_glyph_image_bitmap(context, &data, bitmap)))
+    {
+        scale = em_size / data.pixelsPerEm;
+#ifdef SG_MUTANT_D2D_GLYPH_UNSCALED
+        scale = 1.0f;
+#endif
+        rect->left = origin.x - data.horizontalLeftOrigin.x * scale;
+        rect->top = origin.y - data.horizontalLeftOrigin.y * scale;
+        rect->right = rect->left + data.pixelSize.width * scale;
+        rect->bottom = rect->top + data.pixelSize.height * scale;
+    }
+    IDWriteFontFace4_ReleaseGlyphImageData(face4, image_context);
+    return hr;
+}
+
+static void d2d_device_context_draw_image_glyph_run(struct d2d_device_context *context,
+        DWRITE_GLYPH_IMAGE_FORMATS format, D2D1_POINT_2F origin, const DWRITE_GLYPH_RUN *run)
+{
+    IDWriteFontFace4 *face4;
+    D2D1_POINT_2F pos;
+    ID2D1Bitmap1 *bitmap;
+    D2D1_RECT_F rect;
+    float x = origin.x, advance;
+    UINT32 ppem, i;
+
+    if (FAILED(context->error.code) || !run || !run->fontFace) return;
+    if (FAILED(IDWriteFontFace_QueryInterface(run->fontFace, &IID_IDWriteFontFace4, (void **)&face4))) return;
+    ppem = d2d_glyph_run_ppem(context, run);
+    for (i = 0; i < run->glyphCount; ++i)
+    {
+        advance = d2d_glyph_advance(run->fontFace, run, i);
+        if (run->bidiLevel & 1) x -= advance;
+        pos.x = x;
+        pos.y = origin.y;
+        if (run->glyphOffsets)
+        {
+            pos.x += (run->bidiLevel & 1) ? -run->glyphOffsets[i].advanceOffset : run->glyphOffsets[i].advanceOffset;
+            pos.y -= run->glyphOffsets[i].ascenderOffset;
+        }
+        if (d2d_glyph_image(context, face4, format, run->glyphIndices[i], run->fontEmSize, ppem, pos,
+                &bitmap, &rect) == S_OK)
+        {
+            ID2D1DeviceContext6_DrawBitmap(&context->ID2D1DeviceContext6_iface, (ID2D1Bitmap *)bitmap, &rect, 1.0f,
+                    D2D1_INTERPOLATION_MODE_LINEAR, NULL, NULL);
+            ID2D1Bitmap1_Release(bitmap);
+        }
+        if (!(run->bidiLevel & 1)) x += advance;
+    }
+    IDWriteFontFace4_Release(face4);
+}
+
