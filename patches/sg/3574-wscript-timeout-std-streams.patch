From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wscript: Timeout, StdIn, StdOut, StdErr (3574)

wscript: WScript.Timeout keeps its value, StdIn/StdOut/StdErr are the standard streams

Timeout is read and written (negative values are refused); the host does not end the script by itself.
StdIn, StdOut and StdErr come from the file system object's GetStandardStream (0, 1, 2), as the Windows script
host does.
---
diff --git a/programs/wscript/host.c b/programs/wscript/host.c
index 2e6ed96..ea91418 100644
--- a/programs/wscript/host.c
+++ b/programs/wscript/host.c
@@ -29,8 +29,12 @@
 
 #include <wine/debug.h>
 
+static const CLSID CLSID_FileSystemObject_wsh = {0x0d43fe01,0xf093,0x11cf,{0x89,0x40,0x00,0xa0,0xc9,0x05,0x42,0x28}};
+
 WINE_DEFAULT_DEBUG_CHANNEL(wscript);
 
+static HRESULT get_standard_stream(int type, ITextStream **ret);
+
 #define BUILDVERSION 16535
 static const WCHAR wshVersionW[] = L"5.8";
 
@@ -269,16 +273,26 @@ static HRESULT WINAPI Host_get_BuildVersion(IHost *iface, int *out_Build)
     return S_OK;
 }
 
+/* seconds after which the host ends the script; 0 for never. The value is kept for the script to read
+ * back; the host does not end the script by itself. */
+static LONG host_timeout;
+
 static HRESULT WINAPI Host_get_Timeout(IHost *iface, LONG *out_Timeout)
 {
-    WINE_FIXME("(%p)\n", out_Timeout);
-    return E_NOTIMPL;
+    WINE_TRACE("(%p)\n", out_Timeout);
+
+    if (!out_Timeout) return E_POINTER;
+    *out_Timeout = host_timeout;
+    return S_OK;
 }
 
 static HRESULT WINAPI Host_put_Timeout(IHost *iface, LONG v)
 {
-    WINE_FIXME("(%ld)\n", v);
-    return E_NOTIMPL;
+    WINE_TRACE("(%ld)\n", v);
+
+    if (v < 0) return E_INVALIDARG;
+    host_timeout = v;
+    return S_OK;
 }
 
 static HRESULT WINAPI Host_CreateObject(IHost *iface, BSTR ProgID, BSTR Prefix,
@@ -410,20 +424,62 @@ static HRESULT WINAPI Host_ConnectObject(IHost *iface, IDispatch *Object, BSTR P
 
 static HRESULT WINAPI Host_get_StdIn(IHost *iface, ITextStream **ppts)
 {
-    WINE_FIXME("(%p)\n", ppts);
-    return E_NOTIMPL;
+    WINE_TRACE("(%p)\n", ppts);
+    return get_standard_stream(0, ppts);
 }
 
 static HRESULT WINAPI Host_get_StdOut(IHost *iface, ITextStream **ppts)
 {
-    WINE_FIXME("(%p)\n", ppts);
-    return E_NOTIMPL;
+    WINE_TRACE("(%p)\n", ppts);
+    return get_standard_stream(1, ppts);
 }
 
 static HRESULT WINAPI Host_get_StdErr(IHost *iface, ITextStream **ppts)
 {
-    WINE_FIXME("(%p)\n", ppts);
-    return E_NOTIMPL;
+    WINE_TRACE("(%p)\n", ppts);
+    return get_standard_stream(2, ppts);
+}
+
+/* the standard streams are the file system object's: 0 input, 1 output, 2 error */
+static HRESULT get_standard_stream(int type, ITextStream **ret)
+{
+    static const WCHAR name[] = L"GetStandardStream";
+    DISPPARAMS dp;
+    VARIANT args[2], res;
+    IDispatch *fso;
+    DISPID id;
+    LPOLESTR n = (LPOLESTR)name;
+    HRESULT hres;
+
+    if (!ret) return E_POINTER;
+    *ret = NULL;
+
+    hres = CoCreateInstance(&CLSID_FileSystemObject_wsh, NULL, CLSCTX_INPROC_SERVER, &IID_IDispatch, (void **)&fso);
+    if (FAILED(hres)) return hres;
+    hres = IDispatch_GetIDsOfNames(fso, &IID_NULL, &n, 1, LOCALE_USER_DEFAULT, &id);
+    if (SUCCEEDED(hres))
+    {
+        V_VT(&args[1]) = VT_I4;
+        V_I4(&args[1]) = type;
+        V_VT(&args[0]) = VT_BOOL;
+        V_BOOL(&args[0]) = VARIANT_FALSE;   /* args are in reverse order: type, unicode */
+        dp.rgvarg = args;
+        dp.rgdispidNamedArgs = NULL;
+        dp.cArgs = 2;
+        dp.cNamedArgs = 0;
+        VariantInit(&res);
+        hres = IDispatch_Invoke(fso, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &dp, &res, NULL, NULL);
+        if (SUCCEEDED(hres))
+        {
+            if (V_VT(&res) == VT_DISPATCH && V_DISPATCH(&res))
+                hres = IDispatch_QueryInterface(V_DISPATCH(&res), &IID_ITextStream, (void **)ret);
+            else
+                hres = E_FAIL;
+            VariantClear(&res);
+        }
+    }
+    IDispatch_Release(fso);
+    return hres;
 }
 
 static const IHostVtbl HostVtbl = {
