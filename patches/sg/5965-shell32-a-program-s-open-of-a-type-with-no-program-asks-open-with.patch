From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: A program's open of a type with no program asks Open with (5965)

A program that opened a file whose type has no program (ShellExecuteEx,
"start file.qqq", a program opening a document) got "There is no program
configured to open this type of file." Windows asks "How do you want to
open this file?" there too (its OpenWith), unless the caller passed
SEE_MASK_FLAG_NO_UI. 6542 did it for the shell's own open only.

Now ShellExecuteEx, for the open verb of a file that is there and whose
type has no program, starts Open with in a process of its own
(rundll32 shell32.dll,OpenAs_RunDLL FILE), so the caller is not held,
and succeeds; with SEE_MASK_FLAG_NO_UI it still fails with
SE_ERR_NOASSOC and shows nothing. The shell's own open
(SGShellExecuteFromShell) keeps its dialog owned by the folder.

Gate test-noassoc, mutant SG_MUTANT_PROGRAM_NOASSOC_ERROR.
---
diff --git a/dlls/shell32/shlexec.c b/dlls/shell32/shlexec.c
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -2107,6 +2107,49 @@
     MessageBoxW(hwnd, msg, NULL, MB_ICONERROR);
 }
 
+/* Stained Glass OS: a program's open of a file whose type has no program asks
+ * "How do you want to open this file?", as Windows does (its OpenWith), in a
+ * process of its own so the caller is not held: rundll32 shell32.dll,
+ * OpenAs_RunDLL FILE. Not for the shell's own open (SGShellExecuteFromShell
+ * shows it owned by the folder), not for a folder or a file that is not
+ * there, and not for a verb other than open. */
+static BOOL open_as_process( const SHELLEXECUTEINFOW *sei, SHELLEXECUTEINFOW *out )
+{
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    WCHAR path[MAX_PATH], sys[MAX_PATH], *cmd;
+    DWORD attr, len;
+
+#ifdef SG_MUTANT_PROGRAM_NOASSOC_ERROR
+    return FALSE;
+#endif
+    if (open_as_tls != TLS_OUT_OF_INDEXES && TlsGetValue( open_as_tls )) return FALSE;
+    if (sei->lpVerb && sei->lpVerb[0] && wcsicmp( sei->lpVerb, L"open" )) return FALSE;
+    if (!sei->lpFile || !sei->lpFile[0]) return FALSE;
+    if (PathIsRelativeW( sei->lpFile ) && sei->lpDirectory && sei->lpDirectory[0])
+    {
+        if (!PathCombineW( path, sei->lpDirectory, sei->lpFile )) return FALSE;
+    }
+    else if (!GetFullPathNameW( sei->lpFile, ARRAY_SIZE(path), path, NULL )) return FALSE;
+    attr = GetFileAttributesW( path );
+    if (attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_DIRECTORY)) return FALSE;
+    if (!GetSystemDirectoryW( sys, ARRAY_SIZE(sys) )) return FALSE;
+    len = lstrlenW( sys ) + lstrlenW( path ) + 64;
+    if (!(cmd = malloc( len * sizeof(WCHAR) ))) return FALSE;
+    swprintf( cmd, len, L"\"%s\\rundll32.exe\" shell32.dll,OpenAs_RunDLL \"%s\"", sys, path );
+    TRACE( "no program for %s: %s\n", debugstr_w(path), debugstr_w(cmd) );
+    if (!CreateProcessW( NULL, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi ))
+    {
+        free( cmd );
+        return FALSE;
+    }
+    free( cmd );
+    CloseHandle( pi.hThread );
+    if (out->fMask & SEE_MASK_NOCLOSEPROCESS) out->hProcess = pi.hProcess;
+    else CloseHandle( pi.hProcess );
+    return TRUE;
+}
+
 static WCHAR *expand_environment( const WCHAR *str )
 {
     WCHAR *buf;
@@ -2617,6 +2660,9 @@
 end:
     TRACE("retval %Iu\n", retval);
 
+    if (retval == SE_ERR_NOASSOC && !(sei_tmp.fMask & SEE_MASK_FLAG_NO_UI) && open_as_process( &sei_tmp, sei ))
+        retval = 33;
+
     free(wszApplicationName);
     if (wszParameters != parametersBuffer)
         free(wszParameters);
