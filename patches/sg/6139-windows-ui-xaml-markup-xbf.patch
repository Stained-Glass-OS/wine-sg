diff --git a/dlls/windows.ui.xaml/make_xbf_ids.py b/dlls/windows.ui.xaml/make_xbf_ids.py
new file mode 100644
index 0000000..1e5faae
--- /dev/null
+++ b/dlls/windows.ui.xaml/make_xbf_ids.py
@@ -0,0 +1,20 @@
+#!/usr/bin/env python3
+# Stained Glass OS: generates xbf_ids.h from xbf_ids.txt -- the XAML framework's type and property
+# IDs in compiled XAML (data per XbfAnalyzer, Apache-2.0).
+#   make_xbf_ids.py xbf_ids.txt xbf_ids.h
+import sys
+types, props = [], []
+for line in open(sys.argv[1]):
+    if line.startswith('#') or not line.strip(): continue
+    kind, id_, name, full = line.split()
+    (types if kind == 'T' else props).append((int(id_, 16), name, full))
+out = ['/* generated by make_xbf_ids.py from xbf_ids.txt -- do not edit */', '',
+       'struct xbf_id { UINT16 id; const WCHAR *name; const WCHAR *full; };', '']
+for label, rows in (('xbf_types', types), ('xbf_properties', props)):
+    out.append('static const struct xbf_id %s[] =' % label)
+    out.append('{')
+    for id_, name, full in sorted(rows):
+        out.append('    { 0x%04x, L"%s", L"%s" },' % (id_, name, full))
+    out.append('};')
+    out.append('')
+open(sys.argv[2], 'w').write('\n'.join(out))
