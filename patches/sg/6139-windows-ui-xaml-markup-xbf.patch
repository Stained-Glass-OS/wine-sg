diff --git a/dlls/windows.ui.xaml/resfile.c b/dlls/windows.ui.xaml/resfile.c
new file mode 100644
index 0000000..b1c0454
--- /dev/null
+++ b/dlls/windows.ui.xaml/resfile.c
@@ -0,0 +1,100 @@
+/*
+ * Windows.UI.Xaml -- files of the application's resource index
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Packaged applications keep their compiled pages inside their resource index (resources.pri, or
+ * another .pri of the package), under Files/: the same reader as windows.applicationmodel's
+ * (pri.c) finds them.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include "private.h"
+#include "pri.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+LONG WINAPI GetCurrentPackagePath( UINT32 *length, WCHAR *path );
+
+static char *file_from_pri( const WCHAR *pri_path, const WCHAR *path, size_t *size )
+{
+    HANDLE file = CreateFileW( pri_path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    struct pri_file *pri;
+    const unsigned char *bytes;
+    unsigned char *data;
+    LARGE_INTEGER li;
+    char *ret = NULL;
+    DWORD got;
+    size_t len;
+
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    if (!GetFileSizeEx( file, &li ) || li.QuadPart > 256 * 1024 * 1024 || !(data = malloc( li.QuadPart )))
+    {
+        CloseHandle( file );
+        return NULL;
+    }
+    if (!ReadFile( file, data, li.QuadPart, &got, NULL ) || got != li.QuadPart)
+    {
+        free( data );
+        CloseHandle( file );
+        return NULL;
+    }
+    CloseHandle( file );
+    if (!(pri = pri_parse( data, got ))) { free( data ); return NULL; }
+    if ((bytes = pri_get_data( pri, path, &len )) && (ret = malloc( len )))
+    {
+        memcpy( ret, bytes, len );
+        *size = len;
+    }
+    pri_free( pri );
+    return ret;
+}
+
+char *xaml_app_resource_file( const WCHAR *rel, size_t *size )
+{
+    WCHAR folder[MAX_PATH], path[MAX_PATH + 16], item[MAX_PATH + 16], *p;
+    WIN32_FIND_DATAW data;
+    UINT32 len = MAX_PATH;
+    HANDLE find;
+    char *ret = NULL;
+
+    if (GetCurrentPackagePath( &len, folder ) != ERROR_SUCCESS)
+    {
+        GetModuleFileNameW( NULL, folder, MAX_PATH );
+        if ((p = wcsrchr( folder, '\\' ))) *p = 0;
+    }
+    /* Files/<path>, compiled pages as .xbf */
+    if (wcslen( rel ) > MAX_PATH) return NULL;
+    swprintf( item, ARRAY_SIZE(item), L"Files/%s", rel );
+    if ((p = wcsrchr( item, '.' )) && !wcsicmp( p, L".xaml" )) wcscpy( p, L".xbf" );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\resources.pri", folder );
+    if ((ret = file_from_pri( path, item, size ))) return ret;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\*.pri", folder );
+    if ((find = FindFirstFileW( path, &data )) == INVALID_HANDLE_VALUE) return NULL;
+    do
+    {
+        if (!wcsicmp( data.cFileName, L"resources.pri" )) continue;
+        swprintf( path, ARRAY_SIZE(path), L"%s\\%s", folder, data.cFileName );
+        ret = file_from_pri( path, item, size );
+    } while (!ret && FindNextFileW( find, &data ));
+    FindClose( find );
+    TRACE( "%s: %s\n", debugstr_w( item ), ret ? "found" : "not found" );
+    return ret;
+}
diff --git a/dlls/windows.ui.xaml/xbf.c b/dlls/windows.ui.xaml/xbf.c
new file mode 100644
index 0000000..3d291f6
--- /dev/null
+++ b/dlls/windows.ui.xaml/xbf.c
@@ -0,0 +1,787 @@
+/*
+ * Windows.UI.Xaml markup: compiled XAML (XBF v2)
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Applications ship their pages compiled (.xbf).  The file layout -- header, string, assembly,
+ * namespace, type, property and XML namespace tables, node sections, the node opcodes and value
+ * encodings -- and the framework's type and property numbering (xbf_ids.txt) are per XbfAnalyzer
+ * (Apache-2.0), the open-source XBF analyser; this reader is ours.  Its nodes drive the same object
+ * writer as XAML text.  The input comes from arbitrary applications: every read, table index, offset
+ * and count is checked, recursion and nesting are bounded, and a bad file fails the load.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include "private.h"
+#include "xbf_ids.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+#define XBF_MAX_DEPTH 256
+#define XBF_MAX_SECTION_DEPTH 16
+
+struct xbf_string { const BYTE *chars; UINT32 len; };
+struct xbf_type { UINT32 flags, ns, name; };
+struct xbf_prop { UINT32 flags, type, name; };
+struct xbf_section { UINT32 nodes, positions; };
+
+struct xbf
+{
+    const BYTE *data;
+    size_t size;
+    UINT32 major, minor;
+    UINT32 nstrings, nassemblies, nnamespaces, ntypes, nprops, nxmlns, nsections;
+    struct xbf_string *strings;
+    UINT32 *namespace_names;       /* string index of each type namespace */
+    struct xbf_type *types;
+    struct xbf_prop *props;
+    struct xbf_section *sections;
+    size_t first_node;             /* where node section offsets count from */
+};
+
+struct rd
+{
+    const BYTE *data;
+    size_t size, pos, end;
+    BOOL bad;
+};
+
+static BOOL rd_has( struct rd *r, size_t n )
+{
+    if (r->bad || r->end > r->size || r->pos > r->end || n > r->end - r->pos) { r->bad = TRUE; return FALSE; }
+    return TRUE;
+}
+
+static BYTE rd_u8( struct rd *r ) { return rd_has( r, 1 ) ? r->data[r->pos++] : 0; }
+static UINT16 rd_u16( struct rd *r )
+{
+    UINT16 v;
+    if (!rd_has( r, 2 )) return 0;
+    memcpy( &v, r->data + r->pos, 2 );
+    r->pos += 2;
+    return v;
+}
+static UINT32 rd_u32( struct rd *r )
+{
+    UINT32 v;
+    if (!rd_has( r, 4 )) return 0;
+    memcpy( &v, r->data + r->pos, 4 );
+    r->pos += 4;
+    return v;
+}
+static UINT64 rd_u64( struct rd *r ) { UINT64 lo = rd_u32( r ); return lo | (UINT64)rd_u32( r ) << 32; }
+static FLOAT rd_f32( struct rd *r ) { UINT32 v = rd_u32( r ); FLOAT f; memcpy( &f, &v, 4 ); return f; }
+
+/* .NET's 7-bit encoded int */
+static UINT32 rd_7bit( struct rd *r )
+{
+    UINT32 v = 0;
+    int shift = 0;
+    BYTE b;
+
+    do
+    {
+        b = rd_u8( r );
+        if (shift > 28) { r->bad = TRUE; return 0; }
+        v |= (UINT32)(b & 0x7f) << shift;
+        shift += 7;
+    } while ((b & 0x80) && !r->bad);
+    return v;
+}
+
+/* a length-prefixed UTF-16 string in the stream (a copy) */
+static WCHAR *rd_string( struct rd *r )
+{
+    UINT32 len = rd_u32( r );
+    WCHAR *str;
+
+    if (len > 65536 || !rd_has( r, (size_t)len * 2 )) { r->bad = TRUE; return NULL; }
+    if (!(str = malloc( (len + 1) * sizeof(WCHAR) ))) { r->bad = TRUE; return NULL; }
+    memcpy( str, r->data + r->pos, len * 2 );
+    str[len] = 0;
+    r->pos += len * 2;
+    return str;
+}
+
+static WCHAR *xbf_string( const struct xbf *xbf, UINT32 index )
+{
+    WCHAR *str;
+
+    if (index >= xbf->nstrings) return NULL;
+    if (!(str = malloc( (xbf->strings[index].len + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( str, xbf->strings[index].chars, xbf->strings[index].len * 2 );
+    str[xbf->strings[index].len] = 0;
+    return str;
+}
+
+static const struct xbf_id *find_id( const struct xbf_id *table, size_t count, UINT16 id )
+{
+    size_t lo = 0, hi = count;
+
+    while (lo < hi)
+    {
+        size_t mid = (lo + hi) / 2;
+        if (table[mid].id == id) return &table[mid];
+        if (table[mid].id < id) lo = mid + 1;
+        else hi = mid;
+    }
+    return NULL;
+}
+
+static const WCHAR *short_name( const WCHAR *full )
+{
+    const WCHAR *dot = wcsrchr( full, '.' );
+    return dot ? dot + 1 : full;
+}
+
+static void xbf_free( struct xbf *xbf )
+{
+    free( xbf->strings );
+    free( xbf->namespace_names );
+    free( xbf->types );
+    free( xbf->props );
+    free( xbf->sections );
+}
+
+#define TABLE_MAX 0x100000
+
+static HRESULT xbf_parse( struct xbf *xbf, const BYTE *data, size_t size )
+{
+    struct rd r = { data, size, 0, size };
+    UINT32 i, count;
+
+    memset( xbf, 0, sizeof(*xbf) );
+    xbf->data = data;
+    xbf->size = size;
+    if (size < 4 || memcmp( data, "XBF\0", 4 )) return E_INVALIDARG;
+    r.pos = 4;
+    rd_u32( &r );                  /* metadata size */
+    rd_u32( &r );                  /* node size */
+    xbf->major = rd_u32( &r );
+    xbf->minor = rd_u32( &r );
+    for (i = 0; i < 6; i++) rd_u64( &r );   /* table offsets: the tables follow in order */
+    if (!rd_has( &r, 64 )) return E_INVALIDARG;
+    r.pos += 64;                   /* hash, 32 UTF-16 characters */
+    if (xbf->major != 2)
+    {
+        FIXME( "XBF version %u.%u\n", xbf->major, xbf->minor );
+        return E_NOTIMPL;
+    }
+
+    count = rd_u32( &r );
+    if (r.bad || count > TABLE_MAX || !(xbf->strings = calloc( count + 1, sizeof(*xbf->strings) ))) return E_INVALIDARG;
+    xbf->nstrings = count;
+    for (i = 0; i < count; i++)
+    {
+        UINT32 len = rd_u32( &r );
+        if (r.bad || len > 65536 || !rd_has( &r, (size_t)len * 2 + 2 )) return E_INVALIDARG;
+        xbf->strings[i].chars = data + r.pos;
+        xbf->strings[i].len = len;
+        r.pos += (size_t)len * 2;
+        if (rd_u16( &r )) return E_INVALIDARG;   /* v2: two zero bytes after each */
+    }
+
+    count = rd_u32( &r );          /* assemblies: kind, name */
+    if (r.bad || count > TABLE_MAX || !rd_has( &r, (size_t)count * 8 )) return E_INVALIDARG;
+    xbf->nassemblies = count;
+    for (i = 0; i < count; i++) { rd_u32( &r ); if (rd_u32( &r ) >= xbf->nstrings) return E_INVALIDARG; }
+
+    count = rd_u32( &r );          /* type namespaces: assembly, name */
+    if (r.bad || count > TABLE_MAX || !(xbf->namespace_names = calloc( count + 1, sizeof(UINT32) ))) return E_INVALIDARG;
+    xbf->nnamespaces = count;
+    for (i = 0; i < count; i++)
+    {
+        if (rd_u32( &r ) >= xbf->nassemblies) return E_INVALIDARG;
+        if ((xbf->namespace_names[i] = rd_u32( &r )) >= xbf->nstrings) return E_INVALIDARG;
+    }
+
+    count = rd_u32( &r );          /* types: flags, namespace, name */
+    if (r.bad || count > TABLE_MAX || !(xbf->types = calloc( count + 1, sizeof(*xbf->types) ))) return E_INVALIDARG;
+    xbf->ntypes = count;
+    for (i = 0; i < count; i++)
+    {
+        xbf->types[i].flags = rd_u32( &r );
+        xbf->types[i].ns = rd_u32( &r );
+        xbf->types[i].name = rd_u32( &r );
+        if (r.bad || xbf->types[i].ns >= xbf->nnamespaces || xbf->types[i].name >= xbf->nstrings) return E_INVALIDARG;
+    }
+
+    count = rd_u32( &r );          /* properties: flags, type, name */
+    if (r.bad || count > TABLE_MAX || !(xbf->props = calloc( count + 1, sizeof(*xbf->props) ))) return E_INVALIDARG;
+    xbf->nprops = count;
+    for (i = 0; i < count; i++)
+    {
+        xbf->props[i].flags = rd_u32( &r );
+        xbf->props[i].type = rd_u32( &r );
+        xbf->props[i].name = rd_u32( &r );
+        if (r.bad || xbf->props[i].name >= xbf->nstrings) return E_INVALIDARG;
+        if (!(xbf->props[i].type & 0x8000) && xbf->props[i].type >= xbf->ntypes) return E_INVALIDARG;
+    }
+
+    count = rd_u32( &r );          /* XML namespaces: name */
+    if (r.bad || count > TABLE_MAX || !rd_has( &r, (size_t)count * 4 )) return E_INVALIDARG;
+    xbf->nxmlns = count;
+    for (i = 0; i < count; i++) if (rd_u32( &r ) >= xbf->nstrings) return E_INVALIDARG;
+
+    count = rd_u32( &r );          /* node sections: nodes, positional data */
+    if (r.bad || !count || count > TABLE_MAX || !(xbf->sections = calloc( count, sizeof(*xbf->sections) ))) return E_INVALIDARG;
+    xbf->nsections = count;
+    for (i = 0; i < count; i++)
+    {
+        xbf->sections[i].nodes = rd_u32( &r );
+        xbf->sections[i].positions = rd_u32( &r );
+    }
+    if (r.bad) return E_INVALIDARG;
+    xbf->first_node = r.pos;
+    for (i = 0; i < count; i++)
+        if (xbf->sections[i].nodes > xbf->sections[i].positions ||
+            xbf->sections[i].positions > size - xbf->first_node) return E_INVALIDARG;
+    TRACE( "%u strings, %u types, %u properties, %u sections\n", xbf->nstrings, xbf->ntypes, xbf->nprops, xbf->nsections );
+    return S_OK;
+}
+
+/* ---- reading nodes into objects ---- */
+
+struct frame
+{
+    IInspectable *obj;             /* NULL: something we do not make (a resource reference ...) */
+    BOOL root;
+};
+
+struct collection
+{
+    IInspectable *owner;
+    WCHAR *owner_type;             /* the property's declaring type, or NULL */
+    WCHAR *name;                   /* NULL: the owner's own content */
+};
+
+struct xbf_state
+{
+    struct xbf *xbf;
+    struct xaml_writer *writer;
+    struct frame frames[XBF_MAX_DEPTH];
+    unsigned int nframes;
+    struct collection colls[XBF_MAX_DEPTH];
+    unsigned int ncolls;
+    unsigned int section_depth;
+    IInspectable *root;
+};
+
+/* a property ID: its name and declaring type (short) */
+static BOOL property_name( struct xbf_state *s, UINT16 id, WCHAR **name, WCHAR **owner )
+{
+    *name = *owner = NULL;
+    if (id & 0x8000)
+    {
+        const struct xbf_id *p = find_id( xbf_properties, ARRAY_SIZE(xbf_properties), id & 0x7fff );
+        if (!p) { FIXME( "framework property %#x\n", id ); return FALSE; }
+        *name = wcsdup( p->name );
+        *owner = wcsdup( short_name( p->full ) );
+        return *name && *owner;
+    }
+    if (id >= s->xbf->nprops) return FALSE;
+    *name = xbf_string( s->xbf, s->xbf->props[id].name );
+    return *name != NULL;
+}
+
+/* a type ID: its XML namespace and name, as XAML text would give them */
+static BOOL type_name( struct xbf_state *s, UINT16 id, WCHAR **ns, WCHAR **name )
+{
+    *ns = *name = NULL;
+    if (id & 0x8000)
+    {
+        const struct xbf_id *t = find_id( xbf_types, ARRAY_SIZE(xbf_types), id & 0x7fff );
+        if (!t) { FIXME( "framework type %#x\n", id ); return FALSE; }
+        *name = wcsdup( t->name );
+        return *name != NULL;
+    }
+    if (id >= s->xbf->ntypes) return FALSE;
+    {
+        WCHAR *type_ns = xbf_string( s->xbf, s->xbf->namespace_names[s->xbf->types[id].ns] );
+        if (!type_ns) return FALSE;
+        if ((*ns = malloc( (wcslen( type_ns ) + 7) * sizeof(WCHAR) ))) swprintf( *ns, wcslen( type_ns ) + 7, L"using:%s", type_ns );
+        free( type_ns );
+        *name = xbf_string( s->xbf, s->xbf->types[id].name );
+    }
+    return *ns && *name;
+}
+
+/* a value, as XAML text would write it (NULL: not convertible) */
+static WCHAR *read_value( struct xbf_state *s, struct rd *r )
+{
+    WCHAR buf[64];
+    BYTE type = rd_u8( r );
+
+    switch (type)
+    {
+    case 0x01: return wcsdup( L"False" );
+    case 0x02: return wcsdup( L"True" );
+    case 0x03: swprintf( buf, ARRAY_SIZE(buf), L"%.9g", rd_f32( r ) ); break;
+    case 0x04: swprintf( buf, ARRAY_SIZE(buf), L"%d", (INT32)rd_u32( r ) ); break;
+    case 0x05:
+    {
+        UINT16 index = rd_u16( r );
+#ifndef SG_MUTANT_XBF_NO_BOUNDS
+        if (index >= s->xbf->nstrings) { r->bad = TRUE; return NULL; }
+#endif
+        return xbf_string( s->xbf, index );
+    }
+    case 0x06:
+    {
+        FLOAT l = rd_f32( r ), t = rd_f32( r ), rt = rd_f32( r ), b = rd_f32( r );
+        swprintf( buf, ARRAY_SIZE(buf), L"%.9g,%.9g,%.9g,%.9g", l, t, rt, b );
+        break;
+    }
+    case 0x07:
+    {
+        UINT32 unit = rd_u32( r );
+        FLOAT v = rd_f32( r );
+        if (unit == 0) return wcsdup( L"Auto" );
+        if (unit == 1) swprintf( buf, ARRAY_SIZE(buf), L"%.9g", v );
+        else if (unit == 2) swprintf( buf, ARRAY_SIZE(buf), L"%.9g*", v );
+        else { r->bad = TRUE; return NULL; }
+        break;
+    }
+    case 0x08:
+    {
+        BYTE b = rd_u8( r ), g = rd_u8( r ), rr = rd_u8( r ), a = rd_u8( r );
+        swprintf( buf, ARRAY_SIZE(buf), L"#%02X%02X%02X%02X", a, rr, g, b );
+        break;
+    }
+    case 0x09: return rd_string( r );       /* a duration, as text */
+    case 0x0b:
+    {
+        UINT16 enum_id = rd_u16( r );
+        INT32 v = rd_u32( r );
+        (void)enum_id;
+        swprintf( buf, ARRAY_SIZE(buf), L"#enum%d", v );
+        break;
+    }
+    default:
+        WARN( "value type %#x\n", type );
+        r->bad = TRUE;
+        return NULL;
+    }
+    return r->bad ? NULL : wcsdup( buf );
+}
+
+static IInspectable *top_object( struct xbf_state *s )
+{
+    return s->nframes ? s->frames[s->nframes - 1].obj : NULL;
+}
+
+static HRESULT push_frame( struct xbf_state *s, IInspectable *obj, BOOL root )
+{
+    if (s->nframes >= XBF_MAX_DEPTH || s->ncolls >= XBF_MAX_DEPTH)
+    {
+        if (obj) IInspectable_Release( obj );
+        return E_INVALIDARG;
+    }
+    s->frames[s->nframes].obj = obj;
+    s->frames[s->nframes].root = root;
+    s->nframes++;
+    /* the object's own content collection */
+    s->colls[s->ncolls].owner = obj;
+    s->colls[s->ncolls].owner_type = NULL;
+    s->colls[s->ncolls].name = NULL;
+    s->ncolls++;
+    return S_OK;
+}
+
+static void free_collection( struct collection *c )
+{
+    free( c->owner_type );
+    free( c->name );
+}
+
+/* the object just ended goes where its parent wants it */
+static IInspectable *pop_frame( struct xbf_state *s )
+{
+    IInspectable *obj;
+
+    if (!s->nframes) return NULL;
+    /* its own content collection ends with it */
+    while (s->ncolls && s->colls[s->ncolls - 1].owner == s->frames[s->nframes - 1].obj && !s->colls[s->ncolls - 1].name)
+    {
+        free_collection( &s->colls[--s->ncolls] );
+        break;
+    }
+    obj = s->frames[--s->nframes].obj;
+    return obj;
+}
+
+static HRESULT set_member( struct xbf_state *s, IInspectable *obj, const WCHAR *owner, const WCHAR *name,
+                           const WCHAR *str, IInspectable *value )
+{
+    if (!obj) return S_OK;
+    if (str && !wcsncmp( str, L"#enum", 5 ))
+        return xaml_writer_set_enum( s->writer, obj, owner, name, wcstol( str + 5, NULL, 10 ) );
+    return xaml_writer_set( s->writer, obj, owner, name, str, value );
+}
+
+static HRESULT read_nodes( struct xbf_state *s, struct rd *r, BOOL single );
+
+/* the nodes of another section, read where they are */
+static HRESULT read_section( struct xbf_state *s, UINT32 index, size_t offset, BOOL single )
+{
+    struct rd r;
+    HRESULT hr;
+
+    if (index >= s->xbf->nsections || ++s->section_depth > XBF_MAX_SECTION_DEPTH)
+    {
+        s->section_depth--;
+        return E_INVALIDARG;
+    }
+    r.data = s->xbf->data;
+    r.size = s->xbf->size;
+    r.pos = s->xbf->first_node + s->xbf->sections[index].nodes;
+    r.end = s->xbf->first_node + s->xbf->sections[index].positions;
+    r.bad = FALSE;
+    if (offset > r.end - r.pos) hr = E_INVALIDARG;
+    else
+    {
+        r.pos += offset;
+        hr = read_nodes( s, &r, single );
+        if (r.bad) hr = E_INVALIDARG;
+    }
+    s->section_depth--;
+    return hr;
+}
+
+/* the inline data of a reference to another section; deferred elements are read from it */
+static HRESULT read_section_reference( struct xbf_state *s, struct rd *r )
+{
+    UINT32 section = rd_7bit( r ), kind, i, n;
+    HRESULT hr = S_OK;
+
+    if (rd_u16( r )) r->bad = TRUE;
+    kind = rd_7bit( r );
+    if (r->bad || section >= s->xbf->nsections) return E_INVALIDARG;
+    switch (kind)
+    {
+    case 2: case 8:     /* a style's setters */
+        n = rd_7bit( r );
+        for (i = 0; i < n && !r->bad; i++)
+        {
+            BYTE type = rd_u8( r );
+            WCHAR *v;
+            switch (type)
+            {
+            case 0x01: case 0x02: case 0x08: rd_u16( r ); rd_u16( r ); rd_7bit( r ); break;
+            case 0x11: case 0x12: case 0x18: rd_u16( r ); rd_7bit( r ); break;
+            case 0x20: rd_u16( r ); rd_u16( r ); free( read_value( s, r ) ); break;
+            case 0x30: rd_u16( r ); v = read_value( s, r ); free( v ); break;
+            default: r->bad = TRUE;
+            }
+        }
+        FIXME( "styles are not applied yet\n" );
+        break;
+    case 7: case 371:   /* a resource dictionary */
+        n = rd_7bit( r );
+        for (i = 0; i < n && !r->bad; i++) { rd_u16( r ); rd_7bit( r ); }
+        n = rd_7bit( r );
+        for (i = 0; i < n && !r->bad; i++) rd_u16( r );
+        n = rd_7bit( r );
+        for (i = 0; i < n && !r->bad; i++) { rd_u16( r ); rd_7bit( r ); }
+        if (kind == 371) rd_7bit( r );
+        n = rd_7bit( r );
+        for (i = 0; i < n && !r->bad; i++) rd_u16( r );
+        FIXME( "resource dictionaries are not loaded yet\n" );
+        break;
+    case 5:             /* visual states */
+    {
+        UINT32 states = rd_7bit( r ), j, k, m;
+        if (states > 4096) { r->bad = TRUE; break; }
+        for (i = 0; i < states && !r->bad; i++) rd_7bit( r );
+        if (rd_7bit( r ) != states) { r->bad = TRUE; break; }
+        for (i = 0; i < states && !r->bad; i++)
+        {
+            rd_u16( r ); rd_7bit( r ); rd_7bit( r );
+            n = rd_7bit( r ); for (j = 0; j < n && !r->bad; j++) rd_7bit( r );
+            n = rd_7bit( r ); for (j = 0; j < n && !r->bad; j++) { m = rd_7bit( r ); for (k = 0; k < m && !r->bad; k++) rd_7bit( r ); }
+            n = rd_7bit( r ); for (j = 0; j < n && !r->bad; j++) rd_7bit( r );
+            n = rd_7bit( r ); for (j = 0; j < n && !r->bad; j++) rd_7bit( r );
+            rd_7bit( r );
+        }
+        n = rd_7bit( r ); for (i = 0; i < n && !r->bad; i++) { rd_u16( r ); rd_7bit( r ); rd_7bit( r ); }
+        n = rd_7bit( r ); for (i = 0; i < n && !r->bad; i++) { rd_u16( r ); rd_u16( r ); rd_7bit( r ); }
+        rd_7bit( r );
+        n = rd_7bit( r ); for (i = 0; i < n && !r->bad; i++) { rd_7bit( r ); rd_7bit( r ); rd_7bit( r ); }
+        n = rd_7bit( r ); for (i = 0; i < n && !r->bad; i++) rd_7bit( r );
+        rd_7bit( r );
+        n = rd_7bit( r ); for (i = 0; i < n && !r->bad; i++) rd_u16( r );
+        FIXME( "visual states are not applied yet\n" );
+        break;
+    }
+    case 6: case 746:   /* a deferred element: made now */
+    {
+        IInspectable *child;
+        unsigned int frames = s->nframes;
+        rd_u16( r );
+        if (kind == 6)
+        {
+            n = rd_7bit( r );
+            for (i = 0; i < n && !r->bad; i++) { rd_u16( r ); free( read_value( s, r ) ); }
+        }
+        if (r->bad) break;
+        if (FAILED(hr = read_section( s, section, 0, TRUE ))) break;
+        if (s->nframes == frames + 1 && (child = pop_frame( s )))
+        {
+            if (top_object( s )) xaml_writer_add_content( s->writer, top_object( s ), child );
+            IInspectable_Release( child );
+        }
+        break;
+    }
+    default:
+        WARN( "section reference of kind %u\n", kind );
+        r->bad = TRUE;
+    }
+    return r->bad ? E_INVALIDARG : hr;
+}
+
+static HRESULT begin_object( struct xbf_state *s, UINT16 type_id, BOOL root )
+{
+    IInspectable *obj = NULL;
+    WCHAR *ns, *name;
+    HRESULT hr;
+
+    if (root && !s->nframes && s->root)
+    {
+        IInspectable_AddRef( s->root );
+        return push_frame( s, s->root, TRUE );
+    }
+    if (!type_name( s, type_id, &ns, &name )) hr = E_INVALIDARG;
+    else hr = xaml_writer_create( s->writer, ns, name, &obj );
+    free( ns );
+    free( name );
+    if (hr == E_NOTIMPL) obj = NULL;   /* a type we do not have yet: its members are dropped */
+    else if (FAILED(hr)) return hr;
+    return push_frame( s, obj, root );
+}
+
+static HRESULT read_nodes( struct xbf_state *s, struct rd *r, BOOL single )
+{
+    unsigned int start_frames = s->nframes;
+    HRESULT hr = S_OK;
+
+    while (r->pos < r->end && !r->bad && SUCCEEDED(hr))
+    {
+        BYTE op = rd_u8( r );
+        WCHAR *name = NULL, *owner = NULL, *value = NULL;
+
+        switch (op)
+        {
+        case 0x01: break;
+        case 0x12: case 0x03:       /* XML namespace declaration */
+            rd_u16( r );
+            free( rd_string( r ) );
+            break;
+        case 0x0b:                  /* the root's class */
+            free( rd_string( r ) );
+            break;
+        case 0x17:                  /* the root object */
+            hr = begin_object( s, rd_u16( r ), TRUE );
+            break;
+        case 0x14:                  /* an object */
+            hr = begin_object( s, rd_u16( r ), FALSE );
+            break;
+        case 0x15: case 0x16:       /* a literal value object */
+        {
+            UINT16 type = rd_u16( r );
+            WCHAR *ns, *tname;
+            IInspectable *box = NULL;
+            value = read_value( s, r );
+            if (type_name( s, type, &ns, &tname ) && value)
+            {
+                if (!wcscmp( tname, L"String" ) || !wcscmp( tname, L"Object" )) box = xbox_string( value );
+                else if (!wcscmp( tname, L"Double" ) || !wcscmp( tname, L"Single" )) box = xbox_double( wcstod( value, NULL ) );
+                else if (!wcscmp( tname, L"Int32" )) box = xbox_int32( wcstol( value, NULL, 10 ) );
+                else if (!wcscmp( tname, L"Boolean" )) box = xbox_boolean( !wcsicmp( value, L"True" ) );
+                else box = xbox_string( value );
+            }
+            free( ns );
+            free( tname );
+            hr = push_frame( s, box, FALSE );
+            break;
+        }
+        case 0x21:                  /* the object ends (it is popped where it is used) */
+            if (single && s->nframes == start_frames + 1) return S_OK;
+            if (s->nframes && s->frames[s->nframes - 1].root) return S_OK;
+            break;
+        case 0x1a: case 0x1b:       /* a property set from a value */
+            if (!property_name( s, rd_u16( r ), &name, &owner )) { r->bad = TRUE; break; }
+            if (!(value = read_value( s, r ))) break;
+            hr = set_member( s, top_object( s ), owner, name, value, NULL );
+            break;
+        case 0x07: case 0x20:       /* a property set from the object just made */
+        {
+            IInspectable *child;
+            if (!property_name( s, rd_u16( r ), &name, &owner )) { r->bad = TRUE; break; }
+            if (s->nframes < 2) { r->bad = TRUE; break; }
+            child = pop_frame( s );
+            if (child)
+            {
+                hr = set_member( s, top_object( s ), owner, name, NULL, child );
+                IInspectable_Release( child );
+            }
+            break;
+        }
+        case 0x13:                  /* a collection property begins */
+            if (s->ncolls >= XBF_MAX_DEPTH || !property_name( s, rd_u16( r ), &name, &owner )) { r->bad = TRUE; break; }
+            s->colls[s->ncolls].owner = top_object( s );
+            s->colls[s->ncolls].owner_type = owner;
+            s->colls[s->ncolls].name = name;
+            s->ncolls++;
+            name = owner = NULL;
+            break;
+        case 0x02:                  /* it ends */
+            if (!s->ncolls || !s->colls[s->ncolls - 1].name) { r->bad = TRUE; break; }
+            free_collection( &s->colls[--s->ncolls] );
+            break;
+        case 0x08: case 0x09: case 0x0a:   /* the object just made goes into the collection */
+        {
+            IInspectable *child;
+            struct collection *c;
+            if (s->nframes < 2 || !s->ncolls) { r->bad = TRUE; break; }
+            child = pop_frame( s );
+            if (op == 0x0a) free( read_value( s, r ) );   /* its key */
+            c = &s->colls[s->ncolls - 1];
+            if (child && c->owner)
+            {
+                if (c->name) hr = set_member( s, c->owner, c->owner_type, c->name, NULL, child );
+                else hr = xaml_writer_add_content( s->writer, c->owner, child );
+                if (hr == E_INVALIDARG) hr = S_OK;   /* not ours yet */
+            }
+            if (child) IInspectable_Release( child );
+            break;
+        }
+        case 0x0c:                  /* x:ConnectionId */
+            if ((value = read_value( s, r )) && top_object( s ))
+                xaml_writer_connect( s->writer, wcstol( value, NULL, 10 ), top_object( s ) );
+            break;
+        case 0x0d:                  /* x:Name */
+            if ((value = read_value( s, r )) && top_object( s ))
+                hr = xaml_writer_set( s->writer, top_object( s ), NULL, L"Name", value, NULL );
+            break;
+        case 0x0e:                  /* x:Uid */
+            free( read_value( s, r ) );
+            break;
+        case 0x04:                  /* text or a class modifier */
+            if (!(value = read_value( s, r ))) break;
+            if (s->ncolls && s->colls[s->ncolls - 1].name && s->colls[s->ncolls - 1].owner)
+                hr = push_frame( s, xbox_string( value ), FALSE );
+            break;
+        case 0x0f:                  /* a reference to another section */
+            hr = read_section_reference( s, r );
+            break;
+        case 0x11:                  /* a data template */
+        {
+            UINT32 n, i;
+            rd_u16( r );
+            rd_7bit( r );
+            n = rd_7bit( r ) + rd_7bit( r );
+            for (i = 0; i < n && !r->bad; i++) rd_u16( r );
+            FIXME( "data templates are not loaded yet\n" );
+            break;
+        }
+        case 0x1d:                  /* a style's TargetType */
+            rd_u16( r );
+            rd_u16( r );
+            break;
+        case 0x1e: case 0x24:       /* a property set from a static or theme resource */
+            rd_u16( r );
+            free( read_value( s, r ) );
+            break;
+        case 0x1f:                  /* TemplateBinding */
+            rd_u16( r );
+            rd_u16( r );
+            break;
+        case 0x22: case 0x23:       /* a resource reference as an object */
+            free( read_value( s, r ) );
+            hr = push_frame( s, NULL, FALSE );
+            break;
+        case 0x18: case 0x19:       /* a root with a constructor argument */
+            rd_u16( r );
+            free( read_value( s, r ) );
+            break;
+        case 0x8b:
+        {
+            IInspectable *obj = pop_frame( s );
+            if (obj) IInspectable_Release( obj );
+            break;
+        }
+        default:
+            WARN( "node %#x at %#Ix\n", op, r->pos - 1 );
+            r->bad = TRUE;
+        }
+        free( name );
+        free( owner );
+        free( value );
+    }
+    if (r->bad) return E_INVALIDARG;
+    return hr;
+}
+
+HRESULT xaml_load_xbf( const BYTE *data, size_t size, IInspectable *component, IInspectable **out )
+{
+    struct xaml_writer writer = { component, component };
+    struct xbf_state *s;
+    struct xbf xbf;
+    HRESULT hr;
+
+    *out = NULL;
