From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHGetAttributesFromDataObject; an empty data object

SHGetAttributesFromDataObject (ordinal 750) gives the number of items in a shell data object and the asked-for SFGAO attributes they all have, from their folder; a data object that holds no shell items gives S_FALSE and no attributes. It was a stub. Also: a data object made with no items (SHCreateDataObject with none, to be filled with SetData) rendered file names from a NULL item array and crashed; it now starts with no formats. shlobj.h gains the function.
---
--- a/include/shlobj.h
+++ b/include/shlobj.h
@@ -1189,7 +1189,8 @@
 
 #include <poppack.h>
 
-WINSHELLAPI HRESULT WINAPI SHGetDataFromIDListA(LPSHELLFOLDER psf, LPCITEMIDLIST pidl, int nFormat, LPVOID pv, int cb);
+WINSHELLAPI HRESULT WINAPI SHGetAttributesFromDataObject(IDataObject*,DWORD,DWORD*,UINT*);
+HRESULT WINAPI SHGetDataFromIDListA(LPSHELLFOLDER psf, LPCITEMIDLIST pidl, int nFormat, LPVOID pv, int cb);
 WINSHELLAPI HRESULT WINAPI SHGetDataFromIDListW(LPSHELLFOLDER psf, LPCITEMIDLIST pidl, int nFormat, LPVOID pv, int cb);
 #define  SHGetDataFromIDList WINELIB_NAME_AW(SHGetDataFromIDList)
 
--- a/dlls/shell32/shellitem.c
+++ b/dlls/shell32/shellitem.c
@@ -2508,3 +2508,52 @@
     return E_NOTIMPL;
 }
 #endif
+
+#ifndef SG_MUTANT_NO_ATTRS_FROM_DATAOBJECT
+/* (wine-sg 8276) SHGetAttributesFromDataObject: from a shell data object (its CFSTR_SHELLIDLIST, a CIDA), the
+ * number of items and the asked-for SFGAO attributes they all have, from their folder; S_FALSE and no
+ * attributes for any other data object. */
+HRESULT WINAPI SHGetAttributesFromDataObject(IDataObject *data, DWORD mask, DWORD *attributes, UINT *count)
+{
+    FORMATETC fmt = { 0, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    STGMEDIUM medium;
+    CIDA *ida;
+    HRESULT hr = S_FALSE;
+
+    TRACE("(%p, %#lx, %p, %p)\n", data, mask, attributes, count);
+
+    if (attributes) *attributes = 0;
+    if (count) *count = 0;
+    if (!data) return S_FALSE;
+    fmt.cfFormat = RegisterClipboardFormatW(CFSTR_SHELLIDLISTW);
+    if (FAILED(IDataObject_GetData(data, &fmt, &medium))) return S_FALSE;
+    if ((ida = GlobalLock(medium.hGlobal)))
+    {
+        LPCITEMIDLIST parent = (LPCITEMIDLIST)((BYTE *)ida + ida->aoffset[0]);
+        LPCITEMIDLIST *items = malloc(max(ida->cidl, 1) * sizeof(*items));
+        IShellFolder *folder = NULL;
+        UINT i;
+
+        hr = S_OK;
+        if (count) *count = ida->cidl;
+        if (attributes && mask && ida->cidl && items &&
+            SUCCEEDED(SHBindToObject(NULL, parent, NULL, &IID_IShellFolder, (void **)&folder)))
+        {
+            SFGAOF got = mask;
+
+            for (i = 0; i < ida->cidl; i++) items[i] = (LPCITEMIDLIST)((BYTE *)ida + ida->aoffset[i + 1]);
+            if (SUCCEEDED(IShellFolder_GetAttributesOf(folder, ida->cidl, items, &got))) *attributes = got & mask;
+            IShellFolder_Release(folder);
+        }
+        free(items);
+        GlobalUnlock(medium.hGlobal);
+    }
+    ReleaseStgMedium(&medium);
+    return hr;
+}
+#else
+HRESULT WINAPI SHGetAttributesFromDataObject(IDataObject *data, DWORD mask, DWORD *attributes, UINT *count)
+{
+    return E_NOTIMPL;
+}
+#endif
--- a/dlls/shell32/dataobject.c
+++ b/dlls/shell32/dataobject.c
@@ -563,6 +563,16 @@
     obj->ref = 1;
     obj->IDataObject_iface.lpVtbl = &dtovt;
     obj->data = calloc(4, sizeof(*obj->data));
+#ifndef SG_MUTANT_EMPTY_DATAOBJECT
+    /* (wine-sg 8276) no items (SHCreateDataObject with none, to be filled with SetData): no formats --
+     * rendering file names for nothing read through a NULL item array */
+    if (!pidl_count || !pidls)
+    {
+        obj->data_count = 0;
+        TRACE("Created empty data object %p.\n", obj);
+        return &obj->IDataObject_iface;
+    }
+#endif
     obj->data[0].cf = RegisterClipboardFormatW(CFSTR_SHELLIDLISTW);
     obj->data[0].global = RenderSHELLIDLIST(root_pidl, pidls, pidl_count);
     obj->data_count = 1;
--- a/dlls/shell32/shell32.spec
+++ b/dlls/shell32/shell32.spec
@@ -590,7 +590,7 @@
 745 stub -noname Create_IUIElement
 748 stub -noname SHLimitInputCombo
 749 stub -noname SHGetShellStyleHInstance
-750 stub -noname SHGetAttributesFromDataObject
+750 stdcall -noname SHGetAttributesFromDataObject(ptr long ptr ptr)
 751 stub -noname SHSimulateDropOnClsid
 752 stub -noname SHGetComputerDisplayNameW
 753 stub -noname CheckStagingArea
