@@ -857,10 +910,222 @@ static NTSTATUS open_classes_key( HKEY *retkey, const WCHAR *base, const UNICODE
 
     if (!status)
     {
-        *retkey = (HKEY)((UINT_PTR)*retkey | 2);  /* Windows marks HKCR's keys so */
+        /* Windows marks HKCR's keys so; the keys of a virtualized machine key are plain handles */
+        if (path[0] != '\\') *retkey = (HKEY)((UINT_PTR)*retkey | 2);
         track_classes_key( *retkey, path, user_bound, access );
     }
     heap_free( user_path );
+    heap_free( machine_path );
+    heap_free( path );
+    return status;
+}
