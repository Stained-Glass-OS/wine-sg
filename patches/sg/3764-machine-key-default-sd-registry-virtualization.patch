index 3147d03..b8f4621 100644
--- a/server/registry.c
+++ b/server/registry.c
@@ -461,8 +461,10 @@ static unsigned int key_map_access( struct object *obj, unsigned int access )
 static struct security_descriptor *key_get_sd( struct object *obj )
 {
     static struct security_descriptor *key_default_sd;
+    const struct security_descriptor *machine_sd;
 
