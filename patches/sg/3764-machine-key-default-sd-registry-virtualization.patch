+
+/* ---- Stained Glass OS: registry virtualization (UAC) ----
+ *
+ * An old program that writes under HKLM\Software as a standard user would fail where it worked on
+ * Windows XP. As on Windows Vista and later, such a write goes to the per-user store HKCU\Software\
+ * Classes\VirtualStore\MACHINE\SOFTWARE instead, and what the program reads is the store over the machine's
+ * key. This is the merged view of the classes (the sides are the store and HKLM\Software, the tracked
+ * path begins with a backslash). Only for a 32-bit process whose manifest has no requestedExecutionLevel
+ * (no manifest at all, as old programs), run by a user that is not an administrator and is not elevated;
+ * not for HKLM\Software\Classes, HKLM\Software\Microsoft\Windows and HKLM\Software\Microsoft\Windows NT,
+ * which Windows never virtualizes. Not done: the per-key flags (REG_KEY_DONT_VIRTUALIZE,
+ * REG_KEY_DONT_SILENT_FAIL, REG_KEY_RECURSE_FLAG of NtSetInformationKey) and the virtualization of deletions
+ * and security descriptors. SG_REGISTRY_VIRTUALIZATION=0 turns it off, =1 on for any 32-bit process
+ * without a run level (tests). */
+
+static BOOL virt_enabled(void)
+{
+    static LONG state;   /* 0: not known, 1: on, 2: off */
+    char buffer[1024];
+    WCHAR env[8];
+    ACTIVATION_CONTEXT_RUN_LEVEL_INFORMATION level;
+    HANDLE token;
+    DWORD len, i;
+    LONG s = state;
+    BOOL force = FALSE;
+
+    if (s) return s == 1;
+    s = 2;
+#ifndef SG_MUTANT_VIRT_64BIT
+    if (is_win64) goto done;
+#endif
+    if (GetEnvironmentVariableW( L"SG_REGISTRY_VIRTUALIZATION", env, ARRAY_SIZE(env) ))
+    {
+        if (env[0] == '0') goto done;
+        force = env[0] == '1';
+    }
+    memset( &level, 0, sizeof(level) );
+    if (!RtlQueryInformationActivationContext( 1 /* use the active context */, NULL, NULL,
+                                               RunlevelInformationInActivationContext, &level, sizeof(level), NULL ) &&
+#ifndef SG_MUTANT_VIRT_ANY_LEVEL
+        level.RunLevel != ACTCTX_RUN_LEVEL_UNSPECIFIED)
+#else
+        0)
+#endif
+        goto done;
+    if (!force && !NtOpenProcessToken( NtCurrentProcess(), TOKEN_QUERY, &token ))
+    {
+        TOKEN_ELEVATION elevation;
+        SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+        SID system = { SID_REVISION, 1, SECURITY_NT_AUTHORITY, { SECURITY_LOCAL_SYSTEM_RID } };
+        PSID admins = NULL;
+        BOOL standard = TRUE;
+
+        RtlAllocateAndInitializeSid( &nt, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS, 0, 0, 0, 0, 0, 0, &admins );
+
+        if (!NtQueryInformationToken( token, TokenElevation, &elevation, sizeof(elevation), &len ) &&
+            elevation.TokenIsElevated)
+            standard = FALSE;
+        if (standard && !NtQueryInformationToken( token, TokenUser, buffer, sizeof(buffer), &len ) &&
+            RtlEqualSid( ((TOKEN_USER *)buffer)->User.Sid, &system ))
+            standard = FALSE;
+        if (standard && !NtQueryInformationToken( token, TokenGroups, buffer, sizeof(buffer), &len ))
+        {
+            TOKEN_GROUPS *groups = (TOKEN_GROUPS *)buffer;
+            for (i = 0; i < groups->GroupCount; i++)
+                if ((groups->Groups[i].Attributes & SE_GROUP_ENABLED) && admins && RtlEqualSid( groups->Groups[i].Sid, admins ))
+                    standard = FALSE;
+        }
+        NtClose( token );
+        RtlFreeSid( admins );
+        if (!standard) goto done;
+    }
+    s = 1;
+done:
+    if (InterlockedCompareExchange( &state, s, 0 ) == 0) TRACE( "registry virtualization %s\n", s == 1 ? "on" : "off" );
+    return state == 1;
+}
+
+/* the path below HKLM\Software that a call opens or creates (no Wow6432Node, no backslash at either
+ * end), when virtualization applies to it; NULL otherwise */
+static WCHAR *virt_rest( HKEY hkey, const UNICODE_STRING *name )
+{
+    static const WCHAR machineW[] = L"\\REGISTRY\\MACHINE\\SOFTWARE";
+    char buffer[1024];
+    OBJECT_NAME_INFORMATION *info = (OBJECT_NAME_INFORMATION *)buffer;
+    WCHAR *full, *rest, *p, *tracked = get_classes_path( hkey );
+    DWORD len, name_len = name->Length / sizeof(WCHAR), base_len;
+    const WCHAR *n = name->Buffer;
+
+    if (tracked)
+    {
+        BOOL is_virt = tracked[0] == '\\';
+        if (!is_virt) { heap_free( tracked ); return NULL; }
+        base_len = lstrlenW( machineW ) + lstrlenW( tracked );
+        if (!(full = heap_alloc( (base_len + name_len + 4) * sizeof(WCHAR) ))) { heap_free( tracked ); return NULL; }
+        lstrcpyW( full, machineW );
+        lstrcatW( full, tracked );   /* "\" + rest: the rest follows */
+        heap_free( tracked );
+        if (full[lstrlenW( machineW ) + 1] == 0) full[lstrlenW( machineW )] = 0;
+        base_len = lstrlenW( full );
+    }
+    else
+    {
+        if (NtQueryObject( hkey, ObjectNameInformation, buffer, sizeof(buffer) - sizeof(WCHAR), &len ) ||
+            !info->Name.Buffer) return NULL;
+        base_len = info->Name.Length / sizeof(WCHAR);
+        if (!(full = heap_alloc( (base_len + name_len + 4) * sizeof(WCHAR) ))) return NULL;
+        memcpy( full, info->Name.Buffer, base_len * sizeof(WCHAR) );
+        full[base_len] = 0;
+    }
+    while (name_len && *n == '\\') { n++; name_len--; }
+    while (name_len && n[name_len - 1] == '\\') name_len--;
+    if (name_len)
+    {
+        full[base_len++] = '\\';
+        memcpy( full + base_len, n, name_len * sizeof(WCHAR) );
+        base_len += name_len;
+    }
+    full[base_len] = 0;
+
+    len = lstrlenW( machineW );
+    if (base_len < len || wcsnicmp( full, machineW, len ) || (full[len] && full[len] != '\\'))
+    {
+        heap_free( full );
+        return NULL;
+    }
+    rest = full + len;
+    while (*rest == '\\') rest++;
+    /* the 32-bit view of a 32-bit process is below Wow6432Node: the store has its own */
+    if (!wcsnicmp( rest, L"Wow6432Node", 11 ) && (rest[11] == 0 || rest[11] == '\\'))
+    {
+        rest += 11;
+        while (*rest == '\\') rest++;
+    }
+    /* the keys Windows does not virtualize */
+#ifdef SG_MUTANT_VIRT_NOT_EXCLUDED
+    if (0)
+#else
+    if ((!wcsnicmp( rest, L"Classes", 7 ) && (rest[7] == 0 || rest[7] == '\\')) ||
+        (!wcsnicmp( rest, L"Microsoft\\Windows", 17 ) && (rest[17] == 0 || rest[17] == '\\')) ||
+        (!wcsnicmp( rest, L"Microsoft\\Windows NT", 20 ) && (rest[20] == 0 || rest[20] == '\\')))
+#endif
+    {
+        heap_free( full );
+        return NULL;
+    }
+    p = heap_alloc( (lstrlenW( rest ) + 2) * sizeof(WCHAR) );
+    if (p)
+    {
+        p[0] = '\\';
+        lstrcpyW( p + 1, rest );
+    }
+    heap_free( full );
+    return p;   /* "\" + rest */
+}
+
+#define VIRT_WRITE_ACCESS (KEY_SET_VALUE | KEY_CREATE_SUB_KEY | KEY_CREATE_LINK | DELETE | WRITE_DAC | WRITE_OWNER | \
+                           GENERIC_WRITE | GENERIC_ALL)
+
+/* the result of a plain open or create of a key below HKLM, as virtualization changes it: a write that is
+ * denied goes to the store; a key that is not there, or one opened to read, shows what the store holds */
+static NTSTATUS virt_fixup( HKEY hkey, const UNICODE_STRING *name, DWORD options, ACCESS_MASK access, BOOL create,
+                            const UNICODE_STRING *class, DWORD *dispos, HKEY *retkey, NTSTATUS status )
+{
+    static const UNICODE_STRING empty;
+    BOOL wants_write = access & VIRT_WRITE_ACCESS;
+    WCHAR *path;
+    NTSTATUS st;
+    HKEY key;
+
+    if (status && status != STATUS_ACCESS_DENIED && status != STATUS_OBJECT_NAME_NOT_FOUND) return status;
+    if (options & (REG_OPTION_OPEN_LINK | REG_OPTION_CREATE_LINK)) return status;
+    if (!virt_enabled() || !(path = virt_rest( hkey, name ))) return status;
+
+    if (status == STATUS_ACCESS_DENIED)
+    {
+        if ((wants_write || create) &&
+            !(st = open_classes_key( &key, path, &empty, options, access, TRUE, class, dispos, 0 )))
+        {
+            *retkey = key;
+            status = STATUS_SUCCESS;
+        }
+    }
+    else if (status == STATUS_OBJECT_NAME_NOT_FOUND)
+    {
+        if (!create && !(st = open_classes_key( &key, path, &empty, options, access, FALSE, NULL, NULL, 0 )))
+        {
+            *retkey = key;
+            status = STATUS_SUCCESS;
+        }
+    }
+    else if (!wants_write && *retkey)
+    {
+        HKEY user, machine;
+
+        /* the key is the machine's; when the store has it too, reading it sees both */
+        open_classes_sides( path, KEY_QUERY_VALUE | (access & (KEY_WOW64_64KEY | KEY_WOW64_32KEY)), &user, &machine );
+        if (machine) NtClose( machine );
+        if (user)
+        {
+            NtClose( user );
+#ifndef SG_MUTANT_VIRT_NO_STORE_READ
+            track_classes_key( *retkey, path, FALSE, access );
+#endif
+        }
+    }
     heap_free( path );
     return status;
 }
@@ -1177,7 +1442,11 @@ LSTATUS WINAPI DECLSPEC_HOTPATCH RegCreateKeyExW( HKEY hkey, LPCWSTR name, DWORD
     }
     if (!(hkey = get_special_root_hkey( hkey ))) return ERROR_INVALID_HANDLE;
 
-    return RtlNtStatusToDosError( create_key( retkey, hkey, nameW, options, access, &classW, dispos ) );
+    {
+        NTSTATUS status = create_key( retkey, hkey, nameW, options, access, &classW, dispos );
+        status = virt_fixup( hkey, &nameW, options, access, TRUE, &classW, dispos, retkey, status );
+        return RtlNtStatusToDosError( status );
+    }
 }
 
 
@@ -1235,7 +1504,11 @@ LSTATUS WINAPI DECLSPEC_HOTPATCH RegCreateKeyExA( HKEY hkey, LPCSTR name, DWORD
                     status = open_classes_key( retkey, path, &NtCurrentTeb()->StaticUnicodeString, options, access,
                                                TRUE, &classW, dispos, classes_wow( hkey ) );
                 else
-                    status = create_key( retkey, hkey, NtCurrentTeb()->StaticUnicodeString, options, access, &classW, dispos );
+                {
+                    UNICODE_STRING nameW = NtCurrentTeb()->StaticUnicodeString;
+                    status = create_key( retkey, hkey, nameW, options, access, &classW, dispos );
+                    status = virt_fixup( hkey, &nameW, options, access, TRUE, &classW, dispos, retkey, status );
+                }
                 RtlFreeUnicodeString( &classW );
             }
         }
@@ -1284,7 +1557,11 @@ LSTATUS WINAPI DECLSPEC_HOTPATCH RegOpenKeyExW( HKEY hkey, LPCWSTR name, DWORD o
     }
     if (!(hkey = get_special_root_hkey( hkey ))) return ERROR_INVALID_HANDLE;
 
-    return RtlNtStatusToDosError( open_key( retkey, hkey, &nameW, options, access, FALSE ) );
+    {
+        NTSTATUS status = open_key( retkey, hkey, &nameW, options, access, FALSE );
+        status = virt_fixup( hkey, &nameW, options, access, FALSE, NULL, NULL, retkey, status );
+        return RtlNtStatusToDosError( status );
+    }
 }
 
 
@@ -1339,7 +1616,11 @@ LSTATUS WINAPI DECLSPEC_HOTPATCH RegOpenKeyExA( HKEY hkey, LPCSTR name, DWORD op
             UNICODE_STRING nameW = NtCurrentTeb()->StaticUnicodeString;
             if (path) status = open_classes_key( retkey, path, &nameW, options, access, FALSE, NULL, NULL,
                                                  classes_wow( hkey ) );
-            else status = open_key( retkey, hkey, &nameW, options, access, FALSE );
+            else
+            {
+                status = open_key( retkey, hkey, &nameW, options, access, FALSE );
+                status = virt_fixup( hkey, &nameW, options, access, FALSE, NULL, NULL, retkey, status );
+            }
         }
         heap_free( path );
     }
