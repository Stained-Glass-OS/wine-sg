+/* Stained Glass OS: the descriptor of a key of the machine hive that has none.
+ *
+ * Keys loaded from system.reg carry no descriptor (they are not saved), and
+ * check_object_access() lets everyone do everything with an object without one:
+ * in a shared prefix any user could then write HKLM\Software\...\Run, an
+ * autostart for every user. A key under \Registry\Machine without a descriptor is
+ * therefore checked against the one Windows gives machine keys (SYSTEM and
+ * Administrators full, Users read), unless it is one of the keys the unprivileged
+ * sessions have to write (the display configuration: sg_is_display_config_name).
+ * Keys with a descriptor keep it; HKCU and other users' hives are not touched. */
+const struct security_descriptor *sg_key_default_sd( struct object *obj )
+{
+    static const WCHAR machineW[] = {'\\','R','e','g','i','s','t','r','y','\\','M','a','c','h','i','n','e'};
+    data_size_t len = 0;
+    WCHAR *name;
+    int machine;
+
+#ifdef SG_MUTANT_MKEY_NODEFAULT
+    return NULL;
+#endif
+    if (!sg_system_prefix || !current || obj->ops != &key_ops) return NULL;
+    if (!(name = default_get_full_name( obj, &len ))) return NULL;
+    machine = len >= sizeof(machineW) && !memicmp_strW( name, machineW, sizeof(machineW) ) &&
+              (len == sizeof(machineW) || name[ARRAY_SIZE(machineW)] == '\\');
+    if (machine && sg_is_display_config_name( name, len )) machine = 0;
+    free( name );
+    return machine ? sg_machine_key_sd() : NULL;
+}
