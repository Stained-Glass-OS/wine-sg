+/* The roots and paths of the two sides of a key of a merged view. The view of
+ * HKEY_CLASSES_ROOT: HKCU\Software\Classes\path over HKLM\Software\Classes\path. The view of
+ * a virtualized machine key (path begins with a backslash, then the path below HKLM\Software):
+ * the per-user store HKCU\Software\Classes\VirtualStore\MACHINE\SOFTWARE\path over HKLM\Software\path.
+ * The store of a 32-bit process on 64-bit Windows keeps its keys below Wow6432Node. Allocated. */
+static BOOL view_paths( const WCHAR *path, ACCESS_MASK access, HKEY *user_root, WCHAR **user_path,
+                        HKEY *machine_root, WCHAR **machine_path )
+{
+    *user_root = get_special_root_hkey( HKEY_CURRENT_USER );
+    *user_path = *machine_path = NULL;
+    if (path[0] != '\\')
+    {
+        *machine_root = get_special_root_hkey( HKEY_CLASSES_ROOT );
+        *user_path = user_classes_path( path );
+        if ((*machine_path = heap_alloc( (lstrlenW( path ) + 1) * sizeof(WCHAR) ))) lstrcpyW( *machine_path, path );
+    }
+    else
+    {
+        static const WCHAR store[] = L"Software\\Classes\\VirtualStore\\MACHINE\\SOFTWARE";
+        BOOL wow = (is_wow64 && !(access & KEY_WOW64_64KEY)) || (is_win64 && (access & KEY_WOW64_32KEY));
+        const WCHAR *rest = path + 1;
+        DWORD len = lstrlenW( rest );
+
+        *machine_root = get_special_root_hkey( HKEY_LOCAL_MACHINE );
+        if ((*user_path = heap_alloc( (ARRAY_SIZE(store) + 16 + len + 2) * sizeof(WCHAR) )))
+        {
+            lstrcpyW( *user_path, store );
+            if (wow) lstrcatW( *user_path, L"\\Wow6432Node" );
+            if (len) { lstrcatW( *user_path, L"\\" ); lstrcatW( *user_path, rest ); }
+        }
+        if ((*machine_path = heap_alloc( (len + 10) * sizeof(WCHAR) )))
+        {
+            lstrcpyW( *machine_path, L"Software" );
+            if (len) { lstrcatW( *machine_path, L"\\" ); lstrcatW( *machine_path, rest ); }
+        }
+    }
+    return *user_root && *machine_root;
+}
+
 /* the user's and the machine's key of a path, either may be 0 */
 static void open_classes_sides( const WCHAR *path, ACCESS_MASK access, HKEY *user, HKEY *machine )
 {
     UNICODE_STRING nameW;
-    WCHAR *user_path;
-    HKEY root;
+    WCHAR *user_path, *machine_path;
+    HKEY user_root, machine_root;
 
     *user = *machine = 0;
-    if ((root = get_special_root_hkey( HKEY_CURRENT_USER )) && (user_path = user_classes_path( path )))
+    view_paths( path, access, &user_root, &user_path, &machine_root, &machine_path );
+    if (user_root && user_path)
     {
         RtlInitUnicodeString( &nameW, user_path );
-        if (open_key( user, root, &nameW, 0, access, FALSE )) *user = 0;
-        heap_free( user_path );
+        if (open_key( user, user_root, &nameW, 0, path[0] == '\\' ? access & ~(KEY_WOW64_64KEY | KEY_WOW64_32KEY) : access, FALSE ))
+            *user = 0;
     }
-    if ((root = get_special_root_hkey( HKEY_CLASSES_ROOT )))
+    if (machine_root && machine_path)
     {
-        RtlInitUnicodeString( &nameW, path );
-        if (open_key( machine, root, &nameW, 0, access, FALSE )) *machine = 0;
+        RtlInitUnicodeString( &nameW, machine_path );
+        if (open_key( machine, machine_root, &nameW, 0, access, FALSE )) *machine = 0;
     }
+    heap_free( user_path );
+    heap_free( machine_path );
 }
 
 /* open (or create) a key of the merged view */
@@ -821,7 +864,7 @@ static NTSTATUS open_classes_key( HKEY *retkey, const WCHAR *base, const UNICODE
                                   ACCESS_MASK parent_wow )
 {
     UNICODE_STRING pathW, userW;
-    WCHAR *path, *user_path = NULL;
+    WCHAR *path, *user_path = NULL, *machine_path = NULL;
     NTSTATUS status = STATUS_OBJECT_NAME_NOT_FOUND;
     ACCESS_MASK user_access = access & ~(KEY_WOW64_64KEY | KEY_WOW64_32KEY);
     BOOL user_bound = FALSE;
@@ -830,12 +873,22 @@ static NTSTATUS open_classes_key( HKEY *retkey, const WCHAR *base, const UNICODE
     /* a key below one opened in a view is in that view, unless asked otherwise */
     if (!(access & (KEY_WOW64_64KEY | KEY_WOW64_32KEY))) access |= parent_wow;
     if (!(path = join_classes_path( base, name ))) return STATUS_NO_MEMORY;
-    RtlInitUnicodeString( &pathW, path );
-    user_root = get_special_root_hkey( HKEY_CURRENT_USER );
-    machine_root = get_special_root_hkey( HKEY_CLASSES_ROOT );
+    /* the path of a virtualized machine key begins with a backslash, which the join keeps out */
+    if (base[0] == '\\' && path[0] != '\\')
+    {
