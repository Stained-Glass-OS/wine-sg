From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sysdm.cpl: System Properties is "control sysdm.cpl", not Settings > About

Windows 10 sends "control /name Microsoft.System" to Settings > About
(and Stained Glass's Control Panel now does too, sg-shell, David
2026-10-08: "match what Windows does"), while sysdm.cpl stays System
Properties. sysdm.cpl opened as a Control Panel item asked for
"/name Microsoft.System"; it now asks for "sysdm.cpl", the Control
Panel's own page.

Without Stained Glass's Control Panel, control.exe is Wine's, which
hosts sysdm.cpl again for "control sysdm.cpl" -- which would start it
again, endlessly. sysdm.cpl marks the environment and does not start
control.exe a second time.

Gate: test/sysdm-gate.sh. Mutant SG_MUTANT_SYSDM_LOOPS.
---
--- a/dlls/sysdm.cpl/sysdm.c
+++ b/dlls/sysdm.cpl/sysdm.c
@@ -40,6 +40,17 @@
 {
     SHELLEXECUTEINFOW sei = { sizeof(sei) };
 
+    /* Stained Glass OS (wine-sg 1512): "control.exe sysdm.cpl" is ours when
+     * Stained Glass's Control Panel is installed; Wine's own would host this
+     * applet again, which would start it again -- once is enough */
+#ifndef SG_MUTANT_SYSDM_LOOPS
+    if (GetEnvironmentVariableW( L"SG_SYSDM_RAN_CONTROL", NULL, 0 ))
+    {
+        WARN( "control.exe came back to sysdm.cpl: not again\n" );
+        return;
+    }
+#endif
+    SetEnvironmentVariableW( L"SG_SYSDM_RAN_CONTROL", L"1" );
     sei.fMask = SEE_MASK_NOCLOSEPROCESS;
     sei.lpFile = L"control.exe";
     sei.lpParameters = args;
@@ -84,8 +95,10 @@
         return 0;
     }
     case CPL_DBLCLK:
-        /* the Control Panel's System page */
-        run_control( L"/name Microsoft.System" );
+        /* System Properties: the Control Panel's own page. Not
+         * "/name Microsoft.System", which is Settings > About in Windows 10
+         * (Stained Glass OS, wine-sg 1512) */
+        run_control( L"sysdm.cpl" );
         return 0;
     }
     return 0;
