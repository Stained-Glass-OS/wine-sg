+struct array_store
+{
+    IPropertyStore IPropertyStore_iface;
+    LONG ref;
+    IPropertyStore **stores;
+    UINT count;
+    PROPERTYKEY *keys;
+    UINT key_count;
+};
+
+static struct array_store *impl_from_array_store(IPropertyStore *iface)
+{
+    return CONTAINING_RECORD(iface, struct array_store, IPropertyStore_iface);
+}
+
+static HRESULT WINAPI array_store_QueryInterface(IPropertyStore *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IPropertyStore))
+    {
+        *ppv = iface;
+        IPropertyStore_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI array_store_AddRef(IPropertyStore *iface)
+{
+    return InterlockedIncrement(&impl_from_array_store(iface)->ref);
+}
+
+static ULONG WINAPI array_store_Release(IPropertyStore *iface)
+{
+    struct array_store *store = impl_from_array_store(iface);
+    ULONG ref = InterlockedDecrement(&store->ref);
+    UINT i;
+
+    if (!ref)
+    {
+        for (i = 0; i < store->count; i++) IPropertyStore_Release(store->stores[i]);
+        free(store->stores);
+        free(store->keys);
+        free(store);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI array_store_GetCount(IPropertyStore *iface, DWORD *count)
+{
+    struct array_store *store = impl_from_array_store(iface);
+
+    if (!count) return E_POINTER;
+    *count = store->key_count;
+    return S_OK;
+}
+
+static HRESULT WINAPI array_store_GetAt(IPropertyStore *iface, DWORD index, PROPERTYKEY *key)
+{
+    struct array_store *store = impl_from_array_store(iface);
+
+    if (!key) return E_POINTER;
+    if (index >= store->key_count) return E_INVALIDARG;
+    *key = store->keys[index];
+    return S_OK;
+}
+
+/* a value is the array's when every item has it and they are all equal */
+static HRESULT WINAPI array_store_GetValue(IPropertyStore *iface, REFPROPERTYKEY key, PROPVARIANT *value)
+{
+    struct array_store *store = impl_from_array_store(iface);
+    UINT i;
+
+    if (!key || !value) return E_POINTER;
+    PropVariantInit(value);
+    for (i = 0; i < store->count; i++)
+    {
+        PROPVARIANT cur;
+        HRESULT hr;
+
+        PropVariantInit(&cur);
+        hr = IPropertyStore_GetValue(store->stores[i], key, &cur);
+        if (FAILED(hr) || cur.vt == VT_EMPTY
+#ifndef SG_MUTANT_ARRSTORE_ANY
+                || (i && PropVariantCompareEx(value, &cur, PVCU_DEFAULT, PVCF_DEFAULT))
+#endif
+                )
+        {
+            PropVariantClear(&cur);
+            PropVariantClear(value);
+            return FAILED(hr) ? hr : S_OK;
+        }
+        if (!i) *value = cur;
+        else PropVariantClear(&cur);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI array_store_SetValue(IPropertyStore *iface, REFPROPERTYKEY key, REFPROPVARIANT value)
+{
+    struct array_store *store = impl_from_array_store(iface);
+    HRESULT hr = S_OK;
+    UINT i;
+
+    for (i = 0; i < store->count && SUCCEEDED(hr); i++)
+        hr = IPropertyStore_SetValue(store->stores[i], key, value);
+    return hr;
+}
+
+static HRESULT WINAPI array_store_Commit(IPropertyStore *iface)
+{
+    struct array_store *store = impl_from_array_store(iface);
+    HRESULT hr = S_OK;
+    UINT i;
+
+    for (i = 0; i < store->count && SUCCEEDED(hr); i++)
+        hr = IPropertyStore_Commit(store->stores[i]);
+    return hr;
+}
+
+static const IPropertyStoreVtbl array_store_vtbl =
+{
+    array_store_QueryInterface,
+    array_store_AddRef,
+    array_store_Release,
+    array_store_GetCount,
+    array_store_GetAt,
+    array_store_GetValue,
+    array_store_SetValue,
+    array_store_Commit,
+};
