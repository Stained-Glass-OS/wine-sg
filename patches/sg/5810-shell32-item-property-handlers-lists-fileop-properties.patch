+static void set_class_value(const WCHAR *key, const WCHAR *name, const WCHAR *value)
+{
+    HKEY hkey;
+    LONG ls = RegCreateKeyExW(HKEY_CLASSES_ROOT, key, 0, NULL, 0, KEY_WRITE, NULL, &hkey, NULL);
+
+    ok(!ls, "create %s failed %ld\n", debugstr_w(key), ls);
+    if (ls) return;
+    RegSetValueExW(hkey, name, 0, REG_SZ, (const BYTE *)value, (wcslen(value) + 1) * sizeof(WCHAR));
+    RegCloseKey(hkey);
+}
+
+static WCHAR *list_names(IPropertyDescriptionList *list, WCHAR *buf)
+{
+    UINT i, n = 0;
+
+    buf[0] = 0;
+    IPropertyDescriptionList_GetCount(list, &n);
+    for (i = 0; i < n; i++)
+    {
+        IPropertyDescription *desc;
+        WCHAR *name;
+
+        if (FAILED(IPropertyDescriptionList_GetAt(list, i, &IID_IPropertyDescription, (void **)&desc))) continue;
+        if (SUCCEEDED(IPropertyDescription_GetCanonicalName(desc, &name)))
+        {
+            if (buf[0]) wcscat(buf, L";");
+            wcscat(buf, name);
+            CoTaskMemFree(name);
+        }
+        IPropertyDescription_Release(desc);
+    }
+    return buf;
+}
