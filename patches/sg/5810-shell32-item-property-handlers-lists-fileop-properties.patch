+static HRESULT shellitem_get_handler(struct shell_item *This, BOOL read_write, IPropertyStore **store)
+{
+    return PSGetItemPropertyHandler((IUnknown *)&This->IShellItem2_iface, read_write, &IID_IPropertyStore,
+            (void **)store);
+}
+
+/* what the file's registered property handler knows, for the keys the item's own names and
+ * attributes left empty */
+static void shellitem_merge_handler(IPropertyStore *store, IPropertyStore *handler, const PROPERTYKEY *keys, UINT count)
+{
+    PROPERTYKEY key;
+    PROPVARIANT var, cur;
+    DWORD n;
+    UINT i;
+
+    if (!keys)
+    {
+        if (FAILED(IPropertyStore_GetCount(handler, &n))) return;
+        count = n;
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        if (keys) key = keys[i];
+        else if (FAILED(IPropertyStore_GetAt(handler, i, &key))) continue;
+
+        PropVariantInit(&cur);
+        if (SUCCEEDED(IPropertyStore_GetValue(store, &key, &cur)) && cur.vt != VT_EMPTY)
+        {
+            PropVariantClear(&cur);
+            continue;
+        }
+        PropVariantInit(&var);
+        if (SUCCEEDED(IPropertyStore_GetValue(handler, &key, &var)) && var.vt != VT_EMPTY)
+            IPropertyStore_SetValue(store, &key, &var);
+        PropVariantClear(&var);
+    }
+}
