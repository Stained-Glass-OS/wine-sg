+static void test_description_lists(void)
+{
+    IShellItem2 *items[2], *other;
+    IShellItemArray *array;
+    IPropertyDescriptionList *list;
+    WCHAR buf[512];
+    HRESULT hr;
+
+    set_class_value(L".sgprop", L"FullDetails", L"prop:System.ItemNameDisplay;System.Size;System.Title");
+    set_class_value(L".sgprop2", L"FullDetails", L"prop:System.ItemNameDisplay;System.Title;System.Author");
+    set_class_value(L".sgprop", L"InfoTip", L"prop:System.Title");
+
+    items[0] = make_file(L"d1.sgprop", NULL);
+    items[1] = make_file(L"d2.sgprop2", NULL);
+    other = make_file(L"d3.sgnolist", NULL);
+
+    hr = IShellItem2_GetPropertyDescriptionList(items[0], &PKEY_PropList_FullDetails, &IID_IPropertyDescriptionList,
+            (void **)&list);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (hr == S_OK)
+    {
+        list_names(list, buf);
+        ok(!wcscmp(buf, L"System.ItemNameDisplay;System.Size;System.Title"), "got %s\n", debugstr_w(buf));
+        IPropertyDescriptionList_Release(list);
+    }
+
+    hr = IShellItem2_GetPropertyDescriptionList(items[0], &PKEY_PropList_InfoTip, &IID_IPropertyDescriptionList,
+            (void **)&list);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (hr == S_OK)
+    {
+        list_names(list, buf);
+        ok(!wcscmp(buf, L"System.Title"), "got %s\n", debugstr_w(buf));
+        IPropertyDescriptionList_Release(list);
+    }
+
+    hr = IShellItem2_GetPropertyDescriptionList(other, &PKEY_PropList_FullDetails, &IID_IPropertyDescriptionList,
+            (void **)&list);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND), "got %#lx\n", hr);
+    hr = IShellItem2_GetPropertyDescriptionList(items[0], &PKEY_Title, &IID_IPropertyDescriptionList, (void **)&list);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+
+    array = make_array(items, 2);
+    hr = IShellItemArray_GetPropertyDescriptionList(array, &PKEY_PropList_FullDetails,
+            &IID_IPropertyDescriptionList, (void **)&list);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (hr == S_OK)
+    {
+        list_names(list, buf);
+        ok(!wcscmp(buf, L"System.ItemNameDisplay;System.Title"), "common list: %s\n", debugstr_w(buf));
+        IPropertyDescriptionList_Release(list);
+    }
+    IShellItemArray_Release(array);
+
+    IShellItem2_Release(other);
+    IShellItem2_Release(items[0]);
+    IShellItem2_Release(items[1]);
+
+    RegDeleteTreeW(HKEY_CLASSES_ROOT, L".sgprop2");
+}
