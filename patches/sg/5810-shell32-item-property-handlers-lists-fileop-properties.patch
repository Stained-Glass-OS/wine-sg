+static IShellItem2 *shellitem_as_item2(IShellItem *item)
+{
+    IShellItem2 *item2 = NULL;
+    PIDLIST_ABSOLUTE pidl;
+
+    if (SUCCEEDED(IShellItem_QueryInterface(item, &IID_IShellItem2, (void **)&item2))) return item2;
+    if (SUCCEEDED(SHGetIDListFromObject((IUnknown *)item, &pidl)))
+    {
+        SHCreateItemFromIDList(pidl, &IID_IShellItem2, (void **)&item2);
+        ILFree(pidl);
+    }
+    return item2;
+}
+
+static HRESULT proplist_keys(IPropertyDescriptionList *list, PROPERTYKEY **keys, UINT *count)
+{
+    UINT i, n;
+    HRESULT hr;
+
+    *keys = NULL;
+    if (FAILED(hr = IPropertyDescriptionList_GetCount(list, &n))) return hr;
+    if (n && !(*keys = calloc(n, sizeof(**keys)))) return E_OUTOFMEMORY;
+    *count = 0;
+    for (i = 0; i < n; i++)
+    {
+        IPropertyDescription *desc;
+
+        if (FAILED(IPropertyDescriptionList_GetAt(list, i, &IID_IPropertyDescription, (void **)&desc))) continue;
+        if (SUCCEEDED(IPropertyDescription_GetPropertyKey(desc, &(*keys)[*count]))) ++*count;
+        IPropertyDescription_Release(desc);
+    }
+    return S_OK;
+}
