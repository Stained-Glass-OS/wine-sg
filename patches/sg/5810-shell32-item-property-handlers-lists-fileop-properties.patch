+static void test_array_bind(void)
+{
+    IShellItem2 *items[2];
+    IShellItemArray *array, *single;
+    IDataObject *data;
+    IUnknown *unk;
+    HRESULT hr;
+
+    items[0] = make_file(L"b1.txt", NULL);
+    items[1] = make_file(L"b2.txt", NULL);
+    array = make_array(items, 2);
+
+    hr = IShellItemArray_BindToHandler(array, NULL, &BHID_DataObject, &IID_IDataObject, (void **)&data);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (hr == S_OK)
+    {
+        ok(hdrop_count(data) == 2, "got %u files\n", hdrop_count(data));
+        IDataObject_Release(data);
+    }
+    hr = IShellItemArray_BindToHandler(array, NULL, &BHID_SFUIObject, &IID_IDataObject, (void **)&data);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (hr == S_OK)
+    {
+        ok(hdrop_count(data) == 2, "SFUIObject: got %u files\n", hdrop_count(data));
+        IDataObject_Release(data);
+    }
+    hr = IShellItemArray_BindToHandler(array, NULL, &BHID_Stream, &IID_IUnknown, (void **)&unk);
+    ok(hr == MK_E_NOOBJECT, "got %#lx\n", hr);
+
+    single = make_array(items, 1);
+    hr = IShellItemArray_BindToHandler(single, NULL, &BHID_DataObject, &IID_IDataObject, (void **)&data);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (hr == S_OK)
+    {
+        ok(hdrop_count(data) == 1, "single: got %u files\n", hdrop_count(data));
+        IDataObject_Release(data);
+    }
+    IShellItemArray_Release(single);
+    IShellItemArray_Release(array);
+    IShellItem2_Release(items[0]);
+    IShellItem2_Release(items[1]);
+}
