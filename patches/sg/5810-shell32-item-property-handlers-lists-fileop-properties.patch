+START_TEST(shellitemprops)
+{
+    DWORD cookie;
+    HKEY hkey;
+    WCHAR clsid[64], temp[MAX_PATH];
+    HRESULT hr;
+    LONG ls;
+
+    CoInitialize(NULL);
+
+    ls = RegCreateKeyExW(HKEY_LOCAL_MACHINE,
+            L"Software\\Microsoft\\Windows\\CurrentVersion\\PropertySystem\\PropertyHandlers\\.sgprop",
+            0, NULL, 0, KEY_WRITE, NULL, &hkey, NULL);
+    if (ls)
+    {
+        skip("cannot register the property handler: %ld\n", ls);
+        CoUninitialize();
+        return;
+    }
+    StringFromGUID2(&CLSID_TestHandler, clsid, ARRAY_SIZE(clsid));
+    RegSetValueExW(hkey, NULL, 0, REG_SZ, (const BYTE *)clsid, (wcslen(clsid) + 1) * sizeof(WCHAR));
+    RegCloseKey(hkey);
+
+    hr = CoRegisterClassObject(&CLSID_TestHandler, (IUnknown *)&factory, CLSCTX_INPROC_SERVER,
+            REGCLS_MULTIPLEUSE, &cookie);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    GetTempPathW(ARRAY_SIZE(temp), temp);
+    swprintf(dir, ARRAY_SIZE(dir), L"%ssgprops%lu", temp, GetCurrentProcessId());
+    CreateDirectoryW(dir, NULL);
+
+    test_item_store();
+    test_array_store();
+    test_description_lists();
+    test_array_bind();
+    test_file_operation();
+
+    {
+        WCHAR from[MAX_PATH + 2] = {0};
+        SHFILEOPSTRUCTW fo = { 0 };
+
+        wcscpy(from, dir);
+        fo.wFunc = FO_DELETE;
+        fo.pFrom = from;
+        fo.fFlags = FOF_NOCONFIRMATION | FOF_SILENT | FOF_NOERRORUI;
+        SHFileOperationW(&fo);
+    }
+    RegDeleteTreeW(HKEY_CLASSES_ROOT, L".sgprop");
+    RegDeleteTreeW(HKEY_LOCAL_MACHINE,
+            L"Software\\Microsoft\\Windows\\CurrentVersion\\PropertySystem\\PropertyHandlers\\.sgprop");
+    CoRevokeClassObject(cookie);
+    CoUninitialize();
+}
