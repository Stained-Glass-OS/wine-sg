+#define COBJMACROS
+#include <windows.h>
+#include <shellapi.h>
+#include <shlobj.h>
+#include <shlwapi.h>
+#include <initguid.h>
+#include <propkey.h>
+#include <propvarutil.h>
+#include "wine/test.h"
+
+static void init_string(const WCHAR *str, PROPVARIANT *v)
+{
+    v->vt = VT_LPWSTR;
+    SHStrDupW(str, &v->pwszVal);
+}
+
+static const CLSID CLSID_TestHandler =
+    {0x5a3f0e11, 0x7c1d, 0x4b7e, {0x9d, 0x2a, 0x6e, 0x8f, 0x10, 0x44, 0x21, 0xaa}};
+
+/* what the test property handler "wrote to the files" */
+static struct { WCHAR path[MAX_PATH]; WCHAR title[64]; } saved[16];
+
+static const WCHAR *saved_title(const WCHAR *path)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(saved); i++)
+        if (saved[i].path[0] && !wcsicmp(saved[i].path, path)) return saved[i].title;
+    return NULL;
+}
+
+struct handler
+{
+    IPropertyStore IPropertyStore_iface;
+    IInitializeWithFile IInitializeWithFile_iface;
+    LONG ref;
+    WCHAR path[MAX_PATH];
+    DWORD mode;
+    IPropertyStore *mem;
+};
+
+static struct handler *handler_from_store(IPropertyStore *iface)
+{
+    return CONTAINING_RECORD(iface, struct handler, IPropertyStore_iface);
+}
+
+static HRESULT WINAPI handler_QueryInterface(IPropertyStore *iface, REFIID riid, void **out)
+{
+    struct handler *h = handler_from_store(iface);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IPropertyStore)) *out = &h->IPropertyStore_iface;
+    else if (IsEqualIID(riid, &IID_IInitializeWithFile)) *out = &h->IInitializeWithFile_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI handler_AddRef(IPropertyStore *iface)
+{
+    return InterlockedIncrement(&handler_from_store(iface)->ref);
+}
+
+static ULONG WINAPI handler_Release(IPropertyStore *iface)
+{
+    struct handler *h = handler_from_store(iface);
+    ULONG ref = InterlockedDecrement(&h->ref);
+
+    if (!ref)
+    {
+        if (h->mem) IPropertyStore_Release(h->mem);
+        free(h);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI handler_GetCount(IPropertyStore *iface, DWORD *count)
+{
+    return IPropertyStore_GetCount(handler_from_store(iface)->mem, count);
+}
+
+static HRESULT WINAPI handler_GetAt(IPropertyStore *iface, DWORD i, PROPERTYKEY *key)
+{
+    return IPropertyStore_GetAt(handler_from_store(iface)->mem, i, key);
+}
+
+static HRESULT WINAPI handler_GetValue(IPropertyStore *iface, REFPROPERTYKEY key, PROPVARIANT *v)
+{
+    return IPropertyStore_GetValue(handler_from_store(iface)->mem, key, v);
+}
+
+static HRESULT WINAPI handler_SetValue(IPropertyStore *iface, REFPROPERTYKEY key, REFPROPVARIANT v)
+{
+    struct handler *h = handler_from_store(iface);
+
+    if (!(h->mode & (STGM_WRITE | STGM_READWRITE))) return STG_E_ACCESSDENIED;
+    return IPropertyStore_SetValue(h->mem, key, v);
+}
+
+static HRESULT WINAPI handler_Commit(IPropertyStore *iface)
+{
+    struct handler *h = handler_from_store(iface);
+    PROPVARIANT v;
+    unsigned int i;
+
+    PropVariantInit(&v);
+    IPropertyStore_GetValue(h->mem, &PKEY_Title, &v);
+    for (i = 0; i < ARRAY_SIZE(saved) && saved[i].path[0] && wcsicmp(saved[i].path, h->path); i++) {}
+    if (i < ARRAY_SIZE(saved))
+    {
+        wcscpy(saved[i].path, h->path);
+        wcscpy(saved[i].title, v.vt == VT_LPWSTR ? v.pwszVal : L"");
+    }
+    PropVariantClear(&v);
+    return S_OK;
+}
+
+static const IPropertyStoreVtbl handler_vtbl =
+{
+    handler_QueryInterface, handler_AddRef, handler_Release, handler_GetCount, handler_GetAt,
+    handler_GetValue, handler_SetValue, handler_Commit,
+};
+
+static HRESULT WINAPI init_QueryInterface(IInitializeWithFile *iface, REFIID riid, void **out)
+{
+    struct handler *h = CONTAINING_RECORD(iface, struct handler, IInitializeWithFile_iface);
+    return handler_QueryInterface(&h->IPropertyStore_iface, riid, out);
+}
+
+static ULONG WINAPI init_AddRef(IInitializeWithFile *iface)
+{
+    struct handler *h = CONTAINING_RECORD(iface, struct handler, IInitializeWithFile_iface);
+    return handler_AddRef(&h->IPropertyStore_iface);
+}
+
+static ULONG WINAPI init_Release(IInitializeWithFile *iface)
+{
+    struct handler *h = CONTAINING_RECORD(iface, struct handler, IInitializeWithFile_iface);
+    return handler_Release(&h->IPropertyStore_iface);
+}
+
+static HRESULT WINAPI init_Initialize(IInitializeWithFile *iface, const WCHAR *path, DWORD mode)
+{
+    struct handler *h = CONTAINING_RECORD(iface, struct handler, IInitializeWithFile_iface);
+    const WCHAR *title = saved_title(path);
+    PROPVARIANT v;
+
+    wcscpy(h->path, path);
+    h->mode = mode;
+    if (title && *title)
+    {
+        init_string(title, &v);
+        IPropertyStore_SetValue(h->mem, &PKEY_Title, &v);
+        PropVariantClear(&v);
+    }
+    return S_OK;
+}
+
+static const IInitializeWithFileVtbl init_vtbl = { init_QueryInterface, init_AddRef, init_Release, init_Initialize };
+
+static HRESULT WINAPI factory_QueryInterface(IClassFactory *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IClassFactory))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef(IClassFactory *iface) { return 2; }
+static ULONG WINAPI factory_Release(IClassFactory *iface) { return 1; }
+
+static HRESULT WINAPI factory_CreateInstance(IClassFactory *iface, IUnknown *outer, REFIID riid, void **out)
+{
+    struct handler *h;
+    HRESULT hr;
+
+    if (outer) return CLASS_E_NOAGGREGATION;
+    h = calloc(1, sizeof(*h));
+    h->IPropertyStore_iface.lpVtbl = &handler_vtbl;
+    h->IInitializeWithFile_iface.lpVtbl = &init_vtbl;
+    h->ref = 1;
+    PSCreateMemoryPropertyStore(&IID_IPropertyStore, (void **)&h->mem);
+    hr = IPropertyStore_QueryInterface(&h->IPropertyStore_iface, riid, out);
+    IPropertyStore_Release(&h->IPropertyStore_iface);
+    return hr;
+}
+
+static HRESULT WINAPI factory_LockServer(IClassFactory *iface, BOOL lock) { return S_OK; }
+
+static const IClassFactoryVtbl factory_vtbl =
+    { factory_QueryInterface, factory_AddRef, factory_Release, factory_CreateInstance, factory_LockServer };
+static IClassFactory factory = { &factory_vtbl };
+
+static WCHAR dir[MAX_PATH];
+
+static IShellItem2 *make_file(const WCHAR *name, WCHAR *path_out)
+{
+    IShellItem2 *item = NULL;
+    WCHAR path[MAX_PATH];
+    HANDLE h;
+    HRESULT hr;
+
+    swprintf(path, ARRAY_SIZE(path), L"%s\\%s", dir, name);
+    h = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    ok(h != INVALID_HANDLE_VALUE, "create %s failed %lu\n", debugstr_w(path), GetLastError());
+    CloseHandle(h);
+    hr = SHCreateItemFromParsingName(path, NULL, &IID_IShellItem2, (void **)&item);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (path_out) wcscpy(path_out, path);
+    return item;
+}
+
+static IShellItemArray *make_array(IShellItem2 **items, unsigned int count)
+{
+    PIDLIST_ABSOLUTE pidls[4];
+    IShellItemArray *array = NULL;
+    unsigned int i;
+    HRESULT hr;
+
+    for (i = 0; i < count; i++) SHGetIDListFromObject((IUnknown *)items[i], &pidls[i]);
+    hr = SHCreateShellItemArrayFromIDLists(count, (PCIDLIST_ABSOLUTE_ARRAY)pidls, &array);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    for (i = 0; i < count; i++) ILFree(pidls[i]);
+    return array;
+}
+
+static void set_title(IPropertyStore *store, const WCHAR *title)
+{
+    PROPVARIANT v;
+    HRESULT hr;
+
+    init_string(title, &v);
+    hr = IPropertyStore_SetValue(store, &PKEY_Title, &v);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    PropVariantClear(&v);
+}
+
+static BOOL has_key(IPropertyStore *store, const PROPERTYKEY *key)
+{
+    DWORD i, count = 0;
+    PROPERTYKEY k;
+
+    IPropertyStore_GetCount(store, &count);
+    for (i = 0; i < count; i++)
+        if (SUCCEEDED(IPropertyStore_GetAt(store, i, &k)) && IsEqualPropertyKey(k, *key)) return TRUE;
+    return FALSE;
+}
+
+static void test_item_store(void)
+{
+    IShellItem2 *plain, *a;
+    IPropertyStore *store;
+    WCHAR plain_path[MAX_PATH], a_path[MAX_PATH];
+    PROPVARIANT v;
+    HRESULT hr;
+
+    plain = make_file(L"plain.txt", plain_path);
+    a = make_file(L"a.sgprop", a_path);
+
+    hr = IShellItem2_GetPropertyStore(plain, GPS_READWRITE, &IID_IPropertyStore, (void **)&store);
+    ok(hr == STG_E_ACCESSDENIED, "got %#lx\n", hr);
+    hr = IShellItem2_GetPropertyStore(plain, GPS_HANDLERPROPERTIESONLY, &IID_IPropertyStore, (void **)&store);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND), "got %#lx\n", hr);
+
+    hr = IShellItem2_GetPropertyStore(a, GPS_READWRITE, &IID_IPropertyStore, (void **)&store);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (hr == S_OK)
+    {
+        set_title(store, L"first");
+        hr = IPropertyStore_Commit(store);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        IPropertyStore_Release(store);
+    }
+    ok(saved_title(a_path) && !wcscmp(saved_title(a_path), L"first"), "handler saved %s\n",
+            debugstr_w(saved_title(a_path)));
+
+    hr = IShellItem2_GetPropertyStore(a, GPS_DEFAULT, &IID_IPropertyStore, (void **)&store);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    PropVariantInit(&v);
+    hr = IPropertyStore_GetValue(store, &PKEY_Title, &v);
+    ok(hr == S_OK && v.vt == VT_LPWSTR && !wcscmp(v.pwszVal, L"first"), "got %#lx vt %u\n", hr, v.vt);
+    PropVariantClear(&v);
+    ok(has_key(store, &PKEY_FileName), "file name missing\n");
+    IPropertyStore_Release(store);
+
+    hr = IShellItem2_GetPropertyStore(a, GPS_HANDLERPROPERTIESONLY, &IID_IPropertyStore, (void **)&store);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(has_key(store, &PKEY_Title), "title missing\n");
+    ok(!has_key(store, &PKEY_FileName), "file name present\n");
+    IPropertyStore_Release(store);
+
+    hr = IShellItem2_GetPropertyStore(a, GPS_FASTPROPERTIESONLY, &IID_IPropertyStore, (void **)&store);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(!has_key(store, &PKEY_Title), "title present in fast store\n");
+    IPropertyStore_Release(store);
+
+    IShellItem2_Release(plain);
+    IShellItem2_Release(a);
+}
