+static void test_file_operation(void)
+{
+    PROPERTYKEY keys[1] = { PKEY_Title };
+    IFileOperation *op;
+    IPropertyChangeArray *changes;
+    IShellItem2 *a, *plain, *folder;
+    IShellItem *dest = NULL;
+    WCHAR a_path[MAX_PATH], plain_path[MAX_PATH], copy_path[MAX_PATH], destdir[MAX_PATH];
+    PKA_FLAGS flags[1] = { PKA_SET };
+    PROPVARIANT values[1];
+    BOOL aborted;
+    HRESULT hr;
+
+    init_string(L"via-operation", &values[0]);
+    hr = PSCreatePropertyChangeArray(keys, flags, values, 1, &IID_IPropertyChangeArray, (void **)&changes);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    PropVariantClear(&values[0]);
+
+    a = make_file(L"op.sgprop", a_path);
+    plain = make_file(L"op.txt", plain_path);
+
+    hr = CoCreateInstance(&CLSID_FileOperation, NULL, CLSCTX_INPROC_SERVER, &IID_IFileOperation, (void **)&op);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IFileOperation_SetOperationFlags(op, FOF_NOCONFIRMATION | FOF_SILENT | FOF_NOERRORUI);
+    hr = IFileOperation_SetProperties(op, changes);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IFileOperation_ApplyPropertiesToItem(op, (IShellItem *)a);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IFileOperation_ApplyPropertiesToItem(op, NULL);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    ok(!saved_title(a_path) || !*saved_title(a_path), "applied before PerformOperations\n");
+    hr = IFileOperation_PerformOperations(op);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(saved_title(a_path) && !wcscmp(saved_title(a_path), L"via-operation"), "title %s\n", debugstr_w(saved_title(a_path)));
+    aborted = TRUE;
+    IFileOperation_GetAnyOperationsAborted(op, &aborted);
+    ok(!aborted, "aborted\n");
+    IFileOperation_Release(op);
+
+    /* a file without a property handler cannot take them */
+    hr = CoCreateInstance(&CLSID_FileOperation, NULL, CLSCTX_INPROC_SERVER, &IID_IFileOperation, (void **)&op);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IFileOperation_SetOperationFlags(op, FOF_NOCONFIRMATION | FOF_SILENT | FOF_NOERRORUI);
+    IFileOperation_SetProperties(op, changes);
+    IFileOperation_ApplyPropertiesToItem(op, (IShellItem *)plain);
+    hr = IFileOperation_PerformOperations(op);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    aborted = FALSE;
+    IFileOperation_GetAnyOperationsAborted(op, &aborted);
+    ok(aborted, "not aborted\n");
+    IFileOperation_Release(op);
+
+    /* properties are set before the operation is queued; the copy carries them */
+    swprintf(destdir, ARRAY_SIZE(destdir), L"%s\\copies", dir);
+    CreateDirectoryW(destdir, NULL);
+    hr = SHCreateItemFromParsingName(destdir, NULL, &IID_IShellItem2, (void **)&folder);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = CoCreateInstance(&CLSID_FileOperation, NULL, CLSCTX_INPROC_SERVER, &IID_IFileOperation, (void **)&op);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IFileOperation_SetOperationFlags(op, FOF_NOCONFIRMATION | FOF_SILENT | FOF_NOERRORUI);
+    hr = IFileOperation_CopyItem(op, (IShellItem *)a, (IShellItem *)folder, L"copy-before.sgprop", NULL);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IFileOperation_SetProperties(op, changes);
+    hr = IFileOperation_CopyItem(op, (IShellItem *)a, (IShellItem *)folder, L"copy-after.sgprop", NULL);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IFileOperation_SetProperties(op, NULL);
+    hr = IFileOperation_CopyItem(op, (IShellItem *)a, (IShellItem *)folder, L"copy-cleared.sgprop", NULL);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IFileOperation_PerformOperations(op);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IFileOperation_Release(op);
+
+    swprintf(copy_path, ARRAY_SIZE(copy_path), L"%s\\copy-after.sgprop", destdir);
+    ok(saved_title(copy_path) && !wcscmp(saved_title(copy_path), L"via-operation"), "after: %s\n",
+            debugstr_w(saved_title(copy_path)));
+    swprintf(copy_path, ARRAY_SIZE(copy_path), L"%s\\copy-before.sgprop", destdir);
+    ok(!saved_title(copy_path), "before: %s\n", debugstr_w(saved_title(copy_path)));
+    swprintf(copy_path, ARRAY_SIZE(copy_path), L"%s\\copy-cleared.sgprop", destdir);
+    ok(!saved_title(copy_path), "cleared: %s\n", debugstr_w(saved_title(copy_path)));
+
+    IShellItem2_Release(folder);
+    IShellItem2_Release(a);
+    IShellItem2_Release(plain);
+    IPropertyChangeArray_Release(changes);
+    if (dest) IShellItem_Release(dest);
+}
