+/* IFileOperation::SetProperties: each change is applied to the item's current value and the
+ * result written through the item's writable property store, which is its property handler */
+static HRESULT apply_properties(IShellItem *item, IPropertyChangeArray *changes)
+{
+    IPropertyStore *store;
+    IShellItem2 *item2;
+    HRESULT hr;
+    UINT i, count;
+
+    if (!changes) return S_OK;
+#ifdef SG_MUTANT_FOP_NOAPPLY
+    return S_OK;
+#endif
+    if (FAILED(hr = IPropertyChangeArray_GetCount(changes, &count))) return hr;
+    if (!count) return S_OK;
+    if (FAILED(hr = IShellItem_QueryInterface(item, &IID_IShellItem2, (void **)&item2))) return hr;
+    hr = IShellItem2_GetPropertyStore(item2, GPS_READWRITE, &IID_IPropertyStore, (void **)&store);
+    IShellItem2_Release(item2);
+    if (FAILED(hr)) return hr;
+
+    for (i = 0; i < count && SUCCEEDED(hr); i++)
+    {
+        IPropertyChange *change;
+        PROPVARIANT old, new;
+        PROPERTYKEY key;
+
+        if (FAILED(hr = IPropertyChangeArray_GetAt(changes, i, &IID_IPropertyChange, (void **)&change)))
+            break;
+        PropVariantInit(&old);
+        PropVariantInit(&new);
+        if (SUCCEEDED(hr = IPropertyChange_GetPropertyKey(change, &key))
+                && SUCCEEDED(hr = IPropertyStore_GetValue(store, &key, &old))
+                && SUCCEEDED(hr = IPropertyChange_ApplyToPropVariant(change, &old, &new)))
+            hr = IPropertyStore_SetValue(store, &key, &new);
+        PropVariantClear(&old);
+        PropVariantClear(&new);
+        IPropertyChange_Release(change);
+    }
+    if (SUCCEEDED(hr)) hr = IPropertyStore_Commit(store);
+    IPropertyStore_Release(store);
+    return hr;
+}
