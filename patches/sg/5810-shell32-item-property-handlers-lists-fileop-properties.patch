+static void test_array_store(void)
+{
+    IShellItem2 *items[2];
+    IShellItemArray *array;
+    IPropertyStore *store;
+    WCHAR p1[MAX_PATH], p2[MAX_PATH];
+    PROPVARIANT v;
+    HRESULT hr;
+
+    items[0] = make_file(L"s1.sgprop", p1);
+    items[1] = make_file(L"s2.sgprop", p2);
+    array = make_array(items, 2);
+
+    hr = IShellItemArray_GetPropertyStore(array, GPS_READWRITE, &IID_IPropertyStore, (void **)&store);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    set_title(store, L"both");
+    hr = IPropertyStore_Commit(store);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IPropertyStore_Release(store);
+    ok(saved_title(p1) && !wcscmp(saved_title(p1), L"both"), "first item: %s\n", debugstr_w(saved_title(p1)));
+    ok(saved_title(p2) && !wcscmp(saved_title(p2), L"both"), "second item: %s\n", debugstr_w(saved_title(p2)));
+
+    hr = IShellItemArray_GetPropertyStore(array, GPS_DEFAULT, &IID_IPropertyStore, (void **)&store);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    PropVariantInit(&v);
+    hr = IPropertyStore_GetValue(store, &PKEY_Title, &v);
+    ok(hr == S_OK && v.vt == VT_LPWSTR && !wcscmp(v.pwszVal, L"both"), "equal values: %#lx vt %u\n", hr, v.vt);
+    PropVariantClear(&v);
+    ok(has_key(store, &PKEY_Title), "title is common\n");
+    /* the names differ: no common value, and not in the common keys' values */
+    hr = IPropertyStore_GetValue(store, &PKEY_FileName, &v);
+    ok(hr == S_OK && v.vt == VT_EMPTY, "differing values: %#lx vt %u\n", hr, v.vt);
+    PropVariantClear(&v);
+    IPropertyStore_Release(store);
+
+    /* a different title on one: not shared any more */
+    hr = IShellItem2_GetPropertyStore(items[1], GPS_READWRITE, &IID_IPropertyStore, (void **)&store);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    set_title(store, L"other");
+    IPropertyStore_Commit(store);
+    IPropertyStore_Release(store);
+    hr = IShellItemArray_GetPropertyStore(array, GPS_DEFAULT, &IID_IPropertyStore, (void **)&store);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IPropertyStore_GetValue(store, &PKEY_Title, &v);
+    ok(hr == S_OK && v.vt == VT_EMPTY, "differing titles: %#lx vt %u\n", hr, v.vt);
+    PropVariantClear(&v);
+    IPropertyStore_Release(store);
+
+    IShellItemArray_Release(array);
+    IShellItem2_Release(items[0]);
+    IShellItem2_Release(items[1]);
+}
