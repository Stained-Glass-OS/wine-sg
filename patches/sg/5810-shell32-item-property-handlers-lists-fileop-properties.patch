+static BOOL proplist_read(const WCHAR *class_path, const WCHAR *name, WCHAR **list)
+{
+    DWORD size = 0, type;
+    HKEY key;
+    BOOL ret = FALSE;
+
+    if (RegOpenKeyExW(HKEY_CLASSES_ROOT, class_path, 0, KEY_READ, &key)) return FALSE;
+    if (!RegQueryValueExW(key, name, NULL, &type, NULL, &size) && (type == REG_SZ || type == REG_EXPAND_SZ) && size > 2
+            && (*list = malloc(size + sizeof(WCHAR))))
+    {
+        if (RegQueryValueExW(key, name, NULL, NULL, (BYTE *)*list, &size)) free(*list);
+        else
+        {
+            (*list)[size / sizeof(WCHAR)] = 0;
+            ret = TRUE;
+        }
+    }
+    RegCloseKey(key);
+    return ret;
+}
+
+/* The property list registered for the item's type: on the file's ProgID, its extension,
+ * SystemFileAssociations (extension, then perceived type), then for all files or folders. */
+static HRESULT shellitem_proplist_string(struct shell_item *This, REFPROPERTYKEY type, WCHAR **list)
+{
+    WCHAR path[MAX_PATH], cls[MAX_PATH], buf[MAX_PATH + 64], val[MAX_PATH];
+    const WCHAR *name = NULL, *ext;
+    DWORD attrs, size;
+    HKEY key;
+    UINT i;
+
+    *list = NULL;
+    for (i = 0; i < ARRAY_SIZE(proplist_names); i++)
+        if (IsEqualPropertyKey(*type, *proplist_names[i].key)) name = proplist_names[i].name;
+    if (!name) return E_INVALIDARG;
+    if (!shellitem_fs_path(This, path)) return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    if ((attrs = GetFileAttributesW(path)) == INVALID_FILE_ATTRIBUTES)
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    if (attrs & FILE_ATTRIBUTE_DIRECTORY)
+    {
+        if (proplist_read(L"Directory", name, list) || proplist_read(L"Folder", name, list)
+                || proplist_read(L"SystemFileAssociations\\Directory", name, list)
+                || proplist_read(L"AllFilesystemObjects", name, list))
+            return S_OK;
+        return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    }
+
+    ext = PathFindExtensionW(path);
+    if (*ext && wcslen(ext) < 100)
+    {
+        cls[0] = 0;
+        size = sizeof(cls) - sizeof(WCHAR);
+        if (!RegOpenKeyExW(HKEY_CLASSES_ROOT, ext, 0, KEY_READ, &key))
+        {
+            DWORD sz = sizeof(val) - sizeof(WCHAR);
+
+            if (!RegQueryValueExW(key, NULL, NULL, NULL, (BYTE *)cls, &size)) cls[size / sizeof(WCHAR)] = 0;
+            else cls[0] = 0;
+            val[0] = 0;
+            if (!RegQueryValueExW(key, L"PerceivedType", NULL, NULL, (BYTE *)val, &sz)) val[sz / sizeof(WCHAR)] = 0;
+            else val[0] = 0;
+            RegCloseKey(key);
+        }
+        else val[0] = 0;
+
+        if (cls[0] && proplist_read(cls, name, list)) return S_OK;
+        if (proplist_read(ext, name, list)) return S_OK;
+        swprintf(buf, ARRAY_SIZE(buf), L"SystemFileAssociations\\%s", ext);
+        if (proplist_read(buf, name, list)) return S_OK;
+        if (val[0])
+        {
+            swprintf(buf, ARRAY_SIZE(buf), L"SystemFileAssociations\\%s", val);
+            if (proplist_read(buf, name, list)) return S_OK;
+        }
+    }
+    if (proplist_read(L"*", name, list) || proplist_read(L"AllFilesystemObjects", name, list))
+        return S_OK;
+    return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+}
