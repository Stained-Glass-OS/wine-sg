+/* UTF-8 conversions of codecvt<char16_t> and codecvt<char32_t>. The state
+ * remembers that the byte order mark was handled (generated or consumed). */
+#define CODECVT_STATE_HEADER_DONE 1
+
+static const unsigned char utf8_bom[3] = {0xef, 0xbb, 0xbf};
+
+/* decode one character: returns its length, 0 when incomplete, -1 when invalid */
+static int utf8_decode(const unsigned char *s, const unsigned char *end, unsigned int *ch)
+{
+    unsigned int c = *s, len, i;
+
+    if (c < 0x80) { *ch = c; return 1; }
+    if (c < 0xc2) return -1;
+    if (c < 0xe0) { len = 2; c &= 0x1f; }
+    else if (c < 0xf0) { len = 3; c &= 0x0f; }
+    else if (c < 0xf5) { len = 4; c &= 0x07; }
+    else return -1;
+
+    for (i = 1; i < len; i++)
+    {
+        if (s + i >= end) return 0;
+        if ((s[i] & 0xc0) != 0x80) return -1;
+        c = (c << 6) | (s[i] & 0x3f);
+    }
+    /* overlong forms, surrogates and values past U+10FFFF are invalid */
+    if ((len == 3 && c < 0x800) || (len == 4 && (c < 0x10000 || c > 0x10ffff)) || (c >= 0xd800 && c <= 0xdfff))
+        return -1;
+    *ch = c;
+    return len;
+}
+
+static int utf8_header_in(int mode, _Mbstatet *state, const char **from, const char *from_end)
+{
+    size_t avail = from_end - *from;
+
+    if (!(mode & consume_header) || (state->state & CODECVT_STATE_HEADER_DONE))
+        return CODECVT_ok;
+    if (avail < sizeof(utf8_bom) && !memcmp(*from, utf8_bom, avail))
+        return CODECVT_partial; /* might still be a byte order mark */
+    if (avail >= sizeof(utf8_bom) && !memcmp(*from, utf8_bom, sizeof(utf8_bom)))
+        *from += sizeof(utf8_bom);
+    state->state |= CODECVT_STATE_HEADER_DONE;
+    return CODECVT_ok;
+}
+
+static int utf8_to_utf16(ULONG max_code, int mode, _Mbstatet *state, const char *from, const char *from_end,
+        const char **from_next, char16_t *to, char16_t *to_end, void **to_next)
+{
+    unsigned int ch;
+    int len, ret;
+
+    *from_next = from;
+    *to_next = to;
+    if (from == from_end) return CODECVT_ok;
+    if ((ret = utf8_header_in(mode, state, &from, from_end)) != CODECVT_ok)
+        return ret;
+    while (from < from_end)
+    {
+        if (to == to_end) { ret = CODECVT_partial; break; }
+        len = utf8_decode((const unsigned char *)from, (const unsigned char *)from_end, &ch);
+        if (!len) { ret = CODECVT_partial; break; }
+        if (len < 0 || ch > max_code) { ret = CODECVT_error; break; }
+        if (ch >= 0x10000)
+        {
+            if (to_end - to < 2) { ret = CODECVT_partial; break; }
+            ch -= 0x10000;
+            *to++ = 0xd800 | (ch >> 10);
+            *to++ = 0xdc00 | (ch & 0x3ff);
+        }
+        else *to++ = ch;
+        from += len;
+    }
+    *from_next = from;
+    *to_next = to;
+    return ret;
+}
+
+static int utf8_to_utf32(ULONG max_code, int mode, _Mbstatet *state, const char *from, const char *from_end,
+        const char **from_next, char32_t *to, char32_t *to_end, void **to_next)
+{
+    unsigned int ch;
+    int len, ret;
+
+    *from_next = from;
+    *to_next = to;
+    if (from == from_end) return CODECVT_ok;
+    if ((ret = utf8_header_in(mode, state, &from, from_end)) != CODECVT_ok)
+        return ret;
+    while (from < from_end)
+    {
+        if (to == to_end) { ret = CODECVT_partial; break; }
+        len = utf8_decode((const unsigned char *)from, (const unsigned char *)from_end, &ch);
+        if (!len) { ret = CODECVT_partial; break; }
+        if (len < 0 || ch > max_code) { ret = CODECVT_error; break; }
+        *to++ = ch;
+        from += len;
+    }
+    *from_next = from;
+    *to_next = to;
+    return ret;
+}
+
+/* write the byte order mark first when asked to; FALSE when there is no room */
+static BOOL utf8_header_out(int mode, _Mbstatet *state, char **to, char *to_end)
+{
+    if (!(mode & generate_header) || (state->state & CODECVT_STATE_HEADER_DONE))
+        return TRUE;
+    if (to_end - *to < sizeof(utf8_bom))
+        return FALSE;
+    memcpy(*to, utf8_bom, sizeof(utf8_bom));
+    *to += sizeof(utf8_bom);
+    state->state |= CODECVT_STATE_HEADER_DONE;
+    return TRUE;
+}
+
+static int utf8_encode(unsigned int ch, char *buf)
+{
+    if (ch < 0x80) { buf[0] = ch; return 1; }
+    if (ch < 0x800) { buf[0] = 0xc0 | (ch >> 6); buf[1] = 0x80 | (ch & 0x3f); return 2; }
+    if (ch < 0x10000)
+    {
+        buf[0] = 0xe0 | (ch >> 12); buf[1] = 0x80 | ((ch >> 6) & 0x3f); buf[2] = 0x80 | (ch & 0x3f);
+        return 3;
+    }
+    buf[0] = 0xf0 | (ch >> 18); buf[1] = 0x80 | ((ch >> 12) & 0x3f);
+    buf[2] = 0x80 | ((ch >> 6) & 0x3f); buf[3] = 0x80 | (ch & 0x3f);
+    return 4;
+}
+
+/* UTF-16 (utf16 TRUE) or UTF-32 to UTF-8; a surrogate pair is converted whole */
+static int utf_to_utf8(ULONG max_code, int mode, _Mbstatet *state, BOOL utf16, const void *from_start,
+        const void *from_end, const void **from_next, char *to, char *to_end, char **to_next)
+{
+    const char16_t *from16 = from_start, *end16 = from_end;
+    const char32_t *from32 = from_start, *end32 = from_end;
+    unsigned int ch, used;
+    char buf[4];
+    int len, ret = CODECVT_ok;
+
+    *from_next = from_start;
+    *to_next = to;
+    if (from_start == from_end) return CODECVT_ok;
+    if (!utf8_header_out(mode, state, &to, to_end))
+        return CODECVT_partial;
+
+    while (utf16 ? from16 < end16 : from32 < end32)
+    {
+        if (utf16)
+        {
+            ch = *from16;
+            used = 1;
+            if (ch >= 0xd800 && ch <= 0xdbff)
+            {
+                if (from16 + 1 == end16) { ret = CODECVT_partial; break; }
+                if (from16[1] < 0xdc00 || from16[1] > 0xdfff) { ret = CODECVT_error; break; }
+                ch = 0x10000 + ((ch - 0xd800) << 10) + (from16[1] - 0xdc00);
+                used = 2;
+            }
+            else if (ch >= 0xdc00 && ch <= 0xdfff) { ret = CODECVT_error; break; }
+        }
+        else
+        {
+            ch = *from32;
+            used = 1;
+            if (ch > 0x10ffff || (ch >= 0xd800 && ch <= 0xdfff)) { ret = CODECVT_error; break; }
+        }
+#ifndef SG_MUTANT_CODECVT_NO_MAXCODE
+        if (ch > max_code) { ret = CODECVT_error; break; }
+#endif
+        len = utf8_encode(ch, buf);
+        if (to_end - to < len) { ret = CODECVT_partial; break; }
+        memcpy(to, buf, len);
+        to += len;
+        if (utf16) from16 += used; else from32 += used;
+    }
+    *from_next = utf16 ? (const void *)from16 : (const void *)from32;
+    *to_next = to;
+    return ret;
+}
+
