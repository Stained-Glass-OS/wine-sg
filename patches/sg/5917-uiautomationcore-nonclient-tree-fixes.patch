From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uiautomationcore: the non-client provider's parts without the client object, linked to the window, without its control type

Found at integration (gates fastb-uiafind, fastuiarc, progman, uiacachetree):
with fast-b 3581 every HWND element has a non-client provider (the window's
OBJID_WINDOW object), and three things went wrong:

- the window object's client object became a child element of its own (each
  button appeared twice, every window ended in a copy of itself); in UI
  Automation the client area is the window's element itself, so the client
  object is skipped among a window object's children (told by identity with
  the window's OBJID_CLIENT object: a button's client object has the push
  button role);
- a non-client part's parent was a plain MSAA provider for the window object,
  so walking backwards from the parts never reached the window's child
  windows (last-to-first traversal stopped); the parent of a window object's
  part is now the window's non-client provider, whose node links the parts
  up with the other children;
- the window object answered the window's control type (always Window), so
  Progman and other child or captionless windows were no longer Panes; the
  control type stays the HWND provider's.

Mutants: SG_MUTANT_NC_CLIENT_CHILD, SG_MUTANT_NC_PARENT_LINK,
SG_MUTANT_NC_CONTROL_TYPE.
---
diff --git a/dlls/uiautomationcore/uia_provider.c b/dlls/uiautomationcore/uia_provider.c
--- a/dlls/uiautomationcore/uia_provider.c
+++ b/dlls/uiautomationcore/uia_provider.c
@@ -307,6 +307,54 @@ static HRESULT msaa_acc_get_parent(IAccessible *acc, IAccessible **parent)
     return hr;
 }
 
+static LONG msaa_acc_get_role(IAccessible *acc, VARIANT cid)
+{
+    VARIANT role;
+    LONG ret = 0;
+
+    VariantInit(&role);
+    if (SUCCEEDED(IAccessible_get_accRole(acc, cid, &role)) && V_VT(&role) == VT_I4)
+        ret = V_I4(&role);
+    VariantClear(&role);
+    return ret;
+}
+
+/*
+ * A window object (OBJID_WINDOW) is reached in UI Automation through the
+ * window's non-client provider. Its client object is not an element of its
+ * own there: the client area is the window's element itself, so the client
+ * object is skipped among a window object's children.
+ */
+static BOOL msaa_acc_is_window_object(IAccessible *acc)
+{
+    VARIANT cid;
+
+    variant_init_i4(&cid, CHILDID_SELF);
+    return msaa_acc_get_role(acc, cid) == ROLE_SYSTEM_WINDOW;
+}
+
+static BOOL msaa_acc_is_client_child(IAccessible *parent, IAccessible *acc, VARIANT cid)
+{
+    IAccessible *client = NULL;
+    HWND hwnd = NULL;
+    BOOL ret;
+
+#ifdef SG_MUTANT_NC_CLIENT_CHILD
+    return FALSE;
+#endif
+    /* the client object is a full object of its own (a button's has the push
+     * button role), so it is told by identity, not by role */
+    if (V_I4(&cid) != CHILDID_SELF || acc == parent || !msaa_acc_is_window_object(parent))
+        return FALSE;
+    if (FAILED(WindowFromAccessibleObject(parent, &hwnd)) || !hwnd)
+        return FALSE;
+    if (FAILED(AccessibleObjectFromWindow(hwnd, OBJID_CLIENT, &IID_IAccessible, (void **)&client)) || !client)
+        return FALSE;
+    ret = msaa_acc_compare(acc, client);
+    IAccessible_Release(client);
+    return ret;
+}
+
 #define DIR_FORWARD 0
 #define DIR_REVERSE 1
 static HRESULT msaa_acc_get_next_child(IAccessible *acc, LONG start_pos, LONG direction,
@@ -333,7 +381,8 @@ static HRESULT msaa_acc_get_next_child(IAccessible *acc, LONG start_pos, LONG di
 
         if (hr == S_FALSE)
         {
-            if (!check_visible || !msaa_check_acc_state(acc, cid, STATE_SYSTEM_INVISIBLE))
+            if (!check_visible || (!msaa_check_acc_state(acc, cid, STATE_SYSTEM_INVISIBLE) &&
+                    !msaa_acc_is_client_child(acc, acc, cid)))
             {
                 *child = acc;
                 *child_id = *child_pos = cur_pos;
@@ -351,7 +400,8 @@ static HRESULT msaa_acc_get_next_child(IAccessible *acc, LONG start_pos, LONG di
                 break;
 
             variant_init_i4(&cid, CHILDID_SELF);
-            if (!check_visible || !msaa_check_acc_state(acc_child, cid, STATE_SYSTEM_INVISIBLE))
+            if (!check_visible || (!msaa_check_acc_state(acc_child, cid, STATE_SYSTEM_INVISIBLE) &&
+                    !msaa_acc_is_client_child(acc, acc_child, cid)))
             {
                 *child = acc_child;
                 *child_id = CHILDID_SELF;
@@ -722,6 +772,14 @@ HRESULT WINAPI msaa_provider_GetPropertyValue(IRawElementProviderSimple *iface,
         break;
 
     case UIA_ControlTypePropertyId:
+        /* the window object behind a window's non-client provider: the window's
+         * control type (window or pane, by its style) is the HWND provider's */
+        if (msaa_prov->nonclient && V_I4(&msaa_prov->cid) == CHILDID_SELF && msaa_acc_is_window_object(msaa_prov->acc)
+#ifdef SG_MUTANT_NC_CONTROL_TYPE
+                && 0
+#endif
+           )
+            break;
         if (!msaa_prov->control_type)
         {
             hr = IAccessible_get_accRole(msaa_prov->acc, msaa_prov->cid, &v);
@@ -1053,6 +1111,27 @@ static HRESULT WINAPI msaa_fragment_Navigate(IRawElementProviderFragment *iface,
         else
             acc = msaa_prov->acc;
 
+        /* a window object's part: its parent is the window's non-client provider, whose
+         * node links the parts up with the window's other children */
+        if (msaa_acc_is_window_object(acc)
+#ifdef SG_MUTANT_NC_PARENT_LINK
+                && 0
+#endif
+           )
+        {
+            HWND hwnd = NULL;
+
+            if (SUCCEEDED(WindowFromAccessibleObject(acc, &hwnd)) && hwnd &&
+                    SUCCEEDED(UiaProviderForNonClient(hwnd, OBJID_WINDOW, CHILDID_SELF, &elprov)))
+            {
+                struct msaa_provider *prov = impl_from_msaa_provider(elprov);
+                *ret_val = &prov->IRawElementProviderFragment_iface;
+                if (acc != msaa_prov->acc)
+                    IAccessible_Release(acc);
+                break;
+            }
+        }
+
         hr = create_msaa_provider(acc, CHILDID_SELF, NULL, FALSE, FALSE, &elprov);
         if (SUCCEEDED(hr))
         {
