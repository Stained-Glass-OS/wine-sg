From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] quartz: AmpFactorToDB / DBToAmpFactor, RegisterFilter version check

AmpFactorToDB and DBToAmpFactor compute dB = 20 * log10(amplitude) and
its inverse (decibels in hundredths of a dB as in IBasicAudio, amplitude
as a percentage, 100 = unity; silence is -10000 / 0) instead of the fixed
FIXME values. IFilterMapper2::RegisterFilter accepts REGFILTER2 versions
1 (rgPins) and 2 (rgPins2); any other version fails with E_INVALIDARG
without touching the moniker or the registry, and a NULL prf2 gives
E_POINTER, instead of a FIXME and E_NOTIMPL.

---
diff --git a/dlls/quartz/filtermapper.c b/dlls/quartz/filtermapper.c
index 2707378..5954d21 100644
--- a/dlls/quartz/filtermapper.c
+++ b/dlls/quartz/filtermapper.c
@@ -878,6 +878,9 @@ static HRESULT WINAPI FilterMapper3_RegisterFilter(IFilterMapper3 *iface,
             iface, debugstr_guid(clsid), debugstr_w(name), ret_moniker,
             debugstr_guid(category), debugstr_w(instance), prf2);
 
+    if (!prf2)
+        return E_POINTER;
+
     if (prf2->dwVersion == 2)
     {
         regfilter2 = *prf2;
@@ -914,8 +917,13 @@ static HRESULT WINAPI FilterMapper3_RegisterFilter(IFilterMapper3 *iface,
     }
     else
     {
-        FIXME("dwVersion other that 1 or 2 not supported at the moment\n");
+        /* REGFILTER2 is defined for versions 1 (rgPins) and 2 (rgPins2) only. */
+        WARN("Unsupported REGFILTER2 version %lu.\n", prf2->dwVersion);
+#ifdef SG_MUTANT_RF_VERSION
         return E_NOTIMPL;
+#else
+        return E_INVALIDARG;
+#endif
     }
 
     if (ret_moniker)
diff --git a/dlls/quartz/main.c b/dlls/quartz/main.c
index 9f673aa..e5df636 100644
--- a/dlls/quartz/main.c
+++ b/dlls/quartz/main.c
@@ -17,6 +17,9 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
+#include <math.h>
+#include <limits.h>
+
 #include "wine/debug.h"
 
 #include "quartz_private.h"
@@ -678,19 +681,50 @@ const char * qzdebugstr_guid( const GUID * id )
     return debugstr_guid(id);
 }
 
+/* Undocumented exports; the unit conventions below are assumptions taken from
+ * the audio volume convention of IBasicAudio: decibels are hundredths of a dB
+ * (0 is full volume, -10000 is silence) and an amplitude factor is a percentage
+ * (100 is unity), with dB = 20 * log10(amplitude). */
+#define AMP_MIN_DB (-10000)
+
 int WINAPI AmpFactorToDB(int ampfactor)
 {
-    FIXME("(%d) Stub!\n", ampfactor);
-    return 0;
+    double db;
+
+    TRACE("(%d)\n", ampfactor);
+
+    if (ampfactor <= 0)
+        return AMP_MIN_DB;
+#ifdef SG_MUTANT_AMP_DB
+    db = 10.0 * 100.0 * log10(ampfactor / 100.0);
+#else
+    db = 20.0 * 100.0 * log10(ampfactor / 100.0);
+#endif
+    if (db < AMP_MIN_DB)
+        return AMP_MIN_DB;
+    if (db > INT_MAX)
+        return INT_MAX;
+    return floor(db + 0.5);
 }
 
 int WINAPI DBToAmpFactor(int db)
 {
-    FIXME("(%d) Stub!\n", db);
-    /* Avoid divide by zero (probably during range computation) in Windows Media Player 6.4 */
-    if (db < -1000)
-	return 0;
-    return 100;
+    double amp;
+
+    TRACE("(%d)\n", db);
+
+    /* Very low levels give 0, which also keeps callers that divide by the
+     * result while computing a range (WMP 6.4) away from large values. */
+    if (db <= AMP_MIN_DB)
+        return 0;
+#ifdef SG_MUTANT_AMP_AMP
+    amp = 100.0 * pow(10.0, db / 1000.0);
+#else
+    amp = 100.0 * pow(10.0, db / 2000.0);
+#endif
+    if (amp > INT_MAX)
+        return INT_MAX;
+    return floor(amp + 0.5);
 }
 
 /***********************************************************************
