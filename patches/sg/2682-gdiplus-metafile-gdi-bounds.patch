From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: frame of a metafile recorded with GDI drawing includes the last pixels

The bounds the GDI records of a recording report include their right and
bottom pixels, so the frame of a metafile recorded without a frame
rectangle is one pixel wider and higher than the bounds say: a rectangle
drawn from 25,25 to 75,75 through GetDC gives a width and height of 50, not
49, and a recording that holds only GDI drawing gets the frame of that
drawing. Removes three todo_wine marks of the metafile bounds tests.
---
--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -1744,6 +1744,15 @@ GpStatus METAFILE_GraphicsDeleted(GpMetafile* metafile)
         MetafileHeader header;
 
         stat = GdipGetMetafileHeaderFromEmf(metafile->hemf, &header);
+        /* a recording with GDI drawing only has the frame of what GDI drew */
+        if (stat == Ok && metafile->auto_frame && metafile->auto_frame_max.X < metafile->auto_frame_min.X &&
+                header.EmfHeader.rclBounds.right > header.EmfHeader.rclBounds.left &&
+                header.EmfHeader.rclBounds.bottom > header.EmfHeader.rclBounds.top)
+        {
+            /* the merge below makes it the bounds of the GDI records */
+            metafile->auto_frame_min.X = metafile->auto_frame_max.X = header.EmfHeader.rclBounds.left;
+            metafile->auto_frame_min.Y = metafile->auto_frame_max.Y = header.EmfHeader.rclBounds.top;
+        }
         if (stat == Ok && metafile->auto_frame &&
             metafile->auto_frame_max.X >= metafile->auto_frame_min.X)
         {
@@ -1762,8 +1771,14 @@ GpStatus METAFILE_GraphicsDeleted(GpMetafile* metafile)
 
                 af_min->X = fmin(af_min->X, gdi_bounds_rc.left);
                 af_min->Y = fmin(af_min->Y, gdi_bounds_rc.top);
+                /* the bounds of a GDI record include their right and bottom pixels */
+#ifdef SG_MUTANT_GP_BOUNDS_NO_PLUS1
                 af_max->X = fmax(af_max->X, gdi_bounds_rc.right);
                 af_max->Y = fmax(af_max->Y, gdi_bounds_rc.bottom);
+#else
+                af_max->X = fmax(af_max->X, gdi_bounds_rc.right + 1);
+                af_max->Y = fmax(af_max->Y, gdi_bounds_rc.bottom + 1);
+#endif
             }
 
             bounds_rc.left = floorf(metafile->auto_frame_min.X * x_scale);
--- a/dlls/gdiplus/tests/metafile.c
+++ b/dlls/gdiplus/tests/metafile.c
@@ -1405,8 +1405,8 @@ static void test_nullframerect(void) {
     expect(UnitPixel, unit);
     expectf_(25.0, bounds.X, 0.05);
     expectf_(25.0, bounds.Y, 0.05);
-    todo_wine expectf_(50.0, bounds.Width, 0.05);
-    todo_wine expectf_(50.0, bounds.Height, 0.05);
+    expectf_(50.0, bounds.Width, 0.05);
+    expectf_(50.0, bounds.Height, 0.05);
 
     stat = GdipDisposeImage((GpImage*)metafile);
     expect(Ok, stat);
@@ -1462,8 +1462,7 @@ static void test_nullframerect(void) {
     expect(UnitPixel, unit);
     expectf_(20.0, bounds.X, 0.05);
     expectf_(25.0, bounds.Y, 0.05);
-    expectf_(55.0, bounds.Width, 1.00);
-    todo_wine expectf_(55.0, bounds.Width, 0.05);
+    expectf_(55.0, bounds.Width, 0.05);
     expectf_(85.0, bounds.Height, 0.05);
 
     stat = GdipDisposeImage((GpImage*)metafile);
