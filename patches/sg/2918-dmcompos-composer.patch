+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "dmcompos_private.h"
+#include "dmplugin.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dmcompos);
+
+#define TEMPLATE_MEASURE   (DMUS_PPQ * 4)   /* templates count measures in 4/4 */
+#define DEFAULT_SCALE      0xab5ab5         /* major, two octaves */
+#define SECTION_MEASURES   4                /* a signpost every four measures */
+#define MAX_END_LENGTH     4
+#define COMPOSE_SEED       0x5eed1234u
+
+struct timing
+{
+    MUSIC_TIME beat;
+    MUSIC_TIME measure;
+};
+
+static void timing_init(struct timing *timing, const DMUS_TIMESIGNATURE *sig)
+{
+    DWORD beat_note = sig && sig->bBeat ? sig->bBeat : 4;
+    DWORD beats = sig && sig->bBeatsPerMeasure ? sig->bBeatsPerMeasure : 4;
+
+#ifdef SG_MUTANT_TIMESIG
+    beat_note = 4; beats = 4;
+#endif
+    timing->beat = DMUS_PPQ * 4 / beat_note;
+    timing->measure = timing->beat * beats;
+}
+
+static DWORD lcg_next(DWORD *seed)
+{
+    *seed = *seed * 1103515245u + 12345u;
+    return (*seed >> 16) & 0x7fff;
+}
+
+static DWORD compose_seed(DWORD salt)
+{
+#ifdef SG_MUTANT_SEED
+    return COMPOSE_SEED ^ GetTickCount() ^ salt;
+#else
+    return COMPOSE_SEED ^ (salt * 2654435761u);
+#endif
+}
+
+/* ---- chords ---- */
+
+/* the semitones of the scale inside one octave */
+static int scale_notes(DWORD scale, int notes[12])
+{
+    int i, count = 0;
+
+    for (i = 0; i < 12; i++)
+        if (scale & (1 << i)) notes[count++] = i;
+    return count;
+}
+
+static void chord_set(DMUS_CHORD_KEY *chord, int root, DWORD pattern, DWORD scale, BYTE key, MUSIC_TIME time,
+        const struct timing *timing)
+{
+    static const WCHAR *const names[12] = {L"C", L"C#", L"D", L"D#", L"E", L"F", L"F#", L"G", L"G#", L"A", L"A#", L"B"};
+    const WCHAR *quality = L"M";
+
+    memset(chord, 0, sizeof(*chord));
+    if (pattern & (1 << 3)) quality = (pattern & (1 << 6)) ? L"dim" : L"m";
+    else if (pattern & (1 << 8)) quality = L"aug";
+    swprintf(chord->wszName, ARRAY_SIZE(chord->wszName), L"%ls%ls", names[root % 12], quality);
+    chord->wMeasure = time / timing->measure;
+    chord->bBeat = (time % timing->measure) / timing->beat;
+    chord->bSubChordCount = 1;
+    chord->SubChordList[0].dwChordPattern = pattern;
+    chord->SubChordList[0].dwScalePattern = scale & 0xffffff;
+    chord->SubChordList[0].dwInversionPoints = 0xffffff;
+    chord->SubChordList[0].dwLevels = 0xffffffff;
+    chord->SubChordList[0].bChordRoot = root % 12;
+    chord->SubChordList[0].bScaleRoot = 0;
+    chord->dwScale = scale & 0xffffff;
+    chord->bKey = key;
+}
+
+/* the triad on a degree of the scale, built from the scale notes */
+static void chord_on_degree(DMUS_CHORD_KEY *chord, DWORD scale, int degree, BYTE key, MUSIC_TIME time,
+        const struct timing *timing)
+{
+    int notes[12], n = scale_notes(scale, notes), root, third, fifth;
+    DWORD pattern = 1;
+
+    if (!n)
+    {
+        scale = DEFAULT_SCALE;
+        n = scale_notes(scale, notes);
+    }
+    root = notes[degree % n];
+    if (n >= 3)
+    {
+        third = notes[(degree + 2) % n] + ((degree + 2) % n < degree % n ? 12 : 0);
+        fifth = notes[(degree + 4) % n] + ((degree + 4) % n < degree % n ? 12 : 0);
+        pattern |= (1 << (third - root)) | (1 << (fifth - root));
+    }
+    chord_set(chord, root, pattern, scale, key, time, timing);
+}
+
+/* the degree which a signpost asks for: its lowest root flag, the tonic without one */
+static int signpost_degree(DWORD chords)
+{
+    int i;
+
+#ifdef SG_MUTANT_SIGNPOST_ROOT
+    return 0;
+#endif
+    for (i = 0; i < 7; i++)
+        if (chords & (DMUS_SIGNPOSTF_1 << i)) return i;
+    return 0;
+}
+
+static HRESULT create_track(const CLSID *clsid, IDirectMusicTrack **track)
+{
+    return CoCreateInstance(clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IDirectMusicTrack, (void **)track);
+}
+
+/* the chord track of a progression: one chord at the start of every signpost, then chords which change every
+ * interval (the activity level), the cadence signpost being a dominant measure before its tonic. */
+HRESULT compose_chord_track(const DMUS_IO_SIGNPOST *signposts, DWORD count, DWORD measures, MUSIC_TIME measure_len,
+        MUSIC_TIME beat_len, WORD activity, DWORD scale, IDirectMusicTrack **ret_track)
+{
+    static const int intervals[4] = {16, 8, 4, 2};   /* beats between chord changes */
+    static const int steps[4] = {3, 4, 1, 5};        /* scale steps to the next chord: fourth, fifth, second, sixth */
+    struct timing timing = {beat_len, measure_len};
+    IDirectMusicTrack *track;
+    DWORD i, section_end, notes_count;
+    int notes[12];
+    HRESULT hr;
+
+    if (!(notes_count = scale_notes(scale, notes))) scale = DEFAULT_SCALE, notes_count = 7;
+#ifdef SG_MUTANT_ACTIVITY
+    activity = 1;
+#endif
+    if (activity > 3) activity = 3;
+
+    if (FAILED(hr = create_track(&CLSID_DirectMusicChordTrack, &track))) return hr;
+
+    for (i = 0; i < max(count, 1); i++)
+    {
+        DWORD start = count ? signposts[i].wMeasure : 0, seed;
+        int degree = count ? signpost_degree(signposts[i].dwChords) : 0;
+        BOOL cadence = count && (signposts[i].dwChords & DMUS_SIGNPOSTF_CADENCE);
+        MUSIC_TIME time, step = intervals[activity] * beat_len;
+        DMUS_CHORD_KEY chord;
+
+        section_end = i + 1 < count ? signposts[i + 1].wMeasure : measures;
+        if (section_end > measures) section_end = measures;
+        if (start >= section_end) continue;
+        seed = compose_seed(start);
+
+        time = start * measure_len;
+        if (cadence && section_end - start > 1)
+        {
+            /* the dominant for a measure, then the tonic */
+            chord_on_degree(&chord, scale, 4 % notes_count, 0, time, &timing);
+            if (FAILED(hr = IDirectMusicTrack_SetParam(track, &GUID_ChordParam, time, &chord))) goto done;
+            time += measure_len;
+            degree = 0;
+        }
+        for (; time < (MUSIC_TIME)section_end * measure_len; time += step)
+        {
+            if (time > (MUSIC_TIME)start * measure_len + (cadence ? measure_len : 0))
+            {
+                /* the following chords walk the scale, never staying on the same degree */
+                int next = (degree + steps[lcg_next(&seed) % 4]) % notes_count;
+                degree = next == degree ? (degree + 4) % notes_count : next;
+            }
+            chord_on_degree(&chord, scale, degree, 0, time, &timing);
+            if (FAILED(hr = IDirectMusicTrack_SetParam(track, &GUID_ChordParam, time, &chord))) goto done;
+        }
+    }
+    hr = S_OK;
+done:
+    if (FAILED(hr)) IDirectMusicTrack_Release(track);
+    else *ret_track = track;
+    return hr;
+}
+
+/* ---- segments ---- */
+
+static HRESULT create_segment(MUSIC_TIME length, IDirectMusicSegment **segment)
+{
+    HRESULT hr = CoCreateInstance(&CLSID_DirectMusicSegment, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IDirectMusicSegment, (void **)segment);
+    if (SUCCEEDED(hr) && FAILED(hr = IDirectMusicSegment_SetLength(*segment, length)))
+        IDirectMusicSegment_Release(*segment);
+    return hr;
+}
+
+/* inserts the track (group 1) and releases it */
+static HRESULT insert_track(IDirectMusicSegment *segment, IDirectMusicTrack *track)
+{
+    HRESULT hr = IDirectMusicSegment_InsertTrack(segment, track, 1);
+    IDirectMusicTrack_Release(track);
+    return hr;
+}
+
+static HRESULT add_param_track(IDirectMusicSegment *segment, const CLSID *clsid, REFGUID type, MUSIC_TIME time,
+        void *param)
+{
+    IDirectMusicTrack *track;
+    HRESULT hr;
+
+    if (FAILED(hr = create_track(clsid, &track))) return hr;
+    if (SUCCEEDED(hr = IDirectMusicTrack_SetParam(track, type, time, param)))
+        return insert_track(segment, track);
+    IDirectMusicTrack_Release(track);
+    return hr;
+}
+
+/* the style, the tempo of the style and the chord map */
+static HRESULT add_style_tracks(IDirectMusicSegment *segment, IDirectMusicStyle *style, IDirectMusicChordMap *chordmap)
+{
+    DMUS_TEMPO_PARAM tempo = {0};
+    double value;
+    HRESULT hr;
+
+    if (FAILED(hr = add_param_track(segment, &CLSID_DirectMusicStyleTrack, &GUID_IDirectMusicStyle, 0, style)))
+        return hr;
+#ifdef SG_MUTANT_NOTEMPO
+    if (0)
+#else
+    if (SUCCEEDED(IDirectMusicStyle_GetTempo(style, &value)))
+#endif
+    {
+        tempo.dblTempo = value;
+        if (FAILED(hr = add_param_track(segment, &CLSID_DirectMusicTempoTrack, &GUID_TempoParam, 0, &tempo)))
+            return hr;
+    }
+    if (chordmap)
+        hr = add_param_track(segment, &CLSID_DirectMusicChordMapTrack, &GUID_IDirectMusicChordMap, 0, chordmap);
+    return hr;
+}
+
+static HRESULT get_style(IDirectMusicSegment *segment, IDirectMusicStyle **style)
+{
+    *style = NULL;
+    return segment ? IDirectMusicSegment_GetParam(segment, &GUID_IDirectMusicStyle, 0xFFFFFFFF, DMUS_SEG_ANYTRACK,
+            0, NULL, style) : DMUS_E_NOT_FOUND;
+}
+
+static HRESULT get_chordmap(IDirectMusicSegment *segment, IDirectMusicChordMap **chordmap)
+{
+    *chordmap = NULL;
+    return segment ? IDirectMusicSegment_GetParam(segment, &GUID_IDirectMusicChordMap, 0xFFFFFFFF,
+            DMUS_SEG_ANYTRACK, 0, NULL, chordmap) : DMUS_E_NOT_FOUND;
+}
+
+static DWORD chordmap_scale(IDirectMusicChordMap *chordmap)
+{
+    DWORD scale = 0;
+
+#ifdef SG_MUTANT_SCALE
+    return DEFAULT_SCALE;
+#endif
+    if (chordmap && SUCCEEDED(IDirectMusicChordMap_GetScale(chordmap, &scale)) && (scale & 0xfff))
+        return scale & 0xffffff;
+    return DEFAULT_SCALE;
+}
+
+static HRESULT add_command(IDirectMusicTrack *track, MUSIC_TIME time, BYTE command, BYTE level)
+{
+    DMUS_COMMAND_PARAM param = {command, level, 0, 0};
+
+    return IDirectMusicTrack_SetParam(track, &GUID_CommandParam, time, &param);
+}
+
+/* ---- templates ---- */
+
+/* the groove level (1 to 100) of a measure of the body */
+static BYTE shape_level(WORD shape, DWORD i, DWORD n, DWORD *seed)
+{
+    DWORD t = n > 1 ? i * 100 / (n - 1) : 0, tri = t <= 50 ? t * 2 : (100 - t) * 2;
+
+#ifdef SG_MUTANT_SHAPE_LEVEL
+    return 50;
+#endif
+    switch (shape)
+    {
+    case DMUS_SHAPET_FALLING:  return 1 + (100 - t) * 99 / 100;
+    case DMUS_SHAPET_RISING:   return 1 + t * 99 / 100;
+    case DMUS_SHAPET_PEAKING:  return 1 + tri * 99 / 100;
+    case DMUS_SHAPET_LOUD:     return 90;
+    case DMUS_SHAPET_QUIET:    return 10;
+    case DMUS_SHAPET_RANDOM:   return 1 + lcg_next(seed) % 100;
+    case DMUS_SHAPET_SONG:     return (i / SECTION_MEASURES) % 2 ? 80 : 40;   /* verse, chorus */
+    default:                   return 50;                                       /* level, loopable */
+    }
+}
+
+/* the harmonic tension (0 tonic, 1 subdominant, 2 dominant) of a section */
+static DWORD shape_tension(WORD shape, DWORD s, DWORD sections, DWORD *seed)
+{
+    DWORD last = sections - 1;
+
+    if (!s) return 0;
+    switch (shape)
+    {
+    case DMUS_SHAPET_FALLING:  return last ? (2 * (last - s) + last / 2) / last : 0;
+    case DMUS_SHAPET_RISING:   return last ? (2 * s + last / 2) / last : 0;
+    case DMUS_SHAPET_PEAKING:
+    {
+        DWORD peak = last / 2, pos = s <= peak ? s : last - s;
+
+        return peak ? (2 * pos + peak / 2) / peak : 0;
+    }
+    case DMUS_SHAPET_LOUD:     return 2;
+    case DMUS_SHAPET_LOOPABLE: return s == last ? 2 : 1;   /* the last section leads back to the tonic */
+    case DMUS_SHAPET_RANDOM:   return lcg_next(seed) % 3;
+    case DMUS_SHAPET_SONG:     return (const DWORD[]){0, 1, 0, 2}[s % 4];
+    default:                   return 0;                    /* level, quiet */
+    }
+}
+
+HRESULT compose_template_from_shape(WORD measures, WORD shape, BOOL intro, BOOL end, WORD end_length,
+        IDirectMusicSegment **ret_template)
+{
+    static const DWORD tension_flags[3] = {DMUS_SIGNPOSTF_1, DMUS_SIGNPOSTF_4, DMUS_SIGNPOSTF_5};
+    DWORD intro_len = intro ? 1 : 0, end_len = end ? (end_length ? end_length : 1) : 0, body, sections, i, seed;
+    DWORD body_start, body_end;
+    IDirectMusicSegment *template;
+    IDirectMusicTrack *commands, *signposts;
+    BYTE level = 50, first_level = 50;
+    HRESULT hr;
+
+    TRACE("%u measures, shape %u, intro %d, end %d (%u)\n", measures, shape, intro, end, end_length);
+
+    if (!measures || shape > DMUS_SHAPET_SONG || end_len > MAX_END_LENGTH || intro_len + end_len > measures)
+        return E_INVALIDARG;
+
+    body_start = intro_len;
+    body_end = measures - end_len;
+    body = body_end - body_start;
+    sections = (body + SECTION_MEASURES - 1) / SECTION_MEASURES;
+    seed = compose_seed(shape);
+
+    if (FAILED(hr = create_segment(measures * TEMPLATE_MEASURE, &template))) return hr;
+    if (FAILED(hr = create_track(&CLSID_DirectMusicCommandTrack, &commands)))
+    {
+        IDirectMusicSegment_Release(template);
+        return hr;
+    }
+    if (FAILED(hr = create_dmsignposttrack(&IID_IDirectMusicTrack, (void **)&signposts)))
+    {
+        IDirectMusicTrack_Release(commands);
+        IDirectMusicSegment_Release(template);
+        return hr;
+    }
+
+    /* commands: the intro, a groove command whenever the level changes, then the ending */
+    first_level = body ? shape_level(shape, 0, body, &(DWORD){seed}) : 50;
+    if (intro_len && FAILED(hr = add_command(commands, 0, DMUS_COMMANDT_INTRO, first_level))) goto done;
+    {
+        DWORD level_seed = seed;
+        BOOL have = FALSE;
+
+        for (i = 0; i < body; i++)
+        {
+            BYTE next = shape_level(shape, i, body, &level_seed);
+
+            if (have && next == level) continue;
+            if (FAILED(hr = add_command(commands, (body_start + i) * TEMPLATE_MEASURE, DMUS_COMMANDT_GROOVE, next)))
+                goto done;
+            level = next;
+            have = TRUE;
+        }
+    }
+#ifndef SG_MUTANT_END
+    if (end_len && FAILED(hr = add_command(commands, body_end * TEMPLATE_MEASURE, DMUS_COMMANDT_END, level)))
+        goto done;
+#endif
+
+    /* signposts: the intro and every section ask for a chord, the ending for a cadence */
+    for (i = 0; i <= sections + 1; i++)
+    {
+        DMUS_IO_SIGNPOST signpost = {0};
+
+        if (!i)
+        {
+            if (!intro_len) continue;
+            signpost.wMeasure = 0;
+            signpost.dwChords = DMUS_SIGNPOSTF_1;
+        }
+        else if (i <= sections)
+        {
+            signpost.wMeasure = body_start + (i - 1) * SECTION_MEASURES;
+            signpost.dwChords = tension_flags[shape_tension(shape, i - 1, sections, &seed)];
+        }
+        else
+        {
+            if (!end_len) continue;
+            signpost.wMeasure = body_end;
+            signpost.dwChords = DMUS_SIGNPOSTF_1 | DMUS_SIGNPOSTF_CADENCE;
+#ifdef SG_MUTANT_CADENCE
+            signpost.dwChords = DMUS_SIGNPOSTF_1;
+#endif
+        }
+        signpost.mtTime = signpost.wMeasure * TEMPLATE_MEASURE;
+        if (FAILED(hr = signpost_track_add(signposts, &signpost))) goto done;
+    }
+
+    if (SUCCEEDED(hr = IDirectMusicSegment_InsertTrack(template, commands, 1)))
+        hr = IDirectMusicSegment_InsertTrack(template, signposts, 1);
+done:
+    IDirectMusicTrack_Release(commands);
+    IDirectMusicTrack_Release(signposts);
+    if (FAILED(hr)) IDirectMusicSegment_Release(template);
+    else *ret_template = template;
+    return hr;
+}
+
+/* ---- segments from templates ---- */
+
+/* the command of the measure, when one starts in it */
+static BOOL measure_command(IDirectMusicSegment *segment, DWORD measure, DMUS_COMMAND_PARAM_2 *command)
+{
+    MUSIC_TIME time = measure * TEMPLATE_MEASURE;
+
+    if (FAILED(IDirectMusicSegment_GetParam(segment, &GUID_CommandParam2, 0xFFFFFFFF, DMUS_SEG_ANYTRACK, time,
+            NULL, command)))
+        return FALSE;
+    return command->mtTime == 0;
+}
+
+HRESULT compose_segment_from_template(IDirectMusicStyle *style, IDirectMusicSegment *template, WORD activity,
+        IDirectMusicChordMap *chordmap, IDirectMusicSegment **ret_segment)
+{
+    IDirectMusicStyle *own_style = NULL;
+    IDirectMusicChordMap *own_map = NULL;
+    IDirectMusicTrack *chords = NULL, *commands = NULL, *signpost_track = NULL;
+    DMUS_IO_SIGNPOST *signposts = NULL;
+    DMUS_TIMESIGNATURE sig = {0};
+    IDirectMusicSegment *segment;
+    DWORD count = 0, measures, i;
+    MUSIC_TIME length;
+    struct timing timing;
+    HRESULT hr;
+
+    if (!style && FAILED(get_style(template, &own_style))) return E_INVALIDARG;
+    if (!chordmap && FAILED(get_chordmap(template, &own_map)))
+    {
+        if (own_style) IDirectMusicStyle_Release(own_style);
+        return E_INVALIDARG;
+    }
+    if (!style) style = own_style;
+    if (!chordmap) chordmap = own_map;
+
+    if (FAILED(hr = IDirectMusicSegment_GetLength(template, &length))) goto done;
+    measures = (length + TEMPLATE_MEASURE - 1) / TEMPLATE_MEASURE;
+    if (!measures) measures = 1;
+    if (SUCCEEDED(IDirectMusicStyle_GetTimeSignature(style, &sig))) timing_init(&timing, &sig);
+    else timing_init(&timing, NULL);
+
+    if (FAILED(hr = create_segment(measures * timing.measure, &segment))) goto done;
+    if (FAILED(hr = add_style_tracks(segment, style, chordmap))) goto fail;
+
+    /* the commands of the template, a measure at a time */
+    if (FAILED(hr = create_track(&CLSID_DirectMusicCommandTrack, &commands))) goto fail;
+    for (i = 0; i < measures; i++)
+    {
+        DMUS_COMMAND_PARAM_2 command;
+
+        if (measure_command(template, i, &command) &&
+                FAILED(hr = add_command(commands, i * timing.measure, command.bCommand, command.bGrooveLevel)))
+            goto fail;
+    }
+    hr = insert_track(segment, commands);
+    commands = NULL;
+    if (FAILED(hr)) goto fail;
+
+    /* the chords of the signposts of the template */
+    if (SUCCEEDED(IDirectMusicSegment_GetTrack(template, &CLSID_DirectMusicSignPostTrack, 0xFFFFFFFF,
+            0, &signpost_track)))
+    {
+        hr = signpost_track_get(signpost_track, &signposts, &count);
+        IDirectMusicTrack_Release(signpost_track);
+        if (FAILED(hr)) goto fail;
+    }
+    hr = compose_chord_track(signposts, count, measures, timing.measure, timing.beat, activity,
+            chordmap_scale(chordmap), &chords);
+    free(signposts);
+    if (FAILED(hr)) goto fail;
+    if (FAILED(hr = insert_track(segment, chords))) goto fail;
+
+    *ret_segment = segment;
+    hr = S_OK;
+    goto done;
+fail:
+    if (commands) IDirectMusicTrack_Release(commands);
+    IDirectMusicSegment_Release(segment);
+done:
+    if (own_style) IDirectMusicStyle_Release(own_style);
+    if (own_map) IDirectMusicChordMap_Release(own_map);
+    return hr;
+}
+
+/* ---- transitions ---- */
+
+static BYTE groove_level_at(IDirectMusicSegment *segment, MUSIC_TIME time, BYTE fallback)
+{
+    DMUS_COMMAND_PARAM command;
+
+    if (segment && SUCCEEDED(IDirectMusicSegment_GetParam(segment, &GUID_CommandParam, 0xFFFFFFFF,
+            DMUS_SEG_ANYTRACK, time, NULL, &command)))
+        return command.bGrooveLevel;
+    return fallback;
+}
+
+HRESULT compose_transition(IDirectMusicSegment *from, IDirectMusicSegment *to, MUSIC_TIME time, WORD command,
+        DWORD flags, IDirectMusicChordMap *chordmap, IDirectMusicSegment **ret_segment)
+{
+    static const BYTE embellishment_len[6] = {1, 1, 1, 1, 1, 2};
+    IDirectMusicStyle *style = NULL;
+    IDirectMusicChordMap *own_map = NULL;
+    IDirectMusicTrack *commands = NULL, *chords = NULL;
+    IDirectMusicSegment *segment;
+    DMUS_CHORD_KEY from_chord, to_chord, chord;
+    DMUS_TIMESIGNATURE sig = {0};
+    BOOL have_from = FALSE, have_to = FALSE;
+    DWORD scale, prefix, total, i;
+    BYTE level;
+    struct timing timing;
+    HRESULT hr;
+
+    if (!from && !to) return E_INVALIDARG;
+    if (command > DMUS_COMMANDT_ENDANDINTRO || time < 0) return E_INVALIDARG;
+
+    if (FAILED(get_style(to, &style)) && FAILED(get_style(from, &style))) return E_INVALIDARG;
+    if (!chordmap && FAILED(get_chordmap(to, &own_map)) && FAILED(get_chordmap(from, &own_map))) own_map = NULL;
+    if (!chordmap) chordmap = own_map;
+    scale = chordmap_scale(chordmap);
+
+    if (SUCCEEDED(IDirectMusicStyle_GetTimeSignature(style, &sig))) timing_init(&timing, &sig);
+    else timing_init(&timing, NULL);
+
+    /* the length: the embellishment, after two measures of the groove with the long flag */
+    prefix = (flags & DMUS_COMPOSEF_LONG) ? 2 : 0;
+#ifdef SG_MUTANT_LONG
+    prefix = 0;
+#endif
+    total = prefix + embellishment_len[command];
+
+    if (!(have_from = from && SUCCEEDED(IDirectMusicSegment_GetParam(from, &GUID_ChordParam, 0xFFFFFFFF,
+            DMUS_SEG_ANYTRACK, time, NULL, &from_chord))))
+        memset(&from_chord, 0, sizeof(from_chord));
+    have_to = to && SUCCEEDED(IDirectMusicSegment_GetParam(to, &GUID_ChordParam, 0xFFFFFFFF,
+            DMUS_SEG_ANYTRACK, 0, NULL, &to_chord));
+
+    if (FAILED(hr = create_segment(total * timing.measure, &segment))) goto done;
+    if (FAILED(hr = add_style_tracks(segment, style, chordmap))) goto fail;
+
+    /* commands: the groove of the destination, the embellishment after it */
+    level = groove_level_at(to, 0, groove_level_at(from, time, 50));
+    if (FAILED(hr = create_track(&CLSID_DirectMusicCommandTrack, &commands))) goto fail;
+    if (prefix && FAILED(hr = add_command(commands, 0, DMUS_COMMANDT_GROOVE, level))) goto fail;
+    switch (command)
+    {
+    case DMUS_COMMANDT_ENDANDINTRO:
+        hr = add_command(commands, prefix * timing.measure, DMUS_COMMANDT_END, level);
+        if (SUCCEEDED(hr)) hr = add_command(commands, (prefix + 1) * timing.measure, DMUS_COMMANDT_INTRO, level);
+        break;
+    default:
+        hr = add_command(commands, prefix * timing.measure, command, level);
+        break;
+    }
+    if (FAILED(hr)) goto fail;
+    hr = insert_track(segment, commands);
+    commands = NULL;
+    if (FAILED(hr)) goto fail;
+
+    /* chords: the chord which plays at the time in the first segment, then its dominant
+     * for the last measure, to resolve to the first chord of the second segment */
+    if (FAILED(hr = create_track(&CLSID_DirectMusicChordTrack, &chords))) goto fail;
+    for (i = 0; i < total; i++)
+    {
+        MUSIC_TIME at = i * timing.measure;
+        BOOL last = i == total - 1;
+        int root;
+
+        if (have_from && !(last && have_to))
+        {
+            chord = from_chord;
+            chord.wMeasure = i;
+            chord.bBeat = 0;
+            if (FAILED(hr = IDirectMusicTrack_SetParam(chords, &GUID_ChordParam, at, &chord))) goto fail;
+            continue;
+        }
+        if (!have_to)
+        {
+            chord_on_degree(&chord, scale, 0, 0, at, &timing);
+            if (FAILED(hr = IDirectMusicTrack_SetParam(chords, &GUID_ChordParam, at, &chord))) goto fail;
+            continue;
+        }
+        /* the dominant: of the first chord of the destination when modulating (or without a first
+         * segment), else of the chord of the first segment */
+        root = to_chord.SubChordList[0].bChordRoot;
+        if (have_from && !(flags & DMUS_COMPOSEF_MODULATE)) root = from_chord.SubChordList[0].bChordRoot;
+#ifdef SG_MUTANT_MODULATE
+        root = to_chord.SubChordList[0].bChordRoot;
+#endif
+#ifdef SG_MUTANT_DOMINANT
+        chord_set(&chord, root % 12, 0x91, to_chord.dwScale, to_chord.bKey, at, &timing);
+#else
+        chord_set(&chord, (root + 7) % 12, 0x91, to_chord.dwScale, to_chord.bKey, at, &timing);
+#endif
+        if (FAILED(hr = IDirectMusicTrack_SetParam(chords, &GUID_ChordParam, at, &chord))) goto fail;
+    }
+    hr = insert_track(segment, chords);
+    chords = NULL;
+    if (FAILED(hr)) goto fail;
+
+    *ret_segment = segment;
+    hr = S_OK;
+    goto done;
+fail:
+    if (commands) IDirectMusicTrack_Release(commands);
+    if (chords) IDirectMusicTrack_Release(chords);
+    IDirectMusicSegment_Release(segment);
+done:
+    IDirectMusicStyle_Release(style);
+    if (own_map) IDirectMusicChordMap_Release(own_map);
+    return hr;
+}
