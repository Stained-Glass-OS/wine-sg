From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: RtlComputeImportTableHash

Dependencies (lucasg) imports it statically and did not start (the export was missing). The MD5 hash
of a PE file's import table read through a read-only view of the file: "module.function" (or
"module.ordN") for every import, lower case, module without its .dll/.ocx/.sys, comma-joined -- the
import hash analysis tools use. Revision 1 only. Gate: test/imphash-gate.sh (checks the hash against
an independent computation). Mutant: SG_MUTANT_IMPHASH_ZERO.
---
--- a/dlls/ntdll/crypt.c
+++ b/dlls/ntdll/crypt.c
@@ -19,7 +19,12 @@
  */
 
 #include <stdarg.h>
+#include <stdio.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
 #include "windef.h"
+#include "winternl.h"
+#include "wine/exception.h"
 
 /* SHA1 algorithm
  *
@@ -685,3 +690,134 @@
     byteReverse( (unsigned char *)ctx->buf, 4 );
     memcpy( ctx->digest, ctx->buf, 16 );
 }
+
+/* Stained Glass OS (wine-sg 9702): RtlComputeImportTableHash (undocumented; Dependencies imports it).
+ * The 16-byte MD5 hash of a PE file's import table, read through a read-only data view of the file:
+ * every imported function as "module.function" (or "module.ordN"), the module name lower case without
+ * its .dll/.ocx/.sys extension, the function name lower case, joined by commas in import order -- the
+ * import hash as malware-analysis tools define it. Revision 1 is the only revision. */
+static const void *imphash_ptr( const IMAGE_NT_HEADERS *nt, void *base, SIZE_T size, DWORD rva, SIZE_T len )
+{
+    const char *p = RtlImageRvaToVa( nt, base, rva, NULL );
+    if (!p || p < (char *)base || p + len > (char *)base + size || p + len < p) return NULL;
+    return p;
+}
+
+static void imphash_add( MD5_CTX *ctx, BOOL *first, const char *module, SIZE_T modlen, const char *func, SIZE_T funclen )
+{
+    char buf[512];
+    SIZE_T i, n = 0;
+
+    if (!*first) buf[n++] = ',';
+    *first = FALSE;
+    for (i = 0; i < modlen && n < sizeof(buf) - 1; i++)
+        buf[n++] = (module[i] >= 'A' && module[i] <= 'Z') ? module[i] + 32 : module[i];
+    if (n < sizeof(buf) - 1) buf[n++] = '.';
+    for (i = 0; i < funclen && n < sizeof(buf); i++)
+        buf[n++] = (func[i] >= 'A' && func[i] <= 'Z') ? func[i] + 32 : func[i];
+    MD5Update( ctx, (const unsigned char *)buf, n );
+}
+
+static SIZE_T imphash_strlen( const char *s, const char *end )
+{
+    const char *p = s;
+    while (p < end && *p) p++;
+    return p < end ? p - s : (SIZE_T)-1;
+}
+
+NTSTATUS WINAPI RtlComputeImportTableHash( HANDLE file, char *hash, ULONG revision )
+{
+    LARGE_INTEGER zero = {{ 0 }};
+    HANDLE section;
+    void *base = NULL;
+    SIZE_T size = 0;
+    NTSTATUS status;
+    const IMAGE_NT_HEADERS *nt;
+    const IMAGE_DATA_DIRECTORY *dir = NULL;
+    const IMAGE_IMPORT_DESCRIPTOR *imp;
+    BOOL is64, first = TRUE;
+    MD5_CTX ctx;
+
+    if (revision != 1) return STATUS_UNKNOWN_REVISION;
+    if (!hash) return STATUS_INVALID_PARAMETER;
+    status = NtCreateSection( &section, SECTION_MAP_READ | SECTION_QUERY, NULL, &zero, PAGE_READONLY, SEC_COMMIT, file );
+    if (status) return status;
+    status = NtMapViewOfSection( section, NtCurrentProcess(), &base, 0, 0, NULL, &size, ViewShare, 0, PAGE_READONLY );
+    NtClose( section );
+    if (status) return status;
+
+    status = STATUS_INVALID_IMAGE_FORMAT;
+    __TRY
+    {
+        if (!(nt = RtlImageNtHeader( base )) || (char *)nt + sizeof(*nt) > (char *)base + size) goto done;
+        is64 = nt->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC;
+        if (!is64 && nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR32_MAGIC) goto done;
+        if (is64)
+        {
+            const IMAGE_NT_HEADERS64 *nt64 = (const IMAGE_NT_HEADERS64 *)nt;
+            if (nt64->OptionalHeader.NumberOfRvaAndSizes <= IMAGE_DIRECTORY_ENTRY_IMPORT) goto empty;
+            dir = &nt64->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+        }
+        else
+        {
+            const IMAGE_NT_HEADERS32 *nt32 = (const IMAGE_NT_HEADERS32 *)nt;
+            if (nt32->OptionalHeader.NumberOfRvaAndSizes <= IMAGE_DIRECTORY_ENTRY_IMPORT) goto empty;
+            dir = &nt32->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+        }
+    empty:
+        MD5Init( &ctx );
+        if (dir && dir->VirtualAddress && dir->Size)
+        {
+            DWORD k;
+            for (k = 0; (imp = imphash_ptr( nt, base, size, dir->VirtualAddress + k * sizeof(*imp), sizeof(*imp) )) && imp->Name; k++)
+            {
+                const char *module = imphash_ptr( nt, base, size, imp->Name, 1 ), *dot;
+                SIZE_T modlen, step = is64 ? 8 : 4;
+                DWORD thunk = imp->OriginalFirstThunk ? imp->OriginalFirstThunk : imp->FirstThunk, i;
+
+                if (!module || (modlen = imphash_strlen( module, (char *)base + size )) == (SIZE_T)-1) goto done;
+                if ((dot = memchr( module, '.', modlen )) && modlen - (dot - module) == 4 &&
+                    (!_strnicmp( dot, ".dll", 4 ) || !_strnicmp( dot, ".ocx", 4 ) || !_strnicmp( dot, ".sys", 4 )))
+                    modlen = dot - module;
+                for (i = 0; i < 65536; i++)
+                {
+                    const void *t = imphash_ptr( nt, base, size, thunk + i * step, step );
+                    ULONGLONG v;
+                    char ord[16];
+
+                    if (!t) goto done;
+                    v = is64 ? *(const ULONGLONG *)t : *(const DWORD *)t;
+                    if (!v) break;
+                    if (is64 ? (v & IMAGE_ORDINAL_FLAG64) : (v & IMAGE_ORDINAL_FLAG32))
+                    {
+                        int n = sprintf( ord, "ord%u", (unsigned int)(v & 0xffff) );
+                        imphash_add( &ctx, &first, module, modlen, ord, n );
+                    }
+                    else
+                    {
+                        const IMAGE_IMPORT_BY_NAME *ibn = imphash_ptr( nt, base, size, (DWORD)v, sizeof(*ibn) );
+                        SIZE_T len;
+                        if (!ibn || (len = imphash_strlen( (const char *)ibn->Name, (char *)base + size )) == (SIZE_T)-1)
+                            goto done;
+                        imphash_add( &ctx, &first, module, modlen, (const char *)ibn->Name, len );
+                    }
+                }
+            }
+        }
+        MD5Final( &ctx );
+#ifndef SG_MUTANT_IMPHASH_ZERO
+        memcpy( hash, ctx.digest, 16 );
+#else
+        memset( hash, 0, 16 );
+#endif
+        status = STATUS_SUCCESS;
+    done: ;
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        status = STATUS_INVALID_IMAGE_FORMAT;
+    }
+    __ENDTRY
+    NtUnmapViewOfSection( NtCurrentProcess(), base );
+    return status;
+}
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -568,7 +568,7 @@
 @ stdcall RtlCompareUnicodeStrings(ptr long ptr long long)
 @ stdcall RtlCompressBuffer(long ptr long ptr long long ptr ptr)
 @ stdcall RtlComputeCrc32(long ptr long)
-# @ stub RtlComputeImportTableHash
+@ stdcall RtlComputeImportTableHash(long ptr long)
 # @ stub RtlComputePrivatizedDllName_U
 @ stub RtlConsoleMultiByteToUnicodeN
 @ stdcall RtlConvertDeviceFamilyInfoToString(ptr ptr ptr ptr)
