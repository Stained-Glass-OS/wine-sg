+};
+
+IActivationFactory *brush_factory = &brush_factory_obj.IActivationFactory_iface;
+
+static HRESULT activate_solid( IInspectable **out )
+{
+    struct brush *brush = new_brush( TRUE, NULL );
+
+    if (!brush) return E_OUTOFMEMORY;
+    *out = (IInspectable *)&brush->ISolidColorBrush_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI solid_factory_CreateInstanceWithColor( struct xfiface *iface, struct xcolor color, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    return (*value = xaml_solid_brush( color )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static const void *solid_factory_vtbl[] =
+{
+    ISolidColorBrushFactory_FSTUBS,
+    [ISolidColorBrushFactory_CreateInstanceWithColor] = solid_factory_CreateInstanceWithColor,
+};
+
+static const void *solid_statics_vtbl[] =
+{
+    ISolidColorBrushStatics_FSTUBS,
+    [ISolidColorBrushStatics_ColorProperty] = solid_statics_ColorProperty,
+};
+
+static struct xfactory solid_factory_obj =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.Media.SolidColorBrush",
+    { &IID_ISolidColorBrushFactory, &IID_ISolidColorBrushStatics },
+    { { solid_factory_vtbl }, { solid_statics_vtbl } },
+    activate_solid,
+};
+
+IActivationFactory *solid_color_brush_factory = &solid_factory_obj.IActivationFactory_iface;
+
+/* ---- FontFamily (composable) ---- */
+
+struct font_family
+{
+    struct xobj obj;
+    struct xiface IFontFamily_iface;
+    WCHAR *source;
+};
+
+static const struct xiface_entry font_family_ifaces[] =
+{
