+    if (!(family = calloc( 1, sizeof(*family) ))) return E_OUTOFMEMORY;
+    family->IFontFamily_iface.vtbl = font_family_vtbl;
+    family->source = wcsdup( name ? name : L"" );
+    xobj_init( &family->obj, &font_family_class, outer );
+    if (outer)
+    {
+        *inner = &family->obj.IInspectable_inner;
+        IUnknown_AddRef( family->obj.outer );
+    }
+    *value = &family->IFontFamily_iface;
+    return S_OK;
+}
+
+/* the family's name, if it is a FontFamily of ours (allocated) */
+WCHAR *xaml_font_family_name( IInspectable *iface )
+{
+    struct xiface *family_iface;
+    WCHAR *ret = NULL;
+
+    if (!iface || FAILED(IInspectable_QueryInterface( iface, &IID_IFontFamily, (void **)&family_iface ))) return NULL;
+    if (family_iface->vtbl == font_family_vtbl)
+        ret = wcsdup( CONTAINING_RECORD( family_iface->obj, struct font_family, obj )->source );
+    IUnknown_Release( (IUnknown *)family_iface );
+    return ret;
+}
+
+IInspectable *xaml_font_family( const WCHAR *name )
+{
+    IInspectable *family = NULL;
+    new_font_family( name, NULL, NULL, (void **)&family );
+    return family;
+}
+
+static HRESULT WINAPI font_family_factory_CreateInstanceWithName( struct xfiface *iface, HSTRING name, IInspectable *outer,
+                                                                  IInspectable **inner, void **value )
+{
+    return new_font_family( WindowsGetStringRawBuffer( name, NULL ), outer, inner, value );
+}
