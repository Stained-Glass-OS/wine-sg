diff --git a/dlls/windows.ui.xaml/hosting.c b/dlls/windows.ui.xaml/hosting.c
index ceb2cea..6f16359 100644
--- a/dlls/windows.ui.xaml/hosting.c
+++ b/dlls/windows.ui.xaml/hosting.c
@@ -289,6 +289,28 @@ static LRESULT CALLBACK island_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM
     return DefWindowProcW( hwnd, msg, wparam, lparam );
 }
 
+static BOOL CALLBACK invalidate_island( HWND hwnd, LPARAM param )
+{
+    WCHAR name[32];
+
+    if (GetClassNameW( hwnd, name, ARRAY_SIZE(name) ) && !wcscmp( name, L"Windows.UI.Core.CoreWindow" ))
+        InvalidateRect( hwnd, NULL, FALSE );
+    return TRUE;
+}
+
+static BOOL CALLBACK invalidate_thread_window( HWND hwnd, LPARAM param )
+{
+    invalidate_island( hwnd, 0 );
+    EnumChildWindows( hwnd, invalidate_island, 0 );
+    return TRUE;
+}
+
+/* the islands of this thread paint again */
+void xaml_invalidate_visuals(void)
+{
+    EnumThreadWindows( GetCurrentThreadId(), invalidate_thread_window, 0 );
+}
+
 static ATOM island_class(void)
 {
     static ATOM atom;
