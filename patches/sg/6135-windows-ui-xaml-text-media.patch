+/*
+ * A TextBlock lays its text out with DirectWrite: its desired size is the text's (wrapped to the
+ * width it has when TextWrapping asks for it) plus its padding.  XAML's own font ("Segoe UI",
+ * XamlAutoFontFamily) is the desktop's message font unless that family is installed.
+ */
+
+#include <stdlib.h>
+#include <float.h>
+#include <math.h>
+#include "private.h"
+#include "winuser.h"
+#include "initguid.h"
+#include "dwrite.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+const GUID IID_IReference_FontWeight = { 0x741446b3, 0x9c81, 0x5daa, { 0xb9, 0x95, 0x5b, 0xd6, 0x74, 0x73, 0x49, 0x2c } };
+const GUID IID_IReference_TextWrapping = { 0xab95e70d, 0xa760, 0x52f2, { 0xad, 0xea, 0xda, 0x76, 0x72, 0x37, 0xed, 0xa3 } };
+const GUID IID_IReference_TextAlignment = { 0x7d4ef683, 0x3054, 0x54ed, { 0xbe, 0x23, 0x9f, 0xf0, 0x07, 0x96, 0x14, 0xe7 } };
+const GUID IID_IReference_FontStyle = { 0xbe68e421, 0xab4e, 0x5dbf, { 0x9f, 0xde, 0x9b, 0x8c, 0x13, 0xcb, 0x5f, 0x0a } };
+
+enum { XWRAP_NONE = 1, XWRAP_WRAP = 2, XWRAP_WHOLE_WORDS = 3 };
+enum { XTEXT_CENTER = 0, XTEXT_LEFT = 1, XTEXT_RIGHT = 2, XTEXT_JUSTIFY = 3 };
+
+static struct xaml_property *prop_font_size, *prop_font_family, *prop_font_weight, *prop_font_style, *prop_font_stretch,
+                            *prop_character_spacing, *prop_foreground, *prop_text_wrapping, *prop_text_trimming,
+                            *prop_text_alignment, *prop_text, *prop_padding, *prop_line_height, *prop_max_lines,
+                            *prop_is_text_selection_enabled, *prop_is_text_scale_factor_enabled;
+
+static IDWriteFactory *dwrite;
+
+struct text_block
+{
+    struct uielem e;
+    struct xiface ITextBlock_iface, ITextBlock2_iface, ITextBlock3_iface, ITextBlock4_iface, ITextBlock5_iface,
+                  ITextBlock6_iface, ITextBlock7_iface;
+    IDWriteTextLayout *layout;      /* of the last measure */
+    FLOAT layout_width;
+};
+
+static struct text_block *text_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct text_block, e.d.obj );
+}
+
+static struct text_block *text_from_elem( struct uielem *elem )
+{
+    return CONTAINING_RECORD( elem, struct text_block, e );
+}
+
+static const struct xclass text_class;
+
+static void text_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct uielem *elem = CONTAINING_RECORD( obj, struct uielem, d );
+
+    if (obj->obj.cls == &text_class)   /* a TextBlock: its layout is made again */
+    {
+        struct text_block *text = text_from_elem( elem );
+        if (text->layout) IDWriteTextLayout_Release( text->layout );
+        text->layout = NULL;
+    }
+    uielem_invalidate_measure( elem );
+    xaml_invalidate_visuals();
+}
+
+static void foreground_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    xaml_invalidate_visuals();
+}
+
+static BOOL WINAPI init_text( INIT_ONCE *once, void *param, void **context )
+{
+    static const WCHAR tb[] = L"Windows.UI.Xaml.Controls.TextBlock";
+    struct xthickness zero = { 0 };
+    UINT16 normal_weight = 400;
+    INT32 no_wrap = XWRAP_NONE, left = XTEXT_LEFT, normal = 0;
+
+    xaml_elements_init();
+    xaml_media_init();
+    if (FAILED(DWriteCreateFactory( DWRITE_FACTORY_TYPE_SHARED, &IID_IDWriteFactory, (IUnknown **)&dwrite )))
+        ERR( "no DirectWrite\n" );
+    prop_font_size = xaml_property_register( tb, L"FontSize", L"Double", xbox_double( 14 ), FALSE, text_changed );
+    prop_font_family = xaml_property_register( tb, L"FontFamily", L"Windows.UI.Xaml.Media.FontFamily",
+                                               xaml_font_family( L"Segoe UI" ), FALSE, text_changed );
+    prop_font_weight = xaml_property_register( tb, L"FontWeight", L"Windows.UI.Text.FontWeight",
+            xbox_ref( &IID_IReference_FontWeight, &normal_weight, sizeof(normal_weight) ), FALSE, text_changed );
+    prop_font_style = xaml_property_register( tb, L"FontStyle", L"Windows.UI.Text.FontStyle",
+            xbox_ref( &IID_IReference_FontStyle, &normal, sizeof(normal) ), FALSE, text_changed );
+    prop_font_stretch = xaml_property_register( tb, L"FontStretch", L"Windows.UI.Text.FontStretch", NULL, FALSE, text_changed );
+    prop_character_spacing = xaml_property_register( tb, L"CharacterSpacing", L"Int32", xbox_int32( 0 ), FALSE, text_changed );
+    prop_foreground = xaml_property_register( tb, L"Foreground", L"Windows.UI.Xaml.Media.Brush", NULL, FALSE, foreground_changed );
+    prop_text_wrapping = xaml_property_register( tb, L"TextWrapping", L"Windows.UI.Xaml.TextWrapping",
+            xbox_ref( &IID_IReference_TextWrapping, &no_wrap, sizeof(no_wrap) ), FALSE, text_changed );
+    prop_text_trimming = xaml_property_register( tb, L"TextTrimming", L"Windows.UI.Xaml.TextTrimming", NULL, FALSE, text_changed );
+    prop_text_alignment = xaml_property_register( tb, L"TextAlignment", L"Windows.UI.Xaml.TextAlignment",
+            xbox_ref( &IID_IReference_TextAlignment, &left, sizeof(left) ), FALSE, text_changed );
+    prop_text = xaml_property_register( tb, L"Text", L"String", xbox_string( L"" ), FALSE, text_changed );
+    prop_padding = xaml_property_register( tb, L"Padding", L"Windows.UI.Xaml.Thickness",
+            xbox_ref( &IID_IReference_Thickness, &zero, sizeof(zero) ), FALSE, text_changed );
+    prop_line_height = xaml_property_register( tb, L"LineHeight", L"Double", xbox_double( 0 ), FALSE, text_changed );
+    prop_max_lines = xaml_property_register( tb, L"MaxLines", L"Int32", xbox_int32( 0 ), FALSE, text_changed );
+    prop_is_text_selection_enabled = xaml_property_register( tb, L"IsTextSelectionEnabled", L"Boolean",
+                                                             xbox_boolean( FALSE ), FALSE, NULL );
+    prop_is_text_scale_factor_enabled = xaml_property_register( tb, L"IsTextScaleFactorEnabled", L"Boolean",
+                                                                xbox_boolean( TRUE ), FALSE, NULL );
+    return TRUE;
+}
+
+static void text_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_text, NULL, NULL );
+}
+
+/* ---- values ---- */
+
+static DOUBLE get_dbl( struct uielem *elem, struct xaml_property *prop, DOUBLE def )
+{
+    IInspectable *box = NULL;
+    DOUBLE ret;
+
+    dobj_get_value( &elem->d, prop, &box );
+    ret = xunbox_double( box, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static INT32 get_enum( struct uielem *elem, struct xaml_property *prop, const GUID *iid, INT32 def )
+{
+    IInspectable *box = NULL;
+    INT32 ret;
+
+    dobj_get_value( &elem->d, prop, &box );
+    ret = xunbox_enum( box, iid, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static WCHAR *get_text( struct uielem *elem )
+{
+    IInspectable *box = NULL;
+    WCHAR *ret;
+
+    dobj_get_value( &elem->d, prop_text, &box );
+    ret = xunbox_string( box );
+    if (box) IInspectable_Release( box );
+    return ret ? ret : wcsdup( L"" );
+}
+
+static void get_padding( struct uielem *elem, struct xthickness *padding )
+{
+    IInspectable *box = NULL;
+
+    memset( padding, 0, sizeof(*padding) );
+    dobj_get_value( &elem->d, prop_padding, &box );
+    xunbox_ref( box, &IID_IReference_Thickness, padding, sizeof(*padding) );
+    if (box) IInspectable_Release( box );
+}
+
+static BOOL family_installed( const WCHAR *name )
+{
+    IDWriteFontCollection *fonts;
+    UINT32 index;
+    BOOL exists = FALSE;
+
+    if (!dwrite || FAILED(IDWriteFactory_GetSystemFontCollection( dwrite, &fonts, FALSE ))) return FALSE;
+    IDWriteFontCollection_FindFamilyName( fonts, name, &index, &exists );
+    IDWriteFontCollection_Release( fonts );
+    return exists;
+}
+
+/* the family to lay text out with */
+WCHAR *xaml_resolve_font_family( IInspectable *family )
+{
+    NONCLIENTMETRICSW metrics = { sizeof(metrics) };
+    WCHAR *name = xaml_font_family_name( family );
+
+    if (name && *name && family_installed( name )) return name;
+    if (name && wcscmp( name, L"Segoe UI" ) && wcscmp( name, L"XamlAutoFontFamily" ) && *name)
+    {
+        /* asked for by name: DirectWrite's fallback picks one with its glyphs */
+        return name;
+    }
+    free( name );
+    /* XAML's own font: the desktop's */
+    SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(metrics), &metrics, 0 );
+    return wcsdup( metrics.lfMessageFont.lfFaceName[0] ? metrics.lfMessageFont.lfFaceName : L"Tahoma" );
+}
+
+/* the text laid out within a width (FLT_MAX: unbounded), with a reference */
+static IDWriteTextLayout *text_layout( struct text_block *text, FLOAT width )
+{
+    struct uielem *elem = &text->e;
+    IDWriteTextFormat *format;
+    IDWriteTextLayout *layout = NULL;
+    IInspectable *family = NULL;
+    UINT16 weight = 400;
+    WCHAR *name, *str;
+    INT32 wrap, align, style;
+    DOUBLE size;
+    IInspectable *box = NULL;
+
+    if (!dwrite) return NULL;
+    if (text->layout && text->layout_width == width)
+    {
+        IDWriteTextLayout_AddRef( text->layout );
+        return text->layout;
+    }
+    dobj_get_value( &elem->d, prop_font_family, &family );
+    name = xaml_resolve_font_family( family );
+    if (family) IInspectable_Release( family );
+    dobj_get_value( &elem->d, prop_font_weight, &box );
+    xunbox_ref( box, &IID_IReference_FontWeight, &weight, sizeof(weight) );
+    if (box) IInspectable_Release( box );
+    size = get_dbl( elem, prop_font_size, 14 );
+    style = get_enum( elem, prop_font_style, &IID_IReference_FontStyle, 0 );
+    if (FAILED(IDWriteFactory_CreateTextFormat( dwrite, name, NULL, weight ? weight : 400,
+                                                style == 2 ? DWRITE_FONT_STYLE_ITALIC : style == 1 ? DWRITE_FONT_STYLE_OBLIQUE : DWRITE_FONT_STYLE_NORMAL,
+                                                DWRITE_FONT_STRETCH_NORMAL, size > 0 ? size : 14, L"", &format )))
+    {
+        free( name );
+        return NULL;
+    }
+    free( name );
+    wrap = get_enum( elem, prop_text_wrapping, &IID_IReference_TextWrapping, XWRAP_NONE );
+    IDWriteTextFormat_SetWordWrapping( format, wrap == XWRAP_NONE ? DWRITE_WORD_WRAPPING_NO_WRAP : DWRITE_WORD_WRAPPING_WRAP );
+    align = get_enum( elem, prop_text_alignment, &IID_IReference_TextAlignment, XTEXT_LEFT );
+    IDWriteTextFormat_SetTextAlignment( format, align == XTEXT_CENTER ? DWRITE_TEXT_ALIGNMENT_CENTER :
+                                        align == XTEXT_RIGHT ? DWRITE_TEXT_ALIGNMENT_TRAILING :
+                                        align == XTEXT_JUSTIFY ? DWRITE_TEXT_ALIGNMENT_JUSTIFIED : DWRITE_TEXT_ALIGNMENT_LEADING );
+    str = get_text( elem );
+#ifndef SG_MUTANT_TEXT_NO_WRAP
+    IDWriteFactory_CreateTextLayout( dwrite, str, wcslen( str ), format, wrap == XWRAP_NONE ? FLT_MAX : width,
+                                     FLT_MAX, &layout );
+#else
+    IDWriteFactory_CreateTextLayout( dwrite, str, wcslen( str ), format, FLT_MAX, FLT_MAX, &layout );
+#endif
+    free( str );
+    IDWriteTextFormat_Release( format );
+    if (!layout) return NULL;
+    if (text->layout) IDWriteTextLayout_Release( text->layout );
+    text->layout = layout;
+    text->layout_width = width;
+    IDWriteTextLayout_AddRef( layout );
+    return layout;
+}
+
+static void text_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct text_block *text = text_from_elem( elem );
+    DWRITE_TEXT_METRICS metrics;
+    struct xthickness padding;
+    IDWriteTextLayout *layout;
+    FLOAT width;
+
+    get_padding( elem, &padding );
+    width = isinf( available.width ) ? FLT_MAX : fmax( 0, available.width - padding.left - padding.right );
+    desired->width = padding.left + padding.right;
+    desired->height = padding.top + padding.bottom;
+    if (!(layout = text_layout( text, width ))) return;
+    if (SUCCEEDED(IDWriteTextLayout_GetMetrics( layout, &metrics )))
+    {
+        desired->width += ceil( metrics.widthIncludingTrailingWhitespace );
+        desired->height += ceil( metrics.height );
+    }
+    IDWriteTextLayout_Release( layout );
+}
+
+static void text_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct text_block *text = text_from_elem( elem );
+    struct xthickness padding;
+    IDWriteTextLayout *layout;
+
+    *used = final;
+    get_padding( elem, &padding );
+    /* laid out within its final width, for alignment and wrapping */
+    if ((layout = text_layout( text, fmax( 0, final.width - padding.left - padding.right ) )))
+        IDWriteTextLayout_Release( layout );
+}
+
+static const struct elem_ops text_ops = { text_measure, text_arrange };
