+
+MEDIA_STATIC(brush_statics_OpacityProperty, prop_brush_opacity)
+MEDIA_STATIC(brush_statics_TransformProperty, prop_brush_transform)
+MEDIA_STATIC(brush_statics_RelativeTransformProperty, prop_brush_relative_transform)
+MEDIA_STATIC(solid_statics_ColorProperty, prop_color)
+
+static const void *brush_statics_vtbl[] =
+{
+    IBrushStatics_FSTUBS,
+    [IBrushStatics_OpacityProperty] = brush_statics_OpacityProperty,
+    [IBrushStatics_TransformProperty] = brush_statics_TransformProperty,
+    [IBrushStatics_RelativeTransformProperty] = brush_statics_RelativeTransformProperty,
+};
+
+static struct xfactory brush_factory_obj =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.Media.Brush",
