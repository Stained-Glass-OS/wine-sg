+++ b/dlls/windows.ui.xaml/Makefile.in
@@ -1,5 +1,5 @@
 MODULE  = windows.ui.xaml.dll
-IMPORTS = combase user32 advapi32 uuid
+IMPORTS = combase dwrite user32 advapi32 uuid
 
 SOURCES = \
 	application.c \
@@ -10,8 +10,10 @@ SOURCES = \
 	hosting.c \
 	ifaces.c \
 	main.c \
+	media.c \
 	object.c \
 	panel.c \
+	text.c \
 	value.c \
 	vector.c \
 	window.c
