+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Our XAML takes its look from the system's: the theme colours are the system colours of the
+ * desktop's look (Classic or Rounded, light or dark), not Microsoft's XAML resources.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include "private.h"
+#include "winuser.h"
+
+
+
+const GUID IID_IReference_Color = { 0xab8e5d11, 0xb0c1, 0x5a21, { 0x95, 0xae, 0xf1, 0x6b, 0xf3, 0xa3, 0x76, 0x24 } };
+
+static struct xaml_property *prop_brush_opacity, *prop_brush_transform, *prop_brush_relative_transform, *prop_color;
+
+/* ---- the theme ---- */
+
+struct xcolor xaml_theme_color( enum xaml_theme_color which )
+{
+    static const int index[] =
+    {
+        [XTHEME_TEXT] = COLOR_WINDOWTEXT,
+        [XTHEME_BACKGROUND] = COLOR_WINDOW,
+        [XTHEME_CONTROL] = COLOR_BTNFACE,
+        [XTHEME_CONTROL_TEXT] = COLOR_BTNTEXT,
+        [XTHEME_BORDER] = COLOR_BTNSHADOW,
+        [XTHEME_ACCENT] = COLOR_HIGHLIGHT,
+        [XTHEME_ACCENT_TEXT] = COLOR_HIGHLIGHTTEXT,
+        [XTHEME_DISABLED_TEXT] = COLOR_GRAYTEXT,
+    };
+    COLORREF ref = GetSysColor( index[which] );
+    struct xcolor color = { 0xff, GetRValue( ref ), GetGValue( ref ), GetBValue( ref ) };
+    return color;
+}
+
+/* ---- Brush (composable; SolidColorBrush and the others derive from it) ---- */
+
+static void visual_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    xaml_invalidate_visuals();
+}
+
+static BOOL WINAPI init_media( INIT_ONCE *once, void *param, void **context )
+{
+    static const WCHAR brush[] = L"Windows.UI.Xaml.Media.Brush", solid[] = L"Windows.UI.Xaml.Media.SolidColorBrush";
+    struct xcolor transparent = { 0 };
+
+    prop_brush_opacity = xaml_property_register( brush, L"Opacity", L"Double", xbox_double( 1.0 ), FALSE, visual_changed );
+    prop_brush_transform = xaml_property_register( brush, L"Transform", L"Windows.UI.Xaml.Media.Transform", NULL, FALSE, visual_changed );
+    prop_brush_relative_transform = xaml_property_register( brush, L"RelativeTransform", L"Windows.UI.Xaml.Media.Transform",
+                                                           NULL, FALSE, visual_changed );
+    prop_color = xaml_property_register( solid, L"Color", L"Windows.UI.Color",
+                                         xbox_ref( &IID_IReference_Color, &transparent, sizeof(transparent) ), FALSE, visual_changed );
+    return TRUE;
+}
+
+void xaml_media_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_media, NULL, NULL );
+}
+
+struct brush
+{
+    struct dobj d;
+    struct xiface IBrush_iface;
+    struct xiface ISolidColorBrush_iface;   /* a SolidColorBrush's */
+};
+
+static struct brush *brush_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct brush, d.obj );
+}
+
+static HRESULT WINAPI brush_get_Opacity( struct xiface *iface, DOUBLE *value )
+{
+    IInspectable *box;
+
+    if (!value) return E_POINTER;
+    dobj_get_value( &brush_from_iface( iface )->d, prop_brush_opacity, &box );
+    *value = xunbox_double( box, 1.0 );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
+static HRESULT WINAPI brush_put_Opacity( struct xiface *iface, DOUBLE value )
+{
+    IInspectable *box = xbox_double( value );
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &brush_from_iface( iface )->d, prop_brush_opacity, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static HRESULT WINAPI brush_get_Transform( struct xiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    return dobj_get_value( &brush_from_iface( iface )->d, prop_brush_transform, value );
+}
+
+static HRESULT WINAPI brush_put_Transform( struct xiface *iface, IInspectable *value )
+{
+    return dobj_set_value( &brush_from_iface( iface )->d, prop_brush_transform, value );
+}
+
+static HRESULT WINAPI brush_get_RelativeTransform( struct xiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    return dobj_get_value( &brush_from_iface( iface )->d, prop_brush_relative_transform, value );
+}
+
+static HRESULT WINAPI brush_put_RelativeTransform( struct xiface *iface, IInspectable *value )
+{
+    return dobj_set_value( &brush_from_iface( iface )->d, prop_brush_relative_transform, value );
+}
+
+static const void *brush_vtbl[] =
+{
+    IBrush_STUBS,
+    [IBrush_Opacity] = brush_get_Opacity,
+    [IBrush_SetOpacity] = brush_put_Opacity,
+    [IBrush_Transform] = brush_get_Transform,
+    [IBrush_SetTransform] = brush_put_Transform,
+    [IBrush_RelativeTransform] = brush_get_RelativeTransform,
+    [IBrush_SetRelativeTransform] = brush_put_RelativeTransform,
+};
+
+static HRESULT WINAPI solid_get_Color( struct xiface *iface, struct xcolor *value )
+{
+    IInspectable *box;
+
+    if (!value) return E_POINTER;
+    memset( value, 0, sizeof(*value) );
+    dobj_get_value( &brush_from_iface( iface )->d, prop_color, &box );
+    xunbox_ref( box, &IID_IReference_Color, value, sizeof(*value) );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
+static HRESULT WINAPI solid_put_Color( struct xiface *iface, struct xcolor value )
+{
+    IInspectable *box = xbox_ref( &IID_IReference_Color, &value, sizeof(value) );
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &brush_from_iface( iface )->d, prop_color, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static const void *solid_vtbl[] =
+{
+    ISolidColorBrush_STUBS,
+    [ISolidColorBrush_Color] = solid_get_Color,
+    [ISolidColorBrush_SetColor] = solid_put_Color,
+};
+
+static const struct xiface_entry brush_ifaces[] =
+{
+    { &IID_IBrush, offsetof(struct brush, IBrush_iface) },
+    DOBJ_IFACES(struct dobj),
+};
+
+static const struct xiface_entry solid_ifaces[] =
+{
+    { &IID_ISolidColorBrush, offsetof(struct brush, ISolidColorBrush_iface) },
+    { &IID_IBrush, offsetof(struct brush, IBrush_iface) },
+    DOBJ_IFACES(struct dobj),
+};
+
+static void brush_destroy( struct xobj *obj )
+{
+    dobj_cleanup( &CONTAINING_RECORD( obj, struct brush, d.obj )->d );
+}
+
+static const struct xclass brush_class =
+{
+    L"Windows.UI.Xaml.Media.Brush", brush_ifaces, ARRAY_SIZE(brush_ifaces), brush_destroy,
+};
+
+static const struct xclass solid_class =
+{
+    L"Windows.UI.Xaml.Media.SolidColorBrush", solid_ifaces, ARRAY_SIZE(solid_ifaces), brush_destroy,
+};
+
+static struct brush *new_brush( BOOL solid, IInspectable *outer )
+{
+    struct brush *brush;
+
+    xaml_media_init();
+    if (!(brush = calloc( 1, sizeof(*brush) ))) return NULL;
+    brush->IBrush_iface.vtbl = brush_vtbl;
+    brush->ISolidColorBrush_iface.vtbl = solid_vtbl;
+    dobj_init( &brush->d, solid ? &solid_class : &brush_class, outer );
+    return brush;
+}
+
+/* a brush's colour, if it is a SolidColorBrush (its opacity applied) */
+BOOL xaml_brush_color( IInspectable *brush_iface, struct xcolor *color )
+{
+    struct dobj *obj = dobj_from_inspectable( brush_iface );
+    struct brush *brush;
+    IInspectable *box = NULL;
+    DOUBLE opacity;
+
+    if (!obj || obj->obj.cls != &solid_class) return FALSE;
+    brush = CONTAINING_RECORD( obj, struct brush, d );
+    solid_get_Color( &brush->ISolidColorBrush_iface, color );
+    dobj_get_value( &brush->d, prop_brush_opacity, &box );
+    opacity = xunbox_double( box, 1.0 );
+    if (box) IInspectable_Release( box );
+    color->a = (BYTE)(color->a * fmin( fmax( opacity, 0 ), 1 ) + 0.5);
+    return TRUE;
+}
+
+IInspectable *xaml_solid_brush( struct xcolor color )
+{
+    struct brush *brush = new_brush( TRUE, NULL );
+
+    if (!brush) return NULL;
+    solid_put_Color( &brush->ISolidColorBrush_iface, color );
+    return (IInspectable *)&brush->ISolidColorBrush_iface;
+}
+
+static HRESULT WINAPI brush_factory_CreateInstance( struct xfiface *iface, IInspectable *outer, IInspectable **inner,
+                                                    void **value )
+{
+    struct brush *brush;
+
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(brush = new_brush( FALSE, outer ))) return E_OUTOFMEMORY;
+    if (outer)
+    {
+        *inner = &brush->d.obj.IInspectable_inner;
+        IUnknown_AddRef( brush->d.obj.outer );
+    }
+    *value = &brush->IBrush_iface;
+    return S_OK;
+}
+
+static const void *brush_factory_vtbl[] = { IBrushFactory_FSTUBS, [IBrushFactory_CreateInstance] = brush_factory_CreateInstance };
+
+#define MEDIA_STATIC(name, prop) \
