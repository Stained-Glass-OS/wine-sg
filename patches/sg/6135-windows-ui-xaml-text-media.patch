+static const void *font_family_factory_vtbl[] =
+{
+    IFontFamilyFactory_FSTUBS,
+    [IFontFamilyFactory_CreateInstanceWithName] = font_family_factory_CreateInstanceWithName,
+};
+
+static HRESULT WINAPI font_family_statics2_XamlAutoFontFamily( struct xfiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    return (*value = xaml_font_family( L"Segoe UI" )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static const void *font_family_statics2_vtbl[] =
+{
+    IFontFamilyStatics2_FSTUBS,
+    [IFontFamilyStatics2_XamlAutoFontFamily] = font_family_statics2_XamlAutoFontFamily,
+};
+
+static struct xfactory font_family_factory_obj =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.Media.FontFamily",
+    { &IID_IFontFamilyFactory, &IID_IFontFamilyStatics2 },
+    { { font_family_factory_vtbl }, { font_family_statics2_vtbl } },
+};
+
+IActivationFactory *font_family_factory = &font_family_factory_obj.IActivationFactory_iface;
