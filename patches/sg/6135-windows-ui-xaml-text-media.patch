index 0000000..d1bd15c
--- /dev/null
+++ b/dlls/windows.ui.xaml/media.c
@@ -0,0 +1,441 @@
+/*
+ * Windows.UI.Xaml.Media: Brush, SolidColorBrush, FontFamily; the theme's colours
+ *
+ * Copyright 2026 Stained Glass OS
+ *
