From: Stained Glass OS <dev@stained-glass.example>
Subject: dxgi: DXGIDeclareAdapterRemovalSupport

Programs that cope with a GPU being removed say so first; Paint.NET 5
stopped with EntryPointNotFoundException. Wine's adapters are never
removed, so there is nothing to change: S_OK, and
DXGI_ERROR_ALREADY_EXISTS for a second call, as documented.

Gate: test/winver-gate.sh.
---
--- a/dlls/dxgi/dxgi.spec
+++ b/dlls/dxgi/dxgi.spec
@@ -3,4 +3,5 @@
 @ stdcall CreateDXGIFactory2(long ptr ptr)
 @ stdcall DXGID3D10CreateDevice(ptr ptr ptr long ptr long ptr)
 @ stdcall DXGID3D10RegisterLayers(ptr long)
+@ stdcall DXGIDeclareAdapterRemovalSupport()
 @ stdcall DXGIGetDebugInterface1(long ptr ptr)
--- a/dlls/dxgi/dxgi_main.c
+++ b/dlls/dxgi/dxgi_main.c
@@ -250,3 +250,17 @@
     WARN("Returning DXGI_ERROR_SDK_COMPONENT_MISSING.\n");
     return DXGI_ERROR_SDK_COMPONENT_MISSING;
 }
+
+/* A process says it copes with an adapter being removed (a GPU unplugged
+ * or its driver updated). Wine's adapters are never removed, so there is
+ * nothing to change; only a second call is refused, as documented. */
+HRESULT WINAPI DXGIDeclareAdapterRemovalSupport(void)
+{
+    static LONG declared;
+
+    TRACE("\n");
+
+    if (InterlockedExchange(&declared, 1))
+        return DXGI_ERROR_ALREADY_EXISTS;
+    return S_OK;
+}
