From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntoskrnl.exe: Implement RtlIsNtDdiVersionAvailable.

RtlIsNtDdiVersionAvailable answers whether the running Windows version
(RtlGetVersion: major, minor, service pack and, for Windows 10 and 11, the
release its build number belongs to) is the given NTDDI value or later; it
always answered FALSE, so drivers that check for Windows 10 features took
their old-Windows paths.

Gate: test/ntoskrnl-ntddi-gate.sh (a probe driver; 64-bit, a WoW64 host skips).
---
 dlls/ntoskrnl.exe/ntoskrnl.c | 35 +++++++++++++++++++++++++++++++++--
 1 file changed, 33 insertions(+), 2 deletions(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index bff0c26..8653fae 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -4912,8 +4912,39 @@ BOOLEAN WINAPI IoIs32bitProcess(IRP *irp)
  */
 BOOLEAN WINAPI RtlIsNtDdiVersionAvailable(ULONG version)
 {
-    FIXME("stub: %ld\n", version);
-    return FALSE;
+    /* the first build of each Windows 10 and 11 release the NTDDI values name */
+    static const struct { ULONG build; BYTE subver; } releases[] =
+    {
+        { 22621, 0x0c },  /* NTDDI_WIN10_NI */
+        { 22000, 0x0b },  /* NTDDI_WIN10_CO */
+        { 20348, 0x0a },  /* NTDDI_WIN10_FE */
+        { 19041, 0x08 },  /* NTDDI_WIN10_VB */
+        { 18362, 0x07 },  /* NTDDI_WIN10_19H1 */
+        { 17763, 0x06 },  /* NTDDI_WIN10_RS5 */
+        { 17134, 0x05 },  /* NTDDI_WIN10_RS4 */
+        { 16299, 0x04 },  /* NTDDI_WIN10_RS3 */
+        { 15063, 0x03 },  /* NTDDI_WIN10_RS2 */
+        { 14393, 0x02 },  /* NTDDI_WIN10_RS1 */
+        { 10586, 0x01 },  /* NTDDI_WIN10_TH2 */
+    };
+    RTL_OSVERSIONINFOEXW info = { sizeof(info) };
+    ULONG running, subver = 0;
+    unsigned int i;
+
+    TRACE("%#lx\n", version);
+
+    RtlGetVersion( &info );
+    if (info.dwMajorVersion >= 10)
+    {
+        for (i = 0; i < ARRAY_SIZE(releases); i++)
+            if (info.dwBuildNumber >= releases[i].build) { subver = releases[i].subver; break; }
+    }
+    /* NTDDI: the OS version, the service pack, the release */
+    running = (info.dwMajorVersion << 24) | (info.dwMinorVersion << 16) | (info.wServicePackMajor << 8) | subver;
+#ifdef SG_MUTANT_NTDDI_MAJOR_ONLY
+    running |= 0xffff;
+#endif
+    return version <= running;
 }
 
 BOOLEAN WINAPI KdRefreshDebuggerNotPresent(void)
