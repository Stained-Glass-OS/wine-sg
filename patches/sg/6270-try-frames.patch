From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32, wintrust, crypt32: no return or goto out of a __TRY body (6269's left an exception frame behind)

A __TRY body is left only through its end: 6269's user32 check returned from inside one and left a dead frame on the exception list of every thread that loaded one of our icons, and programs died at their next exception (Teams). Fixed there and in the three other places our patched files leave a __TRY body; make lint now refuses them.
---
diff --git a/dlls/crypt32/decode.c b/dlls/crypt32/decode.c
index 5f0ad3a..dadbb4b 100644
--- a/dlls/crypt32/decode.c
+++ b/dlls/crypt32/decode.c
@@ -4875,11 +4875,15 @@ static BOOL WINAPI CRYPT_AsnDecodeEnumerated(DWORD dwCertEncodingType,
                  * assuming a small length is okay here, it has to be in short
                  * form.
                  */
+                /* Stained Glass OS: no return inside the __TRY (it left its frame on the
+                 * thread's exception list, wine-sg 6270) */
                 if (pbEncoded[1] > sizeof(unsigned int) + 1)
                 {
                     SetLastError(CRYPT_E_ASN1_LARGE);
-                    return FALSE;
+                    ret = FALSE;
                 }
+                else
+                {
                 for (i = 0; i < pbEncoded[1]; i++)
                 {
                     val <<= 8;
@@ -4892,6 +4896,7 @@ static BOOL WINAPI CRYPT_AsnDecodeEnumerated(DWORD dwCertEncodingType,
                         pvStructInfo = *(BYTE **)pvStructInfo;
                     memcpy(pvStructInfo, &val, sizeof(unsigned int));
                 }
+                }
             }
         }
         else
diff --git a/dlls/crypt32/encode.c b/dlls/crypt32/encode.c
index 25078ae..0466b34 100644
--- a/dlls/crypt32/encode.c
+++ b/dlls/crypt32/encode.c
@@ -3775,9 +3775,11 @@ static BOOL WINAPI CRYPT_AsnEncodeChoiceOfTime(DWORD dwCertEncodingType,
         SYSTEMTIME sysTime;
 
         /* Check the year, if it's in the UTCTime range call that encode func */
+        /* Stained Glass OS: no return inside the __TRY (it left its frame on the thread's exception
+         * list, wine-sg 6270) */
         if (!FileTimeToSystemTime(pvStructInfo, &sysTime))
-            return FALSE;
-        if (sysTime.wYear >= 1950 && sysTime.wYear <= 2050)
+            ret = FALSE;
+        else if (sysTime.wYear >= 1950 && sysTime.wYear <= 2050)
             ret = CRYPT_AsnEncodeUtcTime(dwCertEncodingType, lpszStructType,
              pvStructInfo, dwFlags, pEncodePara, pbEncoded, pcbEncoded);
         else
diff --git a/dlls/user32/cursoricon.c b/dlls/user32/cursoricon.c
index 0a73cdd..e1916ee 100644
--- a/dlls/user32/cursoricon.c
+++ b/dlls/user32/cursoricon.c
@@ -1010,17 +1010,24 @@ BOOL sg_module_is_ours( HMODULE module )
     static const char signature[] = "Wine builtin DLL";
     const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)((ULONG_PTR)module & ~(ULONG_PTR)3);
 
+    BOOL ours = FALSE;
+
     if (!module) return TRUE;  /* user32's own */
+    /* no return inside the __TRY: it would leave its frame on the thread's exception list (wine-sg 6270) */
     __TRY
     {
-        if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew < sizeof(*dos) + sizeof(signature)) return FALSE;
-        return !memcmp( dos + 1, signature, sizeof(signature) );
+        ours = dos->e_magic == IMAGE_DOS_SIGNATURE && dos->e_lfanew >= sizeof(*dos) + sizeof(signature) &&
+               !memcmp( dos + 1, signature, sizeof(signature) );
     }
     __EXCEPT_PAGE_FAULT
     {
-        return FALSE;
+        ours = FALSE;
     }
     __ENDTRY
+#ifdef SG_MUTANT_TRY_RETURN
+    __TRY { if (module) return ours; } __EXCEPT_PAGE_FAULT { } __ENDTRY
+#endif
+    return ours;
 }
 
 static void rgb_to_hsv( double r, double g, double b, double *h, double *s, double *v )
diff --git a/dlls/wintrust/asn.c b/dlls/wintrust/asn.c
index 2f0259d..dcd8efe 100644
--- a/dlls/wintrust/asn.c
+++ b/dlls/wintrust/asn.c
@@ -896,17 +896,21 @@ BOOL WINAPI WVTAsn1SpcSpAgencyInfoEncode(DWORD dwCertEncodingType,
     {
         const SPC_SP_AGENCY_INFO *info = pvStructInfo;
         const SPC_LINK *links[2] = { info->pPolicyInformation, info->pLogoLink };
+        BOOL bad = FALSE;
         int i;
 
-        for (i = 0; i < 2; i++)
+        /* no goto out of the __TRY: it would leave its frame on the thread's exception list (wine-sg 6270) */
+        for (i = 0; i < 2 && !bad; i++)
             if (links[i] && links[i]->dwLinkChoice != SPC_URL_LINK_CHOICE &&
              links[i]->dwLinkChoice != SPC_MONIKER_LINK_CHOICE &&
              links[i]->dwLinkChoice != SPC_FILE_LINK_CHOICE)
             {
                 SetLastError(E_INVALIDARG);
-                goto done;
+                bad = TRUE;
             }
-        if (info->pLogoImage)
+        if (bad)
+            ;
+        else if (info->pLogoImage)
             SetLastError(ERROR_NOT_SUPPORTED);
         else
         {
@@ -957,7 +961,6 @@ BOOL WINAPI WVTAsn1SpcSpAgencyInfoEncode(DWORD dwCertEncodingType,
         SetLastError(STATUS_ACCESS_VIOLATION);
     }
     __ENDTRY
-done:
     return ret;
 }
 
