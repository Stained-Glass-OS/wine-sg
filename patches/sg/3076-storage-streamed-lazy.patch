-static HRESULT streamed_create( HSTRING name, IStreamedFileDataRequestedHandler *handler,
+/* files whose data is not there yet */
+struct streamed_entry
+{
+    struct list entry;
+    WCHAR *path;
+    IStreamedFileDataRequestedHandler *handler;
+    WCHAR *url;
+    CRITICAL_SECTION cs;
+    BOOL done;
+    HRESULT result;
+};
+
+static struct list streamed_list = LIST_INIT( streamed_list );
+static CRITICAL_SECTION streamed_cs;
+static CRITICAL_SECTION_DEBUG streamed_cs_debug =
+{
+    0, 0, &streamed_cs,
+    { &streamed_cs_debug.ProcessLocksList, &streamed_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": streamed_cs") }
+};
+static CRITICAL_SECTION streamed_cs = { &streamed_cs_debug, -1, 0, 0, 0, 0 };
+
+/* download url into the file at path through winhttp; an HTTP error status is HTTP_E_STATUS_* */
+static HRESULT download_url( const WCHAR *url, const WCHAR *path )
+{
+    URL_COMPONENTS uc = { sizeof(uc) };
+    HINTERNET session = NULL, connect = NULL, request = NULL;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    WCHAR host[256], object[2048];
+    DWORD status = 0, size = sizeof(status), avail, got, put;
+    HRESULT hr = S_OK;
+    BYTE *buffer;
+
+    uc.lpszHostName = host;
+    uc.dwHostNameLength = ARRAY_SIZE(host);
+    uc.lpszUrlPath = object;
+    uc.dwUrlPathLength = ARRAY_SIZE(object);
+    uc.dwExtraInfoLength = (DWORD)-1;
+    if (!WinHttpCrackUrl( url, 0, 0, &uc )) return HRESULT_FROM_WIN32( GetLastError() );
+    if (uc.dwExtraInfoLength && uc.lpszExtraInfo)
+    {
+        size_t len = wcslen( object );
+        if (len + uc.dwExtraInfoLength >= ARRAY_SIZE(object)) return HRESULT_FROM_WIN32( ERROR_BUFFER_OVERFLOW );
+        memcpy( object + len, uc.lpszExtraInfo, uc.dwExtraInfoLength * sizeof(WCHAR) );
+        object[len + uc.dwExtraInfoLength] = 0;
+    }
+    if (!(buffer = malloc( 65536 ))) return E_OUTOFMEMORY;
+
+    if (!(session = WinHttpOpen( L"Mozilla/5.0", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, NULL, NULL, 0 )) ||
+        !(connect = WinHttpConnect( session, host, uc.nPort, 0 )) ||
+        !(request = WinHttpOpenRequest( connect, NULL, object, NULL, NULL, NULL,
+                                        uc.nScheme == INTERNET_SCHEME_HTTPS ? WINHTTP_FLAG_SECURE : 0 )) ||
+        !WinHttpSendRequest( request, NULL, 0, NULL, 0, 0, 0 ) || !WinHttpReceiveResponse( request, NULL ))
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+    else if (!WinHttpQueryHeaders( request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+                                   NULL, &status, &size, NULL ))
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+    else if (status < 200 || status >= 300) hr = MAKE_HRESULT( SEVERITY_ERROR, 0x19, status );
+    else
+    {
+        file = CreateFileW( path, GENERIC_WRITE, FILE_SHARE_READ, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+        if (file == INVALID_HANDLE_VALUE) hr = HRESULT_FROM_WIN32( GetLastError() );
+        while (SUCCEEDED( hr ))
+        {
+            if (!WinHttpQueryDataAvailable( request, &avail )) hr = HRESULT_FROM_WIN32( GetLastError() );
+            else if (!avail) break;
+            else if (!WinHttpReadData( request, buffer, min( avail, 65536 ), &got )) hr = HRESULT_FROM_WIN32( GetLastError() );
+            else if (!got) break;
+            else if (!WriteFile( file, buffer, got, &put, NULL ) || put != got) hr = HRESULT_FROM_WIN32( GetLastError() );
+        }
+        if (file != INVALID_HANDLE_VALUE) CloseHandle( file );
+    }
+    if (request) WinHttpCloseHandle( request );
+    if (connect) WinHttpCloseHandle( connect );
+    if (session) WinHttpCloseHandle( session );
+    free( buffer );
+    return hr;
+}
+
+/* make the data of a streamed file; runs the handler (or the download) once, then the result stands */
+HRESULT streamed_ensure( const WCHAR *path )
+{
+    struct streamed_entry *e, *found = NULL;
+    WCHAR *part;
+    HRESULT hr;
+
+    if (!path) return S_OK;
+#ifdef SG_MUTANT_NOLAZY
+    return S_OK;
+#endif
+    EnterCriticalSection( &streamed_cs );
+    LIST_FOR_EACH_ENTRY( e, &streamed_list, struct streamed_entry, entry )
+        if (!wcsicmp( e->path, path )) { found = e; break; }
+    LeaveCriticalSection( &streamed_cs );
+    if (!found) return S_OK;
+
+    EnterCriticalSection( &found->cs );
+    if (!found->done)
+    {
+        part = malloc( (wcslen( found->path ) + 8) * sizeof(WCHAR) );
+        if (!part) hr = E_OUTOFMEMORY;
+        else
+        {
+            swprintf( part, wcslen( found->path ) + 8, L"%ls.sgpart", found->path );
+            if (found->url) hr = download_url( found->url, part );
+            else hr = fill_streamed_file( part, found->handler );
+            /* the old data stays when the data cannot be made */
+            if (SUCCEEDED( hr ) && !MoveFileExW( part, found->path, MOVEFILE_REPLACE_EXISTING ))
+                hr = HRESULT_FROM_WIN32( GetLastError() );
+            if (FAILED( hr )) DeleteFileW( part );
+            free( part );
+        }
+        found->result = hr;
+        found->done = TRUE;
+        if (found->handler) IStreamedFileDataRequestedHandler_Release( found->handler );
+        found->handler = NULL;
+    }
+    hr = found->result;
+    LeaveCriticalSection( &found->cs );
+    return hr;
+}
+
+/* the data of the file at path is made when it is first opened */
+static HRESULT streamed_register( const WCHAR *path, IStreamedFileDataRequestedHandler *handler, const WCHAR *url )
+{
+    struct streamed_entry *e, *old;
+
+    if (!(e = calloc( 1, sizeof(*e) ))) return E_OUTOFMEMORY;
+    e->path = wcsdup( path );
+    e->url = url ? wcsdup( url ) : NULL;
+    e->handler = handler;
+    if (handler) IStreamedFileDataRequestedHandler_AddRef( handler );
+    if (!e->path || (url && !e->url))
+    {
+        free( e->path );
+        free( e->url );
+        free( e );
+        return E_OUTOFMEMORY;
+    }
+    InitializeCriticalSectionEx( &e->cs, 0, 0 );
+    EnterCriticalSection( &streamed_cs );
+    /* an older request for the same file is superseded */
+    LIST_FOR_EACH_ENTRY( old, &streamed_list, struct streamed_entry, entry )
+        if (!wcsicmp( old->path, path ) && !old->done)
+        {
+            EnterCriticalSection( &old->cs );
+            old->done = TRUE;
+            old->result = S_OK;
+            if (old->handler) IStreamedFileDataRequestedHandler_Release( old->handler );
+            old->handler = NULL;
+            LeaveCriticalSection( &old->cs );
+        }
+    list_add_head( &streamed_list, &e->entry );
+    LeaveCriticalSection( &streamed_cs );
+    return S_OK;
+}
+
+static HRESULT streamed_create( HSTRING name, IStreamedFileDataRequestedHandler *handler, const WCHAR *url,
                                 IAsyncOperation_StorageFile **operation )
 {
     IUnknown *file = NULL;
     WCHAR *path = NULL;
+    HANDLE h;
     HRESULT hr;
 
     if (!operation) return E_POINTER;
     *operation = NULL;
+    if (!handler && !url) return E_INVALIDARG;
     if (FAILED( hr = streamed_target( name, &path ) )) return hr;
-    if (SUCCEEDED( hr = fill_streamed_file( path, handler ) )) hr = item_from_path( path, FALSE, &file );
-    else DeleteFileW( path );
+    h = CreateFileW( path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                     CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (h == INVALID_HANDLE_VALUE) hr = HRESULT_FROM_WIN32( GetLastError() );
+    else
+    {
+        CloseHandle( h );
+        if (SUCCEEDED( hr = streamed_register( path, handler, url ) )) hr = item_from_path( path, FALSE, &file );
+        if (FAILED( hr )) DeleteFileW( path );
+    }
     free( path );
     return RET_FILE( file, hr, operation );
 }
 
