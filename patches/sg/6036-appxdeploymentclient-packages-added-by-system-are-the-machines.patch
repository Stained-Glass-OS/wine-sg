From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxdeploymentclient, kernelbase, ntdll, shell32: Packages added by SYSTEM are the machine's (6036)

On Stained Glass OS a per-machine installer runs elevated as the machine
account (S-1-5-18), not as the user who asked for it. A package its custom
action added (TeraCopy's sparse package) was recorded in SYSTEM's own
HKCU, or, from a 32-bit caller, under WOW6432Node: no user ever saw it.
A SYSTEM caller now records its packages under HKLM\Software\Wine\AppModel
\Packages (64-bit view), with the all-users Start menu entry and the
machine's COM classes, and no aliases (they are per user). Every reader
(appxdeploymentclient's queries, kernelbase's package identity and
aliases, ntdll's package graph, shell32's package verbs) takes the user's
records, then the machine's. A user cannot remove the machine's package.
---
diff --git a/dlls/appxdeploymentclient/deploy.c b/dlls/appxdeploymentclient/deploy.c
index b1f8998..b0e04ce 100644
--- a/dlls/appxdeploymentclient/deploy.c
+++ b/dlls/appxdeploymentclient/deploy.c
@@ -247,6 +247,62 @@ static BOOL read_record( HKEY key, const WCHAR *full_name, struct package_record
     return TRUE;
 }
 
+/* Stained Glass OS: the machine account's packages are the machine's. An installer that runs elevated
+ * runs as SYSTEM here (not as the user, as with UAC on Windows): the packages it adds are recorded under
+ * HKLM\Software\Wine\AppModel\Packages, with their Start menu entries and COM classes for all users,
+ * and every user finds them there beside their own (HKCU). */
+static BOOL caller_is_system(void)
+{
+    static int is_system = -1;
+    BYTE buffer[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE];
+    TOKEN_USER *user = (TOKEN_USER *)buffer;
+    HANDLE token;
+    DWORD size;
+
+#ifdef SG_MUTANT_AX_SYSTEM_HKCU
+    return FALSE;
+#endif
+    if (is_system >= 0) return is_system;
+    is_system = 0;
+    if (OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+    {
+        if (GetTokenInformation( token, TokenUser, user, sizeof(buffer), &size ))
+            is_system = IsWellKnownSid( user->User.Sid, WinLocalSystemSid );
+        CloseHandle( token );
+    }
+    return is_system;
+}
+
+/* One view of the records and classes for 32- and 64-bit callers (a 32-bit installer's custom action
+ * would otherwise write the machine's under WOW6432Node). */
+#ifdef SG_MUTANT_AX_WOW_VIEW
+#define REC_VIEW 0
+#else
+#define REC_VIEW KEY_WOW64_64KEY
+#endif
+
+static LSTATUS delete_tree_64( HKEY root, const WCHAR *path )
+{
+    LSTATUS res;
+    HKEY key;
+
+    if ((res = RegOpenKeyExW( root, path, 0, KEY_ALL_ACCESS | REC_VIEW, &key ))) return res;
+    RegDeleteTreeW( key, NULL );
+    RegCloseKey( key );
+    return RegDeleteKeyExW( root, path, REC_VIEW, 0 );
+}
+
+/* where this caller's records (and the classes of its packages) go */
+static HKEY own_hive(void)
+{
+    return caller_is_system() ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER;
+}
+
+static HKEY other_hive(void)
+{
+    return caller_is_system() ? HKEY_CURRENT_USER : HKEY_LOCAL_MACHINE;
+}
