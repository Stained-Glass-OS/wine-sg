+                                 NULL, SHGFP_TYPE_CURRENT, programs )))
         return;
     if (FAILED(IAppxManifestReader_GetApplications( manifest, &apps ))) return;
 
@@ -553,24 +610,51 @@ typedef BOOL (*record_func)( struct package_record *rec, void *context );
 static void for_each_record( record_func func, void *context )
 {
     WCHAR full_name[256];
-    DWORD len, index = 0;
-    HKEY root, key;
+    DWORD len, index;
+    HKEY root, key, own = NULL;
     BOOL more = TRUE;
+    int pass;
 
-    if (RegOpenKeyExW( HKEY_CURRENT_USER, packages_keyW, 0, KEY_READ, &root )) return;
-    while (more && (len = ARRAY_SIZE(full_name), !RegEnumKeyExW( root, index++, full_name, &len, NULL, NULL, NULL, NULL )))
+    /* this caller's own records, then the others it sees (a user: the machine's) */
+    for (pass = 0; pass < 2 && more; pass++)
     {
-        struct package_record rec;
-
-        if (RegOpenKeyExW( root, full_name, 0, KEY_READ, &key )) continue;
-        if (read_record( key, full_name, &rec ))
+        if (RegOpenKeyExW( pass ? other_hive() : own_hive(), packages_keyW, 0, KEY_READ | REC_VIEW, &root )) continue;
+        if (!pass) own = root;
+        index = 0;
+        while (more && (len = ARRAY_SIZE(full_name), !RegEnumKeyExW( root, index++, full_name, &len, NULL, NULL, NULL, NULL )))
         {
-            more = func( &rec, context );
-            package_record_free( &rec );
+            struct package_record rec;
+
+            /* the same package recorded in both: the own record counts */
+            if (pass && own && !RegOpenKeyExW( own, full_name, 0, KEY_READ, &key ))
+            {
+                RegCloseKey( key );
+                continue;
+            }
+            if (RegOpenKeyExW( root, full_name, 0, KEY_READ, &key )) continue;
+            if (read_record( key, full_name, &rec ))
+            {
+                more = func( &rec, context );
+                package_record_free( &rec );
+            }
+            RegCloseKey( key );
         }
-        RegCloseKey( key );
+        if (pass) RegCloseKey( root );
     }
-    RegCloseKey( root );
+    if (own) RegCloseKey( own );
+}
