 static const WCHAR deployed_packagesW[] = L"Software\\Wine\\AppModel\\Packages";
 
+/* Stained Glass OS: the user's own records (HKCU), then the machine's (HKLM: packages an installer
+ * running as SYSTEM added, for all users). */
+static HKEY record_hive( const WCHAR *key_path )
+{
+    HKEY key;
+
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, key_path, 0, KEY_READ | KEY_WOW64_64KEY, &key ))
+    {
+        RegCloseKey( key );
+        return HKEY_CURRENT_USER;
+    }
+#ifdef SG_MUTANT_AX_READ_NO_MACHINE
+    return HKEY_CURRENT_USER;
+#endif
+    return HKEY_LOCAL_MACHINE;
+}
+
+/* the index'th deployed package this user sees (a full name in both counts once) */
+static BOOL enum_deployed_package( DWORD index, WCHAR *name, DWORD size )
+{
+    WCHAR path[MAX_PATH];
+    HKEY roots[2] = { HKEY_CURRENT_USER, HKEY_LOCAL_MACHINE };
+    DWORD i, n, len;
+    HKEY key, dup;
+
+#ifdef SG_MUTANT_AX_READ_NO_MACHINE
+    n = 1;
+#else
+    n = 2;
+#endif
+    for (i = 0; i < n; i++)
+    {
+        DWORD sub = 0;
+
+        if (RegOpenKeyExW( roots[i], deployed_packagesW, 0, KEY_READ | KEY_WOW64_64KEY, &key )) continue;
+        while (len = size, !RegEnumKeyExW( key, sub++, name, &len, NULL, NULL, NULL, NULL ))
+        {
+            if (i && wcslen( name ) + ARRAY_SIZE(deployed_packagesW) + 1 < ARRAY_SIZE(path))
+            {
+                swprintf( path, ARRAY_SIZE(path), L"%s\\%s", deployed_packagesW, name );
+                if (!RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ | KEY_WOW64_64KEY, &dup ))
+                {
+                    RegCloseKey( dup );
+                    continue;
+                }
+            }
+            if (!index--)
+            {
+                RegCloseKey( key );
+                return TRUE;
+            }
+        }
+        RegCloseKey( key );
+    }
+    return FALSE;
+}
