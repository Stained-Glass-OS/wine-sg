From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cmd: FOR expands a wildcard in a quoted element (7005)

for /d %%d in ("C:\Program Files\Eclipse Adoptium\jdk-21*") found
nothing: cmd searched for the pattern with its quotes. Scripts that find
a tool in a folder with spaces this way (JAVA_HOME, SDK and MSBuild
finders) failed. The element is searched without its quotes and each
match is quoted again; %%~f gives the bare path.
---
diff --git a/programs/cmd/wcmdmain.c b/programs/cmd/wcmdmain.c
index 4a9d12a..fb8e09a 100644
--- a/programs/cmd/wcmdmain.c
+++ b/programs/cmd/wcmdmain.c
@@ -3586,8 +3586,24 @@ static RETURN_CODE for_control_execute_set(CMD_FOR_CONTROL *for_ctrl, const WCHA
         if (wcspbrk(element, L"?*"))
         {
             WIN32_FIND_DATAW fd;
-            HANDLE hff = FindFirstFileW(buffer, &fd);
-            size_t insert_pos = (wcsrchr(buffer, L'\\') ? wcsrchr(buffer, L'\\') + 1 - buffer : 0);
+            HANDLE hff;
+            size_t insert_pos;
+            BOOL quoted = FALSE;
+
+            /* Stained Glass OS (wine-sg 7005): a quoted element ("C:\Program Files\x*") is
+             * searched without its quotes, and what it finds is quoted again, as cmd does */
+#ifndef SG_MUTANT_FOR_QUOTED_WILDCARD
+            if (buffer[len] == L'"')
+            {
+                size_t blen = wcslen(buffer);
+                quoted = TRUE;
+                memmove(&buffer[len], &buffer[len + 1], (blen - len) * sizeof(WCHAR));
+                blen--;
+                if (blen > len && buffer[blen - 1] == L'"') buffer[--blen] = 0;
+            }
+#endif
+            hff = FindFirstFileW(buffer, &fd);
+            insert_pos = (wcsrchr(buffer, L'\\') ? wcsrchr(buffer, L'\\') + 1 - buffer : 0);
 
             if (hff == INVALID_HANDLE_VALUE)
             {
@@ -3607,7 +3623,15 @@ static RETURN_CODE for_control_execute_set(CMD_FOR_CONTROL *for_ctrl, const WCHA
 
                 if (insert_pos + wcslen(fd.cFileName) + 1 >= ARRAY_SIZE(buffer)) continue;
                 wcscpy(&buffer[insert_pos], fd.cFileName);
-                WCMD_set_for_loop_variable(for_ctrl->variable_index, buffer);
+                if (quoted)
+                {
+                    WCHAR quoted_name[MAX_PATH + 2];
+
+                    if (wcslen(buffer) + 3 > ARRAY_SIZE(quoted_name)) continue;
+                    swprintf(quoted_name, ARRAY_SIZE(quoted_name), L"\"%s\"", buffer);
+                    WCMD_set_for_loop_variable(for_ctrl->variable_index, quoted_name);
+                }
+                else WCMD_set_for_loop_variable(for_ctrl->variable_index, buffer);
                 return_code = node_execute(node);
             } while (return_code != RETURN_CODE_ABORTED && FindNextFileW(hff, &fd) != 0);
             FindClose(hff);
