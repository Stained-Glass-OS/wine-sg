From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winmm: mixerOpen event/thread callbacks, midiStream SMPTE positions and 64KB limit

- mixerOpen accepts CALLBACK_EVENT and CALLBACK_THREAD (an error only on
  Win9x). Nothing changes a mixer behind the application's back here, so the
  callback is never signalled (the mixer test checks the event stays unset).
- midiStreamPosition: TIME_SMPTE is answered in SMPTE (hours/minutes/seconds/
  frames with the frame rate of the stream's SMPTE time division) when the
  stream has a SMPTE division; a ticks-per-beat stream converts it to
  milliseconds like the other unsupported types.
- midiOutPrepareHeader on a stream handle refuses buffers over 64KB with
  MMSYSERR_INVALPARAM.
- MMSYSTEM_GetMidiStream clears its result when the stream is not found.
midiConnect/midiDisconnect stay as they are: connecting needs the callbacks
of a MIDI input to be interposed in midiInOpen, which the drivers copy at open.

---
diff --git a/dlls/winmm/tests/midi.c b/dlls/winmm/tests/midi.c
index 70a5375..e3515de 100644
--- a/dlls/winmm/tests/midi.c
+++ b/dlls/winmm/tests/midi.c
@@ -816,7 +816,7 @@ static void test_midiStream(UINT udev, HWND hwnd)
         mhdr.dwFlags = 0;
         /* PrepareHeader detects the too large buffer is for a stream. */
         rc = midiOutPrepareHeader((HMIDIOUT)hm, &mhdr, sizeof(mhdr));
-        todo_wine ok(rc==MMSYSERR_INVALPARAM, "midiOutPrepare stream too large rc=%s\n", mmsys_error(rc));
+        ok(rc==MMSYSERR_INVALPARAM, "midiOutPrepare stream too large rc=%s\n", mmsys_error(rc));
 
         rc = midiOutUnprepareHeader((HMIDIOUT)hm, &mhdr, sizeof(mhdr));
         ok(!rc, "midiOutUnprepare rc=%s\n", mmsys_error(rc));
@@ -962,7 +962,7 @@ static void test_midiStream(UINT udev, HWND hwnd)
     test_position(hm, TIME_MS,      TIME_MS);
     test_position(hm, TIME_TICKS,   TIME_TICKS);
     test_position(hm, TIME_MIDI,    TIME_MS);
-    todo_wine test_position(hm, TIME_SMPTE,   TIME_SMPTE);
+    test_position(hm, TIME_SMPTE,   TIME_SMPTE);
     test_position(hm, TIME_SAMPLES, TIME_MS);
     test_position(hm, TIME_BYTES,   TIME_MS);
 
diff --git a/dlls/winmm/tests/mixer.c b/dlls/winmm/tests/mixer.c
index a515214..21902d2 100644
--- a/dlls/winmm/tests/mixer.c
+++ b/dlls/winmm/tests/mixer.c
@@ -1080,9 +1080,7 @@ static void test_mixerOpen(void)
 
         event = CreateEventW(NULL, FALSE, FALSE, NULL);
 
-        /* NOTSUPPORTED is not broken, but it enables the todo_wine marker. */
         rc = mixerOpen(&mix, d, (DWORD_PTR)event, 0, CALLBACK_EVENT);
-        todo_wine
         ok(rc == MMSYSERR_NOERROR /* since w2k */ ||
            broken(rc == MMSYSERR_NOTSUPPORTED), /* 98 */
            "mixerOpen: MMSYSERR_NOERROR expected, got %s\n",
diff --git a/dlls/winmm/winmm.c b/dlls/winmm/winmm.c
index cd26e4e..1d6b072 100644
--- a/dlls/winmm/winmm.c
+++ b/dlls/winmm/winmm.c
@@ -180,8 +180,12 @@ MMRESULT WINMM_CheckCallback(DWORD_PTR dwCallback, DWORD fdwOpen, BOOL mixer)
         break;
     case CALLBACK_THREAD:
     case CALLBACK_EVENT:
-        if (mixer) /* FIXME: mixer supports THREAD+EVENT since w2k */
-            return MMSYSERR_NOTSUPPORTED; /* w9X */
+#ifdef SG_MUTANT_WINMM_MIXER_CB
+        if (mixer) return MMSYSERR_NOTSUPPORTED;
+#endif
+        /* a mixer accepts THREAD and EVENT since w2k (MMSYSERR_NOTSUPPORTED on
+         * w9X); nothing changes a mixer behind the application's back here, so
+         * the callback is never signalled */
         break;
     default:
         WARN("Unknown callback type %d\n", HIWORD(fdwOpen));
@@ -413,6 +417,8 @@ static	LPWINE_MIDI	MIDI_OutAlloc(HMIDIOUT* lphMidiOut, DWORD_PTR* lpdwCallback,
     return lpwm;
 }
 
+static BOOL MMSYSTEM_IsMidiStream(HMIDIOUT hMidiOut);
+
 /**************************************************************************
  * 				midiOutOpen    		[WINMM.@]
  */
@@ -483,7 +489,15 @@ UINT WINAPI midiOutPrepareHeader(HMIDIOUT hMidiOut,
 
     if ((wmld = MMDRV_Get(hMidiOut, MMDRV_MIDIOUT, FALSE)) == NULL)
 	return MMSYSERR_INVALHANDLE;
-    /* FIXME: detect MIDIStream handles and enforce 64KB buffer limit on those */
+    /* the buffers of a stream are limited to 64KB */
+    if (lpMidiOutHdr && uSize >= offsetof(MIDIHDR, dwOffset) &&
+        MMSYSTEM_IsMidiStream(hMidiOut) &&
+#ifdef SG_MUTANT_WINMM_MIDI_STREAMBUF
+        0)
+#else
+        lpMidiOutHdr->dwBufferLength > 65535)
+#endif
+	return MMSYSERR_INVALPARAM;
 
     return MMDRV_Message(wmld, MODM_PREPARE, (DWORD_PTR)lpMidiOutHdr, uSize);
 }
@@ -1007,6 +1021,7 @@ static	BOOL	MMSYSTEM_GetMidiStream(HMIDISTRM hMidiStrm, WINE_MIDIStream** lpMidi
     WINE_MIDI* lpwm = (LPWINE_MIDI)MMDRV_Get(hMidiStrm, MMDRV_MIDIOUT, FALSE);
     struct wine_rb_entry *entry;
 
+    *lpMidiStrm = NULL;
     if (lplpwm)
 	*lplpwm = lpwm;
 
@@ -1022,6 +1037,12 @@ static	BOOL	MMSYSTEM_GetMidiStream(HMIDISTRM hMidiStrm, WINE_MIDIStream** lpMidi
     return *lpMidiStrm != NULL;
 }
 
+static BOOL MMSYSTEM_IsMidiStream(HMIDIOUT hMidiOut)
+{
+    WINE_MIDIStream* strm;
+    return MMSYSTEM_GetMidiStream((HMIDISTRM)hMidiOut, &strm, NULL);
+}
+
 /**************************************************************************
  * 				MMSYSTEM_MidiStream_Convert	[internal]
  */
@@ -1598,6 +1619,34 @@ MMRESULT WINAPI midiStreamPosition(HMIDISTRM hMidiStrm, LPMMTIME lpMMT, UINT cbm
 	    lpMMT->u.ticks = midistream_get_current_pulse(lpMidiStrm);
 	    TRACE("=> %ld ticks\n", lpMMT->u.ticks);
 	    break;
+	case TIME_SMPTE:
+	    /* only a stream with a SMPTE time division reports SMPTE time */
+#ifdef SG_MUTANT_WINMM_MIDI_SMPTE
+	    if (1) {
+#else
+	    if (!(lpMidiStrm->dwTimeDiv & 0x8000)) {
+#endif
+		lpMMT->wType = TIME_MS;
+		lpMMT->u.ms = midistream_get_playing_position(lpMidiStrm);
+		TRACE("=> %ld ms\n", lpMMT->u.ms);
+		break;
+	    }
+	    {
+		DWORD ms = midistream_get_playing_position(lpMidiStrm), fps;
+
+		/* negative frames per second in the high byte */
+		fps = -(signed char)HIBYTE(lpMidiStrm->dwTimeDiv);
+		if (fps != 24 && fps != 25 && fps != 29 && fps != 30) fps = 30;
+		lpMMT->u.smpte.hour  = ms / 3600000;
+		lpMMT->u.smpte.min   = ms / 60000 % 60;
+		lpMMT->u.smpte.sec   = ms / 1000 % 60;
+		lpMMT->u.smpte.frame = (ms % 1000) * fps / 1000;
+		lpMMT->u.smpte.fps   = fps;
+		lpMMT->u.smpte.dummy = 0;
+		TRACE("=> smpte %02u:%02u:%02u.%02u/%u\n", lpMMT->u.smpte.hour, lpMMT->u.smpte.min,
+		      lpMMT->u.smpte.sec, lpMMT->u.smpte.frame, lpMMT->u.smpte.fps);
+	    }
+	    break;
 	default:
 	    FIXME("Unsupported time type %x\n", lpMMT->wType);
 	    /* use TIME_MS instead */
