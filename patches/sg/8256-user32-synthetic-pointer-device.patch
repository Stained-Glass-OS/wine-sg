From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: synthetic pointer devices

CreateSyntheticPointerDevice makes a touch (up to 256 contacts) or pen (one) device, DestroySyntheticPointerDevice ends it and InjectSyntheticPointerInput injects contacts. There is no pointer message stream for injected input here, so the primary contact is delivered as Windows promotes an unhandled touch or pen contact: a mouse move to it, the left button down when it touches and up when it lifts. Create was a stub; Destroy and Inject were not exported (Firefox and Thunderbird import them).
---
--- a/dlls/user32/input.c
+++ b/dlls/user32/input.c
@@ -1062,9 +1062,159 @@
     return NtUserGetTaskmanWindow();
 }
 
+#ifndef SG_MUTANT_NO_SYNTH_POINTER
+/* (wine-sg 8256) Synthetic pointer devices: injected touch or pen contacts. There is no pointer message
+ * stream for injected input here, so the primary contact is delivered the way Windows promotes a touch or pen
+ * contact for programs that do not handle pointer messages: as the mouse (move, left button down while in
+ * contact, up when it lifts). */
+struct synthetic_pointer_device
+{
+    DWORD magic;
+    POINTER_INPUT_TYPE type;
+    ULONG max_count;
+    BOOL down;
+};
+#define SYNTHETIC_POINTER_MAGIC 0x53504456 /* 'SPDV' */
+
+static struct synthetic_pointer_device *synthetic_pointer_devices[64];
+static CRITICAL_SECTION synthetic_pointer_section;
+static CRITICAL_SECTION_DEBUG synthetic_pointer_section_debug =
+{
+    0, 0, &synthetic_pointer_section,
+    { &synthetic_pointer_section_debug.ProcessLocksList, &synthetic_pointer_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": synthetic_pointer_section") }
+};
+static CRITICAL_SECTION synthetic_pointer_section = { &synthetic_pointer_section_debug, -1, 0, 0, 0, 0 };
+
+HSYNTHETICPOINTERDEVICE WINAPI CreateSyntheticPointerDevice(POINTER_INPUT_TYPE type, ULONG max_count, POINTER_FEEDBACK_MODE mode)
+{
+    struct synthetic_pointer_device *device;
+
+    TRACE( "type %ld, max_count %ld, mode %d\n", type, max_count, mode );
+
+    if ((type != PT_TOUCH && type != PT_PEN) || !max_count || max_count > (type == PT_PEN ? 1 : 256) ||
+        mode < POINTER_FEEDBACK_DEFAULT || mode > POINTER_FEEDBACK_NONE)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (!(device = calloc( 1, sizeof(*device) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    device->magic = SYNTHETIC_POINTER_MAGIC;
+    device->type = type;
+    device->max_count = max_count;
+    {
+        unsigned int i;
+
+        EnterCriticalSection( &synthetic_pointer_section );
+        for (i = 0; i < ARRAY_SIZE(synthetic_pointer_devices); i++)
+            if (!synthetic_pointer_devices[i]) { synthetic_pointer_devices[i] = device; break; }
+        LeaveCriticalSection( &synthetic_pointer_section );
+        if (i == ARRAY_SIZE(synthetic_pointer_devices))
+        {
+            free( device );
+            SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+            return NULL;
+        }
+    }
+    return (HSYNTHETICPOINTERDEVICE)device;
+}
+
+/* a handle CreateSyntheticPointerDevice gave out and nobody destroyed */
+static struct synthetic_pointer_device *synthetic_pointer_device( HSYNTHETICPOINTERDEVICE handle )
+{
+    struct synthetic_pointer_device *device = NULL;
+    unsigned int i;
+
+    if (!handle) return NULL;
+    EnterCriticalSection( &synthetic_pointer_section );
+    for (i = 0; i < ARRAY_SIZE(synthetic_pointer_devices); i++)
+        if (synthetic_pointer_devices[i] == (struct synthetic_pointer_device *)handle) device = synthetic_pointer_devices[i];
+    LeaveCriticalSection( &synthetic_pointer_section );
+    return device;
+}
+
+/***********************************************************************
+ *              DestroySyntheticPointerDevice (USER32.@)
+ */
+void WINAPI DestroySyntheticPointerDevice( HSYNTHETICPOINTERDEVICE handle )
+{
+    struct synthetic_pointer_device *device = synthetic_pointer_device( handle );
+
+    unsigned int i;
+
+    TRACE( "%p\n", handle );
+    if (!device) return;
+    EnterCriticalSection( &synthetic_pointer_section );
+    for (i = 0; i < ARRAY_SIZE(synthetic_pointer_devices); i++)
+        if (synthetic_pointer_devices[i] == device) synthetic_pointer_devices[i] = NULL;
+    LeaveCriticalSection( &synthetic_pointer_section );
+    free( device );
+}
+
+/***********************************************************************
+ *              InjectSyntheticPointerInput (USER32.@)
+ */
+BOOL WINAPI InjectSyntheticPointerInput( HSYNTHETICPOINTERDEVICE handle, const POINTER_TYPE_INFO *info, UINT32 count )
+{
+    struct synthetic_pointer_device *device = synthetic_pointer_device( handle );
+    INPUT input[2];
+    UINT32 i;
+
+    TRACE( "%p, %p, %u\n", handle, info, count );
+
+    if (!device || !info || !count || count > device->max_count)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (info[i].type != device->type)
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return FALSE;
+        }
+    }
+    for (i = 0; i < count; i++)
+    {
+        const POINTER_INFO *pointer = info[i].type == PT_TOUCH ? &info[i].touchInfo.pointerInfo : &info[i].penInfo.pointerInfo;
+        int x0 = GetSystemMetrics( SM_XVIRTUALSCREEN ), y0 = GetSystemMetrics( SM_YVIRTUALSCREEN );
+        int cx = max( 1, GetSystemMetrics( SM_CXVIRTUALSCREEN ) - 1 ), cy = max( 1, GetSystemMetrics( SM_CYVIRTUALSCREEN ) - 1 );
+        UINT n = 1;
+
+        if (count > 1 && !(pointer->pointerFlags & POINTER_FLAG_PRIMARY)) continue;
+        memset( input, 0, sizeof(input) );
+        input[0].type = INPUT_MOUSE;
+        input[0].mi.dx = MulDiv( pointer->ptPixelLocation.x - x0, 65535, cx );
+        input[0].mi.dy = MulDiv( pointer->ptPixelLocation.y - y0, 65535, cy );
+        input[0].mi.dwFlags = MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_VIRTUALDESK;
+        input[1] = input[0];
+        if ((pointer->pointerFlags & POINTER_FLAG_DOWN) && !device->down)
+        {
+            input[1].mi.dwFlags = MOUSEEVENTF_LEFTDOWN | MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_VIRTUALDESK;
+            device->down = TRUE;
+            n = 2;
+        }
+        else if ((pointer->pointerFlags & POINTER_FLAG_UP) && device->down)
+        {
+            input[1].mi.dwFlags = MOUSEEVENTF_LEFTUP | MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_VIRTUALDESK;
+            device->down = FALSE;
+            n = 2;
+        }
+        if (NtUserSendInput( n, input, sizeof(INPUT) ) != n) return FALSE;
+    }
+    return TRUE;
+}
+#else
 HSYNTHETICPOINTERDEVICE WINAPI CreateSyntheticPointerDevice(POINTER_INPUT_TYPE type, ULONG max_count, POINTER_FEEDBACK_MODE mode)
 {
-    FIXME( "type %ld, max_count %ld, mode %d stub!\n", type, max_count, mode);
     SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
     return NULL;
 }
+void WINAPI DestroySyntheticPointerDevice( HSYNTHETICPOINTERDEVICE handle ) { }
+BOOL WINAPI InjectSyntheticPointerInput( HSYNTHETICPOINTERDEVICE handle, const POINTER_TYPE_INFO *info, UINT32 count ) { return FALSE; }
+#endif
--- a/dlls/user32/user32.spec
+++ b/dlls/user32/user32.spec
@@ -399,7 +399,7 @@
 @ stdcall DestroyIcon(long)
 @ stdcall DestroyMenu(long) NtUserDestroyMenu
 # @ stub DestroyReasons
-# @ stub DestroySyntheticPointerDevice
+@ stdcall DestroySyntheticPointerDevice(ptr)
 @ stdcall DestroyWindow(long) NtUserDestroyWindow
 @ stdcall DialogBoxIndirectParamA(long ptr long ptr long)
 @ stdcall DialogBoxIndirectParamAorW(long ptr long ptr long long)
@@ -755,7 +755,7 @@
 # @ stub InjectKeyboardInput
 # @ stub InjectMouseInput
 # @ stub InjectPointerInput
-# @ stub InjectSyntheticPointerInput
+@ stdcall InjectSyntheticPointerInput(ptr ptr long)
 # @ stub InjectTouchInput
 # @ stub InputSpaceRegionFromPoint
 @ stdcall InsertMenuA(long long long long ptr)
