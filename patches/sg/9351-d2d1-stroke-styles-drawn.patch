+/* wine-sg 9351: an open run of points (a whole open figure, or one dash) with its joins and the caps at
+ * its two ends; a run of one point is a dot (a dash of no length), which only its caps draw, turned the
+ * way (dx, dy) of the segment it lies on. */
+static void widen_run(struct widen_output *out, const D2D1_POINT_2F *pts, size_t n, double dx, double dy,
+        float hw, D2D1_CAP_STYLE start_cap, D2D1_CAP_STYLE end_cap, const D2D1_STROKE_STYLE_PROPERTIES *props,
+        float tolerance)
+{
+    double sx = 0.0, sy = 0.0, ex = 0.0, ey = 0.0;
+    BOOL first = TRUE;
+    size_t j;
+
+    for (j = 0; j + 1 < n; ++j)
+    {
+        D2D1_POINT_2F a = pts[j], b = pts[j + 1], q[4];
+        double ux = b.x - a.x, uy = b.y - a.y, len = sqrt(ux * ux + uy * uy);
+
+        if (len < 1e-9)
+            continue;
+        ux /= len;
+        uy /= len;
+        q[0].x = a.x - uy * hw; q[0].y = a.y + ux * hw;
+        q[1].x = b.x - uy * hw; q[1].y = b.y + ux * hw;
+        q[2].x = b.x + uy * hw; q[2].y = b.y - ux * hw;
+        q[3].x = a.x + uy * hw; q[3].y = a.y - ux * hw;
+        widen_polygon(out, q, 4);
+        if (first)
+        {
+            sx = ux;
+            sy = uy;
+            first = FALSE;
+        }
+        else
+            widen_join(out, a, ex, ey, ux, uy, hw, props->lineJoin, props->miterLimit, tolerance);
+        ex = ux;
+        ey = uy;
+    }
+    if (first)
+    {
+        /* no length: a dot, turned along its segment */
+        if (!n)
+            return;
+        sx = ex = dx;
+        sy = ey = dy;
+        widen_cap(out, pts[0], -sx, -sy, hw, start_cap, tolerance);
+        widen_cap(out, pts[n - 1], ex, ey, hw, end_cap, tolerance);
+        return;
+    }
+    widen_cap(out, pts[0], -sx, -sy, hw, start_cap, tolerance);
+    widen_cap(out, pts[n - 1], ex, ey, hw, end_cap, tolerance);
+}
+
+static BOOL widen_run_add(D2D1_POINT_2F **run, size_t *count, size_t *size, D2D1_POINT_2F p)
+{
+    if (*count && (*run)[*count - 1].x == p.x && (*run)[*count - 1].y == p.y)
+        return TRUE;
+    if (!d2d_array_reserve((void **)run, size, *count + 1, sizeof(**run)))
+        return FALSE;
+    (*run)[(*count)++] = p;
+    return TRUE;
+}
+
+/* wine-sg 9351: a figure cut into dashes. The pattern is in stroke widths and starts dash_offset stroke
+ * widths in; a dash's ends get the dash cap, except where it starts or ends with an open figure, which
+ * get the figure's start and end caps. On a closed figure a dash running through the start continues
+ * into the dash that starts there, with a join. */
+static HRESULT widen_dashed_figure(struct widen_output *out, const struct widen_figure *f, float hw,
+        const D2D1_STROKE_STYLE_PROPERTIES *props, const float *pattern, UINT32 pattern_count, float stroke_width,
+        float tolerance)
+{
+    D2D1_POINT_2F *run = NULL, *first_run = NULL;
+    size_t run_count = 0, run_size = 0, first_count = 0, n = f->count, segments, j;
+    double total = 0.0, pos, left, dx = 1.0, dy = 0.0, fdx = 1.0, fdy = 0.0;
+    BOOL on, started_on, first_open = FALSE, at_start = TRUE;
+    UINT32 idx = 0, k;
+
+    for (k = 0; k < pattern_count; ++k)
+        total += max(pattern[k], 0.0f) * stroke_width;
+    if (total <= 1e-9 || pattern_count < 2)
+        return S_FALSE;
+
+    if (f->closed && n > 1 && f->points[n - 1].x == f->points[0].x && f->points[n - 1].y == f->points[0].y)
+        --n;
+    segments = f->closed ? n : n - 1;
+
+    /* where in the pattern the figure starts */
+    pos = fmod(props->dashOffset * stroke_width, total);
+    if (pos < 0.0)
+        pos += total;
+    while (pos >= max(pattern[idx], 0.0f) * stroke_width && pos > 0.0)
+    {
+        pos -= max(pattern[idx], 0.0f) * stroke_width;
+        idx = (idx + 1) % pattern_count;
+    }
+    left = max(pattern[idx], 0.0f) * stroke_width - pos;
+    on = !(idx & 1);
+    started_on = on;
+
+    if (on && !widen_run_add(&run, &run_count, &run_size, f->points[0]))
+        goto oom;
+
+    for (j = 0; j < segments; ++j)
+    {
+        D2D1_POINT_2F a = f->points[j], b = f->points[(j + 1) % n];
+        double ux = b.x - a.x, uy = b.y - a.y, len = sqrt(ux * ux + uy * uy), t = 0.0;
+
+        if (len < 1e-9)
+            continue;
+        ux /= len;
+        uy /= len;
+        dx = ux;
+        dy = uy;
+        if (j == 0)
+        {
+            fdx = ux;
+            fdy = uy;
+        }
+        for (;;)
+        {
+            D2D1_POINT_2F p;
+
+            if (left > len - t)
+            {
+                left -= len - t;
+                if (on && !widen_run_add(&run, &run_count, &run_size, b))
+                    goto oom;
+                break;
+            }
+            t += left;
+            p.x = a.x + ux * t;
+            p.y = a.y + uy * t;
+            if (on)
+            {
+                /* a dash ends */
+                if (!widen_run_add(&run, &run_count, &run_size, p))
+                    goto oom;
+                if (at_start && f->closed && started_on)
+                {
+                    /* kept: it may continue the dash that runs into the start */
+                    first_run = run;
+                    first_count = run_count;
+                    first_open = TRUE;
+                    run = NULL;
+                    run_size = 0;
+                }
+                else
+                {
+                    widen_run(out, run, run_count, ux, uy, hw,
+                            at_start && started_on && !f->closed ? props->startCap : props->dashCap,
+                            props->dashCap, props, tolerance);
+                }
+                run_count = 0;
+                at_start = FALSE;
+            }
+            else
+            {
+                /* a dash starts */
+                run_count = 0;
+                if (!widen_run_add(&run, &run_count, &run_size, p))
+                    goto oom;
+                if (at_start && !started_on)
+                    at_start = FALSE;
+            }
+            on = !on;
+            idx = (idx + 1) % pattern_count;
+            left = max(pattern[idx], 0.0f) * stroke_width;
+            /* a dash of no length is a dot at p */
+            if (on && left <= 0.0)
+            {
+                widen_run(out, &p, 1, ux, uy, hw, props->dashCap, props->dashCap, props, tolerance);
+                on = FALSE;
+                idx = (idx + 1) % pattern_count;
+                left = max(pattern[idx], 0.0f) * stroke_width;
+            }
+            if (left <= 0.0 && !on)
+            {
+                /* a gap of no length: the next dash starts here too */
+                on = TRUE;
+                idx = (idx + 1) % pattern_count;
+                left = max(pattern[idx], 0.0f) * stroke_width;
+                run_count = 0;
+                if (!widen_run_add(&run, &run_count, &run_size, p))
+                    goto oom;
+            }
+        }
+    }
+
+    /* the dash still open at the end of the figure */
+    if (on && run_count)
+    {
+        if (first_open)
+        {
+            /* closed figure: it runs on into the first dash */
+            for (k = 0; k < first_count; ++k)
+                if (!widen_run_add(&run, &run_count, &run_size, first_run[k]))
+                    goto oom;
+            widen_run(out, run, run_count, dx, dy, hw, props->dashCap, props->dashCap, props, tolerance);
+            first_open = FALSE;
+        }
+        else
+            widen_run(out, run, run_count, dx, dy, hw, at_start && started_on ? props->startCap : props->dashCap,
+                    f->closed ? props->dashCap : props->endCap, props, tolerance);
+    }
+    else if (on && !run_count && !f->closed)
+    {
+        /* a dash starting exactly at the end of an open figure */
+        widen_run(out, &f->points[n - 1], 1, dx, dy, hw, props->dashCap, props->endCap, props, tolerance);
+    }
+    if (first_open)
+        widen_run(out, first_run, first_count, fdx, fdy, hw, props->dashCap, props->dashCap, props, tolerance);
+
+    free(run);
+    free(first_run);
+    return out->hr;
+
+oom:
+    free(run);
+    free(first_run);
+    return E_OUTOFMEMORY;
+}
+
 HRESULT d2d_geometry_widen(ID2D1Geometry *geometry, float stroke_width, ID2D1StrokeStyle *stroke_style,
         const D2D1_MATRIX_3X2_F *transform, float tolerance, ID2D1SimplifiedGeometrySink *sink)
 {
@@ -722,7 +942,8 @@
     struct widen_output out = { 0 };
     D2D1_STROKE_STYLE_PROPERTIES props = { D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT,
                                            D2D1_LINE_JOIN_MITER, 10.0f, D2D1_DASH_STYLE_SOLID, 0.0f };
-    float hw = stroke_width / 2.0f;
+    float hw = stroke_width / 2.0f, *pattern = NULL;
+    UINT32 pattern_count = 0;
     size_t i, j;
     HRESULT hr;
 
@@ -734,8 +955,19 @@
     {
         props.startCap = ID2D1StrokeStyle_GetStartCap(stroke_style);
         props.endCap = ID2D1StrokeStyle_GetEndCap(stroke_style);
+        props.dashCap = ID2D1StrokeStyle_GetDashCap(stroke_style);
         props.lineJoin = ID2D1StrokeStyle_GetLineJoin(stroke_style);
         props.miterLimit = ID2D1StrokeStyle_GetMiterLimit(stroke_style);
+        props.dashStyle = ID2D1StrokeStyle_GetDashStyle(stroke_style);
+        props.dashOffset = ID2D1StrokeStyle_GetDashOffset(stroke_style);
+#ifndef SG_MUTANT_D2D_NO_DASHES
+        if (props.dashStyle != D2D1_DASH_STYLE_SOLID && (pattern_count = ID2D1StrokeStyle_GetDashesCount(stroke_style)))
+        {
+            if (!(pattern = malloc(pattern_count * sizeof(*pattern))))
+                return E_OUTOFMEMORY;
+            ID2D1StrokeStyle_GetDashes(stroke_style, pattern, pattern_count);
+        }
+#endif
     }
 
     if (FAILED(hr = ID2D1Geometry_Simplify(geometry, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_LINES, transform,
@@ -756,6 +988,13 @@
                 widen_cap(&out, f->points[0], 1.0, 0.0, hw, props.startCap, tolerance);
             continue;
         }
+        if (pattern_count)
+        {
+            if (FAILED(hr = widen_dashed_figure(&out, f, hw, &props, pattern, pattern_count, stroke_width, tolerance)))
+                goto done;
+            if (hr == S_OK)
+                continue;
+        }
         if (f->closed && f->points[n - 1].x == f->points[0].x && f->points[n - 1].y == f->points[0].y)
             --n;
         segments = f->closed ? n : n - 1;
@@ -795,6 +1034,7 @@
             D2D1_COMBINE_MODE_UNION, sink);
 
 done:
+    free(pattern);
     for (i = 0; i < input.figure_count; ++i)
         free(input.figures[i].points);
     free(input.figures);
