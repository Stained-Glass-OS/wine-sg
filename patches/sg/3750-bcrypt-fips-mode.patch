From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: BCryptGetFipsAlgorithmMode reads the FIPS policy (3750)

bcrypt: BCryptGetFipsAlgorithmMode reads the FIPS policy

Reads FipsAlgorithmPolicy\Enabled (or the older Lsa value) instead of always
answering that FIPS mode is off.
---
diff --git a/dlls/bcrypt/bcrypt_main.c b/dlls/bcrypt/bcrypt_main.c
index 8078ed6..dfe8679 100644
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -25,6 +25,7 @@
 #define WIN32_NO_STATUS
 #include "windef.h"
 #include "winbase.h"
+#include "winreg.h"
 #include "ntsecapi.h"
 #include "wincrypt.h"
 #include "winternl.h"
@@ -366,14 +367,35 @@ NTSTATUS WINAPI BCryptCloseAlgorithmProvider( BCRYPT_ALG_HANDLE handle, DWORD fl
     return STATUS_SUCCESS;
 }
 
+/* the FIPS policy: HKLM\System\CurrentControlSet\Control\Lsa\FipsAlgorithmPolicy\Enabled (Vista and later), else
+ * the value FIPSAlgorithmPolicy of the Lsa key (XP); not set means off */
+static BOOL read_fips_policy( HKEY root, const WCHAR *subkey, const WCHAR *name, DWORD *value )
+{
+    DWORD size = sizeof(DWORD), type, data = 0;
+    HKEY key;
+    BOOL ret;
+
+    if (RegOpenKeyExW( root, subkey, 0, KEY_QUERY_VALUE, &key )) return FALSE;
+    ret = !RegQueryValueExW( key, name, NULL, &type, (BYTE *)&data, &size ) && type == REG_DWORD && size == sizeof(DWORD);
+    RegCloseKey( key );
+    if (ret) *value = data;
+    return ret;
+}
+
 NTSTATUS WINAPI BCryptGetFipsAlgorithmMode(BOOLEAN *enabled)
 {
-    FIXME("%p - semi-stub\n", enabled);
+    static const WCHAR vista_key[] = L"System\\CurrentControlSet\\Control\\Lsa\\FipsAlgorithmPolicy";
+    static const WCHAR lsa_key[] = L"System\\CurrentControlSet\\Control\\Lsa";
+    DWORD value = 0;
+
+    TRACE("%p\n", enabled);
 
     if (!enabled)
         return STATUS_INVALID_PARAMETER;
 
-    *enabled = FALSE;
+    if (!read_fips_policy( HKEY_LOCAL_MACHINE, vista_key, L"Enabled", &value ))
+        read_fips_policy( HKEY_LOCAL_MACHINE, lsa_key, L"FIPSAlgorithmPolicy", &value );
+    *enabled = !!value;
     return STATUS_SUCCESS;
 }
 
