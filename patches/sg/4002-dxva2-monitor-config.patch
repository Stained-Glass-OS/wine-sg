+/* The monitor a device presents on. */
+static HMONITOR monitor_from_device( IDirect3DDevice9 *device )
+{
+    D3DDEVICE_CREATION_PARAMETERS params;
+    HMONITOR monitor = NULL;
+    IDirect3D9 *d3d;
+
+    if (FAILED(IDirect3DDevice9_GetCreationParameters(device, &params)))
+        return NULL;
+    if (SUCCEEDED(IDirect3DDevice9_GetDirect3D(device, &d3d)))
+    {
+        monitor = IDirect3D9_GetAdapterMonitor(d3d, params.AdapterOrdinal);
+        IDirect3D9_Release(d3d);
+    }
+    return monitor;
 }
 
