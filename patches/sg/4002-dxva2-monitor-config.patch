-BOOL WINAPI DegaussMonitor( HMONITOR monitor )
+/* Physical monitors. Each HMONITOR has one physical monitor; its handle is
+ * kept in a table until DestroyPhysicalMonitor(). There is no DDC/CI link to
+ * the monitors here, so every monitor setting call fails the way it does on a
+ * monitor without an I2C bus. */
+
+#ifndef ERROR_GRAPHICS_INVALID_PHYSICAL_MONITOR_HANDLE
+#define ERROR_GRAPHICS_INVALID_PHYSICAL_MONITOR_HANDLE _HRESULT_TYPEDEF_(0xC026258B)
+#endif
+
+struct physical_monitor
+{
+    HANDLE handle;
+    HMONITOR monitor;
+};
+
+static struct physical_monitor *physical_monitors;
+static size_t physical_monitor_count, physical_monitor_capacity;
+static UINT_PTR next_physical_monitor = 1;
+
+static CRITICAL_SECTION monitors_cs;
+static CRITICAL_SECTION_DEBUG monitors_cs_debug =
 {
-    FIXME("(%p): stub\n", monitor);
+    0, 0, &monitors_cs,
+    { &monitors_cs_debug.ProcessLocksList, &monitors_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": monitors_cs") }
+};
+static CRITICAL_SECTION monitors_cs = { &monitors_cs_debug, -1, 0, 0, 0, 0 };
+
+static BOOL physical_monitor_valid(HANDLE handle)
+{
+    BOOL found = FALSE;
+    size_t i;
 
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    EnterCriticalSection(&monitors_cs);
+    for (i = 0; i < physical_monitor_count && !found; ++i)
+        found = physical_monitors[i].handle == handle;
+    LeaveCriticalSection(&monitors_cs);
+
+    return found;
+}
+
+/* The DDC/CI calls: a valid handle still has no channel to the monitor. */
+static BOOL monitor_no_ddcci(HANDLE handle)
+{
+    if (!physical_monitor_valid(handle))
+        SetLastError(ERROR_GRAPHICS_INVALID_PHYSICAL_MONITOR_HANDLE);
+    else
+        SetLastError(ERROR_GRAPHICS_I2C_NOT_SUPPORTED);
     return FALSE;
 }
 
+BOOL WINAPI CapabilitiesRequestAndCapabilitiesReply( HMONITOR monitor, LPSTR buffer, DWORD length )
+{
+    TRACE("%p, %p, %ld.\n", monitor, buffer, length);
+
+    return monitor_no_ddcci(monitor);
+}
+
+BOOL WINAPI DegaussMonitor( HMONITOR monitor )
+{
+    TRACE("(%p)\n", monitor);
+
+    return monitor_no_ddcci(monitor);
+}
+
 BOOL WINAPI DestroyPhysicalMonitor( HMONITOR monitor )
 {
-    FIXME("(%p): stub\n", monitor);
+    BOOL found = FALSE;
+    size_t i;
 
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    TRACE("(%p)\n", monitor);
+
+    EnterCriticalSection(&monitors_cs);
+    for (i = 0; i < physical_monitor_count; ++i)
+    {
+        if (physical_monitors[i].handle != monitor)
+            continue;
+        physical_monitors[i] = physical_monitors[--physical_monitor_count];
+        found = TRUE;
+        break;
+    }
+    LeaveCriticalSection(&monitors_cs);
+
+    if (!found)
+        SetLastError(ERROR_GRAPHICS_INVALID_PHYSICAL_MONITOR_HANDLE);
+    return found;
 }
 
 BOOL WINAPI DestroyPhysicalMonitors( DWORD arraySize, LPPHYSICAL_MONITOR array )
 {
-    FIXME("%lu, %p: stub.\n", arraySize, array);
+    BOOL ret = TRUE;
+    DWORD i;
 
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    TRACE("%lu, %p.\n", arraySize, array);
+
+    if (!arraySize || !array)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    for (i = 0; i < arraySize; ++i)
+        if (!DestroyPhysicalMonitor(array[i].hPhysicalMonitor))
+            ret = FALSE;
+    return ret;
 }
 
