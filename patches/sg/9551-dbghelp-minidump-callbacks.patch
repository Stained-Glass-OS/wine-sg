+/* Stained Glass OS: a MiniDumpWriteDump callback, with the process the way
+ * Windows names it for each type */
+static BOOL dump_callback(struct dump_context* dc, ULONG type, MINIDUMP_CALLBACK_INPUT* in, MINIDUMP_CALLBACK_OUTPUT* out)
+{
+    if (!dc->cb || !dc->cb->CallbackRoutine) return FALSE;
+    in->CallbackType = type;
+    switch (type)
+    {
+    case IoStartCallback:
+    case IoWriteAllCallback:
+    case IoFinishCallback:
+    case WriteKernelMinidumpCallback:
+        in->ProcessId = 0;
+        in->ProcessHandle = NULL;
+        break;
+    case IsProcessSnapshotCallback:
+    case VmStartCallback:
+        in->ProcessId = 0;
+        in->ProcessHandle = dc->process->handle;
+        break;
+    default:
+        in->ProcessId = dc->pid;
+        in->ProcessHandle = dc->process->handle;
+        break;
+    }
+    return dc->cb->CallbackRoutine(dc->cb->CallbackParam, in, out);
+}
+
+/* CancelCallback: TRUE when the caller cancelled the dump. It is asked
+ * until it stops asking to be (CheckCancel). */
+static BOOL dump_cancelled(struct dump_context* dc)
+{
+    MINIDUMP_CALLBACK_INPUT     cbin;
+    MINIDUMP_CALLBACK_OUTPUT    cbout;
+
+    if (dc->status) return TRUE;
+    if (!dc->check_cancel) return FALSE;
+    memset(&cbin, 0, sizeof(cbin));
+    memset(&cbout, 0, sizeof(cbout));
+    if (!dump_callback(dc, CancelCallback, &cbin, &cbout))
+    {
+        dc->check_cancel = FALSE;
+        return FALSE;
+    }
+    dc->check_cancel = cbout.CheckCancel;
+#ifndef SG_MUTANT_NO_CANCEL
+    if (cbout.Cancel) dc->status = HRESULT_FROM_WIN32(ERROR_CANCELLED);
+#endif
+    return dc->status != S_OK;
+}
+
+/* writes go to the file, or to IoWriteAllCallback when IoStartCallback
+ * took them */
+static void dump_write(struct dump_context* dc, ULONG64 offset, const void* data, unsigned size)
+{
+    DWORD           written;
+    LARGE_INTEGER   pos;
+
+    if (dc->io_callback)
+    {
+        MINIDUMP_CALLBACK_INPUT     cbin;
+        MINIDUMP_CALLBACK_OUTPUT    cbout;
+
+        if (dc->status) return;
+        memset(&cbin, 0, sizeof(cbin));
+        memset(&cbout, 0, sizeof(cbout));
+        cbin.Io.Handle = dc->hFile;
+        cbin.Io.Offset = offset;
+        cbin.Io.Buffer = (void*)data;
+        cbin.Io.BufferBytes = size;
+        if (!dump_callback(dc, IoWriteAllCallback, &cbin, &cbout)) dc->status = E_FAIL;
+        else if (FAILED(cbout.Status)) dc->status = cbout.Status;
+        return;
+    }
+    pos.QuadPart = offset;
+    SetFilePointerEx(dc->hFile, pos, NULL, FILE_BEGIN);
+    if (!WriteFile(dc->hFile, data, size, &written, NULL) && !dc->status)
+        dc->status = HRESULT_FROM_WIN32(GetLastError());
+}
+
+/* the process's memory, for a memory list: what cannot be read is zeros,
+ * after ReadMemoryFailureCallback is told */
+static void dump_read_memory(struct dump_context* dc, ULONG64 addr, void* buf, ULONG len)
+{
+    if (read_process_memory(dc->process, addr, buf, len)) return;
+    memset(buf, 0, len);
+    if (dc->cb)
+    {
+        MINIDUMP_CALLBACK_INPUT     cbin;
+        MINIDUMP_CALLBACK_OUTPUT    cbout;
+
+        memset(&cbin, 0, sizeof(cbin));
+        memset(&cbout, 0, sizeof(cbout));
+        cbin.ReadMemoryFailure.Offset = addr;
+        cbin.ReadMemoryFailure.Bytes = len;
+        cbin.ReadMemoryFailure.FailureStatus = HRESULT_FROM_NT(STATUS_PARTIAL_COPY);
+        dump_callback(dc, ReadMemoryFailureCallback, &cbin, &cbout);
+    }
+}
+
+/* the bytes of a thread stack that lie in a removed range are zeroed */
+static void dump_zero_removed(struct dump_context* dc, ULONG64 addr, char* buf, ULONG len)
 {
-    DWORD       written;
+    unsigned j;
+
+    for (j = 0; j < dc->num_removed; j++)
+    {
+        ULONG64 rb = max(dc->removed[j].base, addr), re = min(dc->removed[j].base + dc->removed[j].size, addr + len);
+        if (rb < re) memset(buf + (rb - addr), 0, re - rb);
+    }
+}
 
-    SetFilePointer(dc->hFile, rva, NULL, FILE_BEGIN);
-    WriteFile(dc->hFile, data, size, &written, NULL);
+static void writeat(struct dump_context* dc, RVA rva, const void* data, unsigned size)
+{
+    dump_write(dc, rva, data, size);
 }
 
