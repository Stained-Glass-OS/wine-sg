+/******************************************************************
+ *		dump_include_callbacks
+ *
+ * Stained Glass OS: IncludeThreadCallback for each thread and
+ * IncludeModuleCallback for each module, before anything is written: a
+ * FALSE leaves the thread or module out of the dump, and the write flags
+ * they return limit what is written for it.
+ */
+static void dump_include_callbacks(struct dump_context* dc)
+{
+    MINIDUMP_CALLBACK_INPUT     cbin;
+    MINIDUMP_CALLBACK_OUTPUT    cbout;
+    ULONG                       flags;
+    unsigned                    i, n;
+
+    flags = ThreadWriteThread | ThreadWriteStack | ThreadWriteContext | ThreadWriteInstructionWindow;
+    if (dc->type & MiniDumpWithProcessThreadData) flags |= ThreadWriteThreadData;
+    if (dc->type & MiniDumpWithThreadInfo) flags |= ThreadWriteThreadInfo;
+    for (i = n = 0; i < dc->num_threads; i++)
+    {
+        dc->threads[i].include_flags = flags;
+        if (dc->cb)
+        {
+            memset(&cbin, 0, sizeof(cbin));
+            memset(&cbout, 0, sizeof(cbout));
+            cbin.IncludeThread.ThreadId = dc->threads[i].tid;
+            cbout.ThreadWriteFlags = flags;
+#ifndef SG_MUTANT_NO_INCLUDE_THREAD
+            if (!dump_callback(dc, IncludeThreadCallback, &cbin, &cbout)) continue;
+            dc->threads[i].include_flags &= cbout.ThreadWriteFlags;
+#endif
+        }
+        dc->threads[n++] = dc->threads[i];
+    }
+    dc->num_threads = n;
+
+    flags = ModuleWriteModule | ModuleWriteMiscRecord | ModuleWriteCvRecord;
+    if (dc->type & MiniDumpWithDataSegs) flags |= ModuleWriteDataSeg;
+    if (dc->type & MiniDumpWithProcessThreadData) flags |= ModuleWriteTlsData;
+    if (dc->type & MiniDumpWithCodeSegs) flags |= ModuleWriteCodeSegs;
+    for (i = n = 0; i < dc->num_modules; i++)
+    {
+        dc->modules[i].include_flags = flags;
+        if (dc->cb)
+        {
+            memset(&cbin, 0, sizeof(cbin));
+            memset(&cbout, 0, sizeof(cbout));
+            cbin.IncludeModule.BaseOfImage = dc->modules[i].base;
+            cbout.ModuleWriteFlags = flags;
+#ifndef SG_MUTANT_NO_INCLUDE_MODULE
+            if (!dump_callback(dc, IncludeModuleCallback, &cbin, &cbout)) continue;
+            dc->modules[i].include_flags &= cbout.ModuleWriteFlags;
+#endif
+        }
+        dc->modules[n++] = dc->modules[i];
+    }
+    dc->num_modules = n;
+}
+
+/* Stained Glass OS: MemoryCallback, asked until it returns FALSE or an
+ * empty range: the ranges it names go to the memory list */
+static void dump_memory_callbacks(struct dump_context* dc)
+{
+    MINIDUMP_CALLBACK_INPUT     cbin;
+    MINIDUMP_CALLBACK_OUTPUT    cbout;
+
+    if (!dc->cb) return;
+    for (;;)
+    {
+        memset(&cbin, 0, sizeof(cbin));
+        memset(&cbout, 0, sizeof(cbout));
+        if (!dump_callback(dc, MemoryCallback, &cbin, &cbout) || !cbout.MemorySize) break;
+#ifndef SG_MUTANT_NO_MEMORY_CALLBACK
+        if (!(dc->type & MiniDumpWithFullMemory))
+            minidump_add_memory_block(dc, cbout.MemoryBase, cbout.MemorySize, 0);
+#endif
+        if (dump_cancelled(dc)) return;
+    }
+}
+
+/* Stained Glass OS: RemoveMemoryCallback, asked the same way: the ranges it
+ * names are taken out of the memory lists (thread stacks keep their place in
+ * the file; their bytes there are zeroed) */
+static void dump_remove_memory_callbacks(struct dump_context* dc)
+{
+    MINIDUMP_CALLBACK_INPUT     cbin;
+    MINIDUMP_CALLBACK_OUTPUT    cbout;
+    struct dump_memory*         r;
+
+    if (!dc->cb) return;
+    for (;;)
+    {
+        memset(&cbin, 0, sizeof(cbin));
+        memset(&cbout, 0, sizeof(cbout));
+        if (!dump_callback(dc, RemoveMemoryCallback, &cbin, &cbout) || !cbout.MemorySize) break;
+        if (!(r = HeapReAlloc(GetProcessHeap(), 0, dc->removed ? dc->removed : HeapAlloc(GetProcessHeap(), 0, 0),
+                              (dc->num_removed + 1) * sizeof(*r)))) break;
+        dc->removed = r;
+        dc->removed[dc->num_removed].base = cbout.MemoryBase;
+        dc->removed[dc->num_removed].size = cbout.MemorySize;
+        dc->removed[dc->num_removed].rva = 0;
+        dc->num_removed++;
+        if (dump_cancelled(dc)) return;
+    }
+}
+
+/* cut the removed ranges out of a block list; a block whose descriptor
+ * a thread points to (rva) keeps its range */
+static void dump_apply_removed(struct dump_context* dc)
+{
+    unsigned i, j;
+
+#ifdef SG_MUTANT_NO_REMOVE_MEMORY
+    return;
+#endif
+
+    for (j = 0; j < dc->num_removed; j++)
+    {
+        ULONG64 rb = dc->removed[j].base, re = rb + dc->removed[j].size;
+
+        for (i = 0; i < dc->num_mem; i++)
+        {
+            ULONG64 b = dc->mem[i].base, e = b + dc->mem[i].size;
+
+            if (dc->mem[i].rva || re <= b || rb >= e) continue;
+            if (rb <= b && re >= e) dc->mem[i].size = 0;
+            else if (rb <= b) { dc->mem[i].base = re; dc->mem[i].size = e - re; }
+            else if (re >= e) dc->mem[i].size = rb - b;
+            else
+            {
+                /* split: the tail becomes a new block */
+                dc->mem[i].size = rb - b;
+                minidump_add_memory_block(dc, re, e - re, 0);
+            }
+        }
+        for (i = 0; i < dc->num_mem64; i++)
+        {
+            ULONG64 b = dc->mem64[i].base, e = b + dc->mem64[i].size;
+
+            if (re <= b || rb >= e) continue;
+            if (rb <= b && re >= e) dc->mem64[i].size = 0;
+            else if (rb <= b) { dc->mem64[i].base = re; dc->mem64[i].size = e - re; }
+            else if (re >= e) dc->mem64[i].size = rb - b;
+            else
+            {
+                ULONG64 tail = e - re;
+                dc->mem64[i].size = rb - b;
+                minidump_add_memory64_block(dc, re, tail);
+            }
+        }
+    }
+    /* drop the emptied blocks */
+    for (i = j = 0; i < dc->num_mem; i++)
+        if (dc->mem[i].size || dc->mem[i].rva) dc->mem[j++] = dc->mem[i];
+    dc->num_mem = j;
+    for (i = j = 0; i < dc->num_mem64; i++)
+        if (dc->mem64[i].size) dc->mem64[j++] = dc->mem64[i];
+    dc->num_mem64 = j;
+}
+
