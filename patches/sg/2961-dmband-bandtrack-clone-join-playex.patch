 }
 
+/* what InitPlay keeps for the extended methods */
+struct band_play_state
+{
+    IDirectMusicPerformance *performance;   /* not referenced */
+};
+
+static struct band_entry *band_entry_create(IDirectMusicBand *band, MUSIC_TIME logical,
+        MUSIC_TIME physical)
+{
+    struct band_entry *entry;
+
+    if (!(entry = calloc(1, sizeof(*entry)))) return NULL;
+    entry->head.lBandTimeLogical = logical;
+    entry->head.lBandTimePhysical = physical;
+    entry->band = band;
+    IDirectMusicBand_AddRef(band);
+    return entry;
+}
+
+/* keeps the list sorted by the logical time, a band at the time of another one comes after it */
+static void band_track_insert(struct band_track *This, struct band_entry *new_entry)
+{
+    struct band_entry *entry;
+
+    LIST_FOR_EACH_ENTRY(entry, &This->bands, struct band_entry, entry)
+    {
+        if (entry->head.lBandTimeLogical > new_entry->head.lBandTimeLogical)
+        {
+            list_add_before(&entry->entry, &new_entry->entry);
+            return;
+        }
+    }
+    list_add_tail(&This->bands, &new_entry->entry);
+}
+
+static void band_track_clear(struct band_track *This)
+{
+    struct band_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &This->bands, struct band_entry, entry)
+    {
+        list_remove(&entry->entry);
+        band_entry_destroy(entry);
+    }
+}
+
+/* Copies the bands of [start, end) of 'src', moved to 'shift' + (time - start). The band in effect at
+ * 'start' is copied first, at 'shift'. A band of the track start (time -1) stays one when the copy
+ * starts at the beginning and 'keep_start' is set; otherwise it counts as time zero. */
+static HRESULT band_track_copy(struct band_track *src, MUSIC_TIME start, MUSIC_TIME end,
+        MUSIC_TIME shift, BOOL keep_start, struct band_track *dst)
+{
+    struct band_entry *entry, *effective = NULL, *copy;
+    BOOL has_start = FALSE;
+
+    LIST_FOR_EACH_ENTRY(entry, &src->bands, struct band_entry, entry)
+    {
+        MUSIC_TIME time = entry->head.lBandTimeLogical;
+
+        if (time == -1 && start == 0) time = keep_start ? -1 : 0;
+        if (time == start) has_start = TRUE;
+        if (time < start && !(time == -1 && start == 0 && keep_start)) effective = entry;
+    }
+
+    if (effective && !has_start)
+    {
+        MUSIC_TIME physical = max(0, effective->head.lBandTimePhysical - start);
+#ifdef SG_MUTANT_CLONE_SHIFT
+        physical = effective->head.lBandTimePhysical;
+#endif
+        if (!(copy = band_entry_create(effective->band, shift, physical + shift))) return E_OUTOFMEMORY;
+        band_track_insert(dst, copy);
+    }
+
+    LIST_FOR_EACH_ENTRY(entry, &src->bands, struct band_entry, entry)
+    {
+        MUSIC_TIME time = entry->head.lBandTimeLogical, physical;
+
+        if (time == -1 && start == 0 && keep_start) time = -1;
+        else
+        {
+            if (time == -1) time = 0;
+            if (time < start || time >= end) continue;
+            time += shift - start;
+        }
+
+        physical = max(0, entry->head.lBandTimePhysical - start);
+#ifdef SG_MUTANT_CLONE_SHIFT
+        physical = entry->head.lBandTimePhysical;
+#endif
+        if (!(copy = band_entry_create(entry->band, time, physical + shift))) return E_OUTOFMEMORY;
+        band_track_insert(dst, copy);
+    }
+    return S_OK;
+}
