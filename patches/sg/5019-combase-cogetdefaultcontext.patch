From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase: Implement CoGetDefaultContext for the current apartment.

CoGetDefaultContext gives the caller's object context for APTTYPE_CURRENT
and for the type of the caller's own apartment (every context here is the
default one of its apartment), fails E_INVALIDARG for APTTYPE_STA ("returns
E_INVALIDARG if APTTYPE_STA is specified") and CO_E_NOTINITIALIZED outside an
apartment. The default context of another apartment is still not supported
(FIXME, E_NOINTERFACE). It always failed with E_NOINTERFACE.

Gate: test/combase-defctx-gate.sh (64/32).
---
 dlls/combase/combase.c | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
index e4cc077..d63d6bc 100644
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -1284,8 +1284,27 @@ HRESULT WINAPI CoGetObjectContext(REFIID riid, void **ppv)
  */
 HRESULT WINAPI CoGetDefaultContext(APTTYPE type, REFIID riid, void **obj)
 {
-    FIXME("%d, %s, %p stub\n", type, debugstr_guid(riid), obj);
+    APTTYPEQUALIFIER qualifier;
+    APTTYPE current;
+    HRESULT hr;
+
+    TRACE("%d, %s, %p\n", type, debugstr_guid(riid), obj);
+
+    if (!obj) return E_INVALIDARG;
+    *obj = NULL;
+#ifndef SG_MUTANT_DEFCTX_NO_CHECKS
+    /* "returns E_INVALIDARG if APTTYPE_STA is specified": there are many */
+    if (type != APTTYPE_CURRENT && type != APTTYPE_MTA && type != APTTYPE_NA && type != APTTYPE_MAINSTA)
+        return E_INVALIDARG;
+    if (FAILED(hr = CoGetApartmentType(&current, &qualifier))) return hr;
+#else
+    current = type;
+#endif
+
+    /* every context here is the default one of its apartment */
+    if (type == APTTYPE_CURRENT || type == current) return CoGetObjectContext(riid, obj);
 
+    FIXME("default context of another apartment (%d, in %d) not supported\n", type, current);
     return E_NOINTERFACE;
 }
 
