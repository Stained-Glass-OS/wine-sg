+/* the bar where it is, or tucked away at its edge (auto-hide), 2 px left on the screen */
+static void sg_second_place( struct sg_second *bar )
+{
+    RECT r = bar->bar;
+    int t = sg_vertical() ? r.right - r.left : r.bottom - r.top;
+
+    if (bar->hidden)
+    {
+        switch (sg_bar.edge)
+        {
+        case ABE_TOP:   OffsetRect( &r, 0, SG_HIDDEN_EDGE - t ); break;
+        case ABE_LEFT:  OffsetRect( &r, SG_HIDDEN_EDGE - t, 0 ); break;
+        case ABE_RIGHT: OffsetRect( &r, t - SG_HIDDEN_EDGE, 0 ); break;
+        default:        OffsetRect( &r, 0, t - SG_HIDDEN_EDGE ); break;
+        }
+    }
+    SetWindowPos( bar->hwnd, HWND_TOPMOST, r.left, r.top, r.right - r.left, r.bottom - r.top,
+                  SWP_NOACTIVATE | SWP_SHOWWINDOW );
+}
+
+/* auto-hide on the other displays' bars, each by itself: it comes out when the
+ * pointer reaches its edge, goes when the pointer has been away a while (wine-sg 7761) */
+static void sg_seconds_autohide(void)
+{
+    struct sg_second *bar;
+    GUITHREADINFO gui = { sizeof(gui) };
+    POINT pt;
+
+#ifdef SG_MUTANT_SECOND_NO_AUTOHIDE
+    return;
+#endif
+    GetCursorPos( &pt );
+    GetGUIThreadInfo( GetCurrentThreadId(), &gui );
+    LIST_FOR_EACH_ENTRY( bar, &sg_seconds, struct sg_second, entry )
+    {
+        RECT edge = bar->bar;
+        if (bar->hidden)
+        {
+            switch (sg_bar.edge)
+            {
+            case ABE_TOP:   edge.bottom = edge.top + SG_HIDDEN_EDGE; break;
+            case ABE_LEFT:  edge.right = edge.left + SG_HIDDEN_EDGE; break;
+            case ABE_RIGHT: edge.left = edge.right - SG_HIDDEN_EDGE; break;
+            default:        edge.top = edge.bottom - SG_HIDDEN_EDGE; break;
+            }
+            if (PtInRect( &edge, pt ))
+            {
+                bar->hidden = FALSE;
+                bar->away = 0;
+                sg_second_place( bar );
+            }
+            continue;
+        }
+        if (PtInRect( &bar->bar, pt ) || (gui.flags & GUI_INMENUMODE)) { bar->away = 0; continue; }
+        if (++bar->away * SG_AUTOHIDE_TICK < SG_AUTOHIDE_DELAY) continue;
+        bar->away = 0;
+        bar->hidden = TRUE;
+        sg_second_place( bar );
+    }
+}
