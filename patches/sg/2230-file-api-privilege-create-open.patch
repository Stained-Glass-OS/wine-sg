From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, kernelbase, kernel32: SetFileValidData privilege, CreateFile and OpenFile edge cases

SetFileValidData only needs the file open for writing; Windows also needs
SeManageVolumePrivilege, enabled (ERROR_PRIVILEGE_NOT_HELD).  CreateFile
with TRUNCATE_EXISTING and no GENERIC_WRITE (none, GENERIC_READ,
FILE_WRITE_DATA) was accepted and truncated; it is
ERROR_INVALID_PARAMETER.  CREATE_NEW on an existing directory without
backup semantics is ERROR_ACCESS_DENIED, not ERROR_FILE_EXISTS.  OpenFile
set OFSTRUCT.cBytes even when it failed; now only on success.  The
todo_wine marks these satisfy, and ones already satisfied (read-only file
deletion, CopyFileEx cancel, SetFileInformationByHandle lengths), are
removed from the kernel32 file test.

---
--- a/dlls/kernel32/file.c
+++ b/dlls/kernel32/file.c
@@ -444,8 +444,7 @@ HFILE WINAPI OpenFile( LPCSTR name, OFSTRUCT *ofs, UINT mode )
         );
 
 
-    ofs->cBytes = sizeof(OFSTRUCT);
-    ofs->nErrCode = 0;
+    ofs->nErrCode = 0;  /* cBytes is set when the call succeeds */
     if (mode & OF_REOPEN) name = ofs->szPathName;
 
     if (!name) return HFILE_ERROR;
@@ -469,6 +468,7 @@ HFILE WINAPI OpenFile( LPCSTR name, OFSTRUCT *ofs, UINT mode )
     {
         ofs->fFixedDisk = (GetDriveTypeA( ofs->szPathName ) != DRIVE_REMOVABLE);
         TRACE("(%s): OF_PARSE, res = '%s'\n", name, ofs->szPathName );
+        ofs->cBytes = sizeof(OFSTRUCT);
         return 0;
     }
 
@@ -498,6 +498,7 @@ HFILE WINAPI OpenFile( LPCSTR name, OFSTRUCT *ofs, UINT mode )
         {
             if (!DeleteFileA( ofs->szPathName )) goto error;
             TRACE("(%s): OF_DELETE return = OK\n", name);
+            ofs->cBytes = sizeof(OFSTRUCT);
             return TRUE;
         }
 
@@ -521,6 +522,9 @@ HFILE WINAPI OpenFile( LPCSTR name, OFSTRUCT *ofs, UINT mode )
         ofs->Reserved2 = filedatetime[1];
     }
     TRACE("(%s): OK, return = %p\n", name, handle );
+#ifndef SG_MUTANT_OPENFILE_CBYTES
+    ofs->cBytes = sizeof(OFSTRUCT);
+#endif
     if (mode & OF_EXIST)  /* Return TRUE instead of a handle */
     {
         CloseHandle( handle );
@@ -529,6 +533,9 @@ HFILE WINAPI OpenFile( LPCSTR name, OFSTRUCT *ofs, UINT mode )
     return HandleToLong(handle);
 
 error:  /* We get here if there was an error opening the file */
+#ifdef SG_MUTANT_OPENFILE_CBYTES
+    ofs->cBytes = sizeof(OFSTRUCT);
+#endif
     ofs->nErrCode = GetLastError();
     WARN("(%s): return = HFILE_ERROR error= %d\n", name,ofs->nErrCode );
     return HFILE_ERROR;
