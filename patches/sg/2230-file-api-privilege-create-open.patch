--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -978,6 +978,15 @@ HANDLE WINAPI DECLSPEC_HOTPATCH CreateFileW( LPCWSTR filename, DWORD access, DWO
         return INVALID_HANDLE_VALUE;
     }
 
+    /* truncating needs GENERIC_WRITE itself, not just the right to write data */
+#ifndef SG_MUTANT_TRUNCATE_NO_WRITE
+    if (creation == TRUNCATE_EXISTING && !(access & (GENERIC_WRITE | GENERIC_ALL)))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return INVALID_HANDLE_VALUE;
+    }
+#endif
+
     if (!RtlDosPathNameToNtPathName_U( filename, &nameW, NULL, NULL ))
     {
         SetLastError( ERROR_PATH_NOT_FOUND );
@@ -1038,7 +1047,18 @@ HANDLE WINAPI DECLSPEC_HOTPATCH CreateFileW( LPCWSTR filename, DWORD access, DWO
          * Note: RtlNtStatusToDosError is not the subject to blame here.
          */
         if (status == STATUS_OBJECT_NAME_COLLISION)
-            SetLastError( ERROR_FILE_EXISTS );
+        {
+            DWORD attrs = GetFileAttributesW( filename );
+#ifdef SG_MUTANT_CREATE_NEW_DIR
+            attrs = INVALID_FILE_ATTRIBUTES;
+#endif
+            /* a directory is not a file that exists: opening it as a file is refused */
+            if (attrs != INVALID_FILE_ATTRIBUTES && (attrs & FILE_ATTRIBUTE_DIRECTORY) &&
+                !(attributes & FILE_FLAG_BACKUP_SEMANTICS))
+                SetLastError( ERROR_ACCESS_DENIED );
+            else
+                SetLastError( ERROR_FILE_EXISTS );
+        }
         else
             SetLastError( RtlNtStatusToDosError(status) );
     }
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5624,6 +5624,37 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             if ((status = server_get_unix_fd( handle, FILE_WRITE_DATA, &fd, &needs_close, NULL, NULL )))
                 return set_file_info_status( io, status );
 
+            /* Stained Glass OS: setting the valid data length needs
+             * SeManageVolumePrivilege, enabled */
+            {
+                PRIVILEGE_SET privs;
+                HANDLE token;
+                BOOLEAN held = FALSE;
+
+                privs.PrivilegeCount = 1;
+                privs.Control = PRIVILEGE_SET_ALL_NECESSARY;
+                privs.Privilege[0].Luid.LowPart = SE_MANAGE_VOLUME_PRIVILEGE;
+                privs.Privilege[0].Luid.HighPart = 0;
+                privs.Privilege[0].Attributes = 0;
+                if (NtOpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token )
+                        && NtOpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+                    status = STATUS_PRIVILEGE_NOT_HELD;
+                else
+                {
+                    status = NtPrivilegeCheck( token, &privs, &held );
+                    NtClose( token );
+                    if (!status && !held) status = STATUS_PRIVILEGE_NOT_HELD;
+                }
+#ifdef SG_MUTANT_VALIDDATA_NO_PRIV
+                status = STATUS_SUCCESS;
+#endif
+                if (status)
+                {
+                    if (needs_close) close( fd );
+                    return set_file_info_status( io, status );
+                }
+            }
+
             if (fstat( fd, &st ) == -1) status = errno_to_status( errno );
             else if (info->ValidDataLength.QuadPart <= 0 || (off_t)info->ValidDataLength.QuadPart > st.st_size)
                 status = STATUS_INVALID_PARAMETER;
