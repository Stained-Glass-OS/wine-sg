From: Stained Glass OS <dev@stained-glass.example>
Subject: wintrust: an RFC 3161 timestamp dates the signature

Store and MSIX packages are signed by certificates valid for a few days
and carry an RFC 3161 timestamp (the szOID_RFC3161_counterSign unsigned
attribute, a SignedData whose content is a TSTInfo). Windows checks the
signer's chain as of the timestamp's time; Wine knew only the old PKCS #9
countersignature, so every such package failed with CERT_E_EXPIRED three
days after it was signed -- Microsoft's App Installer bundle among them.

The timestamp is believed only when all of this holds, and otherwise
ignored (the current time is used, as before):
- the token's content is a TSTInfo whose message imprint is the hash of
  this signature's encrypted digest (SHA-1/256/384/512);
- the token's signature verifies with its signer's certificate (found by
  the CMS signer ID among the token's certificates, each read separately:
  one Wine cannot decode no longer loses them all);
- that certificate chains, at the timestamp's time, to a trusted root,
  valid for time stamping, and passes the base policy.

--- a/dlls/wintrust/softpub.c
+++ b/dlls/wintrust/softpub.c
@@ -753,6 +753,250 @@
     return date;
 }
 
+/* RFC 3161 timestamps (Microsoft's szOID_RFC3161_counterSign unsigned
+ * attribute): a SignedData whose content is a TSTInfo. Store and MSIX
+ * packages are signed by certificates valid for days and carry one; Windows
+ * checks the signer's chain as of the timestamp's time. The timestamp is only
+ * believed when the token's own signature verifies, its message imprint is
+ * the hash of this signature, and its signer chains to a trusted root as a
+ * time-stamping authority at that time -- otherwise it is ignored and the
+ * current time is used, as before. */
+static const char rfc3161_counter_sign[] = "1.3.6.1.4.1.311.3.3.1";
+static const char tst_info_content[] = "1.2.840.113549.1.9.16.1.4";
+
+struct der
+{
+    const BYTE *p, *end;
+};
+
+/* The next element, which must have this tag; its contents in *content. */
+static BOOL der_next(struct der *d, BYTE tag, struct der *content)
+{
+    DWORD len = 0, n, i;
+
+    if (d->end - d->p < 2 || d->p[0] != tag) return FALSE;
+    d->p++;
+    if (*d->p < 0x80) len = *d->p++;
+    else
+    {
+        n = *d->p++ & 0x7f;
+        if (!n || n > 4 || d->end - d->p < n) return FALSE;
+        for (i = 0; i < n; i++) len = (len << 8) | *d->p++;
+    }
+    if (len > d->end - d->p) return FALSE;
+    if (content)
+    {
+        content->p = d->p;
+        content->end = d->p + len;
+    }
+    d->p += len;
+    return TRUE;
+}
+
+static BOOL parse_generalized_time(const struct der *t, FILETIME *time)
+{
+    SYSTEMTIME st = { 0 };
+    const BYTE *p = t->p;
+    DWORD len = t->end - t->p, i;
+
+    /* YYYYMMDDHHMMSS[.f...]Z */
+    if (len < 15 || t->end[-1] != 'Z') return FALSE;
+    for (i = 0; i < 14; i++) if (p[i] < '0' || p[i] > '9') return FALSE;
+#define DIGITS2(o) ((p[o] - '0') * 10 + (p[(o) + 1] - '0'))
+    st.wYear = DIGITS2(0) * 100 + DIGITS2(2);
+    st.wMonth = DIGITS2(4);
+    st.wDay = DIGITS2(6);
+    st.wHour = DIGITS2(8);
+    st.wMinute = DIGITS2(10);
+    st.wSecond = DIGITS2(12);
+#undef DIGITS2
+    return SystemTimeToFileTime(&st, time);
+}
+
+/* The hash algorithm of a message imprint, as a CNG name. */
+static const WCHAR *imprint_hash_name(const struct der *oid)
+{
+    static const BYTE sha1[] = { 0x2b, 0x0e, 0x03, 0x02, 0x1a };
+    static const BYTE sha256[] = { 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01 };
+    static const BYTE sha384[] = { 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02 };
+    static const BYTE sha512[] = { 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x03 };
+    DWORD len = oid->end - oid->p;
+
+    if (len == sizeof(sha1) && !memcmp(oid->p, sha1, len)) return L"SHA1";
+    if (len == sizeof(sha256) && !memcmp(oid->p, sha256, len)) return L"SHA256";
+    if (len == sizeof(sha384) && !memcmp(oid->p, sha384, len)) return L"SHA384";
+    if (len == sizeof(sha512) && !memcmp(oid->p, sha512, len)) return L"SHA512";
+    return NULL;
+}
+
+/* TSTInfo: the message imprint's algorithm and hash, and genTime. */
+static BOOL parse_tst_info(const BYTE *data, DWORD size, struct der *alg, struct der *hash, FILETIME *time)
+{
+    struct der d = { data, data + size }, tst, imprint, alg_id, gen_time, wrapped;
+
+    /* the eContent may come still wrapped in its OCTET STRING */
+    if (size && data[0] == 0x04 && der_next(&d, 0x04, &wrapped)) d = wrapped;
+    return der_next(&d, 0x30, &tst) &&
+           der_next(&tst, 0x02, NULL) &&          /* version */
+           der_next(&tst, 0x06, NULL) &&          /* policy */
+           der_next(&tst, 0x30, &imprint) &&      /* messageImprint */
+           der_next(&imprint, 0x30, &alg_id) &&
+           der_next(&alg_id, 0x06, alg) &&
+           der_next(&imprint, 0x04, hash) &&
+           der_next(&tst, 0x02, NULL) &&          /* serialNumber */
+           der_next(&tst, 0x18, &gen_time) &&     /* genTime */
+           parse_generalized_time(&gen_time, time);
+}
+
+static BOOL WINTRUST_GetTimeFromRFC3161(const CMSG_SIGNER_INFO *signerInfo,
+ const CRYPT_ATTR_BLOB *token, FILETIME *time)
+{
+    static const DWORD encoding = X509_ASN_ENCODING | PKCS_7_ASN_ENCODING;
+    HCRYPTMSG msg;
+    HCERTSTORE store = NULL;
+    PCCERT_CONTEXT cert = NULL;
+    PCCERT_CHAIN_CONTEXT chain = NULL;
+    CMSG_CMS_SIGNER_INFO *cms_signer = NULL;
+    CMSG_CTRL_VERIFY_SIGNATURE_EX_PARA verify;
+    BYTE *content = NULL, digest[64];
+    char content_type[64];
+    DWORD size, digest_len;
+    struct der alg, hash;
+    const WCHAR *hash_name;
+    BOOL ret = FALSE;
+
+    if (!(msg = CryptMsgOpenToDecode(encoding, 0, 0, 0, NULL, NULL))) return FALSE;
+    if (!CryptMsgUpdate(msg, token->pbData, token->cbData, TRUE))
+    {
+        WARN("the timestamp cannot be decoded (%#lx)\n", GetLastError());
+        goto done;
+    }
+
+    size = sizeof(content_type);
+    if (!CryptMsgGetParam(msg, CMSG_INNER_CONTENT_TYPE_PARAM, 0, content_type, &size) ||
+     size > sizeof(content_type) - 1)
+    {
+        WARN("the timestamp has no content type (%#lx)\n", GetLastError());
+        goto done;
+    }
+    content_type[size] = 0;
+    if (strcmp(content_type, tst_info_content))
+    {
+        WARN("a timestamp of content type %s\n", debugstr_a(content_type));
+        goto done;
+    }
+
+    if (!CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, NULL, &size) ||
+     !(content = malloc(size)) || !CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, content, &size))
+    {
+        WARN("the timestamp has no content (%#lx)\n", GetLastError());
+        goto done;
+    }
+    if (!parse_tst_info(content, size, &alg, &hash, time))
+    {
+        WARN("the timestamp's TSTInfo cannot be read\n");
+        goto done;
+    }
+
+    /* the imprint is of this signature */
+    if (!(hash_name = imprint_hash_name(&alg)))
+    {
+        WARN("the timestamp's imprint has an unknown hash\n");
+        goto done;
+    }
+    digest_len = hash.end - hash.p;
+    if (digest_len > sizeof(digest) || !CryptHashCertificate2(hash_name, 0, NULL,
+     signerInfo->EncryptedHash.pbData, signerInfo->EncryptedHash.cbData, digest, &digest_len) ||
+     digest_len != hash.end - hash.p || memcmp(digest, hash.p, digest_len))
+    {
+        WARN("the timestamp is not of this signature\n");
+        goto done;
+    }
+
+    /* the token's signature, by its signer */
+    if (!CryptMsgGetParam(msg, CMSG_CMS_SIGNER_INFO_PARAM, 0, NULL, &size) ||
+     !(cms_signer = malloc(size)) ||
+     !CryptMsgGetParam(msg, CMSG_CMS_SIGNER_INFO_PARAM, 0, cms_signer, &size))
+    {
+        WARN("the timestamp's signer cannot be read (%#lx)\n", GetLastError());
+        goto done;
+    }
+    /* the token's certificates, each that can be read */
+    if (!(store = CertOpenStore(CERT_STORE_PROV_MEMORY, 0, 0, 0, NULL))) goto done;
+    {
+        DWORD count = 0, i, len;
+        BYTE *der;
+
+        size = sizeof(count);
+        CryptMsgGetParam(msg, CMSG_CERT_COUNT_PARAM, 0, &count, &size);
+        for (i = 0; i < count && i < 32; i++)
+        {
+            if (!CryptMsgGetParam(msg, CMSG_CERT_PARAM, i, NULL, &len) || !(der = malloc(len))) continue;
+            if (CryptMsgGetParam(msg, CMSG_CERT_PARAM, i, der, &len) &&
+             !CertAddEncodedCertificateToStore(store, encoding, der, len, CERT_STORE_ADD_ALWAYS, NULL))
+                WARN("the timestamp's certificate %lu cannot be read (%#lx)\n", i, GetLastError());
+            free(der);
+        }
+    }
+    if (!(cert = CertFindCertificateInStore(store, encoding, 0, CERT_FIND_CERT_ID, &cms_signer->SignerId, NULL)))
+    {
+        WARN("the timestamp has no signer certificate\n");
+        goto done;
+    }
+    verify.cbSize = sizeof(verify);
+    verify.hCryptProv = 0;
+    verify.dwSignerIndex = 0;
+    verify.dwSignerType = CMSG_VERIFY_SIGNER_CERT;
+    verify.pvSigner = (void *)cert;
+    if (!CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE_EX, &verify))
+    {
+        WARN("the timestamp's signature does not verify (%#lx)\n", GetLastError());
+        goto done;
+    }
+
+    /* its signer: a trusted time-stamping authority at that time */
+    {
+        static char timestamp_usage[] = szOID_PKIX_KP_TIMESTAMP_SIGNING;
+        LPSTR usages[] = { timestamp_usage };
+        CERT_CHAIN_PARA para = { sizeof(para) };
+        CERT_CHAIN_POLICY_PARA policy_para = { sizeof(policy_para) };
+        CERT_CHAIN_POLICY_STATUS status = { sizeof(status) };
+
+        para.RequestedUsage.dwType = USAGE_MATCH_TYPE_AND;
+        para.RequestedUsage.Usage.cUsageIdentifier = 1;
+        para.RequestedUsage.Usage.rgpszUsageIdentifier = usages;
+        if (!CertGetCertificateChain(NULL, cert, time, store, &para, 0, NULL, &chain))
+        {
+            WARN("no chain for the time-stamping authority\n");
+            goto done;
+        }
+        if (chain->TrustStatus.dwErrorStatus & (CERT_TRUST_IS_NOT_TIME_VALID | CERT_TRUST_IS_REVOKED |
+         CERT_TRUST_IS_NOT_SIGNATURE_VALID | CERT_TRUST_IS_UNTRUSTED_ROOT | CERT_TRUST_IS_PARTIAL_CHAIN |
+         CERT_TRUST_IS_NOT_VALID_FOR_USAGE | CERT_TRUST_IS_CYCLIC))
+        {
+            WARN("the time-stamping authority is not trusted (%#lx)\n", chain->TrustStatus.dwErrorStatus);
+            goto done;
+        }
+        if (!CertVerifyCertificateChainPolicy(CERT_CHAIN_POLICY_BASE, chain, &policy_para, &status) ||
+         status.dwError)
+        {
+            WARN("the time-stamping authority's chain fails the base policy (%#lx)\n", status.dwError);
+            goto done;
+        }
+    }
+    TRACE("RFC 3161 timestamp %s\n", filetime_to_str(time));
+    ret = TRUE;
+
+done:
+    if (chain) CertFreeCertificateChain(chain);
+    if (cert) CertFreeCertificateContext(cert);
+    if (store) CertCloseStore(store, 0);
+    free(cms_signer);
+    free(content);
+    CryptMsgClose(msg);
+    return ret;
+}
+
