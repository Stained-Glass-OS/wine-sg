From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wshom: WshExec.Status is WshFinished for any ended process

WshExec.Status said WshFailed (2) when the child had ended with a nonzero
exit code. Windows says WshRunning (0) while the child runs and WshFinished
(1) once it has ended, whatever its exit code (ExitCode gives that); WshFailed
only when the process cannot be watched. Scripts that wait with
"Do Until oExec.Status = 1" hung for ever on a child that exited nonzero.
Status now waits on the process handle (an exit code of 259 is not taken
for running either).

Gate: test/wshexecstatus-gate.sh; mutant SG_MUTANT_WSHEXEC_FAILED_ON_EXIT_CODE.
---
--- a/dlls/wshom.ocx/shell.c
+++ b/dlls/wshom.ocx/shell.c
@@ -219,27 +219,33 @@
 static HRESULT WINAPI WshExec_get_Status(IWshExec *iface, WshExecStatus *status)
 {
     WshExecImpl *This = impl_from_IWshExec(iface);
-    DWORD code;
 
     TRACE("(%p)->(%p)\n", This, status);
 
     if (!status)
         return E_INVALIDARG;
 
+#ifdef SG_MUTANT_WSHEXEC_FAILED_ON_EXIT_CODE
+    DWORD code;
     if (!GetExitCodeProcess(This->info.hProcess, &code))
         return HRESULT_FROM_WIN32(GetLastError());
-
-    switch (code)
+    *status = code == STILL_ACTIVE ? WshRunning : code ? WshFailed : WshFinished;
+#else
+    /* As Windows: WshRunning while the process runs, WshFinished once it has ended, whatever its exit
+     * code (ExitCode tells that; scripts wait with "Do Until oExec.Status = 1"). WshFailed only when the
+     * process cannot be watched. An exit code of STILL_ACTIVE (259) is not taken for running. */
+    switch (WaitForSingleObject(This->info.hProcess, 0))
     {
-    case 0:
-        *status = WshFinished;
-        break;
-    case STILL_ACTIVE:
+    case WAIT_TIMEOUT:
         *status = WshRunning;
         break;
+    case WAIT_OBJECT_0:
+        *status = WshFinished;
+        break;
     default:
         *status = WshFailed;
     }
+#endif
 
     return S_OK;
 }
