From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dcomp: CompositionAnimationGroup, StartAnimationGroup and groups as implicit animations

ICompositor2::CreateAnimationGroup was E_NOTIMPL and visuals' StartAnimationGroup/StopAnimationGroup refused every group. The group keeps animations (Add/Remove/RemoveAll/Count, IIterable<CompositionAnimation>); starting it runs each animation on its Target (one without a Target fails the call with E_INVALIDARG); a group in an implicit animation collection runs its animations on their Targets, from the old value for the changed property. Interface identity per windows-rs 0.30 (MIT OR Apache-2.0).
---
--- a/dlls/dcomp/animation.c
+++ b/dlls/dcomp/animation.c
@@ -2768,6 +2768,12 @@
     return start_animation( compositor, owner, animatable, impl, properties, name, animation, NULL );
 }
 
+#ifndef SG_MUTANT_NO_ANIMATION_GROUP
+static void implicit_group( struct compositor *compositor, IUnknown *owner, animatable_fn animatable, void *impl,
+                            ICompositionPropertySet *properties, IUnknown *value, const WCHAR *name,
+                            const float *starting );
+#endif
+
 void object_changed_implicit( struct compositor *compositor, IUnknown *owner, animatable_fn animatable, void *impl,
                               ICompositionPropertySet *properties, IImplicitAnimationCollection *collection,
                               const WCHAR *name, const void *old, size_t size )
@@ -2782,6 +2788,14 @@
 
     if (!collection || !(base = implicit_collection_find( collection, name ))) return;
     hr = ICompositionAnimationBase_QueryInterface( base, &IID_ICompositionAnimation, (void **)&animation );
+#ifndef SG_MUTANT_NO_ANIMATION_GROUP
+    if (FAILED(hr))
+    {
+        /* (8215) a group: its animations on their Targets */
+        memcpy( starting, old, min( size, sizeof(starting) ) );
+        implicit_group( compositor, owner, animatable, impl, properties, (IUnknown *)base, name, starting );
+    }
+#endif
     ICompositionAnimationBase_Release( base );
     if (FAILED(hr)) return;
     if (animation->lpVtbl != &animation_vtbl)
@@ -2984,3 +2998,470 @@
     free( *clock );
     *clock = NULL;
 }
+
+/***********************************************************************
+ *          CompositionAnimationGroup (wine-sg 8215)
+ *
+ * A set of animations started together, each on its own Target (ICompositionAnimation2.Target), by
+ * StartAnimationGroup or as an implicit animation. Interface identity per windows-rs 0.30 (MIT OR Apache-2.0).
+ */
+#ifndef SG_MUTANT_NO_ANIMATION_GROUP
+static const GUID IID_ICompositionAnimationGroup_sg = { 0x5e7cc90c, 0xcd14, 0x4e07, { 0x8a, 0x55, 0xc7, 0x25, 0x27, 0xaa, 0xbd, 0xac } };
+static const WCHAR class_animation_group[] = L"Windows.UI.Composition.CompositionAnimationGroup";
+
+struct animation_group
+{
+    struct { const void * const *vtbl; } ICompositionAnimationGroup_iface;
+    IIterable_CompositionAnimation IIterable_CompositionAnimation_iface;
+    ICompositionAnimationBase ICompositionAnimationBase_iface;
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    IInspectable ICompositionObject4_iface;
+    LONG ref;
+    struct compositor *compositor;
+    ICompositionAnimation **items;
+    UINT count, size;
+    ICompositionPropertySet *properties;
+    CRITICAL_SECTION cs;
+};
+
+struct group_iterator
+{
+    IIterator_CompositionAnimation IIterator_CompositionAnimation_iface;
+    LONG ref;
+    struct animation_group *group;
+    UINT index;
+};
+
+static const void * const group_vtbl[];
+
+static struct animation_group *impl_from_group( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct animation_group, ICompositionAnimationGroup_iface );
+}
+
+static HRESULT WINAPI group_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    struct animation_group *impl = impl_from_group( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICompositionAnimationGroup_sg ))
+        *out = &impl->ICompositionAnimationGroup_iface;
+    else if (IsEqualGUID( iid, &IID_IIterable_CompositionAnimation ))
+        *out = &impl->IIterable_CompositionAnimation_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionAnimationBase ))
+        *out = &impl->ICompositionAnimationBase_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject4_x ))
+        *out = &impl->ICompositionObject4_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject ))
+        *out = &impl->ICompositionObject_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI group_AddRef( void *iface )
+{
+    return InterlockedIncrement( &impl_from_group( iface )->ref );
+}
+
+static ULONG WINAPI group_Release( void *iface )
+{
+    struct animation_group *impl = impl_from_group( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT i;
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++) ICompositionAnimation_Release( impl->items[i] );
+        free( impl->items );
+        DeleteCriticalSection( &impl->cs );
+        ICompositor_Release( (ICompositor *)impl->compositor );
+        object_release_properties( impl->properties );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI group_GetIids( void *iface, ULONG *iid_count, IID **iids )
+{
+    const IID *list[] = { &IID_ICompositionAnimationGroup_sg, &IID_IIterable_CompositionAnimation,
+                          &IID_ICompositionAnimationBase, &IID_ICompositionObject, &IID_IClosable };
+    return iid_list( iid_count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI group_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    return class_name( class_animation_group, name );
+}
+
+static HRESULT WINAPI group_GetTrustLevel( void *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI group_get_Count( void *iface, INT32 *value )
+{
+    struct animation_group *impl = impl_from_group( iface );
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    *value = impl->count;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI group_Add( void *iface, ICompositionAnimation *value )
+{
+    struct animation_group *impl = impl_from_group( iface );
+    ICompositionAnimation **items;
+
+    ICompositionAnimation *animation;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    /* kept as its ICompositionAnimation, whichever of its interfaces is given */
+    if (!value || FAILED(ICompositionAnimation_QueryInterface( value, &IID_ICompositionAnimation, (void **)&animation )))
+        return E_INVALIDARG;
+    EnterCriticalSection( &impl->cs );
+    if (impl->count == impl->size)
+    {
+        UINT size = max( 4, impl->size * 2 );
+        if (!(items = realloc( impl->items, size * sizeof(*items) )))
+        {
+            LeaveCriticalSection( &impl->cs );
+            ICompositionAnimation_Release( animation );
+            return E_OUTOFMEMORY;
+        }
+        impl->items = items;
+        impl->size = size;
+    }
+    impl->items[impl->count++] = animation;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI group_Remove( void *iface, ICompositionAnimation *value )
+{
+    struct animation_group *impl = impl_from_group( iface );
+    ICompositionAnimation *animation;
+    UINT i;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value || FAILED(ICompositionAnimation_QueryInterface( value, &IID_ICompositionAnimation, (void **)&animation )))
+        return S_OK;
+    ICompositionAnimation_Release( animation );
+    EnterCriticalSection( &impl->cs );
+    for (i = 0; i < impl->count; i++)
+    {
+        if (impl->items[i] != animation) continue;
+        ICompositionAnimation_Release( impl->items[i] );
+        memmove( impl->items + i, impl->items + i + 1, (impl->count - i - 1) * sizeof(*impl->items) );
+        impl->count--;
+        break;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI group_RemoveAll( void *iface )
+{
+    struct animation_group *impl = impl_from_group( iface );
+    UINT i;
+
+    EnterCriticalSection( &impl->cs );
+    for (i = 0; i < impl->count; i++) ICompositionAnimation_Release( impl->items[i] );
+    impl->count = 0;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static const void * const group_vtbl[] =
+{
+    group_QueryInterface, group_AddRef, group_Release, group_GetIids, group_GetRuntimeClassName, group_GetTrustLevel,
+    group_get_Count, group_Add, group_Remove, group_RemoveAll,
+};
+
+/* IIterator<CompositionAnimation>: a snapshot index into the group */
+static struct group_iterator *impl_from_IIterator_CompositionAnimation( IIterator_CompositionAnimation *iface )
+{
+    return CONTAINING_RECORD( iface, struct group_iterator, IIterator_CompositionAnimation_iface );
+}
+
+static HRESULT WINAPI group_iterator_QueryInterface( IIterator_CompositionAnimation *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_IIterator_CompositionAnimation ))
+    {
+        *out = iface;
+        IInspectable_AddRef( (IInspectable *)iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI group_iterator_AddRef( IIterator_CompositionAnimation *iface )
+{
+    return InterlockedIncrement( &impl_from_IIterator_CompositionAnimation( iface )->ref );
+}
+
+static ULONG WINAPI group_iterator_Release( IIterator_CompositionAnimation *iface )
+{
+    struct group_iterator *impl = impl_from_IIterator_CompositionAnimation( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        group_Release( &impl->group->ICompositionAnimationGroup_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI group_iterator_GetIids( IIterator_CompositionAnimation *iface, ULONG *iid_count, IID **iids )
+{
+    const IID *list[] = { &IID_IIterator_CompositionAnimation };
+    return iid_list( iid_count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI group_iterator_GetRuntimeClassName( IIterator_CompositionAnimation *iface, HSTRING *name )
+{
+    return class_name( L"Windows.Foundation.Collections.IIterator`1<Windows.UI.Composition.CompositionAnimation>", name );
+}
+
+static HRESULT WINAPI group_iterator_GetTrustLevel( IIterator_CompositionAnimation *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI group_iterator_get_Current( IIterator_CompositionAnimation *iface, ICompositionAnimation **value )
+{
+    struct group_iterator *impl = impl_from_IIterator_CompositionAnimation( iface );
+    struct animation_group *group = impl->group;
+    HRESULT hr = E_BOUNDS;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    EnterCriticalSection( &group->cs );
+    if (impl->index < group->count)
+    {
+        *value = group->items[impl->index];
+        ICompositionAnimation_AddRef( *value );
+        hr = S_OK;
+    }
+    LeaveCriticalSection( &group->cs );
+    return hr;
+}
+
+static HRESULT WINAPI group_iterator_get_HasCurrent( IIterator_CompositionAnimation *iface, boolean *value )
+{
+    struct group_iterator *impl = impl_from_IIterator_CompositionAnimation( iface );
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &impl->group->cs );
+    *value = impl->index < impl->group->count;
+    LeaveCriticalSection( &impl->group->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI group_iterator_MoveNext( IIterator_CompositionAnimation *iface, boolean *value )
+{
+    struct group_iterator *impl = impl_from_IIterator_CompositionAnimation( iface );
+    EnterCriticalSection( &impl->group->cs );
+    if (impl->index < impl->group->count) impl->index++;
+    if (value) *value = impl->index < impl->group->count;
+    LeaveCriticalSection( &impl->group->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI group_iterator_GetMany( IIterator_CompositionAnimation *iface, UINT32 size,
+                                              ICompositionAnimation **items, UINT32 *count )
+{
+    struct group_iterator *impl = impl_from_IIterator_CompositionAnimation( iface );
+    struct animation_group *group = impl->group;
+    UINT32 n = 0;
+
+    if (!count || (size && !items)) return E_POINTER;
+    EnterCriticalSection( &group->cs );
+    while (n < size && impl->index + n < group->count)
+    {
+        items[n] = group->items[impl->index + n];
+        ICompositionAnimation_AddRef( items[n] );
+        n++;
+    }
+    impl->index += n;
+    LeaveCriticalSection( &group->cs );
+    *count = n;
+    return S_OK;
+}
+
+static const struct IIterator_CompositionAnimationVtbl group_iterator_vtbl =
+{
+    group_iterator_QueryInterface, group_iterator_AddRef, group_iterator_Release, group_iterator_GetIids,
+    group_iterator_GetRuntimeClassName, group_iterator_GetTrustLevel,
+    group_iterator_get_Current, group_iterator_get_HasCurrent, group_iterator_MoveNext, group_iterator_GetMany,
+};
+
+DEFINE_IINSPECTABLE_( group_iterable, IIterable_CompositionAnimation, struct animation_group,
+                      group_impl_from_iterable, IIterable_CompositionAnimation_iface, &impl->ICompositionAnimationGroup_iface )
+
+static HRESULT WINAPI group_iterable_First( IIterable_CompositionAnimation *iface, IIterator_CompositionAnimation **value )
+{
+    struct animation_group *impl = group_impl_from_iterable( iface );
+    struct group_iterator *iter;
+
+    if (!value) return E_POINTER;
+    if (!(iter = calloc( 1, sizeof(*iter) ))) return E_OUTOFMEMORY;
+    iter->IIterator_CompositionAnimation_iface.lpVtbl = &group_iterator_vtbl;
+    iter->ref = 1;
+    iter->group = impl;
+    group_AddRef( &impl->ICompositionAnimationGroup_iface );
+    *value = &iter->IIterator_CompositionAnimation_iface;
+    return S_OK;
+}
+
+static const struct IIterable_CompositionAnimationVtbl group_iterable_vtbl =
+{
+    group_iterable_QueryInterface, group_iterable_AddRef, group_iterable_Release, group_iterable_GetIids,
+    group_iterable_GetRuntimeClassName, group_iterable_GetTrustLevel, group_iterable_First,
+};
+
+DEFINE_IINSPECTABLE_( group_base, ICompositionAnimationBase, struct animation_group,
+                      group_impl_from_base, ICompositionAnimationBase_iface, &impl->ICompositionAnimationGroup_iface )
+
+static const struct ICompositionAnimationBaseVtbl group_base_vtbl =
+{
+    group_base_QueryInterface, group_base_AddRef, group_base_Release, group_base_GetIids,
+    group_base_GetRuntimeClassName, group_base_GetTrustLevel,
+};
+
+DEFINE_COMPOSITION_OBJECT_( group, struct animation_group, ICompositionAnimationGroup_iface, anim_none )
+DEFINE_COMPOSITION_OBJECT4( group, struct animation_group, ICompositionAnimationGroup_iface )
+
+HRESULT animation_group_create( struct compositor *compositor, void **out )
+{
+    struct animation_group *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->ICompositionAnimationGroup_iface.vtbl = group_vtbl;
+    impl->IIterable_CompositionAnimation_iface.lpVtbl = &group_iterable_vtbl;
+    impl->ICompositionAnimationBase_iface.lpVtbl = &group_base_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &group_object_vtbl;
+    impl->IClosable_iface.lpVtbl = &group_closable_vtbl;
+    impl->ICompositionObject4_iface.lpVtbl = (const IInspectableVtbl *)group_object4_vtbl;
+    impl->ref = 1;
+    impl->compositor = compositor;
+    ICompositor_AddRef( (ICompositor *)compositor );
+    InitializeCriticalSection( &impl->cs );
+    *out = &impl->ICompositionAnimationGroup_iface;
+    return S_OK;
+}
+
+/* one of our groups, from any of its interfaces (a reference added), or NULL */
+static struct animation_group *unsafe_group( IUnknown *unknown )
+{
+    void *iface;
+
+    if (!unknown || FAILED(IUnknown_QueryInterface( unknown, &IID_ICompositionAnimationGroup_sg, &iface ))) return NULL;
+    if (*(const void * const **)iface != group_vtbl)
+    {
+        IUnknown_Release( (IUnknown *)iface );
+        return NULL;
+    }
+    return impl_from_group( iface );
+}
+
+/* the group's animations with their Targets, a snapshot (references added) */
+static UINT group_snapshot( struct animation_group *group, ICompositionAnimation ***items )
+{
+    UINT i, count;
+
+    EnterCriticalSection( &group->cs );
+    count = group->count;
+    if ((*items = malloc( max( count, 1 ) * sizeof(**items) )))
+        for (i = 0; i < count; i++) ICompositionAnimation_AddRef( (*items)[i] = group->items[i] );
+    else count = 0;
+    LeaveCriticalSection( &group->cs );
+    return count;
+}
+
+static HSTRING animation_target( ICompositionAnimation *animation )
+{
+    if (animation->lpVtbl != &animation_vtbl) return NULL;
+    return impl_from_ICompositionAnimation( animation )->target_name;
+}
+
+/* StartAnimationGroup: each animation on its Target; one without a Target is an error (E_INVALIDARG) */
+HRESULT object_start_animation_group( struct compositor *compositor, IUnknown *owner, animatable_fn animatable,
+                                      void *impl, ICompositionPropertySet *properties, IUnknown *value )
+{
+    struct animation_group *group = unsafe_group( value );
+    ICompositionAnimation **items;
+    HRESULT hr = S_OK;
+    UINT i, count;
+
+    if (!group) return E_INVALIDARG;
+    count = group_snapshot( group, &items );
+    for (i = 0; i < count; i++)
+    {
+        HSTRING target = animation_target( items[i] );
+        if (!WindowsGetStringLen( target )) hr = E_INVALIDARG;
+        else if (FAILED(start_animation( compositor, owner, animatable, impl, properties, target, items[i], NULL )))
+            hr = E_INVALIDARG;
+    }
+    for (i = 0; i < count; i++) ICompositionAnimation_Release( items[i] );
+    free( items );
+    group_Release( &group->ICompositionAnimationGroup_iface );
+    return hr;
+}
+
+HRESULT object_stop_animation_group( struct compositor *compositor, IUnknown *owner, IUnknown *value )
+{
+    struct animation_group *group = unsafe_group( value );
+    ICompositionAnimation **items;
+    UINT i, count;
+
+    if (!group) return E_INVALIDARG;
+    count = group_snapshot( group, &items );
+    for (i = 0; i < count; i++)
+    {
+        HSTRING target = animation_target( items[i] );
+        if (WindowsGetStringLen( target )) object_stop_animation( compositor, owner, target );
+        ICompositionAnimation_Release( items[i] );
+    }
+    free( items );
+    group_Release( &group->ICompositionAnimationGroup_iface );
+    return S_OK;
+}
+
+/* an implicit animation that is a group: each animation on its Target, from the old value when that is the
+ * changed property */
+static void implicit_group( struct compositor *compositor, IUnknown *owner, animatable_fn animatable, void *impl,
+                            ICompositionPropertySet *properties, IUnknown *value, const WCHAR *name,
+                            const float *starting )
+{
+    struct animation_group *group = unsafe_group( value );
+    ICompositionAnimation **items;
+    UINT i, count;
+
+    if (!group) return;
+    count = group_snapshot( group, &items );
+    for (i = 0; i < count; i++)
+    {
+        HSTRING target = animation_target( items[i] );
+        const WCHAR *text = WindowsGetStringRawBuffer( target, NULL );
+        if (WindowsGetStringLen( target ))
+            start_animation( compositor, owner, animatable, impl, properties, target, items[i],
+                             wcsicmp( text, name ) ? NULL : starting );
+        ICompositionAnimation_Release( items[i] );
+    }
+    free( items );
+    group_Release( &group->ICompositionAnimationGroup_iface );
+}
+#endif
