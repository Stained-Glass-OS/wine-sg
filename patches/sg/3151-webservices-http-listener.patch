+static HRESULT send_reply_http( struct channel *channel, WS_MESSAGE *msg, BYTE *data, ULONG len )
+{
+    WS_ENVELOPE_VERSION version = WS_ENVELOPE_VERSION_SOAP_1_2;
+    BOOL fault = FALSE;
+    const char *type, *status;
+    char head[256];
+    int n;
+    HRESULT hr;
+
+    WsGetMessageProperty( msg, WS_MESSAGE_PROPERTY_ENVELOPE_VERSION, &version, sizeof(version), NULL );
+    WsGetMessageProperty( msg, WS_MESSAGE_PROPERTY_IS_FAULT, &fault, sizeof(fault), NULL );
+
+    if (channel->encoding == WS_ENCODING_XML_BINARY_1) type = "application/soap+msbin1";
+    else if (version == WS_ENVELOPE_VERSION_SOAP_1_1) type = "text/xml; charset=utf-8";
+    else type = "application/soap+xml; charset=utf-8";
+    status = fault ? "500 Internal Server Error" : "200 OK";
+
+    n = snprintf( head, sizeof(head), "HTTP/1.1 %s\r\nContent-Type: %s\r\nContent-Length: %lu\r\n"
+                  "Connection: close\r\n\r\n", status, type, len );
+    if ((hr = send_bytes( channel->u.http.sock, head, n )) != S_OK) return hr;
+    if (len && (hr = send_bytes( channel->u.http.sock, (char *)data, len )) != S_OK) return hr;
+    shutdown( channel->u.http.sock, SD_SEND );
+    return S_OK;
+}
