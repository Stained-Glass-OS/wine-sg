+static HRESULT open_listener_http( struct listener *listener, const WS_STRING *str )
+{
+    struct sockaddr_storage storage;
+    struct sockaddr *addr = (struct sockaddr *)&storage;
+    int addr_len, on = 1;
+    WS_HTTP_URL *url;
+    WS_HEAP *heap;
+    WCHAR *host = NULL, *path = NULL;
+    USHORT port;
+    HRESULT hr;
+
+    if ((hr = WsCreateHeap( 1 << 8, 0, NULL, 0, &heap, NULL )) != S_OK) return hr;
+    if ((hr = WsDecodeUrl( str, WS_URL_FLAGS_ALLOW_HOST_WILDCARDS, heap, (WS_URL **)&url, NULL )) != S_OK)
+    {
+        WsFreeHeap( heap );
+        return hr;
+    }
+    if (url->url.scheme != WS_URL_HTTP_SCHEME_TYPE)
+    {
+        WsFreeHeap( heap );
+        return url->url.scheme == WS_URL_HTTPS_SCHEME_TYPE ? E_NOTIMPL : WS_E_INVALID_ENDPOINT_URL;
+    }
+    port = url->port;
+    if (!(url->host.length == 1 && (url->host.chars[0] == '+' || url->host.chars[0] == '*')))
+    {
+        if (!(host = malloc( (url->host.length + 1) * sizeof(WCHAR) ))) hr = E_OUTOFMEMORY;
+        else
+        {
+            memcpy( host, url->host.chars, url->host.length * sizeof(WCHAR) );
+            host[url->host.length] = 0;
+        }
+    }
+    if (hr == S_OK)
+    {
+        if (!(path = malloc( (url->path.length + 1) * sizeof(WCHAR) ))) hr = E_OUTOFMEMORY;
+        else
+        {
+            memcpy( path, url->path.chars, url->path.length * sizeof(WCHAR) );
+            path[url->path.length] = 0;
+        }
+    }
+    WsFreeHeap( heap );
+    if (hr != S_OK) goto error;
+
+    winsock_init();
+
+    if ((hr = resolve_hostname( host, port, addr, &addr_len, AI_PASSIVE )) != S_OK) goto error;
+    free( host );
+    host = NULL;
+
+    if ((listener->u.http.socket = socket( addr->sa_family, SOCK_STREAM, 0 )) == -1)
+    {
+        hr = HRESULT_FROM_WIN32( WSAGetLastError() );
+        goto error;
+    }
+    if (setsockopt( listener->u.http.socket, SOL_SOCKET, SO_REUSEADDR, (char *)&on, sizeof(on) ) < 0 ||
+        bind( listener->u.http.socket, addr, addr_len ) < 0 || listen( listener->u.http.socket, 0 ) < 0)
+    {
+        hr = HRESULT_FROM_WIN32( WSAGetLastError() );
+        closesocket( listener->u.http.socket );
+        listener->u.http.socket = -1;
+        goto error;
+    }
+
+    listener->u.http.path = path;
+    listener->state = WS_LISTENER_STATE_OPEN;
+    return S_OK;
+
+error:
+    free( host );
+    free( path );
+    return hr;
+}
+
 static HRESULT open_listener( struct listener *listener, const WS_STRING *url )
 {
     switch (listener->binding)
     {
+    case WS_HTTP_CHANNEL_BINDING:
+        return open_listener_http( listener, url );
+
     case WS_TCP_CHANNEL_BINDING:
         return open_listener_tcp( listener, url );
 
@@ -722,6 +818,17 @@ HRESULT WINAPI WsAcceptChannel( WS_LISTENER *handle, WS_CHANNEL *channel_handle,
             TRACE( "returning %#lx\n", hr );
             return hr;
         }
+        case WS_HTTP_CHANNEL_BINDING:
+        {
+            SOCKET socket = listener->u.http.socket;
+            WCHAR *prefix = wcsdup( listener->u.http.path ? listener->u.http.path : L"" );
+
+            LeaveCriticalSection( &listener->cs );
+            hr = channel_accept_http( socket, prefix, wait, cancel, channel_handle );
+            free( prefix );
+            TRACE( "returning %#lx\n", hr );
+            return hr;
+        }
         default:
             FIXME( "listener binding %u not supported\n", listener->binding );
             break;
