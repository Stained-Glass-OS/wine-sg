+struct sockreader
+{
+    SOCKET s;
+    char  *buf;
+    ULONG  cap, len, pos;
+};
+
+static BOOL sr_fill( struct sockreader *r )
+{
+    int n;
+
+    if (r->pos == r->len) r->pos = r->len = 0;
+    if (r->len == r->cap)
+    {
+        ULONG cap = r->cap ? r->cap * 2 : 4096;
+        char *tmp = realloc( r->buf, cap );
+        if (!tmp) return FALSE;
+        r->buf = tmp;
+        r->cap = cap;
+    }
+    if ((n = recv( r->s, r->buf + r->len, r->cap - r->len, 0 )) <= 0) return FALSE;
+    r->len += n;
+    return TRUE;
+}
+
+/* returns a NUL-terminated line without its line end, valid until the next call */
+static char *sr_line( struct sockreader *r )
+{
+    for (;;)
+    {
+        char *end = memchr( r->buf + r->pos, '\n', r->len - r->pos );
+        if (end)
+        {
+            char *line = r->buf + r->pos;
+            r->pos = end + 1 - r->buf;
+            *end = 0;
+            if (end > line && end[-1] == '\r') end[-1] = 0;
+            return line;
+        }
+        if (r->len - r->pos > 16384 || !sr_fill( r )) return NULL;
+    }
+}
+
+static BOOL sr_read( struct sockreader *r, char *dst, ULONG size )
+{
+    while (size)
+    {
+        ULONG avail = r->len - r->pos, n;
+        if (!avail)
+        {
+            if (!sr_fill( r )) return FALSE;
+            continue;
+        }
+        n = min( avail, size );
+        memcpy( dst, r->buf + r->pos, n );
+        r->pos += n;
+        dst += n;
+        size -= n;
+    }
+    return TRUE;
+}
+
+static void send_http_status( SOCKET s, const char *status )
+{
+    char buf[128];
+    int n = snprintf( buf, sizeof(buf), "HTTP/1.1 %s\r\nContent-Length: 0\r\nConnection: close\r\n\r\n", status );
+    send_bytes( s, buf, n );
+}
+
+static BOOL http_path_matches( const char *target, const WCHAR *prefix )
+{
+    ULONG len = 0, plen = prefix ? wcslen( prefix ) : 0, i;
+
+    while (target[len] && target[len] != ' ' && target[len] != '?' && target[len] != '#') len++;
+    if (!plen) return TRUE;
+#ifdef SG_MUTANT_WSHTTP_PATH
+    return TRUE;
+#endif
+    /* a prefix registered as "/a/" also receives "/a" */
+    if (len + 1 == plen && prefix[plen - 1] == '/') plen--;
+    if (len < plen) return FALSE;
+    for (i = 0; i < plen; i++)
+        if (towlower( (unsigned char)target[i] ) != towlower( prefix[i] )) return FALSE;
+    return len == plen || prefix[plen - 1] == '/' || target[plen] == '/';
+}
+
+/* Reads one request. Returns 0 on success, otherwise an error status that was sent to the client or -1. */
+static const char *read_http_request( struct channel *channel, struct sockreader *r, const WCHAR *prefix )
+{
+    ULONG max = get_max_buffer_size( channel ), size = 0, content_length = 0;
+    BOOL have_length = FALSE, chunked = FALSE, expect = FALSE, msbin = FALSE, ok = TRUE;
+    char *line, *p;
+
+    if (!(line = sr_line( r ))) return "";
+    if (strncmp( line, "POST ", 5 ))
+    {
+        while ((line = sr_line( r )) && *line) {}
+        return "405 Method Not Allowed";
+    }
+    p = line + 5;
+    while (*p == ' ') p++;
+    ok = http_path_matches( p, prefix );
+
+    for (;;)
+    {
+        if (!(line = sr_line( r ))) return "";
+        if (!*line) break;
+        if (!_strnicmp( line, "content-length:", 15 ))
+        {
+            content_length = strtoul( line + 15, NULL, 10 );
+            have_length = TRUE;
+        }
+        else if (!_strnicmp( line, "transfer-encoding:", 18 ))
+        {
+            chunked = strstr( line + 18, "chunked" ) != NULL;
+        }
+        else if (!_strnicmp( line, "expect:", 7 ))
+        {
+            expect = strstr( line + 7, "100-continue" ) != NULL;
+        }
+        else if (!_strnicmp( line, "content-type:", 13 ))
+        {
+            msbin = strstr( line + 13, "msbin1" ) != NULL;
+        }
+    }
+#ifdef SG_MUTANT_WSHTTP_CHUNK
+    chunked = FALSE;
+#endif
+    if (!ok) return "404 Not Found";
+    if (!chunked && !have_length) return "411 Length Required";
+    if (!chunked && content_length > max) return "413 Request Entity Too Large";
+    if (expect) send_bytes( r->s, "HTTP/1.1 100 Continue\r\n\r\n", 25 );
+
+    if (chunked)
+    {
+        for (;;)
+        {
+            ULONG n;
+            if (!(line = sr_line( r ))) return "";
+            n = strtoul( line, NULL, 16 );
+            if (!n)
+            {
+                while ((line = sr_line( r )) && *line) {}
+                break;
+            }
+            if (size + n > max) return "413 Request Entity Too Large";
+            if (resize_read_buffer( channel, size + n ) != S_OK) return "500 Internal Server Error";
+            if (!sr_read( r, channel->read_buf + size, n )) return "";
+            size += n;
+            if (!sr_line( r )) return "";
+        }
+    }
+    else
+    {
+        if (resize_read_buffer( channel, content_length ? content_length : 1 ) != S_OK) return "500 Internal Server Error";
+        if (!sr_read( r, channel->read_buf, content_length )) return "";
+        size = content_length;
+    }
+    channel->read_size = size;
+    if (msbin) channel->encoding = WS_ENCODING_XML_BINARY_1;
+    return NULL;
+}
+
+HRESULT channel_accept_http( SOCKET socket, const WCHAR *prefix, HANDLE wait, HANDLE cancel, WS_CHANNEL *handle )
+{
+    struct channel *channel = (struct channel *)handle;
+    HRESULT hr;
+
+    EnterCriticalSection( &channel->cs );
+
+    if (channel->magic != CHANNEL_MAGIC)
+    {
+        LeaveCriticalSection( &channel->cs );
+        return E_INVALIDARG;
+    }
+
+    for (;;)
+    {
+        struct sockreader r = { 0 };
+        const char *err;
+        DWORD timeout = 30000;
+        SOCKET s;
+
+        if ((hr = sock_accept( socket, wait, cancel, &s )) != S_OK) break;
+        setsockopt( s, SOL_SOCKET, SO_RCVTIMEO, (const char *)&timeout, sizeof(timeout) );
+
+        r.s = s;
+        err = read_http_request( channel, &r, prefix );
+        free( r.buf );
+        if (!err)
+        {
+            if (channel->u.http.sock != -1) closesocket( channel->u.http.sock );
+            channel->u.http.sock = s;
+            channel->state = WS_CHANNEL_STATE_OPEN;
+            break;
+        }
+        if (*err) send_http_status( s, err );
+        closesocket( s );
+    }
+
+    LeaveCriticalSection( &channel->cs );
+    return hr;
+}
+
 HRESULT channel_address_message( WS_CHANNEL *handle, WS_MESSAGE *msg )
 {
     struct channel *channel = (struct channel *)handle;
