From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cldapi: \\?\ paths name the sync root they are under; "a..b" is a plain name

CfCreatePlaceholders (and the other calls taking a path: registering, connecting, unregistering a sync root) compared the path given with the sync roots as it came, so a provider passing its folder as a \\?\ path, as OneDrive does for every placeholder it creates, was told the folder is not under a sync root and no placeholder was made: its folders appeared, made another way, but stayed empty. A \\?\ (or \\?\UNC\) path is now taken as the path it names. A placeholder name was also refused when it merely contained two dots (v1..2.txt); only a ".." component is refused now.
---
diff --git a/dlls/cldapi/main.c b/dlls/cldapi/main.c
index 1f4a326..6ef346d 100644
--- a/dlls/cldapi/main.c
+++ b/dlls/cldapi/main.c
@@ -285,6 +285,19 @@ static BOOL normalize_path(const WCHAR *in, WCHAR *out, DWORD len)
     DWORD ret = GetFullPathNameW(in, len, out, NULL);
 
     if (!ret || ret >= len) return FALSE;
+#ifndef SG_MUTANT_CF_LONG_PREFIX_KEPT
+    /* a \\?\ path names the same place as the DOS path the sync roots are kept under */
+    if (!wcsncmp(out, L"\\\\?\\UNC\\", 8))
+    {
+        memmove(out + 2, out + 8, (ret - 8 + 1) * sizeof(WCHAR));
+        ret -= 6;
+    }
+    else if (!wcsncmp(out, L"\\\\?\\", 4) && out[4] && out[5] == ':')
+    {
+        memmove(out, out + 4, (ret - 4 + 1) * sizeof(WCHAR));
+        ret -= 4;
+    }
+#endif
     while (ret > 3 && out[ret - 1] == '\\') out[--ret] = 0;
     return TRUE;
 }
@@ -828,6 +841,21 @@ HRESULT WINAPI CfDisconnectSyncRoot( LONGLONG key )
     return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
 }
 
+/* does a relative name climb out of its folder (a ".." component; "a..b" is a plain name) */
+static BOOL has_dotdot( const WCHAR *name )
+{
+    const WCHAR *p = name;
+
+    for (;;)
+    {
+        const WCHAR *end = p;
+        while (*end && *end != '\\' && *end != '/') end++;
+        if (end - p == 2 && p[0] == '.' && p[1] == '.') return TRUE;
+        if (!*end) return FALSE;
+        p = end + 1;
+    }
+}
+
 static HRESULT create_one_placeholder( const WCHAR *base, CF_PLACEHOLDER_CREATE_INFO *info )
 {
     WCHAR path[MAX_PATH];
@@ -835,7 +863,7 @@ static HRESULT create_one_placeholder( const WCHAR *base, CF_PLACEHOLDER_CREATE_
     HANDLE file;
     BOOL dir = info->BasicInfo.FileAttributes & FILE_ATTRIBUTE_DIRECTORY;
 
-    if (!info->RelativeFileName || !info->RelativeFileName[0] || wcsstr( info->RelativeFileName, L".." )
+    if (!info->RelativeFileName || !info->RelativeFileName[0] || has_dotdot( info->RelativeFileName )
             || info->FileIdentityLength > META_MAX_IDENTITY || (info->FileIdentityLength && !info->FileIdentity))
         return E_INVALIDARG;
     if (wcslen( base ) + wcslen( info->RelativeFileName ) + 2 >= MAX_PATH) return HRESULT_FROM_WIN32( ERROR_FILENAME_EXCED_RANGE );
