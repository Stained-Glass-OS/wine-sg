+static ITEMIDLIST *ShellView_FolderPidl(IShellViewImpl *This)
+{
+    IPersistFolder2 *pf;
+
+    if (!This->folder_pidl && SUCCEEDED(IShellFolder_QueryInterface(This->pSFParent, &IID_IPersistFolder2, (void **)&pf)))
+    {
+        IPersistFolder2_GetCurFolder(pf, &This->folder_pidl);
+        IPersistFolder2_Release(pf);
+    }
+    return This->folder_pidl;
+}
+
+static void thumb_queue_release(struct thumb_queue *queue)
+{
+    struct thumb_request *req, *next;
+
+    if (InterlockedDecrement(&queue->ref)) return;
+    LIST_FOR_EACH_ENTRY_SAFE(req, next, &queue->requests, struct thumb_request, entry)
+    {
+        list_remove(&req->entry);
+        ILFree(req->abs);
+        ILFree(req->child);
+        free(req);
+    }
+    CloseHandle(queue->event);
+    queue->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection(&queue->cs);
+    free(queue);
+}
+
+/* the picture thread: makes the thumbnails the view asks for, newest request first */
+static DWORD WINAPI thumb_thread(void *arg)
+{
+    struct thumb_queue *queue = arg;
+    struct thumb_request *req;
+
+    CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
+    for (;;)
+    {
+        struct thumb_result *result;
+        HBITMAP bitmap = NULL;
+
+        EnterCriticalSection(&queue->cs);
+        req = queue->quit || list_empty(&queue->requests) ? NULL :
+              LIST_ENTRY(list_head(&queue->requests), struct thumb_request, entry);
+        if (req) list_remove(&req->entry);
+        LeaveCriticalSection(&queue->cs);
+        if (queue->quit) break;
+        if (!req)
+        {
+            WaitForSingleObject(queue->event, INFINITE);
+            continue;
+        }
+        if (SUCCEEDED(SHELL_GetThumbnail(req->abs, req->size, &bitmap)) && bitmap &&
+            (result = malloc(sizeof(*result))))
+        {
+            result->child = req->child;
+            result->bitmap = bitmap;
+            result->gen = req->gen;
+            req->child = NULL;
+            if (queue->quit || !PostMessageW(queue->hwnd, WM_SV_THUMBNAIL, 0, (LPARAM)result))
+            {
+                DeleteObject(bitmap);
+                ILFree(result->child);
+                free(result);
+            }
+        }
+        else if (bitmap) DeleteObject(bitmap);
+        ILFree(req->abs);
+        ILFree(req->child);
+        free(req);
+    }
+    CoUninitialize();
+    thumb_queue_release(queue);
+    return 0;
+}
+
+static void ShellView_StopThumbnails(IShellViewImpl *This)
+{
+    struct thumb_queue *queue = This->thumb_queue;
+
+    if (!queue) return;
+    This->thumb_queue = NULL;
+    EnterCriticalSection(&queue->cs);
+    queue->quit = TRUE;
+    LeaveCriticalSection(&queue->cs);
+    SetEvent(queue->event);
+    thumb_queue_release(queue);
+}
+
+static int requested_find(IShellViewImpl *This, LPARAM item, BOOL *found)
+{
+    int lo = 0, hi = This->n_requested;
+
+    while (lo < hi)
+    {
+        int mid = (lo + hi) / 2;
+        if (This->requested[mid] == item) { *found = TRUE; return mid; }
+        if (This->requested[mid] < item) lo = mid + 1;
+        else hi = mid;
+    }
+    *found = FALSE;
+    return lo;
+}
+
+/* asks the picture thread for an item's thumbnail, once */
+static void ShellView_RequestThumbnail(IShellViewImpl *This, LPCITEMIDLIST pidl)
+{
+    struct thumb_request *req;
+    struct thumb_queue *queue;
+    ITEMIDLIST *folder;
+    BOOL found;
+    int at;
+
+    at = requested_find(This, (LPARAM)pidl, &found);
+    if (found || !(folder = ShellView_FolderPidl(This))) return;
+    if (This->n_requested == This->max_requested)
+    {
+        int max = max(64, This->max_requested * 2);
+        LPARAM *grown = realloc(This->requested, max * sizeof(*grown));
+        if (!grown) return;
+        This->requested = grown;
+        This->max_requested = max;
+    }
+    memmove(This->requested + at + 1, This->requested + at, (This->n_requested - at) * sizeof(LPARAM));
+    This->requested[at] = (LPARAM)pidl;
+    This->n_requested++;
+
+    if (!(queue = This->thumb_queue))
+    {
+        HANDLE thread;
+
+        if (!(queue = calloc(1, sizeof(*queue)))) return;
+        queue->ref = 2;
+        InitializeCriticalSectionEx(&queue->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+        queue->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": thumb_queue.cs");
+        list_init(&queue->requests);
+        queue->event = CreateEventW(NULL, FALSE, FALSE, NULL);
+        queue->hwnd = This->hWnd;
+        if (!(thread = CreateThread(NULL, 0, thumb_thread, queue, 0, NULL)))
+        {
+            queue->ref = 1;
+            thumb_queue_release(queue);
+            return;
+        }
+        CloseHandle(thread);
+        This->thumb_queue = queue;
+    }
+    if (!(req = calloc(1, sizeof(*req)))) return;
+    req->abs = ILCombine(folder, pidl);
+    req->child = ILClone(pidl);
+    req->size = This->image_size;
+    req->gen = This->thumb_gen;
+    EnterCriticalSection(&queue->cs);
+    list_add_head(&queue->requests, &req->entry);
+    LeaveCriticalSection(&queue->cs);
+    SetEvent(queue->event);
+}
+
+/* whether a file type has a thumbnail handler; remembered per extension */
+static BOOL ShellView_HasThumbnail(LPCITEMIDLIST pidl)
+{
+    static struct { WCHAR ext[16]; BOOL has; } cache[64];
+    static int ncache;
+    WCHAR name[MAX_PATH], key[MAX_PATH], value[64];
+    const WCHAR *ext;
+    LONG size;
+    int i;
+
+    if (!_ILIsValue(pidl)) return FALSE;
+    _ILSimpleGetTextW(pidl, name, MAX_PATH);
+    ext = PathFindExtensionW(name);
+    if (!ext[0] || lstrlenW(ext) >= 16) return FALSE;
+    for (i = 0; i < ncache; i++)
+        if (!wcsicmp(cache[i].ext, ext)) return cache[i].has;
+    swprintf(key, ARRAY_SIZE(key), L"%s\\ShellEx\\{e357fccd-a995-4576-b01f-234630154e96}", ext);
+    size = sizeof(value);
+    i = !RegQueryValueW(HKEY_CLASSES_ROOT, key, value, &size) && value[0];
+    if (!i)
+    {
+        swprintf(key, ARRAY_SIZE(key), L"SystemFileAssociations\\%s\\ShellEx\\{e357fccd-a995-4576-b01f-234630154e96}", ext);
+        size = sizeof(value);
+        i = !RegQueryValueW(HKEY_CLASSES_ROOT, key, value, &size) && value[0];
+    }
+    if (!i)
+    {
+        swprintf(key, ARRAY_SIZE(key), L"%s\\ShellEx\\{BB2E617C-0920-11d1-9A0B-00C04FC2D6C1}", ext);
+        size = sizeof(value);
+        i = !RegQueryValueW(HKEY_CLASSES_ROOT, key, value, &size) && value[0];
+    }
+    if (ncache < ARRAY_SIZE(cache))
+    {
+        lstrcpyW(cache[ncache].ext, ext);
+        cache[ncache++].has = i;
+    }
+    return i;
+}
