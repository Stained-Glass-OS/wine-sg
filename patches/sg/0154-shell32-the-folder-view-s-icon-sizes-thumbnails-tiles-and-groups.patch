+/* the column that holds an FMTID_Storage property, -1 if none */
+static int ShellView_ColumnOf(IShellViewImpl *This, DWORD pid)
+{
+    SHCOLUMNID scid;
+    UINT i;
+
+    if (!This->pSF2Parent) return -1;
+    for (i = 0; i < This->columns; i++)
+        if (SUCCEEDED(IShellFolder2_MapColumnToSCID(This->pSF2Parent, i, &scid)) &&
+            IsEqualGUID(&scid.fmtid, &FMTID_Storage) && scid.pid == pid)
+            return i;
+    return -1;
+}
