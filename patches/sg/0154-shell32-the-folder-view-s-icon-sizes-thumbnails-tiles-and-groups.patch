+/* the view's own image for a system image list index, the icon at the view's size */
+static int ShellView_OwnIcon(IShellViewImpl *This, int sys)
+{
+    IImageList *source;
+    HICON icon = NULL;
+    int own = -1;
+
+    if (sys < 0) return sys;
+    if (sys >= This->n_sys_to_own)
+    {
+        int n = max(sys + 1, This->n_sys_to_own * 2), i;
+        int *grown = realloc(This->sys_to_own, n * sizeof(int));
+        if (!grown) return -1;
+        for (i = This->n_sys_to_own; i < n; i++) grown[i] = -1;
+        This->sys_to_own = grown;
+        This->n_sys_to_own = n;
+    }
+    if (This->sys_to_own[sys] != -1) return This->sys_to_own[sys];
+    if (SUCCEEDED(SHGetImageList(This->image_size > 48 ? SHIL_JUMBO : SHIL_EXTRALARGE, &IID_IImageList, (void **)&source)))
+    {
+        IImageList_GetIcon(source, sys, ILD_TRANSPARENT, &icon);
+        IImageList_Release(source);
+    }
+    if (icon)
+    {
+        own = ImageList_AddIcon(This->own_icons, icon);
+        DestroyIcon(icon);
+    }
+    This->sys_to_own[sys] = own;
+    return own;
+}
+
+/* a thumbnail has come: centred on a square the size of the view's icons */
+static void ShellView_OnThumbnail(IShellViewImpl *This, struct thumb_result *result)
+{
+    BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER) }};
+    HBITMAP square;
+    BITMAP bm;
+    DWORD *dst, *pixels = NULL;
+    int size = This->image_size, x0, y0, y, w, h, index, item, i;
+    BOOL alpha = FALSE;
+    LVITEMW lvItem;
+    HDC dc;
+
+    if (result->gen != This->thumb_gen || !This->own_icons || !GetObjectW(result->bitmap, sizeof(bm), &bm) ||
+        (item = LV_FindItemByPidl(This, result->child)) < 0)
+        goto done;
+    /* any handler's bitmap, as top-down 32-bit pixels */
+    w = min(bm.bmWidth, size);
+    h = min(bm.bmHeight, size);
+    bmi.bmiHeader.biWidth = bm.bmWidth;
+    bmi.bmiHeader.biHeight = -bm.bmHeight;
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biCompression = BI_RGB;
+    if (!(pixels = malloc((SIZE_T)bm.bmWidth * bm.bmHeight * 4))) goto done;
+    dc = GetDC(0);
+    i = GetDIBits(dc, result->bitmap, 0, bm.bmHeight, pixels, &bmi, DIB_RGB_COLORS);
+    ReleaseDC(0, dc);
+    if (!i) goto done;
+    for (i = 0; i < bm.bmWidth * bm.bmHeight && !alpha; i++) alpha = !!(pixels[i] >> 24);
+    if (!alpha) for (i = 0; i < bm.bmWidth * bm.bmHeight; i++) pixels[i] |= 0xff000000;
+
+    bmi.bmiHeader.biWidth = size;
+    bmi.bmiHeader.biHeight = -size;
+    if (!(square = CreateDIBSection(NULL, &bmi, DIB_RGB_COLORS, (void **)&dst, NULL, 0))) goto done;
+    memset(dst, 0, size * size * 4);
+    x0 = (size - w) / 2;
+    y0 = (size - h) / 2;
+    for (y = 0; y < h; y++) memcpy(dst + (y0 + y) * size + x0, pixels + (SIZE_T)y * bm.bmWidth, w * 4);
+    index = ImageList_Add(This->own_icons, square, NULL);
+    DeleteObject(square);
+    if (index >= 0)
+    {
+        lvItem.mask = LVIF_IMAGE;
+        lvItem.iItem = item;
+        lvItem.iSubItem = 0;
+        lvItem.iImage = index;
+        SendMessageW(This->hWndList, LVM_SETITEMW, 0, (LPARAM)&lvItem);
+    }
+done:
+    free(pixels);
+    DeleteObject(result->bitmap);
+    ILFree(result->child);
+    free(result);
+}
