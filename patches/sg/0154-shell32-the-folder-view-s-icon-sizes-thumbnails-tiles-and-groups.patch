+/* the subitems a tile shows: type and size (Tiles), type (Content) */
+static void ShellView_SetTileColumns(IShellViewImpl *This, int item)
+{
+    LVTILEINFO info = { sizeof(info) };
+    UINT columns[2];
+
+    info.iItem = item;
+    info.puColumns = columns;
+    if (This->col_type > 0) columns[info.cColumns++] = This->col_type;
+    if (This->FolderSettings.ViewMode == FVM_TILE && This->col_size > 0) columns[info.cColumns++] = This->col_size;
+    SendMessageW(This->hWndList, LVM_SETTILEINFO, 0, (LPARAM)&info);
+}
