+/* Stained Glass: puts the list view in the mode's view, with the images at
+ * the mode's size, and throws away the pictures made for another size */
+static void ShellView_ApplyViewMode(IShellViewImpl *This)
+{
+    UINT mode = This->FolderSettings.ViewMode;
+    HIMAGELIST big_icons, small_icons, old;
+    int size, i, count;
+    DWORD view;
+
+    if (!This->hWndList) return;
+    SetStyle(This, ViewModeToListStyle(mode), LVS_TYPEMASK);
+    switch (mode)
+    {
+    case FVM_ICON:      view = LV_VIEW_ICON; size = This->icon_size ? This->icon_size : 48; break;
+    case FVM_THUMBNAIL: view = LV_VIEW_ICON; size = 96; break;
+    case FVM_TILE:
+    case FVM_CONTENT:   view = LV_VIEW_TILE; size = 48; break;
+    case FVM_SMALLICON: view = LV_VIEW_SMALLICON; size = 16; break;
+    case FVM_DETAILS:   view = LV_VIEW_DETAILS; size = 16; break;
+    default:            view = LV_VIEW_LIST; size = 16; break;
+    }
+    /* the desktop keeps the system's icons */
+    if (This->FolderSettings.fFlags & FWF_DESKTOP) size = min(size, 32);
+
+    InterlockedIncrement(&This->thumb_gen);
+    This->n_requested = 0;
+    free(This->sys_to_own);
+    This->sys_to_own = NULL;
+    This->n_sys_to_own = 0;
+    if (mode == FVM_ICON) This->icon_size = size;
+    This->image_size = size;
+    This->thumbnails = size >= 48;
+
+    Shell_GetImageLists(&big_icons, &small_icons);
+    old = This->own_icons;
+    This->own_icons = NULL;
+    if (size > 32)
+    {
+        This->own_icons = ImageList_Create(size, size, ILC_COLOR32, 64, 64);
+        ImageList_SetBkColor(This->own_icons, CLR_NONE);
+    }
+
+    SendMessageW(This->hWndList, LVM_SETIMAGELIST, LVSIL_NORMAL, (LPARAM)(This->own_icons ? This->own_icons : big_icons));
+    if (old) ImageList_Destroy(old);
+
+    if (view == LV_VIEW_TILE)
+    {
+        LVTILEVIEWINFO tvi = { sizeof(tvi) };
+        RECT client;
+
+        GetClientRect(This->hWndList, &client);
+        tvi.dwMask = LVTVIM_TILESIZE | LVTVIM_COLUMNS | LVTVIM_LABELMARGIN;
+        if (mode == FVM_CONTENT)
+        {
+            /* a row the width of the view; the dates and sizes are drawn on its right */
+            tvi.dwFlags = LVTVIF_FIXEDWIDTH;
+            tvi.sizeTile.cx = max(client.right - GetSystemMetrics(SM_CXVSCROLL) - 4, 200);
+            tvi.cLines = 1;
+            SetRect(&tvi.rcLabelMargin, 0, 0, min(260, tvi.sizeTile.cx / 2), 0);
+        }
+        else
+        {
+            tvi.dwFlags = LVTVIF_FIXEDWIDTH;
+            tvi.sizeTile.cx = 250;
+            tvi.cLines = 2;
+        }
+        SendMessageW(This->hWndList, LVM_SETTILEVIEWINFO, 0, (LPARAM)&tvi);
+    }
+    SendMessageW(This->hWndList, LVM_SETVIEW, view, 0);
+
+    /* every item asks for its image again */
+    count = SendMessageW(This->hWndList, LVM_GETITEMCOUNT, 0, 0);
+    for (i = 0; i < count; i++)
+    {
+        LVITEMW item = { LVIF_IMAGE, i };
+        item.iImage = I_IMAGECALLBACK;
+        SendMessageW(This->hWndList, LVM_SETITEMW, 0, (LPARAM)&item);
+        if (view == LV_VIEW_TILE) ShellView_SetTileColumns(This, i);
+    }
+    InvalidateRect(This->hWndList, NULL, TRUE);
+}
