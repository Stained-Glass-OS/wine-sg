 /* the header shows which column the view is sorted by, and which way */
+/* Stained Glass: the Content view's right side: "Date modified: ..." and
+ * "Size: ...", and a line under the row */
+static void ShellView_DrawContentColumns(IShellViewImpl *This, NMLVCUSTOMDRAW *cd)
+{
+    LPCITEMIDLIST pidl = (LPCITEMIDLIST)cd->nmcd.lItemlParam;
+    WCHAR value[MAX_PATH], line[MAX_PATH + 32];
+    HDC dc = cd->nmcd.hdc;
+    RECT rc, row = cd->nmcd.rc;
+    int height;
+    HBRUSH brush;
+    TEXTMETRICW tm;
+
+    if (!pidl) return;
+    GetTextMetricsW(dc, &tm);
+    height = tm.tmHeight;
+    rc = row;
+    rc.left = max(rc.left, rc.right - 260);
+    rc.right -= 8;
+    rc.top += (row.bottom - row.top - 2 * height) / 2;
+    SetBkMode(dc, TRANSPARENT);
+    SetTextColor(dc, GetSysColor(COLOR_GRAYTEXT));
+    if (This->col_date >= 0)
+    {
+        column_text(This, pidl, This->col_date, value, MAX_PATH);
+        swprintf(line, ARRAY_SIZE(line), L"Date modified: %s", value);
+        DrawTextW(dc, line, -1, &rc, DT_SINGLELINE | DT_LEFT | DT_END_ELLIPSIS | DT_NOPREFIX);
+    }
+    if (This->col_size >= 0 && _ILIsValue(pidl))
+    {
+        column_text(This, pidl, This->col_size, value, MAX_PATH);
+        swprintf(line, ARRAY_SIZE(line), L"Size: %s", value);
+        rc.top += height;
+        DrawTextW(dc, line, -1, &rc, DT_SINGLELINE | DT_LEFT | DT_END_ELLIPSIS | DT_NOPREFIX);
+    }
+    SetRect(&rc, row.left, row.bottom - 1, row.right, row.bottom);
+    brush = CreateSolidBrush(RGB(0xe8, 0xe8, 0xe8));
+    FillRect(dc, &rc, brush);
+    DeleteObject(brush);
+}
