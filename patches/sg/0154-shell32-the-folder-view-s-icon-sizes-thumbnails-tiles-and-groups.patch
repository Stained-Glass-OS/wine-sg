+/* Stained Glass: a recent document whose name the ANSI code page cannot
+ * spell (Japanese in a Western locale) gets its shortcut in the Recent folder
+ * through the Unicode shell link, which is what File Explorer's Quick access
+ * reads */
+static BOOL SHADD_unicode_link(UINT flags, LPCVOID pv)
+{
+    WCHAR path[MAX_PATH], dir[MAX_PATH], link[MAX_PATH];
+    BOOL lossy = FALSE;
+    IShellLinkW *sl;
+    IPersistFile *pf;
+    HRESULT hr;
+
+    if (flags == SHARD_PIDL) { if (!SHGetPathFromIDListW(pv, path)) return FALSE; }
+    else if (flags == SHARD_PATHW) lstrcpynW(path, pv, MAX_PATH);
+    else return FALSE;
+    WideCharToMultiByte(CP_ACP, 0, path, -1, NULL, 0, NULL, &lossy);
+    if (!lossy) return FALSE;
+    if (SHGetFolderPathW(NULL, CSIDL_RECENT, NULL, SHGFP_TYPE_CURRENT, dir) != S_OK) return FALSE;
+    swprintf(link, MAX_PATH, L"%s\\%s.lnk", dir, PathFindFileNameW(path));
+    if (FAILED(CoCreateInstance(&CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW, (void **)&sl))) return FALSE;
+    IShellLinkW_SetPath(sl, path);
+    if (SUCCEEDED(hr = IShellLinkW_QueryInterface(sl, &IID_IPersistFile, (void **)&pf)))
+    {
+        hr = IPersistFile_Save(pf, link, TRUE);
+        IPersistFile_Release(pf);
+    }
+    IShellLinkW_Release(sl);
+    TRACE("%s: %#lx\n", debugstr_w(link), hr);
+    return SUCCEEDED(hr);
+}
