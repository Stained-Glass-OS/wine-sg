+static LONGLONG day_number(const SYSTEMTIME *st)
+{
+    FILETIME ft;
+    SYSTEMTIME day = *st;
+
+    day.wHour = day.wMinute = day.wSecond = day.wMilliseconds = 0;
+    SystemTimeToFileTime(&day, &ft);
+    return (((LONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime) / (86400LL * 10000000);
+}
+
+/* the rank of an item's group for a property: ranks order the groups */
+static int ShellView_GroupRank(IShellViewImpl *This, LPCITEMIDLIST pidl, WCHAR **types, int *ntypes)
+{
+    WCHAR text[MAX_PATH];
+
+    switch (This->group_pid)
+    {
+    case PID_STG_NAME:
+    {
+        WCHAR c;
+        column_text(This, pidl, 0, text, MAX_PATH);
+        c = towupper(text[0]);
+        if (c >= '0' && c <= '9') return 0;
+        if (c >= 'A' && c <= 'H') return 1;
+        if (c >= 'I' && c <= 'P') return 2;
+        if (c >= 'Q' && c <= 'Z') return 3;
+        return 4;
+    }
+    case PID_STG_WRITETIME:
+    {
+        FILETIME ft, local;
+        SYSTEMTIME now, then;
+        LONGLONG today, day;
+        int dow;
+
+        if (!_ILGetFileDateTime(pidl, &ft)) return 0;
+        FileTimeToLocalFileTime(&ft, &local);
+        FileTimeToSystemTime(&local, &then);
+        GetLocalTime(&now);
+        today = day_number(&now);
+        day = day_number(&then);
+        dow = now.wDayOfWeek;   /* the week starts on Sunday */
+        if (day >= today) return 7;
+        if (day == today - 1) return 6;
+        if (day >= today - dow) return 5;
+        if (day >= today - dow - 7) return 4;
+        if (then.wYear == now.wYear && then.wMonth == now.wMonth) return 3;
+        if ((then.wYear == now.wYear && then.wMonth == now.wMonth - 1) ||
+            (now.wMonth == 1 && then.wMonth == 12 && then.wYear == now.wYear - 1)) return 2;
+        if (then.wYear == now.wYear) return 1;
+        return 0;
+    }
+    case PID_STG_SIZE:
+    {
+        ULONGLONG size;
+        if (!_ILIsValue(pidl)) return 0;
+        size = _ILGetFileSize(pidl, NULL, 0);
+        if (!size) return 1;
+        if (size < 16 * 1024) return 2;
+        if (size < 1024 * 1024) return 3;
+        if (size < 128 * 1024 * 1024) return 4;
+        if (size < 1024 * 1024 * 1024) return 5;
+        if (size < 4ULL * 1024 * 1024 * 1024) return 6;
+        return 7;
+    }
+    case PID_STG_STORAGETYPE:
+    {
+        int i;
+        if (This->col_type < 0) return 0;
+        column_text(This, pidl, This->col_type, text, MAX_PATH);
+        for (i = 0; i < *ntypes; i++) if (!wcscmp(types[i], text)) return i;
+        if (*ntypes < 256 && (types[*ntypes] = wcsdup(text))) return (*ntypes)++;
+        return 0;
+    }
+    }
+    return 0;
+}
+
+static int __cdecl compare_type_names(const void *a, const void *b)
+{
+    return lstrcmpiW(*(const WCHAR **)a, *(const WCHAR **)b);
+}
+
+/* Stained Glass: puts every item in its group (or turns groups off) */
+static void ShellView_Regroup(IShellViewImpl *This)
+{
+    WCHAR *types[256], header[MAX_PATH];
+    int ntypes = 0, count, i, g, ngroups, *ranks, *order = NULL, counts[256] = { 0 };
+    LVGROUP group = { sizeof(group) };
+
+    This->regroup_posted = FALSE;
+    if (!This->hWndList) return;
+    SendMessageW(This->hWndList, WM_SETREDRAW, FALSE, 0);
+    SendMessageW(This->hWndList, LVM_REMOVEALLGROUPS, 0, 0);
+    if (!This->group_pid || This->FolderSettings.ViewMode == FVM_LIST)
+    {
+        SendMessageW(This->hWndList, LVM_ENABLEGROUPVIEW, FALSE, 0);
+        SendMessageW(This->hWndList, WM_SETREDRAW, TRUE, 0);
+        return;
+    }
+    count = SendMessageW(This->hWndList, LVM_GETITEMCOUNT, 0, 0);
+    if (!(ranks = calloc(max(count, 1), sizeof(int)))) goto done;
+    for (i = 0; i < count; i++)
+    {
+        LVITEMW item = { LVIF_PARAM, i };
+        SendMessageW(This->hWndList, LVM_GETITEMW, 0, (LPARAM)&item);
+        ranks[i] = min(ShellView_GroupRank(This, (LPCITEMIDLIST)item.lParam, types, &ntypes), 255);
+    }
+    /* types are ranked by name */
+    if (This->group_pid == PID_STG_STORAGETYPE && ntypes)
+    {
+        WCHAR *sorted[256];
+        int map[256], j;
+        memcpy(sorted, types, ntypes * sizeof(WCHAR *));
+        qsort(sorted, ntypes, sizeof(WCHAR *), compare_type_names);
+        for (i = 0; i < ntypes; i++)
+            for (j = 0; j < ntypes; j++) if (sorted[j] == types[i]) map[i] = j;
+        for (i = 0; i < count; i++) ranks[i] = map[ranks[i]];
+        memcpy(types, sorted, ntypes * sizeof(WCHAR *));
+    }
+    for (i = 0; i < count; i++) counts[ranks[i]]++;
+    ngroups = This->group_pid == PID_STG_STORAGETYPE ? ntypes :
+              This->group_pid == PID_STG_NAME ? ARRAY_SIZE(name_groups) :
+              This->group_pid == PID_STG_WRITETIME ? ARRAY_SIZE(date_groups) : ARRAY_SIZE(size_groups);
+
+    SendMessageW(This->hWndList, LVM_ENABLEGROUPVIEW, TRUE, 0);
+    for (g = 0; g < ngroups; g++)
+    {
+        int rank = This->group_ascending ? g : ngroups - 1 - g;
+        const WCHAR *name = This->group_pid == PID_STG_STORAGETYPE ? types[rank] :
+                            This->group_pid == PID_STG_NAME ? name_groups[rank] :
+                            This->group_pid == PID_STG_WRITETIME ? date_groups[rank] : size_groups[rank];
+        if (!counts[rank]) continue;
+        swprintf(header, ARRAY_SIZE(header), L"%s (%d)", name, counts[rank]);
+        group.mask = LVGF_HEADER | LVGF_GROUPID | LVGF_STATE;
+        group.pszHeader = header;
+        group.iGroupId = rank;
+        group.stateMask = group.state = LVGS_COLLAPSIBLE;
+        SendMessageW(This->hWndList, LVM_INSERTGROUP, -1, (LPARAM)&group);
+    }
+    for (i = 0; i < count; i++)
+    {
+        LVITEMW item = { LVIF_GROUPID, i };
+        item.iGroupId = ranks[i];
+        SendMessageW(This->hWndList, LVM_SETITEMW, 0, (LPARAM)&item);
+    }
+    TRACE("grouped %d items by %lu into %d groups\n", count, This->group_pid, ngroups);
+done:
+    for (i = 0; i < ntypes; i++) free(types[i]);
+    free(ranks);
+    free(order);
+    SendMessageW(This->hWndList, WM_SETREDRAW, TRUE, 0);
+}
+
+/* regroups once the current burst of changes is over */
+static void ShellView_PostRegroup(IShellViewImpl *This)
+{
+    if (!This->group_pid || This->regroup_posted) return;
+    This->regroup_posted = TRUE;
+    PostMessageW(This->hWnd, WM_SV_REGROUP, 0, 0);
+}
