From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 17:22:29 -0700
Subject: [PATCH] windows.applicationmodel: Package.Current has no identity
 outside an installed package

A process whose image is not in an installed package (Software\Wine\AppModel\Packages
InstallLocation) has no package identity on Windows: Package.Current now fails with
APPMODEL_ERROR_NO_PACKAGE (0x80073d54), as ApplicationData does. The invented name,
version 1.0.0.0 and publisher are gone. In a packaged process the IPackage and
IPackageId report the real values from GetCurrentPackageId / FullName / FamilyName /
Path (name, version, architecture, resource id, publisher id, installed location).

diff --git a/dlls/windows.applicationmodel/package.c b/dlls/windows.applicationmodel/package.c
index 764338c..de9d0e6 100644
--- a/dlls/windows.applicationmodel/package.c
+++ b/dlls/windows.applicationmodel/package.c
@@ -21,6 +21,10 @@
 #include "wine/debug.h"
 
 #include "pathcch.h"
+#include "appmodel.h"
+
+LONG WINAPI GetCurrentPackageId( UINT32 *length, BYTE *buffer );
+LONG WINAPI GetCurrentPackagePath( UINT32 *length, WCHAR *path );
 
 #include "windows.storage.h"
 
@@ -121,7 +125,7 @@ static const struct IActivationFactoryVtbl factory_vtbl =
 
 /* The installed location is the folder the program's image is in; it is the
  * ordinary Windows.Storage.StorageFolder of that directory. */
-static HRESULT get_installed_location( IStorageFolder **folder )
+static HRESULT get_installed_location( const WCHAR *package_path, IStorageFolder **folder )
 {
     typedef HRESULT (WINAPI *get_factory_func)( HSTRING, IActivationFactory ** );
     static const WCHAR *class_name = L"Windows.Storage.StorageFolder";
@@ -139,8 +143,12 @@ static HRESULT get_installed_location( IStorageFolder **folder )
     int i;
 
     *folder = NULL;
-    if (!GetModuleFileNameW( NULL, buffer, MAX_PATH )) return HRESULT_FROM_WIN32( GetLastError() );
-    if (FAILED( hr = PathCchRemoveFileSpec( buffer, ARRAY_SIZE(buffer) ) )) return hr;
+    if (package_path && *package_path) lstrcpynW( buffer, package_path, ARRAY_SIZE(buffer) );
+    else
+    {
+        if (!GetModuleFileNameW( NULL, buffer, MAX_PATH )) return HRESULT_FROM_WIN32( GetLastError() );
+        if (FAILED( hr = PathCchRemoveFileSpec( buffer, ARRAY_SIZE(buffer) ) )) return hr;
+    }
 
     if (!(module = LoadLibraryW( L"windows.storage.dll" ))) return HRESULT_FROM_WIN32( GetLastError() );
     if (!(get_factory = (void *)GetProcAddress( module, "DllGetActivationFactory" ))) hr = E_NOTIMPL;
@@ -332,13 +340,21 @@ static const IIterator_PackageVtbl empty_iterator_vtbl =
     empty_iterator_get_Current, empty_iterator_get_HasCurrent, empty_iterator_MoveNext, empty_iterator_GetMany,
 };
 
-/* The package identity of a program that has none: its image name, version
- * 1.0.0.0, no resource id and a publisher of the system's own. */
+/* The identity of the package the process runs in. A process whose image is
+ * not in an installed package has none: Package.Current fails for it with
+ * APPMODEL_ERROR_NO_PACKAGE. */
+struct package_info
+{
+    WCHAR name[256], resource[64], publisher[256], publisher_id[32], full[256], family[256], path[MAX_PATH];
+    PackageVersion version;
+    ProcessorArchitecture arch;
+};
+
 struct package_id
 {
     IPackageId IPackageId_iface;
     LONG ref;
-    WCHAR name[MAX_PATH];
+    struct package_info info;
 };
 
 static struct package_id *impl_from_IPackageId( IPackageId *iface )
@@ -389,80 +405,54 @@ static HRESULT WINAPI package_id_GetTrustLevel( IPackageId *iface, TrustLevel *l
     return S_OK;
 }
 
-#define PUBLISHER L"CN=Stained Glass OS"
-#define PUBLISHER_ID L"vcrs5ymhp0gge"
+static HRESULT id_string( const WCHAR *str, HSTRING *value )
+{
+    if (!value) return E_POINTER;
+    return WindowsCreateString( str, wcslen( str ), value );
+}
 
 static HRESULT WINAPI package_id_get_Name( IPackageId *iface, HSTRING *value )
 {
-    struct package_id *impl = impl_from_IPackageId( iface );
-    if (!value) return E_POINTER;
-    return WindowsCreateString( impl->name, wcslen( impl->name ), value );
+    return id_string( impl_from_IPackageId( iface )->info.name, value );
 }
 
 static HRESULT WINAPI package_id_get_Version( IPackageId *iface, PackageVersion *value )
 {
     if (!value) return E_POINTER;
-    value->Major = 1;
-    value->Minor = value->Build = value->Revision = 0;
+    *value = impl_from_IPackageId( iface )->info.version;
     return S_OK;
 }
 
 static HRESULT WINAPI package_id_get_Architecture( IPackageId *iface, ProcessorArchitecture *value )
 {
     if (!value) return E_POINTER;
-#ifdef __x86_64__
-    *value = ProcessorArchitecture_X64;
-#elif defined(__aarch64__)
-    *value = ProcessorArchitecture_Arm64;
-#elif defined(__arm__)
-    *value = ProcessorArchitecture_Arm;
-#else
-    *value = ProcessorArchitecture_X86;
-#endif
+    *value = impl_from_IPackageId( iface )->info.arch;
     return S_OK;
 }
 
 static HRESULT WINAPI package_id_get_ResourceId( IPackageId *iface, HSTRING *value )
 {
-    if (!value) return E_POINTER;
-    return WindowsCreateString( NULL, 0, value );
+    return id_string( impl_from_IPackageId( iface )->info.resource, value );
 }
 
 static HRESULT WINAPI package_id_get_Publisher( IPackageId *iface, HSTRING *value )
 {
-    if (!value) return E_POINTER;
-    return WindowsCreateString( PUBLISHER, wcslen( PUBLISHER ), value );
+    return id_string( impl_from_IPackageId( iface )->info.publisher, value );
 }
 
 static HRESULT WINAPI package_id_get_PublisherId( IPackageId *iface, HSTRING *value )
 {
-    if (!value) return E_POINTER;
-    return WindowsCreateString( PUBLISHER_ID, wcslen( PUBLISHER_ID ), value );
+    return id_string( impl_from_IPackageId( iface )->info.publisher_id, value );
 }
 
 static HRESULT WINAPI package_id_get_FullName( IPackageId *iface, HSTRING *value )
 {
-    struct package_id *impl = impl_from_IPackageId( iface );
-    ProcessorArchitecture arch;
-    const WCHAR *arch_name;
-    WCHAR buffer[MAX_PATH + 64];
-
-    if (!value) return E_POINTER;
-    package_id_get_Architecture( iface, &arch );
-    arch_name = arch == ProcessorArchitecture_X64 ? L"x64" : arch == ProcessorArchitecture_Arm64 ? L"arm64" :
-                arch == ProcessorArchitecture_Arm ? L"arm" : L"x86";
-    swprintf( buffer, ARRAY_SIZE(buffer), L"%s_1.0.0.0_%s__%s", impl->name, arch_name, PUBLISHER_ID );
-    return WindowsCreateString( buffer, wcslen( buffer ), value );
+    return id_string( impl_from_IPackageId( iface )->info.full, value );
 }
 
 static HRESULT WINAPI package_id_get_FamilyName( IPackageId *iface, HSTRING *value )
 {
-    struct package_id *impl = impl_from_IPackageId( iface );
-    WCHAR buffer[MAX_PATH + 32];
-
-    if (!value) return E_POINTER;
-    swprintf( buffer, ARRAY_SIZE(buffer), L"%s_%s", impl->name, PUBLISHER_ID );
-    return WindowsCreateString( buffer, wcslen( buffer ), value );
+    return id_string( impl_from_IPackageId( iface )->info.family, value );
 }
 
 static const IPackageIdVtbl package_id_vtbl =
@@ -478,6 +468,7 @@ struct package
 {
     IPackage IPackage_iface;
     LONG ref;
+    struct package_info info;
 };
 
 static inline struct package *impl_from_IPackage( IPackage *iface )
@@ -543,8 +534,8 @@ static HRESULT WINAPI package_GetTrustLevel( IPackage *iface, TrustLevel *trust_
 
 static HRESULT WINAPI package_get_Id( IPackage *iface, IPackageId **value )
 {
+    struct package *package = impl_from_IPackage( iface );
     struct package_id *impl;
-    WCHAR path[MAX_PATH], *name, *dot;
 
     TRACE( "iface %p, value %p\n", iface, value );
 
@@ -552,23 +543,19 @@ static HRESULT WINAPI package_get_Id( IPackage *iface, IPackageId **value )
     if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
     impl->IPackageId_iface.lpVtbl = &package_id_vtbl;
     impl->ref = 1;
-    if (GetModuleFileNameW( NULL, path, MAX_PATH ))
-    {
-        name = wcsrchr( path, '\\' );
-        name = name ? name + 1 : path;
-        if ((dot = wcsrchr( name, '.' ))) *dot = 0;
-        lstrcpynW( impl->name, name, ARRAY_SIZE(impl->name) );
-    }
+    impl->info = package->info;
     *value = &impl->IPackageId_iface;
     return S_OK;
 }
 
 static HRESULT WINAPI package_get_InstalledLocation( IPackage *iface, IStorageFolder **value )
 {
+    struct package *impl = impl_from_IPackage( iface );
+
     TRACE( "iface %p, value %p\n", iface, value );
 
     if (!value) return E_INVALIDARG;
-    return get_installed_location( value );
+    return get_installed_location( impl->info.path, value );
 }
 
 static HRESULT WINAPI package_get_IsFramework( IPackage *iface, boolean *value )
@@ -616,11 +603,56 @@ DEFINE_IINSPECTABLE( package_statics, IPackageStatics, struct package_statics, I
 static HRESULT WINAPI package_statics_get_Current( IPackageStatics *iface, IPackage **value )
 {
     struct package *impl;
+    struct package_info *info;
+    PACKAGE_ID *id;
+    BYTE id_buffer[1024];
+    UINT32 len;
+    LONG err;
 
     TRACE( "iface %p, value %p\n", iface, value );
 
     if (!value) return E_INVALIDARG;
+    *value = NULL;
+
+    /* a process outside any package has no identity */
+    len = 0;
+    if ((err = GetCurrentPackageFullName( &len, NULL )) == APPMODEL_ERROR_NO_PACKAGE)
+        return HRESULT_FROM_WIN32( APPMODEL_ERROR_NO_PACKAGE );
     if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    info = &impl->info;
+
+    len = ARRAY_SIZE(info->full);
+    if (!(err = GetCurrentPackageFullName( &len, info->full )))
+    {
+        len = ARRAY_SIZE(info->family);
+        err = GetCurrentPackageFamilyName( &len, info->family );
+    }
+    if (!err)
+    {
+        len = sizeof(id_buffer);
+        err = GetCurrentPackageId( &len, id_buffer );
+    }
+    if (!err)
+    {
+        len = ARRAY_SIZE(info->path);
+        err = GetCurrentPackagePath( &len, info->path );
+    }
+    if (err)
+    {
+        free( impl );
+        return HRESULT_FROM_WIN32( err );
+    }
+
+    id = (PACKAGE_ID *)id_buffer;
+    lstrcpynW( info->name, id->name ? id->name : L"", ARRAY_SIZE(info->name) );
+    lstrcpynW( info->resource, id->resourceId ? id->resourceId : L"", ARRAY_SIZE(info->resource) );
+    lstrcpynW( info->publisher, id->publisher ? id->publisher : L"", ARRAY_SIZE(info->publisher) );
+    lstrcpynW( info->publisher_id, id->publisherId ? id->publisherId : L"", ARRAY_SIZE(info->publisher_id) );
+    info->version.Major = id->version.Major;
+    info->version.Minor = id->version.Minor;
+    info->version.Build = id->version.Build;
+    info->version.Revision = id->version.Revision;
+    info->arch = id->processorArchitecture;
 
     impl->IPackage_iface.lpVtbl = &package_vtbl;
     impl->ref = 1;
diff --git a/dlls/windows.applicationmodel/tests/model.c b/dlls/windows.applicationmodel/tests/model.c
index f704e78..d31b894 100644
--- a/dlls/windows.applicationmodel/tests/model.c
+++ b/dlls/windows.applicationmodel/tests/model.c
@@ -569,8 +569,8 @@ static void test_PackageStatics(void)
     hr = IPackageStatics_get_Current( package_statics, NULL );
     ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
     hr = IPackageStatics_get_Current( package_statics, &package );
-    todo_wine ok( hr == 0x80073d54, "got hr %#lx.\n", hr );
-    todo_wine ok( !package, "got package %p.\n", package );
+    ok( hr == 0x80073d54, "got hr %#lx.\n", hr );
+    ok( !package, "got package %p.\n", package );
     if (package) IPackage_Release( package );
 
     ref = IPackageStatics_Release( package_statics );
