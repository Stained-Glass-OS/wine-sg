+/* Stained Glass OS 1692: axis values as the weight, stretch and style
+ * they stand for (wdth is a percentage of normal width) */
+static void axis_values_to_props(DWRITE_FONT_AXIS_VALUE const *values, UINT32 count, DWRITE_FONT_WEIGHT *weight,
+        DWRITE_FONT_STRETCH *stretch, DWRITE_FONT_STYLE *style)
+{
+    static const float widths[] = { 50.0f, 62.5f, 75.0f, 87.5f, 100.0f, 112.5f, 125.0f, 150.0f, 200.0f };
+    unsigned int i, j;
+
+    *weight = DWRITE_FONT_WEIGHT_NORMAL;
+    *stretch = DWRITE_FONT_STRETCH_NORMAL;
+    *style = DWRITE_FONT_STYLE_NORMAL;
+    for (i = 0; i < count; ++i)
+    {
+        switch (values[i].axisTag)
+        {
+        case DWRITE_FONT_AXIS_TAG_WEIGHT:
+            *weight = min(max(values[i].value, 1.0f), 1000.0f);
+            break;
+        case DWRITE_FONT_AXIS_TAG_WIDTH:
+            *stretch = DWRITE_FONT_STRETCH_ULTRA_CONDENSED;
+            for (j = 0; j < ARRAY_SIZE(widths); ++j)
+                if (values[i].value >= widths[j] - 0.01f) *stretch = j + 1;
+            break;
+        case DWRITE_FONT_AXIS_TAG_ITALIC:
+            if (values[i].value >= 1.0f) *style = DWRITE_FONT_STYLE_ITALIC;
+            break;
+        case DWRITE_FONT_AXIS_TAG_SLANT:
+            if (values[i].value != 0.0f && *style == DWRITE_FONT_STYLE_NORMAL) *style = DWRITE_FONT_STYLE_OBLIQUE;
+            break;
+        default:
+            break;
+        }
+    }
+}
+
