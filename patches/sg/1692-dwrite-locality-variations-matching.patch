+/* Stained Glass OS 1692: the runs the source gives a number substitution
+ * to, with their digits, told to the sink */
 static HRESULT WINAPI dwritetextanalyzer_AnalyzeNumberSubstitution(IDWriteTextAnalyzer2 *iface,
     IDWriteTextAnalysisSource* source, UINT32 position, UINT32 length, IDWriteTextAnalysisSink* sink)
 {
-    static int once;
+    UINT32 pos = position, end = position + length;
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p, %u, %u, %p.\n", iface, source, position, length, sink);
+
+    if (!length) return S_OK;
+    if (!source || !sink) return E_INVALIDARG;
+    while (pos < end)
+    {
+        IDWriteNumberSubstitution *subst = NULL;
+        const WCHAR *text = NULL;
+        UINT32 run_len = 0, text_len = 0, i, start;
 
-    if (!once++)
-        FIXME("(%p %u %u %p): stub\n", source, position, length, sink);
+        if (FAILED(hr = IDWriteTextAnalysisSource_GetNumberSubstitution(source, pos, &run_len, &subst))) return hr;
+        if (!run_len) break;
+        run_len = min(run_len, end - pos);
+        if (subst)
+        {
+#ifndef SG_MUTANT_NO_NUMBER_SUBST
+            /* the digits of the run, each span of them */
+            for (i = 0; i < run_len; )
+            {
+                if (FAILED(hr = IDWriteTextAnalysisSource_GetTextAtPosition(source, pos + i, &text, &text_len)) ||
+                    !text || !text_len)
+                    break;
+                text_len = min(text_len, run_len - i);
+                start = i;
+                while (i - start < text_len && !(text[i - start] >= '0' && text[i - start] <= '9')) i++;
+                if (i - start < text_len)
+                {
+                    UINT32 first = i;
+                    while (i - start < text_len && text[i - start] >= '0' && text[i - start] <= '9') i++;
+                    if (FAILED(hr = IDWriteTextAnalysisSink_SetNumberSubstitution(sink, pos + first, i - first, subst)))
+                        break;
+                }
+            }
+#endif
+            IDWriteNumberSubstitution_Release(subst);
+            if (FAILED(hr)) return hr;
+        }
+        pos += run_len;
+    }
     return S_OK;
 }
 
