From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, win32u: keys that type no character have the names Windows gives them

GetKeyNameText named the keys that type no character by their X keysyms: 'Control_L' (with the don't-care bit),
'Return', 'Prior', 'KP_Home', 'BackSpace', 'Super_L', 'Caps_Lock'. Everything's File menu read 'Control_L+N' where
Windows shows 'Ctrl+N', and every program that builds shortcut labels this way did the same. winex11 now names
only keys that type a character (by the character, as before) and leaves the others to win32u's key name tables:
Ctrl, Right Ctrl, Enter, Page Up, Num 7, Backspace, Left Windows, Caps Lock. A layout whose tables name no such
key gets the US names for it.
---
diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
index 4461ce6..e3701d9 100644
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -1284,9 +1284,16 @@ INT WINAPI NtUserGetKeyNameText( LONG lparam, WCHAR *buffer, INT size )
 
     if (code < 0x100) key_name = kbd_tables->pKeyNames;
     else key_name = kbd_tables->pKeyNamesExt;
-    while (key_name->vsc && key_name->vsc != (BYTE)code) key_name++;
+    while (key_name && key_name->vsc && key_name->vsc != (BYTE)code) key_name++;
+    /* Stained Glass OS: a layout whose tables name no such key (the X
+     * driver's for a foreign layout) has the US names for it */
+    if ((!key_name || key_name->vsc != (BYTE)code || !key_name->pwsz) && kbd_tables != &kbdus_tables)
+    {
+        key_name = code < 0x100 ? kbdus_tables.pKeyNames : kbdus_tables.pKeyNamesExt;
+        while (key_name->vsc && key_name->vsc != (BYTE)code) key_name++;
+    }
 
-    if (key_name->vsc == (BYTE)code && key_name->pwsz)
+    if (key_name && key_name->vsc == (BYTE)code && key_name->pwsz)
     {
         len = min( size - 1, wcslen( key_name->pwsz ) );
         memcpy( buffer, key_name->pwsz, len * sizeof(WCHAR) );
diff --git a/dlls/winex11.drv/keyboard.c b/dlls/winex11.drv/keyboard.c
index e13e4ca..7dbaf0f 100644
--- a/dlls/winex11.drv/keyboard.c
+++ b/dlls/winex11.drv/keyboard.c
@@ -2206,6 +2206,14 @@ INT X11DRV_GetKeyNameText( LONG lParam, LPWSTR lpBuffer, INT nSize )
        (scanCode == 0x157) || (scanCode == 0x158))
     scanCode &= 0xff;   /* remove "extended-key" flag for Fx keys */
 
+#ifndef SG_MUTANT_KEYSYM_KEY_NAMES
+  /* Stained Glass OS: the other keys have the names Windows gives them
+   * ("Ctrl", "Enter", "Page Up", "Right Shift", "Num 7"), from win32u's
+   * tables, not X keysym names ("Control_L", "Return", "Prior", "KP_Home")
+   * -- programs show them in menus and shortcut settings */
+  return -1;
+#endif
+
   /* let's do scancode -> keycode -> keysym -> String */
 
   pthread_mutex_lock( &kbd_mutex );
