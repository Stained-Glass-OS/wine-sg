diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
index b3c72da..eff4dd5 100644
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -2564,6 +2564,25 @@ void toggle_caret( HWND hwnd )
 }
 
 
+/**********************************************************************
+ *       NtUserBlockInput    (win32u.@)
+ *
+ * Blocks the hardware input of the desktop (and what other threads send) until the blocking thread unblocks it or exits.
+ */
+BOOL WINAPI NtUserBlockInput( BOOL block )
+{
+    NTSTATUS status;
+
+    SERVER_START_REQ( block_input )
+    {
+        req->block = block;
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    if (status) RtlSetLastWin32Error( RtlNtStatusToDosError( status ));
+    return !status;
+}
+
 /**********************************************************************
  *       NtUserEnableMouseInPointer    (win32u.@)
  */
