index f4c9ab1..4c8d13f 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -2923,12 +2923,29 @@ NTSTATUS WINAPI NtWaitForAlertByThreadId( const void *address, const LARGE_INTEG
 NTSTATUS WINAPI NtCreateTransaction( HANDLE *handle, ACCESS_MASK mask, OBJECT_ATTRIBUTES *obj_attr, GUID *guid, HANDLE tm,
         ULONG options, ULONG isol_level, ULONG isol_flags, PLARGE_INTEGER timeout, UNICODE_STRING *description )
 {
-    FIXME( "%p, %#x, %p, %s, %p, 0x%08x, 0x%08x, 0x%08x, %p, %p stub.\n", handle, (int)mask, obj_attr, debugstr_guid(guid), tm,
-            (int)options, (int)isol_level, (int)isol_flags, timeout, description );
+    struct object_attributes *objattr;
+    data_size_t len;
+    NTSTATUS ret;
 
-    *handle = ULongToHandle(1);
+    TRACE( "%p, %#x, %p, %s, %p, 0x%08x, 0x%08x, 0x%08x, %p, %p\n", handle, (int)mask, obj_attr, debugstr_guid(guid), tm,
+           (int)options, (int)isol_level, (int)isol_flags, timeout, description );
 
-    return STATUS_SUCCESS;
+    /* the guid, the isolation, the timeout and the description describe a transaction nobody enlists in: not kept */
+    *handle = 0;
+    if ((ret = alloc_object_attributes( obj_attr, &objattr, &len ))) return ret;
+
+    SERVER_START_REQ( create_transaction )
+    {
+        req->access = mask;
+        req->options = options;
+        wine_server_add_data( req, objattr, len );
+        ret = wine_server_call( req );
+        *handle = wine_server_ptr_handle( reply->handle );
+    }
+    SERVER_END_REQ;
+
+    free( objattr );
+    return ret;
 }
 
 /***********************************************************************
@@ -2936,9 +2953,18 @@ NTSTATUS WINAPI NtCreateTransaction( HANDLE *handle, ACCESS_MASK mask, OBJECT_AT
  */
 NTSTATUS WINAPI NtCommitTransaction( HANDLE transaction, BOOLEAN wait )
 {
-    FIXME( "%p, %d stub.\n", transaction, wait );
+    NTSTATUS ret;
 
-    return STATUS_SUCCESS;
+    TRACE( "%p, %d\n", transaction, wait );
+
+    SERVER_START_REQ( transaction_op )
+    {
+        req->handle = wine_server_obj_handle( transaction );
+        req->rollback = 0;
+        ret = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    return ret;
 }
 
 /***********************************************************************
@@ -2946,7 +2972,16 @@ NTSTATUS WINAPI NtCommitTransaction( HANDLE transaction, BOOLEAN wait )
  */
 NTSTATUS WINAPI NtRollbackTransaction( HANDLE transaction, BOOLEAN wait )
 {
-    FIXME( "%p, %d stub.\n", transaction, wait );
+    NTSTATUS ret;
 
-    return STATUS_ACCESS_VIOLATION;
+    TRACE( "%p, %d\n", transaction, wait );
+
+    SERVER_START_REQ( transaction_op )
+    {
+        req->handle = wine_server_obj_handle( transaction );
+        req->rollback = 1;
+        ret = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    return ret;
 }
