 /* send a hardware message to a thread queue */
+/* the thread that blocks the input of the desktop, if it is still there */
+static struct thread *get_input_blocker( struct desktop *desktop )
+{
+    struct thread *thread;
+
+    if (!desktop->input_blocker) return NULL;
+    if ((thread = get_thread_from_id( desktop->input_blocker )))
+    {
+        if (thread->state != TERMINATED) return thread;
+        release_object( thread );
+    }
+    desktop->input_blocker = 0;   /* its thread is gone: the input is free again */
+    return NULL;
+}
+
+/* BlockInput: the input of the desktop of the current thread goes to nobody but the blocking thread's own SendInput */
+DECL_HANDLER(block_input)
+{
+    struct desktop *desktop = get_thread_desktop( current, 0 );
+    struct thread *blocker;
+
+    if (!desktop) return;
+    blocker = get_input_blocker( desktop );
+    if (blocker && blocker != current) set_error( STATUS_ACCESS_DENIED );   /* blocked by another thread */
+    else desktop->input_blocker = req->block ? current->id : 0;
+    if (blocker) release_object( blocker );
+    release_object( desktop );
+}
+
 DECL_HANDLER(send_hardware_message)
 {
     struct desktop *desktop;
@@ -3542,6 +3571,23 @@ DECL_HANDLER(send_hardware_message)
     }
     desktop_shm = desktop->shared;
 
+    /* BlockInput: physical input is dropped, and so is what another thread sends */
+    {
+        struct thread *blocker = get_input_blocker( desktop );
+        if (blocker)
+        {
+            int dropped = origin == IMO_HARDWARE || blocker != current;
+            release_object( blocker );
+            if (dropped)
+            {
+                reply->prev_x = reply->new_x = desktop_shm->cursor.x;
+                reply->prev_y = reply->new_y = desktop_shm->cursor.y;
+                release_object( desktop );
+                return;
+            }
+        }
+    }
+
     reply->prev_x = desktop_shm->cursor.x;
     reply->prev_y = desktop_shm->cursor.y;
 
