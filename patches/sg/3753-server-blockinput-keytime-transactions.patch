+/* ---- transactions (NtCreateTransaction, NtCommitTransaction, NtRollbackTransaction) ----
+ * A transaction is a handle that is active until it is committed or rolled back; nothing enlists in it. */
+
+#define TRANSACTION_QUERY_INFORMATION 0x0001
+#define TRANSACTION_SET_INFORMATION   0x0002
+#define TRANSACTION_ENLIST            0x0004
+#define TRANSACTION_COMMIT            0x0008
+#define TRANSACTION_ROLLBACK          0x0010
+#define TRANSACTION_PROPAGATE         0x0020
+#define TRANSACTION_RIGHT_RESERVED1   0x0040
+#define TRANSACTION_GENERIC_READ      (STANDARD_RIGHTS_READ | TRANSACTION_QUERY_INFORMATION | SYNCHRONIZE)
+#define TRANSACTION_GENERIC_WRITE     (STANDARD_RIGHTS_WRITE | TRANSACTION_SET_INFORMATION | TRANSACTION_COMMIT | \
+                                       TRANSACTION_ENLIST | TRANSACTION_ROLLBACK | TRANSACTION_PROPAGATE | SYNCHRONIZE)
+#define TRANSACTION_GENERIC_EXECUTE   (STANDARD_RIGHTS_EXECUTE | TRANSACTION_COMMIT | TRANSACTION_ROLLBACK | SYNCHRONIZE)
+#define TRANSACTION_ALL_ACCESS        (STANDARD_RIGHTS_REQUIRED | SYNCHRONIZE | 0x7f)
+
+static const WCHAR transaction_name[] = {'T','r','a','n','s','a','c','t','i','o','n'};
+
+struct type_descr transaction_type =
+{
+    { transaction_name, sizeof(transaction_name) },   /* name */
+    TRANSACTION_ALL_ACCESS,                           /* valid_access */
+    {                                                 /* mapping */
+        TRANSACTION_GENERIC_READ,
+        TRANSACTION_GENERIC_WRITE,
+        TRANSACTION_GENERIC_EXECUTE,
+        TRANSACTION_ALL_ACCESS
+    },
+};
+
+enum transaction_state { TRANSACTION_ACTIVE, TRANSACTION_COMMITTED, TRANSACTION_ABORTED };
+
+struct transaction
+{
+    struct object obj;              /* object header */
+    enum transaction_state state;
+};
+
+static void transaction_dump( struct object *obj, int verbose );
+
+static const struct object_ops transaction_ops =
+{
+    sizeof(struct transaction),  /* size */
+    &transaction_type,           /* type */
+    transaction_dump,            /* dump */
+    no_add_queue,                /* add_queue */
+    NULL,                        /* remove_queue */
+    NULL,                        /* signaled */
+    NULL,                        /* satisfied */
+    no_signal,                   /* signal */
+    no_get_fd,                   /* get_fd */
+    default_map_access,          /* map_access */
+    default_get_sd,              /* get_sd */
+    default_set_sd,              /* set_sd */
+    default_get_full_name,       /* get_full_name */
+    no_lookup_name,              /* lookup_name */
+    directory_link_name,         /* link_name */
+    default_unlink_name,         /* unlink_name */
+    no_open_file,                /* open_file */
+    no_kernel_obj_list,          /* get_kernel_obj_list */
+    no_close_handle,             /* close_handle */
+    no_destroy                   /* destroy */
+};
+
+static void transaction_dump( struct object *obj, int verbose )
+{
+    struct transaction *transaction = (struct transaction *)obj;
+    assert( obj->ops == &transaction_ops );
+    fprintf( stderr, "Transaction state=%u\n", transaction->state );
+}
+
+DECL_HANDLER(create_transaction)
+{
+    struct transaction *transaction;
+    struct unicode_str name;
+    struct object *root;
+    const struct security_descriptor *sd;
+    const struct object_attributes *objattr = get_req_object_attributes( &sd, &name, &root );
+
+    if (!objattr) return;
+
+    if ((transaction = create_named_object( root, &transaction_ops, &name, objattr->attributes, sd )))
+    {
+        if (get_error() != STATUS_OBJECT_NAME_EXISTS)
+        {
+            /* initialize it if it didn't already exist */
+            transaction->state = TRANSACTION_ACTIVE;
+            reply->handle = alloc_handle_no_access_check( current->process, transaction, req->access, objattr->attributes );
+        }
+        else
+            reply->handle = alloc_handle( current->process, transaction, req->access, objattr->attributes );
+        release_object( transaction );
+    }
+    if (root) release_object( root );
+}
+
+/* commit or roll back: only an active transaction can be ended; ending it twice, or the other way, is an error */
+DECL_HANDLER(transaction_op)
+{
+    struct transaction *transaction;
+
+    if (!(transaction = (struct transaction *)get_handle_obj( current->process, req->handle,
+                                                              req->rollback ? TRANSACTION_ROLLBACK : TRANSACTION_COMMIT,
+                                                              &transaction_ops )))
+        return;
+    if (transaction->state == TRANSACTION_COMMITTED) set_error( STATUS_TRANSACTION_ALREADY_COMMITTED );
+    else if (transaction->state == TRANSACTION_ABORTED) set_error( STATUS_TRANSACTION_ALREADY_ABORTED );
+    else transaction->state = req->rollback ? TRANSACTION_ABORTED : TRANSACTION_COMMITTED;
+    release_object( transaction );
+}
+
