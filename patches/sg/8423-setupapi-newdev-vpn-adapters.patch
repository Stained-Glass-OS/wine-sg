+/***********************************************************************
+ *           DiInstallDevice (NEWDEV.@)
+ *
+ * Stained Glass OS (vpn2, i1014): installs a driver on a device -- the one given, or with none
+ * given the best one in the driver store -- as Windows does. OpenVPN's tapctl (its MSI's
+ * InstallTUNTAPAdapters) creates its Wintun, TAP-Windows6 and ovpn-dco adapters with it; the stub
+ * ended the custom action ("unimplemented function newdev.dll.DiInstallDevice") and left a
+ * half-made device behind that "tapctl list" stopped at.
+ */
+BOOL WINAPI DiInstallDevice(HWND parent, HDEVINFO devinfo, SP_DEVINFO_DATA *device_data,
+                            SP_DRVINFO_DATA_W *driver_data, DWORD flags, BOOL *reboot)
+{
+    SP_DEVINSTALL_PARAMS_W params = {sizeof(params)};
+    BOOL wow64 = FALSE;
+    DWORD i;
+
+    TRACE("parent %p, devinfo %p, device_data %p, driver_data %p, flags %#lx, reboot %p.\n",
+          parent, devinfo, device_data, driver_data, flags, reboot);
+
+    if (reboot) *reboot = FALSE;
+    if (flags & ~(DIIDFLAG_SHOWSEARCHUI | DIIDFLAG_NOFINISHINSTALLUI | DIIDFLAG_INSTALLNULLDRIVER | DIIDFLAG_INSTALLCOPYINFDRIVERS))
+    {
+        SetLastError(ERROR_INVALID_FLAGS);
+        return FALSE;
+    }
+    if (!devinfo || devinfo == INVALID_HANDLE_VALUE || !device_data)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (IsWow64Process(GetCurrentProcess(), &wow64) && wow64)
+    {
+        SetLastError(ERROR_IN_WOW64);
+        return FALSE;
+    }
+    if (!is_admin())
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+    if (flags & DIIDFLAG_INSTALLNULLDRIVER)
+    {
+        /* no driver: the device is set up with none */
+        if (!SetupDiSetSelectedDriverW(devinfo, device_data, NULL)) return FALSE;
+        if (!SetupDiCallClassInstaller(DIF_INSTALLDEVICE, devinfo, device_data) && GetLastError() != ERROR_DI_DO_DEFAULT)
+            return FALSE;
+        SetLastError(ERROR_SUCCESS);
+        return TRUE;
+    }
+
+    if (driver_data)
+    {
+        if (!SetupDiSetSelectedDriverW(devinfo, device_data, driver_data)) return FALSE;
+    }
+    else
+    {
+        /* the best driver of the driver store (the INF folder) for the device's IDs */
+        if (!SetupDiGetDeviceInstallParamsW(devinfo, device_data, &params)) return FALSE;
+        params.Flags &= ~DI_ENUMSINGLEINF;
+        params.DriverPath[0] = 0;
+        if (!SetupDiSetDeviceInstallParamsW(devinfo, device_data, &params)) return FALSE;
+        if (!SetupDiBuildDriverInfoList(devinfo, device_data, SPDIT_COMPATDRIVER)) return FALSE;
+#ifndef SG_MUTANT_DIINSTALLDEVICE_NO_BEST
+        if (!SetupDiCallClassInstaller(DIF_SELECTBESTCOMPATDRV, devinfo, device_data) && GetLastError() != ERROR_DI_DO_DEFAULT)
+#else
+        if (1)
+#endif
+        {
+            if (GetLastError() == ERROR_NO_COMPAT_DRIVERS) SetLastError(ERROR_NO_DRIVER_SELECTED);
+            return FALSE;
+        }
+    }
+
+    for (i = 1; i < ARRAY_SIZE(dif_list); ++i)
+    {
+        if (dif_list[i] == DIF_NEWDEVICEWIZARD_FINISHINSTALL && (flags & DIIDFLAG_NOFINISHINSTALLUI)) continue;
+        if (!SetupDiCallClassInstaller(dif_list[i], devinfo, device_data) && GetLastError() != ERROR_DI_DO_DEFAULT)
+            return FALSE;
+    }
+    if (reboot && SetupDiGetDeviceInstallParamsW(devinfo, device_data, &params))
+        *reboot = !!(params.Flags & (DI_NEEDREBOOT | DI_NEEDRESTART));
+    SetLastError(ERROR_SUCCESS);
+    return TRUE;
+}
 
