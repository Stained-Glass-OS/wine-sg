+/* Stained Glass OS (vpn2, i1014): the class install parameters of a device, or of the set with no
+ * device -- where they are kept, and the install parameters whose DI_CLASSINSTALLPARAMS tells */
+static BOOL class_install_params_slot(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data, BYTE ***params, DWORD **size,
+                                      SP_DEVINSTALL_PARAMS_W **install)
+{
+    struct DeviceInfoSet *set;
+    struct device *device;
+
+    if (!(set = get_device_set(devinfo))) return FALSE;
+    if (device_data)
+    {
+        if (!(device = get_device(devinfo, device_data))) return FALSE;
+        *params = &device->class_install_params;
+        *size = &device->class_install_params_size;
+        *install = &device->params;
+    }
+    else
+    {
+        *params = &set->class_install_params;
+        *size = &set->class_install_params_size;
+        *install = NULL;
+    }
+    return TRUE;
+}
