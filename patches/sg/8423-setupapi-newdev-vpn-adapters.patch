+/* Stained Glass OS (vpn2, i1014): a class driver list -- every model of every INF of the class
+ * (its [Version] ClassGUID; any class for a set without one), as Windows builds it for
+ * SPDIT_CLASSDRIVER. Wintun's installer (OpenVPN, WireGuard's older MSIs) lists the Net class's
+ * drivers to remove its old ones first; "unhandled type" failed the install ("Failed to uninstall
+ * old drivers", msiexec exit 1603). */
+static void enum_class_drivers_from_file(const WCHAR *path, const GUID *class,
+                                         struct driver **list, unsigned int *count)
+{
+    WCHAR mfg_key[LINE_LEN], classname[MAX_CLASS_NAME_LEN];
+    struct driver driver, *drivers = *list;
+    unsigned int driver_count = *count;
+    INFCONTEXT ctx, line;
+    GUID inf_class;
+    DWORD i, j;
+    HINF hinf;
+
+    if (class && !IsEqualGUID(class, &GUID_NULL)
+            && (!SetupDiGetINFClassW(path, &inf_class, classname, ARRAY_SIZE(classname), NULL)
+                || !IsEqualGUID(class, &inf_class)))
+        return;
+    if ((hinf = SetupOpenInfFileW(path, NULL, INF_STYLE_WIN4, NULL)) == INVALID_HANDLE_VALUE)
+        return;
+
+    memset(&driver, 0, sizeof(driver));
+    lstrcpyW(driver.inf_path, path);
+    driver.type = SPDIT_CLASSDRIVER;
+    parse_driver_ver(hinf, &driver);
+
+    for (i = 0; SetupGetLineByIndexW(hinf, L"Manufacturer", i, &ctx); ++i)
+    {
+        SetupGetStringFieldW(&ctx, 0, driver.manufacturer, ARRAY_SIZE(driver.manufacturer), NULL);
+        if (!SetupGetStringFieldW(&ctx, 1, mfg_key, ARRAY_SIZE(mfg_key), NULL))
+            lstrcpyW(mfg_key, driver.manufacturer);
+        if (!any_version_is_compatible(&ctx))
+            continue;
+        if (!SetupDiGetActualSectionToInstallW(hinf, mfg_key, driver.mfg_key, ARRAY_SIZE(driver.mfg_key), NULL, NULL))
+            continue;
+        for (j = 0; SetupGetLineByIndexW(hinf, driver.mfg_key, j, &line); ++j)
+        {
+            struct driver *grown;
+
+            driver.rank = 0;
+            driver.description[0] = driver.section[0] = driver.matching_id[0] = 0;
+            SetupGetStringFieldW(&line, 0, driver.description, ARRAY_SIZE(driver.description), NULL);
+            SetupGetStringFieldW(&line, 1, driver.section, ARRAY_SIZE(driver.section), NULL);
+            SetupGetStringFieldW(&line, 2, driver.matching_id, ARRAY_SIZE(driver.matching_id), NULL);
+            if (!(grown = realloc(drivers, (driver_count + 1) * sizeof(*drivers)))) break;
+            drivers = grown;
+            drivers[driver_count++] = driver;
+        }
+    }
+    SetupCloseInfFile(hinf);
+    *list = drivers;
+    *count = driver_count;
+}
+
+static BOOL build_class_driver_list(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data)
+{
+    WCHAR dir[MAX_PATH], file[MAX_PATH];
+    struct DeviceInfoSet *set;
+    struct device *device = NULL;
+    struct driver **list;
+    unsigned int *count;
+    WIN32_FIND_DATAW find_data;
+    HANDLE find_handle;
+    const GUID *class;
+    WCHAR *p;
+
+    if (!(set = get_device_set(devinfo)))
+        return FALSE;
+    if (device_data)
+    {
+        if (!(device = get_device(devinfo, device_data)))
+            return FALSE;
+        list = &device->class_drivers;
+        count = &device->class_driver_count;
+        class = &device->class;
+    }
+    else
+    {
+        list = &set->class_drivers;
+        count = &set->class_driver_count;
+        class = &set->ClassGuid;
+    }
+    if (*count) return TRUE;  /* built already, as Windows keeps it until it is destroyed */
+
+    if (device && (device->params.Flags & DI_ENUMSINGLEINF))
+    {
+        enum_class_drivers_from_file(device->params.DriverPath, class, list, count);
+        return TRUE;
+    }
+    if (device && device->params.DriverPath[0])
+        lstrcpyW(dir, device->params.DriverPath);
+    else
+    {
+        GetWindowsDirectoryW(dir, MAX_PATH - 8);
+        lstrcatW(dir, L"\\inf");
+    }
+    lstrcpyW(file, dir);
+    lstrcatW(file, L"\\*.inf");
+    if ((find_handle = FindFirstFileW(file, &find_data)) == INVALID_HANDLE_VALUE)
+        return TRUE;
+    do
+    {
+        if (find_data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        if (lstrlenW(dir) + lstrlenW(find_data.cFileName) + 2 > MAX_PATH) continue;
+        lstrcpyW(file, dir);
+        p = file + lstrlenW(file);
+        *p++ = '\\';
+        lstrcpyW(p, find_data.cFileName);
+        enum_class_drivers_from_file(file, class, list, count);
+    } while (FindNextFileW(find_handle, &find_data));
+    FindClose(find_handle);
+    return TRUE;
+}
