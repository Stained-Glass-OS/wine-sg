 /***********************************************************************
+ *              SetupDiSetSelectedDriverW (SETUPAPI.@)
+ *
+ * Stained Glass OS (vpn2, i1014): the device's selected driver, from its compatible driver
+ * list -- the driver the data names (Reserved), or with none named the one matching its
+ * description, manufacturer and provider; NULL selects none. Was a stub: DiInstallDevice with a
+ * driver given, and installers that pick a driver before DIF_INSTALLDEVICE, need it.
+ */
+BOOL WINAPI SetupDiSetSelectedDriverW(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data, SP_DRVINFO_DATA_W *driver_data)
+{
+    struct device *device;
+    unsigned int i;
+
+    TRACE("devinfo %p, device_data %p, driver_data %p.\n", devinfo, device_data, driver_data);
+
+    if (!(device = get_device(devinfo, device_data)))
+        return FALSE;
+    if (!driver_data)
+    {
+        device->selected_driver = NULL;
+        return TRUE;
+    }
+    if (driver_data->cbSize != sizeof(*driver_data) && driver_data->cbSize != sizeof(SP_DRVINFO_DATA_V1_W))
+    {
+        SetLastError(ERROR_INVALID_USER_BUFFER);
+        return FALSE;
+    }
+    for (i = 0; i < device->driver_count; ++i)
+    {
+        struct driver *driver = &device->drivers[i];
+
+        if (driver_data->Reserved)
+        {
+            if ((struct driver *)driver_data->Reserved != driver) continue;
+        }
+        else
+        {
+            SP_DRVINFO_DATA_W data = {sizeof(data)};
+
+            if (driver_data->DriverType != SPDIT_COMPATDRIVER || !copy_driver_data(&data, driver)) continue;
+            if (wcsicmp(data.Description, driver_data->Description) || wcsicmp(data.MfgName, driver_data->MfgName)
+                    || wcsicmp(data.ProviderName, driver_data->ProviderName))
+                continue;
+            driver_data->Reserved = (ULONG_PTR)driver;
+        }
+        device->selected_driver = driver;
+        return TRUE;
+    }
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+}
+
+/***********************************************************************
+ *              SetupDiSetSelectedDriverA (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiSetSelectedDriverA(HDEVINFO devinfo, SP_DEVINFO_DATA *device_data, SP_DRVINFO_DATA_A *driver_data)
+{
+    SP_DRVINFO_DATA_W driver_dataW = {sizeof(driver_dataW)};
+    BOOL ret;
+
+    TRACE("devinfo %p, device_data %p, driver_data %p.\n", devinfo, device_data, driver_data);
+
+    if (!driver_data) return SetupDiSetSelectedDriverW(devinfo, device_data, NULL);
+    if (driver_data->cbSize != sizeof(*driver_data) && driver_data->cbSize != sizeof(SP_DRVINFO_DATA_V1_A))
+    {
+        SetLastError(ERROR_INVALID_USER_BUFFER);
+        return FALSE;
+    }
+    driver_dataW.DriverType = driver_data->DriverType;
+    driver_dataW.Reserved = driver_data->Reserved;
+    MultiByteToWideChar(CP_ACP, 0, driver_data->Description, -1, driver_dataW.Description, ARRAY_SIZE(driver_dataW.Description));
+    MultiByteToWideChar(CP_ACP, 0, driver_data->MfgName, -1, driver_dataW.MfgName, ARRAY_SIZE(driver_dataW.MfgName));
+    MultiByteToWideChar(CP_ACP, 0, driver_data->ProviderName, -1, driver_dataW.ProviderName, ARRAY_SIZE(driver_dataW.ProviderName));
+    if ((ret = SetupDiSetSelectedDriverW(devinfo, device_data, &driver_dataW)))
+        driver_data->Reserved = driver_dataW.Reserved;
+    return ret;
+}
