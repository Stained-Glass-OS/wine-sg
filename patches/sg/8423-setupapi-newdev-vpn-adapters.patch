+/* Stained Glass OS (vpn2, i1014): what Windows' network class installer does for a Net device,
+ * whether or not its driver then loads: the adapter's NetCfgInstanceId in its driver key, and its
+ * connection (Control\Network\{Net}\{id}\Connection: PnpInstanceID, a name "Ethernet N"); both go
+ * when the device is removed. OpenVPN's tapctl waits for NetCfgInstanceId after DiInstallDevice to
+ * know its new Wintun / TAP adapter, and gave up (msiexec exit 67) without it. */
+static const GUID net_class_guid = {0x4d36e972, 0xe325, 0x11ce, {0xbf, 0xc1, 0x08, 0x00, 0x2b, 0xe1, 0x03, 0x18}};
+#define NET_CONNECTIONS_KEY L"System\\CurrentControlSet\\Control\\Network\\{4D36E972-E325-11CE-BFC1-08002BE10318}"
+
+/* the first free "Ethernet", "Ethernet 2", ... among the connections */
+static void net_connection_name(WCHAR *name, DWORD len)
+{
+    HKEY net;
+    DWORD n, i;
+
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, NET_CONNECTIONS_KEY, 0, KEY_READ, &net))
+    {
+        lstrcpynW(name, L"Ethernet", len);
+        return;
+    }
+    for (n = 1; n < 1000; n++)
+    {
+        WCHAR sub[64], other[256];
+        BOOL taken = FALSE;
+
+        if (n == 1) lstrcpynW(name, L"Ethernet", len);
+        else swprintf(name, len, L"Ethernet %lu", n);
+        for (i = 0; !taken; i++)
+        {
+            DWORD sub_len = ARRAY_SIZE(sub), size = sizeof(other);
+            HKEY conn;
+
+            if (RegEnumKeyExW(net, i, sub, &sub_len, NULL, NULL, NULL, NULL)) break;
+            lstrcatW(sub, L"\\Connection");
+            if (RegOpenKeyExW(net, sub, 0, KEY_READ, &conn)) continue;
+            if (!RegQueryValueExW(conn, L"Name", NULL, NULL, (BYTE *)other, &size) && !wcsicmp(other, name)) taken = TRUE;
+            RegCloseKey(conn);
+        }
+        if (!taken) break;
+    }
+    RegCloseKey(net);
+}
+
+static void net_class_install(struct device *device, HKEY driver_key)
+{
+    WCHAR id[39], path[MAX_PATH], name[64];
+    DWORD size = sizeof(id), disp;
+    GUID guid;
+    HKEY conn;
+
+#ifdef SG_MUTANT_NO_NETCFG_INSTANCE
+    return;
+#endif
+    if (!IsEqualGUID(&device->class, &net_class_guid)) return;
+    if (RegQueryValueExW(driver_key, L"NetCfgInstanceId", NULL, NULL, (BYTE *)id, &size) || size < 2 * sizeof(WCHAR))
+    {
+        if (UuidCreate(&guid) != RPC_S_OK) return;
+        SETUPDI_GuidToString(&guid, id);
+        RegSetValueExW(driver_key, L"NetCfgInstanceId", 0, REG_SZ, (BYTE *)id, (lstrlenW(id) + 1) * sizeof(WCHAR));
+    }
+    swprintf(path, ARRAY_SIZE(path), NET_CONNECTIONS_KEY L"\\%s\\Connection", id);
+    if (RegCreateKeyExW(HKEY_LOCAL_MACHINE, path, 0, NULL, 0, KEY_READ | KEY_WRITE, NULL, &conn, &disp)) return;
+    RegSetValueExW(conn, L"PnpInstanceID", 0, REG_SZ, (BYTE *)device->instanceId,
+                   (lstrlenW(device->instanceId) + 1) * sizeof(WCHAR));
+    size = sizeof(name);
+    if (RegQueryValueExW(conn, L"Name", NULL, NULL, (BYTE *)name, &size))
+    {
+        net_connection_name(name, ARRAY_SIZE(name));
+        RegSetValueExW(conn, L"Name", 0, REG_SZ, (BYTE *)name, (lstrlenW(name) + 1) * sizeof(WCHAR));
+    }
+    RegCloseKey(conn);
+}
+
+static void net_class_remove(struct device *device)
+{
+    WCHAR id[39], path[MAX_PATH];
+    DWORD size = sizeof(id);
+    HKEY key;
+
+    if (!IsEqualGUID(&device->class, &net_class_guid)) return;
+    if (open_driver_key(device, KEY_READ, &key)) return;
+    if (!RegQueryValueExW(key, L"NetCfgInstanceId", NULL, NULL, (BYTE *)id, &size) && size > 2 * sizeof(WCHAR)
+            && id[0] == '{')
+    {
+        swprintf(path, ARRAY_SIZE(path), NET_CONNECTIONS_KEY L"\\%s", id);
+        RegDeleteTreeW(HKEY_LOCAL_MACHINE, path);
+    }
+    RegCloseKey(key);
+}
