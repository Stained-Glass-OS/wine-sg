From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase, wintypes: apartment identifiers, shutdown callbacks, global options

- RoGetApartmentIdentifier (a FIXME giving 0xdeadbeef for every
  apartment): the current apartment's own identifier (its OXID), the MTA's
  for a thread in none, CO_E_NOTINITIALIZED with no apartment at all.
- RoRegisterForApartmentShutdown (a FIXME giving a fixed cookie): the
  IApartmentShutdown callback is kept with the apartment and its
  OnUninitialize is called with the identifier when the apartment goes;
  RoUnregisterForApartmentShutdown (an "@ stub") takes it back.
- IGlobalOptions::Set (a FIXME that dropped the value): the value is kept
  and Query gives it back; an invalid exception handling or thread pool
  setting is E_INVALIDARG.
- wintypes: IsApiContractPresentByMajor is no longer a "semi-stub" FIXME
  (it answers from the contracts it knows).

Gate: test/aptshutdown-gate.sh (64- and 32-bit, test/aptshutdown-probe.c).
Mutants SG_MUTANT_NO_SHUTDOWN_CALLBACK (combase/apartment.c),
SG_MUTANT_OPTIONS_NOT_KEPT (combase/combase.c).
---
--- a/dlls/combase/apartment.c
+++ b/dlls/combase/apartment.c
@@ -372,6 +372,7 @@ static struct apartment *apartment_construct(DWORD model)
     list_init(&apt->stubmgrs);
     list_init(&apt->loaded_dlls);
     list_init(&apt->usage_cookies);
+    list_init(&apt->shutdown_callbacks);
     apt->ipidc = 0;
     apt->refs = 1;
     apt->remunk_exported = FALSE;
@@ -473,6 +474,22 @@ void apartment_release(struct apartment *apt)
 
         TRACE("destroying apartment %p, oxid %s\n", apt, wine_dbgstr_longlong(apt->oxid));
 
+        /* Stained Glass OS 1696: those who asked are told it is going */
+        while (!list_empty(&apt->shutdown_callbacks))
+        {
+            struct apartment_shutdown_registration *reg;
+
+            EnterCriticalSection(&apt->cs);
+            reg = LIST_ENTRY(list_head(&apt->shutdown_callbacks), struct apartment_shutdown_registration, entry);
+            list_remove(&reg->entry);
+            LeaveCriticalSection(&apt->cs);
+#ifndef SG_MUTANT_NO_SHUTDOWN_CALLBACK
+            IApartmentShutdown_OnUninitialize(reg->callback, apt->oxid);
+#endif
+            IApartmentShutdown_Release(reg->callback);
+            free(reg);
+        }
+
         if (apt->local_server)
         {
             struct local_server *local_server = apt->local_server;
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -555,8 +555,25 @@ static ULONG WINAPI global_options_Release(IGlobalOptions *iface)
 
 static HRESULT WINAPI global_options_Set(IGlobalOptions *iface, GLOBALOPT_PROPERTIES property, ULONG_PTR value)
 {
-    FIXME("%p, %u, %Ix.\n", iface, property, value);
+    TRACE("%p, %u, %Ix.\n", iface, property, value);
 
+    /* Stained Glass OS 1696: kept, and given back by Query */
+    if (property < COMGLB_EXCEPTION_HANDLING || property > COMGLB_PROPERTIES_RESERVED3)
+        return E_INVALIDARG;
+    switch (property)
+    {
+    case COMGLB_EXCEPTION_HANDLING:
+        if (value > COMGLB_EXCEPTION_DONOT_HANDLE_ANY) return E_INVALIDARG;
+        break;
+    case COMGLB_RPC_THREADPOOL_SETTING:
+        if (value > COMGLB_RPC_THREADPOOL_SETTING_PRIVATE_POOL) return E_INVALIDARG;
+        break;
+    default:
+        break;
+    }
+#ifndef SG_MUTANT_OPTIONS_NOT_KEPT
+    global_options[property] = value;
+#endif
     return S_OK;
 }
 
--- a/dlls/combase/combase.spec
+++ b/dlls/combase/combase.spec
@@ -316,7 +316,7 @@
 @ stdcall RoTransformError(long long ptr)
 @ stdcall RoTransformErrorW(long long long wstr)
 @ stdcall RoUninitialize()
-@ stub RoUnregisterForApartmentShutdown
+@ stdcall RoUnregisterForApartmentShutdown(ptr)
 @ stub SetCleanupFlag
 @ stdcall SetErrorInfo(long ptr)
 @ stdcall SetRestrictedErrorInfo(ptr)
--- a/dlls/combase/combase_private.h
+++ b/dlls/combase/combase_private.h
@@ -51,6 +51,16 @@ struct apartment
 
     /* MTA-only */
     struct list usage_cookies; /* Used for refcount control with CoIncrementMTAUsage()/CoDecrementMTAUsage(). */
+
+    /* Stained Glass OS 1696: RoRegisterForApartmentShutdown's callbacks (CS cs) */
+    struct list shutdown_callbacks;
+};
+
+struct apartment_shutdown_registration
+{
+    struct list entry;
+    struct apartment *apt;
+    IApartmentShutdown *callback;
 };
 
 HRESULT open_key_for_clsid(REFCLSID clsid, const WCHAR *keyname, REGSAM access, HKEY *subkey);
--- a/dlls/combase/roapi.c
+++ b/dlls/combase/roapi.c
@@ -982,12 +982,49 @@ HRESULT WINAPI RoGetAgileReference(enum AgileReferenceOptions option, REFIID rii
  */
 HRESULT WINAPI RoGetApartmentIdentifier(UINT64 *identifier)
 {
-    FIXME("(%p): stub\n", identifier);
+    /* Stained Glass OS 1696: the apartment's own identifier (its OXID) */
+    struct apartment *apt;
+
+    TRACE("(%p)\n", identifier);
 
     if (!identifier)
         return E_INVALIDARG;
+    if (!(apt = apartment_get_current_or_mta()))
+        return CO_E_NOTINITIALIZED;
+    *identifier = apt->oxid;
+    apartment_release(apt);
+    return S_OK;
+}
 
-    *identifier = 0xdeadbeef;
+/***********************************************************************
+ *      RoUnregisterForApartmentShutdown (combase.@)
+ */
+HRESULT WINAPI RoUnregisterForApartmentShutdown(APARTMENT_SHUTDOWN_REGISTRATION_COOKIE cookie)
+{
+    struct apartment_shutdown_registration *reg = (struct apartment_shutdown_registration *)cookie, *iter;
+    struct apartment *apt;
+    BOOL found = FALSE;
+
+    TRACE("(%p)\n", cookie);
+
+    if (!reg)
+        return E_INVALIDARG;
+    if (!(apt = apartment_get_current_or_mta()))
+        return CO_E_NOTINITIALIZED;
+    EnterCriticalSection(&apt->cs);
+    LIST_FOR_EACH_ENTRY(iter, &apt->shutdown_callbacks, struct apartment_shutdown_registration, entry)
+        if (iter == reg)
+        {
+            list_remove(&reg->entry);
+            found = TRUE;
+            break;
+        }
+    LeaveCriticalSection(&apt->cs);
+    apartment_release(apt);
+    if (!found)
+        return E_INVALIDARG;
+    IApartmentShutdown_Release(reg->callback);
+    free(reg);
     return S_OK;
 }
 
@@ -997,16 +1034,30 @@ HRESULT WINAPI RoGetApartmentIdentifier(UINT64 *identifier)
 HRESULT WINAPI RoRegisterForApartmentShutdown(IApartmentShutdown *callback,
         UINT64 *identifier, APARTMENT_SHUTDOWN_REGISTRATION_COOKIE *cookie)
 {
-    HRESULT hr;
+    struct apartment_shutdown_registration *reg;
+    struct apartment *apt;
 
-    FIXME("(%p, %p, %p): stub\n", callback, identifier, cookie);
+    TRACE("(%p, %p, %p)\n", callback, identifier, cookie);
 
-    hr = RoGetApartmentIdentifier(identifier);
-    if (FAILED(hr))
-        return hr;
-
-    if (cookie)
-        *cookie = (void *)0xcafecafe;
+    /* Stained Glass OS 1696: the callback is told when the apartment goes */
+    if (!callback || !identifier || !cookie)
+        return E_INVALIDARG;
+    if (!(apt = apartment_get_current_or_mta()))
+        return CO_E_NOTINITIALIZED;
+    if (!(reg = calloc(1, sizeof(*reg))))
+    {
+        apartment_release(apt);
+        return E_OUTOFMEMORY;
+    }
+    reg->apt = apt;
+    reg->callback = callback;
+    IApartmentShutdown_AddRef(callback);
+    EnterCriticalSection(&apt->cs);
+    list_add_tail(&apt->shutdown_callbacks, &reg->entry);
+    LeaveCriticalSection(&apt->cs);
+    *identifier = apt->oxid;
+    *cookie = (APARTMENT_SHUTDOWN_REGISTRATION_COOKIE)reg;
+    apartment_release(apt);
     return S_OK;
 }
 
