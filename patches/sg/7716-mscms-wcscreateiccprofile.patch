From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscms: WcsCreateIccProfile

---
--- a/dlls/mscms/profile.c
+++ b/dlls/mscms/profile.c
@@ -2123,6 +2123,49 @@
     return OpenColorProfileW( cdm, access, sharing, creation );
 }
 
+/******************************************************************************
+ * WcsCreateIccProfile               [MSCMS.@]
+ *
+ * Stained Glass OS 7716: an ICC profile from a color profile. Wine's profiles (WcsOpenColorProfile
+ * included: no WCS support) are ICC profiles already, so the new profile is a copy of the given
+ * one, in memory. Qt asks for it for each screen's color space; the unimplemented function was an
+ * exception in its window procedure and Qt then had "no screens available": GpgFrontend (MSIX)
+ * showed no window (2026-11-08).
+ */
+HPROFILE WINAPI WcsCreateIccProfile( HPROFILE source, DWORD options )
+{
+    PROFILE profile;
+    DWORD size = 0;
+    HPROFILE ret = NULL;
+    BYTE *data;
+
+    TRACE( "%p, %#lx\n", source, options );
+
+#ifdef SG_MUTANT_NO_WCS_ICC
+    return NULL;
+#endif
+    GetColorProfileFromHandle( source, NULL, &size );
+    if (!size)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return NULL;
+    }
+    if (!(data = malloc( size )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    if (GetColorProfileFromHandle( source, data, &size ))
+    {
+        profile.dwType = PROFILE_MEMBUFFER;
+        profile.pProfileData = data;
+        profile.cbDataSize = size;
+        ret = OpenColorProfileW( &profile, PROFILE_READ, FILE_SHARE_READ, OPEN_EXISTING );
+    }
+    free( data );
+    return ret;
+}
+
 /* Named color profiles: the 'ncl2' tag */
 
 #ifndef LCS_SIGNATURE
--- a/dlls/mscms/mscms.spec
+++ b/dlls/mscms/mscms.spec
@@ -86,7 +86,7 @@
 @ stdcall UnregisterCMMW(wstr long)
 @ stdcall WcsAssociateColorProfileWithDevice(long wstr wstr)
 @ stub WcsCheckColors
-@ stub WcsCreateIccProfile
+@ stdcall WcsCreateIccProfile(ptr long)
 @ stdcall WcsDisassociateColorProfileFromDevice(long wstr wstr)
 @ stdcall WcsEnumColorProfiles(long ptr ptr long ptr)
 @ stdcall WcsEnumColorProfilesSize(long ptr ptr)
