From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32, ntdll, advapi32: the file versions of the system the system reports

TortoiseSVN 1.15's MSI looks for user32.dll >= 6.3.14392.0 in the system folder
("requires Windows 10 version 1607 or later"); Wine's user32 said XP SP2's
5.1.2600.2180 and msiexec ended with 1603. As shell32 (0636), user32 and the
other core files that named an older Windows (ntdll 6.1.7601, advapi32
10.0.10240) now say the Windows 10 build the system reports (10.0.19041.5072).

Test: test/sysversions-gate.sh (mutant SG_MUTANT_USER32_XP_VERSION).
---
--- a/dlls/user32/user32.rc
+++ b/dlls/user32/user32.rc
@@ -335,10 +335,19 @@
 #define WINE_FILEDESCRIPTION_STR "Wine core dll"
 #define WINE_FILENAME_STR "user32.dll"
 
-/* these values come from Windows XP SP2 */
+/* Stained Glass OS: the version of the system this one stands for (the
+ * build the system reports, 10.0.19045, whose files say 10.0.19041):
+ * installers read it to tell the Windows version -- TortoiseSVN's MSI looks
+ * for user32.dll >= 6.3.14392.0 in the system folder ("requires Windows 10
+ * version 1607 or later") -- as for shell32 (0636). */
+#ifdef SG_MUTANT_USER32_XP_VERSION
 #define WINE_FILEVERSION 5,1,2600,2180
 #define WINE_FILEVERSION_STR "5.01.2600.2180"
-#define WINE_PRODUCTVERSION 5,1,2600,2180
-#define WINE_PRODUCTVERSION_STR "5.01.2600.2180"
+#else
+#define WINE_FILEVERSION 10,0,19041,5072
+#define WINE_FILEVERSION_STR "10.0.19041.5072"
+#endif
+#define WINE_PRODUCTVERSION 10,0,19041,5072
+#define WINE_PRODUCTVERSION_STR "10.0.19041.5072"
 
 #include "wine/wine_common_ver.rc"
--- a/dlls/ntdll/version.rc
+++ b/dlls/ntdll/version.rc
@@ -18,9 +18,14 @@
 
 #define WINE_FILEDESCRIPTION_STR "Wine ntdll"
 #define WINE_FILENAME_STR "ntdll.dll"
-#define WINE_FILEVERSION 6,1,7601,24059
-#define WINE_FILEVERSION_STR "6.1.7601.24059"
-#define WINE_PRODUCTVERSION 6,1,7601,24059
-#define WINE_PRODUCTVERSION_STR "6.1.7601.24059"
+/* Stained Glass OS: the version of the system this one stands for (the
+ * build the system reports, 10.0.19045, whose files say 10.0.19041):
+ * installers read it to tell the Windows version -- TortoiseSVN's MSI looks
+ * for user32.dll >= 6.3.14392.0 in the system folder ("requires Windows 10
+ * version 1607 or later") -- as for shell32 (0636). */
+#define WINE_FILEVERSION 10,0,19041,5072
+#define WINE_FILEVERSION_STR "10.0.19041.5072"
+#define WINE_PRODUCTVERSION 10,0,19041,5072
+#define WINE_PRODUCTVERSION_STR "10.0.19041.5072"
 
 #include "wine/wine_common_ver.rc"
--- a/dlls/advapi32/version.rc
+++ b/dlls/advapi32/version.rc
@@ -18,9 +18,14 @@
 
 #define WINE_FILEDESCRIPTION_STR "Wine advapi32 dll"
 #define WINE_FILENAME_STR "advapi32.dll"
-#define WINE_FILEVERSION 10,0,10240,16384
-#define WINE_FILEVERSION_STR "10.0.10240.16384"
-#define WINE_PRODUCTVERSION 10,0,10240,16384
-#define WINE_PRODUCTVERSION_STR "10.0.10240.16384"
+/* Stained Glass OS: the version of the system this one stands for (the
+ * build the system reports, 10.0.19045, whose files say 10.0.19041):
+ * installers read it to tell the Windows version -- TortoiseSVN's MSI looks
+ * for user32.dll >= 6.3.14392.0 in the system folder ("requires Windows 10
+ * version 1607 or later") -- as for shell32 (0636). */
+#define WINE_FILEVERSION 10,0,19041,5072
+#define WINE_FILEVERSION_STR "10.0.19041.5072"
+#define WINE_PRODUCTVERSION 10,0,19041,5072
+#define WINE_PRODUCTVERSION_STR "10.0.19041.5072"
 
 #include "wine/wine_common_ver.rc"
