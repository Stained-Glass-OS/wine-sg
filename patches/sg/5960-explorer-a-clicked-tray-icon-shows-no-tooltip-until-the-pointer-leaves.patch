From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: a clicked tray icon shows no tooltip until the pointer leaves

A notification-area icon's tooltip came up over the menu its click opened
(Flameshot's, through sg-sni): the click hid the tooltip, but the pointer
still on the icon armed it again (the tooltip subclasses the icon,
TTF_SUBCLASS). As on Windows, a clicked icon shows no tooltip until the
pointer has left it: TTM_ACTIVATE FALSE at the click, TRUE again at
WM_MOUSELEAVE (TrackMouseEvent TME_LEAVE).

Test: test/traytip-gate.sh (hovered it shows; clicked, the pointer
moving on it, it does not; away and back it shows again); mutant
SG_MUTANT_TRAY_TIP_AFTER_CLICK fails the second. VM-checked with
Flameshot's tray menu.
---
diff --git a/programs/explorer/systray.c b/programs/explorer/systray.c
index 3dfa6fa..5377bb8 100644
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -132,6 +132,7 @@ struct icon
     HICON          info_icon;       /* info balloon icon */
     UINT           version;         /* notify icon api version */
     BOOL           balloon_clicked; /* Stained Glass OS: its balloon was clicked */
+    BOOL           tip_quiet;       /* Stained Glass OS: clicked -- no tooltip until the pointer leaves */
     GUID           guid;            /* NIF_GUID identity, or all zero */
 };
 
@@ -994,6 +995,19 @@ static LRESULT WINAPI tray_icon_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPA
     case WM_MBUTTONDBLCLK:
     {
         MSG message = {.hwnd = hwnd, .message = msg, .wParam = wparam, .lParam = lparam};
+#ifndef SG_MUTANT_TRAY_TIP_AFTER_CLICK
+        /* clicked: its tooltip goes and stays away until the pointer leaves
+         * the icon, as on Windows -- the pointer still on it re-armed it (the
+         * tooltip subclasses the icon: TTF_SUBCLASS), and it came up over
+         * the menu the click opened (Flameshot's) */
+        if (msg != WM_MOUSEMOVE && !icon->tip_quiet)
+        {
+            TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd };
+            SendMessageW( icon->tooltip, TTM_ACTIVATE, FALSE, 0 );
+            icon->tip_quiet = TRUE;
+            TrackMouseEvent( &tme );
+        }
+#endif
         SendMessageW( icon->tooltip, TTM_RELAYEVENT, 0, (LPARAM)&message );
         if (!notify_owner( icon, msg, lparam )) break;
         if (icon->version > 0)
@@ -1004,6 +1018,11 @@ static LRESULT WINAPI tray_icon_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPA
         break;
     }
 
+    case WM_MOUSELEAVE:
+        if (icon->tip_quiet) SendMessageW( icon->tooltip, TTM_ACTIVATE, TRUE, 0 );
+        icon->tip_quiet = FALSE;
+        break;
+
     case WM_WINDOWPOSCHANGING:
         if (icon->display == ICON_DISPLAY_HIDDEN)
         {
