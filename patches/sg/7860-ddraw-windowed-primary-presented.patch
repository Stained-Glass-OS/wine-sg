From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ddraw: A windowed primary surface is shown through the swap chain.

Wine's VMR-7 video renderer (quartz's default) blits every frame to a DirectDraw primary
surface at DDSCL_NORMAL with a clipper on its video window. ddraw_surface_update_frontbuffer()
had wined3d draw such blits into the window's OpenGL front buffer, and winex11 copies a child
window's offscreen (composite-redirected) drawable into its top-level at the flush. With
NVIDIA's driver under Xwayland, front-buffer drawing stops reaching the X window after a few
frames or at once: glReadPixels(GL_FRONT) holds every new frame at each wglFlush, the current
drawable is the child's GLXWindow, and XGetImage of that window keeps an old frame. The picture
froze while the sound played on (Media Player, 2026-11-18). Swaps always reach it -- the VMR-9
presents through a swap chain and keeps pace.

In a window (not exclusive mode) the primary is now shown as Windows' compositor shows it: the
clipper's (swap chain) window's whole client area is copied from the primary surface into the
swap chain's back buffer and presented at once, with no swap interval, to that window
(dst_window_override: a present otherwise puts the swap chain back on the device window, the
hidden one ddraw makes when the program gave none). A driver may learn a window's new size only
at a swap (llvmpipe), so the first present to a window, after its client size changed or after
a new swap chain, is made twice -- else DOSBox's first frame back from fullscreen landed off its
shrunk window (test-glresize, 6549). Exclusive mode and flips are as before.
Gate test-ddprimary; mutant SG_MUTANT_DDRAW_FRONT_BUFFER_DRAWN.
---
--- a/dlls/ddraw/ddraw.c
+++ b/dlls/ddraw/ddraw.c
@@ -404,6 +404,8 @@
     ddraw->flags &= ~DDRAW_D3D_INITIALIZED;
 
     ddraw_set_swapchain_window(ddraw, NULL);
+    /* wine-sg 7860: a new swap chain's first present is made twice (surface.c) */
+    ddraw->sg_present_window = NULL;
 
     TRACE("Swapchain destroyed.\n");
 }
--- a/dlls/ddraw/ddraw_private.h
+++ b/dlls/ddraw/ddraw_private.h
@@ -107,6 +107,10 @@
     struct wined3d_swapchain *wined3d_swapchain;
     struct wined3d_swapchain_state_parent state_parent;
     HWND swapchain_window;
+    /* wine-sg 7860: the window and client size the primary was last presented to (none after
+     * the swap chain was destroyed) */
+    HWND sg_present_window;
+    SIZE sg_present_size;
 
     /* DirectDraw things, which are not handled by WineD3D */
     DWORD                   cooperative_level;
--- a/dlls/ddraw/surface.c
+++ b/dlls/ddraw/surface.c
@@ -54,6 +54,66 @@
     return surface->surface_desc.ddsCaps.dwCaps & DDSCAPS_FRONTBUFFER;
 }
 
+/* Stained Glass OS (wine-sg 7860): in a window (not exclusive mode) the primary surface is shown
+ * the way a swap chain shows its frames, not by drawing into the window's OpenGL front buffer.
+ * Wine's VMR-7 video renderer blits every frame to a primary surface with a clipper on its video
+ * window, and with NVIDIA's driver under Xwayland draws into the front buffer of a window stop
+ * reaching the window after a few frames, or at once: the front buffer holds each new frame,
+ * the window keeps an old one, and the picture froze while the sound played on. A present
+ * always reaches it (the VMR-9 presents and keeps pace). On Windows the compositor shows a
+ * windowed primary surface at once, without waiting for a vertical blank: so the window's
+ * whole client area is copied from the primary surface into the swap chain's back buffer
+ * (the primary surface holds everything drawn to it, the back buffer is ours and is discarded
+ * at each present) and presented with no swap interval. A GL driver may learn a window's new
+ * size only at a swap (Mesa's llvmpipe): the first frame after the window changed size, or after
+ * a new swap chain (back from exclusive mode), would be placed for the old size, off the window
+ * -- and a program that blits only when its picture changes (DOSBox back from fullscreen) kept
+ * it there. So then the frame is presented twice. */
+static HRESULT ddraw_surface_present_window(struct ddraw_surface *surface)
+{
+    struct ddraw *ddraw = surface->ddraw;
+    struct wined3d_swapchain_desc desc;
+    POINT origin = {0, 0};
+    RECT src, dst, bounds;
+    unsigned int count;
+    HRESULT hr;
+
+    if (!GetClientRect(ddraw->swapchain_window, &src) || !ClientToScreen(ddraw->swapchain_window, &origin))
+        return DD_OK;
+    OffsetRect(&src, origin.x, origin.y);
+    wined3d_swapchain_get_desc(ddraw->wined3d_swapchain, &desc);
+    SetRect(&bounds, 0, 0, min(surface->surface_desc.dwWidth, desc.backbuffer_width),
+            min(surface->surface_desc.dwHeight, desc.backbuffer_height));
+    if (!IntersectRect(&src, &src, &bounds))
+        return DD_OK;
+    dst = src;
+    OffsetRect(&dst, -origin.x, -origin.y);
+
+    count = 1;
+    if (ddraw->sg_present_window != ddraw->swapchain_window || ddraw->sg_present_size.cx != dst.right
+            || ddraw->sg_present_size.cy != dst.bottom)
+        count = 2;
+    ddraw->sg_present_window = ddraw->swapchain_window;
+    ddraw->sg_present_size.cx = dst.right;
+    ddraw->sg_present_size.cy = dst.bottom;
+
+    TRACE("surface %p, window %p, src %s, dst %s, count %u.\n", surface, ddraw->swapchain_window,
+            wine_dbgstr_rect(&src), wine_dbgstr_rect(&dst), count);
+
+    while (count--)
+    {
+        if (FAILED(hr = wined3d_device_context_blt(ddraw->immediate_context,
+                wined3d_swapchain_get_back_buffer(ddraw->wined3d_swapchain, 0), 0, &src,
+                ddraw_surface_get_any_texture(surface, DDRAW_SURFACE_READ), surface->sub_resource_idx, &src, 0,
+                NULL, WINED3D_TEXF_POINT)))
+            return hr;
+        if (FAILED(hr = wined3d_swapchain_present(ddraw->wined3d_swapchain, &src, &dst,
+                ddraw->swapchain_window, 0, 0)))
+            return hr;
+    }
+    return DD_OK;
+}
+
 /* This is slow, of course. Also, in case of locks, we can't prevent other
  * applications from drawing to the screen while we've locked the frontbuffer.
  * We'd like to do this in wined3d instead, but for that to work wined3d needs
@@ -130,6 +190,11 @@
         if (read)
             return DD_OK;
 
+#ifndef SG_MUTANT_DDRAW_FRONT_BUFFER_DRAWN
+        if (!swap_interval && !(ddraw->cooperative_level & DDSCL_EXCLUSIVE))
+            return ddraw_surface_present_window(surface);
+#endif
+
         if (swap_interval)
             dst_texture = wined3d_swapchain_get_back_buffer(ddraw->wined3d_swapchain, 0);
         else
