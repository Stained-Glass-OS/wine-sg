From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmvcore: profile manager SaveProfile and LoadProfileByData (profile XML)

IWMProfileManager::SaveProfile and LoadProfileByData, which returned
E_NOTIMPL, now read and write the XML form of a profile.

- SaveProfile works on any profile object, through its interfaces (so also
  the profile of an opened reader): a "profile" element (version, storage
  format, name, description) with one "streamconfig" element per stream
  (major type, number, names, bitrate, buffer window) holding a "wmmediatype"
  with a waveformatex or videoinfoheader element (other format types as raw
  bytes), and mutexconfig, bandwidthsharing and streamprioritization
  elements. The length protocol is the SDK's: a NULL buffer returns the length
  in characters including the terminator, a short buffer ASF_E_BUFFERTOOSMALL.
- LoadProfileByData parses that text (names and attributes without regard to
  case, single or double quotes, an XML header and comments allowed, the five
  predefined entities, unknown elements ignored) and builds the profile;
  malformed text, a version other than 4.0/7.0/8.0/9.0, a stream number
  outside 1..63, a duplicate stream or a bad GUID is NS_E_INVALID_DATA.

---
diff --git a/dlls/wmvcore/Makefile.in b/dlls/wmvcore/Makefile.in
index d7c7020..88bc838 100644
--- a/dlls/wmvcore/Makefile.in
+++ b/dlls/wmvcore/Makefile.in
@@ -8,6 +8,7 @@ EXTRADLLFLAGS = -Wb,--prefer-native
 SOURCES = \
 	async_reader.c \
 	profile.c \
+	profile_xml.c \
 	version.rc \
 	wmvcore_main.c \
 	writer.c
diff --git a/dlls/wmvcore/profile.h b/dlls/wmvcore/profile.h
index 3ef4d8c..322e790 100644
--- a/dlls/wmvcore/profile.h
+++ b/dlls/wmvcore/profile.h
@@ -25,6 +25,11 @@
 HRESULT profile_create(WMT_VERSION version, IWMProfile3 **out);
 /* A private copy of any profile object, made through its interfaces. */
 HRESULT profile_clone(IWMProfile *src, IWMProfile3 **out);
+/* The XML form of a profile. A NULL buffer returns the length needed, in
+ * characters including the terminator; a short one ASF_E_BUFFERTOOSMALL. */
+HRESULT profile_save_xml(IWMProfile *profile, WCHAR *buffer, DWORD *length);
+HRESULT profile_load_xml(const WCHAR *xml, IWMProfile3 **out);
+
 /* The string getters shared by the profile objects and the writer's input props. */
 HRESULT wm_get_string(const WCHAR *str, WCHAR *out, DWORD *len);
 HRESULT wm_get_string_word(const WCHAR *str, WCHAR *out, WORD *len);
diff --git a/dlls/wmvcore/profile_xml.c b/dlls/wmvcore/profile_xml.c
new file mode 100644
index 0000000..b9f9ec9
--- /dev/null
+++ b/dlls/wmvcore/profile_xml.c
@@ -0,0 +1,1210 @@
+/*
+ * The XML form of a Windows Media profile (IWMProfileManager::SaveProfile
+ * and LoadProfileByData).
+ *
+ * The layout follows the format documented for profile files: a "profile"
+ * element carrying the version, storage format, name and description, one
+ * "streamconfig" element per stream (major type, number, names, bitrate,
+ * buffer window) holding a "wmmediatype" with the format of the stream
+ * (waveformatex or videoinfoheader), and elements for mutual exclusions,
+ * bandwidth sharing and stream prioritization. Media types of other format
+ * types are kept as raw bytes. Element and attribute names are compared
+ * without regard to case when reading.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "wmvcore_private.h"
+#include "wmsdk.h"
+#include "asferr.h"
+#include "nserror.h"
+#include "profile.h"
+
+static const GUID xml_null_guid;
+static const GUID fmt_waveformatex = {0x05589f81, 0xc356, 0x11ce, {0xbf, 0x01, 0x00, 0xaa, 0x00, 0x55, 0x59, 0x5a}};
+static const GUID fmt_videoinfo = {0x05589f80, 0xc356, 0x11ce, {0xbf, 0x01, 0x00, 0xaa, 0x00, 0x55, 0x59, 0x5a}};
+
+#define WAVEFORMATEX_SIZE 18
+#define VIDEOINFO_SIZE 88
+
+/* ---- writing ---- */
+
+struct sb
+{
+    WCHAR *str;
+    size_t len, cap;
+    BOOL failed;
+};
+
+static void sb_add_n(struct sb *sb, const WCHAR *s, size_t n)
+{
+    if (sb->failed)
+        return;
+    if (sb->len + n + 1 > sb->cap)
+    {
+        size_t cap = max(sb->cap * 2, max(sb->len + n + 1, 256));
+        WCHAR *str = realloc(sb->str, cap * sizeof(WCHAR));
+        if (!str)
+        {
+            sb->failed = TRUE;
+            return;
+        }
+        sb->str = str;
+        sb->cap = cap;
+    }
+    memcpy(sb->str + sb->len, s, n * sizeof(WCHAR));
+    sb->len += n;
+    sb->str[sb->len] = 0;
+}
+
+static void sb_add(struct sb *sb, const WCHAR *s)
+{
+    sb_add_n(sb, s, wcslen(s));
+}
+
+static void sb_add_uint(struct sb *sb, ULONGLONG value)
+{
+    WCHAR buf[24], *p = buf + ARRAY_SIZE(buf);
+
+    *--p = 0;
+    do
+    {
+        *--p = '0' + value % 10;
+        value /= 10;
+    } while (value);
+    sb_add(sb, p);
+}
+
+static void sb_add_int(struct sb *sb, LONGLONG value)
+{
+    if (value < 0)
+    {
+        sb_add(sb, L"-");
+        sb_add_uint(sb, -(ULONGLONG)value);
+    }
+    else
+        sb_add_uint(sb, value);
+}
+
+static void sb_add_hex(struct sb *sb, ULONGLONG value, unsigned int digits)
+{
+    WCHAR buf[17];
+    unsigned int i;
+
+    for (i = 0; i < digits; ++i)
+        buf[i] = L"0123456789ABCDEF"[(value >> ((digits - 1 - i) * 4)) & 0xf];
+    sb_add_n(sb, buf, digits);
+}
+
+static void sb_add_guid(struct sb *sb, const GUID *guid)
+{
+    unsigned int i;
+
+    sb_add(sb, L"{");
+    sb_add_hex(sb, guid->Data1, 8);
+    sb_add(sb, L"-");
+    sb_add_hex(sb, guid->Data2, 4);
+    sb_add(sb, L"-");
+    sb_add_hex(sb, guid->Data3, 4);
+    sb_add(sb, L"-");
+    for (i = 0; i < 8; ++i)
+    {
+        if (i == 2)
+            sb_add(sb, L"-");
+        sb_add_hex(sb, guid->Data4[i], 2);
+    }
+    sb_add(sb, L"}");
+}
+
+static void sb_add_escaped(struct sb *sb, const WCHAR *s)
+{
+    for (; s && *s; ++s)
+    {
+        switch (*s)
+        {
+#ifndef SG_MUTANT_WMVW_XML_ESCAPE
+            case '&': sb_add(sb, L"&amp;"); break;
+            case '<': sb_add(sb, L"&lt;"); break;
+            case '>': sb_add(sb, L"&gt;"); break;
+            case '"': sb_add(sb, L"&quot;"); break;
+#endif
+            default: sb_add_n(sb, s, 1); break;
+        }
+    }
+}
+
+static void sb_attr_uint(struct sb *sb, const WCHAR *name, ULONGLONG value)
+{
+    sb_add(sb, L" ");
+    sb_add(sb, name);
+    sb_add(sb, L"=\"");
+    sb_add_uint(sb, value);
+    sb_add(sb, L"\"");
+}
+
+static void sb_attr_int(struct sb *sb, const WCHAR *name, LONGLONG value)
+{
+    sb_add(sb, L" ");
+    sb_add(sb, name);
+    sb_add(sb, L"=\"");
+    sb_add_int(sb, value);
+    sb_add(sb, L"\"");
+}
+
+static void sb_attr_guid(struct sb *sb, const WCHAR *name, const GUID *guid)
+{
+    sb_add(sb, L" ");
+    sb_add(sb, name);
+    sb_add(sb, L"=\"");
+    sb_add_guid(sb, guid);
+    sb_add(sb, L"\"");
+}
+
+static void sb_attr_str(struct sb *sb, const WCHAR *name, const WCHAR *value)
+{
+    sb_add(sb, L" ");
+    sb_add(sb, name);
+    sb_add(sb, L"=\"");
+    sb_add_escaped(sb, value);
+    sb_add(sb, L"\"");
+}
+
+static void sb_attr_hex(struct sb *sb, const WCHAR *name, const BYTE *data, size_t size)
+{
+    size_t i;
+
+    sb_add(sb, L" ");
+    sb_add(sb, name);
+    sb_add(sb, L"=\"");
+    for (i = 0; i < size; ++i)
+        sb_add_hex(sb, data[i], 2);
+    sb_add(sb, L"\"");
+}
+
+static WORD get16(const BYTE *p) { return p[0] | (p[1] << 8); }
+static DWORD get32(const BYTE *p) { return get16(p) | ((DWORD)get16(p + 2) << 16); }
+static ULONGLONG get64(const BYTE *p) { return get32(p) | ((ULONGLONG)get32(p + 4) << 32); }
+static void put16(BYTE *p, WORD v) { p[0] = v; p[1] = v >> 8; }
+static void put32(BYTE *p, DWORD v) { put16(p, v); put16(p + 2, v >> 16); }
+static void put64(BYTE *p, ULONGLONG v) { put32(p, v); put32(p + 4, v >> 32); }
+
+static void sb_media_type(struct sb *sb, const WM_MEDIA_TYPE *mt)
+{
+    const BYTE *f = mt->pbFormat;
+
+    sb_add(sb, L"    <wmmediatype");
+    sb_attr_guid(sb, L"subtype", &mt->subtype);
+    sb_attr_uint(sb, L"bFixedSizeSamples", !!mt->bFixedSizeSamples);
+    sb_attr_uint(sb, L"bTemporalCompression", !!mt->bTemporalCompression);
+    sb_attr_uint(sb, L"lSampleSize", mt->lSampleSize);
+
+    if (IsEqualGUID(&mt->formattype, &fmt_waveformatex) && f && mt->cbFormat >= WAVEFORMATEX_SIZE)
+    {
+        sb_add(sb, L">\n      <waveformatex");
+        sb_attr_uint(sb, L"wFormatTag", get16(f));
+        sb_attr_uint(sb, L"nChannels", get16(f + 2));
+        sb_attr_uint(sb, L"nSamplesPerSec", get32(f + 4));
+        sb_attr_uint(sb, L"nAvgBytesPerSec", get32(f + 8));
+        sb_attr_uint(sb, L"nBlockAlign", get16(f + 12));
+        sb_attr_uint(sb, L"wBitsPerSample", get16(f + 14));
+        sb_attr_hex(sb, L"codecdata", f + WAVEFORMATEX_SIZE, mt->cbFormat - WAVEFORMATEX_SIZE);
+        sb_add(sb, L"/>\n    </wmmediatype>\n");
+    }
+    else if (IsEqualGUID(&mt->formattype, &fmt_videoinfo) && f && mt->cbFormat >= VIDEOINFO_SIZE)
+    {
+        sb_add(sb, L">\n      <videoinfoheader");
+        sb_attr_uint(sb, L"dwBitRate", get32(f + 32));
+        sb_attr_uint(sb, L"dwBitErrorRate", get32(f + 36));
+        sb_attr_int(sb, L"AvgTimePerFrame", (LONGLONG)get64(f + 40));
+        sb_attr_hex(sb, L"extradata", f + VIDEOINFO_SIZE, mt->cbFormat - VIDEOINFO_SIZE);
+        sb_add(sb, L">\n        <rcsource");
+        sb_attr_int(sb, L"left", (LONG)get32(f));
+        sb_attr_int(sb, L"top", (LONG)get32(f + 4));
+        sb_attr_int(sb, L"right", (LONG)get32(f + 8));
+        sb_attr_int(sb, L"bottom", (LONG)get32(f + 12));
+        sb_add(sb, L"/>\n        <rctarget");
+        sb_attr_int(sb, L"left", (LONG)get32(f + 16));
+        sb_attr_int(sb, L"top", (LONG)get32(f + 20));
+        sb_attr_int(sb, L"right", (LONG)get32(f + 24));
+        sb_attr_int(sb, L"bottom", (LONG)get32(f + 28));
+        sb_add(sb, L"/>\n        <bitmapinfoheader");
+        sb_attr_uint(sb, L"biSize", get32(f + 48));
+        sb_attr_int(sb, L"biWidth", (LONG)get32(f + 52));
+        sb_attr_int(sb, L"biHeight", (LONG)get32(f + 56));
+        sb_attr_uint(sb, L"biPlanes", get16(f + 60));
+        sb_attr_uint(sb, L"biBitCount", get16(f + 62));
+        sb_attr_uint(sb, L"biCompression", get32(f + 64));
+        sb_attr_uint(sb, L"biSizeImage", get32(f + 68));
+        sb_attr_int(sb, L"biXPelsPerMeter", (LONG)get32(f + 72));
+        sb_attr_int(sb, L"biYPelsPerMeter", (LONG)get32(f + 76));
+        sb_attr_uint(sb, L"biClrUsed", get32(f + 80));
+        sb_attr_uint(sb, L"biClrImportant", get32(f + 84));
+        sb_add(sb, L"/>\n      </videoinfoheader>\n    </wmmediatype>\n");
+    }
+    else
+    {
+        sb_attr_guid(sb, L"formattype", &mt->formattype);
+        if (mt->cbFormat && f)
+            sb_attr_hex(sb, L"formatdata", f, mt->cbFormat);
+        sb_add(sb, L"/>\n");
+    }
+}
+
+static HRESULT sb_stream_list(struct sb *sb, IWMStreamList *list, const WCHAR *element, const WCHAR *attr)
+{
+    WORD *numbers = NULL, count = 0, i;
+    HRESULT hr;
+
+    if (FAILED(hr = IWMStreamList_GetStreams(list, NULL, &count)) || !count)
+        return hr;
+    if (!(numbers = malloc(count * sizeof(*numbers))))
+        return E_OUTOFMEMORY;
+    if (SUCCEEDED(hr = IWMStreamList_GetStreams(list, numbers, &count)))
+    {
+        for (i = 0; i < count; ++i)
+        {
+            sb_add(sb, L"    <");
+            sb_add(sb, element);
+            sb_attr_uint(sb, attr, numbers[i]);
+            sb_add(sb, L"/>\n");
+        }
+    }
+    free(numbers);
+    return hr;
+}
+
+static HRESULT sb_stream(struct sb *sb, IWMStreamConfig *config)
+{
+    IWMMediaProps *props;
+    WM_MEDIA_TYPE *mt;
+    WCHAR *name = NULL, *connection = NULL;
+    DWORD bitrate, window, size;
+    WORD number, len;
+    GUID type;
+    HRESULT hr;
+
+    if (FAILED(hr = IWMStreamConfig_GetStreamType(config, &type))
+            || FAILED(hr = IWMStreamConfig_GetStreamNumber(config, &number))
+            || FAILED(hr = IWMStreamConfig_GetBitrate(config, &bitrate))
+            || FAILED(hr = IWMStreamConfig_GetBufferWindow(config, &window)))
+        return hr;
+    len = 0;
+    if (SUCCEEDED(IWMStreamConfig_GetStreamName(config, NULL, &len)) && len > 1 && (name = malloc(len * sizeof(WCHAR))))
+        IWMStreamConfig_GetStreamName(config, name, &len);
+    len = 0;
+    if (SUCCEEDED(IWMStreamConfig_GetConnectionName(config, NULL, &len)) && len > 1 && (connection = malloc(len * sizeof(WCHAR))))
+        IWMStreamConfig_GetConnectionName(config, connection, &len);
+
+    sb_add(sb, L"  <streamconfig");
+    sb_attr_guid(sb, L"majortype", &type);
+    sb_attr_uint(sb, L"streamnumber", number);
+    sb_attr_str(sb, L"streamname", name ? name : L"");
+    sb_attr_str(sb, L"inputname", connection ? connection : L"");
+#ifndef SG_MUTANT_WMVW_XML_BITRATE
+    sb_attr_uint(sb, L"bitrate", bitrate);
+#endif
+    sb_attr_int(sb, L"bufferwindow", (LONG)window);
+    free(name);
+    free(connection);
+
+    if (SUCCEEDED(IWMStreamConfig_QueryInterface(config, &IID_IWMMediaProps, (void **)&props)))
+    {
+        size = 0;
+        hr = IWMMediaProps_GetMediaType(props, NULL, &size);
+        if (SUCCEEDED(hr) && size >= sizeof(*mt) && (mt = malloc(size)))
+        {
+            if (SUCCEEDED(IWMMediaProps_GetMediaType(props, mt, &size))
+                    && (!IsEqualGUID(&mt->subtype, &xml_null_guid) || mt->cbFormat))
+            {
+                sb_add(sb, L">\n");
+                sb_media_type(sb, mt);
+                sb_add(sb, L"  </streamconfig>\n");
+                free(mt);
+                IWMMediaProps_Release(props);
+                return S_OK;
+            }
+            free(mt);
+        }
+        IWMMediaProps_Release(props);
+    }
+    sb_add(sb, L"/>\n");
+    return S_OK;
+}
+
+HRESULT profile_save_xml(IWMProfile *profile, WCHAR *buffer, DWORD *length)
+{
+    IWMProfile3 *profile3 = NULL;
+    WMT_STORAGE_FORMAT storage = WMT_Storage_Format_V1;
+    struct sb sb = {0};
+    WCHAR *name = NULL, *description = NULL;
+    WMT_VERSION version;
+    DWORD count, len, i;
+    HRESULT hr;
+
+    if (FAILED(hr = IWMProfile_GetVersion(profile, &version)))
+        return hr;
+    if (SUCCEEDED(IWMProfile_QueryInterface(profile, &IID_IWMProfile3, (void **)&profile3)))
+        IWMProfile3_GetStorageFormat(profile3, &storage);
+
+    len = 0;
+    if (SUCCEEDED(IWMProfile_GetName(profile, NULL, &len)) && len > 1 && (name = malloc(len * sizeof(WCHAR))))
+        IWMProfile_GetName(profile, name, &len);
+    len = 0;
+    if (SUCCEEDED(IWMProfile_GetDescription(profile, NULL, &len)) && len > 1 && (description = malloc(len * sizeof(WCHAR))))
+        IWMProfile_GetDescription(profile, description, &len);
+
+    sb_add(&sb, L"<profile");
+    sb_attr_uint(&sb, L"version", version);
+    sb_attr_uint(&sb, L"storageformat", storage);
+    sb_attr_str(&sb, L"name", name ? name : L"");
+    sb_attr_str(&sb, L"description", description ? description : L"");
+    sb_add(&sb, L">\n");
+    free(name);
+    free(description);
+
+    hr = IWMProfile_GetStreamCount(profile, &count);
+    for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+    {
+        IWMStreamConfig *config;
+
+        if (SUCCEEDED(hr = IWMProfile_GetStream(profile, i, &config)))
+        {
+            hr = sb_stream(&sb, config);
+            IWMStreamConfig_Release(config);
+        }
+    }
+
+    if (SUCCEEDED(hr) && SUCCEEDED(IWMProfile_GetMutualExclusionCount(profile, &count)))
+    {
+        for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+        {
+            IWMMutualExclusion *mutex;
+            GUID type;
+
+            if (FAILED(hr = IWMProfile_GetMutualExclusion(profile, i, &mutex)))
+                break;
+            IWMMutualExclusion_GetType(mutex, &type);
+            sb_add(&sb, L"  <mutexconfig");
+            sb_attr_guid(&sb, L"type", &type);
+            sb_add(&sb, L">\n");
+            hr = sb_stream_list(&sb, (IWMStreamList *)mutex, L"mutexstream", L"streamnumber");
+            sb_add(&sb, L"  </mutexconfig>\n");
+            IWMMutualExclusion_Release(mutex);
+        }
+    }
+
+    if (SUCCEEDED(hr) && profile3 && SUCCEEDED(IWMProfile3_GetBandwidthSharingCount(profile3, &count)))
+    {
+        for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+        {
+            IWMBandwidthSharing *sharing;
+            DWORD bitrate = 0, buffer = 0;
+            GUID type;
+
+            if (FAILED(hr = IWMProfile3_GetBandwidthSharing(profile3, i, &sharing)))
+                break;
+            IWMBandwidthSharing_GetType(sharing, &type);
+            IWMBandwidthSharing_GetBandwidth(sharing, &bitrate, &buffer);
+            sb_add(&sb, L"  <bandwidthsharing");
+            sb_attr_guid(&sb, L"type", &type);
+            sb_attr_uint(&sb, L"bitrate", bitrate);
+            sb_attr_uint(&sb, L"buffer", buffer);
+            sb_add(&sb, L">\n");
+            hr = sb_stream_list(&sb, (IWMStreamList *)sharing, L"sharedstream", L"streamnumber");
+            sb_add(&sb, L"  </bandwidthsharing>\n");
+            IWMBandwidthSharing_Release(sharing);
+        }
+    }
+
+    if (SUCCEEDED(hr) && profile3)
+    {
+        IWMStreamPrioritization *prio;
+
+        if (IWMProfile3_GetStreamPrioritization(profile3, &prio) == S_OK)
+        {
+            WM_STREAM_PRIORITY_RECORD *records = NULL;
+            WORD n = 0, j;
+
+            hr = IWMStreamPrioritization_GetPriorityRecords(prio, NULL, &n);
+            if (SUCCEEDED(hr) && n && !(records = malloc(n * sizeof(*records))))
+                hr = E_OUTOFMEMORY;
+            if (SUCCEEDED(hr) && n)
+                hr = IWMStreamPrioritization_GetPriorityRecords(prio, records, &n);
+            if (SUCCEEDED(hr))
+            {
+                sb_add(&sb, L"  <streamprioritization>\n");
+                for (j = 0; j < n; ++j)
+                {
+                    sb_add(&sb, L"    <prioritystream");
+                    sb_attr_uint(&sb, L"streamnumber", records[j].wStreamNumber);
+                    sb_attr_uint(&sb, L"mandatory", !!records[j].fMandatory);
+                    sb_add(&sb, L"/>\n");
+                }
+                sb_add(&sb, L"  </streamprioritization>\n");
+            }
+            free(records);
+            IWMStreamPrioritization_Release(prio);
+        }
+    }
+    sb_add(&sb, L"</profile>\n");
+
+    if (profile3)
+        IWMProfile3_Release(profile3);
+    if (SUCCEEDED(hr) && sb.failed)
+        hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr))
+    {
+        DWORD need = sb.len + 1;
+
+        if (!buffer)
+        {
+            *length = need;
+        }
+        else if (*length < need)
+        {
+            *length = need;
+            hr = ASF_E_BUFFERTOOSMALL;
+        }
+        else
+        {
+            memcpy(buffer, sb.str, need * sizeof(WCHAR));
+            *length = need;
+        }
+    }
+    free(sb.str);
+    return hr;
+}
+
+/* ---- reading ---- */
+
+struct attr
+{
+    const WCHAR *name, *value;
+    size_t name_len, value_len;
+};
+
+struct tag
+{
+    const WCHAR *name;
+    size_t name_len;
+    BOOL closing, selfclosing;
+    struct attr attrs[24];
+    unsigned int attr_count;
+};
+
+static BOOL is_space(WCHAR c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n'; }
+
+/* Finds the next element tag; returns 0 at the end of the text, -1 on a syntax error. */
+static int next_tag(const WCHAR **pos, struct tag *tag)
+{
+    const WCHAR *p = *pos;
+
+    memset(tag, 0, sizeof(*tag));
+    for (;;)
+    {
+        while (*p && *p != '<')
+            ++p;
+        if (!*p)
+            return 0;
+        if (p[1] == '?')
+        {
+            while (*p && !(p[0] == '?' && p[1] == '>'))
+                ++p;
+            if (!*p) return -1;
+            p += 2;
+            continue;
+        }
+        if (p[1] == '!' && p[2] == '-' && p[3] == '-')
+        {
+            p += 4;
+            while (*p && !(p[0] == '-' && p[1] == '-' && p[2] == '>'))
+                ++p;
+            if (!*p) return -1;
+            p += 3;
+            continue;
+        }
+        break;
+    }
+    ++p;
+    if (*p == '/')
+    {
+        tag->closing = TRUE;
+        ++p;
+    }
+    tag->name = p;
+    while (*p && !is_space(*p) && *p != '>' && *p != '/')
+        ++p;
+    tag->name_len = p - tag->name;
+    if (!tag->name_len)
+        return -1;
+
+    for (;;)
+    {
+        while (is_space(*p))
+            ++p;
+        if (!*p)
+            return -1;
+        if (*p == '>')
+        {
+            ++p;
+            break;
+        }
+        if (*p == '/' && p[1] == '>')
+        {
+            tag->selfclosing = TRUE;
+            p += 2;
+            break;
+        }
+        {
+            struct attr *attr;
+            WCHAR quote;
+
+            if (tag->attr_count >= ARRAY_SIZE(tag->attrs))
+                return -1;
+            attr = &tag->attrs[tag->attr_count++];
+            attr->name = p;
+            while (*p && !is_space(*p) && *p != '=' && *p != '>' && *p != '/')
+                ++p;
+            attr->name_len = p - attr->name;
+            if (!attr->name_len)
+                return -1;
+            while (is_space(*p))
+                ++p;
+            if (*p != '=')
+                return -1;
+            ++p;
+            while (is_space(*p))
+                ++p;
+            quote = *p;
+            if (quote != '"' && quote != '\'')
+                return -1;
+            attr->value = ++p;
+            while (*p && *p != quote)
+                ++p;
+            if (!*p)
+                return -1;
+            attr->value_len = p - attr->value;
+            ++p;
+        }
+    }
+    *pos = p;
+    return 1;
+}
+
+static BOOL name_is(const WCHAR *name, size_t len, const WCHAR *expected)
+{
+    return len == wcslen(expected) && !wcsnicmp(name, expected, len);
+}
+
+static const struct attr *find_attr(const struct tag *tag, const WCHAR *name)
+{
+    unsigned int i;
+
+    for (i = 0; i < tag->attr_count; ++i)
+    {
+        if (name_is(tag->attrs[i].name, tag->attrs[i].name_len, name))
+            return &tag->attrs[i];
+    }
+    return NULL;
+}
+
+/* The value of an attribute with the five predefined entities resolved. */
+static WCHAR *attr_string(const struct attr *attr)
+{
+    WCHAR *out, *o;
+    size_t i = 0;
+
+    if (!(out = malloc((attr->value_len + 1) * sizeof(WCHAR))))
+        return NULL;
+    o = out;
+    while (i < attr->value_len)
+    {
+        static const struct { const WCHAR *ent; WCHAR ch; } ents[] =
+        {
+            {L"&amp;", '&'}, {L"&lt;", '<'}, {L"&gt;", '>'}, {L"&quot;", '"'}, {L"&apos;", '\''},
+        };
+        unsigned int k;
+
+        if (attr->value[i] == '&')
+        {
+            for (k = 0; k < ARRAY_SIZE(ents); ++k)
+            {
+                size_t n = wcslen(ents[k].ent);
+                if (n <= attr->value_len - i && !wcsncmp(attr->value + i, ents[k].ent, n))
+                {
+                    *o++ = ents[k].ch;
+                    i += n;
+                    break;
+                }
+            }
+            if (k < ARRAY_SIZE(ents))
+                continue;
+        }
+        *o++ = attr->value[i++];
+    }
+    *o = 0;
+    return out;
+}
+
+static BOOL attr_number(const struct tag *tag, const WCHAR *name, LONGLONG *value, BOOL *present)
+{
+    const struct attr *attr = find_attr(tag, name);
+    size_t i = 0;
+    BOOL neg = FALSE;
+    ULONGLONG v = 0;
+
+    *present = attr != NULL;
+    if (!attr)
+        return TRUE;
+    if (i < attr->value_len && attr->value[i] == '-')
+    {
+        neg = TRUE;
+        ++i;
+    }
+    if (i == attr->value_len)
+        return FALSE;
+    for (; i < attr->value_len; ++i)
+    {
+        if (attr->value[i] < '0' || attr->value[i] > '9')
+            return FALSE;
+        v = v * 10 + (attr->value[i] - '0');
+    }
+    *value = neg ? -(LONGLONG)v : (LONGLONG)v;
+    return TRUE;
+}
+
+/* Missing numbers read as 0. */
+static BOOL attr_num(const struct tag *tag, const WCHAR *name, LONGLONG *value)
+{
+    BOOL present;
+
+    *value = 0;
+    return attr_number(tag, name, value, &present);
+}
+
+static int hex_digit(WCHAR c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static BOOL parse_hex_digits(const WCHAR *s, unsigned int n, ULONGLONG *out)
+{
+    ULONGLONG v = 0;
+    unsigned int i;
+
+    for (i = 0; i < n; ++i)
+    {
+        int d = hex_digit(s[i]);
+        if (d < 0) return FALSE;
+        v = (v << 4) | d;
+    }
+    *out = v;
+    return TRUE;
+}
+
+static BOOL attr_guid(const struct tag *tag, const WCHAR *name, GUID *guid, BOOL *present)
+{
+    const struct attr *attr = find_attr(tag, name);
+    const WCHAR *s;
+    ULONGLONG v;
+    unsigned int i;
+
+    *present = attr != NULL;
+    if (!attr)
+        return TRUE;
+    s = attr->value;
+    if (attr->value_len != 38 || s[0] != '{' || s[9] != '-' || s[14] != '-' || s[19] != '-' || s[24] != '-' || s[37] != '}')
+        return FALSE;
+    if (!parse_hex_digits(s + 1, 8, &v)) return FALSE;
+    guid->Data1 = v;
+    if (!parse_hex_digits(s + 10, 4, &v)) return FALSE;
+    guid->Data2 = v;
+    if (!parse_hex_digits(s + 15, 4, &v)) return FALSE;
+    guid->Data3 = v;
+    for (i = 0; i < 8; ++i)
+    {
+        if (!parse_hex_digits(s + (i < 2 ? 20 + i * 2 : 25 + (i - 2) * 2), 2, &v)) return FALSE;
+        guid->Data4[i] = v;
+    }
+    return TRUE;
+}
+
+/* Returns a malloc'ed byte array (size may be 0 with *data NULL). */
+static BOOL attr_hex(const struct tag *tag, const WCHAR *name, BYTE **data, size_t *size)
+{
+    const struct attr *attr = find_attr(tag, name);
+    size_t i;
+
+    *data = NULL;
+    *size = 0;
+    if (!attr || !attr->value_len)
+        return TRUE;
+    if (attr->value_len % 2)
+        return FALSE;
+    if (!(*data = malloc(attr->value_len / 2)))
+        return FALSE;
+    for (i = 0; i < attr->value_len / 2; ++i)
+    {
+        int hi = hex_digit(attr->value[i * 2]), lo = hex_digit(attr->value[i * 2 + 1]);
+        if (hi < 0 || lo < 0)
+        {
+            free(*data);
+            *data = NULL;
+            return FALSE;
+        }
+        (*data)[i] = hi << 4 | lo;
+    }
+    *size = attr->value_len / 2;
+    return TRUE;
+}
+
+struct loader
+{
+    IWMProfile3 *profile;
+    IWMStreamConfig *config;
+    WM_MEDIA_TYPE mt;
+    BOOL have_mt;
+    BYTE *format;
+    DWORD format_size;
+    IWMMutualExclusion *mutex;
+    IWMBandwidthSharing *sharing;
+    IWMStreamPrioritization *prio;
+    WM_STREAM_PRIORITY_RECORD *records;
+    WORD record_count;
+};
+
+static void loader_reset_mt(struct loader *l)
+{
+    free(l->format);
+    l->format = NULL;
+    l->format_size = 0;
+    l->have_mt = FALSE;
+    memset(&l->mt, 0, sizeof(l->mt));
+}
+
+static void loader_free(struct loader *l)
+{
+    loader_reset_mt(l);
+    if (l->config) IWMStreamConfig_Release(l->config);
+    if (l->mutex) IWMMutualExclusion_Release(l->mutex);
+    if (l->sharing) IWMBandwidthSharing_Release(l->sharing);
+    if (l->prio) IWMStreamPrioritization_Release(l->prio);
+    free(l->records);
+    if (l->profile) IWMProfile3_Release(l->profile);
+}
+
+static HRESULT load_media_type_tag(struct loader *l, const struct tag *tag)
+{
+    LONGLONG v;
+    BOOL present;
+    BYTE *data;
+    size_t size;
+
+    if (name_is(tag->name, tag->name_len, L"wmmediatype"))
+    {
+        loader_reset_mt(l);
+        l->have_mt = TRUE;
+        if (!attr_guid(tag, L"subtype", &l->mt.subtype, &present)
+                || !attr_guid(tag, L"formattype", &l->mt.formattype, &present))
+            return NS_E_INVALID_DATA;
+        if (!attr_num(tag, L"bFixedSizeSamples", &v)) return NS_E_INVALID_DATA;
+        l->mt.bFixedSizeSamples = !!v;
+        if (!attr_num(tag, L"bTemporalCompression", &v)) return NS_E_INVALID_DATA;
+        l->mt.bTemporalCompression = !!v;
+        if (!attr_num(tag, L"lSampleSize", &v)) return NS_E_INVALID_DATA;
+        l->mt.lSampleSize = v;
+        if (!attr_hex(tag, L"formatdata", &data, &size))
+            return NS_E_INVALID_DATA;
+        l->format = data;
+        l->format_size = size;
+    }
+    else if (l->have_mt && name_is(tag->name, tag->name_len, L"waveformatex"))
+    {
+        LONGLONG tagv, ch, rate, avg, align, bits;
+
+        if (!attr_num(tag, L"wFormatTag", &tagv) || !attr_num(tag, L"nChannels", &ch)
+                || !attr_num(tag, L"nSamplesPerSec", &rate) || !attr_num(tag, L"nAvgBytesPerSec", &avg)
+                || !attr_num(tag, L"nBlockAlign", &align) || !attr_num(tag, L"wBitsPerSample", &bits)
+                || !attr_hex(tag, L"codecdata", &data, &size))
+            return NS_E_INVALID_DATA;
+        free(l->format);
+        if (!(l->format = calloc(1, WAVEFORMATEX_SIZE + size)))
+        {
+            free(data);
+            return E_OUTOFMEMORY;
+        }
+        put16(l->format, tagv);
+        put16(l->format + 2, ch);
+        put32(l->format + 4, rate);
+        put32(l->format + 8, avg);
+        put16(l->format + 12, align);
+        put16(l->format + 14, bits);
+        put16(l->format + 16, size);
+        if (size)
+            memcpy(l->format + WAVEFORMATEX_SIZE, data, size);
+        free(data);
+        l->format_size = WAVEFORMATEX_SIZE + size;
+        l->mt.formattype = fmt_waveformatex;
+    }
+    else if (l->have_mt && name_is(tag->name, tag->name_len, L"videoinfoheader"))
+    {
+        LONGLONG rate, err, avg;
+
+        if (!attr_num(tag, L"dwBitRate", &rate) || !attr_num(tag, L"dwBitErrorRate", &err)
+                || !attr_num(tag, L"AvgTimePerFrame", &avg) || !attr_hex(tag, L"extradata", &data, &size))
+            return NS_E_INVALID_DATA;
+        free(l->format);
+        if (!(l->format = calloc(1, VIDEOINFO_SIZE + size)))
+        {
+            free(data);
+            return E_OUTOFMEMORY;
+        }
+        put32(l->format + 32, rate);
+        put32(l->format + 36, err);
+        put64(l->format + 40, avg);
+        if (size)
+            memcpy(l->format + VIDEOINFO_SIZE, data, size);
+        free(data);
+        l->format_size = VIDEOINFO_SIZE + size;
+        l->mt.formattype = fmt_videoinfo;
+    }
+    else if (l->format && l->format_size >= VIDEOINFO_SIZE && IsEqualGUID(&l->mt.formattype, &fmt_videoinfo)
+            && (name_is(tag->name, tag->name_len, L"rcsource") || name_is(tag->name, tag->name_len, L"rctarget")))
+    {
+        LONGLONG left, top, right, bottom;
+        BYTE *rc = l->format + (name_is(tag->name, tag->name_len, L"rcsource") ? 0 : 16);
+
+        if (!attr_num(tag, L"left", &left) || !attr_num(tag, L"top", &top)
+                || !attr_num(tag, L"right", &right) || !attr_num(tag, L"bottom", &bottom))
+            return NS_E_INVALID_DATA;
+        put32(rc, left);
+        put32(rc + 4, top);
+        put32(rc + 8, right);
+        put32(rc + 12, bottom);
+    }
+    else if (l->format && l->format_size >= VIDEOINFO_SIZE && IsEqualGUID(&l->mt.formattype, &fmt_videoinfo)
+            && name_is(tag->name, tag->name_len, L"bitmapinfoheader"))
+    {
+        LONGLONG sz, w, h, planes, bits, comp, image, xppm, yppm, used, important;
+        BYTE *b = l->format + 48;
+
+        if (!attr_num(tag, L"biSize", &sz) || !attr_num(tag, L"biWidth", &w) || !attr_num(tag, L"biHeight", &h)
+                || !attr_num(tag, L"biPlanes", &planes) || !attr_num(tag, L"biBitCount", &bits)
+                || !attr_num(tag, L"biCompression", &comp) || !attr_num(tag, L"biSizeImage", &image)
+                || !attr_num(tag, L"biXPelsPerMeter", &xppm) || !attr_num(tag, L"biYPelsPerMeter", &yppm)
+                || !attr_num(tag, L"biClrUsed", &used) || !attr_num(tag, L"biClrImportant", &important))
+            return NS_E_INVALID_DATA;
+        put32(b, sz ? sz : 40);
+        put32(b + 4, w);
+        put32(b + 8, h);
+        put16(b + 12, planes);
+        put16(b + 14, bits);
+        put32(b + 16, comp);
+        put32(b + 20, image);
+        put32(b + 24, xppm);
+        put32(b + 28, yppm);
+        put32(b + 32, used);
+        put32(b + 36, important);
+    }
+    return S_OK;
+}
+
+static HRESULT commit_stream(struct loader *l)
+{
+    IWMMediaProps *props;
+    HRESULT hr = S_OK;
+
+    if (l->have_mt && (l->format_size || !IsEqualGUID(&l->mt.subtype, &xml_null_guid)))
+    {
+        if (FAILED(hr = IWMStreamConfig_GetStreamType(l->config, &l->mt.majortype)))
+            return hr;
+        l->mt.cbFormat = l->format_size;
+        l->mt.pbFormat = l->format;
+        if (SUCCEEDED(hr = IWMStreamConfig_QueryInterface(l->config, &IID_IWMMediaProps, (void **)&props)))
+        {
+            hr = IWMMediaProps_SetMediaType(props, &l->mt);
+            IWMMediaProps_Release(props);
+        }
+        if (FAILED(hr))
+            return NS_E_INVALID_DATA;
+    }
+    if (FAILED(hr = IWMProfile3_AddStream(l->profile, l->config)))
+        return hr == NS_E_INVALID_STREAM ? NS_E_INVALID_DATA : hr;
+    IWMStreamConfig_Release(l->config);
+    l->config = NULL;
+    loader_reset_mt(l);
+    return S_OK;
+}
+
+static HRESULT open_stream(struct loader *l, const struct tag *tag)
+{
+    LONGLONG number, bitrate, window;
+    GUID type;
+    BOOL present;
+    WCHAR *s;
+    HRESULT hr;
+
+    if (!attr_guid(tag, L"majortype", &type, &present) || !present)
+        return NS_E_INVALID_DATA;
+    if (FAILED(hr = IWMProfile3_CreateNewStream(l->profile, &type, &l->config)))
+        return hr == E_INVALIDARG ? NS_E_INVALID_DATA : hr;
+    if (!attr_number(tag, L"streamnumber", &number, &present) || !present || number < 1 || number > MAX_PROFILE_STREAM
+            || !attr_num(tag, L"bitrate", &bitrate) || bitrate < 0 || bitrate > 0xffffffff)
+        return NS_E_INVALID_DATA;
+    IWMStreamConfig_SetStreamNumber(l->config, number);
+#ifndef SG_MUTANT_WMVW_XML_LOADBITRATE
+    IWMStreamConfig_SetBitrate(l->config, bitrate);
+#endif
+    if (!attr_number(tag, L"bufferwindow", &window, &present))
+        return NS_E_INVALID_DATA;
+    if (present && (DWORD)window != ~0u)
+        IWMStreamConfig_SetBufferWindow(l->config, window);
+    if (find_attr(tag, L"streamname"))
+    {
+        if (!(s = attr_string(find_attr(tag, L"streamname"))))
+            return E_OUTOFMEMORY;
+        hr = IWMStreamConfig_SetStreamName(l->config, s);
+        free(s);
+        if (FAILED(hr))
+            return NS_E_INVALID_DATA;
+    }
+    if (find_attr(tag, L"inputname"))
+    {
+        if (!(s = attr_string(find_attr(tag, L"inputname"))))
+            return E_OUTOFMEMORY;
+        hr = IWMStreamConfig_SetConnectionName(l->config, s);
+        free(s);
+        if (FAILED(hr))
+            return NS_E_INVALID_DATA;
+    }
+    return S_OK;
+}
+
+static HRESULT add_list_stream(IWMStreamList *list, const struct tag *tag)
+{
+    LONGLONG number;
+    BOOL present;
+
+    if (!attr_number(tag, L"streamnumber", &number, &present) || !present || number < 1 || number > MAX_PROFILE_STREAM)
+        return NS_E_INVALID_DATA;
+    return IWMStreamList_AddStream(list, number) == S_OK ? S_OK : NS_E_INVALID_DATA;
+}
+
+HRESULT profile_load_xml(const WCHAR *xml, IWMProfile3 **out)
+{
+    const WCHAR *pos = xml;
+    struct loader l = {0};
+    struct tag tag;
+    BOOL in_profile = FALSE, done = FALSE;
+    HRESULT hr = S_OK;
+    int ret;
+
+    while (SUCCEEDED(hr) && !done && (ret = next_tag(&pos, &tag)) != 0)
+    {
+        if (ret < 0)
+        {
+            hr = NS_E_INVALID_DATA;
+            break;
+        }
+
+        if (!in_profile)
+        {
+            LONGLONG version, storage;
+            BOOL present;
+            WCHAR *s;
+
+            if (tag.closing || !name_is(tag.name, tag.name_len, L"profile"))
+            {
+                hr = NS_E_INVALID_DATA;
+                break;
+            }
+            if (!attr_number(&tag, L"version", &version, &present))
+                hr = NS_E_INVALID_DATA;
+            else if (!present)
+                version = WMT_VER_9_0;
+#ifdef SG_MUTANT_WMVW_XML_NOVALIDATE
+            if (FALSE)
+#else
+            if (SUCCEEDED(hr) && version != WMT_VER_4_0 && version != WMT_VER_7_0 && version != WMT_VER_8_0
+                    && version != WMT_VER_9_0)
+#endif
+                hr = NS_E_INVALID_DATA;
+            if (SUCCEEDED(hr))
+                hr = profile_create(version, &l.profile);
+            if (SUCCEEDED(hr))
+            {
+                if (!attr_number(&tag, L"storageformat", &storage, &present))
+                    hr = NS_E_INVALID_DATA;
+                else if (present && FAILED(IWMProfile3_SetStorageFormat(l.profile, storage)))
+                    hr = NS_E_INVALID_DATA;
+            }
+            if (SUCCEEDED(hr) && find_attr(&tag, L"name"))
+            {
+                if (!(s = attr_string(find_attr(&tag, L"name"))))
+                    hr = E_OUTOFMEMORY;
+                else
+                {
+                    IWMProfile3_SetName(l.profile, s);
+                    free(s);
+                }
+            }
+            if (SUCCEEDED(hr) && find_attr(&tag, L"description"))
+            {
+                if (!(s = attr_string(find_attr(&tag, L"description"))))
+                    hr = E_OUTOFMEMORY;
+                else
+                {
+                    IWMProfile3_SetDescription(l.profile, s);
+                    free(s);
+                }
+            }
+            in_profile = TRUE;
+            if (tag.selfclosing)
+                done = TRUE;
+            continue;
+        }
+
+        if (tag.closing)
+        {
+            if (name_is(tag.name, tag.name_len, L"profile"))
+                done = TRUE;
+            else if (name_is(tag.name, tag.name_len, L"streamconfig") && l.config)
+                hr = commit_stream(&l);
+            else if (name_is(tag.name, tag.name_len, L"mutexconfig") && l.mutex)
+            {
+                hr = IWMProfile3_AddMutualExclusion(l.profile, l.mutex);
+                IWMMutualExclusion_Release(l.mutex);
+                l.mutex = NULL;
+            }
+            else if (name_is(tag.name, tag.name_len, L"bandwidthsharing") && l.sharing)
+            {
+                hr = IWMProfile3_AddBandwidthSharing(l.profile, l.sharing);
+                IWMBandwidthSharing_Release(l.sharing);
+                l.sharing = NULL;
+            }
+            else if (name_is(tag.name, tag.name_len, L"streamprioritization") && l.prio)
+            {
+                if (SUCCEEDED(hr = IWMStreamPrioritization_SetPriorityRecords(l.prio, l.records, l.record_count)))
+                    hr = IWMProfile3_SetStreamPrioritization(l.profile, l.prio);
+                else
+                    hr = NS_E_INVALID_DATA;
+                IWMStreamPrioritization_Release(l.prio);
+                l.prio = NULL;
+                free(l.records);
+                l.records = NULL;
+                l.record_count = 0;
+            }
+            continue;
+        }
+
+        if (name_is(tag.name, tag.name_len, L"streamconfig"))
+        {
+            hr = open_stream(&l, &tag);
+            if (SUCCEEDED(hr) && tag.selfclosing)
+                hr = commit_stream(&l);
+        }
+        else if (l.config)
+            hr = load_media_type_tag(&l, &tag);
+        else if (name_is(tag.name, tag.name_len, L"mutexconfig"))
+        {
+            GUID type;
+            BOOL present;
+
+            if (SUCCEEDED(hr = IWMProfile3_CreateNewMutualExclusion(l.profile, &l.mutex)))
+            {
+                if (!attr_guid(&tag, L"type", &type, &present))
+                    hr = NS_E_INVALID_DATA;
+                else if (present)
+                    IWMMutualExclusion_SetType(l.mutex, &type);
+            }
+            if (SUCCEEDED(hr) && tag.selfclosing)
+            {
+                hr = IWMProfile3_AddMutualExclusion(l.profile, l.mutex);
+                IWMMutualExclusion_Release(l.mutex);
+                l.mutex = NULL;
+            }
+        }
+        else if (l.mutex && name_is(tag.name, tag.name_len, L"mutexstream"))
+            hr = add_list_stream((IWMStreamList *)l.mutex, &tag);
+        else if (name_is(tag.name, tag.name_len, L"bandwidthsharing"))
+        {
+            LONGLONG bitrate, buffer;
+            GUID type;
+            BOOL present;
+
+            if (SUCCEEDED(hr = IWMProfile3_CreateNewBandwidthSharing(l.profile, &l.sharing)))
+            {
+                if (!attr_guid(&tag, L"type", &type, &present) || !attr_num(&tag, L"bitrate", &bitrate)
+                        || !attr_num(&tag, L"buffer", &buffer))
+                    hr = NS_E_INVALID_DATA;
+                else
+                {
+                    if (present)
+                        IWMBandwidthSharing_SetType(l.sharing, &type);
+                    IWMBandwidthSharing_SetBandwidth(l.sharing, bitrate, buffer);
+                }
+            }
+            if (SUCCEEDED(hr) && tag.selfclosing)
+            {
+                hr = IWMProfile3_AddBandwidthSharing(l.profile, l.sharing);
+                IWMBandwidthSharing_Release(l.sharing);
+                l.sharing = NULL;
+            }
+        }
+        else if (l.sharing && name_is(tag.name, tag.name_len, L"sharedstream"))
+            hr = add_list_stream((IWMStreamList *)l.sharing, &tag);
+        else if (name_is(tag.name, tag.name_len, L"streamprioritization"))
+        {
+            if (SUCCEEDED(hr = IWMProfile3_CreateNewStreamPrioritization(l.profile, &l.prio)) && tag.selfclosing)
+            {
+                hr = IWMProfile3_SetStreamPrioritization(l.profile, l.prio);
+                IWMStreamPrioritization_Release(l.prio);
+                l.prio = NULL;
+            }
+        }
+        else if (l.prio && name_is(tag.name, tag.name_len, L"prioritystream"))
+        {
+            WM_STREAM_PRIORITY_RECORD *records;
+            LONGLONG number, mandatory;
+            BOOL present;
+
+            if (!attr_number(&tag, L"streamnumber", &number, &present) || !present || number < 1
+                    || number > MAX_PROFILE_STREAM || !attr_num(&tag, L"mandatory", &mandatory))
+                hr = NS_E_INVALID_DATA;
+            else if (!(records = realloc(l.records, (l.record_count + 1) * sizeof(*records))))
+                hr = E_OUTOFMEMORY;
+            else
+            {
+                l.records = records;
+                records[l.record_count].wStreamNumber = number;
+                records[l.record_count].fMandatory = !!mandatory;
+                ++l.record_count;
+            }
+        }
+    }
+
+    if (SUCCEEDED(hr) && (!done || l.config || l.mutex || l.sharing || l.prio))
+        hr = NS_E_INVALID_DATA;
+    if (SUCCEEDED(hr))
+    {
+        *out = l.profile;
+        l.profile = NULL;
+    }
+    loader_free(&l);
+    return hr;
+}
