From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: Keep the process's EnableMouseInPointer choice.

EnableMouseInPointer is set once per process, as the user32 input tests show
on Windows: switching it off succeeds (again too), and switching the other
way afterwards fails with ERROR_ACCESS_DENIED; a process that asked for it
on cannot switch it off later. IsMouseInPointerEnabled answers without
setting an error. Switching it on still fails (FIXME): mouse input does not
become WM_POINTER messages here. The input test's todo marks follow.

Gate: test/win32u-mouseinpointer-gate.sh (64/32).
---
 dlls/user32/tests/input.c  |  5 ++---
 dlls/win32u/input.c        | 38 +++++++++++++++++++++++++++++++++++---
 dlls/win32u/tests/win32u.c |  5 ++---
 3 files changed, 39 insertions(+), 9 deletions(-)

diff --git a/dlls/user32/tests/input.c b/dlls/user32/tests/input.c
index 75ec423..9090a47 100644
--- a/dlls/user32/tests/input.c
+++ b/dlls/user32/tests/input.c
@@ -5589,20 +5589,19 @@ static void test_EnableMouseInPointer( const char *arg )
     winetest_push_context( "enable %lu", enable );
 
     ret = pEnableMouseInPointer( enable );
-    todo_wine
+    todo_wine_if(enable)
     ok( ret, "EnableMouseInPointer failed, error %lu\n", GetLastError() );
 
     SetLastError( 0xdeadbeef );
     ret = pEnableMouseInPointer( !enable );
     ok( !ret, "EnableMouseInPointer succeeded\n" );
-    todo_wine
     ok( GetLastError() == ERROR_ACCESS_DENIED, "got error %lu\n", GetLastError() );
     ret = pIsMouseInPointerEnabled();
     todo_wine_if(enable)
     ok( ret == enable, "IsMouseInPointerEnabled returned %u, error %lu\n", ret, GetLastError() );
 
     ret = pEnableMouseInPointer( enable );
-    todo_wine
+    todo_wine_if(enable)
     ok( ret, "EnableMouseInPointer failed, error %lu\n", GetLastError() );
     ret = pIsMouseInPointerEnabled();
     todo_wine_if(enable)
diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
index b3c72da..55cfc9e 100644
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -2567,11 +2567,41 @@ void toggle_caret( HWND hwnd )
 /**********************************************************************
  *       NtUserEnableMouseInPointer    (win32u.@)
  */
+/* set once per process (user32 input tests): -1 not yet, 0 off, 1 on,
+ * 2 asked for on but refused (still set: it cannot be switched off) */
+static LONG mouse_in_pointer = -1;
+
 BOOL WINAPI NtUserEnableMouseInPointer( BOOL enable )
 {
-    FIXME( "enable %u stub!\n", enable );
+    LONG prev;
+
+    TRACE( "enable %u\n", enable );
+
+    enable = !!enable;
+#ifndef SG_MUTANT_MIP_NO_STATE
+    /* mouse input does not turn into WM_POINTER messages here, so it cannot
+     * be switched on; switching it off is what the process has anyway */
+    if (enable)
+    {
+        prev = InterlockedCompareExchange( &mouse_in_pointer, 2, -1 );
+        if (prev == 0)
+        {
+            RtlSetLastWin32Error( ERROR_ACCESS_DENIED );
+            return FALSE;
+        }
+        FIXME( "mouse in pointer mode not supported\n" );
+        RtlSetLastWin32Error( ERROR_CALL_NOT_IMPLEMENTED );
+        return FALSE;
+    }
+    prev = InterlockedCompareExchange( &mouse_in_pointer, 0, -1 );
+    if (prev == -1 || prev == 0) return TRUE;
+    RtlSetLastWin32Error( ERROR_ACCESS_DENIED );
+    return FALSE;
+#else
+    (void)prev;
     RtlSetLastWin32Error( ERROR_CALL_NOT_IMPLEMENTED );
     return FALSE;
+#endif
 }
 
 /**********************************************************************
@@ -2589,9 +2619,11 @@ BOOL WINAPI NtUserEnableMouseInPointerForThread( void )
  */
 BOOL WINAPI NtUserIsMouseInPointerEnabled(void)
 {
-    FIXME( "stub!\n" );
+    TRACE( "\n" );
+#ifdef SG_MUTANT_MIP_NO_STATE
     RtlSetLastWin32Error( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+#endif
+    return mouse_in_pointer == 1;
 }
 
 static BOOL is_captured_by_system(void)
diff --git a/dlls/win32u/tests/win32u.c b/dlls/win32u/tests/win32u.c
index 8e1b56f..f8fc7a5 100644
--- a/dlls/win32u/tests/win32u.c
+++ b/dlls/win32u/tests/win32u.c
@@ -1687,7 +1687,7 @@ static void test_NtUserEnableMouseInPointer( const char *arg )
     ok( !ret, "NtUserIsMouseInPointerEnabled returned %u, error %lu\n", ret, GetLastError() );
 
     ret = NtUserEnableMouseInPointer( enable );
-    todo_wine
+    todo_wine_if(enable)
     ok( ret, "NtUserEnableMouseInPointer failed, error %lu\n", GetLastError() );
     ret = NtUserIsMouseInPointerEnabled();
     todo_wine_if(enable)
@@ -1696,14 +1696,13 @@ static void test_NtUserEnableMouseInPointer( const char *arg )
     SetLastError( 0xdeadbeef );
     ret = NtUserEnableMouseInPointer( !enable );
     ok( !ret, "NtUserEnableMouseInPointer succeeded\n" );
-    todo_wine
     ok( GetLastError() == ERROR_ACCESS_DENIED, "got error %lu\n", GetLastError() );
     ret = NtUserIsMouseInPointerEnabled();
     todo_wine_if(enable)
     ok( ret == enable, "NtUserIsMouseInPointerEnabled returned %u, error %lu\n", ret, GetLastError() );
 
     ret = NtUserEnableMouseInPointer( enable );
-    todo_wine
+    todo_wine_if(enable)
     ok( ret, "NtUserEnableMouseInPointer failed, error %lu\n", GetLastError() );
     ret = NtUserIsMouseInPointerEnabled();
     todo_wine_if(enable)
