From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:55:29 -0700
Subject: [PATCH] wsock32: GetService finds no service (3274)

GetServiceA/W set ERROR_CALL_NOT_IMPLEMENTED and returned SOCKET_ERROR. No name space provider is in use, so the service is not found: ERROR_SERVICE_NOT_FOUND and a result of zero, as documented.

diff --git a/dlls/wsock32/service.c b/dlls/wsock32/service.c
index c109511..4ebb66a 100644
--- a/dlls/wsock32/service.c
+++ b/dlls/wsock32/service.c
@@ -84,9 +84,9 @@ INT WINAPI GetTypeByNameA(LPSTR lpServiceName, LPGUID lpServiceType)
    /* tell the user they've got a substandard implementation */
    FIXME("wsock32: GetTypeByNameA(%p, %p): stub\n", lpServiceName, lpServiceType);
    
-   /* some programs may be able to compensate if they know what happened */
-   SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-   return SOCKET_ERROR; /* error value */
+   /* no name space provider is in use: the service is not found, and the result is zero */
+   SetLastError(ERROR_SERVICE_NOT_FOUND);
+   return 0; /* error value */
 }
 
 
@@ -136,9 +136,9 @@ INT WINAPI SetServiceA(DWORD dwNameSpace, DWORD dwOperation, DWORD dwFlags, LPSE
    FIXME("wsock32: SetServiceA(%lu, %lu, %lu, %p, %p, %p): stub\n", dwNameSpace, dwOperation, dwFlags,
            lpServiceInfo, lpServiceAsyncInfo, lpdwStatusFlags);
     
-   /* some programs may be able to compensate if they know what happened */
-   SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-   return SOCKET_ERROR; /* error value */ 
+   /* no name space provider is in use: the service is not found, and the result is zero */
+   SetLastError(ERROR_SERVICE_NOT_FOUND);
+   return 0; /* error value */ 
 }
 
 /******************************************************************************
@@ -153,9 +153,9 @@ INT WINAPI SetServiceW(DWORD dwNameSpace, DWORD dwOperation, DWORD dwFlags, LPSE
    FIXME("wsock32: SetServiceW(%lu, %lu, %lu, %p, %p, %p): stub\n", dwNameSpace, dwOperation, dwFlags,
            lpServiceInfo, lpServiceAsyncInfo, lpdwStatusFlags);
     
-   /* some programs may be able to compensate if they know what happened */
-   SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-   return SOCKET_ERROR; /* error value */ 
+   /* no name space provider is in use: the service is not found, and the result is zero */
+   SetLastError(ERROR_SERVICE_NOT_FOUND);
+   return 0; /* error value */ 
 }
 
 /******************************************************************************
@@ -195,9 +195,13 @@ INT WINAPI GetServiceA(DWORD dwNameSpace, LPGUID lpGuid, LPSTR lpServiceName,
    FIXME("(%lu, %p, %s, %lu, %p, %p, %p): stub\n", dwNameSpace,
          lpGuid, lpServiceName, dwProperties, lpBuffer, lpdwBufferSize, lpServiceAsyncInfo);
 
-   /* some programs may be able to compensate if they know what happened */
+   /* no name space provider is in use: the service is not found, and the result is zero */
+#ifdef SG_MUTANT_WSOCK32
    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
    return SOCKET_ERROR;
+#endif
+   SetLastError(ERROR_SERVICE_NOT_FOUND);
+   return 0;
 }
 
 /******************************************************************************
@@ -212,7 +216,7 @@ INT WINAPI GetServiceW(DWORD dwNameSpace, LPGUID lpGuid, LPSTR lpServiceName,
    FIXME("(%lu, %p, %s, %lu, %p, %p, %p): stub\n", dwNameSpace,
          lpGuid, lpServiceName, dwProperties, lpBuffer, lpdwBufferSize, lpServiceAsyncInfo);
 
-   /* some programs may be able to compensate if they know what happened */
-   SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-   return SOCKET_ERROR;
+   /* no name space provider is in use: the service is not found, and the result is zero */
+   SetLastError(ERROR_SERVICE_NOT_FOUND);
+   return 0;
 }
