From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: Click-to-Run Office's machine hive is writable by users (5942)

server: Click-to-Run Office's machine hive is writable by users

Word (Microsoft 365, Click-to-Run) could not save a new document: "The save
failed due to out of memory or disk space". Saving a document that already
existed worked. Bisected to 10.0-427, where 3764 gave the keys of system.reg
without a descriptor the machine default (SYSTEM and Administrators full,
Users read). Click-to-Run Office keeps a machine hive of its own under
HKLM\Software\Microsoft\Office\ClickToRun\REGISTRY, and its virtual registry,
running inside WINWORD.EXE as the user, opens those keys with KEY_ALL_ACCESS
(over 1,400 denials during one save, with SG_TRACE_MKEY_DENY=1); the
component lookups failed, and with them the document clone of a first save
(Word's macro storage). Giving the hive's keys an explicit "users full"
descriptor on a running machine made the save work.

The hive (and the one below Wow6432Node) is now treated like the display
configuration: its keys without a descriptor are not checked against the
machine default, and keys made in it later get the users-writable DACL. Keys
beside it (ClickToRun itself, the rest of HKLM\Software\Microsoft\Office) keep
the default. Gate test-hklmsd (C2R checks); mutant SG_MUTANT_C2R_HIVE_READONLY.
---
--- a/server/registry.c
+++ b/server/registry.c
@@ -559,11 +559,41 @@
     return 0;
 }
 
+/* Stained Glass OS: the machine hive Click-to-Run Office keeps for itself, HKLM\Software\Microsoft\
+ * Office\ClickToRun\REGISTRY (and below Wow6432Node). Office's virtual registry runs inside every
+ * Office program, as the user who runs it, and opens the keys of this hive with KEY_ALL_ACCESS: under
+ * the machine default (Users read) the component lookups failed and Word could not save a new
+ * document ("The save failed due to out of memory or disk space", wine-sg 5942). The hive holds
+ * Office's view of the machine, read only by Office, so users write it, as they do the display
+ * configuration. */
+static int sg_is_office_c2r_name( const WCHAR *name, data_size_t len )
+{
+    static const char * const hives[] =
+    {
+        "\\Registry\\Machine\\Software\\Microsoft\\Office\\ClickToRun\\REGISTRY",
+        "\\Registry\\Machine\\Software\\Wow6432Node\\Microsoft\\Office\\ClickToRun\\REGISTRY",
+    };
+    data_size_t chars = len / sizeof(WCHAR), i, j, n;
+
+#ifdef SG_MUTANT_C2R_HIVE_READONLY
+    return 0;
+#endif
+    for (i = 0; i < ARRAY_SIZE(hives); i++)
+    {
+        n = strlen( hives[i] );
+        if (chars < n || (chars > n && name[n] != '\\')) continue;
+        for (j = 0; j < n; j++)
+            if (name[j] >= 0x80 || tolower( name[j] ) != tolower( (unsigned char)hives[i][j] )) break;
+        if (j == n) return 1;
+    }
+    return 0;
+}
+
 static int sg_is_display_config_key( struct object *obj )
 {
     data_size_t len = 0;
     WCHAR *name = obj->ops->get_full_name( obj, &len );
-    int ret = name && sg_is_display_config_name( name, len );
+    int ret = name && (sg_is_display_config_name( name, len ) || sg_is_office_c2r_name( name, len ));
     free( name );
     return ret;
 }
@@ -592,7 +622,7 @@
     if (!(name = default_get_full_name( obj, &len ))) return NULL;
     machine = len >= sizeof(machineW) && !memicmp_strW( name, machineW, sizeof(machineW) ) &&
               (len == sizeof(machineW) || name[ARRAY_SIZE(machineW)] == '\\');
-    if (machine && sg_is_display_config_name( name, len )) machine = 0;
+    if (machine && (sg_is_display_config_name( name, len ) || sg_is_office_c2r_name( name, len ))) machine = 0;
     free( name );
     return machine ? sg_machine_key_sd() : NULL;
 }
