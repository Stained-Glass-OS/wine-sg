+/* a 32-bit program could not reach the 64-bit driver's configuration DLL, so it
+ * has only the public settings: the driver merges them into its own here */
+static DEVMODEW *driver_devmode( HANDLE printer, const WCHAR *name, DEVMODEW *dm )
+{
+    DEVMODEW *full;
+    LONG size;
+
+#ifdef SG_MUTANT_CAPSDEVMODE
+    return dm;
+#endif
+    if (dm && dm->dmDriverExtra) return dm;
+    size = DocumentPropertiesW( NULL, printer, (WCHAR *)name, NULL, NULL, 0 );
+    if (size <= 0 || !(full = calloc( 1, size ))) return dm;
+    full->dmSize = size; /* the buffer's size, as winspool tells the driver */
+    if (DocumentPropertiesW( NULL, printer, (WCHAR *)name, full, dm,
+                             dm ? DM_IN_BUFFER | DM_OUT_BUFFER : DM_OUT_BUFFER ) != IDOK || !full->dmDriverExtra)
+    {
+        free( full );
+        return dm;
+    }
+    free( dm );
+    return full;
+}
