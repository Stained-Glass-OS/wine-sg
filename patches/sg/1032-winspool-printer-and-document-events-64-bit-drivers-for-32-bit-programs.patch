+/* A 32-bit program cannot load a 64-bit driver's configuration DLL (nor the
+ * makers' plug-ins it loads): our 64-bit print host asks the driver for it.
+ * The settings go over in a file; the reply is the call's result and data. */
+static BOOL ask_print_host( const WCHAR *verb, const WCHAR *device, const WCHAR *args, const DEVMODEW *devmode,
+                            LONG *result, void **data, DWORD *size )
+{
+    WCHAR dir[MAX_PATH], in_file[MAX_PATH], out_file[MAX_PATH], host[MAX_PATH], *cmd;
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    BOOL wow64 = FALSE, ret = FALSE;
+    DWORD code = 1, w;
+    HANDLE file;
+    size_t len;
+
+    *data = NULL;
+    *size = 0;
+#ifdef SG_MUTANT_HOSTCONFIG
+    return FALSE;
+#endif
+    if (!IsWow64Process( GetCurrentProcess(), &wow64 ) || !wow64) return FALSE;
+    GetTempPathW( MAX_PATH, dir );
+    if (!GetTempFileNameW( dir, L"shi", 0, in_file )) return FALSE;
+    if (!GetTempFileNameW( dir, L"sho", 0, out_file ))
+    {
+        DeleteFileW( in_file );
+        return FALSE;
+    }
+    file = CreateFileW( in_file, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    if (file != INVALID_HANDLE_VALUE)
+    {
+        if (devmode) WriteFile( file, devmode, devmode->dmSize + devmode->dmDriverExtra, &w, NULL );
+        CloseHandle( file );
+    }
+    GetWindowsDirectoryW( host, MAX_PATH );
+    lstrcatW( host, L"\\sysnative\\splwow64.exe" );
+    len = wcslen( host ) + wcslen( verb ) + wcslen( device ) + wcslen( in_file ) + wcslen( out_file ) + wcslen( args ) + 32;
+    cmd = malloc( len * sizeof(WCHAR) );
+    if (!wcscmp( verb, L"devcaps" ))
+        swprintf( cmd, len, L"\"%s\" devcaps \"%s\" %s \"%s\" \"%s\"", host, device, args, in_file, out_file );
+    else
+        swprintf( cmd, len, L"\"%s\" %s \"%s\" \"%s\" \"%s\" %s", host, verb, device, in_file, out_file, args );
+    TRACE( "%s\n", debugstr_w(cmd) );
+    if (CreateProcessW( host, cmd, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi ))
+    {
+        WaitForSingleObject( pi.hProcess, INFINITE );
+        GetExitCodeProcess( pi.hProcess, &code );
+        CloseHandle( pi.hProcess );
+        CloseHandle( pi.hThread );
+    }
+    free( cmd );
+    file = CreateFileW( out_file, GENERIC_READ, 0, NULL, OPEN_EXISTING, 0, NULL );
+    if (!code && file != INVALID_HANDLE_VALUE)
+    {
+        DWORD total = GetFileSize( file, NULL ), got;
+
+        if (total >= sizeof(LONG) && ReadFile( file, result, sizeof(LONG), &got, NULL ) && got == sizeof(LONG))
+        {
+            ret = TRUE;
+            if (total > sizeof(LONG) && (*data = malloc( total - sizeof(LONG) )))
+            {
+                if (ReadFile( file, *data, total - sizeof(LONG), &got, NULL )) *size = got;
+            }
+        }
+    }
+    if (file != INVALID_HANDLE_VALUE) CloseHandle( file );
+    DeleteFileW( in_file );
+    DeleteFileW( out_file );
+    return ret;
+}
