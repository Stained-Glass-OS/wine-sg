+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    ok = WriteFile( file, &ret, sizeof(ret), &w, NULL ) && (!size || WriteFile( file, data, size, &w, NULL ));
+    CloseHandle( file );
+    return ok;
+}
+
+/* DocumentProperties in this process, where the driver's configuration DLL
+ * (and its makers' plug-ins and pages) loads; hwnd owns its dialog */
+static int devprops( const WCHAR *name, const WCHAR *in_file, const WCHAR *out_file, DWORD mode, HWND hwnd )
+{
+    DEVMODEW *in = read_devmode( in_file ), *out = NULL;
+    LONG ret, size = 0;
+
+    if ((mode & DM_OUT_BUFFER) && (size = DocumentPropertiesW( NULL, NULL, (WCHAR *)name, NULL, NULL, 0 )) > 0 &&
+        (out = calloc( 1, size )))
+        out->dmSize = size;
+    ret = DocumentPropertiesW( hwnd, NULL, (WCHAR *)name, out, in, out ? mode : mode & ~DM_OUT_BUFFER );
+    WINE_TRACE( "%s mode %#lx: %ld\n", debugstr_w(name), mode, ret );
+    if (!write_reply( out_file, ret, out, ret >= 0 && out ? out->dmSize + out->dmDriverExtra : 0 )) return 1;
+    free( in );
+    free( out );
+    return 0;
+}
+
+/* the printer's own (device) settings, as PrinterProperties shows them */
+static int printerprops( const WCHAR *name, const WCHAR *out_file, HWND hwnd )
+{
+    HANDLE printer;
+    LONG ret = FALSE;
+
+    if (OpenPrinterW( (WCHAR *)name, &printer, NULL ))
+    {
+        ret = PrinterProperties( hwnd, printer );
+        ClosePrinter( printer );
+    }
+    return !write_reply( out_file, ret, NULL, 0 );
+}
+
+/* the size of one entry of a DeviceCapabilities list */
+static DWORD devcaps_entry( WORD cap )
+{
+    switch (cap)
+    {
+    case DC_PAPERS:
+    case DC_BINS:
+        return sizeof(WORD);
+    case DC_PAPERSIZE:
+    case DC_ENUMRESOLUTIONS:
+        return 2 * sizeof(LONG);
+    case DC_MEDIATYPES:
+    case DC_NUP:
+        return sizeof(DWORD);
+    case DC_BINNAMES:
+        return 24 * sizeof(WCHAR);
+    case DC_PERSONALITY:
+        return 32 * sizeof(WCHAR);
+    case DC_PAPERNAMES:
+    case DC_FILEDEPENDENCIES:
+    case DC_MEDIAREADY:
+    case DC_MEDIATYPENAMES:
+        return 64 * sizeof(WCHAR);
+    }
+    return 0;
+}
+
+static int devcaps( const WCHAR *name, WORD cap, const WCHAR *in_file, const WCHAR *out_file )
+{
+    DEVMODEW *in = read_devmode( in_file );
+    DWORD entry = devcaps_entry( cap ), size = 0;
+    void *buf = NULL;
+    LONG ret;
+
+    ret = DeviceCapabilitiesW( name, NULL, cap, NULL, in );
+    if (ret > 0 && entry && (buf = calloc( ret, entry )))
+    {
+        ret = DeviceCapabilitiesW( name, NULL, cap, buf, in );
+        if (ret > 0) size = ret * entry;
+    }
+    WINE_TRACE( "%s cap %u: %ld\n", debugstr_w(name), cap, ret );
+    if (!write_reply( out_file, ret, buf, size )) return 1;
+    free( in );
+    free( buf );
+    return 0;
+}
