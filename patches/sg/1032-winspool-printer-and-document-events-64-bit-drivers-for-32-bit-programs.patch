+static BOOL write_reply( const WCHAR *out_file, LONG ret, const void *data, DWORD size )
+{
+    HANDLE file = CreateFileW( out_file, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
