 /******************************************************************
+ *              DocumentEvent   [WINSPOOL.@]
+ *
+ * GDI tells the printer's configuration DLL about a printing call before
+ * (and for some, after) it makes it: makers' drivers prepare a job there,
+ * and Samsung's leaves what its print processor waits for.
+ */
+INT WINAPI DocumentEvent( HANDLE printer, HDC hdc, INT esc, ULONG cb_in, void *in, ULONG cb_out, void *out )
+{
+    config_module_t *config;
+    const WCHAR *device;
+    INT ret = DOCUMENTEVENT_UNSUPPORTED;
+
+    TRACE( "%p, %p, %d, %lu, %p, %lu, %p\n", printer, hdc, esc, cb_in, in, cb_out, out );
+
+    if (!(device = get_opened_printer_name( printer ))) return DOCUMENTEVENT_UNSUPPORTED;
+    /* a 32-bit program and a 64-bit configuration DLL: GDI goes on without it */
+    if (!(config = get_config_module( device, TRUE ))) return DOCUMENTEVENT_UNSUPPORTED;
+    if (config->pDrvDocumentEvent)
+    {
+        ret = config->pDrvDocumentEvent( printer, hdc, esc, cb_in, in, cb_out, out );
+        TRACE( "%s: event %d: %d\n", debugstr_w(device), esc, ret );
+    }
+    release_config_module( config );
+    return ret;
+}
