+/* Stained Glass OS: a rectangle of the desktop's picture drawn again, put
+ * into the picture published, in place: the desktop's compositor paints the
+ * desktop from that pixmap (what explorer draws on the desktop window itself
+ * is under the compositor's canvas), and sees the change as damage to it. A
+ * rubber band dragged out on the desktop was not drawn there at all: the
+ * whole picture was only made again once the mouse had rested. */
+static BOOL set_desktop_part( const struct x11drv_escape_sg_background_part *part )
+{
+    XImage *image;
+    GC gc;
+
+    if (!desktop_pixmap || !is_virtual_desktop() || root_window == DefaultRootWindow( gdi_display )) return FALSE;
+    if (!part->bits || part->width <= 0 || part->height <= 0 || part->x < 0 || part->y < 0 ||
+        part->x + part->width > desktop_pixmap_width || part->y + part->height > desktop_pixmap_height)
+        return FALSE;
+    if (!(image = XCreateImage( gdi_display, default_visual.visual, default_visual.depth, ZPixmap, 0,
+                                (char *)part->bits, part->width, part->height, 32, part->width * 4 )))
+        return FALSE;
+    if (image->bits_per_pixel != 32 || image->byte_order != LSBFirst)
+    {
+        image->data = NULL;
+        XDestroyImage( image );
+        return FALSE;
+    }
+    gc = XCreateGC( gdi_display, desktop_pixmap, 0, NULL );
+    XPutImage( gdi_display, desktop_pixmap, gc, image, 0, 0, part->x, part->y, part->width, part->height );
+    XFreeGC( gdi_display, gc );
+    XFlush( gdi_display );
+    image->data = NULL;
+    XDestroyImage( image );
+    return TRUE;
+}
