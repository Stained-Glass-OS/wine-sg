+/* the arrows, Home, End and Space, as on Windows' desktop: the focus moves
+ * and the selection with it (Shift: from the anchor; Ctrl: the focus alone,
+ * Ctrl+Space toggles); the focused icon is marked from now on */
+static void sg_key_nav( HWND hwnd, WPARAM key )
+{
+    BOOL ctrl = GetKeyState( VK_CONTROL ) < 0, shift = GetKeyState( VK_SHIFT ) < 0;
+    int cur = sg_selected >= 0 && sg_selected < (int)nb_launchers ? sg_selected : -1, next = cur;
+    unsigned int i;
+
+    if (!nb_launchers) return;
+    sg_focus_cues = TRUE;
+    if (key == VK_SPACE)
+    {
+        if (cur < 0) next = 0;
+        else if (ctrl) { launchers[cur]->selected = !launchers[cur]->selected; next = -2; }
+        else launchers[cur]->selected = TRUE;
+    }
+    else if (cur < 0 || key == VK_HOME || key == VK_END)
+    {
+        next = 0;
+        for (i = 1; i < nb_launchers; i++)
+        {
+            int a = launchers[i]->col * 100000 + launchers[i]->row, b = launchers[next]->col * 100000 + launchers[next]->row;
+            if (key == VK_END ? a > b : a < b) next = i;
+        }
+    }
+    else if ((next = sg_neighbour( cur, key )) < 0) next = cur;
+    if (next >= 0)
+    {
+        if (ctrl) sg_selected = next;
+        else if (shift && key != VK_SPACE) sg_select_range( next );
+        else { sg_select_only( next ); sg_anchor = next; }
+    }
+    sg_tip_hide();
+    InvalidateRect( hwnd, NULL, TRUE );
+}
