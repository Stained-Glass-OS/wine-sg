+    BOOL selected = launchers[index]->selected || (int)index == sg_drop_hilite;
+    BOOL hot = (int)index == sg_hot;
+    BOOL focused = sg_focus_cues && (int)index == sg_selected;
+    COLORREF accent = taskbar_accent(), fill = sg_tint( accent, 60 ), edge = sg_tint( accent, 35 );
+    RECT box = sg_item_box( index );
+    int radius = sg_px( sg_box_radius );
+
+#ifdef SG_MUTANT_NO_HOT
+    hot = FALSE;
+#endif
+    if (selected && hot) sg_draw_box( hdc, &box, fill, 0x90, edge, 0xE8, radius );
+    else if (selected) sg_draw_box( hdc, &box, fill, 0x70, edge, focused ? 0xF0 : 0xC8, radius );
+    else if (hot) sg_draw_box( hdc, &box, fill, 0x40, edge, 0x90, radius );
+    else if (focused) sg_draw_box( hdc, &box, fill, 0, edge, 0xD0, radius );
+}
