+/* a region drawn again: its rectangles, or its bounds when it has many */
+static void sg_redraw_region( HWND hwnd, HRGN rgn )
+{
+    DWORD size = GetRegionData( rgn, 0, NULL );
+    RGNDATA *data;
+    RECT bounds;
+
+    if (GetRgnBox( rgn, &bounds ) == NULLREGION) return;
+    if (size && (data = malloc( size )))
+    {
+        if (GetRegionData( rgn, size, data ) && data->rdh.nCount <= 16)
