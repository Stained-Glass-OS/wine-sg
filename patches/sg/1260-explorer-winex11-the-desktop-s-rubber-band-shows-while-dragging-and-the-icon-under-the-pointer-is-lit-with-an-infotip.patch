+/* --- the icon under the pointer, its infotip, the keyboard ---------------------------- */
+
+#define SG_HOVER_TIMER   0x5348      /* the pointer rested on an icon: its infotip */
+#define SG_LEAVE_TIMER   0x5349      /* is the pointer still on the lit icon? */
+
+/* the look's corners for the icons' boxes: Rounded's and Glass's round,
+ * Classic's and Horizon's square (Style\Rounded, Style\Frame: Settings >
+ * Personalization > Looks) */
+static void sg_load_look(void)
+{
+    DWORD rounded = 0, frame = 0, size = sizeof(DWORD);
+
+    RegGetValueW( HKEY_CURRENT_USER, L"Software\\Stained Glass\\Style", L"Rounded", RRF_RT_REG_DWORD, NULL, &rounded, &size );
+    size = sizeof(DWORD);
+    RegGetValueW( HKEY_CURRENT_USER, L"Software\\Stained Glass\\Style", L"Frame", RRF_RT_REG_DWORD, NULL, &frame, &size );
+    sg_box_radius = frame == 2 ? 3 : frame == 1 ? 0 : rounded ? 4 : 0;
+}
+
+static void sg_redraw_item( HWND hwnd, int index )
+{
+    RECT box;
+
+    if (index < 0 || index >= (int)nb_launchers) return;
+    box = sg_item_box( index );
+    InflateRect( &box, 1, 1 );
+    sg_redraw( hwnd, &box );
+}
+
+static void sg_tip_hide(void)
+{
+    TTTOOLINFOW ti = { sizeof(ti), 0, sg_desktop_hwnd, 1 };
+
+    if (sg_tip_index < 0) return;
+    sg_tip_index = -1;
+    if (sg_tip_hwnd) SendMessageW( sg_tip_hwnd, TTM_TRACKACTIVATE, FALSE, (LPARAM)&ti );
+}
+
+static void sg_append( WCHAR *buf, size_t len, const WCHAR *label, const WCHAR *value )
+{
+    size_t n = wcslen( buf );
+    if (!value || !*value || n + 2 >= len) return;
+    swprintf( buf + n, len - n, L"\n%s%s", label, value );
+}
+
+static void sg_format_time( const FILETIME *ft, WCHAR *out, int len )
+{
+    FILETIME local;
+    SYSTEMTIME st;
+    int n;
+
+    out[0] = 0;
+    if (!ft->dwLowDateTime && !ft->dwHighDateTime) return;
+    if (!FileTimeToLocalFileTime( ft, &local ) || !FileTimeToSystemTime( &local, &st )) return;
+    n = GetDateFormatW( LOCALE_USER_DEFAULT, DATE_SHORTDATE, &st, NULL, out, len );
+    if (n <= 0 || n >= len - 1) return;
+    out[n - 1] = ' ';
+    GetTimeFormatW( LOCALE_USER_DEFAULT, TIME_NOSECONDS, &st, NULL, out + n, len - n );
+}
+
+/* what Windows' infotip says of an icon: its full name (a long one is cut
+ * short under the icon), then a file's type, size and date; a shortcut's
+ * comment or where its target is; a folder's date; a shell icon's own tip */
+static void sg_tip_text( unsigned int index, WCHAR *buf, size_t len )
+{
+    const struct launcher *l = launchers[index];
+    const WCHAR *ext = l->path ? wcsrchr( l->path, '.' ) : NULL;
+    WCHAR value[MAX_PATH + 64];
+
+    lstrcpynW( buf, l->title ? l->title : L"", len );
+    if (!l->is_file)
+    {
+        const WCHAR *clsid = l->args && l->args[0] == ':' && l->args[1] == ':' ? l->args + 2 : NULL;
+        WCHAR key[80], tip[512];
+        DWORD size = sizeof(tip);
+
+        if (!clsid && l->path && !wcsicmp( l->path, L"control.exe" )) clsid = L"{5399E694-6CE5-4D6C-8FCE-1D8870FDCBA0}";
+        if (!clsid) return;
+        swprintf( key, ARRAY_SIZE(key), L"CLSID\\%s", clsid );
+        if (RegGetValueW( HKEY_CLASSES_ROOT, key, L"InfoTip", RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ, NULL, tip, &size )) return;
+        if (tip[0] == '@' && SUCCEEDED( SHLoadIndirectString( tip, value, ARRAY_SIZE(value), NULL ) ))
+            sg_append( buf, len, L"", value );
+        else if (tip[0] != '@') sg_append( buf, len, L"", tip );
+        return;
+    }
+    if (ext && !wcsicmp( ext, L".lnk" ) && !l->is_dir)
+    {
+        IShellLinkW *link = load_shelllink( l->path );
+        WCHAR target[MAX_PATH];
+
+        if (!link) return;
+        value[0] = target[0] = 0;
+        if (SUCCEEDED( IShellLinkW_GetDescription( link, value, ARRAY_SIZE(value) ) ) && value[0])
+            sg_append( buf, len, L"", value );
+        else if (SUCCEEDED( IShellLinkW_GetPath( link, target, ARRAY_SIZE(target), NULL, SLGP_RAWPATH ) ) && target[0])
+        {
+            WCHAR *slash = wcsrchr( target, '\\' );
+            if (slash && slash > target + 2) *slash = 0;
+            else if (slash) slash[1] = 0;
+            sg_append( buf, len, L"Location: ", target );
+        }
+        IShellLinkW_Release( link );
+        return;
+    }
+    if (!l->is_dir)
+    {
+        sg_append( buf, len, L"Type: ", l->type );
+        if (StrFormatByteSizeW( l->size, value, ARRAY_SIZE(value) )) sg_append( buf, len, L"Size: ", value );
+    }
+    sg_format_time( &l->mtime, value, ARRAY_SIZE(value) );
+    sg_append( buf, len, L"Date modified: ", value );
+}
+
+static void sg_tip_show( HWND hwnd, int index )
+{
+    TTTOOLINFOW ti = { sizeof(ti), TTF_TRACK | TTF_ABSOLUTE | TTF_TRANSPARENT, hwnd, 1 };
+    WCHAR text[1024];
+    POINT pt;
+
+#ifdef SG_MUTANT_NO_INFOTIP
+    return;
+#endif
+    if (!sg_tip_hwnd)
+    {
+        INITCOMMONCONTROLSEX icc = { sizeof(icc), ICC_WIN95_CLASSES };
+        InitCommonControlsEx( &icc );
+        sg_tip_hwnd = CreateWindowExW( WS_EX_TOPMOST | WS_EX_TOOLWINDOW, TOOLTIPS_CLASSW, NULL,
+                                       WS_POPUP | TTS_NOPREFIX | TTS_ALWAYSTIP, 0, 0, 0, 0, hwnd, NULL, NULL, NULL );
+        if (!sg_tip_hwnd) return;
+        ti.lpszText = (WCHAR *)L"";
+        SendMessageW( sg_tip_hwnd, TTM_ADDTOOLW, 0, (LPARAM)&ti );
+    }
+    /* lines, as wide as a sentence, with a little room round them */
+    SendMessageW( sg_tip_hwnd, TTM_SETMAXTIPWIDTH, 0, sg_px( 400 ) );
+    {
+        RECT margin = { sg_px( 4 ), sg_px( 2 ), sg_px( 4 ), sg_px( 2 ) };
+        SendMessageW( sg_tip_hwnd, TTM_SETMARGIN, 0, (LPARAM)&margin );
+    }
+    sg_tip_text( index, text, ARRAY_SIZE(text) );
+    ti.lpszText = text;
+    SendMessageW( sg_tip_hwnd, TTM_UPDATETIPTEXTW, 0, (LPARAM)&ti );
+    /* below the pointer, as Windows puts it */
+    GetCursorPos( &pt );
+    SendMessageW( sg_tip_hwnd, TTM_TRACKPOSITION, 0, MAKELPARAM( pt.x, pt.y + sg_px( 21 ) ) );
+    SendMessageW( sg_tip_hwnd, TTM_TRACKACTIVATE, TRUE, (LPARAM)&ti );
+    sg_tip_index = index;
+    sg_dump();
+}
+
+/* the pointer is over the desktop itself (not a window on it) at this icon, or -1 */
+static int sg_index_under_pointer( HWND hwnd )
+{
+    POINT pt;
+
+    if (!GetCursorPos( &pt )) return -1;
+    if (WindowFromPoint( pt ) != hwnd) return -1;
+    ScreenToClient( hwnd, &pt );
+    return launcher_index_from_point( pt.x, pt.y );
+}
+
+/* the icon under the pointer, lit (-1: none) */
+static void sg_set_hot( HWND hwnd, int index )
+{
+    int old = sg_hot;
+
+    if (index == old) return;
+    sg_hot = index;
+    sg_tip_hide();
+    sg_redraw_item( hwnd, old );
+    sg_redraw_item( hwnd, index );
+    if (index >= 0)
+    {
+        UINT delay = 0;
+        /* the infotip after the pointer rests: the tooltips' delay (Windows'
+         * double-click time, 500 ms) */
+        SystemParametersInfoW( SPI_GETMOUSEHOVERTIME, 0, &delay, 0 );
+        SetTimer( hwnd, SG_HOVER_TIMER, max( delay, GetDoubleClickTime() ), NULL );
+        SetTimer( hwnd, SG_LEAVE_TIMER, 100, NULL );
+    }
+    else
+    {
+        KillTimer( hwnd, SG_HOVER_TIMER );
+        KillTimer( hwnd, SG_LEAVE_TIMER );
+    }
+    sg_dump();
+}
+
+/* the icon next to INDEX in the arrow's direction, on the grid (-1: none) */
+static int sg_neighbour( int index, WPARAM key )
+{
+    int c = launchers[index]->col, r = launchers[index]->row, best = -1, best_d = INT_MAX;
+    unsigned int i;
+
+    for (i = 0; i < nb_launchers; i++)
+    {
+        int dc = launchers[i]->col - c, dr = launchers[i]->row - r, along, across, d;
+        if ((int)i == index) continue;
+        switch (key)
+        {
+        case VK_LEFT:  along = -dc; across = dr; break;
+        case VK_RIGHT: along = dc;  across = dr; break;
+        case VK_UP:    along = -dr; across = dc; break;
+        default:       along = dr;  across = dc; break;
+        }
+        if (along <= 0) continue;
+        d = along * along + 4 * across * across;
+        if (d < best_d) { best_d = d; best = i; }
+    }
+    return best;
+}
