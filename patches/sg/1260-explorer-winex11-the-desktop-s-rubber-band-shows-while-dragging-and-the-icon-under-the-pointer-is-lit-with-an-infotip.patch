+static COLORREF sg_tint( COLORREF c, int percent_white )
+{
+    return RGB( GetRValue(c) + (255 - GetRValue(c)) * percent_white / 100,
+                GetGValue(c) + (255 - GetGValue(c)) * percent_white / 100,
+                GetBValue(c) + (255 - GetBValue(c)) * percent_white / 100 );
+}
+
+/* how much of the pixel at (x, y) a box of w x h with corners of RADIUS covers */
+static float sg_box_cover( int x, int y, int w, int h, int radius )
+{
+    float cx, cy, d;
+
+    if (x < 0 || y < 0 || x >= w || y >= h) return 0;
+    if (radius <= 0) return 1;
+    if (x >= radius && x < w - radius) return 1;
+    if (y >= radius && y < h - radius) return 1;
+    cx = x < radius ? radius : w - radius;
+    cy = y < radius ? radius : h - radius;
+    d = sqrtf( (x + 0.5f - cx) * (x + 0.5f - cx) + (y + 0.5f - cy) * (y + 0.5f - cy) );
+    d = radius - d + 0.5f;
+    return d <= 0 ? 0 : d >= 1 ? 1 : d;
+}
+
+/* a translucent box with a one-pixel border, its corners rounded by RADIUS:
+ * blended pixel by pixel, so it reads over any wallpaper */
+static void sg_draw_box( HDC hdc, const RECT *r, COLORREF fill, BYTE fill_alpha,
+                         COLORREF border, BYTE border_alpha, int radius )
+{
+    int w = r->right - r->left, h = r->bottom - r->top, x, y;
+    BITMAPINFO bi = {{ sizeof(bi.bmiHeader), w, -h, 1, 32, BI_RGB }};
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    HDC mem;
+    HBITMAP bmp;
+    DWORD *px;
+
+    if (w <= 2 || h <= 2) return;
+    mem = CreateCompatibleDC( hdc );
+    if ((bmp = CreateDIBSection( hdc, &bi, DIB_RGB_COLORS, (void **)&px, NULL, 0 )))
+    {
+        HGDIOBJ old = SelectObject( mem, bmp );
+        for (y = 0; y < h; y++)
+            for (x = 0; x < w; x++)
+            {
+                float outer = sg_box_cover( x, y, w, h, radius );
+                float inner = sg_box_cover( x - 1, y - 1, w - 2, h - 2, radius > 1 ? radius - 1 : 0 );
+                float ab = (outer - inner) * border_alpha, af = inner * fill_alpha;
+                float a = ab + af;
+                BYTE cr = 0, cg = 0, cb = 0;
+                if (a > 0)
+                {
+                    cr = (GetRValue(border) * ab + GetRValue(fill) * af) / 255;
+                    cg = (GetGValue(border) * ab + GetGValue(fill) * af) / 255;
+                    cb = (GetBValue(border) * ab + GetBValue(fill) * af) / 255;
+                }
+                px[y * w + x] = ((DWORD)(a + 0.5f) << 24) | (cr << 16) | (cg << 8) | cb;
+            }
+        GdiAlphaBlend( hdc, r->left, r->top, w, h, mem, 0, 0, w, h, blend );
+        SelectObject( mem, old );
+        DeleteObject( bmp );
+    }
+    DeleteDC( mem );
+}
