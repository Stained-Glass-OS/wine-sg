+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Stained Glass OS (wine-sg 6518): wmvcore's writer encodes a stream through a wg_transform from
+ * the input's uncompressed format to the profile stream's codec (WMA through avenc_wmav2, WMV
+ * through avenc_wmv1/wmv2: GStreamer's libav plugin). These calls are its interface; the
+ * encoder's actual output type (with the codec data a decoder needs) is what goes into the
+ * file's stream properties.
+ */
+
+#include "gst_private.h"
+
+#include "mfapi.h"
+#include "mferror.h"
+#include "mfobjects.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mfplat);
+
+struct wm_encoder
+{
+    wg_transform_t transform;
+    struct wg_sample_queue *queue;
+    DWORD max_output;
+};
+
+HRESULT WINAPI winegstreamer_wm_encoder_create(const AM_MEDIA_TYPE *input, const AM_MEDIA_TYPE *output, void **out)
+{
+    struct wg_transform_attrs attrs = { .input_queue_length = 15 };
+    struct wm_encoder *encoder;
+    HRESULT hr;
+
+    TRACE("input %p, output %p, out %p.\n", input, output, out);
+
+    *out = NULL;
+    if (!init_gstreamer()) return E_FAIL;
+    if (!(encoder = calloc(1, sizeof(*encoder)))) return E_OUTOFMEMORY;
+    if (FAILED(hr = wg_sample_queue_create(&encoder->queue)))
+    {
+        free(encoder);
+        return hr;
+    }
+    if (FAILED(hr = wg_transform_create_quartz(input, output, &attrs, &encoder->transform)) || !encoder->transform)
+    {
+        WARN("no encoder from %s to %s: %#lx\n", debugstr_guid(&input->subtype), debugstr_guid(&output->subtype), hr);
+        wg_sample_queue_destroy(encoder->queue);
+        free(encoder);
+        return FAILED(hr) ? hr : MF_E_TOPO_CODEC_NOT_FOUND;
+    }
+    /* compressed output is never larger than the input much: room for a few uncompressed frames */
+    encoder->max_output = max(1024 * 1024, input->lSampleSize * 2);
+    *out = encoder;
+    return S_OK;
+}
+
+/* the encoder's output type, as a CoTaskMem AM_MEDIA_TYPE (FreeMediaType + CoTaskMemFree) */
+HRESULT WINAPI winegstreamer_wm_encoder_get_output(void *handle, const GUID *format, AM_MEDIA_TYPE **out)
+{
+    struct wm_encoder *encoder = handle;
+    IMFMediaType *type;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = wg_transform_get_output_type(encoder->transform, &type))) return hr;
+    hr = MFCreateAMMediaTypeFromMFMediaType(type, *format, out);
+    IMFMediaType_Release(type);
+    return hr;
+}
+
+HRESULT WINAPI winegstreamer_wm_encoder_push(void *handle, const BYTE *data, DWORD size, LONGLONG time, LONGLONG duration)
+{
+    struct wm_encoder *encoder = handle;
+    IMFMediaBuffer *buffer;
+    IMFSample *sample;
+    BYTE *dst;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMemoryBuffer(size, &buffer))) return hr;
+    if (SUCCEEDED(hr = IMFMediaBuffer_Lock(buffer, &dst, NULL, NULL)))
+    {
+        memcpy(dst, data, size);
+        IMFMediaBuffer_Unlock(buffer);
+        IMFMediaBuffer_SetCurrentLength(buffer, size);
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = MFCreateSample(&sample)))
+    {
+        IMFSample_AddBuffer(sample, buffer);
+        IMFSample_SetSampleTime(sample, time);
+        IMFSample_SetSampleDuration(sample, duration);
+        hr = wg_transform_push_mf(encoder->transform, sample, encoder->queue);
+        IMFSample_Release(sample);
+    }
+    IMFMediaBuffer_Release(buffer);
+    return hr;
+}
+
+/* one encoded sample (CoTaskMem *data), or S_FALSE when the encoder needs more input */
+HRESULT WINAPI winegstreamer_wm_encoder_pull(void *handle, BYTE **data, DWORD *size, LONGLONG *time, LONGLONG *duration,
+                                             BOOL *sync)
+{
+    struct wm_encoder *encoder = handle;
+    IMFMediaBuffer *buffer;
+    IMFSample *sample;
+    DWORD flags = 0, length;
+    UINT32 clean = 0;
+    BYTE *src;
+    HRESULT hr;
+    int tries;
+
+    *data = NULL;
+    *size = 0;
+    if (FAILED(hr = MFCreateMemoryBuffer(encoder->max_output, &buffer))) return hr;
+    if (FAILED(hr = MFCreateSample(&sample)))
+    {
+        IMFMediaBuffer_Release(buffer);
+        return hr;
+    }
+    IMFSample_AddBuffer(sample, buffer);
+
+    for (tries = 0; tries < 3; tries++)
+    {
+        hr = wg_transform_read_mf(encoder->transform, sample, encoder->max_output, &flags);
+        if (hr != MF_E_TRANSFORM_STREAM_CHANGE) break;
+    }
+    if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT) hr = S_FALSE;
+    else if (SUCCEEDED(hr))
+    {
+        wg_sample_queue_flush(encoder->queue, false);
+        IMFSample_GetSampleTime(sample, time);
+        if (FAILED(IMFSample_GetSampleDuration(sample, duration))) *duration = 0;
+        IMFSample_GetUINT32(sample, &MFSampleExtension_CleanPoint, &clean);
+        *sync = !!clean;
+        if (SUCCEEDED(hr = IMFMediaBuffer_Lock(buffer, &src, NULL, &length)))
+        {
+            if ((*data = CoTaskMemAlloc(max(length, 1))))
+            {
+                memcpy(*data, src, length);
+                *size = length;
+            }
+            else hr = E_OUTOFMEMORY;
+            IMFMediaBuffer_Unlock(buffer);
+        }
+    }
+    IMFSample_Release(sample);
+    IMFMediaBuffer_Release(buffer);
+    return hr;
+}
+
+HRESULT WINAPI winegstreamer_wm_encoder_drain(void *handle)
+{
+    struct wm_encoder *encoder = handle;
+    return wg_transform_drain(encoder->transform);
+}
+
+void WINAPI winegstreamer_wm_encoder_destroy(void *handle)
+{
+    struct wm_encoder *encoder = handle;
+
+    if (!encoder) return;
+    wg_transform_destroy(encoder->transform);
+    wg_sample_queue_destroy(encoder->queue);
+    free(encoder);
+}
