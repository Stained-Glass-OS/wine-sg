+/* the encoders' formats into the file's stream properties */
+static void writer_set_encoded_formats(WMWriter *writer)
+{
+    DWORD i;
+
+    for (i = 0; i < writer->input_count; i++)
+    {
+        struct writer_input *input = &writer->inputs[i];
+        WM_MEDIA_TYPE *actual;
+
+        if (!input->encoder) continue;
+        if (SUCCEEDED(winegstreamer_wm_encoder_get_output(input->encoder, &input->stream_mt->formattype, (void **)&actual)))
+        {
+            TRACE("stream %u: %s, %lu format bytes\n", input->stream_number, debugstr_guid(&actual->subtype), actual->cbFormat);
+            asf_mux_set_format(writer->mux, input->stream_number, actual);
+            CoTaskMemFree(actual->pbFormat);
+            if (actual->pUnk) IUnknown_Release(actual->pUnk);
+            CoTaskMemFree(actual);
+        }
+    }
+    writer->formats_ready = TRUE;
+}
+
+static HRESULT writer_flush_pending(WMWriter *writer)
+{
+    struct pending_sample *sample, *next;
+    HRESULT hr = S_OK;
+
+    LIST_FOR_EACH_ENTRY_SAFE(sample, next, &writer->pending, struct pending_sample, entry)
+    {
+        if (SUCCEEDED(hr))
+            hr = asf_mux_write(writer->mux, sample->stream, sample->time, sample->duration, sample->clean_point,
+                               sample->data, sample->size);
+        list_remove(&sample->entry);
+        free(sample);
+    }
+    return hr;
+}
+
+/* a sample into the file, once the encoders have told their formats (the header goes first) */
+static HRESULT writer_mux_write(WMWriter *writer, WORD stream, UINT64 time, UINT64 duration, BOOL clean_point,
+                                const BYTE *data, DWORD size)
+{
+    struct pending_sample *sample;
+    DWORD i;
+
+    if (!writer->formats_ready)
+    {
+        BOOL ready = TRUE;
+
+        for (i = 0; i < writer->input_count; i++)
+            if (writer->inputs[i].encoder && !writer->inputs[i].have_offset) ready = FALSE;
+        if (!ready)
+        {
+            if (!(sample = malloc(offsetof(struct pending_sample, data[size]))))
+                return E_OUTOFMEMORY;
+            sample->stream = stream;
+            sample->time = time;
+            sample->duration = duration;
+            sample->clean_point = clean_point;
+            sample->size = size;
+            memcpy(sample->data, data, size);
+            list_add_tail(&writer->pending, &sample->entry);
+            return S_OK;
+        }
+#ifndef SG_MUTANT_WMVW_EARLY_FORMAT
+        writer_set_encoded_formats(writer);
+#else
+        writer->formats_ready = TRUE;
+#endif
+    }
+    if (!list_empty(&writer->pending))
+    {
+        HRESULT hr = writer_flush_pending(writer);
+        if (FAILED(hr)) return hr;
+    }
+    return asf_mux_write(writer->mux, stream, time, duration, clean_point, data, size);
+}
+
+static void writer_stop_encoders(WMWriter *writer)
+{
+    DWORD i;
+
+    for (i = 0; i < writer->input_count; i++)
+    {
+        winegstreamer_wm_encoder_destroy(writer->inputs[i].encoder);
+        writer->inputs[i].encoder = NULL;
+        writer->inputs[i].have_first_input = writer->inputs[i].have_offset = FALSE;
+    }
+}
+
+/* what an encoder has ready, into the file */
+static HRESULT writer_pull_encoded(WMWriter *writer, struct writer_input *input)
+{
+    LONGLONG time, duration;
+    BOOL sync;
+    DWORD size;
+    BYTE *data;
+    HRESULT hr;
+
+    for (;;)
+    {
+        if (FAILED(hr = winegstreamer_wm_encoder_pull(input->encoder, &data, &size, &time, &duration, &sync)))
+            return hr;
+        if (hr == S_FALSE)
+            return S_OK;
+        TRACE("stream %u: %lu bytes at %s, duration %s, sync %d\n", input->stream_number, size,
+              wine_dbgstr_longlong(time), wine_dbgstr_longlong(duration), sync);
+        /* the first output is at the first input's time */
+        if (!input->have_offset)
+        {
+            input->offset = time - input->first_input;
+            input->have_offset = TRUE;
+        }
+#ifndef SG_MUTANT_WMVW_ENCODER_TIME
+        time -= input->offset;
+        if (time < 0) time = 0;
+#endif
+        hr = writer_mux_write(writer, input->stream_number, time, duration,
+                              !IsEqualGUID(&input->type, &media_type_video) || sync, data, size);
+        CoTaskMemFree(data);
+        if (FAILED(hr))
+            return hr;
+    }
+}
