diff --git a/dlls/winegstreamer/wg_transform.c b/dlls/winegstreamer/wg_transform.c
index 558f657..4280d73 100644
--- a/dlls/winegstreamer/wg_transform.c
+++ b/dlls/winegstreamer/wg_transform.c
@@ -64,6 +64,7 @@ struct wg_transform
     GstCaps *input_caps;
 
     bool draining;
+    guint encoder_bitrate;   /* wine-sg 6518: the bit rate an encoder is asked for */
 };
 
 static struct wg_transform *get_transform(wg_transform_t trans)
@@ -559,8 +560,55 @@ static bool transform_create_encoder_element(struct wg_transform *transform,
     if (!strcmp(output_mime, "audio/x-raw") || !strcmp(output_mime, "video/x-raw"))
         return true;
 
-    return (element = find_element(GST_ELEMENT_FACTORY_TYPE_ENCODER, NULL, transform->output_caps))
-            && append_element(transform->container, element, first, last);
+    if (!(element = find_element(GST_ELEMENT_FACTORY_TYPE_ENCODER, NULL, transform->output_caps)))
+        return false;
+    /* Stained Glass OS (wine-sg 6518): the bit rate the output type asks for (libav encoders
+     * take it in bits per second) */
+    if (transform->encoder_bitrate && g_object_class_find_property(G_OBJECT_GET_CLASS(element), "bitrate"))
+    {
+        GParamSpec *spec = g_object_class_find_property(G_OBJECT_GET_CLASS(element), "bitrate");
+        if (G_PARAM_SPEC_VALUE_TYPE(spec) == G_TYPE_INT64)
+            g_object_set(element, "bitrate", (gint64)transform->encoder_bitrate, NULL);
+        else if (G_PARAM_SPEC_VALUE_TYPE(spec) == G_TYPE_INT)
+            g_object_set(element, "bitrate", (gint)transform->encoder_bitrate, NULL);
+        else if (G_PARAM_SPEC_VALUE_TYPE(spec) == G_TYPE_UINT)
+            g_object_set(element, "bitrate", (guint)transform->encoder_bitrate, NULL);
+        GST_INFO("transform %p encoder bitrate %u", transform, transform->encoder_bitrate);
+    }
+    return append_element(transform->container, element, first, last);
+}
+
+/* Stained Glass OS (wine-sg 6518): raw input to a compressed output is an encoder. The fields an
+ * encoder decides itself (its codec data, block alignment, sample depth, the WMV FourCC string)
+ * are left out of the output caps, or no encoder's caps would match them. */
+static void transform_prepare_encoder_caps(struct wg_transform *transform, const struct wg_media_type *output)
+{
+    GstStructure *structure = gst_caps_get_structure(transform->output_caps, 0);
+    const gchar *input_mime = gst_structure_get_name(gst_caps_get_structure(transform->input_caps, 0));
+    const gchar *output_mime = gst_structure_get_name(structure);
+    GstCaps *caps;
+    gint bitrate;
+
+    if (strcmp(input_mime, "audio/x-raw") && strcmp(input_mime, "video/x-raw"))
+        return;
+    if (!strcmp(output_mime, "audio/x-raw") || !strcmp(output_mime, "video/x-raw"))
+        return;
+
+    if (gst_structure_get_int(structure, "bitrate", &bitrate) && bitrate > 0)
+        transform->encoder_bitrate = bitrate;
+    else if (IsEqualGUID(&output->major, &MFMediaType_Video) && output->format_size >= sizeof(MFVIDEOFORMAT))
+        transform->encoder_bitrate = output->u.video->compressedInfo.AvgBitrate;
+    else if (IsEqualGUID(&output->major, &MFMediaType_Audio) && output->format_size >= sizeof(WAVEFORMATEX))
+        transform->encoder_bitrate = output->u.audio->nAvgBytesPerSec * 8;
+
+    caps = gst_caps_copy(transform->output_caps);
+    structure = gst_caps_get_structure(caps, 0);
+    gst_structure_remove_fields(structure, "codec_data", "block_align", "depth", "bitrate", "streamheader", NULL);
+    if (!strcmp(output_mime, "video/x-wmv"))
+        gst_structure_remove_field(structure, "format");
+    gst_caps_unref(transform->output_caps);
+    transform->output_caps = caps;
+    GST_INFO("transform %p encoder output caps %"GST_PTR_FORMAT, transform, caps);
 }
 
 NTSTATUS wg_transform_create(void *args)
@@ -595,6 +643,9 @@ NTSTATUS wg_transform_create(void *args)
     if (!(transform->output_caps = caps_from_media_type(&params->output_type)))
         goto out;
     GST_INFO("transform %p output caps %"GST_PTR_FORMAT, transform, transform->output_caps);
+#ifndef SG_MUTANT_WG_ENCODER_CAPS_KEPT
+    transform_prepare_encoder_caps(transform, &params->output_type);
+#endif
     output_mime = gst_structure_get_name(gst_caps_get_structure(transform->output_caps, 0));
 
     if (IsEqualGUID(&params->input_type.major, &MFMediaType_Video))
