From: Stained Glass OS <ke7oxh@gmail.com>
Subject: services: a service's own environment variables

Windows adds a service key's Environment value (REG_MULTI_SZ of
"NAME=value") to the environment it starts that service with: how a
service is given a proxy, a JAVA_HOME or a debug switch without changing
the whole machine's. Wine's services.exe gave every service the same
block and ignored the value.

service_start_process now builds a copy of the common block with the
service's own variables on top, starts the service with it and frees it.
A value may itself contain '='.

Gate: make test-svcenv (64- and 32-bit services; a service without the
value sees none of another's; mutant SG_MUTANT_SERVICE_ENV_IGNORED).
--- a/programs/services/services.c
+++ b/programs/services/services.c
@@ -1194,6 +1194,52 @@
     return ERROR_NOT_ENOUGH_SERVER_MEMORY;
 }
 
+/* Stained Glass OS: the service's own variables, as Windows sets them -- its
+ * key's Environment value (REG_MULTI_SZ of "NAME=value") on top of the
+ * environment every service gets. NULL when it has none. */
+static WCHAR *service_environment(struct service_entry *service_entry, void *base)
+{
+    WCHAR *vars, *p, *eq, *env = NULL;
+    const WCHAR *q;
+    DWORD size = 0;
+    UNICODE_STRING name, value;
+
+#ifdef SG_MUTANT_SERVICE_ENV_IGNORED
+    return NULL;
+#endif
+    if (RegGetValueW(service_entry->db->root_key, service_entry->name, L"Environment", RRF_RT_REG_MULTI_SZ,
+                     NULL, NULL, &size) || size <= 2 * sizeof(WCHAR))
+        return NULL;
+    if (!(vars = malloc(size))) return NULL;
+    if (RegGetValueW(service_entry->db->root_key, service_entry->name, L"Environment", RRF_RT_REG_MULTI_SZ,
+                     NULL, vars, &size) || RtlCreateEnvironment(FALSE, &env))
+    {
+        free(vars);
+        return NULL;
+    }
+    /* a copy of the common block, then the service's own */
+    for (q = base; q && *q; q += wcslen(q) + 1)
+    {
+        if (!(eq = wcschr(q + 1, '='))) continue;   /* "=C:=C:\" names start with '=' */
+        name.Buffer = (WCHAR *)q;
+        name.Length = name.MaximumLength = (eq - q) * sizeof(WCHAR);
+        RtlInitUnicodeString(&value, eq + 1);
+        RtlSetEnvironmentVariable(&env, &name, &value);
+    }
+    for (p = vars; *p; p += wcslen(p) + 1)
+    {
+        if (!(eq = wcschr(p + 1, '='))) continue;
+        *eq = 0;
+        RtlInitUnicodeString(&name, p);
+        RtlInitUnicodeString(&value, eq + 1);
+        WINE_TRACE("%s: %s=%s\n", wine_dbgstr_w(service_entry->name), wine_dbgstr_w(p), wine_dbgstr_w(eq + 1));
+        RtlSetEnvironmentVariable(&env, &name, &value);
+        *eq = '=';
+    }
+    free(vars);
+    return env;
+}
+
 static DWORD service_start_process(struct service_entry *service_entry, struct process_entry **new_process,
                                    BOOL *shared_process)
 {
@@ -1202,7 +1248,7 @@
     STARTUPINFOW si;
     BOOL is_wow64 = FALSE;
     HANDLE token;
-    WCHAR *path;
+    WCHAR *path, *own_env;
     DWORD err;
     BOOL r;
 
@@ -1338,7 +1384,10 @@
     process->use_count++;
     service_unlock(service_entry);
 
-    r = CreateProcessW(NULL, path, NULL, NULL, FALSE, CREATE_UNICODE_ENVIRONMENT | DETACHED_PROCESS, environment, NULL, &si, &pi);
+    own_env = service_environment(service_entry, environment);
+    r = CreateProcessW(NULL, path, NULL, NULL, FALSE, CREATE_UNICODE_ENVIRONMENT | DETACHED_PROCESS,
+                       own_env ? own_env : environment, NULL, &si, &pi);
+    if (own_env) RtlDestroyEnvironment(own_env);
     free(path);
     if (!r)
     {
