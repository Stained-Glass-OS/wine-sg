From: Stained Glass OS <dev@stained-glass.example>
Subject: light.msstyles: the theme's own accent colours are purple too

Patch 0031 recoloured Light's images to the project's purple, but the
theme INI names colours of its own, and those stayed Windows-10 blue: the
progress bar, the Highlight and MenuHilight system colours the theme
applies, a command link's hot text, the combo box's highlighted item, task
dialog main instructions and balloon titles. They take the same purple as
the images (48 150 250 -> 123 47 190, 41 121 255 -> 95 36 150).
---
--- a/dlls/light.msstyles/light.rc
+++ b/dlls/light.msstyles/light.rc
@@ -109,7 +109,7 @@
 "ActiveBorder = 255 255 255\r\n"
 "InactiveBorder = 255 255 255\r\n"
 "AppWorkSpace = 128 128 128\r\n"
-"Highlight = 48 150 250\r\n"
+"Highlight = 123 47 190\r\n"
 "HighlightText = 255 255 255\r\n"
 "BtnFace = 245 245 245\r\n"
 "BtnShadow = 166 166 166\r\n"
@@ -125,7 +125,7 @@
 "HotTracking = 224 224 224\r\n"
 "GradientActiveCaption = 50 150 250\r\n"
 "GradientInactiveCaption = 128 128 128\r\n"
-"MenuHilight = 48 150 250\r\n"
+"MenuHilight = 123 47 190\r\n"
 "MenuBar = 255 255 255\r\n"
 
 "\r\n; Nonclient metrics\r\n"
@@ -303,10 +303,10 @@
 "100, 100, 100, 100, 100, 0\r\n"
 
 "[Button.Commandlink(Hot)]\r\n"
-"TextColor = 48 150 250\r\n"
+"TextColor = 123 47 190\r\n"
 
 "[Button.Commandlink(Pressed)]\r\n"
-"TextColor = 41 121 255\r\n"
+"TextColor = 95 36 150\r\n"
 
 "[Button.Commandlink(Disabled)]\r\n"
 "TextColor = 174 174 174\r\n"
@@ -501,7 +501,7 @@
 "TextColor = 0 0 0\r\n"
 
 "[ComboBox.DropDownItem(HighLighted)]\r\n"
-"FillColor = 48 150 250\r\n"
+"FillColor = 123 47 190\r\n"
 "TextColor = 255 255 255\r\n"
 
 "\r\n; Edit\r\n"
@@ -1406,7 +1406,7 @@
 "ProgressSpaceSize = 0\r\n"
 "BgType = BorderFill\r\n"
 "FillType = Solid\r\n"
-"FillColor = 48 150 250\r\n"
+"FillColor = 123 47 190\r\n"
 "BorderSize = 1\r\n"
 "BorderColor = 174 174 174\r\n"
 
@@ -1419,19 +1419,19 @@
 
 "[Progress.Chunk]\r\n"
 "BorderSize = 0\r\n"
-"FillColor = 48 150 250\r\n"
+"FillColor = 123 47 190\r\n"
 
 "[Progress.ChunkVert]\r\n"
 "BorderSize = 0\r\n"
-"FillColor = 48 150 250\r\n"
+"FillColor = 123 47 190\r\n"
 
 "[Progress.Fill]\r\n"
 "BorderSize = 0\r\n"
-"FillColor = 48 150 250\r\n"
+"FillColor = 123 47 190\r\n"
 
 "[Progress.FillVert]\r\n"
 "BorderSize = 0\r\n"
-"FillColor = 48 150 250\r\n"
+"FillColor = 123 47 190\r\n"
 
 "[Progress.Fill(Error)]\r\n"
 "BorderSize = 0\r\n"
@@ -2006,7 +2006,7 @@
 "ContentMargins = 10, 10, 10, 10\r\n"
 
 "[TaskDialog.MainInstructionPane]\r\n"
-"TextColor = 41 121 255\r\n"
+"TextColor = 95 36 150\r\n"
 "ContentMargins = 0, 0, 0, 0\r\n"
 "Font = Tahoma, -16\r\n"
 
@@ -2581,7 +2581,7 @@
 "ImageFile = blue_tooltip_ballon.bmp\r\n"
 
 "[Tooltip.BallonTitle]\r\n"
-"TextColor = 41 121 255\r\n"
+"TextColor = 95 36 150\r\n"
 "Font = Tahoma, -16\r\n"
 
 "[Tooltip.Close]\r\n"
