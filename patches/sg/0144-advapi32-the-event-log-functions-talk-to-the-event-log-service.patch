+/*
+ * The event log functions are the client of the Event Log service
+ * (wevtsvc.dll), which owns the logs and decides what each caller may do;
+ * see include/wine/eventlog.h for the protocol.  A handle is ours: which log,
+ * the source name, and where a sequential read has got to.  A backup log is
+ * read into memory by OpenBackupEventLog and served from there.
+ */
+
 #include <stdarg.h>
+#include <stdlib.h>
 
 #include "windef.h"
 #include "winbase.h"
 #include "winerror.h"
 #include "winternl.h"
+#include "winsvc.h"
 #include "wmistr.h"
 #define _WMI_SOURCE_
 #include "evntrace.h"
 #include "evntprov.h"
 
+#include "wine/eventlog.h"
 #include "wine/debug.h"
 
 #include "advapi32_misc.h"
@@ -38,6 +50,547 @@
 WINE_DEFAULT_DEBUG_CHANNEL(advapi);
 WINE_DECLARE_DEBUG_CHANNEL(eventlog);
 
+#define REQUEST_TIMEOUT 15000
+#define CONNECT_TIMEOUT 3000
+
+struct notify
+{
+    WCHAR log[WINE_EVENTLOG_NAME_LEN];
+    HANDLE event;
+    LONG stop;
+};
+
+struct evlog
+{
+    WCHAR log[WINE_EVENTLOG_NAME_LEN];
+    WCHAR source[WINE_EVENTLOG_NAME_LEN];
+    DWORD pos;              /* between records: the next forwards read is pos, backwards pos-1 */
+    BOOL backup;            /* a backup file, read into memory */
+    BYTE *image;            /* ...its records */
+    DWORD image_size;
+    DWORD *offs;
+    DWORD count, first, next;
+    struct notify *notify;
+};
+
+static CRITICAL_SECTION evlog_cs;
+static CRITICAL_SECTION_DEBUG evlog_cs_debug =
+{
+    0, 0, &evlog_cs,
+    { &evlog_cs_debug.ProcessLocksList, &evlog_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": evlog_cs") }
+};
+static CRITICAL_SECTION evlog_cs = { &evlog_cs_debug, -1, 0, 0, 0, 0 };
+static struct evlog **evlogs;
+static DWORD evlogs_size;
+
+#define HANDLE_BASE 0x45760000
+
+static HANDLE alloc_handle( struct evlog *log )
+{
+    DWORD i;
+    HANDLE ret = NULL;
+
+    EnterCriticalSection( &evlog_cs );
+    for (i = 0; i < evlogs_size; i++) if (!evlogs[i]) break;
+    if (i == evlogs_size)
+    {
+        DWORD size = max( 16, evlogs_size * 2 );
+        struct evlog **new = realloc( evlogs, size * sizeof(*new) );
+        if (new)
+        {
+            memset( new + evlogs_size, 0, (size - evlogs_size) * sizeof(*new) );
+            evlogs = new;
+            evlogs_size = size;
+        }
+    }
+    if (i < evlogs_size && i < 0xffff)
+    {
+        evlogs[i] = log;
+        ret = (HANDLE)(ULONG_PTR)(HANDLE_BASE + (i + 1) * 4);
+    }
+    LeaveCriticalSection( &evlog_cs );
+    if (!ret) SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+    return ret;
+}
+
+/* The handle's state, or NULL (and ERROR_INVALID_HANDLE).  Handles belong to
+ * one thread at a time, as RPC context handles do on Windows. */
+static struct evlog *get_evlog( HANDLE handle )
+{
+    ULONG_PTR h = (ULONG_PTR)handle, i;
+    struct evlog *log = NULL;
+
+    if (h > HANDLE_BASE && !(h % 4) && (i = (h - HANDLE_BASE) / 4 - 1) < 0x10000)
+    {
+        EnterCriticalSection( &evlog_cs );
+        if (i < evlogs_size) log = evlogs[i];
+        LeaveCriticalSection( &evlog_cs );
+    }
+    if (!log) SetLastError( ERROR_INVALID_HANDLE );
+    return log;
+}
+
+static struct evlog *take_evlog( HANDLE handle )
+{
+    ULONG_PTR h = (ULONG_PTR)handle, i;
+    struct evlog *log = NULL;
+
+    if (h > HANDLE_BASE && !(h % 4) && (i = (h - HANDLE_BASE) / 4 - 1) < 0x10000)
+    {
+        EnterCriticalSection( &evlog_cs );
+        if (i < evlogs_size && (log = evlogs[i])) evlogs[i] = NULL;
+        LeaveCriticalSection( &evlog_cs );
+    }
+    if (!log) SetLastError( ERROR_INVALID_HANDLE );
+    return log;
+}
+
+static void free_evlog( struct evlog *log )
+{
+    if (log->notify) InterlockedExchange( &log->notify->stop, 1 );  /* its thread frees it */
+    free( log->image );
+    free( log->offs );
+    free( log );
+}
+
+/* ---- talking to the service -------------------------------------------- */
+
+static LONG service_absent_until;
+
+static void start_service(void)
+{
+    static LONG tried;
+    SC_HANDLE scm, svc;
+
+    if (InterlockedExchange( &tried, 1 )) return;
+    if (!(scm = OpenSCManagerW( NULL, NULL, SC_MANAGER_CONNECT ))) return;
+    if ((svc = OpenServiceW( scm, L"EventLog", SERVICE_START )))
+    {
+        if (!StartServiceW( svc, 0, NULL )) TRACE_(eventlog)( "cannot start EventLog: %lu\n", GetLastError() );
+        CloseServiceHandle( svc );
+    }
+    CloseServiceHandle( scm );
+}
+
+static HANDLE connect_service(void)
+{
+    DWORD start = GetTickCount(), mode = PIPE_READMODE_MESSAGE;
+    HANDLE pipe;
+
+    if ((LONG)(service_absent_until - GetTickCount()) > 0) return INVALID_HANDLE_VALUE;
+    for (;;)
+    {
+        pipe = CreateFileW( WINE_EVENTLOG_PIPE, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING,
+                            FILE_FLAG_OVERLAPPED, NULL );
+        if (pipe != INVALID_HANDLE_VALUE) break;
+        if (GetTickCount() - start > CONNECT_TIMEOUT)
+        {
+            WARN_(eventlog)( "the Event Log service is not answering\n" );
+            service_absent_until = GetTickCount() + 30000;
+            return INVALID_HANDLE_VALUE;
+        }
+        if (GetLastError() == ERROR_PIPE_BUSY) WaitNamedPipeW( WINE_EVENTLOG_PIPE, 500 );
+        else
+        {
+            start_service();
+            Sleep( 50 );
+        }
+    }
+    SetNamedPipeHandleState( pipe, &mode, NULL, NULL );
+    return pipe;
+}
+
+static BOOL wait_io( HANDLE pipe, OVERLAPPED *ov, DWORD *got, DWORD timeout )
+{
+    DWORD err = GetLastError();
+    if (err == ERROR_MORE_DATA) return TRUE;
+    if (err != ERROR_IO_PENDING) return FALSE;
+    if (WaitForSingleObject( ov->hEvent, timeout ))
+    {
+        CancelIo( pipe );
+        GetOverlappedResult( pipe, ov, got, TRUE );
+        return FALSE;
+    }
+    return GetOverlappedResult( pipe, ov, got, FALSE ) || GetLastError() == ERROR_MORE_DATA;
+}
+
+/* One request; the reply (to free) or NULL.  The status of a reply the
+ * service gave is the caller's to look at; NULL means no service. */
+static struct wine_eventlog_reply *transact( struct wine_eventlog_request *req, DWORD timeout )
+{
+    struct wine_eventlog_reply *reply = NULL;
+    OVERLAPPED ov = {0};
+    DWORD got, total = 0, cap = 4096;
+    HANDLE pipe;
+    BOOL ok;
+
+    req->magic = WINE_EVENTLOG_MAGIC;
+    if ((pipe = connect_service()) == INVALID_HANDLE_VALUE) return NULL;
+    if (!(ov.hEvent = CreateEventW( NULL, TRUE, FALSE, NULL ))) goto done;
+
+    if (!WriteFile( pipe, req, req->size, &got, &ov ) && !wait_io( pipe, &ov, &got, timeout )) goto done;
+    if (!(reply = malloc( cap ))) goto done;
+    for (;;)
+    {
+        ResetEvent( ov.hEvent );
+        ok = ReadFile( pipe, (BYTE *)reply + total, cap - total, &got, &ov );
+        if (!ok && !wait_io( pipe, &ov, &got, timeout )) break;
+        total += got;
+        if (ok || GetLastError() != ERROR_MORE_DATA)
+        {
+            ok = TRUE;
+            break;
+        }
+        if (cap >= 0x40000000) break;
+        {
+            void *new = realloc( reply, cap * 2 );
+            if (!new) break;
+            reply = new;
+            cap *= 2;
+        }
+    }
+    if (!ok || total < sizeof(*reply) || reply->magic != WINE_EVENTLOG_MAGIC || reply->size != total)
+    {
+        free( reply );
+        reply = NULL;
+    }
+done:
+    if (ov.hEvent) CloseHandle( ov.hEvent );
+    CloseHandle( pipe );
+    return reply;
+}
+
+/* A request with no payload, for a log; the status, and the reply if wanted. */
+static DWORD simple_request( DWORD op, const WCHAR *log, struct wine_eventlog_reply **out )
+{
+    struct wine_eventlog_request req = {0};
+    struct wine_eventlog_reply *reply;
+    DWORD status;
+
+    req.op = op;
+    req.size = sizeof(req);
+    lstrcpynW( req.log, log, ARRAY_SIZE(req.log) );
+    if (!(reply = transact( &req, REQUEST_TIMEOUT ))) return RPC_S_SERVER_UNAVAILABLE;
+    status = reply->status;
+    if (out && !status) *out = reply;
+    else free( reply );
+    return status;
+}
+
+static BOOL set_error( DWORD err )
+{
+    if (err) SetLastError( err );
+    return !err;
+}
+
+/* An empty server name, or this computer's own, is the local machine. */
+static BOOL is_local( const WCHAR *server )
+{
+    WCHAR name[256];
+    DWORD len;
+
+    if (!server || !server[0]) return TRUE;
+    while (*server == '\\') server++;
+    len = ARRAY_SIZE(name);
+    if (GetComputerNameW( name, &len ) && !wcsicmp( name, server )) return TRUE;
+    len = ARRAY_SIZE(name);
+    if (GetComputerNameExW( ComputerNameDnsFullyQualified, name, &len ) && !wcsicmp( name, server )) return TRUE;
+    return !wcsicmp( server, L"localhost" ) || !wcscmp( server, L"." );
+}
+
+static HANDLE open_log( const WCHAR *server, const WCHAR *name, DWORD access )
+{
+    struct wine_eventlog_request req = {0};
+    struct wine_eventlog_reply *reply;
+    struct evlog *log;
+    HANDLE ret;
+
+    if (!is_local( server ))
+    {
+        FIXME( "remote server %s not supported\n", debugstr_w(server) );
+        SetLastError( RPC_S_SERVER_UNAVAILABLE );
+        return NULL;
+    }
+    req.op = WINE_EVENTLOG_OPEN;
+    req.size = sizeof(req);
+    req.access = access;
+    lstrcpynW( req.log, name, ARRAY_SIZE(req.log) );
+    if (!(reply = transact( &req, REQUEST_TIMEOUT )))
+    {
+        SetLastError( RPC_S_SERVER_UNAVAILABLE );
+        return NULL;
+    }
+    if (reply->status)
+    {
+        SetLastError( reply->status );
+        free( reply );
+        return NULL;
+    }
+    if (!(log = calloc( 1, sizeof(*log) )))
+    {
+        free( reply );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    reply->log[ARRAY_SIZE(reply->log) - 1] = 0;
+    lstrcpyW( log->log, reply->log );
+    lstrcpynW( log->source, name, ARRAY_SIZE(log->source) );
+    free( reply );
+    if (!(ret = alloc_handle( log ))) free_evlog( log );
+    TRACE_(eventlog)( "%s -> %s: %p\n", debugstr_w(name), debugstr_w(log->log), ret );
+    return ret;
+}
+
+/* ---- log images (backups) ---------------------------------------------- */
+
+static BOOL valid_record( const BYTE *p, DWORD left )
+{
+    const EVENTLOGRECORD *rec = (const EVENTLOGRECORD *)p;
+    if (left < sizeof(*rec) + sizeof(DWORD)) return FALSE;
+    if (rec->Length < sizeof(*rec) + sizeof(DWORD) || rec->Length > left || rec->Length % 4) return FALSE;
+    if (rec->Reserved != 0x654c664c) return FALSE;
+    if (rec->StringOffset > rec->Length || rec->UserSidOffset > rec->Length ||
+        rec->UserSidLength > rec->Length - rec->UserSidOffset ||
+        rec->DataOffset > rec->Length || rec->DataLength > rec->Length - rec->DataOffset)
+        return FALSE;
+    return *(const DWORD *)(p + rec->Length - sizeof(DWORD)) == rec->Length;
+}
+
+/* Index a file image (header + records); FALSE if it is not one. */
+static BOOL index_image( struct evlog *log, BYTE *image, DWORD size )
+{
+    const struct wine_eventlog_file_header *hdr = (const void *)image;
+    DWORD off = sizeof(*hdr), cap = 0;
+
+    if (size < sizeof(*hdr) || memcmp( hdr->magic, WINE_EVENTLOG_FILE_MAGIC, sizeof(hdr->magic) ) ||
+        hdr->version != WINE_EVENTLOG_FILE_VERSION)
+        return FALSE;
+    log->count = 0;
+    while (off < size)
+    {
+        const EVENTLOGRECORD *rec = (const EVENTLOGRECORD *)(image + off);
+        if (!valid_record( image + off, size - off )) return FALSE;
+        if (log->count && rec->RecordNumber != log->first + log->count) return FALSE;
+        if (!log->count) log->first = rec->RecordNumber;
+        if (log->count == cap)
+        {
+            DWORD *offs = realloc( log->offs, (cap = max( 64, cap * 2 )) * sizeof(*offs) );
+            if (!offs) return FALSE;
+            log->offs = offs;
+        }
+        log->offs[log->count++] = off;
+        off += rec->Length;
+    }
+    if (!log->count) log->first = hdr->next_record;
+    log->next = log->first + log->count;
+    log->image = image;
+    log->image_size = size;
+    log->backup = TRUE;
+    return TRUE;
+}
+
+static const EVENTLOGRECORD *image_record( const struct evlog *log, DWORD number )
+{
+    return (const EVENTLOGRECORD *)(log->image + log->offs[number - log->first]);
+}
+
+/* The image of a log: a backup's own, or the whole log from the service. */
+static DWORD get_image( struct evlog *log, BYTE **data, DWORD *size )
+{
+    struct wine_eventlog_reply *reply;
+    DWORD status;
+
+    if (log->backup)
+    {
+        *data = log->image;
+        *size = log->image_size;
+        return ERROR_SUCCESS;
+    }
+    if ((status = simple_request( WINE_EVENTLOG_BACKUP, log->log, &reply ))) return status;
+    *size = reply->size - sizeof(*reply);
+    if (!(*data = malloc( *size )))
+    {
+        free( reply );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    memcpy( *data, reply + 1, *size );
+    free( reply );
+    return ERROR_SUCCESS;
+}
+
+static DWORD write_backup( struct evlog *log, const WCHAR *file )
+{
+    BYTE *data;
+    DWORD size, written, status;
+    HANDLE h;
+
+    if (GetFileAttributesW( file ) != INVALID_FILE_ATTRIBUTES) return ERROR_ALREADY_EXISTS;
+    if ((status = get_image( log, &data, &size ))) return status;
+    h = CreateFileW( file, GENERIC_WRITE, 0, NULL, CREATE_NEW, 0, NULL );
+    if (h == INVALID_HANDLE_VALUE)
+        status = GetLastError() == ERROR_FILE_EXISTS ? ERROR_ALREADY_EXISTS : GetLastError();
+    else
+    {
+        if (!WriteFile( h, data, size, &written, NULL ) || written != size) status = GetLastError();
+        CloseHandle( h );
+        if (status) DeleteFileW( file );
+    }
+    if (data != log->image) free( data );
+    return status;
+}
+
+/* ---- records ----------------------------------------------------------- */
+
+/* The size of a (Unicode) record in the ANSI layout, and the record itself
+ * if out is given: the same order and alignment, the strings converted. */
+static DWORD record_to_ansi( const EVENTLOGRECORD *w, BYTE *out )
+{
+    const WCHAR *source = (const WCHAR *)(w + 1);
+    const WCHAR *computer = source + wcslen( source ) + 1;
+    const WCHAR *str = (const WCHAR *)((const BYTE *)w + w->StringOffset);
+    DWORD src_len = WideCharToMultiByte( CP_ACP, 0, source, -1, NULL, 0, NULL, NULL );
+    DWORD comp_len = WideCharToMultiByte( CP_ACP, 0, computer, -1, NULL, 0, NULL, NULL );
+    DWORD sid_off = (sizeof(EVENTLOGRECORD) + src_len + comp_len + 7) & ~7;
+    DWORD str_off = sid_off + w->UserSidLength, off = str_off, total, i;
+    EVENTLOGRECORD *a = (EVENTLOGRECORD *)out;
+
+    for (i = 0; i < w->NumStrings; i++)
+    {
+        DWORD len = WideCharToMultiByte( CP_ACP, 0, str, -1, NULL, 0, NULL, NULL );
+        if (out) WideCharToMultiByte( CP_ACP, 0, str, -1, (char *)out + off, len, NULL, NULL );
+        off += len;
+        str += wcslen( str ) + 1;
+    }
+    total = ((off + w->DataLength + 3) & ~3) + sizeof(DWORD);
+    if (!out) return total;
+
+    *a = *w;
+    a->Length = total;
+    a->UserSidOffset = sid_off;
+    a->StringOffset = str_off;
+    a->DataOffset = off;
+    WideCharToMultiByte( CP_ACP, 0, source, -1, (char *)(a + 1), src_len, NULL, NULL );
+    WideCharToMultiByte( CP_ACP, 0, computer, -1, (char *)(a + 1) + src_len, comp_len, NULL, NULL );
+    memset( out + sizeof(*a) + src_len + comp_len, 0, sid_off - (sizeof(*a) + src_len + comp_len) );
+    if (w->UserSidLength) memcpy( out + sid_off, (const BYTE *)w + w->UserSidOffset, w->UserSidLength );
+    if (w->DataLength) memcpy( out + off, (const BYTE *)w + w->DataOffset, w->DataLength );
+    memset( out + off + w->DataLength, 0, total - sizeof(DWORD) - off - w->DataLength );
+    *(DWORD *)(out + total - sizeof(DWORD)) = total;
+    return total;
+}
+
+static BOOL read_log( HANDLE handle, DWORD flags, DWORD offset, void *buffer, DWORD size,
+                      DWORD *read, DWORD *needed, BOOL ansi )
+{
+    struct wine_eventlog_reply *reply = NULL;
+    const BYTE *recs;
+    struct evlog *log;
+    DWORD count, i, total = 0, last = 0, status;
+    BOOL seek = flags & EVENTLOG_SEEK_READ, backwards = flags & EVENTLOG_BACKWARDS_READ;
+
+    if (!buffer || !read || !needed) return set_error( ERROR_INVALID_PARAMETER );
+    if (!!(flags & EVENTLOG_SEQUENTIAL_READ) == !!seek ||
+        !!(flags & EVENTLOG_FORWARDS_READ) == !!backwards)
+        return set_error( ERROR_INVALID_PARAMETER );
+    if (!(log = get_evlog( handle ))) return FALSE;
+    if (seek && !offset) return set_error( ERROR_INVALID_PARAMETER );
+
+    if (log->backup)
+    {
+        DWORD start, n;
+        if ((status = wine_eventlog_start( log->first, log->next, seek ? offset : 0, log->pos, backwards, &start )))
+            return set_error( status );
+        /* the image's records from start, in the direction read, as a list */
+        for (n = start, count = 0; n >= log->first && n < log->next; n = backwards ? n - 1 : n + 1) count++;
+        if (!(reply = malloc( sizeof(*reply) + count * sizeof(DWORD) ))) return set_error( ERROR_NOT_ENOUGH_MEMORY );
+        for (i = 0, n = start; i < count; i++, n = backwards ? n - 1 : n + 1)
+            ((DWORD *)(reply + 1))[i] = n;
+    }
+    else
+    {
+        struct wine_eventlog_request req = {0};
+        req.op = WINE_EVENTLOG_READ;
+        req.size = sizeof(req);
+        lstrcpyW( req.log, log->log );
+        req.record = seek ? offset : 0;
+        req.pos = log->pos;
+        req.backwards = backwards;
+        req.budget = size;
+        if (!(reply = transact( &req, REQUEST_TIMEOUT ))) return set_error( RPC_S_SERVER_UNAVAILABLE );
+        if (reply->status)
+        {
+            status = reply->status;
+            free( reply );
+            return set_error( status );
+        }
+        count = reply->count;
+    }
+
+    /* whole records, as many as fit; the first must */
+    recs = (const BYTE *)(reply + 1);
+    for (i = 0; i < count; i++)
+    {
+        const EVENTLOGRECORD *rec = log->backup ? image_record( log, ((DWORD *)(reply + 1))[i] )
+                                                : (const EVENTLOGRECORD *)recs;
+        DWORD len = ansi ? record_to_ansi( rec, NULL ) : rec->Length;
+
+        if (total + len > size)
+        {
+            if (!i)
+            {
+                *read = 0;
+                *needed = len;
+                free( reply );
+                return set_error( ERROR_INSUFFICIENT_BUFFER );
+            }
+            break;
+        }
+        if (ansi) record_to_ansi( rec, (BYTE *)buffer + total );
+        else memcpy( (BYTE *)buffer + total, rec, len );
+        total += len;
+        last = rec->RecordNumber;
+        if (!log->backup) recs += rec->Length;
+    }
+    free( reply );
+    if (!i) return set_error( ERROR_HANDLE_EOF );
+    log->pos = backwards ? last : last + 1;
+    *read = total;
+    *needed = 0;
+    return TRUE;
+}
+
+/* ---- notification ------------------------------------------------------ */
+
+static DWORD WINAPI notify_thread( void *arg )
+{
+    struct notify *n = arg;
+    DWORD changes = ~0u;
+
+    while (!n->stop)
+    {
+        struct wine_eventlog_request req = {0};
+        struct wine_eventlog_reply *reply;
+
+        req.op = WINE_EVENTLOG_WAIT;
+        req.size = sizeof(req);
+        lstrcpyW( req.log, n->log );
+        req.pos = changes;
+        if (!(reply = transact( &req, 60000 )) || reply->status)
+        {
+            free( reply );
+            Sleep( 1000 );
+            continue;
+        }
+        if (changes != ~0u && reply->value != changes && !n->stop) SetEvent( n->event );
+        changes = reply->value;
+        free( reply );
+    }
+    CloseHandle( n->event );
+    free( n );
+    return 0;
+}
