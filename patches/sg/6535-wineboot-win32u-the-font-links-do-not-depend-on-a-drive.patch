From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wineboot, win32u: The font links do not depend on a drive (6535)

6533's links in C:\windows\Fonts pointed at "Z:\..." and so went
through dosdevices/z:. With Z: removed (winecfg, or a prefix made
without it) every link dangled, and the next update removed them all:
Krita, which reads the folder with its own fontconfig, found no font
and crashed at start. wineboot now links each font to its Unix path,
also accepts the "\??\unix\..." paths win32u registers in a prefix
without Z:, and makes a dangling link of its own again.

win32u skipped the links' names in every directory it scanned, so
Wine's own fonts (Tahoma, Marlett, Symbol, Wingdings, Webdings) were
not loaded from Wine's data directory either. They still came from the
registry's "Z:\..." paths; without Z: they were not loaded at all
(44 failures in the gdi32 font test). The names are now skipped in the
Windows directory only.
---
 dlls/win32u/font.c           |  6 ++++
 programs/wineboot/wineboot.c | 67 +++++++++++++++++++++++++++++++++---
 2 files changed, 69 insertions(+), 4 deletions(-)

diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
index 382e018..6471b82 100644
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -6857,6 +6857,12 @@ static void load_file_system_fonts(void)
     load_font_link_names();
     get_fonts_win_dir_path( NULL, path );
     load_directory_fonts( path, 0 );
+#ifndef SG_MUTANT_FONT_SKIP_ALL_DIRS
+    /* Stained Glass OS (wine-sg 6535): the links are skipped in the Windows directory only -- not the
+     * fonts they point at, in Wine's data directory (Tahoma and the others were then loaded only from
+     * the registry's "Z:\..." paths, and not at all in a prefix without Z:) */
+    while (skip_count) free( skip_names[--skip_count] );
+#endif
 
     /* Wine data directory */
     get_fonts_data_dir_path( NULL, path );
diff --git a/programs/wineboot/wineboot.c b/programs/wineboot/wineboot.c
index feab4f2..d24dd4b 100644
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -1811,6 +1811,60 @@ static BOOL is_our_link( const WCHAR *path )
     return attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_REPARSE_POINT);
 }
 
+/* a Unix path: "\??\unix\..." (what win32u registers a font outside every drive as, in a prefix
+ * without Z:) or "\\?\unix\..." */
+static BOOL is_unix_font_path( const WCHAR *path )
+{
+    return !wcsnicmp( path, L"\\??\\unix\\", 9 ) || !wcsnicmp( path, L"\\\\?\\unix\\", 9 );
+}
+
+/* a registered path that names a file: "X:\..." or a Unix path */
+static BOOL is_full_font_path( const WCHAR *path )
+{
+#ifdef SG_MUTANT_FONT_LINK_VIA_DRIVE
+    return path[0] && path[1] == ':' && path[2] == '\\';
+#endif
+    return (path[0] && path[1] == ':' && path[2] == '\\') || is_unix_font_path( path );
+}
+
+/* Stained Glass OS (wine-sg 6535): the link points at the font's Unix path, not through a drive
+ * letter: a link through Z: dangled once Z: was removed (or moved), and fontconfig then found no
+ * font at all (Krita crashed at start). */
+static BOOL font_link_target( const WCHAR *path, WCHAR *out, DWORD size )
+{
+    char *unix_name;
+    DWORD len;
+    WCHAR *p;
+
+#ifdef SG_MUTANT_FONT_LINK_VIA_DRIVE
+    lstrcpynW( out, path, size );
+    return TRUE;
+#endif
+    if (is_unix_font_path( path ))
+    {
+        lstrcpynW( out, path, size );
+        out[1] = '\\';   /* as "\\?\unix\..." */
+        return TRUE;
+    }
+    if (!(unix_name = wine_get_unix_file_name( path ))) return FALSE;
+    lstrcpyW( out, L"\\\\?\\unix" );
+    len = MultiByteToWideChar( CP_UTF8, 0, unix_name, -1, out + 8, size - 8 );
+    HeapFree( GetProcessHeap(), 0, unix_name );
+    if (!len) return FALSE;
+    for (p = out + 8; *p; p++) if (*p == '/') *p = '\\';
+    return TRUE;
+}
+
+/* (re)make a link of ours: a dangling one of ours is replaced */
+static BOOL make_font_link( const WCHAR *link, const WCHAR *path )
+{
+    WCHAR target[MAX_PATH + 16];
+
+    if (!font_link_target( path, target, ARRAY_SIZE(target) )) return FALSE;
+    if (GetFileAttributesW( link ) == INVALID_FILE_ATTRIBUTES) DeleteFileW( link );
+    return CreateSymbolicLinkW( link, target, 0 );
+}
+
 static void link_system_fonts(void)
 {
     WCHAR fonts_dir[MAX_PATH], name[512], data[MAX_PATH], link[MAX_PATH], target[MAX_PATH];
@@ -1876,9 +1930,14 @@ static void link_system_fonts(void)
         if (RegEnumValueW( fonts_key, i, name, &name_len, NULL, &type, (BYTE *)data, &data_len )) break;
         if (type != REG_SZ) continue;
         data[data_len / sizeof(WCHAR)] = 0;
-        if (!data[0] || data[1] != ':' || data[2] != '\\') continue;      /* a bare name: in the folder */
+        if (!is_full_font_path( data )) continue;      /* a bare name: in the folder */
         if (!wcsnicmp( data, fonts_dir, dir_len ) && data[dir_len] == '\\') continue;
-        if (!is_font_link_ext( data ) || GetFileAttributesW( data ) == INVALID_FILE_ATTRIBUTES) continue;
+        if (!is_font_link_ext( data )) continue;
+        if (GetFileAttributesW( data ) == INVALID_FILE_ATTRIBUTES)
+        {
+            TRACE( "%s: %s not found\n", debugstr_w(name), debugstr_w(data) );
+            continue;
+        }
         if (!(base = wcsrchr( data, '\\' ))) continue;
         base++;
 
@@ -1900,14 +1959,14 @@ static void link_system_fonts(void)
             {
                 if (!wcsicmp( target, data ))
                 {
-                    if (GetFileAttributesW( link ) == INVALID_FILE_ATTRIBUTES && CreateSymbolicLinkW( link, data, 0 ))
+                    if (GetFileAttributesW( link ) == INVALID_FILE_ATTRIBUTES && make_font_link( link, data ))
                         linked++;
                     break;   /* ours already */
                 }
                 continue;    /* ours, for another font */
             }
             if (GetFileAttributesW( link ) != INVALID_FILE_ATTRIBUTES) continue;   /* a file not ours */
-            if (CreateSymbolicLinkW( link, data, 0 ))
+            if (make_font_link( link, data ))
             {
                 RegSetValueExW( links_key, link_name, 0, REG_SZ, (const BYTE *)data, (lstrlenW( data ) + 1) * sizeof(WCHAR) );
                 linked++;
