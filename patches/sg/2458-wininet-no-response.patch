From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wininet: a server that hangs up without answering is an error

Ground truth from Wine's http test (2 todo_wine marks removed): when a fresh connection is closed by the server before a single byte of the response, HttpSendRequest fails with ERROR_HTTP_INVALID_SERVER_RESPONSE instead of succeeding with an empty response. (A reused connection that the server closed is still retried on a new one.)
---
--- a/dlls/wininet/http.c
+++ b/dlls/wininet/http.c
@@ -5208,6 +5208,15 @@ static DWORD HTTP_HttpSendRequestW(http_request_t *request, LPCWSTR lpszHeaders,
                 loop_next = TRUE;
                 continue;
             }
+#ifndef SG_MUTANT_WININET_NO_RESPONSE
+            /* a server that hangs up on a fresh connection without a word is no server */
+            if(!responseLen) {
+                TRACE("No response from the server\n");
+                http_release_netconn(request, FALSE);
+                res = ERROR_HTTP_INVALID_SERVER_RESPONSE;
+                goto lend;
+            }
+#endif
 
             INTERNET_SendCallback(&request->hdr, request->hdr.dwContext,
                                 INTERNET_STATUS_RESPONSE_RECEIVED, &responseLen,
--- a/dlls/wininet/tests/http.c
+++ b/dlls/wininet/tests/http.c
@@ -4451,8 +4451,8 @@ static void test_premature_disconnect(int port)
     SetLastError(0xdeadbeef);
     ret = HttpSendRequestA(req.request, NULL, 0, NULL, 0);
     err = GetLastError();
-    todo_wine ok(!ret, "HttpSendRequest succeeded\n");
-    todo_wine ok(err == ERROR_HTTP_INVALID_SERVER_RESPONSE, "got %lu\n", err);
+    ok(!ret, "HttpSendRequest succeeded\n");
+    ok(err == ERROR_HTTP_INVALID_SERVER_RESPONSE, "got %lu\n", err);
 
     close_request(&req);
 }
