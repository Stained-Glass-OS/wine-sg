 }
 
+/* Stained Glass OS: "the users of this computer" -- BUILTIN\Users,
+ * Authenticated Users, Interactive -- are the prefix's group (sgwine: every
+ * account that uses the machine's Windows system). A grant to them is the
+ * group's bits, and the file then belongs to that group (sg_users_group).
+ * Wine ignored such a grant: Steam's installer gives the users its folder, and
+ * Steam, run by a user, found "package not writable". */
+static const struct sid sg_auth_users_sid = { SID_REVISION, 1, SECURITY_NT_AUTHORITY, { SECURITY_AUTHENTICATED_USER_RID } };
+static const struct sid sg_interactive_sid = { SID_REVISION, 1, SECURITY_NT_AUTHORITY, { SECURITY_INTERACTIVE_RID } };
+static int sg_users_granted;   /* the last sd_to_mode saw write granted to the users */
+
+static int sg_is_users_sid( const struct sid *sid )
+{
+    return equal_sid( sid, &builtin_users_sid ) || equal_sid( sid, &sg_auth_users_sid ) ||
+           equal_sid( sid, &sg_interactive_sid );
+}
+
+static gid_t sg_tree_gid;
+
+static int sg_users_tree( const char *path, const struct stat *st, int type, struct FTW *ftw )
+{
+    if (type == FTW_SL || st->st_uid != getuid()) return 0;
+    if (st->st_gid != sg_tree_gid && lchown( path, -1, sg_tree_gid ) == -1) return 0;
+    if (type == FTW_D) chmod( path, (st->st_mode & 07777) | S_ISGID | S_IRGRP | S_IWGRP | S_IXGRP );
+    else if (type == FTW_F) chmod( path, (st->st_mode & 07777) | S_IRGRP | S_IWGRP );
+    return 0;
+}
+
+/* the users' write, granted: the file joins the users' group, and a directory
+ * passes it on to what is made in it (setgid) -- Windows' inheritance, as far
+ * as the file system has it. Only for the server's own account, which owns
+ * what it changes. */
+void sg_users_group( int unix_fd, const struct stat *st )
+{
+    static gid_t users_gid = (gid_t)-1;
+    static int looked;
+
+    if (!sg_users_granted || (current && current->process->peer_uid != getuid())) return;
+    if (!looked)
+    {
+        const char *name = getenv( "SG_USERS_GROUP" );   /* a gate's stand-in */
+        struct group *gr = getgrnam( name && *name ? name : "sgwine" );
+        looked = 1;
+        if (gr) users_gid = gr->gr_gid;
+    }
+    if (users_gid == (gid_t)-1) return;
+    if (st->st_gid != users_gid && fchown( unix_fd, -1, users_gid ) == -1) return;
+    if (S_ISDIR( st->st_mode ))
+    {
+        char proc[32], path[4096];
+        ssize_t len;
+
+        fchmod( unix_fd, (st->st_mode & 07777) | S_ISGID | S_IWGRP | S_IRGRP | S_IXGRP );
+        /* what is in it already gets the grant too, as SetNamedSecurityInfo
+         * passes an inheritable grant on (an installer sets it after
+         * unpacking) -- what this account owns, not through links */
+        snprintf( proc, sizeof(proc), "/proc/self/fd/%d", unix_fd );
+        if ((len = readlink( proc, path, sizeof(path) - 1 )) > 0)
+        {
+            path[len] = 0;
+            sg_tree_gid = users_gid;
+            nftw( path, sg_users_tree, 16, FTW_PHYS );
+        }
+    }
+    else fchmod( unix_fd, (st->st_mode & 07777) | S_IWGRP | S_IRGRP );
+}
+
 mode_t sd_to_mode( const struct security_descriptor *sd, const struct sid *owner )
 {
     mode_t new_mode = 0;
