From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui, dcomp: CoreWindow weak references, ICompositor5

WinUI 2's AnimatedVisualPlayer (in every ProgressRing, Windows Terminal's tab headers) takes a weak reference to the thread's CoreWindow and uses the compositor's ICompositor5; the CoreWindow gave no IWeakReferenceSource and the compositor no ICompositor5, and both failures ended in null pointers. The thread's CoreWindow now gives weak references (it lives as long as its thread); the compositor answers ICompositor5: Comment and GlobalPlaybackRate are kept, RequestCommitAsync gives an action already done (every commit is drawn at once), and shapes, shape visuals, geometries and bounce and path animations are not made yet (E_NOTIMPL, so Lottie animations show their fallback).
---
diff --git a/dlls/dcomp/composition.c b/dlls/dcomp/composition.c
index b3de97d..7438b40 100644
--- a/dlls/dcomp/composition.c
+++ b/dlls/dcomp/composition.c
@@ -1635,7 +1635,10 @@ struct compositor
     ICompositorInterop ICompositorInterop_iface;
     ICompositorDesktopInterop ICompositorDesktopInterop_iface;
     IClosable IClosable_iface;
+    struct { const void * const *lpVtbl; } ICompositor5_iface;
     LONG ref;
+    HSTRING comment;                    /* ICompositor5's, kept */
+    FLOAT playback_rate;
     struct list targets;
     ID2D1Device *d2d_device;            /* the first graphics device's, the targets draw with it */
     struct compositor_controller *controller;   /* not referenced */
@@ -2243,6 +2246,10 @@ static struct compositor *impl_from_ICompositor( ICompositor *iface )
     return CONTAINING_RECORD( iface, struct compositor, ICompositor_iface );
 }
 
+/* ICompositor5 (Windows 10 1809): identity per windows-rs (MIT); not in our idl */
+static const GUID IID_ICompositor5_sg = { 0x48ea31ad, 0x7fcd, 0x4076, { 0xa7, 0x9c, 0x90, 0xcc, 0x4b, 0x85, 0x2c, 0x9b } };
+static const void * const compositor5_vtbl[];
+
 static HRESULT WINAPI compositor_QueryInterface( ICompositor *iface, REFIID iid, void **out )
 {
     struct compositor *impl = impl_from_ICompositor( iface );
@@ -2258,6 +2265,10 @@ static HRESULT WINAPI compositor_QueryInterface( ICompositor *iface, REFIID iid,
         *out = &impl->ICompositorDesktopInterop_iface;
     else if (IsEqualGUID( iid, &IID_IClosable ))
         *out = &impl->IClosable_iface;
+#ifndef SG_MUTANT_NO_COMPOSITOR5
+    else if (IsEqualGUID( iid, &IID_ICompositor5_sg ))
+        *out = &impl->ICompositor5_iface;
+#endif
     else
     {
         FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
@@ -2290,6 +2301,7 @@ static ULONG WINAPI compositor_Release( ICompositor *iface )
             DestroyWindow( impl->notify_window );
         }
         animations_free( impl );
+        WindowsDeleteString( impl->comment );
         if (impl->d2d_device) ID2D1Device_Release( impl->d2d_device );
         impl->cs.DebugInfo->Spare[0] = 0;
         DeleteCriticalSection( &impl->cs );
@@ -2766,6 +2778,8 @@ static HRESULT compositor_create( struct compositor **out )
 
     if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
     impl->ICompositor_iface.lpVtbl = &compositor_vtbl;
+    impl->ICompositor5_iface.lpVtbl = compositor5_vtbl;
+    impl->playback_rate = 1.0f;
     impl->ICompositorInterop_iface.lpVtbl = &compositor_interop_vtbl;
     impl->ICompositorDesktopInterop_iface.lpVtbl = &desktop_interop_vtbl;
     impl->IClosable_iface.lpVtbl = &compositor_closable_vtbl;
@@ -3086,6 +3100,22 @@ static const IAsyncInfoVtbl done_info_vtbl =
     done_info_Close,
 };
 
+static HRESULT done_action_create( IAsyncAction **action )
+{
+    static LONG next_id;
+    struct done_action *impl;
+
+    if (!action) return E_POINTER;
+    *action = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAsyncAction_iface.lpVtbl = &done_action_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &done_info_vtbl;
+    impl->ref = 1;
+    impl->id = InterlockedIncrement( &next_id );
+    *action = &impl->IAsyncAction_iface;
+    return S_OK;
+}
+
 static HRESULT WINAPI controller_EnsurePreviousCommitCompletedAsync( ICompositorController *iface,
         IAsyncAction **action )
 {
@@ -3295,3 +3325,117 @@ HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **fa
     IActivationFactory_AddRef( *factory );
     return S_OK;
 }
+
+/* ---- ICompositor5: its comment and playback rate are kept, a commit is waited for as the
+ * controller's is (every commit is drawn at once); shapes, shape visuals, bounce and path animations
+ * are not made yet (E_NOTIMPL: a program's animated visuals, as Lottie's, fall back) ---- */
+
+static struct compositor *impl_from_compositor5( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct compositor, ICompositor5_iface );
+}
+
+static HRESULT WINAPI compositor5_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    return compositor_QueryInterface( &impl_from_compositor5( iface )->ICompositor_iface, iid, out );
+}
+
+static ULONG WINAPI compositor5_AddRef( void *iface )
+{
+    return compositor_AddRef( &impl_from_compositor5( iface )->ICompositor_iface );
+}
+
+static ULONG WINAPI compositor5_Release( void *iface )
+{
+    return compositor_Release( &impl_from_compositor5( iface )->ICompositor_iface );
+}
+
+static HRESULT WINAPI compositor5_GetIids( void *iface, ULONG *count, IID **iids )
+{
+    return compositor_GetIids( &impl_from_compositor5( iface )->ICompositor_iface, count, iids );
+}
+
+static HRESULT WINAPI compositor5_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    return compositor_GetRuntimeClassName( &impl_from_compositor5( iface )->ICompositor_iface, name );
+}
+
+static HRESULT WINAPI compositor5_GetTrustLevel( void *iface, TrustLevel *level )
+{
+    return compositor_GetTrustLevel( &impl_from_compositor5( iface )->ICompositor_iface, level );
+}
+
+static HRESULT WINAPI compositor5_get_Comment( void *iface, HSTRING *value )
+{
+    if (!value) return E_POINTER;
+    return WindowsDuplicateString( impl_from_compositor5( iface )->comment, value );
+}
+
+static HRESULT WINAPI compositor5_put_Comment( void *iface, HSTRING value )
+{
+    struct compositor *impl = impl_from_compositor5( iface );
+    HSTRING copy;
+    HRESULT hr;
+
+    if (FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
+    WindowsDeleteString( impl->comment );
+    impl->comment = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI compositor5_get_GlobalPlaybackRate( void *iface, FLOAT *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_compositor5( iface )->playback_rate;
+    return S_OK;
+}
+
+static HRESULT WINAPI compositor5_put_GlobalPlaybackRate( void *iface, FLOAT value )
+{
+    if (value < 0 || value > 1000) return E_INVALIDARG;
+    impl_from_compositor5( iface )->playback_rate = value;   /* animations run at their own rate */
+    return S_OK;
+}
+
+static HRESULT WINAPI compositor5_not_made( void *iface, void **out )
+{
+    FIXME( "iface %p: shapes and these animations are not supported yet\n", iface );
+    if (out) *out = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI compositor5_not_made_with( void *iface, void *arg, void **out )
+{
+    return compositor5_not_made( iface, out );
+}
+
+static HRESULT WINAPI compositor5_RequestCommitAsync( void *iface, IAsyncAction **action )
+{
+    TRACE( "iface %p, action %p.\n", iface, action );
+    compositor_commit( impl_from_compositor5( iface ) );
+    return done_action_create( action );
+}
+
+static const void * const compositor5_vtbl[] =
+{
+    compositor5_QueryInterface, compositor5_AddRef, compositor5_Release, compositor5_GetIids,
+    compositor5_GetRuntimeClassName, compositor5_GetTrustLevel,
+    compositor5_get_Comment, compositor5_put_Comment, compositor5_get_GlobalPlaybackRate,
+    compositor5_put_GlobalPlaybackRate,
+    compositor5_not_made,           /* CreateBounceScalarAnimation */
+    compositor5_not_made,           /* CreateBounceVector2Animation */
+    compositor5_not_made,           /* CreateBounceVector3Animation */
+    compositor5_not_made,           /* CreateContainerShape */
+    compositor5_not_made,           /* CreateEllipseGeometry */
+    compositor5_not_made,           /* CreateLineGeometry */
+    compositor5_not_made,           /* CreatePathGeometry */
+    compositor5_not_made_with,      /* CreatePathGeometryWithPath */
+    compositor5_not_made,           /* CreatePathKeyFrameAnimation */
+    compositor5_not_made,           /* CreateRectangleGeometry */
+    compositor5_not_made,           /* CreateRoundedRectangleGeometry */
+    compositor5_not_made,           /* CreateShapeVisual */
+    compositor5_not_made,           /* CreateSpriteShape */
+    compositor5_not_made_with,      /* CreateSpriteShapeWithGeometry */
+    compositor5_not_made,           /* CreateViewBox */
+    compositor5_RequestCommitAsync,
+};
diff --git a/dlls/windows.ui/thread_corewindow.c b/dlls/windows.ui/thread_corewindow.c
index f8a1a57..af17e91 100644
--- a/dlls/windows.ui/thread_corewindow.c
+++ b/dlls/windows.ui/thread_corewindow.c
@@ -29,6 +29,7 @@
 
 #include <stdlib.h>
 #include "private.h"
+#include "weakreference.h"
 #include "initguid.h"
 
 #include "wine/debug.h"
@@ -36,11 +37,15 @@
 WINE_DEFAULT_DEBUG_CHANNEL(ui);
 
 DEFINE_GUID(IID_ICoreWindowInterop_sg, 0x45d64a29, 0xa63e, 0x4cb6, 0xb4, 0x98, 0x57, 0x81, 0xd2, 0x98, 0xcb, 0x4f);
+static const GUID IID_IWeakReferenceSource_cw = { 0x00000038, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
+static const GUID IID_IWeakReference_cw = { 0x00000037, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
 
 struct thread_corewindow
 {
     __x_ABI_CWindows_CUI_CCore_CICoreWindow ICoreWindow_iface;
     IUnknown ICoreWindowInterop_iface;
+    IWeakReferenceSource IWeakReferenceSource_iface;   /* C++/WinRT's weak references to it */
+    IWeakReference IWeakReference_iface;               /* it lives as long as its thread */
     LONG ref;
     HWND hwnd;
     DWORD thread;
@@ -50,6 +55,75 @@ struct thread_corewindow
 
 static DWORD corewindow_tls = TLS_OUT_OF_INDEXES;
 
+static HRESULT WINAPI cw_QueryInterface( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface, REFIID iid, void **out );
+
+static struct thread_corewindow *impl_from_source( IWeakReferenceSource *iface )
+{
+    return CONTAINING_RECORD( iface, struct thread_corewindow, IWeakReferenceSource_iface );
+}
+
+static HRESULT WINAPI source_QueryInterface( IWeakReferenceSource *iface, REFIID iid, void **out )
+{
+    return cw_QueryInterface( &impl_from_source( iface )->ICoreWindow_iface, iid, out );
+}
+
+static ULONG WINAPI source_AddRef( IWeakReferenceSource *iface )
+{
+    return InterlockedIncrement( &impl_from_source( iface )->ref );
+}
+
+static ULONG WINAPI source_Release( IWeakReferenceSource *iface )
+{
+    return InterlockedDecrement( &impl_from_source( iface )->ref );
+}
+
+static HRESULT WINAPI source_GetWeakReference( IWeakReferenceSource *iface, IWeakReference **weak )
+{
+    struct thread_corewindow *impl = impl_from_source( iface );
+
+    if (!weak) return E_POINTER;
+    *weak = &impl->IWeakReference_iface;
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static const IWeakReferenceSourceVtbl source_vtbl = { source_QueryInterface, source_AddRef, source_Release, source_GetWeakReference };
+
+static struct thread_corewindow *impl_from_weak( IWeakReference *iface )
+{
+    return CONTAINING_RECORD( iface, struct thread_corewindow, IWeakReference_iface );
+}
+
+static HRESULT WINAPI weak_QueryInterface( IWeakReference *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IWeakReference_cw ))
+    {
+        *out = iface;
+        InterlockedIncrement( &impl_from_weak( iface )->ref );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI weak_AddRef( IWeakReference *iface )
+{
+    return InterlockedIncrement( &impl_from_weak( iface )->ref );
+}
+
+static ULONG WINAPI weak_Release( IWeakReference *iface )
+{
+    return InterlockedDecrement( &impl_from_weak( iface )->ref );
+}
+
+static HRESULT WINAPI weak_Resolve( IWeakReference *iface, REFIID iid, IInspectable **out )
+{
+    /* the thread's window is never gone while its thread runs */
+    return cw_QueryInterface( &impl_from_weak( iface )->ICoreWindow_iface, iid, (void **)out );
+}
+
+static const IWeakReferenceVtbl weak_vtbl = { weak_QueryInterface, weak_AddRef, weak_Release, weak_Resolve };
+
 static struct thread_corewindow *impl_from_ICoreWindow( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface )
 {
     return CONTAINING_RECORD( iface, struct thread_corewindow, ICoreWindow_iface );
@@ -78,6 +152,14 @@ static HRESULT WINAPI cw_QueryInterface( __x_ABI_CWindows_CUI_CCore_CICoreWindow
         InterlockedIncrement( &impl->ref );
         return S_OK;
     }
+#ifndef SG_MUTANT_COREWINDOW_NO_WEAK
+    if (IsEqualGUID( iid, &IID_IWeakReferenceSource_cw ))
+    {
+        *out = &impl->IWeakReferenceSource_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+#endif
     FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
@@ -282,6 +364,8 @@ BOOL WINAPI SgCoreWindowForThread( HWND hwnd )
     if (!(impl = calloc( 1, sizeof(*impl) ))) return FALSE;
     impl->ICoreWindow_iface.lpVtbl = (void *)corewindow_vtbl;
     impl->ICoreWindowInterop_iface.lpVtbl = (void *)interop_vtbl;
+    impl->IWeakReferenceSource_iface.lpVtbl = &source_vtbl;
+    impl->IWeakReference_iface.lpVtbl = &weak_vtbl;
     impl->ref = 1;
     impl->hwnd = hwnd;
     impl->thread = GetCurrentThreadId();
