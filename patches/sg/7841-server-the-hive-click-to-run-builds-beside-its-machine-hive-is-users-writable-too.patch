From: Stained Glass OS <ke7oxh@gmail.com>
Subject: server: the hive Click-to-Run builds beside its machine hive is users-writable too

Verifying 7822 on a fresh 10.0-939 install (qa4): in the session of the
install Word still could not save a new document ("The save failed due to
out of memory or disk space"), and every key of HKLM\Software\Microsoft\
Office\ClickToRun\REGISTRY had the machine DACL (users read). A trace of the
server's key creation showed why: Click-to-Run does not build the hive in
place. It creates its 26,000 keys under ClickToRun\VREGISTRY_<guid>, which
5942 did not name, so they took the machine descriptor from SYSTEM's token,
and then renames that key to REGISTRY; the keys keep their descriptors. Only
after the server restarted (descriptors are not saved) were they writable.

VREGISTRY_<anything> beside REGISTRY is now the same hive for the rule: keys
without a descriptor are not checked against the machine default, and keys
made there get the users-writable DACL. REGISTRYX and VREGISTRYX are still
not.

Gate: test-hklmsd (SYSTEM makes a key in VREGISTRY_<guid>; a standard user
opens it with KEY_ALL_ACCESS; VREGISTRYX stays read-only).
Mutant SG_MUTANT_C2R_BUILDING_HIVE_READONLY.

--- a/server/registry.c
+++ b/server/registry.c
@@ -680,10 +680,13 @@
 {
     static const char * const hives[] =
     {
-        "\\Registry\\Machine\\Software\\Microsoft\\Office\\ClickToRun\\REGISTRY",
-        "\\Registry\\Machine\\Software\\Wow6432Node\\Microsoft\\Office\\ClickToRun\\REGISTRY",
+        "\\Registry\\Machine\\Software\\Microsoft\\Office\\ClickToRun\\",
+        "\\Registry\\Machine\\Software\\Wow6432Node\\Microsoft\\Office\\ClickToRun\\",
     };
-    data_size_t chars = len / sizeof(WCHAR), i, j, n;
+    /* the hive, and the one Click-to-Run builds beside it and then renames over it (7841):
+     * VREGISTRY_<guid> */
+    static const char hive[] = "REGISTRY", building[] = "VREGISTRY_";
+    data_size_t chars = len / sizeof(WCHAR), i, j, n, k;
 
 #ifdef SG_MUTANT_C2R_HIVE_READONLY
     return 0;
@@ -691,10 +694,26 @@
     for (i = 0; i < ARRAY_SIZE(hives); i++)
     {
         n = strlen( hives[i] );
-        if (chars < n || (chars > n && name[n] != '\\')) continue;
+        if (chars <= n) continue;
         for (j = 0; j < n; j++)
             if (name[j] >= 0x80 || tolower( name[j] ) != tolower( (unsigned char)hives[i][j] )) break;
-        if (j == n) return 1;
+        if (j < n) continue;
+        /* the component after ClickToRun */
+        for (k = n; k < chars && name[k] != '\\'; k++) ;
+        if (k - n == strlen( hive ))
+        {
+            for (j = 0; j < k - n; j++)
+                if (name[n + j] >= 0x80 || tolower( name[n + j] ) != tolower( (unsigned char)hive[j] )) break;
+            if (j == k - n) return 1;
+        }
+#ifndef SG_MUTANT_C2R_BUILDING_HIVE_READONLY
+        if (k - n > strlen( building ))
+        {
+            for (j = 0; j < strlen( building ); j++)
+                if (name[n + j] >= 0x80 || tolower( name[n + j] ) != tolower( (unsigned char)building[j] )) break;
+            if (j == strlen( building )) return 1;
+        }
+#endif
     }
     return 0;
 }
