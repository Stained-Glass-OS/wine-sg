From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: a WS_EX_COMPOSITED window's children paint bottom to top

Windows paints all descendants of a WS_EX_COMPOSITED window into one buffer, lowest first. The server handed out WM_PAINT (find_child_to_repaint, get_child_update_flags) top first, so a lower sibling that does not clip its siblings painted over a higher one: Opera's uninstall dialog showed no Uninstall, Re-install or close button. Inside a composited window, children are now visited bottom to top.
---
diff --git a/server/window.c b/server/window.c
index a78115a..1d4189b 100644
--- a/server/window.c
+++ b/server/window.c
@@ -1252,12 +1252,39 @@ static inline int win_needs_repaint( struct window *win )
 
 
 /* find a child of the specified window that needs repainting */
+/* Stained Glass OS (wine-sg 6100): the children of a window with WS_EX_COMPOSITED (or inside one)
+ * are painted bottom to top, as Windows paints them into one buffer: a lower sibling that does not
+ * clip its siblings then cannot paint over a higher one. Opera's installer (RootScreen, composited)
+ * painted its ButtonStrip, the topmost child, first and its UninstallScreen, which covers it, after:
+ * the Uninstall and Re-install buttons were never seen. */
+static int paints_children_bottom_up( struct window *win )
+{
+#ifdef SG_MUTANT_COMPOSITED_TOP_DOWN
+    return 0;
+#endif
+    for (; win; win = win->parent) if (is_window_composited( win )) return 1;
+    return 0;
+}
+
+static struct list *first_child( struct window *win, int rev )
+{
+    return rev ? list_tail( &win->children ) : list_head( &win->children );
+}
+
+static struct list *next_child( struct window *win, struct list *entry, int rev )
+{
+    return rev ? list_prev( &win->children, entry ) : list_next( &win->children, entry );
+}
+
 static struct window *find_child_to_repaint( struct window *parent, struct thread *thread )
 {
     struct window *ptr, *ret = NULL;
+    int rev = paints_children_bottom_up( parent );
+    struct list *entry;
 
-    LIST_FOR_EACH_ENTRY( ptr, &parent->children, struct window, entry )
+    for (entry = first_child( parent, rev ); entry; entry = next_child( parent, entry, rev ))
     {
+        ptr = LIST_ENTRY( entry, struct window, entry );
         if (!(ptr->style & WS_VISIBLE)) continue;
         if (ptr->thread == thread && win_needs_repaint( ptr ))
             ret = ptr;
@@ -1907,6 +1934,8 @@ static unsigned int get_child_update_flags( struct window *win, struct window *f
 {
     struct window *ptr;
     unsigned int ret = 0;
+    struct list *entry;
+    int rev;
 
     /* first make sure we want to iterate children at all */
 
@@ -1918,8 +1947,10 @@ static unsigned int get_child_update_flags( struct window *win, struct window *f
      */
     if (!(flags & UPDATE_ALLCHILDREN) && !(win->style & WS_CLIPCHILDREN)) return 0;
 
-    LIST_FOR_EACH_ENTRY( ptr, &win->children, struct window, entry )
+    rev = paints_children_bottom_up( win );
+    for (entry = first_child( win, rev ); entry; entry = next_child( win, entry, rev ))
     {
+        ptr = LIST_ENTRY( entry, struct window, entry );
         if (from_child)  /* skip all children until from_child is found */
         {
             if (ptr == from_child) from_child = NULL;
