From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: the topmost windows back over a window that took the focus

In a virtual desktop, after a window takes the focus the visible topmost
windows (the taskbar) are restacked over it in Wine's order: stacking it
right below the lowest of them was not enough when the X order had drifted
(field report 2026-10-17: a window under the taskbar came over the bar when
another window closed). Not reproduced in Xvfb; a defensive change.
---
--- a/dlls/winex11.drv/event.c
+++ b/dlls/winex11.drv/event.c
@@ -612,6 +612,34 @@
 }
 
 
+/* Stained Glass: in a virtual desktop, the topmost windows (the taskbar) back
+ * over a window that took the focus, in Wine's own order -- stacking it right
+ * below the lowest of them was not enough when the X order had drifted from
+ * Wine's: a window reaching under the taskbar came up over the bar when
+ * another window closed, for good or for a frame (David, 2026-10-17) */
+static void raise_topmost_band( Display *display, HWND hwnd )
+{
+    HWND list[64], w;
+    int n = 0;
+    XWindowChanges changes;
+
+    if (!is_virtual_desktop()) return;
+    if (NtUserGetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_TOPMOST) return;
+    for (w = NtUserGetWindowRelative( NtUserGetDesktopWindow(), GW_CHILD );
+         w && (NtUserGetWindowLongW( w, GWL_EXSTYLE ) & WS_EX_TOPMOST) && n < ARRAY_SIZE(list);
+         w = NtUserGetWindowRelative( w, GW_HWNDNEXT ))
+    {
+        if (w == hwnd || !(NtUserGetWindowLongW( w, GWL_STYLE ) & WS_VISIBLE)) continue;
+        list[n++] = w;
+    }
+    changes.stack_mode = Above;
+    while (n--)   /* the lowest first: each raise puts the next higher one above it */
+    {
+        Window x = X11DRV_get_whole_window( list[n] );
+        if (x) XConfigureWindow( display, x, CWStackMode, &changes );
+    }
+}
+
 /**********************************************************************
  *              set_input_focus
  *
@@ -664,6 +692,9 @@
             XConfigureWindow( data->display, data->whole_window, CWStackMode, &changes );
         }
     }
+#ifndef SG_MUTANT_TOPMOST_UNDER
+    raise_topmost_band( data->display, data->hwnd );
+#endif
 
     if (data->embedder)
         xembed_request_focus( data->display, data->embedder, timestamp );
