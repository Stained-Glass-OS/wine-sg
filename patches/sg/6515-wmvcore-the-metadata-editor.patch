+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Stained Glass OS (wine-sg 6515): WMCreateEditor was a stub (E_NOTIMPL), so tag editors for
+ * WMA/WMV/ASF files could not open them. The editor reads the header object of an ASF file
+ * (the Advanced Systems Format specification): its Content Description Object (Title, Author,
+ * Copyright, Description, Rating) and Extended Content Description Object (every other file
+ * attribute: WM/AlbumTitle, WM/Genre, ...) become the attributes of its IWMHeaderInfo3 (the
+ * writer's attribute store); Flush writes the two objects back, the header's other objects
+ * kept as they were and the data after it untouched; Close without Flush keeps the file as it
+ * was.
+ */
+
+#include "wmvcore_private.h"
+#include "wmsdk.h"
+#include "asferr.h"
+#include "nserror.h"
+#include "profile.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wmvcore);
+
+static const GUID asf_header = {0x75b22630, 0x668e, 0x11cf, {0xa6, 0xd9, 0x00, 0xaa, 0x00, 0x62, 0xce, 0x6c}};
+static const GUID asf_file_properties = {0x8cabdca1, 0xa947, 0x11cf, {0x8e, 0xe4, 0x00, 0xc0, 0x0c, 0x20, 0x53, 0x65}};
+static const GUID asf_content_description = {0x75b22633, 0x668e, 0x11cf, {0xa6, 0xd9, 0x00, 0xaa, 0x00, 0x62, 0xce, 0x6c}};
+static const GUID asf_extended_content_description = {0xd2d0a440, 0xe307, 0x11d2, {0x97, 0xf0, 0x00, 0xa0, 0xc9, 0x5e, 0xa8, 0x50}};
+
+/* the Content Description Object's five strings, in their order */
+static const WCHAR *const description_names[] = { L"Title", L"Author", L"Copyright", L"Description", L"Rating" };
+
+#define HEADER_SIZE 30   /* GUID, size, object count, two reserved bytes */
+#define OBJECT_SIZE 24   /* GUID, size */
+
+struct editor
+{
+    IWMMetadataEditor IWMMetadataEditor_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+
+    struct writer_header *header;
+    WCHAR *path;
+    BYTE *objects;          /* the header object's children, as read */
+    DWORD objects_size, object_count;
+    UINT64 header_size;     /* where the data starts */
+};
+
+static inline struct editor *impl_from_IWMMetadataEditor(IWMMetadataEditor *iface)
+{
+    return CONTAINING_RECORD(iface, struct editor, IWMMetadataEditor_iface);
+}
+
+static HRESULT WINAPI editor_QueryInterface(IWMMetadataEditor *iface, REFIID iid, void **out)
+{
+    struct editor *editor = impl_from_IWMMetadataEditor(iface);
+
+    TRACE("(%p)->(%s %p)\n", editor, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IWMMetadataEditor))
+        *out = &editor->IWMMetadataEditor_iface;
+    else if (IsEqualGUID(iid, &IID_IWMHeaderInfo) || IsEqualGUID(iid, &IID_IWMHeaderInfo2)
+            || IsEqualGUID(iid, &IID_IWMHeaderInfo3))
+        *out = writer_header_iface(editor->header);
+    else
+    {
+        WARN("Unsupported interface %s.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI editor_AddRef(IWMMetadataEditor *iface)
+{
+    struct editor *editor = impl_from_IWMMetadataEditor(iface);
+    return InterlockedIncrement(&editor->ref);
+}
+
+static void editor_reset(struct editor *editor)
+{
+    free(editor->path);
+    free(editor->objects);
+    editor->path = NULL;
+    editor->objects = NULL;
+    editor->objects_size = editor->object_count = 0;
+    editor->header_size = 0;
+}
+
+static ULONG WINAPI editor_Release(IWMMetadataEditor *iface)
+{
+    struct editor *editor = impl_from_IWMMetadataEditor(iface);
+    ULONG ref = InterlockedDecrement(&editor->ref);
+
+    if (!ref)
+    {
+        editor_reset(editor);
+        writer_header_destroy(editor->header);
+        editor->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&editor->cs);
+        free(editor);
+    }
+    return ref;
+}
+
+/* a new attribute store (the old one's values gone) */
+static HRESULT editor_new_header(struct editor *editor)
+{
+    struct writer_header *header;
+    HRESULT hr;
+
+    if (FAILED(hr = writer_header_create((IUnknown *)&editor->IWMMetadataEditor_iface, &header)))
+        return hr;
+    if (editor->header) writer_header_destroy(editor->header);
+    editor->header = header;
+    return S_OK;
+}
+
+static void add_attribute(struct editor *editor, const WCHAR *name, WMT_ATTR_DATATYPE type, const BYTE *value, DWORD length)
+{
+    IWMHeaderInfo3 *info = writer_header_iface(editor->header);
+    WORD index;
+    HRESULT hr;
+
+    if (FAILED(hr = IWMHeaderInfo3_AddAttribute(info, 0, name, &index, type, 0, value, length)))
+        WARN("attribute %s not kept: %#lx\n", debugstr_w(name), hr);
+}
+
+/* a string as the store keeps it: terminated, its length with the terminator */
+static void add_string(struct editor *editor, const WCHAR *name, const BYTE *data, WORD length)
+{
+    WCHAR *str;
+    WORD chars = length / sizeof(WCHAR);
+
+    if (!length) return;
+    if (!(str = calloc(chars + 1, sizeof(WCHAR)))) return;
+    memcpy(str, data, chars * sizeof(WCHAR));
+    add_attribute(editor, name, WMT_TYPE_STRING, (BYTE *)str, (wcslen(str) + 1) * sizeof(WCHAR));
+    free(str);
+}
+
+static void read_content_description(struct editor *editor, const BYTE *data, DWORD size)
+{
+    WORD lengths[ARRAY_SIZE(description_names)];
+    DWORD pos = sizeof(lengths), i;
+
+    if (size < sizeof(lengths)) return;
+    memcpy(lengths, data, sizeof(lengths));
+    for (i = 0; i < ARRAY_SIZE(description_names); i++)
+    {
+        if (lengths[i] > size - pos) return;
+        add_string(editor, description_names[i], data + pos, lengths[i]);
+        pos += lengths[i];
+    }
+}
+
+static void read_extended_content_description(struct editor *editor, const BYTE *data, DWORD size)
+{
+    WORD count, name_length, type, value_length, i;
+    DWORD pos = 2;
+    WCHAR *name;
+
+    if (size < 2) return;
+    memcpy(&count, data, 2);
+    for (i = 0; i < count; i++)
+    {
+        const BYTE *value;
+
+        if (size - pos < 2) return;
+        memcpy(&name_length, data + pos, 2);
+        pos += 2;
+        if (size - pos < (DWORD)name_length + 4) return;
+        if (!(name = calloc(name_length / sizeof(WCHAR) + 1, sizeof(WCHAR)))) return;
+        memcpy(name, data + pos, name_length & ~1);
+        pos += name_length;
+        memcpy(&type, data + pos, 2);
+        memcpy(&value_length, data + pos + 2, 2);
+        pos += 4;
+        if (size - pos < value_length) { free(name); return; }
+        value = data + pos;
+        pos += value_length;
+
+        /* the descriptor types: string, bytes, BOOL (4 bytes), DWORD, QWORD, WORD */
+        switch (type)
+        {
+        case 0: add_string(editor, name, value, value_length); break;
+        case 1: add_attribute(editor, name, WMT_TYPE_BINARY, value, value_length); break;
+        case 2: if (value_length >= 4) add_attribute(editor, name, WMT_TYPE_BOOL, value, 4); break;
+        case 3: if (value_length >= 4) add_attribute(editor, name, WMT_TYPE_DWORD, value, 4); break;
+        case 4: if (value_length >= 8) add_attribute(editor, name, WMT_TYPE_QWORD, value, 8); break;
+        case 5: if (value_length >= 2) add_attribute(editor, name, WMT_TYPE_WORD, value, 2); break;
+        default: WARN("descriptor %s of type %u skipped\n", debugstr_w(name), type); break;
+        }
+        free(name);
+    }
+}
+
+static HRESULT WINAPI editor_Open(IWMMetadataEditor *iface, const WCHAR *filename)
+{
+    struct editor *editor = impl_from_IWMMetadataEditor(iface);
+    BYTE header[HEADER_SIZE];
+    UINT64 size;
+    DWORD read, pos, i;
+    BOOL file_properties = FALSE;
+    HANDLE file;
+    HRESULT hr;
+
+    TRACE("(%p)->(%s)\n", editor, debugstr_w(filename));
+
+    if (!filename) return E_INVALIDARG;
+    EnterCriticalSection(&editor->cs);
+    if (editor->path)
+    {
+        LeaveCriticalSection(&editor->cs);
+        return NS_E_INVALID_REQUEST;
+    }
+
+    file = CreateFileW(filename, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        LeaveCriticalSection(&editor->cs);
+        return hr;
+    }
+    hr = NS_E_INVALID_INPUT_FORMAT;
+    if (!ReadFile(file, header, sizeof(header), &read, NULL) || read != sizeof(header) ||
+        !IsEqualGUID((GUID *)header, &asf_header))
+        goto done;
+    memcpy(&size, header + 16, 8);
+    memcpy(&editor->object_count, header + 24, 4);
+    if (size < HEADER_SIZE || size > 64 * 1024 * 1024) goto done;
+    editor->objects_size = size - HEADER_SIZE;
+    if (!(editor->objects = malloc(max(editor->objects_size, 1))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if (!ReadFile(file, editor->objects, editor->objects_size, &read, NULL) || read != editor->objects_size)
+        goto done;
+    if (FAILED(hr = editor_new_header(editor))) goto done;
+    hr = NS_E_INVALID_INPUT_FORMAT;
+
+    for (i = 0, pos = 0; i < editor->object_count; i++)
+    {
+        const BYTE *object = editor->objects + pos;
+        UINT64 object_size;
+
+        if (editor->objects_size - pos < OBJECT_SIZE) goto done;
+        memcpy(&object_size, object + 16, 8);
+        if (object_size < OBJECT_SIZE || object_size > editor->objects_size - pos) goto done;
+        if (IsEqualGUID((GUID *)object, &asf_file_properties)) file_properties = TRUE;
+#ifndef SG_MUTANT_WMED_NO_READ
+        else if (IsEqualGUID((GUID *)object, &asf_content_description))
+            read_content_description(editor, object + OBJECT_SIZE, object_size - OBJECT_SIZE);
+        else if (IsEqualGUID((GUID *)object, &asf_extended_content_description))
+            read_extended_content_description(editor, object + OBJECT_SIZE, object_size - OBJECT_SIZE);
+#endif
+        pos += object_size;
+    }
+    if (!file_properties) goto done;
+
+    editor->header_size = size;
+    editor->path = wcsdup(filename);
+    hr = editor->path ? S_OK : E_OUTOFMEMORY;
+
+done:
+    CloseHandle(file);
+    if (FAILED(hr))
+    {
+        WARN("%s: %#lx\n", debugstr_w(filename), hr);
+        editor_reset(editor);
+    }
+    LeaveCriticalSection(&editor->cs);
+    return hr;
+}
+
+static HRESULT WINAPI editor_Close(IWMMetadataEditor *iface)
+{
+    struct editor *editor = impl_from_IWMMetadataEditor(iface);
+
+    TRACE("(%p)\n", editor);
+
+    EnterCriticalSection(&editor->cs);
+    if (!editor->path)
+    {
+        LeaveCriticalSection(&editor->cs);
+        return NS_E_INVALID_REQUEST;
+    }
+    /* the changes not flushed are dropped */
+    editor_reset(editor);
+    editor_new_header(editor);
+    LeaveCriticalSection(&editor->cs);
+    return S_OK;
+}
+
+struct buffer
+{
+    BYTE *data;
+    SIZE_T size, capacity;
+    BOOL failed;
+};
+
+static void put(struct buffer *buffer, const void *data, SIZE_T size)
+{
+    if (buffer->failed) return;
+    if (buffer->size + size > buffer->capacity)
+    {
+        SIZE_T capacity = max(buffer->size + size, max(4096, buffer->capacity * 2));
+        BYTE *grown = realloc(buffer->data, capacity);
+        if (!grown) { buffer->failed = TRUE; return; }
+        buffer->data = grown;
+        buffer->capacity = capacity;
+    }
+    memcpy(buffer->data + buffer->size, data, size);
+    buffer->size += size;
+}
+
+static void put_word(struct buffer *buffer, WORD value) { put(buffer, &value, 2); }
+
+static BOOL is_description_name(const WCHAR *name)
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(description_names); i++)
+        if (!wcscmp(name, description_names[i])) return TRUE;
+    return FALSE;
+}
+
+/* an attribute's value by index, allocated */
+static HRESULT get_attribute(IWMHeaderInfo3 *info, WORD index, WCHAR **name, WMT_ATTR_DATATYPE *type, BYTE **value,
+                             DWORD *length)
+{
+    WORD name_length = 0, lang;
+    HRESULT hr;
+
+    *name = NULL;
+    *value = NULL;
+    *length = 0;
+    if (FAILED(hr = IWMHeaderInfo3_GetAttributeByIndexEx(info, 0, index, NULL, &name_length, type, &lang, NULL, length)))
+        return hr;
+    if (!(*name = calloc(name_length + 1, sizeof(WCHAR))) || !(*value = malloc(max(*length, 1))))
+    {
+        free(*name);
+        return E_OUTOFMEMORY;
+    }
+    return IWMHeaderInfo3_GetAttributeByIndexEx(info, 0, index, *name, &name_length, type, &lang, *value, length);
+}
+
+/* the Content Description and Extended Content Description objects of the store's file attributes */
+static void build_descriptions(struct editor *editor, struct buffer *out, DWORD *count)
+{
+    IWMHeaderInfo3 *info = writer_header_iface(editor->header);
+    const WCHAR *strings[ARRAY_SIZE(description_names)] = { 0 };
+    WCHAR *names[ARRAY_SIZE(description_names)] = { 0 };
+    BYTE *values[ARRAY_SIZE(description_names)] = { 0 };
+    struct buffer ecd = { 0 };
+    WORD attr_count = 0, ecd_count = 0, i, k;
+    BOOL any_description = FALSE;
+    UINT64 size;
+
+    IWMHeaderInfo3_GetAttributeCountEx(info, 0, &attr_count);
+
+    /* the extended descriptors */
+    put_word(&ecd, 0);
+    for (i = 0; i < attr_count; i++)
+    {
+        WMT_ATTR_DATATYPE type;
+        WCHAR *name;
+        BYTE *value;
+        DWORD length;
+        WORD descriptor_type, value_length, name_length;
+
+        if (FAILED(get_attribute(info, i, &name, &type, &value, &length))) continue;
+        if (is_description_name(name) && type == WMT_TYPE_STRING)
+        {
+            for (k = 0; k < ARRAY_SIZE(description_names); k++)
+                if (!wcscmp(name, description_names[k]) && !strings[k])
+                {
+                    strings[k] = (const WCHAR *)value;
+                    names[k] = name;
+                    values[k] = value;
+                    any_description = TRUE;
+                    name = NULL;
+                    value = NULL;
+                    break;
+                }
+            free(name);
+            free(value);
+            continue;
+        }
+        switch (type)
+        {
+        case WMT_TYPE_STRING: descriptor_type = 0; break;
+        case WMT_TYPE_BINARY: descriptor_type = 1; break;
+        case WMT_TYPE_BOOL:   descriptor_type = 2; break;
+        case WMT_TYPE_DWORD:  descriptor_type = 3; break;
+        case WMT_TYPE_QWORD:  descriptor_type = 4; break;
+        case WMT_TYPE_WORD:   descriptor_type = 5; break;
+        default:
+            /* GUIDs go in the metadata library object, which this editor does not write */
+            FIXME("attribute %s of type %u not written\n", debugstr_w(name), type);
+            free(name);
+            free(value);
+            continue;
+        }
+        name_length = (wcslen(name) + 1) * sizeof(WCHAR);
+        value_length = min(length, 0xffff);
+        put_word(&ecd, name_length);
+        put(&ecd, name, name_length);
+        put_word(&ecd, descriptor_type);
+        put_word(&ecd, value_length);
+        put(&ecd, value, value_length);
+        ecd_count++;
+        free(name);
+        free(value);
+    }
+    memcpy(ecd.data, &ecd_count, 2);
+
+    if (any_description)
+    {
+        WORD lengths[ARRAY_SIZE(description_names)];
+
+        size = OBJECT_SIZE + sizeof(lengths);
+        for (k = 0; k < ARRAY_SIZE(description_names); k++)
+        {
+            lengths[k] = strings[k] ? (wcslen(strings[k]) + 1) * sizeof(WCHAR) : 0;
+            size += lengths[k];
+        }
+        put(out, &asf_content_description, sizeof(GUID));
+        put(out, &size, 8);
+        put(out, lengths, sizeof(lengths));
+        for (k = 0; k < ARRAY_SIZE(description_names); k++)
+            if (strings[k]) put(out, strings[k], lengths[k]);
+        (*count)++;
+    }
+    if (ecd_count)
+    {
+        size = OBJECT_SIZE + ecd.size;
+        put(out, &asf_extended_content_description, sizeof(GUID));
+        put(out, &size, 8);
+        put(out, ecd.data, ecd.size);
+        (*count)++;
+    }
+    if (ecd.failed) out->failed = TRUE;
+    free(ecd.data);
+    for (k = 0; k < ARRAY_SIZE(description_names); k++)
+    {
+        free(names[k]);
+        free(values[k]);
+    }
+}
+
+static HRESULT WINAPI editor_Flush(IWMMetadataEditor *iface)
+{
+    struct editor *editor = impl_from_IWMMetadataEditor(iface);
+    struct buffer out = { 0 };
+    WCHAR temp[MAX_PATH + 16];
+    BYTE header[HEADER_SIZE] = { 0 }, chunk[65536];
+    DWORD count = 0, pos, i, read, written;
+    UINT64 size, file_size = 0;
+    LARGE_INTEGER at;
+    HANDLE in = INVALID_HANDLE_VALUE, outfile = INVALID_HANDLE_VALUE;
+    HRESULT hr = S_OK;
+
+    TRACE("(%p)\n", editor);
+
+    EnterCriticalSection(&editor->cs);
+    if (!editor->path)
+    {
+        LeaveCriticalSection(&editor->cs);
+        return NS_E_INVALID_REQUEST;
+    }
+
+    /* the header's objects but the two descriptions, then the new descriptions */
+    put(&out, header, sizeof(header));
+    for (i = 0, pos = 0; i < editor->object_count; i++)
+    {
+        const BYTE *object = editor->objects + pos;
+        UINT64 object_size;
+
+        memcpy(&object_size, object + 16, 8);
+        if (!IsEqualGUID((GUID *)object, &asf_content_description) &&
+            !IsEqualGUID((GUID *)object, &asf_extended_content_description))
+        {
+            put(&out, object, object_size);
+            count++;
+        }
+        pos += object_size;
+    }
+#ifndef SG_MUTANT_WMED_NO_WRITE
+    build_descriptions(editor, &out, &count);
+#endif
+    if (out.failed)
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    memcpy(out.data, &asf_header, sizeof(GUID));
+    size = out.size;
+    memcpy(out.data + 16, &size, 8);
+    memcpy(out.data + 24, &count, 4);
+    out.data[28] = 1;
+    out.data[29] = 2;
+
+    in = CreateFileW(editor->path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (in == INVALID_HANDLE_VALUE) { hr = HRESULT_FROM_WIN32(GetLastError()); goto done; }
+    GetFileSizeEx(in, (LARGE_INTEGER *)&file_size);
+    file_size = file_size - editor->header_size + out.size;
+
+    /* the File Properties Object's file size */
+    for (pos = HEADER_SIZE; pos + OBJECT_SIZE + 32 <= out.size;)
+    {
+        UINT64 object_size;
+
+        memcpy(&object_size, out.data + pos + 16, 8);
+        if (IsEqualGUID((GUID *)(out.data + pos), &asf_file_properties))
+        {
+            memcpy(out.data + pos + OBJECT_SIZE + 16, &file_size, 8);
+            break;
+        }
+        if (object_size < OBJECT_SIZE) break;
+        pos += object_size;
+    }
+
+    /* a new file beside it, then in its place */
+    swprintf(temp, ARRAY_SIZE(temp), L"%s.sgtmp", editor->path);
+    outfile = CreateFileW(temp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (outfile == INVALID_HANDLE_VALUE) { hr = HRESULT_FROM_WIN32(GetLastError()); goto done; }
+    if (!WriteFile(outfile, out.data, out.size, &written, NULL) || written != out.size)
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        goto done;
+    }
+    at.QuadPart = editor->header_size;
+    SetFilePointerEx(in, at, NULL, FILE_BEGIN);
+    while (ReadFile(in, chunk, sizeof(chunk), &read, NULL) && read)
+    {
+        if (!WriteFile(outfile, chunk, read, &written, NULL) || written != read)
+        {
+            hr = HRESULT_FROM_WIN32(GetLastError());
+            goto done;
+        }
+    }
+    CloseHandle(outfile);
+    outfile = INVALID_HANDLE_VALUE;
+    CloseHandle(in);
+    in = INVALID_HANDLE_VALUE;
+    if (!MoveFileExW(temp, editor->path, MOVEFILE_REPLACE_EXISTING))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        DeleteFileW(temp);
+        goto done;
+    }
+
+    /* the file as it is now */
+    free(editor->objects);
+    editor->objects_size = out.size - HEADER_SIZE;
+    if ((editor->objects = malloc(max(editor->objects_size, 1))))
+        memcpy(editor->objects, out.data + HEADER_SIZE, editor->objects_size);
+    else
+        editor->objects_size = 0;
+    editor->object_count = count;
+    editor->header_size = out.size;
+
+done:
+    if (outfile != INVALID_HANDLE_VALUE)
+    {
+        CloseHandle(outfile);
+        DeleteFileW(temp);
+    }
+    if (in != INVALID_HANDLE_VALUE) CloseHandle(in);
+    free(out.data);
+    LeaveCriticalSection(&editor->cs);
+    if (FAILED(hr)) WARN("%#lx\n", hr);
+    return hr;
+}
+
+static const IWMMetadataEditorVtbl editor_vtbl =
+{
+    editor_QueryInterface,
+    editor_AddRef,
+    editor_Release,
+    editor_Open,
+    editor_Close,
+    editor_Flush,
+};
+
+HRESULT WINAPI WMCreateEditor(IWMMetadataEditor **out)
+{
+    struct editor *editor;
+
+    TRACE("(%p)\n", out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(editor = calloc(1, sizeof(*editor)))) return E_OUTOFMEMORY;
+    editor->IWMMetadataEditor_iface.lpVtbl = &editor_vtbl;
+    editor->ref = 1;
+    InitializeCriticalSectionEx(&editor->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    editor->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": editor.cs");
+    if (FAILED(editor_new_header(editor)))
+    {
+        DeleteCriticalSection(&editor->cs);
+        free(editor);
+        return E_OUTOFMEMORY;
+    }
+    *out = &editor->IWMMetadataEditor_iface;
+    return S_OK;
+}
