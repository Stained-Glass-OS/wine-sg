From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] netapi32, shell32: a folder is shared from its Sharing page (Advanced Sharing, NetShareAdd)

A folder could not be shared on the network: File Explorer had no Sharing page,
and NetShareAdd, NetShareDel, NetShareEnum and NetShareGetInfo on this PC were
stubs (i0978).

As Windows has them now:

- Properties of a folder has a Sharing page (Windows' ntshrui): the folder,
  "Shared" or "Not Shared", its network path (\\COMPUTER\share), Share... and
  Advanced Sharing... Both are an administrator's: they start an elevated
  "rundll32 shell32.dll,SgShareFolder" (consent), whose Advanced Sharing dialog
  shares the folder -- Share this folder, the share name, a limit of users, a
  comment, Everyone's permission (Read, Change, Full Control) -- or stops
  sharing it; Share... shares it by its name for the people of this PC to read.
  The page then says what is so.
- netapi32's NetShareAdd (levels 2 and 502; Everyone's permission from the
  share's descriptor) and NetShareDel on this PC ask sg-admind (sg-shell), the
  Control Panel's privileged half, through its spool -- which only SYSTEM, an
  elevated program, may use, so a standard program gets ERROR_ACCESS_DENIED as
  on Windows. sg-admind makes a Samba share; its refusals are Windows' errors:
  NERR_DuplicateShare, NERR_NetNameNotFound, NERR_UnknownDevDir, and, with
  file sharing (smbd) not running, NERR_ServerNotStarted -- as Windows refuses
  with the Server service stopped. NetShareEnum and NetShareGetInfo read the
  shares back with Windows paths.

Whether smbd runs, and the firewall rule it needs, are the machine's (and
David's) decision: see net4's PROGRESS.md.

Test: test/sharing-gate.sh (a stand-in sg-admind on the gate's own spool):
what is asked, the errors, the shares read back; fails on 1192; mutant
SG_MUTANT_NO_LOCAL_SHARES (dlls/netapi32/netapi32.c). The page and Advanced
Sharing were walked in the QA VM (a share made from File Explorer, read from
the other VM, writing refused for Everyone read).
---
--- a/dlls/netapi32/netapi32.c
+++ b/dlls/netapi32/netapi32.c
@@ -643,26 +643,235 @@
     return NERR_Success;
 }
 
+/* Stained Glass OS (net4, i0978): the folders this PC shares on the network. On Windows the
+ * Server service keeps them; here Samba's smbd serves them, from a file of our own that sg-admind
+ * (sg-shell), the Control Panel's privileged half, writes for an elevated program -- as only an
+ * administrator may share a folder on Windows. NetShareAdd and NetShareDel ask sg-admind (its
+ * spool: SYSTEM alone may file a request), NetShareEnum and NetShareGetInfo read the file. With
+ * smbd not running sg-admind refuses, as the Server service stopped makes Windows refuse
+ * (NERR_ServerNotStarted). */
+#define SG_SHARES_CONF "/etc/samba/stained-glass-shares.conf"
+#ifndef SHARE_NETNAME_PARMNUM
+#define SHARE_NETNAME_PARMNUM 1
+#define SHARE_PATH_PARMNUM    8
+#endif
+
+struct sg_share
+{
+    WCHAR name[81];
+    WCHAR path[MAX_PATH];
+    WCHAR remark[257];
+    DWORD max_uses;     /* -1: unlimited */
+    BOOL  read_only;
+};
+
+static WCHAR *sg_dos_path( const char *unix_path )
+{
+    static WCHAR * (CDECL *get_dos)( const char * );
+    if (!get_dos) get_dos = (void *)GetProcAddress( GetModuleHandleW( L"kernel32" ), "wine_get_dos_file_name" );
+    return get_dos ? get_dos( unix_path ) : NULL;
+}
+
+static char *sg_unix_path( const WCHAR *dos_path )
+{
+    static char * (CDECL *get_unix)( const WCHAR * );
+    if (!get_unix) get_unix = (void *)GetProcAddress( GetModuleHandleW( L"kernel32" ), "wine_get_unix_file_name" );
+    return get_unix ? get_unix( dos_path ) : NULL;
+}
+
+/* a Unix setting (an environment variable for the gates, else the default) as a DOS path */
+static BOOL sg_env_dos( const WCHAR *var, const char *def, const char *sub, WCHAR *out, DWORD len )
+{
+    WCHAR env[MAX_PATH], *dos;
+    char unix_path[MAX_PATH * 3];
+
+    if (GetEnvironmentVariableW( var, env, ARRAY_SIZE(env) ))
+        WideCharToMultiByte( CP_UTF8, 0, env, -1, unix_path, sizeof(unix_path) - 64, NULL, NULL );
+    else lstrcpynA( unix_path, def, sizeof(unix_path) - 64 );
+    if (sub) { strcat( unix_path, "/" ); strcat( unix_path, sub ); }
+    if (!(dos = sg_dos_path( unix_path ))) return FALSE;
+    lstrcpynW( out, dos, len );
+    HeapFree( GetProcessHeap(), 0, dos );
+    return TRUE;
+}
+
+/* every share of the file */
+static unsigned int sg_shares_read( struct sg_share **shares )
+{
+    WCHAR conf[MAX_PATH];
+    struct sg_share *list = NULL, *cur = NULL;
+    unsigned int count = 0;
+    char *data, *line, *next, *eq;
+    HANDLE file;
+    DWORD size, got;
+
+    *shares = NULL;
+    if (!sg_env_dos( L"SG_SHARES_CONF", SG_SHARES_CONF, NULL, conf, ARRAY_SIZE(conf) )) return 0;
+    file = CreateFileW( conf, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return 0;
+    size = GetFileSize( file, NULL );
+    if (size == INVALID_FILE_SIZE || size > 1 << 20 || !(data = malloc( size + 1 )))
+    {
+        CloseHandle( file );
+        return 0;
+    }
+    if (!ReadFile( file, data, size, &got, NULL )) got = 0;
+    CloseHandle( file );
+    data[got] = 0;
+    for (line = data; line && *line; line = next)
+    {
+        if ((next = strchr( line, '\n' ))) *next++ = 0;
+        while (*line == ' ' || *line == '\t') line++;
+        if (*line == '[' && strchr( line, ']' ))
+        {
+            struct sg_share *grown = realloc( list, (count + 1) * sizeof(*list) );
+            if (!grown) break;
+            list = grown;
+            cur = &list[count++];
+            memset( cur, 0, sizeof(*cur) );
+            cur->max_uses = ~0u;
+            *strchr( line, ']' ) = 0;
+            MultiByteToWideChar( CP_UTF8, 0, line + 1, -1, cur->name, ARRAY_SIZE(cur->name) );
+        }
+        else if (cur && (eq = strchr( line, '=' )) && *line != '#' && *line != ';')
+        {
+            char *key = line, *value = eq + 1, *end = eq;
+            while (end > key && (end[-1] == ' ' || end[-1] == '\t')) end--;
+            *end = 0;
+            while (*value == ' ' || *value == '\t') value++;
+            if (!strcmp( key, "path" ))
+            {
+                WCHAR *dos = sg_dos_path( value );
+                if (dos) { lstrcpynW( cur->path, dos, ARRAY_SIZE(cur->path) ); HeapFree( GetProcessHeap(), 0, dos ); }
+            }
+            else if (!strcmp( key, "comment" )) MultiByteToWideChar( CP_UTF8, 0, value, -1, cur->remark, ARRAY_SIZE(cur->remark) );
+            else if (!strcmp( key, "max connections" )) cur->max_uses = atoi( value ) ? atoi( value ) : ~0u;
+            else if (!strcmp( key, "read only" )) cur->read_only = !_stricmp( value, "yes" );
+        }
+    }
+    free( data );
+    *shares = list;
+    return count;
+}
+
+/* SYSTEM or an administrator's elevated token */
+static BOOL sg_share_elevated(void)
+{
+    BYTE sid[SECURITY_MAX_SID_SIZE];
+    DWORD len = sizeof(sid);
+    BOOL admin = FALSE;
+    char buf[256];
+    HANDLE token;
+
+    if (OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+    {
+        if (GetTokenInformation( token, TokenUser, buf, sizeof(buf), &len ) &&
+            IsWellKnownSid( ((TOKEN_USER *)buf)->User.Sid, WinLocalSystemSid )) admin = TRUE;
+        CloseHandle( token );
+    }
+    len = sizeof(sid);
+    if (!admin && CreateWellKnownSid( WinBuiltinAdministratorsSid, NULL, sid, &len )) CheckTokenMembership( NULL, sid, &admin );
+    return admin;
+}
+
+/* one request to sg-admind: the fields, one per line; NERR_Success or the error its answer means */
+static NET_API_STATUS sg_admin_request( const WCHAR *const *fields, unsigned int count )
+{
+    WCHAR dir[MAX_PATH], tmp[MAX_PATH], req[MAX_PATH], rep[MAX_PATH], id[33];
+    char body[4096], answer[512];
+    BYTE rnd[16];
+    DWORD len = 0, written, start, got = 0;
+    NET_API_STATUS ret;
+    unsigned int i;
+    HANDLE file;
+
+    for (i = 0; i < count; i++)
+    {
+        int n;
+        if (wcspbrk( fields[i], L"\r\n" )) return ERROR_INVALID_PARAMETER;
+        if (!(n = WideCharToMultiByte( CP_UTF8, 0, fields[i], -1, body + len, sizeof(body) - len - 1, NULL, NULL )))
+            return ERROR_INVALID_PARAMETER;
+        len += n - 1;
+        body[len++] = '\n';
+    }
+    if (!RtlGenRandom( rnd, sizeof(rnd) )) return ERROR_GEN_FAILURE;
+    for (i = 0; i < 16; i++) swprintf( id + 2 * i, 3, L"%02x", rnd[i] );
+    if (!sg_env_dos( L"SG_ADMIN_SPOOL", "/run/stained-glass-admin", "requests", dir, ARRAY_SIZE(dir) ))
+        return NERR_ServerNotStarted;
+    swprintf( tmp, ARRAY_SIZE(tmp), L"%s\\.%s", dir, id );
+    swprintf( req, ARRAY_SIZE(req), L"%s\\%s.req", dir, id );
+    if (!sg_env_dos( L"SG_ADMIN_SPOOL", "/run/stained-glass-admin", "replies", dir, ARRAY_SIZE(dir) ))
+        return NERR_ServerNotStarted;
+    swprintf( rep, ARRAY_SIZE(rep), L"%s\\%s.rep", dir, id );
+
+    file = CreateFileW( tmp, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return sg_share_elevated() ? NERR_ServerNotStarted : ERROR_ACCESS_DENIED;
+    ret = WriteFile( file, body, len, &written, NULL ) && written == len;
+    CloseHandle( file );
+    if (!ret || !MoveFileExW( tmp, req, 0 )) { DeleteFileW( tmp ); return ERROR_GEN_FAILURE; }
+
+    for (start = GetTickCount(); GetFileAttributesW( rep ) == INVALID_FILE_ATTRIBUTES; Sleep( 100 ))
+        if (GetTickCount() - start > 60000) return ERROR_TIMEOUT;
+    file = CreateFileW( rep, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return ERROR_GEN_FAILURE;
+    if (!ReadFile( file, answer, sizeof(answer) - 1, &got, NULL )) got = 0;
+    CloseHandle( file );
+    answer[got] = 0;
+    TRACE( "%s -> %s\n", debugstr_w(fields[0]), debugstr_a(answer) );
+    if (!strncmp( answer, "OK", 2 )) return NERR_Success;
+    if (strstr( answer, "turned off" ) || strstr( answer, "not installed" )) return NERR_ServerNotStarted;
+    if (strstr( answer, "already in use" )) return NERR_DuplicateShare;
+    if (strstr( answer, "does not exist." ) && strstr( answer, "share" )) return NERR_NetNameNotFound;
+    if (strstr( answer, "folder to share does not exist" )) return NERR_UnknownDevDir;
+    if (strstr( answer, "not valid" )) return ERROR_INVALID_PARAMETER;
+    return ERROR_GEN_FAILURE;
+}
+
+/* the level-N record of a share into *bufptr (one block, strings after the record) */
+static NET_API_STATUS sg_share_info( const struct sg_share *shares, unsigned int count, DWORD level, BYTE **bufptr )
+{
+    size_t rec = level == 0 ? sizeof(SHARE_INFO_0) : level == 1 ? sizeof(SHARE_INFO_1) :
+                 level == 2 ? sizeof(SHARE_INFO_2) : sizeof(SHARE_INFO_502), size = count * rec, i;
+    WCHAR *str;
+    BYTE *buf;
+
+    for (i = 0; i < count; i++)
+        size += (wcslen( shares[i].name ) + wcslen( shares[i].path ) + wcslen( shares[i].remark ) + 3) * sizeof(WCHAR);
+    if (NetApiBufferAllocate( size ? size : sizeof(WCHAR), (void **)&buf )) return ERROR_NOT_ENOUGH_MEMORY;
+    memset( buf, 0, size ? size : sizeof(WCHAR) );
+    str = (WCHAR *)(buf + count * rec);
+#define PUT(dst, src) do { wcscpy( str, src ); dst = str; str += wcslen( src ) + 1; } while (0)
+    for (i = 0; i < count; i++)
+    {
+        const struct sg_share *s = &shares[i];
+        SHARE_INFO_502 *info = (SHARE_INFO_502 *)(buf + i * rec);   /* every level starts the same */
+
+        PUT( info->shi502_netname, s->name );
+        if (level == 0) continue;
+        info->shi502_type = STYPE_DISKTREE;
+        PUT( info->shi502_remark, s->remark );
+        if (level == 1) continue;
+        info->shi502_permissions = s->read_only ? ACCESS_READ : ACCESS_ALL;
+        info->shi502_max_uses = s->max_uses;
+        info->shi502_current_uses = 0;
+        PUT( info->shi502_path, s->path );
+        info->shi502_passwd = NULL;
+    }
+#undef PUT
+    *bufptr = buf;
+    return NERR_Success;
+}
