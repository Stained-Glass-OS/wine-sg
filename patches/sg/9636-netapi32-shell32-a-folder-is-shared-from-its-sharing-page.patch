+/* Everyone's permission from a share's descriptor: full, change or read */
+static const WCHAR *sg_share_access( PSECURITY_DESCRIPTOR sd )
+{
+    BOOL present = FALSE, defaulted;
+    ACCESS_ALLOWED_ACE *ace;
+    BYTE everyone[SECURITY_MAX_SID_SIZE];
+    DWORD len = sizeof(everyone), mask = 0, i;
+    ACL *acl = NULL;
+
+    if (!sd || !GetSecurityDescriptorDacl( sd, &present, &acl, &defaulted ) || !present || !acl) return L"read";
+    CreateWellKnownSid( WinWorldSid, NULL, everyone, &len );
+    for (i = 0; i < acl->AceCount; i++)
+        if (GetAce( acl, i, (void **)&ace ) && ace->Header.AceType == ACCESS_ALLOWED_ACE_TYPE &&
+            EqualSid( (PSID)&ace->SidStart, everyone )) mask |= ace->Mask;
+    if ((mask & GENERIC_ALL) || (mask & 0x1f01ff) == 0x1f01ff) return L"full";
+    if ((mask & (GENERIC_WRITE | FILE_WRITE_DATA))) return L"change";
+    return L"read";
 }
 
