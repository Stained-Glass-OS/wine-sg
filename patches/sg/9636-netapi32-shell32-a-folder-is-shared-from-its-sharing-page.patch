+struct folder_share
+{
+    BOOL  shared;
+    WCHAR name[81];
+    WCHAR remark[257];
+    DWORD max_uses;
+    BOOL  read_only;
+};
+
+/* the first share of a folder (NetShareEnum, level 2) */
+static BOOL find_share( const WCHAR *path, struct folder_share *out )
+{
+    share_enum_fn share_enum = (share_enum_fn)GetProcAddress( netapi(), "NetShareEnum" );
+    buffer_free_fn buffer_free = (buffer_free_fn)GetProcAddress( netapi(), "NetApiBufferFree" );
+    SHARE_INFO_2 *info = NULL;
+    DWORD read = 0, total = 0, i;
+
+    memset( out, 0, sizeof(*out) );
+    if (!share_enum || share_enum( NULL, 2, (BYTE **)&info, MAX_PREFERRED_LENGTH, &read, &total, NULL )) return FALSE;
+    for (i = 0; i < read; i++)
+    {
+        if (!info[i].shi2_path || wcsicmp( info[i].shi2_path, path )) continue;
+        out->shared = TRUE;
+        lstrcpynW( out->name, info[i].shi2_netname, ARRAY_SIZE(out->name) );
+        if (info[i].shi2_remark) lstrcpynW( out->remark, info[i].shi2_remark, ARRAY_SIZE(out->remark) );
+        out->max_uses = info[i].shi2_max_uses == ~0u ? 0 : info[i].shi2_max_uses;
+        out->read_only = !(info[i].shi2_permissions & ACCESS_WRITE);
+        break;
+    }
+    if (buffer_free && info) buffer_free( info );
+    return out->shared;
+}
+
+static void share_error( HWND hwnd, NET_API_STATUS err )
+{
+    WCHAR text[512];
+
+    switch (err)
+    {
+    case NERR_ServerNotStarted:
+        lstrcpyW( text, L"File and printer sharing is turned off on this PC, so the folder cannot be shared." ); break;
+    case NERR_DuplicateShare:
+        lstrcpyW( text, L"The share name is already in use on this PC. Choose another share name." ); break;
+    case ERROR_ACCESS_DENIED:
+        lstrcpyW( text, L"You need to be an administrator to share this folder." ); break;
+    case NERR_UnknownDevDir:
+        lstrcpyW( text, L"The folder cannot be shared: it does not exist." ); break;
+    case ERROR_INVALID_PARAMETER:
+        lstrcpyW( text, L"The share name is not valid. It cannot contain any of these characters:\n"
+                        L"\\ / [ ] : | < > + = ; , ? * \" %" ); break;
+    default:
+        swprintf( text, ARRAY_SIZE(text), L"The folder could not be shared (error %lu).", err ); break;
+    }
+    MessageBoxW( hwnd, text, L"Advanced Sharing", MB_OK | MB_ICONERROR );
+}
+
+static NET_API_STATUS add_share( const WCHAR *path, const WCHAR *name, const WCHAR *remark, DWORD max_uses,
+                                 const WCHAR *access )
+{
+    share_add_fn share_add = (share_add_fn)GetProcAddress( netapi(), "NetShareAdd" );
+    SHARE_INFO_502 info;
+    SECURITY_DESCRIPTOR sd;
+    BYTE acl_buf[256], everyone[SECURITY_MAX_SID_SIZE];
+    ACL *acl = (ACL *)acl_buf;
+    DWORD len = sizeof(everyone), mask, parm_err;
+
+    if (!share_add) return ERROR_PROC_NOT_FOUND;
+    /* Everyone's permission, as Windows' Permissions page gives it */
+    mask = !wcscmp( access, L"full" ) ? 0x1f01ff : !wcscmp( access, L"change" ) ? 0x1301bf : 0x1200a9;
+    CreateWellKnownSid( WinWorldSid, NULL, everyone, &len );
+    InitializeAcl( acl, sizeof(acl_buf), ACL_REVISION );
+    AddAccessAllowedAce( acl, ACL_REVISION, mask, everyone );
+    InitializeSecurityDescriptor( &sd, SECURITY_DESCRIPTOR_REVISION );
+    SetSecurityDescriptorDacl( &sd, TRUE, acl, FALSE );
+
+    memset( &info, 0, sizeof(info) );
+    info.shi502_netname = (WCHAR *)name;
+    info.shi502_type = STYPE_DISKTREE;
+    info.shi502_remark = (WCHAR *)remark;
+    info.shi502_permissions = ACCESS_ALL;
+    info.shi502_max_uses = max_uses ? max_uses : ~0u;
+    info.shi502_path = (WCHAR *)path;
+    info.shi502_security_descriptor = &sd;
+    return share_add( NULL, 502, (BYTE *)&info, &parm_err );
+}
+
+static NET_API_STATUS del_share( const WCHAR *name )
+{
+    share_del_fn share_del = (share_del_fn)GetProcAddress( netapi(), "NetShareDel" );
+    return share_del ? share_del( NULL, (WCHAR *)name, 0 ) : ERROR_PROC_NOT_FOUND;
+}
+
+/* ---- Advanced Sharing (elevated) ------------------------------------------------------- */
+
+struct advanced
+{
+    WCHAR path[MAX_PATH];
+    struct folder_share was;
+};
+
+static void advanced_enable( HWND hwnd )
+{
+    BOOL on = IsDlgButtonChecked( hwnd, IDC_ASHARE_ON ) == BST_CHECKED;
+    static const int ids[] = { IDC_ASHARE_NAME, IDC_ASHARE_LIMIT, IDC_ASHARE_COMMENT, IDC_ASHARE_ACCESS,
+                               IDC_ASHARE_NAME_LABEL, IDC_ASHARE_LIMIT_LABEL, IDC_ASHARE_COMMENT_LABEL,
+                               IDC_ASHARE_ACCESS_LABEL };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(ids); i++) EnableWindow( GetDlgItem( hwnd, ids[i] ), on );
+}
+
+/* what the dialog says, carried out: TRUE when done */
+static BOOL advanced_apply( HWND hwnd, struct advanced *adv )
+{
+    static const WCHAR *const access[] = { L"read", L"change", L"full" };
+    WCHAR name[81], remark[257];
+    BOOL on = IsDlgButtonChecked( hwnd, IDC_ASHARE_ON ) == BST_CHECKED;
+    DWORD max_uses = GetDlgItemInt( hwnd, IDC_ASHARE_LIMIT, NULL, FALSE );
+    int sel = SendDlgItemMessageW( hwnd, IDC_ASHARE_ACCESS, CB_GETCURSEL, 0, 0 );
+    NET_API_STATUS err;
+
+    GetDlgItemTextW( hwnd, IDC_ASHARE_NAME, name, ARRAY_SIZE(name) );
+    GetDlgItemTextW( hwnd, IDC_ASHARE_COMMENT, remark, ARRAY_SIZE(remark) );
+    if (sel < 0 || sel > 2) sel = 0;
+
+    if (adv->was.shared)
+    {
+        if (on && !wcscmp( name, adv->was.name ) && !wcscmp( remark, adv->was.remark ) &&
+            max_uses == adv->was.max_uses && (sel == 0) == adv->was.read_only) return TRUE;
+        if ((err = del_share( adv->was.name ))) { share_error( hwnd, err ); return FALSE; }
+        adv->was.shared = FALSE;
+    }
+    if (on)
+    {
+        if (!name[0]) { share_error( hwnd, ERROR_INVALID_PARAMETER ); return FALSE; }
+        if ((err = add_share( adv->path, name, remark, max_uses, access[sel] ))) { share_error( hwnd, err ); return FALSE; }
+    }
+    find_share( adv->path, &adv->was );
+    return TRUE;
+}
+
+static INT_PTR CALLBACK advanced_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    struct advanced *adv = (struct advanced *)GetWindowLongPtrW( hwnd, DWLP_USER );
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        const WCHAR *base;
+        adv = (struct advanced *)lparam;
+        SetWindowLongPtrW( hwnd, DWLP_USER, lparam );
+        base = wcsrchr( adv->path, '\\' ) ? wcsrchr( adv->path, '\\' ) + 1 : adv->path;
+        SendDlgItemMessageW( hwnd, IDC_ASHARE_ACCESS, CB_ADDSTRING, 0, (LPARAM)L"Read" );
+        SendDlgItemMessageW( hwnd, IDC_ASHARE_ACCESS, CB_ADDSTRING, 0, (LPARAM)L"Change" );
+        SendDlgItemMessageW( hwnd, IDC_ASHARE_ACCESS, CB_ADDSTRING, 0, (LPARAM)L"Full Control" );
+        SendDlgItemMessageW( hwnd, IDC_ASHARE_NAME, EM_LIMITTEXT, 80, 0 );
+        SendDlgItemMessageW( hwnd, IDC_ASHARE_COMMENT, EM_LIMITTEXT, 256, 0 );
+        CheckDlgButton( hwnd, IDC_ASHARE_ON, adv->was.shared ? BST_CHECKED : BST_UNCHECKED );
+        SetDlgItemTextW( hwnd, IDC_ASHARE_NAME, adv->was.shared ? adv->was.name : (*base ? base : L"Share") );
+        SetDlgItemInt( hwnd, IDC_ASHARE_LIMIT, adv->was.shared ? adv->was.max_uses : 0, FALSE );
+        SetDlgItemTextW( hwnd, IDC_ASHARE_COMMENT, adv->was.remark );
+        SendDlgItemMessageW( hwnd, IDC_ASHARE_ACCESS, CB_SETCURSEL, adv->was.shared && !adv->was.read_only ? 1 : 0, 0 );
+        advanced_enable( hwnd );
+        return TRUE;
+    }
+    case WM_COMMAND:
+        switch (LOWORD(wparam))
+        {
+        case IDC_ASHARE_ON:
+            advanced_enable( hwnd );
+            return TRUE;
+        case IDOK:
+            if (advanced_apply( hwnd, adv )) EndDialog( hwnd, IDOK );
+            return TRUE;
+        case 3:  /* Apply */
+            advanced_apply( hwnd, adv );
+            return TRUE;
+        case IDCANCEL:
+            EndDialog( hwnd, IDCANCEL );
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+/* "Share...": the folder by its name, for the people of this PC to read */
+static void share_simple( HWND hwnd, const WCHAR *path )
+{
+    struct folder_share share;
+    WCHAR name[81], text[600], computer[MAX_COMPUTERNAME_LENGTH + 1];
+    const WCHAR *base = wcsrchr( path, '\\' ) ? wcsrchr( path, '\\' ) + 1 : path;
+    DWORD len = ARRAY_SIZE(computer);
+    NET_API_STATUS err;
+
+    GetComputerNameW( computer, &len );
+    if (!find_share( path, &share ))
+    {
+        swprintf( text, ARRAY_SIZE(text), L"Share \"%s\" on the network? The people with an account on this PC "
+                  L"will be able to open it and read what is in it.", base );
+        if (MessageBoxW( hwnd, text, L"File Sharing", MB_OKCANCEL | MB_ICONQUESTION ) != IDOK) return;
+        lstrcpynW( name, *base ? base : L"Share", ARRAY_SIZE(name) );
+        if ((err = add_share( path, name, L"", 0, L"read" ))) { share_error( hwnd, err ); return; }
+        find_share( path, &share );
+    }
+    swprintf( text, ARRAY_SIZE(text), L"Your folder is shared.\n\n\\\\%s\\%s", computer, share.name );
+    MessageBoxW( hwnd, text, L"File Sharing", MB_OK | MB_ICONINFORMATION );
+}
+
+/*************************************************************************
+ *              SgShareFolderW   (SHELL32.@)
+ *
+ * rundll32 shell32.dll,SgShareFolder advanced|simple "PATH": the elevated half of the Sharing page.
+ */
+void WINAPI SgShareFolderW( HWND hwnd, HINSTANCE inst, LPCWSTR cmdline, int show )
+{
+    struct advanced adv;
+    const WCHAR *p = cmdline;
+    BOOL simple;
+    int len;
+
+    TRACE( "%s\n", debugstr_w(cmdline) );
+    if (!p) return;
+    while (*p == ' ') p++;
+    simple = !wcsncmp( p, L"simple", 6 );
+    while (*p && *p != ' ') p++;
+    while (*p == ' ') p++;
+    if (*p == '"') p++;
+    lstrcpynW( adv.path, p, ARRAY_SIZE(adv.path) );
+    len = lstrlenW( adv.path );
+    while (len && (adv.path[len - 1] == '"' || adv.path[len - 1] == ' ')) adv.path[--len] = 0;
+    if (!adv.path[0]) return;
+    if (simple) { share_simple( hwnd, adv.path ); return; }
+    find_share( adv.path, &adv.was );
+    DialogBoxParamW( shell32_hInstance, MAKEINTRESOURCEW(IDD_ADVANCED_SHARING), hwnd, advanced_proc, (LPARAM)&adv );
+}
+
+/* ---- the Sharing page -------------------------------------------------------------------- */
+
+struct sharing_page
+{
+    WCHAR path[MAX_PATH];
+};
+
+static void sharing_refresh( HWND hwnd, struct sharing_page *page )
+{
+    struct folder_share share;
+    WCHAR computer[MAX_COMPUTERNAME_LENGTH + 1], netpath[MAX_PATH];
+    DWORD len = ARRAY_SIZE(computer);
+    const WCHAR *base = wcsrchr( page->path, '\\' ) ? wcsrchr( page->path, '\\' ) + 1 : page->path;
+
+    GetComputerNameW( computer, &len );
+    SetDlgItemTextW( hwnd, IDC_SHARE_FOLDER, *base ? base : page->path );
+    if (find_share( page->path, &share ))
+    {
+        SetDlgItemTextW( hwnd, IDC_SHARE_STATE, L"Shared" );
+        swprintf( netpath, ARRAY_SIZE(netpath), L"\\\\%s\\%s", computer, share.name );
+        SetDlgItemTextW( hwnd, IDC_SHARE_NETPATH, netpath );
+    }
+    else
+    {
+        SetDlgItemTextW( hwnd, IDC_SHARE_STATE, L"Not Shared" );
+        SetDlgItemTextW( hwnd, IDC_SHARE_NETPATH, L"Not Shared" );
+    }
+}
+
+/* the elevated half, waited for with this window alive */
+static void sharing_run( HWND hwnd, struct sharing_page *page, const WCHAR *mode )
+{
+    SHELLEXECUTEINFOW sei = { sizeof(sei) };
+    WCHAR args[MAX_PATH + 64];
+
+    swprintf( args, ARRAY_SIZE(args), L"shell32.dll,SgShareFolder %s \"%s\"", mode, page->path );
+    sei.fMask = SEE_MASK_NOCLOSEPROCESS;
+    sei.hwnd = hwnd;
+    sei.lpVerb = L"runas";
+    sei.lpFile = L"rundll32.exe";
+    sei.lpParameters = args;
+    sei.nShow = SW_SHOWNORMAL;
+    if (!ShellExecuteExW( &sei )) return;
+    if (sei.hProcess)
+    {
+        while (MsgWaitForMultipleObjects( 1, &sei.hProcess, FALSE, INFINITE, QS_ALLINPUT ) == WAIT_OBJECT_0 + 1)
+        {
+            MSG msg;
+            while (PeekMessageW( &msg, NULL, 0, 0, PM_REMOVE ))
+            {
+                TranslateMessage( &msg );
+                DispatchMessageW( &msg );
+            }
+        }
+        CloseHandle( sei.hProcess );
+    }
+    sharing_refresh( hwnd, page );
+}
+
+static INT_PTR CALLBACK sharing_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    struct sharing_page *page = (struct sharing_page *)GetWindowLongPtrW( hwnd, DWLP_USER );
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        SHFILEINFOW info;
+        page = (struct sharing_page *)((PROPSHEETPAGEW *)lparam)->lParam;
+        SetWindowLongPtrW( hwnd, DWLP_USER, (LONG_PTR)page );
+        if (SHGetFileInfoW( page->path, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON ))
+            SendDlgItemMessageW( hwnd, IDC_SHARE_ICON, STM_SETICON, (WPARAM)info.hIcon, 0 );
+        SendDlgItemMessageW( hwnd, IDC_SHARE_ADVANCED, BCM_SETSHIELD, 0, TRUE );
+        SendDlgItemMessageW( hwnd, IDC_SHARE_SHARE, BCM_SETSHIELD, 0, TRUE );
+        sharing_refresh( hwnd, page );
+        return TRUE;
+    }
+    case WM_COMMAND:
+        if (LOWORD(wparam) == IDC_SHARE_ADVANCED) { sharing_run( hwnd, page, L"advanced" ); return TRUE; }
+        if (LOWORD(wparam) == IDC_SHARE_SHARE) { sharing_run( hwnd, page, L"simple" ); return TRUE; }
+        break;
+    }
+    return FALSE;
+}
+
+static UINT CALLBACK sharing_callback( HWND hwnd, UINT msg, PROPSHEETPAGEW *psp )
+{
+    if (msg == PSPCB_RELEASE) free( (void *)psp->lParam );
+    return 1;
+}
+
+/* a folder's Sharing page (not a drive's, not the network's or another computer's folder) */
+void add_sharing_page( const WCHAR *path, LPFNADDPROPSHEETPAGE add_page, LPARAM lparam )
+{
+    struct sharing_page *page;
+    PROPSHEETPAGEW psp;
+    HPROPSHEETPAGE hpage;
+    DWORD attrs = GetFileAttributesW( path );
+
+#ifdef SG_MUTANT_NO_SHARING_PAGE
+    return;
+#endif
+    if (attrs == INVALID_FILE_ATTRIBUTES || !(attrs & FILE_ATTRIBUTE_DIRECTORY)) return;
+    if (path[0] == '\\' && path[1] == '\\') return;
+    if (!(page = calloc( 1, sizeof(*page) ))) return;
+    lstrcpynW( page->path, path, ARRAY_SIZE(page->path) );
+    memset( &psp, 0, sizeof(psp) );
+    psp.dwSize = sizeof(psp);
+    psp.dwFlags = PSP_DEFAULT | PSP_USECALLBACK;
+    psp.hInstance = shell32_hInstance;
+    psp.pszTemplate = MAKEINTRESOURCEW(IDD_FOLDER_SHARING);
+    psp.pfnDlgProc = sharing_proc;
+    psp.pfnCallback = sharing_callback;
+    psp.lParam = (LPARAM)page;
+    if ((hpage = CreatePropertySheetPageW( &psp ))) add_page( hpage, lparam );
+    else free( page );
+}
