+typedef NET_API_STATUS (WINAPI *share_enum_fn)( LMSTR, DWORD, BYTE **, DWORD, DWORD *, DWORD *, DWORD * );
+typedef NET_API_STATUS (WINAPI *share_add_fn)( LMSTR, DWORD, BYTE *, DWORD * );
+typedef NET_API_STATUS (WINAPI *share_del_fn)( LMSTR, LMSTR, DWORD );
+typedef NET_API_STATUS (WINAPI *buffer_free_fn)( void * );
+
+static HMODULE netapi( void )
+{
+    static HMODULE module;
+    if (!module) module = LoadLibraryW( L"netapi32.dll" );
+    return module;
+}
