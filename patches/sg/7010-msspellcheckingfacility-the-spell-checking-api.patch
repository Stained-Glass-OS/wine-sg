new file mode 100644
index 0000000..a0bb592
--- /dev/null
+++ b/dlls/msspellcheckingfacility/unixlib.c
@@ -0,0 +1,340 @@
+/*
+ * msspellcheckingfacility unix side: the system's hunspell dictionaries
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dirent.h>
+#include <dlfcn.h>
+#include <iconv.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(spellcheck);
+
+/* libhunspell's C interface, loaded at run time */
+typedef struct hunhandle hunhandle;
+static void *libhunspell;
+static hunhandle * (*pHunspell_create)(const char *aff, const char *dic);
+static void (*pHunspell_destroy)(hunhandle *);
+static int (*pHunspell_spell)(hunhandle *, const char *);
+static char * (*pHunspell_get_dic_encoding)(hunhandle *);
+static int (*pHunspell_suggest)(hunhandle *, char ***, const char *);
+static void (*pHunspell_free_list)(hunhandle *, char ***, int);
+static int (*pHunspell_add)(hunhandle *, const char *);
+static int (*pHunspell_remove)(hunhandle *, const char *);
+
+static const char * const dictionary_dirs[] =
+{
+    "/usr/share/hunspell", "/usr/local/share/hunspell", "/usr/share/myspell", "/usr/share/myspell/dicts",
+};
+
+struct dictionary
+{
+    pthread_mutex_t lock;   /* a hunspell handle is not thread safe */
+    hunhandle *hun;
+    iconv_t to_dic, from_dic;   /* (iconv_t)-1 when the dictionary is UTF-8 */
+};
+
+static pthread_once_t load_once = PTHREAD_ONCE_INIT;
+
+static void load_hunspell(void)
+{
+    static const char * const names[] = { "libhunspell-1.7.so.0", "libhunspell-1.6.so.0", "libhunspell.so" };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(names) && !libhunspell; i++) libhunspell = dlopen(names[i], RTLD_NOW);
+    if (!libhunspell)
+    {
+        WARN("libhunspell not found\n");
+        return;
+    }
+#define LOAD(f) if (!(p##f = dlsym(libhunspell, #f))) { WARN("%s missing\n", #f); dlclose(libhunspell); libhunspell = NULL; return; }
+    LOAD(Hunspell_create)
+    LOAD(Hunspell_destroy)
+    LOAD(Hunspell_spell)
+    LOAD(Hunspell_get_dic_encoding)
+    LOAD(Hunspell_suggest)
+    LOAD(Hunspell_free_list)
+    LOAD(Hunspell_add)
+    LOAD(Hunspell_remove)
+#undef LOAD
+}
+
+static BOOL valid_name(const char *name)
+{
+    const char *p;
+    if (!*name || strlen(name) > 32) return FALSE;
+    for (p = name; *p; p++)
+        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || (*p >= '0' && *p <= '9') || *p == '_' || *p == '-'))
+            return FALSE;
+    return TRUE;
+}
+
+static NTSTATUS dictionary_open(void *args)
+{
+    struct dictionary_open_params *params = args;
+    char aff[512], dic[512];
+    struct dictionary *dict;
+    const char *enc;
+    unsigned int i;
+
+    params->handle = 0;
+    pthread_once(&load_once, load_hunspell);
+    if (!libhunspell) return STATUS_DLL_NOT_FOUND;
+    params->name[sizeof(params->name) - 1] = 0;
+    if (!valid_name(params->name)) return STATUS_INVALID_PARAMETER;
+
+    for (i = 0; i < ARRAY_SIZE(dictionary_dirs); i++)
+    {
+        snprintf(aff, sizeof(aff), "%s/%s.aff", dictionary_dirs[i], params->name);
+        snprintf(dic, sizeof(dic), "%s/%s.dic", dictionary_dirs[i], params->name);
+        if (!access(aff, R_OK) && !access(dic, R_OK)) break;
+    }
+    if (i == ARRAY_SIZE(dictionary_dirs)) return STATUS_NOT_FOUND;
+
+    if (!(dict = calloc(1, sizeof(*dict)))) return STATUS_NO_MEMORY;
+    if (!(dict->hun = pHunspell_create(aff, dic)))
+    {
+        free(dict);
+        return STATUS_UNSUCCESSFUL;
+    }
+    pthread_mutex_init(&dict->lock, NULL);
+    dict->to_dic = dict->from_dic = (iconv_t)-1;
+    enc = pHunspell_get_dic_encoding(dict->hun);
+    if (enc && strcasecmp(enc, "UTF-8") && strcasecmp(enc, "UTF8"))
+    {
+        dict->to_dic = iconv_open(enc, "UTF-8");
+        dict->from_dic = iconv_open("UTF-8", enc);
+    }
+    TRACE("%s: %s, encoding %s\n", params->name, dic, enc);
+    params->handle = (UINT_PTR)dict;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS dictionary_close(void *args)
+{
+    struct dictionary_close_params *params = args;
+    struct dictionary *dict = (struct dictionary *)(UINT_PTR)params->handle;
+
+    if (!dict) return STATUS_INVALID_HANDLE;
+    pHunspell_destroy(dict->hun);
+    if (dict->to_dic != (iconv_t)-1) iconv_close(dict->to_dic);
+    if (dict->from_dic != (iconv_t)-1) iconv_close(dict->from_dic);
+    pthread_mutex_destroy(&dict->lock);
+    free(dict);
+    return STATUS_SUCCESS;
+}
+
+/* convert with iconv; returns a malloc'ed string, or NULL */
+static char *convert(iconv_t cd, const char *str)
+{
+    size_t in_len = strlen(str), out_len = in_len * 4 + 4, left = out_len - 1;
+    char *in = (char *)str, *ret, *out;
+
+    if (cd == (iconv_t)-1) return strdup(str);
+    if (!(ret = out = malloc(out_len))) return NULL;
+    iconv(cd, NULL, NULL, NULL, NULL);
+    if (iconv(cd, &in, &in_len, &out, &left) == (size_t)-1)
+    {
+        free(ret);
+        return NULL;
+    }
+    *out = 0;
+    return ret;
+}
+
+static NTSTATUS dictionary_spell(void *args)
+{
+    struct dictionary_word_params *params = args;
+    struct dictionary *dict = (struct dictionary *)(UINT_PTR)params->handle;
+    char *word;
+
+    if (!dict) return STATUS_INVALID_HANDLE;
+    /* a word the dictionary's character set cannot hold is not in it */
+    params->result = 0;
+    if (!(word = convert(dict->to_dic, (const char *)(UINT_PTR)params->word))) return STATUS_SUCCESS;
+    pthread_mutex_lock(&dict->lock);
+#ifndef SG_MUTANT_SPELL_ALWAYS_RIGHT
+    params->result = pHunspell_spell(dict->hun, word) != 0;
+#else
+    params->result = 1;
+#endif
+    pthread_mutex_unlock(&dict->lock);
+    free(word);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS dictionary_change(void *args, BOOL add)
+{
+    struct dictionary_word_params *params = args;
+    struct dictionary *dict = (struct dictionary *)(UINT_PTR)params->handle;
+    char *word;
+
+    if (!dict) return STATUS_INVALID_HANDLE;
+    if (!(word = convert(dict->to_dic, (const char *)(UINT_PTR)params->word))) return STATUS_INVALID_PARAMETER;
+    pthread_mutex_lock(&dict->lock);
+    if (add) pHunspell_add(dict->hun, word);
+    else pHunspell_remove(dict->hun, word);
+    pthread_mutex_unlock(&dict->lock);
+    free(word);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS dictionary_add(void *args)
+{
+    return dictionary_change(args, TRUE);
+}
+
+static NTSTATUS dictionary_remove(void *args)
+{
+    return dictionary_change(args, FALSE);
+}
+
+/* append a string to a list being built; size counts what would be needed */
+static void list_append(struct dictionary_list_params *params, const char *str, UINT32 *used)
+{
+    UINT32 len = strlen(str) + 1;
+    char *buffer = (char *)(UINT_PTR)params->buffer;
+
+    if (buffer && *used + len <= params->size) memcpy(buffer + *used, str, len);
+    *used += len;
+    params->count++;
+}
+
+static NTSTATUS dictionary_suggest(void *args)
+{
+    struct dictionary_list_params *params = args;
+    struct dictionary *dict = (struct dictionary *)(UINT_PTR)params->handle;
+    char **list = NULL, *word, *str;
+    UINT32 used = 0;
+    int i, count;
+
+    if (!dict) return STATUS_INVALID_HANDLE;
+    params->count = 0;
+    if (!(word = convert(dict->to_dic, (const char *)(UINT_PTR)params->word)))
+    {
+        params->size = 0;
+        return STATUS_SUCCESS;
+    }
+    pthread_mutex_lock(&dict->lock);
+    count = pHunspell_suggest(dict->hun, &list, word);
+    for (i = 0; i < count; i++)
+    {
+        if (!(str = convert(dict->from_dic, list[i]))) continue;
+        list_append(params, str, &used);
+        free(str);
+    }
+    if (list) pHunspell_free_list(dict->hun, &list, count);
+    pthread_mutex_unlock(&dict->lock);
+    free(word);
+    if (params->buffer && used > params->size)
+    {
+        params->size = used;
+        return STATUS_BUFFER_TOO_SMALL;
+    }
+    params->size = used;
+    return STATUS_SUCCESS;
+}
+
+/* the dictionaries installed: "en_US", "de_DE", ... (each once) */
+static NTSTATUS dictionary_languages(void *args)
+{
+    struct dictionary_list_params *params = args;
+    char names[256][40], aff[512];
+    unsigned int i, j, n = 0;
+    struct dirent *de;
+    UINT32 used = 0;
+    DIR *dir;
+
+    params->count = 0;
+    pthread_once(&load_once, load_hunspell);
+    if (libhunspell)
+    {
+        for (i = 0; i < ARRAY_SIZE(dictionary_dirs); i++)
+        {
+            if (!(dir = opendir(dictionary_dirs[i]))) continue;
+            while ((de = readdir(dir)) && n < ARRAY_SIZE(names))
+            {
+                size_t len = strlen(de->d_name);
+                if (len < 5 || len >= sizeof(names[0]) || strcmp(de->d_name + len - 4, ".dic")) continue;
+                if (!strncmp(de->d_name, "hyph_", 5) || !strncmp(de->d_name, "th_", 3)) continue;
+                memcpy(names[n], de->d_name, len - 4);
+                names[n][len - 4] = 0;
+                if (!valid_name(names[n])) continue;
+                snprintf(aff, sizeof(aff), "%s/%s.aff", dictionary_dirs[i], names[n]);
+                if (access(aff, R_OK)) continue;
+                for (j = 0; j < n; j++) if (!strcmp(names[j], names[n])) break;
+                if (j == n) n++;
+            }
+            closedir(dir);
+        }
+    }
+    for (i = 0; i < n; i++) list_append(params, names[i], &used);
+    if (params->buffer && used > params->size)
+    {
+        params->size = used;
+        return STATUS_BUFFER_TOO_SMALL;
+    }
+    params->size = used;
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    dictionary_open,
+    dictionary_close,
+    dictionary_spell,
+    dictionary_suggest,
+    dictionary_add,
+    dictionary_remove,
+    dictionary_languages,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+/* the parameters have the same layout for 32-bit callers */
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    dictionary_open,
+    dictionary_close,
+    dictionary_spell,
+    dictionary_suggest,
+    dictionary_add,
+    dictionary_remove,
+    dictionary_languages,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif
