+/* words, exclusions and autocorrect pairs from a word list file, by its extension */
+static void load_user_file(struct spell_checker *impl, const WCHAR *path)
+{
+    const WCHAR *ext = wcsrchr(path, '.');
+    struct strings list = {0};
+    unsigned int i;
+    WCHAR *bar;
+
+    if (!ext) return;
+    read_word_file(path, &list);
+    for (i = 0; i < list.count; i++)
+    {
+        if (!wcsicmp(ext, L".dic"))
+        {
+            if (strings_find(&impl->added, list.str[i], -1, FALSE) >= 0) continue;
+            strings_add(&impl->added, list.str[i]);
+            dictionary_word(impl, unix_dictionary_add, list.str[i]);
+        }
+        else if (!wcsicmp(ext, L".exc"))
+            strings_add(&impl->excluded, list.str[i]);
+        else if (!wcsicmp(ext, L".acl") && (bar = wcschr(list.str[i], '|')) && bar[1])
+        {
+            *bar = 0;
+            strings_add(&impl->correct_from, list.str[i]);
+            strings_add(&impl->correct_to, bar + 1);
+        }
+    }
+    strings_free(&list);
+}
+
+static HRESULT create_spell_checker(const WCHAR *tag, ISpellChecker **out)
+{
+    struct dictionary_open_params params = {0};
+    static const WCHAR * const defaults[] = { L"default.dic", L"default.exc", L"default.acl" };
+    struct spell_checker *impl;
+    WCHAR appdata[MAX_PATH], path[MAX_PATH];
+    unsigned int i;
+    NTSTATUS status;
+
+    WideCharToMultiByte(CP_UTF8, 0, tag, -1, params.name, sizeof(params.name) - 1, NULL, NULL);
+    for (i = 0; params.name[i]; i++) if (params.name[i] == '-') params.name[i] = '_';
+    if ((status = WINE_UNIX_CALL(unix_dictionary_open, &params)))
+    {
+        WARN("no dictionary for %s: %#lx\n", debugstr_w(tag), status);
+        return E_INVALIDARG;
+    }
+
+    if (!(impl = calloc(1, sizeof(*impl))))
+    {
+        struct dictionary_close_params close = { params.handle };
+        WINE_UNIX_CALL(unix_dictionary_close, &close);
+        return E_OUTOFMEMORY;
+    }
+    impl->ISpellChecker2_iface.lpVtbl = &spell_checker_vtbl;
+    impl->ref = 1;
+    impl->dict = params.handle;
+    InitializeCriticalSection(&impl->cs);
+    lstrcpynW(impl->tag, tag, ARRAY_SIZE(impl->tag));
+
+    if (SUCCEEDED(SHGetFolderPathW(NULL, CSIDL_APPDATA, NULL, SHGFP_TYPE_CURRENT, appdata)))
+    {
+        swprintf(impl->folder, ARRAY_SIZE(impl->folder), L"%s\\Microsoft\\Spelling\\%s", appdata, impl->tag);
+        for (i = 0; i < ARRAY_SIZE(defaults); i++)
+        {
+            swprintf(path, ARRAY_SIZE(path), L"%s\\%s", impl->folder, defaults[i]);
+            load_user_file(impl, path);
+        }
+    }
+    EnterCriticalSection(&registry_cs);
+    for (i = 0; i < registered_paths.count; i++)
+        if (!wcsicmp(registered_tags.str[i], impl->tag)) load_user_file(impl, registered_paths.str[i]);
+    LeaveCriticalSection(&registry_cs);
+
+    TRACE("%s: %p\n", debugstr_w(tag), impl);
+    *out = (ISpellChecker *)&impl->ISpellChecker2_iface;
+    return S_OK;
+}
+
+/* ISpellCheckerFactory and IUserDictionariesRegistrar */
+struct factory
+{
+    ISpellCheckerFactory ISpellCheckerFactory_iface;
+    IUserDictionariesRegistrar IUserDictionariesRegistrar_iface;
+    LONG ref;
+};
+
+static inline struct factory *impl_from_ISpellCheckerFactory(ISpellCheckerFactory *iface)
+{
+    return CONTAINING_RECORD(iface, struct factory, ISpellCheckerFactory_iface);
+}
+
+static inline struct factory *impl_from_IUserDictionariesRegistrar(IUserDictionariesRegistrar *iface)
+{
+    return CONTAINING_RECORD(iface, struct factory, IUserDictionariesRegistrar_iface);
+}
+
+static HRESULT WINAPI factory_QueryInterface(ISpellCheckerFactory *iface, REFIID iid, void **out)
+{
+    struct factory *impl = impl_from_ISpellCheckerFactory(iface);
+
+    TRACE("(%p, %s, %p)\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_ISpellCheckerFactory))
+        *out = &impl->ISpellCheckerFactory_iface;
+    else if (IsEqualIID(iid, &IID_IUserDictionariesRegistrar))
+        *out = &impl->IUserDictionariesRegistrar_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef(ISpellCheckerFactory *iface)
+{
+    return InterlockedIncrement(&impl_from_ISpellCheckerFactory(iface)->ref);
+}
+
+static ULONG WINAPI factory_Release(ISpellCheckerFactory *iface)
+{
+    struct factory *impl = impl_from_ISpellCheckerFactory(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref) free(impl);
+    return ref;
+}
+
+static HRESULT WINAPI factory_get_SupportedLanguages(ISpellCheckerFactory *iface, IEnumString **val)
+{
+    struct strings tags = {0};
+    HRESULT hr;
+
+    TRACE("(%p, %p)\n", iface, val);
+
+    if (!val) return E_POINTER;
+    if (SUCCEEDED(hr = installed_languages(&tags))) hr = create_string_enum(&tags, val);
+    strings_free(&tags);
+    return hr;
+}
+
+static HRESULT WINAPI factory_IsSupported(ISpellCheckerFactory *iface, LPCWSTR tag, BOOL *val)
+{
+    struct strings tags = {0};
+    HRESULT hr;
+
+    TRACE("(%p, %s, %p)\n", iface, debugstr_w(tag), val);
+
+    if (!tag || !val) return E_POINTER;
+    if (!*tag) return E_INVALIDARG;
+    if (SUCCEEDED(hr = installed_languages(&tags))) *val = find_language(&tags, tag) >= 0;
+    strings_free(&tags);
+    return hr;
+}
+
+static HRESULT WINAPI factory_CreateSpellChecker(ISpellCheckerFactory *iface, LPCWSTR tag, ISpellChecker **val)
+{
+    struct strings tags = {0};
+    HRESULT hr;
+    int i;
+
+    TRACE("(%p, %s, %p)\n", iface, debugstr_w(tag), val);
+
+    if (!tag || !val) return E_POINTER;
+    *val = NULL;
+    if (!*tag) return E_INVALIDARG;
+    if (FAILED(hr = installed_languages(&tags))) return hr;
+    if ((i = find_language(&tags, tag)) < 0) hr = E_INVALIDARG;
+    else hr = create_spell_checker(tags.str[i], val);
+    strings_free(&tags);
+    return hr;
+}
+
+static const ISpellCheckerFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_get_SupportedLanguages,
+    factory_IsSupported,
+    factory_CreateSpellChecker,
+};
+
+static HRESULT WINAPI registrar_QueryInterface(IUserDictionariesRegistrar *iface, REFIID iid, void **out)
+{
+    struct factory *impl = impl_from_IUserDictionariesRegistrar(iface);
+    return factory_QueryInterface(&impl->ISpellCheckerFactory_iface, iid, out);
+}
+
+static ULONG WINAPI registrar_AddRef(IUserDictionariesRegistrar *iface)
+{
+    struct factory *impl = impl_from_IUserDictionariesRegistrar(iface);
+    return factory_AddRef(&impl->ISpellCheckerFactory_iface);
+}
+
+static ULONG WINAPI registrar_Release(IUserDictionariesRegistrar *iface)
+{
+    struct factory *impl = impl_from_IUserDictionariesRegistrar(iface);
+    return factory_Release(&impl->ISpellCheckerFactory_iface);
+}
+
+static BOOL valid_user_file(const WCHAR *path)
+{
+    const WCHAR *ext = wcsrchr(path, '.');
+    return ext && (!wcsicmp(ext, L".dic") || !wcsicmp(ext, L".exc") || !wcsicmp(ext, L".acl"));
+}
+
+static HRESULT WINAPI registrar_RegisterUserDictionary(IUserDictionariesRegistrar *iface, LPCWSTR path, LPCWSTR tag)
+{
+    WCHAR full[MAX_PATH];
+
+    TRACE("(%p, %s, %s)\n", iface, debugstr_w(path), debugstr_w(tag));
+
+    if (!path || !tag) return E_POINTER;
+    if (!*tag || !valid_user_file(path) || !GetFullPathNameW(path, ARRAY_SIZE(full), full, NULL)) return E_INVALIDARG;
+    EnterCriticalSection(&registry_cs);
+    strings_add(&registered_paths, full);
+    strings_add(&registered_tags, tag);
+    LeaveCriticalSection(&registry_cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI registrar_UnregisterUserDictionary(IUserDictionariesRegistrar *iface, LPCWSTR path, LPCWSTR tag)
+{
+    WCHAR full[MAX_PATH];
+    unsigned int i;
+    HRESULT hr = E_INVALIDARG;
+
+    TRACE("(%p, %s, %s)\n", iface, debugstr_w(path), debugstr_w(tag));
+
+    if (!path || !tag) return E_POINTER;
+    if (!GetFullPathNameW(path, ARRAY_SIZE(full), full, NULL)) return E_INVALIDARG;
+    EnterCriticalSection(&registry_cs);
+    for (i = 0; i < registered_paths.count; i++)
+    {
+        if (wcsicmp(registered_paths.str[i], full) || wcsicmp(registered_tags.str[i], tag)) continue;
+        strings_remove(&registered_paths, i);
+        strings_remove(&registered_tags, i);
+        hr = S_OK;
+        break;
+    }
+    LeaveCriticalSection(&registry_cs);
+    return hr;
+}
+
+static const IUserDictionariesRegistrarVtbl registrar_vtbl =
+{
+    registrar_QueryInterface,
+    registrar_AddRef,
+    registrar_Release,
+    registrar_RegisterUserDictionary,
+    registrar_UnregisterUserDictionary,
+};
+
+/* class factory */
+static HRESULT WINAPI class_factory_QueryInterface(IClassFactory *iface, REFIID iid, void **out)
+{
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IClassFactory))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI class_factory_AddRef(IClassFactory *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI class_factory_Release(IClassFactory *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI class_factory_CreateInstance(IClassFactory *iface, IUnknown *outer, REFIID iid, void **out)
+{
+    struct factory *impl;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %s, %p)\n", iface, outer, debugstr_guid(iid), out);
+
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->ISpellCheckerFactory_iface.lpVtbl = &factory_vtbl;
+    impl->IUserDictionariesRegistrar_iface.lpVtbl = &registrar_vtbl;
+    impl->ref = 1;
+    hr = factory_QueryInterface(&impl->ISpellCheckerFactory_iface, iid, out);
+    factory_Release(&impl->ISpellCheckerFactory_iface);
+    return hr;
+}
+
+static HRESULT WINAPI class_factory_LockServer(IClassFactory *iface, BOOL lock)
+{
+    return S_OK;
+}
+
+static const IClassFactoryVtbl class_factory_vtbl =
+{
+    class_factory_QueryInterface,
+    class_factory_AddRef,
+    class_factory_Release,
+    class_factory_CreateInstance,
+    class_factory_LockServer,
+};
+
+static IClassFactory class_factory = { &class_factory_vtbl };
+
+HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID iid, void **out)
+{
+    TRACE("(%s, %s, %p)\n", debugstr_guid(clsid), debugstr_guid(iid), out);
+
+    if (IsEqualCLSID(clsid, &CLSID_SpellCheckerFactory))
+        return IClassFactory_QueryInterface(&class_factory, iid, out);
+    *out = NULL;
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
+
+BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls(instance);
+        unix_ok = !__wine_init_unix_call();
+    }
+    return TRUE;
+}
