+static HRESULT WINAPI spell_checker_ComprehensiveCheck(ISpellChecker2 *iface, LPCWSTR text, IEnumSpellingError **val)
+{
+    TRACE("(%p, %s, %p)\n", iface, debugstr_w(text), val);
+    return check_text(impl_from_ISpellChecker2(iface), text, val);
+}
+
+static HRESULT WINAPI spell_checker_Remove(ISpellChecker2 *iface, LPCWSTR word)
+{
+    struct spell_checker *impl = impl_from_ISpellChecker2(iface);
+    WCHAR path[MAX_PATH];
+    struct strings list = {0};
+    BOOL changed = FALSE;
+    int i;
+
+    TRACE("(%p, %s)\n", iface, debugstr_w(word));
+
+    if (!word || !*word) return E_INVALIDARG;
+    EnterCriticalSection(&impl->cs);
+    if ((i = strings_find(&impl->ignored, word, -1, FALSE)) >= 0)
+    {
+        strings_remove(&impl->ignored, i);
+        changed = TRUE;
+    }
+    if ((i = strings_find(&impl->added, word, -1, FALSE)) >= 0)
+    {
+        strings_remove(&impl->added, i);
+        dictionary_word(impl, unix_dictionary_remove, word);
+        changed = TRUE;
+        if (*impl->folder)
+        {
+            swprintf(path, ARRAY_SIZE(path), L"%s\\default.dic", impl->folder);
+            read_word_file(path, &list);
+            while ((i = strings_find(&list, word, -1, FALSE)) >= 0) strings_remove(&list, i);
+            write_word_file(path, &list);
+            strings_free(&list);
+        }
+    }
+    LeaveCriticalSection(&impl->cs);
+    if (changed) fire_changed(impl);
+    return S_OK;
+}
