+static HRESULT WINAPI spell_checker_get_LanguageTag(ISpellChecker2 *iface, LPWSTR *val)
+{
+    return return_string(impl_from_ISpellChecker2(iface)->tag, val);
+}
+
+static BOOL is_word_char(WCHAR c)
+{
+    return iswalpha(c) || iswdigit(c) || (c >= 0x300 && c <= 0x36f);
+}
+
+static BOOL is_apostrophe(WCHAR c)
+{
+    return c == '\'' || c == 0x2019;
+}
+
+/* a run of characters between spaces that names something rather than being prose */
+static BOOL skip_chunk(const WCHAR *start, const WCHAR *end)
+{
+    const WCHAR *p;
+    for (p = start; p < end; p++)
+    {
+        if (*p == '@' || *p == '\\' || *p == '/' || *p == '_') return TRUE;
+        if (*p == ':' && p + 2 < end && p[1] == '/' && p[2] == '/') return TRUE;
+    }
+    return FALSE;
+}
+
+static HRESULT check_text(struct spell_checker *impl, const WCHAR *text, IEnumSpellingError **val)
+{
+    const WCHAR *p = text, *word, *chunk_end, *prev = NULL;
+    struct error_enum *errors;
+    int prev_len = 0, len, i;
+    BOOL digits, only_space;
+
+    if (!val) return E_POINTER;
+    *val = NULL;
+    if (!text) return E_POINTER;
+    if (!(errors = calloc(1, sizeof(*errors)))) return E_OUTOFMEMORY;
+    errors->IEnumSpellingError_iface.lpVtbl = &error_enum_vtbl;
+    errors->ref = 1;
+
+    EnterCriticalSection(&impl->cs);
+    while (*p)
+    {
+        if (!is_word_char(*p))
+        {
+            if (!iswspace(*p)) prev = NULL;   /* punctuation ends a repetition */
+            p++;
+            continue;
+        }
+        /* the chunk this word is in */
+        for (chunk_end = p; *chunk_end && !iswspace(*chunk_end); chunk_end++);
+        {
+            const WCHAR *chunk_start = p;
+            while (chunk_start > text && !iswspace(chunk_start[-1])) chunk_start--;
+            if (skip_chunk(chunk_start, chunk_end))
+            {
+                p = chunk_end;
+                prev = NULL;
+                continue;
+            }
+        }
+
+        word = p;
+        digits = FALSE;
+        while (*p && (is_word_char(*p) || (is_apostrophe(*p) && p > word && is_word_char(p[1]))))
+        {
+            if (iswdigit(*p)) digits = TRUE;
+            p++;
+        }
+        len = p - word;
+        if (digits)
+        {
+            prev = NULL;
+            continue;
+        }
+
+        if (strings_find(&impl->ignored, word, len, FALSE) >= 0 || strings_find(&impl->added, word, len, FALSE) >= 0)
+            ;
+        else if ((i = strings_find(&impl->correct_from, word, len, FALSE)) >= 0)
+            error_enum_add(errors, word - text, len, CORRECTIVE_ACTION_REPLACE, impl->correct_to.str[i]);
+        else if (strings_find(&impl->excluded, word, len, TRUE) >= 0 || !dictionary_spell(impl, word, len))
+            error_enum_add(errors, word - text, len, CORRECTIVE_ACTION_GET_SUGGESTIONS, NULL);
+        else if (prev && prev_len == len && !wcsnicmp(prev, word, len))
+        {
+            /* "the the": the second one goes */
+            for (only_space = TRUE, i = prev_len; prev + i < word; i++) if (!iswspace(prev[i])) only_space = FALSE;
+            if (only_space) error_enum_add(errors, word - text, len, CORRECTIVE_ACTION_DELETE, NULL);
+        }
+        prev = word;
+        prev_len = len;
+    }
+    LeaveCriticalSection(&impl->cs);
+
+    *val = &errors->IEnumSpellingError_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI spell_checker_Check(ISpellChecker2 *iface, LPCWSTR text, IEnumSpellingError **val)
+{
+    TRACE("(%p, %s, %p)\n", iface, debugstr_w(text), val);
+    return check_text(impl_from_ISpellChecker2(iface), text, val);
+}
+
+static HRESULT WINAPI spell_checker_Suggest(ISpellChecker2 *iface, LPCWSTR word, IEnumString **val)
+{
+    struct spell_checker *impl = impl_from_ISpellChecker2(iface);
+    struct dictionary_list_params params = {0};
+    struct strings list = {0};
+    char *utf8, *buffer, *p;
+    WCHAR suggestion[256];
+    unsigned int i;
+    HRESULT hr;
+    int index;
+
+    TRACE("(%p, %s, %p)\n", iface, debugstr_w(word), val);
+
+    if (!val) return E_POINTER;
+    *val = NULL;
+    if (!word || !*word) return E_INVALIDARG;
+
+    EnterCriticalSection(&impl->cs);
+    if ((index = strings_find(&impl->correct_from, word, -1, FALSE)) >= 0)
+        strings_add(&list, impl->correct_to.str[index]);
+    else if (strings_find(&impl->ignored, word, -1, FALSE) >= 0 || strings_find(&impl->added, word, -1, FALSE) >= 0 ||
+             (strings_find(&impl->excluded, word, -1, TRUE) < 0 && dictionary_spell(impl, word, -1)))
+    {
+        /* spelled right: the word itself */
+        LeaveCriticalSection(&impl->cs);
+        strings_add(&list, word);
+        hr = create_string_enum(&list, val);
+        strings_free(&list);
+        return FAILED(hr) ? hr : S_FALSE;
+    }
+    LeaveCriticalSection(&impl->cs);
+
+    if (!list.count && (utf8 = utf8_from_wide(word, -1)))
+    {
+        params.handle = impl->dict;
+        params.word = (UINT_PTR)utf8;
+        if (!WINE_UNIX_CALL(unix_dictionary_suggest, &params) && params.size && (buffer = malloc(params.size)))
+        {
+            params.buffer = (UINT_PTR)buffer;
+            params.count = 0;
+            if (!WINE_UNIX_CALL(unix_dictionary_suggest, &params))
+            {
+                for (i = 0, p = buffer; i < params.count; i++, p += strlen(p) + 1)
+                {
+                    MultiByteToWideChar(CP_UTF8, 0, p, -1, suggestion, ARRAY_SIZE(suggestion));
+                    suggestion[ARRAY_SIZE(suggestion) - 1] = 0;
+                    if (strings_find(&impl->excluded, suggestion, -1, TRUE) < 0) strings_add(&list, suggestion);
+                }
+            }
+            free(buffer);
+        }
+        free(utf8);
+    }
+    hr = create_string_enum(&list, val);
+    strings_free(&list);
+    return hr;
+}
+
+static void ensure_folder(struct spell_checker *impl)
+{
+    WCHAR path[MAX_PATH], *p;
+
+    lstrcpynW(path, impl->folder, ARRAY_SIZE(path));
+    for (p = path + 3; *p; p++)
+    {
+        if (*p != '\\') continue;
+        *p = 0;
+        CreateDirectoryW(path, NULL);
+        *p = '\\';
+    }
+    CreateDirectoryW(path, NULL);
+}
+
+static HRESULT WINAPI spell_checker_Add(ISpellChecker2 *iface, LPCWSTR word)
+{
+    struct spell_checker *impl = impl_from_ISpellChecker2(iface);
+    WCHAR path[MAX_PATH];
+    int i;
+
+    TRACE("(%p, %s)\n", iface, debugstr_w(word));
+
+    if (!word || !*word) return E_INVALIDARG;
+    EnterCriticalSection(&impl->cs);
+    if ((i = strings_find(&impl->excluded, word, -1, TRUE)) >= 0) strings_remove(&impl->excluded, i);
+    if (strings_find(&impl->added, word, -1, FALSE) < 0)
+    {
+        strings_add(&impl->added, word);
+        dictionary_word(impl, unix_dictionary_add, word);
+        if (*impl->folder)
+        {
+            ensure_folder(impl);
+            swprintf(path, ARRAY_SIZE(path), L"%s\\default.dic", impl->folder);
+            append_word_file(path, word);
+        }
+    }
+    LeaveCriticalSection(&impl->cs);
+    fire_changed(impl);
+    return S_OK;
+}
+
+static HRESULT WINAPI spell_checker_Ignore(ISpellChecker2 *iface, LPCWSTR word)
+{
+    struct spell_checker *impl = impl_from_ISpellChecker2(iface);
+
+    TRACE("(%p, %s)\n", iface, debugstr_w(word));
+
+    if (!word || !*word) return E_INVALIDARG;
+    EnterCriticalSection(&impl->cs);
+    if (strings_find(&impl->ignored, word, -1, FALSE) < 0) strings_add(&impl->ignored, word);
+    LeaveCriticalSection(&impl->cs);
+    fire_changed(impl);
+    return S_OK;
+}
+
+static HRESULT WINAPI spell_checker_AutoCorrect(ISpellChecker2 *iface, LPCWSTR from, LPCWSTR to)
+{
+    struct spell_checker *impl = impl_from_ISpellChecker2(iface);
+    WCHAR path[MAX_PATH], line[512];
+    int i;
+
+    TRACE("(%p, %s, %s)\n", iface, debugstr_w(from), debugstr_w(to));
+
+    if (!from || !*from || !to || !*to) return E_INVALIDARG;
+    EnterCriticalSection(&impl->cs);
+    if ((i = strings_find(&impl->correct_from, from, -1, FALSE)) >= 0)
+    {
+        free(impl->correct_to.str[i]);
+        impl->correct_to.str[i] = strdupW(to);
+    }
+    else
+    {
+        strings_add(&impl->correct_from, from);
+        strings_add(&impl->correct_to, to);
+    }
+    if (*impl->folder && wcslen(from) + wcslen(to) + 2 < ARRAY_SIZE(line))
+    {
+        ensure_folder(impl);
+        swprintf(path, ARRAY_SIZE(path), L"%s\\default.acl", impl->folder);
+        swprintf(line, ARRAY_SIZE(line), L"%s|%s", from, to);
+        append_word_file(path, line);
+    }
+    LeaveCriticalSection(&impl->cs);
+    fire_changed(impl);
+    return S_OK;
+}
