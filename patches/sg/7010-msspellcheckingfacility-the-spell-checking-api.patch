+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/unixlib.h"
+
+/* Pointers travel as UINT64 so that 32-bit and 64-bit callers share one layout.
+ * Words and lists are UTF-8; a list is NUL-terminated strings one after another. */
+
+struct dictionary_open_params
+{
+    char name[64];      /* dictionary name, "en_US" */
+    UINT64 handle;      /* out */
+};
+
+struct dictionary_close_params
+{
+    UINT64 handle;
+};
+
+struct dictionary_word_params
+{
+    UINT64 handle;
+    UINT64 word;        /* const char * */
+    UINT32 result;      /* spell: 1 if the word is right */
+    UINT32 pad;
+};
+
+struct dictionary_list_params
+{
+    UINT64 handle;      /* suggest: the dictionary; languages: unused */
+    UINT64 word;        /* suggest: the word */
+    UINT64 buffer;      /* char *, may be 0 to ask for the size */
+    UINT32 size;        /* in: buffer size; out: size needed */
+    UINT32 count;       /* out: number of strings */
+};
+
+enum unix_funcs
+{
+    unix_dictionary_open,
+    unix_dictionary_close,
+    unix_dictionary_spell,
+    unix_dictionary_suggest,
+    unix_dictionary_add,
+    unix_dictionary_remove,
+    unix_dictionary_languages,
+    unix_funcs_count,
+};
