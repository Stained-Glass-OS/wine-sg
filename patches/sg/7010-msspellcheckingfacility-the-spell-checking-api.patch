+static HRESULT WINAPI spell_checker_add_SpellCheckerChanged(ISpellChecker2 *iface,
+        ISpellCheckerChangedEventHandler *handler, DWORD *cookie)
+{
+    struct spell_checker *impl = impl_from_ISpellChecker2(iface);
+    unsigned int i;
+
+    TRACE("(%p, %p, %p)\n", iface, handler, cookie);
+
+    if (!handler || !cookie) return E_POINTER;
+    EnterCriticalSection(&impl->cs);
+    for (i = 0; i < MAX_HANDLERS; i++) if (!impl->handlers[i]) break;
+    if (i < MAX_HANDLERS) ISpellCheckerChangedEventHandler_AddRef((impl->handlers[i] = handler));
+    LeaveCriticalSection(&impl->cs);
+    if (i == MAX_HANDLERS) return E_OUTOFMEMORY;
+    *cookie = i + 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI spell_checker_remove_SpellCheckerChanged(ISpellChecker2 *iface, DWORD cookie)
+{
+    struct spell_checker *impl = impl_from_ISpellChecker2(iface);
+    ISpellCheckerChangedEventHandler *handler = NULL;
+
+    TRACE("(%p, %lu)\n", iface, cookie);
+
+    EnterCriticalSection(&impl->cs);
+    if (cookie && cookie <= MAX_HANDLERS)
+    {
+        handler = impl->handlers[cookie - 1];
+        impl->handlers[cookie - 1] = NULL;
+    }
+    LeaveCriticalSection(&impl->cs);
+    if (!handler) return E_INVALIDARG;
+    ISpellCheckerChangedEventHandler_Release(handler);
+    return S_OK;
+}
