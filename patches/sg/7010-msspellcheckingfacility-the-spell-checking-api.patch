+++ b/dlls/msspellcheckingfacility/main.c
@@ -0,0 +1,1382 @@
+/*
+ * Spell Checking API (ISpellCheckerFactory) over the system's hunspell dictionaries
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Languages are the hunspell dictionaries installed on the system (/usr/share/hunspell,
+ * "en_US.dic" is "en-US").  A user's own word lists live where the documentation puts them,
+ * %APPDATA%\Microsoft\Spelling\<language>\default.dic (added words), default.exc (excluded
+ * words) and default.acl (autocorrect pairs, "from|to"), UTF-16 with a byte order mark, one
+ * entry a line; IUserDictionariesRegistrar adds more such files.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <wchar.h>
+#include <wctype.h>
+
+#define COBJMACROS
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "objbase.h"
+#include "shlobj.h"
+#include "initguid.h"
+#include "spellcheck.h"
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(spellcheck);
+
+static BOOL unix_ok;
+
+static WCHAR *strdupW(const WCHAR *str)
+{
+    size_t len = (wcslen(str) + 1) * sizeof(WCHAR);
+    WCHAR *ret = malloc(len);
+    if (ret) memcpy(ret, str, len);
+    return ret;
+}
+
+static HRESULT return_string(const WCHAR *str, WCHAR **out)
+{
+    size_t len = (wcslen(str) + 1) * sizeof(WCHAR);
+    if (!out) return E_POINTER;
+    if (!(*out = CoTaskMemAlloc(len))) return E_OUTOFMEMORY;
+    memcpy(*out, str, len);
+    return S_OK;
+}
+
+static char *utf8_from_wide(const WCHAR *str, int len)
+{
+    int size = WideCharToMultiByte(CP_UTF8, 0, str, len, NULL, 0, NULL, NULL);
+    char *ret = malloc(size + 1);
+    if (!ret) return NULL;
+    WideCharToMultiByte(CP_UTF8, 0, str, len, ret, size, NULL, NULL);
+    ret[size] = 0;
+    return ret;
+}
+
+/* a list of strings */
+struct strings
+{
+    WCHAR **str;
+    unsigned int count, size;
+};
+
+static BOOL strings_add(struct strings *list, const WCHAR *str)
+{
+    WCHAR **tmp;
+    if (list->count == list->size)
+    {
+        unsigned int size = list->size ? list->size * 2 : 16;
+        if (!(tmp = realloc(list->str, size * sizeof(*tmp)))) return FALSE;
+        list->str = tmp;
+        list->size = size;
+    }
+    if (!(list->str[list->count] = strdupW(str))) return FALSE;
+    list->count++;
+    return TRUE;
+}
+
+static int strings_find(const struct strings *list, const WCHAR *str, int len, BOOL nocase)
+{
+    unsigned int i;
+    for (i = 0; i < list->count; i++)
+    {
+        if (len < 0 ? wcscmp(list->str[i], str) && (!nocase || wcsicmp(list->str[i], str)) :
+            (wcslen(list->str[i]) != len || (nocase ? wcsnicmp(list->str[i], str, len) : wcsncmp(list->str[i], str, len))))
+            continue;
+        return i;
+    }
+    return -1;
+}
+
+static void strings_remove(struct strings *list, unsigned int i)
+{
+    free(list->str[i]);
+    memmove(&list->str[i], &list->str[i + 1], (list->count - i - 1) * sizeof(*list->str));
+    list->count--;
+}
+
+static void strings_free(struct strings *list)
+{
+    while (list->count) free(list->str[--list->count]);
+    free(list->str);
+    list->str = NULL;
+    list->size = 0;
+}
+
+/* IEnumString over a copy of a list */
+struct string_enum
+{
+    IEnumString IEnumString_iface;
+    LONG ref;
+    struct strings list;
+    ULONG pos;
+};
+
+static inline struct string_enum *impl_from_IEnumString(IEnumString *iface)
+{
+    return CONTAINING_RECORD(iface, struct string_enum, IEnumString_iface);
+}
+
+static HRESULT WINAPI string_enum_QueryInterface(IEnumString *iface, REFIID iid, void **out)
+{
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IEnumString))
+    {
+        IEnumString_AddRef((IEnumString *)(*out = iface));
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI string_enum_AddRef(IEnumString *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumString(iface)->ref);
+}
+
+static ULONG WINAPI string_enum_Release(IEnumString *iface)
+{
+    struct string_enum *impl = impl_from_IEnumString(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref)
+    {
+        strings_free(&impl->list);
+        free(impl);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI string_enum_Next(IEnumString *iface, ULONG count, LPOLESTR *out, ULONG *fetched)
+{
+    struct string_enum *impl = impl_from_IEnumString(iface);
+    ULONG n = 0;
+
+    if (!out) return E_POINTER;
+    if (count > 1 && !fetched) return E_INVALIDARG;
+    while (n < count && impl->pos < impl->list.count)
+    {
+        if (FAILED(return_string(impl->list.str[impl->pos], &out[n])))
+        {
+            while (n) CoTaskMemFree(out[--n]);
+            return E_OUTOFMEMORY;
+        }
+        impl->pos++;
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI string_enum_Skip(IEnumString *iface, ULONG count)
+{
+    struct string_enum *impl = impl_from_IEnumString(iface);
+    if (count > impl->list.count - impl->pos)
+    {
+        impl->pos = impl->list.count;
+        return S_FALSE;
+    }
+    impl->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI string_enum_Reset(IEnumString *iface)
+{
+    impl_from_IEnumString(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_string_enum(const struct strings *list, IEnumString **out);
+
+static HRESULT WINAPI string_enum_Clone(IEnumString *iface, IEnumString **out)
+{
+    struct string_enum *impl = impl_from_IEnumString(iface);
+    HRESULT hr;
+    if (SUCCEEDED(hr = create_string_enum(&impl->list, out)))
+        impl_from_IEnumString(*out)->pos = impl->pos;
+    return hr;
+}
+
+static const IEnumStringVtbl string_enum_vtbl =
+{
+    string_enum_QueryInterface,
+    string_enum_AddRef,
+    string_enum_Release,
+    string_enum_Next,
+    string_enum_Skip,
+    string_enum_Reset,
+    string_enum_Clone,
+};
+
+static HRESULT create_string_enum(const struct strings *list, IEnumString **out)
+{
+    struct string_enum *impl;
+    unsigned int i;
+
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->IEnumString_iface.lpVtbl = &string_enum_vtbl;
+    impl->ref = 1;
+    for (i = 0; list && i < list->count; i++)
+    {
+        if (!strings_add(&impl->list, list->str[i]))
+        {
+            IEnumString_Release(&impl->IEnumString_iface);
+            return E_OUTOFMEMORY;
+        }
+    }
+    *out = &impl->IEnumString_iface;
+    return S_OK;
+}
+
+/* ISpellingError */
+struct spelling_error
+{
+    ISpellingError ISpellingError_iface;
+    LONG ref;
+    ULONG start, length;
+    CORRECTIVE_ACTION action;
+    WCHAR *replacement;
+};
+
+static inline struct spelling_error *impl_from_ISpellingError(ISpellingError *iface)
+{
+    return CONTAINING_RECORD(iface, struct spelling_error, ISpellingError_iface);
+}
+
+static HRESULT WINAPI spelling_error_QueryInterface(ISpellingError *iface, REFIID iid, void **out)
+{
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_ISpellingError))
+    {
+        ISpellingError_AddRef((ISpellingError *)(*out = iface));
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI spelling_error_AddRef(ISpellingError *iface)
+{
+    return InterlockedIncrement(&impl_from_ISpellingError(iface)->ref);
+}
+
+static ULONG WINAPI spelling_error_Release(ISpellingError *iface)
+{
+    struct spelling_error *impl = impl_from_ISpellingError(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref)
+    {
+        free(impl->replacement);
+        free(impl);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI spelling_error_get_StartIndex(ISpellingError *iface, ULONG *val)
+{
+    if (!val) return E_POINTER;
+    *val = impl_from_ISpellingError(iface)->start;
+    return S_OK;
+}
+
+static HRESULT WINAPI spelling_error_get_Length(ISpellingError *iface, ULONG *val)
+{
+    if (!val) return E_POINTER;
+    *val = impl_from_ISpellingError(iface)->length;
+    return S_OK;
+}
+
+static HRESULT WINAPI spelling_error_get_CorrectiveAction(ISpellingError *iface, CORRECTIVE_ACTION *val)
+{
+    if (!val) return E_POINTER;
+    *val = impl_from_ISpellingError(iface)->action;
+    return S_OK;
+}
+
+static HRESULT WINAPI spelling_error_get_Replacement(ISpellingError *iface, LPWSTR *val)
+{
+    struct spelling_error *impl = impl_from_ISpellingError(iface);
+    return return_string(impl->replacement ? impl->replacement : L"", val);
+}
+
+static const ISpellingErrorVtbl spelling_error_vtbl =
+{
+    spelling_error_QueryInterface,
+    spelling_error_AddRef,
+    spelling_error_Release,
+    spelling_error_get_StartIndex,
+    spelling_error_get_Length,
+    spelling_error_get_CorrectiveAction,
+    spelling_error_get_Replacement,
+};
+
+/* IEnumSpellingError */
+struct error_enum
+{
+    IEnumSpellingError IEnumSpellingError_iface;
+    LONG ref;
+    ISpellingError **errors;
+    unsigned int count, size, pos;
+};
+
+static inline struct error_enum *impl_from_IEnumSpellingError(IEnumSpellingError *iface)
+{
+    return CONTAINING_RECORD(iface, struct error_enum, IEnumSpellingError_iface);
+}
+
+static HRESULT WINAPI error_enum_QueryInterface(IEnumSpellingError *iface, REFIID iid, void **out)
+{
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IEnumSpellingError))
+    {
+        IEnumSpellingError_AddRef((IEnumSpellingError *)(*out = iface));
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI error_enum_AddRef(IEnumSpellingError *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumSpellingError(iface)->ref);
+}
+
+static ULONG WINAPI error_enum_Release(IEnumSpellingError *iface)
+{
+    struct error_enum *impl = impl_from_IEnumSpellingError(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref)
+    {
+        while (impl->count) ISpellingError_Release(impl->errors[--impl->count]);
+        free(impl->errors);
+        free(impl);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI error_enum_Next(IEnumSpellingError *iface, ISpellingError **val)
+{
+    struct error_enum *impl = impl_from_IEnumSpellingError(iface);
+
+    if (!val) return E_POINTER;
+    if (impl->pos >= impl->count)
+    {
+        *val = NULL;
+        return S_FALSE;
+    }
+    ISpellingError_AddRef((*val = impl->errors[impl->pos++]));
+    return S_OK;
+}
+
+static const IEnumSpellingErrorVtbl error_enum_vtbl =
+{
+    error_enum_QueryInterface,
+    error_enum_AddRef,
+    error_enum_Release,
+    error_enum_Next,
+};
+
+static BOOL error_enum_add(struct error_enum *errors, ULONG start, ULONG length, CORRECTIVE_ACTION action,
+                           const WCHAR *replacement)
+{
+    struct spelling_error *error;
+    ISpellingError **tmp;
+
+    if (errors->count == errors->size)
+    {
+        unsigned int size = errors->size ? errors->size * 2 : 8;
+        if (!(tmp = realloc(errors->errors, size * sizeof(*tmp)))) return FALSE;
+        errors->errors = tmp;
+        errors->size = size;
+    }
+    if (!(error = calloc(1, sizeof(*error)))) return FALSE;
+    error->ISpellingError_iface.lpVtbl = &spelling_error_vtbl;
+    error->ref = 1;
+    error->start = start;
+    error->length = length;
+    error->action = action;
+    if (replacement) error->replacement = strdupW(replacement);
+    errors->errors[errors->count++] = &error->ISpellingError_iface;
+    return TRUE;
+}
+
+/* languages: "en_US" dictionaries are "en-US" tags */
+static HRESULT installed_languages(struct strings *tags)
+{
+    struct dictionary_list_params params = {0};
+    char *buffer = NULL, *p;
+    WCHAR tag[64], *q;
+    NTSTATUS status;
+    unsigned int i;
+
+    if (!unix_ok) return S_OK;
+    if ((status = WINE_UNIX_CALL(unix_dictionary_languages, &params))) return HRESULT_FROM_NT(status);
+    if (!params.size) return S_OK;
+    if (!(buffer = malloc(params.size))) return E_OUTOFMEMORY;
+    params.buffer = (UINT_PTR)buffer;
+    params.count = 0;
+    if ((status = WINE_UNIX_CALL(unix_dictionary_languages, &params)))
+    {
+        free(buffer);
+        return HRESULT_FROM_NT(status);
+    }
+    for (i = 0, p = buffer; i < params.count; i++, p += strlen(p) + 1)
+    {
+        MultiByteToWideChar(CP_UTF8, 0, p, -1, tag, ARRAY_SIZE(tag));
+        for (q = tag; *q; q++) if (*q == '_') *q = '-';
+        strings_add(tags, tag);
+    }
+    free(buffer);
+    return S_OK;
+}
+
+/* the installed tag a language tag names ("en-us" -> "en-US"; a bare language, "en", is its
+ * en-US-style variant: the one whose region matches the language, else the first), or -1 */
+static int find_language(const struct strings *tags, const WCHAR *tag)
+{
+    unsigned int i, len = wcslen(tag);
+    int found;
+
+    if ((found = strings_find(tags, tag, -1, TRUE)) >= 0 || wcschr(tag, '-')) return found;
+    for (i = 0; i < tags->count; i++)
+    {
+        if (wcsnicmp(tags->str[i], tag, len) || tags->str[i][len] != '-') continue;
+        if (found < 0) found = i;
+        if (!wcsicmp(tags->str[i] + len + 1, tag) || (!wcsicmp(tag, L"en") && !wcsicmp(tags->str[i] + len + 1, L"US")))
+            return i;
+    }
+    return found;
+}
+
+/* user dictionaries registered with IUserDictionariesRegistrar (path + tag) */
+static CRITICAL_SECTION registry_cs;
+static CRITICAL_SECTION_DEBUG registry_cs_debug =
+{
+    0, 0, &registry_cs,
+    { &registry_cs_debug.ProcessLocksList, &registry_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": registry_cs") }
+};
+static CRITICAL_SECTION registry_cs = { &registry_cs_debug, -1, 0, 0, 0, 0 };
+static struct strings registered_paths, registered_tags;
+
+/* read a word list file: UTF-16 with a byte order mark, or UTF-8 */
+static void read_word_file(const WCHAR *path, struct strings *list)
+{
+    WCHAR *text = NULL, *line, *end;
+    DWORD size, read;
+    HANDLE file;
+    char *data;
+    int len;
+
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                       OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return;
+    size = GetFileSize(file, NULL);
+    if (size == INVALID_FILE_SIZE || size > 16 << 20 || !(data = malloc(size + 2)))
+    {
+        CloseHandle(file);
+        return;
+    }
+    if (!ReadFile(file, data, size, &read, NULL)) read = 0;
+    CloseHandle(file);
+    data[read] = data[read + 1] = 0;
+
+    if (read >= 2 && (BYTE)data[0] == 0xff && (BYTE)data[1] == 0xfe)
+    {
+        text = (WCHAR *)(data + 2);
+        text[(read - 2) / 2] = 0;
+        text = strdupW(text);
+    }
+    else
+    {
+        const char *start = data;
+        if (read >= 3 && !memcmp(data, "\xef\xbb\xbf", 3)) start += 3;
+        len = MultiByteToWideChar(CP_UTF8, 0, start, -1, NULL, 0);
+        if ((text = malloc(len * sizeof(WCHAR)))) MultiByteToWideChar(CP_UTF8, 0, start, -1, text, len);
+    }
+    free(data);
+    if (!text) return;
+
+    for (line = text; *line; line = end)
+    {
+        for (end = line; *end && *end != '\n' && *end != '\r'; end++);
+        if (*end) *end++ = 0;
+        while (*line == ' ' || *line == '\t') line++;
+        if (*line) strings_add(list, line);
+    }
+    free(text);
+}
+
+static void append_word_file(const WCHAR *path, const WCHAR *line)
+{
+    static const WCHAR bom = 0xfeff;
+    DWORD written;
+    HANDLE file;
+
+    file = CreateFileW(path, FILE_APPEND_DATA, FILE_SHARE_READ, NULL, OPEN_ALWAYS, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return;
+    if (!GetFileSize(file, NULL)) WriteFile(file, &bom, sizeof(bom), &written, NULL);
+    WriteFile(file, line, wcslen(line) * sizeof(WCHAR), &written, NULL);
+    WriteFile(file, L"\r\n", 2 * sizeof(WCHAR), &written, NULL);
+    CloseHandle(file);
+}
+
+static void write_word_file(const WCHAR *path, const struct strings *list)
+{
+    static const WCHAR bom = 0xfeff;
+    DWORD written;
+    unsigned int i;
+    HANDLE file;
+
+    file = CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ, NULL, CREATE_ALWAYS, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return;
+    WriteFile(file, &bom, sizeof(bom), &written, NULL);
+    for (i = 0; i < list->count; i++)
+    {
+        WriteFile(file, list->str[i], wcslen(list->str[i]) * sizeof(WCHAR), &written, NULL);
+        WriteFile(file, L"\r\n", 2 * sizeof(WCHAR), &written, NULL);
+    }
+    CloseHandle(file);
+}
+
+/* ISpellChecker */
+#define MAX_HANDLERS 32
+
+struct spell_checker
+{
+    ISpellChecker2 ISpellChecker2_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    UINT64 dict;
+    WCHAR tag[64];
+    WCHAR folder[MAX_PATH];         /* %APPDATA%\Microsoft\Spelling\<tag> */
+    struct strings added;           /* words added (default.dic and registered .dic) */
+    struct strings ignored;         /* this session's ignored words */
+    struct strings excluded;        /* words always wrong (.exc) */
+    struct strings correct_from, correct_to;   /* autocorrect pairs (.acl) */
+    ISpellCheckerChangedEventHandler *handlers[MAX_HANDLERS];
+};
+
+static inline struct spell_checker *impl_from_ISpellChecker2(ISpellChecker2 *iface)
+{
+    return CONTAINING_RECORD(iface, struct spell_checker, ISpellChecker2_iface);
+}
+
+static void dictionary_word(struct spell_checker *impl, unsigned int code, const WCHAR *word)
+{
+    struct dictionary_word_params params = {0};
+    char *utf8 = utf8_from_wide(word, -1);
+
+    if (!utf8) return;
+    params.handle = impl->dict;
+    params.word = (UINT_PTR)utf8;
+    WINE_UNIX_CALL(code, &params);
+    free(utf8);
+}
+
+static BOOL dictionary_spell(struct spell_checker *impl, const WCHAR *word, int len)
+{
+    struct dictionary_word_params params = {0};
+    char *utf8 = utf8_from_wide(word, len), *p;
+
+    if (!utf8) return TRUE;
+    /* a typographic apostrophe is an apostrophe */
+    while ((p = strstr(utf8, "\xe2\x80\x99")))
+    {
+        *p = '\'';
+        memmove(p + 1, p + 3, strlen(p + 3) + 1);
+    }
+    params.handle = impl->dict;
+    params.word = (UINT_PTR)utf8;
+    if (WINE_UNIX_CALL(unix_dictionary_spell, &params)) params.result = 1;
+    free(utf8);
+    return params.result;
+}
+
+static void fire_changed(struct spell_checker *impl)
+{
+    ISpellCheckerChangedEventHandler *handlers[MAX_HANDLERS];
+    unsigned int i, n = 0;
+
+    EnterCriticalSection(&impl->cs);
+    for (i = 0; i < MAX_HANDLERS; i++)
+        if (impl->handlers[i]) ISpellCheckerChangedEventHandler_AddRef((handlers[n++] = impl->handlers[i]));
+    LeaveCriticalSection(&impl->cs);
+    for (i = 0; i < n; i++)
+    {
+        ISpellCheckerChangedEventHandler_Invoke(handlers[i], (ISpellChecker *)&impl->ISpellChecker2_iface);
+        ISpellCheckerChangedEventHandler_Release(handlers[i]);
+    }
+}
+
+static HRESULT WINAPI spell_checker_QueryInterface(ISpellChecker2 *iface, REFIID iid, void **out)
+{
+    TRACE("(%p, %s, %p)\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_ISpellChecker) || IsEqualIID(iid, &IID_ISpellChecker2))
+    {
+        ISpellChecker2_AddRef((ISpellChecker2 *)(*out = iface));
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI spell_checker_AddRef(ISpellChecker2 *iface)
+{
+    return InterlockedIncrement(&impl_from_ISpellChecker2(iface)->ref);
+}
+
+static ULONG WINAPI spell_checker_Release(ISpellChecker2 *iface)
+{
+    struct spell_checker *impl = impl_from_ISpellChecker2(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    unsigned int i;
+
+    if (!ref)
+    {
+        struct dictionary_close_params params = { impl->dict };
+        WINE_UNIX_CALL(unix_dictionary_close, &params);
+        for (i = 0; i < MAX_HANDLERS; i++)
+            if (impl->handlers[i]) ISpellCheckerChangedEventHandler_Release(impl->handlers[i]);
+        strings_free(&impl->added);
+        strings_free(&impl->ignored);
+        strings_free(&impl->excluded);
+        strings_free(&impl->correct_from);
+        strings_free(&impl->correct_to);
+        DeleteCriticalSection(&impl->cs);
+        free(impl);
+    }
+    return ref;
+}
