+/* a record the responder gave, through the message parser: a one-answer response */
+static DNS_RECORDW *query_record( const struct mdns_event *ev )
+{
+    BYTE msg[sizeof(DNS_HEADER) + MDNS_NAME_LEN + 2 + 10 + MDNS_TXT_LEN];
+    DNS_HEADER *hdr = (DNS_HEADER *)msg;
+    BYTE *p = msg + sizeof(*hdr);
+    const char *label = ev->name, *dot;
+    DNS_RECORDW *list = NULL;
+
+    memset( hdr, 0, sizeof(*hdr) );
+    hdr->IsResponse = 1;
+    hdr->Authoritative = 1;
+    hdr->AnswerCount = 1;
+    while (*label)
+    {
+        size_t len;
+        dot = strchr( label, '.' );
+        len = dot ? dot - label : strlen( label );
+        if (!len || len > 63 || p + len + 2 >= msg + sizeof(msg) - 10 - ev->txt_len) return NULL;
+        *p++ = len;
+        memcpy( p, label, len );
+        p += len;
+        if (!dot) break;
+        label = dot + 1;
+    }
+    *p++ = 0;
+    *p++ = ev->rtype >> 8; *p++ = ev->rtype;
+    *p++ = 0; *p++ = 1;                                     /* IN */
+    *p++ = 0; *p++ = 0; *p++ = 0; *p++ = ev->kind == MDNS_EVENT_REMOVED ? 0 : 120;   /* TTL */
+    *p++ = ev->txt_len >> 8; *p++ = ev->txt_len;
+    memcpy( p, ev->txt, ev->txt_len );
+    p += ev->txt_len;
+    if (DnsExtractRecordsFromMessage_W( (DNS_MESSAGE_BUFFER *)msg, p - msg, &list )) return NULL;
+    return list;
+}
