+enum mdns_mode { MDNS_BROWSE = 1, MDNS_RESOLVE = 2, MDNS_REGISTER = 3, MDNS_QUERY = 4 };
 enum mdns_event_kind { MDNS_EVENT_FOUND = 1, MDNS_EVENT_REMOVED = 2, MDNS_EVENT_FAILED = 3 };
 
 struct mdns_event
@@ -143,8 +143,10 @@ struct mdns_event
     UINT8  has_ip4, has_ip6;
     UINT8  ip4[4];
     UINT8  ip6[16];
+    UINT16 rtype;                   /* MDNS_QUERY: the record's type */
+    UINT16 pad;
     UINT32 txt_len;
-    UINT8  txt[MDNS_TXT_LEN];       /* the TXT strings, each after its length byte */
+    UINT8  txt[MDNS_TXT_LEN];       /* the TXT strings, each after its length byte; MDNS_QUERY: the record data */
 };
 
 struct mdns_start_params
@@ -153,12 +155,12 @@ struct mdns_start_params
     UINT32 mode;
     UINT32 interface;               /* 0: any */
     UINT32 error;                   /* out: a Win32 error */
-    char   name[MDNS_NAME_LEN];     /* MDNS_RESOLVE, MDNS_REGISTER: the instance */
+    char   name[MDNS_NAME_LEN];     /* MDNS_RESOLVE, MDNS_REGISTER: the instance; MDNS_QUERY: the name */
     char   type[MDNS_TYPE_LEN];
     char   domain[MDNS_TYPE_LEN];
     char   host[MDNS_NAME_LEN];     /* MDNS_REGISTER: empty for this machine */
     UINT16 port;
-    UINT16 pad;
+    UINT16 rtype;                   /* MDNS_QUERY: the type asked for */
     UINT32 txt_len;
     UINT8  txt[MDNS_TXT_LEN];
 };
