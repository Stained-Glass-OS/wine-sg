+
+/******************************************************************************
+ * DnsStartMulticastQuery                  [DNSAPI.@]
+ *
+ * Records of a name answered on the local link, reported until DnsStopMulticastQuery
+ * (a record gone with a zero time to live).
+ */
+DNS_STATUS WINAPI DnsStartMulticastQuery( PMDNS_QUERY_REQUEST request, PMDNS_QUERY_HANDLE handle )
+{
+    struct mdns_start_params *params;
+    struct mdns_request *req;
+    DNS_STATUS status = ERROR_INVALID_PARAMETER;
+    size_t len;
+
+    TRACE( "(%p, %p)\n", request, handle );
+
+    if (!request || !handle || !request->Query || !request->pQueryCallback || !request->QueryType ||
+        request->Version != DNS_QUERY_REQUEST_VERSION1)
+        return ERROR_INVALID_PARAMETER;
+    TRACE( "%s type %u interface %lu\n", debugstr_w(request->Query), request->QueryType, request->InterfaceIndex );
+    if (!(params = calloc( 1, sizeof(*params) ))) return ERROR_OUTOFMEMORY;
+    if (!wide_to_utf8( request->Query, params->name, sizeof(params->name) ) || !params->name[0]) goto done;
+    /* a trailing dot is the root */
+    len = strlen( params->name );
+    if (params->name[len - 1] == '.') params->name[len - 1] = 0;
+    params->rtype = request->QueryType;
+    params->interface = request->InterfaceIndex;
+    status = ERROR_OUTOFMEMORY;
+    if (!(req = calloc( 1, sizeof(*req) ))) goto done;
+    req->mode = MDNS_QUERY;
+    req->version = request->Version;
+    req->context = request->pQueryContext;
+    req->query_cb = request->pQueryCallback;
+    req->query_handle = handle;
+    req->cancel = &req->own_cancel;
+    memset( handle, 0, sizeof(*handle) );
+    lstrcpynW( handle->nameBuf, request->Query, ARRAY_SIZE(handle->nameBuf) );
+    handle->wType = request->QueryType;
+    handle->pSubscription = req;
+    if ((status = start_session( req, params )) == DNS_REQUEST_PENDING) status = ERROR_SUCCESS;
+    else
+    {
+        handle->pSubscription = NULL;
+        free( req );
+    }
+done:
+    free( params );
+    return status;
+}
+
+/******************************************************************************
+ * DnsStopMulticastQuery                   [DNSAPI.@]
+ *
+ * No callback comes after it returns, unless it is called from one.
+ */
+DNS_STATUS WINAPI DnsStopMulticastQuery( PMDNS_QUERY_HANDLE handle )
+{
+    struct mdns_request *req;
+    HANDLE thread = NULL;
+    DNS_STATUS status = ERROR_INVALID_PARAMETER;
+
+    TRACE( "(%p)\n", handle );
+    if (!handle) return ERROR_INVALID_PARAMETER;
+    EnterCriticalSection( &requests_cs );
+    for (req = requests; req; req = req->link.next)
+    {
+        struct mdns_handle_params h;
+
+        if (req != handle->pSubscription || req->mode != MDNS_QUERY) continue;
+        req->cancelled = TRUE;
+        h.handle = req->handle;
+        RESOLV_CALL( mdns_cancel, &h );
+        if (req->thread_id != GetCurrentThreadId())
+            DuplicateHandle( GetCurrentProcess(), req->thread, GetCurrentProcess(), &thread, SYNCHRONIZE, FALSE, 0 );
+        status = ERROR_SUCCESS;
+        break;
+    }
+    LeaveCriticalSection( &requests_cs );
+#ifndef SG_MUTANT_MDNS_STOP_NOWAIT
+    if (thread) WaitForSingleObject( thread, INFINITE );
+#endif
+    if (thread) CloseHandle( thread );
+    if (!status) handle->pSubscription = NULL;
+    return status;
+}
