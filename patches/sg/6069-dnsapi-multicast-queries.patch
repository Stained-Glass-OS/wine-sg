     LOAD( common, avahi_string_list_add_arbitrary )
     LOAD( common, avahi_string_list_free )
 #undef LOAD
@@ -180,6 +189,7 @@ struct session
     AvahiClient *client;
     AvahiServiceBrowser *browser;
     AvahiEntryGroup *group;             /* MDNS_REGISTER: the published service, withdrawn when freed */
+    AvahiRecordBrowser *records;        /* MDNS_QUERY */
     struct resolver *resolvers;
     struct mdns_event *events;
     unsigned int event_count, event_alloc;
@@ -355,6 +365,30 @@ static void group_callback( AvahiEntryGroup *group, int state, void *user )
     }
 }
 
+static void record_callback( AvahiRecordBrowser *b, AvahiIfIndex interface, AvahiProtocol protocol, int event,
+                             const char *name, uint16_t clazz, uint16_t type, const void *rdata, size_t size,
+                             int flags, void *user )
+{
+    struct session *s = user;
+    struct mdns_event *ev;
+
+    TRACE( "event %d %s type %u size %zu\n", event, debugstr_a(name), type, size );
+    if (event == AVAHI_BROWSER_NEW || event == AVAHI_BROWSER_REMOVE)
+    {
+        if (size > MDNS_TXT_LEN) return;
+        if (!(ev = new_event( s, event == AVAHI_BROWSER_NEW ? MDNS_EVENT_FOUND : MDNS_EVENT_REMOVED ))) return;
+        ev->interface = interface < 0 ? 0 : interface;
+        copy_str( ev->name, name, sizeof(ev->name) );
+        ev->rtype = type;
+        memcpy( ev->txt, rdata, size );
+        ev->txt_len = size;
+    }
+    else if (event == AVAHI_BROWSER_FAILURE)
+    {
+        if ((ev = new_event( s, MDNS_EVENT_FAILED ))) ev->error = map_avahi_error( p_avahi_client_errno( s->client ) );
+    }
+}
