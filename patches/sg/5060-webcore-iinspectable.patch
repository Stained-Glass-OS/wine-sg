From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.security.authentication.web.core: Implement IInspectable on the manager statics and operations.

IInspectable on WebAuthenticationCoreManager's statics and its operations:
the statics list IActivationFactory, both statics interfaces and IAgileObject,
answer GetRuntimeClassName with E_ILLEGAL_METHOD_CALL (the Interop interface
too) and are BaseTrust; an operation lists its IAsyncOperation<T>, IAsyncInfo
and IAgileObject, is named IAsyncOperation`1<T's class> and is BaseTrust.
IAsyncInfo::get_Id answers an id until the operation is closed and
E_ILLEGAL_METHOD_CALL after. They returned E_NOTIMPL.

Gate: test/webcore-inspectable-gate.sh.
---
 .../async.c                                        | 60 +++++++++++++++++++---
 .../manager.c                                      | 30 ++++++++---
 2 files changed, 78 insertions(+), 12 deletions(-)

diff --git a/dlls/windows.security.authentication.web.core/async.c b/dlls/windows.security.authentication.web.core/async.c
index b519e60..70074cc 100644
--- a/dlls/windows.security.authentication.web.core/async.c
+++ b/dlls/windows.security.authentication.web.core/async.c
@@ -119,20 +119,58 @@ static ULONG WINAPI async_inspectable_Release( IAsyncOperation_IInspectable *ifa
 
 static HRESULT WINAPI async_inspectable_GetIids( IAsyncOperation_IInspectable *iface, ULONG *iid_count, IID **iids )
 {
-    FIXME("iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids);
+    struct async_inspectable *impl = impl_from_IAsyncOperation_IInspectable(iface);
+
+    TRACE("iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids);
+
+    if (!iid_count || !iids) return E_POINTER;
+#ifdef SG_MUTANT_NO_IIDS
     return E_NOTIMPL;
+#endif
+    if (!(*iids = CoTaskMemAlloc(3 * sizeof(IID)))) return E_OUTOFMEMORY;
+    (*iids)[0] = *impl->iid;
+    (*iids)[1] = IID_IAsyncInfo;
+    (*iids)[2] = IID_IAgileObject;
+    *iid_count = 3;
+    return S_OK;
 }
 
 static HRESULT WINAPI async_inspectable_GetRuntimeClassName( IAsyncOperation_IInspectable *iface, HSTRING *class_name )
 {
-    FIXME("iface %p, class_name %p stub!\n", iface, class_name);
+    static const struct
+    {
+        const GUID *iid;
+        const WCHAR *name;
+    }
+    names[] =
+    {
+        {&IID_IAsyncOperation_WebAccountProvider, L"Windows.Foundation.IAsyncOperation`1<Windows.Security.Credentials.WebAccountProvider>"},
+        {&IID_IAsyncOperation_WebAccount, L"Windows.Foundation.IAsyncOperation`1<Windows.Security.Credentials.WebAccount>"},
+        {&IID_IAsyncOperation_WebTokenRequestResult,
+         L"Windows.Foundation.IAsyncOperation`1<Windows.Security.Authentication.Web.Core.WebTokenRequestResult>"},
+        {&IID_IAsyncOperation_FindAllAccountsResult,
+         L"Windows.Foundation.IAsyncOperation`1<Windows.Security.Authentication.Web.Core.FindAllAccountsResult>"},
+    };
+    struct async_inspectable *impl = impl_from_IAsyncOperation_IInspectable(iface);
+    unsigned int i;
+
+    TRACE("iface %p, class_name %p.\n", iface, class_name);
+
+    /* the runtime class of an operation is IAsyncOperation`1 of its result's class */
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+        if (IsEqualGUID(impl->iid, names[i].iid))
+            return WindowsCreateString(names[i].name, wcslen(names[i].name), class_name);
+    FIXME("no class name for %s.\n", debugstr_guid(impl->iid));
     return E_NOTIMPL;
 }
 
 static HRESULT WINAPI async_inspectable_GetTrustLevel( IAsyncOperation_IInspectable *iface, TrustLevel *trust_level )
 {
-    FIXME("iface %p, trust_level %p stub!\n", iface, trust_level);
-    return E_NOTIMPL;
+    TRACE("iface %p, trust_level %p.\n", iface, trust_level);
+
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
 }
 
 static HRESULT WINAPI async_inspectable_put_Completed( IAsyncOperation_IInspectable *iface,
@@ -240,8 +278,18 @@ DEFINE_IINSPECTABLE_(async_inspectable_info, IAsyncInfo, struct async_inspectabl
 
 static HRESULT WINAPI async_inspectable_info_get_Id( IAsyncInfo *iface, UINT32 *id )
 {
-    FIXME("iface %p, id %p stub!\n", iface, id);
-    return E_NOTIMPL;
+    struct async_inspectable *impl = async_inspectable_impl_from_IAsyncInfo(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, id %p.\n", iface, id);
+
+    EnterCriticalSection(&impl->cs);
+    if (impl->status == Closed)
+        hr = E_ILLEGAL_METHOD_CALL;
+    *id = 1;
+    LeaveCriticalSection(&impl->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI async_inspectable_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
diff --git a/dlls/windows.security.authentication.web.core/manager.c b/dlls/windows.security.authentication.web.core/manager.c
index 68f8fb6..b18ce73 100644
--- a/dlls/windows.security.authentication.web.core/manager.c
+++ b/dlls/windows.security.authentication.web.core/manager.c
@@ -107,20 +107,37 @@ static ULONG WINAPI factory_Release( IActivationFactory *iface )
 
 static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
 {
-    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    static const IID *const list[] = { &IID_IActivationFactory, &IID_IWebAuthenticationCoreManagerStatics,
+                                       &IID_IWebAuthenticationCoreManagerStatics4, &IID_IAgileObject };
+    ULONG i;
+
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+
+    if (!iid_count || !iids) return E_POINTER;
+#ifdef SG_MUTANT_NO_IIDS
     return E_NOTIMPL;
+#endif
+    if (!(*iids = CoTaskMemAlloc( ARRAY_SIZE(list) * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < ARRAY_SIZE(list); i++) (*iids)[i] = *list[i];
+    *iid_count = ARRAY_SIZE(list);
+    return S_OK;
 }
 
 static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
 {
-    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
-    return E_NOTIMPL;
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+
+    /* a class factory or a static interface has no runtime class name of its own */
+    return E_ILLEGAL_METHOD_CALL;
 }
 
 static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
 {
-    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
-    return E_NOTIMPL;
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
 }
 
 static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
@@ -612,7 +629,8 @@ static HRESULT WINAPI interop_GetIids( IWebAuthenticationCoreManagerInterop *ifa
 
 static HRESULT WINAPI interop_GetRuntimeClassName( IWebAuthenticationCoreManagerInterop *iface, HSTRING *name )
 {
-    return E_NOTIMPL;
+    /* a static interface has no runtime class name of its own */
+    return E_ILLEGAL_METHOD_CALL;
 }
 
 static HRESULT WINAPI interop_GetTrustLevel( IWebAuthenticationCoreManagerInterop *iface, TrustLevel *level )
