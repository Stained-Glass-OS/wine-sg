+/* Stained Glass OS: what is on the network, from sg-session's sg-netbrowse
+ * (a Unix program: smbclient for a computer's shares, mDNS and NetBIOS for the
+ * computers), one name per line in a file. NULL-terminated list, or NULL. */
+static WCHAR **net_browse(const char *what, const WCHAR *server)
+{
+    static const WCHAR helperW[] = L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-netbrowse";
+    LONG (WINAPI *spawnvp)(char * const argv[], int wait);
+    char helper[MAX_PATH] = "/usr/libexec/stained-glass/sg-netbrowse", serverA[256] = "", *argv[5], *unix_out, *data;
+    WCHAR dir[MAX_PATH], file[MAX_PATH], **names = NULL;
+    unsigned int count = 0, n;
+    HANDLE h;
+    DWORD size, read;
+    char *line, *next;
+
+    WCHAR stub[MAX_PATH + 8] = L"\\\\?\\unix", *p;
+    const WCHAR *helper_path = helperW;
+
+    spawnvp = (void *)GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "__wine_unix_spawnvp");
+    /* SG_NETBROWSE names a stand-in helper (an absolute Unix path), for gates */
+    if (GetEnvironmentVariableW(L"SG_NETBROWSE", stub + 8, MAX_PATH) && stub[8] == '/' &&
+        GetEnvironmentVariableA("SG_NETBROWSE", helper, sizeof(helper)) < sizeof(helper))
+    {
+        for (p = stub + 8; *p; p++) if (*p == '/') *p = '\\';
+        helper_path = stub;
+    }
+    if (!spawnvp || GetFileAttributesW(helper_path) == INVALID_FILE_ATTRIBUTES) return NULL;
+    if (!GetTempPathW(MAX_PATH, dir) || !GetTempFileNameW(dir, L"net", 0, file)) return NULL;
+    if (!(unix_out = wine_get_unix_file_name(file))) { DeleteFileW(file); return NULL; }
+    if (server) WideCharToMultiByte(CP_UTF8, 0, server, -1, serverA, sizeof(serverA), NULL, NULL);
+    argv[0] = helper;
+    argv[1] = (char *)what;
+    argv[2] = unix_out;
+    argv[3] = server ? serverA : NULL;
+    argv[4] = NULL;
+    spawnvp(argv, TRUE);
+    HeapFree(GetProcessHeap(), 0, unix_out);
+
+    h = CreateFileW(file, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+    if (h != INVALID_HANDLE_VALUE && (size = GetFileSize(h, NULL)) != INVALID_FILE_SIZE && size < 1 << 20 &&
+        (data = malloc(size + 1)))
+    {
+        if (ReadFile(h, data, size, &read, NULL))
+        {
+            data[read] = 0;
+            for (line = data; line && *line; line = next)
+            {
+                if ((next = strchr(line, '\n'))) *next++ = 0;
+                if (!*line) continue;
+                if (!(names = realloc(names, (count + 2) * sizeof(*names)))) break;
+                n = MultiByteToWideChar(CP_UTF8, 0, line, -1, NULL, 0);
+                if ((names[count] = malloc(n * sizeof(WCHAR))))
+                    MultiByteToWideChar(CP_UTF8, 0, line, -1, names[count++], n);
+                names[count] = NULL;
+            }
+        }
+        free(data);
+    }
+    if (h != INVALID_HANDLE_VALUE) CloseHandle(h);
+    DeleteFileW(file);
+    return names;
+}
+
+static void net_free(WCHAR **names)
+{
+    WCHAR **p;
+    if (!names) return;
+    for (p = names; *p; p++) free(*p);
+    free(names);
+}
+
+/* a share as a file system folder item: the folder is \\server\share */
+static LPITEMIDLIST net_create_share(const WCHAR *share)
+{
+    WIN32_FIND_DATAW fd = { 0 };
+    fd.dwFileAttributes = FILE_ATTRIBUTE_DIRECTORY;
+    lstrcpynW(fd.cFileName, share, MAX_PATH);
+    return _ILCreateFromFindDataW(&fd);
+}
