 }
 
 static void NSAPI nsDocumentObserver_NodeWillBeDestroyed(nsIDocumentObserver *iface, const nsINode *aNode)
@@ -1040,6 +1054,7 @@ void init_document_mutation(HTMLDocumentNode *doc)
     nsresult nsres;
 
     doc->nsIDocumentObserver_iface.lpVtbl = &nsDocumentObserverVtbl;
+    list_init(&doc->mutation_regs);
 
     nsres = nsIDOMDocument_QueryInterface(doc->dom_document, &IID_nsIDocument, (void**)&nsdoc);
     if(NS_FAILED(nsres)) {
@@ -1056,6 +1071,8 @@ void release_document_mutation(HTMLDocumentNode *doc)
     nsIDocument *nsdoc;
     nsresult nsres;
 
+    mo_release_document(doc);
+
     nsres = nsIDOMDocument_QueryInterface(doc->dom_document, &IID_nsIDocument, (void**)&nsdoc);
     if(NS_FAILED(nsres)) {
         ERR("Could not get nsIDocument: %08lx\n", nsres);
@@ -1108,11 +1125,51 @@ void init_mutation(nsIComponentManager *component_manager)
         ERR("Could not create nsIContentUtils instance: %08lx\n", nsres);
 }
 
+enum {
+    MO_CHILD_LIST = 0x01,
+    MO_ATTRIBUTES = 0x02,
+    MO_CHAR_DATA  = 0x04,
+    MO_SUBTREE    = 0x08,
+    MO_ATTR_OLD   = 0x10,
+    MO_CHAR_OLD   = 0x20
+};
+
+enum mo_record_type { MO_REC_CHILD_LIST, MO_REC_ATTRIBUTES, MO_REC_CHAR_DATA };
+
+struct mutation_observer;
+
+struct mo_registration {
+    struct list doc_entry;
+    struct list obs_entry;
+    struct mutation_observer *observer;
+    HTMLDocumentNode *doc;
+    nsIDOMNode *target;
+    unsigned flags;
+    WCHAR **filter;
+    unsigned filter_cnt;
+};
+
+struct mo_record {
+    struct list entry;
+    enum mo_record_type type;
+    nsIDOMNode *target, *prev, *next;
+    nsIDOMNode **added;
+    unsigned added_cnt;
+    nsIDOMNode **removed;
+    unsigned removed_cnt;
+    WCHAR *attr_name;
+    WCHAR *old_value;
+};
+
 struct mutation_observer {
     IWineMSHTMLMutationObserver IWineMSHTMLMutationObserver_iface;
 
     DispatchEx dispex;
     IDispatch *callback;
+    struct list regs;
+    struct list records;
+    BOOL task_pending;
+    unsigned mark;
 };
 
 static inline struct mutation_observer *impl_from_IWineMSHTMLMutationObserver(IWineMSHTMLMutationObserver *iface)
@@ -1123,12 +1180,893 @@ static inline struct mutation_observer *impl_from_IWineMSHTMLMutationObserver(IW
 DISPEX_IDISPATCH_IMPL(MutationObserver, IWineMSHTMLMutationObserver,
                       impl_from_IWineMSHTMLMutationObserver(iface)->dispex)
 
+static void mo_free_record(struct mo_record *rec)
+{
+    unsigned i;
+
+    if(rec->target) nsIDOMNode_Release(rec->target);
+    if(rec->prev) nsIDOMNode_Release(rec->prev);
+    if(rec->next) nsIDOMNode_Release(rec->next);
+    for(i = 0; i < rec->added_cnt; i++) nsIDOMNode_Release(rec->added[i]);
+    for(i = 0; i < rec->removed_cnt; i++) nsIDOMNode_Release(rec->removed[i]);
+    free(rec->added);
+    free(rec->removed);
+    free(rec->attr_name);
+    free(rec->old_value);
+    free(rec);
+}
+
+static void mo_clear_records(struct mutation_observer *obs)
+{
+    struct mo_record *rec, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(rec, next, &obs->records, struct mo_record, entry) {
+        list_remove(&rec->entry);
+        mo_free_record(rec);
+    }
+}
+
+static void mo_free_registration(struct mo_registration *reg)
+{
+    unsigned i;
+
+    list_remove(&reg->doc_entry);
+    list_remove(&reg->obs_entry);
+    for(i = 0; i < reg->filter_cnt; i++) free(reg->filter[i]);
+    free(reg->filter);
+    nsIDOMNode_Release(reg->target);
+    free(reg);
+}
+
+static void mo_clear_registrations(struct mutation_observer *obs)
+{
+    struct mo_registration *reg, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(reg, next, &obs->regs, struct mo_registration, obs_entry)
+        mo_free_registration(reg);
+}
+
+/* the document goes away: nothing is observed in it any more */
+static void mo_release_document(HTMLDocumentNode *doc)
+{
+    struct mo_registration *reg, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(reg, next, &doc->mutation_regs, struct mo_registration, doc_entry) {
+        struct mutation_observer *obs = reg->observer;
+
+        mo_free_registration(reg);
+        if(list_empty(&obs->regs))
+            mo_clear_records(obs);
+    }
+}
+
+static BOOL mo_is_inclusive_ancestor(nsIDOMNode *ancestor, nsIDOMNode *node)
+{
+    nsIDOMNode *cur = node, *parent;
+    BOOL ret = FALSE;
+
+    nsIDOMNode_AddRef(cur);
+    while(cur) {
+        if(cur == ancestor) {
+            ret = TRUE;
+            nsIDOMNode_Release(cur);
+            break;
+        }
+        parent = NULL;
+        nsIDOMNode_GetParentNode(cur, &parent);
+        nsIDOMNode_Release(cur);
+        cur = parent;
+    }
+    return ret;
+}
+
+static nsIDOMNode *mo_child_at(nsIDOMNode *parent, LONG idx)
+{
+    nsIDOMNodeList *list;
+    nsIDOMNode *ret = NULL;
+
+    if(idx < 0 || !parent)
+        return NULL;
+    if(NS_SUCCEEDED(nsIDOMNode_GetChildNodes(parent, &list)) && list) {
+        nsIDOMNodeList_Item(list, idx, &ret);
+        nsIDOMNodeList_Release(list);
+    }
+    return ret;
+}
+
+static nsIDOMNode *mo_query_node(nsISupports *iface)
+{
+    nsIDOMNode *node = NULL;
+
+    if(iface)
+        nsISupports_QueryInterface(iface, &IID_nsIDOMNode, (void**)&node);
+    return node;
+}
+
+static BOOL mo_filter_match(const struct mo_registration *reg, const WCHAR *name)
+{
+    unsigned i;
+
+    if(!reg->filter)
+        return TRUE;
+    for(i = 0; i < reg->filter_cnt; i++)
+        if(!wcscmp(reg->filter[i], name))
+            return TRUE;
+    return FALSE;
+}
+
+static void mo_schedule(struct mutation_observer *obs, HTMLDocumentNode *doc);
+
+static void mo_add_node(nsIDOMNode ***arr, unsigned *cnt, nsIDOMNode *node)
+{
+    nsIDOMNode **tmp = realloc(*arr, (*cnt + 1) * sizeof(**arr));
+
+    if(!tmp)
+        return;
+    *arr = tmp;
+    nsIDOMNode_AddRef(node);
+    tmp[(*cnt)++] = node;
+}
+
+/* Queues a record for every observer that has an interest in the node. The template is
+ * not kept; each observer gets a copy of the parts it needs. */
+static void mo_queue(HTMLDocumentNode *doc, const struct mo_record *tmpl)
+{
+    static unsigned serial;
+    struct mo_registration *reg;
+    unsigned wanted, i;
+
+    if(list_empty(&doc->mutation_regs))
+        return;
+
+    serial++;
+    switch(tmpl->type) {
+    case MO_REC_CHILD_LIST: wanted = MO_CHILD_LIST; break;
+    case MO_REC_ATTRIBUTES: wanted = MO_ATTRIBUTES; break;
+    default:                wanted = MO_CHAR_DATA; break;
+    }
+
+    LIST_FOR_EACH_ENTRY(reg, &doc->mutation_regs, struct mo_registration, doc_entry) {
+        struct mutation_observer *obs = reg->observer;
+        struct mo_record *rec;
+
+        if(obs->mark == serial || !(reg->flags & wanted))
+            continue;
+#ifdef SG_MUTANT_MO_NOSUBTREE
+        if(reg->target != tmpl->target)
+            continue;
+#endif
+        if(reg->target != tmpl->target && (!(reg->flags & MO_SUBTREE) || !mo_is_inclusive_ancestor(reg->target, tmpl->target)))
+            continue;
+        if(tmpl->type == MO_REC_ATTRIBUTES && !mo_filter_match(reg, tmpl->attr_name))
+            continue;
+        obs->mark = serial;
+
+        if(!(rec = calloc(1, sizeof(*rec))))
+            continue;
+        rec->type = tmpl->type;
+        rec->target = tmpl->target;
+        nsIDOMNode_AddRef(rec->target);
+        if((rec->prev = tmpl->prev)) nsIDOMNode_AddRef(rec->prev);
+        if((rec->next = tmpl->next)) nsIDOMNode_AddRef(rec->next);
+        for(i = 0; i < tmpl->added_cnt; i++) mo_add_node(&rec->added, &rec->added_cnt, tmpl->added[i]);
+        for(i = 0; i < tmpl->removed_cnt; i++) mo_add_node(&rec->removed, &rec->removed_cnt, tmpl->removed[i]);
+        if(tmpl->attr_name) rec->attr_name = wcsdup(tmpl->attr_name);
+        if(tmpl->old_value && ((tmpl->type == MO_REC_ATTRIBUTES && (reg->flags & MO_ATTR_OLD)) ||
+                               (tmpl->type == MO_REC_CHAR_DATA && (reg->flags & MO_CHAR_OLD))))
+            rec->old_value = wcsdup(tmpl->old_value);
+        list_add_tail(&obs->records, &rec->entry);
+        mo_schedule(obs, doc);
+    }
+}
+
+/* the old value of the attribute or text that is about to change */
+static struct {
+    nsIDOMNode *node;
+    WCHAR *name;
+    WCHAR *value;
+} mo_old;
+
+static void mo_forget_old(void)
+{
+    if(mo_old.node) nsIDOMNode_Release(mo_old.node);
+    free(mo_old.name);
+    free(mo_old.value);
+    memset(&mo_old, 0, sizeof(mo_old));
+}
+
+static WCHAR *mo_atom_name(nsISupports *atom)
+{
+    nsIAtomString *str = (nsIAtomString*)atom;
+    const PRUnichar *data;
+    nsAString nsstr;
+    WCHAR *ret = NULL;
+
+    if(!atom || !nsAString_Init(&nsstr, NULL))
+        return NULL;
+    nsIAtomString_ToString(str, &nsstr);
+    nsAString_GetData(&nsstr, &data);
+    if(data && *data)
+        ret = wcsdup(data);
+    nsAString_Finish(&nsstr);
+    return ret;
+}
+
+static WCHAR *mo_get_attribute(nsIDOMNode *node, const WCHAR *name)
+{
+    nsIDOMElement *elem;
+    nsAString name_str, value_str;
+    const PRUnichar *data;
+    WCHAR *ret = NULL;
+    cpp_bool has = FALSE;
+    nsresult nsres;
+
+    if(FAILED(nsIDOMNode_QueryInterface(node, &IID_nsIDOMElement, (void**)&elem)))
+        return NULL;
+    nsAString_InitDepend(&name_str, name);
+    nsAString_Init(&value_str, NULL);
+    nsres = nsIDOMElement_HasAttribute(elem, &name_str, &has);
+    if(NS_SUCCEEDED(nsres) && has)
+        nsres = nsIDOMElement_GetAttribute(elem, &name_str, &value_str);
+    if(NS_SUCCEEDED(nsres) && has) {
+        nsAString_GetData(&value_str, &data);
+        ret = wcsdup(data);
+    }
+    nsAString_Finish(&name_str);
+    nsAString_Finish(&value_str);
+    nsIDOMElement_Release(elem);
+    return ret;
+}
+
+static BOOL mo_wants_old(HTMLDocumentNode *doc, unsigned flag)
+{
+    struct mo_registration *reg;
+
+    LIST_FOR_EACH_ENTRY(reg, &doc->mutation_regs, struct mo_registration, doc_entry)
+        if(reg->flags & flag)
+            return TRUE;
+    return FALSE;
+}
+
+static void mo_attribute_will_change(HTMLDocumentNode *doc, void *element, nsIAtom *atom)
+{
+    nsIDOMNode *node;
+
+    mo_forget_old();
+    if(list_empty(&doc->mutation_regs) || !mo_wants_old(doc, MO_ATTR_OLD))
+        return;
+    if(!(node = mo_query_node((nsISupports*)element)))
+        return;
+    mo_old.name = mo_atom_name((nsISupports*)atom);
+    if(mo_old.name) {
+        mo_old.node = node;
+        mo_old.value = mo_get_attribute(node, mo_old.name);
+    }else {
+        nsIDOMNode_Release(node);
+    }
+}
+
+static void mo_attribute_changed(HTMLDocumentNode *doc, void *element, nsIAtom *atom)
+{
+    struct mo_record rec = { .type = MO_REC_ATTRIBUTES };
+    nsIDOMNode *node;
+
+#ifdef SG_MUTANT_MO_NOATTR
+    mo_forget_old();
+    return;
+#endif
+    if(list_empty(&doc->mutation_regs)) {
+        mo_forget_old();
+        return;
+    }
+    if(!(node = mo_query_node((nsISupports*)element))) {
+        mo_forget_old();
+        return;
+    }
+    rec.attr_name = mo_atom_name((nsISupports*)atom);
+    if(rec.attr_name) {
+        rec.target = node;
+        if(mo_old.node == node && mo_old.name && !wcscmp(mo_old.name, rec.attr_name))
+            rec.old_value = mo_old.value;
+        mo_queue(doc, &rec);
+        free(rec.attr_name);
+    }
+    nsIDOMNode_Release(node);
+    mo_forget_old();
+}
+
+static void mo_chardata_will_change(HTMLDocumentNode *doc, nsIContent *content)
+{
+    nsIDOMCharacterData *chardata;
+    nsIDOMNode *node;
+    nsAString str;
+    const PRUnichar *data;
+
+    mo_forget_old();
+    if(list_empty(&doc->mutation_regs) || !mo_wants_old(doc, MO_CHAR_OLD))
+        return;
+    if(!(node = mo_query_node((nsISupports*)content)))
+        return;
+    if(SUCCEEDED(nsIDOMNode_QueryInterface(node, &IID_nsIDOMCharacterData, (void**)&chardata))) {
+        nsAString_Init(&str, NULL);
+        if(NS_SUCCEEDED(nsIDOMCharacterData_GetData(chardata, &str))) {
+            nsAString_GetData(&str, &data);
+            mo_old.value = wcsdup(data);
+        }
+        nsAString_Finish(&str);
+        nsIDOMCharacterData_Release(chardata);
+    }
+    mo_old.node = node;
+}
+
+static void mo_chardata_changed(HTMLDocumentNode *doc, nsIContent *content)
+{
+    struct mo_record rec = { .type = MO_REC_CHAR_DATA };
+    nsIDOMNode *node;
+
+    if(list_empty(&doc->mutation_regs)) {
+        mo_forget_old();
+        return;
+    }
+    if((node = mo_query_node((nsISupports*)content))) {
+        rec.target = node;
+        if(mo_old.node == node)
+            rec.old_value = mo_old.value;
+        mo_queue(doc, &rec);
+        nsIDOMNode_Release(node);
+    }
+    mo_forget_old();
+}
+
+static nsIDOMNode *mo_container_node(HTMLDocumentNode *doc, nsIContent *container)
+{
+    nsIDOMNode *node;
+
+    if(container)
+        return mo_query_node((nsISupports*)container);
+    node = NULL;
+    nsIDOMDocument_QueryInterface(doc->dom_document, &IID_nsIDOMNode, (void**)&node);
+    return node;
+}
+
+static void mo_children_changed(HTMLDocumentNode *doc, nsIContent *container, LONG first_idx, nsIContent *removed,
+                                nsIContent *prev_sibling, BOOL appended)
+{
+    struct mo_record rec = { .type = MO_REC_CHILD_LIST };
+    nsIDOMNode *parent, *child;
+    LONG idx;
+
+    if(list_empty(&doc->mutation_regs) || !(parent = mo_container_node(doc, container)))
+        return;
+    rec.target = parent;
+
+    if(removed) {
+        if((child = mo_query_node((nsISupports*)removed))) {
+            mo_add_node(&rec.removed, &rec.removed_cnt, child);
+            nsIDOMNode_Release(child);
+        }
+        rec.prev = mo_query_node((nsISupports*)prev_sibling);
+        rec.next = mo_child_at(parent, first_idx);
+    }else {
+        for(idx = first_idx; (child = mo_child_at(parent, idx)); idx++) {
+            mo_add_node(&rec.added, &rec.added_cnt, child);
+            nsIDOMNode_Release(child);
+            if(!appended)
+                break;
+        }
+        rec.prev = mo_child_at(parent, first_idx - 1);
+        rec.next = appended ? NULL : mo_child_at(parent, first_idx + 1);
+    }
+
+    if(rec.added_cnt || rec.removed_cnt)
+        mo_queue(doc, &rec);
+
+    if(rec.prev) nsIDOMNode_Release(rec.prev);
+    if(rec.next) nsIDOMNode_Release(rec.next);
+    for(idx = 0; idx < (LONG)rec.added_cnt; idx++) nsIDOMNode_Release(rec.added[idx]);
+    for(idx = 0; idx < (LONG)rec.removed_cnt; idx++) nsIDOMNode_Release(rec.removed[idx]);
+    free(rec.added);
+    free(rec.removed);
+    nsIDOMNode_Release(parent);
