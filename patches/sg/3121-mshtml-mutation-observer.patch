+/* ---- options of observe() ---- */
+static HRESULT mo_get_option(IDispatch *options, const WCHAR *name, VARIANT *v)
+{
+    DISPPARAMS dp = {0};
+    DISPID id;
+    HRESULT hres;
+
+    V_VT(v) = VT_EMPTY;
+    hres = IDispatch_GetIDsOfNames(options, &IID_NULL, (WCHAR**)&name, 1, LOCALE_USER_DEFAULT, &id);
+    if(hres == DISP_E_UNKNOWNNAME)
+        return S_FALSE;
+    if(FAILED(hres))
+        return hres;
+    hres = IDispatch_Invoke(options, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_PROPERTYGET, &dp, v, NULL, NULL);
+    if(FAILED(hres))
+        return hres;
+    return V_VT(v) == VT_EMPTY ? S_FALSE : S_OK;
+}
+
+/* S_OK: the option is there and set; S_FALSE: absent */
+static HRESULT mo_get_bool_option(IDispatch *options, const WCHAR *name, BOOL *val)
+{
+    VARIANT v, b;
+    HRESULT hres;
+
+    hres = mo_get_option(options, name, &v);
+    if(hres != S_OK)
+        return hres;
+    V_VT(&b) = VT_EMPTY;
+    hres = VariantChangeType(&b, &v, 0, VT_BOOL);
+    VariantClear(&v);
+    if(FAILED(hres))
+        return hres;
+    *val = V_BOOL(&b) != VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT mo_get_filter(IDispatch *options, WCHAR ***filter, unsigned *cnt)
+{
+    VARIANT v, len;
+    IDispatch *array;
+    WCHAR **names;
+    unsigned i, n;
+    HRESULT hres;
+
+    *filter = NULL;
+    *cnt = 0;
+    hres = mo_get_option(options, L"attributeFilter", &v);
+    if(hres != S_OK)
+        return hres;
+    if(V_VT(&v) != VT_DISPATCH || !V_DISPATCH(&v)) {
+        VariantClear(&v);
+        return S_FALSE;
+    }
+    array = V_DISPATCH(&v);
+
+    hres = mo_get_option(array, L"length", &len);
+    if(hres != S_OK) {
+        IDispatch_Release(array);
+        return hres;
+    }
+    {
+        VARIANT l;
+        V_VT(&l) = VT_EMPTY;
+        hres = VariantChangeType(&l, &len, 0, VT_I4);
+        VariantClear(&len);
+        if(FAILED(hres)) {
+            IDispatch_Release(array);
+            return hres;
+        }
+        n = V_I4(&l) > 0 ? V_I4(&l) : 0;
+    }
+
+    names = calloc(n + 1, sizeof(*names));
+    if(!names) {
+        IDispatch_Release(array);
+        return E_OUTOFMEMORY;
+    }
+    for(i = 0; i < n; i++) {
+        WCHAR idx[16];
+        VARIANT item, str;
+
+        swprintf(idx, ARRAY_SIZE(idx), L"%u", i);
+        hres = mo_get_option(array, idx, &item);
+        if(hres != S_OK)
+            continue;
+        V_VT(&str) = VT_EMPTY;
+        if(SUCCEEDED(VariantChangeType(&str, &item, 0, VT_BSTR)) && V_BSTR(&str))
+            names[(*cnt)++] = wcsdup(V_BSTR(&str));
+        VariantClear(&str);
+        VariantClear(&item);
+    }
+    IDispatch_Release(array);
+    *filter = names;
+    return S_OK;
+}
