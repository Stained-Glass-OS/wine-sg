diff --git a/dlls/mshtml/mshtml_private_iface.idl b/dlls/mshtml/mshtml_private_iface.idl
index 5214315..9fe0447 100644
--- a/dlls/mshtml/mshtml_private_iface.idl
+++ b/dlls/mshtml/mshtml_private_iface.idl
@@ -94,6 +94,35 @@ interface IWineMSHTMLMutationObserver : IDispatch
     HRESULT takeRecords([retval, out] IDispatch **records);
 }
 
+[
+    odl,
+    oleautomation,
+    dual,
+    hidden,
+    uuid(c660ee9a-fe13-4533-b8ff-12aa6b193e85)
+]
+interface IWineMSHTMLMutationRecord : IDispatch
+{
+    [propget, id(1)]
+    HRESULT type([retval, out] BSTR *p);
+    [propget, id(2)]
+    HRESULT target([retval, out] IHTMLDOMNode **p);
+    [propget, id(3)]
+    HRESULT addedNodes([retval, out] IDispatch **p);
+    [propget, id(4)]
+    HRESULT removedNodes([retval, out] IDispatch **p);
+    [propget, id(5)]
+    HRESULT previousSibling([retval, out] VARIANT *p);
+    [propget, id(6)]
+    HRESULT nextSibling([retval, out] VARIANT *p);
+    [propget, id(7)]
+    HRESULT attributeName([retval, out] VARIANT *p);
+    [propget, id(8)]
+    HRESULT attributeNamespace([retval, out] VARIANT *p);
+    [propget, id(9)]
+    HRESULT oldValue([retval, out] VARIANT *p);
+}
+
 [
     odl,
     oleautomation,
diff --git a/dlls/mshtml/mutation.c b/dlls/mshtml/mutation.c
index 6cc969c..a42fb0e 100644
--- a/dlls/mshtml/mutation.c
+++ b/dlls/mshtml/mutation.c
@@ -769,24 +769,35 @@ static nsrefcnt NSAPI nsDocumentObserver_Release(nsIDocumentObserver *iface)
     return IHTMLDOMNode_Release(&This->node.IHTMLDOMNode_iface);
 }
 
+static void mo_attribute_will_change(HTMLDocumentNode*,void*,nsIAtom*);
+static void mo_attribute_changed(HTMLDocumentNode*,void*,nsIAtom*);
+static void mo_chardata_will_change(HTMLDocumentNode*,nsIContent*);
+static void mo_chardata_changed(HTMLDocumentNode*,nsIContent*);
+static void mo_children_changed(HTMLDocumentNode*,nsIContent*,LONG,nsIContent*,nsIContent*,BOOL);
+static void mo_release_document(HTMLDocumentNode*);
+
 static void NSAPI nsDocumentObserver_CharacterDataWillChange(nsIDocumentObserver *iface,
