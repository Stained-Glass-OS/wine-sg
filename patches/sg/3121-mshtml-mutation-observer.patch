+/* A script array holding the nodes (or the records). */
+static HRESULT mo_create_array(HTMLInnerWindow *window, IDispatch **ret)
+{
+    VARIANT v;
+    HRESULT hres;
+
+    V_VT(&v) = VT_EMPTY;
+    hres = exec_script_expr(window, L"[]", &v);
+    if(FAILED(hres))
+        return hres;
+    if(V_VT(&v) != VT_DISPATCH || !V_DISPATCH(&v)) {
+        VariantClear(&v);
+        return E_FAIL;
+    }
+    *ret = V_DISPATCH(&v);
+    return S_OK;
+}
+
+static HRESULT mo_array_push(IDispatch *array, IDispatch *item)
+{
+    static const WCHAR *push = L"push";
+    VARIANT arg;
+    DISPPARAMS dp = { &arg, NULL, 1, 0 };
+    DISPID id;
+    HRESULT hres;
+
+    hres = IDispatch_GetIDsOfNames(array, &IID_NULL, (WCHAR**)&push, 1, LOCALE_USER_DEFAULT, &id);
+    if(FAILED(hres))
+        return hres;
+    V_VT(&arg) = VT_DISPATCH;
+    V_DISPATCH(&arg) = item;
+    return IDispatch_Invoke(array, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &dp, NULL, NULL, NULL);
+}
+
+static HRESULT mo_node_array(HTMLInnerWindow *window, nsIDOMNode **nodes, unsigned cnt, IDispatch **ret)
+{
+    IDispatch *array;
+    unsigned i;
+    HRESULT hres;
+
+    hres = mo_create_array(window, &array);
+    if(FAILED(hres))
+        return hres;
+    for(i = 0; i < cnt; i++) {
+        HTMLDOMNode *node;
+
+        hres = get_node(nodes[i], TRUE, &node);
+        if(FAILED(hres))
+            break;
+        hres = mo_array_push(array, (IDispatch*)&node->IHTMLDOMNode_iface);
+        IHTMLDOMNode_Release(&node->IHTMLDOMNode_iface);
+        if(FAILED(hres))
+            break;
+    }
+    if(FAILED(hres)) {
+        IDispatch_Release(array);
+        return hres;
+    }
+    *ret = array;
+    return S_OK;
+}
+
+static HRESULT mo_node_iface(nsIDOMNode *nsnode, IHTMLDOMNode **ret)
+{
+    HTMLDOMNode *node;
+    HRESULT hres;
+
+    *ret = NULL;
+    if(!nsnode)
+        return S_OK;
+    hres = get_node(nsnode, TRUE, &node);
+    if(SUCCEEDED(hres))
+        *ret = &node->IHTMLDOMNode_iface;
+    return hres;
+}
+
+static HRESULT mo_create_record(struct mutation_observer *obs, HTMLInnerWindow *window, const struct mo_record *rec,
+                                IDispatch **ret)
+{
+    struct mutation_record *obj;
+    HRESULT hres;
+
+    if(!(obj = calloc(1, sizeof(*obj))))
+        return E_OUTOFMEMORY;
+    obj->IWineMSHTMLMutationRecord_iface.lpVtbl = &WineMSHTMLMutationRecordVtbl;
+    init_dispatch_with_owner(&obj->dispex, &MutationRecord_dispex, &obs->dispex);
+
+    switch(rec->type) {
+    case MO_REC_CHILD_LIST: obj->type = L"childList"; break;
+    case MO_REC_ATTRIBUTES: obj->type = L"attributes"; break;
+    default:                obj->type = L"characterData"; break;
+    }
+
+    hres = mo_node_iface(rec->target, &obj->target);
+    if(SUCCEEDED(hres)) hres = mo_node_iface(rec->prev, &obj->prev);
+    if(SUCCEEDED(hres)) hres = mo_node_iface(rec->next, &obj->next);
+    if(SUCCEEDED(hres)) hres = mo_node_array(window, rec->added, rec->added_cnt, &obj->added);
+    if(SUCCEEDED(hres)) hres = mo_node_array(window, rec->removed, rec->removed_cnt, &obj->removed);
+    if(SUCCEEDED(hres) && rec->attr_name && !(obj->attr_name = SysAllocString(rec->attr_name)))
+        hres = E_OUTOFMEMORY;
+    if(SUCCEEDED(hres) && rec->old_value && !(obj->old_value = SysAllocString(rec->old_value)))
+        hres = E_OUTOFMEMORY;
+    if(FAILED(hres)) {
+        IWineMSHTMLMutationRecord_Release(&obj->IWineMSHTMLMutationRecord_iface);
+        return hres;
+    }
+
+    *ret = (IDispatch*)&obj->IWineMSHTMLMutationRecord_iface;
+    return S_OK;
+}
+
+static HTMLInnerWindow *mo_window(struct mutation_observer *obs)
+{
+    struct mo_registration *reg;
+
+    if(list_empty(&obs->regs))
+        return NULL;
+    reg = LIST_ENTRY(list_head(&obs->regs), struct mo_registration, obs_entry);
+    return reg->doc->script_global;
+}
+
+/* Takes the queued records and returns them as a script array (NULL: nothing queued). */
+static HRESULT mo_take_records(struct mutation_observer *obs, IDispatch **ret)
+{
+    HTMLInnerWindow *window = mo_window(obs);
+    IDispatch *array;
+    struct mo_record *rec, *next;
+    HRESULT hres;
+
+    *ret = NULL;
+    if(!window || list_empty(&obs->records))
+        return S_FALSE;
+
+    hres = mo_create_array(window, &array);
+    if(FAILED(hres))
+        return hres;
+
+    LIST_FOR_EACH_ENTRY_SAFE(rec, next, &obs->records, struct mo_record, entry) {
+        IDispatch *disp;
+
+        list_remove(&rec->entry);
+        hres = mo_create_record(obs, window, rec, &disp);
+        mo_free_record(rec);
+        if(SUCCEEDED(hres)) {
+            hres = mo_array_push(array, disp);
+            IDispatch_Release(disp);
+        }
+        if(FAILED(hres))
+            WARN("record lost: %08lx\n", hres);
+    }
+    *ret = array;
+    return S_OK;
+}
+
+struct mo_task {
+    task_t header;
+    struct mutation_observer *observer;
+};
+
+static void mo_task_proc(task_t *_task)
+{
+    struct mo_task *task = (struct mo_task*)_task;
+    struct mutation_observer *obs = task->observer;
+    IDispatch *records;
+
+    obs->task_pending = FALSE;
+    if(mo_take_records(obs, &records) == S_OK) {
+        VARIANT args[2];
+        DISPPARAMS dp = { args, NULL, 2, 0 };
+
+        V_VT(&args[0]) = VT_DISPATCH;
+        V_DISPATCH(&args[0]) = (IDispatch*)&obs->IWineMSHTMLMutationObserver_iface;
+        V_VT(&args[1]) = VT_DISPATCH;
+        V_DISPATCH(&args[1]) = records;
+        call_disp_func(obs->callback, &dp, NULL);
+        IDispatch_Release(records);
+    }
+}
+
+static void mo_task_destr(task_t *_task)
+{
+    struct mo_task *task = (struct mo_task*)_task;
+
+    task->observer->task_pending = FALSE;
+    IWineMSHTMLMutationObserver_Release(&task->observer->IWineMSHTMLMutationObserver_iface);
+    free(task);
+}
+
+static void mo_schedule(struct mutation_observer *obs, HTMLDocumentNode *doc)
+{
+    struct mo_task *task;
+
+    if(obs->task_pending || !doc->script_global)
+        return;
+    if(!(task = malloc(sizeof(*task))))
+        return;
+    task->observer = obs;
+    IWineMSHTMLMutationObserver_AddRef(&obs->IWineMSHTMLMutationObserver_iface);
+    if(FAILED(push_task(&task->header, mo_task_proc, mo_task_destr, doc->script_global->task_magic))) {
+        IWineMSHTMLMutationObserver_Release(&obs->IWineMSHTMLMutationObserver_iface);
+        free(task);
+        return;
+    }
+    obs->task_pending = TRUE;
+}
