From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] secur32, wininet, winhttp: TLS 1.3 for clients

schannel's protocol table stopped at TLS 1.2, so a client never offered TLS 1.3 even though
GnuTLS speaks it, and a server that takes only TLS 1.3 (claws-mail.org) failed with
SEC_E_ALGORITHM_MISMATCH / ERROR_INTERNET_SECURITY_CHANNEL_ERROR (12157). TLS 1.3 is now on
for clients by default, as in Windows 11; SCHANNEL\Protocols\TLS 1.3\Client Enabled and
DisabledByDefault turn it off as for the other versions. The server side stays off. A
connection's protocol is reported as SP_PROT_TLS1_3_CLIENT, version 0x304.

TLS 1.3 also ends the handshake differently: the client's Finished is its last message and
comes back with SEC_E_OK, not SEC_I_CONTINUE_NEEDED. wininet and winhttp sent output tokens
only while continuing, so the server never had the Finished and refused the first request
(bad record MAC). They now send a token that comes with SEC_E_OK.
---
--- a/dlls/secur32/schannel.c
+++ b/dlls/secur32/schannel.c
@@ -200,6 +200,12 @@
         { L"TLS 1.0",  SP_PROT_TLS1_0_CLIENT,  SP_PROT_TLS1_0_SERVER,  TRUE, FALSE },
         { L"TLS 1.1",  SP_PROT_TLS1_1_CLIENT,  SP_PROT_TLS1_1_SERVER,  TRUE, FALSE /* NOTE: not enabled by default on Windows */ },
         { L"TLS 1.2",  SP_PROT_TLS1_2_CLIENT,  SP_PROT_TLS1_2_SERVER,  TRUE, FALSE /* NOTE: not enabled by default on Windows */ },
+#ifndef SG_MUTANT_NO_TLS13_CLIENT
+        /* Stained Glass OS (8415): TLS 1.3 for clients, on by default as in Windows 11
+         * (Protocols\TLS 1.3\Client Enabled/DisabledByDefault still turn it off); the server
+         * side stays off, as it was. */
+        { L"TLS 1.3",  SP_PROT_TLS1_3_CLIENT,  SP_PROT_TLS1_3_SERVER,  TRUE, FALSE },
+#endif
         { L"DTLS 1.0", SP_PROT_DTLS1_0_CLIENT, SP_PROT_DTLS1_0_SERVER, TRUE, TRUE },
         { L"DTLS 1.2", SP_PROT_DTLS1_2_CLIENT, SP_PROT_DTLS1_2_SERVER, TRUE, TRUE },
     };
@@ -218,11 +224,13 @@
             for (server = 0; server < 2; server++) {
                 DWORD flag = server ? protocol_config_keys[i].prot_server_flag
                                     : protocol_config_keys[i].prot_client_flag;
+                BOOL default_on = protocol_config_keys[i].enabled &&
+                                  !(server && flag == SP_PROT_TLS1_3_SERVER);  /* 8415 */
                 wcscpy(subkey_name, protocol_config_keys[i].key_name);
                 wcscat(subkey_name, server ? L"\\Server" : L"\\Client");
                 res = RegOpenKeyExW(protocols_key, subkey_name, 0, KEY_READ, &key);
                 if(res != ERROR_SUCCESS) {
-                    if(protocol_config_keys[i].enabled)
+                    if(default_on)
                         enabled |= flag;
                     if(protocol_config_keys[i].disabled_by_default)
                         default_disabled |= flag;
@@ -234,7 +242,7 @@
                 if(res == ERROR_SUCCESS) {
                     if(type == REG_DWORD && value)
                         enabled |= flag;
-                }else if(protocol_config_keys[i].enabled) {
+                }else if(default_on) {
                     enabled |= flag;
                 }
 
@@ -255,7 +263,7 @@
         for(i = 0; i < ARRAY_SIZE(protocol_config_keys); i++) {
             DWORD flag = protocol_config_keys[i].prot_client_flag | protocol_config_keys[i].prot_server_flag;
             if(protocol_config_keys[i].enabled)
-                enabled |= flag;
+                enabled |= flag & ~SP_PROT_TLS1_3_SERVER;  /* 8415: TLS 1.3 for clients only */
             if(protocol_config_keys[i].disabled_by_default)
                 default_disabled |= flag;
         }
--- a/dlls/secur32/schannel_gnutls.c
+++ b/dlls/secur32/schannel_gnutls.c
@@ -723,6 +723,7 @@
     case GNUTLS_TLS1_0: return SP_PROT_TLS1_0_CLIENT;
     case GNUTLS_TLS1_1: return SP_PROT_TLS1_1_CLIENT;
     case GNUTLS_TLS1_2: return SP_PROT_TLS1_2_CLIENT;
+    case GNUTLS_TLS1_3: return SP_PROT_TLS1_3_CLIENT;
     case GNUTLS_DTLS1_0: return SP_PROT_DTLS1_0_CLIENT;
     case GNUTLS_DTLS1_2: return SP_PROT_DTLS1_2_CLIENT;
     default:
@@ -847,6 +848,7 @@
     case GNUTLS_TLS1_0:  return 0x301;
     case GNUTLS_TLS1_1:  return 0x302;
     case GNUTLS_TLS1_2:  return 0x303;
+    case GNUTLS_TLS1_3:  return 0x304;
     case GNUTLS_DTLS1_0: return 0x201;
     case GNUTLS_DTLS1_2: return 0x202;
     default:
--- a/dlls/wininet/netconnection.c
+++ b/dlls/wininet/netconnection.c
@@ -527,6 +527,24 @@
         TRACE("InitializeSecurityContext ret %08lx\n", status);
 
         if(status == SEC_E_OK) {
+#ifndef SG_MUTANT_TLS13_DROP_FINISHED
+            /* Stained Glass OS (8415): the handshake's last message can come with SEC_E_OK --
+             * TLS 1.3's client Finished does. Unsent, the server cannot read what follows. */
+            if(out_buf.cbBuffer) {
+                TRACE("sending %lu bytes\n", out_buf.cbBuffer);
+                size = sock_send(connection->socket, out_buf.pvBuffer, out_buf.cbBuffer, 0);
+                FreeContextBuffer(out_buf.pvBuffer);
+                if(size != out_buf.cbBuffer) {
+                    out_buf.pvBuffer = NULL;
+                    out_buf.cbBuffer = 0;
+                    ERR("send failed\n");
+                    status = ERROR_INTERNET_SECURITY_CHANNEL_ERROR;
+                    break;
+                }
+                out_buf.pvBuffer = NULL;
+                out_buf.cbBuffer = 0;
+            }
+#endif
             if(SecIsValidHandle(&connection->ssl_ctx))
                 DeleteSecurityContext(&connection->ssl_ctx);
             connection->ssl_ctx = ctx;
--- a/dlls/winhttp/net.c
+++ b/dlls/winhttp/net.c
@@ -470,6 +470,24 @@
         TRACE( "InitializeSecurityContext ret %#lx\n", status );
 
         if(status == SEC_E_OK) {
+#ifndef SG_MUTANT_TLS13_DROP_FINISHED
+            /* Stained Glass OS (8415): the handshake's last message can come with SEC_E_OK --
+             * TLS 1.3's client Finished does. Unsent, the server cannot read what follows. */
+            if(out_buf.cbBuffer) {
+                TRACE( "sending %lu bytes\n", out_buf.cbBuffer );
+                size = sock_send(conn->socket, out_buf.pvBuffer, out_buf.cbBuffer, NULL);
+                FreeContextBuffer(out_buf.pvBuffer);
+                if(size != out_buf.cbBuffer) {
+                    out_buf.pvBuffer = NULL;
+                    out_buf.cbBuffer = 0;
+                    ERR("send failed\n");
+                    res = ERROR_WINHTTP_SECURE_CHANNEL_ERROR;
+                    break;
+                }
+                out_buf.pvBuffer = NULL;
+                out_buf.cbBuffer = 0;
+            }
+#endif
             if(in_bufs[1].BufferType == SECBUFFER_EXTRA)
                 FIXME("SECBUFFER_EXTRA not supported\n");
 
