From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: IApplicationAssociationRegistration SetAppAsDefault and SetAppAsDefaultAll

- IApplicationAssociationRegistration::SetAppAsDefault and SetAppAsDefaultAll
  were E_NOTIMPL. SetAppAsDefault finds the application under
  HKCU/HKLM\Software\RegisteredApplications, follows its Capabilities key's
  FileAssociations (or URLAssociations) value for the extension (protocol)
  to the ProgId, and records it as the user's UserChoice (the same write
  "Always use this app" does, now SHELL_SetUserChoice beside
  SHELL_GetUserChoice). SetAppAsDefaultAll does it for every file extension
  and URL protocol the application registers. An application not registered, or
  one that does not declare the association, is
  HRESULT_FROM_WIN32(ERROR_NO_ASSOCIATION).

Gate: test/appdefault-gate.sh (test/appdefault-probe.c). Mutant
SG_MUTANT_SETAPPDEFAULT fails it. Wine's shell32 tests assoc, shelllink,
shlexec: no failures.
---
--- a/dlls/shell32/assoc.c
+++ b/dlls/shell32/assoc.c
@@ -27,6 +27,7 @@
 #include "objbase.h"
 #include "shlguid.h"
 #include "shlwapi.h"
+#include "shlobj.h"
 #include "shobjidl.h"
 #include "shell32_main.h"
 #include "ver.h"
@@ -203,6 +204,113 @@ BOOL SHELL_GetUserChoice(const WCHAR *assoc, WCHAR *progid, DWORD len)
     return TRUE;
 }
 
+/**************************************************************************
+ *  SHELL_SetUserChoice [internal]
+ *
+ * The inverse of SHELL_GetUserChoice: record progid as the user's choice for
+ * assoc (a ".ext" or a protocol like "http"), as openwith.c's "always use
+ * this app" already did inline; ApplicationAssociationRegistration's
+ * SetAppAsDefault/SetAppAsDefaultAll (patch 2001) share it.
+ */
+BOOL SHELL_SetUserChoice(const WCHAR *assoc, const WCHAR *progid)
+{
+    WCHAR path[MAX_PATH + 96];
+
+#ifdef SG_MUTANT_SETAPPDEFAULT
+    return FALSE;
+#endif
+    if (!assoc || !*assoc || *assoc == '{' || wcslen(assoc) > MAX_PATH || !progid) return FALSE;
+    if (*assoc == '.')
+        swprintf(path, ARRAY_SIZE(path), L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FileExts\\%s\\UserChoice", assoc);
+    else
+        swprintf(path, ARRAY_SIZE(path), L"Software\\Microsoft\\Windows\\Shell\\Associations\\UrlAssociations\\%s\\UserChoice", assoc);
+    if (RegSetKeyValueW(HKEY_CURRENT_USER, path, L"ProgId", REG_SZ, progid, (lstrlenW(progid) + 1) * sizeof(WCHAR)))
+        return FALSE;
+    SHChangeNotify(SHCNE_ASSOCCHANGED, SHCNF_IDLIST, NULL, NULL);
+    return TRUE;
+}
+
+/**************************************************************************
+ *  lookup_registered_app_progid [internal]
+ *
+ * appname is a value name under RegisteredApplications (HKCU, then HKLM);
+ * its data names a Capabilities key whose FileAssociations (file
+ * extensions) or URLAssociations (protocols) subkey maps assoc to the
+ * ProgId SetAppAsDefault/SetAppAsDefaultAll should record as the user's
+ * choice for it.
+ */
+static HRESULT lookup_registered_app_progid(const WCHAR *appname, BOOL is_url,
+        const WCHAR *assoc, WCHAR *progid, DWORD len)
+{
+    static const WCHAR reg_apps[] = L"Software\\RegisteredApplications";
+    static const HKEY roots[] = { HKEY_CURRENT_USER, HKEY_LOCAL_MACHINE };
+    WCHAR caps_path[MAX_PATH], assoc_path[MAX_PATH + 32];
+    DWORD size, i;
+
+    for (i = 0; i < ARRAY_SIZE(roots); i++)
+    {
+        size = sizeof(caps_path);
+        if (RegGetValueW(roots[i], reg_apps, appname, RRF_RT_REG_SZ, NULL, caps_path, &size))
+            continue;
+
+        swprintf(assoc_path, ARRAY_SIZE(assoc_path), L"%s\\%s", caps_path,
+                 is_url ? L"URLAssociations" : L"FileAssociations");
+        size = len * sizeof(WCHAR);
+        if (!RegGetValueW(HKEY_LOCAL_MACHINE, assoc_path, assoc, RRF_RT_REG_SZ, NULL, progid, &size) && *progid)
+            return S_OK;
+        size = len * sizeof(WCHAR);
+        if (!RegGetValueW(HKEY_CURRENT_USER, assoc_path, assoc, RRF_RT_REG_SZ, NULL, progid, &size) && *progid)
+            return S_OK;
+    }
+
+    return HRESULT_FROM_WIN32(ERROR_NO_ASSOCIATION);
+}
+
+/* Every value name under a Capabilities\*Associations key of appname, used
+ * by SetAppAsDefaultAll (every association the app declares). */
+static HRESULT for_each_app_association(const WCHAR *appname, BOOL is_url,
+        HRESULT (*cb)(const WCHAR *assoc, const WCHAR *progid, void *arg), void *arg)
+{
+    static const WCHAR reg_apps[] = L"Software\\RegisteredApplications";
+    static const HKEY roots[] = { HKEY_CURRENT_USER, HKEY_LOCAL_MACHINE };
+    WCHAR caps_path[MAX_PATH], assoc_path[MAX_PATH + 32];
+    DWORD size, i, idx;
+    HRESULT hr = HRESULT_FROM_WIN32(ERROR_NO_ASSOCIATION);
+
+    for (i = 0; i < ARRAY_SIZE(roots); i++)
+    {
+        HKEY hkey;
+
+        size = sizeof(caps_path);
+        if (RegGetValueW(roots[i], reg_apps, appname, RRF_RT_REG_SZ, NULL, caps_path, &size))
+            continue;
+
+        swprintf(assoc_path, ARRAY_SIZE(assoc_path), L"%s\\%s", caps_path,
+                 is_url ? L"URLAssociations" : L"FileAssociations");
+        if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, assoc_path, 0, KEY_READ, &hkey))
+            continue;
+
+        for (idx = 0; ; idx++)
+        {
+            WCHAR assoc[MAX_PATH], progid[MAX_PATH];
+            DWORD assoc_len = ARRAY_SIZE(assoc), progid_size = sizeof(progid), type;
+
+            if (RegEnumValueW(hkey, idx, assoc, &assoc_len, NULL, &type, (BYTE *)progid, &progid_size))
+                break;
+            if (type != REG_SZ) continue;
+            if (SUCCEEDED(cb(assoc, progid, arg))) hr = S_OK;
+        }
+        RegCloseKey(hkey);
+    }
+
+    return hr;
+}
+
+static HRESULT set_app_association_cb(const WCHAR *assoc, const WCHAR *progid, void *arg)
+{
+    return SHELL_SetUserChoice(assoc, progid) ? S_OK : E_FAIL;
+}
+
 static HRESULT WINAPI IQueryAssociations_fnInit(
   IQueryAssociations *iface,
   ASSOCF cfFlags,
@@ -1015,14 +1123,44 @@ static HRESULT WINAPI ApplicationAssociationRegistration_QueryAppIsDefaultAll(IA
 static HRESULT WINAPI ApplicationAssociationRegistration_SetAppAsDefault(IApplicationAssociationRegistration* This, LPCWSTR appname,
                                                                          LPCWSTR set, ASSOCIATIONTYPE set_type)
 {
-    FIXME("(%p)->(%s, %s, %d)\n", This, debugstr_w(appname), debugstr_w(set), set_type);
+    TRACE("(%p)->(%s, %s, %d)\n", This, debugstr_w(appname), debugstr_w(set), set_type);
+
+    if (!appname || !set)
+        return E_INVALIDARG;
+#ifdef SG_MUTANT_SETAPPDEFAULT
     return E_NOTIMPL;
+#else
+    {
+        WCHAR progid[MAX_PATH];
+        HRESULT hr;
+
+        if (set_type != AT_FILEEXTENSION && set_type != AT_URLPROTOCOL)
+        {
+            FIXME("association type %d not supported\n", set_type);
+            return E_NOTIMPL;
+        }
+
+        hr = lookup_registered_app_progid(appname, set_type == AT_URLPROTOCOL, set, progid, ARRAY_SIZE(progid));
+        if (FAILED(hr))
+            return hr;
+
+        return SHELL_SetUserChoice(set, progid) ? S_OK : E_FAIL;
+    }
+#endif
 }
 
 static HRESULT WINAPI ApplicationAssociationRegistration_SetAppAsDefaultAll(IApplicationAssociationRegistration* This, LPCWSTR appname)
 {
-    FIXME("(%p)->(%s)\n", This, debugstr_w(appname));
-    return E_NOTIMPL;
+    HRESULT hr1, hr2;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_w(appname));
+
+    if (!appname)
+        return E_INVALIDARG;
+
+    hr1 = for_each_app_association(appname, FALSE, set_app_association_cb, NULL);
+    hr2 = for_each_app_association(appname, TRUE, set_app_association_cb, NULL);
+    return (SUCCEEDED(hr1) || SUCCEEDED(hr2)) ? S_OK : hr1;
 }
 
 
--- a/dlls/shell32/shell32_main.h
+++ b/dlls/shell32/shell32_main.h
@@ -105,6 +105,7 @@ HRESULT WINAPI CompressedFolder_Constructor(IUnknown *outer, REFIID riid, void *
 HRESULT SHELL_CreateHDropDataObject(const WCHAR *paths, IDataObject **ret);
 HRESULT WINAPI QueryAssociations_Constructor(IUnknown *pUnkOuter, REFIID riid, LPVOID *ppOutput);
 BOOL SHELL_GetUserChoice(const WCHAR *assoc, WCHAR *progid, DWORD len);
+BOOL SHELL_SetUserChoice(const WCHAR *assoc, const WCHAR *progid);
 HRESULT WINAPI ExplorerBrowser_Constructor(IUnknown *pUnkOuter, REFIID riid, LPVOID *ppv);
 HRESULT WINAPI KnownFolderManager_Constructor(IUnknown *pUnkOuter, REFIID riid, LPVOID *ppv);
 HRESULT WINAPI IFileOperation_Constructor(IUnknown *outer, REFIID riid, void **out);
