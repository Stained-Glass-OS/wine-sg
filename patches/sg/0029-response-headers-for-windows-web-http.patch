+/* WinRT Windows.Web.Http.Headers.HttpResponseHeaderCollection implementation.
+ *
+ * The response headers, parsed from winhttp's raw header block. The default
+ * interface is the typed IHttpResponseHeaderCollection; the map face
+ * (IMap<HSTRING, HSTRING>) is how a caller looks a header up by name.
+ *
+ * Copyright (C) 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or modify it under
+ * the terms of the GNU Lesser General Public License as published by the Free
+ * Software Foundation; either version 2.1 of the License, or (at your option)
+ * any later version.
+ */
+
+#include <stdlib.h>
+#include <wchar.h>
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(web);
+
+struct rheader { WCHAR *name, *value; };
+
+struct response_headers
+{
+    IHttpResponseHeaderCollection IHttpResponseHeaderCollection_iface;
+    IMap_HSTRING_HSTRING IMap_HSTRING_HSTRING_iface;
+    IIterable_IKeyValuePair_HSTRING_HSTRING IIterable_IKeyValuePair_HSTRING_HSTRING_iface;
+    LONG ref;
+    struct rheader *headers;
+    unsigned int count;
+};
+
+static struct response_headers *impl_from_typed( IHttpResponseHeaderCollection *iface )
+{
+    return CONTAINING_RECORD( iface, struct response_headers, IHttpResponseHeaderCollection_iface );
+}
+static struct response_headers *impl_from_map( IMap_HSTRING_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct response_headers, IMap_HSTRING_HSTRING_iface );
+}
+
+static HRESULT rh_QI( struct response_headers *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IHttpResponseHeaderCollection ))
+    {
+        *out = &impl->IHttpResponseHeaderCollection_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IMap_HSTRING_HSTRING ))
+    {
+        *out = &impl->IMap_HSTRING_HSTRING_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IIterable_IKeyValuePair_HSTRING_HSTRING ))
+    {
+        *out = &impl->IIterable_IKeyValuePair_HSTRING_HSTRING_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG rh_release( struct response_headers *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        unsigned int i;
+        for (i = 0; i < impl->count; i++) { free( impl->headers[i].name ); free( impl->headers[i].value ); }
+        free( impl->headers );
+        free( impl );
+    }
+    return ref;
+}
+
+/* case-insensitive header lookup */
+static struct rheader *rh_find( struct response_headers *impl, HSTRING key )
+{
+    const WCHAR *k = WindowsGetStringRawBuffer( key, NULL );
+    unsigned int i;
+    if (!k) return NULL;
+    for (i = 0; i < impl->count; i++)
+        if (!wcsicmp( impl->headers[i].name, k )) return &impl->headers[i];
+    return NULL;
+}
+
+/* ---- primary: IHttpResponseHeaderCollection ---------------------------- */
+static HRESULT WINAPI trh_QueryInterface( IHttpResponseHeaderCollection *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s.\n", iface, debugstr_guid( iid ) );
+    return rh_QI( impl_from_typed( iface ), iid, out );
+}
+static ULONG WINAPI trh_AddRef( IHttpResponseHeaderCollection *iface ) { return InterlockedIncrement( &impl_from_typed( iface )->ref ); }
+static ULONG WINAPI trh_Release( IHttpResponseHeaderCollection *iface ) { return rh_release( impl_from_typed( iface ) ); }
+static HRESULT WINAPI trh_GetIids( IHttpResponseHeaderCollection *iface, ULONG *c, IID **i ) { return E_NOTIMPL; }
+static HRESULT WINAPI trh_GetRuntimeClassName( IHttpResponseHeaderCollection *iface, HSTRING *n ) { return E_NOTIMPL; }
+static HRESULT WINAPI trh_GetTrustLevel( IHttpResponseHeaderCollection *iface, TrustLevel *t ) { *t = BaseTrust; return S_OK; }
+
+#define RH_GET( Name ) \
+    static HRESULT WINAPI trh_get_##Name( IHttpResponseHeaderCollection *iface, IInspectable **value ) \
+    { TRACE( "iface %p, " #Name ".\n", iface ); return http_header_values_create( NULL, NULL, value ); }
+#define RH_SET( Name ) \
+    static HRESULT WINAPI trh_put_##Name( IHttpResponseHeaderCollection *iface, IInspectable *value ) \
+    { FIXME( "iface %p, " #Name " stub!\n", iface ); return S_OK; }
+
+RH_GET( Age ) RH_SET( Age )
+RH_GET( Allow )
+RH_GET( CacheControl )
+RH_GET( Connection )
+RH_GET( Date ) RH_SET( Date )
+RH_GET( Location ) RH_SET( Location )
+RH_GET( ProxyAuthenticate )
+RH_GET( RetryAfter ) RH_SET( RetryAfter )
+RH_GET( TransferEncoding )
+RH_GET( WwwAuthenticate )
+
+static HRESULT rh_store( struct response_headers *impl, HSTRING name, HSTRING value )
+{
+    const WCHAR *n = WindowsGetStringRawBuffer( name, NULL ), *v = WindowsGetStringRawBuffer( value, NULL );
+    struct rheader *grown = realloc( impl->headers, (impl->count + 1) * sizeof(*grown) );
+    if (!grown) return E_OUTOFMEMORY;
+    impl->headers = grown;
+    impl->headers[impl->count].name = wcsdup( n ? n : L"" );
+    impl->headers[impl->count].value = wcsdup( v ? v : L"" );
+    impl->count++;
+    return S_OK;
+}
+static HRESULT WINAPI trh_Append( IHttpResponseHeaderCollection *iface, HSTRING name, HSTRING value )
+{
+    return rh_store( impl_from_typed( iface ), name, value );
+}
+static HRESULT WINAPI trh_TryAppendWithoutValidation( IHttpResponseHeaderCollection *iface, HSTRING name, HSTRING value, boolean *success )
+{
+    *success = SUCCEEDED( rh_store( impl_from_typed( iface ), name, value ) );
+    return S_OK;
+}
+
+static const struct IHttpResponseHeaderCollectionVtbl trh_vtbl =
+{
+    trh_QueryInterface, trh_AddRef, trh_Release, trh_GetIids, trh_GetRuntimeClassName, trh_GetTrustLevel,
+    trh_get_Age, trh_put_Age, trh_get_Allow, trh_get_CacheControl, trh_get_Connection,
+    trh_get_Date, trh_put_Date, trh_get_Location, trh_put_Location, trh_get_ProxyAuthenticate,
+    trh_get_RetryAfter, trh_put_RetryAfter, trh_get_TransferEncoding, trh_get_WwwAuthenticate,
+    trh_Append, trh_TryAppendWithoutValidation,
+};
+
+/* ---- secondary: IMap<HSTRING, HSTRING> --------------------------------- */
+static HRESULT WINAPI map_QueryInterface( IMap_HSTRING_HSTRING *iface, REFIID iid, void **out )
+{ return rh_QI( impl_from_map( iface ), iid, out ); }
+static ULONG WINAPI map_AddRef( IMap_HSTRING_HSTRING *iface ) { return InterlockedIncrement( &impl_from_map( iface )->ref ); }
+static ULONG WINAPI map_Release( IMap_HSTRING_HSTRING *iface ) { return rh_release( impl_from_map( iface ) ); }
+static HRESULT WINAPI map_GetIids( IMap_HSTRING_HSTRING *iface, ULONG *c, IID **i ) { return E_NOTIMPL; }
+static HRESULT WINAPI map_GetRuntimeClassName( IMap_HSTRING_HSTRING *iface, HSTRING *n ) { return E_NOTIMPL; }
+static HRESULT WINAPI map_GetTrustLevel( IMap_HSTRING_HSTRING *iface, TrustLevel *t ) { *t = BaseTrust; return S_OK; }
+static HRESULT WINAPI map_Lookup( IMap_HSTRING_HSTRING *iface, HSTRING key, HSTRING *value )
+{
+    struct response_headers *impl = impl_from_map( iface );
+    struct rheader *h = rh_find( impl, key );
+    TRACE( "iface %p, key %s.\n", iface, debugstr_hstring( key ) );
+    if (!h) { *value = NULL; return E_BOUNDS; }
+    return WindowsCreateString( h->value, wcslen( h->value ), value );
+}
+static HRESULT WINAPI map_get_Size( IMap_HSTRING_HSTRING *iface, UINT32 *size )
+{ *size = impl_from_map( iface )->count; return S_OK; }
+static HRESULT WINAPI map_HasKey( IMap_HSTRING_HSTRING *iface, HSTRING key, boolean *found )
+{
+    struct response_headers *impl = impl_from_map( iface );
+    TRACE( "iface %p, key %s.\n", iface, debugstr_hstring( key ) );
+    *found = !!rh_find( impl, key );
+    return S_OK;
+}
+static HRESULT WINAPI map_GetView( IMap_HSTRING_HSTRING *iface, IMapView_HSTRING_HSTRING **view ) { *view = NULL; return E_NOTIMPL; }
+static HRESULT WINAPI map_Insert( IMap_HSTRING_HSTRING *iface, HSTRING key, HSTRING value, boolean *replaced ) { *replaced = FALSE; return rh_store( impl_from_map( iface ), key, value ); }
+static HRESULT WINAPI map_Remove( IMap_HSTRING_HSTRING *iface, HSTRING key ) { return S_OK; }
+static HRESULT WINAPI map_Clear( IMap_HSTRING_HSTRING *iface ) { return S_OK; }
+
+static const struct IMap_HSTRING_HSTRINGVtbl map_vtbl =
+{
+    map_QueryInterface, map_AddRef, map_Release, map_GetIids, map_GetRuntimeClassName, map_GetTrustLevel,
+    map_Lookup, map_get_Size, map_HasKey, map_GetView, map_Insert, map_Remove, map_Clear,
+};
+
+
+/* ---- IKeyValuePair<HSTRING, HSTRING> ----------------------------------- */
+struct rh_pair
+{
+    IKeyValuePair_HSTRING_HSTRING IKeyValuePair_HSTRING_HSTRING_iface;
+    LONG ref;
+    WCHAR *key, *value;
+};
+static inline struct rh_pair *impl_from_pair( IKeyValuePair_HSTRING_HSTRING *iface )
+{ return CONTAINING_RECORD( iface, struct rh_pair, IKeyValuePair_HSTRING_HSTRING_iface ); }
+static HRESULT WINAPI pair_QueryInterface( IKeyValuePair_HSTRING_HSTRING *iface, REFIID iid, void **out )
+{
+    struct rh_pair *impl = impl_from_pair( iface );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IKeyValuePair_HSTRING_HSTRING ))
+    { *out = &impl->IKeyValuePair_HSTRING_HSTRING_iface; InterlockedIncrement( &impl->ref ); return S_OK; }
+    *out = NULL; return E_NOINTERFACE;
+}
+static ULONG WINAPI pair_AddRef( IKeyValuePair_HSTRING_HSTRING *iface ) { return InterlockedIncrement( &impl_from_pair( iface )->ref ); }
+static ULONG WINAPI pair_Release( IKeyValuePair_HSTRING_HSTRING *iface )
+{
+    struct rh_pair *impl = impl_from_pair( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) { free( impl->key ); free( impl->value ); free( impl ); }
+    return ref;
+}
+static HRESULT WINAPI pair_GetIids( IKeyValuePair_HSTRING_HSTRING *iface, ULONG *c, IID **i ) { return E_NOTIMPL; }
+static HRESULT WINAPI pair_GetRuntimeClassName( IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *n ) { return E_NOTIMPL; }
+static HRESULT WINAPI pair_GetTrustLevel( IKeyValuePair_HSTRING_HSTRING *iface, TrustLevel *t ) { *t = BaseTrust; return S_OK; }
+static HRESULT WINAPI pair_get_Key( IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *value )
+{ struct rh_pair *impl = impl_from_pair( iface ); return WindowsCreateString( impl->key, wcslen( impl->key ), value ); }
+static HRESULT WINAPI pair_get_Value( IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *value )
+{ struct rh_pair *impl = impl_from_pair( iface ); return WindowsCreateString( impl->value, wcslen( impl->value ), value ); }
+static const struct IKeyValuePair_HSTRING_HSTRINGVtbl pair_vtbl =
+{
+    pair_QueryInterface, pair_AddRef, pair_Release, pair_GetIids, pair_GetRuntimeClassName, pair_GetTrustLevel,
+    pair_get_Key, pair_get_Value,
+};
+static HRESULT pair_create( const WCHAR *key, const WCHAR *value, IKeyValuePair_HSTRING_HSTRING **out )
+{
+    struct rh_pair *impl = calloc( 1, sizeof(*impl) );
+    if (!impl) return E_OUTOFMEMORY;
+    impl->IKeyValuePair_HSTRING_HSTRING_iface.lpVtbl = &pair_vtbl;
+    impl->ref = 1;
+    impl->key = wcsdup( key ); impl->value = wcsdup( value );
+    *out = &impl->IKeyValuePair_HSTRING_HSTRING_iface;
+    return S_OK;
+}
+
+/* ---- IIterator<IKeyValuePair<HSTRING, HSTRING>> ------------------------ */
+struct rh_iterator
+{
+    IIterator_IKeyValuePair_HSTRING_HSTRING IIterator_IKeyValuePair_HSTRING_HSTRING_iface;
+    LONG ref;
+    struct response_headers *coll;
+    unsigned int index;
+};
+static inline struct rh_iterator *impl_from_iterator( IIterator_IKeyValuePair_HSTRING_HSTRING *iface )
+{ return CONTAINING_RECORD( iface, struct rh_iterator, IIterator_IKeyValuePair_HSTRING_HSTRING_iface ); }
+static HRESULT WINAPI iter_QueryInterface( IIterator_IKeyValuePair_HSTRING_HSTRING *iface, REFIID iid, void **out )
