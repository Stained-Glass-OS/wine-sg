+/* Build the collection from winhttp's raw "Name: Value\r\n..." header block. */
+HRESULT http_response_headers_create( const WCHAR *raw, IHttpResponseHeaderCollection **out )
+{
+    struct response_headers *impl;
+    const WCHAR *p = raw;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IHttpResponseHeaderCollection_iface.lpVtbl = &trh_vtbl;
+    impl->IMap_HSTRING_HSTRING_iface.lpVtbl = &map_vtbl;
+    impl->IIterable_IKeyValuePair_HSTRING_HSTRING_iface.lpVtbl = &itbl_vtbl;
+    impl->ref = 1;
+
+    while (p && *p)
+    {
+        const WCHAR *eol = wcschr( p, '\n' ), *colon;
+        size_t linelen = eol ? (size_t)(eol - p) : wcslen( p );
+        while (linelen && (p[linelen-1] == '\r')) linelen--;
+        colon = wmemchr( p, ':', linelen );
+        if (colon && colon > p)
+        {
+            struct rheader *grown = realloc( impl->headers, (impl->count + 1) * sizeof(*grown) );
+            const WCHAR *vs = colon + 1;
+            size_t nlen = colon - p, vlen;
+            while (vs < p + linelen && (*vs == ' ' || *vs == '\t')) vs++;
+            vlen = (p + linelen) - vs;
+            if (grown)
+            {
+                impl->headers = grown;
+                impl->headers[impl->count].name = malloc( (nlen + 1) * sizeof(WCHAR) );
+                impl->headers[impl->count].value = malloc( (vlen + 1) * sizeof(WCHAR) );
+                if (impl->headers[impl->count].name && impl->headers[impl->count].value)
+                {
+                    wmemcpy( impl->headers[impl->count].name, p, nlen ); impl->headers[impl->count].name[nlen] = 0;
+                    wmemcpy( impl->headers[impl->count].value, vs, vlen ); impl->headers[impl->count].value[vlen] = 0;
+                    impl->count++;
+                }
+            }
+        }
+        if (!eol) break;
+        p = eol + 1;
+    }
+
+    *out = &impl->IHttpResponseHeaderCollection_iface;
+    return S_OK;
+}
