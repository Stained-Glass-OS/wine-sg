From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: formats that do not convert, fixed palette flags, WMF header

Ground truth from Wine's gdiplus image tests (todo_wine blocks):
 - 16 bit gray and CMYK bitmaps can be made but not converted: locking them as
   another pixel format and CreateHBITMAPFromBitmap are InvalidParameter, a thumbnail
   is OutOfMemory, and saving a 16 bit gray bitmap fails.
 - GdipInitializePalette gives a fixed palette the flags (type << 8): 0x200 for black
   and white, 0x300 for the 8 colour halftone, 0x800 for the 252 colour one.
 - The header of a metafile made from a Windows metafile has the size in bytes and the
   version (0x300) of that metafile, also after cloning.
The matching todo_wine marks are removed.
---
--- a/dlls/gdiplus/gdiplus_private.h
+++ b/dlls/gdiplus/gdiplus_private.h
@@ -449,6 +449,8 @@ struct GpMetafile{
     MetafileType metafile_type;
     HENHMETAFILE hemf;
     int preserve_hemf; /* if true, hemf belongs to the app and should not be deleted */
+    DWORD wmf_size;    /* size and version of the Windows metafile this was made from */
+    DWORD wmf_version;
 
     /* recording */
     HDC record_dc;
--- a/dlls/gdiplus/image.c
+++ b/dlls/gdiplus/image.c
@@ -1104,6 +1104,15 @@ GpStatus convert_pixels(INT width, INT height,
  * privileges can write to the whole bitmap (not just the area in rect).
  *
  * FIXME: only used portion of format is bits per pixel. */
+/* Windows does not convert from or to these: asking for it is a parameter error. */
+static BOOL pixel_format_converts(PixelFormat format)
+{
+#ifdef SG_MUTANT_GP_CONVERT_ALL
+    return TRUE;
+#endif
+    return format != PixelFormat16bppGrayScale && format != PixelFormat32bppCMYK;
+}
+
 GpStatus WINGDIPAPI GdipBitmapLockBits(GpBitmap* bitmap, GDIPCONST GpRect* rect,
     UINT flags, PixelFormat format, BitmapData* lockeddata)
 {
@@ -1158,6 +1167,12 @@ GpStatus WINGDIPAPI GdipBitmapLockBits(GpBitmap* bitmap, GDIPCONST GpRect* rect,
         return Ok;
     }
 
+    if (!pixel_format_converts(format) || !pixel_format_converts(bitmap->format))
+    {
+        image_unlock(&bitmap->image);
+        return InvalidParameter;
+    }
+
     /* Make sure we can convert to the requested format. */
     if (flags & ImageLockModeRead)
     {
@@ -1415,6 +1430,8 @@ GpStatus WINGDIPAPI GdipCloneImage(GpImage *image, GpImage **cloneImage)
         result->bounds = metafile->bounds;
         result->unit = metafile->unit;
         result->metafile_type = metafile->metafile_type;
+        result->wmf_size = metafile->wmf_size;
+        result->wmf_version = metafile->wmf_version;
         result->hemf = CopyEnhMetaFileW(metafile->hemf, NULL);
         list_init(&result->containers);
 
@@ -1550,6 +1567,7 @@ GpStatus WINGDIPAPI GdipCreateHBITMAPFromBitmap(GpBitmap* bitmap,
     TRACE("(%p,%p,%lx)\n", bitmap, hbmReturn, background);
 
     if (!bitmap || !hbmReturn) return InvalidParameter;
+    if (!pixel_format_converts(bitmap->format)) return InvalidParameter;
     if (!image_lock(&bitmap->image)) return ObjectBusy;
 
     GdipGetImageWidth(&bitmap->image, &width);
@@ -5753,6 +5771,9 @@ GpStatus WINGDIPAPI GdipGetImageThumbnail(GpImage *image, UINT width, UINT heigh
     if (!width) width = 120;
     if (!height) height = 120;
 
+    if (image->type == ImageTypeBitmap && !pixel_format_converts(((GpBitmap *)image)->format))
+        return OutOfMemory;
+
     GdipGetImageWidth(image, &srcwidth);
     GdipGetImageHeight(image, &srcheight);
 
@@ -6146,7 +6167,12 @@ GpStatus WINGDIPAPI GdipInitializePalette(ColorPalette *palette,
 
         if (palette->Count >= wic_palette->Count)
         {
+            /* the flags of a fixed palette tell its type */
+#ifdef SG_MUTANT_GP_PALETTE_FLAGS
             palette->Flags = wic_palette->Flags;
+#else
+            palette->Flags = (UINT)type << 8;
+#endif
             palette->Count = wic_palette->Count;
             memcpy(palette->Entries, wic_palette->Entries, wic_palette->Count * sizeof(wic_palette->Entries[0]));
         }
--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -4091,6 +4091,13 @@ GpStatus WINGDIPAPI GdipGetMetafileHeaderFromMetafile(GpMetafile * metafile,
     }
 
     header->Type = metafile->metafile_type;
+#ifndef SG_MUTANT_GP_WMF_HEADER
+    if (metafile->wmf_size)
+    {
+        header->Size = metafile->wmf_size;
+        header->Version = metafile->wmf_version;
+    }
+#endif
     header->DpiX = metafile->image.xres;
     header->DpiY = metafile->image.yres;
     header->Width = gdip_round(metafile->bounds.Width);
@@ -4294,6 +4301,7 @@ GpStatus WINGDIPAPI GdipCreateMetafileFromWmf(HMETAFILE hwmf, BOOL delete,
     BYTE *copy;
     HENHMETAFILE hemf;
     GpStatus retval = Ok;
+    DWORD wmf_version;
 
     TRACE("(%p, %d, %p, %p)\n", hwmf, delete, placeable, metafile);
 
@@ -4308,6 +4316,7 @@ GpStatus WINGDIPAPI GdipCreateMetafileFromWmf(HMETAFILE hwmf, BOOL delete,
     GetMetaFileBitsEx(hwmf, read, copy);
 
     hemf = SetWinMetaFileBits(read, copy, NULL, NULL);
+    wmf_version = read >= sizeof(METAHEADER) ? ((METAHEADER *)copy)->mtVersion : 0;
     free(copy);
 
     /* FIXME: We should store and use hwmf instead of converting to hemf */
@@ -4315,6 +4324,8 @@ GpStatus WINGDIPAPI GdipCreateMetafileFromWmf(HMETAFILE hwmf, BOOL delete,
 
     if (retval == Ok)
     {
+        (*metafile)->wmf_size = read;
+        (*metafile)->wmf_version = wmf_version;
         if (placeable)
         {
             (*metafile)->image.xres = (REAL)placeable->Inch;
--- a/dlls/gdiplus/tests/image.c
+++ b/dlls/gdiplus/tests/image.c
@@ -1885,8 +1885,8 @@ static void test_loadwmf(void)
     if (stat == Ok)
     {
         expect(MetafileTypeWmfPlaceable, header.Type);
-        todo_wine expect(sizeof(wmfimage)-sizeof(WmfPlaceableFileHeader), header.Size);
-        todo_wine expect(0x300, header.Version);
+        expect(sizeof(wmfimage)-sizeof(WmfPlaceableFileHeader), header.Size);
+        expect(0x300, header.Version);
         expect(0, header.EmfPlusFlags);
         expectf(1440.0, header.DpiX);
         expectf(1440.0, header.DpiY);
@@ -1943,8 +1943,8 @@ static void test_createfromwmf(void)
     if (stat == Ok)
     {
         expect(MetafileTypeWmfPlaceable, header.Type);
-        todo_wine expect(sizeof(wmfimage)-sizeof(WmfPlaceableFileHeader), header.Size);
-        todo_wine expect(0x300, header.Version);
+        expect(sizeof(wmfimage)-sizeof(WmfPlaceableFileHeader), header.Size);
+        expect(0x300, header.Version);
         expect(0, header.EmfPlusFlags);
         expectf(1440.0, header.DpiX);
         expectf(1440.0, header.DpiY);
@@ -4760,7 +4760,7 @@ static void test_image_format(void)
 
         status = GdipCreateHBITMAPFromBitmap(bitmap, &hbitmap, 0);
         if (fmt[i] == PixelFormat16bppGrayScale || fmt[i] == PixelFormat32bppCMYK)
-            todo_wine expect(InvalidParameter, status);
+            expect(InvalidParameter, status);
         else
         {
             expect(Ok, status);
@@ -4777,7 +4777,6 @@ static void test_image_format(void)
 
         status = GdipGetImageThumbnail((GpImage *)bitmap, 0, 0, &thumb, NULL, NULL);
         if (fmt[i] == PixelFormat16bppGrayScale || fmt[i] == PixelFormat32bppCMYK)
-            todo_wine
             ok(status == OutOfMemory || broken(status == InvalidParameter) /* before win7 */,
                "expected OutOfMemory, got %d\n", status);
         else
@@ -4794,7 +4793,7 @@ static void test_image_format(void)
 
         status = GdipBitmapLockBits(bitmap, NULL, ImageLockModeRead, PixelFormat32bppPARGB, &data);
         if (fmt[i] == PixelFormat16bppGrayScale || fmt[i] == PixelFormat32bppCMYK)
-            todo_wine expect(InvalidParameter, status);
+            expect(InvalidParameter, status);
         else
         {
             expect(Ok, status);
@@ -5955,7 +5954,6 @@ static void test_png_save_palette(void)
         status = GdipSaveImageToStream((GpImage *)bitmap, stream, &clsid, NULL);
         GdipDisposeImage((GpImage*)bitmap);
 
-        todo_wine_if(formats[i] == PixelFormat16bppGrayScale)
         ok(formats[i] == PixelFormat16bppGrayScale ?
                 (status == GenericError || status == Win32Error) : status == Ok,
             "Unexpected return value %d saving image for PixelFormat %#x\n", status, formats[i]);
@@ -6245,7 +6243,6 @@ static void test_GdipInitializePalette(void)
     palette->Count = 256;
     status = pGdipInitializePalette(palette, PaletteTypeFixedBW, 0, FALSE, bitmap);
     expect(Ok, status);
-    todo_wine
     expect(0x200, palette->Flags);
     expect(2, palette->Count);
     expect(0xff000000, palette->Entries[0]);
@@ -6256,7 +6253,6 @@ static void test_GdipInitializePalette(void)
     palette->Count = 256;
     status = pGdipInitializePalette(palette, PaletteTypeFixedHalftone8, 1, FALSE, NULL);
     expect(Ok, status);
-    todo_wine
     expect(0x300, palette->Flags);
     expect(16, palette->Count);
     expect(0xff000000, palette->Entries[0]);
@@ -6268,7 +6264,6 @@ static void test_GdipInitializePalette(void)
     palette->Count = 256;
     status = pGdipInitializePalette(palette, PaletteTypeFixedHalftone8, 1, FALSE, bitmap);
     expect(Ok, status);
-    todo_wine
     expect(0x300, palette->Flags);
     expect(16, palette->Count);
     expect(0xff000000, palette->Entries[0]);
@@ -6280,7 +6275,6 @@ static void test_GdipInitializePalette(void)
     palette->Count = 256;
     status = pGdipInitializePalette(palette, PaletteTypeFixedHalftone252, 1, FALSE, bitmap);
     expect(Ok, status);
-    todo_wine
     expect(0x800, palette->Flags);
     expect(252, palette->Count);
     expect(0xff000000, palette->Entries[0]);
