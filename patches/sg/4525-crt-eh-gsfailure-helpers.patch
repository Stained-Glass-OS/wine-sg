  *              _get_unexpected (MSVCRT.@)
  */
diff --git a/dlls/msvcrt/errno.c b/dlls/msvcrt/errno.c
index eb5dd77..ced913e 100644
--- a/dlls/msvcrt/errno.c
+++ b/dlls/msvcrt/errno.c
@@ -517,6 +517,31 @@ void CDECL _invoke_watson( const wchar_t *expr, const wchar_t *func, const wchar
     _exit( STATUS_INVALID_CRUNTIME_PARAMETER );
 }
 
+#if _MSVCR_VER >= 80
+/*********************************************************************
+ * __report_gsfailure (MSVCR80.@)
+ *
+ * A /GS stack cookie check failed: the process ends at once, as
+ * __fastfail(FAST_FAIL_STACK_COOKIE_CHECK_FAILURE) ends it.
+ */
+void CDECL __report_gsfailure( ULONG_PTR cookie )
+{
+    EXCEPTION_RECORD rec;
+
+    ERR( "stack cookie check failed\n" );
+    memset( &rec, 0, sizeof(rec) );
+    rec.ExceptionCode = STATUS_STACK_BUFFER_OVERRUN;
+    rec.ExceptionFlags = EXCEPTION_NONCONTINUABLE;
+    rec.ExceptionAddress = __builtin_return_address(0);
+    rec.NumberParameters = 1;
+    rec.ExceptionInformation[0] = 2;  /* FAST_FAIL_STACK_COOKIE_CHECK_FAILURE */
+#ifndef SG_MUTANT_GSFAILURE_RETURNS
+    RaiseFailFastException( &rec, NULL, 0 );
+    _exit( STATUS_STACK_BUFFER_OVERRUN );
+#endif
+}
+#endif
+
