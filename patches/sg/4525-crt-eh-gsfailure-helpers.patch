index 71bfa50..99473fd 100644
--- a/dlls/msvcrt/cpp.c
+++ b/dlls/msvcrt/cpp.c
@@ -660,6 +660,28 @@ unexpected_function CDECL set_unexpected(unexpected_function func)
     return previous;
 }
 
+#if _MSVCR_VER >= 80
+/*********************************************************************
+ *		?set_terminate@@YAP6AXXZH@Z (MSVCR80.@)
+ *
+ * The overload that lets set_terminate(0) compile: it resets the handler.
+ */
+terminate_function CDECL set_terminate_zero(int zero)
+{
+    if (zero) FIXME("(%d) not 0\n", zero);
+    return set_terminate(NULL);
+}
+
+/*********************************************************************
+ *		?set_unexpected@@YAP6AXXZH@Z (MSVCR80.@)
+ */
+unexpected_function CDECL set_unexpected_zero(int zero)
+{
+    if (zero) FIXME("(%d) not 0\n", zero);
+    return set_unexpected(NULL);
+}
+#endif
+
