+/* Hands the error the site remembered (or the exception of a failed call) to the caller. */
+static void script_report_error(IDirectMusicScriptImpl *This, DMUS_SCRIPT_ERRORINFO *out,
+        const EXCEPINFO *exc, HRESULT hr)
+{
+    if (!out) return;
+    if (This->site && This->site->has_error)
+    {
+        DMUS_SCRIPT_ERRORINFO *e = &This->site->error;
+        DWORD size = out->dwSize;
+        *out = *e;
+        out->dwSize = size ? size : sizeof(*out);
+    }
+    else if (exc && hr == DISP_E_EXCEPTION)
+        set_error_info(out, exc->scode ? exc->scode : E_FAIL, exc->bstrSource, exc->bstrDescription, 0, 0, NULL);
+    else
+        set_error_info(out, hr, NULL, NULL, 0, 0, NULL);
+    if (This->site) This->site->has_error = FALSE;
+}
+
+static HRESULT script_get_dispatch(IDirectMusicScriptImpl *This, IDispatch **disp)
+{
+    HRESULT hr;
+
+    if (!This->running) return DMUS_E_NOT_INIT;
+    if (FAILED(hr = IActiveScript_GetScriptDispatch(This->engine, NULL, disp))) return hr;
+    return S_OK;
+}
+
+static HRESULT script_get_id(IDispatch *disp, const WCHAR *name, DISPID *id, HRESULT not_found)
+{
+    HRESULT hr;
+
+    if (!name) return E_POINTER;
+    hr = IDispatch_GetIDsOfNames(disp, &IID_NULL, (WCHAR **)&name, 1, LOCALE_USER_DEFAULT, id);
+#ifdef SG_MUTANT_NOT_FOUND
+    if (hr == DISP_E_UNKNOWNNAME) return E_FAIL;
+#endif
+    if (hr == DISP_E_UNKNOWNNAME) return not_found;
+    return hr;
+}
+
 static HRESULT WINAPI IDirectMusicScriptImpl_Init(IDirectMusicScript *iface,
-        IDirectMusicPerformance *pPerformance, DMUS_SCRIPT_ERRORINFO *pErrorInfo)
+        IDirectMusicPerformance *performance, DMUS_SCRIPT_ERRORINFO *error_info)
 {
-  IDirectMusicScriptImpl *This = impl_from_IDirectMusicScript(iface);
-  FIXME("(%p, %p, %p): stub\n", This, pPerformance, pErrorInfo);
-  This->pPerformance = pPerformance;
-  return S_OK;
+    IDirectMusicScriptImpl *This = impl_from_IDirectMusicScript(iface);
+    IActiveScriptParse *parse;
+    EXCEPINFO exc = {0};
+    HRESULT hr;
+
+    TRACE("(%p, %p, %p)\n", This, performance, error_info);
+
+    if (!performance) return E_POINTER;
+    if (!This->engine) return DMUS_E_NOT_INIT;
+
+    if (This->running)
+    {
+        /* the script runs once; a later call only changes the performance */
+        IDirectMusicPerformance_AddRef(performance);
+        if (This->performance) IDirectMusicPerformance_Release(This->performance);
+        This->performance = performance;
+        return S_OK;
+    }
+
+    if (FAILED(hr = IActiveScript_QueryInterface(This->engine, &IID_IActiveScriptParse, (void **)&parse)))
+        return DMUS_E_SCRIPT_LANGUAGE_INCOMPATIBLE;
+
+    This->site->has_error = FALSE;
+    hr = IActiveScriptParse_ParseScriptText(parse, This->source ? This->source : L"", NULL, NULL, NULL,
+            0, 0, 0, NULL, &exc);
+    IActiveScriptParse_Release(parse);
+    if (SUCCEEDED(hr))
+        hr = IActiveScript_SetScriptState(This->engine, SCRIPTSTATE_CONNECTED);
+    /* an error in the global code is reported through the site, not the return value */
+#ifndef SG_MUTANT_INIT_GLOBAL_ERROR
+    if (SUCCEEDED(hr) && This->site->has_error) hr = This->site->error.hr;
+#endif
+    if (FAILED(hr))
+    {
+        script_report_error(This, error_info, &exc, hr);
+        SysFreeString(exc.bstrSource);
+        SysFreeString(exc.bstrDescription);
+        SysFreeString(exc.bstrHelpFile);
+        return DMUS_E_SCRIPT_ERROR_IN_SCRIPT;
+    }
+
+    IDirectMusicPerformance_AddRef(performance);
+    This->performance = performance;
+    This->running = TRUE;
+    return S_OK;
 }
 
 static HRESULT WINAPI IDirectMusicScriptImpl_CallRoutine(IDirectMusicScript *iface,
-        WCHAR *pwszRoutineName, DMUS_SCRIPT_ERRORINFO *pErrorInfo)
+        WCHAR *name, DMUS_SCRIPT_ERRORINFO *error_info)
+{
+    IDirectMusicScriptImpl *This = impl_from_IDirectMusicScript(iface);
+    DISPPARAMS params = {0};
+    EXCEPINFO exc = {0};
+    IDispatch *disp;
+    DISPID id;
+    HRESULT hr;
+
+    TRACE("(%p, %s, %p)\n", This, debugstr_w(name), error_info);
+
+    if (!name) return E_POINTER;
+    if (FAILED(hr = script_get_dispatch(This, &disp))) return hr;
+
+    if (SUCCEEDED(hr = script_get_id(disp, name, &id, DMUS_E_SCRIPT_ROUTINE_NOT_FOUND)))
+    {
+        This->site->has_error = FALSE;
+        hr = IDispatch_Invoke(disp, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &params,
+                NULL, &exc, NULL);
+        if (FAILED(hr))
+        {
+            script_report_error(This, error_info, &exc, hr);
+            hr = DMUS_E_SCRIPT_ERROR_IN_SCRIPT;
+        }
+        SysFreeString(exc.bstrSource);
+        SysFreeString(exc.bstrDescription);
+        SysFreeString(exc.bstrHelpFile);
+    }
+    IDispatch_Release(disp);
+    return hr;
+}
+
+static HRESULT script_put_variable(IDirectMusicScriptImpl *This, const WCHAR *name, VARIANT *value,
+        BOOL by_ref, DMUS_SCRIPT_ERRORINFO *error_info)
+{
+    DISPID named = DISPID_PROPERTYPUT;
+    DISPPARAMS params = {value, &named, 1, 1};
+    EXCEPINFO exc = {0};
+    IDispatch *disp;
+    DISPID id;
+    HRESULT hr;
+
+    if (FAILED(hr = script_get_dispatch(This, &disp))) return hr;
+    if (SUCCEEDED(hr = script_get_id(disp, name, &id, DMUS_E_SCRIPT_VARIABLE_NOT_FOUND)))
+    {
+        This->site->has_error = FALSE;
+        hr = IDispatch_Invoke(disp, id, &IID_NULL, LOCALE_USER_DEFAULT,
+                by_ref ? DISPATCH_PROPERTYPUTREF : DISPATCH_PROPERTYPUT, &params, NULL, &exc, NULL);
+        if (FAILED(hr))
+        {
+            script_report_error(This, error_info, &exc, hr);
+            hr = DMUS_E_SCRIPT_ERROR_IN_SCRIPT;
+        }
+        SysFreeString(exc.bstrSource);
+        SysFreeString(exc.bstrDescription);
+        SysFreeString(exc.bstrHelpFile);
+    }
+    IDispatch_Release(disp);
+    return hr;
+}
+
+static HRESULT script_get_variable(IDirectMusicScriptImpl *This, const WCHAR *name, VARIANT *value,
