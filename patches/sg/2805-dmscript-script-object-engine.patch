+    else if (FAILED(CLSIDFromProgID(This->language, &clsid)))
+        return DMUS_E_SCRIPT_LANGUAGE_INCOMPATIBLE;
+
+    if (FAILED(CoCreateInstance(&clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IActiveScript,
+            (void **)&This->engine)))
+        return DMUS_E_SCRIPT_LANGUAGE_INCOMPATIBLE;
+
+    if (!(This->site = calloc(1, sizeof(*This->site))))
+        return E_OUTOFMEMORY;
+    This->site->IActiveScriptSite_iface.lpVtbl = &site_vtbl;
+    This->site->ref = 1;
+
+    if (FAILED(hr = IActiveScript_SetScriptSite(This->engine, &This->site->IActiveScriptSite_iface))
+            || FAILED(hr = IActiveScript_QueryInterface(This->engine, &IID_IActiveScriptParse,
+                    (void **)&parse)))
+        return DMUS_E_SCRIPT_LANGUAGE_INCOMPATIBLE;
+    hr = IActiveScriptParse_InitNew(parse);
+    IActiveScriptParse_Release(parse);
+    return SUCCEEDED(hr) ? S_OK : DMUS_E_SCRIPT_LANGUAGE_INCOMPATIBLE;
+}
+
+static HRESULT script_read_string(IStream *stream, const struct chunk_entry *chunk, WCHAR **str)
+{
+    WCHAR *buf;
+    HRESULT hr;
+
+    if (!(buf = calloc(1, chunk->size + sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    if (FAILED(hr = stream_chunk_get_data(stream, chunk, buf, chunk->size)))
+    {
+        free(buf);
+        return hr;
+    }
+    free(*str);
+    *str = buf;
+    return S_OK;
+}
+
+static HRESULT script_parse_form(IDirectMusicScriptImpl *This, IStream *stream, struct chunk_entry *riff)
+{
+    struct chunk_entry chunk = {.parent = riff};
+    DMUS_OBJECTDESC desc;
+    BOOL have_header = FALSE;
+    HRESULT hr;
+
+    memset(&desc, 0, sizeof(desc));
+    if (FAILED(hr = dmobj_parsedescriptor(stream, riff, &desc,
+            DMUS_OBJ_OBJECT|DMUS_OBJ_NAME|DMUS_OBJ_NAME_INAM|DMUS_OBJ_CATEGORY|DMUS_OBJ_VERSION))
+            || FAILED(hr = stream_reset_chunk_data(stream, riff)))
+        return hr;
+
+    while ((hr = stream_next_chunk(stream, &chunk)) == S_OK)
+    {
+        switch (chunk.id)
+        {
+        case DMUS_FOURCC_SCRIPT_CHUNK:
+            hr = stream_chunk_get_data(stream, &chunk, &This->header, sizeof(This->header));
+            have_header = SUCCEEDED(hr);
+            break;
+        case DMUS_FOURCC_SCRIPTLANGUAGE_CHUNK:
+            hr = script_read_string(stream, &chunk, &This->language);
+            break;
+        case DMUS_FOURCC_SCRIPTSOURCE_CHUNK:
+            hr = script_read_string(stream, &chunk, &This->source);
+            break;
+        case DMUS_FOURCC_SCRIPTVERSION_CHUNK:
+        case DMUS_FOURCC_GUID_CHUNK:
+        case DMUS_FOURCC_VERSION_CHUNK:
+        case DMUS_FOURCC_CATEGORY_CHUNK:
+        case FOURCC_LIST:
+        case FOURCC_RIFF:
+            /* descriptor data was read above; the script's container of helper content is not used */
+            break;
+        default:
+            TRACE("Ignoring chunk %s\n", debugstr_chunk(&chunk));
+            break;
+        }
+        if (FAILED(hr)) return hr;
+    }
+    if (FAILED(hr)) return hr;
+
+    if (!have_header || !This->language || !This->source) return DMUS_E_SCRIPT_INVALID_FILE;
+
+    desc.guidClass = CLSID_DirectMusicScript;
+    desc.dwValidData |= DMUS_OBJ_CLASS | DMUS_OBJ_VERSION;
+    This->dmobj.desc = desc;
+    return S_OK;
+}
+
+static HRESULT WINAPI script_IPersistStream_Load(IPersistStream *iface, IStream *stream)
+{
+    IDirectMusicScriptImpl *This = impl_from_IPersistStream(iface);
+    struct chunk_entry riff = {0};
+    HRESULT hr;
+
+    TRACE("(%p, %p)\n", This, stream);
+
+    if (!stream) return E_POINTER;
+    if ((hr = stream_get_chunk(stream, &riff)) != S_OK) return hr;
+    if (riff.id != FOURCC_RIFF || riff.type != DMUS_FOURCC_SCRIPT_FORM)
+    {
+        TRACE("loading failed: unexpected %s\n", debugstr_chunk(&riff));
+        stream_skip_chunk(stream, &riff);
+        return DMUS_E_SCRIPT_INVALID_FILE;
+    }
+
+    script_close_engine(This);
+    free(This->language);
+    free(This->source);
+    This->language = This->source = NULL;
+    memset(&This->header, 0, sizeof(This->header));
+    if (SUCCEEDED(hr = script_parse_form(This, stream, &riff)))
+        hr = script_create_engine(This);
+    if (FAILED(hr)) script_close_engine(This);
+    return hr;
 }
 
