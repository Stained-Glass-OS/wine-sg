+    {
+        This->site->has_error = FALSE;
+        hr = IDispatch_Invoke(disp, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_PROPERTYGET, &params,
+                value, &exc, NULL);
+        if (FAILED(hr))
+        {
+            script_report_error(This, error_info, &exc, hr);
+            hr = DMUS_E_SCRIPT_ERROR_IN_SCRIPT;
+        }
+        SysFreeString(exc.bstrSource);
+        SysFreeString(exc.bstrDescription);
+        SysFreeString(exc.bstrHelpFile);
+    }
+    IDispatch_Release(disp);
+    return hr;
+}
