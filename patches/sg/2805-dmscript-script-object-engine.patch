+/*****************************************************************************
+ * The site the scripting engine reports to; it remembers the last error.
+ */
+struct script_site
+{
+    IActiveScriptSite IActiveScriptSite_iface;
+    LONG ref;
+    BOOL has_error;
+    DMUS_SCRIPT_ERRORINFO error;
+};
+
+static inline struct script_site *impl_from_IActiveScriptSite(IActiveScriptSite *iface)
+{
+    return CONTAINING_RECORD(iface, struct script_site, IActiveScriptSite_iface);
+}
+
+static HRESULT WINAPI site_QueryInterface(IActiveScriptSite *iface, REFIID riid, void **ret_iface)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IActiveScriptSite))
+    {
+        *ret_iface = iface;
+        IActiveScriptSite_AddRef(iface);
+        return S_OK;
+    }
+    *ret_iface = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI site_AddRef(IActiveScriptSite *iface)
+{
+    struct script_site *This = impl_from_IActiveScriptSite(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI site_Release(IActiveScriptSite *iface)
+{
+    struct script_site *This = impl_from_IActiveScriptSite(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref) free(This);
+    return ref;
+}
+
+static HRESULT WINAPI site_GetLCID(IActiveScriptSite *iface, LCID *lcid)
+{
+    *lcid = LOCALE_USER_DEFAULT;
+    return S_OK;
+}
+
+static HRESULT WINAPI site_GetItemInfo(IActiveScriptSite *iface, LPCOLESTR name, DWORD mask,
+        IUnknown **unk, ITypeInfo **ti)
+{
+    TRACE("(%s, %#lx): no named items\n", debugstr_w(name), mask);
+    if (unk) *unk = NULL;
+    if (ti) *ti = NULL;
+    return TYPE_E_ELEMENTNOTFOUND;
+}
+
+static HRESULT WINAPI site_GetDocVersionString(IActiveScriptSite *iface, BSTR *version)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI site_OnScriptTerminate(IActiveScriptSite *iface, const VARIANT *result,
+        const EXCEPINFO *excepinfo)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI site_OnStateChange(IActiveScriptSite *iface, SCRIPTSTATE state)
+{
+    return S_OK;
+}
+
+static void set_error_info(DMUS_SCRIPT_ERRORINFO *error, HRESULT hr, const WCHAR *source,
+        const WCHAR *description, ULONG line, LONG ch, const WCHAR *text)
+{
+    memset(error, 0, sizeof(*error));
+    error->dwSize = sizeof(*error);
+    error->hr = hr;
+    error->ulLineNumber = line;
+    error->ichCharPosition = ch;
+    if (source) lstrcpynW(error->wszSourceComponent, source, DMUS_MAX_FILENAME);
+    if (description) lstrcpynW(error->wszDescription, description, DMUS_MAX_FILENAME);
+    if (text) lstrcpynW(error->wszSourceLineText, text, DMUS_MAX_FILENAME);
+}
+
+static HRESULT WINAPI site_OnScriptError(IActiveScriptSite *iface, IActiveScriptError *error)
+{
+    struct script_site *This = impl_from_IActiveScriptSite(iface);
+    EXCEPINFO info = {0};
+    DWORD context;
+    ULONG line = 0;
+    LONG ch = 0;
+    BSTR text = NULL;
+
+    IActiveScriptError_GetExceptionInfo(error, &info);
+    IActiveScriptError_GetSourcePosition(error, &context, &line, &ch);
+    IActiveScriptError_GetSourceLineText(error, &text);
+
+    set_error_info(&This->error, info.scode ? info.scode : E_FAIL, info.bstrSource,
+            info.bstrDescription, line, ch, text);
+    This->has_error = TRUE;
+    TRACE("script error %#lx line %lu char %ld: %s\n", This->error.hr, line, ch,
+            debugstr_w(This->error.wszDescription));
+
+    SysFreeString(text);
+    SysFreeString(info.bstrSource);
+    SysFreeString(info.bstrDescription);
+    SysFreeString(info.bstrHelpFile);
+    return S_OK;
+}
+
+static HRESULT WINAPI site_OnEnterScript(IActiveScriptSite *iface)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI site_OnLeaveScript(IActiveScriptSite *iface)
+{
+    return S_OK;
+}
+
+static const IActiveScriptSiteVtbl site_vtbl =
+{
+    site_QueryInterface,
+    site_AddRef,
+    site_Release,
+    site_GetLCID,
+    site_GetItemInfo,
+    site_GetDocVersionString,
+    site_OnScriptTerminate,
+    site_OnStateChange,
+    site_OnScriptError,
+    site_OnEnterScript,
+    site_OnLeaveScript,
+};
 
