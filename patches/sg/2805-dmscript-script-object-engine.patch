+static void script_close_engine(IDirectMusicScriptImpl *This)
+{
+    if (This->engine)
+    {
+        IActiveScript_Close(This->engine);
+        IActiveScript_Release(This->engine);
+        This->engine = NULL;
+    }
+    if (This->site)
