 static HRESULT WINAPI uia_iface_RectToVariant(IUIAutomation6 *iface, RECT rect, VARIANT *out_var)
 {
-    FIXME("%p, %s, %p: stub\n", iface, wine_dbgstr_rect(&rect), out_var);
-    return E_NOTIMPL;
+    double vals[4] = { rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top };
+    SAFEARRAY *sa;
+    void *data;
+    HRESULT hr;
+
+    TRACE("%p, %s, %p\n", iface, wine_dbgstr_rect(&rect), out_var);
+
+    if (!out_var)
+        return E_POINTER;
+    V_VT(out_var) = VT_EMPTY;
+    if (!(sa = SafeArrayCreateVector(VT_R8, 0, 4)))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = SafeArrayAccessData(sa, &data)))
+    {
+        SafeArrayDestroy(sa);
+        return hr;
+    }
+    memcpy(data, vals, sizeof(vals));
+    SafeArrayUnaccessData(sa);
+    V_VT(out_var) = VT_ARRAY | VT_R8;
+    V_ARRAY(out_var) = sa;
+    return S_OK;
 }
 
 static HRESULT WINAPI uia_iface_VariantToRect(IUIAutomation6 *iface, VARIANT var, RECT *out_rect)
 {
-    FIXME("%p, %s, %p: stub\n", iface, debugstr_variant(&var), out_rect);
-    return E_NOTIMPL;
+    LONG lbound, ubound;
+    double *vals;
+    HRESULT hr;
+
+    TRACE("%p, %s, %p\n", iface, debugstr_variant(&var), out_rect);
+
+    if (!out_rect)
+        return E_POINTER;
+    memset(out_rect, 0, sizeof(*out_rect));
+    if (V_VT(&var) != (VT_ARRAY | VT_R8) || !V_ARRAY(&var) || SafeArrayGetDim(V_ARRAY(&var)) != 1)
+        return E_INVALIDARG;
+    if (FAILED(hr = SafeArrayGetLBound(V_ARRAY(&var), 1, &lbound)) ||
+            FAILED(hr = SafeArrayGetUBound(V_ARRAY(&var), 1, &ubound)))
+        return hr;
+    if (ubound - lbound + 1 != 4)
+        return E_INVALIDARG;
+    if (FAILED(hr = SafeArrayAccessData(V_ARRAY(&var), (void **)&vals)))
+        return hr;
+    out_rect->left = lround(vals[0]);
+    out_rect->top = lround(vals[1]);
+#ifdef SG_MUTANT_UIA_RECT_NO_ORIGIN
+    out_rect->right = lround(vals[2]);
+#else
+    out_rect->right = lround(vals[0] + vals[2]);
+#endif
+    out_rect->bottom = lround(vals[1] + vals[3]);
+    SafeArrayUnaccessData(V_ARRAY(&var));
+    return S_OK;
 }
 
 static HRESULT WINAPI uia_iface_SafeArrayToRectNativeArray(IUIAutomation6 *iface, SAFEARRAY *sa, RECT **out_rect_arr,
         int *out_rect_arr_count)
 {
-    FIXME("%p, %p, %p, %p: stub\n", iface, sa, out_rect_arr, out_rect_arr_count);
-    return E_NOTIMPL;
+    LONG lbound, ubound, count, i;
+    double *vals;
+    RECT *rects;
+    VARTYPE vt;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p, %p\n", iface, sa, out_rect_arr, out_rect_arr_count);
+
+    if (!out_rect_arr || !out_rect_arr_count)
+        return E_POINTER;
+    *out_rect_arr = NULL;
+    *out_rect_arr_count = 0;
+    if (!sa || SafeArrayGetDim(sa) != 1 || FAILED(SafeArrayGetVartype(sa, &vt)) || vt != VT_R8)
+        return E_INVALIDARG;
+    if (FAILED(hr = SafeArrayGetLBound(sa, 1, &lbound)) || FAILED(hr = SafeArrayGetUBound(sa, 1, &ubound)))
+        return hr;
+    count = ubound - lbound + 1;
+    if (count <= 0 || count % 4)
+        return E_INVALIDARG;
+    if (!(rects = CoTaskMemAlloc((count / 4) * sizeof(*rects))))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = SafeArrayAccessData(sa, (void **)&vals)))
+    {
+        CoTaskMemFree(rects);
+        return hr;
+    }
+    for (i = 0; i < count / 4; i++)
+    {
+        rects[i].left = lround(vals[i * 4]);
+        rects[i].top = lround(vals[i * 4 + 1]);
+        rects[i].right = lround(vals[i * 4] + vals[i * 4 + 2]);
+        rects[i].bottom = lround(vals[i * 4 + 1] + vals[i * 4 + 3]);
+    }
+    SafeArrayUnaccessData(sa);
+    *out_rect_arr = rects;
+    *out_rect_arr_count = count / 4;
+    return S_OK;
 }
 
