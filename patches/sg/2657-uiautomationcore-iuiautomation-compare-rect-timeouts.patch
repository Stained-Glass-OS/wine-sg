 static HRESULT WINAPI uia_iface_CompareRuntimeIds(IUIAutomation6 *iface, SAFEARRAY *rt_id1, SAFEARRAY *rt_id2,
         BOOL *match)
 {
-    FIXME("%p, %p, %p, %p: stub\n", iface, rt_id1, rt_id2, match);
-    return E_NOTIMPL;
+    LONG lbound1, ubound1, lbound2, ubound2;
+    void *data1, *data2;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p, %p\n", iface, rt_id1, rt_id2, match);
+
+    if (!match)
+        return E_POINTER;
+    *match = FALSE;
+    if (!rt_id1 || !rt_id2)
+        return E_INVALIDARG;
+    if (SafeArrayGetDim(rt_id1) != 1 || SafeArrayGetDim(rt_id2) != 1)
+        return E_INVALIDARG;
+    if (FAILED(hr = SafeArrayGetLBound(rt_id1, 1, &lbound1)) || FAILED(hr = SafeArrayGetUBound(rt_id1, 1, &ubound1)) ||
+            FAILED(hr = SafeArrayGetLBound(rt_id2, 1, &lbound2)) || FAILED(hr = SafeArrayGetUBound(rt_id2, 1, &ubound2)))
+        return hr;
+    if (ubound1 - lbound1 != ubound2 - lbound2 || SafeArrayGetElemsize(rt_id1) != SafeArrayGetElemsize(rt_id2))
+        return S_OK;
+
+    if (FAILED(hr = SafeArrayAccessData(rt_id1, &data1)))
+        return hr;
+    if (SUCCEEDED(hr = SafeArrayAccessData(rt_id2, &data2)))
+    {
+#ifdef SG_MUTANT_UIA_CMP_FIRST_ONLY
+        *match = !memcmp(data1, data2, SafeArrayGetElemsize(rt_id1));
+#else
+        *match = !memcmp(data1, data2, (ubound1 - lbound1 + 1) * SafeArrayGetElemsize(rt_id1));
+#endif
+        SafeArrayUnaccessData(rt_id2);
+    }
+    SafeArrayUnaccessData(rt_id1);
+    return hr;
 }
 
