From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] user32, sechost: device events for ANSI windows

devnotify_window_callbackA converts DBT_DEVTYP_PORT events to ANSI and passes
the string-less structures through; sechost no longer reads past the end of
an empty notification filter. CORE: integrator must review
(patches/notes/5210.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/user32/input.c b/dlls/user32/input.c
--- a/dlls/user32/input.c
+++ b/dlls/user32/input.c
@@ -542,7 +542,36 @@
             return 0;
         }
 
+        case DBT_DEVTYP_PORT:
+        {
+#ifdef SG_MUTANT_DEVA_NOPORT
+            break;
+#endif
+            const DEV_BROADCAST_PORT_W *portW = (const DEV_BROADCAST_PORT_W *)header;
+            size_t lenW, sizeW = header->dbch_size;
+            DEV_BROADCAST_PORT_A *portA;
+            DWORD lenA;
+
+            /* the name is the rest of the structure (it may lack its terminator) */
+            if (sizeW < offsetof(DEV_BROADCAST_PORT_W, dbcp_name)) break;
+            lenW = (sizeW - offsetof(DEV_BROADCAST_PORT_W, dbcp_name)) / sizeof(WCHAR);
+            lenW = wcsnlen( portW->dbcp_name, lenW );
+            if (!(portA = malloc( offsetof(DEV_BROADCAST_PORT_A, dbcp_name[lenW * 3 + 2]) ))) return 0;
+            lenA = WideCharToMultiByte( CP_ACP, 0, portW->dbcp_name, lenW, portA->dbcp_name, lenW * 3, NULL, NULL );
+            portA->dbcp_name[lenA] = 0;
+            portA->dbcp_size = offsetof(DEV_BROADCAST_PORT_A, dbcp_name[lenA + 1]);
+            portA->dbcp_devicetype = portW->dbcp_devicetype;
+            portA->dbcp_reserved = portW->dbcp_reserved;
+            SendMessageTimeoutA( handle, WM_DEVICECHANGE, flags, (LPARAM)portA, SMTO_ABORTIFHUNG, 2000, NULL );
+            free( portA );
+            return 0;
+        }
+
+        /* no strings in these: the same structure for both */
         case DBT_DEVTYP_OEM:
+        case DBT_DEVTYP_VOLUME:
+        case DBT_DEVTYP_NET:
+        case DBT_DEVTYP_DEVNODE:
             break;
         default:
             FIXME( "unimplemented W to A mapping for %#lx\n", header->dbch_devicetype );
diff --git a/dlls/sechost/service.c b/dlls/sechost/service.c
--- a/dlls/sechost/service.c
+++ b/dlls/sechost/service.c
@@ -2663,7 +2663,13 @@
 
     TRACE( "handle %p, filter %p, callback %p\n", handle, filter, callback );
 
+    /* the filter is read as a DEV_BROADCAST_HDR when events are matched, also when it is the
+     * empty one (size 0, matches everything) of RegisterDeviceNotification with no filter */
+#ifdef SG_MUTANT_DEVA_NOEMPTY
     if (!(notify = calloc( 1, sizeof(*notify) + filter->dbch_size )))
+#else
+    if (!(notify = calloc( 1, sizeof(*notify) + max( filter->dbch_size, sizeof(DEV_BROADCAST_HDR) ) )))
+#endif
     {
         SetLastError(ERROR_NOT_ENOUGH_MEMORY);
         return NULL;
-- 
