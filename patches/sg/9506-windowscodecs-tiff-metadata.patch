From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs, gdiplus: the TIFF encoder writes the frame's IFD metadata

A TIFF frame's metadata (tags set through its metadata query writer at /ifd/{ushort=N}, and so GDI+ property items saved as TIFF, which write_properties skipped: 'the TIFF encoder writes no metadata blocks') never reached the file. The common encoder now hands a TIFF frame its IFD writer's serialised directory, and the libtiff encoder sets each tag in the image's directory: a known ASCII tag as a string, a known single SHORT/LONG/RATIONAL value as one, any tag libtiff does not know as a custom field of its type and count. The tags the encoder writes itself (layout, strips, resolution, palette, ICC profile) and the Exif and GPS directory pointers are left out; those two directories are not written (GDI+ leaves Exif and GPS property items out of a TIFF save). The decoder reads the tags back as before.
---
--- a/dlls/windowscodecs/libtiff.c
+++ b/dlls/windowscodecs/libtiff.c
@@ -1207,6 +1207,8 @@
     return S_OK;
 }
 
+static void tiff_encoder_set_metadata(struct tiff_encoder *This, const struct encoder_frame *frame);
+
 static HRESULT CDECL tiff_encoder_create_frame(struct encoder* iface, const struct encoder_frame *frame)
 {
     struct tiff_encoder* This = impl_from_encoder(iface);
@@ -1271,9 +1273,137 @@
         TIFFSetField(This->tiff, TIFFTAG_ICCPROFILE, (uint32_t)frame->icc_profile_len, frame->icc_profile);
 #endif
 
+#ifndef SG_MUTANT_TIFF_NO_METADATA
+    tiff_encoder_set_metadata(This, frame);
+#endif
+
     return S_OK;
 }
 
+/* wine-sg 9506: the tags of the frame's IFD metadata writer (IWICBitmapFrameEncode's metadata query writer,
+ * "/ifd/{ushort=N}"; GDI+ property items saved as TIFF) go into the image's directory. The record is the
+ * writer's serialised IFD (little endian, offsets from its start). Tags the encoder writes itself (the
+ * image's layout, strips, resolution, palette, ICC profile) and the Exif and GPS directory pointers (their
+ * directories are not written) are left out; a tag libtiff does not know is added as a custom field. */
+static BOOL tiff_tag_is_encoders(uint16_t tag)
+{
+    switch (tag)
+    {
+    case 254: case 255: case 256: case 257: case 258: case 259: case 262: case 273: case 277: case 278:
+    case 279: case 282: case 283: case 284: case 296: case 317: case 320: case 322: case 323: case 324:
+    case 325: case 330: case 338: case 339: case 347: case 513: case 514: case 34665: case 34853:
+    case 34675:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void tiff_encoder_set_metadata(struct tiff_encoder *This, const struct encoder_frame *frame)
+{
+    static const BYTE type_size[] = { 0, 1, 1, 2, 4, 8, 1, 1, 2, 4, 8, 4, 8 };
+    static const TIFFDataType data_type[] = { 0, TIFF_BYTE, TIFF_ASCII, TIFF_SHORT, TIFF_LONG, TIFF_RATIONAL,
+            TIFF_SBYTE, TIFF_UNDEFINED, TIFF_SSHORT, TIFF_SLONG, TIFF_SRATIONAL, TIFF_FLOAT, TIFF_DOUBLE };
+    const BYTE *p = frame->metadata, *end = p + frame->metadata_len;
+
+    while (frame->metadata && end - p > (int)sizeof(UINT))
+    {
+        UINT len, count, i;
+        const BYTE *ifd;
+
+        memcpy(&len, p, sizeof(len));
+        p += sizeof(len);
+        if (len > end - p) break;
+        ifd = p;
+        p += len;
+        if (len < 2) continue;
+        count = ifd[0] | (ifd[1] << 8);
+        for (i = 0; i < count && 2 + (i + 1) * 12 <= len; i++)
+        {
+            const BYTE *e = ifd + 2 + i * 12;
+            uint16_t tag = e[0] | (e[1] << 8), type = e[2] | (e[3] << 8);
+            uint32_t n = e[4] | (e[5] << 8) | (e[6] << 16) | ((uint32_t)e[7] << 24), size, at;
+            const TIFFField *field;
+            const BYTE *data;
+            BYTE *values = NULL;
+
+            if (tiff_tag_is_encoders(tag) || !type || type >= ARRAY_SIZE(type_size) || !n) continue;
+            if (n > 0x1000000 / type_size[type]) continue;
+            size = n * type_size[type];
+            if (size <= 4) data = e + 8;
+            else
+            {
+                at = e[8] | (e[9] << 8) | (e[10] << 16) | ((uint32_t)e[11] << 24);
+                if (at > len || size > len - at) continue;
+                data = ifd + at;
+            }
+
+            if (!(field = TIFFFindField(This->tiff, tag, TIFF_ANY)))
+            {
+                /* libtiff keeps the name pointer */
+                TIFFFieldInfo info = { tag, TIFF_VARIABLE2, TIFF_VARIABLE2, data_type[type], FIELD_CUSTOM, 1, 1,
+                        (char *)"PropertyTag" };
+
+                if (TIFFMergeFieldInfo(This->tiff, &info, 1) || !(field = TIFFFindField(This->tiff, tag, TIFF_ANY)))
+                    continue;
+            }
+            if (type == 2 /* ASCII */)
+            {
+                char *str;
+
+                if (!(str = malloc(n + 1))) continue;
+                memcpy(str, data, n);
+                str[n] = 0;
+                if (TIFFFieldPassCount(field))
+                    TIFFSetField(This->tiff, tag, (uint32_t)strlen(str) + 1, str);
+                else
+                    TIFFSetField(This->tiff, tag, str);
+                free(str);
+                continue;
+            }
+            if (TIFFFieldDataType(field) != data_type[type])
+            {
+                WARN("tag %u type %u, libtiff wants %u: left out\n", tag, type, TIFFFieldDataType(field));
+                continue;
+            }
+            if (!(values = malloc(size))) continue;
+            memcpy(values, data, size);
+            if (type == 5 || type == 10)
+            {
+                /* libtiff takes rationals as floats */
+                float *f = malloc(n * sizeof(float));
+                uint32_t k;
+
+                if (!f) { free(values); continue; }
+                for (k = 0; k < n; k++)
+                {
+                    uint32_t num, den;
+                    memcpy(&num, values + k * 8, 4);
+                    memcpy(&den, values + k * 8 + 4, 4);
+                    f[k] = den ? (type == 10 ? (float)(int32_t)num / (int32_t)den : (float)num / den) : 0.0f;
+                }
+                free(values);
+                values = (BYTE *)f;
+            }
+            if (TIFFFieldPassCount(field))
+            {
+                if (TIFFFieldReadCount(field) == TIFF_VARIABLE2 || TIFFFieldWriteCount(field) == TIFF_VARIABLE2)
+                    TIFFSetField(This->tiff, tag, (uint32_t)n, values);
+                else
+                    TIFFSetField(This->tiff, tag, (uint16_t)n, values);
+            }
+            else if (n == 1 && (type == 3 || type == 8))
+                TIFFSetField(This->tiff, tag, (int)*(uint16_t *)values);
+            else if (n == 1 && (type == 4 || type == 9))
+                TIFFSetField(This->tiff, tag, *(uint32_t *)values);
+            else if (n == 1 && (type == 5 || type == 10 || type == 11))
+                TIFFSetField(This->tiff, tag, (double)*(float *)values);
+            else
+                TIFFSetField(This->tiff, tag, values);
+            free(values);
+        }
+    }
+}
+
 static HRESULT CDECL tiff_encoder_write_lines(struct encoder* iface,
     BYTE *data, DWORD line_count, DWORD stride)
 {
--- a/dlls/windowscodecs/encoder.c
+++ b/dlls/windowscodecs/encoder.c
@@ -444,6 +444,9 @@
                 || IsEqualGUID(format, &GUID_MetadataFormatChunktIME);
     if (IsEqualGUID(container, &GUID_ContainerFormatJpeg))
         return IsEqualGUID(format, &GUID_MetadataFormatApp1);
+    /* wine-sg 9506: a TIFF frame's own IFD */
+    if (IsEqualGUID(container, &GUID_ContainerFormatTiff))
+        return IsEqualGUID(format, &GUID_MetadataFormatIfd);
     return FALSE;
 }
 
--- a/dlls/gdiplus/image.c
+++ b/dlls/gdiplus/image.c
@@ -4887,8 +4887,11 @@
     PROPVARIANT value;
     UINT i;
 
-    /* (the TIFF encoder writes no metadata blocks yet) */
     if (IsEqualGUID(container, &GUID_ContainerFormatJpeg)) root = L"/app1/ifd";
+#ifndef SG_MUTANT_GDIP_TIFF_NO_PROPERTIES
+    /* wine-sg 9506: a TIFF's own directory (its Exif and GPS directories are not written) */
+    else if (IsEqualGUID(container, &GUID_ContainerFormatTiff)) root = L"/ifd";
+#endif
     else return;
     if (make_property_list(bitmap) != Ok || !bitmap->prop_count) return;
     if (FAILED(IWICBitmapFrameEncode_GetMetadataQueryWriter(frame, &writer))) return;
@@ -4902,6 +4905,7 @@
             item->id == 0x0117 || item->id == 0x0100 || item->id == 0x0101 || item->id == 0x0102 ||
             item->id == 0x0103 || item->id == 0x0106 || item->id == 0x0115 || item->id == 0x0116)
             continue;
+        if (root[1] == 'i' && (item->id <= 0x001f || is_exif_ifd_tag(item->id))) continue;
         if (item->id <= 0x001f) swprintf(path, ARRAY_SIZE(path), L"%s/gps/{ushort=%u}", root, item->id);
         else if (is_exif_ifd_tag(item->id)) swprintf(path, ARRAY_SIZE(path), L"%s/exif/{ushort=%u}", root, item->id);
         else swprintf(path, ARRAY_SIZE(path), L"%s/{ushort=%u}", root, item->id);
