From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sxs: IAssemblyName::IsEqual and Clone

IAssemblyName::Clone and IsEqual returned E_NOTIMPL. Clone returns an
independent copy of the name (E_INVALIDARG for a NULL out pointer). IsEqual
compares the attributes the flags ask for, with the ASM_CMP_FLAGS values the
documentation lists (added to winsxs.idl): the name, the public key token, the
architecture, and the four parts of the version separately; names and tokens
compare without regard to case; flags for things a name here does not carry
(culture, custom, retarget ...) have nothing to differ in. The result is S_OK
for equal and S_FALSE for different.
---
--- a/dlls/sxs/name.c
+++ b/dlls/sxs/name.c
@@ -252,21 +252,97 @@ static HRESULT WINAPI name_GetVersion(
     return hr;
 }
 
+static const IAssemblyNameVtbl name_vtbl;
+
+static BOOL same_attribute( const WCHAR *a, const WCHAR *b )
+{
+    if (!a || !b) return !a && !b;
+    return !wcsicmp( a, b );
+}
+
+/* the four parts of a version string, as GetVersion reads them */
+static void get_version_parts( const WCHAR *version, WORD parts[4] )
+{
+    DWORD high = 0, low = 0;
+    WCHAR *copy;
+
+    if (version && (copy = wcsdup( version )))
+    {
+        parse_version( copy, &high, &low );
+        free( copy );
+    }
+    parts[0] = high >> 16;
+    parts[1] = high;
+    parts[2] = low >> 16;
+    parts[3] = low;
+}
+
 static HRESULT WINAPI name_IsEqual(
     IAssemblyName *name1,
     IAssemblyName *name2,
     DWORD flags )
 {
-    FIXME("%p, %p, 0x%08lx\n", name1, name2, flags);
-    return E_NOTIMPL;
+    static const DWORD part_flags[4] =
+        { ASM_CMPF_MAJOR_VERSION, ASM_CMPF_MINOR_VERSION, ASM_CMPF_BUILD_NUMBER, ASM_CMPF_REVISION_NUMBER };
+    WORD parts1[4], parts2[4];
+    unsigned int i;
+
+    TRACE("%p, %p, 0x%08lx\n", name1, name2, flags);
+
+    if (!name2) return E_INVALIDARG;
+#ifdef SG_MUTANT_ISEQUAL_ALWAYS
+    return S_OK;
+#endif
+
+    /* only what a name carries is compared: the other flags (culture, key,
+     * retarget ...) have nothing to differ in */
+    if ((flags & ASM_CMPF_NAME) &&
+        !same_attribute( get_name_attribute( name1, NAME_ATTR_ID_NAME ), get_name_attribute( name2, NAME_ATTR_ID_NAME ) ))
+        return S_FALSE;
+    if ((flags & ASM_CMPF_PUBLIC_KEY_TOKEN) &&
+        !same_attribute( get_name_attribute( name1, NAME_ATTR_ID_TOKEN ), get_name_attribute( name2, NAME_ATTR_ID_TOKEN ) ))
+        return S_FALSE;
+    if ((flags & ASM_CMPF_ARCHITECTURE) &&
+        !same_attribute( get_name_attribute( name1, NAME_ATTR_ID_ARCH ), get_name_attribute( name2, NAME_ATTR_ID_ARCH ) ))
+        return S_FALSE;
+
+    get_version_parts( get_name_attribute( name1, NAME_ATTR_ID_VERSION ), parts1 );
+    get_version_parts( get_name_attribute( name2, NAME_ATTR_ID_VERSION ), parts2 );
+    for (i = 0; i < 4; i++)
+        if ((flags & part_flags[i]) && parts1[i] != parts2[i]) return S_FALSE;
+    return S_OK;
 }
 
 static HRESULT WINAPI name_Clone(
     IAssemblyName *iface,
     IAssemblyName **name )
 {
-    FIXME("%p, %p\n", iface, name);
-    return E_NOTIMPL;
+    struct name *orig = impl_from_IAssemblyName( iface ), *copy;
+
+    TRACE("%p, %p\n", iface, name);
+
+    if (!name) return E_INVALIDARG;
+    *name = NULL;
+#ifdef SG_MUTANT_CLONE_ALIAS
+    IAssemblyName_AddRef( iface );
+    *name = iface;
+    return S_OK;
+#endif
+
+    if (!(copy = calloc( 1, sizeof(*copy) ))) return E_OUTOFMEMORY;
+    copy->IAssemblyName_iface.lpVtbl = &name_vtbl;
+    copy->refs = 1;
+    if ((orig->name && !(copy->name = wcsdup( orig->name ))) ||
+        (orig->arch && !(copy->arch = wcsdup( orig->arch ))) ||
+        (orig->token && !(copy->token = wcsdup( orig->token ))) ||
+        (orig->type && !(copy->type = wcsdup( orig->type ))) ||
+        (orig->version && !(copy->version = wcsdup( orig->version ))))
+    {
+        name_Release( &copy->IAssemblyName_iface );
+        return E_OUTOFMEMORY;
+    }
+    *name = &copy->IAssemblyName_iface;
+    return S_OK;
 }
 
 static const IAssemblyNameVtbl name_vtbl =
--- a/dlls/sxs/tests/name.c
+++ b/dlls/sxs/tests/name.c
@@ -195,7 +195,67 @@ static void test_CreateAssemblyNameObject( void )
     ok( !name, "expected NULL got %p\n", name );
 }
 
+static void test_IsEqual_Clone( void )
+{
+    IAssemblyName *name1, *name2, *copy;
+    WCHAR buffer[256], buffer2[256];
+    DWORD len;
+    HRESULT hr;
+
+    hr = CreateAssemblyNameObject( &name1, L"wine,processorArchitecture=\"x86\",publicKeyToken=\"6595b64144ccf1df\","
+                                   L"type=\"win32\",version=\"1.2.3.4\"", CANOF_PARSE_DISPLAY_NAME, NULL );
+    ok( hr == S_OK, "got %08lx\n", hr );
+    hr = CreateAssemblyNameObject( &name2, L"Wine,processorArchitecture=\"amd64\",publicKeyToken=\"6595b64144ccf1df\","
+                                   L"type=\"win32\",version=\"1.2.3.5\"", CANOF_PARSE_DISPLAY_NAME, NULL );
+    ok( hr == S_OK, "got %08lx\n", hr );
+
+    hr = IAssemblyName_IsEqual( name1, name1, ASM_CMPF_IL_ALL );
+    ok( hr == S_OK, "got %08lx\n", hr );
+    hr = IAssemblyName_IsEqual( name1, name2, ASM_CMPF_NAME );
+    ok( hr == S_OK, "got %08lx\n", hr );
+    hr = IAssemblyName_IsEqual( name1, name2, ASM_CMPF_PUBLIC_KEY_TOKEN );
+    ok( hr == S_OK, "got %08lx\n", hr );
+    hr = IAssemblyName_IsEqual( name1, name2, ASM_CMPF_MAJOR_VERSION | ASM_CMPF_MINOR_VERSION | ASM_CMPF_BUILD_NUMBER );
+    ok( hr == S_OK, "got %08lx\n", hr );
+    hr = IAssemblyName_IsEqual( name1, name2, ASM_CMPF_REVISION_NUMBER );
+    ok( hr == S_FALSE, "got %08lx\n", hr );
+    hr = IAssemblyName_IsEqual( name1, name2, ASM_CMPF_VERSION );
+    ok( hr == S_FALSE, "got %08lx\n", hr );
+    hr = IAssemblyName_IsEqual( name1, name2, ASM_CMPF_IL_ALL );
+    ok( hr == S_FALSE, "got %08lx\n", hr );
+    hr = IAssemblyName_IsEqual( name1, name2, ASM_CMPF_IL_NO_VERSION );
+    ok( hr == S_OK, "got %08lx\n", hr );
+    hr = IAssemblyName_IsEqual( name1, name2, ASM_CMPF_ARCHITECTURE );
+    ok( hr == S_FALSE, "got %08lx\n", hr );
+    hr = IAssemblyName_IsEqual( name1, NULL, ASM_CMPF_NAME );
+    ok( hr == E_INVALIDARG, "got %08lx\n", hr );
+
+    copy = (IAssemblyName *)0xdeadbeef;
+    hr = IAssemblyName_Clone( name1, NULL );
+    ok( hr == E_INVALIDARG, "got %08lx\n", hr );
+    hr = IAssemblyName_Clone( name1, &copy );
+    ok( hr == S_OK, "got %08lx\n", hr );
+    ok( copy != name1, "the copy is the original\n" );
+    len = ARRAY_SIZE(buffer);
+    hr = IAssemblyName_GetDisplayName( name1, buffer, &len, 0 );
+    ok( hr == S_OK, "got %08lx\n", hr );
+    len = ARRAY_SIZE(buffer2);
+    hr = IAssemblyName_GetDisplayName( copy, buffer2, &len, 0 );
+    ok( hr == S_OK, "got %08lx\n", hr );
+    ok( !lstrcmpW( buffer, buffer2 ), "got %s, expected %s\n", wine_dbgstr_w(buffer2), wine_dbgstr_w(buffer) );
+    hr = IAssemblyName_IsEqual( name1, copy, ASM_CMPF_IL_ALL | ASM_CMPF_ARCHITECTURE );
+    ok( hr == S_OK, "got %08lx\n", hr );
+    IAssemblyName_Release( name1 );
+    /* the copy does not depend on the original */
+    len = ARRAY_SIZE(buffer2);
+    hr = IAssemblyName_GetDisplayName( copy, buffer2, &len, 0 );
+    ok( hr == S_OK && !lstrcmpW( buffer, buffer2 ), "got %08lx, %s\n", hr, wine_dbgstr_w(buffer2) );
+    IAssemblyName_Release( copy );
+    IAssemblyName_Release( name2 );
+}
+
 START_TEST(name)
 {
     test_CreateAssemblyNameObject();
+    test_IsEqual_Clone();
 }
--- a/include/winsxs.idl
+++ b/include/winsxs.idl
@@ -144,6 +144,27 @@ interface IAssemblyName : IUnknown
         ASM_DISPLAYF_LANGUAGEID            = 0x40
     } ASM_DISPLAY_FLAGS;
 
+    typedef [public] enum
+    {
+        ASM_CMPF_NAME             = 0x1,
+        ASM_CMPF_MAJOR_VERSION    = 0x2,
+        ASM_CMPF_MINOR_VERSION    = 0x4,
+        ASM_CMPF_BUILD_NUMBER     = 0x8,
+        ASM_CMPF_REVISION_NUMBER  = 0x10,
+        ASM_CMPF_VERSION          = 0x1e,
+        ASM_CMPF_PUBLIC_KEY_TOKEN = 0x20,
+        ASM_CMPF_CULTURE          = 0x40,
+        ASM_CMPF_CUSTOM           = 0x80,
+        ASM_CMPF_DEFAULT          = 0x100,
+        ASM_CMPF_RETARGET         = 0x200,
+        ASM_CMPF_ARCHITECTURE     = 0x400,
+        ASM_CMPF_CONFIG_MASK      = 0x800,
+        ASM_CMPF_MVID             = 0x1000,
+        ASM_CMPF_SIGNATURE        = 0x2000,
+        ASM_CMPF_IL_ALL           = 0x7f,
+        ASM_CMPF_IL_NO_VERSION    = 0x61
+    } ASM_CMP_FLAGS;
+
     HRESULT SetProperty(
         [in] DWORD id,
         [in] LPVOID property,
