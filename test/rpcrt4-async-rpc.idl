[uuid(5ee0e9e4-c001-4c01-9001-0123456789ab), version(1.0)]
interface AsyT
{
    [async] void Add([in] handle_t h, [in] long a, [in] long b, [out] long *sum);
    [async] long Slow([in] handle_t h, [in] long ms);
    [async] void Fill([in] handle_t h, [in] long n, [out, size_is(n)] long *buf);
    [async] void Hang([in] handle_t h, [in] long ms);
    [async] void Pair([in] handle_t h, [in] short a, [in] hyper b, [in] double d, [out] hyper *r);
    long Sync([in] handle_t h, [in] long x);
    [async] void None([in] handle_t h);
    void Stop([in] handle_t h);
}
