[uuid(5ee0e9e6-b001-4c01-9001-0123456789ab), version(1.0)]
interface ConvT
{
    typedef struct { long a; short b; char c; hyper h; } SIMPLE;
    typedef struct { long n; [size_is(n)] short v[]; } CSTR;
    typedef struct { long a; [string] char *s; short *p; } PTRS;
    typedef struct { long n; long m; [size_is(n), length_is(m)] short v[]; } CV;
    typedef pipe long LPIPE;
    typedef union switch (long d) _UN
    {
        case 1: short s;
        case 2: double dd;
        case 3: long l;
        default: ;
    } UN;
    typedef [switch_type(long)] union _NU
    {
        [case(1)] short s;
        [case(2)] double dd;
        [case(3)] long l;
    } NU;

    long Basics([in] handle_t h, [in] char c, [in] small sm, [in] byte b, [in] short s, [in] unsigned short us,
                [in] wchar_t w, [in] long l, [in] float f, [in] hyper hy, [in] double d);
    long Simple([in] handle_t h, [in] SIMPLE *p, [in] SIMPLE v);
    long CArr([in] handle_t h, [in] long n, [in, size_is(n)] short *a);
    long VArr([in] handle_t h, [in] long n, [in] long m, [in, size_is(n), length_is(m)] long *a);
    long Fixed([in] handle_t h, [in] long a[3], [in] double d[2]);
    long Str([in] handle_t h, [in, string] char *s, [in, string] wchar_t *w);
    long Cstr([in] handle_t h, [in] CSTR *p);
    long Ptrs([in] handle_t h, [in] PTRS *p, [in, unique] long *u, [in, ref] long *r, [in, unique] long *n,
              [in, ptr] long *f, [in, ptr] long *g);
    long Uni([in] handle_t h, [in] UN *u, [in] long k, [in, switch_is(k)] NU *nu);
    long Vary([in] handle_t h, [in] long m, [in, length_is(m)] short v[6]);
    long Fstr([in] handle_t h, [in, string] char s[8]);
    long Bogus([in] handle_t h, [in] long n, [in, size_is(n)] PTRS *ps);
    long Cv([in] handle_t h, [in] CV *p);
    long Range([in] handle_t h, [in, range(0,1000)] long r);
    long Pipe([in] handle_t h, [in] short pre, [in] LPIPE p);
    long Out([in] handle_t h, [in] long x, [out] long *y, [out] double *d, [out] short s[2], [out] SIMPLE *sv);
    [async] void AOut([in] handle_t h, [in] long x, [out] long *y, [out] double *d);
    void Stop([in] handle_t h);
}
