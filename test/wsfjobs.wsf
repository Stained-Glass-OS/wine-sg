<package>
<!-- Windows Script File (patches/sg/9620), run by test/wsfjobs-gate.sh. Read leniently: no
     XML declaration, so "<" and "&" in the code need no CDATA, as Windows Script Host allows. -->
<job id="main">
<object id="dict" progid="Scripting.Dictionary"/>
<reference object="ADODB.Recordset"/>
<script language="VBScript" src="wsfjobs-lib.vbs"/>
<script language="JScript">
function jsAdd(a, b) { return a + b; }
var jsSeen = libValue();
var jsList = [1, 2, 3];
</script>
<script language="VBScript">
Dim failures
failures = 0
Sub Check(ok, what)
    If ok Then
        WScript.Echo "PASS  " & what
    Else
        WScript.Echo "FAIL  " & what
        failures = failures + 1
    End If
End Sub
Check 1 < 2 And "a" & "b" = "ab", "a lenient block may hold < and &"
Check jsAdd(2, 3) = 5, "a VBScript block calls a JScript block's function"
Check jsSeen = "lib", "the JScript block saw the VBScript src file's function (" & jsSeen & ")"
Check libValue() = "lib", "the src file's function"
Check jsList.length = 3, "VBScript reads a JScript block's array (" & TypeName(jsList) & ")"
Check IsObject(dict), "<object id=""dict""> is a named object (" & TypeName(dict) & ")"
dict.Add "k", 1
Check dict.Count = 1, "the object works"
Check adOpenStatic = 3 And adLockOptimistic = 3, "<reference object=""ADODB.Recordset""> gives ADO's constants"
Check LCase(WScript.ScriptName) = "wsfjobs.wsf", "WScript.ScriptName is the .wsf (" & WScript.ScriptName & ")"
Check WScript.Arguments.Count = 1 And WScript.Arguments(0) = "arg1", "the arguments after the file"
If failures = 0 Then
    WScript.Echo "RESULT: PASS"
Else
    WScript.Echo "RESULT: FAIL (" & failures & ")"
End If
</script>
</job>
<job id="second">
<script language="JScript">
WScript.Echo("JOB second ran");
</script>
</job>
<job id="xmljob">
<script language="VBScript"><![CDATA[
WScript.Echo "JOB xmljob " & (1 < 2)
]]></script>
</job>
</package>
