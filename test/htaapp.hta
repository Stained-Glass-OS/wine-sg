<html>
<head>
<title>htatest</title>
<HTA:APPLICATION ID="oHTA" APPLICATIONNAME="htatest" BORDER="dialog" MAXIMIZEBUTTON="no" MINIMIZEBUTTON="yes" SYSMENU="yes" CAPTION="yes" WINDOWSTATE="normal" VERSION="1.2"/>
<script>
/* test/htaapp-gate.sh: the HTML application object (<HTA:APPLICATION>, patches/sg/9608). Reports go back
 * to the gate's HTTP server; the gate's probe reads the window's styles meanwhile. */
function report(line) {
    var x = new XMLHttpRequest();
    x.open("GET", "/log?" + encodeURIComponent(line), false);
    x.send();
}
function run() {
    try {
        report("cmd=" + oHTA.commandLine);
        report("name=" + oHTA.applicationName + " version=" + oHTA.version + " border=" + oHTA.border);
    } catch (e) { report("THREW " + e.message); }
    report("loaded");
}
window.onload = run;
</script>
</head>
<body>hta</body>
</html>
