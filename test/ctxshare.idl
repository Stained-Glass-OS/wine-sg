/* test/ctxshare-gate.sh: two calls on one context handle (patches/sg/6123) */
[uuid(6c0e7a31-5b2d-4e7f-9a40-0123456789ae), version(1.0)]
interface CtxShare
{
    typedef [context_handle] void *ctx_t;
    long Open([in] handle_t h, [out] ctx_t *ctx);
    long Hold([in] ctx_t ctx, [in] long ms);
    long Poke([in] ctx_t ctx);
    long HoldX([in, out] ctx_t *ctx, [in] long ms);
    void Close([in, out] ctx_t *ctx);
    void Stop([in] handle_t h);
}
