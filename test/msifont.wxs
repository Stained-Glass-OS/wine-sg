<?xml version="1.0" encoding="utf-8"?>
<!-- A package that installs a font into FontsFolder, compressed in an embedded
     cabinet as LibreOffice's (patches/sg/6546): test/msifont-gate.sh builds it
     with wixl. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="SG Font Test" Language="1033" Version="1.0.0" Manufacturer="Stained Glass OS"
           UpgradeCode="2f6b3c41-8a9d-4e7b-b1c2-5d6e7f809a12">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />
    <Media Id="1" Cabinet="data.cab" EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="FontsFolder">
        <Component Id="Font" Guid="5a7c9e13-2b4d-4f6a-8c1e-3d5f7a9b1c23">
          <File Id="SGFont" Name="sgfonttest.ttf" Source="sgfonttest.ttf" KeyPath="yes" />
        </Component>
        <Component Id="Font2" Guid="7c9e1a35-4d6f-4b8c-9e3a-5f7b9d1e3a45">
          <File Id="SGFont2" Name="sgfontgone.ttf" Source="sgfontgone.ttf" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>
    <Feature Id="All" Level="1">
      <ComponentRef Id="Font" />
      <ComponentRef Id="Font2" />
    </Feature>
  </Product>
</Wix>
