[uuid(5ee0e9e3-9001-4c01-9001-0123456789ab), version(1.0), implicit_handle(handle_t cs_bind)]
interface CStructTest
{
    typedef struct { long n; [size_is(n)] long a[]; } cs_t;
    typedef struct { [unique] long *q; long n; [size_is(n)] long a[]; } cps_t;
    void PutCs([in] cs_t *p);
    void PutCps([in] cps_t *p);
}
