/* A language-neutral module (wine-sg 8411 gate): its own data, and a "MUI" resource whose file
 * type (DWORD 4) has bit 0 set, MUI_FILETYPE_LANGUAGE_NEUTRAL_MAIN >> 1, as real ones carry. */
#include <windows.h>
LANGUAGE 0, 0
2 RCDATA { "MAINDATA\0" }
1 MUI { 0xfecdfecdL, 132L, 0x10000L, 0L, 1L, 0L, 0L,
        0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L,
        0L, 0L, 0L, 0L, 0L, 0L }
