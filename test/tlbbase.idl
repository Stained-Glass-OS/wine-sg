/* tlbbase-gate.sh's type library (patches/sg/1301): an interface marshaled by
 * the type library marshaler whose base interfaces have no proxy/stub of
 * their own registered -- the shape of Edge's elevation service
 * (IElevatorEdge : IElevator2 : IElevator : IElevatorEdgeBase : IUnknown,
 * only IElevatorEdge registered, and it adds no methods). */
import "unknwn.idl";

[uuid(5f2a8a0e-5a7e-4c4c-9a9a-5ab000000001), version(1.0)]
library SgTlbBase
{
    importlib("stdole2.tlb");

    [object, uuid(5f2a8a0e-5a7e-4c4c-9a9a-5ab000000010), oleautomation]
    interface ISgGrand : IUnknown
    {
        HRESULT Add([in] int a, [in] int b, [out, retval] int *r);
    }

    [object, uuid(5f2a8a0e-5a7e-4c4c-9a9a-5ab000000011), oleautomation]
    interface ISgBase : ISgGrand
    {
        HRESULT Mul([in] int a, [in] int b, [out, retval] int *r);
        HRESULT Neg([in] int a, [out, retval] int *r);
    }

    [object, uuid(5f2a8a0e-5a7e-4c4c-9a9a-5ab000000012), oleautomation]
    interface ISgEdge : ISgBase
    {
    }
}
