[uuid(5ee0e9e4-c001-4c01-9001-0123456789ac), version(1.0)]
interface Icr
{
    typedef [context_handle] void *ctx_t;
    [async] void Who([in] handle_t h, [out] long *ok);
    void Open([in] handle_t h, [out] ctx_t *ctx);
    long Use([in] ctx_t ctx);
    [async] void Hang([in] handle_t h, [in] long ms);
    void Close([in, out] ctx_t *ctx);
    void Stop([in] handle_t h);
}
