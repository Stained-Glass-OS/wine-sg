<?xml version="1.0" encoding="utf-8"?>
<!-- A package installed per user (no ALLUSERS) that does not say it needs no elevation (the summary's
     word count without bit 3) and puts its files in Program Files, as Mixxx's and Bespoke Synth's
     MSIs do (patches/sg/9001): test/msineedadmin-gate.sh builds it with wixl. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="7d1e2f30-4a5b-4c6d-8e7f-90a1b2c3d4e5" Name="SG Needs Admin Test" Language="1033" Version="1.0.0"
           Manufacturer="Stained Glass OS" UpgradeCode="0f6a2b3c-4d5e-4f60-8a71-92b3c4d5e6f7">
    <Package InstallerVersion="200" Compressed="yes" />
    <Media Id="1" Cabinet="data.cab" EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="SGNeedsAdmin">
          <Component Id="Main" Guid="5a6b7c8d-9e0f-4a1b-8c2d-3e4f5a6b7c8d">
            <File Id="Hello" Source="hello.txt" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="All" Level="1"><ComponentRef Id="Main" /></Feature>
  </Product>
</Wix>
