<?xml version="1.0" encoding="utf-8"?>
<!-- A package installed "just for me" (patches/sg/5944, 5945): test/msiperuser-gate.sh builds it
     with wixl, twice (product codes SGPU1 and SGPU2), and a standard user installs it. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="$(var.Code)" Name="SG Per User Test $(var.N)" Language="1033" Version="1.0.0" Manufacturer="Stained Glass OS"
           UpgradeCode="$(var.Upgrade)">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perUser" />
    <Media Id="1" Cabinet="data.cab" EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLDIR" Name="SGPerUser$(var.N)">
          <Component Id="Main" Guid="$(var.Comp)">
            <File Id="Hello" Source="hello.txt" />
            <RemoveFolder Id="InstallDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Stained Glass\PerUserTest$(var.N)" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="All" Level="1">
      <ComponentRef Id="Main" />
    </Feature>
  </Product>
</Wix>
