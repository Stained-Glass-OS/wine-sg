[uuid(5ee0e9e4-b001-4c01-9001-0123456789ab), version(1.0)]
interface PipeT
{
    typedef struct { long a; short b; } REC;
    typedef pipe long LPIPE;
    typedef pipe REC RECPIPE;
    typedef pipe char CPIPE;
    typedef pipe hyper HPIPE;

    long SumIn([in] handle_t h, [in] LPIPE p, [in] long scale);
    void Gen([in] handle_t h, [in] long n, [in] long chunk, [out] LPIPE p);
    void Echo([in] handle_t h, [in,out] LPIPE p);
    void Recs([in] handle_t h, [in] RECPIPE r, [out] long *total, [out] CPIPE c);
    long Skip([in] handle_t h, [in] LPIPE first, [in] LPIPE second, [in] long take_first);
    long Mixed([in] handle_t h, [in] long a, [in] HPIPE in_p, [in] short b, [out] HPIPE out_p, [out] long *c);
    void Stop([in] handle_t h);
}
