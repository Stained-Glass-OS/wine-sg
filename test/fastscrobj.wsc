<?xml version="1.0"?>
<?component error="true" debug="false"?>
<!-- a component using the parts a script component can have -->
<component id="main">
<registration progid="Sg.ScrobjTest" version="2" classid="{6b5c0d7e-5a1f-4c7e-8d2b-0b8c6d3a9e11}" description="SG scrobj test" remotable="false">
  <script language="VBScript"><![CDATA[
    Function register()
    End Function
  ]]></script>
</registration>
<public>
  <property name="plain"/>
  <property name="ro"><get internalName="getRo"/></property>
  <method name="add" internalName="doAdd"><parameter name="a"/><parameter name="b"/></method>
  <method name="res"/>
  <method name="comp"/>
  <method name="fsoName"/>
  <event name="onx"/>
</public>
<resource id="greeting">Hello <![CDATA[<world>]]></resource>
<object id="fso" progid="Scripting.FileSystemObject"/>
<reference object="Scripting.FileSystemObject"/>
<script language="JScript"><![CDATA[
var plain = 5;
function getRo() { return 42; }
function doAdd(a, b) { return a + b; }
function res() { return getResource("greeting"); }
function comp() { var d = createComponent("Scripting.Dictionary"); d.Add("k", 1); return d.Count; }
function fsoName() { return fso.GetBaseName("C:\\a\\b.txt"); }
]]></script>
</component>
