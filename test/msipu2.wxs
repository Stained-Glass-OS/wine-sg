<?xml version="1.0" encoding="utf-8"?>
<!-- ALLUSERS=2 with MSIINSTALLPERUSER=1: a per-user install, as Windows Installer 5 resolves it
     (patches/sg/9002): test/msipriv-gate.sh builds it with wixl. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="3e4f5a6b-7c8d-4e9f-8a0b-1c2d3e4f5a6b" Name="SG Dual Scope Test" Language="1033" Version="1.0.0"
           Manufacturer="Stained Glass OS" UpgradeCode="4f5a6b7c-8d9e-4f0a-9b1c-2d3e4f5a6b7c">
    <Package InstallerVersion="200" Compressed="yes" />
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />
    <Media Id="1" Cabinet="data.cab" EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLDIR" Name="SGDualScope">
          <Component Id="Main" Guid="5a6b7c8d-9e0f-4a1b-9c2d-3e4f5a6b7c8e">
            <File Id="Hello" Source="hello.txt" />
            <RegistryValue Root="HKCU" Key="Software\Stained Glass\DualScopeTest" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="All" Level="1"><ComponentRef Id="Main" /></Feature>
  </Product>
</Wix>
