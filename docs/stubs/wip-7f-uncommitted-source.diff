+static void test_formatted_text(void)
+{
+    ITextRange *range, *formatted, *dest, *copy;
+    ITextSelection *sel;
+    ITextFont *font;
+    IRichEditOle *reole;
+    ITextDocument2 *doc;
+    HWND hwnd;
+    HRESULT hr;
+    LONG start, end;
+
+    hwnd = new_richedit();
+    SendMessageW( hwnd, WM_SETTEXT, 0, (LPARAM)L"Hello world" );
+    doc = get_doc2( hwnd, &reole );
+
+    hr = ITextDocument2_Range( doc, 6, 11, &range );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ITextRange_GetFont( range, &font );
+    hr = ITextFont_SetBold( font, tomTrue );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ITextFont_Release( font );
+
+    hr = ITextRange_GetFormattedText( range, NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = ITextRange_GetFormattedText( range, &formatted );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    expect_text( formatted, L"world", __LINE__ );
+    expect_bold( formatted, tomTrue, __LINE__ );
+    ITextRange_GetStart( formatted, &start );
+    ITextRange_GetEnd( formatted, &end );
+    ok( start == 0 && end == 5, "got %ld %ld\n", start, end );
+
+    /* the copy is a story of its own */
+    {
+        BSTR str = SysAllocString( L"changed" );
+        hr = ITextRange_SetText( formatted, str );
+        SysFreeString( str );
+    }
+    ok( hr == S_OK, "got %#lx\n", hr );
+    expect_text( range, L"world", __LINE__ );
+    hr = ITextRange_GetDuplicate( formatted, &copy );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ITextRange_Release( formatted );
+    expect_text( copy, L"changed", __LINE__ );
+    ITextRange_Release( copy );
+
+    hr = ITextRange_GetFormattedText( range, &formatted );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ITextDocument2_Range( doc, 0, 0, &dest );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ITextRange_SetFormattedText( dest, NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = ITextRange_SetFormattedText( dest, formatted );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ITextRange_Release( formatted );
+    ITextRange_GetStart( dest, &start );
+    ITextRange_GetEnd( dest, &end );
+    ok( start == 0 && end == 5, "got %ld %ld\n", start, end );
+    expect_text( dest, L"world", __LINE__ );
+    expect_bold( dest, tomTrue, __LINE__ );
+    ITextRange_Release( dest );
+    ITextRange_GetStart( range, &start );
+    ITextRange_GetEnd( range, &end );
+    ok( start == 11 && end == 16, "got %ld %ld\n", start, end );
+    expect_text( range, L"world", __LINE__ );
+    expect_bold( range, tomTrue, __LINE__ );
+    ITextRange_Release( range );
+
+    hr = ITextDocument2_Range( doc, 0, 16, &range );
+    expect_text( range, L"worldHello world", __LINE__ );
+    ITextRange_Release( range );
+
+    /* the selection's text goes the same ways */
+    ITextDocument2_GetSelection( doc, &sel );
+    SendMessageW( hwnd, EM_SETSEL, 0, 5 );
+    hr = ITextSelection_GetFormattedText( sel, &formatted );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    expect_text( formatted, L"world", __LINE__ );
+    expect_bold( formatted, tomTrue, __LINE__ );
+    SendMessageW( hwnd, EM_SETSEL, 16, 16 );
+    hr = ITextSelection_SetFormattedText( sel, formatted );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ITextRange_Release( formatted );
+    hr = ITextDocument2_Range( doc, 0, 21, &range );
+    expect_text( range, L"worldHello worldworld", __LINE__ );
+    ITextRange_Release( range );
+    ITextSelection_Release( sel );
+
+    ITextDocument2_Release( doc );
+    IRichEditOle_Release( reole );
+    DestroyWindow( hwnd );
+}
