+};
+
+static DWORD CALLBACK rtf_buffer_write( DWORD_PTR cookie, BYTE *buf, LONG cb, LONG *written )
+{
+    struct rtf_buffer *rb = (struct rtf_buffer *)cookie;
+    char *data = realloc( rb->data, rb->size + cb + 1 );
+
+    if (!data) return 1;
+    rb->data = data;
+    memcpy( rb->data + rb->size, buf, cb );
+    rb->size += cb;
+    rb->data[rb->size] = 0;
+    *written = cb;
+    return 0;
+}
+
+static DWORD CALLBACK rtf_buffer_read( DWORD_PTR cookie, BYTE *buf, LONG cb, LONG *read )
+{
+    struct rtf_buffer *rb = (struct rtf_buffer *)cookie;
+    DWORD len = min( (DWORD)cb, rb->size - rb->pos );
+
+    memcpy( buf, rb->data + rb->pos, len );
+    rb->pos += len;
+    *read = len;
+    return 0;
+}
+
+/* The formatted text of a character range, as RTF in a buffer the caller frees. */
+HRESULT editor_get_rtf( ME_TextEditor *editor, LONG start, LONG end, char **rtf, DWORD *size )
+{
+    struct rtf_buffer rb = { 0 };
+    EDITSTREAM es = { (DWORD_PTR)&rb, 0, rtf_buffer_write };
+    ME_Cursor cursor;
+
+    cursor_from_char_ofs( editor, start, &cursor );
+    ME_StreamOutRange( editor, SF_RTF, &cursor, end - start, &es );
+    if (es.dwError || !rb.data)
+    {
+        free( rb.data );
+        return E_FAIL;
+    }
+    *rtf = rb.data;
+    *size = rb.size;
+    return S_OK;
+}
+
+/* Replaces the characters from start to end with formatted text; the selection is kept on the
+ * text it was on. Returns where the new text ends. */
+HRESULT editor_replace_rtf( ME_TextEditor *editor, LONG start, LONG end, const char *rtf, DWORD size, LONG *new_end )
+{
+    struct rtf_buffer rb = { (char *)rtf, size, 0 };
+    EDITSTREAM es = { (DWORD_PTR)&rb, 0, rtf_buffer_read };
+    LONG from, to, len, inserted;
+
+    if (editor->props & TXTBIT_READONLY) return E_ACCESSDENIED;
+    len = ME_GetTextLength( editor );
+    end = min( end, len );
+    start = min( start, end );
+    ME_GetSelectionOfs( editor, &from, &to );
+    set_selection_cursors( editor, start, end );
+    if (!ME_StreamIn( editor, SF_RTF | SFF_SELECTION, &es, FALSE ) && es.dwError)
+    {
+        set_selection_cursors( editor, from, to );
+        return E_FAIL;
+    }
+    ME_GetSelectionOfs( editor, &len, &inserted );
+    *new_end = inserted;
+    inserted = *new_end - start - (end - start);
+#define ADJUST(x) ((x) <= start ? (x) : (x) >= end ? (x) + inserted : start)
+    set_selection_cursors( editor, ADJUST(from), ADJUST(to) );
+#undef ADJUST
+    return S_OK;
+}
