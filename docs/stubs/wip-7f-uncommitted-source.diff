+static HRESULT link_finish_create( struct ole_link *link, REFIID riid, DWORD renderopt, FORMATETC *fmt,
+                                   IOleClientSite *site, IStorage *stg, void **obj )
+{
+    HRESULT hr;
+
+    if (FAILED(hr = IStorage_SetClass( stg, &CLSID_StdOleLinkObject ))) return hr;
+    if (FAILED(hr = IPersistStorage_InitNew( &link->IPersistStorage_iface, stg ))) return hr;
+    if (site && FAILED(hr = IOleObject_SetClientSite( &link->IOleObject_iface, site ))) return hr;
+
+    if (renderopt == OLERENDER_DRAW || renderopt == OLERENDER_FORMAT)
+    {
+        FORMATETC draw = { 0, NULL, DVASPECT_CONTENT, -1, TYMED_NULL };
+        DWORD connection;
+
+        if (renderopt == OLERENDER_FORMAT && !fmt) return E_INVALIDARG;
+        hr = IOleCache2_Cache( link->cache, renderopt == OLERENDER_FORMAT ? fmt : &draw, ADVF_PRIMEFIRST, &connection );
+        if (FAILED(hr)) return hr;
+    }
+    else if (renderopt != OLERENDER_NONE && renderopt != OLERENDER_ASIS) return E_INVALIDARG;
+
+    return IOleObject_QueryInterface( &link->IOleObject_iface, riid, obj );
+}
+
+static HRESULT link_create_from_moniker( IMoniker *mk, const CLSID *clsid, REFIID riid, DWORD renderopt,
+                                         FORMATETC *fmt, IOleClientSite *site, IStorage *stg, void **obj )
+{
+    struct ole_link *link;
+    HRESULT hr;
+
+    if (FAILED(hr = link_create( &link ))) return hr;
+    link_set_source( link, mk, clsid );
+    hr = link_finish_create( link, riid, renderopt, fmt, site, stg, obj );
+    IOleObject_Release( &link->IOleObject_iface );
+    return hr;
+}
