+/* IPersistStorage: the "\1Ole" stream names the source */
+
+static HRESULT link_write_stream( struct ole_link *link, IStorage *stg )
+{
+#ifdef SG_MUTANT_LINK_FLAG
+    struct ole_stream_header header = { ole_stream_version, 0, link->update_option, 0, 0 };
+#else
+    struct ole_stream_header header = { ole_stream_version, 1, link->update_option, 0, 0 };
+#endif
+    IStream *stream, *monikers;
+    IPersistStream *persist;
+    LARGE_INTEGER zero = { { 0 } };
+    ULARGE_INTEGER pos;
+    STATSTG stat;
+    HRESULT hr;
+    BYTE *data;
+    ULONG size;
+    HGLOBAL global;
+
+    if (!link->source) return OLE_E_CANT_BINDTOSOURCE;
+
+    if (FAILED(hr = CreateStreamOnHGlobal( NULL, TRUE, &monikers ))) return hr;
+    hr = WriteClassStm( monikers, &link->source_clsid );
+    if (SUCCEEDED(hr)) hr = IMoniker_QueryInterface( link->source, &IID_IPersistStream, (void **)&persist );
+    if (SUCCEEDED(hr))
+    {
+        hr = OleSaveToStream( persist, monikers );
+        IPersistStream_Release( persist );
+    }
+    if (FAILED(hr))
+    {
+        IStream_Release( monikers );
+        return hr;
+    }
+    IStream_Seek( monikers, zero, STREAM_SEEK_CUR, &pos );
+    header.moniker_size = pos.LowPart;
+    IStream_Stat( monikers, &stat, STATFLAG_NONAME );
+    GetHGlobalFromStream( monikers, &global );
+    data = GlobalLock( global );
+
+    hr = IStorage_CreateStream( stg, L"\1Ole", STGM_CREATE | STGM_WRITE | STGM_SHARE_EXCLUSIVE, 0, 0, &stream );
+    if (SUCCEEDED(hr))
+    {
+        hr = IStream_Write( stream, &header, sizeof(header), &size );
+        if (SUCCEEDED(hr)) hr = IStream_Write( stream, data, header.moniker_size, &size );
+        IStream_Release( stream );
+    }
+    GlobalUnlock( global );
+    IStream_Release( monikers );
+    return hr;
+}
+
+static HRESULT link_read_stream( struct ole_link *link, IStorage *stg )
+{
+    struct ole_stream_header header;
+    IMoniker *mk = NULL;
+    IStream *stream;
+    CLSID clsid;
+    ULONG read;
+    HRESULT hr;
+
+    if (FAILED(hr = IStorage_OpenStream( stg, L"\1Ole", NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, 0, &stream )))
+        return hr;
+    hr = IStream_Read( stream, &header, sizeof(header), &read );
+    if (hr != S_OK || read != sizeof(header) || header.version != ole_stream_version || !(header.flags & 1))
+    {
+        IStream_Release( stream );
+        return DV_E_CLIPFORMAT;
+    }
+    hr = ReadClassStm( stream, &clsid );
+    if (SUCCEEDED(hr)) hr = OleLoadFromStream( stream, &IID_IMoniker, (void **)&mk );
+    IStream_Release( stream );
+    if (FAILED(hr)) return DV_E_CLIPFORMAT;
+
+    link_set_source( link, mk, &clsid );
+    IMoniker_Release( mk );
+    link->update_option = header.update_option == OLEUPDATE_ONCALL ? OLEUPDATE_ONCALL : OLEUPDATE_ALWAYS;
+    return S_OK;
+}
