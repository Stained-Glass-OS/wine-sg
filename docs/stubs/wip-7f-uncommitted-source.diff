+/* An embedded object that records what its container asks of it. */
+struct obj
+{
+    IOleObject IOleObject_iface;
+    IPersistStorage IPersistStorage_iface;
+    IOleInPlaceObject IOleInPlaceObject_iface;
+    LONG ref;
