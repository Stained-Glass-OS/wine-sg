new file mode 100644
index 0000000..061eea3
--- /dev/null
+++ b/dlls/ole32/tests/olelink.c
@@ -0,0 +1,401 @@
+/*
+ * Tests for linked objects (OleCreateLink and friends)
+ */
+
+#define COBJMACROS
+#define CONST_VTABLE
+
+#include <stdarg.h>
+#include <stdio.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "oleidl.h"
+
+#include "wine/test.h"
+
+static const CLSID CLSID_linkclass = { 0x00000300, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
+static const CLSID CLSID_linkfile = { 0x4484082e, 0x6d18, 0x4932, { 0xa0, 0x86, 0x5b, 0x4d, 0xcf, 0x36, 0xb3, 0xe0 } };
+
+static WCHAR file_name[MAX_PATH];
+
+static void make_file(void)
+{
+    IStorage *stg;
+    WCHAR dir[MAX_PATH];
+    HRESULT hr;
+
+    GetTempPathW( MAX_PATH, dir );
+    GetTempFileNameW( dir, L"lnk", 0, file_name );
+    DeleteFileW( file_name );
+    hr = StgCreateDocfile( file_name, STGM_CREATE | STGM_READWRITE | STGM_SHARE_EXCLUSIVE, 0, &stg );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IStorage_SetClass( stg, &CLSID_linkfile );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IStorage_Commit( stg, STGC_DEFAULT );
+    IStorage_Release( stg );
+}
+
+static IStorage *new_storage(void)
+{
+    IStorage *stg;
+    HRESULT hr = StgCreateDocfile( NULL, STGM_CREATE | STGM_READWRITE | STGM_SHARE_EXCLUSIVE | STGM_DELETEONRELEASE, 0, &stg );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    return stg;
+}
+
+static void check_ole_stream( IStorage *stg, DWORD update )
+{
+    struct { DWORD version, flags, update, reserved, size; } header;
+    IStream *stream;
+    ULONG read;
+    HRESULT hr;
+
+    hr = IStorage_OpenStream( stg, L"\1Ole", NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, 0, &stream );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (FAILED(hr)) return;
+    hr = IStream_Read( stream, &header, sizeof(header), &read );
+    ok( hr == S_OK && read == sizeof(header), "got %#lx, %lu\n", hr, read );
+    ok( header.version == 0x02000001, "got %#lx\n", header.version );
+    ok( header.flags == 1, "got %#lx\n", header.flags );
+    ok( header.update == update, "got %lu\n", header.update );
+    ok( header.reserved == 0, "got %#lx\n", header.reserved );
+    ok( header.size > 16, "got %lu\n", header.size );
+    IStream_Release( stream );
+}
+
+static void test_link_object( IUnknown *unk, IMoniker *expect_mk )
+{
+    IOleLink *link;
+    IOleObject *obj;
+    IMoniker *mk;
+    DWORD update, status;
+    WCHAR *name;
+    CLSID clsid;
+    HRESULT hr;
+
+    hr = IUnknown_QueryInterface( unk, &IID_IOleLink, (void **)&link );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUnknown_QueryInterface( unk, &IID_IOleObject, (void **)&obj );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    hr = IOleLink_GetSourceMoniker( link, &mk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IMoniker_IsEqual( mk, expect_mk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IMoniker_Release( mk );
+
+    hr = IOleLink_GetSourceDisplayName( link, &name );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !lstrcmpiW( name, file_name ), "got %s\n", wine_dbgstr_w( name ) );
+    CoTaskMemFree( name );
+
+    hr = IOleLink_GetUpdateOptions( link, &update );
+    ok( hr == S_OK && update == OLEUPDATE_ALWAYS, "got %#lx, %lu\n", hr, update );
+    hr = IOleLink_SetUpdateOptions( link, 2 );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = IOleLink_SetUpdateOptions( link, OLEUPDATE_ONCALL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IOleLink_GetUpdateOptions( link, &update );
+    ok( hr == S_OK && update == OLEUPDATE_ONCALL, "got %#lx, %lu\n", hr, update );
+
+    hr = IOleObject_GetUserClassID( obj, &clsid );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( IsEqualGUID( &clsid, &CLSID_linkfile ), "got %s\n", wine_dbgstr_guid( &clsid ) );
+
+    hr = IOleObject_GetMiscStatus( obj, DVASPECT_CONTENT, &status );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( status & OLEMISC_ISLINKOBJECT, "got %#lx\n", status );
+
+    hr = IOleObject_GetMoniker( obj, OLEGETMONIKER_ONLYIFTHERE, OLEWHICHMK_OBJFULL, &mk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IMoniker_IsEqual( mk, expect_mk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IMoniker_Release( mk );
+
+    hr = IOleLink_GetBoundSource( link, (IUnknown **)&mk );
+    ok( hr == E_FAIL, "got %#lx\n", hr );
+
+    IOleObject_Release( obj );
+    IOleLink_Release( link );
+}
+
+static void test_create_link(void)
+{
+    IMoniker *mk, *mk2;
+    IStorage *stg, *stg2;
+    IUnknown *unk, *loaded;
+    IPersistStorage *persist;
+    IOleLink *link;
+    IViewObject2 *view;
+    IOleCache2 *cache;
+    HRESULT hr;
+
+    hr = CreateFileMoniker( file_name, &mk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    stg = new_storage();
+    hr = OleCreateLink( mk, &IID_IUnknown, OLERENDER_NONE, NULL, NULL, stg, (void **)&unk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    test_link_object( unk, mk );
+
+    hr = IUnknown_QueryInterface( unk, &IID_IViewObject2, (void **)&view );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IViewObject2_Release( view );
+    hr = IUnknown_QueryInterface( unk, &IID_IOleCache2, (void **)&cache );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IOleCache2_Release( cache );
+
+    /* the storage is a link's: its class and its "\1Ole" stream */
+    {
+        STATSTG stat;
+
+        hr = IStorage_Stat( stg, &stat, STATFLAG_NONAME );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        ok( IsEqualGUID( &stat.clsid, &CLSID_linkclass ), "got %s\n",
+            wine_dbgstr_guid( &stat.clsid ) );
+    }
+
+    /* an unbound link cannot bind without a source */
+    hr = IUnknown_QueryInterface( unk, &IID_IPersistStorage, (void **)&persist );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    stg2 = new_storage();
+    hr = IPersistStorage_Save( persist, stg2, FALSE );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IPersistStorage_SaveCompleted( persist, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    check_ole_stream( stg2, OLEUPDATE_ONCALL );
+    IPersistStorage_Release( persist );
+
+    /* and it is a link when loaded */
+    hr = OleLoad( stg2, &IID_IUnknown, NULL, (void **)&loaded );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        hr = IUnknown_QueryInterface( loaded, &IID_IOleLink, (void **)&link );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        if (hr == S_OK)
+        {
+            DWORD update;
+
+            hr = IOleLink_GetSourceMoniker( link, &mk2 );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            ok( IMoniker_IsEqual( mk2, mk ) == S_OK, "monikers differ\n" );
+            IMoniker_Release( mk2 );
+            hr = IOleLink_GetUpdateOptions( link, &update );
+            ok( hr == S_OK && update == OLEUPDATE_ONCALL, "got %#lx, %lu\n", hr, update );
+            IOleLink_Release( link );
+        }
+        IUnknown_Release( loaded );
+    }
+
+    IUnknown_Release( unk );
+    IStorage_Release( stg2 );
+    IStorage_Release( stg );
+    IMoniker_Release( mk );
+}
+
+static void test_link_to_file(void)
+{
+    IUnknown *unk;
+    IOleLink *link;
+    IOleObject *obj;
+    IMoniker *mk, *file_mk;
+    IStorage *stg;
+    CLSID clsid;
+    HRESULT hr;
+    WCHAR *name;
+
+    stg = new_storage();
+    hr = OleCreateLinkToFile( file_name, &IID_IUnknown, OLERENDER_DRAW, NULL, NULL, stg, (void **)&unk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        hr = CreateFileMoniker( file_name, &file_mk );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        test_link_object( unk, file_mk );
+        IMoniker_Release( file_mk );
+
+        hr = IUnknown_QueryInterface( unk, &IID_IOleLink, (void **)&link );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        hr = IOleLink_GetSourceMoniker( link, &mk );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        hr = IMoniker_GetDisplayName( mk, NULL, NULL, &name );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        ok( !lstrcmpiW( name, file_name ), "got %s\n", wine_dbgstr_w( name ) );
+        CoTaskMemFree( name );
+        IMoniker_Release( mk );
+
+        /* a source that does not run cannot be bound */
+        hr = IOleLink_BindToSource( link, 0, NULL );
+        ok( hr == OLE_E_CANT_BINDTOSOURCE, "got %#lx\n", hr );
+        hr = IOleLink_BindIfRunning( link );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        hr = IOleLink_UnbindSource( link );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        IOleLink_Release( link );
+
+        hr = IUnknown_QueryInterface( unk, &IID_IOleObject, (void **)&obj );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        hr = IOleObject_GetUserClassID( obj, &clsid );
+        ok( hr == S_OK && IsEqualGUID( &clsid, &CLSID_linkfile ), "got %#lx, %s\n", hr, wine_dbgstr_guid( &clsid ) );
+        IOleObject_Release( obj );
+        IUnknown_Release( unk );
+    }
+    IStorage_Release( stg );
+
+    stg = new_storage();
+    unk = (IUnknown *)0xdeadbeef;
+    hr = OleCreateLinkToFile( L"C:\\no such dir\\file.xyz", &IID_IUnknown, OLERENDER_NONE, NULL, NULL, stg, (void **)&unk );
+    ok( FAILED(hr), "got %#lx\n", hr );
+    ok( !unk, "got %p\n", unk );
+    hr = OleCreateLinkToFile( NULL, &IID_IUnknown, OLERENDER_NONE, NULL, NULL, stg, (void **)&unk );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = OleCreateLinkToFile( file_name, &IID_IUnknown, OLERENDER_NONE, NULL, NULL, NULL, (void **)&unk );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    IStorage_Release( stg );
+}
+
+struct source_data
+{
+    IDataObject IDataObject_iface;
+    IStream *stream;
+};
+
+static HRESULT WINAPI sd_QueryInterface( IDataObject *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IDataObject ))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI sd_AddRef( IDataObject *iface ) { return 2; }
+static ULONG WINAPI sd_Release( IDataObject *iface ) { return 1; }
+static HRESULT WINAPI sd_GetData( IDataObject *iface, FORMATETC *fmt, STGMEDIUM *medium )
+{
+    struct source_data *This = CONTAINING_RECORD( iface, struct source_data, IDataObject_iface );
+    LARGE_INTEGER zero = { { 0 } };
+
+    if (fmt->cfFormat != RegisterClipboardFormatW( L"Link Source" ) || !This->stream) return DV_E_FORMATETC;
+    IStream_Seek( This->stream, zero, STREAM_SEEK_SET, NULL );
+    medium->tymed = TYMED_ISTREAM;
+    medium->pstm = This->stream;
+    IStream_AddRef( This->stream );
+    medium->pUnkForRelease = NULL;
+    return S_OK;
+}
+static HRESULT WINAPI sd_GetDataHere( IDataObject *iface, FORMATETC *fmt, STGMEDIUM *medium ) { return E_NOTIMPL; }
+static HRESULT WINAPI sd_QueryGetData( IDataObject *iface, FORMATETC *fmt ) { return S_FALSE; }
+static HRESULT WINAPI sd_GetCanonicalFormatEtc( IDataObject *iface, FORMATETC *in, FORMATETC *out ) { return E_NOTIMPL; }
+static HRESULT WINAPI sd_SetData( IDataObject *iface, FORMATETC *fmt, STGMEDIUM *medium, BOOL release ) { return E_NOTIMPL; }
+static HRESULT WINAPI sd_EnumFormatEtc( IDataObject *iface, DWORD dir, IEnumFORMATETC **e ) { return E_NOTIMPL; }
+static HRESULT WINAPI sd_DAdvise( IDataObject *iface, FORMATETC *fmt, DWORD flags, IAdviseSink *sink, DWORD *conn ) { return E_NOTIMPL; }
+static HRESULT WINAPI sd_DUnadvise( IDataObject *iface, DWORD conn ) { return E_NOTIMPL; }
+static HRESULT WINAPI sd_EnumDAdvise( IDataObject *iface, IEnumSTATDATA **e ) { return E_NOTIMPL; }
+
+static const IDataObjectVtbl sd_vtbl =
+{
+    sd_QueryInterface, sd_AddRef, sd_Release, sd_GetData, sd_GetDataHere, sd_QueryGetData,
+    sd_GetCanonicalFormatEtc, sd_SetData, sd_EnumFormatEtc, sd_DAdvise, sd_DUnadvise, sd_EnumDAdvise
+};
+
+static void test_link_from_data(void)
+{
+    struct source_data data = { { &sd_vtbl }, NULL };
+    IPersistStream *persist;
+    IMoniker *mk;
+    IStorage *stg;
+    IUnknown *unk;
+    HRESULT hr;
+
+    stg = new_storage();
+    hr = OleCreateLinkFromData( &data.IDataObject_iface, &IID_IUnknown, OLERENDER_NONE, NULL, NULL, stg, (void **)&unk );
+    ok( hr == DV_E_FORMATETC, "got %#lx\n", hr );
+
+    hr = CreateStreamOnHGlobal( NULL, TRUE, &data.stream );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = CreateFileMoniker( file_name, &mk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WriteClassStm( data.stream, &CLSID_linkfile );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IMoniker_QueryInterface( mk, &IID_IPersistStream, (void **)&persist );
+    hr = OleSaveToStream( persist, data.stream );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IPersistStream_Release( persist );
+
+    hr = OleCreateLinkFromData( &data.IDataObject_iface, &IID_IUnknown, OLERENDER_NONE, NULL, NULL, stg, (void **)&unk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        test_link_object( unk, mk );
+        IUnknown_Release( unk );
+    }
+    hr = OleCreateLinkFromData( NULL, &IID_IUnknown, OLERENDER_NONE, NULL, NULL, stg, (void **)&unk );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+
+    IMoniker_Release( mk );
+    IStream_Release( data.stream );
+    IStorage_Release( stg );
+}
+
+static void test_link_stream_handler(void)
+{
+    IStorage *stg, *loaded;
+    IPersistStorage *persist;
+    IMoniker *mk;
+    IUnknown *unk, *handler;
+    IStream *stream;
+    DWORD header[5] = { 0x02000001, 1, 1, 0, 8 };
+    HRESULT hr;
+
+    hr = CreateFileMoniker( file_name, &mk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    stg = new_storage();
+    hr = OleCreateLink( mk, &IID_IUnknown, OLERENDER_NONE, NULL, NULL, stg, (void **)&unk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IMoniker_Release( mk );
+    IUnknown_Release( unk );
+
+    /* a handler reads the stream of a link: a good one and one that is cut short */
+    hr = OleCreateDefaultHandler( &CLSID_linkfile, NULL, &IID_IUnknown, (void **)&handler );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUnknown_QueryInterface( handler, &IID_IPersistStorage, (void **)&persist );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IPersistStorage_Load( persist, stg );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IPersistStorage_Release( persist );
+    IUnknown_Release( handler );
+
+    loaded = new_storage();
+    hr = IStorage_CreateStream( loaded, L"\1Ole", STGM_CREATE | STGM_WRITE | STGM_SHARE_EXCLUSIVE, 0, 0, &stream );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IStream_Write( stream, header, sizeof(header), NULL );
+    IStream_Write( stream, "abcdefgh", 8, NULL );
+    IStream_Release( stream );
+    hr = OleCreateDefaultHandler( &CLSID_linkfile, NULL, &IID_IUnknown, (void **)&handler );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUnknown_QueryInterface( handler, &IID_IPersistStorage, (void **)&persist );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IPersistStorage_Load( persist, loaded );
+    ok( hr == DV_E_CLIPFORMAT, "got %#lx\n", hr );
+    IPersistStorage_Release( persist );
+    IUnknown_Release( handler );
+    IStorage_Release( loaded );
+    IStorage_Release( stg );
+}
+
+START_TEST(olelink)
+{
+    OleInitialize( NULL );
+    make_file();
+    test_create_link();
+    test_link_to_file();
+    test_link_from_data();
+    test_link_stream_handler();
+    DeleteFileW( file_name );
+    OleUninitialize();
+}
