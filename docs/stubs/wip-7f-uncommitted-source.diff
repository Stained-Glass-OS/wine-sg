+static void expect_text( ITextRange *range, const WCHAR *expect, int line )
+{
+    BSTR text = NULL;
+    HRESULT hr = ITextRange_GetText( range, &text );
+
+    ok_(__FILE__, line)( hr == S_OK, "got %#lx\n", hr );
+    ok_(__FILE__, line)( text && !lstrcmpW( text, expect ), "got %s, expected %s\n", wine_dbgstr_w( text ), wine_dbgstr_w( expect ) );
+    SysFreeString( text );
+}
