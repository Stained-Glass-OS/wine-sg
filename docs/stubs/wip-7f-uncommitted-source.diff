+    if (This->site) IOleClientSite_Release( This->site );
+    This->site = site;
+    return S_OK;
+}
+static HRESULT WINAPI oo_GetClientSite( IOleObject *iface, IOleClientSite **site )
+{
+    struct obj *This = obj_from_oleobj( iface );
+    if ((*site = This->site)) IOleClientSite_AddRef( *site );
+    return S_OK;
+}
