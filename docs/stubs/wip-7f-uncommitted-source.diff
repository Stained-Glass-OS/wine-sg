+
+    hwnd = new_richedit();
+    SendMessageW( hwnd, WM_SETTEXT, 0, (LPARAM)L"abcdefgh ijklmnop" );
+    doc = get_doc2( hwnd, &reole );
+
+    hr = ITextDocument2_Range( doc, 5, 5, &range );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ITextRange_GetPoint( range, tomStart | tomClientCoord, &x, &y );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ITextRange_Release( range );
+
+    /* client coordinates, then screen coordinates */
+    hr = ITextDocument2_Range( doc, 0, 1, &range );
+    hr = ITextRange_SetPoint( range, x + 1, y + 1, tomStart | tomClientCoord, FALSE );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ITextRange_GetStart( range, &start );
+    ITextRange_GetEnd( range, &end );
+    ok( start == 5 && end == 5, "got %ld %ld\n", start, end );
+
+    pt.x = x + 1;
+    pt.y = y + 1;
+    ClientToScreen( hwnd, &pt );
+    ITextRange_Release( range );
+    hr = ITextDocument2_Range( doc, 0, 1, &range );
+    hr = ITextRange_SetPoint( range, pt.x, pt.y, tomEnd, TRUE );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ITextRange_GetStart( range, &start );
+    ITextRange_GetEnd( range, &end );
+    ok( start == 0 && end == 5, "got %ld %ld\n", start, end );
+    hr = ITextRange_SetPoint( range, pt.x, pt.y, tomStart, TRUE );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ITextRange_GetStart( range, &start );
+    ITextRange_GetEnd( range, &end );
+    ok( start == 5 && end == 5, "got %ld %ld\n", start, end );
+    ITextRange_Release( range );
+
+    /* the selection anchors where it was and its active end follows the point */
+    ITextDocument2_GetSelection( doc, &sel );
+    SendMessageW( hwnd, EM_SETSEL, 1, 2 );
+    hr = ITextSelection_SetPoint( sel, x + 1, y + 1, tomEnd | tomClientCoord, TRUE );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SendMessageW( hwnd, EM_GETSEL, (WPARAM)&start, (LPARAM)&end );
+    ok( start == 1 && end == 5, "got %ld %ld\n", start, end );
+    hr = ITextSelection_SetPoint( sel, x + 1, y + 1, tomStart | tomClientCoord, FALSE );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SendMessageW( hwnd, EM_GETSEL, (WPARAM)&start, (LPARAM)&end );
+    ok( start == 5 && end == 5, "got %ld %ld\n", start, end );
+    ITextSelection_Release( sel );
+
+    ITextDocument2_Release( doc );
+    IRichEditOle_Release( reole );
+    DestroyWindow( hwnd );
+}
