+static void expect_bold( ITextRange *range, LONG expect, int line )
+{
+    ITextFont *font;
+    LONG bold = -1;
+
+    ITextRange_GetFont( range, &font );
+    ITextFont_GetBold( font, &bold );
+    ok_(__FILE__, line)( bold == expect, "got bold %ld, expected %ld\n", bold, expect );
+    ITextFont_Release( font );
+}
