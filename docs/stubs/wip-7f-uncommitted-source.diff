+static struct obj *obj_from_inplace( IOleInPlaceObject *iface ) { return CONTAINING_RECORD( iface, struct obj, IOleInPlaceObject_iface ); }
+
+static HRESULT WINAPI oo_QueryInterface( IOleObject *iface, REFIID riid, void **ret )
+{
+    struct obj *This = obj_from_oleobj( iface );
+
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IOleObject )) *ret = &This->IOleObject_iface;
+    else if (IsEqualGUID( riid, &IID_IPersistStorage ) || IsEqualGUID( riid, &IID_IPersist ))
+        *ret = &This->IPersistStorage_iface;
+    else if (IsEqualGUID( riid, &IID_IOleInPlaceObject ) || IsEqualGUID( riid, &IID_IOleWindow ))
+        *ret = &This->IOleInPlaceObject_iface;
+    else
+    {
+        *ret = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*ret );
+    return S_OK;
+}
+static ULONG WINAPI oo_AddRef( IOleObject *iface ) { return InterlockedIncrement( &obj_from_oleobj( iface )->ref ); }
+static ULONG WINAPI oo_Release( IOleObject *iface )
+{
+    struct obj *This = obj_from_oleobj( iface );
+    LONG ref = InterlockedDecrement( &This->ref );
+    if (!ref)
+    {
+        if (This->site) IOleClientSite_Release( This->site );
+        if (This->completed_stg) IStorage_Release( This->completed_stg );
+        free( This );
+    }
+    return ref;
+}
+static HRESULT WINAPI oo_SetClientSite( IOleObject *iface, IOleClientSite *site )
+{
+    struct obj *This = obj_from_oleobj( iface );
