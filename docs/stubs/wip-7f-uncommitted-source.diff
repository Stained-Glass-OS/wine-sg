+/******************************************************************************
+ *              OleCreateLink        [OLE32.@]
+ */
+HRESULT WINAPI OleCreateLink( IMoniker *mk, REFIID riid, DWORD renderopt, FORMATETC *fmt,
+                              IOleClientSite *site, IStorage *stg, void **obj )
+{
+    CLSID clsid = CLSID_NULL;
+    DWORD sys;
+
+    TRACE( "%p, %s, %ld, %p, %p, %p, %p\n", mk, debugstr_guid( riid ), renderopt, fmt, site, stg, obj );
+
+    if (!obj) return E_INVALIDARG;
+    *obj = NULL;
+    if (!mk || !stg) return E_INVALIDARG;
+
+    /* a file moniker's class is that of the file */
+    if (SUCCEEDED(IMoniker_IsSystemMoniker( mk, &sys )) && sys == MKSYS_FILEMONIKER)
+    {
+        IBindCtx *bc;
+        WCHAR *name;
+
+        if (SUCCEEDED(CreateBindCtx( 0, &bc )))
+        {
+            if (SUCCEEDED(IMoniker_GetDisplayName( mk, bc, NULL, &name )))
+            {
+                GetClassFile( name, &clsid );
+                CoTaskMemFree( name );
+            }
+            IBindCtx_Release( bc );
+        }
+    }
+    return link_create_from_moniker( mk, &clsid, riid, renderopt, fmt, site, stg, obj );
+}
+
+/******************************************************************************
+ *               OleCreateLinkToFile        [OLE32.@]
+ */
+HRESULT WINAPI OleCreateLinkToFile( LPCOLESTR filename, REFIID riid, DWORD renderopt, FORMATETC *fmt,
+                                    IOleClientSite *site, IStorage *stg, void **obj )
+{
+    CLSID clsid;
+    IMoniker *mk;
+    HRESULT hr;
+
+    TRACE( "%s, %s, %ld, %p, %p, %p, %p\n", debugstr_w( filename ), debugstr_guid( riid ), renderopt, fmt, site, stg, obj );
+
+    if (!obj) return E_INVALIDARG;
+    *obj = NULL;
+    if (!filename || !stg) return E_INVALIDARG;
+
+    if (FAILED(hr = GetClassFile( filename, &clsid ))) return hr;
+    if (FAILED(hr = CreateFileMoniker( filename, &mk ))) return hr;
+    hr = link_create_from_moniker( mk, &clsid, riid, renderopt, fmt, site, stg, obj );
+    IMoniker_Release( mk );
+    return hr;
+}
+
+/******************************************************************************
+ *              OleCreateLinkFromData        [OLE32.@]
+ */
+HRESULT WINAPI OleCreateLinkFromData( IDataObject *data, REFIID riid, DWORD renderopt, FORMATETC *fmt,
+                                      IOleClientSite *site, IStorage *stg, void **obj )
+{
+    FORMATETC source_fmt = { 0, NULL, DVASPECT_CONTENT, -1, TYMED_ISTREAM };
+    STGMEDIUM medium;
+    IMoniker *mk;
+    CLSID clsid;
+    HRESULT hr;
+
+    TRACE( "%p, %s, %#lx, %p, %p, %p, %p\n", data, debugstr_guid( riid ), renderopt, fmt, site, stg, obj );
+
+    if (!obj) return E_INVALIDARG;
+    *obj = NULL;
+    if (!data || !stg) return E_INVALIDARG;
+
+    source_fmt.cfFormat = RegisterClipboardFormatW( L"Link Source" );
+    if (FAILED(hr = IDataObject_GetData( data, &source_fmt, &medium ))) return hr;
+    if (medium.tymed != TYMED_ISTREAM || !medium.pstm)
+    {
+        ReleaseStgMedium( &medium );
+        return DV_E_TYMED;
+    }
+    hr = OleLink_ReadMonikerStream( medium.pstm, &mk, &clsid );
+    ReleaseStgMedium( &medium );
+    if (FAILED(hr)) return hr;
+
+    hr = link_create_from_moniker( mk, &clsid, riid, renderopt, fmt, site, stg, obj );
+    IMoniker_Release( mk );
+    return hr;
+}
