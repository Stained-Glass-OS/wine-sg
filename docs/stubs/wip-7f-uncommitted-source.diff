+}
+
+static WCHAR *strdup_acp_to_w( const char *str )
+{
+    WCHAR *ret;
+    int len;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar( CP_ACP, 0, str, -1, NULL, 0 );
+    if (!(ret = malloc( len * sizeof(WCHAR) ))) return NULL;
+    MultiByteToWideChar( CP_ACP, 0, str, -1, ret, len );
+    return ret;
+}
+
+/* Re-creates the object of a stored embedding under another class: the
+ * storage is rewritten with the new class and the object loaded again. */
+static HRESULT reobj_reload( ME_TextEditor *editor, struct re_object *reobj, const CLSID *clsid, const WCHAR *user_type )
+{
+    IPersistStorage *persist;
+    IOleObject *newobj;
+    CLIPFORMAT cf = 0;
+    WCHAR *old_type = NULL;
+    HRESULT hr;
+
+    if (!reobj->obj.pstg || !reobj->obj.poleobj) return E_INVALIDARG;
+
+    if (SUCCEEDED(IOleObject_QueryInterface( reobj->obj.poleobj, &IID_IPersistStorage, (void **)&persist )))
+    {
+        hr = OleSave( persist, reobj->obj.pstg, TRUE );
+        if (SUCCEEDED(hr)) IPersistStorage_SaveCompleted( persist, NULL );
+        IPersistStorage_Release( persist );
+        if (FAILED(hr)) return hr;
+    }
+
+    ReadFmtUserTypeStg( reobj->obj.pstg, &cf, &old_type );
+    if (FAILED(hr = WriteClassStg( reobj->obj.pstg, clsid ))) goto done;
+    if (FAILED(hr = WriteFmtUserTypeStg( reobj->obj.pstg, cf, (WCHAR *)(user_type ? user_type : old_type) ))) goto done;
+    if (FAILED(hr = OleLoad( reobj->obj.pstg, &IID_IOleObject, reobj->obj.polesite, (void **)&newobj ))) goto done;
+
+    IOleObject_Close( reobj->obj.poleobj, OLECLOSE_NOSAVE );
+    IOleObject_Release( reobj->obj.poleobj );
+    reobj->obj.poleobj = newobj;
+    reobj->obj.clsid = *clsid;
+    reobj_relayout( editor, reobj );
+done:
+    CoTaskMemFree( old_type );
+    return hr;
+}
