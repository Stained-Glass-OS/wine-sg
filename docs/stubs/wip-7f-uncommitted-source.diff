+static void test_call_manager(void)
+{
+    ITextDocument2 *doc;
+    IRichEditOle *reole;
+    IUnknown *manager, *other;
+    BSTR font;
+    LONG pitch, size;
+    HWND hwnd;
+    HRESULT hr;
+
+    hwnd = new_richedit();
+    SendMessageW( hwnd, WM_SETTEXT, 0, (LPARAM)L"text" );
+    doc = get_doc2( hwnd, &reole );
+
+    hr = ITextDocument2_GetCallManager( doc, NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = ITextDocument2_GetCallManager( doc, &manager );
+    ok( hr == S_OK && manager, "got %#lx\n", hr );
+    hr = ITextDocument2_ReleaseCallManager( doc, NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = ITextDocument2_ReleaseCallManager( doc, (IUnknown *)doc );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = ITextDocument2_ReleaseCallManager( doc, manager );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ITextDocument2_GetCallManager( doc, &other );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ITextDocument2_ReleaseCallManager( doc, other );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    hr = ITextDocument2_GetPreferredFont( doc, 0, 0, 0, 0, 12, NULL, &pitch, &size );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = ITextDocument2_GetPreferredFont( doc, 0, 0, 0, 0, 12, &font, &pitch, &size );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( font && font[0], "got %s\n", wine_dbgstr_w( font ) );
+    ok( size == 12, "got %ld\n", size );
+    SysFreeString( font );
+    hr = ITextDocument2_GetPreferredFont( doc, 99, 0, 0, 0, 12, &font, &pitch, &size );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+
+    ITextDocument2_Release( doc );
+    IRichEditOle_Release( reole );
+    DestroyWindow( hwnd );
+}
+
+START_TEST(reole)
+{
+    HMODULE module = LoadLibraryA( "riched20.dll" );
+
+    ok( !!module, "got error %lu\n", GetLastError() );
+    OleInitialize( NULL );
+    test_sites();
+    test_import_data_object();
+    test_formatted_text();
+    test_set_point();
+    test_embedded_object();
+    test_delete_units();
+    test_selection_units();
+    test_call_manager();
+    OleUninitialize();
+}
