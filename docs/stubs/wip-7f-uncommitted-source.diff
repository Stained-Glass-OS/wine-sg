+/* Moves the selection by units other than characters, words and lines, as the arrow keys would:
+ * a selection with text is collapsed to its edge first and that counts as one unit. */
+static HRESULT selection_unit_move( ITextSelection *me, struct text_services *services, int dir, LONG unit,
+                                    LONG count, LONG extend, LONG *delta )
+{
+    ME_TextEditor *editor = services->editor;
+    LONG from, to, n = dir * count, moved = 0, pos, len, anchor;
+    ITextRange *range;
+    WCHAR *t;
+    HRESULT hr;
+
+    if (delta) *delta = 0;
+    if (!count) return S_FALSE;
+    ME_GetSelectionOfs( editor, &from, &to );
+    if (FAILED(hr = CreateITextRange( services, from, to, &range ))) return hr;
+    if (FAILED(hr = tom_story_text( range, &t, &len )))
+    {
+        ITextRange_Release( range );
+        return hr;
+    }
+
+#ifdef SG_MUTANT_SELUNIT_EXTEND
+    extend = 0;
+#endif
+    if (!extend)
+    {
+        LONG steps = n;
+
+        pos = from == to ? from : n < 0 ? from : to;
+        if (from != to)
+        {
+            moved = n < 0 ? -1 : 1;
+            steps = n - moved;
+        }
+        moved += unit == tomObject ? tom_object_step( t, len, &pos, steps ) : tom_step( t, len, unit, &pos, steps );
+        ITextSelection_SetRange( me, pos, pos );
+    }
+    else
+    {
+        pos = ME_GetCursorOfs( &editor->pCursors[0] );
+        anchor = from == to || pos == to ? from : to;
+        moved = unit == tomObject ? tom_object_step( t, len, &pos, n ) : tom_step( t, len, unit, &pos, n );
+        ITextSelection_SetRange( me, anchor, pos );
+    }
+    free( t );
+    ITextRange_Release( range );
+    if (delta) *delta = dir * moved;
+    return moved == n ? S_OK : S_FALSE;
+}
