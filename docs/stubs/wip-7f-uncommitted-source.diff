diff --git a/dlls/ole32/olelink.c b/dlls/ole32/olelink.c
new file mode 100644
index 0000000..4b68c14
--- /dev/null
+++ b/dlls/ole32/olelink.c
@@ -0,0 +1,1115 @@
+/*
+ * The linked object: the object OleCreateLink, OleCreateLinkFromData and
+ * OleCreateLinkToFile make, and OleLoad makes of a storage whose "\1Ole"
+ * stream marks a link.
+ *
+ * A link keeps the moniker of its source, a cache of how the source looks
+ * (a data cache) and the update option. It asks the source for data, to run
+ * and for verbs by binding the moniker.
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "ole2.h"
+#include "objidl.h"
+#include "wine/debug.h"
+
+#include "compobj_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ole);
+
+static const CLSID CLSID_StdOleLinkObject = { 0x00000300, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
+
+struct ole_link
+{
+    IOleObject IOleObject_iface;
+    IOleLink IOleLink_iface;
+    IDataObject IDataObject_iface;
+    IPersistStorage IPersistStorage_iface;
+    LONG ref;
+
+    IMoniker *source;
+    WCHAR *display_name;
+    CLSID source_clsid;
+    DWORD update_option;
+    IOleClientSite *site;
+    IStorage *storage;
+    IOleAdviseHolder *advise;
+    IUnknown *bound;
+    BOOL dirty;
+
+    IUnknown *cache_unk;
+    IOleCache2 *cache;
+    IPersistStorage *cache_persist;
+    IViewObject2 *cache_view;
+    IDataObject *cache_data;
+};
+
+static const DWORD ole_stream_version = 0x02000001;
+
+struct ole_stream_header
+{
+    DWORD version;
+    DWORD flags;
+    DWORD update_option;
+    DWORD reserved;
+    DWORD moniker_size;
+};
+
+static inline struct ole_link *impl_from_IOleObject( IOleObject *iface )
+{
+    return CONTAINING_RECORD( iface, struct ole_link, IOleObject_iface );
+}
+static inline struct ole_link *impl_from_IOleLink( IOleLink *iface )
+{
+    return CONTAINING_RECORD( iface, struct ole_link, IOleLink_iface );
+}
+static inline struct ole_link *impl_from_IDataObject( IDataObject *iface )
+{
+    return CONTAINING_RECORD( iface, struct ole_link, IDataObject_iface );
+}
+static inline struct ole_link *impl_from_IPersistStorage( IPersistStorage *iface )
+{
+    return CONTAINING_RECORD( iface, struct ole_link, IPersistStorage_iface );
+}
+
+static void link_unbind( struct ole_link *link )
+{
+    IUnknown *bound = link->bound;
+
+    link->bound = NULL;
+    if (bound) IUnknown_Release( bound );
+}
+
+static void link_set_source( struct ole_link *link, IMoniker *mk, const CLSID *clsid )
+{
+    link_unbind( link );
+    if (mk) IMoniker_AddRef( mk );
+    if (link->source) IMoniker_Release( link->source );
+    link->source = mk;
+    link->source_clsid = clsid ? *clsid : CLSID_NULL;
+    free( link->display_name );
+    link->display_name = NULL;
+    link->dirty = TRUE;
+}
+
+static HRESULT link_bind( struct ole_link *link, DWORD flags, IBindCtx *bc )
+{
+    IBindCtx *own = NULL;
+    IOleObject *source;
+    HRESULT hr;
+
+    if (link->bound) return S_OK;
+    if (!link->source && link->display_name)
+    {
+        ULONG eaten;
+        IMoniker *mk;
+
+        if (FAILED(hr = CreateBindCtx( 0, &own ))) return hr;
+        hr = MkParseDisplayName( own, link->display_name, &eaten, &mk );
+        IBindCtx_Release( own );
+        own = NULL;
+        if (FAILED(hr)) return hr;
+        link->source = mk;
+    }
+    if (!link->source) return OLE_E_CANT_BINDTOSOURCE;
+
+    if (!bc && FAILED(hr = CreateBindCtx( 0, &own ))) return hr;
+    hr = IMoniker_BindToObject( link->source, bc ? bc : own, NULL, &IID_IUnknown, (void **)&link->bound );
+    if (own) IBindCtx_Release( own );
+    if (FAILED(hr))
+    {
+        link->bound = NULL;
+        return OLE_E_CANT_BINDTOSOURCE;
+    }
+
+    if (!(flags & OLELINKBIND_EVENIFCLASSDIFF) && !IsEqualCLSID( &link->source_clsid, &CLSID_NULL ) &&
+        SUCCEEDED(IUnknown_QueryInterface( link->bound, &IID_IOleObject, (void **)&source )))
+    {
+        CLSID clsid;
+
+        hr = IOleObject_GetUserClassID( source, &clsid );
+        IOleObject_Release( source );
+        if (SUCCEEDED(hr) && !IsEqualCLSID( &clsid, &link->source_clsid ))
+        {
+            link_unbind( link );
+            return OLE_E_CLASSDIFF;
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT link_update_cache( struct ole_link *link )
+{
+    IDataObject *data;
+    HRESULT hr;
+
+    if (FAILED(hr = IUnknown_QueryInterface( link->bound, &IID_IDataObject, (void **)&data ))) return hr;
+    hr = IOleCache2_UpdateCache( link->cache, data, UPDFCACHE_ALL, NULL );
+    IDataObject_Release( data );
+    return hr;
+}
+
+static HRESULT WINAPI link_QueryInterface( IOleObject *iface, REFIID riid, void **obj )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+
+    TRACE( "(%p)->(%s %p)\n", This, debugstr_guid( riid ), obj );
+
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IOleObject ))
+        *obj = &This->IOleObject_iface;
+    else if (IsEqualIID( riid, &IID_IOleLink ))
+        *obj = &This->IOleLink_iface;
+    else if (IsEqualIID( riid, &IID_IDataObject ))
+        *obj = &This->IDataObject_iface;
+    else if (IsEqualIID( riid, &IID_IPersistStorage ) || IsEqualIID( riid, &IID_IPersist ))
+        *obj = &This->IPersistStorage_iface;
+    else if (IsEqualIID( riid, &IID_IOleCache ) || IsEqualIID( riid, &IID_IOleCache2 ) ||
+             IsEqualIID( riid, &IID_IViewObject ) || IsEqualIID( riid, &IID_IViewObject2 ))
+        return IUnknown_QueryInterface( This->cache_unk, riid, obj );
+    else
+    {
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*obj );
+    return S_OK;
+}
+
+static ULONG WINAPI link_AddRef( IOleObject *iface )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+    return InterlockedIncrement( &This->ref );
+}
+
+static ULONG WINAPI link_Release( IOleObject *iface )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+    ULONG ref = InterlockedDecrement( &This->ref );
+
+    if (!ref)
+    {
+        link_unbind( This );
+        if (This->source) IMoniker_Release( This->source );
+        if (This->site) IOleClientSite_Release( This->site );
+        if (This->storage) IStorage_Release( This->storage );
+        if (This->advise) IOleAdviseHolder_Release( This->advise );
+        IUnknown_Release( This->cache_unk );
+        free( This->display_name );
+        free( This );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI link_SetClientSite( IOleObject *iface, IOleClientSite *site )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+
+    TRACE( "(%p)->(%p)\n", This, site );
+
+    if (site) IOleClientSite_AddRef( site );
+    if (This->site) IOleClientSite_Release( This->site );
+    This->site = site;
+    return S_OK;
+}
+
+static HRESULT WINAPI link_GetClientSite( IOleObject *iface, IOleClientSite **site )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+
+    TRACE( "(%p)->(%p)\n", This, site );
+
+    if (!site) return E_INVALIDARG;
+    if ((*site = This->site)) IOleClientSite_AddRef( *site );
+    return S_OK;
+}
+
+static HRESULT WINAPI link_SetHostNames( IOleObject *iface, LPCOLESTR app, LPCOLESTR obj )
+{
+    TRACE( "(%p)->(%s %s)\n", iface, debugstr_w( app ), debugstr_w( obj ) );
+    /* only embedded objects show the names of their container */
+    return S_OK;
+}
+
+static HRESULT WINAPI link_Close( IOleObject *iface, DWORD save_option )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+
+    TRACE( "(%p)->(%#lx)\n", This, save_option );
+
+    link_unbind( This );
+    if (This->advise) IOleAdviseHolder_SendOnClose( This->advise );
+    return S_OK;
+}
+
+static HRESULT WINAPI link_SetMoniker( IOleObject *iface, DWORD which, IMoniker *mk )
+{
+    TRACE( "(%p)->(%lu %p)\n", iface, which, mk );
+    /* the moniker of a link is its source's, which IOleLink sets */
+    return S_OK;
+}
+
+static HRESULT WINAPI link_GetMoniker( IOleObject *iface, DWORD assign, DWORD which, IMoniker **mk )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+
+    TRACE( "(%p)->(%lu %lu %p)\n", This, assign, which, mk );
+
+    if (!mk) return E_INVALIDARG;
+    *mk = NULL;
+    if (!This->source || which == OLEWHICHMK_CONTAINER) return E_FAIL;
+    *mk = This->source;
+    IMoniker_AddRef( *mk );
+    return S_OK;
+}
+
+static HRESULT WINAPI link_InitFromData( IOleObject *iface, IDataObject *data, BOOL creation, DWORD reserved )
+{
+    TRACE( "(%p)->(%p %d %#lx)\n", iface, data, creation, reserved );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI link_GetClipboardData( IOleObject *iface, DWORD reserved, IDataObject **data )
+{
+    TRACE( "(%p)->(%#lx %p)\n", iface, reserved, data );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI link_DoVerb( IOleObject *iface, LONG verb, MSG *msg, IOleClientSite *site, LONG index,
+                                   HWND parent, LPCRECT rect )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+    IOleObject *source;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%ld %p %p %ld %p %s)\n", This, verb, msg, site, index, parent, wine_dbgstr_rect( rect ) );
+
+    if (FAILED(hr = link_bind( This, 0, NULL ))) return hr;
+    if (FAILED(hr = IUnknown_QueryInterface( This->bound, &IID_IOleObject, (void **)&source ))) return hr;
+    hr = IOleObject_DoVerb( source, verb, msg, site ? site : This->site, index, parent, rect );
+    IOleObject_Release( source );
+    return hr;
+}
+
+static HRESULT WINAPI link_EnumVerbs( IOleObject *iface, IEnumOLEVERB **enum_verbs )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+
+    TRACE( "(%p)->(%p)\n", This, enum_verbs );
+    return OleRegEnumVerbs( &This->source_clsid, enum_verbs );
+}
+
+static HRESULT WINAPI link_Update( IOleObject *iface )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+
+    TRACE( "(%p)\n", This );
+    return IOleLink_Update( &This->IOleLink_iface, NULL );
+}
+
+static HRESULT WINAPI link_IsUpToDate( IOleObject *iface )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+    IOleObject *source;
+    HRESULT hr = S_OK;
+
+    TRACE( "(%p)\n", This );
+
+    if (This->bound && SUCCEEDED(IUnknown_QueryInterface( This->bound, &IID_IOleObject, (void **)&source )))
+    {
+        hr = IOleObject_IsUpToDate( source );
+        IOleObject_Release( source );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI link_GetUserClassID( IOleObject *iface, CLSID *clsid )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+
+    TRACE( "(%p)->(%p)\n", This, clsid );
+
+    if (!clsid) return E_INVALIDARG;
+    *clsid = This->source_clsid;
+    return S_OK;
+}
+
+static HRESULT WINAPI link_GetUserType( IOleObject *iface, DWORD form, LPOLESTR *type )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+
+    TRACE( "(%p)->(%lu %p)\n", This, form, type );
+    return OleRegGetUserType( &This->source_clsid, form, type );
+}
+
+static HRESULT WINAPI link_SetExtent( IOleObject *iface, DWORD aspect, SIZEL *size )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+    IOleObject *source;
+    HRESULT hr = OLE_E_NOTRUNNING;
+
+    TRACE( "(%p)->(%lu %p)\n", This, aspect, size );
+
+    /* the size of a link is the source's: it can only be given to a running source */
+    if (This->bound && SUCCEEDED(IUnknown_QueryInterface( This->bound, &IID_IOleObject, (void **)&source )))
+    {
+        hr = IOleObject_SetExtent( source, aspect, size );
+        IOleObject_Release( source );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI link_GetExtent( IOleObject *iface, DWORD aspect, SIZEL *size )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+    IOleObject *source;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%lu %p)\n", This, aspect, size );
+
+    if (!size) return E_INVALIDARG;
+    hr = IViewObject2_GetExtent( This->cache_view, aspect, -1, NULL, size );
+    if (FAILED(hr) && This->bound && SUCCEEDED(IUnknown_QueryInterface( This->bound, &IID_IOleObject, (void **)&source )))
+    {
+        hr = IOleObject_GetExtent( source, aspect, size );
+        IOleObject_Release( source );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI link_Advise( IOleObject *iface, IAdviseSink *sink, DWORD *connection )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p %p)\n", This, sink, connection );
+
+    if (!This->advise && FAILED(hr = CreateOleAdviseHolder( &This->advise ))) return hr;
+    return IOleAdviseHolder_Advise( This->advise, sink, connection );
+}
+
+static HRESULT WINAPI link_Unadvise( IOleObject *iface, DWORD connection )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+
+    TRACE( "(%p)->(%lu)\n", This, connection );
+
+    if (!This->advise) return OLE_E_NOCONNECTION;
+    return IOleAdviseHolder_Unadvise( This->advise, connection );
+}
+
+static HRESULT WINAPI link_EnumAdvise( IOleObject *iface, IEnumSTATDATA **enum_advise )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+
+    TRACE( "(%p)->(%p)\n", This, enum_advise );
+
+    if (!enum_advise) return E_INVALIDARG;
+    *enum_advise = NULL;
+    if (!This->advise) return S_OK;
+    return IOleAdviseHolder_EnumAdvise( This->advise, enum_advise );
+}
+
+static HRESULT WINAPI link_GetMiscStatus( IOleObject *iface, DWORD aspect, DWORD *status )
+{
+    struct ole_link *This = impl_from_IOleObject( iface );
+    HRESULT hr;
+
+    TRACE( "(%p)->(%lu %p)\n", This, aspect, status );
+
+    if (!status) return E_INVALIDARG;
+    hr = OleRegGetMiscStatus( &This->source_clsid, aspect, status );
+    if (FAILED(hr)) *status = 0;
+    *status |= OLEMISC_ISLINKOBJECT;
+    return S_OK;
+}
+
+static HRESULT WINAPI link_SetColorScheme( IOleObject *iface, LOGPALETTE *palette )
+{
+    TRACE( "(%p)->(%p)\n", iface, palette );
+    return OLE_E_NOTRUNNING;
+}
+
+static const IOleObjectVtbl link_vtbl =
+{
+    link_QueryInterface, link_AddRef, link_Release, link_SetClientSite, link_GetClientSite,
+    link_SetHostNames, link_Close, link_SetMoniker, link_GetMoniker, link_InitFromData,
+    link_GetClipboardData, link_DoVerb, link_EnumVerbs, link_Update, link_IsUpToDate,
+    link_GetUserClassID, link_GetUserType, link_SetExtent, link_GetExtent, link_Advise, link_Unadvise,
+    link_EnumAdvise, link_GetMiscStatus, link_SetColorScheme
+};
+
+/* IOleLink */
+
+static HRESULT WINAPI olelink_QueryInterface( IOleLink *iface, REFIID riid, void **obj )
+{
+    return link_QueryInterface( &impl_from_IOleLink( iface )->IOleObject_iface, riid, obj );
+}
+static ULONG WINAPI olelink_AddRef( IOleLink *iface )
+{
+    return link_AddRef( &impl_from_IOleLink( iface )->IOleObject_iface );
+}
+static ULONG WINAPI olelink_Release( IOleLink *iface )
+{
+    return link_Release( &impl_from_IOleLink( iface )->IOleObject_iface );
+}
+
+static HRESULT WINAPI olelink_SetUpdateOptions( IOleLink *iface, DWORD option )
+{
+    struct ole_link *This = impl_from_IOleLink( iface );
+
+    TRACE( "(%p)->(%lu)\n", This, option );
+
+#ifndef SG_MUTANT_LINK_UPDATE
+    if (option != OLEUPDATE_ALWAYS && option != OLEUPDATE_ONCALL) return E_INVALIDARG;
+#endif
+    This->update_option = option;
