+static HRESULT link_create( struct ole_link **ret )
+{
+    struct ole_link *link;
+    HRESULT hr;
+
+    if (!(link = calloc( 1, sizeof(*link) ))) return E_OUTOFMEMORY;
+    link->IOleObject_iface.lpVtbl = &link_vtbl;
+    link->IOleLink_iface.lpVtbl = &olelink_vtbl;
+    link->IDataObject_iface.lpVtbl = &linkdata_vtbl;
+    link->IPersistStorage_iface.lpVtbl = &linkpersist_vtbl;
+    link->ref = 1;
+    link->update_option = OLEUPDATE_ALWAYS;
+
+    hr = CreateDataCache( (IUnknown *)&link->IOleObject_iface, &CLSID_NULL, &IID_IUnknown, (void **)&link->cache_unk );
+    if (FAILED(hr))
+    {
+        free( link );
+        return hr;
+    }
+    /* the interfaces of the aggregated cache are used without a count of their own */
+    IUnknown_QueryInterface( link->cache_unk, &IID_IOleCache2, (void **)&link->cache );
+    IOleCache2_Release( link->cache );
+    IUnknown_QueryInterface( link->cache_unk, &IID_IPersistStorage, (void **)&link->cache_persist );
+    IPersistStorage_Release( link->cache_persist );
+    IUnknown_QueryInterface( link->cache_unk, &IID_IViewObject2, (void **)&link->cache_view );
+    IViewObject2_Release( link->cache_view );
+    IUnknown_QueryInterface( link->cache_unk, &IID_IDataObject, (void **)&link->cache_data );
+    IDataObject_Release( link->cache_data );
+    *ret = link;
+    return S_OK;
+}
+
+/* the link object of a storage that says it holds a link */
+BOOL OleLink_IsLinkStorage( IStorage *stg )
+{
+    struct ole_stream_header header;
+    IStream *stream;
+    ULONG read;
+    BOOL ret;
+
+    if (FAILED(IStorage_OpenStream( stg, L"\1Ole", NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, 0, &stream )))
+        return FALSE;
+    ret = IStream_Read( stream, &header, sizeof(header), &read ) == S_OK && read == sizeof(header) &&
+          header.version == ole_stream_version && (header.flags & 1);
+    IStream_Release( stream );
+    return ret;
+}
