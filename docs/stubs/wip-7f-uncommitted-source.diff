+static HRESULT WINAPI linkpersist_Load( IPersistStorage *iface, IStorage *stg )
+{
+    struct ole_link *This = impl_from_IPersistStorage( iface );
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", This, stg );
+
+    if (!stg) return E_INVALIDARG;
