+static void expect_sel( HWND hwnd, LONG start, LONG end, int line )
+{
+    LONG s, e;
+
+    SendMessageW( hwnd, EM_GETSEL, (WPARAM)&s, (LPARAM)&e );
+    ok_(__FILE__, line)( s == start && e == end, "got %ld %ld, expected %ld %ld\n", s, e, start, end );
+}
