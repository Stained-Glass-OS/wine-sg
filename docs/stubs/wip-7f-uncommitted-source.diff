+static const ITextRangeVtbl trvt;
+static const ITextSelectionVtbl tsvt;
+extern HINSTANCE dll_instance;
+
+/* The text services a range or selection of one of our controls belongs to. */
+static struct text_services *range_services( ITextRange *range )
+{
+    struct text_services *services = NULL;
+    ITextSelection *selection;
+
+    if (range->lpVtbl == &trvt) return impl_from_ITextRange( range )->child.reole;
+    if (SUCCEEDED(ITextRange_QueryInterface( range, &IID_ITextSelection, (void **)&selection )))
+    {
+        if (selection->lpVtbl == &tsvt) services = impl_from_ITextSelection( selection )->services;
+        ITextSelection_Release( selection );
+    }
+    return services;
+}
+
+/* Rich text keeps a paragraph mark with the last paragraph: take back the one the stream added. */
+static void editor_trim_inserted_mark( ME_TextEditor *editor, LONG start, LONG *end, LONG expected )
+{
+    WCHAR ch;
+    ME_Cursor cursor;
+
+    if (*end - start <= expected || *end <= start) return;
+    cursor_from_char_ofs( editor, *end - 1, &cursor );
+    ME_GetTextObjW( editor, &ch, 1, &cursor, 1, FALSE, FALSE );
+    if (ch != '\r') return;
+    ME_InternalDeleteText( editor, &cursor, 1, FALSE );
+    --*end;
+}
+
+static void textranges_update_replace( struct text_services *services, LONG start, LONG end, LONG new_end )
+{
+    ITextRangeImpl *range;
+    LONG delta = new_end - end;
+
+    LIST_FOR_EACH_ENTRY( range, &services->rangelist, ITextRangeImpl, child.entry )
+    {
+#define ADJUST(x) ((x) <= start ? (x) : (x) >= end ? (x) + delta : start)
+        range->start = ADJUST( range->start );
+        range->end = ADJUST( range->end );
+#undef ADJUST
+    }
+}
+
+static HRESULT textrange_get_formatted_text( ITextRange *range, struct text_services *services, ITextRange **ret )
+{
+    LONG start, end, new_end;
+    struct text_services *story;
+    IRichEditOle *ole = NULL;
+    HRESULT hr;
+    char *rtf;
+    DWORD size;
+    HWND hwnd;
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    ITextRange_GetStart( range, &start );
+    ITextRange_GetEnd( range, &end );
+    end = min( end, ME_GetTextLength( services->editor ) );
+    start = min( start, end );
+    if (FAILED(hr = editor_get_rtf( services->editor, start, end, &rtf, &size ))) return hr;
+#ifdef SG_MUTANT_FMT_PLAIN
+    free( rtf );
+    rtf = _strdup( "{\\rtf1 x}" );
+    size = strlen( rtf );
+#endif
+
+    hwnd = CreateWindowExW( 0, L"RichEdit20W", NULL, ES_MULTILINE | WS_POPUP, 0, 0, 0, 0, HWND_MESSAGE, NULL,
+                            dll_instance, NULL );
+    if (!hwnd || !SendMessageW( hwnd, EM_GETOLEINTERFACE, 0, (LPARAM)&ole ) || !ole)
+    {
+        if (hwnd) DestroyWindow( hwnd );
+        free( rtf );
+        return E_FAIL;
+    }
+    story = impl_from_IRichEditOle( ole );
+    IRichEditOle_Release( ole );
+    hr = editor_replace_rtf( story->editor, 0, 0, rtf, size, &new_end );
+    free( rtf );
+    if (SUCCEEDED(hr))
+    {
+        editor_trim_inserted_mark( story->editor, 0, &new_end, end - start );
+        story->owned_hwnd = hwnd;
+        hr = CreateITextRange( story, 0, new_end, ret );
+    }
+    if (FAILED(hr)) DestroyWindow( hwnd );
+    return hr;
+}
+
+static HRESULT textrange_set_formatted_text( ITextRange *range, struct text_services *services, BOOL selection,
+                                             ITextRange *source )
+{
+    struct text_services *src_services;
+    LONG start, end, src_start, src_end, new_end;
+    ME_TextEditor *editor = services->editor;
+    HRESULT hr;
+    char *rtf;
+    DWORD size;
+
+    if (!source) return E_INVALIDARG;
+    ITextRange_GetStart( range, &start );
+    ITextRange_GetEnd( range, &end );
+    ITextRange_GetStart( source, &src_start );
+    ITextRange_GetEnd( source, &src_end );
+
+    if (!(src_services = range_services( source )))
+    {
+        BSTR text = NULL;
+
+        if (FAILED(hr = ITextRange_GetText( source, &text ))) return hr;
+        hr = ITextRange_SetText( range, text );
+        SysFreeString( text );
+        return hr;
+    }
+
+    src_end = min( src_end, ME_GetTextLength( src_services->editor ) );
+    src_start = min( src_start, src_end );
+    if (FAILED(hr = editor_get_rtf( src_services->editor, src_start, src_end, &rtf, &size ))) return hr;
+    hr = editor_replace_rtf( editor, start, end, rtf, size, &new_end );
+    free( rtf );
+    if (FAILED(hr)) return hr;
+    editor_trim_inserted_mark( editor, start, &new_end, src_end - src_start );
+    end = min( end, ME_GetTextLength( editor ) + 1 );
+    textranges_update_replace( services, start, end, new_end );
+    if (range->lpVtbl == &trvt)
+    {
+        ITextRangeImpl *impl = impl_from_ITextRange( range );
+        impl->start = start;
+        impl->end = new_end;
+    }
+    if (selection) set_selection_cursors( editor, start, new_end );
+    ME_UpdateRepaint( editor, FALSE );
+    return S_OK;
+}
