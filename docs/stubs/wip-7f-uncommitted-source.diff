+    if (FAILED(hr = WriteClassStg( stg, &CLSID_StdOleLinkObject ))) return hr;
+    if (FAILED(hr = link_write_stream( This, stg ))) return hr;
+    return IPersistStorage_Save( This->cache_persist, stg, same_as_load );
