+    return oo_QueryInterface( &obj_from_inplace( iface )->IOleObject_iface, riid, ret );
+}
+static ULONG WINAPI ip_AddRef( IOleInPlaceObject *iface ) { return oo_AddRef( &obj_from_inplace( iface )->IOleObject_iface ); }
+static ULONG WINAPI ip_Release( IOleInPlaceObject *iface ) { return oo_Release( &obj_from_inplace( iface )->IOleObject_iface ); }
+static HRESULT WINAPI ip_GetWindow( IOleInPlaceObject *iface, HWND *hwnd ) { *hwnd = NULL; return E_FAIL; }
+static HRESULT WINAPI ip_ContextSensitiveHelp( IOleInPlaceObject *iface, BOOL mode ) { return S_OK; }
+static HRESULT WINAPI ip_InPlaceDeactivate( IOleInPlaceObject *iface )
+{
+    obj_from_inplace( iface )->inplace_deactivate++;
+    return S_OK;
+}
+static HRESULT WINAPI ip_UIDeactivate( IOleInPlaceObject *iface ) { return S_OK; }
+static HRESULT WINAPI ip_SetObjectRects( IOleInPlaceObject *iface, LPCRECT pos, LPCRECT clip )
+{
+    struct obj *This = obj_from_inplace( iface );
+    This->set_rects++;
+    This->pos_rect = *pos;
+    This->clip_rect = *clip;
+    return S_OK;
+}
+static HRESULT WINAPI ip_ReactivateAndUndo( IOleInPlaceObject *iface ) { return S_OK; }
+
+static const IOleInPlaceObjectVtbl ip_vtbl =
+{
+    ip_QueryInterface, ip_AddRef, ip_Release, ip_GetWindow, ip_ContextSensitiveHelp, ip_InPlaceDeactivate,
+    ip_UIDeactivate, ip_SetObjectRects, ip_ReactivateAndUndo
+};
+
+static struct obj *obj_create( void )
+{
+    struct obj *obj = calloc( 1, sizeof(*obj) );
+    obj->IOleObject_iface.lpVtbl = &oo_vtbl;
+    obj->IPersistStorage_iface.lpVtbl = &ps_vtbl;
+    obj->IOleInPlaceObject_iface.lpVtbl = &ip_vtbl;
+    obj->ref = 1;
+    return obj;
+}
+
+static HWND new_richedit(void)
+{
+    HWND hwnd = CreateWindowW( L"RichEdit20W", NULL, ES_MULTILINE | WS_POPUP | WS_VISIBLE | WS_VSCROLL,
+                               0, 0, 300, 100, NULL, NULL, NULL, NULL );
+    ok( hwnd != NULL, "got error %lu\n", GetLastError() );
+    return hwnd;
+}
+
+static HRESULT insert_object( IRichEditOle *reole, struct obj *obj, IOleClientSite *site, IStorage *stg )
+{
+    REOBJECT reo = { sizeof(reo) };
+
+    reo.cp = REO_CP_SELECTION;
+    reo.clsid = CLSID_reoleobj;
+    reo.poleobj = &obj->IOleObject_iface;
+    reo.pstg = stg;
+    reo.polesite = site;
+    reo.dvaspect = DVASPECT_CONTENT;
+    reo.dwFlags = REO_RESIZABLE;
+    return IRichEditOle_InsertObject( reole, &reo );
+}
+
+static DWORD object_flags( IRichEditOle *reole, LONG iob, DWORD *aspect, IStorage **stg )
+{
+    REOBJECT reo = { sizeof(reo) };
+    HRESULT hr = IRichEditOle_GetObject( reole, iob, &reo, stg ? REO_GETOBJ_PSTG : REO_GETOBJ_NO_INTERFACES );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (aspect) *aspect = reo.dvaspect;
+    if (stg) *stg = reo.pstg;
+    return reo.dwFlags;
+}
