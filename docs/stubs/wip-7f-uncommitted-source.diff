+    hr = IOleObject_QueryInterface( &link->IOleObject_iface, riid, obj );
+    IOleObject_Release( &link->IOleObject_iface );
+    return hr;
+}
+
+HRESULT OleLink_ReadMonikerStream( IStream *stream, IMoniker **mk, CLSID *clsid )
+{
+    HRESULT hr;
+
+    *mk = NULL;
+    if (SUCCEEDED(hr = ReadClassStm( stream, clsid ))) hr = OleLoadFromStream( stream, &IID_IMoniker, (void **)mk );
+    return hr;
+}
