+static void test_delete_units(void)
+{
+    static const WCHAR text[] = L"One two three. Four five.\rSecond para\rThird";
+    ITextRange *range;
+    ITextDocument2 *doc;
+    IRichEditOle *reole;
+    HWND hwnd;
+    HRESULT hr;
+    LONG delta;
+
+    hwnd = new_richedit();
+    SendMessageW( hwnd, WM_SETTEXT, 0, (LPARAM)text );
+    doc = get_doc2( hwnd, &reole );
+
+    ITextDocument2_Range( doc, 4, 4, &range );
+    hr = ITextRange_Delete( range, tomWord, 1, &delta );
+    ok( hr == S_OK && delta == 1, "got %#lx, %ld\n", hr, delta );
+    ITextRange_Release( range );
+    ITextDocument2_Range( doc, 0, 100, &range );
+    expect_text( range, L"One three. Four five.\rSecond para\rThird\r", __LINE__ );
+    ITextRange_Release( range );
+
+    /* a sentence forward and a paragraph back */
+    ITextDocument2_Range( doc, 4, 4, &range );
+    hr = ITextRange_Delete( range, tomSentence, 1, &delta );
+    ok( hr == S_OK && delta == 1, "got %#lx, %ld\n", hr, delta );
+    ITextRange_Release( range );
+    ITextDocument2_Range( doc, 0, 100, &range );
+    expect_text( range, L"One Four five.\rSecond para\rThird\r", __LINE__ );
+    ITextRange_Release( range );
+
+    ITextDocument2_Range( doc, 27, 27, &range );
+    hr = ITextRange_Delete( range, tomParagraph, -1, &delta );
+    ok( hr == S_OK && delta == -1, "got %#lx, %ld\n", hr, delta );
+    ITextRange_Release( range );
+    ITextDocument2_Range( doc, 0, 100, &range );
+    expect_text( range, L"One Four five.\rThird\r", __LINE__ );
+    ITextRange_Release( range );
+
+    /* a range with text counts as the first unit */
+    ITextDocument2_Range( doc, 4, 8, &range );
+    hr = ITextRange_Delete( range, tomWord, 2, &delta );
+    ok( hr == S_OK && delta == 2, "got %#lx, %ld\n", hr, delta );
+    ITextRange_Release( range );
+    ITextDocument2_Range( doc, 0, 100, &range );
+    expect_text( range, L"One five.\rThird\r", __LINE__ );
+    ITextRange_Release( range );
+
+    ITextDocument2_Range( doc, 0, 3, &range );
+    hr = ITextRange_Delete( range, tomCharacter, 3, &delta );
+    ok( hr == S_OK && delta == 3, "got %#lx, %ld\n", hr, delta );
+    ITextRange_Release( range );
+    ITextDocument2_Range( doc, 0, 100, &range );
+    expect_text( range, L"ive.\rThird\r", __LINE__ );
+    ITextRange_Release( range );
+
+    ITextDocument2_Range( doc, 0, 0, &range );
+    hr = ITextRange_Delete( range, tomSection, 1, &delta );
+    ok( hr == E_NOTIMPL, "got %#lx\n", hr );
+    ITextRange_Release( range );
+
+    ITextDocument2_Release( doc );
+    IRichEditOle_Release( reole );
+    DestroyWindow( hwnd );
+}
