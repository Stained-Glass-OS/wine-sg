+static void test_embedded_object(void)
+{
+    ITextRange *range;
+    ITextSelection *sel;
+    IOleClientSite *site;
+    ITextDocument2 *doc;
+    IRichEditOle *reole;
+    struct obj *obj;
+    IUnknown *unk;
+    HWND hwnd;
+    HRESULT hr;
+
+    hwnd = new_richedit();
+    SendMessageW( hwnd, WM_SETTEXT, 0, (LPARAM)L"ab" );
+    doc = get_doc2( hwnd, &reole );
+    SendMessageW( hwnd, EM_SETSEL, 1, 1 );
+    obj = obj_create();
+    IRichEditOle_GetClientSite( reole, &site );
+    IOleObject_SetClientSite( &obj->IOleObject_iface, site );
+    hr = insert_object( reole, obj, site, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    ITextDocument2_Range( doc, 1, 2, &range );
+    unk = (IUnknown *)0xdeadbeef;
+    hr = ITextRange_GetEmbeddedObject( range, &unk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( unk == (IUnknown *)&obj->IOleObject_iface, "got %p\n", unk );
+    if (hr == S_OK) IUnknown_Release( unk );
+    hr = ITextRange_GetEmbeddedObject( range, NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ITextRange_Release( range );
+
+    ITextDocument2_Range( doc, 0, 1, &range );
+    unk = (IUnknown *)0xdeadbeef;
+    hr = ITextRange_GetEmbeddedObject( range, &unk );
+    ok( hr == S_FALSE, "got %#lx\n", hr );
+    ok( !unk, "got %p\n", unk );
+    ITextRange_Release( range );
+
+    ITextDocument2_GetSelection( doc, &sel );
+    SendMessageW( hwnd, EM_SETSEL, 1, 2 );
+    hr = ITextSelection_GetEmbeddedObject( sel, &unk );
+    ok( hr == S_OK && unk == (IUnknown *)&obj->IOleObject_iface, "got %#lx, %p\n", hr, unk );
+    if (hr == S_OK) IUnknown_Release( unk );
+    SendMessageW( hwnd, EM_SETSEL, 0, 1 );
+    hr = ITextSelection_GetEmbeddedObject( sel, &unk );
+    ok( hr == S_FALSE && !unk, "got %#lx, %p\n", hr, unk );
+    ITextSelection_Release( sel );
+
+    SendMessageW( hwnd, WM_SETTEXT, 0, (LPARAM)L"" );
+    IOleClientSite_Release( site );
+    IOleObject_Release( &obj->IOleObject_iface );
+    ITextDocument2_Release( doc );
+    IRichEditOle_Release( reole );
+    DestroyWindow( hwnd );
+}
