+static void test_selection_units(void)
+{
+    static const WCHAR text[] = L"One two three. Four five.\rSecond para\rThird";
+    ITextSelection *sel;
+    ITextDocument2 *doc;
+    IRichEditOle *reole;
+    HWND hwnd;
+    HRESULT hr;
+    LONG delta;
+
+    hwnd = new_richedit();
+    SendMessageW( hwnd, WM_SETTEXT, 0, (LPARAM)text );
+    doc = get_doc2( hwnd, &reole );
+    ITextDocument2_GetSelection( doc, &sel );
+
+    SendMessageW( hwnd, EM_SETSEL, 28, 28 );
+    hr = ITextSelection_MoveLeft( sel, tomParagraph, 1, tomMove, &delta );
+    ok( hr == S_OK && delta == 1, "got %#lx, %ld\n", hr, delta );
+    expect_sel( hwnd, 26, 26, __LINE__ );
+    hr = ITextSelection_MoveRight( sel, tomSentence, 1, tomMove, &delta );
+    ok( hr == S_OK && delta == 1, "got %#lx, %ld\n", hr, delta );
+    expect_sel( hwnd, 38, 38, __LINE__ );
+    hr = ITextSelection_MoveLeft( sel, tomSentence, 2, tomMove, &delta );
+    ok( hr == S_OK && delta == 2, "got %#lx, %ld\n", hr, delta );
+    expect_sel( hwnd, 15, 15, __LINE__ );
+    hr = ITextSelection_MoveRight( sel, tomSentence, -1, tomMove, &delta );
+    ok( hr == S_OK && delta == -1, "got %#lx, %ld\n", hr, delta );
+    expect_sel( hwnd, 0, 0, __LINE__ );
+    hr = ITextSelection_MoveLeft( sel, tomSentence, 1, tomMove, &delta );
+    ok( hr == S_FALSE && delta == 0, "got %#lx, %ld\n", hr, delta );
+
+    /* extending moves the active end only */
+    SendMessageW( hwnd, EM_SETSEL, 4, 4 );
+    hr = ITextSelection_MoveRight( sel, tomSentence, 1, tomExtend, &delta );
+    ok( hr == S_OK && delta == 1, "got %#lx, %ld\n", hr, delta );
+    expect_sel( hwnd, 4, 15, __LINE__ );
+    hr = ITextSelection_MoveLeft( sel, tomParagraph, 1, tomExtend, &delta );
+    ok( hr == S_OK && delta == 1, "got %#lx, %ld\n", hr, delta );
+    expect_sel( hwnd, 0, 4, __LINE__ );
+
+    /* a selection with text collapses to its edge first */
+    SendMessageW( hwnd, EM_SETSEL, 4, 7 );
+    hr = ITextSelection_MoveLeft( sel, tomSentence, 1, tomMove, &delta );
+    ok( hr == S_OK && delta == 1, "got %#lx, %ld\n", hr, delta );
+    expect_sel( hwnd, 4, 4, __LINE__ );
+
+    /* up and down by paragraphs and the story */
+    SendMessageW( hwnd, EM_SETSEL, 30, 30 );
+    hr = ITextSelection_MoveUp( sel, tomParagraph, 1, tomMove, &delta );
+    ok( hr == S_OK && delta == 1, "got %#lx, %ld\n", hr, delta );
+    expect_sel( hwnd, 26, 26, __LINE__ );
+    hr = ITextSelection_MoveDown( sel, tomParagraph, 1, tomMove, &delta );
+    ok( hr == S_OK && delta == 1, "got %#lx, %ld\n", hr, delta );
+    expect_sel( hwnd, 38, 38, __LINE__ );
+    hr = ITextSelection_MoveUp( sel, tomStory, 1, tomMove, &delta );
+    ok( hr == S_OK && delta == 1, "got %#lx, %ld\n", hr, delta );
+    expect_sel( hwnd, 0, 0, __LINE__ );
+    hr = ITextSelection_MoveDown( sel, tomSection, 1, tomMove, &delta );
+    ok( hr == E_NOTIMPL, "got %#lx\n", hr );
+
+    ITextSelection_Release( sel );
+    ITextDocument2_Release( doc );
+    IRichEditOle_Release( reole );
+    DestroyWindow( hwnd );
+}
