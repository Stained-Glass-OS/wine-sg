#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all,-fortify,-stackprotector,-format optimize=-lto

%:
	dh $@

override_dh_auto_configure:

# dh's default clean runs `make clean`, which deletes build/obj -- so every
# package build recompiled all of Wine. build.sh keeps the object tree correct
# by itself (it refreshes the source tree whenever the patch series changes), so
# leave it alone. `make distclean` is still there for a from-scratch build.
override_dh_auto_clean:

override_dh_auto_build:
	PREFIX=/opt/wine-sg ./build.sh

override_dh_auto_install:
	PREFIX=/opt/wine-sg DESTDIR=$(CURDIR)/debian/wine-sg DO_INSTALL=1 ./build.sh

# The gate needs to run against an installed tree and creates a Wine prefix,
# which a package build environment cannot be relied on to allow. CI runs it
# separately, against the installed .deb.
override_dh_auto_test:

# Wine's PE files are Windows binaries. dh_strip would mangle them, and
# dh_shlibdeps cannot read them -- so exclude the two PE trees specifically
# rather than the whole Wine directory. Excluding all of lib/wine would hide
# the x86_64-unix .so files from shlibdeps too, and the package would then
# declare little beyond libc while actually needing some two dozen libraries.
#
# build.sh does its own stripping, with the matching mingw strip per
# architecture; see the note there.
override_dh_strip:
override_dh_shlibdeps:
	dh_shlibdeps \
		-X/opt/wine-sg/lib/wine/i386-windows \
		-X/opt/wine-sg/lib/wine/x86_64-windows
