#!/bin/sh
set -e
# Keep the Wine the running wineserver uses until it restarts: an update that changes the
# server protocol could otherwise start no program (the lock screen included) until then.
# The helper is the installed one: the new package's files are not there yet.
if [ "$1" = upgrade ] && [ -x /opt/wine-sg/lib/wine-sg/wine-sg-redirect ]; then
    /opt/wine-sg/lib/wine-sg/wine-sg-redirect start || true
elif [ "$1" = upgrade ] && [ -x /opt/wine-sg/bin/wineserver ]; then
    # from a wine-sg without the helper: the same, inline
    running=
    for p in /proc/[0-9]*; do
        case "$(readlink "$p/exe" 2>/dev/null)" in
        /opt/wine-sg/bin/wineserver|"/opt/wine-sg/bin/wineserver (deleted)") running=1; break ;;
        esac
    done
    if [ -n "$running" ]; then
        rm -rf /opt/wine-sg-running /opt/wine-sg-running.new
        if cp -al /opt/wine-sg /opt/wine-sg-running.new && mv /opt/wine-sg-running.new /opt/wine-sg-running; then
            mkdir -p /run/wine-sg && chmod 755 /run/wine-sg
            printf '/opt/wine-sg-running\n' > /run/wine-sg/redirect.new && chmod 644 /run/wine-sg/redirect.new &&
                mv /run/wine-sg/redirect.new /run/wine-sg/redirect
        fi
    fi
fi
#DEBHELPER#
exit 0
