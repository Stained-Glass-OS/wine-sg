#!/bin/sh
set -e
# The new Wine can talk to the running wineserver: programs start from it at once. Otherwise
# they keep starting from the running Wine until the server restarts (wine-sg-redirect).
# The drop-in on sg-wineserver that ends it when the server starts must be the loaded unit's
# before the server's next restart.
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = configure ] && [ -x /opt/wine-sg/lib/wine-sg/wine-sg-redirect ]; then
    /opt/wine-sg/lib/wine-sg/wine-sg-redirect configure || true
fi
#DEBHELPER#
exit 0
